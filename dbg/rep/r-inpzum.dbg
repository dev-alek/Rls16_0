     3463         where buf_wth-doc.doc-code = p-doc-code
     3464         no-error.
     3465         if available buf_wth-doc
     3466            then do:
     3467   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3468   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3469     (input  buf_wth-doc.obj-type
     3470     ,input  buf_wth-doc.obj-code
     3471     ,output v-host-code
     3472     )  .
     3473            end.
     3474         if v-torgconf-outogr = "no_print"
     3475            then do:
     3476               assign
     3477                  v-torgconf-ogr-name = ""
     3478                  v-torgconf-ogr-post = ""
     3479               .
     3480            end.
     3481         if v-torgconf-outogr  = "ruk_firm"
     3482               then do:
     3483               find first buf_sysconf no-lock
     3484               where buf_sysconf.host-code = v-host-code
     3485               no-error.
     3486               if available buf_sysconf
     3487               then do:
     3488                  assign
     3489                     v-torgconf-ogr-post = buf_sysconf.head-position
     3490                  .
     3491               end.
     3492               find first buf_clients no-lock
     3493                  where buf_clients.obj-type = 'орг':U
     3494                  and buf_clients.obj-code = v-host-code
     3495               .
     3496               find first buf_firm no-lock
     3497                  where buf_firm.firm-code = buf_clients.obj-code
     3498               .
     3499               assign
     3500                  v-torgconf-ogr-name = buf_firm.director
     3501               .
     3502            end.
     3503            if v-torgconf-outogr = "dir_obj"
     3504               then do:
     3505               find first buf_wth-doc no-lock
     3506               where buf_wth-doc.doc-code = p-doc-code
     3507               no-error.
     3508                  find first buf_shop no-lock
     3509                  where buf_shop.obj-code = buf_wth-doc.obj-code
     3510                  .
     3511                  assign
     3512                     v-torgconf-ogr-name = buf_shop.director
     3513                     v-torgconf-ogr-post = "Директор"
     3514                  .
     3515               end.
     3516         if v-torgconf-outogr = "manag_doc"
     3517            then do:
     3518               find first buf_wth-doc no-lock
     3519               where buf_wth-doc.doc-code = p-doc-code
     3520               no-error.
     3521               if available buf_wth-doc
     3522               then do:
     3523                  run rep/get-psn.p
     3524                  (input buf_wth-doc.deliver
     3525                  ,output v-torgconf-ogr-name
     3526                  ) .
     3527               end.
     3528               find first buf_person no-lock
     3529               where buf_person.psn-code = buf_wth-doc.deliver
     3530               no-error.
     3531               if available buf_person
     3532               then do:
     3533                  v-torgconf-ogr-post = buf_person.position.
     3534               end.
     3535               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3536               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3537            end.
     3538      end.
     3539   end.
     3540   end procedure.
     3541   procedure torgconf-get-outogr-param:
     3542       define input parameter p-form-name  as character    no-undo.
     3543       define input parameter p-host-code  as integer      no-undo.
     3544       define input parameter p-obj-type   as character    no-undo.
     3545       define input parameter p-obj-code   as integer      no-undo.
     3546       define input parameter p-doc-code   as character      no-undo.
     3547       define buffer buf_firm          for ub.firm .
     3548       define buffer buf_clients       for ub.clients .
     3549       define buffer buf_sysconf       for ub.sysconf .
     3550       define buffer buf_shop          for ub.shop .
     3551       define buffer buf_store         for ub.store .
     3552       define buffer buf_person        for ub.person .
     3553       define buffer buf_trn-doc       for ub.trn-doc .
     3554       define buffer buf_wth-doc       for ub.wth-doc .
     3555      if  p-form-name <> 'wthtrg12':U
     3556      and p-form-name <> 'wthfct':U
     3557      and p-form-name <> 'wthm11':U
     3558      then do:
     3559       find first buf_trn-doc no-lock
     3560       where buf_trn-doc.doc-code = p-doc-code
     3561       no-error.
     3562       if v-torgconf-outogr = "no_print"
     3563         then do:
     3564            assign
     3565               v-torgconf-ogr-name = ""
     3566               v-torgconf-ogr-post = ""
     3567            .
     3568         end.
     3569      if v-torgconf-outogr  = "ruk_firm"
     3570            then do:
     3571            find first buf_sysconf no-lock
     3572            where buf_sysconf.host-code = p-host-code
     3573            no-error.
     3574            if available buf_sysconf
     3575            then do:
     3576               assign
     3577                  v-torgconf-ogr-post = buf_sysconf.head-position
     3578               .
     3579            end.
     3580            find first buf_clients no-lock
     3581                where buf_clients.obj-type = 'орг':U
     3582                and buf_clients.obj-code = p-host-code
     3583            .
     3584            find first buf_firm no-lock
     3585                where buf_firm.firm-code = buf_clients.obj-code
     3586            .
     3587            assign
     3588                v-torgconf-ogr-name = buf_firm.director
     3589            .
     3590         end.
     3591         if v-torgconf-outogr = "dir_obj"
     3592            then do:
     3593            find first buf_trn-doc no-lock
     3594            where buf_trn-doc.doc-code = p-doc-code
     3595            no-error.
     3596               CASE buf_trn-doc.obj-type:
     3597               WHEN 'маг':U
     3598               THEN DO:
     3599                  find first buf_shop no-lock
     3600                  where buf_shop.obj-code = buf_trn-doc.obj-code
     3601                  .
     3602                  assign
     3603                     v-torgconf-ogr-name = buf_shop.director
     3604                     v-torgconf-ogr-post = "Директор"
     3605                  .
     3606               END.
     3607               WHEN 'скл':U
     3608               THEN DO:
     3609                  find first buf_store no-lock
     3610                  where buf_store.obj-code = buf_trn-doc.obj-code
     3611                  .
     3612                  assign
     3613                     v-torgconf-ogr-name = buf_store.store-boss
     3614                     v-torgconf-ogr-post = "Директор"
     3615                  .
     3616               END.
     3617               OTHERWISE DO:
     3618                  assign
     3619                     v-torgconf-ogr-name = "":U
     3620                     v-torgconf-ogr-post = "":U
     3621                  .
     3622               END.
     3623               END CASE.
     3624            end.
     3625      if v-torgconf-outogr = "manag_doc"
     3626         then do:
     3627            find first buf_trn-doc no-lock
     3628            where buf_trn-doc.doc-code = p-doc-code
     3629            no-error.
     3630            if available buf_trn-doc
     3631            then do:
     3632               run rep/get-psn.p
     3633               (input buf_trn-doc.boss
     3634               ,output v-torgconf-ogr-name
     3635               ) .
     3636            end.
     3637            find first buf_person no-lock
     3638            where buf_person.psn-code = buf_trn-doc.boss
     3639            no-error.
     3640            if available buf_person
     3641            then do:
     3642               v-torgconf-ogr-post = buf_person.position.
     3643            end.
     3644            if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3645            if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3646         end.
     3647      end.
     3648      else do:
     3649      find first buf_wth-doc no-lock
     3650         where buf_wth-doc.doc-code = p-doc-code
     3651         no-error.
     3652         if v-torgconf-outogr = "no_print"
     3653            then do:
     3654               assign
     3655                  v-torgconf-ogr-name = ""
     3656                  v-torgconf-ogr-post = ""
     3657               .
     3658            end.
     3659         if v-torgconf-outogr  = "ruk_firm"
     3660               then do:
     3661               find first buf_sysconf no-lock
     3662               where buf_sysconf.host-code = p-host-code
     3663               no-error.
     3664               if available buf_sysconf
     3665               then do:
     3666                  assign
     3667                     v-torgconf-ogr-post = buf_sysconf.head-position
     3668                  .
     3669               end.
     3670               find first buf_clients no-lock
     3671                  where buf_clients.obj-type = 'орг':U
     3672                  and buf_clients.obj-code = p-host-code
     3673               .
     3674               find first buf_firm no-lock
     3675                  where buf_firm.firm-code = buf_clients.obj-code
     3676               .
     3677               assign
     3678                  v-torgconf-ogr-name = buf_firm.director
     3679               .
     3680            end.
     3681            if v-torgconf-outogr = "dir_obj"
     3682               then do:
     3683               find first buf_wth-doc no-lock
     3684               where buf_wth-doc.doc-code = p-doc-code
     3685               no-error.
     3686                  find first buf_shop no-lock
     3687                  where buf_shop.obj-code = buf_wth-doc.obj-code
     3688                  .
     3689                  assign
     3690                     v-torgconf-ogr-name = buf_shop.director
     3691                     v-torgconf-ogr-post = "Директор"
     3692                  .
     3693               end.
     3694         if v-torgconf-outogr = "manag_doc"
     3695            then do:
     3696               find first buf_wth-doc no-lock
     3697               where buf_wth-doc.doc-code = p-doc-code
     3698               no-error.
     3699               if available buf_wth-doc
     3700               then do:
     3701                  run rep/get-psn.p
     3702                  (input buf_wth-doc.deliver
     3703                  ,output v-torgconf-ogr-name
     3704                  ) .
     3705               end.
     3706               find first buf_person no-lock
     3707               where buf_person.psn-code = buf_wth-doc.deliver
     3708               no-error.
     3709               if available buf_person
     3710               then do:
     3711                  v-torgconf-ogr-post = buf_person.position.
     3712               end.
     3713               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3714               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3715            end.
     3716      end.
     3717   end.
     3718   procedure torgconf-get-reason  :
     3719   define input parameter  p-doc-code       as character        no-undo.
     3720   define input parameter  p-reason-code    as integer          no-undo .
     3721   define input parameter  p-doc-type       as character        no-undo.
     3722       if p-reason-code > 0
     3723       then do:
     3724           define buffer buf_trn-reason for ub.trn-reason.
     3725           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     3726           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     3727       end.
     3728       else do:
     3729           if p-doc-type = 'при':U
     3730           then  do:
     3731               define variable v-attr-type     as character    no-undo.
     3732               define variable v-attr-value    as character    no-undo.
     3733               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     3734               assign v-torgconf-reason = v-attr-value .
     3735               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     3736               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     3737           end.
     3738       end.
     3739   end procedure.
     3740   define variable vss-include-info15 as character format "X(65)" no-undo
     3741   initial "@(#)$Workfile$ $Revision$".
     3742   def var vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3743   procedure r-cost :
     3744     define input  parameter v-doc-code       like ub.doc-line.doc-code          no-undo .
     3745     define input  parameter v-artic          like ub.doc-line.artic             no-undo .
     3746     define input  parameter v-prod-type      like ub.doc-line.prod-type         no-undo .
     3747     define input  parameter v-prod-code      like ub.doc-line.prod-code         no-undo .
     3748     define output parameter v-fact-qnty      like ub.ot-line.fact-qnty       no-undo .
     3749     define output parameter v-vat-pc         like ub.doc-line.vat-pc         no-undo .
     3750     define output parameter v-slt-pc         like ub.doc-line.slt-pc         no-undo .
     3751     define output parameter v-sum-base       like ub.ot-line.sum-base        no-undo .
     3752     define output parameter v-sum-rubl       like ub.ot-line.sum-rubl        no-undo .
     3753     define output parameter v-vat-base       like ub.ot-line.vat-base        no-undo .
     3754     define output parameter v-vat-rubl       like ub.ot-line.vat-rubl        no-undo .
     3755     define output parameter v-slt-base       like ub.ot-line.slt-base        no-undo .
     3756     define output parameter v-slt-rubl       like ub.ot-line.slt-rubl        no-undo .
     3757     define output parameter v-road-tax-base  like ub.ot-line.road-tax-base   no-undo .
     3758     define output parameter v-road-tax-rubl  like ub.ot-line.road-tax-rubl   no-undo .
     3759     define output parameter v-transport-base like ub.ot-line.transport-base  no-undo .
     3760     define output parameter v-transport-rubl like ub.ot-line.transport-rubl  no-undo .
     3761     define output parameter v-other-base     like ub.ot-line.other-base      no-undo .
     3762     define output parameter v-other-rubl     like ub.ot-line.other-rubl      no-undo .
     3763     define output parameter v-excise-base    like ub.ot-line.excise-base     no-undo .
     3764     define output parameter v-excise-rubl    like ub.ot-line.excise-rubl     no-undo .
     3765     do
     3766     on error undo, return error
     3767     :
     3768       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     3769       define buffer   in-vatp-parts    for ub.parts   .
     3770       define buffer   in-vatp-doc      for ub.trn-doc .
     3771       define buffer   in-vatp-goods    for ub.goods   .
     3772       define buffer   in-vatp-sysconf  for ub.sysconf .
     3773       define buffer   in-vatp_doc-attr for ub.doc-attr.
     3774       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     3775       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     3776       define variable varinvprb                  as   character              no-undo.
     3777       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     3778       define variable cli-base-rate              as   decimal                no-undo.
     3779       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     3780       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     3781       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     3782       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     3783       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     3784       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     3785       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     3786       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     3787       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     3788       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     3789       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     3790       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     3791       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     3792       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     3793       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     3794       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     3795       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     3796       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     3797       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     3798       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     3799       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     3800       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     3801       define variable varinvatp-envd             as   character              no-undo.
     3802       define variable varinvatp-type             as   character              no-undo.
     3803       def var v-parts-fact-qnty as decimal   no-undo .
     3804       define buffer buf_parts    for ub.parts    .
     3805       define buffer buf_goods    for ub.goods    .
     3806       define buffer buf_trn-doc  for ub.trn-doc  .
     3807       define buffer buf_doc-line for ub.doc-line .
     3808       find first buf_doc-line no-lock
     3809         where buf_doc-line.doc-code  = v-doc-code
     3810           and buf_doc-line.artic     = v-artic
     3811           and buf_doc-line.prod-type = v-prod-type
     3812           and buf_doc-line.prod-code = v-prod-code
     3813         no-error .
     3814       if not available buf_doc-line then do:
     3815         message
     3816           vss-workfile vss-revision vss-description skip
     3817           vss-include-info16 skip
     3818           "Ошибка задания входных параметров" skip
     3819           "Не найдена строка документа"  skip
     3820           "Документ" v-doc-code skip
     3821           "Артикул" v-artic v-prod-type v-prod-code skip
     3822           view-as alert-box error .
     3823         return error .
     3824       end.
     3825       find first buf_trn-doc no-lock
     3826         where buf_trn-doc.doc-code = v-doc-code
     3827         no-error .
     3828       if not available buf_trn-doc then do:
     3829         message
     3830           vss-workfile vss-revision vss-description skip
     3831           vss-include-info16 skip
     3832           "Ошибка задания входных параметров" skip
     3833           "Не найден документ" skip
     3834           "Документ" v-doc-code skip
     3835           "Артикул" v-artic v-prod-type v-prod-code skip
     3836           view-as alert-box error .
     3837         undo, return error .
     3838       end.
     3839       find first buf_goods no-lock
     3840         where buf_goods.artic     = buf_doc-line.artic
     3841           and buf_goods.prod-type = buf_doc-line.prod-type
     3842           and buf_goods.prod-code = buf_doc-line.prod-code
     3843         no-error .
     3844       if not available buf_goods then do:
     3845         message
     3846           vss-workfile vss-revision vss-description skip
     3847           vss-include-info16 skip
     3848           "Ошибка задания входных параметров" skip
     3849           "Не найден товар" skip
     3850           "Документ" v-doc-code skip
     3851           "Артикул" v-artic v-prod-type v-prod-code skip
     3852           view-as alert-box error .
     3853         undo, return error .
     3854       end.
     3855       if buf_goods.gds-type = 'т':U then do:
     3856             for each buf_parts no-lock
     3857               where buf_parts.out-code  = buf_trn-doc.doc-code
     3858                 and buf_parts.obj-type  = buf_trn-doc.obj-type
     3859                 and buf_parts.obj-code  = buf_trn-doc.obj-code
     3860                 and buf_parts.artic     = buf_doc-line.artic
     3861                 and buf_parts.prod-type = buf_doc-line.prod-type
     3862                 and buf_parts.prod-code = buf_doc-line.prod-code
     3863             on error undo, return error
     3864             :
     3865   assign
     3866     price-rubl-with-tax-loc = buf_parts.price-rubl
     3867     price-base-with-tax-loc = buf_parts.price-base
     3868   .
     3869   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3870   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3871     (output varinvprb
     3872     )  .
     3873     if buf_parts.out-code = 'free-zone':U     or
     3874        buf_parts.out-code = 'out-zone':U   or
     3875        buf_parts.doc-type = 'акт':U then do:
     3876       assign
     3877         in-vatp-have-vat-slt = yes.
     3878     end.
     3879     else do:
     3880       find first in-vatp_doc-attr no-lock
     3881         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
     3882           and in-vatp_doc-attr.attr-code = 'envd':U
     3883         no-error .
     3884       if not available in-vatp_doc-attr then do:
     3885         assign
     3886           in-vatp-have-vat-slt = yes.
     3887       end.
     3888       else do:
     3889            in-vatp-have-vat-slt = no.
     3890       end.
     3891     end.
     3892     assign
     3893      price-cli-with-tax-loc = buf_parts.price-cli
     3894      cli-base-rate          = buf_parts.cli-base-rate.
     3895     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
     3896              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
     3897     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
     3898             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
     3899             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
     3900             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
     3901             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
     3902             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
