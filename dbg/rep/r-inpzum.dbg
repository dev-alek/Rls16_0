     5509               ,input buf_doc-line.prod-code  ,output t-dec       ,output v-vat-pc   ,output v-slt-pc
     5510               ,output v-sum-base             ,output v-sum-rubl  ,output v-vat-base ,output v-vat-rubl
     5511               ,output v-slt-base             ,output v-slt-rubl  ,output t-dec      ,output t-dec
     5512               ,output t-dec   ,output t-dec  ,output t-dec       ,output t-dec      ,output t-dec   ,output t-dec ) no-error .
     5513       if PrintRubl then  assign   stoim   = v-sum-rubl    SLT-sum = v-slt-rubl    VAT-sum = v-vat-rubl  .
     5514       else               assign   stoim   = v-sum-base    SLT-sum = v-slt-base    VAT-sum = v-vat-base  .
     5515       if stoim < 0 then  assign   stoim   = - stoim       SLT-sum = - SLT-sum     VAT-sum = - VAT-sum   .
     5516       find first gds-obj no-lock
