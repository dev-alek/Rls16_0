     4063               v-parts-fact-qnty           = (if buf_trn-doc.doc-type = 'при':U
     4064                                         or buf_trn-doc.doc-type = 'возврат':U
     4065                                         or buf_trn-doc.doc-type = 'инв':U
     4066                                         then buf_doc-line.fact-qnty
     4067                                         else - buf_doc-line.fact-qnty
     4068                                       )
     4069             .
     4070   assign
     4071     price-rubl-with-tax-loc = buf_doc-line.price-rubl
     4072     price-base-with-tax-loc = buf_doc-line.price-base
     4073   .
     4074   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4075   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     4076     (output varinvprb
     4077     )  .
     4078      find first in-vatp_doc-attr no-lock
     4079       where in-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
     4080         and in-vatp_doc-attr.attr-code = 'envd':U
     4081       no-error .
     4082       if available in-vatp_doc-attr
     4083          then do:
     4084          assign
     4085            in-vatp-have-vat-slt = no.
     4086      end.
     4087      else do:
     4088        assign
     4089          in-vatp-have-vat-slt = yes.
     4090      end.
     4091      find first in-vatp-goods where in-vatp-goods.artic     = buf_doc-line.artic     and
     4092                                        in-vatp-goods.prod-type = buf_doc-line.prod-type and
     4093                                        in-vatp-goods.prod-code = buf_doc-line.prod-code no-lock.
     4094      if (not buf_trn-doc.internal and
     4095              buf_trn-doc.doc-type = 'при':U) or
     4096         in-vatp-goods.gds-type = 'у':U then do:
     4097         if varinvprb = "base":u then do:
     4098           assign
     4099             road-tax-base-loc = buf_doc-line.road-tax
     4100             road-tax-rubl-loc = buf_doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale.
     4101         end.
     4102         else do:
     4103           ASSIGN
     4104             road-tax-rubl-loc = buf_doc-line.road-tax
     4105             road-tax-base-loc = buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale.
     4106         end.
     4107         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     4108         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     4109         assign
     4110           road-tax-cli-loc = ?.
     4111         ASSIGN
     4112           transport-base-loc = (if buf_doc-line.transport-base = ? then 0 else buf_doc-line.transport-base)
     4113           transport-rubl-loc = (if buf_doc-line.transport-rubl = ? then 0 else buf_doc-line.transport-rubl)
     4114           transport-cli-loc  = 0
     4115           other-base-loc     = (if buf_doc-line.other-base     = ? then 0 else buf_doc-line.other-base)
     4116           other-rubl-loc     = (if buf_doc-line.other-rubl     = ? then 0 else buf_doc-line.other-rubl)
     4117           other-cli-loc      = 0
     4118           vat-pc-loc         = (if buf_doc-line.vat-pc         = ? then 0 else buf_doc-line.vat-pc)
     4119           slt-pc-loc         = (if buf_doc-line.slt-pc         = ? then 0 else buf_doc-line.slt-pc).
     4120                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     4121               ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     4122         assign
     4123           vat-cli-loc            = ?
     4124           slt-cli-loc            = ?
     4125           price-cli-with-tax-loc = ?.
     4126      end.
     4127      else do:
     4128                                                   for each in-vatp-parts where in-vatp-parts.out-code  = buf_doc-line.doc-code  and
     4129                                         in-vatp-parts.obj-type  = buf_doc-line.obj-type  and
     4130                                         in-vatp-parts.obj-code  = buf_doc-line.obj-code  and
     4131                                         in-vatp-parts.artic     = buf_doc-line.artic     and
     4132                                         in-vatp-parts.prod-type = buf_doc-line.prod-type and
     4133                                         in-vatp-parts.prod-code = buf_doc-line.prod-code
     4134                            use-index out-code no-lock:
     4135             accumulate  in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty (total)
     4136                         in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty (total)
     4137                         in-vatp-parts.transport-base * in-vatp-parts.fact-qnty (total)
     4138                         in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty (total)
     4139                         in-vatp-parts.other-base     * in-vatp-parts.fact-qnty (total)
     4140                         in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty (total)
     4141                                                                                                                 (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     4142                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     4143                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     4144                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     4145                                               (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     4146                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     4147                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     4148                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     4149                         .
     4150         end.
     4151         ASSIGN
     4152           road-tax-base-loc   = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     4153           road-tax-rubl-loc   = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     4154           transport-base-loc  = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-base * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     4155           transport-rubl-loc  = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     4156           other-base-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-base     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     4157           other-rubl-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     4158                                           vat-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
     4159           slt-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
     4160                   vat-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
     4161           slt-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
     4162           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     4163           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     4164         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     4165         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     4166         if transport-base-loc = ? then transport-base-loc = 0.
     4167         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     4168         if other-base-loc     = ? then other-base-loc     = 0.
     4169         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     4170         assign
     4171           transport-cli-loc      = 0
     4172           other-cli-loc          = 0
     4173           road-tax-cli-loc       = ?
     4174           vat-cli-loc            = ?
     4175           slt-cli-loc            = ?
     4176           price-cli-with-tax-loc = ?.
     4177      end.
     4178   ASSIGN
     4179             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     4180       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     4181   .
     4182             assign
     4183               v-fact-qnty           = v-fact-qnty      + v-parts-fact-qnty
     4184               v-vat-pc              = vat-pc-loc
     4185               v-slt-pc              = slt-pc-loc
     4186               v-sum-base            = v-sum-base       + (price-base-with-tax-loc * v-parts-fact-qnty)
     4187               v-sum-rubl            = v-sum-rubl       + (price-rubl-with-tax-loc * v-parts-fact-qnty)
     4188               v-vat-base            = v-vat-base       + (vat-base-loc            * v-parts-fact-qnty)
     4189               v-vat-rubl            = v-vat-rubl       + (vat-rubl-loc            * v-parts-fact-qnty)
     4190               v-slt-base            = v-slt-base       + (slt-base-loc            * v-parts-fact-qnty)
     4191               v-slt-rubl            = v-slt-rubl       + (slt-rubl-loc            * v-parts-fact-qnty)
     4192               v-road-tax-base       =  0
     4193               v-road-tax-rubl       =  0
     4194               v-excise-base         =  0
     4195               v-excise-rubl         =  0
     4196               v-transport-base      =  0
     4197               v-transport-rubl      =  0
     4198               v-other-base          =  0
     4199               v-other-rubl          =  0
     4200             .
     4201       end.
     4202     end.
     4203   end procedure.
     4204   define variable vss-include-info20 as character format "X(65)" no-undo
     4205   initial "@(#)$Workfile$ $Revision$".
     4206   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4207   procedure r-sale :
     4208     define input parameter  p-doc-code          like ub.doc-line.doc-code          no-undo .
     4209     define input parameter  p-artic             like ub.doc-line.artic             no-undo .
     4210     define input parameter  p-prod-type         like ub.doc-line.prod-type         no-undo .
     4211     define input parameter  p-prod-code         like ub.doc-line.prod-code         no-undo .
     4212     define output parameter p-fact-qnty         like ub.ot-line.fact-qnty       no-undo .
     4213     define output parameter p-vat-pc            like ub.doc-line.vat-pc         no-undo .
     4214     define output parameter p-slt-pc            like ub.doc-line.slt-pc         no-undo .
     4215     define output parameter p-sum-base          like ub.ot-line.sum-base        no-undo .
     4216     define output parameter p-sum-rubl          like ub.ot-line.sum-rubl        no-undo .
     4217     define output parameter p-vat-base          like ub.ot-line.vat-base        no-undo .
     4218     define output parameter p-vat-rubl          like ub.ot-line.vat-rubl        no-undo .
     4219     define output parameter p-slt-base          like ub.ot-line.slt-base        no-undo .
     4220     define output parameter p-slt-rubl          like ub.ot-line.slt-rubl        no-undo .
     4221     define output parameter p-road-tax-base     like ub.ot-line.road-tax-base   no-undo .
     4222     define output parameter p-road-tax-rubl     like ub.ot-line.road-tax-rubl   no-undo .
     4223     define output parameter p-transport-base    like ub.ot-line.transport-base  no-undo .
     4224     define output parameter p-transport-rubl    like ub.ot-line.transport-rubl  no-undo .
     4225     define output parameter p-other-base        like ub.ot-line.other-base      no-undo .
     4226     define output parameter p-other-rubl        like ub.ot-line.other-rubl      no-undo .
     4227     define output parameter p-excise-base       like ub.ot-line.excise-base     no-undo .
     4228     define output parameter p-excise-rubl       like ub.ot-line.excise-rubl     no-undo .
     4229     define variable vss-description as character no-undo initial "r-sale-01: обработка продажных цен товара".
     4230     do
     4231     on error undo, return error
     4232     :
     4233       define  variable price-rubl-with-tax-sale    like ub.doc-line.price-rubl no-undo.
     4234       define  variable price-base-with-tax-sale    like ub.doc-line.price-base no-undo.
     4235       define  variable price-rubl-without-tax-sale like ub.doc-line.price-rubl no-undo.
     4236       define  variable price-base-without-tax-sale like ub.doc-line.price-base no-undo.
     4237       define  variable vat-base-sale               like ub.doc-line.price-base no-undo.
     4238       define  variable vat-rubl-sale               like ub.doc-line.price-rubl no-undo.
     4239       define  variable vat-base-buyer              like ub.doc-line.price-base no-undo.
     4240       define  variable vat-rubl-buyer              like ub.doc-line.price-rubl no-undo.
     4241       define  variable slt-base-sale               like ub.doc-line.price-base no-undo.
     4242       define  variable slt-rubl-sale               like ub.doc-line.price-rubl no-undo.
     4243       define  variable road-tax-base-sale          like ub.doc-line.road-tax   no-undo.
     4244       define  variable road-tax-rubl-sale          like ub.doc-line.road-tax   no-undo.
     4245       define  variable excise-base-sale            like ub.doc-line.price-base no-undo.
     4246       define  variable excise-rubl-sale            like ub.doc-line.price-rubl no-undo.
