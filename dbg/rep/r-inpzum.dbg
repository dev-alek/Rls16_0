     1405   procedure torgconf-get-recepient-param :
     1406   define input parameter torgconfdoc-code   as character                  no-undo.
     1407   define output parameter v-code-rec        as integer                    no-undo .
     1408   define output parameter v-type-rec        as character                  no-undo initial 'C':U.
     1409   define output parameter v-codefirm-rec    as integer                    no-undo .
     1410   define output parameter v-curcode-rec     as integer                    no-undo .
     1411        define variable  v-recipient-code  as character                  no-undo .
     1412        define variable  v-recipient       like ub.doc-attr.attr-value   no-undo.
     1413        define variable  v-trdcattr-type   as character                  no-undo initial 'C':U.
     1414   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input torgconfdoc-code ,
     1415                           input 'Recipient':U ,
     1416                          output v-recipient-code ,
     1417                          output v-trdcattr-type ) no-error .
     1418       if error-status :error then do:
     1419        message
     1420         vss-workfile vss-revision vss-description skip
     1421         "Ошибка при вызове процедуры tdat-val":U skip
     1422         "Документ: " torgconfdoc-code skip
     1423         "Атрибут: " 'Recipient':U skip
     1424         "Значение: " v-recipient skip
     1425         trim( error-status :get-message (1) ) skip
     1426         return-value skip
     1427         view-as alert-box error.
     1428       undo, return error return-value.
     1429       end.
     1430     assign
     1431       v-recipient  = v-recipient-code
     1432       v-type-rec = substring(v-recipient-code,1,3)
     1433       v-code-rec  = int(substring(v-recipient-code,4,15))
     1434       no-error
     1435     .
     1436     if v-type-rec = ? then v-type-rec = "" .
     1437     if v-code-rec  = ? then v-code-rec  =  0 .
     1438     end procedure.
