     4326       define variable varinvatp-envdo             as   character              no-undo.
     4327       define variable varinvatp-typeo             as   character              no-undo.
     4328       define variable v-gds-dtl-fact-qnty as decimal no-undo .
     4329       define buffer buf_gds-dtl  for ub.gds-dtl .
     4330       define buffer buf_goods    for ub.goods .
     4331       define buffer buf_trn-doc  for ub.trn-doc .
     4332       define buffer buf_doc-line for ub.doc-line .
     4333       find first buf_doc-line no-lock
     4334         where buf_doc-line.doc-code  = p-doc-code
     4335           and buf_doc-line.artic     = p-artic
     4336           and buf_doc-line.prod-type = p-prod-type
     4337           and buf_doc-line.prod-code = p-prod-code
     4338         no-error .
     4339       if not available buf_doc-line then do:
     4340         message
     4341           vss-workfile vss-revision vss-description skip
     4342           vss-include-info21 skip
     4343           "Ошибка задания входных параметров" skip
     4344           "Не найдена строка документа" skip
     4345           "Документ" p-doc-code skip
     4346           "Артикул" p-artic p-prod-type p-prod-code skip
     4347           view-as alert-box error .
     4348         undo, return error .
     4349       end.
     4350       find first buf_trn-doc no-lock
     4351         where buf_trn-doc.doc-code = buf_doc-line.doc-code
     4352         no-error .
     4353       if not available buf_trn-doc then do:
     4354         message
     4355           vss-workfile vss-revision vss-description skip
     4356           vss-include-info21 skip
     4357           "Не найден документ" skip
     4358           "Документ" p-doc-code skip
     4359           "Артикул" p-artic p-prod-type p-prod-code skip
     4360           view-as alert-box error .
     4361         undo, return error .
     4362       end.
     4363       for each buf_gds-dtl no-lock
     4364         where buf_gds-dtl.doc-code  = buf_doc-line.doc-code
     4365           and buf_gds-dtl.artic     = buf_doc-line.artic
     4366           and buf_gds-dtl.prod-type = buf_doc-line.prod-type
     4367           and buf_gds-dtl.prod-code = buf_doc-line.prod-code
     4368       on error undo, return error
     4369       :
     4370           if buf_trn-doc.doc-type <> 'инв':U
     4371           then do:
     4372               if buf_trn-doc.doc-type = 'при':U
     4373               or buf_trn-doc.doc-type = 'возврат':U
     4374               then do:
     4375                   assign
     4376                       v-gds-dtl-fact-qnty = buf_gds-dtl.fact-qnty
     4377                   .
     4378               end.
     4379               else do:
     4380                   assign
     4381                       v-gds-dtl-fact-qnty = - buf_gds-dtl.fact-qnty
     4382                   .
     4383               end.
     4384           end.
     4385           else do:
     4386               assign
     4387                   v-gds-dtl-fact-qnty = buf_gds-dtl.doc-qnty
     4388               .
     4389           end.
     4390           if v-gds-dtl-fact-qnty <> 0
     4391           then do:
     4392   if buf_trn-doc.ext-doc-type = 'ot':U or
     4393      buf_trn-doc.ext-doc-type = ?                 then do:
     4394     assign
     4395      out-vatp-have-vat-slt = yes.
     4396   end.
     4397   else do:
     4398     find first out-vatp_doc-attr no-lock
     4399       where out-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
     4400         and out-vatp_doc-attr.attr-code = 'envd':U
     4401         no-error .
     4402     if not available out-vatp_doc-attr then do:
     4403       assign
     4404         out-vatp-have-vat-slt = yes.
     4405     end.
     4406     else do:
     4407        out-vatp-have-vat-slt = no.
     4408     end.
     4409   end.
     4410   find first out-vatp_goods where out-vatp_goods.artic     = buf_doc-line.artic     and
     4411                                      out-vatp_goods.prod-type = buf_doc-line.prod-type and
     4412                                      out-vatp_goods.prod-code = buf_doc-line.prod-code no-lock.
     4413   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4414   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     4415     (input  buf_doc-line.artic
     4416     ,input  buf_doc-line.prod-type
     4417     ,input  buf_doc-line.prod-code
     4418     ,output varroot-node
     4419     ) no-error .
     4420   if error-status :error then do:
     4421     message
     4422       vss-workfile vss-revision vss-description skip
     4423       "Ошибка при определении корневого признака товара" skip
     4424       "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     4425       error-status :get-message(1) skip
     4426       return-value skip
     4427       view-as alert-box error .
     4428     undo, return error .
     4429   end.
     4430   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     4431     (input  varroot-node
