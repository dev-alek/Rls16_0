      978   procedure wthcattr-sprcli :
      979   define input parameter parparentproc  as widget-handle no-undo.
      980   define input parameter p-mode  as character no-undo.
      981   define input-output parameter p-value as character no-undo .
      982   define output parameter p-setted as logical no-undo .
      983     DEFINE VARIABLE v-value as character no-undo .
      984     define variable v-cli-type as character no-undo .
      985     define variable v-cli-code as integer no-undo .
      986     define buffer buf_clients   for ub.clients.
      987     define variable v_rid as character no-undo.
      988     define variable ref-rec as recid no-undo .
      989     do
      990     on error undo, return error
      991     :
      992         v-value = p-value.
      993      if p-value <> '':U then do:
      994       assign
      995       v-cli-type = substring(p-value, 1, 3)
      996       v-cli-code = integer(substring(p-value, 4))
      997       no-error.
      998       if error-status:error then do:
      999         assign
     1000         v-cli-type = '':U
     1001         v-cli-code = 0
     1002         .
     1003       end.
     1004      end.
     1005      FIND FIRST buf_clients NO-LOCK WHERE
     1006               buf_clients.obj-type = v-cli-type AND
     1007               buf_clients.obj-code = v-cli-code  NO-ERROR.
     1008      IF available(buf_clients) then do:
     1009       run ref/cli-all.w (
     1010                   input parparentproc
     1011                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
     1012                  ,input v-cli-type
     1013                  ,input 'все':U
     1014                  ,input 'все':U
     1015                  ,input RECID( buf_clients )
     1016                  ,input ",,,,,,NO"
     1017                  ,input ?
     1018                  ,OUTPUT v_rid ).
     1019     END.
     1020     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     1021       run ref/cli-all.w (
     1022                    input parparentproc
     1023                   ,INPUT "b-sel":U
     1024                  ,input  v-cli-type
     1025                  ,input 'все':U
     1026                  ,input 'текущие':U
     1027                  ,input ?
     1028                  ,input ",,,,,,NO"
     1029                  ,input ?
     1030                  ,OUTPUT v_rid ).
     1031     END.
     1032     else do:
     1033       message
     1034       if p-value = "":U then 'Атрибут не задан!'
     1035       else substitute('Не найден клиент &1',p-value)
     1036       view-as alert-box warning.
     1037     end.
     1038     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1039       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1040       IF ERROR-STATUS:ERROR THEN DO:
     1041           RETURN NO-APPLY.
     1042       END.
     1043       FIND FIRST buf_clients NO-LOCK WHERE
     1044                  RECID( buf_clients ) = ref-rec NO-ERROR.
     1045       IF AVAIL buf_clients THEN DO:
     1046         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     1047       end.
     1048     end.
     1049     if v-value <> p-value then do:
     1050       p-value = v-value.
     1051       p-setted = yes.
     1052     end.
     1053     end.
     1054   end procedure.
     1055     define new global shared variable g#wthcalib as handle no-undo.
     1056   procedure torgconf-read :
     1057   do
     1058   on error undo, return error
     1059   :
     1060       define input parameter p-form-name  as character    no-undo.
     1061       define input parameter p-host-code  as integer      no-undo.
     1062       define input parameter p-obj-type   as character    no-undo.
     1063       define input parameter p-obj-code   as integer      no-undo.
     1064       define variable v-outdate   as character     no-undo.
     1065       define variable v-outares   as character     no-undo.
     1066       define variable v-outsend   as character     no-undo.
     1067       define variable v-outasend  as character     no-undo.
     1068       define variable v-outprops  as character     no-undo.
