     5730   procedure print-itog :
     5731     do on error undo, return error return-value :
     5732       case num-form :
     5733         when 1
     5734         then do:
     5735           put stream out_stream Line format "X(136)" skip .
     5736           display stream out_stream sym1 sym2 sym3 sym4 "ИТОГО: " @ gds_name sym5 sym6
     5737             all-qnty @ Price sym7 all-stoim @ qnty sym8 (all-qnty - all-stoim) @ stoim sym9 with frame AKT.
     5738           down stream out_stream with frame AKT .
     5739           put stream out_stream Line format "X(136)" skip .
     5740         end.
     5741         when 2
     5742         then do:
     5743           put stream out_stream Line format "X(136)" skip .
     5744           display stream out_stream sym1 sym2 sym3 sym4 "ИТОГО: " @ gds_name sym5 sym6 sym7 all-qnty @ qnty sym8 all-stoim @ stoim sym9 with frame Zum-rubl.
     5745           down stream out_stream with frame Zum-rubl .
     5746           put stream out_stream Line format "X(136)" skip .
     5747         end.
     5748         when 3
     5749         then do:
     5750           put stream out_stream Line format "X(136)" skip .
     5751           display stream out_stream sym1 sym2 sym3 sym4 "ИТОГО: " @ gds_name sym5 sym6 sym7 all-qnty @ qnty sym8 all-stoim @ stoim sym9 sym10 with frame rubl.
     5752           down stream out_stream with frame rubl .
     5753           put stream out_stream Line format "X(136)" skip .
     5754         end.
     5755         when 4
     5756         then do:
     5757           put stream out_stream Line format "X(136)" skip .
     5758           display stream out_stream sym1 sym2 sym3 sym4 "ИТОГО: " @ gds_name sym5 sym6 sym7 all-qnty @ qnty sym8 all-stoim @ stoim sym9  with frame Zum-jew.
     5759           down stream out_stream with frame Zum-jew .
     5760           put stream out_stream Line format "X(136)" skip .
     5761         end.
     5762       end.
     5763     end.
     5764   end procedure.
     5765   procedure itog:
     5766     if not PrintRubl then run rep/wp.p (     input p-mainmenu-handle, input all-stoim, output s1, output s2 ) .
     5767     else                  run rep/wp-rub.p (                          input all-stoim, output s1, output s2 ) .
     5768     if buf_trn-doc.internal
     5769     then do:
     5770       PUT STREAM Out_Stream SPACE(5) "Итого к оплате " all-stoim format ">,>>>,>>>,>>9.99" SPACE(2) trim(s2) format "X(4)" .
     5771     end.
     5772     else do:
     5773       PUT STREAM Out_Stream SPACE(5) "Итого " all-stoim format ">>,>>>,>>>,>>9.99" SPACE(2) trim(s2) format "X(4)" .
     5774       put stream Out_stream ", в том числе: " format "x(25)" skip(1).
     5775       put stream Out_stream string( ": Сумма  налога :   Сумма НДС   :" ) at 60 format "X(40)" skip.
     5776       for each temp-nalog break by temp-nalog.slt-prc by temp-nalog.vat-prc:
     5777         accumulate
     5778           temp-nalog.slt-sum (total)
     5779           temp-nalog.vat-sum (total)
     5780         .
     5781         put stream Out_stream
     5782           string( "Налог с продаж" + string( temp-nalog.slt-prc, ">>9.<<%")
     5783           + string( ", НДС" + string( temp-nalog.vat-prc, ">>9.<<%") ) ) at 20 format "X(40)"
     5784           string( ":"  + string( temp-nalog.SLT-sum , "->>>,>>>,>>9.99" )
     5785           + ":"  + string( temp-nalog.VAT-sum , "->>>,>>>,>>9.99" ) + ":" ) at 60 format "X(40)"  skip
     5786         .
     5787       end.
     5788       put stream Out_stream
     5789         line at 20 format "X(73)" skip string( "Итого" ) at 20 format "X(40)"
     5790         string( ":" + string( accum total temp-nalog.SLT-sum, "->>>,>>>,>>9.99" ) + ":"
     5791         + string( accum total temp-nalog.VAT-sum, "->>>,>>>,>>9.99" )  + ":" ) at 60 format "X(40)" skip
     5792       .
     5793       put stream Out_stream skip(1) space(10) caps(s1) format "x(126)" skip(2) .
     5794     end.
     5795     if buf_trn-doc.status_ = 'факт':U
     5796     then do:
     5797       run rep/get-psn.p ( input buf_trn-doc.boss, output Mngr_name ) .
     5798       run rep/get-psn.p ( input buf_trn-doc.wrkr, output Wrkr_name) .
     5799       run rep/get-psn.p ( input buf_trn-doc.agnt, output Isp_name ) .
     5800       define variable v-user-name as character no-undo .
     5801   define variable vss-include-info36 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5802   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
     5803     (input  buf_trn-doc.creid
     5804     ,output v-user-name
     5805     )  .
     5806       if not( "" = "ia" and CostPrice = no ) then
     5807            put stream Out_stream "Торговый представитель : " at 9 format "X(30)"  Mngr_name   format "X(30)" skip
     5808                                  "Исполнитель            : " at 9 format "X(30)"  Isp_name    format "X(30)" skip
     5809                                  "Документ оформил       : " at 9 format "X(30)"  v-user-name format "X(60)" skip
     5810                                  "Кладовщик              : " at 9 format "X(30)"  Wrkr_name   format "X(30)" skip(1)
     5811           .
     5812       put stream Out_stream space(65) ( if v-torgconf-outdate = no then string( buf_trn-doc.fact-date, "99/99/9999" ) else "" )  format "X(10)"  skip .
     5813     end.
     5814     else do:
     5815       put stream Out_stream  space(30) "--- Н Е   П О Д П И С Ы В А Т Ь ! ---" format "X(75)" skip(1) .
     5816     end.
     5817   end procedure.
