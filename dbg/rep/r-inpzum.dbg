     5838       then do:
     5839   if g#quest-print = false
     5840   then do:
     5841     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     5842                                         7, (if 4 >= 8 then 2 else 0), 0, 0,
     5843                                         OUTPUT g#log ).
     5844   end.
     5845   else do:
     5846     os-command silent
     5847       value( "COPY /b " +
     5848         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     5849         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     5850         string( session:temp-directory) +  "$" + string( g#report-num )
     5851                 ) .
