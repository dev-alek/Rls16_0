     4445     undo, return error .
     4446   end.
     4447   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4448   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     4449     (output varoutvprb
     4450     )  .
     4451   if varoutvprb = "base":u then do:
     4452     assign
     4453           road-tax-base-sale    =  (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * 1)
     4454       excise-base-sale      =  (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * 1)
     4455     .
     4456   end.
     4457   else do:
     4458     assign
     4459           road-tax-base-sale    =  (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale)
     4460       excise-base-sale      =  (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   / buf_trn-doc.base-rate * buf_trn-doc.base-scale)
     4461     .
     4462   end.
     4463   if varoutvprb = "rubl":u then do:
     4464     assign
     4465           road-tax-rubl-sale    = (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * 1)
     4466       excise-rubl-sale      = (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * 1) .
     4467   end.
     4468   else do:
     4469     assign
     4470           road-tax-rubl-sale    = (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale)
     4471       excise-rubl-sale      = (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * buf_trn-doc.base-rate / buf_trn-doc.base-scale) .
     4472   end.
     4473   assign
     4474     varis-cons-parts-have =  no.
     4475   assign
     4476     varfact-qnty       = 0
     4477     varcons-qnty       = 0
     4478     varprice-base-cons = 0
     4479     varprice-rubl-cons = 0.
     4480   find first out-vatp_doc-line where
     4481              out-vatp_doc-line.doc-code   = buf_trn-doc.doc-code
     4482          and out-vatp_doc-line.artic      = buf_doc-line.artic
     4483          and out-vatp_doc-line.prod-type  = buf_doc-line.prod-type
     4484          and out-vatp_doc-line.prod-code  = buf_doc-line.prod-code no-lock no-error.
     4485   if available out-vatp_doc-line           and
     4486     (out-vatp_doc-line.status_ = 'запрос':U or out-vatp_goods.gds-type = 'у':U) then do:
     4487     assign
     4488       varfact-qnty = out-vatp_doc-line.fact-qnty.
     4489   end.
     4490   else do:
     4491     for each out-vatp_parts where out-vatp_parts.out-code   = buf_trn-doc.doc-code
     4492                                  and out-vatp_parts.obj-type   = buf_trn-doc.obj-type
     4493                                  and out-vatp_parts.obj-code   = buf_trn-doc.obj-code
     4494                                  and out-vatp_parts.artic      = buf_doc-line.artic
     4495                                  and out-vatp_parts.prod-type  = buf_doc-line.prod-type
     4496                                  and out-vatp_parts.prod-code  = buf_doc-line.prod-code no-lock :
     4497       if out-vatp_parts.purch-code = 2 then do:
     4498   assign
     4499     price-rubl-with-tax-loco = out-vatp_parts.price-rubl
     4500     price-base-with-tax-loco = out-vatp_parts.price-base
     4501   .
     4502   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4503   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     4504     (output varinvprbo
     4505     )  .
     4506     if out-vatp_parts.out-code = 'free-zone':U     or
     4507        out-vatp_parts.out-code = 'out-zone':U   or
     4508        out-vatp_parts.doc-type = 'акт':U then do:
     4509       assign
     4510         in-vatp-have-vat-slto = yes.
     4511     end.
     4512     else do:
     4513       find first in-vatp_doc-attro no-lock
     4514         where in-vatp_doc-attro.doc-code  = out-vatp_parts.out-code
     4515           and in-vatp_doc-attro.attr-code = 'envd':U
     4516         no-error .
     4517       if not available in-vatp_doc-attro then do:
     4518         assign
     4519           in-vatp-have-vat-slto = yes.
     4520       end.
     4521       else do:
     4522            in-vatp-have-vat-slto = no.
     4523       end.
     4524     end.
     4525     assign
     4526      price-cli-with-tax-loco = out-vatp_parts.price-cli
     4527      cli-base-rateo          = out-vatp_parts.cli-base-rate.
     4528     ASSIGN   road-tax-base-loco  = (if out-vatp_parts.road-tax-base  = ? then 0 else out-vatp_parts.road-tax-base)
     4529              road-tax-rubl-loco  = (if out-vatp_parts.road-tax-rubl  = ? then 0 else out-vatp_parts.road-tax-rubl).
     4530     ASSIGN  transport-base-loco = (if out-vatp_parts.transport-base = ? then 0 else out-vatp_parts.transport-base)
     4531             transport-rubl-loco = (if out-vatp_parts.transport-rubl = ? then 0 else out-vatp_parts.transport-rubl)
     4532             other-base-loco     = (if out-vatp_parts.other-base     = ? then 0 else out-vatp_parts.other-base)
     4533             other-rubl-loco     = (if out-vatp_parts.other-rubl     = ? then 0 else out-vatp_parts.other-rubl)
     4534             vat-pc-loco         = (if out-vatp_parts.vat-pc         = ? then 0 else out-vatp_parts.vat-pc)
     4535             slt-pc-loco         = (if out-vatp_parts.slt-pc         = ? then 0 else out-vatp_parts.slt-pc).
     4536             ASSIGN   slt-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     4537       ASSIGN   slt-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     4538     assign
     4539       exch-rate-cli-loco = (out-vatp_parts.price-rubl - transport-rubl-loco - other-rubl-loco - road-tax-rubl-loco - (if out-vatp_parts.vat-type <> 'в т. ч.':U then vat-rubl-loco else 0) - (if out-vatp_parts.slt-type <> 'в т. ч.':U then slt-rubl-loco else 0)) / out-vatp_parts.price-cli .
     4540     assign
     4541       slt-cli-loco        = slt-rubl-loco       / exch-rate-cli-loco
     4542       vat-cli-loco        = vat-rubl-loco       / exch-rate-cli-loco
     4543       road-tax-cli-loco   = road-tax-rubl-loco  / exch-rate-cli-loco
     4544       transport-cli-loco  = 0
     4545       other-cli-loco      = 0
     4546     .
     4547   ASSIGN
     4548             price-base-without-tax-loco = price-base-with-tax-loco - vat-base-loco - slt-base-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))
