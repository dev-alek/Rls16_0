     5377     ,output v-root-node
     5378     )  .
     5379   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     5380     (input  v-root-node
     5381     ,input  'empty-scale=request'
     5382     ,output empty-scale
     5383     )  .
     5384       run r-cost in this-procedure ( input buf_doc-line.doc-code  ,input buf_doc-line.artic ,input buf_doc-line.prod-type
     5385               ,input buf_doc-line.prod-code  ,output t-dec       ,output v-vat-pc   ,output v-slt-pc
     5386               ,output v-sum-base             ,output v-sum-rubl  ,output v-vat-base ,output v-vat-rubl
     5387               ,output v-slt-base             ,output v-slt-rubl  ,output t-dec      ,output t-dec
     5388               ,output t-dec   ,output t-dec  ,output t-dec       ,output t-dec      ,output t-dec   ,output t-dec ) no-error .
     5389       if PrintRubl then  assign   stoim   = v-sum-rubl    SLT-sum = v-slt-rubl    VAT-sum = v-vat-rubl  .
     5390       else               assign   stoim   = v-sum-base    SLT-sum = v-slt-base    VAT-sum = v-vat-base  .
     5391       if stoim < 0 then  assign   stoim   = - stoim       SLT-sum = - SLT-sum     VAT-sum = - VAT-sum   .
     5392       find first gds-obj no-lock
     5393         where gds-obj.gds-code = buf_goods.gds-code
     5394           and gds-obj.obj-type = buf_trn-doc.obj-type
     5395           and gds-obj.obj-code = buf_trn-doc.obj-code
     5396         no-error .
     5397       if available gds-obj then do:
     5398         if varr-b = "rubl":u then assign Up-fact = (gds-obj.price-sale - buf_doc-line.price-rubl) / buf_doc-line.price-rubl * 100 .
     5399                              else assign Up-fact = (gds-obj.price-sale - buf_doc-line.price-base) / buf_doc-line.price-base * 100 .
     5400       end.
     5401       else              assign Up-fact = ? .
     5402       assign
     5403         qnty    = buf_doc-line.fact-qnty
     5404         Price   = stoim / qnty
     5405         all-qnty    = all-qnty    + qnty
     5406         all-stoim   = all-stoim   + stoim
     5407         v-vat-pc = round(v-vat-pc,1)
     5408         v-slt-pc = round(v-slt-pc,1)
     5409       .
     5410       find first temp-nalog where temp-nalog.vat-prc = v-vat-pc and temp-nalog.slt-prc = v-slt-pc no-error .
     5411       if not available temp-nalog then do:
     5412         create temp-nalog .
     5413         assign  temp-nalog.vat-prc = v-vat-pc  temp-nalog.slt-prc = v-slt-pc  .
     5414       end.
     5415       assign  temp-nalog.vat-sum = temp-nalog.vat-sum + VAT-sum   temp-nalog.slt-sum = temp-nalog.slt-sum + SLT-sum   .
     5416       find first buf_clients where buf_clients.obj-type = buf_goods.prod-type and buf_clients.obj-code = buf_goods.prod-code no-lock .
     5417       if empty-scale = no and PrintScale = yes and num-form <> 4 then do:
     5418         display stream out_stream
     5419           sym1  Lines_Counter sym2 sym3 buf_goods.artic sym4 gds_name sym5 buf_goods.unit-base sym6 sym7 sym8 sym9
     5420             buf_clients.obj-name
     5421         with frame Zum-rubl.
     5422         down stream out_stream with frame Zum-rubl .
     5423         for each buf_gds-dtl no-lock
     5424           where buf_gds-dtl.doc-code  = buf_doc-line.doc-code
     5425             and buf_gds-dtl.artic     = buf_doc-line.artic
     5426             and buf_gds-dtl.prod-type = buf_doc-line.prod-type
     5427             and buf_gds-dtl.prod-code = buf_doc-line.prod-code
     5428           :
     5429   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     5430     (input  buf_goods.gds-code
     5431     ,input  buf_gds-dtl.prt-code
     5432     ,output b-code
     5433     ) no-error .
     5434           if error-status :error then do:
     5435             message vss-workfile vss-revision vss-description skip "Ошибка при определении бар-кода признака" skip  "Код товара" buf_goods.gds-code skip  "Код признака" buf_gds-dtl.prt-code skip
     5436             view-as alert-box error .
     5437           end.
     5438           find first gds-prt where gds-prt.node-code  = buf_gds-dtl.prt-code no-lock no-error .
     5439           if not CostPrice then do:
     5440             if PrintRubl then assign Price = buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl .
     5441             else              assign Price = buf_gds-dtl.price-base - buf_gds-dtl.discnt-base .
     5442           end.
     5443           display stream out_stream
     5444             sym1  sym2  sym3 sym4 ('  /'+ gds-prt.f-name)  @  gds_name  sym5 sym6
     5445             Price sym7   buf_gds-dtl.fact-qnty @ qnty  sym8 (buf_gds-dtl.fact-qnty * Price ) @ stoim sym9
     5446           with frame Zum-rubl.
     5447           down stream out_stream with frame Zum-rubl .
     5448         end.
     5449       end.
     5450       else do:
     5451         display stream out_stream
     5452           sym1 Lines_Counter sym2 sym3 buf_goods.artic sym4 gds_name sym5 buf_goods.unit-base sym6  Price sym7 qnty sym8 stoim sym9
     5453             buf_clients.obj-name
     5454         with frame Zum-rubl.
     5455         down stream out_stream with frame Zum-rubl .
     5456         if buf_goods.engl-name <> "" then  do:
     5457           display stream out_stream sym1 sym2 sym3 sym4 buf_goods.engl-name  @ gds_name  sym5 sym6 sym8 sym7 sym9  with frame Zum-rubl .
     5458           down stream out_stream 1 with frame Zum-rubl .
     5459         end.
     5460         if num-form = 4 then do:
     5461           goods_PS = ENTRY( 1, buf_goods.PS , chr( 10 ) ) .
     5462           DO i = 2 TO ( NUM-ENTRIES( buf_goods.PS , chr( 10 ) ) ) :
     5463             goods_PS = goods_PS + " " + ENTRY( i, buf_goods.PS , chr( 10 ) ) .
     5464           END.
     5465           goods_PS = trim( goods_PS ) .
     5466           DO WHILE TRUE :
     5467             if length( goods_PS ) <= 134 then do:
     5468               PUT STREAM Out_Stream ":" format "X(1)" goods_PS format "X(134)"  ":"  format "X(1)" SKIP .
     5469               LEAVE .
     5470             end .
     5471             else do:
     5472               goods_PS1 = breakstr(goods_PS, 134, input-output  goods_PS1, input-output  goods_PS2).
     5473               PUT STREAM Out_Stream ":" format "X(1)" goods_PS1 format "X(134)"  ":"  format "X(1)" SKIP .
     5474               goods_PS = trim( goods_PS2 ) .
     5475             end.
     5476           END .
     5477         end.
     5478       end.
     5479         end.
     5480         when 3
     5481         then do:
     5482   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     5483     (input  buf_goods.gds-code
     5484     ,input  ?
     5485     ,output b-code
     5486     ) no-error .
     5487     if error-status :error then do:
     5488       message vss-workfile vss-revision vss-description skip "Ошибка при определении бар-кода товара" skip  "Код товара" buf_goods.gds-code skip
     5489       view-as alert-box error .
     5490     end.
     5491     assign
     5492       gds_name = buf_goods.gds-name
     5493       Lines_Counter = Lines_Counter + 1
     5494       tb-code = string(b-code)
     5495     .
     5496   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5497   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     5498     (input  buf_goods.artic
     5499     ,input  buf_goods.prod-type
     5500     ,input  buf_goods.prod-code
     5501     ,output v-root-node
     5502     )  .
     5503   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     5504     (input  v-root-node
     5505     ,input  'empty-scale=request'
     5506     ,output empty-scale
     5507     )  .
