     5854         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     5855         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     5856         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     5857                 ) .
     5858   end.
     5859       end.
     5860       else do:
     5861   if g#quest-print = false
     5862   then do:
     5863     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     5864                                         7, (if 4 >= 8 then 2 else 0), 0, 0,
     5865                                         OUTPUT g#log ).
     5866   end.
     5867   else do:
     5868     os-command silent
     5869       value( "COPY /b " +
     5870         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     5871         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     5872         string( session:temp-directory) +  "$" + string( g#report-num )
     5873                 ) .
     5874     os-command silent
     5875       value( "COPY /b " +
     5876         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     5877         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     5878         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     5879                 ) .
     5880   end.
     5881       end.
     5882   end procedure.
