     5085         then do:
     5086           for each buf_doc-line no-lock
     5087             where buf_doc-line.doc-code = buf_trn-doc.doc-code
     5088             , first buf_goods no-lock
     5089               where buf_goods.artic      = buf_doc-line.artic
     5090                 and buf_goods.prod-type  = buf_doc-line.prod-type
     5091                 and buf_goods.prod-code  = buf_doc-line.prod-code
     5092             break by buf_goods.grp-name  by buf_goods.gds-name
     5093           :
     5094             if  first-of( buf_goods.grp-name)
     5095             then do:
     5096               run print-grp in this-procedure .
     5097             end.
     5098             run print-line in this-procedure .
     5099           end.
     5100         end.
     5101         else do:
     5102           for each buf_doc-line
     5103             where buf_doc-line.doc-code = buf_trn-doc.doc-code
     5104             , first buf_goods no-lock
     5105               where buf_goods.artic      = buf_doc-line.artic
     5106                 and buf_goods.prod-type  = buf_doc-line.prod-type
     5107                 and buf_goods.prod-code  = buf_doc-line.prod-code
     5108             break by buf_goods.grp-name  by buf_doc-line.num-place
     5109           :
