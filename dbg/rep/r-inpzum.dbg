     5042           end.
     5043         end.
     5044       end.
     5045       else do:
     5046         if sort-name = yes
     5047         then do:
     5048           for each buf_doc-line no-lock
     5049             where buf_doc-line.doc-code = buf_trn-doc.doc-code
     5050             , first buf_goods no-lock
     5051             where buf_goods.artic      = buf_doc-line.artic
     5052               and buf_goods.prod-type  = buf_doc-line.prod-type
