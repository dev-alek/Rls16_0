     4942     find first buf_trn-doc no-lock where recid( buf_trn-doc ) = rec_id  .
     4943     define variable v-host-code             as integer              no-undo.
     4944   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4945   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4946     (input  buf_trn-doc.obj-type
     4947     ,input  buf_trn-doc.obj-code
     4948     ,output v-host-code
     4949     )  .
     4950     run torgconf-read in this-procedure ( input "oldinp", input v-host-code, input buf_trn-doc.obj-type, input buf_trn-doc.obj-code) no-error.
     4951     if error-status :error
     4952     then do:
     4953       message   vss-workfile vss-revision vss-description  skip "Ошибка чтения параметров печати формы." skip "Форма будет напечатана с параметрами по умолчанию."
     4954         skip return-value  skip trim(error-status :get-message(1)) trim(error-status :get-message(2)) trim(error-status :get-message(3))
     4955       view-as alert-box error.
     4956     end.
     4957     if v-torgconf-outnum = yes then  assign v-doc-code = fill( " ", 10 )  .
     4958     else                             assign v-doc-code = buf_trn-doc.doc-code .
     4959     if v-torgconf-outdate = yes then assign v-doc-date-string = fill( " ", 10 )  .
     4960     else                             assign v-doc-date-string = string( buf_trn-doc.doc-date, "99.99.9999" )  .
     4961     if session:set-wait-state("compiler") then.
     4962     Line = fill("-", 200) .
     4963     Lines_Counter = 0 .
     4964     if in-cur-rate
     4965     then do:
     4966       find last curr-accnt no-lock where curr-accnt.curr-code = v-base-code and curr-accnt.exch-date <= today no-error .
     4967       find last curr-shop no-lock
     4968         where curr-shop.curr-code = v-base-code
     4969           and curr-shop.obj-code  = store-code
     4970           and curr-shop.obj-type  = store-type
     4971         use-index pi  no-error .
     4972       if store-type = 'маг':U
     4973       then do:
     4974         if available curr-shop  then assign rate = curr-shop.exch-rate / curr-shop.exch-scale .
     4975       end.
     4976       else do:
     4977         if available curr-accnt then assign rate = curr-accnt.exch-rate / curr-accnt.exch-scale .
     4978       end.
     4979       assign Rubl_Coeff = rate.
     4980     end.
     4981     else assign Rubl_Coeff = buf_trn-doc.base-rate / buf_trn-doc.base-scale.
     4982     find Our_Object  where Our_Object.obj-type  = buf_trn-doc.obj-type and Our_Object.obj-code  = buf_trn-doc.obj-code  no-lock.
     4983     find Our_Host    where Our_Host.obj-type    = 'орг':U               and Our_Host.obj-code    = buf_trn-doc.host-code no-lock.
     4984     find buf_clients where buf_clients.obj-type = buf_trn-doc.cli-type and buf_clients.obj-code = buf_trn-doc.cli-code  no-lock .
     4985     if can-do('факт':U, buf_trn-doc.status_ )
     4986     or ( can-do('накл':U, buf_trn-doc.status_) and buf_trn-doc.flag_ )
     4987     then do:
     4988       if buf_trn-doc.internal then assign num-form = 2 .
     4989       else do:
     4990         if g#inp-jewel then assign num-form = 4 .
     4991         else                assign num-form = 3 .
     4992       end.
     4993     end.
     4994     else  assign num-form = 1 .
     4995   output stream Out_stream to value( string( session:temp-directory +
     4996                                        "rpt" + string( g#report-num ) ) )
     4997                                        page-size 62 .
     4998     run print-titul in this-procedure .
