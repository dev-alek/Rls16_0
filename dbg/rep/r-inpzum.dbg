     5025           for each buf_doc-line
     5026             where buf_doc-line.doc-code = buf_trn-doc.doc-code
     5027             , first buf_goods no-lock
     5028               where buf_goods.artic      = buf_doc-line.artic
     5029                 and buf_goods.prod-type  = buf_doc-line.prod-type
     5030                 and buf_goods.prod-code  = buf_doc-line.prod-code
     5031             break by buf_doc-line.prod-type by buf_doc-line.prod-code by buf_goods.grp-name  by buf_doc-line.num-place
     5032           :
     5033             if  first-of( buf_doc-line.prod-code)
     5034             then do:
     5035               run print-prod in this-procedure .
