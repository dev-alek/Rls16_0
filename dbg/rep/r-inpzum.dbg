     5066             , first buf_goods no-lock
     5067             where buf_goods.artic      = buf_doc-line.artic
     5068                 and buf_goods.prod-type  = buf_doc-line.prod-type
     5069                 and buf_goods.prod-code  = buf_doc-line.prod-code
     5070             break by buf_doc-line.prod-type by buf_doc-line.prod-code by buf_doc-line.num-place
     5071           :
