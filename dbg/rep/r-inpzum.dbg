     1070       define variable v-outprim   as character     no-undo.
     1071       define variable v-outdisc   as character     no-undo.
     1072       define variable v-outsubs   as character     no-undo.
     1073       define variable v-outrecv   as character     no-undo.
     1074       define variable v-outegrp   as character     no-undo.
     1075       define variable v-outt12    as character     no-undo.
     1076       define variable v-outappr   as character     no-undo.
     1077       define variable v-outrubl   as character     no-undo.
     1078       define variable v-outhold   as character     no-undo.
