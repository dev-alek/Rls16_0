     1634   procedure torgconf-get-sup-param :
     1635   define input parameter p-obj-type           as character        no-undo.
     1636   define input parameter p-obj-code           as integer          no-undo.
     1637   define input parameter p-curr-code          as integer          no-undo.
     1638       define variable v-host-code    as integer      no-undo.
     1639       define variable v-par-type     as character    no-undo.
     1640   do
     1641   on error undo, return error
     1642   :
     1643       assign
     1644          v-torgconf-sup-host-code = v-host-code
     1645       .
     1646       if v-torgconf-sup-host-code = 0
     1647       then do:
     1648           assign
     1649               v-torgconf-sup-host-name           = "":U
     1650               v-torgconf-sup-host-addres         = "":U
     1651               v-torgconf-sup-host-post-addres    = "":U
     1652               v-torgconf-sup-host-phone          = "":U
     1653               v-torgconf-sup-host-inn            = "":U
     1654               v-torgconf-sup-host-kpp            = "":U
     1655               v-torgconf-sup-host-okpo           = "":U
     1656               v-torgconf-sup-host-egrip-date     = "":U
     1657               v-torgconf-sup-host-egrip-num      = "":U
     1658           .
     1659       end.
     1660       else do:
     1661           run fmtcli-get-client in this-procedure (
     1662                 input 'орг':U
     1663               , input v-torgconf-sup-host-code
     1664           ).
     1665           assign
     1666               v-torgconf-sup-host-name        = v-fmtcli-name
     1667               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     1668               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     1669               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     1670               v-torgconf-sup-host-phone       = v-fmtcli-phone
     1671               v-torgconf-sup-host-inn         = v-fmtcli-inn
     1672               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     1673               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     1674           .
     1675           run gbl/clntat-v.p (
     1676                 input 'орг':U
     1677               , input v-torgconf-sup-host-code
     1678               , input 'egrip-date':U
     1679               , output v-torgconf-sup-host-egrip-date
     1680               , output v-par-type
     1681           ).
     1682           run gbl/clntat-v.p (
     1683                 input 'орг':U
     1684               , input v-torgconf-sup-host-code
     1685               , input 'egrip-num':U
     1686               , output v-torgconf-sup-host-egrip-num
     1687               , output v-par-type
     1688           ).
     1689           run fmtcli-get-bank in this-procedure (
     1690                 input v-host-code
     1691               , input 'орг':U
     1692               , input v-torgconf-sup-host-code
     1693               , input p-curr-code
     1694           ).
     1695       end.
     1696       assign
     1697           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     1698           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     1699           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     1700           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     1701           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     1702           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     1703           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     1704           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     1705       .
     1706       assign
     1707           v-torgconf-sup-obj-type = p-obj-type
     1708           v-torgconf-sup-obj-code = p-obj-code
     1709       .
     1710       if trim(p-obj-type) <> ""
     1711       and p-obj-code <> 0
     1712       then do:
     1713       run fmtcli-get-client in this-procedure (
     1714             input p-obj-type
     1715           , input p-obj-code
     1716       ).
     1717       assign
     1718           v-torgconf-sup-obj-name        = v-fmtcli-name
     1719           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     1720           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     1721           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1722           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     1723           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     1724           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     1725       .
     1726      end.
     1727      end.
     1728   end procedure.
     1729   procedure torgconf-get-cli-param :
     1730   define input parameter p-host-obj-code      as integer          no-undo.
     1731   define input parameter p-obj-type           as character        no-undo.
     1732   define input parameter p-obj-code           as integer          no-undo.
     1733   define input parameter p-curr-code          as integer          no-undo.
     1734       define variable v-host-code    as integer      no-undo.
     1735   do
     1736   on error undo, return error
     1737   :
     1738       assign
     1739           v-torgconf-cli-type = p-obj-type
     1740           v-torgconf-cli-code = p-obj-code
     1741       .
     1742       run fmtcli-get-client in this-procedure (
     1743             input p-obj-type
     1744           , input p-obj-code
     1745       ).
     1746       assign
     1747           v-torgconf-cli-name         = trim( v-fmtcli-name          )
     1748           v-torgconf-cli-engl-name    = trim( v-fmtcli-engl-name          )
     1749           v-torgconf-cli-addres       = trim( v-fmtcli-full-addres   )
     1750           v-torgconf-cli-post-addres  = trim( v-fmtcli-post-addres   )
     1751           v-torgconf-cli-phone        = trim( v-fmtcli-phone         )
     1752           v-torgconf-cli-inn          = trim( v-fmtcli-inn           )
     1753           v-torgconf-cli-kpp          = trim( v-fmtcli-kpp           )
     1754           v-torgconf-cli-okpo         = trim( v-fmtcli-okpo          )
     1755       .
     1756      run fmtcli-get-bank in this-procedure (
     1757             input p-host-obj-code
     1758           , input p-obj-type
     1759           , input p-obj-code
     1760           , input p-curr-code
     1761       ).
     1762       assign
     1763           v-torgconf-cli-schet-exists = v-fmtcli-schet-exists
     1764           v-torgconf-cli-bank-exists  = v-fmtcli-bank-exists
     1765           v-torgconf-cli-bank-r-schet = v-fmtcli-bank-r-schet
     1766           v-torgconf-cli-bank-c-schet = v-fmtcli-bank-c-schet
     1767           v-torgconf-cli-bank-bik     = v-fmtcli-bank-bik
     1768           v-torgconf-cli-bank-name    = v-fmtcli-bank-name
     1769           v-torgconf-cli-bank-addres  = v-fmtcli-bank-addres
     1770           v-torgconf-cli-bank-city    = v-fmtcli-bank-city
     1771       .
     1772   end.
     1773   end procedure.
     1774   procedure torgconf-get-ship-param :
     1775   define input parameter p-host-obj-code      as integer          no-undo.
     1776   define input parameter p-obj-type           as character        no-undo.
     1777   define input parameter p-obj-code           as integer          no-undo.
     1778   define input parameter p-curr-code          as integer          no-undo.
     1779       define variable v-host-code    as integer      no-undo.
     1780   do
     1781   on error undo, return error
     1782   :
     1783       assign
     1784           v-torgconf-ship-type = p-obj-type
     1785           v-torgconf-ship-code = p-obj-code
     1786       .
     1787       if trim(p-obj-type) = ""
     1788       and p-obj-code = 0
     1789       then do:
     1790       assign
     1791           v-torgconf-ship-name         = "":U
     1792           v-torgconf-ship-addres       = "":U
     1793           v-torgconf-ship-post-addres  = "":U
     1794           v-torgconf-ship-phone        = "":U
     1795           v-torgconf-ship-inn          = "":U
     1796           v-torgconf-ship-kpp          = "":U
     1797           v-torgconf-ship-okpo         = "":U
     1798       .
     1799       end.
     1800       else do:
     1801       run fmtcli-get-client in this-procedure (
     1802             input p-obj-type
     1803           , input p-obj-code
     1804       ).
     1805       assign
     1806           v-torgconf-ship-name         = trim( v-fmtcli-name          )
     1807           v-torgconf-ship-engl-name    = trim( v-fmtcli-engl-name          )
     1808           v-torgconf-ship-addres       = trim( v-fmtcli-full-addres   )
     1809           v-torgconf-ship-post-addres  = trim( v-fmtcli-post-addres   )
     1810           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     1811           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     1812           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     1813           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     1814       .
     1815       end.
     1816           run fmtcli-get-bank in this-procedure (
     1817             input p-host-obj-code
     1818           , input p-obj-type
     1819           , input p-obj-code
     1820           , input p-curr-code
     1821       ).
     1822       assign
     1823           v-torgconf-ship-schet-exists = v-fmtcli-schet-exists
     1824           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
     1825           v-torgconf-ship-bank-r-schet = v-fmtcli-bank-r-schet
     1826           v-torgconf-ship-bank-c-schet = v-fmtcli-bank-c-schet
     1827           v-torgconf-ship-bank-bik     = v-fmtcli-bank-bik
     1828           v-torgconf-ship-bank-name    = v-fmtcli-bank-name
     1829           v-torgconf-ship-bank-addres  = v-fmtcli-bank-addres
     1830           v-torgconf-ship-bank-city    = v-fmtcli-bank-city
     1831       .
     1832   end.
     1833   end procedure.
     1834   procedure torgconf-get-holdfirm-code :
     1835   define input parameter p-obj-type   as character        no-undo.
     1836   define input parameter p-obj-code   as integer          no-undo.
     1837   define output parameter p-firm-code as integer          no-undo.
     1838       define variable v-firm-code-str     as character    no-undo.
     1839       define variable v-par-type          as character    no-undo.
     1840       define buffer buf_clients       for ub.clients.
     1841   do
     1842   for buf_clients
     1843   on error undo, return error
     1844   :
     1845       run gbl/clntat-v.p (
     1846             input p-obj-type
     1847           , input p-obj-code
     1848           , input 'holdfirm-code':U
     1849           , output v-firm-code-str
     1850           , output v-par-type
     1851       ).
     1852       assign
     1853           p-firm-code = integer( v-firm-code-str )
     1854       no-error.
     1855       if error-status :error
     1856       then do:
     1857           message
     1858               "Неверно задан код фирмы для печати накладных."
     1859           view-as alert-box warning.
     1860           assign
     1861               p-firm-code = 0
     1862           .
     1863       end.
     1864       else do:
     1865           find first buf_clients no-lock
     1866                where buf_clients.obj-type = 'орг':U
     1867                  and buf_clients.obj-code = p-firm-code
     1868           no-error.
     1869           if not available buf_clients
     1870           then do:
     1871               message
     1872                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     1873                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     1874               view-as alert-box warning.
     1875               assign
     1876                   p-firm-code = 0
     1877               .
     1878           end.
     1879       end.
     1880   end.
     1881   end procedure.
     1882   procedure torgconf-get-post-head:
     1883   define input  parameter p-obj-type             as character        no-undo.
     1884   define input  parameter p-obj-code             as integer          no-undo.
     1885   define output parameter p-torgconf-post-head   as character        no-undo.
     1886      define variable v-host-code         as integer      no-undo.
     1887      define buffer buf_sysconf     for ub.sysconf.
     1888        assign
     1889         p-torgconf-post-head  = ""
     1890        .
     1891   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1892   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1893     (input  p-obj-type
     1894     ,input  p-obj-code
     1895     ,output v-host-code
     1896     )  .
     1897      find first buf_sysconf no-lock
     1898      where buf_sysconf.host-code = v-host-code
     1899      no-error.
     1900      if available buf_sysconf
     1901      then do:
     1902         assign
     1903            p-torgconf-post-head = buf_sysconf.head-position
     1904         .
     1905      end.
     1906   end procedure.
     1907   procedure torgconf-get-storekeeper:
     1908   define input  parameter p-wrkr                   as integer          no-undo.
     1909   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     1910   define output parameter p-torgconf-post          as character        no-undo.
     1911      define buffer buf_sysconf     for ub.sysconf.
     1912      define buffer buf_person      for ub.person.
     1913      define buffer buf_shop        for ub.shop .
     1914      define buffer buf_store       for ub.store .
     1915      if v-torgconf-outC = "no_print"
     1916      then do:
     1917         assign p-torgconf-post = ""
     1918                p-torgconf-wrkr-name = ""
     1919                .
     1920      end.
     1921      if v-torgconf-outC = "clad_doc"
     1922      then do:
     1923         run rep/get-psn.p
     1924               (input  p-wrkr
     1925               ,output p-torgconf-wrkr-name
     1926               ) .
     1927         find first buf_person no-lock
     1928         where buf_person.psn-code = p-wrkr
     1929         no-error.
     1930         if available buf_person
     1931         then do:
     1932           p-torgconf-post = buf_person.position.
     1933         end.
     1934         if p-torgconf-post = "?":U then p-torgconf-post = "".
     1935         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1936      end.
     1937      if v-torgconf-outC = "clad_obj"
     1938      then do:
     1939         CASE v-torgconf-self-obj-type:
     1940         WHEN 'маг':U
     1941         THEN DO:
     1942            find first buf_shop no-lock
     1943            where buf_shop.obj-code = v-torgconf-self-obj-code
     1944            .
     1945            assign
     1946               p-torgconf-wrkr-name = buf_shop.store-man
     1947               p-torgconf-post = ""
     1948            .
     1949            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1950         END.
     1951         WHEN 'скл':U
     1952         THEN DO:
     1953            find first buf_store no-lock
     1954            where buf_store.obj-code = v-torgconf-self-obj-code
     1955            .
     1956            assign
     1957               p-torgconf-wrkr-name = buf_store.store-man
     1958               p-torgconf-post = ""
     1959            .
     1960            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1961         END.
     1962         OTHERWISE DO:
     1963            assign
     1964               p-torgconf-post = "":U
     1965               p-torgconf-wrkr-name = "":U
     1966            .
     1967         END.
     1968         END CASE.
     1969      end.
     1970    end procedure.
     1971   procedure torgconf-get-form-header :
     1972   define input parameter p-for-inverse    as logical          no-undo.
     1973   define input parameter p-doc-code       as character        no-undo.
     1974   define input parameter p-print-doc      as logical          no-undo.
     1975   define input parameter p-doc-date       as date             no-undo.
     1976   define input parameter p-fact-date      as date             no-undo.
     1977   define input parameter p-doc-type       as character        no-undo.
     1978   define input parameter p-status_        as character        no-undo.
     1979   define input parameter p-reverse        as logical          no-undo.
     1980   define input parameter p-sf-par         as logical          no-undo.
     1981       define variable v-attr-type         as character    no-undo.
     1982       define variable v-doc-code-standard as logical      no-undo.
     1983       define variable v-doc-date-standard as logical      no-undo.
     1984       define variable v-par-consignee-addres  as character    no-undo.
     1985       define variable v-host-code         as integer      no-undo.
     1986       define variable v-dcode-attr        as character    no-undo.
     1987       define variable v-ddate-attr        as character    no-undo.
     1988       define variable v-doc-date          as character    no-undo.
     1989       define variable v-doc-code          as character    no-undo.
     1990       define variable v-par-type          as character    no-undo.
     1991       define variable v-attr              as character    no-undo.
     1992       define buffer buf_firm          for ub.firm .
     1993       define buffer buf_clients       for ub.clients .
     1994       define buffer buf_sysconf       for ub.sysconf .
     1995       define buffer buf_shop          for ub.shop .
     1996       define buffer buf_store         for ub.store .
     1997       define buffer buf_person        for ub.person .
     1998       define buffer buf_trn-doc       for ub.trn-doc .
     1999       define buffer buf_wth-doc       for ub.wth-doc .
     2000       do
     2001   for buf_firm
     2002     , buf_clients
     2003     , buf_sysconf
     2004     , buf_shop
     2005     , buf_trn-doc
     2006     , buf_person
     2007     , buf_wth-doc
     2008   on error undo, return error
     2009   :
     2010       if p-doc-type = 'при':U
     2011       or p-doc-type = 'возврат':U
     2012       then do:
     2013           assign
     2014               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2015                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2016               v-torgconf-suppi            = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2017                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2018               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ),
     2019                                             v-torgconf-self-host-addres, ( if v-torgconf-self-host-phone = "":U then "":U else ", " ),v-torgconf-self-host-phone )
     2020               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-sup-host-name, ( if v-torgconf-sup-host-addres = "":U then "":U else ", " ),
     2021                                             v-torgconf-sup-host-addres, ( if v-torgconf-sup-host-phone = "":U then "":U else ", " ), v-torgconf-sup-host-phone  )
     2022               v-torgconf-supplier-okpo    = v-torgconf-cli-okpo
     2023               v-torgconf-saler-okpo       = v-torgconf-self-host-okpo
     2024               v-torgconf-consignee-okpo   = v-torgconf-sup-host-okpo
     2025               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-cli-code         )
     2026               v-torgconf-supplier-type    = v-torgconf-cli-type
     2027               v-torgconf-saler-code       = substitute( "&1", v-torgconf-self-host-code   )
     2028               v-torgconf-saler-type       = v-torgconf-self-host-type
     2029               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-sup-host-code   )
     2030               v-torgconf-consignee-type   = v-torgconf-sup-host-type
     2031               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-cli-name         )
     2032               v-torgconf-saler-name       = substitute( "&1", v-torgconf-self-host-name   )
     2033               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-sup-host-name   )
     2034               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-cli-addres       )
     2035               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-self-host-addres )
     2036               v-torgconf-consignee-addr   = substitute( "&1", v-torgconf-sup-host-addres )
     2037               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-cli-inn          )
     2038               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-cli-engl-name          )
     2039               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-self-host-inn    )
     2040               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-sup-host-inn    )
     2041               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-cli-kpp          )
     2042               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-self-host-kpp    )
     2043               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-sup-host-kpp    )
     2044           .
     2045           if v-torgconf-cli-schet-exists = yes
     2046           AND v-form-name                  = "torg12":U
     2047           then do:
     2048               assign
     2049                   v-torgconf-supplier = v-torgconf-supplier
     2050                       + substitute( ", р/с &1 к/с &2"
     2051                                   , v-torgconf-cli-bank-r-schet
     2052                                   , v-torgconf-cli-bank-c-schet
     2053                                   )
     2054                   v-torgconf-suppi = v-torgconf-supplier
     2055                       + substitute( ", р/с &1 к/с &2"
     2056                                   , v-torgconf-cli-bank-r-schet
     2057                                   , v-torgconf-cli-bank-c-schet
     2058                                   )
     2059               .
     2060               if v-torgconf-cli-bank-exists = yes
     2061               then do:
     2062                   assign
     2063                       v-torgconf-supplier = v-torgconf-supplier
     2064                           + substitute( " БИК &1 в &2 &3"
     2065                                       , v-torgconf-cli-bank-bik
     2066                                       , v-torgconf-cli-bank-name
     2067                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2068                                       )
     2069                      v-torgconf-suppi = v-torgconf-supplier
     2070                           + substitute( " БИК &1 в &2 &3"
     2071                                       , v-torgconf-cli-bank-bik
     2072                                       , v-torgconf-cli-bank-name
     2073                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2074                                       )
     2075                   .
     2076               end.
     2077           end.
     2078           if v-torgconf-self-schet-exists = yes
     2079           AND v-form-name                  = "torg12":U
     2080           then do:
     2081               assign
     2082                   v-torgconf-saler = v-torgconf-saler
     2083                       + substitute( ", р/с &1 к/с &2"
     2084                                   , v-torgconf-self-bank-r-schet
     2085                                   , v-torgconf-self-bank-c-schet
     2086                                   )
     2087               .
     2088               if v-torgconf-self-bank-exists = yes
     2089               then do:
     2090                   assign
     2091                       v-torgconf-saler = v-torgconf-saler
     2092                           + substitute( " БИК &1 в &2 &3"
     2093                                       , v-torgconf-self-bank-bik
     2094                                       , v-torgconf-self-bank-name
     2095                                       , v-torgconf-self-bank-addres
     2096                                       )
     2097                   .
     2098               end.
     2099           end.
     2100           if v-torgconf-sup-schet-exists = yes
     2101           AND v-form-name                  = "torg12":U
     2102           then do:
     2103               assign
     2104                   v-torgconf-consignee = v-torgconf-consignee
     2105                       + substitute( ", р/с &1 к/с &2"
     2106                                   , v-torgconf-sup-bank-r-schet
     2107                                   , v-torgconf-sup-bank-c-schet
     2108                                   )
     2109               .
     2110             if v-torgconf-sup-bank-exists = yes
     2111              then do:
     2112                assign
     2113                   v-torgconf-consignee = v-torgconf-consignee
