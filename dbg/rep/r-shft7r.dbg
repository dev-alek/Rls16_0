       91   .
       92   procedure create_obj-list :
       93      define input parameter p-obj-type like ub.clients.obj-type no-undo .
       94      define input parameter p-obj-code like ub.clients.obj-code no-undo .
       95      do
       96      on error undo, return error return-value
       97      :
       98         define buffer cli-obj for ub.clients .
       99         define variable p-var as integer no-undo .
      100         define buffer buf_obj-list for obj-list .
      101         find last buf_obj-list  use-index pi no-error .
      102         if available buf_obj-list
      103         then
      104            p-var = buf_obj-list.obj-id + 1.
      105         else
      106            p-var = 1.
      107         find first cli-obj where
      108                   cli-obj.obj-type = p-obj-type
      109               and cli-obj.obj-code = p-obj-code
      110         no-lock no-error.
      111         if available cli-obj
      112         then do:
      113            create buf_obj-list.
      114            assign
      115               buf_obj-list.obj-id   = p-var
      116               buf_obj-list.obj-code = cli-obj.obj-code
      117               buf_obj-list.obj-type = cli-obj.obj-type
      118               buf_obj-list.obj-name = cli-obj.obj-name
      119               buf_obj-list.db-num   = cli-obj.db-num
      120            .
      121         end.
      122      end.
      123   end.
