      485     Col-name[229]=   'HU':U
      486     Col-name[230]=   'HV':U
      487     Col-name[231]=   'HW':U
      488     Col-name[232]=   'HX':U
      489     Col-name[233]=   'HY':U
      490     Col-name[234]=   'HZ':U
      491     Col-name[235]=   'IA':U
      492     Col-name[236]=   'IB':U
      493     Col-name[237]=   'IC':U
      494     Col-name[238]=   'ID':U
      495     Col-name[239]=   'IE':U
      496     Col-name[240]=   'IF':U
      497     Col-name[241]=   'IG':U
      498     Col-name[242]=   'IH':U
      499     Col-name[243]=   'II':U
      500     Col-name[244]=   'IJ':U
      501     Col-name[245]=   'IK':U
      502     Col-name[246]=   'IL':U
      503     Col-name[247]=   'IM':U
      504     Col-name[248]=   'IN':U
      505     Col-name[249]=   'IO':U
      506     Col-name[250]=   'IP':U
      507     Col-name[251]=   'IQ':U
      508     Col-name[252]=   'IR':U
