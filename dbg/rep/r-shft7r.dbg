      513     .
      514    end.
      515   end procedure.
      516   define new global shared variable g#library  as handle no-undo .
      517   define new global shared variable g#library2 as handle no-undo .
      518   define variable var-report-r-b as character no-undo .
      519   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      520   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      521     (output var-report-r-b
      522     )  .
      523   define SHARED temp-table t-7 no-undo
      524   field pump-code like ub.icnt-line.pump-code
      525   field nozzle-code like ub.icnt-line.nozzle-code
      526   field gds-code  like ub.goods.gds-code
      527   field fact-order  like ub.icnt-doc.fact-order
      528   field gds-name  like ub.goods.gds-name
      529   field state-el-cnt like ub.icnt-line.state-el-cnt
      530   field state-mh-cnt like ub.icnt-line.state-mh-cnt
      531   index pi is unique primary
      532     pump-code
      533     nozzle-code
      534     gds-code
      535     fact-order
      536   .
      537   define buffer buf_icnt-doc for ub.icnt-doc .
      538   define buffer buf_icnt-line for ub.icnt-line .
      539   define buffer buf_pump-nozzle for ub.pump-nozzle .
      540   define buffer buf_pl-pump-nozzle for ub.pl-pump-nozzle .
      541   define buffer buf_pl-gds for ub.pl-gds .
      542   define buffer buf_goods for ub.goods .
      543   for each t-7:
      544     delete t-7.
      545   end.
      546   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      547   procedure factord :
      548     define input  parameter p-fact-date            as date    no-undo .
      549     define input  parameter p-fact-time            as integer no-undo .
      550     define input  parameter p-fact-num             as integer no-undo .
      551     define input  parameter p-shift-date           as date    no-undo .
      552     define input  parameter p-shift-num            as integer no-undo .
      553     define input  parameter p-shift-on             as logical no-undo .
      554     define output parameter p-fact-order           as decimal no-undo .
      555     define output parameter p-shift-end-fact-order as decimal no-undo .
      556     define output parameter p-day-end-fact-order   as decimal no-undo .
      557     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      558     if p-fact-date = ?
      559     then do:
      560       return error "Не указана фактическая дата" .
      561     end.
      562     define variable v-fact-date-num as integer no-undo .
      563     assign
      564       v-fact-date-num = integer(p-fact-date)
      565     .
      566     if p-fact-num = ?
      567     or p-fact-num = 0
      568     then do:
      569       return error "Не задан p-fact-num " + string(p-fact-num) .
      570     end.
      571     if p-fact-num < 0
      572     then do:
      573       return error "Отрицательный fact-num " + string(p-fact-num) .
      574     end.
      575     if p-fact-num >= 100000000
      576     then do:
      577       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      578     end.
      579     if p-shift-on = true
      580     then do:
      581       if p-shift-date = ?
      582       then do:
      583         return error "Не задана дата смены" .
      584       end.
      585       if p-shift-num = ?
      586       or p-shift-num = 0
      587       then do:
      588         return error "Не задан номер смены" .
      589       end.
      590     end.
      591     else do:
      592       assign
      593         p-shift-date = p-fact-date
      594         p-shift-num  = 24
      595       .
      596     end.
      597     define variable v-shift-offset as integer no-undo .
      598     if p-shift-date = p-fact-date
      599     then do:
      600       assign
      601         v-shift-offset = 1
      602       .
      603     end.
      604     if p-shift-date < p-fact-date
      605     then do:
      606       assign
      607         v-shift-offset = 0
      608       .
      609     end.
      610     if p-shift-date > p-fact-date
      611     then do:
      612       message
      613         vss-workfile vss-revision vss-description skip
      614         "Неправильная дата закрытия смены" skip
      615         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      616         view-as alert-box error .
      617       undo, return error
      618         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      619           ,string(p-fact-date, '99/99/9999':U)
      620           ,string(p-shift-date, '99/99/9999':U)
      621           )
      622       .
      623     end.
      624     if p-shift-num < 1
      625     or p-shift-num > 24
      626     then do:
      627       message
      628         vss-workfile vss-revision vss-description skip
      629         "Неправильный номер смены" skip
      630         "p-shift-num" p-shift-num skip
      631         view-as alert-box error .
      632       undo, return error return-value .
      633     end.
      634     assign
      635       p-fact-order           = v-fact-date-num
      636                              + v-shift-offset * 0.5
      637                              + p-shift-num    * 0.02 - 0.01
      638                              + p-fact-num     * 0.0000000001
      639       p-shift-end-fact-order = v-fact-date-num
      640                              + v-shift-offset * 0.5
      641                              + p-shift-num    * 0.02
      642       p-day-end-fact-order   = v-fact-date-num
      643                              + 0.99
      644     .
      645     if p-fact-order           <= v-fact-date-num
      646     or p-shift-end-fact-order <= v-fact-date-num
      647     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      648     or p-shift-end-fact-order >= p-day-end-fact-order
      649     then do:
      650       message
      651         vss-workfile vss-revision vss-description skip
      652         "Внутренняя ошибка при генерации фактического номера" skip
      653         "p-fact-date"            p-fact-date            skip
      654         "p-fact-time"            p-fact-time            skip
      655         "p-fact-num"             p-fact-num             skip
      656         "p-shift-date"           p-shift-date           skip
      657         "p-shift-num"            p-shift-num            skip
      658         "p-shift-on"             p-shift-on             skip
      659         "p-shift-end-fact-order" p-shift-end-fact-order skip
      660         "p-day-end-fact-order"   p-day-end-fact-order   skip
      661         "v-fact-date-num"        v-fact-date-num        skip
      662         view-as alert-box error .
      663       undo, return error return-value .
      664     end.
      665   end procedure.
      666   procedure day-begin-fact-order :
      667     define input  parameter p-fact-date            as date    no-undo .
      668     define output parameter p-day-begin-fact-order as decimal no-undo .
      669     do
      670     on error undo, return error return-value
      671     :
      672       if p-fact-date = ?
      673       then do:
      674         assign
      675           p-day-begin-fact-order = 0
      676         .
      677       end.
      678       else do:
      679         assign
      680           p-day-begin-fact-order = integer(p-fact-date)
      681         .
      682       end.
      683     end.
      684   end procedure.
      685   procedure factord-max-fact-order :
      686     define output parameter p-max-fact-order as decimal   no-undo .
      687     do
      688     on error undo, return error return-value
      689     :
      690       run day-begin-fact-order in this-procedure
      691         (input  date(1, 1, 5000)
      692         ,output p-max-fact-order
      693         ) .
      694     end.
      695   end procedure.
      696   procedure factord-cut-archive :
      697     define input  parameter p-obj-type             as character no-undo .
      698     define input  parameter p-obj-code             as integer   no-undo .
      699     define input  parameter p-fact-date            as date      no-undo .
      700     define output parameter p-shift-on             as logical   no-undo .
      701     define output parameter p-shift-date           as date      no-undo .
      702     define output parameter p-shift-num            as integer   no-undo .
      703     define output parameter p-day-end-fact-order   as decimal   no-undo .
      704     define output parameter p-shift-end-fact-order as decimal   no-undo .
      705     define variable v-fact-order as decimal   no-undo .
      706     define buffer buf_shift-obj for ub.shift-obj .
      707     do
      708     on error undo, return error return-value
      709     :
      710   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      711   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      712     (input  p-obj-type
      713     ,input  p-obj-code
      714     ,input  'shift-on=request'
      715     ,output p-shift-on
      716     ) no-error .
      717       if error-status :error
      718       then do:
      719         message
      720           vss-workfile vss-revision vss-description skip
      721           "Ошибка при определении атрибута объекта" skip
      722           "Объект" p-obj-type p-obj-code skip
      723           error-status :get-message(1) skip
      724           return-value skip
      725           view-as alert-box error .
      726         undo, return error return-value .
      727       end.
      728       if p-shift-on = false
      729       then do:
      730         assign
      731           p-shift-date               = ?
      732           p-shift-num                = 0
      733         .
      734       end.
      735       else do:
      736         find first buf_shift-obj share-lock
      737           where buf_shift-obj.obj-type   = p-obj-type
      738             and buf_shift-obj.obj-code   = p-obj-code
      739             and buf_shift-obj.shift-date > p-fact-date
      740           use-index pi
      741           no-error .
      742         if not available buf_shift-obj
      743         or buf_shift-obj.status_ <> 'зкр':U
      744         then do:
      745           message
      746             vss-workfile vss-revision vss-description skip
      747             "Невозможно вычислить последнюю смену" skip
      748             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      749             "Объект" p-obj-type p-obj-code skip
      750             "Дата" p-fact-date skip
      751             view-as alert-box error .
      752           undo, return error return-value .
      753         end.
      754         find last buf_shift-obj share-lock
      755           where buf_shift-obj.obj-type = p-obj-type
      756             and buf_shift-obj.obj-code = p-obj-code
      757             and buf_shift-obj.shift-date <= p-fact-date
      758           use-index pi
      759           no-error .
      760         if available buf_shift-obj
      761         then do:
      762           if  buf_shift-obj.status_ = 'зкр':U
      763           then do:
      764             assign
      765               p-shift-date = buf_shift-obj.shift-date
      766               p-shift-num  = buf_shift-obj.shift-num
      767             .
      768           end.
      769           else do:
      770             message
      771               vss-workfile vss-revision vss-description skip
      772               "Невозможно вычислить последнюю смену" skip
      773               "Статус смены отличен от статуса" 'зкр':U skip
      774               "Объект" p-obj-type p-obj-code skip
      775               "Дата" p-fact-date skip
      776               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      777               view-as alert-box error .
      778             undo, return error return-value .
      779           end.
      780         end.
      781         else do:
      782           assign
      783             p-shift-date = p-fact-date - 1
      784             p-shift-num  = 1
      785           .
      786         end.
      787       end.
      788       run factord in this-procedure
      789         (input  p-fact-date
      790         ,input  1
      791         ,input  1
      792         ,input  p-shift-date
      793         ,input  p-shift-num
      794         ,input  p-shift-on
      795         ,output v-fact-order
      796         ,output p-shift-end-fact-order
      797         ,output p-day-end-fact-order
      798         ) no-error .
      799       if error-status :error
      800       then do:
      801         message
      802           vss-workfile vss-revision vss-description skip
      803           "Ошибка при вызове процедуры factord"
      804           error-status :get-message(1) skip
      805           return-value skip
      806           view-as alert-box error .
      807         undo, return error return-value .
      808       end.
      809     end.
      810   end procedure.
      811   procedure factord-lock-shift :
      812     define input  parameter p-obj-type  as character no-undo .
      813     define input  parameter p-obj-code  as integer   no-undo .
      814     define input  parameter p-fact-date as date      no-undo .
      815     define parameter buffer buf_shift-obj for ub.shift-obj .
      816     define variable v-shift-on      as logical   no-undo .
      817     define variable v-extra-message as character no-undo .
      818     define variable v-error as character no-undo .
      819     do
      820     on error undo, return error return-value
      821     :
      822   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      823   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      824     (input  p-obj-type
      825     ,input  p-obj-code
      826     ,input  'shift-on=request'
      827     ,output v-shift-on
      828     ) no-error .
      829       if error-status :error
      830       then do:
      831         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      832         undo, return error v-error .
      833       end.
      834       if v-shift-on = true
      835       then do:
      836         find first buf_shift-obj share-lock
      837           where buf_shift-obj.obj-type   = p-obj-type
      838             and buf_shift-obj.obj-code   = p-obj-code
      839             and buf_shift-obj.shift-date > p-fact-date
      840           use-index pi
      841           no-error .
      842         if not available buf_shift-obj
      843         or buf_shift-obj.status_ <> 'зкр':U
      844         then do:
      845           find last buf_shift-obj
      846             where buf_shift-obj.obj-type = p-obj-type
      847               and buf_shift-obj.obj-code = p-obj-code
      848               and buf_shift-obj.status_  = 'зкр':U
      849             use-index stts
      850             no-error .
      851           if available buf_shift-obj
      852           then do:
      853             assign
      854               v-extra-message =
      855                     substitute("Дата начала последеней закрытой смены на объекте &1"
      856                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      857                               )
      858             .
      859           end.
      860           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      861           undo, return error v-error .
      862         end.
      863       end.
      864     end.
      865   end procedure.
      866   procedure factord-end-day :
      867     define input  parameter p-fact-date            as date    no-undo .
      868     define output parameter p-day-end-fact-order   as decimal no-undo .
      869     do
      870     on error undo, return error return-value
      871     :
      872       if p-fact-date = ?
      873       then do:
      874         return error "Не указана фактическая дата" .
      875       end.
      876       assign
      877         p-day-end-fact-order = integer(p-fact-date) + 0.99
      878       .
      879     end.
      880   end procedure.
      881   procedure factord-to-date :
      882     define input  parameter p-fact-order as decimal no-undo .
      883     define output parameter p-fact-date  as date    no-undo .
      884     define variable v-ref-date  as date      no-undo .
      885     define variable v-ref-delta as integer   no-undo .
      886     do
      887     on error undo, return error return-value
      888     :
      889       if p-fact-order = ?
      890       or p-fact-order = 0
      891       then do:
      892         return error "Не указан fact-order" .
      893       end.
      894       assign
      895         v-ref-date  = date(1, 1, 2000)
      896       .
      897       assign
      898         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      899       .
      900       assign
      901         p-fact-date = v-ref-date + v-ref-delta
      902       .
      903     end.
      904   end procedure.
      905   procedure factord-to-fact-num :
      906     define input  parameter p-fact-order as decimal no-undo .
      907     define output parameter p-fact-num   as integer no-undo .
      908     define variable v-fact-order-trunc as decimal no-undo .
      909     do
      910     on error undo, return error return-value
      911     :
      912       if p-fact-order = ?
      913       or p-fact-order = 0
      914       then do:
      915         return error "Не указан fact-order" .
      916       end.
      917       assign
      918        v-fact-order-trunc = truncate(p-fact-order, 2)
      919       .
      920       assign
      921         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      922       .
      923     end.
      924   end procedure.
      925   procedure factord-to-shift-num :
      926     define input  parameter p-fact-order as decimal no-undo .
      927     define output parameter p-shift-num   as integer no-undo .
      928     define variable  p-shift-numd  as decimal   no-undo .
      929     define variable v-fact-order-trunc as decimal no-undo .
      930     do
      931     on error undo, return error return-value
      932     :
      933       if p-fact-order = ?
      934       or p-fact-order = 0
      935       then do:
      936         return error "Не указан fact-order" .
      937       end.
      938       assign
      939        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      940       .
      941       if v-fact-order-trunc < 0.5 then do:
      942         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      943       end.
      944       assign
      945         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      946         .
      947        assign
      948         p-shift-num = truncate (p-shift-numd , 0)
      949       .
      950     end.
      951   end procedure.
      952   define buffer end_shift-obj      for ub.shift-obj .
      953   define buffer previous-shift-obj for ub.shift-obj.
      954   define variable fo      as decimal no-undo init 0.
      955   define variable prev-fo as decimal no-undo init 0.
      956   define variable moving  as logical no-undo init yes.
      957   find first end_shift-obj share-lock
      958     where end_shift-obj.obj-type   = pobj-type
      959       and end_shift-obj.obj-code   = pobj-code
      960       and end_shift-obj.shift-date = pshift-date1
      961       and end_shift-obj.shift-num  = pshift-num1
      962       no-error.
      963   if not available end_shift-obj then do:
      964     message
      965       vss-workfile vss-revision vss-description skip
      966       substitute("Не найдена смена с порядковым номером &1 от &2 для объекта &3 &4", pshift-num1, pshift-date1, pobj-type, pobj-code ) skip
      967       view-as alert-box error .
      968     return error.
      969   end.
      970   else do:
      971     assign
      972       fo = end_shift-obj.fact-order
      973     .
      974   end.
      975   find last previous-shift-obj share-lock
      976     where previous-shift-obj.obj-type = pobj-type
      977       and previous-shift-obj.obj-code = pobj-code
      978       and (( previous-shift-obj.shift-date = pshift-date
      979              and previous-shift-obj.shift-num < pshift-num
      980            )
      981            or previous-shift-obj.shift-date < pshift-date
      982           )
      983       use-index pi no-error.
      984   if available previous-shift-obj then do:
      985       if  previous-shift-obj.shift-date < p-previous-shift-date then do:
      986         run day-begin-fact-order in this-procedure (
      987                                                 input  p-previous-shift-date
      988                                                ,output prev-fo).
      989       end.
      990       else do:
      991       assign
      992         prev-fo = previous-shift-obj.fact-order
      993       .
      994       end.
      995   end.
      996   for each buf_icnt-doc no-lock
      997     where buf_icnt-doc.obj-type     = pobj-type
      998       and buf_icnt-doc.obj-code     = pobj-code
      999       and buf_icnt-doc.doc-type     = 'сч-трк-погр':U
     1000       and buf_icnt-doc.ext-doc-type = 'em':U
     1001       and buf_icnt-doc.status_      = 'факт':U
     1002       and buf_icnt-doc.fact-order   >= prev-fo
     1003       and buf_icnt-doc.fact-order   <= fo
     1004   on error undo, return error return-value
     1005   :
     1006     for each buf_icnt-line no-lock
     1007       where buf_icnt-line.doc-code = buf_icnt-doc.doc-code
     1008         and buf_icnt-line.obj-code = buf_icnt-doc.obj-code
     1009         and buf_icnt-line.obj-type = buf_icnt-doc.obj-type
     1010     on error undo, return error return-value
     1011     :
     1012       find first buf_goods no-lock
     1013         where buf_goods.gds-code = buf_icnt-line.gds-code
     1014         no-error .
     1015       create t-7.
     1016       assign
     1017         t-7.pump-code    = buf_icnt-line.pump-code
     1018         t-7.nozzle-code  = buf_icnt-line.nozzle-code
     1019         t-7.gds-code     = buf_icnt-line.gds-code
     1020         t-7.gds-name     = ( if available buf_goods then buf_goods.gds-name else "Неизвестное название" )
     1021         t-7.state-el-cnt = buf_icnt-line.state-el-cnt
     1022         t-7.state-mh-cnt = buf_icnt-line.state-mh-cnt
     1023         t-7.fact-order   = buf_icnt-doc.fact-order
     1024       .
     1025     end.
     1026   end.
