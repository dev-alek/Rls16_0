      380   procedure create_obj-list :
      381      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      382      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      383      do
      384      on error undo, return error return-value
      385      :
      386         define buffer cli-obj for ub.clients .
      387         define variable p-var as integer no-undo .
      388         define buffer buf_obj-list for obj-list .
      389         find last buf_obj-list  use-index pi no-error .
      390         if available buf_obj-list
      391         then
      392            p-var = buf_obj-list.obj-id + 1.
      393         else
      394            p-var = 1.
      395         find first cli-obj where
      396                   cli-obj.obj-type = p-obj-type
      397               and cli-obj.obj-code = p-obj-code
      398         no-lock no-error.
      399         if available cli-obj
      400         then do:
      401            create buf_obj-list.
      402            assign
      403               buf_obj-list.obj-id   = p-var
      404               buf_obj-list.obj-code = cli-obj.obj-code
      405               buf_obj-list.obj-type = cli-obj.obj-type
      406               buf_obj-list.obj-name = cli-obj.obj-name
      407               buf_obj-list.db-num   = cli-obj.db-num
      408            .
      409         end.
      410      end.
      411   end.
