     2548           end.
     2549         end.
     2550       end.
     2551       else do:
     2552         for each buf_temp-diasize-handle
     2553         on error undo move_block, retry move_block
     2554         :
     2555           assign
     2556             v-object-handle = buf_temp-diasize-handle.handle-value
     2557           .
     2558           if v-object-handle <> v-diasize-resize-button
     2559           then do:
     2560             assign
     2561               v-object-handle :col = v-object-handle :col + p-change-value
     2562               no-error .
     2563             if error-status :error
     2564             or error-status :get-message(1) <> ""
     2565             then do:
     2566               undo move_block, retry move_block .
     2567             end.
     2568           end.
     2569         end.
     2570         for each buf_temp-browse-handle
     2571           where buf_temp-browse-handle.browse-type = 'width':u
     2572         on error undo move_block, retry move_block
     2573         :
     2574           assign
     2575             buf_temp-browse-handle.browse-handle :width
     2576               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2577             no-error .
     2578           if error-status :error
     2579           or error-status :get-message(1) <> ""
     2580           then do:
     2581             undo move_block, retry move_block .
     2582           end.
     2583         end.
     2584         assign
     2585           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2586           no-error .
     2587         if error-status :error
     2588         or error-status :get-message(1) <> ""
     2589         then do:
     2590           undo move_block, retry move_block.
     2591         end.
     2592         assign
     2593           frame vs-parts :width = frame vs-parts :width + p-change-value
     2594         no-error .
     2595         if error-status :error
     2596         or error-status :get-message(1) <> ""
     2597         then do:
     2598           undo move_block, retry move_block.
     2599         end.
     2600         if frame vs-parts :scrollable = true
     2601         then do:
     2602           assign
     2603             frame vs-parts :virtual-width = frame vs-parts :virtual-width + p-change-value
     2604           no-error .
     2605           if error-status :error
     2606           or error-status :get-message(1) <> ""
     2607           then do:
     2608             undo move_block, retry move_block.
     2609           end.
     2610         end.
     2611       end.
     2612       if p-move-resize
     2613       then do:
     2614         run diasize_position-resize-button in this-procedure .
     2615       end.
     2616       if v-diasize-wndstore = true
     2617       then do:
     2618         if connected("ub") = true
     2619         then do:
     2620           define variable v-cntxt-db-num        as integer   no-undo .
     2621           define variable v-cntxt-userid        as character no-undo .
     2622           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2623                                             , OUTPUT v-cntxt-userid
     2624                                             ) .
     2625           run gbl/wndsizew.p
     2626             (input  v-cntxt-db-num
     2627             ,input  v-cntxt-userid
     2628             ,input  v-diasize-proc-name
     2629             ,input  'width':u
     2630             ,input  string(frame vs-parts :width - v-diasize-orig-frame-width)
     2631             ) .
     2632         end.
     2633       end.
     2634     end.
     2635     assign
     2636       v-diasize-change-size = false
     2637     .
     2638   end procedure.
     2639   procedure diasize_set-width :
     2640     define input  parameter p-new-width  as decimal   no-undo .
     2641     define input  parameter p-move-resize as logical   no-undo .
     2642     do
     2643     on error undo, return error return-value
     2644     :
     2645       run diasize_change-width in this-procedure
     2646         (input  (p-new-width - frame vs-parts :width)
     2647         ,input  p-move-resize
     2648         ) .
     2649     end.
     2650   end procedure.
     2651   procedure diasize_position-resize-button :
     2652     do with frame vs-parts
     2653     :
     2654       hide v-diasize-resize-button .
     2655       assign
     2656         v-diasize-resize-button :row = frame vs-parts :height - v-diasize-resize-button :height
     2657                     - 1
     2658                     - (frame vs-parts :border-bottom-pixels / session :pixels-per-row)
     2659         v-diasize-resize-button :col = frame vs-parts :width - v-diasize-resize-button :width
     2660                     - 1
     2661                     - (frame vs-parts :border-right-pixels / session :pixels-per-column)
     2662       .
     2663       view v-diasize-resize-button .
     2664     end.
     2665   end procedure.
     2666   on alt-right anywhere
     2667   do:
     2668     run diasize_change-width in this-procedure
     2669       (input 1
     2670       ,input true
     2671       ) .
     2672     return no-apply .
     2673   end.
     2674   on alt-left anywhere
     2675   do:
     2676     run diasize_change-width in this-procedure
     2677       (input -1
     2678       ,input true
     2679       ) .
     2680     return no-apply .
     2681   end.
     2682   on alt-down anywhere
     2683   do:
     2684     run diasize_change-height in this-procedure
     2685       (input 1
     2686       ,input true
     2687       ) .
     2688     return no-apply .
     2689   end.
     2690   on alt-up anywhere
     2691   do:
     2692     run diasize_change-height in this-procedure
     2693       (input -1
     2694       ,input true
     2695       ) .
     2696     return no-apply .
     2697   end.
     2698   on alt-enter of frame vs-parts
     2699   do:
     2700     run diasize_maximize in this-procedure
     2701       (input  ?
     2702       ).
     2703     return no-apply .
     2704   end.
     2705   procedure diasize_end-move :
     2706     do
     2707     on error undo, return error return-value
     2708     :
     2709       define variable v-row-delta as decimal   no-undo .
     2710       define variable v-col-delta as decimal   no-undo .
     2711       define variable v-new-row as decimal   no-undo .
     2712       define variable v-new-col as decimal   no-undo .
     2713       assign
     2714         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2715         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2716       .
     2717       assign
     2718         v-row-delta = v-new-row - frame vs-parts :height
     2719         v-col-delta = v-new-col - frame vs-parts :width
     2720       .
     2721       run diasize_change-height in this-procedure
     2722         (input v-row-delta
     2723         ,input true
     2724         ) .
     2725       run diasize_change-width in this-procedure
     2726         (input v-col-delta
     2727         ,input true
     2728         ) .
     2729     end.
     2730   end procedure.
     2731   procedure diasize_maximize :
     2732     define input  parameter p-action as logical   no-undo .
     2733     do
     2734     on error undo, return error return-value
     2735     :
     2736       if p-action = ?
     2737       then do:
     2738         if v-diasize-need-maximize = true
     2739         then do:
     2740           assign
     2741             p-action = true
     2742           .
     2743         end.
     2744         else do:
     2745           assign
     2746             p-action = false
     2747           .
     2748         end.
     2749       end.
     2750       if p-action = true
     2751       then do:
     2752         run diasize_change-height in this-procedure
     2753           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2754               - frame vs-parts :height-chars
     2755           ,input true
     2756           ) .
     2757         run diasize_change-width in this-procedure
     2758           (input session :width-chars
     2759               - frame vs-parts :width-chars
     2760           ,input true
     2761           ) .
     2762         assign
     2763           v-diasize-need-maximize = false
     2764         .
     2765       end.
     2766       else do:
     2767         run diasize_change-width in this-procedure
     2768           (input v-diasize-orig-frame-width
     2769               - frame vs-parts :width-chars
     2770           ,input true
     2771           ) .
     2772         run diasize_change-height in this-procedure
     2773           (input v-diasize-orig-frame-height
     2774               - frame vs-parts :height-chars
     2775           ,input true
     2776           ) .
     2777         assign
     2778           v-diasize-need-maximize = true
     2779         .
     2780       end.
     2781     end.
     2782   end procedure.
     2783   procedure diasize_restore-orig-size :
     2784     do
     2785     on error undo, return error return-value
     2786     :
     2787       assign
     2788         v-diasize-current-frame-width  = frame vs-parts :width
     2789         v-diasize-current-frame-height = frame vs-parts :height
     2790       .
     2791       run diasize_set-height in this-procedure
     2792         (input  v-diasize-orig-frame-height
     2793         ,input  true
     2794         ) .
     2795       run diasize_set-width in this-procedure
     2796         (input  v-diasize-orig-frame-width
     2797         ,input  true
     2798         ) .
     2799     end.
     2800   end procedure.
     2801   procedure diasize_restore-current-size :
     2802     do
     2803     on error undo, return error return-value
     2804     :
     2805       run diasize_set-height in this-procedure
     2806         (input  v-diasize-current-frame-height
     2807         ,input  true
     2808         ) .
     2809       run diasize_set-width in this-procedure
     2810         (input  v-diasize-current-frame-width
     2811         ,input  true
     2812         ) .
     2813     end.
     2814   end procedure.
     2815   procedure diasize_set-browse-handle :
     2816     define input  parameter p-browse-handle as handle   no-undo .
     2817     define buffer buf_temp-browse-handle for temp-browse-handle .
     2818     do
     2819     on error undo, return error return-value
     2820     :
     2821       assign
     2822         v-diasize-browse-handle = p-browse-handle
     2823       .
     2824       for each buf_temp-browse-handle
     2825       on error undo, return error return-value
     2826       :
     2827         delete buf_temp-browse-handle .
     2828       end.
     2829     end.
     2830   end procedure.
     2831   procedure diasize_add_browse :
     2832     define input  parameter p-browse-type   as character no-undo .
     2833     define input  parameter p-browse-handle as handle    no-undo .
     2834     define buffer buf_temp-browse-handle for temp-browse-handle .
     2835     do
     2836     on error undo, return error return-value
     2837     :
     2838       assign
     2839         v-diasize-browse-number = v-diasize-browse-number + 1
     2840       .
     2841       create buf_temp-browse-handle .
     2842       assign
     2843         buf_temp-browse-handle.browse-type   = p-browse-type
     2844         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2845         buf_temp-browse-handle.browse-handle = p-browse-handle
     2846       .
     2847     end.
     2848   end procedure.
     2849   procedure diasize_init :
     2850     define variable v-default-value    as logical   no-undo .
     2851     define variable v-restore-saved    as logical   no-undo .
     2852     define variable v-resize-value-str as character no-undo .
     2853     do
     2854     on error undo, return error return-value
     2855     :
     2856       do with frame vs-parts
     2857       :
     2858         assign
     2859           v-diasize-orig-frame-height = frame vs-parts :height
     2860           v-diasize-orig-frame-width  = frame vs-parts :width
     2861           v-diasize-browse-handle     = browse br-parts :handle
     2862         .
     2863         create button v-diasize-resize-button
     2864         assign
     2865           parent        = frame vs-parts :first-child
     2866           label         = "s"
     2867           height-pixels = 16
     2868           width-pixels  = 16
     2869           visible       = true
     2870           sensitive     = true
     2871           movable       = true
     2872           triggers:
     2873             on end-move persistent run diasize_end-move in this-procedure .
     2874           end triggers.
     2875         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2876         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2877         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2878         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2879         assign
     2880           v-diasize-wndmax = false
     2881         .
     2882         if connected("ub") = true
     2883         then do:
     2884           define variable v-cntxt-db-num        as integer   no-undo .
     2885           define variable v-cntxt-userid        as character no-undo .
     2886           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2887                                             , OUTPUT v-cntxt-userid
     2888                                             ) .
     2889           run gbl/wndpar_r.p
     2890             (input  v-cntxt-db-num
     2891             ,input  v-cntxt-userid
     2892             ,input  'wndmax':U
     2893             ,output v-diasize-wndmax
     2894             ,output v-default-value
     2895             ) .
     2896         end.
     2897         assign
     2898           v-diasize-wndstore = false
     2899         .
     2900         if connected("ub") = true
     2901         then do:
     2902           run gbl/wndpar_r.p
     2903             (input  v-cntxt-db-num
     2904             ,input  v-cntxt-userid
     2905             ,input  'wndstore':U
     2906             ,output v-diasize-wndstore
     2907             ,output v-default-value
     2908             ) .
     2909         end.
     2910         assign
     2911           v-diasize-proc-name = entry(1, program-name(2), '.')
     2912         .
     2913         if v-diasize-wndstore = true
     2914         then do:
     2915           assign
     2916             v-restore-saved = false
     2917           .
     2918           if connected("ub") = true
     2919           then do:
     2920             run gbl/wndsizer.p
     2921               (input  v-cntxt-db-num
     2922               ,input  v-cntxt-userid
     2923               ,input  v-diasize-proc-name
     2924               ,input  'height':u
     2925               ,output v-resize-value-str
     2926               ) .
     2927             if v-resize-value-str <> '':U
     2928             then do:
     2929               run diasize_change-height in this-procedure
     2930                 (input  integer(v-resize-value-str)
     2931                 ,input  true
     2932                 ) .
     2933               assign
     2934                 v-restore-saved = true
     2935               .
     2936             end.
     2937           end.
     2938           if connected("ub") = true
     2939           then do:
     2940             run gbl/wndsizer.p
     2941               (input  v-cntxt-db-num
     2942               ,input  v-cntxt-userid
     2943               ,input  v-diasize-proc-name
     2944               ,input  'width':u
     2945               ,output v-resize-value-str
     2946               ) .
     2947             if v-resize-value-str <> '':U
     2948             then do:
     2949               run diasize_change-width in this-procedure
     2950                 (input  integer(v-resize-value-str)
     2951                 ,input  true
     2952                 ) .
     2953               assign
     2954                 v-restore-saved = true
     2955               .
     2956             end.
     2957           end.
     2958           if v-restore-saved <> true
     2959           then do:
     2960             if v-diasize-wndmax = true
     2961             then do:
     2962               run diasize_maximize in this-procedure
     2963                 (input  true
     2964                 ) .
     2965             end.
     2966           end.
     2967         end.
     2968         else do:
     2969           if v-diasize-wndmax = true
     2970           then do:
     2971             run diasize_maximize in this-procedure
     2972               (input  true
     2973               ) .
     2974           end.
     2975         end.
     2976       end.
     2977     end.
     2978   end procedure.
     2979   procedure diasize_need-full-display :
     2980     define output parameter p-need-full-display as logical   no-undo .
     2981     do
     2982     on error undo, return error return-value
     2983     :
     2984       assign
     2985         p-need-full-display = v-diasize-need-full-display
     2986       .
     2987       assign
     2988         v-diasize-need-full-display = false
     2989       .
     2990     end.
     2991   end procedure.
     2992   procedure get-context :
     2993      define output parameter p-db-num as integer          no-undo.
     2994      define output parameter p-user-id as character        no-undo.
     2995      define variable v-login               as character    no-undo.
     2996      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2997      define buffer buf_user-login  for ub.user-login .
     2998      do
     2999      on error undo, return error
     3000      :
     3001            FIND FIRST buf_sys-ctrl no-lock.
     3002            ASSIGN
     3003               v-login = USERID("ub")
     3004               p-db-num = buf_sys-ctrl.db-num
     3005            .
     3006            FIND FIRST buf_user-login
     3007                 WHERE buf_user-login.db-num = p-db-num
     3008                   AND buf_user-login.user-login = v-login
     3009                 no-lock
     3010                 no-error
     3011                 .
     3012            IF AVAILABLE buf_user-login
     3013            THEN DO:
     3014               assign
     3015                  p-user-id = buf_user-login.user-id
     3016               .
     3017            END.
     3018      end.
     3019   end procedure.
     3020       run diasize_init in this-procedure .
     3021   MAIN-BLOCK:
     3022   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3023      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3024     run get-report-num in parparentproc(output g#report-num).
     3025   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3026   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3027     (input  p-curr-obj-type
     3028     ,input  p-curr-obj-code
     3029     ,output v-host-code
     3030     )  .
     3031   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3032   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     3033     (input  v-host-code
     3034     ,output v-base-code
     3035     )  .
     3036     find first buf_rep_currency no-lock
     3037     where buf_rep_currency.curr-code = v-base-code
     3038     no-error .
     3039     if available buf_rep_currency then base-type = buf_rep_currency.curr-abbr .
     3040                 else base-type = "б.в." .
     3041     RUN calc.
     3042     assign
     3043     MENU-ITEM m-cycle-rubl:label in menu m-cycle = "в рублях"
     3044     tot-in-sum0-rubl:label = "сумма (руб)"
     3045     .
     3046     RUN enable_UI.
     3047     assign b-print:MENU-MOUSE = 1.
     3048     if gds-art = "" then
     3049         FRAME vs-parts:TITLE = string( "Приходные партии товара: " +
     3050                                                                           suppl-gds.artic + " " + suppl-gds.gds-name ).
     3051     else
     3052         do:
     3053             if num-doc = "" then
     3054                 FRAME vs-parts:TITLE = string( "Поставки с: " + string(from-date,"99/99/9999") +
     3055                                                                                   " по: " + string(to-date,"99/99/9999") +
     3056                                                                                   " Поставщик: " + supplier.obj-name +
     3057                                                                                   " (" + supplier.obj-type + " " + string(supplier.obj-code) + ")" ).
     3058             else
     3059                 do:
     3060                     find ub.trn-doc where ub.trn-doc.doc-code = num-doc no-lock.
     3061                     FRAME vs-parts:TITLE = string( "Поставки по документу: " + num-doc + " от " + string( ub.trn-doc.fact-date, "99/99/9999" ) ).
     3062                 end.
     3063         end.
     3064   suppl-parts.p-in-qnty :LABEL        in browse  br-parts = "Приход! количество!c "           + string(from-date,"99/99/99") + " !по " + string(today,"99/99/99").
     3065   suppl-parts.p-in-sum0-rubl :LABEL   in browse  br-parts = "Приход сумма!уч. цен (руб)!с "   + string(from-date,"99/99/99") + " !по " + string(today,"99/99/99").
     3066   suppl-parts.p-in-sum0-base :LABEL   in browse  br-parts = "Приход сумма!уч. цен (б.вал)!с " + string(from-date,"99/99/99") + " !по " + string(today,"99/99/99").
     3067   suppl-parts.p-in-sum0-base :LABEL   in browse  br-parts = "Приход сумма!вал. поставщика!с " + string(from-date,"99/99/99") + " !по " + string(today,"99/99/99").
     3068   suppl-parts.out-qnty :LABEL         in browse  br-parts = "Расход!количество! с "           + "поставки"  + " !по " + string(today,"99/99/99").
     3069   suppl-parts.out-sum0-rubl :LABEL    in browse  br-parts = "Расход сумма!уч. цен (руб)!с "   + "поставки " + " !по " + string(today,"99/99/99").
     3070   suppl-parts.out-sum0-base :LABEL    in browse  br-parts = "Расход сумма!уч. цен (б.вал)!с " + "поставки " + " !по " + string(today,"99/99/99").
     3071   suppl-parts.out-sum-cli :LABEL      in browse  br-parts = "Расход сумма!вал. поставщика!с " + "поставки " + " !по " + string(today,"99/99/99").
     3072   suppl-parts.free-qnty :LABEL        in browse  br-parts = "Остаток!количество!на "          + string(today,"99/99/99").
     3073   suppl-parts.free-sum0-rubl :LABEL   in browse  br-parts = "Остаток сумма!уч. цен (руб)!на " + string(today,"99/99/99").
     3074   suppl-parts.free-sum0-base :LABEL   in browse  br-parts = "Остаток сумма!уч. цен (б.вал)!на " + string(today,"99/99/99").
     3075   suppl-parts.free-sum-cli :LABEL     in browse  br-parts = "Остаток сумма!вал. поставщика!на " + string(today,"99/99/99").
     3076     apply "entry" to br-parts in frame vs-parts.
     3077     WAIT-FOR GO OF FRAME vs-parts.
     3078   END.
     3079   RUN disable_UI.
     3080   PROCEDURE calc :
     3081   def buffer b-parts for ub.parts.
     3082   def var out-qnty like ub.parts.fact-qnty no-undo.
     3083   def var free-qnty like ub.parts.fact-qnty no-undo.
     3084   def var qnty_sale like suppl-gds.qnty-sale no-undo.
     3085   def var f-date as date no-undo.
     3086   def var l-date as date no-undo.
     3087   define buffer buf-trn-doc for ub.trn-doc.
     3088     assign
     3089       v-can-print-cli = true
     3090     .
     3091   if session:set-wait-state("COMPILER") then.
     3092   run waitfram-show in this-procedure ("Подождите...").
     3093   if gds-art = "" then  do:
     3094       FOR EACH ub.parts WHERE ub.parts.host-code = v-host-code
     3095                                                AND ub.parts.artic      = suppl-gds.artic
     3096                                                AND ub.parts.prod-type  = suppl-gds.prod-type
     3097                                                AND ub.parts.prod-code  = suppl-gds.prod-code
     3098                                                AND ub.parts.supp-type  = supplier.obj-type
     3099                                                AND ub.parts.supp-code  = supplier.obj-code
     3100                                                AND ub.parts.out-code   = ub.parts.in-code
     3101                                                AND ub.parts.status_    = yes
     3102                                                AND ub.parts.fact-date <= to-date no-lock ,
     3103                                                       first  buf-trn-doc where
     3104                                                              buf-trn-doc.doc-code =   ub.parts.in-code  and
     3105                                                              buf-trn-doc.doc-type <> 'инв':U
     3106                                                NO-LOCK BREAK
     3107                         by ub.parts.host-code
     3108                         by ub.parts.supp-type
     3109                         by ub.parts.supp-code
     3110                         by ub.parts.status_
     3111                         by ub.parts.fact-date
     3112                         BY ub.parts.fact-date :
     3113   find ub.goods where ub.goods.artic = ub.parts.artic
     3114                                     and ub.goods.prod-type = ub.parts.prod-type
     3115                                     and ub.goods.prod-code = ub.parts.prod-code no-lock.
     3116   assign
     3117       l-date = ub.parts.fact-date
     3118       qnty_sale = 0
     3119       .
     3120   if prev-exch-code <> ? and prev-exch-code <> ub.parts.exch-code then
     3121       assign prev-exch-code = ?
     3122       v-can-print-cli = false
     3123       .
     3124   for each b-parts where b-parts.artic = ub.parts.artic
     3125                                               and b-parts.prod-type = ub.parts.prod-type
     3126                                               and b-parts.prod-code = ub.parts.prod-code
     3127                                               and b-parts.status_ = yes
     3128                                               and b-parts.doc-type = 'рас':U no-lock,
     3129       each  ub.parts-attr where
     3130             ub.parts-attr.gds-code  = ub.goods.gds-code and
     3131             ub.parts-attr.in-code   = b-parts.in-code and
     3132             ub.parts-attr.part-code = b-parts.part-code
     3133              no-lock ,
     3134        each ub.trn-doc where ub.trn-doc.doc-code = b-parts.out-code
     3135                                               and ub.trn-doc.internal = no no-lock
     3136                                               break
     3137         by b-parts.artic
     3138         by b-parts.prod-type
     3139         by b-parts.prod-code
     3140         by b-parts.status_
     3141         by b-parts.rsrv-free
     3142         by b-parts.fact-date
     3143   :
     3144       if last-of( b-parts.fact-date ) then
     3145           assign qnty_sale = qnty_sale + 1.
     3146       if last( b-parts.fact-date ) and l-date - 1 < b-parts.fact-date then
     3147           assign l-date = b-parts.fact-date + 1.
     3148   end.
     3149   for each b-parts where b-parts.artic = ub.parts.artic
     3150                        and b-parts.prod-type = ub.parts.prod-type
     3151                        and b-parts.prod-code = ub.parts.prod-code
     3152                        and b-parts.out-code = 'out-zone':U
     3153                        and b-parts.fact-date >=  ub.parts.fact-date
     3154                        and b-parts.fact-date <= to-date
     3155                        no-lock ,
     3156       each  ub.parts-attr where
     3157             ub.parts-attr.gds-code  = ub.goods.gds-code and
     3158             ub.parts-attr.in-code   = b-parts.in-code and
     3159             ub.parts-attr.part-code = b-parts.part-code and
     3160             ub.parts-attr.income-in-code = ub.parts.out-code no-lock
     3161                :
     3162       accumulate b-parts.fact-qnty (total).
     3163   end.
     3164   assign out-qnty = (accum total b-parts.fact-qnty) .
     3165   for each b-parts where b-parts.artic = ub.parts.artic
     3166                        and b-parts.prod-type = ub.parts.prod-type
     3167                        and b-parts.prod-code = ub.parts.prod-code
     3168                        and b-parts.out-code = 'free-zone':U
     3169                        and b-parts.fact-date >= ub.parts.fact-date
     3170                        and b-parts.fact-date <= to-date
     3171                        no-lock ,
     3172       each  ub.parts-attr where
     3173             ub.parts-attr.gds-code  = ub.goods.gds-code and
     3174             ub.parts-attr.in-code   = b-parts.in-code and
     3175             ub.parts-attr.part-code = b-parts.part-code and
     3176             ub.parts-attr.income-in-code = ub.parts.out-code no-lock
     3177                :
     3178       accumulate b-parts.fact-qnty (total).
     3179   end.
     3180   assign free-qnty = (accum total b-parts.fact-qnty) .
     3181   if free-qnty > 0 then
     3182       assign l-date = today + 1.
     3183   assign
     3184     price-rubl-with-tax-loc = ub.parts.price-rubl
     3185     price-base-with-tax-loc = ub.parts.price-base
     3186   .
     3187   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3188   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3189     (output varinvprb
     3190     )  .
     3191     if ub.parts.out-code = 'free-zone':U     or
     3192        ub.parts.out-code = 'out-zone':U   or
     3193        ub.parts.doc-type = 'акт':U then do:
     3194       assign
     3195         in-vatp-have-vat-slt = yes.
     3196     end.
     3197     else do:
     3198       find first in-vatp_doc-attr no-lock
     3199         where in-vatp_doc-attr.doc-code  = ub.parts.out-code
     3200           and in-vatp_doc-attr.attr-code = 'envd':U
     3201         no-error .
     3202       if not available in-vatp_doc-attr then do:
     3203         assign
     3204           in-vatp-have-vat-slt = yes.
     3205       end.
     3206       else do:
     3207            in-vatp-have-vat-slt = no.
     3208       end.
     3209     end.
     3210     assign
     3211      price-cli-with-tax-loc = ub.parts.price-cli
     3212      cli-base-rate          = ub.parts.cli-base-rate.
     3213     ASSIGN   road-tax-base-loc  = (if ub.parts.road-tax-base  = ? then 0 else ub.parts.road-tax-base)
     3214              road-tax-rubl-loc  = (if ub.parts.road-tax-rubl  = ? then 0 else ub.parts.road-tax-rubl).
     3215     ASSIGN  transport-base-loc = (if ub.parts.transport-base = ? then 0 else ub.parts.transport-base)
     3216             transport-rubl-loc = (if ub.parts.transport-rubl = ? then 0 else ub.parts.transport-rubl)
     3217             other-base-loc     = (if ub.parts.other-base     = ? then 0 else ub.parts.other-base)
     3218             other-rubl-loc     = (if ub.parts.other-rubl     = ? then 0 else ub.parts.other-rubl)
     3219             vat-pc-loc         = (if ub.parts.vat-pc         = ? then 0 else ub.parts.vat-pc)
     3220             slt-pc-loc         = (if ub.parts.slt-pc         = ? then 0 else ub.parts.slt-pc).
     3221             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     3222       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     3223     assign
     3224       exch-rate-cli-loc = (ub.parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if ub.parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if ub.parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / ub.parts.price-cli .
     3225     assign
     3226       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     3227       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     3228       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     3229       transport-cli-loc  = 0
     3230       other-cli-loc      = 0
     3231     .
     3232   ASSIGN
     3233             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     3234       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     3235   .
     3236   accumulate
     3237       ub.parts.fact-qnty (total)
     3238       ub.parts.fact-qnty * ub.parts.price-rubl (total)
     3239       ub.parts.fact-qnty * ub.parts.price-base (total)
     3240       out-qnty (total)
     3241       out-qnty * ub.parts.price-rubl (total)
     3242       out-qnty * ub.parts.price-base (total)
     3243       free-qnty (total)
     3244       free-qnty * vat-rubl-loc (total)
     3245       free-qnty * vat-base-loc (total)
     3246       free-qnty * price-rubl-with-tax-loc (total)
     3247       free-qnty * price-base-with-tax-loc (total)
     3248       .
     3249   create suppl-parts.
     3250   assign
     3251       suppl-parts.num-doc = num-doc
     3252       suppl-parts.artic = ub.parts.artic
     3253       suppl-parts.prod-type = ub.parts.prod-type
     3254       suppl-parts.prod-code = ub.parts.prod-code
     3255       suppl-parts.gds-code = ub.goods.gds-code
     3256       suppl-parts.gds-name = ub.goods.gds-name
     3257       suppl-parts.doc-type = ub.parts.doc-type
     3258       suppl-parts.in-code  = ub.parts.in-code
     3259       suppl-parts.out-code = ub.parts.out-code
     3260       suppl-parts.fact-date   = ub.parts.fact-date
     3261       suppl-parts.price0-base = ub.parts.price-base
     3262       suppl-parts.price0-rubl = ub.parts.price-rubl
     3263       suppl-parts.price-cli = ub.parts.price-cli / ub.parts.cli-base-rate
     3264       suppl-parts.obj-type  = ub.parts.obj-type
     3265       suppl-parts.obj-code  = ub.parts.obj-code
     3266       suppl-parts.part-code = ub.parts.part-code
     3267       suppl-parts.in-qnty   = ub.parts.fact-qnty
     3268       suppl-parts.in-sum0-rubl = ub.parts.fact-qnty * ub.parts.price-rubl
     3269       suppl-parts.in-sum0-base = ub.parts.fact-qnty * ub.parts.price-base
     3270       suppl-parts.in-sum-cli   = ub.parts.fact-qnty * ub.parts.price-cli / ub.parts.cli-base-rate
     3271       suppl-parts.p-in-qnty      = if (ub.parts.fact-date < from-date) then 0 else (ub.parts.fact-qnty)
     3272       suppl-parts.p-in-sum0-rubl = if (ub.parts.fact-date < from-date) then 0 else (ub.parts.fact-qnty * ub.parts.price-rubl)
     3273       suppl-parts.p-in-sum0-base = if (ub.parts.fact-date < from-date) then 0 else (ub.parts.fact-qnty * ub.parts.price-base)
     3274       suppl-parts.p-in-sum-cli   = if (ub.parts.fact-date < from-date) then 0 else (ub.parts.fact-qnty * ub.parts.price-cli / ub.parts.cli-base-rate)
     3275       suppl-parts.out-qnty = out-qnty
     3276       suppl-parts.out-sum0-rubl = out-qnty * ub.parts.price-rubl
     3277       suppl-parts.out-sum0-base = out-qnty * ub.parts.price-base
     3278       suppl-parts.out-sum-cli = out-qnty * ub.parts.price-cli / ub.parts.cli-base-rate
     3279       suppl-parts.free-qnty = free-qnty
     3280       suppl-parts.free-nds0-rubl = free-qnty * vat-rubl-loc
     3281       suppl-parts.free-nds0-base = free-qnty * vat-base-loc
     3282       suppl-parts.free-sum0-rubl = free-qnty * price-rubl-with-tax-loc
     3283       suppl-parts.free-sum0-base = free-qnty * price-base-with-tax-loc
     3284       suppl-parts.free-sum-cli = free-qnty * ub.parts.price-cli / ub.parts.cli-base-rate
     3285       suppl-parts.qnty-sale = qnty_sale
     3286       suppl-parts.fs-date = ub.parts.fact-date
     3287       suppl-parts.ls-date = l-date
     3288    .
     3289       END.
     3290   end.
     3291   if num-doc = "" and gds-art = 'все':U then do :
     3292          FOR EACH ub.parts WHERE ub.parts.host-code = v-host-code
     3293                                                        AND ub.parts.supp-type = supplier.obj-type
     3294                                                        AND ub.parts.supp-code = supplier.obj-code
     3295                                                        AND ub.parts.status_   = yes
     3296                                                        AND ub.parts.fact-date <= to-date
     3297                                                        AND ub.parts.out-code  = ub.parts.in-code  ,
     3298                                                        first  buf-trn-doc where
     3299                                                               buf-trn-doc.doc-code =   ub.parts.in-code  and
     3300                                                               buf-trn-doc.doc-type <> 'инв':U
     3301                                                        NO-LOCK BREAK
     3302               by ub.parts.host-code
     3303               by ub.parts.supp-type
     3304               by ub.parts.supp-code
     3305               by ub.parts.status_
     3306               BY ub.parts.fact-date
     3307   :
     3308   find ub.goods where ub.goods.artic = ub.parts.artic
     3309                                     and ub.goods.prod-type = ub.parts.prod-type
     3310                                     and ub.goods.prod-code = ub.parts.prod-code no-lock.
     3311   assign
     3312       l-date = ub.parts.fact-date
     3313       qnty_sale = 0
     3314       .
     3315   if prev-exch-code <> ? and prev-exch-code <> ub.parts.exch-code then
     3316       assign prev-exch-code = ?
     3317       v-can-print-cli = false
     3318       .
     3319   for each b-parts where b-parts.artic = ub.parts.artic
     3320                                               and b-parts.prod-type = ub.parts.prod-type
     3321                                               and b-parts.prod-code = ub.parts.prod-code
     3322                                               and b-parts.status_ = yes
     3323                                               and b-parts.doc-type = 'рас':U no-lock,
     3324       each  ub.parts-attr where
     3325             ub.parts-attr.gds-code  = ub.goods.gds-code and
     3326             ub.parts-attr.in-code   = b-parts.in-code and
     3327             ub.parts-attr.part-code = b-parts.part-code
     3328              no-lock ,
     3329        each ub.trn-doc where ub.trn-doc.doc-code = b-parts.out-code
     3330                                               and ub.trn-doc.internal = no no-lock
     3331                                               break
     3332         by b-parts.artic
     3333         by b-parts.prod-type
     3334         by b-parts.prod-code
     3335         by b-parts.status_
     3336         by b-parts.rsrv-free
     3337         by b-parts.fact-date
     3338   :
     3339       if last-of( b-parts.fact-date ) then
     3340           assign qnty_sale = qnty_sale + 1.
     3341       if last( b-parts.fact-date ) and l-date - 1 < b-parts.fact-date then
     3342           assign l-date = b-parts.fact-date + 1.
     3343   end.
     3344   for each b-parts where b-parts.artic = ub.parts.artic
     3345                        and b-parts.prod-type = ub.parts.prod-type
     3346                        and b-parts.prod-code = ub.parts.prod-code
     3347                        and b-parts.out-code = 'out-zone':U
     3348                        and b-parts.fact-date >=  ub.parts.fact-date
     3349                        and b-parts.fact-date <= to-date
     3350                        no-lock ,
     3351       each  ub.parts-attr where
     3352             ub.parts-attr.gds-code  = ub.goods.gds-code and
     3353             ub.parts-attr.in-code   = b-parts.in-code and
     3354             ub.parts-attr.part-code = b-parts.part-code and
     3355             ub.parts-attr.income-in-code = ub.parts.out-code no-lock
     3356                :
     3357       accumulate b-parts.fact-qnty (total).
     3358   end.
     3359   assign out-qnty = (accum total b-parts.fact-qnty) .
     3360   for each b-parts where b-parts.artic = ub.parts.artic
     3361                        and b-parts.prod-type = ub.parts.prod-type
     3362                        and b-parts.prod-code = ub.parts.prod-code
     3363                        and b-parts.out-code = 'free-zone':U
     3364                        and b-parts.fact-date >= ub.parts.fact-date
     3365                        and b-parts.fact-date <= to-date
     3366                        no-lock ,
     3367       each  ub.parts-attr where
     3368             ub.parts-attr.gds-code  = ub.goods.gds-code and
     3369             ub.parts-attr.in-code   = b-parts.in-code and
     3370             ub.parts-attr.part-code = b-parts.part-code and
