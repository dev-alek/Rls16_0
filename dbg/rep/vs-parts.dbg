      368   def
      369   new shared
      370   temp-table  obj-list no-undo
      371     field obj-type like ub.clients.obj-type
      372     field obj-code like ub.clients.obj-code
      373     field obj-name like ub.clients.obj-name
      374     field obj-id   as integer
