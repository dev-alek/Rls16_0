     1153   procedure OpenForExcel :
     1154      define variable v-ch#ExcelApplication as com-handle no-undo .
     1155      define variable v-ch#Workbook         as com-handle no-undo .
     1156      define variable v-ch#Worksheet        as com-handle no-undo .
     1157      os-delete value( string( session:temp-directory ) +
     1158                                 "rpt" + string( g#report-num ) + ".txt":U ) .
     1159      os-delete value( string( session:temp-directory ) +
     1160                                 "rpt" + string( g#report-num ) + ".frm":U ) .
     1161      os-delete value( string( session:temp-directory ) +
     1162                                 "rpt" + string( g#report-num ) + ".txl":U ) .
     1163      if Make-Excel
     1164      then do:
     1165         output stream ForExcel to value( string( session:temp-directory +
     1166                                        "rpt" + string( g#report-num ) + ".txt":U ) ) .
     1167         assign
     1168            v-excel-file = string( session:temp-directory + "rpt" + string( g#report-num ) )
     1169            number-list = 1
     1170         .
     1171         if make-excel-com
     1172         then do:
     1173   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1174   if valid-handle(ch#WorkSheet) then
     1175   RELEASE OBJECT ch#WorkSheet no-error.
     1176   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1177   if valid-handle(ch#Workbook) then
     1178   RELEASE OBJECT ch#Workbook no-error.
     1179   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1180   if valid-handle(ch#ExcelApplication) then
     1181   RELEASE OBJECT ch#ExcelApplication no-error.
     1182            create "Excel.Application" ch#excelApplication connect no-error.
     1183            if error-status:error
     1184            then do :
     1185           create "Excel.Application" ch#excelApplication no-error.
     1186       if error-status :error then do:
     1187           message
     1188           "Ошибка при запуске Excel" skip
     1189           error-status :get-message(1) skip
     1190           view-as alert-box error .
     1191           undo, return error .
     1192       end.
     1193            end.
     1194            assign
     1195               num#str#  = 0.
     1196               v-ch#excelApplication  = ch#excelApplication.
     1197               v-ch#excelApplication:Interactive = false.
     1198               v-ch#excelApplication:ScreenUpdating = false.
     1199               v-ch#excelApplication:Visible = false.
     1200               ch#Workbook  = v-ch#excelApplication:Workbooks:add ().
     1201               ch#WorkSheet = v-ch#excelApplication:Sheets:Item (1).
     1202               v-ch#Worksheet = ch#WorkSheet.
     1203               v-ch#Worksheet:Range ("A1"):Font:Bold = true.
     1204               v-ch#Worksheet:Range ("A1"):Font:Size = 14.
     1205               v-ch#Worksheet:Range ("A1"):HorizontalAlignment = -4131.
     1206               v-ch#Worksheet:Range ("A1"):VerticalAlignment   = -4160
     1207            no-error .
     1208            if error-status:error
     1209            then do:
     1210               Make-Excel-com = false .
     1211               Make-Excel = false .
     1212               output Stream  ForExcel close.
     1213               os-delete value( string( session:temp-directory ) +
     1214                              "rpt" + string( g#report-num ) + ".txt":U ) .
     1215               os-delete value( string( session:temp-directory ) +
     1216                              "rpt" + string( g#report-num ) + ".frm":U ) .
     1217               return.
     1218            end.
     1219         end.
     1220      end.
     1221   end.
     1222   procedure CloseForExcel :
     1223      define variable ii as integer no-undo .
     1224      define variable vsheet-num as integer no-undo.
     1225      if Make-Excel
     1226      then  do:
     1227         output Stream  ForExcel close.
     1228         os-delete value( string( session:temp-directory ) +
     1229                                "rpt" + string( g#report-num ) + ".txt":U ) .
     1230         os-delete value( string( session:temp-directory ) +
     1231                                "rpt" + string( g#report-num ) + ".frm":U ) .
     1232         define buffer buf_sheetf for sheetf.
     1233         find last buf_sheetf no-error .
     1234         if available buf_sheetf
     1235         then
     1236            vsheet-num = buf_sheetf.sheet-num.
     1237         if vsheet-num > 1
     1238         then do:
     1239            do ii = 2 to vsheet-num:
     1240               os-delete value( string( session:temp-directory ) +
     1241                                     "rpt" + string( g#report-num ) + ".":U  + string(ii)) .
     1242            end.
     1243         end.
     1244   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1245   if valid-handle(ch#WorkSheet) then
     1246   RELEASE OBJECT ch#WorkSheet no-error.
     1247   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1248   if valid-handle(ch#Workbook) then
     1249   RELEASE OBJECT ch#Workbook no-error.
     1250   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1251   if valid-handle(ch#ExcelApplication) then
     1252   RELEASE OBJECT ch#ExcelApplication no-error.
     1253      end.
     1254   end.
     1255   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1256   define variable v-waitfram-action01         as character   no-undo .
     1257   define variable v-waitfram-action02         as character   no-undo .
     1258   define variable v-waitfram-action03         as character   no-undo .
     1259   define variable mWaitFramTextBeg            as character   no-undo.
     1260   define variable mWaitFramTextEnd            as character   no-undo.
     1261   define variable mWaitFramView               as logical     no-undo.
     1262   define variable mWaitProcEvent              as logical     no-undo init yes.
     1263   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1264   define variable mWaitFramStop               as logical     no-undo.
     1265   define variable mWaitFramStopUser           as logical     no-undo.
     1266   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1267   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1268   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1269   define button B-WaitFramStop auto-end-key
     1270        label "Стоп"
     1271        size 10 by 1 tooltip "Остоновить процесс".
     1272   define button B-viewProcInfo
     1273        label "Информация"
     1274        size 15 by 1 tooltip "Информация о процесс".
     1275   define frame waitfram
     1276     v-waitfram-action01 format "x(72)" no-label skip
     1277     v-waitfram-action02 format "x(72)" no-label skip
     1278     v-waitfram-action03 format "x(72)" no-label skip
     1279     B-viewProcInfo
     1280     B-WaitFramStop at row 4 col 30
     1281     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1282     .
     1283   define new global shared variable mBatchMode as logical no-undo init ?.
     1284   define variable mFramBachModHandle as handle no-undo.
     1285   mFramBachModHandle = frame waitfram:handle.
     1286   define variable mFameOldVis as logical no-undo.
     1287   define variable mVisCUrentVin as logical no-undo.
     1288   if session:batch-mode
     1289   then
     1290      mBatchMode = yes.
     1291   if mBatchMode = ? then do:
     1292     mVisCUrentVin = current-window:visible.
     1293     mFameOldVis = mFramBachModHandle:visible.
     1294     mFramBachModHandle:visible  = yes.
     1295     mBatchMode = mFramBachModHandle:visible ne yes.
     1296     mFramBachModHandle:visible = mFameOldVis.
     1297     current-window:visible = mVisCUrentVin.
     1298   end.
     1299    if  log-manager:logfile-name ne ?
     1300     then DO:
     1301         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1302         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1303         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1304     end.
     1305   on choose of B-WaitFramStop in frame waitfram
     1306   do:
     1307     mWaitFramStop = yes.
     1308     mWaitFramStopUser = yes.
     1309   end.
     1310   function waitfram-check-timeout returns logical():
     1311      define variable vtime as int64 no-undo.
     1312      if mWaitFramStopTimeOut
     1313      then
     1314         return yes.
     1315      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1316      if     mWaitFramTimeOut ne ?
     1317         and mWaitFramTimeOut ne 0
     1318         and mWaitFramTimeOut lt vtime
     1319      then do:
     1320         mWaitFramStopTimeOut = yes.
     1321      end.
     1322      return mWaitFramStopTimeOut.
     1323   end.
     1324   procedure waitfram-hide :
     1325     if not session:batch-mode
     1326     then do
     1327     on error undo, return error return-value
     1328     :
     1329       pause 0 before-hide .
     1330       if not mBatchMode then
     1331         hide frame waitfram .
     1332     if     not mWaitFramView
     1333        and mWaitProcEvent
     1334     then
     1335       process events .
     1336     end.
     1337   end procedure.
     1338   procedure waitfram-show :
     1339     define input  parameter p-message as character no-undo .
     1340     define variable v-left-margin as integer   no-undo .
     1341     if not session:batch-mode
     1342     then do
     1343     on error undo, return error return-value
     1344     :
     1345       if length(p-message) <= 70 then do:
     1346         assign
     1347           v-left-margin = integer((70 - length(p-message)) / 2)
     1348         .
     1349         assign
     1350           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1351         .
     1352         assign
     1353           v-waitfram-action01 = " "
     1354           v-waitfram-action02 = " "
     1355                                    + fill(" ", v-left-margin)
     1356                                    + p-message
     1357           v-waitfram-action03 = " "
     1358         .
     1359       end.
     1360       else do:
     1361         define variable vRindex1 as integer no-undo.
     1362         define variable vRindex2 as integer no-undo.
     1363         vRindex1 = r-index(p-message," ",70).
     1364         if vRindex1 = 0
     1365         then
     1366            vRindex1 = 70.
     1367         if length(p-message)  <= vRindex1 + 70 then do:
     1368           assign
     1369             v-waitfram-action01 = " "
     1370             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1371             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1372           .
     1373         end.
     1374         else do:
     1375           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1376           if vRindex2 <= vRindex1
     1377           then
     1378              vRindex2 = vRindex1 + 70.
     1379           assign
     1380             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1381             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1382             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1383           .
     1384         end.
     1385       end.
     1386       B-viewProcInfo:visible   in frame waitfram = no.
     1387       B-viewProcInfo:sensitive in frame waitfram = no.
     1388       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1389       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1390       if  (   mWaitFramView
     1391          or  mWaitProcEvent)
     1392          and not mBatchMode
     1393       then
     1394          display
     1395             v-waitfram-action01 skip
     1396             v-waitfram-action02 skip
     1397             v-waitfram-action03 skip
     1398          with frame waitfram .
     1399       if     mWaitFramView
     1400          then do:
     1401             if     mWaitFramInterval ne ?
     1402                and not mBatchMode
     1403             then
     1404                wait-for go of frame waitfram pause mWaitFramInterval.
     1405          end.
     1406          else
     1407             if     mWaitProcEvent
     1408                and not mBatchMode
     1409             then
     1410                process events .
     1411     end.
     1412   end procedure.
     1413      procedure waitfram-show-this:
     1414         define input  parameter iInterval as int64 no-undo.
     1415         define variable vtime as int64 no-undo.
     1416         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1417         mWaitFramInterval = iInterval.
     1418         run waitfram-show (substitute("&1&2 &3&4" ,
     1419                                       mWaitFramTextBeg ,
     1420                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1421                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1422                                       mWaitFramTextEnd
     1423                                      )
     1424                           ).
     1425      end.
     1426      procedure WaitFramRunPause:
     1427         define input  parameter iInterval as dec no-undo.
     1428         define variable vStart  as datetime-tz no-undo.
     1429         define variable vend    as datetime-tz no-undo.
     1430         define variable vint as int64 no-undo.
     1431         define variable vOk as logical no-undo.
     1432         vStart = now.
     1433         vend   = vStart.
     1434         publish "WaitFramPause" (iInterval,output vOk).
     1435         vend   =  now.
     1436         vint = vend - vStart.
     1437         vint = iInterval - vint / 1000.
     1438         if     not mWaitFramStop
     1439            and (   vint > 0
     1440                 or (    not vOk
     1441                     and iInterval eq ?
     1442                     )
     1443                 )
     1444         then
     1445            run waitfram-show-this (iInterval).
     1446         vend   =  now.
     1447         vint = vend - vStart.
     1448         vint = iInterval - vint / 1000.
     1449         if     not mWaitFramStop
     1450            and vint > 0
     1451         then do:
     1452            run gbl/pause.p (vint * 1000).
     1453         end.
     1454         if iInterval ne ?
     1455         then
     1456            publish "WaitFramStop".
     1457         waitfram-check-timeout().
     1458      end.
     1459      procedure WaitFramWaitFor:
     1460         define input  parameter iInterval as dec no-undo.
     1461         assign
     1462            mWaitFramStartProc   = now
     1463            mWaitFramStopUser    = no
     1464            mWaitFramStopTimeOut = no
     1465         .
     1466         block-wait:
     1467         do while not mWaitFramStop:
     1468            run WaitFramRunPause (iInterval).
     1469            if  waitfram-check-timeout()
     1470            then do:
     1471               leave block-wait.
     1472            end.
     1473         end.
     1474         run waitfram-hide.
     1475      end.
     1476   procedure waitfram-join :
     1477     define input  parameter p-line-1  as character no-undo .
     1478     define input  parameter p-line-2  as character no-undo .
     1479     define input  parameter p-line-3  as character no-undo .
     1480     define output parameter p-message as character no-undo .
     1481     do
     1482     on error undo, return error return-value
     1483     :
     1484       assign
     1485         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1486                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1487                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1488       .
     1489     end.
     1490   end procedure.
     1491   function waitfram-join-function returns character
     1492     (input p-line-1 as character
     1493     ,input p-line-2 as character
     1494     ,input p-line-3 as character
     1495     ).
     1496     define variable v-message as character no-undo .
     1497     run waitfram-join in this-procedure
     1498       (input  p-line-1
     1499       ,input  p-line-2
     1500       ,input  p-line-3
     1501       ,output v-message
     1502       ) .
     1503     return v-message .
     1504   end function .
     1505   procedure proc-alt-shift-f2:
     1506     if not ibs.th.gbl.gbl-var:rcode
     1507   then
     1508     run gbl\inidebug.p .
     1509   end.
     1510   procedure proc-alt-shift-f3:
     1511     run gbl/prvssinf.p
     1512       ( input this-procedure
     1513       ) .
     1514   end.
     1515   define variable v-inform-launched as logical no-undo initial false .
     1516   procedure proc-alt-shift-f4:
     1517     define variable v-action as character no-undo .
     1518     if v-inform-launched = false then do:
     1519       assign
     1520         v-inform-launched = true
     1521       .
     1522       run gbl/d-inform.w
     1523         (  input self
     1524         ,  input this-procedure
     1525         , output v-action
     1526         ) no-error .
     1527       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     1528       assign
     1529         v-inform-launched = false
     1530       .
     1531     end.
     1532   end.
     1533   procedure proc-alt-f1:
     1534     run gbl/corrhelp.p
     1535       (input this-procedure
     1536       ) .
     1537   end .
     1538   on alt-shift-f2 anywhere do:
     1539     run proc-alt-shift-f2.
     1540   end.
     1541   on alt-shift-f3 anywhere do:
     1542     run proc-alt-shift-f3 in this-procedure .
     1543   end.
     1544   on alt-shift-f4 anywhere do:
     1545     run proc-alt-shift-f4 in this-procedure.
     1546   end.
     1547   on alt-f1 anywhere do:
     1548     run proc-alt-f1 in this-procedure .
     1549   end.
