     3405     assign
     3406      price-cli-with-tax-loc = ub.parts.price-cli
     3407      cli-base-rate          = ub.parts.cli-base-rate.
     3408     ASSIGN   road-tax-base-loc  = (if ub.parts.road-tax-base  = ? then 0 else ub.parts.road-tax-base)
     3409              road-tax-rubl-loc  = (if ub.parts.road-tax-rubl  = ? then 0 else ub.parts.road-tax-rubl).
     3410     ASSIGN  transport-base-loc = (if ub.parts.transport-base = ? then 0 else ub.parts.transport-base)
     3411             transport-rubl-loc = (if ub.parts.transport-rubl = ? then 0 else ub.parts.transport-rubl)
     3412             other-base-loc     = (if ub.parts.other-base     = ? then 0 else ub.parts.other-base)
     3413             other-rubl-loc     = (if ub.parts.other-rubl     = ? then 0 else ub.parts.other-rubl)
     3414             vat-pc-loc         = (if ub.parts.vat-pc         = ? then 0 else ub.parts.vat-pc)
     3415             slt-pc-loc         = (if ub.parts.slt-pc         = ? then 0 else ub.parts.slt-pc).
     3416             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     3417       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     3418     assign
     3419       exch-rate-cli-loc = (ub.parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if ub.parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if ub.parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / ub.parts.price-cli .
     3420     assign
     3421       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     3422       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     3423       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     3424       transport-cli-loc  = 0
     3425       other-cli-loc      = 0
     3426     .
     3427   ASSIGN
     3428             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     3429       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     3430   .
     3431   accumulate
     3432       ub.parts.fact-qnty (total)
     3433       ub.parts.fact-qnty * ub.parts.price-rubl (total)
     3434       ub.parts.fact-qnty * ub.parts.price-base (total)
     3435       out-qnty (total)
     3436       out-qnty * ub.parts.price-rubl (total)
     3437       out-qnty * ub.parts.price-base (total)
     3438       free-qnty (total)
     3439       free-qnty * vat-rubl-loc (total)
     3440       free-qnty * vat-base-loc (total)
     3441       free-qnty * price-rubl-with-tax-loc (total)
     3442       free-qnty * price-base-with-tax-loc (total)
     3443       .
     3444   create suppl-parts.
     3445   assign
     3446       suppl-parts.num-doc = num-doc
     3447       suppl-parts.artic = ub.parts.artic
     3448       suppl-parts.prod-type = ub.parts.prod-type
     3449       suppl-parts.prod-code = ub.parts.prod-code
     3450       suppl-parts.gds-code = ub.goods.gds-code
     3451       suppl-parts.gds-name = ub.goods.gds-name
     3452       suppl-parts.doc-type = ub.parts.doc-type
     3453       suppl-parts.in-code  = ub.parts.in-code
     3454       suppl-parts.out-code = ub.parts.out-code
     3455       suppl-parts.fact-date   = ub.parts.fact-date
     3456       suppl-parts.price0-base = ub.parts.price-base
     3457       suppl-parts.price0-rubl = ub.parts.price-rubl
     3458       suppl-parts.price-cli = ub.parts.price-cli / ub.parts.cli-base-rate
     3459       suppl-parts.obj-type  = ub.parts.obj-type
     3460       suppl-parts.obj-code  = ub.parts.obj-code
     3461       suppl-parts.part-code = ub.parts.part-code
     3462       suppl-parts.in-qnty   = ub.parts.fact-qnty
     3463       suppl-parts.in-sum0-rubl = ub.parts.fact-qnty * ub.parts.price-rubl
     3464       suppl-parts.in-sum0-base = ub.parts.fact-qnty * ub.parts.price-base
     3465       suppl-parts.in-sum-cli   = ub.parts.fact-qnty * ub.parts.price-cli / ub.parts.cli-base-rate
     3466       suppl-parts.p-in-qnty      = if (ub.parts.fact-date < from-date) then 0 else (ub.parts.fact-qnty)
     3467       suppl-parts.p-in-sum0-rubl = if (ub.parts.fact-date < from-date) then 0 else (ub.parts.fact-qnty * ub.parts.price-rubl)
     3468       suppl-parts.p-in-sum0-base = if (ub.parts.fact-date < from-date) then 0 else (ub.parts.fact-qnty * ub.parts.price-base)
     3469       suppl-parts.p-in-sum-cli   = if (ub.parts.fact-date < from-date) then 0 else (ub.parts.fact-qnty * ub.parts.price-cli / ub.parts.cli-base-rate)
     3470       suppl-parts.out-qnty = out-qnty
     3471       suppl-parts.out-sum0-rubl = out-qnty * ub.parts.price-rubl
     3472       suppl-parts.out-sum0-base = out-qnty * ub.parts.price-base
     3473       suppl-parts.out-sum-cli = out-qnty * ub.parts.price-cli / ub.parts.cli-base-rate
     3474       suppl-parts.free-qnty = free-qnty
     3475       suppl-parts.free-nds0-rubl = free-qnty * vat-rubl-loc
     3476       suppl-parts.free-nds0-base = free-qnty * vat-base-loc
     3477       suppl-parts.free-sum0-rubl = free-qnty * price-rubl-with-tax-loc
     3478       suppl-parts.free-sum0-base = free-qnty * price-base-with-tax-loc
     3479       suppl-parts.free-sum-cli = free-qnty * ub.parts.price-cli / ub.parts.cli-base-rate
     3480       suppl-parts.qnty-sale = qnty_sale
     3481       suppl-parts.fs-date = ub.parts.fact-date
     3482       suppl-parts.ls-date = l-date
     3483    .
     3484          end.
     3485    end.
     3486   assign
     3487       tot-in-qnty      =  (ACCUM TOTAL ub.parts.fact-qnty)
     3488       tot-in-sum0-rubl =  (ACCUM TOTAL ub.parts.fact-qnty * ub.parts.price-rubl)
     3489       tot-in-sum0-base =  (ACCUM TOTAL ub.parts.fact-qnty * ub.parts.price-base)
     3490       tot-out-qnty       = (ACCUM TOTAL out-qnty)
     3491       tot-out-sum0-rubl  = (ACCUM TOTAL out-qnty * ub.parts.price-rubl)
     3492       tot-out-sum0-base  = (ACCUM TOTAL out-qnty * ub.parts.price-base)
     3493       tot-free-qnty      = (ACCUM TOTAL free-qnty)
     3494       tot-free-sum0-rubl = (ACCUM TOTAL free-qnty * price-rubl-with-tax-loc)
     3495       tot-free-sum0-base = (ACCUM TOTAL free-qnty * price-base-with-tax-loc)
     3496       .
     3497   if session:set-wait-state("") then.
     3498   run waitfram-hide in this-procedure .
     3499   END PROCEDURE.
     3500   PROCEDURE disable_UI :
     3501     HIDE FRAME vs-parts.
     3502   END PROCEDURE.
     3503   PROCEDURE enable_UI :
     3504     DISPLAY tot-free-sum0-base tot-out-sum0-rubl tot-in-qnty tot-free-qnty
     3505             tot-free-sum0-rubl tot-in-sum0-rubl tot-out-qnty tot-out-sum0-base
     3506             tot-in-sum0-base
     3507         WITH FRAME vs-parts.
     3508     ENABLE b-help rect-in br-parts b-quit b-print b-docs
     3509         WITH FRAME vs-parts.
     3510     VIEW FRAME vs-parts.
     3511     OPEN QUERY br-parts FOR EACH suppl-parts NO-LOCK,            EACH ub.goods WHERE ub.goods.artic = suppl-parts.artic                      AND ub.goods.prod-type = suppl-parts.prod-type                      AND ub.goods.prod-code = suppl-parts.prod-code NO-LOCK     BY ub.goods.artic BY ub.goods.prod-type BY ub.goods.prod-code BY ub.goods.grp-name BY suppl-parts.in-code.
     3512   END PROCEDURE.
     3513   PROCEDURE print-order :
     3514     def var tb-code as char no-undo.
     3515     def var price0 LIKE ub.parts.price-rubl no-undo.
     3516     def var in-sum0 LIKE ub.parts.price-rubl no-undo.
     3517     def var free-noNDS0 LIKE ub.parts.price-rubl no-undo.
     3518     def var free-NDS0 LIKE ub.parts.price-rubl no-undo.
     3519     def var free-sum0 LIKE ub.parts.price-rubl no-undo.
     3520     def var resource as int init ? no-undo.
     3521     def var avrg-sale as decimal no-undo.
     3522     def var sum-price-s as decimal no-undo.
     3523     def var UpFact as decimal no-undo.
     3524     def var sym1 as char init ":"   no-undo.
     3525     def var sym2 as char init ":"   no-undo.
     3526     def var sym3 as char init ":"   no-undo.
     3527     def var sym4 as char init ":"   no-undo.
     3528     def var sym5 as char init ":"   no-undo.
     3529     def var sym6 as char init ":"   no-undo.
     3530     def var sym7 as char init ":"   no-undo.
     3531     def var sym8 as char init ":"   no-undo.
     3532     def var sym9 as char init ":"   no-undo.
     3533     def var sym10 as char init ":"   no-undo.
     3534     def var sym11 as char init ":"   no-undo.
     3535     def var sym12 as char init ":"   no-undo.
     3536     def var sym13 as char init ":"   no-undo.
     3537     def var sym14 as char init ":"   no-undo.
     3538     def var Line as char no-undo.
     3539     DEFINE FRAME supp-gds
     3540           sym1 column-label ":!:" format "X(1)" space(0)
     3541           suppl-parts.in-code COLUMN-LABEL "№ ПН! " FORMAT "x(16)" space(0)
     3542           sym2 column-label ":!:" format "X(1)" space(0)
     3543           suppl-parts.fact-date COLUMN-LABEL "Дата!прихода" FORMAT "99/99/9999" space(0)
     3544           sym3 column-label ":!:" format "X(1)" space(0)
     3545           suppl-parts.in-qnty COLUMN-LABEL "Приход!    количество" FORMAT "->,>>>,>>9.<<<" space(0)
     3546           sym4 column-label ":!:" format "X(1)" space(0)
     3547           price0 COLUMN-LABEL "Учетная!цена" FORMAT "->>>,>>9.99"  space(0)
     3548           sym5 column-label ":!:" format "X(1)" space(0)
     3549           in-sum0 COLUMN-LABEL "Приход сумма!учетных цен" FORMAT "->>>,>>>,>>9.99" space(0)
     3550           sym6 column-label ":!:" format "X(1)" space(0)
     3551           resource COLUMN-LABEL "Обеспе-!ченность" FORMAT "->>>>>>9" space(0)
     3552           sym7 column-label ":!:" format "X(1)" space(0)
     3553           avrg-sale COLUMN-LABEL "Средние!продажи" FORMAT "->>>>>9"
     3554           sym8 column-label ":!:" format "X(1)"
     3555           suppl-parts.free-qnty COLUMN-LABEL "Остаток!    количество" FORMAT "->,>>>,>>9.<<<"
     3556           sym9 column-label ":!:" format "X(1)"
     3557           free-noNDS0 COLUMN-LABEL "Остаток сумма!уч. цен без НДС" FORMAT "->>>,>>>,>>9.99"
     3558           sym10 column-label ":!:" format "X(1)"
     3559           free-NDS0 COLUMN-LABEL "Остаток сумма!НДС" FORMAT "->>>,>>>,>>9.99"
     3560           sym11 column-label ":!:" format "X(1)"
     3561           free-sum0 COLUMN-LABEL "Остаток сумма!уч. цен c НДС" FORMAT "->>>,>>>,>>9.99"
     3562           sym12 column-label ":!:" format "X(1)"
     3563           sum-price-s COLUMN-LABEL "Остаток cумма!продажных цен" FORMAT "->>>,>>>,>>9.99"
     3564           sym13 column-label ":!:" format "X(1)"
     3565           UpFact COLUMN-LABEL "Наценка! " FORMAT "->>>,>>>,>>9.99%"
     3566           sym14 column-label ":!:" format "X(1)" space(0)
     3567         HEADER
     3568             cur-time-print() AT 5 format "X(35)"
     3569             string( "Отчет для заказа товаров от поставщика: " + supplier.obj-name ) AT 45 format "X(95)"
     3570             string( "Cуммы указаны в " + (if PrintRubl then "руб" else base-type) ) AT 145 format "X(20)"
     3571             string( "Страница " + string( PAGE-NUMBER( PrnLibStream ), ">>9" ) ) AT 170 format "X(13)" SKIP
     3572             Line format "X(198)" AT 1
     3573         with width 232 down stream-io.
     3574     assign PrintRubl = yes .
     3575     if v-base-code <> 0 and var-report-r-b = "base" then
     3576         assign PrintRubl = no .
     3577     if session:set-wait-state("COMPILER") then.
     3578     assign Line = fill("-", 232).
     3579     run prn-lib-open-stream  in this-procedure (
     3580                                                 input parParentProc
     3581                                                 ,input 43
     3582                                                 ,input yes
     3583                                                 ,input no
     3584                                                 ).
     3585     FORM with FRAME supp-gds.
     3586     FORM HEADER
     3587         Line format "X(198)" AT 1 SKIP
     3588         "Продолжение - на следующей странице" AT 60 SKIP
     3589         with FRAME BottomFrame width 232
     3590         PAGE-BOTTOM no-labels no-box.
     3591     VIEW STREAM PrnLibStream FRAME BottomFrame .
     3592     if num-doc = "" then
     3593         PUT STREAM PrnLibStream string( "П Р И Х О Д Н Ы Е   П А Р Т И И   за период с: " + string(from-date,"99/99/9999") +
     3594                                                               " по: " + string(to-date,"99/99/9999") )
     3595                                                        AT 62 format "X(198)"
     3596                                                    SKIP(1)
     3597                                                    .
     3598     else
     3599         PUT STREAM PrnLibStream string( "П Р И Х О Д Н Ы Е   П А Р Т И И   по документу: " + num-doc + " от " + string( ub.trn-doc.fact-date, "99/99/9999" ) )
     3600                                                        AT 62 format "X(198)"
     3601                                                    SKIP(1)
     3602                                                    .
     3603     PUT STREAM PrnLibStream string( "ПОСТАВЩИК: " + supplier.obj-name +
     3604                                                           " (" + supplier.obj-type + " " + string(supplier.obj-code) + ")" )
     3605                                                    AT 10 format "X(198)"
     3606                                                  SKIP.
     3607     if gds-art = "" then
     3608         PUT STREAM PrnLibStream string( "ТОВАР: " + suppl-gds.artic + ' "' + suppl-gds.gds-name + '"' )
     3609                                                        AT 14 format "X(198)"
     3610                                                    SKIP.
     3611     PUT STREAM PrnLibStream " " SKIP.
     3612     FOR EACH suppl-parts NO-LOCK,
     3613             EACH ub.goods WHERE ub.goods.artic = suppl-parts.artic
     3614                                                AND ub.goods.prod-type = suppl-parts.prod-type
     3615                                                AND ub.goods.prod-code = suppl-parts.prod-code
     3616                                                NO-LOCK
     3617                                                BREAK BY ub.goods.grp-name BY ub.goods.artic BY ub.goods.prod-type BY ub.goods.prod-code BY suppl-parts.in-code:
     3618         FIND ub.gds-prt WHERE ub.gds-prt.upper-code = ub.goods.prt-root NO-LOCK.
     3619         FIND ub.bar-code WHERE ub.bar-code.gds-code = ub.goods.gds-code
     3620                         AND ub.bar-code.unit-cli = ub.goods.unit-base
     3621                         AND ub.bar-code.node-code = ub.gds-prt.node-code
     3622                         AND ub.bar-code.part-code = ""
     3623                         AND ub.bar-code.in-code = ""
     3624                         NO-LOCK.
     3625   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3626   gp-fact-order = 0 .
     3627   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3628     (input  ub.goods.gds-code
     3629     ,input  ub.bar-code.node-code
     3630     ,output gp-b-code
     3631     ) no-error .
     3632   if error-status:error then do:
     3633     message
     3634       error-status :get-message(1) skip
     3635       return-value skip
     3636       view-as alert-box error .
     3637     return no-apply.
     3638   end.
     3639   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3640   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     3641     (input  p-curr-obj-type
     3642     ,input  p-curr-obj-code
     3643     ,input  gp-b-code
     3644     ,input  0
     3645     ,input  gp-fact-order
     3646     ,output gp-doc-num
     3647     ,output gp-price-sale
     3648     ,output gp-road-tax
     3649     ,output gp-excise
     3650     ) no-error .
     3651   if error-status:error then do:
     3652     return no-apply.
     3653   end.
     3654   gp-price-sale-parts = gp-price-sale.
     3655   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3656   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_avprpart in g#lib-trn3
     3657     (input  p-curr-obj-type
     3658     ,input  p-curr-obj-code
     3659     ,input  gp-b-code
     3660     ,input  0
     3661     ,input  gp-fact-order
     3662     ,output gp-doc-num
     3663     ,output gp-price-sale-parts
     3664     ,output gp-road-tax
     3665     ,output gp-excise
     3666     ) no-error .
     3667   if error-status:error then do:
     3668     return no-apply.
     3669   end.
     3670   if gp-price-sale-parts <> 0 and gp-price-sale-parts <> ? then do:
     3671       gp-price-sale = gp-price-sale-parts.
     3672    end.
     3673         assign
     3674             price0 = (if PrintRubl then suppl-parts.price0-rubl else suppl-parts.price0-base)
     3675             in-sum0 = (if PrintRubl then suppl-parts.in-sum0-rubl else suppl-parts.in-sum0-base)
     3676             free-sum0 = (if PrintRubl then suppl-parts.free-sum0-rubl else suppl-parts.free-sum0-base)
     3677             free-NDS0 = (if PrintRubl then suppl-parts.free-NDS0-rubl else suppl-parts.free-NDS0-base)
     3678             free-noNDS0 = free-sum0 - free-NDS0
     3679             avrg-sale = suppl-parts.out-qnty / (suppl-parts.ls-date - suppl-parts.fs-date)
     3680             resource = suppl-parts.free-qnty / avrg-sale
     3681             .
     3682         if FIRST-OF (ub.goods.grp-name) then
     3683             do:
     3684                 DOWN STREAM PrnLibStream 1 with FRAME supp-gds .
     3685                 PUT STREAM PrnLibStream SPACE(20) string("Группа: " + ub.goods.grp-name) format "X(100)".
     3686             end.
     3687         if FIRST-OF (ub.goods.prod-code) then
     3688             do:
     3689                 DOWN STREAM PrnLibStream 1 with FRAME supp-gds .
     3690                 PUT STREAM PrnLibStream
     3691                     SPACE(5)
     3692                     "Артикул: " ub.goods.artic format "X(16)"
     3693                     SPACE
     3694                     "Код: " string( ub.bar-code.b-code ) format "x(13)"
     3695                     SPACE
     3696                     suppl-parts.gds-name format "x(50)"
     3697                     .
     3698             end.
     3699         DISPLAY STREAM PrnLibStream
     3700             sym1 suppl-parts.in-code
     3701             sym2 suppl-parts.fact-date
     3702             sym3 suppl-parts.in-qnty
     3703             sym4 price0
     3704             sym5 in-sum0
     3705             sym6 resource
     3706             sym7 suppl-parts.free-qnty
     3707             sym8 avrg-sale
     3708             sym9 free-noNDS0
     3709             sym10 free-NDS0
     3710             sym11 free-sum0
     3711             sym12 sum-price-s
     3712             sym13 ( ( sum-price-s - free-sum0 ) / free-sum0 * 100 ) @ UpFact
     3713             sym14
     3714             with FRAME supp-gds .
     3715         DOWN STREAM PrnLibStream 1 with FRAME supp-gds .
     3716         ACCUMULATE
     3717             suppl-parts.in-qnty (TOTAL)
     3718             in-sum0 (TOTAL)
     3719             suppl-parts.free-qnty (TOTAL)
     3720             free-noNDS0 (TOTAL)
     3721             free-NDS0 (TOTAL)
     3722             free-sum0 (TOTAL)
     3723             sum-price-s (TOTAL)
     3724             suppl-parts.prod-code (SUB-COUNT BY ub.goods.prod-code)
     3725             suppl-parts.in-qnty (SUB-TOTAL BY ub.goods.prod-code)
     3726             in-sum0 (SUB-TOTAL BY ub.goods.prod-code)
     3727             suppl-parts.free-qnty (SUB-TOTAL BY ub.goods.prod-code)
     3728             free-noNDS0 (SUB-TOTAL BY ub.goods.prod-code)
     3729             free-NDS0 (SUB-TOTAL BY ub.goods.prod-code)
     3730             free-sum0 (SUB-TOTAL BY ub.goods.prod-code)
     3731             sum-price-s (SUB-TOTAL BY ub.goods.prod-code)
     3732             .
     3733         if LAST-OF( ub.goods.prod-code ) AND (ACCUM SUB-COUNT BY ub.goods.prod-code suppl-parts.prod-code) > 1 then
     3734             do:
     3735                 DISPLAY STREAM PrnLibStream
     3736                     sym1 string( "Итого по товару" ) @ suppl-parts.in-code
     3737                     sym2
     3738                     sym3 (ACCUM SUB-TOTAL BY ub.goods.prod-code suppl-parts.in-qnty) @ suppl-parts.in-qnty
     3739                     sym4
     3740                     sym5 (ACCUM SUB-TOTAL BY ub.goods.prod-code in-sum0) @ in-sum0
     3741                     sym6
     3742                     sym7
     3743                     sym8 (ACCUM SUB-TOTAL BY ub.goods.prod-code suppl-parts.free-qnty) @ suppl-parts.free-qnty
     3744                     sym9 (ACCUM SUB-TOTAL BY ub.goods.prod-code free-noNDS0) @ free-noNDS0
     3745                     sym10 (ACCUM SUB-TOTAL BY ub.goods.prod-code free-NDS0) @ free-NDS0
     3746                     sym11 (ACCUM SUB-TOTAL BY ub.goods.prod-code free-sum0) @ free-sum0
     3747                     sym12 (ACCUM SUB-TOTAL BY ub.goods.prod-code sum-price-s) @ sum-price-s
     3748                     sym13 ( ( (ACCUM SUB-TOTAL BY ub.goods.prod-code sum-price-s) - (ACCUM SUB-TOTAL BY ub.goods.prod-code free-sum0) ) /
     3749                                       (ACCUM SUB-TOTAL BY ub.goods.prod-code free-sum0) * 100 ) @ UpFact
     3750                     sym14
     3751                     with FRAME supp-gds .
     3752                 DOWN STREAM PrnLibStream 1 with FRAME supp-gds .
     3753             end.
     3754     END.
     3755     PUT STREAM PrnLibStream Line format "X(198)" SKIP.
     3756     DISPLAY STREAM PrnLibStream
     3757         "Итого" @ suppl-parts.in-code
     3758         (ACCUM TOTAL suppl-parts.in-qnty) @ suppl-parts.in-qnty
     3759         (ACCUM TOTAL in-sum0) @ in-sum0
     3760         (ACCUM TOTAL suppl-parts.free-qnty) @ suppl-parts.free-qnty
     3761         (ACCUM TOTAL free-noNDS0) @ free-noNDS0
     3762         (ACCUM TOTAL free-NDS0) @ free-NDS0
     3763         (ACCUM TOTAL free-sum0) @ free-sum0
     3764         (ACCUM TOTAL sum-price-s) @ sum-price-s
     3765         with FRAME supp-gds .
     3766     DOWN STREAM PrnLibStream 1 with FRAME supp-gds .
     3767     HIDE STREAM PrnLibStream FRAME BottomFrame .
     3768     OUTPUT STREAM PrnLibStream CLOSE.
     3769     if session:set-wait-state("") then.
     3770     run prn-lib-prn-file in this-procedure (
     3771                                               input parParentProc
     3772                                               ,input 8
     3773                                               ).
     3774   END PROCEDURE.
     3775   PROCEDURE print-cycle :
     3776       define input parameter val-type as char no-undo.
     3777       def var object as char no-undo.
     3778       def var PartCode LIKE ub.parts.part-code no-undo.
     3779       def var price0 LIKE ub.parts.price-rubl no-undo.
     3780       def var in-sum0 LIKE ub.parts.price-rubl no-undo.
     3781       def var out-sum0 LIKE ub.parts.price-rubl no-undo.
     3782       def var free-sum0 LIKE ub.parts.price-rubl no-undo.
     3783       def var sym1 as char init ":"   no-undo.
     3784       def var sym2 as char init ":"   no-undo.
     3785       def var sym3 as char init ":"   no-undo.
     3786       def var sym4 as char init ":"   no-undo.
     3787       def var sym5 as char init ":"   no-undo.
     3788       def var sym6 as char init ":"   no-undo.
     3789       def var sym7 as char init ":"   no-undo.
     3790       def var sym8 as char init ":"   no-undo.
     3791       def var sym9 as char init ":"   no-undo.
     3792       def var sym10 as char init ":"   no-undo.
     3793       def var sym11 as char init ":"   no-undo.
     3794       def var sym12 as char init ":"   no-undo.
     3795       def var sym13 as char init ":"   no-undo.
     3796       def var Line as char no-undo.
     3797       assign
     3798       sheetf.Excel-Column-Lable =  "Наименование товара,№ ПН,Дата прихода,Учетная цена,Приход количество,Приход сумма учетных цен," +
     3799                                    "Расход количество,Расход сумма учетных цен,Остаток количество,Остаток сумма учетных цен,Объект,Партия"
     3800       sheetf.sizes = "40,16,10,10,15,15,"  +
     3801                       "15,15,15,15,10,14"
     3802       sheetf.colformat = "3=dd/mm/yyyy"
     3803       Make-Excel = yes
     3804       reportname = "П Р И Х О Д Н Ы Е   П А Р Т И И"
     3805       str2 =  "за период с: " + string(from-date,"99/99/9999") +
     3806               " по: " + string(to-date,"99/99/9999")
     3807       str3 =   string( "ПОСТАВЩИК: " + supplier.obj-name +
     3808                " (" + supplier.obj-type + " " + string(supplier.obj-code) + ")" )
     3809       str4 = "Cуммы указаны в " + (if val-type = "rubl" then "руб" else (if val-type = "base" then base-type else cli-val ) )
     3810       .
     3811       DEFINE FRAME supp-gds
     3812             sym1 column-label ":!:" format "X(1)" space(0)
     3813             suppl-parts.gds-name COLUMN-LABEL "Наименование!товара" FORMAT "x(40)" space(0)
     3814             sym2 column-label ":!:" format "X(1)" space(0)
     3815             suppl-parts.in-code COLUMN-LABEL "№ ПН! " FORMAT "x(16)" space(0)
     3816             sym3 column-label ":!:" format "X(1)" space(0)
     3817             suppl-parts.fact-date COLUMN-LABEL "Дата!прихода" FORMAT "99/99/99" space(0)
     3818             sym4 column-label ":!:" format "X(1)" space(0)
     3819             price0 COLUMN-LABEL "Учетная!цена" FORMAT "->>,>>9.99"  space(0)
     3820             sym5 column-label ":!:" format "X(1)" space(0)
     3821             suppl-parts.in-qnty COLUMN-LABEL "Приход!    количество" FORMAT "->,>>>,>>9.<<<" space(0)
     3822             sym6 column-label ":!:" format "X(1)" space(0)
     3823             in-sum0 COLUMN-LABEL "Приход сумма!учетных цен" FORMAT "->>>,>>>,>>9.99" space(0)
     3824             sym7 column-label ":!:" format "X(1)" space(0)
     3825             suppl-parts.out-qnty COLUMN-LABEL "Расход!    количество" FORMAT "->,>>>,>>9.<<<" space(0)
     3826             sym8 column-label ":!:" format "X(1)" space(0)
     3827             out-sum0 COLUMN-LABEL "Расход сумма!учетных цен" FORMAT "->>>,>>>,>>9.99" space(0)
     3828             sym9 column-label ":!:" format "X(1)" space(0)
     3829             suppl-parts.free-qnty COLUMN-LABEL "Остаток!    количество" FORMAT "->,>>>,>>9.<<<" space(0)
     3830             sym10 column-label ":!:" format "X(1)" space(0)
     3831             free-sum0 COLUMN-LABEL "Остаток сумма!учетных цен" FORMAT "->>>,>>>,>>9.99" space(0)
     3832             sym11 column-label ":!:" format "X(1)" space(0)
     3833             object COLUMN-LABEL "Объект! " FORMAT "x(10)"  space(0)
     3834             sym12 column-label ":!:" format "X(1)" space(0)
     3835             PartCode COLUMN-LABEL "Партия! " FORMAT "x(14)" space(0)
     3836             sym13 column-label ":!:" format "X(1)" space(0)
     3837           HEADER
     3838               cur-time-print() AT 5 format "X(35)"
     3839               string( "Отчет по поставщику: " + supplier.obj-name ) AT 45 format "X(71)"
     3840               string( str4 ) AT 145 format "X(20)"
     3841               string( "Страница " + string( PAGE-NUMBER( PrnLibStream ), ">>9" ) ) AT 170 format "X(13)" SKIP
     3842               Line format "X(198)" AT 1
     3843           with width 232 down stream-io.
     3844       if session:set-wait-state("COMPILER") then.
     3845       assign Line = fill("-", 232).
     3846       run prn-lib-open-stream  in this-procedure (
     3847                                                   input parParentProc
     3848                                                   ,input 43
     3849                                                   ,input yes
     3850                                                   ,input no
     3851                                                   ).
     3852       RUN OpenForExcel in this-procedure .
     3853       run rep/extitle.p (1).
     3854       FORM with FRAME supp-gds.
     3855       FORM HEADER
     3856           Line format "X(198)" AT 1 SKIP
     3857           "Продолжение - на следующей странице" AT 60 SKIP
     3858           with FRAME BottomFrame width 232
     3859           PAGE-BOTTOM no-labels no-box.
     3860       VIEW STREAM PrnLibStream FRAME BottomFrame .
     3861       PUT STREAM PrnLibStream
     3862       string( reportname + chr(32) + str2  )  AT 62 format "X(198)"
     3863       SKIP(1)
     3864       str3 AT 10 format "X(198)"
     3865       SKIP.
     3866       if gds-art = "" then
     3867           PUT STREAM PrnLibStream string( "ТОВАР: " + suppl-gds.artic + ' "' + suppl-gds.gds-name + '"' )
     3868                                                          AT 14 format "X(198)"
     3869                                                      SKIP.
     3870       PUT STREAM PrnLibStream " " SKIP.
     3871       FOR EACH suppl-parts NO-LOCK BREAK BY suppl-parts.artic BY suppl-parts.prod-type BY suppl-parts.prod-code BY suppl-parts.in-code:
     3872           CASE val-type:
     3873               WHEN "rubl" THEN
     3874                   assign
     3875                       price0 = suppl-parts.price0-rubl
     3876                       in-sum0 = suppl-parts.in-sum0-rubl
     3877                       out-sum0 = suppl-parts.out-sum0-rubl
     3878                       free-sum0 = suppl-parts.free-sum0-rubl
     3879                       .
     3880               WHEN "base" THEN
     3881                   assign
     3882                       price0 = suppl-parts.price0-base
     3883                       in-sum0 = suppl-parts.in-sum0-base
     3884                       out-sum0 = suppl-parts.out-sum0-base
     3885                       free-sum0 = suppl-parts.free-sum0-base
     3886                       .
     3887               WHEN "cli" THEN
     3888                   assign
     3889                       price0 = suppl-parts.price-cli
     3890                       in-sum0 = suppl-parts.in-sum-cli
     3891                       out-sum0 = suppl-parts.out-sum-cli
     3892                       free-sum0 = suppl-parts.free-sum-cli
     3893                       .
     3894           END CASE.
     3895           DISPLAY STREAM PrnLibStream
     3896               sym1 suppl-parts.in-code
     3897               sym2 string( suppl-parts.artic + " " + suppl-parts.gds-name ) @ suppl-parts.gds-name
     3898               sym3 suppl-parts.fact-date
     3899               sym4 price0
     3900               sym5 suppl-parts.in-qnty
     3901               sym6 in-sum0
     3902               sym7 suppl-parts.out-qnty
     3903               sym8 out-sum0
     3904               sym9 suppl-parts.free-qnty
     3905               sym10 free-sum0
     3906               sym11 (suppl-parts.obj-type + " " + STRING (suppl-parts.obj-code)) @ object
     3907               sym12 (if suppl-parts.part-code = "" then "------" else suppl-parts.part-code) @ PartCode
     3908               sym13
     3909               with FRAME supp-gds .
     3910           DOWN STREAM PrnLibStream 1 with FRAME supp-gds .
     3911           if Make-Excel then  put   stream ForExcel unformatted
     3912           string( suppl-parts.artic + " " + suppl-parts.gds-name )                              CHR(9)
     3913           suppl-parts.in-code                                                                   CHR(9)
     3914           suppl-parts.fact-date                                                                 CHR(9)
     3915           price0                                                                                CHR(9)
     3916           suppl-parts.in-qnty                                                                   CHR(9)
     3917           in-sum0                                                                               CHR(9)
     3918           suppl-parts.out-qnty                                                                  CHR(9)
     3919           out-sum0                                                                              CHR(9)
     3920           suppl-parts.free-qnty                                                                 CHR(9)
     3921           free-sum0                                                                             CHR(9)
     3922           (suppl-parts.obj-type + " " + STRING (suppl-parts.obj-code))                          CHR(9)
     3923           (if suppl-parts.part-code = "" then "------" else suppl-parts.part-code)
     3924           skip.
     3925           ACCUMULATE
     3926               suppl-parts.in-qnty (TOTAL)
     3927               in-sum0 (TOTAL)
     3928               suppl-parts.out-qnty (TOTAL)
     3929               out-sum0 (TOTAL)
     3930               suppl-parts.free-qnty (TOTAL)
     3931               free-sum0 (TOTAL)
     3932               suppl-parts.prod-code (SUB-COUNT BY suppl-parts.prod-code)
     3933               suppl-parts.in-qnty (SUB-TOTAL BY suppl-parts.prod-code)
     3934               in-sum0 (SUB-TOTAL BY suppl-parts.prod-code)
     3935               suppl-parts.out-qnty (SUB-TOTAL BY suppl-parts.prod-code)
     3936               out-sum0 (SUB-TOTAL BY suppl-parts.prod-code)
     3937               suppl-parts.free-qnty (SUB-TOTAL BY suppl-parts.prod-code)
     3938               free-sum0 (SUB-TOTAL BY suppl-parts.prod-code)
     3939               .
     3940           if LAST-OF( suppl-parts.prod-code ) then
     3941               do:
     3942                   if (ACCUM SUB-COUNT BY suppl-parts.prod-code suppl-parts.prod-code) > 1 then
     3943                       do:
     3944                           DISPLAY STREAM PrnLibStream
     3945                               sym1
     3946                               sym2 string( "  Итого по товару" ) @ suppl-parts.gds-name
     3947                               sym3 sym4
     3948                               sym5 (ACCUM SUB-TOTAL BY suppl-parts.prod-code suppl-parts.in-qnty) @ suppl-parts.in-qnty
     3949                               sym6 (ACCUM SUB-TOTAL BY suppl-parts.prod-code in-sum0) @ in-sum0
     3950                               sym7 (ACCUM SUB-TOTAL BY suppl-parts.prod-code suppl-parts.out-qnty) @ suppl-parts.out-qnty
     3951                               sym8 (ACCUM SUB-TOTAL BY suppl-parts.prod-code out-sum0) @ out-sum0
     3952                               sym9 (ACCUM SUB-TOTAL BY suppl-parts.prod-code suppl-parts.free-qnty) @ suppl-parts.free-qnty
     3953                               sym10 (ACCUM SUB-TOTAL BY suppl-parts.prod-code free-sum0) @ free-sum0
     3954                               sym11 sym12 sym13
     3955                               with FRAME supp-gds .
     3956                           DOWN STREAM PrnLibStream 1 with FRAME supp-gds .
     3957                           if Make-Excel then  put   stream ForExcel unformatted
     3958                                                                                             CHR(9)
     3959                           string( "  Итого по товару" )                                     CHR(9)
     3960                                                                                             CHR(9)
     3961                                                                                             CHR(9)
     3962                           (ACCUM SUB-TOTAL BY suppl-parts.prod-code suppl-parts.in-qnty)    CHR(9)
     3963                           (ACCUM SUB-TOTAL BY suppl-parts.prod-code in-sum0)                CHR(9)
     3964                           (ACCUM SUB-TOTAL BY suppl-parts.prod-code suppl-parts.out-qnty)   CHR(9)
     3965                           (ACCUM SUB-TOTAL BY suppl-parts.prod-code out-sum0)               CHR(9)
     3966                           (ACCUM SUB-TOTAL BY suppl-parts.prod-code suppl-parts.free-qnty)  CHR(9)
     3967                           (ACCUM SUB-TOTAL BY suppl-parts.prod-code free-sum0)              CHR(9)
     3968                                                                                             CHR(9)
     3969                                                                                             CHR(9)
     3970                           skip.
     3971                       end.
     3972                   DISPLAY STREAM PrnLibStream
     3973                       sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym13
     3974                       with FRAME supp-gds .
     3975                   DOWN STREAM PrnLibStream 1 with FRAME supp-gds .
     3976               end.
     3977       END.
     3978       PUT STREAM PrnLibStream Line format "X(198)" SKIP.
     3979       DISPLAY STREAM PrnLibStream
     3980           "Итого" @ price0
     3981           (ACCUM TOTAL suppl-parts.in-qnty) @ suppl-parts.in-qnty
     3982           (ACCUM TOTAL in-sum0) @ in-sum0
     3983           (ACCUM TOTAL suppl-parts.out-qnty) @ suppl-parts.out-qnty
     3984           (ACCUM TOTAL out-sum0) @ out-sum0
     3985           (ACCUM TOTAL suppl-parts.free-qnty) @ suppl-parts.free-qnty
     3986           (ACCUM TOTAL free-sum0) @ free-sum0
     3987           with FRAME supp-gds .
     3988       DOWN STREAM PrnLibStream 1 with FRAME supp-gds .
     3989       if Make-Excel then  put   stream ForExcel unformatted
     3990       "Итого"                             CHR(9)
     3991                                           CHR(9)
     3992                                           CHR(9)
     3993                                           CHR(9)
     3994       (ACCUM TOTAL suppl-parts.in-qnty)   CHR(9)
     3995       (ACCUM TOTAL in-sum0)               CHR(9)
     3996       (ACCUM TOTAL suppl-parts.out-qnty)  CHR(9)
     3997       (ACCUM TOTAL out-sum0)              CHR(9)
     3998       (ACCUM TOTAL suppl-parts.free-qnty) CHR(9)
     3999       (ACCUM TOTAL free-sum0)             CHR(9)
     4000                                           CHR(9)
     4001       skip.
     4002       HIDE STREAM PrnLibStream FRAME BottomFrame .
     4003       OUTPUT STREAM PrnLibStream CLOSE.
     4004       if Make-Excel then output stream ForExcel close.
     4005       if session:set-wait-state("") then.
     4006       run prn-lib-prn-file in this-procedure (
     4007                                                 input parParentProc
     4008                                                 ,input 0
     4009                                                 ).
     4010       APPLY "ENTRY" TO BROWSE br-parts.
     4011   END PROCEDURE.
