     3374   end.
     3375   assign free-qnty = (accum total b-parts.fact-qnty) .
     3376   if free-qnty > 0 then
     3377       assign l-date = today + 1.
     3378   assign
     3379     price-rubl-with-tax-loc = ub.parts.price-rubl
     3380     price-base-with-tax-loc = ub.parts.price-base
