      815   define variable var-report-r-b as character no-undo .
      816   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      817   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      818     (output var-report-r-b
      819     )  .
      820   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      821   define  stream PrnLibStream.
      822   procedure prn-lib-prn-file :
      823     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      824     define input parameter p-DIsabledoptions as integer no-undo .
      825     define variable v-report-name as character no-undo .
      826     define variable v-user-action as character no-undo .
      827     define variable v-printed     as logical   no-undo .
      828     define variable v-exist       as logical   no-undo .
      829     do
      830       on error undo, return error
      831       :
      832       run prn-lib-get-report-name  in this-procedure (
      833         input parParentProc
      834         ,output v-report-name
      835         ).
      836   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      837   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      838     (input  v-report-name
      839     ,input  2
      840     ,output v-exist
      841     )  .
      842       if NOT v-exist then
      843       DO:
      844         Message
      845           "Нет заданий на печать ! "
      846           view-as alert-box .
      847         Return  .
      848       End.
      849       run gbl/prnfilen.w
      850         (input  ""
      851         ,input  p-DisabledOptions
      852         ,input  string(v-report-name )
      853         ,input  7
      854         ,output v-user-action
      855         ,output v-printed
      856         ) .
      857       if v-printed then
      858       do:
      859         return "YES" .
      860       end.
      861       else
      862       do:
      863         return "NO" .
      864       end.
      865     end.
      866   end procedure.
      867   procedure prn-lib-open-stream :
      868     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      869     define input parameter p-page-size    as integer no-undo .
      870     define input parameter p-is-stream    as logical no-undo .
      871     define input parameter p-append       as logical no-undo .
      872     define variable v-report-name as character no-undo .
      873     do
      874       on error undo, return error
      875       :
      876       run prn-lib-get-report-name  in this-procedure (
      877         input parParentProc
      878         ,output v-report-name
      879         ).
      880       if p-is-stream then
      881       do:
      882         if p-append then
      883         do:
      884           output stream PrnLibStream to value( v-report-name )
      885             page-size value(p-page-size) append .
      886         end.
      887         if not p-append then
      888         do:
      889           output stream PrnLibStream to value( v-report-name )
      890             page-size value(p-page-size) .
      891         end.
      892       end.
      893       if not p-is-stream then
      894       do:
      895         if p-append then
      896         do:
      897           output to value( v-report-name )
      898             page-size value(p-page-size) append .
      899         end.
      900         if not p-append then
      901         do:
      902           output to value( v-report-name )
      903             page-size value(p-page-size) .
      904         end.
      905       end.
      906     end.
      907   end procedure.
      908   procedure prn-lib-open-exp :
      909     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      910     define input parameter p-is-stream    as logical no-undo .
      911     define input parameter p-is-append    as logical no-undo .
      912     define output parameter p-ReportFileName as char init "report" no-undo.
      913     define output parameter p-process as logical no-undo .
      914     define variable glog as logical no-undo .
      915     do
      916       on error undo, return error
      917       :
      918       SYSTEM-DIALOG GET-FILE p-ReportFileName
      919         TITLE      "Укажите путь"
      920         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      921         ASK-OVERWRITE
      922         CREATE-TEST-FILE
      923         SAVE-AS
      924         USE-FILENAME
      925         DEFAULT-EXTENSION "txt"
      926         UPDATE glog
      927         .
      928       if not glog then  return.
      929       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      930       if p-is-stream then
      931       do:
      932         if p-is-append then
      933         do:
      934           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      935         end.
      936         else
      937         do:
      938           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      939         end.
      940       end.
      941       else
      942       do:
      943         if p-is-append then
      944         do:
      945           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      946         end.
      947         else
      948         do:
      949           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      950         end.
      951       end.
      952       p-process = yes.
      953     end.
      954   end procedure.
      955   procedure prn-lib-get-report-name :
      956     define input parameter parParentProc  as widget-handle no-undo.
      957     define output parameter p-report-name as character no-undo .
      958     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      959   end procedure.
      960   procedure prn-lib-reportviewer-report-name :
      961     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      962     define input parameter p-report-name-html as character no-undo .
      963     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      964   end procedure.
      965   procedure prn-lib-reportviewer :
      966     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      967     define input parameter p-report-name-html as character no-undo .
      968     define input parameter p-param        as character no-undo .
      969     define variable v-excel           as character no-undo init 'TRUE' .
      970     define variable v-value-character as character no-undo .
      971     define variable v-value-integer   as character no-undo .
      972     define variable v-value-date      as date      no-undo .
      973     define variable v-value-decimal   as decimal   no-undo .
      974     define variable rep-excel         as logical   no-undo .
      975     define variable excel-string      as character no-undo .
      976     define variable v-param-type      as character no-undo .
      977     define variable v-tth             as handle    no-undo .
      978     run adm/shattri.p (
      979       input "get":U
      980       ,input  ""
      981       ,input  0
      982       ,input  'report-glob':U
      983       ,input  'rep-excel':U
      984       ,output v-value-character
      985       ,output v-value-date
      986       ,output v-value-decimal
      987       ,output v-value-integer
      988       ,output rep-excel
      989       ,output v-param-type
      990       ,INPUT-OUTPUT table-handle v-tth
      991       )  .
      992     if rep-excel then v-excel = "TRUE" .
      993     else v-excel = "FALSE" .
      994     if p-param eq ""
      995     then
      996        p-param = "EXCEL:" + v-excel.
      997     else
      998        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      999     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1000   end procedure.
