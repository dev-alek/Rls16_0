     6245                 and buf_goods.prod-type  = buf_doc-line.prod-type
     6246                 and buf_goods.prod-code  = buf_doc-line.prod-code
     6247             break by buf_doc-line.prod-type by buf_doc-line.prod-code by buf_doc-line.num-place
     6248           :
     6249             if  first-of( buf_doc-line.prod-code) then do:
     6250               run print-prod in this-procedure .
     6251             end.
     6252             run print-line in this-procedure .
     6253           end.
     6254         end.
     6255       end.
     6256     end.
     6257     else do:
     6258       if sort-gr = yes then do:
     6259         if sort-name = yes then do:
     6260           for each buf_doc-line no-lock
     6261             where buf_doc-line.doc-code = t-doc.doc-code
     6262             , first buf_goods no-lock
     6263               where buf_goods.artic      = buf_doc-line.artic
     6264                 and buf_goods.prod-type  = buf_doc-line.prod-type
     6265                 and buf_goods.prod-code  = buf_doc-line.prod-code
     6266             break by buf_goods.grp-name  by buf_goods.gds-name
     6267           :
     6268             if  first-of( buf_goods.grp-name) then do:
     6269               run print-grp in this-procedure .
     6270             end.
     6271             run print-line in this-procedure .
     6272           end.
     6273         end.
     6274         else do:
     6275           for each buf_doc-line
     6276             where buf_doc-line.doc-code = t-doc.doc-code
     6277             , first buf_goods no-lock
     6278               where buf_goods.artic      = buf_doc-line.artic
     6279                 and buf_goods.prod-type  = buf_doc-line.prod-type
     6280                 and buf_goods.prod-code  = buf_doc-line.prod-code
     6281             break by buf_goods.grp-name  by buf_doc-line.num-place
     6282           :
     6283             if  first-of( buf_goods.grp-name) then do:
     6284               run print-grp in this-procedure .
     6285             end.
     6286             run print-line in this-procedure .
     6287           end.
     6288         end.
     6289       end.
     6290       else do:
     6291         if sort-name = yes then do:
     6292           for each buf_doc-line no-lock
     6293             where buf_doc-line.doc-code = t-doc.doc-code
     6294             , first buf_goods no-lock
     6295             where buf_goods.artic      = buf_doc-line.artic
     6296               and buf_goods.prod-type  = buf_doc-line.prod-type
     6297               and buf_goods.prod-code  = buf_doc-line.prod-code
     6298             break by buf_goods.gds-name
     6299           :
     6300             run print-line in this-procedure .
     6301           end.
     6302         end.
