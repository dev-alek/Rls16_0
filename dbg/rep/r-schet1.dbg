     5768     define variable v-cntxp-in-ov           like ub.store.in-ov           no-undo.
     5769     define variable v-cntxp-in-perm         like ub.store.in-perm         no-undo.
     5770     define variable v-cntxp-no-eq           like ub.store.no-eq           no-undo.
     5771     define variable v-cntxp-rsrv-time       like ub.store.rsrv-time       no-undo.
     5772     define variable v-cntxp-load-time       like ub.store.load-time       no-undo.
     5773     define variable v-cntxp-holidays        like ub.store.holidays        no-undo.
     5774     define variable v-cntxp-in-pay          like ub.store.in-pay          no-undo.
     5775     define variable v-cntxp-out-pay         like ub.store.out-pay         no-undo.
     5776     define variable v-cntxp-ret-pay         like ub.store.ret-pay         no-undo.
     5777     define variable v-cntxp-ret-sup-pay     like ub.store.ret-sup-pay     no-undo.
     5778     define variable v-cntxp-down-pay        like ub.store.down-pay        no-undo.
     5779     define variable v-cntxp-inv-pay         like ub.store.inv-pay         no-undo.
     5780     define variable v-cntxp-chk-pay         like ub.store.chk-pay         no-undo.
     5781     define variable v-cntxp-retail          like ub.sysconf.ord-prt       no-undo.
     5782     define variable v-cntxp-osn-base        like ub.sysconf.osn-base      no-undo.
     5783     define variable v-cntxp-conf-par        as   character                no-undo.
     5784     define variable v-cntxp-par-type        as   character                no-undo.
     5785     define variable v-cntxp-curr-host-code  like ub.store.host-code       no-undo.
     5786     define variable v-cntxp-obj-type        like ub.clients.obj-type      no-undo.
     5787     define variable v-cntxp-obj-code        like ub.clients.obj-code      no-undo.
     5788     define variable v-cntxp-db-num          as integer   no-undo .
     5789     define variable v-cntxp-userid          as character no-undo .
     5790     define variable v-cntxp-level           as character no-undo .
     5791     define variable v-cntxp-db-num-obj      as integer   no-undo .
     5792     define variable v-cntxp-is-admin        as logical   no-undo .
     5793     define buffer bf-cntxp_store for ub.store.
     5794     define buffer bf-cntxp_shop  for ub.shop.
     5795     define buffer bf-cntxp_sysconf for ub.sysconf.
     5796   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5797     run mainmenu_getcntxt in parparentproc
     5798       (output v-cntxp-db-num
     5799       ,output v-cntxp-userid
     5800       ,output v-cntxp-level
     5801       ,output v-cntxp-curr-host-code
     5802       ,output v-cntxp-obj-type
     5803       ,output v-cntxp-obj-code
     5804       ,output v-cntxp-db-num-obj
     5805       ,output v-cntxp-is-admin
     5806       ) .
     5807     if (v-cntxp-obj-type = 'маг':U or v-cntxp-obj-type = 'скл':U) and
     5808        v-cntxp-obj-code <> 0 then do:
     5809   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     5810     (input  'is-prt'
     5811     ,input  0
     5812     ,input  ''
     5813     ,input  0
     5814     ,input  ''
     5815     ,input  ''
     5816     ,input  ''
     5817     ,input  yes
     5818     ,output v-cntxp-conf-par
     5819     ,output v-cntxp-par-type
     5820     ) no-error .
     5821       case v-cntxp-obj-type :
     5822         when 'скл':U then do:
     5823           find first bf-cntxp_store where bf-cntxp_store.obj-code = v-cntxp-obj-code no-lock.
     5824           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_store.host-code no-lock.
     5825           assign
