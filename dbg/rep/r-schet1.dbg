     6346       end.
     6347       put stream out_stream Line format "X(119)" skip .
     6348     end.
     6349     if line-counter( Out_stream ) + 8 > page-size( Out_stream ) then page stream Out_stream .
     6350     if can-do( 'факт':U , t-doc.status_ ) or
     6351        ( can-do( 'рас':U , t-doc.doc-type ) and can-do( 'накл,запрос':U , t-doc.status_ ) and
     6352        ( not t-doc.internal ) )
     6353     then do:
     6354       if not PrintRubl then run rep/wp.p (     input ParParentProc, input all-stoim, output s1, output s2 ) .
     6355       else                  run rep/wp-rub.p ( input all-stoim, output s1, output s2 ) .
     6356       if can-do( 'возврат':U , t-doc.doc-type ) then put stream Out_stream space(5) "Итого " format "x(6)" .
     6357       else                                         put stream Out_stream space(5) "Всего на сумму: " format "x(17)" .
     6358       put stream Out_stream  all-stoim format "->>>,>>>,>>>,>>9.99" space(1) trim(s2) format "x(4)".
     6359       put stream Out_stream skip space(5)  caps(s1) format "x(126)" skip .
     6360       if not t-doc.internal and not CostPrice then do:
     6361         put stream Out_stream space(5)  "в том числе: " format "x(13)" .
