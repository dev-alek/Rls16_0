     5517       end.
     5518       find first bf_sysconf where bf_sysconf.host-code = bf_trn-doc.host-code no-lock.
     5519       assign
     5520         varcur-cons-vat-pc = bf_sysconf.cons-vat-pc.
     5521       if varcur-cons-vat-pc = ? then do:
     5522         return error substitute ("Нет текущего продажного консигнационного НДС по фирме &1", bf_trn-doc.host-code).
     5523       end.
     5524       define buffer buf_tt-clcparts for tt-clcparts .
     5525       for each buf_tt-clcparts
     5526       on error undo, return error return-value
     5527       :
     5528         delete buf_tt-clcparts.
     5529       end.
     5530       for each bf_parts no-lock
     5531         where bf_parts.out-code  = bf_doc-line.doc-code
     5532           and bf_parts.obj-type  = bf_doc-line.obj-type
     5533           and bf_parts.obj-code  = bf_doc-line.obj-code
     5534           and bf_parts.artic     = bf_doc-line.artic
     5535           and bf_parts.prod-type = bf_doc-line.prod-type
     5536           and bf_parts.prod-code = bf_doc-line.prod-code
     5537       on error undo, return error return-value
     5538       :
     5539         create buf_tt-clcparts .
     5540         buffer-copy bf_parts to buf_tt-clcparts .
     5541         if v-calcbypart = yes   then do:
     5542   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partbcod in g#library
     5543     (buffer bf_parts
     5544     ,output v-b-pcode
     5545     ) no-error .
     5546   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5547   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     5548     (input  bf_parts.obj-type
     5549     ,input  bf_parts.obj-code
     5550     ,input  v-b-pcode
     5551     ,input  0
     5552     ,input  bf_trn-doc.fact-order
     5553     ,output vardoc-num
     5554     ,output varprice-salef
     5555     ,output varroad-tax
     5556     ,output varexcise
     5557     ) no-error .
     5558             if varprice-sale = ?
     5559             then do:
     5560               assign
     5561                 varprice-salef = 0
     5562                 varroad-tax   = 0
     5563                 varexcise     = 0
     5564               .
     5565             end.
     5566             assign
     5567             part-cur-base  = varprice-salef
     5568             part-cur-road-tax  = varroad-tax
     5569             part-cur-excise = varexcise.
     5570         end.
     5571       end.
     5572       run clcprtsl_calc-ttable in this-procedure
     5573         (input yes,
     5574          input yes,
     5575          input bf_doc-line.road-tax,
     5576          input bf_doc-line.excise,
     5577          input bf_doc-line.vat-pc,
     5578          input bf_doc-line.cons-vat-pc,
     5579          input bf_doc-line.slt-pc,
     5580          input bf_trn-doc.base-rate,
     5581          input bf_trn-doc.base-scale,
     5582          input varr-b,
     5583          input varcur-base,
     5584          input varcur-road-tax,
     5585          input varcur-excise,
     5586          input varcur-vat-pc,
     5587          input varcur-cons-vat-pc,
     5588          input varcur-slt-pc
     5589          ) no-error.
     5590       if error-status:error then do:
     5591         message
     5592           vss-workfile vss-revision vss-description skip
     5593           "Ошибка при вызове процедуры clcprtsl_calc-ttable." skip
     5594           return-value skip
     5595           trim(error-status :get-message(1))
     5596           trim(error-status :get-message(2))
     5597           trim(error-status :get-message(3))
     5598           trim(error-status :get-message(4))
     5599           trim(error-status :get-message(5)) skip
     5600           view-as alert-box error.
     5601         undo, return error .
     5602       end.
     5603     end.
     5604   end.
     5605   end.
     5606   procedure clcprtsl_calc-ttable :
     5607   define input parameter paris-doc           as   logical                 no-undo.
     5608   define input parameter paris-cur           as   logical                 no-undo.
     5609   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     5610   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     5611   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     5612   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     5613   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     5614   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     5615   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     5616   define input parameter parr-b              as   character               no-undo.
     5617   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     5618   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     5619   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     5620   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     5621   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     5622   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     5623   define buffer bf_tt-allsum      for tt-allsum.
     5624   define buffer bf_tt-clcparts    for tt-clcparts.
     5625   define buffer bf_tt-allsum-line for tt-allsum-line.
     5626   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     5627   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     5628   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     5629   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     5630   define variable varexcise          like ub.price-list.excise     no-undo.
     5631   do on error undo, return error return-value :
     5632   for each bf_tt-allsum-line
     5633   on error undo, return error return-value
     5634    :
     5635     delete bf_tt-allsum-line.
     5636   end.
     5637   for each bf_tt-allsum
     5638   on error undo, return error return-value
     5639   :
     5640     delete bf_tt-allsum.
     5641   end.
     5642   for each bf_tt-clcparts
     5643   on error undo, return error return-value
     5644   :
     5645   if v-calcbypart then do:
     5646             assign
     5647             parcur-base =   bf_tt-clcparts.part-cur-base
     5648             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     5649             parcur-excise =   bf_tt-clcparts.part-cur-excise
     5650             .
     5651   end.
     5652      run clcprtsl_calc-parts in this-procedure (
     5653        input recid(bf_tt-clcparts),
     5654        input paris-doc,
     5655        input paris-cur,
     5656        input parroad-tax,
     5657        input parexcise,
     5658        input parvat-pc,
     5659        input parcons-vat-pc,
     5660        input parslt-pc,
     5661        input parbase-rate,
     5662        input parbase-scale,
     5663        input parr-b,
     5664        input parcur-base,
     5665        input parcur-road-tax,
     5666        input parcur-excise,
     5667        input parcur-vat-pc,
     5668        input parcurcons-vat-pc,
     5669        input parcurslt-pc
     5670        ) no-error.
     5671     if error-status:error then do:
     5672       message
     5673         vss-workfile vss-revision vss-description skip
     5674         vss-include-info16 skip
     5675         "Ошибка при обсчете партии" skip
     5676         "Документ партии " bf_tt-clcparts.out-code skip
     5677         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     5678         return-value skip
     5679         error-status:get-message(1) skip
     5680         error-status:get-message(2) skip
     5681         error-status:get-message(3) skip
     5682         view-as alert-box error .
     5683       undo, return error .
     5684     end.
     5685     for each bf_tt-allsum on error undo, return error return-value :
     5686       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     5687       if not available bf_tt-allsum-line then do:
     5688         create bf_tt-allsum-line.
