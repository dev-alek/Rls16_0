     6304           for each buf_doc-line
     6305             where buf_doc-line.doc-code = t-doc.doc-code
     6306             , first buf_goods no-lock
     6307             where buf_goods.artic      = buf_doc-line.artic
     6308                 and buf_goods.prod-type  = buf_doc-line.prod-type
     6309                 and buf_goods.prod-code  = buf_doc-line.prod-code
     6310             break by buf_doc-line.num-place
     6311           :
     6312             run print-line in this-procedure .
     6313           end.
     6314         end.
     6315       end.
     6316     end.
     6317     if prn_NP then do:
     6318       put stream out_stream Line format "X(134)" skip .
     6319       if PrintRubl then do:
     6320         display stream out_stream
     6321           sym1 sym2 sym3 sym4 "ИТОГО: " @ gds_name sym5 sym6 sym7 all-qnty @ qnty sym8 all-stoim @ stoim sym9 all-SLT-sum @ SLT-sum sym10
     6322         with frame rubl.
     6323         down stream out_stream with frame rubl .
     6324       end.
     6325       else do:
     6326         display stream out_stream
     6327           sym1 sym2 sym3 sym4 "ИТОГО: " @ gds_name sym5 sym6 sym7 all-qnty @ qnty sym8 all-stoim @ stoim sym9 all-SLT-sum @ SLT-sum sym10
     6328         with frame val.
     6329         down stream out_stream with frame val .
     6330       end.
     6331       put stream out_stream Line format "X(134)" skip .
     6332     end.
     6333     else do:
     6334       put stream out_stream Line format "X(119)" skip .
     6335       if PrintRubl then do:
     6336         display stream out_stream
     6337           sym1 sym2 sym3 sym4 "ИТОГО: " @ gds_name sym5 sym6 sym7 all-qnty @ qnty sym8 all-stoim @ stoim sym10
     6338         with frame rubl1.
     6339         down stream out_stream with frame rubl1 .
     6340       end.
     6341       else do:
     6342         display stream out_stream
     6343           sym1 sym2 sym3 sym4 "ИТОГО: " @ gds_name sym5 sym6 sym7 all-qnty @ qnty sym8 all-stoim @ stoim sym10
     6344         with frame val1.
