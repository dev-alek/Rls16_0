     6363           put stream Out_stream space(1) "Скидка " format "x(8)"
     6364             ( if t-doc.tot-calc <> 0 and t-doc.discnt-pc = 0  then " " else string( string( t-doc.discnt-pc, "->>9.9" ) + "%" ) )
     6365             space(2) "на сумму" format "x(10)"
     6366             space(2) ( if not PrintRubl then t-doc.tot-calc else t-doc.discnt-rubl )  format "->>>,>>>,>>>,>>9.99"
     6367             space(2) ( if not PrintRubl then base-type else "РУБ" )  format "x(4)" skip .
     6368         end.
     6369         else put stream Out_stream " " skip .
