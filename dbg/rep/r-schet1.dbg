     5437     ,input  bf_trn-doc.obj-type
     5438     ,input  bf_trn-doc.obj-code
     5439     ,output varcur-vat-pc
     5440     ) no-error .
     5441       if varcur-vat-pc = ?
     5442       then do:
     5443         return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3 документ &4", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code, bf_trn-doc.doc-code).
     5444       end.
     5445       if varcur-slt-pc = ?
     5446       then do:
     5447         return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3 документ &4", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code, bf_trn-doc.doc-code).
     5448       end.
     5449       v-calcbypart = no.
     5450       if bf_doc-line.whole-send-news = integer('1':U)   then
     5451       v-calcbypart = yes.
