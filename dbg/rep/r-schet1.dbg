     3456   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3457     (input  buf_wth-doc.obj-type
     3458     ,input  buf_wth-doc.obj-code
     3459     ,output v-host-code
     3460     )  .
     3461            end.
     3462         if v-torgconf-outogr = "no_print"
     3463            then do:
     3464               assign
     3465                  v-torgconf-ogr-name = ""
     3466                  v-torgconf-ogr-post = ""
     3467               .
     3468            end.
     3469         if v-torgconf-outogr  = "ruk_firm"
     3470               then do:
     3471               find first buf_sysconf no-lock
     3472               where buf_sysconf.host-code = v-host-code
     3473               no-error.
     3474               if available buf_sysconf
     3475               then do:
     3476                  assign
     3477                     v-torgconf-ogr-post = buf_sysconf.head-position
     3478                  .
     3479               end.
     3480               find first buf_clients no-lock
     3481                  where buf_clients.obj-type = 'орг':U
     3482                  and buf_clients.obj-code = v-host-code
     3483               .
     3484               find first buf_firm no-lock
     3485                  where buf_firm.firm-code = buf_clients.obj-code
     3486               .
     3487               assign
     3488                  v-torgconf-ogr-name = buf_firm.director
     3489               .
     3490            end.
     3491            if v-torgconf-outogr = "dir_obj"
     3492               then do:
     3493               find first buf_wth-doc no-lock
     3494               where buf_wth-doc.doc-code = p-doc-code
     3495               no-error.
     3496                  find first buf_shop no-lock
     3497                  where buf_shop.obj-code = buf_wth-doc.obj-code
     3498                  .
     3499                  assign
     3500                     v-torgconf-ogr-name = buf_shop.director
     3501                     v-torgconf-ogr-post = "Директор"
     3502                  .
     3503               end.
     3504         if v-torgconf-outogr = "manag_doc"
     3505            then do:
     3506               find first buf_wth-doc no-lock
     3507               where buf_wth-doc.doc-code = p-doc-code
     3508               no-error.
     3509               if available buf_wth-doc
     3510               then do:
     3511                  run rep/get-psn.p
     3512                  (input buf_wth-doc.deliver
     3513                  ,output v-torgconf-ogr-name
     3514                  ) .
     3515               end.
     3516               find first buf_person no-lock
     3517               where buf_person.psn-code = buf_wth-doc.deliver
     3518               no-error.
     3519               if available buf_person
     3520               then do:
     3521                  v-torgconf-ogr-post = buf_person.position.
     3522               end.
     3523               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3524               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3525            end.
     3526      end.
     3527   end.
     3528   end procedure.
     3529   procedure torgconf-get-outogr-param:
     3530       define input parameter p-form-name  as character    no-undo.
     3531       define input parameter p-host-code  as integer      no-undo.
     3532       define input parameter p-obj-type   as character    no-undo.
     3533       define input parameter p-obj-code   as integer      no-undo.
     3534       define input parameter p-doc-code   as character      no-undo.
     3535       define buffer buf_firm          for ub.firm .
     3536       define buffer buf_clients       for ub.clients .
     3537       define buffer buf_sysconf       for ub.sysconf .
     3538       define buffer buf_shop          for ub.shop .
     3539       define buffer buf_store         for ub.store .
     3540       define buffer buf_person        for ub.person .
     3541       define buffer buf_trn-doc       for ub.trn-doc .
     3542       define buffer buf_wth-doc       for ub.wth-doc .
     3543      if  p-form-name <> 'wthtrg12':U
     3544      and p-form-name <> 'wthfct':U
     3545      and p-form-name <> 'wthm11':U
     3546      then do:
     3547       find first buf_trn-doc no-lock
     3548       where buf_trn-doc.doc-code = p-doc-code
     3549       no-error.
     3550       if v-torgconf-outogr = "no_print"
     3551         then do:
     3552            assign
     3553               v-torgconf-ogr-name = ""
     3554               v-torgconf-ogr-post = ""
     3555            .
     3556         end.
     3557      if v-torgconf-outogr  = "ruk_firm"
     3558            then do:
     3559            find first buf_sysconf no-lock
     3560            where buf_sysconf.host-code = p-host-code
     3561            no-error.
     3562            if available buf_sysconf
     3563            then do:
     3564               assign
     3565                  v-torgconf-ogr-post = buf_sysconf.head-position
     3566               .
     3567            end.
     3568            find first buf_clients no-lock
     3569                where buf_clients.obj-type = 'орг':U
     3570                and buf_clients.obj-code = p-host-code
     3571            .
     3572            find first buf_firm no-lock
     3573                where buf_firm.firm-code = buf_clients.obj-code
     3574            .
     3575            assign
     3576                v-torgconf-ogr-name = buf_firm.director
     3577            .
     3578         end.
     3579         if v-torgconf-outogr = "dir_obj"
     3580            then do:
     3581            find first buf_trn-doc no-lock
     3582            where buf_trn-doc.doc-code = p-doc-code
     3583            no-error.
     3584               CASE buf_trn-doc.obj-type:
     3585               WHEN 'маг':U
     3586               THEN DO:
     3587                  find first buf_shop no-lock
     3588                  where buf_shop.obj-code = buf_trn-doc.obj-code
     3589                  .
     3590                  assign
     3591                     v-torgconf-ogr-name = buf_shop.director
     3592                     v-torgconf-ogr-post = "Директор"
     3593                  .
     3594               END.
     3595               WHEN 'скл':U
     3596               THEN DO:
     3597                  find first buf_store no-lock
     3598                  where buf_store.obj-code = buf_trn-doc.obj-code
     3599                  .
     3600                  assign
     3601                     v-torgconf-ogr-name = buf_store.store-boss
     3602                     v-torgconf-ogr-post = "Директор"
     3603                  .
     3604               END.
     3605               OTHERWISE DO:
     3606                  assign
     3607                     v-torgconf-ogr-name = "":U
     3608                     v-torgconf-ogr-post = "":U
     3609                  .
     3610               END.
     3611               END CASE.
     3612            end.
     3613      if v-torgconf-outogr = "manag_doc"
     3614         then do:
     3615            find first buf_trn-doc no-lock
     3616            where buf_trn-doc.doc-code = p-doc-code
     3617            no-error.
     3618            if available buf_trn-doc
     3619            then do:
     3620               run rep/get-psn.p
     3621               (input buf_trn-doc.boss
     3622               ,output v-torgconf-ogr-name
     3623               ) .
     3624            end.
     3625            find first buf_person no-lock
     3626            where buf_person.psn-code = buf_trn-doc.boss
     3627            no-error.
     3628            if available buf_person
     3629            then do:
     3630               v-torgconf-ogr-post = buf_person.position.
     3631            end.
     3632            if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3633            if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3634         end.
     3635      end.
     3636      else do:
     3637      find first buf_wth-doc no-lock
     3638         where buf_wth-doc.doc-code = p-doc-code
     3639         no-error.
     3640         if v-torgconf-outogr = "no_print"
     3641            then do:
     3642               assign
     3643                  v-torgconf-ogr-name = ""
     3644                  v-torgconf-ogr-post = ""
     3645               .
     3646            end.
     3647         if v-torgconf-outogr  = "ruk_firm"
     3648               then do:
     3649               find first buf_sysconf no-lock
     3650               where buf_sysconf.host-code = p-host-code
     3651               no-error.
     3652               if available buf_sysconf
     3653               then do:
     3654                  assign
     3655                     v-torgconf-ogr-post = buf_sysconf.head-position
     3656                  .
     3657               end.
     3658               find first buf_clients no-lock
     3659                  where buf_clients.obj-type = 'орг':U
     3660                  and buf_clients.obj-code = p-host-code
     3661               .
     3662               find first buf_firm no-lock
     3663                  where buf_firm.firm-code = buf_clients.obj-code
     3664               .
     3665               assign
     3666                  v-torgconf-ogr-name = buf_firm.director
     3667               .
     3668            end.
     3669            if v-torgconf-outogr = "dir_obj"
     3670               then do:
     3671               find first buf_wth-doc no-lock
     3672               where buf_wth-doc.doc-code = p-doc-code
     3673               no-error.
     3674                  find first buf_shop no-lock
     3675                  where buf_shop.obj-code = buf_wth-doc.obj-code
     3676                  .
     3677                  assign
     3678                     v-torgconf-ogr-name = buf_shop.director
     3679                     v-torgconf-ogr-post = "Директор"
     3680                  .
     3681               end.
     3682         if v-torgconf-outogr = "manag_doc"
     3683            then do:
     3684               find first buf_wth-doc no-lock
     3685               where buf_wth-doc.doc-code = p-doc-code
     3686               no-error.
     3687               if available buf_wth-doc
     3688               then do:
     3689                  run rep/get-psn.p
     3690                  (input buf_wth-doc.deliver
     3691                  ,output v-torgconf-ogr-name
     3692                  ) .
     3693               end.
     3694               find first buf_person no-lock
     3695               where buf_person.psn-code = buf_wth-doc.deliver
     3696               no-error.
     3697               if available buf_person
     3698               then do:
     3699                  v-torgconf-ogr-post = buf_person.position.
     3700               end.
     3701               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3702               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3703            end.
     3704      end.
     3705   end.
     3706   procedure torgconf-get-reason  :
     3707   define input parameter  p-doc-code       as character        no-undo.
     3708   define input parameter  p-reason-code    as integer          no-undo .
     3709   define input parameter  p-doc-type       as character        no-undo.
     3710       if p-reason-code > 0
     3711       then do:
     3712           define buffer buf_trn-reason for ub.trn-reason.
     3713           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     3714           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     3715       end.
     3716       else do:
     3717           if p-doc-type = 'при':U
     3718           then  do:
     3719               define variable v-attr-type     as character    no-undo.
     3720               define variable v-attr-value    as character    no-undo.
     3721               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     3722               assign v-torgconf-reason = v-attr-value .
     3723               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     3724               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     3725           end.
     3726       end.
     3727   end procedure.
