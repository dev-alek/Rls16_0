     5761   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5762     define variable v-cntxp-doc-prt         like ub.store.doc-prt         no-undo.
     5763     define variable v-cntxp-price-calc      like ub.store.price-calc      no-undo.
     5764     define variable v-cntxp-inout-price     like ub.store.inout-price     no-undo.
