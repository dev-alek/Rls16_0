     6183     if can-do( 'накл':U , t-doc.status_ ) and ( not t-doc.flag_ ) then
     6184       put stream Out_stream "----------   Т Е С Т О В А Я   П Е Ч А Т Ь   ----------"  at 31 format "X(60)" skip(1) .
     6185     if v-sort-prod = "yes" then do:
     6186       if sort-gr = yes then do:
     6187         if sort-name = yes then do:
     6188           for each buf_doc-line no-lock
     6189             where buf_doc-line.doc-code = t-doc.doc-code
     6190             , first buf_goods no-lock
     6191               where buf_goods.artic      = buf_doc-line.artic
     6192                 and buf_goods.prod-type  = buf_doc-line.prod-type
     6193                 and buf_goods.prod-code  = buf_doc-line.prod-code
     6194             break by buf_doc-line.prod-type by buf_doc-line.prod-code by buf_goods.grp-name  by buf_goods.gds-name
     6195           :
     6196             if  first-of( buf_doc-line.prod-code) then do:
     6197               run print-prod in this-procedure .
     6198             end.
     6199             if  first-of( buf_goods.grp-name) then do:
     6200               run print-grp in this-procedure .
     6201             end.
     6202             run print-line in this-procedure .
     6203           end.
     6204         end.
     6205         else do:
     6206           for each buf_doc-line
     6207             where buf_doc-line.doc-code = t-doc.doc-code
     6208             , first buf_goods no-lock
     6209               where buf_goods.artic      = buf_doc-line.artic
     6210                 and buf_goods.prod-type  = buf_doc-line.prod-type
     6211                 and buf_goods.prod-code  = buf_doc-line.prod-code
     6212             break by buf_doc-line.prod-type by buf_doc-line.prod-code by buf_goods.grp-name  by buf_doc-line.num-place
     6213           :
     6214             if  first-of( buf_doc-line.prod-code) then do:
     6215               run print-prod in this-procedure .
     6216             end.
     6217             if  first-of( buf_goods.grp-name) then do:
     6218               run print-grp in this-procedure .
     6219             end.
     6220             run print-line in this-procedure .
     6221           end.
     6222         end.
     6223       end.
     6224       else do:
     6225         if sort-name = yes then do:
     6226           for each buf_doc-line no-lock
     6227             where buf_doc-line.doc-code = t-doc.doc-code
     6228             , first buf_goods no-lock
     6229             where buf_goods.artic      = buf_doc-line.artic
     6230               and buf_goods.prod-type  = buf_doc-line.prod-type
     6231               and buf_goods.prod-code  = buf_doc-line.prod-code
     6232             break by buf_doc-line.prod-type by buf_doc-line.prod-code by buf_goods.gds-name
     6233           :
     6234             if  first-of( buf_doc-line.prod-code) then do:
     6235               run print-prod in this-procedure .
     6236             end.
     6237             run print-line in this-procedure .
