        1   block-level on error undo, throw.
        2   define input parameter parParentProc     AS WIDGET-HANDLE NO-UNDO.
        3   define input parameter rec_id   as recid          no-undo.
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: r-schet1.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: rep/r-schet1.p $":U .
        9   define variable vss-description as character no-undo init "Печать счета".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71     define variable v-cntxt-db-num        as integer   no-undo .
       72     define variable v-cntxt-userid        as character no-undo .
       73     define variable v-cntxt-level         as character no-undo .
       74     define variable v-cntxt-host-code-obj as integer   no-undo .
       75     define variable v-cntxt-obj-type      as character no-undo .
       76     define variable v-cntxt-obj-code      as integer   no-undo .
       77     define variable v-cntxt-db-num-obj    as integer   no-undo .
       78     define variable v-cntxt-is-admin      as logical   no-undo .
       79   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80     run mainmenu_getcntxt in parparentproc
       81       (output v-cntxt-db-num
       82       ,output v-cntxt-userid
       83       ,output v-cntxt-level
       84       ,output v-cntxt-host-code-obj
       85       ,output v-cntxt-obj-type
       86       ,output v-cntxt-obj-code
       87       ,output v-cntxt-db-num-obj
       88       ,output v-cntxt-is-admin
       89       ) .
       90   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       91   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       92   define  shared variable RepPathName        as character no-undo .
       93   define  shared variable PrintRubl          as logical   no-undo .
       94   define variable vss-include-info3 as character format "X(65)" no-undo
       95   initial "@(#)$Workfile$ $Revision$".
       96   define variable v-fmtcli-name          as character    no-undo.
       97   define variable v-fmtcli-engl-name     as character    no-undo.
       98   define variable v-fmtcli-addres        as character    no-undo.
       99   define variable v-fmtcli-post-addres   as character    no-undo.
      100   define variable v-fmtcli-full-addres   as character    no-undo.
      101   define variable v-fmtcli-phone         as character    no-undo.
      102   define variable v-fmtcli-inn           as character    no-undo.
      103   define variable v-fmtcli-kpp           as character    no-undo.
      104   define variable v-fmtcli-okpo          as character    no-undo.
      105   define variable v-fmtcli-country       as character    no-undo.
      106   define variable v-fmtcli-city          as character    no-undo.
      107   define variable v-fmtcli-index         as character    no-undo.
      108   define variable v-fmtcli-schet-exists  as logical      no-undo.
      109   define variable v-fmtcli-bank-exists   as logical      no-undo.
      110   define variable v-fmtcli-bank-r-schet  as character    no-undo.
      111   define variable v-fmtcli-bank-c-schet  as character    no-undo.
      112   define variable v-fmtcli-bank-bik      as character    no-undo.
      113   define variable v-fmtcli-bank-name     as character    no-undo.
      114   define variable v-fmtcli-bank-addres   as character    no-undo.
      115   define variable v-fmtcli-bank-city     as character    no-undo.
      116   procedure fmtcli-get-bank :
      117   define input parameter p-host-code      as integer          no-undo.
      118   define input parameter p-obj-type       as character        no-undo.
      119   define input parameter p-obj-code       as integer          no-undo.
      120   define input parameter p-curr-code      as integer          no-undo.
      121       define buffer buf_fin-schet     for ub.fin-schet.
      122       define buffer buf_fin-bank      for ub.fin-bank.
      123   do
      124   for buf_fin-schet
      125     , buf_fin-bank
      126   on error undo, return error
      127   :
      128       assign
      129           v-fmtcli-schet-exists       = no
      130           v-fmtcli-bank-exists        = no
      131           v-fmtcli-bank-r-schet       = "":U
      132           v-fmtcli-bank-c-schet       = "":U
      133           v-fmtcli-bank-bik           = "":U
      134           v-fmtcli-bank-name          = "":U
      135           v-fmtcli-bank-addres        = "":U
      136           v-fmtcli-bank-city          = "":U
      137       .
      138       search-for-schet:
      139       for each buf_fin-schet no-lock
      140          where buf_fin-schet.host-code = p-host-code
      141            and buf_fin-schet.cli-type  = p-obj-type
      142            and buf_fin-schet.cli-code  = p-obj-code
      143            and buf_fin-schet.curr-code = p-curr-code
      144       on error undo, return error
      145       :
      146           if buf_fin-schet.status_   = 'удал':U
      147           then do:
      148           end.
      149           else do:
      150               assign
      151                   v-fmtcli-schet-exists   = yes
      152                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      153                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      154               .
      155               find first buf_fin-bank no-lock
      156                    where buf_fin-bank.host-code = p-host-code
      157                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      158               no-error.
      159               if available buf_fin-bank
      160               then do:
      161                   assign
      162                       v-fmtcli-bank-exists      = yes
      163                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      164                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      165                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      166                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      167                   .
      168               end.
      169               else do:
      170                   assign
      171                       v-fmtcli-bank-exists    = no
      172                       v-fmtcli-bank-bik       = "":U
      173                       v-fmtcli-bank-name      = "":U
      174                       v-fmtcli-bank-addres    = "":U
      175                       v-fmtcli-bank-city      = "":U
      176                   .
      177               end.
      178               leave search-for-schet.
      179           end.
      180       end.
      181   end.
      182   end procedure.
      183   procedure fmtcli-get-client :
      184   define input parameter p-obj-type       as character    no-undo.
      185   define input parameter p-obj-code       as integer      no-undo.
      186       define variable v-temp-fmtcli-address      as character     no-undo.
      187       define variable v-num-country-city    as integer      no-undo.
      188       define buffer buf_clients   for ub.clients.
      189       define buffer buf_firm      for ub.firm.
      190       define buffer buf_store     for ub.store.
      191       define buffer buf_shop      for ub.shop.
      192       define buffer buf_person    for ub.person.
      193   do
      194   for buf_clients
      195     , buf_firm
      196     , buf_store
      197     , buf_shop
      198     , buf_person
      199   on error undo, return error
      200   :
      201       assign
      202           v-fmtcli-name           = "":U
      203           v-fmtcli-addres         = "":U
      204           v-fmtcli-post-addres    = "":U
      205           v-fmtcli-full-addres    = "":U
      206           v-fmtcli-phone          = "":U
      207           v-fmtcli-inn            = "":U
      208           v-fmtcli-kpp            = "":U
      209           v-fmtcli-okpo           = "":U
      210           v-fmtcli-city           = "":U
      211           v-fmtcli-index          = "":U
      212           v-fmtcli-country        = "":U
      213       .
      214       find first buf_clients no-lock
      215            where buf_clients.obj-type = p-obj-type
      216              and buf_clients.obj-code = p-obj-code
      217       .
      218       assign
      219           v-fmtcli-name = buf_clients.obj-name
      220       .
      221       case buf_clients.obj-type:
      222          when 'орг':U
      223          then do:
      224               find first buf_firm no-lock
      225                    where buf_firm.firm-code = buf_clients.obj-code
      226                    no-error
      227               .
      228               if available buf_firm
      229               then do:
      230                   assign
      231                       v-num-country-city = num-entries( buf_firm.city )
      232                       v-fmtcli-engl-name = buf_firm.engl-name
      233                   .
      234                   if v-num-country-city > 0
      235                   then do:
      236                       assign
      237                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
      238                       .
      239                   end.
      240                   if v-num-country-city > 1
      241                   then do:
      242                       assign
      243                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
      244                       .
      245                   end.
      246                   run fmtcli-concatenate-strings in this-procedure (
      247                         input v-fmtcli-full-addres
      248                       , input v-fmtcli-country
      249                       , input ", ":U
      250                       , input 50
      251                       , output v-fmtcli-full-addres
      252                   ).
      253                   run fmtcli-concatenate-strings in this-procedure (
      254                         input v-fmtcli-full-addres
      255                       , input v-fmtcli-city
      256                       , input ", ":U
      257                       , input 50
      258                       , output v-fmtcli-full-addres
      259                   ).
      260                   run fmtcli-concatenate-strings in this-procedure (
      261                         input v-fmtcli-full-addres
      262                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
      263                       , input ", ":U
      264                       , input 50
      265                       , output v-fmtcli-full-addres
      266                   ).
      267                   run fmtcli-concatenate-strings in this-procedure (
      268                         input v-fmtcli-post-addres
      269                       , input v-fmtcli-country
      270                       , input ", ":U
      271                       , input 50
      272                       , output v-fmtcli-post-addres
      273                   ).
      274                   run fmtcli-concatenate-strings in this-procedure (
      275                         input v-fmtcli-post-addres
      276                       , input v-fmtcli-city
      277                       , input ", ":U
      278                       , input 50
      279                       , output v-fmtcli-post-addres
      280                   ).
      281                   run fmtcli-concatenate-strings in this-procedure (
      282                         input v-fmtcli-post-addres
      283                       , input string( buf_firm.ind )
      284                       , input ", ":U
      285                       , input 50
      286                       , output v-fmtcli-post-addres
      287                   ).
      288                   run fmtcli-concatenate-strings in this-procedure (
      289                         input substring( buf_firm.addres1, 1, 50 )
      290                       , input buf_firm.addres2
      291                       , input " ":U
      292                       , input 50
      293                       , output v-temp-fmtcli-address
      294                   ).
      295                   run fmtcli-concatenate-strings in this-procedure (
      296                         input v-temp-fmtcli-address
      297                       , input substring( buf_firm.addres1, 51, 50 )
      298                       , input " ":U
      299                       , input 50
      300                       , output v-temp-fmtcli-address
      301                   ).
      302                   run fmtcli-concatenate-strings in this-procedure (
      303                         input v-temp-fmtcli-address
      304                       , input substring( buf_firm.addres1, 101, 50 )
      305                       , input " ":U
      306                       , input 50
      307                       , output v-temp-fmtcli-address
      308                   ).
      309                   assign
      310                       v-fmtcli-addres = v-temp-fmtcli-address
      311                   .
      312                   if buf_firm.addres1 <> ?
      313                   then do:
      314                       run fmtcli-concatenate-strings in this-procedure (
      315                             input v-fmtcli-full-addres
      316                           , input v-fmtcli-addres
      317                           , input ", ":U
      318                           , input 0
      319                           , output v-fmtcli-full-addres
      320                       ).
      321                   end.
      322                   run fmtcli-concatenate-strings in this-procedure (
      323                         input substring( buf_firm.post-addr1, 1, 50 )
      324                       , input buf_firm.post-addr2
      325                       , input " ":U
      326                       , input 50
      327                       , output v-fmtcli-post-addres
      328                   ).
      329                   run fmtcli-concatenate-strings in this-procedure (
      330                         input v-fmtcli-post-addres
      331                       , input substring( buf_firm.post-addr1, 51, 50 )
      332                       , input " ":U
      333                       , input 50
      334                       , output v-fmtcli-post-addres
      335                   ).
      336                   run fmtcli-concatenate-strings in this-procedure (
      337                         input v-fmtcli-post-addres
      338                       , input substring( buf_firm.post-addr1, 101, 50 )
      339                       , input " ":U
      340                       , input 50
      341                       , output v-fmtcli-post-addres
      342                   ).
      343                   assign
      344                       v-fmtcli-phone         = buf_firm.phone
      345                       v-fmtcli-inn           = buf_firm.inn
      346                       v-fmtcli-kpp           = buf_firm.kpp
      347                       v-fmtcli-okpo          = buf_firm.okpo
      348                       v-fmtcli-index         = string( buf_firm.ind )
      349                   .
      350               end.
      351          end.
      352          when 'маг':U
      353          then do:
      354               find first buf_shop no-lock
      355                    where buf_shop.obj-code = buf_clients.obj-code
      356               .
      357               if available buf_shop
      358               then do:
      359                   run fmtcli-concatenate-strings in this-procedure (
      360                         input buf_shop.addres1
      361                       , input buf_shop.addres2
      362                       , input " ":U
      363                       , input 50
      364                       , output v-fmtcli-addres
      365                   ).
      366                   assign
      367                       v-fmtcli-full-addres = v-fmtcli-addres
      368                       v-fmtcli-post-addres = v-fmtcli-addres
      369                       v-fmtcli-phone       = buf_shop.phone
      370                       v-fmtcli-inn         = "":U
      371                       v-fmtcli-kpp         = "":U
      372                       v-fmtcli-okpo        = "":U
      373                       v-fmtcli-city        = "":U
      374                       v-fmtcli-index       = "":U
      375                   .
      376               end.
      377          end.
      378          when 'скл':U
      379          then do:
      380               find first buf_store no-lock
      381                    where buf_store.obj-code = buf_clients.obj-code
      382               .
      383               if available buf_store
      384               then do:
      385                   run fmtcli-concatenate-strings in this-procedure (
      386                         input buf_store.addres1
      387                       , input buf_store.addres2
      388                       , input " ":U
      389                       , input 50
      390                       , output v-fmtcli-addres
      391                   ).
      392                   assign
      393                       v-fmtcli-full-addres = v-fmtcli-addres
      394                       v-fmtcli-phone       = buf_store.phone
      395                       v-fmtcli-inn         = "":U
      396                       v-fmtcli-kpp         = "":U
      397                       v-fmtcli-okpo        = "":U
      398                       v-fmtcli-city        = "":U
      399                       v-fmtcli-index       = "":U
      400                   .
      401               end.
      402          end.
      403          when 'чел':U
      404          then do:
      405               find first buf_person no-lock
      406                    where buf_person.psn-code = buf_clients.obj-code
      407               .
      408               if available buf_person
      409               then do:
      410                   run fmtcli-concatenate-strings in this-procedure (
      411                         input ( if buf_person.ind = 0 or buf_person.ind = ?
      412                                 then "":U
      413                                 else string( buf_person.ind, "999999")
      414                                 )
      415                       , input buf_person.city
      416                       , input ", ":U
      417                       , input 0
      418                       , output v-fmtcli-full-addres
      419                   ).
      420                   assign
      421                       v-fmtcli-addres = buf_person.address
      422                   .
      423                   run fmtcli-concatenate-strings in this-procedure (
      424                         input v-fmtcli-full-addres
      425                       , input v-fmtcli-addres
      426                       , input ", ":U
      427                       , input 0
      428                       , output v-fmtcli-full-addres
      429                   ).
      430                   assign
      431                       v-fmtcli-phone     = buf_person.phone1
      432                       v-fmtcli-inn       = buf_person.inn
      433                       v-fmtcli-kpp       = buf_person.kpp
      434                       v-fmtcli-okpo      = buf_person.okpo
      435                       v-fmtcli-city      = buf_person.city
      436                       v-fmtcli-index     = string( buf_person.ind )
      437                   .
      438               end.
      439          end.
      440       end case.
      441   end.
      442   end procedure.
      443   procedure fmtcli-concatenate-strings :
      444   define input parameter p-string-1       as character        no-undo.
      445   define input parameter p-string-2       as character        no-undo.
      446   define input parameter p-delimiter      as character        no-undo.
      447   define input parameter p-length         as integer          no-undo.
      448   define output parameter p-out-string    as character        no-undo.
      449   do
      450   on error undo, return error
      451   :
      452       assign
      453           p-out-string = ( if p-string-1 = ?
      454                            then "":U
      455                            else trim( p-string-1 ) )
      456       .
      457       assign
      458           p-out-string = p-out-string
      459                        + ( if p-out-string = "":U
      460                            or length( p-out-string ) = p-length
      461                            or p-string-2 = ?
      462                            or trim( p-string-2 ) = "":U
      463                            then "":U
      464                            else p-delimiter )
      465                        + ( if p-string-2 = ?
      466                            or trim( p-string-2 ) = "":U
      467                            then "":U
      468                            else trim( p-string-2 ) )
      469       .
      470   end.
      471   end procedure.
      472   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      473   define new global shared variable g#attr-lib  as handle no-undo .
      474   define variable v-attr-lib-variable as handle no-undo .
      475   procedure clntattr-code :
      476     define input  parameter p-code           as character no-undo .
      477     define output parameter p-type           as character no-undo .
      478     define output parameter p-format         as character no-undo .
      479     define output parameter p-label          as character no-undo .
      480     define output parameter p-user-can-edit  as logical   no-undo .
      481     define output parameter p-output-display as logical   no-undo .
      482     define output parameter p-other          as character no-undo .
      483     do
      484     on error undo, return error return-value
      485     :
      486           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-code in g#attr-lib
      487         (input  p-code
      488         ,output p-type
      489         ,output p-format
      490         ,output p-label
      491         ,output p-user-can-edit
      492         ,output p-output-display
      493         ,output p-other
      494         ) no-error .
      495       if error-status :error
      496       then do:
      497         undo, return error return-value .
      498       end.
      499     end.
      500   end procedure.
      501   procedure clntattr-tooltip :
      502     define input  parameter p-code    as character no-undo .
      503     define output parameter p-tooltip as character no-undo .
      504     define output parameter p-label   as character no-undo .
      505     do
      506     on error undo, return error return-value
      507     :
      508           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-tooltip in g#attr-lib
      509         (input  p-code
      510         ,output p-tooltip
      511         ,output p-label
      512         ) no-error .
      513       if error-status :error
      514       then do:
      515         undo, return error return-value .
      516       end.
      517     end.
      518   end procedure.
      519   procedure clntattr-value :
      520     define input  parameter p-obj-type like ub.clients-attr.obj-type   no-undo .
      521     define input  parameter p-obj-code like ub.clients-attr.obj-code   no-undo .
      522     define input  parameter p-code     like ub.clients-attr.attr-code  no-undo .
      523     define output parameter p-value    like ub.clients-attr.attr-value no-undo .
      524     define output parameter p-type     as character no-undo .
      525     do
      526     on error undo, return error return-value
      527     :
      528           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-value in g#attr-lib
