     6373           if prn_NP and all-slt-sum <> ? and all-slt-sum > 0  then
     6374             put stream Out_stream string( "налог с продаж: " + string( all-SLT-sum, "->>>,>>>,>>9.99" ) + "РУБ") at 20 format "x(50)" skip .
     6375         end.
     6376         else do:
     6377           if all-vat-sum <> ? and all-vat-sum > 0 then
     6378             put stream Out_stream string( "НДС: " + string( all-VAT-sum , "->>>,>>>,>>9.99" ) + base-type) at 20 format "x(50)" skip .
     6379           if prn_NP and all-slt-sum <> ? and all-slt-sum > 0  then
     6380             put stream Out_stream string( "налог с продаж: " + string( all-SLT-sum, "->>>,>>>,>>9.99" ) + base-type) at 20 format "x(50)" skip .
     6381         end.
