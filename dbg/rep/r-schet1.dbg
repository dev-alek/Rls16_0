      958   define variable v-torgconf-doc-date-attr        as character no-undo.
      959   define variable v-torgconf-vdoc-date            as character no-undo.
      960   define variable v-torgconf-main-boss-post       as character no-undo.
      961   define variable v-torgconf-ogr-name             as character no-undo.
