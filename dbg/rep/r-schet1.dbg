      965   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      966   procedure wthcattr-sprcli :
      967   define input parameter parparentproc  as widget-handle no-undo.
      968   define input parameter p-mode  as character no-undo.
      969   define input-output parameter p-value as character no-undo .
      970   define output parameter p-setted as logical no-undo .
      971     DEFINE VARIABLE v-value as character no-undo .
      972     define variable v-cli-type as character no-undo .
      973     define variable v-cli-code as integer no-undo .
      974     define buffer buf_clients   for ub.clients.
      975     define variable v_rid as character no-undo.
      976     define variable ref-rec as recid no-undo .
      977     do
      978     on error undo, return error
      979     :
      980         v-value = p-value.
      981      if p-value <> '':U then do:
      982       assign
      983       v-cli-type = substring(p-value, 1, 3)
      984       v-cli-code = integer(substring(p-value, 4))
      985       no-error.
      986       if error-status:error then do:
      987         assign
      988         v-cli-type = '':U
      989         v-cli-code = 0
      990         .
      991       end.
      992      end.
      993      FIND FIRST buf_clients NO-LOCK WHERE
      994               buf_clients.obj-type = v-cli-type AND
      995               buf_clients.obj-code = v-cli-code  NO-ERROR.
      996      IF available(buf_clients) then do:
      997       run ref/cli-all.w (
      998                   input parparentproc
      999                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
     1000                  ,input v-cli-type
     1001                  ,input 'все':U
     1002                  ,input 'все':U
     1003                  ,input RECID( buf_clients )
     1004                  ,input ",,,,,,NO"
     1005                  ,input ?
     1006                  ,OUTPUT v_rid ).
     1007     END.
     1008     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     1009       run ref/cli-all.w (
     1010                    input parparentproc
     1011                   ,INPUT "b-sel":U
     1012                  ,input  v-cli-type
     1013                  ,input 'все':U
     1014                  ,input 'текущие':U
     1015                  ,input ?
     1016                  ,input ",,,,,,NO"
     1017                  ,input ?
     1018                  ,OUTPUT v_rid ).
     1019     END.
     1020     else do:
     1021       message
     1022       if p-value = "":U then 'Атрибут не задан!'
     1023       else substitute('Не найден клиент &1',p-value)
     1024       view-as alert-box warning.
     1025     end.
     1026     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1027       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1028       IF ERROR-STATUS:ERROR THEN DO:
     1029           RETURN NO-APPLY.
     1030       END.
     1031       FIND FIRST buf_clients NO-LOCK WHERE
     1032                  RECID( buf_clients ) = ref-rec NO-ERROR.
     1033       IF AVAIL buf_clients THEN DO:
     1034         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     1035       end.
     1036     end.
     1037     if v-value <> p-value then do:
     1038       p-value = v-value.
     1039       p-setted = yes.
     1040     end.
     1041     end.
     1042   end procedure.
     1043     define new global shared variable g#wthcalib as handle no-undo.
     1044   procedure torgconf-read :
     1045   do
     1046   on error undo, return error
     1047   :
     1048       define input parameter p-form-name  as character    no-undo.
     1049       define input parameter p-host-code  as integer      no-undo.
