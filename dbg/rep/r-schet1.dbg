     6450         if not printrubl then do:
     6451           display stream out_stream sym1 "Группа -" @ buf_goods.artic buf_goods.grp-name @ gds_name sym10 with frame val .
     6452           down stream out_stream 1 with frame val .
     6453           underline stream out_stream buf_goods.artic gds_name with frame val .
     6454         end.
     6455         else do:
     6456           display stream out_stream sym1 "Группа -" @ buf_goods.artic buf_goods.grp-name @ gds_name sym10 with frame rubl .
     6457           down stream out_stream 1 with frame rubl .
     6458           underline stream out_stream buf_goods.artic gds_name with frame rubl .
     6459         end.
     6460       end.
     6461       else do:
     6462         if not printrubl then do:
     6463           display stream out_stream sym1 "Группа -" @ buf_goods.artic buf_goods.grp-name @ gds_name sym10 with frame val1 .
     6464           down stream out_stream 1 with frame val1 .
     6465           underline stream out_stream buf_goods.artic gds_name with frame val1 .
     6466         end.
     6467         else do:
     6468           display stream out_stream sym1 "Группа -" @ buf_goods.artic buf_goods.grp-name @ gds_name sym10 with frame rubl1 .
     6469           down stream out_stream 1 with frame rubl1 .
     6470           underline stream out_stream buf_goods.artic gds_name with frame rubl1 .
     6471         end.
     6472       end.
     6473     end.
     6474   end procedure.
     6475   procedure print-line :
     6476     do on error undo, return error return-value :
     6477       if prn_NP then do:
     6478         if PrintRubl then do:
     6479   define variable vss-include-info39 as character format "X(65)" no-undo
     6480   initial "@(#)$Workfile$ $Revision$".
     6481   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     6482     (input  buf_goods.gds-code
     6483     ,input  ?
     6484     ,output b-code
     6485     ) no-error .
