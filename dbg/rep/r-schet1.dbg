     6498     (input  v-root-node
     6499     ,input  'empty-scale=request'
     6500     ,output empty-scale
     6501     )  .
     6502       run clcprtsl_calc-line in this-procedure (input recid (buf_doc-line)).
     6503       find first tt-allsum-line where tt-allsum-line.sum-type = 'основная_сумма':U no-error .
