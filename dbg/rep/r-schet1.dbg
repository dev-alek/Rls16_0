     1053       define variable v-outares   as character     no-undo.
     1054       define variable v-outsend   as character     no-undo.
     1055       define variable v-outasend  as character     no-undo.
     1056       define variable v-outprops  as character     no-undo.
     1057       define variable v-outnum    as character     no-undo.
     1058       define variable v-outprim   as character     no-undo.
     1059       define variable v-outdisc   as character     no-undo.
     1060       define variable v-outsubs   as character     no-undo.
     1061       define variable v-outrecv   as character     no-undo.
     1062       define variable v-outegrp   as character     no-undo.
     1063       define variable v-outt12    as character     no-undo.
     1064       define variable v-outappr   as character     no-undo.
     1065       define variable v-outrubl   as character     no-undo.
     1066       define variable v-outhold   as character     no-undo.
     1067       define variable v-outobj    as character     no-undo.
     1068       define variable v-outexlst  as character     no-undo.
     1069       define variable v-outprncd  as character     no-undo.
     1070       define variable v-par-type  as character     no-undo.
     1071       define variable v-outogr    as character     no-undo.
     1072       define variable v-outR      as character     no-undo.
     1073       define variable v-outB      as character     no-undo.
     1074       define variable v-outC      as character     no-undo.
     1075       assign
     1076           v-torgconf-outdate  = no
     1077           v-torgconf-outnum   = no
     1078           v-torgconf-outprim  = no
     1079           v-torgconf-outdisc  = no
     1080           v-torgconf-outsubs  = no
     1081           v-torgconf-outrecv  = no
     1082           v-torgconf-outegrp  = no
     1083           v-torgconf-outt12   = no
     1084           v-torgconf-outappr  = no
     1085           v-torgconf-outrubl  = no
     1086           v-torgconf-outhold  = no
     1087           v-torgconf-outobj   = no
     1088           v-torgconf-outexlst = no
     1089           v-torgconf-outexpas = "":U
     1090           v-torgconf-outprncd = yes
     1091           v-torgconf-outares  = no
     1092           v-torgconf-outsend  = no
     1093           v-torgconf-outasend  = no
     1094           v-torgconf-outprops  = no
     1095           v-form-name          = p-form-name
     1096       .
     1097   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1098   empty temp-table thbjattr_thbj-attr.
     1099   run adm/shattri.p (
     1100      input "get":U
     1101     ,input ''
     1102     ,input 0
     1103     ,input 'prt-glob':U
     1104     ,input  ""
     1105     ,output v-value-character
     1106     ,output v-value-date
     1107     ,output v-value-decimal
     1108     ,output v-value-integer
     1109     ,output v-value-logical
     1110     ,output par-type
     1111     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1112     ) no-error .
     1113   for each thbjattr_thbj-attr :
     1114       if thbjattr_thbj-attr.prop-code = 'outprncd':U then v-outprncd =  string(thbjattr_thbj-attr.property-value-logical) .
     1115       if thbjattr_thbj-attr.prop-code = 'outrecv':U  then v-outrecv  =  thbjattr_thbj-attr.property-value-character .
     1116       if thbjattr_thbj-attr.prop-code = 'outprops':U then v-outprops =  thbjattr_thbj-attr.property-value-character .
     1117   end.
     1118   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1119   empty temp-table thbjattr_thbj-attr.
     1120   run adm/shattri.p (
     1121      input "get":U
     1122     ,input p-obj-type
     1123     ,input p-obj-code
     1124     ,input 'prt-obj':U
     1125     ,input  ""
     1126     ,output v-value-character
     1127     ,output v-value-date
     1128     ,output v-value-decimal
     1129     ,output v-value-integer
     1130     ,output v-value-logical
     1131     ,output par-type
     1132     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1133     ) no-error .
     1134   for each thbjattr_thbj-attr :
     1135       if thbjattr_thbj-attr.prop-code = 'outdate':U  then v-outdate  =  thbjattr_thbj-attr.property-value-character .
     1136       if thbjattr_thbj-attr.prop-code = 'outares':U  then v-outares  =  thbjattr_thbj-attr.property-value-character .
     1137       if thbjattr_thbj-attr.prop-code = 'outnum':U   then v-outnum   =  thbjattr_thbj-attr.property-value-character .
     1138       if thbjattr_thbj-attr.prop-code = 'outprim':U  then v-outprim  =  thbjattr_thbj-attr.property-value-character .
     1139       if thbjattr_thbj-attr.prop-code = 'outdisc':U  then v-outdisc  =  thbjattr_thbj-attr.property-value-character .
     1140       if thbjattr_thbj-attr.prop-code = 'outsubs':U  then v-outsubs  =  thbjattr_thbj-attr.property-value-character .
     1141       if thbjattr_thbj-attr.prop-code = 'outegrp':U  then v-outegrp  =  thbjattr_thbj-attr.property-value-character .
     1142       if thbjattr_thbj-attr.prop-code = 'outt12':U   then v-outt12   =  thbjattr_thbj-attr.property-value-character .
     1143       if thbjattr_thbj-attr.prop-code = 'outappr':U  then v-outappr  =  thbjattr_thbj-attr.property-value-character .
     1144       if thbjattr_thbj-attr.prop-code = 'outrubl':U  then v-outrubl  =  thbjattr_thbj-attr.property-value-character .
     1145       if thbjattr_thbj-attr.prop-code = 'outhold':U  then v-outhold  =  thbjattr_thbj-attr.property-value-character .
     1146       if thbjattr_thbj-attr.prop-code = 'outobj':U   then v-outobj   =  thbjattr_thbj-attr.property-value-character .
     1147       if thbjattr_thbj-attr.prop-code = 'outsend':U  then v-outsend  =  thbjattr_thbj-attr.property-value-character .
     1148       if thbjattr_thbj-attr.prop-code = 'outasend':U then v-outasend =  thbjattr_thbj-attr.property-value-character .
     1149       if thbjattr_thbj-attr.prop-code = 'outogr':U   then v-torgconf-outogr   =  thbjattr_thbj-attr.property-value-character .
     1150       if thbjattr_thbj-attr.prop-code = 'outR':U     then v-torgconf-outR     =  thbjattr_thbj-attr.property-value-character .
     1151       if thbjattr_thbj-attr.prop-code = 'outB':U     then v-torgconf-outB     =  thbjattr_thbj-attr.property-value-character .
     1152       if thbjattr_thbj-attr.prop-code = 'outssdoc':U then v-torgconf-outssdoc =  thbjattr_thbj-attr.property-value-character .
     1153       if thbjattr_thbj-attr.prop-code = 'outC':U     then v-torgconf-outC     =  thbjattr_thbj-attr.property-value-character .
     1154   end.
     1155       run gbl/conf-rd.p ("outexpas", "":U, "":U, 0, "":U, "":U, "":U, no, output v-torgconf-outexpas, output v-par-type) no-error.
     1156       if error-status :error
     1157       then do:
     1158           assign
     1159               v-torgconf-outexpas = "":U
     1160           .
     1161       end.
     1162       assign
     1163           v-torgconf-outprncd = ( v-outprncd = "yes":U )
     1164       .
     1165       if p-form-name <> ""
     1166       and p-form-name <> ?
     1167       then do:
     1168           run gbl/conf-rd.p ("outexlst" , p-host-code, p-obj-type, p-obj-code, "", "", "", no, output v-outexlst , output v-par-type) no-error.
     1169           if error-status :error
     1170           then do:
     1171               assign
     1172                   v-outexlst           = ""
     1173               .
     1174           end.
     1175           if lookup( p-form-name, v-outdate ) <> 0
     1176           then do:
     1177               assign
     1178                   v-torgconf-outdate  = yes
     1179               .
     1180           end.
     1181           if lookup( p-form-name, v-outares ) <> 0
     1182           then do:
     1183               assign
     1184                   v-torgconf-outares  = yes
     1185               .
     1186           end.
     1187           if lookup( p-form-name, v-outnum  ) <> 0
     1188           then do:
     1189               assign
     1190                   v-torgconf-outnum   = yes
     1191               .
     1192           end.
     1193           if lookup( p-form-name, v-outprim ) <> 0
     1194           then do:
     1195               assign
     1196                   v-torgconf-outprim  = yes
     1197               .
     1198           end.
     1199           if lookup( p-form-name, v-outdisc ) <> 0
     1200           then do:
     1201               assign
     1202                   v-torgconf-outdisc  = yes
     1203               .
     1204           end.
     1205           if lookup( p-form-name, v-outsubs ) <> 0
     1206           then do:
     1207               assign
     1208                   v-torgconf-outsubs  = yes
     1209               .
     1210           end.
     1211           if lookup( p-form-name, v-outrecv ) <> 0
     1212           then do:
     1213               assign
     1214                   v-torgconf-outrecv  = yes
     1215               .
     1216           end.
     1217           if lookup( p-form-name, v-outegrp ) <> 0
     1218           then do:
     1219               assign
     1220                   v-torgconf-outegrp  = yes
     1221               .
     1222           end.
     1223           if lookup( p-form-name, v-outt12  ) <> 0
     1224           then do:
     1225               assign
     1226                   v-torgconf-outt12   = yes
     1227               .
     1228           end.
     1229           if lookup( p-form-name, v-outappr  ) <> 0
     1230           then do:
     1231               assign
     1232                   v-torgconf-outappr   = yes
     1233               .
     1234           end.
     1235           if lookup( p-form-name, v-outrubl  ) <> 0
     1236           then do:
     1237               assign
     1238                   v-torgconf-outrubl   = yes
     1239               .
     1240           end.
     1241           if lookup( p-form-name, v-outhold  ) <> 0
     1242           then do:
     1243               assign
     1244                   v-torgconf-outhold   = yes
     1245               .
     1246           end.
     1247           if lookup( p-form-name, v-outobj   ) <> 0
     1248           then do:
     1249               assign
     1250                   v-torgconf-outobj    = yes
     1251               .
     1252           end.
     1253           if lookup( p-form-name, v-outsend   ) <> 0
     1254           then do:
     1255               assign
     1256                   v-torgconf-outsend    = yes
     1257               .
     1258           end.
     1259           if lookup( p-form-name, v-outasend   ) <> 0
     1260           then do:
     1261               assign
     1262                   v-torgconf-outasend    = yes
     1263               .
     1264           end.
     1265           if lookup( p-form-name, v-outprops   ) <> 0
     1266           then do:
     1267               assign
     1268                   v-torgconf-outprops    = yes
     1269               .
     1270           end.
     1271           if lookup( p-form-name, v-outexlst ) <> 0
     1272           then do:
     1273               assign
     1274                   v-torgconf-outexlst  = yes
     1275               .
     1276           end.
     1277        assign
     1278         v-name = p-form-name.
     1279   end.
     1280   end.
     1281   end procedure.
     1282   procedure torgconf-get-self-param :
     1283   define input parameter p-obj-type           as character        no-undo.
     1284   define input parameter p-obj-code           as integer          no-undo.
     1285   define input parameter p-curr-code          as integer          no-undo.
     1286       define variable v-host-code    as integer      no-undo.
     1287       define variable v-par-type     as character    no-undo.
     1288   do
     1289   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1))
     1290   :
     1291   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1292   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1293     (input  p-obj-type
     1294     ,input  p-obj-code
     1295     ,output v-host-code
     1296     )  .
     1297       if v-torgconf-outhold = yes
     1298       then do:
     1299           run torgconf-get-holdfirm-code in this-procedure (
     1300                 input p-obj-type
     1301               , input p-obj-code
     1302               , output v-torgconf-self-host-code
     1303           ).
     1304           if v-torgconf-self-host-code = 0
     1305           then do:
     1306               return error.
     1307           end.
     1308       end.
     1309       else do:
     1310           assign
     1311               v-torgconf-self-host-code = v-host-code
     1312           .
     1313       end.
     1314       if v-torgconf-self-host-code = 0
     1315       then do:
     1316           assign
     1317               v-torgconf-self-host-name           = "":U
     1318               v-torgconf-self-host-addres         = "":U
     1319               v-torgconf-self-host-post-addres    = "":U
     1320               v-torgconf-self-host-phone          = "":U
     1321               v-torgconf-self-host-inn            = "":U
     1322               v-torgconf-self-host-kpp            = "":U
     1323               v-torgconf-self-host-okpo           = "":U
     1324               v-torgconf-self-host-egrip-date     = "":U
     1325               v-torgconf-self-host-egrip-num      = "":U
     1326           .
     1327       end.
     1328       else do:
     1329           run fmtcli-get-client in this-procedure (
     1330                 input 'орг':U
     1331               , input v-torgconf-self-host-code
     1332           ).
