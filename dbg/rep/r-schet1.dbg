     5179   procedure clcprtsl_calc-line :
     5180   define input  parameter parrec-line as recid no-undo.
     5181   define variable v-tax-date         as   date                     no-undo.
     5182   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     5183   define variable varr-b             as   character                no-undo.
     5184   define variable varr-btype         as   character                no-undo.
     5185   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     5186   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     5187   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     5188   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     5189   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     5190   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     5191   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     5192   define variable varb-code          like ub.bar-code.b-code       no-undo.
     5193   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     5194   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     5195   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     5196   define variable varexcise          like ub.price-list.excise     no-undo.
     5197   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     5198   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     5199   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     5200   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     5201   define variable v-varsum           as decimal                  no-undo.
     5202   define variable varprice-salef as decimal   no-undo .
     5203   define buffer bf_trn-doc             for ub.trn-doc.
     5204   define buffer bf_doc-line            for ub.doc-line.
     5205   define buffer bf_gds-dtl             for ub.gds-dtl.
     5206   define buffer bf_goods               for ub.goods.
     5207   define buffer bf_parts               for ub.parts.
     5208   define buffer bf_sysconf             for ub.sysconf.
     5209   define buffer bf_tt-allsum-line      for tt-allsum-line.
     5210   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     5211   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     5212   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     5213   define buffer buf_parts        for ub.parts.
     5214   v-calcbypart = no.
     5215   do on error undo, return error return-value :
     5216   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     5217   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     5218     (output varr-b
     5219     )  .
     5220     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     5221     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     5222     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     5223                               bf_goods.prod-type = bf_doc-line.prod-type and
     5224                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     5225     if bf_trn-doc.fact-date <> ?        then do:
     5226       assign v-tax-date = bf_trn-doc.fact-date.
     5227     end.
     5228     else do:
     5229       assign v-tax-date = ?.
     5230     end.
     5231   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5232   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     5233     (input  bf_goods.gds-code
     5234     ,input  '1':U
     5235     ,input  v-tax-date
     5236     ,input  bf_trn-doc.host-code
     5237     ,input  bf_trn-doc.obj-type
     5238     ,input  bf_trn-doc.obj-code
     5239     ,output v-vat-pc
     5240     ) no-error .
     5241     if error-status :error
     5242     or v-vat-pc = ? then do:
     5243        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     5244     end.
     5245     if bf_goods.gds-type = 'у':U or
     5246        bf_trn-doc.status_ = 'запрос':U then do:
     5247       for each bf_tt-allsum-line
     5248       on error undo, return error return-value
     5249        :
     5250         delete bf_tt-allsum-line.
     5251       end.
     5252       create bf_tt-allsum-line.
     5253       assign
     5254        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     5255       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     5256                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     5257                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     5258                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     5259         assign
     5260           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     5261           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     5262           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     5263           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     5264           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     5265           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     5266           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     5267           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     5268           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     5269           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     5270           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     5271           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     5272           bf_tt-allsum-line.vat-cli-acc          =  ?
     5273           .
     5274       end.
