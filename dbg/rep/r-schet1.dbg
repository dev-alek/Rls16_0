     1420       v-type-rec = substring(v-recipient-code,1,3)
     1421       v-code-rec  = int(substring(v-recipient-code,4,15))
     1422       no-error
     1423     .
     1424     if v-type-rec = ? then v-type-rec = "" .
     1425     if v-code-rec  = ? then v-code-rec  =  0 .
     1426     end procedure.
