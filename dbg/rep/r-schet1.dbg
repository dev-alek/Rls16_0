     6413         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     6414         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     6415                 ) .
     6416   end.
     6417   end.
     6418   procedure Print-prod :
     6419     do on error undo, return error return-value :
     6420       find first buf_clients where buf_clients.obj-type = buf_goods.prod-type and buf_clients.obj-code = buf_goods.prod-code no-lock .
     6421       if prn_NP then do:
     6422         if not printrubl then do:
     6423           display stream out_stream sym1 "Производитель -" @ buf_goods.artic buf_clients.obj-name @ gds_name sym10 with frame val .
     6424           down stream out_stream 1 with frame val .
     6425           underline stream out_stream buf_goods.artic gds_name with frame val .
     6426         end.
     6427         else do:
     6428           display stream out_stream sym1 "Производитель -" @ buf_goods.artic buf_clients.obj-name @ gds_name sym10 with frame rubl .
     6429           down stream out_stream 1 with frame rubl .
     6430           underline stream out_stream buf_goods.artic gds_name with frame rubl .
     6431         end.
     6432       end.
     6433       else do:
     6434         if not printrubl then do:
     6435           display stream out_stream sym1 "Производитель -" @ buf_goods.artic buf_clients.obj-name @ gds_name sym10 with frame val1 .
     6436           down stream out_stream 1 with frame val1 .
     6437           underline stream out_stream buf_goods.artic gds_name with frame val1 .
     6438         end.
     6439         else do:
     6440           display stream out_stream sym1 "Производитель -" @ buf_goods.artic buf_clients.obj-name @ gds_name sym10 with frame rubl1 .
     6441           down stream out_stream 1 with frame rubl1 .
     6442           underline stream out_stream buf_goods.artic gds_name with frame rubl1 .
     6443         end.
     6444       end.
     6445     end.
     6446   end procedure.
     6447   procedure print-grp :
     6448     do on error undo, return error return-value :
