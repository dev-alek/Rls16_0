     1622   procedure torgconf-get-sup-param :
     1623   define input parameter p-obj-type           as character        no-undo.
     1624   define input parameter p-obj-code           as integer          no-undo.
     1625   define input parameter p-curr-code          as integer          no-undo.
     1626       define variable v-host-code    as integer      no-undo.
     1627       define variable v-par-type     as character    no-undo.
     1628   do
     1629   on error undo, return error
     1630   :
     1631       assign
     1632          v-torgconf-sup-host-code = v-host-code
     1633       .
     1634       if v-torgconf-sup-host-code = 0
     1635       then do:
     1636           assign
     1637               v-torgconf-sup-host-name           = "":U
     1638               v-torgconf-sup-host-addres         = "":U
     1639               v-torgconf-sup-host-post-addres    = "":U
     1640               v-torgconf-sup-host-phone          = "":U
     1641               v-torgconf-sup-host-inn            = "":U
     1642               v-torgconf-sup-host-kpp            = "":U
     1643               v-torgconf-sup-host-okpo           = "":U
     1644               v-torgconf-sup-host-egrip-date     = "":U
     1645               v-torgconf-sup-host-egrip-num      = "":U
     1646           .
     1647       end.
     1648       else do:
     1649           run fmtcli-get-client in this-procedure (
     1650                 input 'орг':U
     1651               , input v-torgconf-sup-host-code
     1652           ).
     1653           assign
     1654               v-torgconf-sup-host-name        = v-fmtcli-name
     1655               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     1656               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     1657               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     1658               v-torgconf-sup-host-phone       = v-fmtcli-phone
     1659               v-torgconf-sup-host-inn         = v-fmtcli-inn
     1660               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     1661               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     1662           .
     1663           run gbl/clntat-v.p (
     1664                 input 'орг':U
     1665               , input v-torgconf-sup-host-code
     1666               , input 'egrip-date':U
     1667               , output v-torgconf-sup-host-egrip-date
     1668               , output v-par-type
     1669           ).
     1670           run gbl/clntat-v.p (
     1671                 input 'орг':U
     1672               , input v-torgconf-sup-host-code
     1673               , input 'egrip-num':U
     1674               , output v-torgconf-sup-host-egrip-num
     1675               , output v-par-type
     1676           ).
     1677           run fmtcli-get-bank in this-procedure (
     1678                 input v-host-code
     1679               , input 'орг':U
     1680               , input v-torgconf-sup-host-code
     1681               , input p-curr-code
     1682           ).
     1683       end.
     1684       assign
     1685           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     1686           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     1687           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     1688           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     1689           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     1690           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     1691           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     1692           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     1693       .
     1694       assign
     1695           v-torgconf-sup-obj-type = p-obj-type
     1696           v-torgconf-sup-obj-code = p-obj-code
     1697       .
     1698       if trim(p-obj-type) <> ""
     1699       and p-obj-code <> 0
     1700       then do:
     1701       run fmtcli-get-client in this-procedure (
     1702             input p-obj-type
     1703           , input p-obj-code
     1704       ).
     1705       assign
     1706           v-torgconf-sup-obj-name        = v-fmtcli-name
     1707           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     1708           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     1709           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1710           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     1711           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     1712           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     1713       .
     1714      end.
     1715      end.
     1716   end procedure.
     1717   procedure torgconf-get-cli-param :
     1718   define input parameter p-host-obj-code      as integer          no-undo.
     1719   define input parameter p-obj-type           as character        no-undo.
     1720   define input parameter p-obj-code           as integer          no-undo.
     1721   define input parameter p-curr-code          as integer          no-undo.
     1722       define variable v-host-code    as integer      no-undo.
     1723   do
     1724   on error undo, return error
     1725   :
     1726       assign
     1727           v-torgconf-cli-type = p-obj-type
     1728           v-torgconf-cli-code = p-obj-code
     1729       .
     1730       run fmtcli-get-client in this-procedure (
     1731             input p-obj-type
     1732           , input p-obj-code
     1733       ).
     1734       assign
     1735           v-torgconf-cli-name         = trim( v-fmtcli-name          )
     1736           v-torgconf-cli-engl-name    = trim( v-fmtcli-engl-name          )
     1737           v-torgconf-cli-addres       = trim( v-fmtcli-full-addres   )
     1738           v-torgconf-cli-post-addres  = trim( v-fmtcli-post-addres   )
     1739           v-torgconf-cli-phone        = trim( v-fmtcli-phone         )
     1740           v-torgconf-cli-inn          = trim( v-fmtcli-inn           )
     1741           v-torgconf-cli-kpp          = trim( v-fmtcli-kpp           )
     1742           v-torgconf-cli-okpo         = trim( v-fmtcli-okpo          )
     1743       .
     1744      run fmtcli-get-bank in this-procedure (
     1745             input p-host-obj-code
     1746           , input p-obj-type
     1747           , input p-obj-code
     1748           , input p-curr-code
     1749       ).
     1750       assign
     1751           v-torgconf-cli-schet-exists = v-fmtcli-schet-exists
     1752           v-torgconf-cli-bank-exists  = v-fmtcli-bank-exists
     1753           v-torgconf-cli-bank-r-schet = v-fmtcli-bank-r-schet
     1754           v-torgconf-cli-bank-c-schet = v-fmtcli-bank-c-schet
     1755           v-torgconf-cli-bank-bik     = v-fmtcli-bank-bik
     1756           v-torgconf-cli-bank-name    = v-fmtcli-bank-name
     1757           v-torgconf-cli-bank-addres  = v-fmtcli-bank-addres
     1758           v-torgconf-cli-bank-city    = v-fmtcli-bank-city
     1759       .
     1760   end.
     1761   end procedure.
     1762   procedure torgconf-get-ship-param :
     1763   define input parameter p-host-obj-code      as integer          no-undo.
     1764   define input parameter p-obj-type           as character        no-undo.
     1765   define input parameter p-obj-code           as integer          no-undo.
     1766   define input parameter p-curr-code          as integer          no-undo.
     1767       define variable v-host-code    as integer      no-undo.
     1768   do
     1769   on error undo, return error
     1770   :
     1771       assign
     1772           v-torgconf-ship-type = p-obj-type
     1773           v-torgconf-ship-code = p-obj-code
     1774       .
     1775       if trim(p-obj-type) = ""
     1776       and p-obj-code = 0
     1777       then do:
     1778       assign
     1779           v-torgconf-ship-name         = "":U
     1780           v-torgconf-ship-addres       = "":U
     1781           v-torgconf-ship-post-addres  = "":U
     1782           v-torgconf-ship-phone        = "":U
     1783           v-torgconf-ship-inn          = "":U
     1784           v-torgconf-ship-kpp          = "":U
     1785           v-torgconf-ship-okpo         = "":U
     1786       .
     1787       end.
     1788       else do:
     1789       run fmtcli-get-client in this-procedure (
     1790             input p-obj-type
     1791           , input p-obj-code
     1792       ).
     1793       assign
     1794           v-torgconf-ship-name         = trim( v-fmtcli-name          )
     1795           v-torgconf-ship-engl-name    = trim( v-fmtcli-engl-name          )
     1796           v-torgconf-ship-addres       = trim( v-fmtcli-full-addres   )
     1797           v-torgconf-ship-post-addres  = trim( v-fmtcli-post-addres   )
     1798           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     1799           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     1800           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     1801           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     1802       .
     1803       end.
     1804           run fmtcli-get-bank in this-procedure (
     1805             input p-host-obj-code
     1806           , input p-obj-type
     1807           , input p-obj-code
     1808           , input p-curr-code
     1809       ).
     1810       assign
     1811           v-torgconf-ship-schet-exists = v-fmtcli-schet-exists
     1812           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
     1813           v-torgconf-ship-bank-r-schet = v-fmtcli-bank-r-schet
     1814           v-torgconf-ship-bank-c-schet = v-fmtcli-bank-c-schet
     1815           v-torgconf-ship-bank-bik     = v-fmtcli-bank-bik
     1816           v-torgconf-ship-bank-name    = v-fmtcli-bank-name
     1817           v-torgconf-ship-bank-addres  = v-fmtcli-bank-addres
     1818           v-torgconf-ship-bank-city    = v-fmtcli-bank-city
     1819       .
     1820   end.
     1821   end procedure.
     1822   procedure torgconf-get-holdfirm-code :
     1823   define input parameter p-obj-type   as character        no-undo.
     1824   define input parameter p-obj-code   as integer          no-undo.
     1825   define output parameter p-firm-code as integer          no-undo.
     1826       define variable v-firm-code-str     as character    no-undo.
     1827       define variable v-par-type          as character    no-undo.
     1828       define buffer buf_clients       for ub.clients.
     1829   do
     1830   for buf_clients
     1831   on error undo, return error
     1832   :
     1833       run gbl/clntat-v.p (
     1834             input p-obj-type
     1835           , input p-obj-code
     1836           , input 'holdfirm-code':U
     1837           , output v-firm-code-str
     1838           , output v-par-type
     1839       ).
     1840       assign
     1841           p-firm-code = integer( v-firm-code-str )
     1842       no-error.
     1843       if error-status :error
     1844       then do:
     1845           message
     1846               "Неверно задан код фирмы для печати накладных."
     1847           view-as alert-box warning.
     1848           assign
     1849               p-firm-code = 0
     1850           .
     1851       end.
     1852       else do:
     1853           find first buf_clients no-lock
     1854                where buf_clients.obj-type = 'орг':U
     1855                  and buf_clients.obj-code = p-firm-code
     1856           no-error.
     1857           if not available buf_clients
     1858           then do:
     1859               message
     1860                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     1861                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     1862               view-as alert-box warning.
     1863               assign
     1864                   p-firm-code = 0
     1865               .
     1866           end.
     1867       end.
     1868   end.
     1869   end procedure.
     1870   procedure torgconf-get-post-head:
     1871   define input  parameter p-obj-type             as character        no-undo.
     1872   define input  parameter p-obj-code             as integer          no-undo.
     1873   define output parameter p-torgconf-post-head   as character        no-undo.
     1874      define variable v-host-code         as integer      no-undo.
     1875      define buffer buf_sysconf     for ub.sysconf.
     1876        assign
     1877         p-torgconf-post-head  = ""
     1878        .
     1879   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1880   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1881     (input  p-obj-type
     1882     ,input  p-obj-code
     1883     ,output v-host-code
     1884     )  .
     1885      find first buf_sysconf no-lock
     1886      where buf_sysconf.host-code = v-host-code
     1887      no-error.
     1888      if available buf_sysconf
     1889      then do:
     1890         assign
     1891            p-torgconf-post-head = buf_sysconf.head-position
     1892         .
     1893      end.
     1894   end procedure.
     1895   procedure torgconf-get-storekeeper:
     1896   define input  parameter p-wrkr                   as integer          no-undo.
     1897   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     1898   define output parameter p-torgconf-post          as character        no-undo.
     1899      define buffer buf_sysconf     for ub.sysconf.
     1900      define buffer buf_person      for ub.person.
     1901      define buffer buf_shop        for ub.shop .
     1902      define buffer buf_store       for ub.store .
     1903      if v-torgconf-outC = "no_print"
     1904      then do:
     1905         assign p-torgconf-post = ""
     1906                p-torgconf-wrkr-name = ""
     1907                .
     1908      end.
     1909      if v-torgconf-outC = "clad_doc"
     1910      then do:
     1911         run rep/get-psn.p
     1912               (input  p-wrkr
     1913               ,output p-torgconf-wrkr-name
     1914               ) .
     1915         find first buf_person no-lock
     1916         where buf_person.psn-code = p-wrkr
     1917         no-error.
     1918         if available buf_person
     1919         then do:
     1920           p-torgconf-post = buf_person.position.
     1921         end.
     1922         if p-torgconf-post = "?":U then p-torgconf-post = "".
     1923         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1924      end.
     1925      if v-torgconf-outC = "clad_obj"
     1926      then do:
     1927         CASE v-torgconf-self-obj-type:
     1928         WHEN 'маг':U
     1929         THEN DO:
     1930            find first buf_shop no-lock
     1931            where buf_shop.obj-code = v-torgconf-self-obj-code
     1932            .
     1933            assign
     1934               p-torgconf-wrkr-name = buf_shop.store-man
     1935               p-torgconf-post = ""
     1936            .
     1937            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1938         END.
     1939         WHEN 'скл':U
     1940         THEN DO:
     1941            find first buf_store no-lock
     1942            where buf_store.obj-code = v-torgconf-self-obj-code
     1943            .
     1944            assign
     1945               p-torgconf-wrkr-name = buf_store.store-man
     1946               p-torgconf-post = ""
     1947            .
     1948            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1949         END.
     1950         OTHERWISE DO:
     1951            assign
     1952               p-torgconf-post = "":U
     1953               p-torgconf-wrkr-name = "":U
     1954            .
     1955         END.
     1956         END CASE.
     1957      end.
     1958    end procedure.
     1959   procedure torgconf-get-form-header :
     1960   define input parameter p-for-inverse    as logical          no-undo.
     1961   define input parameter p-doc-code       as character        no-undo.
     1962   define input parameter p-print-doc      as logical          no-undo.
     1963   define input parameter p-doc-date       as date             no-undo.
     1964   define input parameter p-fact-date      as date             no-undo.
     1965   define input parameter p-doc-type       as character        no-undo.
     1966   define input parameter p-status_        as character        no-undo.
     1967   define input parameter p-reverse        as logical          no-undo.
     1968   define input parameter p-sf-par         as logical          no-undo.
     1969       define variable v-attr-type         as character    no-undo.
     1970       define variable v-doc-code-standard as logical      no-undo.
     1971       define variable v-doc-date-standard as logical      no-undo.
     1972       define variable v-par-consignee-addres  as character    no-undo.
     1973       define variable v-host-code         as integer      no-undo.
     1974       define variable v-dcode-attr        as character    no-undo.
     1975       define variable v-ddate-attr        as character    no-undo.
     1976       define variable v-doc-date          as character    no-undo.
     1977       define variable v-doc-code          as character    no-undo.
     1978       define variable v-par-type          as character    no-undo.
     1979       define variable v-attr              as character    no-undo.
     1980       define buffer buf_firm          for ub.firm .
     1981       define buffer buf_clients       for ub.clients .
     1982       define buffer buf_sysconf       for ub.sysconf .
     1983       define buffer buf_shop          for ub.shop .
     1984       define buffer buf_store         for ub.store .
     1985       define buffer buf_person        for ub.person .
     1986       define buffer buf_trn-doc       for ub.trn-doc .
     1987       define buffer buf_wth-doc       for ub.wth-doc .
     1988       do
     1989   for buf_firm
     1990     , buf_clients
     1991     , buf_sysconf
     1992     , buf_shop
     1993     , buf_trn-doc
     1994     , buf_person
     1995     , buf_wth-doc
     1996   on error undo, return error
     1997   :
     1998       if p-doc-type = 'при':U
     1999       or p-doc-type = 'возврат':U
     2000       then do:
     2001           assign
     2002               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2003                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2004               v-torgconf-suppi            = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2005                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2006               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ),
     2007                                             v-torgconf-self-host-addres, ( if v-torgconf-self-host-phone = "":U then "":U else ", " ),v-torgconf-self-host-phone )
     2008               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-sup-host-name, ( if v-torgconf-sup-host-addres = "":U then "":U else ", " ),
     2009                                             v-torgconf-sup-host-addres, ( if v-torgconf-sup-host-phone = "":U then "":U else ", " ), v-torgconf-sup-host-phone  )
     2010               v-torgconf-supplier-okpo    = v-torgconf-cli-okpo
     2011               v-torgconf-saler-okpo       = v-torgconf-self-host-okpo
     2012               v-torgconf-consignee-okpo   = v-torgconf-sup-host-okpo
     2013               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-cli-code         )
     2014               v-torgconf-supplier-type    = v-torgconf-cli-type
     2015               v-torgconf-saler-code       = substitute( "&1", v-torgconf-self-host-code   )
     2016               v-torgconf-saler-type       = v-torgconf-self-host-type
     2017               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-sup-host-code   )
     2018               v-torgconf-consignee-type   = v-torgconf-sup-host-type
     2019               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-cli-name         )
     2020               v-torgconf-saler-name       = substitute( "&1", v-torgconf-self-host-name   )
     2021               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-sup-host-name   )
     2022               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-cli-addres       )
     2023               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-self-host-addres )
     2024               v-torgconf-consignee-addr   = substitute( "&1", v-torgconf-sup-host-addres )
     2025               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-cli-inn          )
     2026               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-cli-engl-name          )
     2027               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-self-host-inn    )
     2028               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-sup-host-inn    )
     2029               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-cli-kpp          )
     2030               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-self-host-kpp    )
     2031               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-sup-host-kpp    )
     2032           .
     2033           if v-torgconf-cli-schet-exists = yes
     2034           AND v-form-name                  = "torg12":U
     2035           then do:
     2036               assign
     2037                   v-torgconf-supplier = v-torgconf-supplier
     2038                       + substitute( ", р/с &1 к/с &2"
     2039                                   , v-torgconf-cli-bank-r-schet
     2040                                   , v-torgconf-cli-bank-c-schet
     2041                                   )
     2042                   v-torgconf-suppi = v-torgconf-supplier
     2043                       + substitute( ", р/с &1 к/с &2"
     2044                                   , v-torgconf-cli-bank-r-schet
     2045                                   , v-torgconf-cli-bank-c-schet
     2046                                   )
     2047               .
     2048               if v-torgconf-cli-bank-exists = yes
     2049               then do:
     2050                   assign
     2051                       v-torgconf-supplier = v-torgconf-supplier
     2052                           + substitute( " БИК &1 в &2 &3"
     2053                                       , v-torgconf-cli-bank-bik
     2054                                       , v-torgconf-cli-bank-name
     2055                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2056                                       )
     2057                      v-torgconf-suppi = v-torgconf-supplier
     2058                           + substitute( " БИК &1 в &2 &3"
     2059                                       , v-torgconf-cli-bank-bik
     2060                                       , v-torgconf-cli-bank-name
     2061                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2062                                       )
     2063                   .
     2064               end.
     2065           end.
     2066           if v-torgconf-self-schet-exists = yes
     2067           AND v-form-name                  = "torg12":U
     2068           then do:
     2069               assign
     2070                   v-torgconf-saler = v-torgconf-saler
     2071                       + substitute( ", р/с &1 к/с &2"
     2072                                   , v-torgconf-self-bank-r-schet
     2073                                   , v-torgconf-self-bank-c-schet
     2074                                   )
     2075               .
     2076               if v-torgconf-self-bank-exists = yes
     2077               then do:
     2078                   assign
     2079                       v-torgconf-saler = v-torgconf-saler
     2080                           + substitute( " БИК &1 в &2 &3"
     2081                                       , v-torgconf-self-bank-bik
     2082                                       , v-torgconf-self-bank-name
     2083                                       , v-torgconf-self-bank-addres
     2084                                       )
     2085                   .
     2086               end.
     2087           end.
     2088           if v-torgconf-sup-schet-exists = yes
     2089           AND v-form-name                  = "torg12":U
     2090           then do:
     2091               assign
     2092                   v-torgconf-consignee = v-torgconf-consignee
     2093                       + substitute( ", р/с &1 к/с &2"
     2094                                   , v-torgconf-sup-bank-r-schet
     2095                                   , v-torgconf-sup-bank-c-schet
     2096                                   )
     2097               .
     2098             if v-torgconf-sup-bank-exists = yes
     2099              then do:
     2100                assign
     2101                   v-torgconf-consignee = v-torgconf-consignee
     2102                           + substitute( " БИК &1 в &2 &3"
     2103                                       , v-torgconf-sup-bank-bik
     2104                                       , v-torgconf-sup-bank-name
     2105                                       , v-torgconf-sup-bank-addres
     2106                                       )
     2107                   .
     2108               end.
     2109           end.
     2110      if v-torgconf-outares = yes  AND v-form-name  = "torg12":U
     2111      then do:
     2112          assign
     2113            v-torgconf-supplier = substitute(  "&1&2&3 &4 &5&6"
