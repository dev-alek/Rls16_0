     5467     (input  bf_trn-doc.obj-type
     5468     ,input  bf_trn-doc.obj-code
     5469     ,input  varb-code
     5470     ,input  0
     5471     ,input  bf_trn-doc.fact-order
     5472     ,output vardoc-num
     5473     ,output varprice-sale
     5474     ,output varroad-tax
     5475     ,output varexcise
     5476     )  .
     5477             if varprice-sale = ?
     5478             then do:
     5479               assign
     5480                 varprice-sale = 0
     5481                 varroad-tax   = 0
     5482                 varexcise     = 0
     5483               .
     5484             end.
     5485             assign
     5486               varlastcur-base     = varprice-sale
     5487               varlastcur-road-tax = varroad-tax
     5488               varlastcur-excise   = varexcise
     5489               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     5490               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     5491               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     5492               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     5493             .
     5494         end.
     5495       end.
     5496       if varcur-fact-qnty = 0 then do:
     5497         assign
     5498           varcur-base      = varlastcur-base
     5499           varcur-road-tax  = varlastcur-road-tax
     5500           varcur-excise    = varlastcur-excise
     5501         .
     5502       end.
     5503       else do:
     5504         assign
     5505           varcur-base      = varcur-base      / varcur-fact-qnty
     5506           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     5507           varcur-excise    = varcur-excise    / varcur-fact-qnty
     5508         .
     5509       end.
     5510       if varcur-vat-pc = ?
     5511       then do:
     5512         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     5513       end.
     5514       if varcur-slt-pc = ?
