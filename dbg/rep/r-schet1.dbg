     5750   end.
     5751   end procedure.
     5752   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5753   DEFINE temp-table temp-nalog no-undo
     5754     field   slt-prc          as  decimal
     5755     field   vat-prc          as  decimal
     5756     field   slt-sum          as  decimal
     5757     field   vat-sum          as  decimal
