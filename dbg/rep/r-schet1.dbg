     1411         "Атрибут: " 'Recipient':U skip
     1412         "Значение: " v-recipient skip
     1413         trim( error-status :get-message (1) ) skip
     1414         return-value skip
     1415         view-as alert-box error.
     1416       undo, return error return-value.
     1417       end.
