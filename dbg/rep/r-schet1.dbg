     1393   procedure torgconf-get-recepient-param :
     1394   define input parameter torgconfdoc-code   as character                  no-undo.
     1395   define output parameter v-code-rec        as integer                    no-undo .
     1396   define output parameter v-type-rec        as character                  no-undo initial 'C':U.
     1397   define output parameter v-codefirm-rec    as integer                    no-undo .
     1398   define output parameter v-curcode-rec     as integer                    no-undo .
     1399        define variable  v-recipient-code  as character                  no-undo .
     1400        define variable  v-recipient       like ub.doc-attr.attr-value   no-undo.
     1401        define variable  v-trdcattr-type   as character                  no-undo initial 'C':U.
     1402   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input torgconfdoc-code ,
     1403                           input 'Recipient':U ,
     1404                          output v-recipient-code ,
     1405                          output v-trdcattr-type ) no-error .
     1406       if error-status :error then do:
     1407        message
     1408         vss-workfile vss-revision vss-description skip
     1409         "Ошибка при вызове процедуры tdat-val":U skip
