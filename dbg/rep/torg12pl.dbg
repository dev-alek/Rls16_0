     5735   procedure thbjattr_code :
     5736      define input  parameter p-upper-code     as character no-undo .
     5737      define input  parameter p-code           as character no-undo .
     5738      define output parameter p-label          as character no-undo .
     5739      define output parameter p-user-can-edit  as logical   no-undo .
     5740      define output parameter p-output-display as logical   no-undo .
     5741      define output parameter p-other          as character no-undo .
     5742      define output parameter p-prop-list      as character no-undo .
     5743      define output parameter p-prop-type-list as character no-undo .
     5744      define output parameter p-prop-label-list as character no-undo .
     5745      define output parameter p-global          as logical no-undo .
     5746      define output parameter p-host           as logical no-undo .
     5747      define output parameter p-shop           as logical no-undo .
     5748      define output parameter p-store          as logical no-undo .
     5749      define output parameter p-db             as logical no-undo .
     5750      define variable p-region as logical no-undo.
     5751      run thbjattr_code_reg in this-procedure (
     5752                                               p-upper-code,
     5753                                               p-code,
     5754                                               output p-label,
     5755                                               output p-user-can-edit,
     5756                                               output p-output-display,
     5757                                               output p-other,
     5758                                               output p-prop-list,
     5759                                               output p-prop-type-list,
     5760                                               output p-prop-label-list,
     5761                                               output p-global,
     5762                                               output p-host,
     5763                                               output p-shop,
     5764                                               output p-store,
     5765                                               output p-db,
     5766                                               output p-region
     5767                                               ).
     5768   end procedure.
     5769   procedure thbjattr_code_reg :
     5770   define input  parameter p-upper-code     as character no-undo .
     5771   define input  parameter p-code           as character no-undo .
     5772   define output parameter p-label          as character no-undo .
     5773   define output parameter p-user-can-edit  as logical   no-undo .
     5774   define output parameter p-output-display as logical   no-undo .
     5775   define output parameter p-other          as character no-undo .
     5776   define output parameter p-prop-list      as character no-undo .
     5777   define output parameter p-prop-type-list as character no-undo .
     5778   define output parameter p-prop-label-list as character no-undo .
     5779   define output parameter p-global          as logical no-undo .
     5780   define output parameter p-host           as logical no-undo .
     5781   define output parameter p-shop           as logical no-undo .
     5782   define output parameter p-store          as logical no-undo .
     5783   define output parameter p-db             as logical no-undo .
     5784   define output parameter p-region         as logical no-undo .
     5785   do
     5786   on error undo, return error return-value
     5787   :
     5788       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
     5789       (input  p-upper-code
     5790       ,input  p-code
     5791       ,output p-label
     5792       ,output p-user-can-edit
     5793       ,output p-output-display
     5794       ,output p-other
     5795       ,output p-prop-list
     5796       ,output p-prop-type-list
     5797       ,output p-prop-label-list
     5798       ,output p-global
     5799       ,output p-host
     5800       ,output p-shop
     5801       ,output p-store
     5802       ,output p-db
     5803       ,output p-region
     5804       ) no-error .
     5805     if error-status :error
     5806     then do:
     5807       undo, return error substitute( "&1. &2&3&4", vss-include-info28, return-value, chr(10), error-status :get-message (1)).
     5808     end.
     5809   end.
     5810   end procedure.
