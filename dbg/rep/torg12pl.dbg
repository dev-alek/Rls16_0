     5159   end procedure.
     5160   procedure clcprtsl_calc-line :
     5161   define input  parameter parrec-line as recid no-undo.
     5162   define variable v-tax-date         as   date                     no-undo.
     5163   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     5164   define variable varr-b             as   character                no-undo.
     5165   define variable varr-btype         as   character                no-undo.
     5166   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     5167   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     5168   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     5169   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     5170   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     5171   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     5172   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     5173   define variable varb-code          like ub.bar-code.b-code       no-undo.
     5174   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     5175   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     5176   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     5177   define variable varexcise          like ub.price-list.excise     no-undo.
     5178   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     5179   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     5180   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     5181   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     5182   define variable v-varsum           as decimal                  no-undo.
     5183   define variable varprice-salef as decimal   no-undo .
     5184   define buffer bf_trn-doc             for ub.trn-doc.
     5185   define buffer bf_doc-line            for ub.doc-line.
     5186   define buffer bf_gds-dtl             for ub.gds-dtl.
     5187   define buffer bf_goods               for ub.goods.
     5188   define buffer bf_parts               for ub.parts.
     5189   define buffer bf_sysconf             for ub.sysconf.
     5190   define buffer bf_tt-allsum-line      for tt-allsum-line.
     5191   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     5192   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     5193   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     5194   define buffer buf_parts        for ub.parts.
     5195   v-calcbypart = no.
     5196   do on error undo, return error return-value :
     5197   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     5198   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     5199     (output varr-b
     5200     )  .
     5201     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     5202     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     5203     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     5204                               bf_goods.prod-type = bf_doc-line.prod-type and
     5205                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     5206     if bf_trn-doc.fact-date <> ?        then do:
     5207       assign v-tax-date = bf_trn-doc.fact-date.
     5208     end.
     5209     else do:
     5210       assign v-tax-date = ?.
     5211     end.
     5212   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5213   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     5214     (input  bf_goods.gds-code
     5215     ,input  '1':U
     5216     ,input  v-tax-date
     5217     ,input  bf_trn-doc.host-code
     5218     ,input  bf_trn-doc.obj-type
     5219     ,input  bf_trn-doc.obj-code
     5220     ,output v-vat-pc
     5221     ) no-error .
     5222     if error-status :error
     5223     or v-vat-pc = ? then do:
     5224        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     5225     end.
     5226     if bf_goods.gds-type = 'у':U or
     5227        bf_trn-doc.status_ = 'запрос':U then do:
     5228       for each bf_tt-allsum-line
     5229       on error undo, return error return-value
     5230        :
     5231         delete bf_tt-allsum-line.
     5232       end.
     5233       create bf_tt-allsum-line.
     5234       assign
     5235        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     5236       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     5237                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     5238                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     5239                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     5240         assign
     5241           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     5242           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     5243           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     5244           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     5245           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     5246           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     5247           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     5248           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     5249           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     5250           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     5251           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     5252           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     5253           bf_tt-allsum-line.vat-cli-acc          =  ?
     5254           .
     5255       end.
