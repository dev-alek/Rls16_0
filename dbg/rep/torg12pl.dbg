     6650           skip space(10)
     6651               "Возврат товара поставщику"             format "X(120)"
     6652       .
     6653       if v-torgconf-outt12 = yes
     6654       then do:
     6655           form with frame f-doc-m .
     6656           down stream out-stream 1 with frame f-doc-m .
     6657       end.
     6658       else do:
     6659           form with frame f-doc .
     6660           down stream out-stream 1 with frame f-doc .
     6661       end.
     6662       run fill-temp_place_parts in this-procedure (
     6663             input buf_trn-doc.doc-code
     6664           , input buf_trn-doc.obj-type
     6665           , input buf_trn-doc.obj-code
     6666       ).
     6667       run fill-temp_locations in this-procedure .
     6668       if CostPrice = yes
     6669       then do:
     6670           run fill-temp-parts-cost in this-procedure (
     6671                 input v-rb-is-base
     6672               , input buf_trn-doc.doc-code
     6673               , input buf_trn-doc.obj-type
     6674               , input buf_trn-doc.obj-code
     6675           ).
     6676       end.
     6677       else do:
     6678           run fill-temp-parts-doc in this-procedure (
     6679                 input v-rb-is-base
     6680               , input buf_trn-doc.doc-code
     6681               , input buf_trn-doc.obj-type
     6682               , input buf_trn-doc.obj-code
     6683           ).
     6684       end.
     6685       for each temp_locations
     6686       break by temp_locations.loc1
     6687             by temp_locations.loc2
     6688             by temp_locations.loc3
     6689             by temp_locations.loc4
     6690       on error undo, return error
     6691       :
     6692           if first-of( temp_locations.loc4 )
     6693           then do:
     6694               run print-location in this-procedure (
     6695                     input substitute( "Складское место: &1 &2. &3 &4 &5 &6"
     6696                                       , temp_locations.pl-code
     6697                                       , temp_locations.pl-name
     6698                                       , temp_locations.loc1
     6699                                       , temp_locations.loc2
     6700                                       , temp_locations.loc3
     6701                                       , temp_locations.loc4
     6702                     )
     6703                   , input v-single-line
     6704               ).
     6705           end.
     6706           run print-location-lines in this-procedure (
     6707                 input temp_locations.loc1
     6708               , input temp_locations.loc2
     6709               , input temp_locations.loc3
     6710               , input temp_locations.loc4
     6711               , input v-itog-qnty-all
     6712               , input v-itog-sum-no-VAT
     6713               , input v-itog-sum-vat
     6714               , input v-itog-sum-all
     6715               , output v-itog-qnty-all
     6716               , output v-itog-sum-no-VAT
     6717               , output v-itog-sum-vat
     6718               , output v-itog-sum-all
     6719           ) no-error.
     6720           if error-status :error
     6721           then do:
     6722               message
     6723                        vss-workfile vss-revision vss-description
     6724                   skip(1)
     6725                   skip "Ошибка печати строки товара."
     6726                   skip return-value
     6727                   skip trim(error-status :get-message(1))
     6728                        trim(error-status :get-message(2))
     6729                        trim(error-status :get-message(3))
     6730               view-as alert-box error.
     6731               undo, return error .
     6732           end.
     6733       end.
     6734       if line-counter( out-stream ) + 20 > page-size( out-stream )
     6735       then do:
     6736           run print-sub-itog in this-procedure (
     6737                 input v-itog-qnty-all
     6738               , input v-itog-sum-no-VAT
     6739               , input v-itog-sum-vat
     6740               , input v-itog-sum-all
     6741               , input v-single-line
     6742           ).
     6743           page stream out-stream .
     6744           hide stream out-stream frame BottomFrame .
     6745       end.
     6746       else do:
     6747           page stream out-stream .
     6748           hide stream out-stream frame BottomFrame .
     6749           run print-sub-itog in this-procedure (
     6750                 input v-itog-qnty-all
     6751               , input v-itog-sum-no-VAT
     6752               , input v-itog-sum-vat
     6753               , input v-itog-sum-all
     6754               , input v-single-line
     6755           ).
     6756       end.
     6757       run print-footer in this-procedure (
     6758             input buf_trn-doc.doc-code
     6759           , input v-itog-qnty-all
     6760           , input v-itog-sum-no-VAT
     6761           , input v-itog-sum-vat
     6762           , input v-itog-sum-all
     6763       ).
     6764   if session :set-wait-state( "" ) then.
     6765       output stream out-stream close.
     6766   if g#quest-print = false
     6767   then do:
     6768     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     6769                                         7, (if 8 >= 8 then 2 else 0), 0, 0,
     6770                                         OUTPUT g#log ).
     6771   end.
     6772   else do:
     6773     os-command silent
     6774       value( "COPY /b " +
     6775         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     6776         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     6777         string( session:temp-directory) +  "$" + string( g#report-num )
     6778                 ) .
     6779     os-command silent
     6780       value( "COPY /b " +
     6781         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     6782         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     6783         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     6784                 ) .
     6785   end.
     6786   end.
     6787   procedure fill-temp_place_parts :
     6788   define input parameter p-doc-code           as character        no-undo.
     6789   define input parameter p-obj-type           as character        no-undo.
     6790   define input parameter p-obj-code           as integer          no-undo.
     6791       define variable v-parts-counter     as integer    no-undo.
     6792       define buffer buf_parts             for parts.
     6793       define buffer buf_goods             for goods.
     6794       define buffer buf_place             for place.
     6795       define buffer buf_temp_place_parts  for temp_place_parts.
     6796   do
     6797   for buf_parts
     6798     , buf_goods
     6799     , buf_place
     6800     , buf_temp_place_parts
     6801   on error undo, return error
     6802   :
     6803       assign
     6804           v-parts-counter = 0
     6805       .
     6806       for each buf_parts
     6807          where buf_parts.out-code     = p-doc-code
     6808            and buf_parts.obj-type     = p-obj-type
     6809            and buf_parts.obj-code     = p-obj-code
     6810       :
     6811           assign
     6812               v-parts-counter = v-parts-counter + 1
     6813           .
     6814           find first buf_goods no-lock
     6815                where buf_goods.artic      = buf_parts.artic
     6816                  and buf_goods.prod-type  = buf_parts.prod-type
     6817                  and buf_goods.prod-code  = buf_parts.prod-code
     6818           .
     6819           create buf_temp_place_parts.
     6820           assign
     6821               buf_temp_place_parts.plp-key        = v-parts-counter
     6822               buf_temp_place_parts.gds-code       = buf_goods.gds-code
     6823               buf_temp_place_parts.part-code      = buf_parts.part-code
     6824               buf_temp_place_parts.artic          = buf_parts.artic
     6825               buf_temp_place_parts.prod-type      = buf_parts.prod-type
     6826               buf_temp_place_parts.prod-code      = buf_parts.prod-code
     6827               buf_temp_place_parts.in-code        = buf_parts.in-code
     6828               buf_temp_place_parts.out-code       = buf_parts.out-code
     6829               buf_temp_place_parts.gds-name       = (if rep-artic then (string(buf_parts.artic,"x(16)") +  " ") else "")  + buf_goods.gds-name
     6830               buf_temp_place_parts.unit-base      = buf_goods.unit-base
     6831               buf_temp_place_parts.okei           = "":U
     6832               buf_temp_place_parts.pack-type      = "":U
     6833               buf_temp_place_parts.qnty-opl       = ?
     6834               buf_temp_place_parts.qnty-pl        = ?
     6835               buf_temp_place_parts.mass           = ?
     6836               buf_temp_place_parts.pl-code        = buf_parts.pl-code
     6837           .
     6838           find first buf_place no-lock
     6839                where buf_place.obj-type = p-obj-type
     6840                  and buf_place.obj-code = p-obj-code
     6841                  and buf_place.pl-code  = buf_parts.pl-code
     6842           no-error.
     6843           if available buf_place
     6844           then do:
     6845               assign
     6846                   buf_temp_place_parts.pl-name = buf_place.pl-name
     6847                   buf_temp_place_parts.loc1    = buf_place.loc1
     6848                   buf_temp_place_parts.loc2    = buf_place.loc2
     6849                   buf_temp_place_parts.loc3    = buf_place.loc3
     6850                   buf_temp_place_parts.loc4    = buf_place.loc4
     6851               .
     6852           end.
     6853       end.
     6854   end.
     6855   end procedure.
     6856   procedure fill-temp-parts-doc :
     6857   define input parameter p-rb-is-base         as logical          no-undo.
     6858   define input parameter p-doc-code           as character        no-undo.
     6859   define input parameter p-obj-type           as character        no-undo.
     6860   define input parameter p-obj-code           as integer          no-undo.
     6861       define buffer buf_trn-doc           for trn-doc.
     6862       define buffer buf_doc-line          for doc-line.
     6863       define buffer buf_parts             for parts.
     6864       define buffer buf_temp_place_parts  for temp_place_parts.
     6865   do
     6866   for buf_trn-doc
     6867     , buf_doc-line
     6868     , buf_parts
     6869     , buf_temp_place_parts
     6870   on error undo, return error
     6871   :
     6872       find first buf_trn-doc no-lock
     6873            where buf_trn-doc.doc-code = p-doc-code
     6874       .
     6875       for each buf_temp_place_parts
     6876       break by buf_temp_place_parts.gds-code
     6877             by buf_temp_place_parts.loc1
     6878             by buf_temp_place_parts.loc2
     6879             by buf_temp_place_parts.loc3
     6880             by buf_temp_place_parts.loc4
     6881       on error undo, return error
     6882       :
     6883           find first buf_parts no-lock
     6884                where buf_parts.obj-type   = p-obj-type
     6885                  and buf_parts.obj-code   = p-obj-code
     6886                  and buf_parts.artic      = buf_temp_place_parts.artic
     6887                  and buf_parts.prod-type  = buf_temp_place_parts.prod-type
     6888                  and buf_parts.prod-code  = buf_temp_place_parts.prod-code
     6889                  and buf_parts.in-code    = buf_temp_place_parts.in-code
     6890                  and buf_parts.out-code   = buf_temp_place_parts.out-code
     6891                  and buf_parts.part-code  = buf_temp_place_parts.part-code
     6892           .
     6893           create tt-clcparts.
     6894           buffer-copy buf_parts to tt-clcparts.
     6895           if last-of( buf_temp_place_parts.loc4 )
     6896           then do:
     6897               find first buf_doc-line no-lock
     6898                    where buf_doc-line.doc-code    = p-doc-code
     6899                      and buf_doc-line.artic       = buf_temp_place_parts.artic
     6900                      and buf_doc-line.prod-type   = buf_temp_place_parts.prod-type
     6901                      and buf_doc-line.prod-code   = buf_temp_place_parts.prod-code
     6902               .
     6903               run clcprtsl_calc-ttable in this-procedure (
     6904                     input yes
     6905                   , input no
     6906                   , input buf_doc-line.road-tax
     6907                   , input buf_doc-line.excise
     6908                   , input buf_doc-line.vat-pc
     6909                   , input buf_doc-line.cons-vat-pc
     6910                   , input buf_doc-line.slt-pc
     6911                   , input buf_trn-doc.base-rate
     6912                   , input buf_trn-doc.base-scale
     6913                   , input ( if p-rb-is-base = yes then "base":U else "rubl":U )
     6914                   , input 0
     6915                   , input 0
     6916                   , input 0
     6917                   , input 0
     6918                   , input 0
     6919                   , input 0
     6920               ) no-error.
     6921               find first tt-allsum-line
     6922                       where tt-allsum-line.sum-type = 'основная_сумма':U
     6923               .
     6924               create temp_place_parts-sum.
     6925               assign
     6926                   temp_place_parts-sum.gds-code     = buf_temp_place_parts.gds-code
     6927                   temp_place_parts-sum.part-code    = buf_temp_place_parts.part-code
     6928                   temp_place_parts-sum.pl-code      = buf_temp_place_parts.pl-code
     6929                   temp_place_parts-sum.qnty-all     = tt-allsum-line.fact-qnty
     6930                   temp_place_parts-sum.loc1         = buf_temp_place_parts.loc1
     6931                   temp_place_parts-sum.loc2         = buf_temp_place_parts.loc2
     6932                   temp_place_parts-sum.loc3         = buf_temp_place_parts.loc3
     6933                   temp_place_parts-sum.loc4         = buf_temp_place_parts.loc4
     6934               .
     6935               if PrintRubl = yes
     6936               then do:
     6937                   assign
     6938                       temp_place_parts-sum.sum-no-VAT   = tt-allsum-line.sum-dsc-rubl-doc - tt-allsum-line.vat-rubl-doc - tt-allsum-line.slt-rubl-doc
     6939                       temp_place_parts-sum.price-no-VAT = temp_place_parts-sum.sum-no-VAT / tt-allsum-line.fact-qnty
     6940                       temp_place_parts-sum.sum-vat      = tt-allsum-line.vat-rubl-doc
     6941                       temp_place_parts-sum.sum-all      = tt-allsum-line.sum-dsc-rubl-doc
     6942                       temp_place_parts-sum.sum-slt      = tt-allsum-line.slt-rubl-doc
     6943                       temp_place_parts-sum.vat-pc       = temp_place_parts-sum.sum-vat / temp_place_parts-sum.sum-no-VAT * 100
     6944                       temp_place_parts-sum.price-all    = temp_place_parts-sum.sum-all / tt-allsum-line.fact-qnty
     6945                   .
     6946               end.
     6947               else do:
     6948                   assign
     6949                       temp_place_parts-sum.sum-no-VAT   = tt-allsum-line.sum-dsc-base-doc - tt-allsum-line.vat-base-doc - tt-allsum-line.slt-base-doc
     6950                       temp_place_parts-sum.price-no-VAT = temp_place_parts-sum.sum-no-VAT / tt-allsum-line.fact-qnty
     6951                       temp_place_parts-sum.sum-vat      = tt-allsum-line.vat-base-doc
     6952                       temp_place_parts-sum.sum-all      = tt-allsum-line.sum-dsc-base-doc
     6953                       temp_place_parts-sum.sum-slt      = tt-allsum-line.slt-base-doc
     6954                       temp_place_parts-sum.vat-pc       = temp_place_parts-sum.sum-vat / temp_place_parts-sum.sum-no-VAT * 100
     6955                       temp_place_parts-sum.price-all    = temp_place_parts-sum.sum-all / tt-allsum-line.fact-qnty
     6956                   .
     6957               end.
     6958               for each tt-clcparts
     6959               on error undo, return error
     6960               :
     6961                   delete tt-clcparts.
     6962               end.
     6963           end.
     6964       end.
     6965   end.
     6966   end procedure.
     6967   procedure fill-temp-parts-cost :
     6968   define input parameter p-rb-is-base         as logical          no-undo.
     6969   define input parameter p-doc-code           as character        no-undo.
     6970   define input parameter p-obj-type           as character        no-undo.
     6971   define input parameter p-obj-code           as integer          no-undo.
     6972       define buffer buf_parts             for parts.
     6973       define buffer buf_goods             for goods.
     6974       define buffer buf_place             for place.
     6975       define buffer buf_temp_place_parts  for temp_place_parts.
     6976   do
     6977   for buf_parts
     6978     , buf_goods
     6979     , buf_place
     6980     , buf_temp_place_parts
     6981   on error undo, return error
     6982   :
     6983       for each buf_temp_place_parts
     6984       on error undo, return error
     6985       :
     6986           find first buf_parts no-lock
     6987                where buf_parts.obj-type   = p-obj-type
     6988                  and buf_parts.obj-code   = p-obj-code
     6989                  and buf_parts.artic      = buf_temp_place_parts.artic
     6990                  and buf_parts.prod-type  = buf_temp_place_parts.prod-type
     6991                  and buf_parts.prod-code  = buf_temp_place_parts.prod-code
     6992                  and buf_parts.in-code    = buf_temp_place_parts.in-code
     6993                  and buf_parts.out-code   = buf_temp_place_parts.out-code
     6994                  and buf_parts.part-code  = buf_temp_place_parts.part-code
     6995           .
     6996           for each tt-clcparts
     6997           :
     6998               delete tt-clcparts.
     6999           end.
     7000           create tt-clcparts.
     7001           buffer-copy buf_parts to tt-clcparts.
     7002           run clcprtsl_calc-parts in this-procedure (
     7003                 input recid( tt-clcparts )
     7004               , input no
     7005               , input no
     7006               , input 0
     7007               , input 0
     7008               , input 0
     7009               , input 0
     7010               , input 0
     7011               , input 0
     7012               , input 0
     7013               , input ( if p-rb-is-base = yes then "base":U else "rubl":U )
     7014               , input 0
     7015               , input 0
     7016               , input 0
     7017               , input 0
     7018               , input 0
     7019               , input 0
     7020           ) no-error.
     7021           find first tt-allsum
     7022                where tt-allsum.sum-type = 'основная_сумма':U
     7023           .
     7024           create temp_place_parts-sum.
     7025           assign
     7026               temp_place_parts-sum.gds-code     = buf_temp_place_parts.gds-code
     7027               temp_place_parts-sum.part-code    = buf_temp_place_parts.part-code
     7028               temp_place_parts-sum.pl-code      = buf_temp_place_parts.pl-code
     7029               temp_place_parts-sum.qnty-all     = tt-allsum.fact-qnty
     7030               temp_place_parts-sum.loc1         = buf_temp_place_parts.loc1
     7031               temp_place_parts-sum.loc2         = buf_temp_place_parts.loc2
     7032               temp_place_parts-sum.loc3         = buf_temp_place_parts.loc3
     7033               temp_place_parts-sum.loc4         = buf_temp_place_parts.loc4
     7034           .
     7035           if PrintRubl = yes
     7036           then do:
     7037               assign
     7038                   temp_place_parts-sum.sum-no-VAT   = tt-allsum.sum-dsc-rubl-acc - tt-allsum.vat-rubl-acc - tt-allsum.slt-rubl-acc
     7039                   temp_place_parts-sum.price-no-VAT = temp_place_parts-sum.sum-no-VAT / tt-allsum.fact-qnty
     7040                   temp_place_parts-sum.sum-vat      = tt-allsum.vat-rubl-acc
     7041                   temp_place_parts-sum.sum-all      = tt-allsum.sum-dsc-rubl-acc
     7042                   temp_place_parts-sum.sum-slt      = tt-allsum.slt-rubl-acc
     7043                   temp_place_parts-sum.vat-pc       = temp_place_parts-sum.sum-vat / temp_place_parts-sum.sum-no-VAT * 100
     7044                   temp_place_parts-sum.price-all    = temp_place_parts-sum.sum-all / tt-allsum.fact-qnty
     7045               .
     7046           end.
     7047           else do:
     7048               assign
     7049                   temp_place_parts-sum.sum-no-VAT   = tt-allsum.sum-dsc-base-acc - tt-allsum.vat-base-acc - tt-allsum.slt-base-acc
     7050                   temp_place_parts-sum.price-no-VAT = temp_place_parts-sum.sum-no-VAT / tt-allsum.fact-qnty
     7051                   temp_place_parts-sum.sum-vat      = tt-allsum.vat-base-acc
     7052                   temp_place_parts-sum.sum-all      = tt-allsum.sum-dsc-base-acc
     7053                   temp_place_parts-sum.sum-slt      = tt-allsum.slt-base-acc
     7054                   temp_place_parts-sum.vat-pc       = temp_place_parts-sum.sum-vat / temp_place_parts-sum.sum-no-VAT * 100
     7055                   temp_place_parts-sum.price-all    = temp_place_parts-sum.sum-all / tt-allsum.fact-qnty
     7056               .
     7057           end.
     7058       end.
     7059   end.
     7060   end procedure.
     7061   procedure fill-temp_locations :
     7062       define buffer buf_temp_place_parts      for temp_place_parts.
     7063       define buffer buf_temp_locations        for temp_locations.
     7064   do
     7065   for buf_temp_place_parts
     7066     , buf_temp_locations
     7067   on error undo, return error
     7068   :
     7069       for each buf_temp_place_parts
     7070       break by buf_temp_place_parts.loc1
     7071             by buf_temp_place_parts.loc2
     7072             by buf_temp_place_parts.loc3
     7073             by buf_temp_place_parts.loc4
     7074       on error undo, return error
     7075       :
     7076           if first-of( buf_temp_place_parts.loc4 )
     7077           then do:
     7078               create buf_temp_locations.
     7079               assign
     7080                   buf_temp_locations.loc1     = buf_temp_place_parts.loc1
     7081                   buf_temp_locations.loc2     = buf_temp_place_parts.loc2
     7082                   buf_temp_locations.loc3     = buf_temp_place_parts.loc3
     7083                   buf_temp_locations.loc4     = buf_temp_place_parts.loc4
     7084                   buf_temp_locations.pl-code  = buf_temp_place_parts.pl-code
     7085                   buf_temp_locations.pl-name  = buf_temp_place_parts.pl-name
     7086               .
     7087           end.
     7088       end.
     7089   end.
     7090   end procedure.
     7091   procedure print-location :
     7092   define input parameter p-loc-name       as character        no-undo.
     7093   define input parameter p-single-line    as character        no-undo.
     7094   do
     7095   on error undo, return error
     7096   :
     7097       if p-loc-name = "":U
     7098       then do:
     7099       end.
     7100       else do:
     7101           if v-doc-line-counter <> 0
     7102           then do:
     7103               put stream out-stream
     7104                   skip p-single-line  format "X(198)" at 1
     7105               .
     7106           end.
     7107           put stream out-stream
     7108               skip p-loc-name     format "X(160)"
     7109               skip p-single-line  format "X(198)" at 1
     7110           .
     7111       end.
     7112   end.
     7113   end procedure.
     7114   procedure print-location-lines :
     7115   define input parameter p-loc1                   as character        no-undo.
     7116   define input parameter p-loc2                   as character        no-undo.
     7117   define input parameter p-loc3                   as character        no-undo.
     7118   define input parameter p-loc4                   as character        no-undo.
     7119   define input parameter p-itog-qnty-all          as decimal          no-undo.
     7120   define input parameter p-itog-sum-no-VAT        as decimal          no-undo.
     7121   define input parameter p-itog-sum-vat           as decimal          no-undo.
     7122   define input parameter p-itog-sum-all           as decimal          no-undo.
     7123   define output parameter p-out-itog-qnty-all     as decimal          no-undo.
     7124   define output parameter p-out-itog-sum-no-VAT   as decimal          no-undo.
     7125   define output parameter p-out-itog-sum-vat      as decimal          no-undo.
     7126   define output parameter p-out-itog-sum-all      as decimal          no-undo.
     7127       define buffer buf_temp_place_parts-sum      for temp_place_parts-sum.
     7128       define buffer buf_temp_place_parts          for temp_place_parts.
     7129   do
     7130   for buf_temp_place_parts-sum
     7131     , buf_temp_place_parts
     7132   on error undo, return error
     7133   :
     7134       assign
     7135           p-out-itog-qnty-all   = p-itog-qnty-all
     7136           p-out-itog-sum-no-VAT = p-itog-sum-no-VAT
     7137           p-out-itog-sum-vat    = p-itog-sum-vat
     7138           p-out-itog-sum-all    = p-itog-sum-all
     7139       .
     7140       for each buf_temp_place_parts-sum
     7141          where buf_temp_place_parts-sum.loc1 = p-loc1
     7142            and buf_temp_place_parts-sum.loc2 = p-loc2
     7143            and buf_temp_place_parts-sum.loc3 = p-loc3
     7144            and buf_temp_place_parts-sum.loc4 = p-loc4
     7145       on error undo, return error
     7146       :
     7147           find first buf_temp_place_parts
     7148                where buf_temp_place_parts.gds-code  = buf_temp_place_parts-sum.gds-code
     7149                  and buf_temp_place_parts.part-code = buf_temp_place_parts-sum.part-code
     7150                  and buf_temp_place_parts.pl-code   = buf_temp_place_parts-sum.pl-code
     7151           .
     7152           assign
     7153               v-doc-line-counter = v-doc-line-counter + 1
     7154           .
     7155           if v-torgconf-outt12 = yes
     7156           then do:
     7157               display stream out-stream
     7158                   sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym13 sym14 sym15 sym16
     7159                   v-doc-line-counter
     7160                   buf_temp_place_parts.gds-name           @ v-gds-name
     7161                   buf_temp_place_parts.gds-code           @ v-gds-code
     7162                   buf_temp_place_parts.unit-base          @ v-unit-base
     7163                   buf_temp_place_parts.okei               @ v-okei
     7164                   buf_temp_place_parts.pack-type          @ v-pack-type
     7165                   buf_temp_place_parts.qnty-opl           when buf_temp_place_parts.qnty-opl <> ? @ v-qnty-opl
     7166                   buf_temp_place_parts.qnty-pl            when buf_temp_place_parts.qnty-pl <> ?  @ v-qnty-pl
     7167                   buf_temp_place_parts.mass               when buf_temp_place_parts.mass <> ?     @ v-mass
     7168                   buf_temp_place_parts-sum.qnty-all       @ v-qnty-all
     7169                   buf_temp_place_parts-sum.price-no-VAT   @ v-price-no-VAT
     7170                   buf_temp_place_parts-sum.sum-no-VAT     @ v-sum-no-VAT
     7171                   buf_temp_place_parts-sum.vat-pc         @ v-vat-pc
     7172                   buf_temp_place_parts-sum.sum-vat        @ v-sum-vat
     7173                   buf_temp_place_parts-sum.sum-all        @ v-sum-all
     7174               with frame f-doc-m.
     7175               down stream out-stream 1 with frame f-doc-m .
     7176           end.
     7177           else do:
     7178               display stream out-stream
     7179                   sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym13 sym14 sym15 sym16 sym17 sym18
     7180                   v-doc-line-counter
     7181                   buf_temp_place_parts.gds-name           @ v-gds-name
     7182                   buf_temp_place_parts.gds-code           @ v-gds-code
     7183                   buf_temp_place_parts.unit-base          @ v-unit-base
     7184                   buf_temp_place_parts.okei               @ v-okei
     7185                   buf_temp_place_parts.pack-type          @ v-pack-type
     7186                   buf_temp_place_parts.qnty-opl           when buf_temp_place_parts.qnty-opl <> ? @ v-qnty-opl
     7187                   buf_temp_place_parts.qnty-pl            when buf_temp_place_parts.qnty-pl <> ?  @ v-qnty-pl
     7188                   buf_temp_place_parts.mass               when buf_temp_place_parts.mass <> ?     @ v-mass
     7189                   buf_temp_place_parts-sum.qnty-all       @ v-qnty-all
     7190                   buf_temp_place_parts-sum.price-no-VAT   @ v-price-no-VAT
     7191                   buf_temp_place_parts-sum.sum-no-VAT     @ v-sum-no-VAT
     7192                   buf_temp_place_parts-sum.vat-pc         @ v-vat-pc
     7193                   buf_temp_place_parts-sum.sum-vat        @ v-sum-vat
     7194                   buf_temp_place_parts-sum.sum-all        @ v-sum-all
     7195                   buf_temp_place_parts-sum.sum-slt        @ v-sum-slt
     7196                   buf_temp_place_parts-sum.price-all      @ v-price-all
     7197               with frame f-doc.
     7198               down stream out-stream 1 with frame f-doc .
     7199           end.
     7200           assign
     7201               p-out-itog-qnty-all   = p-out-itog-qnty-all   + buf_temp_place_parts-sum.qnty-all
     7202               p-out-itog-sum-no-VAT = p-out-itog-sum-no-VAT + buf_temp_place_parts-sum.sum-no-VAT
     7203               p-out-itog-sum-vat    = p-out-itog-sum-vat    + buf_temp_place_parts-sum.sum-vat
     7204               p-out-itog-sum-all    = p-out-itog-sum-all    + buf_temp_place_parts-sum.sum-all
     7205           .
     7206       end.
     7207   end.
     7208   end procedure.
     7209   procedure print-footer :
     7210   define input parameter p-doc-code           as character        no-undo.
     7211   define input parameter p-itog-qnty-all      as decimal          no-undo.
     7212   define input parameter p-itog-sum-no-VAT    as decimal          no-undo.
     7213   define input parameter p-itog-sum-vat       as decimal          no-undo.
     7214   define input parameter p-itog-sum-all       as decimal          no-undo.
     7215       define variable v-string-1          as character    no-undo.
     7216       define variable v-string-2          as character    no-undo.
     7217       define variable v-line-counter-text as character    no-undo.
     7218       define buffer buf_clients   for clients.
     7219       define buffer buf_firm      for firm.
     7220       define buffer buf_sysconf   for sysconf.
     7221       define buffer buf_trn-doc   for trn-doc.
     7222   do
     7223   for buf_clients
     7224     , buf_firm
     7225     , buf_sysconf
     7226   on error undo, return error
     7227   :
     7228       find first buf_trn-doc no-lock
     7229            where buf_trn-doc.doc-code = p-doc-code
     7230       .
     7231       if PrintRubl
     7232       then do:
     7233           run rep/wp-rub.p (
     7234                 input p-itog-sum-all
     7235               , output v-string-1
     7236               , output v-string-2
     7237           ).
     7238       end.
     7239       else do:
     7240           run rep/wp.p (
     7241                 input p-mainmenu-handle
     7242               , input p-itog-sum-all
     7243               , output v-string-1
     7244               , output v-string-2
     7245           ).
     7246       end.
     7247       run rep/wp-qnty.p (
     7248             input v-doc-line-counter
     7249           , output v-line-counter-text
     7250       ).
     7251       put stream out-stream
     7252           space(10) "  Всего на сумму:        "
     7253               trim( string( p-itog-sum-all, "->>>,>>>,>>>,>>>,>>9.99") )  format "X(25)"
     7254               " ("
     7255               trim( if PrintRubl then "руб" else "баз.вал" )              format "X(6)"
     7256               ")"
     7257       .
     7258       if v-torgconf-outdisc = no
     7259       then do:
     7260           put stream out-stream
     7261               substitute( "&1 &2 ( &3 )"
     7262                   , ( if ( if PrintRubl then buf_trn-doc.discnt-rubl else buf_trn-doc.tot-calc ) < 0
     7263                            then ", наценка: "
     7264                            else ", скидка: "  )
     7265                   , trim( string( absolute( ( if PrintRubl
     7266                                               then buf_trn-doc.discnt-rubl
     7267                                               else buf_trn-doc.tot-calc ) ), ">>>,>>>,>>>,>>>,>>9.99" ) )
     7268                   , trim( ( if PrintRubl then "руб" else "баз.вал" ) )
     7269                )                                                          format "X(100)"
     7270           .
     7271       end.
     7272       put stream out-stream
     7273           skip space(30)
     7274               substitute( "НДС: &1 ( &2 )"
     7275                           , trim( string( p-itog-sum-vat, "->>>,>>>,>>>,>>>,>>9.99") )
     7276                           , trim( ( if PrintRubl then "руб" else "баз.вал" ) )
     7277               )                                                           format "X(160)"
     7278       .
     7279       define variable v-doc-places    as character    no-undo.
     7280       define variable v-attr-type     as character    no-undo.
     7281   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     7282                           input 'QntyPlace':U ,
     7283                          output v-doc-places ,
     7284                          output v-attr-type )  .
     7285       if v-doc-places = "":U
     7286       then do:
     7287           assign
     7288               v-doc-places = v-underline
     7289           .
     7290       end.
     7291       put stream out-stream
     7292           skip(2)
     7293           space(10) string( "Товарная накладная имеет приложение на " + v-underline ) format "X(125)" skip
     7294           space(10) string( "и содержит " + CAPS( v-line-counter-text ) + " порядковый(ых) номер(ов) записей") format "X(180)" skip
     7295           v-underline format "X(29)" at 151 skip
     7296           string( "Масса груза (нетто) " + v-underline ) format "X(85)" at 60
     7297                   string( "|" + v-underline ) format "X(30)" at 150 "|" skip
     7298           space(10) string( "Всего мест " + v-doc-places ) format "X(45)"
     7299                   string( "Масса груза (брутто) " + v-underline ) format "X(85)" at 60
     7300                   string( "|" + v-underline ) format "X(30)" at 150 "|" skip(1)
     7301           string( "Приложение (паспорта, сертификаты, и т.д.) на " + string( v-underline, "X(42)" ) + " листах" ) format "X(95)" "|" at 97
     7302               string( "По доверенности N " + string( v-underline, "X(39)" ) + " от " + v-underline ) format "X(100)" at 99 skip
     7303           "Всего отпущено на сумму " format "X(95)" "|" at 97 string( "выданной " + v-underline ) format "X(100)" at 99 skip
     7304           space(2) CAPS( v-string-1 ) format "X(93)" "|" at 97 skip
     7305       .
     7306           define variable v-main-boss  as character     no-undo.
     7307           define variable v-main-buh   as character     no-undo.
     7308           find first buf_clients no-lock
     7309                where buf_clients.obj-type = 'орг':U
     7310                  and buf_clients.obj-code = buf_trn-doc.host-code
     7311           .
     7312           find first buf_firm no-lock
     7313                   where buf_firm.firm-code = buf_clients.obj-code
     7314           .
     7315           assign
     7316               v-main-boss = buf_firm.director
     7317               v-main-buh  = buf_firm.gen-acct
     7318           .
     7319           find first buf_sysconf no-lock
     7320                where buf_sysconf.host-code = v-host-code
     7321           .
     7322           assign
     7323               v-main-buh  = buf_sysconf.snr-accnt
     7324           .
     7325           put stream out-stream
     7326               string( "Отпуск разрешил  Ген. директор: ___________________ / " + ( if v-torgconf-outsubs = no then v-main-boss else "" ) ) format "X(93)" "/ |" at 95 skip
     7327               string( "Главный бухгалтер: ________________________________ / " + ( if v-torgconf-outsubs = no then v-main-buh  else "" ) ) format "X(93)" "/ |" at 95 skip
     7328               string( "Отпуск груза произвел кладовщик: " + v-underline  ) format "X(95)" "|" at 97
     7329               "|" at 97 string( "Груз принял " + v-underline ) format "X(100)" at 99 skip
     7330               v-underline format "X(95)" "|" at 97 string( "Груз получил грузополучатель " + v-underline ) format "X(100)" at 99 skip
     7331               "М.П." at 15  "|" at 97 "М.П." at 99 skip
     7332           .
     7333   end.
     7334   end procedure.
     7335   procedure print-sub-itog :
     7336   define input parameter p-itog-qnty-all      as decimal          no-undo.
     7337   define input parameter p-itog-sum-no-VAT    as decimal          no-undo.
     7338   define input parameter p-itog-sum-vat       as decimal          no-undo.
     7339   define input parameter p-itog-sum-all       as decimal          no-undo.
     7340   define input parameter p-single-line        as character        no-undo.
     7341   do
     7342   on error undo, return error
     7343   :
     7344       put stream out-stream
     7345           skip p-single-line  format "X(198)" at 1
     7346       .
     7347       if v-torgconf-outt12 = yes
     7348       then do:
     7349           display stream out-stream
     7350               "Всего по накладной"    @ v-gds-name
     7351               p-itog-qnty-all         @ v-qnty-all
     7352               p-itog-sum-no-VAT       @ v-sum-no-VAT
     7353               p-itog-sum-vat          @ v-sum-VAT
     7354               p-itog-sum-all          @ v-sum-all
     7355           with frame f-doc-m.
     7356           down stream out-stream 1 with frame f-doc-m .
     7357       end.
     7358       else do:
     7359           display stream out-stream
     7360               "Всего по накладной"    @ v-gds-name
     7361               p-itog-qnty-all         @ v-qnty-all
     7362               p-itog-sum-no-VAT       @ v-sum-no-VAT
     7363               p-itog-sum-vat          @ v-sum-VAT
     7364               p-itog-sum-all          @ v-sum-all
     7365           with frame f-doc.
     7366           down stream out-stream 1 with frame f-doc .
     7367       end.
     7368   end.
     7369   end procedure.
