     5519       :
     5520         create buf_tt-clcparts .
     5521         buffer-copy bf_parts to buf_tt-clcparts .
     5522         if v-calcbypart = yes   then do:
     5523   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partbcod in g#library
     5524     (buffer bf_parts
     5525     ,output v-b-pcode
     5526     ) no-error .
     5527   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5528   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     5529     (input  bf_parts.obj-type
     5530     ,input  bf_parts.obj-code
     5531     ,input  v-b-pcode
     5532     ,input  0
     5533     ,input  bf_trn-doc.fact-order
     5534     ,output vardoc-num
     5535     ,output varprice-salef
     5536     ,output varroad-tax
     5537     ,output varexcise
     5538     ) no-error .
     5539             if varprice-sale = ?
     5540             then do:
     5541               assign
     5542                 varprice-salef = 0
     5543                 varroad-tax   = 0
     5544                 varexcise     = 0
     5545               .
     5546             end.
     5547             assign
     5548             part-cur-base  = varprice-salef
     5549             part-cur-road-tax  = varroad-tax
     5550             part-cur-excise = varexcise.
     5551         end.
     5552       end.
     5553       run clcprtsl_calc-ttable in this-procedure
     5554         (input yes,
     5555          input yes,
     5556          input bf_doc-line.road-tax,
     5557          input bf_doc-line.excise,
     5558          input bf_doc-line.vat-pc,
     5559          input bf_doc-line.cons-vat-pc,
     5560          input bf_doc-line.slt-pc,
     5561          input bf_trn-doc.base-rate,
     5562          input bf_trn-doc.base-scale,
     5563          input varr-b,
     5564          input varcur-base,
     5565          input varcur-road-tax,
     5566          input varcur-excise,
     5567          input varcur-vat-pc,
     5568          input varcur-cons-vat-pc,
     5569          input varcur-slt-pc
     5570          ) no-error.
     5571       if error-status:error then do:
     5572         message
     5573           vss-workfile vss-revision vss-description skip
     5574           "Ошибка при вызове процедуры clcprtsl_calc-ttable." skip
     5575           return-value skip
     5576           trim(error-status :get-message(1))
     5577           trim(error-status :get-message(2))
     5578           trim(error-status :get-message(3))
     5579           trim(error-status :get-message(4))
     5580           trim(error-status :get-message(5)) skip
     5581           view-as alert-box error.
     5582         undo, return error .
     5583       end.
     5584     end.
     5585   end.
     5586   end.
     5587   procedure clcprtsl_calc-ttable :
     5588   define input parameter paris-doc           as   logical                 no-undo.
     5589   define input parameter paris-cur           as   logical                 no-undo.
     5590   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     5591   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     5592   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     5593   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     5594   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     5595   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     5596   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     5597   define input parameter parr-b              as   character               no-undo.
     5598   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     5599   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     5600   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     5601   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     5602   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     5603   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     5604   define buffer bf_tt-allsum      for tt-allsum.
     5605   define buffer bf_tt-clcparts    for tt-clcparts.
     5606   define buffer bf_tt-allsum-line for tt-allsum-line.
     5607   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     5608   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     5609   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     5610   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     5611   define variable varexcise          like ub.price-list.excise     no-undo.
     5612   do on error undo, return error return-value :
     5613   for each bf_tt-allsum-line
     5614   on error undo, return error return-value
     5615    :
     5616     delete bf_tt-allsum-line.
     5617   end.
     5618   for each bf_tt-allsum
     5619   on error undo, return error return-value
     5620   :
     5621     delete bf_tt-allsum.
     5622   end.
     5623   for each bf_tt-clcparts
     5624   on error undo, return error return-value
     5625   :
     5626   if v-calcbypart then do:
     5627             assign
     5628             parcur-base =   bf_tt-clcparts.part-cur-base
     5629             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     5630             parcur-excise =   bf_tt-clcparts.part-cur-excise
     5631             .
     5632   end.
     5633      run clcprtsl_calc-parts in this-procedure (
     5634        input recid(bf_tt-clcparts),
     5635        input paris-doc,
     5636        input paris-cur,
     5637        input parroad-tax,
     5638        input parexcise,
     5639        input parvat-pc,
     5640        input parcons-vat-pc,
     5641        input parslt-pc,
     5642        input parbase-rate,
     5643        input parbase-scale,
     5644        input parr-b,
     5645        input parcur-base,
     5646        input parcur-road-tax,
     5647        input parcur-excise,
     5648        input parcur-vat-pc,
     5649        input parcurcons-vat-pc,
     5650        input parcurslt-pc
     5651        ) no-error.
     5652     if error-status:error then do:
     5653       message
     5654         vss-workfile vss-revision vss-description skip
     5655         vss-include-info14 skip
     5656         "Ошибка при обсчете партии" skip
     5657         "Документ партии " bf_tt-clcparts.out-code skip
     5658         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     5659         return-value skip
     5660         error-status:get-message(1) skip
     5661         error-status:get-message(2) skip
     5662         error-status:get-message(3) skip
     5663         view-as alert-box error .
     5664       undo, return error .
     5665     end.
     5666     for each bf_tt-allsum on error undo, return error return-value :
     5667       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     5668       if not available bf_tt-allsum-line then do:
     5669         create bf_tt-allsum-line.
     5670         assign
     5671           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     5672       end.
