     5448     (input  bf_trn-doc.obj-type
     5449     ,input  bf_trn-doc.obj-code
     5450     ,input  varb-code
     5451     ,input  0
     5452     ,input  bf_trn-doc.fact-order
     5453     ,output vardoc-num
     5454     ,output varprice-sale
     5455     ,output varroad-tax
     5456     ,output varexcise
     5457     )  .
     5458             if varprice-sale = ?
     5459             then do:
     5460               assign
     5461                 varprice-sale = 0
     5462                 varroad-tax   = 0
     5463                 varexcise     = 0
     5464               .
     5465             end.
     5466             assign
     5467               varlastcur-base     = varprice-sale
     5468               varlastcur-road-tax = varroad-tax
     5469               varlastcur-excise   = varexcise
     5470               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     5471               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     5472               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     5473               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     5474             .
     5475         end.
     5476       end.
     5477       if varcur-fact-qnty = 0 then do:
     5478         assign
     5479           varcur-base      = varlastcur-base
     5480           varcur-road-tax  = varlastcur-road-tax
     5481           varcur-excise    = varlastcur-excise
     5482         .
     5483       end.
     5484       else do:
     5485         assign
     5486           varcur-base      = varcur-base      / varcur-fact-qnty
     5487           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     5488           varcur-excise    = varcur-excise    / varcur-fact-qnty
     5489         .
     5490       end.
     5491       if varcur-vat-pc = ?
     5492       then do:
     5493         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     5494       end.
     5495       if varcur-slt-pc = ?
