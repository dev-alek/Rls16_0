     1220               .
     1221           end.
     1222           if lookup( p-form-name, v-outhold  ) <> 0
     1223           then do:
     1224               assign
     1225                   v-torgconf-outhold   = yes
     1226               .
     1227           end.
     1228           if lookup( p-form-name, v-outobj   ) <> 0
     1229           then do:
     1230               assign
     1231                   v-torgconf-outobj    = yes
     1232               .
     1233           end.
     1234           if lookup( p-form-name, v-outsend   ) <> 0
     1235           then do:
     1236               assign
