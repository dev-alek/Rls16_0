     3657   procedure calcitog :
     3658       run aht-ostatok (
     3659           input x-store-code     ,
     3660           input x-store-type     ,
     3661           input x-tog-shift      ,
     3662           input x-date-start - 1 ,
     3663           input date('')         ,
