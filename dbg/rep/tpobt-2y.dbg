     3747   procedure display-b1  :
     3748         if not( not show-negativ-2 and
     3749            ( b1-prih          [1]   = 0 and
     3750              b1-rash          [1]   = 0 and
     3751              b1-kassa         [1]   = 0 and
     3752              b1-inv           [1]   = 0 and
     3753              b1-overturn      [1]   = 0 and
     3754              b1-overturn      [5]   = 0 and
     3755              b1-overturn      [8]   = 0 ) ) then do:
     3756           if  not (not show-negativ  and (
     3757                 b1-prih          [1]   = 0 and
     3758                 b1-rash          [1]   = 0 and
     3759                 b1-kassa         [1]   = 0 and
     3760                 b1-inv           [1]   = 0 and
     3761                 b1-overturn      [1]   = 0 and
     3762                 b1-overturn      [5]   = 0 and
     3763                 b1-ostatok-start [1]   = 0 and
     3764                 b1-ostatok-end   [1]   = 0   )) then do:
     3765                 if sums-only then do:
     3766                     if fr0 = true then do:
     3767                         put stream  outstream  tmp#stroka0 format "x(100)" skip.
     3768                         if Make-Excel then  put   stream ForExcel unformatted string(tmp#stroka0) skip.
     3769                         fr0 = false .
     3770                       end.
     3771                  end.
     3772      if p-tpsy = no  or ( p-tpsy = true and  p-type-tpsy-goods = 2 ) then do:
     3773           run di-qnty in this-procedure ("кол-во"  ,1, s-bar-code, gds-zap-artic, gds-zap-gds-name  ,"","b1":u).
     3774           if xshowcost    then do: run di in this-procedure ("учет." ,2 ,"","", "", "", "b1":u).  end.
     3775           if xshowcrsa    then do: run di in this-procedure ("прод." , 5, "","", "", "", "b1":u).  end.
     3776           if xshowsale    then do: run di in this-procedure ("док." , 8, "","", "", "", "b1":u).  end.
     3777           if vat-cost    then do: run di in this-procedure ( "уч.НДС", 3,"","","","","b1":u ). end.
     3778           if vat-crsa    then do: run di in this-procedure ( "пр.НДС", 6,"","","","","b1":u ).  end.
     3779           if vat-sale    then do: run di in this-procedure ( "дк.НДС", 9,"","","","","b1":u ).  end.
     3780      end.
     3781      if p-tpsy = true  then do:
     3782            if  p-type-tpsy-goods = 3 then
     3783                run di-qnty ("кол-во"  ,11, s-bar-code, gds-zap-artic, gds-zap-gds-name  ,"","b1":u).
     3784            else
     3785               run di-qnty in this-procedure ("кол-во"  ,11, "","", str_svoi, "","b1":u).
     3786           if xshowcost    then do: run di in this-procedure ("учет." ,12 ,"","", "", "", "b1":u).  end.
     3787           if xshowcrsa    then do: run di in this-procedure ("прод." ,15, "","", "", "", "b1":u).  end.
     3788           if xshowsale    then do: run di in this-procedure ("док." , 18, "","", "", "", "b1":u).  end.
     3789           if vat-cost    then do: run di in this-procedure ( "уч.НДС", 13,"","","","","b1":u ). end.
     3790           if vat-crsa    then do: run di in this-procedure ( "пр.НДС", 16,"","","","","b1":u ).  end.
     3791           if vat-sale    then do: run di in this-procedure ( "дк.НДС", 19,"","","","","b1":u ).  end.
     3792      end.
     3793          if not sums-only then run p-line.
     3794    end.
     3795    end.
     3796   end procedure.
