     3844       b1-rash                                            [kk]    = 0
     3845       b1-kassa                                           [kk]    = 0
     3846       b1-inv                                             [kk]    = 0
     3847       b1-overturn                                        [kk]    = 0
     3848       b1-ostatok-end                                     [kk]    = 0
     3849       b1-ostatok-start                                   [kk]    = 0   .
