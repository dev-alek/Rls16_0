     3367                               gds-obj.obj-type = buf_obj-list26.obj-type    and
     3368                               gds-obj.obj-code = buf_obj-list26.obj-code
     3369                               and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     3370                               no-lock ,
     3371           first goods where gds-obj.gds-code  = goods.gds-code
     3372                               no-lock :
     3373               if not can-find(first temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) then do:
     3374                   create temp-gds-list.
     3375                   assign
     3376                     temp-gds-list.prod-code = gds-obj.prod-code
     3377                     temp-gds-list.grp-name  = ""
     3378                     temp-gds-list.gds-code  = gds-obj.gds-code
     3379                     temp-gds-list.artic     = gds-obj.artic
     3380                     temp-gds-list.gds-name  = goods.gds-name
     3381                     .
     3382                     temp-gds-list.grp-name  = n-lavel(input gds-obj.grp-name, input xlavel )
     3383                     .
     3384               end.
     3385           end.
     3386    end.
     3387     for each temp-gds-list no-lock
     3388       , first goods  where goods.gds-code  = temp-gds-list.gds-code no-lock
     3389         break
     3390           by  temp-gds-list.grp-name
     3391           by goods.gds-name :
     3392           str = n-lavel(input goods.grp-name, input xlavel ) no-error .
     3393   find clients where clients.obj-type = goods.prod-type and
     3394                      clients.obj-code = goods.prod-code no-lock .
     3395     assign
     3396         gds-zap-unit-base  = goods.unit-base
     3397         gds-zap-prt-root   = goods.prt-root
