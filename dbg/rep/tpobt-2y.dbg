     4071                   end.
     4072                   assign
     4073                       temp-str = string( "СТАВКА НДС : " + string(var-vat-pc) + "%" )
     4074                       b1-name = temp-str.
     4075                   end.
     4076               if NOT xSumsOnly or (par-3 = "4" Or par-3 = "5" ) THEN DO :
     4077                   fr0 = true .
     4078                   tmp#stroka0 = temp-str.
     4079               End.
     4080             End.
     4081               IF (par-3 = "4"  OR  par-3 = "5")  THEN DO:
     4082                 if par-3 = "4"
     4083                   then Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )          b2-name = gds-zap-grp-name .
     4084                   else Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name )  b2-name = gds-zap-prod-name.
     4085                 if NOT xSumsOnly THEN DO:
     4086                     fr = true .
     4087                 End.
     4088                 break_group1 = false.
     4089               END.
     4090          break_group = false.
     4091       End.
     4092       gds-zap-gds-name = string(old-gds-zap-gds-name,"x(28)") + "|"   + "Консиг".
     4093       run display-line.
     4094       x-type-pr = "s".
     4095       run foreach.
     4096   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     4097     (input  gds-zap-b-code
     4098     ,input  ?
     4099     ,output v-bar-code
     4100     )  .
     4101   s-bar-code = string (v-bar-code,"999999999").
