     4735    end procedure.
     4736   procedure ost-line-body :
     4737   do on error undo, return error return-value :
     4738   define input parameter p-num        as   integer   no-undo .
     4739   define input parameter p-store-type like ub.clients.obj-type no-undo .
     4740   define input parameter p-store-code like ub.clients.obj-code no-undo .
     4741    find last  ub.aht-stk-line where
     4742                           ub.aht-stk-line.gds-code   = gds-zap-b-code
     4743                     and   ub.aht-stk-line.fact-order <= fact-order-1
     4744                     and   ub.aht-stk-line.obj-code   = p-store-code
     4745                     and   ub.aht-stk-line.obj-type   = p-store-type
     4746                     and   ub.aht-stk-line.sum-type   = x-type-pr
     4747                           use-index category no-lock no-error.
     4748           if available ub.aht-stk-line then do:
     4749               if  tprintrubl  then
     4750                     assign
     4751                           ostatok-start[1 + p-num]  = ostatok-start[1 + p-num] +  (if ub.aht-stk-line.sum-type <> "b"
     4752                                                                   then round( ub.aht-stk-line.fact-qnty,3) else 0 )
     4753                           ostatok-start[2 + p-num]  =ostatok-start[2 + p-num] +  round( ub.aht-stk-line.cost-sum-rubl ,2)
     4754                           ostatok-start[3 + p-num]  =ostatok-start[3 + p-num] +  round( ub.aht-stk-line.cost-vat-rubl ,2)
     4755                           ostatok-start[4 + p-num]  =ostatok-start[4 + p-num] +  0
     4756                           ostatok-start[5 + p-num]  =ostatok-start[5 + p-num]  + round( ub.aht-stk-line.crsa-sum-rubl ,2)
     4757                           ostatok-start[6 + p-num]  =ostatok-start[6 + p-num]  + round( ub.aht-stk-line.crsa-vat-rubl ,2)
     4758                           ostatok-start[7 + p-num]  =ostatok-start[7 + p-num]  + round( ub.aht-stk-line.sale-discnt-rubl ,2)
     4759                           ostatok-start[8 + p-num]  =ostatok-start[8 + p-num]  + round( ub.aht-stk-line.crsa-sum-rubl ,2)
     4760                           ostatok-start[9 + p-num]  =ostatok-start[9 + p-num]  + round( ub.aht-stk-line.crsa-vat-rubl ,2)
     4761                           ostatok-start[10 + p-num] =ostatok-start[10 + p-num] + round( ub.aht-stk-line.crsa-slt-rubl ,2)
     4762                           .
     4763                 else
     4764                     assign
     4765                           ostatok-start[1 + p-num]  = ostatok-start[1 + p-num] + (if ub.aht-stk-line.sum-type <> "b"
     4766                                                                      then round( ub.aht-stk-line.fact-qnty,3) else 0 )
     4767                           ostatok-start[2 + p-num]  = ostatok-start[2 + p-num] +  round( ub.aht-stk-line.cost-sum-base ,2)
     4768                           ostatok-start[3 + p-num]  = ostatok-start[3 + p-num] +  round( ub.aht-stk-line.cost-vat-base ,2)
     4769                           ostatok-start[4 + p-num]  = ostatok-start[4 + p-num] +  0
     4770                           ostatok-start[5 + p-num]  = ostatok-start[5 + p-num]  + round( ub.aht-stk-line.crsa-sum-base ,2)
     4771                           ostatok-start[6 + p-num]  = ostatok-start[6 + p-num]  + round( ub.aht-stk-line.crsa-vat-base ,2)
     4772                           ostatok-start[7 + p-num]  = ostatok-start[7 + p-num]  + round( ub.aht-stk-line.sale-discnt-base ,2)
     4773                           ostatok-start[8 + p-num]  = ostatok-start[8 + p-num]  + round( ub.aht-stk-line.crsa-sum-base ,2)
     4774                           ostatok-start[9 + p-num]  = ostatok-start[9 + p-num]  + round( ub.aht-stk-line.crsa-vat-base ,2)
     4775                           ostatok-start[10 + p-num] = ostatok-start[10 + p-num] + round( ub.aht-stk-line.crsa-slt-base ,2)
     4776                     .
     4777                end.
     4778    find last  ub.aht-stk-line where
     4779                           ub.aht-stk-line.gds-code   = gds-zap-b-code
     4780                     and   ub.aht-stk-line.fact-order <= fact-order-2
     4781                     and   ub.aht-stk-line.obj-code   = p-store-code
     4782                     and   ub.aht-stk-line.obj-type   = p-store-type
     4783                     and   ub.aht-stk-line.sum-type   = x-type-pr
     4784                           use-index category no-lock no-error.
     4785           if available ub.aht-stk-line then do:
     4786               if  tprintrubl  then
     4787                     assign
     4788                           ostatok-end[1 + p-num]  = ostatok-end[1 + p-num] + (if ub.aht-stk-line.sum-type <> "b"
     4789                                                                  then round( ub.aht-stk-line.fact-qnty,3) else 0 )
     4790                           ostatok-end[2 + p-num]  = ostatok-end[2 + p-num] + round( ub.aht-stk-line.cost-sum-rubl ,2)
     4791                           ostatok-end[3 + p-num]  = ostatok-end[3 + p-num] + round( ub.aht-stk-line.cost-vat-rubl ,2)
     4792                           ostatok-end[4 + p-num]  = ostatok-end[4 + p-num] + 0
     4793                           ostatok-end[5 + p-num]  = ostatok-end[5 + p-num] + round( ub.aht-stk-line.crsa-sum-rubl ,2)
     4794                           ostatok-end[6 + p-num]  = ostatok-end[6 + p-num] + round( ub.aht-stk-line.crsa-vat-rubl ,2)
     4795                           ostatok-end[7 + p-num]  = ostatok-end[7 + p-num] + round( ub.aht-stk-line.sale-discnt-rubl ,2)
     4796                           ostatok-end[8 + p-num]  = ostatok-end[8 + p-num] + round( ub.aht-stk-line.crsa-sum-rubl ,2)
     4797                           ostatok-end[9 + p-num]  = ostatok-end[9 + p-num] + round( ub.aht-stk-line.crsa-vat-rubl ,2)
     4798                           ostatok-end[10 + p-num] = ostatok-end[10 + p-num] + round( ub.aht-stk-line.crsa-slt-rubl ,2)
     4799                           .
     4800                 else
     4801                     assign
     4802                           ostatok-end[1 + p-num]  = ostatok-end[1 + p-num] +  (if ub.aht-stk-line.sum-type <> "b"
     4803                                                                   then round( ub.aht-stk-line.fact-qnty,3) else 0 )
     4804                           ostatok-end[2 + p-num]  = ostatok-end[2 + p-num] +  round( ub.aht-stk-line.cost-sum-base ,2)
     4805                           ostatok-end[3 + p-num]  = ostatok-end[3 + p-num] +  round( ub.aht-stk-line.cost-vat-base ,2)
     4806                           ostatok-end[4 + p-num]  = ostatok-end[4 + p-num] +  0
     4807                           ostatok-end[5 + p-num]  = ostatok-end[5 + p-num] +  round( ub.aht-stk-line.crsa-sum-base ,2)
     4808                           ostatok-end[6 + p-num]  = ostatok-end[6 + p-num] +  round( ub.aht-stk-line.crsa-vat-base ,2)
     4809                           ostatok-end[7 + p-num]  = ostatok-end[7 + p-num] +  round( ub.aht-stk-line.sale-discnt-base ,2)
     4810                           ostatok-end[8 + p-num]  = ostatok-end[8 + p-num] +  round( ub.aht-stk-line.crsa-sum-base ,2)
     4811                           ostatok-end[9 + p-num]  = ostatok-end[9 + p-num] +  round( ub.aht-stk-line.crsa-vat-base ,2)
     4812                           ostatok-end[10 + p-num] = ostatok-end[10 + p-num] + round( ub.aht-stk-line.crsa-slt-base ,2)
     4813                     .
     4814                end.
     4815   end.
     4816   end procedure.
     4817   procedure ob-line  :
     4818   do on error undo, return error return-value :
     4819   def input  parameter x-store-code     like ub.clients.obj-code         no-undo .
     4820   def input  parameter x-store-type     like ub.clients.obj-type         no-undo .
     4821   def input  parameter x-gds-code       like ub.aht-ot-line.gds-code     no-undo .
     4822   def input  parameter x-fact-order-1   like ub.aht-ot-line.fact-order   no-undo .
     4823   def input  parameter x-fact-order-2   like ub.aht-ot-line.fact-order   no-undo .
     4824   def input  parameter x-sum-type       like ub.aht-ot-line.sum-type     no-undo .
     4825   def input  parameter xtog-obj         as logical no-undo .
     4826   define variable      tt#              as integer no-undo .
     4827   define variable x-type-pr1 as character no-undo .
     4828   define variable x-type-pr2 as character no-undo .
     4829   define variable p-ok as logical   no-undo .
     4830    if x-sum-type = arh-type-cost then tt# = 0 .
     4831    if x-sum-type = arh-type-crsa then tt# = 3 .
     4832    if x-sum-type = arh-type-sale then tt# = 6 .
     4833   if  x-sum-type = "cb" then
     4834    assign
     4835       x-type-pr1 = "c"
     4836       x-type-pr2 = "b"
     4837    .
     4838   else
     4839    assign
     4840       x-type-pr1 = x-sum-type
     4841       x-type-pr2 = x-sum-type
     4842    .
     4843        for each ub.aht-ot-line where
     4844                     (      ub.aht-ot-line.gds-code     = x-gds-code
     4845                     and   ub.aht-ot-line.fact-order   <= x-fact-order-2
     4846                     and   ub.aht-ot-line.fact-order   >= x-fact-order-1
     4847                     and   ub.aht-ot-line.obj-code     = x-store-code
     4848                     and   ub.aht-ot-line.obj-type     = x-store-type
     4849                     and   ub.aht-ot-line.sum-type     = x-type-pr1)
     4850                     or
     4851                     (     ub.aht-ot-line.gds-code     = x-gds-code
     4852                     and   ub.aht-ot-line.fact-order   <= x-fact-order-2
     4853                     and   ub.aht-ot-line.fact-order   >= x-fact-order-1
     4854                     and   ub.aht-ot-line.obj-code     = x-store-code
     4855                     and   ub.aht-ot-line.obj-type     = x-store-type
     4856                     and   ub.aht-ot-line.sum-type     = x-type-pr2 )
     4857                     no-lock :
     4858       if  p-tpsy = true then do:
     4859           run ver-owner2
     4860           ( input  ub.aht-ot-line.gds-code,
     4861             input  ub.aht-ot-line.obj-type,
     4862             input  ub.aht-ot-line.obj-code,
     4863             output p-ok ) .
     4864       end.
     4865       case ub.aht-ot-line.ext-doc-type:
     4866                 when        'ie':U  or
     4867                 when        're':U  or
     4868                 when        'iv':U    or
     4869                 when        'rv':U or
     4870                 when        'im':U     then
     4871                 do:
     4872                 assign
     4873                        prih[1 ]   = prih[1 ]   + (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4874                        prih[2 ]   = prih[2 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4875                        prih[3 ]   = prih[3 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4876                        prih[4 ]   = prih[4 ]
     4877                        prih[5 ]   = prih[5 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4878                        prih[6 ]   = prih[6 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4879                        prih[7 ]   = prih[7 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4880                        prih[8 ]   = prih[8 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4881                        prih[9 ]   = prih[9 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4882                        gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4883                  .
     4884        if p-ok = true then do:
     4885           assign
     4886             prih[11 ]   = prih[11 ]   + (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4887             prih[12 ]   = prih[12 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4888             prih[13 ]   = prih[13 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4889             prih[14 ]   = prih[14 ]
     4890             prih[15 ]   = prih[15 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4891             prih[16 ]   = prih[16 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4892             prih[17 ]   = prih[17 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4893             prih[18 ]   = prih[18 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4894             prih[19 ]   = prih[19 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4895             .
     4896        end.
     4897                 end.
     4898                 when       'ee':U      or
     4899                 when       'ep':U    or
     4900                 when       'ev':U     or
     4901                 when       'em':U       or
     4902                 when       'wm':U       or
     4903                 when       'we':U     then
     4904                 do:
     4905                   assign
     4906                       rash[1  ]   = rash[1 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4907                       rash[2  ]   = rash[2 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4908                       rash[3 ]   = rash[3 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4909                       rash[4 ]   = rash[4 ]
     4910                       rash[5 ]   = rash[5 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4911                       rash[6 ]   = rash[6 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4912                       rash[7 ]   = rash[7 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4913                       rash[8 ]   = rash[8 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4914                       rash[9 ]   = rash[9 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4915                       gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4916                 .
     4917                   if p-ok = true then do:
     4918                     assign
     4919                       rash[11  ]   = rash[11 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4920                       rash[12  ]   = rash[12 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4921                       rash[13 ]   = rash[13 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4922                       rash[14 ]   = rash[14 ]
     4923                       rash[15 ]   = rash[15 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4924                       rash[16 ]   = rash[16 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4925                       rash[17 ]   = rash[17 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4926                       rash[18 ]   = rash[18 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4927                       rash[19 ]   = rash[19 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4928                     .
     4929                   end.
     4930                 end.
     4931                 when       'es':U  or
     4932                 when       'rs':U then
     4933                 do:
     4934                     assign
     4935                       kassa[1  ]   = kassa[1 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4936                       kassa[2  ]   = kassa[2 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4937                       kassa[3  ]   = kassa[3 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4938                       kassa[4  ]   = kassa[4 ]
     4939                       kassa[5  ]   = kassa[5 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4940                       kassa[6  ]   = kassa[6 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4941                       kassa[7  ]   = kassa[7 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4942                       kassa[8  ]   = kassa[8 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4943                       kassa[9  ]   = kassa[9 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4944                       gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4945                       .
     4946                     if p-ok = true then
     4947                     assign
     4948                       kassa[11  ]   = kassa[11 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4949                       kassa[12  ]   = kassa[12 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4950                       kassa[13  ]   = kassa[13 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4951                       kassa[14  ]   = kassa[14 ]
     4952                       kassa[15  ]   = kassa[15 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4953                       kassa[16  ]   = kassa[16 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4954                       kassa[17  ]   = kassa[17 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4955                       kassa[18  ]   = kassa[18 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4956                       kassa[19  ]   = kassa[19 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4957                       .
     4958                 end.
     4959             when       'vt':U            or
     4960             when       'pc':U or
     4961             when       'vp':U       then do:
     4962                 assign
     4963                   inv[1  ]   = inv[1 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4964                   inv[2  ]   = inv[2 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4965                   inv[3  ]   = inv[3 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4966                   inv[4  ]   = inv[4 ]
     4967                   inv[5  ]   = inv[5 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4968                   inv[6  ]   = inv[6 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4969                   inv[7  ]   = inv[7 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4970                   inv[8  ]   = inv[8 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4971                   inv[9  ]   = inv[9 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4972                   gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4973                   .
     4974                 if p-ok = true then
     4975                 assign
     4976                   inv[11  ]   = inv[11 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4977                   inv[12  ]   = inv[12 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4978                   inv[13  ]   = inv[13 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4979                   inv[14  ]   = inv[14 ]
     4980                   inv[15  ]   = inv[15 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4981                   inv[16  ]   = inv[16 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4982                   inv[17  ]   = inv[17 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4983                   inv[18  ]   = inv[18 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4984                   inv[19  ]   = inv[19 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4985                   .
     4986                 end.
     4987             when       'ot':U or
     4988             when       'ap':U then
     4989                 do:
     4990                    assign
     4991                       overturn[1  ]   = overturn[1 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4992                       overturn[2  ]   = overturn[2 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4993                       overturn[3  ]   = overturn[3 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4994                       overturn[4  ]   = overturn[4 ]
     4995                       overturn[5  ]   = overturn[5 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4996                       overturn[6  ]   = overturn[6 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4997                       overturn[7  ]   = overturn[7 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4998                       overturn[8  ]   = overturn[8 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4999                       overturn[9  ]   = overturn[9 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     5000                       gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     5001                       .
     5002                    if p-ok = true then
     5003                    assign
     5004                       overturn[11  ]   = overturn[11 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     5005                       overturn[12  ]   = overturn[12 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     5006                       overturn[13  ]   = overturn[13 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     5007                       overturn[14  ]   = overturn[14 ]
     5008                       overturn[15  ]   = overturn[15 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     5009                       overturn[16  ]   = overturn[16 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     5010                       overturn[17  ]   = overturn[17 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     5011                       overturn[18  ]   = overturn[18 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     5012                       overturn[19  ]   = overturn[19 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     5013                       .
     5014                 end.
     5015         end case.
     5016     end.
     5017     assign
     5018       tt# = 6
     5019       overturn[1 + tt# ]   = (ostatok-end[1 + tt# ]  - ostatok-start[1 + tt# ] )  -  (inv[1 + tt# ] + prih[1 + tt# ] + kassa[1 + tt# ] + rash[1 + tt# ]  )
     5020       overturn[2 + tt# ]   = (ostatok-end[2 + tt# ]  - ostatok-start[2 + tt# ] )  -  (inv[2 + tt# ] + prih[2 + tt# ] + kassa[2 + tt# ] + rash[2 + tt# ]  )
     5021       overturn[3 + tt# ]   = (ostatok-end[3 + tt# ]  - ostatok-start[3 + tt# ] )  -  (inv[3 + tt# ] + prih[3 + tt# ] + kassa[3 + tt# ] + rash[3 + tt# ]  )
     5022     .
     5023     if p-ok = true then
     5024     assign
     5025       tt# = 6
     5026       overturn[1 + tt# ]   = (ostatok-end[1 + tt# ]  - ostatok-start[1 + tt# ] )  -  (inv[1 + tt# ] + prih[1 + tt# ] + kassa[1 + tt# ] + rash[1 + tt# ]  )
     5027       overturn[2 + tt# ]   = (ostatok-end[2 + tt# ]  - ostatok-start[2 + tt# ] )  -  (inv[2 + tt# ] + prih[2 + tt# ] + kassa[2 + tt# ] + rash[2 + tt# ]  )
     5028       overturn[3 + tt# ]   = (ostatok-end[3 + tt# ]  - ostatok-start[3 + tt# ] )  -  (inv[3 + tt# ] + prih[3 + tt# ] + kassa[3 + tt# ] + rash[3 + tt# ]  )
     5029     .
     5030   end.
     5031   end procedure.
     5032   procedure ver-owner :
     5033     do
     5034     on error undo, return error return-value
     5035     :
     5036   define input  parameter p-gds-code like ub.goods.gds-code no-undo .
     5037   define input  parameter p-db-num as integer   no-undo .
     5038   define output parameter p-ok as logical   no-undo .
     5039   define variable  p-proprietor-host-code like ub.clients.host-code no-undo .
     5040   define variable  p-proprietor-obj-type  like ub.clients.obj-type no-undo .
     5041   define variable  p-proprietor-obj-code  like ub.clients.obj-code no-undo .
     5042   p-ok = false .
     5043   if  p-tpsy = false  then return.
     5044     run tpsi-gds-proprietor (
     5045         input  p-gds-code             ,
     5046         input  p-db-num               ,
     5047         output p-proprietor-host-code ,
     5048         output p-proprietor-obj-type  ,
     5049         output p-proprietor-obj-code )  .
     5050    if p-proprietor-host-code = v-cntxt-host-code-obj then p-ok = true  .
     5051   end.
     5052   end procedure.
     5053   procedure ver-owner2 :
     5054     do
     5055     on error undo, return error return-value
     5056     :
     5057   define input  parameter p-gds-code like ub.goods.gds-code no-undo .
     5058   define input  parameter p-obj-type  like ub.clients.obj-type no-undo .
     5059   define input  parameter p-obj-code  like ub.clients.obj-code no-undo .
     5060   define output parameter p-ok as logical   no-undo .
     5061   define variable  p-proprietor-host-code like ub.clients.host-code no-undo .
     5062   define variable  p-proprietor-obj-type  like ub.clients.obj-type no-undo .
     5063   define variable  p-proprietor-obj-code  like ub.clients.obj-code no-undo .
     5064   p-ok = false .
     5065   if  p-tpsy = false  then return.
     5066   define buffer buf_obj-list for obj-list.
     5067   find first buf_obj-list where
     5068         buf_obj-list.obj-type = p-obj-type and
     5069         buf_obj-list.obj-code = p-obj-code
     5070         no-error .
     5071   if error-status :error then return .
     5072     run tpsi-gds-proprietor (
     5073         input  p-gds-code             ,
     5074         input  buf_obj-list.db-num     ,
     5075         output p-proprietor-host-code ,
     5076         output p-proprietor-obj-type  ,
     5077         output p-proprietor-obj-code )  .
     5078    if p-proprietor-host-code = v-cntxt-host-code-obj then p-ok = true  .
     5079   end.
     5080   end procedure.
