      160   procedure create_obj-list :
      161      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      162      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      163      do
      164      on error undo, return error return-value
      165      :
      166         define buffer cli-obj for ub.clients .
      167         define variable p-var as integer no-undo .
      168         define buffer buf_obj-list for obj-list .
      169         find last buf_obj-list  use-index pi no-error .
      170         if available buf_obj-list
      171         then
      172            p-var = buf_obj-list.obj-id + 1.
      173         else
      174            p-var = 1.
      175         find first cli-obj where
      176                   cli-obj.obj-type = p-obj-type
      177               and cli-obj.obj-code = p-obj-code
      178         no-lock no-error.
      179         if available cli-obj
      180         then do:
      181            create buf_obj-list.
      182            assign
      183               buf_obj-list.obj-id   = p-var
      184               buf_obj-list.obj-code = cli-obj.obj-code
      185               buf_obj-list.obj-type = cli-obj.obj-type
      186               buf_obj-list.obj-name = cli-obj.obj-name
      187               buf_obj-list.db-num   = cli-obj.db-num
      188            .
      189         end.
      190      end.
      191   end.
