     4185   procedure di :
     4186   def input parameter p1 as char no-undo.
     4187   def input parameter p2 as int no-undo.
     4188   def input parameter p3 as char no-undo.
     4189   def input parameter p4 as char no-undo.
     4190   def input parameter p5 as char no-undo.
     4191   def input parameter p6 as char no-undo.
     4192   def input parameter p7 as char no-undo.
     4193    case caps(p7) :
     4194      when "b1":u  then do:
     4195       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     4196         p3 @ s-bar-code
     4197         p4 @ gds-zap-artic
     4198         p5 @ gds-zap-gds-name
     4199         p6 @ gds-zap-unit-base
     4200         p1 @ gds-type
