     3969   procedure item-goods :
     3970      def input parameter  par-3 as char no-undo.
     3971      def input parameter  par-4 as char no-undo.
     3972        if par-4 = "goods":u  then do:
     3973           assign
     3974               gds-zap-unit-base  = goods.unit-base
     3975               gds-zap-prt-root   = goods.prt-root
     3976               gds-zap-prod-type  = goods.prod-type
     3977               gds-zap-prod-code  = goods.prod-code
     3978               gds-zap-artic      = goods.artic
     3979               gds-zap-grp-name   = goods.grp-name
     3980               gds-zap-b-code     = goods.gds-code
     3981               gds-zap-type       = goods.gds-type.
     3982           if g#gds-engl then
     3983               assign gds-zap-gds-name = goods.engl-name.
     3984           else
     3985               assign gds-zap-gds-name = goods.gds-name.
     3986        end.
     3987        if par-4 = "gds-list":u  then do:
     3988           assign
     3989               gds-zap-unit-base  = gds-list.unit-base
     3990               gds-zap-prt-root   = gds-list.prt-root
     3991               gds-zap-prod-type  = gds-list.prod-type
     3992               gds-zap-prod-code  = gds-list.prod-code
     3993               gds-zap-artic      = gds-list.artic
     3994               gds-zap-grp-name   = gds-list.grp-name
     3995               gds-zap-b-code     = gds-list.gds-code
     3996               gds-zap-type       = gds-list.gds-type.
     3997           if g#gds-engl then
     3998               assign gds-zap-gds-name = gds-list.engl-name.
     3999           else
     4000               assign gds-zap-gds-name = gds-list.gds-name.
     4001        end.
     4002       define variable old-gds-zap-gds-name as character no-undo .
     4003       old-gds-zap-gds-name = gds-zap-gds-name.
     4004       x-type-pr = "r".
     4005       run foreach.
     4006   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     4007     (input  gds-zap-b-code
     4008     ,input  ?
     4009     ,output v-bar-code
     4010     )  .
     4011   s-bar-code = string (v-bar-code,"999999999").
     4012       If  break_group = true  and par-3 <> "1"  then DO :
     4013            FIND FIRST clients WHERE clients.obj-type = gds-zap-prod-type AND clients.obj-code = gds-zap-prod-code use-index pi NO-LOCK .
     4014            gds-zap-prod-name  = clients.obj-name.
     4015             If break_group1 = true  THEN  DO :
     4016               if (par-3 = "3"  OR  par-3 = "5" ) and  par-3 <> "6"
     4017                 then DO: Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )         b1-name = gds-zap-grp-name . end.
     4018                 else DO: Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) b1-name = gds-zap-prod-name. end.
     4019               if par-3 = "6"  then  dO:
     4020                  if xTog-obj = true then do:
     4021                    var-vat-pc = func-vat (input gds-zap-b-code , input x-store-type, input x-store-code)
     4022                     .
     4023                   end.
     4024                  else do:
     4025                   var-vat-pc = temp-gds-list.vat-pc .
     4026                   end.
     4027                   assign
     4028                       temp-str = string( "СТАВКА НДС : " + string(var-vat-pc) + "%" )
     4029                       b1-name = temp-str.
     4030                   end.
     4031               if NOT xSumsOnly or (par-3 = "4" Or par-3 = "5" ) THEN DO :
     4032                   fr0 = true .
     4033                   tmp#stroka0 = temp-str.
     4034               End.
     4035             End.
     4036               IF (par-3 = "4"  OR  par-3 = "5")  THEN DO:
     4037                 if par-3 = "4"
     4038                   then Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )          b2-name = gds-zap-grp-name .
     4039                   else Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name )  b2-name = gds-zap-prod-name.
     4040                 if NOT xSumsOnly THEN DO:
     4041                     fr = true .
     4042                 End.
     4043                 break_group1 = false.
     4044               END.
     4045          break_group = false.
     4046       End.
     4047       gds-zap-gds-name = string(old-gds-zap-gds-name,"x(28)") + "|" + "Выкуп".
