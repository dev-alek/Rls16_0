     3665           input x-shift-end      ,
     3666           input "n"    ,
     3667           input xtog-obj         ,
     3668           output  fact-order-1 ) .
     3669       run aht-ostatok (
     3670           input x-store-code  ,
     3671           input x-store-type  , x-tog-shift,
     3672           input x-date-start  ,
     3673           input x-date-end    , x-shift-start,x-shift-end,
     3674           input "n" ,
     3675           input xtog-obj ,
     3676           output  fact-order-2 ).
     3677   end procedure.
     3678   procedure display-str1  :
     3679      if p-tpsy = no  or ( p-tpsy = true and  p-type-tpsy-goods = 2 ) then do:
     3680            run di-qnty ("кол-во", 1, s-bar-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     3681            if xshowcost   then do: run di ( "учет." , 2,"","","","","" ). end.
     3682            if xshowcrsa   then do: run di ( "прод." , 5,"","","","","" ). end.
     3683            if xshowsale   then do: run di ( "док."  , 8,"","","","","" ). end.
     3684            if vat-cost    then do: run di ( "уч.НДС", 3,"","","","","" ). end.
     3685            if vat-crsa    then do: run di ( "пр.НДС", 6,"","","","","" ). end.
     3686            if vat-sale    then do: run di ( "дк.НДС", 9,"","","","","" ). end.
     3687      end.
     3688      if p-tpsy = true  then do:
     3689            if  p-type-tpsy-goods = 3 then
     3690                run di-qnty ("кол-во", 11, s-bar-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     3691            else
     3692               run di-qnty ("кол-во", 11, "","",str_svoi,"","").
     3693            if xshowcost   then do: run di ( "учет." , 12,"","","","","" ). end.
     3694            if xshowcrsa   then do: run di ( "прод." , 15,"","","","","" ). end.
     3695            if xshowsale   then do: run di ( "док."  , 18,"","","","","" ). end.
     3696            if vat-cost    then do: run di ( "уч.НДС", 13,"","","","","" ). end.
     3697            if vat-crsa    then do: run di ( "пр.НДС", 16,"","","","","" ). end.
     3698            if vat-sale    then do: run di ( "дк.НДС", 19,"","","","","" ). end.
     3699      end.
