     3878   procedure display-title :
     3879   define variable v-nn as integer   no-undo .
     3880      PUT stream  OutStream  UNFORMATTED  string( v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + objname) at 50 format "x(85)" skip(2)
     3881             reportname  at 20 format "x(170)" skip
     3882             trim(str1)  at 35 format "x(75)" skip.
     3883        v-nn = num-entries(str2,chr(10)) .
     3884        repeat i = 1 to v-nn :
     3885         PUT stream  OutStream  UNFORMATTED  entry(i,str2,chr(10))  at 1 format "x(170)" skip.
     3886        end.
     3887       i=0.
     3888        PUT stream  OutStream  UNFORMATTED  trim(str3)  at 35 format "x(75)" skip.
     3889        v-nn = num-entries(str4,chr(10)) .
     3890        repeat i = 1 to v-nn:
     3891          PUT stream  OutStream  UNFORMATTED  entry(i,str4,chr(10))  at 1 format "x(170)" skip.
     3892        end.
     3893       i=0.
     3894        v-nn = num-entries( reportheader,chr(10)) .
     3895        repeat i = 1 to v-nn :
     3896         PUT stream  OutStream  UNFORMATTED  entry(i,reportheader,chr(10))  at 1 format "x(170)" skip.
     3897        end.
     3898       i=0.
     3899       run rep/extitle.p (1) .
     3900   end procedure.
     3901   procedure report-exec1  :
     3902      find first clients where x-store-type = clients.obj-type and
     3903                               x-store-code = clients.obj-code no-lock no-error.
     3904     run calcitog.
     3905     run print-header.
     3906      case retclassify :
     3907         when "grp-goods":u then      run run2 in this-procedure .
     3908         otherwise do:
     3909           message "error" view-as alert-box error .
     3910         end.
     3911      end case.
     3912     run print-footer.
     3913     end procedure.
     3914   procedure calc-sub-itog :
     3915   define variable b  as int no-undo.
     3916   assign
     3917     b1-gds-zap-other = b1-gds-zap-other +  gds-zap-other
     3918     b2-gds-zap-other = b2-gds-zap-other +  gds-zap-other
     3919     bi-gds-zap-other = bi-gds-zap-other +  gds-zap-other
     3920     bo-gds-zap-other = bo-gds-zap-other +  gds-zap-other
     3921     .
     3922   repeat b = 1 to 20 :
     3923     assign
     3924     b1-ostatok-start[b ]    = b1-ostatok-start[b ]    +  ostatok-start[b ]
     3925     b1-ostatok-end  [b ]    = b1-ostatok-end  [b ]    +  ostatok-end  [b ]
     3926     b2-ostatok-start[b ]    = b2-ostatok-start[b ]    +  ostatok-start[b ]
     3927     b2-ostatok-end  [b ]    = b2-ostatok-end  [b ]    +  ostatok-end  [b ]
     3928     bi-ostatok-start[b ]    = bi-ostatok-start[b ]    +  ostatok-start[b ]
     3929     bi-ostatok-end  [b ]    = bi-ostatok-end  [b ]    +  ostatok-end  [b ]
     3930     bo-ostatok-start[b ]    = bo-ostatok-start[b ]    +  ostatok-start[b ]
     3931     bo-ostatok-end  [b ]    = bo-ostatok-end  [b ]    +  ostatok-end  [b ]
     3932     b1-prih[b ]    = b1-prih[b ]    +  prih[b ]
     3933     b2-prih[b ]    = b2-prih[b ]    +  prih[b ]
     3934     bi-prih[b ]    = bi-prih[b ]    +  prih[b ]
     3935     bo-prih[b ]    = bo-prih[b ]    +  prih[b ]
     3936     b1-rash[b ]    = b1-rash[b ]    +  rash[b ]
     3937     b2-rash[b ]    = b2-rash[b ]    +  rash[b ]
     3938     bi-rash[b ]    = bi-rash[b ]    +  rash[b ]
     3939     bo-rash[b ]    = bo-rash[b ]    +  rash[b ]
     3940     b1-kassa[b ]    = b1-kassa[b ]    +  kassa[b ]
     3941     b2-kassa[b ]    = b2-kassa[b ]    +  kassa[b ]
     3942     bi-kassa[b ]    = bi-kassa[b ]    +  kassa[b ]
     3943     bo-kassa[b ]    = bo-kassa[b ]    +  kassa[b ]
     3944     b1-inv[b ]    = b1-inv[b ]    +  inv[b ]
     3945     b2-inv[b ]    = b2-inv[b ]    +  inv[b ]
     3946     bi-inv[b ]    = bi-inv[b ]    +  inv[b ]
     3947     bo-inv[b ]    = bo-inv[b ]    +  inv[b ]
     3948     b1-overturn[b ]    = b1-overturn[b ]    +  overturn[b ]
     3949     b2-overturn[b ]    = b2-overturn[b ]    +  overturn[b ]
     3950     bi-overturn[b ]    = bi-overturn[b ]    +  overturn[b ]
     3951     bo-overturn[b ]    = bo-overturn[b ]    +  overturn[b ]
     3952     .
     3953   end.
     3954   end procedure.
