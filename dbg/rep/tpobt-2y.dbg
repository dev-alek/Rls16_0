     3827            else
     3828             run di-qnty( "кол-во", 11 ,"","", str_svoi,"", "b2":u).
     3829           if xshowcost    then do: run di ("учет.", 12, "","", "", "", "b2":u).  end.
     3830           if xshowcrsa    then do: run di ("прод.", 15 ,"","", "", "", "b2":u).  end.
     3831           if xshowsale    then do: run di ("док.", 18 ,"","", "", "", "b2":u).  end.
     3832            if vat-cost    then do: run di ( "уч.НДС", 13,"","","","","b2":u ). end.
     3833            if vat-crsa    then do: run di ( "пр.НДС", 16,"","","","","b2":u ).  end.
     3834            if vat-sale    then do: run di ( "дк.НДС", 19,"","","","","b2":u ).  end.
     3835      end.
     3836    end.
     3837   end.
     3838   end procedure.
     3839   procedure clear-b1  :
     3840    b1-gds-zap-other           = 0.
     3841    repeat kk = 1 to 20 :
     3842    assign
