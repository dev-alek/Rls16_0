     1076         .
     1077   define variable vss-include-info13 as character format "X(65)" no-undo
     1078   initial "@(#)$Workfile$ $Revision$".
     1079   procedure grplib-get-full-name :
     1080      define input parameter p-node-code  as integer      no-undo.
     1081      define output parameter p-full-name as character    no-undo.
     1082      do
     1083   on error undo, return error
     1084   :
     1085       define variable v-upper-code    as integer           no-undo.
     1086       define buffer buf_gds-grp       for ub.gds-grp.
     1087       define buffer buf_upper_gds-grp for ub.gds-grp.
     1088       find first buf_gds-grp no-lock
     1089            where buf_gds-grp.node-code = p-node-code
     1090       no-error.
     1091       if not available buf_gds-grp
     1092       then do:
     1093           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1094       end.
     1095       assign
     1096           p-full-name  = ""
     1097           v-upper-code = 1
     1098       .
     1099       do while buf_gds-grp.upper-code <> 0
     1100       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1101       :
     1102           assign
     1103               p-full-name  = buf_gds-grp.node-name
     1104                            + (if p-full-name <> "" then chr(47) else "")
     1105                            + p-full-name
     1106               v-upper-code = buf_gds-grp.upper-code
     1107           .
     1108           find first buf_gds-grp no-lock
     1109                where buf_gds-grp.node-code = v-upper-code
     1110           no-error.
     1111           if not available buf_gds-grp
     1112           then do:
     1113               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     1114                                   + string( v-upper-code )
     1115                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1116           end.
     1117       end.
     1118       assign
     1119       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1120       .
     1121   end.
     1122   end .
     1123   procedure grplib-get-node-from-full-name :
     1124   define input parameter p-full-name as character no-undo .
     1125   define output parameter p-node-code as integer no-undo .
     1126   define variable v-ii as integer no-undo .
     1127   define variable v-upper-code as integer no-undo .
     1128   define variable v-root-code as integer no-undo .
     1129   define variable v-entry as character no-undo .
     1130   define buffer buf_gds-grp       for ub.gds-grp.
     1131   do
     1132   on error undo, return error
     1133   :
     1134     find first buf_gds-grp no-lock
     1135         where buf_gds-grp.upper-code = 0
     1136     no-error .
     1137     if not available buf_gds-grp
     1138     then do:
     1139         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     1140     end.
     1141     else do:
     1142       assign
     1143       v-root-code = buf_gds-grp.node-code
     1144       .
     1145     end.
     1146     v-upper-code = v-root-code.
     1147     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1148       assign
     1149       v-entry = entry(v-ii, p-full-name, chr(47)).
     1150       if v-entry = '' then leave.
     1151       find first buf_gds-grp no-lock where
     1152                 buf_gds-grp.node-name = v-entry
     1153             and buf_gds-grp.upper-code = v-upper-code
     1154             no-error.
     1155       if not available buf_gds-grp then do:
     1156         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1157       end.
     1158       else do:
     1159         p-node-code = buf_gds-grp.node-code.
     1160         v-upper-code = buf_gds-grp.node-code.
     1161       end.
     1162     end.
     1163   end.
     1164   end .
     1165   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1166   define variable v-waitfram-action01         as character   no-undo .
     1167   define variable v-waitfram-action02         as character   no-undo .
     1168   define variable v-waitfram-action03         as character   no-undo .
     1169   define variable mWaitFramTextBeg            as character   no-undo.
     1170   define variable mWaitFramTextEnd            as character   no-undo.
     1171   define variable mWaitFramView               as logical     no-undo.
     1172   define variable mWaitProcEvent              as logical     no-undo init yes.
     1173   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1174   define variable mWaitFramStop               as logical     no-undo.
     1175   define variable mWaitFramStopUser           as logical     no-undo.
     1176   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1177   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1178   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1179   define button B-WaitFramStop auto-end-key
     1180        label "Стоп"
     1181        size 10 by 1 tooltip "Остоновить процесс".
     1182   define button B-viewProcInfo
     1183        label "Информация"
     1184        size 15 by 1 tooltip "Информация о процесс".
     1185   define frame waitfram
     1186     v-waitfram-action01 format "x(72)" no-label skip
     1187     v-waitfram-action02 format "x(72)" no-label skip
     1188     v-waitfram-action03 format "x(72)" no-label skip
     1189     B-viewProcInfo
     1190     B-WaitFramStop at row 4 col 30
     1191     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1192     .
     1193   define new global shared variable mBatchMode as logical no-undo init ?.
     1194   define variable mFramBachModHandle as handle no-undo.
     1195   mFramBachModHandle = frame waitfram:handle.
     1196   define variable mFameOldVis as logical no-undo.
     1197   define variable mVisCUrentVin as logical no-undo.
     1198   if session:batch-mode
     1199   then
     1200      mBatchMode = yes.
     1201   if mBatchMode = ? then do:
     1202     mVisCUrentVin = current-window:visible.
     1203     mFameOldVis = mFramBachModHandle:visible.
     1204     mFramBachModHandle:visible  = yes.
     1205     mBatchMode = mFramBachModHandle:visible ne yes.
     1206     mFramBachModHandle:visible = mFameOldVis.
     1207     current-window:visible = mVisCUrentVin.
     1208   end.
     1209    if  log-manager:logfile-name ne ?
     1210     then DO:
     1211         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1212         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1213         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1214     end.
     1215   on choose of B-WaitFramStop in frame waitfram
     1216   do:
     1217     mWaitFramStop = yes.
     1218     mWaitFramStopUser = yes.
     1219   end.
     1220   function waitfram-check-timeout returns logical():
     1221      define variable vtime as int64 no-undo.
     1222      if mWaitFramStopTimeOut
     1223      then
     1224         return yes.
     1225      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1226      if     mWaitFramTimeOut ne ?
     1227         and mWaitFramTimeOut ne 0
     1228         and mWaitFramTimeOut lt vtime
     1229      then do:
     1230         mWaitFramStopTimeOut = yes.
     1231      end.
     1232      return mWaitFramStopTimeOut.
     1233   end.
     1234   procedure waitfram-hide :
     1235     if not session:batch-mode
     1236     then do
     1237     on error undo, return error return-value
     1238     :
     1239       pause 0 before-hide .
     1240       if not mBatchMode then
     1241         hide frame waitfram .
     1242     if     not mWaitFramView
     1243        and mWaitProcEvent
     1244     then
     1245       process events .
     1246     end.
     1247   end procedure.
     1248   procedure waitfram-show :
     1249     define input  parameter p-message as character no-undo .
     1250     define variable v-left-margin as integer   no-undo .
     1251     if not session:batch-mode
     1252     then do
     1253     on error undo, return error return-value
     1254     :
     1255       if length(p-message) <= 70 then do:
     1256         assign
     1257           v-left-margin = integer((70 - length(p-message)) / 2)
     1258         .
     1259         assign
     1260           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1261         .
     1262         assign
     1263           v-waitfram-action01 = " "
     1264           v-waitfram-action02 = " "
     1265                                    + fill(" ", v-left-margin)
     1266                                    + p-message
     1267           v-waitfram-action03 = " "
     1268         .
     1269       end.
     1270       else do:
     1271         define variable vRindex1 as integer no-undo.
     1272         define variable vRindex2 as integer no-undo.
     1273         vRindex1 = r-index(p-message," ",70).
     1274         if vRindex1 = 0
     1275         then
     1276            vRindex1 = 70.
     1277         if length(p-message)  <= vRindex1 + 70 then do:
     1278           assign
     1279             v-waitfram-action01 = " "
     1280             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1281             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1282           .
     1283         end.
     1284         else do:
     1285           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1286           if vRindex2 <= vRindex1
     1287           then
     1288              vRindex2 = vRindex1 + 70.
     1289           assign
     1290             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1291             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1292             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1293           .
     1294         end.
     1295       end.
     1296       B-viewProcInfo:visible   in frame waitfram = no.
     1297       B-viewProcInfo:sensitive in frame waitfram = no.
     1298       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1299       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1300       if  (   mWaitFramView
     1301          or  mWaitProcEvent)
     1302          and not mBatchMode
     1303       then
     1304          display
     1305             v-waitfram-action01 skip
     1306             v-waitfram-action02 skip
     1307             v-waitfram-action03 skip
     1308          with frame waitfram .
     1309       if     mWaitFramView
     1310          then do:
     1311             if     mWaitFramInterval ne ?
     1312                and not mBatchMode
     1313             then
     1314                wait-for go of frame waitfram pause mWaitFramInterval.
     1315          end.
     1316          else
     1317             if     mWaitProcEvent
     1318                and not mBatchMode
     1319             then
     1320                process events .
     1321     end.
     1322   end procedure.
     1323      procedure waitfram-show-this:
     1324         define input  parameter iInterval as int64 no-undo.
     1325         define variable vtime as int64 no-undo.
     1326         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1327         mWaitFramInterval = iInterval.
     1328         run waitfram-show (substitute("&1&2 &3&4" ,
     1329                                       mWaitFramTextBeg ,
     1330                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1331                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1332                                       mWaitFramTextEnd
     1333                                      )
     1334                           ).
     1335      end.
     1336      procedure WaitFramRunPause:
     1337         define input  parameter iInterval as dec no-undo.
     1338         define variable vStart  as datetime-tz no-undo.
     1339         define variable vend    as datetime-tz no-undo.
     1340         define variable vint as int64 no-undo.
     1341         define variable vOk as logical no-undo.
     1342         vStart = now.
     1343         vend   = vStart.
     1344         publish "WaitFramPause" (iInterval,output vOk).
     1345         vend   =  now.
     1346         vint = vend - vStart.
     1347         vint = iInterval - vint / 1000.
     1348         if     not mWaitFramStop
     1349            and (   vint > 0
     1350                 or (    not vOk
     1351                     and iInterval eq ?
     1352                     )
     1353                 )
     1354         then
     1355            run waitfram-show-this (iInterval).
     1356         vend   =  now.
     1357         vint = vend - vStart.
     1358         vint = iInterval - vint / 1000.
     1359         if     not mWaitFramStop
     1360            and vint > 0
     1361         then do:
     1362            run gbl/pause.p (vint * 1000).
     1363         end.
     1364         if iInterval ne ?
     1365         then
     1366            publish "WaitFramStop".
     1367         waitfram-check-timeout().
     1368      end.
     1369      procedure WaitFramWaitFor:
     1370         define input  parameter iInterval as dec no-undo.
     1371         assign
     1372            mWaitFramStartProc   = now
     1373            mWaitFramStopUser    = no
     1374            mWaitFramStopTimeOut = no
     1375         .
     1376         block-wait:
     1377         do while not mWaitFramStop:
     1378            run WaitFramRunPause (iInterval).
     1379            if  waitfram-check-timeout()
     1380            then do:
     1381               leave block-wait.
     1382            end.
     1383         end.
     1384         run waitfram-hide.
     1385      end.
     1386   procedure waitfram-join :
     1387     define input  parameter p-line-1  as character no-undo .
     1388     define input  parameter p-line-2  as character no-undo .
     1389     define input  parameter p-line-3  as character no-undo .
     1390     define output parameter p-message as character no-undo .
     1391     do
     1392     on error undo, return error return-value
     1393     :
     1394       assign
     1395         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1396                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1397                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1398       .
     1399     end.
     1400   end procedure.
     1401   function waitfram-join-function returns character
     1402     (input p-line-1 as character
     1403     ,input p-line-2 as character
     1404     ,input p-line-3 as character
     1405     ).
     1406     define variable v-message as character no-undo .
     1407     run waitfram-join in this-procedure
     1408       (input  p-line-1
     1409       ,input  p-line-2
     1410       ,input  p-line-3
     1411       ,output v-message
     1412       ) .
     1413     return v-message .
     1414   end function .
