     1547           .
     1548           CREATE FILL-IN C-hour1 IN WIDGET-POOL "My-pool"
     1549             ASSIGN
     1550               FRAME = FRAME hour:HANDLE
     1551               DATA-TYPE = "CHARACTER"
     1552               FORMAT = "X(":U + string(l-col-len) + ")":U
     1553               PRIVATE-DATA =  l-col-format + chr(4) + l-col-type
     1554               ROW = 1
     1555               COLUMN = l-col-pos
