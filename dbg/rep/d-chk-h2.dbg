     2900                   (chk-h.hour[17] <> 0) OR (chk-h.hour[18] <> 0) OR (chk-h.hour[19] <> 0) OR (chk-h.hour[20] <> 0) OR
     2901                   (chk-h.hour[21] <> 0) OR (chk-h.hour[22] <> 0) OR (chk-h.hour[23] <> 0) OR (chk-h.hour[24] <> 0) then do:
     2902     if use-column[1]
