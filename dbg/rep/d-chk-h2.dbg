     2896               if (chk-h.hour[1] <> 0) OR (chk-h.hour[2]<> 0) OR (chk-h.hour[3]<> 0) OR (chk-h.hour[4]<> 0) OR
     2897                   (chk-h.hour[5] <> 0) OR (chk-h.hour[6] <> 0) OR (chk-h.hour[7] <> 0) OR (chk-h.hour[8] <> 0) OR
