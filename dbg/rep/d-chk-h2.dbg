     1540             ASSIGN
     1541               FRAME = FRAME top-Frame:HANDLE
     1542               ROW = 4
     1543               COLUMN = l-col-pos
     1544               screen-value = Fill("-", l-col-len)
     1545               WIDTH-CHARS = l-col-len
