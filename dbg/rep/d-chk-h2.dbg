      323   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      324   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      325     (input  v-report-name
      326     ,input  2
      327     ,output v-exist
      328     )  .
      329       if NOT v-exist then
      330       DO:
      331         Message
      332           "Нет заданий на печать ! "
      333           view-as alert-box .
      334         Return  .
      335       End.
      336       run gbl/prnfilen.w
      337         (input  ""
      338         ,input  p-DisabledOptions
      339         ,input  string(v-report-name )
      340         ,input  7
      341         ,output v-user-action
      342         ,output v-printed
      343         ) .
      344       if v-printed then
      345       do:
      346         return "YES" .
      347       end.
      348       else
      349       do:
      350         return "NO" .
      351       end.
      352     end.
      353   end procedure.
      354   procedure prn-lib-open-stream :
      355     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      356     define input parameter p-page-size    as integer no-undo .
      357     define input parameter p-is-stream    as logical no-undo .
      358     define input parameter p-append       as logical no-undo .
      359     define variable v-report-name as character no-undo .
      360     do
      361       on error undo, return error
      362       :
      363       run prn-lib-get-report-name  in this-procedure (
      364         input parParentProc
      365         ,output v-report-name
      366         ).
      367       if p-is-stream then
      368       do:
      369         if p-append then
      370         do:
      371           output stream PrnLibStream to value( v-report-name )
      372             page-size value(p-page-size) append .
      373         end.
      374         if not p-append then
      375         do:
      376           output stream PrnLibStream to value( v-report-name )
      377             page-size value(p-page-size) .
      378         end.
      379       end.
      380       if not p-is-stream then
      381       do:
      382         if p-append then
      383         do:
      384           output to value( v-report-name )
      385             page-size value(p-page-size) append .
      386         end.
      387         if not p-append then
      388         do:
      389           output to value( v-report-name )
      390             page-size value(p-page-size) .
      391         end.
      392       end.
      393     end.
      394   end procedure.
      395   procedure prn-lib-open-exp :
      396     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      397     define input parameter p-is-stream    as logical no-undo .
      398     define input parameter p-is-append    as logical no-undo .
      399     define output parameter p-ReportFileName as char init "report" no-undo.
      400     define output parameter p-process as logical no-undo .
      401     define variable glog as logical no-undo .
      402     do
      403       on error undo, return error
      404       :
      405       SYSTEM-DIALOG GET-FILE p-ReportFileName
      406         TITLE      "Укажите путь"
      407         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      408         ASK-OVERWRITE
      409         CREATE-TEST-FILE
      410         SAVE-AS
      411         USE-FILENAME
      412         DEFAULT-EXTENSION "txt"
      413         UPDATE glog
      414         .
      415       if not glog then  return.
      416       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      417       if p-is-stream then
      418       do:
      419         if p-is-append then
      420         do:
      421           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      422         end.
      423         else
      424         do:
      425           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      426         end.
      427       end.
      428       else
      429       do:
      430         if p-is-append then
      431         do:
      432           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      433         end.
      434         else
      435         do:
      436           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      437         end.
      438       end.
      439       p-process = yes.
      440     end.
      441   end procedure.
      442   procedure prn-lib-get-report-name :
      443     define input parameter parParentProc  as widget-handle no-undo.
      444     define output parameter p-report-name as character no-undo .
      445     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      446   end procedure.
      447   procedure prn-lib-reportviewer-report-name :
      448     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      449     define input parameter p-report-name-html as character no-undo .
      450     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      451   end procedure.
      452   procedure prn-lib-reportviewer :
      453     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      454     define input parameter p-report-name-html as character no-undo .
      455     define input parameter p-param        as character no-undo .
      456     define variable v-excel           as character no-undo init 'TRUE' .
      457     define variable v-value-character as character no-undo .
      458     define variable v-value-integer   as character no-undo .
      459     define variable v-value-date      as date      no-undo .
      460     define variable v-value-decimal   as decimal   no-undo .
      461     define variable rep-excel         as logical   no-undo .
      462     define variable excel-string      as character no-undo .
      463     define variable v-param-type      as character no-undo .
      464     define variable v-tth             as handle    no-undo .
      465     run adm/shattri.p (
      466       input "get":U
      467       ,input  ""
      468       ,input  0
      469       ,input  'report-glob':U
      470       ,input  'rep-excel':U
      471       ,output v-value-character
      472       ,output v-value-date
      473       ,output v-value-decimal
      474       ,output v-value-integer
      475       ,output rep-excel
      476       ,output v-param-type
      477       ,INPUT-OUTPUT table-handle v-tth
      478       )  .
      479     if rep-excel then v-excel = "TRUE" .
      480     else v-excel = "FALSE" .
      481     if p-param eq ""
      482     then
      483        p-param = "EXCEL:" + v-excel.
      484     else
      485        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      486     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      487   end procedure.
