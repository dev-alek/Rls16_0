     1517     define variable ll-2 as handle no-undo.
     1518     define variable c-hour1 as widget-handle no-undo.
     1519      if l-col-pos > 320 then l-col-pos = 320 .
     1520     if use-column[2] = true then DO:
     1521           CREATE EDITOR LL-2 IN WIDGET-POOL "My-pool"
     1522             ASSIGN
     1523               FRAME = FRAME top-Frame:HANDLE
     1524               ROW = 1
     1525               COLUMN = l-col-pos
     1526               screen-value = Fill("-", l-col-len)
     1527               WIDTH-CHARS = l-col-len
     1528               HEIGHT-CHARS = 3
     1529           .
