      308   define  stream PrnLibStream.
      309   procedure prn-lib-prn-file :
      310     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      311     define input parameter p-DIsabledoptions as integer no-undo .
      312     define variable v-report-name as character no-undo .
      313     define variable v-user-action as character no-undo .
      314     define variable v-printed     as logical   no-undo .
      315     define variable v-exist       as logical   no-undo .
      316     do
      317       on error undo, return error
      318       :
