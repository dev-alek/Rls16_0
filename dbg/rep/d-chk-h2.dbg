      990   define variable l-col-type         as character no-undo .
      991   define variable l-col-pos          as integer no-undo .
      992   define variable l-col-len          as integer no-undo .
      993   define variable l-col-format       as character no-undo .
      994   define variable l-col-lable        as character no-undo .
      995   define variable v-dec-sep          as character no-undo init ? .
      996   define variable v-th-sep           as character no-undo init ? .
      997   define variable v-r-col-num        as integer no-undo .
      998   define variable v-reg-replace      as logical no-undo .
      999   define variable v-date-col-format  as character no-undo .
     1000   DEFINE VARIABLE last-col-num as integer no-undo.
     1001   run gbl/getlocal.p (
     1002                     output v-dec-sep
     1003                    ,output v-th-sep
     1004                    ,output v-sdate
     1005                    ,output v-shortdate
     1006                    ) no-error .
     1007   assign
     1008   v-reg-replace = NOT (v-dec-sep = ".":U and v-th-sep = chr(44))
     1009                   AND (v-dec-sep <> ? and v-th-sep <> ?)
     1010   .
     1011     FUNCTION supress-null RETURNS CHARACTER ( INPUT p-string  AS CHARACTER,
     1012                                               INPUT p-dec-sep AS CHARACTER  ) :
     1013       DEFINE VARIABLE v-string AS CHARACTER NO-UNDO.
     1014       IF TRIM( p-string ) = "0"                    OR
     1015          TRIM( p-string ) = "0" + p-dec-sep + "00" OR
     1016          TRIM( p-string ) =       p-dec-sep + "00" OR
     1017          TRIM( p-string ) =       p-dec-sep + "0"  OR
     1018          TRIM( p-string ) = "0" + p-dec-sep + "0"  THEN DO: ASSIGN v-string = "":U.     END.
     1019                                                    ELSE DO: ASSIGN v-string = p-string. END.
     1020       RETURN ( TRIM( v-string ) ).
     1021     END FUNCTION.
     1022   FUNCTION reg-output returns character( input p-string as character
     1023                                         ,input p-private-data as character
     1024                                         ,input p-replace as logical
     1025                                         ,input p-supress as logical
     1026                                         ,input p-dec-sep as character
     1027                                         ,input p-th-sep as character
     1028                                         ):
     1029   DEFINE VARIABLE v-reg-output as character no-undo .
     1030   DEFINE VARIABLE v-data-type as character no-undo .
     1031   DEFINE VARIABLE v-progress-format as character no-undo .
     1032   assign
     1033   v-progress-format = entry(1, p-private-data, chr(4))
     1034   v-data-type = entry(2, p-private-data, chr(4))
     1035   .
     1036   if p-string = ? then return chr(63).
     1037   if (v-data-type = "INTEGER"
     1038       OR v-data-type = "DECIMAL" ) THEN DO:
     1039     IF p-replace THEN DO:
     1040       assign
     1041         v-reg-output = replace( p-string
     1042                                         ,chr(44)
     1043                                         ,"":U
     1044                                       )
     1045         v-reg-output = trim(v-reg-output)
     1046       .
     1047     END.
     1048     else do:
     1049       v-reg-output = p-string.
     1050     end.
     1051     IF p-supress THEN DO: ASSIGN v-reg-output = supress-null( TRIM( v-reg-output ), p-dec-sep ). END.
     1052     return v-reg-output.
     1053   end.
     1054     return p-string.
     1055   END FUNCTION.
     1056   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
