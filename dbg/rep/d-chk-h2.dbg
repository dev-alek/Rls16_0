     2714   Line = fill( "-" , 60 ) .
     2715   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2716   run waitfram-show in this-procedure ("Строю дерево групп ...").
     2717   if rs-option = 3 then do:
     2718     create full-grp.
     2719     assign
     2720     full-grp.grp-code = 0
     2721     full-grp.full-name = "По всем группам товаров".
     2722   end.
     2723   else do:
     2724     for each ub.gds-grp no-lock:
     2725       find first for-grp where
     2726                 for-grp.upper-code = ub.gds-grp.node-code No-LOCK No-ERROR.
     2727       if not avail for-grp then do:
     2728         create full-grp.
     2729         assign full-grp.grp-code = ub.gds-grp.node-code.
     2730         run grplib-get-full-name in this-procedure(input ub.gds-grp.node-code, output full-grp.full-name).
     2731       end.
     2732     end.
     2733   end.
     2734   run waitfram-hide in this-procedure .
     2735   if nc > 12 then do:
     2736   run prn-lib-open-stream  in this-procedure (
     2737                                                input parParentProc
     2738                                               ,input 62
     2739                                               ,input yes
     2740                                               ,input no
     2741                                               ).
     2742   end.
     2743   else do:
     2744   run prn-lib-open-stream  in this-procedure (
     2745                                                input parParentProc
     2746                                               ,input 43
     2747                                               ,input yes
     2748                                               ,input no
     2749                                               ).
     2750   end.
     2751   FORM with FRAME Hour .
     2752   FORM HEADER
     2753   Line format "X(60)" AT 1 SKIP
     2754   "Продолжение - на следующей странице" AT 10 SKIP
     2755   with FRAME NBottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     2756   VIEW stream PrnLibStream FRAME NBottomFrame .
     2757   PUT stream PrnLibStream
     2758   SPACE(10)
     2759   ("Почасовая статистика по количеству ПОКУПОК ЗА ПЕРИОД c " +
     2760   string( startdate, "99/99/9999" ) + " по " + string( enddate, "99/99/9999" ) + ".")      format "x(110)" SKIP(1).
     2761   if t-dis-card then do:
     2762     PUT stream PrnLibStream UNFORMATTED
     2763     SPACE(10)
     2764     "Только покупки по дисконтным картам" skip.
     2765     if rs-dis-card = 1 then do:
     2766       for each temp-dis-card-type No-LOCK:
     2767         PUT stream PrnLibStream UNFORMATTED
     2768         SPACE(10)
     2769         temp-dis-card-type.type
     2770         skip.
     2771       END.
     2772     end.
     2773   end.
     2774   PUT stream PrnLibStream UNFORMATTED
     2775   SPACE(10) SelectObject  SKIP(0)
     2776   by-object-str skip(1)
     2777   .
     2778   display STREAM PrnLibStream with frame top-Frame .
     2779   _cycle:
     2780   do cycle = 1 to 0 by -1:
     2781     if byobject and cycle = 0 and accum-obj-list = 1 then LEAVE _cycle.
     2782     _obj-list:
     2783     for each obj-list no-lock:
     2784       obj-count = obj-count + 1.
     2785       if not byobject and cycle = 1 then LEAVE _obj-list.
     2786       if cycle = 1 then v-obj-code = obj-list.obj-code.
     2787       if cycle = 0 then v-obj-code = 0.
     2788       if cycle = 1 then do:
     2789         FIND FIRST ub.clients NO-LOCK WHERE
     2790                   ub.clients.obj-code = v-obj-code AND
     2791                   ub.clients.obj-type = 'маг':U NO-ERROR.
     2792         if available clients then do:
     2793           v-obj-name = ub.clients.obj-name.
     2794         end.
     2795         else v-obj-name = string(v-obj-code).
     2796       end.
     2797       if byobject and cycle = 0 then do:
     2798         v-obj-name = "ПО ВСЕМ ОБЪЕКТАМ".
     2799       end.
     2800       if rs-option <> 3 and byobject then do:
     2801     if use-column[1]
     2802     then  C-full-name:screen-value = string(v-obj-name, entry(1, c-full-name:private-data, chr(4))).
     2803         DISPLAY stream  PrnLibStream with frame HOUR.                                      DOWN 1 stream PrnLibStream with frame HOUR.
     2804     if use-column[1]
     2805     then  C-full-name:screen-value = string(fill56).
