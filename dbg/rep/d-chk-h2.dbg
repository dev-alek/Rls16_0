      561   procedure create_obj-list :
      562      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      563      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      564      do
      565      on error undo, return error return-value
      566      :
      567         define buffer cli-obj for ub.clients .
      568         define variable p-var as integer no-undo .
      569         define buffer buf_obj-list for obj-list .
      570         find last buf_obj-list  use-index pi no-error .
      571         if available buf_obj-list
      572         then
      573            p-var = buf_obj-list.obj-id + 1.
      574         else
      575            p-var = 1.
      576         find first cli-obj where
      577                   cli-obj.obj-type = p-obj-type
      578               and cli-obj.obj-code = p-obj-code
      579         no-lock no-error.
      580         if available cli-obj
      581         then do:
      582            create buf_obj-list.
      583            assign
      584               buf_obj-list.obj-id   = p-var
      585               buf_obj-list.obj-code = cli-obj.obj-code
      586               buf_obj-list.obj-type = cli-obj.obj-type
      587               buf_obj-list.obj-name = cli-obj.obj-name
      588               buf_obj-list.db-num   = cli-obj.db-num
      589            .
      590         end.
      591      end.
      592   end.
