        1   block-level on error undo, throw.
        2   define temp-table  tt-dateZakaz     no-undo
        3   field id as integer
        4   field dateStart as date
        5   field dateEnd as date
        6   index pi id
        7       .
        8   DEFINE TEMP-TABLE tt-typeDocChoose NO-UNDO
        9     field type-code as character
       10     field typeName  as character.
       11   define temp-table gds-list like ub.goods
       12     field minZapas as decimal
       13     field contract as character
       14     field contract-code as integer
       15     field price as decimal
       16     field doc-qnty as decimal
       17     index pi contract gds-code.
       18    define temp-table choose-gds-list like ub.goods
       19     field minZapas as decimal
       20     field contract as character
       21     field contract-code as integer
       22     field price as decimal
       23     field doc-qnty as decimal
       24     index pi contract gds-code.
       25     define temp-table tt-gds-list like ub.goods
       26     field contract-code as integer
       27     field price as decimal
       28     field doc-qnty as decimal
       29     index pi gds-code.
       30   define input parameter parparentproc as handle    no-undo .
       31   define input parameter iDateOrder    as date      no-undo.
       32   define input parameter iClientType   like ub.clients.obj-type no-undo.
       33   define input parameter iClientCode   like ub.clients.obj-code no-undo.
       34   define input parameter iParams       as character             no-undo.
       35   define variable vss-revision    as character no-undo init "$Revision: 8f5f559ebdb3, 2359, rls $":U .
       36   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
       37   define variable vss-date        as character no-undo init "$Date: Ср июн 10 21:13:34 2020 +0300 $":U .
       38   define variable vss-workfile    as character no-undo init "$Workfile: r-rsrv-plan.p $":U .
       39   define variable vss-archive     as character no-undo init "$Archive: rep/r-rsrv-plan.p $":U .
       40   define variable vss-description as character no-undo init "Отчет по планированию заказов".
       41   procedure vss-get-info :
       42     define output parameter p-vss-revision    like vss-revision    no-undo .
       43     define output parameter p-vss-author      like vss-author      no-undo .
       44     define output parameter p-vss-date        like vss-date        no-undo .
       45     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       46     define output parameter p-vss-archive     like vss-archive     no-undo .
       47     define output parameter p-vss-description like vss-description no-undo .
       48     assign
       49       p-vss-revision    = vss-revision
       50       p-vss-author      = vss-author
       51       p-vss-date        = vss-date
       52       p-vss-workfile    = vss-workfile
       53       p-vss-archive     = vss-archive
       54       p-vss-description = vss-description
       55     .
       56   end procedure.
       57   procedure vss-get-parameters :
       58     define output parameter p-vss-parameters as character no-undo .
       59   end procedure.
       60   define new global shared variable g#vssrevis-logger as handle    no-undo .
       61   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       62   define variable v-vssrevis-logger                   as handle    no-undo .
       63   procedure vss-logevent :
       64     define input  parameter p-extra-paramters as character no-undo .
       65     define variable v-vssrevis-parameters as character no-undo .
       66     do
       67     on error undo, return error return-value
       68     :
       69       if  valid-handle(v-vssrevis-logger)
       70       and v-vssrevis-logger :get-signature("logevent") <> ""
       71       then do:
       72         run vss-get-parameters in this-procedure
       73           (output v-vssrevis-parameters
       74           ).
       75         run logevent in v-vssrevis-logger
       76           (input vss-workfile
       77           ,input vss-revision
       78           ,input v-vssrevis-parameters
       79           ,input p-extra-paramters
       80           ).
       81       end.
       82     end.
       83   end procedure.
       84   assign
       85     v-vssrevis-logger = g#vssrevis-logger
       86   .
       87   if  valid-handle(v-vssrevis-logger)
       88   and v-vssrevis-logger :get-signature("logevent") <> ""
       89   then do:
       90     assign
       91       v-vssrevis-logevent = true
       92     .
       93     run vss-logevent in this-procedure (input vss-description) .
       94   end.
       95   define new global shared variable g#language as character no-undo .
       96   if g#language <> '' and g#language <> 'rus':U then do:
       97     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       98   end.
       99   define new global shared variable g#library  as handle no-undo .
      100   define new global shared variable g#library2 as handle no-undo .
      101   define   shared variable g#auto as logical no-undo.
      102   define   shared variable g#news as logical no-undo.
      103   define   shared variable g#oxml as logical no-undo.
      104   define   shared variable g#esys as logical no-undo.
      105   define   shared variable g#news-source-db as integer no-undo.
      106   define   shared variable g#esys-source-esys as integer no-undo.
      107   define   shared variable g#db-num as integer   no-undo .
      108   define   shared variable g#userid as character no-undo .
      109   define   shared variable g#passwd as character no-undo .
      110   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      111     define variable v-cntxt-db-num        as integer   no-undo .
      112     define variable v-cntxt-userid        as character no-undo .
      113     define variable v-cntxt-level         as character no-undo .
      114     define variable v-cntxt-host-code-obj as integer   no-undo .
      115     define variable v-cntxt-obj-type      as character no-undo .
      116     define variable v-cntxt-obj-code      as integer   no-undo .
      117     define variable v-cntxt-db-num-obj    as integer   no-undo .
      118     define variable v-cntxt-is-admin      as logical   no-undo .
      119   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      120     run mainmenu_getcntxt in parparentproc
      121       (output v-cntxt-db-num
      122       ,output v-cntxt-userid
      123       ,output v-cntxt-level
      124       ,output v-cntxt-host-code-obj
      125       ,output v-cntxt-obj-type
      126       ,output v-cntxt-obj-code
      127       ,output v-cntxt-db-num-obj
      128       ,output v-cntxt-is-admin
      129       ) .
      130   define variable mySeqOrder as int64 no-undo init ?.
      131   procedure MySeqForOrder:
      132      define input  parameter iTable      as character no-undo.
      133      define input  parameter iSeqNameHist as character no-undo.
      134      define input  parameter iDbName     as character no-undo.
      135      define output parameter oSeq        as int64 no-undo.
      136      if iTable begins "order-"
      137      then do:
      138         if mySeqOrder eq ?
      139         then
      140            mySeqOrder = dynamic-next-value(iSeqNameHist,iDbName).
      141         oSeq = mySeqOrder.
      142      end.
      143      else
      144         oSeq = ?.
      145      return.
      146   end.
      147   define  shared temp-table tt-zakaz like ub.order-line
      148       field gds-name          as character
      149       field minZapas          as decimal
      150       field volMinZapas       as integer
      151       field ostatokDay        as decimal
      152       field qntyDaySale       as integer
      153       field qntyDayGoods      as integer
      154       field ostatokGoods      as decimal
      155       field qntyDay           as integer
      156       field contract-prn-code as character
      157       field contract-code     as integer
      158       index pi    gds-code          contract-code
      159       index artic artic             prod-type         prod-code
      160       index contr contract-prn-code.
      161   define  shared temp-table temp-gds-qnty no-undo
      162       field day      as date
      163       field ost      as decimal
      164       field gds-code as integer
      165       index pi is unique primary day gds-code
      166       index by-ost               ost .
      167   define variable vDocCode as integer no-undo.
      168   define variable vLine    as integer no-undo.
      169   define buffer buf_order-doc       for ub.order-doc .
      170   define buffer buf_order-line      for ub.order-line .
      171   define buffer buf_clients         for ub.clients .
      172   define buffer buf_goods           for ub.goods .
      173   define buffer buf_contract-specif for ub.contract-specif .
      174   define variable orderStatus  as class ibs.th.str.order.sts.order no-undo .
      175   orderStatus =  new ibs.th.str.order.sts.order().
      176   if not can-find (first tt-zakaz) then
      177     return.
      178   MAIN:
      179   do transaction on error undo MAIN, leave MAIN:
      180       find first buf_clients no-lock where
      181                  buf_clients.obj-type = iClientType
      182              and buf_clients.obj-code = iClientCode.
      183       for each tt-zakaz no-lock
      184                break by tt-zakaz.contract-code by tt-zakaz.gds-code:
      185         if first-of(tt-zakaz.contract-code) then
      186         do:
      187           subscribe "getNextseq" anywhere run-procedure "MySeqForOrder".
      188           create buf_order-doc.
      189           assign
      190             vDocCode                        = next-value (s-order-code, ub)
      191             buf_order-doc.obj-type          = v-cntxt-obj-type
      192             buf_order-doc.obj-code          = v-cntxt-obj-code
      193             buf_order-doc.doc-code          = vDocCode
      194             buf_order-doc.doc-date          = now
      195             buf_order-doc.order-date        = today + 1
      196             buf_order-doc.cli-type          = iClientType
      197             buf_order-doc.cli-code          = iClientCode
      198             buf_order-doc.cli-name          = if avail buf_clients then buf_clients.obj-name else ""
      199             buf_order-doc.contract-code     = tt-zakaz.contract-code
      200             buf_order-doc.contract-prn-code = tt-zakaz.contract-prn-code
      201             buf_order-doc.user-id           = v-cntxt-userid
      202             buf_order-doc.sts               = orderStatus:NewStatus:KeyIntDB
      203             buf_order-doc.params            = iParams
      204           .
      205           validate buf_order-doc.
      206         end.
      207         else do:
      208           find first buf_order-doc exclusive-lock where
      209                      buf_order-doc.db-num   = g#db-num
      210                  and buf_order-doc.doc-code = vDocCode no-error.
      211           if not avail  buf_order-doc then
      212           do:
      213             message "Ошибка при создании заказа. Заказы созданы не будут." view-as alert-box.
      214             undo MAIN, leave MAIN.
      215           end.
      216         end.
      217         find first buf_goods no-lock where
      218                    buf_goods.gds-code = tt-zakaz.gds-code.
      219         create buf_order-line.
      220         assign
      221            vLine = vLine + 1
      222            buf_order-line.doc-code      = buf_order-doc.doc-code
      223            buf_order-line.db-num        = buf_order-doc.db-num
      224            buf_order-line.line-num      = vLine
      225            buf_order-line.gds-code      = tt-zakaz.gds-code
      226            buf_order-line.artic         = tt-zakaz.artic
      227            buf_order-line.prod-type     = if avail buf_goods then buf_goods.prod-type else ""
      228            buf_order-line.prod-code     = if avail buf_goods then buf_goods.prod-code else 0
      229            buf_order-line.order-qnty    = tt-zakaz.order-qnty
      230            buf_order-line.fact-qnty     = tt-zakaz.order-qnty
      231            buf_order-line.rest          = tt-zakaz.rest
      232            buf_order-line.sales         = tt-zakaz.sales
      233            buf_order-line.average-sales = tt-zakaz.average-sales
      234            buf_order-line.stock-goods   = if tt-zakaz.average-sales = 0 and tt-zakaz.ostatokDay <> 0 then -1 else integer(tt-zakaz.ostatokGoods)
      235            buf_order-line.volume-goods  = tt-zakaz.volume-goods
      236            buf_order-line.volume-stock  = if tt-zakaz.minZapas > tt-zakaz.rest then tt-zakaz.minZapas else tt-zakaz.volMinZapas
      237            buf_order-line.min-stock     = tt-zakaz.min-stock
      238            buf_order-line.garant-stock  = tt-zakaz.garant-stock
      239            buf_order-line.promo         = tt-zakaz.promo
      240         .
      241         validate buf_order-line.
      242         validate buf_order-doc.
      243         if last-of(tt-zakaz.contract-code) then
      244         do:
      245           unsubscribe "getNextseq".
      246         end.
      247       end.
      248   end.
