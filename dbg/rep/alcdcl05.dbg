     2182   define variable v-fmtcli-kpp           as character    no-undo.
     2183   define variable v-fmtcli-okpo          as character    no-undo.
     2184   define variable v-fmtcli-country       as character    no-undo.
     2185   define variable v-fmtcli-city          as character    no-undo.
     2186   define variable v-fmtcli-index         as character    no-undo.
     2187   define variable v-fmtcli-schet-exists  as logical      no-undo.
     2188   define variable v-fmtcli-bank-exists   as logical      no-undo.
     2189   define variable v-fmtcli-bank-r-schet  as character    no-undo.
     2190   define variable v-fmtcli-bank-c-schet  as character    no-undo.
     2191   define variable v-fmtcli-bank-bik      as character    no-undo.
     2192   define variable v-fmtcli-bank-name     as character    no-undo.
     2193   define variable v-fmtcli-bank-addres   as character    no-undo.
     2194   define variable v-fmtcli-bank-city     as character    no-undo.
     2195   procedure fmtcli-get-bank :
     2196   define input parameter p-host-code      as integer          no-undo.
     2197   define input parameter p-obj-type       as character        no-undo.
     2198   define input parameter p-obj-code       as integer          no-undo.
     2199   define input parameter p-curr-code      as integer          no-undo.
     2200       define buffer buf_fin-schet     for ub.fin-schet.
     2201       define buffer buf_fin-bank      for ub.fin-bank.
     2202   do
     2203   for buf_fin-schet
     2204     , buf_fin-bank
     2205   on error undo, return error
     2206   :
     2207       assign
     2208           v-fmtcli-schet-exists       = no
     2209           v-fmtcli-bank-exists        = no
     2210           v-fmtcli-bank-r-schet       = "":U
     2211           v-fmtcli-bank-c-schet       = "":U
     2212           v-fmtcli-bank-bik           = "":U
     2213           v-fmtcli-bank-name          = "":U
     2214           v-fmtcli-bank-addres        = "":U
     2215           v-fmtcli-bank-city          = "":U
     2216       .
     2217       search-for-schet:
     2218       for each buf_fin-schet no-lock
     2219          where buf_fin-schet.host-code = p-host-code
     2220            and buf_fin-schet.cli-type  = p-obj-type
     2221            and buf_fin-schet.cli-code  = p-obj-code
     2222            and buf_fin-schet.curr-code = p-curr-code
     2223       on error undo, return error
     2224       :
     2225           if buf_fin-schet.status_   = 'удал':U
     2226           then do:
     2227           end.
     2228           else do:
     2229               assign
     2230                   v-fmtcli-schet-exists   = yes
     2231                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
     2232                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
     2233               .
     2234               find first buf_fin-bank no-lock
     2235                    where buf_fin-bank.host-code = p-host-code
     2236                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
     2237               no-error.
     2238               if available buf_fin-bank
     2239               then do:
     2240                   assign
     2241                       v-fmtcli-bank-exists      = yes
     2242                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
     2243                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
     2244                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
     2245                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
     2246                   .
     2247               end.
     2248               else do:
     2249                   assign
     2250                       v-fmtcli-bank-exists    = no
     2251                       v-fmtcli-bank-bik       = "":U
     2252                       v-fmtcli-bank-name      = "":U
     2253                       v-fmtcli-bank-addres    = "":U
     2254                       v-fmtcli-bank-city      = "":U
     2255                   .
     2256               end.
     2257               leave search-for-schet.
     2258           end.
     2259       end.
     2260   end.
     2261   end procedure.
     2262   procedure fmtcli-get-client :
     2263   define input parameter p-obj-type       as character    no-undo.
     2264   define input parameter p-obj-code       as integer      no-undo.
     2265       define variable v-temp-fmtcli-address      as character     no-undo.
     2266       define variable v-num-country-city    as integer      no-undo.
     2267       define buffer buf_clients   for ub.clients.
     2268       define buffer buf_firm      for ub.firm.
     2269       define buffer buf_store     for ub.store.
     2270       define buffer buf_shop      for ub.shop.
     2271       define buffer buf_person    for ub.person.
     2272   do
     2273   for buf_clients
     2274     , buf_firm
     2275     , buf_store
     2276     , buf_shop
     2277     , buf_person
     2278   on error undo, return error
     2279   :
     2280       assign
     2281           v-fmtcli-name           = "":U
     2282           v-fmtcli-addres         = "":U
     2283           v-fmtcli-post-addres    = "":U
     2284           v-fmtcli-full-addres    = "":U
     2285           v-fmtcli-phone          = "":U
     2286           v-fmtcli-inn            = "":U
     2287           v-fmtcli-kpp            = "":U
     2288           v-fmtcli-okpo           = "":U
     2289           v-fmtcli-city           = "":U
     2290           v-fmtcli-index          = "":U
     2291           v-fmtcli-country        = "":U
     2292       .
     2293       find first buf_clients no-lock
     2294            where buf_clients.obj-type = p-obj-type
     2295              and buf_clients.obj-code = p-obj-code
     2296       .
     2297       assign
     2298           v-fmtcli-name = buf_clients.obj-name
     2299       .
     2300       case buf_clients.obj-type:
     2301          when 'орг':U
     2302          then do:
     2303               find first buf_firm no-lock
     2304                    where buf_firm.firm-code = buf_clients.obj-code
     2305                    no-error
     2306               .
     2307               if available buf_firm
     2308               then do:
     2309                   assign
     2310                       v-num-country-city = num-entries( buf_firm.city )
     2311                       v-fmtcli-engl-name = buf_firm.engl-name
     2312                   .
     2313                   if v-num-country-city > 0
     2314                   then do:
     2315                       assign
     2316                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
     2317                       .
     2318                   end.
     2319                   if v-num-country-city > 1
     2320                   then do:
     2321                       assign
     2322                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
     2323                       .
     2324                   end.
     2325                   run fmtcli-concatenate-strings in this-procedure (
     2326                         input v-fmtcli-full-addres
     2327                       , input v-fmtcli-country
     2328                       , input ", ":U
     2329                       , input 50
     2330                       , output v-fmtcli-full-addres
     2331                   ).
     2332                   run fmtcli-concatenate-strings in this-procedure (
     2333                         input v-fmtcli-full-addres
     2334                       , input v-fmtcli-city
     2335                       , input ", ":U
     2336                       , input 50
     2337                       , output v-fmtcli-full-addres
     2338                   ).
     2339                   run fmtcli-concatenate-strings in this-procedure (
     2340                         input v-fmtcli-full-addres
     2341                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
     2342                       , input ", ":U
     2343                       , input 50
     2344                       , output v-fmtcli-full-addres
     2345                   ).
     2346                   run fmtcli-concatenate-strings in this-procedure (
     2347                         input v-fmtcli-post-addres
     2348                       , input v-fmtcli-country
     2349                       , input ", ":U
     2350                       , input 50
     2351                       , output v-fmtcli-post-addres
     2352                   ).
     2353                   run fmtcli-concatenate-strings in this-procedure (
     2354                         input v-fmtcli-post-addres
     2355                       , input v-fmtcli-city
     2356                       , input ", ":U
     2357                       , input 50
     2358                       , output v-fmtcli-post-addres
     2359                   ).
     2360                   run fmtcli-concatenate-strings in this-procedure (
     2361                         input v-fmtcli-post-addres
     2362                       , input string( buf_firm.ind )
     2363                       , input ", ":U
     2364                       , input 50
     2365                       , output v-fmtcli-post-addres
     2366                   ).
     2367                   run fmtcli-concatenate-strings in this-procedure (
     2368                         input substring( buf_firm.addres1, 1, 50 )
     2369                       , input buf_firm.addres2
     2370                       , input " ":U
     2371                       , input 50
     2372                       , output v-temp-fmtcli-address
     2373                   ).
     2374                   run fmtcli-concatenate-strings in this-procedure (
     2375                         input v-temp-fmtcli-address
     2376                       , input substring( buf_firm.addres1, 51, 50 )
     2377                       , input " ":U
     2378                       , input 50
     2379                       , output v-temp-fmtcli-address
     2380                   ).
     2381                   run fmtcli-concatenate-strings in this-procedure (
     2382                         input v-temp-fmtcli-address
     2383                       , input substring( buf_firm.addres1, 101, 50 )
     2384                       , input " ":U
     2385                       , input 50
     2386                       , output v-temp-fmtcli-address
     2387                   ).
     2388                   assign
     2389                       v-fmtcli-addres = v-temp-fmtcli-address
     2390                   .
     2391                   if buf_firm.addres1 <> ?
     2392                   then do:
     2393                       run fmtcli-concatenate-strings in this-procedure (
     2394                             input v-fmtcli-full-addres
     2395                           , input v-fmtcli-addres
     2396                           , input ", ":U
     2397                           , input 0
     2398                           , output v-fmtcli-full-addres
     2399                       ).
     2400                   end.
     2401                   run fmtcli-concatenate-strings in this-procedure (
     2402                         input substring( buf_firm.post-addr1, 1, 50 )
     2403                       , input buf_firm.post-addr2
     2404                       , input " ":U
     2405                       , input 50
     2406                       , output v-fmtcli-post-addres
     2407                   ).
     2408                   run fmtcli-concatenate-strings in this-procedure (
     2409                         input v-fmtcli-post-addres
     2410                       , input substring( buf_firm.post-addr1, 51, 50 )
     2411                       , input " ":U
     2412                       , input 50
     2413                       , output v-fmtcli-post-addres
     2414                   ).
     2415                   run fmtcli-concatenate-strings in this-procedure (
     2416                         input v-fmtcli-post-addres
     2417                       , input substring( buf_firm.post-addr1, 101, 50 )
     2418                       , input " ":U
     2419                       , input 50
     2420                       , output v-fmtcli-post-addres
     2421                   ).
     2422                   assign
     2423                       v-fmtcli-phone         = buf_firm.phone
     2424                       v-fmtcli-inn           = buf_firm.inn
     2425                       v-fmtcli-kpp           = buf_firm.kpp
     2426                       v-fmtcli-okpo          = buf_firm.okpo
     2427                       v-fmtcli-index         = string( buf_firm.ind )
     2428                   .
     2429               end.
     2430          end.
     2431          when 'маг':U
     2432          then do:
     2433               find first buf_shop no-lock
     2434                    where buf_shop.obj-code = buf_clients.obj-code
     2435               .
     2436               if available buf_shop
     2437               then do:
     2438                   run fmtcli-concatenate-strings in this-procedure (
     2439                         input buf_shop.addres1
     2440                       , input buf_shop.addres2
     2441                       , input " ":U
     2442                       , input 50
     2443                       , output v-fmtcli-addres
     2444                   ).
     2445                   assign
     2446                       v-fmtcli-full-addres = v-fmtcli-addres
     2447                       v-fmtcli-post-addres = v-fmtcli-addres
     2448                       v-fmtcli-phone       = buf_shop.phone
     2449                       v-fmtcli-inn         = "":U
     2450                       v-fmtcli-kpp         = "":U
     2451                       v-fmtcli-okpo        = "":U
     2452                       v-fmtcli-city        = "":U
     2453                       v-fmtcli-index       = "":U
     2454                   .
     2455               end.
     2456          end.
     2457          when 'скл':U
     2458          then do:
     2459               find first buf_store no-lock
     2460                    where buf_store.obj-code = buf_clients.obj-code
     2461               .
     2462               if available buf_store
     2463               then do:
     2464                   run fmtcli-concatenate-strings in this-procedure (
     2465                         input buf_store.addres1
     2466                       , input buf_store.addres2
     2467                       , input " ":U
     2468                       , input 50
     2469                       , output v-fmtcli-addres
     2470                   ).
     2471                   assign
     2472                       v-fmtcli-full-addres = v-fmtcli-addres
     2473                       v-fmtcli-phone       = buf_store.phone
     2474                       v-fmtcli-inn         = "":U
     2475                       v-fmtcli-kpp         = "":U
     2476                       v-fmtcli-okpo        = "":U
     2477                       v-fmtcli-city        = "":U
     2478                       v-fmtcli-index       = "":U
     2479                   .
     2480               end.
     2481          end.
     2482          when 'чел':U
     2483          then do:
     2484               find first buf_person no-lock
     2485                    where buf_person.psn-code = buf_clients.obj-code
     2486               .
     2487               if available buf_person
     2488               then do:
     2489                   run fmtcli-concatenate-strings in this-procedure (
     2490                         input ( if buf_person.ind = 0 or buf_person.ind = ?
     2491                                 then "":U
     2492                                 else string( buf_person.ind, "999999")
     2493                                 )
     2494                       , input buf_person.city
     2495                       , input ", ":U
     2496                       , input 0
     2497                       , output v-fmtcli-full-addres
     2498                   ).
     2499                   assign
     2500                       v-fmtcli-addres = buf_person.address
     2501                   .
     2502                   run fmtcli-concatenate-strings in this-procedure (
     2503                         input v-fmtcli-full-addres
     2504                       , input v-fmtcli-addres
     2505                       , input ", ":U
     2506                       , input 0
     2507                       , output v-fmtcli-full-addres
     2508                   ).
     2509                   assign
     2510                       v-fmtcli-phone     = buf_person.phone1
     2511                       v-fmtcli-inn       = buf_person.inn
     2512                       v-fmtcli-kpp       = buf_person.kpp
     2513                       v-fmtcli-okpo      = buf_person.okpo
     2514                       v-fmtcli-city      = buf_person.city
     2515                       v-fmtcli-index     = string( buf_person.ind )
     2516                   .
     2517               end.
     2518          end.
     2519       end case.
     2520   end.
     2521   end procedure.
     2522   procedure fmtcli-concatenate-strings :
     2523   define input parameter p-string-1       as character        no-undo.
     2524   define input parameter p-string-2       as character        no-undo.
     2525   define input parameter p-delimiter      as character        no-undo.
     2526   define input parameter p-length         as integer          no-undo.
     2527   define output parameter p-out-string    as character        no-undo.
     2528   do
     2529   on error undo, return error
     2530   :
     2531       assign
     2532           p-out-string = ( if p-string-1 = ?
     2533                            then "":U
     2534                            else trim( p-string-1 ) )
     2535       .
     2536       assign
     2537           p-out-string = p-out-string
     2538                        + ( if p-out-string = "":U
     2539                            or length( p-out-string ) = p-length
     2540                            or p-string-2 = ?
     2541                            or trim( p-string-2 ) = "":U
     2542                            then "":U
     2543                            else p-delimiter )
     2544                        + ( if p-string-2 = ?
     2545                            or trim( p-string-2 ) = "":U
     2546                            then "":U
     2547                            else trim( p-string-2 ) )
     2548       .
     2549   end.
     2550   end procedure.
     2551   def var vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2552   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     2553   procedure paramls-clear :
     2554     define buffer buf_temp-param for temp-param .
     2555     do
     2556     on error undo, return error return-value
     2557     :
     2558       for each buf_temp-param
     2559       on error undo, return error
     2560       :
     2561         delete buf_temp-param .
     2562       end.
     2563     end.
     2564   end procedure.
     2565   procedure paramls-write :
     2566     define input  parameter p-code     as character no-undo .
     2567     define input  parameter p-sub-code as character no-undo .
     2568     define input  parameter p-value    as character no-undo .
     2569     define buffer buf_temp-param for temp-param .
     2570     do
     2571     on error undo, return error return-value
     2572     :
     2573       find first buf_temp-param
     2574         where buf_temp-param.param-code     = p-code
     2575           and buf_temp-param.param-sub-code = p-sub-code
     2576         no-error .
     2577       if not available buf_temp-param then do:
     2578         create buf_temp-param .
     2579         assign
     2580           buf_temp-param.param-code     = p-code
     2581           buf_temp-param.param-sub-code = p-sub-code
     2582         .
     2583       end.
     2584       assign
     2585         buf_temp-param.param-value = p-value
     2586       .
     2587     end.
     2588   end procedure.
     2589   procedure paramls-read :
     2590     define input  parameter p-code          as character no-undo .
     2591     define input  parameter p-sub-code      as character no-undo .
     2592     define input  parameter p-default-value as character no-undo .
     2593     define output parameter p-value         as character no-undo .
     2594     define buffer buf_temp-param for temp-param .
     2595     do
     2596     on error undo, return error return-value
     2597     :
     2598       find first buf_temp-param
     2599         where buf_temp-param.param-code     = p-code
     2600           and buf_temp-param.param-sub-code = p-sub-code
     2601         no-error .
     2602       if available buf_temp-param then do:
     2603         assign
     2604           p-value = buf_temp-param.param-value
     2605         .
     2606       end.
     2607       else do:
     2608         assign
     2609           p-value = p-default-value
     2610         .
     2611       end.
     2612     end.
     2613   end procedure.
     2614   procedure paramls-append :
     2615     define input  parameter p-code     as character no-undo .
     2616     define input  parameter p-sub-code as character no-undo .
     2617     define input  parameter p-value    as character no-undo .
     2618     define buffer buf_temp-param for temp-param .
     2619     do
     2620     on error undo, return error return-value
     2621     :
     2622       find first buf_temp-param
     2623            where buf_temp-param.param-code     = p-code
     2624              and buf_temp-param.param-sub-code = p-sub-code
     2625         no-error .
     2626       if not available buf_temp-param then do:
     2627         create buf_temp-param .
     2628         assign
     2629           buf_temp-param.param-code     = p-code
     2630           buf_temp-param.param-sub-code = p-sub-code
     2631           buf_temp-param.param-value    = p-value
     2632         .
     2633       end.
     2634       else do:
     2635           assign
     2636               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     2637           .
     2638       end.
     2639     end.
     2640   end procedure.
     2641   define variable g#report-num  as integer    no-undo .
     2642   define variable vss-include-info17 as character format "X(65)" no-undo
     2643   initial "@(#)$Workfile$ $Revision$".
     2644   define stream excel-line.
     2645   define stream excel-cell.
     2646   define temp-table temp_cell-data no-undo
     2647       field data-key as character
     2648       field data-value as character
     2649       index pi is primary unique data-key
     2650   .
     2651   define temp-table temp_sheet1_line-data no-undo
     2652       field sheet-name    as character
     2653       field xl-line-id    as integer
     2654       field npp           as character
     2655       field alctypename   as character
     2656       field ostbegin      as character
     2657       field pritot        as character
     2658       field priprod       as character
     2659       field priopt        as character
     2660       field priret        as character
     2661       field rastot        as character
     2662       field rassel        as character
     2663       field rasret        as character
     2664       field rasspi        as character
     2665       field rasoth        as character
     2666       field ostend        as character
     2667   index pi is primary unique
     2668           xl-line-id
     2669   .
     2670   define variable v-alc05xl-sheet1-cur-data-row  as integer      no-undo.
     2671   define variable v-alc05xl-cell-file-name       as character    no-undo.
     2672   define variable v-alc05xl-data-file-name       as character    no-undo.
     2673   procedure alc05xl-init :
     2674   do
     2675   on error undo, return error
     2676   :
     2677       assign
     2678           v-alc05xl-sheet1-cur-data-row = 0
     2679       .
     2680       run gbl/_tmpfile.p (
     2681             input "xd"
     2682           , input ".txt"
     2683           , output v-alc05xl-data-file-name
     2684       ).
     2685       output stream excel-line to value( v-alc05xl-data-file-name ).
     2686       run gbl/_tmpfile.p (
     2687             input "xc"
     2688           , input ".txt"
     2689           , output v-alc05xl-cell-file-name
     2690       ).
     2691       output stream excel-cell to value( v-alc05xl-cell-file-name ).
     2692       run alc05xl-write-cell-data in this-procedure (
     2693             input "sheetList":U
     2694           , input "Декларация":U
     2695       ).
     2696       if printrubl
     2697       then do:
     2698           run alc05xl-write-cell-data in this-procedure (
     2699                 input "Декларация_valutCode":U
     2700               , input "0":U
     2701           ).
     2702       end.
     2703       else do:
     2704           run alc05xl-write-cell-data in this-procedure (
     2705                 input "Декларация_valutCode":U
     2706               , input "1":U
     2707           ).
     2708       end.
     2709       run alc05xl-write-cell-data in this-procedure (
     2710             input "Декларация_columnList":U
     2711           , input "npp,alctypename,ostbegin,pritot,priprod,priopt,priret,rastot,rassel,rasret,rasspi,rasoth,ostend":U
     2712       ).
     2713       run alc05xl-write-cell-data in this-procedure (
     2714             input "Декларация_columnType":U
     2715           , input "S,S,S,S,S,S,S,S,S,S,S,S,S":U
     2716       ).
     2717       run alc05xl-write-cell-data in this-procedure (
     2718             input "Декларация_subtotalList":U
     2719           , input "":U
     2720       ).
     2721       run alc05xl-write-cell-data in this-procedure (
     2722             input "Декларация_subtotalType":U
     2723           , input "":U
     2724       ).
     2725   end.
     2726   end procedure.
     2727   procedure alc05xl-sheet1-write-line-data :
     2728     define input parameter p-npp          as character no-undo .
     2729     define input parameter p-alctypename  as character no-undo .
     2730     define input parameter p-ostbegin     as character no-undo .
     2731     define input parameter p-pritot       as character no-undo .
     2732     define input parameter p-priprod      as character no-undo .
     2733     define input parameter p-priopt       as character no-undo .
     2734     define input parameter p-priret       as character no-undo .
     2735     define input parameter p-rastot       as character no-undo .
     2736     define input parameter p-rassel       as character no-undo .
     2737     define input parameter p-rasret       as character no-undo .
     2738     define input parameter p-rasspi       as character no-undo .
     2739     define input parameter p-rasoth       as character no-undo .
     2740     define input parameter p-ostend       as character no-undo .
     2741   define buffer buf_temp_sheet1_line-data  for temp_sheet1_line-data.
     2742   do
     2743   for buf_temp_sheet1_line-data
     2744   on error undo, return error
     2745   :
     2746       for each buf_temp_sheet1_line-data
     2747       :
     2748           delete buf_temp_sheet1_line-data.
     2749       end.
     2750       create buf_temp_sheet1_line-data.
     2751       assign
     2752           v-alc05xl-sheet1-cur-data-row         = v-alc05xl-sheet1-cur-data-row + 1
     2753           buf_temp_sheet1_line-data.sheet-name  = "Декларация":U
     2754           buf_temp_sheet1_line-data.xl-line-id  = v-alc05xl-sheet1-cur-data-row
     2755           buf_temp_sheet1_line-data.npp         = p-npp
     2756           buf_temp_sheet1_line-data.alctypename = p-alctypename
     2757           buf_temp_sheet1_line-data.ostbegin    = p-ostbegin
     2758           buf_temp_sheet1_line-data.pritot      = p-pritot
     2759           buf_temp_sheet1_line-data.priprod     = p-priprod
     2760           buf_temp_sheet1_line-data.priopt      = p-priopt
     2761           buf_temp_sheet1_line-data.priret      = p-priret
     2762           buf_temp_sheet1_line-data.rastot      = p-rastot
     2763           buf_temp_sheet1_line-data.rassel      = p-rassel
     2764           buf_temp_sheet1_line-data.rasret      = p-rasret
     2765           buf_temp_sheet1_line-data.rasspi      = p-rasspi
     2766           buf_temp_sheet1_line-data.rasoth      = p-rasoth
     2767           buf_temp_sheet1_line-data.ostend      = p-ostend
     2768       .
     2769       put stream excel-line unformatted
     2770                           buf_temp_sheet1_line-data.sheet-name
     2771           CHR(9)   "DTA":U
     2772           CHR(9)   buf_temp_sheet1_line-data.npp
     2773           CHR(9)   buf_temp_sheet1_line-data.alctypename
     2774           CHR(9)   buf_temp_sheet1_line-data.ostbegin
     2775           CHR(9)   buf_temp_sheet1_line-data.pritot
     2776           CHR(9)   buf_temp_sheet1_line-data.priprod
     2777           CHR(9)   buf_temp_sheet1_line-data.priopt
     2778           CHR(9)   buf_temp_sheet1_line-data.priret
     2779           CHR(9)   buf_temp_sheet1_line-data.rastot
     2780           CHR(9)   buf_temp_sheet1_line-data.rassel
     2781           CHR(9)   buf_temp_sheet1_line-data.rasret
     2782           CHR(9)   buf_temp_sheet1_line-data.rasspi
     2783           CHR(9)   buf_temp_sheet1_line-data.rasoth
     2784           CHR(9)   buf_temp_sheet1_line-data.ostend
     2785           chr(10)
     2786       .
     2787       .
     2788   end.
     2789   end procedure.
     2790   procedure alc05xl-sheet1-write-line-format :
     2791   define input parameter p-fmt-label       as character  no-undo.
     2792       define buffer buf_temp_sheet1_line-data        for temp_sheet1_line-data.
     2793   do
     2794   for buf_temp_sheet1_line-data
     2795   on error undo, return error
     2796   :
     2797       put stream excel-line unformatted
     2798                           "Декларация":U
     2799           CHR(9)   "FMT":U
     2800           CHR(9)   p-fmt-label
     2801           chr(10)
     2802       .
     2803   end.
     2804   end procedure.
     2805   procedure alc05xl-write-cell-data :
     2806   define input parameter p-data-key   as character        no-undo.
     2807   define input parameter p-data-value as character        no-undo.
     2808       define buffer buf_temp_cell-data     for temp_cell-data.
     2809   do
     2810   for buf_temp_cell-data
     2811   on error undo, return error
     2812   :
     2813       find first buf_temp_cell-data
     2814            where buf_temp_cell-data.data-key = p-data-key
     2815       no-error.
     2816       if not available buf_temp_cell-data
     2817       then do:
     2818           create buf_temp_cell-data.
     2819           assign
     2820               buf_temp_cell-data.data-key = p-data-key
     2821           .
     2822       end.
     2823       assign
     2824           buf_temp_cell-data.data-value = p-data-value
     2825       .
     2826       put stream excel-cell unformatted
     2827                           buf_temp_cell-data.data-key
     2828           CHR(9)   buf_temp_cell-data.data-value
     2829           chr(10)
     2830       .
     2831   end.
     2832   end procedure.
     2833   procedure alc05xl-run-excel :
     2834   define input parameter p-header-filename    as character        no-undo.
     2835   define input parameter p-data-filename      as character        no-undo.
     2836       define variable v-Template-file-name    as character    no-undo.
     2837       define variable v-vb-file-name          as character    no-undo.
     2838       define buffer buf_temp-param for temp-param .
     2839   do
     2840   for buf_temp-param
     2841   on error undo, return error
     2842   :
     2843       create buf_temp-param.
     2844       assign
     2845           v-Template-file-name    = search( "exe/alcdcl05.xlt" )
     2846           v-vb-file-name          = search( "exe/t_form.bas")
     2847       .
     2848       if v-Template-file-name = ?
     2849       or v-Template-file-name = "":U
     2850       then do:
     2851           message
     2852               "Ошибка имени файла шаблона."
     2853           view-as alert-box error.
     2854       end.
     2855       if v-vb-file-name = ?
     2856       or v-vb-file-name = "":U
     2857       then do:
     2858           message
     2859               "Ошибка имени файла кода обработки."
     2860           view-as alert-box error.
     2861       end.
     2862       run paramls-write in this-procedure (
     2863             input "template":U
     2864           , input "template-file-name":U
     2865           , input v-Template-file-name
     2866       ).
     2867       run paramls-write in this-procedure (
     2868             input "template":U
     2869           , input "vb-file-name":U
     2870           , input v-vb-file-name
     2871       ).
     2872       run paramls-write in this-procedure (
     2873             input "data":U
     2874           , input "data-header-filename":U
     2875           , input p-header-filename
     2876       ).
     2877       run paramls-write in this-procedure (
     2878             input "data":U
     2879           , input "data-filename":U
     2880           , input p-data-filename
     2881       ).
     2882       run gbl/macroxlt.p (
     2883           input-output table buf_temp-param
     2884       ) no-error.
     2885       if error-status :error
     2886       then do:
     2887           message
     2888                    vss-workfile vss-revision vss-description
     2889               skip(1)
     2890               skip "Ошибка создания файла Excel."
     2891               skip return-value
     2892               skip trim(error-status :get-message(1))
     2893                    trim(error-status :get-message(2))
     2894                    trim(error-status :get-message(3))
     2895           view-as alert-box error.
     2896           undo, return error .
     2897       end.
     2898   end.
     2899   end procedure.
     2900   procedure alc05xl-close :
     2901   do
     2902   on error undo, return error
     2903   :
     2904       output stream excel-line close.
     2905       output stream excel-cell close.
     2906       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     2907           export "exe/alcdcl05.xlt":U.
     2908           export "exe/t_form.bas":U.
     2909           export v-alc05xl-cell-file-name.
     2910           export v-alc05xl-data-file-name.
     2911       output close.
     2912   end.
     2913   end procedure.
     2914   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2915     define variable v-cntxt-db-num        as integer   no-undo .
     2916     define variable v-cntxt-userid        as character no-undo .
     2917     define variable v-cntxt-level         as character no-undo .
     2918     define variable v-cntxt-host-code-obj as integer   no-undo .
     2919     define variable v-cntxt-obj-type      as character no-undo .
     2920     define variable v-cntxt-obj-code      as integer   no-undo .
     2921     define variable v-cntxt-db-num-obj    as integer   no-undo .
     2922     define variable v-cntxt-is-admin      as logical   no-undo .
     2923   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2924     run mainmenu_getcntxt in my-handle
     2925       (output v-cntxt-db-num
     2926       ,output v-cntxt-userid
     2927       ,output v-cntxt-level
     2928       ,output v-cntxt-host-code-obj
     2929       ,output v-cntxt-obj-type
     2930       ,output v-cntxt-obj-code
     2931       ,output v-cntxt-db-num-obj
     2932       ,output v-cntxt-is-admin
     2933       ) .
     2934   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2935   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2936   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     2937   define variable par-type          as character no-undo.
     2938   define variable v-value-character as character no-undo .
     2939   define variable v-value-date      as date      no-undo .
     2940   define variable v-value-decimal   as decimal   no-undo .
     2941   define variable v-value-integer   as integer   no-undo .
     2942   define variable v-value-logical   as logical   no-undo .
     2943   define stream out-stream.
     2944   define temp-table tt-gds no-undo like ub.goods
     2945     field alc-type-inner-code like ub.alc-type.alc-type-inner-code
     2946     field create-user-db-num  like ub.alc-type.create-user-db-num
     2947     field alc-type-code       like ub.alc-type.alc-type-code
     2948     field alc-type-name       like ub.alc-type.alc-type-name
     2949     field gds-man-type        as integer
     2950   index pi is primary unique
     2951     gds-code
     2952   index alc-type
     2953     alc-type-inner-code
     2954     create-user-db-num
     2955   index alc-type-code
     2956     alc-type-code
     2957   .
     2958   define temp-table tt-report no-undo
     2959     field obj-type            like ub.clients.obj-type
     2960     field obj-code            like ub.clients.obj-code
     2961     field type                as integer
     2962     field alc-type-code       like ub.alc-type.alc-type-code
     2963     field alc-type-name       like ub.alc-type.alc-type-name
     2964     field ost-begin-qnty      as decimal
     2965     field ost-end-qnty        as decimal
     2966     field pri-prod-qnty       as decimal
     2967     field pri-opt-qnty        as decimal
     2968     field pri-ret-qnty        as decimal
     2969     field ras-sel-qnty        as decimal
     2970     field ras-ret-qnty        as decimal
     2971     field ras-spi-qnty        as decimal
     2972     field ras-oth-qnty        as decimal
     2973     field pri-tot-qnty        as decimal
     2974     field ras-tot-qnty        as decimal
     2975   index pi is primary unique
     2976     obj-type
     2977     obj-code
     2978     type
     2979     alc-type-code
     2980   index oatc
     2981     obj-type
     2982     obj-code
     2983     alc-type-code
     2984   index atc
     2985     alc-type-code
     2986   .
     2987   define variable v-line                    as character  no-undo .
     2988   define variable v-par-val                 as character  no-undo .
     2989   define variable v-par-type                as character  no-undo .
     2990   define variable v-begin-date              as date       no-undo .
     2991   define variable v-end-date                as date       no-undo .
     2992   define variable v-host-code               like ub.clients.host-code  no-undo .
     2993   define variable v-host-code-2             like ub.clients.host-code  no-undo .
     2994   define variable v-alc-type-count          as integer   no-undo .
     2995   define variable v-str-npp                 as character no-undo .
     2996   do on error undo , return error return-value
     2997   :
     2998   if session :set-wait-state( "compiler" ) then.
     2999   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3000   empty temp-table thbjattr_thbj-attr.
     3001   run adm/shattri.p (
     3002      input "get":U
     3003     ,input ''
     3004     ,input 0
     3005     ,input 'report-glob':U
     3006     ,input  ""
     3007     ,output v-value-character
     3008     ,output v-value-date
     3009     ,output v-value-decimal
     3010     ,output v-value-integer
     3011     ,output v-value-logical
     3012     ,output par-type
     3013     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     3014     ) no-error .
     3015     for each thbjattr_thbj-attr :
     3016         if thbjattr_thbj-attr.prop-code = 'ardecldt' then v-par-val =  string(thbjattr_thbj-attr.property-value-date,"99/99/9999") .
     3017     end.
     3018     find first obj-list no-lock no-error .
     3019     if not available obj-list then do:
     3020       message
     3021         "Нет ни одного объекта для формирования отчета!"
     3022       view-as alert-box error.
     3023       return error return-value.
     3024     end.
     3025   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3026   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3027     (input  obj-list.obj-type
     3028     ,input  obj-list.obj-code
     3029     ,output v-host-code
     3030     )  .
     3031     for each obj-list :
     3032   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3033   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3034     (input  obj-list.obj-type
     3035     ,input  obj-list.obj-code
     3036     ,output v-host-code-2
     3037     )  .
     3038       if v-host-code <> v-host-code-2 then do:
     3039         message
     3040           "Отчет формируется только по объектам одной фирмы."
     3041         view-as alert-box error.
     3042         return error return-value.
     3043       end.
     3044     end.
     3045     run get-report-num in my-handle (output g#report-num).
     3046   output stream out-stream to value( string( session:temp-directory +
     3047                                        "rpt" + string( g#report-num ) ) )
     3048                                        page-size  value(43) .
     3049     put stream out-stream " " skip.
     3050     run alc05xl-init in this-procedure.
     3051     run clear-all in this-procedure .
     3052     assign
     3053       v-begin-date  = date(v-par-val)
     3054       v-end-date    = x-Date-Alone
     3055       v-line        = fill( "-" , 300 )
     3056     .
     3057     run waitfram-show in this-procedure ( "Поиск товаров по справочнику видов алкогольной продукции...":U ) .
     3058     run find-alc-goods in this-procedure .
     3059     run waitfram-show in this-procedure ( "Формирование отчета...":U ) .
     3060     run fill-tt-report in this-procedure .
     3061     run waitfram-show in this-procedure ( "Вывод отчета...":U ) .
     3062     run print-header in this-procedure .
     3063     run print-body in this-procedure .
     3064     run print-footer in this-procedure .
     3065     output stream out-stream close.
     3066     if Make-Excel then output stream ForExcel close.
     3067     run clear-all in this-procedure .
     3068   if session :set-wait-state( "" ) then.
     3069     run waitfram-hide in this-procedure .
     3070     run alc05xl-close in this-procedure .
     3071     os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )  .
     3072     os-rename
     3073       value( string( session:temp-directory ) + "$" + string( g#report-num ) + ".txl" )
     3074       value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )
     3075     .
     3076     define variable v-user-action   as character no-undo .
     3077     define variable v-printed       as logical   no-undo .
     3078     run gbl/prnfilen.w
     3079         (input  ""
     3080         ,input  20
     3081         ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     3082         ,input  ReportFontNum
     3083         ,output v-user-action
     3084         ,output v-printed
     3085         ) .
     3086     os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )  .
     3087   end.
     3088   procedure clear-all :
     3089   do
     3090   on error undo, return error return-value
     3091   :
     3092     empty temp-table tt-gds.
     3093     empty temp-table tt-report.
     3094   end.
     3095   end procedure.
     3096   procedure find-alc-goods :
     3097   do
     3098   on error undo, return error return-value
     3099   :
     3100     define buffer buf_alc-type      for ub.alc-type.
     3101     define buffer buf_alc-type-gds  for ub.alc-type-gds.
     3102     define buffer buf_goods         for ub.goods.
     3103     define variable v-gds-type as integer   no-undo .
     3104     empty temp-table tt-gds.
     3105     for each buf_alc-type no-lock
     3106           where buf_alc-type.alc-type-status = 0
     3107     :
     3108       _gds:
     3109       for each buf_alc-type-gds no-lock
     3110             where buf_alc-type-gds.alc-type-inner-code = buf_alc-type.alc-type-inner-code
     3111               AND buf_alc-type-gds.create-user-db-num  = buf_alc-type.create-user-db-num
     3112         , first buf_goods no-lock
     3113             where buf_goods.gds-code = buf_alc-type-gds.gds-code
     3114       :
     3115         run get-gds-man in this-procedure ( input   buf_goods.prod-type
     3116                                           , input   buf_goods.prod-code
     3117                                           , output  v-gds-type
     3118                                           ) no-error .
     3119         if error-status :error then do:
     3120           message
     3121             "Ошибка при определение территориальной принадлежности товара." skip
     3122             return-value skip
     3123             error-status :get-message(1) skip
     3124             substitute( "Товар &1 - '&2' не включен в результирующий отчет!" , buf_goods.artic , buf_goods.gds-name )
     3125           view-as alert-box error.
     3126           next _gds.
     3127         end.
     3128         if v-gds-type = -1
     3129         then do:
     3130           message
     3131             substitute( 'У производителя &1 &2 товара артикул: &3 - "&4"&5 не установлен атрибут производитель алкогольной продукции.'
     3132                       , buf_goods.prod-type
     3133                       , buf_goods.prod-code
     3134                       , buf_goods.artic
     3135                       , buf_goods.gds-name
     3136                       , chr(10)
     3137                       )
     3138           view-as alert-box error.
     3139           next _gds.
     3140         end.
     3141         find first tt-gds no-lock where tt-gds.gds-code = buf_goods.gds-code no-error .
     3142         if not available tt-gds then do:
     3143           create tt-gds.
     3144           buffer-copy buf_goods to tt-gds
     3145           assign
     3146             tt-gds.alc-type-inner-code = buf_alc-type.alc-type-inner-code
     3147             tt-gds.create-user-db-num  = buf_alc-type.create-user-db-num
     3148             tt-gds.alc-type-code       = buf_alc-type.alc-type-code
     3149             tt-gds.alc-type-name       = buf_alc-type.alc-type-name
     3150             tt-gds.gds-man-type        = v-gds-type
     3151             v-alc-type-count           = v-alc-type-count + 1
     3152           .
     3153         end.
     3154       end.
     3155     end.
     3156   end.
     3157   end procedure.
     3158   procedure get-gds-man :
     3159     define input  parameter p-prod-type like ub.goods.prod-type no-undo .
     3160     define input  parameter p-prod-code like ub.goods.prod-code no-undo .
     3161     define output parameter p-gds-man   as integer   no-undo .
     3162     define buffer buf_clients for ub.clients.
     3163     define variable v-cli-local-str             as character no-undo .
     3164     define variable v-cli-alc-producer-str      as character no-undo .
     3165     define variable v-cli-foreign-producer-str  as character no-undo .
     3166     define variable v-cli-local                 as logical   no-undo .
     3167     define variable v-cli-alc-producer          as logical   no-undo .
     3168     define variable v-cli-foreign-producer      as logical   no-undo .
     3169     define variable v-attr-type                 as character no-undo .
     3170   do
     3171   on error undo, return error return-value
     3172   :
     3173     find first buf_clients no-lock
     3174       where buf_clients.obj-type = p-prod-type
     3175         and buf_clients.obj-code = p-prod-code
     3176     no-error .
     3177     if available buf_clients
     3178     then do:
     3179       run clntattr-value in this-procedure ( input p-prod-type
     3180                                            , input p-prod-code
     3181                                            , input 'cli-local':U
     3182                                            , output v-cli-local-str
     3183                                            , output v-attr-type
     3184                                            ) .
     3185       run clntattr-value in this-procedure ( input p-prod-type
     3186                                            , input p-prod-code
     3187                                            , input 'foreign-producer':U
     3188                                            , output v-cli-foreign-producer-str
     3189                                            , output v-attr-type
     3190                                            ) .
     3191       assign
     3192         v-cli-local             = logical(v-cli-local-str           )
     3193         v-cli-foreign-producer  = logical(v-cli-foreign-producer-str)
     3194       .
     3195       if v-cli-local = yes and v-cli-foreign-producer = yes
     3196       then do:
     3197         return error substitute( "Для контрагента &1 &2 одновременно установлены атрибуты местный и импортный производитель!"
     3198                                , p-prod-type
     3199                                , p-prod-code
     3200                                ) .
     3201       end.
     3202       if v-cli-local = yes
     3203       then do:
     3204         assign
     3205           p-gds-man = 1
     3206         .
     3207         return .
     3208       end.
     3209       if v-cli-foreign-producer = yes
     3210       then do:
     3211         assign
     3212           p-gds-man = 3
     3213         .
     3214         return .
     3215       end.
     3216       assign
     3217         p-gds-man = 2
     3218       .
     3219       return .
     3220     end.
     3221     else do:
     3222       return error substitute("Не найден производитель &1 &2" , p-prod-type , p-prod-code ).
     3223     end.
     3224   end.
     3225   end procedure.
     3226   procedure print-header :
     3227   do
     3228   on error undo, return error return-value
     3229   :
     3230     define variable v-str-obj   as character no-undo .
     3231     define variable v-str-date  as character no-undo .
     3232     define variable v-license   as character no-undo .
     3233     define variable v-month-list as character no-undo extent 12 initial
     3234       ["январь"
     3235       ,"февраль"
     3236       ,"март"
     3237       ,"апрель"
     3238       ,"май"
     3239       ,"июнь"
     3240       ,"июль"
     3241       ,"август"
     3242       ,"сентябрь"
     3243       ,"октябрь"
     3244       ,"ноябрь"
     3245       ,"декабрь"
     3246       ] .
     3247     run fmtcli-get-client in this-procedure
     3248               ( input  'орг':U
     3249               , input  v-host-code
     3250               ) .
     3251     run get-sertificate in this-procedure ( input 'орг':U
     3252                                           , input v-host-code
     3253                                           , input v-end-date
     3254                                           , output v-license
     3255                                           ) .
     3256     assign
     3257       v-str-obj = substitute( '"&1", &2, &3 ', v-fmtcli-name , v-fmtcli-full-addres , v-fmtcli-inn )
     3258       v-str-date = substitute( 'за &1 &2 года * ' , v-month-list[month( v-begin-date )] , year(v-begin-date) )
     3259     .
     3260     run alc05xl-write-cell-data in this-procedure ( input "month":U, input v-str-date ).
     3261     run alc05xl-write-cell-data in this-procedure ( input "object":U, input v-str-obj ).
     3262     run alc05xl-write-cell-data in this-procedure ( input "license":U, input v-license ).
     3263   end.
     3264   end procedure.
     3265   procedure print-body :
     3266     define variable v-list-count    as integer   no-undo .
     3267     define variable v-gds-man-type  as integer   no-undo .
     3268     define variable v-i             as integer   no-undo .
     3269   do
     3270   on error undo, return error return-value
     3271   :
     3272     define variable v-ost-begin-qnty  as decimal   no-undo .
     3273     define variable v-ost-end-qnty    as decimal   no-undo .
     3274     define variable v-pri-prod-qnty   as decimal   no-undo .
     3275     define variable v-pri-opt-qnty    as decimal   no-undo .
     3276     define variable v-pri-ret-qnty    as decimal   no-undo .
     3277     define variable v-ras-sel-qnty    as decimal   no-undo .
     3278     define variable v-ras-ret-qnty    as decimal   no-undo .
     3279     define variable v-ras-spi-qnty    as decimal   no-undo .
     3280     define variable v-ras-oth-qnty    as decimal   no-undo .
     3281     define variable v-pri-tot-qnty    as decimal   no-undo .
     3282     define variable v-ras-tot-qnty    as decimal   no-undo .
     3283     define variable v-b-i             as integer   no-undo .
     3284     define variable v-s-i             as integer   no-undo .
     3285     assign
     3286       v-b-i = 1
     3287       v-s-i = 0
     3288     .
     3289     for each tt-report
     3290     :
     3291       assign
     3292         v-ost-begin-qnty  = v-ost-begin-qnty + tt-report.ost-begin-qnty
     3293         v-ost-end-qnty    = v-ost-end-qnty   + tt-report.ost-end-qnty
     3294         v-pri-prod-qnty   = v-pri-prod-qnty  + tt-report.pri-prod-qnty
     3295         v-pri-opt-qnty    = v-pri-opt-qnty   + tt-report.pri-opt-qnty
     3296         v-pri-ret-qnty    = v-pri-ret-qnty   + tt-report.pri-ret-qnty
     3297         v-ras-sel-qnty    = v-ras-sel-qnty   + tt-report.ras-sel-qnty
     3298         v-ras-ret-qnty    = v-ras-ret-qnty   + tt-report.ras-ret-qnty
     3299         v-ras-spi-qnty    = v-ras-spi-qnty   + tt-report.ras-spi-qnty
     3300         v-ras-oth-qnty    = v-ras-oth-qnty   + tt-report.ras-oth-qnty
     3301         v-pri-tot-qnty    = v-pri-tot-qnty   + tt-report.pri-tot-qnty
     3302         v-ras-tot-qnty    = v-ras-tot-qnty   + tt-report.ras-tot-qnty
     3303       .
     3304     end.
     3305     run alc05xl-sheet1-write-line-data in this-procedure
     3306           ( input substitute("&1." , v-b-i , v-s-i )
     3307           , input "Алкогольная продукция всего в том числе:"
     3308           , input string(v-ost-begin-qnty)
     3309           , input string(v-pri-tot-qnty  )
     3310           , input string(v-pri-prod-qnty )
     3311           , input string(v-pri-opt-qnty  )
     3312           , input string(v-pri-ret-qnty  )
     3313           , input string(v-ras-tot-qnty  )
     3314           , input string(v-ras-sel-qnty  )
     3315           , input string(v-ras-ret-qnty  )
     3316           , input string(v-ras-spi-qnty  )
     3317           , input string(v-ras-oth-qnty  )
     3318           , input string(v-ost-end-qnty  )
     3319           ).
     3320     assign
     3321       v-ost-begin-qnty  = 0
     3322       v-ost-end-qnty    = 0
     3323       v-pri-prod-qnty   = 0
     3324       v-pri-opt-qnty    = 0
     3325       v-pri-ret-qnty    = 0
     3326       v-ras-sel-qnty    = 0
     3327       v-ras-ret-qnty    = 0
     3328       v-ras-spi-qnty    = 0
     3329       v-ras-oth-qnty    = 0
     3330       v-pri-tot-qnty    = 0
     3331       v-ras-tot-qnty    = 0
     3332     .
     3333     for each tt-report
     3334       break by tt-report.alc-type-code
     3335     :
     3336       assign
     3337         v-ost-begin-qnty  = v-ost-begin-qnty + tt-report.ost-begin-qnty
     3338         v-ost-end-qnty    = v-ost-end-qnty   + tt-report.ost-end-qnty
     3339         v-pri-prod-qnty   = v-pri-prod-qnty  + tt-report.pri-prod-qnty
     3340         v-pri-opt-qnty    = v-pri-opt-qnty   + tt-report.pri-opt-qnty
     3341         v-pri-ret-qnty    = v-pri-ret-qnty   + tt-report.pri-ret-qnty
     3342         v-ras-sel-qnty    = v-ras-sel-qnty   + tt-report.ras-sel-qnty
     3343         v-ras-ret-qnty    = v-ras-ret-qnty   + tt-report.ras-ret-qnty
     3344         v-ras-spi-qnty    = v-ras-spi-qnty   + tt-report.ras-spi-qnty
     3345         v-ras-oth-qnty    = v-ras-oth-qnty   + tt-report.ras-oth-qnty
     3346         v-pri-tot-qnty    = v-pri-tot-qnty   + tt-report.pri-tot-qnty
     3347         v-ras-tot-qnty    = v-ras-tot-qnty   + tt-report.ras-tot-qnty
     3348       .
     3349       if last-of(tt-report.alc-type-code)
     3350       then do:
     3351         assign
     3352           v-s-i = v-s-i + 1
     3353         .
     3354         run alc05xl-sheet1-write-line-data in this-procedure
     3355               ( input substitute("&1.&2" , v-b-i , v-s-i )
     3356               , input tt-report.alc-type-name
     3357               , input string(v-ost-begin-qnty)
     3358               , input string(v-pri-tot-qnty  )
     3359               , input string(v-pri-prod-qnty )
     3360               , input string(v-pri-opt-qnty  )
     3361               , input string(v-pri-ret-qnty  )
     3362               , input string(v-ras-tot-qnty  )
     3363               , input string(v-ras-sel-qnty  )
     3364               , input string(v-ras-ret-qnty  )
     3365               , input string(v-ras-spi-qnty  )
     3366               , input string(v-ras-oth-qnty  )
     3367               , input string(v-ost-end-qnty  )
     3368               ).
     3369         assign
     3370           v-ost-begin-qnty  = 0
     3371           v-ost-end-qnty    = 0
     3372           v-pri-prod-qnty   = 0
     3373           v-pri-opt-qnty    = 0
     3374           v-pri-ret-qnty    = 0
     3375           v-ras-sel-qnty    = 0
     3376           v-ras-ret-qnty    = 0
     3377           v-ras-spi-qnty    = 0
     3378           v-ras-oth-qnty    = 0
     3379           v-pri-tot-qnty    = 0
     3380           v-ras-tot-qnty    = 0
     3381         .
     3382       end.
     3383     end.
     3384     assign
     3385       v-list-count = num-entries("1,2,3":U)
     3386       v-ost-begin-qnty  = 0
     3387       v-ost-end-qnty    = 0
     3388       v-pri-prod-qnty   = 0
     3389       v-pri-opt-qnty    = 0
     3390       v-pri-ret-qnty    = 0
     3391       v-ras-sel-qnty    = 0
     3392       v-ras-ret-qnty    = 0
     3393       v-ras-spi-qnty    = 0
     3394       v-ras-oth-qnty    = 0
     3395       v-pri-tot-qnty    = 0
     3396       v-ras-tot-qnty    = 0
     3397     .
     3398     do v-i = 1 to v-list-count :
     3399       assign
     3400         v-gds-man-type = integer( entry( v-i , "1,2,3":U ) )
     3401         v-b-i = v-b-i + 1
     3402         v-s-i = 0
     3403       .
     3404       for each tt-report
     3405         where tt-report.type = v-gds-man-type
     3406       :
     3407         assign
     3408           v-ost-begin-qnty  = v-ost-begin-qnty + tt-report.ost-begin-qnty
     3409           v-ost-end-qnty    = v-ost-end-qnty   + tt-report.ost-end-qnty
     3410           v-pri-prod-qnty   = v-pri-prod-qnty  + tt-report.pri-prod-qnty
     3411           v-pri-opt-qnty    = v-pri-opt-qnty   + tt-report.pri-opt-qnty
     3412           v-pri-ret-qnty    = v-pri-ret-qnty   + tt-report.pri-ret-qnty
     3413           v-ras-sel-qnty    = v-ras-sel-qnty   + tt-report.ras-sel-qnty
     3414           v-ras-ret-qnty    = v-ras-ret-qnty   + tt-report.ras-ret-qnty
     3415           v-ras-spi-qnty    = v-ras-spi-qnty   + tt-report.ras-spi-qnty
     3416           v-ras-oth-qnty    = v-ras-oth-qnty   + tt-report.ras-oth-qnty
     3417           v-pri-tot-qnty    = v-pri-tot-qnty   + tt-report.pri-tot-qnty
     3418           v-ras-tot-qnty    = v-ras-tot-qnty   + tt-report.ras-tot-qnty
     3419         .
     3420       end.
     3421       run alc05xl-sheet1-write-line-data in this-procedure
     3422             ( input substitute("&1." , v-b-i )
     3423             , input substitute( "&1 в том числе " , entry( v-i , "Алкогольная продукция, произведенная в республике Марий Эл;Алкогольная продукция, произведенная в Российской федерации (за исключением алкогольной продукции, произведенной в Республике Марий Эл);Импортная алкогольная продукция" , ';') )
     3424             , input string(v-ost-begin-qnty)
     3425             , input string(v-pri-tot-qnty  )
     3426             , input string(v-pri-prod-qnty )
     3427             , input string(v-pri-opt-qnty  )
     3428             , input string(v-pri-ret-qnty  )
     3429             , input string(v-ras-tot-qnty  )
     3430             , input string(v-ras-sel-qnty  )
     3431             , input string(v-ras-ret-qnty  )
     3432             , input string(v-ras-spi-qnty  )
     3433             , input string(v-ras-oth-qnty  )
     3434             , input string(v-ost-end-qnty  )
     3435             ).
     3436       assign
     3437         v-ost-begin-qnty  = 0
     3438         v-ost-end-qnty    = 0
     3439         v-pri-prod-qnty   = 0
     3440         v-pri-opt-qnty    = 0
     3441         v-pri-ret-qnty    = 0
     3442         v-ras-sel-qnty    = 0
     3443         v-ras-ret-qnty    = 0
     3444         v-ras-spi-qnty    = 0
     3445         v-ras-oth-qnty    = 0
     3446         v-pri-tot-qnty    = 0
     3447         v-ras-tot-qnty    = 0
     3448       .
     3449       for each tt-report
     3450         where tt-report.type = v-gds-man-type
     3451         break by tt-report.alc-type-code
     3452       :
     3453         assign
     3454           v-ost-begin-qnty  = v-ost-begin-qnty + tt-report.ost-begin-qnty
     3455           v-ost-end-qnty    = v-ost-end-qnty   + tt-report.ost-end-qnty
     3456           v-pri-prod-qnty   = v-pri-prod-qnty  + tt-report.pri-prod-qnty
     3457           v-pri-opt-qnty    = v-pri-opt-qnty   + tt-report.pri-opt-qnty
     3458           v-pri-ret-qnty    = v-pri-ret-qnty   + tt-report.pri-ret-qnty
     3459           v-ras-sel-qnty    = v-ras-sel-qnty   + tt-report.ras-sel-qnty
     3460           v-ras-ret-qnty    = v-ras-ret-qnty   + tt-report.ras-ret-qnty
     3461           v-ras-spi-qnty    = v-ras-spi-qnty   + tt-report.ras-spi-qnty
     3462           v-ras-oth-qnty    = v-ras-oth-qnty   + tt-report.ras-oth-qnty
     3463           v-pri-tot-qnty    = v-pri-tot-qnty   + tt-report.pri-tot-qnty
     3464           v-ras-tot-qnty    = v-ras-tot-qnty   + tt-report.ras-tot-qnty
     3465         .
     3466         if last-of(tt-report.alc-type-code)
     3467         then do:
     3468           assign
     3469             v-s-i = v-s-i + 1
     3470           .
     3471           run alc05xl-sheet1-write-line-data in this-procedure
     3472                 ( input substitute("&1.&2" , v-b-i , v-s-i )
     3473                 , input tt-report.alc-type-name
     3474                 , input string(v-ost-begin-qnty)
     3475                 , input string(v-pri-tot-qnty  )
     3476                 , input string(v-pri-prod-qnty )
     3477                 , input string(v-pri-opt-qnty  )
     3478                 , input string(v-pri-ret-qnty  )
     3479                 , input string(v-ras-tot-qnty  )
     3480                 , input string(v-ras-sel-qnty  )
     3481                 , input string(v-ras-ret-qnty  )
     3482                 , input string(v-ras-spi-qnty  )
     3483                 , input string(v-ras-oth-qnty  )
     3484                 , input string(v-ost-end-qnty  )
     3485                 ).
     3486           assign
     3487             v-ost-begin-qnty  = 0
     3488             v-ost-end-qnty    = 0
     3489             v-pri-prod-qnty   = 0
     3490             v-pri-opt-qnty    = 0
     3491             v-pri-ret-qnty    = 0
     3492             v-ras-sel-qnty    = 0
     3493             v-ras-ret-qnty    = 0
     3494             v-ras-spi-qnty    = 0
     3495             v-ras-oth-qnty    = 0
     3496             v-pri-tot-qnty    = 0
     3497             v-ras-tot-qnty    = 0
     3498           .
     3499         end.
     3500       end.
     3501     end.
     3502   end.
     3503   end procedure.
     3504   procedure print-footer :
     3505   do
     3506   on error undo, return error return-value
     3507   :
     3508   end.
     3509   end procedure.
     3510   procedure fill-tt-report :
     3511     define buffer buf_alc-type    for ub.alc-type.
     3512     define buffer buf_ot-line     for ub.ot-line.
     3513     define buffer buf_trn-doc     for ub.trn-doc.
     3514     define buffer sch_trn-doc     for ub.trn-doc.
     3515     define buffer buf_parts       for ub.parts.
     3516     define buffer buf_obj-list    for obj-list.
     3517     define variable v-fact-order-1      like ub.ot-line.fact-order no-undo .
     3518     define variable v-fact-order-2      like ub.ot-line.fact-order no-undo .
     3519     define variable v-fo-1              like ub.ot-line.fact-order no-undo .
     3520     define variable v-fo-2              like ub.ot-line.fact-order no-undo .
     3521     define variable var-x-store-code    like ub.clients.obj-code    no-undo.
     3522     define variable var-x-store-type    like ub.clients.obj-type    no-undo.
     3523     define variable var-x-date-start    like ub.stk-tot.Fact-date   no-undo.
     3524     define variable var-x-date-endt     like ub.stk-tot.Fact-date   no-undo.
     3525     define variable var-x-sum-type      like ub.stk-tot.sum-type    no-undo.
     3526     define variable var-x-ost-sum-type  like ub.stk-tot.sum-type    no-undo.
     3527     define variable var-x-cat-id        like ub.stk-tot.cat-id      no-undo.
     3528     define variable var-xTog-obj        as   logical             no-undo.
     3529     define variable var-Quantity        like ub.stk-tot.fact-qnty   initial ? no-undo.
     3530     define variable var-Coast_R         like ub.stk-tot.sum-rubl    no-undo.
     3531     define variable var-Coast_V         like ub.stk-tot.sum-rubl    no-undo.
     3532     define variable var-VAT_R           like ub.stk-tot.sum-rubl    no-undo.
     3533     define variable var-VAT_V           like ub.stk-tot.sum-rubl    no-undo.
     3534     define variable var-Fact-order      like ub.stk-tot.Fact-order  no-undo.
     3535     define variable var-x-artic         like ub.stk-line.artic        no-undo.
     3536     define variable var-x-prod-code     like ub.stk-line.prod-code    no-undo.
     3537     define variable var-x-prod-type     like ub.stk-line.prod-type    no-undo.
     3538     define variable var-SLT_R           like ub.stk-tot.sum-rubl    no-undo.
     3539     define variable var-SLT_V           like ub.stk-tot.sum-rubl    no-undo.
     3540     define variable v-gds-prod-type   like ub.goods.prod-type no-undo .
     3541     define variable v-gds-prod-code   like ub.goods.prod-code no-undo .
     3542     define variable v-ot-line-qnty    as decimal   no-undo .
     3543     define variable v-parts-line-qnty as decimal   no-undo .
     3544     define variable v-ost-begin-qnty  as decimal   no-undo .
     3545     define variable v-ost-end-qnty    as decimal   no-undo .
     3546     define variable v-pri-prod-qnty   as decimal   no-undo .
     3547     define variable v-pri-opt-qnty    as decimal   no-undo .
     3548     define variable v-pri-ret-qnty    as decimal   no-undo .
     3549     define variable v-ras-sel-qnty    as decimal   no-undo .
     3550     define variable v-ras-ret-qnty    as decimal   no-undo .
     3551     define variable v-ras-spi-qnty    as decimal   no-undo .
     3552     define variable v-ras-oth-qnty    as decimal   no-undo .
     3553     define variable v-gds-type        as integer   no-undo .
     3554     define variable v-i               as integer   no-undo .
     3555     define variable v-income-doc-code as character no-undo .
     3556   do
     3557   on error undo, return error return-value
     3558   :
     3559     run day-begin-fact-order in this-procedure ( input v-begin-date
     3560                                                , output v-fact-order-1
     3561                                                ) no-error .
     3562     if error-status:error then do:
     3563       message error-status :get-message(1) view-as alert-box error .
     3564       return error.
     3565     end.
     3566     run factord-end-day in this-procedure ( input v-end-date
     3567                                           , output v-fact-order-2
     3568                                           ) no-error .
     3569     if error-status:error then do:
     3570       message error-status :get-message(1) view-as alert-box error .
     3571       return error.
     3572     end.
     3573     assign
     3574       var-x-sum-type      = 'cost':U
     3575       var-x-ost-sum-type  = 'cost':U
     3576     .
     3577     for each buf_alc-type no-lock
     3578           where buf_alc-type.alc-type-status = 0
     3579     break by buf_alc-type.alc-type-code
     3580     :
     3581       _gds-ost:
     3582       for each tt-gds no-lock
     3583         where tt-gds.alc-type-code = buf_alc-type.alc-type-code ,
     3584           each obj-list no-lock
     3585       :
     3586         assign
     3587           var-x-store-code  = obj-list.obj-code
     3588           var-x-store-type  = obj-list.obj-type
     3589           var-x-artic       = tt-gds.artic
     3590           var-x-prod-code   = tt-gds.prod-code
     3591           var-x-prod-type   = tt-gds.prod-type
     3592           var-x-cat-id      = '##,##':U
     3593           var-xTog-obj      = yes
     3594         .
     3595         RUN ost-line  (
     3596             input   var-x-store-code,
     3597             input   var-x-store-type,
     3598             INPUT   var-x-artic     ,
     3599             INPUT   var-x-prod-code ,
     3600             INPUT   var-x-prod-type ,
     3601             input   no              ,
     3602             input   v-fact-order-1  ,
     3603             input   var-x-ost-sum-type  ,
     3604             input   var-x-cat-id    ,
     3605             input   var-xTog-obj    ,
     3606             output  var-Quantity    ,
     3607             output  var-Coast_R     ,
     3608             output  var-Coast_V     ,
     3609             output  var-VAT_R       ,
     3610             output  var-VAT_V       ,
     3611             output  var-SLT_R       ,
     3612             output  var-SLT_V       ).
     3613         assign
     3614           v-ost-begin-qnty = ( var-Quantity * tt-gds.ms-base )
     3615         .
     3616         RUN ost-line  (
     3617             input   var-x-store-code,
     3618             input   var-x-store-type,
     3619             INPUT   var-x-artic     ,
     3620             INPUT   var-x-prod-code ,
     3621             INPUT   var-x-prod-type ,
     3622             input   no              ,
     3623             input   v-fact-order-2  ,
     3624             input   var-x-ost-sum-type  ,
     3625             input   var-x-cat-id    ,
     3626             input   var-xTog-obj    ,
     3627             output  var-Quantity    ,
     3628             output  var-Coast_R     ,
     3629             output  var-Coast_V     ,
     3630             output  var-VAT_R       ,
     3631             output  var-VAT_V       ,
     3632             output  var-SLT_R       ,
     3633             output  var-SLT_V       ).
     3634         assign
     3635           v-ost-end-qnty = ( var-Quantity * tt-gds.ms-base )
     3636         .
     3637         find first tt-report
     3638           where tt-report.obj-type       = obj-list.obj-type
     3639             and tt-report.obj-code       = obj-list.obj-code
     3640             and tt-report.type           = tt-gds.gds-man-type
     3641             and tt-report.alc-type-code  = buf_alc-type.alc-type-code
     3642         no-error .
     3643         if not available tt-report then do:
     3644           create tt-report.
     3645           assign
     3646             tt-report.obj-type       = obj-list.obj-type
     3647             tt-report.obj-code       = obj-list.obj-code
     3648             tt-report.type           = tt-gds.gds-man-type
     3649             tt-report.alc-type-code  = buf_alc-type.alc-type-code
     3650             tt-report.alc-type-name  = buf_alc-type.alc-type-name
     3651           .
     3652         end.
     3653         assign
     3654           tt-report.ost-begin-qnty = tt-report.ost-begin-qnty + v-ost-begin-qnty
     3655           tt-report.ost-end-qnty   = tt-report.ost-end-qnty   + v-ost-end-qnty
     3656         .
     3657       end.
     3658       _obj-list:
     3659       for each obj-list no-lock
     3660       :
     3661         _tt-gds:
     3662         for each tt-gds no-lock
     3663           where tt-gds.alc-type-inner-code = buf_alc-type.alc-type-inner-code
     3664             and tt-gds.create-user-db-num  = buf_alc-type.create-user-db-num
     3665         :
     3666           _buf_ot-line:
     3667           for each buf_ot-line no-lock
     3668             where buf_ot-line.artic        = tt-gds.artic
     3669               and buf_ot-line.prod-code    = tt-gds.prod-code
     3670               and buf_ot-line.prod-type    = tt-gds.prod-type
     3671               and buf_ot-line.fact-order   <= v-fact-order-2
     3672               and buf_ot-line.fact-order   >= v-fact-order-1
     3673               and buf_ot-line.obj-code     = obj-list.obj-code
     3674               and buf_ot-line.obj-type     = obj-list.obj-type
     3675               and buf_ot-line.sum-type     = var-x-sum-type
     3676           :
     3677             find first buf_trn-doc no-lock
     3678               where buf_trn-doc.doc-code = buf_ot-line.doc-code
     3679             no-error .
     3680             if not available buf_trn-doc then do:
     3681               message
     3682                 vss-workfile vss-revision vss-description skip
     3683                 substitute( "Не найден складской документ &1.&2Документ не будет учтен в отчете." , buf_ot-line.doc-code , chr(10) )
     3684               view-as alert-box error .
     3685               next _buf_ot-line.
     3686             end.
     3687             assign
     3688               v-ot-line-qnty  = abs( buf_ot-line.fact-qnty * tt-gds.ms-base )
     3689             .
     3690             case buf_ot-line.ext-doc-type:
     3691               when 'ie':U  then do :
     3692                 if ( buf_trn-doc.cli-type = tt-gds.prod-type ) and
     3693                    ( buf_trn-doc.cli-code = tt-gds.prod-code )
     3694                 then do:
     3695                   assign
     3696                     v-pri-prod-qnty = v-pri-prod-qnty + v-ot-line-qnty
     3697                   .
     3698                 end.
     3699                 else do:
     3700                   assign
     3701                     v-pri-opt-qnty = v-pri-opt-qnty + v-ot-line-qnty
     3702                   .
     3703                 end.
     3704               end.
     3705               when 'iv':U     or
     3706               when 'rv':U
     3707               then do :
     3708                 _buf_parts:
     3709                 for each buf_parts no-lock
     3710                       where buf_parts.out-code  = buf_ot-line.doc-code
     3711                         and buf_parts.obj-type  = buf_ot-line.obj-type
     3712                         and buf_parts.obj-code  = buf_ot-line.obj-code
     3713                         and buf_parts.artic     = buf_ot-line.artic
     3714                         and buf_parts.prod-type = buf_ot-line.prod-type
     3715                         and buf_parts.prod-code = buf_ot-line.prod-code
     3716                 :
     3717                   run find-income-doc-code in this-procedure ( input buf_parts.in-code
     3718                                                              , input tt-gds.gds-code
     3719                                                              , input buf_parts.part-code
     3720                                                              , output v-income-doc-code
     3721                                                              ).
     3722                   find first sch_trn-doc no-lock
     3723                     where sch_trn-doc.doc-code = v-income-doc-code
     3724                   no-error .
     3725                   if not available sch_trn-doc then do:
     3726                     message
     3727                       substitute("Не могу найти накладную с номером: &1", buf_parts.in-code)
     3728                     view-as alert-box error .
     3729                     next _buf_parts.
     3730                   end.
     3731                   assign
     3732                     v-parts-line-qnty = ( buf_parts.fact-qnty * tt-gds.ms-base )
     3733                   .
     3734                   if    sch_trn-doc.ext-doc-type = 'ie':U
     3735                     and sch_trn-doc.fact-date   >= v-begin-date
     3736                     and sch_trn-doc.fact-date   <= v-end-date
     3737                   then do:
     3738                     find first buf_obj-list no-lock
     3739                       where buf_obj-list.obj-type = sch_trn-doc.obj-type
     3740                         and buf_obj-list.obj-code = sch_trn-doc.obj-code
     3741                     no-error .
     3742                     if available buf_obj-list then do :
     3743                       next _buf_parts.
     3744                     end.
     3745                   end.
     3746                   if ( sch_trn-doc.cli-type = tt-gds.prod-type ) and
     3747                      ( sch_trn-doc.cli-code = tt-gds.prod-code )
     3748                   then do:
     3749                     assign
     3750                       v-pri-prod-qnty = v-pri-prod-qnty + v-parts-line-qnty
     3751                     .
     3752                   end.
     3753                   else do:
     3754                     assign
     3755                       v-pri-opt-qnty = v-pri-opt-qnty + v-parts-line-qnty
     3756                     .
     3757                   end.
     3758                 end.
     3759               end.
     3760               when 'ee':U  then do :
     3761                 assign
     3762                   v-ras-oth-qnty = v-ras-oth-qnty + v-ot-line-qnty
     3763                 .
     3764               end.
     3765               when 'es':U  then do :
     3766                 assign
     3767                   v-ras-sel-qnty = v-ras-sel-qnty + v-ot-line-qnty
     3768                 .
     3769               end.
     3770               when 're':U  or
     3771               when 'rs':U
     3772               then do :
     3773                 assign
     3774                   v-pri-ret-qnty = v-pri-ret-qnty + v-ot-line-qnty
     3775                 .
     3776               end.
     3777               when 'ep':U then do :
     3778                 assign
     3779                   v-ras-ret-qnty = v-ras-ret-qnty + v-ot-line-qnty
     3780                 .
     3781               end.
     3782               when 'we':U  then do :
     3783                 assign
     3784                   v-ras-spi-qnty = v-ras-spi-qnty + v-ot-line-qnty
     3785                 .
     3786               end.
     3787               when 'ev':U then do :
     3788                 find first sch_trn-doc no-lock
     3789                   where sch_trn-doc.out-code = buf_trn-doc.doc-code
     3790                 no-error .
     3791                 if not available sch_trn-doc
     3792                 then do:
     3793                   message
     3794                     "Не найден документ внутреннего прихода для документа " buf_trn-doc.doc-code
     3795                   view-as alert-box error.
     3796                 end.
     3797                 find first buf_obj-list no-lock
     3798                   where buf_obj-list.obj-type = buf_trn-doc.cli-type
     3799                     and buf_obj-list.obj-code = buf_trn-doc.cli-code
     3800                 no-error .
     3801                 if available buf_obj-list and
     3802                    sch_trn-doc.status_ = 'факт':U
     3803                 then do :
     3804                   next _buf_ot-line.
     3805                 end.
     3806                 assign
     3807                   v-ras-oth-qnty = v-ras-oth-qnty + v-ot-line-qnty
     3808                 .
     3809               end.
     3810               when 'vt':U       or
     3811               when 'vp':U  or
     3812               when 'im':U
     3813               then do:
     3814                 assign
     3815                   v-ras-oth-qnty = v-ras-oth-qnty - buf_ot-line.fact-qnty * tt-gds.ms-base
     3816                 .
     3817               end.
     3818               otherwise do:
     3819               end.
     3820             end case.
     3821           end.
     3822           find first tt-report
     3823             where tt-report.obj-type       = obj-list.obj-type
     3824               and tt-report.obj-code       = obj-list.obj-code
     3825               and tt-report.type           = tt-gds.gds-man-type
     3826               and tt-report.alc-type-code  = buf_alc-type.alc-type-code
     3827           no-error .
     3828           if not available tt-report then do:
     3829             create tt-report.
     3830             assign
     3831               tt-report.obj-type       = obj-list.obj-type
     3832               tt-report.obj-code       = obj-list.obj-code
     3833               tt-report.type           = tt-gds.gds-man-type
     3834               tt-report.alc-type-code  = buf_alc-type.alc-type-code
     3835             .
     3836           end.
     3837           assign
     3838             tt-report.pri-prod-qnty   = tt-report.pri-prod-qnty + v-pri-prod-qnty
     3839             tt-report.pri-opt-qnty    = tt-report.pri-opt-qnty  + v-pri-opt-qnty
     3840             tt-report.pri-ret-qnty    = tt-report.pri-ret-qnty  + v-pri-ret-qnty
     3841             tt-report.ras-sel-qnty    = tt-report.ras-sel-qnty  + v-ras-sel-qnty
     3842             tt-report.ras-ret-qnty    = tt-report.ras-ret-qnty  + v-ras-ret-qnty
     3843             tt-report.ras-spi-qnty    = tt-report.ras-spi-qnty  + v-ras-spi-qnty
     3844             tt-report.ras-oth-qnty    = tt-report.ras-oth-qnty  + v-ras-oth-qnty
     3845             tt-report.pri-tot-qnty    = tt-report.pri-tot-qnty  + v-pri-prod-qnty
     3846                                                                 + v-pri-opt-qnty
     3847                                                                 + v-pri-ret-qnty
     3848             tt-report.ras-tot-qnty    = tt-report.ras-tot-qnty  + v-ras-sel-qnty
     3849                                                                 + v-ras-ret-qnty
     3850                                                                 + v-ras-spi-qnty
     3851                                                                 + v-ras-oth-qnty
     3852             v-pri-prod-qnty = 0
     3853             v-pri-opt-qnty  = 0
     3854             v-pri-ret-qnty  = 0
     3855             v-ras-sel-qnty  = 0
     3856             v-ras-ret-qnty  = 0
     3857             v-ras-spi-qnty  = 0
     3858             v-ras-oth-qnty  = 0
     3859           .
     3860         end.
     3861       end.
     3862     end.
     3863     define variable v-list-count    as integer   no-undo .
     3864     define variable v-gds-man-type  as integer   no-undo .
     3865     assign
     3866       v-list-count = num-entries("1,2,3":U)
     3867     .
     3868     for each buf_alc-type no-lock
     3869           where buf_alc-type.alc-type-status = 0 ,
     3870         each obj-list
     3871     :
     3872       do v-i = 1 to v-list-count :
     3873         assign
     3874           v-gds-man-type = integer( entry(v-i , "1,2,3":U) )
     3875         .
     3876         find first tt-report
     3877           where tt-report.obj-type       = obj-list.obj-type
     3878             and tt-report.obj-code       = obj-list.obj-code
     3879             and tt-report.type           = v-gds-man-type
     3880             and tt-report.alc-type-code  = buf_alc-type.alc-type-code
     3881         no-error .
     3882         if not available tt-report
     3883         then do:
     3884           create tt-report.
     3885           assign
     3886             tt-report.obj-type       = obj-list.obj-type
     3887             tt-report.obj-code       = obj-list.obj-code
     3888             tt-report.type           = v-gds-man-type
     3889             tt-report.alc-type-code  = buf_alc-type.alc-type-code
     3890             tt-report.alc-type-name  = buf_alc-type.alc-type-name
     3891           .
     3892         end.
     3893       end.
     3894     end.
     3895   end.
     3896   end procedure.
     3897   procedure find-income-doc-code :
     3898     define input  parameter p-in-code         like ub.parts.in-code    no-undo .
     3899     define input  parameter p-gds-code        like ub.goods.gds-code   no-undo .
     3900     define input  parameter p-part-code       like ub.parts.part-code  no-undo .
     3901     define output parameter p-income-doc-code like ub.parts.in-code    no-undo .
     3902   define buffer buf_parts-attr        for ub.parts-attr .
     3903   define buffer buf_income_parts-attr for ub.parts-attr .
     3904   do on error undo, return error return-value :
     3905     assign
     3906       p-income-doc-code = ?
     3907     .
     3908     find first buf_parts-attr no-lock
     3909       where buf_parts-attr.in-code   = p-in-code
     3910         and buf_parts-attr.gds-code  = p-gds-code
     3911         and buf_parts-attr.part-code = p-part-code
     3912     no-error .
     3913     if available buf_parts-attr then do:
     3914       find first buf_income_parts-attr no-lock
     3915         where buf_income_parts-attr.in-code   = buf_parts-attr.income-in-code
     3916           and buf_income_parts-attr.gds-code  = buf_parts-attr.income-gds-code
     3917           and buf_income_parts-attr.part-code = buf_parts-attr.income-part-code
     3918         no-error .
     3919       if available buf_income_parts-attr then do:
     3920         assign
     3921           p-income-doc-code = buf_parts-attr.income-in-code
     3922         .
     3923       end.
     3924       else do:
     3925         assign
     3926           p-income-doc-code = ?
     3927         .
     3928       end.
     3929     end.
     3930     else do:
     3931       assign
     3932         p-income-doc-code = ?
     3933       .
     3934     end.
     3935   end.
     3936   end procedure.
     3937   procedure get-sertificate :
     3938     define input  parameter p-obj-type    like ub.clients.obj-type no-undo .
     3939     define input  parameter p-obj-code    like ub.clients.obj-code no-undo .
     3940     define input  parameter p-date        as date                  no-undo .
     3941     define output  parameter p-sertificate as character no-undo .
     3942     define buffer buf_alc-sale-lic for ub.alc-sale-lic.
     3943   do
     3944   on error undo, return error return-value
     3945   :
     3946     find first buf_alc-sale-lic no-lock
     3947         where buf_alc-sale-lic.cli-type = p-obj-type
     3948           and buf_alc-sale-lic.cli-code = p-obj-code
     3949           and buf_alc-sale-lic.date-to  > p-date
     3950     no-error .
     3951     if available buf_alc-sale-lic then do:
     3952         assign
     3953           p-sertificate = substitute( "серия &1, № &2 от &3"
     3954                                     , buf_alc-sale-lic.seria
     3955                                     , buf_alc-sale-lic.number
     3956                                     , string( buf_alc-sale-lic.date-get , "99.99.9999" )
     3957                                     )
     3958         .
     3959     end.
     3960     else do:
     3961       assign
     3962         p-sertificate = ""
     3963       .
     3964     end.
     3965   end.
     3966   end procedure.
