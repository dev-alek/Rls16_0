     2173   define variable vss-include-info15 as character format "X(65)" no-undo
     2174   initial "@(#)$Workfile$ $Revision$".
     2175   define variable v-fmtcli-name          as character    no-undo.
     2176   define variable v-fmtcli-engl-name     as character    no-undo.
     2177   define variable v-fmtcli-addres        as character    no-undo.
     2178   define variable v-fmtcli-post-addres   as character    no-undo.
     2179   define variable v-fmtcli-full-addres   as character    no-undo.
     2180   define variable v-fmtcli-phone         as character    no-undo.
