     1016   define variable sym12 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1017   define variable sym13 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1018   define variable sym14 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1019   define variable sym15 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1020   define variable sym16 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1021   define variable sym17 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1022   define variable sym18 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1023   define variable sym19 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1024   define variable sym20 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1025   define variable sym21 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1026   define variable sym22 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1027   define variable sym23 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1028   define variable sym24 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1029   define variable sym25 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1030   define variable sym26 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1031   define variable sym27 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1032   define variable temp1 as integer   no-undo.
     1033   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1034   procedure factord :
     1035     define input  parameter p-fact-date            as date    no-undo .
     1036     define input  parameter p-fact-time            as integer no-undo .
     1037     define input  parameter p-fact-num             as integer no-undo .
     1038     define input  parameter p-shift-date           as date    no-undo .
     1039     define input  parameter p-shift-num            as integer no-undo .
     1040     define input  parameter p-shift-on             as logical no-undo .
     1041     define output parameter p-fact-order           as decimal no-undo .
     1042     define output parameter p-shift-end-fact-order as decimal no-undo .
     1043     define output parameter p-day-end-fact-order   as decimal no-undo .
     1044     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1045     if p-fact-date = ?
     1046     then do:
     1047       return error "Не указана фактическая дата" .
     1048     end.
     1049     define variable v-fact-date-num as integer no-undo .
     1050     assign
     1051       v-fact-date-num = integer(p-fact-date)
     1052     .
     1053     if p-fact-num = ?
     1054     or p-fact-num = 0
     1055     then do:
     1056       return error "Не задан p-fact-num " + string(p-fact-num) .
     1057     end.
     1058     if p-fact-num < 0
     1059     then do:
     1060       return error "Отрицательный fact-num " + string(p-fact-num) .
     1061     end.
     1062     if p-fact-num >= 100000000
     1063     then do:
     1064       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1065     end.
     1066     if p-shift-on = true
     1067     then do:
     1068       if p-shift-date = ?
     1069       then do:
     1070         return error "Не задана дата смены" .
     1071       end.
     1072       if p-shift-num = ?
     1073       or p-shift-num = 0
     1074       then do:
     1075         return error "Не задан номер смены" .
     1076       end.
     1077     end.
     1078     else do:
     1079       assign
     1080         p-shift-date = p-fact-date
     1081         p-shift-num  = 24
     1082       .
     1083     end.
     1084     define variable v-shift-offset as integer no-undo .
     1085     if p-shift-date = p-fact-date
     1086     then do:
     1087       assign
     1088         v-shift-offset = 1
     1089       .
     1090     end.
     1091     if p-shift-date < p-fact-date
     1092     then do:
     1093       assign
     1094         v-shift-offset = 0
     1095       .
     1096     end.
     1097     if p-shift-date > p-fact-date
     1098     then do:
     1099       message
     1100         vss-workfile vss-revision vss-description skip
     1101         "Неправильная дата закрытия смены" skip
     1102         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1103         view-as alert-box error .
     1104       undo, return error
     1105         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1106           ,string(p-fact-date, '99/99/9999':U)
     1107           ,string(p-shift-date, '99/99/9999':U)
     1108           )
     1109       .
     1110     end.
     1111     if p-shift-num < 1
     1112     or p-shift-num > 24
     1113     then do:
     1114       message
     1115         vss-workfile vss-revision vss-description skip
     1116         "Неправильный номер смены" skip
     1117         "p-shift-num" p-shift-num skip
     1118         view-as alert-box error .
     1119       undo, return error return-value .
     1120     end.
     1121     assign
     1122       p-fact-order           = v-fact-date-num
     1123                              + v-shift-offset * 0.5
     1124                              + p-shift-num    * 0.02 - 0.01
     1125                              + p-fact-num     * 0.0000000001
     1126       p-shift-end-fact-order = v-fact-date-num
     1127                              + v-shift-offset * 0.5
     1128                              + p-shift-num    * 0.02
     1129       p-day-end-fact-order   = v-fact-date-num
     1130                              + 0.99
     1131     .
     1132     if p-fact-order           <= v-fact-date-num
     1133     or p-shift-end-fact-order <= v-fact-date-num
     1134     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1135     or p-shift-end-fact-order >= p-day-end-fact-order
     1136     then do:
     1137       message
     1138         vss-workfile vss-revision vss-description skip
     1139         "Внутренняя ошибка при генерации фактического номера" skip
     1140         "p-fact-date"            p-fact-date            skip
     1141         "p-fact-time"            p-fact-time            skip
     1142         "p-fact-num"             p-fact-num             skip
     1143         "p-shift-date"           p-shift-date           skip
     1144         "p-shift-num"            p-shift-num            skip
     1145         "p-shift-on"             p-shift-on             skip
     1146         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1147         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1148         "v-fact-date-num"        v-fact-date-num        skip
     1149         view-as alert-box error .
     1150       undo, return error return-value .
     1151     end.
     1152   end procedure.
     1153   procedure day-begin-fact-order :
     1154     define input  parameter p-fact-date            as date    no-undo .
     1155     define output parameter p-day-begin-fact-order as decimal no-undo .
     1156     do
     1157     on error undo, return error return-value
     1158     :
     1159       if p-fact-date = ?
     1160       then do:
     1161         assign
     1162           p-day-begin-fact-order = 0
     1163         .
     1164       end.
     1165       else do:
     1166         assign
     1167           p-day-begin-fact-order = integer(p-fact-date)
     1168         .
     1169       end.
     1170     end.
     1171   end procedure.
     1172   procedure factord-max-fact-order :
     1173     define output parameter p-max-fact-order as decimal   no-undo .
     1174     do
     1175     on error undo, return error return-value
     1176     :
     1177       run day-begin-fact-order in this-procedure
     1178         (input  date(1, 1, 5000)
     1179         ,output p-max-fact-order
     1180         ) .
     1181     end.
     1182   end procedure.
     1183   procedure factord-cut-archive :
     1184     define input  parameter p-obj-type             as character no-undo .
     1185     define input  parameter p-obj-code             as integer   no-undo .
     1186     define input  parameter p-fact-date            as date      no-undo .
     1187     define output parameter p-shift-on             as logical   no-undo .
     1188     define output parameter p-shift-date           as date      no-undo .
     1189     define output parameter p-shift-num            as integer   no-undo .
     1190     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1191     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1192     define variable v-fact-order as decimal   no-undo .
     1193     define buffer buf_shift-obj for ub.shift-obj .
     1194     do
     1195     on error undo, return error return-value
     1196     :
     1197   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1198   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1199     (input  p-obj-type
     1200     ,input  p-obj-code
     1201     ,input  'shift-on=request'
     1202     ,output p-shift-on
     1203     ) no-error .
     1204       if error-status :error
     1205       then do:
     1206         message
     1207           vss-workfile vss-revision vss-description skip
     1208           "Ошибка при определении атрибута объекта" skip
     1209           "Объект" p-obj-type p-obj-code skip
     1210           error-status :get-message(1) skip
     1211           return-value skip
     1212           view-as alert-box error .
     1213         undo, return error return-value .
     1214       end.
     1215       if p-shift-on = false
     1216       then do:
     1217         assign
     1218           p-shift-date               = ?
     1219           p-shift-num                = 0
     1220         .
     1221       end.
     1222       else do:
     1223         find first buf_shift-obj share-lock
     1224           where buf_shift-obj.obj-type   = p-obj-type
     1225             and buf_shift-obj.obj-code   = p-obj-code
     1226             and buf_shift-obj.shift-date > p-fact-date
     1227           use-index pi
     1228           no-error .
     1229         if not available buf_shift-obj
     1230         or buf_shift-obj.status_ <> 'зкр':U
     1231         then do:
     1232           message
     1233             vss-workfile vss-revision vss-description skip
     1234             "Невозможно вычислить последнюю смену" skip
     1235             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1236             "Объект" p-obj-type p-obj-code skip
     1237             "Дата" p-fact-date skip
     1238             view-as alert-box error .
     1239           undo, return error return-value .
     1240         end.
     1241         find last buf_shift-obj share-lock
     1242           where buf_shift-obj.obj-type = p-obj-type
     1243             and buf_shift-obj.obj-code = p-obj-code
     1244             and buf_shift-obj.shift-date <= p-fact-date
     1245           use-index pi
     1246           no-error .
     1247         if available buf_shift-obj
     1248         then do:
     1249           if  buf_shift-obj.status_ = 'зкр':U
     1250           then do:
     1251             assign
     1252               p-shift-date = buf_shift-obj.shift-date
     1253               p-shift-num  = buf_shift-obj.shift-num
     1254             .
     1255           end.
     1256           else do:
     1257             message
     1258               vss-workfile vss-revision vss-description skip
     1259               "Невозможно вычислить последнюю смену" skip
     1260               "Статус смены отличен от статуса" 'зкр':U skip
     1261               "Объект" p-obj-type p-obj-code skip
     1262               "Дата" p-fact-date skip
     1263               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1264               view-as alert-box error .
     1265             undo, return error return-value .
     1266           end.
     1267         end.
     1268         else do:
     1269           assign
     1270             p-shift-date = p-fact-date - 1
     1271             p-shift-num  = 1
     1272           .
     1273         end.
     1274       end.
     1275       run factord in this-procedure
     1276         (input  p-fact-date
     1277         ,input  1
     1278         ,input  1
     1279         ,input  p-shift-date
     1280         ,input  p-shift-num
     1281         ,input  p-shift-on
     1282         ,output v-fact-order
     1283         ,output p-shift-end-fact-order
     1284         ,output p-day-end-fact-order
     1285         ) no-error .
     1286       if error-status :error
     1287       then do:
     1288         message
     1289           vss-workfile vss-revision vss-description skip
     1290           "Ошибка при вызове процедуры factord"
     1291           error-status :get-message(1) skip
     1292           return-value skip
     1293           view-as alert-box error .
     1294         undo, return error return-value .
     1295       end.
     1296     end.
     1297   end procedure.
     1298   procedure factord-lock-shift :
     1299     define input  parameter p-obj-type  as character no-undo .
     1300     define input  parameter p-obj-code  as integer   no-undo .
     1301     define input  parameter p-fact-date as date      no-undo .
     1302     define parameter buffer buf_shift-obj for ub.shift-obj .
     1303     define variable v-shift-on      as logical   no-undo .
     1304     define variable v-extra-message as character no-undo .
     1305     define variable v-error as character no-undo .
     1306     do
     1307     on error undo, return error return-value
     1308     :
     1309   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1310   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1311     (input  p-obj-type
     1312     ,input  p-obj-code
     1313     ,input  'shift-on=request'
     1314     ,output v-shift-on
     1315     ) no-error .
     1316       if error-status :error
     1317       then do:
     1318         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1319         undo, return error v-error .
     1320       end.
     1321       if v-shift-on = true
     1322       then do:
     1323         find first buf_shift-obj share-lock
     1324           where buf_shift-obj.obj-type   = p-obj-type
     1325             and buf_shift-obj.obj-code   = p-obj-code
     1326             and buf_shift-obj.shift-date > p-fact-date
     1327           use-index pi
     1328           no-error .
     1329         if not available buf_shift-obj
     1330         or buf_shift-obj.status_ <> 'зкр':U
     1331         then do:
     1332           find last buf_shift-obj
     1333             where buf_shift-obj.obj-type = p-obj-type
     1334               and buf_shift-obj.obj-code = p-obj-code
     1335               and buf_shift-obj.status_  = 'зкр':U
     1336             use-index stts
     1337             no-error .
     1338           if available buf_shift-obj
     1339           then do:
     1340             assign
     1341               v-extra-message =
     1342                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1343                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1344                               )
     1345             .
     1346           end.
     1347           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1348           undo, return error v-error .
     1349         end.
     1350       end.
     1351     end.
     1352   end procedure.
     1353   procedure factord-end-day :
     1354     define input  parameter p-fact-date            as date    no-undo .
     1355     define output parameter p-day-end-fact-order   as decimal no-undo .
     1356     do
     1357     on error undo, return error return-value
     1358     :
     1359       if p-fact-date = ?
     1360       then do:
     1361         return error "Не указана фактическая дата" .
     1362       end.
     1363       assign
     1364         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1365       .
     1366     end.
     1367   end procedure.
     1368   procedure factord-to-date :
     1369     define input  parameter p-fact-order as decimal no-undo .
     1370     define output parameter p-fact-date  as date    no-undo .
     1371     define variable v-ref-date  as date      no-undo .
     1372     define variable v-ref-delta as integer   no-undo .
     1373     do
     1374     on error undo, return error return-value
     1375     :
     1376       if p-fact-order = ?
     1377       or p-fact-order = 0
     1378       then do:
     1379         return error "Не указан fact-order" .
     1380       end.
     1381       assign
     1382         v-ref-date  = date(1, 1, 2000)
     1383       .
     1384       assign
     1385         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1386       .
     1387       assign
     1388         p-fact-date = v-ref-date + v-ref-delta
     1389       .
     1390     end.
     1391   end procedure.
     1392   procedure factord-to-fact-num :
     1393     define input  parameter p-fact-order as decimal no-undo .
     1394     define output parameter p-fact-num   as integer no-undo .
     1395     define variable v-fact-order-trunc as decimal no-undo .
     1396     do
     1397     on error undo, return error return-value
     1398     :
     1399       if p-fact-order = ?
     1400       or p-fact-order = 0
     1401       then do:
     1402         return error "Не указан fact-order" .
     1403       end.
     1404       assign
     1405        v-fact-order-trunc = truncate(p-fact-order, 2)
     1406       .
     1407       assign
     1408         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1409       .
     1410     end.
     1411   end procedure.
     1412   procedure factord-to-shift-num :
     1413     define input  parameter p-fact-order as decimal no-undo .
     1414     define output parameter p-shift-num   as integer no-undo .
     1415     define variable  p-shift-numd  as decimal   no-undo .
     1416     define variable v-fact-order-trunc as decimal no-undo .
     1417     do
     1418     on error undo, return error return-value
     1419     :
     1420       if p-fact-order = ?
     1421       or p-fact-order = 0
     1422       then do:
     1423         return error "Не указан fact-order" .
     1424       end.
     1425       assign
     1426        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1427       .
     1428       if v-fact-order-trunc < 0.5 then do:
     1429         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1430       end.
     1431       assign
     1432         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1433         .
     1434        assign
     1435         p-shift-num = truncate (p-shift-numd , 0)
     1436       .
     1437     end.
     1438   end procedure.
     1439   procedure ost-line :
     1440     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     1441     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     1442     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     1443     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     1444     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     1445     define input  parameter x-tog-shift  as logical no-undo .
     1446     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     1447     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     1448     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     1449     define input  parameter xtog-obj     as logical no-undo .
     1450     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     1451     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     1452     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     1453     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     1454     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     1455     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     1456     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     1457     define buffer buff-obj-list  for obj-list .
     1458     define buffer buff-stk-line  for ub.stk-line .
     1459     assign
     1460       Quantity = 0
     1461       Coast_R  = 0
     1462       Coast_V  = 0
     1463       VAT_R    = 0
     1464       VAT_V    = 0
     1465       SLT_R    = 0
     1466       SLT_V    = 0
     1467     .
     1468     if  x-tog-shift = false then do:
     1469       for each buff-obj-list no-lock
     1470         where xtog-obj = false
     1471            or (buff-obj-list.obj-type = x-store-type
     1472               and buff-obj-list.obj-code = x-store-code
     1473               )
     1474       on error undo, return error
     1475       :
     1476         find last buff-stk-line no-lock
     1477           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1478             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1479             and buff-stk-line.artic      = x-artic
     1480             and buff-stk-line.prod-type  = x-prod-type
     1481             and buff-stk-line.prod-code  = x-prod-code
     1482             and buff-stk-line.sum-type   = x-sum-type
     1483             and buff-stk-line.cat-id     = '##,##':U
     1484             and buff-stk-line.fact-order <= x-fact-order
     1485             and buff-stk-line.shift-num  = 0
     1486           use-index category
     1487           no-error .
     1488         if available buff-stk-line then do:
     1489           assign
     1490             Quantity = Quantity +  buff-stk-line.fact-qnty
     1491             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     1492             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     1493             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     1494             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     1495             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     1496             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     1497           .
     1498         end.
     1499       end.
     1500     end.
     1501     else do:
     1502       for each buff-obj-list no-lock
     1503         where xtog-obj = false
     1504            or (buff-obj-list.obj-type = x-store-type
     1505               and buff-obj-list.obj-code = x-store-code
     1506               )
     1507       on error undo, return error
     1508       :
     1509         find last buff-stk-line no-lock
     1510           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1511             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1512             and buff-stk-line.artic      = x-artic
     1513             and buff-stk-line.prod-type  = x-prod-type
     1514             and buff-stk-line.prod-code  = x-prod-code
     1515             and buff-stk-line.sum-type   = x-sum-type
     1516             and buff-stk-line.cat-id     = '##,##':U
     1517             and buff-stk-line.fact-order <= x-fact-order
     1518             and buff-stk-line.shift-num  > 0
     1519           use-index category
     1520           no-error .
     1521         if available buff-stk-line then do:
     1522           assign
     1523             Quantity = Quantity +  buff-stk-line.fact-qnty
     1524             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     1525             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     1526             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     1527             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     1528             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     1529             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     1530           .
     1531         end.
     1532       end.
     1533     end.
     1534   end procedure.
     1535   procedure ost-lineother-tax :
     1536     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     1537     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     1538     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     1539     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     1540     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     1541     define input  parameter x-tog-shift  as logical no-undo .
     1542     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     1543     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     1544     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     1545     define input  parameter xTog-obj     as logical no-undo .
     1546     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     1547     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     1548     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     1549     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     1550     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     1551     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     1552     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     1553     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     1554     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     1555     define buffer buff-obj-list  for obj-list .
     1556     define buffer buff-stk-line  for ub.stk-line .
     1557     assign
     1558       Quantity = 0
     1559       Coast_R  = 0
     1560       Coast_V  = 0
     1561       VAT_R    = 0
     1562       VAT_V    = 0
     1563       SLT_R    = 0
     1564       SLT_V    = 0
     1565       other_R  = 0
     1566       other_V  = 0
     1567     .
     1568     if  x-tog-shift = false then do:
     1569       for each buff-obj-list no-lock
     1570         where xtog-obj = false
     1571            or (buff-obj-list.obj-type = x-store-type
     1572               and buff-obj-list.obj-code = x-store-code
     1573               )
     1574       on error undo, return error
     1575       :
     1576         find last buff-stk-line no-lock
     1577           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1578             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1579             and buff-stk-line.artic      = x-artic
     1580             and buff-stk-line.prod-type  = x-prod-type
     1581             and buff-stk-line.prod-code  = x-prod-code
     1582             and buff-stk-line.sum-type   = x-sum-type
     1583             and buff-stk-line.cat-id     = '##,##':U
     1584             and buff-stk-line.fact-order <= x-fact-order
     1585             and buff-stk-line.shift-num  = 0
     1586           use-index category
     1587           no-error .
     1588         if available buff-stk-line then do:
     1589           assign
     1590             Quantity = Quantity +  buff-stk-line.fact-qnty
     1591             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     1592             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     1593             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     1594             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     1595             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     1596             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     1597             other_R  = other_R  +  buff-stk-line.other-rubl
     1598             other_V  = other_V  +  buff-stk-line.other-base
     1599           .
     1600         end.
     1601       end.
     1602     end.
     1603     else do:
     1604       for each buff-obj-list no-lock
     1605         where xtog-obj = false
     1606            or (buff-obj-list.obj-type = x-store-type
     1607               and buff-obj-list.obj-code = x-store-code
     1608               )
     1609       on error undo, return error
     1610       :
     1611         find last buff-stk-line no-lock
     1612           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1613             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1614             and buff-stk-line.artic      = x-artic
     1615             and buff-stk-line.prod-type  = x-prod-type
     1616             and buff-stk-line.prod-code  = x-prod-code
     1617             and buff-stk-line.sum-type   = x-sum-type
     1618             and buff-stk-line.cat-id     = '##,##':U
     1619             and buff-stk-line.fact-order <= x-fact-order
     1620             and buff-stk-line.shift-num  > 0
     1621           use-index category
     1622           no-error .
     1623         if available buff-stk-line then do:
     1624           assign
     1625             Quantity = Quantity +  buff-stk-line.fact-qnty
     1626             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     1627             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     1628             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     1629             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     1630             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     1631             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     1632             other_R = other_R   +  buff-stk-line.other-rubl
     1633             other_V = other_V   +  buff-stk-line.other-base
     1634           .
     1635         end.
     1636       end.
     1637     end.
     1638   end procedure.
     1639   procedure ost-line-kg :
     1640     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     1641     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     1642     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     1643     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     1644     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     1645     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     1646     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     1647     define buffer buff-obj-list  for obj-list .
     1648     define buffer buf_doc-line for ub.doc-line .
     1649     define buffer buf_inv-line for ub.inv-line .
     1650     do
     1651     on error undo, return error
     1652     :
     1653       for each buf_doc-line no-lock where
     1654                buf_doc-line.obj-type    = p-obj-type   and
     1655                buf_doc-line.obj-code    = p-obj-code   and
     1656                buf_doc-line.prod-type   = p-prod-type  and
     1657                buf_doc-line.prod-code   = p-prod-code  and
     1658                buf_doc-line.artic       = p-artic      and
     1659                buf_doc-line.status_     = 'факт':U      and
     1660                buf_doc-line.fact-order <= p-fact-order
     1661             by buf_doc-line.fact-order    descending
     1662       :
     1663         find first buf_inv-line no-lock where
     1664                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     1665                    buf_inv-line.artic     = buf_doc-line.artic     and
     1666                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     1667                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     1668         if available buf_inv-line
     1669         then do:
     1670           if buf_inv-line.after-cli-qnty <> ?
     1671           then do:
     1672             assign
     1673               p-quantity-kg = buf_inv-line.after-cli-qnty
     1674             .
     1675             leave .
     1676           end.
     1677         end.
     1678       end.
     1679       if p-quantity-kg = ?
     1680       then do:
     1681         assign
     1682           p-quantity-kg = 0
     1683         .
     1684       end.
     1685     end.
     1686   end procedure.
     1687   define temp-table temp-font no-undo
     1688     field fontnum  as integer
     1689     field fontname as character
     1690     field fontsize as character
     1691     field fonttype as character
     1692     field font-h   as integer
     1693     field font-w   as integer
     1694     field v-row    as integer
     1695     field v-col    as integer
     1696     field v-row-lans as integer
     1697     field v-col-lans as integer
     1698   index pi fontnum
     1699   .
     1700   procedure get-font-ini :
     1701     do
     1702     on error undo, return error return-value
     1703     :
     1704   define variable ii as integer   no-undo .
     1705   define variable v-font7 as character no-undo .
     1706   define variable v-font as character no-undo .
     1707   define variable loc-name as character no-undo .
     1708   define variable loc-size as character no-undo .
     1709   define variable loc-type as character no-undo .
     1710   define variable old_H as integer   no-undo .
     1711   define variable old_w as integer   no-undo .
     1712   define variable old-row  as integer   no-undo .
     1713   define variable old-col  as integer   no-undo .
     1714   define variable old-row-lans  as integer   no-undo .
     1715   define variable old-col-lans  as integer   no-undo .
     1716   define variable vv as integer   no-undo .
     1717   empty temp-table temp-font.
     1718     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     1719       case num-entries (v-font7) :
     1720         when 4 then do:
     1721             assign
     1722               loc-name = entry ( 1 , v-font7 )
     1723               loc-size = entry ( 2 , v-font7 )
     1724               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     1725             .
     1726         end.
     1727         when 3 then do:
     1728             assign
     1729               loc-name = entry ( 1 , v-font7 )
     1730               loc-size = entry ( 2 , v-font7 )
     1731               loc-type = entry ( 3 , v-font7 )
     1732             .
     1733         end.
     1734         when 2 then  do:
     1735             assign
     1736               loc-name = entry ( 1 , v-font7 )
     1737               loc-size = entry ( 2 , v-font7 )
     1738               loc-type = ""
     1739             .
     1740         end.
     1741         when 1 then do:
     1742             assign
     1743               loc-name = trim(entry ( 1 , v-font7 ))
     1744               loc-size = ""
     1745               loc-type = ""
     1746             .
     1747         end.
     1748       end case.
     1749     create temp-font.
     1750     assign
     1751       temp-font.fontnum  = 7
     1752       temp-font.fontname = trim(loc-name)
     1753       temp-font.fontsize = trim(loc-size)
     1754       temp-font.fonttype = trim(loc-type)
     1755       temp-font.v-row    = 62
     1756       temp-font.v-col    = 136
     1757       temp-font.v-row-lans = 43
     1758       temp-font.v-col-lans = 198
     1759     .
     1760     repeat ii = 16 to 100 :
     1761       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     1762       if v-font = "" or v-font = ? then leave.
     1763       case num-entries (v-font) :
     1764         when 4 then do:
     1765             assign
     1766               loc-name = entry ( 1 , v-font )
     1767               loc-size = entry ( 2 , v-font )
     1768               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     1769             .
     1770         end.
     1771         when 3 then do:
     1772             assign
     1773               loc-name = entry ( 1 , v-font )
     1774               loc-size = entry ( 2 , v-font )
     1775               loc-type = entry ( 3 , v-font )
     1776             .
     1777         end.
     1778         when 2 then do:
     1779             assign
     1780               loc-name = entry ( 1 , v-font )
     1781               loc-size = entry ( 2 , v-font )
     1782               loc-type = ""
     1783             .
     1784         end.
     1785         when 1 then do:
     1786             assign
     1787               loc-name = trim(entry ( 1 , v-font ))
     1788               loc-size = ""
     1789               loc-type = ""
     1790             .
     1791         end.
     1792       end case.
     1793     create temp-font.
     1794     assign
     1795       temp-font.fontnum  = ii
     1796       temp-font.fontname = trim(loc-name)
     1797       temp-font.fontsize = trim(loc-size)
     1798       temp-font.fonttype = trim(loc-type)
     1799     .
     1800     end.
     1801       for each temp-font :
     1802          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     1803          if  vv = ? then vv =  0 .
     1804           run rep/exfont.p (
     1805             input   temp-font.fontname ,
     1806             input   vv ,
     1807             input   temp-font.fonttype ,
     1808             output  temp-font.font-h   ,
     1809             output  temp-font.font-w   )
     1810           .
     1811       end.
     1812   find first temp-font where  temp-font.fontnum  = 7  .
     1813   old_H = temp-font.font-H .
     1814   old_w = temp-font.font-W .
     1815   old-row = temp-font.v-row .
     1816   old-col = temp-font.v-col .
     1817   old-row-lans = temp-font.v-row-lans .
     1818   old-col-lans = temp-font.v-col-lans .
     1819       for each temp-font where
     1820                temp-font.fontnum  <> 7 :
     1821           assign
     1822               temp-font.v-row    = old_H * old-row / temp-font.font-h
     1823               temp-font.v-col    = old_W * old-col / temp-font.font-W
     1824               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     1825               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     1826           .
     1827       end.
     1828     end.
     1829   end procedure.
     1830   PROCEDURE How-name :
     1831   define input  parameter h as integer no-undo .
     1832   define input  parameter w as integer no-undo .
     1833   define output parameter n as character  no-undo .
     1834   define variable A4port-H as integer   no-undo init 63.
     1835   define variable A4port-W as integer   no-undo init 136.
     1836   define variable A4lans-H as integer   no-undo init 43.
     1837   define variable A4lans-W as integer   no-undo init 198.
     1838   define variable Strim-W  as integer   no-undo init 278.
     1839   run define-a4-size (
     1840        input ReportFontNum
     1841       ,output A4port-H
     1842       ,output A4port-W
     1843       ,output A4lans-H
     1844       ,output A4lans-W ).
     1845   If w >= 1 and w <= A4port-W Then DO:
     1846     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1847     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     1848     If h > A4port-H              Then n = "to-file":U.
     1849   End.
     1850   If w > A4port-W and w <= A4lans-W Then DO:
     1851     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1852     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1853     If h > A4port-H              Then n = "to-file":U.
     1854   End.
     1855   If w > A4lans-W and w <= Strim-W Then DO:
     1856     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     1857     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1858     If h > A4port-H              Then n = "to-file":U.
     1859   End.
     1860   If w > Strim-W Then DO:
     1861      n = "to-file":U.
     1862   End.
     1863   END PROCEDURE.
     1864   PROCEDURE define-a4-size :
     1865   define input  parameter p-ReportFontNum as integer   no-undo .
     1866   define output parameter A4port-H as integer   no-undo .
     1867   define output parameter A4port-W as integer   no-undo .
     1868   define output parameter A4lans-H as integer   no-undo .
     1869   define output parameter A4lans-W as integer   no-undo .
     1870   if not can-find (first temp-font ) then do:
     1871      run get-font-ini .
     1872   end.
     1873   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     1874   if available temp-font then do:
     1875   assign
     1876     A4port-H = temp-font.v-row
     1877     A4port-W = temp-font.v-col
     1878     A4lans-H = temp-font.v-row-lans
     1879     A4lans-W = temp-font.v-col-lans
     1880   .
     1881   end.
     1882   else do:
     1883   assign
     1884     A4port-H = 63
     1885     A4port-W = 136
     1886     A4lans-H = 43
     1887     A4lans-W = 198
     1888   .
     1889   end.
     1890   END PROCEDURE.
     1891   def var vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1892   define new global shared variable g#attr-lib  as handle no-undo .
     1893   define variable v-attr-lib-variable as handle no-undo .
     1894   procedure clntattr-code :
     1895     define input  parameter p-code           as character no-undo .
     1896     define output parameter p-type           as character no-undo .
     1897     define output parameter p-format         as character no-undo .
     1898     define output parameter p-label          as character no-undo .
     1899     define output parameter p-user-can-edit  as logical   no-undo .
     1900     define output parameter p-output-display as logical   no-undo .
     1901     define output parameter p-other          as character no-undo .
     1902     do
     1903     on error undo, return error return-value
     1904     :
     1905           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-code in g#attr-lib
     1906         (input  p-code
     1907         ,output p-type
     1908         ,output p-format
     1909         ,output p-label
     1910         ,output p-user-can-edit
     1911         ,output p-output-display
     1912         ,output p-other
     1913         ) no-error .
     1914       if error-status :error
     1915       then do:
     1916         undo, return error return-value .
     1917       end.
     1918     end.
     1919   end procedure.
     1920   procedure clntattr-tooltip :
     1921     define input  parameter p-code    as character no-undo .
     1922     define output parameter p-tooltip as character no-undo .
     1923     define output parameter p-label   as character no-undo .
     1924     do
     1925     on error undo, return error return-value
     1926     :
     1927           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-tooltip in g#attr-lib
     1928         (input  p-code
     1929         ,output p-tooltip
     1930         ,output p-label
     1931         ) no-error .
     1932       if error-status :error
     1933       then do:
     1934         undo, return error return-value .
     1935       end.
     1936     end.
     1937   end procedure.
     1938   procedure clntattr-value :
     1939     define input  parameter p-obj-type like ub.clients-attr.obj-type   no-undo .
     1940     define input  parameter p-obj-code like ub.clients-attr.obj-code   no-undo .
     1941     define input  parameter p-code     like ub.clients-attr.attr-code  no-undo .
     1942     define output parameter p-value    like ub.clients-attr.attr-value no-undo .
     1943     define output parameter p-type     as character no-undo .
     1944     do
     1945     on error undo, return error return-value
