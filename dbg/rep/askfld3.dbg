      946        A4-port AT ROW 23.75 COL 15.38 COLON-ALIGNED NO-LABEL
      947        a4-lansc AT ROW 23.92 COL 13.88 COLON-ALIGNED NO-LABEL
      948        only-file AT ROW 24 COL 7.25 COLON-ALIGNED NO-LABEL
      949        "Показать":C8 VIEW-AS TEXT
      950             SIZE 8.88 BY .67 AT ROW 2 COL 51.5
      951             FGCOLOR 4
      952       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      953            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      954            DEFAULT-BUTTON B-exit CANCEL-BUTTON B-quit.
      955   DEFINE FRAME dialog-Frame
      956        "Колонки":C28 VIEW-AS TEXT
      957             SIZE 27.38 BY .67 AT ROW 2.08 COL 2.25
      958             FGCOLOR 4
      959        SPACE(32.24) SKIP(23.16)
      960       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      961            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      962            TITLE "Выбор колонок для печати партий по АПТЕКЕ"
      963            DEFAULT-BUTTON B-exit CANCEL-BUTTON B-quit.
      964   ASSIGN
      965          FRAME dialog-Frame:SCROLLABLE       = FALSE
      966          FRAME dialog-Frame:HIDDEN           = TRUE.
      967   ASSIGN
      968          A-3:HIDDEN IN FRAME dialog-Frame           = TRUE.
      969   ASSIGN
      970          B-help:HIDDEN IN FRAME dialog-Frame           = TRUE.
      971   ASSIGN
      972          B-unmark:HIDDEN IN FRAME dialog-Frame           = TRUE.
      973   ASSIGN
      974          only-text-exel:READ-ONLY IN FRAME dialog-Frame        = TRUE.
      975   ON WINDOW-CLOSE OF FRAME dialog-Frame
      976   DO:
      977     APPLY "END-ERROR":U TO SELF.
      978   END.
      979   ON CHOOSE OF A-3 IN FRAME dialog-Frame
      980   DO:
      981     Display a3  with frame dialog-Frame.
      982     Hide  A4-port  a4-lansc  only-file  in frame dialog-Frame.
      983     print-o = "A3-lansc":U.
      984   END.
      985   ON CHOOSE OF B-exit IN FRAME dialog-Frame
      986   DO:
      987     define variable l-ind as integer no-undo .
      988     run eq-frame.
      989    find first ubflt.usr-flt exclusive-lock
      990      where ubflt.usr-flt.user-name  = g#userid
      991        and ubflt.usr-flt.call-point = "e-obort3":U
      992      no-error .
      993       if not available ubflt.usr-flt then do:
      994         create ubflt.usr-flt.
      995         assign
      996         ubflt.usr-flt.user-name = g#userid
      997         ubflt.usr-flt.call-point   = "e-obort3":u
      998         ubflt.usr-flt.list_ = "" .
      999       end.
     1000      repeat l-ind = 97 to 120 :
     1001        if   use-column[ l-ind ] =  true then ubflt.usr-flt.list_ = ubflt.usr-flt.list_  + string( l-ind ) + "," .
     1002      End.
     1003      ubflt.usr-flt.list_ = ubflt.usr-flt.list_  + string( "print-o=" + print-o ) + ",prod-zen=" + string( prod-zen ) + "," .
     1004   END.
