     1410      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1411     RUN enable_UI.
     1412     define variable Log-Res1 as logical   no-undo .
     1413     define variable Log-Res2 as logical   no-undo .
     1414   define variable vss-include-info15 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1415   do:
     1416     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1417       (input  v-cntxt-db-num
     1418       ,input  v-cntxt-userid
     1419       ,input  0
     1420       ,input  'actn_reports_lookup-cost':U
     1421       ,input  'object':U
     1422       ,input  v-cntxt-host-code-obj
     1423       ,input  v-cntxt-obj-type
     1424       ,input  v-cntxt-obj-code
     1425       ,input  0
     1426       ,input  0
     1427       ,input  0
     1428       ,input  yes
     1429       ,output Log-Res1
     1430       )  .
     1431   end.
     1432     if not Log-Res1 then do:
     1433     end.
     1434   define variable vss-include-info16 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1435   do:
     1436     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1437       (input  v-cntxt-db-num
     1438       ,input  v-cntxt-userid
     1439       ,input  0
     1440       ,input  'actn_reports_lookup-crsa':U
     1441       ,input  'object':U
     1442       ,input  v-cntxt-host-code-obj
     1443       ,input  v-cntxt-obj-type
     1444       ,input  v-cntxt-obj-code
     1445       ,input  0
     1446       ,input  0
     1447       ,input  0
     1448       ,input  yes
     1449       ,output Log-Res2
     1450       )  .
     1451   end.
     1452     if not Log-Res2 then do:
     1453     end.
     1454     enable  tog-97 tog-98 tog-99 tog-100
     1455        TOG-101
     1456        TOG-102
     1457        TOG-103
     1458        TOG-104
     1459        TOG-105
     1460        TOG-106
     1461        TOG-107
     1462        TOG-108
     1463        TOG-109
     1464        TOG-110
     1465        TOG-111
     1466        TOG-112
     1467        TOG-113
     1468        TOG-114
     1469        TOG-115
     1470        TOG-116
     1471        TOG-117
     1472        TOG-118
     1473     with frame dialog-Frame.
     1474     display  tog-97 tog-98 tog-99 tog-100
     1475        TOG-101
     1476        TOG-102
     1477        TOG-103
     1478        TOG-104
     1479        TOG-105
     1480        TOG-106
     1481        TOG-107
     1482        TOG-108
     1483        TOG-109
     1484        TOG-110
