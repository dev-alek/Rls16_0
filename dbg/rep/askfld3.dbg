      650     ,output v-cntxt-host-code-obj
      651     ,output v-cntxt-host-name-obj
      652     )  .
      653   end.
      654   if v-cntxt-level = 'firm':U then do:
      655     find first ub.clients no-lock where
      656                ub.clients.obj-type = 'орг':U and
      657                ub.clients.obj-code = v-cntxt-host-code-obj no-error .
      658   if error-status :error then v-cntxt-host-name-obj = ? .
      659      else v-cntxt-host-name-obj = ub.clients.obj-name.
      660   end.
      661   if v-cntxt-level = 'object':U
      662   or v-cntxt-level = 'firm':U
      663   then do:
      664   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      665   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
      666     (input  v-cntxt-host-code-obj
