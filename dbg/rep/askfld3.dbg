     1103   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1104   on help of frame dialog-Frame
     1105   do:
     1106     run gbl/app_help.p
     1107       (input this-procedure :file-name
     1108       ,input ''
     1109       ,input ?
     1110       ) no-error.
     1111     if error-status :error then do:
     1112       message
     1113         "Ошибка при вызове помощи"
     1114         error-status :get-message(1)
     1115         view-as alert-box .
     1116     end.
     1117   end.
     1118   run minbtn-set in this-procedure .
     1119   on choose of b-help in frame dialog-Frame
     1120   do:
     1121     apply "help":u to frame dialog-Frame .
     1122   end.
     1123   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1124   procedure minbtn-set :
     1125       do
     1126           on error undo, return error return-value
     1127           :
     1128           define variable ii              as integer       no-undo .
     1129           define variable fh              as widget-handle no-undo .
     1130           define variable hh              as widget-handle no-undo .
     1131           define variable v-h             as handle        extent 4 no-undo .
     1132           define variable v-name-button   as character     no-undo .
     1133           define variable v-help-old-x    as decimal       no-undo .
     1134           define variable v-help-old-y    as decimal       no-undo .
     1135           define variable v-help-old-size as decimal       no-undo .
     1136           define variable v-frame-width   as decimal       no-undo .
     1137           define variable jj              as integer       no-undo .
     1138           do
     1139               on error undo, return error
     1140               :
     1141               assign
     1142                   v-frame-width = frame dialog-Frame:width - 0.3
     1143                   fh            = frame dialog-Frame:first-child
     1144                   hh            = fh:first-child
     1145                   ii            = 1
     1146                   .
     1147               do while valid-handle(hh):
     1148                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1149                   do:
     1150                       case lc(hh:name) :
     1151                           when "b-help" then
     1152                               do:
     1153                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1154                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1155                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1156                                   hh:TOOLTIP = "Помощь" .
     1157                                   v-help-old-x = hh:column .
     1158                                   v-help-old-y = hh:row    .
     1159                                   v-help-old-size = hh:width .
     1160                                   hh:width-chars = 2.5 .
     1161                               end.
     1162                           when "b-print" then
     1163                               do:
     1164                                   hh:load-image("cmp/b-print.bmp":u) .
     1165                                   hh:TOOLTIP = "Печать" .
     1166                                   v-h[ii] = hh:handle .
     1167                                   ii = ii + 1 .
     1168                                   hh:width-chars = 3 .
     1169                               end.
     1170                           when "b-history" or
     1171                           when "b-hist" then
     1172                               do:
     1173                                   hh:load-image("cmp/b-hist.bmp":u) .
     1174                                   hh:TOOLTIP = "История" .
     1175                                   v-h[ii] = hh:handle .
     1176                                   ii = ii + 1 .
     1177                                   hh:width-chars = 3 .
     1178                               end.
     1179                           when "b-sch" then
     1180                               do:
     1181                                   hh:load-image("cmp/b-sch.bmp":u) .
     1182                                   hh:TOOLTIP = "Установка Фильтра" .
     1183                                   v-h[ii] = hh:handle .
     1184                                   ii = ii + 1 .
     1185                                   hh:width-chars = 3 .
     1186                               end.
     1187                           when "b-hist-user" then
     1188                               do:
     1189                                   hh:load-image("cmp/b-hist.bmp":u) .
     1190                                   hh:TOOLTIP = "История пользователя" .
     1191                                   ii = ii + 1 .
     1192                               end.
     1193                       end case.
     1194                   end.
     1195                   hh = hh:next-sibling.
     1196               end.
     1197               b-help:column = v-frame-width - b-help:width-chars.
     1198               jj = 0.
     1199               repeat ii = 4 to 1 by -1 :
     1200                   if valid-handle (v-h[ii] ) then
     1201                   do:
     1202                       jj  = jj + 1 .
     1203                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1204                       v-h[ii]:row    = v-help-old-y .
     1205                   end.
     1206               end.
     1207           end.
     1208       end.
     1209   end procedure.
     1210   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME dialog-Frame:PARENT eq ?
     1211   THEN FRAME dialog-Frame:PARENT = ACTIVE-WINDOW.
     1212   define variable  all-empty  as integer no-undo init 0 .
     1213   define variable  ii  as integer no-undo init 0 .
     1214    find first ubflt.usr-flt no-lock
     1215      where ubflt.usr-flt.user-name  = g#userid
     1216        and ubflt.usr-flt.call-point = "e-obort3":U
     1217      no-error .
     1218    if NOT available ubflt.usr-flt then do:
     1219       create ubflt.usr-flt.
     1220       Assign
     1221         ubflt.usr-flt.user-name = g#userid
     1222         ubflt.usr-flt.call-point   = "e-obort3":U
     1223         ubflt.usr-flt.list_ = "" .
     1224    end.
     1225     repeat ii = 97 to 120 :
     1226       use-column[ii] = false  .
     1227       all-empty = 0.
     1228     end.
     1229     repeat ii = 97 to 120 :
     1230       if lookup( string(ii)  , ubflt.usr-flt.list_ ) > 0 then  do:
     1231         use-column[ii] = true .
     1232       end.
     1233       if use-column[ii] then all-empty  = all-empty + 1 .
     1234     end.
     1235    if all-empty =0 then do:
     1236       apply "CHOOSE" TO B-mark IN FRAME dialog-Frame.
     1237    end.
