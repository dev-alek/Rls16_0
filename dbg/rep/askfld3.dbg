     1497   RUN disable_UI.
     1498   PROCEDURE disable_UI :
     1499     HIDE FRAME dialog-Frame.
     1500   END PROCEDURE.
     1501   PROCEDURE enable_UI :
     1502     DISPLAY TOG-97 TOG-98 TOG-99 TOG-100 TOG-101 TOG-102 TOG-103 TOG-104 TOG-105
     1503             TOG-106 TOG-107 TOG-108 TOG-109 TOG-110 TOG-111 TOG-112 TOG-113
     1504             TOG-114 TOG-115 TOG-116 TOG-117 TOG-118 only-text-exel FILL-IN-97
     1505             FILL-IN-98 FILL-IN-99 FILL-IN-100 FILL-IN-101 FILL-IN-102 FILL-IN-103
     1506             FILL-IN-104 FILL-IN-105 FILL-IN-106 FILL-IN-107 FILL-IN-108
     1507             FILL-IN-109 FILL-IN-110 FILL-IN-111 FILL-IN-112 FILL-IN-113
     1508             FILL-IN-114 FILL-IN-115 FILL-IN-116 FILL-IN-117 FILL-IN-118 FILL-IN-51
     1509             F-col-size a3 A4-port a4-lansc only-file
     1510         WITH FRAME dialog-Frame.
     1511     ENABLE B-quit B-exit B-mark B-unmark B-help TOG-97 TOG-98 TOG-99 TOG-100
     1512            TOG-101 TOG-102 TOG-103 TOG-104 TOG-105 TOG-106 TOG-107 TOG-108
     1513            TOG-109 TOG-110 TOG-111 TOG-112 TOG-113 TOG-114 TOG-115 TOG-116
     1514            TOG-117 TOG-118 only-text-exel A-3 FILL-IN-97 FILL-IN-98 FILL-IN-99
     1515            FILL-IN-100 FILL-IN-101 FILL-IN-102 FILL-IN-103 FILL-IN-104
     1516            FILL-IN-105 FILL-IN-106 FILL-IN-107 FILL-IN-108 FILL-IN-109
     1517            FILL-IN-110 FILL-IN-111 FILL-IN-112 FILL-IN-113 FILL-IN-114
     1518            FILL-IN-115 FILL-IN-116 FILL-IN-117 FILL-IN-118 FILL-IN-51 F-col-size
     1519            a3 A4-port a4-lansc only-file
     1520         WITH FRAME dialog-Frame.
     1521     VIEW FRAME dialog-Frame.
     1522   END PROCEDURE.
     1523   PROCEDURE Show-format :
     1524   define variable ij as integer no-undo .
     1525     run eq-frame.
     1526     col-size = 0.
     1527     repeat ij = 1 to 120 :
     1528       if use-column[ij] then col-size = col-size + s-column[ij] + 1 .
     1529     End.
     1530     F-col-size:screen-value in frame dialog-Frame = string( col-size).
     1531     F-col-size = string(col-size).
     1532     Display F-col-size with frame dialog-Frame.
     1533     If col-size >= 1 and col-size <= 136 Then DO:
     1534       Display A4-port a-3  with frame dialog-Frame.
     1535       Hide a4-lansc a3 only-file only-text-exel in frame dialog-Frame.
     1536       print-o = "A4-port":U.
     1537     End.
     1538     If col-size > 136 and col-size <= 198 Then DO:
     1539       Display  a4-lansc a-3  with frame dialog-Frame.
     1540       Hide A4-port a3 only-file only-text-exel in frame dialog-Frame.
     1541       print-o = "A4-lansc":U.
     1542     End.
     1543     If col-size > 198 and col-size <= 235 Then DO:
     1544       Display a3 a-3  with frame dialog-Frame.
     1545       Hide A4-port a4-lansc only-text-exel  only-file in frame dialog-Frame.
     1546       print-o = "A3-lansc":U.
     1547     End.
     1548     If col-size > 235 Then DO:
     1549       Display only-file a-3 with frame dialog-Frame.
     1550       Hide A4-port a4-lansc a3 only-text-exel in frame dialog-Frame.
     1551       print-o = "to-file":U.
     1552     End.
     1553     If col-size > 550 Then DO:
     1554       Display  only-text-exel  with frame dialog-Frame.
     1555       Hide only-file a-3 A4-port a4-lansc a3 in frame dialog-Frame.
     1556       print-o = "to-file":U.
     1557     End.
     1558   END PROCEDURE.
     1559   procedure eq-frame:
     1560     Assign frame dialog-Frame  TOG-97 TOG-98 TOG-99 TOG-100 TOG-101 TOG-102 TOG-103 TOG-104 TOG-105 TOG-106 TOG-107 TOG-108 TOG-109 TOG-110 TOG-111 TOG-112 TOG-113 TOG-114 TOG-115 TOG-116 TOG-117 TOG-118 .
     1561     Assign
     1562       use-column[97]  =  TOG-97
     1563       use-column[98]  =  TOG-98
     1564       use-column[99]  =  TOG-99
     1565       use-column[100] =  TOG-100
     1566       use-column[101]  =  TOG-101
     1567       use-column[102]  =  TOG-102
     1568       use-column[103]  =  TOG-103
     1569       use-column[104]  =  TOG-104
     1570       use-column[105]  =  TOG-105
     1571       use-column[106]  =  TOG-106
     1572       use-column[107]  =  TOG-107
     1573       use-column[108]  =  TOG-108
     1574       use-column[109]  =  TOG-109
     1575       use-column[110]  =  TOG-110
     1576       use-column[111]  =  TOG-111
     1577       use-column[112]  =  TOG-112
     1578       use-column[113]  =  TOG-113
     1579       use-column[114]  =  TOG-114
     1580       use-column[115]  =  TOG-115
     1581       use-column[116]  =  TOG-116
     1582       use-column[117]  =  TOG-117
     1583       use-column[118]  =  TOG-118
