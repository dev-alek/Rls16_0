        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: r-ttn.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: rep/r-ttn.p $":U .
        7   define variable vss-description as character no-undo init "заказная программа - суммарное кол-во товаров по списку док-ов".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define input  parameter p-doc-list as character no-undo .
       67   define variable v-list-index as integer   no-undo .
       68   define variable v-qnty as decimal   no-undo .
       69   define variable is-torg12 as logical   no-undo .
       70   define variable is-torg13 as logical   no-undo .
       71   define buffer buf_trn-doc for trn-doc.
       72   define buffer buf_doc-line for trn-doc.
       73   define  stream str-export12.
       74   define  stream str-export13.
       75     if p-doc-list = "" then do:
       76       message "Нет выбранных документов!"  view-as alert-box.
       77       return.
       78     end.
       79     do v-list-index = 1 to num-entries( p-doc-list ):
       80       find first buf_trn-doc no-lock where recid(buf_trn-doc) = int(entry( v-list-index, p-doc-list)) no-error .
       81       if not available buf_trn-doc then next.
       82       if buf_trn-doc.status_ <> 'факт':U then do:
       83         message "Документ " buf_trn-doc.doc-code " не в статусе " 'факт':U " . Пропускаем."  view-as alert-box.
       84         next.
       85       end.
       86       if buf_trn-doc.internal = yes then do:
       87         if is-torg13 = no then do:
       88           OUTPUT STREAM str-export13 TO  VALUE("ТОРГ-13.txt").
       89           assign is-torg13 = yes .
       90         end.
       91       end.
       92       else do:
       93         if is-torg12 = no then do:
       94           OUTPUT STREAM str-export12 TO  VALUE("ТОРГ-12.txt").
       95           assign is-torg12 = yes .
       96         end.
       97       end.
       98       assign v-qnty = 0 .
       99       for each buf_doc-line no-lock where buf_doc-line.doc-code = buf_trn-doc.doc-code :
      100         assign v-qnty = v-qnty + buf_doc-line.fact-qnty .
      101       end.
      102       if buf_trn-doc.internal = yes then EXPORT STREAM str-export13 buf_trn-doc.doc-code v-qnty  .
      103       else                               EXPORT STREAM str-export12 buf_trn-doc.doc-code v-qnty  .
      104     end.
      105     if is-torg13 = yes then OUTPUT STREAM str-export13 CLOSE.
      106     if is-torg12 = yes then OUTPUT STREAM str-export12 CLOSE.
      107     if is-torg12 = yes or is-torg13 = yes then do:
      108       if search ("TTH.exe") <> ? then do:
      109         os-command silent value(search ("TTH.exe")) .
      110       end.
      111       else do:
      112         if search ("ТТН.exe") <> ? then do:
      113           os-command silent value(search ("ТТН.exe")) .
      114         end.
      115         else message "Файл TTH.exe не найден!" view-as alert-box.
      116       end.
      117     end.
      118     message
      119           "Экспорт выбранных документов в файлы ТОРГ-12.txt и/или ТОРГ-13.txt закончен"
      120   view-as alert-box.
