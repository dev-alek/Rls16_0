      323               "для товара с кодом: " internal-b-code skip
      324               view-as alert-box error title "подсчет контрольной суммы".
      325             return error.
      326           end.
      327           assign
      328             sum3 = sum3 + integer(v-sum-char3)
      329           .
      330         end.
      331         if varcont3 = yes then do:
      332           assign
      333             sum3 = sum3 * 3
      334           .
      335           do i3 = 2 to len-code3 by 2
      336           :
      337             assign
      338               v-sum-char3 = substr(full-b-code, len-code3 - i3 + 1, 1)
      339             .
      340             if v-sum-char3 < "0"
      341             or v-sum-char3 > "9"
      342             then do:
      343               message
      344                 "Невозможно сформировать бар-код" skip
      345                 "для товара с кодом: " internal-b-code skip
      346                 view-as alert-box error title "подсчет контрольной суммы".
      347               return error.
      348             end.
      349             assign
      350               sum3 = sum3 + integer(v-sum-char3)
      351             .
      352           end.
      353           if varcont3 = yes then do:
      354              if sum3 mod 10 = 0 then do:
      355                assign
      356                  full-b-code = full-b-code + '0'
      357                .
      358              end.
      359              else do:
