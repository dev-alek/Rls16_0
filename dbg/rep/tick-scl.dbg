      133   def new shared var bc-frmt as character no-undo .
      134   def new shared var bc-pfx  as character no-undo .
      135   def var bc-par-type as character no-undo .
      136       run gbl/conf-rd.p ("bc-frmt", "", "", 0, "", "", "",  no , output bc-frmt, output bc-par-type) no-error.
      137       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U OR not can-do ("EAN8,EAN13", bc-frmt) ) then
      138           do:
      139               message "Не задан или не верно задан ТИП собственного бар-кода!"
      140                   view-as alert-box ERROR TITLE "".
      141               return error.
      142           end.
      143       run gbl/conf-rd.p ("bc-pfx", "", "", 0, "", "", "",  no , output bc-pfx, output bc-par-type) no-error.
      144       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U ) then
      145           do:
      146               message "Не задан или не верно задан ПРЕФИКС бар-кода складского места!"
      147                   view-as alert-box ERROR TITLE "".
      148               return error.
      149           end.
      150   PROCEDURE gen-bc:
      151     def input  parameter internal-b-code like ub.bar-code.b-code no-undo .
      152     def output parameter full-b-code     as character init ""    no-undo .
      153   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      154     define variable tmp-str2  as character no-undo.
      155     define variable tmp-num2  as character no-undo.
      156     define variable i2        as integer   no-undo.
      157     define variable sum2      as integer   no-undo.
      158     define variable len-code2 as integer   no-undo.
      159     define variable varcont2  as logical   initial yes no-undo.
      160     CASE bc-frmt :
      161       WHEN "EAN13" THEN do:
      162         assign
      163           tmp-str2 = string( internal-b-code, "999999999999" )
      164         .
      165       end.
      166       WHEN "EAN8" THEN do:
      167         assign
      168           tmp-str2 = string( internal-b-code, "9999999" )
      169         .
      170       end.
      171       OTHERWISE DO:
      172           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " bc-frmt " ."
      173           view-as alert-box error.
      174           return error.
      175       END.
      176     END CASE.
      177     if varcont2 = yes then do:
      178       if integer( substring( tmp-str2, 1, length( bc-pfx ) ) ) <> 0
      179       then do:
      180         message
      181           "Невозможно сформировать бар-код" SKIP
      182           "для товара с кодом: " internal-b-code
      183           view-as alert-box error title "подрезание кода".
      184         return error.
      185       end.
      186       else do:
      187         assign
      188           full-b-code = bc-pfx + substring( tmp-str2, length( bc-pfx ) + 1, length( tmp-str2 ) - length( bc-pfx ) )
      189           len-code2    = length( full-b-code )
      190         .
      191         define variable v-sum-char2 as character no-undo .
      192         assign
      193           sum2 = 0
      194         .
      195         do i2 = 1 to len-code2 by 2
      196         :
      197           assign
      198             v-sum-char2 = substr(full-b-code, len-code2 - i2 + 1, 1)
      199           .
      200           if v-sum-char2 < "0"
      201           or v-sum-char2 > "9"
      202           then do:
      203             message
      204               "Невозможно сформировать бар-код" skip
      205               "для товара с кодом: " internal-b-code skip
      206               view-as alert-box error title "подсчет контрольной суммы".
      207             return error.
      208           end.
      209           assign
      210             sum2 = sum2 + integer(v-sum-char2)
      211           .
      212         end.
      213         if varcont2 = yes then do:
      214           assign
      215             sum2 = sum2 * 3
      216           .
      217           do i2 = 2 to len-code2 by 2
      218           :
      219             assign
      220               v-sum-char2 = substr(full-b-code, len-code2 - i2 + 1, 1)
      221             .
      222             if v-sum-char2 < "0"
      223             or v-sum-char2 > "9"
      224             then do:
      225               message
      226                 "Невозможно сформировать бар-код" skip
      227                 "для товара с кодом: " internal-b-code skip
      228                 view-as alert-box error title "подсчет контрольной суммы".
      229               return error.
      230             end.
      231             assign
      232               sum2 = sum2 + integer(v-sum-char2)
      233             .
      234           end.
      235           if varcont2 = yes then do:
      236              if sum2 mod 10 = 0 then do:
      237                assign
      238                  full-b-code = full-b-code + '0'
      239                .
      240              end.
      241              else do:
      242                assign
      243                  full-b-code = full-b-code + string(10 - sum2 mod 10)
      244                .
      245              end.
      246           end.
      247         end.
      248       end.
      249     end.
      250   END PROCEDURE.
      251   def new shared var pl-frmt as character no-undo .
      252   def new shared var pl-pfx  as character no-undo .
      253   def var pl-par-type as character no-undo .
      254       run gbl/conf-rd.p ("pl-frmt", "", "", 0, "", "", "",  no , output pl-frmt, output pl-par-type) no-error.
      255       if "new" = "bc" AND ( error-status:error OR pl-par-type <> "C":U OR not can-do ("EAN8,EAN13", pl-frmt) ) then
      256           do:
      257               message "Не задан или не верно задан ТИП собственного бар-кода!"
      258                   view-as alert-box ERROR TITLE "".
      259               return error.
      260           end.
      261       run gbl/conf-rd.p ("pl-pfx", "", "", 0, "", "", "",  no , output pl-pfx, output pl-par-type) no-error.
      262       if "new" = "bc" AND ( error-status:error OR pl-par-type <> "C":U ) then
      263           do:
      264               message "Не задан или не верно задан ПРЕФИКС бар-кода складского места!"
      265                   view-as alert-box ERROR TITLE "".
      266               return error.
      267           end.
      268   PROCEDURE gen-pl:
