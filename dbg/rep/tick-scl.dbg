      477       ,output v-value-logical7
      478       ,output v-param-type7
      479       ,INPUT-OUTPUT table-handle v-tth7
      480       )  .
      481   delete object v-tth7 no-error.
      482   how-pcnt-kat = ''.
      483   run adm/shattri.p (
      484       input "get":U
      485       ,input  p-obj-type
      486       ,input  p-obj-code
      487       ,input  'cd-inf-send':U
      488       ,input  'how-pcnt-kat':U
      489       ,output how-pcnt-kat
      490       ,output v-value-date6
      491       ,output v-value-decimal6
      492       ,output v-value-integer6
      493       ,output v-value-logical6
      494       ,output v-param-type6
      495       ,INPUT-OUTPUT table-handle v-tth6
      496       ) no-error .
      497   delete object v-tth6.
      498   if how-pcnt-kat = 'pcnt-kat-pdf':U then do:
      499     find first  buf_dis-thbj-rule6 No-LOCK  where
      500                 buf_dis-thbj-rule6.obj-type = p-obj-type
      501           AND  buf_dis-thbj-rule6.obj-code = p-obj-code
      502           and  buf_dis-thbj-rule6.pos-type = dflt-cd
      503           and  buf_dis-thbj-rule6.discnt-role = 'pcnt-kat-pdf':U
      504           and  buf_dis-thbj-rule6.nonunique = ''
      505           no-error .
      506     if not available buf_dis-thbj-rule6 then do:
      507   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      508   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      509     (input  p-obj-type
      510     ,input  p-obj-code
      511     ,output v-host-code6
      512     )  .
      513       find first  buf_dis-thbj-rule6 No-LOCK  where
      514                   buf_dis-thbj-rule6.obj-code = v-host-code6
      515             AND  buf_dis-thbj-rule6.obj-type = 'орг':U
      516             and  buf_dis-thbj-rule6.pos-type = dflt-cd
      517             and  buf_dis-thbj-rule6.discnt-role = 'pcnt-kat-pdf':U
      518             and  buf_dis-thbj-rule6.nonunique = ''
      519             no-error .
      520     end.
      521     if not available buf_dis-thbj-rule6 then do:
      522       find first  buf_dis-thbj-rule6 No-LOCK  where
      523                   buf_dis-thbj-rule6.obj-code = 0
      524             AND  buf_dis-thbj-rule6.obj-type = ''
      525             and  buf_dis-thbj-rule6.pos-type = dflt-cd
      526             and  buf_dis-thbj-rule6.discnt-role = 'pcnt-kat-pdf':U
      527             and  buf_dis-thbj-rule6.nonunique = ''
      528             no-error .
      529     end.
      530     if available buf_dis-thbj-rule6 then do:
      531       how-pcnt-kat = how-pcnt-kat + "=" + string(buf_dis-thbj-rule6.rule-num).
      532     end.
      533     else do:
      534       how-pcnt-kat = how-pcnt-kat + "="  + string(0).
      535     end.
      536   end.
      537   DEFINE VARIABLE b-count as integer init 0 no-undo.
      538   DEFINE VARIABLE v-fact-order        like ub.trn-doc.fact-order     no-undo.
      539   run rep/tickets.w (input parparentproc, input p-obj-type, input p-obj-code, input Action, input "" ).
      540   if TicketName = "" then
      541       RETURN.
      542   OUTPUT STREAM OutStream TO VALUE( lbc-tmp + "title" ) CONVERT TARGET TitleCP PAGE-SIZE 0 .
      543   if bc-rid = ? then do:
      544     if ScaleRid <> "" then  do:
      545             DO jj = 1 TO NUM-ENTRIES( ScaleRid ):
      546                 FIND ub.scales-gds WHERE recid( ub.scales-gds ) = integer( ENTRY( jj, ScaleRid ) ) NO-LOCK.
      547                 FIND ub.bar-code WHERE ub.bar-code.b-code = ub.scales-gds.b-code NO-LOCK.
      548                 run tick-prn.
      549             END.
      550     end.
      551     else do:
      552       FOR EACH ub.scales-gds WHERE
      553                 ub.scales-gds.db-num = p-db-Num AND
      554               ub.scales-gds.scales-num = ScaleNum NO-LOCK:
      555           FIND ub.bar-code WHERE ub.bar-code.b-code = ub.scales-gds.b-code NO-LOCK.
      556           run tick-prn.
      557       END.
      558     end.
      559   end.
      560   else do:
      561       FIND ub.bar-code WHERE recid(ub.bar-code) = bc-rid NO-LOCK.
      562       FIND ub.scales-gds WHERE
      563             ub.scales-gds.db-num = p-db-Num
      564       AND  ub.scales-gds.scales-num = ScaleNum
      565       AND ub.scales-gds.b-code = ub.bar-code.b-code NO-LOCK.
      566       run tick-prn.
      567   end.
      568   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      569   OUTPUT STREAM OutStream CLOSE.
      570   message
      571     substitute( "Передано на печать &1 этикеток (ценников)", b-count )
      572     view-as alert-box INFORMATION.
      573   os-command NO-WAIT value( substitute( "start &1run-lbc.bat &1 &2title &3 &4", lbc-path, lbc-tmp, TicketName, v-user-id ) ).
      574   end.
      575   PROCEDURE tick-prn:
      576       FIND ub.goods WHERE ub.goods.gds-code = ub.bar-code.gds-code NO-LOCK.
      577       FIND ub.gds-prt WHERE ub.gds-prt.upper-code = ub.goods.prt-root NO-LOCK.
      578       assign rootnode_code = ub.gds-prt.node-code.
      579   run rep/ticket.p (
      580                  buffer ub.goods
      581                 ,buffer ub.bar-code
      582                 ,buffer ub.scales-gds
      583                 ,input p-obj-type
      584                 ,input p-obj-code
      585                 ,input Action
      586                 ,input rootnode_code
      587                 ,input TickOnw
      588                 ,input TickOnN
      589                 ,input QntyType
      590                 ,input PriceType
      591                 ,input scaleprice
      592                 ,input nakl-qnty
      593                 ,input list-qnty
      594                 ,input pr-doc-rubl
      595                 ,input pr-doc-rb
      596                 ,input pr-doc-rubl-old
      597                 ,input pr-doc-rb-old
      598                 ,input v-fact-order
      599                 ,input ListProdBc
      600                 ,input curr-rate
      601                 ,input TickPS
      602                 ,input dflt-cd
      603                 ,input how-pcnt-kat
      604                 ,input-output b-count
      605                 ,input v-part-code
      606                 ,input v-doc-code
      607                 ,input v-promo-code
      608                 ,input v-ActionId
      609                 ,input v-db-num
      610                 ) no-error .
      611   END PROCEDURE.
