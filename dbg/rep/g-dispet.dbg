      631   define variable var-report-r-b as character no-undo .
      632   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      633   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      634     (output var-report-r-b
      635     )  .
      636   do
      637   on error undo, return error
      638   :
      639   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      640     run mainmenu_getcntxt in parparentproc
      641       (output v-cntxt-db-num
      642       ,output v-cntxt-userid
      643       ,output v-cntxt-level
      644       ,output v-cntxt-host-code-obj
      645       ,output v-cntxt-obj-type
      646       ,output v-cntxt-obj-code
      647       ,output v-cntxt-db-num-obj
      648       ,output v-cntxt-is-admin
      649       ) .
      650      IF v-cntxt-db-num = 0 THEN do:
      651         run rep/d-report.w
      652            ( input parparentproc
      653            , input 'rep/e-dispet.w'
      654            , input "Отчет диспетчера"
      655            , input 1
      656            , input ""
      657            , input "3"
      658            , input ""
      659            , input ""
      660            , input "1"
      661            , input NO
      662            ).
      663      end.
      664      else do:
      665         run rep/d-report.w
      666            ( input parparentproc
      667            , input 'rep/e-dispet.w'
      668            , input "Отчет диспетчера"
      669            , input 1
      670            , input ""
      671            , input "2"
      672            , input ""
