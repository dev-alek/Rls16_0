        1   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        2   define input  parameter DisabledOptions as integer   no-undo .
        3   define input  parameter p-rep-name   as integer   no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Диалог печати переоценки".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      114   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      115   define new shared variable RepPathName        as character no-undo .
      116   define new shared variable PrintRubl          as logical   no-undo .
      117   define variable v-user-action as character no-undo .
      118   define variable v-printed     as logical   no-undo .
      119   define variable stat                as      logical  init no           no-undo.
      120   define variable RepFileFullName     as      character                   no-undo.
      121   define variable BuhRetFlag          as      character init "NO"         no-undo.
      122   DEFINE BUTTON B-Help DEFAULT
      123        LABEL "&Помощь":L
      124        SIZE 10.5 BY 1.25
      125        BGCOLOR 8 .
      126   DEFINE BUTTON Exit AUTO-END-KEY
      127        LABEL "&Выход ":L
      128        SIZE 10 BY 1.25.
      129   DEFINE BUTTON PrintTitle
      130        LABEL "Печать &оглавления":L
      131        SIZE 19 BY 1.25.
      132   DEFINE BUTTON R-Run
      133        LABEL "П&ечать прайс-листа":L
      134        SIZE 20.5 BY 1.25.
      135   DEFINE FRAME DIALOG-1
      136        Exit AT ROW 1.79 COL 2.13
      137        R-Run AT ROW 1.79 COL 14.63
      138        PrintTitle AT ROW 1.79 COL 36.13
      139        B-Help AT ROW 1.79 COL 58.13
      140        SPACE(2.61) SKIP(0.99)
      141       WITH VIEW-AS DIALOG-BOX
      142            SIDE-LABELS THREE-D  SCROLLABLE
      143            BGCOLOR 8
      144            TITLE "Выбор отчета   ":L
      145            DEFAULT-BUTTON R-Run.
      146   ASSIGN
      147          FRAME DIALOG-1:SCROLLABLE       = FALSE.
      148   ASSIGN
      149          Exit:PRIVATE-DATA IN FRAME DIALOG-1     =
      150                   "Exit".
      151   ASSIGN
      152          R-Run:PRIVATE-DATA IN FRAME DIALOG-1     =
      153                   "R-Run".
      154   ON CHOOSE OF Exit IN FRAME DIALOG-1
      155   DO:
      156       return BuhRetFlag .
      157   END.
      158   ON CHOOSE OF PrintTitle IN FRAME DIALOG-1
      159   DO:
      160       run gbl/prnfilen.w
      161         (input  "Печать оглавления"
      162         ,input  DisabledOptions
      163         ,input  string( session:temp-directory + "plt" + string( p-rep-name ) )
      164         ,input  7
      165         ,output v-user-action
      166         ,output v-printed
      167         ) .
      168       apply "ENTRY" to Exit.
      169   END.
      170   ON CHOOSE OF R-Run IN FRAME DIALOG-1
      171   DO:
      172       run gbl/prnfilen.w
      173         (input  "Печать прайс-листа"
      174         ,input  DisabledOptions
      175         ,input  string( session:temp-directory + "rpt" + string( p-rep-name ) )
      176         ,input  7
      177         ,output v-user-action
      178         ,output v-printed
      179         ) .
      180       apply "ENTRY" to Exit.
      181   END.
      182   IF CURRENT-WINDOW:WINDOW-STATE = WINDOW-MINIMIZED
      183   THEN CURRENT-WINDOW:WINDOW-STATE = WINDOW-NORMAL.
      184   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      185   on help of frame DIALOG-1
      186   do:
      187     run gbl/app_help.p
      188       (input this-procedure :file-name
      189       ,input ''
      190       ,input ?
      191       ) no-error.
      192     if error-status :error then do:
      193       message
      194         "Ошибка при вызове помощи"
      195         error-status :get-message(1)
      196         view-as alert-box .
      197     end.
      198   end.
      199   run minbtn-set in this-procedure .
      200   on choose of b-help in frame DIALOG-1
      201   do:
      202     apply "help":u to frame DIALOG-1 .
      203   end.
      204   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      205   procedure minbtn-set :
      206       do
      207           on error undo, return error return-value
      208           :
      209           define variable ii              as integer       no-undo .
      210           define variable fh              as widget-handle no-undo .
      211           define variable hh              as widget-handle no-undo .
      212           define variable v-h             as handle        extent 4 no-undo .
      213           define variable v-name-button   as character     no-undo .
      214           define variable v-help-old-x    as decimal       no-undo .
      215           define variable v-help-old-y    as decimal       no-undo .
      216           define variable v-help-old-size as decimal       no-undo .
      217           define variable v-frame-width   as decimal       no-undo .
      218           define variable jj              as integer       no-undo .
      219           do
      220               on error undo, return error
      221               :
      222               assign
      223                   v-frame-width = frame DIALOG-1:width - 0.3
      224                   fh            = frame DIALOG-1:first-child
      225                   hh            = fh:first-child
      226                   ii            = 1
      227                   .
      228               do while valid-handle(hh):
      229                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      230                   do:
      231                       case lc(hh:name) :
      232                           when "b-help" then
      233                               do:
      234                                   hh:load-image-up("cmp/b-help.bmp":u) .
      235                                   hh:load-image-down("cmp/b-help.bmp":u) .
      236                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      237                                   hh:TOOLTIP = "Помощь" .
      238                                   v-help-old-x = hh:column .
      239                                   v-help-old-y = hh:row    .
      240                                   v-help-old-size = hh:width .
      241                                   hh:width-chars = 2.5 .
      242                               end.
      243                           when "b-print" then
      244                               do:
      245                                   hh:load-image("cmp/b-print.bmp":u) .
      246                                   hh:TOOLTIP = "Печать" .
      247                                   v-h[ii] = hh:handle .
      248                                   ii = ii + 1 .
      249                                   hh:width-chars = 3 .
      250                               end.
      251                           when "b-history" or
      252                           when "b-hist" then
      253                               do:
      254                                   hh:load-image("cmp/b-hist.bmp":u) .
      255                                   hh:TOOLTIP = "История" .
      256                                   v-h[ii] = hh:handle .
      257                                   ii = ii + 1 .
      258                                   hh:width-chars = 3 .
      259                               end.
      260                           when "b-sch" then
      261                               do:
      262                                   hh:load-image("cmp/b-sch.bmp":u) .
      263                                   hh:TOOLTIP = "Установка Фильтра" .
      264                                   v-h[ii] = hh:handle .
      265                                   ii = ii + 1 .
      266                                   hh:width-chars = 3 .
      267                               end.
      268                           when "b-hist-user" then
      269                               do:
      270                                   hh:load-image("cmp/b-hist.bmp":u) .
      271                                   hh:TOOLTIP = "История пользователя" .
      272                                   ii = ii + 1 .
      273                               end.
      274                       end case.
      275                   end.
      276                   hh = hh:next-sibling.
      277               end.
      278               b-help:column = v-frame-width - b-help:width-chars.
      279               jj = 0.
      280               repeat ii = 4 to 1 by -1 :
      281                   if valid-handle (v-h[ii] ) then
      282                   do:
      283                       jj  = jj + 1 .
      284                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      285                       v-h[ii]:row    = v-help-old-y .
      286                   end.
      287               end.
      288           end.
      289       end.
      290   end procedure.
      291   ON WINDOW-CLOSE OF FRAME DIALOG-1 APPLY "END-ERROR":U TO SELF.
      292   MAIN-BLOCK:
      293   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      294    :
      295       RUN enable_UI.
      296       WAIT-FOR GO OF FRAME DIALOG-1.
      297   END.
      298   RUN disable_UI.
      299   PROCEDURE disable_UI :
      300     HIDE FRAME DIALOG-1.
      301   END PROCEDURE.
      302   PROCEDURE enable_UI :
      303     ENABLE Exit R-Run PrintTitle B-Help
      304         WITH FRAME DIALOG-1.
      305   END PROCEDURE.
