      485   define variable v-host-code8 as integer no-undo .
      486   define buffer buf_dis-thbj-rule8 for ub.dis-thbj-rule.
      487   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      488   define variable v-param-type9 as character no-undo .
      489   define variable v-value-date9 as date no-undo .
      490   define variable v-value-decimal9 as decimal no-undo .
      491   define variable v-value-integer9 as INTEGER no-undo .
      492   define variable v-value-logical9 AS LOGICAL no-undo .
      493   define variable v-tth9 as handle no-undo .
      494   run adm/shattri.p (
      495       input "get":U
      496       ,input  p-obj-type
      497       ,input  p-obj-code
      498       ,input  'cd-sending':U
      499       ,input  'dflt-cd':U
      500       ,output dflt-cd
      501       ,output v-value-date9
      502       ,output v-value-decimal9
      503       ,output v-value-integer9
      504       ,output v-value-logical9
      505       ,output v-param-type9
      506       ,INPUT-OUTPUT table-handle v-tth9
      507       )  .
      508   delete object v-tth9 no-error.
      509   how-pcnt-kat = ''.
      510   run adm/shattri.p (
      511       input "get":U
      512       ,input  p-obj-type
      513       ,input  p-obj-code
      514       ,input  'cd-inf-send':U
      515       ,input  'how-pcnt-kat':U
      516       ,output how-pcnt-kat
      517       ,output v-value-date8
      518       ,output v-value-decimal8
      519       ,output v-value-integer8
      520       ,output v-value-logical8
      521       ,output v-param-type8
      522       ,INPUT-OUTPUT table-handle v-tth8
      523       ) no-error .
      524   delete object v-tth8.
      525   if how-pcnt-kat = 'pcnt-kat-pdf':U then do:
      526     find first  buf_dis-thbj-rule8 No-LOCK  where
      527                 buf_dis-thbj-rule8.obj-type = p-obj-type
      528           AND  buf_dis-thbj-rule8.obj-code = p-obj-code
      529           and  buf_dis-thbj-rule8.pos-type = dflt-cd
      530           and  buf_dis-thbj-rule8.discnt-role = 'pcnt-kat-pdf':U
      531           and  buf_dis-thbj-rule8.nonunique = ''
      532           no-error .
      533     if not available buf_dis-thbj-rule8 then do:
      534   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      535   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      536     (input  p-obj-type
      537     ,input  p-obj-code
      538     ,output v-host-code8
      539     )  .
      540       find first  buf_dis-thbj-rule8 No-LOCK  where
      541                   buf_dis-thbj-rule8.obj-code = v-host-code8
      542             AND  buf_dis-thbj-rule8.obj-type = 'орг':U
      543             and  buf_dis-thbj-rule8.pos-type = dflt-cd
      544             and  buf_dis-thbj-rule8.discnt-role = 'pcnt-kat-pdf':U
      545             and  buf_dis-thbj-rule8.nonunique = ''
      546             no-error .
      547     end.
      548     if not available buf_dis-thbj-rule8 then do:
      549       find first  buf_dis-thbj-rule8 No-LOCK  where
      550                   buf_dis-thbj-rule8.obj-code = 0
      551             AND  buf_dis-thbj-rule8.obj-type = ''
      552             and  buf_dis-thbj-rule8.pos-type = dflt-cd
      553             and  buf_dis-thbj-rule8.discnt-role = 'pcnt-kat-pdf':U
      554             and  buf_dis-thbj-rule8.nonunique = ''
      555             no-error .
      556     end.
      557     if available buf_dis-thbj-rule8 then do:
      558       how-pcnt-kat = how-pcnt-kat + "=" + string(buf_dis-thbj-rule8.rule-num).
      559     end.
      560     else do:
      561       how-pcnt-kat = how-pcnt-kat + "="  + string(0).
      562     end.
      563   end.
      564   def NEW SHARED STREAM OutStream.
      565   def var Action as char no-undo.
      566   FIND ub.bar-code WHERE recid(ub.bar-code) = bc-rid NO-LOCK.
      567   FIND ub.goods WHERE ub.goods.gds-code = ub.bar-code.gds-code NO-LOCK.
      568   FIND ub.gds-prt WHERE ub.gds-prt.upper-code = ub.goods.prt-root NO-LOCK.
      569   FIND ub.gds-prt WHERE ub.gds-prt.node-code = ub.bar-code.node-code NO-LOCK.
      570   assign Action = "BCODE".
      571   DEFINE VARIABLE b-count as integer init 0 no-undo.
      572   DEFINE VARIABLE v-fact-order        like ub.trn-doc.fact-order     no-undo.
      573   run rep/tickets.w (input parparentproc, input p-obj-type, input p-obj-code, input Action, input "" ).
      574   if TicketName = "" then
      575       RETURN.
      576   OUTPUT STREAM OutStream TO VALUE( lbc-tmp + "title" ) CONVERT TARGET TitleCP PAGE-SIZE 0 .
      577   run rep/ticket.p (
      578                  buffer ub.goods
      579                 ,buffer ub.bar-code
      580                 ,buffer ub.scales-gds
      581                 ,input p-obj-type
      582                 ,input p-obj-code
      583                 ,input Action
      584                 ,input rootnode_code
      585                 ,input TickOnw
      586                 ,input TickOnN
      587                 ,input QntyType
      588                 ,input PriceType
      589                 ,input scaleprice
      590                 ,input nakl-qnty
      591                 ,input list-qnty
      592                 ,input pr-doc-rubl
      593                 ,input pr-doc-rb
      594                 ,input pr-doc-rubl-old
      595                 ,input pr-doc-rb-old
      596                 ,input v-fact-order
      597                 ,input ListProdBc
      598                 ,input curr-rate
      599                 ,input TickPS
      600                 ,input dflt-cd
      601                 ,input how-pcnt-kat
      602                 ,input-output b-count
      603                 ,input v-part-code
      604                 ,input v-doc-code
      605                 ,input v-promo-code
      606                 ,input v-ActionId
      607                 ,input v-db-num
      608                 ) no-error .
      609   def var vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      610   OUTPUT STREAM OutStream CLOSE.
      611   message
      612     substitute( "Передано на печать &1 этикеток (ценников)", b-count )
      613     view-as alert-box INFORMATION.
      614   os-command NO-WAIT value( substitute( "start &1run-lbc.bat &1 &2title &3 &4", lbc-path, lbc-tmp, TicketName, v-user-id ) ).
