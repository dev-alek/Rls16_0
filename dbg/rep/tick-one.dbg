      316           view-as alert-box error.
      317           return error.
      318       END.
      319     END CASE.
      320     if varcont5 = yes then do:
      321       if integer( substring( tmp-str5, 1, length( pl-pfx ) ) ) <> 0
      322       then do:
      323         message
      324           "Невозможно сформировать бар-код" SKIP
      325           "для товара с кодом: " internal-b-code
      326           view-as alert-box error title "подрезание кода".
      327         return error.
      328       end.
      329       else do:
      330         assign
      331           full-b-code = pl-pfx + substring( tmp-str5, length( pl-pfx ) + 1, length( tmp-str5 ) - length( pl-pfx ) )
      332           len-code5    = length( full-b-code )
      333         .
      334         define variable v-sum-char5 as character no-undo .
      335         assign
      336           sum5 = 0
      337         .
      338         do i5 = 1 to len-code5 by 2
      339         :
      340           assign
      341             v-sum-char5 = substr(full-b-code, len-code5 - i5 + 1, 1)
      342           .
      343           if v-sum-char5 < "0"
      344           or v-sum-char5 > "9"
      345           then do:
      346             message
      347               "Невозможно сформировать бар-код" skip
      348               "для товара с кодом: " internal-b-code skip
      349               view-as alert-box error title "подсчет контрольной суммы".
      350             return error.
      351           end.
      352           assign
      353             sum5 = sum5 + integer(v-sum-char5)
      354           .
      355         end.
      356         if varcont5 = yes then do:
      357           assign
      358             sum5 = sum5 * 3
      359           .
      360           do i5 = 2 to len-code5 by 2
      361           :
      362             assign
      363               v-sum-char5 = substr(full-b-code, len-code5 - i5 + 1, 1)
      364             .
      365             if v-sum-char5 < "0"
      366             or v-sum-char5 > "9"
      367             then do:
      368               message
      369                 "Невозможно сформировать бар-код" skip
      370                 "для товара с кодом: " internal-b-code skip
      371                 view-as alert-box error title "подсчет контрольной суммы".
      372               return error.
      373             end.
      374             assign
      375               sum5 = sum5 + integer(v-sum-char5)
      376             .
      377           end.
      378           if varcont5 = yes then do:
      379              if sum5 mod 10 = 0 then do:
      380                assign
      381                  full-b-code = full-b-code + '0'
      382                .
      383              end.
      384              else do:
      385                assign
      386                  full-b-code = full-b-code + string(10 - sum5 mod 10)
      387                .
      388              end.
      389           end.
      390         end.
      391       end.
      392     end.
      393   END PROCEDURE.
