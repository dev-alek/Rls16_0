      158   def new shared var bc-frmt as character no-undo .
      159   def new shared var bc-pfx  as character no-undo .
      160   def var bc-par-type as character no-undo .
      161       run gbl/conf-rd.p ("bc-frmt", "", "", 0, "", "", "",  no , output bc-frmt, output bc-par-type) no-error.
      162       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U OR not can-do ("EAN8,EAN13", bc-frmt) ) then
      163           do:
      164               message "Не задан или не верно задан ТИП собственного бар-кода!"
      165                   view-as alert-box ERROR TITLE "".
      166               return error.
      167           end.
      168       run gbl/conf-rd.p ("bc-pfx", "", "", 0, "", "", "",  no , output bc-pfx, output bc-par-type) no-error.
      169       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U ) then
      170           do:
      171               message "Не задан или не верно задан ПРЕФИКС бар-кода складского места!"
      172                   view-as alert-box ERROR TITLE "".
      173               return error.
      174           end.
      175   PROCEDURE gen-bc:
      176     def input  parameter internal-b-code like ub.bar-code.b-code no-undo .
      177     def output parameter full-b-code     as character init ""    no-undo .
      178   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      179     define variable tmp-str4  as character no-undo.
      180     define variable tmp-num4  as character no-undo.
      181     define variable i4        as integer   no-undo.
      182     define variable sum4      as integer   no-undo.
      183     define variable len-code4 as integer   no-undo.
      184     define variable varcont4  as logical   initial yes no-undo.
      185     CASE bc-frmt :
      186       WHEN "EAN13" THEN do:
      187         assign
      188           tmp-str4 = string( internal-b-code, "999999999999" )
      189         .
      190       end.
      191       WHEN "EAN8" THEN do:
      192         assign
      193           tmp-str4 = string( internal-b-code, "9999999" )
      194         .
      195       end.
      196       OTHERWISE DO:
      197           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " bc-frmt " ."
      198           view-as alert-box error.
      199           return error.
      200       END.
      201     END CASE.
      202     if varcont4 = yes then do:
      203       if integer( substring( tmp-str4, 1, length( bc-pfx ) ) ) <> 0
      204       then do:
      205         message
      206           "Невозможно сформировать бар-код" SKIP
      207           "для товара с кодом: " internal-b-code
      208           view-as alert-box error title "подрезание кода".
      209         return error.
      210       end.
      211       else do:
      212         assign
      213           full-b-code = bc-pfx + substring( tmp-str4, length( bc-pfx ) + 1, length( tmp-str4 ) - length( bc-pfx ) )
      214           len-code4    = length( full-b-code )
      215         .
      216         define variable v-sum-char4 as character no-undo .
      217         assign
      218           sum4 = 0
      219         .
      220         do i4 = 1 to len-code4 by 2
      221         :
      222           assign
      223             v-sum-char4 = substr(full-b-code, len-code4 - i4 + 1, 1)
      224           .
      225           if v-sum-char4 < "0"
      226           or v-sum-char4 > "9"
      227           then do:
      228             message
      229               "Невозможно сформировать бар-код" skip
      230               "для товара с кодом: " internal-b-code skip
      231               view-as alert-box error title "подсчет контрольной суммы".
      232             return error.
      233           end.
      234           assign
      235             sum4 = sum4 + integer(v-sum-char4)
      236           .
      237         end.
      238         if varcont4 = yes then do:
      239           assign
      240             sum4 = sum4 * 3
      241           .
      242           do i4 = 2 to len-code4 by 2
      243           :
      244             assign
      245               v-sum-char4 = substr(full-b-code, len-code4 - i4 + 1, 1)
      246             .
      247             if v-sum-char4 < "0"
      248             or v-sum-char4 > "9"
      249             then do:
      250               message
      251                 "Невозможно сформировать бар-код" skip
      252                 "для товара с кодом: " internal-b-code skip
      253                 view-as alert-box error title "подсчет контрольной суммы".
      254               return error.
      255             end.
      256             assign
      257               sum4 = sum4 + integer(v-sum-char4)
      258             .
      259           end.
      260           if varcont4 = yes then do:
      261              if sum4 mod 10 = 0 then do:
      262                assign
      263                  full-b-code = full-b-code + '0'
      264                .
      265              end.
      266              else do:
      267                assign
      268                  full-b-code = full-b-code + string(10 - sum4 mod 10)
      269                .
      270              end.
      271           end.
      272         end.
      273       end.
      274     end.
      275   END PROCEDURE.
      276   def new shared var pl-frmt as character no-undo .
      277   def new shared var pl-pfx  as character no-undo .
      278   def var pl-par-type as character no-undo .
      279       run gbl/conf-rd.p ("pl-frmt", "", "", 0, "", "", "",  no , output pl-frmt, output pl-par-type) no-error.
      280       if "new" = "bc" AND ( error-status:error OR pl-par-type <> "C":U OR not can-do ("EAN8,EAN13", pl-frmt) ) then
      281           do:
      282               message "Не задан или не верно задан ТИП собственного бар-кода!"
      283                   view-as alert-box ERROR TITLE "".
      284               return error.
      285           end.
      286       run gbl/conf-rd.p ("pl-pfx", "", "", 0, "", "", "",  no , output pl-pfx, output pl-par-type) no-error.
      287       if "new" = "bc" AND ( error-status:error OR pl-par-type <> "C":U ) then
      288           do:
      289               message "Не задан или не верно задан ПРЕФИКС бар-кода складского места!"
      290                   view-as alert-box ERROR TITLE "".
      291               return error.
      292           end.
      293   PROCEDURE gen-pl:
      294     def input  parameter internal-b-code like ub.bar-code.b-code no-undo .
      295     def output parameter full-b-code     as character init ""    no-undo .
      296   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      297     define variable tmp-str5  as character no-undo.
      298     define variable tmp-num5  as character no-undo.
      299     define variable i5        as integer   no-undo.
      300     define variable sum5      as integer   no-undo.
      301     define variable len-code5 as integer   no-undo.
      302     define variable varcont5  as logical   initial yes no-undo.
      303     CASE pl-frmt :
      304       WHEN "EAN13" THEN do:
      305         assign
      306           tmp-str5 = string( internal-b-code, "999999999999" )
      307         .
      308       end.
      309       WHEN "EAN8" THEN do:
      310         assign
      311           tmp-str5 = string( internal-b-code, "9999999" )
      312         .
      313       end.
      314       OTHERWISE DO:
