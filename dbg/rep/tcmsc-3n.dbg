     2994              run di-qnty ("кол-во", 1, s-bar-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     2995            if xshowcost    then do: run di ( "учет.", 2,"","","","",""). end.
     2996            if xshowcrsa    then do: run di ( "прод.", 5,"","","","","" ).  end.
     2997            if xshowsale    then do: run di ( "комисс." , 8,"","","","","" ).  end.
     2998            if vat-cost    then do: run di ( "уч.НДС", 3,"","","","","" ). end.
     2999            if vat-crsa    then do: run di ( "пр.НДС", 6,"","","","","" ).  end.
     3000            if vat-sale    then do: run di ( "км.НДС", 9,"","","","","" ).  end.
     3001   end procedure.
     3002   procedure display-bi  :
     3003              run di-qnty("кол-во",1,  "", gds-zap-artic ,"" ,"", "bi":u).
     3004            if xshowcost    then do: run di ("учет." , 2 , "","", "", "", "bi":u).  end.
     3005            if xshowcrsa    then do: run di ("прод." , 5, "","", "", "",  "bi":u).  end.
     3006            if xshowsale    then do: run di ("комисс." , 8, "","", "", "",  "bi":u).  end.
     3007            if vat-cost    then do: run di ( "уч.НДС", 3,"","","","","bi":u ). end.
