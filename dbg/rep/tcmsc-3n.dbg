      756   FUNCTION n-lavel RETURNS char (INPUT grp-name as char, INPUT lavel# as int ).
      757   define variable  str  as char format "X(60)"  no-undo.
      758   define variable  str2 as char no-undo.
      759   define variable v-r as character no-undo init "" .
      760   define variable  i#i as int no-undo.
      761   STR = "".
      762   repeat i#i =1 to lavel#:
      763       if i#i =1 then str   = entry(1,grp-name, chr(47)) .
      764       else do:
      765           str2 = entry(i#i,grp-name, chr(47)) no-error.
      766           if not error-status:error  and str2 <> "":u then
      767                  str = str +  chr(47) +  entry(i#i,grp-name, chr(47)) no-error .
      768           end.
      769   end.
      770   if str <> ? then do:
      771   v-r = str + chr(47) .
      772   end.
      773   RETURN v-r .
      774   END FUNCTION.
      775   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      776     if num-entries(string(p-dec), '.') = 2
      777       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      778       else return( string(p-dec)) .
      779   end function.
      780   function format-point-to-comma returns char (input orig as char ) .
      781   define variable rtext as character no-undo .
      782   define variable strt as integer no-undo .
      783   define variable leng as integer no-undo .
      784   assign rtext = orig .
      785   repeat:
      786     strt =  index(rtext,'.').
      787     if strt = 0 then leave.
      788     leng = 1.
      789     substring(rtext,strt,leng,"character") = v-delim .
      790   end.
      791   return rtext.
      792   end function.
      793   function format-excel-text returns char ( input start-text as char ) :
      794   def var  i    as int no-undo.
      795   def var  ch   as char no-undo.
      796   def var  n    as int no-undo.
      797   def var  ipos as int no-undo.
      798     n = num-entries(trim(start-text), chr(10)) - 1 .
      799     do i = 1 to n :
      800       ipos = index( start-text, chr(10)).
      801       if ipos > 0 then
      802         substr( start-text, ipos, 1 ) = ' '.
      803     end.
      804     n = num-entries(trim(start-text), chr(13)) - 1 .
      805     do i = 1 to n :
      806       ipos = index( start-text, chr(13)).
      807       if ipos > 0 then
      808         substr( start-text, ipos, 1 ) = ' '.
      809     end.
      810     if index( start-text, '"' ) = 0 then
      811       start-text =  '="'   + trim( start-text) + '"'   .
      812       else do:
      813         n = num-entries(trim(start-text), '"') - 1.
      814         do i = 1 to n :
      815           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      816         end.
      817         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      818         start-text = '="'  + ch  + '"' .
      819       end.
      820     return start-text.
      821   end.
      822   function excel-sum returns char (input p-dec as decimal ).
      823     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      824   end function.
      825   function excel-qnty returns char (input p-dec as decimal ).
      826     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      827   end function.
      828   function format-excel-text-macr returns char ( input start-text as char ) :
      829   def var  i    as int no-undo.
      830   def var  ch   as char no-undo.
      831   def var  n    as int no-undo.
      832   def var  ipos as int no-undo.
      833     n = num-entries(trim(start-text), chr(10)) - 1 .
      834     do i = 1 to n :
      835       ipos = index( start-text, chr(10)).
      836       if ipos > 0 then
      837         substring( start-text, ipos , 1 ) = ' '.
      838     end.
      839     n = num-entries(trim(start-text), chr(13)) - 1 .
      840     do i = 1 to n :
      841       ipos = index( start-text, chr(13)).
      842       if ipos > 0 then
      843         substring( start-text, ipos, 1 ) = ' '.
      844     end.
      845     if index( start-text, '"' ) = 0 then
      846       start-text =  '"'   + trim( start-text) + '"'   .
      847       else do:
      848         n = num-entries(trim(start-text), '"') - 1.
      849         do i = 1 to n :
      850           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      851         end.
      852         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      853         start-text = '"'  + ch  + '"' .
      854       end.
      855     n = num-entries(trim(start-text), chr(10)) - 1 .
      856     do i = 1 to n :
      857       ipos = index( start-text, chr(10)).
      858       if ipos > 0 then
      859         substring( start-text, ipos , 1 ) = ' '.
      860     end.
      861       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
      862     return start-text.
      863   end.
      864   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      865   procedure cur-time :
      866      define output parameter p-today as date      no-undo .
      867      define output parameter p-time  as integer   no-undo .
      868     do
      869     on error undo, return error
      870     :
      871       define variable v-date1 as date      no-undo .
      872       define variable v-date2 as date      no-undo .
      873       define variable v-time  as integer   no-undo .
      874       assign
      875         v-date1 = today
      876         v-time  = time
      877         v-date2 = today
      878       .
      879       if v-date1 <> v-date2
      880       then do:
      881         assign
      882           v-date1 = today
      883           v-time  = v-time
      884         .
      885       end.
      886       assign
      887         p-today = v-date1
      888         p-time  = v-time
      889       .
      890     end.
      891   end.
      892   function cur-time-date returns character
      893   :
      894     return string(today, '99/99/9999':U) .
      895   end.
      896   function cur-time-mjd returns decimal
      897   :
      898     define variable v-date as date      no-undo .
      899     define variable v-time as integer   no-undo .
      900     run cur-time in this-procedure
      901       (output v-date
      902       ,output v-time
      903       ) .
      904     return integer(v-date) - 2400002 + (v-time / 86400) .
      905   end.
      906   function cur-time-get-ending-index returns integer
      907   (input p-number as integer
      908   )
      909   :
      910     if p-number < 0
      911     or p-number = ?
      912     then do:
      913       return 1 .
      914     end.
      915     define variable v-rest as integer   no-undo .
      916     assign
      917       p-number = p-number modulo 100
      918     .
      919     if p-number < 20
      920     then do:
      921       assign
      922         v-rest = p-number
      923       .
      924     end.
      925     else do:
      926       assign
      927         v-rest = p-number modulo 10
      928       .
      929     end.
      930     case v-rest :
      931       when 1
      932       then do:
      933         return 2 .
      934       end.
      935       when 2 or
      936       when 3 or
      937       when 4
      938       then do:
      939         return 3 .
      940       end.
      941       otherwise do:
      942         return 1 .
      943       end.
      944     end case .
      945   end.
      946   procedure cur-time-mjd-to-date :
      947      define input  parameter i-mjd-diff as decimal no-undo.
      948      define output parameter o-Date     as date    no-undo.
      949      define output parameter o-Time     as integer no-undo.
      950      define variable v-day-number as integer   no-undo .
      951      if    i-mjd-diff < 0
      952         or i-mjd-diff = ?
      953      then do:
      954         return "?" .
      955      end.
      956      assign
      957         v-day-number = truncate(i-mjd-diff,0).
      958         o-Date = date(v-day-number + 2400002).
      959         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      960     .
      961   end.
      962   function cur-time-mjd-to-string returns character
      963   (input p-mjd-diff as decimal
      964   )
      965   :
      966     define variable v-day-number as integer   no-undo .
      967     define variable v-seconds    as integer   no-undo .
      968     define variable v-hour       as integer   no-undo .
      969     define variable v-min        as integer   no-undo .
      970     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      971     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      972     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      973     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      974     if p-mjd-diff < 0
      975     or p-mjd-diff = ?
      976     then do:
      977       return "?" .
      978     end.
      979     assign
      980       v-day-number = integer(truncate(p-mjd-diff,0))
      981       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      982     .
      983     if v-seconds > 86400
      984     then do:
      985       assign
      986         v-seconds = 86400 - 1
      987       .
      988     end.
      989     if v-seconds < 0
      990     then do:
      991       assign
      992         v-seconds = 0
      993       .
      994     end.
      995     assign
      996       v-hour = truncate(v-seconds / 3600, 0)
      997     .
      998     assign
      999       v-seconds = v-seconds modulo 3600
     1000     .
     1001     assign
     1002       v-min = truncate(v-seconds / 60, 0)
     1003     .
     1004     assign
     1005       v-seconds = v-seconds modulo 60
     1006     .
     1007     return
     1008         (if v-day-number <> 0
     1009           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1010           else ""
     1011         )
     1012       + (if v-day-number <> 0 or v-hour <> 0
     1013           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1014           else ""
     1015         )
     1016       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1017           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1018           else ""
     1019         )
     1020       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1021       .
     1022   end.
     1023   function cur-time-string returns character
     1024   :
     1025     define variable v-date as date      no-undo .
     1026     define variable v-time as integer   no-undo .
     1027     run cur-time in this-procedure
     1028       (output v-date
     1029       ,output v-time
     1030       ) .
     1031     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1032   end.
     1033   function cur-time-string-sec returns character
     1034   :
     1035     define variable v-date as date      no-undo .
     1036     define variable v-time as integer   no-undo .
     1037     run cur-time in this-procedure
     1038       (output v-date
     1039       ,output v-time
     1040       ) .
     1041     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1042   end.
     1043   function cur-time-custom  returns character
     1044   (input p-prefix as character
     1045   ,input p-date-format as character
     1046   ,input p-delimiter as character
     1047   ,input p-time-format as character
     1048   ,input p-suffix as character
     1049   )
     1050   :
     1051     define variable v-date as date      no-undo .
     1052     define variable v-time as integer   no-undo .
     1053     run cur-time in this-procedure
     1054       (output v-date
     1055       ,output v-time
     1056       ) .
     1057     return
     1058       p-prefix
     1059       + string(v-date, p-date-format)
     1060       + p-delimiter
     1061       + string(v-time, p-time-format)
     1062       + p-suffix
     1063       .
     1064   end.
     1065   function cur-time-print  returns character
     1066   :
     1067     define variable v-date as date      no-undo .
     1068     define variable v-time as integer   no-undo .
     1069     run cur-time in this-procedure
     1070       (output v-date
     1071       ,output v-time
     1072       ) .
     1073     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1074   end.
     1075   function cur-time-datetime returns datetime
     1076   :
     1077     define variable v-char as character no-undo .
     1078     define variable v-datetime as datetime no-undo .
     1079     v-char = cur-time-string().
     1080     v-datetime = datetime(v-char).
     1081     return  v-datetime.
     1082   end.
     1083   function cur-time-string-msec returns character
     1084   :
     1085     define variable v-date as datetime  no-undo .
     1086     v-date = now.
     1087     return string(v-date) .
     1088   end.
     1089   def var vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1090   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     1091   procedure paramls-clear :
     1092     define buffer buf_temp-param for temp-param .
     1093     do
     1094     on error undo, return error return-value
     1095     :
     1096       for each buf_temp-param
     1097       on error undo, return error
     1098       :
     1099         delete buf_temp-param .
     1100       end.
     1101     end.
     1102   end procedure.
     1103   procedure paramls-write :
     1104     define input  parameter p-code     as character no-undo .
     1105     define input  parameter p-sub-code as character no-undo .
     1106     define input  parameter p-value    as character no-undo .
     1107     define buffer buf_temp-param for temp-param .
     1108     do
     1109     on error undo, return error return-value
     1110     :
     1111       find first buf_temp-param
     1112         where buf_temp-param.param-code     = p-code
     1113           and buf_temp-param.param-sub-code = p-sub-code
     1114         no-error .
     1115       if not available buf_temp-param then do:
     1116         create buf_temp-param .
     1117         assign
     1118           buf_temp-param.param-code     = p-code
     1119           buf_temp-param.param-sub-code = p-sub-code
     1120         .
     1121       end.
     1122       assign
     1123         buf_temp-param.param-value = p-value
     1124       .
     1125     end.
     1126   end procedure.
     1127   procedure paramls-read :
     1128     define input  parameter p-code          as character no-undo .
     1129     define input  parameter p-sub-code      as character no-undo .
     1130     define input  parameter p-default-value as character no-undo .
     1131     define output parameter p-value         as character no-undo .
     1132     define buffer buf_temp-param for temp-param .
     1133     do
     1134     on error undo, return error return-value
     1135     :
     1136       find first buf_temp-param
     1137         where buf_temp-param.param-code     = p-code
     1138           and buf_temp-param.param-sub-code = p-sub-code
     1139         no-error .
     1140       if available buf_temp-param then do:
     1141         assign
     1142           p-value = buf_temp-param.param-value
     1143         .
     1144       end.
     1145       else do:
     1146         assign
     1147           p-value = p-default-value
     1148         .
     1149       end.
     1150     end.
     1151   end procedure.
     1152   procedure paramls-append :
     1153     define input  parameter p-code     as character no-undo .
     1154     define input  parameter p-sub-code as character no-undo .
     1155     define input  parameter p-value    as character no-undo .
     1156     define buffer buf_temp-param for temp-param .
     1157     do
     1158     on error undo, return error return-value
     1159     :
     1160       find first buf_temp-param
     1161            where buf_temp-param.param-code     = p-code
     1162              and buf_temp-param.param-sub-code = p-sub-code
     1163         no-error .
     1164       if not available buf_temp-param then do:
     1165         create buf_temp-param .
     1166         assign
     1167           buf_temp-param.param-code     = p-code
     1168           buf_temp-param.param-sub-code = p-sub-code
     1169           buf_temp-param.param-value    = p-value
     1170         .
     1171       end.
     1172       else do:
     1173           assign
     1174               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     1175           .
     1176       end.
     1177     end.
     1178   end procedure.
