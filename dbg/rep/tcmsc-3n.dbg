     1312   procedure aht_update-ot-tot :
     1313     define input  parameter p-obj-type            like ub.trn-doc.obj-type     no-undo .
     1314     define input  parameter p-obj-code            like ub.trn-doc.obj-code     no-undo .
     1315     define input  parameter p-fact-order          like ub.trn-doc.fact-order   no-undo .
     1316     define input  parameter p-ext-doc-type        like ub.trn-doc.ext-doc-type no-undo .
     1317     define buffer buf_temp-aht-ot-line for temp-aht-ot-line .
     1318     define buffer buf_temp-aht-ot-tot for temp-aht-ot-tot .
     1319     do
     1320     on error undo, return error
     1321     :
     1322       for each buf_temp-aht-ot-line
     1323       on error undo, return error
     1324       :
     1325         find first buf_temp-aht-ot-tot
     1326           where buf_temp-aht-ot-tot.doc-code = buf_temp-aht-ot-line.doc-code
     1327             and buf_temp-aht-ot-tot.sum-type = buf_temp-aht-ot-line.sum-type
     1328           no-error .
     1329         if not available buf_temp-aht-ot-tot then do:
     1330           create buf_temp-aht-ot-tot .
     1331           assign
     1332             buf_temp-aht-ot-tot.doc-code     = buf_temp-aht-ot-line.doc-code
     1333             buf_temp-aht-ot-tot.sum-type     = buf_temp-aht-ot-line.sum-type
     1334             buf_temp-aht-ot-tot.ext-doc-type = p-ext-doc-type
     1335             buf_temp-aht-ot-tot.obj-type     = p-obj-type
     1336             buf_temp-aht-ot-tot.obj-code     = p-obj-code
     1337             buf_temp-aht-ot-tot.fact-order   = p-fact-order
     1338           .
     1339         end.
     1340         assign
     1341           buf_temp-aht-ot-tot.fact-qnty = buf_temp-aht-ot-tot.fact-qnty + buf_temp-aht-ot-line.fact-qnty
     1342                                                                           buf_temp-aht-ot-tot.cost-sum-base       = buf_temp-aht-ot-tot.cost-sum-base       + buf_temp-aht-ot-line.cost-sum-base            buf_temp-aht-ot-tot.cost-sum-rubl       = buf_temp-aht-ot-tot.cost-sum-rubl       + buf_temp-aht-ot-line.cost-sum-rubl            buf_temp-aht-ot-tot.cost-vat-base       = buf_temp-aht-ot-tot.cost-vat-base       + buf_temp-aht-ot-line.cost-vat-base            buf_temp-aht-ot-tot.cost-vat-rubl       = buf_temp-aht-ot-tot.cost-vat-rubl       + buf_temp-aht-ot-line.cost-vat-rubl            buf_temp-aht-ot-tot.cost-slt-base       = buf_temp-aht-ot-tot.cost-slt-base       + buf_temp-aht-ot-line.cost-slt-base            buf_temp-aht-ot-tot.cost-slt-rubl       = buf_temp-aht-ot-tot.cost-slt-rubl       + buf_temp-aht-ot-line.cost-slt-rubl            buf_temp-aht-ot-tot.cost-road-tax-base  = buf_temp-aht-ot-tot.cost-road-tax-base  + buf_temp-aht-ot-line.cost-road-tax-base       buf_temp-aht-ot-tot.cost-road-tax-rubl  = buf_temp-aht-ot-tot.cost-road-tax-rubl  + buf_temp-aht-ot-line.cost-road-tax-rubl       buf_temp-aht-ot-tot.cost-excise-base    = buf_temp-aht-ot-tot.cost-excise-base    + buf_temp-aht-ot-line.cost-excise-base         buf_temp-aht-ot-tot.cost-excise-rubl    = buf_temp-aht-ot-tot.cost-excise-rubl    + buf_temp-aht-ot-line.cost-excise-rubl         buf_temp-aht-ot-tot.cost-transport-base = buf_temp-aht-ot-tot.cost-transport-base + buf_temp-aht-ot-line.cost-transport-base      buf_temp-aht-ot-tot.cost-transport-rubl = buf_temp-aht-ot-tot.cost-transport-rubl + buf_temp-aht-ot-line.cost-transport-rubl      buf_temp-aht-ot-tot.cost-other-base     = buf_temp-aht-ot-tot.cost-other-base     + buf_temp-aht-ot-line.cost-other-base          buf_temp-aht-ot-tot.cost-other-rubl     = buf_temp-aht-ot-tot.cost-other-rubl     + buf_temp-aht-ot-line.cost-other-rubl          buf_temp-aht-ot-tot.cost-discnt-base    = buf_temp-aht-ot-tot.cost-discnt-base    + buf_temp-aht-ot-line.cost-discnt-base          buf_temp-aht-ot-tot.cost-discnt-rubl    = buf_temp-aht-ot-tot.cost-discnt-rubl    + buf_temp-aht-ot-line.cost-discnt-rubl
     1343                                                                           buf_temp-aht-ot-tot.crsa-sum-base       = buf_temp-aht-ot-tot.crsa-sum-base       + buf_temp-aht-ot-line.crsa-sum-base            buf_temp-aht-ot-tot.crsa-sum-rubl       = buf_temp-aht-ot-tot.crsa-sum-rubl       + buf_temp-aht-ot-line.crsa-sum-rubl            buf_temp-aht-ot-tot.crsa-vat-base       = buf_temp-aht-ot-tot.crsa-vat-base       + buf_temp-aht-ot-line.crsa-vat-base            buf_temp-aht-ot-tot.crsa-vat-rubl       = buf_temp-aht-ot-tot.crsa-vat-rubl       + buf_temp-aht-ot-line.crsa-vat-rubl            buf_temp-aht-ot-tot.crsa-slt-base       = buf_temp-aht-ot-tot.crsa-slt-base       + buf_temp-aht-ot-line.crsa-slt-base            buf_temp-aht-ot-tot.crsa-slt-rubl       = buf_temp-aht-ot-tot.crsa-slt-rubl       + buf_temp-aht-ot-line.crsa-slt-rubl            buf_temp-aht-ot-tot.crsa-road-tax-base  = buf_temp-aht-ot-tot.crsa-road-tax-base  + buf_temp-aht-ot-line.crsa-road-tax-base       buf_temp-aht-ot-tot.crsa-road-tax-rubl  = buf_temp-aht-ot-tot.crsa-road-tax-rubl  + buf_temp-aht-ot-line.crsa-road-tax-rubl       buf_temp-aht-ot-tot.crsa-excise-base    = buf_temp-aht-ot-tot.crsa-excise-base    + buf_temp-aht-ot-line.crsa-excise-base         buf_temp-aht-ot-tot.crsa-excise-rubl    = buf_temp-aht-ot-tot.crsa-excise-rubl    + buf_temp-aht-ot-line.crsa-excise-rubl         buf_temp-aht-ot-tot.crsa-transport-base = buf_temp-aht-ot-tot.crsa-transport-base + buf_temp-aht-ot-line.crsa-transport-base      buf_temp-aht-ot-tot.crsa-transport-rubl = buf_temp-aht-ot-tot.crsa-transport-rubl + buf_temp-aht-ot-line.crsa-transport-rubl      buf_temp-aht-ot-tot.crsa-other-base     = buf_temp-aht-ot-tot.crsa-other-base     + buf_temp-aht-ot-line.crsa-other-base          buf_temp-aht-ot-tot.crsa-other-rubl     = buf_temp-aht-ot-tot.crsa-other-rubl     + buf_temp-aht-ot-line.crsa-other-rubl          buf_temp-aht-ot-tot.crsa-discnt-base    = buf_temp-aht-ot-tot.crsa-discnt-base    + buf_temp-aht-ot-line.crsa-discnt-base          buf_temp-aht-ot-tot.crsa-discnt-rubl    = buf_temp-aht-ot-tot.crsa-discnt-rubl    + buf_temp-aht-ot-line.crsa-discnt-rubl
     1344                                                                           buf_temp-aht-ot-tot.sale-sum-base       = buf_temp-aht-ot-tot.sale-sum-base       + buf_temp-aht-ot-line.sale-sum-base            buf_temp-aht-ot-tot.sale-sum-rubl       = buf_temp-aht-ot-tot.sale-sum-rubl       + buf_temp-aht-ot-line.sale-sum-rubl            buf_temp-aht-ot-tot.sale-vat-base       = buf_temp-aht-ot-tot.sale-vat-base       + buf_temp-aht-ot-line.sale-vat-base            buf_temp-aht-ot-tot.sale-vat-rubl       = buf_temp-aht-ot-tot.sale-vat-rubl       + buf_temp-aht-ot-line.sale-vat-rubl            buf_temp-aht-ot-tot.sale-slt-base       = buf_temp-aht-ot-tot.sale-slt-base       + buf_temp-aht-ot-line.sale-slt-base            buf_temp-aht-ot-tot.sale-slt-rubl       = buf_temp-aht-ot-tot.sale-slt-rubl       + buf_temp-aht-ot-line.sale-slt-rubl            buf_temp-aht-ot-tot.sale-road-tax-base  = buf_temp-aht-ot-tot.sale-road-tax-base  + buf_temp-aht-ot-line.sale-road-tax-base       buf_temp-aht-ot-tot.sale-road-tax-rubl  = buf_temp-aht-ot-tot.sale-road-tax-rubl  + buf_temp-aht-ot-line.sale-road-tax-rubl       buf_temp-aht-ot-tot.sale-excise-base    = buf_temp-aht-ot-tot.sale-excise-base    + buf_temp-aht-ot-line.sale-excise-base         buf_temp-aht-ot-tot.sale-excise-rubl    = buf_temp-aht-ot-tot.sale-excise-rubl    + buf_temp-aht-ot-line.sale-excise-rubl         buf_temp-aht-ot-tot.sale-transport-base = buf_temp-aht-ot-tot.sale-transport-base + buf_temp-aht-ot-line.sale-transport-base      buf_temp-aht-ot-tot.sale-transport-rubl = buf_temp-aht-ot-tot.sale-transport-rubl + buf_temp-aht-ot-line.sale-transport-rubl      buf_temp-aht-ot-tot.sale-other-base     = buf_temp-aht-ot-tot.sale-other-base     + buf_temp-aht-ot-line.sale-other-base          buf_temp-aht-ot-tot.sale-other-rubl     = buf_temp-aht-ot-tot.sale-other-rubl     + buf_temp-aht-ot-line.sale-other-rubl          buf_temp-aht-ot-tot.sale-discnt-base    = buf_temp-aht-ot-tot.sale-discnt-base    + buf_temp-aht-ot-line.sale-discnt-base          buf_temp-aht-ot-tot.sale-discnt-rubl    = buf_temp-aht-ot-tot.sale-discnt-rubl    + buf_temp-aht-ot-line.sale-discnt-rubl
     1345         .
     1346       end.
     1347     end.
     1348   end procedure.
     1349   procedure aht_update-stk-table :
     1350     define input  parameter p-fact-order     like ub.trn-doc.fact-order   no-undo .
     1351     define input  parameter p-cut-fact-order like ub.trn-doc.fact-order   no-undo .
     1352     define input  parameter p-ext-doc-type   like ub.trn-doc.ext-doc-type no-undo .
     1353     define input  parameter p-trn-doc        as logical   no-undo .
     1354     define buffer buf_temp-aht-ot-tot for temp-aht-ot-tot .
     1355     define buffer buf_temp-aht-ot-line for temp-aht-ot-line .
     1356     define variable v-stk-ext-sum-type as character no-undo .
     1357     do
     1358     on error undo, return error
     1359     :
     1360       for each buf_temp-aht-ot-tot
     1361       on error undo, return error
     1362       :
     1363         run aht_get-stk-sum-type in this-procedure
     1364           (input  buf_temp-aht-ot-tot.sum-type
     1365           ,input  p-ext-doc-type
     1366           ,output v-stk-ext-sum-type
     1367           ) .
     1368         run aht_store-stk-tot in this-procedure
     1369           (buffer buf_temp-aht-ot-tot
     1370           ,input buf_temp-aht-ot-tot.sum-type
     1371           ,input p-fact-order
     1372           ,input p-cut-fact-order
     1373           ,input p-ext-doc-type
     1374           ,input false
     1375           ) .
     1376         run aht_store-stk-tot in this-procedure
     1377           (buffer buf_temp-aht-ot-tot
     1378           ,input v-stk-ext-sum-type
     1379           ,input p-fact-order
     1380           ,input p-cut-fact-order
     1381           ,input p-ext-doc-type
     1382           ,input p-trn-doc
     1383           ) .
     1384       end.
     1385       for each buf_temp-aht-ot-line
     1386       on error undo, return error
     1387       :
     1388         run aht_get-stk-sum-type in this-procedure
     1389           (input  buf_temp-aht-ot-line.sum-type
     1390           ,input  p-ext-doc-type
     1391           ,output v-stk-ext-sum-type
     1392           ) .
     1393         run aht_store-stk-line in this-procedure
     1394           (buffer buf_temp-aht-ot-line
     1395           ,input buf_temp-aht-ot-line.sum-type
     1396           ,input p-fact-order
     1397           ,input p-cut-fact-order
     1398           ,input p-ext-doc-type
     1399           ,input false
     1400           ) .
     1401         run aht_store-stk-line in this-procedure
     1402           (buffer buf_temp-aht-ot-line
     1403           ,input v-stk-ext-sum-type
     1404           ,input p-fact-order
     1405           ,input p-cut-fact-order
     1406           ,input p-ext-doc-type
     1407           ,input p-trn-doc
     1408           ) .
     1409       end.
     1410     end.
     1411   end procedure.
     1412   procedure aht_store-stk-tot :
     1413     define parameter buffer buf_temp-aht-ot-tot for temp-aht-ot-tot .
     1414     define input  parameter p-stk-sum-type      as character no-undo .
     1415     define input  parameter p-fact-order        like ub.trn-doc.fact-order   no-undo .
     1416     define input  parameter p-cut-fact-order    like ub.trn-doc.fact-order   no-undo .
     1417     define input  parameter p-ext-doc-type      like ub.trn-doc.ext-doc-type no-undo .
     1418     define input  parameter p-update-sale       as logical   no-undo .
     1419     define buffer buf_aht-stk-tot for ub.aht-stk-tot .
     1420     define buffer new-buf_aht-stk-tot for ub.aht-stk-tot .
     1421     do
     1422     on error undo, return error return-value
     1423     :
     1424       find last buf_aht-stk-tot exclusive-lock
     1425         where buf_aht-stk-tot.obj-type   = buf_temp-aht-ot-tot.obj-type
     1426           and buf_aht-stk-tot.obj-code   = buf_temp-aht-ot-tot.obj-code
     1427           and buf_aht-stk-tot.sum-type   = p-stk-sum-type
     1428           and buf_aht-stk-tot.fact-order <= p-fact-order
     1429         use-index category
     1430         no-error .
     1431       if not available buf_aht-stk-tot
     1432       or buf_aht-stk-tot.fact-order <> p-fact-order
     1433       then do:
     1434         create new-buf_aht-stk-tot .
     1435         assign
     1436           new-buf_aht-stk-tot.obj-type   = buf_temp-aht-ot-tot.obj-type
     1437           new-buf_aht-stk-tot.obj-code   = buf_temp-aht-ot-tot.obj-code
     1438           new-buf_aht-stk-tot.fact-order = p-fact-order
     1439           new-buf_aht-stk-tot.sum-type   = p-stk-sum-type
     1440         .
     1441         if available buf_aht-stk-tot then do:
     1442           assign
     1443             new-buf_aht-stk-tot.fact-qnty = buf_aht-stk-tot.fact-qnty
