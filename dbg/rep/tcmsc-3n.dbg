     1545   procedure aht_store-ot-table :
     1546     define buffer buf_temp-aht-ot-tot for temp-aht-ot-tot .
     1547     define buffer buf_aht-ot-tot for ub.aht-ot-tot .
     1548     define buffer buf_temp-aht-ot-line for temp-aht-ot-line .
     1549     define buffer buf_aht-ot-line for ub.aht-ot-line .
