     3084   procedure clear-b1  :
     3085    b1-gds-zap-other           = 0.
     3086    repeat kk = 1 to 9 :
     3087    assign
     3088       b1-prih                                            [kk]    = 0
     3089       b1-rash                                            [kk]    = 0
     3090       b1-kassa                                           [kk]    = 0
     3091       b1-inv                                             [kk]    = 0
     3092       b1-overturn                                        [kk]    = 0
