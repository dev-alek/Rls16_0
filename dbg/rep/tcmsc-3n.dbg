     1210   procedure aht_get-sum-type :
     1211     define input  parameter p-aht-type        as character no-undo .
     1212     define output parameter p-allsum-sum-type as character no-undo .
     1213     do
     1214     on error undo, return error return-value
     1215     :
     1216       case p-aht-type :
     1217         when 'r':U then do:
     1218           assign
     1219             p-allsum-sum-type = 'сумма_по_выкупу_со_знаком':U
     1220           .
     1221         end.
     1222         when 'c':U then do:
     1223           assign
     1224             p-allsum-sum-type = 'сумма_по_консигнации_закупка_со_знаком':U
     1225           .
     1226         end.
     1227         when 'b':U then do:
     1228           assign
     1229             p-allsum-sum-type = 'сумма_по_консигнации_выгода_со_знаком':U
     1230           .
     1231         end.
     1232         when 's':U then do:
     1233           assign
     1234             p-allsum-sum-type = 'сумма_по_ответственному_хранению_со_знаком':U
     1235           .
     1236         end.
     1237         when 'o':U then do:
     1238           assign
     1239             p-allsum-sum-type = 'сумма_по_старой_консигнации_со_знаком':U
     1240           .
     1241         end.
     1242         when 'v':U then do:
     1243           assign
     1244             p-allsum-sum-type = 'сумма_по_услуге_со_знаком':U
     1245           .
     1246         end.
     1247         otherwise do:
     1248           message
     1249             vss-workfile vss-revision vss-description skip
     1250             vss-include-info17 skip
     1251             "Неизвестное значение типа приобретения" skip
     1252             "Тип приобретения" p-aht-type skip
     1253             view-as alert-box error .
     1254           undo, return error .
     1255         end.
     1256       end.
     1257     end.
     1258   end procedure.
