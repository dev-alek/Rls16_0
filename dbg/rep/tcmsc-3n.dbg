     2195   define variable b2-gds-zap-other         like ub.stk-tot.sum-base no-undo.
     2196   define variable  fact-order-1   like ub.stk-tot.fact-order no-undo.
     2197   define variable  quantity1      like ub.stk-tot.fact-qnty  no-undo.
     2198   define variable  coast_r1       like ub.stk-tot.sum-rubl   no-undo.
     2199   define variable  coast_v1       like ub.stk-tot.sum-rubl   no-undo.
     2200   define variable  vat_r1         like ub.stk-tot.sum-rubl   no-undo.
     2201   define variable  vat_v1         like ub.stk-tot.sum-rubl   no-undo.
     2202   define variable  fact-order-2   like ub.stk-tot.fact-order no-undo.
     2203   define variable  quantity2      like ub.stk-tot.fact-qnty  no-undo.
     2204   define variable  coast2         like ub.stk-tot.sum-rubl   no-undo.
     2205   define variable  coast_r2       like ub.stk-tot.sum-rubl   no-undo.
     2206   define variable  coast_v2       like ub.stk-tot.sum-rubl   no-undo.
     2207   define variable  vat_r2         like ub.stk-tot.sum-rubl   no-undo.
     2208   define variable  vat_v2         like ub.stk-tot.sum-rubl   no-undo.
     2209   define variable  quantity    like ub.stk-tot.fact-qnty  no-undo.
     2210   define variable  coast       like ub.stk-tot.sum-rubl   no-undo.
     2211   define variable  coast_r     like ub.stk-tot.sum-rubl   no-undo.
     2212   define variable  coast_v     like ub.stk-tot.sum-rubl   no-undo.
     2213   define variable  vat_r       like ub.stk-tot.sum-rubl   no-undo.
     2214   define variable  vat_v       like ub.stk-tot.sum-rubl   no-undo.
     2215   define variable  slt_r       like ub.stk-tot.sum-rubl   no-undo.
     2216   define variable  slt_v       like ub.stk-tot.sum-rubl   no-undo.
     2217   define variable  coast3       like ub.stk-tot.sum-rubl   no-undo.
     2218   define variable  coast4       like ub.stk-tot.sum-rubl   no-undo.
     2219   define variable  temp-str as character no-undo.
     2220   define variable xshowcost as logical no-undo .
     2221   define variable xshowsale as logical no-undo .
     2222   define variable xshowcrsa as logical no-undo .
     2223   define variable arh-type-sale as character no-undo .
     2224   define variable arh-type-crsa as character no-undo .
     2225   define variable arh-type-cost as character no-undo .
     2226   define variable arh-type-sadt as character no-undo .
     2227   define variable arh-type-cgdt as character no-undo .
     2228   define variable arh-type-csdt as character no-undo .
     2229   define variable arh-type-allsum  as character no-undo .
     2230   define variable str as character format "x(60)" no-undo.
     2231   define variable i#i as integer no-undo.
     2232   define variable xlavel as integer  no-undo.
     2233   define variable list-field as character no-undo.
     2234   define variable str10 as character no-undo.
     2235   define frame zapas
     2236           s-bar-code column-label  "Код! ! ":c9 space(0)
     2237           sym1 column-label ":!:!:" format "x(1)"       space(0)
     2238           gds-zap-artic column-label "Артикул! ! ":c16 format "x(16)" space(0)
     2239           sym2 column-label ":!:!:" format "x(1)"                         space(0)
     2240           gds-zap-gds-name column-label "Название товара! ! ":c36 format "x(36)" space(0)
     2241           sym3 column-label ":!:!:" format "x(1)"                                     space(0)
     2242           gds-zap-unit-base column-label "Ед.!изм! " format "x(3)"                  space(0)
     2243           sym4 column-label ":!:!:" format "x(1)"                                     space(0)
     2244           gds-type column-label "Тип!данных! ":c6 format "x(6)"                  space(0)
     2245           sym5 column-label ":!:!:" format "x(1)" space(0)
     2246           f-ostatok-start     column-label "Остаток на!начало! ":c14 format "x(14)"           space(0)
     2247           sym6 column-label ":!:!:" format "x(1)" space(0)
     2248           f-prih       column-label "Приход! ! ":c14     format "x(14)"     space(0)
     2249           sym7 column-label ":!:!:" format "x(1)" space(0)
     2250           f-rash       column-label "Расход! ! ":c14  format "x(14)"   space(0)
     2251           sym8 column-label ":!:!:" format "x(1)" space(0)
     2252           f-kassa             column-label "Касса! ! ":c14  format "x(14)"   space(0)
     2253           sym9  column-label ":!:!:" format "x(1)" space(0)
     2254           f-inv               column-label "Инвентаризация!Смена типа!приобретения":c14  format "x(14)"   space(0)
     2255           sym10 column-label ":!:!:" format "x(1)" space(0)
     2256           f-overturn         column-label "Переоценка!продажной и!учетной цен":c14  format "x(14)"   space(0)
     2257           sym11 column-label ":!:!:" format "x(1)" space(0)
     2258           gds-zap-other      column-label "Скидка! ! ":c13     space(0)
     2259           sym12 column-label ":!:!:" format "x(1)" space(0)
     2260           f-ostatok-end     column-label "Остаток!на конец! ":c14 format "x(14)"           space(0)
     2261       header
     2262           string( "Дата печати : " + string(today,"99.99.9999") +  " , " + string(time, "hh:mm") ) at 5 format "x(35)"
     2263           "Цены указаны в" (if tprintrubl then "РУБ" else x-base-type )
     2264           string( "Страница " + string( page-number( outstream ), ">>>>>9") ) at 147 format "x(53)" skip
     2265           line format "x(194)" at 1
     2266      with width 232 down stream-io use-text no-box.
     2267        assign
     2268           i = 0
     2269           xlavel        = xvar-lavel
     2270           select-good   = x-selectgood
     2271           paytype       = x-set_pay_type
     2272           retclassify   = xclassify
     2273           retsorttype   = xsorttype
     2274           sums-only     = xsumsonly
     2275           show-negativ  = xshowzero
     2276           show-negativ-2  = xshowzero-2
     2277           xshowcost     = show-cost
     2278           xshowsale     = show-sale
     2279           xshowcrsa     = show-crsa
     2280           firstline     = false
     2281           line          = fill("-", 232)
     2282           valtype       = if (paytype = 1) then 0  else x-set_val_type.
     2283      run report-execute.
     2284   procedure report-execute :
     2285   define variable gj as integer no-undo init 0.
     2286     if (valtype=0 and x-base-code=0)  or valtype=1
     2287                                   then   assign tprintrubl = yes .
     2288                                   else   assign tprintrubl = no .
     2289     if reportpageheight = 0 then reportpageheight  = 43.
     2290   output stream outstream to value( string( session:temp-directory +
     2291                                        "rpt" + string( g#report-num ) ) )
     2292                                        page-size  value(reportpageheight) .
     2293     find first clients where x-store-type = clients.obj-type and
     2294                              x-store-code = clients.obj-code no-lock no-error.
     2295     if available clients then  objname = clients.obj-name.
     2296                                   else  objname="объект не определен".
     2297   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2298   form header
     2299     line format "x(194)" at 1 skip
     2300     "Продолжение - на следующей странице" at 30 skip
     2301     with frame bottomframe width 232 page-bottom no-labels no-box .
     2302   view stream outstream frame bottomframe .
     2303        run report-exec1.
     2304     hide stream outstream frame bottomframe .
     2305     hide   stream outstream frame zapas .
     2306     output stream outstream close.
     2307   if mFrameView
     2308   then do:
     2309      HIDE FRAME InfoFrame.
     2310   end.
     2311     if Make-Excel then output stream ForExcel close.
     2312     define variable v-user-action as character no-undo .
     2313     define variable v-printed as logical   no-undo .
     2314     define variable DisabledOptions as integer   no-undo .
     2315     define variable v-orient-page as character no-undo .
     2316     run How-name in this-procedure (
     2317         input ReportPageHeight,
     2318         input ReportPageWidth,
     2319         output v-orient-page )
     2320         .
     2321     if v-orient-page = "A4-lans":U then DisabledOptions = 8 .
     2322                                    else DisabledOptions = 0 .
     2323     run gbl/prnfilen.w
     2324       (input  ""
     2325       ,input  DisabledOptions
     2326       ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     2327       ,input  ReportFontNum
     2328       ,output v-user-action
     2329       ,output v-printed
     2330       ) .
     2331   end procedure.
     2332   procedure clear-line :
     2333    do
     2334    on error undo, return error return-value
     2335    :
     2336       assign
     2337           ostatok-start[1]  = 0
     2338           ostatok-start[2]  = 0
     2339           ostatok-start[3]  = 0
     2340           ostatok-start[4]  = 0
     2341           ostatok-start[5]  = 0
     2342           ostatok-start[6]  = 0
     2343           ostatok-start[7]  = 0
     2344           ostatok-start[8]  = 0
     2345           ostatok-start[9]  = 0
     2346           ostatok-start[10] = 0
     2347           ostatok-end[1]  = 0
     2348           ostatok-end[2]  = 0
     2349           ostatok-end[3]  = 0
     2350           ostatok-end[4]  = 0
     2351           ostatok-end[5]  = 0
     2352           ostatok-end[6]  = 0
     2353           ostatok-end[7]  = 0
     2354           ostatok-end[8]  = 0
     2355           ostatok-end[9]  = 0
     2356           ostatok-end[10] = 0
     2357     .
     2358    end.
     2359   end procedure.
     2360   procedure ost-line :
     2361   do
     2362   on error undo, return error return-value
     2363   :
     2364   define input parameter p-store-type like ub.clients.obj-type no-undo .
     2365   define input parameter p-store-code like ub.clients.obj-code no-undo .
     2366   define buffer buf_aht-stk-line  for ub.aht-stk-line .
     2367    find last  ub.aht-stk-line where
     2368                           ub.aht-stk-line.gds-code   = gds-zap-b-code
     2369                     and   ub.aht-stk-line.fact-order <= fact-order-1
     2370                     and   ub.aht-stk-line.obj-code   = p-store-code
     2371                     and   ub.aht-stk-line.obj-type   = p-store-type
     2372                     and   ub.aht-stk-line.sum-type   = "c"
     2373                           use-index category no-lock no-error.
     2374    find last  buf_aht-stk-line where
     2375                           buf_aht-stk-line.gds-code   = gds-zap-b-code
     2376                     and   buf_aht-stk-line.fact-order <= fact-order-1
     2377                     and   buf_aht-stk-line.obj-code   = p-store-code
     2378                     and   buf_aht-stk-line.obj-type   = p-store-type
     2379                     and   buf_aht-stk-line.sum-type   = "b"
     2380                           use-index category no-lock no-error.
     2381           if available ub.aht-stk-line
     2382              and available buf_aht-stk-line
     2383           then do:
     2384               if  tprintrubl  then
     2385                     assign
     2386                           ostatok-start[1]  = ostatok-start[1] + round(  ub.aht-stk-line.fact-qnty,3)
     2387                           ostatok-start[2]  = ostatok-start[2] + round( ub.aht-stk-line.cost-sum-rubl ,2)
     2388                           ostatok-start[3]  = ostatok-start[3] + round( ub.aht-stk-line.cost-vat-rubl ,2)
     2389                           ostatok-start[4]  = ostatok-start[4] +  0
     2390                           ostatok-start[5]  = ostatok-start[5] + round( buf_aht-stk-line.crsa-sum-rubl ,2) + round( ub.aht-stk-line.crsa-sum-rubl ,2)
     2391                           ostatok-start[6]  = ostatok-start[6] + round( buf_aht-stk-line.crsa-vat-rubl ,2) + round( ub.aht-stk-line.crsa-vat-rubl ,2)
     2392                           ostatok-start[7]  = ostatok-start[7] + round( buf_aht-stk-line.sale-discnt-rubl ,2)
     2393                           ostatok-start[8]  = ostatok-start[8] + round( buf_aht-stk-line.crsa-sum-rubl ,2)
     2394                           ostatok-start[9]  = ostatok-start[9] + round( buf_aht-stk-line.crsa-vat-rubl ,2)
     2395                           ostatok-start[10] = ostatok-start[10] + round( buf_aht-stk-line.crsa-slt-rubl ,2)
     2396                           .
     2397                 else
     2398                     assign
     2399                           ostatok-start[1]  = ostatok-start[1] + round( ub.aht-stk-line.fact-qnty,3)
     2400                           ostatok-start[2]  = ostatok-start[2] + round( ub.aht-stk-line.cost-sum-base ,2)
     2401                           ostatok-start[3]  = ostatok-start[3] + round( ub.aht-stk-line.cost-vat-base ,2)
     2402                           ostatok-start[4]  = ostatok-start[4] + 0
     2403                           ostatok-start[5]  = ostatok-start[5] + round( buf_aht-stk-line.crsa-sum-base ,2) + round( ub.aht-stk-line.crsa-sum-base ,2)
     2404                           ostatok-start[6]  = ostatok-start[6] + round( buf_aht-stk-line.crsa-vat-base ,2) + round( ub.aht-stk-line.crsa-vat-base ,2)
     2405                           ostatok-start[7]  = ostatok-start[7] + round( buf_aht-stk-line.sale-discnt-base ,2)
     2406                           ostatok-start[8]  = ostatok-start[8] + round( buf_aht-stk-line.crsa-sum-base ,2)
     2407                           ostatok-start[9]  = ostatok-start[9] + round( buf_aht-stk-line.crsa-vat-base ,2)
     2408                           ostatok-start[10] = ostatok-start[10] + round( buf_aht-stk-line.crsa-slt-base ,2)
     2409                     .
     2410                end.
     2411    find last  ub.aht-stk-line where
     2412                           ub.aht-stk-line.gds-code   = gds-zap-b-code
     2413                     and   ub.aht-stk-line.fact-order <= fact-order-2
     2414                     and   ub.aht-stk-line.obj-code   = p-store-code
     2415                     and   ub.aht-stk-line.obj-type   = p-store-type
     2416                     and   ub.aht-stk-line.sum-type   = "c"
     2417                           use-index category no-lock no-error.
     2418    find last  buf_aht-stk-line where
     2419                            buf_aht-stk-line.gds-code   = gds-zap-b-code
     2420                     and    buf_aht-stk-line.fact-order <= fact-order-2
     2421                     and    buf_aht-stk-line.obj-code   = p-store-code
     2422                     and    buf_aht-stk-line.obj-type   = p-store-type
     2423                     and    buf_aht-stk-line.sum-type   = "b"
     2424                           use-index category no-lock no-error.
     2425           if available ub.aht-stk-line and
     2426              available buf_aht-stk-line then do:
     2427               if  tprintrubl  then
     2428                     assign
     2429                           ostatok-end[1]  = ostatok-end[1] + round( ub.aht-stk-line.fact-qnty,3)
     2430                           ostatok-end[2]  = ostatok-end[2] + round( ub.aht-stk-line.cost-sum-rubl ,2)
     2431                           ostatok-end[3]  = ostatok-end[3] + round( ub.aht-stk-line.cost-vat-rubl ,2)
     2432                           ostatok-end[4]  = ostatok-end[4] + 0
     2433                           ostatok-end[5]  = ostatok-end[5] + round( buf_aht-stk-line.crsa-sum-rubl ,2) + round( ub.aht-stk-line.crsa-sum-rubl ,2)
     2434                           ostatok-end[6]  = ostatok-end[6] + round( buf_aht-stk-line.crsa-vat-rubl ,2) + round( ub.aht-stk-line.crsa-vat-rubl ,2)
     2435                           ostatok-end[7]  = ostatok-end[7] + round( buf_aht-stk-line.sale-discnt-rubl ,2)
     2436                           ostatok-end[8]  = ostatok-end[8] + round( buf_aht-stk-line.crsa-sum-rubl ,2)
     2437                           ostatok-end[9]  = ostatok-end[9] + round( buf_aht-stk-line.crsa-vat-rubl ,2)
     2438                           ostatok-end[10] = ostatok-end[10] + round( buf_aht-stk-line.crsa-slt-rubl ,2)
     2439                           .
     2440                 else
     2441                     assign
     2442                           ostatok-end[1]  = ostatok-end[1] + round( ub.aht-stk-line.fact-qnty,3)
     2443                           ostatok-end[2]  = ostatok-end[2] +  round( ub.aht-stk-line.cost-sum-base ,2)
     2444                           ostatok-end[3]  = ostatok-end[3] +  round( ub.aht-stk-line.cost-vat-base ,2)
     2445                           ostatok-end[4]  = ostatok-end[4] +  0
     2446                           ostatok-end[5]  = ostatok-end[5] +  round( buf_aht-stk-line.crsa-sum-base ,2) + round( ub.aht-stk-line.crsa-sum-rubl     , 2)
     2447                           ostatok-end[6]  = ostatok-end[6] +  round( buf_aht-stk-line.crsa-vat-base ,2) + round( ub.aht-stk-line.crsa-vat-base , 2)
     2448                           ostatok-end[7]  = ostatok-end[7] +  round( buf_aht-stk-line.sale-discnt-base ,2)
     2449                           ostatok-end[8]  = ostatok-end[8] +  round( buf_aht-stk-line.crsa-sum-base ,2)
     2450                           ostatok-end[9]  = ostatok-end[9] +  round( buf_aht-stk-line.crsa-vat-base ,2)
     2451                           ostatok-end[10] = ostatok-end[10] + round( buf_aht-stk-line.crsa-slt-base ,2)
     2452                     .
     2453                end.
     2454   end.
     2455   end procedure.
     2456   procedure foreach :
     2457   define variable old-type as character no-undo .
     2458      old-type = x-type-pr.
     2459   IF ( i modulo v-account = 0 )  then DO:
     2460    Assign
     2461       v-kol-spice = (50 - LENGTH(reportname)) / 2
     2462       RecordsString = fill(' ',v-kol-spice) + string(reportname)
     2463       .
     2464    Assign
     2465       v-kol-spice = (50 - LENGTH(objname)) / 2
     2466       RecordsString2 = fill(' ',v-kol-spice) + string(objname)
     2467       .
     2468             if  log-manager:logfile-name ne ?
     2469             then DO:
     2470                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     2471             end.
     2472              if mFrameView
     2473              then do:
     2474               DISPLAY
     2475                 i @ RecordsDone
     2476                 RecordsString   @ RecordsString
     2477                 RecordsString2  @ RecordsString2
     2478                 WITH FRAME InfoFrame.
     2479              end.
     2480   End.
     2481      if v-button-stop then  DO:
     2482            if mFrameView
     2483            then
     2484               PROCESS EVENTS.
     2485            IF StopProcessing THEN DO:
     2486            RETURN error.
     2487            End.
     2488      end.
     2489     run clear-item.
     2490     run clear-line.
     2491     for each obj-list  no-lock :
     2492          run ost-line (obj-list.obj-type , obj-list.obj-code ) .
     2493     end.
     2494      run ob-line (
     2495             input   x-store-code   ,
     2496             input   x-store-type   ,
     2497             input   gds-zap-b-code ,
     2498             input   fact-order-1,
     2499             input   fact-order-2,
     2500             input   x-type-pr     ,
     2501             input   xtog-obj) .
     2502      run calc-sub-itog .
     2503   end procedure.
     2504   procedure display-line :
     2505        i = i + 1.
     2506           if not( not show-negativ-2 and
     2507            ( prih         [1]   = 0 and
     2508             rash          [1]   = 0 and
     2509             kassa         [1]   = 0 and
     2510             inv           [1]   = 0 and
     2511             overturn      [1]   = 0 and
     2512             overturn      [5]   = 0 and
     2513             overturn      [8]   = 0 ) ) then do:
     2514           if  not (not show-negativ  and (
     2515                 prih          [1]   = 0 and
     2516                 rash          [1]   = 0 and
     2517                 kassa         [1]   = 0 and
     2518                 inv           [1]   = 0 and
     2519                 overturn      [1]   = 0 and
     2520                 overturn      [5]   = 0 and
     2521                 ostatok-start [1]   = 0 and
     2522                 ostatok-end   [1]   = 0   )) then do:
     2523           if not sums-only then do:
     2524               if fr0 = true then do:
     2525                 put stream  outstream  tmp#stroka0 format "x(100)" skip.
     2526                 if Make-Excel then  put   stream ForExcel unformatted string(tmp#stroka0) skip.
     2527                 fr0 = false .
     2528               end.
     2529               if fr = true then do:
     2530                 put stream outstream space(10) temp-str format "x(100)" skip.
     2531                 if Make-Excel then  put   stream ForExcel unformatted CHR(9) string(temp-str) skip.
     2532                 fr = false .
     2533               end.
     2534              run display-str1 in this-procedure.
     2535             end.
     2536           end.
     2537        end.
     2538     end procedure.
     2539   procedure print-header :
     2540   if not firstline then do:
     2541      run display-title.
     2542      form with FRAME ZAPAS .  DOWN stream   OutStream 1 with FRAME ZAPAS .
     2543   end.
     2544    firstline = true .
     2545       if xtog-obj and   x-selectobject <> "currency":u   then  do:
     2546             PUT stream  OutStream  UNFORMATTED     "ПО ОБЪЕКТУ : " + caps(clients.obj-name)  at 30 format "x(170)" skip.
     2547             if Make-Excel then  put   stream ForExcel unformatted   "ПО ОБЪЕКТУ : " + caps(clients.obj-name) format "x(170)" skip.
     2548         end.
     2549         run clear-b1 .
     2550         run clear-b2.
     2551         run clear-bi .
     2552         break_group = true.
     2553         break_group1 = true.
     2554      end procedure.
     2555   procedure print-footer :
     2556         if retclassify = "no-classify":u  then run u-line.
     2557          gds-zap-artic = "ИТОГО" .
     2558          run display-bi.
     2559          run u-line.
     2560          end procedure.
     2561   procedure u-line :
