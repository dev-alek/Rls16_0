     3123   procedure display-title :
     3124      PUT stream  OutStream  UNFORMATTED  string( v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + objname) at 50 format "x(85)" skip(2)
     3125             reportname  at 20 format "x(170)" skip
     3126             trim(str1)  at 35 format "x(75)" skip.
     3127        repeat i = 1 to num-entries(str2,chr(10)) :
     3128         PUT stream  OutStream  UNFORMATTED  entry(i,str2,chr(10))  at 1 format "x(170)" skip.
     3129        end.
     3130       i=0.
     3131          PUT stream  OutStream  UNFORMATTED  trim(str3)  at 35 format "x(75)" skip.
     3132        repeat i = 1 to num-entries(str4,chr(10)) :
     3133         PUT stream  OutStream  UNFORMATTED  entry(i,str4,chr(10))  at 1 format "x(170)" skip.
     3134        end.
     3135       i=0.
     3136        repeat i = 1 to num-entries(reportheader,chr(10)) :
     3137         PUT stream  OutStream  UNFORMATTED  entry(i,reportheader,chr(10))  at 1 format "x(170)" skip.
     3138        end.
     3139       i=0.
     3140       run rep/extitle.p (1) .
     3141   end procedure.
     3142   procedure ob-line  :
     3143   define input  parameter x-store-code     like ub.clients.obj-code         no-undo .
     3144   define input  parameter x-store-type     like ub.clients.obj-type         no-undo .
     3145   define input  parameter x-gds-code       like ub.aht-ot-line.gds-code     no-undo .
     3146   define input  parameter x-fact-order-1   like ub.aht-ot-line.fact-order   no-undo .
     3147   define input  parameter x-fact-order-2   like ub.aht-ot-line.fact-order   no-undo .
     3148   define input  parameter x-sum-type       like ub.aht-ot-line.sum-type     no-undo .
     3149   define input  parameter xtog-obj         as logical no-undo .
     3150   define variable      tt#              as integer no-undo .
     3151   define variable x-type-pr1 as character no-undo .
     3152   define variable x-type-pr2 as character no-undo .
     3153    if x-sum-type = arh-type-cost then tt# = 0 .
     3154    if x-sum-type = arh-type-crsa then tt# = 3 .
     3155    if x-sum-type = arh-type-sale then tt# = 6 .
     3156     for each obj-list  no-lock :
     3157        for each ub.aht-ot-line where
     3158                           ub.aht-ot-line.gds-code      = x-gds-code
     3159                     and   ub.aht-ot-line.fact-order   <= x-fact-order-2
     3160                     and   ub.aht-ot-line.fact-order   >= x-fact-order-1
     3161                     and   ub.aht-ot-line.obj-code     = obj-list.obj-code
     3162                     and   ub.aht-ot-line.obj-type     = obj-list.obj-type
     3163                     and   ub.aht-ot-line.sum-type     = "c"
     3164                     no-lock :
     3165       case ub.aht-ot-line.ext-doc-type:
     3166                 when        'ie':U  or
     3167                 when        're':U  or
     3168                 when        'iv':U    or
     3169                 when        'rv':U or
     3170                 when        'im':U     then
     3171                 do:
     3172                 assign
     3173                        prih[1 ]   = prih[1]   + (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     3174                        prih[2 ]   = prih[2]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     3175                        prih[3 ]   = prih[3]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     3176                        prih[5 ]   = prih[5]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     3177                        prih[6 ]   = prih[6]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     3178                  .
     3179                 end.
     3180                 when       'ee':U      or
     3181                 when       'ep':U    or
     3182                 when       'ev':U     or
     3183                 when       'em':U       or
     3184                 when       'wm':U       or
     3185                 when       'we':U     then
     3186                 do:
     3187                   assign
     3188                       rash[1 ]   = rash[1]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     3189                       rash[2 ]   = rash[2]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     3190                       rash[3 ]   = rash[3]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     3191                       rash[5 ]   = rash[5]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     3192                       rash[6 ]   = rash[6]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     3193                 .
     3194                 end.
     3195                 when       'es':U  or
     3196                 when       'rs':U then
     3197                 do:
     3198                     assign
     3199                       kassa[1 ]   = kassa[1]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     3200                       kassa[2 ]   = kassa[2]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     3201                       kassa[3 ]   = kassa[3]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     3202                       kassa[5 ]   = kassa[5]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     3203                       kassa[6 ]   = kassa[6]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     3204                       .
     3205                 end.
     3206             when       'vt':U            or
     3207             when       'pc':U or
     3208             when       'vp':U       then do:
     3209                 assign
     3210                   inv[1 ]   = inv[1]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     3211                   inv[2 ]   = inv[2]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     3212                   inv[3 ]   = inv[3]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     3213                   inv[5 ]   = inv[5]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     3214                   inv[6 ]   = inv[6]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     3215                   .
     3216                 end.
     3217             when       'ot':U or
     3218             when       'ap':U then
     3219                 do:
     3220                    assign
     3221                       overturn[1 ]   = overturn[1]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     3222                       overturn[2 ]   = overturn[2]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     3223                       overturn[3 ]   = overturn[3]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     3224                       overturn[5 ]   = overturn[5]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     3225                       overturn[6 ]   = overturn[6]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     3226                       .
     3227                 end.
     3228         end case.
     3229      end.
     3230     end.
     3231     for each obj-list  no-lock :
     3232        for each ub.aht-ot-line where
     3233                           ub.aht-ot-line.gds-code      = x-gds-code
     3234                     and   ub.aht-ot-line.fact-order   <= x-fact-order-2
     3235                     and   ub.aht-ot-line.fact-order   >= x-fact-order-1
     3236                     and   ub.aht-ot-line.obj-code     = obj-list.obj-code
     3237                     and   ub.aht-ot-line.obj-type     = obj-list.obj-type
     3238                     and   ub.aht-ot-line.sum-type     = "b"
     3239                     no-lock :
     3240       case ub.aht-ot-line.ext-doc-type:
     3241                 when        'ie':U  or
     3242                 when        're':U  or
     3243                 when        'iv':U    or
     3244                 when        'rv':U or
     3245                 when        'im':U     then
     3246                 do:
     3247                 assign
     3248                        prih[5 ]   = prih[5]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     3249                        prih[6 ]   = prih[6]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     3250                        prih[7 ]   = prih[7]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     3251                        prih[8 ]   = prih[8]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     3252                        prih[9 ]   = prih[9]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     3253                        gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     3254                  .
     3255                 end.
     3256                 when 'ee':U      or
     3257                 when 'ep':U   or
     3258                 when 'ev':U      or
     3259                 when 'em':U       or
     3260                 when 'wm':U       or
     3261                 when 'we':U      then
     3262                 do:
     3263                   assign
     3264                       rash[5 ]   = rash[5]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     3265                       rash[6 ]   = rash[6]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     3266                       rash[7 ]   = rash[7]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     3267                       rash[8 ]   = rash[8]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl - ub.aht-ot-line.sale-slt-rubl  else  ub.aht-ot-line.crsa-sum-base - ub.aht-ot-line.sale-slt-base
     3268                       rash[9 ]   = rash[9]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     3269                       gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     3270                 .
     3271                 end.
     3272                 when       'es':U  or
     3273                 when       'rs':U then
     3274                 do:
     3275                     assign
     3276                       kassa[5 ]   = kassa[5]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     3277                       kassa[6 ]   = kassa[6]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     3278                       kassa[7 ]   = kassa[7]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     3279                       kassa[8 ]   = kassa[8]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl - ub.aht-ot-line.crsa-slt-rubl else  ub.aht-ot-line.crsa-sum-base - ub.aht-ot-line.crsa-slt-base
     3280                       kassa[9 ]   = kassa[9]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     3281                       gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     3282                       .
     3283                 end.
     3284             when       'vt':U            or
     3285             when       'pc':U or
     3286             when       'vp':U       then
     3287                 do:
     3288                 assign
     3289                   inv[5 ]   = inv[5]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     3290                   inv[6 ]   = inv[6]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     3291                   inv[7 ]   = inv[7]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     3292                   inv[8 ]   = inv[8]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     3293                   inv[9 ]   = inv[9]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     3294                   gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     3295                   .
     3296                 end.
     3297             when       'ot':U or
     3298             when       'ap':U then
     3299                 do:
     3300                    assign
     3301                       overturn[5 ]   = overturn[5]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     3302                       overturn[6 ]   = overturn[6]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     3303                       overturn[7 ]   = overturn[7]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     3304                       overturn[8 ]   = overturn[8]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     3305                       overturn[9 ]   = overturn[9]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     3306                       gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     3307                       .
     3308                 end.
     3309         end case.
     3310      end.
     3311     end.
     3312     assign
     3313       tt# = 6
     3314       overturn[1 + tt#]   = (ostatok-end[1 + tt#]  - ostatok-start[1 + tt#] )  -  (inv[1 + tt#] + prih[1 + tt#] + kassa[1 + tt#] + rash[1 + tt#]  )
     3315       overturn[2 + tt#]   = (ostatok-end[2 + tt#]  - ostatok-start[2 + tt#] )  -  (inv[2 + tt#] + prih[2 + tt#] + kassa[2 + tt#] + rash[2 + tt#]  )
     3316       overturn[3 + tt#]   = (ostatok-end[3 + tt#]  - ostatok-start[3 + tt#] )  -  (inv[3 + tt#] + prih[3 + tt#] + kassa[3 + tt#] + rash[3 + tt#]  )
     3317       .
     3318   end procedure.
     3319   procedure report-exec1  :
     3320      find first clients where x-store-type = clients.obj-type and
     3321                               x-store-code = clients.obj-code no-lock no-error.
     3322     run calcitog.
     3323     run print-header.
     3324      case retclassify :
     3325         when "prod":u  then          run run3 in this-procedure .
     3326         otherwise do:
     3327           message "error" view-as alert-box error .
     3328         end.
     3329      end case.
     3330     run print-footer.
     3331     end procedure.
     3332   procedure calc-sub-itog :
     3333   define variable b  as integer no-undo.
     3334   assign
     3335     b1-gds-zap-other = b1-gds-zap-other +  gds-zap-other
     3336     b2-gds-zap-other = b2-gds-zap-other +  gds-zap-other
     3337     bi-gds-zap-other = bi-gds-zap-other +  gds-zap-other
     3338     bo-gds-zap-other = bo-gds-zap-other +  gds-zap-other
     3339     .
     3340   repeat b = 1 to 10 :
     3341     assign
     3342     b1-ostatok-start[b ]    = b1-ostatok-start[b ]    +  ostatok-start[b ]
     3343     b1-ostatok-end  [b ]    = b1-ostatok-end  [b ]    +  ostatok-end  [b ]
     3344     b2-ostatok-start[b ]    = b2-ostatok-start[b ]    +  ostatok-start[b ]
     3345     b2-ostatok-end  [b ]    = b2-ostatok-end  [b ]    +  ostatok-end  [b ]
     3346     bi-ostatok-start[b ]    = bi-ostatok-start[b ]    +  ostatok-start[b ]
     3347     bi-ostatok-end  [b ]    = bi-ostatok-end  [b ]    +  ostatok-end  [b ]
     3348     bo-ostatok-start[b ]    = bo-ostatok-start[b ]    +  ostatok-start[b ]
     3349     bo-ostatok-end  [b ]    = bo-ostatok-end  [b ]    +  ostatok-end  [b ]
     3350     b1-prih[b ]    = b1-prih[b ]    +  prih[b ]
     3351     b2-prih[b ]    = b2-prih[b ]    +  prih[b ]
     3352     bi-prih[b ]    = bi-prih[b ]    +  prih[b ]
     3353     bo-prih[b ]    = bo-prih[b ]    +  prih[b ]
     3354     b1-rash[b ]    = b1-rash[b ]    +  rash[b ]
     3355     b2-rash[b ]    = b2-rash[b ]    +  rash[b ]
     3356     bi-rash[b ]    = bi-rash[b ]    +  rash[b ]
     3357     bo-rash[b ]    = bo-rash[b ]    +  rash[b ]
     3358     b1-kassa[b ]    = b1-kassa[b ]    +  kassa[b ]
     3359     b2-kassa[b ]    = b2-kassa[b ]    +  kassa[b ]
     3360     bi-kassa[b ]    = bi-kassa[b ]    +  kassa[b ]
     3361     bo-kassa[b ]    = bo-kassa[b ]    +  kassa[b ]
     3362     b1-inv[b ]    = b1-inv[b ]    +  inv[b ]
     3363     b2-inv[b ]    = b2-inv[b ]    +  inv[b ]
     3364     bi-inv[b ]    = bi-inv[b ]    +  inv[b ]
     3365     bo-inv[b ]    = bo-inv[b ]    +  inv[b ]
     3366     b1-overturn[b ]    = b1-overturn[b ]    +  overturn[b ]
     3367     b2-overturn[b ]    = b2-overturn[b ]    +  overturn[b ]
     3368     bi-overturn[b ]    = bi-overturn[b ]    +  overturn[b ]
     3369     bo-overturn[b ]    = bo-overturn[b ]    +  overturn[b ]
     3370     .
     3371   end.
     3372   end procedure.
     3373   procedure clear-item :
     3374   define variable kk as integer no-undo.
     3375    gds-zap-other = 0 .
     3376    repeat kk = 1 to 9 :
     3377    assign
     3378       prih            [kk]    = 0
     3379       rash            [kk]    = 0
     3380       kassa           [kk]    = 0
     3381       inv             [kk]    = 0
     3382       overturn        [kk]    = 0
     3383       ostatok-end     [kk]    = 0
     3384       ostatok-start   [kk]    = 0 .
     3385          end.
     3386    end procedure.
     3387   procedure item-goods :
     3388      define input parameter  par-3 as character no-undo.
     3389      define input parameter  par-4 as character no-undo.
     3390        if par-4 = "goods":u  then do:
     3391           assign
     3392               gds-zap-unit-base  = goods.unit-base
     3393               gds-zap-prt-root   = goods.prt-root
     3394               gds-zap-prod-type  = goods.prod-type
     3395               gds-zap-prod-code  = goods.prod-code
     3396               gds-zap-artic      = goods.artic
     3397               gds-zap-grp-name   = goods.grp-name
     3398               gds-zap-b-code     = goods.gds-code
     3399               gds-zap-type       = goods.gds-type.
     3400           if g#gds-engl then
     3401               assign gds-zap-gds-name = goods.engl-name.
     3402           else
     3403               assign gds-zap-gds-name = goods.gds-name.
     3404        end.
     3405        if par-4 = "gds-list":u  then do:
     3406           assign
     3407               gds-zap-unit-base  = gds-list.unit-base
     3408               gds-zap-prt-root   = gds-list.prt-root
     3409               gds-zap-prod-type  = gds-list.prod-type
     3410               gds-zap-prod-code  = gds-list.prod-code
     3411               gds-zap-artic      = gds-list.artic
     3412               gds-zap-grp-name   = gds-list.grp-name
     3413               gds-zap-b-code     = gds-list.gds-code
     3414               gds-zap-type       = gds-list.gds-type.
     3415           if g#gds-engl then
     3416               assign gds-zap-gds-name = gds-list.engl-name.
     3417           else
     3418               assign gds-zap-gds-name = gds-list.gds-name.
     3419        end.
     3420       run foreach.
     3421   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3422     (input  gds-zap-b-code
     3423     ,input  ?
     3424     ,output v-bar-code
     3425     )  .
     3426   s-bar-code = string (v-bar-code,"999999999").
     3427       If  break_group = true  and par-3 <> "1"  then DO :
     3428            FIND FIRST clients WHERE clients.obj-type = gds-zap-prod-type AND clients.obj-code = gds-zap-prod-code use-index pi NO-LOCK .
     3429            gds-zap-prod-name  = clients.obj-name.
     3430             If break_group1 = true  THEN  DO :
     3431               if (par-3 = "3"  OR  par-3 = "5" ) and  par-3 <> "6"
     3432                 then DO: Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )         b1-name = gds-zap-grp-name . end.
     3433                 else DO: Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) b1-name = gds-zap-prod-name. end.
     3434               if par-3 = "6"  then  dO:
     3435                  if xTog-obj = true then do:
     3436                    var-vat-pc = func-vat (input gds-zap-b-code , input x-store-type, input x-store-code)
     3437                     .
     3438                   end.
     3439                  else do:
     3440                   var-vat-pc = temp-gds-list.vat-pc .
     3441                   end.
     3442                   assign
     3443                       temp-str = string( "СТАВКА НДС : " + string(var-vat-pc) + "%" )
     3444                       b1-name = temp-str.
     3445                   end.
     3446               if NOT xSumsOnly or (par-3 = "4" Or par-3 = "5" ) THEN DO :
     3447                   fr0 = true .
     3448                   tmp#stroka0 = temp-str.
     3449               End.
     3450             End.
     3451               IF (par-3 = "4"  OR  par-3 = "5")  THEN DO:
     3452                 if par-3 = "4"
     3453                   then Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )          b2-name = gds-zap-grp-name .
     3454                   else Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name )  b2-name = gds-zap-prod-name.
     3455                 if NOT xSumsOnly THEN DO:
     3456                     fr = true .
     3457                 End.
     3458                 break_group1 = false.
     3459               END.
     3460          break_group = false.
     3461       End.
     3462       run display-line.
     3463    end procedure.
     3464   procedure di :
     3465   define input parameter p1 as character no-undo.
     3466   define input parameter p2 as integer no-undo.
     3467   define input parameter p3 as character no-undo.
     3468   define input parameter p4 as character no-undo.
     3469   define input parameter p5 as character no-undo.
     3470   define input parameter p6 as character no-undo.
     3471   define input parameter p7 as character no-undo.
     3472    case caps(p7) :
     3473      when "b1":u  then do:
     3474       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3475         p3 @ s-bar-code
     3476         p4 @ gds-zap-artic
     3477         p5 @ gds-zap-gds-name
     3478         p6 @ gds-zap-unit-base
     3479         p1 @ gds-type
     3480         b1-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     3481         b1-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     3482         b1-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     3483         b1-KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     3484         b1-Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     3485         b1-Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     3486         b1-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     3487         b1-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     3488         with FRAME ZAPAS .
     3489                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     3490                   end.
     3491      when "b2":u  then  do:
     3492       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3493         p3 @ s-bar-code
     3494         p4 @ gds-zap-artic
     3495         p5 @ gds-zap-gds-name
     3496         p6 @ gds-zap-unit-base
     3497         p1 @ gds-type
     3498         b2-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     3499         b2-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     3500         b2-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     3501         b2-KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     3502         b2-Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     3503         b2-Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     3504         b2-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     3505         b2-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     3506         with FRAME ZAPAS .
     3507                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     3508                 end.
     3509      when "bi":u then  do:
     3510       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3511         p3 @ s-bar-code
     3512         p4 @ gds-zap-artic
     3513         p5 @ gds-zap-gds-name
     3514         p6 @ gds-zap-unit-base
     3515         p1 @ gds-type
     3516         bi-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     3517         bi-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     3518         bi-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     3519         bi-KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     3520         bi-Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     3521         bi-Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     3522         bi-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     3523         bi-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     3524         with FRAME ZAPAS .
     3525                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     3526                 end.
     3527      when "bo":u then  do:
     3528       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3529         p3 @ s-bar-code
     3530         p4 @ gds-zap-artic
     3531         p5 @ gds-zap-gds-name
     3532         p6 @ gds-zap-unit-base
     3533         p1 @ gds-type
     3534         bo-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     3535         bo-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     3536         bo-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     3537         bo-KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     3538         bo-Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     3539         bo-Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     3540         bo-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     3541         bo-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     3542         with FRAME ZAPAS .
     3543                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     3544                 end.
     3545      when ""  then  do:
     3546       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3547         p3 @ s-bar-code
     3548         p4 @ gds-zap-artic
     3549         p5 @ gds-zap-gds-name
     3550         p6 @ gds-zap-unit-base
     3551         p1 @ gds-type
     3552         ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     3553         Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     3554         RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     3555         KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     3556         Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     3557         Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     3558         Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     3559         gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     3560         with FRAME ZAPAS .
     3561                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     3562                 end.
     3563      end case.
     3564    end procedure.
     3565   procedure di-qnty :
     3566   define input parameter p1 as character no-undo.
     3567   define input parameter p2 as integer no-undo.
     3568   define input parameter p3 as character no-undo.
