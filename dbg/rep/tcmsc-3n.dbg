     1640   procedure aht_add-document :
     1641     define input  parameter p-doc-code     like ub.aht-doc.doc-code     no-undo .
     1642     define input  parameter p-obj-type     like ub.aht-doc.obj-type     no-undo .
     1643     define input  parameter p-obj-code     like ub.aht-doc.obj-code     no-undo .
     1644     define input  parameter p-ext-doc-type like ub.aht-doc.ext-doc-type no-undo .
     1645     define input  parameter p-is-trn-doc   like ub.aht-doc.is-trn-doc   no-undo .
     1646     define input  parameter p-fact-order   like ub.aht-doc.fact-order   no-undo .
     1647     define input  parameter p-fact-date    like ub.aht-doc.fact-date    no-undo .
     1648     define input  parameter p-shift-date   like ub.aht-doc.shift-date   no-undo .
     1649     define input  parameter p-shift-num    like ub.aht-doc.shift-num    no-undo .
     1650     define buffer buf_aht-doc for ub.aht-doc .
     1651     do
     1652     on error undo, return error return-value
     1653     :
     1654       find first buf_aht-doc exclusive-lock
     1655         where buf_aht-doc.doc-code = p-doc-code
     1656         no-error .
     1657       if available buf_aht-doc then do:
     1658         message
     1659           vss-workfile vss-revision vss-description skip
     1660           vss-include-info17 skip
     1661           "Попытка повторного создания записи" skip
     1662           "Документ" p-doc-code skip
     1663           view-as alert-box error .
     1664         undo, return error .
     1665       end.
     1666       if p-fact-order = ?
     1667       or p-fact-order = 0
     1668       then do:
     1669         message
     1670           vss-workfile vss-revision vss-description skip
     1671           vss-include-info17 skip
     1672           "Ошибка задания входных параметров" skip
     1673           "Не задан номер документа" skip
     1674           "Документ" p-doc-code skip
     1675           "Номер документа" p-fact-order skip
     1676           view-as alert-box error .
     1677         undo, return error .
     1678       end.
     1679       create buf_aht-doc .
     1680       assign
     1681         buf_aht-doc.doc-code     = p-doc-code
     1682         buf_aht-doc.obj-type     = p-obj-type
     1683         buf_aht-doc.obj-code     = p-obj-code
     1684         buf_aht-doc.ext-doc-type = p-ext-doc-type
     1685         buf_aht-doc.is-trn-doc   = p-is-trn-doc
     1686         buf_aht-doc.fact-order   = p-fact-order
     1687         buf_aht-doc.fact-date    = p-fact-date
     1688         buf_aht-doc.shift-date   = p-shift-date
     1689         buf_aht-doc.shift-num    = p-shift-num
     1690       .
     1691     end.
     1692   end procedure.
     1693   procedure aht_add-date :
     1694     define input  parameter p-obj-type     like ub.aht-stk.obj-type     no-undo .
     1695     define input  parameter p-obj-code     like ub.aht-stk.obj-code     no-undo .
     1696     define input  parameter p-stk-type     like ub.aht-stk.stk-type     no-undo .
     1697     define input  parameter p-fact-order   like ub.aht-stk.fact-order   no-undo .
     1698     define input  parameter p-fact-date    like ub.aht-stk.fact-date    no-undo .
     1699     define input  parameter p-shift-date   like ub.aht-stk.shift-date   no-undo .
     1700     define input  parameter p-shift-num    like ub.aht-stk.shift-num    no-undo .
     1701     define buffer buf_aht-stk for ub.aht-stk .
     1702     do
     1703     on error undo, return error return-value
     1704     :
     1705       find first buf_aht-stk no-lock
     1706         where buf_aht-stk.obj-type   = p-obj-type
     1707           and buf_aht-stk.obj-code   = p-obj-code
     1708           and buf_aht-stk.stk-type   = p-stk-type
     1709           and buf_aht-stk.fact-order = p-fact-order
     1710         no-error .
     1711       if not available buf_aht-stk then do:
     1712         create buf_aht-stk .
     1713         assign
     1714           buf_aht-stk.obj-type   = p-obj-type
     1715           buf_aht-stk.obj-code   = p-obj-code
     1716           buf_aht-stk.stk-type   = p-stk-type
     1717           buf_aht-stk.fact-order = p-fact-order
     1718           buf_aht-stk.fact-date  = p-fact-date
     1719           buf_aht-stk.shift-date = p-shift-date
     1720           buf_aht-stk.shift-num  = p-shift-num
     1721         .
     1722       end.
     1723     end.
     1724   end procedure.
     1725   def var vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1726   PROCEDURE aht-ostatok :
     1727   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     1728   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     1729   def input parameter x-tog-shift   as   logical             no-undo.
     1730   def input parameter x-date-start  like ub.aht-stk.Fact-date   no-undo.
     1731   def input parameter x-date-end    like ub.aht-stk.Fact-date   no-undo.
     1732   def input parameter x-shift-start as integer               no-undo.
     1733   def input parameter x-shift-end   as integer               no-undo.
     1734   def input parameter x-sum-type    like ub.aht-stk.stk-type    no-undo.
     1735   def input parameter xTog-obj   as log no-undo.
     1736   def output parameter Fact-order  like ub.aht-stk.Fact-order  no-undo.
     1737   def var              Fact-order#   like ub.aht-stk.Fact-order  no-undo.
     1738   def var              Fact-orderS   as char  no-undo.
     1739   def var x-date-start-t  like ub.aht-stk.shift-date   no-undo.
     1740       Assign
     1741         Fact-order   = 0
     1742        .
     1743    x-date-start-t  = x-date-start + 1 .
     1744   IF x-date-end = date('') then DO:
     1745      Fact-order = 0 .
     1746      For each obj-list
     1747          WHERE  (NOT xTog-obj OR
     1748                 (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     1749                 no-lock :
     1750         IF  x-TOG-Shift = False Then DO:
     1751                          find last ub.aht-stk where ub.aht-stk.obj-type = obj-list.obj-type and                                             ub.aht-stk.obj-code = obj-list.obj-code and                                             ub.aht-stk.stk-type = x-sum-type
     1752                               and ub.aht-stk.Fact-date <=  x-date-start
     1753                               and ub.aht-stk.shift-num = 0
     1754                               USE-INDEX obj-date no-lock no-error .
     1755              if Available ub.aht-stk THEN  Assign  Fact-order#  = ub.aht-stk.Fact-order .
     1756         End.
     1757         Else  DO :
     1758             find last ub.aht-stk where ub.aht-stk.obj-type = obj-list.obj-type and                                             ub.aht-stk.obj-code = obj-list.obj-code and                                             ub.aht-stk.stk-type = x-sum-type and
     1759               (ub.aht-stk.shift-date  = x-date-start-t and
     1760               ub.aht-stk.shift-num  < x-shift-start or
     1761               ub.aht-stk.shift-date  < x-date-start-t  )
     1762               and ub.aht-stk.shift-num  > 0
     1763               USE-INDEX obj-Shift no-lock no-error .
     1764            If Available ub.aht-stk then  Assign  Fact-order#  = ub.aht-stk.Fact-order .
     1765           END.
     1766       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     1767     End.
     1768   End.
     1769   Else DO:
     1770     For each obj-list  WHERE
     1771        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     1772         no-lock :
     1773      IF  x-TOG-Shift = False Then DO:
     1774          find last ub.aht-stk where ub.aht-stk.obj-type = obj-list.obj-type and                                             ub.aht-stk.obj-code = obj-list.obj-code and                                             ub.aht-stk.stk-type = x-sum-type and
     1775               ub.aht-stk.Fact-date <= x-date-end
     1776               and ub.aht-stk.shift-num = 0
     1777               USE-INDEX obj-date no-lock no-error.
     1778          If Available ub.aht-stk then  Assign  Fact-order#  = ub.aht-stk.Fact-order .
     1779      END.
     1780      Else DO:
     1781           find last ub.aht-stk where ub.aht-stk.obj-type = obj-list.obj-type and                                             ub.aht-stk.obj-code = obj-list.obj-code and                                             ub.aht-stk.stk-type = x-sum-type and
     1782               (ub.aht-stk.shift-date  = x-date-end and
     1783               ub.aht-stk.shift-num  <= x-shift-end or
     1784               ub.aht-stk.shift-date  < x-date-end       ) and
     1785               ub.aht-stk.shift-num   > 0      use-index obj-Shift no-lock no-error.
     1786               if Available ub.aht-stk THEN Assign  Fact-order#  = ub.aht-stk.Fact-order .
     1787       End.
     1788       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     1789     End.
     1790   End.
     1791   END PROCEDURE.
     1792   define variable v-account as integer init 0 no-undo .
     1793   define variable v-account-lavel as character no-undo .
     1794   define variable v-button-stop as logical no-undo .
     1795   define variable v-kol-spice as integer no-undo .
     1796   define variable v-kol-spice2 as integer no-undo .
     1797   define variable v-kol-spice3 as integer no-undo .
     1798   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1799   DEFINE BUTTON StopBtn AUTO-END-KEY
     1800        LABEL "Стоп"
     1801        SIZE 10 BY 1.
     1802   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1803        LABEL "Обработано записей"
     1804         VIEW-AS TEXT
     1805        SIZE 14 BY .67 NO-UNDO.
     1806   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1807         VIEW-AS TEXT
     1808        SIZE 53.25 BY .67
     1809        FGCOLOR 1  NO-UNDO.
     1810   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1811         VIEW-AS TEXT
     1812        SIZE 53.25 BY .67
     1813        FGCOLOR 1  NO-UNDO.
     1814   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1815         VIEW-AS TEXT
     1816        SIZE 53.25 BY .67
     1817        FGCOLOR 1  NO-UNDO.
     1818   DEFINE RECTANGLE RECT-1
     1819        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1820        SIZE 55.13 BY 4.46.
     1821   DEFINE FRAME InfoFrame
     1822        StopBtn AT ROW 4.25 COL 21.75
     1823        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1824        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1825        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1826        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1827        RECT-1 AT ROW 1 COL 1
     1828       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1829            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1830            TITLE "Процесс"
     1831            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1832   define variable mFrameView      as logical   no-undo init yes.
     1833     define variable mFramHandle as handle no-undo.
     1834     mFramHandle = frame InfoFrame:handle.
     1835     if  log-manager:logfile-name ne ?
     1836     then DO:
     1837         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1838         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1839         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1840     end.
     1841     mFrameView = not session:batch-mode and mFramHandle:visible.
     1842     if mFrameView
     1843     then do:
     1844       ASSIGN
     1845          FRAME InfoFrame:HIDDEN                           = TRUE
     1846          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1847     end.
     1848   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1849   DO:
     1850     IF not StopProcessing THEN
     1851       Message "Вы действительно хотите прервать" SKIP
     1852               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1853                 UPDATE StopProcessing.
     1854     IF StopProcessing THEN do:
     1855        if mFrameView
     1856        then do:
     1857           HIDE FRAME InfoFrame.
     1858        end.
     1859     End.
     1860   END.
     1861   assign v-account = ( if integer( 50 ) = 0 then 100 else integer( 50 ) ).
     1862     if  log-manager:logfile-name ne ?
     1863     then DO:
     1864         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1865     end.
     1866     if not session:batch-mode then
     1867     do:
     1868       VIEW FRAME InfoFrame.
     1869       mFrameView = true.
     1870     end.
     1871      v-button-stop = false .
     1872         if mFrameView
     1873         then do:
     1874         if v-button-stop then view STOPBTN in frame InfoFrame.
     1875                          else Hide STOPBTN in frame InfoFrame.
     1876         end.
     1877   define temp-table temp-font no-undo
     1878     field fontnum  as integer
     1879     field fontname as character
     1880     field fontsize as character
     1881     field fonttype as character
     1882     field font-h   as integer
     1883     field font-w   as integer
     1884     field v-row    as integer
     1885     field v-col    as integer
     1886     field v-row-lans as integer
     1887     field v-col-lans as integer
     1888   index pi fontnum
     1889   .
     1890   procedure get-font-ini :
     1891     do
     1892     on error undo, return error return-value
     1893     :
     1894   define variable ii as integer   no-undo .
     1895   define variable v-font7 as character no-undo .
     1896   define variable v-font as character no-undo .
     1897   define variable loc-name as character no-undo .
     1898   define variable loc-size as character no-undo .
     1899   define variable loc-type as character no-undo .
     1900   define variable old_H as integer   no-undo .
     1901   define variable old_w as integer   no-undo .
     1902   define variable old-row  as integer   no-undo .
     1903   define variable old-col  as integer   no-undo .
     1904   define variable old-row-lans  as integer   no-undo .
     1905   define variable old-col-lans  as integer   no-undo .
     1906   define variable vv as integer   no-undo .
     1907   empty temp-table temp-font.
     1908     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     1909       case num-entries (v-font7) :
     1910         when 4 then do:
     1911             assign
     1912               loc-name = entry ( 1 , v-font7 )
     1913               loc-size = entry ( 2 , v-font7 )
     1914               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     1915             .
     1916         end.
     1917         when 3 then do:
     1918             assign
     1919               loc-name = entry ( 1 , v-font7 )
     1920               loc-size = entry ( 2 , v-font7 )
     1921               loc-type = entry ( 3 , v-font7 )
     1922             .
     1923         end.
     1924         when 2 then  do:
     1925             assign
     1926               loc-name = entry ( 1 , v-font7 )
     1927               loc-size = entry ( 2 , v-font7 )
     1928               loc-type = ""
     1929             .
     1930         end.
     1931         when 1 then do:
     1932             assign
     1933               loc-name = trim(entry ( 1 , v-font7 ))
     1934               loc-size = ""
     1935               loc-type = ""
     1936             .
     1937         end.
     1938       end case.
     1939     create temp-font.
     1940     assign
     1941       temp-font.fontnum  = 7
     1942       temp-font.fontname = trim(loc-name)
     1943       temp-font.fontsize = trim(loc-size)
     1944       temp-font.fonttype = trim(loc-type)
     1945       temp-font.v-row    = 62
     1946       temp-font.v-col    = 136
     1947       temp-font.v-row-lans = 43
     1948       temp-font.v-col-lans = 198
     1949     .
     1950     repeat ii = 16 to 100 :
     1951       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     1952       if v-font = "" or v-font = ? then leave.
     1953       case num-entries (v-font) :
     1954         when 4 then do:
     1955             assign
     1956               loc-name = entry ( 1 , v-font )
     1957               loc-size = entry ( 2 , v-font )
     1958               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     1959             .
     1960         end.
     1961         when 3 then do:
     1962             assign
     1963               loc-name = entry ( 1 , v-font )
     1964               loc-size = entry ( 2 , v-font )
     1965               loc-type = entry ( 3 , v-font )
     1966             .
     1967         end.
     1968         when 2 then do:
     1969             assign
     1970               loc-name = entry ( 1 , v-font )
     1971               loc-size = entry ( 2 , v-font )
     1972               loc-type = ""
     1973             .
     1974         end.
     1975         when 1 then do:
     1976             assign
     1977               loc-name = trim(entry ( 1 , v-font ))
     1978               loc-size = ""
     1979               loc-type = ""
     1980             .
     1981         end.
     1982       end case.
     1983     create temp-font.
     1984     assign
     1985       temp-font.fontnum  = ii
     1986       temp-font.fontname = trim(loc-name)
     1987       temp-font.fontsize = trim(loc-size)
     1988       temp-font.fonttype = trim(loc-type)
     1989     .
     1990     end.
     1991       for each temp-font :
     1992          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     1993          if  vv = ? then vv =  0 .
     1994           run rep/exfont.p (
     1995             input   temp-font.fontname ,
     1996             input   vv ,
     1997             input   temp-font.fonttype ,
     1998             output  temp-font.font-h   ,
     1999             output  temp-font.font-w   )
     2000           .
     2001       end.
     2002   find first temp-font where  temp-font.fontnum  = 7  .
     2003   old_H = temp-font.font-H .
     2004   old_w = temp-font.font-W .
     2005   old-row = temp-font.v-row .
     2006   old-col = temp-font.v-col .
     2007   old-row-lans = temp-font.v-row-lans .
     2008   old-col-lans = temp-font.v-col-lans .
     2009       for each temp-font where
     2010                temp-font.fontnum  <> 7 :
     2011           assign
     2012               temp-font.v-row    = old_H * old-row / temp-font.font-h
     2013               temp-font.v-col    = old_W * old-col / temp-font.font-W
     2014               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     2015               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     2016           .
     2017       end.
     2018     end.
     2019   end procedure.
     2020   PROCEDURE How-name :
     2021   define input  parameter h as integer no-undo .
     2022   define input  parameter w as integer no-undo .
     2023   define output parameter n as character  no-undo .
     2024   define variable A4port-H as integer   no-undo init 63.
     2025   define variable A4port-W as integer   no-undo init 136.
     2026   define variable A4lans-H as integer   no-undo init 43.
     2027   define variable A4lans-W as integer   no-undo init 198.
     2028   define variable Strim-W  as integer   no-undo init 278.
     2029   run define-a4-size (
     2030        input ReportFontNum
     2031       ,output A4port-H
     2032       ,output A4port-W
     2033       ,output A4lans-H
     2034       ,output A4lans-W ).
     2035   If w >= 1 and w <= A4port-W Then DO:
     2036     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     2037     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     2038     If h > A4port-H              Then n = "to-file":U.
     2039   End.
     2040   If w > A4port-W and w <= A4lans-W Then DO:
     2041     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     2042     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     2043     If h > A4port-H              Then n = "to-file":U.
     2044   End.
     2045   If w > A4lans-W and w <= Strim-W Then DO:
     2046     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     2047     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     2048     If h > A4port-H              Then n = "to-file":U.
     2049   End.
     2050   If w > Strim-W Then DO:
     2051      n = "to-file":U.
     2052   End.
     2053   END PROCEDURE.
     2054   PROCEDURE define-a4-size :
     2055   define input  parameter p-ReportFontNum as integer   no-undo .
     2056   define output parameter A4port-H as integer   no-undo .
     2057   define output parameter A4port-W as integer   no-undo .
     2058   define output parameter A4lans-H as integer   no-undo .
     2059   define output parameter A4lans-W as integer   no-undo .
     2060   if not can-find (first temp-font ) then do:
     2061      run get-font-ini .
     2062   end.
     2063   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     2064   if available temp-font then do:
     2065   assign
     2066     A4port-H = temp-font.v-row
     2067     A4port-W = temp-font.v-col
     2068     A4lans-H = temp-font.v-row-lans
     2069     A4lans-W = temp-font.v-col-lans
     2070   .
     2071   end.
     2072   else do:
     2073   assign
     2074     A4port-H = 63
     2075     A4port-W = 136
     2076     A4lans-H = 43
     2077     A4lans-W = 198
     2078   .
     2079   end.
     2080   END PROCEDURE.
