     3583         b1-RAsh          [p2] format "->>>>>>>>>>9.<<<" @  F-RAsh
     3584         b1-KAssa         [p2] format "->>>>>>>>>>9.<<<" @  F-KAssa
     3585         b1-Inv           [p2] format "->>>>>>>>>>9.<<<" @  F-Inv
