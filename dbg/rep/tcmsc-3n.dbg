     3572   define input parameter p7 as character no-undo.
     3573    case caps(p7) :
     3574      when "b1":u  then do :
     3575       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3576         p3 @ s-bar-code
     3577         p4 @ gds-zap-artic
     3578         p5 @ gds-zap-gds-name
