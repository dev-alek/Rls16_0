     3020   procedure display-b1  :
     3021         if not( not show-negativ-2 and
     3022            ( b1-prih         [1]   = 0 and
     3023              b1-rash          [1]   = 0 and
     3024              b1-kassa         [1]   = 0 and
     3025              b1-inv           [1]   = 0 and
     3026              b1-overturn      [1]   = 0 and
     3027              b1-overturn      [5]   = 0 and
     3028              b1-overturn      [8]   = 0 ) ) then do:
     3029           if  not (not show-negativ  and (
     3030                 b1-prih          [1]   = 0 and
     3031                 b1-rash          [1]   = 0 and
     3032                 b1-kassa         [1]   = 0 and
     3033                 b1-inv           [1]   = 0 and
     3034                 b1-overturn      [1]   = 0 and
     3035                 b1-overturn      [5]   = 0 and
     3036                 b1-ostatok-start [1]   = 0 and
     3037                 b1-ostatok-end   [1]   = 0   )) then do:
     3038                 if sums-only then do:
     3039                     if fr0 = true then do:
     3040                         put stream  outstream  tmp#stroka0 format "x(100)" skip.
     3041                         if Make-Excel then  put   stream ForExcel unformatted string(tmp#stroka0) skip.
     3042                         fr0 = false .
     3043                       end.
     3044                  end.
     3045           run di-qnty in this-procedure ("кол-во"  ,1, s-bar-code, gds-zap-artic, gds-zap-gds-name ,"","b1":u).
     3046           if xshowcost    then do: run di in this-procedure ("учет." ,2 ,"","", "", "", "b1":u).  end.
     3047           if xshowcrsa    then do: run di in this-procedure ("прод." , 5, "","", "", "", "b1":u).  end.
     3048           if xshowsale    then do: run di in this-procedure ("комисс." , 8, "","", "", "", "b1":u).  end.
     3049           if vat-cost    then do: run di in this-procedure ( "уч.НДС", 3,"","","","","b1":u ). end.
     3050           if vat-crsa    then do: run di in this-procedure ( "пр.НДС", 6,"","","","","b1":u ).  end.
     3051           if vat-sale    then do: run di in this-procedure ( "км.НДС", 9,"","","","","b1":u ).  end.
     3052          if not sums-only then run p-line.
     3053    end.
     3054    end.
     3055   end procedure.
     3056   procedure display-b2  :
     3057        if not( not show-negativ-2 and
     3058            ( b2-prih         [1]   = 0 and
