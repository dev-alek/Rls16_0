     2972   procedure calcitog :
     2973       run aht-ostatok (
     2974           input x-store-code     ,
     2975           input x-store-type     ,
     2976           input x-tog-shift      ,
     2977           input x-date-start - 1 ,
     2978           input date('')         ,
     2979           input x-shift-start    ,
     2980           input x-shift-end      ,
     2981           input "n"    ,
     2982           input xtog-obj         ,
     2983           output  fact-order-1 ) .
     2984       run aht-ostatok (
     2985           input x-store-code  ,
     2986           input x-store-type  , x-tog-shift,
     2987           input x-date-start  ,
     2988           input x-date-end    , x-shift-start,x-shift-end,
     2989           input "n" ,
     2990           input xtog-obj ,
     2991           output  fact-order-2 ).
     2992   end procedure.
