     3005   procedure display-bi  :
     3006   define variable ll as int no-undo.
     3007   define variable kk as int no-undo.
     3008     num#col#  = 0 .
     3009     if use-column[28] then assign num#col#  = num#col#  + 1 .
     3010     if use-column[1] then  assign num#col#  = num#col#  + 1 .
     3011     if use-column[2] then  assign num#col#  = num#col#  + 1 .
     3012     if use-column[3] then  assign num#col#  = num#col#  + 1 .
     3013     if use-column[4] then  assign num#col#  = num#col#  + 1 .
     3014     if use-column[5] then  assign num#col#  = num#col#  + 1 .
     3015     run macr_cell_format
     3016                                 ( 10    ,
     3017                                   true  ,
     3018                                   false ,
     3019                                   ?    ,
     3020                                   num#str# ,
     3021                                   1 ,
     3022                                   num#str# ,
     3023                                   (mp + ll + (kk * (27 - 8)))
     3024                                   ) .
     3025   if use-column[21] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bi-oborot-disc [1],2 ), num#str# , num#col#   ).     end.
     3026   if use-column[23] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bi-oborot-eff  [1],2 ), num#str# , num#col#   ).     end.
     3027   if use-column[24] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bi-oborot-prc  [1],2 ), num#str# , num#col#   ).     end.
     3028   def var l-nk as integer no-undo .
     3029     Assign
     3030       LL = 0
     3031       KK = 1
     3032     .
     3033     if xShowCost      Then DO: KK = KK + 1. End.
     3034     if xShowCostNDS   Then DO: KK = KK + 1. End.
     3035     if xShowCrsa      Then DO: KK = KK + 1. End.
     3036     if xShowCrsaNds   Then DO: KK = KK + 1. End.
     3037     if xShowSale      Then DO: KK = KK + 1. End.
     3038     if xShowSaleNds   Then DO: KK = KK + 1. End.
     3039     if xShowSaleslt   Then DO: KK = KK + 1. End.
     3040     if xShowmediator  Then DO: KK = KK + 1. End.
     3041     if x-tog-wt       then do: KK = KK + 1. End.
     3042     if x-tog-ms       then do: KK = KK + 1. End.
     3043     if xDens          then do: KK = KK + 1. End.
     3044     repeat i = 1 to 13 :
     3045       if i = 7 then next.
     3046       if NOT xShowCost      and i = 2   Then  next.
     3047       if NOT xShowCostNDS   and i = 3   Then  next.
     3048       if NOT xShowCrsa      and i = 5   Then  next.
     3049       if NOT xShowCrsaNds   and i = 6   Then  next.
     3050       if NOT xShowSale      and i = 8   Then  next.
     3051       if NOT xShowSaleNds   and i = 9   Then  next.
     3052       if NOT xShowSaleSlt   and i = 10  Then  next.
     3053       if NOT xShowmediator  and i = 4   Then  next.
     3054       if not x-tog-wt       and i = 11  then  next.
     3055       if not x-tog-ms       and i = 12  then  next.
     3056       if not xDens          and i = 13  then  next.
     3057       assign
     3058         LL = LL + 1
     3059         l-nk = mp-1
     3060       .
     3061     if x-vat or i <> 2  then do:
     3062     if use-column[6]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-ostatok-start                          [i] ,  i). end.
     3063     if use-column[7]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-oborot-ie          [i] ,  i). end.
     3064     if use-column[8]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-oborot-iv          [i] ,  i). end.
