     4549   procedure item-goods :
     4550    define input parameter  par-3 as char no-undo.
     4551    define input parameter  par-4 as char no-undo.
     4552        if par-4 = "goods":u  then  assign
     4553                                       gds-zap-unit-base  = goods.unit-base
     4554                                       gds-zap-prt-root   = goods.prt-root
     4555                                       gds-zap-prod-type  = goods.prod-type
     4556                                       gds-zap-prod-code  = goods.prod-code
     4557                                       gds-zap-artic      = goods.artic
     4558                                       gds-zap-type       = goods.gds-type
     4559                                       gds-zap-grp-name   = goods.grp-name
     4560                                       gds-zap-b-code     = goods.gds-code
     4561                                       gds-zap-gds-name   = if g#gds-engl then goods.engl-name
     4562                                                                          else goods.gds-name
     4563                                       gds-zap-gds-long-name = substring ((if goods.engl-name <> ? then trim(goods.engl-name) else "" ) +
     4564                                                               ( if goods.label-name <> ? then trim(goods.label-name) else "" ),1,120).
     4565        if par-4 = "gds-list":u  then  assign
     4566                                       gds-zap-unit-base  = gds-list.unit-base
     4567                                       gds-zap-prt-root   = gds-list.prt-root
     4568                                       gds-zap-prod-type  = gds-list.prod-type
     4569                                       gds-zap-prod-code  = gds-list.prod-code
     4570                                       gds-zap-artic      = gds-list.artic
     4571                                       gds-zap-type       = gds-list.gds-type
     4572                                       gds-zap-grp-name   = gds-list.grp-name
     4573                                       gds-zap-b-code     = gds-list.gds-code
     4574                                       gds-zap-gds-name   = if g#gds-engl then gds-list.engl-name
     4575                                                                          else gds-list.gds-name
     4576                                       gds-zap-gds-long-name = substring ((if gds-list.engl-name <> ? then trim(gds-list.engl-name) else "" ) +
     4577                                                               ( if gds-list.label-name <> ? then trim(gds-list.label-name) else ""), 1,120).
     4578       run foreach in this-procedure .
     4579   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     4580     (input  gds-zap-b-code
     4581     ,input  ?
     4582     ,output v-bar-code
     4583     )  .
     4584   s-bar-code = string (v-bar-code,"999999999").
     4585       If  break_group = true  and par-3 <> "1"  then DO :
     4586            FIND FIRST clients WHERE clients.obj-type = gds-zap-prod-type AND clients.obj-code = gds-zap-prod-code use-index pi NO-LOCK .
     4587            gds-zap-prod-name  = clients.obj-name.
     4588             If break_group1 = true  THEN  DO :
     4589               if (par-3 = "3"  OR  par-3 = "5" ) and  par-3 <> "6"
     4590                 then DO: Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )         b1-name = gds-zap-grp-name . end.
     4591                 else DO: Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) b1-name = gds-zap-prod-name. end.
     4592               if par-3 = "6"  then  dO:
     4593                  if xTog-obj = true then do:
     4594                   var-vat-pc = (func-vat(gds-obj.gds-code,gds-obj.obj-type,gds-obj.obj-code)) .
     4595                   end.
     4596                  else do:
     4597                   var-vat-pc = temp-gds-list.vat-pc  .
     4598                   end.
     4599                   assign
     4600                       temp-str = string( "СТАВКА НДС : " + string(var-vat-pc) + "%" )
     4601                       b1-name = temp-str .
     4602                   end.
     4603               if NOT xSumsOnly or (par-3 = "4" Or par-3 = "5" ) THEN DO :
     4604                   fr0 = true .
     4605                   tmp#stroka0 = temp-str.
     4606               End .
     4607             End .
     4608             IF (par-3 = "4"  OR  par-3 = "5")  THEN DO :
     4609               if par-3 = "4"
     4610                 then Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )          b2-name = gds-zap-grp-name  .
     4611                 else Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name )  b2-name = gds-zap-prod-name .
     4612               if NOT xSumsOnly THEN DO :
     4613               fr = true .
     4614               End.
     4615               break_group1 = false.
     4616             END.
     4617          break_group = false.
     4618       End.
     4619       run display-line in this-procedure .
     4620    end procedure.
