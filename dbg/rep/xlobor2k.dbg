     2464   procedure display-line :
     2465     i = i + 1.
     2466      if not  (not show-negativ and null-str# = 0 ) then do:
     2467          if not  (not show-negativ-2 and null-str2# = 0  ) then do:
     2468           if not sums-only then do:
     2469               if fr0 = true then do:
     2470                 num#str# = num#str# + 1.
     2471                 num#col# = 1.
     2472                 run macr_excel_char_with_format( string(tmp#stroka0)  , num#str# , num#col#  ) .
     2473                 run macr_cell_format
     2474                 ( 10    ,
     2475                   true  ,
     2476                   true  ,
     2477                   33    ,
     2478                   num#str# ,
     2479                   num#col# ,
     2480                   num#str# ,
     2481                   5 ) .
     2482                 fr0 = false .
     2483               end.
     2484               if fr = true then do:
     2485                   num#str# = num#str# + 1.
     2486                   num#col# = 2.
     2487                   run macr_excel_char_with_format( string(caps(temp-str))  , num#str# , num#col#  ) .
     2488                   run macr_cell_format
     2489                     ( 10    ,
     2490                       true  ,
     2491                       true  ,
     2492                       36    ,
     2493                       num#str# ,
     2494                       num#col# ,
     2495                       num#str# ,
     2496                       5 ) .
     2497                 fr = false .
     2498               end.
     2499               run display-str1 in this-procedure .
     2500               run new-tmp-page .
     2501               end.
     2502           end.
     2503       end.
     2504   end procedure.
     2505   procedure print-header :
     2506   if not firstline then   do: end.
     2507       firstline = true .
     2508       if xtog-obj and   x-selectobject <> "currency":u   then  do:
     2509        num#str# = num#str# + 1.
     2510        num#col# = 1.
     2511        run macr_excel_char_with_format(
     2512        string(  "ПО ОБЪЕКТУ : " + ObjName)
     2513         , num#str# , num#col#  ) .
     2514        num#col# = num#col# + 3.
     2515        run macr_excel_char_with_format(
     2516        string(  x-store-type + " " + string(x-store-code)  )
     2517         , num#str# , num#col#  ) .
     2518        num#col# = num#col# + 1.
     2519        run macr_excel_char_with_format(
     2520        string( "УБД " + string(x-db-num)  )
     2521         , num#str# , num#col#  ) .
     2522       end.
     2523         run clear-b1 in this-procedure .
     2524         run clear-b2 in this-procedure .
     2525         run clear-bi in this-procedure .
     2526         break_group = true.
     2527         break_group1 = true.
     2528      end procedure.
     2529   procedure print-footer :
     2530        num#str# = num#str# + 1.
     2531        num#col# = 1.
     2532        run macr_excel_char_with_format( string("ИТОГО"  )  , num#str# , num#col#  ) .
     2533        run display-bi in this-procedure .
     2534   end procedure.
     2535   procedure run2 :
     2536       case select-good :
     2537           when 1  then do:
     2538       define buffer buf_obj-list18 for obj-list.
     2539     for each buf_obj-list18 no-lock :
     2540         if xtog-obj and  not (buf_obj-list18.obj-type = x-store-type  and
     2541                               buf_obj-list18.obj-code = x-store-code )
     2542         then next.
     2543           for  each gds-obj   where
     2544                               gds-obj.obj-type = buf_obj-list18.obj-type    and
     2545                               gds-obj.obj-code = buf_obj-list18.obj-code
     2546                               and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2547                               no-lock ,
     2548           first goods where gds-obj.gds-code  = goods.gds-code
     2549                               no-lock :
     2550               if not can-find(first temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) then do:
     2551                   create temp-gds-list.
     2552                   assign
     2553                     temp-gds-list.prod-code = gds-obj.prod-code
     2554                     temp-gds-list.grp-name  = ""
     2555                     temp-gds-list.gds-code  = gds-obj.gds-code
     2556                     temp-gds-list.artic     = gds-obj.artic
     2557                     temp-gds-list.gds-name  = goods.gds-name
     2558                     .
     2559                     temp-gds-list.grp-name  = n-lavel(input gds-obj.grp-name, input xlavel )
     2560                     .
     2561               end.
     2562           end.
     2563    end.
     2564     for each temp-gds-list no-lock
     2565       , first goods  where goods.gds-code  = temp-gds-list.gds-code no-lock
     2566         break
     2567           by  temp-gds-list.grp-name
     2568           by temp-gds-list.artic :
     2569           str = n-lavel(input goods.grp-name, input xlavel ) no-error .
     2570   find clients where clients.obj-type = goods.prod-type and
     2571                      clients.obj-code = goods.prod-code no-lock .
     2572     assign
     2573         gds-zap-unit-base  = goods.unit-base
     2574         gds-zap-prt-root   = goods.prt-root
     2575         gds-zap-prod-type  = goods.prod-type
     2576         gds-zap-prod-code  = goods.prod-code
     2577         gds-zap-artic      = goods.artic
     2578         gds-zap-type       = goods.gds-type
     2579         gds-zap-grp-name   = goods.grp-name
     2580         gds-zap-b-code     = goods.gds-code
