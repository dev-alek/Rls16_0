     3719   procedure ob-line  :
     3720   define input  parameter x-store-code     like ub.clients.obj-code     no-undo.
     3721   define input  parameter x-store-type     like ub.clients.obj-type     no-undo.
     3722   define input  parameter x-artic          like ub.ot-line.artic        no-undo.
     3723   define input  parameter x-prod-code      like ub.ot-line.prod-code    no-undo.
     3724   define input  parameter x-prod-type      like ub.ot-line.prod-type    no-undo.
     3725   define input  parameter x-fact-order-1   like ub.ot-line.fact-order   no-undo.
     3726   define input  parameter x-fact-order-2   like ub.ot-line.fact-order   no-undo.
     3727   define input  parameter x-sum-type       like ub.ot-line.sum-type     no-undo.
     3728   define input  parameter x-cat-id         like ub.ot-line.cat-id       no-undo.
     3729   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type no-undo.
     3730   define input  parameter xtog-obj           as log no-undo.
     3731   define variable  quantity#    like ub.ot-line.fact-qnty   no-undo.
     3732   define variable  coast_r#     like ub.ot-line.sum-rubl    no-undo.
     3733   define variable  coast_v#     like ub.ot-line.sum-rubl    no-undo.
     3734   define variable  vat_r#       like ub.ot-line.sum-rubl    no-undo.
     3735   define variable  vat_v#       like ub.ot-line.sum-rubl    no-undo.
     3736   define variable  slt_r#       like ub.ot-line.sum-rubl    no-undo.
     3737   define variable  slt_v#       like ub.ot-line.sum-rubl    no-undo.
     3738   define variable  v-summa  as decimal extent 4 no-undo .
     3739   define variable  tt#          as int no-undo.
     3740   define variable v-ii as integer no-undo .
     3741   define variable slt  as decimal no-undo .
     3742   define variable disc  as decimal no-undo .
     3743   define variable xi as integer no-undo .
     3744   define variable v-tt as integer no-undo .
     3745    if (x-sum-type = 'cost':U  or x-sum-type = 'cssr':U) then assign tt# = 0 v-tt = 0.
     3746       else
     3747       if (x-sum-type = 'crsa':U  or x-sum-type = 'cgsr':U) then assign tt# = 3  v-tt = 100.
     3748       else
     3749       assign tt# = 6  v-tt = 200.
     3750     if long-p = false then do :
     3751     for each obj-list no-lock:
     3752      if  xtog-obj then
     3753          if   not(x-store-type     = obj-list.obj-type
     3754               and x-store-code    = obj-list.obj-code ) then next.
     3755           for each ub.ot-line where
     3756                     ub.ot-line.artic         = x-artic
     3757               and   ub.ot-line.prod-code    = x-prod-code
     3758               and   ub.ot-line.prod-type    = x-prod-type
     3759               and   ub.ot-line.fact-order   <= x-fact-order-2
     3760               and   ub.ot-line.fact-order   >= x-fact-order-1
     3761               and   ub.ot-line.obj-code     = obj-list.obj-code
     3762               and   ub.ot-line.obj-type     = obj-list.obj-type
     3763               and   ub.ot-line.sum-type     = x-sum-type
     3764               no-lock :
     3765               case ub.ot-line.ext-doc-type:
     3766     WHEN 'ie':U THEN DO:
     3767       ASSIGN oborot-ie[1 + tt#]   = oborot-ie[1 + tt#]   +  ub.ot-line.fact-qnty
     3768             oborot-ie[2 + tt#]   = oborot-ie[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3769             oborot-ie[3 + tt#]   = oborot-ie[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3770         if tt# = 6 Then   assign
     3771             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3772             oborot-ie[10]   = oborot-ie[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3773             End.
     3774     WHEN 'ee':U THEN DO:
     3775       ASSIGN oborot-ee[1 + tt#]   = oborot-ee[1 + tt#]   +  ub.ot-line.fact-qnty
     3776             oborot-ee[2 + tt#]   = oborot-ee[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3777             oborot-ee[3 + tt#]   = oborot-ee[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3778         if tt# = 6 Then   assign
     3779             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3780             oborot-ee[10]   = oborot-ee[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3781             End.
     3782     WHEN 'ep':U THEN DO:
     3783       ASSIGN oborot-ep[1 + tt#]   = oborot-ep[1 + tt#]   +  ub.ot-line.fact-qnty
     3784             oborot-ep[2 + tt#]   = oborot-ep[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3785             oborot-ep[3 + tt#]   = oborot-ep[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3786         if tt# = 6 Then   assign
     3787             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3788             oborot-ep[10]   = oborot-ep[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3789             End.
     3790     WHEN 'es':U THEN DO:
     3791       ASSIGN oborot-es[1 + tt#]   = oborot-es[1 + tt#]   +  ub.ot-line.fact-qnty
     3792             oborot-es[2 + tt#]   = oborot-es[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3793             oborot-es[3 + tt#]   = oborot-es[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3794         if tt# = 6 Then   assign
     3795             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3796             oborot-es[10]   = oborot-es[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3797             End.
     3798     WHEN 're':U THEN DO:
     3799       ASSIGN oborot-re[1 + tt#]   = oborot-re[1 + tt#]   +  ub.ot-line.fact-qnty
     3800             oborot-re[2 + tt#]   = oborot-re[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3801             oborot-re[3 + tt#]   = oborot-re[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3802         if tt# = 6 Then   assign
     3803             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3804             oborot-re[10]   = oborot-re[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3805             End.
     3806     WHEN 'rs':U THEN DO:
     3807       ASSIGN oborot-rs[1 + tt#]   = oborot-rs[1 + tt#]   +  ub.ot-line.fact-qnty
     3808             oborot-rs[2 + tt#]   = oborot-rs[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3809             oborot-rs[3 + tt#]   = oborot-rs[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3810         if tt# = 6 Then   assign
     3811             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3812             oborot-rs[10]   = oborot-rs[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3813             End.
     3814     WHEN 'we':U THEN DO:
     3815       ASSIGN oborot-we[1 + tt#]   = oborot-we[1 + tt#]   +  ub.ot-line.fact-qnty
     3816             oborot-we[2 + tt#]   = oborot-we[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3817             oborot-we[3 + tt#]   = oborot-we[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3818         if tt# = 6 Then   assign
     3819             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3820             oborot-we[10]   = oborot-we[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3821             End.
     3822     WHEN 'vt':U  OR  WHEN 'mp':U OR WHEN 'vp':U THEN DO:
     3823       ASSIGN oborot-vt[1 + tt#]   = oborot-vt[1 + tt#]   +  ub.ot-line.fact-qnty
     3824             oborot-vt[2 + tt#]   = oborot-vt[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3825             oborot-vt[3 + tt#]   = oborot-vt[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3826           if tt# = 6 Then  assign
     3827             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3828             oborot-vt[10]   = oborot-vt[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3829             End.
     3830     WHEN 'iv':U THEN DO:
     3831       ASSIGN oborot-iv[1 + tt#]   = oborot-iv[1 + tt#]   +  ub.ot-line.fact-qnty
     3832             oborot-iv[2 + tt#]   = oborot-iv[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3833             oborot-iv[3 + tt#]   = oborot-iv[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3834         if tt# = 6 Then   assign
     3835             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3836             oborot-iv[10]   = oborot-iv[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3837             End.
     3838     WHEN 'ev':U THEN DO:
     3839       ASSIGN oborot-ev[1 + tt#]   = oborot-ev[1 + tt#]   +  ub.ot-line.fact-qnty
     3840             oborot-ev[2 + tt#]   = oborot-ev[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3841             oborot-ev[3 + tt#]   = oborot-ev[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3842         if tt# = 6 Then   assign
     3843             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3844             oborot-ev[10]   = oborot-ev[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3845             End.
     3846     WHEN 'rv':U THEN DO:
     3847       ASSIGN oborot-rv[1 + tt#]   = oborot-rv[1 + tt#]   +  ub.ot-line.fact-qnty
     3848             oborot-rv[2 + tt#]   = oborot-rv[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3849             oborot-rv[3 + tt#]   = oborot-rv[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3850         if tt# = 6 Then   assign
     3851             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3852             oborot-rv[10]   = oborot-rv[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3853             End.
     3854     WHEN 'wm':U  OR  WHEN 'em':U THEN DO:
     3855       ASSIGN oborot-em[1 + tt#]   = oborot-em[1 + tt#]   +  ub.ot-line.fact-qnty
     3856             oborot-em[2 + tt#]   = oborot-em[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3857             oborot-em[3 + tt#]   = oborot-em[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3858           if tt# = 6 Then  assign
     3859             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3860             oborot-em[10]   = oborot-em[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3861             End.
     3862     WHEN 'im':U THEN DO:
     3863       ASSIGN oborot-im[1 + tt#]   = oborot-im[1 + tt#]   +  ub.ot-line.fact-qnty
     3864             oborot-im[2 + tt#]   = oborot-im[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3865             oborot-im[3 + tt#]   = oborot-im[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3866         if tt# = 6 Then   assign
     3867             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3868             oborot-im[10]   = oborot-im[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3869             End.
     3870     WHEN 'ot':U THEN DO:
     3871       ASSIGN oborot-ot[1 + tt#]   = oborot-ot[1 + tt#]   +  ub.ot-line.fact-qnty
     3872             oborot-ot[2 + tt#]   = oborot-ot[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3873             oborot-ot[3 + tt#]   = oborot-ot[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3874         if tt# = 6 Then   assign
     3875             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3876             oborot-ot[10]   = oborot-ot[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3877             End.
     3878     WHEN 'ap':U THEN DO:
     3879       ASSIGN oborot-ap[1 + tt#]   = oborot-ap[1 + tt#]   +  ub.ot-line.fact-qnty
     3880             oborot-ap[2 + tt#]   = oborot-ap[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3881             oborot-ap[3 + tt#]   = oborot-ap[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3882         if tt# = 6 Then   assign
     3883             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3884             oborot-ap[10]   = oborot-ap[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3885             End.
     3886     WHEN 'pc':U THEN DO:
     3887       ASSIGN oborot-pc[1 + tt#]   = oborot-pc[1 + tt#]   +  ub.ot-line.fact-qnty
     3888             oborot-pc[2 + tt#]   = oborot-pc[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3889             oborot-pc[3 + tt#]   = oborot-pc[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3890         if tt# = 6 Then   assign
     3891             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3892             oborot-pc[10]   = oborot-pc[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3893             End.
     3894               end case.
     3895           end.
     3896      end.
     3897   end.
     3898   else do:
     3899   xi = 1 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-ie [1 + tt#] ,output  oborot-ie [2 + tt#] ,output  oborot-ie [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-ie[10]    = oborot-ie[10]    + slt  .
     3900   xi = 2 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-ee [1 + tt#] ,output  oborot-ee [2 + tt#] ,output  oborot-ee [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-ee[10]    = oborot-ee[10]    + slt  .
     3901   xi = 3 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-ep [1 + tt#] ,output  oborot-ep [2 + tt#] ,output  oborot-ep [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-ep[10]    = oborot-ep[10]    + slt  .
     3902   xi = 4 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-es [1 + tt#] ,output  oborot-es [2 + tt#] ,output  oborot-es [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-es[10]    = oborot-es[10]    + slt  .
     3903   xi = 5 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-re [1 + tt#] ,output  oborot-re [2 + tt#] ,output  oborot-re [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-re[10]    = oborot-re[10]    + slt  .
     3904   xi = 6 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-rs [1 + tt#] ,output  oborot-rs [2 + tt#] ,output  oborot-rs [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-rs[10]    = oborot-rs[10]    + slt  .
     3905   xi = 7 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-we [1 + tt#] ,output  oborot-we [2 + tt#] ,output  oborot-we [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-we[10]    = oborot-we[10]    + slt  .
     3906   xi = 8 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-vt [1 + tt#] ,output  oborot-vt [2 + tt#] ,output  oborot-vt [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-vt[10]    = oborot-vt[10]    + slt  .
     3907   xi = 9 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-iv [1 + tt#] ,output  oborot-iv [2 + tt#] ,output  oborot-iv [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-iv[10]    = oborot-iv[10]    + slt  .
     3908   xi = 10 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-ev [1 + tt#] ,output  oborot-ev [2 + tt#] ,output  oborot-ev [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-ev[10]    = oborot-ev[10]    + slt  .
     3909   xi = 11 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-rv [1 + tt#] ,output  oborot-rv [2 + tt#] ,output  oborot-rv [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-rv[10]    = oborot-rv[10]    + slt  .
     3910   xi = 12 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-em [1 + tt#] ,output  oborot-em [2 + tt#] ,output  oborot-em [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-em[10]    = oborot-em[10]    + slt  .
     3911   xi = 13 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-im [1 + tt#] ,output  oborot-im [2 + tt#] ,output  oborot-im [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-im[10]    = oborot-im[10]    + slt  .
     3912   xi = 14 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-ot [1 + tt#] ,output  oborot-ot [2 + tt#] ,output  oborot-ot [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-ot[10]    = oborot-ot[10]    + slt  .
     3913   xi = 15 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-ap [1 + tt#] ,output  oborot-ap [2 + tt#] ,output  oborot-ap [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-ap[10]    = oborot-ap[10]    + slt  .
     3914   xi = 16 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-pc [1 + tt#] ,output  oborot-pc [2 + tt#] ,output  oborot-pc [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-pc[10]    = oborot-pc[10]    + slt  .
     3915   end.
     3916     if tt# = 6 then do:
     3917     if  xshowmediator = false then
     3918         oborot-sum-cost[1] =
     3919         oborot-ee[2]      +
     3920         oborot-es[2] +
     3921         oborot-re[2]  +
     3922         oborot-rs[2]
     3923         .
     3924         else
     3925         oborot-sum-cost[1] =
     3926         oborot-ee[4]      +
     3927         oborot-es[4] +
     3928         oborot-re[4]  +
     3929         oborot-rs[4]
     3930         .
     3931        repeat v-ii = 1 to 1 :
     3932        v-summa[v-ii ]  =
     3933           oborot-ie[v-ii ] + oborot-ee[v-ii ] + oborot-ep[v-ii ] +
     3934           oborot-es[v-ii ] + oborot-re[v-ii ] + oborot-rs[v-ii ] +
     3935           oborot-we[v-ii ] + oborot-vt[v-ii ] + oborot-iv[v-ii ] +
     3936           oborot-ev[v-ii ] + oborot-rv[v-ii ] + oborot-em[v-ii ] +
     3937           oborot-im[v-ii ] .
     3938        end.
     3939        repeat v-ii = 2 to 4 :
     3940        v-summa[v-ii ]  =
     3941           oborot-ie[v-ii + tt#] + oborot-ee[v-ii + tt#] + oborot-ep[v-ii + tt#] +
     3942           oborot-es[v-ii + tt#] + oborot-re[v-ii + tt#] + oborot-rs[v-ii + tt#] +
     3943           oborot-we[v-ii + tt#] + oborot-vt[v-ii + tt#] + oborot-iv[v-ii + tt#] +
     3944           oborot-ev[v-ii + tt#] + oborot-rv[v-ii + tt#] + oborot-em[v-ii + tt#] +
     3945           oborot-im[v-ii + tt#] .
     3946        end.
     3947         oborot-sum-sale[1] =
     3948         oborot-ee[2 + tt#] +
     3949         oborot-es[2 + tt#] +
     3950         oborot-re[2 + tt#] +
     3951         oborot-rs[2 + tt#]
     3952         .
     3953          assign oborot-ot[1 + tt#] = (ostatok-end[1 + tt#]  - ostatok-start[1 + tt#])  -  (v-summa[1])
     3954           oborot-ot[2 + tt#] = (ostatok-end[2 + tt#]  - ostatok-start[2 + tt#])  -  (v-summa[2])
     3955                                                                                                     -  oborot-disc[1]
     3956           oborot-ot[3 + tt#] = (ostatok-end[3 + tt#]  - ostatok-start[3 + tt#])  -  (v-summa[3])
     3957           oborot-ot[10] = (ostatok-end[10]  - ostatok-start[10])                 -  (v-summa[4])
     3958           .
     3959           oborot-eff[1] = -1 * (oborot-sum-sale[1] - oborot-sum-cost[1]) .
     3960           if oborot-sum-cost[1] <>  0 then
     3961             oborot-prc[1] = 100 * (oborot-sum-sale[1] - oborot-sum-cost[1] ) / oborot-sum-cost[1].
     3962             else oborot-prc[1] = 0.
     3963     end.
     3964   oborot-ie[4]   = Round(oborot-ie[1]   *  p-price-med , 2) .
     3965   oborot-ee[4]   = Round(oborot-ee[1]   *  p-price-med , 2) .
     3966   oborot-ep[4]   = Round(oborot-ep[1]   *  p-price-med , 2) .
     3967   oborot-es[4]   = Round(oborot-es[1]   *  p-price-med , 2) .
     3968   oborot-re[4]   = Round(oborot-re[1]   *  p-price-med , 2) .
     3969   oborot-rs[4]   = Round(oborot-rs[1]   *  p-price-med , 2) .
     3970   oborot-we[4]   = Round(oborot-we[1]   *  p-price-med , 2) .
     3971   oborot-vt[4]   = Round(oborot-vt[1]   *  p-price-med , 2) .
     3972   oborot-iv[4]   = Round(oborot-iv[1]   *  p-price-med , 2) .
     3973   oborot-ev[4]   = Round(oborot-ev[1]   *  p-price-med , 2) .
     3974   oborot-rv[4]   = Round(oborot-rv[1]   *  p-price-med , 2) .
     3975   oborot-em[4]   = Round(oborot-em[1]   *  p-price-med , 2) .
     3976   oborot-im[4]   = Round(oborot-im[1]   *  p-price-med , 2) .
     3977   oborot-ot[4]   = Round(oborot-ot[1]   *  p-price-med , 2) .
     3978   oborot-ap[4]   = Round(oborot-ap[1]   *  p-price-med , 2) .
     3979   oborot-pc[4]   = Round(oborot-pc[1]   *  p-price-med , 2) .
     3980   end procedure.
     3981   procedure ost-line :
     3982     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     3983     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     3984     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     3985     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     3986     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     3987     define input  parameter x-tog-shift  as logical no-undo .
     3988     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     3989     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     3990     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     3991     define input  parameter xtog-obj     as logical no-undo .
     3992     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     3993     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     3994     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     3995     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     3996     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     3997     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     3998     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     3999     define buffer buff-obj-list  for obj-list .
     4000     define buffer buff-stk-line  for ub.stk-line .
     4001     assign
     4002       Quantity = 0
     4003       Coast_R  = 0
     4004       Coast_V  = 0
     4005       VAT_R    = 0
     4006       VAT_V    = 0
     4007       SLT_R    = 0
     4008       SLT_V    = 0
     4009     .
     4010     if  x-tog-shift = false then do:
     4011       for each buff-obj-list no-lock
     4012       on error undo, return error
     4013       :
     4014         find last buff-stk-line no-lock
     4015           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     4016             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     4017             and buff-stk-line.artic      = x-artic
     4018             and buff-stk-line.prod-type  = x-prod-type
     4019             and buff-stk-line.prod-code  = x-prod-code
     4020             and buff-stk-line.sum-type   = x-sum-type
     4021             and buff-stk-line.cat-id     = '##,##':U
     4022             and buff-stk-line.fact-order <= x-fact-order
     4023             and buff-stk-line.shift-num  = 0
     4024           use-index category
     4025           no-error .
     4026         if available buff-stk-line then do:
     4027           assign
     4028             Quantity = Quantity +  buff-stk-line.fact-qnty
     4029             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     4030             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     4031             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     4032             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     4033             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     4034             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     4035           .
     4036         end.
     4037       end.
     4038     end.
     4039     else do:
     4040       for each buff-obj-list no-lock
     4041         where xtog-obj = false
     4042            or (buff-obj-list.obj-type = x-store-type
     4043               and buff-obj-list.obj-code = x-store-code
     4044               )
     4045       on error undo, return error
     4046       :
     4047         find last buff-stk-line no-lock
     4048           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     4049             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     4050             and buff-stk-line.artic      = x-artic
     4051             and buff-stk-line.prod-type  = x-prod-type
     4052             and buff-stk-line.prod-code  = x-prod-code
     4053             and buff-stk-line.sum-type   = x-sum-type
     4054             and buff-stk-line.cat-id     = '##,##':U
     4055             and buff-stk-line.fact-order <= x-fact-order
     4056             and buff-stk-line.shift-num  > 0
     4057           use-index category
     4058           no-error .
     4059         if available buff-stk-line then do:
     4060           assign
     4061             Quantity = Quantity +  buff-stk-line.fact-qnty
     4062             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     4063             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     4064             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     4065             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     4066             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     4067             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     4068           .
     4069         end.
     4070       end.
     4071     end.
     4072   end procedure.
     4073   procedure ost-lineother-tax :
     4074     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     4075     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     4076     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     4077     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     4078     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     4079     define input  parameter x-tog-shift  as logical no-undo .
     4080     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     4081     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     4082     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     4083     define input  parameter xTog-obj     as logical no-undo .
     4084     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     4085     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     4086     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     4087     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     4088     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     4089     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     4090     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     4091     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     4092     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     4093     define buffer buff-obj-list  for obj-list .
     4094     define buffer buff-stk-line  for ub.stk-line .
     4095     assign
     4096       Quantity = 0
     4097       Coast_R  = 0
     4098       Coast_V  = 0
     4099       VAT_R    = 0
     4100       VAT_V    = 0
     4101       SLT_R    = 0
     4102       SLT_V    = 0
     4103       other_R  = 0
     4104       other_V  = 0
     4105     .
     4106     if  x-tog-shift = false then do:
     4107       for each buff-obj-list no-lock
     4108       on error undo, return error
     4109       :
     4110         find last buff-stk-line no-lock
     4111           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     4112             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     4113             and buff-stk-line.artic      = x-artic
     4114             and buff-stk-line.prod-type  = x-prod-type
     4115             and buff-stk-line.prod-code  = x-prod-code
     4116             and buff-stk-line.sum-type   = x-sum-type
     4117             and buff-stk-line.cat-id     = '##,##':U
     4118             and buff-stk-line.fact-order <= x-fact-order
     4119             and buff-stk-line.shift-num  = 0
     4120           use-index category
     4121           no-error .
     4122         if available buff-stk-line then do:
     4123           assign
     4124             Quantity = Quantity +  buff-stk-line.fact-qnty
     4125             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     4126             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     4127             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     4128             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     4129             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     4130             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     4131             other_R  = other_R  +  buff-stk-line.other-rubl
     4132             other_V  = other_V  +  buff-stk-line.other-base
     4133           .
     4134         end.
     4135       end.
     4136     end.
     4137     else do:
     4138       for each buff-obj-list no-lock
     4139         where xtog-obj = false
     4140            or (buff-obj-list.obj-type = x-store-type
     4141               and buff-obj-list.obj-code = x-store-code
     4142               )
     4143       on error undo, return error
     4144       :
     4145         find last buff-stk-line no-lock
     4146           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     4147             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     4148             and buff-stk-line.artic      = x-artic
     4149             and buff-stk-line.prod-type  = x-prod-type
     4150             and buff-stk-line.prod-code  = x-prod-code
     4151             and buff-stk-line.sum-type   = x-sum-type
     4152             and buff-stk-line.cat-id     = '##,##':U
     4153             and buff-stk-line.fact-order <= x-fact-order
     4154             and buff-stk-line.shift-num  > 0
     4155           use-index category
     4156           no-error .
     4157         if available buff-stk-line then do:
     4158           assign
     4159             Quantity = Quantity +  buff-stk-line.fact-qnty
     4160             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     4161             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     4162             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     4163             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     4164             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     4165             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     4166             other_R = other_R   +  buff-stk-line.other-rubl
     4167             other_V = other_V   +  buff-stk-line.other-base
     4168           .
     4169         end.
     4170       end.
     4171     end.
     4172   end procedure.
     4173   procedure ost-line-kg :
     4174     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     4175     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     4176     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     4177     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     4178     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     4179     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     4180     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     4181     define buffer buff-obj-list  for obj-list .
     4182     define buffer buf_doc-line for ub.doc-line .
     4183     define buffer buf_inv-line for ub.inv-line .
     4184     do
     4185     on error undo, return error
     4186     :
     4187       for each buf_doc-line no-lock where
     4188                buf_doc-line.obj-type    = p-obj-type   and
     4189                buf_doc-line.obj-code    = p-obj-code   and
     4190                buf_doc-line.prod-type   = p-prod-type  and
     4191                buf_doc-line.prod-code   = p-prod-code  and
     4192                buf_doc-line.artic       = p-artic      and
     4193                buf_doc-line.status_     = 'факт':U      and
     4194                buf_doc-line.fact-order <= p-fact-order
     4195             by buf_doc-line.fact-order    descending
     4196       :
     4197         find first buf_inv-line no-lock where
     4198                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     4199                    buf_inv-line.artic     = buf_doc-line.artic     and
     4200                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     4201                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     4202         if available buf_inv-line
     4203         then do:
     4204           if buf_inv-line.after-cli-qnty <> ?
     4205           then do:
     4206             assign
     4207               p-quantity-kg = buf_inv-line.after-cli-qnty
     4208             .
     4209             leave .
     4210           end.
     4211         end.
     4212       end.
     4213       if p-quantity-kg = ?
     4214       then do:
     4215         assign
     4216           p-quantity-kg = 0
     4217         .
     4218       end.
     4219     end.
     4220   end procedure.
     4221   PROCEDURE ostatok :
     4222   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     4223   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     4224   def input parameter x-tog-shift   as   logical             no-undo.
     4225   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     4226   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     4227   def input parameter x-shift-start as integer               no-undo.
     4228   def input parameter x-shift-end   as integer               no-undo.
     4229   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     4230   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     4231   def input parameter xTog-obj   as log no-undo.
     4232   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     4233   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     4234   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     4235   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     4236   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     4237   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     4238   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     4239   def var              Fact-orderS   as char  no-undo.
     4240   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     4241      Assign
     4242         Fact-order   = 0
     4243         Quantity     = 0
     4244         Coast_R      = 0
     4245         Coast_V      = 0
     4246         VAT_R        = 0
     4247         VAT_V        = 0 .
     4248    x-date-start-t  = x-date-start + 1 .
     4249   IF x-date-end = date('') then DO:
     4250      Fact-order = 0 .
     4251      for each obj-list
     4252          where  ( not xtog-obj or
     4253                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     4254                 no-lock :
     4255         if  x-tog-shift = false then do:
     4256                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     4257                               ub.stk-tot.Fact-date <=  x-date-start
     4258                               and ub.stk-tot.shift-num = 0
     4259                               USE-INDEX fact-date no-lock no-error .
     4260              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     4261         End.
     4262         Else  DO :
     4263             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     4264              (ub.stk-tot.shift-date  = x-date-start-t and
     4265               ub.stk-tot.shift-num  < x-shift-start or
     4266               ub.stk-tot.shift-date  < x-date-start-t  )
     4267               and ub.stk-tot.shift-num  > 0
     4268               USE-INDEX Shift-num no-lock no-error .
     4269            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     4270           END.
     4271       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     4272     End.
     4273   End.
     4274   Else DO:
     4275     For each obj-list  WHERE
     4276        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     4277         no-lock :
     4278      IF  x-TOG-Shift = False Then DO:
     4279          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     4280               ub.stk-tot.Fact-date <= x-date-end
     4281               and ub.stk-tot.shift-num = 0
     4282               USE-INDEX fact-date no-lock no-error.
     4283          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     4284      END.
     4285      Else DO:
     4286           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     4287               (ub.stk-tot.shift-date  = x-date-end and
     4288               ub.stk-tot.shift-num  <= x-shift-end or
     4289               ub.stk-tot.shift-date  < x-date-end       ) and
     4290               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     4291               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     4292       End.
     4293       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     4294     End.
     4295   End.
     4296   END PROCEDURE.
     4297   procedure report-exec1  :
     4298      find first clients where x-store-type = clients.obj-type and
     4299                               x-store-code = clients.obj-code
     4300                               no-lock no-error.
     4301              if available clients then assign  objname = clients.obj-name
     4302                                                x-db-num     = clients.db-num.
     4303                                            else  objname="объект не определен".
     4304     run calcitog in this-procedure .
     4305     run print-header in this-procedure .      case retclassify :
     4306      when "grp-goods":u      then  run run2 in this-procedure .
     4307      otherwise do:
     4308        message "Ошибка вызова" view-as alert-box error .
     4309      end.
     4310      end case.
     4311     run print-footer in this-procedure .
     4312     end procedure.
     4313   procedure calc-sub-itog :
     4314   define input parameter tt as int no-undo.
     4315   define variable tt2 as integer no-undo .
     4316     if tt = 6 then tt2 = 7 .
     4317               else tt2 = tt.
     4318   repeat i# = 1 + tt to 3 + tt2 :
     4319   run sum-i (
     4320    input oborot-vt[i#]
     4321   ,input tt
     4322   ,input-output b1-oborot-vt[i#]
     4323   ,input-output b2-oborot-vt[i#]
     4324   ,input-output bi-oborot-vt[i#]
     4325   ,input-output bo-oborot-vt[i#]
     4326   ,input oborot-ie[i#]
     4327   ,input-output b1-oborot-ie[i#]
     4328   ,input-output b2-oborot-ie[i#]
     4329   ,input-output bi-oborot-ie[i#]
     4330   ,input-output bo-oborot-ie[i#]
     4331   ) .
     4332   run sum-i (
     4333    input oborot-iv[i#]
     4334   ,input tt
     4335   ,input-output b1-oborot-iv[i#]
     4336   ,input-output b2-oborot-iv[i#]
     4337   ,input-output bi-oborot-iv[i#]
     4338   ,input-output bo-oborot-iv[i#]
     4339   ,input oborot-ee[i#]
     4340   ,input-output b1-oborot-ee[i#]
     4341   ,input-output b2-oborot-ee[i#]
     4342   ,input-output bi-oborot-ee[i#]
     4343   ,input-output bo-oborot-ee[i#]
     4344   ) .
     4345   run sum-i (
     4346    input oborot-ev[i#]
     4347   ,input tt
     4348   ,input-output b1-oborot-ev[i#]
     4349   ,input-output b2-oborot-ev[i#]
     4350   ,input-output bi-oborot-ev[i#]
     4351   ,input-output bo-oborot-ev[i#]
     4352   ,input oborot-ep[i#]
     4353   ,input-output b1-oborot-ep[i#]
     4354   ,input-output b2-oborot-ep[i#]
     4355   ,input-output bi-oborot-ep[i#]
     4356   ,input-output bo-oborot-ep[i#]
     4357   ) .
     4358   run sum-i (
     4359    input oborot-rv[i#]
     4360   ,input tt
     4361   ,input-output b1-oborot-rv[i#]
     4362   ,input-output b2-oborot-rv[i#]
     4363   ,input-output bi-oborot-rv[i#]
     4364   ,input-output bo-oborot-rv[i#]
     4365   ,input oborot-es[i#]
     4366   ,input-output b1-oborot-es[i#]
     4367   ,input-output b2-oborot-es[i#]
     4368   ,input-output bi-oborot-es[i#]
     4369   ,input-output bo-oborot-es[i#]
     4370   ) .
     4371   run sum-i (
     4372    input oborot-em[i#]
     4373   ,input tt
     4374   ,input-output b1-oborot-em[i#]
     4375   ,input-output b2-oborot-em[i#]
     4376   ,input-output bi-oborot-em[i#]
     4377   ,input-output bo-oborot-em[i#]
     4378   ,input oborot-re[i#]
     4379   ,input-output b1-oborot-re[i#]
     4380   ,input-output b2-oborot-re[i#]
     4381   ,input-output bi-oborot-re[i#]
     4382   ,input-output bo-oborot-re[i#]
     4383   ) .
     4384   run sum-i (
     4385    input oborot-im[i#]
     4386   ,input tt
     4387   ,input-output b1-oborot-im[i#]
     4388   ,input-output b2-oborot-im[i#]
     4389   ,input-output bi-oborot-im[i#]
     4390   ,input-output bo-oborot-im[i#]
     4391   ,input oborot-rs[i#]
     4392   ,input-output b1-oborot-rs[i#]
     4393   ,input-output b2-oborot-rs[i#]
     4394   ,input-output bi-oborot-rs[i#]
     4395   ,input-output bo-oborot-rs[i#]
     4396   ) .
     4397   run sum-i (
     4398    input oborot-ot[i#]
     4399   ,input tt
     4400   ,input-output b1-oborot-ot[i#]
     4401   ,input-output b2-oborot-ot[i#]
     4402   ,input-output bi-oborot-ot[i#]
     4403   ,input-output bo-oborot-ot[i#]
     4404   ,input oborot-we[i#]
     4405   ,input-output b1-oborot-we[i#]
     4406   ,input-output b2-oborot-we[i#]
     4407   ,input-output bi-oborot-we[i#]
     4408   ,input-output bo-oborot-we[i#]
     4409   ) .
     4410   run sum-i (
     4411    input oborot-ap[i#]
     4412   ,input tt
     4413   ,input-output b1-oborot-ap[i#]
     4414   ,input-output b2-oborot-ap[i#]
     4415   ,input-output bi-oborot-ap[i#]
     4416   ,input-output bo-oborot-ap[i#]
     4417   ,input oborot-pc[i#]
     4418   ,input-output b1-oborot-pc[i#]
     4419   ,input-output b2-oborot-pc[i#]
     4420   ,input-output bi-oborot-pc[i#]
     4421   ,input-output bo-oborot-pc[i#]
     4422   ) .
     4423     b1-oborot-em[ i#] = b1-oborot-em[ i#] + oborot-wm[ i#].
     4424     b2-oborot-em[ i#] = b2-oborot-em[ i#] + oborot-wm[ i#].
     4425     bi-oborot-em[ i#] = bi-oborot-em[ i#] + oborot-wm[ i#].
     4426     bo-oborot-em[ i#] = bo-oborot-em[ i#] + oborot-wm[ i#].
     4427     bo-ostatok-start[ i#]  = bo-ostatok-start[i#]  + ostatok-start[ i#]  .
     4428     bo-ostatok-end[ i#]    = bo-ostatok-end[i#]    + ostatok-end[ i#]    .
     4429     if i# = 7 then b1-oborot-disc[1 ]  = b1-oborot-disc[1]  + oborot-disc[1]  .
     4430     if i# = 7 then b2-oborot-disc[1 ]  = b2-oborot-disc[1]  + oborot-disc[1]  .
     4431     if i# = 7 then bi-oborot-disc[1 ]  = bi-oborot-disc[1]  + oborot-disc[1]  .
     4432     if i# = 7 then bo-oborot-disc[1 ]  = bo-oborot-disc[1]  + oborot-disc[1]  .
     4433     if i# = 8 then
     4434       assign
     4435         bi-oborot-sum-sale[ i#]  = bi-oborot-ee[ i#] +
     4436                                 bi-oborot-re[ i#]         +
     4437                                 bi-oborot-rs[ i#]    +
     4438                                 bi-oborot-es[ i#]
     4439         b1-oborot-sum-sale[ i#]  = b1-oborot-ee[ i#] +
     4440                                 b1-oborot-re[ i#]         +
     4441                                 b1-oborot-rs[ i#]    +
     4442                                 b1-oborot-es[ i#]
     4443         b2-oborot-sum-sale[ i#]  = b2-oborot-ee[ i#] +
     4444                                 b2-oborot-re[ i#]         +
     4445                                 b2-oborot-rs[ i#]    +
     4446                                 b2-oborot-es[ i#]
     4447         bo-oborot-sum-sale[ i#]  = bo-oborot-ee[ i#] +
     4448                                 bo-oborot-re[ i#]         +
     4449                                 bo-oborot-rs[ i#]    +
     4450                                 bo-oborot-es[ i#]
     4451         .
     4452     if  xshowmediator = true  then do:
     4453         if i# = 8 then b1-oborot-sum-cost[2 ]  = b1-oborot-sum-cost[2]  + oborot-sum-cost[1]  .
     4454         if i# = 8 then b2-oborot-sum-cost[2 ]  = b2-oborot-sum-cost[2]  + oborot-sum-cost[1]  .
     4455         if i# = 8 then bi-oborot-sum-cost[2 ]  = bi-oborot-sum-cost[2]  + oborot-sum-cost[1]  .
     4456         if i# = 8 then bo-oborot-sum-cost[2 ]  = bo-oborot-sum-cost[2]  + oborot-sum-cost[1]  .
     4457     end.
     4458     if i# = 2 and xshowmediator = false  then
     4459         assign
     4460           bi-oborot-sum-cost[ i#]  = bi-oborot-ee[ i#] +
     4461                                   bi-oborot-re[ i#]         +
     4462                                   bi-oborot-rs[ i#]    +
     4463                                   bi-oborot-es[ i#]
     4464           b1-oborot-sum-cost[ i#]  = b1-oborot-ee[ i#] +
     4465                                   b1-oborot-re[ i#]         +
     4466                                   b1-oborot-rs[ i#]    +
     4467                                   b1-oborot-es[ i#]
     4468           b2-oborot-sum-cost[ i#]  = b2-oborot-ee[ i#] +
     4469                                   b2-oborot-re[ i#]         +
     4470                                   b2-oborot-rs[ i#]    +
     4471                                   b2-oborot-es[ i#]
     4472           bo-oborot-sum-cost[ i#]  = bo-oborot-ee[ i#] +
     4473                                   bo-oborot-re[ i#]         +
     4474                                   bo-oborot-rs[ i#]    +
     4475                                   bo-oborot-es[ i#]
     4476           .
     4477     if i# = 8 then b1-oborot-eff[1 ]  = b1-oborot-eff[1]  + oborot-eff[1]  .
     4478     if i# = 8 then b2-oborot-eff[1 ]  = b2-oborot-eff[1]  + oborot-eff[1]  .
     4479     if i# = 8 then bi-oborot-eff[1 ]  = bi-oborot-eff[1]  + oborot-eff[1]  .
     4480     if i# = 8 then bo-oborot-eff[1 ]  = bo-oborot-eff[1]  + oborot-eff[1]  .
     4481     if i# = 8 then    if  bi-oborot-sum-cost[2] <>  0 then
     4482                           bi-oborot-prc[1] = 100 * (bi-oborot-sum-sale[8] - bi-oborot-sum-cost[2] ) / bi-oborot-sum-cost[2] .
     4483                      else bi-oborot-prc[1] = 0.
     4484     if i# = 8 then    if  bo-oborot-sum-cost[2] <>  0 then
     4485                           bo-oborot-prc[1] = 100 * (bo-oborot-sum-sale[8] - bo-oborot-sum-cost[2] ) / bo-oborot-sum-cost[2] .
     4486                      else bo-oborot-prc[1] = 0.
     4487     if i# = 8 then    if  b1-oborot-sum-cost[2] <>  0 then
     4488                           b1-oborot-prc[1] = 100 * (b1-oborot-sum-sale[8] - b1-oborot-sum-cost[2] ) / b1-oborot-sum-cost[2] .
     4489                      else b1-oborot-prc[1] = 0.
     4490     if i# = 8 then    if  b2-oborot-sum-cost[2] <>  0 then
     4491                           b2-oborot-prc[1] = 100 * (b2-oborot-sum-sale[8] - b2-oborot-sum-cost[2] ) / b2-oborot-sum-cost[2] .
     4492                      else b2-oborot-prc[1] = 0.
     4493    end.
     4494   end procedure.
     4495   procedure sum-i :
     4496   define input parameter ob like oborot-ot[1] no-undo.
     4497   define input parameter tt as int  no-undo.
     4498   define input-output parameter b1 like b1-oborot-ot[1] no-undo.
     4499   define input-output parameter b2 like b1-oborot-ot[1] no-undo.
     4500   define input-output parameter bi like b1-oborot-ot[1] no-undo.
     4501   define input-output parameter bo like b1-oborot-ot[1] no-undo.
     4502   define input parameter ob2 like oborot-ot[1] no-undo.
     4503   define input-output parameter b1- like b1-oborot-ot[1] no-undo.
     4504   define input-output parameter b2- like b1-oborot-ot[1] no-undo.
     4505   define input-output parameter bi- like b1-oborot-ot[1] no-undo.
     4506   define input-output parameter bo- like b1-oborot-ot[1] no-undo.
     4507   assign
     4508    b1  = b1 + ob
     4509    b2  = b2 + ob
     4510    b1- = b1- + ob2
     4511    b2- = b2- + ob2
     4512    .
     4513       assign
     4514       bi = bi + ob
     4515       bo = bo + ob
     4516       bi- = bi- + ob2
     4517       bo- = bo- + ob2
     4518       .
     4519   end procedure.
     4520   procedure clear-item :
     4521   define variable kk as int no-undo.
     4522    repeat kk = 1 to 13 :
     4523    assign
     4524       oborot-ie                 [kk]    = 0
     4525       oborot-ee                 [kk]    = 0
