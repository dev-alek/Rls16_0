     3080     if i = 13 then do:
     3081       if "bi-" = "b1-" or "bi-" = "b2-" or "bi-" = "bi-" or "bi-" = "bo-" then do:
     3082          if use-column[27] then do: l-nk = l-nk + 1 .  run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , 0 ,  i). end.
     3083       end.
     3084       else do:
     3085         if use-column[27] then do: l-nk = l-nk + 1 .  run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , ( if ABS(bi-oborot-ee         [1] +
     3086                                                                                                                                       bi-oborot-re     [1] +
     3087                                                                                                                                       bi-oborot-es    [1] +
     3088                                                                                                                                       bi-oborot-rs[1] ) <> 0
     3089                                                                                                                               then
     3090                                                                                                                                   ABS(bi-oborot-ee         [11] +
     3091                                                                                                                                       bi-oborot-re     [11] +
     3092                                                                                                                                       bi-oborot-es    [11] +
     3093                                                                                                                                       bi-oborot-rs[11] )
     3094                                                                                                                                   /
     3095                                                                                                                                   ABS(bi-oborot-ee         [1] +
     3096                                                                                                                                       bi-oborot-re     [1] +
     3097                                                                                                                                       bi-oborot-es    [1] +
     3098                                                                                                                                       bi-oborot-rs[1] )
     3099                                                                                                                               else 0 )
     3100         ,  i). end.
     3101       end.
     3102     end.
     3103     else do:
     3104     if use-column[27] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , (bi-oborot-ee         [i] +
     3105                                                                                                                           bi-oborot-re     [i] +
     3106                                                                                                                           bi-oborot-es    [i] +
     3107                                                                                                                           bi-oborot-rs[i] )
     3108     ,  i). end.
     3109     end.
     3110     end.
     3111     if x-vat = false  and i = 2 then do:
     3112     if use-column[6]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-ostatok-start                          [i] -  bi-ostatok-start                          [3] ),  i). end.
     3113     if use-column[7]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-oborot-ie          [i] -  bi-oborot-ie          [3] ),  i). end.
     3114     if use-column[8]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-oborot-iv          [i] -  bi-oborot-iv          [3] ),  i). end.
