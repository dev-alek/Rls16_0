     4532       oborot-iv                 [kk]    = 0
     4533       oborot-ev                 [kk]    = 0
     4534       oborot-rv             [kk]    = 0
     4535       oborot-em                  [kk]    = 0
     4536       oborot-wm                  [kk]    = 0
     4537       oborot-im                  [kk]    = 0
     4538       oborot-ot                  [kk]    = 0
     4539       oborot-disc                             [kk]    = 0
     4540       oborot-eff                              [kk]    = 0
     4541       oborot-prc                              [kk]    = 0
