     4859   procedure ex-display :
     4860   define input parameter par-1 as int no-undo.
     4861   define input parameter par-2 like  ostatok-start[1] no-undo.
     4862   define input parameter par-i as int no-undo.
     4863     assign num#col#  = par-1.
     4864     if par-i = 13 then do:
     4865       run macr_excel_dec ( round (par-2 ,4)  , num#str# , num#col#   ).
     4866     end.
     4867     else do:
     4868       if par-i = 1 or par-i = 11 or par-i = 12 then do :
     4869         run macr_excel_dec ( round (par-2 ,3)  , num#str# , num#col#   ).
     4870       end.
     4871       else do :
     4872         run macr_excel_dec ( round (par-2 ,2)  , num#str# , num#col#   ).
     4873       end.
     4874     end.
     4875   end procedure.
     4876   procedure u-line:
     4877   end procedure.
     4878   procedure p-line:
     4879   end procedure.
     4880   procedure make-col :
     4881    define variable l#1 as int  no-undo.
     4882    define variable l#2 as int  no-undo.
     4883    define variable l as int  no-undo.
     4884     assign
     4885       nk = 0
     4886       kk = 0
     4887     .
     4888     if xshowcost     then do: kk = kk + 1. end.
     4889     if xshowcostnds  then do: kk = kk + 1. end.
     4890     if xshowcrsa     then do: kk = kk + 1. end.
     4891     if xshowcrsands  then do: kk = kk + 1. end.
     4892     if xshowsale     then do: kk = kk + 1. end.
     4893     if xshowsalends  then do: kk = kk + 1. end.
     4894     if xshowsaleslt  then do: kk = kk + 1. end.
     4895     if xshowmediator then do: kk = kk + 1. end.
     4896     if x-tog-wt      then do: kk = kk + 1. end.
     4897     if x-tog-ms      then do: kk = kk + 1. end.
     4898     if xDens         then do: kk = kk + 1. end.
     4899    assign
     4900     num#str# = num#str# + 1
     4901     num#col#  = 0
     4902    .
     4903    if use-column[28] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "№ "              , num#str# , num#col# ) . run macr_cell_size (10, ? , num#str# , num#col# , num#str# , num#col# ). end.
     4904    if use-column[1]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "Код "            , num#str# , num#col# ) . run macr_cell_size (10, ? , num#str# , num#col# , num#str# , num#col# ). end.
     4905    if use-column[2]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "Артикул"         , num#str# , num#col# ) . run macr_cell_size (16, ? , num#str# , num#col# , num#str# , num#col# ). end.
     4906    if use-column[3]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "Название товара" , num#str# , num#col# ) . run macr_cell_size (60, ? , num#str# , num#col# , num#str# , num#col# ). end.
     4907    if use-column[4]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "Ед.изм "         , num#str# , num#col# ) . run macr_cell_size (7 , ? , num#str# , num#col# , num#str# , num#col# ). end.
     4908    if use-column[5]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "т/у"             , num#str# , num#col# ) . run macr_cell_size (4 , ? , num#str# , num#col# , num#str# , num#col# ). end.
     4909    if use-column[21] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "Скидка"          , num#str# , num#col# ) . run macr_cell_size (15, ? , num#str# , num#col# , num#str# , num#col# ). end.
     4910    if use-column[23] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "Эффективность"   , num#str# , num#col# ) . run macr_cell_size (16, ? , num#str# , num#col# , num#str# , num#col# ). end.
     4911    if use-column[24] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "% наценки"       , num#str# , num#col# ) . run macr_cell_size (13, ? , num#str# , num#col# , num#str# , num#col# ). end.
     4912       mp = num#col#  + 1.
     4913       mp-1 = num#col#  .
     4914    if use-column[6]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Остаток на начало "               , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4915    if use-column[7]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот приход внешний"            , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4916    if use-column[8]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот приход перемещение"        , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4917    if use-column[9]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот приход производство"       , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4918    if use-column[10] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот расход внешний"            , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4919    if use-column[11] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот расход перемещение"        , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4920    if use-column[12] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот расход производство"       , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4921    if use-column[13] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот  списание"                 , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4922    if use-column[14] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот касса продажа "            , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4923    if use-column[15] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот касса возврат"             , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4924    if use-column[16] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот возврат внешний"           , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4925    if use-column[17] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот возврат поставщику"        , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4926    if use-column[18] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот возврат перемещение"       , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4927    if use-column[19] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот  инвентаризация"           , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4928    if use-column[20] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот  переоценка"               , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4929    if use-column[22] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Остаток на конец "                , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4930    if use-column[25] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format('коррекция учетных цен':U       , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4931    if use-column[26] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format('смена типа приобретения':U       , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4932    if use-column[27] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Расход-Возврат"                   , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4933       run macr_cell_size (16, ? , num#str# , mp, num#str# , (num#col#  + (kk * (num#col#  - mp)) + kk) ).
     4934      num#str# = num#str# + 1.
     4935      repeat l#1 = mp to nk :
     4936            l#2 = 0.
     4937                num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "количество"  , num#str# , num#col#  ) .
     4938            if xshowcost    then do:
     4939                l#2 = l#2 + 1.
     4940                num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "учетн. сумма"  , num#str# , num#col#  ) .
     4941                end.
     4942            if xshowcostnds then do:
     4943                l#2 = l#2 + 1.
     4944                num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "учетн.НДС"  , num#str# , num#col#  ) .
     4945               end.
     4946            if xshowmediator then do:
     4947               l#2 = l#2 + 1.
     4948               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "цены поср."  , num#str# , num#col#  ) .
     4949               end.
     4950            if xshowcrsa    then do:
     4951               l#2 = l#2 + 1.
     4952               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "продаж. сумма"  , num#str# , num#col#  ) .
     4953               end.
     4954            if xshowcrsands then do:
     4955               l#2 = l#2 + 1.
     4956               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "продаж.НДС"  , num#str# , num#col#  ) .
     4957               end.
     4958             if xshowsale    then do:
     4959               l#2 = l#2 + 1.
     4960               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "док. сумма"  , num#str# , num#col#  ) .
     4961               end.
     4962            if xshowsalends then do:
     4963               l#2 = l#2 + 1.
     4964               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "док.НДС"  , num#str# , num#col#  ) .
     4965               end.
     4966            if xshowsaleslt then do:
     4967               l#2 = l#2 + 1.
     4968               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "док.НсП"  , num#str# , num#col#  ) .
     4969            end.
     4970            if x-tog-wt then do:
     4971             assign
     4972               l#2 = l#2 + 1
     4973               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2
     4974             .
     4975             run macr_excel_char_with_format( "вес"  , num#str# , num#col#  ) .
     4976            end.
     4977            if x-tog-ms then do:
     4978             assign
     4979               l#2 = l#2 + 1
     4980               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2
     4981             .
     4982             run macr_excel_char_with_format( "объем"  , num#str# , num#col#  ) .
     4983            end.
     4984            if xDens then do:
     4985             assign
     4986               l#2 = l#2 + 1
     4987               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2
     4988             .
     4989             run macr_excel_char_with_format( "плотность"  , num#str# , num#col#  ) .
     4990            end.
     4991        end.
     4992   end procedure .
