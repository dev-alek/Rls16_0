     5052   procedure new-tmp-page :
     5053    do
     5054    on error undo, return error return-value
     5055    :
     5056       if   num#str#  >=  63000  then do:
     5057           output stream macr_excel  close .
     5058           run paramls-write in this-procedure
     5059             (input "file"
     5060             ,input string(v-ind)
     5061             ,input v-file-name
     5062             ) .
     5063           run gbl/_tmpfile.p ("wb", ".txt", output v-file-name) .
     5064           output stream  macr_excel to value(v-file-name) .
     5065           v-ind = v-ind + 1 .
     5066           num#str# = 0 .
     5067   define variable old-s as integer no-undo .
     5068   define variable old-s2 as integer no-undo .
     5069       assign
     5070       old-s =   num#str#
     5071       .
     5072       run make-col .
     5073       assign
     5074         old-s2 =   num#str#
     5075       .
     5076      num#str# = old-s + 1  .
     5077      run proc-print-header .
     5078      num#str# = old-s2     .
     5079       end.
     5080    end.
     5081   end procedure.
     5082   procedure pp :
     5083   define input parameter ll as integer no-undo .
     5084   define input parameter uu as integer no-undo .
     5085   define input parameter ff as character no-undo .
     5086   End procedure.
     5087   procedure find-last-prise-med :
     5088   define input parameter p-artic     like ub.goods.artic no-undo .
     5089   define input parameter p-prod-type like ub.goods.prod-type no-undo .
     5090   define input parameter p-prod-code like ub.goods.prod-code no-undo .
     5091   define input parameter p-host-code like ub.gds-obj.host-code no-undo .
     5092   define output parameter  p-price   like ub.gds-obj.last-base no-undo .
     5093   define buffer p-gds-obj   for  ub.gds-obj .
     5094   define buffer buf_trn-doc for  ub.trn-doc .
     5095   define variable v-fact-order as decimal no-undo .
     5096   p-price = 0 .
     5097     define variable v-in-date as date      no-undo .
     5098     define variable fl as logical no-undo .
     5099     fl = yes.
     5100     v-fact-order = 0 .
     5101     for each tt-obj-list no-lock break by tt-obj-list.obj-type by tt-obj-list.obj-code
     5102     :
     5103       find first p-gds-obj no-lock
     5104         where p-gds-obj.artic     = p-artic         and
     5105                 p-gds-obj.prod-type = p-prod-type     and
     5106                 p-gds-obj.prod-code = p-prod-code     and
     5107                 p-gds-obj.obj-code  = tt-obj-list.obj-code and
     5108                 p-gds-obj.obj-type  = tt-obj-list.obj-type
     5109         no-error .
     5110       if available p-gds-obj then do:
     5111       if p-gds-obj.in-date = ?  then next .
     5112       if fl = yes then do:
     5113         assign
     5114           v-in-date = p-gds-obj.in-date
     5115           p-price   =  if tPrintRubl then  p-gds-obj.last-rubl else  p-gds-obj.last-base
     5116           fl = no
     5117       .
     5118        find first buf_trn-doc no-lock  where buf_trn-doc.doc-code = p-gds-obj.in-code no-error  .
     5119        if available buf_trn-doc  then  v-fact-order = buf_trn-doc.fact-order .
     5120       end.
     5121         if p-gds-obj.in-date >= v-in-date   then do:
     5122            if p-gds-obj.in-date = v-in-date then do:
     5123               find first buf_trn-doc no-lock  where buf_trn-doc.doc-code = p-gds-obj.in-code no-error .
     5124               if available buf_trn-doc  then
     5125                   if buf_trn-doc.fact-order >  v-fact-order   then do:
     5126                     assign
     5127                       v-fact-order = buf_trn-doc.fact-order
     5128                       p-price   =  if tPrintRubl then  p-gds-obj.last-rubl else  p-gds-obj.last-base
     5129                       v-in-date =   p-gds-obj.in-date
     5130                     .
     5131                   end.
     5132            end.
     5133            else do:
     5134             find first buf_trn-doc no-lock  where buf_trn-doc.doc-code = p-gds-obj.in-code no-error .
     5135             if available buf_trn-doc  then
     5136                 assign
     5137                   p-price   =    if tPrintRubl then  p-gds-obj.last-rubl else  p-gds-obj.last-base
     5138                   v-in-date =    p-gds-obj.in-date
     5139                   v-fact-order = buf_trn-doc.fact-order .
     5140                 .
     5141             end.
     5142           if p-price = ? then   p-price  = 0 .
     5143         end.
     5144       end.
     5145     End .
     5146     if p-price = ? then   p-price  = 0 .
     5147   end procedure.
     5148   procedure find-mediator :
     5149   define input  parameter c-host-code as integer no-undo .
     5150   define input  parameter p-Showmediatr as logical no-undo .
     5151   define output parameter p-host-code as integer no-undo .
     5152   define output parameter p-flag as logical no-undo .
     5153   define buffer b-sysconf  for ub.sysconf.
     5154    p-host-code = 0 .
     5155    p-flag  = true .
     5156       if p-Showmediatr = true then do:
     5157       find first ub.sysconf where ub.sysconf.avrg-price = true no-lock no-error .
     5158             if avail ub.sysconf then DO :
     5159               p-host-code = ub.sysconf.host-code.
     5160               if tPrintRubl = false then do:
     5161                     find first b-sysconf where b-sysconf.host-code = c-host-code no-lock no-error .
     5162                           if  ub.sysconf.base-code <> b-sysconf.base-code then DO:
     5163                                 p-flag  = false  .
     5164                                 message "Базовая валюта посредника и базовая валюта текущей фирмы не совпадает . Нельзя получить отчет в валюте !"
     5165                                 view-as alert-box error.
     5166                           end.
     5167               end.
     5168             end.
     5169             for each ub.shop no-lock where ub.shop.host-code = p-host-code :
     5170                 create tt-obj-list no-error .
     5171                 assign tt-obj-list.obj-type = 'маг':U
     5172                        tt-obj-list.obj-code = ub.shop.obj-code no-error .
     5173             end.
     5174             for each ub.store no-lock where ub.store.host-code = p-host-code :
     5175                 create tt-obj-list no-error .
     5176                 assign tt-obj-list.obj-type = 'скл':U
     5177                        tt-obj-list.obj-code = ub.store.obj-code no-error .
     5178             end.
     5179       End.
     5180    End procedure .
     5181   PROCEDURE ob-line-stk  :
     5182   define input  parameter x-store-code     like ub.clients.obj-code      no-undo.
     5183   define input  parameter x-store-type     like ub.clients.obj-type      no-undo.
     5184   define INPUT  parameter x-artic          like ub.stk-line.artic        no-undo.
     5185   define INPUT  parameter x-prod-code      like ub.stk-line.prod-code    no-undo.
     5186   define INPUT  parameter x-prod-type      like ub.stk-line.prod-type    no-undo.
     5187   define INPUT  parameter x-Fact-order-1   like ub.stk-line.Fact-order   no-undo.
     5188   define INPUT  parameter x-Fact-order-2   like ub.stk-line.Fact-order   no-undo.
     5189   define input  parameter x-sum-type       like ub.stk-line.sum-type     no-undo.
     5190   define input  parameter x-cat-id         like ub.stk-line.cat-id       no-undo.
     5191   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type  no-undo.
     5192   define input  parameter xTog-obj         as log                     no-undo.
     5193   define input  parameter xi               as int                     no-undo.
     5194   define output  parameter Quntity         like ub.stk-line.fact-qnty   no-undo.
     5195   define output  parameter sum             like ub.stk-line.sum-base    no-undo.
     5196   define output  parameter vat             like ub.stk-line.sum-base    no-undo.
     5197   define output  parameter slt             like ub.stk-line.sum-base    no-undo.
     5198   define output  parameter disc            like ub.stk-line.sum-base    no-undo.
     5199   define variable  First-qnty   like ub.stk-line.fact-qnty   no-undo.
     5200   define variable  Second-qnty  like ub.stk-line.fact-qnty   no-undo.
     5201   define variable  First-sum   like ub.stk-line.sum-base   no-undo.
     5202   define variable  Second-sum  like ub.stk-line.sum-base   no-undo.
     5203   define variable  First-vat   like ub.stk-line.sum-base   no-undo.
     5204   define variable  Second-vat  like ub.stk-line.sum-base   no-undo.
     5205   define variable  First-slt   like ub.stk-line.sum-base   no-undo.
     5206   define variable  Second-slt  like ub.stk-line.sum-base   no-undo.
     5207   define variable  First-disc   like ub.stk-line.sum-base   no-undo.
     5208   define variable  Second-disc  like ub.stk-line.sum-base   no-undo.
     5209   define buffer stk-line2 for ub.stk-line .
     5210   if x-Fact-order-2 < x-Fact-order-1 Then x-Fact-order-2 = x-Fact-order-1.
     5211    Assign
     5212      First-qnty  = 0
     5213      Second-qnty = 0
     5214      Quntity     = 0
     5215      First-sum  = 0
     5216      Second-sum = 0
     5217      sum        = 0
     5218      First-vat  = 0
     5219      Second-vat = 0
     5220      vat        = 0
     5221      First-slt   = 0
     5222      Second-slt  = 0
     5223      slt         = 0
     5224      First-disc  = 0
     5225      Second-disc = 0
     5226      disc        = 0
     5227     .
     5228     For each obj-list  no-lock :
     5229      if  xTog-obj THEN
     5230          if   NOT(    x-store-type     = obj-list.obj-type
     5231               AND    x-store-code      = obj-list.obj-code ) Then NEXT.
     5232      FOR each temp#sum-type where temp#sum-type.xi = xi no-lock :
     5233         find last ub.stk-line no-lock
     5234           where ub.stk-line.obj-type   = obj-list.obj-type
     5235             and ub.stk-line.obj-code   = obj-list.obj-code
     5236             and ub.stk-line.artic      = x-artic
     5237             and ub.stk-line.prod-type  = x-prod-type
     5238             and ub.stk-line.prod-code  = x-prod-code
     5239             and ub.stk-line.sum-type   = temp#sum-type.sum-type
     5240             and ub.stk-line.cat-id     = '##,##':U
     5241             and ub.stk-line.fact-order <= x-fact-order-1
     5242           use-index category
     5243           no-error .
     5244         if available ub.stk-line then do:
     5245           assign
     5246             First-qnty = First-qnty + ub.stk-line.fact-qnty
     5247             First-sum  = First-sum  + (if tprintrubl then ub.stk-line.sum-rubl   else ub.stk-line.sum-base  )
     5248             First-vat  = First-vat  + (if tprintrubl then ub.stk-line.vat-rubl   else ub.stk-line.vat-base  )
     5249             First-disc = First-disc + (if tprintrubl then ub.stk-line.other-rubl else ub.stk-line.other-base )
     5250             First-slt  = First-slt  + (if tprintrubl then ub.stk-line.slt-rubl   else ub.stk-line.slt-base   )
     5251           .
     5252         end.
     5253         find last stk-line2 no-lock
     5254           where stk-line2.obj-code   = obj-list.obj-code
     5255             and stk-line2.obj-type   = obj-list.obj-type
     5256             and stk-line2.artic      = x-artic
     5257             and stk-line2.prod-type  = x-prod-type
     5258             and stk-line2.prod-code  = x-prod-code
     5259             and stk-line2.sum-type   = temp#sum-type.sum-type
     5260             and stk-line2.cat-id     = '##,##':U
     5261             and stk-line2.fact-order <= x-fact-order-2
     5262           use-index category
     5263           no-error .
     5264         if available stk-line2 then do:
     5265           assign
     5266             Second-qnty = Second-qnty + Stk-line2.fact-qnty
     5267             Second-sum  = Second-sum  + (if tprintrubl then stk-line2.sum-rubl else stk-line2.sum-base    )
     5268             Second-vat  = Second-vat  + (if tprintrubl then stk-line2.vat-rubl else stk-line2.vat-base    )
     5269             second-disc = second-disc + (if tprintrubl then stk-line2.other-rubl else stk-line2.other-base )
     5270             second-slt  = second-slt  + (if tprintrubl then stk-line2.slt-rubl   else stk-line2.slt-base   )
     5271           .
     5272         end.
     5273      end.
     5274    end.
     5275    Assign
     5276      Quntity = Second-qnty - first-qnty
     5277      sum     = Second-sum  - first-sum
     5278      vat     = Second-vat  - first-vat
     5279      slt     = Second-slt  - first-slt
     5280      disc    = Second-disc  - first-disc
     5281      .
     5282   END PROCEDURE.
     5283   procedure calc-ms-wt :
     5284   define input        parameter p-oborot-num      as decimal   no-undo .
     5285   define input        parameter p-gds-wt-ms-base  as decimal   no-undo .
     5286   define input-output parameter p-oborot          as decimal   no-undo .
     5287   define input-output parameter p-bi-oborot       as decimal   no-undo .
     5288   define input-output parameter p-bo-oborot       as decimal   no-undo .
     5289   define input-output parameter p-b1-oborot       as decimal   no-undo .
     5290   define input-output parameter p-b2-oborot       as decimal   no-undo .
     5291   do
     5292   on error undo, return error return-value
     5293   :
     5294   if p-is-petrol = true then return .
     5295     assign
     5296       p-oborot    = p-oborot-num * p-gds-wt-ms-base
     5297       p-bi-oborot = p-bi-oborot + p-oborot
     5298       p-bo-oborot = p-bo-oborot + p-oborot
     5299       p-b1-oborot = p-b1-oborot + p-oborot
     5300       p-b2-oborot = p-b2-oborot + p-oborot
     5301     .
     5302   end.
     5303   end procedure.
     5304   procedure calc-dens :
     5305   define input        parameter p-ostatok-wt       as decimal   no-undo .
     5306   define input        parameter p-ostatok          as decimal   no-undo .
     5307   define input-output parameter p-density          as decimal   no-undo .
     5308   define input-output parameter p-bi-density       as decimal   no-undo .
     5309   define input-output parameter p-bo-density       as decimal   no-undo .
     5310   define input-output parameter p-b1-density       as decimal   no-undo .
     5311   define input-output parameter p-b2-density       as decimal   no-undo .
     5312   do
     5313   on error undo, return error return-value
     5314   :
     5315   if p-is-petrol = false then return .
     5316     assign
     5317       p-density    = if abs(p-ostatok) < abs(p-ostatok-wt) then abs(p-ostatok / p-ostatok-wt) else 0
     5318       p-bi-density = 0
     5319       p-bo-density = 0
     5320       p-b1-density = 0
     5321       p-b2-density = 0
     5322     .
     5323   end.
     5324   end procedure.
     5325   procedure calc-pt-ob :
     5326   define input  parameter p-ext-doc-type    as character no-undo .
     5327   define input  parameter x-store-type      as character no-undo .
     5328   define input  parameter x-store-code      as integer   no-undo .
     5329   define input  parameter p-artic           as character no-undo .
     5330   define input  parameter p-prod-type       as character no-undo .
     5331   define input  parameter p-prod-code       as integer   no-undo .
     5332   define input-output parameter p-oborot    as decimal   no-undo .
     5333   define input-output parameter p-bi-oborot as decimal   no-undo .
     5334   define input-output parameter p-bo-oborot as decimal   no-undo .
     5335   define input-output parameter p-b1-oborot as decimal   no-undo .
     5336   define input-output parameter p-b2-oborot as decimal   no-undo .
     5337     do
     5338     on error undo, return error return-value
     5339     :
     5340   define variable v-oborot as decimal   no-undo .
     5341   define buffer buf_doc-line  for ub.doc-line  .
     5342   define buffer buf_inv-line  for ub.inv-line  .
     5343   define buffer buf1_obj-list for obj-list .
     5344   assign
     5345     v-oborot = 0
     5346   .
     5347   if p-is-petrol = false   then return .
     5348     for each buf1_obj-list no-lock :
     5349      if  xtog-obj then
     5350          if   not(x-store-type     = buf1_obj-list.obj-type
     5351               and x-store-code     = buf1_obj-list.obj-code ) then next.
     5352       for each buf_doc-line  no-lock where
     5353             buf_doc-line.obj-type     = buf1_obj-list.obj-type and
     5354             buf_doc-line.obj-code     = buf1_obj-list.obj-code and
     5355             buf_doc-line.artic        = p-artic and
     5356             buf_doc-line.prod-type    = p-prod-type and
     5357             buf_doc-line.prod-code    = p-prod-code and
     5358             buf_doc-line.ext-doc-type = p-ext-doc-type and
     5359             buf_doc-line.status_      = 'факт':U        and
     5360             buf_doc-line.fact-order   <= fact-order-2  and
     5361             buf_doc-line.fact-order   >= fact-order-1
     5362             :
     5363             for each buf_inv-line  no-lock where
     5364                 buf_inv-line.doc-code     = buf_doc-line.doc-code and
     5365                 buf_inv-line.artic        = buf_doc-line.artic and
     5366                 buf_inv-line.prod-type    = buf_doc-line.prod-type and
     5367                 buf_inv-line.prod-code    = buf_doc-line.prod-code
     5368                 :
     5369                 if p-ext-doc-type = 'vt':U  then v-oborot = v-oborot + buf_doc-line.cli-qnty .
     5370                     else do:
     5371                     if p-ext-doc-type = 'we':U    or
     5372                        p-ext-doc-type = 'ee':U    or
     5373                        p-ext-doc-type = 'ev':U    or
     5374                        p-ext-doc-type = 'ep':U or
     5375                        p-ext-doc-type = 'em':U     or
     5376                        p-ext-doc-type = 'wm':U     or
     5377                        p-ext-doc-type = 'es':U   then
     5378                           v-oborot = v-oborot - buf_inv-line.wast-cli-qnty .
     5379                           else v-oborot = v-oborot + buf_inv-line.wast-cli-qnty .
     5380                     end.
     5381             end.
     5382       end.
     5383   end.
     5384   assign
     5385     p-oborot    = v-oborot
     5386     p-bi-oborot = p-bi-oborot + v-oborot
     5387     p-bo-oborot = p-bo-oborot + v-oborot
     5388     p-b1-oborot = p-b1-oborot + v-oborot
     5389     p-b2-oborot = p-b2-oborot + v-oborot
     5390   .
     5391   end.
     5392   end procedure.
     5393   procedure calc-density :
     5394   define input        parameter p-ext-doc-type  as character no-undo .
     5395   define input        parameter x-store-type    as character no-undo .
     5396   define input        parameter x-store-code    as integer   no-undo .
     5397   define input        parameter p-artic         as character no-undo .
     5398   define input        parameter p-prod-type     as character no-undo .
     5399   define input        parameter p-prod-code     as integer   no-undo .
     5400   define input-output parameter p-density       as decimal   no-undo .
     5401   define input-output parameter p-bi-density    as decimal   no-undo .
     5402   define input-output parameter p-bo-density    as decimal   no-undo .
     5403   define input-output parameter p-b1-density    as decimal   no-undo .
     5404   define input-output parameter p-b2-density    as decimal   no-undo .
     5405     do
     5406     on error undo, return error return-value
     5407     :
     5408   define variable v-oborot    as decimal   no-undo .
     5409   define variable v-fact-qnty as decimal   no-undo .
     5410   define buffer buf_doc-line  for ub.doc-line  .
     5411   define buffer buf_inv-line  for ub.inv-line  .
     5412   define buffer buf1_obj-list for obj-list .
     5413   assign
     5414     v-oborot     = 0
     5415     v-fact-qnty  = 0
     5416   .
     5417   if p-is-petrol = false   then return .
     5418     for each buf1_obj-list no-lock :
     5419      if  xtog-obj then
     5420          if   not(x-store-type     = buf1_obj-list.obj-type
     5421               and x-store-code     = buf1_obj-list.obj-code ) then next.
     5422       for each buf_doc-line  no-lock where
     5423             buf_doc-line.obj-type     = buf1_obj-list.obj-type and
     5424             buf_doc-line.obj-code     = buf1_obj-list.obj-code and
     5425             buf_doc-line.artic        = p-artic and
     5426             buf_doc-line.prod-type    = p-prod-type and
     5427             buf_doc-line.prod-code    = p-prod-code and
     5428             buf_doc-line.ext-doc-type = p-ext-doc-type and
     5429             buf_doc-line.status_      = 'факт':U        and
     5430             buf_doc-line.fact-order   <= fact-order-2  and
     5431             buf_doc-line.fact-order   >= fact-order-1
     5432             :
     5433             assign v-fact-qnty = v-fact-qnty + buf_doc-line.fact-qnty.
     5434             for each buf_inv-line  no-lock where
     5435                 buf_inv-line.doc-code     = buf_doc-line.doc-code and
     5436                 buf_inv-line.artic        = buf_doc-line.artic and
     5437                 buf_inv-line.prod-type    = buf_doc-line.prod-type and
     5438                 buf_inv-line.prod-code    = buf_doc-line.prod-code
     5439                 :
     5440                 if p-ext-doc-type = 'vt':U  then v-oborot = v-oborot + buf_doc-line.cli-qnty .
     5441                     else do:
     5442                     if p-ext-doc-type = 'we':U    or
     5443                        p-ext-doc-type = 'ee':U    or
     5444                        p-ext-doc-type = 'ev':U    or
     5445                        p-ext-doc-type = 'ep':U or
     5446                        p-ext-doc-type = 'em':U     or
     5447                        p-ext-doc-type = 'wm':U     or
     5448                        p-ext-doc-type = 'es':U   then
     5449                           v-oborot = v-oborot - buf_inv-line.wast-cli-qnty .
     5450                           else v-oborot = v-oborot + buf_inv-line.wast-cli-qnty .
     5451                     end.
     5452             end.
     5453       end.
     5454       assign
     5455         p-density    = if ( v-fact-qnty <> 0 and ABS(v-oborot) < ABS(v-fact-qnty)) then ABS(v-oborot / v-fact-qnty) else 0
     5456       .
     5457       assign
     5458         p-bi-density = p-density
     5459         p-bo-density = 0
     5460         p-b1-density = 0
     5461         p-b2-density = 0
     5462       .
     5463   end.
     5464   end.
     5465   end procedure.
