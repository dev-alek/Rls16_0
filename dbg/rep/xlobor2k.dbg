     5020   assign temp#sum-type.sum-type = 'cgdt':U + 'we':U temp#sum-type.xi = 107 . create temp#sum-type.
     5021   assign temp#sum-type.sum-type = 'cgdt':U + 'vt':U temp#sum-type.xi = 108 . create temp#sum-type.
