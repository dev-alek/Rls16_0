     3481     if not show-negativ-2 then  run b2-null-str-pr2  in this-procedure .
     3482      if not  (not show-negativ   and b2-null-str#  = 0  ) then do :
     3483         if not  (not show-negativ-2 and b2-null-str2# = 0  ) then do :
     3484   assign
     3485     num#str# = num#str# + 1
     3486     num#col# = 1.
     3487     run macr_excel_char_with_format( string( s-bar-code + ' ' + gds-zap-artic + ' ' + gds-zap-gds-name)  , num#str# , num#col#  ) .
     3488     num#col#  = 0 .
     3489     if use-column[28] then assign num#col#  = num#col#  + 1 .
     3490     if use-column[1] then  assign num#col#  = num#col#  + 1 .
     3491     if use-column[2] then  assign num#col#  = num#col#  + 1 .
     3492     if use-column[3] then  assign num#col#  = num#col#  + 1 .
     3493     if use-column[4] then  assign num#col#  = num#col#  + 1 .
     3494     if use-column[5] then  assign num#col#  = num#col#  + 1 .
     3495   if use-column[21] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(b2-oborot-disc [1],2 ), num#str# , num#col#   ).     end.
     3496   if use-column[23] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(b2-oborot-eff  [1],2 ), num#str# , num#col#   ).     end.
     3497   if use-column[24] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(b2-oborot-prc  [1],2 ), num#str# , num#col#   ).     end.
