     3608                                                                                               b2-oborot-rs[i]) -
     3609                                                                                             (b2-oborot-ee         [3] +
     3610                                                                                               b2-oborot-re     [3] +
     3611                                                                                               b2-oborot-es    [3] +
     3612                                                                                               b2-oborot-rs[3] ) ) , i ). end.
     3613     end.
     3614     end.
     3615     end.
     3616    run new-tmp-page .
     3617     run macr_cell_format
     3618     ( 10    ,
     3619       true  ,
     3620       true  ,
     3621       33    ,
     3622       num#str# ,
     3623       1 ,
     3624       num#str# ,
     3625       num#col# ) .
     3626     end.
     3627     end.
     3628   end procedure.
