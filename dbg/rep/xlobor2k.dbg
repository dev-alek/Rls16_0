     3693   bi-oborot-ee         [kk] = 0
     3694   bi-oborot-ep      [kk] = 0
     3695   bi-oborot-es    [kk] = 0
     3696   bi-oborot-re     [kk] = 0
     3697   bi-oborot-rs [kk] = 0
     3698   bi-oborot-we         [kk] = 0
     3699   bi-oborot-vt               [kk] = 0
     3700   bi-oborot-iv         [kk] = 0
     3701   bi-oborot-ev         [kk] = 0
     3702   bi-oborot-rv     [kk] = 0
     3703   bi-oborot-em          [kk] = 0
     3704   bi-oborot-wm          [kk] = 0
     3705   bi-oborot-im          [kk] = 0
     3706   bi-oborot-ot          [kk] = 0
     3707   bi-oborot-disc                    [kk] = 0
     3708   bi-oborot-eff                     [kk] = 0
     3709   bi-oborot-prc                     [kk] = 0
     3710   bi-ostatok-end                           [kk] = 0
