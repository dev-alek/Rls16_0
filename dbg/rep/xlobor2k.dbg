     3308                           run macr_cell_format
     3309                           ( 10    ,
     3310                             true  ,
     3311                             true  ,
     3312                             36    ,
     3313                             num#str# ,
     3314                             num#col# ,
     3315                             num#str# ,
     3316                             5 ) .
     3317                         fr0 = false .
     3318                       end.
     3319                  end.
     3320     num#str# = num#str# + 1     .
     3321     num#col# = 2 .
