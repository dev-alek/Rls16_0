     3116     if use-column[10] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-oborot-ee          [i] -  bi-oborot-ee          [3] ),  i). end.
