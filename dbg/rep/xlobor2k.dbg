     2834   procedure calcitog :
     2835       run ostatok  in this-procedure (
     2836           input x-store-code  ,
     2837           input x-store-type  , x-tog-shift ,
     2838           input x-date-start - 1 ,
     2839           input date('')      , x-Shift-Start,x-Shift-End,
     2840           input 'crsa':U   ,
     2841           input '##,##':U,
     2842           input xtog-obj ,
     2843           output  quantity1  ,
     2844           output  coast_r1   ,
     2845           output  coast_v1   ,
     2846           output  vat_r1     ,
     2847           output  vat_v1     ,
     2848           output  fact-order-1 ).
     2849       run ostatok  in this-procedure (
     2850           input x-store-code  ,
     2851           input x-store-type  , x-tog-shift ,
     2852           input x-date-start  ,
     2853           input x-date-end    , x-Shift-Start,x-Shift-End,
     2854           input 'crsa':U   ,
     2855           input '##,##':U,
     2856           input xtog-obj ,
     2857           output  quantity1  ,
     2858           output  coast_r1   ,
     2859           output  coast_v1   ,
     2860           output  vat_r1     ,
     2861           output  vat_v1     ,
     2862           output  fact-order-2 ).
     2863             quantity1  = 0.
     2864             coast_r1   = 0.
     2865             coast_v1   = 0.
     2866             vat_r1     = 0.
     2867             vat_v1     = 0.
     2868   end procedure.
     2869   procedure display-str1  :
     2870   define variable ll as int no-undo.
     2871     assign
     2872       num#str# = num#str# + 1
     2873       num#col# = 0
     2874       v-gds-num = v-gds-num + 1
     2875     .
     2876     if use-column[28] then do: assign num#col#  = num#col# + 1 .   run macr_excel_dec ( v-gds-num , num#str# , num#col#   ) .   end.
     2877     if use-column[1]  then do: assign num#col#  = num#col# + 1 .   run macr_excel_dec ( gds-zap-b-code , num#str# , num#col#   ) .   end.
     2878     if use-column[2]  then do: assign num#col#  = num#col# + 1 .   run macr_excel_char ( gds-zap-artic, num#str# , num#col#   )   .   end.
     2879     if use-column[3]  then do: assign num#col#  = num#col# + 1 .   run macr_excel_char ( if xlongName then gds-zap-gds-long-name else gds-zap-gds-name, num#str# , num#col#   ) .  end.
     2880     if use-column[4]  then do: assign num#col#  = num#col# + 1 .   run macr_excel_char ( gds-zap-unit-base, num#str# , num#col#   ) . end.
     2881     if use-column[5]  then do: assign num#col#  = num#col# + 1 .   run macr_excel_char ( gds-zap-type, num#str# , num#col#   ) .      end.
     2882   if use-column[21] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(oborot-disc [1],2 ), num#str# , num#col#   ).     end.
     2883   if use-column[23] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(oborot-eff  [1],2 ), num#str# , num#col#   ).     end.
     2884   if use-column[24] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(oborot-prc  [1],2 ), num#str# , num#col#   ).     end.
     2885   def var l-nk as integer no-undo .
     2886     Assign
     2887       LL = 0
     2888       KK = 1
     2889     .
     2890     if xShowCost      Then DO: KK = KK + 1. End.
     2891     if xShowCostNDS   Then DO: KK = KK + 1. End.
     2892     if xShowCrsa      Then DO: KK = KK + 1. End.
     2893     if xShowCrsaNds   Then DO: KK = KK + 1. End.
     2894     if xShowSale      Then DO: KK = KK + 1. End.
     2895     if xShowSaleNds   Then DO: KK = KK + 1. End.
     2896     if xShowSaleslt   Then DO: KK = KK + 1. End.
     2897     if xShowmediator  Then DO: KK = KK + 1. End.
     2898     if x-tog-wt       then do: KK = KK + 1. End.
     2899     if x-tog-ms       then do: KK = KK + 1. End.
     2900     if xDens          then do: KK = KK + 1. End.
     2901     repeat i = 1 to 13 :
     2902       if i = 7 then next.
     2903       if NOT xShowCost      and i = 2   Then  next.
     2904       if NOT xShowCostNDS   and i = 3   Then  next.
     2905       if NOT xShowCrsa      and i = 5   Then  next.
     2906       if NOT xShowCrsaNds   and i = 6   Then  next.
     2907       if NOT xShowSale      and i = 8   Then  next.
     2908       if NOT xShowSaleNds   and i = 9   Then  next.
     2909       if NOT xShowSaleSlt   and i = 10  Then  next.
     2910       if NOT xShowmediator  and i = 4   Then  next.
     2911       if not x-tog-wt       and i = 11  then  next.
     2912       if not x-tog-ms       and i = 12  then  next.
     2913       if not xDens          and i = 13  then  next.
     2914       assign
     2915         LL = LL + 1
     2916         l-nk = mp-1
     2917       .
     2918     if x-vat or i <> 2  then do:
     2919     if use-column[6]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , ostatok-start                          [i] ,  i). end.
     2920     if use-column[7]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-ie          [i] ,  i). end.
     2921     if use-column[8]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-iv          [i] ,  i). end.
     2922     if use-column[9]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-im           [i] ,  i). end.
     2923     if use-column[10] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-ee          [i] ,  i). end.
     2924     if use-column[11] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-ev          [i] ,  i). end.
     2925     if use-column[12] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-em           [i] ,  i). end.
     2926     if use-column[13] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-we          [i] ,  i). end.
     2927     if use-column[14] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-es     [i] ,  i). end.
     2928     if use-column[15] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-rs [i] ,  i). end.
     2929     if use-column[16] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-re      [i] ,  i). end.
     2930     if use-column[17] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-ep       [i] ,  i). end.
     2931     if use-column[18] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-rv      [i] ,  i). end.
