      753   DEFINE INPUT PARAMETER pcurr-code like ub.cash-pay.curr-code no-undo.
      754   DEFINE INPUT PARAMETER pqnty1 as decimal no-undo.
      755   DEFINE INPUT PARAMETER pqnty2 as decimal no-undo.
      756   DEFINE INPUT PARAMETER pnetto as decimal no-undo.
      757   DEFINE INPUT PARAMETER pout-name as character no-undo.
      758   DEFINE INPUT PARAMETER pis-pay as logical no-undo.
      759   DEFINE INPUT PARAMETER pii as integer no-undo.
      760   _main:
