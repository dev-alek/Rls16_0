     1549   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1550   define new global shared variable g#trdcalib as handle no-undo.
     1551   function fnc-convert-dot-to-colon returns character
     1552       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
     1553   function fnc-convert-dot-to-colon returns character
     1554   (input p-data as decimal, input p-accur as character, input p-num as integer):
     1555       define variable result as character no-undo.
     1556       define variable v-str-result as character no-undo.
     1557       if p-data = ? then p-data = 0 .
     1558       p-data = round(p-data, p-num).
     1559       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     1560       return v-str-result.
     1561   END FUNCTION.
