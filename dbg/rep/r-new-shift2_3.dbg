     2320       loc-grp-only-not-single = 0
     2321       loc-income-ii           = 0
     2322       loc-income-sug-ii       = 0
     2323       curr-real-ii            = 1.
     2324     FIND LAST treal-2 NO-LOCK WHERE
     2325       treal-2.gds-code = t-2.gds-code AND
     2326       treal-2.is-pay   = YES          USE-INDEX vi NO-ERROR.
     2327     if available treal-2 then
     2328     do:
     2329       assign
     2330         loc-real-ii  = treal-2.ii + 1
