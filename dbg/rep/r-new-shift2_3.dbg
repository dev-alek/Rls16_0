     2236   define temp-table t-2-not-sug like t-2 .
     2237   define temp-table t-2-sug like t-2 .
     2238   define variable loc-grp-only-not-single as integer no-undo .
     2239   define variable v-delta                 as integer no-undo .
     2240   define buffer buf_shift-pgds     for shift-pgdst.
     2241   define buffer buf_shift-pgds-in  for shift-pgds-int.
     2242   define buffer buf_shift-pgds-out for shift-pgds-outt.
     2243   define buffer buf_cash-pay       for ub.cash-pay.
     2244   define stream Out-Stream.
     2245   define stream OutStr-html.
     2246     procedure on-same-page :
     2247       define input parameter p-line-number as integer no-undo .
     2248       if p-line-number > page-size( PrnLibstream )
     2249       then do:
     2250         return .
     2251       end.
     2252       if line-counter( PrnLibstream ) + p-line-number > page-size( PrnLibstream )
     2253       then do:
     2254         page stream PrnLibstream .
     2255       end.
     2256     end procedure.
     2257   FUNCTION get-grp-name-code RETURNS INTEGER
     2258     ( INPUT p-cdpay-code AS integer, INPUT p-curr-code AS INTEGER, output p-grp-name as character ) :
     2259     DEFINE VARIABLE v-dopi  AS INTEGER   NO-UNDO INIT ?.
     2260     DEFINE VARIABLE v-value AS character NO-UNDO.
     2261     DEFINE VARIABLE v-type  AS character NO-UNDO.
     2262     RUN cp-attr-value  IN THIS-PROCEDURE(
     2263       input p-cdpay-code
     2264       ,input p-curr-code
     2265       ,input 0
     2266       ,input '':U
     2267       ,input 0
     2268       ,INPUT 'grp-code':U
     2269       ,output v-value
     2270       ,OUTPUT v-type) NO-ERROR.
     2271     IF NOT ERROR-STATUS:ERROR THEN
     2272     DO:
     2273       ASSIGN
     2274         v-dopi     = INTEGER(entry(2, v-value, chr(4)))
     2275         p-grp-name = entry(1, v-value, chr(4) )
     2276         NO-ERROR.
     2277     END.
     2278     RETURN v-dopi.
     2279   END FUNCTION.
     2280   run rep/r-shft2r.p ( input p-obj-type
     2281     ,input p-obj-code
     2282     ,input X-date-Start
