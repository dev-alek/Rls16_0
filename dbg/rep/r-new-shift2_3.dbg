      720   PROCEDURE create-treal-2.
      721   DEFINE INPUT PARAMETER pgds-code like ub.goods.gds-code no-undo.
      722   DEFINE INPUT PARAMETER pcpay-code like ub.cash-pay.cdpay-code no-undo.
      723   DEFINE INPUT PARAMETER pcurr-code like ub.cash-pay.curr-code no-undo.
      724   DEFINE INPUT PARAMETER pqnty1 as decimal no-undo.
      725   DEFINE INPUT PARAMETER pqnty2 as decimal no-undo.
      726   DEFINE INPUT PARAMETER pnetto as decimal no-undo.
      727   DEFINE INPUT PARAMETER pout-name as character no-undo.
      728   DEFINE INPUT PARAMETER pis-pay as logical no-undo.
      729   DEFINE INPUT PARAMETER pii as integer no-undo.
      730   _main:
      731   DO ON ERROR UNDO _main, return error:
      732       create treal-2.
      733       assign
      734       treal-2.gds-code = pgds-code
      735       treal-2.cpay-code = pcpay-code
      736       treal-2.curr-code = pcurr-code
      737       treal-2.qnty1  =  pqnty1
      738       treal-2.qnty2  = pqnty2
      739       treal-2.netto = pnetto
      740       treal-2.out-name = pout-name
      741       treal-2.is-pay = pis-pay
      742       treal-2.ii = pii
      743       treal-2.discnt-type = -99
      744       no-error
      745       .
      746       if error-status:error then undo _main, return error.
      747   END.
      748   END PROCEDURE.
      749   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
