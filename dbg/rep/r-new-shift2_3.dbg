     1310   end procedure.
     1311   define buffer grptreal-2 for treal-2.
     1312   define buffer nottreal-2 for treal-2.
     1313   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1314   PROCEDURE create-grptreal-2.
     1315   DEFINE INPUT PARAMETER pgds-code like ub.goods.gds-code no-undo.
     1316   DEFINE INPUT PARAMETER pcpay-code like ub.cash-pay.cdpay-code no-undo.
     1317   DEFINE INPUT PARAMETER pcurr-code like ub.cash-pay.curr-code no-undo.
     1318   DEFINE INPUT PARAMETER pqnty1 as decimal no-undo.
     1319   DEFINE INPUT PARAMETER pqnty2 as decimal no-undo.
     1320   DEFINE INPUT PARAMETER pnetto as decimal no-undo.
     1321   DEFINE INPUT PARAMETER pout-name as character no-undo.
     1322   DEFINE INPUT PARAMETER pis-pay as logical no-undo.
     1323   DEFINE INPUT PARAMETER pii as integer no-undo.
     1324   _main:
     1325   DO ON ERROR UNDO _main, return error:
     1326       create grptreal-2.
     1327       assign
     1328       grptreal-2.gds-code = pgds-code
     1329       grptreal-2.cpay-code = pcpay-code
     1330       grptreal-2.curr-code = pcurr-code
     1331       grptreal-2.qnty1  =  pqnty1
     1332       grptreal-2.qnty2  = pqnty2
     1333       grptreal-2.netto = pnetto
     1334       grptreal-2.out-name = pout-name
     1335       grptreal-2.is-pay = pis-pay
     1336       grptreal-2.ii = pii
     1337       grptreal-2.discnt-type = -99
     1338       no-error
     1339       .
     1340       if error-status:error then undo _main, return error.
     1341   END.
     1342   END PROCEDURE.
