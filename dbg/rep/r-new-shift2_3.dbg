       18   define variable vss-revision    as character no-undo initial "$Revision$":U.
       19   define variable vss-author      as character no-undo initial "$Author$":U.
       20   define variable vss-date        as character no-undo initial "$Date$":U.
       21   define variable vss-workfile    as character no-undo initial "$Workfile$":U.
       22   define variable vss-archive     as character no-undo initial "$Archive$":U.
