     2676         end.
     2677         run create-treal-2 in this-procedure ( input t-2-sug.gds-code,
     2678                                                input 0,
     2679                                                input 0,
     2680                                                input areal-no-pay-qnty1,
     2681                                                input areal-no-pay-qnty2,
     2682                                                input areal-no-pay-netto,
     2683                                                input "ИТОГО ПРОЧ.РАСХОД",
     2684                                                input no,
     2685                                                input curr-real-ii         ) no-error.
     2686         assign curr-real-ii = curr-real-ii + 1.
     2687         run create-treal-2 in this-procedure ( input t-2-sug.gds-code,
     2688                                                input 0,
     2689                                                input 0,
     2690                                                input areal-qnty1,
     2691                                                input areal-qnty2,
     2692                                                input areal-netto,
     2693                                                input "ВСЕГО РАСХОД ",
     2694                                                input ?,
     2695                                                input curr-real-ii     ) no-error.
     2696       end.
     2697     END.
     2698     for EACH tincome-2 WHERE
     2699       tincome-2.gds-code = t-2-sug.gds-code
     2700       USE-INDEX vi
     2701       :
     2702       if tincome-2.supp-name = "Итого по поставщику" then
     2703       do:
     2704         assign
     2705           loc-income-sug-ii = tincome-2.ii .
     2706         next.
     2707       end.
     2708       assign
     2709         aincome-sug-qnty1 = aincome-sug-qnty1 + round(tincome-2.qnty1,2)
     2710         aincome-sug-qnty2 = aincome-sug-qnty2 + round(tincome-2.qnty2,2)
     2711         aincome-sug-qnty3 = aincome-sug-qnty3 + round(tincome-2.qnty3,2)
     2712         loc-income-sug-ii = tincome-2.ii
     2713         .
     2714     END.
     2715     if loc-income-sug-ii > 1 then
     2716     do:
     2717       run create-tincome-2 in this-procedure ( input t-2-sug.gds-code,
     2718         input "",
     2719         input aincome-sug-qnty1,
     2720         input aincome-sug-qnty2,
     2721         input aincome-sug-qnty3,
     2722         input "ИТОГО ПОСТУПЛЕНИЙ",
     2723         input 0,
     2724         input no,
     2725         input ( loc-income-sug-ii + 1 ) ) no-error.
     2726       assign
     2727         loc-income-sug-ii = loc-income-sug-ii + 1.
     2728     end.
     2729     assign
     2730       t-2-sug.lines = MAX( curr-real-ii - loc-grp-only-not-single
     2731                           , loc-income-sug-ii, 1 ).
     2732   end.
     2733   run print-total .
     2734   run print-sug .
     2735   procedure print-total .
     2736     output stream OutStr-html to value(v-report-name-html) append convert target 'UTF-8' .
     2737     put stream OutStr-html unformatted
     2738       substitute (
     2739       '<tbody> <!-- Здесь начинается таблица отчета --> 
     2740                   <tr> <!-- Первые строки – шапка таблицы с тэгами tr -->                                 
     2741                   <th text_wrap="true" colspan="17" style="text-align: center;">Нефтепродукты: бензины и ДТ</th>                  
     2742               </tr>                                                                                       
     2743                                              
     2744                   <tr> <!-- Первые строки – шапка таблицы с тэгами tr -->                                 
     2745                   <th text_wrap="true" colspan="3" style="text-align: center;">Информация о продукте</th>                  
     2746                   <th text_wrap="true" colspan="6" style="text-align: center;">Расшифровка поступления</th>                
     2747                   <th text_wrap="true" colspan="7" style="text-align: center;">Расшифровка реализации</th>                 
     2748                   <th text_wrap="true" rowspan="3" style="text-align: center;">Остаток на конец кг</th>                       
     2749               </tr>                                                                                       
     2750               <tr>                                                                                        
     2751                   <th text_wrap="true" rowspan="2" style="text-align: center;">Наименование продукта</th>                  
     2752                   <th text_wrap="true" rowspan="2" style="text-align: center;">Цена розничная на конец смены</th>          
     2753                   <th text_wrap="true" rowspan="2" style="text-align: center;">Остаток на начало кг</th>                      
     2754                   <th text_wrap="true"             style="text-align: center;">Поставщик</th>                              
     2755                   <th text_wrap="true" rowspan="2" style="text-align: center;">Номер документа прихода (ТТН)</th>          
     2756                   <th text_wrap="true" rowspan="2" style="text-align: center;">Количество кг/л</th>                             
     2757                   <th text_wrap="true" rowspan="2" style="text-align: center;">Плотность кг/м3</th>  
     2758                   <th text_wrap="true" rowspan="2" style="text-align: center;">ЕУ кг.</th>                         
     2759                   <th text_wrap="true" rowspan="2" style="text-align: center;">Т в гр.°С</th>         
     2760                   <th text_wrap="true" rowspan="2" style="text-align: center;">Тип расхода (тип платежа)</th>              
     2761                   <th text_wrap="true" rowspan="2" style="text-align: center;">Кол-во в литрах</th>                        
     2762                   <th text_wrap="true" rowspan="2" style="text-align: center;">Кол-во в кг</th>                    
     2763                   <th text_wrap="true" rowspan="2" style="text-align: center;">Сумма</th>
     2764                   <th text_wrap="true" rowspan="2" style="text-align: center;">Сумма скидки</th>                 
     2765                   <th text_wrap="true" rowspan="2" style="text-align: center;">Сумма брутто</th>                 
     2766                   <th text_wrap="true" rowspan="2" style="text-align: center;">Кол-во чеков</th>                                                   
     2767               </tr>                                                                                       
     2768               <tr>                                                                                        
     2769                   <th text_wrap="true" style="text-align: center;">Наименование</th>                                       
     2770               </tr>                                                                                       
     2771               <tr>                                                                                        
     2772                   <th style="text-align: center;">2.1</th>                                                  
     2773                   <th style="text-align: center;">2.2</th>                                                  
     2774                   <th style="text-align: center;">2.3</th>                                                  
     2775                   <th style="text-align: center;">2.4</th>                                                  
     2776                   <th style="text-align: center;">2.5</th>                                                  
     2777                   <th style="text-align: center;">2.6</th>                                                  
     2778                   <th style="text-align: center;">2.7</th>                                                  
     2779                   <th style="text-align: center;">2.8</th>                                                  
     2780                   <th style="text-align: center;">2.9</th>                                                  
     2781                   <th style="text-align: center;">2.10</th>                                                 
     2782                   <th style="text-align: center;">2.11</th>                                                 
     2783                   <th style="text-align: center;">2.12</th>                                                 
     2784                   <th style="text-align: center;">2.13</th>                                                 
     2785                   <th style="text-align: center;">2.14</th>                                                 
     2786                   <th style="text-align: center;">2.15</th>                                                 
     2787                   <th style="text-align: center;">2.16</th>                                                 
     2788                   <th style="text-align: center;">2.17</th>                                                 
     2789               </tr>'
     2790       , chr(123), chr(125)
     2791       ).
     2792     for each actreal-2 :
     2793       delete actreal-2 .
     2794     end.
     2795     FOR EACH t-2-not-sug NO-LOCK
     2796       BREAK
     2797       BY t-2-not-sug.main-code:
     2798       v-delta = 0.
     2799       DO jj = 1 TO t-2-not-sug.lines :
     2800         assign
     2801           pol1      = "":U
     2802           pol2      = 0
     2803           pol3      = 0
     2804           pol4      = 0
     2805           pol5      = "":U
     2806           pol6      = "":U
     2807           pol7      = 0
     2808           pol8      = 0
     2809           pol9      = 0
     2810           pol10     = ?
     2811           pol11     = "":U
     2812           pol12     = 0
     2813           pol13     = 0
     2814           pol14     = 0
     2815           pol15     = 0
     2816           pol16     = 0
     2817           pol17     = 0
     2818           pol18     = 0
     2819           pol19     = 0
     2820           main-line = no
     2821           supp-line = no
     2822           pay-line  = no.
     2823         IF jj = 1 then
     2824         do:
     2825           assign
     2826             pol1      = t-2-not-sug.gds-name
     2827             pol2      = t-2-not-sug.last-price
     2828             pol3      = t-2-not-sug.qnty1-before
     2829             pol4      = t-2-not-sug.qnty2-before
     2830             pol18     = t-2-not-sug.qnty1-after
     2831             pol19     = t-2-not-sug.qnty2-after
     2832             main-line = yes.
     2833           if p-batch > 0
     2834             then
     2835           do:
     2836             find first buf_shift-pgds where
     2837               buf_shift-pgds.obj-type = p-obj-type
     2838               and buf_shift-pgds.obj-code = p-obj-code
     2839               and buf_shift-pgds.shift-date = X-date-end
     2840               and buf_shift-pgds.shift-num = X-shift-end
     2841               and buf_shift-pgds.gds-code = t-2-not-sug.gds-code no-error.
     2842             if available buf_shift-pgds then
     2843             do:
     2844               assign
     2845                 buf_shift-pgds.end-price-sale = t-2-not-sug.last-price
     2846                 .
     2847               release buf_shift-pgds.
     2848             end.
     2849           end.
     2850         END.
     2851         FIND FIRST tincome-2 NO-LOCK WHERE
     2852           tincome-2.gds-code = t-2-not-sug.gds-code AND
     2853           tincome-2.ii       = jj           NO-ERROR.
     2854         IF AVAIlABLE tincome-2 THEN
     2855         DO:
     2856   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input tincome-2.doc-code ,
     2857                           input 'nids':U ,
     2858                          output v-attr-value ,
     2859                          output v-attr-type )  .
     2860           assign
     2861             pol6       = if v-attr-value = "" or v-attr-value = ?
     2862                  then tincome-2.doc-code
     2863                  else v-attr-value
     2864             pol8-excel = if v-attr-value = "" or v-attr-value = ?
     2865                  then tincome-2.doc-code
     2866                  else '="' + v-attr-value + '"'
     2867             .
     2868           ASSIGN
     2869             pol5      = tincome-2.supp-name
     2870             pol7      = round(tincome-2.qnty1,2)
     2871             pol8      = tincome-2.density
     2872             pol9      = round(tincome-2.qnty2,2)
     2873             pol10     = tincome-2.temperature
     2874             supp-line = yes.
     2875           if p-batch > 0
     2876             and tincome-2.supp-code > 0
     2877             and tincome-2.gds-code > 0
     2878             then
     2879           do:
     2880             find first buf_shift-pgds-in where
     2881               buf_shift-pgds-in.obj-type = p-obj-type
     2882               and buf_shift-pgds-in.obj-code = p-obj-code
     2883               and buf_shift-pgds-in.shift-date = X-date-end
     2884               and buf_shift-pgds-in.shift-num = X-shift-end
     2885               and buf_shift-pgds-in.gds-code = t-2-not-sug.gds-code
     2886               and buf_shift-pgds-in.doc-code = tincome-2.doc-code no-error.
     2887             if not available buf_shift-pgds-in then
     2888             do:
     2889               create buf_shift-pgds-in.
     2890               assign
     2891                 buf_shift-pgds-in.obj-type      = p-obj-type
     2892                 buf_shift-pgds-in.obj-code      = p-obj-code
     2893                 buf_shift-pgds-in.shift-date    = X-date-end
     2894                 buf_shift-pgds-in.shift-num     = X-shift-end
     2895                 buf_shift-pgds-in.gds-code      = t-2-not-sug.gds-code
     2896                 buf_shift-pgds-in.doc-code      = tincome-2.doc-code
     2897                 buf_shift-pgds-in.cli-type-code = substitute("&1&2", tincome-2.supp-type, tincome-2.supp-code)
     2898                 buf_shift-pgds-in.cli-name      = tincome-2.supp-name
     2899                 buf_shift-pgds-in.fact-qnty     = tincome-2.qnty1
     2900                 buf_shift-pgds-in.fact-qnty-2   = tincome-2.qnty2
     2901                 .
     2902               release buf_shift-pgds-in.
     2903             end.
     2904           end.
     2905         END.
     2906         _not-empty-group:
     2907         do while true :
     2908           FIND FIRST treal-2 NO-LOCK WHERE
     2909             treal-2.gds-code = t-2-not-sug.gds-code AND
     2910             treal-2.ii       = jj + v-delta          NO-ERROR.
     2911           if not available treal-2 then
     2912           do:
     2913             put stream OutStr-html unformatted
     2914               substitute (
     2915               '  
     2916               <tr>
     2917                       <td rowspan="2" text_wrap="true">&1</td>
     2918                       <td text_wrap="true" rowspan="2" style="text-align: right;">&2</td>
     2919                       <td text_wrap="true" rowspan="2" style="text-align: right;">&3</td>
     2920                       <td text_wrap="true" rowspan="2" style="text-align: left;">&5</td>
     2921                       <td text_wrap="true" rowspan="2">&6</td>
     2922                       <td text_wrap="true" style="text-align: right;">&8</td>
     2923                       <td text_wrap="true" rowspan="2" style="text-align: right;">&7</td>
     2924                       <td text_wrap="true" rowspan="2" style="text-align: right;"></td>
     2925                       <td text_wrap="true" rowspan="2" style="text-align: right;">&4</td>'
     2926               ,
     2927               pol1,
     2928               if main-line = no then "" else string(pol2,"->>>>>>>>>>>9.99"),
     2929               if main-line = no then "" else string(pol4,"->>>>>>>>>>>9.99"),
     2930               if pol10 = ? or pol6 = "" then "" else string(pol10,"->>>>>>>>>>>9"),
     2931               if supp-line = no then "" else pol5,
     2932               if pol6 = "" then "" else string(pol6),
     2933               if supp-line = no or pol8 = ? or pol6 = "" then "" else string(pol8,">>>>>>>>>>>9.9999"),
     2934               if supp-line = no then "" else string(pol9,"->>>>>>>>>>>9.99")
     2935               ).
     2936             put stream OutStr-html unformatted
     2937               substitute (
     2938               '
     2939                       <td text_wrap="true" rowspan="2" style="text-align: right;">&1</td>
     2940                       <td text_wrap="true" rowspan="2" >&2</td>
     2941                       <td text_wrap="true" rowspan="2" style="text-align: right;">&3</td>
     2942                       <td text_wrap="true" rowspan="2" style="text-align: right;">&4</td>
     2943                       <td text_wrap="true" rowspan="2" style="text-align: right;">&5</td>
     2944                       <td text_wrap="true" rowspan="2" style="text-align: right;">&6</td>
     2945                       <td text_wrap="true" rowspan="2" style="text-align: right;">&7</td>
     2946                       <td rowspan="2" text_wrap="true" style="text-align: right;">&8</td> 
     2947                       </tr>
     2948                  '
     2949               ,
     2950               if pay-line = no then "" else pol11,
     2951               if pay-line = no then "" else string(pol12,"->>>>>>>>>>>9.99"),
     2952               if pay-line = no then "" else string(pol13,"->>>>>>>>>>>9.99"),
     2953               if pay-line = no then "" else string(pol14,"->>>>>>>>>>>9.99"),
     2954               if pay-line = no or pol15 = 0 then "" else string(pol15,"->>>>>>>>>>>9.99"),
     2955               if pay-line = no or pol16 = 0 then "" else string(pol16,"->>>>>>>>>>>9.99"),
     2956               if main-line = no or pol17 = 0 then "" else string(pol17,"->>>>>>>>>>>9.99"),
     2957               if main-line = no then "" else string(pol19,"->>>>>>>>>>>9.99")
     2958               ).
     2959             put stream OutStr-html unformatted
     2960               substitute (
     2961               '
     2962                       <tr>
     2963                       
     2964                       <td text_wrap="true" style="text-align: right;">&2</td>
     2965                       
     2966                       </tr>
     2967                  '
     2968               ,
     2969               if main-line = no then "" else string(pol3,"->>>>>>>>>>>9.99"),
     2970               if supp-line = no then "" else string(pol7,">>>>>>>>>>>9.99"),
     2971               if main-line = no then "" else string(pol18,"->>>>>>>>>>>9.99")
     2972               ).
     2973             leave _not-empty-group.
     2974           end.
     2975           if available treal-2 then
     2976           do:
     2977             if (treal-2.cpay-code <> 0
     2978               or treal-2.curr-code= - 1) and treal-2.discnt-type = -99
     2979               then
     2980             do:
     2981               FIND FIRST actreal-2 WHERE
     2982                 actreal-2.gds-code = 0 AND
     2983                 actreal-2.cpay-code = treal-2.cpay-code AND
     2984                 actreal-2.curr-code = treal-2.curr-code AND
     2985                 actreal-2.is-pay = treal-2.is-pay NO-ERROR.
     2986               if not available actreal-2 then
     2987               do:
     2988                 assign
     2989                   acii = acii + 1.
     2990                 run create-actreal-2 in this-procedure ( input 0,
     2991                   input treal-2.cpay-code,
     2992                   input treal-2.curr-code,
     2993                   input treal-2.qnty1,
     2994                   input treal-2.qnty2,
     2995                   input treal-2.netto,
     2996                   input trim(treal-2.out-name, chr(4)),
     2997                   input treal-2.is-pay,
     2998                   input acii               ) no-error.
     2999               end.
     3000               else
     3001               do:
     3002                 assign
     3003                   actreal-2.qnty1 = actreal-2.qnty1 + round(treal-2.qnty1,2)
     3004                   actreal-2.qnty2 = actreal-2.qnty2 + round(treal-2.qnty2,2)
     3005                   actreal-2.netto = actreal-2.netto + round(treal-2.netto,2).
     3006               end.
     3007             end.
     3008             if treal-2.is-pay = yes
     3009               and treal-2.curr-code < 0
     3010               and treal-2.out-name begins chr(4) then
     3011             do:
     3012               assign
     3013                 v-delta = v-delta + 1
     3014                 .
     3015               next _not-empty-group.
     3016             end.
     3017             else
     3018             do:
     3019               assign
     3020                 pol11    = treal-2.out-name
     3021                 pol12    = treal-2.qnty1
     3022                 pol13    = treal-2.qnty2
     3023                 pol14    = treal-2.netto
     3024                 pol15    = treal-2.discount-sum
     3025                 pol16    = treal-2.brutto
     3026                 pol17    = treal-2.chk-qnty
     3027                 pay-line = yes
     3028                 .
     3029               if p-batch > 0
     3030                 and (treal-2.curr-code > 0
     3031                 or not (treal-2.curr-code = 0 and treal-2.cpay-code = 0)
     3032                 )
     3033                 and treal-2.gds-code > 0
     3034                 then
     3035               do:
     3036                 find first buf_shift-pgds-out where
     3037                   buf_shift-pgds-out.obj-type = p-obj-type
     3038                   and buf_shift-pgds-out.obj-code = p-obj-code
     3039                   and buf_shift-pgds-out.shift-date = X-date-end
     3040                   and buf_shift-pgds-out.shift-num = X-shift-end
     3041                   and buf_shift-pgds-out.gds-code = treal-2.gds-code
     3042                   and buf_shift-pgds-out.pay-code = treal-2.cpay-code
     3043                   and buf_shift-pgds-out.curr-code = treal-2.curr-code
     3044                   no-error.
     3045                 if not available buf_shift-pgds-out then
     3046                 do:
     3047                   find first buf_cash-pay no-lock where
     3048                     buf_cash-pay.cdpay-code = treal-2.cpay-code
     3049                     and  buf_cash-pay.curr-code = treal-2.curr-code no-error.
     3050                   create buf_shift-pgds-out.
     3051                   assign
     3052                     buf_shift-pgds-out.obj-type    = p-obj-type
     3053                     buf_shift-pgds-out.obj-code    = p-obj-code
     3054                     buf_shift-pgds-out.shift-date  = X-date-end
     3055                     buf_shift-pgds-out.shift-num   = X-shift-end
     3056                     buf_shift-pgds-out.gds-code    = treal-2.gds-code
     3057                     buf_shift-pgds-out.pay-code    = treal-2.cpay-code
     3058                     buf_shift-pgds-out.curr-code   = treal-2.curr-code
     3059                     buf_shift-pgds-out.out-name    = treal-2.out-name
     3060                     buf_shift-pgds-out.cp-type     = (if available buf_cash-pay
     3061                                               and buf_cash-pay.is-cash
     3062                                               then 1
     3063                                               else 2)
     3064                     buf_shift-pgds-out.fact-qnty   = treal-2.qnty1
     3065                     buf_shift-pgds-out.fact-qnty-2 = treal-2.qnty2
     3066                     buf_shift-pgds-out.fact-sum    = treal-2.netto
     3067                     .
     3068                   .
     3069                 end.
     3070               end.
     3071               put stream OutStr-html unformatted
     3072                 substitute (
     3073                 '  <tr>
     3074                       <td rowspan="2" text_wrap="true">&1</td>
     3075                       <td text_wrap="true" rowspan="2" style="text-align: right;">&2</td>
     3076                       <td text_wrap="true" rowspan="2" style="text-align: right;">&3</td>
     3077                       <td text_wrap="true" rowspan="2" style="text-align: left;">&5</td>
     3078                       <td text_wrap="true" rowspan="2">&6</td>
     3079                       <td text_wrap="true" style="text-align: right;">&8</td>
     3080                       <td text_wrap="true" rowspan="2" style="text-align: right;">&7</td>
     3081                       <td text_wrap="true" rowspan="2" style="text-align: right;"></td>
     3082                       <td text_wrap="true" rowspan="2" style="text-align: right;">&4</td>'
     3083                 ,
     3084                 pol1,
     3085                 if main-line = no then "" else string(pol2,"->>>>>>>>>>>9.99"),
     3086                 if main-line = no then "" else string(pol4,"->>>>>>>>>>>9.99"),
     3087                 if pol10 = ? or pol6 = "" then "" else string(pol10,"->>>>>>>>>>>9"),
     3088                 if supp-line = no then "" else pol5,
     3089                 if pol6 = "" then "" else string(pol6),
     3090                 if supp-line = no or pol8 = ? or pol6 = "" then "" else string(pol8,">>>>>>>>>>>9.9999"),
     3091                 if supp-line = no then "" else string(pol9,"->>>>>>>>>>>9.99")
     3092                 ).
     3093               put stream OutStr-html unformatted
     3094                 substitute (
     3095                 '
     3096                       <td text_wrap="true" rowspan="2" style="text-align: right;">&1</td>
     3097                       <td text_wrap="true" rowspan="2" >&2</td>
     3098                       <td text_wrap="true" rowspan="2" style="text-align: right;">&3</td>
     3099                       <td text_wrap="true" rowspan="2" style="text-align: right;">&4</td>
     3100                       <td text_wrap="true" rowspan="2" style="text-align: right;">&5</td>
     3101                       <td text_wrap="true" rowspan="2" style="text-align: right;">&6</td>
     3102                       <td text_wrap="true" rowspan="2" style="text-align: right;">&7</td>
     3103                       <td rowspan="2" text_wrap="true" style="text-align: right;">&8</td>
     3104                       </tr>
     3105                  '
     3106                 ,
     3107                 if pay-line = no then "" else pol11,
     3108                 if pay-line = no then "" else string(pol12,"->>>>>>>>>>>9.99"),
     3109                 if pay-line = no then "" else string(pol13,"->>>>>>>>>>>9.99"),
     3110                 if pay-line = no then "" else string(pol14,"->>>>>>>>>>>9.99"),
     3111                 if pay-line = no or pol15 = 0 then "" else string(pol15,"->>>>>>>>>>>9.99"),
     3112                 if pay-line = no or pol16 = 0 then "" else string(pol16,"->>>>>>>>>>>9.99"),
     3113                 if  pol17 = 0 then "" else string(pol17,"->>>>>>>>>>>9.99"),
     3114                 if main-line = no then "" else string(pol19,"->>>>>>>>>>>9.99")
     3115                 ).
     3116               put stream OutStr-html unformatted
     3117                 substitute (
     3118                 '
     3119                       <tr>
     3120                       
     3121                       <td text_wrap="true" style="text-align: right;">&2</td>
     3122                       
     3123                       </tr>
     3124                  '
     3125                 ,
     3126                 if main-line = no then "" else string(pol3,"->>>>>>>>>>>9.99"),
     3127                 if supp-line = no then "" else string(pol7,">>>>>>>>>>>9.99"),
     3128                 if main-line = no then "" else string(pol18,"->>>>>>>>>>>9.99")
     3129                 ).
     3130               leave _not-empty-group.
     3131             end.
     3132           end.
     3133         end.
     3134         if jj <= t-2-not-sug.lines then
     3135           if main-line = yes then
     3136           do:
     3137             assign
     3138               accum-4  = accum-4  + round(pol3,2)
     3139               accum-5  = accum-5  + round(pol4,2)
     3140               accum-17 = accum-17 + round(pol18,2)
     3141               accum-18 = accum-18 + round(pol19,2).
     3142           end.
     3143         if supp-line = yes then
     3144         do:
     3145           if tincome-2.is-fact = yes then
     3146           do:
     3147             assign
     3148               accum-9  = accum-9  + round(pol7,2)
     3149               accum-11 = accum-11 + round(pol9,2).
     3150           end.
     3151         end.
     3152         if pay-line = yes then
     3153         do:
     3154           if treal-2.cpay-code <> 0
     3155             and treal-2.curr-code <>  - 1
     3156             then
     3157           do:
     3158             if treal-2.discnt-type = -99 or treal-2.cpay-code < 0 then
     3159             do:
     3160               assign
     3161                 accum-14 = accum-14 + round(pol12,2)
     3162                 accum-15 = accum-15 + round(pol13,2)
     3163                 accum-16 = accum-16 + round(pol14,2).
     3164             end.
     3165           end.
     3166         end.
     3167       END.
     3168       IF LAST( t-2-not-sug.main-code ) THEN
     3169       DO:
     3170         assign
     3171           pol1  = "ИТОГО"
     3172           pol3  = accum-4
     3173           pol4  = accum-5
     3174           pol7  = accum-9
     3175           pol9  = accum-11
     3176           POL11 = "ИТОГО РАСХОД"
     3177           pol12 = accum-14
     3178           pol13 = accum-15
     3179           pol14 = accum-16
     3180           pol18 = accum-17
     3181           pol19 = accum-18.
     3182         put stream OutStr-html unformatted
     3183           substitute (
     3184           '  <tr>
     3185                       <th text_wrap="true" rowspan="2" style="text-align: left; vertical-align: middle;">&1</th>
     3186                       <th text_wrap="true" rowspan="2"></th>
     3187                       <th text_wrap="true" rowspan="2" style="text-align: right; vertical-align: middle;">&2</th>
     3188                       <th text_wrap="true" rowspan="2" style="text-align: left; vertical-align: middle;">&3</th>
     3189                       <th rowspan="2"></th>
     3190                       <th text_wrap="true" style="text-align: right; vertical-align: middle;">&4</th>
     3191                       <th rowspan="2"></th>
     3192                       <th rowspan="2"></th>
     3193                       <th rowspan="2"></th>
     3194                       <th text_wrap="true" rowspan="2" style="text-align: right; vertical-align: middle;">&5</th>
     3195                       <th text_wrap="true" rowspan="2" style="vertical-align: middle;">&6</th>
     3196                       <th text_wrap="true" rowspan="2" style="text-align: right; vertical-align: middle;">&7</th>
     3197                       <th text_wrap="true" rowspan="2" style="text-align: right; vertical-align: middle;">&8</th>
     3198                       <th text_wrap="true" rowspan="2" style="text-align: right; vertical-align: middle;"></th>
     3199                       '
     3200           ,
     3201           pol1,
     3202           string(pol4,"->>>>>>>>>>>9.99"),
     3203           pol5,
     3204           string(pol9,"->>>>>>>>>>>9.99"),
     3205           pol11,
     3206           string(pol12,"->>>>>>>>>>>9.99"),
     3207           string(pol13,"->>>>>>>>>>>9.99"),
     3208           string(pol14,"->>>>>>>>>>>9.99"),
     3209           string(pol15,"->>>>>>>>>>>9.99")
     3210           ).
     3211         put stream OutStr-html unformatted
     3212           substitute (
     3213           '
     3214               <th text_wrap="true" rowspan="2" style="text-align: right; vertical-align: middle;"></th>
     3215               <th text_wrap="true" rowspan="2" style="text-align: right; vertical-align: middle;"></th>
     3216               <th rowspan="2" text_wrap="true" style="text-align: right; vertical-align: middle;">&3</th>
     3217               </tr><tr>
     3218               
     3219               <th text_wrap="true" style="text-align: right; vertical-align: middle;">&5</th>
     3220               
     3221                  </tr>'
     3222           ,
     3223           string(pol16,"->>>>>>>>>>>9.99"),
     3224           string(pol17,"->>>>>>>>>>>9.99"),
     3225           string(pol19,"->>>>>>>>>>>9.99"),
     3226           string(pol3,"->>>>>>>>>>>9.99"),
     3227           string(pol7,"->>>>>>>>>>>9.99"),
     3228           string(pol18,"->>>>>>>>>>>9.99")
     3229           ).
     3230         if can-find( first actreal-2 no-lock ) then
     3231         do:
     3232           assign
     3233             pol11 = "     в том числе:".
     3234           put stream OutStr-html unformatted
     3235             substitute (
     3236             '  <tr>
     3237                       <th></th>
     3238                       <th></th>
     3239                       <th></th>
     3240                       <th></th>
     3241                       <th></th>
     3242                       <th></th>
     3243                       <th></th>
     3244                       <th></th>
     3245                       <th></th>
     3246                       <th text_wrap="true">&1</th>
     3247                       <th></th>
     3248                       <th></th>
     3249                       <th></th>
     3250                       <th></th>
     3251                       <th></th>
     3252                       <th></th>
     3253                       <th></th>
     3254                   </tr>'
     3255             ,
     3256             pol11
     3257             ).
     3258           assign
     3259             areal-is-pay-qnty1 = 0
     3260             areal-is-pay-qnty2 = 0
     3261             areal-is-pay-netto = 0
     3262             areal-no-pay-qnty1 = 0
     3263             areal-no-pay-qnty2 = 0
     3264             areal-no-pay-netto = 0.
     3265           FOR EACH actreal-2 NO-LOCK
     3266             BREAK
     3267             BY actreal-2.gds-code
     3268             By actreal-2.is-pay    DESCENDING
     3269             BY actreal-2.cpay-code DESCENDING
     3270             BY actreal-2.curr-code :
     3271             if actreal-2.is-pay = yes then
     3272             do:
     3273               if actreal-2.curr-code >= 0 then
     3274                 assign areal-is-pay-qnty1 = areal-is-pay-qnty1 + round(actreal-2.qnty1,2)
     3275                   areal-is-pay-qnty2 = areal-is-pay-qnty2 + round(actreal-2.qnty2,2)
     3276                   areal-is-pay-netto = areal-is-pay-netto + round(actreal-2.netto,2).
     3277             end.
     3278             else
     3279             do:
     3280               assign
     3281                 areal-no-pay-qnty1 = areal-no-pay-qnty1 + round(actreal-2.qnty1,2)
     3282                 areal-no-pay-qnty2 = areal-no-pay-qnty2 + round(actreal-2.qnty2,2)
     3283                 areal-no-pay-netto = areal-no-pay-netto + round(actreal-2.netto,2) .
     3284             end.
     3285             assign
     3286               pol11 = actreal-2.out-name
     3287               pol12 = actreal-2.qnty1
     3288               pol13 = actreal-2.qnty2
     3289               pol14 = actreal-2.netto
     3290               pol15 = actreal-2.brutto
     3291               pol16 = actreal-2.discount-sum
     3292               pol17 = actreal-2.chk-qnty.
     3293             put stream OutStr-html unformatted
     3294               substitute (
     3295               '  <tr>
     3296                       <th></th>
     3297                       <th></th>
     3298                       <th></th>
     3299                       <th></th>
     3300                       <th></th>
     3301                       <th></th>
     3302                       <th></th>
     3303                       <th></th>
     3304                       <th></th>
     3305                       <th text_wrap="true">&1</th>
     3306                       <th text_wrap="true" style="text-align: right; vertical-align: middle;">&2</th>
     3307                       <th text_wrap="true" style="text-align: right; vertical-align: middle;">&3</th>
     3308                       <th text_wrap="true" style="text-align: right; vertical-align: middle;">&4</th>
     3309                       <th text_wrap="true" style="text-align: right; vertical-align: middle;">&5</th>
     3310                       <th text_wrap="true" style="text-align: right; vertical-align: middle;">&6</th>
     3311                       <th text_wrap="true" style="text-align: right; vertical-align: middle;">&7</th>
     3312                       <th></th>
     3313                  </tr>'
     3314               ,
     3315               pol11,
     3316               string(pol12,"->>>>>>>>>>>9.99"),
     3317               string(pol13,"->>>>>>>>>>>9.99"),
     3318               string(pol14,"->>>>>>>>>>>9.99"),
     3319               if pol15 = 0 then "" else string(pol15,"->>>>>>>>>>>9.99"),
     3320               if pol16 = 0 then "" else string(pol16,"->>>>>>>>>>>9.99"),
     3321               if pol17 = 0 then "" else string(pol17,"->>>>>>>>>>>9.99")
     3322               ).
     3323             if last-of( actreal-2.is-pay )  then
     3324             do:
     3325               if actreal-2.discnt-type = -99 or actreal-2.cpay-code < 0 then
     3326               do:
     3327                 if actreal-2.is-pay = yes then
     3328                 do:
     3329                   assign
     3330                     pol11 = "ИТОГО ОПЛАЧ.РАСХОД"
     3331                     pol12 = areal-is-pay-qnty1
     3332                     pol13 = areal-is-pay-qnty2
     3333                     pol14 = areal-is-pay-netto.
     3334                 end.
     3335                 else
     3336                 do:
     3337                   assign
     3338                     pol11 = "ИТОГО ПРОЧ.РАСХОД"
     3339                     pol12 = areal-no-pay-qnty1
     3340                     pol13 = areal-no-pay-qnty2
     3341                     pol14 = areal-no-pay-netto.
     3342                 end.
     3343               end.
     3344               put stream OutStr-html unformatted
     3345                 substitute (
     3346                 '  <tr>
     3347                       <th></th>
     3348                       <th></th>
     3349                       <th></th>
     3350                       <th></th>
     3351                       <th></th>
     3352                       <th></th>
     3353                       <th></th>
     3354                       <th></th>
     3355                       <th></th>
     3356                       <th text_wrap="true">&1</th>
     3357                       <th text_wrap="true" style="text-align: right; vertical-align: middle;">&2</th>
     3358                       <th text_wrap="true" style="text-align: right; vertical-align: middle;">&3</th>
     3359                       <th text_wrap="true" style="text-align: right; vertical-align: middle;">&4</th>
     3360                       <th></th>
     3361                       <th></th>
     3362                       <th></th>
     3363                       <th></th>
     3364                  </tr>'
     3365                 ,
     3366                 pol11,
     3367                 string(pol12,"->>>>>>>>>>>9.99"),
     3368                 string(pol13,"->>>>>>>>>>>9.99"),
     3369                 string(pol14,"->>>>>>>>>>>9.99")
     3370                 ).
     3371             end.
     3372           END.
     3373         END.
     3374       END.
     3375     END.
     3376     put stream OutStr-html unformatted
     3377       substitute (
     3378       '
     3379           </tbody>
     3380           '
     3381       , chr(123), chr(125)
     3382       ).
     3383     output stream OutStr-html close.
     3384   end procedure .
     3385   procedure print-sug .
     3386     if can-find(t-2-sug) then do:
     3387     output stream OutStr-html to value(v-report-name-html) append convert target 'UTF-8' .
     3388     put stream OutStr-html unformatted
     3389       substitute (
     3390       '<tbody> <!-- Здесь начинается таблица отчета -->                                             
     3391               <tr> <!-- Первые строки – шапка таблицы с тэгами tr -->                                 
     3392                   <th text_wrap="true" colspan="17" style="text-align: center;">СУГ</th>                  
     3393               </tr>                                                                                       
     3394                   <tr> <!-- Первые строки – шапка таблицы с тэгами tr -->                                 
     3395                   <th text_wrap="true" colspan="3" style="text-align: center;">Информация о продукте</th>                  
     3396                   <th text_wrap="true" colspan="6" style="text-align: center;">Расшифровка поступления</th>                
     3397                   <th text_wrap="true" colspan="7" style="text-align: center;">Расшифровка реализации</th>                 
     3398                   <th text_wrap="true" rowspan="3" style="text-align: center;">Остаток на конец кг</th>                       
     3399               </tr>                                                                                       
     3400               <tr>                                                                                        
     3401                   <th text_wrap="true" rowspan="2" style="text-align: center;">Наименование продукта</th>                  
     3402                   <th text_wrap="true" rowspan="2" style="text-align: center;">Цена розничная на конец смены</th>          
     3403                   <th text_wrap="true" rowspan="2" style="text-align: center;">Остаток на начало кг</th>                      
     3404                   <th text_wrap="true" style="text-align: center;">Поставщик</th>                              
     3405                   <th text_wrap="true" rowspan="2" style="text-align: center;">Номер документа прихода (ТТН)</th>          
     3406                   <th text_wrap="true" colspan="4" style="text-align: center;">Количество</th>                             
     3407                   <th text_wrap="true" rowspan="2" style="text-align: center;">Тип расхода (тип платежа)</th>              
     3408                   <th text_wrap="true" rowspan="2" style="text-align: center;">Кол-во в литрах</th>                        
     3409                   <th text_wrap="true" rowspan="2" style="text-align: center;">Кол-во в кг</th>                    
     3410                   <th text_wrap="true" rowspan="2" style="text-align: center;">Сумма</th>
     3411                   <th text_wrap="true" rowspan="2" style="text-align: center;">Сумма скидки</th>                 
     3412                   <th text_wrap="true" rowspan="2" style="text-align: center;">Сумма брутто</th>                 
     3413                   <th text_wrap="true" rowspan="2" style="text-align: center;">Кол-во чеков</th>                                                   
     3414               </tr>                                                                                       
     3415               <tr>                                                                                        
     3416                   <th text_wrap="true" style="text-align: center;">Наименование</th>                                       
     3417                   <th colspan="2" style="text-align: center;">Масса по ТТН кг.</th>                                           
     3418                   <th colspan="2" text_wrap="true" style="text-align: center;">Масса к учету кг.</th>                                    
     3419               </tr>                                                                                       
     3420               <tr>                                                                                        
     3421                   <th style="text-align: center;">2.18</th>                                                  
     3422                   <th style="text-align: center;">2.19</th>                                                  
     3423                   <th style="text-align: center;">2.20</th>                                                  
     3424                   <th style="text-align: center;">2.21</th>                                                  
     3425                   <th style="text-align: center;">2.22</th>                                                  
     3426                   <th colspan="2" style="text-align: center;">2.23</th>                                                  
     3427                   <th colspan="2" style="text-align: center;">2.24</th>                                                  
     3428                   <th style="text-align: center;">2.25</th>                                                  
     3429                   <th style="text-align: center;">2.26</th>                                                 
     3430                   <th style="text-align: center;">2.27</th>                                                 
     3431                   <th style="text-align: center;">2.28</th>                                                 
     3432                   <th style="text-align: center;">2.29</th>                                                 
     3433                   <th style="text-align: center;">2.30</th>                                                 
     3434                   <th style="text-align: center;">2.31</th>                                                 
     3435                   <th style="text-align: center;">2.32</th>                                                 
     3436               </tr>'
     3437       , chr(123), chr(125)
     3438       ).
     3439     for each actreal-2 :
     3440       delete actreal-2 .
     3441     end.
     3442     FOR EACH t-2-sug NO-LOCK
     3443       BREAK
     3444       BY t-2-sug.main-code :
     3445       v-delta = 0.
     3446       DO jj = 1 TO t-2-sug.lines :
     3447         assign
     3448           pol1      = "":U
     3449           pol2      = 0
     3450           pol3      = 0
     3451           pol4      = 0
     3452           pol5      = "":U
     3453           pol6      = "":U
     3454           pol7      = 0
     3455           pol8      = 0
     3456           pol9      = 0
     3457           pol10     = ?
     3458           pol11     = "":U
     3459           pol12     = 0
     3460           pol13     = 0
     3461           pol14     = 0
     3462           pol15     = 0
     3463           pol16     = 0
     3464           pol17     = 0
     3465           pol18     = 0
     3466           pol19     = 0
     3467           main-line = no
     3468           supp-line = no
     3469           pay-line  = no.
     3470         IF jj = 1 then
     3471         do:
     3472           assign
     3473             pol1      = t-2-sug.gds-name
     3474             pol2      = t-2-sug.last-price
     3475             pol3      = t-2-sug.qnty1-before
     3476             pol4      = t-2-sug.qnty2-before
     3477             pol18     = t-2-sug.qnty1-after
     3478             pol19     = t-2-sug.qnty2-after
     3479             main-line = yes.
     3480           if p-batch > 0
     3481             then
     3482           do:
     3483             find first buf_shift-pgds where
     3484               buf_shift-pgds.obj-type = p-obj-type
     3485               and buf_shift-pgds.obj-code = p-obj-code
     3486               and buf_shift-pgds.shift-date = X-date-end
     3487               and buf_shift-pgds.shift-num = X-shift-end
     3488               and buf_shift-pgds.gds-code = t-2-sug.gds-code no-error.
     3489             if available buf_shift-pgds then
     3490             do:
     3491               assign
     3492                 buf_shift-pgds.end-price-sale = t-2-sug.last-price
     3493                 .
     3494               release buf_shift-pgds.
     3495             end.
     3496           end.
     3497         END.
     3498         FIND FIRST tincome-2 NO-LOCK WHERE
     3499           tincome-2.gds-code = t-2-sug.gds-code AND
     3500           tincome-2.ii       = jj           NO-ERROR.
     3501         IF AVAIlABLE tincome-2 THEN
     3502         DO:
     3503   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input tincome-2.doc-code ,
     3504                           input 'nids':U ,
     3505                          output v-attr-value ,
     3506                          output v-attr-type )  .
     3507           assign
     3508             pol6       = if v-attr-value = "" or v-attr-value = ?
     3509                  then tincome-2.doc-code
     3510                  else v-attr-value
     3511             pol8-excel = if v-attr-value = "" or v-attr-value = ?
     3512                  then tincome-2.doc-code
     3513                  else '="' + v-attr-value + '"'
     3514             .
     3515           ASSIGN
     3516             pol5      = tincome-2.supp-name
     3517             pol7      = round(tincome-2.qnty1,2)
     3518             pol9      = round(tincome-2.qnty3,2)
     3519             supp-line = yes.
     3520           if p-batch > 0
     3521             and tincome-2.supp-code > 0
     3522             and tincome-2.gds-code > 0
     3523             then
     3524           do:
     3525             find first buf_shift-pgds-in where
     3526               buf_shift-pgds-in.obj-type = p-obj-type
     3527               and buf_shift-pgds-in.obj-code = p-obj-code
     3528               and buf_shift-pgds-in.shift-date = X-date-end
     3529               and buf_shift-pgds-in.shift-num = X-shift-end
     3530               and buf_shift-pgds-in.gds-code = t-2-sug.gds-code
     3531               and buf_shift-pgds-in.doc-code = tincome-2.doc-code no-error.
     3532             if not available buf_shift-pgds-in then
     3533             do:
     3534               create buf_shift-pgds-in.
     3535               assign
     3536                 buf_shift-pgds-in.obj-type      = p-obj-type
     3537                 buf_shift-pgds-in.obj-code      = p-obj-code
     3538                 buf_shift-pgds-in.shift-date    = X-date-end
     3539                 buf_shift-pgds-in.shift-num     = X-shift-end
     3540                 buf_shift-pgds-in.gds-code      = t-2-sug.gds-code
     3541                 buf_shift-pgds-in.doc-code      = tincome-2.doc-code
     3542                 buf_shift-pgds-in.cli-type-code = substitute("&1&2", tincome-2.supp-type, tincome-2.supp-code)
     3543                 buf_shift-pgds-in.cli-name      = tincome-2.supp-name
     3544                 buf_shift-pgds-in.fact-qnty     = tincome-2.qnty1
     3545                 buf_shift-pgds-in.fact-qnty-2   = tincome-2.qnty2
     3546                 .
     3547               release buf_shift-pgds-in.
     3548             end.
     3549           end.
     3550         END.
     3551         _not-empty-group:
     3552         do while true :
     3553           FIND FIRST treal-2 NO-LOCK WHERE
     3554             treal-2.gds-code = t-2-sug.gds-code AND
     3555             treal-2.ii       = jj + v-delta          NO-ERROR.
     3556           if not available treal-2 then
     3557           do:
     3558             put stream OutStr-html unformatted
     3559               substitute (
     3560               '  <tr> 
     3561                                 <td  text_wrap="true">&1</td>
     3562                                 <td  text_wrap="true" style="text-align: right;">&2</td>
     3563                                 <td  text_wrap="true" style="text-align: right;">&3</td>
     3564                                 <td  text_wrap="true" style="text-align: right;">&4</td>
     3565                                 <td text_wrap="true" >&5</td>
     3566                                 <td colspan="2"  text_wrap="true" style="text-align: right;">&6</td>
     3567                                 <td colspan="2"  text_wrap="true" style="text-align: right;">&7</td>
     3568                                 <td text_wrap="true" >&8</td>
     3569                                 <td text_wrap="true"  style="text-align: right;">&9</td>'
     3570               ,
     3571               pol1,
     3572               if main-line = no then "" else string(pol2,"->>>>>>>>>>>9.99"),
     3573               if main-line = no then "" else string(pol4,"->>>>>>>>>>>9.99"),
     3574               if supp-line = no then "" else pol5,
     3575               if pol6 = "" then "" else string(pol6),
     3576               if supp-line = no then "" else string(pol9,"->>>>>>>>>>>9.99"),
     3577               if supp-line = no then "" else string(pol7,">>>>>>>>>>>9.99"),
     3578               if pay-line = no then "" else pol11,
     3579               if pay-line = no then "" else string(pol12,"->>>>>>>>>>>9.99")
     3580               ).
     3581             put stream OutStr-html unformatted
     3582               substitute (
     3583               '
     3584                       <td text_wrap="true"  style="text-align: right;">&1</td>
     3585                       <td text_wrap="true"  style="text-align: right;">&2</td>
     3586                       <td text_wrap="true"  style="text-align: right;">&3</td>
     3587                       <td text_wrap="true"  style="text-align: right;">&4</td>
     3588                       <td text_wrap="true"  style="text-align: right;">&5</td>
     3589                       <td text_wrap="true" style="text-align: right;">&6</td>
     3590                       </tr>
     3591                  '
     3592               ,
     3593               if pay-line = no then "" else string(pol13,"->>>>>>>>>>>9.99"),
     3594               if pay-line = no then "" else string(pol14,"->>>>>>>>>>>9.99"),
     3595               if pay-line = no or pol15 = 0 then "" else string(pol15,"->>>>>>>>>>>9.99"),
     3596               if pay-line = no or pol16 = 0 then "" else string(pol16,"->>>>>>>>>>>9.99"),
     3597               if main-line = no or pol17 = 0 then "" else string(pol17,"->>>>>>>>>>>9.99"),
     3598               if main-line = no then "" else string(pol19,"->>>>>>>>>>>9.99"),
     3599               if main-line = no then "" else string(pol3,"->>>>>>>>>>>9.99"),
     3600               if main-line = no then "" else string(pol18,"->>>>>>>>>>>9.99")
     3601               ).
     3602             leave _not-empty-group.
     3603           end.
     3604           if available treal-2 then
     3605           do:
     3606             if (treal-2.cpay-code <> 0
     3607               or treal-2.curr-code= - 1) and treal-2.discnt-type = -99
     3608               then
     3609             do:
     3610               FIND FIRST actreal-2 WHERE
     3611                 actreal-2.gds-code = 0 AND
     3612                 actreal-2.cpay-code = treal-2.cpay-code AND
     3613                 actreal-2.curr-code = treal-2.curr-code AND
     3614                 actreal-2.is-pay = treal-2.is-pay NO-ERROR.
     3615               if not available actreal-2 then
     3616               do:
     3617                 assign
     3618                   acii = acii + 1.
     3619                 run create-actreal-2 in this-procedure ( input 0,
     3620                   input treal-2.cpay-code,
     3621                   input treal-2.curr-code,
     3622                   input treal-2.qnty1,
     3623                   input treal-2.qnty2,
     3624                   input treal-2.netto,
     3625                   input trim(treal-2.out-name, chr(4)),
     3626                   input treal-2.is-pay,
     3627                   input acii               ) no-error.
     3628               end.
     3629               else
     3630               do:
     3631                 assign
     3632                   actreal-2.qnty1 = actreal-2.qnty1 + round(treal-2.qnty1,2)
     3633                   actreal-2.qnty2 = actreal-2.qnty2 + round(treal-2.qnty2,2)
     3634                   actreal-2.netto = actreal-2.netto + round(treal-2.netto,2).
     3635               end.
     3636             end.
     3637             if treal-2.is-pay = yes
     3638               and treal-2.curr-code < 0
     3639               and treal-2.out-name begins chr(4) then
     3640             do:
     3641               assign
     3642                 v-delta = v-delta + 1
     3643                 .
     3644               next _not-empty-group.
     3645             end.
     3646             else
     3647             do:
     3648               assign
     3649                 pol11    = treal-2.out-name
     3650                 pol12    = treal-2.qnty1
     3651                 pol13    = treal-2.qnty2
     3652                 pol14    = treal-2.netto
     3653                 pol15    = treal-2.discount-sum
     3654                 pol16    = treal-2.brutto
     3655                 pol17    = treal-2.chk-qnty
     3656                 pay-line = yes
     3657                 .
     3658               if p-batch > 0
     3659                 and (treal-2.curr-code > 0
     3660                 or not (treal-2.curr-code = 0 and treal-2.cpay-code = 0)
     3661                 )
     3662                 and treal-2.gds-code > 0
     3663                 then
     3664               do:
     3665                 find first buf_shift-pgds-out where
     3666                   buf_shift-pgds-out.obj-type = p-obj-type
     3667                   and buf_shift-pgds-out.obj-code = p-obj-code
     3668                   and buf_shift-pgds-out.shift-date = X-date-end
     3669                   and buf_shift-pgds-out.shift-num = X-shift-end
     3670                   and buf_shift-pgds-out.gds-code = treal-2.gds-code
     3671                   and buf_shift-pgds-out.pay-code = treal-2.cpay-code
     3672                   and buf_shift-pgds-out.curr-code = treal-2.curr-code
     3673                   no-error.
     3674                 if not available buf_shift-pgds-out then
     3675                 do:
     3676                   find first buf_cash-pay no-lock where
     3677                     buf_cash-pay.cdpay-code = treal-2.cpay-code
     3678                     and  buf_cash-pay.curr-code = treal-2.curr-code no-error.
     3679                   create buf_shift-pgds-out.
     3680                   assign
     3681                     buf_shift-pgds-out.obj-type    = p-obj-type
     3682                     buf_shift-pgds-out.obj-code    = p-obj-code
     3683                     buf_shift-pgds-out.shift-date  = X-date-end
     3684                     buf_shift-pgds-out.shift-num   = X-shift-end
     3685                     buf_shift-pgds-out.gds-code    = treal-2.gds-code
     3686                     buf_shift-pgds-out.pay-code    = treal-2.cpay-code
     3687                     buf_shift-pgds-out.curr-code   = treal-2.curr-code
     3688                     buf_shift-pgds-out.out-name    = treal-2.out-name
     3689                     buf_shift-pgds-out.cp-type     = (if available buf_cash-pay
     3690                                               and buf_cash-pay.is-cash
     3691                                               then 1
     3692                                               else 2)
     3693                     buf_shift-pgds-out.fact-qnty   = treal-2.qnty1
     3694                     buf_shift-pgds-out.fact-qnty-2 = treal-2.qnty2
     3695                     buf_shift-pgds-out.fact-sum    = treal-2.netto
     3696                     .
     3697                   .
     3698                 end.
     3699               end.
     3700               put stream OutStr-html unformatted
     3701                 substitute (
     3702                 '  <tr>
     3703                       <td text_wrap="true">&1</td>
     3704                       <td text_wrap="true" style="text-align: right;">&2</td>
     3705                       <td text_wrap="true" style="text-align: right;">&3</td>
     3706                       <td text_wrap="true" style="text-align: right;">&4</td>
     3707                       <td text_wrap="true">&5</td>
     3708                       <td colspan="2" text_wrap="true" style="text-align: right;">&6</td>
     3709                       <td colspan="2" text_wrap="true" style="text-align: right;">&7</td>
     3710                       <td text_wrap="true">&8</td>
     3711                       <td text_wrap="true" style="text-align: right;">&9</td>'
     3712                 ,
     3713                 pol1,
     3714                 if main-line = no then "" else string(pol2,"->>>>>>>>>>>9.99"),
     3715                 if main-line = no then "" else string(pol4,"->>>>>>>>>>>9.99"),
     3716                 if supp-line = no then "" else pol5,
     3717                 if pol6 = "" then "" else string(pol6),
     3718                 if supp-line = no then "" else string(pol9,"->>>>>>>>>>>9.99"),
     3719                 if supp-line = no then "" else string(pol7,">>>>>>>>>>>9.99"),
     3720                 if pay-line = no then "" else pol11,
     3721                 if pay-line = no then "" else string(pol12,"->>>>>>>>>>>9.99")
     3722                 ).
     3723               put stream OutStr-html unformatted
     3724                 substitute (
     3725                 '
     3726                       <td text_wrap="true"  style="text-align: right;">&1</td>
     3727                       <td text_wrap="true"  style="text-align: right;">&2</td>
     3728                       <td text_wrap="true"  style="text-align: right;">&3</td>
     3729                       <td text_wrap="true"  style="text-align: right;">&4</td>
     3730                       <td text_wrap="true"  style="text-align: right;">&5</td>
     3731                       <td text_wrap="true"  style="text-align: right;">&6</td>
     3732                       </tr>
     3733                  
     3734                       
     3735                  '
     3736                 ,
     3737                 if pay-line = no then "" else string(pol13,"->>>>>>>>>>>9.99"),
     3738                 if pay-line = no then "" else string(pol14,"->>>>>>>>>>>9.99"),
     3739                 if pay-line = no or pol15 = 0 then "" else string(pol15,"->>>>>>>>>>>9.99"),
     3740                 if pay-line = no or pol16 = 0 then "" else string(pol16,"->>>>>>>>>>>9.99"),
     3741                 if main-line = no or pol17 = 0 then "" else string(pol17,"->>>>>>>>>>>9.99"),
     3742                 if main-line = no then "" else string(pol19,"->>>>>>>>>>>9.99"),
     3743                 if main-line = no then "" else string(pol3,"->>>>>>>>>>>9.99"),
     3744                 if main-line = no then "" else string(pol18,"->>>>>>>>>>>9.99")
     3745                 ).
     3746               leave _not-empty-group.
     3747             end.
     3748           end.
     3749         end.
     3750         if jj <= t-2-sug.lines then
     3751           if main-line = yes then
     3752           do:
     3753             assign
     3754               accum-sug-4  = accum-sug-4  + round(pol3,2)
     3755               accum-sug-5  = accum-sug-5  + round(pol4,2)
     3756               accum-sug-17 = accum-sug-17 + round(pol18,2)
     3757               accum-sug-18 = accum-sug-18 + round(pol19,2).
     3758           end.
     3759         if supp-line = yes then
     3760         do:
     3761           if tincome-2.is-fact = yes then
     3762           do:
     3763             assign
     3764               accum-sug-9  = accum-sug-9  + round(pol7,2)
     3765               accum-sug-11 = accum-sug-11 + round(pol9,2).
     3766           end.
     3767         end.
     3768         if pay-line = yes then
     3769         do:
     3770           if treal-2.cpay-code <> 0
     3771             and treal-2.curr-code <>  - 1
     3772             then
     3773           do:
     3774             if treal-2.discnt-type = -99 or treal-2.cpay-code < 0 then
     3775             do:
     3776               assign
     3777                 accum-sug-14 = accum-sug-14 + round(pol12,2)
     3778                 accum-sug-15 = accum-sug-15 + round(pol13,2)
     3779                 accum-sug-16 = accum-sug-16 + round(pol14,2).
     3780             end.
     3781           end.
     3782         end.
     3783       END.
     3784       IF LAST( t-2-sug.main-code ) THEN
     3785       DO:
     3786         assign
     3787           pol1  = "ИТОГО"
     3788           pol3  = accum-sug-4
     3789           pol4  = accum-sug-5
     3790           pol7  = accum-sug-9
     3791           pol9  = accum-sug-11
     3792           POL11 = "ИТОГО РАСХОД"
     3793           pol12 = accum-sug-14
     3794           pol13 = accum-sug-15
     3795           pol14 = accum-sug-16
     3796           pol18 = accum-sug-17
     3797           pol19 = accum-sug-18.
     3798         put stream OutStr-html unformatted
     3799           substitute (
     3800           '        
     3801           
     3802           <tr>
     3803                       <th text_wrap="true"  style="text-align: left; vertical-align: middle;">&1</th>
     3804                       <th ></th>
     3805                       <th text_wrap="true" style="text-align: right; vertical-align: middle;">&2</th>
     3806                       <th text_wrap="true" style="text-align: right; vertical-align: middle;">&3</th>
     3807                       <th ></th>
     3808                       <th colspan="2"  text_wrap="true" style="text-align: right; vertical-align: middle;">&4</th>
     3809                       <th colspan="2"  text_wrap="true" style="text-align: right; vertical-align: middle;">&5</th>
     3810                       <th  text_wrap="true" style="text-align: right; vertical-align: middle;">&6</th>
     3811                       <th text_wrap="true"  style="vertical-align: middle;">&7</th>
     3812                       <th text_wrap="true"  style="text-align: right; vertical-align: middle;">&8</th>
     3813                       <th text_wrap="true"  style="text-align: right; vertical-align: middle;">&9</th>
     3814                                         
     3815                       
     3816                       '
     3817           ,
     3818           pol1,
     3819           string(pol4,"->>>>>>>>>>>9.99"),
     3820           pol5,
     3821           string(pol9,"->>>>>>>>>>>9.99"),
     3822           string(pol7,"->>>>>>>>>>>9.99"),
     3823           pol11,
     3824           string(pol12,"->>>>>>>>>>>9.99"),
     3825           string(pol13,"->>>>>>>>>>>9.99"),
     3826           string(pol14,"->>>>>>>>>>>9.99")
     3827           ).
     3828         put stream OutStr-html unformatted
     3829           substitute (
     3830           '
     3831               <th text_wrap="true" style="text-align: right; vertical-align: middle;"></th>
     3832               <th text_wrap="true" style="text-align: right; vertical-align: middle;"></th>       
     3833               <th text_wrap="true" style="text-align: right; vertical-align: middle;"></th>
     3834               <th  text_wrap="true" style="text-align: right; vertical-align: middle;">&4</th>
     3835               </tr>
     3836               '
     3837           ,
     3838           string(pol15,"->>>>>>>>>>>9.99"),
     3839           string(pol16,"->>>>>>>>>>>9.99"),
     3840           string(pol17,"->>>>>>>>>>>9.99"),
     3841           string(pol19,"->>>>>>>>>>>9.99"),
     3842           string(pol3,"->>>>>>>>>>>9.99"),
     3843           string(pol18,"->>>>>>>>>>>9.99")
     3844           ).
     3845         if can-find( first actreal-2 no-lock ) then
     3846         do:
     3847           assign
     3848             pol11 = "     в том числе:".
     3849           put stream OutStr-html unformatted
     3850             substitute (
     3851             '  <tr>
     3852                       <th></th>
     3853                       <th></th>
     3854                       <th></th>
     3855                       <th></th>
     3856                       <th></th>
     3857                       <th colspan="2"></th>
     3858                       <th colspan="2"></th>
     3859                       <th text_wrap="true">&1</th>
     3860                       <th></th>
     3861                       <th></th>
     3862                       <th></th>
     3863                       <th></th>
     3864                       <th></th>
     3865                       <th></th>
     3866                       <th></th>
     3867                   </tr>'
     3868             ,
     3869             pol11
     3870             ).
     3871           assign
     3872             areal-is-pay-qnty1 = 0
     3873             areal-is-pay-qnty2 = 0
     3874             areal-is-pay-netto = 0
     3875             areal-no-pay-qnty1 = 0
     3876             areal-no-pay-qnty2 = 0
     3877             areal-no-pay-netto = 0.
     3878           FOR EACH actreal-2 NO-LOCK
     3879             BREAK
     3880             BY actreal-2.gds-code
     3881             By actreal-2.is-pay    DESCENDING
     3882             BY actreal-2.cpay-code DESCENDING
     3883             BY actreal-2.curr-code :
     3884             if actreal-2.is-pay = yes then
     3885             do:
     3886               if actreal-2.curr-code >= 0 then
     3887                 assign areal-is-pay-qnty1 = areal-is-pay-qnty1 + round(actreal-2.qnty1,2)
     3888                   areal-is-pay-qnty2 = areal-is-pay-qnty2 + round(actreal-2.qnty2,2)
     3889                   areal-is-pay-netto = areal-is-pay-netto + round(actreal-2.netto,2).
     3890             end.
     3891             else
     3892             do:
     3893               assign
     3894                 areal-no-pay-qnty1 = areal-no-pay-qnty1 + round(actreal-2.qnty1,2)
     3895                 areal-no-pay-qnty2 = areal-no-pay-qnty2 + round(actreal-2.qnty2,2)
     3896                 areal-no-pay-netto = areal-no-pay-netto + round(actreal-2.netto,2) .
     3897             end.
     3898             assign
     3899               pol11 = actreal-2.out-name
     3900               pol12 = actreal-2.qnty1
     3901               pol13 = actreal-2.qnty2
     3902               pol14 = actreal-2.netto
     3903               pol15 = actreal-2.brutto
     3904               pol16 = actreal-2.discount-sum
     3905               pol17 = actreal-2.chk-qnty.
     3906             put stream OutStr-html unformatted
     3907               substitute (
     3908               '  <tr>
     3909                       <th></th>
     3910                       <th></th>
     3911                       <th></th>
     3912                       <th></th>
     3913                       <th></th>
     3914                       <th colspan="2"></th>
     3915                       <th colspan="2"></th>
     3916                       <th text_wrap="true">&1</th>
     3917                       <th text_wrap="true" style="text-align: right; vertical-align: middle;">&2</th>
     3918                       <th text_wrap="true" style="text-align: right; vertical-align: middle;">&3</th>
     3919                       <th text_wrap="true" style="text-align: right; vertical-align: middle;">&4</th>
     3920                       <th text_wrap="true" style="text-align: right; vertical-align: middle;">&5</th>
     3921                       <th text_wrap="true" style="text-align: right; vertical-align: middle;">&6</th>
     3922                       <th text_wrap="true" style="text-align: right; vertical-align: middle;">&7</th>
     3923                       <th></th>
     3924                  </tr>'
     3925               ,
     3926               pol11,
     3927               string(pol12,"->>>>>>>>>>>9.99"),
     3928               string(pol13,"->>>>>>>>>>>9.99"),
     3929               string(pol14,"->>>>>>>>>>>9.99"),
     3930               if pol15 = 0 then "" else string(pol15,"->>>>>>>>>>>9.99"),
     3931               if pol16 = 0 then "" else string(pol16,"->>>>>>>>>>>9.99"),
     3932               if pol17 = 0 then "" else string(pol17,"->>>>>>>>>>>9.99")
     3933               ).
     3934             if last-of( actreal-2.is-pay )  then
     3935             do:
     3936               if actreal-2.discnt-type = -99 or actreal-2.cpay-code < 0 then
     3937               do:
     3938                 if actreal-2.is-pay = yes then
     3939                 do:
     3940                   assign
     3941                     pol11 = "ИТОГО ОПЛАЧ.РАСХОД"
     3942                     pol12 = areal-is-pay-qnty1
     3943                     pol13 = areal-is-pay-qnty2
     3944                     pol14 = areal-is-pay-netto.
     3945                 end.
     3946                 else
     3947                 do:
     3948                   assign
     3949                     pol11 = "ИТОГО ПРОЧ.РАСХОД"
     3950                     pol12 = areal-no-pay-qnty1
     3951                     pol13 = areal-no-pay-qnty2
     3952                     pol14 = areal-no-pay-netto.
     3953                 end.
     3954               end.
     3955               put stream OutStr-html unformatted
     3956                 substitute (
     3957                 '  <tr>
     3958                       <th></th>
     3959                       <th></th>
     3960                       <th></th>
     3961                       <th></th>
     3962                       <th></th>
     3963                       <th colspan="2"></th>
     3964                       <th colspan="2"></th>
     3965                       <th text_wrap="true">&1</th>
     3966                       <th text_wrap="true" style="text-align: right; vertical-align: middle;">&2</th>
     3967                       <th text_wrap="true" style="text-align: right; vertical-align: middle;">&3</th>
     3968                       <th text_wrap="true" style="text-align: right; vertical-align: middle;">&4</th>
     3969                       <th></th>
     3970                       <th></th>
     3971                       <th></th>
     3972                       <th></th>
     3973                  </tr>'
     3974                 ,
     3975                 pol11,
     3976                 string(pol12,"->>>>>>>>>>>9.99"),
     3977                 string(pol13,"->>>>>>>>>>>9.99"),
     3978                 string(pol14,"->>>>>>>>>>>9.99")
     3979                 ).
     3980             end.
     3981           END.
     3982         END.
     3983       END.
     3984     END.
     3985     put stream OutStr-html unformatted
     3986       substitute (
     3987       '
     3988           </tbody>
     3989           '
     3990       , chr(123), chr(125)
     3991       ).
     3992     output stream OutStr-html close.
     3993   end.
     3994   end procedure .
     3995   PROCEDURE create-tincome-2 :
     3996     define input parameter p-gds-code  like ub.goods.gds-code   no-undo.
     3997     define input parameter p-doc-code  like ub.trn-doc.doc-code no-undo.
     3998     define input parameter p-qnty1     as   decimal             no-undo.
     3999     define input parameter p-qnty2     as   decimal             no-undo.
     4000     define input parameter p-qnty3    as   decimal             no-undo.
     4001     define input parameter p-supp-name as   character           no-undo.
     4002     define input parameter p-supp-code like ub.clients.obj-code no-undo.
     4003     define input parameter p-is-fact   as   logical             no-undo.
     4004     define input parameter p-ii        as   integer             no-undo.
     4005     _main:
     4006     DO ON ERROR UNDO _main, RETURN ERROR :
     4007       CREATE tincome-2.
     4008       assign
     4009         tincome-2.gds-code    = p-gds-code
     4010         tincome-2.doc-code    = p-doc-code
     4011         tincome-2.supp-code   = p-supp-code
     4012         tincome-2.supp-name   = p-supp-name
     4013         tincome-2.is-fact     = p-is-fact
     4014         tincome-2.temperature = ?
     4015         tincome-2.ii          = p-ii
     4016         tincome-2.qnty1       = p-qnty1
     4017         tincome-2.qnty2       = p-qnty2
     4018         tincome-2.qnty3       = p-qnty3
     4019       no-error.
     4020       IF ERROR-STATUS :ERROR THEN
     4021       DO:
     4022         UNDO _main, RETURN ERROR.
     4023       END.
     4024     END.
     4025   END PROCEDURE.
