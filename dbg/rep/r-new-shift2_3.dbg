     2313       aincome-qnty2           = 0
     2314       aincome-qnty3           = 0
     2315       aincome-sug-qnty1       = 0
     2316       aincome-sug-qnty2       = 0
     2317       aincome-sug-qnty3       = 0
     2318       loc-real-ii             = 1
