      746   then
      747     run gbl\inidebug.p .
      748   end.
      749   procedure proc-alt-shift-f3:
      750     run gbl/prvssinf.p
      751       ( input this-procedure
      752       ) .
      753   end.
      754   define variable v-inform-launched as logical no-undo initial false .
      755   procedure proc-alt-shift-f4:
      756     define variable v-action as character no-undo .
      757     if v-inform-launched = false then do:
      758       assign
      759         v-inform-launched = true
      760       .
      761       run gbl/d-inform.w
      762         (  input self
      763         ,  input this-procedure
      764         , output v-action
      765         ) no-error .
      766       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      767       assign
      768         v-inform-launched = false
      769       .
      770     end.
      771   end.
      772   procedure proc-alt-f1:
