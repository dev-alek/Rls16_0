      900   procedure grplib-get-parameters :
      901   define input parameter p-store-type     as character        no-undo.
      902   define input parameter p-store-code     as integer          no-undo.
      903   do
      904   on error undo, return error
      905   :
      906       assign
      907           v-grplib-not-fill-extra-info = no
      908       .
      909   end.
      910   end procedure.
      911   procedure grplib-get-sort-name :
      912   do
      913   on error undo, return error
      914   :
      915   define input parameter p-node-code  as integer      no-undo.
      916   define output parameter p-sort-name as character    no-undo.
      917       define variable v-upper-code    as integer           no-undo.
      918       define buffer buf_gds-grp       for ub.gds-grp.
      919       define buffer buf_upper_gds-grp for ub.gds-grp.
      920       find first buf_gds-grp no-lock
      921            where buf_gds-grp.node-code = p-node-code
      922       no-error.
      923       if not available buf_gds-grp
      924       then do:
      925           undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      926       end.
      927       assign
      928           p-sort-name  = ""
      929           v-upper-code = 1
      930       .
      931       do while buf_gds-grp.upper-code <> 0
      932       on error undo, return error "grplib-get-sort-name: Ошибка составления полного имени группы"
      933       :
      934           assign
      935               p-sort-name  = buf_gds-grp.node-name
      936                            + (if p-sort-name <> "" then chr(2) else "")
      937                            + p-sort-name
      938               v-upper-code = buf_gds-grp.upper-code
      939           .
      940           find first buf_gds-grp no-lock
      941                where buf_gds-grp.node-code = v-upper-code
      942           no-error.
      943           if not available buf_gds-grp
      944           then do:
      945               undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом "
      946                                   + string( v-upper-code )
      947                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      948           end.
      949       end.
      950   end.
      951   end procedure.
      952   define variable vss-include-info15 as character format "X(65)" no-undo
      953   initial "@(#)$Workfile$ $Revision$".
      954   procedure grplib-get-full-name :
      955      define input parameter p-node-code  as integer      no-undo.
      956      define output parameter p-full-name as character    no-undo.
      957      do
      958   on error undo, return error
      959   :
      960       define variable v-upper-code    as integer           no-undo.
      961       define buffer buf_gds-grp       for ub.gds-grp.
      962       define buffer buf_upper_gds-grp for ub.gds-grp.
      963       find first buf_gds-grp no-lock
      964            where buf_gds-grp.node-code = p-node-code
      965       no-error.
      966       if not available buf_gds-grp
      967       then do:
      968           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      969       end.
      970       assign
      971           p-full-name  = ""
      972           v-upper-code = 1
      973       .
      974       do while buf_gds-grp.upper-code <> 0
      975       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      976       :
      977           assign
      978               p-full-name  = buf_gds-grp.node-name
      979                            + (if p-full-name <> "" then chr(47) else "")
      980                            + p-full-name
      981               v-upper-code = buf_gds-grp.upper-code
      982           .
      983           find first buf_gds-grp no-lock
      984                where buf_gds-grp.node-code = v-upper-code
      985           no-error.
      986           if not available buf_gds-grp
      987           then do:
      988               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      989                                   + string( v-upper-code )
      990                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      991           end.
      992       end.
      993       assign
      994       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      995       .
      996   end.
      997   end .
      998   procedure grplib-get-node-from-full-name :
      999   define input parameter p-full-name as character no-undo .
     1000   define output parameter p-node-code as integer no-undo .
     1001   define variable v-ii as integer no-undo .
     1002   define variable v-upper-code as integer no-undo .
     1003   define variable v-root-code as integer no-undo .
     1004   define variable v-entry as character no-undo .
     1005   define buffer buf_gds-grp       for ub.gds-grp.
     1006   do
     1007   on error undo, return error
     1008   :
     1009     find first buf_gds-grp no-lock
     1010         where buf_gds-grp.upper-code = 0
     1011     no-error .
     1012     if not available buf_gds-grp
     1013     then do:
     1014         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     1015     end.
     1016     else do:
     1017       assign
     1018       v-root-code = buf_gds-grp.node-code
     1019       .
     1020     end.
     1021     v-upper-code = v-root-code.
     1022     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1023       assign
     1024       v-entry = entry(v-ii, p-full-name, chr(47)).
     1025       if v-entry = '' then leave.
     1026       find first buf_gds-grp no-lock where
     1027                 buf_gds-grp.node-name = v-entry
     1028             and buf_gds-grp.upper-code = v-upper-code
     1029             no-error.
     1030       if not available buf_gds-grp then do:
     1031         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1032       end.
     1033       else do:
     1034         p-node-code = buf_gds-grp.node-code.
     1035         v-upper-code = buf_gds-grp.node-code.
     1036       end.
     1037     end.
     1038   end.
     1039   end .
     1040   procedure grplib-get-root-code :
     1041   do
     1042   on error undo, return error
     1043   :
     1044   define output parameter p-root-code as integer      no-undo.
     1045       define buffer buf_gds-grp       for ub.gds-grp.
     1046       find first buf_gds-grp no-lock
     1047           where buf_gds-grp.upper-code = 0
     1048       no-error .
     1049       if not available buf_gds-grp
     1050       then do:
     1051           undo, return error .
     1052       end.
     1053       else do:
     1054           assign
     1055               p-root-code = buf_gds-grp.node-code
     1056           .
     1057       end.
     1058   end.
     1059   end procedure.
     1060   procedure grplib-find-grp-by-full-name :
     1061   do
     1062   on error undo, return error
     1063   :
     1064   define input parameter p-search-name  as character    no-undo.
     1065   define input parameter p-fill-path    as logical      no-undo.
     1066   define output parameter p-found       as logical      no-undo.
     1067       define variable v-upper-code    as integer          no-undo.
     1068       define variable v-counter       as integer           no-undo.
     1069       define variable v-level         as integer           no-undo.
     1070       define variable v-full-name     as character         no-undo.
     1071       define variable v-sort-name     as character         no-undo.
     1072       define buffer buf_gds-grp       for ub.gds-grp.
     1073       assign
     1074           p-search-name = replace( p-search-name, chr(47), chr(2) )
     1075       .
     1076       run grplib-get-root-code ( output v-upper-code ) no-error .
     1077       if error-status :error
     1078       then do:
     1079           undo, return error "grplib-expand-name: Ошибка при поиске корневого узла".
     1080       end.
     1081       assign
     1082           v-full-name  = ""
     1083           v-level      = num-entries( p-search-name, chr(2) )
     1084       .
     1085       for each temp_grplib_found-grp
     1086       :
     1087           delete temp_grplib_found-grp.
     1088       end.
     1089       start-name-analyze:
     1090       do v-counter = 1 to v-level
     1091       :
     1092           if v-counter < v-level
     1093           then do:
     1094               find first buf_gds-grp no-lock
     1095                    where buf_gds-grp.upper-code = v-upper-code
     1096                      and buf_gds-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
     1097               no-error .
     1098               if not available buf_gds-grp
     1099               then do:
     1100                   assign
     1101                       v-full-name  = p-search-name
     1102                       v-sort-name  = p-search-name
     1103                   .
     1104                   return error "grplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
     1105               end.
     1106               else do:
     1107                   assign
     1108                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_gds-grp.node-name
     1109                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_gds-grp.node-name
     1110                       v-upper-code = buf_gds-grp.node-code
     1111                   .
     1112                   if p-fill-path = yes
     1113                   then do:
     1114                       create temp_grplib_found-grp.
     1115                       assign
     1116                           temp_grplib_found-grp.full-name = v-full-name + chr(47)
     1117                           temp_grplib_found-grp.sort-name = v-sort-name
     1118                           temp_grplib_found-grp.node-code = v-upper-code
     1119                           temp_grplib_found-grp.level     = v-counter
     1120                       .
     1121                   end.
     1122               end.
     1123           end.
     1124           else do:
     1125               for each buf_gds-grp no-lock
     1126                  where buf_gds-grp.upper-code = v-upper-code
     1127                    and buf_gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
     1128               :
     1129                   assign
     1130                       p-found = yes
     1131                   .
     1132                   create temp_grplib_found-grp.
     1133                   assign
     1134                       temp_grplib_found-grp.full-name = v-full-name
     1135                                                           + (if v-full-name = "" then "" else chr(47) )
     1136                                                           + buf_gds-grp.node-name + chr(47)
     1137                       temp_grplib_found-grp.sort-name = v-sort-name
     1138                                                           + ( if v-sort-name = "" then "" else chr(2) )
     1139                                                           + buf_gds-grp.node-name
     1140                       temp_grplib_found-grp.node-code = buf_gds-grp.node-code
     1141                       temp_grplib_found-grp.level     = v-level
     1142                   .
     1143               end.
     1144               if p-found = no
     1145               then do:
     1146                   assign
     1147                       v-full-name  = p-search-name
     1148                       v-sort-name  = p-search-name
     1149                   .
     1150                   for each temp_grplib_found-grp
     1151                   :
     1152                       delete temp_grplib_found-grp.
     1153                   end.
     1154                   assign
     1155                       p-found = no
     1156                   .
     1157               end.
     1158           end.
     1159       end.
     1160   end.
     1161   end procedure.
     1162   procedure grplib-find-all-subgroup :
     1163   do
     1164   on error undo, return error
     1165   :
     1166   define input parameter p-start-node-code    as integer      no-undo.
     1167   define input parameter p-terminal-only      as logical      no-undo.
     1168       define variable v-start-full-name   as character     no-undo.
     1169       define variable v-start-sort-name   as character     no-undo.
     1170       define variable v-not-found         as logical       no-undo.
     1171       define variable v-is-terminal       as logical       no-undo.
     1172       define buffer buf_gds-grp           for ub.gds-grp.
     1173       create temp_found-result-nodelist.
     1174       assign
     1175           temp_found-result-nodelist.node-code = p-start-node-code
     1176           temp_found-result-nodelist.processed = no
     1177       .
     1178       run grplib-get-full-name in this-procedure (
     1179             input p-start-node-code
     1180           , output v-start-full-name
     1181       ).
     1182       run grplib-get-full-name in this-procedure (
     1183             input p-start-node-code
     1184           , output v-start-sort-name
     1185       ).
     1186       process-nodes:
     1187       do while yes
     1188       :
     1189           find first temp_found-result-nodelist
     1190                where temp_found-result-nodelist.node-code = p-start-node-code
     1191           .
     1192           assign
     1193               temp_found-result-nodelist.processed = yes
     1194           .
     1195           for each buf_gds-grp no-lock
     1196              where buf_gds-grp.upper-code = p-start-node-code
     1197           on error undo, return error
     1198           :
     1199               run grplib-is-terminal in this-procedure (
     1200                     input buf_gds-grp.node-code
     1201                   , output v-is-terminal
     1202               ).
     1203               if v-is-terminal = yes
     1204               then do:
     1205                   create temp_grplib_found-grp.
     1206                   assign
     1207                       temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1208                                                           chr(47) + buf_gds-grp.node-name + chr(47)
     1209                       temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1210                                                           chr(2) + buf_gds-grp.node-name + chr(2)
     1211                       temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
     1212                       temp_grplib_found-grp.is-terminal = yes
     1213                   .
     1214               end.
     1215               else do:
     1216                   create temp_found-result-nodelist.
     1217                   assign
     1218                       temp_found-result-nodelist.node-code = buf_gds-grp.node-code
     1219                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
     1220                                                              chr(47) + buf_gds-grp.node-name + chr(47)
     1221                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
     1222                                                              chr(2) + buf_gds-grp.node-name + chr(2)
     1223                       temp_found-result-nodelist.processed = no
     1224                   .
     1225                   if p-terminal-only = no
     1226                   then do:
     1227                       create temp_grplib_found-grp.
     1228                       assign
     1229                           temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1230                                                               chr(47) + buf_gds-grp.node-name + chr(47)
     1231                           temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1232                                                               chr(2) + buf_gds-grp.node-name + chr(2)
     1233                           temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
     1234                           temp_grplib_found-grp.is-terminal = no
     1235                       .
     1236                   end.
     1237               end.
     1238           end.
     1239           find first temp_found-result-nodelist
     1240                where temp_found-result-nodelist.processed = no
     1241           no-error.
     1242           if not available temp_found-result-nodelist
     1243           then do:
     1244               leave process-nodes.
     1245           end.
     1246           else do:
     1247               assign
     1248                   p-start-node-code = temp_found-result-nodelist.node-code
     1249                   v-start-full-name = temp_found-result-nodelist.full-name
     1250                   v-start-sort-name = temp_found-result-nodelist.sort-name
     1251               .
     1252           end.
     1253       end.
     1254   end.
     1255   end procedure.
     1256   procedure grplib-expand-name :
     1257   define input parameter p-start-name as character        no-undo.
     1258   define output parameter p-end-name  as character        no-undo.
     1259       define variable v-is-terminal   as logical      no-undo.
     1260       define variable v-found         as character    no-undo.
     1261       define buffer buf_temp_grplib_found-grp     for temp_grplib_found-grp.
     1262   do
     1263   for buf_temp_grplib_found-grp
     1264   on error undo, return error
     1265   :
     1266       run grplib-find-grp-by-full-name in this-procedure (
     1267             input p-start-name
     1268           , input no
     1269           , output v-found
     1270       ) no-error.
     1271       run grplib-get-max-substring in this-procedure (
     1272                   input length( p-start-name )
     1273                 , output p-end-name
     1274       ) no-error .
     1275       if error-status :error
     1276       then do:
     1277           assign
     1278               p-end-name = ""
     1279           .
     1280       end.
     1281       else do:
     1282           find first temp_grplib_found-grp
     1283               where temp_grplib_found-grp.full-name = p-end-name
     1284           no-error.
     1285           if available temp_grplib_found-grp
     1286           then do:
     1287               find first buf_temp_grplib_found-grp
     1288                   where buf_temp_grplib_found-grp.full-name begins p-end-name
     1289                   and recid( buf_temp_grplib_found-grp ) <> recid( temp_grplib_found-grp )
     1290               no-error.
     1291               if not available buf_temp_grplib_found-grp
     1292               then do:
     1293                   run grplib-is-terminal in this-procedure (
     1294                       input temp_grplib_found-grp.node-code
     1295                       , output v-is-terminal
     1296                   ).
     1297               end.
     1298           end.
     1299       end.
     1300   end.
     1301   end procedure.
     1302   procedure grplib-get-max-substring :
     1303   do
     1304   on error undo, return error
     1305   :
     1306   define input parameter p-min-substring-length   as integer      no-undo.
     1307   define output parameter p-substring             as character    no-undo.
     1308           define variable v-char-counter  as integer           no-undo.
     1309           define variable v-current-char  as character         no-undo.
     1310           define variable v-names-counter  as integer           no-undo.
     1311           define variable v-base-string   as character         no-undo.
     1312           assign
     1313               v-char-counter  = p-min-substring-length
     1314           .
     1315           find first temp_grplib_found-grp no-error.
     1316           if not available temp_grplib_found-grp
     1317           then do:
     1318               undo, return error "grplib-get-max-substring: Нет строк для вычисления общей подстроки".
     1319           end.
     1320           else do:
     1321               assign
     1322                   v-base-string  = temp_grplib_found-grp.full-name
     1323                   v-char-counter = 0
     1324               .
     1325               counter-block:
     1326               do while yes
     1327               on error undo, return error "grplib-get-max-substring: Ошибка вычисления продолжения имени группы."
     1328               :
     1329                   assign
     1330                       v-char-counter  = v-char-counter + 1
     1331                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
     1332                       v-names-counter = 0
     1333                   .
     1334                   compare-block:
     1335                   for each temp_grplib_found-grp
     1336                   :
     1337                       assign
     1338                           v-names-counter = v-names-counter + 1
     1339                       .
     1340                       if v-names-counter = 1
     1341                       then do:
     1342                           next compare-block.
     1343                       end.
     1344                       if substring( temp_grplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
     1345                       then do:
     1346                           leave counter-block.
     1347                       end.
     1348                   end.
     1349                   if v-names-counter = 1
     1350                   then do:
     1351                       assign
     1352                           p-substring = v-base-string
     1353                       .
     1354                       return.
     1355                   end.
     1356               end.
     1357               assign
     1358                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
     1359               .
     1360           end.
     1361   end.
     1362   end procedure.
     1363   procedure grplib-is-terminal :
     1364   do
     1365   on error undo, return error "Ошибка процедуры grplib-is-terminal"
     1366   :
     1367   define input parameter p-node-code      as integer      no-undo.
     1368   define output parameter p-is-terminal   as logical      no-undo.
     1369       define buffer buf_gds-grp       for ub.gds-grp.
     1370       find first buf_gds-grp no-lock
     1371           where buf_gds-grp.upper-code = p-node-code
     1372       no-error .
     1373       if not available buf_gds-grp
     1374       then do:
     1375           assign
     1376               p-is-terminal = yes
     1377           .
     1378       end.
     1379       else do:
     1380           assign
     1381               p-is-terminal = no
     1382           .
     1383       end.
     1384   end.
     1385   end procedure.
     1386   procedure grplib-have-goods :
     1387   do
     1388   on error undo, return error
     1389   :
     1390   define input parameter p-node-code      as integer      no-undo.
     1391   define output parameter p-have-goods   as logical      no-undo.
     1392       define buffer buf_goods         for ub.goods.
     1393       find first buf_goods no-lock
     1394            where buf_goods.grp-code = p-node-code
     1395       no-error .
     1396       if available buf_goods
     1397       then do:
     1398           assign
     1399               p-have-goods = yes
     1400           .
     1401       end.
     1402       else do:
     1403           assign
     1404               p-have-goods = no
     1405           .
     1406       end.
     1407   end.
     1408   end procedure.
     1409   procedure grplib-find-by-substring :
     1410   do
     1411   on error undo, return error
     1412   :
     1413   define input parameter p-start-code         as integer      no-undo.
     1414   define input parameter p-full-search-string as character    no-undo.
     1415   define output parameter p-found-code        as integer      no-undo.
     1416   define output parameter p-full-name         as character    no-undo.
     1417       define variable v-start-code     as integer           no-undo.
     1418       define variable v-found          as logical  init no  no-undo.
     1419       define buffer buf_gds-grp       for ub.gds-grp.
     1420       search-grp:
     1421       for each buf_gds-grp no-lock
     1422           where buf_gds-grp.node-code > p-start-code
     1423       :
     1424           if index( buf_gds-grp.node-name, p-full-search-string ) <> 0
     1425           then do:
     1426               assign
     1427                   p-found-code = buf_gds-grp.node-code
     1428                   v-found      = yes
     1429               .
     1430               run grplib-get-full-name in this-procedure (
     1431                     input p-found-code
     1432                   , output p-full-name
     1433               ) no-error .
     1434               if error-status :error
     1435               then do:
     1436                   undo, return error "grplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
     1437               end.
     1438               leave search-grp.
     1439           end.
     1440       end.
     1441       if v-found = yes
     1442       then do:
     1443       end.
     1444       else do:
     1445           assign
     1446               p-full-name  = ""
     1447               p-found-code = 0
     1448           .
     1449       end.
     1450   end.
     1451   end procedure.
     1452   procedure grplib-analyze-grp-name :
     1453   do
     1454   on error undo, return error
     1455   :
     1456   define input parameter p-grp-name       as character            no-undo.
     1457   define input parameter p-upper-code     as integer              no-undo.
     1458   define output parameter p-error-message as character init ""    no-undo.
     1459       define variable v-char-list     as character    no-undo.
     1460       define variable v-char-counter  as integer      no-undo.
     1461       define variable v-full-name     as character    no-undo.
     1462       if p-grp-name = "" then do:
     1463           assign
     1464               p-error-message = "Название группы не может быть пустым.".
     1465           .
     1466       end.
     1467       else do:
     1468           assign
     1469               v-char-list = "47,92,58,63,34,60,62,171,187,183"
     1470           .
     1471           do v-char-counter = 1 to num-entries( v-char-list )
     1472           :
     1473               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
     1474               then do:
     1475                   assign
     1476                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
     1477                   .
     1478                   return.
     1479               end.
     1480           end.
     1481           if p-upper-code > 0
     1482           then do:
     1483               run grplib-get-full-name in this-procedure (
     1484                     input p-upper-code
     1485                   , output v-full-name
     1486               ) no-error .
     1487               if error-status :error
     1488               then do:
     1489                   undo, return error "grplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
     1490               end.
     1491               if length( v-full-name ) + 1 + length( p-grp-name ) > 350
     1492               then do:
     1493                   assign
     1494                       p-error-message = 'Полное название группы не может содержать более 350 символов.'
     1495                   .
     1496               end.
     1497           end.
     1498       end.
     1499   end.
     1500   end procedure.
     1501   procedure grplib-get-lvl-num :
     1502   define input parameter p-node-code  as integer      no-undo.
     1503   define output parameter p-lvl-num   as integer      no-undo.
     1504       define variable v-full-name    as character    no-undo.
     1505   do
     1506   on error undo, return error
     1507   :
     1508       run grplib-get-full-name in this-procedure (
     1509             input p-node-code
     1510           , output v-full-name
     1511       ).
     1512       assign
     1513           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
     1514       .
     1515       if p-lvl-num = -1
     1516       then do:
     1517           assign
     1518               p-lvl-num = 0
     1519           .
     1520       end.
     1521   end.
     1522   end procedure.
     1523   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1524   define shared temp-table dc-list no-undo like ub.dis-card
     1525     field to-del as logical
     1526     field order-num as integer
     1527     field fdec as decimal
     1528     field fint as integer
     1529     field flog as logical
     1530     field fchar as character
     1531     index pi  is primary unique d-card
     1532     index cn      card-num
     1533     index cli cli-type cli-code
     1534     index host-dscnt  emitent-host-code status_ d-pcnt
     1535     index host-type  emitent-host-code type d-pcnt
     1536     index oi order-num
     1537     .
     1538   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1539   define  shared  temp-table dc-list-hist no-undo
     1540   field list-table as character
     1541   field id as integer
     1542   field line as integer
     1543   field hist-mode as character
     1544   field des as character
     1545   field num-recs as integer
     1546   field option_ as character
     1547   field item_ as character
     1548   field status_ as character
     1549   field num-add as integer
     1550   field num-ignored as integer
     1551   field done as logical
     1552   field err_ as logical
     1553   field err-mes as character
     1554   index pi is primary
     1555   id
     1556   line
     1557   index isdone
     1558   done
     1559   .
     1560   define input parameter  parparentproc    as handle.
     1561   define input parameter  det-by-obj      as logical.
     1562   define input parameter  det-by-dcard    as logical.
     1563   define input parameter  segm-sex        as logical.
     1564   define input parameter  segm-age        as logical.
     1565   define input parameter  plist           as character.
     1566   define input parameter  x-start-date    as date.
     1567   define input parameter  x-end-date      as date.
     1568   define input parameter  dcard-mode      as integer.
     1569   define variable head-objects    as character    no-undo.
     1570   define variable Report          as class ReportXml no-undo.
     1571   define variable xml_tmp         as character    no-undo.
     1572   define variable xslt_path       as character    no-undo.
     1573   define variable xslt            as character    no-undo.
     1574   define variable xml_res         as character    no-undo.
     1575   define variable temp-purch      as integer      no-undo.
     1576   define variable temp-total      as decimal      no-undo.
     1577   define variable temp-discount   as decimal      no-undo.
     1578   define variable temp-averg      as decimal      no-undo.
     1579   define variable chk-find        as integer      no-undo init 0.
     1580   define variable grab-start      as decimal      no-undo.
     1581   define variable grab-end        as decimal      no-undo.
     1582   define variable chk-exists-in-tmp as logical    no-undo.
     1583   define variable tmp-val-total   as decimal      no-undo.
     1584   define variable tmp-val-quan    as decimal      no-undo.
     1585   define variable i-quantmp           as integer      no-undo.
     1586   define variable d-sumtmp            as decimal      no-undo.
     1587   define variable d-disctmp           as decimal      no-undo.
     1588   define variable list-counter        as integer      no-undo.
     1589   define variable xls-name            as character    no-undo.
     1590   define variable tmp-obj         as character no-undo.
     1591   define variable fnd-good-in-chk as logical      no-undo.
     1592   define variable tmp-sred        as decimal      no-undo format ">>>>9":u.
     1593   define variable tot-purch       as integer no-undo.
     1594   define variable tot-sum         as decimal no-undo.
     1595               define new shared temp-table   t-report-tmp no-undo
     1596               field   period      as character    format "X(21)":u
     1597               field   sex         like ub.person.gender
     1598               field   dcard-num   like ub.dis-card.d-card
     1599               field   purchases   as integer
     1600               field   total-sum   as decimal      format ">>>>>>>>9":u
     1601               field   discount    as decimal      format ">>>>9":u
     1602               field   averg       as decimal      format ">>>>9":u
     1603               field   t-object    as character
     1604               index   ind-prim    dcard-num
     1605               index   ind-period  period
     1606               index   ind-object  t-object
     1607               index   ind-sex     sex.
     1608               define temp-table t-cards no-undo
     1609               field   dcard       like ub.dis-card.d-card
     1610               index   ind-dc      dcard.
     1611   FUNCTION get-sex RETURNS CHARACTER
     1612           ( input sex as logical ) FORWARD.
     1613   FUNCTION get-sex RETURNS CHARACTER
     1614               ( input sex as logical ):
     1615   if sex then return "Ж":u.
     1616   else if not sex then return "М":u.
     1617   else return "Не указано":u.
     1618   END FUNCTION.
     1619   function calc-age-in-years returns decimal
     1620       ( input bday as date):
     1621       define variable ret-age as integer no-undo.
     1622       ret-age = integer(entry(3 , string(cur-time-date()) , "/")) - integer(entry(3,string(bday,"99/99/9999"),"/")).
     1623       if integer(entry(2 , string(cur-time-date()) , "/")) < integer(entry(2,string(bday,"99/99/9999"),"/"))
     1624           then ret-age = ret-age - 1.
     1625       else if integer(entry(2,string(cur-time-date()),"/")) = integer(entry(2,string(bday,"99/99/9999"),"/")) and integer(entry(1,string(cur-time-date()),"/")) < integer(entry(1,string(bday,"99/99/9999"),"/"))
     1626           then ret-age = ret-age - 1.
     1627       define variable result as decimal no-undo.
     1628       result = ret-age.
     1629       return result.
     1630   end function.
     1631   function grab returns decimal
     1632       (input frst as logical, input period as character):
     1633       define variable val as decimal no-undo.
     1634       if period = "0" and frst then return 0.
     1635       else if period = "0" and not frst then return 9999.
     1636       if frst then
     1637       do:
     1638           val = decimal(entry(1,period,"-":u)).
     1639       end.
     1640       else do:
     1641           if entry(2,period,"-":u) = "...":u then
     1642               val = 9999.
     1643           else
     1644               val = decimal(entry(2,period,"-":u)).
     1645       end.
     1646       return val.
     1647   end function.
     1648   procedure fill-table:
     1649       define input parameter p-summ as decimal format ">>>>>>>>9":u.
     1650       define input parameter p-dsct as decimal format ">>>>9":u.
     1651       define input parameter p-quan as integer.
     1652       define input parameter p-card like dis-card.d-card.
     1653       define input parameter p-obj  as character.
     1654       define input parameter p-psn  like person.psn-code.
     1655       define variable var-card      as logical no-undo init no.
     1656       for first person where person.psn-code = p-psn:
     1657           create t-report-tmp.
     1658               t-report-tmp.t-object = p-obj.
     1659               t-report-tmp.averg = p-summ / p-quan.
     1660               t-report-tmp.dcard-num = p-card.
     1661               t-report-tmp.discount = p-dsct.
     1662               if not segm-age then
     1663                   t-report-tmp.period = "".
     1664               else do:
     1665                   if person.date-birth = ? then
     1666                       t-report-tmp.period = "остальные".
     1667                   else if grab-start > 0 and grab-end < 9999 then
     1668                       t-report-tmp.period = " oт ":u + string(grab-start) + " до ":u + string(grab-end).
     1669                   else if grab-start = 0 and grab-end < 9999 then
     1670                       t-report-tmp.period = " до ":u + string(grab-end).
     1671                   else if grab-start > 0 and grab-start < 9999 and grab-end = 9999 then
     1672                       t-report-tmp.period = " oт ":u + string(grab-start).
     1673               end.
     1674               t-report-tmp.purchases = p-quan.
     1675               if segm-sex then
     1676                   t-report-tmp.sex = person.gender.
     1677               else
     1678                   t-report-tmp.sex = no.
     1679               t-report-tmp.total-sum = p-summ.
     1680               for first t-cards where t-cards.dcard = p-card:
     1681                   var-card = yes.
     1682               end.
     1683               if not var-card then do:
     1684                   create t-cards.
     1685                   t-cards.dcard = p-card.
     1686               end.
     1687       end.
     1688   end.
     1689   if x-selectgood = 2 then do:
     1690       for each gds-list exclusive-lock:
     1691           delete gds-list.
     1692       end.
     1693       for each ub.goods no-lock:
     1694           for first tmp#grp where tmp#grp.is-term and tmp#grp.grp-name = goods.grp-name:
     1695               create gds-list.
     1696               assign
     1697                   gds-list.artic = ub.goods.artic
     1698                   gds-list.gds-code = ub.goods.gds-code
     1699                   gds-list.prod-type = ub.goods.prod-type
     1700                   gds-list.prod-code = ub.goods.prod-code
     1701               .
     1702           end.
     1703       end.
     1704   end.
     1705   if dcard-mode = 0 then do:
     1706       for each dc-list:
     1707           delete dc-list.
     1708       end.
     1709       for each dis-card no-lock:
     1710       create dc-list.
     1711       assign
     1712           dc-list.d-card = dis-card.d-card.
     1713           dc-list.card-num = dis-card.card-num.
     1714           dc-list.cli-type = dis-card.cli-type.
     1715           dc-list.cli-code = dis-card.cli-code.
     1716           dc-list.issue-date = dis-card.issue-date.
     1717       end.
     1718   end.
     1719   if not segm-age then
     1720   plist = "0".
     1721   for each dc-list where dc-list.cli-type = 'чел':U:
     1722       list-counter = 0.
     1723       do while list-counter < num-entries(plist, ","):
     1724           list-counter = list-counter + 1.
     1725           grab-start = grab(yes, entry(list-counter, plist, ",")).
     1726           grab-end = grab(no, entry(list-counter, plist, ",")).
     1727           for first person where person.psn-code = dc-list.cli-code
     1728           no-lock:
     1729               if not segm-age
     1730               or person.date-birth = ? and list-counter = 1
     1731               or calc-age-in-years(person.date-birth) >= grab-start
     1732               and calc-age-in-years(person.date-birth) <= grab-end
     1733               then do:
     1734                   i-quantmp = 0.
     1735                   d-disctmp = 0.
     1736                   d-sumtmp = 0.
     1737                   if not det-by-obj then do:
     1738                       i-quantmp = 0.
     1739                       d-disctmp = 0.
     1740                       d-sumtmp = 0.
     1741                       for each obj-list:
     1742                           for each chk-doc where chk-doc.tot-doc >= 0
     1743                           and chk-doc.d-card = dc-list.d-card
     1744                           and chk-doc.chk-date >= x-date-start
     1745                           and chk-doc.chk-date <= x-date-end
     1746                           and chk-doc.obj-type = obj-list.obj-type
     1747                           and chk-doc.obj-code = obj-list.obj-code
     1748                           no-lock:
     1749                               fnd-good-in-chk = false.
     1750                               if x-selectgood = 1 then do:
     1751                                   fnd-good-in-chk = true.
     1752                                   d-disctmp = d-disctmp  + chk-doc.discnt.
     1753                                   d-sumtmp = d-sumtmp + chk-doc.tot-doc.
     1754                               end.
     1755                               else do:
     1756                                   for each gds-list:
     1757                                       for each chk-gds where chk-gds.doc-code = chk-doc.doc-code
     1758                                       no-lock:
     1759                                           for first bar-code where bar-code.gds-code = gds-list.gds-code
     1760                                           and bar-code.b-code = chk-gds.b-code
     1761                                           no-lock:
     1762                                               fnd-good-in-chk = true.
     1763                                               d-disctmp = d-disctmp  + chk-gds.discnt.
     1764                                               d-sumtmp = d-sumtmp + chk-gds.price-base * chk-gds.doc-qnty.
     1765                                           end.
     1766                                       end.
     1767                                   end.
     1768                               end.
     1769                               if fnd-good-in-chk then i-quantmp = i-quantmp + 1.
     1770                           end.
     1771                       end.
     1772                       if d-sumtmp > 0 and i-quantmp > 0 then do:
     1773                           run fill-table(input d-sumtmp, input d-disctmp, input i-quantmp, input dc-list.d-card, input "", input person.psn-code).
     1774                       end.
     1775                   end.
     1776                   else do:
     1777                       for each obj-list:
     1778                           i-quantmp = 0.
     1779                           d-disctmp = 0.
     1780                           d-sumtmp = 0.
     1781                           for each chk-doc where chk-doc.tot-doc >= 0
     1782                           and chk-doc.d-card = dc-list.d-card
     1783                           and chk-doc.chk-date >= x-date-start
     1784                           and chk-doc.chk-date <= x-date-end
     1785                           and chk-doc.obj-type = obj-list.obj-type
     1786                           and chk-doc.obj-code = obj-list.obj-code
     1787                           no-lock:
     1788                               fnd-good-in-chk = false.
     1789                               if x-selectgood = 1 then do:
     1790                                   fnd-good-in-chk = true.
     1791                                   d-disctmp = d-disctmp  + chk-doc.discnt.
     1792                                   d-sumtmp = d-sumtmp + chk-doc.tot-doc.
     1793                               end.
     1794                               else do:
     1795                                   for each gds-list:
     1796                                       for each chk-gds where chk-gds.doc-code = chk-doc.doc-code
     1797                                       no-lock:
     1798                                           for first bar-code where bar-code.gds-code = gds-list.gds-code
     1799                                           and bar-code.b-code = chk-gds.b-code
     1800                                           no-lock:
     1801                                               fnd-good-in-chk = true.
     1802                                               d-disctmp = d-disctmp  + chk-gds.discnt.
     1803                                               d-sumtmp = d-sumtmp + chk-gds.price-base * chk-gds.doc-qnty.
     1804                                           end.
     1805                                       end.
     1806                                   end.
     1807                               end.
     1808                               if fnd-good-in-chk then i-quantmp = i-quantmp + 1.
     1809                           end.
     1810                           if d-sumtmp > 0 and i-quantmp > 0 then do:
     1811                               tmp-obj = obj-list.obj-type + string(obj-list.obj-code).
     1812                               run fill-table(input d-sumtmp, input d-disctmp, input i-quantmp, input dc-list.d-card, input obj-list.obj-type + string(obj-list.obj-code), input person.psn-code).
     1813                           end.
     1814                       end.
     1815                   end.
     1816               end.
     1817           end.
     1818       end.
     1819   end.
     1820   for first t-report-tmp no-lock:
     1821     chk-find = 1.
     1822   end.
     1823   if chk-find = 0 then do:
     1824       message "По текущим дисконтным картам не найдено ни одной покупки." view-as alert-box.
     1825       return.
     1826   end.
     1827   for each t-cards:
     1828       accumulate t-cards.dcard (count).
     1829   end.
     1830   for each obj-list:
     1831       head-objects = head-objects + obj-list.obj-type + string(obj-list.obj-code) + ", ".
     1832   end.
     1833   xml_tmp = string(session:temp-directory + "segment-tmp.xml").
     1834   Report = new ReportXml(xml_tmp).
     1835   if segm-sex and segm-age then
     1836       Report:add-element("mode","1").
     1837   if not segm-sex and segm-age then
     1838       Report:add-element("mode","2").
     1839   if segm-sex and not segm-age then
     1840       Report:add-element("mode","3").
     1841   if det-by-obj then
     1842       Report:add-element("detmode","1").
     1843   else if not det-by-obj then
     1844       Report:add-element("detmode","0").
     1845   Report:worksheet("Лист 1").
     1846   Report:worksheet-header("start").
     1847   if segm-sex and segm-age then
     1848       Report:worksheet-header("Сегментация клиентов по возрасту и полу.").
     1849   if not segm-sex and segm-age then
     1850       Report:worksheet-header("Сегментация клиентов по возрасту.").
     1851   if segm-sex and not segm-age then
     1852   Report:worksheet-header("Сегментация клиентов по полу.").
     1853   Report:worksheet-header("За период с " + string(x-date-start,"99/99/9999") + " по " + string(x-date-end,"99/99/9999")).
     1854   Report:worksheet-header("Дата создания: " + string(cur-time-date())).
     1855   Report:worksheet-header("Выбор объектов: " + head-objects).
     1856   Report:worksheet-header("end").
     1857   if segm-sex and segm-age then do:
     1858       Report:table-columns("70,70,100,100,120,100,100").
     1859       Report:table-types = "String,String,Number,Number,Number,Number,Number".
     1860       Report:table-header("Возраст|Пол|№ ДК|Количество покупок|Сумма покупки|Скидка по ДК|Средняя покупка","40","4").
     1861   end.
     1862   if not segm-sex and segm-age then do:
     1863       Report:table-columns("70,70,100,100,120,100,100").
     1864       Report:table-types = "String,String,Number,Number,Number,Number,Number".
     1865       Report:table-header("|Пол|№ ДК|Количество покупок|Сумма покупки|Скидка по ДК|Средняя покупка","40","4").
     1866   end.
     1867   if segm-sex and not segm-age then do:
     1868       Report:table-columns("70,70,100,100,120,100,100").
     1869       Report:table-types = "String,String,Number,Number,Number,Number,Number".
     1870       Report:table-header("Возраст||№ ДК|Количество покупок|Сумма покупки|Скидка по ДК|Средняя покупка","40","4").
     1871   end.
     1872   for each t-report-tmp break by t-report-tmp.t-object by t-report-tmp.period by t-report-tmp.sex by t-report-tmp.dcard-num:
     1873       if first-of (t-report-tmp.t-object) then do:
     1874           report:start-element("object").
     1875           Report:add-attr("value","Объект: " + t-report-tmp.t-object).
     1876           if not segm-age then
     1877               report:start-element("period").
     1878       end.
     1879       if segm-age and first-of (t-report-tmp.period) then do:
     1880           report:start-element("period").
     1881           Report:add-attr("value",t-report-tmp.period).
     1882           if not segm-sex then
     1883               report:start-element("gender").
     1884       end.
     1885       if segm-sex and first-of (t-report-tmp.sex) then do:
     1886           report:start-element("gender").
     1887           report:add-attr("value", get-sex(t-report-tmp.sex)).
     1888       end.
     1889       if det-by-dcard then
     1890           Report:table-row(""
     1891                       + "|" +        ""
     1892                       + "|" +        string(t-report-tmp.dcard-num)
     1893                       + "|" +        string(t-report-tmp.purchases)
     1894                       + "|" +        string(t-report-tmp.total-sum)
     1895                       + "|" +        string(t-report-tmp.discount)
     1896                       + "|" +        string(t-report-tmp.averg)
     1897           ).
     1898       if not det-by-dcard then do:
     1899           if segm-sex then do:
     1900               accumulate t-report-tmp.purchases (total by t-report-tmp.sex).
     1901               accumulate t-report-tmp.total-sum (total by t-report-tmp.sex).
     1902               accumulate t-report-tmp.discount  (total by t-report-tmp.sex).
     1903               if last-of (t-report-tmp.sex) then do:
     1904                       Report:table-row(""
     1905                                   + "|" +        ""
     1906                                   + "|" +        ""
     1907                                   + "|" +        string(accum total by t-report-tmp.sex t-report-tmp.purchases)
     1908                                   + "|" +        string(accum total by t-report-tmp.sex t-report-tmp.total-sum)
     1909                                   + "|" +        string(accum total by t-report-tmp.sex t-report-tmp.discount)
     1910                                   + "|" +        string(decimal(string(accum total by t-report-tmp.sex t-report-tmp.total-sum)) / decimal(string(accum total by t-report-tmp.sex t-report-tmp.purchases)))
     1911                       ).
     1912               end.
     1913           end.
     1914           else if segm-age then do:
     1915               accumulate t-report-tmp.purchases (total by t-report-tmp.period).
     1916               accumulate t-report-tmp.total-sum (total by t-report-tmp.period).
     1917               accumulate t-report-tmp.discount  (total by t-report-tmp.period).
     1918               if last-of (t-report-tmp.period) then do:
     1919                   Report:table-row(""
     1920                               + "|" +        ""
     1921                               + "|" +        ""
     1922                               + "|" +        string(accum total by t-report-tmp.period t-report-tmp.purchases)
     1923                               + "|" +        string(accum total by t-report-tmp.period t-report-tmp.total-sum)
     1924                               + "|" +        string(accum total by t-report-tmp.period t-report-tmp.discount)
     1925                               + "|" +        string(decimal(string(accum total by t-report-tmp.period t-report-tmp.total-sum)) / decimal(string(accum total by t-report-tmp.period t-report-tmp.purchases)))
     1926                   ).
     1927               end.
     1928           end.
     1929       end.
     1930           accumulate t-report-tmp.dcard-num (count by t-report-tmp.t-object).
     1931           accumulate t-report-tmp.purchases (total by t-report-tmp.t-object).
     1932           accumulate t-report-tmp.total-sum (total by t-report-tmp.t-object).
     1933           accumulate t-report-tmp.discount  (total by t-report-tmp.t-object).
     1934           tot-purch = tot-purch + t-report-tmp.purchases.
     1935           tot-sum   = tot-sum   + t-report-tmp.total-sum.
     1936       if segm-sex and last-of (t-report-tmp.sex) then do:
     1937           report:end-element("gender").
     1938       end.
     1939       if segm-age and last-of (t-report-tmp.period) then do:
     1940           if not segm-sex then
     1941               report:end-element("gender").
     1942           report:end-element("period").
     1943       end.
     1944       if last-of (t-report-tmp.t-object) then do:
     1945       if not segm-age then
     1946           report:end-element("period").
     1947           if det-by-obj then do:
     1948               tmp-sred = accum total by t-report-tmp.t-object t-report-tmp.total-sum.
     1949               tmp-sred = tmp-sred / accum total by t-report-tmp.t-object t-report-tmp.purchases.
     1950               if segm-sex and segm-age then
     1951                   Report:table-subtotal("Итоги по объекту"  +
     1952                                   "||" + string(accum count by t-report-tmp.t-object t-report-tmp.dcard-num ) +
     1953                                   "|" + string(accum total by t-report-tmp.t-object t-report-tmp.purchases) +
     1954                                   "|" + string(accum total by t-report-tmp.t-object t-report-tmp.total-sum) +
     1955                                   "|" + string(accum total by t-report-tmp.t-object t-report-tmp.discount) +
     1956                                   "|" + string(tmp-sred)
     1957                   ).
     1958               else
     1959                   Report:table-subtotal("Итоги по объекту"+
     1960                                   "|" + string(accum count by t-report-tmp.t-object t-report-tmp.dcard-num) +
     1961                                   "|" + string(accum total by t-report-tmp.t-object t-report-tmp.purchases) +
     1962                                   "|" + string(accum total by t-report-tmp.t-object t-report-tmp.total-sum) +
     1963                                   "|" + string(accum total by t-report-tmp.t-object t-report-tmp.discount) +
     1964                                   "|" + string(tmp-sred)
     1965                   ).
     1966           end.
     1967           report:end-element("object").
     1968       end.
     1969   end.
     1970   tmp-sred = accum total t-report-tmp.total-sum.
     1971   tmp-sred = tmp-sred / accum total t-report-tmp.purchases.
     1972   if segm-sex and segm-age then
     1973       Report:table-total("Итоги"  +
     1974                       "||" + string(accum count t-cards.dcard ) +
     1975                       "|" + string(tot-purch) +
     1976                       "|" + string(tot-sum) +
     1977                       "|" + string(accum total t-report-tmp.discount) +
     1978                       "|" + string(tmp-sred)
     1979       ).
     1980   else
     1981       Report:table-total("Итоги"+
     1982                       "|" + string(accum count t-cards.dcard ) +
     1983                       "|" + string(tot-purch) +
     1984                       "|" + string(tot-sum) +
     1985                       "|" + string(accum total t-report-tmp.discount) +
     1986                       "|" + string(tmp-sred)
     1987       ).
     1988   Report:worksheet("end").
     1989   delete object Report.
     1990   xslt_path = search("exe\xslt.exe").
     1991   xslt      = search("exe\segmentation.xsl").
     1992   xml_res   = string(session:temp-directory + "segment-res.xml").
     1993   os-command silent value(xslt_path + " " + xslt + " " + xml_tmp + " " + xml_res).
     1994   define variable chExcel as com-handle.
     1995   create "Excel.Application" chExcel no-error.
     1996       if error-status :error then do:
     1997           message
     1998           "Ошибка при запуске Excel" skip
     1999           error-status :get-message(1) skip
     2000           view-as alert-box error .
     2001           undo, return error .
     2002       end.
     2003   chExcel:Visible = false.
     2004   chExcel:DisplayAlerts = false.
     2005   chExcel:Workbooks:open(xml_res).
     2006   xls-name = string(session:temp-directory + "rep_" + replace(replace(string(now,"99.99.99 HH:MM:SS"),":","-")," ","_") + ".xls").
     2007   chExcel:ActiveWorkBook:SaveAs(xls-name,56, , , , , true).
     2008   chExcel:Visible = true.
     2009   chExcel:DisplayAlerts = true.
     2010   release object chExcel no-error.
     2011   os-delete value(xml_res).
