      312   procedure create_obj-list :
      313      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      314      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      315      do
      316      on error undo, return error return-value
      317      :
      318         define buffer cli-obj for ub.clients .
      319         define variable p-var as integer no-undo .
      320         define buffer buf_obj-list for obj-list .
      321         find last buf_obj-list  use-index pi no-error .
      322         if available buf_obj-list
      323         then
      324            p-var = buf_obj-list.obj-id + 1.
      325         else
      326            p-var = 1.
      327         find first cli-obj where
      328                   cli-obj.obj-type = p-obj-type
      329               and cli-obj.obj-code = p-obj-code
      330         no-lock no-error.
      331         if available cli-obj
      332         then do:
      333            create buf_obj-list.
      334            assign
      335               buf_obj-list.obj-id   = p-var
      336               buf_obj-list.obj-code = cli-obj.obj-code
      337               buf_obj-list.obj-type = cli-obj.obj-type
      338               buf_obj-list.obj-name = cli-obj.obj-name
      339               buf_obj-list.db-num   = cli-obj.db-num
      340            .
      341         end.
      342      end.
      343   end.
