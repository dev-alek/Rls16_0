      570   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      571   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      572   define  shared variable RepPathName        as character no-undo .
      573   define  shared variable PrintRubl          as logical   no-undo .
      574   PROCEDURE ostatok :
      575   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
      576   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
      577   def input parameter x-tog-shift   as   logical             no-undo.
      578   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
      579   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
      580   def input parameter x-shift-start as integer               no-undo.
      581   def input parameter x-shift-end   as integer               no-undo.
      582   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
      583   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
      584   def input parameter xTog-obj   as log no-undo.
      585   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
      586   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
      587   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
      588   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
      589   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
      590   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
      591   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
      592   def var              Fact-orderS   as char  no-undo.
      593   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
      594      Assign
      595         Fact-order   = 0
      596         Quantity     = 0
      597         Coast_R      = 0
      598         Coast_V      = 0
      599         VAT_R        = 0
      600         VAT_V        = 0 .
      601    x-date-start-t  = x-date-start + 1 .
      602   IF x-date-end = date('') then DO:
      603      Fact-order = 0 .
      604      for each obj-list
      605          where  ( not xtog-obj or
      606                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
      607                 no-lock :
      608         if  x-tog-shift = false then do:
      609                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
      610                               ub.stk-tot.Fact-date <=  x-date-start
      611                               and ub.stk-tot.shift-num = 0
      612                               USE-INDEX fact-date no-lock no-error .
      613              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
      614         End.
      615         Else  DO :
      616             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
      617              (ub.stk-tot.shift-date  = x-date-start-t and
      618               ub.stk-tot.shift-num  < x-shift-start or
      619               ub.stk-tot.shift-date  < x-date-start-t  )
      620               and ub.stk-tot.shift-num  > 0
      621               USE-INDEX Shift-num no-lock no-error .
      622            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
      623           END.
      624       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
      625     End.
      626   End.
      627   Else DO:
      628     For each obj-list  WHERE
      629        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
      630         no-lock :
      631      IF  x-TOG-Shift = False Then DO:
      632          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
      633               ub.stk-tot.Fact-date <= x-date-end
      634               and ub.stk-tot.shift-num = 0
      635               USE-INDEX fact-date no-lock no-error.
      636          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
      637      END.
      638      Else DO:
      639           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
      640               (ub.stk-tot.shift-date  = x-date-end and
      641               ub.stk-tot.shift-num  <= x-shift-end or
      642               ub.stk-tot.shift-date  < x-date-end       ) and
      643               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
      644               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
      645       End.
      646       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
      647     End.
      648   End.
      649   END PROCEDURE.
