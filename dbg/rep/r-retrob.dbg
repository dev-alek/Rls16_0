      764   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
      765   DEFINE BUTTON StopBtn AUTO-END-KEY
      766        LABEL "Стоп"
      767        SIZE 10 BY 1.
      768   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
      769        LABEL "Обработано записей"
      770         VIEW-AS TEXT
      771        SIZE 14 BY .67 NO-UNDO.
      772   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
      773         VIEW-AS TEXT
      774        SIZE 53.25 BY .67
      775        FGCOLOR 1  NO-UNDO.
      776   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
      777         VIEW-AS TEXT
      778        SIZE 53.25 BY .67
      779        FGCOLOR 1  NO-UNDO.
      780   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
      781         VIEW-AS TEXT
      782        SIZE 53.25 BY .67
      783        FGCOLOR 1  NO-UNDO.
      784   DEFINE RECTANGLE RECT-1
      785        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      786        SIZE 55.13 BY 4.46.
      787   DEFINE FRAME InfoFrame
      788        StopBtn AT ROW 4.25 COL 21.75
      789        RecordsString AT ROW 1.21 COL 2 NO-LABEL
      790        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
      791        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
      792        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
      793        RECT-1 AT ROW 1 COL 1
      794       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      795            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      796            TITLE "Процесс"
      797            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
      798   define variable mFrameView      as logical   no-undo init yes.
      799     define variable mFramHandle as handle no-undo.
      800     mFramHandle = frame InfoFrame:handle.
      801     if  log-manager:logfile-name ne ?
      802     then DO:
      803         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      804         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      805         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
      806     end.
      807     mFrameView = not session:batch-mode and mFramHandle:visible.
      808     if mFrameView
      809     then do:
      810       ASSIGN
      811          FRAME InfoFrame:HIDDEN                           = TRUE
      812          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
      813     end.
      814   ON CHOOSE OF StopBtn IN FRAME InfoFrame
      815   DO:
      816     IF not StopProcessing THEN
      817       Message "Вы действительно хотите прервать" SKIP
      818               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
      819                 UPDATE StopProcessing.
      820     IF StopProcessing THEN do:
      821        if mFrameView
      822        then do:
      823           HIDE FRAME InfoFrame.
      824        end.
      825     End.
      826   END.
