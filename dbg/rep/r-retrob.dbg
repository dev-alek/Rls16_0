      899   case X-Radio-Task:
      900     when 1 then do :
      901       run ostatok (
      902           input 0  ,
      903           input ""  ,no,
      904           input x-date-start - 1 ,
      905           input date('')      ,  0, 24,
      906           input 'crsa':U   ,
      907           input '##,##':U,
      908           input false ,
      909           output  v-temp-f-o  ,
      910           output  v-temp-f-o   ,
      911           output  v-temp-f-o   ,
      912           output  v-temp-f-o     ,
      913           output  v-temp-f-o     ,
      914           output  v-start-fact-order ).
      915       run ostatok (
      916           input 0  ,
      917           input ""  ,no,
      918           input x-date-start  ,
      919           input x-date-end    ,  0, 24,
      920           input 'crsa':U   ,
      921           input '##,##':U,
      922           input false ,
      923           output  v-temp-f-o  ,
      924           output  v-temp-f-o   ,
      925           output  v-temp-f-o   ,
      926           output  v-temp-f-o     ,
      927           output  v-temp-f-o     ,
      928           output  v-end-fact-order ).
      929     end.
      930     when 2 then do :
      931       run ostatok (
      932           input 0  ,
      933           input ""  ,yes,
      934           input x-date-start - 1 ,
      935           input date('')      ,  0, 24,
      936           input 'crsa':U   ,
      937           input '##,##':U,
      938           input false ,
      939           output  v-temp-f-o  ,
      940           output  v-temp-f-o   ,
      941           output  v-temp-f-o   ,
      942           output  v-temp-f-o     ,
      943           output  v-temp-f-o     ,
      944           output  v-start-fact-order ).
      945       run ostatok (
      946           input 0  ,
      947           input ""  ,yes,
      948           input x-date-start  ,
      949           input x-date-end    ,  0, 24,
      950           input 'crsa':U   ,
      951           input '##,##':U,
      952           input false ,
      953           output  v-temp-f-o  ,
      954           output  v-temp-f-o   ,
      955           output  v-temp-f-o   ,
      956           output  v-temp-f-o     ,
      957           output  v-temp-f-o     ,
      958           output  v-end-fact-order ).
      959     end.
      960   end case.
      961   assign v-account = ( if integer( 25 ) = 0 then 100 else integer( 25 ) ).
      962     if  log-manager:logfile-name ne ?
      963     then DO:
      964         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
      965     end.
      966     if not session:batch-mode then
      967     do:
      968       VIEW FRAME InfoFrame.
      969       mFrameView = true.
      970     end.
      971      v-button-stop = false .
      972         if mFrameView
      973         then do:
      974         if v-button-stop then view STOPBTN in frame InfoFrame.
      975                          else Hide STOPBTN in frame InfoFrame.
      976         end.
      977     for each obj-list :
      978         case x-SelectGood :
      979         when 1 then do:
      980             for each buf_gds-obj no-lock
      981               where buf_gds-obj.obj-type  = obj-list.obj-type
      982                 and buf_gds-obj.obj-code  = obj-list.obj-code
      983               :
      984               run fill-tt in this-procedure.          end.
      985         end.
      986           when 3 then do:
      987             for each G#cli ,
      988                 each buf_gds-obj  no-lock
      989               where buf_gds-obj.obj-type  = obj-list.obj-type
      990                 and buf_gds-obj.obj-code  = obj-list.obj-code
      991                 and buf_gds-obj.prod-type = G#cli.obj-type
      992                 and buf_gds-obj.prod-code = G#cli.obj-code
      993                use-index pi  :
      994                run fill-tt in this-procedure.
      995             end.
      996           end .
      997           when 2 then do:
      998             for each tmp#grp :
      999               run grplib-get-full-name in this-procedure( input tmp#grp.node-code, output CurrGrpName ) .
     1000               for each buf_gds-obj no-lock
     1001                 where buf_gds-obj.obj-type  = obj-list.obj-type
     1002                   and buf_gds-obj.obj-code  = obj-list.obj-code
     1003                   and buf_gds-obj.grp-name begins CurrGrpName
     1004                 use-index obj-grp :
     1005                 run fill-tt in this-procedure.
     1006               end .
     1007             end.
     1008           end.
     1009          otherwise do:
     1010             for each gds-list ,
     1011                 each buf_gds-obj no-lock
     1012               where buf_gds-obj.obj-type  = obj-list.obj-type
     1013                 and buf_gds-obj.obj-code  = obj-list.obj-code
     1014                 and buf_gds-obj.artic     = gds-list.artic
     1015                 and buf_gds-obj.prod-type = gds-list.prod-type
     1016                 and buf_gds-obj.prod-code = gds-list.prod-code
     1017               :
     1018               run fill-tt in this-procedure.
     1019             end.
     1020           end.
     1021         end case.
     1022     end.
     1023   run rep/extitle.p (1).
     1024   for each tt-supp no-lock :
     1025     if p-det-tov then do :
     1026       if Make-Excel then  put   stream ForExcel unformatted
     1027       tt-supp.name                      CHR(9)
     1028       tt-supp.type + " " tt-supp.code   CHR(9)
     1029                                         CHR(9)
     1030       round(tt-supp.sum,2)              CHR(9)
     1031       round(tt-supp.sum-vat,2)          CHR(9)
     1032                                         CHR(9)
     1033                                         CHR(9)
     1034                                         CHR(9)
     1035       round(tt-supp.sum-bonus,2)        CHR(9)
     1036       SKIP.
     1037       if not p-itog-prod then do :
     1038         for each tt-gds where tt-gds.supp-type = tt-supp.type  and
     1039                               tt-gds.supp-code = tt-supp.code  no-lock :
     1040           if      tt-gds.method = "vat-yes" then v-method = "Приход с НДС".
     1041           else if tt-gds.method = "vat-no"  then v-method = "Приход без НДС".
     1042           else v-method = " - ".
     1043           if Make-Excel then  put   stream ForExcel unformatted
     1044           "     " + tt-gds.name       CHR(9)
     1045           tt-gds.code       CHR(9)
     1046           tt-gds.artic      CHR(9)
     1047           round(tt-gds.sum,2)        CHR(9)
     1048           round(tt-gds.sum-vat,2)    CHR(9)
     1049           tt-gds.pct-rate   CHR(9)
     1050           tt-gds.sum-rate   CHR(9)
     1051           v-method          CHR(9)
     1052           round(tt-gds.sum-bonus,2)  CHR(9)
     1053           SKIP.
     1054         end.
     1055       end.
     1056     end.
     1057     else do :
     1058       if Make-Excel then  put   stream ForExcel unformatted
     1059       tt-supp.name                      CHR(9)
     1060       tt-supp.type + " " tt-supp.code   CHR(9)
     1061       round(tt-supp.sum,2)              CHR(9)
     1062       round(tt-supp.sum-vat,2)          CHR(9)
     1063       round(tt-supp.sum-bonus,2)        CHR(9)
     1064       SKIP.
     1065     end.
     1066     if p-itog-prod then do :
     1067       for each tt-prod where tt-prod.supp-type = tt-supp.type and
     1068                              tt-prod.supp-code = tt-supp.code no-lock :
     1069         if p-det-tov then do :
     1070           if Make-Excel then  put   stream ForExcel unformatted
     1071           "   " + tt-prod.name              CHR(9)
     1072           tt-prod.type + " " tt-prod.code   CHR(9)
     1073                                             CHR(9)
     1074           round(tt-prod.sum,2)              CHR(9)
     1075           round(tt-prod.sum-vat,2)          CHR(9)
     1076                                             CHR(9)
     1077                                             CHR(9)
     1078                                             CHR(9)
     1079           round(tt-prod.sum-bonus,2)        CHR(9)
     1080           SKIP.
     1081           for each tt-gds where tt-gds.prod-type = tt-prod.type       and
     1082                                 tt-gds.prod-code = tt-prod.code       and
     1083                                 tt-gds.supp-type = tt-prod.supp-type  and
     1084                                 tt-gds.supp-code = tt-prod.supp-code  no-lock :
     1085             if      tt-gds.method = "vat-yes" then v-method = "Приход с НДС".
     1086             else if tt-gds.method = "vat-no"  then v-method = "Приход без НДС".
     1087             else v-method = " - ".
     1088             if Make-Excel then  put   stream ForExcel unformatted
     1089             "     " + tt-gds.name       CHR(9)
     1090             tt-gds.code       CHR(9)
     1091             tt-gds.artic      CHR(9)
     1092             round(tt-gds.sum,2)        CHR(9)
     1093             round(tt-gds.sum-vat,2)    CHR(9)
     1094             tt-gds.pct-rate   CHR(9)
     1095             tt-gds.sum-rate   CHR(9)
     1096             v-method          CHR(9)
     1097             round(tt-gds.sum-bonus,2)  CHR(9)
     1098             SKIP.
     1099           end.
     1100         end.
     1101         else do :
     1102           if Make-Excel then  put   stream ForExcel unformatted
     1103           "   " + tt-prod.name              CHR(9)
     1104           tt-prod.type + " " tt-prod.code   CHR(9)
     1105           round(tt-prod.sum,2)              CHR(9)
     1106           round(tt-prod.sum-vat,2)          CHR(9)
     1107           round(tt-prod.sum-bonus,2)        CHR(9)
     1108           SKIP.
     1109         end.
     1110       end.
     1111     end.
     1112   end.
     1113   if Make-Excel then output stream ForExcel close.
     1114   if mFrameView
     1115   then do:
     1116      HIDE FRAME InfoFrame.
     1117   end.
     1118   if session :set-wait-state( "" ) then.
     1119   run rep/runexcel.p (string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txt").
     1120   procedure fill-tt :
     1121     find first G#CUSTOMER no-error .
     1122     if not available G#CUSTOMER then
     1123     for each buf_clients no-lock :
     1124       v-temp-sum  = 0 .
     1125       v-temp-vozv = 0 .
     1126       find first buf2_clients where buf2_clients.obj-type = obj-list.obj-type and
     1127                                     buf2_clients.obj-code = obj-list.obj-code no-lock.
     1128       for each   buf_contract where buf_contract.contract-date-beg <= x-date-start          and
     1129                                    (buf_contract.contract-date-end >= x-date-start or
     1130                                     buf_contract.contract-date-end = ?)                     and
     1131                                     buf_contract.status_            = 'тек':U      and
     1132                                     buf_contract.host-code          = buf2_clients.host-code    and
     1133                                     buf_contract.doc-type           = 'при':U     and
     1134                                     buf_contract.cli-type           = buf_clients.obj-type  and
     1135                                     buf_contract.cli-code           = buf_clients.obj-code  no-lock :
     1136         find last  buf_contract-specif where buf_contract-specif.host-code    = buf_contract.host-code    and
     1137                                              buf_contract-specif.contract-num = buf_contract.contract-code and
     1138                                              buf_contract-specif.gds-code     = buf_gds-obj.gds-code      no-lock no-error.
     1139         if available buf_contract-specif then do :
     1140           find first tt-gds where tt-gds.supp-type    = buf_clients.obj-type  and
     1141                                   tt-gds.supp-code    = buf_clients.obj-code  and
     1142                                   tt-gds.prod-type    = buf_gds-obj.prod-type and
     1143                                   tt-gds.prod-code    = buf_gds-obj.prod-code and
     1144                                   tt-gds.code         = buf_gds-obj.gds-code  no-lock no-error.
     1145           if not available tt-gds then do :
     1146             find first buf_goods where buf_goods.gds-code = buf_gds-obj.gds-code no-lock.
     1147             create tt-gds.
     1148             assign  tt-gds.supp-type    = buf_clients.obj-type
     1149                     tt-gds.supp-code    = buf_clients.obj-code
     1150                     tt-gds.prod-type    = buf_gds-obj.prod-type
     1151                     tt-gds.prod-code    = buf_gds-obj.prod-code
     1152                     tt-gds.code         = buf_gds-obj.gds-code
     1153                     tt-gds.name         = buf_goods.gds-name
     1154                     tt-gds.artic        = buf_gds-obj.artic
     1155                     tt-gds.sum          = 0
     1156                     tt-gds.sum-vat      = 0
     1157                     tt-gds.sum-bonus    = 0
     1158             .
     1159             find first buf_contract-specif-attr where buf_contract-specif-attr.host-code    = buf_contract-specif.host-code     and
     1160                                                       buf_contract-specif-attr.contract-num = buf_contract-specif.contract-num  and
     1161                                                       buf_contract-specif-attr.gds-code     = buf_contract-specif.gds-code      and
     1162                                                       buf_contract-specif-attr.attr-code    = "retro-bonus"                     no-lock no-error.
     1163             if available buf_contract-specif-attr then do :
     1164               do i = 1 to num-entries(buf_contract-specif-attr.attr-value, ';') - 1 :
     1165                 if date(entry(1, entry(i, buf_contract-specif-attr.attr-value, ';')))  <= x-date-start and
     1166                    date(entry(2, entry(i, buf_contract-specif-attr.attr-value, ';')))  >= x-date-start then do :
     1167                   assign  tt-gds.pct-rate = decimal (entry(3, entry(i, buf_contract-specif-attr.attr-value, ';')))
     1168                           tt-gds.sum-rate = decimal (entry(4, entry(i, buf_contract-specif-attr.attr-value, ';')))
     1169                           tt-gds.method   =         (entry(5, entry(i, buf_contract-specif-attr.attr-value, ';')))
     1170                           tt-gds.vozvrat  = logical (entry(6, entry(i, buf_contract-specif-attr.attr-value, ';')))
     1171                   .
     1172                   leave.
     1173                 end.
     1174               end.
     1175               if tt-gds.pct-rate = ? then tt-gds.pct-rate = 0.
     1176               if tt-gds.sum-rate = ? then tt-gds.sum-rate = 0.
     1177               if tt-gds.method   = ? then tt-gds.method = "-".
     1178             end.
     1179             else assign tt-gds.pct-rate = 0
     1180                         tt-gds.sum-rate = 0
     1181                         tt-gds.method   = "-"
     1182             .
     1183           end.
     1184           find first tt-prod where tt-prod.type       = tt-gds.prod-type and
     1185                                    tt-prod.code       = tt-gds.prod-code and
     1186                                    tt-prod.supp-type  = tt-gds.supp-type and
     1187                                    tt-prod.supp-code  = tt-gds.supp-code no-lock no-error.
     1188           if not available tt-prod then do :
     1189             find first buf2_clients where buf2_clients.obj-type = tt-gds.prod-type and
     1190                                           buf2_clients.obj-code = tt-gds.prod-code no-lock.
     1191             create tt-prod.
     1192             assign  tt-prod.type       = tt-gds.prod-type
     1193                     tt-prod.code       = tt-gds.prod-code
     1194                     tt-prod.supp-type  = tt-gds.supp-type
     1195                     tt-prod.supp-code  = tt-gds.supp-code
     1196                     tt-prod.name       = buf2_clients.obj-name
     1197                     tt-prod.sum        = 0
     1198                     tt-prod.sum-vat    = 0
     1199                     tt-prod.sum-bonus  = 0
     1200             .
     1201           end.
     1202           find first tt-supp where tt-supp.type = buf_clients.obj-type and
     1203                                    tt-supp.code = buf_clients.obj-code no-lock no-error.
     1204           if not available tt-supp then do :
     1205             create tt-supp.
     1206             assign  tt-supp.type      = buf_clients.obj-type
     1207                     tt-supp.code      = buf_clients.obj-code
     1208                     tt-supp.name      = buf_clients.obj-name
     1209                     tt-supp.sum       = 0
     1210                     tt-supp.sum-vat   = 0
     1211                     tt-supp.sum-bonus = 0
     1212             .
     1213           end.
     1214           for last buf_stk-supp-line where buf_stk-supp-line.artic        = buf_gds-obj.artic                 and
     1215                                            buf_stk-supp-line.prod-type    = buf_gds-obj.prod-type             and
     1216                                            buf_stk-supp-line.prod-code    = buf_gds-obj.prod-code             and
     1217                                            buf_stk-supp-line.obj-type     = obj-list.obj-type                 and
     1218                                            buf_stk-supp-line.obj-code     = obj-list.obj-code                 and
     1219                                            buf_stk-supp-line.cli-type     = buf_clients.obj-type              and
     1220                                            buf_stk-supp-line.cli-code     = buf_clients.obj-code              and
     1221                                            buf_stk-supp-line.sum-type     = 'sadt':U + 'ie':U  and
     1222                                            buf_stk-supp-line.fact-order  <= v-end-fact-order                  no-lock :
     1223             assign tt-gds.sum       = tt-gds.sum + buf_stk-supp-line.sum-rubl
     1224                    tt-gds.sum-vat   = tt-gds.sum-vat + buf_stk-supp-line.sum-rubl - buf_stk-supp-line.vat-rubl
     1225                    tt-prod.sum      = tt-prod.sum + buf_stk-supp-line.sum-rubl
     1226                    tt-prod.sum-vat  = tt-prod.sum-vat + buf_stk-supp-line.sum-rubl - buf_stk-supp-line.vat-rubl
     1227                    tt-supp.sum      = tt-supp.sum + buf_stk-supp-line.sum-rubl
     1228                    tt-supp.sum-vat  = tt-supp.sum-vat + buf_stk-supp-line.sum-rubl - buf_stk-supp-line.vat-rubl
     1229                    v-temp-sum = v-temp-sum + buf_stk-supp-line.sum-rubl
     1230             .
     1231           end.
     1232           for last buf_stk-supp-line where buf_stk-supp-line.artic        = buf_gds-obj.artic                 and
     1233                                            buf_stk-supp-line.prod-type    = buf_gds-obj.prod-type             and
     1234                                            buf_stk-supp-line.prod-code    = buf_gds-obj.prod-code             and
     1235                                            buf_stk-supp-line.obj-type     = obj-list.obj-type                 and
     1236                                            buf_stk-supp-line.obj-code     = obj-list.obj-code                 and
     1237                                            buf_stk-supp-line.cli-type     = buf_clients.obj-type              and
     1238                                            buf_stk-supp-line.cli-code     = buf_clients.obj-code              and
     1239                                            buf_stk-supp-line.sum-type     = 'sadt':U + 'ep':U  and
     1240                                            buf_stk-supp-line.fact-order  <= v-end-fact-order                  no-lock :
     1241             assign tt-gds.sum       = tt-gds.sum + buf_stk-supp-line.sum-rubl
     1242                    tt-gds.sum-vat   = tt-gds.sum-vat + buf_stk-supp-line.sum-rubl - buf_stk-supp-line.vat-rubl
     1243                    tt-prod.sum      = tt-prod.sum + buf_stk-supp-line.sum-rubl
     1244                    tt-prod.sum-vat  = tt-prod.sum-vat + buf_stk-supp-line.sum-rubl - buf_stk-supp-line.vat-rubl
     1245                    tt-supp.sum      = tt-supp.sum + buf_stk-supp-line.sum-rubl
     1246                    tt-supp.sum-vat  = tt-supp.sum-vat + buf_stk-supp-line.sum-rubl - buf_stk-supp-line.vat-rubl
     1247                    v-temp-vozv = buf_stk-supp-line.sum-rubl
     1248                    v-temp-sum = v-temp-sum + buf_stk-supp-line.sum-rubl
     1249             .
     1250           end.
     1251           for last buf_stk-supp-line where buf_stk-supp-line.artic        = buf_gds-obj.artic                 and
     1252                                            buf_stk-supp-line.prod-type    = buf_gds-obj.prod-type             and
     1253                                            buf_stk-supp-line.prod-code    = buf_gds-obj.prod-code             and
     1254                                            buf_stk-supp-line.obj-type     = obj-list.obj-type                 and
     1255                                            buf_stk-supp-line.obj-code     = obj-list.obj-code                 and
     1256                                            buf_stk-supp-line.cli-type     = buf_clients.obj-type              and
     1257                                            buf_stk-supp-line.cli-code     = buf_clients.obj-code              and
     1258                                            buf_stk-supp-line.sum-type     = 'sadt':U + 'ie':U  and
     1259                                            buf_stk-supp-line.fact-order  <= v-start-fact-order                no-lock :
     1260             assign tt-gds.sum       = tt-gds.sum - buf_stk-supp-line.sum-rubl
     1261                    tt-gds.sum-vat   = tt-gds.sum-vat - (buf_stk-supp-line.sum-rubl - buf_stk-supp-line.vat-rubl)
     1262                    tt-prod.sum      = tt-prod.sum - buf_stk-supp-line.sum-rubl
     1263                    tt-prod.sum-vat  = tt-prod.sum-vat - (buf_stk-supp-line.sum-rubl - buf_stk-supp-line.vat-rubl)
     1264                    tt-supp.sum      = tt-supp.sum - buf_stk-supp-line.sum-rubl
     1265                    tt-supp.sum-vat  = tt-supp.sum-vat - (buf_stk-supp-line.sum-rubl - buf_stk-supp-line.vat-rubl)
     1266                    v-temp-sum = v-temp-sum - buf_stk-supp-line.sum-rubl
     1267             .
     1268           end.
     1269           for last buf_stk-supp-line where buf_stk-supp-line.artic        = buf_gds-obj.artic                 and
     1270                                            buf_stk-supp-line.prod-type    = buf_gds-obj.prod-type             and
     1271                                            buf_stk-supp-line.prod-code    = buf_gds-obj.prod-code             and
     1272                                            buf_stk-supp-line.obj-type     = obj-list.obj-type                 and
     1273                                            buf_stk-supp-line.obj-code     = obj-list.obj-code                 and
     1274                                            buf_stk-supp-line.cli-type     = buf_clients.obj-type              and
     1275                                            buf_stk-supp-line.cli-code     = buf_clients.obj-code              and
     1276                                            buf_stk-supp-line.sum-type     = 'sadt':U + 'ep':U  and
     1277                                            buf_stk-supp-line.fact-order  <= v-start-fact-order                no-lock :
     1278             assign tt-gds.sum       = tt-gds.sum - buf_stk-supp-line.sum-rubl
     1279                    tt-gds.sum-vat   = tt-gds.sum-vat - (buf_stk-supp-line.sum-rubl - buf_stk-supp-line.vat-rubl)
     1280                    tt-prod.sum      = tt-prod.sum - buf_stk-supp-line.sum-rubl
     1281                    tt-prod.sum-vat  = tt-prod.sum-vat - (buf_stk-supp-line.sum-rubl - buf_stk-supp-line.vat-rubl)
     1282                    tt-supp.sum      = tt-supp.sum - buf_stk-supp-line.sum-rubl
     1283                    tt-supp.sum-vat  = tt-supp.sum-vat - (buf_stk-supp-line.sum-rubl - buf_stk-supp-line.vat-rubl)
     1284                    v-temp-vozv = v-temp-vozv - buf_stk-supp-line.sum-rubl
     1285                    v-temp-sum = v-temp-sum - buf_stk-supp-line.sum-rubl
     1286             .
     1287           end.
     1288           if tt-gds.sum <> 0 then do :
     1289             if v-temp-sum <> 0 then do :
     1290               if tt-gds.method = "vat-yes" then
     1291                 tt-gds.sum-bonus = tt-gds.sum * (tt-gds.pct-rate / 100) + tt-gds.sum-rate.
     1292               else
     1293                 tt-gds.sum-bonus = tt-gds.sum-vat * (tt-gds.pct-rate / 100) + tt-gds.sum-rate.
     1294               if v-temp-vozv <> 0 and tt-gds.vozvrat then tt-gds.sum-bonus = 0.
     1295               assign tt-prod.sum-bonus = tt-prod.sum-bonus + tt-gds.sum-bonus
     1296                     tt-supp.sum-bonus = tt-supp.sum-bonus + tt-gds.sum-bonus
     1297               .
     1298             end.
     1299           end.
     1300           else do :
     1301             delete tt-gds.
     1302           end.
     1303           if tt-prod.sum = 0 then delete tt-prod.
     1304           leave.
     1305         end.
     1306       end.
     1307       assign Counter1 = Counter1 + 1.
     1308   IF ( Counter1 modulo v-account = 0 )  then DO:
     1309             if  log-manager:logfile-name ne ?
     1310             then DO:
     1311                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     1312             end.
     1313              if mFrameView
     1314              then do:
     1315               DISPLAY
     1316                 Counter1 @ RecordsDone
     1317                 WITH FRAME InfoFrame.
     1318              end.
     1319   End.
     1320      if v-button-stop then  DO:
     1321            if mFrameView
     1322            then
     1323               PROCESS EVENTS.
     1324            IF StopProcessing THEN DO:
     1325            RETURN error.
     1326            End.
     1327      end.
     1328     end.
     1329     Else for each G#CUSTOMER no-lock :
     1330       v-temp-sum  = 0 .
     1331       v-temp-vozv = 0 .
     1332       find first buf2_clients where buf2_clients.obj-type = obj-list.obj-type and
     1333                                     buf2_clients.obj-code = obj-list.obj-code no-lock.
     1334       for each   buf_contract where buf_contract.contract-date-beg <= x-date-start          and
     1335                                    (buf_contract.contract-date-end >= x-date-start or
     1336                                     buf_contract.contract-date-end = ?)                     and
     1337                                     buf_contract.status_            = 'тек':U      and
     1338                                     buf_contract.host-code          = buf2_clients.host-code    and
     1339                                     buf_contract.doc-type           = 'при':U     and
     1340                                     buf_contract.cli-type           = G#CUSTOMER.obj-type  and
     1341                                     buf_contract.cli-code           = G#CUSTOMER.obj-code  no-lock :
     1342         find last  buf_contract-specif where buf_contract-specif.host-code    = buf_contract.host-code    and
     1343                                              buf_contract-specif.contract-num = buf_contract.contract-code and
     1344                                              buf_contract-specif.gds-code     = buf_gds-obj.gds-code      no-lock no-error.
     1345         if available buf_contract-specif then do :
     1346           find first tt-gds where tt-gds.supp-type    = G#CUSTOMER.obj-type  and
     1347                                   tt-gds.supp-code    = G#CUSTOMER.obj-code  and
     1348                                   tt-gds.prod-type    = buf_gds-obj.prod-type and
     1349                                   tt-gds.prod-code    = buf_gds-obj.prod-code and
     1350                                   tt-gds.code         = buf_gds-obj.gds-code  no-lock no-error.
     1351           if not available tt-gds then do :
     1352             find first buf_goods where buf_goods.gds-code = buf_gds-obj.gds-code no-lock.
     1353             create tt-gds.
     1354             assign  tt-gds.supp-type    = G#CUSTOMER.obj-type
     1355                     tt-gds.supp-code    = G#CUSTOMER.obj-code
     1356                     tt-gds.prod-type    = buf_gds-obj.prod-type
     1357                     tt-gds.prod-code    = buf_gds-obj.prod-code
     1358                     tt-gds.code         = buf_gds-obj.gds-code
     1359                     tt-gds.name         = buf_goods.gds-name
     1360                     tt-gds.artic        = buf_gds-obj.artic
     1361                     tt-gds.sum          = 0
     1362                     tt-gds.sum-vat      = 0
     1363                     tt-gds.sum-bonus    = 0
     1364             .
     1365             find first buf_contract-specif-attr where buf_contract-specif-attr.host-code    = buf_contract-specif.host-code     and
     1366                                                       buf_contract-specif-attr.contract-num = buf_contract-specif.contract-num  and
     1367                                                       buf_contract-specif-attr.gds-code     = buf_contract-specif.gds-code      and
     1368                                                       buf_contract-specif-attr.attr-code    = "retro-bonus"                     no-lock no-error.
     1369             if available buf_contract-specif-attr then do :
     1370               do i = 1 to num-entries(buf_contract-specif-attr.attr-value, ';') - 1 :
     1371                 if date(entry(1, entry(i, buf_contract-specif-attr.attr-value, ';')))  <= x-date-start and
     1372                    date(entry(2, entry(i, buf_contract-specif-attr.attr-value, ';')))  >= x-date-start then do :
     1373                   assign  tt-gds.pct-rate = decimal (entry(3, entry(i, buf_contract-specif-attr.attr-value, ';')))
     1374                           tt-gds.sum-rate = decimal (entry(4, entry(i, buf_contract-specif-attr.attr-value, ';')))
     1375                           tt-gds.method   =         (entry(5, entry(i, buf_contract-specif-attr.attr-value, ';')))
     1376                           tt-gds.vozvrat  = logical (entry(6, entry(i, buf_contract-specif-attr.attr-value, ';')))
     1377                   .
     1378                   leave.
     1379                 end.
     1380               end.
     1381               if tt-gds.pct-rate = ? then tt-gds.pct-rate = 0.
     1382               if tt-gds.sum-rate = ? then tt-gds.sum-rate = 0.
     1383               if tt-gds.method   = ? then tt-gds.method = "-".
     1384             end.
     1385             else assign tt-gds.pct-rate = 0
     1386                         tt-gds.sum-rate = 0
     1387                         tt-gds.method   = "-"
     1388             .
     1389           end.
     1390           find first tt-prod where tt-prod.type       = tt-gds.prod-type and
     1391                                    tt-prod.code       = tt-gds.prod-code and
     1392                                    tt-prod.supp-type  = tt-gds.supp-type and
     1393                                    tt-prod.supp-code  = tt-gds.supp-code no-lock no-error.
     1394           if not available tt-prod then do :
     1395             find first buf2_clients where buf2_clients.obj-type = tt-gds.prod-type and
     1396                                           buf2_clients.obj-code = tt-gds.prod-code no-lock.
     1397             create tt-prod.
     1398             assign  tt-prod.type       = tt-gds.prod-type
     1399                     tt-prod.code       = tt-gds.prod-code
     1400                     tt-prod.supp-type  = tt-gds.supp-type
     1401                     tt-prod.supp-code  = tt-gds.supp-code
     1402                     tt-prod.name       = buf2_clients.obj-name
     1403                     tt-prod.sum        = 0
     1404                     tt-prod.sum-vat    = 0
     1405                     tt-prod.sum-bonus  = 0
     1406             .
     1407           end.
     1408           find first tt-supp where tt-supp.type = G#CUSTOMER.obj-type and
     1409                                    tt-supp.code = G#CUSTOMER.obj-code no-lock no-error.
     1410           if not available tt-supp then do :
     1411             create tt-supp.
     1412             assign  tt-supp.type      = G#CUSTOMER.obj-type
     1413                     tt-supp.code      = G#CUSTOMER.obj-code
     1414                     tt-supp.name      = G#CUSTOMER.obj-name
     1415                     tt-supp.sum       = 0
     1416                     tt-supp.sum-vat   = 0
     1417                     tt-supp.sum-bonus = 0
     1418             .
     1419           end.
     1420           for last buf_stk-supp-line where buf_stk-supp-line.artic        = buf_gds-obj.artic                 and
     1421                                            buf_stk-supp-line.prod-type    = buf_gds-obj.prod-type             and
     1422                                            buf_stk-supp-line.prod-code    = buf_gds-obj.prod-code             and
     1423                                            buf_stk-supp-line.obj-type     = obj-list.obj-type                 and
     1424                                            buf_stk-supp-line.obj-code     = obj-list.obj-code                 and
     1425                                            buf_stk-supp-line.cli-type     = G#CUSTOMER.obj-type              and
     1426                                            buf_stk-supp-line.cli-code     = G#CUSTOMER.obj-code              and
     1427                                            buf_stk-supp-line.sum-type     = 'sadt':U + 'ie':U  and
     1428                                            buf_stk-supp-line.fact-order  <= v-end-fact-order                  no-lock :
     1429             assign tt-gds.sum       = tt-gds.sum + buf_stk-supp-line.sum-rubl
     1430                    tt-gds.sum-vat   = tt-gds.sum-vat + buf_stk-supp-line.sum-rubl - buf_stk-supp-line.vat-rubl
     1431                    tt-prod.sum      = tt-prod.sum + buf_stk-supp-line.sum-rubl
     1432                    tt-prod.sum-vat  = tt-prod.sum-vat + buf_stk-supp-line.sum-rubl - buf_stk-supp-line.vat-rubl
     1433                    tt-supp.sum      = tt-supp.sum + buf_stk-supp-line.sum-rubl
     1434                    tt-supp.sum-vat  = tt-supp.sum-vat + buf_stk-supp-line.sum-rubl - buf_stk-supp-line.vat-rubl
     1435                    v-temp-sum = v-temp-sum + buf_stk-supp-line.sum-rubl
     1436             .
     1437           end.
     1438           for last buf_stk-supp-line where buf_stk-supp-line.artic        = buf_gds-obj.artic                 and
     1439                                            buf_stk-supp-line.prod-type    = buf_gds-obj.prod-type             and
     1440                                            buf_stk-supp-line.prod-code    = buf_gds-obj.prod-code             and
     1441                                            buf_stk-supp-line.obj-type     = obj-list.obj-type                 and
     1442                                            buf_stk-supp-line.obj-code     = obj-list.obj-code                 and
     1443                                            buf_stk-supp-line.cli-type     = G#CUSTOMER.obj-type              and
     1444                                            buf_stk-supp-line.cli-code     = G#CUSTOMER.obj-code              and
     1445                                            buf_stk-supp-line.sum-type     = 'sadt':U + 'ep':U  and
     1446                                            buf_stk-supp-line.fact-order  <= v-end-fact-order                  no-lock :
     1447             assign tt-gds.sum       = tt-gds.sum + buf_stk-supp-line.sum-rubl
     1448                    tt-gds.sum-vat   = tt-gds.sum-vat + buf_stk-supp-line.sum-rubl - buf_stk-supp-line.vat-rubl
     1449                    tt-prod.sum      = tt-prod.sum + buf_stk-supp-line.sum-rubl
     1450                    tt-prod.sum-vat  = tt-prod.sum-vat + buf_stk-supp-line.sum-rubl - buf_stk-supp-line.vat-rubl
     1451                    tt-supp.sum      = tt-supp.sum + buf_stk-supp-line.sum-rubl
     1452                    tt-supp.sum-vat  = tt-supp.sum-vat + buf_stk-supp-line.sum-rubl - buf_stk-supp-line.vat-rubl
     1453                    v-temp-vozv = buf_stk-supp-line.sum-rubl
     1454                    v-temp-sum = v-temp-sum + buf_stk-supp-line.sum-rubl
     1455             .
     1456           end.
     1457           for last buf_stk-supp-line where buf_stk-supp-line.artic        = buf_gds-obj.artic                 and
     1458                                            buf_stk-supp-line.prod-type    = buf_gds-obj.prod-type             and
     1459                                            buf_stk-supp-line.prod-code    = buf_gds-obj.prod-code             and
     1460                                            buf_stk-supp-line.obj-type     = obj-list.obj-type                 and
     1461                                            buf_stk-supp-line.obj-code     = obj-list.obj-code                 and
     1462                                            buf_stk-supp-line.cli-type     = G#CUSTOMER.obj-type              and
     1463                                            buf_stk-supp-line.cli-code     = G#CUSTOMER.obj-code              and
     1464                                            buf_stk-supp-line.sum-type     = 'sadt':U + 'ie':U  and
     1465                                            buf_stk-supp-line.fact-order  <= v-start-fact-order                no-lock :
     1466             assign tt-gds.sum       = tt-gds.sum - buf_stk-supp-line.sum-rubl
     1467                    tt-gds.sum-vat   = tt-gds.sum-vat - (buf_stk-supp-line.sum-rubl - buf_stk-supp-line.vat-rubl)
     1468                    tt-prod.sum      = tt-prod.sum - buf_stk-supp-line.sum-rubl
     1469                    tt-prod.sum-vat  = tt-prod.sum-vat - (buf_stk-supp-line.sum-rubl - buf_stk-supp-line.vat-rubl)
     1470                    tt-supp.sum      = tt-supp.sum - buf_stk-supp-line.sum-rubl
     1471                    tt-supp.sum-vat  = tt-supp.sum-vat - (buf_stk-supp-line.sum-rubl - buf_stk-supp-line.vat-rubl)
     1472                    v-temp-sum = v-temp-sum - buf_stk-supp-line.sum-rubl
     1473             .
     1474           end.
     1475           for last buf_stk-supp-line where buf_stk-supp-line.artic        = buf_gds-obj.artic                 and
     1476                                            buf_stk-supp-line.prod-type    = buf_gds-obj.prod-type             and
     1477                                            buf_stk-supp-line.prod-code    = buf_gds-obj.prod-code             and
     1478                                            buf_stk-supp-line.obj-type     = obj-list.obj-type                 and
     1479                                            buf_stk-supp-line.obj-code     = obj-list.obj-code                 and
     1480                                            buf_stk-supp-line.cli-type     = G#CUSTOMER.obj-type              and
     1481                                            buf_stk-supp-line.cli-code     = G#CUSTOMER.obj-code              and
     1482                                            buf_stk-supp-line.sum-type     = 'sadt':U + 'ep':U  and
     1483                                            buf_stk-supp-line.fact-order  <= v-start-fact-order                no-lock :
     1484             assign tt-gds.sum       = tt-gds.sum - buf_stk-supp-line.sum-rubl
     1485                    tt-gds.sum-vat   = tt-gds.sum-vat - (buf_stk-supp-line.sum-rubl - buf_stk-supp-line.vat-rubl)
     1486                    tt-prod.sum      = tt-prod.sum - buf_stk-supp-line.sum-rubl
     1487                    tt-prod.sum-vat  = tt-prod.sum-vat - (buf_stk-supp-line.sum-rubl - buf_stk-supp-line.vat-rubl)
     1488                    tt-supp.sum      = tt-supp.sum - buf_stk-supp-line.sum-rubl
     1489                    tt-supp.sum-vat  = tt-supp.sum-vat - (buf_stk-supp-line.sum-rubl - buf_stk-supp-line.vat-rubl)
     1490                    v-temp-vozv = v-temp-vozv - buf_stk-supp-line.sum-rubl
     1491                    v-temp-sum = v-temp-sum - buf_stk-supp-line.sum-rubl
     1492             .
     1493           end.
     1494           if tt-gds.sum <> 0 then do :
     1495             if v-temp-sum <> 0 then do :
     1496               if tt-gds.method = "vat-yes" then
     1497                 tt-gds.sum-bonus = tt-gds.sum * (tt-gds.pct-rate / 100) + tt-gds.sum-rate.
     1498               else
     1499                 tt-gds.sum-bonus = tt-gds.sum-vat * (tt-gds.pct-rate / 100) + tt-gds.sum-rate.
     1500               if v-temp-vozv <> 0 and tt-gds.vozvrat then tt-gds.sum-bonus = 0.
     1501               assign tt-prod.sum-bonus = tt-prod.sum-bonus + tt-gds.sum-bonus
     1502                     tt-supp.sum-bonus = tt-supp.sum-bonus + tt-gds.sum-bonus
     1503               .
     1504             end.
     1505           end.
     1506           else do :
     1507             delete tt-gds.
     1508           end.
     1509           if tt-prod.sum = 0 then delete tt-prod.
     1510           leave.
     1511         end.
     1512       end.
     1513       assign Counter1 = Counter1 + 1.
     1514   IF ( Counter1 modulo v-account = 0 )  then DO:
     1515             if  log-manager:logfile-name ne ?
     1516             then DO:
     1517                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     1518             end.
     1519              if mFrameView
     1520              then do:
     1521               DISPLAY
     1522                 Counter1 @ RecordsDone
     1523                 WITH FRAME InfoFrame.
     1524              end.
     1525   End.
     1526      if v-button-stop then  DO:
     1527            if mFrameView
     1528            then
     1529               PROCESS EVENTS.
     1530            IF StopProcessing THEN DO:
     1531            RETURN error.
     1532            End.
     1533      end.
     1534     end.
     1535   end procedure.
