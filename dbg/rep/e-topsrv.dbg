     1601   benefits.price column-label "Розничная цена" format "->,>>>,>>>,>>9.99"
     1602   sym6 column-label ":" format "X(1)"
     1603   benefits.tot-r-b column-label "Сумма  по учет.цене" format "->,>>>,>>>,>>>,>>9.99"
     1604   benefits.tot-r-b-brutto column-label "Сумма  по розн.цене" format "->,>>>,>>>,>>>,>>9.99"
     1605   for-ben.b-code column-label "Код основн.!товара"
     1606   for-main column-label "Тип!товара"
     1607   sym7 column-label ":" format "X(1)"
     1608   HEADER  date_string AT 5 format "X(35)"
     1609   v-header-base-curr        format "X(20)" AT 42
     1610   "Страница " AT 65 PAGE-NUMBER( PrnLibStream )  AT 75 FORMAT ">>9" SKIP
     1611   Line format "X(107)" AT 1
     1612   with width 232 down stream-io use-text .
     1613   DEFINE VARIABLE cas-num AS INTEGER FORMAT ">>9":U INITIAL 0
     1614        VIEW-AS FILL-IN
     1615        SIZE 14.25 BY .96 NO-UNDO.
     1616   DEFINE VARIABLE RS-cass AS CHARACTER INITIAL "1"
     1617        VIEW-AS RADIO-SET VERTICAL
     1618        RADIO-BUTTONS
     1619             "Все", "1",
     1620   "Выборочно", "2"
     1621        SIZE 26.38 BY 2.13 NO-UNDO.
     1622   DEFINE VARIABLE RS-method AS CHARACTER
     1623        VIEW-AS RADIO-SET VERTICAL
     1624        RADIO-BUTTONS
     1625             "Без разбивки по ценам", "no-break":U,
     1626   "С разбивкой по ценам", "break":U
     1627        SIZE 25.88 BY 2.21 NO-UNDO.
     1628   DEFINE RECTANGLE RECT-11
     1629        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1630        SIZE 30.38 BY 3.42.
     1631   DEFINE RECTANGLE RECT-12
     1632        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1633        SIZE 30.63 BY 5.67.
     1634   DEFINE FRAME F-Main
     1635        RS-method AT ROW 2.42 COL 3.88 NO-LABEL
     1636        RS-cass AT ROW 6.54 COL 3.5 NO-LABEL
     1637        cas-num AT ROW 9.08 COL 4.5 COLON-ALIGNED NO-LABEL
     1638        "Кассы:" VIEW-AS TEXT
     1639             SIZE 26.63 BY .96 AT ROW 5.17 COL 3.75
     1640             FGCOLOR 4
     1641        RECT-11 AT ROW 1.5 COL 2.25
     1642        RECT-12 AT ROW 5.08 COL 2
     1643       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1644            SIDE-LABELS NO-UNDERLINE THREE-D
     1645            AT COL 1 ROW 1
     1646            SIZE 42 BY 11.88.
     1647   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1648   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1649   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1650   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1651   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1652   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1653   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1654   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1655       ASSIGN adm-object-hdl = FRAME F-Main:HANDLE.
     1656   RUN ensure-broker.
     1657   THIS-PROCEDURE:ADM-DATA =
     1658        'ADM1.1~`':U +
     1659        'SmartObject~`':U +
     1660        'FRAME~`':U +
     1661        'NO ~`':U +
     1662        '~`':U +
     1663        '~`':U +
     1664        '~`':U +
     1665        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1666           + "~`":U +
     1667        'Layout,Hide-on-Init~`':U +
     1668        '~`':U +
     1669        '~`':U +
     1670        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1671        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1672            THEN "^^":U
     1673        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1674             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1675   PROCEDURE adm-apply-entry :
     1676     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1677   END PROCEDURE.
     1678   PROCEDURE adm-destroy :
     1679    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1680   END PROCEDURE.
     1681   PROCEDURE adm-disable :
     1682       DISABLE RECT-11 RECT-12 RS-method RS-cass cas-num WITH FRAME F-Main.
     1683       RUN dispatch ('disable-fields':U).
     1684       RUN set-attribute-list ('ENABLED=no':U).
     1685       RETURN.
     1686   END PROCEDURE.
     1687   PROCEDURE adm-edit-attribute-list :
     1688         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
     1689         RETURN.
     1690   END PROCEDURE.
     1691   PROCEDURE adm-enable :
     1692       ENABLE UNLESS-HIDDEN RECT-11 RECT-12 RS-method RS-cass cas-num WITH FRAME F-Main.
     1693       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1694       RUN set-attribute-list ('ENABLED=yes':U).
     1695       RETURN.
     1696   END PROCEDURE.
     1697   PROCEDURE adm-exit :
     1698        RUN notify ('exit':U).
     1699     RETURN.
     1700   END PROCEDURE.
     1701   PROCEDURE adm-hide :
     1702     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1703   END PROCEDURE.
     1704   PROCEDURE adm-initialize :
     1705     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1706   END PROCEDURE.
     1707   PROCEDURE adm-show-errors :
     1708       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1709       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1710           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1711       END.
     1712       RETURN.
     1713   END PROCEDURE.
     1714   PROCEDURE adm-UIB-mode :
     1715     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1716   END PROCEDURE.
     1717   PROCEDURE adm-view :
     1718     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1719   END PROCEDURE.
     1720   PROCEDURE dispatch :
     1721       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1722       RUN broker-dispatch IN adm-broker-hdl
     1723           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1724       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1725   END PROCEDURE.
     1726   PROCEDURE ensure-broker :
     1727   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1728   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1729   DO:
     1730       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1731       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1732   END.
     1733   END PROCEDURE.
     1734   PROCEDURE get-attribute :
     1735     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1736     RUN broker-get-attribute IN adm-broker-hdl
     1737         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1738     RETURN RETURN-VALUE.
     1739   END PROCEDURE.
     1740   PROCEDURE get-attribute-list :
     1741     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1742     RUN broker-get-attribute-list IN adm-broker-hdl
     1743         (INPUT THIS-PROCEDURE,
     1744          INPUT ?,
     1745          OUTPUT p-attr-list) NO-ERROR.
     1746     RETURN.
     1747   END PROCEDURE.
     1748   PROCEDURE new-state :
     1749     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1750     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1751     RETURN.
     1752   END PROCEDURE.
     1753   PROCEDURE notify :
     1754     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1755     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1756     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1757         RETURN "ADM-ERROR":U.
     1758     RETURN.
     1759   END PROCEDURE.
     1760   PROCEDURE set-attribute-list :
     1761     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1762     RUN ensure-broker.
     1763     RUN broker-set-attribute-list IN adm-broker-hdl
     1764         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1765     RETURN.
     1766   END PROCEDURE.
     1767   PROCEDURE set-position :
     1768       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1769       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1770       IF VALID-HANDLE(adm-object-hdl) THEN
     1771       DO:
     1772           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     1773           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     1774           DO:
     1775             IF p-row = 0 THEN p-row =
     1776               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     1777             IF p-col = 0 THEN p-col =
     1778               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     1779           END.
     1780           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     1781           DO:
     1782             parent-hdl = adm-object-hdl:PARENT.
     1783             IF p-row = 0 THEN p-row =
     1784               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     1785                 parent-hdl:ROW.
     1786             IF p-col = 0 THEN p-col =
     1787               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     1788                 parent-hdl:COL.
     1789           END.
     1790           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     1791           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     1792         ASSIGN adm-object-hdl:ROW    =   p-row
     1793                adm-object-hdl:COLUMN =   p-col.
     1794       END.
     1795       RETURN.
     1796   END PROCEDURE.
     1797   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
     1798       STRING(adm-object-hdl)).
     1799   PAUSE 0 BEFORE-HIDE.
     1800   PROCEDURE adm-change-page :
     1801     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
     1802     END PROCEDURE.
     1803   PROCEDURE delete-page :
     1804     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
     1805     RUN broker-delete-page IN adm-broker-hdl
     1806         (INPUT THIS-PROCEDURE, INPUT p-page#).
     1807     END PROCEDURE.
     1808   PROCEDURE init-object :
     1809     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
     1810     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
     1811     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
     1812     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
     1813     RUN broker-init-object IN adm-broker-hdl
     1814         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
     1815          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
     1816     RETURN.
     1817   END PROCEDURE.
     1818   PROCEDURE init-pages :
     1819     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
     1820     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1821         INPUT p-page-list) NO-ERROR.
     1822     END PROCEDURE.
     1823   PROCEDURE select-page :
     1824     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
     1825     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1826         INPUT p-page#) NO-ERROR.
     1827     END PROCEDURE.
     1828   PROCEDURE view-page :
     1829     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
     1830     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1831         INPUT p-page#).
     1832     END PROCEDURE.
     1833   ON VALUE-CHANGED OF RS-cass IN FRAME F-Main
     1834   DO:
     1835   assign RS-Cass.
     1836     if RS-cass = 'все':U then do:
     1837       assign cas-num = 0.
     1838       disable cas-num with frame F-Main.
     1839       hide cas-num in frame F-Main.
     1840     end.
     1841     else do:
     1842       assign rs-method = "no-break":U.
     1843       enable cas-num with frame F-Main.
     1844       display cas-num rs-method with frame F-Main.
     1845     end.
     1846   END.
     1847   ON VALUE-CHANGED OF RS-method IN FRAME F-Main
     1848   DO:
     1849      assign rs-method .
     1850   END.
     1851   if not this-procedure :persistent
     1852   then do:
     1853     message
     1854       vss-workfile vss-revision vss-description skip
     1855       "Ошибка при запуске процедуры" skip
     1856       "Данную процедуру следует запускать только с параметром persistent" skip
     1857       view-as alert-box error .
     1858     undo, return error .
     1859   end.
     1860   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1861   PROCEDURE no-benq.
     1862   DEFINE OUTPUT PARAMETER found as logical init no.
     1863   define buffer buf_chk-doc for ub.chk-doc.
     1864   FOR EACH obj-list WHERE
     1865           obj-list.obj-type = 'маг':U NO-LOCK :
     1866     CASE X-Radio-Task > 1 :
     1867       WHEN YES THEN DO:
     1868         FOR EACH buf_chk-doc NO-LOCK WHERE
     1869                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1870                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1871                 (
     1872                   buf_chk-doc.shift-date >= X-date-start AND
     1873                   buf_chk-doc.shift-date <= X-date-end)
     1874                   AND
     1875                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1876           IF X-Radio-Task = 3 AND
     1877           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     1878             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     1879           IF X-Radio-Task = 4 AND
     1880           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1881           found = yes.
     1882           return.
     1883         END.
     1884       END.
     1885       WHEN NO THEN DO:
     1886         FOR EACH buf_chk-doc NO-LOCK WHERE
     1887               buf_chk-doc.obj-type = obj-list.obj-type AND
     1888               buf_chk-doc.obj-code = obj-list.obj-code AND
     1889               buf_chk-doc.chk-date >= X-date-start AND
     1890               buf_chk-doc.chk-date <= X-date-end   AND
     1891               (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1892           found = yes.
     1893           return.
     1894         END.
     1895        END.
     1896      END CASE.
     1897    END.
     1898   END PROCEDURE.
     1899   PROCEDURE no-benqi.
     1900   DEFINE OUTPUT PARAMETER found as logical init no.
     1901   define buffer buf_chk-doc for ub.chk-doc.
     1902   define buffer buf_inkas for ub.inkas.
     1903   FOR EACH obj-list WHERE
     1904         obj-list.obj-type = 'маг':U NO-LOCK :
     1905     CASE X-Radio-Task > 1 :
     1906       WHEN YES THEN DO:
     1907         FOR EACH buf_chk-doc No-LOCK WHERE
     1908                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1909                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1910                 (
     1911                   buf_chk-doc.shift-date >= X-date-start AND
     1912                   buf_chk-doc.shift-date <= X-date-end)
     1913                   AND
     1914                   buf_Chk-doc.out-code = ? AND
     1915                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1916           IF X-Radio-Task = 3 AND
     1917           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     1918             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     1919           IF X-Radio-Task = 4 AND
     1920           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1921           found = yes.
     1922           return.
     1923         END.
     1924         FOR EACH buf_inkas No-LOCK WHERE
     1925                   buf_inkas.obj-type = obj-list.obj-type AND
     1926                   buf_inkas.obj-code = obj-list.obj-code AND
     1927                   (
     1928                   buf_inkas.shift-date >= X-date-start AND
     1929                   buf_inkas.shift-date <= X-date-end):
     1930           if buf_inkas.status_ = 'факт':U
     1931           or buf_inkas.status_ = 'запрос':U then next.
     1932           IF X-Radio-Task = 3 AND
     1933           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
     1934             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
     1935           IF X-Radio-Task = 4 AND
     1936           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
     1937           found = yes.
     1938           return.
     1939         END.
     1940       END.
     1941       WHEN NO THEN DO:
     1942         FOR EACH buf_chk-doc NO-LOCK WHERE
     1943                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1944                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1945                 buf_chk-doc.chk-date >= X-date-start AND
     1946                 buf_chk-doc.chk-date <= X-date-end   AND
     1947                 buf_Chk-doc.out-code = ? AND
     1948                 (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1949           found = yes.
     1950           return.
     1951         END.
     1952         FOR EACH buf_inkas NO-LOCK WHERE
     1953                 buf_inkas.obj-type = obj-list.obj-type AND
     1954                 buf_inkas.obj-code = obj-list.obj-code AND
     1955                 buf_inkas.doc-date >= X-date-start AND
     1956                 buf_inkas.doc-date <= X-date-end :
     1957           if buf_inkas.status_ = 'факт':U
     1958           or buf_inkas.status_ = 'запрос':U then next.
     1959           found = yes.
     1960           return.
     1961         END.
     1962       END.
     1963     END CASE.
     1964   END.
     1965   END PROCEDURE.
     1966   PROCEDURE no-benq-i.
     1967   DEFINE OUTPUT PARAMETER found as logical init no.
     1968   define buffer buf_inkas for ub.inkas.
     1969   CASE X-Radio-Task > 1:
     1970     WHEN YES then do:
     1971       FOR EACH obj-list WHERE
     1972               obj-list.obj-type = 'маг':U NO-LOCK :
     1973         FOR EACH buf_inkas NO-LOCK WHERE
     1974                 buf_inkas.obj-type = obj-list.obj-type AND
     1975                 buf_inkas.obj-code = obj-list.obj-code AND
     1976                 buf_inkas.status_ = 'факт':U AND
     1977                 (
     1978                 buf_inkas.shift-date >= X-date-start AND
     1979                 buf_inkas.shift-date <= X-date-end):
     1980           IF X-Radio-Task = 3 AND
     1981           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
     1982             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
     1983           IF X-Radio-Task = 4 AND
     1984           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
     1985           found = yes.
     1986           return.
     1987         END.
     1988     END.
     1989     END.
     1990     WHEN NO THEN DO:
     1991       FOR EACH obj-list WHERE
     1992               obj-list.obj-type = 'маг':U NO-LOCK :
     1993         FOR EACH buf_inkas NO-LOCK WHERE
     1994                 buf_inkas.obj-type = obj-list.obj-type AND
     1995                 buf_inkas.obj-code = obj-list.obj-code AND
     1996                 buf_inkas.status_ = 'факт':U AND
     1997                 buf_inkas.doc-date >= X-date-start AND
     1998                 buf_inkas.doc-date <= X-date-end :
     1999            found = yes.
     2000            return.
     2001         END.
     2002       END.
     2003     END.
     2004   END CASE.
     2005   END PROCEDURE.
     2006   PROCEDURE no-benq-i-office.
     2007   DEFINE OUTPUT PARAMETER found as logical init no.
     2008   define buffer buf_sale-doc for ub.sale-doc.
     2009   CASE X-Radio-Task > 1:
     2010     WHEN YES then do:
     2011       FOR EACH obj-list WHERE
     2012               obj-list.obj-type = 'маг':U NO-LOCK :
     2013         FOR EACH buf_sale-doc NO-LOCK WHERE
     2014                  buf_Sale-doc.obj-type = obj-list.obj-type
     2015              AND buf_sale-doc.obj-code = obj-list.obj-code
     2016              AND buf_sale-doc.status_ = 'факт':U
     2017              AND buf_sale-doc.chr-office = 'у':U
     2018              AND (
     2019                 buf_sale-doc.shift-date >= X-date-start
     2020                 AND
     2021                 buf_sale-doc.shift-date <= X-date-end):
     2022           IF X-Radio-Task = 3 AND
     2023           ((buf_sale-doc.shift-date = X-date-start AND buf_sale-doc.shift-num < X-shift-Start) OR
     2024             (buf_sale-doc.shift-date = X-date-end AND  buf_sale-doc.shift-num > X-shift-End) ) THEN NEXT.
     2025           IF X-Radio-Task = 4 AND
     2026           (buf_sale-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     2027           found = yes.
     2028           return.
     2029         END.
     2030       END.
     2031     END.
     2032     WHEN NO THEN DO:
     2033       FOR EACH obj-list WHERE
     2034               obj-list.obj-type = 'маг':U NO-LOCK :
     2035         FOR EACH buf_sale-doc NO-LOCK WHERE
     2036                 buf_sale-doc.obj-type = obj-list.obj-type
     2037            AND  buf_sale-doc.obj-code = obj-list.obj-code
     2038            AND  buf_sale-doc.status_ = 'факт':U
     2039            AND  buf_sale-doc.chr-office = 'у':U
     2040            AND  buf_sale-doc.doc-date >= X-date-start
     2041            AND  buf_sale-doc.doc-date <= X-date-end :
     2042           found = yes.
     2043           return.
     2044         END.
     2045       END.
     2046     END.
     2047   END CASE.
     2048   END PROCEDURE.
     2049   PROCEDURE adm-create-objects :
     2050   END PROCEDURE.
     2051   PROCEDURE adm-row-available :
     2052     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     2053     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     2054     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     2055     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     2056     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     2057     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     2058     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     2059     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     2060     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     2061     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     2062     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     2063     IF adm-updating-record THEN RETURN.
     2064     RUN get-attribute ('FIELDS-ENABLED':U).
     2065     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     2066     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     2067         OUTPUT link-handle) NO-ERROR.
     2068     IF link-handle = "":U THEN
     2069         RETURN.
     2070     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     2071     IF NUM-ENTRIES(link-handle) > 1 THEN
     2072         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     2073             "encountered more than one RECORD-SOURCE.":U SKIP
     2074             "The first - ":U record-source-hdl:file-name " - will be used.":U
     2075                VIEW-AS ALERT-BOX ERROR.
     2076     RUN get-attribute ('Key-Name':U).
     2077     key-name = RETURN-VALUE.
     2078     IF key-name = "":U THEN key-name = ?.
     2079     IF key-name NE ? THEN DO:
     2080       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     2081         NO-ERROR.
     2082       IF key-value NE ? THEN
     2083         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     2084     END.
     2085   IF VALID-HANDLE (adm-object-hdl) THEN
     2086       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     2087   RUN notify IN THIS-PROCEDURE ('row-available':U).
     2088   END PROCEDURE.
     2089   PROCEDURE disable_UI :
     2090     HIDE FRAME F-Main.
     2091     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     2092   END PROCEDURE.
     2093   PROCEDURE enable_UI :
     2094     DISPLAY RS-method RS-cass cas-num
     2095         WITH FRAME F-Main.
     2096     ENABLE RECT-11 RECT-12 RS-method RS-cass cas-num
     2097         WITH FRAME F-Main.
     2098   END PROCEDURE.
     2099   PROCEDURE Ini-from-selobj :
     2100   DEFINE INPUT PARAMETER myp-state as character no-undo.
     2101       CASE myp-state:
     2102           WHEN 'все':U then do:
     2103                   assign
     2104                   RS-CASS = "Все".
     2105                   Display RS-CASS with frame F-Main.
     2106                   DISABLE RS-CASS with frame F-Main.
     2107           END.
     2108           WHEN "Текущий" then do:
     2109                   ENABLE RS-CASS with frame F-Main.
     2110           END.
     2111           WHEN "Выборочно" then do:
     2112                   assign
     2113                   RS-CASS = "Все".
     2114                   Display RS-CASS with frame F-Main.
     2115                   DISABLE RS-CASS with frame F-Main.
     2116           END.
     2117       END CASE.
     2118   END PROCEDURE.
     2119   PROCEDURE local-apply-layout :
     2120   ASSIGN
     2121   RS-cass:RADIO-BUTTONS IN FRAME F-Main =  "все" + chr(44) + 'все':U + chr(44) +
     2122                                    "Выборочно" + chr(44) + "currency":U.
     2123     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     2124   END PROCEDURE.
     2125   PROCEDURE local-initialize :
     2126     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     2127       apply "value-changed" to rs-method in frame F-Main.
     2128       apply "value-changed" to rs-cass in frame F-Main.
     2129   END PROCEDURE.
     2130   PROCEDURE My-Report :
     2131   ASSIGN
     2132   frame F-Main cas-num
     2133   frame F-Main RS-cass
     2134   frame F-Main RS-method
     2135   .
     2136   run My-var.
     2137   assign
     2138   date_string = cur-time-print()
     2139   Line = fill( "-", 140 )
     2140   .
     2141   run no-benq(output found).
     2142   run no-benqi(output NotInc).
     2143   if not found then do:
     2144       run waitfram-hide in this-procedure .
     2145       message "Не было продаж на выбранных объектах в течение заданного Вами периода времени." view-as alert-box information .
     2146       return.
     2147   end.
     2148   run waitfram-show in this-procedure ( 'Подождите ...' ) .
     2149   if v-curr-r-b = 'base':U then do:
     2150     sale-price-type = base-type.
     2151   end.
     2152   else do:
     2153     sale-price-type = "рублей".
     2154   end.
     2155   run top-sq.
     2156   IF RS-method = "no-break":U then RUN Print-no-break.
     2157   else RUN Print-break.
     2158   run prn-lib-prn-file in this-procedure (
     2159                                             input my-handle
     2160                                             ,input 8
     2161                                             ).
     2162   END PROCEDURE.
     2163   PROCEDURE My-var :
     2164   ASSIGN
     2165   frame F-Main RS-Method
     2166   frame F-Main RS-Cass
     2167   frame F-Main Cas-Num
     2168   .
     2169   Assign
     2170    STR-obj-type = ''
     2171    STR-obj-code = ''
     2172    STR-obj-name = ''
     2173    STR-obj      = ''.
     2174   For each obj-list no-lock:
     2175    Assign
     2176    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     2177    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     2178    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     2179    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     2180   End.
     2181   ReportNAme = "Продажи топлива и сервисного элемента".
     2182   ReportHeader =  radio-label(string(Rs-Method), RS-Method:radio-buttons) + chr(10) +
     2183                               "Кассы: " +
     2184                               radio-label(string(Rs-cass), RS-cass:radio-buttons) + chr(10) +
     2185                               (IF Rs-cass = "Выборочно" then ("Касса N:" + string(cas-num)) else "") .
     2186   END PROCEDURE.
     2187   PROCEDURE Print-Break :
     2188   define variable found as logical init no no-undo.
     2189   run waitfram-hide in this-procedure .
     2190   run prn-lib-open-stream  in this-procedure (
     2191                                                input my-handle
     2192                                               ,input 43
     2193                                               ,input yes
     2194                                               ,input no
     2195                                               ).
     2196   FORM HEADER
     2197   Line format "X(107)" AT 1 SKIP
     2198   "Продолжение - на следующей странице" AT 30 SKIP
     2199   with FRAME BottomFrame1 width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     2200   VIEW stream PrnLibStream FRAME BottomFrame1 .
     2201   FIND FIRST ub.clients No-LOCK WHERE
     2202                ub.clients.obj-type = v-cntxt-obj-type
     2203            AND ub.clients.obj-code = v-cntxt-obj-code No-ERROR.
     2204   PUT stream PrnLibStream space(5)  "ОТЧЕТ  ПО  ПРОДАЖАМ ТОПЛИВА И СЕРВИСНОМУ ЭЛЕМЕНТУ С РАЗБИВКОЙ ПО ЦЕНЕ" skip(1).
     2205   PUT stream PrnLibStream UNFORMATTED str4 skip(0).
     2206   PUT stream PrnLibStream str1 format "X(120)" SKIP(1)
     2207   space(5) (
     2208   IF NotInc then
     2209   "( сформирован по ВСЕМ ЧЕКАМ " + (IF cas-num = 0 then "ВСЕХ КАСС" ELSE
     2210   ("КАССЫ " + string(cas-num))) + " , вошедшим в отчеты о продажах )"
     2211   else
     2212   "( сформирован по ВСЕМ ЧЕКАМ " + (IF cas-num = 0 then "ВСЕХ КАСС" ELSE
     2213   ("КАССЫ " + string(cas-num) ) ) + ")"
     2214    )
     2215   format "x(80)" skip
     2216   .
     2217               FORM with frame Benefit-Uchet .
     2218   FOR EACH benefits NO-LOCK BREAk BY benefits.b-code  BY benefits.out-code:
     2219           IF FIRST-OF(benefits.out-code) then do:
     2220               FIND FIRST ub.doc-line No-LOCK WHERE
     2221                                   ub.doc-line.artic = benefits.artic AND
     2222                                   ub.doc-line.prod-type = benefits.prod-type AND
     2223                                   ub.doc-line.prod-code = benefits.prod-code AND
     2224                                   ub.doc-line.doc-code = benefits.out-code NO-ERROR.
     2225               IF AVAIL doc-line then
     2226               for-tot-r-b = if v-curr-r-b = 'base':U
     2227                             then  ub.doc-line.price-base
     2228                             else ub.doc-line.price-rubl.
     2229               else for-tot-r-b = 0.
     2230               found = no.
     2231               if NOT benefits.main_ then do:
     2232                   FIND first ub.recipe-gds where ub.recipe-gds.recipe-code = ub.recipe.recipe-code No-LOCK NO-ERROR.
     2233                   IF not avail ub.recipe-gds then found = no.
     2234                   else do:
     2235                       FIND FIRST for-ben No-LOCK WHERE for-ben.artic = ub.recipe-gds.artic AND
     2236                                                                                 for-ben.prod-type = ub.recipe-gds.prod-type AND
     2237                                                                                 for-ben.prod-code = ub.recipe-gds.prod-code No-ERROR.
     2238                       IF not avail for-ben then found = no.
     2239                       else do:
     2240                           FIND FIRST recipe where ub.recipe-gds.recipe-code = ub.recipe.recipe-code No-LOCK.
     2241                           IF AVAIL recipe then do:
     2242                               FIND FIRST for-ben No-LOCK where for-ben.artic = ub.recipe.artic AND
     2243                                                                                         for-ben.prod-type = ub.recipe.prod-type AND
     2244                                                                                         for-ben.prod-code = ub.recipe.prod-code NO-ERROR.
     2245                               IF AVAIL for-ben then found = yes.
     2246                               else found = no.
     2247                           end.
     2248                           else found = no.
     2249                       end.
     2250                   end.
     2251               end.
     2252           end.
     2253           DISPLAY stream PrnLibStream
     2254           benefits.b-code
     2255           benefits.gds-name
     2256           benefits.unit-base
     2257           benefits.qnty
     2258           benefits.price-uchet * benefits.qnty  @ benefits.tot-r-b
     2259           benefits.tot-r-b-brutto
     2260           if found then for-ben.b-code else benefits.b-code @ for-ben.b-code
     2261           if benefits.main_ then 'осн' else "доп" @ for-main
     2262           sym1
     2263           sym6
     2264           sym7
     2265           with frame Benefit-Uchet .
     2266            DOWN stream PrnLibStream 1 with frame Benefit-Uchet .
     2267   END.
     2268           HIDE stream PrnLibStream FRAME BottomFrame1.
     2269               PUT stream PrnLibStream Line format "X(140)" SKIP(1) .
     2270           if ( line-counter( PrnLibStream ) + 9 ) > page-size( PrnLibStream ) then  page .
     2271           PUT stream PrnLibStream space(10) "Директор _______________" format "X(30)"
     2272                                   "Старший продавец ______________" format "X(30)" SKIP(2)
     2273                               space(10) "Бухгалтер ______________" format "X(30)"
     2274                                   "Кассир ________________________" format "X(30)" SKIP .
     2275           output stream PrnLibStream CLOSE.
     2276   END PROCEDURE.
     2277   PROCEDURE Print-no-break :
     2278   define variable found as logical init no no-undo.
     2279   run waitfram-hide in this-procedure .
     2280   run prn-lib-open-stream  in this-procedure (
     2281                                                input my-handle
     2282                                               ,input 43
     2283                                               ,input yes
     2284                                               ,input no
     2285                                               ).
     2286   FORM HEADER
     2287   Line format "X(107)" AT 1 SKIP
     2288   "Продолжение - на следующей странице" AT 30 SKIP
     2289   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     2290   VIEW stream PrnLibStream FRAME BottomFrame .
     2291   FIND FIRST ub.clients No-LOCK WHERE
     2292           ub.clients.obj-type = v-cntxt-obj-type
     2293       AND ub.clients.obj-code = v-cntxt-obj-code No-ERROR.
     2294   PUT stream PrnLibStream space(5)  "ОТЧЕТ  ПО  ПРОДАЖАМ ТОПЛИВА И СЕРВИСНОМУ ЭЛЕМЕНТУ" skip(1).
     2295   PUT stream PrnLibStream UNFORMATTED str4 skip(0).
     2296   PUT stream PrnLibStream UNFORMATTED str1
     2297   space(5) (
     2298   IF NotInc then
     2299   "( сформирован по ВСЕМ ЧЕКАМ " + (IF cas-num = 0 then "ВСЕХ КАСС" ELSE
     2300   ("КАССЫ " + string(cas-num))) + " , вошедшим в отчеты о продажах )"
     2301   else
     2302   "( сформирован по ВСЕМ ЧЕКАМ " + (IF cas-num = 0 then "ВСЕХ КАСС" ELSE
     2303   ("КАССЫ " + string(cas-num) ) ) + ")"
     2304    )
     2305   format "x(80)" skip
     2306   .
     2307               FORM with frame Benefit-Base .
     2308   FOR EACH benefits NO-LOCK WHERE benefits.main_ BREAk BY benefits.b-code  :
     2309           ACCUMULATE
     2310           benefits.qnty (total BY benefits.b-code)
     2311           benefits.tot-r-b (total BY benefits.b-code)
     2312           benefits.tot-r-b-brutto (total BY benefits.b-code).
     2313           FIND FIRST ub.recipe No-LOCK where ub.recipe.artic = benefits.artic AND
     2314                                                                    ub.recipe.prod-type = benefits.prod-type AND
     2315                                                                    ub.recipe.prod-code = benefits.prod-code NO-ERROR.
     2316           IF not avail ub.recipe then do:
     2317               found = no.
     2318           end.
     2319           else do:
     2320               FIND first ub.recipe-gds where ub.recipe-gds.recipe-code = ub.recipe.recipe-code No-LOCK NO-ERROR.
     2321               IF not avail recipe-gds then found = no.
     2322               else do:
     2323                   FIND FIRST for-ben No-LOCK WHERE for-ben.artic = ub.recipe-gds.artic AND
     2324                                                                                 for-ben.prod-type = ub.recipe-gds.prod-type AND
     2325                                                                                 for-ben.prod-code = ub.recipe-gds.prod-code No-ERROR.
     2326                   IF not avail for-ben then found = no.
     2327                   else found = yes.
     2328               end.
     2329           end.
     2330           if found then
     2331           ACCUMULATE
     2332           for-ben.qnty (TOTAL)
     2333           for-ben.tot-r-b (TOTAL).
     2334           ACCUMULATE
     2335           (benefits.tot-r-b-brutto - benefits.tot-r-b - (IF found then for-ben.tot-r-b else 0 )) (TOTAL)
     2336           (benefits.qnty - (IF found then for-ben.qnty else 0)) (TOTAL).
     2337           DISPLAY stream PrnLibStream
     2338                           benefits.b-code
     2339                           benefits.gds-name
     2340                           benefits.qnty
     2341                           benefits.tot-r-b-brutto @ for-tot-r-b
     2342                           for-ben.b-code when found
     2343                           for-ben.gds-name when found
     2344                           for-ben.qnty  when found
     2345                           for-ben.tot-r-b when found
     2346                           IF found then (benefits.qnty - for-ben.qnty) else benefits.qnty
     2347                           @ for-diff-q
     2348                           (IF found then (benefits.tot-r-b-brutto - benefits.tot-r-b - for-ben.tot-r-b) else
     2349                           (benefits.tot-r-b-brutto - benefits.tot-r-b))
     2350                           @ for-diff
     2351                           benefits.tot-r-b
     2352                           sym1
     2353                           sym6
     2354                           sym7
     2355                           with frame Benefit-Base .
     2356                           DOWN stream PrnLibStream 1 with frame Benefit-Base .
     2357           IF LAST(benefits.b-code) then do:
     2358               UNDERLINE stream PrnLibStream
     2359                           benefits.b-code
     2360                           benefits.gds-name
     2361                           benefits.qnty
     2362                           for-tot-r-b
     2363                           for-ben.b-code
     2364                           for-ben.gds-name
     2365                           for-ben.qnty
     2366                           for-ben.tot-r-b
     2367                           for-diff-q
     2368                           for-diff
     2369                           benefits.tot-r-b
     2370                           sym1
     2371                           sym6
     2372                           sym7
     2373                           with frame Benefit-Base .
     2374                DISPLAY stream PrnLibStream
     2375                           " " @ benefits.b-code
     2376                           "ИТОГО" @ benefits.gds-name
     2377                           ACCUM TOTAL benefits.qnty @ benefits.qnty
     2378                           ACCUM TOTAL benefits.tot-r-b-brutto @ for-tot-r-b
     2379                           " " @ for-ben.b-code
     2380                           " " @ for-ben.gds-name
     2381                           ACCUM TOTAL for-ben.qnty @ for-ben.qnty
     2382                           ACCUM TOTAL for-ben.tot-r-b @ for-ben.tot-r-b
     2383                           ACCUM TOTAL
     2384                           (benefits.qnty - (IF found then for-ben.qnty else 0))
     2385                           @ for-diff-q
     2386                           ACCUM TOTAL
     2387                           (benefits.tot-r-b-brutto - benefits.tot-r-b - (IF found then for-ben.tot-r-b else 0 ))
     2388                           @ for-diff
     2389                           ACCUM TOTAL benefits.tot-r-b @ benefits.tot-r-b
     2390                           sym1
     2391                           sym6
     2392                           sym7
     2393                           with frame Benefit-Base .
     2394                           DOWN stream PrnLibStream 1 with frame Benefit-Base .
     2395               UNDERLINE stream PrnLibStream
     2396                           benefits.b-code
     2397                           benefits.gds-name
     2398                           benefits.qnty
     2399                           for-tot-r-b
     2400                           for-ben.b-code
     2401                           for-ben.gds-name
     2402                           for-ben.qnty
     2403                           for-ben.tot-r-b
     2404                           for-diff-q
     2405                           for-diff
     2406                           benefits.tot-r-b
     2407                           sym1
     2408                           sym6
     2409                           sym7
     2410                           with frame Benefit-Base .
     2411                       end.
     2412   END.
     2413           HIDE stream PrnLibStream FRAME BottomFrame.
     2414               PUT stream PrnLibStream Line format "X(140)" SKIP(1) .
     2415           if ( line-counter( PrnLibStream ) + 9 ) > page-size( PrnLibStream ) then  page .
     2416           PUT stream PrnLibStream space(10) "Директор _______________" format "X(30)"
     2417                                   "Старший продавец ______________" format "X(30)" SKIP(2)
     2418                               space(10) "Бухгалтер ______________" format "X(30)"
     2419                                   "Кассир ________________________" format "X(30)" SKIP .
     2420           output stream PrnLibStream CLOSE.
     2421   END PROCEDURE.
     2422   PROCEDURE send-records :
     2423   END PROCEDURE.
     2424   PROCEDURE state-changed :
     2425     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
     2426     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     2427     CASE p-state:
     2428       WHEN "link-changed":U then do:
     2429           run ini-from-selobj(X-Selectobject).
     2430       end.
     2431     END CASE.
     2432   END PROCEDURE.
     2433   PROCEDURE top-sq :
     2434   define var b-sum as decimal no-undo.
     2435   define var b-sum-brutto as decimal no-undo.
     2436   define var b-qnty as decimal no-undo.
     2437   define variable me as logical init no no-undo.
     2438   if RS-method = "break":U then me = yes.
     2439   else me = no.
     2440   FOR EACH obj-list WHERE obj-list.obj-type = 'маг':U NO-LOCK :
     2441     ACCUMULATE obj-list.obj-code ( COUNT ) .
     2442     CASE (X-Radio-Task > 1):
     2443       WHEN YES THEN DO:
     2444         _chk-doc:
     2445         FOR EACH ub.chk-doc WHERE
     2446                 ub.chk-doc.obj-type = obj-list.obj-type AND
     2447                 ub.chk-doc.obj-code = obj-list.obj-code AND
     2448                   (
     2449                   ub.chk-doc.shift-date >= X-date-start AND
     2450                   ub.chk-doc.shift-date <= X-date-end)
     2451                   AND
     2452                 (IF cas-num > 0 then ub.chk-doc.pay-desk = cas-num else TRUE)
     2453                 NO-LOCK use-index shift,
     2454                 EACH ub.chk-gds NO-LOCK WHERE ub.chk-doc.doc-code = ub.chk-gds.doc-code AND ub.chk-gds.pump > 0
     2455           BREAK
     2456           BY ub.chk-doc.doc-code
     2457           BY ub.chk-gds.b-code:
     2458           if lookup(string(ub.chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next _chk-doc.
     2459           IF NOT ub.chk-doc.office = 'т':U  then NEXT.
     2460           IF X-Radio-Task = 3 AND
     2461           ((chk-doc.shift-date = X-date-start AND ub.chk-doc.shift-num < X-shift-Start) OR
     2462             (chk-doc.shift-date = X-date-end AND  ub.chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     2463           IF X-Radio-Task = 4 AND
     2464           (ub.chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     2465   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2466   IF NOT chk-doc.office = 'т':U  then NEXT.
     2467   if first-of(chk-gds.b-code)  then do:
     2468       FIND FIRST ub.bar-code NO-LOCK WHERE
     2469                  ub.bar-code.b-code = ub.chk-gds.b-code No-ERROR.
     2470       FIND FIRST ub.goods No-LOCK WHERE
     2471                  ub.goods.gds-code = ub.bar-code.gds-code NO-ERROR.
     2472       FIND FIRST ub.units WHERE
     2473                  ub.units.unit-name = ub.goods.unit-base No-LOCK No-ERROR.
     2474       assign
     2475       b-qnty = 0
     2476       b-sum = 0
     2477       b-sum-brutto = 0.
     2478   end.
     2479   assign
     2480   b-qnty = b-qnty + ub.chk-gds.doc-qnty
     2481   b-sum = b-sum  + ub.chk-gds.doc-qnty * (ub.chk-gds.price-base - ub.chk-gds.discnt)
     2482   b-sum-brutto = b-sum-brutto  + ub.chk-gds.doc-qnty * (ub.chk-gds.price-base - ub.chk-gds.discnt + ub.chk-gds.price-service)
     2483   .
     2484   IF LASt-of(chk-gds.b-code) then do:
     2485           IF me then
     2486           FIND FIRST benefits WHERE benefits.b-code = ub.chk-gds.b-code and
     2487                                                           benefits.out-code = ub.chk-gds.out-code and
     2488                                                           benefits.price = ub.chk-gds.price-base No-ERROR.
     2489           else
     2490           FIND FIRST benefits WHERE benefits.b-code = ub.chk-gds.b-code No-ERROR.
     2491           IF NOT avail benefits then do:
     2492               create benefits.
     2493               assign
     2494               benefits.b-code = ub.chk-gds.b-code
     2495               benefits.gds-name = ub.goods.gds-name
     2496               benefits.artic = ub.goods.artic
     2497               benefits.prod-type = ub.goods.prod-type
     2498               benefits.prod-code = ub.goods.prod-code
     2499               benefits.main_ =  IF LOOKUP('топ':U, units.type) > 0 and ub.goods.gds-type = 'у':U then no else yes
     2500               benefits.out-code = if me then ub.chk-gds.out-code else ?
     2501               benefits.price = if me then ub.chk-gds.price-base else 0
     2502               benefits.unit-base = ub.goods.unit-base.
     2503           end.
     2504           assign
     2505           benefits.qnty = benefits.qnty  + ub.chk-gds.doc-qnty
     2506           benefits.tot-r-b = benefits.tot-r-b + b-sum
     2507           benefits.tot-r-b-brutto = benefits.tot-r-b-brutto + b-sum-brutto
     2508           .
     2509   end.
     2510         end.
     2511       END.
     2512       WHEN NO THEN DO:
     2513         _chk-doc2:
     2514         FOR EACH ub.chk-doc WHERE
     2515                 ub.chk-doc.obj-type = obj-list.obj-type AND
     2516                 ub.chk-doc.obj-code = obj-list.obj-code AND
     2517                 ub.chk-doc.chk-date >= X-date-start AND
     2518                 ub.chk-doc.chk-date <= X-date-end AND
     2519                 (IF cas-num > 0 then ub.chk-doc.pay-desk = cas-num else TRUE)
     2520                 NO-LOCK,
     2521             EACH ub.chk-gds NO-LOCK WHERE
     2522                 ub.chk-doc.doc-code = ub.chk-gds.doc-code AND ub.chk-gds.pump > 0
     2523          BREAK
     2524          BY ub.chk-doc.doc-code
     2525          BY ub.chk-gds.b-code:
     2526            if lookup(string(ub.chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next _chk-doc2.
     2527   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2528   IF NOT chk-doc.office = 'т':U  then NEXT.
     2529   if first-of(chk-gds.b-code)  then do:
     2530       FIND FIRST ub.bar-code NO-LOCK WHERE
     2531                  ub.bar-code.b-code = ub.chk-gds.b-code No-ERROR.
     2532       FIND FIRST ub.goods No-LOCK WHERE
     2533                  ub.goods.gds-code = ub.bar-code.gds-code NO-ERROR.
     2534       FIND FIRST ub.units WHERE
     2535                  ub.units.unit-name = ub.goods.unit-base No-LOCK No-ERROR.
     2536       assign
     2537       b-qnty = 0
     2538       b-sum = 0
     2539       b-sum-brutto = 0.
     2540   end.
     2541   assign
     2542   b-qnty = b-qnty + ub.chk-gds.doc-qnty
     2543   b-sum = b-sum  + ub.chk-gds.doc-qnty * (ub.chk-gds.price-base - ub.chk-gds.discnt)
     2544   b-sum-brutto = b-sum-brutto  + ub.chk-gds.doc-qnty * (ub.chk-gds.price-base - ub.chk-gds.discnt + ub.chk-gds.price-service)
     2545   .
     2546   IF LASt-of(chk-gds.b-code) then do:
     2547           IF me then
     2548           FIND FIRST benefits WHERE benefits.b-code = ub.chk-gds.b-code and
     2549                                                           benefits.out-code = ub.chk-gds.out-code and
     2550                                                           benefits.price = ub.chk-gds.price-base No-ERROR.
     2551           else
     2552           FIND FIRST benefits WHERE benefits.b-code = ub.chk-gds.b-code No-ERROR.
     2553           IF NOT avail benefits then do:
     2554               create benefits.
     2555               assign
     2556               benefits.b-code = ub.chk-gds.b-code
     2557               benefits.gds-name = ub.goods.gds-name
     2558               benefits.artic = ub.goods.artic
     2559               benefits.prod-type = ub.goods.prod-type
     2560               benefits.prod-code = ub.goods.prod-code
     2561               benefits.main_ =  IF LOOKUP('топ':U, units.type) > 0 and ub.goods.gds-type = 'у':U then no else yes
     2562               benefits.out-code = if me then ub.chk-gds.out-code else ?
     2563               benefits.price = if me then ub.chk-gds.price-base else 0
     2564               benefits.unit-base = ub.goods.unit-base.
     2565           end.
     2566           assign
     2567           benefits.qnty = benefits.qnty  + ub.chk-gds.doc-qnty
     2568           benefits.tot-r-b = benefits.tot-r-b + b-sum
     2569           benefits.tot-r-b-brutto = benefits.tot-r-b-brutto + b-sum-brutto
     2570           .
     2571   end.
     2572          end.
     2573        END.
     2574      END CASE.
     2575   END.
     2576   END PROCEDURE.
