     1555   def temp-table benefits no-undo
     1556       Field b-code like ub.bar-code.b-code
     1557       field gds-name like ub.goods.gds-name
     1558       field artic like ub.goods.artic
     1559       field prod-type like ub.goods.prod-type
     1560       field prod-code like ub.goods.prod-code
     1561       field main_ as logical
     1562       field qnty as decimal format "->>>,>>>,>>9.999"
     1563       field tot-r-b like    ub.chk-pay.tot-base
     1564       field tot-r-b-brutto like    ub.chk-pay.tot-base
     1565       field price like ub.chk-gds.price-base
     1566       field price-uchet like ub.chk-gds.price-base
     1567       field out-code like ub.inkas.inkas-code
     1568       field unit-base like ub.goods.unit-base
     1569       INDEX pi IS PRIMARY     b-code main_  out-code price ASCENDING
     1570       INDEX p1 b-code ASCENDING
     1571       .
