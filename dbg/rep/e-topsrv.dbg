      790   define variable var-report-r-b as character no-undo .
      791   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      792   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      793     (output var-report-r-b
      794     )  .
      795   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      796   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      797   define new shared variable RepPathName        as character no-undo .
      798   define new shared variable PrintRubl          as logical   no-undo .
      799   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      800   define  stream PrnLibStream.
      801   procedure prn-lib-prn-file :
      802     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      803     define input parameter p-DIsabledoptions as integer no-undo .
      804     define variable v-report-name as character no-undo .
      805     define variable v-user-action as character no-undo .
      806     define variable v-printed     as logical   no-undo .
      807     define variable v-exist       as logical   no-undo .
      808     do
      809       on error undo, return error
      810       :
      811       run prn-lib-get-report-name  in this-procedure (
      812         input parParentProc
      813         ,output v-report-name
      814         ).
      815   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      816   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      817     (input  v-report-name
      818     ,input  2
      819     ,output v-exist
      820     )  .
      821       if NOT v-exist then
      822       DO:
      823         Message
      824           "Нет заданий на печать ! "
      825           view-as alert-box .
      826         Return  .
      827       End.
      828       run gbl/prnfilen.w
      829         (input  ""
      830         ,input  p-DisabledOptions
      831         ,input  string(v-report-name )
      832         ,input  7
      833         ,output v-user-action
      834         ,output v-printed
      835         ) .
      836       if v-printed then
      837       do:
      838         return "YES" .
      839       end.
      840       else
      841       do:
      842         return "NO" .
      843       end.
      844     end.
      845   end procedure.
      846   procedure prn-lib-open-stream :
      847     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      848     define input parameter p-page-size    as integer no-undo .
      849     define input parameter p-is-stream    as logical no-undo .
      850     define input parameter p-append       as logical no-undo .
      851     define variable v-report-name as character no-undo .
      852     do
      853       on error undo, return error
      854       :
      855       run prn-lib-get-report-name  in this-procedure (
      856         input parParentProc
      857         ,output v-report-name
      858         ).
      859       if p-is-stream then
      860       do:
      861         if p-append then
      862         do:
      863           output stream PrnLibStream to value( v-report-name )
      864             page-size value(p-page-size) append .
      865         end.
      866         if not p-append then
      867         do:
      868           output stream PrnLibStream to value( v-report-name )
      869             page-size value(p-page-size) .
      870         end.
      871       end.
      872       if not p-is-stream then
      873       do:
      874         if p-append then
      875         do:
      876           output to value( v-report-name )
      877             page-size value(p-page-size) append .
      878         end.
      879         if not p-append then
      880         do:
      881           output to value( v-report-name )
      882             page-size value(p-page-size) .
      883         end.
      884       end.
      885     end.
      886   end procedure.
      887   procedure prn-lib-open-exp :
      888     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      889     define input parameter p-is-stream    as logical no-undo .
      890     define input parameter p-is-append    as logical no-undo .
      891     define output parameter p-ReportFileName as char init "report" no-undo.
      892     define output parameter p-process as logical no-undo .
      893     define variable glog as logical no-undo .
      894     do
      895       on error undo, return error
      896       :
      897       SYSTEM-DIALOG GET-FILE p-ReportFileName
      898         TITLE      "Укажите путь"
      899         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      900         ASK-OVERWRITE
      901         CREATE-TEST-FILE
      902         SAVE-AS
      903         USE-FILENAME
      904         DEFAULT-EXTENSION "txt"
      905         UPDATE glog
      906         .
      907       if not glog then  return.
      908       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      909       if p-is-stream then
      910       do:
      911         if p-is-append then
      912         do:
      913           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      914         end.
      915         else
      916         do:
      917           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      918         end.
      919       end.
      920       else
      921       do:
      922         if p-is-append then
      923         do:
      924           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      925         end.
      926         else
      927         do:
      928           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      929         end.
      930       end.
      931       p-process = yes.
      932     end.
      933   end procedure.
      934   procedure prn-lib-get-report-name :
      935     define input parameter parParentProc  as widget-handle no-undo.
      936     define output parameter p-report-name as character no-undo .
      937     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      938   end procedure.
      939   procedure prn-lib-reportviewer-report-name :
      940     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      941     define input parameter p-report-name-html as character no-undo .
      942     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      943   end procedure.
      944   procedure prn-lib-reportviewer :
      945     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      946     define input parameter p-report-name-html as character no-undo .
      947     define input parameter p-param        as character no-undo .
      948     define variable v-excel           as character no-undo init 'TRUE' .
      949     define variable v-value-character as character no-undo .
      950     define variable v-value-integer   as character no-undo .
      951     define variable v-value-date      as date      no-undo .
      952     define variable v-value-decimal   as decimal   no-undo .
      953     define variable rep-excel         as logical   no-undo .
      954     define variable excel-string      as character no-undo .
      955     define variable v-param-type      as character no-undo .
      956     define variable v-tth             as handle    no-undo .
      957     run adm/shattri.p (
      958       input "get":U
      959       ,input  ""
      960       ,input  0
      961       ,input  'report-glob':U
      962       ,input  'rep-excel':U
      963       ,output v-value-character
      964       ,output v-value-date
      965       ,output v-value-decimal
      966       ,output v-value-integer
      967       ,output rep-excel
      968       ,output v-param-type
      969       ,INPUT-OUTPUT table-handle v-tth
      970       )  .
      971     if rep-excel then v-excel = "TRUE" .
      972     else v-excel = "FALSE" .
      973     if p-param eq ""
      974     then
      975        p-param = "EXCEL:" + v-excel.
      976     else
      977        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      978     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      979   end procedure.
      980   function diff-list returns character (
      981     input parfirst-list  as character,
      982     input parsecond-list as character,
      983     input pardelim       as character).
      984     if pardelim = ""
      985     or pardelim = ?
      986     then do:
      987       assign
      988         pardelim = ","
      989       .
      990     end.
      991     def var ind as integer no-undo .
      992     def var v-elem as character no-undo .
      993     def var v-result-list as character no-undo init "".
      994     def var v-num-parfirst-list as integer no-undo .
      995     assign
      996       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      997     .
      998     do ind = 1 to v-num-parfirst-list
      999     :
     1000       assign
     1001         v-elem = entry(ind, parfirst-list, pardelim)
     1002       .
     1003       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
     1004         assign
     1005           v-result-list = v-result-list
     1006                         + (if v-result-list > "" then pardelim else "")
     1007                         + v-elem
     1008         .
     1009       end.
     1010     end.
     1011     return v-result-list .
     1012   end function.
     1013   function add-list returns character (
     1014    input parfirst-list  as character,
     1015    input parsecond-list as character,
     1016    input pardelim       as character).
     1017     if pardelim = ""
     1018     or pardelim = ?
     1019     then do:
     1020       assign
     1021         pardelim = ","
     1022       .
     1023     end.
     1024     def var ind as integer no-undo .
     1025     def var v-elem as character no-undo .
     1026     def var v-result-list as character no-undo init "".
     1027     def var v-num-parfirst-list as integer no-undo .
     1028     assign
     1029       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1030     .
     1031     do ind = 1 to v-num-parfirst-list
     1032     :
     1033       assign
     1034         v-elem = entry(ind, parfirst-list, pardelim)
     1035       .
     1036       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
     1037         assign
     1038           v-result-list = v-result-list
     1039                         + (if v-result-list > "" then pardelim else "")
     1040                         + v-elem
     1041         .
     1042       end.
     1043     end.
     1044     def var v-num-parsecond-list as integer no-undo .
     1045     assign
     1046       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
     1047     .
     1048     do ind = 1 to v-num-parsecond-list
     1049     :
     1050       assign
     1051         v-elem = entry(ind, parsecond-list, pardelim)
     1052       .
     1053       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
     1054         assign
     1055           v-result-list = v-result-list
     1056                         + (if v-result-list > "" then pardelim else "")
     1057                         + v-elem
     1058         .
     1059       end.
     1060     end.
     1061     return v-result-list .
     1062   end function.
     1063   function cross-list returns character (
     1064    input parfirst-list  as character,
     1065    input parsecond-list as character,
     1066    input pardelim       as character).
     1067     if pardelim = ""
     1068     or pardelim = ?
     1069     then do:
     1070       assign
     1071         pardelim = ","
     1072       .
     1073     end.
     1074     def var ind as integer no-undo .
     1075     def var v-elem as character no-undo .
     1076     def var v-result-list as character no-undo init "".
     1077     def var v-num-parfirst-list as integer no-undo .
     1078     assign
     1079       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1080     .
     1081     do ind = 1 to v-num-parfirst-list
     1082     :
     1083       assign
     1084         v-elem = entry(ind, parfirst-list, pardelim)
     1085       .
     1086       if lookup(v-elem, v-result-list, pardelim) = 0
     1087       and lookup(v-elem, parsecond-list, pardelim) > 0
     1088       then do:
     1089         assign
     1090           v-result-list = v-result-list
     1091                         + (if v-result-list > "" then pardelim else "")
     1092                         + v-elem
     1093         .
     1094       end.
     1095     end.
     1096     return v-result-list .
     1097   end function.
     1098   function radio-label returns character (
     1099    input par-rs-value  as character,
     1100    input par-rs-radio-buttons as character)
     1101    .
     1102    DEFINE variable v-result-label as character no-undo.
     1103    assign
     1104    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
     1105                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
     1106                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
     1107                             ), par-rs-radio-buttons
     1108                           )
     1109    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1110    .
     1111   return v-result-label.
     1112   end function.
     1113   function m-radio-label returns character (
     1114    input par-rs-value  as character,
     1115    input par-rs-radio-buttons as character,
     1116    input par-delim as character
     1117    )
     1118    .
     1119    DEFINE variable v-result-label as character no-undo.
     1120    assign
     1121    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
     1122                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
     1123                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
     1124                             ), par-rs-radio-buttons, par-delim
     1125                           )
     1126    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1127    .
     1128   return v-result-label.
     1129   end function.
     1130   FUNCTION mixlist returns character
     1131   (
     1132    input parfirst-list  as character
     1133    ,input parsecond-list as character
     1134    ,input pardelim       as character
     1135    ,input pardelim-result as character ) :
     1136     if pardelim = ""
     1137     or pardelim = ?
     1138     then do:
     1139       assign
     1140         pardelim = ","
     1141       .
     1142     end.
     1143     def var ind as integer no-undo .
     1144     def var v-elem1 as character no-undo .
     1145     def var v-elem2 as character no-undo .
     1146     def var v-result-list as character no-undo init "".
     1147     do ind = 1 to num-entries(parfirst-list, pardelim)
     1148     :
     1149       assign
     1150         v-elem1 = entry(ind, parfirst-list, pardelim)
     1151         v-elem2 = entry(ind, parsecond-list, pardelim)
     1152       .
     1153         assign
     1154           v-result-list = v-result-list
     1155                         + (if v-result-list > "" then pardelim-result else "")
     1156                         + v-elem1 + pardelim-result + v-elem2
     1157         .
     1158     end.
     1159     return v-result-list .
     1160   END FUNCTION.
