     1096   procedure prn-lib-open-stream :
     1097     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1098     define input parameter p-page-size    as integer no-undo .
     1099     define input parameter p-is-stream    as logical no-undo .
     1100     define input parameter p-append       as logical no-undo .
     1101     define variable v-report-name as character no-undo .
     1102     do
     1103       on error undo, return error
     1104       :
     1105       run prn-lib-get-report-name  in this-procedure (
     1106         input parParentProc
     1107         ,output v-report-name
     1108         ).
     1109       if p-is-stream then
     1110       do:
     1111         if p-append then
     1112         do:
     1113           output stream PrnLibStream to value( v-report-name )
     1114             page-size value(p-page-size) append .
     1115         end.
     1116         if not p-append then
     1117         do:
     1118           output stream PrnLibStream to value( v-report-name )
     1119             page-size value(p-page-size) .
     1120         end.
     1121       end.
     1122       if not p-is-stream then
     1123       do:
     1124         if p-append then
     1125         do:
     1126           output to value( v-report-name )
     1127             page-size value(p-page-size) append .
     1128         end.
     1129         if not p-append then
     1130         do:
     1131           output to value( v-report-name )
     1132             page-size value(p-page-size) .
     1133         end.
     1134       end.
     1135     end.
     1136   end procedure.
     1137   procedure prn-lib-open-exp :
     1138     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1139     define input parameter p-is-stream    as logical no-undo .
     1140     define input parameter p-is-append    as logical no-undo .
     1141     define output parameter p-ReportFileName as char init "report" no-undo.
     1142     define output parameter p-process as logical no-undo .
     1143     define variable glog as logical no-undo .
     1144     do
     1145       on error undo, return error
     1146       :
     1147       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1148         TITLE      "Укажите путь"
     1149         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1150         ASK-OVERWRITE
     1151         CREATE-TEST-FILE
     1152         SAVE-AS
     1153         USE-FILENAME
     1154         DEFAULT-EXTENSION "txt"
     1155         UPDATE glog
     1156         .
     1157       if not glog then  return.
     1158       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1159       if p-is-stream then
     1160       do:
     1161         if p-is-append then
     1162         do:
     1163           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1164         end.
     1165         else
     1166         do:
     1167           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1168         end.
     1169       end.
     1170       else
     1171       do:
     1172         if p-is-append then
     1173         do:
     1174           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1175         end.
     1176         else
     1177         do:
     1178           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1179         end.
     1180       end.
     1181       p-process = yes.
     1182     end.
     1183   end procedure.
