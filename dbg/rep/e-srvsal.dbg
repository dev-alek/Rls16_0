     1392   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1393   PROCEDURE no-benq.
     1394   DEFINE OUTPUT PARAMETER found as logical init no.
     1395   define buffer buf_chk-doc for ub.chk-doc.
     1396   FOR EACH obj-list WHERE
     1397           obj-list.obj-type = 'маг':U NO-LOCK :
     1398     CASE X-Radio-Task > 1 :
     1399       WHEN YES THEN DO:
     1400         FOR EACH buf_chk-doc NO-LOCK WHERE
     1401                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1402                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1403                 (
     1404                   buf_chk-doc.shift-date >= X-date-start AND
     1405                   buf_chk-doc.shift-date <= X-date-end)
     1406                   AND
     1407                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1408           IF X-Radio-Task = 3 AND
     1409           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     1410             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     1411           IF X-Radio-Task = 4 AND
     1412           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1413           found = yes.
     1414           return.
     1415         END.
     1416       END.
     1417       WHEN NO THEN DO:
     1418         FOR EACH buf_chk-doc NO-LOCK WHERE
     1419               buf_chk-doc.obj-type = obj-list.obj-type AND
     1420               buf_chk-doc.obj-code = obj-list.obj-code AND
     1421               buf_chk-doc.chk-date >= X-date-start AND
     1422               buf_chk-doc.chk-date <= X-date-end   AND
     1423               (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1424           found = yes.
     1425           return.
     1426         END.
     1427        END.
     1428      END CASE.
     1429    END.
     1430   END PROCEDURE.
     1431   PROCEDURE no-benqi.
     1432   DEFINE OUTPUT PARAMETER found as logical init no.
     1433   define buffer buf_chk-doc for ub.chk-doc.
     1434   define buffer buf_inkas for ub.inkas.
     1435   FOR EACH obj-list WHERE
     1436         obj-list.obj-type = 'маг':U NO-LOCK :
     1437     CASE X-Radio-Task > 1 :
     1438       WHEN YES THEN DO:
     1439         FOR EACH buf_chk-doc No-LOCK WHERE
     1440                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1441                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1442                 (
     1443                   buf_chk-doc.shift-date >= X-date-start AND
     1444                   buf_chk-doc.shift-date <= X-date-end)
     1445                   AND
     1446                   buf_Chk-doc.out-code = ? AND
     1447                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1448           IF X-Radio-Task = 3 AND
     1449           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     1450             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     1451           IF X-Radio-Task = 4 AND
     1452           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1453           found = yes.
     1454           return.
     1455         END.
     1456         FOR EACH buf_inkas No-LOCK WHERE
     1457                   buf_inkas.obj-type = obj-list.obj-type AND
     1458                   buf_inkas.obj-code = obj-list.obj-code AND
     1459                   (
     1460                   buf_inkas.shift-date >= X-date-start AND
     1461                   buf_inkas.shift-date <= X-date-end):
     1462           if buf_inkas.status_ = 'факт':U
     1463           or buf_inkas.status_ = 'запрос':U then next.
     1464           IF X-Radio-Task = 3 AND
     1465           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
     1466             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
     1467           IF X-Radio-Task = 4 AND
     1468           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
     1469           found = yes.
     1470           return.
     1471         END.
     1472       END.
     1473       WHEN NO THEN DO:
     1474         FOR EACH buf_chk-doc NO-LOCK WHERE
     1475                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1476                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1477                 buf_chk-doc.chk-date >= X-date-start AND
     1478                 buf_chk-doc.chk-date <= X-date-end   AND
     1479                 buf_Chk-doc.out-code = ? AND
     1480                 (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1481           found = yes.
     1482           return.
     1483         END.
     1484         FOR EACH buf_inkas NO-LOCK WHERE
     1485                 buf_inkas.obj-type = obj-list.obj-type AND
     1486                 buf_inkas.obj-code = obj-list.obj-code AND
     1487                 buf_inkas.doc-date >= X-date-start AND
     1488                 buf_inkas.doc-date <= X-date-end :
     1489           if buf_inkas.status_ = 'факт':U
     1490           or buf_inkas.status_ = 'запрос':U then next.
     1491           found = yes.
     1492           return.
     1493         END.
     1494       END.
     1495     END CASE.
     1496   END.
     1497   END PROCEDURE.
     1498   PROCEDURE no-benq-i.
     1499   DEFINE OUTPUT PARAMETER found as logical init no.
     1500   define buffer buf_inkas for ub.inkas.
     1501   CASE X-Radio-Task > 1:
     1502     WHEN YES then do:
     1503       FOR EACH obj-list WHERE
     1504               obj-list.obj-type = 'маг':U NO-LOCK :
     1505         FOR EACH buf_inkas NO-LOCK WHERE
     1506                 buf_inkas.obj-type = obj-list.obj-type AND
     1507                 buf_inkas.obj-code = obj-list.obj-code AND
     1508                 buf_inkas.status_ = 'факт':U AND
     1509                 (
     1510                 buf_inkas.shift-date >= X-date-start AND
     1511                 buf_inkas.shift-date <= X-date-end):
     1512           IF X-Radio-Task = 3 AND
     1513           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
     1514             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
     1515           IF X-Radio-Task = 4 AND
     1516           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
     1517           found = yes.
     1518           return.
     1519         END.
     1520     END.
     1521     END.
     1522     WHEN NO THEN DO:
     1523       FOR EACH obj-list WHERE
     1524               obj-list.obj-type = 'маг':U NO-LOCK :
     1525         FOR EACH buf_inkas NO-LOCK WHERE
     1526                 buf_inkas.obj-type = obj-list.obj-type AND
     1527                 buf_inkas.obj-code = obj-list.obj-code AND
     1528                 buf_inkas.status_ = 'факт':U AND
     1529                 buf_inkas.doc-date >= X-date-start AND
     1530                 buf_inkas.doc-date <= X-date-end :
     1531            found = yes.
     1532            return.
     1533         END.
     1534       END.
     1535     END.
     1536   END CASE.
     1537   END PROCEDURE.
     1538   PROCEDURE no-benq-i-office.
     1539   DEFINE OUTPUT PARAMETER found as logical init no.
     1540   define buffer buf_sale-doc for ub.sale-doc.
     1541   CASE X-Radio-Task > 1:
     1542     WHEN YES then do:
     1543       FOR EACH obj-list WHERE
     1544               obj-list.obj-type = 'маг':U NO-LOCK :
     1545         FOR EACH buf_sale-doc NO-LOCK WHERE
     1546                  buf_Sale-doc.obj-type = obj-list.obj-type
     1547              AND buf_sale-doc.obj-code = obj-list.obj-code
     1548              AND buf_sale-doc.status_ = 'факт':U
     1549              AND buf_sale-doc.chr-office = 'у':U
     1550              AND (
     1551                 buf_sale-doc.shift-date >= X-date-start
     1552                 AND
     1553                 buf_sale-doc.shift-date <= X-date-end):
     1554           IF X-Radio-Task = 3 AND
     1555           ((buf_sale-doc.shift-date = X-date-start AND buf_sale-doc.shift-num < X-shift-Start) OR
     1556             (buf_sale-doc.shift-date = X-date-end AND  buf_sale-doc.shift-num > X-shift-End) ) THEN NEXT.
     1557           IF X-Radio-Task = 4 AND
     1558           (buf_sale-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1559           found = yes.
     1560           return.
     1561         END.
     1562       END.
     1563     END.
     1564     WHEN NO THEN DO:
     1565       FOR EACH obj-list WHERE
     1566               obj-list.obj-type = 'маг':U NO-LOCK :
     1567         FOR EACH buf_sale-doc NO-LOCK WHERE
     1568                 buf_sale-doc.obj-type = obj-list.obj-type
     1569            AND  buf_sale-doc.obj-code = obj-list.obj-code
     1570            AND  buf_sale-doc.status_ = 'факт':U
     1571            AND  buf_sale-doc.chr-office = 'у':U
     1572            AND  buf_sale-doc.doc-date >= X-date-start
     1573            AND  buf_sale-doc.doc-date <= X-date-end :
     1574           found = yes.
     1575           return.
     1576         END.
     1577       END.
     1578     END.
     1579   END CASE.
     1580   END PROCEDURE.
     1581   assign
     1582       date_string = cur-time-print()
     1583       Line = fill( "-", 250 ).
     1584   run no-benq-i-office in this-procedure ( output found).
     1585   if not found then do:
     1586     run waitfram-hide in this-procedure .
     1587     message "Не было никакой реализации услуг на выбранных объектах в течение заданного Вами периода времени." view-as alert-box information .
     1588     return.
     1589   end.
     1590   run waitfram-show in this-procedure ('Подождите ...' ) .
     1591   Run ByTemp in this-procedure .
     1592   PROCEDURE ByTemp:
     1593   define variable accum-tot-doc as decimal no-undo .
     1594   define variable accum-discnt as decimal no-undo .
     1595   define variable accum-num-chk as decimal no-undo .
     1596   define variable accum-fact-qnty as decimal no-undo .
     1597   define variable accum-netto as decimal no-undo .
     1598   define variable accum-tot-doc-by-date as decimal no-undo .
     1599   define variable accum-discnt-by-date as decimal no-undo .
     1600   define variable accum-num-chk-by-date as decimal no-undo .
     1601   define variable accum-fact-qnty-by-date as decimal no-undo .
     1602   define variable accum-netto-by-date as decimal no-undo .
     1603   define variable v-curr-r-b as character no-undo .
     1604   define variable accum-count as integer no-undo .
     1605   define variable num-objs as integer   no-undo .
     1606   define buffer buf_Sale-doc for ub.sale-doc.
     1607   define buffer buf_trn-doc for ub.trn-doc.
     1608   define buffer obj_temp-serv for temp-serv.
     1609   define buffer tot_temp-serv for temp-serv.
     1610   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1611   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1612     (output v-curr-r-b
     1613     )  .
     1614   v-curr-r-b = 'base':U.
     1615   run prn-lib-open-stream  in this-procedure (
     1616                                                input my-handle
     1617                                               ,input 62
     1618                                               ,input yes
     1619                                               ,input no
     1620                                               ).
     1621   FORM HEADER
     1622   Line format "X(231)" AT 1 SKIP
     1623   "Продолжение - на следующей странице" AT 90 SKIP
     1624   with FRAME NBottomFrame width 232
     1625   PAGE-BOTTOM NO-LABELS NO-BOX .
     1626   VIEW stream PrnLibStream FRAME NBottomFrame .
     1627   PUT stream PrnLibStream SPACE(30)
     1628   "РЕАЛИЗАЦИЯ  УСЛУГ  " str1 format "x(110)" SKIP(1).
     1629   PUT stream PrnLibStream SPACE(30) "По объектам :"
     1630               format "X(130)" SKIP(1).
     1631   FOR EACH obj-list :
     1632           FIND cli-obj WHERE cli-obj.obj-type = obj-list.obj-type AND
     1633                                             cli-obj.obj-code = obj-list.obj-code NO-LOCK .
     1634           PUT stream PrnLibStream SPACE(30) cli-obj.obj-name format "X(100)" SKIP.
     1635   END.
     1636   PUT stream PrnLibStream " " SKIP(1) .
     1637   for each temp-serv:
     1638     delete temp-serv.
     1639   end.
     1640   FOR EACH obj-list ,
     1641     each buf_Sale-doc no-lock where
     1642        buf_sale-doc.obj-type = obj-list.obj-type
     1643    and buf_sale-doc.obj-code = obj-list.obj-code
     1644    and buf_sale-doc.chr-office = 'у':U
     1645    and buf_sale-doc.status_ = 'факт':U,
     1646     first buf_trn-doc no-lock WHERE
     1647       buf_trn-doc.doc-code = buf_sale-doc.doc-code
     1648     BREAK
     1649     BY  buf_trn-doc.obj-type
     1650     BY  buf_trn-doc.obj-code
     1651     BY  buf_trn-doc.status_
     1652     BY  buf_trn-doc.fact-date
     1653      :
     1654       if first-of(buf_trn-doc.fact-date) then do:
     1655         assign
     1656         accum-tot-doc-by-date    = 0
     1657         accum-discnt-by-date     = 0
     1658         accum-num-chk-by-date    = 0
     1659         accum-fact-qnty-by-date  = 0
     1660         accum-netto-by-date      = 0
     1661         .
     1662       end.
     1663       if first-of(buf_trn-doc.obj-code) then do:
     1664         assign
     1665         accum-tot-doc    = 0
     1666         accum-discnt     = 0
     1667         accum-num-chk    = 0
     1668         accum-fact-qnty  = 0
     1669         accum-netto      = 0
     1670         .
     1671       end.
     1672       assign
     1673       accum-netto-by-date = accum-netto-by-date +
     1674                             (if v-curr-r-b = 'rubl':U
     1675                             then buf_trn-doc.tot-sale - buf_trn-doc.discnt-rubl
     1676                             else buf_trn-doc.tot-fact - buf_trn-doc.tot-calc) * buf_sale-doc.dir
     1677       accum-netto  = accum-netto +
     1678                             (if v-curr-r-b = 'rubl':U
     1679                             then buf_trn-doc.tot-sale - buf_trn-doc.discnt-rubl
     1680                             else buf_trn-doc.tot-fact - buf_trn-doc.tot-calc) * buf_sale-doc.dir
     1681       accum-tot-doc-by-date = accum-tot-doc-by-date + buf_trn-doc.tot-doc * buf_sale-doc.dir
     1682       accum-tot-doc = accum-tot-doc + buf_trn-doc.tot-doc
     1683       accum-discnt = accum-tot-doc - accum-netto
     1684       accum-discnt-by-date = accum-tot-doc-by-date - accum-netto-by-date
     1685       accum-num-chk = accum-num-chk + buf_sale-doc.chk-amount
     1686       accum-num-chk-by-date = accum-num-chk-by-date + buf_sale-doc.chk-amount
     1687       accum-fact-qnty = accum-fact-qnty + buf_sale-doc.fact-qnty
     1688       accum-fact-qnty-by-date = accum-fact-qnty-by-date + buf_sale-doc.fact-qnty
     1689       .
     1690       PROCESS EVENTS .
     1691       if last-of( buf_trn-doc.fact-date ) then do:
     1692         accum-count = accum-count + 1.
     1693         if accum-count modulo 2  = 0
     1694         AND accum-count >= 2
     1695         then do:
     1696           run waitfram-show in this-procedure ( substitute("Обработано дней : &1" , accum-count)).
     1697         end.
     1698         find first temp-serv where
     1699                   temp-serv.fact-date = buf_trn-doc.fact-date
     1700               and temp-serv.obj-type = ''
     1701               and temp-serv.obj-code = 0 no-error.
     1702         if not available temp-serv then do:
     1703           create temp-serv.
     1704           assign
     1705           temp-serv.obj-type   = ''
     1706           temp-serv.obj-code   = 0
     1707           temp-serv.fact-date = buf_trn-doc.fact-date
     1708           temp-serv.tot-doc = temp-serv.tot-doc + accum-tot-doc-by-date
     1709           temp-serv.discnt = temp-serv.discnt + accum-discnt-by-date
     1710           temp-serv.num-chk = temp-serv.num-chk + accum-num-chk-by-date
     1711           temp-serv.fact-qnty = temp-serv.fact-qnty + accum-fact-qnty-by-date
     1712           temp-serv.netto = temp-serv.netto + accum-netto-by-date
     1713           .
     1714           release temp-serv.
     1715         end.
     1716       end.
     1717       if last-of( buf_trn-doc.obj-code ) then do:
     1718         num-objs = num-objs + 1.
     1719         find first temp-serv where
     1720                   temp-serv.fact-date = 01/01/1990
     1721               and temp-serv.obj-type = buf_trn-doc.obj-type
     1722               and temp-serv.obj-code = buf_trn-doc.obj-code no-error.
     1723         if not available temp-serv then do:
     1724           create temp-serv.
     1725           assign
     1726           temp-serv.obj-type   = buf_trn-doc.obj-type
     1727           temp-serv.obj-code   = buf_trn-doc.obj-code
     1728           temp-serv.fact-date = 01/01/1990
     1729           temp-serv.tot-doc = temp-serv.tot-doc + accum-tot-doc
     1730           temp-serv.discnt = temp-serv.discnt + accum-discnt
     1731           temp-serv.num-chk = temp-serv.num-chk + accum-num-chk
     1732           temp-serv.fact-qnty = temp-serv.fact-qnty + accum-fact-qnty
     1733           temp-serv.netto = temp-serv.netto + accum-netto
     1734           .
     1735           release temp-serv.
     1736         end.
     1737         find first temp-serv where
     1738                   temp-serv.fact-date = 01/01/1990
     1739               and temp-serv.obj-type = ''
     1740               and temp-serv.obj-code = 0 no-error.
     1741         if not available temp-serv then do:
     1742           create temp-serv.
     1743           assign
     1744           temp-serv.obj-type   = ''
     1745           temp-serv.obj-code   = 0
     1746           temp-serv.fact-date = 01/01/1990
     1747           .
     1748         end.
     1749         assign
     1750         temp-serv.tot-doc = temp-serv.tot-doc + accum-tot-doc
     1751         temp-serv.discnt = temp-serv.discnt + accum-discnt
     1752         temp-serv.num-chk = temp-serv.num-chk + accum-num-chk
     1753         temp-serv.fact-qnty = temp-serv.fact-qnty + accum-fact-qnty
     1754         temp-serv.netto = temp-serv.netto + accum-netto
     1755         .
     1756         release temp-serv.
     1757       end.
     1758     end.
     1759     FOR each temp-serv where
     1760             temp-serv.obj-type = ''
     1761         and temp-serv.obj-code = 0
     1762         and temp-serv.fact-date > 01/01/1990
     1763     break
     1764     by temp-serv.fact-date
     1765     with FRAME GoodsRep
     1766     :
     1767       pcnt = round(  temp-serv.discnt /  temp-serv.tot-doc * 100, 1 ) .
     1768       if pcnt = ? then pcnt = 0.
     1769       DISPLAY stream PrnLibStream
     1770       sym1 temp-serv.fact-date
     1771       sym2
     1772       temp-serv.fact-qnty
     1773       sym3
     1774       temp-serv.tot-doc
     1775       sym4
     1776       temp-serv.discnt
     1777       sym8 pcnt    when pcnt <> 0
     1778       sym5 temp-serv.netto
     1779       sym6
     1780       temp-serv.num-chk
     1781       sym7
     1782       .
     1783       DOWN stream PrnLibStream 1  .
     1784       if last( temp-serv.fact-date ) then do:
     1785         if num-objs > 1 then do:
     1786           UNDERLINE stream PrnLibStream
     1787           temp-serv.fact-date
     1788           temp-serv.fact-qnty
     1789           temp-serv.tot-doc
     1790           temp-serv.discnt
     1791           pcnt
     1792           temp-serv.netto
     1793           temp-serv.num-chk
     1794           with FRAME GoodsRep
     1795           .
     1796           for each obj_temp-serv where
     1797                   obj_temp-serv.fact-date = 01/01/1990
     1798                and obj_temp-serv.obj-type > ''
     1799           by obj_temp-serv.obj-type
     1800           by obj_temp-serv.obj-code:
     1801             pcnt = round( obj_temp-serv.discnt / obj_temp-serv.tot-doc * 100, 1 ) .
     1802             if pcnt = ? then pcnt = 0.
     1803             DISPLAY stream PrnLibStream
     1804             sym1
     1805             sym2 substitute("маг &1", obj_temp-serv.obj-code) @ temp-serv.fact-date
     1806             sym3 obj_temp-serv.fact-qnty @ temp-serv.fact-qnty
     1807             sym4 obj_temp-serv.tot-doc @ temp-serv.tot-doc
     1808             sym5 obj_temp-serv.discnt @ temp-serv.discnt
     1809             sym6 pcnt    when pcnt <> 0
     1810             sym7 obj_temp-serv.netto @ temp-serv.netto
     1811             sym8 obj_temp-serv.num-chk @ temp-serv.num-chk
     1812             with FRAME GoodsRep
     1813             .
     1814             DOWN stream PrnLibStream 1  with FRAME GoodsRep. .
     1815           end.
     1816           UNDERLINE stream PrnLibStream
     1817           temp-serv.fact-date
     1818           temp-serv.fact-qnty
     1819           temp-serv.tot-doc
     1820           temp-serv.discnt
     1821           pcnt
     1822           temp-serv.netto
     1823           temp-serv.num-chk
     1824           with FRAME GoodsRep
     1825           .
     1826         end.
     1827         else do:
     1828           UNDERLINE stream PrnLibStream
     1829           temp-serv.fact-date
     1830           temp-serv.fact-qnty
     1831           temp-serv.tot-doc
     1832           temp-serv.discnt
     1833           pcnt
     1834           temp-serv.netto
     1835           temp-serv.num-chk
     1836           with FRAME GoodsRep
     1837           .
     1838         end.
     1839         find first tot_temp-serv where
     1840                   tot_temp-serv.fact-date = 01/01/1990
     1841              and  tot_temp-serv.obj-type = ''
     1842              and  tot_temp-serv.obj-code = 0.
     1843           pcnt = round( tot_temp-serv.discnt / tot_temp-serv.tot-doc * 100, 1 ) .
     1844           if pcnt = ? then pcnt = 0.
     1845           DISPLAY stream PrnLibStream
     1846           sym1 "ИТОГО" @ temp-serv.fact-date
     1847           sym2 tot_temp-serv.fact-qnty @ temp-serv.fact-qnty
     1848           sym3 tot_temp-serv.tot-doc @ temp-serv.tot-doc
     1849           sym4 tot_temp-serv.discnt @ temp-serv.discnt
     1850           sym5 pcnt    when pcnt <> 0
     1851           sym6 tot_temp-serv.netto @ temp-serv.netto
     1852           sym7 tot_temp-serv.num-chk @ temp-serv.num-chk
     1853           sym8
     1854           with FRAME GoodsRep
     1855           .
     1856         end.
     1857       END.
     1858       HIDE stream PrnLibStream FRAME NBottomFrame .
     1859       run waitfram-hide in this-procedure .
     1860       output stream PrnLibStream CLOSE .
     1861       run prn-lib-prn-file in this-procedure (
     1862                                                 input my-handle
     1863                                                 ,input 0
     1864                                                 ).
     1865   END PROCEDURE.
