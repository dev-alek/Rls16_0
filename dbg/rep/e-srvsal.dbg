     1194   procedure prn-lib-reportviewer :
     1195     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1196     define input parameter p-report-name-html as character no-undo .
     1197     define input parameter p-param        as character no-undo .
     1198     define variable v-excel           as character no-undo init 'TRUE' .
     1199     define variable v-value-character as character no-undo .
     1200     define variable v-value-integer   as character no-undo .
     1201     define variable v-value-date      as date      no-undo .
     1202     define variable v-value-decimal   as decimal   no-undo .
     1203     define variable rep-excel         as logical   no-undo .
     1204     define variable excel-string      as character no-undo .
     1205     define variable v-param-type      as character no-undo .
     1206     define variable v-tth             as handle    no-undo .
     1207     run adm/shattri.p (
     1208       input "get":U
     1209       ,input  ""
     1210       ,input  0
     1211       ,input  'report-glob':U
     1212       ,input  'rep-excel':U
     1213       ,output v-value-character
     1214       ,output v-value-date
     1215       ,output v-value-decimal
     1216       ,output v-value-integer
     1217       ,output rep-excel
     1218       ,output v-param-type
     1219       ,INPUT-OUTPUT table-handle v-tth
     1220       )  .
     1221     if rep-excel then v-excel = "TRUE" .
     1222     else v-excel = "FALSE" .
     1223     if p-param eq ""
