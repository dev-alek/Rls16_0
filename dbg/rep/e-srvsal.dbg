      794   define variable var-report-r-b as character no-undo .
      795   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      796   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      797     (output var-report-r-b
      798     )  .
      799   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      800   define variable v-waitfram-action01         as character   no-undo .
      801   define variable v-waitfram-action02         as character   no-undo .
      802   define variable v-waitfram-action03         as character   no-undo .
      803   define variable mWaitFramTextBeg            as character   no-undo.
      804   define variable mWaitFramTextEnd            as character   no-undo.
      805   define variable mWaitFramView               as logical     no-undo.
      806   define variable mWaitProcEvent              as logical     no-undo init yes.
      807   define variable mWaitFramInterval           as integer     no-undo init 1 .
      808   define variable mWaitFramStop               as logical     no-undo.
      809   define variable mWaitFramStopUser           as logical     no-undo.
      810   define variable mWaitFramStopTimeOut        as logical     no-undo.
      811   define variable mWaitFramStartProc          as datetime-tz no-undo.
      812   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      813   define button B-WaitFramStop auto-end-key
      814        label "Стоп"
      815        size 10 by 1 tooltip "Остоновить процесс".
      816   define button B-viewProcInfo
      817        label "Информация"
      818        size 15 by 1 tooltip "Информация о процесс".
      819   define frame waitfram
      820     v-waitfram-action01 format "x(72)" no-label skip
      821     v-waitfram-action02 format "x(72)" no-label skip
      822     v-waitfram-action03 format "x(72)" no-label skip
      823     B-viewProcInfo
      824     B-WaitFramStop at row 4 col 30
      825     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      826     .
      827   define new global shared variable mBatchMode as logical no-undo init ?.
      828   define variable mFramBachModHandle as handle no-undo.
      829   mFramBachModHandle = frame waitfram:handle.
      830   define variable mFameOldVis as logical no-undo.
      831   define variable mVisCUrentVin as logical no-undo.
      832   if session:batch-mode
      833   then
      834      mBatchMode = yes.
      835   if mBatchMode = ? then do:
      836     mVisCUrentVin = current-window:visible.
      837     mFameOldVis = mFramBachModHandle:visible.
      838     mFramBachModHandle:visible  = yes.
      839     mBatchMode = mFramBachModHandle:visible ne yes.
      840     mFramBachModHandle:visible = mFameOldVis.
      841     current-window:visible = mVisCUrentVin.
      842   end.
      843    if  log-manager:logfile-name ne ?
      844     then DO:
      845         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      846         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      847         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      848     end.
      849   on choose of B-WaitFramStop in frame waitfram
      850   do:
      851     mWaitFramStop = yes.
      852     mWaitFramStopUser = yes.
      853   end.
      854   function waitfram-check-timeout returns logical():
      855      define variable vtime as int64 no-undo.
      856      if mWaitFramStopTimeOut
      857      then
      858         return yes.
      859      vtime = ( now - mWaitFramStartProc ) / 1000 .
      860      if     mWaitFramTimeOut ne ?
      861         and mWaitFramTimeOut ne 0
      862         and mWaitFramTimeOut lt vtime
      863      then do:
      864         mWaitFramStopTimeOut = yes.
      865      end.
      866      return mWaitFramStopTimeOut.
      867   end.
      868   procedure waitfram-hide :
      869     if not session:batch-mode
      870     then do
      871     on error undo, return error return-value
      872     :
      873       pause 0 before-hide .
      874       if not mBatchMode then
      875         hide frame waitfram .
      876     if     not mWaitFramView
      877        and mWaitProcEvent
      878     then
      879       process events .
      880     end.
      881   end procedure.
      882   procedure waitfram-show :
      883     define input  parameter p-message as character no-undo .
      884     define variable v-left-margin as integer   no-undo .
      885     if not session:batch-mode
      886     then do
      887     on error undo, return error return-value
      888     :
      889       if length(p-message) <= 70 then do:
      890         assign
      891           v-left-margin = integer((70 - length(p-message)) / 2)
      892         .
      893         assign
      894           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      895         .
      896         assign
      897           v-waitfram-action01 = " "
      898           v-waitfram-action02 = " "
      899                                    + fill(" ", v-left-margin)
      900                                    + p-message
      901           v-waitfram-action03 = " "
      902         .
      903       end.
      904       else do:
      905         define variable vRindex1 as integer no-undo.
      906         define variable vRindex2 as integer no-undo.
      907         vRindex1 = r-index(p-message," ",70).
      908         if vRindex1 = 0
      909         then
      910            vRindex1 = 70.
      911         if length(p-message)  <= vRindex1 + 70 then do:
      912           assign
      913             v-waitfram-action01 = " "
      914             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      915             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      916           .
      917         end.
      918         else do:
      919           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      920           if vRindex2 <= vRindex1
      921           then
      922              vRindex2 = vRindex1 + 70.
      923           assign
      924             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      925             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      926             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      927           .
      928         end.
      929       end.
      930       B-viewProcInfo:visible   in frame waitfram = no.
      931       B-viewProcInfo:sensitive in frame waitfram = no.
      932       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      933       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      934       if  (   mWaitFramView
      935          or  mWaitProcEvent)
      936          and not mBatchMode
      937       then
      938          display
      939             v-waitfram-action01 skip
      940             v-waitfram-action02 skip
      941             v-waitfram-action03 skip
      942          with frame waitfram .
      943       if     mWaitFramView
      944          then do:
      945             if     mWaitFramInterval ne ?
      946                and not mBatchMode
      947             then
      948                wait-for go of frame waitfram pause mWaitFramInterval.
      949          end.
      950          else
      951             if     mWaitProcEvent
      952                and not mBatchMode
      953             then
      954                process events .
      955     end.
      956   end procedure.
      957      procedure waitfram-show-this:
      958         define input  parameter iInterval as int64 no-undo.
      959         define variable vtime as int64 no-undo.
      960         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      961         mWaitFramInterval = iInterval.
      962         run waitfram-show (substitute("&1&2 &3&4" ,
      963                                       mWaitFramTextBeg ,
      964                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      965                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      966                                       mWaitFramTextEnd
      967                                      )
      968                           ).
      969      end.
      970      procedure WaitFramRunPause:
      971         define input  parameter iInterval as dec no-undo.
      972         define variable vStart  as datetime-tz no-undo.
      973         define variable vend    as datetime-tz no-undo.
      974         define variable vint as int64 no-undo.
      975         define variable vOk as logical no-undo.
      976         vStart = now.
      977         vend   = vStart.
      978         publish "WaitFramPause" (iInterval,output vOk).
      979         vend   =  now.
      980         vint = vend - vStart.
      981         vint = iInterval - vint / 1000.
      982         if     not mWaitFramStop
      983            and (   vint > 0
      984                 or (    not vOk
      985                     and iInterval eq ?
      986                     )
      987                 )
      988         then
      989            run waitfram-show-this (iInterval).
      990         vend   =  now.
      991         vint = vend - vStart.
      992         vint = iInterval - vint / 1000.
      993         if     not mWaitFramStop
      994            and vint > 0
      995         then do:
      996            run gbl/pause.p (vint * 1000).
      997         end.
      998         if iInterval ne ?
      999         then
     1000            publish "WaitFramStop".
     1001         waitfram-check-timeout().
     1002      end.
     1003      procedure WaitFramWaitFor:
     1004         define input  parameter iInterval as dec no-undo.
     1005         assign
     1006            mWaitFramStartProc   = now
     1007            mWaitFramStopUser    = no
     1008            mWaitFramStopTimeOut = no
     1009         .
     1010         block-wait:
     1011         do while not mWaitFramStop:
     1012            run WaitFramRunPause (iInterval).
     1013            if  waitfram-check-timeout()
     1014            then do:
     1015               leave block-wait.
     1016            end.
     1017         end.
     1018         run waitfram-hide.
     1019      end.
     1020   procedure waitfram-join :
     1021     define input  parameter p-line-1  as character no-undo .
     1022     define input  parameter p-line-2  as character no-undo .
     1023     define input  parameter p-line-3  as character no-undo .
     1024     define output parameter p-message as character no-undo .
     1025     do
     1026     on error undo, return error return-value
     1027     :
     1028       assign
     1029         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1030                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1031                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1032       .
     1033     end.
     1034   end procedure.
     1035   function waitfram-join-function returns character
     1036     (input p-line-1 as character
     1037     ,input p-line-2 as character
     1038     ,input p-line-3 as character
     1039     ).
     1040     define variable v-message as character no-undo .
     1041     run waitfram-join in this-procedure
     1042       (input  p-line-1
     1043       ,input  p-line-2
     1044       ,input  p-line-3
     1045       ,output v-message
     1046       ) .
     1047     return v-message .
     1048   end function .
     1049   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1050   define  stream PrnLibStream.
     1051   procedure prn-lib-prn-file :
     1052     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1053     define input parameter p-DIsabledoptions as integer no-undo .
     1054     define variable v-report-name as character no-undo .
     1055     define variable v-user-action as character no-undo .
