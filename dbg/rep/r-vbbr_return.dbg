     2388   procedure torgconf-get-sup-param :
     2389   define input parameter p-obj-type           as character        no-undo.
     2390   define input parameter p-obj-code           as integer          no-undo.
     2391   define input parameter p-curr-code          as integer          no-undo.
     2392       define variable v-host-code    as integer      no-undo.
     2393       define variable v-par-type     as character    no-undo.
     2394   do
     2395   on error undo, return error
     2396   :
     2397       assign
     2398          v-torgconf-sup-host-code = v-host-code
     2399       .
     2400       if v-torgconf-sup-host-code = 0
     2401       then do:
     2402           assign
     2403               v-torgconf-sup-host-name           = "":U
     2404               v-torgconf-sup-host-addres         = "":U
     2405               v-torgconf-sup-host-post-addres    = "":U
     2406               v-torgconf-sup-host-phone          = "":U
     2407               v-torgconf-sup-host-inn            = "":U
     2408               v-torgconf-sup-host-kpp            = "":U
     2409               v-torgconf-sup-host-okpo           = "":U
     2410               v-torgconf-sup-host-egrip-date     = "":U
     2411               v-torgconf-sup-host-egrip-num      = "":U
     2412           .
     2413       end.
     2414       else do:
     2415           run fmtcli-get-client in this-procedure (
     2416                 input 'орг':U
     2417               , input v-torgconf-sup-host-code
     2418           ).
     2419           assign
     2420               v-torgconf-sup-host-name        = v-fmtcli-name
     2421               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     2422               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     2423               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     2424               v-torgconf-sup-host-phone       = v-fmtcli-phone
     2425               v-torgconf-sup-host-inn         = v-fmtcli-inn
     2426               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     2427               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     2428           .
     2429           run gbl/clntat-v.p (
     2430                 input 'орг':U
     2431               , input v-torgconf-sup-host-code
     2432               , input 'egrip-date':U
     2433               , output v-torgconf-sup-host-egrip-date
     2434               , output v-par-type
     2435           ).
     2436           run gbl/clntat-v.p (
     2437                 input 'орг':U
     2438               , input v-torgconf-sup-host-code
     2439               , input 'egrip-num':U
     2440               , output v-torgconf-sup-host-egrip-num
     2441               , output v-par-type
     2442           ).
     2443           run fmtcli-get-bank in this-procedure (
     2444                 input v-host-code
     2445               , input 'орг':U
     2446               , input v-torgconf-sup-host-code
     2447               , input p-curr-code
     2448           ).
     2449       end.
     2450       assign
     2451           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     2452           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     2453           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     2454           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     2455           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     2456           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     2457           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     2458           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     2459       .
     2460       assign
     2461           v-torgconf-sup-obj-type = p-obj-type
     2462           v-torgconf-sup-obj-code = p-obj-code
     2463       .
     2464       if trim(p-obj-type) <> ""
     2465       and p-obj-code <> 0
     2466       then do:
     2467       run fmtcli-get-client in this-procedure (
     2468             input p-obj-type
     2469           , input p-obj-code
     2470       ).
     2471       assign
     2472           v-torgconf-sup-obj-name        = v-fmtcli-name
     2473           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     2474           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     2475           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     2476           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     2477           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     2478           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     2479       .
     2480      end.
     2481      end.
     2482   end procedure.
     2483   procedure torgconf-get-cli-param :
     2484   define input parameter p-host-obj-code      as integer          no-undo.
     2485   define input parameter p-obj-type           as character        no-undo.
     2486   define input parameter p-obj-code           as integer          no-undo.
     2487   define input parameter p-curr-code          as integer          no-undo.
     2488       define variable v-host-code    as integer      no-undo.
     2489   do
