     5256       :
     5257       run prn-lib-get-report-name  in this-procedure (
     5258         input parParentProc
     5259         ,output v-report-name
     5260         ).
     5261       if p-is-stream then
     5262       do:
     5263         if p-append then
     5264         do:
     5265           output stream PrnLibStream to value( v-report-name )
     5266             page-size value(p-page-size) append .
     5267         end.
     5268         if not p-append then
     5269         do:
     5270           output stream PrnLibStream to value( v-report-name )
     5271             page-size value(p-page-size) .
     5272         end.
     5273       end.
     5274       if not p-is-stream then
     5275       do:
     5276         if p-append then
     5277         do:
     5278           output to value( v-report-name )
     5279             page-size value(p-page-size) append .
     5280         end.
     5281         if not p-append then
     5282         do:
     5283           output to value( v-report-name )
     5284             page-size value(p-page-size) .
     5285         end.
     5286       end.
     5287     end.
     5288   end procedure.
     5289   procedure prn-lib-open-exp :
     5290     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     5291     define input parameter p-is-stream    as logical no-undo .
     5292     define input parameter p-is-append    as logical no-undo .
     5293     define output parameter p-ReportFileName as char init "report" no-undo.
     5294     define output parameter p-process as logical no-undo .
     5295     define variable glog as logical no-undo .
     5296     do
     5297       on error undo, return error
     5298       :
     5299       SYSTEM-DIALOG GET-FILE p-ReportFileName
     5300         TITLE      "Укажите путь"
     5301         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     5302         ASK-OVERWRITE
     5303         CREATE-TEST-FILE
     5304         SAVE-AS
     5305         USE-FILENAME
     5306         DEFAULT-EXTENSION "txt"
     5307         UPDATE glog
     5308         .
     5309       if not glog then  return.
     5310       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     5311       if p-is-stream then
     5312       do:
     5313         if p-is-append then
     5314         do:
     5315           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     5316         end.
     5317         else
     5318         do:
     5319           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     5320         end.
     5321       end.
     5322       else
     5323       do:
     5324         if p-is-append then
     5325         do:
     5326           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     5327         end.
     5328         else
     5329         do:
     5330           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     5331         end.
     5332       end.
     5333       p-process = yes.
     5334     end.
     5335   end procedure.
     5336   procedure prn-lib-get-report-name :
     5337     define input parameter parParentProc  as widget-handle no-undo.
     5338     define output parameter p-report-name as character no-undo .
     5339     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     5340   end procedure.
     5341   procedure prn-lib-reportviewer-report-name :
     5342     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     5343     define input parameter p-report-name-html as character no-undo .
     5344     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     5345   end procedure.
     5346   procedure prn-lib-reportviewer :
     5347     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     5348     define input parameter p-report-name-html as character no-undo .
     5349     define input parameter p-param        as character no-undo .
     5350     define variable v-excel           as character no-undo init 'TRUE' .
     5351     define variable v-value-character as character no-undo .
     5352     define variable v-value-integer   as character no-undo .
     5353     define variable v-value-date      as date      no-undo .
     5354     define variable v-value-decimal   as decimal   no-undo .
     5355     define variable rep-excel         as logical   no-undo .
     5356     define variable excel-string      as character no-undo .
     5357     define variable v-param-type      as character no-undo .
     5358     define variable v-tth             as handle    no-undo .
     5359     run adm/shattri.p (
     5360       input "get":U
     5361       ,input  ""
     5362       ,input  0
     5363       ,input  'report-glob':U
     5364       ,input  'rep-excel':U
     5365       ,output v-value-character
     5366       ,output v-value-date
     5367       ,output v-value-decimal
     5368       ,output v-value-integer
     5369       ,output rep-excel
     5370       ,output v-param-type
     5371       ,INPUT-OUTPUT table-handle v-tth
     5372       )  .
     5373     if rep-excel then v-excel = "TRUE" .
     5374     else v-excel = "FALSE" .
     5375     if p-param eq ""
     5376     then
     5377        p-param = "EXCEL:" + v-excel.
     5378     else
     5379        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     5380     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     5381   end procedure.
     5382   function fnc-convert-dot-to-colon returns character
     5383       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
     5384   function fnc-convert-dot-to-colon returns character
     5385   (input p-data as decimal, input p-accur as character, input p-num as integer):
     5386       define variable result as character no-undo.
     5387       define variable v-str-result as character no-undo.
     5388       if p-data = ? then p-data = 0 .
     5389       p-data = round(p-data, p-num).
     5390       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     5391       return v-str-result.
     5392   END FUNCTION.
     5393   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5394     define variable v-cntxt-db-num        as integer   no-undo .
     5395     define variable v-cntxt-userid        as character no-undo .
     5396     define variable v-cntxt-level         as character no-undo .
     5397     define variable v-cntxt-host-code-obj as integer   no-undo .
     5398     define variable v-cntxt-obj-type      as character no-undo .
     5399     define variable v-cntxt-obj-code      as integer   no-undo .
     5400     define variable v-cntxt-db-num-obj    as integer   no-undo .
     5401     define variable v-cntxt-is-admin      as logical   no-undo .
     5402   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5403     run mainmenu_getcntxt in parparentproc
     5404       (output v-cntxt-db-num
     5405       ,output v-cntxt-userid
     5406       ,output v-cntxt-level
     5407       ,output v-cntxt-host-code-obj
     5408       ,output v-cntxt-obj-type
     5409       ,output v-cntxt-obj-code
     5410       ,output v-cntxt-db-num-obj
     5411       ,output v-cntxt-is-admin
     5412       ) .
     5413   define stream Out-Stream.
     5414   define stream OutStr-html.
     5415   DEFINE TEMP-TABLE tt-cash-pay like ub.cash-pay-attr .
     5416   define VARIABLE p-report-id         as character no-undo .
     5417   define variable v-file-name-rep-htm as character no-undo .
     5418   define VARIABLE v-attr-value        as character no-undo .
     5419   define variable v-obj-type          as character no-undo .
     5420   define variable v-obj-code          as integer   no-undo .
     5421   define variable v-obj-name          as character no-undo .
     5422   define variable v-period            as character no-undo .
     5423   define variable v-list-obj          as character no-undo .
     5424   define variable v-print-date        as character no-undo .
     5425   define variable v-doc-num2          as character no-undo .
     5426   define buffer buf_chk-doc   for ub.chk-doc .
     5427   define buffer bf_chk-doc   for ub.chk-doc .
     5428   define buffer buf_clients   for ub.clients .
     5429   define buffer buf_chk-disnt for ub.chk-discnt .
     5430   define buffer buf_chk-gds   for ub.chk-gds .
     5431   define buffer buf_bar-code  for ub.bar-code .
     5432   define buffer buf_goods     for ub.goods .
     5433   define buffer buf_podarki   for tt-podarki .
     5434   define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     5435   define buffer buf_chk-pay       for ub.chk-pay .
     5436   do
     5437     on error undo, return error return-value
     5438     :
     5439     find first obj-list no-error .
     5440     if not available obj-list then
     5441     do:
     5442       message
     5443         "Не указан объект для формирования отчета!"
     5444         view-as alert-box error.
     5445       undo, return error.
     5446     end.
     5447     DEFINE VARIABLE v-dop   AS character NO-UNDO .
     5448     DEFINE VARIABLE v-value AS character NO-UNDO.
     5449     DEFINE VARIABLE v-type  AS character NO-UNDO.
     5450     for each buf_cash-pay-attr no-lock where buf_cash-pay-attr.attr-code = "cash-prop"
     5451       and buf_cash-pay-attr.attr-value = "2":
     5452       create tt-cash-pay .
     5453       buffer-copy buf_cash-pay-attr to tt-cash-pay .
     5454     end.
     5455     if x-TOG-Shift then
     5456     do:
     5457       v-period = "Смены с " + string (x-Shift-Start) + " по " + string (x-Shift-End) + " За период с " + string (x-Date-Start,"99.99.9999") + " по " + string (x-Date-End,"99.99.9999") .
     5458     end.
     5459     else
     5460     do:
     5461       v-period = "За период с " + string (x-Date-Start,"99.99.9999") + " по " + string (x-Date-End,"99.99.9999") .
     5462     end.
     5463     run clients-write(INPUT v-cntxt-host-code-obj, INPUT 'орг':U, OUTPUT v-obj-name) no-error .
     5464     DEFINE VARIABLE v-today as date    no-undo .
     5465     DEFINE VARIABLE v-time  as integer no-undo .
     5466     run cur-time in this-procedure (
     5467       output v-today
     5468       , output v-time
     5469       ).
     5470     v-print-date = "Дата печати: " + string (v-today,"99.99.9999") + ", время: " + string(truncate (v-time / 3600, 0)) + ":" + string((v-time modulo 3600) / 60,"99")  + ":" + string((v-time modulo 3600) / 360,"99").
     5471     for each obj-list no-lock:
     5472       if v-list-obj = "" then v-list-obj = string(obj-list.obj-code).
     5473       else v-list-obj = v-list-obj + ", " + string(obj-list.obj-code).
     5474       if x-TOG-Shift then
     5475       do:
     5476         for each buf_chk-doc no-lock
     5477           where buf_chk-doc.obj-code = obj-list.obj-code
     5478           and buf_chk-doc.obj-type = obj-list.obj-type
     5479           and buf_chk-doc.shift-date >= x-Date-Start
     5480           and buf_chk-doc.shift-date <= x-Date-End
     5481           and buf_chk-doc.out-code <> ?
     5482           and  (buf_chk-doc.chk-type = integer('6':U)
     5483           or buf_chk-doc.chk-type = integer('96':U)):
     5484           if (buf_chk-doc.shift-date = X-date-Start)
     5485             and (buf_chk-doc.shift-num < x-Shift-Start) then next.
     5486           if (buf_chk-doc.shift-date = X-date-End)
     5487             and (buf_chk-doc.shift-num > x-Shift-End) then next.
     5488           run report .
     5489         end.
     5490       end.
     5491       else
     5492       do:
     5493         for each buf_chk-doc no-lock
     5494           where buf_chk-doc.obj-code = obj-list.obj-code
     5495           and buf_chk-doc.obj-type = obj-list.obj-type
     5496           and buf_chk-doc.chk-date >= x-Date-Start
     5497           and buf_chk-doc.chk-date <= x-Date-End
     5498           and buf_chk-doc.out-code <> ?
     5499           and  (buf_chk-doc.chk-type = integer('6':U)
     5500           or buf_chk-doc.chk-type = integer('96':U))  :
     5501           run report .
     5502         end.
     5503       end.
     5504     end.
     5505   procedure report:
     5506   for each tt-promo, each buf_chk-pay no-lock where buf_chk-pay.doc-code = buf_chk-doc.doc-code,
     5507   first tt-cash-pay no-lock where tt-cash-pay.curr-code = buf_chk-pay.curr-code and tt-cash-pay.cdpay-code = buf_chk-pay.pay-code:
     5508         if num-entries (buf_chk-doc.doc-num2,":") > 1 then
     5509         do:
     5510           v-doc-num2 = entry(1, buf_chk-doc.doc-num2,":") .
     5511         end.
     5512         else v-doc-num2 = buf_chk-doc.doc-num2 .
     5513       for last bf_chk-doc no-lock where bf_chk-doc.chk-num = integer(v-doc-num2) and bf_chk-doc.obj-code = buf_chk-doc.obj-code
     5514       and bf_chk-doc.obj-type = buf_chk-doc.obj-type and bf_chk-doc.z-number = buf_chk-doc.z-number
     5515       and bf_chk-doc.pay-desk = buf_chk-doc.pay-desk and bf_chk-doc.chk-type = integer('1':U) by bf_chk-doc.chk-date:
     5516     for first buf_chk-disnt no-lock where buf_chk-disnt.doc-code = bf_chk-doc.doc-code
     5517       and buf_chk-disnt.promo-id = string(tt-promo.id) and buf_chk-disnt.record-type = 0:
     5518           create tt-podarki .
     5519           assign
     5520             tt-podarki.obj-code = buf_chk-doc.obj-code
     5521             tt-podarki.date_sale    = string(bf_chk-doc.chk-date,"99.99.9999") + " " + string(truncate (bf_chk-doc.chk-time / 3600, 0)) + ":" + string((bf_chk-doc.chk-time modulo 3600) / 60,"99")
     5522             tt-podarki.chk-num = bf_chk-doc.chk-num
     5523             tt-podarki.doc-code = buf_chk-doc.doc-code
     5524             tt-podarki.sum_sale = bf_chk-doc.netto
     5525             tt-podarki.date_return = string(buf_chk-doc.chk-date,"99.99.9999") + " " + string(truncate (buf_chk-doc.chk-time / 3600, 0)) + ":" + string((buf_chk-doc.chk-time modulo 3600) / 60,"99")
     5526             tt-podarki.chk-num2 = buf_chk-doc.chk-num
     5527             tt-podarki.sum_return = buf_chk-doc.netto
     5528             tt-podarki.tot-sum  = bf_chk-doc.netto + buf_chk-doc.netto
     5529             .
     5530         end.
     5531       end.
     5532       end.
     5533   end procedure.
     5534     run get-report-num (output p-report-id).
     5535     v-file-name-rep-htm = session:temp-directory + string(p-report-id) + ".html".
     5536     output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8'.
     5537     put stream OutStr-html unformatted
     5538       "<!DOCTYPE HTML>" skip
     5539       ' <html>' skip
     5540       '  <head>' skip
     5541       '   <meta charset="utf-8">' skip
     5542       '    <style type="text/css">' skip
     5543       '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     5544       '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     5545       '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black; height: 14px;' + chr(125) skip
     5546       '   </style>' skip
     5547       '  </head>' skip
     5548       .
     5549     put stream OutStr-html unformatted
     5550       '<body>' skip
     5551       '<TABLE name="1"  fit_to_page="true" orientation="landscape" CELLSPACING="0" BORDER="0">'skip
     5552       '<thead>' skip
     5553       .
     5554     put stream OutStr-html unformatted
     5555       '<tr>' skip
     5556       '<td style="width: 160px;"></td>' skip
     5557       '<td style="width: 160px;"></td>' skip
     5558       '<td style="width: 160px;"></td>' skip
     5559       '<td style="width: 160px;"></td>' skip
     5560       '<td style="width: 160px;"></td>' skip
     5561       '<td style="width: 160px;"></td>' skip
     5562       '<td style="width: 160px;"></td>' skip
     5563       '<td style="width: 160px;"></td>' skip
     5564       '</tr>' skip
     5565       .
     5566     put stream OutStr-html unformatted
     5567       '<TR><TD colspan="8"></TD></TR>' skip
     5568       '<TR>' skip
     5569       '<TD colspan="8" style="font-weight: bold;">Отчет для контроля возвратных операций</TD>' skip
     5570       '</TR>'skip
     5571       '<TR>' skip
     5572       '<TD colspan="8">' + v-period + '</TD>' skip
     5573       '</TR>'skip
     5574       '<TR>' skip
     5575       '<TD colspan="8">' + v-obj-name + '</TD>' skip
     5576       '</TR>'skip
     5577       '<TR>' skip
     5578       '<TD colspan="8">Выбор объекта:</TD>' skip
     5579       '</TR>'skip
     5580       '<TR>' skip
     5581       '<TD colspan="8">' + "АЗК №" + v-list-obj + " маг" + '</TD>' skip
     5582       '</TR>'skip
     5583       '<TR>' skip
     5584       '<TD colspan="8">' + v-print-date + '</TD>' skip
     5585       '</TR>'skip
     5586       '</thead>' skip
     5587       '<tbody>' skip
     5588       .
     5589     put stream OutStr-html unformatted
     5590       '<TR>' skip
     5591       '<TD text_wrap="true" style="text-align: center;">Номер АЗК</TD>' skip
     5592       '<TD text_wrap="true" style="text-align: center;">Дата и время покупки</TD>' skip
     5593       '<TD text_wrap="true" style="text-align: center;">Номер чека продажи</TD>' skip
     5594       '<TD text_wrap="true" style="text-align: center;">Сумма чека продажи</TD>' skip
     5595       '<TD text_wrap="true" style="text-align: center;">Дата и время чека возврата</TD>' skip
     5596       '<TD text_wrap="true" style="text-align: center;">Номер чека возврата</TD>' skip
     5597       '<TD text_wrap="true" style="text-align: center;">Сумма чека возврата</TD>' skip
     5598       '<TD text_wrap="true" style="text-align: center;">Итоговая сумма с учетом возврата</TD>' skip
     5599       '</TR>'skip
     5600       .
     5601     for each buf_podarki:
     5602       put stream OutStr-html unformatted
     5603         '<TR>' skip
     5604         '<TD text_wrap="true">' + string(buf_podarki.obj-code) + '</TD>' skip
     5605         '<TD text_wrap="true" style="text-align: left;">' + string(buf_podarki.date_sale) + '</TD>' skip
     5606         '<TD text_wrap="true" style="text-align: center;">' + string(buf_podarki.chk-num) + '</TD>' skip
     5607         '<TD text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(buf_podarki.sum_sale,"->>>>>>>>>>>9.99",2) + '" style="text-align: right;">' + fnc-convert-dot-to-colon(buf_podarki.sum_sale,"->>>>>>>>>>>9.99",2) + '</TD>' skip
     5608         '<TD text_wrap="true" style="text-align: left;">' + string(buf_podarki.date_return) + '</TD>' skip
     5609         '<TD text_wrap="true" style="text-align: center;">' + string(buf_podarki.chk-num2) + '</TD>' skip
     5610         '<TD text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(buf_podarki.sum_return,"->>>>>>>>>>>9.99",2) + '" style="text-align: right;">' + fnc-convert-dot-to-colon(buf_podarki.sum_return,"->>>>>>>>>>>9.99",2) + '</TD>' skip
     5611         '<TD text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(buf_podarki.tot-sum,"->>>>>>>>>>>9.99",2) + '" style="text-align: right;">' + fnc-convert-dot-to-colon(buf_podarki.tot-sum,"->>>>>>>>>>>9.99",2) + '</TD>' skip
     5612         '</TR>'skip
     5613         .
     5614     end.
     5615     put stream OutStr-html unformatted
     5616       '</table>' skip
     5617       '</body>' skip
     5618       '</html>' skip
     5619       .
     5620     output stream OutStr-html close.
     5621     run prn-lib-reportviewer-report-name in this-procedure (
     5622       input THIS-PROCEDURE
     5623       ,input v-file-name-rep-htm
     5624       ).
     5625   PROCEDURE get-report-num :
     5626     define output parameter p-report-num as integer no-undo .
     5627     do
     5628       on error undo, return error return-value
     5629       :
     5630       run gbl/getrpnum.p (output p-report-num).
     5631     end.
     5632   END PROCEDURE.
     5633   procedure clients-write:
     5634     DEFINE input PARAMETER   p-obj-code      as integer      no-undo .
     5635     DEFINE INPUT PARAMETER   p-obj-type      as character    no-undo .
     5636     DEFINE OUTPUT PARAMETER  p-obj-name      as character    no-undo .
     5637     find first buf_clients no-lock where buf_clients.obj-code = p-obj-code
     5638       and buf_clients.obj-type = p-obj-type no-error .
     5639     if AVAILABLE buf_clients then
     5640     do:
     5641       p-obj-name = buf_clients.obj-name .
     5642     end.
     5643   end.
     5644   end.
