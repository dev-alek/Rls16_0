      579   define variable var-report-r-b as character no-undo .
      580   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      581   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      582     (output var-report-r-b
      583     )  .
      584   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      585   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      586   define  shared variable RepPathName        as character no-undo .
      587   define  shared variable PrintRubl          as logical   no-undo .
      588   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      589   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      590   procedure cur-time :
      591      define output parameter p-today as date      no-undo .
      592      define output parameter p-time  as integer   no-undo .
      593     do
      594     on error undo, return error
      595     :
      596       define variable v-date1 as date      no-undo .
      597       define variable v-date2 as date      no-undo .
      598       define variable v-time  as integer   no-undo .
      599       assign
      600         v-date1 = today
      601         v-time  = time
      602         v-date2 = today
      603       .
      604       if v-date1 <> v-date2
      605       then do:
      606         assign
      607           v-date1 = today
      608           v-time  = v-time
      609         .
      610       end.
      611       assign
      612         p-today = v-date1
      613         p-time  = v-time
      614       .
      615     end.
      616   end.
      617   function cur-time-date returns character
      618   :
      619     return string(today, '99/99/9999':U) .
      620   end.
      621   function cur-time-mjd returns decimal
      622   :
      623     define variable v-date as date      no-undo .
      624     define variable v-time as integer   no-undo .
      625     run cur-time in this-procedure
      626       (output v-date
      627       ,output v-time
      628       ) .
      629     return integer(v-date) - 2400002 + (v-time / 86400) .
      630   end.
      631   function cur-time-get-ending-index returns integer
      632   (input p-number as integer
      633   )
      634   :
      635     if p-number < 0
      636     or p-number = ?
      637     then do:
      638       return 1 .
      639     end.
      640     define variable v-rest as integer   no-undo .
      641     assign
      642       p-number = p-number modulo 100
      643     .
      644     if p-number < 20
      645     then do:
      646       assign
      647         v-rest = p-number
      648       .
      649     end.
      650     else do:
      651       assign
      652         v-rest = p-number modulo 10
      653       .
      654     end.
      655     case v-rest :
      656       when 1
      657       then do:
      658         return 2 .
      659       end.
      660       when 2 or
      661       when 3 or
      662       when 4
      663       then do:
      664         return 3 .
      665       end.
      666       otherwise do:
      667         return 1 .
      668       end.
      669     end case .
      670   end.
      671   procedure cur-time-mjd-to-date :
      672      define input  parameter i-mjd-diff as decimal no-undo.
      673      define output parameter o-Date     as date    no-undo.
      674      define output parameter o-Time     as integer no-undo.
      675      define variable v-day-number as integer   no-undo .
      676      if    i-mjd-diff < 0
      677         or i-mjd-diff = ?
      678      then do:
      679         return "?" .
      680      end.
      681      assign
      682         v-day-number = truncate(i-mjd-diff,0).
      683         o-Date = date(v-day-number + 2400002).
      684         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      685     .
      686   end.
      687   function cur-time-mjd-to-string returns character
      688   (input p-mjd-diff as decimal
      689   )
      690   :
      691     define variable v-day-number as integer   no-undo .
      692     define variable v-seconds    as integer   no-undo .
      693     define variable v-hour       as integer   no-undo .
      694     define variable v-min        as integer   no-undo .
      695     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      696     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      697     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      698     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      699     if p-mjd-diff < 0
      700     or p-mjd-diff = ?
      701     then do:
      702       return "?" .
      703     end.
      704     assign
      705       v-day-number = integer(truncate(p-mjd-diff,0))
      706       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      707     .
      708     if v-seconds > 86400
      709     then do:
      710       assign
      711         v-seconds = 86400 - 1
      712       .
      713     end.
      714     if v-seconds < 0
      715     then do:
      716       assign
      717         v-seconds = 0
      718       .
      719     end.
      720     assign
      721       v-hour = truncate(v-seconds / 3600, 0)
      722     .
      723     assign
      724       v-seconds = v-seconds modulo 3600
      725     .
      726     assign
      727       v-min = truncate(v-seconds / 60, 0)
      728     .
      729     assign
      730       v-seconds = v-seconds modulo 60
      731     .
      732     return
      733         (if v-day-number <> 0
      734           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      735           else ""
      736         )
      737       + (if v-day-number <> 0 or v-hour <> 0
      738           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      739           else ""
      740         )
      741       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      742           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      743           else ""
      744         )
      745       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      746       .
      747   end.
      748   function cur-time-string returns character
      749   :
      750     define variable v-date as date      no-undo .
      751     define variable v-time as integer   no-undo .
      752     run cur-time in this-procedure
      753       (output v-date
      754       ,output v-time
      755       ) .
      756     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      757   end.
      758   function cur-time-string-sec returns character
      759   :
      760     define variable v-date as date      no-undo .
      761     define variable v-time as integer   no-undo .
      762     run cur-time in this-procedure
      763       (output v-date
      764       ,output v-time
      765       ) .
      766     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      767   end.
      768   function cur-time-custom  returns character
      769   (input p-prefix as character
      770   ,input p-date-format as character
      771   ,input p-delimiter as character
      772   ,input p-time-format as character
      773   ,input p-suffix as character
      774   )
      775   :
      776     define variable v-date as date      no-undo .
      777     define variable v-time as integer   no-undo .
      778     run cur-time in this-procedure
      779       (output v-date
      780       ,output v-time
      781       ) .
      782     return
      783       p-prefix
      784       + string(v-date, p-date-format)
      785       + p-delimiter
      786       + string(v-time, p-time-format)
      787       + p-suffix
      788       .
      789   end.
      790   function cur-time-print  returns character
      791   :
      792     define variable v-date as date      no-undo .
      793     define variable v-time as integer   no-undo .
      794     run cur-time in this-procedure
      795       (output v-date
      796       ,output v-time
      797       ) .
      798     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      799   end.
      800   function cur-time-datetime returns datetime
      801   :
      802     define variable v-char as character no-undo .
      803     define variable v-datetime as datetime no-undo .
      804     v-char = cur-time-string().
      805     v-datetime = datetime(v-char).
      806     return  v-datetime.
      807   end.
      808   function cur-time-string-msec returns character
      809   :
      810     define variable v-date as datetime  no-undo .
      811     v-date = now.
      812     return string(v-date) .
      813   end.
      814   procedure cp-attr-code :
      815     do
      816     on error undo, return error
      817     :
      818       define input  parameter p-code           as character no-undo .
      819       define output parameter p-type           as character no-undo .
      820       define output parameter p-format         as character no-undo .
      821       define output parameter p-label          as character no-undo .
      822       define output parameter p-range          as integer   no-undo .
      823       define output parameter p-user-can-edit  as logical   no-undo .
      824       define output parameter p-output-display as logical   no-undo .
      825       define output parameter p-other          as character no-undo .
      826       case p-code :
      827               when 'paycard-export-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      828               when 'grp-code':U then do:     assign     p-label = "Группа платежа"     p-type = 'C':U      p-format = "X(45)"     p-label = "Группа платежа"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=grp-code':u      .   end.
      829               when 'is-use':U then do:     assign     p-label = "Используется"     p-type = 'C':U      p-format = "X(255)"     p-label = "Используется"     p-range = 4     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=is-use':u      .   end.
      830               when 'dop-doc':U then do:     assign     p-label = "Дополнительный документ"     p-type = 'C':U      p-format = "X(255)"     p-label = "Дополнительный документ"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=dop-doc':u      .   end.
      831               when 'paycard-all-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      832               when 'paycard-edit-prefix':U then do:     assign     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      833               when 'form_km3':U then do:     assign     p-label = "Формировать КМ-3 по чекам возврата"     p-type = 'L':U      p-format = "+/-"     p-label = "Формировать КМ-3 по чекам возврата"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      834               when 'bal_malina':U then do:     assign     p-label = "Оплата баллами Малина"     p-type = 'L':U      p-format = "+/-"     p-label = "Оплата баллами Малина"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      835               when 'max_proc_sum':U then do:     assign     p-label = "Максимальный % порог от суммы"     p-type = 'D':U      p-format = ">>9.99"     p-label = "Максимальный % порог от суммы"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      836               when 'mask_card_kup':U then do:     assign     p-label = "Маска карты\купона"     p-type = 'C':U      p-format = "x(129)"     p-label = "Маска карты\купона"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      837         otherwise do:
      838           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code ).
      839         end.
      840       end.
      841     end.
      842   end procedure.
      843   procedure cp-attr-tooltip :
      844     do
      845     on error undo, return error
      846     :
      847       define input  parameter p-code    as character no-undo .
      848       define output parameter p-tooltip as character no-undo .
      849       define output parameter p-label   as character no-undo .
      850       case p-code :
      851               when 'paycard-export-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт (для выгрузки в XML)"     p-label = "Префиксы платежных карт (для выгрузки в XML)" .   end.
      852               when 'grp-code':U then do:     assign     p-tooltip = "Группа платежа"     p-label = "Группа платежа" .   end.
      853               when 'is-use':U then do:     assign     p-tooltip = "Используется"     p-label = "Используется" .   end.
      854               when 'dop-doc':U then do:     assign     p-tooltip = "Дополнительный документ"     p-label = "Дополнительный документ" .   end.
      855               when 'paycard-all-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)" .   end.
      856               when 'paycard-edit-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт, разрешенных для редактировани"     p-label = "Префиксы платежных карт, разрешенных для редактирования" .   end.
      857               when 'form_km3':U then do:     assign     p-tooltip = "Формировать КМ-3 по чекам возврата"     p-label = "Формировать КМ-3 по чекам возврата" .   end.
      858               when 'bal_malina':U then do:     assign     p-tooltip = "Оплата баллами Малина"     p-label = "Оплата баллами Малина" .   end.
      859               when 'max_proc_sum':U then do:     assign     p-tooltip = "Максимальный % порог от суммы"     p-label = "Максимальный % порог от суммы" .   end.
      860               when 'mask_card_kup':U then do:     assign     p-tooltip = "Маска карты\купона"     p-label = "Маска карты\купона" .   end.
      861         otherwise do:
      862           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code) .
      863         end.
      864       end.
      865     end.
      866   end procedure.
      867   procedure cp-attr-value :
      868     do
      869     on error undo, return error
      870     :
      871       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      872       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      873       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      874       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      875       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      876       define input  parameter p-code        like ub.cash-pay-attr.attr-code      no-undo .
      877       define output parameter p-value       like ub.cash-pay-attr.attr-value    no-undo .
      878       define output parameter p-type        as character no-undo .
      879       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      880       define variable v-format         as character no-undo .
      881       define variable v-label          as character no-undo .
      882       define variable v-range          as integer   no-undo .
      883       define variable v-user-can-edit  as logical   no-undo .
      884       define variable v-output-display as logical   no-undo .
      885       define variable v-other          as character no-undo .
      886       run cp-attr-code in this-procedure
      887         (input  p-code
      888         ,output p-type
      889         ,output v-format
      890         ,output v-label
      891         ,output v-range
      892         ,output v-user-can-edit
      893         ,output v-output-display
      894         ,output v-other
      895         ) no-error .
      896       if error-status :error then do:
      897         undo, return error return-value .
      898       end.
      899       find first buf_cash-pay-attr no-lock
      900         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      901           and buf_cash-pay-attr.curr-code  = p-curr-code
      902           and buf_cash-pay-attr.host-code  = p-host-code
      903           and buf_cash-pay-attr.obj-type   = p-obj-type
      904           and buf_cash-pay-attr.obj-code   = p-obj-code
      905           and buf_cash-pay-attr.attr-code  = p-code
      906         no-error .
      907       if avail buf_cash-pay-attr then do:
      908         assign
      909           p-value =  buf_cash-pay-attr.attr-value
      910         .
      911       end.
      912       else do:
      913         assign
      914           p-value = if p-type = 'L':U then "no":U else ""
      915         .
      916       end.
      917     end.
      918   end procedure.
      919   procedure cp-attr-write :
      920     do
      921     on error undo, return error
      922     :
      923       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      924       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      925       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      926       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      927       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      928       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
      929       define input parameter p-value    like ub.cash-pay-attr.attr-value no-undo .
      930       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      931       define buffer last_cash-pay-attr for ub.cash-pay-attr .
      932       define variable v-type           as character no-undo .
      933       define variable v-format         as character no-undo .
      934       define variable v-label          as character no-undo .
      935       define variable v-range          as integer   no-undo .
      936       define variable v-user-can-edit  as logical   no-undo .
      937       define variable v-output-display as logical   no-undo .
      938       define variable v-other          as character no-undo .
      939       run cp-attr-code in this-procedure
      940         (input  p-code
      941         ,output v-type
      942         ,output v-format
      943         ,output v-label
      944         ,output v-range
      945         ,output v-user-can-edit
      946         ,output v-output-display
      947         ,output v-other
      948         ) no-error .
      949       if error-status :error then do:
      950         undo, return error return-value .
      951       end.
      952       find first buf_cash-pay-attr exclusive-lock
      953         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      954           and buf_cash-pay-attr.curr-code  = p-curr-code
      955           and buf_cash-pay-attr.host-code  = p-host-code
      956           and buf_cash-pay-attr.obj-type   = p-obj-type
      957           and buf_cash-pay-attr.obj-code   = p-obj-code
      958           and buf_cash-pay-attr.attr-code = p-code
      959         no-error .
      960       if not available buf_cash-pay-attr then do:
      961         create buf_cash-pay-attr .
      962         assign
      963         buf_cash-pay-attr.cdpay-code = p-cdpay-code
      964         buf_cash-pay-attr.curr-code  = p-curr-code
      965         buf_cash-pay-attr.host-code  = p-host-code
      966         buf_cash-pay-attr.obj-type   = p-obj-type
      967         buf_cash-pay-attr.obj-code   = p-obj-code
      968         buf_cash-pay-attr.attr-code = p-code
      969         .
      970       end.
      971       assign
      972         buf_cash-pay-attr.attr-value = p-value
      973       .
      974       release buf_cash-pay-attr no-error .
      975       if error-status:error then do:
      976         undo, return error return-value .
      977       end.
      978     end.
      979   end procedure.
      980   procedure cp-attr-exist :
      981     do
      982     on error undo, return error
      983     :
      984       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      985       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      986       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      987       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      988       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      989       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
      990       define output parameter p-exist   as logical  no-undo .
      991       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      992       define variable v-type           as character no-undo .
      993       define variable v-format         as character no-undo .
      994       define variable v-label          as character no-undo .
      995       define variable v-range          as integer   no-undo .
      996       define variable v-user-can-edit  as logical   no-undo .
      997       define variable v-output-display as logical   no-undo .
      998       define variable v-other          as character no-undo .
      999       run cp-attr-code in this-procedure
     1000         (input  p-code
     1001         ,output v-type
     1002         ,output v-format
     1003         ,output v-label
     1004         ,output v-range
     1005         ,output v-user-can-edit
     1006         ,output v-output-display
     1007         ,output v-other
     1008         ) no-error .
     1009       if error-status :error then do:
     1010         undo, return error return-value .
     1011       end.
     1012       find first buf_cash-pay-attr exclusive-lock
     1013         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     1014           and buf_cash-pay-attr.curr-code  = p-curr-code
     1015           and buf_cash-pay-attr.host-code  = p-host-code
     1016           and buf_cash-pay-attr.obj-type   = p-obj-type
     1017           and buf_cash-pay-attr.obj-code   = p-obj-code
     1018           and buf_cash-pay-attr.attr-code = p-code
     1019         no-error .
     1020       if  available buf_cash-pay-attr then do:
     1021         p-exist = yes.
     1022       end.
     1023     end.
     1024   end procedure.
     1025   procedure cp-attr-delete :
     1026     do
     1027     on error undo, return error
     1028     :
     1029       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     1030       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     1031       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     1032       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     1033       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     1034       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
     1035       define output parameter p-deleted  as logical no-undo.
     1036       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     1037       define variable v-type           as character no-undo .
     1038       define variable v-format         as character no-undo .
     1039       define variable v-label          as character no-undo .
     1040       define variable v-range          as integer   no-undo .
     1041       define variable v-user-can-edit  as logical   no-undo .
     1042       define variable v-output-display as logical   no-undo .
     1043       define variable v-other          as character no-undo .
     1044       run cp-attr-code in this-procedure
     1045         (input  p-code
     1046         ,output v-type
     1047         ,output v-format
     1048         ,output v-label
     1049         ,output v-range
     1050         ,output v-user-can-edit
     1051         ,output v-output-display
     1052         ,output v-other
     1053         ) no-error .
     1054       if error-status :error then do:
     1055         undo, return error return-value .
     1056       end.
     1057       find first buf_cash-pay-attr exclusive-lock
     1058         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     1059           and buf_cash-pay-attr.curr-code  = p-curr-code
     1060           and buf_cash-pay-attr.host-code  = p-host-code
     1061           and buf_cash-pay-attr.obj-type   = p-obj-type
     1062           and buf_cash-pay-attr.obj-code   = p-obj-code
     1063           and buf_cash-pay-attr.attr-code = p-code
     1064         no-error NO-WAIT.
     1065       if not available buf_cash-pay-attr then do:
     1066         p-deleted = no.
     1067       end.
     1068       else do:
     1069         delete buf_cash-pay-attr no-error .
     1070         if error-status:error then do:
     1071           undo, return error return-value .
     1072         end.
     1073         p-deleted = yes.
     1074       end.
     1075     end.
     1076   end procedure.
     1077   procedure cp-attr-news :
     1078     do
     1079     on error undo, return error
     1080     :
     1081       define input  parameter p-code           as character no-undo .
     1082       define output parameter p-news           as logical   no-undo .
     1083       case p-code :
     1084               when 'paycard-export-prefix':U then do:     assign     p-news = true.   end.
     1085               when 'grp-code':U then do:     assign     p-news = true.   end.
     1086               when 'is-use':U then do:     assign     p-news = true.   end.
     1087               when 'dop-doc':U then do:     assign     p-news = true.   end.
     1088               when 'paycard-all-prefix':U then do:     assign     p-news = true.   end.
     1089               when 'paycard-edit-prefix':U then do:     assign     p-news = true.   end.
     1090               when 'form_km3':U then do:     assign     p-news = false.   end.
     1091               when 'bal_malina':U then do:     assign     p-news = false.   end.
     1092               when 'max_proc_sum':U then do:     assign     p-news = true.   end.
     1093               when 'mask_card_kup':U then do:     assign     p-news = true.   end.
     1094         otherwise do:
     1095           p-news = no.
     1096         end.
     1097       end.
     1098     end.
     1099   end procedure.
