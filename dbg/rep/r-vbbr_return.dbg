     2588   procedure torgconf-get-holdfirm-code :
     2589   define input parameter p-obj-type   as character        no-undo.
     2590   define input parameter p-obj-code   as integer          no-undo.
     2591   define output parameter p-firm-code as integer          no-undo.
     2592       define variable v-firm-code-str     as character    no-undo.
     2593       define variable v-par-type          as character    no-undo.
     2594       define buffer buf_clients       for ub.clients.
     2595   do
     2596   for buf_clients
     2597   on error undo, return error
     2598   :
     2599       run gbl/clntat-v.p (
     2600             input p-obj-type
     2601           , input p-obj-code
     2602           , input 'holdfirm-code':U
     2603           , output v-firm-code-str
     2604           , output v-par-type
     2605       ).
     2606       assign
     2607           p-firm-code = integer( v-firm-code-str )
     2608       no-error.
     2609       if error-status :error
     2610       then do:
     2611           message
     2612               "Неверно задан код фирмы для печати накладных."
     2613           view-as alert-box warning.
     2614           assign
     2615               p-firm-code = 0
     2616           .
     2617       end.
     2618       else do:
     2619           find first buf_clients no-lock
     2620                where buf_clients.obj-type = 'орг':U
     2621                  and buf_clients.obj-code = p-firm-code
     2622           no-error.
     2623           if not available buf_clients
     2624           then do:
     2625               message
     2626                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     2627                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     2628               view-as alert-box warning.
     2629               assign
     2630                   p-firm-code = 0
     2631               .
     2632           end.
     2633       end.
     2634   end.
     2635   end procedure.
     2636   procedure torgconf-get-post-head:
     2637   define input  parameter p-obj-type             as character        no-undo.
     2638   define input  parameter p-obj-code             as integer          no-undo.
     2639   define output parameter p-torgconf-post-head   as character        no-undo.
     2640      define variable v-host-code         as integer      no-undo.
     2641      define buffer buf_sysconf     for ub.sysconf.
     2642        assign
     2643         p-torgconf-post-head  = ""
     2644        .
     2645   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2646   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2647     (input  p-obj-type
     2648     ,input  p-obj-code
     2649     ,output v-host-code
     2650     )  .
     2651      find first buf_sysconf no-lock
     2652      where buf_sysconf.host-code = v-host-code
     2653      no-error.
     2654      if available buf_sysconf
     2655      then do:
     2656         assign
     2657            p-torgconf-post-head = buf_sysconf.head-position
     2658         .
     2659      end.
     2660   end procedure.
     2661   procedure torgconf-get-storekeeper:
     2662   define input  parameter p-wrkr                   as integer          no-undo.
     2663   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     2664   define output parameter p-torgconf-post          as character        no-undo.
     2665      define buffer buf_sysconf     for ub.sysconf.
     2666      define buffer buf_person      for ub.person.
     2667      define buffer buf_shop        for ub.shop .
     2668      define buffer buf_store       for ub.store .
     2669      if v-torgconf-outC = "no_print"
     2670      then do:
     2671         assign p-torgconf-post = ""
     2672                p-torgconf-wrkr-name = ""
     2673                .
     2674      end.
     2675      if v-torgconf-outC = "clad_doc"
     2676      then do:
     2677         run rep/get-psn.p
     2678               (input  p-wrkr
     2679               ,output p-torgconf-wrkr-name
     2680               ) .
     2681         find first buf_person no-lock
     2682         where buf_person.psn-code = p-wrkr
     2683         no-error.
     2684         if available buf_person
     2685         then do:
     2686           p-torgconf-post = buf_person.position.
     2687         end.
     2688         if p-torgconf-post = "?":U then p-torgconf-post = "".
     2689         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2690      end.
     2691      if v-torgconf-outC = "clad_obj"
     2692      then do:
     2693         CASE v-torgconf-self-obj-type:
     2694         WHEN 'маг':U
     2695         THEN DO:
     2696            find first buf_shop no-lock
     2697            where buf_shop.obj-code = v-torgconf-self-obj-code
     2698            .
     2699            assign
     2700               p-torgconf-wrkr-name = buf_shop.store-man
     2701               p-torgconf-post = ""
     2702            .
     2703            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2704         END.
     2705         WHEN 'скл':U
     2706         THEN DO:
     2707            find first buf_store no-lock
     2708            where buf_store.obj-code = v-torgconf-self-obj-code
     2709            .
     2710            assign
     2711               p-torgconf-wrkr-name = buf_store.store-man
     2712               p-torgconf-post = ""
     2713            .
     2714            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2715         END.
     2716         OTHERWISE DO:
     2717            assign
     2718               p-torgconf-post = "":U
     2719               p-torgconf-wrkr-name = "":U
     2720            .
     2721         END.
     2722         END CASE.
     2723      end.
     2724    end procedure.
     2725   procedure torgconf-get-form-header :
     2726   define input parameter p-for-inverse    as logical          no-undo.
     2727   define input parameter p-doc-code       as character        no-undo.
     2728   define input parameter p-print-doc      as logical          no-undo.
     2729   define input parameter p-doc-date       as date             no-undo.
     2730   define input parameter p-fact-date      as date             no-undo.
     2731   define input parameter p-doc-type       as character        no-undo.
     2732   define input parameter p-status_        as character        no-undo.
     2733   define input parameter p-reverse        as logical          no-undo.
     2734   define input parameter p-sf-par         as logical          no-undo.
     2735       define variable v-attr-type         as character    no-undo.
     2736       define variable v-doc-code-standard as logical      no-undo.
     2737       define variable v-doc-date-standard as logical      no-undo.
     2738       define variable v-par-consignee-addres  as character    no-undo.
     2739       define variable v-host-code         as integer      no-undo.
     2740       define variable v-dcode-attr        as character    no-undo.
     2741       define variable v-ddate-attr        as character    no-undo.
     2742       define variable v-doc-date          as character    no-undo.
     2743       define variable v-doc-code          as character    no-undo.
     2744       define variable v-par-type          as character    no-undo.
     2745       define variable v-attr              as character    no-undo.
     2746       define buffer buf_firm          for ub.firm .
     2747       define buffer buf_clients       for ub.clients .
     2748       define buffer buf_sysconf       for ub.sysconf .
     2749       define buffer buf_shop          for ub.shop .
     2750       define buffer buf_store         for ub.store .
     2751       define buffer buf_person        for ub.person .
     2752       define buffer buf_trn-doc       for ub.trn-doc .
     2753       define buffer buf_wth-doc       for ub.wth-doc .
     2754       do
     2755   for buf_firm
     2756     , buf_clients
     2757     , buf_sysconf
     2758     , buf_shop
     2759     , buf_trn-doc
     2760     , buf_person
     2761     , buf_wth-doc
     2762   on error undo, return error
     2763   :
     2764       if p-doc-type = 'при':U
     2765       or p-doc-type = 'возврат':U
     2766       then do:
     2767           assign
     2768               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2769                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2770               v-torgconf-suppi            = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2771                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2772               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ),
     2773                                             v-torgconf-self-host-addres, ( if v-torgconf-self-host-phone = "":U then "":U else ", " ),v-torgconf-self-host-phone )
     2774               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-sup-host-name, ( if v-torgconf-sup-host-addres = "":U then "":U else ", " ),
     2775                                             v-torgconf-sup-host-addres, ( if v-torgconf-sup-host-phone = "":U then "":U else ", " ), v-torgconf-sup-host-phone  )
     2776               v-torgconf-supplier-okpo    = v-torgconf-cli-okpo
     2777               v-torgconf-saler-okpo       = v-torgconf-self-host-okpo
     2778               v-torgconf-consignee-okpo   = v-torgconf-sup-host-okpo
     2779               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-cli-code         )
     2780               v-torgconf-supplier-type    = v-torgconf-cli-type
     2781               v-torgconf-saler-code       = substitute( "&1", v-torgconf-self-host-code   )
     2782               v-torgconf-saler-type       = v-torgconf-self-host-type
     2783               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-sup-host-code   )
     2784               v-torgconf-consignee-type   = v-torgconf-sup-host-type
     2785               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-cli-name         )
     2786               v-torgconf-saler-name       = substitute( "&1", v-torgconf-self-host-name   )
     2787               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-sup-host-name   )
     2788               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-cli-addres       )
     2789               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-self-host-addres )
     2790               v-torgconf-consignee-addr   = substitute( "&1", v-torgconf-sup-host-addres )
     2791               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-cli-inn          )
     2792               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-cli-engl-name          )
     2793               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-self-host-inn    )
     2794               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-sup-host-inn    )
     2795               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-cli-kpp          )
     2796               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-self-host-kpp    )
     2797               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-sup-host-kpp    )
     2798           .
     2799           if v-torgconf-cli-schet-exists = yes
     2800           AND v-form-name                  = "torg12":U
     2801           then do:
     2802               assign
     2803                   v-torgconf-supplier = v-torgconf-supplier
     2804                       + substitute( ", р/с &1 к/с &2"
     2805                                   , v-torgconf-cli-bank-r-schet
     2806                                   , v-torgconf-cli-bank-c-schet
     2807                                   )
     2808                   v-torgconf-suppi = v-torgconf-supplier
     2809                       + substitute( ", р/с &1 к/с &2"
     2810                                   , v-torgconf-cli-bank-r-schet
     2811                                   , v-torgconf-cli-bank-c-schet
     2812                                   )
     2813               .
     2814               if v-torgconf-cli-bank-exists = yes
     2815               then do:
     2816                   assign
     2817                       v-torgconf-supplier = v-torgconf-supplier
     2818                           + substitute( " БИК &1 в &2 &3"
     2819                                       , v-torgconf-cli-bank-bik
     2820                                       , v-torgconf-cli-bank-name
     2821                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2822                                       )
     2823                      v-torgconf-suppi = v-torgconf-supplier
     2824                           + substitute( " БИК &1 в &2 &3"
     2825                                       , v-torgconf-cli-bank-bik
     2826                                       , v-torgconf-cli-bank-name
     2827                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2828                                       )
     2829                   .
     2830               end.
     2831           end.
     2832           if v-torgconf-self-schet-exists = yes
     2833           AND v-form-name                  = "torg12":U
     2834           then do:
     2835               assign
     2836                   v-torgconf-saler = v-torgconf-saler
     2837                       + substitute( ", р/с &1 к/с &2"
     2838                                   , v-torgconf-self-bank-r-schet
     2839                                   , v-torgconf-self-bank-c-schet
     2840                                   )
     2841               .
     2842               if v-torgconf-self-bank-exists = yes
     2843               then do:
     2844                   assign
     2845                       v-torgconf-saler = v-torgconf-saler
     2846                           + substitute( " БИК &1 в &2 &3"
     2847                                       , v-torgconf-self-bank-bik
     2848                                       , v-torgconf-self-bank-name
     2849                                       , v-torgconf-self-bank-addres
     2850                                       )
     2851                   .
     2852               end.
     2853           end.
     2854           if v-torgconf-sup-schet-exists = yes
     2855           AND v-form-name                  = "torg12":U
     2856           then do:
     2857               assign
     2858                   v-torgconf-consignee = v-torgconf-consignee
     2859                       + substitute( ", р/с &1 к/с &2"
     2860                                   , v-torgconf-sup-bank-r-schet
     2861                                   , v-torgconf-sup-bank-c-schet
     2862                                   )
     2863               .
     2864             if v-torgconf-sup-bank-exists = yes
     2865              then do:
     2866                assign
     2867                   v-torgconf-consignee = v-torgconf-consignee
     2868                           + substitute( " БИК &1 в &2 &3"
     2869                                       , v-torgconf-sup-bank-bik
     2870                                       , v-torgconf-sup-bank-name
     2871                                       , v-torgconf-sup-bank-addres
     2872                                       )
     2873                   .
     2874               end.
     2875           end.
     2876      if v-torgconf-outares = yes  AND v-form-name  = "torg12":U
     2877      then do:
     2878          assign
     2879            v-torgconf-supplier = substitute(  "&1&2&3 &4 &5&6"
     2880                                                   , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2881                                                   , v-torgconf-cli-name
     2882                                                   , ( if v-torgconf-outprncd = yes
     2883                                                         then substitute( " (&1)", v-torgconf-cli-code )
     2884                                                         else "":U )
     2885                                                   , v-torgconf-cli-post-addres
     2886                                                   , v-torgconf-cli-phone
     2887                                                   , ( if v-torgconf-cli-bank-r-schet <> "":U
     2888                                                       AND v-form-name                  = "torg12":U
     2889                                                         then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2890                                                               , v-torgconf-cli-bank-r-schet
     2891                                                               , v-torgconf-cli-bank-c-schet
     2892                                                               , v-torgconf-cli-bank-bik
     2893                                                               , v-torgconf-cli-bank-name
     2894                                                               , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )     )
     2895                                                         else "":U )
     2896                                                )
     2897         .
     2898      end.
     2899       v-torgconf-suppi = substitute(  "&1&2&3 &4 &5&6"
     2900                                        , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2901                                        , v-torgconf-cli-name
     2902                                        , ( if v-torgconf-outprncd = yes
     2903                                            then substitute( " (&1)", v-torgconf-cli-code )
     2904                                            else "":U )
     2905                                        , v-torgconf-cli-addres
     2906                                        , v-torgconf-cli-phone
     2907                                        , ( if v-torgconf-cli-bank-r-schet <> "":U
     2908                                            AND v-form-name                  = "torg12":U
     2909                                            then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2910                                                           , v-torgconf-cli-bank-r-schet
     2911                                                           , v-torgconf-cli-bank-c-schet
     2912                                                           , v-torgconf-cli-bank-bik
     2913                                                           , v-torgconf-cli-bank-name
     2914                                                           , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) ))
     2915                                                   else "":U )
     2916                                        ).
     2917       end.
     2918       else do:
     2919       v-torgconf-suppi = substitute(  "&1&2&3 &4 &5&6"
     2920                                        , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-self-host-inn, v-torgconf-self-host-kpp) ELSE "":U
     2921                                        , v-torgconf-self-host-name
     2922                                        , ( if v-torgconf-outprncd = yes
     2923                                            then substitute( " (&1)", v-torgconf-self-host-code )
     2924                                            else "":U )
     2925                                        , v-torgconf-self-host-addres
     2926                                        , v-torgconf-self-host-phone
     2927                                        , ( if v-torgconf-self-bank-r-schet <> "":U
     2928                                            AND v-form-name                  = "torg12":U
     2929                                            then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2930                                                           , v-torgconf-self-bank-r-schet
     2931                                                           , v-torgconf-self-bank-c-schet
     2932                                                           , v-torgconf-self-bank-bik
     2933                                                           , v-torgconf-self-bank-name
     2934                                                           , (if v-torgconf-self-bank-city = "":U then "":U else ( "г. " + v-torgconf-self-bank-city) )     )
     2935                                                   else "":U )
     2936                                           ).
     2937         if v-torgconf-outares = yes
     2938         and p-reverse = no
     2939         then do:
     2940            assign
     2941               v-par-consignee-addres = v-torgconf-ship-post-addres
     2942            .
     2943         end.
     2944         if v-torgconf-outares = no
     2945         and p-reverse = no
     2946         then do:
     2947            assign
     2948               v-par-consignee-addres = v-torgconf-ship-addres
     2949            .
     2950         end.
     2951         if p-reverse = yes
     2952         then do:
     2953             assign
     2954               v-par-consignee-addres = v-torgconf-ship-addres
     2955             .
     2956         end.
     2957           assign
     2958               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ), v-torgconf-self-host-addres,
     2959                                             ( if v-torgconf-self-host-phone = "":U then "":U else ", " ), v-torgconf-self-host-phone )
     2960               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-cli-name      , ( if v-torgconf-cli-addres       = "":U then "":U else ", " ), v-torgconf-cli-addres,
     2961                                             ( if v-torgconf-cli-phone       = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2962               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-ship-name      , ( if v-par-consignee-addres   = "":U then "":U else ", " ), v-par-consignee-addres,
     2963                                              ( if v-torgconf-ship-phone   = "":U then "":U else ", " ), v-torgconf-ship-phone)
     2964               v-torgconf-supplier-okpo    = v-torgconf-self-host-okpo
     2965               v-torgconf-saler-okpo       = v-torgconf-cli-okpo
     2966               v-torgconf-consignee-okpo   = v-torgconf-ship-okpo
     2967               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-self-host-code   )
     2968               v-torgconf-supplier-code    = v-torgconf-self-host-type
     2969               v-torgconf-saler-code       = substitute( "&1", v-torgconf-cli-code         )
     2970               v-torgconf-saler-type       = v-torgconf-cli-type
     2971               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-ship-code         )
     2972               v-torgconf-consignee-type   = v-torgconf-ship-type
     2973               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-self-host-name   )
     2974               v-torgconf-saler-name       = substitute( "&1", v-torgconf-cli-name         )
     2975               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-ship-name         )
     2976               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-self-host-addres )
     2977               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-cli-addres       )
     2978               v-torgconf-consignee-addr   = substitute( "&1", v-par-consignee-addres                )
     2979               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-self-host-inn    )
     2980               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-self-host-engl-name    )
     2981               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-cli-inn          )
     2982               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-ship-inn          )
     2983               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-self-host-kpp    )
     2984               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-cli-kpp          )
     2985               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-ship-kpp          )
     2986               v-torgconf-sf-buyer-name    = v-torgconf-consignee-name
     2987               v-torgconf-sf-buyer-code    = v-torgconf-consignee-code
     2988               v-torgconf-sf-buyer-type    = v-torgconf-consignee-type
     2989               v-torgconf-sf-buyer-addr    = v-torgconf-consignee-addr
     2990           .
     2991           if v-torgconf-self-schet-exists = yes
     2992           AND v-form-name                  = "torg12":U
     2993           then do:
     2994               assign
     2995                   v-torgconf-supplier = v-torgconf-supplier
     2996                       + substitute( ", р/с &1 к/с &2"
     2997                                   , v-torgconf-self-bank-r-schet
     2998                                   , v-torgconf-self-bank-c-schet
     2999                                   )
     3000               .
     3001               if v-torgconf-self-bank-exists = yes
     3002               then do:
     3003                   assign
     3004                       v-torgconf-supplier = v-torgconf-supplier
     3005                           + substitute( " БИК &1 в &2 &3"
     3006                                       , v-torgconf-self-bank-bik
