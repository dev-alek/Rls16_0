     2537       assign
     2538           v-torgconf-ship-type = p-obj-type
     2539           v-torgconf-ship-code = p-obj-code
     2540       .
     2541       if trim(p-obj-type) = ""
     2542       and p-obj-code = 0
     2543       then do:
     2544       assign
     2545           v-torgconf-ship-name         = "":U
     2546           v-torgconf-ship-addres       = "":U
     2547           v-torgconf-ship-post-addres  = "":U
     2548           v-torgconf-ship-phone        = "":U
     2549           v-torgconf-ship-inn          = "":U
     2550           v-torgconf-ship-kpp          = "":U
     2551           v-torgconf-ship-okpo         = "":U
     2552       .
     2553       end.
     2554       else do:
     2555       run fmtcli-get-client in this-procedure (
     2556             input p-obj-type
     2557           , input p-obj-code
     2558       ).
     2559       assign
     2560           v-torgconf-ship-name         = trim( v-fmtcli-name          )
     2561           v-torgconf-ship-engl-name    = trim( v-fmtcli-engl-name          )
     2562           v-torgconf-ship-addres       = trim( v-fmtcli-full-addres   )
     2563           v-torgconf-ship-post-addres  = trim( v-fmtcli-post-addres   )
     2564           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     2565           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     2566           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     2567           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     2568       .
     2569       end.
     2570           run fmtcli-get-bank in this-procedure (
     2571             input p-host-obj-code
     2572           , input p-obj-type
     2573           , input p-obj-code
     2574           , input p-curr-code
     2575       ).
     2576       assign
     2577           v-torgconf-ship-schet-exists = v-fmtcli-schet-exists
     2578           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
     2579           v-torgconf-ship-bank-r-schet = v-fmtcli-bank-r-schet
     2580           v-torgconf-ship-bank-c-schet = v-fmtcli-bank-c-schet
     2581           v-torgconf-ship-bank-bik     = v-fmtcli-bank-bik
