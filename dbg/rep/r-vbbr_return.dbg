     5201   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5202   define  stream PrnLibStream.
     5203   procedure prn-lib-prn-file :
     5204     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     5205     define input parameter p-DIsabledoptions as integer no-undo .
     5206     define variable v-report-name as character no-undo .
     5207     define variable v-user-action as character no-undo .
     5208     define variable v-printed     as logical   no-undo .
     5209     define variable v-exist       as logical   no-undo .
     5210     do
     5211       on error undo, return error
     5212       :
     5213       run prn-lib-get-report-name  in this-procedure (
     5214         input parParentProc
     5215         ,output v-report-name
     5216         ).
     5217   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5218   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     5219     (input  v-report-name
     5220     ,input  2
     5221     ,output v-exist
     5222     )  .
     5223       if NOT v-exist then
     5224       DO:
     5225         Message
     5226           "Нет заданий на печать ! "
     5227           view-as alert-box .
     5228         Return  .
     5229       End.
     5230       run gbl/prnfilen.w
     5231         (input  ""
     5232         ,input  p-DisabledOptions
     5233         ,input  string(v-report-name )
     5234         ,input  7
     5235         ,output v-user-action
     5236         ,output v-printed
     5237         ) .
     5238       if v-printed then
     5239       do:
     5240         return "YES" .
     5241       end.
     5242       else
     5243       do:
     5244         return "NO" .
     5245       end.
     5246     end.
     5247   end procedure.
