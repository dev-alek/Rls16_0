     4442                  .
     4443                  assign
     4444                     v-torgconf-ogr-name = buf_shop.director
     4445                     v-torgconf-ogr-post = "Директор"
     4446                  .
     4447               end.
     4448         if v-torgconf-outogr = "manag_doc"
     4449            then do:
     4450               find first buf_wth-doc no-lock
     4451               where buf_wth-doc.doc-code = p-doc-code
     4452               no-error.
     4453               if available buf_wth-doc
     4454               then do:
     4455                  run rep/get-psn.p
     4456                  (input buf_wth-doc.deliver
     4457                  ,output v-torgconf-ogr-name
     4458                  ) .
     4459               end.
     4460               find first buf_person no-lock
     4461               where buf_person.psn-code = buf_wth-doc.deliver
     4462               no-error.
     4463               if available buf_person
     4464               then do:
     4465                  v-torgconf-ogr-post = buf_person.position.
     4466               end.
     4467               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     4468               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     4469            end.
     4470      end.
     4471   end.
     4472   procedure torgconf-get-reason  :
     4473   define input parameter  p-doc-code       as character        no-undo.
     4474   define input parameter  p-reason-code    as integer          no-undo .
     4475   define input parameter  p-doc-type       as character        no-undo.
     4476       if p-reason-code > 0
     4477       then do:
     4478           define buffer buf_trn-reason for ub.trn-reason.
     4479           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     4480           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     4481       end.
     4482       else do:
     4483           if p-doc-type = 'при':U
     4484           then  do:
     4485               define variable v-attr-type     as character    no-undo.
     4486               define variable v-attr-value    as character    no-undo.
     4487               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     4488               assign v-torgconf-reason = v-attr-value .
     4489               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     4490               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     4491           end.
     4492       end.
     4493   end procedure.
