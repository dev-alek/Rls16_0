     2497             input p-obj-type
     2498           , input p-obj-code
     2499       ).
     2500       assign
     2501           v-torgconf-cli-name         = trim( v-fmtcli-name          )
     2502           v-torgconf-cli-engl-name    = trim( v-fmtcli-engl-name          )
     2503           v-torgconf-cli-addres       = trim( v-fmtcli-full-addres   )
     2504           v-torgconf-cli-post-addres  = trim( v-fmtcli-post-addres   )
     2505           v-torgconf-cli-phone        = trim( v-fmtcli-phone         )
     2506           v-torgconf-cli-inn          = trim( v-fmtcli-inn           )
     2507           v-torgconf-cli-kpp          = trim( v-fmtcli-kpp           )
     2508           v-torgconf-cli-okpo         = trim( v-fmtcli-okpo          )
     2509       .
     2510      run fmtcli-get-bank in this-procedure (
     2511             input p-host-obj-code
     2512           , input p-obj-type
     2513           , input p-obj-code
     2514           , input p-curr-code
     2515       ).
     2516       assign
     2517           v-torgconf-cli-schet-exists = v-fmtcli-schet-exists
     2518           v-torgconf-cli-bank-exists  = v-fmtcli-bank-exists
     2519           v-torgconf-cli-bank-r-schet = v-fmtcli-bank-r-schet
     2520           v-torgconf-cli-bank-c-schet = v-fmtcli-bank-c-schet
     2521           v-torgconf-cli-bank-bik     = v-fmtcli-bank-bik
     2522           v-torgconf-cli-bank-name    = v-fmtcli-bank-name
     2523           v-torgconf-cli-bank-addres  = v-fmtcli-bank-addres
     2524           v-torgconf-cli-bank-city    = v-fmtcli-bank-city
     2525       .
     2526   end.
     2527   end procedure.
     2528   procedure torgconf-get-ship-param :
     2529   define input parameter p-host-obj-code      as integer          no-undo.
     2530   define input parameter p-obj-type           as character        no-undo.
     2531   define input parameter p-obj-code           as integer          no-undo.
     2532   define input parameter p-curr-code          as integer          no-undo.
     2533       define variable v-host-code    as integer      no-undo.
     2534   do
     2535   on error undo, return error
