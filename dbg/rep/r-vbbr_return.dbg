     1108               when 'paycard-all-prefix':U then do:     assign     p-hist = true.   end.
     1109               when 'paycard-edit-prefix':U then do:     assign     p-hist = true.   end.
     1110               when 'form_km3':U then do:     assign     p-hist = true.   end.
     1111               when 'bal_malina':U then do:     assign     p-hist = true.   end.
     1112               when 'max_proc_sum':U then do:     assign     p-hist = true.   end.
     1113               when 'mask_card_kup':U then do:     assign     p-hist = true.   end.
     1114         otherwise do:
