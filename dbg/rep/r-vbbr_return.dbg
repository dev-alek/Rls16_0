     1116         end.
     1117       end.
     1118     end.
     1119   end procedure.
     1120   define new global shared variable g#lib-trn  as handle no-undo .
     1121   define new global shared variable g#lib-trn2 as handle no-undo .
     1122   define new global shared variable g#lib-trn3 as handle no-undo .
     1123   define new global shared variable g#lib-trn4 as handle no-undo .
     1124   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1125   define new global shared variable g#trdcalib as handle no-undo.
     1126   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
     1127                                     iInput AS INTEGER).
     1128     def var v-start-print as integer no-undo .
     1129     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
     1130     assign
     1131       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
     1132     .
     1133     RETURN v-start-print .
     1134   END FUNCTION.
     1135   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
     1136                                     iInput AS INTEGER).
     1137     def var v-start-print as integer no-undo .
     1138     assign
     1139       v-start-print = INTEGER(iEndPix - 1 - iInput)
     1140     .
     1141     if v-start-print < 0 then return 0.
     1142     RETURN v-start-print .
     1143   END FUNCTION.
     1144   define variable vss-include-info11 as character format "X(65)" no-undo
     1145   initial "@(#)$Workfile$ $Revision$".
     1146   define variable v-fmtcli-name          as character    no-undo.
     1147   define variable v-fmtcli-engl-name     as character    no-undo.
     1148   define variable v-fmtcli-addres        as character    no-undo.
     1149   define variable v-fmtcli-post-addres   as character    no-undo.
     1150   define variable v-fmtcli-full-addres   as character    no-undo.
     1151   define variable v-fmtcli-phone         as character    no-undo.
     1152   define variable v-fmtcli-inn           as character    no-undo.
     1153   define variable v-fmtcli-kpp           as character    no-undo.
     1154   define variable v-fmtcli-okpo          as character    no-undo.
     1155   define variable v-fmtcli-country       as character    no-undo.
     1156   define variable v-fmtcli-city          as character    no-undo.
     1157   define variable v-fmtcli-index         as character    no-undo.
     1158   define variable v-fmtcli-schet-exists  as logical      no-undo.
     1159   define variable v-fmtcli-bank-exists   as logical      no-undo.
     1160   define variable v-fmtcli-bank-r-schet  as character    no-undo.
     1161   define variable v-fmtcli-bank-c-schet  as character    no-undo.
     1162   define variable v-fmtcli-bank-bik      as character    no-undo.
     1163   define variable v-fmtcli-bank-name     as character    no-undo.
     1164   define variable v-fmtcli-bank-addres   as character    no-undo.
     1165   define variable v-fmtcli-bank-city     as character    no-undo.
     1166   procedure fmtcli-get-bank :
     1167   define input parameter p-host-code      as integer          no-undo.
     1168   define input parameter p-obj-type       as character        no-undo.
     1169   define input parameter p-obj-code       as integer          no-undo.
     1170   define input parameter p-curr-code      as integer          no-undo.
     1171       define buffer buf_fin-schet     for ub.fin-schet.
     1172       define buffer buf_fin-bank      for ub.fin-bank.
     1173   do
     1174   for buf_fin-schet
     1175     , buf_fin-bank
     1176   on error undo, return error
     1177   :
     1178       assign
     1179           v-fmtcli-schet-exists       = no
     1180           v-fmtcli-bank-exists        = no
     1181           v-fmtcli-bank-r-schet       = "":U
     1182           v-fmtcli-bank-c-schet       = "":U
     1183           v-fmtcli-bank-bik           = "":U
     1184           v-fmtcli-bank-name          = "":U
     1185           v-fmtcli-bank-addres        = "":U
     1186           v-fmtcli-bank-city          = "":U
     1187       .
     1188       search-for-schet:
     1189       for each buf_fin-schet no-lock
     1190          where buf_fin-schet.host-code = p-host-code
     1191            and buf_fin-schet.cli-type  = p-obj-type
     1192            and buf_fin-schet.cli-code  = p-obj-code
     1193            and buf_fin-schet.curr-code = p-curr-code
     1194       on error undo, return error
     1195       :
     1196           if buf_fin-schet.status_   = 'удал':U
     1197           then do:
     1198           end.
     1199           else do:
     1200               assign
     1201                   v-fmtcli-schet-exists   = yes
     1202                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
     1203                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
     1204               .
     1205               find first buf_fin-bank no-lock
     1206                    where buf_fin-bank.host-code = p-host-code
     1207                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
     1208               no-error.
     1209               if available buf_fin-bank
     1210               then do:
     1211                   assign
     1212                       v-fmtcli-bank-exists      = yes
     1213                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
     1214                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
     1215                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
     1216                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
     1217                   .
     1218               end.
     1219               else do:
     1220                   assign
     1221                       v-fmtcli-bank-exists    = no
     1222                       v-fmtcli-bank-bik       = "":U
     1223                       v-fmtcli-bank-name      = "":U
     1224                       v-fmtcli-bank-addres    = "":U
     1225                       v-fmtcli-bank-city      = "":U
     1226                   .
     1227               end.
     1228               leave search-for-schet.
     1229           end.
     1230       end.
     1231   end.
     1232   end procedure.
     1233   procedure fmtcli-get-client :
     1234   define input parameter p-obj-type       as character    no-undo.
     1235   define input parameter p-obj-code       as integer      no-undo.
     1236       define variable v-temp-fmtcli-address      as character     no-undo.
     1237       define variable v-num-country-city    as integer      no-undo.
     1238       define buffer buf_clients   for ub.clients.
     1239       define buffer buf_firm      for ub.firm.
     1240       define buffer buf_store     for ub.store.
     1241       define buffer buf_shop      for ub.shop.
     1242       define buffer buf_person    for ub.person.
     1243   do
     1244   for buf_clients
     1245     , buf_firm
     1246     , buf_store
     1247     , buf_shop
     1248     , buf_person
     1249   on error undo, return error
     1250   :
     1251       assign
     1252           v-fmtcli-name           = "":U
     1253           v-fmtcli-addres         = "":U
     1254           v-fmtcli-post-addres    = "":U
     1255           v-fmtcli-full-addres    = "":U
     1256           v-fmtcli-phone          = "":U
     1257           v-fmtcli-inn            = "":U
     1258           v-fmtcli-kpp            = "":U
     1259           v-fmtcli-okpo           = "":U
     1260           v-fmtcli-city           = "":U
     1261           v-fmtcli-index          = "":U
     1262           v-fmtcli-country        = "":U
     1263       .
     1264       find first buf_clients no-lock
     1265            where buf_clients.obj-type = p-obj-type
     1266              and buf_clients.obj-code = p-obj-code
     1267       .
     1268       assign
     1269           v-fmtcli-name = buf_clients.obj-name
     1270       .
     1271       case buf_clients.obj-type:
     1272          when 'орг':U
     1273          then do:
     1274               find first buf_firm no-lock
     1275                    where buf_firm.firm-code = buf_clients.obj-code
     1276                    no-error
     1277               .
     1278               if available buf_firm
     1279               then do:
     1280                   assign
     1281                       v-num-country-city = num-entries( buf_firm.city )
     1282                       v-fmtcli-engl-name = buf_firm.engl-name
     1283                   .
     1284                   if v-num-country-city > 0
     1285                   then do:
     1286                       assign
     1287                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
     1288                       .
     1289                   end.
     1290                   if v-num-country-city > 1
     1291                   then do:
     1292                       assign
     1293                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
     1294                       .
     1295                   end.
     1296                   run fmtcli-concatenate-strings in this-procedure (
     1297                         input v-fmtcli-full-addres
     1298                       , input v-fmtcli-country
     1299                       , input ", ":U
     1300                       , input 50
     1301                       , output v-fmtcli-full-addres
     1302                   ).
     1303                   run fmtcli-concatenate-strings in this-procedure (
     1304                         input v-fmtcli-full-addres
     1305                       , input v-fmtcli-city
     1306                       , input ", ":U
     1307                       , input 50
     1308                       , output v-fmtcli-full-addres
     1309                   ).
     1310                   run fmtcli-concatenate-strings in this-procedure (
     1311                         input v-fmtcli-full-addres
     1312                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
     1313                       , input ", ":U
     1314                       , input 50
     1315                       , output v-fmtcli-full-addres
     1316                   ).
     1317                   run fmtcli-concatenate-strings in this-procedure (
     1318                         input v-fmtcli-post-addres
     1319                       , input v-fmtcli-country
     1320                       , input ", ":U
     1321                       , input 50
     1322                       , output v-fmtcli-post-addres
     1323                   ).
     1324                   run fmtcli-concatenate-strings in this-procedure (
     1325                         input v-fmtcli-post-addres
     1326                       , input v-fmtcli-city
     1327                       , input ", ":U
     1328                       , input 50
     1329                       , output v-fmtcli-post-addres
     1330                   ).
     1331                   run fmtcli-concatenate-strings in this-procedure (
     1332                         input v-fmtcli-post-addres
     1333                       , input string( buf_firm.ind )
     1334                       , input ", ":U
     1335                       , input 50
     1336                       , output v-fmtcli-post-addres
     1337                   ).
     1338                   run fmtcli-concatenate-strings in this-procedure (
     1339                         input substring( buf_firm.addres1, 1, 50 )
     1340                       , input buf_firm.addres2
     1341                       , input " ":U
     1342                       , input 50
     1343                       , output v-temp-fmtcli-address
     1344                   ).
     1345                   run fmtcli-concatenate-strings in this-procedure (
     1346                         input v-temp-fmtcli-address
     1347                       , input substring( buf_firm.addres1, 51, 50 )
     1348                       , input " ":U
     1349                       , input 50
     1350                       , output v-temp-fmtcli-address
     1351                   ).
     1352                   run fmtcli-concatenate-strings in this-procedure (
     1353                         input v-temp-fmtcli-address
     1354                       , input substring( buf_firm.addres1, 101, 50 )
     1355                       , input " ":U
     1356                       , input 50
     1357                       , output v-temp-fmtcli-address
     1358                   ).
     1359                   assign
     1360                       v-fmtcli-addres = v-temp-fmtcli-address
     1361                   .
     1362                   if buf_firm.addres1 <> ?
     1363                   then do:
     1364                       run fmtcli-concatenate-strings in this-procedure (
     1365                             input v-fmtcli-full-addres
     1366                           , input v-fmtcli-addres
     1367                           , input ", ":U
     1368                           , input 0
     1369                           , output v-fmtcli-full-addres
     1370                       ).
     1371                   end.
     1372                   run fmtcli-concatenate-strings in this-procedure (
     1373                         input substring( buf_firm.post-addr1, 1, 50 )
     1374                       , input buf_firm.post-addr2
     1375                       , input " ":U
     1376                       , input 50
     1377                       , output v-fmtcli-post-addres
     1378                   ).
     1379                   run fmtcli-concatenate-strings in this-procedure (
     1380                         input v-fmtcli-post-addres
     1381                       , input substring( buf_firm.post-addr1, 51, 50 )
     1382                       , input " ":U
     1383                       , input 50
     1384                       , output v-fmtcli-post-addres
     1385                   ).
     1386                   run fmtcli-concatenate-strings in this-procedure (
     1387                         input v-fmtcli-post-addres
     1388                       , input substring( buf_firm.post-addr1, 101, 50 )
     1389                       , input " ":U
     1390                       , input 50
     1391                       , output v-fmtcli-post-addres
     1392                   ).
     1393                   assign
     1394                       v-fmtcli-phone         = buf_firm.phone
     1395                       v-fmtcli-inn           = buf_firm.inn
     1396                       v-fmtcli-kpp           = buf_firm.kpp
     1397                       v-fmtcli-okpo          = buf_firm.okpo
     1398                       v-fmtcli-index         = string( buf_firm.ind )
     1399                   .
     1400               end.
     1401          end.
     1402          when 'маг':U
     1403          then do:
     1404               find first buf_shop no-lock
     1405                    where buf_shop.obj-code = buf_clients.obj-code
     1406               .
     1407               if available buf_shop
     1408               then do:
     1409                   run fmtcli-concatenate-strings in this-procedure (
     1410                         input buf_shop.addres1
     1411                       , input buf_shop.addres2
     1412                       , input " ":U
     1413                       , input 50
     1414                       , output v-fmtcli-addres
     1415                   ).
     1416                   assign
     1417                       v-fmtcli-full-addres = v-fmtcli-addres
     1418                       v-fmtcli-post-addres = v-fmtcli-addres
     1419                       v-fmtcli-phone       = buf_shop.phone
     1420                       v-fmtcli-inn         = "":U
     1421                       v-fmtcli-kpp         = "":U
     1422                       v-fmtcli-okpo        = "":U
     1423                       v-fmtcli-city        = "":U
     1424                       v-fmtcli-index       = "":U
     1425                   .
     1426               end.
     1427          end.
     1428          when 'скл':U
     1429          then do:
     1430               find first buf_store no-lock
     1431                    where buf_store.obj-code = buf_clients.obj-code
     1432               .
     1433               if available buf_store
     1434               then do:
     1435                   run fmtcli-concatenate-strings in this-procedure (
     1436                         input buf_store.addres1
     1437                       , input buf_store.addres2
     1438                       , input " ":U
     1439                       , input 50
     1440                       , output v-fmtcli-addres
     1441                   ).
     1442                   assign
     1443                       v-fmtcli-full-addres = v-fmtcli-addres
     1444                       v-fmtcli-phone       = buf_store.phone
     1445                       v-fmtcli-inn         = "":U
     1446                       v-fmtcli-kpp         = "":U
     1447                       v-fmtcli-okpo        = "":U
     1448                       v-fmtcli-city        = "":U
     1449                       v-fmtcli-index       = "":U
     1450                   .
     1451               end.
     1452          end.
     1453          when 'чел':U
     1454          then do:
     1455               find first buf_person no-lock
     1456                    where buf_person.psn-code = buf_clients.obj-code
     1457               .
     1458               if available buf_person
     1459               then do:
     1460                   run fmtcli-concatenate-strings in this-procedure (
     1461                         input ( if buf_person.ind = 0 or buf_person.ind = ?
     1462                                 then "":U
     1463                                 else string( buf_person.ind, "999999")
     1464                                 )
     1465                       , input buf_person.city
     1466                       , input ", ":U
     1467                       , input 0
     1468                       , output v-fmtcli-full-addres
     1469                   ).
     1470                   assign
     1471                       v-fmtcli-addres = buf_person.address
     1472                   .
     1473                   run fmtcli-concatenate-strings in this-procedure (
     1474                         input v-fmtcli-full-addres
     1475                       , input v-fmtcli-addres
     1476                       , input ", ":U
     1477                       , input 0
     1478                       , output v-fmtcli-full-addres
     1479                   ).
     1480                   assign
     1481                       v-fmtcli-phone     = buf_person.phone1
     1482                       v-fmtcli-inn       = buf_person.inn
     1483                       v-fmtcli-kpp       = buf_person.kpp
     1484                       v-fmtcli-okpo      = buf_person.okpo
     1485                       v-fmtcli-city      = buf_person.city
     1486                       v-fmtcli-index     = string( buf_person.ind )
     1487                   .
     1488               end.
     1489          end.
     1490       end case.
     1491   end.
     1492   end procedure.
     1493   procedure fmtcli-concatenate-strings :
     1494   define input parameter p-string-1       as character        no-undo.
     1495   define input parameter p-string-2       as character        no-undo.
     1496   define input parameter p-delimiter      as character        no-undo.
     1497   define input parameter p-length         as integer          no-undo.
     1498   define output parameter p-out-string    as character        no-undo.
     1499   do
     1500   on error undo, return error
     1501   :
     1502       assign
     1503           p-out-string = ( if p-string-1 = ?
     1504                            then "":U
     1505                            else trim( p-string-1 ) )
     1506       .
     1507       assign
     1508           p-out-string = p-out-string
     1509                        + ( if p-out-string = "":U
     1510                            or length( p-out-string ) = p-length
     1511                            or p-string-2 = ?
     1512                            or trim( p-string-2 ) = "":U
     1513                            then "":U
     1514                            else p-delimiter )
     1515                        + ( if p-string-2 = ?
     1516                            or trim( p-string-2 ) = "":U
     1517                            then "":U
     1518                            else trim( p-string-2 ) )
     1519       .
     1520   end.
     1521   end procedure.
