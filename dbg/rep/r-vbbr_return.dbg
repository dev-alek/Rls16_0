     2159   procedure torgconf-get-recepient-param :
     2160   define input parameter torgconfdoc-code   as character                  no-undo.
     2161   define output parameter v-code-rec        as integer                    no-undo .
     2162   define output parameter v-type-rec        as character                  no-undo initial 'C':U.
     2163   define output parameter v-codefirm-rec    as integer                    no-undo .
     2164   define output parameter v-curcode-rec     as integer                    no-undo .
     2165        define variable  v-recipient-code  as character                  no-undo .
     2166        define variable  v-recipient       like ub.doc-attr.attr-value   no-undo.
     2167        define variable  v-trdcattr-type   as character                  no-undo initial 'C':U.
     2168   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input torgconfdoc-code ,
     2169                           input 'Recipient':U ,
     2170                          output v-recipient-code ,
     2171                          output v-trdcattr-type ) no-error .
     2172       if error-status :error then do:
     2173        message
     2174         vss-workfile vss-revision vss-description skip
     2175         "Ошибка при вызове процедуры tdat-val":U skip
     2176         "Документ: " torgconfdoc-code skip
     2177         "Атрибут: " 'Recipient':U skip
     2178         "Значение: " v-recipient skip
     2179         trim( error-status :get-message (1) ) skip
     2180         return-value skip
     2181         view-as alert-box error.
     2182       undo, return error return-value.
     2183       end.
     2184     assign
     2185       v-recipient  = v-recipient-code
     2186       v-type-rec = substring(v-recipient-code,1,3)
     2187       v-code-rec  = int(substring(v-recipient-code,4,15))
     2188       no-error
     2189     .
     2190     if v-type-rec = ? then v-type-rec = "" .
     2191     if v-code-rec  = ? then v-code-rec  =  0 .
     2192     end procedure.
