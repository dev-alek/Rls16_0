     1732   procedure wthcattr-sprcli :
     1733   define input parameter parparentproc  as widget-handle no-undo.
     1734   define input parameter p-mode  as character no-undo.
     1735   define input-output parameter p-value as character no-undo .
     1736   define output parameter p-setted as logical no-undo .
     1737     DEFINE VARIABLE v-value as character no-undo .
     1738     define variable v-cli-type as character no-undo .
     1739     define variable v-cli-code as integer no-undo .
     1740     define buffer buf_clients   for ub.clients.
     1741     define variable v_rid as character no-undo.
     1742     define variable ref-rec as recid no-undo .
     1743     do
     1744     on error undo, return error
     1745     :
     1746         v-value = p-value.
     1747      if p-value <> '':U then do:
     1748       assign
     1749       v-cli-type = substring(p-value, 1, 3)
     1750       v-cli-code = integer(substring(p-value, 4))
     1751       no-error.
     1752       if error-status:error then do:
     1753         assign
     1754         v-cli-type = '':U
     1755         v-cli-code = 0
     1756         .
     1757       end.
     1758      end.
     1759      FIND FIRST buf_clients NO-LOCK WHERE
     1760               buf_clients.obj-type = v-cli-type AND
     1761               buf_clients.obj-code = v-cli-code  NO-ERROR.
     1762      IF available(buf_clients) then do:
     1763       run ref/cli-all.w (
     1764                   input parparentproc
     1765                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
     1766                  ,input v-cli-type
     1767                  ,input 'все':U
     1768                  ,input 'все':U
     1769                  ,input RECID( buf_clients )
     1770                  ,input ",,,,,,NO"
     1771                  ,input ?
     1772                  ,OUTPUT v_rid ).
     1773     END.
     1774     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     1775       run ref/cli-all.w (
     1776                    input parparentproc
     1777                   ,INPUT "b-sel":U
     1778                  ,input  v-cli-type
     1779                  ,input 'все':U
     1780                  ,input 'текущие':U
     1781                  ,input ?
     1782                  ,input ",,,,,,NO"
     1783                  ,input ?
     1784                  ,OUTPUT v_rid ).
     1785     END.
     1786     else do:
     1787       message
     1788       if p-value = "":U then 'Атрибут не задан!'
     1789       else substitute('Не найден клиент &1',p-value)
     1790       view-as alert-box warning.
     1791     end.
     1792     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1793       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1794       IF ERROR-STATUS:ERROR THEN DO:
     1795           RETURN NO-APPLY.
     1796       END.
     1797       FIND FIRST buf_clients NO-LOCK WHERE
     1798                  RECID( buf_clients ) = ref-rec NO-ERROR.
     1799       IF AVAIL buf_clients THEN DO:
     1800         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     1801       end.
     1802     end.
     1803     if v-value <> p-value then do:
     1804       p-value = v-value.
     1805       p-setted = yes.
     1806     end.
     1807     end.
     1808   end procedure.
     1809     define new global shared variable g#wthcalib as handle no-undo.
     1810   procedure torgconf-read :
     1811   do
     1812   on error undo, return error
     1813   :
     1814       define input parameter p-form-name  as character    no-undo.
     1815       define input parameter p-host-code  as integer      no-undo.
     1816       define input parameter p-obj-type   as character    no-undo.
     1817       define input parameter p-obj-code   as integer      no-undo.
     1818       define variable v-outdate   as character     no-undo.
     1819       define variable v-outares   as character     no-undo.
