     4529   def var vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4530   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     4531   procedure paramls-clear :
     4532     define buffer buf_temp-param for temp-param .
     4533     do
     4534     on error undo, return error return-value
     4535     :
     4536       for each buf_temp-param
     4537       on error undo, return error
     4538       :
     4539         delete buf_temp-param .
     4540       end.
     4541     end.
     4542   end procedure.
     4543   procedure paramls-write :
     4544     define input  parameter p-code     as character no-undo .
     4545     define input  parameter p-sub-code as character no-undo .
     4546     define input  parameter p-value    as character no-undo .
     4547     define buffer buf_temp-param for temp-param .
     4548     do
     4549     on error undo, return error return-value
     4550     :
     4551       find first buf_temp-param
     4552         where buf_temp-param.param-code     = p-code
     4553           and buf_temp-param.param-sub-code = p-sub-code
     4554         no-error .
     4555       if not available buf_temp-param then do:
     4556         create buf_temp-param .
     4557         assign
     4558           buf_temp-param.param-code     = p-code
     4559           buf_temp-param.param-sub-code = p-sub-code
     4560         .
     4561       end.
     4562       assign
     4563         buf_temp-param.param-value = p-value
     4564       .
     4565     end.
     4566   end procedure.
     4567   procedure paramls-read :
     4568     define input  parameter p-code          as character no-undo .
     4569     define input  parameter p-sub-code      as character no-undo .
     4570     define input  parameter p-default-value as character no-undo .
     4571     define output parameter p-value         as character no-undo .
     4572     define buffer buf_temp-param for temp-param .
     4573     do
     4574     on error undo, return error return-value
     4575     :
     4576       find first buf_temp-param
     4577         where buf_temp-param.param-code     = p-code
     4578           and buf_temp-param.param-sub-code = p-sub-code
     4579         no-error .
     4580       if available buf_temp-param then do:
     4581         assign
     4582           p-value = buf_temp-param.param-value
     4583         .
     4584       end.
     4585       else do:
     4586         assign
     4587           p-value = p-default-value
     4588         .
     4589       end.
     4590     end.
     4591   end procedure.
     4592   procedure paramls-append :
     4593     define input  parameter p-code     as character no-undo .
     4594     define input  parameter p-sub-code as character no-undo .
     4595     define input  parameter p-value    as character no-undo .
     4596     define buffer buf_temp-param for temp-param .
     4597     do
     4598     on error undo, return error return-value
     4599     :
     4600       find first buf_temp-param
     4601            where buf_temp-param.param-code     = p-code
     4602              and buf_temp-param.param-sub-code = p-sub-code
     4603         no-error .
     4604       if not available buf_temp-param then do:
     4605         create buf_temp-param .
     4606         assign
     4607           buf_temp-param.param-code     = p-code
     4608           buf_temp-param.param-sub-code = p-sub-code
     4609           buf_temp-param.param-value    = p-value
     4610         .
     4611       end.
     4612       else do:
     4613           assign
     4614               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     4615           .
     4616       end.
     4617     end.
     4618   end procedure.
