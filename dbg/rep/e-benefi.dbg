     1324         INPUT p-page#).
     1325     END PROCEDURE.
     1326   ASSIGN
     1327          Cas-Num:HIDDEN IN FRAME F-Main           = TRUE.
     1328   ON VALUE-CHANGED OF RS-by IN FRAME F-Main
     1329   DO:
     1330       assign RS-by.
     1331       if RS-by = 3 then assign
     1332         RS-method:SENSITIVE in frame F-Main = false
     1333         RS-method:SCREEN-VALUE in frame F-Main = "chk-doc":U
     1334       .
     1335       else assign
     1336         RS-method:SENSITIVE in frame F-Main = true
     1337       .
     1338       assign
     1339       RS-method.
     1340   END.
     1341   ON VALUE-CHANGED OF RS-cass IN FRAME F-Main
     1342   DO:
     1343   assign RS-Cass.
     1344   if RS-cass = "all":U then do:
     1345       assign cas-num = 0.
     1346       display cas-num with frame F-Main.
     1347       disable cas-num with frame F-Main.
     1348       HIDE cas-num in frame F-Main.
     1349   end.
     1350   else do:
     1351      enable cas-num with frame F-Main.
     1352      display cas-num with frame F-Main.
     1353   end.
     1354   END.
     1355   ON VALUE-CHANGED OF RS-method IN FRAME F-Main
     1356   DO:
     1357     assign
     1358     rs-method
     1359     RS-BY.
     1360     if rs-method = "inkas":U then do:
     1361       my-request = true.
     1362       Verify-send-check = false  .
     1363     RUN get-attribute IN THIS-PROCEDURE ('UIB-MODE').
     1364     IF RETURN-VALUE NE "DESIGN" THEN DO:
     1365       RUN get-link-handle IN adm-broker-hdl ( THIS-PROCEDURE, 'State':U , OUTPUT source-str ).
     1366       State-source = WIDGET-HANDLE ( source-str ).
     1367       IF not VALID-HANDLE ( State-source ) THEN
     1368         Message "Не определен линк " 'State':U view-as alert-box error.
     1369     END.
     1370       Run Select-Objects-proc IN State-source.
     1371     end.
     1372     else do:
     1373       my-request = true.
     1374       Verify-send-check = true  .
     1375     RUN get-attribute IN THIS-PROCEDURE ('UIB-MODE').
     1376     IF RETURN-VALUE NE "DESIGN" THEN DO:
     1377       RUN get-link-handle IN adm-broker-hdl ( THIS-PROCEDURE, 'State':U , OUTPUT source-str ).
     1378       State-source = WIDGET-HANDLE ( source-str ).
     1379       IF not VALID-HANDLE ( State-source ) THEN
     1380         Message "Не определен линк " 'State':U view-as alert-box error.
     1381     END.
     1382       Run Select-Objects-proc IN State-source.
     1383     end.
     1384   END.
     1385   if not this-procedure :persistent
     1386   then do:
     1387     message
     1388       vss-workfile vss-revision vss-description skip
     1389       "Ошибка при запуске процедуры" skip
     1390       "Данную процедуру следует запускать только с параметром persistent" skip
     1391       view-as alert-box error .
     1392     undo, return error .
     1393   end.
     1394   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1395     run mainmenu_getcntxt in my-handle
     1396       (output v-cntxt-db-num
     1397       ,output v-cntxt-userid
     1398       ,output v-cntxt-level
     1399       ,output v-cntxt-host-code-obj
     1400       ,output v-cntxt-obj-type
     1401       ,output v-cntxt-obj-code
     1402       ,output v-cntxt-db-num-obj
     1403       ,output v-cntxt-is-admin
     1404       ) .
     1405   PROCEDURE adm-create-objects :
     1406   END PROCEDURE.
     1407   PROCEDURE adm-row-available :
     1408     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1409     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1410     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1411     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1412     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1413     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1414     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1415     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1416     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1417     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1418     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1419     IF adm-updating-record THEN RETURN.
     1420     RUN get-attribute ('FIELDS-ENABLED':U).
     1421     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1422     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1423         OUTPUT link-handle) NO-ERROR.
     1424     IF link-handle = "":U THEN
     1425         RETURN.
     1426     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1427     IF NUM-ENTRIES(link-handle) > 1 THEN
     1428         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1429             "encountered more than one RECORD-SOURCE.":U SKIP
     1430             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1431                VIEW-AS ALERT-BOX ERROR.
     1432     RUN get-attribute ('Key-Name':U).
     1433     key-name = RETURN-VALUE.
     1434     IF key-name = "":U THEN key-name = ?.
     1435     IF key-name NE ? THEN DO:
     1436       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1437         NO-ERROR.
     1438       IF key-value NE ? THEN
     1439         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1440     END.
     1441   IF VALID-HANDLE (adm-object-hdl) THEN
     1442       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1443   RUN notify IN THIS-PROCEDURE ('row-available':U).
     1444   END PROCEDURE.
     1445   PROCEDURE disable_UI :
     1446     HIDE FRAME F-Main.
     1447     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1448   END PROCEDURE.
     1449   PROCEDURE enable_UI :
     1450     DISPLAY RS-by RS-method RS-cass
     1451         WITH FRAME F-Main.
     1452     ENABLE RECT-detail RECT-method RECT-3 RS-by RS-method RS-cass
     1453         WITH FRAME F-Main.
     1454   END PROCEDURE.
     1455   PROCEDURE ini-from-selobj :
     1456   define variable num-obj-list as integer no-undo.
     1457   CASE X-SelectObject :
     1458       when "currency":U then do:
     1459          enable rs-cass with frame F-Main.
     1460       end.
     1461       when 'все':U then do:
     1462           assign cas-num  = 0
     1463           rs-cass = "all":U.
     1464           display rs-cass with frame F-Main.
     1465           disable rs-cass with frame F-Main.
     1466           Hide cas-num in frame F-Main.
     1467       end.
     1468       when "choice":U then do:
     1469           for each obj-list no-lock:
     1470               num-obj-list = num-obj-list + 1.
     1471               if num-obj-list > 1 then leave.
     1472           end.
     1473           if num-obj-list > 1 then do:
     1474           assign cas-num  = 0
     1475           rs-cass = "all":U.
     1476           display rs-cass cas-num with frame F-Main.
     1477           disable rs-cass with frame F-Main.
     1478           Hide cas-num in frame F-Main.
     1479       end.
     1480   end.
     1481   END CASE.
     1482   END PROCEDURE.
     1483   PROCEDURE local-initialize :
     1484     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1485       run ini-from-selobj.
     1486   END PROCEDURE.
     1487   PROCEDURE My-report :
     1488   define variable v-err-message as character no-undo .
     1489   Run My-var.
     1490   run waitfram-show in this-procedure ( input "Ждите..." ) .
     1491   HowBreak = (Rs-by > 0) .
     1492   if RS-method = "inkas" then do:
     1493     case RS-by:
     1494       when 2 then do:
     1495         case my-Set_val_type:
     1496           when 2 then do:
     1497             run rep/r-beneb4.p (
     1498                           input my-handle
     1499                           ,input cas-num
     1500                           ,input howbreak
     1501                           ) no-error.
     1502           end.
     1503           when 1 then do:
     1504             run rep/r-bener4.p (
     1505                           input my-handle
     1506                           ,input cas-num
     1507                           ,input howbreak
     1508                           ) no-error.
     1509           end.
     1510           when 3 then do:
     1511             run rep/r-bento4.p (
     1512                           input my-handle
     1513                           ,input cas-num
     1514                           ,input howbreak
     1515                           ) no-error.
     1516           end.
     1517         END CASE.
     1518       end.
     1519       when 3 then .
     1520       otherwise do:
     1521         case my-Set_val_type:
     1522           when 2 then do:
     1523             run rep/r-beneb3.p (
     1524                           input my-handle
     1525                           ,input cas-num
     1526                           ,input howbreak
     1527                           ) no-error .
     1528           end.
     1529           when 1 then do:
     1530             run rep/r-bener3.p (
     1531                           input my-handle
     1532                           ,input cas-num
     1533                           ,input howbreak
     1534                           ) no-error .
     1535           end.
     1536           when 3 then do:
     1537             run rep/r-bento3.p (
     1538                           input my-handle
     1539                           ,input cas-num
     1540                           ,input howbreak
     1541                           ) no-error.
     1542           end.
     1543         END CASE.
     1544       end.
     1545     end case.
     1546   end.
     1547   else do:
     1548     case RS-by:
     1549       when 2 then do:
     1550         case my-Set_val_type:
     1551           when 2 then do:
     1552             run rep/r-beneb2.p (
     1553                             input my-handle
     1554                            , input cas-num
     1555                            , input howbreak
     1556                             ) no-error.
     1557           end.
     1558           when 1 then do:
     1559             run rep/r-bener2.p (
     1560                             input my-handle
     1561                             ,input cas-num
     1562                             ,input howbreak
     1563                             ) no-error.
     1564           end.
     1565           when 3 then do:
     1566             run rep/r-bento2.p (
     1567                             input my-handle
     1568                             ,input cas-num
     1569                             ,input howbreak
     1570                             ) no-error.
     1571           end.
     1572         END CASE.
     1573       end.
     1574       when 3 then do:
     1575             run rep/r-beneb5.p (
     1576                           input my-handle
     1577                           ,input cas-num
     1578                           ,input howbreak
     1579                           ) no-error.
     1580       end.
     1581       otherwise do:
     1582         case my-Set_val_type:
     1583           when 2 then do:
     1584             run rep/r-beneb1.p (
     1585                             input my-handle
     1586                             ,input cas-num
     1587                             ,input howbreak
     1588                             ) no-error.
     1589           end.
     1590           when 1 then dO:
     1591             run rep/r-bener1.p (
     1592                             input my-handle
     1593                             ,input cas-num
     1594                             ,input howbreak
     1595                             ) no-error.
     1596           end.
     1597           when 3 then dO:
     1598             run rep/r-bento1.p (
     1599                             input my-handle
     1600                             ,input cas-num
     1601                             ,input howbreak
     1602                             ) no-error.
     1603           end.
     1604         END CASE.
     1605       end.
     1606     end case.
     1607   end.
     1608   if error-status:error then do:
     1609     v-err-message = substitute("&2&1&3&1всего ошибок &4",
     1610                                chr(10), return-value, error-status:get-message(1), error-status:num-messages) .
     1611     message v-err-message view-as alert-box.
     1612     run waitfram-hide in this-procedure .
     1613     return .
     1614   end.
     1615   run waitfram-hide in this-procedure .
     1616   END PROCEDURE.
     1617   PROCEDURE My-var :
     1618   assign
     1619   frame F-Main Rs-BY
     1620   frame F-Main Rs-Method
     1621   frame F-Main Rs-Cass
     1622   frame F-Main Cas-num
     1623   no-error .
     1624   assign
     1625   my-Set_val_TYPE = if x-SET_val_TYPE = 0 then 2 else x-SET_val_TYPE
     1626   no-error .
     1627   Assign
     1628    STR-obj-type = ''
     1629    STR-obj-code = ''
     1630    STR-obj-name = ''
     1631    STR-obj      = ''
     1632   no-error .
     1633   For each obj-list no-lock:
     1634    Assign
     1635    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     1636    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     1637    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     1638    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ','
     1639    no-error .
     1640   End.
     1641   ReportHeader =  "Метод формирования: " +
     1642                               radio-label(string(rs-method), rs-method:radio-buttons) + chr(10) +
     1643                               "Детализация: " +
     1644                               radio-label(string(rs-by), rs-by:radio-buttons) + chr(10) +
     1645                               "Кассы: " +
     1646                               radio-label(string(rs-cass), rs-cass:radio-buttons) + chr(10) +
     1647                               (IF cas-num > 0 then ("Касса N: " + String(cas-num)) else "")
     1648                               no-error .
     1649   ReportNAme = "Отчет о выручке" no-error .
     1650     return .
     1651   END PROCEDURE.
     1652   PROCEDURE report-to-ach :
     1653    do
     1654    on error undo, return error return-value
     1655    :
     1656    DEFINE INPUT-OUTPUT  PARAMETER TABLE FOR param-to-export .
     1657     for each  param-to-export : delete  param-to-export. end.
     1658   define variable cconnect as character no-undo .
     1659   define variable user-name as character no-undo .
     1660   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1661   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
     1662     (input  v-cntxt-userid
     1663     ,output user-name
     1664     )  .
     1665    get-key-value section "rep-sets" key "conpar" value cconnect .
     1666   define variable v-base-key as character no-undo .
     1667   run gbl/base-key.p
     1668      (output v-base-key
     1669     ) .
     1670     run create-param-to-export  in this-procedure
     1671     ( input 'base-key'  ,
     1672      input ''  ,
     1673      input 'character'  ,
     1674      input v-base-key  ,
     1675      input 'ключ' )
     1676    .
     1677     run create-param-to-export  in this-procedure
     1678     ( input 'db-connect'  ,
     1679      input ''  ,
     1680      input 'character'  ,
     1681      input cconnect  ,
     1682      input 'строка коннекта к БД' )
     1683    .
     1684     run create-param-to-export  in this-procedure
     1685     ( input 'report-code'  ,
     1686      input ''  ,
     1687      input 'character'  ,
     1688      input ReportProc  ,
     1689      input 'уникальный код отчета' )
     1690    .
     1691   define variable v-host-code like ub.sysconf.host-code no-undo .
     1692   define variable v-host-name like ub.clients.obj-name no-undo .
     1693   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1694   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
     1695     (input  v-cntxt-obj-type
     1696     ,input  v-cntxt-obj-code
     1697     ,output v-host-code
     1698     ,output v-host-name
     1699     )  .
     1700     run create-param-to-export  in this-procedure
     1701     ( input 'firm-name'  ,
     1702      input ''  ,
     1703      input 'character'  ,
     1704      input v-host-name  ,
     1705      input 'имя фирмы' )
     1706    .
     1707     run create-param-to-export  in this-procedure
     1708     ( input 'firm-code'  ,
     1709      input ''  ,
     1710      input 'integer'  ,
     1711      input string(v-cntxt-host-code-obj)  ,
     1712      input 'код фирмы' )
     1713    .
     1714     run create-param-to-export  in this-procedure
     1715     ( input 'user-name'  ,
     1716      input ''  ,
     1717      input 'character'  ,
     1718      input user-name  ,
     1719      input 'имя пользователя' )
     1720    .
     1721     run create-param-to-export  in this-procedure
     1722     ( input 'store-type'  ,
     1723      input ''  ,
     1724      input 'character'  ,
     1725      input v-cntxt-obj-type  ,
     1726      input 'текущий объект - тип'  )
     1727    .
     1728     run create-param-to-export  in this-procedure
     1729     ( input 'store-code'  ,
     1730      input ''  ,
     1731      input 'integer'  ,
     1732      input string(v-cntxt-obj-code)  ,
     1733      input 'текущий объект - код' )
     1734    .
     1735     run create-param-to-export  in this-procedure
     1736     ( input 'date-start'  ,
     1737      input ''  ,
     1738      input 'data'  ,
     1739      input string(x-date-start,'99/99/9999')  ,
     1740      input 'дата начала интервала'  )
     1741    .
     1742     run create-param-to-export  in this-procedure
     1743     ( input 'date-end'  ,
     1744      input ''  ,
     1745      input 'data'  ,
     1746      input string(x-date-end,'99/99/9999')  ,
     1747      input 'дата конца интервала' )
     1748    .
     1749     run create-param-to-export  in this-procedure
     1750     ( input 'user-id'  ,
     1751      input ''  ,
     1752      input 'character'  ,
     1753      input v-cntxt-userid  ,
     1754      input 'код пользователя' )
     1755    .
     1756   define variable v-base-code like ub.sysconf.base-code no-undo .
     1757   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1758   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1759     (input  v-cntxt-host-code-obj
     1760     ,output v-base-code
     1761     )  .
     1762   define buffer buf_currency for ub.currency.
     1763   find first buf_currency no-lock where
     1764             buf_currency.curr-code = v-base-code.
     1765     run create-param-to-export  in this-procedure
     1766     ( input 'base-type'  ,
     1767      input ''  ,
     1768      input 'character'  ,
     1769      input string(buf_currency.curr-abbr)  ,
     1770      input 'тип базовой валюты' )
     1771    .
     1772     run create-param-to-export  in this-procedure
     1773     ( input 'base-code'  ,
     1774      input ''  ,
     1775      input 'integer'  ,
     1776      input string(v-base-code)  ,
     1777      input 'код базовой валюты' )
     1778    .
     1779   if Show-Crsa or Show-Cost or Show-Sale then do:
     1780     run create-param-to-export  in this-procedure
     1781     ( input 'crsa'  ,
     1782      input ''  ,
     1783      input 'logical'  ,
     1784      input string(show-Crsa,'yes/no')  ,
     1785      input '  продажные цены' )
     1786    .
     1787     run create-param-to-export  in this-procedure
     1788     ( input 'cost'  ,
     1789      input ''  ,
     1790      input 'logical'  ,
     1791      input string(show-cost,'yes/no')  ,
     1792      input '  учетные цены' )
     1793    .
     1794     run create-param-to-export  in this-procedure
     1795     ( input 'sale'  ,
     1796      input ''  ,
     1797      input 'logical'  ,
     1798      input string(show-sale,'yes/no')  ,
     1799      input '  цены документа' )
     1800    .
     1801   end.
     1802   else do:
     1803     run create-param-to-export  in this-procedure
     1804     ( input 'set-pay-type'  ,
     1805      input ''  ,
     1806      input 'integer'  ,
     1807      input string(x-set_pay_type)  ,
     1808      input 'тип цены Продажные цены=1 Учетные цены=2 Цены документа=3 ' )
     1809    .
     1810   end.
     1811     run create-param-to-export  in this-procedure
     1812     ( input 'rubl-val'  ,
     1813      input ''  ,
     1814      input 'integer'  ,
     1815      input string(x-SET_val_TYPE)  ,
     1816      input 'печатать в рублях или валюте руб=1  вал=2  обе=3 ' )
     1817    .
     1818     run create-param-to-export  in this-procedure
     1819     ( input 'reportname'  ,
     1820      input ''  ,
     1821      input 'character'  ,
     1822      input reportname  ,
     1823      input 'название отчета' )
     1824    .
     1825     run create-param-to-export  in this-procedure
     1826     ( input 'select-good'  ,
     1827      input ''  ,
     1828      input 'integer'  ,
     1829      input string(x-selectgood)  ,
     1830      input 'тип выбора товара all=1 grp=2 prod=3 choice=4 one=5 grp-prod=6' )
     1831    .
     1832    define variable ii as integer no-undo .
     1833    define variable ii-name as character no-undo .
     1834    define variable ii-1 as integer no-undo .
     1835    define variable ii-name-1 as character no-undo .
     1836     define variable ii-2 as integer no-undo .
     1837    define variable ii-name-2 as character no-undo .
     1838    define variable ii-3 as integer no-undo .
     1839    define variable ii-name-3 as character no-undo .
     1840    if x-selectgood = 1     Or
     1841       x-selectgood = 2     Or
     1842       x-selectgood = 3    Or
     1843       x-selectgood = 4  then do:
     1844    ii = 0.
     1845         for each gds-list :
     1846           ii = ii + 1 .
     1847           if ii = 1 then ii-name = "список товаров - содержит gds-code  (уникальный ключ товара)" .
     1848                     else ii-name = "" .
     1849     run create-param-to-export  in this-procedure
     1850     ( input 'gds-list'  ,
     1851      input string(ii)  ,
     1852      input 'integer'  ,
     1853      input string(gds-list.gds-code)  ,
     1854      input ii-name )
     1855    .
     1856         end.
     1857    end.
     1858    if x-selectgood = 2 then do:
     1859    ii-2 = 0.
     1860         for each tmp#grp :
     1861           ii-2 = ii-2 + 1 .
     1862           if ii-2 = 1 then ii-name-2 = "список товаров - содержит  <node-code#grp-name>  (уникальный ключ списка групп)" .
     1863                     else ii-name-2 = "" .
     1864     run create-param-to-export  in this-procedure
     1865     ( input 'tmp#grp'  ,
     1866      input string(ii-2)  ,
     1867      input 'integer character '  ,
     1868      input string(tmp#grp.node-code) + '#' +  (tmp#grp.grp-name)  ,
     1869      input ii-name-2 )
     1870    .
     1871         end.
     1872    end.
     1873    if x-selectgood = 3 then do:
     1874    ii-3 = 0.
     1875         for each g#cli :
     1876           ii-3 = ii-3 + 1 .
     1877           if ii-3 = 1 then ii-name-3 = "список товаров - содержит  <node-code#grp-name>  (уникальный ключ списка производителе)" .
     1878                       else ii-name-3 = "" .
     1879     run create-param-to-export  in this-procedure
     1880     ( input 'g#cli'  ,
     1881      input string(ii-3)  ,
     1882      input 'character integer'  ,
     1883      input g#cli.obj-type + '#' + string(g#cli.obj-code)  ,
     1884      input ii-name-3 )
     1885    .
     1886         end.
     1887    end.
     1888     run create-param-to-export  in this-procedure
     1889     ( input 'select-object'  ,
     1890      input ''  ,
     1891      input 'character'  ,
     1892      input x-selectobject  ,
     1893      input 'тип выбора объекта   -currency -choice -firm -все' )
     1894    .
     1895    ii-1 = 0.
     1896     for each obj-list :
     1897       ii-1 = ii-1 + 1 .
     1898       if ii-1 = 1 then ii-name-1 = "список объектов - содержит <obj-type#obj-code>  (уникальный ключ clients)" .
     1899                 else ii-name-1 = "" .
     1900     run create-param-to-export  in this-procedure
     1901     ( input 'obj-list'  ,
     1902      input string(ii-1)  ,
     1903      input 'character integer'  ,
     1904      input obj-list.obj-type + '#' + string (obj-list.obj-code)  ,
     1905      input ii-name-1 )
     1906    .
     1907     end.
     1908     run create-param-to-export  in this-procedure
     1909     ( input 'rs-method'                             ,
     1910      input ''                                    ,
     1911      input 'character'                           ,
     1912      input rs-method:screen-value in frame F-Main   ,
     1913      input 'метод формирования' )
     1914    .
     1915     run create-param-to-export  in this-procedure
     1916     ( input 'rs-by'                             ,
     1917      input ''                                    ,
     1918      input 'character'                           ,
     1919      input lc( radio-label(string(rs-by), rs-by:radio-buttons in frame F-Main))    ,
     1920      input 'детализация' )
     1921    .
     1922     run create-param-to-export  in this-procedure
     1923     ( input 'rs-cass'                             ,
     1924      input ''                                    ,
     1925      input 'character'                           ,
     1926      input lc(Rs-cass:screen-value in frame F-Main)   ,
     1927      input 'выбор касс' )
     1928    .
     1929     run create-param-to-export  in this-procedure
     1930     ( input 'cas-num'                             ,
     1931      input ''                                    ,
     1932      input 'integer'                             ,
     1933      input cas-num:screen-value in frame F-Main   ,
     1934      input 'номер кассы' )
     1935    .
     1936     end.
     1937   END PROCEDURE.
     1938   PROCEDURE send-records :
     1939   END PROCEDURE.
     1940   PROCEDURE state-changed :
     1941     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
     1942     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1943     CASE p-state:
     1944       WHEN "link-changed" then do:
     1945           run ini-from-selobj.
     1946       end.
     1947     END CASE.
     1948   END PROCEDURE.
