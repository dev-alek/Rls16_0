     1197   PROCEDURE adm-initialize :
     1198     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1199   END PROCEDURE.
     1200   PROCEDURE adm-show-errors :
     1201       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1202       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1203           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1204       END.
     1205       RETURN.
     1206   END PROCEDURE.
     1207   PROCEDURE adm-UIB-mode :
     1208     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1209   END PROCEDURE.
     1210   PROCEDURE adm-view :
     1211     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1212   END PROCEDURE.
     1213   PROCEDURE dispatch :
     1214       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1215       RUN broker-dispatch IN adm-broker-hdl
     1216           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1217       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1218   END PROCEDURE.
     1219   PROCEDURE ensure-broker :
     1220   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1221   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1222   DO:
     1223       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1224       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1225   END.
     1226   END PROCEDURE.
     1227   PROCEDURE get-attribute :
     1228     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1229     RUN broker-get-attribute IN adm-broker-hdl
     1230         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1231     RETURN RETURN-VALUE.
     1232   END PROCEDURE.
     1233   PROCEDURE get-attribute-list :
     1234     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1235     RUN broker-get-attribute-list IN adm-broker-hdl
     1236         (INPUT THIS-PROCEDURE,
     1237          INPUT ?,
     1238          OUTPUT p-attr-list) NO-ERROR.
     1239     RETURN.
     1240   END PROCEDURE.
     1241   PROCEDURE new-state :
     1242     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1243     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1244     RETURN.
     1245   END PROCEDURE.
     1246   PROCEDURE notify :
     1247     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1248     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1249     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1250         RETURN "ADM-ERROR":U.
     1251     RETURN.
     1252   END PROCEDURE.
     1253   PROCEDURE set-attribute-list :
     1254     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1255     RUN ensure-broker.
     1256     RUN broker-set-attribute-list IN adm-broker-hdl
     1257         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1258     RETURN.
     1259   END PROCEDURE.
     1260   PROCEDURE set-position :
     1261       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1262       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1263       IF VALID-HANDLE(adm-object-hdl) THEN
     1264       DO:
     1265           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     1266           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     1267           DO:
     1268             IF p-row = 0 THEN p-row =
     1269               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     1270             IF p-col = 0 THEN p-col =
     1271               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     1272           END.
     1273           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     1274           DO:
     1275             parent-hdl = adm-object-hdl:PARENT.
     1276             IF p-row = 0 THEN p-row =
     1277               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     1278                 parent-hdl:ROW.
     1279             IF p-col = 0 THEN p-col =
     1280               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     1281                 parent-hdl:COL.
     1282           END.
     1283           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     1284           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     1285         ASSIGN adm-object-hdl:ROW    =   p-row
     1286                adm-object-hdl:COLUMN =   p-col.
     1287       END.
     1288       RETURN.
     1289   END PROCEDURE.
     1290   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
     1291       STRING(adm-object-hdl)).
     1292   PAUSE 0 BEFORE-HIDE.
     1293   PROCEDURE adm-change-page :
     1294     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
     1295     END PROCEDURE.
     1296   PROCEDURE delete-page :
     1297     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
     1298     RUN broker-delete-page IN adm-broker-hdl
     1299         (INPUT THIS-PROCEDURE, INPUT p-page#).
     1300     END PROCEDURE.
     1301   PROCEDURE init-object :
     1302     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
     1303     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
     1304     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
     1305     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
     1306     RUN broker-init-object IN adm-broker-hdl
     1307         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
     1308          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
