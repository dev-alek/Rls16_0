     1314         INPUT p-page-list) NO-ERROR.
     1315     END PROCEDURE.
     1316   PROCEDURE select-page :
     1317     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
     1318     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1319         INPUT p-page#) NO-ERROR.
     1320     END PROCEDURE.
     1321   PROCEDURE view-page :
     1322     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
