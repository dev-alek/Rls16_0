      865   function diff-list returns character (
      866     input parfirst-list  as character,
      867     input parsecond-list as character,
      868     input pardelim       as character).
      869     if pardelim = ""
      870     or pardelim = ?
      871     then do:
      872       assign
      873         pardelim = ","
      874       .
      875     end.
      876     def var ind as integer no-undo .
      877     def var v-elem as character no-undo .
      878     def var v-result-list as character no-undo init "".
      879     def var v-num-parfirst-list as integer no-undo .
      880     assign
      881       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      882     .
      883     do ind = 1 to v-num-parfirst-list
      884     :
      885       assign
      886         v-elem = entry(ind, parfirst-list, pardelim)
      887       .
      888       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      889         assign
      890           v-result-list = v-result-list
      891                         + (if v-result-list > "" then pardelim else "")
      892                         + v-elem
      893         .
      894       end.
      895     end.
      896     return v-result-list .
      897   end function.
      898   function add-list returns character (
      899    input parfirst-list  as character,
      900    input parsecond-list as character,
      901    input pardelim       as character).
      902     if pardelim = ""
      903     or pardelim = ?
      904     then do:
      905       assign
      906         pardelim = ","
      907       .
      908     end.
      909     def var ind as integer no-undo .
      910     def var v-elem as character no-undo .
      911     def var v-result-list as character no-undo init "".
      912     def var v-num-parfirst-list as integer no-undo .
      913     assign
      914       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      915     .
      916     do ind = 1 to v-num-parfirst-list
      917     :
      918       assign
      919         v-elem = entry(ind, parfirst-list, pardelim)
      920       .
      921       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      922         assign
      923           v-result-list = v-result-list
      924                         + (if v-result-list > "" then pardelim else "")
      925                         + v-elem
      926         .
      927       end.
      928     end.
      929     def var v-num-parsecond-list as integer no-undo .
      930     assign
      931       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      932     .
      933     do ind = 1 to v-num-parsecond-list
      934     :
      935       assign
      936         v-elem = entry(ind, parsecond-list, pardelim)
      937       .
      938       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      939         assign
      940           v-result-list = v-result-list
      941                         + (if v-result-list > "" then pardelim else "")
      942                         + v-elem
      943         .
      944       end.
      945     end.
      946     return v-result-list .
      947   end function.
      948   function cross-list returns character (
      949    input parfirst-list  as character,
      950    input parsecond-list as character,
      951    input pardelim       as character).
      952     if pardelim = ""
      953     or pardelim = ?
      954     then do:
      955       assign
      956         pardelim = ","
      957       .
      958     end.
      959     def var ind as integer no-undo .
      960     def var v-elem as character no-undo .
      961     def var v-result-list as character no-undo init "".
      962     def var v-num-parfirst-list as integer no-undo .
      963     assign
      964       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      965     .
      966     do ind = 1 to v-num-parfirst-list
      967     :
      968       assign
      969         v-elem = entry(ind, parfirst-list, pardelim)
      970       .
      971       if lookup(v-elem, v-result-list, pardelim) = 0
      972       and lookup(v-elem, parsecond-list, pardelim) > 0
      973       then do:
      974         assign
      975           v-result-list = v-result-list
      976                         + (if v-result-list > "" then pardelim else "")
      977                         + v-elem
      978         .
      979       end.
      980     end.
      981     return v-result-list .
      982   end function.
      983   function radio-label returns character (
      984    input par-rs-value  as character,
      985    input par-rs-radio-buttons as character)
      986    .
      987    DEFINE variable v-result-label as character no-undo.
      988    assign
      989    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      990                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      991                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      992                             ), par-rs-radio-buttons
      993                           )
      994    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      995    .
      996   return v-result-label.
      997   end function.
      998   function m-radio-label returns character (
      999    input par-rs-value  as character,
     1000    input par-rs-radio-buttons as character,
     1001    input par-delim as character
     1002    )
     1003    .
     1004    DEFINE variable v-result-label as character no-undo.
     1005    assign
     1006    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
     1007                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
     1008                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
     1009                             ), par-rs-radio-buttons, par-delim
     1010                           )
     1011    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1012    .
     1013   return v-result-label.
     1014   end function.
     1015   FUNCTION mixlist returns character
     1016   (
     1017    input parfirst-list  as character
     1018    ,input parsecond-list as character
     1019    ,input pardelim       as character
     1020    ,input pardelim-result as character ) :
     1021     if pardelim = ""
     1022     or pardelim = ?
     1023     then do:
     1024       assign
     1025         pardelim = ","
     1026       .
     1027     end.
     1028     def var ind as integer no-undo .
     1029     def var v-elem1 as character no-undo .
     1030     def var v-elem2 as character no-undo .
     1031     def var v-result-list as character no-undo init "".
     1032     do ind = 1 to num-entries(parfirst-list, pardelim)
     1033     :
     1034       assign
     1035         v-elem1 = entry(ind, parfirst-list, pardelim)
     1036         v-elem2 = entry(ind, parsecond-list, pardelim)
     1037       .
     1038         assign
     1039           v-result-list = v-result-list
     1040                         + (if v-result-list > "" then pardelim-result else "")
     1041                         + v-elem1 + pardelim-result + v-elem2
     1042         .
     1043     end.
     1044     return v-result-list .
     1045   END FUNCTION.
     1046   define temp-table param-to-export no-undo
     1047   field param-code     as character
     1048   field param-sub-code as character
     1049   field param-type     as character
     1050   field param-value    as character
     1051   field param-comment  as character
     1052   index pi is unique primary  param-code     param-sub-code
     1053   .
     1054   procedure create-param-to-export :
     1055    do
     1056    on error undo, return error return-value
     1057    :
     1058    define input parameter p1 as character no-undo .
     1059    define input parameter p2 as character no-undo .
     1060    define input parameter p3 as character no-undo .
     1061    define input parameter p4 as character no-undo .
     1062    define input parameter p5 as character no-undo .
     1063     create  param-to-export.
     1064     assign
     1065        param-to-export.param-code     =  p1
     1066        param-to-export.param-sub-code =  p2
     1067        param-to-export.param-type     =  p3
     1068        param-to-export.param-value    =  p4
     1069        param-to-export.param-comment  =  p5
     1070     .
     1071    end.
     1072   end procedure.
     1073   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1074     define variable v-cntxt-db-num        as integer   no-undo .
     1075     define variable v-cntxt-userid        as character no-undo .
     1076     define variable v-cntxt-level         as character no-undo .
