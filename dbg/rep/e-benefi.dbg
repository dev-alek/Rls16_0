     1078     define variable v-cntxt-obj-type      as character no-undo .
     1079     define variable v-cntxt-obj-code      as integer   no-undo .
     1080     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1081     define variable v-cntxt-is-admin      as logical   no-undo .
     1082   define variable State-source as Widget-handle.
     1083   define shared variable cas-shft as logical no-undo init no.
     1084   DEFINE VARIABLE HowBreak        as logical     no-undo.
     1085   DEFINE VARIABLE my-SET_val_TYPE as integer no-undo.
     1086   DEFINE VARIABLE Cas-Num AS INTEGER FORMAT ">>9":U INITIAL 0
     1087        LABEL "N"
     1088        VIEW-AS FILL-IN
     1089        SIZE 4.6 BY 1 NO-UNDO.
     1090   DEFINE VARIABLE RS-by AS INTEGER
     1091        VIEW-AS RADIO-SET VERTICAL
     1092        RADIO-BUTTONS
     1093             "Без разбиения", 0,
     1094   "C разбиением по дням", 1,
     1095   "C разбиением по кассам", 2,
     1096   "С разбиением по товарам", 3
     1097        SIZE 31.8 BY 3.81 NO-UNDO.
     1098   DEFINE VARIABLE RS-cass AS CHARACTER INITIAL "all"
     1099        VIEW-AS RADIO-SET VERTICAL
     1100        RADIO-BUTTONS
     1101             "Все", "all":U,
     1102   "Выборочно", "selective":U
     1103        SIZE 14.8 BY 1.81 NO-UNDO.
     1104   DEFINE VARIABLE RS-method AS CHARACTER INITIAL "chk-doc"
     1105        VIEW-AS RADIO-SET VERTICAL
     1106        RADIO-BUTTONS
     1107             "Отчет о продаже", "inkas":U,
     1108   "Чеки", "chk-doc":U
     1109        SIZE 25.8 BY 2.1 NO-UNDO.
     1110   DEFINE RECTANGLE RECT-3
     1111        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1112        SIZE 35.6 BY 3.48.
     1113   DEFINE RECTANGLE RECT-detail
     1114        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1115        SIZE 36.2 BY 5.86.
     1116   DEFINE RECTANGLE RECT-method
     1117        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1118        SIZE 35.8 BY 3.71.
     1119   DEFINE FRAME F-Main
     1120        RS-by AT ROW 2.71 COL 4.2 NO-LABEL
     1121        RS-method AT ROW 8.91 COL 4 NO-LABEL
     1122        RS-cass AT ROW 12.67 COL 4 NO-LABEL
     1123        Cas-Num AT ROW 13.29 COL 28.6 COLON-ALIGNED
     1124        "Кассы" VIEW-AS TEXT
     1125             SIZE 21.4 BY 1 AT ROW 11.67 COL 4
     1126             FGCOLOR 4
     1127        "Детализация" VIEW-AS TEXT
     1128             SIZE 27.8 BY 1 AT ROW 1.43 COL 4.2
     1129             FGCOLOR 4
     1130        "Метод формирования" VIEW-AS TEXT
     1131             SIZE 23.8 BY .95 AT ROW 7.81 COL 4
     1132             FGCOLOR 4
     1133        RECT-detail AT ROW 1.14 COL 2.2
     1134        RECT-method AT ROW 7.52 COL 2
     1135        RECT-3 AT ROW 11.48 COL 2
     1136       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1137            SIDE-LABELS NO-UNDERLINE THREE-D
     1138            AT COL 1 ROW 1
     1139            SIZE 38 BY 14.54.
     1140   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1141   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1142   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1143   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1144   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1145   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1146   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1147   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1148       ASSIGN adm-object-hdl = FRAME F-Main:HANDLE.
     1149   RUN ensure-broker.
     1150   THIS-PROCEDURE:ADM-DATA =
     1151        'ADM1.1~`':U +
     1152        'SmartObject~`':U +
     1153        'FRAME~`':U +
     1154        'NO ~`':U +
     1155        '~`':U +
     1156        '~`':U +
     1157        '~`':U +
     1158        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1159           + "~`":U +
     1160        'Layout,Hide-on-Init~`':U +
     1161        '~`':U +
     1162        '~`':U +
     1163        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1164        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1165            THEN "^^":U
     1166        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1167             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1168   PROCEDURE adm-apply-entry :
     1169     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1170   END PROCEDURE.
     1171   PROCEDURE adm-destroy :
     1172    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1173   END PROCEDURE.
     1174   PROCEDURE adm-disable :
     1175       DISABLE RECT-detail RECT-method RECT-3 RS-by RS-method RS-cass WITH FRAME F-Main.
     1176       RUN dispatch ('disable-fields':U).
     1177       RUN set-attribute-list ('ENABLED=no':U).
     1178       RETURN.
     1179   END PROCEDURE.
     1180   PROCEDURE adm-edit-attribute-list :
     1181         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
     1182         RETURN.
     1183   END PROCEDURE.
     1184   PROCEDURE adm-enable :
     1185       ENABLE UNLESS-HIDDEN RECT-detail RECT-method RECT-3 RS-by RS-method RS-cass WITH FRAME F-Main.
     1186       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1187       RUN set-attribute-list ('ENABLED=yes':U).
     1188       RETURN.
     1189   END PROCEDURE.
     1190   PROCEDURE adm-exit :
     1191        RUN notify ('exit':U).
     1192     RETURN.
     1193   END PROCEDURE.
     1194   PROCEDURE adm-hide :
     1195     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
