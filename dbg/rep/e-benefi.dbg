        1   CREATE WIDGET-POOL.
        2   define variable vss-revision    as character no-undo init "$Revision$":u .
        3   define variable vss-author      as character no-undo init "$Author$":u .
        4   define variable vss-date        as character no-undo init "$Date$":u .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":u .
        6   define variable vss-archive     as character no-undo init "$Archive$":u .
        7   define variable vss-description as character no-undo init "Отчет о выручке" .
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   procedure proc-alt-shift-f2:
       67     if not ibs.th.gbl.gbl-var:rcode
       68   then
       69     run gbl\inidebug.p .
       70   end.
       71   procedure proc-alt-shift-f3:
       72     run gbl/prvssinf.p
       73       ( input this-procedure
       74       ) .
       75   end.
       76   define variable v-inform-launched as logical no-undo initial false .
       77   procedure proc-alt-shift-f4:
       78     define variable v-action as character no-undo .
       79     if v-inform-launched = false then do:
       80       assign
       81         v-inform-launched = true
       82       .
       83       run gbl/d-inform.w
       84         (  input self
       85         ,  input this-procedure
       86         , output v-action
       87         ) no-error .
       88       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       89       assign
       90         v-inform-launched = false
       91       .
       92     end.
       93   end.
       94   procedure proc-alt-f1:
       95     run gbl/corrhelp.p
       96       (input this-procedure
       97       ) .
       98   end .
       99   on alt-shift-f2 anywhere do:
      100     run proc-alt-shift-f2.
      101   end.
      102   on alt-shift-f3 anywhere do:
      103     run proc-alt-shift-f3 in this-procedure .
      104   end.
      105   on alt-shift-f4 anywhere do:
      106     run proc-alt-shift-f4 in this-procedure.
      107   end.
      108   on alt-f1 anywhere do:
      109     run proc-alt-f1 in this-procedure .
      110   end.
      111   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      112   define variable v-waitfram-action01         as character   no-undo .
      113   define variable v-waitfram-action02         as character   no-undo .
      114   define variable v-waitfram-action03         as character   no-undo .
      115   define variable mWaitFramTextBeg            as character   no-undo.
      116   define variable mWaitFramTextEnd            as character   no-undo.
      117   define variable mWaitFramView               as logical     no-undo.
      118   define variable mWaitProcEvent              as logical     no-undo init yes.
      119   define variable mWaitFramInterval           as integer     no-undo init 1 .
      120   define variable mWaitFramStop               as logical     no-undo.
      121   define variable mWaitFramStopUser           as logical     no-undo.
      122   define variable mWaitFramStopTimeOut        as logical     no-undo.
      123   define variable mWaitFramStartProc          as datetime-tz no-undo.
      124   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      125   define button B-WaitFramStop auto-end-key
      126        label "Стоп"
      127        size 10 by 1 tooltip "Остоновить процесс".
      128   define button B-viewProcInfo
      129        label "Информация"
      130        size 15 by 1 tooltip "Информация о процесс".
      131   define frame waitfram
      132     v-waitfram-action01 format "x(72)" no-label skip
      133     v-waitfram-action02 format "x(72)" no-label skip
      134     v-waitfram-action03 format "x(72)" no-label skip
      135     B-viewProcInfo
      136     B-WaitFramStop at row 4 col 30
      137     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      138     .
      139   define new global shared variable mBatchMode as logical no-undo init ?.
      140   define variable mFramBachModHandle as handle no-undo.
      141   mFramBachModHandle = frame waitfram:handle.
      142   define variable mFameOldVis as logical no-undo.
      143   define variable mVisCUrentVin as logical no-undo.
      144   if session:batch-mode
      145   then
      146      mBatchMode = yes.
      147   if mBatchMode = ? then do:
      148     mVisCUrentVin = current-window:visible.
      149     mFameOldVis = mFramBachModHandle:visible.
      150     mFramBachModHandle:visible  = yes.
      151     mBatchMode = mFramBachModHandle:visible ne yes.
      152     mFramBachModHandle:visible = mFameOldVis.
      153     current-window:visible = mVisCUrentVin.
      154   end.
      155    if  log-manager:logfile-name ne ?
      156     then DO:
      157         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      158         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      159         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      160     end.
      161   on choose of B-WaitFramStop in frame waitfram
      162   do:
      163     mWaitFramStop = yes.
      164     mWaitFramStopUser = yes.
      165   end.
      166   function waitfram-check-timeout returns logical():
      167      define variable vtime as int64 no-undo.
      168      if mWaitFramStopTimeOut
      169      then
      170         return yes.
      171      vtime = ( now - mWaitFramStartProc ) / 1000 .
      172      if     mWaitFramTimeOut ne ?
      173         and mWaitFramTimeOut ne 0
      174         and mWaitFramTimeOut lt vtime
      175      then do:
      176         mWaitFramStopTimeOut = yes.
      177      end.
      178      return mWaitFramStopTimeOut.
      179   end.
      180   procedure waitfram-hide :
      181     if not session:batch-mode
      182     then do
      183     on error undo, return error return-value
      184     :
      185       pause 0 before-hide .
      186       if not mBatchMode then
      187         hide frame waitfram .
      188     if     not mWaitFramView
      189        and mWaitProcEvent
      190     then
      191       process events .
      192     end.
      193   end procedure.
      194   procedure waitfram-show :
      195     define input  parameter p-message as character no-undo .
      196     define variable v-left-margin as integer   no-undo .
      197     if not session:batch-mode
      198     then do
      199     on error undo, return error return-value
      200     :
      201       if length(p-message) <= 70 then do:
      202         assign
      203           v-left-margin = integer((70 - length(p-message)) / 2)
      204         .
      205         assign
      206           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      207         .
      208         assign
      209           v-waitfram-action01 = " "
      210           v-waitfram-action02 = " "
      211                                    + fill(" ", v-left-margin)
      212                                    + p-message
      213           v-waitfram-action03 = " "
      214         .
      215       end.
      216       else do:
      217         define variable vRindex1 as integer no-undo.
      218         define variable vRindex2 as integer no-undo.
      219         vRindex1 = r-index(p-message," ",70).
      220         if vRindex1 = 0
      221         then
      222            vRindex1 = 70.
      223         if length(p-message)  <= vRindex1 + 70 then do:
      224           assign
      225             v-waitfram-action01 = " "
      226             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      227             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      228           .
      229         end.
      230         else do:
      231           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      232           if vRindex2 <= vRindex1
      233           then
      234              vRindex2 = vRindex1 + 70.
      235           assign
      236             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      237             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      238             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      239           .
      240         end.
      241       end.
      242       B-viewProcInfo:visible   in frame waitfram = no.
      243       B-viewProcInfo:sensitive in frame waitfram = no.
      244       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      245       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      246       if  (   mWaitFramView
      247          or  mWaitProcEvent)
      248          and not mBatchMode
      249       then
      250          display
      251             v-waitfram-action01 skip
      252             v-waitfram-action02 skip
      253             v-waitfram-action03 skip
      254          with frame waitfram .
      255       if     mWaitFramView
      256          then do:
      257             if     mWaitFramInterval ne ?
      258                and not mBatchMode
      259             then
      260                wait-for go of frame waitfram pause mWaitFramInterval.
      261          end.
      262          else
      263             if     mWaitProcEvent
      264                and not mBatchMode
      265             then
      266                process events .
      267     end.
      268   end procedure.
      269      procedure waitfram-show-this:
      270         define input  parameter iInterval as int64 no-undo.
      271         define variable vtime as int64 no-undo.
      272         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      273         mWaitFramInterval = iInterval.
      274         run waitfram-show (substitute("&1&2 &3&4" ,
      275                                       mWaitFramTextBeg ,
      276                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      277                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      278                                       mWaitFramTextEnd
      279                                      )
      280                           ).
      281      end.
      282      procedure WaitFramRunPause:
      283         define input  parameter iInterval as dec no-undo.
      284         define variable vStart  as datetime-tz no-undo.
      285         define variable vend    as datetime-tz no-undo.
      286         define variable vint as int64 no-undo.
      287         define variable vOk as logical no-undo.
      288         vStart = now.
      289         vend   = vStart.
      290         publish "WaitFramPause" (iInterval,output vOk).
      291         vend   =  now.
      292         vint = vend - vStart.
      293         vint = iInterval - vint / 1000.
      294         if     not mWaitFramStop
      295            and (   vint > 0
      296                 or (    not vOk
      297                     and iInterval eq ?
      298                     )
      299                 )
      300         then
      301            run waitfram-show-this (iInterval).
      302         vend   =  now.
      303         vint = vend - vStart.
      304         vint = iInterval - vint / 1000.
      305         if     not mWaitFramStop
      306            and vint > 0
      307         then do:
      308            run gbl/pause.p (vint * 1000).
      309         end.
      310         if iInterval ne ?
      311         then
      312            publish "WaitFramStop".
      313         waitfram-check-timeout().
      314      end.
      315      procedure WaitFramWaitFor:
      316         define input  parameter iInterval as dec no-undo.
      317         assign
      318            mWaitFramStartProc   = now
      319            mWaitFramStopUser    = no
      320            mWaitFramStopTimeOut = no
      321         .
      322         block-wait:
      323         do while not mWaitFramStop:
      324            run WaitFramRunPause (iInterval).
      325            if  waitfram-check-timeout()
      326            then do:
      327               leave block-wait.
      328            end.
      329         end.
      330         run waitfram-hide.
      331      end.
      332   procedure waitfram-join :
      333     define input  parameter p-line-1  as character no-undo .
      334     define input  parameter p-line-2  as character no-undo .
      335     define input  parameter p-line-3  as character no-undo .
      336     define output parameter p-message as character no-undo .
      337     do
      338     on error undo, return error return-value
      339     :
      340       assign
      341         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      342                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      343                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      344       .
      345     end.
      346   end procedure.
      347   function waitfram-join-function returns character
      348     (input p-line-1 as character
      349     ,input p-line-2 as character
      350     ,input p-line-3 as character
      351     ).
      352     define variable v-message as character no-undo .
      353     run waitfram-join in this-procedure
      354       (input  p-line-1
      355       ,input  p-line-2
      356       ,input  p-line-3
      357       ,output v-message
      358       ) .
      359     return v-message .
      360   end function .
