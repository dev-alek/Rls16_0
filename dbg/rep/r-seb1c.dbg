     1090   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1091   define variable v-waitfram-action01         as character   no-undo .
     1092   define variable v-waitfram-action02         as character   no-undo .
     1093   define variable v-waitfram-action03         as character   no-undo .
     1094   define variable mWaitFramTextBeg            as character   no-undo.
     1095   define variable mWaitFramTextEnd            as character   no-undo.
     1096   define variable mWaitFramView               as logical     no-undo.
     1097   define variable mWaitProcEvent              as logical     no-undo init yes.
     1098   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1099   define variable mWaitFramStop               as logical     no-undo.
     1100   define variable mWaitFramStopUser           as logical     no-undo.
     1101   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1102   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1103   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1104   define button B-WaitFramStop auto-end-key
     1105        label "Стоп"
     1106        size 10 by 1 tooltip "Остоновить процесс".
     1107   define button B-viewProcInfo
     1108        label "Информация"
     1109        size 15 by 1 tooltip "Информация о процесс".
     1110   define frame waitfram
     1111     v-waitfram-action01 format "x(72)" no-label skip
     1112     v-waitfram-action02 format "x(72)" no-label skip
     1113     v-waitfram-action03 format "x(72)" no-label skip
     1114     B-viewProcInfo
     1115     B-WaitFramStop at row 4 col 30
     1116     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1117     .
     1118   define new global shared variable mBatchMode as logical no-undo init ?.
     1119   define variable mFramBachModHandle as handle no-undo.
     1120   mFramBachModHandle = frame waitfram:handle.
     1121   define variable mFameOldVis as logical no-undo.
     1122   define variable mVisCUrentVin as logical no-undo.
     1123   if session:batch-mode
     1124   then
     1125      mBatchMode = yes.
     1126   if mBatchMode = ? then do:
     1127     mVisCUrentVin = current-window:visible.
     1128     mFameOldVis = mFramBachModHandle:visible.
     1129     mFramBachModHandle:visible  = yes.
     1130     mBatchMode = mFramBachModHandle:visible ne yes.
     1131     mFramBachModHandle:visible = mFameOldVis.
     1132     current-window:visible = mVisCUrentVin.
     1133   end.
     1134    if  log-manager:logfile-name ne ?
     1135     then DO:
     1136         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1137         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1138         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1139     end.
     1140   on choose of B-WaitFramStop in frame waitfram
     1141   do:
     1142     mWaitFramStop = yes.
     1143     mWaitFramStopUser = yes.
     1144   end.
     1145   function waitfram-check-timeout returns logical():
     1146      define variable vtime as int64 no-undo.
     1147      if mWaitFramStopTimeOut
     1148      then
     1149         return yes.
     1150      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1151      if     mWaitFramTimeOut ne ?
     1152         and mWaitFramTimeOut ne 0
     1153         and mWaitFramTimeOut lt vtime
     1154      then do:
     1155         mWaitFramStopTimeOut = yes.
     1156      end.
     1157      return mWaitFramStopTimeOut.
     1158   end.
     1159   procedure waitfram-hide :
     1160     if not session:batch-mode
     1161     then do
     1162     on error undo, return error return-value
     1163     :
     1164       pause 0 before-hide .
     1165       if not mBatchMode then
     1166         hide frame waitfram .
     1167     if     not mWaitFramView
     1168        and mWaitProcEvent
     1169     then
     1170       process events .
     1171     end.
     1172   end procedure.
     1173   procedure waitfram-show :
     1174     define input  parameter p-message as character no-undo .
     1175     define variable v-left-margin as integer   no-undo .
     1176     if not session:batch-mode
     1177     then do
     1178     on error undo, return error return-value
     1179     :
     1180       if length(p-message) <= 70 then do:
     1181         assign
     1182           v-left-margin = integer((70 - length(p-message)) / 2)
     1183         .
     1184         assign
     1185           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1186         .
     1187         assign
     1188           v-waitfram-action01 = " "
     1189           v-waitfram-action02 = " "
     1190                                    + fill(" ", v-left-margin)
     1191                                    + p-message
     1192           v-waitfram-action03 = " "
     1193         .
     1194       end.
     1195       else do:
     1196         define variable vRindex1 as integer no-undo.
     1197         define variable vRindex2 as integer no-undo.
     1198         vRindex1 = r-index(p-message," ",70).
     1199         if vRindex1 = 0
     1200         then
     1201            vRindex1 = 70.
     1202         if length(p-message)  <= vRindex1 + 70 then do:
     1203           assign
     1204             v-waitfram-action01 = " "
     1205             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1206             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1207           .
     1208         end.
     1209         else do:
     1210           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1211           if vRindex2 <= vRindex1
     1212           then
     1213              vRindex2 = vRindex1 + 70.
     1214           assign
     1215             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1216             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1217             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1218           .
     1219         end.
     1220       end.
     1221       B-viewProcInfo:visible   in frame waitfram = no.
     1222       B-viewProcInfo:sensitive in frame waitfram = no.
     1223       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1224       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1225       if  (   mWaitFramView
     1226          or  mWaitProcEvent)
     1227          and not mBatchMode
     1228       then
     1229          display
     1230             v-waitfram-action01 skip
     1231             v-waitfram-action02 skip
     1232             v-waitfram-action03 skip
     1233          with frame waitfram .
     1234       if     mWaitFramView
     1235          then do:
     1236             if     mWaitFramInterval ne ?
     1237                and not mBatchMode
     1238             then
     1239                wait-for go of frame waitfram pause mWaitFramInterval.
     1240          end.
     1241          else
     1242             if     mWaitProcEvent
     1243                and not mBatchMode
     1244             then
     1245                process events .
     1246     end.
     1247   end procedure.
     1248      procedure waitfram-show-this:
     1249         define input  parameter iInterval as int64 no-undo.
     1250         define variable vtime as int64 no-undo.
     1251         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1252         mWaitFramInterval = iInterval.
     1253         run waitfram-show (substitute("&1&2 &3&4" ,
     1254                                       mWaitFramTextBeg ,
     1255                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1256                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1257                                       mWaitFramTextEnd
     1258                                      )
     1259                           ).
     1260      end.
     1261      procedure WaitFramRunPause:
     1262         define input  parameter iInterval as dec no-undo.
     1263         define variable vStart  as datetime-tz no-undo.
     1264         define variable vend    as datetime-tz no-undo.
     1265         define variable vint as int64 no-undo.
     1266         define variable vOk as logical no-undo.
     1267         vStart = now.
     1268         vend   = vStart.
     1269         publish "WaitFramPause" (iInterval,output vOk).
     1270         vend   =  now.
     1271         vint = vend - vStart.
     1272         vint = iInterval - vint / 1000.
     1273         if     not mWaitFramStop
     1274            and (   vint > 0
     1275                 or (    not vOk
     1276                     and iInterval eq ?
     1277                     )
     1278                 )
     1279         then
     1280            run waitfram-show-this (iInterval).
     1281         vend   =  now.
     1282         vint = vend - vStart.
     1283         vint = iInterval - vint / 1000.
     1284         if     not mWaitFramStop
     1285            and vint > 0
     1286         then do:
     1287            run gbl/pause.p (vint * 1000).
     1288         end.
     1289         if iInterval ne ?
     1290         then
     1291            publish "WaitFramStop".
     1292         waitfram-check-timeout().
     1293      end.
     1294      procedure WaitFramWaitFor:
     1295         define input  parameter iInterval as dec no-undo.
     1296         assign
     1297            mWaitFramStartProc   = now
     1298            mWaitFramStopUser    = no
     1299            mWaitFramStopTimeOut = no
     1300         .
     1301         block-wait:
     1302         do while not mWaitFramStop:
     1303            run WaitFramRunPause (iInterval).
     1304            if  waitfram-check-timeout()
     1305            then do:
     1306               leave block-wait.
     1307            end.
     1308         end.
     1309         run waitfram-hide.
     1310      end.
     1311   procedure waitfram-join :
     1312     define input  parameter p-line-1  as character no-undo .
     1313     define input  parameter p-line-2  as character no-undo .
     1314     define input  parameter p-line-3  as character no-undo .
     1315     define output parameter p-message as character no-undo .
     1316     do
     1317     on error undo, return error return-value
     1318     :
     1319       assign
     1320         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1321                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1322                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1323       .
     1324     end.
     1325   end procedure.
     1326   function waitfram-join-function returns character
     1327     (input p-line-1 as character
     1328     ,input p-line-2 as character
     1329     ,input p-line-3 as character
     1330     ).
     1331     define variable v-message as character no-undo .
     1332     run waitfram-join in this-procedure
     1333       (input  p-line-1
     1334       ,input  p-line-2
     1335       ,input  p-line-3
     1336       ,output v-message
     1337       ) .
     1338     return v-message .
     1339   end function .
