     1563     run dbflib-add-data in this-procedure (
     1564                             input 8
     1565                           , input i
     1566                           , input "NAMEP"
     1567                           , input tt-seb.NAMEP
     1568                       ).
     1569     run dbflib-add-data in this-procedure (
     1570                             input 9
     1571                           , input i
     1572                           , input "POLUCH"
     1573                           , input tt-seb.POLUCH
     1574                       ).
     1575   end.
     1576   run dbflib-write-dbf in this-procedure (
     1577       input "sebestst.dbf":U
     1578     , input i
     1579   ) no-error.
     1580   if error-status :error
     1581   then do:
     1582       message
     1583                vss-workfile vss-revision vss-description
     1584           skip(1)
     1585           skip "Ошибка записи файла формата dbf."
     1586           skip return-value
     1587           skip trim( error-status :get-message( 1 ) )
     1588                trim( error-status :get-message( 2 ) )
     1589                trim( error-status :get-message( 3 ) )
     1590       view-as alert-box error.
     1591       undo, return error.
     1592   end.
     1593   run waitfram-hide .
     1594   message "Готово! Данные выгружены в файл sebestst.dbf в рабочую папку." view-as alert-box .
     1595   end.
     1596   procedure make-tt :
     1597     do
     1598     on error undo, return error return-value
     1599     :
     1600     define buffer buf_shift-obj for ub.shift-obj.
     1601     define buffer buf_trn-doc for ub.trn-doc.
     1602     define buffer buf_doc-line for ub.doc-line.
     1603     define buffer buf2_doc-line for ub.doc-line.
     1604     define buffer buf_chk-doc for ub.chk-doc.
     1605     define buffer buf_chk-gds for ub.chk-gds.
     1606     define buffer buf_chk-gds-pay for ub.chk-gds-pay.
     1607     define buffer buf_bar-code for ub.bar-code .
     1608     define buffer buf_fbr-doc for ub.fbr-doc .
     1609     define buffer buf_comp_fbr-line for ub.fbr-line.
     1610     define buffer buf_ingr_fbr-line for ub.fbr-line.
     1611     define buffer buf_ot-line for ub.ot-line .
     1612     define variable v-pay-code as character no-undo .
     1613     define variable v-vat-pc as decimal no-undo .
     1614     for each buf_trn-doc no-lock where  buf_trn-doc.shift-date    >=  x-Date-Start
     1615                                    and  buf_trn-doc.shift-date    <=  x-Date-End
     1616                                    and  buf_trn-doc.obj-type      =   obj-list.obj-type
     1617                                    and  buf_trn-doc.obj-code      =   obj-list.obj-code
     1618                                    and  buf_trn-doc.status_       =   'факт':U
     1619                                    and  buf_trn-doc.ext-doc-type  =   'es':U,
     1620     each buf_chk-doc no-lock where buf_chk-doc.out-code = buf_trn-doc.doc-code,
     1621     each buf_chk-gds no-lock where buf_chk-gds.doc-code = buf_chk-doc.doc-code,
     1622     each buf_chk-gds-pay no-lock where buf_chk-gds-pay.doc-code = buf_chk-gds.doc-code
     1623                                    and buf_chk-gds-pay.line-num = buf_chk-gds.line-num
     1624                                    and buf_chk-gds-pay.b-code   = buf_chk-gds.b-code,
     1625     first buf_bar-code no-lock where buf_bar-code.b-code  = buf_chk-gds-pay.b-code,
     1626     first tt-gds-list no-lock where tt-gds-list.gds-code = buf_bar-code.gds-code:
     1627       if trim(buf_chk-doc.d-card) > ""
     1628       then do :
     1629         if buf_chk-gds-pay.pay-code = 1 then v-pay-code = "Т001" .
     1630         else
     1631         if buf_chk-gds-pay.pay-code = 2975 then v-pay-code = "Т002" .
     1632         else
     1633         v-pay-code = string(buf_chk-gds-pay.pay-code, "9999") .
     1634         if v-pay-code = "Т001" and buf_chk-gds-pay.tot-r-b <= 0.01 then v-pay-code = string(buf_chk-gds-pay.pay-code, "9999") .
     1635       end.
     1636       else do :
     1637         v-pay-code = string(buf_chk-gds-pay.pay-code, "9999") .
     1638       end.
     1639       find first tt-seb exclusive-lock where  tt-seb.DATAS = x-Date-End
     1640                                          and  tt-seb.AZS   = string(obj-list.obj-code, "99999999999")
     1641                                          and  tt-seb.TOVAR = string(tt-gds-list.gds-code, "99999999999")
     1642                                          and  tt-seb.KODVO = v-pay-code
     1643                                          no-error .
     1644       if not available tt-seb
     1645       then do :
     1646         create tt-seb.
     1647         assign
     1648           tt-seb.DATAS = x-Date-End
     1649           tt-seb.AZS   = string(obj-list.obj-code, "99999999999")
     1650           tt-seb.TOVAR = string(tt-gds-list.gds-code, "99999999999")
     1651           tt-seb.KODVO = v-pay-code
     1652           tt-seb.NAMEA = obj-list.obj-name
     1653           tt-seb.NAMET = tt-gds-list.gds-name
     1654           tt-seb.POLUCH = ""
     1655           tt-seb.NAMEP = ""
     1656         .
     1657       end.
     1658       assign tt-seb.chk-qnty = tt-seb.chk-qnty + buf_chk-gds-pay.eff-doc-qnty .
     1659       find first buf_doc-line no-lock where buf_doc-line.doc-code   = buf_trn-doc.doc-code
     1660                                         and buf_doc-line.artic      = tt-gds-list.artic
     1661                                         and buf_doc-line.prod-type  = tt-gds-list.prod-type
     1662                                         and buf_doc-line.prod-code  = tt-gds-list.prod-code
     1663                                         no-error .
     1664       if available buf_doc-line
     1665       then do :
     1666         find last buf_ot-line where  buf_ot-line.doc-code    = buf_trn-doc.doc-code       and
     1667                                       buf_ot-line.artic        =  buf_doc-line.artic                and
     1668                                       buf_ot-line.prod-code    =  buf_doc-line.prod-code            and
     1669                                       buf_ot-line.prod-type    =  buf_doc-line.prod-type            and
     1670                                       buf_ot-line.obj-code     =  obj-list.obj-code      and
     1671                                       buf_ot-line.obj-type     =  obj-list.obj-type      and
     1672                                       buf_ot-line.sum-type     = 'cost':U use-index pi no-lock no-error.
     1673         assign
     1674           v-vat-pc = if available buf_ot-line then (buf_ot-line.vat-rubl / (buf_ot-line.sum-rubl - buf_ot-line.vat-rubl)) else 0
     1675           tt-seb.SUMMA = tt-seb.SUMMA + (buf_chk-gds-pay.eff-doc-qnty * buf_doc-line.price-rubl / (1 + v-vat-pc))
     1676         .
     1677       end.
     1678     end.
     1679     for each buf_trn-doc no-lock where  buf_trn-doc.shift-date    >=  x-Date-Start
     1680                                    and  buf_trn-doc.shift-date    <=  x-Date-End
     1681                                    and  buf_trn-doc.obj-type      =   obj-list.obj-type
     1682                                    and  buf_trn-doc.obj-code      =   obj-list.obj-code
     1683                                    and  buf_trn-doc.status_       =   'факт':U
     1684                                    and  buf_trn-doc.ext-doc-type  =   'ev':U,
     1685     each buf_doc-line no-lock where buf_doc-line.doc-code = buf_trn-doc.doc-code,
     1686     first tt-gds-list no-lock where tt-gds-list.artic     = buf_doc-line.artic
     1687                                 and tt-gds-list.prod-type = buf_doc-line.prod-type
     1688                                 and tt-gds-list.prod-code = buf_doc-line.prod-code:
     1689       find first tt-seb exclusive-lock where  tt-seb.DATAS = x-Date-End
     1690                                          and  tt-seb.AZS   = string(obj-list.obj-code, "99999999999")
     1691                                          and  tt-seb.TOVAR = string(tt-gds-list.gds-code, "99999999999")
     1692                                          and  tt-seb.KODVO = "9999"
     1693                                          and  tt-seb.POLUCH = string(buf_trn-doc.cli-code, "99999999999")
     1694                                          no-error .
     1695       if not available tt-seb
     1696       then do :
     1697         create tt-seb.
     1698         assign
     1699           tt-seb.DATAS = x-Date-End
     1700           tt-seb.AZS   = string(obj-list.obj-code, "99999999999")
     1701           tt-seb.TOVAR = string(tt-gds-list.gds-code, "99999999999")
     1702           tt-seb.KODVO = "9999"
     1703           tt-seb.NAMEA = obj-list.obj-name
     1704           tt-seb.NAMET = tt-gds-list.gds-name
     1705           tt-seb.POLUCH = string(buf_trn-doc.cli-code, "99999999999")
     1706           tt-seb.NAMEP = buf_trn-doc.cli-name
     1707         .
     1708       end.
     1709       assign tt-seb.chk-qnty = tt-seb.chk-qnty + buf_doc-line.fact-qnty .
     1710       find last  buf_ot-line where buf_ot-line.doc-code    = buf_trn-doc.doc-code       and
     1711                                     buf_ot-line.artic        =  buf_doc-line.artic                and
     1712                                     buf_ot-line.prod-code    =  buf_doc-line.prod-code            and
     1713                                     buf_ot-line.prod-type    =  buf_doc-line.prod-type            and
     1714                                     buf_ot-line.obj-code     =  obj-list.obj-code      and
     1715                                     buf_ot-line.obj-type     =  obj-list.obj-type      and
     1716                                     buf_ot-line.sum-type     = 'cost':U use-index pi no-lock no-error.
     1717       assign
     1718         v-vat-pc = if available buf_ot-line then (buf_ot-line.vat-rubl / (buf_ot-line.sum-rubl - buf_ot-line.vat-rubl)) else 0
     1719         tt-seb.SUMMA = tt-seb.SUMMA + (buf_doc-line.fact-qnty * buf_doc-line.price-rubl / (1 + v-vat-pc))
     1720       .
     1721     end.
     1722     for each buf_trn-doc no-lock where  buf_trn-doc.shift-date    >=  x-Date-Start
     1723                                    and  buf_trn-doc.shift-date    <=  x-Date-End
     1724                                    and  buf_trn-doc.obj-type      =   obj-list.obj-type
     1725                                    and  buf_trn-doc.obj-code      =   obj-list.obj-code
     1726                                    and  buf_trn-doc.status_       =   'факт':U
     1727                                    and  buf_trn-doc.ext-doc-type  =   'we':U,
     1728     each buf_doc-line no-lock where buf_doc-line.doc-code = buf_trn-doc.doc-code,
     1729     first tt-gds-list no-lock where tt-gds-list.artic     = buf_doc-line.artic
     1730                                 and tt-gds-list.prod-type = buf_doc-line.prod-type
     1731                                 and tt-gds-list.prod-code = buf_doc-line.prod-code:
     1732       find first tt-seb exclusive-lock where  tt-seb.DATAS = x-Date-End
     1733                                          and  tt-seb.AZS   = string(obj-list.obj-code, "99999999999")
     1734                                          and  tt-seb.TOVAR = string(tt-gds-list.gds-code, "99999999999")
     1735                                          and  tt-seb.KODVO = "9998"
     1736                                          no-error .
     1737       if not available tt-seb
     1738       then do :
     1739         create tt-seb.
     1740         assign
     1741           tt-seb.DATAS = x-Date-End
     1742           tt-seb.AZS   = string(obj-list.obj-code, "99999999999")
     1743           tt-seb.TOVAR = string(tt-gds-list.gds-code, "99999999999")
     1744           tt-seb.KODVO = "9998"
     1745           tt-seb.NAMEA = obj-list.obj-name
     1746           tt-seb.NAMET = tt-gds-list.gds-name
     1747           tt-seb.POLUCH = ""
     1748           tt-seb.NAMEP = ""
     1749         .
     1750       end.
     1751       assign tt-seb.chk-qnty = tt-seb.chk-qnty + buf_doc-line.fact-qnty .
     1752       find last buf_ot-line where  buf_ot-line.doc-code    = buf_trn-doc.doc-code       and
     1753                                     buf_ot-line.artic        =  buf_doc-line.artic                and
     1754                                     buf_ot-line.prod-code    =  buf_doc-line.prod-code            and
     1755                                     buf_ot-line.prod-type    =  buf_doc-line.prod-type            and
     1756                                     buf_ot-line.obj-code     =  obj-list.obj-code      and
     1757                                     buf_ot-line.obj-type     =  obj-list.obj-type      and
     1758                                     buf_ot-line.sum-type     = 'cost':U use-index pi no-lock no-error.
     1759       assign
     1760         v-vat-pc = if available buf_ot-line then (buf_ot-line.vat-rubl / (buf_ot-line.sum-rubl - buf_ot-line.vat-rubl)) else 0
     1761         tt-seb.SUMMA = tt-seb.SUMMA + (buf_doc-line.fact-qnty * buf_doc-line.price-rubl /(1 + v-vat-pc))
     1762       .
     1763     end.
     1764     for each buf_fbr-doc no-lock where  buf_fbr-doc.shift-date    >=  x-Date-Start
     1765                                    and  buf_fbr-doc.shift-date    <=  x-Date-End
     1766                                    and  buf_fbr-doc.obj-type      =   obj-list.obj-type
     1767                                    and  buf_fbr-doc.obj-code      =   obj-list.obj-code
     1768                                    and  buf_fbr-doc.status_       =   'факт':U:
     1769       for each buf_comp_fbr-line no-lock where buf_comp_fbr-line.doc-code = buf_fbr-doc.doc-code
     1770                                            and buf_comp_fbr-line.is-comp = yes,
     1771       first buf_goods of buf_comp_fbr-line:
     1772         for each buf_ingr_fbr-line no-lock where buf_ingr_fbr-line.doc-code = buf_fbr-doc.doc-code
     1773                                              and buf_ingr_fbr-line.is-comp = no
     1774                                              and buf_ingr_fbr-line.recipe-code = buf_comp_fbr-line.recipe-code,
     1775         first tt-gds-list no-lock where tt-gds-list.artic     = buf_ingr_fbr-line.artic
     1776                                     and tt-gds-list.prod-type = buf_ingr_fbr-line.prod-type
     1777                                     and tt-gds-list.prod-code = buf_ingr_fbr-line.prod-code :
     1778           find first tt-fbr no-lock where tt-fbr.comp-gds-code = buf_goods.gds-code
     1779                                       and tt-fbr.ingr-gds-code = tt-gds-list.gds-code
     1780                                       no-error .
     1781           if not available tt-fbr
     1782           then do :
     1783             create tt-fbr .
     1784             assign
     1785               tt-fbr.comp-gds-code = buf_goods.gds-code
     1786               tt-fbr.ingr-gds-code = tt-gds-list.gds-code
     1787               tt-fbr.ingr-gds-name = tt-gds-list.gds-name
     1788             .
     1789           end.
     1790           assign
     1791             tt-fbr.comp-qnty = tt-fbr.comp-qnty + buf_comp_fbr-line.fact-qnty
     1792             tt-fbr.inqr-qnty = tt-fbr.inqr-qnty + buf_ingr_fbr-line.fact-qnty
     1793           .
     1794         end.
     1795       end.
     1796     end.
     1797     for each buf_trn-doc no-lock where  buf_trn-doc.shift-date    >=  x-Date-Start
     1798                                    and  buf_trn-doc.shift-date    <=  x-Date-End
     1799                                    and  buf_trn-doc.obj-type      =   obj-list.obj-type
     1800                                    and  buf_trn-doc.obj-code      =   obj-list.obj-code
     1801                                    and  buf_trn-doc.status_       =   'факт':U
     1802                                    and  buf_trn-doc.ext-doc-type  =   'wm':U,
     1803     each buf_doc-line no-lock where buf_doc-line.doc-code = buf_trn-doc.doc-code,
     1804     first tt-gds-list no-lock where tt-gds-list.artic     = buf_doc-line.artic
     1805                                 and tt-gds-list.prod-type = buf_doc-line.prod-type
     1806                                 and tt-gds-list.prod-code = buf_doc-line.prod-code:
     1807       find first tt-seb exclusive-lock where  tt-seb.DATAS = x-Date-End
     1808                                          and  tt-seb.AZS   = string(obj-list.obj-code, "99999999999")
     1809                                          and  tt-seb.TOVAR = string(tt-gds-list.gds-code, "99999999999")
     1810                                          and  tt-seb.KODVO = "spi-prvo"
     1811                                          no-error .
     1812       if not available tt-seb
     1813       then do :
     1814         create tt-seb.
     1815         assign
     1816           tt-seb.DATAS = x-Date-End
     1817           tt-seb.AZS   = string(obj-list.obj-code, "99999999999")
     1818           tt-seb.TOVAR = string(tt-gds-list.gds-code, "99999999999")
     1819           tt-seb.KODVO = "spi-prvo"
     1820           tt-seb.NAMEA = obj-list.obj-name
     1821           tt-seb.NAMET = tt-gds-list.gds-name
     1822           tt-seb.POLUCH = ""
     1823           tt-seb.NAMEP = ""
     1824         .
     1825       end.
     1826       assign tt-seb.chk-qnty = tt-seb.chk-qnty + buf_doc-line.fact-qnty .
     1827       find last buf_ot-line where  buf_ot-line.doc-code    = buf_trn-doc.doc-code       and
     1828                                     buf_ot-line.artic        =  buf_doc-line.artic                and
     1829                                     buf_ot-line.prod-code    =  buf_doc-line.prod-code            and
     1830                                     buf_ot-line.prod-type    =  buf_doc-line.prod-type            and
     1831                                     buf_ot-line.obj-code     =  obj-list.obj-code      and
     1832                                     buf_ot-line.obj-type     =  obj-list.obj-type      and
     1833                                     buf_ot-line.sum-type     = 'cost':U use-index pi no-lock no-error.
     1834       assign
     1835         v-vat-pc = if available buf_ot-line then (buf_ot-line.vat-rubl / (buf_ot-line.sum-rubl - buf_ot-line.vat-rubl)) else 0
     1836         tt-seb.SUMMA = tt-seb.SUMMA + (buf_doc-line.fact-qnty * buf_doc-line.price-rubl / (1 + v-vat-pc))
     1837       .
     1838     end.
     1839     for each buf_trn-doc no-lock where  buf_trn-doc.shift-date    >=  x-Date-Start
     1840                                    and  buf_trn-doc.shift-date    <=  x-Date-End
     1841                                    and  buf_trn-doc.obj-type      =   obj-list.obj-type
     1842                                    and  buf_trn-doc.obj-code      =   obj-list.obj-code
     1843                                    and  buf_trn-doc.status_       =   'факт':U
     1844                                    and  buf_trn-doc.ext-doc-type  =   'vp':U,
     1845     each buf_doc-line no-lock where buf_doc-line.doc-code = buf_trn-doc.doc-code
     1846                                 and buf_doc-line.fact-qnty < 0,
     1847     first tt-gds-list no-lock where tt-gds-list.artic     = buf_doc-line.artic
     1848                                 and tt-gds-list.prod-type = buf_doc-line.prod-type
     1849                                 and tt-gds-list.prod-code = buf_doc-line.prod-code:
     1850       find first ub.recipe no-lock where
     1851                  ub.recipe.prod-type = buf_doc-line.prod-type
     1852              and ub.recipe.prod-code = buf_doc-line.prod-code
     1853              and ub.recipe.artic     = buf_doc-line.artic
     1854              and
     1855                (
     1856                ( ub.recipe.obj-type  = obj-list.obj-type
     1857              and ub.recipe.obj-code  = obj-list.obj-code
     1858                )
     1859               or
     1860                ( ub.recipe.obj-type  = "":U
     1861              and ub.recipe.obj-code  = 0
     1862                )
     1863                )
     1864              no-error.
     1865       if available ub.recipe
     1866       then do :
     1867         find first ub.parts-root no-lock where ub.parts-root.doc-code = buf_trn-doc.doc-code
     1868                                            and ub.parts-root.orig-gds-code = tt-gds-list.gds-code
     1869                                            no-error .
     1870         if available ub.parts-root
     1871         then do :
     1872           for each buf_tt-seb exclusive-lock where buf_tt-seb.DATAS = x-Date-End
     1873                                                and buf_tt-seb.AZS   = string(obj-list.obj-code, "99999999999")
     1874                                                and buf_tt-seb.TOVAR = string(ub.parts-root.orig-gds-code, "99999999999") :
     1875             find first tt-seb exclusive-lock where  tt-seb.DATAS = x-Date-End
     1876                                                and  tt-seb.AZS   = string(obj-list.obj-code, "99999999999")
     1877                                                and  tt-seb.TOVAR = string(ub.parts-root.gds-code, "99999999999")
     1878                                                and  tt-seb.KODVO = buf_tt-seb.KODVO
     1879                                                no-error .
     1880             if available tt-seb
     1881             then do :
     1882               find first ub.goods no-lock where ub.goods.gds-code = ub.parts-root.gds-code .
     1883               find first buf2_doc-line no-lock where buf2_doc-line.doc-code   = buf_doc-line.doc-code
     1884                                                  and buf2_doc-line.artic      = ub.goods.artic
     1885                                                  and buf2_doc-line.prod-type  = ub.goods.prod-type
     1886                                                  and buf2_doc-line.prod-code  = ub.goods.prod-code
     1887                                                  and buf2_doc-line.fact-qnty >= 0
     1888                                                  no-error .
     1889               if available buf2_doc-line
     1890               then do :
     1891                 find first ub.parts no-lock where ub.parts.artic      = buf2_doc-line.artic
     1892                                               and ub.parts.prod-type  = buf2_doc-line.prod-type
     1893                                               and ub.parts.prod-code  = buf2_doc-line.prod-code
     1894                                               and ub.parts.in-code    = buf_trn-doc.doc-code
     1895                                               and ub.parts.out-code   = 'out-zone':U
     1896                                               no-error .
     1897                 if available ub.parts
     1898                 then do :
     1899                   assign
     1900                     buf_tt-seb.chk-qnty = buf_tt-seb.chk-qnty + ((abs(buf_doc-line.fact-qnty) / buf2_doc-line.fact-qnty) * ub.parts.fact-qnty)
     1901                     buf_tt-seb.SUMMA = buf_tt-seb.SUMMA + (tt-seb.SUMMA * (ub.parts.fact-qnty / tt-seb.chk-qnty))
     1902                     tt-seb.chk-qnty = tt-seb.chk-qnty - ub.parts.fact-qnty
     1903                     tt-seb.SUMMA = tt-seb.SUMMA - (tt-seb.SUMMA * (ub.parts.fact-qnty / tt-seb.chk-qnty))
     1904                   .
     1905                 end .
     1906               end .
     1907             end .
     1908           end .
     1909         end .
     1910       end .
     1911     end .
     1912     for each buf_tt-seb no-lock where buf_tt-seb.KODVO <> "spi-prvo" :
     1913       for each tt-fbr no-lock where tt-fbr.comp-gds-code = integer(buf_tt-seb.TOVAR) :
     1914         find first tt-seb exclusive-lock where  tt-seb.DATAS = x-Date-End
     1915                                            and  tt-seb.AZS   = string(obj-list.obj-code, "99999999999")
     1916                                            and  tt-seb.TOVAR = string(tt-fbr.ingr-gds-code, "99999999999")
     1917                                            and  tt-seb.KODVO = buf_tt-seb.KODVO
     1918                                            no-error .
     1919         if not available tt-seb
     1920         then do :
     1921           create tt-seb.
     1922           assign
     1923             tt-seb.DATAS = x-Date-End
     1924             tt-seb.AZS   = string(obj-list.obj-code, "99999999999")
     1925             tt-seb.TOVAR = string(tt-fbr.ingr-gds-code, "99999999999")
     1926             tt-seb.KODVO = buf_tt-seb.KODVO
     1927             tt-seb.NAMEA = obj-list.obj-name
     1928             tt-seb.NAMET = tt-fbr.ingr-gds-name
     1929             tt-seb.POLUCH = ""
     1930             tt-seb.NAMEP = ""
     1931           .
     1932         end .
     1933         find first buf2_tt-seb no-lock where  buf2_tt-seb.DATAS = x-Date-End
     1934                                          and  buf2_tt-seb.AZS   = string(obj-list.obj-code, "99999999999")
     1935                                          and  buf2_tt-seb.TOVAR = string(tt-fbr.ingr-gds-code, "99999999999")
     1936                                          and  buf2_tt-seb.KODVO = "spi-prvo"
     1937                                          no-error .
     1938         if available buf2_tt-seb
     1939         then do :
     1940           assign
     1941             tt-seb.SUMMA = tt-seb.SUMMA + (buf2_tt-seb.SUMMA * buf_tt-seb.chk-qnty / buf2_tt-seb.chk-qnty * (tt-fbr.inqr-qnty / tt-fbr.comp-qnty))
     1942           .
     1943         end.
     1944       end.
     1945     end.
     1946     end.
     1947   end procedure.
     1948   procedure make-dbf :
     1949     define input parameter p-tt-hndl as handle .
     1950   end.
     1951   procedure dbflib-write-dbf :
     1952   define input parameter p-filename       as character        no-undo.
     1953   define input parameter p-record-amount  as integer          no-undo.
     1954       define variable v-date          as date         no-undo.
     1955       define variable v-string-value  as character    no-undo.
     1956       define variable raw-value       as raw          no-undo.
     1957       define variable v-record-count  as integer      no-undo.
     1958       define buffer buf_temp_dbflib_field    for temp_dbflib_field.
     1959       define buffer buf_temp_dbflib_data     for temp_dbflib_data.
     1960   do
     1961   for buf_temp_dbflib_field
     1962     , buf_temp_dbflib_data
     1963   on error undo, return error
     1964   :
     1965       output stream dbf-stream to value( p-filename ) binary convert target 'IBM866'.
     1966       put stream dbf-stream
     1967           control "~003":U
     1968       .
     1969       run dbflib-makebinary (
     1970             input year( today ) - 2000
     1971           , input 1
     1972           , output raw-value
     1973       ).
     1974       put stream dbf-stream control raw-value.
     1975       run dbflib-makebinary (
     1976           month( today )
     1977           , input 1
     1978           , output raw-value
     1979       ).
     1980       put stream dbf-stream control raw-value.
     1981       run dbflib-makebinary (
     1982             input day( today )
     1983           , input 1
     1984           , output raw-value
     1985       ).
     1986       put stream dbf-stream control raw-value.
     1987       run dbflib-makebinary (
     1988             input p-record-amount
     1989           , input 4
     1990           , output raw-value
     1991       ).
     1992       put stream dbf-stream control raw-value.
     1993       run dbflib-makebinary (
     1994             input ( 32 + 32 * v-field-amount + 1 )
     1995           , input 2
     1996           , output raw-value
     1997       ).
     1998       put stream dbf-stream control raw-value.
     1999       run dbflib-makebinary (
     2000             input v-dbflib-reclength + 1
     2001           , input 2
     2002           , output raw-value
     2003       ).
     2004       put stream dbf-stream control raw-value.
     2005       put stream dbf-stream control null( 20 ).
     2006       for each buf_temp_dbflib_field use-index col_
     2007       :
     2008           put stream dbf-stream control
     2009               buf_temp_dbflib_field.dbfield-name
     2010               null( 11 - length( buf_temp_dbflib_field.dbfield-name ) )
     2011           .
     2012           case buf_temp_dbflib_field.data-type:
     2013               when "character":U
     2014               then do:
     2015                   put stream dbf-stream "C".
     2016               end.
     2017               when "integer":U
     2018               or when "decimal"
     2019               then do:
     2020                   put stream dbf-stream "N".
     2021               end.
     2022               when "logical":U
     2023               then do:
     2024                   put stream dbf-stream "L".
     2025               end.
     2026               when "date":U
     2027               then do:
     2028                   put stream dbf-stream "D".
     2029               end.
     2030               otherwise do:
     2031                   undo, return error substitute("Unknown field type for &1: &2",
     2032                                                   buf_temp_dbflib_field.field-handle:name,
     2033                                                   buf_temp_dbflib_field.data-type).
     2034               end.
     2035           end case.
     2036           put stream dbf-stream control
     2037               null( 4 )
     2038               chr( buf_temp_dbflib_field.field-length )
     2039           .
     2040           if buf_temp_dbflib_field.field-decimals = 0
     2041           then do:
     2042               put stream dbf-stream control null.
     2043           end.
     2044           else do:
     2045               put stream dbf-stream control
     2046                   chr( buf_temp_dbflib_field.field-decimals )
     2047               .
     2048           end.
     2049           put stream dbf-stream control
     2050               null(2)
     2051               chr(1)
     2052               null(11)
     2053          .
     2054       end.
     2055       put stream dbf-stream control
     2056           chr(13)
     2057       .
     2058       do v-record-count = 1 to p-record-amount
     2059       on error undo, return error
     2060       :
     2061           for each buf_temp_dbflib_data
     2062              where buf_temp_dbflib_data.record-number = v-record-count use-index col_
     2063           :
     2064               put stream dbf-stream
     2065                   " "
     2066               .
     2067               find first buf_temp_dbflib_field
     2068               where buf_temp_dbflib_field.field-name = buf_temp_dbflib_data.field-name
     2069               no-error.
     2070               if available buf_temp_dbflib_field
     2071               then do:
     2072                   case buf_temp_dbflib_field.data-type
     2073                   :
     2074                       when "logical":U
     2075                       then do:
     2076                           put stream dbf-stream unformatted
     2077                               ( if buf_temp_dbflib_data.data-value = "yes":U
     2078                               then "T":U
     2079                               else "F":U )
     2080                           .
     2081                       end.
     2082                       when "date":U
     2083                       then do:
     2084                           assign
     2085                               v-date = date( buf_temp_dbflib_data.data-value )
     2086                           .
     2087                           put stream dbf-stream unformatted
     2088                               year( v-date )
     2089                               month( v-date ) format "99"
     2090                               day( v-date ) format "99"
     2091                           .
     2092                       end.
     2093                       when "decimal":U
     2094                       or when "integer":U
     2095                       then do:
     2096                           if session:numeric-format = "EUROPEAN":U
     2097                           then do:
     2098                               assign
     2099                                   v-string-value = replace( string( buf_temp_dbflib_data.data-value ), ".":U, "":U )
     2100                                   v-string-value = replace( v-string-value, ",":U, ".":U )
     2101                               .
     2102                           end.
     2103                           else do:
     2104                               assign
     2105                                   v-string-value = replace( string( buf_temp_dbflib_data.data-value ),",","")
     2106                               .
     2107                           end.
     2108                           put stream dbf-stream unformatted
     2109                               v-string-value
     2110                               fill( " ":U, buf_temp_dbflib_field.field-length - 1 - length( v-string-value ) )
     2111                           .
     2112                       end.
     2113                       otherwise do:
     2114                           put stream dbf-stream unformatted
     2115                               string( buf_temp_dbflib_data.data-value )
     2116                               fill( " ", buf_temp_dbflib_field.field-length - 1 - length( string( buf_temp_dbflib_data.data-value ) ) )
     2117                           .
     2118                       end.
     2119                   end case.
     2120               end.
     2121           end.
     2122       end.
     2123       output stream dbf-stream close.
     2124   end.
     2125   end procedure.
     2126   PROCEDURE dbflib-makebinary:
     2127   define input parameter anumm#     as integer      no-undo.
     2128   define input parameter abyte#     as integer      no-undo.
     2129   define output parameter raw-value as raw          no-undo.
     2130       define variable acoun#    as integer      no-undo.
     2131   do
     2132   on error undo, return error
     2133   :
     2134       assign
     2135           length( raw-value ) = abyte#
     2136       .
     2137       if anumm# <0
     2138       then do:
     2139           message
     2140                    vss-workfile vss-revision vss-description
     2141               skip(1)
     2142               skip ": This routine works for positive integers only."
     2143               skip "Received value of" anumm# "is invalid."
     2144               skip return-value
     2145               skip trim(error-status :get-message(1))
     2146                    trim(error-status :get-message(2))
     2147                    trim(error-status :get-message(3))
     2148           view-as alert-box error
     2149           title "Conversion to binary".
     2150           undo, return error .
     2151       end.
     2152       if anumm# > 0
     2153       and anumm# modulo anumm# / EXP( anumm#, abyte#) > 256
     2154       then do:
     2155           message
     2156                    vss-workfile vss-revision vss-description
     2157               skip(1)
     2158               skip ": received number" anumm#
     2159               skip "does not fit in" abyte# "bytes."
     2160               skip return-value
     2161               skip trim(error-status :get-message(1))
     2162                    trim(error-status :get-message(2))
     2163                    trim(error-status :get-message(3))
     2164           view-as alert-box error
     2165           title "Conversion to binary".
     2166           undo, return error .
     2167       end.
     2168       do acoun# = abyte# to 1 by -1
     2169       on error undo, return error
     2170       :
     2171           put-byte( raw-value, acoun# ) = int( truncate( anumm# / EXP( 256, acoun# - 1 ), 0 ) ).
     2172           if anumm# ne 0
     2173           then do:
     2174               assign
     2175                   anumm# = anumm# modulo EXP( 256, acoun# - 1 )
     2176               .
     2177           end.
     2178       end.
     2179   end.
     2180   END PROCEDURE.
     2181   procedure dbflib-init :
     2182       define buffer buf_temp_dbflib_field    for temp_dbflib_field.
     2183       define buffer buf_temp_dbflib_data     for temp_dbflib_data.
     2184   do
     2185   for buf_temp_dbflib_field
     2186     , buf_temp_dbflib_data
     2187   :
     2188       empty temp-table buf_temp_dbflib_field.
     2189       empty temp-table buf_temp_dbflib_data.
     2190       assign
     2191           v-dbflib-reclength = 0
     2192           v-field-amount     = 0
     2193       .
     2194   end.
     2195   end procedure.
     2196   procedure dbflib-add-field :
     2197   define input parameter p-col-num        as integer          no-undo.
     2198   define input parameter p-field-name     as character        no-undo.
     2199   define input parameter p-field-length   as integer          no-undo.
     2200   define input parameter p-data-type      as character        no-undo.
     2201   define input parameter p-field-decimals as integer          no-undo.
     2202       define buffer buf_temp_dbflib_field    for temp_dbflib_field.
     2203   do
     2204   for buf_temp_dbflib_field
     2205   on error undo, return error
     2206   :
     2207       find first buf_temp_dbflib_field
     2208            where buf_temp_dbflib_field.field-name       = p-field-name
     2209       no-error.
     2210       if not available buf_temp_dbflib_field
     2211       then do:
     2212           create buf_temp_dbflib_field.
     2213           assign
     2214               buf_temp_dbflib_field.col-num          = p-col-num
     2215               buf_temp_dbflib_field.field-name       = p-field-name
     2216               buf_temp_dbflib_field.field-length     = p-field-length
     2217               buf_temp_dbflib_field.data-type        = p-data-type
     2218               buf_temp_dbflib_field.field-decimals   = p-field-decimals
     2219               buf_temp_dbflib_field.dbfield-name     = caps( replace( substring( p-field-name, 1, 11 ), "-":U, "_":U ) )
     2220               v-dbflib-reclength                     = v-dbflib-reclength + buf_temp_dbflib_field.field-length
     2221               v-field-amount                         = v-field-amount + 1
     2222           .
     2223       end.
     2224   end.
     2225   end procedure.
     2226   procedure dbflib-add-data :
     2227   define input parameter p-col-num        as integer          no-undo.
     2228   define input parameter p-record-number  as integer          no-undo.
     2229   define input parameter p-field-name     as character        no-undo.
     2230   define input parameter p-data-value     as character        no-undo.
     2231       define buffer buf_temp_dbflib_data      for temp_dbflib_data.
     2232   do
     2233   for buf_temp_dbflib_data
     2234   on error undo, return error
     2235   :
     2236       find first buf_temp_dbflib_data
     2237            where buf_temp_dbflib_data.record-number  = p-record-number
     2238              and buf_temp_dbflib_data.field-name     = p-field-name
     2239       no-error.
     2240       if not available buf_temp_dbflib_data
     2241       then do:
     2242           create buf_temp_dbflib_data.
     2243           assign
     2244               buf_temp_dbflib_data.col-num        = p-col-num
     2245               buf_temp_dbflib_data.record-number  = p-record-number
     2246               buf_temp_dbflib_data.field-name     = p-field-name
     2247               buf_temp_dbflib_data.data-value     = p-data-value
     2248           .
     2249       end.
     2250   end.
     2251   end procedure.
