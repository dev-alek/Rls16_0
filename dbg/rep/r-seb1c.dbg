      983   procedure proc-alt-shift-f2:
      984     if not ibs.th.gbl.gbl-var:rcode
      985   then
      986     run gbl\inidebug.p .
      987   end.
      988   procedure proc-alt-shift-f3:
      989     run gbl/prvssinf.p
      990       ( input this-procedure
      991       ) .
      992   end.
      993   define variable v-inform-launched as logical no-undo initial false .
      994   procedure proc-alt-shift-f4:
      995     define variable v-action as character no-undo .
      996     if v-inform-launched = false then do:
      997       assign
      998         v-inform-launched = true
      999       .
     1000       run gbl/d-inform.w
     1001         (  input self
     1002         ,  input this-procedure
     1003         , output v-action
     1004         ) no-error .
     1005       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     1006       assign
     1007         v-inform-launched = false
     1008       .
     1009     end.
     1010   end.
     1011   procedure proc-alt-f1:
     1012     run gbl/corrhelp.p
     1013       (input this-procedure
     1014       ) .
     1015   end .
     1016   on alt-shift-f2 anywhere do:
     1017     run proc-alt-shift-f2.
     1018   end.
     1019   on alt-shift-f3 anywhere do:
     1020     run proc-alt-shift-f3 in this-procedure .
     1021   end.
     1022   on alt-shift-f4 anywhere do:
     1023     run proc-alt-shift-f4 in this-procedure.
     1024   end.
     1025   on alt-f1 anywhere do:
     1026     run proc-alt-f1 in this-procedure .
     1027   end.
