      886     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      887     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      888     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      889     IF "":U = "":U THEN
      890       RUN modify-list-attribute IN adm-broker-hdl
      891         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      892     RUN use-create-on-add(?).
      893   PROCEDURE adm-add-record :
