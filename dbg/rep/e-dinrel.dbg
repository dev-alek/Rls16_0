      132   def
      133    shared
      134   temp-table  obj-list no-undo
      135     field obj-type like ub.clients.obj-type
      136     field obj-code like ub.clients.obj-code
      137     field obj-name like ub.clients.obj-name
      138     field obj-id   as integer
