      914        "must have at least one Enabled Table to perform Copy.":U
      915          VIEW-AS ALERT-BOX ERROR.
      916       RETURN.
      917   END PROCEDURE.
      918   PROCEDURE adm-create-record :
      919      RETURN.
      920   END PROCEDURE.
      921   PROCEDURE adm-current-changed :
      922     RETURN.
      923   END PROCEDURE.
      924   PROCEDURE adm-delete-record :
      925    MESSAGE
      926          "Object ":U THIS-PROCEDURE:FILE-NAME
      927            "must have at least one Enabled Table to perform Delete.":U
      928              VIEW-AS ALERT-BOX ERROR.
      929       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      930       RETURN.
