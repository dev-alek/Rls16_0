     2508   define variable vss-include-info23 as character format "X(65)" no-undo
     2509   initial "@(#)$Workfile$ $Revision$".
     2510           run menu-doc-create-menu-item in this-procedure
     2511             ( input xtype
     2512              , input xstatus
     2513              , input xinternal
     2514              , input xflag
     2515              , input '*'
     2516              , input '*'
     2517              , input '*'
     2518              , input '*'
     2519              , input 'Калькуляционные карточки (печатать только после переоценки)'
     2520              , input 'cost,sale,rubl,base'
     2521              , input 'rep/op-1.p'
     2522              , input 'yes,yes,1,no,no'
     2523              , input '------'
     2524              , input ''
     2525              , input 'A4port'
     2526              , input ''
     2527           ).
     2528   define variable vss-include-info24 as character format "X(65)" no-undo
     2529   initial "@(#)$Workfile$ $Revision$".
     2530           run menu-doc-create-menu-item in this-procedure
     2531             ( input xtype
     2532              , input xstatus
     2533              , input xinternal
     2534              , input xflag
     2535              , input '*'
     2536              , input 'акт':U
     2537              , input '*'
     2538              , input '*'
     2539              , input 'Акт о переоценке товаров'
     2540              , input 'cost,sale,rubl,base'
     2541              , input 'rep/r-ord.p'
     2542              , input 'akt'
     2543              , input '------'
     2544              , input 'yukos,ibs,Rosneft*'
     2545              , input 'A4lans'
     2546              , input ''
     2547           ).
     2548       find first buf_usr-flt exclusive-lock
     2549            where buf_usr-flt.user-name   = v-cntxt-userid
     2550              and buf_usr-flt.call-point  = substitute( "&1,&2":U
     2551                                                   , 'переоценка':U
     2552                                                   , ub.price-doc.status_   )
     2553       no-error .
     2554       if available buf_usr-flt
     2555       then do:
     2556           assign
     2557               v-list_               = buf_usr-flt.list_
     2558               rs-price-selection    = (if buf_usr-flt.type-price =  yes then 1 else 2)
     2559               tg-print-zero         = buf_usr-flt.type-val
     2560               tg-sort-by-group      = buf_usr-flt.sort-gr
     2561           .
     2562       end.
     2563       else do:
     2564           create  buf_usr-flt .
     2565           assign
     2566               buf_usr-flt.user-name  = v-cntxt-userid
     2567               buf_usr-flt.call-point = substitute( "&1,&2":U
     2568                                               , 'переоценка':U
     2569                                               , ub.price-doc.status_   )
     2570               rs-price-selection    = 1
     2571               tg-print-zero         = no
     2572               tg-sort-by-group      = no
     2573           .
     2574           assign
     2575               buf_usr-flt.list_ = "":U
     2576           .
     2577           for each tmp#list
     2578               where tmp#list.last-use = yes
     2579           :
     2580               assign
     2581                   buf_usr-flt.list_  = substitute(  "&1&2&3":U
     2582                                           , buf_usr-flt.list_
     2583                                           , ( if buf_usr-flt.list_ = "":U then "":U else ",":U )
     2584                                           , tmp#list.id
     2585                                       )
     2586               .
     2587           end.
     2588       end.
     2589     For each tmp#list share-lock
     2590     :
     2591         if lookup( string( tmp#list.id ), v-list_ ) > 0
     2592         then tmp#list.last-use = true .
     2593         tmp#list.view_ = 1 .
     2594         if sys-key <> 'ExpertekIBS':U then DO:
     2595             if sys-key <> tmp#list.sys-key  and tmp#list.sys-key <> ''
     2596                        THEN  Assign tmp#list.view_ = 0   tmp#list.last-use = false.
     2597         End.
     2598         if     tmp#list.proc-name = '' Then  Assign tmp#list.view_ = 0   tmp#list.last-use = false.
     2599     End.
     2600   END PROCEDURE.
