        1   define input parameter p-mainmenu-handle    as handle           no-undo.
        2   define input parameter rec_id               as  recid           no-undo.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Печать переоценки".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       71   define new shared variable RepPathName        as character no-undo .
       72   define new shared variable PrintRubl          as logical   no-undo .
       73   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       74   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
       75   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
       76   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
       77   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
       78   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
       79   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
       80   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
       81   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
       82   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
       83   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
       84   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
       85   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
       86   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
       87   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
       88   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
       89   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
       90   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
       91   define variable vss-include-info2 as character format "X(65)" no-undo
       92   initial "@(#)$Workfile$ $Revision$".
       93       define temp-table Tmp#List no-undo like ub.ord-blank
       94           field id                        as integer
       95           field proc-name                 as character
       96           field proc-param                as character
       97           field print-options             as character
       98           field orient                    as character
       99           field orient-orientation        as character
      100           field orient-font-num           as integer
      101           field font-num                  as character
      102           field filtr                     as character
      103           field view_                     as integer  init 1
      104           field sys-key                   as character
      105           field sys-key-black             as character
      106           field type-parts                as character
      107           field type-parts-enabled        as logical
      108           field type-price                as character
      109           field type-price-enabled        as logical
      110           field type-scale                as character
      111           field type-scale-enabled        as logical
      112           field type-val                  as character
      113           field type-val-enabled          as logical
      114           field sort-name                 as character
      115           field sort-name-enabled         as logical
      116           field sort-gr                   as character
      117           field sort-gr-enabled           as logical
      118           field print-graft               as character
      119           field print-graft-enabled       as logical
      120           field no-vat                    as character
      121           field no-vat-enabled            as logical
      122           index pi is primary unique id
      123           index in-name
      124              blank-name
      125           index lu
      126               last-use
      127       .
      128       define temp-table temp_form-list no-undo
      129           field doc-code  as character
      130           field id        as integer
      131           field doc-type  as character
      132           field status_   as character
      133           field internal  as character
      134           field flag      as character
      135           index pi is primary unique
      136               doc-code
      137               id
      138           index idx
      139               id
      140       .
      141       define temp-table temp_menu-doc_disabled-doc-list no-undo
      142           field doc-code      as character
      143           field blank-name    as character
      144           field reason        as character
      145           index pi is primary unique
      146                   doc-code
      147                   blank-name
      148       .
      149       define variable v-menu-doc-sys-key              as character    no-undo.
      150       define variable v-menu-doc-doc-code             as character    no-undo.
      151       define variable v-menu-doc-doc-type             as character    no-undo.
      152       define variable v-menu-doc-ext-doc-type         as character    no-undo.
      153       define variable v-menu-doc-status_              as character    no-undo.
      154       define variable v-menu-doc-internal             as character    no-undo.
      155       define variable v-menu-doc-flag                 as character    no-undo.
      156       define variable v-menu-doc-item-counter         as integer      no-undo.
      157       define variable v-menu-doc-item-disabled        as logical      no-undo.
      158   define variable vss-include-info3 as character format "X(65)":U no-undo initial "@(#)$Workfile$ $Revision$".
      159   function check-entry-with-mask returns logical ( input p-element as character, input p-list as character, input p-delimiter as character ) :
      160     define variable p-entry   as logical   no-undo .
      161     define variable v-ind as integer   no-undo .
      162     if p-delimiter = "*":U then do:
      163       message
      164         vss-workfile "(check-entry-with-mask)" vss-revision vss-description skip
      165         substitute('Разделитель не может быть равный "&1"', p-delimiter ) skip
      166         view-as alert-box error .
      167       return ? .
      168     end.
      169     assign
      170       p-entry = true
      171     .
      172     if lookup( p-element, p-list, p-delimiter ) = 0 then do:
      173       assign
      174         p-entry = false
      175       .
      176       if num-entries( p-list, "*":U ) > 1 then do:
      177         block_check-list:
      178         do v-ind = 1 to num-entries( p-list, p-delimiter )
      179         :
      180           if p-element matches entry( v-ind, p-list, p-delimiter ) then do:
      181             assign
      182               p-entry = true
      183             .
      184             leave block_check-list .
      185           end.
      186         end.
      187       end.
      188     end.
      189     return p-entry .
      190   end function .
      191       procedure menu-doc-create-menu-item
      192       :
      193       define input parameter p-type   as   character no-undo.
      194       define input parameter p-stat   as   character no-undo.
      195       define input parameter p-intr   as   character no-undo.
      196       define input parameter p-flag   as   character no-undo.
      197       define input parameter param-1  as   character no-undo.
      198       define input parameter param-2  as   character no-undo.
      199       define input parameter param-3  as   character no-undo.
      200       define input parameter param-4  as   character no-undo.
      201       define input parameter param-5  as   character no-undo.
      202       define input parameter param-6  as   character no-undo.
      203       define input parameter param-7  as   character no-undo.
      204       define input parameter param-8  as   character no-undo.
      205       define input parameter param-9  as   character no-undo.
      206       define input parameter param-10 as   character no-undo.
      207       define input parameter param-11 as   character no-undo.
      208       define input parameter param-12 as   character no-undo.
      209       do
      210       on error undo, return error
      211       :
      212           assign
      213               v-menu-doc-item-disabled = yes
      214           .
      215           if v-menu-doc-sys-key <> 'ExpertekIBS':U
      216           and ( ( param-10 <> "":U
      217                   and check-entry-with-mask( v-menu-doc-sys-key, param-10, chr(44) ) = false
      218                 )
      219                 or ( param-12 <> "":U
      220                      and check-entry-with-mask( v-menu-doc-sys-key, param-12, chr(44) ) = true )
      221                    )
      222           then do:
      223               undo, return .
      224           end.
      225           if param-7 = "":U
      226           then do:
      227               undo, return .
      228           end.
      229           if param-1 = '*':U
      230           or lookup( p-type, param-1 ) > 0
      231           then do:
      232               if param-2 = '*':U
      233               or lookup( p-stat, param-2 ) > 0
      234               then do:
      235                   if param-3 = '*':U
      236                   or lookup( p-intr, param-3 ) > 0
      237                   then do:
      238                       if param-4 = '*':U
      239                       or lookup( p-flag, param-4 ) > 0
      240                       then do:
      241                           assign
      242                               v-menu-doc-item-disabled = no
      243                           .
      244                           find first tmp#list
      245                                where tmp#list.blank-name     = param-5
      246                                  and tmp#list.filtr          = param-6
      247                                  and tmp#list.proc-name      = param-7
      248                                  and tmp#list.proc-param     = param-8
      249                                  and tmp#list.print-options  = param-9
      250                                  and tmp#list.sys-key        = param-10
      251                                  and tmp#list.orient         = param-11
      252                                  and tmp#list.sys-key-black  = param-12
      253                           no-error.
      254                           if not available tmp#list
      255                           then do:
      256                               assign
      257                                   v-menu-doc-item-counter = v-menu-doc-item-counter + 1
      258                               .
      259                               create tmp#list.
      260                               assign
      261                                   tmp#list.id             = v-menu-doc-item-counter
      262                                   tmp#list.cli-code       = v-menu-doc-item-counter
      263                                   tmp#list.blank-name     = param-5
      264                                   tmp#list.filtr          = param-6
      265                                   tmp#list.proc-name      = param-7
      266                                   tmp#list.proc-param     = param-8
      267                                   tmp#list.print-options  = param-9
      268                                   tmp#list.sys-key        = param-10
      269                                   tmp#list.orient         = param-11
      270                                   tmp#list.sys-key-black  = param-12
      271                               .
      272                               assign
      273                                   tmp#list.orient-orientation     = entry( 1, tmp#list.orient )
      274                                   tmp#list.orient-font-num        = 7
      275                               .
      276                               assign
      277                                   tmp#list.orient-font-num      = ( if num-entries( tmp#list.orient ) > 1
      278                                                                     then integer( entry( 2, tmp#list.orient ) )
      279                                                                     else 7 )
      280                               no-error.
      281                               if error-status :error
      282                               then do:
      283                                   assign
      284                                       tmp#list.orient-font-num = 7
      285                                   .
      286                               end.
      287                               run menu-doc-set-visible-options in this-procedure (
      288                                     input tmp#list.print-options
      289                                   , output tmp#list.type-parts-enabled
      290                                   , output tmp#list.type-price-enabled
      291                                   , output tmp#list.type-scale-enabled
      292                                   , output tmp#list.type-val-enabled
      293                                   , output tmp#list.sort-name-enabled
      294                                   , output tmp#list.sort-gr-enabled
      295                                   , output tmp#list.print-graft-enabled
      296                                   , output tmp#list.no-vat-enabled
      297                               ).
      298                           end.
      299                       end.
      300                   end.
      301               end.
      302           end.
      303           if v-menu-doc-item-disabled = yes
      304           then do:
      305               find first tmp#list
      306                    where tmp#list.blank-name     = param-5
      307                      and tmp#list.filtr          = param-6
      308                      and tmp#list.proc-name      = param-7
      309                      and tmp#list.proc-param     = param-8
      310                      and tmp#list.print-options  = param-9
      311                      and tmp#list.sys-key        = param-10
      312                      and tmp#list.orient         = param-11
      313                      and tmp#list.sys-key-black  = param-12
      314               no-error.
      315               if available tmp#list
      316               then do:
      317                   find first temp_menu-doc_disabled-doc-list
      318                        where temp_menu-doc_disabled-doc-list.doc-code     = v-menu-doc-doc-code
      319                          and temp_menu-doc_disabled-doc-list.blank-name   = param-5
      320                   no-error.
      321                   if not available temp_menu-doc_disabled-doc-list
      322                   then do:
      323                       create temp_menu-doc_disabled-doc-list.
      324                       assign
      325                           temp_menu-doc_disabled-doc-list.doc-code    = v-menu-doc-doc-code
      326                           temp_menu-doc_disabled-doc-list.blank-name  = param-5
      327                       .
      328                   end.
      329                   if param-1 <> '*':U
      330                   and lookup( p-type, param-1 ) > 0
      331                   then do:
      332                       assign
      333                           temp_menu-doc_disabled-doc-list.reason   = "type":U
      334                       .
      335                   end.
      336                   assign
      337                       temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + ",":U
      338                   .
      339                   if param-2 <> '*':U
      340                   and lookup( p-stat, param-2 ) > 0
      341                   then do:
      342                       assign
      343                           temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + "stat":U
      344                       .
      345                   end.
      346                   assign
      347                       temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + ",":U
      348                   .
      349                   if param-3 <> '*':U
      350                   and lookup( p-intr, param-3 ) > 0
      351                   then do:
      352                       assign
      353                           temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + "intr":U
      354                       .
      355                   end.
      356                   assign
      357                       temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + ",":U
      358                   .
      359                   if param-4 <> '*':U
      360                   and lookup( p-flag, param-4 ) > 0
      361                   then do:
      362                       assign
      363                           temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + "flag":U
      364                       .
      365                   end.
      366                   if v-menu-doc-sys-key = 'ExpertekIBS':U
      367                   then do:
      368                       run menu-doc-extend-blank-name-for-IBS in this-procedure (
      369                             input tmp#list.blank-name
      370                           , input tmp#list.sys-key
      371                           , input Tmp#List.sys-key-black
      372                           , output tmp#list.blank-name
      373                       ).
      374                   end.
      375               end.
      376               else do:
      377                   assign
      378                       v-menu-doc-item-disabled = no
      379                   .
      380               end.
      381           end.
      382           if v-menu-doc-item-disabled = no
      383           then do:
      384               find first tmp#list
      385                    where tmp#list.blank-name     = param-5
      386                      and tmp#list.filtr          = param-6
      387                      and tmp#list.proc-name      = param-7
      388                      and tmp#list.proc-param     = param-8
      389                      and tmp#list.print-options  = param-9
      390                      and tmp#list.sys-key        = param-10
      391                      and tmp#list.orient         = param-11
      392                      and tmp#list.sys-key-black  = param-12
      393               no-error.
      394               if available tmp#list
      395               then do:
      396                   find first temp_form-list
      397                        where temp_form-list.doc-code  = v-menu-doc-doc-code
      398                          and temp_form-list.id        = tmp#list.id
      399                   no-error.
      400                   if not available temp_form-list
      401                   then do:
      402                       create temp_form-list.
      403                       assign
      404                           temp_form-list.doc-code  = v-menu-doc-doc-code
      405                           temp_form-list.id        = tmp#list.id
      406                           temp_form-list.doc-type  = v-menu-doc-doc-type
      407                           temp_form-list.status_   = v-menu-doc-status_
      408                           temp_form-list.internal  = v-menu-doc-internal
      409                           temp_form-list.flag      = v-menu-doc-flag
      410                       .
      411                   end.
      412                   if v-menu-doc-sys-key = 'ExpertekIBS':U
      413                   then do:
      414                       run menu-doc-extend-blank-name-for-IBS in this-procedure (
      415                             input tmp#list.blank-name
      416                           , input tmp#list.sys-key
      417                           , input Tmp#List.sys-key-black
      418                           , output tmp#list.blank-name
      419                       ).
      420                   end.
      421               end.
      422           end.
      423       end.
      424       end procedure.
      425       procedure menu-doc-set-visible-options :
      426       define input parameter p-print-options          as character        no-undo.
      427       define output parameter p-type-parts-enabled    as logical          no-undo.
      428       define output parameter p-type-price-enabled    as logical          no-undo.
      429       define output parameter p-type-scale-enabled    as logical          no-undo.
      430       define output parameter p-type-val-enabled      as logical          no-undo.
      431       define output parameter p-sort-name-enabled     as logical          no-undo.
      432       define output parameter p-sort-gr-enabled       as logical          no-undo.
      433       define output parameter p-print-graft-enabled   as logical          no-undo.
      434       define output parameter p-no-vat-enabled        as logical          no-undo.
      435       do
      436       on error undo, return error
      437       :
      438           assign
      439               p-type-parts-enabled    = ( if substring( p-print-options, 1, 1 ) = "+" then yes else no )
      440               p-type-price-enabled    = ( if substring( p-print-options, 2, 1 ) = "+" then yes else no )
      441               p-type-scale-enabled    = ( if substring( p-print-options, 3, 1 ) = "+" then yes else no )
      442               p-type-val-enabled      = ( if substring( p-print-options, 4, 1 ) = "+" then yes else no )
      443               p-sort-name-enabled     = ( if substring( p-print-options, 5, 1 ) = "+" then yes else no )
      444               p-sort-gr-enabled       = ( if substring( p-print-options, 6, 1 ) = "+" then yes else no )
      445               p-print-graft-enabled   = ( if substring( p-print-options, 7, 1 ) = "+" then yes else no )
      446               p-no-vat-enabled        = ( if substring( p-print-options, 8, 1 ) = "+" then yes else no )
      447           .
      448       end.
      449       end procedure.
      450       procedure menu-doc-create-options-string :
      451       define input parameter p-tmp-list-id        as integer          no-undo.
      452       define output parameter p-options-string    as character        no-undo.
      453           define buffer buf_tmp#list      for tmp#list.
      454       do
      455       for buf_tmp#list
      456       on error undo, return error
      457       :
      458           find first buf_tmp#list
      459                where buf_tmp#list.id = p-tmp-list-id
      460           .
      461           assign
      462               p-options-string =  ( if trim( buf_tmp#list.type-parts  ) = "+":U then "+":U else "-":U )
      463                                 + ( if trim( buf_tmp#list.type-price  ) = "+":U then "+":U else "-":U )
      464                                 + ( if trim( buf_tmp#list.type-scale  ) = "+":U then "+":U else "-":U )
      465                                 + ( if trim( buf_tmp#list.type-val    ) = "+":U then "+":U else "-":U )
      466                                 + ( if trim( buf_tmp#list.sort-name   ) = "+":U then "+":U else "-":U )
      467                                 + ( if trim( buf_tmp#list.sort-gr     ) = "+":U then "+":U else "-":U )
      468                                 + ( if trim( buf_tmp#list.print-graft ) = "+":U then "+":U else "-":U )
      469                                 + ( if trim( buf_tmp#list.no-vat      ) = "+":U then "+":U else "-":U )
      470           .
      471       end.
      472       end procedure.
      473       procedure menu-doc-set-options-string :
      474       define input parameter p-tmp-list-id            as integer          no-undo.
      475       define input parameter p-options-string         as character        no-undo.
      476           define buffer buf_tmp#list      for tmp#list.
      477       do
      478       for buf_tmp#list
      479       on error undo, return error
      480       :
      481           find first buf_tmp#list
      482                where buf_tmp#list.id = p-tmp-list-id
      483           .
      484           assign
      485               buf_tmp#list.type-parts  = ( if buf_tmp#list.type-parts-enabled     = yes then substitute( "  &1", substring( p-options-string, 1, 1 ) ) else " ":U )
      486               buf_tmp#list.type-price  = ( if buf_tmp#list.type-price-enabled     = yes then substitute( "  &1", substring( p-options-string, 2, 1 ) ) else " ":U )
      487               buf_tmp#list.type-scale  = ( if buf_tmp#list.type-scale-enabled     = yes then substitute( "  &1", substring( p-options-string, 3, 1 ) ) else " ":U )
      488               buf_tmp#list.type-val    = ( if buf_tmp#list.type-val-enabled       = yes then substitute( "  &1", substring( p-options-string, 4, 1 ) ) else " ":U )
      489               buf_tmp#list.sort-name   = ( if buf_tmp#list.sort-name-enabled      = yes then substitute( "  &1", substring( p-options-string, 5, 1 ) ) else " ":U )
      490               buf_tmp#list.sort-gr     = ( if buf_tmp#list.sort-gr-enabled        = yes then substitute( "  &1", substring( p-options-string, 6, 1 ) ) else " ":U )
      491               buf_tmp#list.print-graft = ( if buf_tmp#list.print-graft-enabled    = yes then substitute( "  &1", substring( p-options-string, 7, 1 ) ) else " ":U )
      492               buf_tmp#list.no-vat      = ( if buf_tmp#list.no-vat-enabled         = yes then substitute( "  &1", substring( p-options-string, 8, 1 ) ) else " ":U )
      493           .
      494       end.
      495       end procedure.
      496       procedure menu-doc-create-options-enabled-string :
      497       define input parameter p-tmp-list-id                as integer          no-undo.
      498       define output parameter p-options-enabled-string    as character        no-undo.
      499           define buffer buf_tmp#list      for tmp#list.
      500       do
      501       for buf_tmp#list
      502       on error undo, return error
      503       :
      504           find first buf_tmp#list
      505                where buf_tmp#list.id = p-tmp-list-id
      506           .
      507           assign
      508               p-options-enabled-string =  ( if buf_tmp#list.type-parts-enabled  = yes then "+":U else "-":U )
      509                                         + ( if buf_tmp#list.type-price-enabled  = yes then "+":U else "-":U )
      510                                         + ( if buf_tmp#list.type-scale-enabled  = yes then "+":U else "-":U )
      511                                         + ( if buf_tmp#list.type-val-enabled    = yes then "+":U else "-":U )
      512                                         + ( if buf_tmp#list.sort-name-enabled   = yes then "+":U else "-":U )
      513                                         + ( if buf_tmp#list.sort-gr-enabled     = yes then "+":U else "-":U )
      514                                         + ( if buf_tmp#list.print-graft-enabled = yes then "+":U else "-":U )
      515                                         + ( if buf_tmp#list.no-vat-enabled      = yes then "+":U else "-":U )
      516           .
      517       end.
      518       end procedure.
      519       procedure menu-doc-extend-blank-name-for-IBS :
      520       define input parameter p-in-blank-name      as character        no-undo.
      521       define input parameter p-sys-key            as character        no-undo.
      522       define input parameter p-sys-key-black      as character        no-undo.
      523       define output parameter p-out-blank-name    as character        no-undo.
      524       do
      525       on error undo, return error
      526       :
      527           assign
      528               p-out-blank-name = p-in-blank-name
      529           .
      530           if p-sys-key <> "":U
      531           then do:
      532               assign
      533                   p-out-blank-name = substring( p-in-blank-name + " '" + p-sys-key + "'" , 1, 120 )
      534               .
      535           end.
      536           if p-sys-key-black <> ""
      537           then do:
      538               assign
      539                   p-out-blank-name = substring( p-in-blank-name + " no-'" + p-sys-key-black + "'", 1, 120 )
      540               .
      541           end.
      542       end.
      543       end procedure.
      544   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      545     define variable v-cntxt-db-num        as integer   no-undo .
