      549     define variable v-cntxt-obj-type      as character no-undo .
      550     define variable v-cntxt-obj-code      as integer   no-undo .
      551     define variable v-cntxt-db-num-obj    as integer   no-undo .
      552     define variable v-cntxt-is-admin      as logical   no-undo .
      553   procedure proc-alt-shift-f2:
      554     if not ibs.th.gbl.gbl-var:rcode
      555   then
      556     run gbl\inidebug.p .
      557   end.
      558   procedure proc-alt-shift-f3:
      559     run gbl/prvssinf.p
      560       ( input this-procedure
      561       ) .
      562   end.
      563   define variable v-inform-launched as logical no-undo initial false .
      564   procedure proc-alt-shift-f4:
      565     define variable v-action as character no-undo .
      566     if v-inform-launched = false then do:
      567       assign
      568         v-inform-launched = true
      569       .
      570       run gbl/d-inform.w
      571         (  input self
      572         ,  input this-procedure
      573         , output v-action
      574         ) no-error .
      575       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      576       assign
      577         v-inform-launched = false
      578       .
      579     end.
      580   end.
      581   procedure proc-alt-f1:
      582     run gbl/corrhelp.p
      583       (input this-procedure
      584       ) .
      585   end .
      586   on alt-shift-f2 anywhere do:
      587     run proc-alt-shift-f2.
      588   end.
      589   on alt-shift-f3 anywhere do:
      590     run proc-alt-shift-f3 in this-procedure .
      591   end.
      592   on alt-shift-f4 anywhere do:
      593     run proc-alt-shift-f4 in this-procedure.
      594   end.
      595   on alt-f1 anywhere do:
      596     run proc-alt-f1 in this-procedure .
      597   end.
      598   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      599   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      600   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      601   define variable par-type          as character no-undo.
      602   define variable v-value-character as character no-undo .
      603   define variable v-value-date      as date      no-undo .
      604   define variable v-value-decimal   as decimal   no-undo .
      605   define variable v-value-integer   as integer   no-undo .
      606   define variable v-value-logical   as logical   no-undo .
      607   define variable ii as int no-undo .
      608   define variable Nesoot_Flag  as logical  no-undo .
      609   define variable stat                 as logical  no-undo .
      610   define variable in-docprvalue as character no-undo.
      611   define variable in-docprtype  as character no-undo.
      612   define variable v-list_  as character no-undo.
      613   define variable sys-key as char no-undo.
      614   define variable g#report-num    as integer      no-undo.
      615   define variable g#quest-print   as logical      no-undo.
      616   define variable g#log           as logical      no-undo.
