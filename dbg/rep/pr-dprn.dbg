      620   DEFINE NEW SHARED BUFFER clients FOR ub.clients.
      621   define buffer buf_usr-flt for ubflt.usr-flt .
      622   DEFINE BUTTON b-erase
      623        LABEL "&Снять все *":L
      624        size 13.13 by 1.1 TOOLTIP "Снять все отметки"
      625        BGCOLOR 8 .
      626   DEFINE BUTTON b-exit AUTO-END-KEY
      627        LABEL "&Выход ":L
      628        size 10 by 1.1
      629        BGCOLOR 8 .
      630   DEFINE BUTTON b-help
      631        LABEL "&Помощь":L
      632        size 10 by 1
      633        BGCOLOR 8 .
      634   DEFINE BUTTON b-mark
      635        LABEL "&*":L
      636        size 3.63 by 1.1
      637        BGCOLOR 8 .
      638   DEFINE BUTTON b-print-doc
      639        LABEL ".   Пе&чать":L
      640        size 13.50 by 1.1
      641        BGCOLOR 8 .
      642   DEFINE BUTTON i-print
      643        IMAGE-UP FILE "cmp/b-print.bmp":U
      644        IMAGE-DOWN FILE "cmp/b-print.bmp":U
      645        IMAGE-INSENSITIVE FILE "cmp/b-print.bmp":U
      646        LABEL ""
      647        SIZE 4 BY .90.
      648   DEFINE VARIABLE v-printer-name AS CHARACTER FORMAT "X(256)":U
      649        LABEL "Текущий принтер"
      650         VIEW-AS TEXT
      651        SIZE 47 BY .67
      652        FGCOLOR 4  NO-UNDO.
      653   DEFINE VARIABLE rs-price-selection AS INTEGER
      654        VIEW-AS RADIO-SET VERTICAL
      655        RADIO-BUTTONS
      656             "Старая и новая цена; процент разницы", 1,
      657   "Учетная и новая цена; процент наценки", 2
      658        SIZE 41.25 BY 1.67 NO-UNDO.
      659   DEFINE RECTANGLE RECT-1
      660        edge-chars 0.25 GRAPHIC-EDGE  NO-FILL
      661        SIZE 64.25 BY 2.13.
      662   DEFINE VARIABLE tg-print-zero AS LOGICAL INITIAL no
      663        LABEL "С нулевыми"
      664        VIEW-AS TOGGLE-BOX
      665        SIZE 16.63 BY .83 NO-UNDO.
      666   DEFINE VARIABLE tg-sort-by-group AS LOGICAL INITIAL no
      667        LABEL "По группам"
      668        VIEW-AS TOGGLE-BOX
      669        SIZE 17.38 BY .83 NO-UNDO.
      670   DEFINE QUERY BROWSE-2 FOR
      671         Tmp#List SCROLLING.
      672   DEFINE BROWSE BROWSE-2
      673     QUERY BROWSE-2 DISPLAY
      674         Tmp#List.last-use COLUMN-LABEL "*" FORMAT "*/"
      675         Tmp#List.blank-name COLUMN-LABEL "Название документа":C59 FORMAT "X(59)"
      676     ENABLE
      677         Tmp#List.last-use
      678       WITH NO-BOX NO-ROW-MARKERS SEPARATORS SIZE 64 BY 15.46.
      679   DEFINE FRAME Dialog-Frame
      680        b-exit at row 1.08 col 2.13
      681        b-mark at row 1.08 col 12.13
      682        b-erase at row 1.08 col 15.88
      683        b-print-doc at row 1.08 col 29.50
      684        i-print AT ROW 1.13 COL 30.13 NO-TAB-STOP
      685        b-help at row 1.08 col 55.63
      686        BROWSE-2 AT ROW 2.25 COL 1.75
      687        tg-print-zero AT ROW 18.92 COL 44.88
      688        rs-price-selection AT ROW 19 COL 2.63 NO-LABEL
      689        tg-sort-by-group AT ROW 19.83 COL 44.88
      690        v-printer-name AT ROW 17.96 COL 16.88 COLON-ALIGNED
      691        RECT-1 AT ROW 18.75 COL 1.63
      692        SPACE(0.74) SKIP(0.24)
      693       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      694            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      695            TITLE "".
      696   ASSIGN
      697          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      698          FRAME Dialog-Frame:HIDDEN           = TRUE.
      699   ASSIGN
      700          BROWSE-2:MAX-DATA-GUESS IN FRAME Dialog-Frame     = 200.
      701   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      702   DO:
      703     APPLY "END-ERROR":U TO SELF.
      704   END.
      705   ON ROW-DISPLAY OF BROWSE-2 IN FRAME Dialog-Frame
      706   DO:
      707   if Tmp#List.orient = 'A4port' OR
      708      Tmp#List.orient = 'A3port'
      709        then DO:
      710         Tmp#List.last-use          :fgcolor in browse BROWSE-2 = blue_color.
      711         Tmp#List.blank-name        :fgcolor in browse BROWSE-2 = blue_color.
      712     End.
      713     Else DO:
      714         if Tmp#List.orient = 'EXCEL' OR
      715           Tmp#List.orient = 'self'
      716             then DO:
      717                 Tmp#List.last-use   :fgcolor in browse BROWSE-2 = CYAN_COLOR.
      718                 Tmp#List.blank-name :fgcolor in browse BROWSE-2 = CYAN_COLOR.
      719             end.
      720             Else DO:
      721                 Tmp#List.last-use   :fgcolor in browse BROWSE-2 = black_color.
      722                 Tmp#List.blank-name :fgcolor in browse BROWSE-2 = black_color.
      723             End.
      724     End.
      725   END.
      726   ON CHOOSE OF b-erase IN FRAME Dialog-Frame
      727   DO:
      728     For each Tmp#List share-lock :
      729         Tmp#List.last-use=false.
      730     End.
      731       OPEN QUERY BROWSE-2 FOR EACH Tmp#List NO-LOCK where     Tmp#List.view_ <> 0     BY Tmp#List.cli-code.
      732   END.
      733   ON CHOOSE OF i-print IN FRAME Dialog-Frame
      734   DO:
      735     APPLY "choose" TO b-print-doc.
      736   END.
      737   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
      738   OR MOUSE-SELECT-DBLCLICK OF BROWSE-2 IN FRAME Dialog-Frame
      739   DO:
      740       if not available tmp#list
      741       then do:
      742           message "Неправильный выбор строки.".
      743           return no-apply.
      744       end.
      745       BROWSE-2 :refresh ().
      746       if tmp#list.last-use = true
      747       then do:
      748           assign
      749               tmp#list.last-use = false
      750           .
      751           display
      752               "" @ tmp#list.last-use
      753           with browse BROWSE-2.
      754       end.
      755       else do:
      756           assign
      757               tmp#list.last-use = true
      758           .
      759           display
      760               "*" @ tmp#list.last-use
      761           with browse BROWSE-2.
      762       end.
      763       apply "VALUE-CHANGED" to BROWSE-2 in frame Dialog-Frame.
      764       assign
      765           g#log = BROWSE-2:select-next-row ()
      766       .
      767   END.
      768   ON CHOOSE OF b-print-doc IN FRAME Dialog-Frame
      769   DO:
      770       define variable lok as logical no-undo .
      771       define variable         PrintDoc              as      logical no-undo .
      772       define variable         PrintSet              as      logical no-undo .
      773       define variable         Print-Round           AS      LOGICAL INITIAL yes no-undo .
      774       define variable l-recid as recid no-undo .
      775       Assign
      776           v-list_ = ''
      777           ii      = 0
      778           l-recid = recid(Tmp#List)
      779       .
      780       For each Tmp#List share-lock
      781       :
      782           if Tmp#List.last-use <> false
      783           then Assign
      784               ii      = ii + 1
      785               v-list_ = v-list_ + ',' + string(tmp#list.id)
      786           .
      787       End.
      788       if ii = 0 then DO :
      789           Message "Отметьте формы документа для печати!" view-as alert-box INFORMATION title "Внимание !".
      790           find first Tmp#List where l-recid = recid(Tmp#List) no-lock  .
      791           return no-apply.
      792           End.
      793   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      794   empty temp-table thbjattr_thbj-attr.
      795   run adm/shattri.p (
      796      input "get":U
      797     ,input v-cntxt-obj-type
      798     ,input v-cntxt-obj-code
      799     ,input 'prt-obj':U
      800     ,input  ""
      801     ,output v-value-character
      802     ,output v-value-date
      803     ,output v-value-decimal
      804     ,output v-value-integer
      805     ,output v-value-logical
      806     ,output par-type
      807     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      808     ) no-error .
      809   for each thbjattr_thbj-attr :
      810       if thbjattr_thbj-attr.prop-code = 'in-docpr' then in-docprvalue =  thbjattr_thbj-attr.property-value-character .
      811   end.
      812       find first buf_usr-flt exclusive-lock
      813            where buf_usr-flt.user-name   = v-cntxt-userid
      814              and buf_usr-flt.call-point  = substitute( "&1,&2"
      815                                                   , 'переоценка':U
      816                                                   , ub.price-doc.status_   )
      817       no-error .
      818       if available buf_usr-flt
      819       then do:
      820           assign
      821               buf_usr-flt.type-price  = ( if rs-price-selection = 1 then yes else no )
      822               buf_usr-flt.type-val    = tg-print-zero
      823               buf_usr-flt.sort-gr     = tg-sort-by-group
      824           .
      825           assign
      826               buf_usr-flt.list_ = "":U
      827           .
      828           for each tmp#list
      829              where tmp#list.last-use = yes
      830           :
      831               assign
      832                   buf_usr-flt.list_  = substitute(  "&1&2&3":U
      833                                           , buf_usr-flt.list_
      834                                           , ( if buf_usr-flt.list_ = "":U then "":U else ",":U )
      835                                           , tmp#list.id
      836                                       )
      837               .
      838           end.
      839       end.
      840       else do:
      841           create  buf_usr-flt .
      842           assign
      843               buf_usr-flt.user-name  = v-cntxt-userid
      844               buf_usr-flt.call-point = substitute( "&1,&2":U
      845                                               , 'переоценка':U
      846                                               , ub.price-doc.status_   )
      847               rs-price-selection    = 1
      848               tg-print-zero         = no
      849               tg-sort-by-group      = no
      850           .
      851           assign
      852               buf_usr-flt.list_ = "":U
      853           .
      854           for each tmp#list
      855               where tmp#list.last-use = yes
      856           :
      857               assign
      858                   buf_usr-flt.list_  = substitute(  "&1&2&3":U
      859                                           , buf_usr-flt.list_
      860                                           , ( if buf_usr-flt.list_ = "":U then "":U else ",":U )
      861                                           , tmp#list.id
      862                                       )
      863               .
      864           end.
      865       end.
      866       if g#quest-print = true
      867       then do:
      868           output  to value( string( session:temp-directory + "$" + string( g#report-num ) ) ) .
      869           OUTPUT CLOSE.
      870       End.
      871     for each Tmp#List no-lock
      872        where Tmp#List.last-use = true
      873     :
      874           case num-entries(tmp#list.proc-param)
      875           :
      876               when 0
      877               then do:
      878                   run value (tmp#list.proc-name)  (
      879                         input p-mainmenu-handle
      880                       , input rec_id
      881                       , input rs-price-selection
      882                       , input tg-print-zero
      883                       , input tg-sort-by-group
      884                   ).
      885               end.
      886               when 1
      887               then do:
      888                   run value (tmp#list.proc-name)  (
      889                         input p-mainmenu-handle
      890                       , input rec_id
      891                       , input tmp#list.proc-param
      892                       , input rs-price-selection
      893                       , input tg-print-zero
      894                       , input tg-sort-by-group
      895                   ).
      896               end.
      897               when 2
      898               then do:
      899                   run value (tmp#list.proc-name)  (
      900                         input p-mainmenu-handle
      901                       , input rec_id
      902                       , input entry(1,tmp#list.proc-param)
      903                       , input entry(2,tmp#list.proc-param)
      904                       , input rs-price-selection
      905                       , input tg-print-zero
      906                       , input tg-sort-by-group
      907                   ).
      908               end.
      909               when 4
      910               then do:
      911                   message
      912                   "Для документа производства число параметров не может быть больше 3"
      913                   view-as alert-box.
      914                   undo, return no-apply .
      915               end.
      916           end case.
      917       end.
      918   if session :set-wait-state( "" ) then.
      919     if  g#quest-print = true  Then do:
      920           OS-DELETE
      921              value( string( session:temp-directory) + "rpt" + string( g#report-num )  )    .
      922            OS-RENAME
      923              value(  string( session:temp-directory) + "$" + string( g#report-num )     )
      924              value(  string( session:temp-directory) + "rpt" + string( g#report-num )) .
      925            IF ii = 1 and
      926               ((can-find (first tmp#list where CAPS(Tmp#list.proc-name) = "rep/xl-prtcl.p":U and Tmp#List.last-use = true) = true  ) OR
      927                (can-find (first tmp#list where CAPS(Tmp#list.proc-name) = "rep/tick-doc.p":U and Tmp#List.last-use = true) = true  ))
      928                THEN do:
      929   if session :set-wait-state( "" ) then.
      930                end.
      931                ELSE DO :
      932                 find first tmp#list where  Tmp#List.last-use = true no-lock no-error .
      933                 case Tmp#list.orient :
      934                     when 'A4port' then do:
      935                           DisabledOptions = 4 .
      936                     end.
      937                     when 'A4lans' or when "" then do:
      938                         DisabledOptions = 8 .
      939                     end.
      940                 End case.
      941                 if Tmp#list.orient <> "HTML":U then
      942                 run gbl/prnfilen.w
      943                   (input  ""
      944                   ,input  DisabledOptions
      945                   ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
      946                   ,input 7
      947                   ,output v-user-action
      948                   ,output v-printed
      949                   ) .
      950                End.
      951         End.
      952      Else  Message 'Задание распечатано'.
      953   END.
      954   ON VALUE-CHANGED OF rs-price-selection IN FRAME Dialog-Frame
      955   OR VALUE-CHANGED OF tg-print-zero IN FRAME Dialog-Frame
      956   OR VALUE-CHANGED OF tg-sort-by-group IN FRAME Dialog-Frame
      957   DO:
      958       assign
      959           rs-price-selection
      960           tg-print-zero
      961           tg-sort-by-group
      962       .
      963   END.
      964     For each tmp#list share-lock:
      965         if lookup(string(tmp#list.id), list_) > 0
      966         then tmp#list.last-use = true .
      967         tmp#list.view_ = 1 .
      968         if sys-key <> 'ExpertekIBS':U then DO:
      969             if sys-key <> tmp#list.sys-key  and tmp#list.sys-key <> ''
      970                        THEN  Assign tmp#list.view_ = 0   tmp#list.last-use = false.
      971         End.
      972         if     tmp#list.proc-name = '' Then  Assign tmp#list.view_ = 0   tmp#list.last-use = false.
      973     End.
      974     OPEN QUERY BROWSE-2 FOR EACH Tmp#List NO-LOCK where     Tmp#List.view_ <> 0     BY Tmp#List.cli-code.
      975     apply "VALUE-CHANGED" TO BROWSE-2 IN FRAME Dialog-Frame.
      976     apply "entry" TO BROWSE-2 IN FRAME Dialog-Frame.
      977   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      978   on help of frame Dialog-Frame
      979   do:
      980     run gbl/app_help.p
      981       (input this-procedure :file-name
      982       ,input ''
      983       ,input ?
      984       ) no-error.
      985     if error-status :error then do:
      986       message
      987         "Ошибка при вызове помощи"
      988         error-status :get-message(1)
      989         view-as alert-box .
      990     end.
      991   end.
      992   run minbtn-set in this-procedure .
      993   on choose of b-help in frame Dialog-Frame
      994   do:
      995     apply "help":u to frame Dialog-Frame .
      996   end.
      997   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      998   procedure minbtn-set :
      999       do
     1000           on error undo, return error return-value
     1001           :
     1002           define variable ii              as integer       no-undo .
     1003           define variable fh              as widget-handle no-undo .
     1004           define variable hh              as widget-handle no-undo .
     1005           define variable v-h             as handle        extent 4 no-undo .
     1006           define variable v-name-button   as character     no-undo .
     1007           define variable v-help-old-x    as decimal       no-undo .
     1008           define variable v-help-old-y    as decimal       no-undo .
     1009           define variable v-help-old-size as decimal       no-undo .
     1010           define variable v-frame-width   as decimal       no-undo .
     1011           define variable jj              as integer       no-undo .
     1012           do
     1013               on error undo, return error
     1014               :
     1015               assign
     1016                   v-frame-width = frame Dialog-Frame:width - 0.3
     1017                   fh            = frame Dialog-Frame:first-child
     1018                   hh            = fh:first-child
     1019                   ii            = 1
     1020                   .
     1021               do while valid-handle(hh):
     1022                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1023                   do:
     1024                       case lc(hh:name) :
     1025                           when "b-help" then
     1026                               do:
     1027                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1028                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1029                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1030                                   hh:TOOLTIP = "Помощь" .
     1031                                   v-help-old-x = hh:column .
     1032                                   v-help-old-y = hh:row    .
     1033                                   v-help-old-size = hh:width .
     1034                                   hh:width-chars = 2.5 .
     1035                               end.
     1036                           when "b-print" then
     1037                               do:
     1038                                   hh:load-image("cmp/b-print.bmp":u) .
     1039                                   hh:TOOLTIP = "Печать" .
     1040                                   v-h[ii] = hh:handle .
     1041                                   ii = ii + 1 .
     1042                                   hh:width-chars = 3 .
     1043                               end.
     1044                           when "b-history" or
     1045                           when "b-hist" then
     1046                               do:
     1047                                   hh:load-image("cmp/b-hist.bmp":u) .
     1048                                   hh:TOOLTIP = "История" .
     1049                                   v-h[ii] = hh:handle .
     1050                                   ii = ii + 1 .
     1051                                   hh:width-chars = 3 .
     1052                               end.
     1053                           when "b-sch" then
     1054                               do:
     1055                                   hh:load-image("cmp/b-sch.bmp":u) .
     1056                                   hh:TOOLTIP = "Установка Фильтра" .
     1057                                   v-h[ii] = hh:handle .
     1058                                   ii = ii + 1 .
     1059                                   hh:width-chars = 3 .
     1060                               end.
     1061                           when "b-hist-user" then
     1062                               do:
     1063                                   hh:load-image("cmp/b-hist.bmp":u) .
     1064                                   hh:TOOLTIP = "История пользователя" .
     1065                                   ii = ii + 1 .
     1066                               end.
     1067                       end case.
     1068                   end.
     1069                   hh = hh:next-sibling.
     1070               end.
     1071               b-help:column = v-frame-width - b-help:width-chars.
     1072               jj = 0.
     1073               repeat ii = 4 to 1 by -1 :
     1074                   if valid-handle (v-h[ii] ) then
     1075                   do:
     1076                       jj  = jj + 1 .
     1077                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1078                       v-h[ii]:row    = v-help-old-y .
     1079                   end.
     1080               end.
     1081           end.
     1082       end.
     1083   end procedure.
     1084   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1085   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1086   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1087   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1088   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1089   define variable v-diasize-current-frame-height as decimal   no-undo .
     1090   define variable v-diasize-change-size          as logical   no-undo .
     1091   define variable v-diasize-resize-button        as handle    no-undo .
     1092   define variable v-diasize-wndmax               as logical   no-undo .
     1093   define variable v-diasize-wndstore             as logical   no-undo .
     1094   define variable v-diasize-proc-name            as character no-undo .
     1095   define variable v-diasize-browse-handle        as handle    no-undo .
     1096   define variable v-diasize-browse-number        as integer   no-undo .
     1097   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1098   define temp-table temp-diasize-handle no-undo
     1099     field handle-value  as handle
     1100     field save-position as decimal
     1101     index xpk is primary unique handle-value
     1102     .
     1103   define temp-table temp-browse-handle no-undo
     1104     field browse-type   as character
     1105     field browse-number as integer
     1106     field browse-handle as handle
     1107     field original-size as decimal
     1108     index xpk is primary unique browse-type browse-number
     1109     index xie browse-type browse-handle
     1110   .
     1111   procedure diasize_change-height :
     1112     define input  parameter p-change-value  as decimal   no-undo .
     1113     define input  parameter p-move-resize   as logical   no-undo .
     1114     define variable v-field-group-handle    as handle    no-undo .
     1115     define variable v-object-handle         as handle    no-undo .
     1116     define variable v-frame-height          as decimal   no-undo .
     1117     define variable v-frame-virtual-height  as decimal   no-undo .
     1118     define variable v-browse-height         as decimal   no-undo .
     1119     define variable v-window-height         as decimal   no-undo .
     1120     define variable v-window-virtual-height as decimal   no-undo .
     1121     define variable v-change-sign           as integer   no-undo .
     1122     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1123     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1124     if p-change-value > 0
     1125     then do:
     1126       if frame Dialog-Frame :height + p-change-value
     1127           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1128       then do:
     1129         assign
     1130           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1131                           - (frame Dialog-Frame :height-chars)
     1132         .
     1133         if p-change-value <= 0
     1134         then do:
     1135           run diasize_position-resize-button in this-procedure .
     1136           return .
     1137         end.
     1138       end.
     1139     end.
     1140     if p-change-value < 0
     1141     then do:
     1142       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1143       then do:
     1144         assign
     1145           p-change-value = v-diasize-orig-frame-height
     1146                          - (frame Dialog-Frame :height-chars)
     1147         .
     1148         if p-change-value >= 0
     1149         then do:
     1150           run diasize_position-resize-button in this-procedure .
     1151           return .
     1152         end.
     1153       end.
     1154     end.
     1155     if p-change-value >= 0
     1156     then do:
     1157       assign
     1158         v-change-sign = 1
     1159       .
     1160     end.
     1161     else do:
     1162       assign
     1163         v-change-sign = -1
     1164       .
     1165     end.
     1166     assign
     1167       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1168     .
     1169     if p-change-value = 0
     1170     then do:
     1171       run diasize_position-resize-button in this-procedure .
     1172       return .
     1173     end.
     1174     move_block:
     1175     do
     1176     on error undo move_block, retry move_block
     1177     :
     1178       if retry
     1179       then do:
     1180         do
     1181         on error undo move_block, leave move_block
     1182         :
     1183           if p-change-value > 0
     1184           then do:
     1185             for each buf_temp-diasize-handle
     1186             on error undo, next
     1187             :
     1188               assign
     1189                 v-object-handle = buf_temp-diasize-handle.handle-value
     1190               .
     1191               if v-object-handle <> v-diasize-resize-button
     1192               then do:
     1193                 assign
     1194                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1195                 .
     1196               end.
     1197             end.
     1198             assign
     1199               v-diasize-browse-handle :height = v-browse-height
     1200             .
     1201             for each buf_temp-browse-handle
     1202               where buf_temp-browse-handle.browse-type = 'height':u
     1203             on error undo, next
     1204             :
     1205               assign
     1206                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1207               .
     1208             end.
     1209             assign
     1210               frame Dialog-Frame :height = v-frame-height
     1211             .
     1212             if frame Dialog-Frame :scrollable = true
     1213             then do:
     1214               assign
     1215                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1216               .
     1217             end.
     1218             run diasize_position-resize-button in this-procedure .
     1219           end.
     1220           else do:
     1221             if frame Dialog-Frame :scrollable = true
     1222             then do:
     1223               assign
     1224                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1225               .
     1226             end.
     1227             assign
     1228               frame Dialog-Frame :height = v-frame-height
     1229             .
     1230             assign
     1231               v-diasize-browse-handle :height = v-browse-height
     1232             .
     1233             for each buf_temp-browse-handle
     1234               where buf_temp-browse-handle.browse-type = 'height':u
     1235             on error undo, next
     1236             :
     1237               assign
     1238                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1239               .
     1240             end.
     1241             for each buf_temp-diasize-handle
     1242             on error undo, next
     1243             :
     1244               assign
     1245                 v-object-handle = buf_temp-diasize-handle.handle-value
     1246               .
     1247               if v-object-handle <> v-diasize-resize-button
     1248               then do:
     1249                 assign
     1250                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1251                 .
     1252               end.
     1253             end.
     1254             run diasize_position-resize-button in this-procedure .
     1255           end.
     1256           assign
     1257             v-diasize-change-size = false
     1258           .
     1259           leave move_block .
     1260         end.
     1261       end.
     1262       assign
     1263         v-diasize-need-full-display = true
     1264       .
     1265       if v-diasize-change-size = false
     1266       then do:
     1267         assign
     1268           v-diasize-change-size = true
     1269         .
     1270       end.
     1271       else do:
     1272         return .
     1273       end.
     1274       assign
     1275         v-frame-height = frame Dialog-Frame :height
     1276         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1277         v-browse-height = v-diasize-browse-handle :height
     1278       .
     1279       for each buf_temp-browse-handle
     1280         where buf_temp-browse-handle.browse-type = 'height':u
     1281       :
     1282         assign
     1283           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1284         .
     1285       end.
     1286       for each buf_temp-diasize-handle
     1287       :
     1288         delete buf_temp-diasize-handle .
     1289       end.
     1290       assign
     1291         v-field-group-handle = frame Dialog-Frame :first-child
     1292       .
     1293       do while valid-handle(v-field-group-handle)
     1294       :
     1295         assign
     1296           v-object-handle = v-field-group-handle :first-child
     1297         .
     1298         do while valid-handle(v-object-handle)
     1299         :
     1300           if  v-object-handle <> v-diasize-browse-handle :handle
     1301           and can-query(v-object-handle, "row")
     1302           and can-query(v-object-handle, "height")
     1303           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1304           then do:
     1305             find first buf_temp-browse-handle
     1306               where buf_temp-browse-handle.browse-type   = 'height':u
     1307                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1308               no-error .
     1309             if available buf_temp-browse-handle
     1310             then do:
     1311             end.
     1312             else do:
     1313               create buf_temp-diasize-handle .
     1314               assign
     1315                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1316                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1317               .
     1318             end.
     1319           end.
     1320           assign
     1321             v-object-handle = v-object-handle :next-sibling
     1322           .
     1323         end.
     1324         assign
     1325           v-field-group-handle = v-field-group-handle :next-sibling
     1326         .
     1327       end.
     1328       do with frame Dialog-Frame
     1329       :
     1330         hide v-diasize-resize-button .
     1331         assign
     1332           v-diasize-resize-button :row    = 1
     1333           v-diasize-resize-button :column = 1
     1334         .
     1335       end.
     1336       if p-change-value > 0
     1337       then do:
     1338         if frame Dialog-Frame :scrollable = true
     1339         then do:
     1340           assign
     1341             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1342             no-error .
     1343           if error-status :error
     1344           or error-status :get-message(1) <> ""
     1345           then do:
     1346             undo move_block, retry move_block .
     1347           end.
     1348         end.
     1349         assign
     1350           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1351           no-error .
     1352         if error-status :error
     1353         or error-status :get-message(1) <> ""
     1354         then do:
     1355           undo move_block, retry move_block .
     1356         end.
     1357         assign
     1358           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1359           no-error .
     1360         if error-status :error
     1361         or error-status :get-message(1) <> ""
     1362         then do:
     1363           undo move_block, retry move_block .
     1364         end.
     1365         for each buf_temp-browse-handle
     1366           where buf_temp-browse-handle.browse-type = 'height':u
     1367         on error undo move_block, retry move_block
     1368         :
     1369           assign
     1370             buf_temp-browse-handle.browse-handle :height
     1371               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1372             no-error .
     1373           if error-status :error
     1374           or error-status :get-message(1) <> ""
     1375           then do:
     1376             undo move_block, retry move_block .
     1377           end.
     1378         end.
     1379         for each buf_temp-diasize-handle
     1380         on error undo move_block, retry move_block
     1381         :
     1382           assign
     1383             v-object-handle = buf_temp-diasize-handle.handle-value
     1384           .
     1385           if v-object-handle <> v-diasize-resize-button
     1386           then do:
     1387             assign
     1388               v-object-handle :row = v-object-handle :row + p-change-value
     1389               no-error .
     1390             if error-status :error
     1391             or error-status :get-message(1) <> ""
     1392             then do:
     1393               undo move_block, retry move_block .
     1394             end.
     1395           end.
     1396         end.
     1397       end.
     1398       else do:
     1399         for each buf_temp-diasize-handle
     1400         on error undo move_block, retry move_block
     1401         :
     1402           assign
     1403             v-object-handle = buf_temp-diasize-handle.handle-value
     1404           .
     1405           if v-object-handle <> v-diasize-resize-button
     1406           then do:
     1407             assign
     1408               v-object-handle :row = v-object-handle :row + p-change-value
     1409               no-error .
     1410             if error-status :error
     1411             or error-status :get-message(1) <> ""
     1412             then do:
     1413               undo move_block, retry move_block .
     1414             end.
     1415           end.
     1416         end.
     1417         assign
     1418           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1419           no-error .
     1420         if error-status :error
     1421         or error-status :get-message(1) <> ""
     1422         then do:
     1423           undo move_block, retry move_block .
     1424         end.
     1425         for each buf_temp-browse-handle
     1426           where buf_temp-browse-handle.browse-type = 'height':u
     1427         on error undo move_block, retry move_block
     1428         :
     1429           assign
     1430             buf_temp-browse-handle.browse-handle :height
     1431               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1432             no-error .
     1433           if error-status :error
     1434           or error-status :get-message(1) <> ""
     1435           then do:
     1436             undo move_block, retry move_block .
     1437           end.
     1438         end.
     1439         assign
     1440           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1441           no-error .
     1442         if error-status :error
     1443         or error-status :get-message(1) <> ""
     1444         then do:
     1445           undo move_block, retry move_block .
     1446         end.
     1447         if frame Dialog-Frame :scrollable = true
     1448         then do:
     1449           assign
     1450             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1451             no-error .
     1452           if error-status :error
     1453           or error-status :get-message(1) <> ""
     1454           then do:
     1455             undo move_block, retry move_block .
     1456           end.
     1457         end.
     1458       end.
     1459       if p-move-resize = true
     1460       then do:
     1461         run diasize_position-resize-button in this-procedure .
     1462       end.
     1463       if v-diasize-wndstore = true
     1464       then do:
     1465         if connected("ub") = true
     1466         then do:
     1467           define variable v-cntxt-db-num        as integer   no-undo .
     1468           define variable v-cntxt-userid        as character no-undo .
     1469           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1470                                             , OUTPUT v-cntxt-userid
     1471                                             ) .
     1472           run gbl/wndsizew.p
     1473             (input  v-cntxt-db-num
     1474             ,input  v-cntxt-userid
     1475             ,input  v-diasize-proc-name
     1476             ,input  'height':u
     1477             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1478             ) .
     1479         end.
     1480       end.
     1481     end.
     1482     assign
     1483       v-diasize-change-size = false
     1484     .
     1485   end procedure.
     1486   procedure diasize_set-height :
     1487     define input  parameter p-new-height  as decimal   no-undo .
     1488     define input  parameter p-move-resize as logical   no-undo .
     1489     do
     1490     on error undo, return error return-value
     1491     :
     1492       run diasize_change-height in this-procedure
     1493         (input  (p-new-height - frame Dialog-Frame :height)
     1494         ,input  p-move-resize
     1495         ) .
     1496     end.
     1497   end procedure.
     1498   procedure diasize_change-width :
     1499     define input  parameter p-change-value as decimal   no-undo .
     1500     define input  parameter p-move-resize  as logical   no-undo .
     1501     define variable v-field-group-handle   as handle    no-undo .
     1502     define variable v-object-handle        as handle    no-undo .
     1503     define variable v-frame-width          as decimal   no-undo .
     1504     define variable v-frame-virtual-width  as decimal   no-undo .
     1505     define variable v-browse-width         as decimal   no-undo .
     1506     define variable v-window-width         as decimal   no-undo .
     1507     define variable v-window-virtual-width as decimal   no-undo .
     1508     define variable v-change-sign          as integer   no-undo .
     1509     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1510     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1511     if p-change-value > 0
     1512     then do:
     1513       if frame Dialog-Frame :width + p-change-value >
     1514           session :width-chars
     1515       then do:
     1516         assign
     1517           p-change-value = session :width-chars - frame Dialog-Frame :width
     1518         .
     1519         if p-change-value <= 0
     1520         then do:
     1521           run diasize_position-resize-button in this-procedure .
     1522           return .
     1523         end.
     1524       end.
     1525     end.
     1526     if p-change-value < 0
     1527     then do:
     1528       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1529       then do:
     1530         assign
     1531           p-change-value = v-diasize-orig-frame-width
     1532                          - frame Dialog-Frame :width
     1533         .
     1534         if p-change-value >= 0
     1535         then do:
     1536           run diasize_position-resize-button in this-procedure .
     1537           return .
     1538         end.
     1539       end.
     1540     end.
     1541     if p-change-value >= 0
     1542     then do:
     1543       assign
     1544         v-change-sign = 1
     1545       .
     1546     end.
     1547     else do:
     1548       assign
     1549         v-change-sign = -1
     1550       .
     1551     end.
     1552     assign
     1553       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1554     .
     1555     if p-change-value = 0
     1556     then do:
     1557       run diasize_position-resize-button in this-procedure .
     1558       return .
     1559     end.
     1560     move_block:
     1561     do
     1562     on error undo move_block, leave move_block
     1563     :
     1564       if retry
     1565       then do:
     1566         do
     1567         on error undo move_block, leave move_block
     1568         :
     1569           if p-change-value > 0
     1570           then do:
     1571             for each buf_temp-diasize-handle
     1572             on error undo, next
     1573             :
     1574               assign
     1575                 v-object-handle = buf_temp-diasize-handle.handle-value
     1576               .
     1577               if v-object-handle <> v-diasize-resize-button
     1578               then do:
     1579                 assign
     1580                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1581                 .
     1582               end.
     1583             end.
     1584             assign
     1585               v-diasize-browse-handle :width = v-browse-width
     1586             .
     1587             for each buf_temp-browse-handle
     1588               where buf_temp-browse-handle.browse-type = 'width':u
     1589             on error undo, next
     1590             :
     1591               assign
     1592                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1593               .
     1594             end.
     1595             assign
     1596               frame Dialog-Frame :width = v-frame-width
     1597             .
     1598             if frame Dialog-Frame :scrollable = true
     1599             then do:
     1600               assign
     1601                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1602               .
     1603             end.
     1604             run diasize_position-resize-button in this-procedure .
     1605           end.
     1606           else do:
     1607             if frame Dialog-Frame :scrollable = true
     1608             then do:
     1609               assign
     1610                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1611               .
     1612             end.
     1613             assign
     1614               frame Dialog-Frame :width = v-frame-width
     1615             .
     1616             for each buf_temp-browse-handle
     1617               where buf_temp-browse-handle.browse-type = 'width':u
     1618             on error undo, next
     1619             :
     1620               assign
     1621                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1622               .
     1623             end.
     1624             assign
     1625               v-diasize-browse-handle :width = v-browse-width
     1626             .
     1627             for each buf_temp-diasize-handle
     1628             on error undo, next
     1629             :
     1630               assign
     1631                 v-object-handle = buf_temp-diasize-handle.handle-value
     1632               .
     1633               if v-object-handle <> v-diasize-resize-button
     1634               then do:
     1635                 assign
     1636                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1637                 .
     1638               end.
     1639             end.
     1640             run diasize_position-resize-button in this-procedure .
     1641           end.
     1642           assign
     1643             v-diasize-change-size = false
     1644           .
     1645           leave move_block .
     1646         end.
     1647       end.
     1648       assign
     1649         v-diasize-need-full-display = true
     1650       .
     1651       if v-diasize-change-size = false
     1652       then do:
     1653         assign
     1654           v-diasize-change-size = true
     1655         .
     1656       end.
     1657       else do:
     1658         return .
     1659       end.
     1660       assign
     1661         v-frame-width = frame Dialog-Frame :width
     1662         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1663         v-browse-width = v-diasize-browse-handle :width
     1664       .
     1665       for each buf_temp-browse-handle
     1666         where buf_temp-browse-handle.browse-type = 'width':u
     1667       :
     1668         assign
     1669           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1670         .
     1671       end.
     1672       for each buf_temp-diasize-handle
     1673       :
     1674         delete buf_temp-diasize-handle .
     1675       end.
     1676       assign
     1677         v-field-group-handle = frame Dialog-Frame :first-child
     1678       .
     1679       do while valid-handle(v-field-group-handle)
     1680       :
     1681         assign
     1682           v-object-handle = v-field-group-handle :first-child
     1683         .
     1684         do while valid-handle(v-object-handle)
     1685         :
     1686           if  v-object-handle <> v-diasize-browse-handle :handle
     1687           and v-object-handle <> v-diasize-resize-button
     1688           and can-query(v-object-handle, "row")
     1689           and can-query(v-object-handle, "height")
     1690           and ( v-object-handle :col + v-object-handle :width
     1691                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1692               )
     1693           then do:
     1694             find first buf_temp-browse-handle
     1695               where buf_temp-browse-handle.browse-type   = 'width':u
     1696                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1697               no-error .
     1698             if available buf_temp-browse-handle
     1699             then do:
     1700             end.
     1701             else do:
     1702               create buf_temp-diasize-handle .
     1703               assign
     1704                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1705                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1706               .
     1707             end.
     1708           end.
     1709           assign
     1710             v-object-handle = v-object-handle :next-sibling
     1711           .
     1712         end.
     1713         assign
     1714           v-field-group-handle = v-field-group-handle :next-sibling
     1715         .
     1716       end.
     1717       do with frame Dialog-Frame
     1718       :
     1719         hide v-diasize-resize-button .
     1720         v-diasize-resize-button :row = 1.
     1721         v-diasize-resize-button :column = 1.
     1722       end.
     1723       if p-change-value > 0
     1724       then do:
     1725         if frame Dialog-Frame :scrollable = true
     1726         then do:
     1727           assign
     1728             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1729             no-error .
     1730           if error-status :error
     1731           or error-status :get-message(1) <> ""
     1732           then do:
     1733             undo move_block, retry move_block.
     1734           end.
     1735         end.
     1736         assign
     1737           frame Dialog-Frame :width = v-frame-width + p-change-value
     1738           no-error .
     1739         if error-status :error
     1740         or error-status :get-message(1) <> ""
     1741         then do:
     1742           undo move_block, retry move_block.
     1743         end.
     1744         assign
     1745           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1746         no-error .
     1747         if error-status :error
     1748         or error-status :get-message(1) <> ""
     1749         then do:
     1750           undo move_block, retry move_block.
     1751         end.
     1752         for each buf_temp-browse-handle
     1753           where buf_temp-browse-handle.browse-type = 'width':u
     1754         on error undo move_block, retry move_block
     1755         :
     1756           assign
     1757             buf_temp-browse-handle.browse-handle :width
     1758               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1759             no-error .
     1760           if error-status :error
     1761           or error-status :get-message(1) <> ""
     1762           then do:
     1763             undo move_block, retry move_block .
     1764           end.
     1765         end.
     1766         for each buf_temp-diasize-handle
     1767         on error undo move_block, retry move_block
     1768         :
     1769           assign
     1770             v-object-handle = buf_temp-diasize-handle.handle-value
     1771           .
     1772           if v-object-handle <> v-diasize-resize-button
     1773           then do:
     1774             assign
     1775               v-object-handle :col = v-object-handle :col + p-change-value
     1776               no-error .
     1777             if error-status :error
     1778             or error-status :get-message(1) <> ""
     1779             then do:
     1780               undo move_block, retry move_block .
     1781             end.
     1782           end.
     1783         end.
     1784       end.
     1785       else do:
     1786         for each buf_temp-diasize-handle
     1787         on error undo move_block, retry move_block
     1788         :
     1789           assign
     1790             v-object-handle = buf_temp-diasize-handle.handle-value
     1791           .
     1792           if v-object-handle <> v-diasize-resize-button
     1793           then do:
     1794             assign
     1795               v-object-handle :col = v-object-handle :col + p-change-value
     1796               no-error .
     1797             if error-status :error
     1798             or error-status :get-message(1) <> ""
     1799             then do:
     1800               undo move_block, retry move_block .
     1801             end.
     1802           end.
     1803         end.
     1804         for each buf_temp-browse-handle
     1805           where buf_temp-browse-handle.browse-type = 'width':u
     1806         on error undo move_block, retry move_block
     1807         :
     1808           assign
     1809             buf_temp-browse-handle.browse-handle :width
     1810               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1811             no-error .
     1812           if error-status :error
     1813           or error-status :get-message(1) <> ""
     1814           then do:
     1815             undo move_block, retry move_block .
     1816           end.
     1817         end.
     1818         assign
     1819           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1820           no-error .
     1821         if error-status :error
     1822         or error-status :get-message(1) <> ""
     1823         then do:
     1824           undo move_block, retry move_block.
     1825         end.
     1826         assign
     1827           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1828         no-error .
     1829         if error-status :error
     1830         or error-status :get-message(1) <> ""
     1831         then do:
     1832           undo move_block, retry move_block.
     1833         end.
     1834         if frame Dialog-Frame :scrollable = true
     1835         then do:
     1836           assign
     1837             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1838           no-error .
     1839           if error-status :error
     1840           or error-status :get-message(1) <> ""
     1841           then do:
     1842             undo move_block, retry move_block.
     1843           end.
     1844         end.
     1845       end.
     1846       if p-move-resize
     1847       then do:
     1848         run diasize_position-resize-button in this-procedure .
     1849       end.
     1850       if v-diasize-wndstore = true
     1851       then do:
     1852         if connected("ub") = true
     1853         then do:
     1854           define variable v-cntxt-db-num        as integer   no-undo .
     1855           define variable v-cntxt-userid        as character no-undo .
     1856           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1857                                             , OUTPUT v-cntxt-userid
     1858                                             ) .
     1859           run gbl/wndsizew.p
     1860             (input  v-cntxt-db-num
     1861             ,input  v-cntxt-userid
     1862             ,input  v-diasize-proc-name
     1863             ,input  'width':u
     1864             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1865             ) .
     1866         end.
     1867       end.
     1868     end.
     1869     assign
     1870       v-diasize-change-size = false
     1871     .
     1872   end procedure.
     1873   procedure diasize_set-width :
     1874     define input  parameter p-new-width  as decimal   no-undo .
     1875     define input  parameter p-move-resize as logical   no-undo .
     1876     do
     1877     on error undo, return error return-value
     1878     :
     1879       run diasize_change-width in this-procedure
     1880         (input  (p-new-width - frame Dialog-Frame :width)
     1881         ,input  p-move-resize
     1882         ) .
     1883     end.
     1884   end procedure.
     1885   procedure diasize_position-resize-button :
     1886     do with frame Dialog-Frame
     1887     :
     1888       hide v-diasize-resize-button .
     1889       assign
     1890         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1891                     - 1
     1892                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1893         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1894                     - 1
     1895                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1896       .
     1897       view v-diasize-resize-button .
     1898     end.
     1899   end procedure.
     1900   on alt-right anywhere
     1901   do:
     1902     run diasize_change-width in this-procedure
     1903       (input 1
     1904       ,input true
     1905       ) .
     1906     return no-apply .
     1907   end.
     1908   on alt-left anywhere
     1909   do:
     1910     run diasize_change-width in this-procedure
     1911       (input -1
     1912       ,input true
     1913       ) .
     1914     return no-apply .
     1915   end.
     1916   on alt-down anywhere
     1917   do:
     1918     run diasize_change-height in this-procedure
     1919       (input 1
     1920       ,input true
     1921       ) .
     1922     return no-apply .
     1923   end.
     1924   on alt-up anywhere
     1925   do:
     1926     run diasize_change-height in this-procedure
     1927       (input -1
     1928       ,input true
     1929       ) .
     1930     return no-apply .
     1931   end.
     1932   on alt-enter of frame Dialog-Frame
     1933   do:
     1934     run diasize_maximize in this-procedure
     1935       (input  ?
     1936       ).
     1937     return no-apply .
     1938   end.
     1939   procedure diasize_end-move :
     1940     do
     1941     on error undo, return error return-value
     1942     :
     1943       define variable v-row-delta as decimal   no-undo .
     1944       define variable v-col-delta as decimal   no-undo .
     1945       define variable v-new-row as decimal   no-undo .
     1946       define variable v-new-col as decimal   no-undo .
     1947       assign
     1948         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1949         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1950       .
     1951       assign
     1952         v-row-delta = v-new-row - frame Dialog-Frame :height
     1953         v-col-delta = v-new-col - frame Dialog-Frame :width
     1954       .
     1955       run diasize_change-height in this-procedure
     1956         (input v-row-delta
     1957         ,input true
     1958         ) .
     1959       run diasize_change-width in this-procedure
     1960         (input v-col-delta
     1961         ,input true
     1962         ) .
     1963     end.
     1964   end procedure.
     1965   procedure diasize_maximize :
     1966     define input  parameter p-action as logical   no-undo .
     1967     do
     1968     on error undo, return error return-value
     1969     :
     1970       if p-action = ?
     1971       then do:
     1972         if v-diasize-need-maximize = true
     1973         then do:
     1974           assign
     1975             p-action = true
     1976           .
     1977         end.
     1978         else do:
     1979           assign
     1980             p-action = false
     1981           .
     1982         end.
     1983       end.
     1984       if p-action = true
     1985       then do:
     1986         run diasize_change-height in this-procedure
     1987           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1988               - frame Dialog-Frame :height-chars
     1989           ,input true
     1990           ) .
     1991         run diasize_change-width in this-procedure
     1992           (input session :width-chars
     1993               - frame Dialog-Frame :width-chars
     1994           ,input true
     1995           ) .
     1996         assign
     1997           v-diasize-need-maximize = false
     1998         .
     1999       end.
     2000       else do:
     2001         run diasize_change-width in this-procedure
     2002           (input v-diasize-orig-frame-width
     2003               - frame Dialog-Frame :width-chars
     2004           ,input true
     2005           ) .
     2006         run diasize_change-height in this-procedure
     2007           (input v-diasize-orig-frame-height
     2008               - frame Dialog-Frame :height-chars
     2009           ,input true
     2010           ) .
     2011         assign
     2012           v-diasize-need-maximize = true
     2013         .
     2014       end.
     2015     end.
     2016   end procedure.
     2017   procedure diasize_restore-orig-size :
     2018     do
     2019     on error undo, return error return-value
     2020     :
     2021       assign
     2022         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2023         v-diasize-current-frame-height = frame Dialog-Frame :height
     2024       .
     2025       run diasize_set-height in this-procedure
     2026         (input  v-diasize-orig-frame-height
     2027         ,input  true
     2028         ) .
     2029       run diasize_set-width in this-procedure
     2030         (input  v-diasize-orig-frame-width
     2031         ,input  true
     2032         ) .
     2033     end.
     2034   end procedure.
     2035   procedure diasize_restore-current-size :
     2036     do
     2037     on error undo, return error return-value
     2038     :
     2039       run diasize_set-height in this-procedure
     2040         (input  v-diasize-current-frame-height
     2041         ,input  true
     2042         ) .
     2043       run diasize_set-width in this-procedure
     2044         (input  v-diasize-current-frame-width
     2045         ,input  true
     2046         ) .
     2047     end.
     2048   end procedure.
     2049   procedure diasize_set-browse-handle :
     2050     define input  parameter p-browse-handle as handle   no-undo .
     2051     define buffer buf_temp-browse-handle for temp-browse-handle .
     2052     do
     2053     on error undo, return error return-value
     2054     :
     2055       assign
     2056         v-diasize-browse-handle = p-browse-handle
     2057       .
     2058       for each buf_temp-browse-handle
     2059       on error undo, return error return-value
     2060       :
     2061         delete buf_temp-browse-handle .
     2062       end.
     2063     end.
     2064   end procedure.
     2065   procedure diasize_add_browse :
     2066     define input  parameter p-browse-type   as character no-undo .
     2067     define input  parameter p-browse-handle as handle    no-undo .
     2068     define buffer buf_temp-browse-handle for temp-browse-handle .
     2069     do
     2070     on error undo, return error return-value
     2071     :
     2072       assign
     2073         v-diasize-browse-number = v-diasize-browse-number + 1
     2074       .
     2075       create buf_temp-browse-handle .
     2076       assign
     2077         buf_temp-browse-handle.browse-type   = p-browse-type
     2078         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2079         buf_temp-browse-handle.browse-handle = p-browse-handle
     2080       .
     2081     end.
     2082   end procedure.
     2083   procedure diasize_init :
     2084     define variable v-default-value    as logical   no-undo .
     2085     define variable v-restore-saved    as logical   no-undo .
     2086     define variable v-resize-value-str as character no-undo .
     2087     do
     2088     on error undo, return error return-value
     2089     :
     2090       do with frame Dialog-Frame
     2091       :
     2092         assign
     2093           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2094           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2095           v-diasize-browse-handle     = browse BROWSE-2 :handle
     2096         .
     2097         create button v-diasize-resize-button
     2098         assign
     2099           parent        = frame Dialog-Frame :first-child
     2100           label         = "s"
     2101           height-pixels = 16
     2102           width-pixels  = 16
     2103           visible       = true
     2104           sensitive     = true
     2105           movable       = true
     2106           triggers:
     2107             on end-move persistent run diasize_end-move in this-procedure .
     2108           end triggers.
     2109         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2110         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2111         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2112         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2113         assign
     2114           v-diasize-wndmax = false
     2115         .
     2116         if connected("ub") = true
     2117         then do:
     2118           define variable v-cntxt-db-num        as integer   no-undo .
     2119           define variable v-cntxt-userid        as character no-undo .
     2120           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2121                                             , OUTPUT v-cntxt-userid
     2122                                             ) .
     2123           run gbl/wndpar_r.p
     2124             (input  v-cntxt-db-num
     2125             ,input  v-cntxt-userid
     2126             ,input  'wndmax':U
     2127             ,output v-diasize-wndmax
     2128             ,output v-default-value
     2129             ) .
     2130         end.
     2131         assign
     2132           v-diasize-wndstore = false
     2133         .
     2134         if connected("ub") = true
     2135         then do:
     2136           run gbl/wndpar_r.p
     2137             (input  v-cntxt-db-num
     2138             ,input  v-cntxt-userid
     2139             ,input  'wndstore':U
     2140             ,output v-diasize-wndstore
     2141             ,output v-default-value
     2142             ) .
     2143         end.
     2144         assign
     2145           v-diasize-proc-name = entry(1, program-name(2), '.')
     2146         .
     2147         if v-diasize-wndstore = true
     2148         then do:
     2149           assign
     2150             v-restore-saved = false
     2151           .
     2152           if connected("ub") = true
     2153           then do:
     2154             run gbl/wndsizer.p
     2155               (input  v-cntxt-db-num
     2156               ,input  v-cntxt-userid
     2157               ,input  v-diasize-proc-name
     2158               ,input  'height':u
     2159               ,output v-resize-value-str
     2160               ) .
     2161             if v-resize-value-str <> '':U
     2162             then do:
     2163               run diasize_change-height in this-procedure
     2164                 (input  integer(v-resize-value-str)
     2165                 ,input  true
     2166                 ) .
     2167               assign
     2168                 v-restore-saved = true
     2169               .
     2170             end.
     2171           end.
     2172           if connected("ub") = true
     2173           then do:
     2174             run gbl/wndsizer.p
     2175               (input  v-cntxt-db-num
     2176               ,input  v-cntxt-userid
     2177               ,input  v-diasize-proc-name
     2178               ,input  'width':u
     2179               ,output v-resize-value-str
     2180               ) .
     2181             if v-resize-value-str <> '':U
     2182             then do:
     2183               run diasize_change-width in this-procedure
     2184                 (input  integer(v-resize-value-str)
     2185                 ,input  true
     2186                 ) .
     2187               assign
     2188                 v-restore-saved = true
     2189               .
     2190             end.
     2191           end.
     2192           if v-restore-saved <> true
     2193           then do:
     2194             if v-diasize-wndmax = true
     2195             then do:
     2196               run diasize_maximize in this-procedure
     2197                 (input  true
     2198                 ) .
     2199             end.
     2200           end.
     2201         end.
     2202         else do:
     2203           if v-diasize-wndmax = true
     2204           then do:
     2205             run diasize_maximize in this-procedure
     2206               (input  true
     2207               ) .
     2208           end.
     2209         end.
     2210       end.
     2211     end.
     2212   end procedure.
     2213   procedure diasize_need-full-display :
     2214     define output parameter p-need-full-display as logical   no-undo .
     2215     do
     2216     on error undo, return error return-value
     2217     :
     2218       assign
     2219         p-need-full-display = v-diasize-need-full-display
     2220       .
     2221       assign
     2222         v-diasize-need-full-display = false
     2223       .
     2224     end.
     2225   end procedure.
     2226   procedure get-context :
     2227      define output parameter p-db-num as integer          no-undo.
     2228      define output parameter p-user-id as character        no-undo.
     2229      define variable v-login               as character    no-undo.
     2230      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2231      define buffer buf_user-login  for ub.user-login .
     2232      do
     2233      on error undo, return error
     2234      :
     2235            FIND FIRST buf_sys-ctrl no-lock.
     2236            ASSIGN
     2237               v-login = USERID("ub")
     2238               p-db-num = buf_sys-ctrl.db-num
     2239            .
     2240            FIND FIRST buf_user-login
     2241                 WHERE buf_user-login.db-num = p-db-num
     2242                   AND buf_user-login.user-login = v-login
     2243                 no-lock
     2244                 no-error
     2245                 .
     2246            IF AVAILABLE buf_user-login
     2247            THEN DO:
     2248               assign
     2249                  p-user-id = buf_user-login.user-id
     2250               .
     2251            END.
     2252      end.
     2253   end procedure.
     2254       run diasize_init in this-procedure .
     2255   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2256     run mainmenu_getcntxt in p-mainmenu-handle
     2257       (output v-cntxt-db-num
     2258       ,output v-cntxt-userid
     2259       ,output v-cntxt-level
     2260       ,output v-cntxt-host-code-obj
     2261       ,output v-cntxt-obj-type
     2262       ,output v-cntxt-obj-code
     2263       ,output v-cntxt-db-num-obj
     2264       ,output v-cntxt-is-admin
     2265       ) .
     2266   find first ub.price-doc where recid(ub.price-doc) = rec_id no-lock.
     2267   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2268   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2269     v-printer-name = session:printer-name.
     2270   run load-menu (ub.price-doc.doc-num,  '*', ub.price-doc.status_, '*', '*').
     2271   MAIN-BLOCK:
     2272   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2273      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2274       run get-report-num in p-mainmenu-handle (
     2275           output g#report-num
     2276       ).
     2277       run get-quest-print in p-mainmenu-handle (
     2278           output g#quest-print
     2279       ).
     2280     RUN enable_UI.
     2281     Tmp#List.last-use      :read-only in browse BROWSE-2 =  true .
     2282       ASSIGN frame Dialog-Frame:TITLE =  "Печать переоценки  "
     2283     + " Статус: " + ub.price-doc.status_
     2284     + "  № "  + ub.price-doc.doc-num.
     2285     WAIT-FOR GO OF FRAME Dialog-Frame focus BROWSE-2.
     2286   END.
     2287   RUN disable_UI.
     2288   PROCEDURE disable_UI :
     2289     HIDE FRAME Dialog-Frame.
     2290   END PROCEDURE.
     2291   PROCEDURE enable_UI :
     2292     DISPLAY tg-print-zero rs-price-selection tg-sort-by-group v-printer-name
     2293         WITH FRAME Dialog-Frame.
     2294     ENABLE RECT-1 b-exit b-mark b-erase b-print-doc b-help BROWSE-2 tg-print-zero i-print
     2295            rs-price-selection tg-sort-by-group v-printer-name
     2296         WITH FRAME Dialog-Frame.
     2297     VIEW FRAME Dialog-Frame.
     2298     OPEN QUERY BROWSE-2 FOR EACH Tmp#List NO-LOCK where     Tmp#List.view_ <> 0     BY Tmp#List.cli-code.
     2299   END PROCEDURE.
     2300   PROCEDURE Load-menu :
     2301   define input parameter p-doc-num as character        no-undo.
     2302   define input parameter xtype     as character        no-undo.
     2303   define input parameter xstatus   as character        no-undo.
     2304   define input parameter xInternal as character        no-undo.
     2305   define input parameter xflag     as character        no-undo.
     2306   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile:currsysk.i $ $Revision: $".
     2307   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currsysk in g#library
     2308     (output v-menu-doc-sys-key
     2309     ) no-error .
     2310       assign
     2311           v-menu-doc-doc-code = p-doc-num
     2312           v-menu-doc-doc-type = xtype
     2313           v-menu-doc-status_  = xstatus
     2314           v-menu-doc-internal = xInternal
     2315           v-menu-doc-flag     = xflag
     2316           sys-key             = v-menu-doc-sys-key
     2317       .
