      406   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      407   define temp-table userobjs_temp-user-obj no-undo
      408     field obj-type as character
      409     field obj-code as integer
      410     index xpk is primary unique obj-type obj-code
      411     .
      412   procedure userobjs_clear :
      413     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      414     do
      415     on error undo, return error return-value
      416     :
      417       for each buf_userobjs_temp-user-obj
      418       on error undo, return error return-value
      419       :
      420         delete buf_userobjs_temp-user-obj .
      421       end.
      422     end.
      423   end .
      424   procedure userobjs_object-count :
      425     define output parameter p-total-count as integer   no-undo .
      426     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      427     do
      428     on error undo, return error return-value
      429     :
      430       assign
      431         p-total-count = 0
      432       .
      433       for each buf_userobjs_temp-user-obj
      434       on error undo, return error return-value
      435       :
      436         assign
      437           p-total-count = p-total-count + 1
      438         .
      439       end.
      440     end.
      441   end.
      442   procedure userobjs_append :
      443      define input  parameter p-obj-type as character no-undo .
      444      define input  parameter p-obj-code as integer   no-undo .
      445     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      446     do
      447     on error undo, return error return-value
      448     :
      449       find first buf_userobjs_temp-user-obj
      450         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      451           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      452         no-error .
      453       if not available buf_userobjs_temp-user-obj
      454       then do:
      455         create buf_userobjs_temp-user-obj .
      456         assign
      457           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      458           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      459         .
      460       end.
      461     end.
      462   end.
      463   procedure userobjs_object-exist :
      464     define output parameter p-object-exist as logical   no-undo .
      465     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      466     do
      467     on error undo, return error return-value
      468     :
      469       find first buf_userobjs_temp-user-obj
      470         no-error .
      471       if not available buf_userobjs_temp-user-obj
      472       then do:
      473         assign
      474           p-object-exist = false
      475         .
      476       end.
      477       else do:
      478         assign
      479           p-object-exist = true
      480         .
      481       end.
      482     end.
      483   end.
      484   procedure userobjs_transfer :
      485     define input  parameter p-callback-handle as handle no-undo .
      486     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      487     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      488     do
      489     on error undo, return error return-value
      490     :
      491       if valid-handle(p-callback-handle) <> true
      492       then do:
      493         message
      494           vss-workfile vss-revision vss-description skip
      495           "Ошибка задания входных параметров" skip
      496           "Неизвестный указатель на процедуру" skip
      497           view-as alert-box error .
      498         undo, return error return-value .
      499       end.
      500       if p-callback-handle :get-signature("userobjs_append") = ""
      501       then do:
      502         message
      503           vss-workfile vss-revision vss-description skip
      504           "Ошибка задания входных параметров" skip
      505           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      506                     ,p-callback-handle :file-name
      507                     ) skip
      508           view-as alert-box error .
      509         undo, return error return-value .
      510       end.
      511       for each buf_userobjs_temp-user-obj
      512       on error undo, return error return-value
      513       :
      514         run userobjs_append in p-callback-handle
      515           (input  buf_userobjs_temp-user-obj.obj-type
      516           ,input  buf_userobjs_temp-user-obj.obj-code
      517           ) .
      518       end.
      519     end.
      520   end procedure.
      521   procedure userobjs_select-one :
      522      define input  parameter parparentproc     as widget-handle no-undo .
      523      define input  parameter p-db-num          as integer   no-undo .
      524      define input  parameter p-user-id         as character no-undo .
      525      define input  parameter p-host-code-obj   as integer   no-undo .
      526      define input  parameter p-obj-type        as character no-undo .
      527      define input  parameter p-obj-code        as integer   no-undo .
      528      define output parameter p-user-select     as logical   no-undo .
      529      define output parameter p-select-obj-type as character no-undo .
      530      define output parameter p-select-obj-code as character no-undo .
      531     do
      532     on error undo, return error return-value
      533     :
      534       run gbl/userobjs.w
      535         (input  parparentproc
      536         ,input  this-procedure :handle
      537         ,input  p-db-num
      538         ,input  p-user-id
      539         ,input  p-host-code-obj
      540         ,input  p-obj-type
      541         ,input  p-obj-code
      542         ,INPUT  "b-sel"
      543         ,output p-user-select
      544         ,output p-select-obj-type
      545         ,output p-select-obj-code
      546         ) .
      547     end.
      548   end.
      549   procedure userobjs_select-many :
      550     define input  parameter parparentproc   as widget-handle no-undo .
      551     define input  parameter p-db-num        as integer   no-undo .
      552     define input  parameter p-user-id       as character no-undo .
      553     define input  parameter p-host-code-obj as integer   no-undo .
      554     define input  parameter p-obj-type      as character no-undo .
      555     define input  parameter p-obj-code      as integer   no-undo .
      556     define output parameter p-user-select   as logical   no-undo .
      557     define variable v-select-obj-type as character no-undo .
      558     define variable v-select-obj-code as integer   no-undo .
      559     do
      560     on error undo, return error return-value
      561     :
      562       run gbl/userobjs.w
      563         (input  parparentproc
      564         ,input  this-procedure :handle
      565         ,input  p-db-num
      566         ,input  p-user-id
      567         ,input  p-host-code-obj
      568         ,input  p-obj-type
      569         ,input  p-obj-code
      570         ,INPUT  "b-sel,b-mark"
