      577   procedure thobjs :
      578      define input        parameter parparentproc     as widget-handle no-undo .
      579      define input        parameter i-bttns           as character     no-undo .
      580      define input        parameter i-list-mode       as character     no-undo.
      581      define input        parameter i-obj-type        as character     no-undo.
      582      define input        parameter i-db-num          as integer       no-undo.
      583      define input        parameter i-host-code       as integer       no-undo.
      584      define input-output parameter p-rid-list        as character     no-undo .
      585   run ref/thobjs.p
      586           ( input parparentproc
      587            ,input  this-procedure :handle
      588           , input i-bttns
      589           , input i-list-mode
      590           , input i-obj-type
      591           , input i-db-num
      592           , input i-host-code
      593           , input-output p-rid-list ) no-error .
      594   end.
      595   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      596   define variable v-waitfram-action01         as character   no-undo .
      597   define variable v-waitfram-action02         as character   no-undo .
      598   define variable v-waitfram-action03         as character   no-undo .
      599   define variable mWaitFramTextBeg            as character   no-undo.
      600   define variable mWaitFramTextEnd            as character   no-undo.
      601   define variable mWaitFramView               as logical     no-undo.
      602   define variable mWaitProcEvent              as logical     no-undo init yes.
      603   define variable mWaitFramInterval           as integer     no-undo init 1 .
      604   define variable mWaitFramStop               as logical     no-undo.
      605   define variable mWaitFramStopUser           as logical     no-undo.
      606   define variable mWaitFramStopTimeOut        as logical     no-undo.
      607   define variable mWaitFramStartProc          as datetime-tz no-undo.
      608   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      609   define button B-WaitFramStop auto-end-key
      610        label "Стоп"
      611        size 10 by 1 tooltip "Остоновить процесс".
      612   define button B-viewProcInfo
      613        label "Информация"
      614        size 15 by 1 tooltip "Информация о процесс".
      615   define frame waitfram
      616     v-waitfram-action01 format "x(72)" no-label skip
      617     v-waitfram-action02 format "x(72)" no-label skip
      618     v-waitfram-action03 format "x(72)" no-label skip
      619     B-viewProcInfo
      620     B-WaitFramStop at row 4 col 30
      621     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      622     .
      623   define new global shared variable mBatchMode as logical no-undo init ?.
      624   define variable mFramBachModHandle as handle no-undo.
      625   mFramBachModHandle = frame waitfram:handle.
      626   define variable mFameOldVis as logical no-undo.
      627   define variable mVisCUrentVin as logical no-undo.
      628   if session:batch-mode
      629   then
      630      mBatchMode = yes.
      631   if mBatchMode = ? then do:
      632     mVisCUrentVin = current-window:visible.
      633     mFameOldVis = mFramBachModHandle:visible.
      634     mFramBachModHandle:visible  = yes.
      635     mBatchMode = mFramBachModHandle:visible ne yes.
      636     mFramBachModHandle:visible = mFameOldVis.
      637     current-window:visible = mVisCUrentVin.
      638   end.
      639    if  log-manager:logfile-name ne ?
      640     then DO:
      641         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      642         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      643         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      644     end.
      645   on choose of B-WaitFramStop in frame waitfram
      646   do:
      647     mWaitFramStop = yes.
      648     mWaitFramStopUser = yes.
      649   end.
      650   function waitfram-check-timeout returns logical():
      651      define variable vtime as int64 no-undo.
      652      if mWaitFramStopTimeOut
      653      then
      654         return yes.
      655      vtime = ( now - mWaitFramStartProc ) / 1000 .
      656      if     mWaitFramTimeOut ne ?
      657         and mWaitFramTimeOut ne 0
      658         and mWaitFramTimeOut lt vtime
      659      then do:
      660         mWaitFramStopTimeOut = yes.
      661      end.
      662      return mWaitFramStopTimeOut.
      663   end.
      664   procedure waitfram-hide :
      665     if not session:batch-mode
      666     then do
      667     on error undo, return error return-value
      668     :
      669       pause 0 before-hide .
      670       if not mBatchMode then
      671         hide frame waitfram .
      672     if     not mWaitFramView
      673        and mWaitProcEvent
      674     then
      675       process events .
      676     end.
      677   end procedure.
      678   procedure waitfram-show :
      679     define input  parameter p-message as character no-undo .
      680     define variable v-left-margin as integer   no-undo .
      681     if not session:batch-mode
      682     then do
      683     on error undo, return error return-value
      684     :
      685       if length(p-message) <= 70 then do:
      686         assign
      687           v-left-margin = integer((70 - length(p-message)) / 2)
      688         .
      689         assign
      690           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      691         .
      692         assign
      693           v-waitfram-action01 = " "
      694           v-waitfram-action02 = " "
      695                                    + fill(" ", v-left-margin)
      696                                    + p-message
      697           v-waitfram-action03 = " "
      698         .
      699       end.
      700       else do:
      701         define variable vRindex1 as integer no-undo.
      702         define variable vRindex2 as integer no-undo.
      703         vRindex1 = r-index(p-message," ",70).
      704         if vRindex1 = 0
      705         then
      706            vRindex1 = 70.
      707         if length(p-message)  <= vRindex1 + 70 then do:
      708           assign
      709             v-waitfram-action01 = " "
      710             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      711             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      712           .
      713         end.
      714         else do:
      715           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      716           if vRindex2 <= vRindex1
      717           then
      718              vRindex2 = vRindex1 + 70.
      719           assign
      720             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      721             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      722             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      723           .
      724         end.
      725       end.
      726       B-viewProcInfo:visible   in frame waitfram = no.
      727       B-viewProcInfo:sensitive in frame waitfram = no.
      728       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      729       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      730       if  (   mWaitFramView
      731          or  mWaitProcEvent)
      732          and not mBatchMode
      733       then
      734          display
      735             v-waitfram-action01 skip
      736             v-waitfram-action02 skip
      737             v-waitfram-action03 skip
      738          with frame waitfram .
      739       if     mWaitFramView
      740          then do:
      741             if     mWaitFramInterval ne ?
      742                and not mBatchMode
      743             then
      744                wait-for go of frame waitfram pause mWaitFramInterval.
      745          end.
      746          else
      747             if     mWaitProcEvent
      748                and not mBatchMode
      749             then
      750                process events .
      751     end.
      752   end procedure.
      753      procedure waitfram-show-this:
      754         define input  parameter iInterval as int64 no-undo.
      755         define variable vtime as int64 no-undo.
      756         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      757         mWaitFramInterval = iInterval.
      758         run waitfram-show (substitute("&1&2 &3&4" ,
      759                                       mWaitFramTextBeg ,
      760                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      761                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      762                                       mWaitFramTextEnd
      763                                      )
      764                           ).
      765      end.
      766      procedure WaitFramRunPause:
      767         define input  parameter iInterval as dec no-undo.
      768         define variable vStart  as datetime-tz no-undo.
      769         define variable vend    as datetime-tz no-undo.
      770         define variable vint as int64 no-undo.
      771         define variable vOk as logical no-undo.
      772         vStart = now.
      773         vend   = vStart.
      774         publish "WaitFramPause" (iInterval,output vOk).
      775         vend   =  now.
      776         vint = vend - vStart.
      777         vint = iInterval - vint / 1000.
      778         if     not mWaitFramStop
      779            and (   vint > 0
      780                 or (    not vOk
      781                     and iInterval eq ?
      782                     )
      783                 )
      784         then
      785            run waitfram-show-this (iInterval).
      786         vend   =  now.
      787         vint = vend - vStart.
      788         vint = iInterval - vint / 1000.
      789         if     not mWaitFramStop
      790            and vint > 0
      791         then do:
      792            run gbl/pause.p (vint * 1000).
      793         end.
      794         if iInterval ne ?
      795         then
      796            publish "WaitFramStop".
      797         waitfram-check-timeout().
      798      end.
      799      procedure WaitFramWaitFor:
      800         define input  parameter iInterval as dec no-undo.
      801         assign
      802            mWaitFramStartProc   = now
      803            mWaitFramStopUser    = no
      804            mWaitFramStopTimeOut = no
      805         .
      806         block-wait:
      807         do while not mWaitFramStop:
      808            run WaitFramRunPause (iInterval).
      809            if  waitfram-check-timeout()
      810            then do:
      811               leave block-wait.
      812            end.
      813         end.
      814         run waitfram-hide.
      815      end.
      816   procedure waitfram-join :
      817     define input  parameter p-line-1  as character no-undo .
      818     define input  parameter p-line-2  as character no-undo .
      819     define input  parameter p-line-3  as character no-undo .
      820     define output parameter p-message as character no-undo .
      821     do
      822     on error undo, return error return-value
      823     :
      824       assign
      825         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      826                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      827                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      828       .
      829     end.
      830   end procedure.
      831   function waitfram-join-function returns character
      832     (input p-line-1 as character
      833     ,input p-line-2 as character
      834     ,input p-line-3 as character
      835     ).
      836     define variable v-message as character no-undo .
      837     run waitfram-join in this-procedure
      838       (input  p-line-1
      839       ,input  p-line-2
      840       ,input  p-line-3
      841       ,output v-message
      842       ) .
      843     return v-message .
      844   end function .
      845   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      846     define variable v-cntxt-db-num        as integer   no-undo .
      847     define variable v-cntxt-userid        as character no-undo .
      848     define variable v-cntxt-level         as character no-undo .
      849     define variable v-cntxt-host-code-obj as integer   no-undo .
      850     define variable v-cntxt-obj-type      as character no-undo .
      851     define variable v-cntxt-obj-code      as integer   no-undo .
      852     define variable v-cntxt-db-num-obj    as integer   no-undo .
      853     define variable v-cntxt-is-admin      as logical   no-undo .
      854   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      855     run mainmenu_getcntxt in parparentproc
      856       (output v-cntxt-db-num
      857       ,output v-cntxt-userid
      858       ,output v-cntxt-level
      859       ,output v-cntxt-host-code-obj
      860       ,output v-cntxt-obj-type
      861       ,output v-cntxt-obj-code
      862       ,output v-cntxt-db-num-obj
      863       ,output v-cntxt-is-admin
      864       ) .
      865   def temp-table tt-obj no-undo
      866       field db-num as int format ">>,>>9" COLUMN-LABEL "БД"
      867       field obj-type as char format "x(3)" COLUMN-LABEL "Тип"
      868       field obj-code as int format ">>,>>9" COLUMN-LABEL "Код"
      869       field obj-name as char format "x(30)" COLUMN-LABEL "Название"
      870       field last-upload-date as char COLUMN-LABEL "Последняя!выгруженная!дата"
      871       field last-upload-shift as char COLUMN-LABEL "Последняя!выгруженная!смена"
      872       field date-delta as int format ">>,>>9" COLUMN-LABEL "Дельта!по дате"
      873       field obj-date as date format "99/99/9999" COLUMN-LABEL "Текущая!дата"
      874       field obj-shift as char format "x(20)" COLUMN-LABEL "Текущая!смена"
      875   .
      876   DEFINE BUTTON b-print
      877        LABEL "Печать"
      878        SIZE 7 BY 1.
      879   DEFINE BUTTON b-refresh
      880        LABEL "Обновить"
      881        SIZE 9 BY 1.
      882   DEFINE BUTTON b-sel-objs
      883        LABEL "Выбор"
      884        SIZE 7 BY 1.
      885   DEFINE BUTTON b_OK AUTO-GO
      886        LABEL "Выход"
      887        SIZE 7 BY 1
      888        BGCOLOR 8 .
      889   DEFINE VARIABLE allow-days AS INTEGER FORMAT ">,>>>,>>9":U INITIAL 1
      890        VIEW-AS FILL-IN
      891        SIZE 8 BY 1 NO-UNDO.
      892   DEFINE VARIABLE sel-obj-type AS INTEGER INITIAL 2
      893        VIEW-AS RADIO-SET VERTICAL
      894        RADIO-BUTTONS
      895             "№ объектов", 1,
      896   "Все", 2
      897        SIZE 16 BY 2 NO-UNDO.
      898   DEFINE RECTANGLE RECT-1
      899        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      900        SIZE 24 BY 2.14.
      901   DEFINE RECTANGLE RECT-2
      902        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      903        SIZE 40 BY 2.14.
      904   DEFINE QUERY br-obj FOR
      905         tt-obj SCROLLING.
      906   DEFINE BROWSE br-obj
      907     QUERY br-obj DISPLAY
      908         tt-obj.db-num
      909         tt-obj.obj-type
      910         tt-obj.obj-code
      911         tt-obj.obj-name
      912         tt-obj.last-upload-date
      913         tt-obj.last-upload-shift
      914         tt-obj.date-delta
      915         tt-obj.obj-date
      916         tt-obj.obj-shift
      917       WITH NO-ROW-MARKERS SEPARATORS SIZE 104 BY 15.71 FIT-LAST-COLUMN.
      918   DEFINE FRAME Dialog-Frame
      919        b_OK AT ROW 1 COL 1
      920        b-print AT ROW 1 COL 9 WIDGET-ID 2
      921        b-refresh AT ROW 1 COL 16 WIDGET-ID 4
      922        sel-obj-type AT ROW 2.24 COL 2 NO-LABEL WIDGET-ID 10
      923        b-sel-objs AT ROW 2.38 COL 17 WIDGET-ID 8
      924        allow-days AT ROW 2.67 COL 53.4 COLON-ALIGNED NO-LABEL WIDGET-ID 26
      925        br-obj AT ROW 4.33 COL 1 WIDGET-ID 100
      926        "Допустимое кол-во дней" VIEW-AS TEXT
      927             SIZE 27 BY 1 AT ROW 2.24 COL 25.4 WIDGET-ID 22
      928        "от последней даты выгрузки" VIEW-AS TEXT
      929             SIZE 30 BY 1 AT ROW 3.14 COL 25.4 WIDGET-ID 24
      930        RECT-1 AT ROW 2.19 COL 1 WIDGET-ID 14
      931        RECT-2 AT ROW 2.19 COL 25 WIDGET-ID 16
      932        SPACE(39.99) SKIP(15.80)
      933       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      934            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      935            TITLE "Мониторниг инкрементальной выгрузки"
      936            DEFAULT-BUTTON b_OK.
      937   ASSIGN
      938          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      939          FRAME Dialog-Frame:HIDDEN           = TRUE.
      940   ASSIGN
      941          br-obj:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 3
      942          br-obj:ALLOW-COLUMN-SEARCHING IN FRAME Dialog-Frame = TRUE.
      943   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      944   DO:
      945     APPLY "END-ERROR":U TO SELF.
      946   END.
      947   ON CHOOSE OF b-print IN FRAME Dialog-Frame
      948   DO:
      949     message "Печать пока не предусмотрена!" view-as alert-box.
      950   END.
      951   ON CHOOSE OF b-refresh IN FRAME Dialog-Frame
      952   DO:
      953     assign frame Dialog-Frame sel-obj-type allow-days.
      954     run prepare-rows.
      955     run update-br("obj-code", false).
      956   END.
      957   ON CHOOSE OF b-sel-objs IN FRAME Dialog-Frame
      958   DO:
      959   def var v-sel as logical no-undo.
      960   run userobjs_select-many(
      961       parParentProc,
      962       g#db-num,
      963       g#userid,
      964       v-cntxt-host-code-obj,
      965       v-cntxt-obj-type,
      966       v-cntxt-obj-code,
      967       output v-sel
      968   ).
      969   END.
      970   ON ROW-DISPLAY OF br-obj IN FRAME Dialog-Frame
      971   DO:
      972     if tt-obj.date-delta > allow-days then do:
      973         tt-obj.date-delta:FGCOLOR in browse br-obj = 12.
      974     end.
      975   END.
      976   ON START-SEARCH OF br-obj IN FRAME Dialog-Frame
      977   DO:
      978     def var curr-col as char no-undo.
      979     curr-col = browse br-obj:CURRENT-COLUMN:NAME.
      980     v-sort-column = curr-col.
      981     if curr-col = v-sort-column then do:
      982       v-sort-desc = not v-sort-desc.
      983     end.
      984     run update-br(curr-col, v-sort-desc).
      985   END.
      986   ON VALUE-CHANGED OF sel-obj-type IN FRAME Dialog-Frame
      987   DO:
      988     assign frame Dialog-Frame sel-obj-type.
      989     if sel-obj-type = 1 then do:
      990         enable b-sel-objs with frame Dialog-Frame.
      991     end.
      992     else do:
      993         disable b-sel-objs with frame Dialog-Frame.
      994     end.
      995   END.
      996   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      997   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      998   MAIN-BLOCK:
      999   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1000      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1001   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1002   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1003   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1004   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1005   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1006   define variable v-diasize-current-frame-height as decimal   no-undo .
     1007   define variable v-diasize-change-size          as logical   no-undo .
     1008   define variable v-diasize-resize-button        as handle    no-undo .
     1009   define variable v-diasize-wndmax               as logical   no-undo .
     1010   define variable v-diasize-wndstore             as logical   no-undo .
     1011   define variable v-diasize-proc-name            as character no-undo .
     1012   define variable v-diasize-browse-handle        as handle    no-undo .
     1013   define variable v-diasize-browse-number        as integer   no-undo .
     1014   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1015   define temp-table temp-diasize-handle no-undo
     1016     field handle-value  as handle
     1017     field save-position as decimal
     1018     index xpk is primary unique handle-value
     1019     .
     1020   define temp-table temp-browse-handle no-undo
     1021     field browse-type   as character
     1022     field browse-number as integer
     1023     field browse-handle as handle
     1024     field original-size as decimal
     1025     index xpk is primary unique browse-type browse-number
     1026     index xie browse-type browse-handle
     1027   .
     1028   procedure diasize_change-height :
     1029     define input  parameter p-change-value  as decimal   no-undo .
     1030     define input  parameter p-move-resize   as logical   no-undo .
     1031     define variable v-field-group-handle    as handle    no-undo .
     1032     define variable v-object-handle         as handle    no-undo .
     1033     define variable v-frame-height          as decimal   no-undo .
     1034     define variable v-frame-virtual-height  as decimal   no-undo .
     1035     define variable v-browse-height         as decimal   no-undo .
     1036     define variable v-window-height         as decimal   no-undo .
     1037     define variable v-window-virtual-height as decimal   no-undo .
     1038     define variable v-change-sign           as integer   no-undo .
     1039     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1040     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1041     if p-change-value > 0
     1042     then do:
     1043       if frame Dialog-Frame :height + p-change-value
     1044           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1045       then do:
     1046         assign
     1047           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1048                           - (frame Dialog-Frame :height-chars)
     1049         .
     1050         if p-change-value <= 0
     1051         then do:
     1052           run diasize_position-resize-button in this-procedure .
     1053           return .
     1054         end.
     1055       end.
     1056     end.
     1057     if p-change-value < 0
     1058     then do:
     1059       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1060       then do:
     1061         assign
     1062           p-change-value = v-diasize-orig-frame-height
     1063                          - (frame Dialog-Frame :height-chars)
     1064         .
     1065         if p-change-value >= 0
     1066         then do:
     1067           run diasize_position-resize-button in this-procedure .
     1068           return .
     1069         end.
     1070       end.
     1071     end.
     1072     if p-change-value >= 0
     1073     then do:
     1074       assign
     1075         v-change-sign = 1
     1076       .
     1077     end.
     1078     else do:
     1079       assign
     1080         v-change-sign = -1
     1081       .
     1082     end.
     1083     assign
     1084       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1085     .
     1086     if p-change-value = 0
     1087     then do:
     1088       run diasize_position-resize-button in this-procedure .
     1089       return .
     1090     end.
     1091     move_block:
     1092     do
     1093     on error undo move_block, retry move_block
     1094     :
     1095       if retry
     1096       then do:
     1097         do
     1098         on error undo move_block, leave move_block
     1099         :
     1100           if p-change-value > 0
     1101           then do:
     1102             for each buf_temp-diasize-handle
     1103             on error undo, next
     1104             :
     1105               assign
     1106                 v-object-handle = buf_temp-diasize-handle.handle-value
     1107               .
     1108               if v-object-handle <> v-diasize-resize-button
     1109               then do:
     1110                 assign
     1111                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1112                 .
     1113               end.
     1114             end.
     1115             assign
     1116               v-diasize-browse-handle :height = v-browse-height
     1117             .
     1118             for each buf_temp-browse-handle
     1119               where buf_temp-browse-handle.browse-type = 'height':u
     1120             on error undo, next
     1121             :
     1122               assign
     1123                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1124               .
     1125             end.
     1126             assign
     1127               frame Dialog-Frame :height = v-frame-height
     1128             .
     1129             if frame Dialog-Frame :scrollable = true
     1130             then do:
     1131               assign
     1132                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1133               .
     1134             end.
     1135             run diasize_position-resize-button in this-procedure .
     1136           end.
     1137           else do:
     1138             if frame Dialog-Frame :scrollable = true
     1139             then do:
     1140               assign
     1141                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1142               .
     1143             end.
     1144             assign
     1145               frame Dialog-Frame :height = v-frame-height
     1146             .
     1147             assign
     1148               v-diasize-browse-handle :height = v-browse-height
     1149             .
     1150             for each buf_temp-browse-handle
     1151               where buf_temp-browse-handle.browse-type = 'height':u
     1152             on error undo, next
     1153             :
     1154               assign
     1155                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1156               .
     1157             end.
     1158             for each buf_temp-diasize-handle
     1159             on error undo, next
     1160             :
     1161               assign
     1162                 v-object-handle = buf_temp-diasize-handle.handle-value
     1163               .
     1164               if v-object-handle <> v-diasize-resize-button
     1165               then do:
     1166                 assign
     1167                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1168                 .
     1169               end.
     1170             end.
     1171             run diasize_position-resize-button in this-procedure .
     1172           end.
     1173           assign
     1174             v-diasize-change-size = false
     1175           .
     1176           leave move_block .
     1177         end.
     1178       end.
     1179       assign
     1180         v-diasize-need-full-display = true
     1181       .
     1182       if v-diasize-change-size = false
     1183       then do:
     1184         assign
     1185           v-diasize-change-size = true
     1186         .
     1187       end.
     1188       else do:
     1189         return .
     1190       end.
     1191       assign
     1192         v-frame-height = frame Dialog-Frame :height
     1193         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1194         v-browse-height = v-diasize-browse-handle :height
     1195       .
     1196       for each buf_temp-browse-handle
     1197         where buf_temp-browse-handle.browse-type = 'height':u
     1198       :
     1199         assign
     1200           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1201         .
     1202       end.
     1203       for each buf_temp-diasize-handle
     1204       :
     1205         delete buf_temp-diasize-handle .
     1206       end.
     1207       assign
     1208         v-field-group-handle = frame Dialog-Frame :first-child
     1209       .
     1210       do while valid-handle(v-field-group-handle)
     1211       :
     1212         assign
     1213           v-object-handle = v-field-group-handle :first-child
     1214         .
     1215         do while valid-handle(v-object-handle)
     1216         :
     1217           if  v-object-handle <> v-diasize-browse-handle :handle
     1218           and can-query(v-object-handle, "row")
     1219           and can-query(v-object-handle, "height")
     1220           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1221           then do:
     1222             find first buf_temp-browse-handle
     1223               where buf_temp-browse-handle.browse-type   = 'height':u
     1224                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1225               no-error .
     1226             if available buf_temp-browse-handle
     1227             then do:
     1228             end.
     1229             else do:
     1230               create buf_temp-diasize-handle .
     1231               assign
     1232                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1233                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1234               .
     1235             end.
     1236           end.
     1237           assign
     1238             v-object-handle = v-object-handle :next-sibling
     1239           .
     1240         end.
     1241         assign
     1242           v-field-group-handle = v-field-group-handle :next-sibling
     1243         .
     1244       end.
     1245       do with frame Dialog-Frame
     1246       :
     1247         hide v-diasize-resize-button .
     1248         assign
     1249           v-diasize-resize-button :row    = 1
     1250           v-diasize-resize-button :column = 1
     1251         .
     1252       end.
     1253       if p-change-value > 0
     1254       then do:
     1255         if frame Dialog-Frame :scrollable = true
     1256         then do:
     1257           assign
     1258             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1259             no-error .
     1260           if error-status :error
     1261           or error-status :get-message(1) <> ""
     1262           then do:
     1263             undo move_block, retry move_block .
     1264           end.
     1265         end.
     1266         assign
     1267           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1268           no-error .
     1269         if error-status :error
     1270         or error-status :get-message(1) <> ""
     1271         then do:
     1272           undo move_block, retry move_block .
     1273         end.
     1274         assign
     1275           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1276           no-error .
     1277         if error-status :error
     1278         or error-status :get-message(1) <> ""
     1279         then do:
     1280           undo move_block, retry move_block .
     1281         end.
     1282         for each buf_temp-browse-handle
     1283           where buf_temp-browse-handle.browse-type = 'height':u
     1284         on error undo move_block, retry move_block
     1285         :
     1286           assign
     1287             buf_temp-browse-handle.browse-handle :height
     1288               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1289             no-error .
     1290           if error-status :error
     1291           or error-status :get-message(1) <> ""
     1292           then do:
     1293             undo move_block, retry move_block .
     1294           end.
     1295         end.
     1296         for each buf_temp-diasize-handle
     1297         on error undo move_block, retry move_block
     1298         :
     1299           assign
     1300             v-object-handle = buf_temp-diasize-handle.handle-value
     1301           .
     1302           if v-object-handle <> v-diasize-resize-button
     1303           then do:
     1304             assign
     1305               v-object-handle :row = v-object-handle :row + p-change-value
     1306               no-error .
     1307             if error-status :error
     1308             or error-status :get-message(1) <> ""
     1309             then do:
     1310               undo move_block, retry move_block .
     1311             end.
     1312           end.
     1313         end.
     1314       end.
     1315       else do:
     1316         for each buf_temp-diasize-handle
     1317         on error undo move_block, retry move_block
     1318         :
     1319           assign
     1320             v-object-handle = buf_temp-diasize-handle.handle-value
     1321           .
     1322           if v-object-handle <> v-diasize-resize-button
     1323           then do:
     1324             assign
     1325               v-object-handle :row = v-object-handle :row + p-change-value
     1326               no-error .
     1327             if error-status :error
     1328             or error-status :get-message(1) <> ""
     1329             then do:
     1330               undo move_block, retry move_block .
     1331             end.
     1332           end.
     1333         end.
     1334         assign
     1335           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1336           no-error .
     1337         if error-status :error
     1338         or error-status :get-message(1) <> ""
     1339         then do:
     1340           undo move_block, retry move_block .
     1341         end.
     1342         for each buf_temp-browse-handle
     1343           where buf_temp-browse-handle.browse-type = 'height':u
     1344         on error undo move_block, retry move_block
     1345         :
     1346           assign
     1347             buf_temp-browse-handle.browse-handle :height
     1348               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1349             no-error .
     1350           if error-status :error
     1351           or error-status :get-message(1) <> ""
     1352           then do:
     1353             undo move_block, retry move_block .
     1354           end.
     1355         end.
     1356         assign
     1357           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1358           no-error .
     1359         if error-status :error
     1360         or error-status :get-message(1) <> ""
     1361         then do:
     1362           undo move_block, retry move_block .
     1363         end.
     1364         if frame Dialog-Frame :scrollable = true
     1365         then do:
     1366           assign
     1367             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1368             no-error .
     1369           if error-status :error
     1370           or error-status :get-message(1) <> ""
     1371           then do:
     1372             undo move_block, retry move_block .
     1373           end.
     1374         end.
     1375       end.
     1376       if p-move-resize = true
     1377       then do:
     1378         run diasize_position-resize-button in this-procedure .
     1379       end.
     1380       if v-diasize-wndstore = true
     1381       then do:
     1382         if connected("ub") = true
     1383         then do:
     1384           define variable v-cntxt-db-num        as integer   no-undo .
     1385           define variable v-cntxt-userid        as character no-undo .
     1386           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1387                                             , OUTPUT v-cntxt-userid
     1388                                             ) .
     1389           run gbl/wndsizew.p
     1390             (input  v-cntxt-db-num
     1391             ,input  v-cntxt-userid
     1392             ,input  v-diasize-proc-name
     1393             ,input  'height':u
     1394             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1395             ) .
     1396         end.
     1397       end.
     1398     end.
     1399     assign
     1400       v-diasize-change-size = false
     1401     .
     1402   end procedure.
     1403   procedure diasize_set-height :
     1404     define input  parameter p-new-height  as decimal   no-undo .
     1405     define input  parameter p-move-resize as logical   no-undo .
     1406     do
     1407     on error undo, return error return-value
     1408     :
     1409       run diasize_change-height in this-procedure
     1410         (input  (p-new-height - frame Dialog-Frame :height)
     1411         ,input  p-move-resize
     1412         ) .
     1413     end.
     1414   end procedure.
     1415   procedure diasize_change-width :
     1416     define input  parameter p-change-value as decimal   no-undo .
     1417     define input  parameter p-move-resize  as logical   no-undo .
     1418     define variable v-field-group-handle   as handle    no-undo .
     1419     define variable v-object-handle        as handle    no-undo .
     1420     define variable v-frame-width          as decimal   no-undo .
     1421     define variable v-frame-virtual-width  as decimal   no-undo .
     1422     define variable v-browse-width         as decimal   no-undo .
     1423     define variable v-window-width         as decimal   no-undo .
     1424     define variable v-window-virtual-width as decimal   no-undo .
     1425     define variable v-change-sign          as integer   no-undo .
     1426     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1427     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1428     if p-change-value > 0
     1429     then do:
     1430       if frame Dialog-Frame :width + p-change-value >
     1431           session :width-chars
     1432       then do:
     1433         assign
     1434           p-change-value = session :width-chars - frame Dialog-Frame :width
     1435         .
     1436         if p-change-value <= 0
     1437         then do:
     1438           run diasize_position-resize-button in this-procedure .
     1439           return .
     1440         end.
     1441       end.
     1442     end.
     1443     if p-change-value < 0
     1444     then do:
     1445       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1446       then do:
     1447         assign
     1448           p-change-value = v-diasize-orig-frame-width
     1449                          - frame Dialog-Frame :width
     1450         .
     1451         if p-change-value >= 0
     1452         then do:
     1453           run diasize_position-resize-button in this-procedure .
     1454           return .
     1455         end.
     1456       end.
     1457     end.
     1458     if p-change-value >= 0
     1459     then do:
     1460       assign
     1461         v-change-sign = 1
     1462       .
     1463     end.
     1464     else do:
     1465       assign
     1466         v-change-sign = -1
     1467       .
     1468     end.
     1469     assign
     1470       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1471     .
     1472     if p-change-value = 0
     1473     then do:
     1474       run diasize_position-resize-button in this-procedure .
     1475       return .
     1476     end.
     1477     move_block:
     1478     do
     1479     on error undo move_block, leave move_block
     1480     :
     1481       if retry
     1482       then do:
     1483         do
     1484         on error undo move_block, leave move_block
     1485         :
     1486           if p-change-value > 0
     1487           then do:
     1488             for each buf_temp-diasize-handle
     1489             on error undo, next
     1490             :
     1491               assign
     1492                 v-object-handle = buf_temp-diasize-handle.handle-value
     1493               .
     1494               if v-object-handle <> v-diasize-resize-button
     1495               then do:
     1496                 assign
     1497                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1498                 .
     1499               end.
     1500             end.
     1501             assign
     1502               v-diasize-browse-handle :width = v-browse-width
     1503             .
     1504             for each buf_temp-browse-handle
     1505               where buf_temp-browse-handle.browse-type = 'width':u
     1506             on error undo, next
     1507             :
     1508               assign
     1509                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1510               .
     1511             end.
     1512             assign
     1513               frame Dialog-Frame :width = v-frame-width
     1514             .
     1515             if frame Dialog-Frame :scrollable = true
     1516             then do:
     1517               assign
     1518                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1519               .
     1520             end.
     1521             run diasize_position-resize-button in this-procedure .
     1522           end.
     1523           else do:
     1524             if frame Dialog-Frame :scrollable = true
     1525             then do:
     1526               assign
     1527                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1528               .
     1529             end.
     1530             assign
     1531               frame Dialog-Frame :width = v-frame-width
     1532             .
     1533             for each buf_temp-browse-handle
     1534               where buf_temp-browse-handle.browse-type = 'width':u
     1535             on error undo, next
     1536             :
     1537               assign
     1538                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1539               .
     1540             end.
     1541             assign
     1542               v-diasize-browse-handle :width = v-browse-width
     1543             .
     1544             for each buf_temp-diasize-handle
     1545             on error undo, next
     1546             :
     1547               assign
     1548                 v-object-handle = buf_temp-diasize-handle.handle-value
     1549               .
     1550               if v-object-handle <> v-diasize-resize-button
     1551               then do:
     1552                 assign
     1553                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1554                 .
     1555               end.
     1556             end.
     1557             run diasize_position-resize-button in this-procedure .
     1558           end.
     1559           assign
     1560             v-diasize-change-size = false
     1561           .
     1562           leave move_block .
     1563         end.
     1564       end.
     1565       assign
     1566         v-diasize-need-full-display = true
     1567       .
     1568       if v-diasize-change-size = false
     1569       then do:
     1570         assign
     1571           v-diasize-change-size = true
     1572         .
     1573       end.
     1574       else do:
     1575         return .
     1576       end.
     1577       assign
     1578         v-frame-width = frame Dialog-Frame :width
     1579         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1580         v-browse-width = v-diasize-browse-handle :width
     1581       .
     1582       for each buf_temp-browse-handle
     1583         where buf_temp-browse-handle.browse-type = 'width':u
     1584       :
     1585         assign
     1586           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1587         .
     1588       end.
     1589       for each buf_temp-diasize-handle
     1590       :
     1591         delete buf_temp-diasize-handle .
     1592       end.
     1593       assign
     1594         v-field-group-handle = frame Dialog-Frame :first-child
     1595       .
     1596       do while valid-handle(v-field-group-handle)
     1597       :
     1598         assign
     1599           v-object-handle = v-field-group-handle :first-child
     1600         .
     1601         do while valid-handle(v-object-handle)
     1602         :
     1603           if  v-object-handle <> v-diasize-browse-handle :handle
     1604           and v-object-handle <> v-diasize-resize-button
     1605           and can-query(v-object-handle, "row")
     1606           and can-query(v-object-handle, "height")
     1607           and ( v-object-handle :col + v-object-handle :width
     1608                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1609               )
     1610           then do:
     1611             find first buf_temp-browse-handle
     1612               where buf_temp-browse-handle.browse-type   = 'width':u
     1613                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1614               no-error .
     1615             if available buf_temp-browse-handle
     1616             then do:
     1617             end.
     1618             else do:
     1619               create buf_temp-diasize-handle .
     1620               assign
     1621                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1622                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1623               .
     1624             end.
     1625           end.
     1626           assign
     1627             v-object-handle = v-object-handle :next-sibling
     1628           .
     1629         end.
     1630         assign
     1631           v-field-group-handle = v-field-group-handle :next-sibling
     1632         .
     1633       end.
     1634       do with frame Dialog-Frame
     1635       :
     1636         hide v-diasize-resize-button .
     1637         v-diasize-resize-button :row = 1.
     1638         v-diasize-resize-button :column = 1.
     1639       end.
     1640       if p-change-value > 0
     1641       then do:
     1642         if frame Dialog-Frame :scrollable = true
     1643         then do:
     1644           assign
     1645             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1646             no-error .
     1647           if error-status :error
     1648           or error-status :get-message(1) <> ""
     1649           then do:
     1650             undo move_block, retry move_block.
     1651           end.
     1652         end.
     1653         assign
     1654           frame Dialog-Frame :width = v-frame-width + p-change-value
     1655           no-error .
     1656         if error-status :error
     1657         or error-status :get-message(1) <> ""
     1658         then do:
     1659           undo move_block, retry move_block.
     1660         end.
     1661         assign
     1662           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1663         no-error .
     1664         if error-status :error
     1665         or error-status :get-message(1) <> ""
     1666         then do:
     1667           undo move_block, retry move_block.
     1668         end.
     1669         for each buf_temp-browse-handle
     1670           where buf_temp-browse-handle.browse-type = 'width':u
     1671         on error undo move_block, retry move_block
     1672         :
     1673           assign
     1674             buf_temp-browse-handle.browse-handle :width
     1675               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1676             no-error .
     1677           if error-status :error
     1678           or error-status :get-message(1) <> ""
     1679           then do:
     1680             undo move_block, retry move_block .
     1681           end.
     1682         end.
     1683         for each buf_temp-diasize-handle
     1684         on error undo move_block, retry move_block
     1685         :
     1686           assign
     1687             v-object-handle = buf_temp-diasize-handle.handle-value
     1688           .
     1689           if v-object-handle <> v-diasize-resize-button
     1690           then do:
     1691             assign
     1692               v-object-handle :col = v-object-handle :col + p-change-value
     1693               no-error .
     1694             if error-status :error
     1695             or error-status :get-message(1) <> ""
     1696             then do:
     1697               undo move_block, retry move_block .
     1698             end.
     1699           end.
     1700         end.
     1701       end.
     1702       else do:
     1703         for each buf_temp-diasize-handle
     1704         on error undo move_block, retry move_block
     1705         :
     1706           assign
     1707             v-object-handle = buf_temp-diasize-handle.handle-value
     1708           .
     1709           if v-object-handle <> v-diasize-resize-button
     1710           then do:
     1711             assign
     1712               v-object-handle :col = v-object-handle :col + p-change-value
     1713               no-error .
     1714             if error-status :error
     1715             or error-status :get-message(1) <> ""
     1716             then do:
     1717               undo move_block, retry move_block .
     1718             end.
     1719           end.
     1720         end.
     1721         for each buf_temp-browse-handle
     1722           where buf_temp-browse-handle.browse-type = 'width':u
     1723         on error undo move_block, retry move_block
     1724         :
     1725           assign
     1726             buf_temp-browse-handle.browse-handle :width
     1727               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1728             no-error .
     1729           if error-status :error
     1730           or error-status :get-message(1) <> ""
     1731           then do:
     1732             undo move_block, retry move_block .
     1733           end.
     1734         end.
     1735         assign
     1736           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1737           no-error .
     1738         if error-status :error
     1739         or error-status :get-message(1) <> ""
     1740         then do:
     1741           undo move_block, retry move_block.
     1742         end.
     1743         assign
     1744           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1745         no-error .
     1746         if error-status :error
     1747         or error-status :get-message(1) <> ""
     1748         then do:
     1749           undo move_block, retry move_block.
     1750         end.
     1751         if frame Dialog-Frame :scrollable = true
     1752         then do:
     1753           assign
     1754             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1755           no-error .
     1756           if error-status :error
     1757           or error-status :get-message(1) <> ""
     1758           then do:
     1759             undo move_block, retry move_block.
     1760           end.
     1761         end.
     1762       end.
     1763       if p-move-resize
     1764       then do:
     1765         run diasize_position-resize-button in this-procedure .
     1766       end.
     1767       if v-diasize-wndstore = true
     1768       then do:
     1769         if connected("ub") = true
     1770         then do:
     1771           define variable v-cntxt-db-num        as integer   no-undo .
     1772           define variable v-cntxt-userid        as character no-undo .
     1773           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1774                                             , OUTPUT v-cntxt-userid
     1775                                             ) .
     1776           run gbl/wndsizew.p
     1777             (input  v-cntxt-db-num
     1778             ,input  v-cntxt-userid
     1779             ,input  v-diasize-proc-name
     1780             ,input  'width':u
     1781             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1782             ) .
     1783         end.
     1784       end.
     1785     end.
     1786     assign
     1787       v-diasize-change-size = false
     1788     .
     1789   end procedure.
     1790   procedure diasize_set-width :
     1791     define input  parameter p-new-width  as decimal   no-undo .
     1792     define input  parameter p-move-resize as logical   no-undo .
     1793     do
     1794     on error undo, return error return-value
     1795     :
     1796       run diasize_change-width in this-procedure
     1797         (input  (p-new-width - frame Dialog-Frame :width)
     1798         ,input  p-move-resize
     1799         ) .
     1800     end.
     1801   end procedure.
     1802   procedure diasize_position-resize-button :
     1803     do with frame Dialog-Frame
     1804     :
     1805       hide v-diasize-resize-button .
     1806       assign
     1807         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1808                     - 1
     1809                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1810         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1811                     - 1
     1812                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1813       .
     1814       view v-diasize-resize-button .
     1815     end.
     1816   end procedure.
     1817   on alt-right anywhere
     1818   do:
     1819     run diasize_change-width in this-procedure
     1820       (input 1
     1821       ,input true
     1822       ) .
     1823     return no-apply .
     1824   end.
     1825   on alt-left anywhere
     1826   do:
     1827     run diasize_change-width in this-procedure
     1828       (input -1
     1829       ,input true
     1830       ) .
     1831     return no-apply .
     1832   end.
     1833   on alt-down anywhere
     1834   do:
     1835     run diasize_change-height in this-procedure
     1836       (input 1
     1837       ,input true
     1838       ) .
     1839     return no-apply .
     1840   end.
     1841   on alt-up anywhere
     1842   do:
     1843     run diasize_change-height in this-procedure
     1844       (input -1
     1845       ,input true
     1846       ) .
     1847     return no-apply .
     1848   end.
     1849   on alt-enter of frame Dialog-Frame
     1850   do:
     1851     run diasize_maximize in this-procedure
     1852       (input  ?
     1853       ).
     1854     return no-apply .
     1855   end.
     1856   procedure diasize_end-move :
     1857     do
     1858     on error undo, return error return-value
     1859     :
     1860       define variable v-row-delta as decimal   no-undo .
     1861       define variable v-col-delta as decimal   no-undo .
     1862       define variable v-new-row as decimal   no-undo .
     1863       define variable v-new-col as decimal   no-undo .
     1864       assign
     1865         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1866         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1867       .
     1868       assign
     1869         v-row-delta = v-new-row - frame Dialog-Frame :height
     1870         v-col-delta = v-new-col - frame Dialog-Frame :width
     1871       .
     1872       run diasize_change-height in this-procedure
     1873         (input v-row-delta
     1874         ,input true
     1875         ) .
     1876       run diasize_change-width in this-procedure
     1877         (input v-col-delta
     1878         ,input true
     1879         ) .
     1880     end.
     1881   end procedure.
     1882   procedure diasize_maximize :
     1883     define input  parameter p-action as logical   no-undo .
     1884     do
     1885     on error undo, return error return-value
     1886     :
     1887       if p-action = ?
     1888       then do:
     1889         if v-diasize-need-maximize = true
     1890         then do:
     1891           assign
     1892             p-action = true
     1893           .
     1894         end.
     1895         else do:
     1896           assign
     1897             p-action = false
     1898           .
     1899         end.
     1900       end.
     1901       if p-action = true
     1902       then do:
     1903         run diasize_change-height in this-procedure
     1904           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1905               - frame Dialog-Frame :height-chars
     1906           ,input true
     1907           ) .
     1908         run diasize_change-width in this-procedure
     1909           (input session :width-chars
     1910               - frame Dialog-Frame :width-chars
     1911           ,input true
     1912           ) .
     1913         assign
     1914           v-diasize-need-maximize = false
     1915         .
     1916       end.
     1917       else do:
     1918         run diasize_change-width in this-procedure
     1919           (input v-diasize-orig-frame-width
     1920               - frame Dialog-Frame :width-chars
     1921           ,input true
     1922           ) .
     1923         run diasize_change-height in this-procedure
     1924           (input v-diasize-orig-frame-height
     1925               - frame Dialog-Frame :height-chars
     1926           ,input true
     1927           ) .
     1928         assign
     1929           v-diasize-need-maximize = true
     1930         .
     1931       end.
     1932     end.
     1933   end procedure.
     1934   procedure diasize_restore-orig-size :
     1935     do
     1936     on error undo, return error return-value
     1937     :
     1938       assign
     1939         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1940         v-diasize-current-frame-height = frame Dialog-Frame :height
     1941       .
     1942       run diasize_set-height in this-procedure
     1943         (input  v-diasize-orig-frame-height
     1944         ,input  true
     1945         ) .
     1946       run diasize_set-width in this-procedure
     1947         (input  v-diasize-orig-frame-width
     1948         ,input  true
     1949         ) .
     1950     end.
     1951   end procedure.
     1952   procedure diasize_restore-current-size :
     1953     do
     1954     on error undo, return error return-value
     1955     :
     1956       run diasize_set-height in this-procedure
     1957         (input  v-diasize-current-frame-height
     1958         ,input  true
     1959         ) .
     1960       run diasize_set-width in this-procedure
     1961         (input  v-diasize-current-frame-width
     1962         ,input  true
     1963         ) .
     1964     end.
     1965   end procedure.
     1966   procedure diasize_set-browse-handle :
     1967     define input  parameter p-browse-handle as handle   no-undo .
     1968     define buffer buf_temp-browse-handle for temp-browse-handle .
     1969     do
     1970     on error undo, return error return-value
     1971     :
     1972       assign
     1973         v-diasize-browse-handle = p-browse-handle
     1974       .
     1975       for each buf_temp-browse-handle
     1976       on error undo, return error return-value
     1977       :
     1978         delete buf_temp-browse-handle .
     1979       end.
     1980     end.
     1981   end procedure.
     1982   procedure diasize_add_browse :
     1983     define input  parameter p-browse-type   as character no-undo .
     1984     define input  parameter p-browse-handle as handle    no-undo .
     1985     define buffer buf_temp-browse-handle for temp-browse-handle .
     1986     do
     1987     on error undo, return error return-value
     1988     :
     1989       assign
     1990         v-diasize-browse-number = v-diasize-browse-number + 1
     1991       .
     1992       create buf_temp-browse-handle .
     1993       assign
     1994         buf_temp-browse-handle.browse-type   = p-browse-type
     1995         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1996         buf_temp-browse-handle.browse-handle = p-browse-handle
     1997       .
     1998     end.
     1999   end procedure.
     2000   procedure diasize_init :
     2001     define variable v-default-value    as logical   no-undo .
     2002     define variable v-restore-saved    as logical   no-undo .
     2003     define variable v-resize-value-str as character no-undo .
     2004     do
     2005     on error undo, return error return-value
     2006     :
     2007       do with frame Dialog-Frame
     2008       :
     2009         assign
     2010           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2011           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2012           v-diasize-browse-handle     = browse br-obj :handle
     2013         .
     2014         create button v-diasize-resize-button
     2015         assign
     2016           parent        = frame Dialog-Frame :first-child
     2017           label         = "s"
     2018           height-pixels = 16
     2019           width-pixels  = 16
     2020           visible       = true
     2021           sensitive     = true
     2022           movable       = true
     2023           triggers:
     2024             on end-move persistent run diasize_end-move in this-procedure .
     2025           end triggers.
     2026         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2027         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2028         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2029         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2030         assign
     2031           v-diasize-wndmax = false
     2032         .
     2033         if connected("ub") = true
     2034         then do:
     2035           define variable v-cntxt-db-num        as integer   no-undo .
     2036           define variable v-cntxt-userid        as character no-undo .
     2037           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2038                                             , OUTPUT v-cntxt-userid
     2039                                             ) .
     2040           run gbl/wndpar_r.p
     2041             (input  v-cntxt-db-num
     2042             ,input  v-cntxt-userid
     2043             ,input  'wndmax':U
     2044             ,output v-diasize-wndmax
     2045             ,output v-default-value
     2046             ) .
     2047         end.
     2048         assign
     2049           v-diasize-wndstore = false
     2050         .
     2051         if connected("ub") = true
     2052         then do:
     2053           run gbl/wndpar_r.p
     2054             (input  v-cntxt-db-num
     2055             ,input  v-cntxt-userid
     2056             ,input  'wndstore':U
     2057             ,output v-diasize-wndstore
     2058             ,output v-default-value
     2059             ) .
     2060         end.
     2061         assign
     2062           v-diasize-proc-name = entry(1, program-name(2), '.')
     2063         .
     2064         if v-diasize-wndstore = true
     2065         then do:
     2066           assign
     2067             v-restore-saved = false
     2068           .
     2069           if connected("ub") = true
     2070           then do:
     2071             run gbl/wndsizer.p
     2072               (input  v-cntxt-db-num
     2073               ,input  v-cntxt-userid
     2074               ,input  v-diasize-proc-name
     2075               ,input  'height':u
     2076               ,output v-resize-value-str
     2077               ) .
     2078             if v-resize-value-str <> '':U
     2079             then do:
     2080               run diasize_change-height in this-procedure
     2081                 (input  integer(v-resize-value-str)
     2082                 ,input  true
     2083                 ) .
     2084               assign
     2085                 v-restore-saved = true
     2086               .
     2087             end.
     2088           end.
     2089           if connected("ub") = true
     2090           then do:
     2091             run gbl/wndsizer.p
     2092               (input  v-cntxt-db-num
     2093               ,input  v-cntxt-userid
     2094               ,input  v-diasize-proc-name
     2095               ,input  'width':u
     2096               ,output v-resize-value-str
     2097               ) .
     2098             if v-resize-value-str <> '':U
     2099             then do:
     2100               run diasize_change-width in this-procedure
     2101                 (input  integer(v-resize-value-str)
     2102                 ,input  true
     2103                 ) .
     2104               assign
     2105                 v-restore-saved = true
     2106               .
     2107             end.
     2108           end.
     2109           if v-restore-saved <> true
     2110           then do:
     2111             if v-diasize-wndmax = true
     2112             then do:
     2113               run diasize_maximize in this-procedure
     2114                 (input  true
     2115                 ) .
     2116             end.
     2117           end.
     2118         end.
     2119         else do:
     2120           if v-diasize-wndmax = true
     2121           then do:
     2122             run diasize_maximize in this-procedure
     2123               (input  true
     2124               ) .
     2125           end.
     2126         end.
     2127       end.
     2128     end.
     2129   end procedure.
     2130   procedure diasize_need-full-display :
     2131     define output parameter p-need-full-display as logical   no-undo .
     2132     do
     2133     on error undo, return error return-value
     2134     :
     2135       assign
     2136         p-need-full-display = v-diasize-need-full-display
     2137       .
     2138       assign
     2139         v-diasize-need-full-display = false
     2140       .
     2141     end.
     2142   end procedure.
     2143   procedure get-context :
     2144      define output parameter p-db-num as integer          no-undo.
     2145      define output parameter p-user-id as character        no-undo.
     2146      define variable v-login               as character    no-undo.
     2147      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2148      define buffer buf_user-login  for ub.user-login .
     2149      do
     2150      on error undo, return error
     2151      :
     2152            FIND FIRST buf_sys-ctrl no-lock.
     2153            ASSIGN
     2154               v-login = USERID("ub")
     2155               p-db-num = buf_sys-ctrl.db-num
     2156            .
     2157            FIND FIRST buf_user-login
     2158                 WHERE buf_user-login.db-num = p-db-num
     2159                   AND buf_user-login.user-login = v-login
     2160                 no-lock
     2161                 no-error
     2162                 .
     2163            IF AVAILABLE buf_user-login
     2164            THEN DO:
     2165               assign
     2166                  p-user-id = buf_user-login.user-id
     2167               .
     2168            END.
     2169      end.
     2170   end procedure.
     2171     run diasize_init in this-procedure.
     2172     RUN enable_UI.
     2173     WAIT-FOR GO OF FRAME Dialog-Frame.
     2174   END.
     2175   RUN disable_UI.
     2176   PROCEDURE disable_UI :
     2177     HIDE FRAME Dialog-Frame.
     2178   END PROCEDURE.
     2179   PROCEDURE enable_UI :
     2180     DISPLAY sel-obj-type allow-days
     2181         WITH FRAME Dialog-Frame.
     2182     ENABLE b_OK RECT-1 RECT-2 b-print b-refresh sel-obj-type allow-days br-obj
     2183         WITH FRAME Dialog-Frame.
     2184     VIEW FRAME Dialog-Frame.
     2185     OPEN QUERY br-obj FOR EACH tt-obj.
     2186   END PROCEDURE.
     2187   PROCEDURE prepare-row :
     2188   def param buffer bf_clients for ub.clients.
     2189   def var v-bge-incr-last-shift-date as char no-undo.
     2190   def var v-bge-incr-last-shift-num as char no-undo.
     2191   def var v-type as char no-undo.
     2192   def var v-obj-date as date no-undo.
     2193   def var v-obj-shift as logical no-undo.
     2194   def var v-shift-date as date no-undo.
     2195   def var v-shift-num as int no-undo.
     2196   def var v-shift-name as char no-undo.
     2197   if (bf_clients.obj-type = 'маг':U or bf_clients.obj-type = 'скл':U)
     2198       and bf_clients.stts = 0  then do:
     2199   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2200   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2201     (input  bf_clients.obj-type
     2202     ,input  bf_clients.obj-code
     2203     ,input  'shift-on=request'
     2204     ,output v-obj-shift
     2205     ) no-error .
     2206       if error-status:error or not v-obj-shift then return.
     2207       run clntattr-value(
     2208           bf_clients.obj-type,
     2209           bf_clients.obj-code,
     2210           'bge-incr-last-shift-date':U,
     2211           output v-bge-incr-last-shift-date,
     2212           output v-type
     2213       ).
     2214       run clntattr-value(
     2215           bf_clients.obj-type,
     2216           bf_clients.obj-code,
     2217           'bge-incr-last-shift-num':U,
     2218           output v-bge-incr-last-shift-num,
     2219           output v-type
     2220       ).
     2221       if v-bge-incr-last-shift-date = "" or v-bge-incr-last-shift-num = "" then return.
     2222   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2223   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     2224     (input  bf_clients.obj-type
     2225     ,input  bf_clients.obj-code
     2226     ,output v-obj-date
     2227     ) no-error .
     2228       if error-status:error then return.
     2229   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2230   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     2231     (input  bf_clients.obj-type
     2232     ,input  bf_clients.obj-code
     2233     ,output v-shift-date
     2234     ,output v-shift-num
     2235     ,output v-shift-name
     2236     ) no-error .
     2237       if error-status:error then return.
     2238       create tt-obj.
     2239       assign
     2240           tt-obj.db-num = bf_clients.db-num
     2241           tt-obj.obj-code = bf_clients.obj-code
     2242           tt-obj.obj-type = bf_clients.obj-type
     2243           tt-obj.obj-name = bf_clients.obj-name
     2244           tt-obj.last-upload-date = v-bge-incr-last-shift-date
     2245           tt-obj.last-upload-shift = v-bge-incr-last-shift-num
     2246           tt-obj.obj-date = v-obj-date
     2247           tt-obj.obj-shift = substitute("&1 &2", v-shift-date, v-shift-num)
     2248           tt-obj.date-delta = interval(v-obj-date, date(v-bge-incr-last-shift-date), "days").
     2249       .
     2250   end.
     2251   END PROCEDURE.
     2252   PROCEDURE prepare-rows :
     2253   def buffer bf_clients for ub.clients.
     2254   run waitfram-show("Обновление...").
     2255   EMPTY TEMP-TABLE tt-obj.
     2256   if sel-obj-type = 2 then do:
     2257       for each bf_clients
     2258           where (bf_clients.obj-type = 'маг':U or bf_clients.obj-type = 'скл':U)
     2259           and bf_clients.stts = 0
     2260           no-lock:
     2261           run prepare-row(buffer bf_clients).
     2262       end.
     2263   end.
     2264   else do:
     2265       for each userobjs_temp-user-obj no-lock:
     2266           find first bf_clients
     2267               where bf_clients.obj-type = userobjs_temp-user-obj.obj-type
     2268               and bf_clients.obj-code = userobjs_temp-user-obj.obj-code
     2269               no-lock.
     2270           run prepare-row(buffer bf_clients).
     2271       end.
     2272   end.
     2273   run waitfram-hide.
     2274   END PROCEDURE.
     2275   PROCEDURE update-br :
     2276   def input param p-sort-field as char no-undo.
     2277   def input param p-sort-desc as logical no-undo.
     2278   def var str as char no-undo init "for each tt-obj no-lock by ".
     2279   str = str + p-sort-field.
     2280   if p-sort-desc then
     2281       str = str + " DESC".
     2282   query br-obj:QUERY-CLOSE ().
     2283   query br-obj:QUERY-PREPARE(str).
     2284   query br-obj:QUERY-OPEN().
     2285   END PROCEDURE.
