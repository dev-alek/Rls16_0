        1   using ibs.th.str.*.
        2   block-level on error undo, throw.
        3   define variable vss-revision    as character no-undo init "$Revision: bed8e2b06c8e, 2357, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
        5   define variable vss-date        as character no-undo init "$Date: Ср июн 10 21:13:34 2020 +0300 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: hdd-report-shd.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: rep/hdd-report-shd.p $":U .
        8   define variable vss-description as character no-undo init "Результаты проверки HDD".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define input parameter parparentproc    as widget-handle           no-undo.
       64   define input parameter p-Date-start     as date no-undo .
       65   define input parameter p-Date-end     as date no-undo .
       66   define input parameter p-obj-list  as character no-undo .
       67   define input parameter p-folder  as character no-undo .
       68   define input parameter p-file  as character no-undo .
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       76   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       77   define  shared variable RepPathName        as character no-undo .
       78   define  shared variable PrintRubl          as logical   no-undo .
       79   define new global shared variable g#lib-trn  as handle no-undo .
       80   define new global shared variable g#lib-trn2 as handle no-undo .
       81   define new global shared variable g#lib-trn3 as handle no-undo .
       82   define new global shared variable g#lib-trn4 as handle no-undo .
       83   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       84   define  stream PrnLibStream.
       85   procedure prn-lib-prn-file :
       86     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
       87     define input parameter p-DIsabledoptions as integer no-undo .
       88     define variable v-report-name as character no-undo .
       89     define variable v-user-action as character no-undo .
       90     define variable v-printed     as logical   no-undo .
       91     define variable v-exist       as logical   no-undo .
       92     do
       93       on error undo, return error
       94       :
       95       run prn-lib-get-report-name  in this-procedure (
       96         input parParentProc
       97         ,output v-report-name
       98         ).
       99   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      100   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      101     (input  v-report-name
      102     ,input  2
      103     ,output v-exist
      104     )  .
      105       if NOT v-exist then
      106       DO:
      107         Message
      108           "Нет заданий на печать ! "
      109           view-as alert-box .
      110         Return  .
      111       End.
      112       run gbl/prnfilen.w
      113         (input  ""
      114         ,input  p-DisabledOptions
      115         ,input  string(v-report-name )
      116         ,input  7
      117         ,output v-user-action
      118         ,output v-printed
      119         ) .
      120       if v-printed then
      121       do:
      122         return "YES" .
      123       end.
      124       else
      125       do:
      126         return "NO" .
      127       end.
      128     end.
      129   end procedure.
      130   procedure prn-lib-open-stream :
      131     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      132     define input parameter p-page-size    as integer no-undo .
      133     define input parameter p-is-stream    as logical no-undo .
      134     define input parameter p-append       as logical no-undo .
      135     define variable v-report-name as character no-undo .
      136     do
      137       on error undo, return error
      138       :
      139       run prn-lib-get-report-name  in this-procedure (
      140         input parParentProc
      141         ,output v-report-name
      142         ).
      143       if p-is-stream then
      144       do:
      145         if p-append then
      146         do:
      147           output stream PrnLibStream to value( v-report-name )
      148             page-size value(p-page-size) append .
      149         end.
      150         if not p-append then
      151         do:
      152           output stream PrnLibStream to value( v-report-name )
      153             page-size value(p-page-size) .
      154         end.
      155       end.
      156       if not p-is-stream then
      157       do:
      158         if p-append then
      159         do:
      160           output to value( v-report-name )
      161             page-size value(p-page-size) append .
      162         end.
      163         if not p-append then
      164         do:
      165           output to value( v-report-name )
      166             page-size value(p-page-size) .
      167         end.
      168       end.
      169     end.
      170   end procedure.
      171   procedure prn-lib-open-exp :
      172     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      173     define input parameter p-is-stream    as logical no-undo .
      174     define input parameter p-is-append    as logical no-undo .
      175     define output parameter p-ReportFileName as char init "report" no-undo.
      176     define output parameter p-process as logical no-undo .
      177     define variable glog as logical no-undo .
      178     do
      179       on error undo, return error
      180       :
      181       SYSTEM-DIALOG GET-FILE p-ReportFileName
      182         TITLE      "Укажите путь"
      183         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      184         ASK-OVERWRITE
      185         CREATE-TEST-FILE
      186         SAVE-AS
      187         USE-FILENAME
      188         DEFAULT-EXTENSION "txt"
      189         UPDATE glog
      190         .
      191       if not glog then  return.
      192       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      193       if p-is-stream then
      194       do:
      195         if p-is-append then
      196         do:
      197           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      198         end.
      199         else
      200         do:
      201           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      202         end.
      203       end.
      204       else
      205       do:
      206         if p-is-append then
      207         do:
      208           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      209         end.
      210         else
      211         do:
      212           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      213         end.
      214       end.
      215       p-process = yes.
      216     end.
      217   end procedure.
      218   procedure prn-lib-get-report-name :
      219     define input parameter parParentProc  as widget-handle no-undo.
      220     define output parameter p-report-name as character no-undo .
      221     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      222   end procedure.
      223   procedure prn-lib-reportviewer-report-name :
      224     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      225     define input parameter p-report-name-html as character no-undo .
      226     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      227   end procedure.
      228   procedure prn-lib-reportviewer :
      229     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      230     define input parameter p-report-name-html as character no-undo .
      231     define input parameter p-param        as character no-undo .
      232     define variable v-excel           as character no-undo init 'TRUE' .
      233     define variable v-value-character as character no-undo .
      234     define variable v-value-integer   as character no-undo .
      235     define variable v-value-date      as date      no-undo .
      236     define variable v-value-decimal   as decimal   no-undo .
      237     define variable rep-excel         as logical   no-undo .
      238     define variable excel-string      as character no-undo .
      239     define variable v-param-type      as character no-undo .
      240     define variable v-tth             as handle    no-undo .
      241     run adm/shattri.p (
      242       input "get":U
      243       ,input  ""
      244       ,input  0
      245       ,input  'report-glob':U
      246       ,input  'rep-excel':U
      247       ,output v-value-character
      248       ,output v-value-date
      249       ,output v-value-decimal
      250       ,output v-value-integer
      251       ,output rep-excel
      252       ,output v-param-type
      253       ,INPUT-OUTPUT table-handle v-tth
      254       )  .
      255     if rep-excel then v-excel = "TRUE" .
      256     else v-excel = "FALSE" .
      257     if p-param eq ""
      258     then
      259        p-param = "EXCEL:" + v-excel.
      260     else
      261        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      262     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      263   end procedure.
      264   function fnc-convert-dot-to-colon returns character
      265       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
      266   function fnc-convert-dot-to-colon returns character
      267   (input p-data as decimal, input p-accur as character, input p-num as integer):
      268       define variable result as character no-undo.
      269       define variable v-str-result as character no-undo.
      270       if p-data = ? then p-data = 0 .
      271       p-data = round(p-data, p-num).
      272       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
      273       return v-str-result.
      274   END FUNCTION.
      275   define temp-table tt-devicePC no-undo
      276     field id          as integer
      277     field modeldevice like ub.devisPC.modeldevice
      278     field ModelPC     like ub.devisPC.ModelPC
      279     field namepc      like ub.devisPC.namepc
      280     field date_start  as character
      281     field time_start  as character
      282     field date_end    as character
      283     field time_end    as character
      284     field ProcDisk    as decimal
      285     field UserProc    as decimal
      286     field status_     as character
      287     field db-num      as integer
      288     index pi id .
      289   define temp-table tt-devicePCAttr no-undo
      290     field id        as integer
      291     field date_     as date
      292     field time_     as integer
      293     field name_     as character
      294     field db-num    as integer
      295     field value_    as decimal
      296     field tresh     as decimal
      297     field type_     as character
      298     field raw_value as character
      299     field ch_raw    as decimal
      300     field ch_val    as decimal
      301     index pi id
      302     .
      303   define temp-table tt-attrDevis like ub.devisPC-attr
      304     index pi id db-num
      305     asc date asc time_.
      306   define buffer buf_devisPC        for ub.devisPC .
      307   define buffer buf_devisPCAttr    for ub.devisPC-attr .
      308   define buffer bf_devisPCAttr     for ub.devisPC-attr .
      309   define buffer bt_devisPCAttr     for ub.devisPC-attr .
      310   define buffer buf_devisPC-attr   for ub.devisPC-attr .
      311   define buffer buf_tt-devisPCAttr for tt-devicePCAttr .
      312   define buffer buf_tt-devicePC    for tt-devicePC .
      313   define stream Out-Stream.
      314   define stream OutStr-html.
      315   define stream Outhtmllog.
      316   define VARIABLE p-report-id         as character no-undo .
      317   define variable v-file-name-rep-htm as character no-undo .
      318   define variable ii                  as integer   no-undo .
      319   define variable jj                  as integer   no-undo .
      320   define variable v-change-Raw        as decimal   no-undo .
      321   define variable v-change-Value      as decimal   no-undo .
      322   define variable v-ok-Raw            as decimal   no-undo .
      323   define variable v-ok-Value          as decimal   no-undo .
      324   define variable v-delta             as decimal   no-undo .
      325   define variable v-time-start        as integer   no-undo .
      326   define variable v-time-end          as integer   no-undo .
      327   define variable v-time-start1       as character no-undo .
      328   define variable v-time-end1         as character no-undo .
      329   define variable v-date-start        as date      no-undo .
      330   define variable v-date-end          as date      no-undo .
      331   define variable v-color             as character no-undo .
      332   define variable v-host-name         as character no-undo .
      333   define variable v-obj-name          as character no-undo .
      334   define variable v-period            as character no-undo .
      335   do
      336     on error undo, return error return-value
      337     :
      338     for first ub.sysconf, first ub.clients no-lock where ub.clients.obj-code = ub.sysconf.host-code and ub.clients.obj-type = 'орг':U:
      339       v-host-name = ub.clients.obj-name .
      340     end.
      341     if p-Date-start = ? then p-Date-start = today .
      342     if p-Date-end = ? then p-Date-end = today .
      343     v-period = "c: " + string (p-Date-start,"99.99.9999") + " по " + string (p-Date-end,"99.99.9999") .
      344     if p-obj-list = "" then p-obj-list = "0" .
      345     do ii = 1 to num-entries (p-obj-list, chr(44)):
      346       for first ub.clients no-lock where ub.clients.obj-code = integer(entry(ii, p-obj-list, chr(44))) and ub.clients.obj-type = 'маг':U:
      347         v-obj-name = v-obj-name + "," + ub.clients.obj-name .
      348       end.
      349       for each buf_devisPC no-lock where buf_devisPC.DB-num = integer(entry(ii, p-obj-list, chr(44))):
      350         create tt-devicePC .
      351         assign
      352           tt-devicePC.id          = buf_devisPC.id
      353           tt-devicePC.db-num      = buf_devisPC.DB-num
      354           tt-devicePC.modeldevice = buf_devisPC.modeldevice
      355           tt-devicePC.ModelPC     = buf_devisPC.ModelPC
      356           tt-devicePC.namepc      = buf_devisPC.namepc
      357           .
      358         empty temp-table tt-attrDevis .
      359         for each buf_devisPCAttr no-lock where buf_devisPCAttr.id = tt-devicePC.id and buf_devisPCAttr.db-num = tt-devicePC.DB-num
      360           and buf_devisPCAttr.attr-code <> "ProcDisk" and buf_devisPCAttr.attr-code <> "UserProc" and buf_devisPCAttr.attr-code <> "testStatus" and buf_devisPCAttr.date >= p-Date-start
      361           and buf_devisPCAttr.date <= p-Date-end break by buf_devisPCAttr.attr-code by buf_devisPCAttr.date by buf_devisPCAttr.time_:
      362           find first tt-attrDevis where tt-attrDevis.id = buf_devisPCAttr.id and tt-attrDevis.db-num = buf_devisPCAttr.db-num and tt-attrDevis.attr-code = buf_devisPCAttr.attr-code
      363             and tt-attrDevis.date = buf_devisPCAttr.date and tt-attrDevis.time_ = buf_devisPCAttr.time_ no-error .
      364           if not available (tt-attrDevis) then
      365           do:
      366             create tt-attrDevis .
      367             buffer-copy buf_devisPCAttr to tt-attrDevis .
      368           end.
      369         end.
      370         for each tt-attrDevis where tt-attrDevis.id = tt-devicePC.id and tt-attrDevis.db-num = tt-devicePC.db-num break by tt-attrDevis.attr-code by tt-attrDevis.date by tt-attrDevis.time_:
      371           if first-of (tt-attrDevis.attr-code) then
      372           do:
      373             create tt-devicePCAttr .
      374             assign
      375               tt-devicePCAttr.id        = tt-attrDevis.id
      376               tt-devicePCAttr.db-num    = tt-attrDevis.db-num
      377               tt-devicePCAttr.name_     = tt-attrDevis.attr-code
      378               tt-devicePCAttr.type_     = tt-attrDevis.type
      379               tt-devicePCAttr.value_    = decimal(tt-attrDevis.attr-value)
      380               tt-devicePCAttr.raw_value = tt-attrDevis.attr-Raw-value
      381               .
      382           end.
      383           if last-of (tt-attrDevis.attr-code) and last-of (tt-attrDevis.date) then
      384           do:
      385             find first tt-devicePCAttr where tt-devicePCAttr.id = tt-attrDevis.id and tt-devicePCAttr.db-num = tt-attrDevis.db-num
      386               and tt-devicePCAttr.name_ = tt-attrDevis.attr-code no-error .
      387             if available (tt-devicePCAttr) then
      388             do:
      389               assign
      390                 tt-devicePCAttr.tresh = decimal(tt-attrDevis.tresh)
      391                 .
      392               decimal (tt-attrDevis.attr-Raw-value) no-error .
      393               if not error-status:error then
      394               do:
      395                 tt-devicePCAttr.ch_raw = decimal(tt-attrDevis.attr-Raw-value) - decimal(tt-devicePCAttr.raw_value) .
      396               end.
      397               tt-devicePCAttr.ch_val = decimal(tt-attrDevis.attr-value) - tt-devicePCAttr.value_ .
      398               tt-devicePCAttr.raw_value = tt-attrDevis.attr-Raw-value.
      399               tt-devicePCAttr.value_    = decimal(tt-attrDevis.attr-value).
      400             end.
      401           end.
      402         end.
      403         assign
      404           v-time-start1 = ""
      405           v-date-end    = ?
      406           v-date-start  = ?
      407           .
      408         for each tt-attrDevis no-lock where tt-attrDevis.id = tt-devicePC.id and tt-attrDevis.db-num = tt-devicePC.db-num break by tt-attrDevis.date by tt-attrDevis.time_:
      409           if first-of (tt-attrDevis.date) then
      410           do:
      411             if v-time-start1 = "" then v-time-start1  = string(truncate (tt-attrDevis.time_ / 3600, 0)) + ":" + string((tt-attrDevis.time_ modulo 3600) / 60,"99") .
      412             if v-date-start = ? then v-date-start = tt-attrDevis.date .
      413           end.
      414           if last-of (tt-attrDevis.date) and last-of (tt-attrDevis.time_) then
      415           do:
      416             find first buf_tt-devicePC where buf_tt-devicePC.id = tt-attrDevis.id and buf_tt-devicePC.db-num = tt-attrDevis.db-num no-error .
      417             assign
      418               buf_tt-devicePC.time_end   = string(truncate (tt-attrDevis.time_ / 3600, 0)) + ":" + string((tt-attrDevis.time_ modulo 3600) / 60,"99")
      419               buf_tt-devicePC.date_end   = string(tt-attrDevis.date)
      420               buf_tt-devicePC.time_start = v-time-start1
      421               buf_tt-devicePC.date_start = string(v-date-start)
      422               .
      423           end.
      424         end.
      425       end.
      426       for each tt-devicePC:
      427         find first tt-devicePCAttr where tt-devicePCAttr.id = tt-devicePC.id no-error .
      428         if not available (tt-devicePCAttr) then delete tt-devicePC .
      429       end.
      430       output stream Outhtmllog to value(p-folder + "\" + p-file + ".txt") append convert target 'UTF-8'.
      431       find first tt-devicePCAttr no-error .
      432       if not available (tt-devicePCAttr) then
      433       do:
      434         put stream Outhtmllog unformatted
      435           "По АЗК №" + entry(ii, p-obj-list, chr(44)) + " отсутствуют данные за выбранный период c " + string(p-Date-start,"99/99/9999") + " по "  + string(p-Date-end,"99/99/9999") skip .
      436         return .
      437       end.
      438       else
      439       do:
      440         put stream Outhtmllog unformatted
      441           "По АЗК №" + entry(ii, p-obj-list, chr(44)) + " данные за выбранный период c " + string(p-Date-start,"99/99/9999") + " по "  + string(p-Date-end,"99/99/9999") + " " + "выгружены" skip .
      442       end.
      443       output stream Outhtmllog close.
      444     end.
      445     run get-report-num (output p-report-id).
      446     v-file-name-rep-htm = p-folder + "\" + string(p-file) + string(p-Date-end,"99999999") + replace (string(time,"HH:MM:SS"),":","") + ".html".
      447     v-obj-name = trim(v-obj-name,",").
      448     output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8'.
      449     put stream OutStr-html unformatted
      450       "<!DOCTYPE HTML>" skip
      451       ' <html>' skip
      452       '  <head>' skip
      453       '   <meta charset="utf-8">' skip
      454       '    <style type="text/css">' skip
      455       '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
      456       '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
      457       '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black; height: 14px;' + chr(125) skip
      458       '   </style>' skip
      459       '  </head>' skip
      460       .
      461     put stream OutStr-html unformatted
      462       '<body>' skip
      463       '<TABLE name="1"  fit_to_page="true" orientation="portrait" CELLSPACING="0" BORDER="0">'skip
      464       '<thead>' skip
      465       .
      466     put stream OutStr-html unformatted
      467       '<tr>' skip
      468       '<td style="width: 50px;"></td>' skip
      469       '<td style="width: 70px;"></td>' skip
      470       '<td style="width: 70px;"></td>' skip
      471       '<td style="width: 100px;"></td>' skip
      472       '<td style="width: 100px;"></td>' skip
      473       '<td style="width: 170px;"></td>' skip
      474       '<td style="width: 50px;"></td>' skip
      475       '<td style="width: 50px;"></td>' skip
      476       '<td style="width: 70px;"></td>' skip
      477       '<td style="width: 50px;"></td>' skip
      478       '<td style="width: 80px;"></td>' skip
      479       '<td style="width: 80px;"></td>' skip
      480       '</tr>' skip
      481       '<tr><td colspan="12" style="text-align: center;">Результаты проверки HDD</td></tr>'
      482       '<tr><td colspan="12" style="text-align: left;">По фирме: ' + v-host-name + '</td></tr>'
      483       '<tr><td colspan="12" style="text-align: left;">По объектам: ' + v-obj-name + '</td></tr>'
      484       '<tr><td colspan="12" style="text-align: left;">За период ' + v-period + '</td></tr>'
      485       .
      486     put stream OutStr-html unformatted
      487       '<TR><TD colspan="12"></TD></TR>' skip
      488       '</thead>' skip
      489       '<tbody>' skip
      490       .
      491     put stream OutStr-html unformatted
      492       '<TR>' skip
      493       '<TD text_wrap="true" rowspan="2" style="text-align: center;">АЗК</TD>' skip
      494       '<TD text_wrap="true" rowspan="2" style="text-align: center;">Начало периода</TD>' skip
      495       '<TD text_wrap="true" rowspan="2" style="text-align: center;">Конец периода</TD>' skip
      496       '<TD text_wrap="true" rowspan="2" style="text-align: center;">Имя ПК</TD>' skip
      497       '<TD text_wrap="true" rowspan="2" style="text-align: center;">Модель диска</TD>' skip
      498       '<TD text_wrap="true" colspan="7" style="text-align: center;">Атрибуты диска</TD>' skip
      499       '</TR>' skip .
      500     put stream OutStr-html unformatted
      501       '<TR>' skip
      502       '<TD text_wrap="true" style="text-align: center;">Название</TD>' skip
      503       '<TD text_wrap="true" style="text-align: center;">Value</TD>' skip
      504       '<TD text_wrap="true" style="text-align: center;">Thresh</TD>' skip
      505       '<TD text_wrap="true" style="text-align: center;">Тип</TD>' skip
      506       '<TD text_wrap="true" style="text-align: center;">Raw_value</TD>' skip
      507       '<TD text_wrap="true" style="text-align: center;">Изменение Raw_value</TD>' skip
      508       '<TD text_wrap="true" style="text-align: center;">Изменение Value</TD>' skip
      509       '</TR>'skip
      510       .
      511     for each tt-devicePC no-lock:
      512       find first tt-devicePCAttr no-lock where tt-devicePCAttr.id = tt-devicePC.id no-error .
      513       if not available (tt-devicePCAttr) then next .
      514       put stream OutStr-html unformatted
      515         '<TR>' skip
      516         '<TD text_wrap="true" style="text-align: center;">' + string(tt-devicePC.db-num) + '</TD>' skip
      517         '<TD text_wrap="true" style="text-align: center;">' + string(tt-devicePC.date_start + " " + tt-devicePC.time_start) + '</TD>' skip
      518         '<TD text_wrap="true" style="text-align: center;">' + string (tt-devicePC.date_end + " " + tt-devicePC.time_end) + '</TD>' skip
      519         '<TD text_wrap="true" style="text-align: center;">' + string (tt-devicePC.namepc) + '</TD>' skip
      520         '<TD text_wrap="true" style="text-align: center;">' + string (tt-devicePC.modeldevice) + '</TD>' skip
      521         .
      522       for each tt-devicePCAttr no-lock where tt-devicePCAttr.id = tt-devicePC.id break by tt-devicePCAttr.id by tt-devicePCAttr.name_ by tt-devicePCAttr.date_ by tt-devicePCAttr.time_
      523         :
      524         if tt-devicePCAttr.value_ <= tt-devicePCAttr.tresh then v-color = "red" .
      525         else v-color = "white" .
      526         if first-of (tt-devicePCAttr.id ) then
      527         do:
      528           put stream OutStr-html unformatted
      529             '<TD text_wrap="true" style="text-align: center; background-color:' + v-color + ';">' + string (tt-devicePCAttr.name_) + '</TD>' skip
      530             '<TD text_wrap="true" style="text-align: center; background-color:' + v-color + ';">' + string (tt-devicePCAttr.value_) + '</TD>' skip
      531             '<TD text_wrap="true" style="text-align: center; background-color:' + v-color + ';">' + string (tt-devicePCAttr.tresh) + '</TD>' skip
      532             '<TD text_wrap="true" style="text-align: center; background-color:' + v-color + ';">' + string (tt-devicePCAttr.type_) + '</TD>' skip
      533             '<TD text_wrap="true" style="text-align: center; background-color:' + v-color + ';">' + string (tt-devicePCAttr.raw_value) + '</TD>' skip
      534             '<TD text_wrap="true" style="text-align: center; background-color:' + v-color + ';">' + string (tt-devicePCAttr.ch_raw) + '</TD>' skip
      535             '<TD text_wrap="true" style="text-align: center; background-color:' + v-color + ';">' + string (tt-devicePCAttr.ch_val) + '</TD>' skip
      536             '</tr>'
      537             .
      538         end.
      539         else
      540         do:
      541           put stream OutStr-html unformatted
      542             '<TR>' skip
      543             '<TD text_wrap="true" colspan="5" style="text-align: center;"></TD>' skip
      544             '<TD text_wrap="true" style="text-align: center; background-color:' + v-color + ';">' + string (tt-devicePCAttr.name_) + '</TD>' skip
      545             '<TD text_wrap="true" style="text-align: center; background-color:' + v-color + ';">' + string (tt-devicePCAttr.value_) + '</TD>' skip
      546             '<TD text_wrap="true" style="text-align: center; background-color:' + v-color + ';">' + string (tt-devicePCAttr.tresh) + '</TD>' skip
      547             '<TD text_wrap="true" style="text-align: center; background-color:' + v-color + ';">' + string (tt-devicePCAttr.type_) + '</TD>' skip
      548             '<TD text_wrap="true" style="text-align: center; background-color:' + v-color + ';">' + string (tt-devicePCAttr.raw_value) + '</TD>' skip
      549             '<TD text_wrap="true" style="text-align: center; background-color:' + v-color + ';">' + string (tt-devicePCAttr.ch_raw) + '</TD>' skip
      550             '<TD text_wrap="true" style="text-align: center; background-color:' + v-color + ';">' + string (tt-devicePCAttr.ch_val) + '</TD>' skip
      551             '</tr>'
      552             .
      553         end.
      554       end.
      555     end.
      556     put stream OutStr-html unformatted
      557       '</tbody>' skip
      558       '<tfoot>' skip.
      559     put stream OutStr-html unformatted
      560       '</tfoot>' skip
      561       '</table>' skip
      562       '</body>' skip
      563       '</html>' skip
      564       .
      565     output stream OutStr-html close.
      566     define variable v-report-name       as character no-undo .
      567     define variable v-fill-path-RepView as character no-undo.
      568       if search("exe\ReportViewer\reportviewer.exe") <> ? then
      569     do:
      570       v-fill-path-RepView = search("exe\ReportViewer\reportviewer.exe").
      571     end.
      572     else
      573     do:
      574       message "Не найдена программа просмотра отчёта!" view-as alert-box error.
      575     end.
      576     os-command no-wait value(v-fill-path-RepView + " false " + v-file-name-rep-htm).
      577   end.
      578   PROCEDURE get-report-num :
      579     define output parameter p-report-num as integer no-undo .
      580     do
      581       on error undo, return error return-value
      582       :
      583       run gbl/getrpnum.p (output p-report-num).
      584     end.
      585   END PROCEDURE.
