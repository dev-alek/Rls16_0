      842   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      843   define shared temp-table gds-list no-undo like ub.goods
      844     field qnty   as decimal
      845     field to-del as logical
      846     field order-num as integer
      847     field to-sel as logical
      848     field promo-code as character
