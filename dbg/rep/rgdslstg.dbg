      852     index code is         unique gds-code
      853     index oi order-num
      854     index isel to-sel
      855     .
      856   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      857   define  shared  temp-table gds-list-hist no-undo
      858   field list-table as character
      859   field id as integer
      860   field line as integer
      861   field hist-mode as character
      862   field des as character
      863   field num-recs as integer
      864   field option_ as character
      865   field item_ as character
      866   field status_ as character
      867   field num-add as integer
      868   field num-ignored as integer
      869   field done as logical
      870   field err_ as logical
      871   field err-mes as character
