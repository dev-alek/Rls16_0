      303   define  stream PrnLibStream.
      304   procedure prn-lib-prn-file :
      305     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      306     define input parameter p-DIsabledoptions as integer no-undo .
      307     define variable v-report-name as character no-undo .
      308     define variable v-user-action as character no-undo .
      309     define variable v-printed     as logical   no-undo .
      310     define variable v-exist       as logical   no-undo .
      311     do
      312       on error undo, return error
      313       :
      314       run prn-lib-get-report-name  in this-procedure (
      315         input parParentProc
      316         ,output v-report-name
      317         ).
      318   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      319   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      320     (input  v-report-name
      321     ,input  2
      322     ,output v-exist
      323     )  .
      324       if NOT v-exist then
      325       DO:
      326         Message
      327           "Нет заданий на печать ! "
      328           view-as alert-box .
      329         Return  .
      330       End.
      331       run gbl/prnfilen.w
      332         (input  ""
      333         ,input  p-DisabledOptions
      334         ,input  string(v-report-name )
      335         ,input  7
      336         ,output v-user-action
      337         ,output v-printed
      338         ) .
      339       if v-printed then
      340       do:
      341         return "YES" .
      342       end.
      343       else
      344       do:
      345         return "NO" .
      346       end.
      347     end.
      348   end procedure.
      349   procedure prn-lib-open-stream :
      350     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      351     define input parameter p-page-size    as integer no-undo .
      352     define input parameter p-is-stream    as logical no-undo .
      353     define input parameter p-append       as logical no-undo .
      354     define variable v-report-name as character no-undo .
      355     do
      356       on error undo, return error
      357       :
      358       run prn-lib-get-report-name  in this-procedure (
      359         input parParentProc
      360         ,output v-report-name
      361         ).
      362       if p-is-stream then
      363       do:
      364         if p-append then
      365         do:
      366           output stream PrnLibStream to value( v-report-name )
      367             page-size value(p-page-size) append .
      368         end.
      369         if not p-append then
      370         do:
      371           output stream PrnLibStream to value( v-report-name )
      372             page-size value(p-page-size) .
      373         end.
      374       end.
      375       if not p-is-stream then
      376       do:
      377         if p-append then
      378         do:
      379           output to value( v-report-name )
      380             page-size value(p-page-size) append .
      381         end.
      382         if not p-append then
      383         do:
      384           output to value( v-report-name )
      385             page-size value(p-page-size) .
      386         end.
      387       end.
      388     end.
      389   end procedure.
      390   procedure prn-lib-open-exp :
      391     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      392     define input parameter p-is-stream    as logical no-undo .
      393     define input parameter p-is-append    as logical no-undo .
      394     define output parameter p-ReportFileName as char init "report" no-undo.
      395     define output parameter p-process as logical no-undo .
      396     define variable glog as logical no-undo .
      397     do
      398       on error undo, return error
      399       :
      400       SYSTEM-DIALOG GET-FILE p-ReportFileName
      401         TITLE      "Укажите путь"
      402         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      403         ASK-OVERWRITE
      404         CREATE-TEST-FILE
      405         SAVE-AS
      406         USE-FILENAME
      407         DEFAULT-EXTENSION "txt"
      408         UPDATE glog
      409         .
      410       if not glog then  return.
      411       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      412       if p-is-stream then
      413       do:
      414         if p-is-append then
      415         do:
      416           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      417         end.
      418         else
      419         do:
      420           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      421         end.
      422       end.
      423       else
      424       do:
      425         if p-is-append then
      426         do:
      427           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      428         end.
      429         else
      430         do:
      431           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      432         end.
      433       end.
      434       p-process = yes.
      435     end.
      436   end procedure.
      437   procedure prn-lib-get-report-name :
      438     define input parameter parParentProc  as widget-handle no-undo.
      439     define output parameter p-report-name as character no-undo .
      440     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      441   end procedure.
      442   procedure prn-lib-reportviewer-report-name :
      443     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      444     define input parameter p-report-name-html as character no-undo .
      445     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      446   end procedure.
      447   procedure prn-lib-reportviewer :
      448     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      449     define input parameter p-report-name-html as character no-undo .
      450     define input parameter p-param        as character no-undo .
      451     define variable v-excel           as character no-undo init 'TRUE' .
      452     define variable v-value-character as character no-undo .
      453     define variable v-value-integer   as character no-undo .
      454     define variable v-value-date      as date      no-undo .
      455     define variable v-value-decimal   as decimal   no-undo .
      456     define variable rep-excel         as logical   no-undo .
      457     define variable excel-string      as character no-undo .
      458     define variable v-param-type      as character no-undo .
      459     define variable v-tth             as handle    no-undo .
      460     run adm/shattri.p (
      461       input "get":U
      462       ,input  ""
      463       ,input  0
      464       ,input  'report-glob':U
      465       ,input  'rep-excel':U
      466       ,output v-value-character
      467       ,output v-value-date
      468       ,output v-value-decimal
      469       ,output v-value-integer
      470       ,output rep-excel
      471       ,output v-param-type
      472       ,INPUT-OUTPUT table-handle v-tth
      473       )  .
      474     if rep-excel then v-excel = "TRUE" .
      475     else v-excel = "FALSE" .
      476     if p-param eq ""
      477     then
      478        p-param = "EXCEL:" + v-excel.
      479     else
      480        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      481     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      482   end procedure.
