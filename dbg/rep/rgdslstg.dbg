      874   line
      875   index isdone
      876   done
      877   .
      878   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      879   define variable v-waitfram-action01         as character   no-undo .
      880   define variable v-waitfram-action02         as character   no-undo .
      881   define variable v-waitfram-action03         as character   no-undo .
      882   define variable mWaitFramTextBeg            as character   no-undo.
      883   define variable mWaitFramTextEnd            as character   no-undo.
      884   define variable mWaitFramView               as logical     no-undo.
      885   define variable mWaitProcEvent              as logical     no-undo init yes.
      886   define variable mWaitFramInterval           as integer     no-undo init 1 .
      887   define variable mWaitFramStop               as logical     no-undo.
      888   define variable mWaitFramStopUser           as logical     no-undo.
      889   define variable mWaitFramStopTimeOut        as logical     no-undo.
      890   define variable mWaitFramStartProc          as datetime-tz no-undo.
      891   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      892   define button B-WaitFramStop auto-end-key
      893        label "Стоп"
      894        size 10 by 1 tooltip "Остоновить процесс".
      895   define button B-viewProcInfo
      896        label "Информация"
      897        size 15 by 1 tooltip "Информация о процесс".
      898   define frame waitfram
      899     v-waitfram-action01 format "x(72)" no-label skip
      900     v-waitfram-action02 format "x(72)" no-label skip
      901     v-waitfram-action03 format "x(72)" no-label skip
      902     B-viewProcInfo
      903     B-WaitFramStop at row 4 col 30
      904     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      905     .
      906   define new global shared variable mBatchMode as logical no-undo init ?.
      907   define variable mFramBachModHandle as handle no-undo.
      908   mFramBachModHandle = frame waitfram:handle.
      909   define variable mFameOldVis as logical no-undo.
      910   define variable mVisCUrentVin as logical no-undo.
      911   if session:batch-mode
      912   then
      913      mBatchMode = yes.
      914   if mBatchMode = ? then do:
      915     mVisCUrentVin = current-window:visible.
      916     mFameOldVis = mFramBachModHandle:visible.
      917     mFramBachModHandle:visible  = yes.
      918     mBatchMode = mFramBachModHandle:visible ne yes.
      919     mFramBachModHandle:visible = mFameOldVis.
      920     current-window:visible = mVisCUrentVin.
      921   end.
      922    if  log-manager:logfile-name ne ?
      923     then DO:
      924         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      925         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      926         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      927     end.
      928   on choose of B-WaitFramStop in frame waitfram
      929   do:
      930     mWaitFramStop = yes.
      931     mWaitFramStopUser = yes.
      932   end.
      933   function waitfram-check-timeout returns logical():
      934      define variable vtime as int64 no-undo.
      935      if mWaitFramStopTimeOut
      936      then
      937         return yes.
      938      vtime = ( now - mWaitFramStartProc ) / 1000 .
      939      if     mWaitFramTimeOut ne ?
      940         and mWaitFramTimeOut ne 0
      941         and mWaitFramTimeOut lt vtime
      942      then do:
      943         mWaitFramStopTimeOut = yes.
      944      end.
      945      return mWaitFramStopTimeOut.
      946   end.
      947   procedure waitfram-hide :
      948     if not session:batch-mode
      949     then do
      950     on error undo, return error return-value
      951     :
      952       pause 0 before-hide .
      953       if not mBatchMode then
      954         hide frame waitfram .
      955     if     not mWaitFramView
      956        and mWaitProcEvent
      957     then
      958       process events .
      959     end.
      960   end procedure.
      961   procedure waitfram-show :
      962     define input  parameter p-message as character no-undo .
      963     define variable v-left-margin as integer   no-undo .
      964     if not session:batch-mode
      965     then do
      966     on error undo, return error return-value
      967     :
      968       if length(p-message) <= 70 then do:
      969         assign
      970           v-left-margin = integer((70 - length(p-message)) / 2)
      971         .
      972         assign
      973           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      974         .
      975         assign
      976           v-waitfram-action01 = " "
      977           v-waitfram-action02 = " "
      978                                    + fill(" ", v-left-margin)
      979                                    + p-message
      980           v-waitfram-action03 = " "
      981         .
      982       end.
      983       else do:
      984         define variable vRindex1 as integer no-undo.
      985         define variable vRindex2 as integer no-undo.
      986         vRindex1 = r-index(p-message," ",70).
      987         if vRindex1 = 0
      988         then
      989            vRindex1 = 70.
      990         if length(p-message)  <= vRindex1 + 70 then do:
      991           assign
      992             v-waitfram-action01 = " "
      993             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      994             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      995           .
      996         end.
      997         else do:
      998           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      999           if vRindex2 <= vRindex1
     1000           then
     1001              vRindex2 = vRindex1 + 70.
     1002           assign
     1003             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1004             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1005             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1006           .
     1007         end.
     1008       end.
     1009       B-viewProcInfo:visible   in frame waitfram = no.
     1010       B-viewProcInfo:sensitive in frame waitfram = no.
     1011       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1012       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1013       if  (   mWaitFramView
     1014          or  mWaitProcEvent)
     1015          and not mBatchMode
     1016       then
     1017          display
     1018             v-waitfram-action01 skip
     1019             v-waitfram-action02 skip
     1020             v-waitfram-action03 skip
     1021          with frame waitfram .
     1022       if     mWaitFramView
     1023          then do:
     1024             if     mWaitFramInterval ne ?
     1025                and not mBatchMode
     1026             then
     1027                wait-for go of frame waitfram pause mWaitFramInterval.
     1028          end.
     1029          else
     1030             if     mWaitProcEvent
     1031                and not mBatchMode
     1032             then
     1033                process events .
     1034     end.
     1035   end procedure.
     1036      procedure waitfram-show-this:
     1037         define input  parameter iInterval as int64 no-undo.
     1038         define variable vtime as int64 no-undo.
     1039         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1040         mWaitFramInterval = iInterval.
     1041         run waitfram-show (substitute("&1&2 &3&4" ,
     1042                                       mWaitFramTextBeg ,
     1043                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1044                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1045                                       mWaitFramTextEnd
     1046                                      )
     1047                           ).
     1048      end.
     1049      procedure WaitFramRunPause:
     1050         define input  parameter iInterval as dec no-undo.
     1051         define variable vStart  as datetime-tz no-undo.
     1052         define variable vend    as datetime-tz no-undo.
     1053         define variable vint as int64 no-undo.
     1054         define variable vOk as logical no-undo.
     1055         vStart = now.
     1056         vend   = vStart.
     1057         publish "WaitFramPause" (iInterval,output vOk).
     1058         vend   =  now.
     1059         vint = vend - vStart.
     1060         vint = iInterval - vint / 1000.
     1061         if     not mWaitFramStop
     1062            and (   vint > 0
     1063                 or (    not vOk
     1064                     and iInterval eq ?
     1065                     )
     1066                 )
     1067         then
     1068            run waitfram-show-this (iInterval).
     1069         vend   =  now.
     1070         vint = vend - vStart.
     1071         vint = iInterval - vint / 1000.
     1072         if     not mWaitFramStop
     1073            and vint > 0
     1074         then do:
     1075            run gbl/pause.p (vint * 1000).
     1076         end.
     1077         if iInterval ne ?
     1078         then
     1079            publish "WaitFramStop".
     1080         waitfram-check-timeout().
     1081      end.
     1082      procedure WaitFramWaitFor:
     1083         define input  parameter iInterval as dec no-undo.
     1084         assign
     1085            mWaitFramStartProc   = now
     1086            mWaitFramStopUser    = no
     1087            mWaitFramStopTimeOut = no
     1088         .
     1089         block-wait:
     1090         do while not mWaitFramStop:
     1091            run WaitFramRunPause (iInterval).
     1092            if  waitfram-check-timeout()
     1093            then do:
     1094               leave block-wait.
     1095            end.
     1096         end.
     1097         run waitfram-hide.
     1098      end.
     1099   procedure waitfram-join :
     1100     define input  parameter p-line-1  as character no-undo .
     1101     define input  parameter p-line-2  as character no-undo .
     1102     define input  parameter p-line-3  as character no-undo .
     1103     define output parameter p-message as character no-undo .
     1104     do
     1105     on error undo, return error return-value
     1106     :
     1107       assign
     1108         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1109                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1110                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1111       .
     1112     end.
     1113   end procedure.
     1114   function waitfram-join-function returns character
     1115     (input p-line-1 as character
     1116     ,input p-line-2 as character
     1117     ,input p-line-3 as character
     1118     ).
     1119     define variable v-message as character no-undo .
     1120     run waitfram-join in this-procedure
     1121       (input  p-line-1
     1122       ,input  p-line-2
     1123       ,input  p-line-3
     1124       ,output v-message
     1125       ) .
     1126     return v-message .
     1127   end function .
     1128   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1129   define variable  sym1 as char init ":"   no-undo.
     1130   define variable  sym2 as char init ":"   no-undo.
     1131   define variable  sym3 as char init ":"   no-undo.
     1132   define variable  sym4 as char init ":"   no-undo.
     1133   define variable  sym5 as char init ":"   no-undo.
     1134   define variable  sym6 as char init ":"   no-undo.
     1135   define variable  sym7 as char init ":"   no-undo.
     1136   define variable  sym8 as char init ":"   no-undo.
     1137   define variable  tb-code as char no-undo.
     1138   define variable  pbtb-code as character no-undo .
     1139   define variable  free-clmn as char no-undo.
     1140   define variable  Line         as  char    no-undo.
     1141   define variable  v-ind as integer no-undo .
     1142   DEFINE VARIABLE varattr-value as character no-undo .
     1143   DEFINE VARIABLE varattr-type as character no-undo .
     1144   define buffer buf_clients for ub.clients.
     1145   define buffer buf_units for ub.units.
     1146   define stream PrnLibStream.
     1147   DEFINE FRAME zapas
     1148   sym1 column-label ":!:" format "X(1)"
     1149   gds-zap.weight-bc column-label "Вес.!код" format "X(5)"
     1150   sym2 column-label ":!:" format "X(1)"
     1151   tb-code column-label "Код! " format "x(10)"
     1152   sym3 column-label ":!:" format "X(1)"
     1153   gds-zap.artic column-label "Артикул! " format "X(16)"
     1154   sym4 column-label ":!:" format "X(1)"
     1155   gds-zap.gds-name column-label "Название товара! " format "X(50)"
     1156   sym5 column-label ":!:" format "X(1)"
     1157   free-clmn column-label "Для заметок! " format "X(38)"
     1158   sym6 column-label ":!:" format "X(1)"
     1159   HEADER
     1160   cur-time-print() AT 5 format "X(35)"
     1161   string( "Страница" ) AT 110 PAGE-NUMBER(Prnlibstream) AT 120 FORMAT ">>>9" SKIP
     1162   Line format "X(135)" AT 1
     1163   with width 160 down stream-io.
     1164   if not can-find(first gds-list) then do:
     1165     message
     1166       "Список пустой"
     1167       view-as alert-box information .
     1168     return .
     1169   end.
     1170   run waitfram-show in this-procedure ( "Обработано записей " ) .
     1171   FOR EACH gds-list USE-INDEX art NO-LOCK:
     1172     assign
     1173     v-ind = v-ind + 1
     1174     .
     1175     if ( v-ind modulo 25 ) = 0 then do:
     1176       run waitfram-show in this-procedure ( "Обработано записей " + string(v-ind) ) .
     1177     end.
     1178     FIND buf_clients WHERE
     1179        buf_clients.obj-type = gds-list.prod-type
     1180    AND buf_clients.obj-code = gds-list.prod-code NO-LOCK .
     1181     CREATE gds-zap .
     1182     assign
     1183     gds-zap.unit-base  = gds-list.unit-base
     1184     gds-zap.prt-root     = gds-list.prt-root
     1185     gds-zap.gds-name = gds-list.gds-name
     1186     gds-zap.prod-type  = gds-list.prod-type
     1187     gds-zap.prod-code = gds-list.prod-code
     1188     gds-zap.artic          = gds-list.artic
     1189     gds-zap.prod-name = buf_clients.obj-name
     1190     gds-zap.grp-name = gds-list.grp-name
     1191     gds-zap.order-num  = gds-list.order-num
     1192     .
     1193   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1194     (input  gds-list.gds-code
     1195     ,input  ?
     1196     ,output gds-zap.b-code
     1197     )  .
     1198     assign
     1199       gds-zap.weight-bc = ""
     1200     .
     1201     FIND buf_units WHERE
     1202         buf_units.unit-name = gds-list.unit-base NO-LOCK.
     1203     if lookup('вес':U, buf_units.type) > 0 then do:
     1204       varattr-value = "":U.
     1205       run gdsoattr-value in this-procedure(
     1206                                             input 'scales-code':U
     1207                                             ,input gds-list.gds-code
     1208                                             ,input p-obj-type
     1209                                             ,input p-obj-code
     1210                                             ,output varattr-value
     1211                                             ,output varattr-type
     1212                                             ) no-error.
     1213       assign gds-zap.weight-bc = varattr-value.
     1214     end.
     1215   END.
     1216   run waitfram-hide in this-procedure .
     1217     run prn-lib-open-stream  in this-procedure (
     1218                                               input parparentproc
     1219                                               ,input 62
     1220                                               ,input yes
     1221                                               ,input no
     1222                                               ).
     1223   PUT  stream PrnlibStream
     1224   space(30)
     1225   "СПИСОК  ТОВАРОВ" format "X(50)" SKIP(1)
     1226            .
     1227   FORM HEADER
     1228   Line format "X(135)" AT 1 SKIP
     1229   "Продолжение - на следующей странице" AT 30 SKIP
     1230   with FRAME BottomFrame width 160 PAGE-BOTTOM NO-LABELS NO-BOX.
     1231   VIEW stream Prnlibstream FRAME BottomFrame .
     1232   Line = fill("-", 140) .
     1233   FORM with frame zapas .
     1234   CASE p-Classify :
     1235     when "Classify_1" then do:
     1236       FOR EACH gds-zap BREAK BY  (if p-sorttype = "artic":U                     then gds-zap.artic                     else (if p-sorttype = "b-code":U                           then string( gds-zap.b-code, "9999999999" )                           else string(gds-zap.order-num, "9999999999"))                           ) :
     1237         DISPLAY stream PrnLibStream
     1238         sym1 string( gds-zap.b-code, ">>>>>>>>>9" ) @ tb-code
     1239         sym2 gds-zap.artic sym3 gds-zap.gds-name
     1240         sym4 gds-zap.weight-bc
     1241         sym5 free-clmn sym6
     1242         with frame zapas .
     1243         DOWN stream PrnLibStream
     1244         1 with frame zapas .
     1245       END.
     1246     end.
     1247     when "Classify_2" then do:
     1248       FOR EACH gds-zap
     1249       BREAK
     1250       BY ( gds-zap.prod-type + string( gds-zap.prod-code ) )
     1251       BY (if p-sorttype = "artic":U                     then gds-zap.artic                     else (if p-sorttype = "b-code":U                           then string( gds-zap.b-code, "9999999999" )                           else string(gds-zap.order-num, "9999999999"))                           ) :
     1252         if first-of ( ( gds-zap.prod-type + string( gds-zap.prod-code ) ) ) then  do:
     1253           if NOT first ( ( gds-zap.prod-type + string( gds-zap.prod-code ) ) ) then do:
     1254               UNDERLINE stream PrnLibStream
     1255               tb-code
     1256               gds-zap.artic
     1257               gds-zap.gds-name
     1258               with frame zapas .
     1259           end.
     1260           DISPLAY stream PrnLibStream
     1261           sym1
     1262           "Производитель :" @ gds-zap.artic
     1263           gds-zap.prod-name @ gds-zap.gds-name
     1264           sym5 with frame zapas .
     1265           DOWN stream PrnLibStream
     1266           1 with frame zapas .
     1267           UNDERLINE stream PrnLibStream
     1268           tb-code
     1269           gds-zap.artic
     1270           gds-zap.gds-name
     1271           with frame zapas .
     1272         end.
     1273         DISPLAY stream PrnLibStream
     1274         sym1 string( gds-zap.b-code, ">>>>>>>>>9" ) @ tb-code
     1275         sym2 gds-zap.artic sym3 gds-zap.gds-name
     1276         sym4 gds-zap.weight-bc
     1277         sym5 free-clmn sym6
     1278         with frame zapas .
     1279         DOWN stream PrnLibStream
     1280         1 with frame zapas .
     1281       END.
     1282     END.
     1283     when "Classify_3" then do:
     1284       FOR EACH gds-zap
     1285       BREAK
     1286       BY gds-zap.grp-name
     1287       BY (if p-sorttype = "artic":U                     then gds-zap.artic                     else (if p-sorttype = "b-code":U                           then string( gds-zap.b-code, "9999999999" )                           else string(gds-zap.order-num, "9999999999"))                           )  :
     1288         if first-of ( gds-zap.grp-name ) then do:
     1289           if NOT first ( gds-zap.grp-name ) then do:
     1290             UNDERLINE stream PrnLibStream
     1291             tb-code
     1292             gds-zap.artic
     1293             gds-zap.gds-name
     1294             with frame zapas .
     1295           end.
     1296           DISPLAY stream PrnLibStream
     1297           sym1 "Группа товаров :" @ gds-zap.artic
     1298           gds-zap.grp-name @ gds-zap.gds-name
     1299           sym5
     1300           with frame zapas .
     1301           DOWN stream PrnLibStream
     1302           1 with frame zapas .
     1303           UNDERLINE stream PrnLibStream
     1304           tb-code
     1305           gds-zap.artic
     1306           gds-zap.gds-name
     1307           with frame zapas .
     1308         end.
     1309         DISPLAY stream PrnLibStream
     1310         sym1 string( gds-zap.b-code, ">>>>>>>>>9" ) @ tb-code
     1311         sym2 gds-zap.artic sym3 gds-zap.gds-name
     1312         sym4 gds-zap.weight-bc
     1313         sym5 free-clmn
     1314         sym6
     1315         with frame zapas .
     1316         DOWN stream PrnLibStream
     1317         1 with frame zapas .
     1318       END.
     1319     end.
     1320     when "Classify_4" then do:
     1321       FOR EACH gds-zap
     1322       BREAK
     1323       BY ( gds-zap.prod-type + string( gds-zap.prod-code ) )
     1324       BY gds-zap.grp-name
     1325       BY (if p-sorttype = "artic":U                     then gds-zap.artic                     else (if p-sorttype = "b-code":U                           then string( gds-zap.b-code, "9999999999" )                           else string(gds-zap.order-num, "9999999999"))                           ) :
     1326         if first-of ( ( gds-zap.prod-type + string( gds-zap.prod-code ) ) ) then do:
     1327           if NOT first ( ( gds-zap.prod-type + string( gds-zap.prod-code ) ) ) then do:
     1328             UNDERLINE stream PrnLibStream
     1329             tb-code
     1330             gds-zap.artic
     1331             gds-zap.gds-name
     1332             with frame zapas .
     1333           end.
     1334           DISPLAY stream PrnLibStream
     1335           sym1  "Производитель :" @ gds-zap.artic
     1336           gds-zap.prod-name @ gds-zap.gds-name
     1337           sym5 with frame zapas .
     1338           DOWN stream PrnLibStream
     1339           1 with frame zapas .
     1340           UNDERLINE stream PrnLibStream
     1341           tb-code
     1342           gds-zap.artic
     1343           gds-zap.gds-name
     1344           with frame zapas .
     1345         end.
     1346         if first-of ( gds-zap.grp-name ) then do:
     1347           if NOT first ( gds-zap.grp-name ) then do:
     1348             UNDERLINE stream PrnLibStream
     1349             tb-code
     1350             gds-zap.artic
     1351             gds-zap.gds-name
     1352             with frame zapas .
     1353           end.
     1354           DISPLAY stream PrnLibStream
     1355           sym1 "Группа товаров :" @ gds-zap.artic
     1356           gds-zap.grp-name @ gds-zap.gds-name
     1357           sym5 with frame zapas .
     1358           DOWN stream PrnLibStream
     1359           1 with frame zapas .
     1360           UNDERLINE stream PrnLibStream
     1361           tb-code
     1362           gds-zap.artic
     1363           gds-zap.gds-name
     1364           with frame zapas .
     1365         end.
     1366         DISPLAY stream PrnLibStream
     1367         sym1 string( gds-zap.b-code, ">>>>>>>>>9" ) @ tb-code
     1368         sym2 gds-zap.artic sym3 gds-zap.gds-name
     1369         sym4 gds-zap.weight-bc
     1370         sym5 free-clmn sym6
     1371         with frame zapas .
     1372         DOWN stream PrnLibStream
     1373         1 with frame zapas .
     1374       END.
     1375     end.
     1376     when "Classify_5" then do:
     1377       FOR EACH gds-zap
     1378       BREAK
     1379       BY gds-zap.grp-name
     1380       BY ( gds-zap.prod-type + string( gds-zap.prod-code ) )
     1381       BY (if p-sorttype = "artic":U                     then gds-zap.artic                     else (if p-sorttype = "b-code":U                           then string( gds-zap.b-code, "9999999999" )                           else string(gds-zap.order-num, "9999999999"))                           ) :
     1382         if first-of ( gds-zap.grp-name ) then  do:
     1383           if NOT first ( gds-zap.grp-name ) then do:
     1384             UNDERLINE stream PrnLibStream
     1385             tb-code
     1386             gds-zap.artic
     1387             gds-zap.gds-name
     1388             with frame zapas .
     1389           end.
     1390           DISPLAY stream PrnLibStream
     1391           sym1 "Группа товаров :" @ gds-zap.artic
     1392           gds-zap.grp-name @ gds-zap.gds-name
     1393           sym5 with frame zapas .
     1394           DOWN stream PrnLibStream
     1395           1 with frame zapas .
     1396           UNDERLINE stream PrnLibStream
     1397           tb-code gds-zap.artic gds-zap.gds-name with frame zapas .
     1398         end.
     1399         if first-of ( ( gds-zap.prod-type + string( gds-zap.prod-code ) ) ) then do:
     1400           if NOT first ( ( gds-zap.prod-type + string( gds-zap.prod-code ) ) ) then do:
     1401             UNDERLINE stream PrnLibStream
     1402             tb-code
     1403             gds-zap.artic
     1404             gds-zap.gds-name
     1405             with frame zapas .
     1406           end.
     1407           DISPLAY stream PrnLibStream
     1408           sym1 "Производитель :" @ gds-zap.artic
     1409           gds-zap.prod-name @ gds-zap.gds-name
     1410           sym5
     1411           with frame zapas .
     1412           DOWN stream PrnLibStream
     1413           1 with frame zapas .
     1414           UNDERLINE stream PrnLibStream
     1415           tb-code gds-zap.artic gds-zap.gds-name with frame zapas .
     1416         end.
     1417         DISPLAY stream PrnLibStream
     1418         sym1 string( gds-zap.b-code, ">>>>>>>>>9" ) @ tb-code
     1419         sym2 gds-zap.artic sym3 gds-zap.gds-name
     1420         sym4 gds-zap.weight-bc
     1421         sym5 free-clmn sym6
     1422         with frame zapas .
     1423         DOWN stream PrnLibStream
     1424         1 with frame zapas .
     1425       END.
     1426     END.
     1427   END CASE .
     1428   HIDE stream PrnlibStream FRAME BottomFrame .
     1429   PUT  stream PrnlibStream
     1430   Line format "X(135)" SKIP .
     1431   output stream PrnlibStream CLOSE .
     1432   run prn-lib-prn-file in this-procedure (
     1433                                             input parparentproc
     1434                                             ,input 0
     1435                                             ).
     1436   return "OK" .
