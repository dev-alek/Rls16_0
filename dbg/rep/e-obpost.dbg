      984        ShowParts AT ROW 15.42 COL 49.25
      985        ShowZero-2 AT ROW 15.5 COL 2.75
      986        ShowZero AT ROW 16.42 COL 2.75
      987        Cli-art AT ROW 16.58 COL 49.25
      988        "Выбор поставщика:" VIEW-AS TEXT
      989             SIZE 19.38 BY .67 AT ROW 1.25 COL 7.13
      990             FGCOLOR 4
      991        "Сортировка :" VIEW-AS TEXT
      992             SIZE 13.63 BY .75 AT ROW 1.29 COL 52.75
      993             FGCOLOR 4
      994        "Показать :" VIEW-AS TEXT
      995             SIZE 11.5 BY .75 AT ROW 5.71 COL 52.75
      996             FGCOLOR 4
      997        "Классификация :" VIEW-AS TEXT
      998             SIZE 15 BY .75 AT ROW 4.83 COL 7.13
      999             FGCOLOR 4
     1000        RECT-6 AT ROW 1.04 COL 48.13
     1001        RECT-7 AT ROW 1.04 COL 1.75
     1002        RECT-5 AT ROW 4.63 COL 1.75
     1003        RECT-8 AT ROW 11.63 COL 1.75
     1004        RECT-9 AT ROW 5.5 COL 48.13
     1005       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1006            SIDE-LABELS NO-UNDERLINE THREE-D
     1007            AT COL 1 ROW 1 SCROLLABLE .
     1008   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1009   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1010   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1011   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1012   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1013   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1014   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1015   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1016         adm-object-hdl = FRAME F-Main:HANDLE.
     1017   RUN ensure-broker.
     1018   THIS-PROCEDURE:ADM-DATA =
     1019        'ADM1.1~`':U +
     1020        'SmartObject~`':U +
     1021        '~`':U +
     1022        'NO ~`':U +
     1023        '~`':U +
     1024        '~`':U +
     1025        '~`':U +
     1026        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1027           + "~`":U +
     1028        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
     1029        'Record-Source,Record-Target,TableIO-Target~`':U +
     1030        '~`':U +
     1031        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1032        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1033            THEN "^^":U
     1034        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1035             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1036   PROCEDURE adm-apply-entry :
     1037     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1038   END PROCEDURE.
     1039   PROCEDURE adm-destroy :
     1040    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1041   END PROCEDURE.
     1042   PROCEDURE adm-disable :
     1043       DISABLE RECT-6 RECT-7 RECT-5 RECT-8 RECT-9 RADPost PostName SortType Tog-obj Showcost Classify Showsale type-stor t-in SumsOnly ShowParts ShowZero-2 Cli-art WITH FRAME F-Main.
     1044       RUN dispatch ('disable-fields':U).
     1045       RUN set-attribute-list ('ENABLED=no':U).
     1046       RETURN.
     1047   END PROCEDURE.
     1048   PROCEDURE adm-edit-attribute-list :
     1049         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
     1050         RETURN.
     1051   END PROCEDURE.
     1052   PROCEDURE adm-enable :
     1053       ENABLE UNLESS-HIDDEN RECT-6 RECT-7 RECT-5 RECT-8 RECT-9 RADPost PostName SortType Tog-obj Showcost Classify Showsale type-stor t-in SumsOnly ShowParts ShowZero-2 Cli-art WITH FRAME F-Main.
     1054       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1055       RUN set-attribute-list ('ENABLED=yes':U).
     1056       RETURN.
     1057   END PROCEDURE.
     1058   PROCEDURE adm-exit :
     1059        RUN notify ('exit':U).
     1060     RETURN.
     1061   END PROCEDURE.
     1062   PROCEDURE adm-hide :
     1063     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1064   END PROCEDURE.
     1065   PROCEDURE adm-initialize :
     1066     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1067   END PROCEDURE.
     1068   PROCEDURE adm-show-errors :
     1069       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1070       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1071           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1072       END.
     1073       RETURN.
     1074   END PROCEDURE.
     1075   PROCEDURE adm-UIB-mode :
     1076     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1077   END PROCEDURE.
     1078   PROCEDURE adm-view :
     1079     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1080   END PROCEDURE.
     1081   PROCEDURE dispatch :
     1082       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1083       RUN broker-dispatch IN adm-broker-hdl
     1084           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1085       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1086   END PROCEDURE.
     1087   PROCEDURE ensure-broker :
     1088   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1089   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1090   DO:
     1091       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1092       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1093   END.
     1094   END PROCEDURE.
     1095   PROCEDURE get-attribute :
     1096     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1097     RUN broker-get-attribute IN adm-broker-hdl
     1098         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1099     RETURN RETURN-VALUE.
     1100   END PROCEDURE.
     1101   PROCEDURE get-attribute-list :
     1102     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1103     RUN broker-get-attribute-list IN adm-broker-hdl
     1104         (INPUT THIS-PROCEDURE,
     1105          INPUT ?,
     1106          OUTPUT p-attr-list) NO-ERROR.
     1107     RETURN.
     1108   END PROCEDURE.
     1109   PROCEDURE new-state :
     1110     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1111     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1112     RETURN.
     1113   END PROCEDURE.
     1114   PROCEDURE notify :
     1115     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1116     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1117     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1118         RETURN "ADM-ERROR":U.
     1119     RETURN.
     1120   END PROCEDURE.
     1121   PROCEDURE set-attribute-list :
     1122     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1123     RUN ensure-broker.
     1124     RUN broker-set-attribute-list IN adm-broker-hdl
     1125         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1126     RETURN.
     1127   END PROCEDURE.
     1128   PROCEDURE set-position :
     1129       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1130       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1131       IF VALID-HANDLE(adm-object-hdl) THEN
     1132       DO:
     1133         ASSIGN adm-object-hdl:ROW    =   p-row
     1134                adm-object-hdl:COLUMN =   p-col.
     1135       END.
     1136       RETURN.
     1137   END PROCEDURE.
     1138   PROCEDURE adm-display-fields :
     1139       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1140       RETURN.
     1141   END PROCEDURE.
     1142   PROCEDURE adm-open-query :
     1143     RETURN.
     1144   END PROCEDURE.
     1145   PROCEDURE adm-row-changed :
     1146         IF VALID-HANDLE(adm-object-hdl) THEN
     1147           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1148         RUN notify ('row-available':U).
     1149         RETURN.
     1150   END PROCEDURE.
     1151   PROCEDURE reposition-query :
     1152       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1153       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1154       RETURN.
     1155   END PROCEDURE.
     1156     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1157     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1158     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1159     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1160     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1161     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1162     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1163     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1164     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1165     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1166     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1167     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1168     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1169     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1170     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1171     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1172     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1173     IF "":U = "":U THEN
     1174       RUN modify-list-attribute IN adm-broker-hdl
     1175         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1176     RUN use-create-on-add(?).
     1177   PROCEDURE adm-add-record :
     1178       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1179          "must have at least one Enabled Table to perform Add.":U
     1180          VIEW-AS ALERT-BOX ERROR.
     1181       RETURN.
     1182   END PROCEDURE.
     1183   PROCEDURE adm-assign-record :
     1184    MESSAGE
     1185          "Object ":U THIS-PROCEDURE:FILE-NAME
     1186            "must have at least one Enabled Table to perform Assign.":U
     1187              VIEW-AS ALERT-BOX ERROR.
     1188      RETURN.
     1189     END PROCEDURE.
     1190   PROCEDURE adm-assign-statement :
     1191     RETURN.
     1192   END PROCEDURE.
     1193   PROCEDURE adm-cancel-record :
     1194      RETURN.
     1195     END PROCEDURE.
     1196   PROCEDURE adm-copy-record :
     1197       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1198        "must have at least one Enabled Table to perform Copy.":U
     1199          VIEW-AS ALERT-BOX ERROR.
     1200       RETURN.
     1201   END PROCEDURE.
     1202   PROCEDURE adm-create-record :
     1203      RETURN.
     1204   END PROCEDURE.
     1205   PROCEDURE adm-current-changed :
     1206     RETURN.
     1207   END PROCEDURE.
     1208   PROCEDURE adm-delete-record :
     1209    MESSAGE
     1210          "Object ":U THIS-PROCEDURE:FILE-NAME
     1211            "must have at least one Enabled Table to perform Delete.":U
     1212              VIEW-AS ALERT-BOX ERROR.
     1213       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1214       RETURN.
     1215   END PROCEDURE.
     1216   PROCEDURE adm-disable-fields :
     1217         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1218       RETURN.
     1219   END PROCEDURE.
     1220   PROCEDURE adm-enable-fields :
     1221       RETURN.
     1222   END PROCEDURE.
     1223   PROCEDURE adm-end-update :
     1224     RETURN.
     1225   END PROCEDURE.
     1226   PROCEDURE adm-reset-record :
     1227       RETURN.
     1228   END PROCEDURE.
     1229   PROCEDURE adm-update-record :
     1230       MESSAGE
     1231         "Object ":U THIS-PROCEDURE:FILE-NAME
     1232           "must have at least one Enabled Table to perform Update.":U
     1233             VIEW-AS ALERT-BOX ERROR.
     1234      RETURN.
     1235   END PROCEDURE.
     1236   PROCEDURE check-modified :
     1237   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1238   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1239   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1240   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1241     IF check-state = "check":U THEN
     1242     DO:
     1243       RUN get-link-handle IN adm-broker-hdl
     1244         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1245            OUTPUT group-target-list).
     1246       IF group-target-list NE "":U THEN
     1247       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1248         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1249         RUN check-modified IN curr-widget ('group-check':U).
     1250         IF RETURN-VALUE NE "":U THEN
     1251         DO:
     1252           RUN check-modified-message(RETURN-VALUE).
     1253           RETURN "":U.
     1254         END.
     1255       END.
     1256     END.
     1257     RETURN "":U.
     1258   END PROCEDURE.
     1259   PROCEDURE check-modified-message :
     1260     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1261        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1262           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1263        IF RETURN-VALUE = "YES":U THEN
     1264           RUN notify ('view,CONTAINER-SOURCE':U).
     1265        MESSAGE IF p-changed-table NE ? THEN
     1266           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1267           ELSE "Current values have been changed."
     1268           SKIP "  Do you wish to save those changes?"
     1269           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1270        IF ANS THEN
     1271        DO:
     1272           IF group-assign-target THEN
     1273             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1274           ELSE RUN dispatch('update-record':U).
     1275           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1276           DO:
     1277               MESSAGE "Changes to the previous record were not saved."
     1278                 VIEW-AS ALERT-BOX ERROR.
     1279               IF group-assign-target THEN
     1280                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1281               ELSE RUN dispatch ('cancel-record':U).
     1282           END.
     1283        END.
     1284        ELSE DO:
     1285          IF group-assign-target THEN
     1286             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1287          ELSE RUN dispatch('cancel-record':U).
     1288        END.
     1289        RETURN.
     1290   END PROCEDURE.
     1291   PROCEDURE get-rowid :
     1292       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1293       ASSIGN
     1294       p-table   =   adm-first-table.
     1295       RETURN.
     1296   END PROCEDURE.
     1297   PROCEDURE init-group-assign :
     1298       RUN request-attribute IN adm-broker-hdl
     1299         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1300       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1301         group-assign-target = yes.
     1302       ELSE group-assign-target = no.
     1303       RETURN.
     1304   END PROCEDURE.
     1305   PROCEDURE set-editors :
     1306       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1307       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1308       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1309       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1310       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1311       DO WHILE VALID-HANDLE (curr-widget):
     1312           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1313              curr-widget:HIDDEN = no THEN DO:
     1314             CASE p-field-setting:
     1315               WHEN "INITIALIZE":U THEN
     1316               DO:
     1317                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1318                     read-only-list +
     1319                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1320                        STRING(curr-widget).
     1321               END.
     1322               WHEN "DISABLE":U OR
     1323               WHEN "ENABLE":U THEN
     1324               DO:
     1325                   curr-widget:SENSITIVE = yes.
     1326                   RUN get-attribute ('Read-Only-Editors':U).
     1327                   IF RETURN-VALUE = ? OR
     1328                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1329                       curr-widget:READ-ONLY =
     1330                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1331               END.
     1332               WHEN "CLEAR":U THEN
     1333                   curr-widget:SCREEN-VALUE = "":U.
     1334             END CASE.
     1335           END.
     1336           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1337       END.
     1338       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1339         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1340           + '"':U).
     1341       RETURN.
     1342   END PROCEDURE.
     1343   PROCEDURE use-check-modified-all :
     1344    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1345     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1346     RETURN.
     1347   END PROCEDURE.
     1348   PROCEDURE use-create-on-add :
     1349   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1350      RETURN.
     1351   END PROCEDURE.
     1352   PROCEDURE use-initial-lock :
     1353     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1354     ASSIGN adm-initial-lock = p-attr-value.
     1355     RETURN.
     1356   END PROCEDURE.
     1357     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1358   ASSIGN
     1359          FRAME F-Main:SCROLLABLE       = FALSE
     1360          FRAME F-Main:HIDDEN           = TRUE.
     1361   ASSIGN
     1362          Cli-art:HIDDEN IN FRAME F-Main           = TRUE.
     1363   ASSIGN
     1364          PostName:READ-ONLY IN FRAME F-Main        = TRUE.
     1365   ASSIGN
     1366          ShowParts:HIDDEN IN FRAME F-Main           = TRUE.
     1367   ON VALUE-CHANGED OF Classify IN FRAME F-Main
     1368   DO:
     1369       Assign Classify.
     1370      if Classify = "grp-goods":U
     1371            Then do:
     1372               display TOG-lavel   with frame F-Main .
     1373               enable  TOG-lavel   with frame F-Main .
     1374           end.
     1375            Else do:
     1376               display  TOG-lavel  var-Lavel with frame F-Main .
     1377               disable  TOG-lavel  var-Lavel with frame F-Main .
     1378           end.
     1379    if Classify = "post":U
     1380            Then do:
     1381               display TOG-lavel-2   with frame F-Main .
     1382               enable  TOG-lavel-2   with frame F-Main .
     1383           end.
     1384            Else do:
     1385               display  TOG-lavel-2  var-Lavel-2 with frame F-Main .
     1386               disable  TOG-lavel-2  var-Lavel-2 with frame F-Main .
     1387           end.
     1388   END.
     1389   ON VALUE-CHANGED OF RADPost IN FRAME F-Main
     1390   DO:
     1391     Assign RadPost.
     1392     for each g#post : delete g#post. end.
     1393     Case RAdPost :
     1394     when 1 then DO:
     1395             Assign  Postname = 'все':U.
     1396             Display PostName with frame F-Main .
     1397          END.
     1398     when 2 then
     1399           do:
     1400              run ref/cli-all.w
     1401                              ( my-handle
     1402                              , "b-sel,b-mark"
     1403                              , 'все':U
     1404                              , 'все':U
     1405                              , 'текущие':U
     1406                              , ?
     1407                              , ",,,,,,NO,,"
     1408                              ,?
     1409                             , output post-grp_recids ) .
     1410               if post-grp_recids = "" then do:
     1411                    Assign  Postname = 'все':U radpost = 1.
     1412                    Display PostName radpost with frame F-Main .
     1413               end.
     1414               else do:
     1415                   Assign  Postname = ''.
     1416                   v-nn = num-entries( post-grp_recids ) .
     1417                   DO ii = 1 TO v-nn :
     1418                       FIND cli-post WHERE recid( cli-post ) = int(entry( ii, post-grp_recids )) NO-LOCK.
     1419                       create g#post.
     1420                       assign
     1421                       g#post.obj-type = cli-post.obj-type
     1422                       g#post.obj-code = cli-post.obj-code
     1423                       g#post.obj-name = cli-post.obj-name
     1424                       Postname = PostName + cli-post.obj-name + chr(10).
     1425                   END.
     1426                    Display PostName with frame F-Main .
     1427               end.
     1428           end.
     1429     End case.
     1430     END.
     1431   ON VALUE-CHANGED OF Showsale IN FRAME F-Main
     1432   DO:
     1433   assign Showsale.
     1434     if showsale then DO:
     1435                     type-stor = 1 .
     1436                     type-stor:screen-value = '1' .
     1437                     disable type-stor with frame F-Main.
     1438                     End.
     1439                 else enable type-stor with frame F-Main.
     1440   END.
     1441   ON VALUE-CHANGED OF ShowZero-2 IN FRAME F-Main
     1442   DO:
     1443     assign ShowZero-2.
     1444     if ShowZero-2 = no then do:
     1445        ShowZero = no .
     1446        display ShowZero with frame F-Main .
     1447        disable ShowZero with frame F-Main .
     1448     end.
     1449     else enable ShowZero with frame F-Main .
     1450   END.
     1451   ON VALUE-CHANGED OF Tog-lavel IN FRAME F-Main
     1452   DO:
     1453      Assign tog-lavel.
     1454     if tog-lavel =TRUE
     1455           Then do:
     1456               display  var-Lavel  with frame F-Main .
     1457               enable   var-Lavel  with frame F-Main .
     1458           end.
     1459            Else do:
     1460               display    var-Lavel with frame F-Main .
     1461               disable    var-Lavel with frame F-Main .
     1462           end.
     1463   END.
     1464   ON VALUE-CHANGED OF Tog-lavel-2 IN FRAME F-Main
     1465   DO:
     1466      Assign tog-lavel-2.
     1467     if tog-lavel-2 = TRUE
     1468           Then do:
     1469               display  var-Lavel-2  with frame F-Main .
     1470               enable   var-Lavel-2  with frame F-Main .
     1471           end.
     1472            Else do:
     1473               display    var-Lavel-2 with frame F-Main .
     1474               disable    var-Lavel-2 with frame F-Main .
     1475           end.
     1476   END.
     1477   ON VALUE-CHANGED OF Tog-obj IN FRAME F-Main
     1478   DO:
     1479   define variable g#log as logical   no-undo .
     1480    assign Tog-obj.
     1481     if tog-obj = false then do:
     1482          g#log = Classify:disable(radio-label("post", Classify:radio-buttons)) .
     1483          g#log = Classify:disable(radio-label("post/grp-goods", Classify:radio-buttons)) .
     1484          g#log = Classify:disable(radio-label("grp-goods/post", Classify:radio-buttons)) .
     1485     End.
     1486     Else do:
     1487          g#log = Classify:enable (radio-label("post", Classify:radio-buttons)) .
     1488          g#log = Classify:enable (radio-label("post/grp-goods", Classify:radio-buttons)) .
     1489          g#log = Classify:enable (radio-label("grp-goods/post", Classify:radio-buttons)) .
     1490       display Classify SumsOnly type-stor ShowZero  with frame F-Main.
     1491       enable Classify SumsOnly type-stor ShowZero  with frame F-Main.
     1492     End.
     1493   END.
     1494   if not this-procedure :persistent
     1495   then do:
     1496     message
     1497       vss-workfile vss-revision vss-description skip
     1498       "Ошибка при запуске процедуры" skip
     1499       "Данную процедуру следует запускать только с параметром persistent" skip
     1500       view-as alert-box error .
     1501     undo, return error .
     1502   end.
     1503   PROCEDURE disable_UI :
     1504     HIDE FRAME F-Main.
     1505     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1506   END PROCEDURE.
     1507   PROCEDURE local-initialize :
     1508     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1509      Tog-obj:screen-value     in frame F-Main = 'yes':U.
     1510      var-lavel:screen-value   in frame F-Main = '1'.
     1511      var-lavel-2:screen-value in frame F-Main = '1'.
     1512   END PROCEDURE.
     1513   PROCEDURE my-report :
     1514    run rep/r-obpost.p
     1515       ( input v-cntxt-obj-code ,
     1516         input v-cntxt-obj-type ,
     1517         input base-type        ,
     1518         input base-code        ,
     1519         input Cli-art          ,
     1520         input ?                ,
     1521         input ?                ,
     1522         input PostName         ,
     1523         input ?                ,
     1524         input RadPost          ,
     1525         input ?                ,
     1526         input ShowParts        ,
     1527         input Classify         ,
     1528         input SortType         ,
     1529         input SumsOnly         ,
     1530         input ShowZero-2       ,
     1531         input ShowZero         ,
     1532         input tog-obj          ,
     1533         input ?                ,
     1534         input type-stor        ,
     1535         input tog-lavel        ,
     1536         input var-lavel        ,
     1537         input tog-lavel-2      ,
     1538         input var-lavel-2      ,
     1539         input t-in
     1540         ) .
     1541   END PROCEDURE.
     1542   PROCEDURE my-var :
     1543   assign frame F-Main type-stor
     1544   Cli-art  PostName  RADPost   ShowParts showcost showsale
     1545   ShowZero ShowZero-2 Classify  SortType  SumsOnly Tog-obj
     1546   Tog-lavel  var-lavel Tog-lavel-2  Var-lavel-2 t-in .
     1547   Show-cost = showcost.
     1548   Show-sale = showsale.
     1549   ReportNAme = "Оборотная ведомость по поставщикам " .
     1550   def var t-class as char no-undo.
     1551   def var t-sort as char no-undo.
     1552     case classify:
     1553       when "no-classify":u    then t-class =   "Без классификации" .
     1554       when "prod":u           then t-class =   "Производители"   .
     1555       when "post":u           then t-class =   "Поставщики"   .
     1556       when "grp-goods":u      then t-class =   "Группы товаров"  .
     1557       when "post/grp-goods":u then t-class =   "Поставщики/Группы товаров" .
     1558       when "prod/grp-goods":u then t-class =   "Производители/Группы товаров" .
     1559       when "grp-goods/prod":u then t-class =   "Группы товаров/Производители" .
     1560       when "grp-goods/post":u then t-class =   "Группы товаров/Поставщики" .
     1561       when  "vat-ps":u        then t-class =   "Ставка НДС" .
     1562       when  "sort":u          then t-class =   "Проба(Сорт)" .
     1563       when  "n-level":u       then t-class =   "Группы с уровнем вложенности " .
     1564       when  "t-level":u       then t-class =   "Терминальные группы" .
     1565    end case.
     1566     case sorttype:
     1567       when "sort-pp":u               then t-sort =   "по порядку" .
     1568       when "sort-code":u             then t-sort =   "по коду" .
     1569       when "sort-artic":u            then t-sort =   "по артикулу"  .
     1570       when "sort-qunty":u            then t-sort =   "по реализации".
     1571       when "sort-name":u             then t-sort =   "по наименованию".
     1572       when "sort-type":u             then t-sort =   "по типу ткани".
     1573       when "sort-doc-code":u         then t-sort =   "по номеру документа".
     1574       when "sort-recipe-code":u      then t-sort =   "по номеру рецепта".
     1575    end case.
     1576   ReportHeader = "Поставщики : " + PostName + chr(10).
     1577   ReportHeader = ReportHeader + "Классификация : " + t-Class.
     1578   ReportHeader = ReportHeader +
     1579                  (if tog-lavel  then "    Итоги с уровня товаров "  + String(var-lavel)  else " "    ).
     1580   ReportHeader = ReportHeader +
     1581                  (if tog-lavel-2  then "    Итоги с уровня поставщика "  + String(var-lavel-2)  else " "    ).
     1582   ReportHeader = ReportHeader  + chr(10).
     1583   ReportHeader = ReportHeader +
     1584                  "Сортировка " + t-Sort + chr(10) +
     1585                  "Показать : " +
     1586                  (if SumsOnly      then "Только итоги, "  else " "             ) +
     1587                  (if Show-Cost     then "Суммы в учетных ценах, "    else " "  ) +
     1588                  (if Show-Crsa     then "Суммы в продажных ценах, "  else " "  ) +
     1589                  (if Show-Sale     then "Суммы в ценах документа, "  else " "  ) +
     1590                  (if t-in          then "Приход и Расход с внутренним перемещением, "  else " Приход и Расход внешние, "  ) +
     1591                  (if ShowParts     then "Партии , "  else " "                  ) +
     1592                  (if cli-art       then "Артикулы поставщика, "  else " "      ) +
     1593                  (if ShowZero-2    then "Показывать нулевые обороты "  else "Не показывать нулевые обороты " ) +
     1594                  (if ShowZero      then "Показывать нулевые остатки "  else "Не показывать нулевые остатки " )
     1595                   .
     1596   ReportHeader =  ReportHeader  + chr(10) + Caps(Entry(((type-stor * 2) - 1), type-stor:RADIO-BUTTONS)) .
     1597    sheetf.Excel-Column-Lable = "Код,Артикул,Название товара ,Ед.изм" +
     1598          ",Остаток на  начало" +  (if Show-Cost then "," else "" )  + (if  Show-Sale then "," else "" )  +
     1599          ",Приход" +             (if Show-Cost then "," else "" )  + (if  Show-Sale then "," else "" )  +
     1600          ",Расход" +             (if Show-Cost then "," else "" )  + (if  Show-Sale then "," else "" )  +
     1601          ",Касса" +              (if Show-Cost then "," else "" )  + (if  Show-Sale then "," else "" )  +
     1602          ",Инвентаризация" +     (if Show-Cost then "," else "" )  + (if  Show-Sale then "," else "" )  +
     1603          ",Списание" +           (if Show-Cost then "," else "" )  + (if  Show-Sale then "," else "" )  +
     1604          ",Возврат внешний" +    (if Show-Cost then "," else "" )  + (if  Show-Sale then "," else "" )  +
     1605          ",Возврат поставщика" + (if Show-Cost then "," else "" )  + (if  Show-Sale then "," else "" )  +
     1606          ",Остаток на конец" +  (if Show-Cost then "," else "" )  + (if  Show-Sale then "," else "" )  +
     1607           chr(10) .
     1608    sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + ",,," +
     1609    ",кол-во" + (if Show-Cost then ",учет.сумма" else "" )  + ( if Show-Sale then ",сумма док." else "" )  +
     1610    ",кол-во" + (if Show-Cost then ",учет.сумма" else "" )  + ( if Show-Sale then ",сумма док." else "" )  +
     1611    ",кол-во" + (if Show-Cost then ",учет.сумма" else "" )  + ( if Show-Sale then ",сумма док." else "" )  +
     1612    ",кол-во" + (if Show-Cost then ",учет.сумма" else "" )  + ( if Show-Sale then ",сумма док." else "" )  +
     1613    ",кол-во" + (if Show-Cost then ",учет.сумма" else "" )  + ( if Show-Sale then ",сумма док." else "" )  +
     1614    ",кол-во" + (if Show-Cost then ",учет.сумма" else "" )  + ( if Show-Sale then ",сумма док." else "" )  +
     1615    ",кол-во" + (if Show-Cost then ",учет.сумма" else "" )  + ( if Show-Sale then ",сумма док." else "" )  +
     1616    ",кол-во" + (if Show-Cost then ",учет.сумма" else "" )  + ( if Show-Sale then ",сумма док." else "" )  +
     1617    ",кол-во" + (if Show-Cost then ",учет.сумма" else "" )  + ( if Show-Sale then ",сумма док." else "" )  .
     1618    sheetf.Sizes  = "10,16,60,7,13,13,13,13,13,13,13,13,13," +
     1619                              (if Show-Cost then "13,13,13,13,13,13,13,13,13," else "") +
     1620                              (if Show-Sale then "13,13,13,13,13,13,13,13,13," else "") .
     1621    Sheetf.ColFOrmat = "2=@;3=@"  .
     1622   END PROCEDURE.
     1623   PROCEDURE state-changed :
     1624     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1625     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1626     CASE p-state:
     1627     END CASE.
     1628     END PROCEDURE.
