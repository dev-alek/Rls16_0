      677   function diff-list returns character (
      678     input parfirst-list  as character,
      679     input parsecond-list as character,
      680     input pardelim       as character).
      681     if pardelim = ""
      682     or pardelim = ?
      683     then do:
      684       assign
      685         pardelim = ","
      686       .
      687     end.
      688     def var ind as integer no-undo .
      689     def var v-elem as character no-undo .
      690     def var v-result-list as character no-undo init "".
      691     def var v-num-parfirst-list as integer no-undo .
      692     assign
      693       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      694     .
      695     do ind = 1 to v-num-parfirst-list
      696     :
      697       assign
      698         v-elem = entry(ind, parfirst-list, pardelim)
      699       .
      700       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      701         assign
      702           v-result-list = v-result-list
      703                         + (if v-result-list > "" then pardelim else "")
      704                         + v-elem
      705         .
      706       end.
      707     end.
      708     return v-result-list .
      709   end function.
      710   function add-list returns character (
      711    input parfirst-list  as character,
      712    input parsecond-list as character,
      713    input pardelim       as character).
      714     if pardelim = ""
      715     or pardelim = ?
      716     then do:
      717       assign
      718         pardelim = ","
      719       .
      720     end.
      721     def var ind as integer no-undo .
      722     def var v-elem as character no-undo .
      723     def var v-result-list as character no-undo init "".
      724     def var v-num-parfirst-list as integer no-undo .
      725     assign
      726       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      727     .
      728     do ind = 1 to v-num-parfirst-list
      729     :
      730       assign
      731         v-elem = entry(ind, parfirst-list, pardelim)
      732       .
      733       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      734         assign
      735           v-result-list = v-result-list
      736                         + (if v-result-list > "" then pardelim else "")
      737                         + v-elem
      738         .
      739       end.
      740     end.
      741     def var v-num-parsecond-list as integer no-undo .
      742     assign
      743       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      744     .
      745     do ind = 1 to v-num-parsecond-list
      746     :
      747       assign
      748         v-elem = entry(ind, parsecond-list, pardelim)
      749       .
      750       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      751         assign
      752           v-result-list = v-result-list
      753                         + (if v-result-list > "" then pardelim else "")
      754                         + v-elem
      755         .
      756       end.
      757     end.
      758     return v-result-list .
      759   end function.
      760   function cross-list returns character (
      761    input parfirst-list  as character,
      762    input parsecond-list as character,
      763    input pardelim       as character).
      764     if pardelim = ""
      765     or pardelim = ?
      766     then do:
      767       assign
      768         pardelim = ","
      769       .
      770     end.
      771     def var ind as integer no-undo .
      772     def var v-elem as character no-undo .
      773     def var v-result-list as character no-undo init "".
      774     def var v-num-parfirst-list as integer no-undo .
      775     assign
      776       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      777     .
      778     do ind = 1 to v-num-parfirst-list
      779     :
      780       assign
      781         v-elem = entry(ind, parfirst-list, pardelim)
      782       .
      783       if lookup(v-elem, v-result-list, pardelim) = 0
      784       and lookup(v-elem, parsecond-list, pardelim) > 0
      785       then do:
      786         assign
      787           v-result-list = v-result-list
      788                         + (if v-result-list > "" then pardelim else "")
      789                         + v-elem
      790         .
      791       end.
      792     end.
      793     return v-result-list .
      794   end function.
      795   function radio-label returns character (
      796    input par-rs-value  as character,
      797    input par-rs-radio-buttons as character)
      798    .
      799    DEFINE variable v-result-label as character no-undo.
      800    assign
      801    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      802                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      803                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      804                             ), par-rs-radio-buttons
      805                           )
      806    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      807    .
      808   return v-result-label.
      809   end function.
      810   function m-radio-label returns character (
      811    input par-rs-value  as character,
      812    input par-rs-radio-buttons as character,
      813    input par-delim as character
      814    )
      815    .
      816    DEFINE variable v-result-label as character no-undo.
      817    assign
      818    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      819                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      820                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      821                             ), par-rs-radio-buttons, par-delim
      822                           )
      823    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      824    .
      825   return v-result-label.
      826   end function.
      827   FUNCTION mixlist returns character
      828   (
      829    input parfirst-list  as character
      830    ,input parsecond-list as character
      831    ,input pardelim       as character
      832    ,input pardelim-result as character ) :
      833     if pardelim = ""
      834     or pardelim = ?
      835     then do:
      836       assign
      837         pardelim = ","
      838       .
      839     end.
      840     def var ind as integer no-undo .
      841     def var v-elem1 as character no-undo .
      842     def var v-elem2 as character no-undo .
      843     def var v-result-list as character no-undo init "".
      844     do ind = 1 to num-entries(parfirst-list, pardelim)
      845     :
      846       assign
      847         v-elem1 = entry(ind, parfirst-list, pardelim)
      848         v-elem2 = entry(ind, parsecond-list, pardelim)
      849       .
      850         assign
      851           v-result-list = v-result-list
      852                         + (if v-result-list > "" then pardelim-result else "")
      853                         + v-elem1 + pardelim-result + v-elem2
      854         .
      855     end.
      856     return v-result-list .
      857   END FUNCTION.
