        1   DEFINE INPUT PARAMETER  parParentProc  AS WIDGET-HANDLE NO-UNDO.
        2   define input parameter p-ok as logical no-undo .
        3   define variable fl              as character no-undo .
        4   define variable post-grp_recids as character no-undo .
        5   define variable v-cli-type      as character no-undo .
        6   define variable v-cli-code      as integer   no-undo .
        7   define variable v-cli-name      as character no-undo .
        8   define variable list-dogovor    as character no-undo .
        9   define variable v-rid-list      as character no-undo .
       10   define variable v-dog-edi       as character no-undo .
       11   define variable vOk             as logical   no-undo .
       12   define variable glog            as logical   no-undo .
       13   define variable listDogovor as character no-undo .
       14   define new global shared variable g#language as character no-undo .
       15   if g#language <> '' and g#language <> 'rus':U then do:
       16     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       17   end.
       18   define new global shared variable g#library  as handle no-undo .
       19   define new global shared variable g#library2 as handle no-undo .
       20   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       21   procedure sel-date :
       22     define input  parameter p-date-handle as handle    no-undo .
       23     define input  parameter p-description as character no-undo .
       24     do
       25     on error undo, return error return-value
       26     :
       27       if (can-query (p-date-handle, "sensitive")
       28         and
       29         p-date-handle :sensitive = true
       30         )
       31       or (can-query (p-date-handle, "read-only")
       32         and
       33         p-date-handle :read-only = false
       34         )
       35       then do:
       36         if p-date-handle :handle <> focus :handle
       37         then do:
       38           apply "entry":u to p-date-handle .
       39         end.
       40         define variable v-ok            as logical no-undo .
       41         define variable v-curr-sv-date as date no-undo .
       42         assign
       43           v-curr-sv-date = date(p-date-handle :screen-value) no-error
       44         .
       45         if v-curr-sv-date = ?
       46         then do:
       47           run gbl/getcurdt.p
       48             (output v-curr-sv-date
       49             ) .
       50         end.
       51         if v-curr-sv-date <> ?
       52         then do:
       53           run gbl/d-inpday.w
       54             (input ?
       55             ,input "Выбор даты"
       56             ,input p-description
       57             ,input ""
       58             ,input-output v-curr-sv-date
       59             ,output v-ok
       60             ).
       61           if v-ok = true
       62           then do:
       63             assign
       64               p-date-handle :screen-value = string(v-curr-sv-date) .
       65             .
       66           end.
       67         end.
       68       end.
       69     end.
       70   end procedure.
       71   procedure check-contract-code :
       72     define input  parameter parmode           as   character                     no-undo.
       73     define input  parameter parhost-code      like ub.trn-doc.host-code          no-undo.
       74     define input  parameter parcli-type       like ub.trn-doc.cli-type           no-undo.
       75     define input  parameter parcli-code       like ub.trn-doc.cli-code           no-undo.
       76     define input  parameter parframe-value    as   character                     no-undo.
       77     define input  parameter parmenu-handle    as   handle                        no-undo.
       78     define input  parameter parobj-date       as   date                          no-undo.
       79     define input  parameter partype-contract  as   character                     no-undo .
       80     define output parameter parcontract-code  as   character                     no-undo.
       81     define buffer bf_contract     for ub.contract.
       82     define buffer bf-oth_contract for ub.contract.
       83     define variable varrid-list      as character no-undo.
       84     define variable varrecid         as recid     no-undo.
       85     define variable varlog           as logical   no-undo.
       86     define variable var-args         as char      no-undo.
       87     define variable var-ext-doc-type as char      no-undo.
       88     define variable jj               as integer   no-undo .
       89     do on error undo, return error return-value :
       90       var-args = parmode.
       91       parmode = entry(1, parmode).
       92       run cntrcode-get-arg-val(var-args, "doc-type", output var-ext-doc-type).
       93       if partype-contract = "" or partype-contract = ? then
       94         partype-contract = 'при':U .
       95       assign
       96         parcontract-code = ""
       97         .
       98       if parmode = "input":u
       99         then
      100       do:
      101         if parframe-value = ""
      102           then
      103         do:
      104           assign
      105             parcontract-code = ""
      106             .
      107         end.
      108         else
      109         do:
      110           find first bf_contract no-lock
      111             where bf_contract.host-code         = parhost-code
      112             and bf_contract.cli-type          = parcli-type
      113             and bf_contract.cli-code          = parcli-code
      114             and bf_contract.contract-prn-code = parframe-value
      115             no-error.
      116           if available bf_contract
      117             then
      118           do:
      119             find first bf-oth_contract no-lock
      120               where bf-oth_contract.host-code          = parhost-code
      121               and bf-oth_contract.contract-prn-code  = parframe-value
      122               and bf-oth_contract.cli-type           = parcli-type
      123               and bf-oth_contract.cli-code           = parcli-code
      124               and rowid(bf_contract)                 <> rowid(bf-oth_contract)
      125               no-error .
      126             if available bf-oth_contract
      127               then
      128             do:
      129               message
      130                 "На фирме " parhost-code skip
      131                 "у контрагента" parcli-type parcli-code skip
      132                 "имеются два контракта с номером" parframe-value skip
      133                 view-as alert-box .
      134             end.
      135             else
      136             do:
      137               assign
      138                 parcontract-code = string(bf_contract.contract-code)
      139                 .
      140             end.
      141           end.
      142         end.
      143       end.
      144       if parmode <> "input":u
      145         or parcontract-code = ""
      146         then
      147       do:
      148         run str/cont-all.w (input parmenu-handle,
      149           input parhost-code,
      150           input "b-sel,b-mark",
      151           input "firm-curr" ,
      152           input parcli-type,
      153           input parcli-code,
      154           input ?,
      155           input ?,
      156           input "current":u,
      157           input partype-contract,
      158           input-output varrid-list ) no-error.
      159         if error-status:error then
      160         do:
      161           message "Ошибка при вызове справочника договоров." skip
      162             return-value                skip
      163             error-status:get-message(1) skip
      164             error-status:get-message(2)
      165             view-as alert-box error.
      166           return error.
      167         end.
      168         do jj = 1 to num-entries (varrid-list):
      169           assign
      170             varrecid = integer(entry(jj, varrid-list)).
      171           find first bf_contract where recid(bf_contract) = varrecid no-lock no-error.
      172           if available bf_contract then
      173           do:
      174             assign
      175               parcontract-code = parcontract-code + "," + string(bf_contract.contract-code).
      176           end.
      177         end.
      178       end.
      179     end.
      180   end procedure.
      181   procedure check-contract-code-attr :
      182     define input  parameter parmode           as   character                     no-undo.
      183     define input  parameter parhost-code      like ub.trn-doc.host-code          no-undo.
      184     define input  parameter parcli-type       like ub.trn-doc.cli-type           no-undo.
      185     define input  parameter parcli-code       like ub.trn-doc.cli-code           no-undo.
      186     define input  parameter parframe-value    as   character                     no-undo.
      187     define input  parameter parmenu-handle    as   handle                        no-undo.
      188     define input  parameter parobj-date       as   date                          no-undo.
      189     define input  parameter partype-contract  as   character                     no-undo .
      190     define input  parameter parattr-code      as   character                     no-undo .
      191     define output parameter parcontract-code  as   character                     no-undo.
      192     define buffer bf_contract     for ub.contract.
      193     define buffer bf-oth_contract for ub.contract.
      194     define variable varrid-list      as character no-undo.
      195     define variable varrecid         as recid     no-undo.
      196     define variable varlog           as logical   no-undo.
      197     define variable var-args         as char      no-undo.
      198     define variable var-ext-doc-type as char      no-undo.
      199     define variable jj               as integer   no-undo .
      200     do on error undo, return error return-value :
      201       var-args = parmode.
      202       parmode = entry(1, parmode).
      203       run cntrcode-get-arg-val(var-args, "doc-type", output var-ext-doc-type).
      204       if partype-contract = "" or partype-contract = ? then
      205         partype-contract = 'при':U .
      206       assign
      207         parcontract-code = ""
      208         .
      209       if parmode = "input":u
      210         then
      211       do:
      212         if parframe-value = ""
      213           then
      214         do:
      215           assign
      216             parcontract-code = ""
      217             .
      218         end.
      219         else
      220         do:
      221           find first bf_contract no-lock
      222             where bf_contract.host-code         = parhost-code
      223             and bf_contract.cli-type          = parcli-type
      224             and bf_contract.cli-code          = parcli-code
      225             and bf_contract.contract-prn-code = parframe-value
      226             no-error.
      227           if available bf_contract
      228             then
      229           do:
      230             find first bf-oth_contract no-lock
      231               where bf-oth_contract.host-code          = parhost-code
      232               and bf-oth_contract.contract-prn-code  = parframe-value
      233               and bf-oth_contract.cli-type           = parcli-type
      234               and bf-oth_contract.cli-code           = parcli-code
      235               and rowid(bf_contract)                 <> rowid(bf-oth_contract)
      236               no-error .
      237             if available bf-oth_contract
      238               then
      239             do:
      240               message
      241                 "На фирме " parhost-code skip
      242                 "у контрагента" parcli-type parcli-code skip
      243                 "имеются два контракта с номером" parframe-value skip
      244                 view-as alert-box .
      245             end.
      246             else
      247             do:
      248               assign
      249                 parcontract-code = string(bf_contract.contract-code)
      250                 .
      251             end.
      252           end.
      253         end.
      254       end.
      255       if parmode <> "input":u
      256         or parcontract-code = ""
      257         then
      258       do:
      259         run str/cont-all-attr.w (input parmenu-handle,
      260           input parhost-code,
      261           input "b-sel,b-mark",
      262           input "firm-curr" ,
      263           input parcli-type,
      264           input parcli-code,
      265           input ?,
      266           input ?,
      267           input "current":u,
      268           input partype-contract,
      269           input parattr-code,
      270           input-output varrid-list ) no-error.
      271         if error-status:error then
      272         do:
      273           message "Ошибка при вызове справочника договоров." skip
      274             return-value                skip
      275             error-status:get-message(1) skip
      276             error-status:get-message(2)
      277             view-as alert-box error.
      278           return error.
      279         end.
      280         do jj = 1 to num-entries (varrid-list):
      281           assign
      282             varrecid = integer(entry(jj, varrid-list)).
      283           find first bf_contract where recid(bf_contract) = varrecid no-lock no-error.
      284           if available bf_contract then
      285           do:
      286             assign
      287               parcontract-code = parcontract-code + "," + string(bf_contract.contract-code).
      288           end.
      289         end.
      290       end.
      291     end.
      292   end procedure.
      293   procedure cntrcode-get-arg-val:
      294     def input param p-args as char no-undo.
      295     def input param p-key as char no-undo.
      296     def output param p-val as char no-undo.
      297     def var i       as int  no-undo.
      298     def var nums    as int  no-undo.
      299     def var key-val as char no-undo.
      300     nums = num-entries(p-args).
      301     do i = 1 to nums:
      302       key-val = entry(i, p-args).
      303       if key-val begins (p-key + "=") then
      304       do:
      305         p-val = entry(2, key-val, "=").
      306         return.
      307       end.
      308     end.
      309     p-val = "".
      310   end.
