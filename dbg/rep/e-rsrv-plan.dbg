     2079   if p-ok then v-title = "Заказ товаров Магазина" .
     2080   else v-title = "Отчет по планированию заказа товаров Магазина и готовой продукции Кафе" .
     2081   Date-order = today .
     2082   Date-End = today - 1 .
     2083   Date-Start = today - 28 .
     2084   find first tt-typeDocChoose no-error .
     2085   if not available (tt-typeDocChoose) then
     2086   do:
     2087       create tt-typeDocChoose .
     2088       assign
     2089           tt-typeDocChoose.type-code = 'es':U
     2090           tt-typeDocChoose.typeName  = "расход внешний касса"
     2091           .
     2092       create tt-typeDocChoose .
     2093       assign
     2094           tt-typeDocChoose.type-code = 'rs':U
     2095           tt-typeDocChoose.typeName  = "возврат внешний касса"
     2096           .
     2097   end.
     2098   for each tt-typeDocChoose:
     2099       f-typedoc-desc = f-typedoc-desc + ", " + tt-typeDocChoose.typeName .
     2100   end.
     2101   f-typedoc-desc = trim(f-typedoc-desc,", ") .
     2102   display f-typedoc-desc with frame Dialog-Frame .
     2103   RUN enable_UI.
     2104   apply  "CHOOSE":U   to  button-1 in frame Dialog-Frame .
     2105   WAIT-FOR GO OF FRAME Dialog-Frame.
     2106   END.
     2107   RUN disable_UI.
     2108   PROCEDURE disable_UI :
     2109       HIDE FRAME Dialog-Frame.
     2110   END PROCEDURE.
     2111   PROCEDURE enable_UI :
     2112       DISPLAY Date-order rs_period text-sale-list1 text-period_list2 Date-Start
     2113           Date-End RADIO-SET-1 sale_day garant_day text-client text-dogovor
     2114           customer-name text-googs SelectGood
     2115           t-daygoods Goods-Editor F-button-1 F-button-2 text-cliname
     2116           WITH FRAME Dialog-Frame.
     2117       ENABLE b-exit Btn_OK i-exit BUTTON-1 RECT-5 RECT-6 BUTTON-2
     2118           RECT-7 Date-order b-date rs_period Date-Start Date-End RADIO-SET-1
     2119           br_date garant_day b-clients customer-name SelectGood b-chooseContract b-chooseGoods
     2120           t-daygoods Goods-Editor F-button-1 F-button-2 b-date-End b-date-Start b-contract
     2121           WITH FRAME Dialog-Frame.
     2122       VIEW FRAME Dialog-Frame.
     2123       hide b-type-doc text-typedoc_list-2 f-typedoc-desc in frame Dialog-Frame .
     2124       OPEN QUERY br_date FOR EACH tt-dateZakaz NO-LOCK INDEXED-REPOSITION.
     2125   END PROCEDURE.
     2126   PROCEDURE getGoods :
     2127       define input parameter p-list-dogovor as character no-undo .
     2128       define input parameter p-obj-code as integer no-undo .
     2129       define input parameter p-obj-type as character no-undo .
     2130       define variable ii as integer no-undo .
     2131       define buffer buf_trn-doc         for ub.trn-doc .
     2132       define buffer buf_doc-line        for ub.doc-line .
     2133       define buffer buf_goods           for ub.goods .
     2134       define buffer buf_contract-specif for ub.contract-specif .
     2135       case SelectGood:
     2136           when 1 or
     2137           when 0 then
     2138               do:
     2139                   if not p-ok then
     2140                   do:
     2141                       if list-dogovor <> "" then
     2142                       do:
     2143                           list-dogovor = "".
     2144                           customer-name = "БЕЗ ДОГОВОРА" .
     2145                           display customer-name with frame Dialog-Frame .
     2146                       end.
     2147                   end.
     2148                   else
     2149                   do:
     2150                       for each ub.contract no-lock where ub.contract.cli-code = p-obj-code and
     2151                           ub.contract.cli-type = p-obj-type and
     2152                           (ub.contract.contract-date-end > today or ub.contract.contract-date-end = ?) and
     2153                           ub.contract.contract-date-beg <= today and
     2154                           ub.contract.status_ = 'тек':U:
     2155                           find first ub.contract-attr no-lock where ub.contract-attr.contract-code = ub.contract.contract-code and
     2156                               ub.contract-attr.host-code = ub.contract.host-code and
     2157                               ub.contract-attr.attr-code = "contract-edi_orders" and
     2158                               ub.contract-attr.attr-value = string (true) no-error .
     2159                           if not available (ub.contract-attr) then next .
     2160                           for each buf_contract-specif no-lock where
     2161                               buf_contract-specif.contract-num = ub.contract.contract-code :
     2162                               find first gds-list where gds-list.gds-code = ub.contract-specif.gds-code and
     2163                                   gds-list.contract = ub.contract.contract-prn-code no-error .
     2164                               if not available (gds-list) then
     2165                               do:
     2166                                   find first buf_goods no-lock where buf_goods.gds-code = buf_contract-specif.gds-code no-error .
     2167                                   if available (buf_goods) then
     2168                                   do:
     2169                                       create gds-list .
     2170                                       buffer-copy buf_goods to gds-list assign
     2171                                           gds-list.contract-code = ub.contract.contract-code
     2172                                           gds-list.contract      = ub.contract.contract-prn-code
     2173                                           .
     2174                                   end.
     2175                               end.
     2176                           end.
     2177                       end.
     2178                   end.
     2179               end.
     2180           when 2 then
     2181               do:
     2182                   do ii = 1 to num-entries (list-dogovor):
     2183                       find first ub.contract no-lock where ub.contract.contract-code = integer(entry(ii,list-dogovor,",")) no-error .
     2184                       for each buf_contract-specif no-lock where buf_contract-specif.contract-num = ub.contract.contract-code:
     2185                           find first gds-list where gds-list.gds-code = buf_contract-specif.gds-code and
     2186                               gds-list.contract-code = buf_contract-specif.contract-num no-error .
     2187                           if not available (gds-list) then
     2188                           do:
     2189                               find first buf_goods no-lock where buf_goods.gds-code = buf_contract-specif.gds-code no-error .
     2190                               if available (buf_goods) then
     2191                               do:
     2192                                   create gds-list .
     2193                                   buffer-copy buf_goods to gds-list assign
     2194                                       gds-list.contract-code = ub.contract.contract-code
     2195                                       gds-list.contract = ub.contract.contract-prn-code
     2196                                       .
     2197                               end.
     2198                           end.
     2199                       end.
     2200                   end.
     2201               end.
     2202       end case .
     2203   END PROCEDURE.
     2204   FUNCTION customerName RETURNS CHARACTER
     2205       ( p-dogovor as character) :
     2206       define variable ii    as integer   no-undo .
     2207       define variable name_ as character no-undo .
     2208       define buffer buf_contract for ub.contract .
     2209       do ii = 1 to num-entries(p-dogovor):
     2210           find first buf_contract no-lock where buf_contract.contract-code = integer(entry(ii,p-dogovor,",")) no-error .
     2211           if available (buf_contract) then
     2212           do:
     2213               name_ = name_ + ", " + buf_contract.contract-prn-code .
     2214           end.
     2215       end.
     2216       if name_ <> "" then name_ = trim(name_,",") .
     2217       RETURN name_ .
     2218   END FUNCTION.
