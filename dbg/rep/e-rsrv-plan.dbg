      544   DEFINE BROWSE br_date
      545       QUERY br_date NO-LOCK DISPLAY
      546       tt-dateZakaz.dateStart COLUMN-LABEL "Начало" FORMAT "99/99/9999":U WIDTH 14
      547       tt-dateZakaz.dateEnd COLUMN-LABEL "Конец" FORMAT "99/99/9999":U
      548       WITH NO-ROW-MARKERS SEPARATORS NO-SCROLLBAR-VERTICAL SIZE 30 BY 7.71
      549            TITLE "Интервалы анализа" ROW-HEIGHT-CHARS 1 FIT-LAST-COLUMN.
      550   DEFINE FRAME Dialog-Frame
      551       b-exit AT ROW 1 COL 1 WIDGET-ID 4
      552       Btn_OK AT ROW 1 COL 11 WIDGET-ID 10
      553       i-exit AT ROW 1.08 COL 11.13 WIDGET-ID 12 NO-TAB-STOP
      554       BUTTON-1 AT ROW 2.5 COL 2 WIDGET-ID 14
      555       BUTTON-2 AT ROW 2.5 COL 17 WIDGET-ID 16
      556       Date-order AT ROW 4.25 COL 46 RIGHT-ALIGNED WIDGET-ID 50
      557       b-date AT ROW 4.29 COL 49.38 RIGHT-ALIGNED WIDGET-ID 374
      558       rs_period AT ROW 5.75 COL 44.30 NO-LABEL WIDGET-ID 40
      559       text-sale-list1 AT ROW 5.83 COL 2.63 NO-LABEL WIDGET-ID 84
      560       text-period_list2 AT ROW 6 COL 11.75 COLON-ALIGNED NO-LABEL WIDGET-ID 94
      561       Date-Start AT ROW 6 COL 47.75 COLON-ALIGNED WIDGET-ID 34
      562       b-date-Start AT ROW 6 COL 65 RIGHT-ALIGNED WIDGET-ID 374
      563       Date-End AT ROW 6 COL 83.38 RIGHT-ALIGNED WIDGET-ID 32
      564       b-date-End AT ROW 6 COL 86.63 RIGHT-ALIGNED WIDGET-ID 374
      565       RADIO-SET-1 AT ROW 7 COL 6.38 NO-LABEL WIDGET-ID 56
      566       sale_day AT ROW 7.13 COL 37.88 RIGHT-ALIGNED NO-LABEL WIDGET-ID 66
      567       bt-not-sel-all AT ROW 7.54 COL 51.75 WIDGET-ID 86 NO-TAB-STOP
      568       bt-not-sel-desel-all AT ROW 7.54 COL 54.75 WIDGET-ID 88 NO-TAB-STOP
      569       br_date AT ROW 7.54 COL 86.75 RIGHT-ALIGNED WIDGET-ID 200
      570       garant_day AT ROW 8.46 COL 37.88 RIGHT-ALIGNED WIDGET-ID 52
      571       text-client AT ROW 10.25 COL 2.5 NO-LABEL WIDGET-ID 80
      572       b-clients AT ROW 10.25 COL 35.63 RIGHT-ALIGNED WIDGET-ID 46
      573       text-dogovor AT ROW 11.75 COL 2.5 NO-LABEL WIDGET-ID 376
      574       customer-name AT ROW 12.83 COL 35.5 RIGHT-ALIGNED NO-LABEL WIDGET-ID 48
      575       text-googs AT ROW 15.08 COL 2.5 NO-LABEL WIDGET-ID 82
      576       text-typedoc_list-2 AT ROW 15.5 COL 11.75 COLON-ALIGNED NO-LABEL WIDGET-ID 96
      577       b-type-doc AT ROW 15.5 COL 31.75 WIDGET-ID 36
      578       f-typedoc-desc AT ROW 15.5 COL 35.75 COLON-ALIGNED NO-LABEL WIDGET-ID 90
      579       text-cliname AT ROW 10.25 COL 36.75 COLON-ALIGNED NO-LABEL WIDGET-ID 90
      580       SelectGood AT ROW 16.08 COL 2.5 NO-LABEL WIDGET-ID 68
      581       b-contract AT ROW 17.21 COL 35.63 RIGHT-ALIGNED WIDGET-ID 384
      582       t-daygoods AT ROW 18 COL 14 WIDGET-ID 92
      583       b-chooseContract AT ROW 18.38 COL 35.63 RIGHT-ALIGNED WIDGET-ID 386
      584       b-chooseGoods AT ROW 18.38 COL 38.75 RIGHT-ALIGNED WIDGET-ID 388
      585       Goods-Editor AT ROW 19.63 COL 2.5 NO-LABEL WIDGET-ID 54
      586       F-button-1 AT ROW 2.75 COL 1 COLON-ALIGNED NO-LABEL WIDGET-ID 372
      587       F-button-2 AT ROW 2.75 COL 16 COLON-ALIGNED NO-LABEL WIDGET-ID 348
      588       RECT-5 AT ROW 3.75 COL 2 WIDGET-ID 378
      589       RECT-6 AT ROW 10 COL 2 WIDGET-ID 380
      590       RECT-7 AT ROW 11.5 COL 2 WIDGET-ID 382
      591       SPACE(1.24) SKIP(0.57)
      592       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      593       SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      594       TITLE v-title WIDGET-ID 100.
      595   ASSIGN
      596       FRAME Dialog-Frame:SCROLLABLE = FALSE
      597       FRAME Dialog-Frame:HIDDEN     = TRUE.
      598   ASSIGN
      599       b-chooseContract:HIDDEN IN FRAME Dialog-Frame = TRUE.
      600   ASSIGN
      601       b-chooseGoods:HIDDEN IN FRAME Dialog-Frame = TRUE.
      602   ASSIGN
      603       b-clients:HIDDEN IN FRAME Dialog-Frame = TRUE.
      604   ASSIGN
      605       b-contract:HIDDEN IN FRAME Dialog-Frame = TRUE.
      606   ASSIGN
      607       b-date:HIDDEN IN FRAME Dialog-Frame = TRUE.
      608   ASSIGN
      609       b-date-Start:HIDDEN IN FRAME Dialog-Frame = TRUE.
      610   ASSIGN
      611       b-date-End:HIDDEN IN FRAME Dialog-Frame = TRUE.
      612   ASSIGN
      613       tt-dateZakaz.dateStart:AUTO-RESIZE IN BROWSE br_date = TRUE.
      614   ASSIGN
      615       customer-name:READ-ONLY IN FRAME Dialog-Frame = TRUE.
      616   ASSIGN
      617       f-typedoc-desc:READ-ONLY IN FRAME Dialog-Frame = TRUE.
      618   ASSIGN
      619       text-cliname:READ-ONLY IN FRAME Dialog-Frame = TRUE.
      620   ASSIGN
      621       Goods-Editor:READ-ONLY IN FRAME Dialog-Frame = TRUE.
      622   ASSIGN
      623       text-client:READ-ONLY IN FRAME Dialog-Frame = TRUE.
      624   ASSIGN
      625       text-dogovor:READ-ONLY IN FRAME Dialog-Frame = TRUE.
      626   ASSIGN
      627       text-googs:READ-ONLY IN FRAME Dialog-Frame = TRUE.
      628   ASSIGN
      629       text-period_list2:READ-ONLY IN FRAME Dialog-Frame = TRUE.
      630   ASSIGN
      631       text-sale-list1:READ-ONLY IN FRAME Dialog-Frame = TRUE.
      632   ASSIGN
      633       text-typedoc_list-2:READ-ONLY IN FRAME Dialog-Frame = TRUE.
      634   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      635       DO:
      636           APPLY "END-ERROR":U TO SELF.
      637       END.
      638   ON CHOOSE OF b-chooseContract IN FRAME Dialog-Frame
      639       DO:
      640           define buffer buf_clients for ub.clients .
      641           APPLY "choose" TO b-contract .
      642           if list-dogovor = "" then
      643           do:
      644               list-dogovor = customer-name .
      645               empty temp-table gds-list .
      646               SelectGood = 2 .
      647               Goods-Editor = "" .
      648               display SelectGood Goods-Editor with frame Dialog-Frame .
      649               hide b-chooseContract b-chooseGoods in frame Dialog-Frame .
      650               enable b-contract with frame Dialog-Frame .
      651               return no-apply .
      652           end.
      653           if listDogovor <> "" then
      654               APPLY "choose" TO b-chooseGoods .
      655       END.
      656   ON CHOOSE OF b-contract IN FRAME Dialog-Frame
      657       DO:
      658           define buffer buf_clients for ub.clients .
      659           if p-ok then
      660           do:
      661               run check-contract-code-attr in this-procedure (input  substitute("&1,&2", "choose":u, "doc-type"),
      662                   input  v-cntxt-host-code-obj,
      663                   input  v-cli-type,
      664                   input  v-cli-code,
      665                   input  ?,
      666                   input  parparentproc,
      667                   input  today,
      668                   input  "" ,
      669                   input  "contract-edi_orders",
      670                   output listDogovor) .
      671           end.
      672           else
      673           do:
      674               run check-contract-code in this-procedure (input  substitute("&1,&2", "choose":u, "doc-type"),
      675                   input  v-cntxt-host-code-obj,
      676                   input  v-cli-type,
      677                   input  v-cli-code,
      678                   input  ?,
      679                   input  parparentproc,
      680                   input  today,
      681                   input  "" ,
      682                   output listDogovor) no-error.
      683           end.
      684           if listDogovor <> "" then do:
      685               listDogovor =  trim (listDogovor,",") .
      686               list-dogovor = listDogovor .
      687               empty temp-table gds-list .
      688               customer-name = customerName(list-dogovor) .
      689               display customer-name with frame Dialog-Frame .
      690               find first buf_clients no-lock where recid(buf_clients) = integer(post-grp_recids) no-error .
      691               if available (buf_clients) then
      692               run getGoods(list-dogovor, buf_clients.obj-code, buf_clients.obj-type) .
      693           end.
      694       END.
      695   ON choose OF bt-not-sel-all IN FRAME Dialog-Frame
      696       DO:
      697           run rep/choose_date.w (input parParentProc,
      698               input-output table tt-dateZakaz by-reference) .
      699           OPEN QUERY br_date FOR EACH tt-dateZakaz NO-LOCK INDEXED-REPOSITION.
      700       END.
      701   ON CHOOSE OF b-chooseGoods IN FRAME Dialog-Frame
      702       DO:
      703           if list-dogovor = "" then
      704           do:
      705               message "Для выбора товара необходимо выбрать договор(ы)" view-as alert-box.
      706               SelectGood = 1 .
      707               display SelectGood with frame Dialog-Frame .
      708               hide b-chooseContract b-chooseGoods b-contract in frame Dialog-Frame .
      709               return no-apply.
      710           end.
      711           RUN str/contspec_choose.w (
      712               input  parparentproc,
      713               input  "b-mark,b-sel",
      714               input  'ПРОСМОТР':U,
      715               input  v-cntxt-host-code-obj,
      716               input  list-dogovor,
      717               input integer(post-grp_recids),
      718               output table choose-gds-list
      719               ).
      720           find first gds-list no-error .
      721           if available (gds-list) then
      722           do:
      723               find first choose-gds-list no-error .
      724               if available (choose-gds-list) then
      725               do:
      726                   v-rid-list = "" .
      727                   Goods-Editor = "" .
      728                   empty temp-table gds-list .
      729                   for each choose-gds-list:
      730                       create gds-list.
      731                       buffer-copy choose-gds-list to gds-list .
      732                   end.
      733               end.
      734               else
      735               do:
      736                   return no-apply .
      737               end.
      738           end.
      739           else
      740           do:
      741               find first choose-gds-list no-error .
      742               if not available (choose-gds-list) then
      743               do:
      744                   SelectGood = 2 .
      745                   Goods-Editor = "" .
      746                   display SelectGood Goods-Editor with frame Dialog-Frame .
      747                   hide b-chooseContract b-chooseGoods in frame Dialog-Frame .
      748                   enable b-contract with frame Dialog-Frame .
      749                   return no-apply .
      750               end.
      751               else
      752               do:
      753                   v-rid-list = "" .
      754                   Goods-Editor = "" .
      755                   empty temp-table gds-list .
      756                   for each choose-gds-list:
      757                       create gds-list.
      758                       buffer-copy choose-gds-list to gds-list .
      759                   end.
      760               end.
      761           end.
      762           for each gds-list:
      763               if lookup(string(gds-list.gds-code),v-rid-list,", ") > 0 then next .
      764               v-rid-list = v-rid-list + "," + string(gds-list.gds-code) .
      765           end.
      766           v-rid-list = trim(v-rid-list,",") .
      767           Goods-Editor = v-rid-list .
      768           display Goods-Editor with frame Dialog-Frame .
      769       END.
      770   ON choose OF bt-not-sel-desel-all IN FRAME Dialog-Frame
      771       DO:
      772           if available (tt-dateZakaz) then
      773           do:
      774               delete tt-dateZakaz .
      775           end.
      776           else
      777           do:
      778               message "Не выбран интервал анализа для удаления"
      779                   view-as alert-box.
      780           end.
      781           OPEN QUERY br_date FOR EACH tt-dateZakaz NO-LOCK INDEXED-REPOSITION.
      782       END.
      783   ON LEAVE OF Date-End IN FRAME Dialog-Frame
      784       DO:
      785           if date(Date-End:screen-value) >= today then
      786           do:
      787               message "Дата окончания периода продаж должна быть меньше текущей"
      788                   view-as alert-box.
      789               display Date-End with frame Dialog-Frame .
      790               return no-apply .
      791           end.
      792           Assign  Date-End no-error.
      793           display Date-End with frame Dialog-Frame .
      794       END.
      795   ON LEAVE OF Date-Start IN FRAME Dialog-Frame
      796       DO:
      797           if date(Date-Start:screen-value) >= today then
      798           do:
      799               message "Дата начала периода продаж должна быть меньше текущей"
      800                   view-as alert-box.
      801               display Date-Start with frame Dialog-Frame .
      802               return no-apply .
      803           end.
      804           Assign  Date-Start no-error.
      805           display Date-Start with frame Dialog-Frame .
      806       END.
      807   ON CHOOSE OF btn_ok IN FRAME Dialog-Frame
      808       DO:
      809           define buffer buf_clients for ub.clients .
      810               define buffer buf_trn-doc         for ub.trn-doc .
      811       define buffer buf_doc-line        for ub.doc-line .
      812       define buffer buf_goods           for ub.goods .
      813       define buffer buf_contract-specif for ub.contract-specif .
      814           if text-cliname = "" then
      815           do:
      816               message "Выберите контрагента!"
      817                   view-as alert-box.
      818               return no-apply .
      819           end.
      820           if SelectGood = 3 and Goods-Editor = "" then
      821           do:
      822               message "Товар не выбран!"
      823                   view-as alert-box.
      824               return no-apply .
      825           end.
      826           if fl = "" then
      827           do:
      828               message "Необходимо сходить на вкладку 'Продолжение...'"
      829                   view-as alert-box.
      830               APPLY "choose" TO BUTTON-2 .
      831               return no-apply .
      832           end.
      833           vOk = true .
      834           case SelectGood:
      835               when 0 or
      836               when 1 then
      837                   do:
      838                       glog = yes .
      839                       find first buf_clients no-lock where recid(buf_clients) = integer(post-grp_recids) no-error .
      840                       if available (buf_clients) then
      841                           run getGoods(list-dogovor, buf_clients.obj-code, buf_clients.obj-type) .
      842                       if not glog then return no-apply .
      843                   end.
      844           end case .
      845           find first gds-list no-error .
      846           if not available (gds-list) then
      847           do:
      848               if p-ok then
      849               do:
      850                   message "Не найдены товары для создания заказа."
      851                       view-as alert-box.
      852                   return no-apply .
      853               end.
      854               else run getGoods(list-dogovor, buf_clients.obj-code, buf_clients.obj-type) .
      855           end.
      856           assign
      857               t-daygoods
      858               RADIO-SET-1
      859               rs_period
      860               .
      861           if not p-ok and (SelectGood = 0 or SelectGood = 1) then
      862           do:
      863              block-trn-doc:
      864              for each buf_trn-doc no-lock where buf_trn-doc.obj-code = v-cntxt-obj-code and
      865                   buf_trn-doc.obj-type = v-cntxt-obj-type and
      866                   buf_trn-doc.cli-code = buf_clients.obj-code and
      867                   buf_trn-doc.cli-type = buf_clients.obj-type and
      868                   buf_trn-doc.ext-doc-type = 'ie':U and
      869                   buf_trn-doc.status_ = 'факт':U:
      870                      if buf_trn-doc.contract-code <> 0 then do:
      871                         find first ub.contract no-lock where ub.contract.host-code = buf_trn-doc.host-code and
      872                               ub.contract.cli-code = buf_trn-doc.cli-code and
      873                               ub.contract.cli-type = buf_trn-doc.cli-type and
      874                               ub.contract.status_ = 'тек':U and
      875                               ub.contract.contract-code = buf_trn-doc.contract-code no-error.
      876                               if available ub.contract and
      877                               (ub.contract.contract-date-end > today or ub.contract.contract-date-end = ?) and
      878                                   ub.contract.contract-date-beg <= today then
      879                               do:
      880                               end.
      881                               else
      882                                  next block-trn-doc.
      883                      end.
      884                      else release ub.contract .
      885                   for each buf_doc-line no-lock where buf_doc-line.doc-code = buf_trn-doc.doc-code,
      886                       first buf_goods no-lock where buf_goods.artic = buf_doc-line.artic and
      887                       buf_goods.prod-code = buf_doc-line.prod-code and
      888                       buf_goods.prod-type = buf_doc-line.prod-type:
      889                       if available ub.contract then
      890                       do:
      891                               for first buf_contract-specif no-lock where
      892                               buf_contract-specif.host-code = ub.contract.host-code and
      893                               buf_contract-specif.contract-num = ub.contract.contract-code and
      894                               buf_contract-specif.gds-code = buf_goods.gds-code:
      895                                   find first gds-list where gds-list.gds-code = buf_contract-specif.gds-code and
      896                                       gds-list.contract = ub.contract.contract-prn-code and
      897                                       gds-list.contract-code = buf_contract-specif.contract-num no-error .
      898                                   if not available (gds-list) then
      899                                   do:
      900                                       create gds-list .
      901                                       buffer-copy buf_goods to gds-list
      902                                           assign
      903                                           gds-list.contract-code = ub.contract.contract-code
      904                                           gds-list.contract      = ub.contract.contract-prn-code
      905                                           .
      906                                   end.
      907                           end.
      908                       end.
      909                       else
      910                       do:
      911                           find first gds-list where gds-list.gds-code = buf_goods.gds-code no-error .
      912                           if not available (gds-list) then
      913                           do:
      914                               create gds-list .
      915                               buffer-copy buf_goods to gds-list .
      916                           end.
      917                       end.
      918                   end.
      919               end.
      920           end .
      921           if p-ok and customer-name = "БЕЗ ДОГОВОРА" then
      922           do:
      923               message "Внимание! Формирование заказа невозможно, выберите договор(-ы)"
      924                   view-as alert-box.
      925               return no-apply .
      926           end.
      927           run rep/r-rsrv-plan.p(input parParentProc,
      928               input p-ok,
      929               input post-grp_recids,
      930               input Date-order,
      931               input rs_period,
      932               input Date-Start,
      933               input Date-End,
      934               input RADIO-SET-1,
      935               input sale_day,
      936               input garant_day,
      937               input t-daygoods,
      938               input table tt-typeDocChoose,
      939               input table tt-dateZakaz,
      940               input table gds-list
      941               ) .
      942       END.
      943   ON CHOOSE OF i-exit IN FRAME Dialog-Frame
      944       DO:
      945           APPLY "choose" TO btn_ok.
      946       END.
      947   ON CHOOSE OF b-type-doc IN FRAME Dialog-Frame
      948       DO:
      949           f-typedoc-desc = "" .
      950           run ref/type_doc.w (input parParentProc, input-output table tt-typeDocChoose ) .
      951           for each tt-typeDocChoose:
      952               f-typedoc-desc = f-typedoc-desc + ", " + tt-typeDocChoose.typeName .
      953           end.
      954           f-typedoc-desc = trim(f-typedoc-desc,", ") .
      955           display f-typedoc-desc with frame Dialog-Frame .
      956       END.
      957   ON CHOOSE OF b-clients IN FRAME Dialog-Frame
      958       DO:
      959           define buffer bf_contract  for ub.contract .
      960           define buffer cli-post     for ub.clients .
      961           define buffer buf_contract for ub.contract .
      962           define variable v-nn             as integer   no-undo .
      963           define variable ii               as integer   no-undo .
      964           define variable vIsChange        as logical   no-undo init no.
      965           define variable old-list-dogovor as character no-undo .
      966           if p-ok then
      967           do:
      968               run ref/cli-all.w
      969                   ( parParentProc
      970                   , "b-sel"
      971                   , 'все':U
      972                   , 'все':U
      973                   , 'текущие':U
      974                   , ?
      975                   , ?
      976                   , "contract-edi_orders"
      977                   , output post-grp_recids ) .
      978           end.
      979           else
      980           do:
      981               run ref/cli-all.w
      982                   ( parParentProc
      983                   , "b-sel"
      984                   , 'все':U
      985                   , 'все':U
      986                   , 'текущие':U
      987                   , ?
      988                   , ?
      989                   , ""
      990                   , output post-grp_recids ) .
      991           end.
      992           if post-grp_recids <> "" then
      993           do:
      994               Assign
      995                   text-cliname  = ''
      996                   customer-name = "".
      997               v-nn = num-entries( post-grp_recids ) .
      998               DO ii = 1 TO v-nn :
      999                   FIND cli-post WHERE recid( cli-post ) = int(entry( ii, post-grp_recids )) NO-LOCK.
     1000                   if v-cli-code <> cli-post.obj-code or v-cli-type <> cli-post.obj-type then
     1001                       vIsChange = yes.
     1002                   assign
     1003                       v-cli-code   = cli-post.obj-code
     1004                       v-cli-type   = cli-post.obj-type
     1005                       v-cli-name   = cli-post.obj-name
     1006                       text-cliname = cli-post.obj-type + " " + string(cli-post.obj-code) + " " + cli-post.obj-name .
     1007               END.
     1008               if p-ok then customer-name = "Все действующие договоры с EDI" .
     1009               else customer-name = "Все действующие договоры" .
     1010               SelectGood = 1 .
     1011               if p-ok then customer-name = "Все действующие договоры с EDI" .
     1012               else customer-name = "Все действующие договоры" .
     1013               list-dogovor = "" .
     1014               v-rid-list = "" .
     1015               Goods-Editor = "" .
     1016               empty temp-table gds-list .
     1017               Display text-cliname customer-name SelectGood Goods-Editor with frame Dialog-Frame .
     1018               hide b-chooseContract b-chooseGoods b-contract in frame Dialog-Frame .
     1019           end.
     1020           else
     1021           do:
     1022               if v-cli-code <> ? and v-cli-code <> 0 then
     1023               do:
     1024                   find cli-post where cli-post.obj-code = v-cli-code and
     1025                       cli-post.obj-type = v-cli-type no-lock .
     1026                   post-grp_recids = string(recid (cli-post)) .
     1027               end.
     1028           end.
     1029       END.
     1030   ON VALUE-CHANGED OF RADIO-SET-1 IN FRAME Dialog-Frame
     1031       DO:
     1032           assign RADIO-SET-1 .
     1033           case RADIO-SET-1:
     1034               when 5 then
     1035                   do:
     1036                       enable sale_day with frame Dialog-Frame .
     1037                   end.
     1038               otherwise
     1039               do:
     1040                   disable sale_day with frame Dialog-Frame .
     1041               end.
     1042           end case .
     1043       END.
     1044   ON leave OF sale_day IN FRAME Dialog-Frame
     1045       DO:
     1046           assign sale_day .
     1047       END.
     1048   ON LEAVE OF Date-End IN FRAME Dialog-Frame
     1049       DO:
     1050           apply "TAB":U to self .
     1051       END.
     1052   ON LEAVE OF Date-Start IN FRAME Dialog-Frame
     1053       DO:
     1054           apply "TAB":U to self .
     1055       END.
     1056   ON leave OF garant_day IN FRAME Dialog-Frame
     1057       DO:
     1058           assign garant_day .
     1059           if garant_day = ? then return no-apply .
     1060       END.
     1061   ON VALUE-CHANGED OF rs_period IN FRAME Dialog-Frame
     1062       DO:
     1063           assign rs_period .
     1064           case rs_period:
     1065               when 1 then
     1066                   do:
     1067                       enable Date-End Date-Start b-date-End b-date-Start with frame Dialog-Frame .
     1068                       disable bt-not-sel-all bt-not-sel-desel-all br_date with frame Dialog-Frame .
     1069                       empty temp-table tt-dateZakaz .
     1070                       OPEN QUERY br_date FOR EACH tt-dateZakaz NO-LOCK INDEXED-REPOSITION.
     1071                   end.
     1072               otherwise
     1073               do:
     1074                   disable Date-End Date-Start b-date-End b-date-Start with frame Dialog-Frame .
     1075                   enable bt-not-sel-all bt-not-sel-desel-all br_date with frame Dialog-Frame .
     1076               end.
     1077           end case .
     1078       END.
     1079   ON VALUE-CHANGED OF SelectGood IN FRAME Dialog-Frame
     1080       DO:
     1081           define buffer buf_clients    for ub.clients .
     1082           define buffer buf_goods-attr for ub.gds-obj-attr .
     1083           define buffer bf_contract    for ub.contract .
     1084           define buffer cli-post       for ub.clients .
     1085           define buffer buf_contract   for ub.contract .
     1086           define variable ii               as integer   no-undo .
     1087           define variable v-nn             as integer   no-undo .
     1088           define variable vIsChange        as logical   no-undo init no.
     1089           define variable old-list-dogovor as character no-undo .
     1090           assign SelectGood .
     1091           find first buf_clients no-lock where recid(buf_clients) = integer(post-grp_recids) no-error .
     1092           if available (buf_clients) then
     1093           do:
     1094               case SelectGood:
     1095                   when 1 or
     1096                   when 0 then
     1097                       do:
     1098                           v-rid-list = "" .
     1099                           list-dogovor = "" .
     1100                           empty temp-table gds-list .
     1101                           if p-ok then customer-name = "Все действующие договоры с EDI" .
     1102                           else customer-name = "Все действующие договоры" .
     1103                           hide b-chooseContract b-chooseGoods b-contract in frame Dialog-Frame .
     1104                           run getGoods(list-dogovor, buf_clients.obj-code, buf_clients.obj-type) .
     1105                       end.
     1106                   when 2 then
     1107                       do:
     1108                           hide b-chooseContract b-chooseGoods in frame Dialog-Frame .
     1109                           enable b-contract with frame Dialog-Frame .
     1110                           list-dogovor = "" .
     1111                           Goods-Editor = "" .
     1112                           v-rid-list = "" .
     1113                           empty temp-table gds-list .
     1114                           APPLY "choose" TO b-contract .
     1115                           list-dogovor =  trim (list-dogovor,",") .
     1116                           if list-dogovor = "" then
     1117                           do:
     1118                               SelectGood = 1 .
     1119                               if p-ok then customer-name = "Все действующие договоры с EDI" .
     1120                               else customer-name = "Все действующие договоры" .
     1121                               display SelectGood customer-name with frame Dialog-Frame .
     1122                               hide b-chooseContract b-chooseGoods b-contract in frame Dialog-Frame .
     1123                           end.
     1124                       end.
     1125                   when 3 then
     1126                       do:
     1127                           enable b-chooseContract b-chooseGoods with frame Dialog-Frame .
     1128                           hide b-contract in frame Dialog-Frame .
     1129                           list-dogovor = "" .
     1130                           empty temp-table gds-list .
     1131                           APPLY "choose" TO b-contract .
     1132                          if list-dogovor = "" then
     1133                           do:
     1134                               SelectGood = 1 .
     1135                               if p-ok then customer-name = "Все действующие договоры с EDI" .
     1136                               else customer-name = "Все действующие договоры" .
     1137                               display SelectGood customer-name with frame Dialog-Frame .
     1138                               hide b-chooseContract b-chooseGoods b-contract in frame Dialog-Frame .
     1139                               return no-apply .
     1140                           end.
     1141                           APPLY "choose" TO b-chooseGoods .
     1142                           find first gds-list no-error .
     1143                           if not available (gds-list) then
     1144                           do:
     1145                               SelectGood = 2 .
     1146                               hide b-chooseContract b-chooseGoods in frame Dialog-Frame .
     1147                               enable b-contract with frame Dialog-Frame .
     1148                               display SelectGood with frame Dialog-Frame .
     1149                               run getGoods(list-dogovor, buf_clients.obj-code, buf_clients.obj-type) .
     1150                               return no-apply .
     1151                           end.
     1152                       end .
     1153               end case.
     1154           end.
     1155           else
     1156           do:
     1157               message "Выберите контрагента!"
     1158                   view-as alert-box.
     1159               SelectGood = 1 .
     1160               hide b-chooseContract b-chooseGoods b-contract in frame Dialog-Frame .
     1161               display SelectGood with frame Dialog-Frame .
     1162           end.
     1163           Goods-Editor = v-rid-list .
     1164           if not vOk then display Goods-Editor with frame Dialog-Frame .
     1165           for each gds-list:
     1166               for first buf_goods-attr no-lock where buf_goods-attr.gds-code = gds-list.gds-code and
     1167                   buf_goods-attr.attr-code = 'min-zapas':U:
     1168                   gds-list.minZapas = decimal (buf_goods-attr.attr-value) .
     1169               end.
     1170           end.
     1171           find first gds-list where gds-list.minZapas = 0 no-error .
     1172           if available (gds-list) then
     1173           do:
     1174               if vOk then
     1175               do:
     1176                   if p-ok then
     1177                   do:
     1178                       message "Внимание! Не у всех выбранных товаров установлен атрибут «Минимальный запас»" skip
     1179                           "Создать заказ?"
     1180                           view-as alert-box question buttons YES-NO update glog .
     1181                   end.
     1182                   else
     1183                   do:
     1184                       message "Внимание! Не у всех выбранных товаров установлен атрибут «Минимальный запас»" skip
     1185                           "Вывести отчет?"
     1186                           view-as alert-box question buttons YES-NO update glog .
     1187                   end.
     1188                   if not glog then
     1189                   do:
     1190                       APPLY "choose" TO BUTTON-1 .
     1191                   end.
     1192               end.
     1193               else
     1194               do:
     1195                   message "Внимание! Не у всех выбранных товаров установлен атрибут «Минимальный запас»"
     1196                       view-as alert-box.
     1197               end.
     1198           end.
     1199           display SelectGood customer-name Goods-Editor with frame Dialog-Frame .
     1200       END.
     1201   ON CHOOSE OF BUTTON-1 IN FRAME Dialog-Frame
     1202       DO:
     1203           DISPLAY RECT-5 RECT-6 RECT-7 Date-order b-date RADIO-SET-1 sale_day garant_day b-clients customer-name SelectGood Goods-Editor text-client text-dogovor text-googs text-sale-list1 text-cliname b-contract b-chooseContract b-chooseGoods with FRAME Dialog-Frame.
     1204           case SelectGood:
     1205               when 1 or
     1206               when 0 then
     1207                   do:
     1208                       hide b-chooseContract b-chooseGoods b-contract in frame Dialog-Frame .
     1209                   end.
     1210               when 2 then
     1211                   do:
     1212                       hide b-chooseContract b-chooseGoods in frame Dialog-Frame .
     1213                       enable b-contract with frame Dialog-Frame .
     1214                   end.
     1215               when 3 then
     1216                   do:
     1217                       hide b-contract in frame Dialog-Frame .
     1218                       enable b-chooseContract b-chooseGoods with frame Dialog-Frame .
     1219                   end.
     1220           end case .
     1221           HIDE Date-Start Date-End rs_period text-period_list2 br_date bt-not-sel-all bt-not-sel-desel-all t-daygoods b-date-Start b-date-End IN FRAME Dialog-Frame.
     1222           button-1:LOAD-IMAGE-UP("adeicon\ts-up":U)        in frame Dialog-Frame .
     1223           button-2:LOAD-IMAGE-Up("adeicon\ts-down":U)      in frame Dialog-Frame .
     1224           F-button-1:fgcolor = 1 .
     1225           f-button-2:fgcolor = ? .
     1226       END.
     1227   ON CHOOSE OF BUTTON-2 IN FRAME Dialog-Frame
     1228       DO:
     1229           assign
     1230               garant_day
     1231               Date-order
     1232               .
