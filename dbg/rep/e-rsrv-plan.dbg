     1526         v-curr-sv-date = date(self :screen-value) no-error
     1527       .
     1528       if v-curr-sv-date = ?
     1529       then do:
     1530         run gbl/getcurdt.p
     1531           (output v-curr-sv-date
     1532           ) .
