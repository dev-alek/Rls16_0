     1407   MAIN-BLOCK:
     1408   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1409       ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1410   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1411   on ' ' of Date-order in frame Dialog-Frame
     1412   do:
     1413     if (can-query (self, "sensitive")
     1414        and
     1415        self :sensitive = true
     1416        )
     1417     or (can-query (self, "read-only")
     1418        and
     1419        self :read-only = false
     1420        )
     1421     then do:
     1422       assign
     1423         self :screen-value = ?
     1424       .
     1425     end.
     1426     return no-apply.
     1427   end.
     1428   on delete-character of Date-order in frame Dialog-Frame
     1429   do:
     1430     if (can-query (self, "sensitive")
     1431        and
     1432        self :sensitive = true
     1433        )
     1434     or (can-query (self, "read-only")
     1435        and
     1436        self :read-only = false
     1437        )
     1438     then do:
     1439       assign
     1440         self :screen-value = ?
     1441       .
     1442     end.
     1443     return no-apply.
     1444   end.
     1445   on ctrl-d of Date-order in frame Dialog-Frame
     1446   do:
     1447     define variable v-curr-sv-date as date no-undo .
     1448     if (can-query (self, "sensitive")
     1449        and
     1450        self :sensitive = true
     1451        )
     1452     or (can-query (self, "read-only")
     1453        and
     1454        self :read-only = false
     1455        )
     1456     then do:
     1457       if self :handle <> focus :handle
     1458       then do:
     1459         apply "entry":u to self .
     1460       end.
     1461       run gbl/getcurdt.p
     1462         (output v-curr-sv-date
     1463         ) .
     1464       assign
     1465         self :screen-value = string(v-curr-sv-date) .
     1466       .
     1467     end.
     1468     return no-apply.
     1469   end.
     1470   on ctrl-b of Date-order in frame Dialog-Frame
     1471   do:
     1472     if (can-query (self, "sensitive")
     1473        and
     1474        self :sensitive = true
     1475        )
     1476     or (can-query (self, "read-only")
     1477        and
     1478        self :read-only = false
     1479        )
     1480     then do:
     1481       if self :handle <> focus :handle
     1482       then do:
     1483         apply "entry":u to self .
     1484       end.
     1485       define variable v-curr-sv-date as date no-undo .
     1486       define variable v-new-sv-date  as date no-undo .
     1487       assign
     1488         v-curr-sv-date = date(self :screen-value) no-error
     1489       .
     1490       if v-curr-sv-date = ?
     1491       then do:
     1492         run gbl/getcurdt.p
     1493           (output v-curr-sv-date
     1494           ) .
     1495       end.
     1496       if v-curr-sv-date <> ?
     1497       then do:
     1498         assign
     1499           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     1500         .
     1501         assign
     1502           self :screen-value = string(v-new-sv-date) .
     1503         .
     1504       end.
     1505     end.
     1506     return no-apply .
     1507   end.
     1508   on ctrl-e of Date-order in frame Dialog-Frame
     1509   do:
     1510     if (can-query (self, "sensitive")
     1511        and
     1512        self :sensitive = true
     1513        )
     1514     or (can-query (self, "read-only")
     1515        and
     1516        self :read-only = false
     1517        )
     1518     then do:
     1519       if self :handle <> focus :handle
     1520       then do:
     1521         apply "entry":u to self .
     1522       end.
     1523       define variable v-curr-sv-date as date no-undo .
