     1601     then do:
     1602       ASSIGN
     1603         Date-order :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date4 :HANDLE
     1604         Date-order :MENU-MOUSE in frame Dialog-Frame = 3
     1605       .
     1606     end.
     1607     define variable v-label-handle4 as handle no-undo .
     1608     assign
     1609       v-label-handle4 = Date-order :side-label-handle in frame Dialog-Frame
     1610     .
     1611     if valid-handle (v-label-handle4)
     1612     then do:
