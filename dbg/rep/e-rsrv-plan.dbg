     1253   ON CHOOSE OF b-date IN FRAME Dialog-Frame
     1254       DO:
     1255           run sel-date in this-procedure
     1256               (input Date-order :handle
     1257               ,input ""
     1258               ) .
     1259           if date(Date-order:screen-value) < today then
     1260           do:
     1261               message "Дата заказа должна быть равна или больше текущей"
     1262                   view-as alert-box.
     1263               display Date-order with frame Dialog-Frame .
     1264               return no-apply .
     1265           end.
     1266           assign Date-order .
     1267       END.
     1268   ON LEAVE OF Date-order IN FRAME Dialog-Frame
     1269       DO:
     1270           apply "TAB":U to self .
     1271       END.
     1272   ON RETURN OF Date-order IN FRAME Dialog-Frame
     1273       DO:
     1274           apply "TAB":U to self .
     1275       END.
     1276   ON TAB OF Date-order IN FRAME Dialog-Frame
     1277       DO:
     1278           date(Date-order:screen-value) no-error.
     1279           if error-status:error then
     1280           do:
     1281               message "Ошибка ввода даты"
     1282                   view-as alert-box.
     1283               display Date-order with frame Dialog-Frame .
     1284               return no-apply .
     1285           end.
     1286           if string(Date-order) <> Date-order:screen-value then
     1287           do:
     1288               if date(Date-order:screen-value) < today then
     1289               do:
     1290                   message "Дата заказа должна быть равна или больше текущей"
     1291                       view-as alert-box.
     1292                   display Date-order with frame Dialog-Frame .
     1293                   return no-apply.
     1294               end.
     1295               assign Date-order .
     1296               display Date-order with frame Dialog-Frame .
     1297           end.
     1298       END.
     1299   ON CHOOSE OF b-date-Start IN FRAME Dialog-Frame
     1300       DO:
     1301           run sel-date in this-procedure
     1302               (input Date-Start :handle
     1303               ,input ""
     1304               ) .
