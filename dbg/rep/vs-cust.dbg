      407   def
      408   new shared
      409   temp-table  obj-list no-undo
      410     field obj-type like ub.clients.obj-type
      411     field obj-code like ub.clients.obj-code
      412     field obj-name like ub.clients.obj-name
      413     field obj-id   as integer
