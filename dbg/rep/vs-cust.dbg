     1148   def var vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1149   function func-get-name-from-ext-type   returns char
     1150     ( p-ext-type as character   ,
     1151       p-caps     as logical ).
     1152   define variable v-ext-name as character no-undo .
     1153   run get-name-from-ext-type in this-procedure (
     1154       input p-ext-type  ,
     1155       input p-caps  ,
     1156       output v-ext-name )
     1157       no-error .
     1158       if error-status :error then do:
     1159          assign
     1160            v-ext-name = p-ext-type
     1161          .
     1162       end.
     1163    return (v-ext-name) .
     1164   end.
     1165   procedure get-name-from-ext-type :
     1166    do
     1167    on error undo, return error return-value
     1168    :
     1169   define input  parameter p-ext-type as character no-undo .
     1170   define input  parameter p-caps     as logical no-undo   .
     1171   define output parameter p-ext-name as character no-undo .
     1172   define variable v-num as integer no-undo .
     1173     if lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) = 0 then do :
     1174       message
     1175         vss-include-info11 skip
     1176         "Неправильно задано значение входящего параметра! "
     1177         "Нет такого типа документов " p-ext-type
     1178         view-as alert-box error .
     1179         undo, return error .
     1180     end.
     1181     v-num      = lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) .
     1182     p-ext-name = entry  ( v-num , 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ) .
     1183     if p-caps  = true then do :
     1184        p-ext-name = caps(substring(p-ext-name,1,1) ) + substring(p-ext-name, 2 , length (p-ext-name) - 1 ) .
     1185     end .
     1186     end.
     1187   end procedure.
     1188   define variable g#report-num as integer no-undo .
     1189   procedure OpenForExcel :
     1190      define variable v-ch#ExcelApplication as com-handle no-undo .
     1191      define variable v-ch#Workbook         as com-handle no-undo .
     1192      define variable v-ch#Worksheet        as com-handle no-undo .
     1193      os-delete value( string( session:temp-directory ) +
     1194                                 "rpt" + string( g#report-num ) + ".txt":U ) .
     1195      os-delete value( string( session:temp-directory ) +
     1196                                 "rpt" + string( g#report-num ) + ".frm":U ) .
     1197      os-delete value( string( session:temp-directory ) +
     1198                                 "rpt" + string( g#report-num ) + ".txl":U ) .
     1199      if Make-Excel
     1200      then do:
     1201         output stream ForExcel to value( string( session:temp-directory +
     1202                                        "rpt" + string( g#report-num ) + ".txt":U ) ) .
     1203         assign
     1204            v-excel-file = string( session:temp-directory + "rpt" + string( g#report-num ) )
     1205            number-list = 1
     1206         .
     1207         if make-excel-com
     1208         then do:
     1209   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1210   if valid-handle(ch#WorkSheet) then
     1211   RELEASE OBJECT ch#WorkSheet no-error.
     1212   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1213   if valid-handle(ch#Workbook) then
     1214   RELEASE OBJECT ch#Workbook no-error.
     1215   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1216   if valid-handle(ch#ExcelApplication) then
     1217   RELEASE OBJECT ch#ExcelApplication no-error.
     1218            create "Excel.Application" ch#excelApplication connect no-error.
     1219            if error-status:error
     1220            then do :
     1221           create "Excel.Application" ch#excelApplication no-error.
     1222       if error-status :error then do:
     1223           message
     1224           "Ошибка при запуске Excel" skip
     1225           error-status :get-message(1) skip
     1226           view-as alert-box error .
     1227           undo, return error .
     1228       end.
     1229            end.
     1230            assign
     1231               num#str#  = 0.
     1232               v-ch#excelApplication  = ch#excelApplication.
     1233               v-ch#excelApplication:Interactive = false.
     1234               v-ch#excelApplication:ScreenUpdating = false.
     1235               v-ch#excelApplication:Visible = false.
     1236               ch#Workbook  = v-ch#excelApplication:Workbooks:add ().
     1237               ch#WorkSheet = v-ch#excelApplication:Sheets:Item (1).
     1238               v-ch#Worksheet = ch#WorkSheet.
     1239               v-ch#Worksheet:Range ("A1"):Font:Bold = true.
     1240               v-ch#Worksheet:Range ("A1"):Font:Size = 14.
     1241               v-ch#Worksheet:Range ("A1"):HorizontalAlignment = -4131.
     1242               v-ch#Worksheet:Range ("A1"):VerticalAlignment   = -4160
     1243            no-error .
     1244            if error-status:error
     1245            then do:
     1246               Make-Excel-com = false .
     1247               Make-Excel = false .
     1248               output Stream  ForExcel close.
     1249               os-delete value( string( session:temp-directory ) +
     1250                              "rpt" + string( g#report-num ) + ".txt":U ) .
     1251               os-delete value( string( session:temp-directory ) +
     1252                              "rpt" + string( g#report-num ) + ".frm":U ) .
     1253               return.
     1254            end.
     1255         end.
     1256      end.
     1257   end.
     1258   procedure CloseForExcel :
     1259      define variable ii as integer no-undo .
     1260      define variable vsheet-num as integer no-undo.
     1261      if Make-Excel
     1262      then  do:
     1263         output Stream  ForExcel close.
     1264         os-delete value( string( session:temp-directory ) +
     1265                                "rpt" + string( g#report-num ) + ".txt":U ) .
     1266         os-delete value( string( session:temp-directory ) +
     1267                                "rpt" + string( g#report-num ) + ".frm":U ) .
     1268         define buffer buf_sheetf for sheetf.
     1269         find last buf_sheetf no-error .
     1270         if available buf_sheetf
     1271         then
     1272            vsheet-num = buf_sheetf.sheet-num.
     1273         if vsheet-num > 1
     1274         then do:
     1275            do ii = 2 to vsheet-num:
     1276               os-delete value( string( session:temp-directory ) +
     1277                                     "rpt" + string( g#report-num ) + ".":U  + string(ii)) .
     1278            end.
     1279         end.
     1280   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1281   if valid-handle(ch#WorkSheet) then
     1282   RELEASE OBJECT ch#WorkSheet no-error.
     1283   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1284   if valid-handle(ch#Workbook) then
     1285   RELEASE OBJECT ch#Workbook no-error.
     1286   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1287   if valid-handle(ch#ExcelApplication) then
     1288   RELEASE OBJECT ch#ExcelApplication no-error.
     1289      end.
     1290   end.
     1291   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1292   define variable v-waitfram-action01         as character   no-undo .
     1293   define variable v-waitfram-action02         as character   no-undo .
     1294   define variable v-waitfram-action03         as character   no-undo .
     1295   define variable mWaitFramTextBeg            as character   no-undo.
     1296   define variable mWaitFramTextEnd            as character   no-undo.
     1297   define variable mWaitFramView               as logical     no-undo.
     1298   define variable mWaitProcEvent              as logical     no-undo init yes.
     1299   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1300   define variable mWaitFramStop               as logical     no-undo.
     1301   define variable mWaitFramStopUser           as logical     no-undo.
     1302   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1303   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1304   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1305   define button B-WaitFramStop auto-end-key
     1306        label "Стоп"
     1307        size 10 by 1 tooltip "Остоновить процесс".
     1308   define button B-viewProcInfo
     1309        label "Информация"
     1310        size 15 by 1 tooltip "Информация о процесс".
     1311   define frame waitfram
     1312     v-waitfram-action01 format "x(72)" no-label skip
     1313     v-waitfram-action02 format "x(72)" no-label skip
     1314     v-waitfram-action03 format "x(72)" no-label skip
     1315     B-viewProcInfo
     1316     B-WaitFramStop at row 4 col 30
     1317     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1318     .
     1319   define new global shared variable mBatchMode as logical no-undo init ?.
     1320   define variable mFramBachModHandle as handle no-undo.
     1321   mFramBachModHandle = frame waitfram:handle.
     1322   define variable mFameOldVis as logical no-undo.
     1323   define variable mVisCUrentVin as logical no-undo.
     1324   if session:batch-mode
     1325   then
     1326      mBatchMode = yes.
     1327   if mBatchMode = ? then do:
     1328     mVisCUrentVin = current-window:visible.
     1329     mFameOldVis = mFramBachModHandle:visible.
     1330     mFramBachModHandle:visible  = yes.
     1331     mBatchMode = mFramBachModHandle:visible ne yes.
     1332     mFramBachModHandle:visible = mFameOldVis.
     1333     current-window:visible = mVisCUrentVin.
     1334   end.
     1335    if  log-manager:logfile-name ne ?
     1336     then DO:
     1337         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1338         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1339         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1340     end.
     1341   on choose of B-WaitFramStop in frame waitfram
     1342   do:
     1343     mWaitFramStop = yes.
     1344     mWaitFramStopUser = yes.
     1345   end.
     1346   function waitfram-check-timeout returns logical():
     1347      define variable vtime as int64 no-undo.
     1348      if mWaitFramStopTimeOut
     1349      then
     1350         return yes.
     1351      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1352      if     mWaitFramTimeOut ne ?
     1353         and mWaitFramTimeOut ne 0
     1354         and mWaitFramTimeOut lt vtime
     1355      then do:
     1356         mWaitFramStopTimeOut = yes.
     1357      end.
     1358      return mWaitFramStopTimeOut.
     1359   end.
     1360   procedure waitfram-hide :
     1361     if not session:batch-mode
     1362     then do
     1363     on error undo, return error return-value
     1364     :
     1365       pause 0 before-hide .
     1366       if not mBatchMode then
     1367         hide frame waitfram .
     1368     if     not mWaitFramView
     1369        and mWaitProcEvent
     1370     then
     1371       process events .
     1372     end.
     1373   end procedure.
     1374   procedure waitfram-show :
     1375     define input  parameter p-message as character no-undo .
     1376     define variable v-left-margin as integer   no-undo .
     1377     if not session:batch-mode
     1378     then do
     1379     on error undo, return error return-value
     1380     :
     1381       if length(p-message) <= 70 then do:
     1382         assign
     1383           v-left-margin = integer((70 - length(p-message)) / 2)
     1384         .
     1385         assign
     1386           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1387         .
     1388         assign
     1389           v-waitfram-action01 = " "
     1390           v-waitfram-action02 = " "
     1391                                    + fill(" ", v-left-margin)
     1392                                    + p-message
     1393           v-waitfram-action03 = " "
     1394         .
     1395       end.
     1396       else do:
     1397         define variable vRindex1 as integer no-undo.
     1398         define variable vRindex2 as integer no-undo.
     1399         vRindex1 = r-index(p-message," ",70).
     1400         if vRindex1 = 0
     1401         then
     1402            vRindex1 = 70.
     1403         if length(p-message)  <= vRindex1 + 70 then do:
     1404           assign
     1405             v-waitfram-action01 = " "
     1406             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1407             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1408           .
     1409         end.
     1410         else do:
     1411           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1412           if vRindex2 <= vRindex1
     1413           then
     1414              vRindex2 = vRindex1 + 70.
     1415           assign
     1416             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1417             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1418             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1419           .
     1420         end.
     1421       end.
     1422       B-viewProcInfo:visible   in frame waitfram = no.
     1423       B-viewProcInfo:sensitive in frame waitfram = no.
     1424       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1425       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1426       if  (   mWaitFramView
     1427          or  mWaitProcEvent)
     1428          and not mBatchMode
     1429       then
     1430          display
     1431             v-waitfram-action01 skip
     1432             v-waitfram-action02 skip
     1433             v-waitfram-action03 skip
     1434          with frame waitfram .
     1435       if     mWaitFramView
     1436          then do:
     1437             if     mWaitFramInterval ne ?
     1438                and not mBatchMode
     1439             then
     1440                wait-for go of frame waitfram pause mWaitFramInterval.
     1441          end.
     1442          else
     1443             if     mWaitProcEvent
     1444                and not mBatchMode
     1445             then
     1446                process events .
     1447     end.
     1448   end procedure.
     1449      procedure waitfram-show-this:
     1450         define input  parameter iInterval as int64 no-undo.
     1451         define variable vtime as int64 no-undo.
     1452         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1453         mWaitFramInterval = iInterval.
     1454         run waitfram-show (substitute("&1&2 &3&4" ,
     1455                                       mWaitFramTextBeg ,
     1456                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1457                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1458                                       mWaitFramTextEnd
     1459                                      )
     1460                           ).
     1461      end.
     1462      procedure WaitFramRunPause:
     1463         define input  parameter iInterval as dec no-undo.
     1464         define variable vStart  as datetime-tz no-undo.
     1465         define variable vend    as datetime-tz no-undo.
     1466         define variable vint as int64 no-undo.
     1467         define variable vOk as logical no-undo.
     1468         vStart = now.
     1469         vend   = vStart.
     1470         publish "WaitFramPause" (iInterval,output vOk).
     1471         vend   =  now.
     1472         vint = vend - vStart.
     1473         vint = iInterval - vint / 1000.
     1474         if     not mWaitFramStop
     1475            and (   vint > 0
     1476                 or (    not vOk
     1477                     and iInterval eq ?
     1478                     )
     1479                 )
     1480         then
     1481            run waitfram-show-this (iInterval).
     1482         vend   =  now.
     1483         vint = vend - vStart.
     1484         vint = iInterval - vint / 1000.
     1485         if     not mWaitFramStop
     1486            and vint > 0
     1487         then do:
     1488            run gbl/pause.p (vint * 1000).
     1489         end.
     1490         if iInterval ne ?
     1491         then
     1492            publish "WaitFramStop".
     1493         waitfram-check-timeout().
     1494      end.
     1495      procedure WaitFramWaitFor:
     1496         define input  parameter iInterval as dec no-undo.
     1497         assign
     1498            mWaitFramStartProc   = now
     1499            mWaitFramStopUser    = no
     1500            mWaitFramStopTimeOut = no
     1501         .
     1502         block-wait:
     1503         do while not mWaitFramStop:
     1504            run WaitFramRunPause (iInterval).
     1505            if  waitfram-check-timeout()
     1506            then do:
     1507               leave block-wait.
     1508            end.
     1509         end.
     1510         run waitfram-hide.
     1511      end.
     1512   procedure waitfram-join :
     1513     define input  parameter p-line-1  as character no-undo .
     1514     define input  parameter p-line-2  as character no-undo .
     1515     define input  parameter p-line-3  as character no-undo .
     1516     define output parameter p-message as character no-undo .
     1517     do
     1518     on error undo, return error return-value
     1519     :
     1520       assign
     1521         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1522                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1523                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1524       .
     1525     end.
     1526   end procedure.
     1527   function waitfram-join-function returns character
     1528     (input p-line-1 as character
     1529     ,input p-line-2 as character
     1530     ,input p-line-3 as character
     1531     ).
     1532     define variable v-message as character no-undo .
     1533     run waitfram-join in this-procedure
     1534       (input  p-line-1
     1535       ,input  p-line-2
     1536       ,input  p-line-3
     1537       ,output v-message
     1538       ) .
     1539     return v-message .
     1540   end function .
     1541   define variable v-host-code like ub.sysconf.host-code no-undo .
     1542   define variable base-type as character no-undo .
     1543   define variable v-base-code like ub.sysconf.base-code no-undo .
     1544   define buffer buf_rep_currency for ub.currency.
     1545   def new shared buffer t-doc for ub.trn-doc.
     1546   define variable str3-1 as character no-undo .
     1547   define variable str3-2 as character no-undo .
     1548   define variable str3-3 as character no-undo .
     1549   DEFINE BUTTON b-help
     1550        LABEL "Помощь"
     1551        size 10 by 1
     1552        BGCOLOR 8 .
     1553   DEFINE BUTTON b-print DEFAULT
     1554        LABEL "Печать"
     1555        size 10 by 1.
     1556   DEFINE BUTTON b-quit AUTO-END-KEY
     1557        LABEL "Выход "
     1558        size 10 by 1
     1559        BGCOLOR 8 .
     1560   DEFINE VARIABLE tot-free-qnty AS DECIMAL FORMAT "->>>,>>>,>>9.<<<":U INITIAL ?
     1561        VIEW-AS FILL-IN
     1562        size 17 by 1 TOOLTIP "текущий"
     1563        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
     1564   DEFINE VARIABLE tot-free-sum0-base AS DECIMAL FORMAT "->>>,>>>,>>9.99" INITIAL ?
     1565        VIEW-AS FILL-IN
     1566        size 17 by 1 TOOLTIP "текущий"
     1567        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
     1568   DEFINE VARIABLE tot-free-sum0-rubl AS DECIMAL FORMAT "->>>,>>>,>>9.99" INITIAL ?
     1569        VIEW-AS FILL-IN
     1570        size 17 by 1 TOOLTIP "текущий"
     1571        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
     1572   DEFINE VARIABLE tot-in-qnty AS DECIMAL FORMAT "->>>,>>>,>>9.<<<":U INITIAL ?
     1573        LABEL "кол-во"
     1574        VIEW-AS FILL-IN
     1575        size 17 by 1 TOOLTIP "Количество прихода за период"
     1576        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
     1577   DEFINE VARIABLE tot-in-sum0-base AS DECIMAL FORMAT "->>>,>>>,>>9.99" INITIAL ?
     1578        LABEL "сумма (б.вал)"
     1579        VIEW-AS FILL-IN
     1580        size 17 by 1 TOOLTIP "за период"
     1581        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
     1582   DEFINE VARIABLE tot-in-sum0-rubl AS DECIMAL FORMAT "->>>,>>>,>>9.99" INITIAL ?
     1583        LABEL "сумма ()"
     1584        VIEW-AS FILL-IN
     1585        size 17 by 1 TOOLTIP "за период"
     1586        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
     1587   DEFINE VARIABLE tot-out-qnty AS DECIMAL FORMAT "->>>,>>>,>>9.<<<":U INITIAL ?
     1588        VIEW-AS FILL-IN
     1589        size 17 by 1 TOOLTIP "за период"
     1590        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
     1591   DEFINE VARIABLE tot-out-sum0-base AS DECIMAL FORMAT "->>>,>>>,>>9.99" INITIAL ?
     1592        VIEW-AS FILL-IN
     1593        size 17 by 1 TOOLTIP "за период"
     1594        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
     1595   DEFINE VARIABLE tot-out-sum0-rubl AS DECIMAL FORMAT "->>>,>>>,>>9.99" INITIAL ?
     1596        VIEW-AS FILL-IN
     1597        size 17 by 1 TOOLTIP "за период"
     1598        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
     1599   DEFINE RECTANGLE rect-in
     1600        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
     1601        size 96.5 by 4.83
     1602        BGCOLOR 8 .
     1603   DEFINE QUERY br-docs FOR
     1604         ub.parts,ub.parts-attr,
     1605         t-doc SCROLLING.
     1606   DEFINE BROWSE br-docs
     1607     QUERY br-docs DISPLAY
     1608         t-doc.doc-type COLUMN-LABEL "Т" format "x(1)"
     1609         t-doc.status_ COLUMN-LABEL "Стат" format "x(4)"
     1610         t-doc.flag_ COLUMN-LABEL "OK" FORMAT "+/-"
     1611         t-doc.doc-code format "x(12)"
     1612         (substring ((string (t-doc.doc-date)), 1, 5)) format "x(5)" column-label "Дата"
     1613         t-doc.fact-date COLUMN-LABEL "Факт"
     1614         t-doc.internal COLUMN-LABEL "В" FORMAT "+/-"
     1615         t-doc.cli-name format "x(27)"
     1616         ub.parts.fact-qnty COLUMN-LABEL "Количество" FORMAT "->>>,>>9.<<<"
     1617         ub.parts.price-base COLUMN-LABEL "Цена (б.вал)"
     1618         ub.parts.price-rubl
     1619         (if ub.parts.part-code = "" then "------" else ub.parts.part-code) COLUMN-LABEL "Партия" FORMAT "x(14)"
     1620         (trim (t-doc.obj-type) + string (t-doc.obj-code, ">>>>9")) COLUMN-LABEL "Объекты" FORMAT "x(8)"
     1621         t-doc.inv-num column-label "Инвойс "
     1622         t-doc.ord-num column-label "Заказ"
     1623         t-doc.ship-num column-label "Отгрузка"
     1624         t-doc.ship-date column-label "Дата"
     1625         t-doc.out-code column-label "На док-т" format "x(12)"
     1626         t-doc.acc-date column-label "Проводка"
     1627         func-get-name-from-ext-type ( t-doc.ext-doc-type , false )   COLUMN-LABEL "Тип" FORMAT "x(20)"
     1628       WITH NO-ROW-MARKERS SEPARATORS
     1629              size 96.5 by 17.33 .
     1630   DEFINE FRAME v-cust
     1631        tot-out-sum0-rubl at row 22 col 45 COLON-ALIGNED NO-LABEL
     1632        br-docs at row 2.33 col 2
     1633        tot-in-qnty at row 20.83 col 18.5 COLON-ALIGNED
     1634        tot-out-sum0-base at row 23.17 col 45 COLON-ALIGNED NO-LABEL
     1635        tot-free-qnty at row 20.83 col 72.5 COLON-ALIGNED NO-LABEL
     1636        tot-in-sum0-rubl at row 22 col 18.5 COLON-ALIGNED
     1637        tot-free-sum0-base at row 23.17 col 72.5 COLON-ALIGNED NO-LABEL
     1638        tot-free-sum0-rubl at row 22 col 72.5 COLON-ALIGNED NO-LABEL
     1639        tot-out-qnty at row 20.83 col 45 COLON-ALIGNED NO-LABEL
     1640        tot-in-sum0-base at row 23.17 col 18.5 COLON-ALIGNED
     1641        b-print at row 1.17 col 12
     1642        b-help at row 1.17 col 88.5
     1643        b-quit at row 1.17 col 2
     1644        "Остаток" VIEW-AS TEXT
     1645             size 10 by 0.63 at row 20 col 77.5
     1646        rect-in at row 19.67 col 2
     1647        "Расход" VIEW-AS TEXT
     1648             size 8.5 by 0.63 at row 20 col 51
     1649        "Приход" VIEW-AS TEXT
     1650             size 8.5 by 0.63 at row 20 col 25.5
     1651       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1652            SIDE-LABELS NO-UNDERLINE THREE-D
     1653            size 100.13 by 24.88
     1654            TITLE "Документы"
     1655            DEFAULT-BUTTON b-quit.
     1656   ASSIGN
     1657          FRAME v-cust:SCROLLABLE       = FALSE
     1658          FRAME v-cust:HIDDEN           = TRUE.
     1659   ON WINDOW-CLOSE OF FRAME v-cust
     1660   DO:
     1661     APPLY "END-ERROR":U TO SELF.
     1662   END.
     1663   ON CHOOSE OF b-print IN FRAME v-cust
     1664   DO:
     1665   define variable object as char no-undo.
     1666   define variable price0 LIKE ub.parts.price-rubl no-undo.
     1667   define variable stoim0 as decimal no-undo.
     1668   define variable DocDate as char no-undo.
     1669   define variable sym1 as char init ":"   no-undo.
     1670   define variable sym2 as char init ":"   no-undo.
     1671   define variable sym3 as char init ":"   no-undo.
     1672   define variable sym4 as char init ":"   no-undo.
     1673   define variable sym5 as char init ":"   no-undo.
     1674   define variable sym6 as char init ":"   no-undo.
     1675   define variable sym7 as char init ":"   no-undo.
     1676   define variable sym8 as char init ":"   no-undo.
     1677   define variable sym9 as char init ":"   no-undo.
     1678   define variable sym10 as char init ":"   no-undo.
     1679   define variable sym11 as char init ":"   no-undo.
     1680   define variable sym12 as char init ":"   no-undo.
     1681   define variable sym13 as char init ":"   no-undo.
     1682   define variable sym14 as char init ":"   no-undo.
     1683   define variable Line as char no-undo.
     1684   assign PrintRubl = yes .
     1685   if v-base-code <> 0 then
     1686       message
     1687       "Печатать в РУБЛЯХ ?"
     1688       VIEW-AS ALERT-BOX QUESTION BUTTONS yes-no TITLE "" UPDATE PrintRubl.
     1689   assign
     1690   sheetf.Excel-Column-Lable =  "Тип,Стат,OK,Номер документа,Дата,Дата закр.,В,Контрагент,Количество," +
     1691                                 "Учетная цена,Сумма учетных цен,Партия,Объект"
     1692   sheetf.sizes = "4,5,3,16,5,10,3,47,15,"  +
     1693                   "15,18,14,8"
     1694   sheetf.colformat = "6=dd/mm/yyyy"
     1695   Make-Excel = yes
     1696   reportname = "Д О К У М Е Н Т Ы "
     1697   str2 = "за период с: " + string(from-date,"99/99/9999") +  " по: " + string(to-date,"99/99/9999")
     1698   str3-1 =   string( "ПОСТАВЩИК: " + supplier.obj-name +
     1699                                                         " (" + supplier.obj-type + " " + string(supplier.obj-code) + ")" )
     1700   str3-2 =  string( "ТОВАР: " + suppl-parts.artic + ' "' + suppl-parts.gds-name + '"' )
     1701   str3-3 =  string( "ПАРТИЯ: " + suppl-parts.part-code +
     1702            "из " + caps(substring(suppl-parts.doc-type, 1, 1)) + "Н № " + suppl-parts.out-code )
     1703   str3 = str3-1 + chr(32) + str3-2 + chr(32) + str3-3
     1704   str4 = string( "Cуммы указаны в " + (if PrintRubl then "руб" else base-type) )
     1705   .
     1706   DEFINE FRAME supp-gds
     1707         sym1 column-label ":" format "X(1)"
     1708         t-doc.doc-type COLUMN-LABEL "Тип" FORMAT "x(3)"
     1709         sym2 column-label ":" format "X(1)"
     1710         t-doc.status_ COLUMN-LABEL "Стат" format "x(4)"
     1711         sym3 column-label ":" format "X(1)"
     1712         t-doc.flag_ COLUMN-LABEL "OK" FORMAT "+/-"
     1713         sym4 column-label ":" format "X(1)"
     1714         t-doc.doc-code COLUMN-LABEL "Номер документа" format "x(16)"
     1715         sym5 column-label ":" format "X(1)"
     1716         DocDate COLUMN-LABEL "Дата" format "x(5)"
     1717         sym6 column-label ":" format "X(1)"
     1718         t-doc.fact-date COLUMN-LABEL "Дата закр."  FORMAT "99/99/9999"
     1719         sym7 column-label ":" format "X(1)"
     1720         t-doc.internal COLUMN-LABEL "В" FORMAT "+/-"
     1721         sym8 column-label ":" format "X(1)"
     1722         t-doc.cli-name COLUMN-LABEL "Контрагент" format "x(47)"
     1723         sym9 column-label ":" format "X(1)"
     1724         ub.parts.fact-qnty COLUMN-LABEL "    Количество" FORMAT "->,>>>,>>9.<<<"
     1725         sym10 column-label ":" format "X(1)"
     1726         price0 COLUMN-LABEL "Учетная цена" FORMAT "->,>>>,>>9.99"
     1727         sym11 column-label ":" format "X(1)"
     1728         stoim0 COLUMN-LABEL "Сумма учетных цен" FORMAT "->>,>>>,>>>,>>9.99"
     1729         sym12 column-label ":" format "X(1)"
     1730         ub.parts.part-code COLUMN-LABEL "Партия" FORMAT "x(14)"
     1731         sym13 column-label ":" format "X(1)"
     1732         object COLUMN-LABEL "Объект" FORMAT "x(8)"
     1733         sym14 column-label ":" format "X(1)"
     1734       HEADER
     1735           cur-time-print() AT 5 format "X(35)"
     1736           string( "Отчет по поставщику: " + supplier.obj-name ) AT 45 format "X(71)"
     1737           str4 AT 145 format "X(20)"
     1738           string( "Страница " + string( PAGE-NUMBER( PrnLibStream ), ">>9" ) ) AT 170 format "X(13)" SKIP
     1739           Line format "X(195)" AT 1
     1740       with width 232 down stream-io.
     1741   if session:set-wait-state("COMPILER") then.
     1742   assign Line = fill("-", 232).
     1743   run prn-lib-open-stream  in this-procedure (
     1744                                                input parParentProc
     1745                                               ,input 43
     1746                                               ,input yes
     1747                                               ,input no
     1748                                               ).
     1749   run get-report-num in parparentproc (output g#report-num).
     1750   RUN OpenForExcel in this-procedure .
     1751       run rep/extitle.p (1).
     1752   FORM with FRAME supp-gds.
     1753   FORM HEADER
     1754       Line format "X(195)" AT 1 SKIP
     1755       "Продолжение - на следующей странице" AT 60 SKIP
     1756       with FRAME BottomFrame width 232
     1757       PAGE-BOTTOM no-labels no-box.
     1758   VIEW STREAM PrnLibStream FRAME BottomFrame .
     1759   PUT STREAM PrnLibStream string( reportname + chr(32) + str2)
     1760                                                  AT 69 format "X(195)"
     1761                                              SKIP(1)
     1762                                              str3-1
     1763                                                  AT 10 format "X(195)"
     1764                                              SKIP
     1765                                              str3-2
     1766                                                  AT 14 format "X(195)"
     1767                                              SKIP
     1768                                              str3-3
     1769                                                  AT 13 format "X(195)"
     1770                                              SKIP(1).
     1771       DO WHILE available ub.parts :
     1772           GET prev br-docs.
     1773       END.
     1774       GET next br-docs.
     1775       DO WHILE available ub.parts :
     1776           assign price0 = (if PrintRubl then suppl-parts.price0-rubl else suppl-parts.price0-base).
     1777           assign stoim0 = price0 * ub.parts.fact-qnty.
     1778           DISPLAY STREAM PrnLibStream
     1779               sym1 t-doc.doc-type
     1780               sym2 t-doc.status_
     1781               sym3 t-doc.flag_
     1782               sym4 t-doc.doc-code
     1783               sym5 (substring ((string (t-doc.doc-date)), 1, 5)) @ DocDate
     1784               sym6 t-doc.fact-date
     1785               sym7 t-doc.internal
     1786               sym8 t-doc.cli-name
     1787               sym9 ub.parts.fact-qnty
     1788               sym10 price0
     1789               sym11 stoim0
     1790               sym12 (if ub.parts.part-code = "" then "------" else ub.parts.part-code) @ ub.parts.part-code
     1791               sym13 (trim (t-doc.obj-type) + string (t-doc.obj-code, ">>>>9")) @ object
     1792               sym14
     1793               with FRAME supp-gds .
     1794           DOWN STREAM PrnLibStream 1 with FRAME supp-gds .
     1795           if Make-Excel then  put   stream ForExcel unformatted
     1796           t-doc.doc-type                                                  CHR(9)
     1797           t-doc.status_                                                   CHR(9)
     1798           (if t-doc.flag_ then "+":U else "-":U)                          CHR(9)
     1799           t-doc.doc-code                                                  CHR(9)
     1800           (substring ((string (t-doc.doc-date)), 1, 5))                   CHR(9)
     1801           t-doc.fact-date                                                 CHR(9)
     1802           (if t-doc.internal then "+":U else "-":U)                       CHR(9)
     1803           t-doc.cli-name                                                  CHR(9)
     1804           ub.parts.fact-qnty                                                 CHR(9)
     1805           price0                                                          CHR(9)
     1806           stoim0                                                          CHR(9)
     1807           (if ub.parts.part-code = "" then "------" else ub.parts.part-code)    CHR(9)
     1808           (trim (t-doc.obj-type) + string (t-doc.obj-code, ">>>>9"))
     1809           skip.
     1810           GET next br-docs.
     1811       END.
     1812   PUT STREAM PrnLibStream Line format "X(195)" SKIP.
     1813   DISPLAY STREAM PrnLibStream
     1814       "Остаток" @ t-doc.cli-name
     1815       tot-free-qnty @ ub.parts.fact-qnty
     1816       (if PrintRubl then tot-free-sum0-rubl else tot-free-sum0-base) @ stoim0
     1817       with FRAME supp-gds .
     1818   DOWN STREAM PrnLibStream 1 with FRAME supp-gds .
     1819   if Make-Excel then  put   stream ForExcel unformatted
     1820                                                                   CHR(9)
     1821                                                                   CHR(9)
     1822                                                                   CHR(9)
     1823                                                                   CHR(9)
     1824                                                                   CHR(9)
     1825                                                                   CHR(9)
     1826                                                                   CHR(9)
     1827   "Остаток"                                                       CHR(9)
     1828   tot-free-qnty                                                   CHR(9)
     1829                                                                   CHR(9)
     1830   (if PrintRubl then tot-free-sum0-rubl else tot-free-sum0-base)  CHR(9)
     1831                                                                   CHR(9)
     1832   skip.
     1833   HIDE STREAM PrnLibStream FRAME BottomFrame .
     1834   OUTPUT STREAM PrnLibStream CLOSE.
     1835   if Make-Excel then output stream ForExcel close.
     1836   if session:set-wait-state("") then.
     1837   run prn-lib-prn-file in this-procedure (
     1838                                             input parParentProc
     1839                                             ,input 8
     1840                                             ).
     1841   APPLY "ENTRY" TO BROWSE br-docs.
     1842   END.
     1843   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME v-cust:PARENT eq ?
     1844   THEN FRAME v-cust:PARENT = ACTIVE-WINDOW.
     1845   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1846   on help of frame v-cust
     1847   do:
     1848     run gbl/app_help.p
     1849       (input this-procedure :file-name
     1850       ,input ''
     1851       ,input ?
     1852       ) no-error.
     1853     if error-status :error then do:
     1854       message
     1855         "Ошибка при вызове помощи"
     1856         error-status :get-message(1)
     1857         view-as alert-box .
     1858     end.
     1859   end.
     1860   run minbtn-set in this-procedure .
     1861   on choose of b-help in frame v-cust
     1862   do:
     1863     apply "help":u to frame v-cust .
     1864   end.
     1865   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1866   procedure minbtn-set :
     1867       do
     1868           on error undo, return error return-value
     1869           :
     1870           define variable ii              as integer       no-undo .
     1871           define variable fh              as widget-handle no-undo .
     1872           define variable hh              as widget-handle no-undo .
     1873           define variable v-h             as handle        extent 4 no-undo .
     1874           define variable v-name-button   as character     no-undo .
     1875           define variable v-help-old-x    as decimal       no-undo .
     1876           define variable v-help-old-y    as decimal       no-undo .
     1877           define variable v-help-old-size as decimal       no-undo .
     1878           define variable v-frame-width   as decimal       no-undo .
     1879           define variable jj              as integer       no-undo .
     1880           do
     1881               on error undo, return error
     1882               :
     1883               assign
     1884                   v-frame-width = frame v-cust:width - 0.3
     1885                   fh            = frame v-cust:first-child
     1886                   hh            = fh:first-child
     1887                   ii            = 1
     1888                   .
     1889               do while valid-handle(hh):
     1890                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1891                   do:
     1892                       case lc(hh:name) :
     1893                           when "b-help" then
     1894                               do:
     1895                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1896                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1897                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1898                                   hh:TOOLTIP = "Помощь" .
     1899                                   v-help-old-x = hh:column .
     1900                                   v-help-old-y = hh:row    .
     1901                                   v-help-old-size = hh:width .
     1902                                   hh:width-chars = 2.5 .
     1903                               end.
     1904                           when "b-print" then
     1905                               do:
     1906                                   hh:load-image("cmp/b-print.bmp":u) .
     1907                                   hh:TOOLTIP = "Печать" .
     1908                                   v-h[ii] = hh:handle .
     1909                                   ii = ii + 1 .
     1910                                   hh:width-chars = 3 .
     1911                               end.
     1912                           when "b-history" or
     1913                           when "b-hist" then
     1914                               do:
     1915                                   hh:load-image("cmp/b-hist.bmp":u) .
     1916                                   hh:TOOLTIP = "История" .
     1917                                   v-h[ii] = hh:handle .
     1918                                   ii = ii + 1 .
     1919                                   hh:width-chars = 3 .
     1920                               end.
     1921                           when "b-sch" then
     1922                               do:
     1923                                   hh:load-image("cmp/b-sch.bmp":u) .
     1924                                   hh:TOOLTIP = "Установка Фильтра" .
     1925                                   v-h[ii] = hh:handle .
     1926                                   ii = ii + 1 .
     1927                                   hh:width-chars = 3 .
     1928                               end.
     1929                           when "b-hist-user" then
     1930                               do:
     1931                                   hh:load-image("cmp/b-hist.bmp":u) .
     1932                                   hh:TOOLTIP = "История пользователя" .
     1933                                   ii = ii + 1 .
     1934                               end.
     1935                       end case.
     1936                   end.
     1937                   hh = hh:next-sibling.
     1938               end.
     1939               b-help:column = v-frame-width - b-help:width-chars.
     1940               jj = 0.
     1941               repeat ii = 4 to 1 by -1 :
     1942                   if valid-handle (v-h[ii] ) then
     1943                   do:
     1944                       jj  = jj + 1 .
     1945                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1946                       v-h[ii]:row    = v-help-old-y .
     1947                   end.
     1948               end.
     1949           end.
     1950       end.
     1951   end procedure.
     1952   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1953   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1954   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1955   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1956   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1957   define variable v-diasize-current-frame-height as decimal   no-undo .
     1958   define variable v-diasize-change-size          as logical   no-undo .
     1959   define variable v-diasize-resize-button        as handle    no-undo .
     1960   define variable v-diasize-wndmax               as logical   no-undo .
     1961   define variable v-diasize-wndstore             as logical   no-undo .
     1962   define variable v-diasize-proc-name            as character no-undo .
     1963   define variable v-diasize-browse-handle        as handle    no-undo .
     1964   define variable v-diasize-browse-number        as integer   no-undo .
     1965   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1966   define temp-table temp-diasize-handle no-undo
     1967     field handle-value  as handle
     1968     field save-position as decimal
     1969     index xpk is primary unique handle-value
     1970     .
     1971   define temp-table temp-browse-handle no-undo
     1972     field browse-type   as character
     1973     field browse-number as integer
     1974     field browse-handle as handle
     1975     field original-size as decimal
     1976     index xpk is primary unique browse-type browse-number
     1977     index xie browse-type browse-handle
     1978   .
     1979   procedure diasize_change-height :
     1980     define input  parameter p-change-value  as decimal   no-undo .
     1981     define input  parameter p-move-resize   as logical   no-undo .
     1982     define variable v-field-group-handle    as handle    no-undo .
     1983     define variable v-object-handle         as handle    no-undo .
     1984     define variable v-frame-height          as decimal   no-undo .
     1985     define variable v-frame-virtual-height  as decimal   no-undo .
     1986     define variable v-browse-height         as decimal   no-undo .
     1987     define variable v-window-height         as decimal   no-undo .
     1988     define variable v-window-virtual-height as decimal   no-undo .
     1989     define variable v-change-sign           as integer   no-undo .
     1990     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1991     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1992     if p-change-value > 0
     1993     then do:
     1994       if frame v-cust :height + p-change-value
     1995           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1996       then do:
     1997         assign
     1998           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1999                           - (frame v-cust :height-chars)
     2000         .
     2001         if p-change-value <= 0
     2002         then do:
     2003           run diasize_position-resize-button in this-procedure .
     2004           return .
     2005         end.
     2006       end.
     2007     end.
     2008     if p-change-value < 0
     2009     then do:
     2010       if frame v-cust :height + p-change-value < v-diasize-orig-frame-height
     2011       then do:
     2012         assign
     2013           p-change-value = v-diasize-orig-frame-height
     2014                          - (frame v-cust :height-chars)
     2015         .
     2016         if p-change-value >= 0
     2017         then do:
     2018           run diasize_position-resize-button in this-procedure .
     2019           return .
     2020         end.
     2021       end.
     2022     end.
     2023     if p-change-value >= 0
     2024     then do:
     2025       assign
     2026         v-change-sign = 1
     2027       .
     2028     end.
     2029     else do:
     2030       assign
     2031         v-change-sign = -1
     2032       .
     2033     end.
     2034     assign
     2035       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2036     .
     2037     if p-change-value = 0
     2038     then do:
     2039       run diasize_position-resize-button in this-procedure .
     2040       return .
     2041     end.
     2042     move_block:
     2043     do
     2044     on error undo move_block, retry move_block
     2045     :
     2046       if retry
     2047       then do:
     2048         do
     2049         on error undo move_block, leave move_block
     2050         :
     2051           if p-change-value > 0
     2052           then do:
     2053             for each buf_temp-diasize-handle
     2054             on error undo, next
     2055             :
     2056               assign
     2057                 v-object-handle = buf_temp-diasize-handle.handle-value
     2058               .
     2059               if v-object-handle <> v-diasize-resize-button
     2060               then do:
     2061                 assign
     2062                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2063                 .
     2064               end.
     2065             end.
     2066             assign
     2067               v-diasize-browse-handle :height = v-browse-height
     2068             .
     2069             for each buf_temp-browse-handle
     2070               where buf_temp-browse-handle.browse-type = 'height':u
     2071             on error undo, next
     2072             :
     2073               assign
     2074                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2075               .
     2076             end.
     2077             assign
     2078               frame v-cust :height = v-frame-height
     2079             .
     2080             if frame v-cust :scrollable = true
     2081             then do:
     2082               assign
     2083                 frame v-cust :virtual-height = v-frame-virtual-height
     2084               .
     2085             end.
     2086             run diasize_position-resize-button in this-procedure .
     2087           end.
     2088           else do:
     2089             if frame v-cust :scrollable = true
     2090             then do:
     2091               assign
     2092                 frame v-cust :virtual-height = v-frame-virtual-height
     2093               .
     2094             end.
     2095             assign
     2096               frame v-cust :height = v-frame-height
     2097             .
     2098             assign
     2099               v-diasize-browse-handle :height = v-browse-height
     2100             .
     2101             for each buf_temp-browse-handle
     2102               where buf_temp-browse-handle.browse-type = 'height':u
     2103             on error undo, next
     2104             :
     2105               assign
     2106                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2107               .
     2108             end.
     2109             for each buf_temp-diasize-handle
     2110             on error undo, next
     2111             :
     2112               assign
     2113                 v-object-handle = buf_temp-diasize-handle.handle-value
     2114               .
     2115               if v-object-handle <> v-diasize-resize-button
     2116               then do:
     2117                 assign
     2118                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2119                 .
     2120               end.
     2121             end.
     2122             run diasize_position-resize-button in this-procedure .
     2123           end.
     2124           assign
     2125             v-diasize-change-size = false
     2126           .
     2127           leave move_block .
     2128         end.
     2129       end.
     2130       assign
     2131         v-diasize-need-full-display = true
     2132       .
     2133       if v-diasize-change-size = false
     2134       then do:
     2135         assign
     2136           v-diasize-change-size = true
     2137         .
     2138       end.
     2139       else do:
     2140         return .
     2141       end.
     2142       assign
     2143         v-frame-height = frame v-cust :height
     2144         v-frame-virtual-height = frame v-cust :virtual-height
     2145         v-browse-height = v-diasize-browse-handle :height
     2146       .
     2147       for each buf_temp-browse-handle
     2148         where buf_temp-browse-handle.browse-type = 'height':u
     2149       :
     2150         assign
     2151           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2152         .
     2153       end.
     2154       for each buf_temp-diasize-handle
     2155       :
     2156         delete buf_temp-diasize-handle .
     2157       end.
     2158       assign
     2159         v-field-group-handle = frame v-cust :first-child
     2160       .
     2161       do while valid-handle(v-field-group-handle)
     2162       :
     2163         assign
     2164           v-object-handle = v-field-group-handle :first-child
     2165         .
     2166         do while valid-handle(v-object-handle)
     2167         :
     2168           if  v-object-handle <> v-diasize-browse-handle :handle
     2169           and can-query(v-object-handle, "row")
     2170           and can-query(v-object-handle, "height")
     2171           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2172           then do:
     2173             find first buf_temp-browse-handle
     2174               where buf_temp-browse-handle.browse-type   = 'height':u
     2175                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2176               no-error .
     2177             if available buf_temp-browse-handle
     2178             then do:
     2179             end.
     2180             else do:
     2181               create buf_temp-diasize-handle .
     2182               assign
     2183                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2184                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2185               .
     2186             end.
     2187           end.
     2188           assign
     2189             v-object-handle = v-object-handle :next-sibling
     2190           .
     2191         end.
     2192         assign
     2193           v-field-group-handle = v-field-group-handle :next-sibling
     2194         .
     2195       end.
     2196       do with frame v-cust
     2197       :
     2198         hide v-diasize-resize-button .
     2199         assign
     2200           v-diasize-resize-button :row    = 1
     2201           v-diasize-resize-button :column = 1
     2202         .
     2203       end.
     2204       if p-change-value > 0
     2205       then do:
     2206         if frame v-cust :scrollable = true
     2207         then do:
     2208           assign
     2209             frame v-cust :virtual-height = frame v-cust :virtual-height + p-change-value
     2210             no-error .
     2211           if error-status :error
     2212           or error-status :get-message(1) <> ""
     2213           then do:
     2214             undo move_block, retry move_block .
     2215           end.
     2216         end.
     2217         assign
     2218           frame v-cust :height = frame v-cust :height + p-change-value
     2219           no-error .
     2220         if error-status :error
     2221         or error-status :get-message(1) <> ""
     2222         then do:
     2223           undo move_block, retry move_block .
     2224         end.
     2225         assign
     2226           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2227           no-error .
     2228         if error-status :error
     2229         or error-status :get-message(1) <> ""
     2230         then do:
     2231           undo move_block, retry move_block .
     2232         end.
     2233         for each buf_temp-browse-handle
     2234           where buf_temp-browse-handle.browse-type = 'height':u
     2235         on error undo move_block, retry move_block
     2236         :
     2237           assign
     2238             buf_temp-browse-handle.browse-handle :height
     2239               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2240             no-error .
     2241           if error-status :error
     2242           or error-status :get-message(1) <> ""
     2243           then do:
     2244             undo move_block, retry move_block .
     2245           end.
     2246         end.
     2247         for each buf_temp-diasize-handle
     2248         on error undo move_block, retry move_block
     2249         :
     2250           assign
     2251             v-object-handle = buf_temp-diasize-handle.handle-value
     2252           .
     2253           if v-object-handle <> v-diasize-resize-button
     2254           then do:
     2255             assign
     2256               v-object-handle :row = v-object-handle :row + p-change-value
     2257               no-error .
     2258             if error-status :error
     2259             or error-status :get-message(1) <> ""
     2260             then do:
     2261               undo move_block, retry move_block .
     2262             end.
     2263           end.
     2264         end.
     2265       end.
     2266       else do:
     2267         for each buf_temp-diasize-handle
     2268         on error undo move_block, retry move_block
     2269         :
     2270           assign
     2271             v-object-handle = buf_temp-diasize-handle.handle-value
     2272           .
     2273           if v-object-handle <> v-diasize-resize-button
     2274           then do:
     2275             assign
     2276               v-object-handle :row = v-object-handle :row + p-change-value
     2277               no-error .
     2278             if error-status :error
     2279             or error-status :get-message(1) <> ""
     2280             then do:
     2281               undo move_block, retry move_block .
     2282             end.
     2283           end.
     2284         end.
     2285         assign
     2286           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2287           no-error .
     2288         if error-status :error
     2289         or error-status :get-message(1) <> ""
     2290         then do:
     2291           undo move_block, retry move_block .
     2292         end.
     2293         for each buf_temp-browse-handle
     2294           where buf_temp-browse-handle.browse-type = 'height':u
     2295         on error undo move_block, retry move_block
     2296         :
     2297           assign
     2298             buf_temp-browse-handle.browse-handle :height
     2299               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2300             no-error .
     2301           if error-status :error
     2302           or error-status :get-message(1) <> ""
     2303           then do:
     2304             undo move_block, retry move_block .
     2305           end.
     2306         end.
     2307         assign
     2308           frame v-cust :height = frame v-cust :height + p-change-value
     2309           no-error .
     2310         if error-status :error
     2311         or error-status :get-message(1) <> ""
     2312         then do:
     2313           undo move_block, retry move_block .
     2314         end.
     2315         if frame v-cust :scrollable = true
     2316         then do:
     2317           assign
     2318             frame v-cust :virtual-height = frame v-cust :virtual-height + p-change-value
     2319             no-error .
     2320           if error-status :error
     2321           or error-status :get-message(1) <> ""
     2322           then do:
     2323             undo move_block, retry move_block .
     2324           end.
     2325         end.
     2326       end.
     2327       if p-move-resize = true
     2328       then do:
     2329         run diasize_position-resize-button in this-procedure .
     2330       end.
     2331       if v-diasize-wndstore = true
     2332       then do:
     2333         if connected("ub") = true
     2334         then do:
     2335           define variable v-cntxt-db-num        as integer   no-undo .
     2336           define variable v-cntxt-userid        as character no-undo .
     2337           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2338                                             , OUTPUT v-cntxt-userid
     2339                                             ) .
     2340           run gbl/wndsizew.p
     2341             (input  v-cntxt-db-num
     2342             ,input  v-cntxt-userid
     2343             ,input  v-diasize-proc-name
     2344             ,input  'height':u
     2345             ,input  string(frame v-cust :height - v-diasize-orig-frame-height)
     2346             ) .
     2347         end.
     2348       end.
     2349     end.
     2350     assign
     2351       v-diasize-change-size = false
     2352     .
     2353   end procedure.
     2354   procedure diasize_set-height :
     2355     define input  parameter p-new-height  as decimal   no-undo .
     2356     define input  parameter p-move-resize as logical   no-undo .
     2357     do
     2358     on error undo, return error return-value
     2359     :
     2360       run diasize_change-height in this-procedure
     2361         (input  (p-new-height - frame v-cust :height)
     2362         ,input  p-move-resize
     2363         ) .
     2364     end.
     2365   end procedure.
     2366   procedure diasize_change-width :
     2367     define input  parameter p-change-value as decimal   no-undo .
     2368     define input  parameter p-move-resize  as logical   no-undo .
     2369     define variable v-field-group-handle   as handle    no-undo .
     2370     define variable v-object-handle        as handle    no-undo .
     2371     define variable v-frame-width          as decimal   no-undo .
     2372     define variable v-frame-virtual-width  as decimal   no-undo .
     2373     define variable v-browse-width         as decimal   no-undo .
     2374     define variable v-window-width         as decimal   no-undo .
     2375     define variable v-window-virtual-width as decimal   no-undo .
     2376     define variable v-change-sign          as integer   no-undo .
     2377     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2378     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2379     if p-change-value > 0
     2380     then do:
     2381       if frame v-cust :width + p-change-value >
     2382           session :width-chars
     2383       then do:
     2384         assign
     2385           p-change-value = session :width-chars - frame v-cust :width
     2386         .
     2387         if p-change-value <= 0
     2388         then do:
     2389           run diasize_position-resize-button in this-procedure .
     2390           return .
     2391         end.
     2392       end.
     2393     end.
     2394     if p-change-value < 0
     2395     then do:
     2396       if frame v-cust :width + p-change-value < v-diasize-orig-frame-width
     2397       then do:
     2398         assign
     2399           p-change-value = v-diasize-orig-frame-width
     2400                          - frame v-cust :width
     2401         .
     2402         if p-change-value >= 0
     2403         then do:
     2404           run diasize_position-resize-button in this-procedure .
     2405           return .
     2406         end.
     2407       end.
     2408     end.
     2409     if p-change-value >= 0
     2410     then do:
     2411       assign
     2412         v-change-sign = 1
     2413       .
     2414     end.
     2415     else do:
     2416       assign
     2417         v-change-sign = -1
     2418       .
     2419     end.
     2420     assign
     2421       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2422     .
     2423     if p-change-value = 0
     2424     then do:
     2425       run diasize_position-resize-button in this-procedure .
     2426       return .
     2427     end.
     2428     move_block:
     2429     do
     2430     on error undo move_block, leave move_block
     2431     :
     2432       if retry
     2433       then do:
     2434         do
     2435         on error undo move_block, leave move_block
     2436         :
     2437           if p-change-value > 0
     2438           then do:
     2439             for each buf_temp-diasize-handle
     2440             on error undo, next
     2441             :
     2442               assign
     2443                 v-object-handle = buf_temp-diasize-handle.handle-value
     2444               .
     2445               if v-object-handle <> v-diasize-resize-button
     2446               then do:
     2447                 assign
     2448                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2449                 .
     2450               end.
     2451             end.
     2452             assign
     2453               v-diasize-browse-handle :width = v-browse-width
     2454             .
