     2487             :
     2488               assign
     2489                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2490               .
     2491             end.
     2492             assign
     2493               v-diasize-browse-handle :width = v-browse-width
     2494             .
     2495             for each buf_temp-diasize-handle
     2496             on error undo, next
     2497             :
     2498               assign
     2499                 v-object-handle = buf_temp-diasize-handle.handle-value
     2500               .
     2501               if v-object-handle <> v-diasize-resize-button
     2502               then do:
