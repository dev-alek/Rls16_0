      419   procedure create_obj-list :
      420      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      421      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      422      do
      423      on error undo, return error return-value
      424      :
      425         define buffer cli-obj for ub.clients .
      426         define variable p-var as integer no-undo .
      427         define buffer buf_obj-list for obj-list .
      428         find last buf_obj-list  use-index pi no-error .
      429         if available buf_obj-list
      430         then
      431            p-var = buf_obj-list.obj-id + 1.
      432         else
      433            p-var = 1.
      434         find first cli-obj where
      435                   cli-obj.obj-type = p-obj-type
      436               and cli-obj.obj-code = p-obj-code
      437         no-lock no-error.
      438         if available cli-obj
      439         then do:
      440            create buf_obj-list.
      441            assign
      442               buf_obj-list.obj-id   = p-var
      443               buf_obj-list.obj-code = cli-obj.obj-code
      444               buf_obj-list.obj-type = cli-obj.obj-type
      445               buf_obj-list.obj-name = cli-obj.obj-name
      446               buf_obj-list.db-num   = cli-obj.db-num
      447            .
      448         end.
      449      end.
      450   end.
