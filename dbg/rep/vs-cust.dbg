      854   define variable var-report-r-b as character no-undo .
      855   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      856   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      857     (output var-report-r-b
      858     )  .
      859   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      860   define  stream PrnLibStream.
      861   procedure prn-lib-prn-file :
      862     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      863     define input parameter p-DIsabledoptions as integer no-undo .
      864     define variable v-report-name as character no-undo .
      865     define variable v-user-action as character no-undo .
      866     define variable v-printed     as logical   no-undo .
      867     define variable v-exist       as logical   no-undo .
      868     do
      869       on error undo, return error
      870       :
      871       run prn-lib-get-report-name  in this-procedure (
      872         input parParentProc
      873         ,output v-report-name
      874         ).
      875   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      876   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      877     (input  v-report-name
      878     ,input  2
      879     ,output v-exist
      880     )  .
      881       if NOT v-exist then
      882       DO:
      883         Message
      884           "Нет заданий на печать ! "
      885           view-as alert-box .
      886         Return  .
      887       End.
      888       run gbl/prnfilen.w
      889         (input  ""
      890         ,input  p-DisabledOptions
      891         ,input  string(v-report-name )
      892         ,input  7
      893         ,output v-user-action
      894         ,output v-printed
      895         ) .
      896       if v-printed then
      897       do:
      898         return "YES" .
      899       end.
      900       else
      901       do:
      902         return "NO" .
      903       end.
      904     end.
      905   end procedure.
      906   procedure prn-lib-open-stream :
      907     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      908     define input parameter p-page-size    as integer no-undo .
      909     define input parameter p-is-stream    as logical no-undo .
      910     define input parameter p-append       as logical no-undo .
      911     define variable v-report-name as character no-undo .
      912     do
      913       on error undo, return error
      914       :
      915       run prn-lib-get-report-name  in this-procedure (
      916         input parParentProc
      917         ,output v-report-name
      918         ).
      919       if p-is-stream then
      920       do:
      921         if p-append then
      922         do:
      923           output stream PrnLibStream to value( v-report-name )
      924             page-size value(p-page-size) append .
      925         end.
      926         if not p-append then
      927         do:
      928           output stream PrnLibStream to value( v-report-name )
      929             page-size value(p-page-size) .
      930         end.
      931       end.
      932       if not p-is-stream then
      933       do:
      934         if p-append then
      935         do:
      936           output to value( v-report-name )
      937             page-size value(p-page-size) append .
      938         end.
      939         if not p-append then
      940         do:
      941           output to value( v-report-name )
      942             page-size value(p-page-size) .
      943         end.
      944       end.
      945     end.
      946   end procedure.
      947   procedure prn-lib-open-exp :
      948     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      949     define input parameter p-is-stream    as logical no-undo .
      950     define input parameter p-is-append    as logical no-undo .
      951     define output parameter p-ReportFileName as char init "report" no-undo.
      952     define output parameter p-process as logical no-undo .
      953     define variable glog as logical no-undo .
      954     do
      955       on error undo, return error
      956       :
      957       SYSTEM-DIALOG GET-FILE p-ReportFileName
      958         TITLE      "Укажите путь"
      959         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      960         ASK-OVERWRITE
      961         CREATE-TEST-FILE
      962         SAVE-AS
      963         USE-FILENAME
      964         DEFAULT-EXTENSION "txt"
      965         UPDATE glog
      966         .
      967       if not glog then  return.
      968       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      969       if p-is-stream then
      970       do:
      971         if p-is-append then
      972         do:
      973           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      974         end.
      975         else
      976         do:
      977           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      978         end.
      979       end.
      980       else
      981       do:
      982         if p-is-append then
      983         do:
      984           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      985         end.
      986         else
      987         do:
      988           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      989         end.
      990       end.
      991       p-process = yes.
      992     end.
      993   end procedure.
      994   procedure prn-lib-get-report-name :
      995     define input parameter parParentProc  as widget-handle no-undo.
      996     define output parameter p-report-name as character no-undo .
      997     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      998   end procedure.
      999   procedure prn-lib-reportviewer-report-name :
     1000     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1001     define input parameter p-report-name-html as character no-undo .
     1002     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1003   end procedure.
     1004   procedure prn-lib-reportviewer :
     1005     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1006     define input parameter p-report-name-html as character no-undo .
     1007     define input parameter p-param        as character no-undo .
     1008     define variable v-excel           as character no-undo init 'TRUE' .
     1009     define variable v-value-character as character no-undo .
     1010     define variable v-value-integer   as character no-undo .
     1011     define variable v-value-date      as date      no-undo .
     1012     define variable v-value-decimal   as decimal   no-undo .
     1013     define variable rep-excel         as logical   no-undo .
     1014     define variable excel-string      as character no-undo .
     1015     define variable v-param-type      as character no-undo .
     1016     define variable v-tth             as handle    no-undo .
     1017     run adm/shattri.p (
     1018       input "get":U
     1019       ,input  ""
     1020       ,input  0
     1021       ,input  'report-glob':U
     1022       ,input  'rep-excel':U
     1023       ,output v-value-character
     1024       ,output v-value-date
     1025       ,output v-value-decimal
     1026       ,output v-value-integer
     1027       ,output rep-excel
     1028       ,output v-param-type
     1029       ,INPUT-OUTPUT table-handle v-tth
     1030       )  .
     1031     if rep-excel then v-excel = "TRUE" .
     1032     else v-excel = "FALSE" .
     1033     if p-param eq ""
     1034     then
     1035        p-param = "EXCEL:" + v-excel.
     1036     else
     1037        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1038     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1039   end procedure.
     1040   define  shared temp-table sup-gds no-undo
     1041       field artic          like ub.goods.artic
