     2509           end.
     2510           assign
     2511             v-diasize-change-size = false
     2512           .
     2513           leave move_block .
     2514         end.
     2515       end.
     2516       assign
     2517         v-diasize-need-full-display = true
     2518       .
     2519       if v-diasize-change-size = false
     2520       then do:
     2521         assign
     2522           v-diasize-change-size = true
     2523         .
     2524       end.
     2525       else do:
     2526         return .
     2527       end.
     2528       assign
     2529         v-frame-width = frame v-cust :width
     2530         v-frame-virtual-width = frame v-cust :virtual-width
     2531         v-browse-width = v-diasize-browse-handle :width
     2532       .
     2533       for each buf_temp-browse-handle
     2534         where buf_temp-browse-handle.browse-type = 'width':u
     2535       :
     2536         assign
     2537           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2538         .
     2539       end.
     2540       for each buf_temp-diasize-handle
     2541       :
     2542         delete buf_temp-diasize-handle .
     2543       end.
     2544       assign
     2545         v-field-group-handle = frame v-cust :first-child
     2546       .
     2547       do while valid-handle(v-field-group-handle)
     2548       :
     2549         assign
     2550           v-object-handle = v-field-group-handle :first-child
     2551         .
     2552         do while valid-handle(v-object-handle)
     2553         :
     2554           if  v-object-handle <> v-diasize-browse-handle :handle
     2555           and v-object-handle <> v-diasize-resize-button
     2556           and can-query(v-object-handle, "row")
     2557           and can-query(v-object-handle, "height")
     2558           and ( v-object-handle :col + v-object-handle :width
     2559                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2560               )
     2561           then do:
     2562             find first buf_temp-browse-handle
     2563               where buf_temp-browse-handle.browse-type   = 'width':u
     2564                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2565               no-error .
     2566             if available buf_temp-browse-handle
     2567             then do:
     2568             end.
     2569             else do:
     2570               create buf_temp-diasize-handle .
     2571               assign
     2572                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2573                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2574               .
     2575             end.
     2576           end.
     2577           assign
     2578             v-object-handle = v-object-handle :next-sibling
     2579           .
     2580         end.
     2581         assign
     2582           v-field-group-handle = v-field-group-handle :next-sibling
     2583         .
     2584       end.
     2585       do with frame v-cust
     2586       :
     2587         hide v-diasize-resize-button .
     2588         v-diasize-resize-button :row = 1.
     2589         v-diasize-resize-button :column = 1.
     2590       end.
     2591       if p-change-value > 0
     2592       then do:
     2593         if frame v-cust :scrollable = true
     2594         then do:
     2595           assign
     2596             frame v-cust :virtual-width = frame v-cust :virtual-width + p-change-value
     2597             no-error .
     2598           if error-status :error
     2599           or error-status :get-message(1) <> ""
     2600           then do:
     2601             undo move_block, retry move_block.
     2602           end.
     2603         end.
     2604         assign
     2605           frame v-cust :width = v-frame-width + p-change-value
     2606           no-error .
     2607         if error-status :error
     2608         or error-status :get-message(1) <> ""
     2609         then do:
     2610           undo move_block, retry move_block.
     2611         end.
     2612         assign
     2613           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2614         no-error .
     2615         if error-status :error
     2616         or error-status :get-message(1) <> ""
     2617         then do:
     2618           undo move_block, retry move_block.
     2619         end.
     2620         for each buf_temp-browse-handle
     2621           where buf_temp-browse-handle.browse-type = 'width':u
     2622         on error undo move_block, retry move_block
     2623         :
     2624           assign
     2625             buf_temp-browse-handle.browse-handle :width
     2626               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2627             no-error .
     2628           if error-status :error
     2629           or error-status :get-message(1) <> ""
     2630           then do:
     2631             undo move_block, retry move_block .
     2632           end.
     2633         end.
     2634         for each buf_temp-diasize-handle
     2635         on error undo move_block, retry move_block
     2636         :
     2637           assign
     2638             v-object-handle = buf_temp-diasize-handle.handle-value
     2639           .
     2640           if v-object-handle <> v-diasize-resize-button
     2641           then do:
     2642             assign
     2643               v-object-handle :col = v-object-handle :col + p-change-value
     2644               no-error .
     2645             if error-status :error
     2646             or error-status :get-message(1) <> ""
     2647             then do:
     2648               undo move_block, retry move_block .
     2649             end.
     2650           end.
     2651         end.
     2652       end.
     2653       else do:
     2654         for each buf_temp-diasize-handle
     2655         on error undo move_block, retry move_block
     2656         :
     2657           assign
     2658             v-object-handle = buf_temp-diasize-handle.handle-value
     2659           .
     2660           if v-object-handle <> v-diasize-resize-button
     2661           then do:
     2662             assign
     2663               v-object-handle :col = v-object-handle :col + p-change-value
     2664               no-error .
     2665             if error-status :error
     2666             or error-status :get-message(1) <> ""
     2667             then do:
     2668               undo move_block, retry move_block .
     2669             end.
     2670           end.
     2671         end.
     2672         for each buf_temp-browse-handle
     2673           where buf_temp-browse-handle.browse-type = 'width':u
     2674         on error undo move_block, retry move_block
     2675         :
     2676           assign
     2677             buf_temp-browse-handle.browse-handle :width
     2678               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2679             no-error .
     2680           if error-status :error
     2681           or error-status :get-message(1) <> ""
     2682           then do:
     2683             undo move_block, retry move_block .
     2684           end.
     2685         end.
     2686         assign
     2687           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2688           no-error .
     2689         if error-status :error
     2690         or error-status :get-message(1) <> ""
     2691         then do:
     2692           undo move_block, retry move_block.
     2693         end.
     2694         assign
     2695           frame v-cust :width = frame v-cust :width + p-change-value
     2696         no-error .
     2697         if error-status :error
     2698         or error-status :get-message(1) <> ""
     2699         then do:
     2700           undo move_block, retry move_block.
     2701         end.
     2702         if frame v-cust :scrollable = true
     2703         then do:
     2704           assign
     2705             frame v-cust :virtual-width = frame v-cust :virtual-width + p-change-value
     2706           no-error .
     2707           if error-status :error
     2708           or error-status :get-message(1) <> ""
     2709           then do:
     2710             undo move_block, retry move_block.
     2711           end.
     2712         end.
     2713       end.
     2714       if p-move-resize
     2715       then do:
     2716         run diasize_position-resize-button in this-procedure .
     2717       end.
     2718       if v-diasize-wndstore = true
     2719       then do:
     2720         if connected("ub") = true
     2721         then do:
     2722           define variable v-cntxt-db-num        as integer   no-undo .
     2723           define variable v-cntxt-userid        as character no-undo .
     2724           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2725                                             , OUTPUT v-cntxt-userid
     2726                                             ) .
     2727           run gbl/wndsizew.p
     2728             (input  v-cntxt-db-num
     2729             ,input  v-cntxt-userid
     2730             ,input  v-diasize-proc-name
     2731             ,input  'width':u
     2732             ,input  string(frame v-cust :width - v-diasize-orig-frame-width)
     2733             ) .
     2734         end.
     2735       end.
     2736     end.
     2737     assign
     2738       v-diasize-change-size = false
     2739     .
     2740   end procedure.
     2741   procedure diasize_set-width :
     2742     define input  parameter p-new-width  as decimal   no-undo .
     2743     define input  parameter p-move-resize as logical   no-undo .
     2744     do
     2745     on error undo, return error return-value
     2746     :
     2747       run diasize_change-width in this-procedure
     2748         (input  (p-new-width - frame v-cust :width)
     2749         ,input  p-move-resize
     2750         ) .
     2751     end.
     2752   end procedure.
     2753   procedure diasize_position-resize-button :
     2754     do with frame v-cust
     2755     :
     2756       hide v-diasize-resize-button .
     2757       assign
     2758         v-diasize-resize-button :row = frame v-cust :height - v-diasize-resize-button :height
     2759                     - 1
     2760                     - (frame v-cust :border-bottom-pixels / session :pixels-per-row)
     2761         v-diasize-resize-button :col = frame v-cust :width - v-diasize-resize-button :width
     2762                     - 1
     2763                     - (frame v-cust :border-right-pixels / session :pixels-per-column)
     2764       .
     2765       view v-diasize-resize-button .
     2766     end.
     2767   end procedure.
     2768   on alt-right anywhere
     2769   do:
     2770     run diasize_change-width in this-procedure
     2771       (input 1
     2772       ,input true
     2773       ) .
     2774     return no-apply .
     2775   end.
     2776   on alt-left anywhere
     2777   do:
     2778     run diasize_change-width in this-procedure
     2779       (input -1
     2780       ,input true
     2781       ) .
     2782     return no-apply .
     2783   end.
     2784   on alt-down anywhere
     2785   do:
     2786     run diasize_change-height in this-procedure
     2787       (input 1
     2788       ,input true
     2789       ) .
     2790     return no-apply .
     2791   end.
     2792   on alt-up anywhere
     2793   do:
     2794     run diasize_change-height in this-procedure
     2795       (input -1
     2796       ,input true
     2797       ) .
     2798     return no-apply .
     2799   end.
     2800   on alt-enter of frame v-cust
     2801   do:
     2802     run diasize_maximize in this-procedure
     2803       (input  ?
     2804       ).
     2805     return no-apply .
     2806   end.
     2807   procedure diasize_end-move :
     2808     do
     2809     on error undo, return error return-value
     2810     :
     2811       define variable v-row-delta as decimal   no-undo .
     2812       define variable v-col-delta as decimal   no-undo .
     2813       define variable v-new-row as decimal   no-undo .
     2814       define variable v-new-col as decimal   no-undo .
     2815       assign
     2816         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2817         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2818       .
     2819       assign
     2820         v-row-delta = v-new-row - frame v-cust :height
     2821         v-col-delta = v-new-col - frame v-cust :width
     2822       .
     2823       run diasize_change-height in this-procedure
     2824         (input v-row-delta
     2825         ,input true
     2826         ) .
     2827       run diasize_change-width in this-procedure
     2828         (input v-col-delta
     2829         ,input true
     2830         ) .
     2831     end.
     2832   end procedure.
     2833   procedure diasize_maximize :
     2834     define input  parameter p-action as logical   no-undo .
     2835     do
     2836     on error undo, return error return-value
     2837     :
     2838       if p-action = ?
     2839       then do:
     2840         if v-diasize-need-maximize = true
     2841         then do:
     2842           assign
     2843             p-action = true
     2844           .
     2845         end.
     2846         else do:
     2847           assign
     2848             p-action = false
     2849           .
     2850         end.
     2851       end.
     2852       if p-action = true
     2853       then do:
     2854         run diasize_change-height in this-procedure
     2855           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2856               - frame v-cust :height-chars
     2857           ,input true
     2858           ) .
     2859         run diasize_change-width in this-procedure
     2860           (input session :width-chars
     2861               - frame v-cust :width-chars
     2862           ,input true
     2863           ) .
     2864         assign
     2865           v-diasize-need-maximize = false
     2866         .
     2867       end.
     2868       else do:
     2869         run diasize_change-width in this-procedure
     2870           (input v-diasize-orig-frame-width
     2871               - frame v-cust :width-chars
     2872           ,input true
     2873           ) .
     2874         run diasize_change-height in this-procedure
     2875           (input v-diasize-orig-frame-height
     2876               - frame v-cust :height-chars
     2877           ,input true
     2878           ) .
     2879         assign
     2880           v-diasize-need-maximize = true
     2881         .
     2882       end.
     2883     end.
     2884   end procedure.
     2885   procedure diasize_restore-orig-size :
     2886     do
     2887     on error undo, return error return-value
     2888     :
     2889       assign
     2890         v-diasize-current-frame-width  = frame v-cust :width
     2891         v-diasize-current-frame-height = frame v-cust :height
     2892       .
     2893       run diasize_set-height in this-procedure
     2894         (input  v-diasize-orig-frame-height
     2895         ,input  true
     2896         ) .
     2897       run diasize_set-width in this-procedure
     2898         (input  v-diasize-orig-frame-width
     2899         ,input  true
     2900         ) .
     2901     end.
     2902   end procedure.
     2903   procedure diasize_restore-current-size :
     2904     do
     2905     on error undo, return error return-value
     2906     :
     2907       run diasize_set-height in this-procedure
     2908         (input  v-diasize-current-frame-height
     2909         ,input  true
     2910         ) .
     2911       run diasize_set-width in this-procedure
     2912         (input  v-diasize-current-frame-width
     2913         ,input  true
     2914         ) .
     2915     end.
     2916   end procedure.
     2917   procedure diasize_set-browse-handle :
     2918     define input  parameter p-browse-handle as handle   no-undo .
     2919     define buffer buf_temp-browse-handle for temp-browse-handle .
     2920     do
     2921     on error undo, return error return-value
     2922     :
     2923       assign
     2924         v-diasize-browse-handle = p-browse-handle
     2925       .
     2926       for each buf_temp-browse-handle
     2927       on error undo, return error return-value
     2928       :
     2929         delete buf_temp-browse-handle .
     2930       end.
     2931     end.
     2932   end procedure.
     2933   procedure diasize_add_browse :
     2934     define input  parameter p-browse-type   as character no-undo .
     2935     define input  parameter p-browse-handle as handle    no-undo .
     2936     define buffer buf_temp-browse-handle for temp-browse-handle .
     2937     do
     2938     on error undo, return error return-value
     2939     :
     2940       assign
     2941         v-diasize-browse-number = v-diasize-browse-number + 1
     2942       .
     2943       create buf_temp-browse-handle .
     2944       assign
     2945         buf_temp-browse-handle.browse-type   = p-browse-type
     2946         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2947         buf_temp-browse-handle.browse-handle = p-browse-handle
     2948       .
     2949     end.
     2950   end procedure.
     2951   procedure diasize_init :
     2952     define variable v-default-value    as logical   no-undo .
     2953     define variable v-restore-saved    as logical   no-undo .
     2954     define variable v-resize-value-str as character no-undo .
     2955     do
     2956     on error undo, return error return-value
     2957     :
     2958       do with frame v-cust
     2959       :
     2960         assign
     2961           v-diasize-orig-frame-height = frame v-cust :height
     2962           v-diasize-orig-frame-width  = frame v-cust :width
     2963           v-diasize-browse-handle     = browse br-docs :handle
     2964         .
     2965         create button v-diasize-resize-button
     2966         assign
     2967           parent        = frame v-cust :first-child
     2968           label         = "s"
     2969           height-pixels = 16
     2970           width-pixels  = 16
     2971           visible       = true
     2972           sensitive     = true
     2973           movable       = true
     2974           triggers:
     2975             on end-move persistent run diasize_end-move in this-procedure .
     2976           end triggers.
     2977         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2978         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2979         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2980         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2981         assign
     2982           v-diasize-wndmax = false
     2983         .
     2984         if connected("ub") = true
     2985         then do:
     2986           define variable v-cntxt-db-num        as integer   no-undo .
     2987           define variable v-cntxt-userid        as character no-undo .
     2988           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2989                                             , OUTPUT v-cntxt-userid
     2990                                             ) .
     2991           run gbl/wndpar_r.p
     2992             (input  v-cntxt-db-num
     2993             ,input  v-cntxt-userid
     2994             ,input  'wndmax':U
     2995             ,output v-diasize-wndmax
     2996             ,output v-default-value
     2997             ) .
     2998         end.
     2999         assign
     3000           v-diasize-wndstore = false
     3001         .
     3002         if connected("ub") = true
     3003         then do:
     3004           run gbl/wndpar_r.p
     3005             (input  v-cntxt-db-num
     3006             ,input  v-cntxt-userid
     3007             ,input  'wndstore':U
     3008             ,output v-diasize-wndstore
     3009             ,output v-default-value
     3010             ) .
     3011         end.
     3012         assign
     3013           v-diasize-proc-name = entry(1, program-name(2), '.')
     3014         .
     3015         if v-diasize-wndstore = true
     3016         then do:
     3017           assign
     3018             v-restore-saved = false
     3019           .
     3020           if connected("ub") = true
     3021           then do:
     3022             run gbl/wndsizer.p
     3023               (input  v-cntxt-db-num
     3024               ,input  v-cntxt-userid
     3025               ,input  v-diasize-proc-name
     3026               ,input  'height':u
     3027               ,output v-resize-value-str
     3028               ) .
     3029             if v-resize-value-str <> '':U
     3030             then do:
     3031               run diasize_change-height in this-procedure
     3032                 (input  integer(v-resize-value-str)
     3033                 ,input  true
     3034                 ) .
     3035               assign
     3036                 v-restore-saved = true
     3037               .
     3038             end.
     3039           end.
     3040           if connected("ub") = true
     3041           then do:
     3042             run gbl/wndsizer.p
     3043               (input  v-cntxt-db-num
     3044               ,input  v-cntxt-userid
     3045               ,input  v-diasize-proc-name
     3046               ,input  'width':u
     3047               ,output v-resize-value-str
     3048               ) .
     3049             if v-resize-value-str <> '':U
     3050             then do:
     3051               run diasize_change-width in this-procedure
     3052                 (input  integer(v-resize-value-str)
     3053                 ,input  true
     3054                 ) .
     3055               assign
     3056                 v-restore-saved = true
     3057               .
     3058             end.
     3059           end.
     3060           if v-restore-saved <> true
     3061           then do:
     3062             if v-diasize-wndmax = true
     3063             then do:
     3064               run diasize_maximize in this-procedure
     3065                 (input  true
     3066                 ) .
     3067             end.
     3068           end.
     3069         end.
     3070         else do:
     3071           if v-diasize-wndmax = true
     3072           then do:
     3073             run diasize_maximize in this-procedure
     3074               (input  true
     3075               ) .
     3076           end.
     3077         end.
     3078       end.
     3079     end.
     3080   end procedure.
     3081   procedure diasize_need-full-display :
     3082     define output parameter p-need-full-display as logical   no-undo .
     3083     do
     3084     on error undo, return error return-value
     3085     :
     3086       assign
     3087         p-need-full-display = v-diasize-need-full-display
     3088       .
     3089       assign
     3090         v-diasize-need-full-display = false
     3091       .
     3092     end.
     3093   end procedure.
     3094   procedure get-context :
     3095      define output parameter p-db-num as integer          no-undo.
     3096      define output parameter p-user-id as character        no-undo.
     3097      define variable v-login               as character    no-undo.
     3098      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3099      define buffer buf_user-login  for ub.user-login .
     3100      do
     3101      on error undo, return error
     3102      :
     3103            FIND FIRST buf_sys-ctrl no-lock.
     3104            ASSIGN
     3105               v-login = USERID("ub")
     3106               p-db-num = buf_sys-ctrl.db-num
     3107            .
     3108            FIND FIRST buf_user-login
     3109                 WHERE buf_user-login.db-num = p-db-num
     3110                   AND buf_user-login.user-login = v-login
     3111                 no-lock
     3112                 no-error
     3113                 .
     3114            IF AVAILABLE buf_user-login
     3115            THEN DO:
     3116               assign
     3117                  p-user-id = buf_user-login.user-id
     3118               .
     3119            END.
     3120      end.
     3121   end procedure.
     3122       run diasize_init in this-procedure .
     3123   MAIN-BLOCK:
     3124   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3125      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3126   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3127   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3128     (input  p-curr-obj-type
     3129     ,input  p-curr-obj-code
     3130     ,output v-host-code
     3131     )  .
     3132   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3133   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     3134     (input  v-host-code
     3135     ,output v-base-code
     3136     )  .
     3137     find first buf_rep_currency no-lock
     3138     where buf_rep_currency.curr-code = v-base-code
     3139     no-error .
     3140     if available buf_rep_currency then base-type = buf_rep_currency.curr-abbr .
     3141                 else base-type = "б.в." .
     3142     assign
     3143     tot-in-qnty = suppl-parts.p-in-qnty
     3144     tot-in-sum0-base = suppl-parts.p-in-sum0-base
     3145     tot-in-sum0-rubl = suppl-parts.p-in-sum0-rubl
     3146     tot-out-qnty       = 0
     3147     tot-out-sum0-base  = 0
     3148     tot-out-sum0-rubl  = 0
     3149     tot-free-qnty      = suppl-parts.free-qnty
     3150     tot-free-sum0-base = suppl-parts.free-sum0-base
     3151     tot-free-sum0-rubl = suppl-parts.free-sum0-rubl
     3152     .
     3153    FOR EACH ub.parts WHERE
     3154               ub.parts.artic = suppl-parts.artic
     3155           AND ub.parts.prod-type = suppl-parts.prod-type
     3156           AND ub.parts.prod-code = suppl-parts.prod-code
     3157           AND ub.parts.status_ = yes NO-LOCK,
     3158       each  ub.parts-attr where
     3159             ub.parts-attr.gds-code = suppl-parts.gds-code and
     3160             ub.parts-attr.in-code = ub.parts.in-code and
     3161             ub.parts-attr.part-code = ub.parts.part-code and
     3162             ub.parts-attr.income-in-code = suppl-parts.out-code
     3163             no-lock ,
     3164        EACH t-doc WHERE t-doc.doc-code = ub.parts.out-code
     3165                     and t-doc.fact-date >= from-date
     3166                     and t-doc.fact-date <= to-date
     3167                   and (
     3168                        t-doc.ext-doc-type = 'ee':U
     3169                     or t-doc.ext-doc-type = 'es':U
     3170                     or t-doc.ext-doc-type = 'rs':U
     3171                     or t-doc.ext-doc-type = 're':U )
     3172                NO-LOCK :
     3173         assign
     3174         tot-out-qnty       = tot-out-qnty     +  ub.parts.fact-qnty
     3175         tot-out-sum0-base  = tot-out-sum0-base +  ub.parts.fact-qnty   * ub.parts.price-base
     3176         tot-out-sum0-rubl  = tot-out-sum0-rubl +  ub.parts.fact-qnty   * ub.parts.price-rubl
     3177         .
     3178     end.
     3179     RUN enable_UI.
     3180     FRAME v-cust:TITLE = string("Документы по партии " + suppl-parts.part-code +
     3181                                        " из " + caps(substring(suppl-parts.doc-type, 1, 1)) + "Н № " + suppl-parts.out-code +
     3182                                        " товара " + suppl-parts.artic + " " + suppl-parts.gds-name  +
     3183                                        " с: " + string(from-date,"99/99/99") +
     3184                                        " по: " + string(to-date,"99/99/99") )
     3185                                        .
     3186     APPLY "ENTRY" TO BROWSE br-docs .
     3187     APPLY "ITERATION-CHANGED" TO BROWSE br-docs .
     3188     WAIT-FOR GO OF FRAME v-cust.
     3189   END.
     3190   RUN disable_UI.
     3191   PROCEDURE disable_UI :
     3192     HIDE FRAME v-cust.
     3193   END PROCEDURE.
     3194   PROCEDURE enable_UI :
     3195     DISPLAY tot-out-sum0-rubl tot-in-qnty tot-out-sum0-base tot-free-qnty
     3196             tot-in-sum0-rubl tot-free-sum0-base tot-free-sum0-rubl tot-out-qnty
     3197             tot-in-sum0-base
     3198         WITH FRAME v-cust.
     3199     ENABLE rect-in br-docs b-print b-help b-quit
     3200         WITH FRAME v-cust.
     3201     VIEW FRAME v-cust.
     3202     OPEN QUERY br-docs FOR EACH ub.parts WHERE             ub.parts.artic = suppl-parts.artic         AND ub.parts.prod-type = suppl-parts.prod-type         AND ub.parts.prod-code = suppl-parts.prod-code         AND ub.parts.status_ = yes NO-LOCK,     each  ub.parts-attr where           ub.parts-attr.gds-code = suppl-parts.gds-code and             ub.parts-attr.in-code = ub.parts.in-code and                 ub.parts-attr.part-code = ub.parts.part-code    and             ub.parts-attr.income-in-code = suppl-parts.out-code           no-lock ,                          EACH t-doc WHERE t-doc.doc-code = ub.parts.out-code                   and t-doc.fact-date >= from-date                   and t-doc.fact-date <= to-date                   and ( t-doc.ext-doc-type = 'ie':U                    or t-doc.ext-doc-type = 'ee':U                     or t-doc.ext-doc-type = 'es':U                   or t-doc.ext-doc-type = 'rs':U                   or t-doc.ext-doc-type = 're':U                   or t-doc.ext-doc-type = 'pc':U                      or t-doc.ext-doc-type = 'ap':U )               NO-LOCK BY t-doc.fact-date BY t-doc.fact-num.
     3203     assign tot-in-sum0-rubl:label = "сумма (руб)" .
     3204   END PROCEDURE.
