     1048       field in-nds0-rubl   like ub.parts.price-rubl
     1049       field in-nds0-base   like ub.parts.price-base
     1050       field in-sum0-rubl   like ub.parts.price-rubl
     1051       field in-sum0-base   like ub.parts.price-base
