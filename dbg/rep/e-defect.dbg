     1082     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1083     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1084     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1085     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1086     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1087     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1088     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1089     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1090     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1091     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1092     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1093     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1094     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1095     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1096     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1097     IF "":U = "":U THEN
     1098       RUN modify-list-attribute IN adm-broker-hdl
     1099         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1100     RUN use-create-on-add(?).
