      572   procedure godendo-date-to-offset :
      573     define input  parameter p-today  as date      no-undo .
      574     define input  parameter p-date   as date      no-undo .
      575     define output parameter p-offset as integer   no-undo .
      576     do
      577     on error undo, return error return-value
      578     :
      579       if p-date  = ?
      580       or p-today = ?
      581       then do:
      582         assign
      583           p-offset = ?
      584         .
      585       end.
      586       else do:
      587         assign
      588           p-offset = p-date - p-today + 1
      589         .
      590       end.
      591     end.
      592   end procedure.
      593   procedure godendo-offset-to-date :
      594     define input  parameter p-today  as date      no-undo .
      595     define input  parameter p-offset as integer   no-undo .
      596     define output parameter p-date   as date      no-undo .
      597     do
      598     on error undo, return error return-value
      599     :
      600       if p-today  = ?
      601       or p-offset = ?
      602       then do:
      603         assign
      604           p-date = ?
      605         .
      606       end.
      607       else do:
      608         assign
      609           p-date = p-offset + p-today - 1
      610         .
      611       end.
      612     end.
      613   end procedure.
      614   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      615   procedure cur-time :
      616      define output parameter p-today as date      no-undo .
      617      define output parameter p-time  as integer   no-undo .
      618     do
      619     on error undo, return error
      620     :
      621       define variable v-date1 as date      no-undo .
      622       define variable v-date2 as date      no-undo .
      623       define variable v-time  as integer   no-undo .
      624       assign
      625         v-date1 = today
      626         v-time  = time
      627         v-date2 = today
      628       .
      629       if v-date1 <> v-date2
      630       then do:
      631         assign
      632           v-date1 = today
      633           v-time  = v-time
      634         .
      635       end.
      636       assign
      637         p-today = v-date1
      638         p-time  = v-time
      639       .
      640     end.
      641   end.
      642   function cur-time-date returns character
      643   :
      644     return string(today, '99/99/9999':U) .
      645   end.
      646   function cur-time-mjd returns decimal
      647   :
      648     define variable v-date as date      no-undo .
      649     define variable v-time as integer   no-undo .
      650     run cur-time in this-procedure
      651       (output v-date
      652       ,output v-time
      653       ) .
      654     return integer(v-date) - 2400002 + (v-time / 86400) .
      655   end.
      656   function cur-time-get-ending-index returns integer
      657   (input p-number as integer
      658   )
      659   :
      660     if p-number < 0
      661     or p-number = ?
      662     then do:
      663       return 1 .
      664     end.
      665     define variable v-rest as integer   no-undo .
      666     assign
      667       p-number = p-number modulo 100
      668     .
      669     if p-number < 20
      670     then do:
      671       assign
      672         v-rest = p-number
      673       .
      674     end.
      675     else do:
      676       assign
      677         v-rest = p-number modulo 10
      678       .
      679     end.
      680     case v-rest :
      681       when 1
      682       then do:
      683         return 2 .
      684       end.
      685       when 2 or
      686       when 3 or
      687       when 4
      688       then do:
      689         return 3 .
      690       end.
      691       otherwise do:
      692         return 1 .
      693       end.
      694     end case .
      695   end.
      696   procedure cur-time-mjd-to-date :
      697      define input  parameter i-mjd-diff as decimal no-undo.
      698      define output parameter o-Date     as date    no-undo.
      699      define output parameter o-Time     as integer no-undo.
      700      define variable v-day-number as integer   no-undo .
      701      if    i-mjd-diff < 0
      702         or i-mjd-diff = ?
      703      then do:
      704         return "?" .
      705      end.
      706      assign
      707         v-day-number = truncate(i-mjd-diff,0).
      708         o-Date = date(v-day-number + 2400002).
      709         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      710     .
      711   end.
      712   function cur-time-mjd-to-string returns character
      713   (input p-mjd-diff as decimal
      714   )
      715   :
      716     define variable v-day-number as integer   no-undo .
      717     define variable v-seconds    as integer   no-undo .
      718     define variable v-hour       as integer   no-undo .
      719     define variable v-min        as integer   no-undo .
      720     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      721     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      722     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      723     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      724     if p-mjd-diff < 0
      725     or p-mjd-diff = ?
      726     then do:
      727       return "?" .
      728     end.
      729     assign
      730       v-day-number = integer(truncate(p-mjd-diff,0))
      731       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      732     .
      733     if v-seconds > 86400
      734     then do:
      735       assign
      736         v-seconds = 86400 - 1
      737       .
      738     end.
      739     if v-seconds < 0
      740     then do:
      741       assign
      742         v-seconds = 0
      743       .
      744     end.
      745     assign
      746       v-hour = truncate(v-seconds / 3600, 0)
      747     .
      748     assign
      749       v-seconds = v-seconds modulo 3600
      750     .
      751     assign
      752       v-min = truncate(v-seconds / 60, 0)
      753     .
      754     assign
      755       v-seconds = v-seconds modulo 60
      756     .
      757     return
      758         (if v-day-number <> 0
      759           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      760           else ""
      761         )
      762       + (if v-day-number <> 0 or v-hour <> 0
      763           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      764           else ""
      765         )
      766       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      767           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      768           else ""
      769         )
      770       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      771       .
      772   end.
      773   function cur-time-string returns character
      774   :
      775     define variable v-date as date      no-undo .
      776     define variable v-time as integer   no-undo .
      777     run cur-time in this-procedure
      778       (output v-date
      779       ,output v-time
      780       ) .
      781     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      782   end.
      783   function cur-time-string-sec returns character
      784   :
      785     define variable v-date as date      no-undo .
      786     define variable v-time as integer   no-undo .
      787     run cur-time in this-procedure
      788       (output v-date
      789       ,output v-time
      790       ) .
      791     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      792   end.
      793   function cur-time-custom  returns character
      794   (input p-prefix as character
      795   ,input p-date-format as character
      796   ,input p-delimiter as character
      797   ,input p-time-format as character
      798   ,input p-suffix as character
      799   )
      800   :
      801     define variable v-date as date      no-undo .
      802     define variable v-time as integer   no-undo .
      803     run cur-time in this-procedure
      804       (output v-date
      805       ,output v-time
      806       ) .
      807     return
      808       p-prefix
      809       + string(v-date, p-date-format)
      810       + p-delimiter
      811       + string(v-time, p-time-format)
      812       + p-suffix
      813       .
      814   end.
      815   function cur-time-print  returns character
      816   :
      817     define variable v-date as date      no-undo .
      818     define variable v-time as integer   no-undo .
      819     run cur-time in this-procedure
      820       (output v-date
      821       ,output v-time
      822       ) .
      823     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      824   end.
      825   function cur-time-datetime returns datetime
      826   :
      827     define variable v-char as character no-undo .
      828     define variable v-datetime as datetime no-undo .
      829     v-char = cur-time-string().
      830     v-datetime = datetime(v-char).
      831     return  v-datetime.
      832   end.
      833   function cur-time-string-msec returns character
      834   :
      835     define variable v-date as datetime  no-undo .
      836     v-date = now.
      837     return string(v-date) .
      838   end.
      839   procedure proc-alt-shift-f2:
      840     if not ibs.th.gbl.gbl-var:rcode
      841   then
      842     run gbl\inidebug.p .
      843   end.
      844   procedure proc-alt-shift-f3:
      845     run gbl/prvssinf.p
      846       ( input this-procedure
      847       ) .
      848   end.
      849   define variable v-inform-launched as logical no-undo initial false .
      850   procedure proc-alt-shift-f4:
      851     define variable v-action as character no-undo .
      852     if v-inform-launched = false then do:
      853       assign
      854         v-inform-launched = true
      855       .
      856       run gbl/d-inform.w
      857         (  input self
      858         ,  input this-procedure
      859         , output v-action
      860         ) no-error .
      861       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      862       assign
      863         v-inform-launched = false
      864       .
      865     end.
      866   end.
      867   procedure proc-alt-f1:
      868     run gbl/corrhelp.p
      869       (input this-procedure
      870       ) .
      871   end .
      872   on alt-shift-f2 anywhere do:
      873     run proc-alt-shift-f2.
      874   end.
      875   on alt-shift-f3 anywhere do:
      876     run proc-alt-shift-f3 in this-procedure .
      877   end.
      878   on alt-shift-f4 anywhere do:
      879     run proc-alt-shift-f4 in this-procedure.
      880   end.
      881   on alt-f1 anywhere do:
      882     run proc-alt-f1 in this-procedure .
      883   end.
      884   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      885     define variable v-cntxt-db-num        as integer   no-undo .
      886     define variable v-cntxt-userid        as character no-undo .
      887     define variable v-cntxt-level         as character no-undo .
      888     define variable v-cntxt-host-code-obj as integer   no-undo .
      889     define variable v-cntxt-obj-type      as character no-undo .
      890     define variable v-cntxt-obj-code      as integer   no-undo .
      891     define variable v-cntxt-db-num-obj    as integer   no-undo .
      892     define variable v-cntxt-is-admin      as logical   no-undo .
      893   define variable v-today as date      no-undo .
      894   define variable v-time as integer   no-undo .
      895   DEFINE VARIABLE rs-classificator AS CHARACTER
      896        VIEW-AS RADIO-SET VERTICAL
      897        RADIO-BUTTONS
      898             "Без классификации", "no-classify":U,
      899   "Производители", "prod":U,
      900   "Группы товаров", "grp-goods":U,
      901   "Производители/Группы товаров", "prod/grp-goods":U,
      902   "Группы товаров/Производители", "grp-goods/prod":U
      903        SIZE 30.5 BY 5.75 NO-UNDO.
      904   DEFINE VARIABLE rs-sort-type AS CHARACTER
      905        VIEW-AS RADIO-SET VERTICAL
      906        RADIO-BUTTONS
      907             "по коду", "sort-code":U,
      908   "по артикулу", "sort-artic":U,
      909   "по наименов.", "sort-name":U
      910        SIZE 14 BY 2.75 NO-UNDO.
      911   DEFINE RECTANGLE RECT-5
      912        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      913        SIZE 32.25 BY 7.17.
      914   DEFINE RECTANGLE RECT-6
      915        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      916        SIZE 16 BY 7.25.
      917   DEFINE FRAME F-Main
      918        rs-classificator AT ROW 4.25 COL 1.5 NO-LABEL
      919        rs-sort-type AT ROW 4.58 COL 35.13 NO-LABEL
      920        "Сортировка :" VIEW-AS TEXT
      921             SIZE 11.5 BY .75 AT ROW 3.33 COL 36.63
      922             FGCOLOR 4
      923        "Классификация :" VIEW-AS TEXT
      924             SIZE 15 BY .75 AT ROW 3.21 COL 9.25
      925             FGCOLOR 4
      926        RECT-6 AT ROW 3 COL 34
      927        RECT-5 AT ROW 3 COL 1
      928       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      929            SIDE-LABELS NO-UNDERLINE THREE-D
      930            AT COL 1 ROW 1 SCROLLABLE
      931            BGCOLOR 8 FGCOLOR 0 .
      932   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      933   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      934   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      935   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      936   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      937   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      938   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      939   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      940         adm-object-hdl = FRAME F-Main:HANDLE.
      941   RUN ensure-broker.
      942   THIS-PROCEDURE:ADM-DATA =
      943        'ADM1.1~`':U +
      944        'SmartObject~`':U +
      945        '~`':U +
      946        'NO ~`':U +
      947        '~`':U +
      948        '~`':U +
      949        '~`':U +
      950        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      951           + "~`":U +
      952        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      953        'Record-Source,Record-Target,TableIO-Target~`':U +
      954        '~`':U +
      955        '~`~`~`~`~`~`~`~`~`~`~`':U +
      956        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      957            THEN "^^":U
      958        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      959             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      960   PROCEDURE adm-apply-entry :
      961     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      962   END PROCEDURE.
      963   PROCEDURE adm-destroy :
      964    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      965   END PROCEDURE.
      966   PROCEDURE adm-disable :
      967       DISABLE RECT-6 RECT-5 rs-classificator rs-sort-type WITH FRAME F-Main.
      968       RUN dispatch ('disable-fields':U).
      969       RUN set-attribute-list ('ENABLED=no':U).
      970       RETURN.
      971   END PROCEDURE.
      972   PROCEDURE adm-edit-attribute-list :
      973         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      974         RETURN.
      975   END PROCEDURE.
      976   PROCEDURE adm-enable :
      977       ENABLE UNLESS-HIDDEN RECT-6 RECT-5 rs-classificator rs-sort-type WITH FRAME F-Main.
      978       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      979       RUN set-attribute-list ('ENABLED=yes':U).
      980       RETURN.
      981   END PROCEDURE.
      982   PROCEDURE adm-exit :
      983        RUN notify ('exit':U).
      984     RETURN.
      985   END PROCEDURE.
      986   PROCEDURE adm-hide :
      987     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      988   END PROCEDURE.
      989   PROCEDURE adm-initialize :
      990     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      991   END PROCEDURE.
      992   PROCEDURE adm-show-errors :
      993       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      994       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      995           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      996       END.
      997       RETURN.
      998   END PROCEDURE.
      999   PROCEDURE adm-UIB-mode :
     1000     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1001   END PROCEDURE.
     1002   PROCEDURE adm-view :
     1003     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1004   END PROCEDURE.
     1005   PROCEDURE dispatch :
     1006       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1007       RUN broker-dispatch IN adm-broker-hdl
     1008           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1009       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1010   END PROCEDURE.
     1011   PROCEDURE ensure-broker :
     1012   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1013   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1014   DO:
     1015       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1016       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1017   END.
     1018   END PROCEDURE.
     1019   PROCEDURE get-attribute :
     1020     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1021     RUN broker-get-attribute IN adm-broker-hdl
     1022         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1023     RETURN RETURN-VALUE.
     1024   END PROCEDURE.
     1025   PROCEDURE get-attribute-list :
     1026     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1027     RUN broker-get-attribute-list IN adm-broker-hdl
     1028         (INPUT THIS-PROCEDURE,
     1029          INPUT ?,
     1030          OUTPUT p-attr-list) NO-ERROR.
     1031     RETURN.
     1032   END PROCEDURE.
     1033   PROCEDURE new-state :
     1034     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1035     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1036     RETURN.
     1037   END PROCEDURE.
     1038   PROCEDURE notify :
     1039     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1040     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1041     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1042         RETURN "ADM-ERROR":U.
     1043     RETURN.
     1044   END PROCEDURE.
     1045   PROCEDURE set-attribute-list :
     1046     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
