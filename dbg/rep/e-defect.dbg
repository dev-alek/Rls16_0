     1160   PROCEDURE check-modified :
     1161   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1162   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1163   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1164   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1165     IF check-state = "check":U THEN
     1166     DO:
     1167       RUN get-link-handle IN adm-broker-hdl
     1168         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1169            OUTPUT group-target-list).
     1170       IF group-target-list NE "":U THEN
     1171       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1172         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1173         RUN check-modified IN curr-widget ('group-check':U).
     1174         IF RETURN-VALUE NE "":U THEN
     1175         DO:
     1176           RUN check-modified-message(RETURN-VALUE).
     1177           RETURN "":U.
     1178         END.
     1179       END.
     1180     END.
     1181     RETURN "":U.
     1182   END PROCEDURE.
     1183   PROCEDURE check-modified-message :
     1184     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1185        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1186           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1187        IF RETURN-VALUE = "YES":U THEN
     1188           RUN notify ('view,CONTAINER-SOURCE':U).
     1189        MESSAGE IF p-changed-table NE ? THEN
     1190           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1191           ELSE "Current values have been changed."
     1192           SKIP "  Do you wish to save those changes?"
     1193           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1194        IF ANS THEN
     1195        DO:
     1196           IF group-assign-target THEN
     1197             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1198           ELSE RUN dispatch('update-record':U).
     1199           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1200           DO:
     1201               MESSAGE "Changes to the previous record were not saved."
     1202                 VIEW-AS ALERT-BOX ERROR.
     1203               IF group-assign-target THEN
     1204                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1205               ELSE RUN dispatch ('cancel-record':U).
     1206           END.
     1207        END.
     1208        ELSE DO:
     1209          IF group-assign-target THEN
     1210             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1211          ELSE RUN dispatch('cancel-record':U).
     1212        END.
     1213        RETURN.
     1214   END PROCEDURE.
     1215   PROCEDURE get-rowid :
     1216       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1217       ASSIGN
     1218       p-table   =   adm-first-table.
     1219       RETURN.
     1220   END PROCEDURE.
     1221   PROCEDURE init-group-assign :
     1222       RUN request-attribute IN adm-broker-hdl
     1223         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1224       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1225         group-assign-target = yes.
     1226       ELSE group-assign-target = no.
     1227       RETURN.
     1228   END PROCEDURE.
     1229   PROCEDURE set-editors :
     1230       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1231       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1232       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1233       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1234       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1235       DO WHILE VALID-HANDLE (curr-widget):
     1236           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1237              curr-widget:HIDDEN = no THEN DO:
     1238             CASE p-field-setting:
     1239               WHEN "INITIALIZE":U THEN
     1240               DO:
     1241                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1242                     read-only-list +
     1243                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1244                        STRING(curr-widget).
     1245               END.
     1246               WHEN "DISABLE":U OR
     1247               WHEN "ENABLE":U THEN
     1248               DO:
     1249                   curr-widget:SENSITIVE = yes.
     1250                   RUN get-attribute ('Read-Only-Editors':U).
     1251                   IF RETURN-VALUE = ? OR
     1252                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1253                       curr-widget:READ-ONLY =
     1254                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1255               END.
     1256               WHEN "CLEAR":U THEN
     1257                   curr-widget:SCREEN-VALUE = "":U.
     1258             END CASE.
     1259           END.
     1260           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1261       END.
     1262       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1263         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1264           + '"':U).
     1265       RETURN.
     1266   END PROCEDURE.
     1267   PROCEDURE use-check-modified-all :
     1268    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1269     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1270     RETURN.
     1271   END PROCEDURE.
     1272   PROCEDURE use-create-on-add :
     1273   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1274      RETURN.
     1275   END PROCEDURE.
     1276   PROCEDURE use-initial-lock :
     1277     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1278     ASSIGN adm-initial-lock = p-attr-value.
     1279     RETURN.
     1280   END PROCEDURE.
     1281     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1282   ASSIGN
     1283          FRAME F-Main:SCROLLABLE       = FALSE
     1284          FRAME F-Main:HIDDEN           = TRUE.
     1285   ON VALUE-CHANGED OF rs-classificator IN FRAME F-Main
     1286   DO:
     1287       Assign rs-classificator.
     1288   END.
     1289   if not this-procedure :persistent
     1290   then do:
     1291     message
     1292       vss-workfile vss-revision vss-description skip
     1293       "Ошибка при запуске процедуры" skip
     1294       "Данную процедуру следует запускать только с параметром persistent" skip
     1295       view-as alert-box error .
     1296     undo, return error .
     1297   end.
     1298   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1299     run mainmenu_getcntxt in my-handle
     1300       (output v-cntxt-db-num
     1301       ,output v-cntxt-userid
     1302       ,output v-cntxt-level
     1303       ,output v-cntxt-host-code-obj
     1304       ,output v-cntxt-obj-type
     1305       ,output v-cntxt-obj-code
     1306       ,output v-cntxt-db-num-obj
     1307       ,output v-cntxt-is-admin
     1308       ) .
     1309   PROCEDURE disable_UI :
     1310     HIDE FRAME F-Main.
     1311     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1312   END PROCEDURE.
     1313   PROCEDURE local-initialize :
     1314     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1315   END PROCEDURE.
     1316   PROCEDURE my-report :
     1317       run rep/r-defect.p
     1318       (     input v-cntxt-obj-type
     1319           , input v-cntxt-obj-code
     1320           , input rs-classificator
     1321           , input rs-sort-type
     1322       ).
     1323   END PROCEDURE.
     1324   PROCEDURE my-var :
     1325   define variable v-radio-customer as integer no-undo .
     1326   define variable v-radio-schet    as integer no-undo .
     1327   define variable v-curr-code      as integer no-undo .
     1328   define variable v-radio-period   as character no-undo .
     1329   define variable v-keep-spis      as character no-undo .
     1330   run get-var-from-1-report-page (
     1331       output v-radio-customer ,
     1332       output v-radio-schet,
     1333       output v-curr-code,
     1334       output v-radio-period ,
     1335       output v-keep-spis ) .
     1336       assign frame F-Main
     1337           rs-classificator
     1338           rs-sort-type
     1339       .
     1340       define variable v-class-string as character no-undo.
     1341       define variable v-sort-string  as character no-undo.
     1342       case rs-classificator:
     1343           WHEN "no-classify":U    THEN v-class-string = "Без классификации" .
     1344           WHEN "prod":U           THEN v-class-string = "Производители"   .
     1345           WHEN "post":U           THEN v-class-string = "Поставщики"   .
     1346           WHEN "grp-goods":U      THEN v-class-string = "Группы товаров"  .
     1347           WHEN "post/grp-goods":U THEN v-class-string = "Поставщики/Группы товаров" .
     1348           WHEN "prod/grp-goods":U THEN v-class-string = "Производители/Группы товаров" .
     1349           WHEN "grp-goods/prod":U THEN v-class-string = "Группы товаров/Производители" .
     1350           WHEN "grp-goods/post":U THEN v-class-string = "Группы товаров/Поставщики" .
     1351           WHEN "vat-ps":U         THEN v-class-string = "Ставка НДС" .
     1352           WHEN "sort":U           THEN v-class-string = "Проба(Сорт)" .
     1353           WHEN "n-level":U        THEN v-class-string = "Группы с уровнем вложенности " .
     1354           WHEN "t-level":U        THEN v-class-string = "Терминальные группы" .
     1355       end case.
     1356       case rs-sort-type:
     1357           WHEN "sort-code":U          THEN v-sort-string = "по коду" .
     1358           WHEN "sort-artic":U         THEN v-sort-string = "по артикулу"  .
     1359           WHEN "sort-qunty":U         THEN v-sort-string = "по реализации".
     1360           WHEN "sort-name":U          THEN v-sort-string = "по наименованию".
     1361           WHEN "sort-type":U          THEN v-sort-string = "по типу ткани".
     1362           WHEN "sort-doc-code":U      THEN v-sort-string = "по номеру документа".
     1363           WHEN "sort-recipe-code":U   THEN v-sort-string = "по номеру рецепта".
     1364       end case.
     1365       assign
     1366           ReportName   = substitute(  "Отчет по фальсифицированным и забракованным партиям на &1" , string( today , "99/99/9999") ).
     1367           ReportHeader    = substitute( "Приходы c &1 по &2" , string(x-date-start , "99/99/9999") , string(x-date-end , "99/99/9999")  )
     1368                           + chr(10) + substitute( "Классификация: &1", v-class-string )
     1369                           + chr(10) + substitute( "Сортировка: &1", v-sort-string )
     1370                           .
     1371         find first g#customer no-error .
     1372         if available  g#customer then do:
     1373         ReportHeader = ReportHeader + " По списку поставщиков" .
     1374         end.
     1375    sheetf.Excel-Column-Lable =
     1376              "Код"
     1377     + ","  + "Артикул"
     1378     + ","  + "Производитель"
     1379     + ","  + "Наименование товара"
     1380     + ","  + "Поставщик"
     1381     + ","  + "Имя поставщика"
     1382     + ","  + "Партия"
     1383     + ","  + "Остаток"
     1384     + ","  + "Объект"
     1385     + ","  + "ПН"
     1386     + ","  + "Дата ПН"
     1387     + ","  + "Цена учетная"
     1388     + ","  + "Цена продажная"
     1389     + ","  + "Цена производителя"
     1390     .
     1391    sheetf.Sizes         =  "10,16,20,35,15,40,15,15,20,15,15,15,15,15" .
     1392    sheetf.make-correct  =  "" .
     1393   END PROCEDURE.
     1394   procedure get-var-from-1-report-page :
     1395    do
     1396    on error undo, return error return-value
     1397    :
     1398   define output parameter p-customer as integer no-undo .
     1399   define output parameter p-schet    as integer no-undo .
     1400   define output parameter p-curr-code as integer no-undo .
     1401   define output parameter p-period    as character no-undo .
     1402   define output parameter p-keep-spis  as character no-undo .
     1403   define variable v-res as character no-undo .
     1404     RUN get-attribute IN THIS-PROCEDURE ('UIB-MODE').
     1405     IF RETURN-VALUE NE "DESIGN" THEN DO:
     1406       RUN get-link-handle IN adm-broker-hdl ( THIS-PROCEDURE, 'State':U , OUTPUT source-str ).
     1407       State-source = WIDGET-HANDLE ( source-str ).
     1408       IF not VALID-HANDLE ( State-source ) THEN
     1409         Message "Не определен линк " 'State':U view-as alert-box error.
     1410     END.
     1411    run get-attribute in state-source  ( 'KEEP-SPIS':U ).
     1412     v-res = return-value .
     1413     if v-res = ? or v-res = "" then p-keep-spis = ? .
     1414                                else p-keep-spis = return-value .
     1415    run get-attribute in state-source  ( 'RADIO-PERIOD':U ).
     1416     v-res = return-value .
     1417     if v-res = ? or v-res = "" then p-period = ? .
     1418                                else p-period = return-value .
     1419    run get-attribute in state-source  ( 'RADIO-CUSTOMER':U ).
     1420     v-res = return-value .
     1421     if v-res = ? or v-res = "" then p-customer = ? .
     1422                                else p-customer = integer (return-value) .
     1423    run get-attribute in state-source  ( 'RADIO-SCHET':U ).
     1424     v-res = return-value .
     1425     if v-res = ? or v-res = "" then p-schet = ? .
     1426                                else p-schet = integer (return-value) .
     1427    run get-attribute in state-source  ( 'EX-CURR-CODE':U ).
     1428     v-res = return-value .
     1429     if v-res = ? or v-res = "" then p-curr-code = ? .
     1430                                else p-curr-code = integer (return-value) .
     1431    end.
     1432   end procedure.
     1433   PROCEDURE state-changed :
     1434     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1435     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1436     CASE p-state:
     1437     END CASE.
     1438   END PROCEDURE.
