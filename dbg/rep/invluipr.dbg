     1030   def var Tmp_Counter   as   int  init 0  no-undo.
     1031   define stream  OutStream .
     1032   define stream  macr_excel.
     1033   define variable v-file-name as character no-undo .
     1034   define variable v-ind       as integer   no-undo .
     1035   define variable C-str  as character no-undo .
     1036   def var sym1 as char  init ":"   no-undo.
     1037   def var sym2 as char  init ":"   no-undo.
     1038   def var sym3 as char  init ":"   no-undo.
     1039   def var sym4 as char  init ":"   no-undo.
     1040   def var sym5 as char  init ":"   no-undo.
     1041   define variable vartemp-string as character no-undo.
     1042   define variable num#col#    as integer no-undo .
     1043   define variable summ   as decimal no-undo .
     1044   define variable num-ln as integer no-undo .
     1045   define variable var-1  as integer no-undo .
     1046   define variable var-2  as integer no-undo .
     1047   define variable C-c    as integer no-undo .
     1048   define variable str--1 as character Format "x(60)" no-undo.
     1049   define variable str--2 as integer no-undo .
     1050   define variable C-i    as integer no-undo .
     1051   define variable p-var  as integer no-undo .
     1052   define variable v-user-action as character no-undo .
     1053   define variable v-printed     as logical   no-undo .
     1054   DEFINE FRAME print-diff
     1055       sym1 column-label ":"  format "X(1)" space(0)
     1056       tt-result.b-code COLUMN-LABEL "Бар-код":C9 format "999999999" space(0)
     1057       sym2 column-label ":"  format "X(1)" space(0)
     1058       tt-result.artic COLUMN-LABEL "Артикул":C40 format "X(16)" space(0)
     1059       Sym3 column-label ":" format "X(1)" space(0)
     1060       tt-result.gds-name COLUMN-LABEL "Наименование товара":C40 format "X(40)" space(0)
     1061       Sym4 column-label ":" format "X(1)" space(0)
     1062       vartemp-string COLUMN-LABEL "Количество":C13 format "X(20)" space(0)
     1063       Sym5 column-label ":" format "X(1)" space(0)
     1064       HEADER
     1065       string( "Лист " + string( PAGE-NUMBER(OutStream) , ">>>>9") ) AT 70 format "X(13)" SKIP
     1066       Line format "X(114)" AT 1
     1067       with width 232 down stream-io use-text NO-BOX.
     1068     if session:set-wait-state("compiler") then.
     1069   output STREAM OutStream to value( string( session:temp-directory +
     1070                                        "rpt" + string( g#report-num ) ) )
     1071                                        page-size  value(43) .
     1072     define variable v-prn0 as character no-undo .
     1073     assign
     1074       Line    = fill("-", 230)
     1075       UndLine = fill("_", 230)
     1076       LineBuf = fill("_", 240)
     1077     .
     1078   define variable v-account as integer init 0 no-undo .
     1079   define variable v-account-lavel as character no-undo .
     1080   define variable v-button-stop as logical no-undo .
     1081   define variable v-kol-spice as integer no-undo .
     1082   define variable v-kol-spice2 as integer no-undo .
     1083   define variable v-kol-spice3 as integer no-undo .
     1084   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1085   DEFINE BUTTON StopBtn AUTO-END-KEY
     1086        LABEL "Стоп"
     1087        SIZE 10 BY 1.
     1088   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1089        LABEL "Обработано записей"
     1090         VIEW-AS TEXT
     1091        SIZE 14 BY .67 NO-UNDO.
     1092   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1093         VIEW-AS TEXT
     1094        SIZE 53.25 BY .67
     1095        FGCOLOR 1  NO-UNDO.
     1096   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1097         VIEW-AS TEXT
     1098        SIZE 53.25 BY .67
     1099        FGCOLOR 1  NO-UNDO.
     1100   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1101         VIEW-AS TEXT
     1102        SIZE 53.25 BY .67
     1103        FGCOLOR 1  NO-UNDO.
     1104   DEFINE RECTANGLE RECT-1
     1105        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1106        SIZE 55.13 BY 4.46.
     1107   DEFINE FRAME InfoFrame
     1108        StopBtn AT ROW 4.25 COL 21.75
     1109        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1110        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1111        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1112        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1113        RECT-1 AT ROW 1 COL 1
     1114       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1115            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1116            TITLE "Процесс"
     1117            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1118   define variable mFrameView      as logical   no-undo init yes.
     1119     define variable mFramHandle as handle no-undo.
     1120     mFramHandle = frame InfoFrame:handle.
     1121     if  log-manager:logfile-name ne ?
     1122     then DO:
     1123         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1124         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1125         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1126     end.
     1127     mFrameView = not session:batch-mode and mFramHandle:visible.
     1128     if mFrameView
     1129     then do:
     1130       ASSIGN
     1131          FRAME InfoFrame:HIDDEN                           = TRUE
     1132          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1133     end.
     1134   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1135   DO:
     1136     IF not StopProcessing THEN
     1137       Message "Вы действительно хотите прервать" SKIP
     1138               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1139                 UPDATE StopProcessing.
     1140     IF StopProcessing THEN do:
     1141        if mFrameView
     1142        then do:
     1143           HIDE FRAME InfoFrame.
     1144        end.
     1145     End.
     1146   END.
     1147   assign v-account = ( if integer( 25 ) = 0 then 100 else integer( 25 ) ).
     1148     if  log-manager:logfile-name ne ?
     1149     then DO:
     1150         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1151     end.
     1152     if not session:batch-mode then
     1153     do:
     1154       VIEW FRAME InfoFrame.
     1155       mFrameView = true.
     1156     end.
     1157      v-button-stop = false .
     1158         if mFrameView
     1159         then do:
     1160         if v-button-stop then view STOPBTN in frame InfoFrame.
     1161                          else Hide STOPBTN in frame InfoFrame.
     1162         end.
     1163   v-ind = 0    .
     1164   FORM with frame print-diff .
     1165    Output stream Macr_Excel close .
     1166    run gbl/_tmpfile.p ("wb", ".txt", output v-file-name) .
     1167    output stream macr_excel to value(v-file-name)   .
     1168   assign
     1169     num#str# = 0 .
     1170   assign
     1171     v-ind = v-ind + 1.
     1172   run PrintTitul in this-procedure .
     1173   for each tt-result where tt-result.scan-1 <> tt-result.scan-2 use-index artic:
     1174       run print-line in this-procedure .
     1175   end.
     1176   put stream OutStream Line format "X(114)".
     1177   run on-same-page in this-procedure (input 15) .
     1178   page stream OutStream .
     1179   run paramls-write in this-procedure
     1180     (input "file"
     1181     ,input "Разница":u
     1182     ,input v-file-name
     1183     ) .
     1184   HIDE STREAM OutStream FRAME print-diff.
     1185   HIDE stream OutStream FRAME BottomFrame .
     1186   HIDE stream OutStream FRAME BottomFrame2 .
     1187   output stream OutStream CLOSE .
     1188   Output stream Macr_Excel  close .
     1189   if mFrameView
     1190   then do:
     1191      HIDE FRAME InfoFrame.
     1192   end.
     1193   run paramls-write in this-procedure
     1194       (input "charcol"
     1195       ,input ""
     1196       ,input "1"
     1197       ) .
     1198   run end-proc .
     1199     define variable DisabledOptions as integer   no-undo .
     1200     DisabledOptions = 0 .
     1201     run gbl/prnfilen.w
     1202       (input  ""
     1203       ,input  DisabledOptions
     1204       ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     1205       , 7
     1206       ,output v-user-action
     1207       ,output v-printed
     1208       ) .
     1209   procedure print-line :
     1210     do on error undo, return error return-value :
     1211     assign
     1212        Lines_Counter = Lines_Counter + 1
     1213       .
     1214     if line-counter( OutStream ) + 2 > page-size( OutStream ) then page stream OutStream.
     1215     if line-counter( OutStream ) < Tmp_Counter then
     1216       assign
     1217       .
     1218     assign
     1219       Tmp_Counter  = line-counter( OutStream )
     1220       num-ln = num-ln + 1
     1221     .
     1222   num#str# = num#str# + 1.
     1223   num#col# = 1.
     1224   run macr_excel_char( string(tt-result.b-code)   , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1225   run macr_excel_char( tt-result.artic    , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1226   run macr_excel_char( tt-result.gds-name , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1227     display stream OutStream
     1228       sym1 tt-result.b-code
     1229       sym2 tt-result.artic
     1230       sym3 tt-result.gds-name
     1231       sym4
     1232       sym5
     1233       with FRAME print-diff.
     1234     DOWN stream OutStream 1 with FRAME print-diff.
     1235   end.
     1236   end procedure.
     1237   procedure PrintTitul :
     1238     do  on error undo, return error return-value  :
     1239     define variable cc as integer no-undo .
     1240     define variable tt as integer no-undo .
     1241         PUT STREAM OutStream
     1242           space(5) string( "Отчет расхождений по инвентаризации со сравнением" ) format "x(50)" skip
     1243           space(5) cur-time-date() format "X(20)"
     1244           skip .
     1245         .
     1246       num#str# = num#str# + 1.
     1247       num#col# = 2.
     1248       cc = num#str# .
     1249       run macr_excel_char( "Отчет расхождений по инвентаризации со сравнением"    , num#str# , num#col#   ) .
     1250       num#str# = num#str# + 1.
     1251       num#col# = 2.
     1252       run macr_excel_char( cur-time-date()   , num#str# , num#col#   ) .
     1253       run macr_cell_format
     1254       ( 20    ,
     1255         true  ,
     1256         false  ,
     1257         ?    ,
     1258         cc ,
     1259         2 ,
     1260         num#str# ,
     1261         2 ) .
     1262       num#str# = num#str# + 1.
     1263       num#col# = 1.
     1264       tt = num#str#  .
     1265       run macr_excel_char( "Бар-код"   , num#str# , num#col#   ) .
     1266       run macr_cell_size ( 10 , ? , num#str# , num#col# , ?, ? ) .
     1267       num#col# = 2.
     1268       run macr_excel_char( "Артикул"   , num#str# , num#col#   ) .
     1269       run macr_cell_size ( 21 , ? , num#str# , num#col# , ?, ? ) .
     1270       num#col# = 3.
     1271       run macr_excel_char( "Наименование товара"   , num#str# , num#col#   ) .
     1272       run macr_cell_size ( 40 , ? , num#str# , num#col# , ?, ? ) .
     1273       num#col# = 4.
     1274       run macr_excel_char( "Количество"   , num#str# , num#col#   ) .
     1275       run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1276       run macr_cell_format
     1277       ( 12    ,
     1278         true  ,
     1279         false  ,
     1280         ?    ,
     1281         num#str# ,
     1282         1 ,
     1283         num#str# ,
     1284         4 ) .
     1285        put  stream macr_excel unformatted
     1286          substitute('select("r&1c&2:r&3c&4 ")' , tt , 1 , num#str# ,  num#col# ) + chr(10)  +
     1287          'BORDER( 2 , 2 , 2 , 2 , 2 , ,0,0,0,0,0) '  + chr(10) +
     1288          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     1289          .
     1290     end.
     1291   end procedure.
     1292   PROCEDURE on-same-page :
     1293     define input parameter p-line-number as integer  no-undo .
     1294     if p-line-number > page-size( OutStream ) then return .
     1295     if line-counter( OutStream ) + p-line-number > page-size( OutStream ) then  page stream OutStream .
     1296   end procedure.
     1297   def var vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1298   procedure macr_excel_char :
     1299    do
     1300    on error undo, return error return-value
     1301    :
     1302    define input parameter  p-val as character no-undo .
     1303    define input parameter  p-row as integer no-undo .
     1304    define input parameter  p-col as integer no-undo .
     1305    if p-val = ? then p-val = "" .
     1306       put stream macr_excel unformatted
     1307             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1308    end.
     1309   end procedure.
     1310   procedure macr_excel_char_with_format :
     1311    do
     1312    on error undo, return error return-value
     1313    :
     1314    define input parameter  p-val as character no-undo .
     1315    define input parameter  p-row as integer no-undo .
     1316    define input parameter  p-col as integer no-undo .
     1317    if p-val = ? then p-val = "" .
     1318       put stream macr_excel unformatted
     1319             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     1320       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     1321       put stream macr_excel unformatted
     1322             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1323    end.
     1324   end procedure.
     1325   procedure macr_excel_cell_format :
     1326    do
     1327    on error undo, return error return-value
     1328    :
     1329    define input parameter  p-val    as character no-undo .
     1330    define input parameter  p-row    as integer   no-undo .
     1331    define input parameter  p-col    as integer   no-undo .
     1332    define input parameter  p-format as character no-undo .
     1333    if p-val = ? then p-val = "" .
     1334       put stream macr_excel unformatted
     1335             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     1336       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     1337       put stream macr_excel unformatted
     1338             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1339    end.
     1340   end procedure.
     1341   procedure macr_excel_sum :
     1342    do
     1343    on error undo, return error return-value
     1344    :
     1345    define input parameter  p-row as integer no-undo .
     1346    define input parameter  p-col as integer no-undo .
     1347    define input parameter  p-row1 as integer no-undo .
     1348    define input parameter  p-col1 as integer no-undo .
     1349    define input parameter  p-row2 as integer no-undo .
     1350    define input parameter  p-col2 as integer no-undo .
     1351       put stream macr_excel unformatted
     1352             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     1353    end.
     1354   end procedure.
     1355   procedure macr_excel_dec :
     1356    do
     1357    on error undo, return error return-value
     1358    :
     1359    define input parameter  p-val as character no-undo .
     1360    define input parameter  p-row as integer   no-undo .
     1361    define input parameter  p-col as integer   no-undo .
     1362     if p-val = ? then p-val =  "" .
     1363      put  stream macr_excel unformatted
     1364           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     1365    end.
     1366   end procedure.
     1367   procedure macr_cell_format :
     1368    do
     1369    on error undo, return error return-value
     1370    :
     1371    define input parameter  p-size   as integer   no-undo .
     1372    define input parameter  p-bold   as logical   no-undo .
     1373    define input parameter  p-italic as logical   no-undo .
     1374    define input parameter  p-color  as integer   no-undo .
     1375    define input parameter  p-row    as integer   no-undo .
     1376    define input parameter  p-col    as integer   no-undo .
     1377    define input parameter  p-row-2  as integer   no-undo .
     1378    define input parameter  p-col-2  as integer   no-undo .
     1379     if p-size = ? then p-size = 10 .
     1380     if p-bold = ? then p-bold = false .
     1381     if p-italic = ? then p-italic = false .
     1382     if p-row-2 = ? then p-row-2 = p-row .
     1383     if p-col-2 = ? then p-col-2 = p-col .
     1384     put  stream macr_excel unformatted
     1385      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     1386     if p-color <> ? then do:
     1387        put  stream macr_excel unformatted
     1388          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     1389     end.
     1390     put  stream macr_excel unformatted
     1391          substitute('format.font(,&1,&2,&3)' , p-size,
     1392                                           string ( p-bold  , "true/false" ) ,
     1393                                           string ( p-italic , "true/false" )
     1394                                           ) + chr(10) .
     1395    end.
     1396   end procedure.
     1397   procedure macr_cell_size :
     1398    do
     1399    on error undo, return error return-value
     1400    :
     1401    define input parameter  p-w   as integer   no-undo .
     1402    define input parameter  p-l   as integer   no-undo .
     1403    define input parameter  p-row    as integer   no-undo .
     1404    define input parameter  p-col    as integer   no-undo .
     1405    define input parameter  p-row-2  as integer   no-undo .
     1406    define input parameter  p-col-2  as integer   no-undo .
     1407     if p-row-2 = ? then p-row-2 = p-row .
     1408     if p-col-2 = ? then p-col-2 = p-col .
     1409     if p-w = ? then    p-w = 0 .
     1410     if p-l = ? then    p-l = 0 .
     1411    define variable s-w as character no-undo .
     1412    define variable s-l as character no-undo .
     1413    if p-w = 0 then s-w = "" .
     1414               else s-w = string(p-w)  .
     1415    if p-l = 0 then s-l = "" .
     1416               else s-l = string(p-l)  .
     1417   put  stream macr_excel unformatted
     1418        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     1419   put  stream macr_excel unformatted
     1420        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     1421   put  stream macr_excel unformatted
     1422        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     1423    end.
     1424   end procedure.
     1425   procedure proc-print-header :
     1426    do
     1427    on error undo, return error return-value
     1428    :
     1429      find first sheetf .
     1430        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     1431        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     1432        var-1 =  num#str# .
     1433        repeat c-c = 1 to sheetf.excel-row-title :
     1434        num#str# = num#str# + 1 .
     1435        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     1436        do c-i = 1 to p-var :
     1437           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     1438           str--2 = integer(entry( c-i, sheetf.sizes )) .
     1439           num#col# = c-i .
     1440           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     1441           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     1442        end.
     1443       c-i = 0.
     1444       end.
     1445       run macr_cell_format (
     1446           10       ,
     1447           true     ,
     1448           false    ,
     1449           35       ,
     1450           var-1 + 1,
     1451           1        ,
     1452           num#str# ,
     1453           num#col# )
     1454           .
     1455     put  stream macr_excel unformatted
     1456          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     1457          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     1458          .
     1459    end.
     1460   end procedure.
     1461   procedure end-proc :
     1462    do
     1463    on error undo, return error return-value
     1464    :
     1465     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     1466     OUTPUT to VALUE (v-file-name) .
     1467     for each temp-param :
     1468       export  temp-param  .
     1469     end.
     1470    end.
     1471   end procedure.
