      989   define new global shared variable g#vssrevis-logger as handle    no-undo .
      990   define variable v-vssrevis-logevent                 as logical   no-undo init false .
      991   define variable v-vssrevis-logger                   as handle    no-undo .
      992   procedure vss-logevent :
      993     define input  parameter p-extra-paramters as character no-undo .
      994     define variable v-vssrevis-parameters as character no-undo .
      995     do
      996     on error undo, return error return-value
      997     :
      998       if  valid-handle(v-vssrevis-logger)
      999       and v-vssrevis-logger :get-signature("logevent") <> ""
     1000       then do:
     1001         run vss-get-parameters in this-procedure
     1002           (output v-vssrevis-parameters
     1003           ).
     1004         run logevent in v-vssrevis-logger
     1005           (input vss-workfile
     1006           ,input vss-revision
     1007           ,input v-vssrevis-parameters
     1008           ,input p-extra-paramters
     1009           ).
     1010       end.
     1011     end.
     1012   end procedure.
     1013   assign
     1014     v-vssrevis-logger = g#vssrevis-logger
     1015   .
     1016   if  valid-handle(v-vssrevis-logger)
     1017   and v-vssrevis-logger :get-signature("logevent") <> ""
     1018   then do:
     1019     assign
     1020       v-vssrevis-logevent = true
     1021     .
     1022     run vss-logevent in this-procedure (input vss-description) .
     1023   end.
     1024   define variable g#report-num as integer   no-undo .
     1025   run get-report-num  in parParentProc ( output g#report-num ).
     1026   def var LineBuf  as char  no-undo.
     1027   def var Line     as char  no-undo.
