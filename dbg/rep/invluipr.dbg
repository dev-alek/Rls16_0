      102   procedure create_obj-list :
      103      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      104      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      105      do
      106      on error undo, return error return-value
      107      :
      108         define buffer cli-obj for ub.clients .
      109         define variable p-var as integer no-undo .
      110         define buffer buf_obj-list for obj-list .
      111         find last buf_obj-list  use-index pi no-error .
      112         if available buf_obj-list
      113         then
      114            p-var = buf_obj-list.obj-id + 1.
      115         else
      116            p-var = 1.
      117         find first cli-obj where
      118                   cli-obj.obj-type = p-obj-type
      119               and cli-obj.obj-code = p-obj-code
      120         no-lock no-error.
      121         if available cli-obj
      122         then do:
      123            create buf_obj-list.
      124            assign
      125               buf_obj-list.obj-id   = p-var
      126               buf_obj-list.obj-code = cli-obj.obj-code
      127               buf_obj-list.obj-type = cli-obj.obj-type
      128               buf_obj-list.obj-name = cli-obj.obj-name
      129               buf_obj-list.db-num   = cli-obj.db-num
      130            .
      131         end.
      132      end.
      133   end.
