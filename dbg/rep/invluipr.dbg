      531   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      532   function breakstr returns character ( input        for-name    as character,
      533                                         input        line-length as integer,
      534                                         input-output line1       as character,
      535                                         input-output line2       as character ) :
      536     define variable ii as integer no-undo.
      537     if length( for-name ) > line-length then do:
      538       assign ii    = 1
      539              line1 = "":u
      540              line2 = "":u.
      541       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
      542         assign line1 =       substring( for-name, 1, line-length     )
      543                line2 = trim( substring( for-name,    line-length + 1 ) ).
      544       end.                                                     else do:
      545         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
      546           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
      547                  ii    = ii    + 1.
      548           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
      549             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
      550           end.
      551         end.
      552         assign line2 = trim( substring( for-name, length( line1 ) ) ).
      553       end.
      554     end.                                else do:
      555       assign line1 = for-name
      556              line2 = "":u.
      557     end.
      558     return ( line1 ).
      559   end function.
      560   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      561   procedure cur-time :
      562      define output parameter p-today as date      no-undo .
      563      define output parameter p-time  as integer   no-undo .
      564     do
      565     on error undo, return error
      566     :
      567       define variable v-date1 as date      no-undo .
      568       define variable v-date2 as date      no-undo .
      569       define variable v-time  as integer   no-undo .
      570       assign
      571         v-date1 = today
      572         v-time  = time
      573         v-date2 = today
      574       .
      575       if v-date1 <> v-date2
      576       then do:
      577         assign
      578           v-date1 = today
      579           v-time  = v-time
      580         .
      581       end.
      582       assign
      583         p-today = v-date1
      584         p-time  = v-time
      585       .
      586     end.
      587   end.
      588   function cur-time-date returns character
      589   :
      590     return string(today, '99/99/9999':U) .
      591   end.
      592   function cur-time-mjd returns decimal
      593   :
      594     define variable v-date as date      no-undo .
      595     define variable v-time as integer   no-undo .
      596     run cur-time in this-procedure
      597       (output v-date
      598       ,output v-time
      599       ) .
      600     return integer(v-date) - 2400002 + (v-time / 86400) .
      601   end.
      602   function cur-time-get-ending-index returns integer
      603   (input p-number as integer
      604   )
      605   :
      606     if p-number < 0
      607     or p-number = ?
      608     then do:
      609       return 1 .
      610     end.
      611     define variable v-rest as integer   no-undo .
      612     assign
      613       p-number = p-number modulo 100
      614     .
      615     if p-number < 20
      616     then do:
      617       assign
      618         v-rest = p-number
      619       .
      620     end.
      621     else do:
      622       assign
      623         v-rest = p-number modulo 10
      624       .
      625     end.
      626     case v-rest :
      627       when 1
      628       then do:
      629         return 2 .
      630       end.
      631       when 2 or
      632       when 3 or
      633       when 4
      634       then do:
      635         return 3 .
      636       end.
      637       otherwise do:
      638         return 1 .
      639       end.
      640     end case .
      641   end.
      642   procedure cur-time-mjd-to-date :
      643      define input  parameter i-mjd-diff as decimal no-undo.
      644      define output parameter o-Date     as date    no-undo.
      645      define output parameter o-Time     as integer no-undo.
      646      define variable v-day-number as integer   no-undo .
      647      if    i-mjd-diff < 0
      648         or i-mjd-diff = ?
      649      then do:
      650         return "?" .
      651      end.
      652      assign
      653         v-day-number = truncate(i-mjd-diff,0).
      654         o-Date = date(v-day-number + 2400002).
      655         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      656     .
      657   end.
      658   function cur-time-mjd-to-string returns character
      659   (input p-mjd-diff as decimal
      660   )
      661   :
      662     define variable v-day-number as integer   no-undo .
      663     define variable v-seconds    as integer   no-undo .
      664     define variable v-hour       as integer   no-undo .
      665     define variable v-min        as integer   no-undo .
      666     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      667     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      668     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      669     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      670     if p-mjd-diff < 0
      671     or p-mjd-diff = ?
      672     then do:
      673       return "?" .
      674     end.
      675     assign
      676       v-day-number = integer(truncate(p-mjd-diff,0))
      677       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      678     .
      679     if v-seconds > 86400
      680     then do:
      681       assign
      682         v-seconds = 86400 - 1
      683       .
      684     end.
      685     if v-seconds < 0
      686     then do:
      687       assign
      688         v-seconds = 0
      689       .
      690     end.
      691     assign
      692       v-hour = truncate(v-seconds / 3600, 0)
      693     .
      694     assign
      695       v-seconds = v-seconds modulo 3600
      696     .
      697     assign
      698       v-min = truncate(v-seconds / 60, 0)
      699     .
      700     assign
      701       v-seconds = v-seconds modulo 60
      702     .
      703     return
      704         (if v-day-number <> 0
      705           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      706           else ""
      707         )
      708       + (if v-day-number <> 0 or v-hour <> 0
      709           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      710           else ""
      711         )
      712       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      713           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      714           else ""
      715         )
      716       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      717       .
      718   end.
      719   function cur-time-string returns character
      720   :
      721     define variable v-date as date      no-undo .
      722     define variable v-time as integer   no-undo .
      723     run cur-time in this-procedure
      724       (output v-date
      725       ,output v-time
      726       ) .
      727     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      728   end.
      729   function cur-time-string-sec returns character
      730   :
      731     define variable v-date as date      no-undo .
      732     define variable v-time as integer   no-undo .
      733     run cur-time in this-procedure
      734       (output v-date
      735       ,output v-time
      736       ) .
      737     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      738   end.
      739   function cur-time-custom  returns character
      740   (input p-prefix as character
      741   ,input p-date-format as character
      742   ,input p-delimiter as character
      743   ,input p-time-format as character
      744   ,input p-suffix as character
      745   )
      746   :
      747     define variable v-date as date      no-undo .
      748     define variable v-time as integer   no-undo .
      749     run cur-time in this-procedure
      750       (output v-date
      751       ,output v-time
      752       ) .
      753     return
      754       p-prefix
      755       + string(v-date, p-date-format)
      756       + p-delimiter
      757       + string(v-time, p-time-format)
      758       + p-suffix
      759       .
      760   end.
      761   function cur-time-print  returns character
      762   :
      763     define variable v-date as date      no-undo .
      764     define variable v-time as integer   no-undo .
      765     run cur-time in this-procedure
      766       (output v-date
      767       ,output v-time
      768       ) .
      769     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      770   end.
      771   function cur-time-datetime returns datetime
      772   :
      773     define variable v-char as character no-undo .
      774     define variable v-datetime as datetime no-undo .
      775     v-char = cur-time-string().
      776     v-datetime = datetime(v-char).
      777     return  v-datetime.
      778   end.
      779   function cur-time-string-msec returns character
      780   :
      781     define variable v-date as datetime  no-undo .
      782     v-date = now.
      783     return string(v-date) .
      784   end.
      785   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      786     if num-entries(string(p-dec), '.') = 2
      787       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      788       else return( string(p-dec)) .
      789   end function.
      790   function format-point-to-comma returns char (input orig as char ) .
      791   define variable rtext as character no-undo .
      792   define variable strt as integer no-undo .
      793   define variable leng as integer no-undo .
      794   assign rtext = orig .
      795   repeat:
      796     strt =  index(rtext,'.').
      797     if strt = 0 then leave.
      798     leng = 1.
      799     substring(rtext,strt,leng,"character") = v-delim .
      800   end.
      801   return rtext.
      802   end function.
      803   function format-excel-text returns char ( input start-text as char ) :
      804   def var  i    as int no-undo.
      805   def var  ch   as char no-undo.
      806   def var  n    as int no-undo.
      807   def var  ipos as int no-undo.
      808     n = num-entries(trim(start-text), chr(10)) - 1 .
      809     do i = 1 to n :
      810       ipos = index( start-text, chr(10)).
      811       if ipos > 0 then
      812         substr( start-text, ipos, 1 ) = ' '.
      813     end.
      814     n = num-entries(trim(start-text), chr(13)) - 1 .
      815     do i = 1 to n :
      816       ipos = index( start-text, chr(13)).
      817       if ipos > 0 then
      818         substr( start-text, ipos, 1 ) = ' '.
      819     end.
      820     if index( start-text, '"' ) = 0 then
      821       start-text =  '="'   + trim( start-text) + '"'   .
      822       else do:
      823         n = num-entries(trim(start-text), '"') - 1.
      824         do i = 1 to n :
      825           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      826         end.
      827         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      828         start-text = '="'  + ch  + '"' .
      829       end.
      830     return start-text.
      831   end.
      832   function excel-sum returns char (input p-dec as decimal ).
      833     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      834   end function.
      835   function excel-qnty returns char (input p-dec as decimal ).
      836     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      837   end function.
      838   function format-excel-text-macr returns char ( input start-text as char ) :
      839   def var  i    as int no-undo.
      840   def var  ch   as char no-undo.
      841   def var  n    as int no-undo.
      842   def var  ipos as int no-undo.
      843     n = num-entries(trim(start-text), chr(10)) - 1 .
      844     do i = 1 to n :
      845       ipos = index( start-text, chr(10)).
      846       if ipos > 0 then
      847         substring( start-text, ipos , 1 ) = ' '.
      848     end.
      849     n = num-entries(trim(start-text), chr(13)) - 1 .
      850     do i = 1 to n :
      851       ipos = index( start-text, chr(13)).
      852       if ipos > 0 then
      853         substring( start-text, ipos, 1 ) = ' '.
      854     end.
      855     if index( start-text, '"' ) = 0 then
      856       start-text =  '"'   + trim( start-text) + '"'   .
      857       else do:
      858         n = num-entries(trim(start-text), '"') - 1.
      859         do i = 1 to n :
      860           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      861         end.
      862         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      863         start-text = '"'  + ch  + '"' .
      864       end.
      865     n = num-entries(trim(start-text), chr(10)) - 1 .
      866     do i = 1 to n :
      867       ipos = index( start-text, chr(10)).
      868       if ipos > 0 then
      869         substring( start-text, ipos , 1 ) = ' '.
      870     end.
      871       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
      872     return start-text.
      873   end.
      874   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      875   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      876   procedure paramls-clear :
      877     define buffer buf_temp-param for temp-param .
      878     do
      879     on error undo, return error return-value
      880     :
      881       for each buf_temp-param
      882       on error undo, return error
      883       :
      884         delete buf_temp-param .
      885       end.
      886     end.
      887   end procedure.
      888   procedure paramls-write :
      889     define input  parameter p-code     as character no-undo .
      890     define input  parameter p-sub-code as character no-undo .
      891     define input  parameter p-value    as character no-undo .
      892     define buffer buf_temp-param for temp-param .
      893     do
      894     on error undo, return error return-value
      895     :
      896       find first buf_temp-param
      897         where buf_temp-param.param-code     = p-code
      898           and buf_temp-param.param-sub-code = p-sub-code
      899         no-error .
      900       if not available buf_temp-param then do:
      901         create buf_temp-param .
      902         assign
      903           buf_temp-param.param-code     = p-code
      904           buf_temp-param.param-sub-code = p-sub-code
      905         .
      906       end.
      907       assign
      908         buf_temp-param.param-value = p-value
      909       .
      910     end.
      911   end procedure.
      912   procedure paramls-read :
      913     define input  parameter p-code          as character no-undo .
      914     define input  parameter p-sub-code      as character no-undo .
      915     define input  parameter p-default-value as character no-undo .
      916     define output parameter p-value         as character no-undo .
      917     define buffer buf_temp-param for temp-param .
      918     do
      919     on error undo, return error return-value
      920     :
      921       find first buf_temp-param
      922         where buf_temp-param.param-code     = p-code
      923           and buf_temp-param.param-sub-code = p-sub-code
      924         no-error .
      925       if available buf_temp-param then do:
      926         assign
      927           p-value = buf_temp-param.param-value
      928         .
      929       end.
      930       else do:
      931         assign
      932           p-value = p-default-value
      933         .
      934       end.
      935     end.
      936   end procedure.
      937   procedure paramls-append :
      938     define input  parameter p-code     as character no-undo .
      939     define input  parameter p-sub-code as character no-undo .
      940     define input  parameter p-value    as character no-undo .
      941     define buffer buf_temp-param for temp-param .
      942     do
      943     on error undo, return error return-value
      944     :
      945       find first buf_temp-param
      946            where buf_temp-param.param-code     = p-code
      947              and buf_temp-param.param-sub-code = p-sub-code
      948         no-error .
      949       if not available buf_temp-param then do:
      950         create buf_temp-param .
      951         assign
      952           buf_temp-param.param-code     = p-code
      953           buf_temp-param.param-sub-code = p-sub-code
      954           buf_temp-param.param-value    = p-value
      955         .
      956       end.
      957       else do:
      958           assign
      959               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      960           .
      961       end.
      962     end.
      963   end procedure.
      964   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
      965   def var vss-author      as character no-undo init "$Author: expertek $":U .
