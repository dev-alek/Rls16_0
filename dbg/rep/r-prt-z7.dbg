     7247      if Make-Excel then  put   stream ForExcel unformatted  obj-list.obj-name chr(10).
     7248     end.
     7249             n-nn = 0.
     7250             n-no = n-no + 1 .
     7251   .
     7252    For Each gds-obj where
     7253             gds-obj.obj-code    = obj-list.obj-code and
     7254             gds-obj.obj-type    = obj-list.obj-type
     7255             no-lock,
     7256             first goods where
     7257                   goods.prod-type = gds-obj.prod-type and
     7258                   goods.prod-code = gds-obj.prod-code and
     7259                   goods.artic     = gds-obj.artic  and
     7260                   goods.gds-type    = 'т':U
     7261                                 no-lock
     7262             , first gds-list where
     7263                     gds-list.prod-type =  gds-obj.prod-type and
     7264                     gds-list.prod-code =  gds-obj.prod-code and
     7265                     gds-list.artic     =  gds-obj.artic
     7266                     no-lock
     7267               break
     7268                   by goods.grp-name by ( gds-obj.artic + gds-obj.prod-type + string ( gds-obj.prod-code ))
     7269                   by gds-obj.artic
     7270                   with FRAME Zapas :
     7271                        pr-cursor = 0.
     7272                        go-work = false.
     7273                        if v-prizn = "" then do:
     7274                           go-work = true.
     7275                        end.
     7276                        else do:
     7277                             if goods.prt-root <> Prtroot then
     7278                             do while pr-cursor < num-entries(v-prizn,","):
     7279                             pr-cursor = pr-cursor + 1.
     7280                                 if entry(pr-cursor,v-prizn,",") <> "" then do:
     7281                                     for first prt-obj where
     7282                                     prt-obj.artic     = goods.artic     and
     7283                                     prt-obj.prod-type = goods.prod-type and
     7284                                     prt-obj.prod-code = goods.prod-code and
     7285                                     prt-obj.obj-code  = obj-list.obj-code and
     7286                                     prt-obj.obj-type  = obj-list.obj-type and
     7287                                     prt-obj.is-term   =  true  and
     7288                                     prt-obj.prt-code  = integer(entry(pr-cursor,v-prizn,","))
     7289                                     no-lock:
     7290                                         pr-cursor = num-entries(v-prizn,",").
     7291                                         go-work = true.
     7292                                         v-tmp-prt = integer(entry(pr-cursor,v-prizn,",")).
     7293                                     end.
     7294                                 end.
     7295                             end.
     7296                         end.
     7297                   if go-work then do:
     7298                   n-nm = n-nm + 1.
     7299   IF ( n-nm modulo v-account = 0 )  then DO:
     7300             if  log-manager:logfile-name ne ?
     7301             then DO:
     7302                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     7303             end.
     7304              if mFrameView
     7305              then do:
     7306               DISPLAY
     7307                 n-nm @ RecordsDone
     7308                 WITH FRAME InfoFrame.
     7309              end.
     7310   End.
     7311      if v-button-stop then  DO:
     7312            if mFrameView
     7313            then
     7314               PROCESS EVENTS.
     7315            IF StopProcessing THEN DO:
     7316            RETURN error.
     7317            End.
     7318      end.
     7319                   IF first-of(gds-obj.artic) then DO:
     7320                   assign
     7321                     f-qnty         = 0
     7322                     f-cost-sum     = 0
     7323                     f-sale-sum     = 0
     7324                     f-cost-pr      = 0
     7325                     f-sale-pr      = 0
     7326                     f-sale-other   = 0
     7327                     f-free-qnty    = 0
     7328                     f-wait-qnty    = 0
     7329                     f-rez-qnty     = 0
     7330                     f-rez-cost     = 0
     7331                     f-rez-sale     = 0
     7332                     f-rez-cost-pr  = 0
     7333                     tot-v-sale-sum = 0
     7334                     tot-v-cost-sum = 0
     7335                     .
     7336                   End.
     7337             if first-of(goods.grp-name) then  DO:
     7338                var-client = goods.grp-name.
     7339                     if  Itog = false Then do:
     7340                       PUT stream OutStream  goods.grp-name  AT 1 format "X(160)" SKIP.
     7341                       DOWN stream OutStream .
     7342                       if Make-Excel then  put   stream ForExcel unformatted goods.grp-name chr(10) .
     7343                     End.
     7344             End.
     7345   if last-of(gds-obj.artic) then DO:
     7346    IF v-var = "no-today" then DO:
     7347                  RUN ost-line in this-procedure
     7348                  (
     7349                   input   gds-obj.obj-code  ,
     7350                   input   gds-obj.obj-type  ,
     7351                   INPUT   gds-obj.artic     ,
     7352                   INPUT   gds-obj.prod-code ,
     7353                   INPUT   gds-obj.prod-type ,
     7354                   input   0                 ,
     7355                   INPUT   fact-order-2      ,
     7356                   input   'crsa':U       ,
     7357                   input   '##,##':U    ,
     7358                   input   yes               ,
     7359                   output  Quantity1         ,
     7360                   output  Coast_R1          ,
     7361                   output  Coast_V1          ,
     7362                   output  VAT_R1            ,
     7363                   output  VAT_V1            ,
     7364                   output  SLT_R1            ,
     7365                   output  SLT_V1            ).
     7366                Assign
     7367                   f-qnty       = Quantity1
     7368                   f-sale-sum   = if tprintrubl then Coast_R1 else Coast_V1
     7369                   f-sale-pr    = if f-qnty = 0 then 0 else f-sale-sum / f-qnty
     7370                   .
     7371                  RUN ost-line in this-procedure
     7372                  (
     7373                   input   gds-obj.obj-code  ,
     7374                   input   gds-obj.obj-type  ,
     7375                   INPUT   gds-obj.artic     ,
     7376                   INPUT   gds-obj.prod-code ,
     7377                   INPUT   gds-obj.prod-type ,
     7378                   input   0                 ,
     7379                   INPUT   fact-order-2      ,
     7380                   input   'cost':U       ,
     7381                   input   '##,##':U    ,
     7382                   input   yes      ,
     7383                   output  Quantity1   ,
     7384                   output  Coast_R1  ,
     7385                   output  Coast_V1  ,
     7386                   output  VAT_R1    ,
     7387                   output  VAT_V1    ,
     7388                   output  SLT_R1    ,
     7389                   output  SLT_V1    ).
     7390                Assign
     7391                   f-cost-sum   = if tprintrubl then Coast_R1 else Coast_V1
     7392                   f-cost-pr    = if Quantity1 = 0 then 0 else ( f-cost-sum / Quantity1 )
     7393                   .
     7394   end.
     7395   else do:
     7396        if v-prizn <> "" and goods.prt-root <> Prtroot then do:
     7397           pr-cursor = 0.
     7398                    f-qnty = 0.
     7399            do while pr-cursor < num-entries(v-prizn,","):
     7400                pr-cursor = pr-cursor + 1.
     7401                if entry(pr-cursor,v-prizn,",") <> "" then do:
     7402                    for each prt-obj no-lock where prt-obj.prt-code = integer(entry(pr-cursor,v-prizn,","))
     7403                    and prt-obj.artic = gds-obj.artic
     7404                    and prt-obj.obj-code = gds-obj.obj-code
     7405                    and prt-obj.obj-type = gds-obj.obj-type
     7406                    and prt-obj.is-term   =  true
     7407                    :
     7408                    assign
     7409                       f-qnty       =  f-qnty + prt-obj.fact-qnty
     7410                       f-cost-sum   = f-cost-sum + if gds-obj.fact-qnty = 0 then 0 else prt-obj.fact-qnty * determined(gds-obj.fact-rubl) / gds-obj.fact-qnty
     7411                       f-sale-sum   = f-sale-sum + if gds-obj.fact-qnty = 0 then 0 else prt-obj.fact-qnty * gds-obj.fact-sale / gds-obj.fact-qnty
     7412                       f-free-qnty  = f-free-qnty + prt-obj.free-qnty
     7413                       f-cost-pr   = if prt-obj.fact-qnty  = 0 then 0 else determined(gds-obj.fact-rubl) / gds-obj.fact-qnty
     7414                       f-sale-pr   = if prt-obj.fact-qnty  = 0 then 0 else prt-obj.price-sale
     7415                       .
     7416                    end.
     7417                end.
     7418            end.
     7419        end.
     7420        else do:
     7421            Assign
     7422               f-qnty       = gds-obj.fact-qnty
     7423               f-cost-sum   = determined(gds-obj.fact-rubl)
     7424               f-sale-sum   = gds-obj.fact-sale
     7425               f-free-qnty  = gds-obj.free-qnty
     7426               f-cost-pr   = if f-qnty = 0 then 0 else f-cost-sum / f-qnty
     7427               f-sale-pr   = if f-qnty = 0 then 0 else f-sale-sum / f-qnty
     7428             .
     7429         end.
     7430        end.
     7431                 if c-f-rez-qnty     <> ? or
     7432                    c-f-rez-cost     <> ? or
     7433                    c-f-rez-sale     <> ? then do:
     7434                    empty temp-table t-trn-doc .
     7435                    empty temp-table temp_gds-dtl .
     7436                         for each buf_parts no-lock where
     7437                                  buf_parts.artic      = gds-obj.artic       and
     7438                                  buf_parts.prod-type  = gds-obj.prod-type   and
     7439                                  buf_parts.prod-code  = gds-obj.prod-code   and
     7440                                  buf_parts.obj-type   = gds-obj.obj-type    and
     7441                                  buf_parts.obj-code   = gds-obj.obj-code    and
     7442                                  buf_parts.status_    = false               and
     7443                                  buf_parts.rsrv-free  = true    ,
     7444                           first bufi_trn-doc no-lock where
     7445                                 bufi_trn-doc.doc-code = buf_parts.out-code
     7446                                 and
     7447                               ( bufi_trn-doc.doc-type = 'рас':U or
     7448                                 bufi_trn-doc.doc-type = 'спи':U )
     7449                                 :
     7450                                 if not can-find( first t-trn-doc where t-trn-doc.doc-code = bufi_trn-doc.doc-code) then do:
     7451                                     create t-trn-doc.
     7452                                     assign
     7453                                     t-trn-doc.doc-code = bufi_trn-doc.doc-code .
     7454                   .
     7455   end.
     7456                             end.
     7457                             for each t-trn-doc :
     7458                                 for each  bufd_gds-dtl no-lock where
     7459                                           bufd_gds-dtl.doc-code   = t-trn-doc.doc-code  and
     7460                                           bufd_gds-dtl.artic      = gds-obj.artic       and
     7461                                           bufd_gds-dtl.prod-type  = gds-obj.prod-type   and
     7462                                           bufd_gds-dtl.prod-code  = gds-obj.prod-code ,
     7463                                     first buff_doc-line no-lock where
     7464                                           buff_doc-line.doc-code   = bufd_gds-dtl.doc-code  and
     7465                                           buff_doc-line.artic      = bufd_gds-dtl.artic     and
     7466                                           buff_doc-line.prod-type  = bufd_gds-dtl.prod-type and
     7467                                           buff_doc-line.prod-code  = bufd_gds-dtl.prod-code
     7468                                           :
     7469                                           assign
     7470                                             f-rez-qnty = f-rez-qnty  + bufd_gds-dtl.doc-qnty
     7471                                             f-rez-cost = f-rez-cost  + ( bufd_gds-dtl.doc-qnty * buff_doc-line.price-rubl )
     7472                                             f-rez-sale = f-rez-sale  + ( bufd_gds-dtl.doc-qnty * bufd_gds-dtl.price-rubl )
     7473                                             f-rez-cost-pr = ( if f-rez-qnty = 0 then 0 else f-rez-cost / f-rez-qnty )
     7474                                           .
     7475                                           create temp_gds-dtl.
     7476                                           buffer-copy bufd_gds-dtl to temp_gds-dtl
     7477                                           assign
     7478                                              temp_gds-dtl.cost-sum = bufd_gds-dtl.doc-qnty * buff_doc-line.price-rubl
     7479                                              temp_gds-dtl.sale-sum = bufd_gds-dtl.doc-qnty * bufd_gds-dtl.price-rubl
     7480                                           .
     7481                                 end.
     7482                            end.
     7483                 end.
     7484                 f-sale-other = 100 * determined((f-sale-sum - f-cost-sum) / f-cost-sum).
     7485                 if c-f-wait-qnty <> ? Then DO :
     7486                   for each trn-doc no-lock  where
     7487                       trn-doc.obj-code        = obj-list.obj-code and
     7488                       trn-doc.obj-type        = obj-list.obj-type and
     7489                       trn-doc.status_         = 'накл':U           and
     7490                       trn-doc.flag_           = true              and
     7491                       trn-doc.Fact-order      <= fact-order-2     and
     7492                       trn-doc.ext-doc-type    = 'ie':U :
     7493                       for each doc-line no-lock where
     7494                           doc-line.doc-code   = trn-doc.doc-code   and
     7495                           doc-line.artic      = goods.artic        and
     7496                           doc-line.prod-code  = goods.prod-code    and
     7497                           doc-line.prod-type  = goods.prod-type    :
     7498                               Assign
     7499                                 f-wait-qnty   = f-wait-qnty     + doc-line.fact-qnty.
     7500                       end.
     7501                   End.
     7502                 End.
     7503                if itog = false and
     7504                   ( p-zero-ost = true or
     7505                   not(f-qnty         = 0 and
     7506                       f-cost-sum     = 0 and
     7507                       f-sale-sum     = 0 and
     7508                       f-sale-other   = 0 and
     7509                       f-free-qnty    = 0 and
     7510                       f-wait-qnty    = 0  ))
     7511                   Then DO:
     7512                       n-nn = n-nn + 1 .
     7513   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
