     6543                                     create t-trn-doc.
     6544                                     assign
     6545                                     t-trn-doc.doc-code = bufi_trn-doc.doc-code .
     6546                   .
     6547   end.
     6548                             end.
     6549                             for each t-trn-doc :
     6550                                 for each  bufd_gds-dtl no-lock where
     6551                                           bufd_gds-dtl.doc-code   = t-trn-doc.doc-code  and
     6552                                           bufd_gds-dtl.artic      = gds-obj.artic       and
     6553                                           bufd_gds-dtl.prod-type  = gds-obj.prod-type   and
     6554                                           bufd_gds-dtl.prod-code  = gds-obj.prod-code ,
     6555                                     first buff_doc-line no-lock where
     6556                                           buff_doc-line.doc-code   = bufd_gds-dtl.doc-code  and
     6557                                           buff_doc-line.artic      = bufd_gds-dtl.artic     and
     6558                                           buff_doc-line.prod-type  = bufd_gds-dtl.prod-type and
     6559                                           buff_doc-line.prod-code  = bufd_gds-dtl.prod-code
     6560                                           :
     6561                                           assign
     6562                                             f-rez-qnty = f-rez-qnty  + bufd_gds-dtl.doc-qnty
     6563                                             f-rez-cost = f-rez-cost  + ( bufd_gds-dtl.doc-qnty * buff_doc-line.price-rubl )
     6564                                             f-rez-sale = f-rez-sale  + ( bufd_gds-dtl.doc-qnty * bufd_gds-dtl.price-rubl )
     6565                                             f-rez-cost-pr = ( if f-rez-qnty = 0 then 0 else f-rez-cost / f-rez-qnty )
     6566                                           .
     6567                                           create temp_gds-dtl.
     6568                                           buffer-copy bufd_gds-dtl to temp_gds-dtl
     6569                                           assign
     6570                                              temp_gds-dtl.cost-sum = bufd_gds-dtl.doc-qnty * buff_doc-line.price-rubl
     6571                                              temp_gds-dtl.sale-sum = bufd_gds-dtl.doc-qnty * bufd_gds-dtl.price-rubl
     6572                                           .
     6573                                 end.
     6574                            end.
     6575                 end.
     6576                 f-sale-other = 100 * determined((f-sale-sum - f-cost-sum) / f-cost-sum).
     6577                 if c-f-wait-qnty <> ? Then DO :
