     5678           pr-cursor = 0.
     5679                    f-qnty = 0.
     5680            do while pr-cursor < num-entries(v-prizn,","):
     5681                pr-cursor = pr-cursor + 1.
     5682                if entry(pr-cursor,v-prizn,",") <> "" then do:
     5683                    for each prt-obj no-lock where prt-obj.prt-code = integer(entry(pr-cursor,v-prizn,","))
     5684                    and prt-obj.artic = gds-obj.artic
     5685                    and prt-obj.obj-code = gds-obj.obj-code
     5686                    and prt-obj.obj-type = gds-obj.obj-type
     5687                    and prt-obj.is-term   =  true
     5688                    :
     5689                    assign
     5690                       f-qnty       =  f-qnty + prt-obj.fact-qnty
     5691                       f-cost-sum   = f-cost-sum + if gds-obj.fact-qnty = 0 then 0 else prt-obj.fact-qnty * determined(gds-obj.fact-rubl) / gds-obj.fact-qnty
     5692                       f-sale-sum   = f-sale-sum + if gds-obj.fact-qnty = 0 then 0 else prt-obj.fact-qnty * gds-obj.fact-sale / gds-obj.fact-qnty
     5693                       f-free-qnty  = f-free-qnty + prt-obj.free-qnty
     5694                       f-cost-pr   = if prt-obj.fact-qnty  = 0 then 0 else determined(gds-obj.fact-rubl) / gds-obj.fact-qnty
     5695                       f-sale-pr   = if prt-obj.fact-qnty  = 0 then 0 else prt-obj.price-sale
     5696                       .
     5697                    end.
     5698                end.
     5699            end.
     5700        end.
     5701        else do:
     5702            Assign
     5703               f-qnty       = gds-obj.fact-qnty
     5704               f-cost-sum   = determined(gds-obj.fact-rubl)
     5705               f-sale-sum   = gds-obj.fact-sale
     5706               f-free-qnty  = gds-obj.free-qnty
     5707               f-cost-pr   = if f-qnty = 0 then 0 else f-cost-sum / f-qnty
     5708               f-sale-pr   = if f-qnty = 0 then 0 else f-sale-sum / f-qnty
     5709             .
     5710         end.
     5711        end.
     5712                 if c-f-rez-qnty     <> ? or
     5713                    c-f-rez-cost     <> ? or
     5714                    c-f-rez-sale     <> ? then do:
     5715                    empty temp-table t-trn-doc .
     5716                    empty temp-table temp_gds-dtl .
     5717                         for each buf_parts no-lock where
     5718                                  buf_parts.artic      = gds-obj.artic       and
     5719                                  buf_parts.prod-type  = gds-obj.prod-type   and
     5720                                  buf_parts.prod-code  = gds-obj.prod-code   and
     5721                                  buf_parts.obj-type   = gds-obj.obj-type    and
     5722                                  buf_parts.obj-code   = gds-obj.obj-code    and
     5723                                  buf_parts.status_    = false               and
     5724                                  buf_parts.rsrv-free  = true    ,
     5725                           first bufi_trn-doc no-lock where
     5726                                 bufi_trn-doc.doc-code = buf_parts.out-code
     5727                                 and
     5728                               ( bufi_trn-doc.doc-type = 'рас':U or
     5729                                 bufi_trn-doc.doc-type = 'спи':U )
     5730                                 :
     5731                                 if not can-find( first t-trn-doc where t-trn-doc.doc-code = bufi_trn-doc.doc-code) then do:
     5732                                     create t-trn-doc.
     5733                                     assign
     5734                                     t-trn-doc.doc-code = bufi_trn-doc.doc-code .
     5735                   .
     5736   end.
     5737                             end.
     5738                             for each t-trn-doc :
     5739                                 for each  bufd_gds-dtl no-lock where
     5740                                           bufd_gds-dtl.doc-code   = t-trn-doc.doc-code  and
     5741                                           bufd_gds-dtl.artic      = gds-obj.artic       and
     5742                                           bufd_gds-dtl.prod-type  = gds-obj.prod-type   and
     5743                                           bufd_gds-dtl.prod-code  = gds-obj.prod-code ,
     5744                                     first buff_doc-line no-lock where
     5745                                           buff_doc-line.doc-code   = bufd_gds-dtl.doc-code  and
     5746                                           buff_doc-line.artic      = bufd_gds-dtl.artic     and
     5747                                           buff_doc-line.prod-type  = bufd_gds-dtl.prod-type and
     5748                                           buff_doc-line.prod-code  = bufd_gds-dtl.prod-code
     5749                                           :
     5750                                           assign
     5751                                             f-rez-qnty = f-rez-qnty  + bufd_gds-dtl.doc-qnty
     5752                                             f-rez-cost = f-rez-cost  + ( bufd_gds-dtl.doc-qnty * buff_doc-line.price-rubl )
     5753                                             f-rez-sale = f-rez-sale  + ( bufd_gds-dtl.doc-qnty * bufd_gds-dtl.price-rubl )
     5754                                             f-rez-cost-pr = ( if f-rez-qnty = 0 then 0 else f-rez-cost / f-rez-qnty )
     5755                                           .
     5756                                           create temp_gds-dtl.
     5757                                           buffer-copy bufd_gds-dtl to temp_gds-dtl
     5758                                           assign
     5759                                              temp_gds-dtl.cost-sum = bufd_gds-dtl.doc-qnty * buff_doc-line.price-rubl
     5760                                              temp_gds-dtl.sale-sum = bufd_gds-dtl.doc-qnty * bufd_gds-dtl.price-rubl
     5761                                           .
     5762                                 end.
     5763                            end.
     5764                 end.
     5765                 f-sale-other = 100 * determined((f-sale-sum - f-cost-sum) / f-cost-sum).
     5766                 if c-f-wait-qnty <> ? Then DO :
     5767                   for each trn-doc no-lock  where
     5768                       trn-doc.obj-code        = obj-list.obj-code and
     5769                       trn-doc.obj-type        = obj-list.obj-type and
     5770                       trn-doc.status_         = 'накл':U           and
     5771                       trn-doc.flag_           = true              and
     5772                       trn-doc.Fact-order      <= fact-order-2     and
     5773                       trn-doc.ext-doc-type    = 'ie':U :
     5774                       for each doc-line no-lock where
     5775                           doc-line.doc-code   = trn-doc.doc-code   and
     5776                           doc-line.artic      = goods.artic        and
     5777                           doc-line.prod-code  = goods.prod-code    and
     5778                           doc-line.prod-type  = goods.prod-type    :
     5779                               Assign
     5780                                 f-wait-qnty   = f-wait-qnty     + doc-line.fact-qnty.
     5781                       end.
     5782                   End.
     5783                 End.
     5784                if itog = false and
     5785                   ( p-zero-ost = true or
     5786                   not(f-qnty         = 0 and
     5787                       f-cost-sum     = 0 and
     5788                       f-sale-sum     = 0 and
     5789                       f-sale-other   = 0 and
     5790                       f-free-qnty    = 0 and
     5791                       f-wait-qnty    = 0  ))
