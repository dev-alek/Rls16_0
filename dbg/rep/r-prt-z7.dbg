     9576       define variable out-vatp-have-vat-slt-prl    as   logical initial yes                 no-undo.
     9577       define buffer   in-vatp-trn-doco-prl  for ub.trn-doc .
     9578       define buffer   in-vatp-partso-prl    for ub.parts   .
     9579       define buffer   in-vatp-doco-prl      for ub.trn-doc .
     9580       define buffer   in-vatp-goodso-prl    for ub.goods   .
