     5641                   output  Coast_R1          ,
     5642                   output  Coast_V1          ,
     5643                   output  VAT_R1            ,
     5644                   output  VAT_V1            ,
     5645                   output  SLT_R1            ,
     5646                   output  SLT_V1            ).
     5647                Assign
     5648                   f-qnty       = Quantity1
     5649                   f-sale-sum   = if tprintrubl then Coast_R1 else Coast_V1
     5650                   f-sale-pr    = if f-qnty = 0 then 0 else f-sale-sum / f-qnty
     5651                   .
     5652                  RUN ost-line in this-procedure
     5653                  (
     5654                   input   gds-obj.obj-code  ,
     5655                   input   gds-obj.obj-type  ,
     5656                   INPUT   gds-obj.artic     ,
