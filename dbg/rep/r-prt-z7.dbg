      808   procedure proc-alt-shift-f2:
      809     if not ibs.th.gbl.gbl-var:rcode
      810   then
      811     run gbl\inidebug.p .
      812   end.
      813   procedure proc-alt-shift-f3:
      814     run gbl/prvssinf.p
      815       ( input this-procedure
      816       ) .
      817   end.
      818   define variable v-inform-launched as logical no-undo initial false .
      819   procedure proc-alt-shift-f4:
      820     define variable v-action as character no-undo .
      821     if v-inform-launched = false then do:
      822       assign
      823         v-inform-launched = true
      824       .
      825       run gbl/d-inform.w
      826         (  input self
      827         ,  input this-procedure
      828         , output v-action
      829         ) no-error .
      830       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      831       assign
      832         v-inform-launched = false
      833       .
      834     end.
      835   end.
      836   procedure proc-alt-f1:
      837     run gbl/corrhelp.p
      838       (input this-procedure
      839       ) .
      840   end .
