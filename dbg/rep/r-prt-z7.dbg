     5626   if last-of(gds-obj.artic) then DO:
     5627    IF v-var = "no-today" then DO:
     5628                  RUN ost-line in this-procedure
     5629                  (
     5630                   input   gds-obj.obj-code  ,
     5631                   input   gds-obj.obj-type  ,
     5632                   INPUT   gds-obj.artic     ,
