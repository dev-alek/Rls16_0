     6331      if Make-Excel then  put   stream ForExcel unformatted  obj-list.obj-name chr(10).
     6332     end.
     6333             n-nn = 0.
     6334             n-no = n-no + 1 .
     6335   .
     6336    For Each gds-obj where
     6337             gds-obj.obj-code    = obj-list.obj-code and
     6338             gds-obj.obj-type    = obj-list.obj-type
     6339             no-lock,
     6340             first goods where
     6341                   goods.prod-type = gds-obj.prod-type and
     6342                   goods.prod-code = gds-obj.prod-code and
     6343                   goods.artic     = gds-obj.artic  and
     6344                   goods.gds-type    = 'т':U
     6345                                 no-lock
     6346             , first gds-list where
     6347                     gds-list.prod-type =  gds-obj.prod-type and
     6348                     gds-list.prod-code =  gds-obj.prod-code and
     6349                     gds-list.artic     =  gds-obj.artic
     6350                     no-lock
     6351               break
     6352                   by gds-obj.prod-type By gds-obj.prod-code by gds-obj.artic
     6353                   with FRAME Zapas :
     6354                        pr-cursor = 0.
     6355                        go-work = false.
     6356                        if v-prizn = "" then do:
     6357                           go-work = true.
     6358                        end.
     6359                        else do:
     6360                             if goods.prt-root <> Prtroot then
     6361                             do while pr-cursor < num-entries(v-prizn,","):
     6362                             pr-cursor = pr-cursor + 1.
     6363                                 if entry(pr-cursor,v-prizn,",") <> "" then do:
     6364                                     for first prt-obj where
     6365                                     prt-obj.artic     = goods.artic     and
     6366                                     prt-obj.prod-type = goods.prod-type and
     6367                                     prt-obj.prod-code = goods.prod-code and
     6368                                     prt-obj.obj-code  = obj-list.obj-code and
     6369                                     prt-obj.obj-type  = obj-list.obj-type and
     6370                                     prt-obj.is-term   =  true  and
     6371                                     prt-obj.prt-code  = integer(entry(pr-cursor,v-prizn,","))
     6372                                     no-lock:
     6373                                         pr-cursor = num-entries(v-prizn,",").
     6374                                         go-work = true.
     6375                                         v-tmp-prt = integer(entry(pr-cursor,v-prizn,",")).
     6376                                     end.
     6377                                 end.
     6378                             end.
     6379                         end.
     6380                   if go-work then do:
     6381                   n-nm = n-nm + 1.
     6382   IF ( n-nm modulo v-account = 0 )  then DO:
     6383             if  log-manager:logfile-name ne ?
     6384             then DO:
     6385                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     6386             end.
     6387              if mFrameView
     6388              then do:
     6389               DISPLAY
     6390                 n-nm @ RecordsDone
     6391                 WITH FRAME InfoFrame.
     6392              end.
     6393   End.
     6394      if v-button-stop then  DO:
     6395            if mFrameView
     6396            then
     6397               PROCESS EVENTS.
     6398            IF StopProcessing THEN DO:
     6399            RETURN error.
     6400            End.
     6401      end.
     6402                   IF first-of(gds-obj.artic) then DO:
     6403                   assign
     6404                     f-qnty         = 0
     6405                     f-cost-sum     = 0
     6406                     f-sale-sum     = 0
     6407                     f-cost-pr      = 0
     6408                     f-sale-pr      = 0
     6409                     f-sale-other   = 0
     6410                     f-free-qnty    = 0
     6411                     f-wait-qnty    = 0
     6412                     f-rez-qnty     = 0
     6413                     f-rez-cost     = 0
     6414                     f-rez-sale     = 0
     6415                     f-rez-cost-pr  = 0
     6416                     tot-v-sale-sum = 0
     6417                     tot-v-cost-sum = 0
     6418                     .
     6419                   End.
     6420             if first-of(gds-obj.prod-code)  and classify = 2 then DO:
     6421                 FIND FIRST clients-p where  gds-obj.prod-type = clients-p.obj-type AND
     6422                                             gds-obj.prod-code = clients-p.obj-code no-lock no-error.
     6423                  if avail clients-p then var-client = Clients-p.obj-name.
     6424                     if  Itog = false Then do:
     6425     if c-f-gds-name <>  ?  then do :
     6426       c-f-gds-name:screen-value = string(var-client) .
     6427       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6428           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6429           display STREAM OutStream    with frame top-frame .
