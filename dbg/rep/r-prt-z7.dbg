     8910   procedure display-prt :
     8911   define variable pr-cursor as integer no-undo init 0.
     8912   define variable go-work   as logical no-undo init no.
     8913   define variable v-tmp-prt like gds-prt.node-code init -1.
     8914   IF goods.prt-root <> Prtroot Then DO:
     8915       If v-var = "no-today"  then do:
     8916   run  prdoclib-init-prt-obj-by-factord in this-procedure
     8917   ( input gds-obj.obj-type  ,
     8918     input gds-obj.obj-code  ,
     8919     input gds-obj.artic     ,
     8920     input gds-obj.prod-type ,
     8921     input gds-obj.prod-code ,
     8922     input fact-order-2 ,
     8923     input false ) .
     8924       end.
     8925     for each prt-obj where
     8926         prt-obj.artic     = goods.artic     and
     8927         prt-obj.prod-type = goods.prod-type and
     8928         prt-obj.prod-code = goods.prod-code and
     8929         prt-obj.obj-code  = obj-list.obj-code and
     8930         prt-obj.obj-type  = obj-list.obj-type and
     8931         prt-obj.is-term   =  true no-lock
     8932         BREAK BY prt-obj.prt-code with FRAME Zapas :
     8933         pr-cursor = 0.
     8934         go-work = false.
     8935         if v-prizn = "" then do:
     8936           go-work = true.
     8937         end.
     8938         else do:
     8939             do while pr-cursor < num-entries(v-prizn,","):
     8940                 pr-cursor = pr-cursor + 1.
     8941                 if entry(pr-cursor,v-prizn,",") <> "" then do:
     8942                     if integer(entry(pr-cursor,v-prizn,",")) = prt-obj.prt-code then do:
     8943                         pr-cursor = num-entries(v-prizn,",").
     8944                         go-work = true.
     8945                     end.
     8946                 end.
     8947             end.
     8948         end.
     8949         if go-work then do:
     8950             if v-var <> "no-today" then do:
     8951                 Assign
     8952                   p-qnty      = p-qnty       + prt-obj.fact-qnty
     8953                   p-free-qnty = p-free-qnty  + prt-obj.free-qnty
     8954                   p-sale-sum  = p-sale-sum   + prt-obj.fact-qnty * prt-obj.price-sale
     8955                   p-sale-pr   = if p-qnty = 0 then 0 else p-sale-sum / p-qnty
     8956                   .
     8957             End.
     8958             IF last-of(prt-obj.prt-code) THEN DO:
     8959   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     8960     (input  gds-obj.gds-code
     8961     ,input  prt-obj.prt-code
     8962     ,output v-bar-code
     8963     )  .
     8964                 if v-var = "no-today" then do:
     8965                   find first temp-prt-obj no-lock
     8966                        where temp-prt-obj.prt-obj-recid   = recid (prt-obj) no-error .
     8967                        if avail temp-prt-obj then do :
     8968                           run  calc-price-sale-for-prt in this-procedure  (output v-price-sale) .
     8969                           Assign
     8970                             p-qnty      = temp-prt-obj.fact-qnty
     8971                             p-free-qnty = 0
     8972                             p-sale-sum  = temp-prt-obj.fact-qnty * v-price-sale
     8973                             p-sale-pr   = if p-qnty = 0 then 0 else p-sale-sum / p-qnty
     8974                             .
     8975                         End.
     8976                         Else
     8977                           Assign
     8978                             p-qnty      = 0
     8979                             p-free-qnty = 0
     8980                             p-sale-sum  = 0   .
     8981                 End.
     8982           FIND first gds-prt  where gds-prt.node-code = prt-obj.prt-code NO-LOCK no-error .
     8983           if c-f-wait-qnty <> ? Then DO :
     8984             for each trn-doc no-lock  where
     8985                 trn-doc.obj-code        = obj-list.obj-code and
     8986                 trn-doc.obj-type        = obj-list.obj-type and
     8987                 trn-doc.status_         = 'накл':U           and
     8988                 trn-doc.flag_           = true              and
     8989                 trn-doc.ext-doc-type    = 'ie':U :
     8990                 for each gds-dtl no-lock where
     8991                     gds-dtl.doc-code   = trn-doc.doc-code   and
     8992                     gds-dtl.artic      = goods.artic        and
     8993                     gds-dtl.prod-code  = goods.prod-code    and
     8994                     gds-dtl.prod-type  = goods.prod-type    and
     8995                     gds-dtl.prt-code   = prt-obj.prt-code   and
     8996                     gds-dtl.obj-code   = obj-list.obj-code  and
     8997                     gds-dtl.obj-type   = obj-list.obj-type :
     8998                     Assign
     8999                     p-wait-qnty   = p-wait-qnty     + gds-dtl.fact-qnty.
     9000                 end.
     9001             End.
     9002           End.
     9003           if ( f-rez-qnty <> ? or
     9004               f-rez-cost <> ? or
     9005               f-rez-sale <> ? ) and  v-var <> "no-today"
     9006           then do:
     9007                 for each temp_gds-dtl where
     9008                           temp_gds-dtl.prt-code   = prt-obj.prt-code  :
     9009                     assign
     9010                       p-rez-qnty = p-rez-qnty  + temp_gds-dtl.doc-qnty
     9011                       p-rez-cost = p-rez-cost  + temp_gds-dtl.cost-sum
     9012                       p-rez-sale = p-rez-sale  + temp_gds-dtl.sale-sum
     9013                       p-rez-cost-pr = ( if p-rez-qnty = 0 then 0 else p-rez-cost / p-rez-qnty )
     9014                     .
     9015                 end.
     9016           end.
     9017           Assign
     9018           p-cost-sum     = determined( f-cost-sum * p-qnty  / f-qnty)
     9019           p-sale-other   = 100 * determined((p-sale-sum - p-cost-sum) / p-cost-sum)
     9020           p-cost-pr      = if p-qnty = 0 then 0 else p-cost-sum   / p-qnty
     9021           .
     9022           if not (p-zero = false  and
     9023                (p-qnty        =  0  and
     9024                 p-cost-sum    =  0  and
     9025                 p-sale-sum    =  0  and
     9026                 p-sale-other  =  0  and
     9027                 p-free-qnty   =  0  and
     9028                     p-wait-qnty  = 0  ) ) then do:
     9029     if c-nn <>  ?  then do :
     9030       c-nn:screen-value = string('') .
     9031       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9032           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9033           display STREAM OutStream    with frame top-frame .
     9034       End.
     9035     End.
     9036     if c-f-artic <>  ?  then do :
     9037       c-f-artic:screen-value = string('') .
     9038       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9039           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9040           display STREAM OutStream    with frame top-frame .
     9041       End.
     9042     End.
     9043     if c-f-b-code <>  ?  then do :
     9044       c-f-b-code:screen-value = string(string(v-bar-code,'999999999')) .
     9045       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9046           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9047           display STREAM OutStream    with frame top-frame .
     9048       End.
     9049     End.
     9050     if c-f-prt-name <>  ?  then do :
     9051       c-f-prt-name:screen-value = string(gds-prt.f-name) .
     9052       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9053           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9054           display STREAM OutStream    with frame top-frame .
     9055       End.
     9056     End.
     9057     if c-f-qnty <>  ?  then do :
     9058       c-f-qnty:screen-value = string(p-qnty) .
     9059       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9060           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9061           display STREAM OutStream    with frame top-frame .
     9062       End.
     9063     End.
     9064     if c-f-cost-pr <>  ?  then do :
     9065       c-f-cost-pr:screen-value = string(p-cost-pr) .
     9066       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9067           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9068           display STREAM OutStream    with frame top-frame .
     9069       End.
     9070     End.
     9071     if c-f-cost-sum <>  ?  then do :
     9072       c-f-cost-sum:screen-value = string(p-cost-sum) .
     9073       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9074           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9075           display STREAM OutStream    with frame top-frame .
     9076       End.
     9077     End.
     9078     if c-f-sale-pr <>  ?  then do :
     9079       c-f-sale-pr:screen-value = string(p-sale-pr) .
     9080       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9081           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9082           display STREAM OutStream    with frame top-frame .
     9083       End.
     9084     End.
     9085     if c-f-sale-sum <>  ?  then do :
     9086       c-f-sale-sum:screen-value = string(p-sale-sum) .
     9087       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9088           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9089           display STREAM OutStream    with frame top-frame .
     9090       End.
     9091     End.
     9092     if c-f-sale-other <>  ?  then do :
     9093       c-f-sale-other:screen-value = string(p-sale-other) .
     9094       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9095           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9096           display STREAM OutStream    with frame top-frame .
     9097       End.
     9098     End.
     9099     if c-f-free-qnty <>  ?  then do :
     9100       c-f-free-qnty:screen-value = string(p-free-qnty) .
     9101       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9102           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9103           display STREAM OutStream    with frame top-frame .
     9104       End.
     9105     End.
     9106     if c-f-wait-qnty <>  ?  then do :
     9107       c-f-wait-qnty:screen-value = string(p-wait-qnty) .
     9108       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9109           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9110           display STREAM OutStream    with frame top-frame .
     9111       End.
     9112     End.
     9113     if c-f-rez-qnty <>  ?  then do :
     9114       c-f-rez-qnty:screen-value = string(p-rez-qnty) .
     9115       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9116           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9117           display STREAM OutStream    with frame top-frame .
     9118       End.
     9119     End.
     9120     if c-f-rez-cost <>  ?  then do :
     9121       c-f-rez-cost:screen-value = string(p-rez-cost) .
     9122       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9123           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9124           display STREAM OutStream    with frame top-frame .
     9125       End.
     9126     End.
     9127     if c-f-rez-sale <>  ?  then do :
     9128       c-f-rez-sale:screen-value = string(p-rez-sale) .
     9129       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9130           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9131           display STREAM OutStream    with frame top-frame .
     9132       End.
     9133     End.
     9134     if c-f-rez-cost-pr <>  ?  then do :
     9135       c-f-rez-cost-pr:screen-value = string(p-rez-cost-pr) .
     9136       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9137           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9138           display STREAM OutStream    with frame top-frame .
     9139       End.
     9140     End.
     9141               Display stream OutStream no-error.
     9142               DOWN stream OutStream .
     9143               if Make-Excel then  put   stream ForExcel unformatted
     9144               CHR(9)
     9145               string(v-bar-code,"999999999") CHR(9)
     9146                            CHR(9)
     9147                            CHR(9)
     9148                gds-prt.f-name                    CHR(9)
     9149                excel-qnty(p-qnty)                            CHR(9)
     9150                excel-sum(p-cost-pr)                        CHR(9)
     9151                excel-sum(p-cost-sum)                        CHR(9)
     9152                excel-sum(p-sale-pr)                        CHR(9)
     9153                excel-sum(p-sale-sum)                        CHR(9)
     9154                excel-sum(p-sale-other)                      CHR(9)
     9155                excel-sum(p-free-qnty)                       CHR(9)
     9156               excel-sum(p-wait-qnty)   CHR(9)
     9157               excel-sum(p-rez-qnty   ) CHR(9)
     9158               excel-sum(p-rez-cost   ) CHR(9)
     9159               excel-sum(p-rez-sale   ) CHR(9)
     9160               excel-sum(p-rez-cost-pr) CHR(9)
     9161               chr(10) .
     9162           End.
     9163           Assign
     9164             p-qnty        =  0
     9165             p-cost-sum    =  0
     9166             p-sale-sum    =  0
     9167             p-sale-other  =  0
     9168             p-free-qnty   =  0
     9169             p-wait-qnty   =  0
     9170             p-rez-qnty     = 0
     9171             p-rez-cost     = 0
     9172             p-rez-sale     = 0
     9173             p-rez-cost-pr  = 0
     9174             .
     9175       End.
     9176     End.
     9177     end.
     9178   End.
     9179   end procedure.
     9180   PROCEDURE on-same-page :
     9181     define input parameter p-line-number as integer  no-undo .
     9182     if p-line-number > page-size( OutStream ) then do:
     9183       return .
     9184     end.
     9185     if line-counter( OutStream ) + p-line-number > page-size( OutStream ) then do:
     9186       page stream OutStream .
     9187     end.
     9188   end procedure.
     9189   PROCEDURE ostatok :
     9190   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     9191   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     9192   def input parameter x-tog-shift   as   logical             no-undo.
     9193   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     9194   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     9195   def input parameter x-shift-start as integer               no-undo.
     9196   def input parameter x-shift-end   as integer               no-undo.
     9197   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     9198   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     9199   def input parameter xTog-obj   as log no-undo.
     9200   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     9201   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     9202   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     9203   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     9204   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     9205   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     9206   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     9207   def var              Fact-orderS   as char  no-undo.
     9208   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     9209      Assign
     9210         Fact-order   = 0
     9211         Quantity     = 0
     9212         Coast_R      = 0
     9213         Coast_V      = 0
     9214         VAT_R        = 0
     9215         VAT_V        = 0 .
     9216    x-date-start-t  = x-date-start + 1 .
     9217   IF x-date-end = date('') then DO:
     9218      Fact-order = 0 .
     9219      for each obj-list
     9220          where  ( not xtog-obj or
     9221                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     9222                 no-lock :
     9223         if  x-tog-shift = false then do:
     9224                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     9225                               ub.stk-tot.Fact-date <=  x-date-start
     9226                               and ub.stk-tot.shift-num = 0
     9227                               USE-INDEX fact-date no-lock no-error .
     9228              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     9229         End.
     9230         Else  DO :
     9231             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     9232              (ub.stk-tot.shift-date  = x-date-start-t and
     9233               ub.stk-tot.shift-num  < x-shift-start or
     9234               ub.stk-tot.shift-date  < x-date-start-t  )
     9235               and ub.stk-tot.shift-num  > 0
     9236               USE-INDEX Shift-num no-lock no-error .
     9237            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     9238           END.
     9239       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     9240     End.
     9241   End.
     9242   Else DO:
     9243     For each obj-list  WHERE
     9244        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     9245         no-lock :
     9246      IF  x-TOG-Shift = False Then DO:
     9247          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     9248               ub.stk-tot.Fact-date <= x-date-end
     9249               and ub.stk-tot.shift-num = 0
     9250               USE-INDEX fact-date no-lock no-error.
     9251          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     9252      END.
     9253      Else DO:
     9254           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     9255               (ub.stk-tot.shift-date  = x-date-end and
     9256               ub.stk-tot.shift-num  <= x-shift-end or
     9257               ub.stk-tot.shift-date  < x-date-end       ) and
     9258               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     9259               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     9260       End.
     9261       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     9262     End.
     9263   End.
     9264   END PROCEDURE.
     9265   procedure ost-line :
     9266     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     9267     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     9268     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     9269     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     9270     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     9271     define input  parameter x-tog-shift  as logical no-undo .
     9272     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     9273     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     9274     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     9275     define input  parameter xtog-obj     as logical no-undo .
     9276     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     9277     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     9278     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     9279     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     9280     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     9281     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     9282     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     9283     define buffer buff-obj-list  for obj-list .
     9284     define buffer buff-stk-line  for ub.stk-line .
     9285     assign
     9286       Quantity = 0
     9287       Coast_R  = 0
     9288       Coast_V  = 0
     9289       VAT_R    = 0
     9290       VAT_V    = 0
     9291       SLT_R    = 0
     9292       SLT_V    = 0
     9293     .
     9294     if  x-tog-shift = false then do:
     9295       for each buff-obj-list no-lock
     9296         where xtog-obj = false
     9297            or (buff-obj-list.obj-type = x-store-type
     9298               and buff-obj-list.obj-code = x-store-code
     9299               )
     9300       on error undo, return error
     9301       :
     9302       find last buff-stk-line no-lock
     9303         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     9304           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     9305           and buff-stk-line.artic      = x-artic
     9306           and buff-stk-line.prod-type  = x-prod-type
     9307           and buff-stk-line.prod-code  = x-prod-code
     9308           and buff-stk-line.sum-type   = x-sum-type
     9309           and buff-stk-line.cat-id     = '##,##':U
     9310           and buff-stk-line.fact-order <= x-fact-order
     9311           and buff-stk-line.shift-num  = 0
     9312         use-index category
     9313         no-error .
     9314       if available buff-stk-line then do:
     9315         assign
     9316           Quantity = Quantity + buff-stk-line.fact-qnty
     9317           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     9318           Coast_V  = Coast_V  + buff-stk-line.sum-base
     9319           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     9320           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     9321           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     9322           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     9323         .
     9324       end.
     9325      end.
     9326     end.
     9327     else do:
     9328       for each buff-obj-list no-lock
     9329         where xtog-obj = false
     9330            or (buff-obj-list.obj-type = x-store-type
     9331               and buff-obj-list.obj-code = x-store-code
     9332               )
     9333       on error undo, return error
     9334       :
     9335         find last buff-stk-line no-lock
     9336           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     9337             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     9338             and buff-stk-line.artic      = x-artic
     9339             and buff-stk-line.prod-type  = x-prod-type
     9340             and buff-stk-line.prod-code  = x-prod-code
     9341             and buff-stk-line.sum-type   = x-sum-type
     9342             and buff-stk-line.cat-id     = '##,##':U
     9343             and buff-stk-line.fact-order <= x-fact-order
     9344             and buff-stk-line.shift-num  > 0
     9345           use-index category
     9346           no-error .
     9347         if available buff-stk-line then do:
     9348           assign
     9349             Quantity = Quantity +  buff-stk-line.fact-qnty
     9350             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     9351             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     9352             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     9353             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     9354             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     9355             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     9356           .
     9357         end.
     9358       end.
     9359     end.
     9360   end procedure.
     9361   procedure ost-lineother-tax :
     9362     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     9363     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     9364     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     9365     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     9366     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     9367     define input  parameter x-tog-shift  as logical no-undo .
     9368     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     9369     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     9370     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     9371     define input  parameter xTog-obj     as logical no-undo .
     9372     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     9373     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     9374     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     9375     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     9376     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     9377     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     9378     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     9379     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     9380     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     9381     define buffer buff-obj-list  for obj-list .
     9382     define buffer buff-stk-line  for ub.stk-line .
     9383     assign
     9384       Quantity = 0
     9385       Coast_R  = 0
     9386       Coast_V  = 0
     9387       VAT_R    = 0
     9388       VAT_V    = 0
     9389       SLT_R    = 0
     9390       SLT_V    = 0
     9391       other_R  = 0
     9392       other_V  = 0
     9393     .
     9394     if  x-tog-shift = false then do:
     9395       for each buff-obj-list no-lock
     9396         where xtog-obj = false
     9397            or (buff-obj-list.obj-type = x-store-type
     9398               and buff-obj-list.obj-code = x-store-code
     9399               )
     9400       on error undo, return error
     9401       :
     9402       find last buff-stk-line no-lock
     9403         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     9404           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     9405           and buff-stk-line.artic      = x-artic
     9406           and buff-stk-line.prod-type  = x-prod-type
     9407           and buff-stk-line.prod-code  = x-prod-code
     9408           and buff-stk-line.sum-type   = x-sum-type
     9409           and buff-stk-line.cat-id     = '##,##':U
     9410           and buff-stk-line.fact-order <= x-fact-order
     9411           and buff-stk-line.shift-num  = 0
     9412         use-index category
     9413         no-error .
     9414       if available buff-stk-line then do:
     9415         assign
     9416           Quantity = Quantity + buff-stk-line.fact-qnty
     9417           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     9418           Coast_V  = Coast_V  + buff-stk-line.sum-base
     9419           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     9420           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     9421           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     9422           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     9423           other_R  = other_R  + buff-stk-line.other-rubl
     9424           other_V  = other_V  + buff-stk-line.other-base
     9425         .
     9426       end.
     9427    end.
     9428     end.
     9429     else do:
     9430       for each buff-obj-list no-lock
     9431         where xtog-obj = false
     9432            or (buff-obj-list.obj-type = x-store-type
     9433               and buff-obj-list.obj-code = x-store-code
     9434               )
     9435       on error undo, return error
     9436       :
     9437         find last buff-stk-line no-lock
     9438           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     9439             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     9440             and buff-stk-line.artic      = x-artic
     9441             and buff-stk-line.prod-type  = x-prod-type
     9442             and buff-stk-line.prod-code  = x-prod-code
     9443             and buff-stk-line.sum-type   = x-sum-type
     9444             and buff-stk-line.cat-id     = '##,##':U
     9445             and buff-stk-line.fact-order <= x-fact-order
     9446             and buff-stk-line.shift-num  > 0
     9447           use-index category
     9448           no-error .
     9449         if available buff-stk-line then do:
     9450           assign
     9451             Quantity = Quantity +  buff-stk-line.fact-qnty
     9452             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     9453             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     9454             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     9455             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     9456             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     9457             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     9458             other_R = other_R   +  buff-stk-line.other-rubl
     9459             other_V = other_V   +  buff-stk-line.other-base
     9460           .
     9461         end.
     9462       end.
     9463     end.
     9464   end procedure.
     9465   procedure ost-line-kg :
     9466     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     9467     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     9468     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     9469     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     9470     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     9471     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     9472     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     9473     define buffer buff-obj-list  for obj-list .
     9474     define buffer buf_doc-line for ub.doc-line .
     9475     define buffer buf_inv-line for ub.inv-line .
     9476     do
     9477     on error undo, return error
     9478     :
     9479       for each buf_doc-line no-lock where
     9480                buf_doc-line.obj-type    = p-obj-type   and
     9481                buf_doc-line.obj-code    = p-obj-code   and
     9482                buf_doc-line.prod-type   = p-prod-type  and
     9483                buf_doc-line.prod-code   = p-prod-code  and
     9484                buf_doc-line.artic       = p-artic      and
     9485                buf_doc-line.status_     = 'факт':U      and
     9486                buf_doc-line.fact-order <= p-fact-order
     9487             by buf_doc-line.fact-order    descending
     9488       :
     9489         find first buf_inv-line no-lock where
     9490                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     9491                    buf_inv-line.artic     = buf_doc-line.artic     and
     9492                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     9493                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     9494         if available buf_inv-line
     9495         then do:
     9496           if buf_inv-line.after-cli-qnty <> ?
     9497           then do:
     9498             assign
     9499               p-quantity-kg = buf_inv-line.after-cli-qnty
     9500             .
     9501             leave .
     9502           end.
     9503         end.
     9504       end.
     9505       if p-quantity-kg = ?
     9506       then do:
     9507         assign
     9508           p-quantity-kg = 0
     9509         .
     9510       end.
     9511     end.
     9512   end procedure.
