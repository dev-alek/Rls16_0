     3112           and bf_parts.artic      = bf_price-list.artic
     3113           and bf_parts.prod-type  = bf_price-list.prod-type
     3114           and bf_parts.prod-code  = bf_price-list.prod-code
     3115       :
     3116         assign
     3117           varfact-qnty = varfact-qnty + bf_parts.fact-qnty
     3118         .
     3119       end.
     3120       assign
     3121         vardoc-num   = bf_price-list.doc-num
     3122         vardoc-code  = bf_price-list.doc-num
     3123         varobj-type  = bf_price-list.obj-type
     3124         varobj-code  = bf_price-list.obj-code
