     5536      if Make-Excel then  put   stream ForExcel unformatted  obj-list.obj-name chr(10).
     5537     end.
     5538             n-nn = 0.
     5539             n-no = n-no + 1 .
     5540   .
     5541    For Each gds-obj where
     5542             gds-obj.obj-code    = obj-list.obj-code and
     5543             gds-obj.obj-type    = obj-list.obj-type
     5544             no-lock,
     5545             first goods where
     5546                   goods.prod-type = gds-obj.prod-type and
     5547                   goods.prod-code = gds-obj.prod-code and
     5548                   goods.artic     = gds-obj.artic  and
     5549                   goods.gds-type    = 'т':U
     5550                                 no-lock
     5551             , first gds-list where
     5552                     gds-list.prod-type =  gds-obj.prod-type and
     5553                     gds-list.prod-code =  gds-obj.prod-code and
     5554                     gds-list.artic     =  gds-obj.artic
     5555                     no-lock
     5556               break
     5557                   by ( gds-obj.artic + gds-obj.prod-type + string ( gds-obj.prod-code ))
     5558                   by gds-obj.prod-type By gds-obj.prod-code by gds-obj.artic
     5559                   with FRAME Zapas :
     5560                        pr-cursor = 0.
     5561                        go-work = false.
     5562                        if v-prizn = "" then do:
     5563                           go-work = true.
     5564                        end.
     5565                        else do:
     5566                             if goods.prt-root <> Prtroot then
     5567                             do while pr-cursor < num-entries(v-prizn,","):
     5568                             pr-cursor = pr-cursor + 1.
     5569                                 if entry(pr-cursor,v-prizn,",") <> "" then do:
     5570                                     for first prt-obj where
     5571                                     prt-obj.artic     = goods.artic     and
     5572                                     prt-obj.prod-type = goods.prod-type and
     5573                                     prt-obj.prod-code = goods.prod-code and
     5574                                     prt-obj.obj-code  = obj-list.obj-code and
     5575                                     prt-obj.obj-type  = obj-list.obj-type and
     5576                                     prt-obj.is-term   =  true  and
     5577                                     prt-obj.prt-code  = integer(entry(pr-cursor,v-prizn,","))
     5578                                     no-lock:
     5579                                         pr-cursor = num-entries(v-prizn,",").
     5580                                         go-work = true.
     5581                                         v-tmp-prt = integer(entry(pr-cursor,v-prizn,",")).
     5582                                     end.
     5583                                 end.
     5584                             end.
     5585                         end.
     5586                   if go-work then do:
     5587                   n-nm = n-nm + 1.
     5588   IF ( n-nm modulo v-account = 0 )  then DO:
     5589             if  log-manager:logfile-name ne ?
     5590             then DO:
