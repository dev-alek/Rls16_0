     6435                     End.
     6436             End.
     6437   if last-of(gds-obj.artic) then DO:
     6438    IF v-var = "no-today" then DO:
     6439                  RUN ost-line in this-procedure
     6440                  (
     6441                   input   gds-obj.obj-code  ,
     6442                   input   gds-obj.obj-type  ,
     6443                   INPUT   gds-obj.artic     ,
     6444                   INPUT   gds-obj.prod-code ,
     6445                   INPUT   gds-obj.prod-type ,
     6446                   input   0                 ,
     6447                   INPUT   fact-order-2      ,
     6448                   input   'crsa':U       ,
     6449                   input   '##,##':U    ,
     6450                   input   yes               ,
     6451                   output  Quantity1         ,
     6452                   output  Coast_R1          ,
     6453                   output  Coast_V1          ,
     6454                   output  VAT_R1            ,
     6455                   output  VAT_V1            ,
     6456                   output  SLT_R1            ,
     6457                   output  SLT_V1            ).
     6458                Assign
     6459                   f-qnty       = Quantity1
     6460                   f-sale-sum   = if tprintrubl then Coast_R1 else Coast_V1
     6461                   f-sale-pr    = if f-qnty = 0 then 0 else f-sale-sum / f-qnty
     6462                   .
     6463                  RUN ost-line in this-procedure
     6464                  (
     6465                   input   gds-obj.obj-code  ,
     6466                   input   gds-obj.obj-type  ,
     6467                   INPUT   gds-obj.artic     ,
     6468                   INPUT   gds-obj.prod-code ,
     6469                   INPUT   gds-obj.prod-type ,
     6470                   input   0                 ,
     6471                   INPUT   fact-order-2      ,
     6472                   input   'cost':U       ,
     6473                   input   '##,##':U    ,
     6474                   input   yes      ,
     6475                   output  Quantity1   ,
     6476                   output  Coast_R1  ,
     6477                   output  Coast_V1  ,
     6478                   output  VAT_R1    ,
     6479                   output  VAT_V1    ,
     6480                   output  SLT_R1    ,
     6481                   output  SLT_V1    ).
     6482                Assign
     6483                   f-cost-sum   = if tprintrubl then Coast_R1 else Coast_V1
     6484                   f-cost-pr    = if Quantity1 = 0 then 0 else ( f-cost-sum / Quantity1 )
     6485                   .
     6486   end.
     6487   else do:
     6488        if v-prizn <> "" and goods.prt-root <> Prtroot then do:
     6489           pr-cursor = 0.
     6490                    f-qnty = 0.
     6491            do while pr-cursor < num-entries(v-prizn,","):
     6492                pr-cursor = pr-cursor + 1.
     6493                if entry(pr-cursor,v-prizn,",") <> "" then do:
     6494                    for each prt-obj no-lock where prt-obj.prt-code = integer(entry(pr-cursor,v-prizn,","))
     6495                    and prt-obj.artic = gds-obj.artic
     6496                    and prt-obj.obj-code = gds-obj.obj-code
     6497                    and prt-obj.obj-type = gds-obj.obj-type
     6498                    and prt-obj.is-term   =  true
     6499                    :
     6500                    assign
     6501                       f-qnty       =  f-qnty + prt-obj.fact-qnty
     6502                       f-cost-sum   = f-cost-sum + if gds-obj.fact-qnty = 0 then 0 else prt-obj.fact-qnty * determined(gds-obj.fact-rubl) / gds-obj.fact-qnty
     6503                       f-sale-sum   = f-sale-sum + if gds-obj.fact-qnty = 0 then 0 else prt-obj.fact-qnty * gds-obj.fact-sale / gds-obj.fact-qnty
     6504                       f-free-qnty  = f-free-qnty + prt-obj.free-qnty
     6505                       f-cost-pr   = if prt-obj.fact-qnty  = 0 then 0 else determined(gds-obj.fact-rubl) / gds-obj.fact-qnty
     6506                       f-sale-pr   = if prt-obj.fact-qnty  = 0 then 0 else prt-obj.price-sale
     6507                       .
     6508                    end.
     6509                end.
     6510            end.
     6511        end.
     6512        else do:
     6513            Assign
     6514               f-qnty       = gds-obj.fact-qnty
     6515               f-cost-sum   = determined(gds-obj.fact-rubl)
     6516               f-sale-sum   = gds-obj.fact-sale
     6517               f-free-qnty  = gds-obj.free-qnty
