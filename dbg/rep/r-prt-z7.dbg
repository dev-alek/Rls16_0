     5606            End.
     5607      end.
     5608                   IF first-of(gds-obj.artic) then DO:
     5609                   assign
     5610                     f-qnty         = 0
     5611                     f-cost-sum     = 0
     5612                     f-sale-sum     = 0
     5613                     f-cost-pr      = 0
     5614                     f-sale-pr      = 0
     5615                     f-sale-other   = 0
     5616                     f-free-qnty    = 0
     5617                     f-wait-qnty    = 0
