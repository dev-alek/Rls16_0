     5665                   output  Coast_R1  ,
     5666                   output  Coast_V1  ,
     5667                   output  VAT_R1    ,
     5668                   output  VAT_V1    ,
     5669                   output  SLT_R1    ,
     5670                   output  SLT_V1    ).
     5671                Assign
     5672                   f-cost-sum   = if tprintrubl then Coast_R1 else Coast_V1
     5673                   f-cost-pr    = if Quantity1 = 0 then 0 else ( f-cost-sum / Quantity1 )
     5674                   .
     5675   end.
     5676   else do:
