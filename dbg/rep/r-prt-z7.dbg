     1473   procedure prdoclib-clear-temp-prt-obj :
     1474     define buffer buf_temp-prt-obj for temp-prt-obj .
     1475     do
     1476     on error undo, return error return-value
     1477     :
     1478       for each buf_temp-prt-obj
     1479       on error undo, return error return-value
     1480       :
     1481         delete buf_temp-prt-obj .
     1482       end.
     1483     end.
     1484   end procedure.
     1485   procedure prdoclib-create-temp-prt-obj :
     1486     define input parameter  p-root-price-sale like ub.price-list.price-sale no-undo .
     1487     define parameter buffer buf_prt-obj       for ub.prt-obj .
     1488     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
     1489     define buffer buf_gds-prt for ub.gds-prt .
     1490     do
     1491     on error undo, return error return-value
     1492     :
     1493       find first buf_temp-prt-obj
     1494         where buf_temp-prt-obj.prt-code = buf_prt-obj.prt-code
     1495         no-error .
     1496       if not available buf_temp-prt-obj
     1497       then do:
     1498         create buf_temp-prt-obj .
     1499         assign
     1500           buf_temp-prt-obj.prt-code         = buf_prt-obj.prt-code
     1501           buf_temp-prt-obj.price-sale       = ?
     1502           buf_temp-prt-obj.fact-qnty        = buf_prt-obj.fact-qnty
     1503           buf_temp-prt-obj.price-list-qnty  = ?
     1504           buf_temp-prt-obj.prt-obj-recid    = recid(buf_prt-obj)
     1505           buf_temp-prt-obj.price-list-recid = ?
     1506         .
     1507         find first buf_gds-prt no-lock
     1508           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     1509           .
     1510         assign
     1511           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     1512         .
     1513         if buf_temp-prt-obj.is-term
     1514         then do:
     1515           assign
     1516             buf_temp-prt-obj.price-sale = p-root-price-sale
     1517           .
     1518         end.
     1519       end.
     1520     end.
     1521   end procedure.
     1522   procedure prdoclib-temp-prt-obj-by-prt-root :
     1523     define input parameter  p-prt-code like ub.prt-obj.prt-code no-undo .
     1524     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
     1525     define buffer buf_gds-prt for ub.gds-prt .
     1526     do
     1527     on error undo, return error return-value
     1528     :
     1529       find first buf_temp-prt-obj
     1530         where buf_temp-prt-obj.prt-code = p-prt-code
     1531         no-error .
     1532       if not available buf_temp-prt-obj
     1533       then do:
     1534         create buf_temp-prt-obj .
     1535         assign
     1536           buf_temp-prt-obj.prt-code         = p-prt-code
     1537           buf_temp-prt-obj.price-sale       = ?
     1538           buf_temp-prt-obj.fact-qnty        = 0
     1539           buf_temp-prt-obj.price-list-qnty  = ?
     1540           buf_temp-prt-obj.prt-obj-recid    = ?
     1541           buf_temp-prt-obj.price-list-recid = ?
     1542         .
     1543         find first buf_gds-prt no-lock
     1544           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     1545           .
     1546         assign
     1547           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     1548         .
     1549         if buf_temp-prt-obj.is-term
     1550         then do:
     1551           assign
     1552             buf_temp-prt-obj.price-sale = 0
     1553           .
     1554         end.
     1555       end.
     1556     end.
     1557   end procedure.
     1558   procedure prdoclib-init-temp-prt-obj :
     1559     define input parameter p-obj-type        like ub.prt-obj.obj-type  no-undo .
     1560     define input parameter p-obj-code        like ub.prt-obj.obj-code  no-undo .
     1561     define input parameter p-artic           like ub.prt-obj.artic     no-undo .
     1562     define input parameter p-prod-type       like ub.prt-obj.prod-type no-undo .
     1563     define input parameter p-prod-code       like ub.prt-obj.prod-code no-undo .
     1564     define input parameter p-root-price-sale like ub.prt-obj.price-sale no-undo .
     1565     define buffer buf_prt-obj      for ub.prt-obj .
     1566     define buffer buf_temp-prt-obj for temp-prt-obj .
     1567     do
     1568     on error undo, return error return-value
     1569     :
     1570       run prdoclib-clear-temp-prt-obj in this-procedure .
     1571       for each buf_prt-obj
     1572         where buf_prt-obj.obj-type  = p-obj-type
     1573           and buf_prt-obj.obj-code  = p-obj-code
     1574           and buf_prt-obj.artic     = p-artic
     1575           and buf_prt-obj.prod-type = p-prod-type
     1576           and buf_prt-obj.prod-code = p-prod-code
     1577       on error undo, return error return-value
     1578       :
     1579         run prdoclib-create-temp-prt-obj in this-procedure
     1580           (input  p-root-price-sale
     1581           ,buffer buf_prt-obj
     1582           ,buffer buf_temp-prt-obj
     1583           ).
     1584       end.
     1585     end.
     1586   end procedure.
     1587   procedure prdoclib-calc-fact-sale :
     1588     define input  parameter p-price-list-recid   as recid     no-undo .
     1589     define output parameter p-fact-qnty          as decimal   no-undo .
     1590     define output parameter p-cur-base           as decimal   no-undo .
     1591     define output parameter p-cur-VAT-base       as decimal   no-undo .
     1592     define output parameter p-cur-SLT-base       as decimal   no-undo .
     1593     define output parameter p-cur-road-tax-base  as decimal   no-undo .
     1594     define output parameter p-cur-excise-base    as decimal   no-undo .
     1595     define buffer buf_main_price-list for ub.price-list .
     1596     define buffer buf_price-list      for ub.price-list .
     1597     define buffer buf_goods           for ub.goods .
     1598     define buffer buf_gds-obj         for ub.gds-obj .
     1599     define buffer buf_bar-code        for ub.bar-code .
     1600     define variable l-empty-scale   as logical   no-undo .
     1601     do
     1602     on error undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )
     1603     on stop undo, return error substitute(" stop &1 &2" , return-value , error-status :get-message(1)  )
     1604     on end-key undo, return error substitute(" end-key &1 &2" , return-value , error-status :get-message(1)  )
     1605     :
     1606       find first buf_main_price-list no-lock
     1607         where recid(buf_main_price-list) = p-price-list-recid
     1608         no-error .
     1609       if not available buf_main_price-list
     1610       then do:
     1611         message
     1612           vss-workfile vss-revision vss-description skip
     1613           vss-include-info16 skip
     1614           "Ошибка задания входных параметров" skip
     1615           "Не найдена строка переоценки" skip
     1616           "Код записи (recid)" p-price-list-recid skip
     1617           view-as alert-box error .
     1618         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )   .
     1619       end.
     1620       if buf_main_price-list.main-price <> true
     1621       then do:
     1622         message
     1623           vss-workfile vss-revision vss-description skip
     1624           vss-include-info16 skip
     1625           "Ошибка задания входных параметров" skip
     1626           "Строка переоценки не является основной" skip
     1627           "Код записи (recid)" p-price-list-recid skip
     1628           "Переоценка" buf_main_price-list.doc-num skip
     1629           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1630           "Бар-код" buf_main_price-list.b-code skip
     1631           view-as alert-box error .
     1632         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )  .
     1633       end.
     1634       find first buf_goods no-lock
     1635         where buf_goods.artic     = buf_main_price-list.artic
     1636           and buf_goods.prod-type = buf_main_price-list.prod-type
     1637           and buf_goods.prod-code = buf_main_price-list.prod-code
     1638         no-error .
     1639       if not available buf_goods
     1640       then do:
     1641         message
     1642           vss-workfile vss-revision vss-description skip
     1643           vss-include-info16 skip
     1644           "Не найден товар" skip
     1645           "Переоценка" buf_main_price-list.doc-num skip
     1646           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1647           view-as alert-box error .
     1648         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1649       end.
     1650   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1651   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1652     (input  buf_main_price-list.artic
     1653     ,input  buf_main_price-list.prod-type
     1654     ,input  buf_main_price-list.prod-code
     1655     ,input  'empty-scale=request':u
     1656     ,output l-empty-scale
     1657     ) no-error .
     1658       if error-status :error
     1659       then do:
     1660         message
     1661           vss-workfile vss-revision vss-description skip
     1662           vss-include-info16 skip
     1663           "Ошибка при определении атрибута товара" skip
     1664           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1665           'empty-scale=request':u skip
     1666           error-status :get-message(1) skip
     1667           return-value skip
     1668           view-as alert-box error .
     1669         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1670       end.
     1671       find first buf_gds-obj no-lock
     1672         where buf_gds-obj.gds-code = buf_goods.gds-code
     1673           and buf_gds-obj.obj-type = buf_main_price-list.obj-type
     1674           and buf_gds-obj.obj-code = buf_main_price-list.obj-code
     1675         no-error .
     1676         if not available buf_gds-obj then do:
     1677   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1678   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1679     (input  buf_main_price-list.obj-type
     1680     ,input  buf_main_price-list.obj-code
     1681     ,input  buf_goods.artic
     1682     ,input  buf_goods.prod-type
     1683     ,input  buf_goods.prod-code
     1684     ,buffer buf_gds-obj
     1685     ) no-error .
     1686           if error-status :error then do:
     1687              undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1688           end.
     1689         end.
     1690       define variable price-rubl-with-tax-sale-prl    as decimal   no-undo .
     1691       define variable price-base-with-tax-sale-prl    as decimal   no-undo .
     1692       define variable price-rubl-without-tax-sale-prl as decimal   no-undo .
     1693       define variable price-base-without-tax-sale-prl as decimal   no-undo .
     1694       define variable vat-base-sale-prl               as decimal   no-undo .
     1695       define variable vat-rubl-sale-prl               as decimal   no-undo .
     1696       define variable vat-base-buyer-prl              as decimal   no-undo .
     1697       define variable vat-rubl-buyer-prl              as decimal   no-undo .
     1698       define variable slt-base-sale-prl               as decimal   no-undo .
     1699       define variable slt-rubl-sale-prl               as decimal   no-undo .
     1700       define variable road-tax-base-sale-prl          as decimal   no-undo .
     1701       define variable road-tax-rubl-sale-prl          as decimal   no-undo .
     1702       define variable excise-base-sale-prl            as decimal   no-undo .
     1703       define variable excise-rubl-sale-prl            as decimal   no-undo .
     1704       define variable discnt-base-sale-prl            as decimal   no-undo .
     1705       define variable discnt-rubl-sale-prl            as decimal   no-undo .
     1706       if buf_main_price-list.doc-qnty <> 0
     1707       then do:
     1708         run prl-vat in this-procedure
     1709           (input  recid(buf_main_price-list)
     1710           ,output price-rubl-with-tax-sale-prl
     1711           ,output price-base-with-tax-sale-prl
     1712           ,output price-rubl-without-tax-sale-prl
     1713           ,output price-base-without-tax-sale-prl
     1714           ,output vat-base-sale-prl
     1715           ,output vat-rubl-sale-prl
     1716           ,output vat-base-buyer-prl
     1717           ,output vat-rubl-buyer-prl
     1718           ,output slt-base-sale-prl
     1719           ,output slt-rubl-sale-prl
     1720           ,output road-tax-base-sale-prl
     1721           ,output road-tax-rubl-sale-prl
     1722           ,output excise-base-sale-prl
     1723           ,output excise-rubl-sale-prl
     1724           ,output discnt-base-sale-prl
     1725           ,output discnt-rubl-sale-prl
     1726           ) no-error .
     1727         if error-status :error
     1728         then do:
     1729           message
     1730             vss-workfile vss-revision vss-description skip
     1731             vss-include-info16 skip
     1732             "Ошибка при вызове процеды prl-vat" skip
     1733             "Документ" buf_main_price-list.doc-num skip
     1734             "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1735             error-status :get-message(1) skip
     1736             return-value skip
     1737             view-as alert-box error .
     1738           undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1739         end.
     1740       end.
     1741       else do:
     1742         assign
     1743           price-rubl-with-tax-sale-prl    = 0
     1744           price-base-with-tax-sale-prl    = 0
     1745           price-rubl-without-tax-sale-prl = 0
     1746           price-base-without-tax-sale-prl = 0
     1747           vat-base-sale-prl               = 0
     1748           vat-rubl-sale-prl               = 0
     1749           vat-base-buyer-prl              = 0
     1750           vat-rubl-buyer-prl              = 0
     1751           slt-base-sale-prl               = 0
     1752           slt-rubl-sale-prl               = 0
     1753           road-tax-base-sale-prl          = 0
     1754           road-tax-rubl-sale-prl          = 0
     1755           excise-base-sale-prl            = 0
     1756           excise-rubl-sale-prl            = 0
     1757           discnt-base-sale-prl            = 0
     1758           discnt-rubl-sale-prl            = 0
     1759         .
     1760       end.
     1761       define variable v-curr-r-b as character no-undo .
     1762   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1763   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1764     (output v-curr-r-b
     1765     )  .
     1766       if v-curr-r-b = 'base':U
     1767       then do:
     1768         assign
     1769           p-fact-qnty         = buf_main_price-list.doc-qnty
     1770           p-cur-base          = price-base-with-tax-sale-prl * buf_main_price-list.doc-qnty
     1771           p-cur-VAT-base      = vat-base-sale-prl * buf_main_price-list.doc-qnty
     1772           p-cur-SLT-base      = slt-base-sale-prl * buf_main_price-list.doc-qnty
     1773           p-cur-road-tax-base = road-tax-base-sale-prl * buf_main_price-list.doc-qnty
     1774           p-cur-excise-base   = excise-base-sale-prl * buf_main_price-list.doc-qnty
     1775         .
     1776       end.
     1777       else do:
     1778         assign
     1779           p-fact-qnty         = buf_main_price-list.doc-qnty
     1780           p-cur-base          = price-rubl-with-tax-sale-prl * buf_main_price-list.doc-qnty
     1781           p-cur-VAT-base      = vat-rubl-sale-prl * buf_main_price-list.doc-qnty
     1782           p-cur-SLT-base      = slt-rubl-sale-prl * buf_main_price-list.doc-qnty
     1783           p-cur-road-tax-base = road-tax-rubl-sale-prl * buf_main_price-list.doc-qnty
     1784           p-cur-excise-base   = excise-rubl-sale-prl * buf_main_price-list.doc-qnty
     1785         .
     1786       end.
     1787         define variable v-unit-base like ub.goods.unit-base no-undo .
     1788   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1789   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     1790     (input  buf_goods.gds-code
     1791     ,output v-unit-base
     1792     ) no-error .
     1793         if error-status :error
     1794         then do:
     1795           message
     1796             vss-workfile vss-revision vss-description skip
     1797             vss-include-info16 skip
     1798             "Ошибка при определении базовой единицы измерения товара" skip
     1799             "Код товара" buf_goods.gds-code skip
     1800             error-status :get-message(1) skip
     1801             return-value skip
     1802             view-as alert-box error .
     1803           undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1804         end.
     1805         for each buf_price-list no-lock
     1806           where buf_price-list.doc-num    = buf_main_price-list.doc-num
     1807             and buf_price-list.main-price = false
     1808             and buf_price-list.artic      = buf_main_price-list.artic
     1809             and buf_price-list.prod-type  = buf_main_price-list.prod-type
     1810             and buf_price-list.prod-code  = buf_main_price-list.prod-code
     1811         :
     1812           if buf_price-list.doc-qnty = ?
     1813           then do:
     1814             find first buf_bar-code no-lock
     1815               where buf_bar-code.b-code = buf_price-list.b-code
     1816               no-error .
     1817             if available buf_bar-code
     1818             and buf_bar-code.unit-cli = v-unit-base
     1819             then do:
     1820               message
     1821                 vss-workfile vss-revision vss-description skip
     1822                 vss-include-info16 skip
     1823                 "Ошибка при закрытии переоценки" skip
     1824                 "Не задано количество для бар-кода с основной единицей измерения" skip
     1825                 "Переоценка" buf_main_price-list.doc-num skip
     1826                 "Бар-код" buf_price-list.b-code skip
     1827                 "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1828                 "Количество" buf_price-list.doc-qnty skip
     1829                 "Основная единица измерения" v-unit-base skip
     1830                 "Единица измерения бар-кода" buf_bar-code.unit-cli skip
     1831                 view-as alert-box error .
     1832               undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1833             end.
     1834             next .
     1835           end.
     1836           if not can-find
     1837             (first buf_bar-code
     1838             where buf_bar-code.b-code = buf_price-list.b-code
     1839             )
     1840           then do:
     1841             message
     1842               vss-workfile vss-revision vss-description skip
     1843               vss-include-info16 skip
     1844               "В переоценке задан несуществующий бар-код" skip
     1845               "Переоценка" buf_price-list.doc-num skip
     1846               "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
     1847               "Бар-код" buf_price-list.b-code skip
     1848               view-as alert-box error .
     1849             undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1850           end.
     1851           if buf_price-list.doc-qnty <> 0
     1852           then do:
     1853             run prl-vat in this-procedure
     1854               (input  recid(buf_price-list)
     1855               ,output price-rubl-with-tax-sale-prl
     1856               ,output price-base-with-tax-sale-prl
     1857               ,output price-rubl-without-tax-sale-prl
     1858               ,output price-base-without-tax-sale-prl
     1859               ,output vat-base-sale-prl
     1860               ,output vat-rubl-sale-prl
     1861               ,output vat-base-buyer-prl
     1862               ,output vat-rubl-buyer-prl
     1863               ,output slt-base-sale-prl
     1864               ,output slt-rubl-sale-prl
     1865               ,output road-tax-base-sale-prl
     1866               ,output road-tax-rubl-sale-prl
     1867               ,output excise-base-sale-prl
     1868               ,output excise-rubl-sale-prl
     1869               ,output discnt-base-sale-prl
     1870               ,output discnt-rubl-sale-prl
     1871               ) no-error .
     1872             if error-status :error
     1873             then do:
     1874               message
     1875                 vss-workfile vss-revision vss-description skip
     1876                 vss-include-info16 skip
     1877                 "Ошибка при вызове процеды prl-vat" skip
     1878                 "Документ" buf_price-list.doc-num skip
     1879                 "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
     1880                 error-status :get-message(1) skip
     1881                 return-value skip
     1882                 view-as alert-box error .
     1883               undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1884             end.
     1885           end.
     1886           else do:
     1887             assign
     1888               price-rubl-with-tax-sale-prl    = 0
     1889               price-base-with-tax-sale-prl    = 0
     1890               price-rubl-without-tax-sale-prl = 0
     1891               price-base-without-tax-sale-prl = 0
     1892               vat-base-sale-prl               = 0
     1893               vat-rubl-sale-prl               = 0
     1894               vat-base-buyer-prl              = 0
     1895               vat-rubl-buyer-prl              = 0
     1896               slt-base-sale-prl               = 0
     1897               slt-rubl-sale-prl               = 0
     1898               road-tax-base-sale-prl          = 0
     1899               road-tax-rubl-sale-prl          = 0
     1900               excise-base-sale-prl            = 0
     1901               excise-rubl-sale-prl            = 0
     1902               discnt-base-sale-prl            = 0
     1903               discnt-rubl-sale-prl            = 0
     1904             .
     1905           end.
     1906           if v-curr-r-b = 'base':U
     1907           then do:
     1908             assign
     1909               p-fact-qnty         = p-fact-qnty
     1910                                   + buf_price-list.doc-qnty
     1911               p-cur-base          = p-cur-base
     1912                                   + price-base-with-tax-sale-prl * buf_price-list.doc-qnty
     1913               p-cur-VAT-base      = p-cur-VAT-base
     1914                                   + vat-base-sale-prl * buf_price-list.doc-qnty
     1915               p-cur-SLT-base      = p-cur-SLT-base
     1916                                   + slt-base-sale-prl * buf_price-list.doc-qnty
     1917               p-cur-road-tax-base = p-cur-road-tax-base
     1918                                   + road-tax-base-sale-prl * buf_price-list.doc-qnty
     1919               p-cur-excise-base   = p-cur-excise-base
     1920                                   + excise-base-sale-prl * buf_price-list.doc-qnty
     1921             .
     1922           end.
     1923           else do:
     1924             assign
     1925               p-fact-qnty         = p-fact-qnty
     1926                                   + buf_price-list.doc-qnty
     1927               p-cur-base          = p-cur-base
     1928                                   + price-rubl-with-tax-sale-prl * buf_price-list.doc-qnty
     1929               p-cur-VAT-base      = p-cur-VAT-base
     1930                                   + vat-rubl-sale-prl * buf_price-list.doc-qnty
     1931               p-cur-SLT-base      = p-cur-SLT-base
     1932                                   + slt-rubl-sale-prl * buf_price-list.doc-qnty
     1933               p-cur-road-tax-base = p-cur-road-tax-base
     1934                                   + road-tax-rubl-sale-prl * buf_price-list.doc-qnty
     1935               p-cur-excise-base   = p-cur-excise-base
     1936                                   + excise-rubl-sale-prl * buf_price-list.doc-qnty
     1937             .
     1938           end.
     1939         end.
     1940     end.
     1941   end procedure.
     1942   procedure prdoclib-calc-prc :
     1943     define input  parameter p-price-doc-recid as   recid                  no-undo.
     1944     define input  parameter p-cons-pay        as   integer                no-undo.
     1945     define output parameter p-ov-cons         like ub.doc-line.price-base no-undo.
     1946     define output parameter p-ov-VAT-cons     like ub.doc-line.price-base no-undo.
     1947     define output parameter p-ov-SLT-cons     like ub.doc-line.price-base no-undo.
     1948     define output parameter p-ov-prch         like ub.doc-line.price-base no-undo.
     1949     define output parameter p-ov-VAT-prch     like ub.doc-line.price-base no-undo.
     1950     define output parameter p-ov-SLT-prch     like ub.doc-line.price-base no-undo.
     1951     do
     1952     on error undo, return error return-value
     1953     :
     1954       define buffer buf_price-doc       for ub.price-doc .
     1955       define buffer buf_price-list      for ub.price-list .
     1956       define buffer buf_parts           for ub.parts .
     1957       define variable v-ov-qnty     as decimal   no-undo .
     1958       define variable v-ov-base     as decimal   no-undo .
     1959       define variable v-ov-VAT-base as decimal   no-undo .
     1960       define variable v-ov-SLT-base as decimal   no-undo .
     1961       define variable v-cons-qnty   as decimal   no-undo .
     1962       define variable v-prch-qnty   as decimal   no-undo .
     1963       define variable v-cons-mult   as decimal   no-undo .
     1964       define variable v-prch-mult   as decimal   no-undo .
     1965       find first buf_price-doc no-lock
     1966         where recid(buf_price-doc) = p-price-doc-recid
     1967         no-error .
     1968       if not available buf_price-doc
     1969       then do:
     1970         message
     1971           vss-workfile vss-revision vss-description skip
     1972           vss-include-info16 skip
     1973           "Ошибка задания входных параметров" skip
     1974           "Не найден документ переоценки" skip
     1975           "Код записи (recid)" p-price-doc-recid skip
     1976           view-as alert-box error .
     1977         undo, return error .
     1978       end.
     1979       for each buf_price-list no-lock
     1980         where buf_price-list.doc-num    = buf_price-doc.doc-num
     1981           and buf_price-list.main-price = true
     1982       on error undo, return error return-value
     1983       :
     1984         run prdoclib-calc-ov
     1985           (input recid(buf_price-list)
     1986           ,output v-ov-qnty
     1987           ,output v-ov-base
     1988           ,output v-ov-VAT-base
     1989           ,output v-ov-SLT-base
     1990           ) no-error .
     1991         if error-status :error
     1992         then do:
     1993           if error-status :get-message(1) <> ""
     1994           then do:
     1995             message
     1996               vss-workfile vss-revision vss-description skip
     1997               vss-include-info16 skip
     1998               "Ошибка при вызове процедуры prdoclib-calc-ov" skip
     1999               error-status :get-message(1) skip
     2000               return-value skip
     2001               view-as alert-box error .
     2002           end.
     2003           undo, return error return-value .
     2004         end.
     2005         assign
     2006           v-cons-qnty = 0
     2007           v-prch-qnty = 0
     2008         .
     2009         for each buf_parts no-lock
     2010           where buf_parts.out-code  = buf_price-list.doc-num
     2011             and buf_parts.obj-type  = buf_price-list.obj-type
     2012             and buf_parts.obj-code  = buf_price-list.obj-code
     2013             and buf_parts.artic     = buf_price-list.artic
     2014             and buf_parts.prod-type = buf_price-list.prod-type
     2015             and buf_parts.prod-code = buf_price-list.prod-code
     2016         on error undo, return error return-value
     2017         :
     2018           if buf_parts.pay-code = p-cons-pay
     2019           then do:
     2020             assign
     2021               v-cons-qnty = v-cons-qnty + buf_parts.fact-qnty
     2022             .
     2023           end.
     2024           else do:
     2025             assign
     2026               v-prch-qnty = v-prch-qnty + buf_parts.fact-qnty
     2027             .
     2028           end.
     2029         end.
     2030         if (v-cons-qnty + v-prch-qnty) = 0
     2031         then do:
     2032           assign
     2033             v-cons-mult = 0
     2034             v-prch-mult = 1
     2035           .
     2036         end.
     2037         else do:
     2038           assign
     2039             v-cons-mult = v-cons-qnty / (v-cons-qnty + v-prch-qnty)
     2040             v-prch-mult = v-prch-qnty / (v-cons-qnty + v-prch-qnty)
     2041           .
     2042         end.
     2043         assign
     2044           p-ov-cons     = p-ov-cons     + v-ov-base     * v-cons-mult
     2045           p-ov-VAT-cons = p-ov-VAT-cons + v-ov-VAT-base * v-cons-mult
     2046           p-ov-SLT-cons = p-ov-SLT-cons + v-ov-SLT-base * v-cons-mult
     2047           p-ov-prch     = p-ov-prch     + v-ov-base     * v-prch-mult
     2048           p-ov-VAT-prch = p-ov-VAT-prch + v-ov-VAT-base * v-prch-mult
     2049           p-ov-SLT-prch = p-ov-SLT-prch + v-ov-SLT-base * v-prch-mult
     2050         .
     2051       end.
     2052     end.
     2053   end procedure.
     2054   procedure prdoclib-calc-ov :
     2055     define input  parameter p-price-list-recid as recid     no-undo .
     2056     define output parameter p-fact-qnty        as decimal   no-undo .
     2057     define output parameter p-ov-base          as decimal   no-undo .
     2058     define output parameter p-ov-VAT-base      as decimal   no-undo .
     2059     define output parameter p-ov-SLT-base      as decimal   no-undo .
     2060     do
     2061     on error undo, return error return-value
     2062     :
     2063       define buffer buf_main_price-list    for ub.price-list .
     2064       define buffer buf_prev_price-list    for ub.price-list .
     2065       define buffer buf_special_price-list for ub.price-list .
     2066       define buffer buf_goods              for ub.goods .
     2067       define variable v-fact-qnty             like ub.doc-line.price-base no-undo.
     2068       define variable v-cur-base              like ub.doc-line.price-base no-undo.
     2069       define variable v-cur-VAT-base          like ub.doc-line.price-base no-undo.
     2070       define variable v-cur-SLT-base          like ub.doc-line.price-base no-undo.
     2071       define variable v-cur-road-tax-base     like ub.doc-line.price-base no-undo.
     2072       define variable v-cur-excise-base       like ub.doc-line.price-base no-undo.
     2073       define variable v-prev-price-list-recid as   recid                  no-undo.
     2074       define variable v-prev-cli-base-rate    like ub.goods.cli-base-rate no-undo.
     2075       define variable v-prev-fact-qnty        like ub.doc-line.price-base no-undo.
     2076       define variable v-prev-cur-base         like ub.doc-line.price-base no-undo.
     2077       define variable v-prev-cur-VAT-base     like ub.doc-line.price-base no-undo.
     2078       define variable v-prev-cur-SLT-base     like ub.doc-line.price-base no-undo.
     2079       find first buf_main_price-list no-lock
     2080         where recid(buf_main_price-list) = p-price-list-recid
     2081         no-error .
     2082       if not available buf_main_price-list
     2083       then do:
     2084         message
     2085           vss-workfile vss-revision vss-description skip
     2086           vss-include-info16 skip
     2087           "Ошибка задания входных параметров" skip
     2088           "Не найдена строка переоценки" skip
     2089           "Код записи (recid)" p-price-list-recid skip
     2090           view-as alert-box error .
     2091         undo, return error .
     2092       end.
     2093       if buf_main_price-list.main-price <> true
     2094       then do:
     2095         message
     2096           vss-workfile vss-revision vss-description skip
     2097           vss-include-info16 skip
     2098           "Ошибка задания входных параметров" skip
     2099           "Строка переоценки не является основной" skip
     2100           "Код записи (recid)" p-price-list-recid skip
     2101           "Переоценка" buf_main_price-list.doc-num skip
     2102           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2103           "Бар-код" buf_main_price-list.b-code skip
     2104           view-as alert-box error .
     2105         undo, return error .
     2106       end.
     2107       run prdoclib-calc-fact-sale in this-procedure
     2108         (input  recid(buf_main_price-list)
     2109         ,output v-fact-qnty
     2110         ,output v-cur-base
     2111         ,output v-cur-VAT-base
     2112         ,output v-cur-SLT-base
     2113         ,output v-cur-road-tax-base
     2114         ,output v-cur-excise-base
     2115         ) no-error.
     2116       if error-status :error
     2117       then do:
     2118         message
     2119           vss-workfile vss-revision vss-description skip
     2120           vss-include-info16 skip
     2121           "Ошибка при расчете сумм переоценки." skip
     2122           "Документ переоценки" buf_main_price-list.doc-num skip
     2123           "Товар" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2124           error-status :get-message(1) skip
     2125           return-value skip
     2126           view-as alert-box error .
     2127         undo, return error .
     2128       end.
     2129   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2130   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     2131     (input  buf_main_price-list.obj-type
     2132     ,input  buf_main_price-list.obj-code
     2133     ,input  buf_main_price-list.b-code
     2134     ,input  buf_main_price-list.b-code
     2135     ,input  buf_main_price-list.fact-order
     2136     ,output v-prev-price-list-recid
     2137     ,output v-prev-cli-base-rate
     2138     ) no-error .
     2139       if error-status :error
     2140       then do:
     2141         message
     2142           vss-workfile vss-revision vss-description skip
     2143           vss-include-info16 skip
     2144           "Ошибка при поиске предыдущей переоценки." skip
     2145           "Документ переоценки " buf_main_price-list.doc-num skip
     2146           "Товар " buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2147           error-status :get-message(1) skip
     2148           return-value skip
     2149           view-as alert-box error .
     2150         undo, return error .
     2151       end.
     2152       if v-prev-price-list-recid <> ?
     2153       then do:
     2154         find first buf_prev_price-list no-lock
     2155           where recid(buf_prev_price-list) = v-prev-price-list-recid
     2156           .
     2157         find first buf_special_price-list no-lock
     2158           where buf_special_price-list.doc-num    = buf_prev_price-list.doc-num
     2159             and buf_special_price-list.main-price = false
     2160             and buf_special_price-list.artic      = buf_prev_price-list.artic
     2161             and buf_special_price-list.prod-type  = buf_prev_price-list.prod-type
     2162             and buf_special_price-list.prod-code  = buf_prev_price-list.prod-code
     2163             and buf_special_price-list.doc-qnty   <> ?
     2164           no-error .
     2165         if available buf_special_price-list
     2166         then do:
     2167           message
     2168             "Товар имеет специальные цены на признаки" skip
     2169             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     2170             "Переоценка" buf_prev_price-list.doc-num skip
     2171             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     2172             view-as alert-box error .
     2173           undo, return error .
     2174         end.
     2175         find first buf_goods no-lock
     2176           where buf_goods.artic     = buf_main_price-list.artic
     2177             and buf_goods.prod-type = buf_main_price-list.prod-type
     2178             and buf_goods.prod-code = buf_main_price-list.prod-code
     2179           no-error .
     2180         if not available buf_goods
     2181         then do:
     2182           message
     2183             vss-workfile vss-revision vss-description skip
     2184             vss-include-info16 skip
     2185             "Не найден товар" skip
     2186             "Переоценка" buf_main_price-list.doc-num skip
     2187             "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2188             view-as alert-box error .
     2189           undo, return error .
     2190         end.
     2191         if buf_prev_price-list.vat-pc = ?
     2192         or buf_prev_price-list.slt-pc = ?
     2193         then do:
     2194           message
     2195             "В переоценке не заданы налоги товара" skip
     2196             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     2197             "Переоценка" buf_prev_price-list.doc-num skip
     2198             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     2199             "НДС" buf_prev_price-list.vat-pc skip
     2200             "НП" buf_prev_price-list.slt-pc skip
     2201             view-as alert-box error .
     2202           undo, return error return-value .
     2203         end.
     2204         define variable v-prev-cur-SLT-pc as decimal no-undo .
     2205         assign
     2206           v-prev-cur-SLT-pc   = buf_prev_price-list.price-sale * buf_prev_price-list.slt-pc / (100 + buf_prev_price-list.slt-pc)
     2207         .
     2208         assign
     2209           v-prev-cur-base     = v-fact-qnty * buf_prev_price-list.price-sale
     2210           v-prev-cur-VAT-base = v-fact-qnty
     2211                               * (buf_prev_price-list.price-sale - v-prev-cur-SLT-pc)
     2212                               * buf_prev_price-list.vat-pc / (100 + buf_prev_price-list.vat-pc)
     2213           v-prev-cur-SLT-base = v-fact-qnty * v-prev-cur-SLT-pc
     2214         .
     2215         assign
     2216           p-fact-qnty   = v-fact-qnty
     2217           p-ov-base     = v-cur-base     - v-prev-cur-base
     2218           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     2219           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     2220         .
     2221       end.
     2222       else do:
     2223         assign
     2224           v-prev-cur-base     = 0
     2225           v-prev-cur-VAT-base = 0
     2226           v-prev-cur-SLT-base = 0
     2227           .
     2228         assign
     2229           p-fact-qnty   = v-fact-qnty
     2230           p-ov-base     = v-cur-base     - v-prev-cur-base
     2231           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     2232           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     2233         .
     2234       end.
     2235     end.
     2236   end procedure.
     2237   procedure prdoclib-init-prt-obj-by-factord :
     2238     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     2239     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     2240     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     2241     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     2242     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     2243     define input parameter p-fact-order         as decimal   no-undo .
     2244     define input parameter p-include-fact-order as logical   no-undo .
     2245     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-factord: определение остатков по признакам на любой момент времени".
     2246     define buffer buf_gds-obj      for ub.gds-obj .
     2247     define buffer buf_doc-line     for ub.doc-line .
     2248     define buffer buf_temp-prt-obj for temp-prt-obj .
     2249     define variable v-total-gds-dtl-qnty as decimal   no-undo .
     2250     do
     2251     on error undo, return error return-value
     2252     :
     2253       do transaction
     2254       on error undo, return error return-value
     2255       :
     2256   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2257   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     2258     (input  p-obj-type
     2259     ,input  p-obj-code
     2260     ,input  p-artic
     2261     ,input  p-prod-type
     2262     ,input  p-prod-code
     2263     ,buffer buf_gds-obj
     2264     ) no-error .
     2265         if error-status :error
     2266         then do:
     2267           message
     2268             vss-workfile vss-revision vss-description skip
     2269             vss-include-info16 skip
     2270             "Невозможно найти gds-obj" skip
     2271             error-status :get-message(1) skip
     2272             return-value skip
     2273             view-as alert-box error .
     2274           undo, return error .
     2275         end.
     2276         find current buf_gds-obj exclusive-lock .
     2277       end.
     2278       run prdoclib-init-temp-prt-obj in this-procedure
     2279         (input p-obj-type
     2280         ,input p-obj-code
     2281         ,input p-artic
     2282         ,input p-prod-type
     2283         ,input p-prod-code
     2284         ,input 0
     2285         ) .
     2286       for each buf_temp-prt-obj
     2287         where buf_temp-prt-obj.is-term <> true
     2288       on error undo, return error return-value
     2289       :
     2290         delete buf_temp-prt-obj .
     2291       end.
     2292       if p-include-fact-order = true
     2293       then do:
     2294         assign
     2295          p-fact-order = p-fact-order - 0.0000000001
     2296         .
     2297       end.
     2298       for each buf_doc-line no-lock
     2299         where buf_doc-line.obj-type   = p-obj-type
     2300           and buf_doc-line.obj-code   = p-obj-code
     2301           and buf_doc-line.artic      = p-artic
     2302           and buf_doc-line.prod-type  = p-prod-type
     2303           and buf_doc-line.prod-code  = p-prod-code
     2304           and buf_doc-line.status_    = 'факт':U
     2305           and buf_doc-line.fact-order >= p-fact-order
     2306       on error undo, return error return-value
     2307       :
     2308         run prdoclib-process-document in this-procedure
     2309           (input  buf_doc-line.doc-code
     2310           ,input  p-obj-type
     2311           ,input  p-obj-code
     2312           ,input  p-artic
     2313           ,input  p-prod-type
     2314           ,input  p-prod-code
     2315           ,output v-total-gds-dtl-qnty
     2316           ) .
     2317       end.
     2318     end.
     2319   end procedure.
     2320   procedure prdoclib-process-document :
     2321     define input  parameter p-doc-code           as character no-undo .
     2322     define input  parameter p-obj-type           as character no-undo .
     2323     define input  parameter p-obj-code           as integer   no-undo .
     2324     define input  parameter p-artic              as character no-undo .
     2325     define input  parameter p-prod-type          as character no-undo .
     2326     define input  parameter p-prod-code          as integer   no-undo .
     2327     define output parameter p-total-gds-dtl-qnty as decimal   no-undo .
     2328     define buffer buf_trn-doc      for ub.trn-doc .
     2329     define buffer buf_gds-dtl      for ub.gds-dtl .
     2330     define buffer buf_temp-prt-obj for temp-prt-obj .
     2331     do
     2332     on error undo, return error return-value
     2333     :
     2334       find first buf_trn-doc no-lock
     2335         where buf_trn-doc.doc-code = p-doc-code
     2336         no-error .
     2337       if not available buf_trn-doc then do:
     2338         message
     2339           vss-workfile vss-revision vss-description skip
     2340           vss-include-info16 skip
     2341           "Ошибка при поиске документа" skip
     2342           "Документ" p-doc-code skip
     2343           "Объект" p-obj-type p-obj-code skip
     2344           "Артикул" p-artic p-prod-type p-prod-code skip
     2345           view-as alert-box error .
     2346         undo, return error .
     2347       end.
     2348       assign
     2349         p-total-gds-dtl-qnty = 0
     2350       .
     2351       for each buf_gds-dtl no-lock
     2352         where buf_gds-dtl.doc-code  = p-doc-code
     2353           and buf_gds-dtl.artic     = p-artic
     2354           and buf_gds-dtl.prod-type = p-prod-type
     2355           and buf_gds-dtl.prod-code = p-prod-code
     2356       on error undo, return error
     2357       :
     2358         define variable v-term-node as integer   no-undo .
     2359   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run termnode in g#library
     2360     (input  buf_gds-dtl.prt-code
     2361     ,output v-term-node
     2362     )  .
     2363         run prdoclib-temp-prt-obj-by-prt-root in this-procedure
     2364           (input  v-term-node
     2365           ,buffer buf_temp-prt-obj
     2366           ) .
     2367         if buf_temp-prt-obj.is-term <> true then do:
     2368           undo, return error substitute("Документ ссылается на нетерминальный признак. Код признака &1"
     2369                                        ,buf_gds-dtl.prt-code
     2370                                        ) .
     2371         end.
     2372         case buf_trn-doc.doc-type :
     2373           when 'при':U or
     2374           when 'возврат':U
     2375           then do:
     2376             assign
     2377               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     2378                                           - buf_gds-dtl.fact-qnty
     2379               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     2380                                           - buf_gds-dtl.fact-qnty
     2381             .
     2382           end.
     2383           when 'рас':U or
     2384           when 'спи':U
     2385           then do:
     2386             assign
     2387               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     2388                                           + buf_gds-dtl.fact-qnty
     2389               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     2390                                           + buf_gds-dtl.fact-qnty
     2391             .
     2392           end.
     2393           when 'инв':U
     2394           then do:
     2395             assign
     2396               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     2397                                           - buf_gds-dtl.doc-qnty
     2398               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     2399                                           - buf_gds-dtl.doc-qnty
     2400             .
     2401           end.
     2402           otherwise do:
     2403             undo, return error substitute("Неизвестный тип документа &1"
     2404                                          ,buf_trn-doc.doc-type
     2405                                          ) .
     2406           end.
     2407         end.
     2408       end.
     2409     end.
     2410   end procedure.
     2411   procedure prdoclib-prc-pl-document :
     2412     define input  parameter p-doc-code              as character no-undo .
     2413     define input  parameter p-obj-type              as character no-undo .
     2414     define input  parameter p-obj-code              as integer   no-undo .
     2415     define input  parameter p-gds-code              as integer   no-undo .
     2416     define output parameter p-total-pl-gds-qnty     as decimal   no-undo .
     2417     define output parameter p-total-pl-gds-cli-qnty as decimal   no-undo .
     2418     do
     2419     on error undo, return error return-value
     2420     :
     2421       define buffer buf_trn-doc      for ub.trn-doc .
     2422       define buffer buf_doc-pl       for ub.doc-pl .
     2423       define buffer buf_temp-pl-gds for temp-pl-gds .
     2424       define variable v-sign as decimal   no-undo .
     2425       find first buf_trn-doc no-lock
     2426         where buf_trn-doc.doc-code = p-doc-code
     2427         no-error .
     2428       if not available buf_trn-doc then do:
     2429         message
     2430           vss-workfile vss-revision vss-description skip
     2431           vss-include-info16 skip
     2432           "Ошибка при поиске документа" skip
     2433           "Документ" p-doc-code skip
     2434           "Объект" p-obj-type p-obj-code skip
     2435           "Товар" p-gds-code skip
     2436           view-as alert-box error .
     2437         undo, return error .
     2438       end.
     2439       assign
     2440         p-total-pl-gds-qnty     = 0
     2441         p-total-pl-gds-cli-qnty = 0
     2442       .
     2443       for each buf_doc-pl no-lock
     2444         where buf_doc-pl.out-code  = p-doc-code
     2445           and buf_doc-pl.gds-code  = p-gds-code
     2446       on error undo, return error return-value
     2447       :
     2448         find first buf_temp-pl-gds
     2449           where buf_temp-pl-gds.obj-type = buf_trn-doc.obj-type
     2450             and buf_temp-pl-gds.obj-code = buf_trn-doc.obj-code
     2451             and buf_temp-pl-gds.pl-code  = buf_doc-pl.pl-code
     2452           .
     2453         case buf_trn-doc.doc-type :
     2454           when 'при':U
     2455           or when 'возврат':U
     2456           or when 'инв':U
     2457           then do:
     2458             assign
     2459               v-sign = -1.0
     2460             .
     2461           end.
     2462           when 'рас':U or
     2463           when 'спи':U
     2464           then do:
     2465             assign
     2466               v-sign = 1.0
     2467             .
     2468           end.
     2469           otherwise do:
     2470             undo, return error substitute("(prdoclib-prc-pl-document) Неизвестный тип документа &1", buf_trn-doc.doc-type ) .
     2471           end.
     2472         end case.
     2473         assign
     2474           p-total-pl-gds-qnty           = p-total-pl-gds-qnty           + buf_doc-pl.fact-qnty     * v-sign
     2475           p-total-pl-gds-cli-qnty       = p-total-pl-gds-cli-qnty       + buf_doc-pl.cli-fact-qnty * v-sign
     2476           buf_temp-pl-gds.fact-qnty     = buf_temp-pl-gds.fact-qnty     + buf_doc-pl.fact-qnty     * v-sign
     2477           buf_temp-pl-gds.cli-fact-qnty = buf_temp-pl-gds.cli-fact-qnty + buf_doc-pl.cli-fact-qnty * v-sign
     2478         .
     2479       end.
     2480     end.
     2481   end procedure.
     2482   procedure prdoclib-init-prt-obj-by-date :
     2483     define input parameter p-obj-type   like ub.gds-obj.obj-type  no-undo .
     2484     define input parameter p-obj-code   like ub.gds-obj.obj-code  no-undo .
     2485     define input parameter p-artic      like ub.gds-obj.artic     no-undo .
     2486     define input parameter p-prod-type  like ub.gds-obj.prod-type no-undo .
     2487     define input parameter p-prod-code  like ub.gds-obj.prod-code no-undo .
     2488     define input parameter p-fact-date  as date      no-undo .
     2489     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-date: определение остатков по признакам на конец дня".
     2490     do
     2491     on error undo, return error return-value
     2492     :
     2493       define variable v-fact-order                as decimal   no-undo .
     2494       define variable v-shift-end-fact-order      as decimal   no-undo .
     2495       define variable v-day-end-fact-order        as decimal   no-undo .
     2496       run factord in this-procedure
     2497         (input  p-fact-date
     2498         ,input  1
     2499         ,input  1
     2500         ,input  ?
     2501         ,input  0
     2502         ,input  false
     2503         ,output v-fact-order
     2504         ,output v-shift-end-fact-order
     2505         ,output v-day-end-fact-order
     2506         ) no-error .
     2507       if error-status :error
     2508       then do:
     2509         message
     2510           vss-workfile vss-revision vss-description skip
     2511           vss-include-info16 skip
     2512           "Ошибка при определении момента времени, на который требуется остаток" skip
     2513           "Объект" p-obj-type p-obj-code skip
     2514           "Артикул" p-artic p-prod-type p-prod-code skip
     2515           "Дата" p-fact-date skip
     2516           view-as alert-box error .
     2517         undo, return error .
     2518       end.
     2519       run prdoclib-init-prt-obj-by-date-factord in this-procedure
     2520         (input p-obj-type
     2521         ,input p-obj-code
     2522         ,input p-artic
     2523         ,input p-prod-type
     2524         ,input p-prod-code
     2525         ,input v-day-end-fact-order
     2526         ,input false
     2527         ) no-error .
     2528       if error-status :error
     2529       then do:
     2530         message
     2531           vss-workfile vss-revision vss-description skip
     2532           vss-include-info16 skip
     2533           "Ошибка при вызове метода prdoclib-init-prt-obj-by-date-factord" skip
     2534           "Объект" p-obj-type p-obj-code skip
     2535           "Артикул" p-artic p-prod-type p-prod-code skip
     2536           "Дата" p-fact-date skip
     2537           view-as alert-box error .
     2538         undo, return error .
     2539       end.
     2540     end.
     2541   end procedure.
     2542   procedure prdoclib-calc-temp-fact-sale :
     2543     define input  parameter p-obj-type           as character no-undo .
     2544     define input  parameter p-obj-code           as integer   no-undo .
     2545     define input  parameter p-gds-code           as integer   no-undo .
     2546     define input  parameter p-day-end-fact-order as decimal   no-undo .
     2547     define input  parameter p-curr-r-b           as character no-undo .
     2548     define output parameter p-fact-qnty          as decimal   no-undo .
     2549     define output parameter p-cur-base           as decimal   no-undo .
     2550     define output parameter p-cur-VAT-base       as decimal   no-undo .
     2551     define output parameter p-cur-SLT-base       as decimal   no-undo .
     2552     define output parameter p-cur-road-tax-base  as decimal   no-undo .
     2553     define output parameter p-cur-excise-base    as decimal   no-undo .
     2554     define buffer buf_temp-prt-obj for temp-prt-obj .
     2555     define variable v-prt-b-code        like ub.bar-code.b-code no-undo .
     2556     define variable v-cli-base-rate     like ub.bar-code.cli-base-rate no-undo .
     2557     define variable parrecid-prl        as recid     no-undo .
     2558     define variable v-fact-qnty         as decimal   no-undo .
     2559     define variable v-cur-base          as decimal   no-undo .
     2560     define variable v-cur-VAT-base      as decimal   no-undo .
     2561     define variable v-cur-SLT-base      as decimal   no-undo .
     2562     define variable v-cur-road-tax-base as decimal   no-undo .
     2563     define variable v-cur-excise-base   as decimal   no-undo .
     2564     define variable price-rubl-with-tax-sale-prl    as decimal   no-undo .
     2565     define variable price-base-with-tax-sale-prl    as decimal   no-undo .
     2566     define variable price-rubl-without-tax-sale-prl as decimal   no-undo .
     2567     define variable price-base-without-tax-sale-prl as decimal   no-undo .
     2568     define variable vat-base-sale-prl               as decimal   no-undo .
     2569     define variable vat-rubl-sale-prl               as decimal   no-undo .
     2570     define variable vat-base-buyer-prl              as decimal   no-undo .
     2571     define variable vat-rubl-buyer-prl              as decimal   no-undo .
     2572     define variable slt-base-sale-prl               as decimal   no-undo .
     2573     define variable slt-rubl-sale-prl               as decimal   no-undo .
     2574     define variable road-tax-base-sale-prl          as decimal   no-undo .
     2575     define variable road-tax-rubl-sale-prl          as decimal   no-undo .
     2576     define variable excise-base-sale-prl            as decimal   no-undo .
     2577     define variable excise-rubl-sale-prl            as decimal   no-undo .
     2578     define variable discnt-base-sale-prl            as decimal   no-undo .
     2579     define variable discnt-rubl-sale-prl            as decimal   no-undo .
     2580     do
     2581     on error undo, return error return-value
     2582     :
     2583       for each buf_temp-prt-obj no-lock
     2584       on error undo, return error return-value
     2585       :
     2586   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2587     (input  p-gds-code
     2588     ,input  buf_temp-prt-obj.prt-code
     2589     ,output v-prt-b-code
     2590     ) no-error .
     2591         if error-status :error
     2592         then do:
     2593           message
     2594             vss-workfile vss-revision vss-description skip
     2595             "Ошибка при определении бар-кода признака" skip
     2596             "Код товара"   p-gds-code skip
     2597             "Код признака" buf_temp-prt-obj.prt-code skip
     2598             error-status :get-message(1) skip
     2599             return-value skip
     2600             view-as alert-box error .
     2601           undo, return error .
     2602         end.
     2603   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2604   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     2605     (input  p-obj-type
     2606     ,input  p-obj-code
     2607     ,input  v-prt-b-code
     2608     ,input  0
     2609     ,input  p-day-end-fact-order
     2610     ,output parrecid-prl
     2611     ,output v-cli-base-rate
     2612     ) no-error .
     2613         if error-status :error
     2614         then do:
     2615           message
     2616             vss-workfile vss-revision vss-description skip
     2617             "Ошибка при определении цены бар-кода" skip
     2618             "Объект" p-obj-type p-obj-code skip
     2619             "Бар-код" v-prt-b-code skip
     2620             "fact-order" p-day-end-fact-order skip
     2621             error-status :get-message(1) skip
     2622             return-value skip
     2623             view-as alert-box error .
     2624           undo, return error .
     2625         end.
     2626         if parrecid-prl <> ?
     2627         then do:
     2628           run prl-vat in this-procedure
     2629             (input  parrecid-prl
     2630             ,output price-rubl-with-tax-sale-prl
     2631             ,output price-base-with-tax-sale-prl
     2632             ,output price-rubl-without-tax-sale-prl
     2633             ,output price-base-without-tax-sale-prl
     2634             ,output vat-base-sale-prl
     2635             ,output vat-rubl-sale-prl
     2636             ,output vat-base-buyer-prl
     2637             ,output vat-rubl-buyer-prl
     2638             ,output slt-base-sale-prl
     2639             ,output slt-rubl-sale-prl
     2640             ,output road-tax-base-sale-prl
     2641             ,output road-tax-rubl-sale-prl
     2642             ,output excise-base-sale-prl
     2643             ,output excise-rubl-sale-prl
     2644             ,output discnt-base-sale-prl
     2645             ,output discnt-rubl-sale-prl
     2646             ) no-error .
     2647           if error-status :error
     2648           then do:
     2649             message
     2650               vss-workfile vss-revision vss-description skip
     2651               "Ошибка при вызове процеды prl-vat" skip
     2652               "Объект" p-obj-type p-obj-code skip
     2653               "Код товара" p-gds-code skip
     2654               "Указатель на запись переоценки" parrecid-prl skip
     2655               error-status :get-message(1) skip
     2656               return-value skip
     2657               view-as alert-box error .
     2658             undo, return error .
     2659           end.
     2660         end.
     2661         else do:
     2662           assign
     2663             price-rubl-with-tax-sale-prl    = 0
     2664             price-base-with-tax-sale-prl    = 0
     2665             price-rubl-without-tax-sale-prl = 0
     2666             price-base-without-tax-sale-prl = 0
     2667             vat-base-sale-prl               = 0
     2668             vat-rubl-sale-prl               = 0
     2669             slt-base-sale-prl               = 0
     2670             slt-rubl-sale-prl               = 0
     2671             road-tax-base-sale-prl          = 0
     2672             road-tax-rubl-sale-prl          = 0
     2673             excise-base-sale-prl            = 0
     2674             excise-rubl-sale-prl            = 0
     2675             discnt-base-sale-prl            = 0
     2676             discnt-rubl-sale-prl            = 0
     2677           .
     2678         end.
     2679         assign
     2680           v-fact-qnty         = v-fact-qnty
     2681                               + buf_temp-prt-obj.fact-qnty
     2682           v-cur-base          = v-cur-base
     2683                               + (if p-curr-r-b = 'base':U
     2684                                   then price-base-with-tax-sale-prl
     2685                                   else price-rubl-with-tax-sale-prl
     2686                                 )
     2687                               * buf_temp-prt-obj.fact-qnty
     2688           v-cur-VAT-base      = v-cur-VAT-base
     2689                               + (if p-curr-r-b = 'base':U
     2690                                   then vat-base-sale-prl
     2691                                   else vat-rubl-sale-prl
     2692                                 )
     2693                               * buf_temp-prt-obj.fact-qnty
     2694           v-cur-SLT-base      = v-cur-SLT-base
     2695                               + (if p-curr-r-b = 'base':U
     2696                                   then slt-base-sale-prl
     2697                                   else slt-rubl-sale-prl
     2698                                 )
     2699                               * buf_temp-prt-obj.fact-qnty
     2700           v-cur-road-tax-base = v-cur-road-tax-base
     2701                               + (if p-curr-r-b = 'base':U
     2702                                   then road-tax-base-sale-prl
     2703                                   else road-tax-rubl-sale-prl
     2704                                 )
     2705                               * buf_temp-prt-obj.fact-qnty
     2706           v-cur-excise-base   = v-cur-excise-base
     2707                               + (if p-curr-r-b = 'base':U
     2708                                   then excise-base-sale-prl
     2709                                   else excise-rubl-sale-prl
     2710                                 )
     2711                               * buf_temp-prt-obj.fact-qnty
     2712         .
     2713       end.
     2714       assign
     2715         p-fact-qnty         = v-fact-qnty
     2716         p-cur-base          = v-cur-base
     2717         p-cur-VAT-base      = v-cur-VAT-base
     2718         p-cur-SLT-base      = v-cur-SLT-base
     2719         p-cur-road-tax-base = v-cur-road-tax-base
     2720         p-cur-excise-base   = v-cur-excise-base
     2721       .
     2722     end.
     2723   end procedure.
     2724   procedure prdoclib-clear-temp-pl-gds :
     2725     define buffer buf_temp-pl-gds for temp-pl-gds .
     2726     do
     2727     on error undo, return error return-value
     2728     :
     2729       for each buf_temp-pl-gds
     2730       on error undo, return error return-value
     2731       :
     2732         delete buf_temp-pl-gds .
     2733       end.
     2734     end.
     2735   end procedure.
     2736   procedure prdoclib-init-temp-pl-gds :
     2737     define input parameter p-obj-type        like ub.pl-gds.obj-type  no-undo .
     2738     define input parameter p-obj-code        like ub.pl-gds.obj-code  no-undo .
     2739     define input parameter p-gds-code        like ub.pl-gds.gds-code  no-undo .
     2740     define buffer buf_pl-gds      for ub.pl-gds .
     2741     define buffer buf_temp-pl-gds for temp-pl-gds .
     2742     do
     2743     on error undo, return error return-value
     2744     :
     2745       run prdoclib-clear-temp-pl-gds in this-procedure .
     2746       for each buf_pl-gds
     2747         where buf_pl-gds.obj-type = p-obj-type
     2748           and buf_pl-gds.obj-code = p-obj-code
     2749           and buf_pl-gds.gds-code = p-gds-code
     2750       on error undo, return error return-value
     2751       :
     2752         create buf_temp-pl-gds .
     2753         buffer-copy buf_pl-gds to buf_temp-pl-gds .
     2754       end.
     2755     end.
     2756   end procedure.
     2757   procedure prdoclib-init-pl-gds-by-factord :
     2758     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     2759     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     2760     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     2761     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     2762     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     2763     define input parameter p-fact-order         as decimal   no-undo .
     2764     define input parameter p-include-fact-order as logical   no-undo .
     2765     define variable vss-description as character no-undo init "prdoclib-init-pl-gds-by-factord: определение остатков по признакам на любой момент времени".
     2766     define buffer buf_goods       for ub.goods .
     2767     define buffer buf_gds-obj     for ub.gds-obj .
     2768     define buffer buf_doc-line    for ub.doc-line .
     2769     define buffer buf_temp-pl-gds for temp-pl-gds .
     2770     define variable v-total-pl-gds-qnty     as decimal   no-undo .
     2771     define variable v-total-pl-gds-cli-qnty as decimal   no-undo .
     2772     do
     2773     on error undo, return error return-value
     2774     :
     2775       do transaction
     2776       on error undo, return error return-value
     2777       :
     2778   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2779   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     2780     (input  p-obj-type
     2781     ,input  p-obj-code
     2782     ,input  p-artic
     2783     ,input  p-prod-type
     2784     ,input  p-prod-code
     2785     ,buffer buf_gds-obj
     2786     ) no-error .
     2787         if error-status :error
     2788         then do:
     2789           message
     2790             vss-workfile vss-revision vss-description skip
     2791             vss-include-info16 skip
     2792             "Невозможно найти gds-obj" skip
     2793             error-status :get-message(1) skip
     2794             return-value skip
     2795             view-as alert-box error .
     2796           undo, return error return-value .
     2797         end.
     2798         find current buf_gds-obj exclusive-lock .
     2799       end.
     2800       find first buf_goods no-lock
     2801         where buf_goods.artic     = p-artic
     2802           and buf_goods.prod-type = p-prod-type
     2803           and buf_goods.prod-code = p-prod-code
     2804         .
     2805       run prdoclib-init-temp-pl-gds in this-procedure
     2806         (input p-obj-type
     2807         ,input p-obj-code
     2808         ,input buf_goods.gds-code
     2809         ) .
     2810       if p-include-fact-order = true
     2811       then do:
     2812         assign
     2813          p-fact-order = p-fact-order - 0.0000000001
     2814         .
     2815       end.
     2816       for each buf_doc-line no-lock
     2817         where buf_doc-line.obj-type   = p-obj-type
     2818           and buf_doc-line.obj-code   = p-obj-code
     2819           and buf_doc-line.artic      = p-artic
     2820           and buf_doc-line.prod-type  = p-prod-type
     2821           and buf_doc-line.prod-code  = p-prod-code
     2822           and buf_doc-line.status_    = 'факт':U
     2823           and buf_doc-line.fact-order >= p-fact-order
     2824       on error undo, return error return-value
     2825       :
     2826         run prdoclib-prc-pl-document in this-procedure
     2827           ( input  buf_doc-line.doc-code
     2828            ,input  p-obj-type
     2829            ,input  p-obj-code
     2830            ,input  buf_goods.gds-code
     2831            ,output v-total-pl-gds-qnty
     2832            ,output v-total-pl-gds-cli-qnty
     2833           ) .
     2834       end.
     2835     end.
     2836   end procedure.
     2837   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     2838     if num-entries(string(p-dec), '.') = 2
     2839       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     2840       else return( string(p-dec)) .
     2841   end function.
     2842   function format-point-to-comma returns char (input orig as char ) .
     2843   define variable rtext as character no-undo .
     2844   define variable strt as integer no-undo .
     2845   define variable leng as integer no-undo .
     2846   assign rtext = orig .
     2847   repeat:
     2848     strt =  index(rtext,'.').
     2849     if strt = 0 then leave.
     2850     leng = 1.
     2851     substring(rtext,strt,leng,"character") = v-delim .
     2852   end.
     2853   return rtext.
     2854   end function.
     2855   function format-excel-text returns char ( input start-text as char ) :
     2856   def var  i    as int no-undo.
     2857   def var  ch   as char no-undo.
     2858   def var  n    as int no-undo.
     2859   def var  ipos as int no-undo.
     2860     n = num-entries(trim(start-text), chr(10)) - 1 .
     2861     do i = 1 to n :
     2862       ipos = index( start-text, chr(10)).
     2863       if ipos > 0 then
     2864         substr( start-text, ipos, 1 ) = ' '.
     2865     end.
     2866     n = num-entries(trim(start-text), chr(13)) - 1 .
     2867     do i = 1 to n :
     2868       ipos = index( start-text, chr(13)).
     2869       if ipos > 0 then
     2870         substr( start-text, ipos, 1 ) = ' '.
     2871     end.
     2872     if index( start-text, '"' ) = 0 then
     2873       start-text =  '="'   + trim( start-text) + '"'   .
     2874       else do:
     2875         n = num-entries(trim(start-text), '"') - 1.
     2876         do i = 1 to n :
     2877           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     2878         end.
     2879         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     2880         start-text = '="'  + ch  + '"' .
     2881       end.
     2882     return start-text.
     2883   end.
     2884   function excel-sum returns char (input p-dec as decimal ).
     2885     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     2886   end function.
     2887   function excel-qnty returns char (input p-dec as decimal ).
     2888     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     2889   end function.
     2890   function format-excel-text-macr returns char ( input start-text as char ) :
     2891   def var  i    as int no-undo.
     2892   def var  ch   as char no-undo.
     2893   def var  n    as int no-undo.
     2894   def var  ipos as int no-undo.
     2895     n = num-entries(trim(start-text), chr(10)) - 1 .
     2896     do i = 1 to n :
     2897       ipos = index( start-text, chr(10)).
     2898       if ipos > 0 then
     2899         substring( start-text, ipos , 1 ) = ' '.
     2900     end.
     2901     n = num-entries(trim(start-text), chr(13)) - 1 .
     2902     do i = 1 to n :
     2903       ipos = index( start-text, chr(13)).
     2904       if ipos > 0 then
     2905         substring( start-text, ipos, 1 ) = ' '.
     2906     end.
     2907     if index( start-text, '"' ) = 0 then
     2908       start-text =  '"'   + trim( start-text) + '"'   .
     2909       else do:
     2910         n = num-entries(trim(start-text), '"') - 1.
     2911         do i = 1 to n :
     2912           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     2913         end.
     2914         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     2915         start-text = '"'  + ch  + '"' .
     2916       end.
     2917     n = num-entries(trim(start-text), chr(10)) - 1 .
     2918     do i = 1 to n :
     2919       ipos = index( start-text, chr(10)).
     2920       if ipos > 0 then
     2921         substring( start-text, ipos , 1 ) = ' '.
     2922     end.
     2923       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     2924     return start-text.
     2925   end.
     2926   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2927   FUNCTION determined RETURNS DECIMAL (INPUT parundefine-var AS DECIMAL):
     2928      IF parundefine-var = ? THEN RETURN 0.00.
     2929                             ELSE RETURN parundefine-var.
     2930   END FUNCTION.
     2931   FUNCTION dtm-char RETURNS CHARACTER (INPUT p-undef-char AS CHARACTER):
     2932      IF p-undef-char = ? THEN do:
     2933        RETURN "?".
     2934      end.
     2935      ELSE do:
     2936        RETURN p-undef-char .
     2937      end.
     2938   END FUNCTION.
