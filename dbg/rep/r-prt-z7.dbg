     9593       define variable price-cli-without-tax-loco-prl  like ub.doc-line.price-base no-undo.
     9594       define variable vat-base-loco-prl               like ub.doc-line.price-base no-undo.
     9595       define variable vat-rubl-loco-prl               like ub.doc-line.price-rubl no-undo.
     9596       define variable vat-cli-loco-prl                like ub.doc-line.price-rubl no-undo.
     9597       define variable slt-base-loco-prl               like ub.doc-line.price-base no-undo.
     9598       define variable slt-rubl-loco-prl               like ub.doc-line.price-rubl no-undo.
     9599       define variable slt-cli-loco-prl                like ub.doc-line.price-rubl no-undo.
     9600       define variable road-tax-base-loco-prl          like ub.doc-line.road-tax   no-undo.
     9601       define variable road-tax-rubl-loco-prl          like ub.doc-line.road-tax   no-undo.
     9602       define variable road-tax-cli-loco-prl           like ub.doc-line.road-tax   no-undo.
     9603       define variable transport-base-loco-prl         like ub.doc-line.price-base no-undo.
     9604       define variable transport-rubl-loco-prl         like ub.doc-line.price-rubl no-undo.
     9605       define variable transport-cli-loco-prl          like ub.doc-line.price-rubl no-undo.
     9606       define variable other-base-loco-prl             like ub.doc-line.price-base no-undo.
     9607       define variable other-rubl-loco-prl             like ub.doc-line.price-rubl no-undo.
     9608       define variable other-cli-loco-prl              like ub.doc-line.price-rubl no-undo.
     9609       define variable exch-rate-cli-loco-prl          like ub.trn-doc.exch-rate   no-undo.
     9610       define variable varinvatp-envdo-prl             as   character              no-undo.
     9611       define variable varinvatp-typeo-prl             as   character              no-undo.
     9612   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9613   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     9614     (input  gds-obj.obj-type
     9615     ,input  gds-obj.obj-code
     9616     ,input  v-bar-code
     9617     ,input  0
     9618     ,input  fact-order-2
     9619     ,output parrecid-prl
     9620     ,output v-cli-base-rate
     9621     ) no-error .
     9622                 if error-status :error then do:
     9623                   message
     9624                     vss-workfile vss-revision vss-description skip
     9625                     "Ошибка при определении цены бар-кода" skip
     9626                     "Объект" gds-obj.obj-type gds-obj.obj-code skip
     9627                     "Бар-код" v-bar-code skip
     9628                     "fact-order" fact-order-2 skip
     9629                     error-status :get-message(1) skip
     9630                     return-value skip
     9631                     view-as alert-box error .
     9632                 end.
     9633           if parrecid-prl <> ? then do:
     9634             run prl-vat in this-procedure
     9635               (input  parrecid-prl
     9636               ,output price-rubl-with-tax-sale-prl
     9637               ,output price-base-with-tax-sale-prl
     9638               ,output price-rubl-without-tax-sale-prl
     9639               ,output price-base-without-tax-sale-prl
     9640               ,output vat-base-sale-prl
     9641               ,output vat-rubl-sale-prl
     9642               ,output vat-base-buyer-prl
     9643               ,output vat-rubl-buyer-prl
     9644               ,output slt-base-sale-prl
     9645               ,output slt-rubl-sale-prl
     9646               ,output road-tax-base-sale-prl
     9647               ,output road-tax-rubl-sale-prl
     9648               ,output excise-base-sale-prl
     9649               ,output excise-rubl-sale-prl
     9650               ,output discnt-base-sale-prl
     9651               ,output discnt-rubl-sale-prl
     9652               ) no-error .
     9653                   if error-status :error then do:
     9654                     message
     9655                       vss-workfile vss-revision vss-description skip
     9656                       "Ошибка при вызове процеды prl-vat" skip
     9657                       "Документ" ub.doc-line.doc-code skip
     9658                       "Артикул" ub.doc-line.artic ub.doc-line.prod-type ub.doc-line.prod-code skip
     9659                       error-status :get-message(1) skip
     9660                       return-value skip
     9661                       view-as alert-box error .
     9662                   end.
     9663           end.
     9664           else do:
     9665             assign
     9666               price-rubl-with-tax-sale-prl    = 0
     9667               price-base-with-tax-sale-prl    = 0
     9668             .
     9669           end.
     9670     assign
     9671       v-cur-base = price-rubl-with-tax-sale-prl
     9672     .
     9673   end procedure.
