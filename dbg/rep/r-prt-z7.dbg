     9561       define variable varvatcons-rubl-factovp-prl  like ub.gds-dtl.price-base               no-undo.
     9562       define variable vardsc-rubl-factovp-prl      like ub.gds-dtl.price-base               no-undo.
     9563       define variable varsum-rubl-docovp-prl       like ub.gds-dtl.price-base               no-undo.
     9564       define variable varslt-rubl-docovp-prl       like ub.gds-dtl.price-base               no-undo.
     9565       define variable varvat-rubl-docovp-prl       like ub.gds-dtl.price-base               no-undo.
     9566       define variable varvatcons-rubl-docovp-prl   like ub.gds-dtl.price-base               no-undo.
     9567       define variable vardsc-rubl-docovp-prl       like ub.gds-dtl.price-base               no-undo.
     9568       define variable varfact-qnty-prl             like ub.parts.fact-qnty                  no-undo.
     9569       define variable varcons-qnty-prl             like ub.parts.fact-qnty                  no-undo.
     9570       define variable varis-one-gds-dtl-prl        as   logical                             no-undo.
     9571       define variable varcur-prlprice-base         like ub.gds-dtl.cur-base                 no-undo.
