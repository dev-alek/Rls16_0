      661     ) no-error .
      662   if error-status :error then do:
      663     message
      664       vss-workfile vss-revision vss-description skip
      665       "Ошибка при определении атрибута признака" skip
      666       "Артикул" ub.doc-line.artic ub.doc-line.prod-type ub.doc-line.prod-code skip
