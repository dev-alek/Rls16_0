     1449       if t-doc.doc-type = 'инв':U then do:
     1450         ASSIGN
     1451                   price-base-with-tax-sale    = varsum-base-docovp / varfact-qnty
     1452           slt-base-sale               = varslt-base-docovp / varfact-qnty
     1453           vat-base-buyer              = varvat-base-docovp / varfact-qnty
     1454           discnt-base-sale            = vardsc-base-docovp / varfact-qnty
     1455           vat-base-sale               = varvatcons-base-docovp / varfact-qnty
     1456                   price-rubl-with-tax-sale    = varsum-rubl-docovp / varfact-qnty
     1457           slt-rubl-sale               = varslt-rubl-docovp / varfact-qnty
     1458           vat-rubl-buyer              = varvat-rubl-docovp / varfact-qnty
     1459           discnt-rubl-sale            = vardsc-rubl-docovp / varfact-qnty
     1460           vat-rubl-sale               = varvatcons-rubl-docovp / varfact-qnty.
     1461       end.
     1462       else do:
     1463         ASSIGN
     1464                   price-base-with-tax-sale    = varsum-base-factovp / varfact-qnty
     1465           slt-base-sale               = varslt-base-factovp / varfact-qnty
     1466           vat-base-buyer              = varvat-base-factovp / varfact-qnty
     1467           discnt-base-sale            = vardsc-base-factovp / varfact-qnty
