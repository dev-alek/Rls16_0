      674   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      675   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      676     (output varoutvprb
      677     )  .
      678   if varoutvprb = "base":u then do:
      679     assign
      680           road-tax-base-sale    =  (if ub.doc-line.road-tax = ? then 0 else ub.doc-line.road-tax * 1)
      681       excise-base-sale      =  (if ub.doc-line.excise   = ? then 0 else ub.doc-line.excise   * 1)
      682     .
      683   end.
      684   else do:
      685     assign
      686           road-tax-base-sale    =  (if ub.doc-line.road-tax = ? then 0 else ub.doc-line.road-tax / t-doc.base-rate * t-doc.base-scale)
      687       excise-base-sale      =  (if ub.doc-line.excise   = ? then 0 else ub.doc-line.excise   / t-doc.base-rate * t-doc.base-scale)
      688     .
      689   end.
      690   if varoutvprb = "rubl":u then do:
      691     assign
      692           road-tax-rubl-sale    = (if ub.doc-line.road-tax = ? then 0 else ub.doc-line.road-tax * 1)
      693       excise-rubl-sale      = (if ub.doc-line.excise   = ? then 0 else ub.doc-line.excise   * 1) .
      694   end.
      695   else do:
      696     assign
      697           road-tax-rubl-sale    = (if ub.doc-line.road-tax = ? then 0 else ub.doc-line.road-tax * t-doc.base-rate / t-doc.base-scale)
      698       excise-rubl-sale      = (if ub.doc-line.excise   = ? then 0 else ub.doc-line.excise   * t-doc.base-rate / t-doc.base-scale) .
      699   end.
      700   assign
      701     varis-cons-parts-have =  no.
      702   assign
      703     varfact-qnty       = 0
      704     varcons-qnty       = 0
      705     varprice-base-cons = 0
      706     varprice-rubl-cons = 0.
      707   find first out-vatp_doc-line where
      708              out-vatp_doc-line.doc-code   = t-doc.doc-code
      709          and out-vatp_doc-line.artic      = ub.doc-line.artic
      710          and out-vatp_doc-line.prod-type  = ub.doc-line.prod-type
      711          and out-vatp_doc-line.prod-code  = ub.doc-line.prod-code no-lock no-error.
      712   if available out-vatp_doc-line           and
      713     (out-vatp_doc-line.status_ = 'запрос':U or out-vatp_goods.gds-type = 'у':U) then do:
      714     assign
      715       varfact-qnty = out-vatp_doc-line.fact-qnty.
      716   end.
      717   else do:
      718     for each out-vatp_parts where out-vatp_parts.out-code   = t-doc.doc-code
      719                                  and out-vatp_parts.obj-type   = t-doc.obj-type
      720                                  and out-vatp_parts.obj-code   = t-doc.obj-code
      721                                  and out-vatp_parts.artic      = ub.doc-line.artic
      722                                  and out-vatp_parts.prod-type  = ub.doc-line.prod-type
      723                                  and out-vatp_parts.prod-code  = ub.doc-line.prod-code no-lock :
      724       if out-vatp_parts.purch-code = 2 then do:
      725   assign
