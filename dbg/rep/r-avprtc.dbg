      206   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      207   function breakstr returns character ( input        for-name    as character,
      208                                         input        line-length as integer,
      209                                         input-output line1       as character,
      210                                         input-output line2       as character ) :
      211     define variable ii as integer no-undo.
      212     if length( for-name ) > line-length then do:
      213       assign ii    = 1
      214              line1 = "":u
      215              line2 = "":u.
      216       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
      217         assign line1 =       substring( for-name, 1, line-length     )
      218                line2 = trim( substring( for-name,    line-length + 1 ) ).
      219       end.                                                     else do:
      220         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
      221           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
      222                  ii    = ii    + 1.
      223           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
      224             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
      225           end.
      226         end.
      227         assign line2 = trim( substring( for-name, length( line1 ) ) ).
      228       end.
      229     end.                                else do:
      230       assign line1 = for-name
      231              line2 = "":u.
      232     end.
      233     return ( line1 ).
      234   end function.
