      800   assign
      801     varsum-base-factovp     = 0
      802     varslt-base-factovp     = 0
      803     varvat-base-factovp     = 0
      804     varvatcons-base-factovp = 0
      805     vardsc-base-factovp     = 0
      806     varsum-base-docovp      = 0
      807     varslt-base-docovp      = 0
      808     varvat-base-docovp      = 0
      809     varvatcons-base-docovp  = 0
      810     vardsc-base-docovp      = 0
      811     varsum-rubl-factovp     = 0
      812     varslt-rubl-factovp     = 0
      813     varvat-rubl-factovp     = 0
      814     varvatcons-rubl-factovp = 0
      815     vardsc-rubl-factovp     = 0
      816     varsum-rubl-docovp      = 0
      817     varslt-rubl-docovp      = 0
      818     varvat-rubl-docovp      = 0
      819     varvatcons-rubl-docovp  = 0
      820     vardsc-rubl-docovp      = 0.
      821   assign
      822     varis-one-gds-dtl = no.
      823   find first out-vatp_gds-dtl where out-vatp_gds-dtl.doc-code  = t-doc.doc-code  and
      824                                        out-vatp_gds-dtl.artic     = ub.doc-line.artic     and
      825                                        out-vatp_gds-dtl.prod-type = ub.doc-line.prod-type and
      826                                        out-vatp_gds-dtl.prod-code = ub.doc-line.prod-code no-lock no-error.
      827   if available out-vatp_gds-dtl then do:
      828     find first buf_out-vatp_gds-dtl where buf_out-vatp_gds-dtl.doc-code  =  t-doc.doc-code                and
      829                                              buf_out-vatp_gds-dtl.artic     =  ub.doc-line.artic                   and
      830                                              buf_out-vatp_gds-dtl.prod-type =  ub.doc-line.prod-type               and
      831                                              buf_out-vatp_gds-dtl.prod-code =  ub.doc-line.prod-code               and
      832                                              recid(buf_out-vatp_gds-dtl)    <> recid(out-vatp_gds-dtl) no-lock no-error.
      833     if not available buf_out-vatp_gds-dtl then do:
      834       assign
      835         varis-one-gds-dtl = yes.
      836     end.
      837     if varoutvprb = "base":u then do:
      838       assign
      839         varcurprice-base = out-vatp_gds-dtl.cur-base
      840         varcurprice-rubl = out-vatp_gds-dtl.cur-base * ((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) / (out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base)).
      841     end.
      842     else do:
      843       assign
      844         varcurprice-base = out-vatp_gds-dtl.cur-base / ((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) / (out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base))
      845         varcurprice-rubl = out-vatp_gds-dtl.cur-base.
      846     end.
      847     if varempty-scale    = yes or
      848        varis-one-gds-dtl = yes   then do:
      849       assign
      850                   price-base-with-tax-sale    = (out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base)
      851           slt-base-sale               = (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc)
      852           vat-base-buyer              = (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-base-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc)
      853           discnt-base-sale            = out-vatp_gds-dtl.discnt-base
      854                   price-rubl-with-tax-sale    = (out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl)
      855           slt-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc)
      856           vat-rubl-buyer              = (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-rubl-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc)
      857           discnt-rubl-sale            = out-vatp_gds-dtl.discnt-rubl
      858           .
      859       if t-doc.doc-type = 'инв':U then do:
      860         ASSIGN
      861                   vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * ub.doc-line.cons-vat-pc / (100 + ub.doc-line.cons-vat-pc) * out-vatp_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-base-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc) * out-vatp_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
      862                   vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * ub.doc-line.cons-vat-pc / (100 + ub.doc-line.cons-vat-pc) * out-vatp_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-rubl-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc) * out-vatp_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
      863           .
      864       end.
      865       else do:
      866         ASSIGN
      867                   vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * ub.doc-line.cons-vat-pc / (100 + ub.doc-line.cons-vat-pc) * out-vatp_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-base-sale ) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc) * out-vatp_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
      868                   vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * ub.doc-line.cons-vat-pc / (100 + ub.doc-line.cons-vat-pc) * out-vatp_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-rubl-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc) * out-vatp_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
      869           .
      870       end.
      871     end.
      872     else do:
      873       for each out-vatp_gds-dtl where out-vatp_gds-dtl.doc-code  = t-doc.doc-code  and
      874                                          out-vatp_gds-dtl.artic     = ub.doc-line.artic     and
      875                                          out-vatp_gds-dtl.prod-type = ub.doc-line.prod-type and
      876                                          out-vatp_gds-dtl.prod-code = ub.doc-line.prod-code no-lock :
      877         if varoutvprb = "base":u then do:
      878           assign
      879             varcurprice-base = out-vatp_gds-dtl.cur-base
      880             varcurprice-rubl = out-vatp_gds-dtl.cur-base * ((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) / (out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base)).
      881         end.
      882         else do:
      883           assign
      884             varcurprice-base = out-vatp_gds-dtl.cur-base / ((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) / (out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base))
      885             varcurprice-rubl = out-vatp_gds-dtl.cur-base.
      886         end.
      887         assign
      888                varsum-base-factovp = varsum-base-factovp + (out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base)                 * out-vatp_gds-dtl.fact-qnty
      889          varslt-base-factovp = varslt-base-factovp + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc)                   * out-vatp_gds-dtl.fact-qnty
      890          varvat-base-factovp = varvat-base-factovp + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-base-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc)                   * out-vatp_gds-dtl.fact-qnty
      891          varvatcons-base-factovp = varvatcons-base-factovp + (((out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * ub.doc-line.cons-vat-pc / (100 + ub.doc-line.cons-vat-pc) * out-vatp_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-base-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc) * out-vatp_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty)
      892          vardsc-base-factovp = vardsc-base-factovp + out-vatp_gds-dtl.discnt-base * out-vatp_gds-dtl.fact-qnty
      893          varsum-base-docovp  = varsum-base-docovp  + (out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base)                 * out-vatp_gds-dtl.doc-qnty
      894          varslt-base-docovp  = varslt-base-docovp  + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc)                   * out-vatp_gds-dtl.doc-qnty
      895          varvat-base-docovp  = varvat-base-docovp  + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-base-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc)                   * out-vatp_gds-dtl.doc-qnty
      896          varvatcons-base-docovp  = varvatcons-base-docovp  + (((out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * ub.doc-line.cons-vat-pc / (100 + ub.doc-line.cons-vat-pc) * out-vatp_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-base-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc) * out-vatp_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty)
      897          vardsc-base-docovp  = vardsc-base-docovp  + out-vatp_gds-dtl.discnt-base * out-vatp_gds-dtl.doc-qnty
      898         .
      899         assign
      900                varsum-rubl-factovp = varsum-rubl-factovp + (out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl)                 * out-vatp_gds-dtl.fact-qnty
      901          varslt-rubl-factovp = varslt-rubl-factovp + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc)                   * out-vatp_gds-dtl.fact-qnty
      902          varvat-rubl-factovp = varvat-rubl-factovp + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-rubl-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc)                   * out-vatp_gds-dtl.fact-qnty
      903          varvatcons-rubl-factovp = varvatcons-rubl-factovp + (((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * ub.doc-line.cons-vat-pc / (100 + ub.doc-line.cons-vat-pc) * out-vatp_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-rubl-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc) * out-vatp_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty)
      904          vardsc-rubl-factovp = vardsc-rubl-factovp + out-vatp_gds-dtl.discnt-rubl * out-vatp_gds-dtl.fact-qnty
      905          varsum-rubl-docovp  = varsum-rubl-docovp  + (out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl)                 * out-vatp_gds-dtl.doc-qnty
      906          varslt-rubl-docovp  = varslt-rubl-docovp  + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc)                   * out-vatp_gds-dtl.doc-qnty
      907          varvat-rubl-docovp  = varvat-rubl-docovp  + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-rubl-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc)                   * out-vatp_gds-dtl.doc-qnty
      908          varvatcons-rubl-docovp  = varvatcons-rubl-docovp  + (((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * ub.doc-line.cons-vat-pc / (100 + ub.doc-line.cons-vat-pc) * out-vatp_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-rubl-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc) * out-vatp_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty)
      909          vardsc-rubl-docovp  = vardsc-rubl-docovp  + out-vatp_gds-dtl.discnt-rubl * out-vatp_gds-dtl.doc-qnty   .
      910       end.
      911       if t-doc.doc-type = 'инв':U then do:
      912         ASSIGN
      913                   price-base-with-tax-sale    = varsum-base-docovp / varfact-qnty
      914           slt-base-sale               = varslt-base-docovp / varfact-qnty
      915           vat-base-buyer              = varvat-base-docovp / varfact-qnty
      916           discnt-base-sale            = vardsc-base-docovp / varfact-qnty
      917           vat-base-sale               = varvatcons-base-docovp / varfact-qnty
      918                   price-rubl-with-tax-sale    = varsum-rubl-docovp / varfact-qnty
      919           slt-rubl-sale               = varslt-rubl-docovp / varfact-qnty
      920           vat-rubl-buyer              = varvat-rubl-docovp / varfact-qnty
      921           discnt-rubl-sale            = vardsc-rubl-docovp / varfact-qnty
      922           vat-rubl-sale               = varvatcons-rubl-docovp / varfact-qnty.
      923       end.
      924       else do:
      925         ASSIGN
      926                   price-base-with-tax-sale    = varsum-base-factovp / varfact-qnty
      927           slt-base-sale               = varslt-base-factovp / varfact-qnty
      928           vat-base-buyer              = varvat-base-factovp / varfact-qnty
      929           discnt-base-sale            = vardsc-base-factovp / varfact-qnty
      930           vat-base-sale               = varvatcons-base-factovp / varfact-qnty
      931                   price-rubl-with-tax-sale    = varsum-rubl-factovp / varfact-qnty
      932           slt-rubl-sale               = varslt-rubl-factovp / varfact-qnty
      933           vat-rubl-buyer              = varvat-rubl-factovp / varfact-qnty
      934           discnt-rubl-sale            = vardsc-rubl-factovp / varfact-qnty
      935           vat-rubl-sale               = varvatcons-rubl-factovp / varfact-qnty.
      936       end.
      937     end.
      938   end.
      939   assign
      940     price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
      941     price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
      942                           assign price-noNDS = ( if PrintRubl then price-rubl-without-tax-sale else price-base-without-tax-sale ) .
      943                       end.
      944                   assign
      945                     price-noNDS = round( price-noNDS , 2 )
      946                     prt-tqnty =  ub.gds-dtl.fact-qnty
      947                     VAT-gds = round( (price-noNDS * ub.doc-line.vat-pc / 100 ), 2 )
      948                     SLT-gds = round( ( (price-noNDS + VAT-gds) * prt-tqnty * torg-SLT-pc / 100 ), 2 )
      949                     price-withNDS = round( ( price-noNDS + VAT-gds + SLT-gds / prt-tqnty ) , 2 )
      950                     .
      951                   if VAT-gds = ? then VAT-gds = 0.
      952                   if SLT-gds = ? then SLT-gds = 0.
      953                   assign
      954                       prt-VAT-gds = VAT-gds * prt-tqnty
      955                       prt-SLT-gds = SLT-gds
      956                       prt-stoim-noNDS = price-noNDS * prt-tqnty
      957                       prt-stoim = prt-stoim-noNDS + prt-VAT-gds
      958                       .
      959                   ACCUMULATE
      960                       prt-tqnty (TOTAL)
      961                       prt-VAT-gds ( TOTAL )
      962                       prt-SLT-gds ( TOTAL )
      963                       prt-stoim-noNDS ( TOTAL )
      964                       prt-stoim ( TOTAL )
      965                       .
      966                   if PrintScale then
      967                       do:
      968                           FIND ub.bar-code WHERE ub.bar-code.gds-code = ub.goods.gds-code
      969                                           AND ub.bar-code.unit-cli = ub.goods.unit-base
      970                                           AND ub.bar-code.node-code = ub.gds-dtl.prt-code
      971                                           AND ub.bar-code.part-code = ""
      972                                           AND ub.bar-code.in-code = ""
      973                                         NO-LOCK .
      974                           PrtName = "".
      975                           DO WHILE available ub.gds-prt:
      976                               if available ub.gds-prt then
      977                                   PrtName = "\" + string( ub.gds-prt.node-name, "x(10)" ) + PrtName.
      978                               Node_Code = ub.gds-prt.upper-code.
      979                               FIND ub.gds-prt WHERE ub.gds-prt.node-code = Node_Code
      980                                                                  AND ub.gds-prt.root <> yes NO-LOCK NO-ERROR.
      981                           END.
      982                           DISPLAY STREAM Out-Stream
      983                                   PrtName @ ub.goods.gds-name
      984                                   string( ub.bar-code.b-code ) @ tb-code
      985                                   ub.units.long-name
      986                                   prod-name @ cli-prod.obj-name
      987                                   (if PriceWithTax then price-withNDS else price-noNDS) @ price-withNDS
      988                                   sym1 sym2 sym7 sym8 sym9
      989                                   with frame f-doc .
      990                           DOWN STREAM Out-Stream 1 with FRAME f-doc .
      991                       end.
      992               END.
      993               assign
      994                   tqnty = ( ACCUM TOTAL prt-tqnty )
      995                   VAT-gds = ( ACCUM TOTAL prt-VAT-gds )
      996                   SLT-gds = ( ACCUM TOTAL prt-SLT-gds )
      997                   stoim-noNDS = ( ACCUM TOTAL prt-stoim-noNDS )
      998                   stoim = ( ACCUM TOTAL prt-stoim )
      999                   .
     1000               if NOT PrintScale then
     1001                   do:
     1002                       FIND ub.bar-code WHERE ub.bar-code.gds-code = ub.goods.gds-code
     1003                                       AND ub.bar-code.unit-cli = ub.goods.unit-base
     1004                                       AND ub.bar-code.node-code = rootnode_code
