     1474       end.
     1475     end.
     1476   end.
     1477   assign
     1478     price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     1479     price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     1480                               assign price-noNDS = ( if PrintRubl then price-rubl-without-tax-sale else price-base-without-tax-sale ).
     1481                           end.
     1482                       assign
     1483                         price-noNDS = round( price-noNDS , 2 )
     1484                         VAT-gds = round( (price-noNDS * ub.doc-line.vat-pc / 100 ), 2 )
     1485                         SLT-gds = round( ( (price-noNDS + VAT-gds) * tqnty * torg-SLT-pc / 100 ), 2 )
     1486                         price-withNDS = round( ( price-noNDS + VAT-gds + SLT-gds / tqnty ) , 2 )
     1487                         .
     1488               if VAT-gds = ? then VAT-gds = 0.
     1489               if SLT-gds = ? then SLT-gds = 0.
     1490               assign
     1491                   VAT-gds = VAT-gds * tqnty
     1492                   stoim-noNDS = price-noNDS * tqnty
     1493                   stoim = stoim-noNDS + VAT-gds
     1494                   .
     1495               DISPLAY STREAM Out-Stream
     1496                   LineCounter
     1497                   ub.goods.artic
     1498                   gds-str1 @ ub.goods.gds-name
     1499                   string( ub.bar-code.b-code ) @ tb-code
     1500                   prod-name @ cli-prod.obj-name
     1501                   ub.units.long-name
     1502                   (if PriceWithTax then price-withNDS else price-noNDS) @ price-withNDS
     1503                   sym1 sym2 sym7 sym8 sym9
     1504                   with frame f-doc .
     1505               DOWN STREAM Out-Stream 1 with FRAME f-doc .
     1506               LineCounter = LineCounter + 1.
     1507           end.
     1508       ACCUMULATE
     1509           tqnty (TOTAL)
     1510           VAT-gds ( TOTAL )
     1511           SLT-gds ( TOTAL )
     1512           stoim-noNDS ( TOTAL )
     1513           stoim ( TOTAL )
     1514           .
     1515   END.
     1516   if line-counter( Out-Stream ) + 13 > page-size( Out-Stream ) then
     1517       page STREAM Out-Stream .
     1518   PUT STREAM Out-Stream  Line format "X(136)" SKIP(1) SPACE(5) "Всего "
     1519           ( LineCounter - 1 ) format ">,>>>,>>9" SPACE(2)
     1520           "наименований" format "x(13)" SKIP(1) .
     1521   define variable v-user-name as character no-undo .
     1522   define variable vss-include-info16 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1523   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
     1524     (input  v-cntxt-userid
     1525     ,output v-user-name
     1526     )  .
     1527   PUT STREAM Out-Stream SKIP(1) SPACE(10) "Подписи сторон" format "x(100)" SKIP(1)
     1528           SPACE(10) "Генеральный директор : " format "x(70)" SKIP(1)
     1529           SPACE(10) "Планово-экономический отдел : " format "x(70)" SKIP(1)
     1530           SPACE(10) "Управляющий  магазином : " format "x(70)" SKIP(3)
     1531           SPACE(20) string( "Исполнитель : " + v-user-name ) format "x(70)" SKIP .
     1532   HIDE STREAM Out-Stream FRAME BottomFrame .
     1533   output STREAM Out-Stream CLOSE.
     1534   if g#quest-print = false
     1535   then do:
     1536     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     1537                                         7, (if 0 >= 8 then 2 else 0), 0, 0,
     1538                                         OUTPUT g#log ).
     1539   end.
     1540   else do:
     1541     os-command silent
     1542       value( "COPY /b " +
     1543         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     1544         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     1545         string( session:temp-directory) +  "$" + string( g#report-num )
     1546                 ) .
     1547     os-command silent
     1548       value( "COPY /b " +
     1549         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     1550         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     1551         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     1552                 ) .
     1553   end.
