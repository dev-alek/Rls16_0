      353   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currsysk in g#library
      354     (output v-sys-key
      355     ) no-error .
      356   FIND t-doc WHERE recid( t-doc ) = rec_id  NO-LOCK .
      357   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      358   empty temp-table thbjattr_thbj-attr.
      359   run adm/shattri.p (
      360      input "get":U
      361     ,input t-doc.obj-type
      362     ,input t-doc.obj-code
      363     ,input 'prt-obj':U
      364     ,input  ""
      365     ,output v-value-character
      366     ,output v-value-date
      367     ,output v-value-decimal
      368     ,output v-value-integer
      369     ,output v-value-logical
      370     ,output par-type
      371     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      372     ) no-error .
      373   for each thbjattr_thbj-attr :
      374       if thbjattr_thbj-attr.prop-code = 'FGdsNinD' then tmp-var =  string(thbjattr_thbj-attr.property-value-logical) .
      375   end.
      376   FullGdsName = (tmp-var = "yes") .
      377   DEFINE FRAME f-doc
      378           sym1 column-label ":!:" format "X(1)" space(0)
      379           LineCounter COLUMN-LABEL "N!п/п" format ">>9" space(0)
      380           sym2 column-label ":!:" format "X(1)"
      381           tb-code column-label "Код! " format "x(10)"
      382           ub.goods.artic COLUMN-LABEL "Артикул! " format "X(18)"
      383           ub.goods.gds-name COLUMN-LABEL "Наименование! " format "X(30)"
      384           cli-prod.obj-name COLUMN-LABEL "Производитель! " format "X(40)"
      385           sym9 column-label ":!:" format "X(1)"
      386           ub.units.long-name COLUMN-LABEL "Единица!измер. " format "X(7)"
      387           sym7 column-label ":!:" format "X(1)"
      388           price-withNDS COLUMN-LABEL "Цена за ед.! " format ">>>>>>>,>>9.99"
      389           sym8 column-label ":!:" format "X(1)" space(0)
      390       HEADER
      391           string( "Цены и суммы указаны в " + trim( val-str ) ) format "X(30)"
      392           tdoc-code AT 70 format "X(10)"
      393           string( "Страница " + string( PAGE-NUMBER( Out-Stream ), ">>9" ) ) AT 110 format "X(13)" SKIP
      394           Line format "X(136)" AT 1
      395       with width 235 down stream-io.
      396   Line = fill("-", 230) .
      397   UndLine = fill("_", 230) .
      398   LineCounter = 1 .
      399   assign
      400     tdoc-code = t-doc.doc-code
      401     tdoc-date = (if t-doc.status_ <> 'факт':U then t-doc.doc-date else t-doc.fact-date )
      402     .
      403   FIND OurObject WHERE OurObject.obj-type = t-doc.obj-type AND
      404                                             OurObject.obj-code = t-doc.obj-code NO-LOCK NO-ERROR.
      405   CASE OurObject.obj-type :
      406       when 'маг':U then
      407           do:
      408               FIND ub.shop WHERE ub.shop.obj-code = OurObject.obj-code NO-LOCK .
      409               tdoc-prt = ub.shop.doc-prt.
      410           end.
      411       when 'скл':U then
      412           do:
      413               FIND ub.store WHERE ub.store.obj-code = OurObject.obj-code NO-LOCK .
      414               tdoc-prt = ub.store.doc-prt .
      415           end.
      416   END CASE.
      417   FIND Our_Host WHERE Our_Host.obj-type = 'орг':U AND
      418                                          Our_Host.obj-code = t-doc.host-code NO-LOCK.
      419   if NOT tdoc-prt then
      420       PrintScale = no .
      421   if session:set-wait-state("compiler") then.
      422   output STREAM Out-Stream to value( string( session:temp-directory +
      423                                        "rpt" + string( g#report-num ) ) )
      424                                        page-size 62 .
      425   FORM HEADER
      426       Line format "X(136)" AT 1 SKIP
      427       "Продолжение - на следующей странице" AT 30 SKIP
      428       with FRAME BottomFrame width 235 PAGE-BOTTOM NO-LABELS NO-BOX .
      429   VIEW STREAM Out-Stream FRAME BottomFrame .
      430   assign val-str = ( if PrintRubl then "рублях" else "баз.вал" ).
      431   FIND ub.clients WHERE ub.clients.obj-type = t-doc.cli-type AND
      432                      ub.clients.obj-code = t-doc.cli-code NO-LOCK.
      433   PUT STREAM Out-Stream
      434       space(20)
      435       "П Р О Т О К О Л   СОГЛАСОВАНИЯ  СВОБОДНЫХ  ОТПУСКНЫХ  ЦЕН"
      436           format "X(100)" SKIP(1)
      437       SPACE(20) string( "между " + CAPS( Our_Host.obj-name ) + " и " + CAPS( ub.clients.obj-name ) )
      438           format "X(100)" SKIP(1)
      439       SPACE(40) string( "НАКЛАДНАЯ  N " + tdoc-code ) format "X(60)" SKIP(1) .
      440       .
      441   FORM with frame f-doc .
      442   FOR  EACH ub.doc-line where ub.doc-line.doc-code = t-doc.doc-code NO-LOCK
      443                               BREAK BY ub.doc-line.artic :
      444       FIND ub.goods WHERE ub.goods.prod-type = ub.doc-line.prod-type AND
      445                        ub.goods.prod-code = ub.doc-line.prod-code AND
      446                        ub.goods.artic = ub.doc-line.artic NO-LOCK .
      447       FIND cli-prod WHERE cli-prod.obj-type = ub.doc-line.prod-type AND
      448                           cli-prod.obj-code = ub.doc-line.prod-code NO-LOCK .
      449       assign prod-name = (if NOT noprod then cli-prod.obj-name else "" ).
      450       FIND FIRST ub.units WHERE ub.units.unit-name = ub.goods.unit-base NO-LOCK no-error.
      451       if v-sys-key = "iab" then do:
      452         FIND ub.sysconf WHERE ub.sysconf.host-code = t-doc.host-code NO-LOCK.
      453         if t-doc.doc-type = 'рас':U AND t-doc.internal = no AND t-doc.pay-code = ub.sysconf.cash-pay then
      454             assign torg-SLT-pc = 5.
      455         else
      456             assign torg-SLT-pc = 0.
      457       end.
      458       else do:
      459         assign torg-SLT-pc = ub.doc-line.SLT-pc.
      460       end.
      461       if FullGdsName then
      462           do:
      463               gds-str1 = breakstr(ub.goods.gds-name, 30, input-output gds-str1, input-output gds-str2).
      464               assign j = 0.
      465               DO WHILE gds-str2 <> "" :
      466                   assign gds-str = gds-str2.
      467                   gds-str1 = breakstr(gds-str, 30, input-output gds-str1, input-output gds-str2).
      468                   assign j = j + 1.
      469               END.
      470               if line-counter( Out-Stream ) + j > page-size( Out-Stream ) then
      471                 PAGE STREAM Out-Stream.
      472               gds-str1 = breakstr(ub.goods.gds-name, 30, input-output gds-str1, input-output gds-str2).
      473           end.
      474       else
      475           do:
      476               assign gds-str1 = ub.goods.gds-name.
      477           end.
      478       FIND ub.gds-prt where ub.gds-prt.upper-code = ub.goods.prt-root NO-LOCK .
      479       rootnode_code = ub.gds-prt.node-code.
      480       if ( NOT can-do( '_Пустая шкала':U, ub.gds-prt.node-name ) ) then
      481           do:
      482               if PrintScale then
      483                   do:
      484                       DISPLAY STREAM Out-Stream
      485                               LineCounter
      486                               gds-str1 @ ub.goods.gds-name
      487                               ub.goods.artic
      488                               prod-name @ cli-prod.obj-name
      489                               sym1 sym2 sym7 sym8 sym9
      490                               with frame f-doc .
      491                       DOWN STREAM Out-Stream 1 with FRAME f-doc .
      492                       LineCounter = LineCounter + 1.
      493                   end.
      494               if session:set-wait-state("compiler") then.
      495               FOR EACH ub.gds-dtl WHERE
      496                               ub.gds-dtl.prod-type = ub.doc-line.prod-type AND
      497                               ub.gds-dtl.prod-code = ub.doc-line.prod-code AND
      498                               ub.gds-dtl.artic = ub.doc-line.artic AND
      499                               ub.gds-dtl.doc-code = ub.doc-line.doc-code NO-LOCK :
      500                   FIND ub.gds-prt WHERE ub.gds-prt.node-code = ub.gds-dtl.prt-code NO-LOCK.
      501                   if t-doc.doc-type = 'при':U then
      502                       do:
      503   assign
      504     price-rubl-with-tax-loc = ub.doc-line.price-rubl
      505     price-base-with-tax-loc = ub.doc-line.price-base
      506   .
      507   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      508   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      509     (output varinvprb
      510     )  .
      511      find first in-vatp_doc-attr no-lock
      512       where in-vatp_doc-attr.doc-code  = t-doc.doc-code
      513         and in-vatp_doc-attr.attr-code = 'envd':U
      514       no-error .
      515       if available in-vatp_doc-attr
      516          then do:
      517          assign
      518            in-vatp-have-vat-slt = no.
      519      end.
      520      else do:
      521        assign
      522          in-vatp-have-vat-slt = yes.
      523      end.
      524      find first in-vatp-goods where in-vatp-goods.artic     = ub.doc-line.artic     and
      525                                        in-vatp-goods.prod-type = ub.doc-line.prod-type and
      526                                        in-vatp-goods.prod-code = ub.doc-line.prod-code no-lock.
      527      if (not t-doc.internal and
      528              t-doc.doc-type = 'при':U) or
      529         in-vatp-goods.gds-type = 'у':U then do:
      530         if varinvprb = "base":u then do:
      531           assign
      532             road-tax-base-loc = ub.doc-line.road-tax
      533             road-tax-rubl-loc = ub.doc-line.road-tax * t-doc.base-rate / t-doc.base-scale.
      534         end.
      535         else do:
      536           ASSIGN
      537             road-tax-rubl-loc = ub.doc-line.road-tax
      538             road-tax-base-loc = ub.doc-line.road-tax / t-doc.base-rate * t-doc.base-scale.
      539         end.
      540         if road-tax-base-loc = ? then road-tax-base-loc = 0.
      541         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
      542         assign
      543           road-tax-cli-loc = ?.
      544         ASSIGN
      545           transport-base-loc = (if ub.doc-line.transport-base = ? then 0 else ub.doc-line.transport-base)
      546           transport-rubl-loc = (if ub.doc-line.transport-rubl = ? then 0 else ub.doc-line.transport-rubl)
      547           transport-cli-loc  = 0
      548           other-base-loc     = (if ub.doc-line.other-base     = ? then 0 else ub.doc-line.other-base)
      549           other-rubl-loc     = (if ub.doc-line.other-rubl     = ? then 0 else ub.doc-line.other-rubl)
      550           other-cli-loc      = 0
      551           vat-pc-loc         = (if ub.doc-line.vat-pc         = ? then 0 else ub.doc-line.vat-pc)
      552           slt-pc-loc         = (if ub.doc-line.slt-pc         = ? then 0 else ub.doc-line.slt-pc).
      553                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      554               ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      555         assign
      556           vat-cli-loc            = ?
      557           slt-cli-loc            = ?
      558           price-cli-with-tax-loc = ?.
      559      end.
      560      else do:
      561                                                   for each in-vatp-parts where in-vatp-parts.out-code  = ub.doc-line.doc-code  and
      562                                         in-vatp-parts.obj-type  = ub.doc-line.obj-type  and
      563                                         in-vatp-parts.obj-code  = ub.doc-line.obj-code  and
      564                                         in-vatp-parts.artic     = ub.doc-line.artic     and
      565                                         in-vatp-parts.prod-type = ub.doc-line.prod-type and
      566                                         in-vatp-parts.prod-code = ub.doc-line.prod-code
      567                            use-index out-code no-lock:
      568             accumulate  in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty (total)
      569                         in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty (total)
      570                         in-vatp-parts.transport-base * in-vatp-parts.fact-qnty (total)
      571                         in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty (total)
      572                         in-vatp-parts.other-base     * in-vatp-parts.fact-qnty (total)
      573                         in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty (total)
      574                                                                                                                 (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
      575                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
      576                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
      577                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
      578                                               (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
      579                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
      580                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
      581                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
      582                         .
      583         end.
      584         ASSIGN
      585           road-tax-base-loc   = if ub.doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty) / ub.doc-line.fact-qnty  else 0
      586           road-tax-rubl-loc   = if ub.doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty) / ub.doc-line.fact-qnty  else 0
      587           transport-base-loc  = if ub.doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-base * in-vatp-parts.fact-qnty) / ub.doc-line.fact-qnty  else 0
      588           transport-rubl-loc  = if ub.doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty) / ub.doc-line.fact-qnty  else 0
      589           other-base-loc      = if ub.doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-base     * in-vatp-parts.fact-qnty) / ub.doc-line.fact-qnty  else 0
      590           other-rubl-loc      = if ub.doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty) / ub.doc-line.fact-qnty  else 0
      591                                           vat-base-loc        = if ub.doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / ub.doc-line.fact-qnty   else 0
      592           slt-base-loc        = if ub.doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / ub.doc-line.fact-qnty   else 0
      593                   vat-rubl-loc        = if ub.doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / ub.doc-line.fact-qnty   else 0
      594           slt-rubl-loc        = if ub.doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / ub.doc-line.fact-qnty   else 0
      595           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
      596           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
      597         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
      598         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
      599         if transport-base-loc = ? then transport-base-loc = 0.
      600         if transport-rubl-loc = ? then transport-rubl-loc = 0.
      601         if other-base-loc     = ? then other-base-loc     = 0.
      602         if other-rubl-loc     = ? then other-rubl-loc     = 0.
      603         assign
      604           transport-cli-loc      = 0
      605           other-cli-loc          = 0
      606           road-tax-cli-loc       = ?
      607           vat-cli-loc            = ?
      608           slt-cli-loc            = ?
      609           price-cli-with-tax-loc = ?.
      610      end.
      611   ASSIGN
      612             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
      613       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
      614   .
      615                           assign price-noNDS = ( if PrintRubl then price-rubl-without-tax-loc else price-base-without-tax-loc ) .
      616                       end.
      617                   else
      618                       do:
      619   if t-doc.ext-doc-type = 'ot':U or
      620      t-doc.ext-doc-type = ?                 then do:
      621     assign
      622      out-vatp-have-vat-slt = yes.
      623   end.
      624   else do:
      625     find first out-vatp_doc-attr no-lock
      626       where out-vatp_doc-attr.doc-code  = t-doc.doc-code
      627         and out-vatp_doc-attr.attr-code = 'envd':U
      628         no-error .
      629     if not available out-vatp_doc-attr then do:
      630       assign
      631         out-vatp-have-vat-slt = yes.
      632     end.
      633     else do:
      634        out-vatp-have-vat-slt = no.
      635     end.
      636   end.
      637   find first out-vatp_goods where out-vatp_goods.artic     = ub.doc-line.artic     and
      638                                      out-vatp_goods.prod-type = ub.doc-line.prod-type and
      639                                      out-vatp_goods.prod-code = ub.doc-line.prod-code no-lock.
      640   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      641   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
      642     (input  ub.doc-line.artic
      643     ,input  ub.doc-line.prod-type
      644     ,input  ub.doc-line.prod-code
      645     ,output varroot-node
      646     ) no-error .
      647   if error-status :error then do:
