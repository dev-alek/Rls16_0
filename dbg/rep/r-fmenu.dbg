      907   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      908   function breakstr returns character ( input        for-name    as character,
      909                                         input        line-length as integer,
      910                                         input-output line1       as character,
      911                                         input-output line2       as character ) :
      912     define variable ii as integer no-undo.
      913     if length( for-name ) > line-length then do:
      914       assign ii    = 1
      915              line1 = "":u
      916              line2 = "":u.
      917       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
      918         assign line1 =       substring( for-name, 1, line-length     )
      919                line2 = trim( substring( for-name,    line-length + 1 ) ).
      920       end.                                                     else do:
      921         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
      922           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
      923                  ii    = ii    + 1.
      924           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
      925             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
      926           end.
      927         end.
      928         assign line2 = trim( substring( for-name, length( line1 ) ) ).
      929       end.
      930     end.                                else do:
      931       assign line1 = for-name
      932              line2 = "":u.
      933     end.
      934     return ( line1 ).
      935   end function.
      936       def var t-addres        like ub.firm.addres1   no-undo.
      937       def var t-phone         like ub.firm.phone     no-undo.
      938       def var t-inn           like ub.firm.inn       no-undo.
      939       def var t-okpo          like ub.firm.okpo      no-undo.
      940       def var t-temp-address  like ub.firm.addres1   no-undo.
      941   def var vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      942   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      943   procedure paramls-clear :
      944     define buffer buf_temp-param for temp-param .
      945     do
      946     on error undo, return error return-value
      947     :
      948       for each buf_temp-param
      949       on error undo, return error
      950       :
      951         delete buf_temp-param .
      952       end.
      953     end.
      954   end procedure.
      955   procedure paramls-write :
      956     define input  parameter p-code     as character no-undo .
      957     define input  parameter p-sub-code as character no-undo .
      958     define input  parameter p-value    as character no-undo .
      959     define buffer buf_temp-param for temp-param .
      960     do
      961     on error undo, return error return-value
      962     :
      963       find first buf_temp-param
      964         where buf_temp-param.param-code     = p-code
      965           and buf_temp-param.param-sub-code = p-sub-code
      966         no-error .
      967       if not available buf_temp-param then do:
      968         create buf_temp-param .
      969         assign
      970           buf_temp-param.param-code     = p-code
      971           buf_temp-param.param-sub-code = p-sub-code
      972         .
      973       end.
      974       assign
      975         buf_temp-param.param-value = p-value
      976       .
      977     end.
      978   end procedure.
      979   procedure paramls-read :
      980     define input  parameter p-code          as character no-undo .
      981     define input  parameter p-sub-code      as character no-undo .
      982     define input  parameter p-default-value as character no-undo .
      983     define output parameter p-value         as character no-undo .
      984     define buffer buf_temp-param for temp-param .
      985     do
      986     on error undo, return error return-value
      987     :
      988       find first buf_temp-param
      989         where buf_temp-param.param-code     = p-code
      990           and buf_temp-param.param-sub-code = p-sub-code
      991         no-error .
      992       if available buf_temp-param then do:
      993         assign
      994           p-value = buf_temp-param.param-value
      995         .
      996       end.
      997       else do:
      998         assign
      999           p-value = p-default-value
     1000         .
     1001       end.
     1002     end.
     1003   end procedure.
     1004   procedure paramls-append :
     1005     define input  parameter p-code     as character no-undo .
     1006     define input  parameter p-sub-code as character no-undo .
     1007     define input  parameter p-value    as character no-undo .
     1008     define buffer buf_temp-param for temp-param .
     1009     do
     1010     on error undo, return error return-value
     1011     :
     1012       find first buf_temp-param
     1013            where buf_temp-param.param-code     = p-code
     1014              and buf_temp-param.param-sub-code = p-sub-code
     1015         no-error .
     1016       if not available buf_temp-param then do:
     1017         create buf_temp-param .
     1018         assign
     1019           buf_temp-param.param-code     = p-code
     1020           buf_temp-param.param-sub-code = p-sub-code
     1021           buf_temp-param.param-value    = p-value
     1022         .
     1023       end.
     1024       else do:
     1025           assign
     1026               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     1027           .
     1028       end.
     1029     end.
     1030   end procedure.
     1031   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     1032     if num-entries(string(p-dec), '.') = 2
     1033       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     1034       else return( string(p-dec)) .
     1035   end function.
     1036   function format-point-to-comma returns char (input orig as char ) .
     1037   define variable rtext as character no-undo .
     1038   define variable strt as integer no-undo .
     1039   define variable leng as integer no-undo .
     1040   assign rtext = orig .
     1041   repeat:
     1042     strt =  index(rtext,'.').
     1043     if strt = 0 then leave.
     1044     leng = 1.
     1045     substring(rtext,strt,leng,"character") = v-delim .
     1046   end.
     1047   return rtext.
     1048   end function.
     1049   function format-excel-text returns char ( input start-text as char ) :
     1050   def var  i    as int no-undo.
     1051   def var  ch   as char no-undo.
     1052   def var  n    as int no-undo.
     1053   def var  ipos as int no-undo.
     1054     n = num-entries(trim(start-text), chr(10)) - 1 .
     1055     do i = 1 to n :
     1056       ipos = index( start-text, chr(10)).
     1057       if ipos > 0 then
     1058         substr( start-text, ipos, 1 ) = ' '.
     1059     end.
     1060     n = num-entries(trim(start-text), chr(13)) - 1 .
     1061     do i = 1 to n :
     1062       ipos = index( start-text, chr(13)).
     1063       if ipos > 0 then
     1064         substr( start-text, ipos, 1 ) = ' '.
     1065     end.
     1066     if index( start-text, '"' ) = 0 then
     1067       start-text =  '="'   + trim( start-text) + '"'   .
     1068       else do:
     1069         n = num-entries(trim(start-text), '"') - 1.
     1070         do i = 1 to n :
     1071           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1072         end.
     1073         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1074         start-text = '="'  + ch  + '"' .
     1075       end.
     1076     return start-text.
     1077   end.
     1078   function excel-sum returns char (input p-dec as decimal ).
     1079     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     1080   end function.
     1081   function excel-qnty returns char (input p-dec as decimal ).
     1082     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     1083   end function.
     1084   function format-excel-text-macr returns char ( input start-text as char ) :
     1085   def var  i    as int no-undo.
     1086   def var  ch   as char no-undo.
     1087   def var  n    as int no-undo.
     1088   def var  ipos as int no-undo.
     1089     n = num-entries(trim(start-text), chr(10)) - 1 .
     1090     do i = 1 to n :
     1091       ipos = index( start-text, chr(10)).
     1092       if ipos > 0 then
     1093         substring( start-text, ipos , 1 ) = ' '.
     1094     end.
     1095     n = num-entries(trim(start-text), chr(13)) - 1 .
     1096     do i = 1 to n :
     1097       ipos = index( start-text, chr(13)).
     1098       if ipos > 0 then
     1099         substring( start-text, ipos, 1 ) = ' '.
     1100     end.
     1101     if index( start-text, '"' ) = 0 then
     1102       start-text =  '"'   + trim( start-text) + '"'   .
     1103       else do:
     1104         n = num-entries(trim(start-text), '"') - 1.
     1105         do i = 1 to n :
     1106           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1107         end.
     1108         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1109         start-text = '"'  + ch  + '"' .
     1110       end.
     1111     n = num-entries(trim(start-text), chr(10)) - 1 .
     1112     do i = 1 to n :
     1113       ipos = index( start-text, chr(10)).
     1114       if ipos > 0 then
     1115         substring( start-text, ipos , 1 ) = ' '.
     1116     end.
     1117       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     1118     return start-text.
     1119   end.
     1120   define temp-table temp-font no-undo
     1121     field fontnum  as integer
     1122     field fontname as character
     1123     field fontsize as character
     1124     field fonttype as character
     1125     field font-h   as integer
     1126     field font-w   as integer
     1127     field v-row    as integer
     1128     field v-col    as integer
     1129     field v-row-lans as integer
     1130     field v-col-lans as integer
     1131   index pi fontnum
     1132   .
     1133   procedure get-font-ini :
     1134     do
     1135     on error undo, return error return-value
     1136     :
     1137   define variable ii as integer   no-undo .
     1138   define variable v-font7 as character no-undo .
     1139   define variable v-font as character no-undo .
     1140   define variable loc-name as character no-undo .
     1141   define variable loc-size as character no-undo .
     1142   define variable loc-type as character no-undo .
     1143   define variable old_H as integer   no-undo .
     1144   define variable old_w as integer   no-undo .
     1145   define variable old-row  as integer   no-undo .
     1146   define variable old-col  as integer   no-undo .
     1147   define variable old-row-lans  as integer   no-undo .
     1148   define variable old-col-lans  as integer   no-undo .
     1149   define variable vv as integer   no-undo .
     1150   empty temp-table temp-font.
     1151     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     1152       case num-entries (v-font7) :
     1153         when 4 then do:
     1154             assign
     1155               loc-name = entry ( 1 , v-font7 )
     1156               loc-size = entry ( 2 , v-font7 )
     1157               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     1158             .
     1159         end.
     1160         when 3 then do:
     1161             assign
     1162               loc-name = entry ( 1 , v-font7 )
     1163               loc-size = entry ( 2 , v-font7 )
     1164               loc-type = entry ( 3 , v-font7 )
     1165             .
     1166         end.
     1167         when 2 then  do:
     1168             assign
     1169               loc-name = entry ( 1 , v-font7 )
     1170               loc-size = entry ( 2 , v-font7 )
     1171               loc-type = ""
     1172             .
     1173         end.
     1174         when 1 then do:
     1175             assign
     1176               loc-name = trim(entry ( 1 , v-font7 ))
     1177               loc-size = ""
     1178               loc-type = ""
     1179             .
     1180         end.
     1181       end case.
     1182     create temp-font.
     1183     assign
     1184       temp-font.fontnum  = 7
     1185       temp-font.fontname = trim(loc-name)
     1186       temp-font.fontsize = trim(loc-size)
     1187       temp-font.fonttype = trim(loc-type)
     1188       temp-font.v-row    = 62
     1189       temp-font.v-col    = 136
     1190       temp-font.v-row-lans = 43
     1191       temp-font.v-col-lans = 198
     1192     .
     1193     repeat ii = 16 to 100 :
     1194       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     1195       if v-font = "" or v-font = ? then leave.
     1196       case num-entries (v-font) :
     1197         when 4 then do:
     1198             assign
     1199               loc-name = entry ( 1 , v-font )
     1200               loc-size = entry ( 2 , v-font )
     1201               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     1202             .
     1203         end.
     1204         when 3 then do:
     1205             assign
     1206               loc-name = entry ( 1 , v-font )
     1207               loc-size = entry ( 2 , v-font )
     1208               loc-type = entry ( 3 , v-font )
     1209             .
     1210         end.
     1211         when 2 then do:
     1212             assign
     1213               loc-name = entry ( 1 , v-font )
     1214               loc-size = entry ( 2 , v-font )
     1215               loc-type = ""
     1216             .
     1217         end.
     1218         when 1 then do:
     1219             assign
     1220               loc-name = trim(entry ( 1 , v-font ))
     1221               loc-size = ""
     1222               loc-type = ""
     1223             .
     1224         end.
     1225       end case.
     1226     create temp-font.
     1227     assign
     1228       temp-font.fontnum  = ii
     1229       temp-font.fontname = trim(loc-name)
     1230       temp-font.fontsize = trim(loc-size)
     1231       temp-font.fonttype = trim(loc-type)
     1232     .
     1233     end.
     1234       for each temp-font :
     1235          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     1236          if  vv = ? then vv =  0 .
     1237           run rep/exfont.p (
     1238             input   temp-font.fontname ,
     1239             input   vv ,
     1240             input   temp-font.fonttype ,
     1241             output  temp-font.font-h   ,
     1242             output  temp-font.font-w   )
     1243           .
     1244       end.
     1245   find first temp-font where  temp-font.fontnum  = 7  .
     1246   old_H = temp-font.font-H .
     1247   old_w = temp-font.font-W .
     1248   old-row = temp-font.v-row .
     1249   old-col = temp-font.v-col .
     1250   old-row-lans = temp-font.v-row-lans .
     1251   old-col-lans = temp-font.v-col-lans .
     1252       for each temp-font where
     1253                temp-font.fontnum  <> 7 :
     1254           assign
     1255               temp-font.v-row    = old_H * old-row / temp-font.font-h
     1256               temp-font.v-col    = old_W * old-col / temp-font.font-W
     1257               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     1258               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     1259           .
     1260       end.
     1261     end.
     1262   end procedure.
     1263   PROCEDURE How-name :
     1264   define input  parameter h as integer no-undo .
     1265   define input  parameter w as integer no-undo .
     1266   define output parameter n as character  no-undo .
     1267   define variable A4port-H as integer   no-undo init 63.
     1268   define variable A4port-W as integer   no-undo init 136.
     1269   define variable A4lans-H as integer   no-undo init 43.
     1270   define variable A4lans-W as integer   no-undo init 198.
     1271   define variable Strim-W  as integer   no-undo init 278.
     1272   run define-a4-size (
     1273        input ReportFontNum
     1274       ,output A4port-H
     1275       ,output A4port-W
     1276       ,output A4lans-H
     1277       ,output A4lans-W ).
     1278   If w >= 1 and w <= A4port-W Then DO:
     1279     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1280     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     1281     If h > A4port-H              Then n = "to-file":U.
     1282   End.
     1283   If w > A4port-W and w <= A4lans-W Then DO:
     1284     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1285     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1286     If h > A4port-H              Then n = "to-file":U.
     1287   End.
     1288   If w > A4lans-W and w <= Strim-W Then DO:
     1289     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     1290     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1291     If h > A4port-H              Then n = "to-file":U.
     1292   End.
     1293   If w > Strim-W Then DO:
     1294      n = "to-file":U.
     1295   End.
     1296   END PROCEDURE.
     1297   PROCEDURE define-a4-size :
     1298   define input  parameter p-ReportFontNum as integer   no-undo .
     1299   define output parameter A4port-H as integer   no-undo .
     1300   define output parameter A4port-W as integer   no-undo .
     1301   define output parameter A4lans-H as integer   no-undo .
     1302   define output parameter A4lans-W as integer   no-undo .
     1303   if not can-find (first temp-font ) then do:
     1304      run get-font-ini .
     1305   end.
     1306   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     1307   if available temp-font then do:
     1308   assign
     1309     A4port-H = temp-font.v-row
     1310     A4port-W = temp-font.v-col
     1311     A4lans-H = temp-font.v-row-lans
     1312     A4lans-W = temp-font.v-col-lans
     1313   .
     1314   end.
     1315   else do:
     1316   assign
     1317     A4port-H = 63
     1318     A4port-W = 136
     1319     A4lans-H = 43
     1320     A4lans-W = 198
     1321   .
     1322   end.
     1323   END PROCEDURE.
     1324    do
     1325    on error undo, return error return-value
     1326    :
     1327   define variable   sort-name   as logical no-undo.
     1328   define variable   sort-gr     as logical no-undo.
     1329   define variable   print-graft as logical no-undo.
     1330   define variable   summ as decimal no-undo .
     1331   x-date-start = x-date-alone .
     1332   sort-gr    = yes .
     1333   sort-name  = no  .
     1334   define variable sort-group as logical   no-undo .
     1335   if sort-gr                  then assign sort-group = yes .
     1336   else                             assign sort-group = no .
     1337   DEFINE temp-table temp-str no-undo
     1338     field   np                as integer
     1339     field   grp-name          as  char
     1340     field   gds-name          as  char
     1341     field   b-code            as character
     1342     field   norma             as decimal
     1343     field   num-rcp           as char
     1344     field   p-inp             as decimal
     1345     field   qnty              as decimal
     1346     field   price             as decimal
     1347     field   stoim             as decimal
     1348   .
     1349   define stream  OutStream  .
     1350   define stream  macr_excel .
     1351   define variable v-file-name as character no-undo .
     1352   define variable v-ind       as integer   no-undo .
     1353   define variable num#col#    as integer no-undo .
     1354   define variable C-c    as integer no-undo .
     1355   define variable C-str  as character no-undo .
     1356   define variable str--1 as character Format "x(60)" no-undo.
     1357   define variable str--2 as integer no-undo .
     1358   define variable C-i    as integer no-undo .
     1359   define variable p-var  as integer no-undo .
     1360   define variable var-1  as integer no-undo .
     1361   define variable var-2  as integer no-undo .
     1362   def buffer buf_clients for  clients .
     1363   def buffer This_Object for  clients .
     1364   def buffer buf_goods        for goods .
     1365   define variable qnty as decimal   no-undo .
     1366   define variable sum  as decimal   no-undo .
     1367   define variable num-ln as integer   no-undo .
     1368   define variable FullNameGds as character no-undo .
     1369   define variable gds-str as char no-undo.
     1370   define variable gds-str1 as char no-undo.
     1371   define variable gds-str2 as char no-undo.
     1372   define variable i as int no-undo.
     1373   define variable j as int no-undo.
     1374   define variable Counter1 as integer init 0  no-undo .
     1375   define variable LineBuf       as char    no-undo.
     1376   define variable Line       as char    no-undo.
     1377   define variable UndLine    as char    no-undo.
     1378   define variable     Lines_Counter as   int  init 0  no-undo.
     1379   define variable     Tmp_Counter   as   int  init 0  no-undo.
     1380   define variable     tdoc-date     like fbr-pln.doc-date no-undo.
     1381   define variable     tdoc-code     like fbr-pln.doc-code no-undo.
     1382   define variable  abbr              as  char no-undo.
     1383   define variable  pp                as  char no-undo.
     1384   define variable sym1 as char  init ":"   no-undo.
     1385   define variable sym2 as char  init ":"   no-undo.
     1386   define variable sym3 as char  init ":"   no-undo.
     1387   define variable sym4 as char  init ":"   no-undo.
     1388   DEFINE FRAME plan-menu
     1389       sym1 column-label ":"  format "X(1)" space(0)
     1390       temp-str.b-code COLUMN-LABEL "Код":C9 format "X(9)" space(0)
     1391       sym2 column-label ":"  format "X(1)" space(0)
     1392       temp-str.gds-name COLUMN-LABEL " Наименование блюда":C40     format "X(40)" space(0)
     1393       Sym3 column-label ":" format "X(1)" space(0)
     1394       temp-str.Price COLUMN-LABEL "Цена":C13 format "->>>>>>>>9.99" space(0)
     1395       Sym4 column-label ":" format "X(1)" space(0)
     1396       HEADER
     1397       string( "Лист " + string( PAGE-NUMBER(OutStream) , ">>>>9") ) AT 70 format "X(13)" SKIP
     1398       Line format "X(66)" AT 1
     1399       with width 232 down stream-io use-text NO-BOX.
     1400     if session:set-wait-state("compiler") then.
     1401   output STREAM OutStream to value( string( session:temp-directory +
     1402                                        "rpt" + string( g#report-num ) ) )
     1403                                        page-size  value(ReportPageHeight) .
     1404     define variable v-prn0 as character no-undo .
     1405     assign
     1406       Line    = fill("-", 230)
     1407       UndLine = fill("_", 230)
     1408       LineBuf = fill("_", 240)
     1409     .
     1410     IF var-report-r-b = "rubl" THEN Assign PP = "Цены руб.".
     1411                          Else Assign PP = "Цены  баз.вал." .
     1412   define variable v-account as integer init 0 no-undo .
     1413   define variable v-account-lavel as character no-undo .
     1414   define variable v-button-stop as logical no-undo .
     1415   define variable v-kol-spice as integer no-undo .
     1416   define variable v-kol-spice2 as integer no-undo .
     1417   define variable v-kol-spice3 as integer no-undo .
     1418   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1419   DEFINE BUTTON StopBtn AUTO-END-KEY
     1420        LABEL "Стоп"
     1421        SIZE 10 BY 1.
     1422   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1423        LABEL "Обработано записей"
     1424         VIEW-AS TEXT
     1425        SIZE 14 BY .67 NO-UNDO.
     1426   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1427         VIEW-AS TEXT
     1428        SIZE 53.25 BY .67
     1429        FGCOLOR 1  NO-UNDO.
     1430   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1431         VIEW-AS TEXT
     1432        SIZE 53.25 BY .67
     1433        FGCOLOR 1  NO-UNDO.
     1434   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1435         VIEW-AS TEXT
     1436        SIZE 53.25 BY .67
     1437        FGCOLOR 1  NO-UNDO.
     1438   DEFINE RECTANGLE RECT-1
     1439        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1440        SIZE 55.13 BY 4.46.
     1441   DEFINE FRAME InfoFrame
     1442        StopBtn AT ROW 4.25 COL 21.75
     1443        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1444        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1445        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1446        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1447        RECT-1 AT ROW 1 COL 1
     1448       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1449            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1450            TITLE "Процесс"
     1451            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1452   define variable mFrameView      as logical   no-undo init yes.
     1453     define variable mFramHandle as handle no-undo.
     1454     mFramHandle = frame InfoFrame:handle.
     1455     if  log-manager:logfile-name ne ?
     1456     then DO:
     1457         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1458         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1459         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1460     end.
     1461     mFrameView = not session:batch-mode and mFramHandle:visible.
     1462     if mFrameView
     1463     then do:
     1464       ASSIGN
     1465          FRAME InfoFrame:HIDDEN                           = TRUE
     1466          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1467     end.
     1468   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1469   DO:
     1470     IF not StopProcessing THEN
     1471       Message "Вы действительно хотите прервать" SKIP
     1472               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1473                 UPDATE StopProcessing.
     1474     IF StopProcessing THEN do:
     1475        if mFrameView
     1476        then do:
     1477           HIDE FRAME InfoFrame.
     1478        end.
     1479     End.
     1480   END.
     1481   assign v-account = ( if integer( 25 ) = 0 then 100 else integer( 25 ) ).
     1482     if  log-manager:logfile-name ne ?
     1483     then DO:
     1484         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1485     end.
     1486     if not session:batch-mode then
     1487     do:
     1488       VIEW FRAME InfoFrame.
     1489       mFrameView = true.
     1490     end.
     1491      v-button-stop = false .
     1492         if mFrameView
     1493         then do:
     1494         if v-button-stop then view STOPBTN in frame InfoFrame.
     1495                          else Hide STOPBTN in frame InfoFrame.
     1496         end.
     1497   v-ind = 0    .
     1498   FORM with frame plan-menu .
     1499   for each obj-list :
     1500       Output stream Macr_Excel  close .
     1501       num#str# = 0 .
     1502       run gbl/_tmpfile.p ( "wb", ".txt", output v-file-name) .
     1503       output stream macr_excel to value(v-file-name)   .
     1504       v-ind = v-ind + 1.
     1505   for each fbr-pln no-lock where fbr-pln.status_  = 'факт':U and
     1506                                  fbr-pln.doc-type = 'план-меню':U and
     1507                                  fbr-pln.fact-date = x-date-start and
     1508                                  fbr-pln.obj-type = obj-list.obj-type and
     1509                                  fbr-pln.obj-code = obj-list.obj-code :
     1510     FIND This_Object  WHERE This_Object.obj-type = fbr-pln.obj-type AND This_Object.obj-code = fbr-pln.obj-code  NO-LOCK.
     1511     FIND clients      WHERE clients.obj-type     = 'орг':U           AND clients.obj-code     = fbr-pln.host-code NO-LOCK.
     1512     run PrintTitul in this-procedure .
     1513    run make-tt.
     1514       if sort-group = yes then do:
     1515         for each temp-str no-lock break by temp-str.grp-name by if sort-name then  temp-str.gds-name Else string(temp-str.np,"999999999") :
     1516           if first-of( temp-str.grp-name) then run print-grp in this-procedure .
     1517           run print-line in this-procedure .
     1518           if last-of( temp-str.grp-name ) then  run print-grp-itog in this-procedure .
     1519         end.
     1520       end.
     1521       else do:
     1522         for each temp-str no-lock break by if sort-name then  temp-str.gds-name Else string(temp-str.np,"999999999") :
     1523           run print-line in this-procedure .
     1524         end.
     1525       end.
     1526     run on-same-page in this-procedure (input 15) .
     1527     run PrintPodval in this-procedure .
     1528     page stream OutStream .
     1529     run paramls-write in this-procedure
     1530       (input "file"
     1531       ,input string(v-ind) + obj-list.obj-name
     1532       ,input v-file-name
     1533       ) .
     1534   end.
     1535   end.
     1536   HIDE STREAM OutStream FRAME plan-menu.
     1537   HIDE stream OutStream FRAME BottomFrame .
     1538   HIDE stream OutStream FRAME BottomFrame2 .
     1539   output stream OutStream CLOSE .
     1540   Output stream Macr_Excel  close .
     1541   if mFrameView
     1542   then do:
     1543      HIDE FRAME InfoFrame.
     1544   end.
     1545       run paramls-write in this-procedure
     1546           (input "charcol"
     1547           ,input ""
     1548           ,input "1,2"
     1549           ) .
     1550     run end-proc in this-procedure .
     1551     define variable v-user-action as character no-undo .
     1552     define variable v-printed as logical   no-undo .
     1553     define variable DisabledOptions as integer   no-undo .
     1554     define variable v-orient-page as character no-undo .
     1555     run How-name in this-procedure (
     1556         input ReportPageHeight,
     1557         input ReportPageWidth,
     1558         output v-orient-page )
     1559         .
     1560     if v-orient-page = "A4-lans":U then DisabledOptions = 8 .
     1561                                    else DisabledOptions = 0 .
     1562     run gbl/prnfilen.w
     1563       (input  ""
     1564       ,input  DisabledOptions
     1565       ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     1566       ,input ReportFontNum
     1567       ,output v-user-action
     1568       ,output v-printed
     1569       ) .
     1570   end.
     1571   procedure print-grp :
     1572     do  on error undo, return error return-value  :
     1573       DOWN stream OutStream 1 with FRAME plan-menu .
     1574       PUT stream OutStream UNFORMATTED String("               " + TRIM(CAPS(temp-str.grp-name)))  skip  .
     1575       num#str# = num#str# + 1.
     1576       run macr_excel_char in this-procedure ( CAPS(temp-str.grp-name)    , num#str# , 2   ) .
     1577       run macr_cell_format in this-procedure
     1578             ( 12    ,
     1579               true  ,
     1580               false ,
     1581               ?     ,
     1582               num#str# ,
     1583               2 ,
     1584               num#str# ,
     1585               2               ) .
     1586     end.
     1587   end procedure.
     1588   procedure print-line :
     1589     do on error undo, return error return-value :
     1590     assign
     1591        Lines_Counter = Lines_Counter + 1
     1592        summ = summ  + temp-str.stoim
     1593       .
     1594     if line-counter( OutStream ) + 2 > page-size( OutStream ) then page stream OutStream.
     1595     if line-counter( OutStream ) < Tmp_Counter then
     1596       assign
     1597       .
     1598     assign
     1599       Tmp_Counter  = line-counter( OutStream )
     1600       num-ln = num-ln + 1
     1601     .
     1602     FullNameGds = temp-str.gds-name .
     1603     gds-str1 = breakstr(FullNameGds, 40, input-output  gds-str1, input-output gds-str2).
     1604     assign j = 0.
     1605     DO WHILE gds-str2 <> "" :
     1606       assign gds-str = gds-str2.
     1607       gds-str1 = breakstr(gds-str, 40, input-output gds-str1, input-output gds-str2).
     1608       assign j = j + 1.
     1609     END.
     1610     if line-counter( OutStream ) + j > page-size( OutStream ) then  PAGE STREAM OutStream.
     1611     gds-str1 = breakstr(FullNameGds, 40, input-output  gds-str1, input-output gds-str2).
     1612   num#str# = num#str# + 1.
     1613   num#col# = 1.
     1614   run macr_excel_char in this-procedure ( temp-str.b-code    , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1615   run macr_excel_char in this-procedure ( temp-str.gds-name  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1616   run macr_excel_dec in this-procedure  ( temp-str.price     , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1617     display stream OutStream
     1618       sym1     temp-str.price
     1619       sym2     temp-str.gds-name
     1620       sym3     temp-str.b-code
     1621       sym4
     1622       with FRAME plan-menu.
     1623     DOWN stream OutStream 1 with FRAME plan-menu.
     1624     if print-graft = false THEN do:
     1625     underline stream OutStream
     1626       sym1     temp-str.price
     1627       sym2     temp-str.gds-name
     1628       sym3     temp-str.b-code
     1629       sym4
     1630       with FRAME plan-menu.
     1631     DOWN stream OutStream 1 with FRAME plan-menu.
     1632      end.
     1633     end.
     1634   end procedure.
     1635   procedure print-grp-itog :
     1636     do on error undo, return error return-value :
     1637     end.
     1638   end procedure.
     1639   procedure print-all-itog :
     1640     underline stream OutStream
     1641       sym1
     1642       sym2     temp-str.gds-name
     1643       sym3     temp-str.b-code
     1644       sym4     temp-str.price
     1645       with FRAME plan-menu.
     1646     DOWN stream OutStream 1 with FRAME plan-menu.
     1647   end procedure.
     1648   procedure PrintTitul :
     1649     do  on error undo, return error return-value  :
     1650     define variable cc as integer no-undo .
     1651     define variable tt as integer no-undo .
     1652       case clients.obj-type:
     1653          when 'орг':U
     1654          then do:
     1655               FIND ub.firm WHERE ub.firm.firm-code = clients.obj-code NO-LOCK .
     1656               if available ub.firm
     1657               then do:
     1658                   assign
     1659                       t-addres = ( if ub.firm.ind = 0 or ub.firm.ind = ? then "" else string( ub.firm.ind ) )
     1660                       t-addres = t-addres
     1661                           + ( if ub.firm.city = ? or trim(ub.firm.city) = ""
     1662                               then ""
     1663                               else ( (if t-addres = "" then "" else ", ") + trim( ub.firm.city ) )
     1664                             )
     1665                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 1, 50 ) ) )
     1666                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     1667                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     1668                           + ( if  ub.firm.addres2 = ? or trim(ub.firm.addres2) = "" then "" else ( ", " + trim( ub.firm.addres2 ) ) )
     1669                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 51, 50 ) ) )
     1670                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     1671                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     1672                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 101, 50 ) ) )
     1673                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     1674                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     1675                       t-phone = ub.firm.phone
     1676                       t-inn   = ub.firm.inn
     1677                       t-okpo  = ub.firm.okpo
     1678                   .
     1679               end.
     1680          end.
     1681          when 'маг':U
     1682          then do:
     1683               FIND ub.shop WHERE ub.shop.obj-code = clients.obj-code NO-LOCK .
     1684               if available ub.shop
     1685               then do:
     1686                   assign
     1687                       t-addres = ( if trim( shop.addres1 ) <> "" then ( trim( shop.addres1 ) ) else "" )
     1688                               + ( if trim( shop.addres2 ) <> "" then ( ", " + trim( shop.addres2 ) ) else "" )
     1689                       t-phone = shop.phone
     1690                       t-inn = ""
     1691                       t-okpo = ""
     1692                   .
     1693               end.
     1694          end.
     1695          when 'скл':U
     1696          then do:
     1697               FIND ub.store WHERE ub.store.obj-code = clients.obj-code NO-LOCK .
     1698               if available ub.store
     1699               then do:
     1700                   assign
     1701                       t-addres = ( if trim( ub.store.addres1 ) <> "" then ( trim( ub.store.addres1 ) ) else "" )
     1702                               + ( if trim( ub.store.addres2 ) <> "" then ( ", " + trim( ub.store.addres2 ) ) else "" )
     1703                       t-phone = ub.store.phone
     1704                       t-inn = ""
     1705                       t-okpo = ""
     1706                   .
     1707               end.
     1708          end.
     1709          when 'чел':U
     1710          then do:
     1711               find ub.person where ub.person.psn-code = clients.obj-code no-lock .
     1712               if available ub.person
     1713               then do:
     1714                   assign
     1715                       t-addres = ( if ub.person.ind <> 0 and ub.person.ind <> ? then string( ub.person.ind ) else "" )
     1716                                   + ( if  ub.person.city <> ? and trim(ub.person.city) <> "" then ( ", " + trim( ub.person.city ) ) else "" )
     1717                                   + ( if  ub.person.address <> ? and trim(ub.person.address) <> "" then ( ", " + trim( ub.person.address ) ) else "" )
     1718                       t-phone = ub.person.phone1
     1719                       t-inn = ub.person.inn
     1720                       t-okpo = ub.person.okpo
     1721                   .
     1722               end.
     1723          end.
     1724       end case.
     1725         PUT STREAM OutStream
     1726           space(5) string( "М Е Н Ю" ) skip
     1727           space(5) string( CAPS( This_Object.obj-name ) + " (" + string(This_Object.obj-code) + ")" ) format "X(160)"   skip
     1728           space(5) cur-time-date() format "X(20)"
     1729           skip .
     1730         .
     1731       num#str# = num#str# + 1.
     1732       num#col# = 2.
     1733       cc = num#str# .
     1734       run macr_excel_char in this-procedure ( "М Е Н Ю"    , num#str# , num#col#   ) .
     1735       num#str# = num#str# + 1.
     1736       num#col# = 2.
     1737       run macr_excel_char in this-procedure ( string( CAPS( This_Object.obj-name ) + " (" + string(This_Object.obj-code) + ")" )   , num#str# , num#col#   ) .
     1738       num#str# = num#str# + 1.
     1739       num#col# = 2.
     1740       run macr_excel_char in this-procedure ( cur-time-date()   , num#str# , num#col#   ) .
     1741       run macr_cell_format in this-procedure
     1742       ( 20    ,
     1743         true  ,
     1744         false  ,
     1745         ?    ,
     1746         cc ,
     1747         2 ,
     1748         num#str# ,
     1749         2 ) .
     1750       num#str# = num#str# + 1.
     1751       num#col# = 1.
     1752       tt = num#str#  .
     1753       run macr_excel_char in this-procedure ( "Код"   , num#str# , num#col#   ) .
     1754       run macr_cell_size in this-procedure  ( 10 , ? , num#str# , num#col# , ?, ? ) .
     1755       num#col# = 2.
     1756       run macr_excel_char in this-procedure ( "Наименование блюда"   , num#str# , num#col#   ) .
     1757       run macr_cell_size in this-procedure  ( 40 , ? , num#str# , num#col# , ?, ? ) .
     1758       num#col# = 3.
     1759       run macr_excel_char in this-procedure ( "Цена"   , num#str# , num#col#   ) .
     1760       run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1761       run macr_cell_format in this-procedure
     1762       ( 12    ,
     1763         true  ,
     1764         false  ,
     1765         ?    ,
     1766         num#str# ,
     1767         1 ,
     1768         num#str# ,
     1769         3 ) .
     1770        put  stream macr_excel unformatted
     1771          substitute('select("r&1c&2:r&3c&4 ")' , tt , 1 , num#str# ,  num#col# ) + chr(10)  +
     1772          'BORDER( 2 , 2 , 2 , 2 , 2 , ,0,0,0,0,0) '  + chr(10) +
     1773          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     1774          .
     1775     end.
     1776   end procedure.
     1777   procedure PrintPodval :
     1778     do on error undo, return error return-value  :
     1779     PUT  STREAM OutStream " "
     1780     skip skip skip
     1781   " Руководитель _______________________ " skip
     1782   " Шеф повар    _______________________ " skip
     1783   " Калькулятор  _______________________ " skip
     1784         .
     1785       num#str# = num#str# + 3.
     1786       num#col# = 2.
     1787       run macr_excel_char in this-procedure ( "Руководитель"   , num#str# , num#col#   ) .
     1788       num#str# = num#str# + 1.
     1789       num#col# = 2.
     1790       run macr_excel_char in this-procedure ( "Шеф повар"   , num#str# , num#col#   ) .
     1791       num#str# = num#str# + 1.
     1792       num#col# = 2.
     1793       run macr_excel_char in this-procedure ( "Калькулятор"   , num#str# , num#col#   ) .
     1794     end.
     1795   end procedure.
     1796   PROCEDURE on-same-page :
     1797     define input parameter p-line-number as integer  no-undo .
     1798     if p-line-number > page-size( OutStream ) then return .
     1799     if line-counter( OutStream ) + p-line-number > page-size( OutStream ) then  page stream OutStream .
     1800   end procedure.
     1801   procedure make-tt :
     1802     do
     1803     on error undo, return error return-value
     1804     :
     1805   define buffer buf_fbr-pln-line for fbr-pln-line .
     1806   define buffer buf_recipe for recipe .
     1807   define buffer buf_goods  for goods .
     1808   define variable v-cur-dn as character no-undo .
     1809   define variable v-cur-pr as decimal no-undo .
     1810   define variable v-cur-rt as decimal no-undo .
     1811   define variable v-cur-ex as decimal no-undo .
     1812   define variable v-bar-code like bar-code.b-code no-undo .
     1813   for each temp-str :
     1814       delete temp-str.
     1815   end.
     1816    for each  buf_fbr-pln-line no-lock where buf_fbr-pln-line.doc-code = fbr-pln.doc-code
     1817                                       break by  buf_fbr-pln-line.line-num :
     1818     find first buf_recipe no-lock  where buf_recipe.recipe-code = buf_fbr-pln-line.recipe-code
     1819                                              no-error .
     1820     find first buf_goods      no-lock  where buf_goods.gds-code = buf_fbr-pln-line.gds-code
     1821                                              no-error .
     1822       if error-status :error then message vss-workfile vss-revision vss-description skip
     1823       error-status :get-message(1) skip
     1824       "Не найден товар в справочнике!!!"
     1825        .
     1826   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1827     (input  buf_goods.gds-code
     1828     ,input  ?
     1829     ,output v-bar-code
     1830     )  .
     1831   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1832   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1833     (input  buf_fbr-pln-line.obj-type
     1834     ,input  buf_fbr-pln-line.obj-code
     1835     ,input  v-bar-code
     1836     ,input  0
     1837     ,input  0
     1838     ,output v-cur-dn
     1839     ,output v-cur-pr
     1840     ,output v-cur-rt
     1841     ,output v-cur-ex
     1842     )  .
     1843     define variable v-grp-fbr-name as character no-undo .
     1844     find first fbr-gds-obj no-lock where
     1845                fbr-gds-obj.gds-code = buf_goods.gds-code and
     1846                fbr-gds-obj.obj-code = buf_fbr-pln-line.obj-code and
     1847                fbr-gds-obj.obj-type = buf_fbr-pln-line.obj-type
     1848                no-error .
     1849     if error-status :error then v-grp-fbr-name = "Блюдо и гарнир" .
     1850     else do:
     1851         find first fbr-gds-grp no-lock where fbr-gds-grp.node-code = fbr-gds-obj.fbr-grp-code and
     1852                                             fbr-gds-grp.obj-code   = fbr-pln.obj-code     and
     1853                                             fbr-gds-grp.obj-type   = fbr-pln.obj-type    no-error .
     1854         if available fbr-gds-grp then v-grp-fbr-name = fbr-gds-grp.node-name .
     1855         else do:
     1856           v-grp-fbr-name = "Блюдо и гарнир" .
     1857           message vss-workfile vss-revision vss-description skip
     1858                   error-status :get-message(1)              skip
     1859                   "Товар не приязан к ГРУППЕ БЛЮД"          skip
     1860                   "Блюдо      : " buf_goods.artic  buf_goods.prod-code buf_goods.prod-type skip
     1861                                   buf_goods.gds-name        skip
     1862                                   buf_goods.grp-name        skip
     1863                   "Код группы : " fbr-gds-obj.fbr-grp-code  skip
     1864                   "Объект     : " fbr-gds-obj.obj-code fbr-gds-obj.obj-type skip
     1865                   "Будет входить в группу  - " v-grp-fbr-name
     1866           .
     1867         end.
     1868     end.
     1869     create temp-str .
     1870     assign
     1871       temp-str.np         = buf_fbr-pln-line.line-num
     1872       temp-str.grp-name   = v-grp-fbr-name
     1873       temp-str.gds-name   = buf_goods.gds-name
     1874       temp-str.b-code     = string(v-bar-code)
     1875       temp-str.norma      = ?
     1876       temp-str.num-rcp    = if available buf_recipe then  string(buf_recipe.recipe-ref-num) else "НЕТ"
     1877       temp-str.p-inp      = if available buf_recipe then (if buf_recipe.portion-qnty <> 0 and buf_recipe.portion-qnty <> ? then  buf_recipe.qnty / buf_recipe.portion-qnty else 0)
     1878                                                     else 0
     1879       temp-str.qnty       = buf_fbr-pln-line.fact-qnty
     1880       temp-str.price      = v-cur-pr
     1881       temp-str.stoim      = temp-str.qnty  * temp-str.price
     1882       .
     1883     end.
     1884     end.
     1885    end procedure.
     1886   def var vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1887   procedure macr_excel_char :
     1888    do
     1889    on error undo, return error return-value
     1890    :
     1891    define input parameter  p-val as character no-undo .
     1892    define input parameter  p-row as integer no-undo .
     1893    define input parameter  p-col as integer no-undo .
     1894    if p-val = ? then p-val = "" .
     1895       put stream macr_excel unformatted
     1896             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1897    end.
     1898   end procedure.
     1899   procedure macr_excel_char_with_format :
     1900    do
     1901    on error undo, return error return-value
     1902    :
     1903    define input parameter  p-val as character no-undo .
     1904    define input parameter  p-row as integer no-undo .
     1905    define input parameter  p-col as integer no-undo .
     1906    if p-val = ? then p-val = "" .
     1907       put stream macr_excel unformatted
     1908             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     1909       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     1910       put stream macr_excel unformatted
     1911             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1912    end.
     1913   end procedure.
     1914   procedure macr_excel_cell_format :
     1915    do
     1916    on error undo, return error return-value
     1917    :
     1918    define input parameter  p-val    as character no-undo .
     1919    define input parameter  p-row    as integer   no-undo .
     1920    define input parameter  p-col    as integer   no-undo .
     1921    define input parameter  p-format as character no-undo .
     1922    if p-val = ? then p-val = "" .
     1923       put stream macr_excel unformatted
     1924             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     1925       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     1926       put stream macr_excel unformatted
     1927             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1928    end.
     1929   end procedure.
     1930   procedure macr_excel_sum :
     1931    do
     1932    on error undo, return error return-value
     1933    :
     1934    define input parameter  p-row as integer no-undo .
     1935    define input parameter  p-col as integer no-undo .
     1936    define input parameter  p-row1 as integer no-undo .
     1937    define input parameter  p-col1 as integer no-undo .
     1938    define input parameter  p-row2 as integer no-undo .
     1939    define input parameter  p-col2 as integer no-undo .
     1940       put stream macr_excel unformatted
     1941             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     1942    end.
     1943   end procedure.
     1944   procedure macr_excel_dec :
     1945    do
     1946    on error undo, return error return-value
     1947    :
     1948    define input parameter  p-val as character no-undo .
     1949    define input parameter  p-row as integer   no-undo .
     1950    define input parameter  p-col as integer   no-undo .
     1951     if p-val = ? then p-val =  "" .
     1952      put  stream macr_excel unformatted
     1953           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     1954    end.
     1955   end procedure.
     1956   procedure macr_cell_format :
     1957    do
     1958    on error undo, return error return-value
     1959    :
     1960    define input parameter  p-size   as integer   no-undo .
     1961    define input parameter  p-bold   as logical   no-undo .
     1962    define input parameter  p-italic as logical   no-undo .
     1963    define input parameter  p-color  as integer   no-undo .
     1964    define input parameter  p-row    as integer   no-undo .
     1965    define input parameter  p-col    as integer   no-undo .
     1966    define input parameter  p-row-2  as integer   no-undo .
     1967    define input parameter  p-col-2  as integer   no-undo .
     1968     if p-size = ? then p-size = 10 .
     1969     if p-bold = ? then p-bold = false .
     1970     if p-italic = ? then p-italic = false .
     1971     if p-row-2 = ? then p-row-2 = p-row .
     1972     if p-col-2 = ? then p-col-2 = p-col .
     1973     put  stream macr_excel unformatted
     1974      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     1975     if p-color <> ? then do:
     1976        put  stream macr_excel unformatted
     1977          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     1978     end.
     1979     put  stream macr_excel unformatted
     1980          substitute('format.font(,&1,&2,&3)' , p-size,
     1981                                           string ( p-bold  , "true/false" ) ,
     1982                                           string ( p-italic , "true/false" )
     1983                                           ) + chr(10) .
     1984    end.
     1985   end procedure.
     1986   procedure macr_cell_size :
     1987    do
     1988    on error undo, return error return-value
     1989    :
     1990    define input parameter  p-w   as integer   no-undo .
     1991    define input parameter  p-l   as integer   no-undo .
     1992    define input parameter  p-row    as integer   no-undo .
     1993    define input parameter  p-col    as integer   no-undo .
     1994    define input parameter  p-row-2  as integer   no-undo .
     1995    define input parameter  p-col-2  as integer   no-undo .
     1996     if p-row-2 = ? then p-row-2 = p-row .
     1997     if p-col-2 = ? then p-col-2 = p-col .
     1998     if p-w = ? then    p-w = 0 .
     1999     if p-l = ? then    p-l = 0 .
     2000    define variable s-w as character no-undo .
     2001    define variable s-l as character no-undo .
     2002    if p-w = 0 then s-w = "" .
     2003               else s-w = string(p-w)  .
     2004    if p-l = 0 then s-l = "" .
     2005               else s-l = string(p-l)  .
     2006   put  stream macr_excel unformatted
     2007        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     2008   put  stream macr_excel unformatted
     2009        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     2010   put  stream macr_excel unformatted
     2011        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     2012    end.
     2013   end procedure.
     2014   procedure proc-print-header :
     2015    do
     2016    on error undo, return error return-value
     2017    :
     2018      find first sheetf .
     2019        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     2020        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     2021        var-1 =  num#str# .
     2022        repeat c-c = 1 to sheetf.excel-row-title :
     2023        num#str# = num#str# + 1 .
     2024        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     2025        do c-i = 1 to p-var :
     2026           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     2027           str--2 = integer(entry( c-i, sheetf.sizes )) .
     2028           num#col# = c-i .
     2029           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     2030           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     2031        end.
     2032       c-i = 0.
     2033       end.
     2034       run macr_cell_format (
     2035           10       ,
     2036           true     ,
     2037           false    ,
     2038           35       ,
     2039           var-1 + 1,
     2040           1        ,
     2041           num#str# ,
     2042           num#col# )
     2043           .
     2044     put  stream macr_excel unformatted
     2045          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     2046          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     2047          .
     2048    end.
     2049   end procedure.
     2050   procedure end-proc :
     2051    do
     2052    on error undo, return error return-value
     2053    :
     2054     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     2055     OUTPUT to VALUE (v-file-name) .
     2056     for each temp-param :
     2057       export  temp-param  .
     2058     end.
     2059    end.
     2060   end procedure.
