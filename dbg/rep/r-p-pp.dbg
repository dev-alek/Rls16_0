     1452       .
     1453     end.
     1454   end.
     1455   end.
     1456   end procedure.
     1457   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1458   procedure factord :
     1459     define input  parameter p-fact-date            as date    no-undo .
     1460     define input  parameter p-fact-time            as integer no-undo .
     1461     define input  parameter p-fact-num             as integer no-undo .
     1462     define input  parameter p-shift-date           as date    no-undo .
     1463     define input  parameter p-shift-num            as integer no-undo .
     1464     define input  parameter p-shift-on             as logical no-undo .
     1465     define output parameter p-fact-order           as decimal no-undo .
     1466     define output parameter p-shift-end-fact-order as decimal no-undo .
     1467     define output parameter p-day-end-fact-order   as decimal no-undo .
     1468     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1469     if p-fact-date = ?
     1470     then do:
     1471       return error "Не указана фактическая дата" .
     1472     end.
     1473     define variable v-fact-date-num as integer no-undo .
     1474     assign
     1475       v-fact-date-num = integer(p-fact-date)
     1476     .
     1477     if p-fact-num = ?
     1478     or p-fact-num = 0
     1479     then do:
     1480       return error "Не задан p-fact-num " + string(p-fact-num) .
     1481     end.
     1482     if p-fact-num < 0
     1483     then do:
     1484       return error "Отрицательный fact-num " + string(p-fact-num) .
     1485     end.
     1486     if p-fact-num >= 100000000
     1487     then do:
     1488       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1489     end.
     1490     if p-shift-on = true
     1491     then do:
     1492       if p-shift-date = ?
     1493       then do:
     1494         return error "Не задана дата смены" .
     1495       end.
     1496       if p-shift-num = ?
     1497       or p-shift-num = 0
     1498       then do:
     1499         return error "Не задан номер смены" .
     1500       end.
     1501     end.
     1502     else do:
     1503       assign
     1504         p-shift-date = p-fact-date
     1505         p-shift-num  = 24
     1506       .
     1507     end.
     1508     define variable v-shift-offset as integer no-undo .
     1509     if p-shift-date = p-fact-date
     1510     then do:
     1511       assign
     1512         v-shift-offset = 1
     1513       .
     1514     end.
     1515     if p-shift-date < p-fact-date
     1516     then do:
     1517       assign
     1518         v-shift-offset = 0
     1519       .
     1520     end.
     1521     if p-shift-date > p-fact-date
     1522     then do:
     1523       message
     1524         vss-workfile vss-revision vss-description skip
     1525         "Неправильная дата закрытия смены" skip
     1526         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1527         view-as alert-box error .
     1528       undo, return error
     1529         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1530           ,string(p-fact-date, '99/99/9999':U)
     1531           ,string(p-shift-date, '99/99/9999':U)
     1532           )
     1533       .
     1534     end.
     1535     if p-shift-num < 1
     1536     or p-shift-num > 24
     1537     then do:
     1538       message
     1539         vss-workfile vss-revision vss-description skip
     1540         "Неправильный номер смены" skip
     1541         "p-shift-num" p-shift-num skip
     1542         view-as alert-box error .
     1543       undo, return error return-value .
     1544     end.
     1545     assign
     1546       p-fact-order           = v-fact-date-num
     1547                              + v-shift-offset * 0.5
     1548                              + p-shift-num    * 0.02 - 0.01
     1549                              + p-fact-num     * 0.0000000001
     1550       p-shift-end-fact-order = v-fact-date-num
     1551                              + v-shift-offset * 0.5
     1552                              + p-shift-num    * 0.02
     1553       p-day-end-fact-order   = v-fact-date-num
     1554                              + 0.99
     1555     .
     1556     if p-fact-order           <= v-fact-date-num
     1557     or p-shift-end-fact-order <= v-fact-date-num
     1558     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1559     or p-shift-end-fact-order >= p-day-end-fact-order
     1560     then do:
     1561       message
     1562         vss-workfile vss-revision vss-description skip
     1563         "Внутренняя ошибка при генерации фактического номера" skip
     1564         "p-fact-date"            p-fact-date            skip
     1565         "p-fact-time"            p-fact-time            skip
     1566         "p-fact-num"             p-fact-num             skip
     1567         "p-shift-date"           p-shift-date           skip
     1568         "p-shift-num"            p-shift-num            skip
     1569         "p-shift-on"             p-shift-on             skip
     1570         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1571         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1572         "v-fact-date-num"        v-fact-date-num        skip
     1573         view-as alert-box error .
     1574       undo, return error return-value .
     1575     end.
     1576   end procedure.
     1577   procedure day-begin-fact-order :
     1578     define input  parameter p-fact-date            as date    no-undo .
     1579     define output parameter p-day-begin-fact-order as decimal no-undo .
     1580     do
     1581     on error undo, return error return-value
     1582     :
     1583       if p-fact-date = ?
     1584       then do:
     1585         assign
     1586           p-day-begin-fact-order = 0
     1587         .
     1588       end.
     1589       else do:
     1590         assign
     1591           p-day-begin-fact-order = integer(p-fact-date)
     1592         .
     1593       end.
     1594     end.
     1595   end procedure.
     1596   procedure factord-max-fact-order :
     1597     define output parameter p-max-fact-order as decimal   no-undo .
     1598     do
     1599     on error undo, return error return-value
     1600     :
     1601       run day-begin-fact-order in this-procedure
     1602         (input  date(1, 1, 5000)
     1603         ,output p-max-fact-order
     1604         ) .
     1605     end.
     1606   end procedure.
     1607   procedure factord-cut-archive :
     1608     define input  parameter p-obj-type             as character no-undo .
     1609     define input  parameter p-obj-code             as integer   no-undo .
     1610     define input  parameter p-fact-date            as date      no-undo .
     1611     define output parameter p-shift-on             as logical   no-undo .
     1612     define output parameter p-shift-date           as date      no-undo .
     1613     define output parameter p-shift-num            as integer   no-undo .
     1614     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1615     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1616     define variable v-fact-order as decimal   no-undo .
     1617     define buffer buf_shift-obj for ub.shift-obj .
     1618     do
     1619     on error undo, return error return-value
     1620     :
     1621   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1622   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1623     (input  p-obj-type
     1624     ,input  p-obj-code
     1625     ,input  'shift-on=request'
     1626     ,output p-shift-on
     1627     ) no-error .
     1628       if error-status :error
     1629       then do:
     1630         message
     1631           vss-workfile vss-revision vss-description skip
     1632           "Ошибка при определении атрибута объекта" skip
     1633           "Объект" p-obj-type p-obj-code skip
     1634           error-status :get-message(1) skip
     1635           return-value skip
     1636           view-as alert-box error .
     1637         undo, return error return-value .
     1638       end.
     1639       if p-shift-on = false
     1640       then do:
     1641         assign
     1642           p-shift-date               = ?
     1643           p-shift-num                = 0
     1644         .
     1645       end.
     1646       else do:
     1647         find first buf_shift-obj share-lock
     1648           where buf_shift-obj.obj-type   = p-obj-type
     1649             and buf_shift-obj.obj-code   = p-obj-code
     1650             and buf_shift-obj.shift-date > p-fact-date
     1651           use-index pi
     1652           no-error .
     1653         if not available buf_shift-obj
     1654         or buf_shift-obj.status_ <> 'зкр':U
     1655         then do:
     1656           message
     1657             vss-workfile vss-revision vss-description skip
     1658             "Невозможно вычислить последнюю смену" skip
     1659             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1660             "Объект" p-obj-type p-obj-code skip
     1661             "Дата" p-fact-date skip
     1662             view-as alert-box error .
     1663           undo, return error return-value .
     1664         end.
     1665         find last buf_shift-obj share-lock
     1666           where buf_shift-obj.obj-type = p-obj-type
     1667             and buf_shift-obj.obj-code = p-obj-code
     1668             and buf_shift-obj.shift-date <= p-fact-date
     1669           use-index pi
     1670           no-error .
     1671         if available buf_shift-obj
     1672         then do:
     1673           if  buf_shift-obj.status_ = 'зкр':U
     1674           then do:
     1675             assign
     1676               p-shift-date = buf_shift-obj.shift-date
     1677               p-shift-num  = buf_shift-obj.shift-num
     1678             .
     1679           end.
     1680           else do:
     1681             message
     1682               vss-workfile vss-revision vss-description skip
     1683               "Невозможно вычислить последнюю смену" skip
     1684               "Статус смены отличен от статуса" 'зкр':U skip
     1685               "Объект" p-obj-type p-obj-code skip
     1686               "Дата" p-fact-date skip
     1687               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1688               view-as alert-box error .
     1689             undo, return error return-value .
     1690           end.
     1691         end.
     1692         else do:
     1693           assign
     1694             p-shift-date = p-fact-date - 1
     1695             p-shift-num  = 1
     1696           .
     1697         end.
     1698       end.
     1699       run factord in this-procedure
     1700         (input  p-fact-date
     1701         ,input  1
     1702         ,input  1
     1703         ,input  p-shift-date
     1704         ,input  p-shift-num
     1705         ,input  p-shift-on
     1706         ,output v-fact-order
     1707         ,output p-shift-end-fact-order
     1708         ,output p-day-end-fact-order
     1709         ) no-error .
     1710       if error-status :error
     1711       then do:
     1712         message
     1713           vss-workfile vss-revision vss-description skip
     1714           "Ошибка при вызове процедуры factord"
     1715           error-status :get-message(1) skip
     1716           return-value skip
     1717           view-as alert-box error .
     1718         undo, return error return-value .
     1719       end.
     1720     end.
     1721   end procedure.
     1722   procedure factord-lock-shift :
     1723     define input  parameter p-obj-type  as character no-undo .
     1724     define input  parameter p-obj-code  as integer   no-undo .
     1725     define input  parameter p-fact-date as date      no-undo .
     1726     define parameter buffer buf_shift-obj for ub.shift-obj .
     1727     define variable v-shift-on      as logical   no-undo .
     1728     define variable v-extra-message as character no-undo .
     1729     define variable v-error as character no-undo .
     1730     do
     1731     on error undo, return error return-value
     1732     :
     1733   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1734   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1735     (input  p-obj-type
     1736     ,input  p-obj-code
     1737     ,input  'shift-on=request'
     1738     ,output v-shift-on
     1739     ) no-error .
     1740       if error-status :error
     1741       then do:
     1742         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1743         undo, return error v-error .
     1744       end.
     1745       if v-shift-on = true
     1746       then do:
     1747         find first buf_shift-obj share-lock
     1748           where buf_shift-obj.obj-type   = p-obj-type
     1749             and buf_shift-obj.obj-code   = p-obj-code
     1750             and buf_shift-obj.shift-date > p-fact-date
     1751           use-index pi
     1752           no-error .
     1753         if not available buf_shift-obj
     1754         or buf_shift-obj.status_ <> 'зкр':U
     1755         then do:
     1756           find last buf_shift-obj
     1757             where buf_shift-obj.obj-type = p-obj-type
     1758               and buf_shift-obj.obj-code = p-obj-code
     1759               and buf_shift-obj.status_  = 'зкр':U
     1760             use-index stts
     1761             no-error .
     1762           if available buf_shift-obj
     1763           then do:
     1764             assign
     1765               v-extra-message =
     1766                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1767                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1768                               )
     1769             .
     1770           end.
     1771           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1772           undo, return error v-error .
     1773         end.
     1774       end.
     1775     end.
     1776   end procedure.
     1777   procedure factord-end-day :
     1778     define input  parameter p-fact-date            as date    no-undo .
     1779     define output parameter p-day-end-fact-order   as decimal no-undo .
     1780     do
     1781     on error undo, return error return-value
     1782     :
     1783       if p-fact-date = ?
     1784       then do:
     1785         return error "Не указана фактическая дата" .
     1786       end.
     1787       assign
     1788         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1789       .
     1790     end.
     1791   end procedure.
     1792   procedure factord-to-date :
     1793     define input  parameter p-fact-order as decimal no-undo .
     1794     define output parameter p-fact-date  as date    no-undo .
     1795     define variable v-ref-date  as date      no-undo .
     1796     define variable v-ref-delta as integer   no-undo .
     1797     do
     1798     on error undo, return error return-value
     1799     :
     1800       if p-fact-order = ?
     1801       or p-fact-order = 0
     1802       then do:
     1803         return error "Не указан fact-order" .
     1804       end.
     1805       assign
     1806         v-ref-date  = date(1, 1, 2000)
     1807       .
     1808       assign
     1809         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1810       .
     1811       assign
     1812         p-fact-date = v-ref-date + v-ref-delta
     1813       .
     1814     end.
     1815   end procedure.
     1816   procedure factord-to-fact-num :
     1817     define input  parameter p-fact-order as decimal no-undo .
     1818     define output parameter p-fact-num   as integer no-undo .
     1819     define variable v-fact-order-trunc as decimal no-undo .
     1820     do
     1821     on error undo, return error return-value
     1822     :
     1823       if p-fact-order = ?
     1824       or p-fact-order = 0
     1825       then do:
     1826         return error "Не указан fact-order" .
     1827       end.
     1828       assign
     1829        v-fact-order-trunc = truncate(p-fact-order, 2)
     1830       .
     1831       assign
     1832         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1833       .
     1834     end.
     1835   end procedure.
     1836   procedure factord-to-shift-num :
     1837     define input  parameter p-fact-order as decimal no-undo .
     1838     define output parameter p-shift-num   as integer no-undo .
     1839     define variable  p-shift-numd  as decimal   no-undo .
     1840     define variable v-fact-order-trunc as decimal no-undo .
     1841     do
     1842     on error undo, return error return-value
     1843     :
     1844       if p-fact-order = ?
     1845       or p-fact-order = 0
     1846       then do:
     1847         return error "Не указан fact-order" .
     1848       end.
     1849       assign
     1850        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1851       .
     1852       if v-fact-order-trunc < 0.5 then do:
     1853         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1854       end.
     1855       assign
     1856         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1857         .
     1858        assign
     1859         p-shift-num = truncate (p-shift-numd , 0)
     1860       .
     1861     end.
     1862   end procedure.
     1863   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
