     1441       p-cli-code   =  if p-exists-income-cli and  p-cli-code = ?
     1442                         then v-cli-code-value
     1443                         else p-cli-code
     1444       v-found =  (p-exists-income-cli ) or (v-range <= 1)
     1445       jj = jj + 1
