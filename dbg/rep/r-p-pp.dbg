     1433                           then yes
     1434                           else p-exists-income-cli)
     1435       p-range-income-cli = if p-exists-income-cli and p-cli-type = ?
     1436                         then v-range
     1437                         else p-range-income-cli
     1438       p-cli-type   =  if p-exists-income-cli and  p-cli-type = ?
     1439                         then v-cli-type-value
