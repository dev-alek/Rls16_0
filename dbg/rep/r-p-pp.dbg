     1972   define new shared stream PrnLibStream.
     1973   procedure prn-lib-prn-file :
     1974     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1975     define input parameter p-DIsabledoptions as integer no-undo .
