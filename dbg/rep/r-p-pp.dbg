     1986         ).
     1987   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1988   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1989     (input  v-report-name
     1990     ,input  2
     1991     ,output v-exist
     1992     )  .
     1993       if NOT v-exist then
     1994       DO:
     1995         Message
     1996           "Нет заданий на печать ! "
     1997           view-as alert-box .
     1998         Return  .
     1999       End.
     2000       run gbl/prnfilen.w
     2001         (input  ""
     2002         ,input  p-DisabledOptions
     2003         ,input  string(v-report-name )
     2004         ,input  7
     2005         ,output v-user-action
     2006         ,output v-printed
     2007         ) .
     2008       if v-printed then
     2009       do:
     2010         return "YES" .
     2011       end.
     2012       else
     2013       do:
     2014         return "NO" .
     2015       end.
     2016     end.
     2017   end procedure.
     2018   procedure prn-lib-open-stream :
     2019     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     2020     define input parameter p-page-size    as integer no-undo .
     2021     define input parameter p-is-stream    as logical no-undo .
     2022     define input parameter p-append       as logical no-undo .
     2023     define variable v-report-name as character no-undo .
     2024     do
     2025       on error undo, return error
     2026       :
     2027       run prn-lib-get-report-name  in this-procedure (
     2028         input parParentProc
     2029         ,output v-report-name
     2030         ).
     2031       if p-is-stream then
     2032       do:
     2033         if p-append then
     2034         do:
     2035           output stream PrnLibStream to value( v-report-name )
     2036             page-size value(p-page-size) append .
     2037         end.
     2038         if not p-append then
     2039         do:
     2040           output stream PrnLibStream to value( v-report-name )
     2041             page-size value(p-page-size) .
     2042         end.
     2043       end.
     2044       if not p-is-stream then
     2045       do:
     2046         if p-append then
     2047         do:
     2048           output to value( v-report-name )
     2049             page-size value(p-page-size) append .
     2050         end.
     2051         if not p-append then
     2052         do:
     2053           output to value( v-report-name )
     2054             page-size value(p-page-size) .
     2055         end.
     2056       end.
     2057     end.
     2058   end procedure.
     2059   procedure prn-lib-open-exp :
     2060     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     2061     define input parameter p-is-stream    as logical no-undo .
     2062     define input parameter p-is-append    as logical no-undo .
     2063     define output parameter p-ReportFileName as char init "report" no-undo.
     2064     define output parameter p-process as logical no-undo .
     2065     define variable glog as logical no-undo .
     2066     do
     2067       on error undo, return error
     2068       :
     2069       SYSTEM-DIALOG GET-FILE p-ReportFileName
     2070         TITLE      "Укажите путь"
     2071         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     2072         ASK-OVERWRITE
     2073         CREATE-TEST-FILE
     2074         SAVE-AS
     2075         USE-FILENAME
     2076         DEFAULT-EXTENSION "txt"
     2077         UPDATE glog
     2078         .
     2079       if not glog then  return.
     2080       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     2081       if p-is-stream then
     2082       do:
     2083         if p-is-append then
     2084         do:
     2085           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     2086         end.
     2087         else
     2088         do:
     2089           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     2090         end.
     2091       end.
     2092       else
     2093       do:
     2094         if p-is-append then
     2095         do:
     2096           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     2097         end.
     2098         else
     2099         do:
     2100           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     2101         end.
     2102       end.
     2103       p-process = yes.
     2104     end.
     2105   end procedure.
     2106   procedure prn-lib-get-report-name :
     2107     define input parameter parParentProc  as widget-handle no-undo.
     2108     define output parameter p-report-name as character no-undo .
     2109     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     2110   end procedure.
     2111   procedure prn-lib-reportviewer-report-name :
     2112     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     2113     define input parameter p-report-name-html as character no-undo .
     2114     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     2115   end procedure.
     2116   procedure prn-lib-reportviewer :
     2117     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     2118     define input parameter p-report-name-html as character no-undo .
     2119     define input parameter p-param        as character no-undo .
     2120     define variable v-excel           as character no-undo init 'TRUE' .
     2121     define variable v-value-character as character no-undo .
     2122     define variable v-value-integer   as character no-undo .
     2123     define variable v-value-date      as date      no-undo .
     2124     define variable v-value-decimal   as decimal   no-undo .
     2125     define variable rep-excel         as logical   no-undo .
     2126     define variable excel-string      as character no-undo .
     2127     define variable v-param-type      as character no-undo .
     2128     define variable v-tth             as handle    no-undo .
     2129     run adm/shattri.p (
     2130       input "get":U
     2131       ,input  ""
     2132       ,input  0
     2133       ,input  'report-glob':U
     2134       ,input  'rep-excel':U
     2135       ,output v-value-character
     2136       ,output v-value-date
     2137       ,output v-value-decimal
     2138       ,output v-value-integer
     2139       ,output rep-excel
     2140       ,output v-param-type
     2141       ,INPUT-OUTPUT table-handle v-tth
     2142       )  .
     2143     if rep-excel then v-excel = "TRUE" .
     2144     else v-excel = "FALSE" .
     2145     if p-param eq ""
     2146     then
     2147        p-param = "EXCEL:" + v-excel.
     2148     else
     2149        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     2150     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     2151   end procedure.
     2152   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2153   function fnc-convert-dot-to-colon returns character
     2154       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
     2155   function fnc-convert-dot-to-colon returns character
     2156   (input p-data as decimal, input p-accur as character, input p-num as integer):
     2157       define variable result as character no-undo.
     2158       define variable v-str-result as character no-undo.
     2159       if p-data = ? then p-data = 0 .
     2160       p-data = round(p-data, p-num).
     2161       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     2162       return v-str-result.
     2163   END FUNCTION.
     2164   define input  parameter par-crsa    as logical   no-undo .
     2165   define input  parameter par-all     as integer   no-undo .
     2166   define input  parameter par-nacenka as logical   no-undo .
     2167   define input  parameter par-det-obj as logical   no-undo .
     2168   define variable parhost-code as integer no-undo .
     2169   parhost-code = v-cntxt-host-code-obj.
     2170   define variable kol-post     as integer   no-undo .
     2171   define variable v-goods-type as character no-undo .
     2172   define variable v-grp        as character no-undo .
     2173   define variable v-obj        as character no-undo .
     2174   define variable v-num-date   as integer   no-undo .
     2175   define variable v-start-date as date      no-undo .
     2176   define variable ii           as integer   no-undo .
     2177   define variable v-price      as decimal   no-undo .
     2178   define variable v-obj-code   as integer   no-undo .
     2179   define variable v-obj-type   as character no-undo .
     2180   define variable v-yes        as logical   no-undo .
     2181   define variable v-yes-only   as logical   no-undo .
     2182   define variable gg           as integer   no-undo .
     2183   define variable v-old-price  as decimal   no-undo .
     2184   define variable v-povtor     as logical   no-undo .
     2185   define variable v-fact-order-start as decimal no-undo .
     2186   define variable v-fact-order-end   as decimal no-undo .
     2187   define buffer bf_cli-gds  for ub.cli-gds .
     2188   define buffer bf_doc-line for ub.doc-line.
     2189   define buffer buf_clients for ub.clients .
     2190   define buffer buf_goods   for ub.goods .
     2191   define buffer buf_trn-doc for ub.trn-doc .
     2192   define variable v-price-rubl as decimal decimals 2 no-undo .
     2193   define variable v-price-cli  as decimal no-undo .
     2194   define variable v-goods      as logical no-undo .
     2195   define temp-table tt-temp no-undo
     2196     field gds-code   as integer
     2197     field gds-name   as char
     2198     field obj-type   as char
     2199     field obj-code   as int
     2200     field obj-name   as char
     2201     field cli-code   as int
     2202     field cli-type   as char
     2203     field cli-name   as char
     2204     field fact-date  as date
     2205     field price-rubl as decimal
     2206     field price-cli  as decimal
     2207     field price-prod as decimal
     2208     field nacenka    as character
     2209     field trn-date   as date
     2210     field fact-qty   as decimal
     2211     field resul      as logical
     2212     index pi  gds-code  obj-type obj-code fact-date
     2213     index pi2 fact-date desc
     2214     .
     2215   define temp-table tt-goods no-undo
     2216     field gds-code as integer
     2217     field obj-type as char
     2218     field obj-code as int
     2219     field five     as int
     2220     index pi gds-code obj-type obj-code
     2221     .
     2222   define buffer buf_tt for tt-temp .
     2223   define variable jj                 as integer no-undo .
     2224   define variable v-fact-order-alone as decimal no-undo .
     2225   define variable v-custom           as logical no-undo .
     2226   define stream Out-Stream.
     2227   define stream OutStr-html.
     2228   define variable v-report-name-html as character no-undo .
     2229   define variable v-report-id        as character no-undo .
     2230   if can-find (first g#customer) then v-custom = yes .
     2231   run day-begin-fact-order in this-procedure ( input ( x-Date-Start + 1 ),   output v-fact-order-start ).
     2232   run day-begin-fact-order in this-procedure ( input ( x-Date-End + 1 ),     output v-fact-order-end   ).
     2233   for each obj-list no-lock :
     2234     if v-obj= "" then v-obj = obj-list.obj-name .
     2235     else  v-obj = v-obj + ", " + obj-list.obj-name .
     2236     case x-SelectGood:
     2237       when 1 then
     2238         do:
     2239           v-goods-type = "Все товары" .
     2240           _DL :
     2241           for each buf_trn-doc no-lock where
     2242             buf_trn-doc.fact-date >= x-Date-Start and
     2243             buf_trn-doc.fact-date <= x-Date-End and
     2244             buf_trn-doc.ext-doc-type = 'ie':U and
     2245             buf_trn-doc.status_ = 'факт':U and
     2246             buf_trn-doc.obj-code = obj-list.obj-code and
     2247             buf_trn-doc.obj-type = obj-list.obj-type,
     2248             each bf_doc-line no-lock where
     2249             bf_doc-line.doc-code = buf_trn-doc.doc-code,
     2250             first buf_goods where buf_goods.artic = bf_doc-line.artic
     2251             and buf_goods.prod-code = bf_doc-line.prod-code
     2252             and buf_goods.prod-type = bf_doc-line.prod-type no-lock :
     2253             if v-custom and not can-find (first g#customer where g#customer.obj-code = buf_trn-doc.cli-code
     2254               and g#customer.obj-type = buf_trn-doc.cli-type no-lock) then NEXT _DL.
     2255             if bf_doc-line.fact-qnty = 0 then NEXT _DL .
     2256             run proc-temp-table .
     2257           end.
     2258         end.
     2259       when 4 then
     2260         do:
     2261           v-goods-type = "Выборочно" .
     2262           for each gds-list no-lock, each buf_goods no-lock where buf_goods.gds-code = gds-list.gds-code:
     2263             _DL :
     2264             for each bf_doc-line no-lock where
     2265               bf_doc-line.ext-doc-type = 'ie':U and
     2266               bf_doc-line.status_ = 'факт':U and
     2267               bf_doc-line.obj-code = obj-list.obj-code and
     2268               bf_doc-line.obj-type = obj-list.obj-type and
     2269               bf_doc-line.artic = gds-list.artic and
     2270               bf_doc-line.prod-code = gds-list.prod-code and
     2271               bf_doc-line.prod-type = gds-list.prod-type and
     2272               bf_doc-line.fact-order >= v-fact-order-start - 1 and
     2273               bf_doc-line.fact-order <= v-fact-order-end + 1,
     2274               first buf_trn-doc where buf_trn-doc.doc-code = bf_doc-line.doc-code and
     2275               buf_trn-doc.fact-date >= x-Date-Start and
     2276               buf_trn-doc.fact-date <= x-Date-End no-lock :
     2277               if v-custom and not can-find (first g#customer where g#customer.obj-code = buf_trn-doc.cli-code
     2278                 and g#customer.obj-type = buf_trn-doc.cli-type no-lock) then NEXT _DL.
     2279               run proc-temp-table  .
     2280             end.
     2281           end.
     2282         end.
     2283       when 2 then
     2284         do:
     2285           v-goods-type = "По группам" .
     2286           for each tmp#grp no-lock:
     2287   _DL :
     2288             for each buf_goods no-lock where buf_goods.grp-name begins tmp#grp.grp-name :
     2289               for each bf_doc-line no-lock where
     2290                 bf_doc-line.ext-doc-type = 'ie':U and
     2291                 bf_doc-line.status_ = 'факт':U and
     2292                 bf_doc-line.obj-code = obj-list.obj-code and
     2293                 bf_doc-line.obj-type = obj-list.obj-type and
     2294                 bf_doc-line.artic = buf_goods.artic and
     2295                 bf_doc-line.prod-code = buf_goods.prod-code and
     2296                 bf_doc-line.prod-type = buf_goods.prod-type and
     2297                 bf_doc-line.fact-order >= v-fact-order-start - 1 and
     2298                 bf_doc-line.fact-order <= v-fact-order-end + 1,
     2299                 first buf_trn-doc where buf_trn-doc.doc-code = bf_doc-line.doc-code and
     2300                 buf_trn-doc.fact-date >= x-Date-Start and
     2301                 buf_trn-doc.fact-date <= x-Date-End no-lock :
     2302                 if v-custom and not can-find (first g#customer where g#customer.obj-code = buf_trn-doc.cli-code
     2303                   and g#customer.obj-type = buf_trn-doc.cli-type no-lock) then NEXT _DL.
     2304                 run proc-temp-table  .
     2305               end.
     2306             end.
     2307           end.
     2308           end.
     2309         end case.
     2310     end.
     2311   run get-report-num in my-handle (
     2312     output v-report-id
     2313     ).
     2314   v-report-name-html = session:temp-directory  + string(v-report-id) + ".html".
     2315   output stream OutStr-html to value(v-report-name-html) convert target 'UTF-8' .
     2316   put stream OutStr-html unformatted
     2317     '<!doctype html>' skip
     2318     '  <html> ' skip
     2319     '   <head> ' skip
     2320     '    <meta charset="UTF-8"> ' skip
     2321     '        <!-- Стили документа --> 'skip
     2322     '    <style> ' skip
     2323     '         table ~{ ' skip
     2324     '             border-collapse: collapse; ' skip
     2325     '             width: 1400px;  ' skip
     2326     '         ~} ' skip
     2327     '         .class1 ~{ ' skip
     2328     '             border-collapse: collapse; ' skip
     2329     '        ~} ' skip
     2330     '         tbody td, th ~{ ' skip
     2331     '             border: 1px solid black; ' skip
     2332     '             border-collapse: collapse; ' skip
     2333     '       height: 14px; ' skip
     2334     '         ~} ' skip
     2335     '    </style> ' skip
     2336     '    </head> ' skip
     2337     '      <body> ' skip
     2338     '        <table orientation="landscape" name="Цены" fit_to_page="true">  <!-- таблица, в которой содержится шапка отчета --> ' skip
     2339     '          <thead>  <!-- Шапка отчета --> ' skip
     2340     '          <!-- Обязательно создаётся строка таблицы, в которой находятся размеры колонок в px--> ' skip
     2341     '            <tr class="set_columns"> ' skip
     2342     '              <td style="width:170px"></td> ' skip
     2343     '              <td style="width:70px"></td> ' skip
     2344     '              <td style="width:250px"></td> ' skip
     2345     '            </tr> ' skip
     2346     '          <tr> ' skip
     2347     '            <td colspan="3">За период с ' + string(x-Date-Start) + ' по ' + string(x-Date-End) + ' </td> ' skip
     2348     '          </tr> ' skip
     2349     '          <tr> ' skip
     2350     '            <td colspan="3">Выбор товара: ' + v-goods-type + '</td> ' skip
     2351     '          </tr> ' skip
     2352     '          <tr> ' skip
     2353     '            <td colspan="3">' + v-grp + '</td> ' skip
     2354     '          </tr> ' skip
     2355     '          <tr> ' skip
     2356     '            <td colspan="3">Выбор объекта: ' + v-obj + '</td> ' skip
     2357     '          </tr> ' skip
     2358     '          </thead>' skip
     2359     .
     2360   v-num-date = x-Date-End - x-Date-Start + 1 .
     2361   put stream OutStr-html unformatted
     2362     '<tbody>' skip
     2363     '<tr>' skip
     2364     '<th rowspan="2">Наименование поставщика</th>' skip
     2365     '<th rowspan="2">Код</th>' skip
     2366     '<th rowspan="2">Название товара</th>' skip
     2367     .
     2368   if par-det-obj then
     2369   do:
     2370     put stream OutStr-html unformatted
     2371       '<th rowspan="2">Объект</th>' skip
     2372       .
     2373   end.
     2374   put stream OutStr-html unformatted
     2375     '<th colspan="' + string(v-num-date) + '">Стоимость в учетных ценах за ед.</th>' skip
     2376     .
     2377   if par-crsa then
     2378   do:
     2379     put stream OutStr-html unformatted
     2380       '<th rowspan="2">Продажная цена</th>' skip
     2381       .
     2382   end.
     2383   if par-nacenka then
     2384   do:
     2385     put stream OutStr-html unformatted
     2386       '<th rowspan="2">Наценка %</th>' skip
     2387       .
     2388   end.
     2389   put stream OutStr-html unformatted
     2390     '</tr>' skip
     2391     '<tr>' skip
     2392     .
     2393   do v-start-date=x-Date-Start to x-Date-End :
     2394     put stream OutStr-html unformatted
     2395       '<th>' + string(v-start-date) + '</th>' skip
     2396       .
     2397   end.
     2398   put stream OutStr-html unformatted
     2399     '</tr>' skip
     2400     '<tr>' skip
     2401     .
     2402   define variable v-det-obj as integer no-undo .
     2403   v-det-obj = 3 .
     2404   if par-det-obj then v-det-obj = v-det-obj + 1.
     2405   if par-crsa then v-det-obj = v-det-obj + 1.
     2406   if par-nacenka then v-det-obj = v-det-obj + 1.
     2407   do v-start-date=(x-Date-Start - v-det-obj) to x-Date-End :
     2408     ii = ii + 1 .
     2409     put stream OutStr-html unformatted
     2410       '<th>' + string(ii) + '</th>' skip
     2411       .
     2412   end.
     2413   put stream OutStr-html unformatted
     2414     '</tr>' skip
     2415     .
     2416   if par-all = 1 then do:
     2417                 v-yes = no .
     2418                 v-yes-only = yes .
     2419   end.
     2420   else v-yes = yes .
     2421   for each tt-temp where tt-temp.resul = no no-lock:
     2422     v-yes-only = no .
     2423     if v-yes then
     2424     do:
     2425       gg = 0.
     2426       ch-yes:
     2427       for each buf_tt where buf_tt.gds-code = tt-temp.gds-code and
     2428           buf_tt.cli-code = tt-temp.cli-code and
     2429           buf_tt.cli-type = tt-temp.cli-type
     2430           no-lock :
     2431           gg = gg + 1.
     2432           if gg = 1 then v-old-price = buf_tt.price-rubl / buf_tt.fact-qty .
     2433               if v-old-price <> buf_tt.price-rubl / buf_tt.fact-qty  then do:
     2434                 v-yes-only = yes.
     2435                 leave ch-yes.
     2436                end.
     2437            v-old-price = buf_tt.price-rubl / buf_tt.fact-qty.
     2438         end.
     2439       end.
     2440       if v-yes-only or v-yes = no then do:
     2441       put stream OutStr-html unformatted
     2442         '<tr>' skip
     2443         '<td>' + string(tt-temp.cli-name) + '</td>' skip
     2444         '<td style="text-align: center;">' + string(tt-temp.gds-code) + '</td>' skip
     2445         '<td>' + string(tt-temp.gds-name) + '</td>' skip
     2446         .
     2447       if par-det-obj then
     2448       do:
     2449         put stream OutStr-html unformatted
     2450           '<td>' + string(tt-temp.obj-name) + '</td>' skip
     2451           .
     2452       end.
     2453       do v-start-date = x-Date-Start to x-Date-End :
     2454         find first buf_tt no-lock where buf_tt.gds-code = tt-temp.gds-code and
     2455           buf_tt.cli-code = tt-temp.cli-code and
     2456           buf_tt.cli-type = tt-temp.cli-type and
     2457           buf_tt.obj-code = tt-temp.obj-code and
     2458           buf_tt.obj-type = tt-temp.obj-type and
     2459           buf_tt.trn-date = v-start-date no-error .
     2460         if available buf_tt then
     2461         do:
     2462           buf_tt.resul = yes .
     2463             put stream OutStr-html unformatted
     2464               '<td num="0.00" val="' + fnc-convert-dot-to-colon((buf_tt.price-rubl / buf_tt.fact-qty),"->>>>>>>>>>>9.99",2) + '" style="text-align: right;">' + fnc-convert-dot-to-colon((buf_tt.price-rubl / buf_tt.fact-qty),"->>>>>>>>>>>9.99",2) + '</td>' skip
     2465               .
     2466           end.
     2467         else
     2468         do:
     2469           put stream OutStr-html unformatted
     2470             '<td num="0.00" val="' + fnc-convert-dot-to-colon(0.00,"->>>>>>>>9.99",2) + '" style="text-align: right;">' + fnc-convert-dot-to-colon(0.00,"->>>>>>>>>>>9.99",2) + '</td>' skip
     2471             .
     2472         end.
     2473       end.
     2474       if par-crsa then
     2475       do:
     2476         put stream OutStr-html unformatted
     2477         '<TD num="0.000" val="' + fnc-convert-dot-to-colon(tt-temp.price-prod,"->>>>>>>>>>>9.99",2) + '" style="text-align: right"> ' + if tt-temp.price-prod <> ? then fnc-convert-dot-to-colon(tt-temp.price-prod,"->>>>>>>>>>>9.99",2) + '</TD>' else "" + '</td>' skip
     2478           .
     2479       end.
     2480       if par-nacenka then
     2481       do:
     2482         put stream OutStr-html unformatted
     2483         '<TD num="0.000" val="' + fnc-convert-dot-to-colon(decimal (tt-temp.nacenka),"->>>>>>>>>>>9.99",2) + '" style="text-align: right"> ' + if tt-temp.nacenka <> ? then fnc-convert-dot-to-colon(decimal (tt-temp.nacenka),"->>>>>>>>>>>9.99",2) + '</TD>' else "" + '</td>' skip
     2484           .
     2485       end.
     2486       put stream OutStr-html unformatted
     2487         '</tr>' skip
     2488         .
     2489     end.
     2490   end.
     2491   put stream OutStr-html unformatted
     2492     '  </tbody>' skip
     2493     '  </body>' skip
     2494     '  </html> ' skip
     2495     .
     2496   output stream OutStr-html close.
     2497   run prn-lib-reportviewer-report-name in this-procedure (
     2498     input this-procedure
     2499     ,input v-report-name-html
     2500     ).
     2501   procedure proc-temp-table :
     2502     find first tt-temp where tt-temp.gds-code = buf_goods.gds-code and
     2503       tt-temp.trn-date = buf_trn-doc.fact-date and
     2504       tt-temp.cli-code = buf_trn-doc.cli-code and
     2505       tt-temp.cli-type = buf_trn-doc.cli-type and
     2506       tt-temp.obj-code = (if par-det-obj then bf_doc-line.obj-code else 0) and
     2507       tt-temp.obj-type = (if par-det-obj then bf_doc-line.obj-type else '') no-error .
     2508     if not available tt-temp then
     2509     do:
     2510       create tt-temp .
     2511       assign
     2512         tt-temp.gds-code   = buf_goods.gds-code
     2513         tt-temp.gds-name   = buf_goods.gds-name
     2514         tt-temp.trn-date   = buf_trn-doc.fact-date
     2515         tt-temp.cli-code   = buf_trn-doc.cli-code
     2516         tt-temp.cli-type   = buf_trn-doc.cli-type
     2517         tt-temp.obj-code   = if par-det-obj then bf_doc-line.obj-code else 0
     2518         tt-temp.obj-type   = if par-det-obj then bf_doc-line.obj-type else ''
     2519         .
     2520       if par-crsa then
     2521       do:
     2522         find first gds-obj no-lock where
     2523           gds-obj.gds-code = buf_goods.gds-code and
     2524           gds-obj.obj-code = obj-list.obj-code and
     2525           gds-obj.obj-type = obj-list.obj-type no-error.
     2526         if available gds-obj then tt-temp.price-prod = gds-obj.price-sale .
     2527       end.
     2528       find first ub.clients where ub.clients.obj-code = tt-temp.cli-code and ub.clients.obj-type = tt-temp.cli-type no-lock no-error .
     2529       if available ub.clients then tt-temp.cli-name = ub.clients.obj-name .
     2530       find first ub.clients where ub.clients.obj-code = tt-temp.obj-code and ub.clients.obj-type = tt-temp.obj-type no-lock no-error .
     2531       if available ub.clients then tt-temp.obj-name = ub.clients.obj-name .
     2532       if par-nacenka then
     2533       do:
     2534         define variable v-margins-range   as integer   no-undo.
     2535         define variable v-margins-exists  as logical   no-undo.
     2536         define variable v-increase-range  as integer   no-undo.
     2537         define variable v-increase-exists as logical   no-undo.
     2538         define variable v-min-marg        as decimal   no-undo.
     2539         define variable v-max-marg        as decimal   no-undo.
     2540         define variable v-increase-pc     as decimal   no-undo.
     2541         define variable v-round-method    as character no-undo.
     2542         define variable v-base            as decimal   no-undo .
     2543         define variable v-rmethod-range   as integer   no-undo.
     2544         define variable v-rmethod-exists  as logical   no-undo.
     2545         run grp-obj-margin-value in this-procedure
     2546           (        input gds-list.grp-code
     2547           , input obj-list.obj-type
     2548           , input obj-list.obj-code
     2549           , output v-min-marg
     2550           , output v-max-marg
     2551           , output v-increase-pc
     2552           , output v-round-method
     2553           , output v-base
     2554           , output v-margins-range
     2555           , output v-margins-exists
     2556           , output v-increase-range
     2557           , output v-increase-exists
     2558           , output v-rmethod-range
     2559           , output v-rmethod-exists
     2560           ) no-error .
     2561         if v-increase-exists then
     2562         do:
     2563           assign
     2564             tt-temp.nacenka = string( v-increase-pc )
     2565             .
     2566         end.
     2567       end.
     2568     end.
     2569     tt-temp.price-rubl = tt-temp.price-rubl + (bf_doc-line.price-rubl * bf_doc-line.fact-qnty).
     2570     tt-temp.fact-qty = tt-temp.fact-qty + bf_doc-line.fact-qnty .
     2571   end procedure.
