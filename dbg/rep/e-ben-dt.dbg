     1011   PROCEDURE check-modified :
     1012   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1013   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1014   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1015   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1016     IF check-state = "check":U THEN
     1017     DO:
     1018       RUN get-link-handle IN adm-broker-hdl
     1019         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1020            OUTPUT group-target-list).
     1021       IF group-target-list NE "":U THEN
     1022       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1023         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1024         RUN check-modified IN curr-widget ('group-check':U).
     1025         IF RETURN-VALUE NE "":U THEN
     1026         DO:
     1027           RUN check-modified-message(RETURN-VALUE).
     1028           RETURN "":U.
     1029         END.
     1030       END.
     1031     END.
     1032     RETURN "":U.
     1033   END PROCEDURE.
     1034   PROCEDURE check-modified-message :
     1035     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1036        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1037           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1038        IF RETURN-VALUE = "YES":U THEN
     1039           RUN notify ('view,CONTAINER-SOURCE':U).
     1040        MESSAGE IF p-changed-table NE ? THEN
     1041           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1042           ELSE "Current values have been changed."
     1043           SKIP "  Do you wish to save those changes?"
     1044           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1045        IF ANS THEN
     1046        DO:
     1047           IF group-assign-target THEN
     1048             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1049           ELSE RUN dispatch('update-record':U).
     1050           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1051           DO:
     1052               MESSAGE "Changes to the previous record were not saved."
     1053                 VIEW-AS ALERT-BOX ERROR.
     1054               IF group-assign-target THEN
     1055                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1056               ELSE RUN dispatch ('cancel-record':U).
     1057           END.
     1058        END.
     1059        ELSE DO:
     1060          IF group-assign-target THEN
     1061             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1062          ELSE RUN dispatch('cancel-record':U).
     1063        END.
     1064        RETURN.
     1065   END PROCEDURE.
     1066   PROCEDURE get-rowid :
     1067       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1068       ASSIGN
     1069       p-table   =   adm-first-table.
     1070       RETURN.
     1071   END PROCEDURE.
     1072   PROCEDURE init-group-assign :
     1073       RUN request-attribute IN adm-broker-hdl
     1074         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1075       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1076         group-assign-target = yes.
     1077       ELSE group-assign-target = no.
     1078       RETURN.
     1079   END PROCEDURE.
     1080   PROCEDURE set-editors :
     1081       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1082       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1083       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1084       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1085       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1086       DO WHILE VALID-HANDLE (curr-widget):
     1087           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1088              curr-widget:HIDDEN = no THEN DO:
     1089             CASE p-field-setting:
     1090               WHEN "INITIALIZE":U THEN
     1091               DO:
     1092                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1093                     read-only-list +
     1094                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1095                        STRING(curr-widget).
     1096               END.
     1097               WHEN "DISABLE":U OR
     1098               WHEN "ENABLE":U THEN
     1099               DO:
     1100                   curr-widget:SENSITIVE = yes.
     1101                   RUN get-attribute ('Read-Only-Editors':U).
     1102                   IF RETURN-VALUE = ? OR
     1103                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1104                       curr-widget:READ-ONLY =
     1105                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1106               END.
     1107               WHEN "CLEAR":U THEN
     1108                   curr-widget:SCREEN-VALUE = "":U.
     1109             END CASE.
     1110           END.
     1111           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1112       END.
     1113       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1114         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1115           + '"':U).
     1116       RETURN.
     1117   END PROCEDURE.
     1118   PROCEDURE use-check-modified-all :
     1119    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1120     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1121     RETURN.
     1122   END PROCEDURE.
     1123   PROCEDURE use-create-on-add :
     1124   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1125      RETURN.
     1126   END PROCEDURE.
     1127   PROCEDURE use-initial-lock :
     1128     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1129     ASSIGN adm-initial-lock = p-attr-value.
     1130     RETURN.
     1131   END PROCEDURE.
     1132     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1133   ASSIGN
     1134          FRAME F-Main:SCROLLABLE       = FALSE
     1135          FRAME F-Main:HIDDEN           = TRUE.
     1136   ON CHOOSE OF BUTTON-1 IN FRAME F-Main
     1137   DO:
     1138     run rep/askfld2.w (input-output ParamStr) .
     1139   END.
     1140   ON VALUE-CHANGED OF Classify IN FRAME F-Main
     1141   DO:
     1142       Assign Classify.
     1143      if Classify = "grp-goods":U
     1144            Then do:
     1145               display Itog   with frame F-Main .
     1146               enable  Itog   with frame F-Main .
     1147           end.
     1148            Else do:
     1149               Itog = false.
     1150               display  Itog  with frame F-Main .
     1151               disable  Itog  with frame F-Main .
     1152           end.
     1153   END.
     1154   ON VALUE-CHANGED OF DetalWeek IN FRAME F-Main
     1155   DO:
     1156   Assign DetalWeek.
     1157     if DetalWeek = 1 then do:
     1158       enable  week-1 week-2 week-3 week-4 week-5 week-12 week-22 week-32 week-42 week-52 with frame F-Main .
     1159     end.
     1160     else do:
     1161       disable week-1 week-2 week-3 week-4 week-5 week-12 week-22 week-32 week-42 week-52 with frame F-Main .
     1162     end.
     1163   END.
     1164   if not this-procedure :persistent
     1165   then do:
     1166     message
     1167       vss-workfile vss-revision vss-description skip
     1168       "Ошибка при запуске процедуры" skip
     1169       "Данную процедуру следует запускать только с параметром persistent" skip
     1170       view-as alert-box error .
     1171     undo, return error .
     1172   end.
     1173   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1174   on ' ' of month-1, month-2, month-3, month-4, week-1, week-12, week-2, week-22, week-3, week-32, week-4, week-42, week-5, week-52 in frame F-Main
     1175   do:
     1176     if (can-query (self, "sensitive")
     1177        and
     1178        self :sensitive = true
     1179        )
     1180     or (can-query (self, "read-only")
     1181        and
     1182        self :read-only = false
     1183        )
     1184     then do:
     1185       assign
     1186         self :screen-value = ?
     1187       .
     1188     end.
     1189     return no-apply.
     1190   end.
     1191   on delete-character of month-1, month-2, month-3, month-4, week-1, week-12, week-2, week-22, week-3, week-32, week-4, week-42, week-5, week-52 in frame F-Main
     1192   do:
     1193     if (can-query (self, "sensitive")
     1194        and
     1195        self :sensitive = true
     1196        )
     1197     or (can-query (self, "read-only")
     1198        and
     1199        self :read-only = false
     1200        )
     1201     then do:
     1202       assign
     1203         self :screen-value = ?
     1204       .
     1205     end.
     1206     return no-apply.
     1207   end.
     1208   on ctrl-d of month-1, month-2, month-3, month-4, week-1, week-12, week-2, week-22, week-3, week-32, week-4, week-42, week-5, week-52 in frame F-Main
     1209   do:
     1210     define variable v-curr-sv-date as date no-undo .
     1211     if (can-query (self, "sensitive")
     1212        and
     1213        self :sensitive = true
     1214        )
     1215     or (can-query (self, "read-only")
     1216        and
     1217        self :read-only = false
     1218        )
     1219     then do:
     1220       if self :handle <> focus :handle
     1221       then do:
     1222         apply "entry":u to self .
     1223       end.
     1224       run gbl/getcurdt.p
     1225         (output v-curr-sv-date
     1226         ) .
     1227       assign
     1228         self :screen-value = string(v-curr-sv-date) .
     1229       .
     1230     end.
     1231     return no-apply.
     1232   end.
     1233   on ctrl-b of month-1, month-2, month-3, month-4, week-1, week-12, week-2, week-22, week-3, week-32, week-4, week-42, week-5, week-52 in frame F-Main
     1234   do:
     1235     if (can-query (self, "sensitive")
     1236        and
     1237        self :sensitive = true
     1238        )
     1239     or (can-query (self, "read-only")
     1240        and
     1241        self :read-only = false
     1242        )
     1243     then do:
     1244       if self :handle <> focus :handle
     1245       then do:
     1246         apply "entry":u to self .
     1247       end.
     1248       define variable v-curr-sv-date as date no-undo .
     1249       define variable v-new-sv-date  as date no-undo .
     1250       assign
     1251         v-curr-sv-date = date(self :screen-value) no-error
     1252       .
     1253       if v-curr-sv-date = ?
     1254       then do:
     1255         run gbl/getcurdt.p
     1256           (output v-curr-sv-date
     1257           ) .
     1258       end.
     1259       if v-curr-sv-date <> ?
     1260       then do:
     1261         assign
     1262           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     1263         .
     1264         assign
     1265           self :screen-value = string(v-new-sv-date) .
     1266         .
     1267       end.
     1268     end.
     1269     return no-apply .
     1270   end.
     1271   on ctrl-e of month-1, month-2, month-3, month-4, week-1, week-12, week-2, week-22, week-3, week-32, week-4, week-42, week-5, week-52 in frame F-Main
     1272   do:
     1273     if (can-query (self, "sensitive")
     1274        and
     1275        self :sensitive = true
     1276        )
     1277     or (can-query (self, "read-only")
     1278        and
     1279        self :read-only = false
     1280        )
     1281     then do:
     1282       if self :handle <> focus :handle
     1283       then do:
     1284         apply "entry":u to self .
     1285       end.
     1286       define variable v-curr-sv-date as date no-undo .
     1287       define variable v-new-sv-date  as date no-undo .
     1288       assign
     1289         v-curr-sv-date = date(self :screen-value) no-error
     1290       .
     1291       if v-curr-sv-date = ?
     1292       then do:
     1293         run gbl/getcurdt.p
     1294           (output v-curr-sv-date
     1295           ) .
     1296       end.
     1297       if v-curr-sv-date <> ?
     1298       then do:
     1299         run gbl/lastdate.p
     1300           (input  v-curr-sv-date
     1301           ,output v-new-sv-date
     1302           ).
     1303         assign
     1304           self :screen-value = string(v-new-sv-date) .
     1305         .
     1306       end.
     1307     end.
     1308     return no-apply .
     1309   end.
     1310   on ctrl-f of month-1, month-2, month-3, month-4, week-1, week-12, week-2, week-22, week-3, week-32, week-4, week-42, week-5, week-52 in frame F-Main
     1311   do:
     1312     if (can-query (self, "sensitive")
     1313        and
     1314        self :sensitive = true
     1315        )
     1316     or (can-query (self, "read-only")
     1317        and
     1318        self :read-only = false
     1319        )
     1320     then do:
     1321       if self :handle <> focus :handle
     1322       then do:
     1323         apply "entry":u to self .
     1324       end.
     1325       define variable v-ok            as logical   no-undo .
     1326       define variable v-curr-sv-date  as date      no-undo .
     1327       define variable v-description   as character no-undo .
     1328       assign
     1329         v-curr-sv-date = date(self :screen-value) no-error
     1330       .
     1331       if v-curr-sv-date = ?
     1332       then do:
     1333         run gbl/getcurdt.p
     1334           (output v-curr-sv-date
     1335           ) .
     1336       end.
     1337       if v-curr-sv-date <> ?
     1338       then do:
     1339         run gbl/d-inpday.w
     1340           (input ?
     1341           ,input "Выбор даты"
     1342           ,input v-description
     1343           ,input ""
     1344           ,input-output v-curr-sv-date
     1345           ,output v-ok
     1346           ).
     1347         if v-ok = true
     1348         then do:
     1349           assign
     1350             self :screen-value = string(v-curr-sv-date) .
     1351           .
     1352         end.
     1353       end.
     1354     end.
     1355     return no-apply .
     1356   end.
     1357   PROCEDURE disable_UI :
     1358     HIDE FRAME F-Main.
     1359     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1360   END PROCEDURE.
     1361   PROCEDURE find-fo :
     1362   def input  parameter date1 as date no-undo.
     1363   def input  parameter date2 as date no-undo.
     1364   def output parameter f-1   like ot-line.fact-order no-undo.
     1365   def output parameter f-2   like ot-line.fact-order no-undo.
     1366      Assign f-1 = Integer(date1 - 1) + 0.99  f-2 = Integer(date2)  + 0.99.
     1367   END PROCEDURE.
     1368   PROCEDURE local-initialize :
     1369     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1370     disable  Itog  with frame F-Main .
     1371     assign
     1372       month-3 :screen-value in frame F-Main = string(x-Date-Start,"99/99/9999")
     1373       month-4 :screen-value in frame F-Main = string(x-Date-End,"99/99/9999")
     1374     .
     1375    find first ubflt.usr-flt no-lock
     1376      where ubflt.usr-flt.user-name = g#userid
     1377        and ubflt.usr-flt.call-point   = "e-ben-dt":U
     1378    no-error .
     1379    if available ubflt.usr-flt then do:
     1380      assign
     1381        ParamStr = ubflt.usr-flt.list_
     1382      .
     1383    end.
     1384    else run rep/askfld2.w (input-output ParamStr) .
     1385   END PROCEDURE.
     1386   PROCEDURE my-report :
     1387    run rep/r-ben-dt.p  (
     1388      input  SortType1,
     1389      input  Classify ,
     1390      input  DetalWeek,
     1391      input  Itog ,
     1392      input  month-1  ,
     1393      input  month-2  ,
     1394      input  month-3  ,
     1395      input  month-4  ,
     1396      input  week-1   ,
     1397      input  week-12  ,
     1398      input  week-2   ,
     1399      input  week-22  ,
     1400      input  week-3   ,
     1401      input  week-32  ,
     1402      input  week-4   ,
     1403      input  week-42  ,
     1404      input  week-5   ,
     1405      input  week-52  ,
     1406      input  ParamStr
     1407      ) .
     1408   END PROCEDURE.
     1409   PROCEDURE my-var :
     1410   define variable v-check-date as date      no-undo .
     1411     define variable v-archive-ok as logical   no-undo .
     1412     define variable v-comment    as character no-undo .
     1413     define variable v-can-print  as logical   no-undo .
     1414   define variable NumObj as integer initial 0  no-undo .
     1415   define variable NumWeek as integer initial 0  no-undo .
     1416   define variable NumPrice as integer initial 0  no-undo .
     1417   assign frame F-Main Itog DetalWeek Classify SortType1 month-1 month-2 month-3 month-4 week-1 week-12 week-2 week-22
     1418                              week-3 week-32 week-4 week-42 week-5 week-52 .
     1419   if week-1 <> ? and week-12 <> ? then NumWeek = NumWeek + 1 .
     1420   if week-2 <> ? and week-22 <> ? then NumWeek = NumWeek + 1 .
     1421   if week-3 <> ? and week-32 <> ? then NumWeek = NumWeek + 1 .
     1422   if week-4 <> ? and week-42 <> ? then NumWeek = NumWeek + 1 .
     1423   if week-5 <> ? and week-52 <> ? then NumWeek = NumWeek + 1 .
     1424     if DetalWeek = 1 and NumWeek = 0 then do:
     1425       message 'Не заданы понедельные интервалы просмотра реализации ! ' view-as alert-box error.
     1426       return 'second-page':u  .
     1427     end.
     1428   Assign
     1429    STR-obj-type = ''
     1430    STR-obj-code = ''
     1431    STR-obj-name = ''
     1432    STR-obj      = ''.
     1433   For each obj-list no-lock:
     1434     Assign
     1435       NumObj = NumObj + 1
     1436       STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     1437       STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     1438       STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     1439       STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     1440   End.
     1441   ReportNAme = "Д В И Ж Е Н И Е   Т О В А Р А".
     1442   def var t-class as char no-undo.
     1443     CASE Classify:
     1444       WHEN "no-classify":U    THEN t-class =   "Без классификации" .
     1445       WHEN "grp-goods":U      THEN t-class =   "Группы товаров"  .
     1446    End case.
     1447   ReportHeader = "Классификация : " + t-Class.
     1448   ReportHeader = ReportHeader + chr(10).
     1449   if x-SET_val_TYPE = 1 then ReportHeader = ReportHeader + "Цены указаны в: рублях" + chr(10).
     1450   else                       ReportHeader = ReportHeader + "Цены указаны в: валюте" + chr(10).
     1451   ReportHeader = ReportHeader + "Интервал реализации : " .
     1452   ReportHeader = ReportHeader  + if month-1 <> DATE('') THEN  " с " + String(month-1,"99.99.9999")            ELSE "" .
     1453   ReportHeader = ReportHeader  + if month-2 <> DATE('') THEN  " по " + String(month-2,"99.99.9999")      + chr(10) ELSE "" .
     1454     if DetalWeek = 1 then do:
     1455       ReportHeader = ReportHeader  + if week-1  <> DATE('')   THEN  " 1я неделя " + String(week-1,"99.99.9999")          ELSE ""  .
     1456       ReportHeader = ReportHeader  + if week-12 <> DATE('')   THEN  " по " + String(week-12,"99.99.9999")      + chr(10) ELSE ""  .
     1457       ReportHeader = ReportHeader  + if week-2  <> DATE('')   THEN  " 2я неделя " + String(week-2,"99.99.9999")          ELSE ""  .
     1458       ReportHeader = ReportHeader  + if week-22 <> DATE('')   THEN  " по " + String(week-22,"99.99.9999")      + chr(10) ELSE ""  .
     1459       ReportHeader = ReportHeader  + if week-3  <> DATE('')   THEN  " 3я неделя " + String(week-3,"99.99.9999")          ELSE ""  .
     1460       ReportHeader = ReportHeader  + if week-32 <> DATE('')   THEN  " по " + String(week-32,"99.99.9999")      + chr(10) ELSE ""  .
     1461       ReportHeader = ReportHeader  + if week-4  <> DATE('')   THEN  " 4я неделя " + String(week-4,"99.99.9999")          ELSE ""  .
     1462       ReportHeader = ReportHeader  + if week-42 <> DATE('')   THEN  " по " + String(week-42,"99.99.9999")      + chr(10) ELSE ""  .
     1463       ReportHeader = ReportHeader  + if week-5  <> DATE('')   THEN  " 5я неделя " + String(week-5,"99.99.9999")          ELSE ""  .
     1464       ReportHeader = ReportHeader  + if week-52 <> DATE('')   THEN  " по " + String(week-52,"99.99.9999")      + chr(10) ELSE "" .
     1465     end.
     1466     else do:
     1467       ReportHeader = ReportHeader  + "реализация с разбивкой по месяцам"  + chr(10) .
     1468     end.
     1469   ReportHeader = ReportHeader + "Интервал среднесуточной реализации : " .
     1470   ReportHeader = ReportHeader  + if month-3 <> DATE('') THEN  " с " + String(month-3,"99.99.9999")            ELSE "" .
     1471   ReportHeader = ReportHeader  + if month-4 <> DATE('') THEN  " по " + String(month-4,"99.99.9999")      + chr(10) ELSE "" .
     1472     define variable t-Sort as character no-undo .
     1473     case SortType1 :
     1474       when 1 then  t-Sort = "по кол-ву реализованного" .
     1475       when 2 then  t-Sort = "по кол-ву заказанного" .
     1476       when 3 then  t-Sort = "по кол-ву остатков" .
     1477     end.
     1478     ReportHeader = ReportHeader + "Сортировка " + t-Sort .
     1479     assign
     1480       v-check-date = maximum( month-1 ,
     1481                         month-2 ,
     1482                         week-1  ,
     1483                         week-12 ,
     1484                         week-2  ,
     1485                         week-22 ,
     1486                         week-3  ,
     1487                         week-32 ,
     1488                         week-4  ,
     1489                         week-42 ,
     1490                         week-5  ,
     1491                         week-52 )
     1492     .
     1493     run rep/chk-ahz.p
     1494       (input        v-cntxt-obj-type
     1495       ,input        v-cntxt-obj-code
     1496       ,input        false
     1497       ,input        true
     1498       ,input        false
     1499       ,input        false
     1500       ,input        true
     1501       ,input        v-cntxt-db-num
     1502       ,input        v-cntxt-userid
     1503       ,input-output v-check-date
     1504       ,input-output v-check-date
     1505       ,output       v-archive-ok
     1506       ,output       v-comment
     1507       ,output       v-can-print
     1508       ).
     1509     run find-fo in this-procedure
     1510       (input  month-1
     1511       ,input  month-2
     1512       ,output fo0
     1513       ,output fo02
     1514       ).
     1515     run find-fo in this-procedure
     1516       (input  week-1
     1517       ,input  week-12
     1518       ,output fo1
     1519       ,output fo12
     1520       ).
     1521     run find-fo in this-procedure
     1522       (input  week-2
     1523       ,input  week-22
     1524       ,output fo2
     1525       ,output fo22
     1526       ).
     1527     run find-fo in this-procedure
     1528       (input  week-3
     1529       ,input  week-32
     1530       ,output fo3
     1531       ,output fo32
     1532       ).
     1533     run find-fo in this-procedure
     1534       (input  week-4
     1535       ,input  week-42
     1536       ,output fo4
     1537       ,output fo42
     1538       ).
     1539     run find-fo in this-procedure
     1540       (input  week-5
     1541       ,input  week-52
     1542       ,output fo5
     1543       ,output fo52
     1544       ).
     1545   END PROCEDURE.
     1546   PROCEDURE state-changed :
     1547     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1548     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1549     def var nn as int no-undo.
     1550     def var ret# as log no-undo.
     1551     CASE p-state:
     1552     END CASE.
     1553   if month-1 = ? THEN   month-1 = DAte(month(x-Date-Start ),1,year(x-Date-Start )).
     1554   if month-2 = ? THEN   DO:
     1555       month-2 = x-Date-End  .
     1556       End.
     1557         Nn = Weekday(Date(Month(Month-1 ),1,Year(Month-1)))  .
     1558         if week-1  = ? THEN   week-1  = month-1 + (2 - NN)                           .
     1559         if week-12 = ? THEN   week-12 = week-1 +  6                                  .
     1560         if week-2  = ? THEN   week-2  = week-12 + 1                                  .
     1561         if week-22 = ? THEN   week-22 = week-2  + 6                                  .
     1562         if week-3  = ? THEN   week-3  = week-22 + 1                                  .
     1563         if week-32 = ? THEN   week-32 = week-3  + 6                                  .
     1564         if week-4  = ? THEN   week-4  = week-32 + 1                                  .
     1565         if week-42 = ? THEN   week-42 = week-4  + 6                                  .
     1566         if week-5  = ? THEN   week-5  = week-42 + 1                                  .
     1567         if week-52 = ? THEN   week-52 = week-5 + 6                                   .
     1568   display month-1 month-2 week-1 week-12 week-2 week-22 week-3 week-32 week-4 week-42 week-5 week-52 with frame F-Main.
     1569   END PROCEDURE.
