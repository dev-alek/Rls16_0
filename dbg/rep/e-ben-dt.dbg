      653   DEFINE BUTTON BUTTON-1
      654        LABEL "Колонки для отчета"
      655        SIZE 21.5 BY 1.13.
      656   DEFINE VARIABLE month-1 AS DATE FORMAT "99/99/9999":U
      657        LABEL "Реализация c"
      658        VIEW-AS FILL-IN
      659        SIZE 12 BY 1 NO-UNDO.
      660   DEFINE VARIABLE month-2 AS DATE FORMAT "99/99/9999":U
      661        LABEL "по"
      662        VIEW-AS FILL-IN
      663        SIZE 12 BY 1 NO-UNDO.
      664   DEFINE VARIABLE month-3 AS DATE FORMAT "99/99/9999":U
      665        LABEL "Сред. суточ. реализ. c"
      666        VIEW-AS FILL-IN
      667        SIZE 12 BY 1 NO-UNDO.
      668   DEFINE VARIABLE month-4 AS DATE FORMAT "99/99/9999":U
      669        LABEL "по"
      670        VIEW-AS FILL-IN
      671        SIZE 12 BY 1 NO-UNDO.
      672   DEFINE VARIABLE week-1 AS DATE FORMAT "99/99/9999":U
      673        LABEL "Неделя 1 с"
      674        VIEW-AS FILL-IN NATIVE
      675        SIZE 12 BY 1 NO-UNDO.
      676   DEFINE VARIABLE week-12 AS DATE FORMAT "99/99/9999":U
      677        LABEL "по"
      678        VIEW-AS FILL-IN NATIVE
      679        SIZE 12 BY 1 NO-UNDO.
      680   DEFINE VARIABLE week-2 AS DATE FORMAT "99/99/9999":U
      681        LABEL "Неделя 2 с"
      682        VIEW-AS FILL-IN NATIVE
      683        SIZE 12 BY 1 NO-UNDO.
      684   DEFINE VARIABLE week-22 AS DATE FORMAT "99/99/9999":U
      685        LABEL "по"
      686        VIEW-AS FILL-IN NATIVE
      687        SIZE 12 BY 1 NO-UNDO.
      688   DEFINE VARIABLE week-3 AS DATE FORMAT "99/99/9999":U
      689        LABEL "Неделя 3 с"
      690        VIEW-AS FILL-IN NATIVE
      691        SIZE 12 BY 1 NO-UNDO.
      692   DEFINE VARIABLE week-32 AS DATE FORMAT "99/99/9999":U
      693        LABEL "по"
      694        VIEW-AS FILL-IN NATIVE
      695        SIZE 12 BY 1 NO-UNDO.
      696   DEFINE VARIABLE week-4 AS DATE FORMAT "99/99/9999":U
      697        LABEL "Неделя 4 c"
      698        VIEW-AS FILL-IN NATIVE
      699        SIZE 12 BY 1 NO-UNDO.
      700   DEFINE VARIABLE week-42 AS DATE FORMAT "99/99/9999":U
      701        LABEL "по"
      702        VIEW-AS FILL-IN NATIVE
      703        SIZE 12 BY 1 NO-UNDO.
