      708   DEFINE VARIABLE week-52 AS DATE FORMAT "99/99/9999":U
      709        LABEL "по"
      710        VIEW-AS FILL-IN NATIVE
      711        SIZE 12 BY 1 NO-UNDO.
      712   DEFINE VARIABLE Classify AS CHARACTER
      713        VIEW-AS RADIO-SET VERTICAL
      714        RADIO-BUTTONS
      715             "Без классификации", "no-classify":U,
      716   "Группы товаров", "grp-goods":U
      717        SIZE 19.75 BY 2.21
      718        FGCOLOR 0  NO-UNDO.
      719   DEFINE VARIABLE DetalWeek AS INTEGER
      720        VIEW-AS RADIO-SET VERTICAL
      721        RADIO-BUTTONS
      722             "Понедельно", 1,
      723   "Помесячно", 2
      724        SIZE 17.63 BY 2.21
      725        FGCOLOR 0  NO-UNDO.
      726   DEFINE VARIABLE SortType1 AS INTEGER
      727        VIEW-AS RADIO-SET VERTICAL
      728        RADIO-BUTTONS
      729             "по кол-ву реализов.", 1,
      730   "по кол-ву заказанного", 2,
      731   "по кол-ву оставшегося", 3
      732        SIZE 25.25 BY 3.13
      733        FGCOLOR 0  NO-UNDO.
      734   DEFINE RECTANGLE RECT-5
      735        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      736        SIZE 40.75 BY 4.92.
      737   DEFINE RECTANGLE RECT-6
      738        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      739        SIZE 27.75 BY 4.92.
      740   DEFINE RECTANGLE RECT-9
      741        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      742        SIZE 68.5 BY 9.54.
      743   DEFINE VARIABLE Itog AS LOGICAL INITIAL no
      744        LABEL "Только итоги":L
      745        VIEW-AS TOGGLE-BOX
      746        SIZE 16.88 BY .83
      747        FGCOLOR 0  NO-UNDO.
      748   DEFINE FRAME F-Main
      749        SortType1 AT ROW 2.33 COL 42.75 NO-LABEL
      750        Classify AT ROW 2.5 COL 2.25 NO-LABEL
      751        Itog AT ROW 3.88 COL 22.75
      752        month-3 AT ROW 7.67 COL 24.38 COLON-ALIGNED
      753        month-4 AT ROW 7.71 COL 40.88 COLON-ALIGNED
      754        DetalWeek AT ROW 9.08 COL 47.88 NO-LABEL
      755        month-1 AT ROW 9.13 COL 14.25 COLON-ALIGNED
      756        month-2 AT ROW 9.13 COL 31.5 COLON-ALIGNED
      757        week-1 AT ROW 10.08 COL 14.38 COLON-ALIGNED
      758        week-12 AT ROW 10.17 COL 31.5 COLON-ALIGNED
      759        week-2 AT ROW 11.08 COL 14.38 COLON-ALIGNED
      760        week-22 AT ROW 11.17 COL 31.5 COLON-ALIGNED
      761        week-3 AT ROW 12.13 COL 14.38 COLON-ALIGNED
      762        week-32 AT ROW 12.21 COL 31.5 COLON-ALIGNED
      763        week-4 AT ROW 13.21 COL 14.38 COLON-ALIGNED
      764        week-42 AT ROW 13.29 COL 31.5 COLON-ALIGNED
      765        week-5 AT ROW 14.25 COL 14.38 COLON-ALIGNED
      766        week-52 AT ROW 14.33 COL 31.5 COLON-ALIGNED
      767        BUTTON-1 AT ROW 16.29 COL 6
      768        "Классификация :":C39 VIEW-AS TEXT
      769             SIZE 38.75 BY .75 AT ROW 1.46 COL 2.25
      770             FGCOLOR 4
      771        "Интервалы просмотра реализации":C45 VIEW-AS TEXT
      772             SIZE 45.75 BY .67 AT ROW 6.71 COL 1.75
      773             FGCOLOR 4
      774        "Сортировка :" VIEW-AS TEXT
      775             SIZE 13.63 BY .75 AT ROW 1.46 COL 42.88
      776             FGCOLOR 4
      777        RECT-5 AT ROW 1 COL 1
      778        RECT-9 AT ROW 6.38 COL 1.25
      779        RECT-6 AT ROW 1 COL 41.88
      780       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      781            SIDE-LABELS NO-UNDERLINE THREE-D
      782            AT COL 1 ROW 1 SCROLLABLE .
      783   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      784   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      785   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      786   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      787   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      788   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      789   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      790   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      791         adm-object-hdl = FRAME F-Main:HANDLE.
      792   RUN ensure-broker.
      793   THIS-PROCEDURE:ADM-DATA =
      794        'ADM1.1~`':U +
      795        'SmartObject~`':U +
      796        '~`':U +
      797        'NO ~`':U +
      798        '~`':U +
      799        '~`':U +
      800        '~`':U +
      801        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      802           + "~`":U +
      803        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      804        'Record-Source,Record-Target,TableIO-Target~`':U +
      805        '~`':U +
      806        '~`~`~`~`~`~`~`~`~`~`~`':U +
      807        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      808            THEN "^^":U
      809        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      810             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      811   PROCEDURE adm-apply-entry :
      812     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      813   END PROCEDURE.
      814   PROCEDURE adm-destroy :
      815    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      816   END PROCEDURE.
      817   PROCEDURE adm-disable :
      818       DISABLE RECT-5 RECT-9 RECT-6 SortType1 Classify month-3 month-4 DetalWeek month-1 month-2 week-1 week-12 week-2 week-22 week-3 week-32 week-4 week-42 week-5 week-52 BUTTON-1 WITH FRAME F-Main.
      819       RUN dispatch ('disable-fields':U).
      820       RUN set-attribute-list ('ENABLED=no':U).
      821       RETURN.
      822   END PROCEDURE.
      823   PROCEDURE adm-edit-attribute-list :
      824         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      825         RETURN.
      826   END PROCEDURE.
      827   PROCEDURE adm-enable :
      828       ENABLE UNLESS-HIDDEN RECT-5 RECT-9 RECT-6 SortType1 Classify month-3 month-4 DetalWeek month-1 month-2 week-1 week-12 week-2 week-22 week-3 week-32 week-4 week-42 week-5 week-52 BUTTON-1 WITH FRAME F-Main.
      829       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      830       RUN set-attribute-list ('ENABLED=yes':U).
      831       RETURN.
      832   END PROCEDURE.
      833   PROCEDURE adm-exit :
      834        RUN notify ('exit':U).
      835     RETURN.
      836   END PROCEDURE.
      837   PROCEDURE adm-hide :
      838     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      839   END PROCEDURE.
      840   PROCEDURE adm-initialize :
      841     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      842   END PROCEDURE.
      843   PROCEDURE adm-show-errors :
      844       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      845       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      846           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      847       END.
      848       RETURN.
      849   END PROCEDURE.
      850   PROCEDURE adm-UIB-mode :
      851     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      852   END PROCEDURE.
      853   PROCEDURE adm-view :
      854     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      855   END PROCEDURE.
      856   PROCEDURE dispatch :
      857       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      858       RUN broker-dispatch IN adm-broker-hdl
      859           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      860       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      861   END PROCEDURE.
      862   PROCEDURE ensure-broker :
      863   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      864   IF RETURN-VALUE NE "ADM-Broker":U THEN
      865   DO:
      866       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      867       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      868   END.
      869   END PROCEDURE.
      870   PROCEDURE get-attribute :
      871     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      872     RUN broker-get-attribute IN adm-broker-hdl
      873         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      874     RETURN RETURN-VALUE.
      875   END PROCEDURE.
      876   PROCEDURE get-attribute-list :
      877     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      878     RUN broker-get-attribute-list IN adm-broker-hdl
      879         (INPUT THIS-PROCEDURE,
      880          INPUT ?,
      881          OUTPUT p-attr-list) NO-ERROR.
      882     RETURN.
      883   END PROCEDURE.
      884   PROCEDURE new-state :
      885     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      886     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      887     RETURN.
      888   END PROCEDURE.
      889   PROCEDURE notify :
      890     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      891     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      892     IF RETURN-VALUE = "ADM-ERROR":U THEN
      893         RETURN "ADM-ERROR":U.
      894     RETURN.
      895   END PROCEDURE.
      896   PROCEDURE set-attribute-list :
      897     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      898     RUN ensure-broker.
      899     RUN broker-set-attribute-list IN adm-broker-hdl
      900         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      901     RETURN.
      902   END PROCEDURE.
      903   PROCEDURE set-position :
      904       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      905       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      906       IF VALID-HANDLE(adm-object-hdl) THEN
      907       DO:
      908         ASSIGN adm-object-hdl:ROW    =   p-row
      909                adm-object-hdl:COLUMN =   p-col.
      910       END.
      911       RETURN.
      912   END PROCEDURE.
      913   PROCEDURE adm-display-fields :
      914       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      915       RETURN.
      916   END PROCEDURE.
      917   PROCEDURE adm-open-query :
      918     RETURN.
      919   END PROCEDURE.
      920   PROCEDURE adm-row-changed :
      921         IF VALID-HANDLE(adm-object-hdl) THEN
      922           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      923         RUN notify ('row-available':U).
      924         RETURN.
      925   END PROCEDURE.
      926   PROCEDURE reposition-query :
      927       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      928       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      929       RETURN.
      930   END PROCEDURE.
      931     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      932     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      933     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      934     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      935     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      936     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      937     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      938     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      939     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      940     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      941     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      942     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      943     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      944     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      945     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      946     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      947     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      948     IF "":U = "":U THEN
      949       RUN modify-list-attribute IN adm-broker-hdl
      950         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      951     RUN use-create-on-add(?).
      952   PROCEDURE adm-add-record :
      953       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      954          "must have at least one Enabled Table to perform Add.":U
      955          VIEW-AS ALERT-BOX ERROR.
      956       RETURN.
      957   END PROCEDURE.
