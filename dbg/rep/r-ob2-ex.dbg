      143   procedure create_obj-list :
      144      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      145      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      146      do
      147      on error undo, return error return-value
      148      :
      149         define buffer cli-obj for ub.clients .
      150         define variable p-var as integer no-undo .
      151         define buffer buf_obj-list for obj-list .
      152         find last buf_obj-list  use-index pi no-error .
      153         if available buf_obj-list
      154         then
      155            p-var = buf_obj-list.obj-id + 1.
      156         else
      157            p-var = 1.
      158         find first cli-obj where
      159                   cli-obj.obj-type = p-obj-type
      160               and cli-obj.obj-code = p-obj-code
      161         no-lock no-error.
      162         if available cli-obj
      163         then do:
      164            create buf_obj-list.
      165            assign
      166               buf_obj-list.obj-id   = p-var
      167               buf_obj-list.obj-code = cli-obj.obj-code
      168               buf_obj-list.obj-type = cli-obj.obj-type
      169               buf_obj-list.obj-name = cli-obj.obj-name
      170               buf_obj-list.db-num   = cli-obj.db-num
      171            .
      172         end.
      173      end.
      174   end.
