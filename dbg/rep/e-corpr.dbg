      564   define new global shared variable g#library  as handle no-undo .
      565   define new global shared variable g#library2 as handle no-undo .
      566   define variable var-report-r-b as character no-undo .
      567   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      568   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      569     (output var-report-r-b
      570     )  .
      571   procedure proc-alt-shift-f2:
      572     if not ibs.th.gbl.gbl-var:rcode
      573   then
      574     run gbl\inidebug.p .
      575   end.
      576   procedure proc-alt-shift-f3:
      577     run gbl/prvssinf.p
      578       ( input this-procedure
      579       ) .
      580   end.
      581   define variable v-inform-launched as logical no-undo initial false .
      582   procedure proc-alt-shift-f4:
      583     define variable v-action as character no-undo .
      584     if v-inform-launched = false then do:
      585       assign
      586         v-inform-launched = true
      587       .
      588       run gbl/d-inform.w
      589         (  input self
      590         ,  input this-procedure
      591         , output v-action
      592         ) no-error .
      593       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      594       assign
      595         v-inform-launched = false
      596       .
      597     end.
      598   end.
      599   procedure proc-alt-f1:
      600     run gbl/corrhelp.p
      601       (input this-procedure
      602       ) .
      603   end .
      604   on alt-shift-f2 anywhere do:
      605     run proc-alt-shift-f2.
      606   end.
      607   on alt-shift-f3 anywhere do:
      608     run proc-alt-shift-f3 in this-procedure .
      609   end.
      610   on alt-shift-f4 anywhere do:
      611     run proc-alt-shift-f4 in this-procedure.
      612   end.
      613   on alt-f1 anywhere do:
      614     run proc-alt-f1 in this-procedure .
      615   end.
      616     DEFINE VARIABLE parParentProc     AS WIDGET-HANDLE NO-UNDO.
      617     ASSIGN parParentProc =  my-handle .
      618   DEFINE BUTTON r-cli
      619        IMAGE-UP FILE "btn-down-arrow":U
      620        IMAGE-DOWN FILE "btn-down-arrow":U
      621        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      622        LABEL "r-cli"
      623        SIZE 3.5 BY 1.08.
      624   DEFINE VARIABLE COMBO-cli-type AS CHARACTER FORMAT "X(256)":U
      625        VIEW-AS COMBO-BOX INNER-LINES 5
      626        LIST-ITEMS "орг","чел","скл","маг"
      627        DROP-DOWN-LIST
      628        SIZE 7.63 BY 1 NO-UNDO.
      629   DEFINE VARIABLE FILL-cli-code AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
      630        LABEL "&Поставщик"
      631        VIEW-AS FILL-IN
      632        SIZE 12 BY 1 NO-UNDO.
      633   DEFINE VARIABLE FILL-cli-name AS CHARACTER FORMAT "X(256)":U
      634        VIEW-AS FILL-IN
      635        SIZE 35.13 BY 1 NO-UNDO.
      636   DEFINE VARIABLE FILL-num AS CHARACTER FORMAT "X(256)":U
      637        LABEL "Номер &документа"
      638        VIEW-AS FILL-IN
      639        SIZE 26.38 BY 1 NO-UNDO.
      640   DEFINE VARIABLE RADIO-SET-1 AS INTEGER
      641        VIEW-AS RADIO-SET VERTICAL
      642        RADIO-BUTTONS
      643             "Возврат поставщику ТОРГ-12", 1,
      644   "Приход ТОРГ-12", 2,
      645   "Приход Счет-фактура", 3
      646        SIZE 32.13 BY 3.5 NO-UNDO.
      647   DEFINE VARIABLE sort-name AS INTEGER
      648        VIEW-AS RADIO-SET VERTICAL
      649        RADIO-BUTTONS
      650             "по наименованию", 1,
      651   "по коду", 2,
      652   "по артикулу", 3
      653        SIZE 32.13 BY 3.5 NO-UNDO.
      654   DEFINE RECTANGLE RECT-5
      655        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      656        SIZE 36.88 BY 6.25.
      657   DEFINE RECTANGLE RECT-6
      658        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      659        SIZE 35.88 BY 6.21.
      660   DEFINE RECTANGLE RECT-7
      661        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      662        SIZE 74.75 BY 4.13.
      663   DEFINE RECTANGLE RECT-8
      664        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      665        SIZE 36.88 BY 3.17.
      666   DEFINE VARIABLE sort-gr AS LOGICAL INITIAL no
      667        LABEL "По группам"
      668        VIEW-AS TOGGLE-BOX
      669        SIZE 18 BY .83 NO-UNDO.
      670   DEFINE FRAME F-Main
      671        r-cli AT ROW 1.75 COL 4
      672        FILL-cli-code AT ROW 1.79 COL 17.13 COLON-ALIGNED
      673        COMBO-cli-type AT ROW 1.79 COL 29.88 COLON-ALIGNED NO-LABEL
      674        FILL-cli-name AT ROW 1.79 COL 38.63 COLON-ALIGNED NO-LABEL
      675        FILL-num AT ROW 3.5 COL 19.38 COLON-ALIGNED
      676        sort-name AT ROW 7.79 COL 41.63 NO-LABEL
      677        RADIO-SET-1 AT ROW 7.88 COL 4.88 NO-LABEL
      678        sort-gr AT ROW 14.17 COL 5.25
      679        "Сортировка :" VIEW-AS TEXT
      680             SIZE 19.13 BY 1.17 AT ROW 6.08 COL 41.75
      681             FGCOLOR 4
      682        "Печать документа:" VIEW-AS TEXT
      683             SIZE 33 BY 1.17 AT ROW 6.13 COL 4.25
      684             FGCOLOR 4
      685        "Классификация :" VIEW-AS TEXT
      686             SIZE 22.63 BY 1.17 AT ROW 12.67 COL 4.5
      687             FGCOLOR 4
      688        RECT-8 AT ROW 12.17 COL 1.88
      689        RECT-5 AT ROW 5.63 COL 2
      690        RECT-6 AT ROW 5.63 COL 40.13
      691        RECT-7 AT ROW 1 COL 1.88
      692       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      693            SIDE-LABELS NO-UNDERLINE THREE-D
      694            AT COL 1 ROW 1 SCROLLABLE .
      695   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      696   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      697   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      698   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      699   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      700   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      701   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      702   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      703         adm-object-hdl = FRAME F-Main:HANDLE.
      704   RUN ensure-broker.
      705   THIS-PROCEDURE:ADM-DATA =
      706        'ADM1.1~`':U +
      707        'SmartObject~`':U +
      708        '~`':U +
      709        'NO ~`':U +
      710        '~`':U +
      711        '~`':U +
      712        '~`':U +
      713        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      714           + "~`":U +
      715        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      716        'Record-Source,Record-Target,TableIO-Target~`':U +
      717        '~`':U +
      718        '~`~`~`~`~`~`~`~`~`~`~`':U +
      719        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      720            THEN "^^":U
      721        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      722             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      723   PROCEDURE adm-apply-entry :
      724     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      725   END PROCEDURE.
      726   PROCEDURE adm-destroy :
      727    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      728   END PROCEDURE.
      729   PROCEDURE adm-disable :
      730       DISABLE RECT-8 RECT-5 RECT-6 RECT-7 r-cli FILL-cli-code COMBO-cli-type FILL-num sort-name RADIO-SET-1 sort-gr WITH FRAME F-Main.
      731       RUN dispatch ('disable-fields':U).
      732       RUN set-attribute-list ('ENABLED=no':U).
      733       RETURN.
      734   END PROCEDURE.
      735   PROCEDURE adm-edit-attribute-list :
      736         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      737         RETURN.
      738   END PROCEDURE.
      739   PROCEDURE adm-enable :
      740       ENABLE UNLESS-HIDDEN RECT-8 RECT-5 RECT-6 RECT-7 r-cli FILL-cli-code COMBO-cli-type FILL-num sort-name RADIO-SET-1 sort-gr WITH FRAME F-Main.
      741       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      742       RUN set-attribute-list ('ENABLED=yes':U).
      743       RETURN.
      744   END PROCEDURE.
      745   PROCEDURE adm-exit :
      746        RUN notify ('exit':U).
      747     RETURN.
      748   END PROCEDURE.
      749   PROCEDURE adm-hide :
      750     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      751   END PROCEDURE.
      752   PROCEDURE adm-initialize :
      753     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      754   END PROCEDURE.
      755   PROCEDURE adm-show-errors :
      756       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      757       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      758           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      759       END.
      760       RETURN.
      761   END PROCEDURE.
      762   PROCEDURE adm-UIB-mode :
      763     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      764   END PROCEDURE.
      765   PROCEDURE adm-view :
      766     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      767   END PROCEDURE.
      768   PROCEDURE dispatch :
      769       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      770       RUN broker-dispatch IN adm-broker-hdl
      771           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      772       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      773   END PROCEDURE.
      774   PROCEDURE ensure-broker :
      775   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      776   IF RETURN-VALUE NE "ADM-Broker":U THEN
      777   DO:
      778       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      779       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      780   END.
      781   END PROCEDURE.
      782   PROCEDURE get-attribute :
      783     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      784     RUN broker-get-attribute IN adm-broker-hdl
      785         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      786     RETURN RETURN-VALUE.
      787   END PROCEDURE.
      788   PROCEDURE get-attribute-list :
      789     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      790     RUN broker-get-attribute-list IN adm-broker-hdl
      791         (INPUT THIS-PROCEDURE,
      792          INPUT ?,
      793          OUTPUT p-attr-list) NO-ERROR.
      794     RETURN.
      795   END PROCEDURE.
      796   PROCEDURE new-state :
      797     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      798     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      799     RETURN.
      800   END PROCEDURE.
      801   PROCEDURE notify :
      802     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      803     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      804     IF RETURN-VALUE = "ADM-ERROR":U THEN
      805         RETURN "ADM-ERROR":U.
      806     RETURN.
      807   END PROCEDURE.
      808   PROCEDURE set-attribute-list :
      809     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      810     RUN ensure-broker.
      811     RUN broker-set-attribute-list IN adm-broker-hdl
      812         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      813     RETURN.
      814   END PROCEDURE.
      815   PROCEDURE set-position :
      816       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      817       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      818       IF VALID-HANDLE(adm-object-hdl) THEN
      819       DO:
      820         ASSIGN adm-object-hdl:ROW    =   p-row
      821                adm-object-hdl:COLUMN =   p-col.
      822       END.
      823       RETURN.
      824   END PROCEDURE.
      825   PROCEDURE adm-display-fields :
      826       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      827       RETURN.
      828   END PROCEDURE.
      829   PROCEDURE adm-open-query :
      830     RETURN.
      831   END PROCEDURE.
      832   PROCEDURE adm-row-changed :
      833         IF VALID-HANDLE(adm-object-hdl) THEN
      834           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      835         RUN notify ('row-available':U).
      836         RETURN.
      837   END PROCEDURE.
      838   PROCEDURE reposition-query :
      839       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      840       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      841       RETURN.
      842   END PROCEDURE.
      843     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      844     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      845     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      846     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      847     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      848     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      849     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      850     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      851     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      852     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      853     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      854     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      855     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      856     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      857     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      858     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      859     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      860     IF "":U = "":U THEN
      861       RUN modify-list-attribute IN adm-broker-hdl
      862         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      863     RUN use-create-on-add(?).
      864   PROCEDURE adm-add-record :
      865       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      866          "must have at least one Enabled Table to perform Add.":U
      867          VIEW-AS ALERT-BOX ERROR.
      868       RETURN.
      869   END PROCEDURE.
      870   PROCEDURE adm-assign-record :
