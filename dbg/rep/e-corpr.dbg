      876     END PROCEDURE.
      877   PROCEDURE adm-assign-statement :
      878     RETURN.
      879   END PROCEDURE.
      880   PROCEDURE adm-cancel-record :
      881      RETURN.
      882     END PROCEDURE.
      883   PROCEDURE adm-copy-record :
      884       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      885        "must have at least one Enabled Table to perform Copy.":U
      886          VIEW-AS ALERT-BOX ERROR.
      887       RETURN.
      888   END PROCEDURE.
      889   PROCEDURE adm-create-record :
      890      RETURN.
      891   END PROCEDURE.
      892   PROCEDURE adm-current-changed :
      893     RETURN.
      894   END PROCEDURE.
      895   PROCEDURE adm-delete-record :
      896    MESSAGE
      897          "Object ":U THIS-PROCEDURE:FILE-NAME
      898            "must have at least one Enabled Table to perform Delete.":U
      899              VIEW-AS ALERT-BOX ERROR.
      900       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      901       RETURN.
      902   END PROCEDURE.
      903   PROCEDURE adm-disable-fields :
      904         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
      905       RETURN.
      906   END PROCEDURE.
      907   PROCEDURE adm-enable-fields :
      908       RETURN.
      909   END PROCEDURE.
      910   PROCEDURE adm-end-update :
      911     RETURN.
      912   END PROCEDURE.
      913   PROCEDURE adm-reset-record :
      914       RETURN.
      915   END PROCEDURE.
      916   PROCEDURE adm-update-record :
      917       MESSAGE
      918         "Object ":U THIS-PROCEDURE:FILE-NAME
      919           "must have at least one Enabled Table to perform Update.":U
      920             VIEW-AS ALERT-BOX ERROR.
      921      RETURN.
      922   END PROCEDURE.
      923   PROCEDURE check-modified :
      924   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      925   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      926   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      927   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      928     IF check-state = "check":U THEN
      929     DO:
      930       RUN get-link-handle IN adm-broker-hdl
      931         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      932            OUTPUT group-target-list).
      933       IF group-target-list NE "":U THEN
      934       DO i = 1 TO NUM-ENTRIES(group-target-list):
      935         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      936         RUN check-modified IN curr-widget ('group-check':U).
      937         IF RETURN-VALUE NE "":U THEN
      938         DO:
      939           RUN check-modified-message(RETURN-VALUE).
      940           RETURN "":U.
      941         END.
      942       END.
      943     END.
      944     RETURN "":U.
      945   END PROCEDURE.
      946   PROCEDURE check-modified-message :
      947     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      948        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      949           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      950        IF RETURN-VALUE = "YES":U THEN
      951           RUN notify ('view,CONTAINER-SOURCE':U).
      952        MESSAGE IF p-changed-table NE ? THEN
      953           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      954           ELSE "Current values have been changed."
      955           SKIP "  Do you wish to save those changes?"
      956           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      957        IF ANS THEN
      958        DO:
      959           IF group-assign-target THEN
      960             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      961           ELSE RUN dispatch('update-record':U).
      962           IF RETURN-VALUE = "ADM-ERROR":U THEN
      963           DO:
      964               MESSAGE "Changes to the previous record were not saved."
      965                 VIEW-AS ALERT-BOX ERROR.
      966               IF group-assign-target THEN
      967                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      968               ELSE RUN dispatch ('cancel-record':U).
      969           END.
      970        END.
      971        ELSE DO:
      972          IF group-assign-target THEN
      973             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      974          ELSE RUN dispatch('cancel-record':U).
      975        END.
      976        RETURN.
      977   END PROCEDURE.
      978   PROCEDURE get-rowid :
      979       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
      980       ASSIGN
      981       p-table   =   adm-first-table.
      982       RETURN.
      983   END PROCEDURE.
      984   PROCEDURE init-group-assign :
      985       RUN request-attribute IN adm-broker-hdl
      986         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
      987       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
      988         group-assign-target = yes.
      989       ELSE group-assign-target = no.
      990       RETURN.
      991   END PROCEDURE.
      992   PROCEDURE set-editors :
      993       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
      994       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
      995       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
      996       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
      997       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
      998       DO WHILE VALID-HANDLE (curr-widget):
      999           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1000              curr-widget:HIDDEN = no THEN DO:
     1001             CASE p-field-setting:
     1002               WHEN "INITIALIZE":U THEN
     1003               DO:
     1004                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1005                     read-only-list +
     1006                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1007                        STRING(curr-widget).
     1008               END.
     1009               WHEN "DISABLE":U OR
     1010               WHEN "ENABLE":U THEN
     1011               DO:
     1012                   curr-widget:SENSITIVE = yes.
     1013                   RUN get-attribute ('Read-Only-Editors':U).
     1014                   IF RETURN-VALUE = ? OR
     1015                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1016                       curr-widget:READ-ONLY =
     1017                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1018               END.
     1019               WHEN "CLEAR":U THEN
     1020                   curr-widget:SCREEN-VALUE = "":U.
     1021             END CASE.
     1022           END.
     1023           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1024       END.
     1025       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1026         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1027           + '"':U).
     1028       RETURN.
     1029   END PROCEDURE.
     1030   PROCEDURE use-check-modified-all :
     1031    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1032     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1033     RETURN.
     1034   END PROCEDURE.
     1035   PROCEDURE use-create-on-add :
     1036   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1037      RETURN.
     1038   END PROCEDURE.
     1039   PROCEDURE use-initial-lock :
     1040     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1041     ASSIGN adm-initial-lock = p-attr-value.
     1042     RETURN.
     1043   END PROCEDURE.
     1044     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1045   ASSIGN
     1046          FRAME F-Main:SCROLLABLE       = FALSE
     1047          FRAME F-Main:HIDDEN           = TRUE.
     1048   ON LEAVE OF COMBO-cli-type IN FRAME F-Main
     1049   DO:
     1050     ASSIGN COMBO-cli-type.
     1051     FIND supplier NO-LOCK WHERE supplier.obj-type = COMBO-cli-type AND supplier.obj-code = FILL-cli-code NO-ERROR.
     1052     ASSIGN FILL-cli-name = ( IF AVAIL supplier THEN supplier.obj-name ELSE "":U ).
     1053     DISP   FILL-cli-name WITH FRAME F-Main.
     1054   END.
     1055   ON VALUE-CHANGED OF COMBO-cli-type IN FRAME F-Main
     1056   DO:
     1057     ASSIGN COMBO-cli-type.
     1058     FIND supplier NO-LOCK WHERE supplier.obj-type = COMBO-cli-type AND supplier.obj-code = FILL-cli-code NO-ERROR.
     1059     ASSIGN FILL-cli-name = ( IF AVAIL supplier THEN supplier.obj-name ELSE "":U ).
     1060     DISP   FILL-cli-name WITH FRAME F-Main.
     1061   END.
     1062   ON LEAVE OF FILL-cli-code IN FRAME F-Main
     1063   DO:
     1064     ASSIGN FILL-cli-code.
     1065     FIND supplier NO-LOCK WHERE supplier.obj-type = COMBO-cli-type AND supplier.obj-code = FILL-cli-code NO-ERROR.
     1066     ASSIGN FILL-cli-name = ( IF AVAIL supplier THEN supplier.obj-name ELSE "":U ).
     1067     DISP   FILL-cli-name WITH FRAME F-Main.
     1068   END.
     1069   ON CHOOSE OF r-cli IN FRAME F-Main
     1070   DO:
     1071     DEF VAR v_rid-list AS CHAR NO-UNDO.
     1072     run ref/cli-all.w (parParentProc
     1073                    , INPUT "b-sel"
     1074                    , 'про':U
     1075                    , 'все':U
     1076                    , 'текущие':U
     1077                    , ( IF AVAIL supplier THEN RECID( supplier ) ELSE ? )
     1078                    , ",,,,,,NO,,"
     1079                    ,?
     1080     , OUTPUT v_rid-list ).
     1081     FIND supplier NO-LOCK WHERE RECID( supplier ) = INT( v_rid-list ) NO-ERROR.
     1082     IF AVAIL supplier THEN DO:
     1083       ASSIGN FILL-cli-code  = supplier.obj-code
     1084              COMBO-cli-type = supplier.obj-type
     1085              FILL-cli-name  = supplier.obj-name.
     1086     END.              ELSE DO:
     1087       ASSIGN FILL-cli-name  = "":U
     1088              FILL-cli-code  = 0
     1089              COMBO-cli-type = 'орг':U.
     1090     END.
     1091     DISP COMBO-cli-type FILL-cli-code FILL-cli-name WITH FRAME F-Main.
     1092   END.
     1093   if not this-procedure :persistent
     1094   then do:
     1095     message
     1096       vss-workfile vss-revision vss-description skip
     1097       "Ошибка при запуске процедуры" skip
     1098       "Данную процедуру следует запускать только с параметром persistent" skip
     1099       view-as alert-box error .
     1100     undo, return error .
     1101   end.
     1102   ASSIGN COMBO-cli-type = 'орг':U.
     1103   DISP   COMBO-cli-type WITH FRAME F-Main.
     1104   PROCEDURE disable_UI :
     1105     HIDE FRAME F-Main.
     1106     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1107   END PROCEDURE.
     1108   PROCEDURE local-apply-layout :
     1109     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     1110   END PROCEDURE.
     1111   PROCEDURE my-report :
     1112   find first supplier no-lock where supplier.obj-code = FILL-cli-code and supplier.obj-type = COMBO-cli-type no-error.
     1113     if avail supplier then do:
     1114       case RADIO-SET-1 :
     1115         when 1 then run rep/r-corpr1.p ( my-handle, COMBO-cli-type, FILL-cli-code, FILL-num, sort-name, sort-gr, yes ) .
     1116         when 2 then run rep/r-corpr1.p ( my-handle, COMBO-cli-type, FILL-cli-code, FILL-num, sort-name, sort-gr, no ) .
     1117         when 3 then run rep/r-corpr2.p ( COMBO-cli-type, FILL-cli-code, FILL-num, sort-name, sort-gr, ? ) .
     1118       end.
     1119     end.
     1120     else  message  "Поставщик не выбран!" view-as alert-box.
     1121   END PROCEDURE.
     1122   PROCEDURE my-var :
     1123     Assign frame F-Main COMBO-cli-type FILL-cli-code FILL-num RADIO-SET-1 sort-name sort-gr .
     1124   END PROCEDURE.
     1125   PROCEDURE state-changed :
     1126     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1127     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1128     CASE p-state:
     1129       when "link-changed":U then  DO:
     1130            Run my-var.
     1131            End.
     1132     END CASE.
     1133   END PROCEDURE.
