      903   CREATE WIDGET-POOL.
      904   define variable State-source    as  WIDGET-HANDLE   no-undo.
      905   define variable v-today         as date             no-undo.
      906   define variable v-time          as integer          no-undo.
      907   DEFINE VARIABLE E-coll AS CHARACTER
      908        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      909        SIZE 73 BY 5.5 NO-UNDO.
      910   DEFINE VARIABLE Classify AS INTEGER INITIAL 5
      911        VIEW-AS RADIO-SET VERTICAL
      912        RADIO-BUTTONS
      913             "Коллекция", 5,
      914   "Коллекция/группы товаров", 6,
      915   "Группы товаров/Коллекция", 7
      916        SIZE 75 BY 3.13 NO-UNDO.
      917   DEFINE VARIABLE R-coll AS INTEGER INITIAL 1
      918        VIEW-AS RADIO-SET VERTICAL
      919        RADIO-BUTTONS
      920             "Все коллекции", 1,
      921   "Выборочно", 2
      922        SIZE 73 BY 2.25 NO-UNDO.
      923   DEFINE RECTANGLE RECT-12
      924        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      925        SIZE 77.75 BY 16.83.
      926   DEFINE VARIABLE Itog AS LOGICAL INITIAL no
      927        LABEL "Только итоги"
      928        VIEW-AS TOGGLE-BOX
      929        SIZE 28.88 BY .83 NO-UNDO.
      930   DEFINE VARIABLE Zero AS LOGICAL INITIAL no
      931        LABEL "Нулевые количества по признакам"
      932        VIEW-AS TOGGLE-BOX
      933        SIZE 34.5 BY .83 NO-UNDO.
      934   DEFINE FRAME F-Main
      935        Classify AT ROW 2.38 COL 3 NO-LABEL
      936        Itog AT ROW 7.75 COL 3
      937        Zero AT ROW 8.75 COL 3
      938        R-coll AT ROW 10 COL 3 NO-LABEL
      939        E-coll AT ROW 12.25 COL 3 NO-LABEL
      940        "Классификация:":C28 VIEW-AS TEXT
      941             SIZE 28.75 BY .75 AT ROW 1.42 COL 3
      942             FGCOLOR 4
      943        "Показать:":C28 VIEW-AS TEXT
      944             SIZE 28.75 BY .75 AT ROW 6.79 COL 3
      945             FGCOLOR 4
      946        RECT-12 AT ROW 1.13 COL 1
      947       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      948            SIDE-LABELS NO-UNDERLINE THREE-D
      949            AT COL 1 ROW 1 SCROLLABLE .
      950   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      951   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      952   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      953   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      954   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      955   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      956   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      957   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      958         adm-object-hdl = FRAME F-Main:HANDLE.
      959   RUN ensure-broker.
      960   THIS-PROCEDURE:ADM-DATA =
      961        'ADM1.1~`':U +
      962        'SmartObject~`':U +
      963        '~`':U +
      964        'NO ~`':U +
      965        '~`':U +
      966        '~`':U +
      967        '~`':U +
      968        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      969           + "~`":U +
      970        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      971        'Record-Source,Record-Target,TableIO-Target~`':U +
      972        '~`':U +
      973        '~`~`~`~`~`~`~`~`~`~`~`':U +
      974        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      975            THEN "^^":U
      976        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      977             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      978   PROCEDURE adm-apply-entry :
      979     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      980   END PROCEDURE.
      981   PROCEDURE adm-destroy :
      982    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      983   END PROCEDURE.
      984   PROCEDURE adm-disable :
      985       DISABLE RECT-12 Classify Itog Zero R-coll E-coll WITH FRAME F-Main.
      986       RUN dispatch ('disable-fields':U).
      987       RUN set-attribute-list ('ENABLED=no':U).
      988       RETURN.
      989   END PROCEDURE.
      990   PROCEDURE adm-edit-attribute-list :
      991         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      992         RETURN.
      993   END PROCEDURE.
      994   PROCEDURE adm-enable :
      995       ENABLE UNLESS-HIDDEN RECT-12 Classify Itog Zero R-coll E-coll WITH FRAME F-Main.
      996       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      997       RUN set-attribute-list ('ENABLED=yes':U).
      998       RETURN.
      999   END PROCEDURE.
     1000   PROCEDURE adm-exit :
     1001        RUN notify ('exit':U).
     1002     RETURN.
     1003   END PROCEDURE.
     1004   PROCEDURE adm-hide :
     1005     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1006   END PROCEDURE.
     1007   PROCEDURE adm-initialize :
     1008     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1009   END PROCEDURE.
     1010   PROCEDURE adm-show-errors :
     1011       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1012       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1013           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1014       END.
     1015       RETURN.
     1016   END PROCEDURE.
     1017   PROCEDURE adm-UIB-mode :
     1018     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1019   END PROCEDURE.
     1020   PROCEDURE adm-view :
     1021     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1022   END PROCEDURE.
     1023   PROCEDURE dispatch :
     1024       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1025       RUN broker-dispatch IN adm-broker-hdl
     1026           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1027       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1028   END PROCEDURE.
     1029   PROCEDURE ensure-broker :
     1030   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1031   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1032   DO:
     1033       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1034       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1035   END.
     1036   END PROCEDURE.
     1037   PROCEDURE get-attribute :
     1038     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1039     RUN broker-get-attribute IN adm-broker-hdl
     1040         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1041     RETURN RETURN-VALUE.
     1042   END PROCEDURE.
     1043   PROCEDURE get-attribute-list :
     1044     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1045     RUN broker-get-attribute-list IN adm-broker-hdl
     1046         (INPUT THIS-PROCEDURE,
     1047          INPUT ?,
     1048          OUTPUT p-attr-list) NO-ERROR.
     1049     RETURN.
     1050   END PROCEDURE.
     1051   PROCEDURE new-state :
     1052     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1053     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1054     RETURN.
     1055   END PROCEDURE.
     1056   PROCEDURE notify :
     1057     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1058     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1059     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1060         RETURN "ADM-ERROR":U.
     1061     RETURN.
     1062   END PROCEDURE.
     1063   PROCEDURE set-attribute-list :
     1064     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1065     RUN ensure-broker.
     1066     RUN broker-set-attribute-list IN adm-broker-hdl
     1067         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1068     RETURN.
     1069   END PROCEDURE.
     1070   PROCEDURE set-position :
     1071       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1072       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1073       IF VALID-HANDLE(adm-object-hdl) THEN
     1074       DO:
     1075         ASSIGN adm-object-hdl:ROW    =   p-row
     1076                adm-object-hdl:COLUMN =   p-col.
     1077       END.
     1078       RETURN.
     1079   END PROCEDURE.
     1080   PROCEDURE adm-display-fields :
     1081       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1082       RETURN.
     1083   END PROCEDURE.
     1084   PROCEDURE adm-open-query :
     1085     RETURN.
     1086   END PROCEDURE.
     1087   PROCEDURE adm-row-changed :
     1088         IF VALID-HANDLE(adm-object-hdl) THEN
     1089           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1090         RUN notify ('row-available':U).
     1091         RETURN.
     1092   END PROCEDURE.
     1093   PROCEDURE reposition-query :
     1094       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1095       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1096       RETURN.
     1097   END PROCEDURE.
     1098     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1099     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1100     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1101     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1102     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1103     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1104     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1105     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1106     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1107     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1108     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1109     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1110     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1111     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1112     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1113     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1114     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1115     IF "":U = "":U THEN
     1116       RUN modify-list-attribute IN adm-broker-hdl
     1117         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1118     RUN use-create-on-add(?).
     1119   PROCEDURE adm-add-record :
     1120       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1121          "must have at least one Enabled Table to perform Add.":U
     1122          VIEW-AS ALERT-BOX ERROR.
     1123       RETURN.
     1124   END PROCEDURE.
     1125   PROCEDURE adm-assign-record :
     1126    MESSAGE
     1127          "Object ":U THIS-PROCEDURE:FILE-NAME
     1128            "must have at least one Enabled Table to perform Assign.":U
     1129              VIEW-AS ALERT-BOX ERROR.
     1130      RETURN.
     1131     END PROCEDURE.
     1132   PROCEDURE adm-assign-statement :
     1133     RETURN.
     1134   END PROCEDURE.
     1135   PROCEDURE adm-cancel-record :
     1136      RETURN.
     1137     END PROCEDURE.
     1138   PROCEDURE adm-copy-record :
     1139       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1140        "must have at least one Enabled Table to perform Copy.":U
     1141          VIEW-AS ALERT-BOX ERROR.
     1142       RETURN.
     1143   END PROCEDURE.
     1144   PROCEDURE adm-create-record :
     1145      RETURN.
     1146   END PROCEDURE.
     1147   PROCEDURE adm-current-changed :
     1148     RETURN.
     1149   END PROCEDURE.
     1150   PROCEDURE adm-delete-record :
     1151    MESSAGE
     1152          "Object ":U THIS-PROCEDURE:FILE-NAME
     1153            "must have at least one Enabled Table to perform Delete.":U
     1154              VIEW-AS ALERT-BOX ERROR.
     1155       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1156       RETURN.
     1157   END PROCEDURE.
     1158   PROCEDURE adm-disable-fields :
     1159         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1160       RETURN.
     1161   END PROCEDURE.
     1162   PROCEDURE adm-enable-fields :
     1163       RETURN.
     1164   END PROCEDURE.
     1165   PROCEDURE adm-end-update :
     1166     RETURN.
     1167   END PROCEDURE.
     1168   PROCEDURE adm-reset-record :
     1169       RETURN.
     1170   END PROCEDURE.
     1171   PROCEDURE adm-update-record :
     1172       MESSAGE
     1173         "Object ":U THIS-PROCEDURE:FILE-NAME
     1174           "must have at least one Enabled Table to perform Update.":U
     1175             VIEW-AS ALERT-BOX ERROR.
     1176      RETURN.
     1177   END PROCEDURE.
     1178   PROCEDURE check-modified :
     1179   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1180   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1181   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1182   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1183     IF check-state = "check":U THEN
     1184     DO:
     1185       RUN get-link-handle IN adm-broker-hdl
     1186         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1187            OUTPUT group-target-list).
     1188       IF group-target-list NE "":U THEN
     1189       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1190         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1191         RUN check-modified IN curr-widget ('group-check':U).
     1192         IF RETURN-VALUE NE "":U THEN
     1193         DO:
     1194           RUN check-modified-message(RETURN-VALUE).
     1195           RETURN "":U.
     1196         END.
     1197       END.
     1198     END.
     1199     RETURN "":U.
     1200   END PROCEDURE.
     1201   PROCEDURE check-modified-message :
     1202     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1203        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1204           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1205        IF RETURN-VALUE = "YES":U THEN
     1206           RUN notify ('view,CONTAINER-SOURCE':U).
     1207        MESSAGE IF p-changed-table NE ? THEN
     1208           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1209           ELSE "Current values have been changed."
     1210           SKIP "  Do you wish to save those changes?"
     1211           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1212        IF ANS THEN
     1213        DO:
     1214           IF group-assign-target THEN
     1215             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1216           ELSE RUN dispatch('update-record':U).
     1217           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1218           DO:
     1219               MESSAGE "Changes to the previous record were not saved."
     1220                 VIEW-AS ALERT-BOX ERROR.
     1221               IF group-assign-target THEN
     1222                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1223               ELSE RUN dispatch ('cancel-record':U).
     1224           END.
     1225        END.
     1226        ELSE DO:
     1227          IF group-assign-target THEN
     1228             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1229          ELSE RUN dispatch('cancel-record':U).
     1230        END.
     1231        RETURN.
     1232   END PROCEDURE.
     1233   PROCEDURE get-rowid :
     1234       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1235       ASSIGN
     1236       p-table   =   adm-first-table.
     1237       RETURN.
     1238   END PROCEDURE.
     1239   PROCEDURE init-group-assign :
     1240       RUN request-attribute IN adm-broker-hdl
     1241         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1242       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1243         group-assign-target = yes.
     1244       ELSE group-assign-target = no.
     1245       RETURN.
     1246   END PROCEDURE.
     1247   PROCEDURE set-editors :
     1248       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1249       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1250       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1251       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1252       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1253       DO WHILE VALID-HANDLE (curr-widget):
     1254           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1255              curr-widget:HIDDEN = no THEN DO:
     1256             CASE p-field-setting:
     1257               WHEN "INITIALIZE":U THEN
     1258               DO:
     1259                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1260                     read-only-list +
     1261                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1262                        STRING(curr-widget).
     1263               END.
     1264               WHEN "DISABLE":U OR
     1265               WHEN "ENABLE":U THEN
     1266               DO:
     1267                   curr-widget:SENSITIVE = yes.
     1268                   RUN get-attribute ('Read-Only-Editors':U).
     1269                   IF RETURN-VALUE = ? OR
     1270                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1271                       curr-widget:READ-ONLY =
     1272                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1273               END.
     1274               WHEN "CLEAR":U THEN
     1275                   curr-widget:SCREEN-VALUE = "":U.
     1276             END CASE.
     1277           END.
     1278           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1279       END.
     1280       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1281         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1282           + '"':U).
     1283       RETURN.
     1284   END PROCEDURE.
     1285   PROCEDURE use-check-modified-all :
     1286    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1287     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1288     RETURN.
     1289   END PROCEDURE.
     1290   PROCEDURE use-create-on-add :
     1291   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1292      RETURN.
     1293   END PROCEDURE.
     1294   PROCEDURE use-initial-lock :
     1295     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1296     ASSIGN adm-initial-lock = p-attr-value.
     1297     RETURN.
     1298   END PROCEDURE.
     1299     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1300   ASSIGN
     1301          FRAME F-Main:SCROLLABLE       = FALSE
     1302          FRAME F-Main:HIDDEN           = TRUE.
     1303   ON VALUE-CHANGED OF R-coll IN FRAME F-Main
     1304   DO:
     1305     define variable v-recid as character no-undo .
     1306     ASSIGN r-coll.
     1307     for each tt-season : delete tt-season . end. e-coll = "" .
     1308     IF r-coll = 1  THEN DO:
     1309       e-coll = "Все: " + chr(10)  .
     1310       for each ub.season no-lock where
     1311                ub.season.sea-month-1 = 0 and
     1312                ub.season.sea-month-2 = 0 :
     1313          create tt-season.
     1314          BUFFER-COPY ub.season  to tt-season .
     1315          e-coll = e-coll + ub.season.sea-name + chr(10)  .
     1316       end.
     1317     END.
     1318     ELSE DO:
     1319       run ref/collec.w (my-handle, input "b-mark,b-sel,only-coll" , output v-recid) .
     1320       if v-recid = "" or v-recid = ? then do:
     1321          r-coll = 1.
     1322          display r-coll  with frame F-Main .
     1323           e-coll = "Все: " + chr(10)  .
     1324           for each ub.season no-lock where
     1325                   ub.season.sea-month-1 = 0 and
     1326                   ub.season.sea-month-2 = 0 :
     1327             create tt-season.
     1328             BUFFER-COPY ub.season  to tt-season .
     1329             e-coll = e-coll + ub.season.sea-name + chr(10)  .
     1330           end.
     1331       end.
     1332       else do:
     1333         for each ub.season no-lock where  lookup(string(recid(ub.season)),v-recid) > 0 :
     1334           create tt-season.
     1335           BUFFER-COPY ub.season  to tt-season .
     1336           e-coll = e-coll + ub.season.sea-name + chr(10)  .
     1337         end.
     1338       end.
     1339     END.
     1340     DISPLAY e-coll WITH FRAME F-Main .
     1341   END.
     1342   if not this-procedure :persistent
     1343   then do:
     1344     message
     1345       vss-workfile vss-revision vss-description skip
     1346       "Ошибка при запуске процедуры" skip
     1347       "Данную процедуру следует запускать только с параметром persistent" skip
     1348       view-as alert-box error .
     1349     undo, return error .
     1350   end.
     1351   PROCEDURE disable_UI :
     1352     HIDE FRAME F-Main.
     1353     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1354   END PROCEDURE.
     1355   PROCEDURE enable_UI :
     1356     DISPLAY Classify Itog Zero R-coll E-coll
     1357         WITH FRAME F-Main.
     1358     ENABLE RECT-12 Classify Itog Zero R-coll E-coll
     1359         WITH FRAME F-Main.
     1360   END PROCEDURE.
     1361   PROCEDURE local-apply-layout :
     1362     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     1363     define variable v-par-val as character no-undo .
     1364     assign
     1365     ReportName = "Состояние запаса по коллекциям"
     1366     v-par-val = "Коллекции"
     1367    Classify:RADIO-BUTTONS in frame F-Main  = substitute("&1,5,&2,6,&3,7", v-par-val , v-par-val + '/Группы товаров' , 'Группы товаров/' + v-par-val ) .
     1368    R-coll:RADIO-BUTTONS   in frame F-Main  = substitute("&1,1,&2,2", "Все " + v-par-val ,  'Выборочно'  ) .
     1369     e-coll:READ-ONLY IN FRAME F-Main = true .
     1370     R-coll = 1.
     1371   apply "VALUE-CHANGED" to R-coll IN FRAME F-Main .
     1372   END PROCEDURE.
     1373   PROCEDURE my-report :
     1374   define buffer tt-goods for ub.goods .
     1375   define variable v-col-rec  as integer init 0 no-undo .
     1376   if x-selectgood = 2 then do:
     1377   v-col-rec = 0.
     1378   for each gds-list : delete gds-list . end.
     1379       for each tmp#grp :
     1380         for each tt-goods no-lock where tt-goods.grp-name begins tmp#grp.grp-name :
     1381           create gds-list.
     1382           buffer-copy tt-goods to gds-list.
     1383           v-col-rec = 1 + v-col-rec  .
     1384         end.
     1385       end.
     1386     if v-col-rec = 0 then do:
     1387     message "Не выбрана группа товаров !!" view-as alert-box information .
     1388     return  .
     1389     end.
     1390   end.
     1391   if x-selectgood = 3 then do:
     1392   v-col-rec = 0.
     1393   for each gds-list : delete gds-list . end.
     1394       for each g#cli :
     1395         for each tt-goods no-lock where tt-goods.prod-code = g#cli.obj-code and
     1396                                         tt-goods.prod-type = g#cli.obj-type
     1397          :
     1398           v-col-rec = 1 + v-col-rec  .
     1399           create gds-list.
     1400           buffer-copy tt-goods to gds-list.
     1401         end.
     1402       end.
     1403     if v-col-rec = 0 then do:
     1404     message "Не выбраны производители !!" view-as alert-box information .
     1405     return  .
     1406     end.
     1407   end.
     1408   run cur-time in this-procedure ( output v-today
     1409                                  , output v-time
     1410                                  ).
     1411   If x-date-alone <> v-today Then do:
     1412         if x-SelectGood = 1 Then DO:
     1413             If x-SET_val_TYPE = 1
     1414               then DO :
     1415                   run rep/r-prtsz5.p
     1416                       (input v-cntxt-obj-code ,  input v-cntxt-obj-type ,  input base-type ,  input base-code ,  input Classify,  input zero,  input no ,  input Itog ,   input true ,   input table tt-season ) .
     1417                   End.
     1418               Else do:
     1419                   run rep/r-prtsz6.p
     1420                       (input v-cntxt-obj-code ,  input v-cntxt-obj-type ,  input base-type ,  input base-code ,  input Classify,  input zero,  input no ,  input Itog ,   input true ,   input table tt-season ) .
     1421                   End.
     1422         End.
     1423         Else DO:
     1424             If x-SET_val_TYPE = 1
     1425               then do:
     1426                   run rep/r-prtsz7.p
     1427                       (input v-cntxt-obj-code ,  input v-cntxt-obj-type ,  input base-type ,  input base-code ,  input Classify,  input zero,  input no ,  input Itog ,   input true ,   input table tt-season ) .
     1428                   End.
     1429               Else do:
     1430                   run rep/r-prtsz8.p
     1431                       (input v-cntxt-obj-code ,  input v-cntxt-obj-type ,  input base-type ,  input base-code ,  input Classify,  input zero,  input no ,  input Itog ,   input true ,   input table tt-season ) .
     1432                   End.
     1433         End.
     1434   End.
     1435   Else do:
     1436         if x-SelectGood = 1 Then DO:
     1437             If x-SET_val_TYPE = 1
     1438               then DO :
     1439                   run rep/r-prtsz1.p
     1440                       (input v-cntxt-obj-code ,  input v-cntxt-obj-type ,  input base-type ,  input base-code ,  input Classify,  input zero,  input no ,  input Itog ,   input true ,   input table tt-season ) .
     1441                   End.
     1442               Else do:
     1443                   run rep/r-prtsz2.p
     1444                       (input v-cntxt-obj-code ,  input v-cntxt-obj-type ,  input base-type ,  input base-code ,  input Classify,  input zero,  input no ,  input Itog ,   input true ,   input table tt-season ) .
     1445                   End.
     1446         End.
     1447         Else DO:
     1448             If x-SET_val_TYPE = 1
     1449               then do:
     1450                   run rep/r-prtsz3.p
     1451                       (input v-cntxt-obj-code ,  input v-cntxt-obj-type ,  input base-type ,  input base-code ,  input Classify,  input zero,  input no ,  input Itog ,   input true ,   input table tt-season ) .
     1452                   End.
     1453               Else do:
     1454                   run rep/r-prtsz4.p
     1455                       (input v-cntxt-obj-code ,  input v-cntxt-obj-type ,  input base-type ,  input base-code ,  input Classify,  input zero,  input no ,  input Itog ,   input true ,   input table tt-season ) .
     1456                   End.
     1457         End.
     1458   End.
     1459   END PROCEDURE.
     1460   PROCEDURE my-var :
     1461   assign frame F-Main
     1462         Classify
     1463         itog
     1464         zero
     1465         .
     1466   Sheetf.Excel-Column-Lable =
     1467   "N п\п,
     1468   Код,
     1469   Артикул,
     1470   Название товара ,
     1471   Признак товара,
     1472   Количество,
     1473   Учетные цена с НДС,
     1474   Сумма в уч.ценах,
     1475   Продажная цена,
     1476   Суммы в продажных ценах,
     1477   % наценки,
     1478   Свободное количество,
     1479   Ожидаемое количество," .
     1480   Sheetf.ColFOrmat = "2=@;3=@;4=@;5=@"  .
     1481   Sheetf.make-correct =  "true  ,true ,true ,true ,true ,true ,true ,true ,true, true ,true, true ,true ," .
     1482   Sheetf.Sizes = "6,16,9,60,20," + Fill("15,", 8)  .
     1483    run cur-time in this-procedure ( output v-today
     1484                                   , output v-time
     1485                                   ).
     1486    if x-date-alone  <> v-today then
     1487        Sheetf.rights-column =
     1488        "true  ,true ,true ,true ,true ,true ,true, true ,true ,true ,true,false ,true ," .
     1489        else
     1490         Sheetf.rights-column  =
     1491        "true  ,true ,true ,true ,true ,true ,true, true ,true ,true ,true, true ,true ," .
     1492   END PROCEDURE.
     1493   PROCEDURE state-changed :
     1494     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1495     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1496     CASE p-state:
     1497     END CASE.
     1498   END PROCEDURE.
