     1496   define temp-table tt-cash-list like cash-list .
     1497   DEFINE BUTTON b-sel-cash DEFAULT
     1498     IMAGE-UP FILE "btn-down-arrow":U
     1499     IMAGE-DOWN FILE "btn-down-arrow":U
     1500     IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1501     LABEL "":L
     1502     SIZE 2.5 BY 1.08.
     1503   DEFINE BUTTON b-sel-param DEFAULT
     1504     IMAGE-UP FILE "btn-down-arrow":U
     1505     IMAGE-DOWN FILE "btn-down-arrow":U
     1506     IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1507     LABEL "":L
     1508     SIZE 2.5 BY 1.08.
     1509   DEFINE VARIABLE SelectDiff   AS CHARACTER
     1510     VIEW-AS RADIO-SET VERTICAL
     1511     RADIO-BUTTONS
     1512     "Все кассы", "all":U,
     1513     "Выбор кассы", "select":U
     1514     SIZE 32.5 BY 1.54 NO-UNDO.
     1515   DEFINE VARIABLE SelectParam  AS CHARACTER
     1516     VIEW-AS RADIO-SET VERTICAL
     1517     RADIO-BUTTONS
     1518     "Все параметры", "all":U,
     1519     "Параметры с расхождениями", "diff":U,
     1520     "Обязательные параметры", "mandatory":U,
     1521     "Необязательные параметры", "optional":U,
     1522     "Выбор параметров", "choose":U
     1523     SIZE 30.63 BY 3.25 NO-UNDO.
     1524   DEFINE VARIABLE SelectSource AS CHARACTER
     1525     VIEW-AS RADIO-SET VERTICAL
     1526     RADIO-BUTTONS
     1527     "Все", "all":U,
     1528     "Параметры", "param":U,
     1529     "Клавиатура", "keyboard":U
     1530     SIZE 30.63 BY 2.5 NO-UNDO.
     1531   DEFINE RECTANGLE rect-3
     1532     EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1533     SIZE 37.25 BY 4.79.
     1534   DEFINE RECTANGLE rect-4
     1535     EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1536     SIZE 37.25 BY 11.5.
     1537   DEFINE RECTANGLE rect-6
     1538     EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1539     SIZE 37 BY 3.
     1540   DEFINE RECTANGLE rect-8
     1541     EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1542     SIZE 37.13 BY 3.75.
     1543   DEFINE VARIABLE choose-device AS CHARACTER INITIAL "-1"
     1544     VIEW-AS SELECTION-LIST MULTIPLE SCROLLBAR-VERTICAL
     1545     SIZE 35.5 BY 9.88 NO-UNDO.
     1546   DEFINE FRAME F-Main
     1547     SelectParam AT ROW 2.5 COL 2.75 NO-LABEL
     1548     choose-device AT ROW 2.63 COL 39.63 NO-LABEL WIDGET-ID 10
     1549     b-sel-param AT ROW 4.83 COL 35.13 WIDGET-ID 80
     1550     SelectSource AT ROW 7 COL 2.88 NO-LABEL WIDGET-ID 64
     1551     SelectDiff AT ROW 11.04 COL 2.88 NO-LABEL WIDGET-ID 54
     1552     b-sel-cash AT ROW 11.5 COL 35.13 WIDGET-ID 82
     1553     "Выбор по обязательности" VIEW-AS TEXT
     1554     SIZE 31.25 BY .79 AT ROW 1.42 COL 2.63
     1555     FGCOLOR 4
     1556     "Выбор признака исполнения касссы" VIEW-AS TEXT
     1557     SIZE 32.88 BY .79 AT ROW 1.46 COL 39.88 WIDGET-ID 50
     1558     FGCOLOR 4
     1559     "Выбор источника" VIEW-AS TEXT
     1560     SIZE 31.25 BY .79 AT ROW 6.13 COL 2.75 WIDGET-ID 70
     1561     FGCOLOR 4
     1562     "По наличию расхождений" VIEW-AS TEXT
     1563     SIZE 31.25 BY .79 AT ROW 9.96 COL 2.75 WIDGET-ID 60
     1564     FGCOLOR 4
     1565     rect-3 AT ROW 1.21 COL 1.25
     1566     rect-4 AT ROW 1.25 COL 38.75 WIDGET-ID 42
     1567     rect-6 AT ROW 9.75 COL 1.5 WIDGET-ID 52
     1568     rect-8 AT ROW 6 COL 1.38 WIDGET-ID 62
     1569     WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1570     SIDE-LABELS NO-UNDERLINE THREE-D
     1571     AT COL 1 ROW 1
     1572     SIZE 75 BY 12.08.
     1573   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1574   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1575   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1576   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1577   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1578   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1579   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1580   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1581       ASSIGN adm-object-hdl = FRAME F-Main:HANDLE.
     1582   RUN ensure-broker.
     1583   THIS-PROCEDURE:ADM-DATA =
     1584        'ADM1.1~`':U +
     1585        'SmartObject~`':U +
     1586        'FRAME~`':U +
     1587        'NO ~`':U +
     1588        '~`':U +
     1589        '~`':U +
     1590        '~`':U +
     1591        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1592           + "~`":U +
     1593        'Layout,Hide-on-Init~`':U +
     1594        '~`':U +
     1595        '~`':U +
     1596        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1597        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1598            THEN "^^":U
     1599        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1600             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1601   PROCEDURE adm-apply-entry :
     1602     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1603   END PROCEDURE.
     1604   PROCEDURE adm-destroy :
     1605    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1606   END PROCEDURE.
     1607   PROCEDURE adm-disable :
     1608       DISABLE rect-3 rect-4 rect-6 rect-8 SelectParam choose-device SelectSource SelectDiff WITH FRAME F-Main.
     1609       RUN dispatch ('disable-fields':U).
     1610       RUN set-attribute-list ('ENABLED=no':U).
     1611       RETURN.
     1612   END PROCEDURE.
     1613   PROCEDURE adm-edit-attribute-list :
     1614         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
     1615         RETURN.
     1616   END PROCEDURE.
     1617   PROCEDURE adm-enable :
     1618       ENABLE UNLESS-HIDDEN rect-3 rect-4 rect-6 rect-8 SelectParam choose-device SelectSource SelectDiff WITH FRAME F-Main.
     1619       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1620       RUN set-attribute-list ('ENABLED=yes':U).
     1621       RETURN.
     1622   END PROCEDURE.
     1623   PROCEDURE adm-exit :
     1624        RUN notify ('exit':U).
     1625     RETURN.
     1626   END PROCEDURE.
     1627   PROCEDURE adm-hide :
     1628     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1629   END PROCEDURE.
     1630   PROCEDURE adm-initialize :
     1631     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1632   END PROCEDURE.
     1633   PROCEDURE adm-show-errors :
     1634       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1635       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1636           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1637       END.
     1638       RETURN.
     1639   END PROCEDURE.
     1640   PROCEDURE adm-UIB-mode :
     1641     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1642   END PROCEDURE.
     1643   PROCEDURE adm-view :
     1644     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1645   END PROCEDURE.
     1646   PROCEDURE dispatch :
     1647       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1648       RUN broker-dispatch IN adm-broker-hdl
     1649           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1650       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1651   END PROCEDURE.
     1652   PROCEDURE ensure-broker :
     1653   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1654   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1655   DO:
     1656       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1657       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1658   END.
     1659   END PROCEDURE.
     1660   PROCEDURE get-attribute :
     1661     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1662     RUN broker-get-attribute IN adm-broker-hdl
     1663         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1664     RETURN RETURN-VALUE.
     1665   END PROCEDURE.
     1666   PROCEDURE get-attribute-list :
     1667     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1668     RUN broker-get-attribute-list IN adm-broker-hdl
     1669         (INPUT THIS-PROCEDURE,
     1670          INPUT ?,
     1671          OUTPUT p-attr-list) NO-ERROR.
     1672     RETURN.
     1673   END PROCEDURE.
     1674   PROCEDURE new-state :
     1675     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1676     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1677     RETURN.
     1678   END PROCEDURE.
     1679   PROCEDURE notify :
     1680     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1681     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1682     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1683         RETURN "ADM-ERROR":U.
     1684     RETURN.
     1685   END PROCEDURE.
     1686   PROCEDURE set-attribute-list :
     1687     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1688     RUN ensure-broker.
     1689     RUN broker-set-attribute-list IN adm-broker-hdl
     1690         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1691     RETURN.
     1692   END PROCEDURE.
     1693   PROCEDURE set-position :
     1694       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1695       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1696       IF VALID-HANDLE(adm-object-hdl) THEN
     1697       DO:
     1698           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     1699           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     1700           DO:
     1701             IF p-row = 0 THEN p-row =
     1702               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     1703             IF p-col = 0 THEN p-col =
     1704               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     1705           END.
     1706           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     1707           DO:
     1708             parent-hdl = adm-object-hdl:PARENT.
     1709             IF p-row = 0 THEN p-row =
     1710               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     1711                 parent-hdl:ROW.
     1712             IF p-col = 0 THEN p-col =
     1713               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     1714                 parent-hdl:COL.
     1715           END.
     1716           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     1717           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     1718         ASSIGN adm-object-hdl:ROW    =   p-row
     1719                adm-object-hdl:COLUMN =   p-col.
     1720       END.
     1721       RETURN.
     1722   END PROCEDURE.
     1723   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
     1724       STRING(adm-object-hdl)).
     1725   PAUSE 0 BEFORE-HIDE.
     1726   PROCEDURE adm-change-page :
     1727     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
     1728     END PROCEDURE.
     1729   PROCEDURE delete-page :
     1730     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
     1731     RUN broker-delete-page IN adm-broker-hdl
     1732         (INPUT THIS-PROCEDURE, INPUT p-page#).
     1733     END PROCEDURE.
     1734   PROCEDURE init-object :
     1735     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
     1736     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
     1737     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
     1738     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
     1739     RUN broker-init-object IN adm-broker-hdl
     1740         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
     1741          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
     1742     RETURN.
     1743   END PROCEDURE.
     1744   PROCEDURE init-pages :
     1745     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
     1746     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1747         INPUT p-page-list) NO-ERROR.
     1748     END PROCEDURE.
     1749   PROCEDURE select-page :
     1750     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
     1751     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1752         INPUT p-page#) NO-ERROR.
     1753     END PROCEDURE.
     1754   PROCEDURE view-page :
     1755     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
     1756     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1757         INPUT p-page#).
     1758     END PROCEDURE.
     1759   ON CHOOSE OF b-sel-cash IN FRAME F-Main
     1760     DO:
     1761       DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1762       define variable ii         as integer   no-undo .
     1763       define buffer buf_cash-desk for ub.cash-desk.
     1764       assign SelectDiff.
     1765       for each tt-cash-list:
     1766         delete tt-cash-list.
     1767       end.
     1768       run ref/cashlist.w (input my-handle
     1769         ,INPUT "b-sel,b-mark"
     1770         ,INPUT 'все':U
     1771         ,INPUT v-cntxt-db-num
     1772         ,INPUT v-cntxt-host-code-obj
     1773         ,INPUT 'маг':U
     1774         ,INPUT v-cntxt-obj-code
     1775         ,INPUT ?
     1776         ,OUTPUT v-rid-list) NO-ERROR.
     1777       IF error-status:error
     1778         OR v-rid-list = '':U THEN
     1779       DO:
     1780         RETURN no-apply.
     1781       END.
     1782       do ii = 1 to num-entries(v-rid-list):
     1783         find first buf_cash-desk no-lock where
     1784           recid(buf_cash-desk) = integer(entry(ii, v-rid-list)) no-error .
     1785         if available buf_cash-desk and buf_cash-desk.autonomy <> integer('1':U) then
     1786         do:
     1787           CREATE tt-cash-list.
     1788           buffer-copy buf_cash-desk to tt-cash-list.
     1789         end.
     1790       end.
     1791     END.
     1792   ON CHOOSE OF b-sel-param IN FRAME F-Main
     1793     DO:
     1794       empty temp-table tmprecid .
     1795       run ref/cashpargroup.w ( input  my-handle
     1796         ,input  'ВЫБОР':U
     1797         ,input  ""
     1798         ,input "cash-param"
     1799         ,input ?
     1800         ) .
     1801       find first tmprecid no-lock where tmprecid.fTable = "code" no-error .
     1802       if not available tmprecid then
     1803       do:
     1804         message
     1805           "В списке нет ни одного параметра"
     1806           view-as alert-box WARNING.
     1807         SelectParam = "all" .
     1808         display SelectParam with frame F-Main .
     1809       end.
     1810     END.
     1811   ON VALUE-CHANGED OF choose-device IN FRAME F-Main
     1812     DO:
     1813       assign choose-device .
     1814     END.
     1815   ON VALUE-CHANGED OF SelectDiff IN FRAME F-Main
     1816     DO:
     1817       DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1818       define variable ii         as integer   no-undo .
     1819       define buffer buf_cash-desk for ub.cash-desk.
     1820       assign SelectDiff.
     1821       for each tt-cash-list:
     1822         delete tt-cash-list.
     1823       end.
     1824       case SelectDiff:
     1825         when "all" then
     1826           do:
     1827             disable b-sel-cash with frame F-Main .
     1828             for each obj-list:
     1829               for each cash-desk where cash-desk.obj-code = obj-list.obj-code and cash-desk.is-del = false and cash-desk.autonomy <> integer('1':U):
     1830                 buffer-copy cash-desk to tt-cash-list .
     1831               end.
     1832             end.
     1833           end.
     1834         otherwise
     1835         do:
     1836           enable b-sel-cash with frame F-Main .
     1837           run ref/cashlist.w (input my-handle
     1838             ,INPUT "b-sel,b-mark"
     1839             ,INPUT 'все':U
     1840             ,INPUT v-cntxt-db-num
     1841             ,INPUT v-cntxt-host-code-obj
     1842             ,INPUT 'маг':U
     1843             ,INPUT v-cntxt-obj-code
     1844             ,INPUT ?
     1845             ,OUTPUT v-rid-list) NO-ERROR.
     1846           IF error-status:error
     1847             OR v-rid-list = '':U THEN
     1848           DO:
     1849             message "Кассы не выбраны"
     1850               view-as alert-box WARNING.
     1851             SelectDiff = "all" .
     1852             display SelectDiff with frame F-Main .
     1853             disable b-sel-cash with frame F-Main .
     1854     for each obj-list:
     1855       for each cash-desk where cash-desk.obj-code = obj-list.obj-code and cash-desk.is-del = false and cash-desk.autonomy <> integer('1':U):
     1856         find first tt-cash-list where tt-cash-list.obj-code = cash-desk.obj-code and tt-cash-list.db-num = cash-desk.db-num and
     1857           tt-cash-list.pos-type = cash-desk.pos-type and tt-cash-list.cash-num = cash-desk.cash-num no-error .
     1858         if not available (tt-cash-list) then
     1859         do:
     1860           create tt-cash-list.
     1861           buffer-copy cash-desk to tt-cash-list .
     1862         end.
     1863       end.
     1864     end.
     1865           END.
     1866           do ii = 1 to num-entries(v-rid-list):
     1867             find first buf_cash-desk no-lock where
     1868               recid(buf_cash-desk) = integer(entry(ii, v-rid-list)) no-error .
     1869             if available buf_cash-desk and buf_cash-desk.autonomy <> integer('1':U) then
     1870             do:
     1871               CREATE tt-cash-list.
     1872               buffer-copy buf_cash-desk to tt-cash-list.
     1873             end.
     1874           end.
     1875         end.
     1876       end case .
     1877     END.
     1878   ON VALUE-CHANGED OF SelectParam IN FRAME F-Main
     1879     DO:
     1880       assign SelectParam.
     1881       case SelectParam:
     1882         when "choose":u then
     1883           do:
     1884             enable b-sel-param with frame F-Main .
     1885             for each tmprecid exclusive-lock where tmprecid.fTable = "code":
     1886               delete tmprecid .
     1887           end.
     1888             run ref/cashpargroup.w ( input  my-handle
     1889               ,input  'ВЫБОР':U
     1890               ,input  ""
     1891               ,input "cash-param"
     1892               ,input ?
     1893               ) .
     1894             find first tmprecid no-lock where tmprecid.fTable = "code" no-error .
     1895             if not available tmprecid then
     1896             do:
     1897               message
     1898                 "В списке нет ни одного параметра"
     1899                 view-as alert-box WARNING.
     1900               SelectParam = "all" .
     1901               display SelectParam with frame F-Main .
     1902               disable b-sel-param with frame F-Main .
     1903             end.
     1904           end.
     1905         otherwise
     1906         do:
     1907           disable b-sel-param with frame F-Main .
     1908         end.
     1909       end case.
     1910     END.
     1911   ON VALUE-CHANGED OF SelectSource IN FRAME F-Main
     1912     DO:
     1913       assign SelectSource.
     1914     END.
     1915   for each tt-cash-list:
     1916     delete tt-cash-list.
     1917   end.
     1918   run inifields .
     1919   PROCEDURE adm-create-objects :
     1920   END PROCEDURE.
     1921   PROCEDURE adm-row-available :
     1922     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1923     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1924     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1925     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1926     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1927     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1928     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1929     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1930     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1931     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1932     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1933     IF adm-updating-record THEN RETURN.
     1934     RUN get-attribute ('FIELDS-ENABLED':U).
     1935     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1936     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1937         OUTPUT link-handle) NO-ERROR.
     1938     IF link-handle = "":U THEN
     1939         RETURN.
     1940     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1941     IF NUM-ENTRIES(link-handle) > 1 THEN
     1942         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1943             "encountered more than one RECORD-SOURCE.":U SKIP
     1944             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1945                VIEW-AS ALERT-BOX ERROR.
     1946     RUN get-attribute ('Key-Name':U).
     1947     key-name = RETURN-VALUE.
     1948     IF key-name = "":U THEN key-name = ?.
     1949     IF key-name NE ? THEN DO:
     1950       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1951         NO-ERROR.
     1952       IF key-value NE ? THEN
     1953         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1954     END.
     1955   IF VALID-HANDLE (adm-object-hdl) THEN
     1956       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1957   RUN notify IN THIS-PROCEDURE ('row-available':U).
     1958   END PROCEDURE.
     1959   PROCEDURE disable_UI :
     1960     HIDE FRAME F-Main.
     1961     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1962   END PROCEDURE.
     1963   PROCEDURE enable_UI :
     1964     DISPLAY SelectParam choose-device SelectSource SelectDiff
     1965       WITH FRAME F-Main.
     1966     ENABLE rect-3 rect-4 rect-6 rect-8 SelectParam choose-device SelectSource
     1967       SelectDiff
     1968       WITH FRAME F-Main.
     1969   END PROCEDURE.
     1970   PROCEDURE inifields :
     1971     define variable mdevice as class ibs.th.str.cash.CashDevice
     1972       no-undo.
     1973     mdevice = new ibs.th.str.cash.CashDevice().
     1974     define variable objType    as ibs.th.gbl.propmap no-undo.
     1975     define variable kk as integer no-undo .
     1976     do kk = 1 to mdevice:mapType:GetItem(kk):
     1977       objType = mdevice:CurrProp.
     1978       create tt-device .
     1979       assign
     1980         tt-device.code_    = string(objType:KeyIntDB)
     1981         tt-device.codeName = objType:Label_
     1982         .
     1983     end.
     1984     choose-device:list-item-pairs in frame F-Main = "ВСЕ,-1" .
     1985     for each tt-device no-lock by tt-device.code_:
     1986       assign
     1987         choose-device :list-item-pairs = substitute( "&2&1&3&1&4"
     1988                                          , ","
     1989                                          , choose-device :list-item-pairs
     1990                                          , tt-device.codeName
     1991                                          , tt-device.code_) no-error   .
     1992       if error-status:error then leave .
     1993     end.
     1994     for each obj-list:
     1995       for each cash-desk where cash-desk.obj-code = obj-list.obj-code and cash-desk.is-del = false and cash-desk.autonomy <> integer('1':U):
     1996         find first tt-cash-list where tt-cash-list.obj-code = cash-desk.obj-code and tt-cash-list.db-num = cash-desk.db-num and
     1997           tt-cash-list.pos-type = cash-desk.pos-type and tt-cash-list.cash-num = cash-desk.cash-num no-error .
     1998         if not available (tt-cash-list) then
     1999         do:
     2000           create tt-cash-list.
     2001           buffer-copy cash-desk to tt-cash-list .
     2002         end.
     2003       end.
     2004     end.
     2005   END PROCEDURE.
     2006   PROCEDURE local-initialize :
     2007     run dispatch in this-procedure ( input 'initialize':u ) .
     2008   end procedure.
     2009   PROCEDURE My-report :
     2010   define variable v-attr-value as character no-undo .
     2011     define variable v-attr-type  as character no-undo .
     2012     define buffer buf_cash-desk-attr for ub.cash-desk-attr .
     2013     define variable kk as integer no-undo .
     2014     empty temp-table cash-list .
     2015     for each tt-cash-list:
     2016       create cash-list .
     2017       buffer-copy tt-cash-list to cash-list .
     2018     end.
     2019     if choose-device <> "-1" then
     2020     do:
     2021       for each cash-list :
     2022         if lookup(string(cash-list.deviceCode), choose-device, ",") = 0 then
     2023         delete cash-list .
     2024       end.
     2025     end.
     2026     run rep/cash-param.p (
     2027       input my-handle,
     2028       input choose-device,
     2029       input SelectParam,
     2030       input SelectSource,
     2031       input table tmprecid,
     2032       input table cash-list
     2033       ).
     2034   end procedure.
     2035   PROCEDURE my-var :
     2036     .
     2037   end procedure.
