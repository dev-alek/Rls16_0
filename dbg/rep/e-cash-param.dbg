      684   procedure cur-time :
      685      define output parameter p-today as date      no-undo .
      686      define output parameter p-time  as integer   no-undo .
      687     do
      688     on error undo, return error
      689     :
      690       define variable v-date1 as date      no-undo .
      691       define variable v-date2 as date      no-undo .
      692       define variable v-time  as integer   no-undo .
      693       assign
      694         v-date1 = today
      695         v-time  = time
      696         v-date2 = today
      697       .
      698       if v-date1 <> v-date2
      699       then do:
      700         assign
      701           v-date1 = today
      702           v-time  = v-time
      703         .
      704       end.
      705       assign
      706         p-today = v-date1
      707         p-time  = v-time
      708       .
      709     end.
      710   end.
      711   function cur-time-date returns character
      712   :
      713     return string(today, '99/99/9999':U) .
      714   end.
      715   function cur-time-mjd returns decimal
      716   :
      717     define variable v-date as date      no-undo .
      718     define variable v-time as integer   no-undo .
      719     run cur-time in this-procedure
      720       (output v-date
      721       ,output v-time
      722       ) .
      723     return integer(v-date) - 2400002 + (v-time / 86400) .
      724   end.
      725   function cur-time-get-ending-index returns integer
      726   (input p-number as integer
      727   )
      728   :
      729     if p-number < 0
      730     or p-number = ?
      731     then do:
      732       return 1 .
      733     end.
      734     define variable v-rest as integer   no-undo .
      735     assign
      736       p-number = p-number modulo 100
      737     .
      738     if p-number < 20
      739     then do:
      740       assign
      741         v-rest = p-number
      742       .
      743     end.
      744     else do:
      745       assign
      746         v-rest = p-number modulo 10
      747       .
      748     end.
      749     case v-rest :
      750       when 1
      751       then do:
      752         return 2 .
      753       end.
      754       when 2 or
      755       when 3 or
      756       when 4
      757       then do:
      758         return 3 .
      759       end.
      760       otherwise do:
      761         return 1 .
      762       end.
      763     end case .
      764   end.
      765   procedure cur-time-mjd-to-date :
      766      define input  parameter i-mjd-diff as decimal no-undo.
      767      define output parameter o-Date     as date    no-undo.
      768      define output parameter o-Time     as integer no-undo.
      769      define variable v-day-number as integer   no-undo .
      770      if    i-mjd-diff < 0
      771         or i-mjd-diff = ?
      772      then do:
      773         return "?" .
      774      end.
      775      assign
      776         v-day-number = truncate(i-mjd-diff,0).
      777         o-Date = date(v-day-number + 2400002).
      778         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      779     .
      780   end.
      781   function cur-time-mjd-to-string returns character
      782   (input p-mjd-diff as decimal
      783   )
      784   :
      785     define variable v-day-number as integer   no-undo .
      786     define variable v-seconds    as integer   no-undo .
      787     define variable v-hour       as integer   no-undo .
      788     define variable v-min        as integer   no-undo .
      789     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      790     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      791     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      792     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      793     if p-mjd-diff < 0
      794     or p-mjd-diff = ?
      795     then do:
      796       return "?" .
      797     end.
      798     assign
      799       v-day-number = integer(truncate(p-mjd-diff,0))
      800       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      801     .
      802     if v-seconds > 86400
      803     then do:
      804       assign
      805         v-seconds = 86400 - 1
      806       .
      807     end.
      808     if v-seconds < 0
      809     then do:
      810       assign
      811         v-seconds = 0
      812       .
      813     end.
      814     assign
      815       v-hour = truncate(v-seconds / 3600, 0)
      816     .
      817     assign
      818       v-seconds = v-seconds modulo 3600
      819     .
      820     assign
      821       v-min = truncate(v-seconds / 60, 0)
      822     .
      823     assign
      824       v-seconds = v-seconds modulo 60
      825     .
      826     return
      827         (if v-day-number <> 0
      828           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      829           else ""
      830         )
      831       + (if v-day-number <> 0 or v-hour <> 0
      832           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      833           else ""
      834         )
      835       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      836           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      837           else ""
      838         )
      839       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      840       .
      841   end.
      842   function cur-time-string returns character
      843   :
      844     define variable v-date as date      no-undo .
      845     define variable v-time as integer   no-undo .
      846     run cur-time in this-procedure
      847       (output v-date
      848       ,output v-time
      849       ) .
      850     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      851   end.
      852   function cur-time-string-sec returns character
      853   :
      854     define variable v-date as date      no-undo .
      855     define variable v-time as integer   no-undo .
      856     run cur-time in this-procedure
      857       (output v-date
      858       ,output v-time
      859       ) .
      860     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      861   end.
      862   function cur-time-custom  returns character
      863   (input p-prefix as character
      864   ,input p-date-format as character
      865   ,input p-delimiter as character
      866   ,input p-time-format as character
      867   ,input p-suffix as character
      868   )
      869   :
      870     define variable v-date as date      no-undo .
      871     define variable v-time as integer   no-undo .
      872     run cur-time in this-procedure
      873       (output v-date
      874       ,output v-time
      875       ) .
      876     return
      877       p-prefix
      878       + string(v-date, p-date-format)
      879       + p-delimiter
      880       + string(v-time, p-time-format)
      881       + p-suffix
      882       .
      883   end.
      884   function cur-time-print  returns character
      885   :
      886     define variable v-date as date      no-undo .
      887     define variable v-time as integer   no-undo .
      888     run cur-time in this-procedure
      889       (output v-date
      890       ,output v-time
      891       ) .
      892     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      893   end.
      894   function cur-time-datetime returns datetime
      895   :
      896     define variable v-char as character no-undo .
      897     define variable v-datetime as datetime no-undo .
      898     v-char = cur-time-string().
      899     v-datetime = datetime(v-char).
      900     return  v-datetime.
      901   end.
      902   function cur-time-string-msec returns character
      903   :
      904     define variable v-date as datetime  no-undo .
      905     v-date = now.
      906     return string(v-date) .
      907   end.
      908    define new shared temp-table tmprecid
      909       field Frecid as recid init ?
      910       field fnum as character
      911       field fTable as character
      912    index num  fnum Frecid
      913    index itable is primary unique fTable Frecid
      914    .
      915   define variable fSelect as logical no-undo format "*/" column-label "".
      916   function isSelect return logical
      917       (iBuffer as handle  ):
      918       define buffer tmprecid for tmprecid.
      919       if iBuffer:available
      920       then
      921          find first tmprecid where tmprecid.fTable = iBuffer:TABLE
      922                                and tmprecid.Frecid = iBuffer:recid
      923          no-lock no-error.
      924       return available tmprecid.
      925    end.
      926   function setSelect return logical
      927       (iBuffer as handle  ):
      928       define buffer tmprecid for tmprecid.
      929       if iBuffer:available
      930       then do:
      931          find first tmprecid where tmprecid.fTable = iBuffer:TABLE
      932                                and tmprecid.Frecid = iBuffer:recid
      933          no-lock no-error.
      934          if available tmprecid
      935          then
      936             delete tmprecid.
      937          else do:
      938             create tmprecid.
      939             assign
      940                tmprecid.fTable = iBuffer:TABLE
      941                tmprecid.Frecid = iBuffer:recid
      942             .
      943          end.
      944       end.
      945       return available tmprecid.
      946    end.
      947    procedure rid-keep :
      948        run gbl/rid-keep.p (input table tmprecid) no-error.
      949    end.
      950    procedure rid-rest :
      951         run gbl/rid-rest.p (output table tmprecid) no-error.
      952    end.
