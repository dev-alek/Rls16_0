     1447     on error undo, return error return-value
     1448     :
     1449           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run cd-attr-manual-edit in g#attr-lib
     1450         (input  p-ucode
     1451         ,input  p-code
     1452         ,output p-section-num
     1453         ) no-error .
     1454       if error-status :error
     1455       then do:
     1456         undo, return error return-value .
