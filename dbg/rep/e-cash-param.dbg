     1464     do
     1465     on error undo, return error return-value
     1466     :
     1467           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run cd-attr-batch-edit in g#attr-lib
     1468         (input  p-ucode
     1469         ,input  p-code
     1470         ,output p-section-num
     1471         ) no-error .
     1472       if error-status :error
