     1404                           )
     1405       .
     1406       return ? .
     1407     end.
     1408     return v-return-value .
     1409   end function.
     1410   procedure cd-attr_check-marketer :
     1411     define input parameter p-db-num   like ub.cash-desk-attr.db-num     no-undo .
     1412     define input parameter p-obj-code like ub.cash-desk-attr.obj-code   no-undo .
     1413     define input parameter p-pos-type like ub.cash-desk-attr.pos-type   no-undo .
     1414     define input parameter p-cash-num like ub.cash-desk-attr.cash-num   no-undo .
     1415     define input parameter p-ucode     like ub.cash-desk-attr.upper-attr-code  no-undo .
     1416     define input parameter p-code     like ub.cash-desk-attr.attr-code  no-undo .
     1417     define input parameter p-value as character no-undo .
     1418     define input parameter p-mode  as character no-undo .
     1419     define output parameter p-correct     as logical no-undo .
     1420     define output parameter p-error-code  as character no-undo .
     1421     do
     1422     on error undo, return error return-value
     1423     :
     1424           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run cd-attr_check-marketer in g#attr-lib
     1425         (input  p-db-num
     1426         ,input  p-obj-code
     1427         ,input  p-pos-type
     1428         ,input  p-cash-num
     1429         ,input  p-ucode
     1430         ,input  p-code
     1431         ,input  p-value
     1432         ,input  p-mode
     1433         ,output p-correct
     1434         ,output p-error-code
     1435         ) no-error .
     1436       if error-status :error
     1437       then do:
     1438         undo, return error return-value .
     1439       end.
     1440     end.
     1441   end procedure.
     1442   procedure cd-attr-manual-edit :
