     3726       b1-rash                                            [kk]    = 0
     3727       b1-kassa                                           [kk]    = 0
     3728       b1-inv                                             [kk]    = 0
     3729       b1-overturn                                        [kk]    = 0
     3730       b1-ostatok-end                                     [kk]    = 0
     3731       b1-ostatok-start                                   [kk]    = 0   .
     3732      end.
     3733    end procedure.
     3734   procedure clear-b2  :
