     3760   procedure display-title :
     3761   define variable v-nn as integer   no-undo .
     3762      PUT stream  OutStream  UNFORMATTED  string( v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + objname) at 50 format "x(85)" skip(2)
     3763             reportname  at 20 format "x(170)" skip
     3764             trim(str1)  at 35 format "x(75)" skip.
     3765        v-nn = num-entries(str2,chr(10)) .
     3766        repeat i = 1 to v-nn :
     3767         PUT stream  OutStream  UNFORMATTED  entry(i,str2,chr(10))  at 1 format "x(170)" skip.
     3768        end.
     3769       i=0.
     3770        PUT stream  OutStream  UNFORMATTED  trim(str3)  at 35 format "x(75)" skip.
     3771        v-nn = num-entries(str4,chr(10)) .
     3772        repeat i = 1 to v-nn:
     3773          PUT stream  OutStream  UNFORMATTED  entry(i,str4,chr(10))  at 1 format "x(170)" skip.
     3774        end.
     3775       i=0.
     3776        v-nn = num-entries( reportheader,chr(10)) .
     3777        repeat i = 1 to v-nn :
     3778         PUT stream  OutStream  UNFORMATTED  entry(i,reportheader,chr(10))  at 1 format "x(170)" skip.
     3779        end.
     3780       i=0.
     3781       run rep/extitle.p (1) .
     3782   end procedure.
     3783   procedure report-exec1  :
     3784      find first clients where x-store-type = clients.obj-type and
     3785                               x-store-code = clients.obj-code no-lock no-error.
     3786     run calcitog.
     3787     run print-header.
     3788      case retclassify :
     3789         when "prod/grp-goods":u then run run4 in this-procedure .
     3790         otherwise do:
     3791           message "error" view-as alert-box error .
     3792         end.
     3793      end case.
     3794     run print-footer.
     3795     end procedure.
     3796   procedure calc-sub-itog :
     3797   define variable b  as int no-undo.
     3798   assign
     3799     b1-gds-zap-other = b1-gds-zap-other +  gds-zap-other
     3800     b2-gds-zap-other = b2-gds-zap-other +  gds-zap-other
     3801     bi-gds-zap-other = bi-gds-zap-other +  gds-zap-other
     3802     bo-gds-zap-other = bo-gds-zap-other +  gds-zap-other
     3803     .
     3804   repeat b = 1 to 20 :
     3805     assign
     3806     b1-ostatok-start[b ]    = b1-ostatok-start[b ]    +  ostatok-start[b ]
     3807     b1-ostatok-end  [b ]    = b1-ostatok-end  [b ]    +  ostatok-end  [b ]
     3808     b2-ostatok-start[b ]    = b2-ostatok-start[b ]    +  ostatok-start[b ]
     3809     b2-ostatok-end  [b ]    = b2-ostatok-end  [b ]    +  ostatok-end  [b ]
     3810     bi-ostatok-start[b ]    = bi-ostatok-start[b ]    +  ostatok-start[b ]
     3811     bi-ostatok-end  [b ]    = bi-ostatok-end  [b ]    +  ostatok-end  [b ]
     3812     bo-ostatok-start[b ]    = bo-ostatok-start[b ]    +  ostatok-start[b ]
     3813     bo-ostatok-end  [b ]    = bo-ostatok-end  [b ]    +  ostatok-end  [b ]
     3814     b1-prih[b ]    = b1-prih[b ]    +  prih[b ]
     3815     b2-prih[b ]    = b2-prih[b ]    +  prih[b ]
     3816     bi-prih[b ]    = bi-prih[b ]    +  prih[b ]
     3817     bo-prih[b ]    = bo-prih[b ]    +  prih[b ]
     3818     b1-rash[b ]    = b1-rash[b ]    +  rash[b ]
     3819     b2-rash[b ]    = b2-rash[b ]    +  rash[b ]
     3820     bi-rash[b ]    = bi-rash[b ]    +  rash[b ]
     3821     bo-rash[b ]    = bo-rash[b ]    +  rash[b ]
     3822     b1-kassa[b ]    = b1-kassa[b ]    +  kassa[b ]
     3823     b2-kassa[b ]    = b2-kassa[b ]    +  kassa[b ]
     3824     bi-kassa[b ]    = bi-kassa[b ]    +  kassa[b ]
     3825     bo-kassa[b ]    = bo-kassa[b ]    +  kassa[b ]
     3826     b1-inv[b ]    = b1-inv[b ]    +  inv[b ]
     3827     b2-inv[b ]    = b2-inv[b ]    +  inv[b ]
     3828     bi-inv[b ]    = bi-inv[b ]    +  inv[b ]
     3829     bo-inv[b ]    = bo-inv[b ]    +  inv[b ]
     3830     b1-overturn[b ]    = b1-overturn[b ]    +  overturn[b ]
     3831     b2-overturn[b ]    = b2-overturn[b ]    +  overturn[b ]
     3832     bi-overturn[b ]    = bi-overturn[b ]    +  overturn[b ]
     3833     bo-overturn[b ]    = bo-overturn[b ]    +  overturn[b ]
     3834     .
     3835   end.
     3836   end procedure.
     3837   procedure clear-item :
     3838   define variable kk as int no-undo.
     3839    gds-zap-other = 0 .
     3840    repeat kk = 1 to 20 :
     3841    assign
     3842       prih            [kk]    = 0
     3843       rash            [kk]    = 0
     3844       kassa           [kk]    = 0
     3845       inv             [kk]    = 0
     3846       overturn        [kk]    = 0
     3847       ostatok-end     [kk]    = 0
     3848       ostatok-start   [kk]    = 0 .
