     4506     excel-sum(bo-Inv          [5  + f_e ])  CHR(9)
     4507     excel-sum(bo-Inv          [8  + f_e ])  CHR(9)
     4508     excel-sum(bo-Inv          [3  + f_e ])  CHR(9)
     4509     excel-sum(bo-Inv          [6  + f_e ])  CHR(9)
     4510     excel-sum(bo-Inv          [9  + f_e ])  CHR(9)
     4511     .
     4512     if Make-Excel then  put   stream ForExcel unformatted
     4513     excel-qnty(bo-Overturn    [1  + f_e ])  CHR(9)
     4514     excel-sum(bo-Overturn     [2  + f_e ])  CHR(9)
     4515     excel-sum(bo-Overturn     [5  + f_e ])  CHR(9)
     4516     excel-sum(bo-Overturn     [8  + f_e ])  CHR(9)
     4517     excel-sum(bo-Overturn     [3  + f_e ])  CHR(9)
     4518     excel-sum(bo-Overturn     [6  + f_e ])  CHR(9)
     4519     excel-sum(bo-Overturn     [9  + f_e ])  CHR(9)
     4520     excel-qnty(bo-Ostatok-end [1  + f_e ])  CHR(9)
     4521     excel-sum(bo-Ostatok-end  [2  + f_e ])  CHR(9)
     4522     excel-sum(bo-Ostatok-end  [5  + f_e ])  CHR(9)
     4523     excel-sum(bo-Ostatok-end  [8  + f_e ])  CHR(9)
     4524     excel-sum(bo-Ostatok-end  [3  + f_e ])  CHR(9)
     4525     excel-sum(bo-Ostatok-end  [6  + f_e ])  CHR(9)
     4526     excel-sum(bo-Ostatok-end  [9  + f_e ])  CHR(9)
     4527     g2
     4528     skip.
     4529                end.
     4530      when ""  then     do :
     4531       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     4532         p3 @ s-bar-code
     4533         p4 @ gds-zap-artic
     4534         p5 @ gds-zap-gds-name
     4535         p6 @ gds-zap-unit-base
     4536         p1 @ gds-type
     4537         ostatok-start [p2] format "->>>>>>>>>>9.<<<" @  F-ostatok-start
     4538         Prih          [p2] format "->>>>>>>>>>9.<<<" @  F-Prih
     4539         RAsh          [p2] format "->>>>>>>>>>9.<<<" @  F-RAsh
     4540         KAssa         [p2] format "->>>>>>>>>>9.<<<" @  F-KAssa
     4541         Inv           [p2] format "->>>>>>>>>>9.<<<" @  F-Inv
     4542         Overturn      [p2] format "->>>>>>>>>>9.<<<" @  F-Overturn
     4543         Ostatok-end   [p2] format "->>>>>>>>>>9.<<<" @  F-Ostatok-end
     4544         gds-zap-other      format "->>>>>>>>>>9.<<<" when (p2 = 1) @  gds-zap-other
     4545         with FRAME ZAPAS .
     4546    if  p2 > 10  then f_e = 10 .
     4547                 else f_e =  0 .
     4548   if Make-Excel then  put   stream ForExcel unformatted
     4549     p3 CHR(9)
     4550     p4 CHR(9)
     4551     if f_e = 0 then g1 else p5 CHR(9)
     4552     p6 CHR(9)
     4553     gds-zap-type CHR(9)
     4554     excel-sum(gds-zap-other   )  CHR(9)
     4555     excel-qnty(ostatok-start[1  + f_e ])  CHR(9)
     4556     excel-sum(ostatok-start[2  + f_e ])  CHR(9)
     4557     excel-sum(ostatok-start[5  + f_e ])  CHR(9)
     4558     excel-sum(ostatok-start[8  + f_e ])  CHR(9)
     4559     .
     4560     if Make-Excel then  put   stream ForExcel unformatted
     4561     excel-sum(ostatok-start[3  + f_e ])  CHR(9)
     4562     excel-sum(ostatok-start[6  + f_e ])  CHR(9)
     4563     excel-sum(ostatok-start[9  + f_e ])  CHR(9)
     4564     excel-qnty(Prih        [1  + f_e ])  CHR(9)
     4565     excel-sum(Prih         [2  + f_e ])  CHR(9)
     4566     excel-sum(Prih         [5  + f_e ])  CHR(9)
     4567     excel-sum(Prih         [8  + f_e ])  CHR(9)
     4568     excel-sum(Prih         [3  + f_e ])  CHR(9)
     4569     excel-sum(Prih         [6  + f_e ])  CHR(9)
     4570     excel-sum(Prih         [9  + f_e ])  CHR(9)
     4571     .
     4572     if Make-Excel then  put   stream ForExcel unformatted
     4573     excel-qnty(RAsh        [1  + f_e ])  CHR(9)
     4574     excel-sum(RAsh         [2  + f_e ])  CHR(9)
     4575     excel-sum(RAsh         [5  + f_e ])  CHR(9)
     4576     excel-sum(RAsh         [8  + f_e ])  CHR(9)
     4577     excel-sum(RAsh         [3  + f_e ])  CHR(9)
     4578     excel-sum(RAsh         [6  + f_e ])  CHR(9)
     4579     excel-sum(RAsh         [9  + f_e ])  CHR(9)
     4580     excel-qnty(KAssa       [1  + f_e ])  CHR(9)
     4581     excel-sum(KAssa        [2  + f_e ])  CHR(9)
     4582     excel-sum(KAssa        [5  + f_e ])  CHR(9)
     4583     excel-sum(KAssa        [8  + f_e ])  CHR(9)
     4584     excel-sum(KAssa        [3  + f_e ])  CHR(9)
     4585     excel-sum(KAssa        [6  + f_e ])  CHR(9)
     4586     .
     4587     if Make-Excel then  put   stream ForExcel unformatted
     4588     excel-sum(KAssa        [9  + f_e ])  CHR(9)
     4589     excel-qnty(Inv         [1  + f_e ])  CHR(9)
     4590     excel-sum(Inv          [2  + f_e ])  CHR(9)
     4591     excel-sum(Inv          [5  + f_e ])  CHR(9)
     4592     excel-sum(Inv          [8  + f_e ])  CHR(9)
     4593     excel-sum(Inv          [3  + f_e ])  CHR(9)
     4594     excel-sum(Inv          [6  + f_e ])  CHR(9)
     4595     excel-sum(Inv          [9  + f_e ])  CHR(9)
     4596     .
     4597     if Make-Excel then  put   stream ForExcel unformatted
     4598     excel-qnty(Overturn    [1  + f_e ])  CHR(9)
     4599     excel-sum(Overturn     [2  + f_e ])  CHR(9)
     4600     excel-sum(Overturn     [5  + f_e ])  CHR(9)
     4601     excel-sum(Overturn     [8  + f_e ])  CHR(9)
     4602     excel-sum(Overturn     [3  + f_e ])  CHR(9)
     4603     excel-sum(Overturn     [6  + f_e ])  CHR(9)
     4604     excel-sum(Overturn     [9  + f_e ])  CHR(9)
     4605     excel-qnty(Ostatok-end [1  + f_e ])  CHR(9)
     4606     excel-sum(Ostatok-end  [2  + f_e ])  CHR(9)
     4607     excel-sum(Ostatok-end  [5  + f_e ])  CHR(9)
     4608     excel-sum(Ostatok-end  [8  + f_e ])  CHR(9)
     4609     excel-sum(Ostatok-end  [3  + f_e ])  CHR(9)
     4610     excel-sum(Ostatok-end  [6  + f_e ])  CHR(9)
     4611     excel-sum(Ostatok-end  [9  + f_e ])  CHR(9)
     4612     g2
     4613     skip.
     4614                 end.
     4615      end case.
     4616                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     4617    end procedure.
     4618   procedure ost-line-body :
     4619   do on error undo, return error return-value :
     4620   define input parameter p-num        as   integer   no-undo .
     4621   define input parameter p-store-type like ub.clients.obj-type no-undo .
     4622   define input parameter p-store-code like ub.clients.obj-code no-undo .
     4623    find last  ub.aht-stk-line where
     4624                           ub.aht-stk-line.gds-code   = gds-zap-b-code
     4625                     and   ub.aht-stk-line.fact-order <= fact-order-1
     4626                     and   ub.aht-stk-line.obj-code   = p-store-code
     4627                     and   ub.aht-stk-line.obj-type   = p-store-type
     4628                     and   ub.aht-stk-line.sum-type   = x-type-pr
     4629                           use-index category no-lock no-error.
     4630           if available ub.aht-stk-line then do:
     4631               if  tprintrubl  then
     4632                     assign
     4633                           ostatok-start[1 + p-num]  = ostatok-start[1 + p-num] +  (if ub.aht-stk-line.sum-type <> "b"
     4634                                                                   then round( ub.aht-stk-line.fact-qnty,3) else 0 )
     4635                           ostatok-start[2 + p-num]  =ostatok-start[2 + p-num] +  round( ub.aht-stk-line.cost-sum-rubl ,2)
     4636                           ostatok-start[3 + p-num]  =ostatok-start[3 + p-num] +  round( ub.aht-stk-line.cost-vat-rubl ,2)
     4637                           ostatok-start[4 + p-num]  =ostatok-start[4 + p-num] +  0
     4638                           ostatok-start[5 + p-num]  =ostatok-start[5 + p-num]  + round( ub.aht-stk-line.crsa-sum-rubl ,2)
     4639                           ostatok-start[6 + p-num]  =ostatok-start[6 + p-num]  + round( ub.aht-stk-line.crsa-vat-rubl ,2)
     4640                           ostatok-start[7 + p-num]  =ostatok-start[7 + p-num]  + round( ub.aht-stk-line.sale-discnt-rubl ,2)
     4641                           ostatok-start[8 + p-num]  =ostatok-start[8 + p-num]  + round( ub.aht-stk-line.crsa-sum-rubl ,2)
     4642                           ostatok-start[9 + p-num]  =ostatok-start[9 + p-num]  + round( ub.aht-stk-line.crsa-vat-rubl ,2)
     4643                           ostatok-start[10 + p-num] =ostatok-start[10 + p-num] + round( ub.aht-stk-line.crsa-slt-rubl ,2)
     4644                           .
     4645                 else
     4646                     assign
     4647                           ostatok-start[1 + p-num]  = ostatok-start[1 + p-num] + (if ub.aht-stk-line.sum-type <> "b"
     4648                                                                      then round( ub.aht-stk-line.fact-qnty,3) else 0 )
     4649                           ostatok-start[2 + p-num]  = ostatok-start[2 + p-num] +  round( ub.aht-stk-line.cost-sum-base ,2)
     4650                           ostatok-start[3 + p-num]  = ostatok-start[3 + p-num] +  round( ub.aht-stk-line.cost-vat-base ,2)
     4651                           ostatok-start[4 + p-num]  = ostatok-start[4 + p-num] +  0
     4652                           ostatok-start[5 + p-num]  = ostatok-start[5 + p-num]  + round( ub.aht-stk-line.crsa-sum-base ,2)
     4653                           ostatok-start[6 + p-num]  = ostatok-start[6 + p-num]  + round( ub.aht-stk-line.crsa-vat-base ,2)
     4654                           ostatok-start[7 + p-num]  = ostatok-start[7 + p-num]  + round( ub.aht-stk-line.sale-discnt-base ,2)
     4655                           ostatok-start[8 + p-num]  = ostatok-start[8 + p-num]  + round( ub.aht-stk-line.crsa-sum-base ,2)
     4656                           ostatok-start[9 + p-num]  = ostatok-start[9 + p-num]  + round( ub.aht-stk-line.crsa-vat-base ,2)
     4657                           ostatok-start[10 + p-num] = ostatok-start[10 + p-num] + round( ub.aht-stk-line.crsa-slt-base ,2)
     4658                     .
     4659                end.
     4660    find last  ub.aht-stk-line where
     4661                           ub.aht-stk-line.gds-code   = gds-zap-b-code
     4662                     and   ub.aht-stk-line.fact-order <= fact-order-2
     4663                     and   ub.aht-stk-line.obj-code   = p-store-code
     4664                     and   ub.aht-stk-line.obj-type   = p-store-type
     4665                     and   ub.aht-stk-line.sum-type   = x-type-pr
     4666                           use-index category no-lock no-error.
     4667           if available ub.aht-stk-line then do:
     4668               if  tprintrubl  then
     4669                     assign
     4670                           ostatok-end[1 + p-num]  = ostatok-end[1 + p-num] + (if ub.aht-stk-line.sum-type <> "b"
     4671                                                                  then round( ub.aht-stk-line.fact-qnty,3) else 0 )
     4672                           ostatok-end[2 + p-num]  = ostatok-end[2 + p-num] + round( ub.aht-stk-line.cost-sum-rubl ,2)
     4673                           ostatok-end[3 + p-num]  = ostatok-end[3 + p-num] + round( ub.aht-stk-line.cost-vat-rubl ,2)
     4674                           ostatok-end[4 + p-num]  = ostatok-end[4 + p-num] + 0
     4675                           ostatok-end[5 + p-num]  = ostatok-end[5 + p-num] + round( ub.aht-stk-line.crsa-sum-rubl ,2)
     4676                           ostatok-end[6 + p-num]  = ostatok-end[6 + p-num] + round( ub.aht-stk-line.crsa-vat-rubl ,2)
     4677                           ostatok-end[7 + p-num]  = ostatok-end[7 + p-num] + round( ub.aht-stk-line.sale-discnt-rubl ,2)
     4678                           ostatok-end[8 + p-num]  = ostatok-end[8 + p-num] + round( ub.aht-stk-line.crsa-sum-rubl ,2)
     4679                           ostatok-end[9 + p-num]  = ostatok-end[9 + p-num] + round( ub.aht-stk-line.crsa-vat-rubl ,2)
     4680                           ostatok-end[10 + p-num] = ostatok-end[10 + p-num] + round( ub.aht-stk-line.crsa-slt-rubl ,2)
     4681                           .
     4682                 else
     4683                     assign
     4684                           ostatok-end[1 + p-num]  = ostatok-end[1 + p-num] +  (if ub.aht-stk-line.sum-type <> "b"
     4685                                                                   then round( ub.aht-stk-line.fact-qnty,3) else 0 )
     4686                           ostatok-end[2 + p-num]  = ostatok-end[2 + p-num] +  round( ub.aht-stk-line.cost-sum-base ,2)
     4687                           ostatok-end[3 + p-num]  = ostatok-end[3 + p-num] +  round( ub.aht-stk-line.cost-vat-base ,2)
     4688                           ostatok-end[4 + p-num]  = ostatok-end[4 + p-num] +  0
     4689                           ostatok-end[5 + p-num]  = ostatok-end[5 + p-num] +  round( ub.aht-stk-line.crsa-sum-base ,2)
     4690                           ostatok-end[6 + p-num]  = ostatok-end[6 + p-num] +  round( ub.aht-stk-line.crsa-vat-base ,2)
     4691                           ostatok-end[7 + p-num]  = ostatok-end[7 + p-num] +  round( ub.aht-stk-line.sale-discnt-base ,2)
     4692                           ostatok-end[8 + p-num]  = ostatok-end[8 + p-num] +  round( ub.aht-stk-line.crsa-sum-base ,2)
     4693                           ostatok-end[9 + p-num]  = ostatok-end[9 + p-num] +  round( ub.aht-stk-line.crsa-vat-base ,2)
     4694                           ostatok-end[10 + p-num] = ostatok-end[10 + p-num] + round( ub.aht-stk-line.crsa-slt-base ,2)
     4695                     .
     4696                end.
     4697   end.
     4698   end procedure.
     4699   procedure ob-line  :
     4700   do on error undo, return error return-value :
     4701   def input  parameter x-store-code     like ub.clients.obj-code         no-undo .
     4702   def input  parameter x-store-type     like ub.clients.obj-type         no-undo .
     4703   def input  parameter x-gds-code       like ub.aht-ot-line.gds-code     no-undo .
     4704   def input  parameter x-fact-order-1   like ub.aht-ot-line.fact-order   no-undo .
     4705   def input  parameter x-fact-order-2   like ub.aht-ot-line.fact-order   no-undo .
     4706   def input  parameter x-sum-type       like ub.aht-ot-line.sum-type     no-undo .
     4707   def input  parameter xtog-obj         as logical no-undo .
     4708   define variable      tt#              as integer no-undo .
     4709   define variable x-type-pr1 as character no-undo .
     4710   define variable x-type-pr2 as character no-undo .
     4711   define variable p-ok as logical   no-undo .
     4712    if x-sum-type = arh-type-cost then tt# = 0 .
     4713    if x-sum-type = arh-type-crsa then tt# = 3 .
     4714    if x-sum-type = arh-type-sale then tt# = 6 .
     4715   if  x-sum-type = "cb" then
     4716    assign
     4717       x-type-pr1 = "c"
     4718       x-type-pr2 = "b"
     4719    .
     4720   else
     4721    assign
     4722       x-type-pr1 = x-sum-type
     4723       x-type-pr2 = x-sum-type
     4724    .
     4725     for each obj-list  no-lock :
     4726        for each ub.aht-ot-line where
     4727                         ( ub.aht-ot-line.gds-code      = x-gds-code
     4728                     and   ub.aht-ot-line.fact-order   <= x-fact-order-2
     4729                     and   ub.aht-ot-line.fact-order   >= x-fact-order-1
     4730                     and   ub.aht-ot-line.obj-code     = obj-list.obj-code
     4731                     and   ub.aht-ot-line.obj-type     = obj-list.obj-type
     4732                     and   ub.aht-ot-line.sum-type     = x-type-pr1 )
     4733                     OR  ( ub.aht-ot-line.gds-code      = x-gds-code
     4734                     and   ub.aht-ot-line.fact-order   <= x-fact-order-2
     4735                     and   ub.aht-ot-line.fact-order   >= x-fact-order-1
     4736                     and   ub.aht-ot-line.obj-code     = obj-list.obj-code
     4737                     and   ub.aht-ot-line.obj-type     = obj-list.obj-type
     4738                     and   ub.aht-ot-line.sum-type     = x-type-pr2 )
     4739                     no-lock :
     4740       if  p-tpsy = true then do:
     4741           run ver-owner2
     4742           ( input  ub.aht-ot-line.gds-code,
     4743             input  ub.aht-ot-line.obj-type,
     4744             input  ub.aht-ot-line.obj-code,
     4745             output p-ok ) .
     4746       end.
     4747       case ub.aht-ot-line.ext-doc-type:
     4748                 when        'ie':U  or
     4749                 when        're':U  or
     4750                 when        'iv':U    or
     4751                 when        'rv':U or
     4752                 when        'im':U     then
     4753                 do:
     4754                 assign
     4755                        prih[1 ]   = prih[1 ]   + (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4756                        prih[2 ]   = prih[2 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4757                        prih[3 ]   = prih[3 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4758                        prih[4 ]   = prih[4 ]
     4759                        prih[5 ]   = prih[5 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4760                        prih[6 ]   = prih[6 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4761                        prih[7 ]   = prih[7 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4762                        prih[8 ]   = prih[8 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4763                        prih[9 ]   = prih[9 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4764                        gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4765                  .
     4766        if p-ok = true then do:
     4767           assign
     4768             prih[11 ]   = prih[11 ]   + (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4769             prih[12 ]   = prih[12 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4770             prih[13 ]   = prih[13 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4771             prih[14 ]   = prih[14 ]
     4772             prih[15 ]   = prih[15 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4773             prih[16 ]   = prih[16 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4774             prih[17 ]   = prih[17 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4775             prih[18 ]   = prih[18 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4776             prih[19 ]   = prih[19 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4777             .
     4778        end.
     4779                 end.
     4780                 when       'ee':U      or
     4781                 when       'ep':U    or
     4782                 when       'ev':U     or
     4783                 when       'em':U       or
     4784                 when       'wm':U       or
     4785                 when       'we':U     then
     4786                 do:
     4787                   assign
     4788                       rash[1  ]   = rash[1 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4789                       rash[2  ]   = rash[2 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4790                       rash[3 ]   = rash[3 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4791                       rash[4 ]   = rash[4 ]
     4792                       rash[5 ]   = rash[5 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4793                       rash[6 ]   = rash[6 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4794                       rash[7 ]   = rash[7 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4795                       rash[8 ]   = rash[8 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4796                       rash[9 ]   = rash[9 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4797                       gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4798                 .
     4799                   if p-ok = true then do:
     4800                     assign
     4801                       rash[11  ]   = rash[11 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4802                       rash[12  ]   = rash[12 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4803                       rash[13 ]   = rash[13 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4804                       rash[14 ]   = rash[14 ]
     4805                       rash[15 ]   = rash[15 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4806                       rash[16 ]   = rash[16 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4807                       rash[17 ]   = rash[17 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4808                       rash[18 ]   = rash[18 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4809                       rash[19 ]   = rash[19 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4810                     .
     4811                   end.
     4812                 end.
     4813                 when       'es':U  or
     4814                 when       'rs':U then
     4815                 do:
     4816                     assign
     4817                       kassa[1  ]   = kassa[1 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4818                       kassa[2  ]   = kassa[2 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4819                       kassa[3  ]   = kassa[3 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4820                       kassa[4  ]   = kassa[4 ]
     4821                       kassa[5  ]   = kassa[5 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4822                       kassa[6  ]   = kassa[6 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4823                       kassa[7  ]   = kassa[7 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4824                       kassa[8  ]   = kassa[8 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4825                       kassa[9  ]   = kassa[9 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4826                       gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4827                       .
     4828                     if p-ok = true then
     4829                     assign
     4830                       kassa[11  ]   = kassa[11 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4831                       kassa[12  ]   = kassa[12 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4832                       kassa[13  ]   = kassa[13 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4833                       kassa[14  ]   = kassa[14 ]
     4834                       kassa[15  ]   = kassa[15 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4835                       kassa[16  ]   = kassa[16 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4836                       kassa[17  ]   = kassa[17 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4837                       kassa[18  ]   = kassa[18 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4838                       kassa[19  ]   = kassa[19 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4839                       .
     4840                 end.
     4841             when       'vt':U            or
     4842             when       'pc':U or
     4843             when       'vp':U       then do:
     4844                 assign
     4845                   inv[1  ]   = inv[1 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4846                   inv[2  ]   = inv[2 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4847                   inv[3  ]   = inv[3 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4848                   inv[4  ]   = inv[4 ]
     4849                   inv[5  ]   = inv[5 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4850                   inv[6  ]   = inv[6 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4851                   inv[7  ]   = inv[7 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4852                   inv[8  ]   = inv[8 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4853                   inv[9  ]   = inv[9 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4854                   gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4855                   .
     4856                 if p-ok = true then
     4857                 assign
     4858                   inv[11  ]   = inv[11 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4859                   inv[12  ]   = inv[12 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4860                   inv[13  ]   = inv[13 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4861                   inv[14  ]   = inv[14 ]
     4862                   inv[15  ]   = inv[15 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4863                   inv[16  ]   = inv[16 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4864                   inv[17  ]   = inv[17 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4865                   inv[18  ]   = inv[18 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4866                   inv[19  ]   = inv[19 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4867                   .
     4868                 end.
     4869             when       'ot':U or
     4870             when       'ap':U then
     4871                 do:
     4872                    assign
     4873                       overturn[1  ]   = overturn[1 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4874                       overturn[2  ]   = overturn[2 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4875                       overturn[3  ]   = overturn[3 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4876                       overturn[4  ]   = overturn[4 ]
     4877                       overturn[5  ]   = overturn[5 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4878                       overturn[6  ]   = overturn[6 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4879                       overturn[7  ]   = overturn[7 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4880                       overturn[8  ]   = overturn[8 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4881                       overturn[9  ]   = overturn[9 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4882                       gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4883                       .
     4884                    if p-ok = true then
     4885                    assign
     4886                       overturn[11  ]   = overturn[11 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4887                       overturn[12  ]   = overturn[12 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4888                       overturn[13  ]   = overturn[13 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4889                       overturn[14  ]   = overturn[14 ]
     4890                       overturn[15  ]   = overturn[15 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4891                       overturn[16  ]   = overturn[16 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4892                       overturn[17  ]   = overturn[17 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4893                       overturn[18  ]   = overturn[18 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4894                       overturn[19  ]   = overturn[19 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4895                       .
     4896                 end.
     4897         end case.
     4898      end.
     4899     end.
     4900     assign
     4901       tt# = 6
     4902       overturn[1 + tt# ]   = (ostatok-end[1 + tt# ]  - ostatok-start[1 + tt# ] )  -  (inv[1 + tt# ] + prih[1 + tt# ] + kassa[1 + tt# ] + rash[1 + tt# ]  )
     4903       overturn[2 + tt# ]   = (ostatok-end[2 + tt# ]  - ostatok-start[2 + tt# ] )  -  (inv[2 + tt# ] + prih[2 + tt# ] + kassa[2 + tt# ] + rash[2 + tt# ]  )
     4904       overturn[3 + tt# ]   = (ostatok-end[3 + tt# ]  - ostatok-start[3 + tt# ] )  -  (inv[3 + tt# ] + prih[3 + tt# ] + kassa[3 + tt# ] + rash[3 + tt# ]  )
     4905     .
     4906     if p-ok = true then
     4907     assign
     4908       tt# = 6
     4909       overturn[1 + tt# ]   = (ostatok-end[1 + tt# ]  - ostatok-start[1 + tt# ] )  -  (inv[1 + tt# ] + prih[1 + tt# ] + kassa[1 + tt# ] + rash[1 + tt# ]  )
     4910       overturn[2 + tt# ]   = (ostatok-end[2 + tt# ]  - ostatok-start[2 + tt# ] )  -  (inv[2 + tt# ] + prih[2 + tt# ] + kassa[2 + tt# ] + rash[2 + tt# ]  )
     4911       overturn[3 + tt# ]   = (ostatok-end[3 + tt# ]  - ostatok-start[3 + tt# ] )  -  (inv[3 + tt# ] + prih[3 + tt# ] + kassa[3 + tt# ] + rash[3 + tt# ]  )
     4912     .
     4913   end.
     4914   end procedure.
     4915   procedure ver-owner :
     4916     do
     4917     on error undo, return error return-value
     4918     :
     4919   define input  parameter p-gds-code like ub.goods.gds-code no-undo .
     4920   define input  parameter p-db-num as integer   no-undo .
     4921   define output parameter p-ok as logical   no-undo .
     4922   define variable  p-proprietor-host-code like ub.clients.host-code no-undo .
     4923   define variable  p-proprietor-obj-type  like ub.clients.obj-type no-undo .
     4924   define variable  p-proprietor-obj-code  like ub.clients.obj-code no-undo .
     4925   p-ok = false .
     4926   if  p-tpsy = false  then return.
     4927     run tpsi-gds-proprietor (
     4928         input  p-gds-code             ,
     4929         input  p-db-num               ,
     4930         output p-proprietor-host-code ,
     4931         output p-proprietor-obj-type  ,
     4932         output p-proprietor-obj-code )  .
     4933    if p-proprietor-host-code = v-cntxt-host-code-obj then p-ok = true  .
     4934   end.
     4935   end procedure.
     4936   procedure ver-owner2 :
     4937     do
     4938     on error undo, return error return-value
     4939     :
     4940   define input  parameter p-gds-code like ub.goods.gds-code no-undo .
     4941   define input  parameter p-obj-type  like ub.clients.obj-type no-undo .
     4942   define input  parameter p-obj-code  like ub.clients.obj-code no-undo .
     4943   define output parameter p-ok as logical   no-undo .
     4944   define variable  p-proprietor-host-code like ub.clients.host-code no-undo .
     4945   define variable  p-proprietor-obj-type  like ub.clients.obj-type no-undo .
     4946   define variable  p-proprietor-obj-code  like ub.clients.obj-code no-undo .
     4947   p-ok = false .
     4948   if  p-tpsy = false  then return.
     4949   define buffer buf_obj-list for obj-list.
     4950   find first buf_obj-list where
     4951         buf_obj-list.obj-type = p-obj-type and
     4952         buf_obj-list.obj-code = p-obj-code
     4953         no-error .
     4954   if error-status :error then return .
     4955     run tpsi-gds-proprietor (
     4956         input  p-gds-code             ,
     4957         input  buf_obj-list.db-num     ,
     4958         output p-proprietor-host-code ,
     4959         output p-proprietor-obj-type  ,
     4960         output p-proprietor-obj-code )  .
     4961    if p-proprietor-host-code = v-cntxt-host-code-obj then p-ok = true  .
     4962   end.
     4963   end procedure.
