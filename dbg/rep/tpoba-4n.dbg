     4067   procedure di :
     4068   def input parameter p1 as char no-undo.
     4069   def input parameter p2 as int no-undo.
     4070   def input parameter p3 as char no-undo.
     4071   def input parameter p4 as char no-undo.
     4072   def input parameter p5 as char no-undo.
     4073   def input parameter p6 as char no-undo.
     4074   def input parameter p7 as char no-undo.
     4075    case caps(p7) :
     4076      when "b1":u  then do:
     4077       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     4078         p3 @ s-bar-code
     4079         p4 @ gds-zap-artic
     4080         p5 @ gds-zap-gds-name
     4081         p6 @ gds-zap-unit-base
     4082         p1 @ gds-type
     4083         b1-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     4084         b1-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     4085         b1-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     4086         b1-KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     4087         b1-Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     4088         b1-Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     4089         b1-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     4090         b1-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     4091         with FRAME ZAPAS .
     4092                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     4093                   end.
     4094      when "b2":u  then  do:
     4095       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     4096         p3 @ s-bar-code
     4097         p4 @ gds-zap-artic
     4098         p5 @ gds-zap-gds-name
     4099         p6 @ gds-zap-unit-base
     4100         p1 @ gds-type
     4101         b2-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     4102         b2-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     4103         b2-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     4104         b2-KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     4105         b2-Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     4106         b2-Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     4107         b2-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     4108         b2-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     4109         with FRAME ZAPAS .
     4110                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     4111                 end.
     4112      when "bi":u then  do:
     4113       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     4114         p3 @ s-bar-code
     4115         p4 @ gds-zap-artic
     4116         p5 @ gds-zap-gds-name
     4117         p6 @ gds-zap-unit-base
     4118         p1 @ gds-type
     4119         bi-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     4120         bi-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     4121         bi-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     4122         bi-KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     4123         bi-Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     4124         bi-Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     4125         bi-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     4126         bi-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     4127         with FRAME ZAPAS .
     4128                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     4129                 end.
     4130      when "bo":u then  do:
     4131       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     4132         p3 @ s-bar-code
     4133         p4 @ gds-zap-artic
     4134         p5 @ gds-zap-gds-name
     4135         p6 @ gds-zap-unit-base
     4136         p1 @ gds-type
     4137         bo-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     4138         bo-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     4139         bo-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     4140         bo-KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     4141         bo-Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     4142         bo-Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     4143         bo-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     4144         bo-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     4145         with FRAME ZAPAS .
     4146                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     4147                 end.
     4148      when ""  then  do:
     4149       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     4150         p3 @ s-bar-code
     4151         p4 @ gds-zap-artic
     4152         p5 @ gds-zap-gds-name
     4153         p6 @ gds-zap-unit-base
     4154         p1 @ gds-type
     4155         ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     4156         Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     4157         RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     4158         KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     4159         Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     4160         Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     4161         Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     4162         gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     4163         with FRAME ZAPAS .
     4164                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     4165                 end.
     4166      end case.
     4167    end procedure.
     4168   procedure di-qnty :
     4169   def input parameter p1 as char no-undo.
     4170   def input parameter p2 as int no-undo.
     4171   def input parameter p3 as char no-undo.
     4172   def input parameter p4 as char no-undo.
     4173   def input parameter p5 as char no-undo.
     4174   def input parameter p6 as char no-undo.
     4175   def input parameter p7 as char no-undo.
     4176    case caps(p7) :
     4177      when "b1":u  then do :
     4178       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     4179         p3 @ s-bar-code
     4180         p4 @ gds-zap-artic
     4181         p5 @ gds-zap-gds-name
     4182         p6 @ gds-zap-unit-base
     4183         p1 @ gds-type
     4184         b1-ostatok-start [p2] format "->>>>>>>>>>9.<<<" @  F-ostatok-start
     4185         b1-Prih          [p2] format "->>>>>>>>>>9.<<<" @  F-Prih
     4186         b1-RAsh          [p2] format "->>>>>>>>>>9.<<<" @  F-RAsh
     4187         b1-KAssa         [p2] format "->>>>>>>>>>9.<<<" @  F-KAssa
     4188         b1-Inv           [p2] format "->>>>>>>>>>9.<<<" @  F-Inv
     4189         b1-Overturn      [p2] format "->>>>>>>>>>9.<<<" @  F-Overturn
     4190         b1-Ostatok-end   [p2] format "->>>>>>>>>>9.<<<" @  F-Ostatok-end
     4191         b1-gds-zap-other      format "->>>>>>>>>>9.<<<" when (p2 = 1) @  gds-zap-other
     4192         with FRAME ZAPAS .
     4193                 if num-entries(g1, "|") = 2 then assign  g1 =  "" .
     4194                 p6 = "" .
     4195                 gds-zap-type = "" .
     4196    if  p2 > 10  then f_e = 10 .
     4197                 else f_e =  0 .
     4198   if Make-Excel then  put   stream ForExcel unformatted
     4199     p3 CHR(9)
     4200     p4 CHR(9)
     4201     if f_e = 0 then g1 else p5 CHR(9)
