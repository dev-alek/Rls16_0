     3851   procedure item-goods :
     3852      def input parameter  par-3 as char no-undo.
     3853      def input parameter  par-4 as char no-undo.
     3854        if par-4 = "goods":u  then do:
     3855           assign
     3856               gds-zap-unit-base  = goods.unit-base
     3857               gds-zap-prt-root   = goods.prt-root
     3858               gds-zap-prod-type  = goods.prod-type
