     3711           if xshowcost    then do: run di ("учет.", 12, "","", "", "", "b2":u).  end.
     3712           if xshowcrsa    then do: run di ("прод.", 15 ,"","", "", "", "b2":u).  end.
     3713           if xshowsale    then do: run di ("док.", 18 ,"","", "", "", "b2":u).  end.
     3714            if vat-cost    then do: run di ( "уч.НДС", 13,"","","","","b2":u ). end.
     3715            if vat-crsa    then do: run di ( "пр.НДС", 16,"","","","","b2":u ).  end.
     3716            if vat-sale    then do: run di ( "дк.НДС", 19,"","","","","b2":u ).  end.
     3717      end.
     3718    end.
     3719   end.
     3720   end procedure.
     3721   procedure clear-b1  :
     3722    b1-gds-zap-other           = 0.
     3723    repeat kk = 1 to 20 :
     3724    assign
