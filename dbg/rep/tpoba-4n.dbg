     3629   procedure display-b1  :
     3630         if not( not show-negativ-2 and
     3631            ( b1-prih          [1]   = 0 and
     3632              b1-rash          [1]   = 0 and
     3633              b1-kassa         [1]   = 0 and
     3634              b1-inv           [1]   = 0 and
     3635              b1-overturn      [1]   = 0 and
     3636              b1-overturn      [5]   = 0 and
     3637              b1-overturn      [8]   = 0 ) ) then do:
     3638           if  not (not show-negativ  and (
     3639                 b1-prih          [1]   = 0 and
     3640                 b1-rash          [1]   = 0 and
     3641                 b1-kassa         [1]   = 0 and
     3642                 b1-inv           [1]   = 0 and
     3643                 b1-overturn      [1]   = 0 and
     3644                 b1-overturn      [5]   = 0 and
     3645                 b1-ostatok-start [1]   = 0 and
     3646                 b1-ostatok-end   [1]   = 0   )) then do:
     3647                 if sums-only then do:
     3648                     if fr0 = true then do:
     3649                         put stream  outstream  tmp#stroka0 format "x(100)" skip.
     3650                         if Make-Excel then  put   stream ForExcel unformatted string(tmp#stroka0) skip.
     3651                         fr0 = false .
     3652                       end.
     3653                  end.
     3654      if p-tpsy = no  or ( p-tpsy = true and  p-type-tpsy-goods = 2 ) then do:
     3655           run di-qnty in this-procedure ("кол-во"  ,1, s-bar-code, gds-zap-artic, gds-zap-gds-name  ,"","b1":u).
     3656           if xshowcost    then do: run di in this-procedure ("учет." ,2 ,"","", "", "", "b1":u).  end.
     3657           if xshowcrsa    then do: run di in this-procedure ("прод." , 5, "","", "", "", "b1":u).  end.
     3658           if xshowsale    then do: run di in this-procedure ("док." , 8, "","", "", "", "b1":u).  end.
     3659           if vat-cost    then do: run di in this-procedure ( "уч.НДС", 3,"","","","","b1":u ). end.
     3660           if vat-crsa    then do: run di in this-procedure ( "пр.НДС", 6,"","","","","b1":u ).  end.
     3661           if vat-sale    then do: run di in this-procedure ( "дк.НДС", 9,"","","","","b1":u ).  end.
     3662      end.
     3663      if p-tpsy = true  then do:
     3664            if  p-type-tpsy-goods = 3 then
     3665                run di-qnty ("кол-во"  ,11, s-bar-code, gds-zap-artic, gds-zap-gds-name  ,"","b1":u).
     3666            else
     3667               run di-qnty in this-procedure ("кол-во"  ,11, "","", str_svoi, "","b1":u).
     3668           if xshowcost    then do: run di in this-procedure ("учет." ,12 ,"","", "", "", "b1":u).  end.
     3669           if xshowcrsa    then do: run di in this-procedure ("прод." ,15, "","", "", "", "b1":u).  end.
     3670           if xshowsale    then do: run di in this-procedure ("док." , 18, "","", "", "", "b1":u).  end.
     3671           if vat-cost    then do: run di in this-procedure ( "уч.НДС", 13,"","","","","b1":u ). end.
     3672           if vat-crsa    then do: run di in this-procedure ( "пр.НДС", 16,"","","","","b1":u ).  end.
     3673           if vat-sale    then do: run di in this-procedure ( "дк.НДС", 19,"","","","","b1":u ).  end.
     3674      end.
     3675          if not sums-only then run p-line.
     3676    end.
     3677    end.
     3678   end procedure.
