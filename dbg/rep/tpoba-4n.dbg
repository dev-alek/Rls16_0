     3895            FIND FIRST clients WHERE clients.obj-type = gds-zap-prod-type AND clients.obj-code = gds-zap-prod-code use-index pi NO-LOCK .
     3896            gds-zap-prod-name  = clients.obj-name.
     3897             If break_group1 = true  THEN  DO :
     3898               if (par-3 = "3"  OR  par-3 = "5" ) and  par-3 <> "6"
     3899                 then DO: Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )         b1-name = gds-zap-grp-name . end.
     3900                 else DO: Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) b1-name = gds-zap-prod-name. end.
     3901               if par-3 = "6"  then  dO:
     3902                  if xTog-obj = true then do:
     3903                    var-vat-pc = func-vat (input gds-zap-b-code , input x-store-type, input x-store-code)
     3904                     .
     3905                   end.
     3906                  else do:
     3907                   var-vat-pc = temp-gds-list.vat-pc .
     3908                   end.
     3909                   assign
     3910                       temp-str = string( "СТАВКА НДС : " + string(var-vat-pc) + "%" )
     3911                       b1-name = temp-str.
     3912                   end.
     3913               if NOT xSumsOnly or (par-3 = "4" Or par-3 = "5" ) THEN DO :
     3914                   fr0 = true .
     3915                   tmp#stroka0 = temp-str.
     3916               End.
     3917             End.
     3918               IF (par-3 = "4"  OR  par-3 = "5")  THEN DO:
     3919                 if par-3 = "4"
     3920                   then Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )          b2-name = gds-zap-grp-name .
