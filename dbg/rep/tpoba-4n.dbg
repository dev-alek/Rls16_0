     3487   BY (substring(clients.obj-name,1,10) + string(gds-list.prod-code))
     3488   BY (temp-gds-list.grp-name)
     3489       BY gds-list.artic :
     3490       run item-goods ( "4" , "gds-list" ) .
     3491         if return-value <> "" then NEXT.
     3492           If Last-of(temp-gds-list.grp-name) Then Do:
     3493           If String(Entry(2,"temp-gds-list.grp-name",".")) = "Grp-name"
     3494             Then  Assign
     3495                     S-bar-code   = " Итого по "
     3496                     Gds-zap-artic = Substring(
     3497                                          B2-name
     3498                                         ,1,16)
     3499                     Gds-zap-gds-name = Substring(
     3500                                          B2-name
     3501                                         ,17,40)
     3502                                   .
     3503             Else  Assign
     3504                     S-bar-code   = ""
     3505                     Gds-zap-artic = "        Итого по "
     3506                     Gds-zap-gds-name =   B2-name
     3507                                   .
     3508               Run Display-b1 In This-procedure .
     3509               Run Clear-b1 In This-procedure .
     3510               Assign Break_Group = True.
     3511           End.
     3512           If Last-of((substring(clients.obj-name,1,10) + string(gds-list.prod-code))) Then Do:
     3513           If String(Entry(2,"(substring(clients.obj-name,1,10) + string(gds-list.prod-code))",".")) = "Grp-name"
     3514             Then  Assign
     3515                 S-bar-code   = "Итого по "
     3516                 Gds-zap-artic = Substring(
     3517                                      B1-name
     3518                                     ,1,16)
     3519                 Gds-zap-gds-name = Substring(
     3520                                      B1-name
     3521                                     ,17,40)
     3522                               .
     3523             Else Assign
     3524                 S-bar-code = ""
     3525                 Gds-zap-artic = If  ("4" = "4"  Or  "4" = "5") Then "Итого по "
     3526                                                                    Else "  Итого по "
     3527                 Gds-zap-gds-name =   B1-name
     3528                 .
     3529             Run Display-b2 In This-procedure .
     3530             Run Clear-b2 In This-procedure .
     3531             Run Clear-b1 In This-procedure .
     3532             Assign  Break_Group1 = True.
     3533           End.
     3534     End.
     3535   End.
     3536            end.
     3537         end case.
     3538   end procedure.
     3539   procedure calcitog :
     3540       run aht-ostatok (
     3541           input x-store-code     ,
     3542           input x-store-type     ,
     3543           input x-tog-shift      ,
     3544           input x-date-start - 1 ,
     3545           input date('')         ,
     3546           input x-shift-start    ,
     3547           input x-shift-end      ,
     3548           input "n"    ,
     3549           input xtog-obj         ,
     3550           output  fact-order-1 ) .
     3551       run aht-ostatok (
     3552           input x-store-code  ,
     3553           input x-store-type  , x-tog-shift,
     3554           input x-date-start  ,
     3555           input x-date-end    , x-shift-start,x-shift-end,
     3556           input "n" ,
     3557           input xtog-obj ,
     3558           output  fact-order-2 ).
     3559   end procedure.
     3560   procedure display-str1  :
     3561      if p-tpsy = no  or ( p-tpsy = true and  p-type-tpsy-goods = 2 ) then do:
     3562            run di-qnty ("кол-во", 1, s-bar-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     3563            if xshowcost   then do: run di ( "учет." , 2,"","","","","" ). end.
     3564            if xshowcrsa   then do: run di ( "прод." , 5,"","","","","" ). end.
     3565            if xshowsale   then do: run di ( "док."  , 8,"","","","","" ). end.
     3566            if vat-cost    then do: run di ( "уч.НДС", 3,"","","","","" ). end.
     3567            if vat-crsa    then do: run di ( "пр.НДС", 6,"","","","","" ). end.
     3568            if vat-sale    then do: run di ( "дк.НДС", 9,"","","","","" ). end.
     3569      end.
     3570      if p-tpsy = true  then do:
     3571            if  p-type-tpsy-goods = 3 then
     3572                run di-qnty ("кол-во", 11, s-bar-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     3573            else
     3574               run di-qnty ("кол-во", 11, "","",str_svoi,"","").
     3575            if xshowcost   then do: run di ( "учет." , 12,"","","","","" ). end.
     3576            if xshowcrsa   then do: run di ( "прод." , 15,"","","","","" ). end.
     3577            if xshowsale   then do: run di ( "док."  , 18,"","","","","" ). end.
     3578            if vat-cost    then do: run di ( "уч.НДС", 13,"","","","","" ). end.
     3579            if vat-crsa    then do: run di ( "пр.НДС", 16,"","","","","" ). end.
     3580            if vat-sale    then do: run di ( "дк.НДС", 19,"","","","","" ). end.
     3581      end.
     3582   end procedure.
