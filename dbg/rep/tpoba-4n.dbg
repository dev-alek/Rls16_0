     3864           if g#gds-engl then
     3865               assign gds-zap-gds-name = goods.engl-name.
     3866           else
     3867               assign gds-zap-gds-name = goods.gds-name.
     3868        end.
     3869        if par-4 = "gds-list":u  then do:
     3870           assign
