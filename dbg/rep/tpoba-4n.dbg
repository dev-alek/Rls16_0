     3883        end.
     3884       define variable old-gds-zap-gds-name as character no-undo .
     3885       old-gds-zap-gds-name = gds-zap-gds-name.
     3886       x-type-pr = "r".
     3887       run foreach.
     3888   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3889     (input  gds-zap-b-code
     3890     ,input  ?
     3891     ,output v-bar-code
     3892     )  .
     3893   s-bar-code = string (v-bar-code,"999999999").
