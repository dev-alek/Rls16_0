     3696                 b2-ostatok-end   [1]   = 0   )) then do:
     3697      if p-tpsy = no  or ( p-tpsy = true and  p-type-tpsy-goods = 2 ) then do:
     3698           run di-qnty( "кол-во", 1 ,s-bar-code,gds-zap-artic, gds-zap-gds-name,"", "b2":u).
     3699           if xshowcost    then do: run di ("учет.", 2, "","", "", "", "b2":u).  end.
     3700           if xshowcrsa    then do: run di ("прод.", 5 ,"","", "", "", "b2":u).  end.
     3701           if xshowsale    then do: run di ("док.", 8 ,"","", "", "", "b2":u).  end.
     3702            if vat-cost    then do: run di ( "уч.НДС", 3,"","","","","b2":u ). end.
     3703            if vat-crsa    then do: run di ( "пр.НДС", 6,"","","","","b2":u ).  end.
     3704            if vat-sale    then do: run di ( "дк.НДС", 9,"","","","","b2":u ).  end.
