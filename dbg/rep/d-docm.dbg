     6117   PROCEDURE create-menu-items2 :
     6118   define input parameter p-doc-code       as character        no-undo.
     6119   define input parameter p-doc-type       as character        no-undo.
     6120   define input parameter p-ext-doc-type   as character        no-undo.
     6121   define input parameter p-status_        as character        no-undo.
     6122   define input parameter p-Internal       as character        no-undo.
     6123   define input parameter p-flag_          as character        no-undo.
     6124       define variable xtype        as character    no-undo.
     6125       define variable xstatus      as character    no-undo.
     6126       define variable xInternal    as character    no-undo.
     6127       define variable xflag        as character    no-undo.
     6128   do
     6129   on error undo, return error
     6130   :
     6131       if p-doc-type <> 'инв':U
     6132       then do:
     6133           assign
     6134               xtype = p-doc-type
     6135           .
     6136       end.
     6137       else do:
     6138           assign
     6139               xtype = p-ext-doc-type
     6140           .
     6141       end.
     6142       assign
     6143           xstatus             = string( p-status_  )
     6144           xInternal           = string( p-Internal )
     6145           xflag               = string( p-flag_    )
     6146       .
     6147       assign
     6148           v-menu-doc-doc-code     = p-doc-code
     6149           v-menu-doc-doc-type     = xtype
     6150           v-menu-doc-ext-doc-type = p-ext-doc-type
     6151           v-menu-doc-status_      = xstatus
     6152           v-menu-doc-internal     = xInternal
     6153           v-menu-doc-flag         = xflag
     6154       .
     6155   define variable vss-include-info195 as character format "X(65)" no-undo
     6156   initial "@(#)$Workfile$ $Revision$".
     6157   define variable is-ptrl  as character no-undo .
     6158   define variable is-jwlr  as character no-undo .
     6159   define variable par-type as character no-undo .
     6160     define variable v-value-character as character no-undo .
     6161     define variable v-value-date      as date no-undo .
     6162     define variable v-value-decimal   as decimal no-undo .
     6163     define variable v-value-integer   as integer no-undo .
     6164     define variable v-tth             as handle no-undo .
     6165     define variable v-type            as character no-undo .
     6166     define VARIABLE v-izlish        as logical    no-undo .
     6167   run gbl/conf-rd.p ("is-ptrl", "", "", 0, "", "", "", no, output is-ptrl, output par-type) no-error.
     6168   if error-status :error
     6169     or par-type <> "l"
     6170     or is-ptrl  <> "yes"
     6171   then do:
     6172     assign is-ptrl = "no".
     6173   end.
     6174   run gbl/conf-rd.p ("is-jwlr", "", "", 0, "", "", "", no, output is-jwlr, output par-type) no-error.
     6175   if error-status :error
     6176     or par-type <> "l"
     6177     or is-jwlr  <> "yes"
     6178   then do:
     6179     assign is-jwlr = "no".
     6180   end.
