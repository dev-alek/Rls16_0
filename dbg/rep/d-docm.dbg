        1   define temp-table temp_trn-doc-code no-undo
        2       field doc-code as character
        3       index pi is primary unique doc-code
        4   .
        5   define input parameter p-mainmenu-handle    as handle           no-undo.
        6   define input parameter p-alldocs-handle     as handle           no-undo.
        7   define input parameter table for temp_trn-doc-code .
        8   define variable vss-revision    as character no-undo init "$Revision$":U .
        9   define variable vss-author      as character no-undo init "$Author$":U .
       10   define variable vss-date        as character no-undo init "$Date$":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       12   define variable vss-archive     as character no-undo init "$Archive$":U .
       13   define variable vss-description as character no-undo init "Список печатных форм для печати документов.".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   procedure proc-alt-shift-f2:
       73     if not ibs.th.gbl.gbl-var:rcode
       74   then
       75     run gbl\inidebug.p .
       76   end.
       77   procedure proc-alt-shift-f3:
       78     run gbl/prvssinf.p
       79       ( input this-procedure
       80       ) .
       81   end.
       82   define variable v-inform-launched as logical no-undo initial false .
       83   procedure proc-alt-shift-f4:
       84     define variable v-action as character no-undo .
       85     if v-inform-launched = false then do:
       86       assign
       87         v-inform-launched = true
       88       .
       89       run gbl/d-inform.w
       90         (  input self
       91         ,  input this-procedure
       92         , output v-action
       93         ) no-error .
       94       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       95       assign
       96         v-inform-launched = false
       97       .
       98     end.
       99   end.
      100   procedure proc-alt-f1:
      101     run gbl/corrhelp.p
      102       (input this-procedure
      103       ) .
      104   end .
      105   on alt-shift-f2 anywhere do:
      106     run proc-alt-shift-f2.
      107   end.
      108   on alt-shift-f3 anywhere do:
      109     run proc-alt-shift-f3 in this-procedure .
      110   end.
      111   on alt-shift-f4 anywhere do:
      112     run proc-alt-shift-f4 in this-procedure.
      113   end.
      114   on alt-f1 anywhere do:
      115     run proc-alt-f1 in this-procedure .
      116   end.
      117   define new global shared variable g#library  as handle no-undo .
      118   define new global shared variable g#library2 as handle no-undo .
      119   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      120   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      121   define new shared variable RepPathName        as character no-undo .
      122   define new shared variable PrintRubl          as logical   no-undo .
      123   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      124   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      125   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      126   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      127   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      128   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      129   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      130   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      131   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      132   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      133   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      134   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      135   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      136   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      137   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      138   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      139   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      140   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      141   define variable vss-include-info2 as character format "X(65)" no-undo
      142   initial "@(#)$Workfile$ $Revision$".
      143       define temp-table Tmp#List no-undo like ub.ord-blank
      144           field id                        as integer
      145           field proc-name                 as character
      146           field proc-param                as character
      147           field print-options             as character
      148           field orient                    as character
      149           field orient-orientation        as character
      150           field orient-font-num           as integer
      151           field font-num                  as character
      152           field filtr                     as character
      153           field view_                     as integer  init 1
      154           field sys-key                   as character
      155           field sys-key-black             as character
      156           field type-parts                as character
      157           field type-parts-enabled        as logical
      158           field type-price                as character
      159           field type-price-enabled        as logical
      160           field type-scale                as character
      161           field type-scale-enabled        as logical
      162           field type-val                  as character
      163           field type-val-enabled          as logical
      164           field sort-name                 as character
      165           field sort-name-enabled         as logical
      166           field sort-gr                   as character
      167           field sort-gr-enabled           as logical
      168           field print-graft               as character
      169           field print-graft-enabled       as logical
      170           field no-vat                    as character
      171           field no-vat-enabled            as logical
      172           index pi is primary unique id
      173           index in-name
      174              blank-name
      175           index lu
      176               last-use
      177       .
      178       define temp-table temp_form-list no-undo
      179           field doc-code  as character
      180           field id        as integer
      181           field doc-type  as character
      182           field status_   as character
      183           field internal  as character
      184           field flag      as character
      185           index pi is primary unique
      186               doc-code
      187               id
      188           index idx
      189               id
      190       .
      191       define temp-table temp_menu-doc_disabled-doc-list no-undo
      192           field doc-code      as character
      193           field blank-name    as character
      194           field reason        as character
      195           index pi is primary unique
      196                   doc-code
      197                   blank-name
      198       .
      199       define variable v-menu-doc-sys-key              as character    no-undo.
      200       define variable v-menu-doc-doc-code             as character    no-undo.
      201       define variable v-menu-doc-doc-type             as character    no-undo.
      202       define variable v-menu-doc-ext-doc-type         as character    no-undo.
      203       define variable v-menu-doc-status_              as character    no-undo.
      204       define variable v-menu-doc-internal             as character    no-undo.
      205       define variable v-menu-doc-flag                 as character    no-undo.
      206       define variable v-menu-doc-item-counter         as integer      no-undo.
      207       define variable v-menu-doc-item-disabled        as logical      no-undo.
      208   define variable vss-include-info3 as character format "X(65)":U no-undo initial "@(#)$Workfile$ $Revision$".
      209   function check-entry-with-mask returns logical ( input p-element as character, input p-list as character, input p-delimiter as character ) :
      210     define variable p-entry   as logical   no-undo .
      211     define variable v-ind as integer   no-undo .
      212     if p-delimiter = "*":U then do:
      213       message
      214         vss-workfile "(check-entry-with-mask)" vss-revision vss-description skip
      215         substitute('Разделитель не может быть равный "&1"', p-delimiter ) skip
      216         view-as alert-box error .
      217       return ? .
      218     end.
      219     assign
      220       p-entry = true
      221     .
      222     if lookup( p-element, p-list, p-delimiter ) = 0 then do:
      223       assign
      224         p-entry = false
      225       .
      226       if num-entries( p-list, "*":U ) > 1 then do:
      227         block_check-list:
      228         do v-ind = 1 to num-entries( p-list, p-delimiter )
      229         :
      230           if p-element matches entry( v-ind, p-list, p-delimiter ) then do:
      231             assign
      232               p-entry = true
      233             .
      234             leave block_check-list .
      235           end.
      236         end.
      237       end.
      238     end.
      239     return p-entry .
      240   end function .
      241       procedure menu-doc-create-menu-item
      242       :
      243       define input parameter p-type   as   character no-undo.
      244       define input parameter p-stat   as   character no-undo.
      245       define input parameter p-intr   as   character no-undo.
      246       define input parameter p-flag   as   character no-undo.
      247       define input parameter param-1  as   character no-undo.
      248       define input parameter param-2  as   character no-undo.
      249       define input parameter param-3  as   character no-undo.
      250       define input parameter param-4  as   character no-undo.
      251       define input parameter param-5  as   character no-undo.
      252       define input parameter param-6  as   character no-undo.
      253       define input parameter param-7  as   character no-undo.
      254       define input parameter param-8  as   character no-undo.
      255       define input parameter param-9  as   character no-undo.
      256       define input parameter param-10 as   character no-undo.
      257       define input parameter param-11 as   character no-undo.
      258       define input parameter param-12 as   character no-undo.
      259       do
      260       on error undo, return error
      261       :
      262           assign
      263               v-menu-doc-item-disabled = yes
      264           .
      265           if v-menu-doc-sys-key <> 'ExpertekIBS':U
      266           and ( ( param-10 <> "":U
      267                   and check-entry-with-mask( v-menu-doc-sys-key, param-10, chr(44) ) = false
      268                 )
      269                 or ( param-12 <> "":U
      270                      and check-entry-with-mask( v-menu-doc-sys-key, param-12, chr(44) ) = true )
      271                    )
      272           then do:
      273               undo, return .
      274           end.
      275           if param-7 = "":U
      276           then do:
      277               undo, return .
      278           end.
      279           if param-1 = '*':U
      280           or lookup( p-type, param-1 ) > 0
      281           then do:
      282               if param-2 = '*':U
      283               or lookup( p-stat, param-2 ) > 0
      284               then do:
      285                   if param-3 = '*':U
      286                   or lookup( p-intr, param-3 ) > 0
      287                   then do:
      288                       if param-4 = '*':U
      289                       or lookup( p-flag, param-4 ) > 0
      290                       then do:
      291                           assign
      292                               v-menu-doc-item-disabled = no
      293                           .
      294                           find first tmp#list
      295                                where tmp#list.blank-name     = param-5
      296                                  and tmp#list.filtr          = param-6
      297                                  and tmp#list.proc-name      = param-7
      298                                  and tmp#list.proc-param     = param-8
      299                                  and tmp#list.print-options  = param-9
      300                                  and tmp#list.sys-key        = param-10
      301                                  and tmp#list.orient         = param-11
      302                                  and tmp#list.sys-key-black  = param-12
      303                           no-error.
      304                           if not available tmp#list
      305                           then do:
      306                               assign
      307                                   v-menu-doc-item-counter = v-menu-doc-item-counter + 1
      308                               .
      309                               create tmp#list.
      310                               assign
      311                                   tmp#list.id             = v-menu-doc-item-counter
      312                                   tmp#list.cli-code       = v-menu-doc-item-counter
      313                                   tmp#list.blank-name     = param-5
      314                                   tmp#list.filtr          = param-6
      315                                   tmp#list.proc-name      = param-7
      316                                   tmp#list.proc-param     = param-8
      317                                   tmp#list.print-options  = param-9
      318                                   tmp#list.sys-key        = param-10
      319                                   tmp#list.orient         = param-11
      320                                   tmp#list.sys-key-black  = param-12
      321                               .
      322                               assign
      323                                   tmp#list.orient-orientation     = entry( 1, tmp#list.orient )
      324                                   tmp#list.orient-font-num        = 7
      325                               .
      326                               assign
      327                                   tmp#list.orient-font-num      = ( if num-entries( tmp#list.orient ) > 1
      328                                                                     then integer( entry( 2, tmp#list.orient ) )
      329                                                                     else 7 )
      330                               no-error.
      331                               if error-status :error
      332                               then do:
      333                                   assign
      334                                       tmp#list.orient-font-num = 7
      335                                   .
      336                               end.
      337                               run menu-doc-set-visible-options in this-procedure (
      338                                     input tmp#list.print-options
      339                                   , output tmp#list.type-parts-enabled
      340                                   , output tmp#list.type-price-enabled
      341                                   , output tmp#list.type-scale-enabled
      342                                   , output tmp#list.type-val-enabled
      343                                   , output tmp#list.sort-name-enabled
      344                                   , output tmp#list.sort-gr-enabled
      345                                   , output tmp#list.print-graft-enabled
      346                                   , output tmp#list.no-vat-enabled
      347                               ).
      348                           end.
      349                       end.
      350                   end.
      351               end.
      352           end.
      353           if v-menu-doc-item-disabled = yes
      354           then do:
      355               find first tmp#list
      356                    where tmp#list.blank-name     = param-5
      357                      and tmp#list.filtr          = param-6
      358                      and tmp#list.proc-name      = param-7
      359                      and tmp#list.proc-param     = param-8
      360                      and tmp#list.print-options  = param-9
      361                      and tmp#list.sys-key        = param-10
      362                      and tmp#list.orient         = param-11
      363                      and tmp#list.sys-key-black  = param-12
      364               no-error.
      365               if available tmp#list
      366               then do:
      367                   find first temp_menu-doc_disabled-doc-list
      368                        where temp_menu-doc_disabled-doc-list.doc-code     = v-menu-doc-doc-code
      369                          and temp_menu-doc_disabled-doc-list.blank-name   = param-5
      370                   no-error.
      371                   if not available temp_menu-doc_disabled-doc-list
      372                   then do:
      373                       create temp_menu-doc_disabled-doc-list.
      374                       assign
      375                           temp_menu-doc_disabled-doc-list.doc-code    = v-menu-doc-doc-code
      376                           temp_menu-doc_disabled-doc-list.blank-name  = param-5
      377                       .
      378                   end.
      379                   if param-1 <> '*':U
      380                   and lookup( p-type, param-1 ) > 0
      381                   then do:
      382                       assign
      383                           temp_menu-doc_disabled-doc-list.reason   = "type":U
      384                       .
      385                   end.
      386                   assign
      387                       temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + ",":U
      388                   .
      389                   if param-2 <> '*':U
      390                   and lookup( p-stat, param-2 ) > 0
      391                   then do:
      392                       assign
      393                           temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + "stat":U
      394                       .
      395                   end.
      396                   assign
      397                       temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + ",":U
      398                   .
      399                   if param-3 <> '*':U
      400                   and lookup( p-intr, param-3 ) > 0
      401                   then do:
      402                       assign
      403                           temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + "intr":U
      404                       .
      405                   end.
      406                   assign
      407                       temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + ",":U
      408                   .
      409                   if param-4 <> '*':U
      410                   and lookup( p-flag, param-4 ) > 0
      411                   then do:
      412                       assign
      413                           temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + "flag":U
      414                       .
      415                   end.
      416                   if v-menu-doc-sys-key = 'ExpertekIBS':U
      417                   then do:
      418                       run menu-doc-extend-blank-name-for-IBS in this-procedure (
      419                             input tmp#list.blank-name
      420                           , input tmp#list.sys-key
      421                           , input Tmp#List.sys-key-black
      422                           , output tmp#list.blank-name
      423                       ).
      424                   end.
      425               end.
      426               else do:
      427                   assign
      428                       v-menu-doc-item-disabled = no
      429                   .
      430               end.
      431           end.
      432           if v-menu-doc-item-disabled = no
      433           then do:
      434               find first tmp#list
      435                    where tmp#list.blank-name     = param-5
      436                      and tmp#list.filtr          = param-6
      437                      and tmp#list.proc-name      = param-7
      438                      and tmp#list.proc-param     = param-8
      439                      and tmp#list.print-options  = param-9
      440                      and tmp#list.sys-key        = param-10
      441                      and tmp#list.orient         = param-11
      442                      and tmp#list.sys-key-black  = param-12
      443               no-error.
      444               if available tmp#list
      445               then do:
      446                   find first temp_form-list
      447                        where temp_form-list.doc-code  = v-menu-doc-doc-code
      448                          and temp_form-list.id        = tmp#list.id
      449                   no-error.
      450                   if not available temp_form-list
      451                   then do:
      452                       create temp_form-list.
      453                       assign
      454                           temp_form-list.doc-code  = v-menu-doc-doc-code
      455                           temp_form-list.id        = tmp#list.id
      456                           temp_form-list.doc-type  = v-menu-doc-doc-type
      457                           temp_form-list.status_   = v-menu-doc-status_
      458                           temp_form-list.internal  = v-menu-doc-internal
      459                           temp_form-list.flag      = v-menu-doc-flag
      460                       .
      461                   end.
      462                   if v-menu-doc-sys-key = 'ExpertekIBS':U
      463                   then do:
      464                       run menu-doc-extend-blank-name-for-IBS in this-procedure (
      465                             input tmp#list.blank-name
      466                           , input tmp#list.sys-key
      467                           , input Tmp#List.sys-key-black
      468                           , output tmp#list.blank-name
      469                       ).
      470                   end.
      471               end.
      472           end.
      473       end.
      474       end procedure.
      475       procedure menu-doc-set-visible-options :
      476       define input parameter p-print-options          as character        no-undo.
      477       define output parameter p-type-parts-enabled    as logical          no-undo.
      478       define output parameter p-type-price-enabled    as logical          no-undo.
      479       define output parameter p-type-scale-enabled    as logical          no-undo.
      480       define output parameter p-type-val-enabled      as logical          no-undo.
      481       define output parameter p-sort-name-enabled     as logical          no-undo.
      482       define output parameter p-sort-gr-enabled       as logical          no-undo.
      483       define output parameter p-print-graft-enabled   as logical          no-undo.
      484       define output parameter p-no-vat-enabled        as logical          no-undo.
      485       do
      486       on error undo, return error
      487       :
      488           assign
      489               p-type-parts-enabled    = ( if substring( p-print-options, 1, 1 ) = "+" then yes else no )
      490               p-type-price-enabled    = ( if substring( p-print-options, 2, 1 ) = "+" then yes else no )
      491               p-type-scale-enabled    = ( if substring( p-print-options, 3, 1 ) = "+" then yes else no )
      492               p-type-val-enabled      = ( if substring( p-print-options, 4, 1 ) = "+" then yes else no )
      493               p-sort-name-enabled     = ( if substring( p-print-options, 5, 1 ) = "+" then yes else no )
      494               p-sort-gr-enabled       = ( if substring( p-print-options, 6, 1 ) = "+" then yes else no )
      495               p-print-graft-enabled   = ( if substring( p-print-options, 7, 1 ) = "+" then yes else no )
      496               p-no-vat-enabled        = ( if substring( p-print-options, 8, 1 ) = "+" then yes else no )
      497           .
      498       end.
      499       end procedure.
      500       procedure menu-doc-create-options-string :
      501       define input parameter p-tmp-list-id        as integer          no-undo.
      502       define output parameter p-options-string    as character        no-undo.
      503           define buffer buf_tmp#list      for tmp#list.
      504       do
      505       for buf_tmp#list
      506       on error undo, return error
      507       :
      508           find first buf_tmp#list
      509                where buf_tmp#list.id = p-tmp-list-id
      510           .
      511           assign
      512               p-options-string =  ( if trim( buf_tmp#list.type-parts  ) = "+":U then "+":U else "-":U )
      513                                 + ( if trim( buf_tmp#list.type-price  ) = "+":U then "+":U else "-":U )
      514                                 + ( if trim( buf_tmp#list.type-scale  ) = "+":U then "+":U else "-":U )
      515                                 + ( if trim( buf_tmp#list.type-val    ) = "+":U then "+":U else "-":U )
      516                                 + ( if trim( buf_tmp#list.sort-name   ) = "+":U then "+":U else "-":U )
      517                                 + ( if trim( buf_tmp#list.sort-gr     ) = "+":U then "+":U else "-":U )
      518                                 + ( if trim( buf_tmp#list.print-graft ) = "+":U then "+":U else "-":U )
      519                                 + ( if trim( buf_tmp#list.no-vat      ) = "+":U then "+":U else "-":U )
      520           .
      521       end.
      522       end procedure.
      523       procedure menu-doc-set-options-string :
      524       define input parameter p-tmp-list-id            as integer          no-undo.
      525       define input parameter p-options-string         as character        no-undo.
      526           define buffer buf_tmp#list      for tmp#list.
      527       do
      528       for buf_tmp#list
      529       on error undo, return error
      530       :
      531           find first buf_tmp#list
      532                where buf_tmp#list.id = p-tmp-list-id
      533           .
      534           assign
      535               buf_tmp#list.type-parts  = ( if buf_tmp#list.type-parts-enabled     = yes then substitute( "  &1", substring( p-options-string, 1, 1 ) ) else " ":U )
      536               buf_tmp#list.type-price  = ( if buf_tmp#list.type-price-enabled     = yes then substitute( "  &1", substring( p-options-string, 2, 1 ) ) else " ":U )
      537               buf_tmp#list.type-scale  = ( if buf_tmp#list.type-scale-enabled     = yes then substitute( "  &1", substring( p-options-string, 3, 1 ) ) else " ":U )
      538               buf_tmp#list.type-val    = ( if buf_tmp#list.type-val-enabled       = yes then substitute( "  &1", substring( p-options-string, 4, 1 ) ) else " ":U )
      539               buf_tmp#list.sort-name   = ( if buf_tmp#list.sort-name-enabled      = yes then substitute( "  &1", substring( p-options-string, 5, 1 ) ) else " ":U )
      540               buf_tmp#list.sort-gr     = ( if buf_tmp#list.sort-gr-enabled        = yes then substitute( "  &1", substring( p-options-string, 6, 1 ) ) else " ":U )
      541               buf_tmp#list.print-graft = ( if buf_tmp#list.print-graft-enabled    = yes then substitute( "  &1", substring( p-options-string, 7, 1 ) ) else " ":U )
      542               buf_tmp#list.no-vat      = ( if buf_tmp#list.no-vat-enabled         = yes then substitute( "  &1", substring( p-options-string, 8, 1 ) ) else " ":U )
      543           .
      544       end.
      545       end procedure.
      546       procedure menu-doc-create-options-enabled-string :
      547       define input parameter p-tmp-list-id                as integer          no-undo.
      548       define output parameter p-options-enabled-string    as character        no-undo.
      549           define buffer buf_tmp#list      for tmp#list.
      550       do
      551       for buf_tmp#list
      552       on error undo, return error
      553       :
      554           find first buf_tmp#list
      555                where buf_tmp#list.id = p-tmp-list-id
      556           .
      557           assign
      558               p-options-enabled-string =  ( if buf_tmp#list.type-parts-enabled  = yes then "+":U else "-":U )
      559                                         + ( if buf_tmp#list.type-price-enabled  = yes then "+":U else "-":U )
      560                                         + ( if buf_tmp#list.type-scale-enabled  = yes then "+":U else "-":U )
      561                                         + ( if buf_tmp#list.type-val-enabled    = yes then "+":U else "-":U )
      562                                         + ( if buf_tmp#list.sort-name-enabled   = yes then "+":U else "-":U )
      563                                         + ( if buf_tmp#list.sort-gr-enabled     = yes then "+":U else "-":U )
      564                                         + ( if buf_tmp#list.print-graft-enabled = yes then "+":U else "-":U )
      565                                         + ( if buf_tmp#list.no-vat-enabled      = yes then "+":U else "-":U )
      566           .
      567       end.
      568       end procedure.
      569       procedure menu-doc-extend-blank-name-for-IBS :
      570       define input parameter p-in-blank-name      as character        no-undo.
      571       define input parameter p-sys-key            as character        no-undo.
      572       define input parameter p-sys-key-black      as character        no-undo.
      573       define output parameter p-out-blank-name    as character        no-undo.
      574       do
      575       on error undo, return error
      576       :
      577           assign
      578               p-out-blank-name = p-in-blank-name
      579           .
      580           if p-sys-key <> "":U
      581           then do:
      582               assign
      583                   p-out-blank-name = substring( p-in-blank-name + " '" + p-sys-key + "'" , 1, 120 )
      584               .
      585           end.
      586           if p-sys-key-black <> ""
      587           then do:
      588               assign
      589                   p-out-blank-name = substring( p-in-blank-name + " no-'" + p-sys-key-black + "'", 1, 120 )
      590               .
      591           end.
      592       end.
      593       end procedure.
      594   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      595     define variable v-cntxt-db-num        as integer   no-undo .
      596     define variable v-cntxt-userid        as character no-undo .
      597     define variable v-cntxt-level         as character no-undo .
      598     define variable v-cntxt-host-code-obj as integer   no-undo .
      599     define variable v-cntxt-obj-type      as character no-undo .
      600     define variable v-cntxt-obj-code      as integer   no-undo .
      601     define variable v-cntxt-db-num-obj    as integer   no-undo .
      602     define variable v-cntxt-is-admin      as logical   no-undo .
      603   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      604   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      605   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      606   define variable par-type          as character no-undo.
      607   define variable v-value-character as character no-undo .
      608   define variable v-value-date      as date      no-undo .
      609   define variable v-value-decimal   as decimal   no-undo .
      610   define variable v-value-integer   as integer   no-undo .
      611   define variable v-value-logical   as logical   no-undo .
      612   define new shared variable print-graft as logical no-undo .
      613   define new shared variable no-vat      as logical no-undo .
      614   define new shared variable sort-gr     as logical no-undo .
      615   define new shared variable sort-name   as logical no-undo .
      616   define new shared variable CostPrice   as logical no-undo .
      617   define new shared variable PrintScale  as logical no-undo .
      618   define new shared variable PrintParts  as logical no-undo .
      619   define variable in-docprvalue       as character    no-undo.
      620   define variable g#report-num    as integer      no-undo.
      621   define variable g#quest-print   as logical      no-undo.
      622   define variable g#log           as logical      no-undo.
      623   DEFINE BUTTON b-chg
      624        LABEL "&Изменить"
      625        SIZE 10 BY 1.1.
      626   DEFINE BUTTON b-deselect
      627        LABEL "&Снять *"
      628        SIZE 10 BY 1.1.
      629   DEFINE BUTTON b-exit AUTO-GO
      630        LABEL "&Выход"
      631        SIZE 10 BY 1.1
      632        BGCOLOR 8 .
      633   DEFINE BUTTON b-help
      634        LABEL "Помощ&ь"
      635        SIZE 3.5 BY 1
      636        BGCOLOR 8 .
      637   DEFINE BUTTON b-print-doc
      638        LABEL ".   Пе&чать":L
      639        SIZE 11.75 BY 1.1
      640        BGCOLOR 8 .
      641   DEFINE BUTTON b-sel
      642        LABEL "*"
      643        SIZE 3 BY 1.1.
      644   DEFINE BUTTON i-print
      645        IMAGE-UP FILE "cmp/b-print.bmp":U
      646        IMAGE-DOWN FILE "cmp/b-print.bmp":U
      647        IMAGE-INSENSITIVE FILE "cmp/b-print.bmp":U
      648        LABEL ""
      649        SIZE 4 BY .96.
      650   DEFINE VARIABLE fi-default-printer AS CHARACTER FORMAT "X(256)":U
      651         VIEW-AS TEXT
      652        SIZE 97 BY .67
      653        FGCOLOR 4  NO-UNDO.
      654   DEFINE QUERY br-table FOR
      655         Tmp#List SCROLLING.
      656   DEFINE BROWSE br-table
      657     QUERY br-table NO-LOCK DISPLAY
      658       Tmp#List.last-use COLUMN-LABEL "*" FORMAT "*/"
      659       Tmp#List.blank-name COLUMN-LABEL "Название печатной формы":C53 FORMAT "X(128)"
      660       Tmp#List.type-parts     column-label "ц.пар"    format "X(5)"
      661       Tmp#List.type-price     column-label "ц.док"    format "X(5)"
      662       Tmp#List.type-scale     column-label "шкала"    format "X(5)"
      663       Tmp#List.type-val       column-label "в ..."    format "X(5)"
      664       Tmp#List.sort-name      column-label "по наим"  format "X(7)"
      665       Tmp#List.sort-gr        column-label "по гр"    format "X(5)"
      666       Tmp#List.print-graft    column-label "по арт"   format "X(4)"
      667       Tmp#List.no-vat         column-label "-НДС"     format "X(4)"
      668       WITH NO-ROW-MARKERS SEPARATORS SIZE 97.88 BY 20.25 EXPANDABLE.
      669   DEFINE FRAME Dialog-Frame
      670        b-exit AT ROW 1 COL 1.63
      671        b-sel AT ROW 1 COL 11.63
      672        b-deselect AT ROW 1 COL 14.63
      673        b-chg AT ROW 1 COL 24.75
      674        b-print-doc AT ROW 1 COL 34.75
      675        b-help AT ROW 1 COL 96
      676        i-print AT ROW 1.04 COL 35 WIDGET-ID 2 NO-TAB-STOP
      677        br-table AT ROW 2.25 COL 1.63
      678        fi-default-printer AT ROW 22.75 COL 1.5 NO-LABEL
      679        SPACE(1.37) SKIP(0.20)
      680       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      681            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      682            TITLE "Список печатных форм".
      683   ASSIGN
      684          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      685          FRAME Dialog-Frame:HIDDEN           = TRUE.
      686   ASSIGN
      687          fi-default-printer:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      688   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      689   DO:
      690     APPLY "END-ERROR":U TO SELF.
      691   END.
      692   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
      693   DO:
      694       if available tmp#list
      695       then do:
      696           define variable v-options-string            as character    no-undo.
      697           define variable v-options-string-new        as character    no-undo.
      698           define variable v-options-enabled-string    as character    no-undo.
      699           run menu-doc-create-options-string in this-procedure (
      700                 input tmp#list.id
      701               , output v-options-string
      702           ).
      703           run menu-doc-create-options-enabled-string in this-procedure (
      704                 input tmp#list.id
      705               , output v-options-enabled-string
      706           ).
      707           run rep/d-docmd.w (
      708                 input tmp#list.blank-name
      709               , input v-options-string
      710               , input v-options-enabled-string
      711               , output v-options-string-new
      712           ) no-error.
      713           if error-status :error
      714           then do:
      715               message
      716                        vss-workfile vss-revision vss-description
      717                   skip(1)
      718                   skip "Ошибка изменения параметров печати."
      719                   skip return-value
      720                   skip trim(error-status :get-message(1))
      721                        trim(error-status :get-message(2))
      722                        trim(error-status :get-message(3))
      723               view-as alert-box error.
      724               undo, return no-apply .
      725           end.
      726           if v-options-string-new <> v-options-string
      727           then do:
      728               run menu-doc-set-options-string in this-procedure (
      729                       input tmp#list.id
      730                     , input v-options-string-new
      731               ).
      732               browse br-table :refresh().
      733               apply "entry" to br-table in frame Dialog-Frame.
      734           end.
      735       end.
      736   END.
      737   ON CHOOSE OF b-deselect IN FRAME Dialog-Frame
      738   DO:
      739       for each tmp#list no-lock
      740       :
      741           assign
      742               tmp#list.last-use = no
      743           .
      744       end.
      745       browse br-table :refresh().
      746   END.
      747   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      748   DO:
      749       run save-form-parameters in this-procedure no-error.
      750       if error-status :error
      751       then do:
      752           message
      753                    vss-workfile vss-revision vss-description
      754               skip(1)
      755               skip "Ошибка при сохранении параметров"
      756               skip "списка печатных форм."
      757               skip return-value
      758               skip trim(error-status :get-message(1))
      759                    trim(error-status :get-message(2))
      760                    trim(error-status :get-message(3))
      761           view-as alert-box error.
      762       end.
      763   END.
      764   ON CHOOSE OF b-print-doc IN FRAME Dialog-Frame
      765   DO:
      766       define variable v-is-selected   as logical      no-undo.
      767       define buffer buf_temp_tmp#list      for tmp#list.
      768       assign
      769           v-is-selected = no
      770       .
      771       test-selecting:
      772       for each buf_temp_tmp#list
      773       :
      774           if buf_temp_tmp#list.last-use <> no
      775           then do:
      776               assign
      777                   v-is-selected = yes
      778               .
      779               leave test-selecting.
      780           end.
      781       end.
      782       if v-is-selected = no
      783       then do:
      784           message
      785               "Не выбрано ни одной формы"
      786               skip "для печати."
      787           view-as alert-box information
      788           title "Печать невозможна"
      789           .
      790           undo, return no-apply.
      791       end.
      792       else do:
      793           run print-docs in this-procedure no-error.
      794           if error-status :error
      795           then do:
      796               message
      797                        vss-workfile vss-revision vss-description
      798                   skip(1)
      799                   skip "Ошибка печати документов."
      800                   skip return-value
      801                   skip trim(error-status :get-message(1))
      802                        trim(error-status :get-message(2))
      803                        trim(error-status :get-message(3))
      804               view-as alert-box error.
      805               undo, return no-apply .
      806           end.
      807       end.
      808   END.
      809   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
      810   DO:
      811       if available tmp#list
      812       then do:
      813           assign
      814               tmp#list.last-use = ( if tmp#list.last-use = yes then no else yes )
      815           .
      816           run reposition-browse in this-procedure .
      817           browse br-table :refresh().
      818       end.
      819   END.
      820   ON 1 OF br-table IN FRAME Dialog-Frame
      821   DO:
      822       if available tmp#list
      823       then do:
      824           if tmp#list.type-parts = "  +":U
      825           or tmp#list.type-parts = "  -":U
      826           then do:
      827               assign
      828                   tmp#list.type-parts = ( if tmp#list.type-parts = "  +":U then "  -":U else "  +":U )
      829               .
      830           end.
      831           br-table :refresh().
      832       end.
      833   END.
      834   ON 2 OF br-table IN FRAME Dialog-Frame
      835   DO:
      836       if available tmp#list
      837       then do:
      838           if tmp#list.type-price = "  +":U
      839           or tmp#list.type-price = "  -":U
      840           then do:
      841               assign
      842                   tmp#list.type-price = ( if tmp#list.type-price = "  +":U then "  -":U else "  +":U )
      843               .
      844           end.
      845           br-table :refresh().
      846       end.
      847   END.
      848   ON 3 OF br-table IN FRAME Dialog-Frame
      849   DO:
      850       if available tmp#list
      851       then do:
      852           if tmp#list.type-scale = "  +":U
      853           or tmp#list.type-scale = "  -":U
      854           then do:
      855               assign
      856                   tmp#list.type-scale = ( if tmp#list.type-scale = "  +":U then "  -":U else "  +":U )
      857               .
      858           end.
      859           br-table :refresh().
      860       end.
      861   END.
      862   ON 4 OF br-table IN FRAME Dialog-Frame
      863   DO:
      864       if available tmp#list
      865       then do:
      866           if tmp#list.type-val = "  +":U
      867           or tmp#list.type-val = "  -":U
      868           then do:
      869               assign
      870                   tmp#list.type-val = ( if tmp#list.type-val = "  +":U then "  -":U else "  +":U )
      871               .
      872           end.
      873           br-table :refresh().
      874       end.
      875   END.
      876   ON 5 OF br-table IN FRAME Dialog-Frame
      877   DO:
      878       if available tmp#list
      879       then do:
      880           if tmp#list.sort-name = "  +":U
      881           or tmp#list.sort-name = "  -":U
      882           then do:
      883               assign
      884                   tmp#list.sort-name = ( if tmp#list.sort-name = "  +":U then "  -":U else "  +":U )
      885               .
      886           end.
      887           br-table :refresh().
      888       end.
      889   END.
      890   ON 6 OF br-table IN FRAME Dialog-Frame
      891   DO:
      892       if available tmp#list
      893       then do:
      894           if tmp#list.sort-gr = "  +":U
      895           or tmp#list.sort-gr = "  -":U
      896           then do:
      897               assign
      898                   tmp#list.sort-gr = ( if tmp#list.sort-gr = "  +":U then "  -":U else "  +":U )
      899               .
      900           end.
      901           br-table :refresh().
      902       end.
      903   END.
      904   ON 7 OF br-table IN FRAME Dialog-Frame
      905   DO:
      906       if available tmp#list
      907       then do:
      908           if tmp#list.print-graft = "  +":U
      909           or tmp#list.print-graft = "  -":U
      910           then do:
      911               assign
      912                   tmp#list.print-graft = ( if tmp#list.print-graft = "  +":U then "  -":U else "  +":U )
      913               .
      914           end.
      915           br-table :refresh().
      916       end.
      917   END.
      918   ON 8 OF br-table IN FRAME Dialog-Frame
      919   DO:
      920       if available tmp#list
      921       then do:
      922           if tmp#list.no-vat      = "  +":U
      923           or tmp#list.no-vat      = "  -":U
      924           then do:
      925               assign
      926                   tmp#list.no-vat      = ( if tmp#list.no-vat      = "  +":U then "  -":U else "  +":U )
      927               .
      928           end.
      929           br-table :refresh().
      930       end.
      931   END.
      932   ON MOUSE-SELECT-DBLCLICK OF br-table IN FRAME Dialog-Frame
      933   DO:
      934       if available Tmp#List
      935       then do:
      936           run select-or-deselect-item in this-procedure (
      937               input Tmp#List.id
      938           ) no-error.
      939           if error-status :error
      940           then do:
      941               message
      942                   vss-workfile vss-revision vss-description
      943                   skip "Ошибка выбора или отмены выбора."
      944                   skip return-value
      945                   skip trim(error-status :get-message(1))
      946                   trim(error-status :get-message(2))
      947                   trim(error-status :get-message(3))
      948               view-as alert-box error.
      949               undo, return no-apply .
      950           end.
      951           br-table :refresh().
      952       end.
      953   END.
      954   ON ROW-DISPLAY OF br-table IN FRAME Dialog-Frame
      955   DO:
      956       if tmp#list.type-price-enabled = no
      957       then do:
      958           assign
      959               Tmp#List.type-price :bgcolor in browse br-table = GREY_COLOR
      960           .
      961       end.
      962       if tmp#list.type-scale-enabled = no
      963       then do:
      964           assign
      965               Tmp#List.type-scale :bgcolor in browse br-table = GREY_COLOR
      966           .
      967       end.
      968       if tmp#list.type-val-enabled = no
      969       then do:
      970           assign
      971               Tmp#List.type-val :bgcolor in browse br-table = GREY_COLOR
      972           .
      973       end.
      974       if tmp#list.sort-name-enabled = no
      975       then do:
      976           assign
      977               Tmp#List.sort-name :bgcolor in browse br-table = GREY_COLOR
      978           .
      979       end.
      980       if tmp#list.sort-gr-enabled = no
      981       then do:
      982           assign
      983               Tmp#List.sort-gr :bgcolor in browse br-table = GREY_COLOR
      984           .
      985       end.
      986       if tmp#list.print-graft-enabled = no
      987       then do:
      988           assign
      989               Tmp#List.print-graft :bgcolor in browse br-table = GREY_COLOR
      990           .
      991       end.
      992       if tmp#list.no-vat-enabled = no
      993       then do:
      994           assign
      995               Tmp#List.no-vat :bgcolor in browse br-table = GREY_COLOR
      996           .
      997       end.
      998       if tmp#list.type-parts-enabled = no
      999       then do:
     1000           assign
     1001               Tmp#List.type-parts :bgcolor in browse br-table = GREY_COLOR
     1002           .
     1003       end.
     1004       if lookup("other", tmp#list.filtr) > 0  then do:
     1005           assign
     1006               Tmp#List.last-use          :bgcolor in browse br-table = yellow_COLOR
     1007               Tmp#List.blank-name        :bgcolor in browse br-table = yellow_COLOR
     1008           .
     1009       end.
     1010       else do:
     1011           assign
     1012               Tmp#List.last-use          :bgcolor in browse br-table = ?
     1013               Tmp#List.blank-name        :bgcolor in browse br-table = ?
     1014           .
     1015       end.
     1016       if Tmp#List.orient-font-num <> 7
     1017       then do:
     1018           assign
     1019               Tmp#List.last-use          :fgcolor in browse br-table = DARK_GREEN_COLOR
     1020               Tmp#List.blank-name        :fgcolor in browse br-table = DARK_GREEN_COLOR
     1021           .
     1022       end.
     1023       else do:
     1024           if Tmp#List.orient-orientation = 'A4port':U
     1025           or Tmp#List.orient-orientation = 'A3port':U
     1026           then do:
     1027               Tmp#List.last-use          :fgcolor in browse br-table = BLUE_COLOR.
     1028               Tmp#List.blank-name        :fgcolor in browse br-table = BLUE_COLOR.
     1029           end.
     1030           else do:
     1031               if Tmp#List.orient-orientation = 'EXCEL':U
     1032               or Tmp#List.orient-orientation = 'self':U
     1033               then do:
     1034                   Tmp#List.last-use   :fgcolor in browse br-table = CYAN_COLOR.
     1035                   Tmp#List.blank-name :fgcolor in browse br-table = CYAN_COLOR.
     1036               end.
     1037               else do:
     1038                   Tmp#List.last-use   :fgcolor in browse br-table = BLACK_COLOR.
     1039                   Tmp#List.blank-name :fgcolor in browse br-table = BLACK_COLOR.
     1040               end.
     1041           end.
     1042       end.
     1043   END.
     1044   ON CHOOSE OF i-print IN FRAME Dialog-Frame
     1045   DO:
     1046     APPLY "choose" TO b-print-doc.
     1047   END.
     1048   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1049   on help of frame Dialog-Frame
     1050   do:
     1051     run gbl/app_help.p
     1052       (input this-procedure :file-name
     1053       ,input ''
     1054       ,input ?
     1055       ) no-error.
     1056     if error-status :error then do:
     1057       message
     1058         "Ошибка при вызове помощи"
     1059         error-status :get-message(1)
     1060         view-as alert-box .
     1061     end.
     1062   end.
     1063   run minbtn-set in this-procedure .
     1064   on choose of b-help in frame Dialog-Frame
     1065   do:
     1066     apply "help":u to frame Dialog-Frame .
     1067   end.
     1068   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1069   procedure minbtn-set :
     1070       do
     1071           on error undo, return error return-value
     1072           :
     1073           define variable ii              as integer       no-undo .
     1074           define variable fh              as widget-handle no-undo .
     1075           define variable hh              as widget-handle no-undo .
     1076           define variable v-h             as handle        extent 4 no-undo .
     1077           define variable v-name-button   as character     no-undo .
     1078           define variable v-help-old-x    as decimal       no-undo .
     1079           define variable v-help-old-y    as decimal       no-undo .
     1080           define variable v-help-old-size as decimal       no-undo .
     1081           define variable v-frame-width   as decimal       no-undo .
     1082           define variable jj              as integer       no-undo .
     1083           do
     1084               on error undo, return error
     1085               :
     1086               assign
     1087                   v-frame-width = frame Dialog-Frame:width - 0.3
     1088                   fh            = frame Dialog-Frame:first-child
     1089                   hh            = fh:first-child
     1090                   ii            = 1
     1091                   .
     1092               do while valid-handle(hh):
     1093                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1094                   do:
     1095                       case lc(hh:name) :
     1096                           when "b-help" then
     1097                               do:
     1098                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1099                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1100                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1101                                   hh:TOOLTIP = "Помощь" .
     1102                                   v-help-old-x = hh:column .
     1103                                   v-help-old-y = hh:row    .
     1104                                   v-help-old-size = hh:width .
     1105                                   hh:width-chars = 2.5 .
     1106                               end.
     1107                           when "b-print" then
     1108                               do:
     1109                                   hh:load-image("cmp/b-print.bmp":u) .
     1110                                   hh:TOOLTIP = "Печать" .
     1111                                   v-h[ii] = hh:handle .
     1112                                   ii = ii + 1 .
     1113                                   hh:width-chars = 3 .
     1114                               end.
     1115                           when "b-history" or
     1116                           when "b-hist" then
     1117                               do:
     1118                                   hh:load-image("cmp/b-hist.bmp":u) .
     1119                                   hh:TOOLTIP = "История" .
     1120                                   v-h[ii] = hh:handle .
     1121                                   ii = ii + 1 .
     1122                                   hh:width-chars = 3 .
     1123                               end.
     1124                           when "b-sch" then
     1125                               do:
     1126                                   hh:load-image("cmp/b-sch.bmp":u) .
     1127                                   hh:TOOLTIP = "Установка Фильтра" .
     1128                                   v-h[ii] = hh:handle .
     1129                                   ii = ii + 1 .
     1130                                   hh:width-chars = 3 .
     1131                               end.
     1132                           when "b-hist-user" then
     1133                               do:
     1134                                   hh:load-image("cmp/b-hist.bmp":u) .
     1135                                   hh:TOOLTIP = "История пользователя" .
     1136                                   ii = ii + 1 .
     1137                               end.
     1138                       end case.
     1139                   end.
     1140                   hh = hh:next-sibling.
     1141               end.
     1142               b-help:column = v-frame-width - b-help:width-chars.
     1143               jj = 0.
     1144               repeat ii = 4 to 1 by -1 :
     1145                   if valid-handle (v-h[ii] ) then
     1146                   do:
     1147                       jj  = jj + 1 .
     1148                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1149                       v-h[ii]:row    = v-help-old-y .
     1150                   end.
     1151               end.
     1152           end.
     1153       end.
     1154   end procedure.
     1155   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1156   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1157   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1158   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1159   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1160   define variable v-diasize-current-frame-height as decimal   no-undo .
     1161   define variable v-diasize-change-size          as logical   no-undo .
     1162   define variable v-diasize-resize-button        as handle    no-undo .
     1163   define variable v-diasize-wndmax               as logical   no-undo .
     1164   define variable v-diasize-wndstore             as logical   no-undo .
     1165   define variable v-diasize-proc-name            as character no-undo .
     1166   define variable v-diasize-browse-handle        as handle    no-undo .
     1167   define variable v-diasize-browse-number        as integer   no-undo .
     1168   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1169   define temp-table temp-diasize-handle no-undo
     1170     field handle-value  as handle
     1171     field save-position as decimal
     1172     index xpk is primary unique handle-value
     1173     .
     1174   define temp-table temp-browse-handle no-undo
     1175     field browse-type   as character
     1176     field browse-number as integer
     1177     field browse-handle as handle
     1178     field original-size as decimal
     1179     index xpk is primary unique browse-type browse-number
     1180     index xie browse-type browse-handle
     1181   .
     1182   procedure diasize_change-height :
     1183     define input  parameter p-change-value  as decimal   no-undo .
     1184     define input  parameter p-move-resize   as logical   no-undo .
     1185     define variable v-field-group-handle    as handle    no-undo .
     1186     define variable v-object-handle         as handle    no-undo .
     1187     define variable v-frame-height          as decimal   no-undo .
     1188     define variable v-frame-virtual-height  as decimal   no-undo .
     1189     define variable v-browse-height         as decimal   no-undo .
     1190     define variable v-window-height         as decimal   no-undo .
     1191     define variable v-window-virtual-height as decimal   no-undo .
     1192     define variable v-change-sign           as integer   no-undo .
     1193     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1194     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1195     if p-change-value > 0
     1196     then do:
     1197       if frame Dialog-Frame :height + p-change-value
     1198           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1199       then do:
     1200         assign
     1201           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1202                           - (frame Dialog-Frame :height-chars)
     1203         .
     1204         if p-change-value <= 0
     1205         then do:
     1206           run diasize_position-resize-button in this-procedure .
     1207           return .
     1208         end.
     1209       end.
     1210     end.
     1211     if p-change-value < 0
     1212     then do:
     1213       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1214       then do:
     1215         assign
     1216           p-change-value = v-diasize-orig-frame-height
     1217                          - (frame Dialog-Frame :height-chars)
     1218         .
     1219         if p-change-value >= 0
     1220         then do:
     1221           run diasize_position-resize-button in this-procedure .
     1222           return .
     1223         end.
     1224       end.
     1225     end.
     1226     if p-change-value >= 0
     1227     then do:
     1228       assign
     1229         v-change-sign = 1
     1230       .
     1231     end.
     1232     else do:
     1233       assign
     1234         v-change-sign = -1
     1235       .
     1236     end.
     1237     assign
     1238       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1239     .
     1240     if p-change-value = 0
     1241     then do:
     1242       run diasize_position-resize-button in this-procedure .
     1243       return .
     1244     end.
     1245     move_block:
     1246     do
     1247     on error undo move_block, retry move_block
     1248     :
     1249       if retry
     1250       then do:
     1251         do
     1252         on error undo move_block, leave move_block
     1253         :
     1254           if p-change-value > 0
     1255           then do:
     1256             for each buf_temp-diasize-handle
     1257             on error undo, next
     1258             :
     1259               assign
     1260                 v-object-handle = buf_temp-diasize-handle.handle-value
     1261               .
     1262               if v-object-handle <> v-diasize-resize-button
     1263               then do:
     1264                 assign
     1265                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1266                 .
     1267               end.
     1268             end.
     1269             assign
     1270               v-diasize-browse-handle :height = v-browse-height
     1271             .
     1272             for each buf_temp-browse-handle
     1273               where buf_temp-browse-handle.browse-type = 'height':u
     1274             on error undo, next
     1275             :
     1276               assign
     1277                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1278               .
     1279             end.
     1280             assign
     1281               frame Dialog-Frame :height = v-frame-height
     1282             .
     1283             if frame Dialog-Frame :scrollable = true
     1284             then do:
     1285               assign
     1286                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1287               .
     1288             end.
     1289             run diasize_position-resize-button in this-procedure .
     1290           end.
     1291           else do:
     1292             if frame Dialog-Frame :scrollable = true
     1293             then do:
     1294               assign
     1295                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1296               .
     1297             end.
     1298             assign
     1299               frame Dialog-Frame :height = v-frame-height
     1300             .
     1301             assign
     1302               v-diasize-browse-handle :height = v-browse-height
     1303             .
     1304             for each buf_temp-browse-handle
     1305               where buf_temp-browse-handle.browse-type = 'height':u
     1306             on error undo, next
     1307             :
     1308               assign
     1309                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1310               .
     1311             end.
     1312             for each buf_temp-diasize-handle
     1313             on error undo, next
     1314             :
     1315               assign
     1316                 v-object-handle = buf_temp-diasize-handle.handle-value
     1317               .
     1318               if v-object-handle <> v-diasize-resize-button
     1319               then do:
     1320                 assign
     1321                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1322                 .
     1323               end.
     1324             end.
     1325             run diasize_position-resize-button in this-procedure .
     1326           end.
     1327           assign
     1328             v-diasize-change-size = false
     1329           .
     1330           leave move_block .
     1331         end.
     1332       end.
     1333       assign
     1334         v-diasize-need-full-display = true
     1335       .
     1336       if v-diasize-change-size = false
     1337       then do:
     1338         assign
     1339           v-diasize-change-size = true
     1340         .
     1341       end.
     1342       else do:
     1343         return .
     1344       end.
     1345       assign
     1346         v-frame-height = frame Dialog-Frame :height
     1347         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1348         v-browse-height = v-diasize-browse-handle :height
     1349       .
     1350       for each buf_temp-browse-handle
     1351         where buf_temp-browse-handle.browse-type = 'height':u
     1352       :
     1353         assign
     1354           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1355         .
     1356       end.
     1357       for each buf_temp-diasize-handle
     1358       :
     1359         delete buf_temp-diasize-handle .
     1360       end.
     1361       assign
     1362         v-field-group-handle = frame Dialog-Frame :first-child
     1363       .
     1364       do while valid-handle(v-field-group-handle)
     1365       :
     1366         assign
     1367           v-object-handle = v-field-group-handle :first-child
     1368         .
     1369         do while valid-handle(v-object-handle)
     1370         :
     1371           if  v-object-handle <> v-diasize-browse-handle :handle
     1372           and can-query(v-object-handle, "row")
     1373           and can-query(v-object-handle, "height")
     1374           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1375           then do:
     1376             find first buf_temp-browse-handle
     1377               where buf_temp-browse-handle.browse-type   = 'height':u
     1378                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1379               no-error .
     1380             if available buf_temp-browse-handle
     1381             then do:
     1382             end.
     1383             else do:
     1384               create buf_temp-diasize-handle .
     1385               assign
     1386                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1387                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1388               .
     1389             end.
     1390           end.
     1391           assign
     1392             v-object-handle = v-object-handle :next-sibling
     1393           .
     1394         end.
     1395         assign
     1396           v-field-group-handle = v-field-group-handle :next-sibling
     1397         .
     1398       end.
     1399       do with frame Dialog-Frame
     1400       :
     1401         hide v-diasize-resize-button .
     1402         assign
     1403           v-diasize-resize-button :row    = 1
     1404           v-diasize-resize-button :column = 1
     1405         .
     1406       end.
     1407       if p-change-value > 0
     1408       then do:
     1409         if frame Dialog-Frame :scrollable = true
     1410         then do:
     1411           assign
     1412             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1413             no-error .
     1414           if error-status :error
     1415           or error-status :get-message(1) <> ""
     1416           then do:
     1417             undo move_block, retry move_block .
     1418           end.
     1419         end.
     1420         assign
     1421           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1422           no-error .
     1423         if error-status :error
     1424         or error-status :get-message(1) <> ""
     1425         then do:
     1426           undo move_block, retry move_block .
     1427         end.
     1428         assign
     1429           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1430           no-error .
     1431         if error-status :error
     1432         or error-status :get-message(1) <> ""
     1433         then do:
     1434           undo move_block, retry move_block .
     1435         end.
     1436         for each buf_temp-browse-handle
     1437           where buf_temp-browse-handle.browse-type = 'height':u
     1438         on error undo move_block, retry move_block
     1439         :
     1440           assign
     1441             buf_temp-browse-handle.browse-handle :height
     1442               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1443             no-error .
     1444           if error-status :error
     1445           or error-status :get-message(1) <> ""
     1446           then do:
     1447             undo move_block, retry move_block .
     1448           end.
     1449         end.
     1450         for each buf_temp-diasize-handle
     1451         on error undo move_block, retry move_block
     1452         :
     1453           assign
     1454             v-object-handle = buf_temp-diasize-handle.handle-value
     1455           .
     1456           if v-object-handle <> v-diasize-resize-button
     1457           then do:
     1458             assign
     1459               v-object-handle :row = v-object-handle :row + p-change-value
     1460               no-error .
     1461             if error-status :error
     1462             or error-status :get-message(1) <> ""
     1463             then do:
     1464               undo move_block, retry move_block .
     1465             end.
     1466           end.
     1467         end.
     1468       end.
     1469       else do:
     1470         for each buf_temp-diasize-handle
     1471         on error undo move_block, retry move_block
     1472         :
     1473           assign
     1474             v-object-handle = buf_temp-diasize-handle.handle-value
     1475           .
     1476           if v-object-handle <> v-diasize-resize-button
     1477           then do:
     1478             assign
     1479               v-object-handle :row = v-object-handle :row + p-change-value
     1480               no-error .
     1481             if error-status :error
     1482             or error-status :get-message(1) <> ""
     1483             then do:
     1484               undo move_block, retry move_block .
     1485             end.
     1486           end.
     1487         end.
     1488         assign
     1489           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1490           no-error .
     1491         if error-status :error
     1492         or error-status :get-message(1) <> ""
     1493         then do:
     1494           undo move_block, retry move_block .
     1495         end.
     1496         for each buf_temp-browse-handle
     1497           where buf_temp-browse-handle.browse-type = 'height':u
     1498         on error undo move_block, retry move_block
     1499         :
     1500           assign
     1501             buf_temp-browse-handle.browse-handle :height
     1502               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1503             no-error .
     1504           if error-status :error
     1505           or error-status :get-message(1) <> ""
     1506           then do:
     1507             undo move_block, retry move_block .
     1508           end.
     1509         end.
     1510         assign
     1511           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1512           no-error .
     1513         if error-status :error
     1514         or error-status :get-message(1) <> ""
     1515         then do:
     1516           undo move_block, retry move_block .
     1517         end.
     1518         if frame Dialog-Frame :scrollable = true
     1519         then do:
     1520           assign
     1521             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1522             no-error .
     1523           if error-status :error
     1524           or error-status :get-message(1) <> ""
     1525           then do:
     1526             undo move_block, retry move_block .
     1527           end.
     1528         end.
     1529       end.
     1530       if p-move-resize = true
     1531       then do:
     1532         run diasize_position-resize-button in this-procedure .
     1533       end.
     1534       if v-diasize-wndstore = true
     1535       then do:
     1536         if connected("ub") = true
     1537         then do:
     1538           define variable v-cntxt-db-num        as integer   no-undo .
     1539           define variable v-cntxt-userid        as character no-undo .
     1540           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1541                                             , OUTPUT v-cntxt-userid
     1542                                             ) .
     1543           run gbl/wndsizew.p
     1544             (input  v-cntxt-db-num
     1545             ,input  v-cntxt-userid
     1546             ,input  v-diasize-proc-name
     1547             ,input  'height':u
     1548             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1549             ) .
     1550         end.
     1551       end.
     1552     end.
     1553     assign
     1554       v-diasize-change-size = false
     1555     .
     1556   end procedure.
     1557   procedure diasize_set-height :
     1558     define input  parameter p-new-height  as decimal   no-undo .
     1559     define input  parameter p-move-resize as logical   no-undo .
     1560     do
     1561     on error undo, return error return-value
     1562     :
     1563       run diasize_change-height in this-procedure
     1564         (input  (p-new-height - frame Dialog-Frame :height)
     1565         ,input  p-move-resize
     1566         ) .
     1567     end.
     1568   end procedure.
     1569   procedure diasize_change-width :
     1570     define input  parameter p-change-value as decimal   no-undo .
     1571     define input  parameter p-move-resize  as logical   no-undo .
     1572     define variable v-field-group-handle   as handle    no-undo .
     1573     define variable v-object-handle        as handle    no-undo .
     1574     define variable v-frame-width          as decimal   no-undo .
     1575     define variable v-frame-virtual-width  as decimal   no-undo .
     1576     define variable v-browse-width         as decimal   no-undo .
     1577     define variable v-window-width         as decimal   no-undo .
     1578     define variable v-window-virtual-width as decimal   no-undo .
     1579     define variable v-change-sign          as integer   no-undo .
     1580     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1581     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1582     if p-change-value > 0
     1583     then do:
     1584       if frame Dialog-Frame :width + p-change-value >
     1585           session :width-chars
     1586       then do:
     1587         assign
     1588           p-change-value = session :width-chars - frame Dialog-Frame :width
     1589         .
     1590         if p-change-value <= 0
     1591         then do:
     1592           run diasize_position-resize-button in this-procedure .
     1593           return .
     1594         end.
     1595       end.
     1596     end.
     1597     if p-change-value < 0
     1598     then do:
     1599       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1600       then do:
     1601         assign
     1602           p-change-value = v-diasize-orig-frame-width
     1603                          - frame Dialog-Frame :width
     1604         .
     1605         if p-change-value >= 0
     1606         then do:
     1607           run diasize_position-resize-button in this-procedure .
     1608           return .
     1609         end.
     1610       end.
     1611     end.
     1612     if p-change-value >= 0
     1613     then do:
     1614       assign
     1615         v-change-sign = 1
     1616       .
     1617     end.
     1618     else do:
     1619       assign
     1620         v-change-sign = -1
     1621       .
     1622     end.
     1623     assign
     1624       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1625     .
     1626     if p-change-value = 0
     1627     then do:
     1628       run diasize_position-resize-button in this-procedure .
     1629       return .
     1630     end.
     1631     move_block:
     1632     do
     1633     on error undo move_block, leave move_block
     1634     :
     1635       if retry
     1636       then do:
     1637         do
     1638         on error undo move_block, leave move_block
     1639         :
     1640           if p-change-value > 0
     1641           then do:
     1642             for each buf_temp-diasize-handle
     1643             on error undo, next
     1644             :
     1645               assign
     1646                 v-object-handle = buf_temp-diasize-handle.handle-value
     1647               .
     1648               if v-object-handle <> v-diasize-resize-button
     1649               then do:
     1650                 assign
     1651                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1652                 .
     1653               end.
     1654             end.
     1655             assign
     1656               v-diasize-browse-handle :width = v-browse-width
     1657             .
     1658             for each buf_temp-browse-handle
     1659               where buf_temp-browse-handle.browse-type = 'width':u
     1660             on error undo, next
     1661             :
     1662               assign
     1663                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1664               .
     1665             end.
     1666             assign
     1667               frame Dialog-Frame :width = v-frame-width
     1668             .
     1669             if frame Dialog-Frame :scrollable = true
     1670             then do:
     1671               assign
     1672                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1673               .
     1674             end.
     1675             run diasize_position-resize-button in this-procedure .
     1676           end.
     1677           else do:
     1678             if frame Dialog-Frame :scrollable = true
     1679             then do:
     1680               assign
     1681                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1682               .
     1683             end.
     1684             assign
     1685               frame Dialog-Frame :width = v-frame-width
     1686             .
     1687             for each buf_temp-browse-handle
     1688               where buf_temp-browse-handle.browse-type = 'width':u
     1689             on error undo, next
     1690             :
     1691               assign
     1692                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1693               .
     1694             end.
     1695             assign
     1696               v-diasize-browse-handle :width = v-browse-width
     1697             .
     1698             for each buf_temp-diasize-handle
     1699             on error undo, next
     1700             :
     1701               assign
     1702                 v-object-handle = buf_temp-diasize-handle.handle-value
     1703               .
     1704               if v-object-handle <> v-diasize-resize-button
     1705               then do:
     1706                 assign
     1707                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1708                 .
     1709               end.
     1710             end.
     1711             run diasize_position-resize-button in this-procedure .
     1712           end.
     1713           assign
     1714             v-diasize-change-size = false
     1715           .
     1716           leave move_block .
     1717         end.
     1718       end.
     1719       assign
     1720         v-diasize-need-full-display = true
     1721       .
     1722       if v-diasize-change-size = false
     1723       then do:
     1724         assign
     1725           v-diasize-change-size = true
     1726         .
     1727       end.
     1728       else do:
     1729         return .
     1730       end.
     1731       assign
     1732         v-frame-width = frame Dialog-Frame :width
     1733         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1734         v-browse-width = v-diasize-browse-handle :width
     1735       .
     1736       for each buf_temp-browse-handle
     1737         where buf_temp-browse-handle.browse-type = 'width':u
     1738       :
     1739         assign
     1740           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1741         .
     1742       end.
     1743       for each buf_temp-diasize-handle
     1744       :
     1745         delete buf_temp-diasize-handle .
     1746       end.
     1747       assign
     1748         v-field-group-handle = frame Dialog-Frame :first-child
     1749       .
     1750       do while valid-handle(v-field-group-handle)
     1751       :
     1752         assign
     1753           v-object-handle = v-field-group-handle :first-child
     1754         .
     1755         do while valid-handle(v-object-handle)
     1756         :
     1757           if  v-object-handle <> v-diasize-browse-handle :handle
     1758           and v-object-handle <> v-diasize-resize-button
     1759           and can-query(v-object-handle, "row")
     1760           and can-query(v-object-handle, "height")
     1761           and ( v-object-handle :col + v-object-handle :width
     1762                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1763               )
     1764           then do:
     1765             find first buf_temp-browse-handle
     1766               where buf_temp-browse-handle.browse-type   = 'width':u
     1767                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1768               no-error .
     1769             if available buf_temp-browse-handle
     1770             then do:
     1771             end.
     1772             else do:
     1773               create buf_temp-diasize-handle .
     1774               assign
     1775                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1776                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1777               .
     1778             end.
     1779           end.
     1780           assign
     1781             v-object-handle = v-object-handle :next-sibling
     1782           .
     1783         end.
     1784         assign
     1785           v-field-group-handle = v-field-group-handle :next-sibling
     1786         .
     1787       end.
     1788       do with frame Dialog-Frame
     1789       :
     1790         hide v-diasize-resize-button .
     1791         v-diasize-resize-button :row = 1.
     1792         v-diasize-resize-button :column = 1.
     1793       end.
     1794       if p-change-value > 0
     1795       then do:
     1796         if frame Dialog-Frame :scrollable = true
     1797         then do:
     1798           assign
     1799             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1800             no-error .
     1801           if error-status :error
     1802           or error-status :get-message(1) <> ""
     1803           then do:
     1804             undo move_block, retry move_block.
     1805           end.
     1806         end.
     1807         assign
     1808           frame Dialog-Frame :width = v-frame-width + p-change-value
     1809           no-error .
     1810         if error-status :error
     1811         or error-status :get-message(1) <> ""
     1812         then do:
     1813           undo move_block, retry move_block.
     1814         end.
     1815         assign
     1816           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1817         no-error .
     1818         if error-status :error
     1819         or error-status :get-message(1) <> ""
     1820         then do:
     1821           undo move_block, retry move_block.
     1822         end.
     1823         for each buf_temp-browse-handle
     1824           where buf_temp-browse-handle.browse-type = 'width':u
     1825         on error undo move_block, retry move_block
     1826         :
     1827           assign
     1828             buf_temp-browse-handle.browse-handle :width
     1829               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1830             no-error .
     1831           if error-status :error
     1832           or error-status :get-message(1) <> ""
     1833           then do:
     1834             undo move_block, retry move_block .
     1835           end.
     1836         end.
     1837         for each buf_temp-diasize-handle
     1838         on error undo move_block, retry move_block
     1839         :
     1840           assign
     1841             v-object-handle = buf_temp-diasize-handle.handle-value
     1842           .
     1843           if v-object-handle <> v-diasize-resize-button
     1844           then do:
     1845             assign
     1846               v-object-handle :col = v-object-handle :col + p-change-value
     1847               no-error .
     1848             if error-status :error
     1849             or error-status :get-message(1) <> ""
     1850             then do:
     1851               undo move_block, retry move_block .
     1852             end.
     1853           end.
     1854         end.
     1855       end.
     1856       else do:
     1857         for each buf_temp-diasize-handle
     1858         on error undo move_block, retry move_block
     1859         :
     1860           assign
     1861             v-object-handle = buf_temp-diasize-handle.handle-value
     1862           .
     1863           if v-object-handle <> v-diasize-resize-button
     1864           then do:
     1865             assign
     1866               v-object-handle :col = v-object-handle :col + p-change-value
     1867               no-error .
     1868             if error-status :error
     1869             or error-status :get-message(1) <> ""
     1870             then do:
     1871               undo move_block, retry move_block .
     1872             end.
     1873           end.
     1874         end.
     1875         for each buf_temp-browse-handle
     1876           where buf_temp-browse-handle.browse-type = 'width':u
     1877         on error undo move_block, retry move_block
     1878         :
     1879           assign
     1880             buf_temp-browse-handle.browse-handle :width
     1881               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1882             no-error .
     1883           if error-status :error
     1884           or error-status :get-message(1) <> ""
     1885           then do:
     1886             undo move_block, retry move_block .
     1887           end.
     1888         end.
     1889         assign
     1890           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1891           no-error .
     1892         if error-status :error
     1893         or error-status :get-message(1) <> ""
     1894         then do:
     1895           undo move_block, retry move_block.
     1896         end.
     1897         assign
     1898           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1899         no-error .
     1900         if error-status :error
     1901         or error-status :get-message(1) <> ""
     1902         then do:
     1903           undo move_block, retry move_block.
     1904         end.
     1905         if frame Dialog-Frame :scrollable = true
     1906         then do:
     1907           assign
     1908             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1909           no-error .
     1910           if error-status :error
     1911           or error-status :get-message(1) <> ""
     1912           then do:
     1913             undo move_block, retry move_block.
     1914           end.
     1915         end.
     1916       end.
     1917       if p-move-resize
     1918       then do:
     1919         run diasize_position-resize-button in this-procedure .
     1920       end.
     1921       if v-diasize-wndstore = true
     1922       then do:
     1923         if connected("ub") = true
     1924         then do:
     1925           define variable v-cntxt-db-num        as integer   no-undo .
     1926           define variable v-cntxt-userid        as character no-undo .
     1927           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1928                                             , OUTPUT v-cntxt-userid
     1929                                             ) .
     1930           run gbl/wndsizew.p
     1931             (input  v-cntxt-db-num
     1932             ,input  v-cntxt-userid
     1933             ,input  v-diasize-proc-name
     1934             ,input  'width':u
     1935             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1936             ) .
     1937         end.
     1938       end.
     1939     end.
     1940     assign
     1941       v-diasize-change-size = false
     1942     .
     1943   end procedure.
     1944   procedure diasize_set-width :
     1945     define input  parameter p-new-width  as decimal   no-undo .
     1946     define input  parameter p-move-resize as logical   no-undo .
     1947     do
     1948     on error undo, return error return-value
     1949     :
     1950       run diasize_change-width in this-procedure
     1951         (input  (p-new-width - frame Dialog-Frame :width)
     1952         ,input  p-move-resize
     1953         ) .
     1954     end.
     1955   end procedure.
     1956   procedure diasize_position-resize-button :
     1957     do with frame Dialog-Frame
     1958     :
     1959       hide v-diasize-resize-button .
     1960       assign
     1961         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1962                     - 1
     1963                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1964         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1965                     - 1
     1966                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1967       .
     1968       view v-diasize-resize-button .
     1969     end.
     1970   end procedure.
     1971   on alt-right anywhere
     1972   do:
     1973     run diasize_change-width in this-procedure
     1974       (input 1
     1975       ,input true
     1976       ) .
     1977     return no-apply .
     1978   end.
     1979   on alt-left anywhere
     1980   do:
     1981     run diasize_change-width in this-procedure
     1982       (input -1
     1983       ,input true
     1984       ) .
     1985     return no-apply .
     1986   end.
     1987   on alt-down anywhere
     1988   do:
     1989     run diasize_change-height in this-procedure
     1990       (input 1
     1991       ,input true
     1992       ) .
     1993     return no-apply .
     1994   end.
     1995   on alt-up anywhere
     1996   do:
     1997     run diasize_change-height in this-procedure
     1998       (input -1
     1999       ,input true
     2000       ) .
     2001     return no-apply .
     2002   end.
     2003   on alt-enter of frame Dialog-Frame
     2004   do:
     2005     run diasize_maximize in this-procedure
     2006       (input  ?
     2007       ).
     2008     return no-apply .
     2009   end.
     2010   procedure diasize_end-move :
     2011     do
     2012     on error undo, return error return-value
     2013     :
     2014       define variable v-row-delta as decimal   no-undo .
     2015       define variable v-col-delta as decimal   no-undo .
     2016       define variable v-new-row as decimal   no-undo .
     2017       define variable v-new-col as decimal   no-undo .
     2018       assign
     2019         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2020         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2021       .
     2022       assign
     2023         v-row-delta = v-new-row - frame Dialog-Frame :height
     2024         v-col-delta = v-new-col - frame Dialog-Frame :width
     2025       .
     2026       run diasize_change-height in this-procedure
     2027         (input v-row-delta
     2028         ,input true
     2029         ) .
     2030       run diasize_change-width in this-procedure
     2031         (input v-col-delta
     2032         ,input true
     2033         ) .
     2034     end.
     2035   end procedure.
     2036   procedure diasize_maximize :
     2037     define input  parameter p-action as logical   no-undo .
     2038     do
     2039     on error undo, return error return-value
     2040     :
     2041       if p-action = ?
     2042       then do:
     2043         if v-diasize-need-maximize = true
     2044         then do:
     2045           assign
     2046             p-action = true
     2047           .
     2048         end.
     2049         else do:
     2050           assign
     2051             p-action = false
     2052           .
     2053         end.
     2054       end.
     2055       if p-action = true
     2056       then do:
     2057         run diasize_change-height in this-procedure
     2058           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2059               - frame Dialog-Frame :height-chars
     2060           ,input true
     2061           ) .
     2062         run diasize_change-width in this-procedure
     2063           (input session :width-chars
     2064               - frame Dialog-Frame :width-chars
     2065           ,input true
     2066           ) .
     2067         assign
     2068           v-diasize-need-maximize = false
     2069         .
     2070       end.
     2071       else do:
     2072         run diasize_change-width in this-procedure
     2073           (input v-diasize-orig-frame-width
     2074               - frame Dialog-Frame :width-chars
     2075           ,input true
     2076           ) .
     2077         run diasize_change-height in this-procedure
     2078           (input v-diasize-orig-frame-height
     2079               - frame Dialog-Frame :height-chars
     2080           ,input true
     2081           ) .
     2082         assign
     2083           v-diasize-need-maximize = true
     2084         .
     2085       end.
     2086     end.
     2087   end procedure.
     2088   procedure diasize_restore-orig-size :
     2089     do
     2090     on error undo, return error return-value
     2091     :
     2092       assign
     2093         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2094         v-diasize-current-frame-height = frame Dialog-Frame :height
     2095       .
     2096       run diasize_set-height in this-procedure
     2097         (input  v-diasize-orig-frame-height
     2098         ,input  true
     2099         ) .
     2100       run diasize_set-width in this-procedure
     2101         (input  v-diasize-orig-frame-width
     2102         ,input  true
     2103         ) .
     2104     end.
     2105   end procedure.
     2106   procedure diasize_restore-current-size :
     2107     do
     2108     on error undo, return error return-value
     2109     :
     2110       run diasize_set-height in this-procedure
     2111         (input  v-diasize-current-frame-height
     2112         ,input  true
     2113         ) .
     2114       run diasize_set-width in this-procedure
     2115         (input  v-diasize-current-frame-width
     2116         ,input  true
     2117         ) .
     2118     end.
     2119   end procedure.
     2120   procedure diasize_set-browse-handle :
     2121     define input  parameter p-browse-handle as handle   no-undo .
     2122     define buffer buf_temp-browse-handle for temp-browse-handle .
     2123     do
     2124     on error undo, return error return-value
     2125     :
     2126       assign
     2127         v-diasize-browse-handle = p-browse-handle
     2128       .
     2129       for each buf_temp-browse-handle
     2130       on error undo, return error return-value
     2131       :
     2132         delete buf_temp-browse-handle .
     2133       end.
     2134     end.
     2135   end procedure.
     2136   procedure diasize_add_browse :
     2137     define input  parameter p-browse-type   as character no-undo .
     2138     define input  parameter p-browse-handle as handle    no-undo .
     2139     define buffer buf_temp-browse-handle for temp-browse-handle .
     2140     do
     2141     on error undo, return error return-value
     2142     :
     2143       assign
     2144         v-diasize-browse-number = v-diasize-browse-number + 1
     2145       .
     2146       create buf_temp-browse-handle .
     2147       assign
     2148         buf_temp-browse-handle.browse-type   = p-browse-type
     2149         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2150         buf_temp-browse-handle.browse-handle = p-browse-handle
     2151       .
     2152     end.
     2153   end procedure.
     2154   procedure diasize_init :
     2155     define variable v-default-value    as logical   no-undo .
     2156     define variable v-restore-saved    as logical   no-undo .
     2157     define variable v-resize-value-str as character no-undo .
     2158     do
     2159     on error undo, return error return-value
     2160     :
     2161       do with frame Dialog-Frame
     2162       :
     2163         assign
     2164           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2165           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2166           v-diasize-browse-handle     = browse br-table :handle
     2167         .
     2168         create button v-diasize-resize-button
     2169         assign
     2170           parent        = frame Dialog-Frame :first-child
     2171           label         = "s"
     2172           height-pixels = 16
     2173           width-pixels  = 16
     2174           visible       = true
     2175           sensitive     = true
     2176           movable       = true
     2177           triggers:
     2178             on end-move persistent run diasize_end-move in this-procedure .
     2179           end triggers.
     2180         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2181         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2182         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2183         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2184         assign
     2185           v-diasize-wndmax = false
     2186         .
     2187         if connected("ub") = true
     2188         then do:
     2189           define variable v-cntxt-db-num        as integer   no-undo .
     2190           define variable v-cntxt-userid        as character no-undo .
     2191           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2192                                             , OUTPUT v-cntxt-userid
     2193                                             ) .
     2194           run gbl/wndpar_r.p
     2195             (input  v-cntxt-db-num
     2196             ,input  v-cntxt-userid
     2197             ,input  'wndmax':U
     2198             ,output v-diasize-wndmax
     2199             ,output v-default-value
     2200             ) .
     2201         end.
     2202         assign
     2203           v-diasize-wndstore = false
     2204         .
     2205         if connected("ub") = true
     2206         then do:
     2207           run gbl/wndpar_r.p
     2208             (input  v-cntxt-db-num
     2209             ,input  v-cntxt-userid
     2210             ,input  'wndstore':U
     2211             ,output v-diasize-wndstore
     2212             ,output v-default-value
     2213             ) .
     2214         end.
     2215         assign
     2216           v-diasize-proc-name = entry(1, program-name(2), '.')
     2217         .
     2218         if v-diasize-wndstore = true
     2219         then do:
     2220           assign
     2221             v-restore-saved = false
     2222           .
     2223           if connected("ub") = true
     2224           then do:
     2225             run gbl/wndsizer.p
     2226               (input  v-cntxt-db-num
     2227               ,input  v-cntxt-userid
     2228               ,input  v-diasize-proc-name
     2229               ,input  'height':u
     2230               ,output v-resize-value-str
     2231               ) .
     2232             if v-resize-value-str <> '':U
     2233             then do:
     2234               run diasize_change-height in this-procedure
     2235                 (input  integer(v-resize-value-str)
     2236                 ,input  true
     2237                 ) .
     2238               assign
     2239                 v-restore-saved = true
     2240               .
     2241             end.
     2242           end.
     2243           if connected("ub") = true
     2244           then do:
     2245             run gbl/wndsizer.p
     2246               (input  v-cntxt-db-num
     2247               ,input  v-cntxt-userid
     2248               ,input  v-diasize-proc-name
     2249               ,input  'width':u
     2250               ,output v-resize-value-str
     2251               ) .
     2252             if v-resize-value-str <> '':U
     2253             then do:
     2254               run diasize_change-width in this-procedure
     2255                 (input  integer(v-resize-value-str)
     2256                 ,input  true
     2257                 ) .
     2258               assign
     2259                 v-restore-saved = true
     2260               .
     2261             end.
     2262           end.
     2263           if v-restore-saved <> true
     2264           then do:
     2265             if v-diasize-wndmax = true
     2266             then do:
     2267               run diasize_maximize in this-procedure
     2268                 (input  true
     2269                 ) .
     2270             end.
     2271           end.
     2272         end.
     2273         else do:
     2274           if v-diasize-wndmax = true
     2275           then do:
     2276             run diasize_maximize in this-procedure
     2277               (input  true
     2278               ) .
     2279           end.
     2280         end.
     2281       end.
     2282     end.
     2283   end procedure.
     2284   procedure diasize_need-full-display :
     2285     define output parameter p-need-full-display as logical   no-undo .
     2286     do
     2287     on error undo, return error return-value
     2288     :
     2289       assign
     2290         p-need-full-display = v-diasize-need-full-display
     2291       .
     2292       assign
     2293         v-diasize-need-full-display = false
     2294       .
     2295     end.
     2296   end procedure.
     2297   procedure get-context :
     2298      define output parameter p-db-num as integer          no-undo.
     2299      define output parameter p-user-id as character        no-undo.
     2300      define variable v-login               as character    no-undo.
     2301      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2302      define buffer buf_user-login  for ub.user-login .
     2303      do
     2304      on error undo, return error
     2305      :
     2306            FIND FIRST buf_sys-ctrl no-lock.
     2307            ASSIGN
     2308               v-login = USERID("ub")
     2309               p-db-num = buf_sys-ctrl.db-num
     2310            .
     2311            FIND FIRST buf_user-login
     2312                 WHERE buf_user-login.db-num = p-db-num
     2313                   AND buf_user-login.user-login = v-login
     2314                 no-lock
     2315                 no-error
     2316                 .
     2317            IF AVAILABLE buf_user-login
     2318            THEN DO:
     2319               assign
     2320                  p-user-id = buf_user-login.user-id
     2321               .
     2322            END.
     2323      end.
     2324   end procedure.
     2325       run diasize_init in this-procedure .
     2326   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2327   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
