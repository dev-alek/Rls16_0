     2421   define variable is-jwlr  as character no-undo .
     2422   define variable par-type as character no-undo .
     2423   run gbl/conf-rd.p ("is-ptrl", "", "", 0, "", "", "", no, output is-ptrl, output par-type) no-error.
     2424   if error-status :error
     2425     or par-type <> "l"
     2426     or is-ptrl  <> "yes"
     2427   then do:
     2428     assign is-ptrl = "no".
     2429   end.
     2430   run gbl/conf-rd.p ("is-jwlr", "", "", 0, "", "", "", no, output is-jwlr, output par-type) no-error.
     2431   if error-status :error
     2432     or par-type <> "l"
     2433     or is-jwlr  <> "yes"
     2434   then do:
     2435     assign is-jwlr = "no".
     2436   end.
