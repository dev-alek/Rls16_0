     2380   PROCEDURE create-menu-items1 :
     2381   define input parameter p-doc-code       as character        no-undo.
     2382   define input parameter p-doc-type       as character        no-undo.
     2383   define input parameter p-ext-doc-type   as character        no-undo.
     2384   define input parameter p-status_        as character        no-undo.
     2385   define input parameter p-Internal       as character        no-undo.
     2386   define input parameter p-flag_          as character        no-undo.
     2387       define variable xtype        as character    no-undo.
     2388       define variable xstatus      as character    no-undo.
     2389       define variable xInternal    as character    no-undo.
     2390       define variable xflag        as character    no-undo.
     2391   do
     2392   on error undo, return error
     2393   :
     2394       if p-doc-type <> 'инв':U
     2395       then do:
     2396           assign
     2397               xtype = p-doc-type
     2398           .
     2399       end.
     2400       else do:
     2401           assign
     2402               xtype = p-ext-doc-type
     2403           .
     2404       end.
     2405       assign
     2406           xstatus             = string( p-status_  )
     2407           xInternal           = string( p-Internal )
     2408           xflag               = string( p-flag_    )
     2409       .
     2410       assign
     2411           v-menu-doc-doc-code     = p-doc-code
     2412           v-menu-doc-doc-type     = xtype
     2413           v-menu-doc-ext-doc-type = p-ext-doc-type
     2414           v-menu-doc-status_      = xstatus
     2415           v-menu-doc-internal     = xInternal
     2416           v-menu-doc-flag         = xflag
     2417       .
     2418   define variable vss-include-info12 as character format "X(65)" no-undo
     2419   initial "@(#)$Workfile: load-doc.i $ $Revision: 992a74a9441b, 3581, rls $".
