     8510   PROCEDURE disable_UI :
     8511     HIDE FRAME Dialog-Frame.
     8512   END PROCEDURE.
     8513   PROCEDURE enable_UI :
     8514     DISPLAY fi-default-printer
     8515         WITH FRAME Dialog-Frame.
     8516     ENABLE b-exit b-chg b-print-doc b-help i-print br-table fi-default-printer
     8517         WITH FRAME Dialog-Frame.
     8518     VIEW FRAME Dialog-Frame.
     8519     run local-open-query in this-procedure .
     8520   END PROCEDURE.
     8521   PROCEDURE get-call-point :
     8522   define input parameter p-tmp#list-id as integer          no-undo.
     8523   define output parameter p-call-point as character        no-undo.
     8524       define variable v-doc-type        as character    no-undo.
     8525       define variable v-doc-status      as character    no-undo.
     8526       define variable v-doc-internal    as character    no-undo.
     8527       define variable v-doc-flag        as character    no-undo.
     8528       define buffer buf_temp_form-list        for temp_form-list.
     8529   do
     8530   for buf_temp_form-list
     8531   on error undo, return error
     8532   :
     8533       assign
     8534           v-doc-type     = "":U
     8535           v-doc-status   = "":U
     8536           v-doc-internal = "":U
     8537           v-doc-flag     = "":U
     8538       .
     8539       for each buf_temp_form-list
     8540          where buf_temp_form-list.id = Tmp#List.id
     8541       :
     8542           if lookup( buf_temp_form-list.doc-type, v-doc-type ) = 0
     8543           then do:
     8544               assign
     8545                   v-doc-type = ( if v-doc-type = "":U then "":U else "_":U ) + buf_temp_form-list.doc-type
     8546               .
     8547           end.
     8548           if lookup( buf_temp_form-list.status_, v-doc-status ) = 0
     8549           then do:
     8550               assign
     8551                   v-doc-status = ( if v-doc-status = "":U then "":U else "_":U ) + buf_temp_form-list.status_
     8552               .
     8553           end.
     8554           if lookup( buf_temp_form-list.internal, v-doc-internal ) = 0
     8555           then do:
     8556               assign
     8557                   v-doc-internal = ( if v-doc-internal = "":U then "":U else "_":U ) + buf_temp_form-list.internal
     8558               .
     8559           end.
     8560           if lookup( buf_temp_form-list.flag, v-doc-flag ) = 0
     8561           then do:
     8562               assign
     8563                   v-doc-flag = ( if v-doc-flag = "":U then "":U else "_":U ) + buf_temp_form-list.flag
     8564               .
     8565           end.
     8566       end.
     8567       assign
     8568           p-call-point = substitute( "&1,&2,&3,&4", v-doc-type, v-doc-status, v-doc-internal, v-doc-flag )
     8569       .
     8570   end.
     8571   END PROCEDURE.
     8572   PROCEDURE get-handle-all-docs :
     8573   define output parameter p-handle as handle no-undo .
     8574     p-handle =  p-alldocs-handle .
     8575   END PROCEDURE.
     8576   PROCEDURE get-saved-character :
     8577   define input parameter p-list           as character        no-undo.
     8578   define input parameter p-name           as character        no-undo.
     8579   define output parameter p-character     as character        no-undo.
     8580       define variable v-position    as integer      no-undo.
     8581   do
     8582   on error undo, return error
     8583   :
     8584       assign
     8585           v-position = lookup( p-name, p-list )
     8586       .
     8587       if v-position = 0
     8588       then do:
     8589           assign
     8590               p-character = "":U
     8591           .
     8592       end.
     8593       else do:
     8594           if num-entries( p-list ) > v-position
     8595           then do:
     8596               assign
     8597                   p-character = entry( v-position + 1, p-list )
     8598               .
     8599           end.
     8600           else do:
     8601               assign
     8602                   p-character = "":U
     8603               .
     8604           end.
     8605       end.
     8606   end.
     8607   END PROCEDURE.
     8608   PROCEDURE get-saved-logical :
     8609   define input parameter p-list       as character        no-undo.
     8610   define input parameter p-name       as character        no-undo.
     8611   define output parameter p-logical   as character        no-undo.
     8612       define variable v-position    as integer      no-undo.
     8613   do
     8614   on error undo, return error
     8615   :
     8616       assign
     8617           v-position = lookup( p-name, p-list )
     8618       .
     8619       if v-position = 0
     8620       then do:
     8621           assign
     8622               p-logical = "  -":U
     8623           .
     8624       end.
     8625       else do:
     8626           if num-entries( p-list ) > v-position
     8627           then do:
     8628               assign
     8629                   p-logical = "  ":U + entry( v-position + 1, p-list )
     8630               .
     8631               if trim( p-logical ) = "":U
     8632               then do:
     8633                   assign
     8634                       p-logical = "  -":U
     8635                   .
     8636               end.
     8637           end.
     8638           else do:
     8639               assign
     8640                   p-logical = "  -":U
     8641               .
     8642           end.
     8643       end.
     8644   end.
     8645   END PROCEDURE.
     8646   PROCEDURE init-fields :
     8647   define variable xtype        as character    no-undo.
     8648   define variable xstatus      as character    no-undo.
     8649   define variable xInternal    as character    no-undo.
     8650   define variable xflag        as character    no-undo.
     8651       define variable v-temp-char     as character    no-undo.
     8652       define variable v-par-type      as character    no-undo.
     8653       define variable v-call-point    as character    no-undo.
     8654       define variable v-doc-counter   as integer      no-undo.
     8655       define variable v-form-title    as character    no-undo.
     8656       define buffer buf_trn-doc           for ub.trn-doc.
     8657       define buffer buf_usr-flt           for ubflt.usr-flt.
     8658   do
     8659   for buf_trn-doc
     8660     , buf_usr-flt
     8661   with frame Dialog-Frame
     8662   on error undo, return error
     8663   :
     8664       assign
     8665           fi-default-printer = session :printer-name
     8666       .
     8667   define variable vss-include-info309 as character format "x(65)" no-undo initial "@(#)$Workfile:currsysk.i $ $Revision: $".
     8668   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currsysk in g#library
     8669     (output v-menu-doc-sys-key
     8670     ) no-error .
     8671       for each temp_trn-doc-code
     8672       on error undo, return error
     8673       :
     8674           assign
     8675               v-doc-counter = v-doc-counter + 1
     8676           .
     8677           find first buf_trn-doc no-lock
     8678                where buf_trn-doc.doc-code = temp_trn-doc-code.doc-code
     8679           .
     8680           run create-menu-items1 in this-procedure (
     8681                 input buf_trn-doc.doc-code
     8682               , input buf_trn-doc.doc-type
     8683               , input buf_trn-doc.ext-doc-type
     8684               , input buf_trn-doc.status_
     8685               , input buf_trn-doc.Internal
     8686               , input buf_trn-doc.flag_
     8687           ).
     8688           run create-menu-items2 in this-procedure (
     8689                 input buf_trn-doc.doc-code
     8690               , input buf_trn-doc.doc-type
     8691               , input buf_trn-doc.ext-doc-type
     8692               , input buf_trn-doc.status_
     8693               , input buf_trn-doc.Internal
     8694               , input buf_trn-doc.flag_
     8695           ).
     8696       end.
     8697       if v-doc-counter = 1
     8698       then do:
     8699           assign
     8700               v-form-title = substitute( "Печать документа   Тип: &1 Статус: &2&3 &4   № &5"
     8701                   , v-menu-doc-doc-type
     8702                   , v-menu-doc-status_
     8703                   , string( v-menu-doc-flag, "+/-" )
     8704                   , string( v-menu-doc-internal,"внутренний/внешний")
     8705                   , v-menu-doc-doc-code )
     8706           .
     8707       end.
     8708       else do:
     8709           assign
     8710               v-form-title = substitute( "Печать выбранных документов по списку" )
     8711           .
     8712       end.
     8713       assign
     8714           frame Dialog-Frame :title = v-form-title
     8715       .
     8716       for each Tmp#List
     8717       :
     8718           run get-call-point in this-procedure (
     8719                 input Tmp#List.id
     8720               , output v-call-point
     8721           ).
     8722           find first buf_usr-flt no-lock
     8723                where buf_usr-flt.user-name  = v-cntxt-userid
     8724                  and buf_usr-flt.call-point = substitute( "&1,&2,&3,&4"
     8725                                               , Tmp#List.blank-name
     8726                                               , Tmp#List.sys-key
     8727                                               , Tmp#List.sys-key-black
     8728                                               , v-call-point )
     8729           no-error.
     8730           if available buf_usr-flt
     8731           then do:
     8732               run get-saved-logical in this-procedure (
     8733                     input buf_usr-flt.list_
     8734                   , input "type-parts":U
     8735                   , output Tmp#List.type-parts
     8736               ).
     8737               run get-saved-logical in this-procedure (
     8738                     input buf_usr-flt.list_
     8739                   , input "type-price":U
     8740                   , output Tmp#List.type-price
     8741               ).
     8742               run get-saved-logical in this-procedure (
     8743                     input buf_usr-flt.list_
     8744                   , input "type-val":U
     8745                   , output Tmp#List.type-val
     8746               ).
     8747               run get-saved-logical in this-procedure (
     8748                     input buf_usr-flt.list_
     8749                   , input "sort-gr":U
     8750                   , output Tmp#List.sort-gr
     8751               ).
     8752               run get-saved-logical in this-procedure (
     8753                     input buf_usr-flt.list_
     8754                   , input "print-graft":U
     8755                   , output Tmp#List.print-graft
     8756               ).
     8757               run get-saved-logical in this-procedure (
     8758                     input buf_usr-flt.list_
     8759                   , input "type-scale":U
     8760                   , output Tmp#List.type-scale
     8761               ).
     8762               run get-saved-logical in this-procedure (
     8763                     input buf_usr-flt.list_
     8764                   , input "sort-name":U
     8765                   , output Tmp#List.sort-name
     8766               ).
     8767               run get-saved-logical in this-procedure (
     8768                     input buf_usr-flt.list_
     8769                   , input "no-vat":U
     8770                   , output Tmp#List.no-vat
     8771               ).
     8772               assign
     8773                   v-temp-char = "":U
     8774               .
     8775               run get-saved-logical in this-procedure (
     8776                     input buf_usr-flt.list_
     8777                   , input "selection":U
     8778                   , output v-temp-char
     8779               ).
     8780               if v-temp-char = "  +":U
     8781               then do:
     8782                   assign
     8783                       Tmp#List.last-use = yes
     8784                   .
     8785               end.
     8786           end.
     8787           else do:
     8788               assign
     8789                   Tmp#List.type-parts   = "  -":U
     8790                   Tmp#List.type-price   = "  -":U
     8791                   Tmp#List.type-val     = "  -":U
     8792                   Tmp#List.sort-gr      = "  -":U
     8793                   Tmp#List.sort-name    = "  -":U
     8794                   Tmp#List.print-graft  = "  -":U
     8795                   Tmp#List.type-scale   = "  -":U
     8796                   Tmp#List.no-vat       = "  -":U
     8797               .
     8798           end.
     8799           if Tmp#List.type-parts-enabled = no
     8800           then do:
     8801               assign
     8802                   Tmp#List.type-parts   = " ":U
     8803               .
     8804           end.
     8805           if Tmp#List.type-price-enabled = no
     8806           then do:
     8807               assign
     8808                   Tmp#List.type-price   = " ":U
     8809               .
     8810           end.
     8811           if Tmp#List.type-val-enabled = no
     8812           then do:
     8813               assign
     8814                   Tmp#List.type-val     = " ":U
     8815               .
     8816           end.
     8817           if Tmp#List.sort-gr-enabled = no
     8818           then do:
     8819               assign
     8820                   Tmp#List.sort-gr      = " ":U
     8821               .
     8822           end.
     8823           if Tmp#List.sort-name-enabled = no
     8824           then do:
     8825               assign
     8826                   Tmp#List.sort-name    = " ":U
     8827               .
     8828           end.
     8829           if Tmp#List.print-graft-enabled = no
     8830           then do:
     8831               assign
     8832                   Tmp#List.print-graft  = " ":U
     8833               .
     8834           end.
     8835           if Tmp#List.no-vat-enabled = no
     8836           then do:
     8837               assign
     8838                   Tmp#List.no-vat  = " ":U
     8839               .
     8840           end.
     8841           if Tmp#List.type-scale-enabled = no
     8842           then do:
     8843               assign
     8844                   Tmp#List.type-scale   = " ":U
     8845               .
     8846           end.
     8847         if v-doc-counter > 1 then do:
     8848            if lookup("no-print-many" ,Tmp#List.filtr )  > 0 then do:
     8849               Tmp#List.view_ = 0.
     8850            end.
     8851         end.
     8852       end.
     8853   end.
     8854   END PROCEDURE.
     8855   PROCEDURE local-open-query :
     8856           open query br-table
     8857           for each Tmp#List no-lock
     8858              where Tmp#List.view_ <> 0
     8859           by Tmp#List.blank-name
     8860           .
     8861    END PROCEDURE.
     8862   PROCEDURE print-docs :
     8863       define variable v-doc-type          as character    no-undo.
     8864       define variable v-status            as character    no-undo.
     8865       define variable v-internal          as character    no-undo.
     8866       define variable v-flag              as character    no-undo.
     8867       define variable v-form-amount       as integer      no-undo.
     8868       define variable v-user-action       as character    no-undo.
     8869       define variable v-printed           as logical      no-undo.
     8870       define variable v-log               as logical      no-undo.
     8871       define variable listGdsProcActn     as character init "rep/inv-3p.p,rep/inv-3.p,rep/inv-19.p,rep/inv-8l.p,rep/inv-8.p,rep/inv-3del.p,rep/inv-pst.p,rep/inv-3slg.p,rep/inv-pst.p" no-undo.
     8872       define variable listPtrlProcActn    as character init "rep/inv-3-kg.p,rep/r-orsvx1.p,rep/r-np34.p,rep/r-orioxl.p" no-undo.
     8873       define buffer buf_trn-doc       for ub.trn-doc.
     8874       define buffer buf_t_tmp#list    for tmp#list.
     8875       define buffer buf_tmp#list      for tmp#list.
     8876   do
     8877   for buf_trn-doc
     8878     , buf_t_tmp#list
     8879     , buf_tmp#list
     8880   with frame Dialog-Frame
     8881   on error undo, return error
     8882   :
     8883       if g#quest-print = yes
     8884       then do:
     8885           output  to value( string( session:temp-directory + "$" + string( g#report-num ) ) ) .
     8886           output close.
     8887       End.
     8888       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) .
     8889       output close.
     8890       output to value( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".txl" ) .
     8891       output close.
     8892       for each temp_form-list
     8893       by temp_form-list.doc-code
     8894       on error undo, return error
     8895       :
     8896           for each buf_tmp#list
     8897              where buf_tmp#list.id = temp_form-list.id
     8898           on error undo, return error
     8899           :
     8900               if buf_tmp#list.last-use <> no
     8901               then do:
     8902                 if lookup (buf_tmp#list.proc-name, listGdsProcActn) > 0 and not buf_tmp#list.blank-name = "Предварительная инвентаризационная опись"
     8903                 then do:
     8904   define variable vss-include-info310 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8905   do:
     8906     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     8907       (input  v-cntxt-db-num
     8908       ,input  v-cntxt-userid
     8909       ,input  0
     8910       ,input  'actn_inv-gds_report':U
     8911       ,input  'global':U
     8912       ,input  0
     8913       ,input  '':U
     8914       ,input  0
     8915       ,input  0
     8916       ,input  0
     8917       ,input  0
     8918       ,input  false
     8919       ,output v-log
     8920       )  .
     8921   end.
     8922                    if not v-log then do:
     8923                      message
     8924                        "Недостаточно прав для вывода на печать"
     8925                        skip
     8926                        buf_tmp#list.blank-name "."
     8927                        skip
     8928                        " "
     8929                        skip
     8930                        "Для вывода на печать"
     8931                        skip
     8932                        buf_tmp#list.blank-name
     8933                        skip
     8934                        "обратитесь в службу поддержки."
     8935                      view-as alert-box error title "Ошибка".
     8936                      next.
     8937                    end.
     8938                  end.
     8939                 if lookup (buf_tmp#list.proc-name, listPtrlProcActn) > 0
     8940                 then do:
     8941   define variable vss-include-info311 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8942   do:
     8943     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     8944       (input  v-cntxt-db-num
     8945       ,input  v-cntxt-userid
     8946       ,input  0
     8947       ,input  'actn_inv-ptrl_report':U
     8948       ,input  'global':U
     8949       ,input  0
     8950       ,input  '':U
     8951       ,input  0
     8952       ,input  0
     8953       ,input  0
     8954       ,input  0
     8955       ,input  false
     8956       ,output v-log
     8957       )  .
     8958   end.
     8959                    if not v-log then do:
     8960                      message
     8961                        "Недостаточно прав для вывода на печать"
     8962                        skip
     8963                        buf_tmp#list.blank-name "."
     8964                        skip
     8965                        " "
     8966                        skip
     8967                        "Для вывода на печать"
     8968                        skip
     8969                        buf_tmp#list.blank-name
     8970                        skip
     8971                        "обратитесь в службу поддержки."
     8972                      view-as alert-box error title "Ошибка".
     8973                      next.
     8974                    end.
     8975                  end.
     8976                   find first buf_t_tmp#list no-lock
     8977                        where buf_t_tmp#list.id = temp_form-list.id
     8978                   .
     8979                   assign
     8980                       v-form-amount = v-form-amount + 1
     8981                   .
     8982                   find first buf_trn-doc
     8983                        where buf_trn-doc.doc-code = temp_form-list.doc-code
     8984                   no-lock.
     8985                   if buf_trn-doc.doc-type <> 'инв':U
     8986                   then do:
     8987                       assign
     8988                           v-doc-type = buf_trn-doc.doc-type
     8989                       .
     8990                   end.
     8991                   else do:
     8992                       assign
     8993                           v-doc-type = buf_trn-doc.ext-doc-type
     8994                       .
     8995                   end.
     8996                   assign
     8997                       v-status   = string( buf_trn-doc.status_  )
     8998                       v-internal = string( buf_trn-doc.Internal )
     8999                       v-flag     = string( buf_trn-doc.flag_    )
     9000                   .
     9001                   assign
     9002                       print-graft = ( trim( buf_tmp#list.print-graft ) = "+":U )
     9003                       no-vat      = ( trim( buf_tmp#list.no-vat      ) = "+":U )
     9004                       sort-gr     = ( trim( buf_tmp#list.sort-gr     ) = "+":U )
     9005                       sort-name   = ( trim( buf_tmp#list.sort-name   ) = "+":U )
     9006                       CostPrice   = ( trim( buf_tmp#list.type-price  ) <> "+":U )
     9007                       PrintScale  = ( trim( buf_tmp#list.type-scale  ) = "+":U )
     9008                       PrintRubl   = ( trim( buf_tmp#list.type-val    ) = "+":U )
     9009                       PrintParts  = ( trim( buf_tmp#list.type-parts  ) = "+":U )
     9010                   .
     9011                   run trg/userlog.p (
     9012                         input "printdoc":U
     9013                       , input substitute("&1&2&3&2&4&2&5",buf_tmp#list.blank-name,chr(3),temp_form-list.doc-code, buf_tmp#list.proc-param,
     9014                         string(PrintParts) + ',' + string(print-graft) + ',' + string(no-vat) + ',' + string(print-graft) + ',' + string(sort-gr) + ',' + string(sort-name) + ',' + string(CostPrice) + ',' + string(PrintScale)  + ',' + string(PrintRubl))
     9015                       , input ?
     9016                       , input ?
     9017                       , input ""
     9018                   ) no-error.
     9019                   if error-status :error
     9020                   then do:
     9021                       message return-value + error-status:get-message(1) view-as alert-box title "Ошибка записи истории действий пользователя".
     9022                   end.
     9023                   case num-entries( buf_tmp#list.proc-param )
     9024                   :
     9025                       when 0
     9026                       then do:
     9027                           run value ( buf_tmp#list.proc-name )  (
     9028                                 input p-mainmenu-handle
     9029                               , input recid( buf_trn-doc )
     9030                           ).
     9031                       end.
     9032                       when 1
     9033                       then do:
     9034                           run value ( buf_tmp#list.proc-name ) (
     9035                                 input p-mainmenu-handle
     9036                               , input recid( buf_trn-doc )
     9037                               , input buf_tmp#list.proc-param
     9038                           ).
     9039                       end.
     9040                       when 2
     9041                       then do:
     9042                           run value ( buf_tmp#list.proc-name )  (
     9043                                 input p-mainmenu-handle
     9044                               , input recid( buf_trn-doc )
     9045                               , input entry( 1, buf_tmp#list.proc-param )
     9046                               , input entry( 2, buf_tmp#list.proc-param )
     9047                           ).
     9048                       end.
     9049                       when 3
     9050                       then do:
     9051                           run value ( buf_tmp#list.proc-name )  (
     9052                                 input p-mainmenu-handle
     9053                               , input recid( buf_trn-doc )
     9054                               , input entry( 1, buf_tmp#list.proc-param )
     9055                               , input entry( 2, buf_tmp#list.proc-param )
     9056                               , input entry( 3, buf_tmp#list.proc-param )
     9057                           ).
     9058                       end.
     9059                       when 4
     9060                       then do:
     9061                           run value ( buf_tmp#list.proc-name )  (
     9062                                 input p-mainmenu-handle
     9063                               , input recid( buf_trn-doc )
     9064                               , input entry( 1, buf_tmp#list.proc-param )
     9065                               , input entry( 2, buf_tmp#list.proc-param )
     9066                               , input entry( 3, buf_tmp#list.proc-param )
     9067                               , input entry( 4, buf_tmp#list.proc-param )
     9068                           ).
     9069                       end.
     9070                       when 5
     9071                       then do:
     9072                           run value ( buf_tmp#list.proc-name )  (
     9073                                 input p-mainmenu-handle
     9074                               , input recid( buf_trn-doc )
     9075                               , input entry( 1, buf_tmp#list.proc-param )
     9076                               , input entry( 2, buf_tmp#list.proc-param )
     9077                               , input entry( 3, buf_tmp#list.proc-param )
     9078                               , input entry( 4, buf_tmp#list.proc-param )
     9079                               , input entry( 5, buf_tmp#list.proc-param )
     9080                           ).
     9081                       end.
     9082                       when 6
     9083                       then do:
     9084                           run value ( buf_tmp#list.proc-name )  (
     9085                                 input p-mainmenu-handle
     9086                               , input recid( buf_trn-doc )
     9087                               , input entry( 1, buf_tmp#list.proc-param )
     9088                               , input entry( 2, buf_tmp#list.proc-param )
     9089                               , input entry( 3, buf_tmp#list.proc-param )
     9090                               , input entry( 4, buf_tmp#list.proc-param )
     9091                               , input entry( 5, buf_tmp#list.proc-param )
     9092                               , input entry( 6, buf_tmp#list.proc-param )
     9093                           ).
     9094                       end.
     9095                       when 7
     9096                       then do:
     9097                           run value ( buf_tmp#list.proc-name )  (
     9098                                 input p-mainmenu-handle
     9099                               , input recid( buf_trn-doc )
     9100                               , input entry( 1, buf_tmp#list.proc-param )
     9101                               , input entry( 2, buf_tmp#list.proc-param )
     9102                               , input entry( 3, buf_tmp#list.proc-param )
     9103                               , input entry( 4, buf_tmp#list.proc-param )
     9104                               , input entry( 5, buf_tmp#list.proc-param )
     9105                               , input entry( 6, buf_tmp#list.proc-param )
     9106                               , input entry( 7, buf_tmp#list.proc-param )
     9107                           ).
     9108                       end.
     9109                       when 8
     9110                       then do:
     9111                           run value ( buf_tmp#list.proc-name )  (
     9112                                 input p-mainmenu-handle
     9113                               , input recid( buf_trn-doc )
     9114                               , input entry( 1, buf_tmp#list.proc-param )
     9115                               , input entry( 2, buf_tmp#list.proc-param )
     9116                               , input entry( 3, buf_tmp#list.proc-param )
     9117                               , input entry( 4, buf_tmp#list.proc-param )
     9118                               , input entry( 5, buf_tmp#list.proc-param )
     9119                               , input entry( 6, buf_tmp#list.proc-param )
     9120                               , input entry( 7, buf_tmp#list.proc-param )
     9121                               , input entry( 8, buf_tmp#list.proc-param )
     9122                           ).
     9123                       end.
     9124                   end case.
     9125               end.
     9126           end.
     9127       end.
     9128       if g#quest-print = yes
     9129       Then do:
     9130           os-delete
     9131               value( string( session:temp-directory ) + "rpt" + string( g#report-num ) )
     9132           .
     9133           os-rename
     9134               value(  string( session:temp-directory ) + "$" + string( g#report-num ) )
     9135               value(  string( session:temp-directory ) + "rpt" + string( g#report-num ) )
     9136           .
     9137           os-delete
     9138               value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )
     9139           .
     9140           os-rename
     9141               value(  string( session:temp-directory ) + "$" + string( g#report-num ) + ".txl" )
     9142               value(  string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )
     9143           .
     9144           if v-form-amount = 1
     9145           and ((can-find (first buf_tmp#list where CAPS(buf_tmp#list.proc-name) = "XL-PRTCL.P":U and buf_tmp#list.last-use = yes) = yes  )
     9146           or (can-find (first buf_tmp#list where CAPS(buf_tmp#list.proc-name) = "TICK-DOC.P":U and buf_tmp#list.last-use = yes) = yes  ))
     9147           then do:
     9148   if session :set-wait-state( "" ) then.
     9149           end.
     9150           else do
     9151           :
     9152               find first buf_tmp#list
     9153                    where buf_tmp#list.last-use = yes
     9154               no-error.
     9155               if available buf_tmp#list
     9156               then do:
     9157                   if buf_tmp#list.orient-orientation = "runexcelport":U
     9158                   or buf_tmp#list.orient-orientation = "runexcellans":U
     9159                   then do:
     9160                       os-rename
     9161                           value(  string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )
     9162                           value(  string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".tx_" )
     9163                       .
     9164                   end.
     9165                   case buf_tmp#list.orient-orientation
     9166                   :
     9167                       when "A4port":U
     9168                       or when "runexcelport":U
     9169                       then do:
     9170                           run gbl/prnfilen.w (
     9171                                 input "":U
     9172                               , input 0
     9173                               , input string( session :temp-directory )
     9174                                           + "rpt"
     9175                                           + string( g#report-num )
     9176                               , input buf_tmp#list.orient-font-num
     9177                               , output v-user-action
     9178                               , output v-printed
     9179                           ) .
     9180                       end.
     9181                       when "A4lans":U
     9182                       or when "runexcellans":U
     9183                       or when "":U
     9184                       then do:
     9185                           run gbl/prnfilen.w (
     9186                                 input "":U
     9187                               , input 8
     9188                               , input string( session :temp-directory )
     9189                                           + "rpt"
     9190                                           + string( g#report-num )
     9191                               , input buf_tmp#list.orient-font-num
     9192                               , output v-user-action
     9193                               , output v-printed
     9194                           ) .
     9195                       end.
     9196                   end case.
     9197                   if buf_tmp#list.orient-orientation = "runexcelport":U
     9198                   or buf_tmp#list.orient-orientation = "runexcellans":U
     9199                   then do:
     9200                       os-rename
     9201                           value(  string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".tx_" )
     9202                           value(  string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )
     9203                       .
     9204                   end.
     9205               end.
     9206           end.
     9207       end.
     9208       else do:
     9209           Message 'Задание распечатано'.
     9210       end.
     9211   end.
     9212   END PROCEDURE.
     9213   PROCEDURE reposition-browse :
     9214   do
     9215   with frame Dialog-Frame
     9216   on error undo, return error
     9217   :
     9218       define variable v-focused-row    as integer      no-undo.
     9219       assign
     9220           v-focused-row     = br-table :focused-row in frame Dialog-Frame.
     9221       .
     9222       get next br-table.
     9223       if available tmp#list
     9224       then do:
     9225           if v-focused-row >= br-table :height-chars - 4
     9226           then do:
     9227               br-table :set-repositioned-row( v-focused-row, "ALWAYS" ) in frame Dialog-Frame.
     9228           end.
     9229           else do:
     9230               br-table :set-repositioned-row( v-focused-row + 1, "ALWAYS" ) in frame Dialog-Frame.
     9231           end.
     9232           reposition br-table to rowid rowid( tmp#list ) no-error.
     9233       end.
     9234       else do:
     9235           get last br-table.
     9236       end.
     9237   end.
     9238   END PROCEDURE.
     9239   PROCEDURE reposition-to-recid :
     9240   define input parameter p-ext-system-recid  as recid        no-undo.
     9241   do
     9242   on error undo, return error
     9243   :
     9244       if p-ext-system-recid <> ?
     9245       then do:
     9246           reposition br-table to recid p-ext-system-recid no-error .
     9247       end.
     9248       do with frame Dialog-Frame
     9249       :
     9250           apply "entry":u to browse br-table .
     9251       end.
     9252   end.
     9253   END PROCEDURE.
     9254   PROCEDURE save-form-parameters :
     9255       define variable v-call-point    as character    no-undo.
     9256       define buffer buf_tmp#list          for tmp#list.
     9257       define buffer buf_usr-flt           for ubflt.usr-flt.
     9258       define buffer buf_temp_form-list    for temp_form-list.
     9259   do
     9260   for buf_tmp#list
     9261     , buf_usr-flt
     9262     , buf_temp_form-list
     9263   on error undo, return error
     9264   :
     9265       for each buf_tmp#list
     9266       :
     9267           run get-call-point in this-procedure (
     9268                 input buf_tmp#list.id
     9269               , output v-call-point
     9270           ).
     9271           find first buf_usr-flt exclusive-lock
     9272                where buf_usr-flt.user-name  = v-cntxt-userid
     9273                  and buf_usr-flt.call-point = substitute( "&1,&2,&3,&4"
     9274                                               , buf_tmp#list.blank-name
     9275                                               , buf_tmp#list.sys-key
     9276                                               , buf_tmp#list.sys-key-black
     9277                                               , v-call-point )
     9278           no-error.
     9279           if not available buf_usr-flt
     9280           then do:
     9281               create buf_usr-flt.
     9282               assign
     9283                   buf_usr-flt.user-name  = v-cntxt-userid
     9284                   buf_usr-flt.call-point = substitute( "&1,&2,&3,&4"
     9285                                               , buf_tmp#list.blank-name
     9286                                               , buf_tmp#list.sys-key
     9287                                               , buf_tmp#list.sys-key-black
     9288                                               , v-call-point )
     9289               .
     9290           end.
     9291           assign
     9292               buf_usr-flt.list_ = substitute( "selection,&1,type-parts,&2,type-price,&3,type-scale,&4,type-val,&5,sort-name,&6,sort-gr,&7,print-graft,&8":U
     9293                                       , ( if buf_tmp#list.last-use = yes then "+":U else "-":U )
     9294                                       , ( if index( buf_tmp#list.type-parts , "+":U ) <> 0 then "+":U else "-":U )
     9295                                       , ( if index( buf_tmp#list.type-price , "+":U ) <> 0 then "+":U else "-":U )
     9296                                       , ( if index( buf_tmp#list.type-scale , "+":U ) <> 0 then "+":U else "-":U )
     9297                                       , ( if index( buf_tmp#list.type-val   , "+":U ) <> 0 then "+":U else "-":U )
     9298                                       , ( if index( buf_tmp#list.sort-name  , "+":U ) <> 0 then "+":U else "-":U )
     9299                                       , ( if index( buf_tmp#list.sort-gr    , "+":U ) <> 0 then "+":U else "-":U )
     9300                                       , ( if index( buf_tmp#list.print-graft, "+":U ) <> 0 then "+":U else "-":U )
     9301                                       , ( if index( buf_tmp#list.no-vat     , "+":U ) <> 0 then "+":U else "-":U )
     9302                                       )
     9303           .
     9304       end.
     9305   end.
     9306   END PROCEDURE.
     9307   PROCEDURE select-or-deselect-item :
     9308   define input  parameter p-id as integer    no-undo.
     9309       define buffer buf_tmp#list for tmp#list.
     9310   do
     9311   for buf_tmp#list
     9312   on error undo, return error
     9313   :
     9314       find first buf_tmp#list
     9315            where buf_tmp#list.id = p-id
     9316       .
     9317       if buf_tmp#list.last-use = yes
     9318       then do:
     9319           assign
     9320               buf_tmp#list.last-use = no
     9321           .
     9322       end.
     9323       else do:
     9324           assign
     9325               buf_tmp#list.last-use = yes
     9326           .
     9327       end.
     9328   end.
     9329   END PROCEDURE.
     9330   PROCEDURE test-temp-tables :
     9331       define buffer buf_t_tmp#list      for tmp#list.
     9332   do
     9333   for buf_t_tmp#list
     9334   on error undo, return error
     9335   :
     9336       output to "D:\111.txt".
     9337       for each temp_trn-doc-code no-lock
     9338       :
     9339           put unformatted
     9340               skip substitute( "&1", temp_trn-doc-code.doc-code )
     9341           .
     9342       end.
     9343       put unformatted
     9344           skip "================================================================================"
     9345       .
     9346       for each temp_form-list no-lock
     9347       on error undo, return error
     9348       :
     9349           find first buf_t_tmp#list no-lock
     9350                where buf_t_tmp#list.id = temp_form-list.id
     9351           .
     9352           put unformatted
     9353               skip substitute( "&1 &2 &3 &4 &5 &6 &7 &8", temp_form-list.doc-code, temp_form-list.doc-type, temp_form-list.status_, temp_form-list.internal, temp_form-list.flag, temp_form-list.id, buf_t_tmp#list.blank-name, buf_t_tmp#list.last-use )
     9354           .
     9355       end.
     9356       put unformatted
     9357           skip "================================================================================"
     9358       .
     9359       for each temp_menu-doc_disabled-doc-list no-lock
     9360       on error undo, return error
     9361       :
     9362           put unformatted
     9363               skip substitute( "&1 &2 &3", temp_menu-doc_disabled-doc-list.doc-code, temp_menu-doc_disabled-doc-list.blank-name, temp_menu-doc_disabled-doc-list.reason )
     9364           .
     9365       end.
     9366       output close.
     9367   end.
     9368   END PROCEDURE.
     9369   PROCEDURE ui-disable-all :
     9370   do
     9371   on error undo, return error
     9372   :
     9373   end.
     9374   END PROCEDURE.
     9375   PROCEDURE ui-enable :
     9376       define buffer buf_clients       for ub.clients.
     9377   do
     9378   for buf_clients
     9379   on error undo, return error
     9380   :
     9381       enable
     9382           b-sel
     9383           b-deselect
     9384       with frame Dialog-Frame .
     9385       Tmp#List.blank-name:width in browse br-table = 53.
     9386       Tmp#List.blank-name:resizable in browse br-table = yes.
     9387   end.
     9388   END PROCEDURE.
