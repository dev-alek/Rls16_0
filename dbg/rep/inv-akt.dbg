        1   block-level on error undo, throw.
        2   define input parameter parParentProc     AS WIDGET-HANDLE NO-UNDO.
        3   define input parameter p-trn-doc-recid      as recid    no-undo.
        4   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   def var vss-author      as character no-undo init "$Author: expertek $":U .
        6   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   def var vss-workfile    as character no-undo init "$Workfile: inv-akt.p $":U .
        8   def var vss-archive     as character no-undo init "$Archive: rep/inv-akt.p $":U .
        9   def var vss-description as character no-undo init "Пустографка".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69   procedure cur-time :
       70      define output parameter p-today as date      no-undo .
       71      define output parameter p-time  as integer   no-undo .
       72     do
       73     on error undo, return error
       74     :
       75       define variable v-date1 as date      no-undo .
       76       define variable v-date2 as date      no-undo .
       77       define variable v-time  as integer   no-undo .
       78       assign
       79         v-date1 = today
       80         v-time  = time
       81         v-date2 = today
       82       .
       83       if v-date1 <> v-date2
       84       then do:
       85         assign
       86           v-date1 = today
       87           v-time  = v-time
       88         .
       89       end.
       90       assign
       91         p-today = v-date1
       92         p-time  = v-time
       93       .
       94     end.
       95   end.
       96   function cur-time-date returns character
       97   :
       98     return string(today, '99/99/9999':U) .
       99   end.
      100   function cur-time-mjd returns decimal
      101   :
      102     define variable v-date as date      no-undo .
      103     define variable v-time as integer   no-undo .
      104     run cur-time in this-procedure
      105       (output v-date
      106       ,output v-time
      107       ) .
      108     return integer(v-date) - 2400002 + (v-time / 86400) .
      109   end.
      110   function cur-time-get-ending-index returns integer
      111   (input p-number as integer
      112   )
      113   :
      114     if p-number < 0
      115     or p-number = ?
      116     then do:
      117       return 1 .
      118     end.
      119     define variable v-rest as integer   no-undo .
      120     assign
      121       p-number = p-number modulo 100
      122     .
      123     if p-number < 20
      124     then do:
      125       assign
      126         v-rest = p-number
      127       .
      128     end.
      129     else do:
      130       assign
      131         v-rest = p-number modulo 10
      132       .
      133     end.
      134     case v-rest :
      135       when 1
      136       then do:
      137         return 2 .
      138       end.
      139       when 2 or
      140       when 3 or
      141       when 4
      142       then do:
      143         return 3 .
      144       end.
      145       otherwise do:
      146         return 1 .
      147       end.
      148     end case .
      149   end.
      150   procedure cur-time-mjd-to-date :
      151      define input  parameter i-mjd-diff as decimal no-undo.
      152      define output parameter o-Date     as date    no-undo.
      153      define output parameter o-Time     as integer no-undo.
      154      define variable v-day-number as integer   no-undo .
      155      if    i-mjd-diff < 0
      156         or i-mjd-diff = ?
      157      then do:
      158         return "?" .
      159      end.
      160      assign
      161         v-day-number = truncate(i-mjd-diff,0).
      162         o-Date = date(v-day-number + 2400002).
      163         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      164     .
      165   end.
      166   function cur-time-mjd-to-string returns character
      167   (input p-mjd-diff as decimal
      168   )
      169   :
      170     define variable v-day-number as integer   no-undo .
      171     define variable v-seconds    as integer   no-undo .
      172     define variable v-hour       as integer   no-undo .
      173     define variable v-min        as integer   no-undo .
      174     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      175     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      176     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      177     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      178     if p-mjd-diff < 0
      179     or p-mjd-diff = ?
      180     then do:
      181       return "?" .
      182     end.
      183     assign
      184       v-day-number = integer(truncate(p-mjd-diff,0))
      185       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      186     .
      187     if v-seconds > 86400
      188     then do:
      189       assign
      190         v-seconds = 86400 - 1
      191       .
      192     end.
      193     if v-seconds < 0
      194     then do:
      195       assign
      196         v-seconds = 0
      197       .
      198     end.
      199     assign
      200       v-hour = truncate(v-seconds / 3600, 0)
      201     .
      202     assign
      203       v-seconds = v-seconds modulo 3600
      204     .
      205     assign
      206       v-min = truncate(v-seconds / 60, 0)
      207     .
      208     assign
      209       v-seconds = v-seconds modulo 60
      210     .
      211     return
      212         (if v-day-number <> 0
      213           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      214           else ""
      215         )
      216       + (if v-day-number <> 0 or v-hour <> 0
      217           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      218           else ""
      219         )
      220       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      221           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      222           else ""
      223         )
      224       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      225       .
      226   end.
      227   function cur-time-string returns character
      228   :
      229     define variable v-date as date      no-undo .
      230     define variable v-time as integer   no-undo .
      231     run cur-time in this-procedure
      232       (output v-date
      233       ,output v-time
      234       ) .
      235     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      236   end.
      237   function cur-time-string-sec returns character
      238   :
      239     define variable v-date as date      no-undo .
      240     define variable v-time as integer   no-undo .
      241     run cur-time in this-procedure
      242       (output v-date
      243       ,output v-time
      244       ) .
      245     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      246   end.
      247   function cur-time-custom  returns character
      248   (input p-prefix as character
      249   ,input p-date-format as character
      250   ,input p-delimiter as character
      251   ,input p-time-format as character
      252   ,input p-suffix as character
      253   )
      254   :
      255     define variable v-date as date      no-undo .
      256     define variable v-time as integer   no-undo .
      257     run cur-time in this-procedure
      258       (output v-date
      259       ,output v-time
      260       ) .
      261     return
      262       p-prefix
      263       + string(v-date, p-date-format)
      264       + p-delimiter
      265       + string(v-time, p-time-format)
      266       + p-suffix
      267       .
      268   end.
      269   function cur-time-print  returns character
      270   :
      271     define variable v-date as date      no-undo .
      272     define variable v-time as integer   no-undo .
      273     run cur-time in this-procedure
      274       (output v-date
      275       ,output v-time
      276       ) .
      277     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      278   end.
      279   function cur-time-datetime returns datetime
      280   :
      281     define variable v-char as character no-undo .
      282     define variable v-datetime as datetime no-undo .
      283     v-char = cur-time-string().
      284     v-datetime = datetime(v-char).
      285     return  v-datetime.
      286   end.
      287   function cur-time-string-msec returns character
      288   :
      289     define variable v-date as datetime  no-undo .
      290     v-date = now.
      291     return string(v-date) .
      292   end.
      293   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      294   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      295   define new shared variable RepPathName        as character no-undo .
      296   define new shared variable PrintRubl          as logical   no-undo .
      297   define variable sym1  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      298   define variable sym2  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      299   define variable sym3  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      300   define variable sym4  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      301   define variable sym5  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      302   define variable sym6  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      303   define variable sym7  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      304   define variable sym8  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      305   define variable sym9  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      306   define variable sym10 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      307   define variable sym11 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      308   define variable sym12 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      309   define variable sym13 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      310   define variable sym14 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      311   define variable sym15 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      312   define variable sym16 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      313   define variable sym17 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      314   define variable sym18 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      315   define variable sym19 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      316   define variable sym20 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      317   define variable sym21 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      318   define variable sym22 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      319   define variable sym23 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      320   define variable sym24 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      321   define variable sym25 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      322   define variable sym26 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      323   define variable sym27 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      324   define variable temp1 as integer   no-undo.
      325   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      326   define variable v-waitfram-action01         as character   no-undo .
      327   define variable v-waitfram-action02         as character   no-undo .
      328   define variable v-waitfram-action03         as character   no-undo .
      329   define variable mWaitFramTextBeg            as character   no-undo.
      330   define variable mWaitFramTextEnd            as character   no-undo.
      331   define variable mWaitFramView               as logical     no-undo.
      332   define variable mWaitProcEvent              as logical     no-undo init yes.
      333   define variable mWaitFramInterval           as integer     no-undo init 1 .
      334   define variable mWaitFramStop               as logical     no-undo.
      335   define variable mWaitFramStopUser           as logical     no-undo.
      336   define variable mWaitFramStopTimeOut        as logical     no-undo.
      337   define variable mWaitFramStartProc          as datetime-tz no-undo.
      338   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      339   define button B-WaitFramStop auto-end-key
      340        label "Стоп"
      341        size 10 by 1 tooltip "Остоновить процесс".
      342   define button B-viewProcInfo
      343        label "Информация"
      344        size 15 by 1 tooltip "Информация о процесс".
      345   define frame waitfram
      346     v-waitfram-action01 format "x(72)" no-label skip
      347     v-waitfram-action02 format "x(72)" no-label skip
      348     v-waitfram-action03 format "x(72)" no-label skip
      349     B-viewProcInfo
      350     B-WaitFramStop at row 4 col 30
      351     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      352     .
      353   define new global shared variable mBatchMode as logical no-undo init ?.
      354   define variable mFramBachModHandle as handle no-undo.
      355   mFramBachModHandle = frame waitfram:handle.
      356   define variable mFameOldVis as logical no-undo.
      357   define variable mVisCUrentVin as logical no-undo.
      358   if session:batch-mode
      359   then
      360      mBatchMode = yes.
      361   if mBatchMode = ? then do:
      362     mVisCUrentVin = current-window:visible.
      363     mFameOldVis = mFramBachModHandle:visible.
      364     mFramBachModHandle:visible  = yes.
      365     mBatchMode = mFramBachModHandle:visible ne yes.
      366     mFramBachModHandle:visible = mFameOldVis.
      367     current-window:visible = mVisCUrentVin.
      368   end.
      369    if  log-manager:logfile-name ne ?
      370     then DO:
      371         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      372         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      373         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      374     end.
      375   on choose of B-WaitFramStop in frame waitfram
      376   do:
      377     mWaitFramStop = yes.
      378     mWaitFramStopUser = yes.
      379   end.
      380   function waitfram-check-timeout returns logical():
      381      define variable vtime as int64 no-undo.
      382      if mWaitFramStopTimeOut
      383      then
      384         return yes.
      385      vtime = ( now - mWaitFramStartProc ) / 1000 .
      386      if     mWaitFramTimeOut ne ?
      387         and mWaitFramTimeOut ne 0
      388         and mWaitFramTimeOut lt vtime
      389      then do:
      390         mWaitFramStopTimeOut = yes.
      391      end.
      392      return mWaitFramStopTimeOut.
      393   end.
      394   procedure waitfram-hide :
      395     if not session:batch-mode
      396     then do
      397     on error undo, return error return-value
      398     :
      399       pause 0 before-hide .
      400       if not mBatchMode then
      401         hide frame waitfram .
      402     if     not mWaitFramView
      403        and mWaitProcEvent
      404     then
      405       process events .
      406     end.
      407   end procedure.
      408   procedure waitfram-show :
      409     define input  parameter p-message as character no-undo .
      410     define variable v-left-margin as integer   no-undo .
      411     if not session:batch-mode
      412     then do
      413     on error undo, return error return-value
      414     :
      415       if length(p-message) <= 70 then do:
      416         assign
      417           v-left-margin = integer((70 - length(p-message)) / 2)
      418         .
      419         assign
      420           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      421         .
      422         assign
      423           v-waitfram-action01 = " "
      424           v-waitfram-action02 = " "
      425                                    + fill(" ", v-left-margin)
      426                                    + p-message
      427           v-waitfram-action03 = " "
      428         .
      429       end.
      430       else do:
      431         define variable vRindex1 as integer no-undo.
      432         define variable vRindex2 as integer no-undo.
      433         vRindex1 = r-index(p-message," ",70).
      434         if vRindex1 = 0
      435         then
      436            vRindex1 = 70.
      437         if length(p-message)  <= vRindex1 + 70 then do:
      438           assign
      439             v-waitfram-action01 = " "
      440             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      441             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      442           .
      443         end.
      444         else do:
      445           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      446           if vRindex2 <= vRindex1
      447           then
      448              vRindex2 = vRindex1 + 70.
      449           assign
      450             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      451             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      452             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      453           .
      454         end.
      455       end.
      456       B-viewProcInfo:visible   in frame waitfram = no.
      457       B-viewProcInfo:sensitive in frame waitfram = no.
      458       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      459       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      460       if  (   mWaitFramView
      461          or  mWaitProcEvent)
      462          and not mBatchMode
      463       then
      464          display
      465             v-waitfram-action01 skip
      466             v-waitfram-action02 skip
      467             v-waitfram-action03 skip
      468          with frame waitfram .
      469       if     mWaitFramView
      470          then do:
      471             if     mWaitFramInterval ne ?
      472                and not mBatchMode
      473             then
      474                wait-for go of frame waitfram pause mWaitFramInterval.
      475          end.
      476          else
      477             if     mWaitProcEvent
      478                and not mBatchMode
      479             then
      480                process events .
      481     end.
      482   end procedure.
      483      procedure waitfram-show-this:
      484         define input  parameter iInterval as int64 no-undo.
      485         define variable vtime as int64 no-undo.
      486         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      487         mWaitFramInterval = iInterval.
      488         run waitfram-show (substitute("&1&2 &3&4" ,
      489                                       mWaitFramTextBeg ,
      490                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      491                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      492                                       mWaitFramTextEnd
      493                                      )
      494                           ).
      495      end.
      496      procedure WaitFramRunPause:
      497         define input  parameter iInterval as dec no-undo.
      498         define variable vStart  as datetime-tz no-undo.
      499         define variable vend    as datetime-tz no-undo.
      500         define variable vint as int64 no-undo.
      501         define variable vOk as logical no-undo.
      502         vStart = now.
      503         vend   = vStart.
      504         publish "WaitFramPause" (iInterval,output vOk).
      505         vend   =  now.
      506         vint = vend - vStart.
      507         vint = iInterval - vint / 1000.
      508         if     not mWaitFramStop
      509            and (   vint > 0
      510                 or (    not vOk
      511                     and iInterval eq ?
      512                     )
      513                 )
      514         then
      515            run waitfram-show-this (iInterval).
      516         vend   =  now.
      517         vint = vend - vStart.
      518         vint = iInterval - vint / 1000.
      519         if     not mWaitFramStop
      520            and vint > 0
      521         then do:
      522            run gbl/pause.p (vint * 1000).
      523         end.
      524         if iInterval ne ?
      525         then
      526            publish "WaitFramStop".
      527         waitfram-check-timeout().
      528      end.
      529      procedure WaitFramWaitFor:
      530         define input  parameter iInterval as dec no-undo.
      531         assign
      532            mWaitFramStartProc   = now
      533            mWaitFramStopUser    = no
      534            mWaitFramStopTimeOut = no
      535         .
      536         block-wait:
      537         do while not mWaitFramStop:
      538            run WaitFramRunPause (iInterval).
      539            if  waitfram-check-timeout()
      540            then do:
      541               leave block-wait.
      542            end.
      543         end.
      544         run waitfram-hide.
      545      end.
      546   procedure waitfram-join :
      547     define input  parameter p-line-1  as character no-undo .
      548     define input  parameter p-line-2  as character no-undo .
      549     define input  parameter p-line-3  as character no-undo .
      550     define output parameter p-message as character no-undo .
      551     do
      552     on error undo, return error return-value
      553     :
      554       assign
      555         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      556                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      557                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      558       .
      559     end.
      560   end procedure.
      561   function waitfram-join-function returns character
      562     (input p-line-1 as character
      563     ,input p-line-2 as character
      564     ,input p-line-3 as character
      565     ).
      566     define variable v-message as character no-undo .
      567     run waitfram-join in this-procedure
      568       (input  p-line-1
      569       ,input  p-line-2
      570       ,input  p-line-3
      571       ,output v-message
      572       ) .
      573     return v-message .
      574   end function .
      575     define variable g#report-num as integer   no-undo .
      576     run get-report-num  in parParentProc ( output g#report-num ).
      577     define variable g#quest-print as logical   no-undo .
      578     run get-quest-print in parParentProc ( output g#quest-print ).
      579     define variable g#log as logical   no-undo .
      580   define shared variable  sort-name    as logical  no-undo.
      581   define shared variable  sort-gr      as logical  no-undo.
      582   define buffer buf_doc-line  for doc-line.
      583   define buffer buf_trn-doc   for trn-doc.
      584   define buffer buf_goods     for goods.
      585   define buffer This_Object   for clients .
      586   define variable v-lines-counter as int no-undo.
      587   def temp-table temp_goods no-undo
      588       field obj-type      as character
      589       field unit-base     as character
      590       field obj-code      as integer
      591       field gds-code      as integer
      592       field artic         as character
      593       field prod-type     as character
      594       field prod-code     as integer
      595       field gds-name      as character
      596       field full-grp-name as character
      597       field qnty          as decimal
      598       index byart is primary unique artic prod-type prod-code
      599       index byname gds-name artic
      600       index bygrp full-grp-name
      601   .
      602   define stream OutStream.
      603   define variable v-line-string   as character            no-undo.
      604   define variable UndLine         as character            no-undo.
      605   define variable v-doc-string    as character no-undo .
      606   define variable v-qnty          as decimal   no-undo .
      607    DEFINE FRAME zapas
      608           sym1                 column-label ":"            format "x(1)"                   space(0)
      609           v-lines-counter      column-label "№"            format ">>>>>>>9":C             space(0)
      610           sym2                 column-label ":"            format "x(1)"                   space(0)
      611           temp_goods.artic     column-label "Артикул"      format "X(17)"                  space(0)
      612           sym3                 column-label ":"            format "x(1)"                   space(0)
      613           temp_goods.gds-name  column-label "Наименование" format "X(70)"  space(0)
      614           sym4                 column-label ":"            format "x(1)"                   space(0)
      615           temp_goods.unit-base column-label "ед.изм"       format "X(6)"                   space(0)
      616           sym5                 column-label ":"            format "x(1)"                   space(0)
      617           temp_goods.qnty      column-label "Факт. кол-во" format "->>>>>>>>>>>.<<<"       space(0)
      618           sym6                 column-label ":"            format "x(1)"                   space(0)
      619       HEADER
      620           cur-time-print()                                                        at 5    format "X(35)"
      621           v-doc-string                                                            at 67   format "X(40)"
      622           string( "Страница " + string( PAGE-NUMBER( OutStream ), ">>>>>>9") )    at 111  format "X(17)"
      623       skip
      624           v-line-string  format "X(120)"  with width 136 down stream-io use-text NO-BOX.
      625   if session :set-wait-state( "compiler" ) then.
      626   output stream OutStream to value( string( session:temp-directory +
      627                                        "rpt" + string( g#report-num ) ) )
      628                                        page-size 62 .
      629       assign
      630         v-line-string = fill("-", 129)
      631         UndLine       = fill("_", 129)
      632       .
      633       find first buf_trn-doc no-lock where recid( buf_trn-doc ) = p-trn-doc-recid .
      634       assign v-doc-string = "По документу N " + buf_trn-doc.doc-code + " от " + string( buf_trn-doc.doc-date, "99/99/9999" ) .
      635     find first This_Object  WHERE This_Object.obj-type = buf_trn-doc.obj-type AND This_Object.obj-code = buf_trn-doc.obj-code  NO-LOCK.
      636     find first  clients      WHERE clients.obj-type     = 'орг':U           AND clients.obj-code     = buf_trn-doc.host-code NO-LOCK.
      637         PUT STREAM OutStream
      638            v-line-string format  "X(100)" skip
      639            "| "  "Предприятие, организация " format  "X(30)" AT 15 "| " AT 50  "Склад " format  "X(20)" AT 75 "|" AT 100 skip
      640            v-line-string format  "X(100)" skip
      641            "| "  CAPS( clients.obj-name ) + " (" + string(clients.obj-code) + ")" format  "X(47)"  "| " AT 50
      642            string(  This_Object.obj-name  + " (" + string(This_Object.obj-code) + ")" ) format  "X(47)"  "| " AT 100  skip
      643            v-line-string format  "X(100)" skip (2)
      644           space(15) string( "Акт приема-передачи товарно-материальных ценностей № "
      645                   + buf_trn-doc.doc-code + string( buf_trn-doc.doc-date, "99/99/9999")
      646                   + (if buf_trn-doc.status_ <> 'факт':U then string( "(" + CAPS(buf_trn-doc.status_) + ")" ) else "")
      647                                       ) format "X(100)" skip (2)
      648         .
      649       form with frame zapas .
      650       form header
      651           v-line-string format "X(120)" at 1 skip   "Продолжение - на следующей странице" at 30 skip
      652           with frame BottomFrame width 136 page-bottom no-labels no-box .
      653       view stream OutStream frame BottomFrame .
      654       for each buf_doc-line no-lock where buf_doc-line.doc-code =  buf_trn-doc.doc-code :
      655         find first buf_goods no-lock
      656           where buf_goods.artic      = buf_doc-line.artic
      657             and buf_goods.prod-type  = buf_doc-line.prod-type
      658             and buf_goods.prod-code  = buf_doc-line.prod-code
      659         no-error.
      660         create temp_goods no-error.
      661         assign
      662           temp_goods.obj-type         = buf_doc-line.obj-type
      663           temp_goods.obj-code         = buf_doc-line.obj-code
      664           temp_goods.artic            = buf_doc-line.artic
      665           temp_goods.prod-type        = buf_doc-line.prod-type
      666           temp_goods.prod-code        = buf_doc-line.prod-code
      667           temp_goods.qnty             = buf_doc-line.doc-qnty
      668           temp_goods.gds-code         = ( if available buf_goods then buf_goods.gds-code else 0 )
      669           temp_goods.gds-name         = ( if available buf_goods then buf_goods.gds-name else "" )
      670           temp_goods.full-grp-name    = ( if available buf_goods then trim( buf_goods.grp-name," /\" ) else "" )
      671           temp_goods.unit-base        = buf_goods.unit-base
      672         .
      673       end.
      674       if sort-gr = yes then do:
      675         if sort-name = no  then do:
      676           for each temp_goods
      677             break by temp_goods.full-grp-name
      678                   by temp_goods.artic
      679                   by temp_goods.prod-type
      680                   by temp_goods.prod-code
      681           :
      682             if first-of( temp_goods.full-grp-name ) then do:
      683               run print-group-line in this-procedure ( input temp_goods.full-grp-name ).
      684             end.
      685             run print-line in this-procedure .
      686           end.
      687         end.
      688         else do:
      689           for each temp_goods
      690             break by temp_goods.full-grp-name
      691                 by temp_goods.gds-name
      692           :
      693             if first-of( temp_goods.full-grp-name )  then  run print-group-line in this-procedure ( input temp_goods.full-grp-name ).
      694             run print-line in this-procedure .
      695           end.
      696         end.
      697       end.
      698       else do:
      699         if sort-name = no then do:
      700           for each temp_goods  use-index byart :
      701             run print-line in this-procedure .
      702           end.
      703         end.
      704         else do:
      705           for each temp_goods use-index byname :
      706             run print-line in this-procedure .
      707           end.
      708         end.
      709       end.
      710       put  stream outstream  v-line-string  format "X(120)" .
      711       display stream OutStream
      712         Sym1 Sym5 Sym6
      713         "Итого:" @ temp_goods.gds-name
      714         v-qnty @ temp_goods.qnty
      715       with frame zapas.
      716       down stream  OutStream 1 with frame zapas.
      717       put  stream outstream  v-line-string  format "X(120)" .
      718       put  stream outstream skip
      719                 "   Все ценности, поименованные  в  настоящей  инвентаризационной  описи  с комиссией проверены в натуре в моем (нашем)" SKIP
      720                 "личном присутствии  и внесены в опись, в связи с чем претензий к инвентаризационной комиссии не имею (не имеем). " SKIP
      721                 "Товарно-материальные ценности, перечисленные в описи, находятся на моем (нашем) ответственном хранении." SKIP(1)
      722                 "   Сдал: " "Принял: " at 70 SKIP(1)
      723                 UndLine   format "X(25)" AT 1  UndLine   format "X(25)" AT 30 UndLine   format "X(25)" AT 60 UndLine   format "X(25)" AT 90 SKIP
      724                 "Фамилия" format "X(25)" AT 10 "подпись" format "X(25)" AT 40 "Фамилия" format "X(25)" AT 70 "подпись" format "X(25)" AT 100  SKIP
      725                 UndLine   format "X(25)" AT 1  UndLine   format "X(25)" AT 30 UndLine   format "X(25)" AT 60 UndLine   format "X(25)" AT 90 SKIP
      726                 "Фамилия" format "X(25)" AT 10 "подпись" format "X(25)" AT 40 "Фамилия" format "X(25)" AT 70 "подпись" format "X(25)" AT 100  SKIP
      727                 "Указанные в настоящей описи данные и расчеты проверил"
      728                     UndLine format "X(25)" AT 10 UndLine format "X(25)"   AT 40 UndLine format "X(50)"               AT 70 SKIP
      729                 "должность" format "X(25)" AT 10 "подпись" format "X(25)" AT 40 "расшифровка подписи" format "X(50)" AT 70 SKIP
      730                 "<<       >> _________________        г. " .
      731       HIDE   stream OutStream FRAME BottomFrame .
      732       HIDE   STREAM OutStream FRAME ZAPAS .
      733       Output stream OutStream close.
      734   if session :set-wait-state( "" ) then.
      735   if g#quest-print = false
      736   then do:
      737     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
      738                                         7, (if 0 >= 8 then 2 else 0), 0, 0,
      739                                         OUTPUT g#log ).
      740   end.
      741   else do:
      742     os-command silent
      743       value( "COPY /b " +
      744         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
      745         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
      746         string( session:temp-directory) +  "$" + string( g#report-num )
      747                 ) .
      748     os-command silent
      749       value( "COPY /b " +
      750         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
      751         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
      752         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
      753                 ) .
      754   end.
      755   procedure print-line :
      756     do on error undo, return error :
      757       assign
      758         v-lines-counter = v-lines-counter + 1
      759         v-qnty = v-qnty + temp_goods.qnty
      760       .
      761   If Integer(50) = 0 Then Temp1  = 100  .
      762                         Else Temp1 = Integer(50) .
      763        IF ( v-lines-counter modulo Temp1 = 0 ) AND ( v-lines-counter >= Temp1 ) then
      764            RUN waitfram-show( "Обработано строк : " + string( v-lines-counter )) .
      765       display stream OutStream
      766         Sym1  Sym2 Sym3 Sym4 Sym5 Sym6
      767         v-lines-counter
      768         temp_goods.artic
      769         temp_goods.gds-name
      770         temp_goods.unit-base
      771         temp_goods.qnty
      772       with frame zapas.
      773       down stream  OutStream 1 with frame zapas.
      774     end.
      775   end procedure.
      776   procedure print-group-line :
      777     define input parameter p-full-grp-name  as character        no-undo.
      778     do on error undo, return error :
      779      DOWN stream OutStream 1 with FRAME zapas .
      780      PUT stream OutStream UNFORMATTED String("_______________Группа : " + TRIM(CAPS(p-full-grp-name)) + UndLine)  FORMAT "X(120)" skip  .
      781     end.
      782   end procedure.
