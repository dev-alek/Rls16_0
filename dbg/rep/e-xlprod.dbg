      631   procedure prn-lib-prn-file :
      632     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      633     define input parameter p-DIsabledoptions as integer no-undo .
      634     define variable v-report-name as character no-undo .
      635     define variable v-user-action as character no-undo .
      636     define variable v-printed     as logical   no-undo .
      637     define variable v-exist       as logical   no-undo .
      638     do
      639       on error undo, return error
      640       :
      641       run prn-lib-get-report-name  in this-procedure (
      642         input parParentProc
      643         ,output v-report-name
      644         ).
      645   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      646   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      647     (input  v-report-name
      648     ,input  2
      649     ,output v-exist
      650     )  .
      651       if NOT v-exist then
      652       DO:
      653         Message
      654           "Нет заданий на печать ! "
      655           view-as alert-box .
      656         Return  .
      657       End.
      658       run gbl/prnfilen.w
      659         (input  ""
      660         ,input  p-DisabledOptions
      661         ,input  string(v-report-name )
      662         ,input  7
      663         ,output v-user-action
      664         ,output v-printed
      665         ) .
      666       if v-printed then
      667       do:
      668         return "YES" .
      669       end.
      670       else
      671       do:
      672         return "NO" .
      673       end.
      674     end.
      675   end procedure.
      676   procedure prn-lib-open-stream :
      677     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      678     define input parameter p-page-size    as integer no-undo .
      679     define input parameter p-is-stream    as logical no-undo .
      680     define input parameter p-append       as logical no-undo .
      681     define variable v-report-name as character no-undo .
      682     do
      683       on error undo, return error
      684       :
      685       run prn-lib-get-report-name  in this-procedure (
      686         input parParentProc
      687         ,output v-report-name
      688         ).
      689       if p-is-stream then
      690       do:
      691         if p-append then
      692         do:
      693           output stream PrnLibStream to value( v-report-name )
      694             page-size value(p-page-size) append .
      695         end.
      696         if not p-append then
      697         do:
      698           output stream PrnLibStream to value( v-report-name )
      699             page-size value(p-page-size) .
      700         end.
      701       end.
      702       if not p-is-stream then
      703       do:
      704         if p-append then
      705         do:
      706           output to value( v-report-name )
      707             page-size value(p-page-size) append .
      708         end.
      709         if not p-append then
      710         do:
      711           output to value( v-report-name )
      712             page-size value(p-page-size) .
      713         end.
      714       end.
      715     end.
      716   end procedure.
      717   procedure prn-lib-open-exp :
      718     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      719     define input parameter p-is-stream    as logical no-undo .
      720     define input parameter p-is-append    as logical no-undo .
      721     define output parameter p-ReportFileName as char init "report" no-undo.
      722     define output parameter p-process as logical no-undo .
      723     define variable glog as logical no-undo .
      724     do
      725       on error undo, return error
      726       :
      727       SYSTEM-DIALOG GET-FILE p-ReportFileName
      728         TITLE      "Укажите путь"
      729         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      730         ASK-OVERWRITE
      731         CREATE-TEST-FILE
      732         SAVE-AS
      733         USE-FILENAME
      734         DEFAULT-EXTENSION "txt"
      735         UPDATE glog
      736         .
      737       if not glog then  return.
      738       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      739       if p-is-stream then
      740       do:
      741         if p-is-append then
      742         do:
      743           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      744         end.
      745         else
      746         do:
      747           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      748         end.
      749       end.
      750       else
      751       do:
      752         if p-is-append then
      753         do:
      754           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      755         end.
      756         else
      757         do:
      758           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      759         end.
      760       end.
      761       p-process = yes.
      762     end.
      763   end procedure.
      764   procedure prn-lib-get-report-name :
      765     define input parameter parParentProc  as widget-handle no-undo.
      766     define output parameter p-report-name as character no-undo .
      767     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      768   end procedure.
      769   procedure prn-lib-reportviewer-report-name :
      770     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      771     define input parameter p-report-name-html as character no-undo .
      772     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      773   end procedure.
      774   procedure prn-lib-reportviewer :
      775     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      776     define input parameter p-report-name-html as character no-undo .
      777     define input parameter p-param        as character no-undo .
      778     define variable v-excel           as character no-undo init 'TRUE' .
      779     define variable v-value-character as character no-undo .
      780     define variable v-value-integer   as character no-undo .
      781     define variable v-value-date      as date      no-undo .
      782     define variable v-value-decimal   as decimal   no-undo .
      783     define variable rep-excel         as logical   no-undo .
      784     define variable excel-string      as character no-undo .
      785     define variable v-param-type      as character no-undo .
      786     define variable v-tth             as handle    no-undo .
      787     run adm/shattri.p (
      788       input "get":U
      789       ,input  ""
      790       ,input  0
      791       ,input  'report-glob':U
      792       ,input  'rep-excel':U
      793       ,output v-value-character
      794       ,output v-value-date
      795       ,output v-value-decimal
      796       ,output v-value-integer
      797       ,output rep-excel
      798       ,output v-param-type
      799       ,INPUT-OUTPUT table-handle v-tth
      800       )  .
      801     if rep-excel then v-excel = "TRUE" .
      802     else v-excel = "FALSE" .
      803     if p-param eq ""
      804     then
      805        p-param = "EXCEL:" + v-excel.
      806     else
      807        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      808     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      809   end procedure.
      810   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      811   define variable v-waitfram-action01         as character   no-undo .
      812   define variable v-waitfram-action02         as character   no-undo .
      813   define variable v-waitfram-action03         as character   no-undo .
      814   define variable mWaitFramTextBeg            as character   no-undo.
      815   define variable mWaitFramTextEnd            as character   no-undo.
      816   define variable mWaitFramView               as logical     no-undo.
      817   define variable mWaitProcEvent              as logical     no-undo init yes.
      818   define variable mWaitFramInterval           as integer     no-undo init 1 .
      819   define variable mWaitFramStop               as logical     no-undo.
      820   define variable mWaitFramStopUser           as logical     no-undo.
      821   define variable mWaitFramStopTimeOut        as logical     no-undo.
      822   define variable mWaitFramStartProc          as datetime-tz no-undo.
      823   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      824   define button B-WaitFramStop auto-end-key
      825        label "Стоп"
      826        size 10 by 1 tooltip "Остоновить процесс".
      827   define button B-viewProcInfo
      828        label "Информация"
      829        size 15 by 1 tooltip "Информация о процесс".
      830   define frame waitfram
      831     v-waitfram-action01 format "x(72)" no-label skip
      832     v-waitfram-action02 format "x(72)" no-label skip
      833     v-waitfram-action03 format "x(72)" no-label skip
      834     B-viewProcInfo
      835     B-WaitFramStop at row 4 col 30
      836     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      837     .
      838   define new global shared variable mBatchMode as logical no-undo init ?.
      839   define variable mFramBachModHandle as handle no-undo.
      840   mFramBachModHandle = frame waitfram:handle.
      841   define variable mFameOldVis as logical no-undo.
      842   define variable mVisCUrentVin as logical no-undo.
      843   if session:batch-mode
      844   then
      845      mBatchMode = yes.
      846   if mBatchMode = ? then do:
      847     mVisCUrentVin = current-window:visible.
      848     mFameOldVis = mFramBachModHandle:visible.
      849     mFramBachModHandle:visible  = yes.
      850     mBatchMode = mFramBachModHandle:visible ne yes.
      851     mFramBachModHandle:visible = mFameOldVis.
      852     current-window:visible = mVisCUrentVin.
      853   end.
      854    if  log-manager:logfile-name ne ?
      855     then DO:
      856         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      857         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      858         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      859     end.
      860   on choose of B-WaitFramStop in frame waitfram
      861   do:
      862     mWaitFramStop = yes.
      863     mWaitFramStopUser = yes.
      864   end.
      865   function waitfram-check-timeout returns logical():
      866      define variable vtime as int64 no-undo.
      867      if mWaitFramStopTimeOut
      868      then
      869         return yes.
      870      vtime = ( now - mWaitFramStartProc ) / 1000 .
      871      if     mWaitFramTimeOut ne ?
      872         and mWaitFramTimeOut ne 0
      873         and mWaitFramTimeOut lt vtime
      874      then do:
      875         mWaitFramStopTimeOut = yes.
      876      end.
      877      return mWaitFramStopTimeOut.
      878   end.
      879   procedure waitfram-hide :
      880     if not session:batch-mode
      881     then do
      882     on error undo, return error return-value
      883     :
      884       pause 0 before-hide .
      885       if not mBatchMode then
      886         hide frame waitfram .
      887     if     not mWaitFramView
      888        and mWaitProcEvent
      889     then
      890       process events .
      891     end.
      892   end procedure.
      893   procedure waitfram-show :
      894     define input  parameter p-message as character no-undo .
      895     define variable v-left-margin as integer   no-undo .
      896     if not session:batch-mode
      897     then do
      898     on error undo, return error return-value
      899     :
      900       if length(p-message) <= 70 then do:
      901         assign
      902           v-left-margin = integer((70 - length(p-message)) / 2)
      903         .
      904         assign
      905           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      906         .
      907         assign
      908           v-waitfram-action01 = " "
      909           v-waitfram-action02 = " "
      910                                    + fill(" ", v-left-margin)
      911                                    + p-message
      912           v-waitfram-action03 = " "
      913         .
      914       end.
      915       else do:
      916         define variable vRindex1 as integer no-undo.
      917         define variable vRindex2 as integer no-undo.
      918         vRindex1 = r-index(p-message," ",70).
      919         if vRindex1 = 0
      920         then
      921            vRindex1 = 70.
      922         if length(p-message)  <= vRindex1 + 70 then do:
      923           assign
      924             v-waitfram-action01 = " "
      925             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      926             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      927           .
      928         end.
      929         else do:
      930           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      931           if vRindex2 <= vRindex1
      932           then
      933              vRindex2 = vRindex1 + 70.
      934           assign
      935             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      936             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      937             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      938           .
      939         end.
      940       end.
      941       B-viewProcInfo:visible   in frame waitfram = no.
      942       B-viewProcInfo:sensitive in frame waitfram = no.
      943       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      944       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      945       if  (   mWaitFramView
      946          or  mWaitProcEvent)
      947          and not mBatchMode
      948       then
      949          display
      950             v-waitfram-action01 skip
      951             v-waitfram-action02 skip
      952             v-waitfram-action03 skip
      953          with frame waitfram .
      954       if     mWaitFramView
      955          then do:
      956             if     mWaitFramInterval ne ?
      957                and not mBatchMode
      958             then
      959                wait-for go of frame waitfram pause mWaitFramInterval.
      960          end.
      961          else
      962             if     mWaitProcEvent
      963                and not mBatchMode
      964             then
      965                process events .
      966     end.
      967   end procedure.
      968      procedure waitfram-show-this:
      969         define input  parameter iInterval as int64 no-undo.
      970         define variable vtime as int64 no-undo.
      971         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      972         mWaitFramInterval = iInterval.
      973         run waitfram-show (substitute("&1&2 &3&4" ,
      974                                       mWaitFramTextBeg ,
      975                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      976                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      977                                       mWaitFramTextEnd
      978                                      )
      979                           ).
      980      end.
      981      procedure WaitFramRunPause:
      982         define input  parameter iInterval as dec no-undo.
      983         define variable vStart  as datetime-tz no-undo.
      984         define variable vend    as datetime-tz no-undo.
      985         define variable vint as int64 no-undo.
      986         define variable vOk as logical no-undo.
      987         vStart = now.
      988         vend   = vStart.
      989         publish "WaitFramPause" (iInterval,output vOk).
      990         vend   =  now.
      991         vint = vend - vStart.
      992         vint = iInterval - vint / 1000.
      993         if     not mWaitFramStop
      994            and (   vint > 0
      995                 or (    not vOk
      996                     and iInterval eq ?
      997                     )
      998                 )
      999         then
     1000            run waitfram-show-this (iInterval).
     1001         vend   =  now.
     1002         vint = vend - vStart.
     1003         vint = iInterval - vint / 1000.
     1004         if     not mWaitFramStop
     1005            and vint > 0
     1006         then do:
     1007            run gbl/pause.p (vint * 1000).
     1008         end.
     1009         if iInterval ne ?
     1010         then
     1011            publish "WaitFramStop".
     1012         waitfram-check-timeout().
     1013      end.
     1014      procedure WaitFramWaitFor:
     1015         define input  parameter iInterval as dec no-undo.
     1016         assign
     1017            mWaitFramStartProc   = now
     1018            mWaitFramStopUser    = no
     1019            mWaitFramStopTimeOut = no
     1020         .
     1021         block-wait:
     1022         do while not mWaitFramStop:
     1023            run WaitFramRunPause (iInterval).
     1024            if  waitfram-check-timeout()
     1025            then do:
     1026               leave block-wait.
     1027            end.
     1028         end.
     1029         run waitfram-hide.
     1030      end.
     1031   procedure waitfram-join :
     1032     define input  parameter p-line-1  as character no-undo .
     1033     define input  parameter p-line-2  as character no-undo .
     1034     define input  parameter p-line-3  as character no-undo .
     1035     define output parameter p-message as character no-undo .
     1036     do
     1037     on error undo, return error return-value
     1038     :
     1039       assign
     1040         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1041                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1042                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1043       .
     1044     end.
     1045   end procedure.
     1046   function waitfram-join-function returns character
     1047     (input p-line-1 as character
     1048     ,input p-line-2 as character
     1049     ,input p-line-3 as character
     1050     ).
     1051     define variable v-message as character no-undo .
     1052     run waitfram-join in this-procedure
     1053       (input  p-line-1
     1054       ,input  p-line-2
     1055       ,input  p-line-3
     1056       ,output v-message
     1057       ) .
     1058     return v-message .
     1059   end function .
