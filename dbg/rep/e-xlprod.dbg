     1137   def buffer ret-doc for ub.trn-doc.
     1138   define variable cas-shft as logical no-undo.
     1139   define variable cas-num as integer no-undo.
     1140   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1141   PROCEDURE no-benq.
     1142   DEFINE OUTPUT PARAMETER found as logical init no.
     1143   define buffer buf_chk-doc for ub.chk-doc.
     1144   FOR EACH obj-list WHERE
     1145           obj-list.obj-type = 'маг':U NO-LOCK :
     1146     CASE X-Radio-Task > 1 :
     1147       WHEN YES THEN DO:
     1148         FOR EACH buf_chk-doc NO-LOCK WHERE
     1149                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1150                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1151                 (
     1152                   buf_chk-doc.shift-date >= X-date-start AND
     1153                   buf_chk-doc.shift-date <= X-date-end)
     1154                   AND
     1155                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1156           IF X-Radio-Task = 3 AND
     1157           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     1158             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     1159           IF X-Radio-Task = 4 AND
     1160           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1161           found = yes.
     1162           return.
     1163         END.
     1164       END.
     1165       WHEN NO THEN DO:
     1166         FOR EACH buf_chk-doc NO-LOCK WHERE
     1167               buf_chk-doc.obj-type = obj-list.obj-type AND
     1168               buf_chk-doc.obj-code = obj-list.obj-code AND
     1169               buf_chk-doc.chk-date >= X-date-start AND
     1170               buf_chk-doc.chk-date <= X-date-end   AND
     1171               (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1172           found = yes.
     1173           return.
     1174         END.
     1175        END.
     1176      END CASE.
     1177    END.
     1178   END PROCEDURE.
     1179   PROCEDURE no-benqi.
     1180   DEFINE OUTPUT PARAMETER found as logical init no.
     1181   define buffer buf_chk-doc for ub.chk-doc.
     1182   define buffer buf_inkas for ub.inkas.
     1183   FOR EACH obj-list WHERE
     1184         obj-list.obj-type = 'маг':U NO-LOCK :
     1185     CASE X-Radio-Task > 1 :
     1186       WHEN YES THEN DO:
     1187         FOR EACH buf_chk-doc No-LOCK WHERE
     1188                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1189                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1190                 (
     1191                   buf_chk-doc.shift-date >= X-date-start AND
     1192                   buf_chk-doc.shift-date <= X-date-end)
     1193                   AND
     1194                   buf_Chk-doc.out-code = ? AND
     1195                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1196           IF X-Radio-Task = 3 AND
     1197           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     1198             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     1199           IF X-Radio-Task = 4 AND
     1200           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1201           found = yes.
     1202           return.
     1203         END.
     1204         FOR EACH buf_inkas No-LOCK WHERE
     1205                   buf_inkas.obj-type = obj-list.obj-type AND
     1206                   buf_inkas.obj-code = obj-list.obj-code AND
     1207                   (
     1208                   buf_inkas.shift-date >= X-date-start AND
     1209                   buf_inkas.shift-date <= X-date-end):
     1210           if buf_inkas.status_ = 'факт':U
     1211           or buf_inkas.status_ = 'запрос':U then next.
     1212           IF X-Radio-Task = 3 AND
     1213           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
     1214             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
     1215           IF X-Radio-Task = 4 AND
     1216           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
     1217           found = yes.
     1218           return.
     1219         END.
     1220       END.
     1221       WHEN NO THEN DO:
     1222         FOR EACH buf_chk-doc NO-LOCK WHERE
     1223                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1224                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1225                 buf_chk-doc.chk-date >= X-date-start AND
     1226                 buf_chk-doc.chk-date <= X-date-end   AND
     1227                 buf_Chk-doc.out-code = ? AND
     1228                 (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1229           found = yes.
     1230           return.
     1231         END.
     1232         FOR EACH buf_inkas NO-LOCK WHERE
     1233                 buf_inkas.obj-type = obj-list.obj-type AND
     1234                 buf_inkas.obj-code = obj-list.obj-code AND
     1235                 buf_inkas.doc-date >= X-date-start AND
     1236                 buf_inkas.doc-date <= X-date-end :
     1237           if buf_inkas.status_ = 'факт':U
     1238           or buf_inkas.status_ = 'запрос':U then next.
     1239           found = yes.
     1240           return.
     1241         END.
     1242       END.
     1243     END CASE.
     1244   END.
     1245   END PROCEDURE.
     1246   PROCEDURE no-benq-i.
     1247   DEFINE OUTPUT PARAMETER found as logical init no.
     1248   define buffer buf_inkas for ub.inkas.
     1249   CASE X-Radio-Task > 1:
     1250     WHEN YES then do:
     1251       FOR EACH obj-list WHERE
     1252               obj-list.obj-type = 'маг':U NO-LOCK :
     1253         FOR EACH buf_inkas NO-LOCK WHERE
     1254                 buf_inkas.obj-type = obj-list.obj-type AND
     1255                 buf_inkas.obj-code = obj-list.obj-code AND
     1256                 buf_inkas.status_ = 'факт':U AND
     1257                 (
     1258                 buf_inkas.shift-date >= X-date-start AND
     1259                 buf_inkas.shift-date <= X-date-end):
     1260           IF X-Radio-Task = 3 AND
     1261           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
     1262             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
     1263           IF X-Radio-Task = 4 AND
     1264           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
     1265           found = yes.
     1266           return.
     1267         END.
     1268     END.
     1269     END.
     1270     WHEN NO THEN DO:
     1271       FOR EACH obj-list WHERE
     1272               obj-list.obj-type = 'маг':U NO-LOCK :
     1273         FOR EACH buf_inkas NO-LOCK WHERE
     1274                 buf_inkas.obj-type = obj-list.obj-type AND
     1275                 buf_inkas.obj-code = obj-list.obj-code AND
     1276                 buf_inkas.status_ = 'факт':U AND
     1277                 buf_inkas.doc-date >= X-date-start AND
     1278                 buf_inkas.doc-date <= X-date-end :
     1279            found = yes.
     1280            return.
     1281         END.
     1282       END.
     1283     END.
     1284   END CASE.
     1285   END PROCEDURE.
     1286   PROCEDURE no-benq-i-office.
     1287   DEFINE OUTPUT PARAMETER found as logical init no.
     1288   define buffer buf_sale-doc for ub.sale-doc.
     1289   CASE X-Radio-Task > 1:
     1290     WHEN YES then do:
     1291       FOR EACH obj-list WHERE
     1292               obj-list.obj-type = 'маг':U NO-LOCK :
     1293         FOR EACH buf_sale-doc NO-LOCK WHERE
     1294                  buf_Sale-doc.obj-type = obj-list.obj-type
     1295              AND buf_sale-doc.obj-code = obj-list.obj-code
     1296              AND buf_sale-doc.status_ = 'факт':U
     1297              AND buf_sale-doc.chr-office = 'у':U
     1298              AND (
     1299                 buf_sale-doc.shift-date >= X-date-start
     1300                 AND
     1301                 buf_sale-doc.shift-date <= X-date-end):
     1302           IF X-Radio-Task = 3 AND
     1303           ((buf_sale-doc.shift-date = X-date-start AND buf_sale-doc.shift-num < X-shift-Start) OR
     1304             (buf_sale-doc.shift-date = X-date-end AND  buf_sale-doc.shift-num > X-shift-End) ) THEN NEXT.
     1305           IF X-Radio-Task = 4 AND
     1306           (buf_sale-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1307           found = yes.
     1308           return.
     1309         END.
     1310       END.
     1311     END.
     1312     WHEN NO THEN DO:
     1313       FOR EACH obj-list WHERE
     1314               obj-list.obj-type = 'маг':U NO-LOCK :
     1315         FOR EACH buf_sale-doc NO-LOCK WHERE
     1316                 buf_sale-doc.obj-type = obj-list.obj-type
     1317            AND  buf_sale-doc.obj-code = obj-list.obj-code
     1318            AND  buf_sale-doc.status_ = 'факт':U
     1319            AND  buf_sale-doc.chr-office = 'у':U
     1320            AND  buf_sale-doc.doc-date >= X-date-start
     1321            AND  buf_sale-doc.doc-date <= X-date-end :
     1322           found = yes.
     1323           return.
     1324         END.
     1325       END.
     1326     END.
     1327   END CASE.
     1328   END PROCEDURE.
     1329   DEFINE VARIABLE h_s-month AS HANDLE NO-UNDO.
     1330   DEFINE FRAME F-Main
     1331       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1332            SIDE-LABELS NO-UNDERLINE THREE-D
     1333            AT COL 1 ROW 1
     1334            SIZE 40 BY 11.88.
     1335   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1336   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1337   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1338   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1339   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1340   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1341   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1342   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1343       ASSIGN adm-object-hdl = FRAME F-Main:HANDLE.
     1344   RUN ensure-broker.
     1345   THIS-PROCEDURE:ADM-DATA =
     1346        'ADM1.1~`':U +
     1347        'SmartObject~`':U +
     1348        'FRAME~`':U +
     1349        'NO ~`':U +
     1350        '~`':U +
     1351        '~`':U +
     1352        '~`':U +
     1353        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1354           + "~`":U +
     1355        'Layout,Hide-on-Init~`':U +
     1356        '~`':U +
     1357        '~`':U +
     1358        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1359        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1360            THEN "^^":U
     1361        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1362             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1363   PROCEDURE adm-apply-entry :
     1364     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1365   END PROCEDURE.
     1366   PROCEDURE adm-destroy :
     1367    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1368   END PROCEDURE.
     1369   PROCEDURE adm-disable :
     1370       DISABLE  WITH FRAME F-Main.
     1371       RUN dispatch ('disable-fields':U).
     1372       RUN set-attribute-list ('ENABLED=no':U).
     1373       RETURN.
     1374   END PROCEDURE.
     1375   PROCEDURE adm-edit-attribute-list :
     1376         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
     1377         RETURN.
     1378   END PROCEDURE.
     1379   PROCEDURE adm-enable :
     1380       ENABLE UNLESS-HIDDEN  WITH FRAME F-Main.
     1381       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1382       RUN set-attribute-list ('ENABLED=yes':U).
     1383       RETURN.
     1384   END PROCEDURE.
     1385   PROCEDURE adm-exit :
     1386        RUN notify ('exit':U).
     1387     RETURN.
     1388   END PROCEDURE.
     1389   PROCEDURE adm-hide :
     1390     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1391   END PROCEDURE.
     1392   PROCEDURE adm-initialize :
     1393     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1394   END PROCEDURE.
     1395   PROCEDURE adm-show-errors :
     1396       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1397       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1398           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1399       END.
     1400       RETURN.
     1401   END PROCEDURE.
     1402   PROCEDURE adm-UIB-mode :
     1403     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1404   END PROCEDURE.
     1405   PROCEDURE adm-view :
     1406     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1407   END PROCEDURE.
     1408   PROCEDURE dispatch :
     1409       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1410       RUN broker-dispatch IN adm-broker-hdl
     1411           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1412       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1413   END PROCEDURE.
     1414   PROCEDURE ensure-broker :
     1415   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1416   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1417   DO:
     1418       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1419       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1420   END.
     1421   END PROCEDURE.
     1422   PROCEDURE get-attribute :
     1423     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1424     RUN broker-get-attribute IN adm-broker-hdl
     1425         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1426     RETURN RETURN-VALUE.
     1427   END PROCEDURE.
     1428   PROCEDURE get-attribute-list :
     1429     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1430     RUN broker-get-attribute-list IN adm-broker-hdl
     1431         (INPUT THIS-PROCEDURE,
     1432          INPUT ?,
     1433          OUTPUT p-attr-list) NO-ERROR.
     1434     RETURN.
     1435   END PROCEDURE.
     1436   PROCEDURE new-state :
     1437     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1438     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1439     RETURN.
     1440   END PROCEDURE.
     1441   PROCEDURE notify :
     1442     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1443     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1444     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1445         RETURN "ADM-ERROR":U.
     1446     RETURN.
     1447   END PROCEDURE.
     1448   PROCEDURE set-attribute-list :
     1449     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1450     RUN ensure-broker.
     1451     RUN broker-set-attribute-list IN adm-broker-hdl
     1452         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1453     RETURN.
     1454   END PROCEDURE.
     1455   PROCEDURE set-position :
     1456       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1457       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1458       IF VALID-HANDLE(adm-object-hdl) THEN
     1459       DO:
     1460           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     1461           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     1462           DO:
     1463             IF p-row = 0 THEN p-row =
     1464               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     1465             IF p-col = 0 THEN p-col =
     1466               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     1467           END.
     1468           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     1469           DO:
     1470             parent-hdl = adm-object-hdl:PARENT.
     1471             IF p-row = 0 THEN p-row =
     1472               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     1473                 parent-hdl:ROW.
     1474             IF p-col = 0 THEN p-col =
     1475               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     1476                 parent-hdl:COL.
     1477           END.
     1478           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     1479           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     1480         ASSIGN adm-object-hdl:ROW    =   p-row
     1481                adm-object-hdl:COLUMN =   p-col.
     1482       END.
     1483       RETURN.
     1484   END PROCEDURE.
     1485   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
     1486       STRING(adm-object-hdl)).
     1487   PAUSE 0 BEFORE-HIDE.
     1488   PROCEDURE adm-change-page :
     1489     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
     1490     END PROCEDURE.
     1491   PROCEDURE delete-page :
     1492     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
     1493     RUN broker-delete-page IN adm-broker-hdl
     1494         (INPUT THIS-PROCEDURE, INPUT p-page#).
     1495     END PROCEDURE.
     1496   PROCEDURE init-object :
     1497     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
     1498     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
     1499     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
     1500     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
     1501     RUN broker-init-object IN adm-broker-hdl
     1502         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
     1503          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
     1504     RETURN.
     1505   END PROCEDURE.
     1506   PROCEDURE init-pages :
     1507     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
     1508     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1509         INPUT p-page-list) NO-ERROR.
     1510     END PROCEDURE.
     1511   PROCEDURE select-page :
     1512     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
     1513     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1514         INPUT p-page#) NO-ERROR.
     1515     END PROCEDURE.
     1516   PROCEDURE view-page :
     1517     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
     1518     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1519         INPUT p-page#).
     1520     END PROCEDURE.
     1521   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1522     run mainmenu_getcntxt in my-handle
     1523       (output v-cntxt-db-num
     1524       ,output v-cntxt-userid
     1525       ,output v-cntxt-level
     1526       ,output v-cntxt-host-code-obj
     1527       ,output v-cntxt-obj-type
     1528       ,output v-cntxt-obj-code
     1529       ,output v-cntxt-db-num-obj
     1530       ,output v-cntxt-is-admin
     1531       ) .
     1532   parparentproc = my-handle.
     1533   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1534     run mainmenu_getcntxt in parparentproc
     1535       (output v-cntxp-db-num
     1536       ,output v-cntxp-userid
     1537       ,output v-cntxp-level
     1538       ,output v-cntxp-curr-host-code
     1539       ,output v-cntxp-obj-type
     1540       ,output v-cntxp-obj-code
     1541       ,output v-cntxp-db-num-obj
     1542       ,output v-cntxp-is-admin
     1543       ) .
     1544     if (v-cntxp-obj-type = 'маг':U or v-cntxp-obj-type = 'скл':U) and
     1545        v-cntxp-obj-code <> 0 then do:
     1546   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1547     (input  'is-prt'
     1548     ,input  0
     1549     ,input  ''
     1550     ,input  0
     1551     ,input  ''
     1552     ,input  ''
     1553     ,input  ''
     1554     ,input  yes
     1555     ,output v-cntxp-conf-par
     1556     ,output v-cntxp-par-type
     1557     ) no-error .
     1558       case v-cntxp-obj-type :
     1559         when 'скл':U then do:
     1560           find first bf-cntxp_store where bf-cntxp_store.obj-code = v-cntxp-obj-code no-lock.
     1561           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_store.host-code no-lock.
     1562           assign
     1563             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_store.doc-prt
     1564             v-cntxp-price-calc      = bf-cntxp_store.price-calc
     1565             v-cntxp-inout-price     = bf-cntxp_store.inout-price
     1566             v-cntxp-unit-cli-perm   = bf-cntxp_store.unit-cli-perm
     1567             v-cntxp-out-rate        = bf-cntxp_store.out-rate
     1568             v-cntxp-out-line-discnt = bf-cntxp_store.out-line-discnt
     1569             v-cntxp-in-ov           = bf-cntxp_store.in-ov
     1570             v-cntxp-in-perm         = bf-cntxp_store.in-perm
     1571             v-cntxp-no-eq           = bf-cntxp_store.no-eq
     1572             v-cntxp-rsrv-time       = bf-cntxp_store.rsrv-time
     1573             v-cntxp-load-time       = bf-cntxp_store.load-time
     1574             v-cntxp-holidays        = bf-cntxp_store.holidays
     1575             v-cntxp-in-pay          = bf-cntxp_store.in-pay
     1576             v-cntxp-out-pay         = bf-cntxp_store.out-pay
     1577             v-cntxp-ret-pay         = bf-cntxp_store.ret-pay
     1578             v-cntxp-ret-sup-pay     = bf-cntxp_store.ret-sup-pay
     1579             v-cntxp-down-pay        = bf-cntxp_store.down-pay
     1580             v-cntxp-inv-pay         = bf-cntxp_store.inv-pay
     1581             v-cntxp-chk-pay         = bf-cntxp_store.chk-pay
     1582             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
     1583             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
     1584             .
     1585         end.
     1586         when 'маг':U then do:
     1587           find first bf-cntxp_shop where bf-cntxp_shop.obj-code = v-cntxp-obj-code no-lock.
     1588           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_shop.host-code no-lock.
     1589           assign
     1590             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_shop.doc-prt
     1591             v-cntxp-price-calc      = bf-cntxp_shop.price-calc
     1592             v-cntxp-inout-price     = bf-cntxp_shop.inout-price
     1593             v-cntxp-unit-cli-perm   = bf-cntxp_shop.unit-cli-perm
     1594             v-cntxp-out-rate        = bf-cntxp_shop.out-rate
     1595             v-cntxp-out-line-discnt = bf-cntxp_shop.out-line-discnt
     1596             v-cntxp-in-ov           = bf-cntxp_shop.in-ov
     1597             v-cntxp-in-perm         = bf-cntxp_shop.in-perm
     1598             v-cntxp-no-eq           = bf-cntxp_shop.no-eq
     1599             v-cntxp-rsrv-time       = bf-cntxp_shop.rsrv-time
     1600             v-cntxp-load-time       = bf-cntxp_shop.load-time
     1601             v-cntxp-holidays        = bf-cntxp_shop.holidays
     1602             v-cntxp-in-pay          = bf-cntxp_shop.in-pay
     1603             v-cntxp-out-pay         = bf-cntxp_shop.out-pay
     1604             v-cntxp-ret-pay         = bf-cntxp_shop.ret-pay
     1605             v-cntxp-ret-sup-pay     = bf-cntxp_shop.ret-sup-pay
     1606             v-cntxp-down-pay        = bf-cntxp_shop.down-pay
     1607             v-cntxp-inv-pay         = bf-cntxp_shop.inv-pay
     1608             v-cntxp-chk-pay         = bf-cntxp_shop.chk-pay
     1609             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
     1610             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
     1611             .
     1612         end.
     1613       end case.
     1614     end.
     1615   if not this-procedure :persistent
     1616   then do:
     1617     message
     1618       vss-workfile vss-revision vss-description skip
     1619       "Ошибка при запуске процедуры" skip
     1620       "Данную процедуру следует запускать только с параметром persistent" skip
     1621       view-as alert-box error .
     1622     undo, return error .
     1623   end.
     1624   PROCEDURE adm-create-objects :
     1625     DEFINE VARIABLE adm-current-page  AS INTEGER NO-UNDO.
     1626     RUN get-attribute IN THIS-PROCEDURE ('Current-Page':U).
     1627     ASSIGN adm-current-page = INTEGER(RETURN-VALUE).
     1628     CASE adm-current-page:
     1629       WHEN 0 THEN DO:
     1630          RUN init-object IN THIS-PROCEDURE (
     1631                INPUT  'rep/s-month.w':U ,
     1632                INPUT  FRAME F-Main:HANDLE ,
     1633                INPUT  '':U ,
     1634                OUTPUT h_s-month ).
     1635       END.
     1636     END CASE.
     1637   END PROCEDURE.
     1638   PROCEDURE adm-row-available :
     1639     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1640     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1641     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1642     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1643     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1644     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1645     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1646     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1647     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1648     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1649     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1650     IF adm-updating-record THEN RETURN.
     1651     RUN get-attribute ('FIELDS-ENABLED':U).
     1652     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1653     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1654         OUTPUT link-handle) NO-ERROR.
     1655     IF link-handle = "":U THEN
     1656         RETURN.
     1657     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1658     IF NUM-ENTRIES(link-handle) > 1 THEN
     1659         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1660             "encountered more than one RECORD-SOURCE.":U SKIP
     1661             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1662                VIEW-AS ALERT-BOX ERROR.
     1663     RUN get-attribute ('Key-Name':U).
     1664     key-name = RETURN-VALUE.
     1665     IF key-name = "":U THEN key-name = ?.
     1666     IF key-name NE ? THEN DO:
     1667       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1668         NO-ERROR.
     1669       IF key-value NE ? THEN
     1670         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1671     END.
     1672   IF VALID-HANDLE (adm-object-hdl) THEN
     1673       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1674   RUN notify IN THIS-PROCEDURE ('row-available':U).
     1675   END PROCEDURE.
     1676   PROCEDURE disable_UI :
     1677     HIDE FRAME F-Main.
     1678     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1679   END PROCEDURE.
     1680   PROCEDURE enable_UI :
     1681   END PROCEDURE.
     1682   PROCEDURE My-report :
     1683   DEFINE VAR II as INTEGER No-UNDO.
     1684   DEFINE VAR CurrDay as  integer     no-undo.
     1685   DEFINE VAR StrBuf as char no-undo.
     1686   DEFINE VAR XLStrBuf as char no-undo.
     1687   define variable     Retail             as  log         no-undo.
     1688   define variable     Opt                 as  log         no-undo.
     1689   define variable     NotInc          as  log     no-undo.
     1690   define variable glog as logical no-undo .
     1691   define variable p-XL-delim as character no-undo .
     1692   define variable type-par1 as character no-undo .
     1693   define variable tmp-var1  as character no-undo .
     1694   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1695   empty temp-table thbjattr_thbj-attr.
     1696   run adm/shattri.p (
     1697      input "get":U
     1698     ,input v-cntxt-obj-type
     1699     ,input v-cntxt-obj-code
     1700     ,input 'report-firm':U
     1701     ,input  ""
     1702     ,output v-value-character
     1703     ,output v-value-date
     1704     ,output v-value-decimal
     1705     ,output v-value-integer
     1706     ,output v-value-logical
     1707     ,output par-type
     1708     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1709     ) no-error .
     1710   for each thbjattr_thbj-attr :
     1711       if thbjattr_thbj-attr.prop-code = 'XL-delim'  then tmp-var1   = thbjattr_thbj-attr.property-value-character.
     1712   end.
     1713   IF tmp-var1 = "" then p-XL-delim = ";".
     1714   else p-XL-delim = tmp-var1.
     1715   run Assign-Frame in h_s-month.
     1716   IF X-SelectGood = 1 then do:
     1717       message "Вас действительно интересуют" skip
     1718               "ВСЕ производители ?"
     1719       view-as alert-box question buttons YES-NO update glog .
     1720   end.
     1721   else
     1722   glog = TRUE .
     1723   if NOT glog then return .
     1724   run My-var.
     1725   run no-benqi(OUTPUT NotInc).
     1726   for each prod_sum:
     1727       delete prod_sum.
     1728   end.
     1729   for each objects:
     1730       delete objects.
     1731   end.
     1732   assign
     1733   Retail = FALSE
     1734   Opt = FALSE
     1735   .
     1736   run waitfram-show in this-procedure ( "Подождите ..." ) .
     1737   FOR EACH obj-list :
     1738       FIND FIRST ub.clients WHERE ub.clients.obj-type = obj-list.obj-type AND
     1739                          ub.clients.obj-code = obj-list.obj-code NO-LOCK .
     1740       CREATE objects .
     1741       assign
     1742       objects.obj-type = ub.clients.obj-type
     1743       objects.obj-code = ub.clients.obj-code
     1744       objects.obj-name = REPLACE(REPLACE(ub.clients.obj-name, chr(44), ""), p-XL-delim, "")
     1745       .
     1746       if X-SElectGood = 1
     1747       then
     1748       FOR EACH cli-prod WHERE cli-prod.is-prod = TRUE NO-LOCK :
     1749           CREATE prod_sum .
     1750           assign
     1751           prod_sum.obj-type = obj-list.obj-type
     1752           prod_sum.obj-code = obj-list.obj-code
     1753           prod_sum.obj-name = cli-prod.obj-name
     1754           prod_sum.name-attr =
     1755           cli-prod.obj-name + cli-prod.obj-type + string( cli-prod.obj-code )
     1756           prod_sum.prod-type = cli-prod.obj-type
     1757           prod_sum.prod-code = cli-prod.obj-code .
     1758       END.
     1759       else do:
     1760           FOR EACH g#cli No-LOCK :
     1761               CREATE prod_sum .
     1762               assign
     1763               prod_sum.obj-type = obj-list.obj-type
     1764               prod_sum.obj-code = obj-list.obj-code
     1765               prod_sum.obj-name = g#cli.obj-name
     1766               prod_sum.name-attr = g#cli.obj-name + g#cli.obj-type + string( g#cli.obj-code )
     1767               prod_sum.prod-type = g#cli.obj-type
     1768               prod_sum.prod-code = g#cli.obj-code
     1769               .
     1770           END .
     1771       END.
     1772       if can-find( FIRST ub.inkas WHERE
     1773                          ub.inkas.obj-type = obj-list.obj-type AND
     1774                          ub.inkas.obj-code = obj-list.obj-code AND
     1775                          ub.inkas.doc-date >= vStartPoint AND
     1776                          ub.inkas.doc-date <= vEndPoint AND
     1777                          ub.inkas.status_ = 'факт':U )
     1778       then
     1779       FOR EACH ub.inkas WHERE
     1780                         ub.inkas.obj-type = obj-list.obj-type AND
     1781                         ub.inkas.obj-code = obj-list.obj-code AND
     1782                         ub.inkas.doc-date >= vStartPoint AND
     1783                         ub.inkas.doc-date <= vEndPoint AND
     1784                         ub.inkas.status_ = 'факт':U      NO-LOCK :
     1785           PROCESS EVENTS .
     1786           ACCUMULATE     ub.inkas.inkas-code ( COUNT ) .
     1787           if ( ( ACCUM COUNT ub.inkas.inkas-code ) modulo 5 ) = 0 AND
     1788                ( ACCUM COUNT ub.inkas.inkas-code ) >= 5
     1789           then
     1790           run waitfram-show in this-procedure ( obj-list.obj-type + " N" + string( obj-list.obj-code ) +
     1791                           ", обработано отчетов по продаже : " +
     1792                           string( ACCUM COUNT ub.inkas.inkas-code ) ) .
     1793           FIND FIRST ub.trn-doc where ub.trn-doc.doc-code = ub.inkas.inkas-code no-lock no-error.
     1794           FIND FIRST ret-doc where ret-doc.doc-code = ub.trn-doc.out-code no-lock no-error.
     1795           FOR EACH ub.gds-dtl NO-LOCK WHERE ub.gds-dtl.doc-code = ub.trn-doc.doc-code
     1796               BREAK BY ub.gds-dtl.prod-type BY ub.gds-dtl.prod-code:
     1797               IF FIRST-OF (ub.gds-dtl.prod-code) then do:
     1798                   FIND FIRST prod_sum WHERE
     1799                   prod_sum.prod-type = ub.gds-dtl.prod-type AND
     1800                   prod_sum.prod-code = ub.gds-dtl.prod-code NO-ERROR .
     1801               end.
     1802               if available prod_sum then do:
     1803                   assign
     1804                   prod_sum.tot-sum = prod_sum.tot-sum +
     1805                                      ub.gds-dtl.doc-qnty * ub.gds-dtl.cur-base.
     1806               end.
     1807           END.
     1808           IF AVAILABLE RET-DOC THEN DO:
     1809             FOR EACH ub.gds-dtl NO-LOCK WHERE ub.gds-dtl.doc-code = ret-doc.doc-code
     1810                 BREAK BY ub.gds-dtl.prod-type BY ub.gds-dtl.prod-code:
     1811                 IF FIRST-OF (ub.gds-dtl.prod-code) then do:
     1812                     FIND FIRST prod_sum WHERE
     1813                               prod_sum.prod-type = ub.gds-dtl.prod-type AND
     1814                               prod_sum.prod-code = ub.gds-dtl.prod-code NO-ERROR .
     1815                 end.
     1816                 if available prod_sum then do:
     1817                     assign
     1818                     prod_sum.tot-sum = prod_sum.tot-sum -
     1819                                       ub.gds-dtl.doc-qnty * ub.gds-dtl.cur-base.
     1820                 end.
     1821             END.
     1822           END.
     1823       END.
     1824       if can-find( FIRST ub.trn-doc WHERE
     1825                          ub.trn-doc.obj-type = obj-list.obj-type AND
     1826                          ub.trn-doc.obj-code = obj-list.obj-code AND
     1827                          ub.trn-doc.internal = no AND
     1828                        ( ub.trn-doc.doc-type = 'рас':U OR ub.trn-doc.doc-type = 'возврат':U ) AND
     1829                          ub.trn-doc.status_ = 'факт':U AND
     1830                          ub.trn-doc.fact-date >= vStartPoint AND
     1831                          ub.trn-doc.fact-date <= vEndPoint AND
     1832                          ub.trn-doc.ext-doc-type <> 'ep':U AND
     1833                          ub.trn-doc.discnt-type <> 'касс':U )
     1834        then
     1835        FOR EACH ub.trn-doc WHERE
     1836                 ub.trn-doc.obj-type = obj-list.obj-type AND
     1837                 ub.trn-doc.obj-code = obj-list.obj-code AND
     1838                 ub.trn-doc.internal = no AND
     1839               ( ub.trn-doc.doc-type = 'рас':U OR ub.trn-doc.doc-type = 'возврат':U ) AND
     1840                 ub.trn-doc.status_ = 'факт':U AND
     1841                 ub.trn-doc.fact-date >= vStartPoint AND
     1842                 ub.trn-doc.fact-date <= vEndPoint AND
     1843                 ub.trn-doc.ext-doc-type <> 'ep':U AND
     1844                 ub.trn-doc.discnt-type <> 'касс':U NO-LOCK :
     1845           PROCESS EVENTS .
     1846           ACCUMULATE     ub.trn-doc.doc-code ( COUNT ) .
     1847           if ( ( ACCUM COUNT ub.trn-doc.doc-code ) modulo 25 ) = 0 AND
     1848                ( ACCUM COUNT ub.trn-doc.doc-code ) >= 25
     1849           then
     1850           run waitfram-show in this-procedure (obj-list.obj-type + " N" + string( obj-list.obj-code ) +
     1851                            ", обработано накладных : " +
     1852                          string( ACCUM COUNT ub.trn-doc.doc-code ) ) .
     1853           FOR EACH ub.doc-line WHERE ub.doc-line.doc-code = ub.trn-doc.doc-code NO-LOCK :
     1854               FIND FIRST prod_sum WHERE
     1855                          prod_sum.prod-type = ub.doc-line.prod-type AND
     1856                          prod_sum.prod-code = ub.doc-line.prod-code NO-ERROR .
     1857               if available prod_sum then do:
     1858                   FOR EACH gds-dtl WHERE
     1859                            gds-dtl.doc-code = ub.doc-line.doc-code AND
     1860                            gds-dtl.prod-code = ub.doc-line.prod-code AND
     1861                            gds-dtl.prod-type = ub.doc-line.prod-type AND
     1862                            gds-dtl.artic = ub.doc-line.artic    NO-LOCK :
     1863                       ACCUMULATE (if v-curr-r-b = 'base':U
     1864                                   then ub.gds-dtl.price-base
     1865                                   else ub.gds-dtl.price-rubl) * ub.gds-dtl.fact-qnty ( TOTAL ) .
     1866                   END .
     1867                   assign
     1868                   prod_sum.tot-sum = prod_sum.tot-sum +
     1869                                    ( if can-do( 'рас':U, ub.trn-doc.doc-type )
     1870                                      then ( ACCUM TOTAL
     1871                                                       (if v-curr-r-b = 'base':U
     1872                                                       then ub.gds-dtl.price-base
     1873                                                       else ub.gds-dtl.price-rubl)
     1874                                                       * ub.gds-dtl.fact-qnty )
     1875                                      else ( - ( ACCUM TOTAL
     1876                                                       (if v-curr-r-b = 'base':U
     1877                                                       then ub.gds-dtl.price-base
     1878                                                       else ub.gds-dtl.price-rubl)
     1879                                                       * ub.gds-dtl.fact-qnty ) ) ) .
     1880                end.
     1881           END.
     1882        END .
     1883   END.
     1884   run waitfram-hide in this-procedure .
     1885   if can-find( first prod_sum where prod_sum.tot-sum <> 0 ) then do:
     1886       run gbl/numtomon.p ( month( vStartPoint ), output StrBuf ) .
     1887       run prn-lib-open-stream  in this-procedure (
     1888                                                   input parParentProc
     1889                                                   ,input 0
     1890                                                   ,input yes
     1891                                                   ,input no
     1892                                                   ).
     1893        PUT stream PrnLibStream space(20)
     1894        "Реализация товаров в магазинах" skip
     1895        space(20) "в действовавших продажных ценах" skip
     1896        space(21) "по фирмам ( производителям )" skip(1)
     1897        space(23) "за " StrBuf format "x(9)" string( year( vStartPoint ), ">>>9" ) format "x(4)"
     1898                  "  года  " skip(1)
     1899        space(20) ( if NotInc then "( сформирован НЕ ПО ВСЕМ ЧЕКАМ )" else " " ) format "x(40)" skip
     1900        .
     1901        assign
     1902        StrBuf = string( p-XL-delim + string( "ФИРМА", "x(19)" ) + p-XL-delim )
     1903        sheetf.Excel-COlumn-Lable = string( "ФИРМА", "x(19)" ) + chr(44)
     1904        sheetf.sizes = "10" + chr(44)
     1905          .
     1906        FOR EACH objects BY objects.obj-type BY objects.obj-code :
     1907           assign
     1908           StrBuf = StrBuf + string( caps( trim( objects.obj-type ) ) + ".  N " +
     1909                    string ( objects.obj-code, ">>>>>>9" ) + p-XL-delim , "x(16)" )
     1910           sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + string( caps( trim( objects.obj-type ) ) + ".  N " +
     1911                            string ( objects.obj-code, ">>>>>>9" ) + chr(44) , "x(16)" )
     1912           sheetf.SIzes = sheetf.Sizes + "16" + chr(44)
     1913           .
     1914        END .
     1915        assign
     1916        StrBuf = StrBuf + "     ИТОГО" + fill( " ", 5 ) + p-XL-delim
     1917        sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + "     ИТОГО" + fill( " ", 5 ) + chr(44)
     1918        sheetf.SIzes = sheetf.SIzes + "16" + chr(44)
     1919        .
     1920        EXPORT stream PrnLibStream StrBuf .
     1921        ASSIGN
     1922        StrBuf = p-XL-delim + fill( " ", 18 ) + p-XL-delim
     1923        sheetf.EXcel-COlumn-Lable = sheetf.EXcel-COlumn-Lable + chr(10) + chr(44)
     1924        .
     1925        FOR EACH objects BY objects.obj-type BY objects.obj-code :
     1926            assign
     1927            StrBuf = StrBuf + string( string( objects.obj-name, "x(15)" ) + p-XL-delim , "x(16)" )
     1928            sheetf.Excel-COlumn-Lable = sheetf.Excel-COlumn-Lable + string( replace( objects.obj-name, chr(44), "":U), "x(15)" ) + chr(44)
     1929            .
     1930        END .
     1931        assign
     1932        StrBuf = StrBuf + fill( " ", 15 ) + p-XL-delim
     1933        sheetf.Excel-COlumn-Lable = sheetf.Excel-COlumn-Lable + chr(44)
     1934        str3 = " "
     1935        .
     1936        EXPORT stream PrnLibStream StrBuf .
     1937        PUT stream PrnLibStream "" skip .
     1938        run rep/extitle.p (1).
     1939        FOR EACH prod_sum BREAK BY prod_sum.name-attr
     1940                                BY prod_sum.obj-type
     1941                                BY prod_sum.obj-code :
     1942           if first-of( prod_sum.name-attr )
     1943           then
     1944           assign
     1945           StrBuf = string( string( p-XL-delim + prod_sum.obj-name, "X(19)" ) + p-XL-delim )
     1946           XLStrBuf = string( string(prod_sum.obj-name, "X(19)" ) + CHR(9) )
     1947           .
     1948           ACCUMULATE prod_sum.tot-sum ( SUB-TOTAL BY prod_sum.name-attr ) .
     1949           assign
     1950           StrBuf = StrBuf + ( if prod_sum.tot-sum <> 0
     1951                               then string( prod_sum.tot-sum, "->>>,>>>,>>9.99" )
     1952                               else fill( " ", 15 ) ) + p-XL-delim
     1953           XLStrBuf = XLStrBuf + ( if prod_sum.tot-sum <> 0
     1954                               then string( prod_sum.tot-sum )
     1955                               else "":U) + CHR(9)
     1956           .
     1957           if last-of( prod_sum.name-attr ) then do:
     1958              assign
     1959              StrBuf = StrBuf +
     1960                      ( if ( ACCUM SUB-TOTAL BY prod_sum.name-attr prod_sum.tot-sum ) <> 0
     1961                        then string( ACCUM SUB-TOTAL BY prod_sum.name-attr prod_sum.tot-sum, "->>>,>>>,>>9.99" )
     1962                        else fill( " ", 15 ) ) + p-XL-delim
     1963              XLStrBuf = XLStrBuf +
     1964                      ( if ( ACCUM SUB-TOTAL BY prod_sum.name-attr prod_sum.tot-sum ) <> 0
     1965                        then string( ACCUM SUB-TOTAL BY prod_sum.name-attr prod_sum.tot-sum )
     1966                        else "":U) + CHR(9)
     1967              .
     1968              EXPORT stream PrnLibStream StrBuf .
     1969              if Make-Excel then  put   stream ForExcel unformatted
     1970              XlStrBuf
     1971              SKIP
     1972              .
     1973           end.
     1974        END.
     1975       PUT stream PrnLibStream "" skip .
     1976       assign
     1977       StrBuf = p-XL-delim + string("ИТОГО:", "X(18)") + p-XL-delim
     1978       XLStrBuf = string("ИТОГО:", "X(18)") + CHR(9)
     1979       .
     1980       FOR EACH prod_sum BREAK BY prod_sum.obj-type BY prod_sum.obj-code :
     1981           ACCUMULATE
     1982           prod_sum.tot-sum ( SUB-TOTAL BY prod_sum.obj-code )
     1983           prod_sum.tot-sum ( TOTAL )
     1984           .
     1985           if last-of( prod_sum.obj-code )
     1986           then
     1987           assign
     1988           StrBuf = StrBuf +
     1989                    string( ACCUM SUB-TOTAL BY prod_sum.obj-code prod_sum.tot-sum, "->>>,>>>,>>9.99" ) +
     1990                    p-XL-delim
     1991           XLStrBuf = XLStrBuf +
     1992                    string( ACCUM SUB-TOTAL BY prod_sum.obj-code prod_sum.tot-sum ) +
     1993                    CHR(9)
     1994           .
     1995       END.
     1996       assign
     1997       StrBuf = StrBuf +
     1998                string( ACCUM TOTAL prod_sum.tot-sum, "->>>,>>>,>>9.99" ) + p-XL-delim
     1999       XLStrBuf = XLStrBuf +
     2000                string( ACCUM TOTAL prod_sum.tot-sum) + CHR(9)
     2001        .
     2002       EXPORT stream PrnLibStream StrBuf .
     2003       PUT stream PrnLibStream " " SKIP.
     2004       if Make-Excel then  put   stream ForExcel unformatted
     2005        XLstrBuf
     2006       SKIP.
     2007       output stream PrnLibStream CLOSE .
     2008       if Make-Excel then output stream ForExcel close.
     2009        run prn-lib-prn-file in this-procedure (
     2010                                             input my-handle
     2011                                             ,input 11
     2012                                             ).
     2013       run waitfram-hide in this-procedure .
     2014   end.
     2015   else do:
     2016       run waitfram-hide in this-procedure .
     2017       message "Не было никакой выручки на выбранных объектах" skip
     2018               "в течение заданного Вами периода времени."
     2019       view-as alert-box INFORMATION .
     2020   end.
     2021   FOR EACH prod_sum :
     2022       delete prod_sum .
     2023   END.
     2024   FOR EACH objects :
     2025       delete objects .
     2026   END.
     2027   END PROCEDURE.
     2028   PROCEDURE My-Var :
     2029   run Assign-Frame in h_s-month.
     2030   DEFINE VAR StrBuf as char no-undo.
     2031   define variable     NotInc          as  log     no-undo.
     2032   Assign
     2033    STR-obj-type = ''
     2034    STR-obj-code = ''
     2035    STR-obj-name = ''
     2036    STR-obj      = ''.
     2037   IF X-SelectGood = 1
     2038   then
     2039   str2 = "По всем производителям".
     2040   else str2 = " ".
     2041   For each obj-list no-lock:
     2042    Assign
     2043    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     2044    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     2045    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     2046    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     2047   End.
     2048   ReportNAme = "Помесячный оборот по производителям в ценах продаж".
     2049   run gbl/numtomon.p ( month( vStartPoint ), output StrBuf ) .
     2050   run no-benqi(OUTPUT NotInc).
     2051   ReportHeader = "За " + StrBuf  + " " + ENTRY(NUm-entries(vStrBuf, " "), vStrBuf, " ") +
     2052                  chr(10) + ( if NotInc then "( сформирован НЕ ПО ВСЕМ ЧЕКАМ )" else " " ).
     2053   END PROCEDURE.
     2054   PROCEDURE send-records :
     2055   END PROCEDURE.
     2056   PROCEDURE state-changed :
     2057     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
     2058     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     2059   END PROCEDURE.
