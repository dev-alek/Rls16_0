      174   def
      175    shared
      176   temp-table  obj-list no-undo
      177     field obj-type like ub.clients.obj-type
      178     field obj-code like ub.clients.obj-code
      179     field obj-name like ub.clients.obj-name
      180     field obj-id   as integer
      181     field db-num   as integer
      182     index pi is primary unique obj-id
      183     index ie1 obj-type obj-code
      184     index ie2 obj-name
      185   .
      186   procedure create_obj-list :
      187      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      188      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      189      do
      190      on error undo, return error return-value
      191      :
      192         define buffer cli-obj for ub.clients .
      193         define variable p-var as integer no-undo .
      194         define buffer buf_obj-list for obj-list .
      195         find last buf_obj-list  use-index pi no-error .
      196         if available buf_obj-list
      197         then
      198            p-var = buf_obj-list.obj-id + 1.
      199         else
      200            p-var = 1.
      201         find first cli-obj where
      202                   cli-obj.obj-type = p-obj-type
      203               and cli-obj.obj-code = p-obj-code
      204         no-lock no-error.
      205         if available cli-obj
      206         then do:
      207            create buf_obj-list.
      208            assign
      209               buf_obj-list.obj-id   = p-var
      210               buf_obj-list.obj-code = cli-obj.obj-code
      211               buf_obj-list.obj-type = cli-obj.obj-type
      212               buf_obj-list.obj-name = cli-obj.obj-name
      213               buf_obj-list.db-num   = cli-obj.db-num
      214            .
      215         end.
      216      end.
      217   end.
