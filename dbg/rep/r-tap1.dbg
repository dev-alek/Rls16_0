      262       def var v-tax-parts-qnty                as decimal  init 0          no-undo.
      263   define variable vss-include-info4 as character format "X(65)" no-undo
      264   initial "@(#)$Workfile$ $Revision$".
      265   define stream excel-line.
      266   define stream excel-cell.
      267   define temp-table temp_cell-data no-undo
      268       field data-key as character
      269       field data-value as character
      270       index pi is primary unique data-key
      271   .
      272   define variable v-tap1-sheet1-cur-data-row     as integer      no-undo.
      273   define variable v-tap1-cell-file-name       as character    no-undo.
      274   define variable v-tap1-data-file-name       as character    no-undo.
      275   procedure tap1-init :
      276   do
      277   on error undo, return error
      278   :
      279       assign
      280           v-tap1-sheet1-cur-data-row = 0
      281       .
      282       run gbl/_tmpfile.p (
      283             input "xd"
      284           , input ".txt"
      285           , output v-tap1-data-file-name
      286       ).
      287       output stream excel-line to value( v-tap1-data-file-name ).
      288       run gbl/_tmpfile.p (
      289             input "xc"
      290           , input ".txt"
      291           , output v-tap1-cell-file-name
      292       ).
      293       output stream excel-cell to value( v-tap1-cell-file-name ).
      294       run tap1-write-cell-data in this-procedure (
      295             input "sheetList":U
      296           , input "Лист1":U
      297       ).
      298       if printrubl
      299       then do:
      300           run tap1-write-cell-data in this-procedure (
      301                 input "Лист1_valutCode":U
      302               , input "0":U
      303           ).
      304       end.
      305       else do:
      306           run tap1-write-cell-data in this-procedure (
      307                 input "Лист1_valutCode":U
      308               , input "1":U
      309           ).
      310       end.
      311       run tap1-write-cell-data in this-procedure (
      312             input "Лист1_columnList":U
      313           , input "number,artic,name,chrt,meas,qnty,price_before,summ_before,price_after,summ_after,delta":U
      314       ).
      315       run tap1-write-cell-data in this-procedure (
      316             input "Лист1_columnType":U
      317           , input "S,S,S,S,S,S,S,S,S,S,S":U
      318       ).
      319       run tap1-write-cell-data in this-procedure (
      320             input "Лист1_subtotalList":U
      321           , input "":U
      322       ).
      323       run tap1-write-cell-data in this-procedure (
      324             input "Лист1_subtotalType":U
      325           , input "":U
      326       ).
      327   end.
      328   end procedure.
      329   procedure tap1-sheet1-write-line-data :
      330   define input parameter p-number       as character        no-undo.
      331   define input parameter p-artic        as character        no-undo.
      332   define input parameter p-name         as character        no-undo.
      333   define input parameter p-chrt         as character        no-undo.
      334   define input parameter p-meas         as character        no-undo.
      335   define input parameter p-qnty         as character        no-undo.
      336   define input parameter p-price_before as character        no-undo.
      337   define input parameter p-summ_before  as character        no-undo.
      338   define input parameter p-price_after  as character        no-undo.
      339   define input parameter p-summ_after   as character        no-undo.
      340   define input parameter p-delta        as character        no-undo.
      341   do
      342   on error undo, return error
      343   :
      344      put stream excel-line unformatted
      345                           "Лист1":U
      346            chr(9)  "DTA":U
      347            chr(9)  p-number
      348            chr(9)  p-artic
      349            chr(9)  p-name
      350            chr(9)  p-chrt
      351            chr(9)  p-meas
      352            chr(9)  p-qnty
      353            chr(9)  p-price_before
      354            chr(9)  p-summ_before
      355            chr(9)  p-price_after
      356            chr(9)  p-summ_after
      357            chr(9)  p-delta
      358            chr(10)
      359      .
      360   end.
      361   end procedure.
      362   procedure tap1-write-cell-data :
      363   define input parameter p-data-key   as character        no-undo.
      364   define input parameter p-data-value as character        no-undo.
      365       define buffer buf_temp_cell-data     for temp_cell-data.
      366   do
      367   for buf_temp_cell-data
      368   on error undo, return error
      369   :
      370       find first buf_temp_cell-data
      371            where buf_temp_cell-data.data-key = p-data-key
      372       no-error.
      373       if not available buf_temp_cell-data
      374       then do:
      375           create buf_temp_cell-data.
      376           assign
      377               buf_temp_cell-data.data-key = p-data-key
      378           .
      379       end.
      380       assign
      381           buf_temp_cell-data.data-value = p-data-value
      382       .
      383       put stream excel-cell unformatted
      384                           buf_temp_cell-data.data-key
      385           chr(9)   buf_temp_cell-data.data-value
      386           chr(10)
      387       .
      388   end.
      389   end procedure.
      390   procedure tap1-run-excel :
      391   define input parameter p-header-filename    as character        no-undo.
      392   define input parameter p-data-filename      as character        no-undo.
      393   define variable v-template-file-name    as character    no-undo.
      394   define variable v-vb-file-name          as character    no-undo.
      395   define buffer buf_temp-param for temp-param .
      396   do
      397   for buf_temp-param
      398   on error undo, return error
      399   :
      400       create buf_temp-param.
      401       assign
      402           v-template-file-name    = search( "exe/wth-tap1.xlt" )
      403           v-vb-file-name          = search( "exe/t_form.bas" )
      404       .
      405       if v-template-file-name = ?
      406       or v-template-file-name = "":U
      407       then do:
      408           message
      409               "Ошибка имени файла шаблона."
      410           view-as alert-box error.
      411       end.
      412       if v-vb-file-name = ?
      413       or v-vb-file-name = "":U
      414       then do:
      415           message
      416               "Ошибка имени файла кода обработки."
      417           view-as alert-box error.
      418       end.
      419       run paramls-write in this-procedure (
      420             input "template":U
      421           , input "template-file-name":U
      422           , input v-template-file-name
      423       ).
      424       run paramls-write in this-procedure (
      425             input "template":U
      426           , input "vb-file-name":U
      427           , input v-vb-file-name
      428       ).
      429       run paramls-write in this-procedure (
      430             input "data":U
      431           , input "data-header-filename":U
      432           , input p-header-filename
      433       ).
      434       run paramls-write in this-procedure (
      435             input "data":U
      436           , input "data-filename":U
      437           , input p-data-filename
      438       ).
      439       run gbl/macroxlt.p (
      440           input-output table buf_temp-param
      441       ) no-error.
      442       if error-status :error
      443       then do:
      444           message
      445                    vss-workfile vss-revision vss-description
      446               skip(1)
      447               skip "Ошибка создания файла Excel."
      448               skip return-value
      449               skip trim(error-status :get-message(1))
      450                    trim(error-status :get-message(2))
      451                    trim(error-status :get-message(3))
      452           view-as alert-box error.
      453           undo, return error .
      454       end.
      455   end.
      456   end procedure.
      457   procedure tap1-close :
      458   do
      459   on error undo, return error
      460   :
      461       output stream excel-line close.
      462       output stream excel-cell close.
      463       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
      464           export "exe/wth-tap1.xlt" .
      465           export "exe/t_form.bas" .
      466           export v-tap1-cell-file-name.
      467           export v-tap1-data-file-name.
      468       output close.
      469   end.
      470   end procedure.
