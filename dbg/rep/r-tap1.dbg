      969      run print-header    in this-procedure .
      970      run print-body      in this-procedure .
      971      run print-footer    in this-procedure .
      972      run close-stream    IN THIS-PROCEDURE .
      973   end.
      974   procedure fill-tt :
      975   do
      976   on error undo, return error
      977   :
      978   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      979     run mainmenu_getcntxt in parparentproc
      980       (output v-cntxt-db-num
      981       ,output v-cntxt-userid
      982       ,output v-cntxt-level
      983       ,output v-cntxt-host-code-obj
      984       ,output v-cntxt-obj-type
      985       ,output v-cntxt-obj-code
      986       ,output v-cntxt-db-num-obj
      987       ,output v-cntxt-is-admin
      988       ) .
      989   if session :set-wait-state( "compiler" ) then.
      990      run get-report-num in parparentproc (
      991         output g#report-num
      992      ).
      993      run get-quest-print in parparentproc (
      994         output g#quest-print
      995      ).
      996   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      997   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
      998     (output v-rb-is-base
      999     )  .
     1000      find first buf_price-doc
     1001           where recid(buf_price-doc) = rec_id
     1002           no-lock
     1003           .
     1004      if not available buf_price-doc
     1005      then do:
     1006         bell.
     1007         message 'Порушена табличка "price-doc"(r-tap1.p).'.
     1008         return error.
     1009      end.
     1010      if  buf_price-doc.status_ <> 'акт':U
     1011      then do:
     1012         bell.
     1013         message 'Документ не акт переоценки (r-tap1.p).'.
     1014         return error.
     1015      end.
     1016      find     obj_clients
     1017         where obj_clients.obj-code = buf_price-doc.obj-code
     1018         and   obj_clients.obj-type = buf_price-doc.obj-type
     1019         no-lock
     1020         .
     1021      if not available obj_clients
     1022      then do:
     1023         bell.
     1024         message 'Порушена табличка "clients" (r-tap1.p).'.
     1025         return error.
     1026      end.
     1027   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1028   do:
     1029     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1030       (input  v-cntxt-db-num
     1031       ,input  v-cntxt-userid
     1032       ,input  0
     1033       ,input  'actn_overvalue-cast_print':U
     1034       ,input  'firm':U
     1035       ,input  v-cntxt-host-code-obj
     1036       ,input  '':U
     1037       ,input  0
     1038       ,input  0
     1039       ,input  0
     1040       ,input  0
     1041       ,input  false
     1042       ,output v-ok
     1043       )  .
     1044   end.
     1045      find     buf_trn-doc
     1046         where buf_trn-doc.doc-code = buf_price-doc.doc-num
     1047         no-lock
     1048         no-error
     1049         .
     1050      find     firm_clients
     1051         where firm_clients.obj-type = 'орг':U
     1052         and   firm_clients.obj-code = buf_price-doc.host-code
     1053         no-lock
     1054      .
     1055      assign
     1056         v-single-line = fill("-", 168)
     1057      .
     1058   end.
     1059   end procedure.
     1060   procedure open-stream :
     1061   do
     1062   on error undo, return error
     1063   :
     1064   output stream outstream to value( string( session:temp-directory +
     1065                                        "rpt" + string( g#report-num ) ) )
     1066                                        page-size 62 .
     1067      run tap1-init in this-procedure.
     1068   end.
     1069   end procedure.
     1070   procedure print-header :
     1071   do
     1072   on error undo, return error
     1073   :
     1074      put stream outstream
     1075      skip(1)
     1076      .
     1077      put stream outstream skip(2)
     1078         space(150)  "Форма ТАП-1-ДО"                                                            SKIP
     1079            "Организация:"   firm_clients.obj-name "Утверждаю:  _____________________________" AT 108                SKIP
     1080                                                      "должность"                AT 130                SKIP
     1081            "структурное подразделение:"   obj_clients.obj-name  "_____________________________________" AT 120                SKIP
     1082                                                               "  подпись      расшифровка подписи"  AT 120     SKIP
     1083                                                               "«______» ____________ 200__г."AT 120  SKIP
     1084         space(57)   "АКТ"                      "+-----------------+------------+" AT 101        SKIP
     1085         space(50)   "О ПЕРЕОЦЕНКЕ ТОВАРОВ"     "|      Номер      |     от     |" AT 101        SKIP
     1086                                                "+-----------------+------------+" AT 101        SKIP
     1087                                                "|" AT 101       buf_price-doc.doc-num AT 102 "|" AT 119 buf_price-doc.doc-date format "99.99.9999" AT 121  "|" AT 132 SKIP
     1088                                                "+----------------------+-------+-----------------+------------+"  AT 70       SKIP
     1089                           "Основание составления акта" AT 30    "| Приказ, распоряжение | Номер |                 |" AT 70 SKIP
     1090                                                                 "+----------------------+-------+-----------------+" AT 70 SKIP
     1091                                                                 "| Ненужное зачеркнуть  |  от   |                 |" AT 70 SKIP
     1092                                                                 "+----------------------+-------+-----------------+" AT 70 SKIP
     1093                     "Комиссия в составе: Председатель комиссии : _____________________________"            SKIP
     1094         space(27)   "Члены комиссии : ____________________________________________________________________________________________________________________"          SKIP
     1095                     "произвела переоценку товаров. Переоцененные товары перемаркированы."                  SKIP
     1096         skip .
     1097      form header
     1098                  "Продолжение - на следующей странице" at 30 skip
     1099                  with frame Bottomframe width 160 page-bottom no-labels no-box .
     1100      view stream outstream frame bottomframe .
     1101      RUN tap1-write-cell-data IN THIS-PROCEDURE
     1102          ( INPUT "firm":U
     1103          , INPUT firm_clients.obj-name
     1104          ) .
     1105      RUN tap1-write-cell-data IN THIS-PROCEDURE
     1106          ( INPUT "object":U
     1107          , INPUT obj_clients.obj-name
     1108          ) .
     1109      RUN tap1-write-cell-data IN THIS-PROCEDURE
     1110          ( INPUT "doc_num":U
     1111          , INPUT buf_price-doc.doc-num
     1112          ) .
     1113      RUN tap1-write-cell-data IN THIS-PROCEDURE
     1114          ( INPUT "doc_date":U
     1115          , INPUT buf_price-doc.doc-date
     1116          ) .
     1117   end.
     1118   end procedure.
     1119   procedure print-body :
     1120   do
     1121   on error undo, return error
     1122   :
     1123      form with frame f-tap .
     1124      for each buf_price-list
     1125         no-lock
     1126         where buf_price-list.doc-num = buf_price-doc.doc-num
     1127         ,
     1128         each buf_goods
     1129         no-lock
     1130         where buf_goods.artic     = buf_price-list.artic
     1131           and buf_goods.prod-type = buf_price-list.prod-type
     1132           and buf_goods.prod-code = buf_price-list.prod-code
     1133         break by buf_goods.artic descending
     1134         :
     1135   define variable vss-include-info11 as character format "X(65)" no-undo
     1136   initial "@(#)$Workfile$ $Revision$".
     1137               find first buf_bar-code no-lock
     1138                    where buf_bar-code.b-code = buf_price-list.b-code
     1139               .
     1140               if buf_bar-code.unit-cli = buf_goods.unit-base
     1141               then do:
     1142                   assign
     1143                       v-code-is-main = yes
     1144                   .
     1145               end.
     1146               else do:
     1147                   assign
     1148                       v-code-is-main = no
     1149                   .
     1150               end.
     1151               if not (v-code-is-main = yes)
     1152               then do:
     1153                   assign
     1154                       v-not-main-unit-cli       = buf_bar-code.unit-cli
     1155                       v-not-main-cli-base-rate  = buf_bar-code.cli-base-rate
     1156                       v-not-main-b-code         = buf_bar-code.b-code
     1157                   .
     1158               end.
     1159               find first buf_gds-prt no-lock
     1160                    where buf_gds-prt.node-code = buf_bar-code.node-code
     1161               .
     1162               assign
     1163                 v-gds-prt-node-name =
     1164                 ( if buf_gds-prt.upper-code = buf_goods.prt-root
     1165                   then if buf_bar-code.in-code = ''
     1166                       then buf_goods.gds-name
     1167                       else buf_bar-code.in-code + '    ' + buf_bar-code.part-code
     1168                   else
     1169                           '    ' + buf_gds-prt.f-name
     1170                 )
     1171               .
     1172               find first buf_gds-obj no-lock
     1173                    where buf_gds-obj.obj-type  = buf_price-list.obj-type
     1174                      and buf_gds-obj.obj-code  = buf_price-list.obj-code
     1175                      and buf_gds-obj.prod-type = buf_price-list.prod-type
     1176                      and buf_gds-obj.prod-code = buf_price-list.prod-code
     1177                      and buf_gds-obj.artic     = buf_price-list.artic
     1178               no-error.
     1179               if available buf_gds-obj
     1180               then do:
     1181                   assign
     1182                       v-gds-obj-last-price = ( if v-rb-is-base = yes then buf_gds-obj.last-base else buf_gds-obj.last-rubl )
     1183                   .
     1184                   if v-gds-obj-last-price = ?
     1185                   then do:
     1186                       assign
     1187                           v-gds-obj-last-price = 0
     1188                       .
     1189                   end.
     1190               end.
     1191               else do:
     1192                   assign
     1193                       v-gds-obj-last-price = 0
     1194                   .
     1195               end.
     1196               find first buf_gds-prt no-lock
     1197                    where buf_gds-prt.upper-code = buf_goods.prt-root
     1198               .
     1199               assign
     1200                   v-gds-prt-node-code = buf_gds-prt.node-code
     1201               .
     1202   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1203   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1204     (input  buf_price-list.obj-type
     1205     ,input  buf_price-list.obj-code
     1206     ,input  buf_price-list.b-code
     1207     ,input  0
     1208     ,input  buf_price-list.fact-order
     1209     ,output v-price-list-doc-num
     1210     ,output v-price-list-price-sale
     1211     ,output v-price-list-road-tax
     1212     ,output v-price-list-excise
     1213     )  .
     1214               if v-price-list-price-sale = ?
     1215               then do:
     1216                   assign
     1217                       v-price-list-price-sale = 0
     1218                   .
     1219               end.
     1220               if v-price-list-road-tax = ?
     1221               then do:
     1222                   assign
     1223                       v-price-list-road-tax = 0
     1224                   .
     1225               end.
     1226               assign
     1227                   v-price-list-price-sale_old = v-price-list-price-sale
     1228               .
     1229   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1230     (input  buf_goods.gds-code
     1231     ,input  buf_bar-code.node-code
     1232     ,output v-price-list-b-code
     1233     )  .
     1234               find first buf_bar-code no-lock
     1235                    where buf_bar-code.b-code = v-price-list-b-code
     1236               .
     1237               accumulate buf_bar-code.b-code ( count ) .
     1238         if v-code-is-main = yes
     1239         then do:
     1240            accumulate ( ( buf_price-list.price-sale - v-price-list-price-sale_old ) * buf_price-list.doc-qnty ) (total)
     1241                         ( buf_price-list.doc-qnty ) (total)
     1242                         ( buf_price-list.doc-qnty * v-price-list-price-sale_old ) (total)
     1243                         ( buf_price-list.doc-qnty * buf_price-list.price-sale ) (total)
     1244                         ( buf_price-list.doc-qnty * v-gds-obj-last-price ) (total) .
     1245            run print-line-fact in this-procedure.
     1246         end.
     1247         if line-counter( outstream ) + 9 > page-size( outstream ) then
     1248               page stream outstream .
     1249      end.
     1250      ASSIGN
     1251         v-delta     = accum total ( ( buf_price-list.price-sale - v-price-list-price-sale_old) * buf_price-list.doc-qnty)
     1252         v-new-sum   = accum total ( buf_price-list.doc-qnty * buf_price-list.price-sale )
     1253         v-old-sum   = accum total ( buf_price-list.doc-qnty * v-price-list-price-sale_old )
     1254         v-qnty-all  = accum total ( buf_price-list.doc-qnty )
     1255      .
     1256   end.
     1257   end procedure.
     1258   procedure print-footer :
     1259   do
     1260   on error undo, return error
     1261   :
     1262      put stream outstream v-single-line format "X(168)" skip.
     1263      display stream outstream
     1264         "Всего" format "X(8)" @ buf_goods.gds-name
     1265         v-qnty-all @ buf_price-list.doc-qnty
     1266         v-old-sum
     1267         v-new-sum
     1268         v-delta
     1269         with frame f-tap
     1270      .
     1271      hide stream outstream frame Bottomframe .
     1272      RUN tap1-write-cell-data IN THIS-PROCEDURE
     1273          ( INPUT "it_qnty":U
     1274          , INPUT v-qnty-all
     1275          ) .
     1276      RUN tap1-write-cell-data IN THIS-PROCEDURE
     1277          ( INPUT "it_summ_before":U
     1278          , INPUT v-old-sum
     1279          ) .
     1280      RUN tap1-write-cell-data IN THIS-PROCEDURE
     1281          ( INPUT "it_summ_after":U
     1282          , INPUT v-new-sum
     1283          ) .
     1284      RUN tap1-write-cell-data IN THIS-PROCEDURE
     1285          ( INPUT "it_delta":U
     1286          , INPUT v-delta
     1287          ) .
     1288      IF v-line-counter > 0
     1289      THEN DO:
     1290         run rep/wp-qnty.p (
     1291               input absolute( 1 )
     1292               , output propis
     1293         ) .
     1294         RUN tap1-write-cell-data IN THIS-PROCEDURE
     1295            ( INPUT "number_begin":U
     1296            , INPUT propis
     1297            ) .
     1298         define variable v-out-str    as character    no-undo.
     1299         assign
     1300            v-out-str = "Количество порядковых номеров: с № " + propis
     1301         .
     1302         run rep/wp-qnty.p (
     1303               input absolute( v-line-counter )
     1304               , output propis
     1305         ) .
     1306         RUN tap1-write-cell-data IN THIS-PROCEDURE
     1307            ( INPUT "number_end":U
     1308            , INPUT propis
     1309            ) .
     1310         assign
     1311            v-out-str = v-out-str + " по № " + propis
     1312         .
     1313         put stream outstream
     1314            v-out-str FORMAT "x(168)"
     1315         .
     1316      END.
     1317      ELSE DO:
     1318         ASSIGN
     1319            propis = "Ноль"
     1320         .
     1321         RUN tap1-write-cell-data IN THIS-PROCEDURE
     1322            ( INPUT "number_begin":U
     1323            , INPUT propis
     1324            ) .
     1325         RUN tap1-write-cell-data IN THIS-PROCEDURE
     1326            ( INPUT "number_end":U
     1327            , INPUT propis
     1328            ) .
     1329         assign
     1330            v-out-str = "Количество порядковых номеров: с № " + propis + " по № " + propis
     1331         .
     1332         put stream outstream
     1333            v-out-str FORMAT "x(168)"
     1334         .
     1335      END.
     1336      run rep/wp-qnty.p (
     1337              input absolute( v-qnty-all )
     1338            , output propis
     1339      ) .
     1340      IF propis = "":U
     1341      OR TRUNCATE( v-qnty-all, 0) = 0
     1342      THEN DO:
     1343         ASSIGN
     1344            propis = "Ноль " + propis
     1345         .
     1346      END.
     1347      IF v-qnty-all < 0
     1348      THEN DO:
     1349         ASSIGN
     1350            propis = "Минус " + propis
     1351         .
     1352      END.
     1353      assign
     1354         v-out-str = "Количество в натуральных показателях " + propis
     1355      .
     1356      put stream outstream skip
     1357         v-out-str FORMAT "x(168)"
     1358      .
     1359      RUN tap1-write-cell-data IN THIS-PROCEDURE
     1360          ( INPUT "qnty_prop":U
     1361          , INPUT propis
     1362          ) .
     1363      if v-rb-is-base = yes
     1364      then do:
     1365         run rep/wp.p (
     1366               input parparentproc
     1367               , input absolute( v-delta )
     1368               , output propis
     1369               , output abbr
     1370         ) .
     1371      end.
     1372      else do:
     1373         run rep/wp-rub.p (
     1374               input absolute( v-delta )
     1375               , output propis
     1376               , output abbr
     1377         ) .
     1378      end.
     1379      put stream outstream skip
     1380               "Cумма переоценки: " format "X(18)"
     1381               ( v-delta ) format "->>>>>>>>9.99"
     1382               space(1)
     1383               ( if v-rb-is-base = yes then "баз.вал" else "руб" )         format "X(3)"
     1384               " (" format "X(2)"
     1385               .
     1386      IF v-delta < 0
     1387      THEN DO:
     1388         ASSIGN
     1389            propis = "Минус " + propis
     1390         .
     1391      END.
     1392      put stream outstream
     1393               string( propis + ")" )
     1394                  format "X(95)"
     1395               .
     1396      RUN tap1-write-cell-data IN THIS-PROCEDURE
     1397          ( INPUT "summ_prop":U
     1398          , INPUT propis
     1399          ) .
     1400      put stream outstream skip
     1401         "Все члены комиссии предупреждены об ответственности за подписание акта, содержащего данные, несоответствующие действительности." SKIP(1)
     1402         "          Председатель комиссии : _____________________  __________________  __________________________________" SKIP
     1403         "                                        должность              подпись               расшифровка подписи       " SKIP(1)
     1404         "                 Члены комиссии : _____________________  __________________  __________________________________" SKIP
     1405         "                                        должность              подпись               расшифровка подписи       " SKIP(1)
     1406         "                                : _____________________  __________________  __________________________________" SKIP
     1407         "                                        должность              подпись               расшифровка подписи       " SKIP
     1408      .
     1409      if v-rb-is-base = yes
     1410      then do:
     1411         run rep/wp.p (
     1412               input parparentproc
     1413               , input absolute( v-new-sum )
     1414               , output propis
     1415               , output abbr
     1416         ) .
     1417      end.
     1418      else do:
     1419         run rep/wp-rub.p (
     1420               input absolute( v-new-sum )
     1421               , output propis
     1422               , output abbr
     1423         ) .
     1424      end.
     1425      IF v-new-sum < 0
     1426      THEN DO:
     1427         ASSIGN
     1428            propis = "Минус " + propis
     1429         .
     1430      END.
     1431      RUN tap1-write-cell-data IN THIS-PROCEDURE
     1432          ( INPUT "summ_after_prop":U
     1433          , INPUT propis
     1434          ) .
     1435      put stream outstream UNFORMATTED skip
     1436         "Товарные ценности, перечисленные на общую сумму после переоценки " propis SKIP
     1437         "находятся на моем (нашем) ответственном хранении. Материально-ответственное (ые) лицо (а)_____________________  __________________  __________________________________" SKIP
     1438         "                должность              подпись               расшифровка подписи       " AT 77
     1439      .
     1440   end.
     1441   end procedure.
     1442   procedure close-stream :
     1443   do
     1444   on error undo, return error
     1445   :
     1446      output stream outstream close.
     1447   if session :set-wait-state( "" ) then.
     1448      run tap1-close in this-procedure .
     1449      os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )  .
     1450      os-rename
     1451         value( string( session:temp-directory ) + "$" + string( g#report-num ) + ".txl" )
     1452         value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )
     1453      .
     1454   if g#quest-print = false
     1455   then do:
     1456     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     1457                                         7, (if 8 >= 8 then 2 else 0), 0, 0,
     1458                                         OUTPUT g#log ).
     1459   end.
     1460   else do:
     1461     os-command silent
     1462       value( "COPY /b " +
     1463         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     1464         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     1465         string( session:temp-directory) +  "$" + string( g#report-num )
     1466                 ) .
     1467     os-command silent
     1468       value( "COPY /b " +
     1469         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     1470         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     1471         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     1472                 ) .
     1473   end.
     1474   end.
     1475   end procedure.
     1476   procedure print-line-fact :
     1477   do
     1478   on error undo, return error
     1479   :
     1480      if ( ( buf_price-list.price-sale - v-price-list-price-sale_old ) * buf_price-list.doc-qnty  <> 0 ) or ( p-print-null-qnty = yes )
     1481      then do:
     1482         assign
     1483            v-line-counter = v-line-counter + 1
     1484         .
     1485         display stream outstream
     1486            v-line-counter
     1487            buf_price-list.artic
     1488            v-gds-prt-node-name                                         @ buf_goods.gds-name
     1489            buf_goods.unit-base
     1490            buf_price-list.doc-qnty       when buf_price-list.doc-qnty <> ?
     1491            v-price-list-price-sale_old
     1492            ( buf_price-list.doc-qnty * v-price-list-price-sale_old )   @ v-old-sum
     1493            buf_price-list.price-sale
     1494            ( buf_price-list.doc-qnty * buf_price-list.price-sale )     @ v-new-sum
     1495            (( buf_price-list.price-sale - v-price-list-price-sale_old ) * buf_price-list.doc-qnty )  @ v-delta
     1496            sym1
     1497            sym2
     1498            sym3
     1499            sym4
     1500            sym5
     1501            sym6
     1502            sym7
     1503            sym8
     1504            sym9
     1505            sym10
     1506            sym11
     1507            sym12
     1508         with frame f-tap .
     1509         down stream outstream 1 with frame f-tap .
     1510   define variable vss-include-info13 as character format "X(65)" no-undo
     1511   initial "@(#)$Workfile$ $Revision$".
     1512       if hvrdtax (recid(buf_goods))
     1513       then do:
     1514           run tax-name (  input 'rdt':U
     1515                         , output v-taxname
     1516                        ).
     1517           assign
     1518               v-tax       = buf_price-list.road-tax * buf_price-list.doc-qnty
     1519               v-tax-sum   = v-tax-sum + v-tax
     1520           .
     1521            for each buf_parts
     1522            where buf_parts.obj-type         = buf_price-list.obj-type
     1523                  and buf_parts.obj-code     = buf_price-list.obj-code
     1524                  and buf_parts.artic        = buf_price-list.artic
     1525                  and buf_parts.prod-type    = buf_price-list.prod-type
     1526                  and buf_parts.prod-code    = buf_price-list.prod-code
     1527                  and buf_parts.out-code     = buf_price-list.doc-num
     1528            break by buf_parts.road-tax-rubl
     1529            :
     1530                  if first-of( buf_parts.road-tax-rubl )
     1531                  then do:
     1532                     assign
     1533                        v-tax-parts-qnty  = 0
     1534                     .
     1535                  end.
     1536                  assign
     1537                     v-tax-parts-qnty    = v-tax-parts-qnty  + buf_parts.fact-qnty
     1538                  .
     1539                  if last-of( buf_parts.road-tax-rubl )
     1540                  then do:
     1541                     display stream outstream
     1542                        "     В том числе"                                  @ buf_price-list.artic
     1543                        v-taxname                                           @ buf_goods.gds-name
     1544                        v-tax-parts-qnty          @ buf_price-list.doc-qnty
     1545                        buf_goods.unit-base
     1546                        buf_parts.road-tax-rubl                             @ buf_price-list.price-sale
     1547                        v-tax-parts-qnty * buf_parts.road-tax-rubl              @ v-new-sum
     1548                        sym1
     1549                        sym2
     1550                        sym3
     1551                        sym4
     1552                        sym5
     1553                        sym6
     1554                        sym7
     1555                        sym8
     1556                        sym9
     1557                        sym10
     1558                        sym11
     1559                        sym12
     1560                     with frame f-tap
     1561                     .
     1562                     down stream outstream 1
     1563                     with frame f-tap  .
     1564                     RUN tap1-sheet1-write-line-data IN THIS-PROCEDURE
     1565                        ( INPUT "":U
     1566                        , INPUT "В том числе"
     1567                        , INPUT v-taxname
     1568                        , INPUT "":U
     1569                        , INPUT buf_goods.unit-base
     1570                        , INPUT v-tax-parts-qnty
     1571                        , INPUT "":U
     1572                        , INPUT "":U
     1573                        , INPUT buf_parts.road-tax-rubl
     1574                        , INPUT ( v-tax-parts-qnty * buf_parts.road-tax-rubl )
     1575                        , INPUT "":U
     1576                        ) .
     1577                  end.
     1578            end.
     1579       end.
     1580         RUN tap1-sheet1-write-line-data IN THIS-PROCEDURE
     1581            ( INPUT v-line-counter
     1582            , INPUT buf_price-list.artic
     1583            , INPUT v-gds-prt-node-name
     1584            , INPUT "":U
     1585            , INPUT buf_goods.unit-base
     1586            , INPUT buf_price-list.doc-qnty
     1587            , INPUT v-price-list-price-sale_old
     1588            , INPUT ( buf_price-list.doc-qnty * v-price-list-price-sale_old )
     1589            , INPUT buf_price-list.price-sale
     1590            , INPUT ( buf_price-list.doc-qnty * buf_price-list.price-sale )
     1591            , INPUT (( buf_price-list.price-sale - v-price-list-price-sale_old ) * buf_price-list.doc-qnty )
     1592            ) .
     1593      end.
     1594   end.
     1595   end procedure.
