      134   function hvrdtax return logical (input parrecid as recid):
      135   define variable varresult as logical no-undo.
      136   run hvrdtax-proc (input parrecid, output varresult).
      137   return varresult.
      138   end function.
      139   procedure hvrdtax-proc:
      140   define input  parameter parrecid  as recid   no-undo.
      141   define output parameter parresult as logical no-undo.
      142   define buffer bf_goods for ub.goods.
      143   define buffer bf_units for ub.units.
      144   define buffer rt_tax   for ub.tax.
      145   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
      146   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
      147   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
      148   if available rt_tax and
      149       can-find(first ub.tax-units No-LOCK WHERE
      150                      ub.tax-units.tax-code = rt_tax.tax-code AND
      151                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
      152                                                       else assign parresult = no.
      153   end procedure.
      154   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      155   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      156   procedure paramls-clear :
      157     define buffer buf_temp-param for temp-param .
      158     do
      159     on error undo, return error return-value
      160     :
      161       for each buf_temp-param
      162       on error undo, return error
      163       :
      164         delete buf_temp-param .
      165       end.
      166     end.
      167   end procedure.
      168   procedure paramls-write :
      169     define input  parameter p-code     as character no-undo .
      170     define input  parameter p-sub-code as character no-undo .
      171     define input  parameter p-value    as character no-undo .
      172     define buffer buf_temp-param for temp-param .
      173     do
      174     on error undo, return error return-value
      175     :
      176       find first buf_temp-param
      177         where buf_temp-param.param-code     = p-code
      178           and buf_temp-param.param-sub-code = p-sub-code
      179         no-error .
      180       if not available buf_temp-param then do:
      181         create buf_temp-param .
      182         assign
      183           buf_temp-param.param-code     = p-code
      184           buf_temp-param.param-sub-code = p-sub-code
      185         .
      186       end.
      187       assign
      188         buf_temp-param.param-value = p-value
      189       .
      190     end.
      191   end procedure.
      192   procedure paramls-read :
      193     define input  parameter p-code          as character no-undo .
      194     define input  parameter p-sub-code      as character no-undo .
      195     define input  parameter p-default-value as character no-undo .
      196     define output parameter p-value         as character no-undo .
      197     define buffer buf_temp-param for temp-param .
      198     do
      199     on error undo, return error return-value
      200     :
      201       find first buf_temp-param
      202         where buf_temp-param.param-code     = p-code
      203           and buf_temp-param.param-sub-code = p-sub-code
      204         no-error .
      205       if available buf_temp-param then do:
      206         assign
      207           p-value = buf_temp-param.param-value
      208         .
      209       end.
      210       else do:
      211         assign
      212           p-value = p-default-value
      213         .
      214       end.
      215     end.
      216   end procedure.
      217   procedure paramls-append :
      218     define input  parameter p-code     as character no-undo .
      219     define input  parameter p-sub-code as character no-undo .
      220     define input  parameter p-value    as character no-undo .
      221     define buffer buf_temp-param for temp-param .
      222     do
      223     on error undo, return error return-value
      224     :
      225       find first buf_temp-param
      226            where buf_temp-param.param-code     = p-code
      227              and buf_temp-param.param-sub-code = p-sub-code
      228         no-error .
      229       if not available buf_temp-param then do:
      230         create buf_temp-param .
      231         assign
      232           buf_temp-param.param-code     = p-code
      233           buf_temp-param.param-sub-code = p-sub-code
      234           buf_temp-param.param-value    = p-value
      235         .
      236       end.
      237       else do:
      238           assign
      239               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      240           .
      241       end.
      242     end.
      243   end procedure.
      244   define variable vss-include-info3 as character format "X(65)" no-undo
      245   initial "@(#)$Workfile$ $Revision$".
      246       def var v-price-list-doc-num            like ub.price-list.doc-num     no-undo.
      247       def var v-price-list-price-sale         like ub.price-list.price-sale  no-undo.
      248       def var v-price-list-price-sale_old     like ub.price-list.price-sale  no-undo.
      249       def var v-price-list-road-tax           like ub.price-list.road-tax    no-undo.
      250       def var v-price-list-excise             like ub.price-list.excise      no-undo.
      251       def var v-price-list-b-code             like ub.bar-code.b-code        no-undo.
      252       def var v-gds-obj-last-price            like ub.gds-obj.last-rubl      no-undo.
      253       def var v-gds-prt-node-code             like ub.gds-prt.node-code      no-undo.
      254       def var v-gds-prt-node-name             like ub.gds-prt.node-name      no-undo.
      255       def var v-code-is-main                  as logical                  no-undo.
      256       def var v-not-main-unit-cli             like ub.bar-code.unit-cli      no-undo.
      257       def var v-not-main-cli-base-rate        like ub.bar-code.cli-base-rate no-undo.
      258       def var v-not-main-b-code               like ub.bar-code.cli-base-rate no-undo.
      259       def var v-taxname                       as char                     no-undo.
      260       def var v-tax                           as decimal  init 0          no-undo.
