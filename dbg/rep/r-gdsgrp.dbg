      530   procedure grplib-get-parameters :
      531   define input parameter p-store-type     as character        no-undo.
      532   define input parameter p-store-code     as integer          no-undo.
      533   do
      534   on error undo, return error
      535   :
      536       assign
      537           v-grplib-not-fill-extra-info = no
      538       .
