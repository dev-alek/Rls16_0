      541   procedure grplib-get-sort-name :
      542   do
      543   on error undo, return error
      544   :
      545   define input parameter p-node-code  as integer      no-undo.
      546   define output parameter p-sort-name as character    no-undo.
      547       define variable v-upper-code    as integer           no-undo.
      548       define buffer buf_gds-grp       for ub.gds-grp.
      549       define buffer buf_upper_gds-grp for ub.gds-grp.
      550       find first buf_gds-grp no-lock
      551            where buf_gds-grp.node-code = p-node-code
      552       no-error.
      553       if not available buf_gds-grp
      554       then do:
      555           undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      556       end.
      557       assign
      558           p-sort-name  = ""
      559           v-upper-code = 1
      560       .
      561       do while buf_gds-grp.upper-code <> 0
      562       on error undo, return error "grplib-get-sort-name: Ошибка составления полного имени группы"
      563       :
      564           assign
      565               p-sort-name  = buf_gds-grp.node-name
      566                            + (if p-sort-name <> "" then chr(2) else "")
      567                            + p-sort-name
      568               v-upper-code = buf_gds-grp.upper-code
      569           .
      570           find first buf_gds-grp no-lock
      571                where buf_gds-grp.node-code = v-upper-code
      572           no-error.
      573           if not available buf_gds-grp
      574           then do:
      575               undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом "
      576                                   + string( v-upper-code )
      577                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      578           end.
      579       end.
      580   end.
      581   end procedure.
      582   define variable vss-include-info5 as character format "X(65)" no-undo
      583   initial "@(#)$Workfile$ $Revision$".
      584   procedure grplib-get-full-name :
      585      define input parameter p-node-code  as integer      no-undo.
      586      define output parameter p-full-name as character    no-undo.
      587      do
      588   on error undo, return error
      589   :
      590       define variable v-upper-code    as integer           no-undo.
      591       define buffer buf_gds-grp       for ub.gds-grp.
      592       define buffer buf_upper_gds-grp for ub.gds-grp.
      593       find first buf_gds-grp no-lock
      594            where buf_gds-grp.node-code = p-node-code
      595       no-error.
      596       if not available buf_gds-grp
      597       then do:
      598           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      599       end.
      600       assign
      601           p-full-name  = ""
      602           v-upper-code = 1
      603       .
      604       do while buf_gds-grp.upper-code <> 0
      605       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      606       :
      607           assign
      608               p-full-name  = buf_gds-grp.node-name
      609                            + (if p-full-name <> "" then chr(47) else "")
      610                            + p-full-name
      611               v-upper-code = buf_gds-grp.upper-code
      612           .
      613           find first buf_gds-grp no-lock
      614                where buf_gds-grp.node-code = v-upper-code
      615           no-error.
      616           if not available buf_gds-grp
      617           then do:
      618               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      619                                   + string( v-upper-code )
      620                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      621           end.
      622       end.
      623       assign
      624       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      625       .
      626   end.
      627   end .
      628   procedure grplib-get-node-from-full-name :
      629   define input parameter p-full-name as character no-undo .
      630   define output parameter p-node-code as integer no-undo .
      631   define variable v-ii as integer no-undo .
      632   define variable v-upper-code as integer no-undo .
      633   define variable v-root-code as integer no-undo .
      634   define variable v-entry as character no-undo .
      635   define buffer buf_gds-grp       for ub.gds-grp.
      636   do
      637   on error undo, return error
      638   :
      639     find first buf_gds-grp no-lock
      640         where buf_gds-grp.upper-code = 0
      641     no-error .
      642     if not available buf_gds-grp
      643     then do:
      644         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      645     end.
      646     else do:
      647       assign
      648       v-root-code = buf_gds-grp.node-code
      649       .
      650     end.
      651     v-upper-code = v-root-code.
      652     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      653       assign
      654       v-entry = entry(v-ii, p-full-name, chr(47)).
      655       if v-entry = '' then leave.
      656       find first buf_gds-grp no-lock where
      657                 buf_gds-grp.node-name = v-entry
      658             and buf_gds-grp.upper-code = v-upper-code
      659             no-error.
      660       if not available buf_gds-grp then do:
      661         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      662       end.
      663       else do:
      664         p-node-code = buf_gds-grp.node-code.
      665         v-upper-code = buf_gds-grp.node-code.
      666       end.
      667     end.
      668   end.
      669   end .
      670   procedure grplib-get-root-code :
      671   do
      672   on error undo, return error
      673   :
      674   define output parameter p-root-code as integer      no-undo.
      675       define buffer buf_gds-grp       for ub.gds-grp.
      676       find first buf_gds-grp no-lock
      677           where buf_gds-grp.upper-code = 0
      678       no-error .
      679       if not available buf_gds-grp
      680       then do:
      681           undo, return error .
      682       end.
      683       else do:
      684           assign
      685               p-root-code = buf_gds-grp.node-code
      686           .
      687       end.
      688   end.
      689   end procedure.
      690   procedure grplib-find-grp-by-full-name :
      691   do
      692   on error undo, return error
      693   :
      694   define input parameter p-search-name  as character    no-undo.
      695   define input parameter p-fill-path    as logical      no-undo.
      696   define output parameter p-found       as logical      no-undo.
      697       define variable v-upper-code    as integer          no-undo.
      698       define variable v-counter       as integer           no-undo.
      699       define variable v-level         as integer           no-undo.
      700       define variable v-full-name     as character         no-undo.
      701       define variable v-sort-name     as character         no-undo.
      702       define buffer buf_gds-grp       for ub.gds-grp.
      703       assign
      704           p-search-name = replace( p-search-name, chr(47), chr(2) )
      705       .
      706       run grplib-get-root-code ( output v-upper-code ) no-error .
      707       if error-status :error
      708       then do:
      709           undo, return error "grplib-expand-name: Ошибка при поиске корневого узла".
      710       end.
      711       assign
      712           v-full-name  = ""
      713           v-level      = num-entries( p-search-name, chr(2) )
      714       .
      715       for each temp_grplib_found-grp
      716       :
      717           delete temp_grplib_found-grp.
      718       end.
      719       start-name-analyze:
      720       do v-counter = 1 to v-level
      721       :
      722           if v-counter < v-level
      723           then do:
      724               find first buf_gds-grp no-lock
      725                    where buf_gds-grp.upper-code = v-upper-code
      726                      and buf_gds-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
      727               no-error .
      728               if not available buf_gds-grp
      729               then do:
      730                   assign
      731                       v-full-name  = p-search-name
      732                       v-sort-name  = p-search-name
      733                   .
      734                   return error "grplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
      735               end.
      736               else do:
      737                   assign
      738                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_gds-grp.node-name
      739                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_gds-grp.node-name
      740                       v-upper-code = buf_gds-grp.node-code
      741                   .
      742                   if p-fill-path = yes
      743                   then do:
      744                       create temp_grplib_found-grp.
      745                       assign
      746                           temp_grplib_found-grp.full-name = v-full-name + chr(47)
      747                           temp_grplib_found-grp.sort-name = v-sort-name
      748                           temp_grplib_found-grp.node-code = v-upper-code
      749                           temp_grplib_found-grp.level     = v-counter
      750                       .
      751                   end.
      752               end.
      753           end.
      754           else do:
      755               for each buf_gds-grp no-lock
      756                  where buf_gds-grp.upper-code = v-upper-code
      757                    and buf_gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
      758               :
      759                   assign
      760                       p-found = yes
      761                   .
      762                   create temp_grplib_found-grp.
      763                   assign
      764                       temp_grplib_found-grp.full-name = v-full-name
      765                                                           + (if v-full-name = "" then "" else chr(47) )
      766                                                           + buf_gds-grp.node-name + chr(47)
      767                       temp_grplib_found-grp.sort-name = v-sort-name
      768                                                           + ( if v-sort-name = "" then "" else chr(2) )
      769                                                           + buf_gds-grp.node-name
      770                       temp_grplib_found-grp.node-code = buf_gds-grp.node-code
      771                       temp_grplib_found-grp.level     = v-level
      772                   .
      773               end.
      774               if p-found = no
      775               then do:
      776                   assign
      777                       v-full-name  = p-search-name
      778                       v-sort-name  = p-search-name
      779                   .
      780                   for each temp_grplib_found-grp
      781                   :
      782                       delete temp_grplib_found-grp.
      783                   end.
      784                   assign
      785                       p-found = no
      786                   .
      787               end.
      788           end.
      789       end.
      790   end.
      791   end procedure.
      792   procedure grplib-find-all-subgroup :
      793   do
      794   on error undo, return error
      795   :
      796   define input parameter p-start-node-code    as integer      no-undo.
      797   define input parameter p-terminal-only      as logical      no-undo.
      798       define variable v-start-full-name   as character     no-undo.
      799       define variable v-start-sort-name   as character     no-undo.
      800       define variable v-not-found         as logical       no-undo.
      801       define variable v-is-terminal       as logical       no-undo.
      802       define buffer buf_gds-grp           for ub.gds-grp.
      803       create temp_found-result-nodelist.
      804       assign
      805           temp_found-result-nodelist.node-code = p-start-node-code
      806           temp_found-result-nodelist.processed = no
      807       .
      808       run grplib-get-full-name in this-procedure (
      809             input p-start-node-code
      810           , output v-start-full-name
      811       ).
      812       run grplib-get-full-name in this-procedure (
      813             input p-start-node-code
      814           , output v-start-sort-name
      815       ).
      816       process-nodes:
      817       do while yes
      818       :
      819           find first temp_found-result-nodelist
      820                where temp_found-result-nodelist.node-code = p-start-node-code
      821           .
      822           assign
      823               temp_found-result-nodelist.processed = yes
      824           .
      825           for each buf_gds-grp no-lock
      826              where buf_gds-grp.upper-code = p-start-node-code
      827           on error undo, return error
      828           :
      829               run grplib-is-terminal in this-procedure (
      830                     input buf_gds-grp.node-code
      831                   , output v-is-terminal
      832               ).
      833               if v-is-terminal = yes
      834               then do:
      835                   create temp_grplib_found-grp.
      836                   assign
      837                       temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      838                                                           chr(47) + buf_gds-grp.node-name + chr(47)
      839                       temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      840                                                           chr(2) + buf_gds-grp.node-name + chr(2)
      841                       temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
      842                       temp_grplib_found-grp.is-terminal = yes
      843                   .
      844               end.
      845               else do:
      846                   create temp_found-result-nodelist.
      847                   assign
      848                       temp_found-result-nodelist.node-code = buf_gds-grp.node-code
      849                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
      850                                                              chr(47) + buf_gds-grp.node-name + chr(47)
      851                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
      852                                                              chr(2) + buf_gds-grp.node-name + chr(2)
      853                       temp_found-result-nodelist.processed = no
      854                   .
      855                   if p-terminal-only = no
      856                   then do:
      857                       create temp_grplib_found-grp.
      858                       assign
      859                           temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      860                                                               chr(47) + buf_gds-grp.node-name + chr(47)
      861                           temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      862                                                               chr(2) + buf_gds-grp.node-name + chr(2)
      863                           temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
      864                           temp_grplib_found-grp.is-terminal = no
      865                       .
      866                   end.
      867               end.
      868           end.
      869           find first temp_found-result-nodelist
      870                where temp_found-result-nodelist.processed = no
      871           no-error.
      872           if not available temp_found-result-nodelist
      873           then do:
      874               leave process-nodes.
      875           end.
      876           else do:
      877               assign
      878                   p-start-node-code = temp_found-result-nodelist.node-code
      879                   v-start-full-name = temp_found-result-nodelist.full-name
      880                   v-start-sort-name = temp_found-result-nodelist.sort-name
      881               .
      882           end.
      883       end.
      884   end.
      885   end procedure.
      886   procedure grplib-expand-name :
      887   define input parameter p-start-name as character        no-undo.
      888   define output parameter p-end-name  as character        no-undo.
      889       define variable v-is-terminal   as logical      no-undo.
      890       define variable v-found         as character    no-undo.
      891       define buffer buf_temp_grplib_found-grp     for temp_grplib_found-grp.
      892   do
      893   for buf_temp_grplib_found-grp
      894   on error undo, return error
      895   :
      896       run grplib-find-grp-by-full-name in this-procedure (
      897             input p-start-name
      898           , input no
      899           , output v-found
      900       ) no-error.
      901       run grplib-get-max-substring in this-procedure (
      902                   input length( p-start-name )
      903                 , output p-end-name
      904       ) no-error .
      905       if error-status :error
      906       then do:
      907           assign
      908               p-end-name = ""
      909           .
      910       end.
      911       else do:
      912           find first temp_grplib_found-grp
      913               where temp_grplib_found-grp.full-name = p-end-name
      914           no-error.
      915           if available temp_grplib_found-grp
      916           then do:
      917               find first buf_temp_grplib_found-grp
      918                   where buf_temp_grplib_found-grp.full-name begins p-end-name
      919                   and recid( buf_temp_grplib_found-grp ) <> recid( temp_grplib_found-grp )
      920               no-error.
      921               if not available buf_temp_grplib_found-grp
      922               then do:
      923                   run grplib-is-terminal in this-procedure (
      924                       input temp_grplib_found-grp.node-code
      925                       , output v-is-terminal
      926                   ).
      927               end.
      928           end.
      929       end.
      930   end.
      931   end procedure.
      932   procedure grplib-get-max-substring :
      933   do
      934   on error undo, return error
      935   :
      936   define input parameter p-min-substring-length   as integer      no-undo.
      937   define output parameter p-substring             as character    no-undo.
      938           define variable v-char-counter  as integer           no-undo.
      939           define variable v-current-char  as character         no-undo.
      940           define variable v-names-counter  as integer           no-undo.
      941           define variable v-base-string   as character         no-undo.
      942           assign
      943               v-char-counter  = p-min-substring-length
      944           .
      945           find first temp_grplib_found-grp no-error.
      946           if not available temp_grplib_found-grp
      947           then do:
      948               undo, return error "grplib-get-max-substring: Нет строк для вычисления общей подстроки".
      949           end.
      950           else do:
      951               assign
      952                   v-base-string  = temp_grplib_found-grp.full-name
      953                   v-char-counter = 0
      954               .
      955               counter-block:
      956               do while yes
      957               on error undo, return error "grplib-get-max-substring: Ошибка вычисления продолжения имени группы."
      958               :
      959                   assign
      960                       v-char-counter  = v-char-counter + 1
      961                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
      962                       v-names-counter = 0
      963                   .
      964                   compare-block:
      965                   for each temp_grplib_found-grp
      966                   :
      967                       assign
      968                           v-names-counter = v-names-counter + 1
      969                       .
      970                       if v-names-counter = 1
      971                       then do:
      972                           next compare-block.
      973                       end.
      974                       if substring( temp_grplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
      975                       then do:
      976                           leave counter-block.
      977                       end.
      978                   end.
      979                   if v-names-counter = 1
      980                   then do:
      981                       assign
      982                           p-substring = v-base-string
      983                       .
      984                       return.
      985                   end.
      986               end.
      987               assign
      988                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
      989               .
      990           end.
      991   end.
      992   end procedure.
      993   procedure grplib-is-terminal :
      994   do
      995   on error undo, return error "Ошибка процедуры grplib-is-terminal"
      996   :
      997   define input parameter p-node-code      as integer      no-undo.
      998   define output parameter p-is-terminal   as logical      no-undo.
      999       define buffer buf_gds-grp       for ub.gds-grp.
     1000       find first buf_gds-grp no-lock
     1001           where buf_gds-grp.upper-code = p-node-code
     1002       no-error .
     1003       if not available buf_gds-grp
     1004       then do:
     1005           assign
     1006               p-is-terminal = yes
     1007           .
     1008       end.
     1009       else do:
     1010           assign
     1011               p-is-terminal = no
     1012           .
     1013       end.
     1014   end.
     1015   end procedure.
     1016   procedure grplib-have-goods :
     1017   do
     1018   on error undo, return error
     1019   :
     1020   define input parameter p-node-code      as integer      no-undo.
     1021   define output parameter p-have-goods   as logical      no-undo.
     1022       define buffer buf_goods         for ub.goods.
     1023       find first buf_goods no-lock
     1024            where buf_goods.grp-code = p-node-code
     1025       no-error .
     1026       if available buf_goods
     1027       then do:
     1028           assign
     1029               p-have-goods = yes
     1030           .
     1031       end.
     1032       else do:
     1033           assign
     1034               p-have-goods = no
     1035           .
     1036       end.
     1037   end.
     1038   end procedure.
     1039   procedure grplib-find-by-substring :
     1040   do
     1041   on error undo, return error
     1042   :
     1043   define input parameter p-start-code         as integer      no-undo.
     1044   define input parameter p-full-search-string as character    no-undo.
     1045   define output parameter p-found-code        as integer      no-undo.
     1046   define output parameter p-full-name         as character    no-undo.
     1047       define variable v-start-code     as integer           no-undo.
     1048       define variable v-found          as logical  init no  no-undo.
     1049       define buffer buf_gds-grp       for ub.gds-grp.
     1050       search-grp:
     1051       for each buf_gds-grp no-lock
     1052           where buf_gds-grp.node-code > p-start-code
     1053       :
     1054           if index( buf_gds-grp.node-name, p-full-search-string ) <> 0
     1055           then do:
     1056               assign
     1057                   p-found-code = buf_gds-grp.node-code
     1058                   v-found      = yes
     1059               .
     1060               run grplib-get-full-name in this-procedure (
     1061                     input p-found-code
     1062                   , output p-full-name
     1063               ) no-error .
     1064               if error-status :error
     1065               then do:
     1066                   undo, return error "grplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
     1067               end.
     1068               leave search-grp.
     1069           end.
     1070       end.
     1071       if v-found = yes
     1072       then do:
     1073       end.
     1074       else do:
     1075           assign
     1076               p-full-name  = ""
     1077               p-found-code = 0
     1078           .
     1079       end.
     1080   end.
     1081   end procedure.
     1082   procedure grplib-analyze-grp-name :
     1083   do
     1084   on error undo, return error
     1085   :
     1086   define input parameter p-grp-name       as character            no-undo.
     1087   define input parameter p-upper-code     as integer              no-undo.
     1088   define output parameter p-error-message as character init ""    no-undo.
     1089       define variable v-char-list     as character    no-undo.
     1090       define variable v-char-counter  as integer      no-undo.
     1091       define variable v-full-name     as character    no-undo.
     1092       if p-grp-name = "" then do:
     1093           assign
     1094               p-error-message = "Название группы не может быть пустым.".
     1095           .
     1096       end.
     1097       else do:
     1098           assign
     1099               v-char-list = "47,92,58,63,34,60,62,171,187,183"
     1100           .
     1101           do v-char-counter = 1 to num-entries( v-char-list )
     1102           :
     1103               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
     1104               then do:
     1105                   assign
     1106                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
     1107                   .
     1108                   return.
     1109               end.
     1110           end.
     1111           if p-upper-code > 0
     1112           then do:
     1113               run grplib-get-full-name in this-procedure (
     1114                     input p-upper-code
     1115                   , output v-full-name
     1116               ) no-error .
     1117               if error-status :error
     1118               then do:
     1119                   undo, return error "grplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
     1120               end.
     1121               if length( v-full-name ) + 1 + length( p-grp-name ) > 350
     1122               then do:
     1123                   assign
     1124                       p-error-message = 'Полное название группы не может содержать более 350 символов.'
     1125                   .
     1126               end.
     1127           end.
     1128       end.
     1129   end.
     1130   end procedure.
     1131   procedure grplib-get-lvl-num :
     1132   define input parameter p-node-code  as integer      no-undo.
     1133   define output parameter p-lvl-num   as integer      no-undo.
     1134       define variable v-full-name    as character    no-undo.
     1135   do
     1136   on error undo, return error
     1137   :
     1138       run grplib-get-full-name in this-procedure (
     1139             input p-node-code
     1140           , output v-full-name
     1141       ).
     1142       assign
     1143           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
     1144       .
     1145       if p-lvl-num = -1
     1146       then do:
     1147           assign
     1148               p-lvl-num = 0
     1149           .
     1150       end.
     1151   end.
     1152   end procedure.
     1153   do
     1154   on error undo, return error
     1155   :
     1156   define temp-table temp_goods no-undo
     1157       field gds-code  as integer
     1158       field artic     as character
     1159       field prod-type as character
     1160       field prod-code as integer
     1161       field full-grp-name  as character
     1162       field gds-name  as character
     1163       index pi    is primary unique gds-code
     1164       index apc   is unique artic prod-type prod-code
     1165       index grp full-grp-name
     1166   .
     1167   define variable grp-path    like ub.clients.grp-name  no-undo.
     1168   define variable v-line              as character         no-undo.
     1169   define variable v-status            as character         no-undo.
     1170   define variable v-node-name         as character         no-undo.
     1171   define variable v-node-code         as integer           no-undo.
     1172   define variable v-start-node-name   as character     no-undo.
     1173   define variable v-is-terminal       as logical       no-undo.
     1174   define variable sym1 as character  init ":"   no-undo.
     1175   define variable sym2 as character  init ":"   no-undo.
     1176   define variable sym3 as character  init ":"   no-undo.
     1177   define variable sym4 as character  init ":"   no-undo.
     1178   define variable i as integer no-undo .
     1179   define buffer buf_start_gds-grp for ub.gds-grp.
     1180   define buffer buf_gds-grp       for ub.gds-grp.
     1181   define buffer buf_goods         for ub.goods.
     1182   define frame GdsListRpt
     1183       sym1 column-label ":" format "x(1)"
     1184       buf_goods.gds-name column-label "Наименование" format "x(50)"
     1185       sym2 column-label ":" format "x(1)"
     1186       buf_goods.artic column-label "Артикул" format "x(16)"
     1187       sym3 column-label ":" format "x(1)"
     1188       v-status column-label "Статус" format "x(5)"
     1189       sym4 column-label ":" format "x(1)"
     1190       header
     1191           cur-time-print() at 5 format "X(35)"
     1192           string( "Страница " + string( PAGE-NUMBER( PrnLibStream )  , ">>>>9") ) at 54 format "X(17)" skip
     1193           v-line format "X(120)" at 1
     1194   with width 235 down stream-io use-text .
     1195   define frame frmgrp
     1196       v-node-code   format ">>>>>>>>>9" space(2)
     1197       v-node-name   format "X(170)"
     1198       with width 198 down stream-io use-text no-labels no-box .
     1199   find first buf_start_gds-grp no-lock
     1200        where recid( buf_start_gds-grp ) = p-gds-grp-recid
     1201   .
     1202   run grplib-get-full-name in this-procedure( input buf_start_gds-grp.node-code, output grp-path ).
     1203   if session :set-wait-state( "compiler" ) then.
     1204   run prn-lib-open-stream  in this-procedure (
     1205                                                input parParentProc
     1206                                               ,input 43
     1207                                               ,input yes
     1208                                               ,input no
     1209                                               ).
     1210   assign
     1211       v-line = fill( "-", 120 )
     1212   .
     1213   put stream PrnLibStream space(20) "СПИСОК  ГРУПП  ТОВАРОВ." format "x(30)" skip(1).
     1214   form header
     1215       v-line format "X(120)"
     1216       skip "Продолжение - на следующей странице" at 30
     1217       skip
     1218   with frame GdsBottomframe
     1219   width 235
     1220   page-bottom
     1221   no-labels
     1222   no-box
     1223   .
     1224   run grplib-find-all-subgroup in this-procedure (
     1225             input buf_start_gds-grp.node-code
     1226           , input no
     1227   ).
     1228   if p-print-option = "terminal":U
     1229   then do:
     1230       view stream PrnLibStream frame gdsbottomframe .
     1231       run grplib-is-terminal in this-procedure (
     1232             input buf_start_gds-grp.node-code
     1233           , output v-is-terminal
     1234       ).
     1235       if v-is-terminal = yes then do:
     1236           put stream PrnLibStream
     1237               space(2) string( "Группа: " + grp-path ) format "X(180)"
     1238               skip
     1239               v-line format "X(120)"
     1240               skip
     1241           .
     1242           view stream PrnLibStream frame GdsListRpt.
     1243           for each buf_goods no-lock
     1244              where buf_goods.grp-code = buf_start_gds-grp.node-code
     1245           on error undo, return error
     1246           :
     1247               display stream PrnLibStream
     1248                   sym1 buf_goods.gds-name
     1249                   sym2 buf_goods.artic
     1250                   sym3 "УДАЛЕН" when buf_goods.stts <> 0      @ v-status
     1251                   sym4
     1252               with frame GdsListRpt.
     1253               down stream PrnLibStream 1 with frame GdsListRpt .
     1254           end.
     1255           put stream PrnLibStream
     1256               v-line format "X(120)"
     1257               skip
     1258           .
     1259       end.
     1260       for each temp_grplib_found-grp
     1261          where temp_grplib_found-grp.is-terminal = yes
     1262       :
     1263           down stream PrnLibStream 1 with frame GdsListRpt .
     1264           put stream PrnLibStream
     1265               space(2) string( "Группа: " + temp_grplib_found-grp.full-name ) format "X(180)"
     1266               skip
     1267               v-line format "X(120)"
     1268               skip
     1269           .
     1270           for each buf_goods no-lock
     1271              where buf_goods.grp-code = temp_grplib_found-grp.node-code
     1272           on error undo, return error
     1273           :
     1274               display stream PrnLibStream
     1275                   sym1 buf_goods.gds-name
     1276                   sym2 buf_goods.artic
     1277                   sym3 "УДАЛЕН" when buf_goods.stts <> 0      @ v-status
     1278                   sym4
     1279               with frame GdsListRpt.
     1280               down stream PrnLibStream 1 with frame GdsListRpt .
     1281           end.
     1282           put stream PrnLibStream
     1283               v-line format "X(120)"
     1284               skip
     1285           .
     1286       end.
     1287       hide stream PrnLibStream frame GdsBottomframe .
     1288       put stream PrnLibStream v-line format "X(120)" skip.
     1289   end.
     1290   else do:
     1291       form with frame frmgrp .
     1292       display stream PrnLibStream
     1293       buf_start_gds-grp.node-code @ v-node-code
     1294       grp-path                    @ v-node-name
     1295       with frame frmgrp .
     1296       down stream PrnLibStream 1 with frame frmgrp .
     1297       for each temp_grplib_found-grp
     1298       :
     1299           display stream PrnLibStream
     1300               temp_grplib_found-grp.node-code     @ v-node-code
     1301               temp_grplib_found-grp.full-name     @ v-node-name
     1302           with frame frmgrp .
     1303           down stream PrnLibStream 1 with frame frmgrp .
     1304       end.
     1305       hide stream PrnLibStream frame GdsBottomframe .
     1306   end.
     1307   if session :set-wait-state( "" ) then.
     1308   output stream PrnLibStream close.
     1309   run prn-lib-prn-file in this-procedure (
     1310                                             input parParentProc
     1311                                             ,input 0
     1312                                             ).
     1313   end.
