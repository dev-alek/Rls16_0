     2942                                               and can-find(first g#post  where  post-stk-line.cli-type = g#post.obj-type and  post-stk-line.cli-code = g#post.obj-code ) = TRUE
     2943                                               :
     2944                    find first  temp-t-post-stk-line where
     2945                      temp-t-post-stk-line.cli-type  = post-stk-line.cli-type  and
     2946                      temp-t-post-stk-line.cli-code  = post-stk-line.cli-code   and
     2947                      temp-t-post-stk-line.artic     = post-stk-line.artic     and
     2948                      temp-t-post-stk-line.prod-type = post-stk-line.prod-type and
     2949                      temp-t-post-stk-line.prod-code = post-stk-line.prod-code no-lock no-error .
     2950                      if not available  temp-t-post-stk-line then do:
     2951                         find first  ub.goods no-lock where
     2952                                               ub.goods.artic     = post-stk-line.artic     and
     2953                                               ub.goods.prod-type = post-stk-line.prod-type and
     2954                                               ub.goods.prod-code = post-stk-line.prod-code no-error .
     2955                         find first  prod-cli no-lock  where
     2956                                                   prod-cli.obj-type = post-stk-line.prod-type and
     2957                                                   prod-cli.obj-code = post-stk-line.prod-code
     2958                                                   no-error .
     2959                         find first  ub.clients  no-lock  where
     2960                                                   ub.clients.obj-type = post-stk-line.cli-type and
     2961                                                   ub.clients.obj-code = post-stk-line.cli-code no-error .
     2962                           run create-temp-t-post-stk-line .
     2963                    end.
