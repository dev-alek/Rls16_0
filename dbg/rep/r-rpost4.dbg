     4472                         ub.goods.prod-type = post-stk-line.prod-type and
     4473                         ub.goods.prod-code = post-stk-line.prod-code  and  can-find(first gds-list where  ub.goods.gds-code = gds-list.gds-code ) = TRUE
     4474                         :
     4475                    find first  temp-t-post-stk-line where
     4476                      temp-t-post-stk-line.cli-type  = post-stk-line.cli-type  and
     4477                      temp-t-post-stk-line.cli-code  = post-stk-line.cli-code   and
     4478                      temp-t-post-stk-line.artic     = post-stk-line.artic     and
     4479                      temp-t-post-stk-line.prod-type = post-stk-line.prod-type and
     4480                      temp-t-post-stk-line.prod-code = post-stk-line.prod-code no-lock no-error .
     4481                      if not available temp-t-post-stk-line then do:
     4482                         find first  prod-cli no-lock  where
     4483                                                   prod-cli.obj-type = post-stk-line.prod-type and
     4484                                                   prod-cli.obj-code = post-stk-line.prod-code
     4485                                                   no-error .
     4486                         find first  ub.clients  no-lock  where
     4487                                                   ub.clients.obj-type = post-stk-line.cli-type and
     4488                                                   ub.clients.obj-code = post-stk-line.cli-code no-error .
     4489                           run create-temp-t-post-stk-line .
     4490                    end.
     4491                    else do:
     4492                            assign
     4493                              temp-t-post-stk-line.fact-order = post-stk-line.fact-order  .
     4494                            .
     4495                    end.
     4496             end.
     4497             for each temp-t-post-stk-line no-lock   ,
     4498                    last temp-post-stk-line  where
     4499                                               temp-post-stk-line.fact-order <=  fact-order-2 and
     4500                                               temp-post-stk-line.cat-id     =  t#cat-id                         and
     4501                                               temp-post-stk-line.sum-type   =  t#sum-type                       and
     4502                                               temp-post-stk-line.artic      =  temp-t-post-stk-line.artic       and
     4503                                               temp-post-stk-line.prod-type  =  temp-t-post-stk-line.prod-type   and
     4504                                               temp-post-stk-line.prod-code  =  temp-t-post-stk-line.prod-code   and
     4505                                               temp-post-stk-line.obj-type   =  temp-t-post-stk-line.obj-type    and
     4506                                               temp-post-stk-line.obj-code   =  temp-t-post-stk-line.obj-code    and
     4507                                               temp-post-stk-line.cli-type   =  temp-t-post-stk-line.cli-type    and
     4508                                               temp-post-stk-line.cli-code   =  temp-t-post-stk-line.cli-code
     4509                                               no-lock
     4510                                               break
     4511                                               by ((temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code)))
     4512                                               by ((temp-t-post-stk-line.artic + temp-t-post-stk-line.prod-type + string(temp-t-post-stk-line.prod-code)))
     4513                                               by temp-t-post-stk-line.fact-order :
     4514                                       if first-of( (temp-t-post-stk-line.artic + temp-t-post-stk-line.prod-type + string(temp-t-post-stk-line.prod-code)) ) then do : run goods-start. end .
     4515                                       if last-of ( (temp-t-post-stk-line.artic + temp-t-post-stk-line.prod-type + string(temp-t-post-stk-line.prod-code)) ) then do : run goods-end.
     4516                                          run display-line .
     4517                                       end.
     4518                                       if last-of( (temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code)) ) then do :
     4519                                          run tmp-create (temp-t-post-stk-line.cli-code,
     4520                                                          temp-t-post-stk-line.cli-type,
     4521                                                          temp-t-post-stk-line.clients-obj-name,
     4522                                                          obj-list.obj-code,
     4523                                                          obj-list.obj-type ) .
     4524                                          run tmp-clear.
     4525                                       end.
     4526             end.
     4527          end.
     4528          for each tmp-cli-gds no-lock
     4529              break
     4530              by tmp-cli-gds.name
     4531              by (tmp-cli-gds.cli-type + string(tmp-cli-gds.cli-code)) :
     4532              if first-of(tmp-cli-gds.cli-type + string(tmp-cli-gds.cli-code)) then run tmp-clear.
     4533               run tmp-assign.
     4534              if last-of((tmp-cli-gds.cli-type + string(tmp-cli-gds.cli-code))) then do:
     4535                  run print-footer ( 3 ,tmp-cli-gds.name).
     4536              end.
     4537          end.
     4538   End procedure.
     4539   procedure Goods-start :
     4540   END PROCEDURE.
     4541   procedure Goods-end :
     4542   END PROCEDURE.
     4543   PROCEDURE display-line :
     4544     i = i + 1.
     4545   If Integer(10) = 0 Then Temp1  = 100  .
     4546                         Else Temp1 = Integer(10) .
     4547        IF ( i modulo Temp1 = 0 ) AND ( i >= Temp1 ) then
     4548            RUN waitfram-show( "Обработано строк : " + string( i )) .
     4549     run clear-item in this-procedure .
     4550       assign
     4551             gds-zap-gds-name   = temp-t-post-stk-line.gds-name
     4552             gds-zap-unit-base  = temp-t-post-stk-line.unit-base
     4553             gds-zap-prt-root   = temp-t-post-stk-line.prt-root
     4554             gds-zap-prod-type  = temp-t-post-stk-line.prod-type
     4555             gds-zap-prod-code  = temp-t-post-stk-line.prod-code
     4556             gds-zap-artic      = temp-t-post-stk-line.artic
     4557             gds-zap-grp-name   = temp-t-post-stk-line.Goods-grp-name
     4558             gds-zap-b-code     = temp-t-post-stk-line.gds-code
     4559             gds-zap-type       = temp-t-post-stk-line.gds-type
     4560             pos-cli-type       = temp-t-post-stk-line.Cli-type
     4561             pos-cli-code       = temp-t-post-stk-line.Cli-code
     4562             pos-cli-grp-name   = temp-t-post-stk-line.Clients-grp-name.
     4563       run ob-line (
     4564                temp-t-post-stk-line.obj-code    ,
     4565                temp-t-post-stk-line.obj-type    ,
     4566                temp-t-post-stk-line.cli-code    ,
     4567                temp-t-post-stk-line.cli-type    ,
     4568                temp-t-post-stk-line.artic       ,
     4569                temp-t-post-stk-line.prod-code   ,
     4570                temp-t-post-stk-line.prod-type   ,
     4571                Fact-order-1   ,
     4572                Fact-order-2   ,
     4573                t#sum-type     ,
     4574                t#cat-id       ,
     4575                ""             ,
     4576                yes) .
     4577      if Show-Sale Then  run ob-line (
     4578                temp-t-post-stk-line.obj-code    ,
     4579                temp-t-post-stk-line.obj-type    ,
     4580                temp-t-post-stk-line.cli-code    ,
     4581                temp-t-post-stk-line.cli-type    ,
     4582                temp-t-post-stk-line.artic       ,
     4583                temp-t-post-stk-line.prod-code   ,
     4584                temp-t-post-stk-line.prod-type   ,
     4585                Fact-order-1   ,
     4586                Fact-order-2   ,
     4587                'sale':U    ,
     4588                '##':U ,
     4589                ""             ,
     4590                yes) .
     4591            run calc-sub-itog in this-procedure (0).
     4592               if Show-Sale Then run calc-sub-itog in this-procedure (3).
     4593               IF  NOT (NOT Show-Negativ  AND (
     4594                                          RAsh         [1] = 0  AND
     4595                                          KAssa        [1] = 0  AND
     4596                                          Inv          [1] = 0  AND
     4597                                          vzvr         [1] = 0  AND
     4598                                          vzvr-post    [1] = 0
     4599                                          ))
     4600            then DO:
     4601              IF NOT Sums-Only then DO:
     4602                 run display-str1.
     4603              End.
     4604            End.
     4605            run clear-item.
     4606     END PROCEDURE.
     4607   PROCEDURE display-str1  :
     4608        run di-qnty ("кол-во", 1, gds-zap-b-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     4609            if show-cost        then do: run di ("учет."  , 2 , "","", "", "", "":u).  end.
     4610            if show-cost-vat    then do: run di ("уч.НДС" , 3 , "","", "", "", "":u).  end.
     4611            if show-sale        then do: run di ("док-т." , 5 , "","", "", "", "":u).  end.
     4612            if show-sale-vat    then do: run di ("д .НДС" , 6 , "","", "", "", "":u).  end.
     4613   END PROCEDURE.
     4614   PROCEDURE Di :
     4615   def input parameter p1 as char no-undo.
     4616   def input parameter p2 as int no-undo.
     4617   def input parameter p3 as char no-undo.
     4618   def input parameter p4 as char no-undo.
     4619   def input parameter p5 as char no-undo.
     4620   def input parameter p6 as char no-undo.
     4621   def input parameter p7 as char no-undo.
     4622    CASE CAPS(p7) :
     4623      WHEN "P":U  Then
     4624                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     4625                   p3 @ gds-zap-b-code
     4626                   p4 @ gds-zap-artic
     4627                   p5 @ gds-zap-gds-name
     4628                   p6 @ gds-zap-unit-base
     4629                   p1 @ gds-type
     4630                  p-vzvr      [p2]    @  F-vzvr
     4631                  p-vzvr-post [p2]    @  F-vzvr-post
     4632                  p-RAsh      [p2]    @  F-RAsh
     4633                  p-KAssa     [p2]    @  F-KAssa
     4634                  p-Inv       [p2]    @  F-Inv
     4635                  p-spis      [p2]    @  F-spis
     4636                  with FRAME ZAPAS .
     4637      WHEN "O":U  Then
     4638                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     4639                   p3 @ gds-zap-b-code
     4640                   p4 @ gds-zap-artic
     4641                   p5 @ gds-zap-gds-name
     4642                   p6 @ gds-zap-unit-base
     4643                   p1 @ gds-type
     4644                  o-vzvr      [p2]    @  F-vzvr
     4645                  o-vzvr-post [p2]    @  F-vzvr-post
     4646                  o-RAsh      [p2]    @  F-RAsh
     4647                  o-KAssa     [p2]    @  F-KAssa
     4648                  o-Inv       [p2]    @  F-Inv
     4649                  o-spis      [p2]    @  F-spis
     4650                  with FRAME ZAPAS .
     4651      WHEN "B1":U  Then
     4652                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     4653                   p3 @ gds-zap-b-code
     4654                   p4 @ gds-zap-artic
     4655                   p5 @ gds-zap-gds-name
     4656                   p6 @ gds-zap-unit-base
     4657                   p1 @ gds-type
     4658                  b1-vzvr      [p2]    @  F-vzvr
     4659                  b1-vzvr-post [p2]    @  F-vzvr-post
     4660                  b1-RAsh      [p2]    @  F-RAsh
     4661                  b1-KAssa     [p2]    @  F-KAssa
     4662                  b1-Inv       [p2]    @  F-Inv
     4663                  b1-spis      [p2]    @  F-spis
     4664                  with FRAME ZAPAS .
     4665      WHEN "B2":U  Then
     4666                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     4667                   p3 @ gds-zap-b-code
     4668                   p4 @ gds-zap-artic
     4669                   p5 @ gds-zap-gds-name
     4670                   p6 @ gds-zap-unit-base
     4671                   p1 @ gds-type
     4672                  b2-vzvr      [p2]    @  F-vzvr
     4673                  b2-vzvr-post [p2]    @  F-vzvr-post
     4674                  b2-RAsh      [p2]    @  F-RAsh
     4675                  b2-KAssa     [p2]    @  F-KAssa
     4676                  b2-Inv       [p2]    @  F-Inv
     4677                  b2-spis      [p2]    @  F-spis
     4678                  with FRAME ZAPAS .
     4679      WHEN "BI":U Then
     4680                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     4681                   p3 @ gds-zap-b-code
     4682                   p4 @ gds-zap-artic
     4683                   p5 @ gds-zap-gds-name
     4684                   p6 @ gds-zap-unit-base
     4685                   p1 @ gds-type
     4686                  bi-vzvr      [p2]    @  F-vzvr
     4687                  bi-vzvr-post [p2]    @  F-vzvr-post
     4688                  bi-RAsh      [p2]    @  F-RAsh
     4689                  bi-KAssa     [p2]    @  F-KAssa
     4690                  bi-Inv       [p2]    @  F-Inv
     4691                  bi-spis      [p2]    @  F-spis
     4692                  with FRAME ZAPAS .
     4693      WHEN ""  Then DO:
     4694                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     4695                   p3 @ gds-zap-b-code
     4696                   p4 @ gds-zap-artic
     4697                   p5 @ gds-zap-gds-name
     4698                   p6 @ gds-zap-unit-base
     4699                   p1 @ gds-type
     4700                  vzvr      [p2]    @  F-vzvr
     4701                  vzvr-post [p2]    @  F-vzvr-post
     4702                  RAsh      [p2]    @  F-RAsh
     4703                  KAssa     [p2]    @  F-KAssa
     4704                  Inv       [p2]    @  F-Inv
     4705                  spis      [p2]    @  F-spis
     4706                  with FRAME ZAPAS .
     4707                 End.
     4708      End case.
     4709                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     4710    END PROCEDURE.
     4711   PROCEDURE Di-qnty :
     4712   def input parameter p1 as char no-undo.
     4713   def input parameter p2 as int no-undo.
     4714   def input parameter p3 as char no-undo.
     4715   def input parameter p4 as char no-undo.
     4716   def input parameter p5 as char no-undo.
     4717   def input parameter p6 as char no-undo.
     4718   def input parameter p7 as char no-undo.
     4719    CASE CAPS(p7) :
     4720      WHEN "O":U  Then DO :
     4721                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     4722                   p3 @ gds-zap-b-code
     4723                   p4 @ gds-zap-artic
     4724                   p5 @ gds-zap-gds-name
     4725                   p6 @ gds-zap-unit-base
     4726                   p1 @ gds-type
     4727                  o-vzvr      [p2]    @  F-vzvr
     4728                  o-vzvr-post [p2]    @  F-vzvr-post
     4729                  o-RAsh      [p2]    @  F-RAsh
     4730                  o-KAssa     [p2]    @  F-KAssa
     4731                  o-Inv       [p2]    @  F-Inv
     4732                  o-spis      [p2]    @  F-spis
     4733                  with FRAME ZAPAS .
     4734       if Make-Excel then  put   stream ForExcel unformatted p3 CHR(9)
     4735                   p4 CHR(9)
     4736                   p5 CHR(9)
     4737                   p6 CHR(9)
     4738                   gds-zap-type CHR(9)
     4739                    excel-qnty(o-RAsh         [1]  ) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4740   if Showcost       then (     excel-sum  (   o-RAsh[2] )  + CHR(9)   ) else ("")
     4741   if Show-cost-vat  then (     excel-sum  (   o-RAsh[3] )  + CHR(9)   ) else ("")
     4742   if Showsale       then (     excel-sum  (   o-RAsh[5] )  + CHR(9)   ) else ("")
     4743   if Show-sale-vat  then (     excel-sum  (   o-RAsh[6] )  + CHR(9)   ) else ("")
     4744                    excel-qnty(o-KAssa        [1]) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4745   if Showcost       then (     excel-sum  (   o-KAssa[2])  + CHR(9)    ) else ("")
     4746   if Show-cost-vat  then (     excel-sum  (   o-KAssa[3])  + CHR(9)    ) else ("")
     4747   if Showsale       then (     excel-sum  (   o-KAssa[5])  + CHR(9)    ) else ("")
     4748   if Show-sale-vat  then (     excel-sum  (   o-KAssa[6])  + CHR(9)    ) else ("")
     4749   .
     4750   if Make-Excel then  put   stream ForExcel unformatted     excel-qnty( o-Inv            [1] ) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4751   if Showcost       then (     excel-sum  (   o-Inv [2] ) + CHR(9)    ) else ("")
     4752   if Show-cost-vat  then (     excel-sum  (   o-Inv [3] ) + CHR(9)    ) else ("")
     4753   if Showsale       then (     excel-sum  (   o-Inv [5] ) + CHR(9)    ) else ("")
     4754   if Show-sale-vat  then (     excel-sum  (   o-Inv [6] ) + CHR(9)    ) else ("")
     4755                    excel-qnty(o-vzvr         [1]) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4756   if Showcost       then (     excel-sum  (   o-vzvr [2] ) + CHR(9)    ) else ("")
     4757   if Show-cost-vat  then (     excel-sum  (   o-vzvr [3] ) + CHR(9)    ) else ("")
     4758   if Showsale       then (     excel-sum  (   o-vzvr [5] ) + CHR(9)    ) else ("")
     4759   if Show-sale-vat  then (     excel-sum  (   o-vzvr [6] ) + CHR(9)    ) else ("")
     4760                   excel-qnty(o-vzvr-post    [1]) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4761   if Showcost       then (     excel-sum  (   o-vzvr-post[2] ) + CHR(9)     ) else ("")
     4762   if Show-cost-vat  then (     excel-sum  (   o-vzvr-post[3] ) + CHR(9)     ) else ("")
     4763   if Showsale       then (     excel-sum  (   o-vzvr-post[5] ) + CHR(9)     ) else ("")
     4764   if Show-sale-vat  then (     excel-sum  (   o-vzvr-post[6] ) + CHR(9)     ) else ("")
     4765                   excel-qnty(o-spis    [1] ) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4766   if Showcost       then (     excel-sum  (   o-spis[2] ) + CHR(9)     ) else ("")
     4767   if Show-cost-vat  then (     excel-sum  (   o-spis[3] ) + CHR(9)     ) else ("")
     4768   if Showsale       then (     excel-sum  (   o-spis[5] ) + CHR(9)     ) else ("")
     4769   if Show-sale-vat  then (     excel-sum  (   o-spis[6] ) + CHR(9)     ) else ("")
     4770            chr(10).
     4771                   End.
     4772      WHEN "P":U  Then DO :
     4773                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     4774                   p3 @ gds-zap-b-code
     4775                   p4 @ gds-zap-artic
     4776                   p5 @ gds-zap-gds-name
     4777                   p6 @ gds-zap-unit-base
     4778                   p1 @ gds-type
     4779                  p-vzvr      [p2]    @  F-vzvr
     4780                  p-vzvr-post [p2]    @  F-vzvr-post
     4781                  p-RAsh      [p2]    @  F-RAsh
     4782                  p-KAssa     [p2]    @  F-KAssa
     4783                  p-Inv       [p2]    @  F-Inv
     4784                  p-spis      [p2]    @  F-spis
     4785                  with FRAME ZAPAS .
     4786       if Make-Excel then  put   stream ForExcel unformatted p3 CHR(9)
     4787                   p4 CHR(9)
     4788                   p5 CHR(9)
     4789                   p6 CHR(9)
     4790                   gds-zap-type CHR(9)
     4791                    excel-qnty(p-RAsh         [1]  ) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4792   if Showcost       then (     excel-sum  (   p-RAsh[2] )  + CHR(9)   ) else ("")
     4793   if Show-cost-vat  then (     excel-sum  (   p-RAsh[3] )  + CHR(9)   ) else ("")
     4794   if Showsale       then (     excel-sum  (   p-RAsh[5] )  + CHR(9)   ) else ("")
     4795   if Show-sale-vat  then (     excel-sum  (   p-RAsh[6] )  + CHR(9)   ) else ("")
     4796                    excel-qnty(p-KAssa        [1]) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4797   if Showcost       then (     excel-sum  (   p-KAssa[2])  + CHR(9)    ) else ("")
     4798   if Show-cost-vat  then (     excel-sum  (   p-KAssa[3])  + CHR(9)    ) else ("")
     4799   if Showsale       then (     excel-sum  (   p-KAssa[5])  + CHR(9)    ) else ("")
     4800   if Show-sale-vat  then (     excel-sum  (   p-KAssa[6])  + CHR(9)    ) else ("")
     4801   .
     4802   if Make-Excel then  put   stream ForExcel unformatted     excel-qnty( p-Inv            [1] ) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4803   if Showcost       then (     excel-sum  (   p-Inv [2] ) + CHR(9)    ) else ("")
     4804   if Show-cost-vat  then (     excel-sum  (   p-Inv [3] ) + CHR(9)    ) else ("")
     4805   if Showsale       then (     excel-sum  (   p-Inv [5] ) + CHR(9)    ) else ("")
     4806   if Show-sale-vat  then (     excel-sum  (   p-Inv [6] ) + CHR(9)    ) else ("")
     4807                    excel-qnty(p-vzvr         [1]) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4808   if Showcost       then (     excel-sum  (   p-vzvr [2] ) + CHR(9)    ) else ("")
     4809   if Show-cost-vat  then (     excel-sum  (   p-vzvr [3] ) + CHR(9)    ) else ("")
     4810   if Showsale       then (     excel-sum  (   p-vzvr [5] ) + CHR(9)    ) else ("")
     4811   if Show-sale-vat  then (     excel-sum  (   p-vzvr [6] ) + CHR(9)    ) else ("")
     4812                   excel-qnty(p-vzvr-post    [1]) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4813   if Showcost       then (     excel-sum  (   p-vzvr-post[2] ) + CHR(9)     ) else ("")
