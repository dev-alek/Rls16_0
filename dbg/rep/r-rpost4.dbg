     5034    END PROCEDURE.
     5035   PROCEDURE Clear-item :
     5036   def var kk as int no-undo.
     5037    REPEAT kk = 1 to 9:
     5038    Assign
     5039       rash             [kk]  = 0
     5040       kassa            [kk]  = 0
     5041       Inv              [kk]  = 0
     5042       vzvr-post        [kk]  = 0
     5043       vzvr             [kk]  = 0
     5044       spis             [kk]  = 0 .
     5045          End.
     5046    END PROCEDURE.
     5047   PROCEDURE ob-line :
     5048   def input  parameter x-store-code   like ub.clients.obj-code     no-undo.
     5049   def input  parameter x-store-type   like ub.clients.obj-type     no-undo.
     5050   def input  parameter x-cli-code     like ub.clients.obj-code     no-undo.
     5051   def input  parameter x-cli-type     like ub.clients.obj-type     no-undo.
     5052   def INPUT  parameter x-artic        like post-ot-line.artic        no-undo.
     5053   def INPUT  parameter x-prod-code    like post-ot-line.prod-code    no-undo.
     5054   def INPUT  parameter x-prod-type    like post-ot-line.prod-type    no-undo.
     5055   def INPUT  parameter x-Fact-order-1   like post-ot-line.Fact-order   no-undo.
     5056   def INPUT  parameter x-Fact-order-2   like post-ot-line.Fact-order   no-undo.
     5057   def input  parameter x-sum-type       like post-ot-line.sum-type     no-undo.
     5058   def input  parameter x-cat-id         like post-ot-line.cat-id       no-undo.
     5059   def input  parameter x-ext-doc-type   like post-ot-line.ext-doc-type no-undo.
     5060   def input  parameter xTog-obj           as log no-undo .
     5061   def var  tt#          as   int                 no-undo .
     5062   def var tt-cost like  ub.gds-dtl.price-rubl no-undo .
     5063   def var tt-sale like  ub.gds-dtl.price-rubl no-undo .
     5064    if (x-sum-type = 'cost':U  or x-sum-type = 'cssr':U) then tt# = 0.
     5065    if (x-sum-type = 'sale':U  or x-sum-type = 'sasr':U) then tt# = 3.
     5066    if (x-sum-type = 'crsa':U  or x-sum-type = 'cgsr':U) then tt# = 6.
     5067        FOR each post-ot-line where
     5068                 post-ot-line.artic        = x-artic
     5069           AND   post-ot-line.fact-order  <= fact-order-2  AND   post-ot-line.fact-order  >= fact-order-1
     5070           AND   post-ot-line.obj-code     = x-store-code
     5071           AND   post-ot-line.obj-type     = x-store-type
     5072           AND   post-ot-line.prod-code    = x-prod-code
     5073           AND   post-ot-line.prod-type    = x-prod-type
     5074           AND   post-ot-line.cli-code     = x-cli-code
     5075           AND   post-ot-line.cli-type     = x-cli-type
     5076           AND   post-ot-line.sum-type     = x-sum-type
     5077           and   post-ot-line.cat-id       = x-cat-id
     5078           no-lock :
     5079           For each ub.parts no-lock where
     5080                       post-ot-line.artic        = ub.parts.artic
     5081                 AND   post-ot-line.prod-code    = ub.parts.prod-code
     5082                 AND   post-ot-line.prod-type    = ub.parts.prod-type
     5083                 AND   post-ot-line.cli-code     = ub.parts.supp-code
     5084                 AND   post-ot-line.cli-type     = ub.parts.supp-type
     5085                 AND   post-ot-line.obj-code     = ub.parts.obj-code
     5086                 AND   post-ot-line.obj-type     = ub.parts.obj-type
     5087                 AND   post-ot-line.doc-code     = ub.parts.out-code
     5088                 AND   ub.parts.fact-date >= x-date-start
     5089                 AND   ub.parts.fact-date <= x-date-end  :
     5090           CASE post-ot-line.ext-doc-type:
     5091                WHEN         're':U      THEN DO :
     5092              ASSIGN vzvr[1 + tt#]   = vzvr[1 + tt#]   +  ub.parts.fact-qnty
     5093                     vzvr[2 + tt#]   = vzvr[2 + tt#]   +  if tprintrubl then  (ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.sum-rubl else   (ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.sum-base
     5094                     vzvr[3 + tt#]   = vzvr[3 + tt#]   +  if tprintrubl then  (ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.vat-rubl else   (ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.vat-base  .
     5095                    End.
     5096                WHEN       'ep':U    Then DO:
     5097              ASSIGN vzvr-post[1 + tt#]   = vzvr-post[1 + tt#]   +  ub.parts.fact-qnty
     5098                     vzvr-post[2 + tt#]   = vzvr-post[2 + tt#]   +  if tprintrubl then (ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.sum-rubl else (ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.sum-base
     5099                     vzvr-post[3 + tt#]   = vzvr-post[3 + tt#]   +  if tprintrubl then (ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.vat-rubl else (ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.vat-base  .
     5100                     End.
     5101                WHEN       'ee':U       THEN  DO:
     5102              ASSIGN rash[1 + tt#]   = rash[1 + tt#]   +  ub.parts.fact-qnty
     5103                     rash[2 + tt#]   = rash[2 + tt#]   +  if tprintrubl then  (ub.parts.fact-qnty / post-ot-line.fact-qnty) * post-ot-line.sum-rubl else (ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.sum-base
     5104                     rash[3 + tt#]   = rash[3 + tt#]   +  if tprintrubl then  (ub.parts.fact-qnty / post-ot-line.fact-qnty) * post-ot-line.vat-rubl else (ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.vat-base  .
     5105                    End.
     5106                WHEN      'we':U       THEN  DO:
     5107              ASSIGN spis[1 + tt#]   = spis[1 + tt#]   +  ub.parts.fact-qnty
     5108                     spis[2 + tt#]   = spis[2 + tt#]   +  if tprintrubl then (ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.sum-rubl else (ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.sum-base
     5109                     spis[3 + tt#]   = spis[3 + tt#]   +  if tprintrubl then (ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.vat-rubl else (ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.vat-base  .
     5110                    End.
     5111                WHEN       'es':U  then do:
     5112              ASSIGN kassa[1 + tt#]   = kassa[1 + tt#]   +  ub.parts.fact-qnty
     5113                     kassa[2 + tt#]   = kassa[2 + tt#]   +  if tprintrubl then  (ub.parts.fact-qnty / post-ot-line.fact-qnty) * post-ot-line.sum-rubl else (ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.sum-base
     5114                     kassa[3 + tt#]   = kassa[3 + tt#]   +  if tprintrubl then  (ub.parts.fact-qnty / post-ot-line.fact-qnty) * post-ot-line.vat-rubl else (ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.vat-base .
     5115                    End.
     5116                WHEN       'rs':U THEN  DO:
     5117              ASSIGN kassa[1 + tt#]   = kassa[1 + tt#]   -  ub.parts.fact-qnty
     5118                     kassa[2 + tt#]   = kassa[2 + tt#]   +  if tprintrubl then  ( ( -1 ) * ub.parts.fact-qnty / post-ot-line.fact-qnty) * post-ot-line.sum-rubl else ( ( -1 ) * ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.sum-base
     5119                     kassa[3 + tt#]   = kassa[3 + tt#]   +  if tprintrubl then  ( ( -1 ) * ub.parts.fact-qnty / post-ot-line.fact-qnty) * post-ot-line.vat-rubl else ( ( -1 ) * ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.vat-base .
     5120                    End.
     5121                when 'vt':U  or
     5122                when 'vp':U   or
     5123                when 'ap':U   or
     5124                when 'mp':U or
     5125                when 'pc':U     then  do:
     5126                 assign inv[1 + tt#] = inv[1 + tt#]   +  ub.parts.fact-qnty
     5127                        inv[2 + tt#] = inv[2 + tt#]   +  if tprintrubl then (ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.sum-rubl else (ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.sum-base
     5128                        Inv[3 + tt#] = Inv[3 + tt#]   +  if tprintrubl then (ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.vat-rubl else (ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.vat-base  .
     5129              end.
     5130             End CASE.
     5131        End.
     5132      End.
     5133   END PROCEDURE.
     5134   PROCEDURE Calc-Sub-itog :
     5135   def input parameter tt as int no-undo.
     5136   def var b as int no-undo.
     5137   repeat b = 1 to 3:
     5138     Assign
     5139     B1-RAsh[b + TT]    = B1-RAsh[b + TT]    +  RAsh[b + TT]
     5140     B2-RAsh[b + TT]    = B2-RAsh[b + TT]    +  RAsh[b + TT]
     5141     Bi-RAsh[b + TT]    = Bi-RAsh[b + TT]    +  RAsh[b + TT]
     5142     p-RAsh[b + TT]    = p-RAsh[b + TT]    +  RAsh[b + TT]
     5143     o-RAsh[b + TT]    = o-RAsh[b + TT]    +  RAsh[b + TT]
     5144     B1-KAssa[b + TT]    = B1-KAssa[b + TT]    +  KAssa[b + TT]
     5145     B2-kassa[b + TT]    = B2-kassa[b + TT]    +  kassa[b + TT]
     5146     Bi-Kassa[b + TT]    = Bi-Kassa[b + TT]    +  Kassa[b + TT]
     5147     p-Kassa[b + TT]    = p-Kassa[b + TT]    +  Kassa[b + TT]
     5148     o-Kassa[b + TT]    = o-Kassa[b + TT]    +  Kassa[b + TT]
     5149     B1-Inv[b + TT]    = B1-Inv[b + TT]    +  Inv[b + TT]
     5150     B2-Inv[b + TT]    = B2-Inv[b + TT]    +  Inv[b + TT]
     5151     Bi-Inv[b + TT]    = Bi-Inv[b + TT]    +  Inv[b + TT]
     5152     p-Inv[b + TT]    = p-Inv[b + TT]    +  Inv[b + TT]
     5153     o-Inv[b + TT]    = o-Inv[b + TT]    +  Inv[b + TT]
     5154     B1-vzvr[b + TT]    = B1-vzvr[b + TT]    + vzvr[b + TT]
     5155     B2-vzvr[b + TT]    = B2-vzvr[b + TT]    + vzvr[b + TT]
     5156     Bi-vzvr[b + TT]    = Bi-vzvr[b + TT]    + vzvr[b + TT]
     5157     p-vzvr[b + TT]    = p-vzvr[b + TT]    + vzvr[b + TT]
     5158     o-vzvr[b + TT]    = o-vzvr[b + TT]    + vzvr[b + TT]
     5159     B1-spis[b + TT]    = B1-spis[b + TT]    + spis[b + TT]
     5160     B2-spis[b + TT]    = B2-spis[b + TT]    + spis[b + TT]
     5161     Bi-spis[b + TT]    = Bi-spis[b + TT]    + spis[b + TT]
     5162     p-spis[b + TT]     = p-spis[b + TT]    + spis[b + TT]
     5163     o-spis[b + TT]     = o-spis[b + TT]    + spis[b + TT]
     5164     B1-vzvr-post[b + TT]    = B1-vzvr-post[b + TT]    + vzvr-post[b + TT]
     5165     B2-vzvr-post[b + TT]    = B2-vzvr-post[b + TT]    + vzvr-post[b + TT]
     5166     Bi-vzvr-post[b + TT]    = Bi-vzvr-post[b + TT]    + vzvr-post[b + TT]
     5167     p-vzvr-post[b + TT]    = p-vzvr-post[b + TT]    + vzvr-post[b + TT]
     5168     o-vzvr-post[b + TT]    = o-vzvr-post[b + TT]    + vzvr-post[b + TT]
     5169   .
     5170      .
     5171   End.
     5172   END PROCEDURE.
     5173   PROCEDURE U-LINE :
     5174   UNDERLINE stream OutStream  sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     5175           gds-zap-b-code
     5176           gds-zap-artic
     5177           gds-zap-gds-name
     5178           gds-zap-unit-base
     5179           gds-type
     5180           F-Rash
     5181           F-KAssa
     5182           F-Inv
     5183           F-vzvr
     5184           F-vzvr-post
     5185           F-spis
     5186           with FRAME ZAPAS .
     5187           DOWN stream   OutStream 1 with FRAME ZAPAS.
     5188           END PROCEDURE.
     5189   procedure Print-Footer :
     5190   define input parameter Nx as integer no-undo .
     5191   define input parameter Name as char no-undo .
     5192       if Nx = 1 Then DO:
     5193            run di-qnty ("кол-во", 1,"","Итого по : ",trim(name),"","b1").
     5194            if show-cost then do :     run di ( "учет." , 2, "","","","","b1" ).  end.
     5195            if show-cost-vat then do : run di ( "уч.НДС", 3, "","","","","b1" ).  end.
     5196            if show-sale then do :     run di ( "док-т.", 5, "","","","","b1" ).  end.
     5197            if show-sale-vat then do : run di ( "д. НДС", 6, "","","","","b1" ).  end.
     5198            if not sums-only then run u-line.
     5199            run clear-itemb1-.
     5200            end.
     5201    if nx = 2 then do:
     5202            run di-qnty ("кол-во", 1,"","","Итого по : " + trim(name),"","b2").
     5203            if show-cost then do :      run di ( "учет." , 2, "","","","","b2" ).  end.
     5204            if show-cost-vat  then do : run di ( "уч.НДС", 3, "","","","","b2" ).  end.
     5205            if show-sale then do :      run di ( "док-т.", 5, "","","","","b2" ).  end.
     5206            if show-sale-vat  then do : run di ( "д. НДС", 6, "","","","","b2" ).  end.
     5207            if not sums-only then run u-line.
     5208            run clear-itemb2-.
     5209           end.
     5210    if nx = 3 then do:
     5211            if not sums-only then run u-line.
     5212            run di-qnty ("кол-во", 1,"","Итого по пост-ку" , trim(name),"","p").
     5213            if show-cost then do :      run di ( "учет." , 2, "","","","","p" ).  end.
     5214            if show-cost-vat  then do : run di ( "уч.НДС", 3, "","","","","p" ).  end.
     5215            if show-sale then do :      run di ( "док-т.", 5, "","","","","p" ).  end.
     5216            if show-sale-vat  then do : run di ( "д. НДС", 6, "","","","","p" ).  end.
     5217            if not sums-only then run u-line.
     5218            run clear-itemp-.
     5219             end.
     5220    if nx = 0 then do:
     5221            run di-qnty ("кол-во", 1,"","Итого  объект: " , trim(name),"","o").
     5222            if show-cost then do :      run di ( "учет." , 2, "","","","","o" ).  end.
     5223            if show-cost-vat  then do : run di ( "уч.НДС", 3, "","","","","o" ).  end.
     5224            if show-sale then do :      run di ( "док-т.", 5, "","","","","o" ).  end.
     5225            if show-sale-vat  then do : run di ( "д. НДС", 6, "","","","","o" ).  end.
     5226            if not sums-only then run u-line.
     5227            run clear-itemo-.
     5228             end.
     5229    END PROCEDURE.
     5230   PROCEDURE Clear-itemb1- :
     5231   def var kk as int no-undo.
     5232    REPEAT kk = 1 to 9:
     5233    Assign
     5234      b1-rash             [kk]  = 0
     5235      b1-kassa            [kk]  = 0
     5236      b1-Inv              [kk]  = 0
     5237      b1-spis             [kk]  = 0
     5238      b1-vzvr             [kk]  = 0
     5239      b1-vzvr-post        [kk]  = 0
     5240      .
     5241          End.
     5242    END PROCEDURE.
     5243   PROCEDURE Clear-itemb2- :
     5244   def var kk as int no-undo.
     5245    REPEAT kk = 1 to 9:
     5246    Assign
     5247      b2-rash             [kk]  = 0
     5248      b2-kassa            [kk]  = 0
     5249      b2-Inv              [kk]  = 0
     5250      b2-spis             [kk]  = 0
     5251      b2-vzvr             [kk]  = 0
     5252      b2-vzvr-post        [kk]  = 0
     5253      .
     5254      End.
     5255    END PROCEDURE.
     5256   PROCEDURE Clear-itemp- :
     5257   def var kk as int no-undo.
     5258    REPEAT kk = 1 to 9:
     5259    Assign
     5260      p-rash             [kk]  = 0
     5261      p-kassa            [kk]  = 0
     5262      p-Inv              [kk]  = 0
     5263      p-spis              [kk]  = 0
     5264      p-vzvr             [kk]  = 0
     5265      p-vzvr-post        [kk]  = 0
     5266      .
     5267      End.
     5268    END PROCEDURE.
     5269   PROCEDURE Clear-itemo- :
     5270   def var kk as int no-undo.
     5271    REPEAT kk = 1 to 9:
     5272    Assign
     5273      o-rash             [kk]  = 0
     5274      o-kassa            [kk]  = 0
     5275      o-Inv              [kk]  = 0
     5276      o-spis             [kk]  = 0
     5277      o-vzvr             [kk]  = 0
     5278      o-vzvr-post        [kk]  = 0
     5279      .
     5280      End.
     5281    END PROCEDURE.
     5282   Procedure Tmp-create :
     5283   define input parameter p1   like ub.clients.obj-code  no-undo .
     5284   define input parameter p2   like ub.clients.obj-type  no-undo .
     5285   define input parameter Name like ub.clients.obj-name  no-undo .
     5286   define input parameter p3   like obj-list.obj-code no-undo .
     5287   define input parameter p4   like obj-list.obj-type no-undo .
     5288     Create tmp-cli-gds.
     5289    def var kk as int no-undo.
     5290    REPEAT kk = 1 to 9 :
     5291      Assign
     5292         tmp-cli-gds.p-rash[kk]           = p-rash[kk]
     5293         tmp-cli-gds.p-kassa[kk]          = p-kassa[kk]
     5294         tmp-cli-gds.p-Inv[kk]            = p-Inv[kk]
     5295         tmp-cli-gds.p-spis[kk]           = p-spis[kk]
     5296         tmp-cli-gds.p-vzvr[kk]           = p-vzvr[kk]
     5297         tmp-cli-gds.p-vzvr-post[kk]      = p-vzvr-post[kk]
     5298         .
     5299    end.
     5300         assign
     5301         tmp-cli-gds.cli-code         = p1
     5302         tmp-cli-gds.cli-type         = p2
     5303         tmp-cli-gds.Name             = Name
     5304         tmp-cli-gds.obj-code         = p3
     5305         tmp-cli-gds.obj-type         = p4
     5306         .
     5307    END PROCEDURE.
     5308   Procedure Tmp-clear :
     5309    def var kk as int no-undo.
     5310    REPEAT kk = 1 to 9 :
     5311    Assign
     5312        p-rash[kk]          = 0
     5313        p-kassa[kk]         = 0
     5314        p-Inv[kk]           = 0
     5315        p-spis[kk]          = 0
     5316        p-vzvr[kk]          = 0
     5317        p-vzvr-post[kk]     = 0
     5318       .
     5319       end.
     5320   END PROCEDURE.
     5321   Procedure Tmp-assign :
     5322    def var kk as int no-undo.
     5323    REPEAT kk = 1 to 9 :
     5324       Assign
     5325       p-rash[kk]           = p-rash[kk]            + tmp-cli-gds.p-rash[kk]
     5326       p-kassa[kk]          = p-kassa[kk]           + tmp-cli-gds.p-kassa[kk]
     5327       p-Inv[kk]            = p-Inv[kk]             + tmp-cli-gds.p-Inv[kk]
     5328       p-spis[kk]           = p-spis[kk]            + tmp-cli-gds.p-spis[kk]
     5329       p-vzvr[kk]           = p-vzvr[kk]            + tmp-cli-gds.p-vzvr[kk]
     5330       p-vzvr-post[kk]      = p-vzvr-post[kk]       + tmp-cli-gds.p-vzvr-post[kk]
     5331       .
     5332    end.
     5333   END PROCEDURE.
