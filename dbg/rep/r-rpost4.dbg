     4210   procedure Print-Header :
     4211   define input parameter N as integer no-undo .
     4212   define input parameter Name as char no-undo .
     4213   PUT stream  OutStream  UNFORMATTED trim(Name) AT ((N - 1) * 10 ) format "x(100)" skip.
     4214   if Make-Excel then  put   stream ForExcel unformatted fill(" " + CHR(9), N - 1) trim(Name) skip.
     4215   END PROCEDURE.
