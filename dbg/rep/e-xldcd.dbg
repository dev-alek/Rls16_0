     1329                                 then dc-list.first-main-card
     1330                                 else (if t-legacy and not t-subsid
     1331                                       then  dc-list.first-card
     1332                                       else  dc-list.main-card
     1333                                       )
     1334                                 ).
     1335               assign
     1336               dcards.d-card        = dc-list.d-card
     1337               dcards.card-num-chr  = v-card-num-chr
     1338               dcards.first-card    = dc-list.first-card
     1339               dcards.main-card     = dc-list.main-card
     1340               dcards.first-main-card = dc-list.first-main-card
     1341               dcards.cli-type-code = dc-list.cli-type + string(dc-list.cli-code)
     1342               .
     1343             end.
     1344           end.
     1345         END.
     1346       end.
     1347       when "ALL":U then do:
     1348         for each X_dis-card no-lock,
     1349             first obj-host no-lock where
     1350                   obj-host.host-code = X_dis-card.emitent-host-code:
     1351           if not can-find(first dcards no-lock where
     1352                                 dcards.d-card = X_dis-card.d-card) then do:
     1353             CREATE dcards .
     1354             assign
     1355             dcards.date_  = 01/01/1990
     1356             dcards.d-card = X_dis-card.d-card
     1357             dcards.artic = "":U
     1358             dcards.b-code = 0
     1359             dcards.prod-type = "":U
     1360             dcards.prod-code = 0
     1361             dcards.qnty = 0
     1362             dcards.node-code = 0
     1363             dcards.cli-type-code = X_dis-card.cli-type + string(X_dis-card.cli-code)
     1364             dcards.card-num  = X_dis-card.card-num
     1365             .
     1366             if t-legacy then do:
     1367               assign
     1368               v-card-num-chr = (if t-legacy and t-subsid
     1369                                 then X_dis-card.first-main-card
     1370                                 else (if t-legacy and not t-subsid
     1371                                       then  X_dis-card.first-card
     1372                                       else  X_dis-card.main-card
     1373                                       )
     1374                                 ).
     1375               assign
     1376               dcards.d-card          = X_dis-card.d-card
     1377               dcards.card-num-chr    = v-card-num-chr
     1378               dcards.first-card      = X_dis-card.first-card
     1379               dcards.main-card       = X_dis-card.main-card
     1380               dcards.first-main-card = X_dis-card.first-main-card
     1381               dcards.cli-type-code = X_dis-card.cli-type + string(X_dis-card.cli-code)
     1382               .
     1383             end.
     1384           end.
     1385           else do:
     1386           end.
     1387         end.
     1388       end.
     1389       when "ONE":U then do:
     1390         if not can-find (first dcards no-lock where
     1391                                 dcards.d-card = FIXdcard) then do:
     1392             CREATE dcards .
     1393             assign
     1394             dcards.date_  = 01/01/1990
     1395             dcards.d-card = X_dis-card.d-card
     1396             dcards.artic = "":U
     1397             dcards.b-code = 0
     1398             dcards.prod-type = "":U
     1399             dcards.prod-code = 0
     1400             dcards.qnty = 0
     1401             dcards.node-code = 0
     1402             dcards.cli-type-code = X_dis-card.cli-type + string(X_dis-card.cli-code)
     1403             dcards.card-num  = X_dis-card.card-num
     1404             .
     1405           if t-legacy then do:
     1406             assign
     1407             v-card-num-chr = (if t-legacy and t-subsid
     1408                               then X_dis-card.first-main-card
     1409                               else (if t-legacy and not t-subsid
     1410                                     then  X_dis-card.first-card
     1411                                     else  X_dis-card.main-card
     1412                                     )).
     1413             assign
     1414             dcards.d-card          = X_dis-card.d-card
     1415             dcards.card-num-chr    = v-card-num-chr
     1416             dcards.main-card       = X_dis-card.main-card
     1417             dcards.first-main-card = X_dis-card.first-main-card
     1418             dcards.first-card      = X_dis-card.first-card
     1419             dcards.cli-type-code   = X_dis-card.cli-type + string(X_dis-card.cli-code)
     1420             .
     1421           end.
     1422         end.
     1423       end.
     1424     END CASE.
     1425   end.
     1426   if t-imp then
     1427   FOR EACH obj-host
     1428     WHERE obj-host.host-code > 0
     1429   :
     1430     _chk-payment:
     1431     FOR EACH buf_payment no-lock
     1432       where buf_payment.host-code = obj-host.host-code
     1433         AND buf_payment.fact-date >= StartPoint
     1434         AND buf_payment.fact-date <= EndPoint
     1435         AND buf_payment.d-card > ""
     1436         and buf_payment.status_ = 'факт':U
     1437         AND buf_payment.source-type = 'касс':U + chr(44) + 'import':U
     1438     :
     1439       do:
     1440         if dcardmode = "list" then do:
     1441           find first dc-list WHERE
     1442                       dc-list.d-card = buf_payment.d-card no-error.
     1443           if not available dc-list then next _chk-payment.
     1444         end.
     1445       end.
     1446       for each buf_payment-attr no-lock
     1447         where buf_payment-attr.pmnt-code = buf_payment.pmnt-code
     1448           and buf_payment-attr.attr-code = "obj"
     1449       :
     1450         if num-entries( buf_payment-attr.attr-value ) < 2 then
     1451           leave.
