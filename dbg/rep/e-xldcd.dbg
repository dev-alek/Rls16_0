     1484         FIND FIRST dcards WHERE dcards.d-card = buf_payment.d-card NO-ERROR .
     1485         if NOT available dcards then  do:
     1486           CREATE dcards .
     1487           assign
     1488             dcards.date_  = buf_payment.fact-date
     1489             dcards.d-card = buf_payment.d-card
     1490             dcards.artic = "Импорт из ВС"
     1491             dcards.b-code =  0
     1492             dcards.prod-type = ""
     1493             dcards.prod-code = 0
     1494             dcards.qnty = 0
     1495             dcards.node-code = 0
     1496           .
     1497           if t-legacy or t-subsid then do:
     1498             if available buf_dis-card then do:
     1499               assign
     1500                 dcards.cli-type-code   = buf_dis-card.cli-type + string(buf_dis-card.cli-code)
     1501                 dcards.card-num        = buf_dis-card.card-num
     1502                 dcards.d-card          = buf_dis-card.d-card
     1503                 dcards.card-num-chr    = v-card-num-chr
     1504                 dcards.main-card       = buf_dis-card.main-card
     1505                 dcards.first-card      = buf_dis-card.first-card
     1506                 dcards.first-main-card = buf_dis-card.first-main-card
     1507               .
     1508             end.
     1509           end.
     1510           else do:
     1511             if available buf_dis-card then do:
     1512               assign
     1513                 dcards.cli-type-code = buf_dis-card.cli-type + string(buf_dis-card.cli-code)
     1514               .
     1515             end.
     1516             else do:
     1517               assign
     1518                 dcards.cli-type-code = buf_payment.cli-type + string(buf_payment.cli-code)
     1519               .
     1520             end.
     1521           end.
     1522         end.
     1523         assign
     1524           dcards.qnty = 0
     1525           dcards.sale-price = 0
     1526           dcards.sum = dcards.sum + buf_payment.tot-cli
     1527           dcards.counter = (if new-doc then dcards.counter + 1 else dcards.counter )
     1528         .
     1529         new-doc = no.
     1530       end.
     1531       else do:
     1532         FIND FIRST dcards
     1533           WHERE dcards.date_ = buf_payment.fact-date
     1534             AND dcards.d-card = buf_payment.d-card
     1535             AND dcards.b-code = 0
     1536             AND dcards.sale-price = 0
     1537           NO-ERROR .
     1538         if NOT available dcards then do:
     1539           CREATE dcards .
     1540           assign
     1541             dcards.date_  = buf_payment.fact-date
     1542             dcards.d-card = buf_payment.d-card
     1543             dcards.artic = "Импорт из ВС"
     1544             dcards.b-code = 0
     1545             dcards.qnty = 0
     1546           .
     1547           if t-legacy or t-subsid then do:
     1548             assign
     1549               dcards.d-card          = buf_dis-card.d-card
     1550               dcards.card-num-chr    = v-card-num-chr
     1551               dcards.first-card      = buf_dis-card.first-card
     1552               dcards.main-card       = buf_dis-card.main-card
     1553               dcards.first-main-card = buf_dis-card.first-main-card
     1554               dcards.cli-type-code   = buf_dis-card.cli-type + string(buf_dis-card.cli-code)
     1555               dcards.card-num        = buf_dis-card.card-num
     1556             .
     1557           end.
     1558           else do:
     1559             if available buf_dis-card then do:
     1560               assign
     1561                 dcards.cli-type-code = buf_dis-card.cli-type + string(buf_dis-card.cli-code)
     1562               .
     1563             end.
     1564             else do:
     1565               assign
     1566                 dcards.cli-type-code = buf_payment.cli-type + string(buf_payment.cli-code)
     1567               .
     1568             end.
     1569           end.
     1570         end.
     1571         assign
     1572           dcards.qnty = 0
     1573           dcards.sale-price = 0
     1574           dcards.sum = dcards.sum + buf_payment.tot-cli
     1575           dcards.counter = (if new-doc then dcards.counter + 1 else dcards.counter )
     1576         .
     1577         new-doc = no.
     1578       end.
     1579     END.
     1580   END.
     1581   run waitfram-hide in this-procedure .
     1582   procedure my-watch-table:
     1583       define variable v-full-file-name as character no-undo.
     1584       define variable v-message as character no-undo.
     1585       define variable v-table-handle as handle no-undo.
     1586       define variable v-cnt-field as integer no-undo.
     1587       define variable v-list-field-name as character no-undo.
     1588       define variable v-list-field-label as character no-undo.
     1589       define variable v-list-field-type as character no-undo.
     1590       define variable v-ii as integer no-undo.
     1591       define buffer dc-list for dc-list.
     1592       v-table-handle = buffer dc-list:handle.
     1593       v-cnt-field = v-table-handle:num-fields.
     1594       do v-ii = 1 to v-cnt-field:
     1595           v-list-field-name =
     1596               (if v-list-field-name <> "" then
     1597                  v-list-field-name + "$" + v-table-handle:buffer-field(v-ii):name
     1598               else
     1599                   v-table-handle:buffer-field(v-ii):name).
     1600           v-list-field-label =
     1601               (if v-list-field-label <> "" then
     1602                  v-list-field-label + "$" + v-table-handle:buffer-field(v-ii):label
     1603               else
     1604                   v-table-handle:buffer-field(v-ii):label).
     1605           v-list-field-type =
     1606               (if v-list-field-type <> "" then
     1607                  v-list-field-type + "$" + v-table-handle:buffer-field(v-ii):data-type
     1608               else
     1609                   v-table-handle:buffer-field(v-ii):data-type).
     1610       end.
     1611       v-full-file-name = "C:\work15_0\my-watch_dc-list.txt".
     1612       if search(v-full-file-name) = ? then
     1613           do:
     1614               message "Не найден файл отчёта: " v-full-file-name view-as alert-box error.
     1615           end.
     1616       output stream MyWatch-strm to value(v-full-file-name)   convert target "utf-8".
     1617           put stream MyWatch-strm unformatted
     1618               today format "99.99.9999" " " string(time, "HH:MM") " " "Исследуемая таблица: " "dc-list" "." skip
     1619               v-list-field-label skip
     1620               v-list-field-name skip
     1621               v-list-field-type skip
     1622           .
     1623           if not can-find(first dc-list) then
     1624           do:
     1625               v-message = "Исследуемая таблица dc-list пуста!".
     1626               put stream MyWatch-strm unformatted
     1627                   v-message
     1628               .
     1629               message "My-watch-table: " v-message view-as alert-box information.
     1630           end.
     1631               for each  dc-list no-lock:
     1632                   export stream MyWatch-strm delimiter "$"  dc-list.
     1633               end.
     1634       output stream MyWatch-strm close.
     1635   end procedure.
