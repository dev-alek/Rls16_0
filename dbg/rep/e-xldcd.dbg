      997   define temp-table obj-host no-undo
      998   FIELd host-code like ub.sysconf.host-code
      999   index pi is primary unique host-code.
     1000   define buffer buf_shop for ub.shop.
     1001   define buffer buf_store for ub.store.
     1002   define buffer buf_dis-card for ub.dis-card.
     1003   define buffer buf_dcards for dcards.
     1004   define buffer X_dis-card for ub.dis-card.
     1005   define buffer buf_chk-doc for ub.chk-doc.
     1006   define buffer buf_CHK-GDS for ub.chk-gds.
     1007   define buffer buf_bar-code for ub.bar-code.
     1008   define buffer buf_goods for ub.goods.
     1009   define buffer buf_payment for ub.payment.
     1010   define buffer buf_payment-attr for ub.payment-attr.
     1011   define stream MyWatch-strm.
     1012   if p-prodmode2 = "ONE" then do:
     1013     if prodmode = 3 then do:
     1014       assign
     1015       ProdType = Substr(FixProdAttr, 1, 3)
     1016       ProdCode = integer(substr(FixProdAttr, 4))
     1017       .
     1018     end.
     1019     if prodmode = 2 then do:
     1020       assign
     1021       v-grp-code = integer(FixProdAttr)
     1022       .
     1023       run grplib-get-full-name  in this-procedure (
     1024                                                   input v-grp-code
     1025                                                   ,output v-grp-name).
     1026     end.
     1027     if prodmode = 5 then do:
     1028       assign
     1029       v-gds-code = integer(FixProdAttr)
     1030       .
     1031     end.
     1032   end.
     1033   for each obj-host:
     1034     DELETE obj-host.
     1035   end.
     1036   create obj-host.
     1037   assign
     1038   obj-host.host-code = 0
     1039   .
     1040   FOR EACH obj-list :
     1041     if obj-list.obj-type = 'маг':U then do:
     1042       find first buf_shop no-lock where
     1043                 buf_shop.obj-code = obj-list.obj-code.
     1044       find first obj-host no-lock where
     1045                   obj-host.host-code = buf_shop.host-code no-error .
     1046       if not available obj-host then do:
     1047         create
     1048         obj-host.
     1049         assign
     1050         obj-host.host-code = buf_shop.host-code
     1051         .
     1052       end.
     1053     end.
     1054     else do:
     1055       find first buf_store no-lock where
     1056                  buf_store.obj-code = obj-list.obj-code.
     1057       find first obj-host no-lock where
     1058                  obj-host.host-code = buf_store.host-code no-error .
     1059       if not available obj-host then do:
     1060         create
     1061         obj-host.
     1062         assign
     1063         obj-host.host-code = buf_store.host-code
     1064         .
     1065       end.
     1066     end.
     1067     if can-find( FIRST chk-doc WHERE
     1068                         chk-doc.obj-type = obj-list.obj-type AND
     1069                         chk-doc.obj-code = obj-list.obj-code AND
     1070                         chk-doc.chk-date >= StartPoint AND
     1071                         chk-doc.chk-date <= EndPoint AND
     1072                         chk-doc.d-card <> "" AND
     1073                         chk-doc.out-code <> ? ) then DO:
     1074       _chk-doc:
     1075       FOR EACH buf_chk-doc NO-LOCK WHERE
     1076               buf_chk-doc.obj-type = obj-list.obj-type
     1077           AND buf_chk-doc.obj-code = obj-list.obj-code
     1078           AND buf_chk-doc.chk-date >= StartPoint
     1079           AND buf_chk-doc.chk-date <= EndPoint
     1080           AND buf_chk-doc.out-code <> ?
     1081           and buf_chk-doc.d-card > '':U:
     1082         if LOOKUP(string(buf_chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,69,101,106,108,169,196,114,115,116,117,111,112,136,113,101,106,108,208,2,3,4,5,7,43,44':U) > 0 then next _CHk-doc.
     1083           if (dcardmode = "ONE" or dcardmode = "LIST") then
     1084           do:
     1085             if dcardmode = "ONE" then
     1086             do:
     1087               if not  buf_chk-doc.d-card = FixDCard then next _chk-doc.
     1088             end.
     1089             if dcardmode = "list" then
     1090             do:
     1091               find first dc-list WHERE
     1092                          dc-list.d-card = buf_chk-doc.d-card no-error.
     1093               if not available dc-list then next _chk-doc.
     1094             end.
     1095           end.
     1096           PROCESS EVENTS .
     1097           v-count = v-count + 1.
     1098           if ( v-count  modulo 10 ) = 0
     1099           AND  v-count >= 10 then
     1100           do:
     1101             run waitfram-show in this-procedure ( input substitute("&1&2 обработано чеков &3"
     1102                                                                   ,obj-list.obj-type
     1103                                                                   ,obj-list.obj-code
     1104                                                                   ,v-count)
     1105                                                 ).
     1106           end.
     1107           new-doc = yes.
     1108           IF T-time and NOT can-find(FIRST times where
     1109                                               times.time1  <= buf_chk-doc.chk-time AND
     1110                                               times.time2 >= buf_chk-doc.chk-time) then do:
     1111             NEXT _chk-doc.
     1112           end.
     1113           IF TotalOnly
     1114           AND PRODMODE = 1 then do:
     1115             FIND FIRST dcards WHERE dcards.d-card = buf_chk-doc.d-card NO-ERROR .
     1116             if NOT available dcards then  do:
     1117               CREATE dcards .
     1118               assign
     1119               dcards.date_  = buf_chk-doc.chk-date
     1120               dcards.d-card = buf_chk-doc.d-card
     1121               dcards.artic = ""
     1122               dcards.b-code =  0
     1123               dcards.prod-type = ""
     1124               dcards.prod-code = 0
     1125               dcards.qnty = 0
     1126               dcards.node-code = 0
     1127               .
     1128               if t-legacy or t-subsid then do:
     1129                 find first buf_dis-card no-lock where
     1130                             buf_dis-card.d-card = buf_chk-doc.d-card no-error .
     1131                 if available buf_dis-card then do:
     1132                   assign
     1133                   v-card-num-chr = (if t-legacy and t-subsid
     1134                                     then buf_dis-card.first-main-card
     1135                                     else (if t-legacy and not t-subsid
     1136                                           then  buf_dis-card.first-card
     1137                                           else  buf_dis-card.main-card
     1138                                           )
     1139                                     ).
     1140                   assign
     1141                   dcards.cli-type-code   = buf_dis-card.cli-type + string(buf_dis-card.cli-code)
     1142                   dcards.card-num        = buf_dis-card.card-num
     1143                   dcards.d-card          = buf_dis-card.d-card
     1144                   dcards.card-num-chr    = v-card-num-chr
     1145                   dcards.main-card       = buf_dis-card.main-card
     1146                   dcards.first-card      = buf_dis-card.first-card
     1147                   dcards.first-main-card = buf_dis-card.first-main-card
     1148                   .
     1149                 end.
     1150               end.
     1151               else do:
     1152                 if buf_chk-doc.cli-type = ?
     1153                 or buf_chk-doc.cli-code = ?
     1154                 or buf_chk-doc.cli-type = '':U
     1155                 or buf_chk-doc.cli-code = 0 then do:
     1156                   find first buf_dis-card no-lock where
     1157                             buf_dis-card.d-card = buf_chk-doc.d-card no-error .
     1158                   if available buf_dis-card then do:
     1159                     assign
     1160                     dcards.cli-type-code = buf_dis-card.cli-type + string(buf_dis-card.cli-code)
     1161                     .
     1162                   end.
     1163                 end.
     1164                 else do:
     1165                   assign
     1166                   dcards.cli-type-code = buf_chk-doc.cli-type + string(buf_chk-doc.cli-code)
     1167                   .
     1168                 end.
     1169               end.
     1170             end.
     1171             assign
     1172             dcards.qnty = 0
     1173             dcards.sale-price = 0
     1174             dcards.discount = dcards.discount + buf_chk-doc.discnt
     1175             dcards.sum = dcards.sum + buf_chk-doc.tot-doc
     1176             dcards.counter = (if new-doc then dcards.counter + 1 else dcards.counter ) .
     1177             new-doc = no.
     1178           end.
     1179           else do:
     1180             _chk:
     1181             FOR EACH buf_chk-gds WHERE buf_chk-gds.doc-code = buf_chk-doc.doc-code,
     1182                 FIRST buf_bar-code No-LOCK WHERE
     1183                       buf_bar-code.b-code = buf_chk-gds.b-code,
     1184                 FIRST buf_goods No-LOCK WHERE
     1185                         buf_goods.gds-code = buf_bar-code.gds-code:
     1186               if p-prodmode2 = "ONE" then do:
     1187                 case prodmode:
     1188                   when 3 then do:
     1189                     if not ( buf_goods.prod-type = ProdType
     1190                           AND buf_goods.prod-code = ProdCode) then next _chk.
     1191                   end.
     1192                   when 1 then do:
     1193                   end.
     1194                   when 2 then do:
     1195                     if not buf_goods.grp-name begins v-grp-name then next _chk.
     1196                   end.
     1197                   when 5 then do:
     1198                     if not buf_goods.gds-code = v-gds-code then next _chk.
     1199                   end.
     1200                 end case.
     1201               end.
     1202               if buf_chk-gds.write-off-code <> ?
     1203               and buf_chk-gds.write-off-code > 0 then NEXT _CHk.
     1204               if p-prodmode2 = "LIST" then do:
     1205                 if prodmode = 3 then do:
     1206                   IF NOT can-find(first g#cli No-LOCK where
     1207                                         g#cli.obj-type = buf_goods.prod-type AND
     1208                                         g#cli.obj-code = buf_goods.prod-code) then NEXT _chk.
     1209                 end.
     1210                 if prodmode = 2 then do:
     1211                   assign
     1212                   v-grp-name = ""
     1213                   v-found = no
     1214                   .
     1215                   _ii-grp:
     1216                   do ii-grp = 1 to num-entries(buf_goods.grp-name, chr(47)) - 1:
     1217                     assign
     1218                     v-grp-name = v-grp-name + entry(ii-grp, buf_goods.grp-name, chr(47)) + chr(47).
     1219                     IF can-find(first tmp#grp No-LOCK where
     1220                                       tmp#grp.grp-name = v-grp-name) then do:
     1221                       assign
     1222                       v-found = yes
     1223                       .
     1224                       leave _ii-grp.
     1225                     end.
     1226                   end.
     1227                   if not v-found then do:
     1228                     next _chk.
     1229                   end.
     1230                 end.
     1231                 if prodmode = 4 then do:
     1232                   IF NOT can-find(first gds-list No-LOCK where
     1233                                       gds-list.gds-code = buf_goods.gds-code) then NEXT _chk.
     1234                   end.
     1235                 end.
     1236                 FIND FIRST dcards WHERE
     1237                           dcards.date_ = buf_chk-doc.chk-date
     1238                       AND dcards.d-card = buf_chk-doc.d-card
     1239                       AND dcards.b-code = buf_bar-code.b-code
     1240                       AND dcards.sale-price = buf_chk-gds.price-base  NO-ERROR .
     1241                 if NOT available dcards then do:
     1242                   CREATE dcards .
     1243                   assign
     1244                   dcards.date_  = buf_chk-doc.chk-date
     1245                   dcards.d-card = buf_chk-doc.d-card
     1246                   dcards.artic = buf_goods.artic
     1247                   dcards.b-code = buf_bar-code.b-code
     1248                   dcards.prod-type = buf_goods.prod-type
     1249                   dcards.prod-code = buf_goods.prod-code
     1250                   dcards.qnty = 0
     1251                   dcards.node-code = buf_bar-code.node-code
     1252                   .
     1253                   if t-legacy or t-subsid then do:
     1254                     find first buf_dis-card no-lock where
     1255                                 buf_dis-card.d-card = buf_chk-doc.d-card no-error .
     1256                     assign
     1257                     v-card-num-chr = (if t-legacy and t-subsid
     1258                                       then buf_dis-card.first-main-card
     1259                                       else (if t-legacy and not t-subsid
     1260                                             then  buf_dis-card.first-card
     1261                                             else  buf_dis-card.main-card
     1262                                             )
     1263                                       ).
     1264                     assign
     1265                     dcards.d-card          = buf_dis-card.d-card
     1266                     dcards.card-num-chr    = v-card-num-chr
     1267                     dcards.first-card      = buf_dis-card.first-card
     1268                     dcards.main-card       = buf_dis-card.main-card
     1269                     dcards.first-main-card = buf_dis-card.first-main-card
     1270                     dcards.cli-type-code   = buf_dis-card.cli-type + string(buf_dis-card.cli-code)
     1271                     dcards.card-num        = buf_dis-card.card-num
     1272                     .
     1273                   end.
     1274                   else do:
     1275                     if buf_chk-doc.cli-type = ?
     1276                     or buf_chk-doc.cli-code = ?
     1277                     or buf_chk-doc.cli-type = '':U
     1278                     or buf_chk-doc.cli-code = 0 then do:
     1279                       find first buf_dis-card no-lock where
     1280                                 buf_dis-card.d-card = buf_chk-doc.d-card no-error .
     1281                       if available buf_dis-card then do:
     1282                         assign
     1283                         dcards.cli-type-code = buf_dis-card.cli-type + string(buf_dis-card.cli-code)
     1284                         .
     1285                       end.
     1286                     end.
     1287                     else do:
     1288                       assign
     1289                       dcards.cli-type-code = buf_chk-doc.cli-type + string(buf_chk-doc.cli-code)
     1290                       .
     1291                     end.
     1292                   end.
     1293                 end.
     1294                 assign
     1295                 dcards.qnty = dcards.qnty + buf_chk-gds.doc-qnty
     1296                 dcards.sale-price = buf_chk-gds.price-base
     1297                 dcards.discount = dcards.discount + ( buf_chk-gds.doc-qnty *
     1298                         ( buf_chk-gds.discnt + ( dcards.sale-price - buf_chk-gds.price-base ) ) )
     1299                 dcards.sum = dcards.sum + ( buf_chk-gds.doc-qnty * dcards.sale-price )
     1300                 dcards.counter = (if new-doc then dcards.counter + 1 else dcards.counter ) .
     1301                 new-doc = no.
     1302             end.
     1303           END.
     1304         END.
     1305      END.
     1306   END.
     1307   if T-zeros then do:
     1308     CASE dcardmode :
     1309       when "LIST":U then do:
     1310         FOR EACH dc-list no-LOCK:
     1311           if not can-find(first dcards no-lock where
     1312                                 dcards.d-card = dc-list.d-card) then do:
     1313             CREATE dcards .
     1314             assign
     1315             dcards.date_  = 01/01/1990
     1316             dcards.d-card = dc-list.d-card
     1317             dcards.artic = "":U
     1318             dcards.b-code = 0
     1319             dcards.prod-type = "":U
     1320             dcards.prod-code = 0
     1321             dcards.qnty = 0
     1322             dcards.node-code = 0
     1323             dcards.cli-type-code = dc-list.cli-type + string(dc-list.cli-code)
     1324             dcards.card-num  = dc-list.card-num
     1325             .
