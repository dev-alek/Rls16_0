      151   procedure create_obj-list :
      152      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      153      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      154      do
      155      on error undo, return error return-value
      156      :
      157         define buffer cli-obj for ub.clients .
      158         define variable p-var as integer no-undo .
      159         define buffer buf_obj-list for obj-list .
      160         find last buf_obj-list  use-index pi no-error .
      161         if available buf_obj-list
      162         then
      163            p-var = buf_obj-list.obj-id + 1.
      164         else
      165            p-var = 1.
      166         find first cli-obj where
      167                   cli-obj.obj-type = p-obj-type
      168               and cli-obj.obj-code = p-obj-code
      169         no-lock no-error.
      170         if available cli-obj
      171         then do:
      172            create buf_obj-list.
      173            assign
      174               buf_obj-list.obj-id   = p-var
      175               buf_obj-list.obj-code = cli-obj.obj-code
      176               buf_obj-list.obj-type = cli-obj.obj-type
      177               buf_obj-list.obj-name = cli-obj.obj-name
      178               buf_obj-list.db-num   = cli-obj.db-num
      179            .
      180         end.
      181      end.
      182   end.
