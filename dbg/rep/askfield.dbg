      971        "Колонки отчета ~"Оборотная ведомость по всем типам документов~"":C79 VIEW-AS TEXT
      972             SIZE 78.25 BY 1 AT ROW 2.17 COL 2.25
      973             BGCOLOR 3 FGCOLOR 15
      974       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      975            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      976            DEFAULT-BUTTON B-save CANCEL-BUTTON B-Cancel.
      977   DEFINE FRAME Dialog-Frame
      978        "Показать":C8 VIEW-AS TEXT
      979             SIZE 8.88 BY .67 AT ROW 3.58 COL 31.5
      980             FGCOLOR 4
      981        "Колонки":C28 VIEW-AS TEXT
      982             SIZE 27.38 BY .67 AT ROW 3.58 COL 41.75
      983             FGCOLOR 4
      984        "Колонки":C28 VIEW-AS TEXT
      985             SIZE 27.38 BY .67 AT ROW 3.58 COL 3
      986             FGCOLOR 4
      987        "Показать":C8 VIEW-AS TEXT
      988             SIZE 8.88 BY .67 AT ROW 3.58 COL 70.75
      989             FGCOLOR 4
      990        RECT-10 AT ROW 3.29 COL 30.88
      991        RECT-11 AT ROW 4.42 COL 1.63
      992        RECT-12 AT ROW 3.33 COL 70.13
      993        RECT-13 AT ROW 20.21 COL 53.5
      994        RECT-14 AT ROW 20.5 COL 53.13
      995        RECT-15 AT ROW 20.17 COL 52
      996        RECT-17 AT ROW 19.71 COL 42.25
      997        RECT-9 AT ROW 3.29 COL 1.63
      998        SPACE(0.24) SKIP(0.00)
      999       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1000            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1001            TITLE "Выбор колонок для печати"
     1002            DEFAULT-BUTTON B-save CANCEL-BUTTON B-Cancel.
     1003   ASSIGN
     1004          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1005          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1006   ASSIGN
     1007          B-unmark:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1008   ASSIGN
     1009          FILL-IN-30:PRIVATE-DATA IN FRAME Dialog-Frame     =
     1010                   "коррекция учетных цен".
     1011   ASSIGN
     1012          FILL-IN-31:PRIVATE-DATA IN FRAME Dialog-Frame     =
     1013                   "смена типа приобретения".
     1014   ASSIGN
     1015          FILL-IN-32:PRIVATE-DATA IN FRAME Dialog-Frame     =
     1016                   "Расход-Возврат".
     1017   ASSIGN
     1018          only-text-exel:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1019   ASSIGN
     1020          TOG-26:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1021   ON WINDOW-CLOSE OF FRAME Dialog-Frame
