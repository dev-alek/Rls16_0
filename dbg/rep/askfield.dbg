     1047      TOG-8:screen-value  in frame Dialog-Frame = string( true )
     1048      TOG-9:screen-value  in frame Dialog-Frame = string( true )
     1049      TOG-10:screen-value in frame Dialog-Frame = string( true )
     1050      TOG-11:screen-value in frame Dialog-Frame = string( true )
