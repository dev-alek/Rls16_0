     1071   ON CHOOSE OF B-save IN FRAME Dialog-Frame
     1072   DO:
     1073   define variable  l-ind as integer no-undo .
     1074   define buffer buf_usr-flt for ubflt.usr-flt  .
     1075   run eq-frame.
     1076    find first buf_usr-flt exclusive-lock where
     1077            buf_usr-flt.user-name    = g#userid and
     1078            buf_usr-flt.call-point   = p-filter
     1079            no-error .
     1080     if not available  buf_usr-flt then  create buf_usr-flt.
     1081     Assign
     1082       buf_usr-flt.user-name    = g#userid
     1083       buf_usr-flt.call-point   = p-filter
     1084       buf_usr-flt.list_        = ""
     1085       .
     1086     repeat l-ind = 1 to 28 :
     1087         if   use-column[ l-ind ] =  true then
     1088         buf_usr-flt.list_ = buf_usr-flt.list_  + string( l-ind ) + "," .
     1089     End.
     1090     buf_usr-flt.list_ = buf_usr-flt.list_  + string( "print-o=" + print-o ) + "," .
     1091   release buf_usr-flt no-error .
     1092   if error-status :error then message
     1093     vss-workfile vss-revision vss-description skip
     1094     error-status :get-message(1) skip
     1095     return-value skip
     1096     "Ошибка  release"
     1097     view-as alert-box error
     1098   .
     1099   END.
