     1061      TOG-22:screen-value in frame Dialog-Frame = string( true )
     1062      TOG-23:screen-value in frame Dialog-Frame = string( true )
     1063      TOG-24:screen-value in frame Dialog-Frame = string( true )
     1064      TOG-25:screen-value in frame Dialog-Frame = string( true )
     1065      TOG-26:screen-value in frame Dialog-Frame = string( false  )
     1066      TOG-27:screen-value in frame Dialog-Frame = string( true )
     1067      TOG-28:screen-value in frame Dialog-Frame = string( true )
