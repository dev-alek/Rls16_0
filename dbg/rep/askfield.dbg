     1151   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1152   on help of frame Dialog-Frame
     1153   do:
     1154     run gbl/app_help.p
     1155       (input this-procedure :file-name
     1156       ,input ''
     1157       ,input ?
     1158       ) no-error.
     1159     if error-status :error then do:
     1160       message
     1161         "Ошибка при вызове помощи"
     1162         error-status :get-message(1)
     1163         view-as alert-box .
     1164     end.
     1165   end.
     1166   run minbtn-set in this-procedure .
     1167   on choose of b-help in frame Dialog-Frame
     1168   do:
     1169     apply "help":u to frame Dialog-Frame .
     1170   end.
     1171   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1172   procedure minbtn-set :
     1173       do
     1174           on error undo, return error return-value
     1175           :
     1176           define variable ii              as integer       no-undo .
     1177           define variable fh              as widget-handle no-undo .
     1178           define variable hh              as widget-handle no-undo .
     1179           define variable v-h             as handle        extent 4 no-undo .
     1180           define variable v-name-button   as character     no-undo .
     1181           define variable v-help-old-x    as decimal       no-undo .
     1182           define variable v-help-old-y    as decimal       no-undo .
     1183           define variable v-help-old-size as decimal       no-undo .
     1184           define variable v-frame-width   as decimal       no-undo .
     1185           define variable jj              as integer       no-undo .
     1186           do
     1187               on error undo, return error
     1188               :
     1189               assign
     1190                   v-frame-width = frame Dialog-Frame:width - 0.3
     1191                   fh            = frame Dialog-Frame:first-child
     1192                   hh            = fh:first-child
     1193                   ii            = 1
     1194                   .
     1195               do while valid-handle(hh):
     1196                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1197                   do:
     1198                       case lc(hh:name) :
     1199                           when "b-help" then
     1200                               do:
     1201                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1202                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1203                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1204                                   hh:TOOLTIP = "Помощь" .
     1205                                   v-help-old-x = hh:column .
     1206                                   v-help-old-y = hh:row    .
     1207                                   v-help-old-size = hh:width .
     1208                                   hh:width-chars = 2.5 .
     1209                               end.
     1210                           when "b-print" then
     1211                               do:
     1212                                   hh:load-image("cmp/b-print.bmp":u) .
     1213                                   hh:TOOLTIP = "Печать" .
     1214                                   v-h[ii] = hh:handle .
     1215                                   ii = ii + 1 .
     1216                                   hh:width-chars = 3 .
     1217                               end.
     1218                           when "b-history" or
     1219                           when "b-hist" then
     1220                               do:
     1221                                   hh:load-image("cmp/b-hist.bmp":u) .
     1222                                   hh:TOOLTIP = "История" .
     1223                                   v-h[ii] = hh:handle .
     1224                                   ii = ii + 1 .
     1225                                   hh:width-chars = 3 .
     1226                               end.
     1227                           when "b-sch" then
     1228                               do:
     1229                                   hh:load-image("cmp/b-sch.bmp":u) .
     1230                                   hh:TOOLTIP = "Установка Фильтра" .
     1231                                   v-h[ii] = hh:handle .
     1232                                   ii = ii + 1 .
     1233                                   hh:width-chars = 3 .
     1234                               end.
     1235                           when "b-hist-user" then
     1236                               do:
     1237                                   hh:load-image("cmp/b-hist.bmp":u) .
     1238                                   hh:TOOLTIP = "История пользователя" .
     1239                                   ii = ii + 1 .
     1240                               end.
     1241                       end case.
     1242                   end.
     1243                   hh = hh:next-sibling.
     1244               end.
     1245               b-help:column = v-frame-width - b-help:width-chars.
     1246               jj = 0.
     1247               repeat ii = 4 to 1 by -1 :
     1248                   if valid-handle (v-h[ii] ) then
     1249                   do:
     1250                       jj  = jj + 1 .
     1251                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1252                       v-h[ii]:row    = v-help-old-y .
     1253                   end.
     1254               end.
     1255           end.
     1256       end.
     1257   end procedure.
     1258   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1259   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1260   define variable   all-empty  as integer no-undo init 0 .
     1261   define variable   ii  as integer no-undo init 0 .
     1262   repeat ii = 1 to 28 :
     1263     if use-column[ii ] then all-empty  = all-empty + 1 .
     1264   End.
     1265    if all-empty =0 then
     1266       apply "CHOOSE" TO B-mark IN FRAME Dialog-Frame.
     1267    Else
     1268   Assign
     1269     TOG-1   = use-column[1 ]
     1270     TOG-2   = use-column[2 ]
     1271     TOG-3   = use-column[3 ]
     1272     TOG-4   = use-column[4 ]
     1273     TOG-5   = use-column[5 ]
     1274     TOG-6   = use-column[6 ]
     1275     TOG-7   = use-column[7 ]
     1276     TOG-8   = use-column[8 ]
     1277     TOG-9   = use-column[9 ]
     1278     TOG-10  = use-column[10]
     1279     TOG-11  = use-column[11]
     1280     TOG-12  = use-column[12]
     1281     TOG-13  = use-column[13]
     1282     TOG-14  = use-column[14]
     1283     TOG-15  = use-column[15]
     1284     TOG-16  = use-column[16]
     1285     TOG-17  = use-column[17]
     1286     TOG-18  = use-column[18]
     1287     TOG-19  = use-column[19]
     1288     TOG-20  = use-column[20]
     1289     TOG-21  = use-column[21]
     1290     TOG-22  = use-column[22]
     1291     TOG-23  = use-column[23]
     1292     TOG-24  = use-column[24]
     1293     TOG-25  = use-column[25]
     1294     TOG-26  = use-column[26]
     1295     TOG-27  = use-column[27]
     1296     TOG-28  = use-column[28]
     1297    .
     1298     Assign
     1299     s-column[1 ] =  9
     1300     s-column[2 ] =  16
     1301     s-column[3 ] =  ( IF p-filter = "r-ptrlot":U THEN 36 ELSE 38 )
     1302     s-column[4 ] =  3
     1303     s-column[5 ] =  9
     1304     s-column[6 ] =  14
     1305     s-column[7 ] =  14
     1306     s-column[8 ] =  14
     1307     s-column[9 ] =  14
     1308     s-column[10] =  14
     1309     s-column[11] =  14
     1310     s-column[12] =  14
     1311     s-column[13] =  14
     1312     s-column[14] =  14
     1313     s-column[15] =  14
     1314     s-column[16] =  14
     1315     s-column[17] =  14
     1316     s-column[18] =  14
     1317     s-column[19] =  14
     1318     s-column[20] =  14
     1319     s-column[21] =  14
     1320     s-column[22] =  14
     1321     s-column[23] =  14
     1322     s-column[24] =  14
     1323     s-column[25] =  14
     1324     s-column[26] =  14
     1325     s-column[27] =  14
     1326     s-column[28] =  9
     1327     .
     1328   MAIN-BLOCK:
     1329   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1330      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1331      FILL-IN-30 =  FILL-IN-30:PRIVATE-DATA IN FRAME Dialog-Frame.
     1332      FILL-IN-32 =  FILL-IN-32:PRIVATE-DATA IN FRAME Dialog-Frame.
     1333     RUN enable_UI.
     1334     RUN Show-format.
     1335     WAIT-FOR GO OF FRAME Dialog-Frame.
     1336   END.
     1337   RUN disable_UI.
