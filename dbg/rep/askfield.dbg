      575   define variable var-report-r-b as character no-undo .
      576   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      577   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      578     (output var-report-r-b
      579     )  .
      580   procedure proc-alt-shift-f2:
      581     if not ibs.th.gbl.gbl-var:rcode
      582   then
      583     run gbl\inidebug.p .
      584   end.
      585   procedure proc-alt-shift-f3:
      586     run gbl/prvssinf.p
      587       ( input this-procedure
      588       ) .
      589   end.
      590   define variable v-inform-launched as logical no-undo initial false .
      591   procedure proc-alt-shift-f4:
      592     define variable v-action as character no-undo .
      593     if v-inform-launched = false then do:
      594       assign
      595         v-inform-launched = true
      596       .
      597       run gbl/d-inform.w
      598         (  input self
      599         ,  input this-procedure
      600         , output v-action
      601         ) no-error .
      602       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      603       assign
      604         v-inform-launched = false
      605       .
      606     end.
      607   end.
      608   procedure proc-alt-f1:
      609     run gbl/corrhelp.p
      610       (input this-procedure
      611       ) .
      612   end .
      613   on alt-shift-f2 anywhere do:
      614     run proc-alt-shift-f2.
      615   end.
      616   on alt-shift-f3 anywhere do:
      617     run proc-alt-shift-f3 in this-procedure .
      618   end.
      619   on alt-shift-f4 anywhere do:
      620     run proc-alt-shift-f4 in this-procedure.
      621   end.
      622   on alt-f1 anywhere do:
      623     run proc-alt-f1 in this-procedure .
      624   end.
