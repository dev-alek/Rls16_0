     1213   .
     1214   define temp-table abc-grp-lvl no-undo
     1215     FIELD abc-id                  AS INTEGER   LABEL "Внутренний код шапки ABC анализа"
     1216     FIELD db-num                  AS INTEGER   FORMAT ">9" INITIAL ? LABEL "Номер БД" COLUMN-LABEL "БД"
     1217     FIELD fullname                as character
     1218     FIELD abcg-abc                AS CHARACTER FORMAT "X(8)" LABEL "Группа ABC в результате анализа"
     1219     FIELD rating                  AS DECIMAL   DECIMALS 0 FORMAT ">>>>>>>>>9" LABEL "рейтинг" COLUMN-LABEL "рейтинг"
     1220     FIELD proc-from-all           AS DECIMAL   DECIMALS 4 FORMAT "->>,>>9.9999" LABEL "Процент от общего оборота" COLUMN-LABEL "Доля"
     1221     FIELD abcg-abc-old            AS CHARACTER FORMAT "X(1)" LABEL "Группа ABC в результате анализа рассчитанная"
     1222     FIELD abcg-prcnt-account      AS DECIMAL   DECIMALS 10 FORMAT ">9.99" LABEL "Процент для оценки по критерию"
     1223     FIELD abcg-prcnt-for-estimate AS DECIMAL   DECIMALS 10 FORMAT ">9.99" LABEL "Процент для оценки по критерию"
     1224     FIELD abcg-sum-for-estimate   as decimal
     1225   INDEX pi
     1226     abc-id
     1227     db-num
     1228     fullname
     1229   index  pi2
     1230     abc-id
     1231     db-num
     1232     abcg-abc
     1233     rating
     1234   .
     1235   define temp-table temp-tt no-undo
     1236   field id        as recid
     1237   field summa     as decimal
     1238   field proc      as decimal
     1239   field proc-2    as decimal
     1240   field proc-acc1 as decimal
     1241   field proc-acc2 as decimal
     1242   field ABC-1     as character
     1243   field ABC       as character
