     1155   define buffer buf_abc-analysis-grp        for ub.abc-analysis-grp.
     1156   define buffer buf_criterion-analysis      for ub.criterion-analysis .
     1157   DEFINE TEMP-TABLE x-analysis           no-undo  LIKE ub.abc-analysis.
     1158   define buffer buf_gds-grp                 for ub.gds-grp  .
     1159   DEFINE temp-table temp-str no-undo
     1160     field   lvl-code    as integer
