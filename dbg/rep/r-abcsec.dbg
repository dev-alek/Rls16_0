      818   define variable var-report-r-b as character no-undo .
      819   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      820   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      821     (output var-report-r-b
      822     )  .
      823   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      824   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      825   procedure paramls-clear :
      826     define buffer buf_temp-param for temp-param .
      827     do
      828     on error undo, return error return-value
      829     :
      830       for each buf_temp-param
      831       on error undo, return error
      832       :
      833         delete buf_temp-param .
      834       end.
      835     end.
      836   end procedure.
      837   procedure paramls-write :
      838     define input  parameter p-code     as character no-undo .
      839     define input  parameter p-sub-code as character no-undo .
      840     define input  parameter p-value    as character no-undo .
      841     define buffer buf_temp-param for temp-param .
      842     do
      843     on error undo, return error return-value
      844     :
      845       find first buf_temp-param
      846         where buf_temp-param.param-code     = p-code
      847           and buf_temp-param.param-sub-code = p-sub-code
      848         no-error .
      849       if not available buf_temp-param then do:
      850         create buf_temp-param .
      851         assign
      852           buf_temp-param.param-code     = p-code
      853           buf_temp-param.param-sub-code = p-sub-code
      854         .
      855       end.
      856       assign
      857         buf_temp-param.param-value = p-value
      858       .
      859     end.
      860   end procedure.
      861   procedure paramls-read :
      862     define input  parameter p-code          as character no-undo .
      863     define input  parameter p-sub-code      as character no-undo .
      864     define input  parameter p-default-value as character no-undo .
      865     define output parameter p-value         as character no-undo .
      866     define buffer buf_temp-param for temp-param .
      867     do
      868     on error undo, return error return-value
      869     :
      870       find first buf_temp-param
      871         where buf_temp-param.param-code     = p-code
      872           and buf_temp-param.param-sub-code = p-sub-code
      873         no-error .
      874       if available buf_temp-param then do:
      875         assign
      876           p-value = buf_temp-param.param-value
      877         .
      878       end.
      879       else do:
      880         assign
      881           p-value = p-default-value
      882         .
      883       end.
      884     end.
      885   end procedure.
      886   procedure paramls-append :
      887     define input  parameter p-code     as character no-undo .
      888     define input  parameter p-sub-code as character no-undo .
      889     define input  parameter p-value    as character no-undo .
      890     define buffer buf_temp-param for temp-param .
      891     do
      892     on error undo, return error return-value
      893     :
      894       find first buf_temp-param
      895            where buf_temp-param.param-code     = p-code
      896              and buf_temp-param.param-sub-code = p-sub-code
      897         no-error .
      898       if not available buf_temp-param then do:
      899         create buf_temp-param .
      900         assign
      901           buf_temp-param.param-code     = p-code
      902           buf_temp-param.param-sub-code = p-sub-code
      903           buf_temp-param.param-value    = p-value
      904         .
      905       end.
      906       else do:
      907           assign
      908               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      909           .
      910       end.
      911     end.
      912   end procedure.
      913   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      914     if num-entries(string(p-dec), '.') = 2
      915       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      916       else return( string(p-dec)) .
      917   end function.
      918   function format-point-to-comma returns char (input orig as char ) .
      919   define variable rtext as character no-undo .
      920   define variable strt as integer no-undo .
      921   define variable leng as integer no-undo .
      922   assign rtext = orig .
      923   repeat:
      924     strt =  index(rtext,'.').
      925     if strt = 0 then leave.
      926     leng = 1.
      927     substring(rtext,strt,leng,"character") = v-delim .
      928   end.
      929   return rtext.
      930   end function.
      931   function format-excel-text returns char ( input start-text as char ) :
      932   def var  i    as int no-undo.
      933   def var  ch   as char no-undo.
      934   def var  n    as int no-undo.
      935   def var  ipos as int no-undo.
      936     n = num-entries(trim(start-text), chr(10)) - 1 .
      937     do i = 1 to n :
      938       ipos = index( start-text, chr(10)).
      939       if ipos > 0 then
      940         substr( start-text, ipos, 1 ) = ' '.
      941     end.
      942     n = num-entries(trim(start-text), chr(13)) - 1 .
      943     do i = 1 to n :
      944       ipos = index( start-text, chr(13)).
      945       if ipos > 0 then
      946         substr( start-text, ipos, 1 ) = ' '.
      947     end.
      948     if index( start-text, '"' ) = 0 then
      949       start-text =  '="'   + trim( start-text) + '"'   .
      950       else do:
      951         n = num-entries(trim(start-text), '"') - 1.
      952         do i = 1 to n :
      953           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      954         end.
      955         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      956         start-text = '="'  + ch  + '"' .
      957       end.
      958     return start-text.
      959   end.
      960   function excel-sum returns char (input p-dec as decimal ).
      961     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      962   end function.
      963   function excel-qnty returns char (input p-dec as decimal ).
      964     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      965   end function.
      966   function format-excel-text-macr returns char ( input start-text as char ) :
      967   def var  i    as int no-undo.
      968   def var  ch   as char no-undo.
      969   def var  n    as int no-undo.
      970   def var  ipos as int no-undo.
      971     n = num-entries(trim(start-text), chr(10)) - 1 .
      972     do i = 1 to n :
      973       ipos = index( start-text, chr(10)).
      974       if ipos > 0 then
      975         substring( start-text, ipos , 1 ) = ' '.
      976     end.
      977     n = num-entries(trim(start-text), chr(13)) - 1 .
      978     do i = 1 to n :
      979       ipos = index( start-text, chr(13)).
      980       if ipos > 0 then
      981         substring( start-text, ipos, 1 ) = ' '.
      982     end.
      983     if index( start-text, '"' ) = 0 then
      984       start-text =  '"'   + trim( start-text) + '"'   .
      985       else do:
      986         n = num-entries(trim(start-text), '"') - 1.
      987         do i = 1 to n :
      988           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      989         end.
      990         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      991         start-text = '"'  + ch  + '"' .
      992       end.
      993     n = num-entries(trim(start-text), chr(10)) - 1 .
      994     do i = 1 to n :
      995       ipos = index( start-text, chr(10)).
      996       if ipos > 0 then
      997         substring( start-text, ipos , 1 ) = ' '.
      998     end.
      999       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     1000     return start-text.
     1001   end.
     1002   FUNCTION n-lavel RETURNS char (INPUT grp-name as char, INPUT lavel# as int ).
     1003   define variable  str  as char format "X(60)"  no-undo.
     1004   define variable  str2 as char no-undo.
     1005   define variable v-r as character no-undo init "" .
     1006   define variable  i#i as int no-undo.
     1007   STR = "".
     1008   repeat i#i =1 to lavel#:
     1009       if i#i =1 then str   = entry(1,grp-name, chr(47)) .
     1010       else do:
     1011           str2 = entry(i#i,grp-name, chr(47)) no-error.
     1012           if not error-status:error  and str2 <> "":u then
     1013                  str = str +  chr(47) +  entry(i#i,grp-name, chr(47)) no-error .
     1014           end.
     1015   end.
     1016   if str <> ? then do:
     1017   v-r = str + chr(47) .
     1018   end.
     1019   RETURN v-r .
     1020   END FUNCTION.
     1021   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1022   function func-get-name-from-ext-type   returns char
     1023     ( p-ext-type as character   ,
     1024       p-caps     as logical ).
     1025   define variable v-ext-name as character no-undo .
     1026   run get-name-from-ext-type in this-procedure (
     1027       input p-ext-type  ,
     1028       input p-caps  ,
     1029       output v-ext-name )
     1030       no-error .
     1031       if error-status :error then do:
     1032          assign
     1033            v-ext-name = p-ext-type
     1034          .
     1035       end.
     1036    return (v-ext-name) .
     1037   end.
     1038   procedure get-name-from-ext-type :
     1039    do
     1040    on error undo, return error return-value
     1041    :
     1042   define input  parameter p-ext-type as character no-undo .
     1043   define input  parameter p-caps     as logical no-undo   .
     1044   define output parameter p-ext-name as character no-undo .
     1045   define variable v-num as integer no-undo .
     1046     if lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) = 0 then do :
     1047       message
     1048         vss-include-info10 skip
     1049         "Неправильно задано значение входящего параметра! "
     1050         "Нет такого типа документов " p-ext-type
     1051         view-as alert-box error .
     1052         undo, return error .
     1053     end.
     1054     v-num      = lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) .
     1055     p-ext-name = entry  ( v-num , 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ) .
     1056     if p-caps  = true then do :
     1057        p-ext-name = caps(substring(p-ext-name,1,1) ) + substring(p-ext-name, 2 , length (p-ext-name) - 1 ) .
     1058     end .
     1059     end.
     1060   end procedure.
     1061   define variable vss-include-info11 as character format "X(65)" no-undo
     1062   initial "@(#)$Workfile$ $Revision$".
     1063   procedure grplib-get-full-name :
     1064      define input parameter p-node-code  as integer      no-undo.
     1065      define output parameter p-full-name as character    no-undo.
     1066      do
     1067   on error undo, return error
     1068   :
     1069       define variable v-upper-code    as integer           no-undo.
     1070       define buffer buf_gds-grp       for ub.gds-grp.
     1071       define buffer buf_upper_gds-grp for ub.gds-grp.
     1072       find first buf_gds-grp no-lock
     1073            where buf_gds-grp.node-code = p-node-code
     1074       no-error.
     1075       if not available buf_gds-grp
     1076       then do:
     1077           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1078       end.
     1079       assign
     1080           p-full-name  = ""
     1081           v-upper-code = 1
     1082       .
     1083       do while buf_gds-grp.upper-code <> 0
     1084       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1085       :
     1086           assign
     1087               p-full-name  = buf_gds-grp.node-name
     1088                            + (if p-full-name <> "" then chr(47) else "")
     1089                            + p-full-name
     1090               v-upper-code = buf_gds-grp.upper-code
     1091           .
     1092           find first buf_gds-grp no-lock
     1093                where buf_gds-grp.node-code = v-upper-code
     1094           no-error.
     1095           if not available buf_gds-grp
     1096           then do:
     1097               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     1098                                   + string( v-upper-code )
     1099                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1100           end.
     1101       end.
     1102       assign
     1103       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1104       .
     1105   end.
     1106   end .
     1107   procedure grplib-get-node-from-full-name :
     1108   define input parameter p-full-name as character no-undo .
     1109   define output parameter p-node-code as integer no-undo .
     1110   define variable v-ii as integer no-undo .
     1111   define variable v-upper-code as integer no-undo .
     1112   define variable v-root-code as integer no-undo .
     1113   define variable v-entry as character no-undo .
     1114   define buffer buf_gds-grp       for ub.gds-grp.
     1115   do
     1116   on error undo, return error
     1117   :
     1118     find first buf_gds-grp no-lock
     1119         where buf_gds-grp.upper-code = 0
     1120     no-error .
     1121     if not available buf_gds-grp
     1122     then do:
     1123         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     1124     end.
     1125     else do:
     1126       assign
     1127       v-root-code = buf_gds-grp.node-code
     1128       .
     1129     end.
     1130     v-upper-code = v-root-code.
     1131     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1132       assign
     1133       v-entry = entry(v-ii, p-full-name, chr(47)).
     1134       if v-entry = '' then leave.
     1135       find first buf_gds-grp no-lock where
     1136                 buf_gds-grp.node-name = v-entry
     1137             and buf_gds-grp.upper-code = v-upper-code
     1138             no-error.
     1139       if not available buf_gds-grp then do:
     1140         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1141       end.
     1142       else do:
     1143         p-node-code = buf_gds-grp.node-code.
     1144         v-upper-code = buf_gds-grp.node-code.
     1145       end.
     1146     end.
     1147   end.
     1148   end .
     1149   Make-Excel      = true.
     1150   Make-Excel-com  = false .
     1151   define buffer buf_abc-analysis            for ub.abc-analysis.
     1152   define buffer buf_abc-analysis-goods      for ub.abc-analysis-goods.
