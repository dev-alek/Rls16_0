     1248   .
     1249   define buffer buf_abc-grp-lvl  for abc-grp-lvl  .
     1250   define buffer buf2_gds-grp for ub.gds-grp  .
     1251   define variable first-lavel as integer   no-undo .
     1252   define variable v-sum-prc as decimal   no-undo .
     1253   define variable var-i as integer   no-undo .
     1254   define variable var-kol as integer   no-undo .
     1255   define variable number-group as character no-undo .
     1256   define variable i-numb as integer   no-undo .
     1257   var-kol = num-entries (p-rez).
     1258   repeat var-i = 1 to var-kol :
     1259      find first buf_abc-analysis no-lock where recid(buf_abc-analysis) = int(entry(var-i,p-rez )) no-error .
     1260      if not available buf_abc-analysis  then next.
     1261      find first  buf_criterion-analysis no-lock where buf_criterion-analysis.cral-id = buf_abc-analysis.cral-id no-error .
     1262      if not available buf_criterion-analysis  then next.
     1263       create temp-abc.
     1264       assign
     1265       temp-abc.nn          = var-i
     1266       temp-abc.id          = buf_abc-analysis.abc-id
     1267       temp-abc.db-num      = buf_abc-analysis.db-num
     1268       temp-abc.type        = if buf_abc-analysis.abc-type = "2"  then "Двухпроходный, ограничение Е <= " + string(buf_abc-analysis.le-proc)  else " "
     1269       temp-abc.name        = buf_abc-analysis.abc-name
     1270       temp-abc.des         = buf_abc-analysis.abc-des
     1271       temp-abc.name-cral   = buf_criterion-analysis.cral-name
     1272       temp-abc.A           = buf_abc-analysis.abc-a
     1273       temp-abc.B           = buf_abc-analysis.abc-b
     1274       temp-abc.C           = buf_abc-analysis.abc-c
     1275       temp-abc.D           = buf_abc-analysis.abc-d
     1276       temp-abc.E           = buf_abc-analysis.abc-E
     1277       temp-abc.F           = buf_abc-analysis.abc-F
     1278       temp-abc.date-cr     = buf_abc-analysis.abc-date-create
     1279       temp-abc.period      = buf_abc-analysis.abc-string-period
     1280       temp-abc.ext-doc-type = ""
     1281       .
     1282        define buffer buf_abc-analysis-doc for ub.abc-analysis-doc.
     1283        for each buf_abc-analysis-doc no-lock where
     1284                 buf_abc-analysis-doc.abc-id = buf_abc-analysis.abc-id and
     1285                 buf_abc-analysis-doc.db-num = buf_abc-analysis.db-num
     1286        :
     1287        temp-abc.ext-doc-type = temp-abc.ext-doc-type + func-get-name-from-ext-type (buf_abc-analysis-doc.abcd-ext-doc-type , true ) + "," .
     1288        end.
     1289        for each buf_abc-analysis-obj no-lock where
     1290                 buf_abc-analysis-obj.abc-id = buf_abc-analysis.abc-id and
     1291                 buf_abc-analysis-obj.db-num = buf_abc-analysis.db-num
     1292        :
     1293        temp-abc.obj = temp-abc.obj +  buf_abc-analysis-obj.obj-type + " " + string(buf_abc-analysis-obj.obj-code) + "," .
     1294        end.
     1295   end.
     1296   define stream  macr_excel .
     1297   define variable g#report-num  as integer   no-undo .
     1298   define variable v-file-name as character no-undo .
     1299   define variable p-file-name as character no-undo .
     1300   define variable v-ind       as integer   no-undo .
     1301   define variable num#col#    as integer no-undo .
     1302   define variable C-c         as integer no-undo .
     1303   define variable C-str       as character no-undo .
     1304   define variable str--1      as character Format "x(60)" no-undo.
     1305   define variable str--2      as integer no-undo .
     1306   define variable C-i         as integer no-undo .
     1307   define variable p-var       as integer no-undo .
     1308   define variable var-1       as integer no-undo .
     1309   define variable var-2       as integer no-undo .
     1310   def buffer buf_clients for ub.clients .
     1311   def buffer This_Object for ub.clients .
     1312   def buffer buf_goods   for ub.goods .
     1313   define variable qnty as decimal   no-undo .
     1314   define variable sum  as decimal   no-undo .
     1315   define variable vv-qnty1 as decimal   no-undo .
     1316   define variable vv-qnty2 as decimal   no-undo .
     1317   define variable num-ln as integer   no-undo .
     1318   def var i as int no-undo.
     1319   def var j as int no-undo.
     1320   define variable Counter1 as integer init 0  no-undo .
     1321   def var LineBuf       as char    no-undo.
     1322   def var Line       as char    no-undo.
     1323   def var UndLine    as char    no-undo.
     1324   def var Lines_Counter as   int  init 0  no-undo.
     1325   def var Tmp_Counter   as   int  init 0  no-undo.
     1326   def var tdoc-date     like ub.fbr-pln.doc-date no-undo.
     1327   def var tdoc-code     like ub.fbr-pln.doc-code no-undo.
     1328   def var  abbr              as  char no-undo.
     1329   def var  pp                as  char no-undo.
     1330     if session:set-wait-state("compiler") then.
     1331     define variable v-prn0 as character no-undo .
     1332     if var-report-r-b = "rubl" then assign pp = "Цены руб.".
     1333                                else assign pp = "Цены  баз.вал." .
     1334   define variable v-account as integer init 0 no-undo .
     1335   define variable v-account-lavel as character no-undo .
     1336   define variable v-button-stop as logical no-undo .
     1337   define variable v-kol-spice as integer no-undo .
     1338   define variable v-kol-spice2 as integer no-undo .
     1339   define variable v-kol-spice3 as integer no-undo .
     1340   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1341   DEFINE BUTTON StopBtn AUTO-END-KEY
     1342        LABEL "Стоп"
     1343        SIZE 10 BY 1.
     1344   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1345        LABEL "Обработано записей"
     1346         VIEW-AS TEXT
     1347        SIZE 14 BY .67 NO-UNDO.
     1348   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1349         VIEW-AS TEXT
     1350        SIZE 53.25 BY .67
     1351        FGCOLOR 1  NO-UNDO.
     1352   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1353         VIEW-AS TEXT
     1354        SIZE 53.25 BY .67
     1355        FGCOLOR 1  NO-UNDO.
     1356   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1357         VIEW-AS TEXT
     1358        SIZE 53.25 BY .67
     1359        FGCOLOR 1  NO-UNDO.
     1360   DEFINE RECTANGLE RECT-1
     1361        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1362        SIZE 55.13 BY 4.46.
     1363   DEFINE FRAME InfoFrame
     1364        StopBtn AT ROW 4.25 COL 21.75
     1365        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1366        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1367        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1368        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1369        RECT-1 AT ROW 1 COL 1
     1370       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1371            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1372            TITLE "Процесс"
     1373            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1374   define variable mFrameView      as logical   no-undo init yes.
     1375     define variable mFramHandle as handle no-undo.
     1376     mFramHandle = frame InfoFrame:handle.
     1377     if  log-manager:logfile-name ne ?
     1378     then DO:
     1379         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1380         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1381         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1382     end.
     1383     mFrameView = not session:batch-mode and mFramHandle:visible.
     1384     if mFrameView
     1385     then do:
     1386       ASSIGN
     1387          FRAME InfoFrame:HIDDEN                           = TRUE
     1388          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1389     end.
     1390   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1391   DO:
     1392     IF not StopProcessing THEN
     1393       Message "Вы действительно хотите прервать" SKIP
     1394               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1395                 UPDATE StopProcessing.
     1396     IF StopProcessing THEN do:
     1397        if mFrameView
     1398        then do:
     1399           HIDE FRAME InfoFrame.
     1400        end.
     1401     End.
     1402   END.
     1403   assign v-account = ( if integer( 1 ) = 0 then 100 else integer( 1 ) ).
     1404     if  log-manager:logfile-name ne ?
     1405     then DO:
     1406         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1407     end.
     1408     if not session:batch-mode then
     1409     do:
     1410       VIEW FRAME InfoFrame.
     1411       mFrameView = true.
     1412     end.
     1413      v-button-stop = false .
     1414         if mFrameView
     1415         then do:
     1416         if v-button-stop then view STOPBTN in frame InfoFrame.
     1417                          else Hide STOPBTN in frame InfoFrame.
     1418         end.
     1419   v-ind = 0    .
     1420    run paramls-clear in this-procedure .
     1421    run paramls-write in this-procedure
     1422       (input 'rowsgroup-enable':u
     1423       ,input '':u
     1424       ,input 'yes':u
     1425       ) .
     1426       Output stream Macr_Excel  close .
     1427       num#str# = 0 .
     1428       run gbl/_tmpfile.p ("wb", ".txt", output v-file-name) .
     1429       output stream macr_excel to value(v-file-name)   .
     1430       v-ind = v-ind + 1.
     1431    run get-report-num  in parParentProc(output g#report-num).
     1432       define stream  Stream-rpt .
     1433       p-file-name =  string( session:temp-directory +
     1434                     "rpt" + string( g#report-num ) + ".txt" ) .
     1435       output stream stream-rpt to value(p-file-name)   .
     1436       output stream stream-rpt close  .
     1437     run PrintTitul in this-procedure .
     1438     for each temp-str :  delete temp-str.  end.
     1439     run make-tt in this-procedure .
     1440     define variable v-row as integer   no-undo .
     1441     for each temp-grp2 break
     1442                        by temp-grp2.abc
     1443                        by temp-grp2.rating
     1444                        :
     1445        i-numb = i-numb + 1 .
     1446        number-group = string(i-numb,"99999") .
     1447         run print-grp-name in this-procedure ( output v-row ) .
     1448         for each temp-str where temp-str.grp-name begins  temp-grp2.node-name
     1449                  break by temp-str.prcK
     1450              :
     1451             run print-line in this-procedure .
     1452         end.
     1453         run print-grp-itogo in this-procedure (input v-row ) .
     1454      end.
     1455     run PrintPodval in this-procedure .
     1456     run paramls-write in this-procedure
     1457       (input "file"
     1458       ,input string(v-ind)
     1459       ,input v-file-name
     1460       ) .
     1461   Output stream Macr_Excel  close .
     1462   if mFrameView
     1463   then do:
     1464      HIDE FRAME InfoFrame.
     1465   end.
     1466       run paramls-write in this-procedure
     1467           (input "charcol"
     1468           ,input ""
     1469           ,input "1,3,4,5,6"
     1470           ) .
     1471     run end-proc in this-procedure .
     1472     run rep/runexcel.p (p-file-name ).
     1473   procedure print-line :
     1474     do on error undo, return error return-value :
     1475   num#str# = num#str# + 1.
     1476   num#col# = 1.
     1477   run macr_excel_char ( temp-str.artic     , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1478   run macr_excel_char ( temp-str.gds-code  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1479   run macr_excel_char ( temp-str.gds-name  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1480   run macr_excel_char ( temp-str.grp-name  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1481   run macr_excel_char ( temp-str.prod-name , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1482   for each temp-abc:
     1483     find first ub.abc-analysis-goods no-lock where
     1484                ub.abc-analysis-goods.abc-id = temp-abc.id and
     1485                ub.abc-analysis-goods.db-num = temp-abc.db-num and
     1486                ub.abc-analysis-goods.gds-code = temp-STR.gds-code no-error .
     1487     if available ub.abc-analysis-goods then do:
     1488        run macr_excel_char( ub.abc-analysis-goods.abcg-abc + string(ub.abc-analysis-goods.rating) , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1489        run macr_excel_DEC ( ub.abc-analysis-goods.proc-from-all , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1490        run macr_excel_DEC ( ub.abc-analysis-goods.abcg-sum-for-estimate   , num#str# , num#col#   ) .
     1491   define variable v-color as integer   no-undo .
     1492       if ub.abc-analysis-goods.abcg-abc = "A" then
     1493          assign
     1494            v-color = 3
     1495          .
     1496       if ub.abc-analysis-goods.abcg-abc = "C" then
     1497          assign
     1498            v-color = 0
     1499          .
     1500       if ub.abc-analysis-goods.abcg-abc = "B" then
     1501          assign
     1502             v-color = 41
     1503          .
     1504       if ub.abc-analysis-goods.abcg-abc = "D" then
     1505          assign
     1506            v-color = 14
     1507          .
     1508       if ub.abc-analysis-goods.abcg-abc = "E" then
     1509          assign
     1510            v-color = 13
     1511          .
     1512       if ub.abc-analysis-goods.abcg-abc = "F" then
     1513          assign
     1514             v-color = 48
     1515          .
     1516      put  stream macr_excel unformatted
     1517           substitute('select("r&1c&2:r&3c&4 ")' , num#str# , num#col# - 2 , num#str# , num#col# ) + chr(10)
     1518           substitute('font.properties(,,,,,,,,,&1,,,)', v-color ) + chr(10) .
     1519        assign    num#col# = num#col# + 1 .
     1520     end.
     1521     ELSE
     1522     num#col# = num#col# + 3 .
     1523   end.
     1524     end.
     1525   end procedure.
     1526   procedure print-all-itog :
     1527   end procedure.
     1528   procedure PrintTitul :
     1529     do  on error undo, return error return-value  :
     1530     define variable cc as integer no-undo .
     1531     define variable tt as integer no-undo .
     1532       num#str# = num#str# + 1.
     1533       num#col# = 2.
     1534       cc = num#str# .
     1535       run macr_excel_char ( "Сравнение ABC анализов по группам товаров до уровня " + string(p-lvl) , num#str# , num#col#   ) .
     1536       num#str# = num#str# + 1.
     1537       num#col# = 2.
     1538       run macr_excel_char ("Печать " + cur-time-date()  , num#str# , num#col#   ) .
     1539       run macr_cell_format
     1540           ( 12     ,
     1541             true   ,
     1542             false  ,
     1543             ?      ,
     1544             cc     ,
     1545             2      ,
     1546             num#str# ,
     1547             2 ) .
     1548       run pshap.
     1549       num#str# = num#str# + 1.
     1550       num#col# = 1.
     1551       run macr_excel_char ( "Группы с нулевым рейтингом не показываются " , num#str# , num#col#   ) .
     1552       num#str# = num#str# + 1.
     1553       num#col# = 1.
     1554       run macr_excel_char ( "Артикул товара"   , num#str# , num#col#   ) .
     1555       run macr_cell_size ( 10 , ? , num#str# , num#col# , ?, ? ) .
     1556       num#col# = 2.
     1557       run macr_excel_char ( "Код"   , num#str# , num#col#   ) .
     1558       run macr_cell_size  ( 10 , ? , num#str# , num#col# , ?, ? ) .
     1559       num#col# = 3.
     1560       run macr_excel_char ( "ТМЦ"   , num#str# , num#col#   ) .
     1561       run macr_cell_size  ( 25 , ? , num#str# , num#col# , ?, ? ) .
     1562       num#col# = 4.
     1563       run macr_excel_char ( "Группа"   , num#str# , num#col#   ) .
     1564       run macr_cell_size  ( 32 , ? , num#str# , num#col# , ?, ? ) .
     1565       num#col# = 5.
     1566       run macr_excel_char ( "Производитель"   , num#str# , num#col#   ) .
     1567       run macr_cell_size  ( 20 , ? , num#str# , num#col# , ?, ? ) .
     1568       for each temp-abc :
     1569           num#col# = num#col# + 1.
     1570           run macr_excel_char ( "Анализ № " + string(temp-abc.nn) , num#str# , num#col#   ) .
     1571           run macr_cell_size  ( 10 , ? , num#str# , num#col# , ?, ? ) .
     1572           num#col# = num#col# + 1.
     1573           run macr_excel_char (  "%"  , num#str# , num#col#   ) .
     1574           run macr_cell_size  ( 5 , ? , num#str# , num#col# , ?, ? ) .
     1575           num#col# = num#col# + 1.
     1576           run macr_excel_char ( "Сумма по критерию"  , num#str# , num#col#   ) .
     1577           run macr_cell_size  ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1578           if temp-abc.nn modulo 2 = 0 then do:
     1579               run macr_cell_format in this-procedure
     1580               ( 10    ,
     1581                 true  ,
     1582                 false  ,
     1583                 33    ,
     1584                 num#str# ,
     1585                 num#col# - 2 ,
     1586                 num#str# ,
     1587                 num#col# ) .
     1588           end.
     1589           else do:
     1590               run macr_cell_format in this-procedure
     1591               ( 10    ,
     1592                 true  ,
     1593                 false  ,
     1594                 34    ,
     1595                 num#str# ,
     1596                 num#col# - 2 ,
     1597                 num#str# ,
     1598                 num#col# ) .
     1599           end.
     1600       end.
     1601       run macr_cell_format in this-procedure
     1602       ( 10    ,
     1603         true  ,
     1604         false  ,
     1605         ?    ,
     1606         num#str# ,
     1607         1 ,
     1608         num#str# ,
     1609         14 ) .
     1610        put  stream macr_excel unformatted
     1611          substitute('select("r&1c&2:r&3c&4 ")' , num#str# , 1 , num#str# ,  num#col# ) + chr(10)  +
     1612          'BORDER( 2 , 2 , 2 , 2 , 2 , ,0,0,0,0,0) '  + chr(10) +
     1613          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     1614          .
     1615     end.
     1616   end procedure.
     1617   procedure PrintPodval :
     1618     do on error undo, return error return-value  :
     1619       num#str# = num#str# + 3.
     1620       num#col# = 1.
     1621       run macr_excel_char in this-procedure ( "Исполнитель"   , num#str# , num#col#   ) .
     1622       num#col# = 3.
     1623       run macr_excel_char ( p-user-name  , num#str# , num#col#   ) .
     1624     end.
     1625   end procedure.
     1626   procedure make-tt :
     1627     do
     1628     on error undo, return error return-value
     1629     :
     1630   define buffer buf_abc-analysis-goods  for ub.abc-analysis-goods.
     1631   define buffer buf_goods               for ub.goods.
     1632   define buffer buf_clients             for ub.clients  .
     1633   define variable p-full-name as character    no-undo.
     1634   define variable short-name as character    no-undo.
     1635   define variable  v-izt      as character no-undo .
     1636   define variable  v-acc-mat as character no-undo .
     1637   define variable  v-Amin    as character no-undo .
     1638   define variable v-full-name as character no-undo .
     1639   define variable s-prc as decimal   no-undo .
     1640   define variable s-sum as decimal   no-undo .
     1641   define variable s-n   as integer   no-undo .
     1642   define variable nn    as integer   no-undo .
     1643   for each temp-abc :
     1644     for each buf_abc-analysis-goods no-lock where
     1645              buf_abc-analysis-goods.abc-id = temp-abc.id  and
     1646              buf_abc-analysis-goods.db-num = temp-abc.db-num :
     1647              find first buf_goods no-lock where buf_goods.gds-code =  buf_abc-analysis-goods.gds-code no-error .
     1648         if not can-find ( first temp-str where temp-str.gds-code  = buf_abc-analysis-goods.gds-code) then do:
     1649             find first buf_clients no-lock where buf_clients.obj-type = buf_goods.prod-type and buf_clients.obj-code = buf_goods.prod-code no-error .
     1650             create temp-str .
     1651             assign
     1652                 temp-str.prcK      = buf_abc-analysis-goods.abcg-abc + string( buf_abc-analysis-goods.rating,"999999999999")
     1653                 temp-str.prc       = buf_abc-analysis-goods.abcg-prcnt-for-estimate
     1654                 temp-str.gds-code  = buf_abc-analysis-goods.gds-code
     1655                 temp-str.artic     = buf_goods.artic
     1656                 temp-str.gds-name  = buf_goods.gds-name
     1657                 temp-str.grp-code  = buf_goods.grp-code
     1658                 temp-str.grp-name  = buf_goods.grp-name
     1659                 temp-str.prod-name = buf_clients.obj-name
     1660             .
     1661         end.
     1662         short-name = n-lavel ( buf_goods.grp-name , p-lvl ) .
     1663         if not can-find ( first buf_abc-grp-lvl where buf_abc-grp-lvl.fullname  =  short-name and
     1664                                                       buf_abc-grp-lvl.abc-id = temp-abc.id  and
     1665                                                       buf_abc-grp-lvl.db-num = temp-abc.db-num  ) then do:
     1666             create buf_abc-grp-lvl.
     1667             assign
     1668               buf_abc-grp-lvl.fullname =  short-name
     1669               buf_abc-grp-lvl.abc-id = temp-abc.id
     1670               buf_abc-grp-lvl.db-num = temp-abc.db-num
     1671             .
     1672         end.
     1673     end.
     1674     for each buf_abc-grp-lvl no-lock where
     1675              buf_abc-grp-lvl.abc-id = temp-abc.id  and
     1676              buf_abc-grp-lvl.db-num = temp-abc.db-num :
     1677               s-prc = 0.
     1678               s-sum = 0.
     1679               for each buf_abc-analysis-grp no-lock where
     1680                     buf_abc-analysis-grp.abc-id = buf_abc-grp-lvl.abc-id  and
     1681                     buf_abc-analysis-grp.db-num = buf_abc-grp-lvl.db-num  :
     1682                     run grplib-get-full-name in this-procedure  ( input buf_abc-analysis-grp.grp-code , output v-full-name ) .
     1683                     if v-full-name begins buf_abc-grp-lvl.fullname then do:
     1684                         s-prc = s-prc + buf_abc-analysis-grp.proc-from-all .
     1685                         s-sum = s-sum + buf_abc-analysis-grp.abcg-sum-for-estimate .
     1686                     end.
     1687               end.
     1688               buf_abc-grp-lvl.abcg-prcnt-for-estimate = s-prc.
     1689               buf_abc-grp-lvl.abcg-sum-for-estimate = s-sum.
     1690     end.
     1691   IF ( temp-abc.nn modulo v-account = 0 )  then DO:
     1692    Assign
     1693       v-kol-spice = (50 - LENGTH('Пересчет ABC для подгрупп')) / 2
     1694       RecordsString = fill(' ',v-kol-spice) + string('Пересчет ABC для подгрупп')
     1695       .
     1696    Assign
     1697       v-kol-spice = (50 - LENGTH(temp-abc.name)) / 2
     1698       RecordsString2 = fill(' ',v-kol-spice) + string(temp-abc.name)
     1699       .
     1700             if  log-manager:logfile-name ne ?
     1701             then DO:
     1702                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     1703             end.
     1704              if mFrameView
     1705              then do:
     1706               DISPLAY
     1707                 temp-abc.nn @ RecordsDone
     1708                 RecordsString   @ RecordsString
     1709                 RecordsString2  @ RecordsString2
     1710                 WITH FRAME InfoFrame.
     1711              end.
     1712   End.
     1713      if v-button-stop then  DO:
     1714            if mFrameView
     1715            then
     1716               PROCESS EVENTS.
     1717            IF StopProcessing THEN DO:
     1718            RETURN error.
     1719            End.
     1720      end.
     1721     for each temp-tt : delete temp-tt . end.
     1722     for each buf_abc-grp-lvl where
     1723              buf_abc-grp-lvl.abc-id = temp-abc.id  and
     1724              buf_abc-grp-lvl.db-num = temp-abc.db-num
     1725              :
     1726         create temp-tt.
     1727         assign
     1728           temp-tt.id = recid(buf_abc-grp-lvl)
     1729           temp-tt.summa = buf_abc-grp-lvl.abcg-sum-for-estimate
     1730         .
     1731     end.
     1732     for each x-analysis : delete x-analysis . end.
     1733     for each buf_abc-analysis where
     1734              buf_abc-analysis.abc-id = temp-abc.id  and
     1735              buf_abc-analysis.db-num = temp-abc.db-num
     1736              :
     1737         create temp-tt.
     1738         buffer-copy buf_abc-analysis to x-analysis.
     1739     end.
     1740     run ref/tt-abc.p
     1741         ( input table x-analysis
     1742         , input-output table temp-tt )
     1743      .
     1744     for each buf_abc-grp-lvl no-lock where
     1745              buf_abc-grp-lvl.abc-id = temp-abc.id  and
     1746              buf_abc-grp-lvl.db-num = temp-abc.db-num  :
     1747           find first temp-tt where temp-tt.id =  recid (buf_abc-grp-lvl)  no-error .
     1748           buf_abc-grp-lvl.abcg-abc = temp-tt.abc .
     1749           buf_abc-grp-lvl.proc-from-all = temp-tt.proc .
     1750     end.
     1751     s-n = 0.
     1752     for each buf_abc-grp-lvl no-lock where
     1753              buf_abc-grp-lvl.abc-id = temp-abc.id  and
     1754              buf_abc-grp-lvl.db-num = temp-abc.db-num  break
     1755                 by buf_abc-grp-lvl.abcg-abc
     1756                 by buf_abc-grp-lvl.abcg-sum-for-estimate desc
     1757                 :
     1758              if first-of(buf_abc-grp-lvl.abcg-abc) then s-n = 0.
     1759              s-n = s-n + 1.
     1760              buf_abc-grp-lvl.rating = s-n .
     1761     end.
     1762   end.
     1763   define buffer buf_temp-abc for temp-abc  .
     1764   find first buf_temp-abc no-error .
     1765   for each ub.gds-grp where ub.gds-grp.is-term = true no-lock  :
     1766   run grplib-get-full-name in this-procedure
     1767    ( input  ub.gds-grp.node-code ,
     1768      output p-full-name  ) .
     1769     short-name = n-lavel ( p-full-name , p-lvl ) .
     1770     if not can-find ( first temp-grp2 where temp-grp2.node-name  =  short-name ) then do:
     1771        find first abc-grp-lvl where
     1772                   abc-grp-lvl.fullname = short-name and
     1773                   abc-grp-lvl.abc-id   = buf_temp-abc.id  and
     1774                   abc-grp-lvl.db-num   = buf_temp-abc.db-num  no-error .
     1775         create temp-grp2.
     1776         assign
     1777           temp-grp2.grp-name   =  p-full-name
     1778           temp-grp2.node-name  =  short-name
     1779           temp-grp2.abc        =  if available abc-grp-lvl then  abc-grp-lvl.abcg-abc else "X"
     1780           temp-grp2.rating     =  if available abc-grp-lvl then  abc-grp-lvl.rating   else 0
     1781         .
     1782     end.
     1783   end.
     1784   for each temp-grp2 :
     1785       v-sum-prc = 0 .
     1786       for each temp-str where  temp-str.grp-name begins temp-grp2.node-name :
     1787           temp-str.lvl-code  = p-lvl .
     1788           temp-str.node-code = ? .
     1789           v-sum-prc = v-sum-prc + temp-str.prc .
     1790       end.
     1791       if v-sum-prc = 0 then do:
     1792         find first temp-str where temp-str.grp-name begins  temp-grp2.node-name no-error .
     1793         if not available temp-str then
     1794            delete temp-grp2   .
     1795       end.
     1796       else temp-grp2.prc = v-sum-prc .
     1797   end.
     1798     end.
     1799    end procedure.
     1800   procedure pshap :
     1801     do
     1802     on error undo, return error return-value
     1803     :
     1804     define variable tt as integer   no-undo .
     1805       num#str# = num#str# + 1.
     1806       num#col# = 1.
     1807       tt = num#str# .
     1808       for each temp-abc :
     1809           run macr_excel_char in this-procedure
     1810           ( "Анализ № " + string(temp-abc.nn )  ,
     1811              num#str# ,
     1812              num#col#   ) .
     1813               run macr_cell_format in this-procedure
     1814               ( 10    ,
     1815                 true  ,
     1816                 false ,
     1817                 ?     ,
     1818                 num#str# ,
     1819                 num#col# ,
     1820                 num#str# ,
     1821                 num#col# ) .
     1822           num#str# = num#str# + 1.
     1823           run macr_excel_char ( temp-abc.name               , num#str# , num#col#   ) . num#str# = num#str# + 1.
     1824           if temp-abc.des <> "" then do:  run macr_excel_char( temp-abc.des                , num#str# , num#col#   ) . num#str# = num#str# + 1. end.
     1825           run macr_excel_char ( temp-abc.name-cral          , num#str# , num#col#   ) . num#str# = num#str# + 1.
     1826           run macr_excel_char ( "A=" + string( temp-abc.A )                 , num#str# , num#col#   ) . num#str# = num#str# + 1.
     1827           run macr_excel_char ( "B=" + string( temp-abc.B )                 , num#str# , num#col#   ) . num#str# = num#str# + 1.
     1828           run macr_excel_char ( "C=" + string( temp-abc.C )                 , num#str# , num#col#   ) . num#str# = num#str# + 1.
     1829           if temp-abc.D > 0 then do:  run macr_excel_char ( "D=" + string(temp-abc.D )   , num#str# , num#col#   ) .    num#str# = num#str# + 1. end.
     1830           if temp-abc.E > 0 then do:  run macr_excel_char ( "E=" + string(temp-abc.E )   , num#str# , num#col#   ) .    num#str# = num#str# + 1. end.
     1831           if temp-abc.F > 0 then do:  run macr_excel_char ( "F=" + string(temp-abc.F )   , num#str# , num#col#   ) .    num#str# = num#str# + 1. end.
     1832           if temp-abc.type <> " " then do: run macr_excel_char ( temp-abc.type          , num#str# , num#col#   ) .  num#str# = num#str# + 1.    end.
     1833           run macr_excel_char ( "создан : " + string(temp-abc.date-cr , "99/99/9999")            , num#str# , num#col#   ) . num#str# = num#str# + 1.
     1834           run macr_excel_char ( temp-abc.period             , num#str# , num#col#   ) .  num#str# = num#str# + 1.
     1835           run macr_excel_char ( temp-abc.ext-doc-type       , num#str# , num#col#   ) .  num#str# = num#str# + 1.
     1836           run macr_excel_char ( temp-abc.obj                , num#str# , num#col#   ) .  num#str# = num#str# + 1.
     1837       end.
     1838     end.
     1839   end procedure.
     1840   procedure print-grp-name :
     1841   define output parameter p-row as integer   no-undo .
     1842     do
     1843     on error undo, return error return-value
     1844     :
     1845   num#str# = num#str# + 1.
     1846   num#col# = 1.
     1847   run macr_excel_char (  temp-grp2.node-name   , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1848    assign    num#col# = num#col# + 1 .
     1849    assign    num#col# = num#col# + 1 .
     1850   run macr_excel_char ( entry(1, temp-grp2.grp-name ,"/" )    , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1851       run macr_cell_format in this-procedure
     1852           ( 12     ,
     1853             true   ,
     1854             false  ,
     1855             48      ,
     1856             num#str# ,
     1857             1      ,
     1858             num#str# ,
     1859             5 + ( var-kol * 3 ) ) .
     1860   p-row =  num#str# .
     1861     end.
     1862   end procedure.
     1863   procedure print-grp-itogo :
     1864   define input  parameter p-row as integer   no-undo .
     1865     do
     1866     on error undo, return error return-value
     1867     :
     1868     run paramls-write in this-procedure
     1869       (input "rowsgroup"
     1870       ,input string(v-ind) + ',':u + number-group
     1871       ,input substitute('&1:&2' ,  p-row, num#str# )
     1872       ) .
     1873   num#str# = num#str# + 1.
     1874   num#col# = 1.
     1875       run macr_cell_format in this-procedure
     1876           ( ?     ,
     1877             true   ,
     1878             false  ,
     1879             ?      ,
     1880             num#str# ,
     1881             1      ,
     1882             num#str# ,
     1883             5 + ( var-kol * 3 ) ) .
     1884   run macr_excel_char in this-procedure (  temp-grp2.node-name    , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1885    assign    num#col# = num#col# + 1 .
     1886    assign    num#col# = num#col# + 1 .
     1887   run macr_excel_char ( entry(1, temp-grp2.grp-name ,"/" ) , num#str# , num#col#   ) . assign num#col# = num#col# + 1 .
     1888   run macr_excel_char ( ""                  , num#str# , num#col#   ) . assign num#col# = num#col# + 1 .
     1889   for each temp-abc:
     1890     find first abc-grp-lvl no-lock where
     1891                abc-grp-lvl.abc-id = temp-abc.id and
     1892                abc-grp-lvl.db-num = temp-abc.db-num and
     1893                abc-grp-lvl.fullname = temp-grp2.node-name no-error .
     1894     if available abc-grp-lvl then do:
     1895        run macr_excel_char ( abc-grp-lvl.abcg-abc + string(abc-grp-lvl.rating) , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1896        run macr_excel_DEC ( abc-grp-lvl.proc-from-all , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1897        run macr_excel_DEC ( abc-grp-lvl.abcg-sum-for-estimate   , num#str# , num#col#   ) .
     1898   define variable v-color as integer   no-undo .
     1899       if abc-grp-lvl.abcg-abc = "A" then
     1900          assign
     1901            v-color = 3
     1902          .
     1903       if abc-grp-lvl.abcg-abc = "C" then
     1904          assign
     1905            v-color = 0
     1906          .
     1907       if abc-grp-lvl.abcg-abc = "B" then
     1908          assign
     1909             v-color = 41
     1910          .
     1911       if abc-grp-lvl.abcg-abc = "D" then
     1912          assign
     1913            v-color = 14
     1914          .
     1915       if abc-grp-lvl.abcg-abc = "E" then
     1916          assign
     1917            v-color = 13
     1918          .
     1919       if abc-grp-lvl.abcg-abc = "F" then
     1920          assign
     1921             v-color = 48
     1922          .
     1923      put  stream macr_excel unformatted
     1924           substitute('select("r&1c&2:r&3c&4 ")' , num#str# , num#col# - 2 , num#str# , num#col# ) + chr(10)
     1925           substitute('font.properties(,,,,,,,,,&1,,,)', v-color ) + chr(10)
     1926           .
     1927        assign    num#col# = num#col# + 1 .
     1928     end.
     1929     ELSE
     1930     num#col# = num#col# + 3 .
     1931   end.
     1932     end.
     1933   end procedure.
     1934   def var vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1935   procedure macr_excel_char :
     1936    do
     1937    on error undo, return error return-value
     1938    :
     1939    define input parameter  p-val as character no-undo .
     1940    define input parameter  p-row as integer no-undo .
     1941    define input parameter  p-col as integer no-undo .
     1942    if p-val = ? then p-val = "" .
     1943       put stream macr_excel unformatted
     1944             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1945    end.
     1946   end procedure.
     1947   procedure macr_excel_char_with_format :
     1948    do
     1949    on error undo, return error return-value
     1950    :
     1951    define input parameter  p-val as character no-undo .
     1952    define input parameter  p-row as integer no-undo .
     1953    define input parameter  p-col as integer no-undo .
     1954    if p-val = ? then p-val = "" .
     1955       put stream macr_excel unformatted
     1956             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     1957       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     1958       put stream macr_excel unformatted
     1959             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1960    end.
     1961   end procedure.
     1962   procedure macr_excel_cell_format :
     1963    do
     1964    on error undo, return error return-value
     1965    :
     1966    define input parameter  p-val    as character no-undo .
     1967    define input parameter  p-row    as integer   no-undo .
     1968    define input parameter  p-col    as integer   no-undo .
     1969    define input parameter  p-format as character no-undo .
     1970    if p-val = ? then p-val = "" .
     1971       put stream macr_excel unformatted
     1972             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     1973       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     1974       put stream macr_excel unformatted
     1975             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1976    end.
     1977   end procedure.
     1978   procedure macr_excel_sum :
     1979    do
     1980    on error undo, return error return-value
     1981    :
     1982    define input parameter  p-row as integer no-undo .
     1983    define input parameter  p-col as integer no-undo .
     1984    define input parameter  p-row1 as integer no-undo .
     1985    define input parameter  p-col1 as integer no-undo .
     1986    define input parameter  p-row2 as integer no-undo .
     1987    define input parameter  p-col2 as integer no-undo .
     1988       put stream macr_excel unformatted
     1989             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     1990    end.
     1991   end procedure.
     1992   procedure macr_excel_dec :
     1993    do
     1994    on error undo, return error return-value
     1995    :
     1996    define input parameter  p-val as character no-undo .
     1997    define input parameter  p-row as integer   no-undo .
     1998    define input parameter  p-col as integer   no-undo .
     1999     if p-val = ? then p-val =  "" .
     2000      put  stream macr_excel unformatted
     2001           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     2002    end.
     2003   end procedure.
     2004   procedure macr_cell_format :
     2005    do
     2006    on error undo, return error return-value
     2007    :
     2008    define input parameter  p-size   as integer   no-undo .
     2009    define input parameter  p-bold   as logical   no-undo .
     2010    define input parameter  p-italic as logical   no-undo .
     2011    define input parameter  p-color  as integer   no-undo .
     2012    define input parameter  p-row    as integer   no-undo .
     2013    define input parameter  p-col    as integer   no-undo .
     2014    define input parameter  p-row-2  as integer   no-undo .
     2015    define input parameter  p-col-2  as integer   no-undo .
     2016     if p-size = ? then p-size = 10 .
     2017     if p-bold = ? then p-bold = false .
     2018     if p-italic = ? then p-italic = false .
     2019     if p-row-2 = ? then p-row-2 = p-row .
     2020     if p-col-2 = ? then p-col-2 = p-col .
     2021     put  stream macr_excel unformatted
     2022      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     2023     if p-color <> ? then do:
     2024        put  stream macr_excel unformatted
     2025          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     2026     end.
     2027     put  stream macr_excel unformatted
     2028          substitute('format.font(,&1,&2,&3)' , p-size,
     2029                                           string ( p-bold  , "true/false" ) ,
     2030                                           string ( p-italic , "true/false" )
     2031                                           ) + chr(10) .
     2032    end.
     2033   end procedure.
     2034   procedure macr_cell_size :
     2035    do
     2036    on error undo, return error return-value
     2037    :
     2038    define input parameter  p-w   as integer   no-undo .
     2039    define input parameter  p-l   as integer   no-undo .
     2040    define input parameter  p-row    as integer   no-undo .
     2041    define input parameter  p-col    as integer   no-undo .
     2042    define input parameter  p-row-2  as integer   no-undo .
     2043    define input parameter  p-col-2  as integer   no-undo .
     2044     if p-row-2 = ? then p-row-2 = p-row .
     2045     if p-col-2 = ? then p-col-2 = p-col .
     2046     if p-w = ? then    p-w = 0 .
     2047     if p-l = ? then    p-l = 0 .
     2048    define variable s-w as character no-undo .
     2049    define variable s-l as character no-undo .
     2050    if p-w = 0 then s-w = "" .
     2051               else s-w = string(p-w)  .
     2052    if p-l = 0 then s-l = "" .
     2053               else s-l = string(p-l)  .
     2054   put  stream macr_excel unformatted
     2055        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     2056   put  stream macr_excel unformatted
     2057        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     2058   put  stream macr_excel unformatted
     2059        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     2060    end.
     2061   end procedure.
     2062   procedure proc-print-header :
     2063    do
     2064    on error undo, return error return-value
     2065    :
     2066      find first sheetf .
     2067        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     2068        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     2069        var-1 =  num#str# .
     2070        repeat c-c = 1 to sheetf.excel-row-title :
     2071        num#str# = num#str# + 1 .
     2072        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     2073        do c-i = 1 to p-var :
     2074           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     2075           str--2 = integer(entry( c-i, sheetf.sizes )) .
     2076           num#col# = c-i .
     2077           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     2078           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     2079        end.
     2080       c-i = 0.
     2081       end.
     2082       run macr_cell_format (
     2083           10       ,
     2084           true     ,
     2085           false    ,
     2086           35       ,
     2087           var-1 + 1,
     2088           1        ,
     2089           num#str# ,
     2090           num#col# )
     2091           .
     2092     put  stream macr_excel unformatted
     2093          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     2094          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     2095          .
     2096    end.
     2097   end procedure.
     2098   procedure end-proc :
     2099    do
     2100    on error undo, return error return-value
     2101    :
     2102     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     2103     OUTPUT to VALUE (v-file-name) .
     2104     for each temp-param :
     2105       export  temp-param  .
     2106     end.
     2107    end.
     2108   end procedure.
