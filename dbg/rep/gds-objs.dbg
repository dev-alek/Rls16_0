        1   define input parameter parparentproc  as widget-handle no-undo.
        2   define input parameter pp-artic     like ub.prt-obj.artic     no-undo.
        3   define input parameter pp-prod-type like ub.prt-obj.prod-type no-undo.
        4   define input parameter pp-prod-code like ub.prt-obj.prod-code no-undo.
        5   define input parameter pp-host-code like ub.prt-obj.host-code no-undo.
        6   define input parameter pp-node-code like ub.gds-prt.node-code no-undo.
        7   define variable vss-revision    as character no-undo initial "$Revision$":U .
        8   define variable vss-author      as character no-undo initial "$Author$":U .
        9   define variable vss-date        as character no-undo initial "$Date$":U .
       10   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
       11   define variable vss-archive     as character no-undo initial "$Archive$":U .
       12   define variable vss-description as character no-undo initial "Остатки по признаку по всем объектам текущей фирмы или всех фирм".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define   shared variable g#auto as logical no-undo.
       74   define   shared variable g#news as logical no-undo.
       75   define   shared variable g#oxml as logical no-undo.
       76   define   shared variable g#esys as logical no-undo.
       77   define   shared variable g#news-source-db as integer no-undo.
       78   define   shared variable g#esys-source-esys as integer no-undo.
       79   define   shared variable g#db-num as integer   no-undo .
       80   define   shared variable g#userid as character no-undo .
       81   define   shared variable g#passwd as character no-undo .
       82   procedure proc-alt-shift-f2:
       83     if not ibs.th.gbl.gbl-var:rcode
       84   then
       85     run gbl\inidebug.p .
       86   end.
       87   procedure proc-alt-shift-f3:
       88     run gbl/prvssinf.p
       89       ( input this-procedure
       90       ) .
       91   end.
       92   define variable v-inform-launched as logical no-undo initial false .
       93   procedure proc-alt-shift-f4:
       94     define variable v-action as character no-undo .
       95     if v-inform-launched = false then do:
       96       assign
       97         v-inform-launched = true
       98       .
       99       run gbl/d-inform.w
      100         (  input self
      101         ,  input this-procedure
      102         , output v-action
      103         ) no-error .
      104       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      105       assign
      106         v-inform-launched = false
      107       .
      108     end.
      109   end.
      110   procedure proc-alt-f1:
      111     run gbl/corrhelp.p
      112       (input this-procedure
      113       ) .
      114   end .
      115   on alt-shift-f2 anywhere do:
      116     run proc-alt-shift-f2.
      117   end.
      118   on alt-shift-f3 anywhere do:
      119     run proc-alt-shift-f3 in this-procedure .
      120   end.
      121   on alt-shift-f4 anywhere do:
      122     run proc-alt-shift-f4 in this-procedure.
      123   end.
      124   on alt-f1 anywhere do:
      125     run proc-alt-f1 in this-procedure .
      126   end.
      127   define new global shared variable g#lib-trn  as handle no-undo .
      128   define new global shared variable g#lib-trn2 as handle no-undo .
      129   define new global shared variable g#lib-trn3 as handle no-undo .
      130   define new global shared variable g#lib-trn4 as handle no-undo .
      131   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      132   procedure cur-time :
      133      define output parameter p-today as date      no-undo .
      134      define output parameter p-time  as integer   no-undo .
      135     do
      136     on error undo, return error
      137     :
      138       define variable v-date1 as date      no-undo .
      139       define variable v-date2 as date      no-undo .
      140       define variable v-time  as integer   no-undo .
      141       assign
      142         v-date1 = today
      143         v-time  = time
      144         v-date2 = today
      145       .
      146       if v-date1 <> v-date2
      147       then do:
      148         assign
      149           v-date1 = today
      150           v-time  = v-time
      151         .
      152       end.
      153       assign
      154         p-today = v-date1
      155         p-time  = v-time
      156       .
      157     end.
      158   end.
      159   function cur-time-date returns character
      160   :
      161     return string(today, '99/99/9999':U) .
      162   end.
      163   function cur-time-mjd returns decimal
      164   :
      165     define variable v-date as date      no-undo .
      166     define variable v-time as integer   no-undo .
      167     run cur-time in this-procedure
      168       (output v-date
      169       ,output v-time
      170       ) .
      171     return integer(v-date) - 2400002 + (v-time / 86400) .
      172   end.
      173   function cur-time-get-ending-index returns integer
      174   (input p-number as integer
      175   )
      176   :
      177     if p-number < 0
      178     or p-number = ?
      179     then do:
      180       return 1 .
      181     end.
      182     define variable v-rest as integer   no-undo .
      183     assign
      184       p-number = p-number modulo 100
      185     .
      186     if p-number < 20
      187     then do:
      188       assign
      189         v-rest = p-number
      190       .
      191     end.
      192     else do:
      193       assign
      194         v-rest = p-number modulo 10
      195       .
      196     end.
      197     case v-rest :
      198       when 1
      199       then do:
      200         return 2 .
      201       end.
      202       when 2 or
      203       when 3 or
      204       when 4
      205       then do:
      206         return 3 .
      207       end.
      208       otherwise do:
      209         return 1 .
      210       end.
      211     end case .
      212   end.
      213   procedure cur-time-mjd-to-date :
      214      define input  parameter i-mjd-diff as decimal no-undo.
      215      define output parameter o-Date     as date    no-undo.
      216      define output parameter o-Time     as integer no-undo.
      217      define variable v-day-number as integer   no-undo .
      218      if    i-mjd-diff < 0
      219         or i-mjd-diff = ?
      220      then do:
      221         return "?" .
      222      end.
      223      assign
      224         v-day-number = truncate(i-mjd-diff,0).
      225         o-Date = date(v-day-number + 2400002).
      226         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      227     .
      228   end.
      229   function cur-time-mjd-to-string returns character
      230   (input p-mjd-diff as decimal
      231   )
      232   :
      233     define variable v-day-number as integer   no-undo .
      234     define variable v-seconds    as integer   no-undo .
      235     define variable v-hour       as integer   no-undo .
      236     define variable v-min        as integer   no-undo .
      237     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      238     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      239     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      240     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      241     if p-mjd-diff < 0
      242     or p-mjd-diff = ?
      243     then do:
      244       return "?" .
      245     end.
      246     assign
      247       v-day-number = integer(truncate(p-mjd-diff,0))
      248       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      249     .
      250     if v-seconds > 86400
      251     then do:
      252       assign
      253         v-seconds = 86400 - 1
      254       .
      255     end.
      256     if v-seconds < 0
      257     then do:
      258       assign
      259         v-seconds = 0
      260       .
      261     end.
      262     assign
      263       v-hour = truncate(v-seconds / 3600, 0)
      264     .
      265     assign
      266       v-seconds = v-seconds modulo 3600
      267     .
      268     assign
      269       v-min = truncate(v-seconds / 60, 0)
      270     .
      271     assign
      272       v-seconds = v-seconds modulo 60
      273     .
      274     return
      275         (if v-day-number <> 0
      276           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      277           else ""
      278         )
      279       + (if v-day-number <> 0 or v-hour <> 0
      280           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      281           else ""
      282         )
      283       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      284           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      285           else ""
      286         )
      287       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      288       .
      289   end.
      290   function cur-time-string returns character
      291   :
      292     define variable v-date as date      no-undo .
      293     define variable v-time as integer   no-undo .
      294     run cur-time in this-procedure
      295       (output v-date
      296       ,output v-time
      297       ) .
      298     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      299   end.
      300   function cur-time-string-sec returns character
      301   :
      302     define variable v-date as date      no-undo .
      303     define variable v-time as integer   no-undo .
      304     run cur-time in this-procedure
      305       (output v-date
      306       ,output v-time
      307       ) .
      308     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      309   end.
      310   function cur-time-custom  returns character
      311   (input p-prefix as character
      312   ,input p-date-format as character
      313   ,input p-delimiter as character
      314   ,input p-time-format as character
      315   ,input p-suffix as character
      316   )
      317   :
      318     define variable v-date as date      no-undo .
      319     define variable v-time as integer   no-undo .
      320     run cur-time in this-procedure
      321       (output v-date
      322       ,output v-time
      323       ) .
      324     return
      325       p-prefix
      326       + string(v-date, p-date-format)
      327       + p-delimiter
      328       + string(v-time, p-time-format)
      329       + p-suffix
      330       .
      331   end.
      332   function cur-time-print  returns character
      333   :
      334     define variable v-date as date      no-undo .
      335     define variable v-time as integer   no-undo .
      336     run cur-time in this-procedure
      337       (output v-date
      338       ,output v-time
      339       ) .
      340     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      341   end.
      342   function cur-time-datetime returns datetime
      343   :
      344     define variable v-char as character no-undo .
      345     define variable v-datetime as datetime no-undo .
      346     v-char = cur-time-string().
      347     v-datetime = datetime(v-char).
      348     return  v-datetime.
      349   end.
      350   function cur-time-string-msec returns character
      351   :
      352     define variable v-date as datetime  no-undo .
      353     v-date = now.
      354     return string(v-date) .
      355   end.
      356   define variable vss-include-info1 as character no-undo format "x(65)":U initial "@(#)$Workfile$ $Revision$".
      357   define temp-table temp_prt-obj no-undo
      358     field artic       like ub.prt-obj.artic
      359     field obj-type    like ub.prt-obj.obj-type
      360     field obj-code    like ub.prt-obj.obj-code
      361     field host-code   like ub.prt-obj.host-code
      362     field obj-name    like ub.clients.obj-name
      363     field qnty        like ub.prt-obj.fact-qnty
      364     field free-qnty   like ub.prt-obj.free-qnty
      365     field price       like ub.prt-obj.price-sale
      366     field fact-qty-kg like ub.prt-obj.fact-qnty
      367     field free-qty-kg like ub.prt-obj.free-qnty
      368     field price-kg    like ub.prt-obj.price-sale
      369     field sdate       like ub.trn-doc.fact-date
      370     field stime       as   character
      371     field stime-int   as   integer
      372     field db-num      like ub.db.db-num
      373     field db-name     like ub.db.db-name
      374     index pi          is   unique primary           obj-type obj-code
      375     index ie1                             host-code obj-type obj-code
      376   .
      377   procedure fill-temp_prt-obj :
      378     define input  parameter p-artic       as character no-undo .
      379     define input  parameter p-prod-type   as character no-undo .
      380     define input  parameter p-prod-code   as integer   no-undo .
      381     define input  parameter p-host-code   as integer   no-undo .
      382     define input  parameter p-node        as integer   no-undo .
      383     define input  parameter p-firm-global as character no-undo .
      384     define input  parameter p-is-ptrl     as logical   no-undo .
      385     define output parameter p-total-fact  as decimal   no-undo .
      386     define output parameter p-total-sum   as decimal   no-undo .
      387     define output parameter p-fact-kg     as decimal   no-undo .
      388     do on error undo, return error return-value :
      389       define buffer buf_temp_prt-obj for temp_prt-obj .
      390       define buffer buf_prt-obj      for ub.prt-obj .
      391       define buffer buf_clients      for ub.clients .
      392       define buffer buf_db           for ub.db .
      393       define buffer buf_trn-doc      for ub.trn-doc .
      394       define buffer buf_db-status    for ub.db-status .
      395       for each buf_temp_prt-obj on error undo, return error return-value :
      396         delete buf_temp_prt-obj .
      397       end.
      398       if p-firm-global = "firm" then do:
      399         for each buf_prt-obj no-lock where
      400                  buf_prt-obj.artic     = p-artic     and
      401                  buf_prt-obj.prod-type = p-prod-type and
      402                  buf_prt-obj.prod-code = p-prod-code and
      403                  buf_prt-obj.prt-code  = p-node      and
      404                  buf_prt-obj.host-code = p-host-code on error undo, return error return-value :
      405           find buf_temp_prt-obj no-lock where
      406                buf_temp_prt-obj.artic    = buf_prt-obj.artic    and
      407                buf_temp_prt-obj.obj-type = buf_prt-obj.obj-type and
      408                buf_temp_prt-obj.obj-code = buf_prt-obj.obj-code no-error .
      409           if not available buf_temp_prt-obj then do:
      410             create buf_temp_prt-obj.
      411             assign buf_temp_prt-obj.artic     = buf_prt-obj.artic
      412                    buf_temp_prt-obj.obj-type  = buf_prt-obj.obj-type
      413                    buf_temp_prt-obj.obj-code  = buf_prt-obj.obj-code
      414                    buf_temp_prt-obj.host-code = p-host-code
      415                    buf_temp_prt-obj.qnty      = buf_prt-obj.fact-qnty
      416                    buf_temp_prt-obj.free-qnty = buf_prt-obj.free-qnty
      417                    buf_temp_prt-obj.price     = buf_prt-obj.price-sale
      418                    buf_temp_prt-obj.obj-name  = ?
      419                    buf_temp_prt-obj.sdate     = ?
      420                    buf_temp_prt-obj.stime     = ?
      421                    buf_temp_prt-obj.stime-int = ?
      422                    buf_temp_prt-obj.db-num    = ?
      423                    buf_temp_prt-obj.db-name   = ?
      424             .
      425           if p-is-ptrl = yes then do:
      426             run get-weight-qty in this-procedure ( buffer buf_prt-obj,
      427                                                    output buf_temp_prt-obj.free-qty-kg,
      428                                                    output buf_temp_prt-obj.fact-qty-kg  ) no-error.
      429             if error-status :error then do: undo, return error return-value. end.
      430             run get-weight-prc in this-procedure ( buffer buf_prt-obj,
      431                                                    output buf_temp_prt-obj.price-kg     ) no-error.
      432             if error-status :error then do: undo, return error return-value. end.
      433           end.
      434           end.
      435         end.
      436       end.
      437       else do:
      438         for each buf_prt-obj no-lock where
      439                  buf_prt-obj.artic     = p-artic     and
      440                  buf_prt-obj.prod-type = p-prod-type and
      441                  buf_prt-obj.prod-code = p-prod-code and
      442                  buf_prt-obj.prt-code  = p-node      on error undo, return error return-value :
      443           find buf_temp_prt-obj no-lock where
      444                buf_temp_prt-obj.artic    = buf_prt-obj.artic    and
      445                buf_temp_prt-obj.obj-type = buf_prt-obj.obj-type and
      446                buf_temp_prt-obj.obj-code = buf_prt-obj.obj-code no-error .
      447           if not available buf_temp_prt-obj then do:
      448             create buf_temp_prt-obj.
      449             assign buf_temp_prt-obj.artic     = buf_prt-obj.artic
      450                    buf_temp_prt-obj.obj-type  = buf_prt-obj.obj-type
      451                    buf_temp_prt-obj.obj-code  = buf_prt-obj.obj-code
      452                    buf_temp_prt-obj.host-code = ?
      453                    buf_temp_prt-obj.qnty      = buf_prt-obj.fact-qnty
      454                    buf_temp_prt-obj.free-qnty = buf_prt-obj.free-qnty
      455                    buf_temp_prt-obj.price     = buf_prt-obj.price-sale
      456                    buf_temp_prt-obj.obj-name  = ?
      457                    buf_temp_prt-obj.sdate     = ?
      458                    buf_temp_prt-obj.stime     = ?
      459                    buf_temp_prt-obj.stime-int = ?
      460                    buf_temp_prt-obj.db-num    = ?
      461                    buf_temp_prt-obj.db-name   = ?
      462             .
      463           if p-is-ptrl = yes then do:
      464             run get-weight-qty in this-procedure ( buffer buf_prt-obj,
      465                                                    output buf_temp_prt-obj.free-qty-kg,
      466                                                    output buf_temp_prt-obj.fact-qty-kg  ) no-error.
      467             if error-status :error then do: undo, return error return-value. end.
      468             run get-weight-prc in this-procedure ( buffer buf_prt-obj,
      469                                                    output buf_temp_prt-obj.price-kg     ) no-error.
      470             if error-status :error then do: undo, return error return-value. end.
      471           end.
      472           end.
      473         end.
      474       end.
      475       assign
      476         p-total-fact = 0
      477         p-total-sum  = 0
      478       .
      479       for each buf_temp_prt-obj on error undo, return error return-value :
      480         assign
      481           p-total-fact = p-total-fact + buf_temp_prt-obj.qnty
      482           p-total-sum  = p-total-sum  + buf_temp_prt-obj.qnty        * buf_temp_prt-obj.price
      483           p-fact-kg    = p-fact-kg    + buf_temp_prt-obj.fact-qty-kg
      484         .
      485         find first buf_clients no-lock where
      486                    buf_clients.obj-type = buf_temp_prt-obj.obj-type and
      487                    buf_clients.obj-code = buf_temp_prt-obj.obj-code no-error .
      488         if available buf_clients then do:
      489           assign
      490             buf_temp_prt-obj.db-num   = buf_clients.db-num
      491             buf_temp_prt-obj.obj-name = buf_clients.obj-name
      492           .
      493         end.
      494         find first buf_db no-lock where buf_db.db-num = buf_temp_prt-obj.db-num no-error.
      495         if available buf_db then do:
      496           assign
      497             buf_temp_prt-obj.db-num  = buf_db.db-num
      498             buf_temp_prt-obj.db-name = buf_db.db-name
      499           .
      500         end.
      501         if buf_temp_prt-obj.db-num = g#db-num then do:
      502           run cur-time in this-procedure ( output buf_temp_prt-obj.sdate, output buf_temp_prt-obj.stime-int ) .
      503         end.
      504         else do:
      505           find first buf_db-status no-lock where buf_db-status.db-num = buf_temp_prt-obj.db-num no-error .
      506           if available buf_db-status then do:
      507             assign
      508               buf_temp_prt-obj.sdate     = buf_db-status.stock-date
      509               buf_temp_prt-obj.stime-int = buf_db-status.stock-time
      510             .
      511           end.
      512         end.
      513         if buf_temp_prt-obj.stime-int <> ? then do:
      514           assign
      515             buf_temp_prt-obj.stime = string( buf_temp_prt-obj.stime-int, 'HH:MM:SS':U )
      516           .
      517         end.
      518       end.
      519     end.
      520   end procedure.
      521     procedure get-weight-qty :
      522       define        parameter buffer loc-prt-obj   for ub.prt-obj.
      523       define output parameter        p-free-qty-kg as  decimal no-undo initial 0.0.
      524       define output parameter        p-fact-qty-kg as  decimal no-undo initial 0.0.
      525       define buffer buf_doc-line for ub.doc-line.
      526       define buffer buf_inv-line for ub.inv-line.
      527       do on error undo, return error return-value :
      528         if available loc-prt-obj then do:
      529           for each buf_doc-line no-lock where
      530                    buf_doc-line.obj-type   = loc-prt-obj.obj-type  and
      531                    buf_doc-line.obj-code   = loc-prt-obj.obj-code  and
      532                    buf_doc-line.prod-type  = loc-prt-obj.prod-type and
      533                    buf_doc-line.prod-code  = loc-prt-obj.prod-code and
      534                    buf_doc-line.artic      = loc-prt-obj.artic     and
      535                    buf_doc-line.status_    = 'факт':U               and
      536                    buf_doc-line.fact-order > 0                     use-index fact-order
      537                 by buf_doc-line.fact-order   descending :
      538             find first buf_inv-line no-lock where
      539                        buf_inv-line.doc-code  = buf_doc-line.doc-code  and
      540                        buf_inv-line.artic     = buf_doc-line.artic     and
      541                        buf_inv-line.prod-code = buf_doc-line.prod-code and
      542                        buf_inv-line.prod-type = buf_doc-line.prod-type no-error.
      543             if available buf_inv-line then do:
      544               assign p-fact-qty-kg = ( if buf_inv-line.after-cli-qnty = ? then 0.0 else buf_inv-line.after-cli-qnty ).
      545               if loc-prt-obj.free-qnty <> ? and loc-prt-obj.fact-qnty <> ? and loc-prt-obj.fact-qnty <> 0.0 then do:
      546                 assign p-free-qty-kg = loc-prt-obj.free-qnty / loc-prt-obj.fact-qnty * p-fact-qty-kg.
      547               end.
      548               leave.
      549             end.
      550           end.
      551         end.
      552       end.
      553     end procedure.
      554     procedure get-weight-prc :
      555       define        parameter buffer loc-prt-obj  for ub.prt-obj.
      556       define output parameter        p-price-sale as  decimal no-undo initial 0.0.
      557       define variable is-base as logical no-undo.
      558       define buffer buf_doc-line for ub.doc-line.
      559       define buffer buf_inv-line for ub.inv-line.
      560       do on error undo, return error return-value :
      561         if available loc-prt-obj then do:
      562   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      563   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
      564     (output is-base
      565     ) no-error .
      566           if error-status :error then do: return error return-value. end.
      567           for each buf_doc-line no-lock where
      568                    buf_doc-line.obj-type   = loc-prt-obj.obj-type  and
      569                    buf_doc-line.obj-code   = loc-prt-obj.obj-code  and
      570                    buf_doc-line.prod-type  = loc-prt-obj.prod-type and
      571                    buf_doc-line.prod-code  = loc-prt-obj.prod-code and
      572                    buf_doc-line.artic      = loc-prt-obj.artic     and
      573                    buf_doc-line.status_    = 'факт':U               and
      574                    buf_doc-line.fact-order > 0                     use-index fact-order
      575                 by buf_doc-line.fact-order   descending :
      576             find first buf_inv-line no-lock where
      577                        buf_inv-line.doc-code  = buf_doc-line.doc-code  and
      578                        buf_inv-line.artic     = buf_doc-line.artic     and
      579                        buf_inv-line.prod-code = buf_doc-line.prod-code and
      580                        buf_inv-line.prod-type = buf_doc-line.prod-type no-error.
      581             if available buf_inv-line then do:
      582               assign p-price-sale = ( if is-base = yes then buf_inv-line.wast-base else buf_inv-line.wast-rubl ).
      583               leave.
      584             end.
      585           end.
      586         end.
      587       end.
      588     end procedure.
      589   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      590   define variable v-waitfram-action01         as character   no-undo .
      591   define variable v-waitfram-action02         as character   no-undo .
      592   define variable v-waitfram-action03         as character   no-undo .
      593   define variable mWaitFramTextBeg            as character   no-undo.
      594   define variable mWaitFramTextEnd            as character   no-undo.
      595   define variable mWaitFramView               as logical     no-undo.
      596   define variable mWaitProcEvent              as logical     no-undo init yes.
      597   define variable mWaitFramInterval           as integer     no-undo init 1 .
      598   define variable mWaitFramStop               as logical     no-undo.
      599   define variable mWaitFramStopUser           as logical     no-undo.
      600   define variable mWaitFramStopTimeOut        as logical     no-undo.
      601   define variable mWaitFramStartProc          as datetime-tz no-undo.
      602   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      603   define button B-WaitFramStop auto-end-key
      604        label "Стоп"
      605        size 10 by 1 tooltip "Остоновить процесс".
      606   define button B-viewProcInfo
      607        label "Информация"
      608        size 15 by 1 tooltip "Информация о процесс".
      609   define frame waitfram
      610     v-waitfram-action01 format "x(72)" no-label skip
      611     v-waitfram-action02 format "x(72)" no-label skip
      612     v-waitfram-action03 format "x(72)" no-label skip
      613     B-viewProcInfo
      614     B-WaitFramStop at row 4 col 30
      615     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      616     .
      617   define new global shared variable mBatchMode as logical no-undo init ?.
      618   define variable mFramBachModHandle as handle no-undo.
      619   mFramBachModHandle = frame waitfram:handle.
      620   define variable mFameOldVis as logical no-undo.
      621   define variable mVisCUrentVin as logical no-undo.
      622   if session:batch-mode
      623   then
      624      mBatchMode = yes.
      625   if mBatchMode = ? then do:
      626     mVisCUrentVin = current-window:visible.
      627     mFameOldVis = mFramBachModHandle:visible.
      628     mFramBachModHandle:visible  = yes.
      629     mBatchMode = mFramBachModHandle:visible ne yes.
      630     mFramBachModHandle:visible = mFameOldVis.
      631     current-window:visible = mVisCUrentVin.
      632   end.
      633    if  log-manager:logfile-name ne ?
      634     then DO:
      635         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      636         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      637         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      638     end.
      639   on choose of B-WaitFramStop in frame waitfram
      640   do:
      641     mWaitFramStop = yes.
      642     mWaitFramStopUser = yes.
      643   end.
      644   function waitfram-check-timeout returns logical():
      645      define variable vtime as int64 no-undo.
      646      if mWaitFramStopTimeOut
      647      then
      648         return yes.
      649      vtime = ( now - mWaitFramStartProc ) / 1000 .
      650      if     mWaitFramTimeOut ne ?
      651         and mWaitFramTimeOut ne 0
      652         and mWaitFramTimeOut lt vtime
      653      then do:
      654         mWaitFramStopTimeOut = yes.
      655      end.
      656      return mWaitFramStopTimeOut.
      657   end.
      658   procedure waitfram-hide :
      659     if not session:batch-mode
      660     then do
      661     on error undo, return error return-value
      662     :
      663       pause 0 before-hide .
      664       if not mBatchMode then
      665         hide frame waitfram .
      666     if     not mWaitFramView
      667        and mWaitProcEvent
      668     then
      669       process events .
      670     end.
      671   end procedure.
      672   procedure waitfram-show :
      673     define input  parameter p-message as character no-undo .
      674     define variable v-left-margin as integer   no-undo .
      675     if not session:batch-mode
      676     then do
      677     on error undo, return error return-value
      678     :
      679       if length(p-message) <= 70 then do:
      680         assign
      681           v-left-margin = integer((70 - length(p-message)) / 2)
      682         .
      683         assign
      684           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      685         .
      686         assign
      687           v-waitfram-action01 = " "
      688           v-waitfram-action02 = " "
      689                                    + fill(" ", v-left-margin)
      690                                    + p-message
      691           v-waitfram-action03 = " "
      692         .
      693       end.
      694       else do:
      695         define variable vRindex1 as integer no-undo.
      696         define variable vRindex2 as integer no-undo.
      697         vRindex1 = r-index(p-message," ",70).
      698         if vRindex1 = 0
      699         then
      700            vRindex1 = 70.
      701         if length(p-message)  <= vRindex1 + 70 then do:
      702           assign
      703             v-waitfram-action01 = " "
      704             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      705             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      706           .
      707         end.
      708         else do:
      709           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      710           if vRindex2 <= vRindex1
      711           then
      712              vRindex2 = vRindex1 + 70.
      713           assign
      714             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      715             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      716             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      717           .
      718         end.
      719       end.
      720       B-viewProcInfo:visible   in frame waitfram = no.
      721       B-viewProcInfo:sensitive in frame waitfram = no.
      722       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      723       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      724       if  (   mWaitFramView
      725          or  mWaitProcEvent)
      726          and not mBatchMode
      727       then
      728          display
      729             v-waitfram-action01 skip
      730             v-waitfram-action02 skip
      731             v-waitfram-action03 skip
      732          with frame waitfram .
      733       if     mWaitFramView
      734          then do:
      735             if     mWaitFramInterval ne ?
      736                and not mBatchMode
      737             then
      738                wait-for go of frame waitfram pause mWaitFramInterval.
      739          end.
      740          else
      741             if     mWaitProcEvent
      742                and not mBatchMode
      743             then
      744                process events .
      745     end.
      746   end procedure.
      747      procedure waitfram-show-this:
      748         define input  parameter iInterval as int64 no-undo.
      749         define variable vtime as int64 no-undo.
      750         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      751         mWaitFramInterval = iInterval.
      752         run waitfram-show (substitute("&1&2 &3&4" ,
      753                                       mWaitFramTextBeg ,
      754                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      755                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      756                                       mWaitFramTextEnd
      757                                      )
      758                           ).
      759      end.
      760      procedure WaitFramRunPause:
      761         define input  parameter iInterval as dec no-undo.
      762         define variable vStart  as datetime-tz no-undo.
      763         define variable vend    as datetime-tz no-undo.
      764         define variable vint as int64 no-undo.
      765         define variable vOk as logical no-undo.
      766         vStart = now.
      767         vend   = vStart.
      768         publish "WaitFramPause" (iInterval,output vOk).
      769         vend   =  now.
      770         vint = vend - vStart.
      771         vint = iInterval - vint / 1000.
      772         if     not mWaitFramStop
      773            and (   vint > 0
      774                 or (    not vOk
      775                     and iInterval eq ?
      776                     )
      777                 )
      778         then
      779            run waitfram-show-this (iInterval).
      780         vend   =  now.
      781         vint = vend - vStart.
      782         vint = iInterval - vint / 1000.
      783         if     not mWaitFramStop
      784            and vint > 0
      785         then do:
      786            run gbl/pause.p (vint * 1000).
      787         end.
      788         if iInterval ne ?
      789         then
      790            publish "WaitFramStop".
      791         waitfram-check-timeout().
      792      end.
      793      procedure WaitFramWaitFor:
      794         define input  parameter iInterval as dec no-undo.
      795         assign
      796            mWaitFramStartProc   = now
      797            mWaitFramStopUser    = no
      798            mWaitFramStopTimeOut = no
      799         .
      800         block-wait:
      801         do while not mWaitFramStop:
      802            run WaitFramRunPause (iInterval).
      803            if  waitfram-check-timeout()
      804            then do:
      805               leave block-wait.
      806            end.
      807         end.
      808         run waitfram-hide.
      809      end.
      810   procedure waitfram-join :
      811     define input  parameter p-line-1  as character no-undo .
      812     define input  parameter p-line-2  as character no-undo .
      813     define input  parameter p-line-3  as character no-undo .
      814     define output parameter p-message as character no-undo .
      815     do
      816     on error undo, return error return-value
      817     :
      818       assign
      819         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      820                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      821                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      822       .
      823     end.
      824   end procedure.
      825   function waitfram-join-function returns character
      826     (input p-line-1 as character
      827     ,input p-line-2 as character
      828     ,input p-line-3 as character
      829     ).
      830     define variable v-message as character no-undo .
      831     run waitfram-join in this-procedure
      832       (input  p-line-1
      833       ,input  p-line-2
      834       ,input  p-line-3
      835       ,output v-message
      836       ) .
      837     return v-message .
      838   end function .
      839   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      840     define variable v-cntxt-db-num        as integer   no-undo .
      841     define variable v-cntxt-userid        as character no-undo .
      842     define variable v-cntxt-level         as character no-undo .
      843     define variable v-cntxt-host-code-obj as integer   no-undo .
      844     define variable v-cntxt-obj-type      as character no-undo .
      845     define variable v-cntxt-obj-code      as integer   no-undo .
      846     define variable v-cntxt-db-num-obj    as integer   no-undo .
      847     define variable v-cntxt-is-admin      as logical   no-undo .
      848   define variable v-is-ptrl     as character no-undo.
      849   define variable v-data-type   as character no-undo.
      850   define variable is-petrol     as logical   no-undo initial ?.
      851   define variable is-pieces     as logical   no-undo initial ?.
      852   define variable is-kg-visible as logical   no-undo initial ?.
      853   define buffer buf_temp_prt-obj for temp_prt-obj .
      854   define buffer buf_goods        for ub.goods .
      855   define buffer buf_gds-prt      for ub.gds-prt .
      856   define variable p-need as decimal   no-undo .
      857   function f-on-line return decimal (buffer buf_temp_prt-obj for temp_prt-obj).
      858   define variable v-value      as character no-undo .
      859   define variable v-type       as character no-undo .
      860   define variable v-obj-db-num as integer   no-undo .
      861   define buffer bf_gds-obj for ub.gds-obj  .
      862   define buffer buf_db     for ub.db .
      863   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      864   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
      865     (input  buf_temp_prt-obj.obj-type
      866     ,input  buf_temp_prt-obj.obj-code
      867     ,output v-obj-db-num
      868     )  .
      869   find first bf_gds-obj where
      870             bf_gds-obj.obj-type = buf_temp_prt-obj.obj-type and
      871             bf_gds-obj.obj-code = buf_temp_prt-obj.obj-code and
      872             bf_gds-obj.gds-code = buf_goods.gds-code
      873             no-error .
      874   find first buf_db no-lock where
      875              buf_db.db-num = v-obj-db-num
      876              .
      877   if v-obj-db-num = g#db-num then do:
      878      if available bf_gds-obj then
      879          return bf_gds-obj.free-qnty .
      880      else
      881          return ? .
      882   end.
      883   else do:
      884      if available bf_gds-obj
      885        and buf_db.on-line-rest = true
      886      then
      887          return bf_gds-obj.on-line-rest .
      888      else
      889          return ? .
      890   end.
      891   end function.
