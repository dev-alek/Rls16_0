      937        FGCOLOR 4  NO-UNDO.
      938   DEFINE RECTANGLE RECT-1
      939        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      940        SIZE 77.50 BY 2.79.
      941   DEFINE QUERY br-prt-obj FOR
      942         buf_temp_prt-obj SCROLLING.
      943   DEFINE BROWSE br-prt-obj
      944     QUERY br-prt-obj NO-LOCK DISPLAY
      945         (buf_temp_prt-obj.obj-type + " " + string (buf_temp_prt-obj.obj-code, "99999"))
      946                                      column-label "Объект"           format "x(9)":U
      947         buf_temp_prt-obj.obj-name    column-label "Название объекта" format "x(25)":U
      948         f-on-line( buffer buf_temp_prt-obj ) @ p-need  column-label "On-line Ост."   format "->,>>>,>>9.<<<":U
      949         buf_temp_prt-obj.qnty        column-label "Количество"
      950         buf_temp_prt-obj.free-qnty   column-label "Свободно"
