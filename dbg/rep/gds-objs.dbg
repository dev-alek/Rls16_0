      971        FI-Filter-Label AT ROW  4.50 COL  1.75               NO-LABEL
      972        RECT-1          AT ROW  1.25 COL 21.38 SPACE( 0.98 ) SKIP( 16.78 )
      973   WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER SIDE-LABELS NO-UNDERLINE THREE-D SCROLLABLE
      974        TITLE "Остатки по признаку" CANCEL-BUTTON b-quit.
      975   ASSIGN
      976          FRAME d-gds-objs:SCROLLABLE       = FALSE
      977          FRAME d-gds-objs:HIDDEN           = TRUE.
      978   ASSIGN
      979          br-prt-obj:NUM-LOCKED-COLUMNS IN FRAME d-gds-objs     = 1.
      980   ON WINDOW-CLOSE OF FRAME d-gds-objs
      981   DO:
      982     APPLY "END-ERROR":U TO SELF.
      983   END.
      984   ON VALUE-CHANGED OF br-prt-obj IN FRAME d-gds-objs
      985   DO:
      986     define buffer host-b for ub.clients.
      987     if not available buf_temp_prt-obj then do: return no-apply. end.
      988     if buf_temp_prt-obj.obj-type = 'скл':U then do:
      989       find ub.store no-lock where ub.store.obj-code = buf_temp_prt-obj.obj-code.
      990       find host-b   no-lock where
      991            host-b.obj-type = 'орг':U and
      992            host-b.obj-code = ub.store.host-code.
      993     end.
      994     else do:
      995       find ub.shop no-lock where ub.shop.obj-code = buf_temp_prt-obj.obj-code.
      996       find host-b  no-lock where
      997            host-b.obj-type = 'орг':U and
      998            host-b.obj-code = ub.shop.host-code.
      999     end.
     1000     assign  firm-name = host-b.obj-name.
     1001     display firm-name with frame d-gds-objs.
     1002   END.
     1003   ON VALUE-CHANGED OF rs-firm-global IN FRAME d-gds-objs
     1004   DO:
     1005     define variable is-glob as logical no-undo.
     1006     assign rs-firm-global.
     1007     if rs-firm-global = "global"
     1008     then do:
     1009   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1010   do:
     1011     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1012       (input  v-cntxt-db-num
     1013       ,input  v-cntxt-userid
     1014       ,input  0
     1015       ,input  'actn_documents_all':U
     1016       ,input  'global':U
     1017       ,input  0
     1018       ,input  '':U
     1019       ,input  0
     1020       ,input  0
     1021       ,input  0
     1022       ,input  0
     1023       ,input  true
     1024       ,output is-glob
     1025       )  .
     1026   end.
     1027       if is-glob = no then do: assign rs-firm-global = "firm". end.
     1028     end.
     1029     run UI-on in this-procedure .
     1030   END.
     1031   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-gds-objs:PARENT eq ?
     1032   THEN FRAME d-gds-objs:PARENT = ACTIVE-WINDOW.
     1033   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1034   on help of frame d-gds-objs
     1035   do:
     1036     run gbl/app_help.p
     1037       (input this-procedure :file-name
     1038       ,input ''
     1039       ,input ?
     1040       ) no-error.
     1041     if error-status :error then do:
     1042       message
     1043         "Ошибка при вызове помощи"
     1044         error-status :get-message(1)
     1045         view-as alert-box .
     1046     end.
     1047   end.
     1048   run minbtn-set in this-procedure .
     1049   on choose of b-help in frame d-gds-objs
     1050   do:
     1051     apply "help":u to frame d-gds-objs .
     1052   end.
     1053   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1054   procedure minbtn-set :
     1055       do
     1056           on error undo, return error return-value
     1057           :
     1058           define variable ii              as integer       no-undo .
     1059           define variable fh              as widget-handle no-undo .
     1060           define variable hh              as widget-handle no-undo .
     1061           define variable v-h             as handle        extent 4 no-undo .
     1062           define variable v-name-button   as character     no-undo .
     1063           define variable v-help-old-x    as decimal       no-undo .
     1064           define variable v-help-old-y    as decimal       no-undo .
     1065           define variable v-help-old-size as decimal       no-undo .
     1066           define variable v-frame-width   as decimal       no-undo .
     1067           define variable jj              as integer       no-undo .
     1068           do
     1069               on error undo, return error
     1070               :
     1071               assign
     1072                   v-frame-width = frame d-gds-objs:width - 0.3
     1073                   fh            = frame d-gds-objs:first-child
     1074                   hh            = fh:first-child
     1075                   ii            = 1
     1076                   .
     1077               do while valid-handle(hh):
     1078                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1079                   do:
     1080                       case lc(hh:name) :
     1081                           when "b-help" then
     1082                               do:
     1083                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1084                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1085                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1086                                   hh:TOOLTIP = "Помощь" .
     1087                                   v-help-old-x = hh:column .
     1088                                   v-help-old-y = hh:row    .
     1089                                   v-help-old-size = hh:width .
     1090                                   hh:width-chars = 2.5 .
     1091                               end.
     1092                           when "b-print" then
     1093                               do:
     1094                                   hh:load-image("cmp/b-print.bmp":u) .
     1095                                   hh:TOOLTIP = "Печать" .
     1096                                   v-h[ii] = hh:handle .
     1097                                   ii = ii + 1 .
     1098                                   hh:width-chars = 3 .
     1099                               end.
     1100                           when "b-history" or
     1101                           when "b-hist" then
     1102                               do:
     1103                                   hh:load-image("cmp/b-hist.bmp":u) .
     1104                                   hh:TOOLTIP = "История" .
     1105                                   v-h[ii] = hh:handle .
     1106                                   ii = ii + 1 .
     1107                                   hh:width-chars = 3 .
     1108                               end.
     1109                           when "b-sch" then
     1110                               do:
     1111                                   hh:load-image("cmp/b-sch.bmp":u) .
     1112                                   hh:TOOLTIP = "Установка Фильтра" .
     1113                                   v-h[ii] = hh:handle .
     1114                                   ii = ii + 1 .
     1115                                   hh:width-chars = 3 .
     1116                               end.
     1117                           when "b-hist-user" then
     1118                               do:
     1119                                   hh:load-image("cmp/b-hist.bmp":u) .
     1120                                   hh:TOOLTIP = "История пользователя" .
     1121                                   ii = ii + 1 .
     1122                               end.
     1123                       end case.
     1124                   end.
     1125                   hh = hh:next-sibling.
     1126               end.
     1127               b-help:column = v-frame-width - b-help:width-chars.
     1128               jj = 0.
     1129               repeat ii = 4 to 1 by -1 :
     1130                   if valid-handle (v-h[ii] ) then
     1131                   do:
     1132                       jj  = jj + 1 .
     1133                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1134                       v-h[ii]:row    = v-help-old-y .
     1135                   end.
     1136               end.
     1137           end.
     1138       end.
     1139   end procedure.
     1140   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1141   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1142   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1143   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1144   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1145   define variable v-diasize-current-frame-height as decimal   no-undo .
     1146   define variable v-diasize-change-size          as logical   no-undo .
     1147   define variable v-diasize-resize-button        as handle    no-undo .
     1148   define variable v-diasize-wndmax               as logical   no-undo .
     1149   define variable v-diasize-wndstore             as logical   no-undo .
     1150   define variable v-diasize-proc-name            as character no-undo .
     1151   define variable v-diasize-browse-handle        as handle    no-undo .
     1152   define variable v-diasize-browse-number        as integer   no-undo .
     1153   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1154   define temp-table temp-diasize-handle no-undo
     1155     field handle-value  as handle
     1156     field save-position as decimal
     1157     index xpk is primary unique handle-value
     1158     .
     1159   define temp-table temp-browse-handle no-undo
     1160     field browse-type   as character
     1161     field browse-number as integer
     1162     field browse-handle as handle
     1163     field original-size as decimal
     1164     index xpk is primary unique browse-type browse-number
     1165     index xie browse-type browse-handle
     1166   .
     1167   procedure diasize_change-height :
     1168     define input  parameter p-change-value  as decimal   no-undo .
     1169     define input  parameter p-move-resize   as logical   no-undo .
     1170     define variable v-field-group-handle    as handle    no-undo .
     1171     define variable v-object-handle         as handle    no-undo .
     1172     define variable v-frame-height          as decimal   no-undo .
     1173     define variable v-frame-virtual-height  as decimal   no-undo .
     1174     define variable v-browse-height         as decimal   no-undo .
     1175     define variable v-window-height         as decimal   no-undo .
     1176     define variable v-window-virtual-height as decimal   no-undo .
     1177     define variable v-change-sign           as integer   no-undo .
     1178     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1179     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1180     if p-change-value > 0
     1181     then do:
     1182       if frame d-gds-objs :height + p-change-value
     1183           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1184       then do:
     1185         assign
     1186           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1187                           - (frame d-gds-objs :height-chars)
     1188         .
     1189         if p-change-value <= 0
     1190         then do:
     1191           run diasize_position-resize-button in this-procedure .
     1192           return .
     1193         end.
     1194       end.
     1195     end.
     1196     if p-change-value < 0
     1197     then do:
     1198       if frame d-gds-objs :height + p-change-value < v-diasize-orig-frame-height
     1199       then do:
     1200         assign
     1201           p-change-value = v-diasize-orig-frame-height
     1202                          - (frame d-gds-objs :height-chars)
     1203         .
     1204         if p-change-value >= 0
     1205         then do:
     1206           run diasize_position-resize-button in this-procedure .
     1207           return .
     1208         end.
     1209       end.
     1210     end.
     1211     if p-change-value >= 0
     1212     then do:
     1213       assign
     1214         v-change-sign = 1
     1215       .
     1216     end.
     1217     else do:
     1218       assign
     1219         v-change-sign = -1
     1220       .
     1221     end.
     1222     assign
     1223       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1224     .
     1225     if p-change-value = 0
     1226     then do:
     1227       run diasize_position-resize-button in this-procedure .
     1228       return .
     1229     end.
     1230     move_block:
     1231     do
     1232     on error undo move_block, retry move_block
     1233     :
     1234       if retry
     1235       then do:
     1236         do
     1237         on error undo move_block, leave move_block
     1238         :
     1239           if p-change-value > 0
     1240           then do:
     1241             for each buf_temp-diasize-handle
     1242             on error undo, next
     1243             :
     1244               assign
     1245                 v-object-handle = buf_temp-diasize-handle.handle-value
     1246               .
     1247               if v-object-handle <> v-diasize-resize-button
     1248               then do:
     1249                 assign
     1250                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1251                 .
     1252               end.
     1253             end.
     1254             assign
     1255               v-diasize-browse-handle :height = v-browse-height
     1256             .
     1257             for each buf_temp-browse-handle
     1258               where buf_temp-browse-handle.browse-type = 'height':u
     1259             on error undo, next
     1260             :
     1261               assign
     1262                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1263               .
     1264             end.
     1265             assign
     1266               frame d-gds-objs :height = v-frame-height
     1267             .
     1268             if frame d-gds-objs :scrollable = true
     1269             then do:
     1270               assign
     1271                 frame d-gds-objs :virtual-height = v-frame-virtual-height
     1272               .
     1273             end.
     1274             run diasize_position-resize-button in this-procedure .
     1275           end.
     1276           else do:
     1277             if frame d-gds-objs :scrollable = true
     1278             then do:
     1279               assign
     1280                 frame d-gds-objs :virtual-height = v-frame-virtual-height
     1281               .
     1282             end.
     1283             assign
     1284               frame d-gds-objs :height = v-frame-height
     1285             .
     1286             assign
     1287               v-diasize-browse-handle :height = v-browse-height
     1288             .
     1289             for each buf_temp-browse-handle
     1290               where buf_temp-browse-handle.browse-type = 'height':u
     1291             on error undo, next
     1292             :
     1293               assign
     1294                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1295               .
     1296             end.
     1297             for each buf_temp-diasize-handle
     1298             on error undo, next
     1299             :
     1300               assign
     1301                 v-object-handle = buf_temp-diasize-handle.handle-value
     1302               .
     1303               if v-object-handle <> v-diasize-resize-button
     1304               then do:
     1305                 assign
     1306                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1307                 .
     1308               end.
     1309             end.
     1310             run diasize_position-resize-button in this-procedure .
     1311           end.
     1312           assign
     1313             v-diasize-change-size = false
     1314           .
     1315           leave move_block .
     1316         end.
     1317       end.
     1318       assign
     1319         v-diasize-need-full-display = true
     1320       .
     1321       if v-diasize-change-size = false
     1322       then do:
     1323         assign
     1324           v-diasize-change-size = true
     1325         .
     1326       end.
     1327       else do:
     1328         return .
     1329       end.
     1330       assign
     1331         v-frame-height = frame d-gds-objs :height
     1332         v-frame-virtual-height = frame d-gds-objs :virtual-height
     1333         v-browse-height = v-diasize-browse-handle :height
     1334       .
     1335       for each buf_temp-browse-handle
     1336         where buf_temp-browse-handle.browse-type = 'height':u
     1337       :
     1338         assign
     1339           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1340         .
     1341       end.
     1342       for each buf_temp-diasize-handle
     1343       :
     1344         delete buf_temp-diasize-handle .
     1345       end.
     1346       assign
     1347         v-field-group-handle = frame d-gds-objs :first-child
     1348       .
     1349       do while valid-handle(v-field-group-handle)
     1350       :
     1351         assign
     1352           v-object-handle = v-field-group-handle :first-child
     1353         .
     1354         do while valid-handle(v-object-handle)
     1355         :
     1356           if  v-object-handle <> v-diasize-browse-handle :handle
     1357           and can-query(v-object-handle, "row")
     1358           and can-query(v-object-handle, "height")
     1359           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1360           then do:
     1361             find first buf_temp-browse-handle
     1362               where buf_temp-browse-handle.browse-type   = 'height':u
     1363                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1364               no-error .
     1365             if available buf_temp-browse-handle
     1366             then do:
     1367             end.
     1368             else do:
     1369               create buf_temp-diasize-handle .
     1370               assign
     1371                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1372                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1373               .
     1374             end.
     1375           end.
     1376           assign
     1377             v-object-handle = v-object-handle :next-sibling
     1378           .
     1379         end.
     1380         assign
     1381           v-field-group-handle = v-field-group-handle :next-sibling
     1382         .
     1383       end.
     1384       do with frame d-gds-objs
     1385       :
     1386         hide v-diasize-resize-button .
     1387         assign
     1388           v-diasize-resize-button :row    = 1
     1389           v-diasize-resize-button :column = 1
     1390         .
     1391       end.
     1392       if p-change-value > 0
     1393       then do:
     1394         if frame d-gds-objs :scrollable = true
     1395         then do:
     1396           assign
     1397             frame d-gds-objs :virtual-height = frame d-gds-objs :virtual-height + p-change-value
     1398             no-error .
     1399           if error-status :error
     1400           or error-status :get-message(1) <> ""
     1401           then do:
     1402             undo move_block, retry move_block .
     1403           end.
     1404         end.
     1405         assign
     1406           frame d-gds-objs :height = frame d-gds-objs :height + p-change-value
     1407           no-error .
     1408         if error-status :error
     1409         or error-status :get-message(1) <> ""
     1410         then do:
     1411           undo move_block, retry move_block .
     1412         end.
     1413         assign
     1414           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1415           no-error .
     1416         if error-status :error
     1417         or error-status :get-message(1) <> ""
     1418         then do:
     1419           undo move_block, retry move_block .
     1420         end.
     1421         for each buf_temp-browse-handle
     1422           where buf_temp-browse-handle.browse-type = 'height':u
     1423         on error undo move_block, retry move_block
     1424         :
     1425           assign
     1426             buf_temp-browse-handle.browse-handle :height
     1427               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1428             no-error .
     1429           if error-status :error
     1430           or error-status :get-message(1) <> ""
     1431           then do:
     1432             undo move_block, retry move_block .
     1433           end.
     1434         end.
     1435         for each buf_temp-diasize-handle
     1436         on error undo move_block, retry move_block
     1437         :
     1438           assign
     1439             v-object-handle = buf_temp-diasize-handle.handle-value
     1440           .
     1441           if v-object-handle <> v-diasize-resize-button
     1442           then do:
     1443             assign
     1444               v-object-handle :row = v-object-handle :row + p-change-value
     1445               no-error .
     1446             if error-status :error
     1447             or error-status :get-message(1) <> ""
     1448             then do:
     1449               undo move_block, retry move_block .
     1450             end.
     1451           end.
     1452         end.
     1453       end.
     1454       else do:
     1455         for each buf_temp-diasize-handle
     1456         on error undo move_block, retry move_block
     1457         :
     1458           assign
     1459             v-object-handle = buf_temp-diasize-handle.handle-value
     1460           .
     1461           if v-object-handle <> v-diasize-resize-button
     1462           then do:
     1463             assign
     1464               v-object-handle :row = v-object-handle :row + p-change-value
     1465               no-error .
     1466             if error-status :error
     1467             or error-status :get-message(1) <> ""
     1468             then do:
     1469               undo move_block, retry move_block .
     1470             end.
     1471           end.
     1472         end.
     1473         assign
     1474           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1475           no-error .
     1476         if error-status :error
     1477         or error-status :get-message(1) <> ""
     1478         then do:
     1479           undo move_block, retry move_block .
     1480         end.
     1481         for each buf_temp-browse-handle
     1482           where buf_temp-browse-handle.browse-type = 'height':u
     1483         on error undo move_block, retry move_block
     1484         :
     1485           assign
     1486             buf_temp-browse-handle.browse-handle :height
     1487               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1488             no-error .
     1489           if error-status :error
     1490           or error-status :get-message(1) <> ""
     1491           then do:
     1492             undo move_block, retry move_block .
     1493           end.
     1494         end.
     1495         assign
     1496           frame d-gds-objs :height = frame d-gds-objs :height + p-change-value
     1497           no-error .
     1498         if error-status :error
     1499         or error-status :get-message(1) <> ""
     1500         then do:
     1501           undo move_block, retry move_block .
     1502         end.
     1503         if frame d-gds-objs :scrollable = true
     1504         then do:
     1505           assign
     1506             frame d-gds-objs :virtual-height = frame d-gds-objs :virtual-height + p-change-value
     1507             no-error .
     1508           if error-status :error
     1509           or error-status :get-message(1) <> ""
     1510           then do:
     1511             undo move_block, retry move_block .
     1512           end.
     1513         end.
     1514       end.
     1515       if p-move-resize = true
     1516       then do:
     1517         run diasize_position-resize-button in this-procedure .
     1518       end.
     1519       if v-diasize-wndstore = true
     1520       then do:
     1521         if connected("ub") = true
     1522         then do:
     1523           define variable v-cntxt-db-num        as integer   no-undo .
     1524           define variable v-cntxt-userid        as character no-undo .
     1525           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1526                                             , OUTPUT v-cntxt-userid
     1527                                             ) .
     1528           run gbl/wndsizew.p
     1529             (input  v-cntxt-db-num
     1530             ,input  v-cntxt-userid
     1531             ,input  v-diasize-proc-name
     1532             ,input  'height':u
     1533             ,input  string(frame d-gds-objs :height - v-diasize-orig-frame-height)
     1534             ) .
     1535         end.
     1536       end.
     1537     end.
     1538     assign
     1539       v-diasize-change-size = false
     1540     .
     1541   end procedure.
     1542   procedure diasize_set-height :
     1543     define input  parameter p-new-height  as decimal   no-undo .
     1544     define input  parameter p-move-resize as logical   no-undo .
     1545     do
     1546     on error undo, return error return-value
     1547     :
     1548       run diasize_change-height in this-procedure
     1549         (input  (p-new-height - frame d-gds-objs :height)
     1550         ,input  p-move-resize
     1551         ) .
     1552     end.
     1553   end procedure.
     1554   procedure diasize_change-width :
     1555     define input  parameter p-change-value as decimal   no-undo .
     1556     define input  parameter p-move-resize  as logical   no-undo .
     1557     define variable v-field-group-handle   as handle    no-undo .
     1558     define variable v-object-handle        as handle    no-undo .
     1559     define variable v-frame-width          as decimal   no-undo .
     1560     define variable v-frame-virtual-width  as decimal   no-undo .
     1561     define variable v-browse-width         as decimal   no-undo .
     1562     define variable v-window-width         as decimal   no-undo .
     1563     define variable v-window-virtual-width as decimal   no-undo .
     1564     define variable v-change-sign          as integer   no-undo .
     1565     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1566     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1567     if p-change-value > 0
     1568     then do:
     1569       if frame d-gds-objs :width + p-change-value >
     1570           session :width-chars
     1571       then do:
     1572         assign
     1573           p-change-value = session :width-chars - frame d-gds-objs :width
     1574         .
     1575         if p-change-value <= 0
     1576         then do:
     1577           run diasize_position-resize-button in this-procedure .
     1578           return .
     1579         end.
     1580       end.
     1581     end.
     1582     if p-change-value < 0
     1583     then do:
     1584       if frame d-gds-objs :width + p-change-value < v-diasize-orig-frame-width
     1585       then do:
     1586         assign
     1587           p-change-value = v-diasize-orig-frame-width
     1588                          - frame d-gds-objs :width
     1589         .
     1590         if p-change-value >= 0
     1591         then do:
     1592           run diasize_position-resize-button in this-procedure .
     1593           return .
     1594         end.
     1595       end.
     1596     end.
     1597     if p-change-value >= 0
     1598     then do:
     1599       assign
     1600         v-change-sign = 1
     1601       .
     1602     end.
     1603     else do:
     1604       assign
     1605         v-change-sign = -1
     1606       .
     1607     end.
     1608     assign
     1609       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1610     .
     1611     if p-change-value = 0
     1612     then do:
     1613       run diasize_position-resize-button in this-procedure .
     1614       return .
     1615     end.
     1616     move_block:
     1617     do
     1618     on error undo move_block, leave move_block
     1619     :
     1620       if retry
     1621       then do:
     1622         do
     1623         on error undo move_block, leave move_block
     1624         :
     1625           if p-change-value > 0
     1626           then do:
     1627             for each buf_temp-diasize-handle
     1628             on error undo, next
     1629             :
     1630               assign
     1631                 v-object-handle = buf_temp-diasize-handle.handle-value
     1632               .
     1633               if v-object-handle <> v-diasize-resize-button
     1634               then do:
     1635                 assign
     1636                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1637                 .
     1638               end.
     1639             end.
     1640             assign
     1641               v-diasize-browse-handle :width = v-browse-width
     1642             .
     1643             for each buf_temp-browse-handle
     1644               where buf_temp-browse-handle.browse-type = 'width':u
     1645             on error undo, next
     1646             :
     1647               assign
     1648                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1649               .
     1650             end.
     1651             assign
     1652               frame d-gds-objs :width = v-frame-width
     1653             .
     1654             if frame d-gds-objs :scrollable = true
     1655             then do:
     1656               assign
     1657                 frame d-gds-objs :virtual-width = v-frame-virtual-width
     1658               .
     1659             end.
     1660             run diasize_position-resize-button in this-procedure .
     1661           end.
     1662           else do:
     1663             if frame d-gds-objs :scrollable = true
     1664             then do:
     1665               assign
     1666                 frame d-gds-objs :virtual-width = v-frame-virtual-width
     1667               .
     1668             end.
     1669             assign
     1670               frame d-gds-objs :width = v-frame-width
     1671             .
     1672             for each buf_temp-browse-handle
     1673               where buf_temp-browse-handle.browse-type = 'width':u
     1674             on error undo, next
     1675             :
     1676               assign
     1677                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1678               .
     1679             end.
     1680             assign
     1681               v-diasize-browse-handle :width = v-browse-width
     1682             .
     1683             for each buf_temp-diasize-handle
     1684             on error undo, next
     1685             :
     1686               assign
     1687                 v-object-handle = buf_temp-diasize-handle.handle-value
     1688               .
     1689               if v-object-handle <> v-diasize-resize-button
     1690               then do:
     1691                 assign
     1692                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1693                 .
     1694               end.
     1695             end.
     1696             run diasize_position-resize-button in this-procedure .
     1697           end.
     1698           assign
     1699             v-diasize-change-size = false
     1700           .
     1701           leave move_block .
     1702         end.
     1703       end.
     1704       assign
     1705         v-diasize-need-full-display = true
     1706       .
     1707       if v-diasize-change-size = false
     1708       then do:
     1709         assign
     1710           v-diasize-change-size = true
     1711         .
     1712       end.
     1713       else do:
     1714         return .
     1715       end.
     1716       assign
     1717         v-frame-width = frame d-gds-objs :width
     1718         v-frame-virtual-width = frame d-gds-objs :virtual-width
     1719         v-browse-width = v-diasize-browse-handle :width
     1720       .
     1721       for each buf_temp-browse-handle
     1722         where buf_temp-browse-handle.browse-type = 'width':u
     1723       :
     1724         assign
     1725           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1726         .
     1727       end.
     1728       for each buf_temp-diasize-handle
     1729       :
     1730         delete buf_temp-diasize-handle .
     1731       end.
     1732       assign
     1733         v-field-group-handle = frame d-gds-objs :first-child
     1734       .
     1735       do while valid-handle(v-field-group-handle)
     1736       :
     1737         assign
     1738           v-object-handle = v-field-group-handle :first-child
     1739         .
     1740         do while valid-handle(v-object-handle)
     1741         :
     1742           if  v-object-handle <> v-diasize-browse-handle :handle
     1743           and v-object-handle <> v-diasize-resize-button
     1744           and can-query(v-object-handle, "row")
     1745           and can-query(v-object-handle, "height")
     1746           and ( v-object-handle :col + v-object-handle :width
     1747                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1748               )
     1749           then do:
     1750             find first buf_temp-browse-handle
     1751               where buf_temp-browse-handle.browse-type   = 'width':u
     1752                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1753               no-error .
     1754             if available buf_temp-browse-handle
     1755             then do:
     1756             end.
     1757             else do:
     1758               create buf_temp-diasize-handle .
     1759               assign
     1760                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1761                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1762               .
     1763             end.
     1764           end.
     1765           assign
     1766             v-object-handle = v-object-handle :next-sibling
     1767           .
     1768         end.
     1769         assign
     1770           v-field-group-handle = v-field-group-handle :next-sibling
     1771         .
     1772       end.
     1773       do with frame d-gds-objs
     1774       :
     1775         hide v-diasize-resize-button .
     1776         v-diasize-resize-button :row = 1.
     1777         v-diasize-resize-button :column = 1.
     1778       end.
     1779       if p-change-value > 0
     1780       then do:
     1781         if frame d-gds-objs :scrollable = true
     1782         then do:
     1783           assign
     1784             frame d-gds-objs :virtual-width = frame d-gds-objs :virtual-width + p-change-value
     1785             no-error .
     1786           if error-status :error
     1787           or error-status :get-message(1) <> ""
     1788           then do:
     1789             undo move_block, retry move_block.
     1790           end.
     1791         end.
     1792         assign
     1793           frame d-gds-objs :width = v-frame-width + p-change-value
     1794           no-error .
     1795         if error-status :error
     1796         or error-status :get-message(1) <> ""
     1797         then do:
     1798           undo move_block, retry move_block.
     1799         end.
     1800         assign
     1801           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1802         no-error .
     1803         if error-status :error
     1804         or error-status :get-message(1) <> ""
     1805         then do:
     1806           undo move_block, retry move_block.
     1807         end.
     1808         for each buf_temp-browse-handle
     1809           where buf_temp-browse-handle.browse-type = 'width':u
     1810         on error undo move_block, retry move_block
     1811         :
     1812           assign
     1813             buf_temp-browse-handle.browse-handle :width
     1814               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1815             no-error .
     1816           if error-status :error
     1817           or error-status :get-message(1) <> ""
     1818           then do:
     1819             undo move_block, retry move_block .
     1820           end.
     1821         end.
     1822         for each buf_temp-diasize-handle
     1823         on error undo move_block, retry move_block
     1824         :
     1825           assign
     1826             v-object-handle = buf_temp-diasize-handle.handle-value
     1827           .
     1828           if v-object-handle <> v-diasize-resize-button
     1829           then do:
     1830             assign
     1831               v-object-handle :col = v-object-handle :col + p-change-value
     1832               no-error .
     1833             if error-status :error
     1834             or error-status :get-message(1) <> ""
     1835             then do:
     1836               undo move_block, retry move_block .
     1837             end.
     1838           end.
     1839         end.
     1840       end.
     1841       else do:
     1842         for each buf_temp-diasize-handle
     1843         on error undo move_block, retry move_block
     1844         :
     1845           assign
     1846             v-object-handle = buf_temp-diasize-handle.handle-value
     1847           .
     1848           if v-object-handle <> v-diasize-resize-button
     1849           then do:
     1850             assign
     1851               v-object-handle :col = v-object-handle :col + p-change-value
     1852               no-error .
     1853             if error-status :error
     1854             or error-status :get-message(1) <> ""
     1855             then do:
     1856               undo move_block, retry move_block .
     1857             end.
     1858           end.
     1859         end.
     1860         for each buf_temp-browse-handle
     1861           where buf_temp-browse-handle.browse-type = 'width':u
     1862         on error undo move_block, retry move_block
     1863         :
     1864           assign
     1865             buf_temp-browse-handle.browse-handle :width
     1866               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1867             no-error .
     1868           if error-status :error
     1869           or error-status :get-message(1) <> ""
     1870           then do:
     1871             undo move_block, retry move_block .
     1872           end.
     1873         end.
     1874         assign
     1875           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1876           no-error .
     1877         if error-status :error
     1878         or error-status :get-message(1) <> ""
     1879         then do:
     1880           undo move_block, retry move_block.
     1881         end.
     1882         assign
     1883           frame d-gds-objs :width = frame d-gds-objs :width + p-change-value
     1884         no-error .
     1885         if error-status :error
     1886         or error-status :get-message(1) <> ""
     1887         then do:
     1888           undo move_block, retry move_block.
     1889         end.
     1890         if frame d-gds-objs :scrollable = true
     1891         then do:
     1892           assign
     1893             frame d-gds-objs :virtual-width = frame d-gds-objs :virtual-width + p-change-value
     1894           no-error .
     1895           if error-status :error
     1896           or error-status :get-message(1) <> ""
     1897           then do:
     1898             undo move_block, retry move_block.
     1899           end.
     1900         end.
     1901       end.
     1902       if p-move-resize
     1903       then do:
     1904         run diasize_position-resize-button in this-procedure .
     1905       end.
     1906       if v-diasize-wndstore = true
     1907       then do:
     1908         if connected("ub") = true
     1909         then do:
     1910           define variable v-cntxt-db-num        as integer   no-undo .
     1911           define variable v-cntxt-userid        as character no-undo .
     1912           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1913                                             , OUTPUT v-cntxt-userid
     1914                                             ) .
     1915           run gbl/wndsizew.p
     1916             (input  v-cntxt-db-num
     1917             ,input  v-cntxt-userid
     1918             ,input  v-diasize-proc-name
     1919             ,input  'width':u
     1920             ,input  string(frame d-gds-objs :width - v-diasize-orig-frame-width)
     1921             ) .
     1922         end.
     1923       end.
     1924     end.
     1925     assign
     1926       v-diasize-change-size = false
     1927     .
     1928   end procedure.
     1929   procedure diasize_set-width :
     1930     define input  parameter p-new-width  as decimal   no-undo .
     1931     define input  parameter p-move-resize as logical   no-undo .
     1932     do
     1933     on error undo, return error return-value
     1934     :
     1935       run diasize_change-width in this-procedure
     1936         (input  (p-new-width - frame d-gds-objs :width)
     1937         ,input  p-move-resize
     1938         ) .
     1939     end.
     1940   end procedure.
     1941   procedure diasize_position-resize-button :
     1942     do with frame d-gds-objs
     1943     :
     1944       hide v-diasize-resize-button .
     1945       assign
     1946         v-diasize-resize-button :row = frame d-gds-objs :height - v-diasize-resize-button :height
     1947                     - 1
     1948                     - (frame d-gds-objs :border-bottom-pixels / session :pixels-per-row)
     1949         v-diasize-resize-button :col = frame d-gds-objs :width - v-diasize-resize-button :width
     1950                     - 1
     1951                     - (frame d-gds-objs :border-right-pixels / session :pixels-per-column)
     1952       .
     1953       view v-diasize-resize-button .
     1954     end.
     1955   end procedure.
     1956   on alt-right anywhere
     1957   do:
     1958     run diasize_change-width in this-procedure
     1959       (input 1
     1960       ,input true
     1961       ) .
     1962     return no-apply .
     1963   end.
     1964   on alt-left anywhere
     1965   do:
     1966     run diasize_change-width in this-procedure
     1967       (input -1
     1968       ,input true
     1969       ) .
     1970     return no-apply .
     1971   end.
     1972   on alt-down anywhere
     1973   do:
     1974     run diasize_change-height in this-procedure
     1975       (input 1
     1976       ,input true
     1977       ) .
     1978     return no-apply .
     1979   end.
     1980   on alt-up anywhere
     1981   do:
     1982     run diasize_change-height in this-procedure
     1983       (input -1
     1984       ,input true
     1985       ) .
     1986     return no-apply .
     1987   end.
     1988   on alt-enter of frame d-gds-objs
     1989   do:
     1990     run diasize_maximize in this-procedure
     1991       (input  ?
     1992       ).
     1993     return no-apply .
     1994   end.
     1995   procedure diasize_end-move :
     1996     do
     1997     on error undo, return error return-value
     1998     :
     1999       define variable v-row-delta as decimal   no-undo .
     2000       define variable v-col-delta as decimal   no-undo .
     2001       define variable v-new-row as decimal   no-undo .
     2002       define variable v-new-col as decimal   no-undo .
     2003       assign
     2004         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2005         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2006       .
     2007       assign
     2008         v-row-delta = v-new-row - frame d-gds-objs :height
     2009         v-col-delta = v-new-col - frame d-gds-objs :width
     2010       .
     2011       run diasize_change-height in this-procedure
     2012         (input v-row-delta
     2013         ,input true
     2014         ) .
     2015       run diasize_change-width in this-procedure
     2016         (input v-col-delta
     2017         ,input true
     2018         ) .
     2019     end.
     2020   end procedure.
     2021   procedure diasize_maximize :
     2022     define input  parameter p-action as logical   no-undo .
     2023     do
     2024     on error undo, return error return-value
     2025     :
     2026       if p-action = ?
     2027       then do:
     2028         if v-diasize-need-maximize = true
     2029         then do:
     2030           assign
     2031             p-action = true
     2032           .
     2033         end.
     2034         else do:
     2035           assign
     2036             p-action = false
     2037           .
     2038         end.
     2039       end.
     2040       if p-action = true
     2041       then do:
     2042         run diasize_change-height in this-procedure
     2043           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2044               - frame d-gds-objs :height-chars
     2045           ,input true
     2046           ) .
     2047         run diasize_change-width in this-procedure
     2048           (input session :width-chars
     2049               - frame d-gds-objs :width-chars
     2050           ,input true
     2051           ) .
     2052         assign
     2053           v-diasize-need-maximize = false
     2054         .
     2055       end.
     2056       else do:
     2057         run diasize_change-width in this-procedure
     2058           (input v-diasize-orig-frame-width
     2059               - frame d-gds-objs :width-chars
     2060           ,input true
     2061           ) .
     2062         run diasize_change-height in this-procedure
     2063           (input v-diasize-orig-frame-height
     2064               - frame d-gds-objs :height-chars
     2065           ,input true
     2066           ) .
     2067         assign
     2068           v-diasize-need-maximize = true
     2069         .
     2070       end.
     2071     end.
     2072   end procedure.
     2073   procedure diasize_restore-orig-size :
     2074     do
     2075     on error undo, return error return-value
     2076     :
     2077       assign
     2078         v-diasize-current-frame-width  = frame d-gds-objs :width
     2079         v-diasize-current-frame-height = frame d-gds-objs :height
     2080       .
     2081       run diasize_set-height in this-procedure
     2082         (input  v-diasize-orig-frame-height
     2083         ,input  true
     2084         ) .
     2085       run diasize_set-width in this-procedure
     2086         (input  v-diasize-orig-frame-width
     2087         ,input  true
     2088         ) .
     2089     end.
     2090   end procedure.
     2091   procedure diasize_restore-current-size :
     2092     do
     2093     on error undo, return error return-value
     2094     :
     2095       run diasize_set-height in this-procedure
     2096         (input  v-diasize-current-frame-height
     2097         ,input  true
     2098         ) .
     2099       run diasize_set-width in this-procedure
     2100         (input  v-diasize-current-frame-width
     2101         ,input  true
     2102         ) .
     2103     end.
     2104   end procedure.
     2105   procedure diasize_set-browse-handle :
     2106     define input  parameter p-browse-handle as handle   no-undo .
     2107     define buffer buf_temp-browse-handle for temp-browse-handle .
     2108     do
     2109     on error undo, return error return-value
     2110     :
     2111       assign
     2112         v-diasize-browse-handle = p-browse-handle
     2113       .
     2114       for each buf_temp-browse-handle
     2115       on error undo, return error return-value
     2116       :
     2117         delete buf_temp-browse-handle .
     2118       end.
     2119     end.
     2120   end procedure.
     2121   procedure diasize_add_browse :
     2122     define input  parameter p-browse-type   as character no-undo .
     2123     define input  parameter p-browse-handle as handle    no-undo .
     2124     define buffer buf_temp-browse-handle for temp-browse-handle .
     2125     do
     2126     on error undo, return error return-value
     2127     :
     2128       assign
     2129         v-diasize-browse-number = v-diasize-browse-number + 1
     2130       .
     2131       create buf_temp-browse-handle .
     2132       assign
     2133         buf_temp-browse-handle.browse-type   = p-browse-type
     2134         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2135         buf_temp-browse-handle.browse-handle = p-browse-handle
     2136       .
     2137     end.
     2138   end procedure.
     2139   procedure diasize_init :
     2140     define variable v-default-value    as logical   no-undo .
     2141     define variable v-restore-saved    as logical   no-undo .
     2142     define variable v-resize-value-str as character no-undo .
     2143     do
     2144     on error undo, return error return-value
     2145     :
     2146       do with frame d-gds-objs
     2147       :
     2148         assign
     2149           v-diasize-orig-frame-height = frame d-gds-objs :height
     2150           v-diasize-orig-frame-width  = frame d-gds-objs :width
     2151           v-diasize-browse-handle     = browse br-prt-obj :handle
     2152         .
     2153         create button v-diasize-resize-button
     2154         assign
     2155           parent        = frame d-gds-objs :first-child
     2156           label         = "s"
     2157           height-pixels = 16
     2158           width-pixels  = 16
     2159           visible       = true
     2160           sensitive     = true
     2161           movable       = true
     2162           triggers:
     2163             on end-move persistent run diasize_end-move in this-procedure .
     2164           end triggers.
     2165         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2166         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2167         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2168         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2169         assign
     2170           v-diasize-wndmax = false
     2171         .
     2172         if connected("ub") = true
     2173         then do:
     2174           define variable v-cntxt-db-num        as integer   no-undo .
     2175           define variable v-cntxt-userid        as character no-undo .
     2176           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2177                                             , OUTPUT v-cntxt-userid
     2178                                             ) .
     2179           run gbl/wndpar_r.p
     2180             (input  v-cntxt-db-num
     2181             ,input  v-cntxt-userid
     2182             ,input  'wndmax':U
     2183             ,output v-diasize-wndmax
     2184             ,output v-default-value
     2185             ) .
     2186         end.
     2187         assign
     2188           v-diasize-wndstore = false
     2189         .
     2190         if connected("ub") = true
     2191         then do:
     2192           run gbl/wndpar_r.p
     2193             (input  v-cntxt-db-num
     2194             ,input  v-cntxt-userid
     2195             ,input  'wndstore':U
     2196             ,output v-diasize-wndstore
     2197             ,output v-default-value
     2198             ) .
     2199         end.
     2200         assign
     2201           v-diasize-proc-name = entry(1, program-name(2), '.')
     2202         .
     2203         if v-diasize-wndstore = true
     2204         then do:
     2205           assign
     2206             v-restore-saved = false
     2207           .
     2208           if connected("ub") = true
     2209           then do:
     2210             run gbl/wndsizer.p
     2211               (input  v-cntxt-db-num
     2212               ,input  v-cntxt-userid
     2213               ,input  v-diasize-proc-name
     2214               ,input  'height':u
     2215               ,output v-resize-value-str
     2216               ) .
     2217             if v-resize-value-str <> '':U
     2218             then do:
     2219               run diasize_change-height in this-procedure
     2220                 (input  integer(v-resize-value-str)
     2221                 ,input  true
     2222                 ) .
     2223               assign
     2224                 v-restore-saved = true
     2225               .
     2226             end.
     2227           end.
     2228           if connected("ub") = true
     2229           then do:
     2230             run gbl/wndsizer.p
     2231               (input  v-cntxt-db-num
     2232               ,input  v-cntxt-userid
     2233               ,input  v-diasize-proc-name
     2234               ,input  'width':u
     2235               ,output v-resize-value-str
     2236               ) .
     2237             if v-resize-value-str <> '':U
     2238             then do:
     2239               run diasize_change-width in this-procedure
     2240                 (input  integer(v-resize-value-str)
     2241                 ,input  true
     2242                 ) .
     2243               assign
     2244                 v-restore-saved = true
     2245               .
     2246             end.
     2247           end.
     2248           if v-restore-saved <> true
     2249           then do:
     2250             if v-diasize-wndmax = true
     2251             then do:
     2252               run diasize_maximize in this-procedure
     2253                 (input  true
     2254                 ) .
     2255             end.
     2256           end.
     2257         end.
     2258         else do:
     2259           if v-diasize-wndmax = true
     2260           then do:
     2261             run diasize_maximize in this-procedure
     2262               (input  true
     2263               ) .
     2264           end.
     2265         end.
     2266       end.
     2267     end.
     2268   end procedure.
     2269   procedure diasize_need-full-display :
     2270     define output parameter p-need-full-display as logical   no-undo .
     2271     do
     2272     on error undo, return error return-value
     2273     :
     2274       assign
     2275         p-need-full-display = v-diasize-need-full-display
     2276       .
     2277       assign
     2278         v-diasize-need-full-display = false
     2279       .
     2280     end.
     2281   end procedure.
     2282   procedure get-context :
     2283      define output parameter p-db-num as integer          no-undo.
     2284      define output parameter p-user-id as character        no-undo.
     2285      define variable v-login               as character    no-undo.
     2286      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2287      define buffer buf_user-login  for ub.user-login .
     2288      do
     2289      on error undo, return error
     2290      :
     2291            FIND FIRST buf_sys-ctrl no-lock.
     2292            ASSIGN
     2293               v-login = USERID("ub")
     2294               p-db-num = buf_sys-ctrl.db-num
     2295            .
     2296            FIND FIRST buf_user-login
     2297                 WHERE buf_user-login.db-num = p-db-num
     2298                   AND buf_user-login.user-login = v-login
     2299                 no-lock
     2300                 no-error
     2301                 .
     2302            IF AVAILABLE buf_user-login
     2303            THEN DO:
     2304               assign
     2305                  p-user-id = buf_user-login.user-id
     2306               .
     2307            END.
     2308      end.
     2309   end procedure.
     2310       run diasize_init in this-procedure .
     2311   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2312   do:
     2313     br-prt-obj :SET-REPOSITIONED-ROW(8, "CONDITIONAL") .
     2314   end.
     2315   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2316   on f5 of frame d-gds-objs anywhere
     2317   do:
     2318     run UI-on in this-procedure .
     2319       apply "VALUE-CHANGED" to br-prt-obj.
     2320   end.
     2321   MAIN-BLOCK:
     2322   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2323      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2324   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2325     run mainmenu_getcntxt in parparentproc
     2326       (output v-cntxt-db-num
     2327       ,output v-cntxt-userid
     2328       ,output v-cntxt-level
     2329       ,output v-cntxt-host-code-obj
     2330       ,output v-cntxt-obj-type
     2331       ,output v-cntxt-obj-code
     2332       ,output v-cntxt-db-num-obj
     2333       ,output v-cntxt-is-admin
     2334       ) .
     2335     assign
     2336       v-is-ptrl = ?
     2337       is-petrol = ?
     2338       is-pieces = ?
     2339     .
     2340   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     2341     (input  'is-ptrl'
     2342     ,input  ''
     2343     ,input  ''
     2344     ,input  0
     2345     ,input  ''
     2346     ,input  ''
     2347     ,input  ''
     2348     ,input  no
     2349     ,output v-is-ptrl
     2350     ,output v-data-type
     2351     ) no-error .
     2352     if error-status :error or v-data-type <> "L" or lookup( v-is-ptrl, "yes,no" ) = 0 then do: assign v-is-ptrl = "no". end.
     2353     if v-is-ptrl = "yes" then do:
     2354   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     2355     (
     2356        input pp-artic
     2357     ,  input pp-prod-type
     2358     ,  input pp-prod-code
     2359     , output is-petrol
     2360     , output is-pieces
     2361     ) no-error.
     2362       if not error-status :error and is-petrol = yes and is-pieces = no then do:
     2363         assign
     2364           is-kg-visible = yes
     2365         .
     2366       end.
     2367     end.
     2368     if is-kg-visible <> yes then do:
     2369       assign
     2370         buf_temp_prt-obj.fact-qty-kg :visible in browse br-prt-obj = no
     2371         buf_temp_prt-obj.free-qty-kg :visible in browse br-prt-obj = no
     2372         buf_temp_prt-obj.price-kg    :visible in browse br-prt-obj = no
     2373       .
     2374       assign
     2375         total-fact-kg :hidden in frame d-gds-objs = no
     2376         ed_izm        :hidden in frame d-gds-objs = no
     2377       .
     2378     end.
     2379     find first buf_goods no-lock where
     2380                buf_goods.artic     = pp-artic     and
     2381                buf_goods.prod-type = pp-prod-type and
     2382                buf_goods.prod-code = pp-prod-code .
     2383     if pp-node-code <> -1 then do:
     2384       find first buf_gds-prt no-lock where buf_gds-prt.node-code = pp-node-code.
     2385     end.
     2386     assign
     2387       rs-firm-global = 'firm':u
     2388       ed_izm         = buf_goods.unit-cli
     2389     .
     2390     run UI-on in this-procedure .
     2391     WAIT-FOR GO OF FRAME d-gds-objs FOCUS b-quit.
     2392   END.
     2393   RUN disable_UI.
     2394   PROCEDURE disable_UI :
     2395     HIDE FRAME d-gds-objs NO-PAUSE.
     2396   END PROCEDURE.
     2397   PROCEDURE enable_UI :
     2398     DISPLAY total-fact total-sum rs-firm-global fi-description firm-name
     2399             FI-Filter-Label
     2400         WITH FRAME d-gds-objs.
     2401     ENABLE b-quit b-help RECT-1 rs-firm-global br-prt-obj FI-Filter-Label
     2402         WITH FRAME d-gds-objs.
     2403     VIEW FRAME d-gds-objs.
     2404     run UI-on in this-procedure .
     2405   END PROCEDURE.
     2406   PROCEDURE UI-on :
     2407     define variable v-db-num    as integer no-undo.
     2408     define variable v-root-node as integer no-undo.
     2409     define buffer buf_db for ub.db .
     2410   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2411   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     2412     (input  pp-artic
     2413     ,input  pp-prod-type
     2414     ,input  pp-prod-code
     2415     ,output v-root-node
     2416     ) no-error .
     2417     if error-status :error then do:
     2418       message vss-workfile vss-revision vss-description   skip
     2419               "Ошибка при определении корневого признака" skip
     2420       view-as alert-box error .
     2421       undo, return error .
     2422     end.
     2423   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2424   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     2425     (output v-db-num
     2426     )  .
     2427     if v-db-num <> 0 then do:
     2428       find first buf_db no-lock where buf_db.db-num = v-db-num no-error .
     2429       if not available buf_db then do:
     2430         message vss-workfile vss-revision vss-description skip
     2431                 "Ошибка при поиске базы данных" skip
     2432                 "База данных" v-db-num skip
     2433         view-as alert-box error .
     2434         undo, return error return-value .
     2435       end.
     2436       p-need:visible in browse br-prt-obj = false  .
     2437       if buf_db.remote-stock = true then do:
     2438         assign
     2439           fi-description = "Приём информации об остатках из других БД включён."
     2440         .
     2441       end.
     2442       else do:
     2443         assign
     2444           fi-description = "Приём информации об остатках из других БД выключен. Информация об остатках является устаревшей."
     2445         .
     2446       end.
     2447     end.
     2448     else do:
     2449       p-need:visible in browse br-prt-obj = true   .
     2450       assign
     2451         fi-description = "Приём информации об остатках из других БД включён."
     2452       .
     2453     end.
     2454     run waitfram-show     in this-procedure (  input "Считывание остатков" ) .
     2455     run fill-temp_prt-obj in this-procedure (  input pp-artic,
     2456                                                input pp-prod-type,
     2457                                                input pp-prod-code,
     2458                                                input pp-host-code,
     2459                                                input ( if pp-node-code = -1 then v-root-node else pp-node-code ),
     2460                                                input rs-firm-global,
     2461                                                input is-kg-visible,
     2462                                               output total-fact,
     2463                                               output total-sum,
     2464                                               output total-fact-kg                                             ) .
     2465     run waitfram-hide     in this-procedure .
     2466     display
     2467       total-fact
     2468       total-fact-kg  when is-kg-visible = yes
     2469       ed_izm         when is-kg-visible = yes
     2470       rs-firm-global
     2471       total-sum
     2472       fi-description
     2473     with frame d-gds-objs .
     2474     enable
     2475       b-quit
     2476       b-help
     2477       br-prt-obj
     2478       rs-firm-global
     2479     with frame d-gds-objs .
     2480     view frame d-gds-objs.
     2481     if rs-firm-global = "firm" then do:
     2482       assign frame d-gds-objs :title = 'Остатки по объектам текущей фирмы.'.
     2483       OPEN QUERY br-prt-obj FOR EACH buf_temp_prt-obj NO-LOCK BY buf_temp_prt-obj.qnty DESCENDING.
     2484     end.
     2485     else do:
     2486       assign frame d-gds-objs :title = 'Остатки по объектам всех фирм.'.
     2487       OPEN QUERY br-prt-obj FOR EACH buf_temp_prt-obj NO-LOCK BY buf_temp_prt-obj.qnty DESCENDING.
     2488     end.
     2489     apply "VALUE-CHANGED":U to browse br-prt-obj.
     2490     if pp-node-code = -1 then do:
     2491       assign frame d-gds-objs :title = frame d-gds-objs :title + '   Артикул : ' + buf_goods.artic +
     2492                                           '    ' + buf_goods.gds-name.
     2493     end.
     2494     else do:
     2495       assign frame d-gds-objs :title = frame d-gds-objs :title + '   Артикул : ' + buf_goods.artic +
     2496                                           '    Признак : ' + buf_gds-prt.f-name + '    ' + buf_goods.gds-name.
     2497     end.
     2498   END PROCEDURE.
