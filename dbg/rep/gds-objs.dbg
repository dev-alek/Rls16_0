      924        SIZE 4 BY 1
      925        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      926   DEFINE VARIABLE total-fact-kg AS DECIMAL FORMAT "->>,>>>,>>9.<<<":U INITIAL 0
      927        LABEL "Количество по объектам"
      928        VIEW-AS FILL-IN
      929        SIZE 16.88 BY 1 TOOLTIP "Общее количество (кг) на всех объектах фирмы (всех фирм)"
