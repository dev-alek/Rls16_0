     1730   FUNCTION format-etime RETURNS CHARACTER
     1731      (INPUT p-etime AS INT64)
     1732      :
     1733      define variable v-datetime as character no-undo .
     1734      define variable v-col-date as integer   no-undo .
     1735      if p-etime = ?
     1736         then
     1737      do:
     1738         v-datetime = " " .
     1739      end.
     1740      if p-etime >= 86400 then
     1741      do:
     1742         v-col-date = int(p-etime / 86400) .
     1743         if p-etime - (v-col-date * 86400) < 0 then do:
     1744            if (v-col-date - 1) > 0 then
     1745         v-datetime = string((v-col-date - 1),">>>>>>>>>9") + "дн." + string( 86400 + p-etime - ((v-col-date - 1) * 86400), 'HH:MM:SS') .
     1746         end.
     1747         else
     1748         v-datetime = string((v-col-date),">>>>>>>>>9") + "дн." + string(( p-etime - (v-col-date) * 86400), 'HH:MM:SS') .
     1749      end.
     1750      else
     1751      do:
     1752         if p-etime = 0 then v-datetime = "" .
     1753         else v-datetime = string( p-etime, 'HH:MM:SS') .
     1754      end.
     1755      return v-datetime .
     1756   END FUNCTION.
     1757   FUNCTION Type-kassa RETURNS CHARACTER
     1758      (INPUT p-kassa AS character)
     1759      :
     1760      if p-kassa = ""
     1761         then
     1762      do:
     1763         return " " .
     1764      end.
     1765      case p-kassa:
     1766         when "Все" then
     1767            return "Все" .
     1768         when "IBM-XML" then
     1769            return "ППО UniFO-L" .
     1770         when "Autotank" then
     1771            return "АСУ Заправщик" .
     1772      end case .
     1773   END FUNCTION.
     1774   FUNCTION qnty-dif-int RETURNS INTEGER
     1775      (input p-date-End as date,
     1776      input p-time-end as integer,
     1777      INPUT p-date-Start AS date,
     1778      input p-time-Start as integer) :
     1779      define variable v-datetime as integer no-undo .
     1780      define variable v-col-date as integer   no-undo .
     1781      if (p-time-end - p-time-Start) < 0 then
     1782      do:
     1783         v-datetime = integer(p-date-end - p-date-start - 1) * 86400  + ( 86400 + p-time-end - p-time-Start) .
     1784      end.
     1785      else
     1786      do:
     1787         v-datetime = (p-date-end - p-date-start) * 86400 + (p-time-end - p-time-Start) .
     1788      end.
     1789      if v-datetime < 0 then v-datetime = 0 .
     1790      return v-datetime .
     1791   END FUNCTION.
