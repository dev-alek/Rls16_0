     1894   DEFINE TEMP-TABLE tt-chk NO-UNDO
     1895      FIELD ob-type  LIKE chk-doc.obj-type
     1896      FIELD ob-code  LIKE chk-doc.obj-code
     1897      FIELD kassa    LIKE chk-doc.pay-desk
     1898      FIELD smena    LIKE chk-doc.src-shift-name
     1899      FIELD chk-date LIKE chk-doc.chk-date
     1900      FIELD chk-time LIKE chk-doc.chk-time
     1901      FIELD chk-type LIKE chk-doc.chk-type
     1902      field chk-num  like chk-doc.chk-num
     1903      INDEX pi AS UNIQUE PRIMARY ob-code kassa chk-date chk-time
     1904      .
     1905   DEFINE TEMP-TABLE tt-period NO-UNDO
     1906      FIELD ob-type    LIKE chk-doc.obj-type
     1907      FIELD ob-code    LIKE chk-doc.obj-code
     1908      FIELD kassa      LIKE chk-doc.pay-desk
     1909      FIELD smena      as integer
     1910      FIELD date-beg   LIKE chk-doc.chk-date
     1911      FIELD date-end   LIKE chk-doc.chk-date
     1912      FIELD time-beg   LIKE chk-doc.chk-time
     1913      FIELD time-end   LIKE chk-doc.chk-time
     1914      field qnty-kassa as integer
     1915      FIELD FLG        AS INT
     1916      INDEX pi AS UNIQUE PRIMARY ob-code kassa date-beg time-beg date-end time-end
     1917      .
     1918   DEFINE TEMP-TABLE tt-tr NO-UNDO
     1919      FIELD npp       AS INT
     1920      FIELD td_1      as character
     1921      FIELD td_2_date as date
     1922      field td_2_time as integer
     1923      FIELD td_3_date as date
     1924      field td_3_time as integer
     1925      FIELD td_4      as integer
     1926      FIELD td_5      as character
     1927      FIELD td_6      as character
     1928      field obj-code  as integer
     1929      field obj-type  as character
     1930      INDEX pi AS UNIQUE PRIMARY npp obj-code obj-type
     1931      .
     1932   define temp-table tt-tr-time like tt-tr .
     1933   define buffer buf_tt-chk for tt-chk .
     1934   define variable chk-sale       as character no-undo .
     1935   define variable old-shift-date as date      no-undo init ?.
     1936   define variable old-shift-num  as integer   no-undo init 0.
     1937   define variable old-time       as integer   no-undo .
     1938   define variable pay-desk       as character no-undo .
     1939   define variable v-date         as date      no-undo .
     1940   define variable nnn            as integer   no-undo .
     1941   define buffer previous-shift-obj for ub.shift-obj .
     1942   define buffer previous-rvs-doc   for ub.rvs-doc .
     1943   FOR EACH obj-list  NO-LOCK:
     1944      if x-tog-shift then
     1945      do:
     1946         nnn = 0 .
     1947         for each ub.shift-obj no-lock where ub.shift-obj.obj-code = obj-list.obj-code and
     1948            ub.shift-obj.obj-type = obj-list.obj-type and
     1949            ub.shift-obj.shift-date >= x-Date-Start and
     1950            ub.shift-obj.shift-date <= x-Date-End:
     1951            if ub.shift-obj.shift-date = X-date-Start and ub.shift-obj.shift-num < X-Shift-Start then next .
     1952            if ub.shift-obj.shift-date = X-date-End   and ub.shift-obj.shift-num > X-Shift-End then next .
     1953            chk-sale = "" .
     1954            for each chk-doc where chk-doc.shift-date = shift-obj.shift-date and
     1955               chk-doc.shift-num = ub.shift-obj.shift-num and
     1956               chk-doc.obj-code = ub.shift-obj.obj-code and
     1957               chk-doc.obj-type = ub.shift-obj.obj-type and
     1958               chk-doc.chk-type = 1:
     1959               FIND FIRST cash-desk WHERE cash-desk.obj-code = chk-doc.obj-code AND cash-desk.cash-num = chk-doc.pay-desk no-lock no-error.
     1960               IF   cash-desk.pos-type  =  type-pos OR  type-pos = 'Все' THEN
     1961               DO:
     1962                  if lookup (string(chk-doc.pay-desk),chk-sale,";") = 0 then
     1963                     chk-sale = chk-sale + ";" + string(chk-doc.pay-desk) .
     1964               end.
     1965            end.
     1966            chk-sale = trim(chk-sale,";") .
     1967            if old-shift-date = ? and old-shift-num = 0 then
     1968            do:
     1969               find last previous-shift-obj share-lock
     1970                  where previous-shift-obj.obj-type = obj-list.obj-type
     1971                  and previous-shift-obj.obj-code = obj-list.obj-code
     1972                  and (( previous-shift-obj.shift-date = ub.shift-obj.shift-date
     1973                  and previous-shift-obj.shift-num < ub.shift-obj.shift-num
     1974                  )
     1975                  or previous-shift-obj.shift-date < ub.shift-obj.shift-date
     1976                  )
     1977                  use-index pi no-error.
     1978               if available previous-shift-obj then
     1979               do:
     1980                  find first previous-rvs-doc no-lock
     1981                     where previous-rvs-doc.obj-type = obj-list.obj-type
     1982                     and previous-rvs-doc.obj-code   = obj-list.obj-code
     1983                     and previous-rvs-doc.shift-date = previous-shift-obj.shift-date
     1984                     and previous-rvs-doc.shift-num  = previous-shift-obj.shift-num
     1985                     and previous-rvs-doc.status_    = 'факт':U
     1986                     and previous-rvs-doc.rvs-type   = 'смена':U
     1987                     no-error.
     1988                  if available (previous-rvs-doc) then
     1989                  do:
     1990                     assign
     1991                        old-shift-date = previous-rvs-doc.fact-date
     1992                        old-shift-num  = previous-rvs-doc.shift-num
     1993                        old-time       = previous-rvs-doc.fact-time
     1994                        .
     1995                  end.
     1996               end.
     1997            end.
     1998            nnn = nnn + 1 .
     1999            create tt-period .
     2000            assign
     2001               tt-period.date-beg   = old-shift-date
     2002               tt-period.time-beg   = old-time
     2003               tt-period.ob-code    = obj-list.obj-code
     2004               tt-period.ob-type    = obj-list.obj-type
     2005               tt-period.qnty-kassa = num-entries(chk-sale,";")
     2006               tt-period.smena      = nnn
     2007               .
     2008            find first ub.rvs-doc no-lock
     2009               where ub.rvs-doc.obj-type = obj-list.obj-type
     2010               and ub.rvs-doc.obj-code   = obj-list.obj-code
     2011               and ub.rvs-doc.shift-date = ub.shift-obj.shift-date
     2012               and ub.rvs-doc.shift-num  = ub.shift-obj.shift-num
     2013               and ub.rvs-doc.status_    = 'факт':U
     2014               and ub.rvs-doc.rvs-type   = 'смена':U
     2015               no-error.
     2016            if available (ub.rvs-doc) then
     2017            do:
     2018               assign
     2019                  old-shift-date = ub.rvs-doc.fact-date
     2020                  old-shift-num  = ub.rvs-doc.shift-num
     2021                  old-time       = ub.rvs-doc.fact-time
     2022                  .
     2023               assign
     2024                  tt-period.date-end = ub.rvs-doc.fact-date
     2025                  tt-period.time-end = ub.rvs-doc.fact-time
     2026                  .
     2027            end.
     2028         end.
     2029         for last ub.shift-obj no-lock where ub.shift-obj.obj-code = obj-list.obj-code and
     2030            ub.shift-obj.obj-type = obj-list.obj-type and
     2031            ub.shift-obj.shift-date = x-Date-End and
     2032            ub.shift-obj.shift-num = x-Shift-End:
     2033            if ub.shift-obj.status_ = 'зкр':U then
     2034            do:
     2035               v-close = true .
     2036            end.
     2037         end.
     2038      end.
     2039      else
     2040      do:
     2041            nnn = 0 .
     2042            for each ub.shift-obj no-lock where ub.shift-obj.obj-code = obj-list.obj-code and
     2043               ub.shift-obj.obj-type = obj-list.obj-type and
     2044               ub.shift-obj.open-date >= x-Date-Start and
     2045               ub.shift-obj.close-date <= x-Date-End:
     2046               chk-sale = "" .
     2047               for each chk-doc where chk-doc.shift-date = shift-obj.shift-date and
     2048                  chk-doc.shift-num = ub.shift-obj.shift-num and
     2049                  chk-doc.obj-code = ub.shift-obj.obj-code and
     2050                  chk-doc.obj-type = ub.shift-obj.obj-type and
     2051                  chk-doc.chk-type = 1:
     2052                  FIND FIRST cash-desk WHERE cash-desk.obj-code = chk-doc.obj-code AND cash-desk.cash-num = chk-doc.pay-desk no-lock no-error.
     2053                  IF   cash-desk.pos-type  =  type-pos OR  type-pos = 'Все' THEN
     2054                  DO:
     2055                     if lookup (string(chk-doc.pay-desk),chk-sale,";") = 0 then
     2056                        chk-sale = chk-sale + ";" + string(chk-doc.pay-desk) .
     2057                  end.
     2058               end.
     2059               chk-sale = trim(chk-sale,";") .
     2060               if old-shift-date = ? and old-shift-num = 0 then
     2061               do:
     2062                  find last previous-shift-obj share-lock
     2063                     where previous-shift-obj.obj-type = obj-list.obj-type
     2064                     and previous-shift-obj.obj-code = obj-list.obj-code
     2065                     and (( previous-shift-obj.shift-date = ub.shift-obj.shift-date
     2066                     and previous-shift-obj.shift-num < ub.shift-obj.shift-num
     2067                     )
     2068                     or previous-shift-obj.shift-date < ub.shift-obj.shift-date
     2069                     )
     2070                     use-index pi no-error.
     2071                  if available previous-shift-obj then
     2072                  do:
     2073                     find first previous-rvs-doc no-lock
     2074                        where previous-rvs-doc.obj-type = obj-list.obj-type
     2075                        and previous-rvs-doc.obj-code   = obj-list.obj-code
     2076                        and previous-rvs-doc.shift-date = previous-shift-obj.shift-date
     2077                        and previous-rvs-doc.shift-num  = previous-shift-obj.shift-num
     2078                        and previous-rvs-doc.status_    = 'факт':U
     2079                        and previous-rvs-doc.rvs-type   = 'смена':U
     2080                        no-error.
     2081                     if available (previous-rvs-doc) then
     2082                     do:
     2083                        assign
     2084                           old-shift-date = previous-rvs-doc.fact-date
     2085                           old-shift-num  = previous-rvs-doc.shift-num
     2086                           old-time       = previous-rvs-doc.fact-time
     2087                           .
     2088                     end.
     2089                  end.
     2090               end.
     2091               nnn = nnn + 1 .
     2092               create tt-period .
     2093               assign
     2094                  tt-period.date-beg   = old-shift-date
     2095                  tt-period.time-beg   = old-time
     2096                  tt-period.ob-code    = obj-list.obj-code
     2097                  tt-period.ob-type    = obj-list.obj-type
     2098                  tt-period.qnty-kassa = num-entries(chk-sale,";")
     2099                  tt-period.smena      = nnn
     2100                  .
     2101               find first ub.rvs-doc no-lock
     2102                  where ub.rvs-doc.obj-type = obj-list.obj-type
     2103                  and ub.rvs-doc.obj-code   = obj-list.obj-code
     2104                  and ub.rvs-doc.shift-date = ub.shift-obj.shift-date
     2105                  and ub.rvs-doc.shift-num  = ub.shift-obj.shift-num
     2106                  and ub.rvs-doc.status_    = 'факт':U
     2107                  and ub.rvs-doc.rvs-type   = 'смена':U
     2108                  no-error.
     2109               if available (ub.rvs-doc) then
     2110               do:
     2111                  assign
     2112                     old-shift-date = ub.rvs-doc.fact-date
     2113                     old-shift-num  = ub.rvs-doc.shift-num
     2114                     old-time       = ub.rvs-doc.fact-time
     2115                     .
     2116                  assign
     2117                     tt-period.date-end = ub.rvs-doc.fact-date
     2118                     tt-period.time-end = ub.rvs-doc.fact-time
     2119                     .
     2120               end.
     2121            end.
     2122            for last ub.shift-obj no-lock where ub.shift-obj.obj-code = obj-list.obj-code and
     2123               ub.shift-obj.obj-type = obj-list.obj-type and
     2124               ub.shift-obj.close-date = x-Date-End:
     2125               if ub.shift-obj.status_ = 'зкр':U then
     2126               do:
     2127                  v-close = true .
     2128               end.
     2129            end.
     2130         end.
     2131      run proc-report .
     2132   end.
     2133   DEFINE VARIABLE kol-kass   AS INTEGER   NO-UNDO.
     2134   DEFINE VARIABLE kass       AS INTEGER   NO-UNDO.
     2135   DEFINE VARIABLE kol-kass2  AS INTEGER   NO-UNDO.
     2136   DEFINE VARIABLE beg-p-date AS DATE      NO-UNDO.
     2137   DEFINE VARIABLE end-p-date AS DATE      NO-UNDO.
     2138   DEFINE VARIABLE beg-p-time AS INTEGER   NO-UNDO.
     2139   DEFINE VARIABLE end-p-time AS INTEGER   NO-UNDO.
     2140   DEFINE VARIABLE dl-time    AS INT64     NO-UNDO.
     2141   DEFINE VARIABLE ch-l       AS INTEGER   NO-UNDO INITIAL 0.
     2142   DEFINE VARIABLE ch-2       AS INTEGER   NO-UNDO INITIAL 0 .
     2143   DEFINE VARIABLE nach-txt   AS CHARACTER NO-UNDO .
     2144   DEFINE VARIABLE nach-txt2  AS CHARACTER NO-UNDO .
     2145   procedure proc-report:
     2146      FOR EACH tt-period no-lock where tt-period.ob-code = obj-list.obj-code and tt-period.ob-type = obj-list.obj-type break by tt-period.smena:
     2147         if ch-l = 0 then
     2148         do:
     2149            ch-l = ch-l + 1.
     2150            create tt-tr .
     2151            ASSIGN
     2152               tt-tr.td_2_date = tt-period.date-beg
     2153               tt-tr.td_2_time = tt-period.time-beg
     2154               tt-tr.td_5      = STRING(tt-period.qnty-kassa)
     2155               tt-tr.npp       = ch-l
     2156               tt-tr.obj-code  = tt-period.ob-code
     2157               tt-tr.obj-type  = tt-period.ob-type
     2158               .
     2159            kol-kass2 = tt-period.qnty-kassa .
     2160            kol-kass = tt-period.qnty-kassa .
     2161            end-p-date = tt-period.date-end .
     2162            end-p-time = tt-period.time-end .
     2163         end.
     2164         else
     2165         do:
     2166            if kol-kass <> tt-period.qnty-kassa then
     2167            do:
     2168               find first tt-tr where tt-tr.npp = ch-l no-error .
     2169               if available (tt-tr) then
     2170               do:
     2171                  assign
     2172                     tt-tr.td_3_date = end-p-date
     2173                     tt-tr.td_3_time = end-p-time
     2174                     tt-tr.td_4      = qnty-dif-int(tt-tr.td_3_date, tt-tr.td_3_time, tt-tr.td_2_date, tt-tr.td_2_time)
     2175                     .
     2176               end.
     2177               ch-l = ch-l + 1.
     2178               create tt-tr .
     2179               ASSIGN
     2180                  tt-tr.td_2_date = tt-period.date-beg
     2181                  tt-tr.td_2_time = tt-period.time-beg
     2182                  tt-tr.td_5      = STRING(tt-period.qnty-kassa)
     2183                  tt-tr.npp       = ch-l
     2184                  tt-tr.obj-code  = tt-period.ob-code
     2185                  tt-tr.obj-type  = tt-period.ob-type
     2186                  .
     2187               if kol-kass2 <= tt-period.qnty-kassa then kol-kass2 = tt-period.qnty-kassa .
     2188               kol-kass = tt-period.qnty-kassa .
     2189               end-p-date = tt-period.date-end .
     2190               end-p-time = tt-period.time-end .
     2191            end.
     2192            else
     2193            do:
     2194               end-p-date = tt-period.date-end .
     2195               end-p-time = tt-period.time-end .
     2196            end.
     2197         end.
     2198         if last-of (tt-period.smena) then
     2199         do:
     2200            if v-close = true and available(tt-tr) then
     2201            do:
     2202               assign
     2203                  tt-tr.td_3_date = tt-period.date-end
     2204                  tt-tr.td_3_time = tt-period.time-end
     2205                  tt-tr.td_4      = qnty-dif-int(tt-tr.td_3_date, tt-tr.td_3_time, tt-tr.td_2_date, tt-tr.td_2_time)
     2206                  .
     2207            end .
     2208         end.
     2209      end.
     2210      CREATE tt-tr.
     2211      ASSIGN
     2212         tt-tr.npp  = 0
     2213         tt-tr.td_1 = obj-list.obj-name
     2214         tt-tr.td_6 = STRING(kol-kass2)
     2215         .
     2216      kol-kass2 = 0 .
     2217      kol-kass = 0 .
     2218      RUN itog_azs.
     2219   end procedure .
     2220   put stream OutStr-html unformatted
     2221      '</tbody> 'skip
     2222      '</table>'skip
     2223      ' </body>'skip
     2224      ' </html> 'skip.
     2225   PROCEDURE itog_azs:
     2226      FOR EACH tt-tr NO-LOCK:
     2227         if tt-tr.npp = 0 then
     2228         do:
     2229            put stream OutStr-html unformatted
     2230               '<tr bgcolor="#F8CBAD">' skip
     2231               '<td style="text-align:center;">' tt-tr.td_1 '</td>' skip
     2232               '<td style="text-align:center;">' '</td>' skip
     2233               '<td style="text-align:center;">' '</td>' skip
     2234               '<td style="text-align:center;">' format-etime(tt-tr.td_4) '</td>' skip
     2235               '<td style="text-align:center;">' tt-tr.td_5 '</td>' skip
     2236               '<td style="text-align:center;">' tt-tr.td_6 '</td>' skip
     2237               '</tr>' skip
     2238               .
     2239         end.
     2240         else if tt-tr.npp <> 0 then
     2241            do:
     2242               put stream OutStr-html unformatted
     2243                  '<tr >' skip
     2244                  '<td style="text-align:center;">' tt-tr.td_1 '</td>' skip
     2245                  '<td style="text-align:center;">' STRING(tt-tr.td_2_date, "99.99.9999") + ' ' + format-etime(tt-tr.td_2_time) '</td>' skip
     2246                  '<td style="text-align:center;">' if tt-tr.td_3_date <> ? then (STRING(tt-tr.td_3_date, "99.99.9999") + ' ' + format-etime(tt-tr.td_3_time)) else "" '</td>' skip
     2247                  '<td style="text-align:center;">' format-etime(tt-tr.td_4) '</td>' skip
     2248                  '<td style="text-align:center;">' if tt-tr.td_3_date <> ? then tt-tr.td_5 else "" '</td>' skip
     2249                  '<td style="text-align:center;">' tt-tr.td_6 '</td>' skip
     2250                  '</tr>' skip
     2251                  .
     2252            end.
     2253      end.
     2254      EMPTY TEMP-TABLE tt-tr.
     2255   END PROCEDURE.
     2256   output stream OutStr-html close.
     2257       run prn-lib-reportviewer in this-procedure (
     2258           input parparentproc
     2259           ,input v-file-name-rep-htm
     2260           ,input ""
     2261           ) no-error.
     2262       if error-status:error then
     2263       do:
     2264           message return-value view-as alert-box.
     2265           return .
     2266       end.
