     3001     (input  obj-list.obj-type
     3002     ,input  obj-list.obj-code
     3003     ,output v-host-code-1
     3004     )  .
     3005     for each obj-list :
     3006   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3007   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3008     (input  obj-list.obj-type
     3009     ,input  obj-list.obj-code
     3010     ,output v-host-code-2
     3011     )  .
     3012       if v-host-code-1 <> v-host-code-2 then do:
     3013         message
     3014           "Отчет формируется по объектом одной фирмы!"
     3015         view-as alert-box error.
     3016         undo, return error.
     3017       end.
     3018     end.
     3019     run day-begin-fact-order in this-procedure ( input x-Date-Start , output v-fact-order-1 ).
     3020     run day-begin-fact-order in this-procedure ( input ( x-Date-End + 1 ) , output v-fact-order-2 ).
     3021     run get-report-num in parparentproc (output g#report-num).
     3022   output stream out-stream to value( string( session:temp-directory +
     3023                                        "rpt" + string( g#report-num ) ) )
     3024                                        page-size 62 .
     3025     run torg29xl-init in this-procedure.
     3026     run create-report in this-procedure .
     3027     run print-report in this-procedure .
     3028     run waitfram-hide in this-procedure .
     3029     run torg29xl-close in this-procedure .
     3030     output stream out-stream close.
     3031     if Make-Excel then output stream ForExcel close.
     3032     run clear-tt in this-procedure .
     3033   if session :set-wait-state( "" ) then.
     3034     os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )  .
     3035     os-rename
     3036       value( string( session:temp-directory ) + "$" + string( g#report-num ) + ".txl" )
     3037       value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )
     3038     .
     3039     define variable v-user-action   as character no-undo .
     3040     define variable v-printed       as logical   no-undo .
     3041     define variable DisabledOptions as integer   no-undo .
     3042     define variable v-orient-page as character no-undo .
     3043     run How-name in this-procedure ( input ReportPageHeight
     3044                                    , input ReportPageWidth
     3045                                    , output v-orient-page
     3046                                    ) .
     3047     if v-orient-page = "A4-lans":U then DisabledOptions = 8 .
     3048                                    else DisabledOptions = 0 .
     3049     run gbl/prnfilen.w
     3050         ( input  ""
     3051         , input  DisabledOptions
     3052         , input  string(session :temp-directory) + "rpt" + string( g#report-num )
     3053         , input  ReportFontNum
     3054         , output v-user-action
     3055         , output v-printed
     3056         ) .
     3057     os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )  .
     3058   end.
     3059   procedure clear-tt :
     3060   do
     3061   on error undo, return error return-value
     3062   :
     3063     empty temp-table tt-report-object.
     3064     empty temp-table tt-report.
     3065     empty temp-table tt-goods.
     3066   end.
     3067   end procedure.
     3068   procedure print-header-list-1 :
     3069     define buffer buf_clients for ub.clients.
     3070     define variable v-obj-list as character format "X(78)" no-undo .
     3071   do
     3072   on error undo, return error return-value
     3073   :
     3074   find first buf_clients no-lock
     3075     where buf_clients.obj-type = 'орг':U
     3076       and buf_clients.obj-code = v-host-code-1
     3077   no-error .
     3078   if not available buf_clients then do:
     3079     message
     3080       "Не найдена фирма с кодом " v-host-code-1 skip
     3081       "Отчет не может быть сформирован"
     3082     view-as alert-box error.
     3083     return error.
     3084   end.
     3085   for each obj-list :
     3086     assign
     3087       v-obj-list = v-obj-list + obj-list.obj-name + ','
     3088     .
     3089   end.
     3090   assign
     3091     v-obj-list = trim( v-obj-list , ',' ).
     3092   .
     3093   run fmtcli-get-client in this-procedure ( input  buf_clients.obj-type , input buf_clients.obj-code ).
     3094   put stream out-stream unformatted
     3095     "                                                                                                 Унифицированная форма N ТОРГ-29" skip
     3096     "                                                                                                                                " skip
     3097     "                                                                                                 Утверждена                     " skip
     3098     "                                                                                                 Постановлением                 " skip
     3099     "                                                                                                 Госкомстата России             " skip
     3100     "                                                                                                 от 25.12.98 N 132              " skip
     3101     "                                                                                                                                " skip
     3102     "                                                                                                                      ----------" skip
     3103     "                                                                                                                      |  Код   |" skip
     3104     "                                                                                                                      |--------|" skip
     3105     "                                                                                                        Форма по ОКУД |0330229 |" skip
     3106     "                                                                                                                      |--------|" skip
     3107     substitute( "             &1    по ОКПО |&2|"
     3108               , string( p-fmt-align-string( v-fmtcli-name , 93 , "left") , "X(93)" )
     3109               , string( v-fmtcli-okpo , "X(8)"  )
     3110               )
     3111     skip
     3112     "             -----------------------------------------------------------------------------------------------          |--------|" skip
     3113     "                                                   организация                                                        |        |" skip
     3114     substitute( "             &1                           |--------|"
     3115               , string( p-fmt-align-string( v-obj-list , 78 , "left") , "X(78)" )
     3116               )
     3117     skip
     3118     "             ------------------------------------------------------------------------------  Вид деятельности по ОКДП |        |" skip
     3119     "                                           структурное подразделение                                                  |--------|" skip
     3120     "                                                                                                         Вид операции |        |" skip
     3121     "                                                                                                                      ----------" skip
     3122     "                                                                                                                                " skip
     3123     "                                                                                  ----------------------------------------------" skip
     3124     "                                                                                  |  Номер  |    Дата   |        Отчетный      |" skip
     3125     "                                                                                  |документа|составления|         период       |" skip
     3126     "                                                                                  |         |           |----------------------|" skip
     3127     "                                                                                  |         |           |     с     |    по    |" skip
     3128     "                                                                                  |---------|-----------|-----------|----------|" skip
     3129     substitute( "                                                                   ТОВАРНЫЙ ОТЧЕТ |         |&1 |&2 |&3|"
     3130               , string( today , "99.99.9999" )
     3131               , string( x-Date-Start , "99.99.9999" )
     3132               , string( x-Date-End , "99.99.9999" )
     3133               )
     3134     skip
     3135     "                                                                                  ----------------------------------------------" skip
     3136     "                                                                                                                                " skip
     3137     "                                                                                                               -----------------" skip
     3138     "                                                                                                               |Табельный номер|" skip
     3139     "                                                                                                               |---------------|" skip
     3140     "                                                                                                               |               |" skip
     3141     "                        Материально ответственное лицо _______________________________________________________ -----------------" skip
     3142     "                                                                             должность, фамилия,                                " skip
     3143     "                                                                                имя, отчество                                   " skip(1)
     3144   .
     3145   run print-table-header in this-procedure .
     3146   run torg29xl-write-cell-data in this-procedure ( input "h_firmname":U, input v-fmtcli-name ).
     3147   run torg29xl-write-cell-data in this-procedure ( input "h_objlist":U,  input v-obj-list ).
     3148   run torg29xl-write-cell-data in this-procedure ( input "h_okpo":U, input v-fmtcli-okpo ).
     3149   run torg29xl-write-cell-data in this-procedure ( input "h_printdate":U, input string( today , "99.99.9999") ).
     3150   run torg29xl-write-cell-data in this-procedure ( input "h_datestart":U, input string( x-Date-Start, "99.99.9999" ) ).
     3151   run torg29xl-write-cell-data in this-procedure ( input "h_dateend":U, input string( x-Date-End , "99.99.9999" ) ).
     3152   end.
     3153   end procedure.
     3154   procedure print-header-list-2 :
     3155   do
     3156   on error undo, return error return-value
     3157   :
     3158     put stream out-stream "Оборотная сторона формы N ТОРГ-29" skip(1).
     3159     run print-table-header in this-procedure .
     3160   end.
     3161   end procedure.
     3162   procedure print-table-header :
     3163     define variable v-str     as character no-undo .
     3164     define variable v-length  as integer   no-undo .
     3165     define variable v-result  as character no-undo .
     3166     define variable v-i       as integer   no-undo .
     3167     define variable v-j       as integer   no-undo .
     3168   do
     3169   :
     3170     assign
     3171       v-str     = "Сумма, руб. коп."
     3172       v-length  = length(v-str)
     3173     .
     3174     if v-length > 31
     3175     then do:
     3176       assign
     3177         v-result = substring( v-str , 1 , 31 )
     3178       .
     3179     end.
     3180     else do:
     3181       assign
     3182         v-i = center-field( 1, 31, v-length )
     3183       .
     3184       do v-j = 1 to 31
     3185       :
     3186         if v-j <> v-i
     3187         then do:
     3188           assign
     3189             v-result = v-result + " "
     3190           .
     3191         end.
     3192         else do:
     3193           assign
     3194             v-result  = v-result + v-str
     3195             v-j       = v-j + length(v-str) - 1
     3196           .
     3197         end.
     3198       end.
     3199     end.
     3200     put stream out-stream unformatted
     3201                  "--------------------------------------------------------------------------------------------------------------------------------":U skip
     3202       substitute( ":          Наименование        :            Документ           :&1:              Отметки          :":U
     3203                 , v-result
     3204                 ) skip
     3205                  ":                              :-------------------------------:-------------------------------:            бухгалтерии        :":U skip
     3206                  ":                              :    дата  :        номер       :     товара    :       тары    :                               :":U skip
     3207    .
     3208   end.
     3209   end procedure.
     3210   procedure print-footer-list-2 :
     3211   do
     3212   on error undo, return error return-value
     3213   :
     3214   put stream out-stream unformatted
     3215     "Приложение ____________________________________________ документов                    ":U skip
     3216     "                                                                                      ":U skip
     3217     "Отчет с документами                                                                   ":U skip
     3218     "принял и проверил   _________________________ __________________ _____________________":U skip
     3219     "                              должность              подпись      расшифровка подписи ":U skip
     3220     "                                                                                      ":U skip
     3221     "Материально                                                                           ":U skip
     3222     "ответственное лицо  _________________________ __________________ _____________________":U skip
     3223     "                              должность              подпись      расшифровка подписи ":U skip
     3224   .
     3225   end.
     3226   end procedure.
     3227   procedure create-tt-goods :
     3228     define buffer buf_goods   for ub.goods.
     3229     define buffer buf_cli-gds for ub.cli-gds.
     3230     define variable v-curr-grp-name as character            no-undo .
     3231     define variable v-host-code     like ub.clients.host-code  no-undo .
     3232   do
     3233   on error undo, return error return-value
     3234   :
     3235     run waitfram-show in this-procedure ( "Формирование списка товаров..." ) .
     3236     empty temp-table tt-goods.
     3237     case x-SelectGood :
     3238       when 1 then do:
     3239         for each buf_goods no-lock
     3240           where buf_goods.stts = 0
     3241         :
     3242           create tt-goods.
     3243           buffer-copy buf_goods to tt-goods.
     3244           assign
     3245             v-gds-counter = v-gds-counter + 1
     3246           .
     3247         end.
     3248       end.
     3249       when 2 then do:
     3250         for each tmp#grp no-lock
     3251         :
     3252           run grplib-get-full-name in this-procedure( input tmp#grp.node-code, output v-curr-grp-name ) .
     3253           for each buf_goods no-lock
     3254                 where buf_goods.grp-name begins v-curr-grp-name
     3255           :
     3256             find first tt-goods no-lock
     3257               where tt-goods.artic     = buf_goods.artic
     3258                 and tt-goods.prod-type = buf_goods.prod-type
     3259                 and tt-goods.prod-code = buf_goods.prod-code
     3260               no-error .
     3261             if not available tt-goods then do:
     3262               create tt-goods.
     3263               buffer-copy buf_goods to tt-goods.
     3264               assign
     3265                 v-gds-counter = v-gds-counter + 1
     3266               .
     3267             end.
     3268           end.
     3269         end.
     3270       end.
     3271       when 3 then do:
     3272         for each buf_goods no-lock
     3273           where buf_goods.stts = 0 ,
     3274             each buf_cli-gds no-lock
     3275               where buf_cli-gds.prod-type = buf_goods.prod-type
     3276                 and buf_cli-gds.prod-code = buf_goods.prod-code
     3277                 and buf_cli-gds.artic     = buf_goods.artic ,
     3278             first g#cli
     3279               where g#cli.obj-type = buf_cli-gds.cli-type
     3280                 and g#cli.obj-code = buf_cli-gds.cli-code
     3281         :
     3282           find first tt-goods no-lock
     3283             where tt-goods.prod-type = buf_goods.prod-type
     3284               and tt-goods.prod-code = buf_goods.prod-code
     3285               and tt-goods.artic     = buf_goods.artic
     3286           no-error.
     3287           if not available tt-goods then do:
     3288             create tt-goods.
     3289             buffer-copy buf_goods to tt-goods no-error.
     3290             assign
     3291               v-gds-counter = v-gds-counter + 1
     3292             .
     3293           end.
     3294         end.
     3295       end.
     3296       when 4 or when 5 then do:
     3297         for each gds-list :
     3298           find first buf_goods no-lock
     3299             where buf_goods.gds-code = gds-list.gds-code
     3300           no-error .
     3301           if available buf_goods then do:
     3302             create tt-goods.
     3303             buffer-copy buf_goods to tt-goods.
     3304             assign
     3305               v-gds-counter = v-gds-counter + 1
     3306             .
     3307           end.
     3308         end.
     3309       end.
     3310       when 7 then do:
     3311         for each tmp#grp no-lock
     3312         :
     3313           run grplib-get-full-name in this-procedure( input tmp#grp.node-code, output v-curr-grp-name ) .
     3314           for each buf_goods no-lock
     3315                 where buf_goods.grp-name begins v-curr-grp-name
     3316           :
     3317             find first tt-goods no-lock
     3318               where tt-goods.artic     = buf_goods.artic
     3319                 and tt-goods.prod-type = buf_goods.prod-type
     3320                 and tt-goods.prod-code = buf_goods.prod-code
     3321               no-error .
     3322             if not available tt-goods then do:
     3323               create tt-goods.
     3324               buffer-copy buf_goods to tt-goods no-error.
     3325               assign
     3326                 v-gds-counter = v-gds-counter + 1
     3327               .
     3328             end.
     3329           end.
     3330         end.
     3331         for each buf_goods no-lock
     3332           where buf_goods.stts = 0 ,
     3333             each buf_cli-gds no-lock
     3334               where buf_cli-gds.prod-type = buf_goods.prod-type
     3335                 and buf_cli-gds.prod-code = buf_goods.prod-code
     3336                 and buf_cli-gds.artic     = buf_goods.artic ,
     3337             first g#cli
     3338               where g#cli.obj-type = buf_cli-gds.cli-type
     3339                 and g#cli.obj-code = buf_cli-gds.cli-code
     3340         :
     3341           find first tt-goods no-lock
     3342             where tt-goods.prod-type = buf_goods.prod-type
     3343               and tt-goods.prod-code = buf_goods.prod-code
     3344               and tt-goods.artic     = buf_goods.artic
     3345           no-error.
     3346           if not available tt-goods then do:
     3347             create tt-goods.
     3348             buffer-copy buf_goods to tt-goods no-error.
     3349             assign
     3350               v-gds-counter = v-gds-counter + 1
     3351             .
     3352           end.
     3353         end.
     3354       end.
     3355     end case.
     3356     run waitfram-hide in this-procedure .
     3357   end.
     3358   end procedure.
     3359   procedure create-report :
     3360     define buffer buf_gds-obj   for ub.gds-obj.
     3361     define buffer buf_trn-doc   for ub.trn-doc.
     3362     define buffer buf_doc-line  for ub.doc-line.
     3363     define buffer buf_ot-line   for ub.ot-line.
     3364     define buffer buf_obj-list  for obj-list.
     3365     define buffer tt_report     for tt-report .
     3366     define variable var-x-store-code    like ub.clients.obj-code    no-undo.
     3367     define variable var-x-store-type    like ub.clients.obj-type    no-undo.
     3368     define variable var-x-date-start    like ub.stk-tot.Fact-date   no-undo.
     3369     define variable var-x-date-endt     like ub.stk-tot.Fact-date   no-undo.
     3370     define variable var-x-sum-type      like ub.stk-tot.sum-type    no-undo.
     3371     define variable var-x-ost-sum-type  like ub.stk-tot.sum-type    no-undo.
     3372     define variable var-x-cat-id        like ub.stk-tot.cat-id      no-undo.
     3373     define variable var-xTog-obj        as   log                 no-undo.
     3374     define variable var-Quantity        like ub.stk-tot.fact-qnty   initial ? no-undo.
     3375     define variable var-Coast_R         like ub.stk-tot.sum-rubl    no-undo.
     3376     define variable var-Coast_V         like ub.stk-tot.sum-rubl    no-undo.
     3377     define variable var-VAT_R           like ub.stk-tot.sum-rubl    no-undo.
     3378     define variable var-VAT_V           like ub.stk-tot.sum-rubl    no-undo.
     3379     define variable var-Fact-order      like ub.stk-tot.Fact-order  no-undo.
     3380     define variable var-x-artic         like ub.stk-line.artic        no-undo.
     3381     define variable var-x-prod-code     like ub.stk-line.prod-code    no-undo.
     3382     define variable var-x-prod-type     like ub.stk-line.prod-type    no-undo.
     3383     define variable var-SLT_R           like ub.stk-tot.sum-rubl    no-undo.
     3384     define variable var-SLT_V           like ub.stk-tot.sum-rubl    no-undo.
     3385     define variable v-ost-gds-1         as decimal   no-undo .
     3386     define variable v-ost-tara-1        as decimal   no-undo .
     3387     define variable v-ost-gds-2         as decimal   no-undo .
     3388     define variable v-ost-tara-2        as decimal   no-undo .
     3389     define variable v-ost-qnty          as decimal   no-undo .
     3390     define variable v-counter           as integer   no-undo .
     3391     define variable v-doc-date          as date      no-undo .
     3392     define variable v-prg               as class ProgressBar no-undo .
     3393     define variable v-none-sym-1        as character no-undo .
     3394     define variable v-none-sym-2        as character no-undo .
     3395   do
     3396   on error undo, return error return-value
     3397   :
     3398     run create-tt-goods in this-procedure .
     3399     empty temp-table tt-report.
     3400     case x-SET_PAY_TYPE :
     3401       when 2 then do:
     3402         assign
     3403           var-x-sum-type      = 'cost':U
     3404           var-x-ost-sum-type  = 'cost':U
     3405         .
     3406       end.
     3407       when 1 then do:
     3408         assign
     3409           var-x-sum-type      = 'crsa':U
     3410           var-x-ost-sum-type  = 'crsa':U
     3411         .
     3412       end.
     3413       when 3 then do:
     3414         assign
     3415           var-x-sum-type      = 'sale':U
     3416           var-x-ost-sum-type  = 'crsa':U
     3417         .
     3418       end.
     3419       otherwise do:
     3420         assign
     3421           var-x-sum-type      = 'cost':U
     3422           var-x-ost-sum-type  = 'cost':U
     3423         .
     3424       end.
     3425     end case.
     3426     assign
     3427       v-none-sym-1 = p-fmt-align-string( "---":U , 15 , "center")
     3428       v-none-sym-2 = p-fmt-align-string( "---":U , 15 , "center")
     3429     .
     3430     for each obj-list :
     3431       v-prg = new ProgressBar( 1 , v-gds-counter ).
     3432       assign
     3433         v-prg:frame-title = obj-list.obj-name
     3434         v-prg:fg-color = 9
     3435       .
     3436       v-prg:show-bar().
     3437       _goods-loop:
     3438       for each tt-goods
     3439       :
     3440         v-prg:increment().
     3441         find first buf_gds-obj no-lock
     3442             where buf_gds-obj.obj-type  = obj-list.obj-type
     3443               and buf_gds-obj.obj-code  = obj-list.obj-code
     3444               and buf_gds-obj.artic     = tt-goods.artic
     3445               and buf_gds-obj.prod-type = tt-goods.prod-type
     3446               and buf_gds-obj.prod-code = tt-goods.prod-code
     3447         no-error .
     3448         if not available buf_gds-obj then do:
     3449           next _goods-loop.
     3450         end.
     3451         assign
     3452           var-x-store-code  = obj-list.obj-code
     3453           var-x-store-type  = obj-list.obj-type
     3454           var-x-artic       = tt-goods.artic
     3455           var-x-prod-code   = tt-goods.prod-code
     3456           var-x-prod-type   = tt-goods.prod-type
     3457           var-x-cat-id      = '##,##':U
     3458           var-xTog-obj      = yes
     3459           v-counter         = v-counter + 1
     3460         .
     3461         RUN ost-line in this-procedure (
     3462             input   var-x-store-code    ,
     3463             input   var-x-store-type    ,
     3464             input   var-x-artic         ,
     3465             input   var-x-prod-code     ,
     3466             input   var-x-prod-type     ,
     3467             input   no                  ,
     3468             input   v-fact-order-1      ,
     3469             input   var-x-ost-sum-type  ,
     3470             input   var-x-cat-id        ,
     3471             input   var-xTog-obj        ,
     3472             output  var-Quantity        ,
     3473             output  var-Coast_R         ,
     3474             output  var-Coast_V         ,
     3475             output  var-VAT_R           ,
     3476             output  var-VAT_V           ,
     3477             output  var-SLT_R           ,
     3478             output  var-SLT_V          ) .
     3479         assign
     3480           v-ost-gds-1 = v-ost-gds-1 + ( if v-print-rubl = yes then var-Coast_R else var-Coast_V )
     3481         .
     3482         RUN ost-line in this-procedure (
     3483             input   var-x-store-code    ,
     3484             input   var-x-store-type    ,
     3485             input   var-x-artic         ,
     3486             input   var-x-prod-code     ,
     3487             input   var-x-prod-type     ,
     3488             input   no                  ,
     3489             input   v-fact-order-2      ,
     3490             input   var-x-ost-sum-type  ,
     3491             input   var-x-cat-id        ,
     3492             input   var-xTog-obj        ,
     3493             output  var-Quantity        ,
     3494             output  var-Coast_R         ,
     3495             output  var-Coast_V         ,
     3496             output  var-VAT_R           ,
     3497             output  var-VAT_V           ,
     3498             output  var-SLT_R           ,
     3499             output  var-SLT_V          ) .
     3500         assign
     3501           v-ost-gds-2 = v-ost-gds-2 + ( if v-print-rubl = yes then var-Coast_R else var-Coast_V )
     3502         .
     3503         _ot-line:
     3504         for each buf_ot-line no-lock
     3505             where buf_ot-line.obj-type     = obj-list.obj-type
     3506               and buf_ot-line.obj-code     = obj-list.obj-code
     3507               and buf_ot-line.artic        = tt-goods.artic
     3508               and buf_ot-line.prod-type    = tt-goods.prod-type
     3509               and buf_ot-line.prod-code    = tt-goods.prod-code
     3510               and buf_ot-line.fact-order   >= v-fact-order-1
     3511               and buf_ot-line.fact-order   <= v-fact-order-2
     3512               and buf_ot-line.sum-type     = var-x-sum-type
     3513         :
     3514           find first buf_trn-doc no-lock
     3515             where buf_trn-doc.doc-code = buf_ot-line.doc-code
     3516           no-error .
     3517           if available buf_trn-doc then do:
     3518              find first buf_obj-list no-lock
     3519               where buf_obj-list.obj-type = buf_trn-doc.cli-type
     3520                 and buf_obj-list.obj-code = buf_trn-doc.cli-code
     3521              no-error .
     3522              if available buf_obj-list then do:
     3523               next _ot-line.
     3524              end.
     3525           end.
     3526           case buf_ot-line.ext-doc-type :
     3527             when 'ie':U           or
     3528             when 'iv':U           or
     3529             when 'rv':U       or
     3530             when 'im':U
     3531             then do:
     3532               if x-SET_PAY_TYPE = 3 then next _ot-line.
     3533             find first tt_report where
     3534                 tt_report.ext-doc-type = "inc":U
     3535             and tt_report.obj-type      = obj-list.obj-type
     3536             and tt_report.obj-code      = obj-list.obj-code
     3537             and tt_report.doc-code      = buf_ot-line.doc-code
     3538             and tt_report.gds-code      = tt-goods.gds-code no-error .
     3539             if not available (tt_report) then do:
     3540               create tt_report.
     3541               assign
     3542                 tt_report.ext-doc-type = "inc":U
     3543                 tt_report.obj-type      = obj-list.obj-type
     3544                 tt_report.obj-code      = obj-list.obj-code
     3545                 tt_report.doc-code      = buf_ot-line.doc-code
     3546                 tt_report.gds-code      = tt-goods.gds-code
     3547               .
     3548             end.
     3549             end.
     3550             when 're':U       or
     3551             when 'rs':U
     3552             then do:
     3553             find first tt_report where
     3554                 tt_report.ext-doc-type = "inc":U
     3555             and tt_report.obj-type      = obj-list.obj-type
     3556             and tt_report.obj-code      = obj-list.obj-code
     3557             and tt_report.doc-code      = buf_ot-line.doc-code
     3558             and tt_report.gds-code      = tt-goods.gds-code no-error .
     3559             if not available (tt_report) then do:
     3560               create tt_report.
     3561               assign
     3562                 tt_report.ext-doc-type = "inc":U
     3563                 tt_report.obj-type      = obj-list.obj-type
     3564                 tt_report.obj-code      = obj-list.obj-code
     3565                 tt_report.doc-code      = buf_ot-line.doc-code
     3566                 tt_report.gds-code      = tt-goods.gds-code
     3567               .
     3568             end.
     3569             end.
     3570             when 'ee':U           or
     3571             when 'es':U      or
     3572             when 'ep':U        or
     3573             when 'we':U           or
     3574             when 'ev':U           or
     3575             when 'em':U            or
     3576             when 'wm':U
     3577             then do:
     3578             find first tt_report where
     3579                 tt_report.ext-doc-type = "out":U
     3580             and tt_report.obj-type      = obj-list.obj-type
     3581             and tt_report.obj-code      = obj-list.obj-code
     3582             and tt_report.doc-code      = buf_ot-line.doc-code
     3583             and tt_report.gds-code      = tt-goods.gds-code no-error .
     3584             if not available (tt_report) then do:
     3585               create tt_report.
     3586               assign
     3587                 tt_report.ext-doc-type = "out":U
     3588                 tt_report.obj-type      = obj-list.obj-type
     3589                 tt_report.obj-code      = obj-list.obj-code
     3590                 tt_report.doc-code      = buf_ot-line.doc-code
     3591                 tt_report.gds-code      = tt-goods.gds-code
     3592               .
     3593             end.
     3594             end.
     3595             when 'vt':U               or
     3596             when 'vp':U          or
     3597             when 'ot':U          or
     3598             when 'ap':U    or
     3599             when 'mp':U
     3600             then do:
     3601               if x-SET_PAY_TYPE = 3 then next _ot-line.
     3602             if ( buf_ot-line.sum-base > 0 or buf_ot-line.sum-rubl > 0 ) then
     3603             do:
     3604               find first tt_report where
     3605                 tt_report.ext-doc-type = "inc":U
     3606                 and tt_report.obj-type      = obj-list.obj-type
     3607                 and tt_report.obj-code      = obj-list.obj-code
     3608                 and tt_report.doc-code      = buf_ot-line.doc-code
     3609                 and tt_report.gds-code      = tt-goods.gds-code no-error .
     3610               if not available (tt_report) then
     3611               do:
     3612                 create tt_report.
     3613                 assign
     3614                   tt_report.ext-doc-type = "inc":U
     3615                   tt_report.obj-type     = obj-list.obj-type
     3616                   tt_report.obj-code     = obj-list.obj-code
     3617                   tt_report.doc-code     = buf_ot-line.doc-code
     3618                   tt_report.gds-code     = tt-goods.gds-code
     3619                   .
     3620               end.
     3621             end.
     3622             else
     3623             do:
     3624               find first tt_report where
     3625                 tt_report.ext-doc-type = "out":U
     3626                 and tt_report.obj-type      = obj-list.obj-type
     3627                 and tt_report.obj-code      = obj-list.obj-code
     3628                 and tt_report.doc-code      = buf_ot-line.doc-code
     3629                 and tt_report.gds-code      = tt-goods.gds-code no-error .
     3630               if not available (tt_report) then
     3631               do:
     3632                 create tt_report.
     3633                 assign
     3634                   tt_report.ext-doc-type = "out":U
     3635                   tt_report.obj-type     = obj-list.obj-type
     3636                   tt_report.obj-code     = obj-list.obj-code
     3637                   tt_report.doc-code     = buf_ot-line.doc-code
     3638                   tt_report.gds-code     = tt-goods.gds-code
     3639                   .
     3640               end.
     3641             end.
     3642           end.
     3643             otherwise do:
     3644               next _ot-line.
     3645             end.
     3646           end case.
     3647           run factord-to-date in this-procedure ( input buf_ot-line.fact-order , output v-doc-date ) .
     3648           assign
     3649             tt_report.fact-order    = buf_ot-line.fact-order
     3650             tt_report.fact-date     = v-doc-date
     3651             tt_report.gds-name      = tt-goods.gds-name
     3652             tt_report.gds-sum       = abs( if v-print-rubl = yes then buf_ot-line.sum-rubl
     3653                                       else buf_ot-line.sum-base )
     3654             tt_report.tara-sum      = 0
     3655             tt_report.fact-date-str = string( v-doc-date , "99.99.9999" )
     3656             tt_report.gds-sum-str   = if tt_report.gds-sum = 0  then v-none-sym-1
     3657                                       else string( tt_report.gds-sum , "->>>,>>>,>>9.99" )
     3658             tt_report.tara-sum-str  = if tt_report.tara-sum = 0  then v-none-sym-2
     3659                                       else string( tt_report.tara-sum , "->>>,>>>,>>9.99")
     3660             tt_report.buh-1         = ""
     3661             tt_report.buh-2         = ""
     3662             v-counter               = v-counter + 1
     3663            .
     3664            release tt_report .
     3665         end.
     3666         if x-SET_PAY_TYPE = 3 then do:
     3667           _ot-line-sale :
     3668           for each buf_ot-line no-lock
     3669               where buf_ot-line.obj-type     = obj-list.obj-type
     3670                 and buf_ot-line.obj-code     = obj-list.obj-code
     3671                 and buf_ot-line.artic        = tt-goods.artic
     3672                 and buf_ot-line.prod-type    = tt-goods.prod-type
     3673                 and buf_ot-line.prod-code    = tt-goods.prod-code
     3674                 and buf_ot-line.fact-order   >= v-fact-order-1
     3675                 and buf_ot-line.fact-order   <= v-fact-order-2
     3676                 and buf_ot-line.sum-type     = 'crsa':U
     3677           :
     3678             case buf_ot-line.ext-doc-type :
     3679               when 'ie':U           or
     3680               when 'iv':U           or
     3681               when 'rv':U       or
     3682               when 'im':U
     3683               then do:
     3684             find first tt_report where
     3685                 tt_report.ext-doc-type = "out":U
     3686             and tt_report.obj-type      = obj-list.obj-type
     3687             and tt_report.obj-code      = obj-list.obj-code
     3688             and tt_report.doc-code      = buf_ot-line.doc-code
     3689             and tt_report.gds-code      = tt-goods.gds-code no-error .
     3690             if not available (tt_report) then do:
     3691               create tt_report.
     3692               assign
     3693                 tt_report.ext-doc-type = "out":U
     3694                 tt_report.obj-type      = obj-list.obj-type
     3695                 tt_report.obj-code      = obj-list.obj-code
     3696                 tt_report.doc-code      = buf_ot-line.doc-code
     3697                 tt_report.gds-code      = tt-goods.gds-code
     3698               .
     3699             end.
     3700               end.
     3701               when 'vt':U               or
     3702               when 'vp':U          or
     3703               when 'ot':U          or
     3704               when 'ap':U    or
     3705               when 'mp':U
     3706               then do:
     3707             if ( buf_ot-line.sum-base > 0 or buf_ot-line.sum-rubl > 0 ) then
     3708             do:
     3709               find first tt_report where
     3710                 tt_report.ext-doc-type = "inc":U
     3711                 and tt_report.obj-type      = obj-list.obj-type
     3712                 and tt_report.obj-code      = obj-list.obj-code
     3713                 and tt_report.doc-code      = buf_ot-line.doc-code
     3714                 and tt_report.gds-code      = tt-goods.gds-code no-error .
     3715               if not available (tt_report) then
     3716               do:
     3717                 create tt_report.
     3718                 assign
     3719                   tt_report.ext-doc-type = "inc":U
     3720                   tt_report.obj-type     = obj-list.obj-type
     3721                   tt_report.obj-code     = obj-list.obj-code
     3722                   tt_report.doc-code     = buf_ot-line.doc-code
     3723                   tt_report.gds-code     = tt-goods.gds-code
     3724                   .
     3725               end.
     3726             end.
     3727             else
     3728             do:
     3729               find first tt_report where
     3730                 tt_report.ext-doc-type = "out":U
     3731                 and tt_report.obj-type      = obj-list.obj-type
     3732                 and tt_report.obj-code      = obj-list.obj-code
     3733                 and tt_report.doc-code      = buf_ot-line.doc-code
     3734                 and tt_report.gds-code      = tt-goods.gds-code no-error .
     3735               if not available (tt_report) then
     3736               do:
     3737                 create tt_report.
     3738                 assign
     3739                   tt_report.ext-doc-type = "out":U
     3740                   tt_report.obj-type     = obj-list.obj-type
     3741                   tt_report.obj-code     = obj-list.obj-code
     3742                   tt_report.doc-code     = buf_ot-line.doc-code
     3743                   tt_report.gds-code     = tt-goods.gds-code
     3744                   .
     3745               end.
     3746             end.
     3747               end.
     3748               otherwise do:
     3749                 next _ot-line-sale.
     3750               end.
     3751             end case.
     3752             run factord-to-date in this-procedure ( input buf_ot-line.fact-order , output v-doc-date ) .
     3753             assign
     3754               tt_report.fact-order    = buf_ot-line.fact-order
     3755               tt_report.fact-date     = v-doc-date
     3756               tt_report.gds-name      = tt-goods.gds-name
     3757               tt_report.gds-sum       = abs( if v-print-rubl = yes then buf_ot-line.sum-rubl
     3758                                         else buf_ot-line.sum-base )
     3759               tt_report.tara-sum      = 0
     3760               tt_report.fact-date-str = string( v-doc-date , "99.99.9999" )
     3761               tt_report.gds-sum-str   = if tt_report.gds-sum = 0  then v-none-sym-1
     3762                                         else string( tt_report.gds-sum , "->>>,>>>,>>9.99" )
     3763               tt_report.tara-sum-str  = if tt_report.tara-sum = 0  then v-none-sym-2
     3764                                         else string( tt_report.tara-sum , "->>>,>>>,>>9.99")
     3765               tt_report.buh-1         = ""
     3766               tt_report.buh-2         = ""
     3767               v-counter               = v-counter + 1
     3768             .
     3769             release tt_report .
     3770           end.
     3771         end.
     3772       end.
     3773       create tt-report-object.
     3774       assign
     3775         tt-report-object.obj-type       = obj-list.obj-type
     3776         tt-report-object.obj-code       = obj-list.obj-code
     3777         tt-report-object.ost-gds-sum-1  = v-ost-gds-1
     3778         tt-report-object.ost-gds-sum-2  = v-ost-gds-2
     3779         v-ost-gds-1                     = 0
     3780         v-ost-gds-2                     = 0
     3781       .
     3782       v-prg:hide-bar().
     3783       delete object v-prg.
     3784       assign
     3785           v-prg = ?
     3786       .
     3787     end.
     3788     for each tt-report :
     3789       if tt-report.gds-sum = 0 and tt-report.tara-sum = 0 then delete tt-report.
     3790     end.
     3791   end.
     3792   end procedure.
     3793   procedure print-report :
     3794     define variable v-total-gds         as decimal   no-undo .
     3795     define variable v-total-tara        as decimal   no-undo .
     3796     define variable v-ost-gds-1         as decimal   no-undo .
     3797     define variable v-ost-tara-1        as decimal   no-undo .
     3798     define variable v-ost-gds-2         as decimal   no-undo .
     3799     define variable v-ost-tara-2        as decimal   no-undo .
     3800     define variable v-ost-gds-str-1     as character no-undo .
     3801     define variable v-ost-tara-str-1    as character no-undo .
     3802     define variable v-ost-gds-str-2     as character no-undo .
     3803     define variable v-ost-tara-str-2    as character no-undo .
     3804     define variable v-total-gds-str     as character no-undo .
     3805     define variable v-total-tara-str    as character no-undo .
     3806     define variable v-itog-s-ost-gds    as decimal   no-undo .
     3807     define variable v-itog-s-ost-tara   as decimal   no-undo .
     3808     define variable v-avt-ovt-gds       as decimal   no-undo .
     3809     define variable v-avt-ovt-tara      as decimal   no-undo .
     3810     define variable v-avt-ovt-gds-str   as character no-undo .
     3811     define variable v-avt-ovt-tara-str  as character no-undo .
     3812   do
     3813   on error undo, return error return-value
     3814   :
     3815     view stream out-stream frame BottomFrame .
     3816     run print-header-list-1 in this-procedure .
     3817     for each tt-report-object :
     3818       assign
     3819         v-ost-gds-1   = v-ost-gds-1  + tt-report-object.ost-gds-sum-1
     3820         v-ost-tara-1  = v-ost-tara-1 + tt-report-object.ost-tara-sum-1
     3821         v-ost-gds-2   = v-ost-gds-2  + tt-report-object.ost-gds-sum-2
     3822         v-ost-tara-2  = v-ost-tara-2 + tt-report-object.ost-tara-sum-2
     3823       .
     3824     end.
     3825     assign
     3826       v-ost-gds-str-1   = if v-ost-gds-1  = 0 then p-fmt-align-string( "---":U , 15 , "center")
     3827                           else string( v-ost-gds-1  , "->>>,>>>,>>9.99":U )
     3828       v-ost-tara-str-1  = if v-ost-tara-1 = 0 then p-fmt-align-string( "---":U , 15 , "center")
     3829                           else string( v-ost-tara-1 , "->>>,>>>,>>9.99":U )
     3830       v-ost-gds-str-2   = if v-ost-gds-2  = 0 then p-fmt-align-string( "---":U , 15 , "center")
     3831                           else string( v-ost-gds-2  , "->>>,>>>,>>9.99":U )
     3832       v-ost-tara-str-2  = if v-ost-tara-2 = 0 then p-fmt-align-string( "---":U , 15 , "center")
     3833                           else string( v-ost-tara-2 , "->>>,>>>,>>9.99":U )
     3834     .
     3835       display stream out-stream
     3836         sym1
     3837         substitute("Остаток на &1" , w-date( x-Date-Start ))  @ tt-report.gds-name
     3838         sym2
     3839         p-fmt-align-string( "X":U , 10 , "center") @ tt-report.fact-date-str
     3840         sym3
     3841         p-fmt-align-string( "X":U , 20 , "center") @ tt-report.doc-code
     3842         sym4
     3843         v-ost-gds-str-1 @ tt-report.gds-sum-str
     3844         sym5
     3845         v-ost-tara-str-1 @ tt-report.tara-sum-str
     3846         sym6
     3847         sym7
     3848         sym8
     3849       with frame torg29.
     3850       down stream out-stream with frame torg29.
     3851       display stream out-stream
     3852         sym1
     3853         p-fmt-align-string( "Приход" , 30 , "center")  @ tt-report.gds-name
     3854         sym2
     3855         sym3
     3856         sym4
     3857         sym5
     3858         sym6
     3859         sym7
     3860         sym8
     3861       with frame torg29.
     3862       down stream out-stream with frame torg29.
     3863       run torg29xl-sheet1-write-line-data ( input substitute("Остаток на &1" , w-date( x-Date-Start ))
     3864                                           , input "X":U
     3865                                           , input "X":U
     3866                                           , input trim( v-ost-gds-str-1  )
     3867                                           , input trim( v-ost-tara-str-1 )
     3868                                           , input " ":U
     3869                                           , input " ":U
     3870                                           ) .
     3871       run torg29xl-sheet1-write-line-data ( input "Приход"
     3872                                           , input " ":U
     3873                                           , input " ":U
     3874                                           , input " ":U
     3875                                           , input " ":U
     3876                                           , input " ":U
     3877                                           , input " ":U
     3878                                           ) .
     3879       for each tt-report
     3880         where tt-report.ext-doc-type = "inc":U
     3881       by tt-report.fact-order
     3882       by tt-report.obj-type
     3883       by tt-report.obj-code
     3884       :
     3885         display stream out-stream
     3886           sym1
     3887           tt-report.gds-name
     3888           sym2
     3889           tt-report.fact-date-str
     3890           sym3
     3891           tt-report.doc-code
     3892           sym4
     3893           tt-report.gds-sum-str
     3894           sym5
     3895           tt-report.tara-sum-str
     3896           sym6
     3897           tt-report.buh-1
     3898           sym7
     3899           tt-report.buh-2
     3900           sym8
     3901         with frame torg29.
     3902         down stream out-stream with frame torg29.
     3903         run torg29xl-sheet1-write-line-data ( input tt-report.gds-name
     3904                                             , input tt-report.fact-date-str
     3905                                             , input tt-report.doc-code
     3906                                             , input trim(tt-report.gds-sum-str)
     3907                                             , input trim(tt-report.tara-sum-str)
     3908                                             , input tt-report.buh-1
     3909                                             , input tt-report.buh-2
     3910                                             ) .
     3911         assign
     3912           v-total-gds  = v-total-gds  + tt-report.gds-sum
     3913           v-total-tara = v-total-tara + tt-report.tara-sum
     3914         .
     3915       end.
     3916       put stream out-stream v-line format "X(128)" skip.
     3917       assign
     3918         v-total-gds-str   = if v-total-gds  = 0 then p-fmt-align-string( "---":U , 15 , "center")
     3919                             else string( v-total-gds , "->>>,>>>,>>9.99":U )
     3920         v-total-tara-str  = if v-total-tara = 0 then p-fmt-align-string( "---":U , 15 , "center")
     3921                             else string( v-total-tara , "->>>,>>>,>>9.99":U )
     3922       .
     3923       display stream out-stream
     3924         sym1
     3925         "Итого по приходу" @ tt-report.gds-name
     3926         sym2
     3927         p-fmt-align-string( "X":U , 10 , "center") @ tt-report.fact-date-str
     3928         sym3
     3929         p-fmt-align-string( "X":U , 20 , "center") @ tt-report.doc-code
     3930         sym4
     3931         v-total-gds-str @ tt-report.gds-sum-str
     3932         sym5
     3933         v-total-tara-str @ tt-report.tara-sum-str
     3934         sym6
     3935         sym7
     3936         sym8
     3937       with frame torg29.
     3938       down stream out-stream with frame torg29.
     3939       put stream out-stream v-line format "X(128)" skip.
     3940       run torg29xl-write-cell-data in this-procedure ( input "f_incomegds":U  , input trim(v-total-gds-str)  ).
     3941       run torg29xl-write-cell-data in this-procedure ( input "f_incometara":U , input trim(v-total-tara-str) ).
     3942       assign
     3943         v-total-gds-str   = if (v-ost-gds-1 + v-total-gds) = 0 then
     3944                               p-fmt-align-string( "---":U , 15 , "center")
     3945                             else
     3946                               string( (v-ost-gds-1 + v-total-gds) , "->>>,>>>,>>9.99":U )
     3947         v-total-tara-str  = if (v-ost-tara-1 + v-total-tara) = 0 then
     3948                               p-fmt-align-string( "---":U , 15 , "center")
     3949                             else
     3950                               string( (v-ost-tara-1 + v-total-tara) , "->>>,>>>,>>9.99":U )
     3951         v-itog-s-ost-gds  = (v-ost-gds-1 + v-total-gds)
     3952         v-itog-s-ost-tara = (v-ost-tara-1 + v-total-tara)
     3953       .
     3954       display stream out-stream
     3955         sym1
     3956         "Итого с остатком" @ tt-report.gds-name
     3957         sym2
     3958         p-fmt-align-string( "X":U , 10 , "center") @ tt-report.fact-date-str
     3959         sym3
     3960         p-fmt-align-string( "X":U , 20 , "center") @ tt-report.doc-code
     3961         sym4
     3962         v-total-gds-str @ tt-report.gds-sum-str
     3963         sym5
     3964         v-total-tara-str @ tt-report.tara-sum-str
     3965         sym6
     3966         sym7
     3967         sym8
     3968       with frame torg29.
     3969       down stream out-stream with frame torg29.
     3970       put stream out-stream v-line format "X(128)" skip.
     3971       run torg29xl-write-cell-data in this-procedure ( input "f_incostgds":U  , input trim(v-total-gds-str)  ).
     3972       run torg29xl-write-cell-data in this-procedure ( input "f_incosttara":U , input trim(v-total-tara-str) ).
     3973     hide stream out-stream frame BottomFrame .
     3974     page stream out-stream.
     3975     view stream out-stream frame BottomFrame .
     3976     run print-header-list-2 in this-procedure .
     3977       display stream out-stream
     3978         sym1
     3979         p-fmt-align-string( "Расход" , 30 , "center")  @ tt-report.gds-name
     3980         sym2
     3981         p-fmt-align-string( "X":U , 10 , "center") @ tt-report.fact-date-str
     3982         sym3
     3983         p-fmt-align-string( "X":U , 20 , "center") @ tt-report.doc-code
     3984         sym4
     3985         sym5
     3986         sym6
     3987         sym7
     3988         sym8
     3989       with frame torg29.
     3990       down stream out-stream with frame torg29.
     3991       run torg29xl-sheet2-write-line-data ( input "Расход":U
     3992                                           , input " ":U
     3993                                           , input " ":U
     3994                                           , input " ":U
     3995                                           , input " ":U
     3996                                           , input " ":U
     3997                                           , input " ":U
     3998                                           ) .
     3999       assign
     4000         v-total-gds  = 0
     4001         v-total-tara = 0
     4002       .
     4003       for each tt-report
     4004         where tt-report.ext-doc-type = "out":U
     4005       by tt-report.gds-code
     4006       by tt-report.fact-order
     4007       by tt-report.obj-type
     4008       by tt-report.obj-code
     4009       :
     4010         display stream out-stream
     4011           sym1
     4012           tt-report.gds-name
     4013           sym2
     4014           tt-report.fact-date-str
     4015           sym3
     4016           tt-report.doc-code
     4017           sym4
     4018           tt-report.gds-sum-str
     4019           sym5
     4020           tt-report.tara-sum-str
     4021           sym6
     4022           tt-report.buh-1
     4023           sym7
     4024           tt-report.buh-2
     4025           sym8
     4026         with frame torg29.
     4027         down stream out-stream with frame torg29.
     4028         run torg29xl-sheet2-write-line-data ( input tt-report.gds-name
     4029                                             , input tt-report.fact-date-str
     4030                                             , input tt-report.doc-code
     4031                                             , input trim(tt-report.gds-sum-str)
     4032                                             , input trim(tt-report.tara-sum-str)
     4033                                             , input tt-report.buh-1
     4034                                             , input tt-report.buh-2
     4035                                             ) .
     4036         assign
     4037           v-total-gds  = v-total-gds  + tt-report.gds-sum
     4038           v-total-tara = v-total-tara + tt-report.tara-sum
     4039         .
     4040       end.
     4041       if x-SET_PAY_TYPE = 3 then do:
     4042         assign
     4043           v-avt-ovt-gds       = v-itog-s-ost-gds  - (v-total-gds + v-ost-gds-2)
     4044           v-avt-ovt-tara      = v-itog-s-ost-tara - (v-total-tara + v-ost-tara-2)
     4045           v-avt-ovt-gds-str   = if v-avt-ovt-gds = 0 then p-fmt-align-string( "---":U , 15 , "center")
     4046                                 else string( v-avt-ovt-gds , "->>>,>>>,>>9.99":U )
     4047           v-avt-ovt-tara-str  = if v-avt-ovt-tara = 0 then p-fmt-align-string( "---":U , 15 , "center")
     4048                                 else string( v-avt-ovt-tara , "->>>,>>>,>>9.99":U )
     4049         .
     4050       end.
     4051       else do:
     4052         assign
     4053           v-avt-ovt-gds       = 0
     4054           v-avt-ovt-tara      = 0
     4055           v-avt-ovt-gds-str   = p-fmt-align-string( "---":U , 15 , "center")
     4056           v-avt-ovt-tara-str  = p-fmt-align-string( "---":U , 15 , "center")
     4057         .
     4058       end.
     4059       assign
     4060         v-total-gds         = v-total-gds  + v-avt-ovt-gds
     4061         v-total-tara        = v-total-tara + v-avt-ovt-tara
     4062         v-total-gds-str     = if v-total-gds  = 0 then p-fmt-align-string( "---":U , 15 , "center")
     4063                               else string( v-total-gds , "->>>,>>>,>>9.99":U )
     4064         v-total-tara-str    = if v-total-tara = 0 then p-fmt-align-string( "---":U , 15 , "center")
     4065                               else string( v-total-tara , "->>>,>>>,>>9.99":U )
     4066       .
     4067       if x-SET_PAY_TYPE = 3 and ( v-avt-ovt-gds <> 0 or v-avt-ovt-tara <> 0 ) then do:
     4068         put stream out-stream v-line format "X(128)" skip.
     4069         display stream out-stream
     4070           sym1
     4071           "Автоматическая переоценка" @ tt-report.gds-name
     4072           sym2
     4073           p-fmt-align-string( "X":U , 10 , "center") @ tt-report.fact-date-str
     4074           sym3
     4075           p-fmt-align-string( "X":U , 20 , "center") @ tt-report.doc-code
     4076           sym4
     4077           v-avt-ovt-gds-str @ tt-report.gds-sum-str
     4078           sym5
     4079           v-avt-ovt-tara-str @ tt-report.tara-sum-str
     4080           sym6
     4081           sym7
     4082           sym8
     4083         with frame torg29.
     4084         down stream out-stream with frame torg29.
     4085         run torg29xl-sheet2-write-line-data ( input "Автоматическая переоценка":U
     4086                                             , input "X":U
     4087                                             , input "X":U
     4088                                             , input trim(v-avt-ovt-gds-str)
     4089                                             , input trim(v-avt-ovt-tara-str)
     4090                                             , input ""
     4091                                             , input ""
     4092                                             ) .
     4093       end.
     4094       put stream out-stream v-line format "X(128)" skip.
     4095       display stream out-stream
     4096         sym1
     4097         "Итого по расходу" @ tt-report.gds-name
     4098         sym2
     4099         p-fmt-align-string( "X":U , 10 , "center") @ tt-report.fact-date-str
     4100         sym3
     4101         p-fmt-align-string( "X":U , 20 , "center") @ tt-report.doc-code
     4102         sym4
     4103         v-total-gds-str @ tt-report.gds-sum-str
     4104         sym5
     4105         v-total-tara-str @ tt-report.tara-sum-str
     4106         sym6
     4107         sym7
     4108         sym8
     4109       with frame torg29.
     4110       down stream out-stream with frame torg29.
     4111       put stream out-stream v-line format "X(128)" skip.
     4112       display stream out-stream
     4113         sym1
     4114         substitute("Остаток на &1 " , w-date(x-Date-End) )  @ tt-report.gds-name
     4115         sym2
     4116         p-fmt-align-string( "X":U , 10 , "center") @ tt-report.fact-date-str
     4117         sym3
     4118         p-fmt-align-string( "X":U , 20 , "center") @ tt-report.doc-code
     4119         sym4
     4120         v-ost-gds-str-2 @ tt-report.gds-sum-str
     4121         sym5
     4122         v-ost-tara-str-2 @ tt-report.tara-sum-str
     4123         sym6
     4124         sym7
     4125         sym8
     4126       with frame torg29.
     4127       down stream out-stream with frame torg29.
     4128       put stream out-stream v-line format "X(128)" skip(2).
     4129       run torg29xl-write-cell-data in this-procedure ( input "f_expgds":U       , input trim(v-total-gds-str)  ).
     4130       run torg29xl-write-cell-data in this-procedure ( input "f_exptara":U      , input trim(v-total-tara-str) ).
     4131       run torg29xl-write-cell-data in this-procedure ( input "f_expostdateend":U, input substitute("Остаток на &1 " , w-date(x-Date-End) )  ).
     4132       run torg29xl-write-cell-data in this-procedure ( input "f_expostgds":U    , input trim(v-ost-gds-str-2)  ).
     4133       run torg29xl-write-cell-data in this-procedure ( input "f_exposttara":U   , input trim(v-ost-tara-str-2) ).
     4134     run print-footer-list-2 in this-procedure .
     4135     hide stream out-stream frame BottomFrame .
     4136   end.
     4137   end procedure.
     4138   function w-date returns character ( input p-date as date ) .
     4139   do
     4140   on error undo, return error
     4141   :
     4142     define variable month-str as character init "января;февраля;марта;апреля;мая;июня;июля;августа;сентября;октября;ноября;декабря":U no-undo.
     4143     return ( string( DAY( p-date ) ) + " " + entry( month( p-date ) , month-str , ";" ) + " " + string( year( p-date ) ) + " г." ).
     4144   end.
     4145   end function.
