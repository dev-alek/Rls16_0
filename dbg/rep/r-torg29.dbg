     2586   procedure torg29xl-init :
     2587   do
     2588   on error undo, return error
     2589   :
     2590       assign
     2591           v-torg29xl-sheet1-cur-data-row = 0
     2592           v-torg29xl-sheet2-cur-data-row = 0
     2593       .
     2594       run gbl/_tmpfile.p (
     2595             input "xd"
     2596           , input ".txt"
     2597           , output v-torg29xl-data-file-name
     2598       ).
     2599       output stream excel-line to value( v-torg29xl-data-file-name ).
     2600       run gbl/_tmpfile.p (
     2601             input "xc"
     2602           , input ".txt"
     2603           , output v-torg29xl-cell-file-name
     2604       ).
     2605       output stream excel-cell to value( v-torg29xl-cell-file-name ).
     2606       run torg29xl-write-cell-data in this-procedure (
     2607             input "sheetList":U
     2608           , input "лист1,лист2":U
     2609       ).
     2610       if printrubl
     2611       then do:
     2612           run torg29xl-write-cell-data in this-procedure (
     2613                 input "лист1_valutCode":U
     2614               , input "0":U
     2615           ).
     2616           run torg29xl-write-cell-data in this-procedure (
     2617                 input "лист2_valutCode":U
     2618               , input "0":U
     2619           ).
     2620       end.
     2621       else do:
     2622           run torg29xl-write-cell-data in this-procedure (
     2623                 input "лист1_valutCode":U
     2624               , input "1":U
     2625           ).
     2626           run torg29xl-write-cell-data in this-procedure (
     2627                 input "лист2_valutCode":U
     2628               , input "1":U
     2629           ).
     2630       end.
     2631       run torg29xl-write-cell-data in this-procedure (
     2632             input "лист1_columnList":U
     2633           , input "gdsname,docdate,doccode,gdssum,tarasum,buhone,buhtwo":U
     2634       ).
     2635       run torg29xl-write-cell-data in this-procedure (
     2636             input "лист1_columnType":U
     2637           , input "S,S,S,S,S,S,S":U
     2638       ).
     2639       run torg29xl-write-cell-data in this-procedure (
     2640             input "лист1_subtotalList":U
     2641           , input "":U
     2642       ).
     2643       run torg29xl-write-cell-data in this-procedure (
     2644             input "лист1_subtotalType":U
     2645           , input "":U
     2646       ).
     2647       run torg29xl-write-cell-data in this-procedure (
     2648             input "лист2_columnList":U
     2649           , input "gdsname,docdate,doccode,gdssum,tarasum,buhone,buhtwo":U
     2650       ).
     2651       run torg29xl-write-cell-data in this-procedure (
     2652             input "лист2_columnType":U
     2653           , input "S,S,S,S,S,S,S":U
     2654       ).
     2655       run torg29xl-write-cell-data in this-procedure (
     2656             input "лист2_subtotalList":U
     2657           , input "":U
     2658       ).
     2659       run torg29xl-write-cell-data in this-procedure (
     2660             input "лист2_subtotalType":U
     2661           , input "":U
     2662       ).
     2663   end.
     2664   end procedure.
     2665   procedure torg29xl-sheet1-write-line-data :
     2666   define input parameter p-gdsname as character        no-undo.
     2667   define input parameter p-docdate as character        no-undo.
     2668   define input parameter p-doccode as character        no-undo.
     2669   define input parameter p-gdssum  as character        no-undo.
     2670   define input parameter p-tarasum as character        no-undo.
     2671   define input parameter p-buhone  as character        no-undo.
     2672   define input parameter p-buhtwo  as character        no-undo.
     2673       define buffer buf_temp_sheet1_line-data        for temp_sheet1_line-data.
     2674   do
     2675   for buf_temp_sheet1_line-data
     2676   on error undo, return error
     2677   :
     2678       for each buf_temp_sheet1_line-data
     2679       :
     2680           delete buf_temp_sheet1_line-data.
     2681       end.
     2682       create buf_temp_sheet1_line-data.
     2683       assign
     2684           v-torg29xl-sheet1-cur-data-row       = v-torg29xl-sheet1-cur-data-row + 1
     2685           buf_temp_sheet1_line-data.sheet-name = "лист1":U
     2686           buf_temp_sheet1_line-data.xl-line-id = v-torg29xl-sheet1-cur-data-row
     2687           buf_temp_sheet1_line-data.gdsname    = p-gdsname
     2688           buf_temp_sheet1_line-data.docdate    = p-docdate
     2689           buf_temp_sheet1_line-data.doccode    = p-doccode
     2690           buf_temp_sheet1_line-data.gdssum     = p-gdssum
     2691           buf_temp_sheet1_line-data.tarasum    = p-tarasum
     2692           buf_temp_sheet1_line-data.buhone     = p-buhone
     2693           buf_temp_sheet1_line-data.buhtwo     = p-buhtwo
     2694       .
     2695       put stream excel-line unformatted
     2696                           buf_temp_sheet1_line-data.sheet-name
     2697           CHR(9)   "DTA":U
     2698           CHR(9)   buf_temp_sheet1_line-data.gdsname
     2699           CHR(9)   buf_temp_sheet1_line-data.docdate
     2700           CHR(9)   buf_temp_sheet1_line-data.doccode
     2701           CHR(9)   buf_temp_sheet1_line-data.gdssum
     2702           CHR(9)   buf_temp_sheet1_line-data.tarasum
     2703           CHR(9)   buf_temp_sheet1_line-data.buhone
     2704           CHR(9)   buf_temp_sheet1_line-data.buhtwo
     2705           chr(10)
     2706       .
     2707       .
     2708   end.
     2709   end procedure.
     2710   procedure torg29xl-sheet2-write-line-data :
     2711   define input parameter p-gdsname as character        no-undo.
     2712   define input parameter p-docdate as character        no-undo.
