     2756   procedure torg29xl-write-cell-data :
     2757   define input parameter p-data-key   as character        no-undo.
     2758   define input parameter p-data-value as character        no-undo.
     2759       define buffer buf_temp_cell-data     for temp_cell-data.
     2760   do
     2761   for buf_temp_cell-data
     2762   on error undo, return error
     2763   :
     2764       find first buf_temp_cell-data
     2765            where buf_temp_cell-data.data-key = p-data-key
     2766       no-error.
     2767       if not available buf_temp_cell-data
     2768       then do:
     2769           create buf_temp_cell-data.
     2770           assign
     2771               buf_temp_cell-data.data-key = p-data-key
     2772           .
     2773       end.
     2774       assign
     2775           buf_temp_cell-data.data-value = p-data-value
     2776       .
     2777       put stream excel-cell unformatted
     2778                           buf_temp_cell-data.data-key
     2779           CHR(9)   buf_temp_cell-data.data-value
     2780           chr(10)
     2781       .
     2782   end.
     2783   end procedure.
     2784   procedure torg29xl-run-excel :
     2785   define input parameter p-header-filename    as character        no-undo.
     2786   define input parameter p-data-filename      as character        no-undo.
     2787       define variable v-template-file-name    as character    no-undo.
     2788       define variable v-vb-file-name          as character    no-undo.
     2789       define buffer buf_temp-param for temp-param .
     2790   do
     2791   for buf_temp-param
     2792   on error undo, return error
     2793   :
     2794       create buf_temp-param.
     2795       assign
     2796           v-template-file-name    = search( "exe/torg29.xlt" )
     2797           v-vb-file-name          = search( "exe/t_form.bas")
     2798       .
     2799       if v-template-file-name = ?
     2800       or v-template-file-name = "":U
     2801       then do:
     2802           message
     2803               "Ошибка имени файла шаблона."
     2804           view-as alert-box error.
     2805       end.
     2806       if v-vb-file-name = ?
     2807       or v-vb-file-name = "":U
     2808       then do:
     2809           message
     2810               "Ошибка имени файла кода обработки."
     2811           view-as alert-box error.
     2812       end.
     2813       run paramls-write in this-procedure (
     2814             input "template":U
     2815           , input "template-file-name":U
     2816           , input v-template-file-name
     2817       ).
     2818       run paramls-write in this-procedure (
     2819             input "template":U
     2820           , input "vb-file-name":U
     2821           , input v-vb-file-name
     2822       ).
     2823       run paramls-write in this-procedure (
     2824             input "data":U
     2825           , input "data-header-filename":U
     2826           , input p-header-filename
     2827       ).
     2828       run paramls-write in this-procedure (
     2829             input "data":U
     2830           , input "data-filename":U
     2831           , input p-data-filename
     2832       ).
     2833       run gbl/macroxlt.p (
     2834           input-output table buf_temp-param
     2835       ) no-error.
     2836       if error-status :error
     2837       then do:
     2838           message
     2839                    vss-workfile vss-revision vss-description
     2840               skip(1)
     2841               skip "Ошибка создания файла Excel."
     2842               skip return-value
     2843               skip trim(error-status :get-message(1))
     2844                    trim(error-status :get-message(2))
     2845                    trim(error-status :get-message(3))
     2846           view-as alert-box error.
     2847           undo, return error .
     2848       end.
     2849   end.
     2850   end procedure.
     2851   procedure torg29xl-close :
     2852   do
     2853   on error undo, return error
     2854   :
     2855       output stream excel-line close.
     2856       output stream excel-cell close.
     2857       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) .
     2858           export "exe/torg29.xlt":U.
     2859           export "exe/t_form.bas":U.
     2860           export v-torg29xl-cell-file-name.
     2861           export v-torg29xl-data-file-name.
     2862       output close.
     2863   end.
     2864   end procedure.
     2865   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2866     define variable v-cntxt-db-num        as integer   no-undo .
