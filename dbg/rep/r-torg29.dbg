     2923   define variable v-host-code-1 like ub.clients.host-code no-undo .
     2924   define variable v-host-code-2 like ub.clients.host-code no-undo .
     2925   function w-date returns character ( input p-date as date ) forward .
     2926   define frame torg29
     2927     sym1                            no-label format "X(1)"                          space(0)
     2928     tt-report.gds-name              no-label format "X(30)":U                   space(0)
     2929     sym2                            no-label format "X(1)"                          space(0)
     2930     tt-report.fact-date-str         no-label format "X(10)":U                   space(0)
     2931     sym3                            no-label format "X(1)"                          space(0)
     2932     tt-report.doc-code              no-label format "X(20)":U                   space(0)
     2933     sym4                            no-label format "X(1)"                          space(0)
     2934     tt-report.gds-sum-str           no-label format "X(15)":U                   space(0)
     2935     sym5                            no-label format "X(1)"                          space(0)
     2936     tt-report.tara-sum-str          no-label format "X(15)":U                   space(0)
     2937     sym6                            no-label format "X(1)"                          space(0)
     2938     tt-report.buh-1                 no-label format "X(15)":U                   space(0)
     2939     sym7                            no-label format "X(1)"                          space(0)
     2940     tt-report.buh-2                 no-label format "X(15)":U                   space(0)
     2941     sym8                            no-label format "X(1)"                          space(0)
     2942   header
     2943       ":------------------------------:----------:--------------------:---------------:---------------:-------------------------------:":U skip
     2944       ":               1              :     2    :          3         :       4       :       5       :       6       :        7      :":U skip
     2945   with width 128 down stream-io no-label no-box.
     2946   form header
     2947           v-line format "X(128)" at 1 SKIP
     2948           "Продолжение - на следующей странице" at 1 SKIP
     2949   with frame BottomFrame width 198 PAGE-BOTTOM NO-LABELS NO-BOX .
     2950   do on error undo, return error return-value
     2951   :
     2952   if session :set-wait-state( "compiler" ) then.
     2953     run clear-tt in this-procedure .
     2954   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2955     run mainmenu_getcntxt in parparentproc
     2956       (output v-cntxt-db-num
     2957       ,output v-cntxt-userid
     2958       ,output v-cntxt-level
     2959       ,output v-cntxt-host-code-obj
     2960       ,output v-cntxt-obj-type
     2961       ,output v-cntxt-obj-code
     2962       ,output v-cntxt-db-num-obj
     2963       ,output v-cntxt-is-admin
     2964       ) .
     2965     assign
     2966       v-line = fill( "-" , 300 )
     2967     .
     2968     case x-SET_val_TYPE :
     2969       when 1 then do:
     2970         assign
     2971           v-print-rubl = yes
     2972         .
     2973       end.
     2974       when 2 then do:
     2975         assign
     2976           v-print-rubl = no
     2977         .
     2978       end.
     2979       otherwise do:
     2980         if x-SET_PAY_TYPE <> 1 then do:
     2981           message "Неизвестный тип валюты!" skip "Отчет формируется в базовой валюте" view-as alert-box information .
     2982         end.
     2983   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2984   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2985     (output v-curr-r-b
     2986     )  .
     2987         assign
     2988           v-print-rubl = ( v-curr-r-b = 'rubl':U )
     2989         .
     2990       end.
     2991     end case.
     2992     find first obj-list no-error .
     2993     if not available obj-list then do:
     2994       message
     2995         "Не указан объект для формирования отчета!"
     2996       view-as alert-box error.
     2997       undo, return error.
     2998     end.
