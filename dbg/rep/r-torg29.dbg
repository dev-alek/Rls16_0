      576   define variable sym2  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      577   define variable sym3  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      578   define variable sym4  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      579   define variable sym5  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      580   define variable sym6  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      581   define variable sym7  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      582   define variable sym8  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      583   define variable sym9  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      584   define variable sym10 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      585   define variable sym11 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      586   define variable sym12 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      587   define variable sym13 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      588   define variable sym14 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      589   define variable sym15 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      590   define variable sym16 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      591   define variable sym17 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      592   define variable sym18 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      593   define variable sym19 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      594   define variable sym20 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      595   define variable sym21 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      596   define variable sym22 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      597   define variable sym23 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      598   define variable sym24 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      599   define variable sym25 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      600   define variable sym26 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      601   define variable sym27 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      602   define variable temp1 as integer   no-undo.
      603   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      604   procedure factord :
      605     define input  parameter p-fact-date            as date    no-undo .
      606     define input  parameter p-fact-time            as integer no-undo .
      607     define input  parameter p-fact-num             as integer no-undo .
      608     define input  parameter p-shift-date           as date    no-undo .
      609     define input  parameter p-shift-num            as integer no-undo .
      610     define input  parameter p-shift-on             as logical no-undo .
      611     define output parameter p-fact-order           as decimal no-undo .
      612     define output parameter p-shift-end-fact-order as decimal no-undo .
      613     define output parameter p-day-end-fact-order   as decimal no-undo .
      614     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      615     if p-fact-date = ?
      616     then do:
      617       return error "Не указана фактическая дата" .
      618     end.
      619     define variable v-fact-date-num as integer no-undo .
      620     assign
      621       v-fact-date-num = integer(p-fact-date)
      622     .
      623     if p-fact-num = ?
      624     or p-fact-num = 0
      625     then do:
      626       return error "Не задан p-fact-num " + string(p-fact-num) .
      627     end.
      628     if p-fact-num < 0
      629     then do:
      630       return error "Отрицательный fact-num " + string(p-fact-num) .
      631     end.
      632     if p-fact-num >= 100000000
      633     then do:
      634       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      635     end.
      636     if p-shift-on = true
      637     then do:
      638       if p-shift-date = ?
      639       then do:
      640         return error "Не задана дата смены" .
      641       end.
      642       if p-shift-num = ?
      643       or p-shift-num = 0
      644       then do:
      645         return error "Не задан номер смены" .
      646       end.
      647     end.
      648     else do:
      649       assign
      650         p-shift-date = p-fact-date
      651         p-shift-num  = 24
      652       .
      653     end.
      654     define variable v-shift-offset as integer no-undo .
      655     if p-shift-date = p-fact-date
      656     then do:
      657       assign
      658         v-shift-offset = 1
      659       .
      660     end.
      661     if p-shift-date < p-fact-date
      662     then do:
      663       assign
      664         v-shift-offset = 0
      665       .
      666     end.
      667     if p-shift-date > p-fact-date
      668     then do:
      669       message
      670         vss-workfile vss-revision vss-description skip
      671         "Неправильная дата закрытия смены" skip
      672         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      673         view-as alert-box error .
      674       undo, return error
      675         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      676           ,string(p-fact-date, '99/99/9999':U)
      677           ,string(p-shift-date, '99/99/9999':U)
      678           )
      679       .
      680     end.
      681     if p-shift-num < 1
      682     or p-shift-num > 24
      683     then do:
      684       message
      685         vss-workfile vss-revision vss-description skip
      686         "Неправильный номер смены" skip
      687         "p-shift-num" p-shift-num skip
      688         view-as alert-box error .
      689       undo, return error return-value .
      690     end.
      691     assign
      692       p-fact-order           = v-fact-date-num
      693                              + v-shift-offset * 0.5
      694                              + p-shift-num    * 0.02 - 0.01
      695                              + p-fact-num     * 0.0000000001
      696       p-shift-end-fact-order = v-fact-date-num
      697                              + v-shift-offset * 0.5
      698                              + p-shift-num    * 0.02
      699       p-day-end-fact-order   = v-fact-date-num
      700                              + 0.99
      701     .
      702     if p-fact-order           <= v-fact-date-num
      703     or p-shift-end-fact-order <= v-fact-date-num
      704     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      705     or p-shift-end-fact-order >= p-day-end-fact-order
      706     then do:
      707       message
      708         vss-workfile vss-revision vss-description skip
      709         "Внутренняя ошибка при генерации фактического номера" skip
      710         "p-fact-date"            p-fact-date            skip
      711         "p-fact-time"            p-fact-time            skip
      712         "p-fact-num"             p-fact-num             skip
      713         "p-shift-date"           p-shift-date           skip
      714         "p-shift-num"            p-shift-num            skip
      715         "p-shift-on"             p-shift-on             skip
      716         "p-shift-end-fact-order" p-shift-end-fact-order skip
      717         "p-day-end-fact-order"   p-day-end-fact-order   skip
      718         "v-fact-date-num"        v-fact-date-num        skip
      719         view-as alert-box error .
      720       undo, return error return-value .
      721     end.
      722   end procedure.
      723   procedure day-begin-fact-order :
      724     define input  parameter p-fact-date            as date    no-undo .
      725     define output parameter p-day-begin-fact-order as decimal no-undo .
      726     do
      727     on error undo, return error return-value
      728     :
      729       if p-fact-date = ?
      730       then do:
      731         assign
      732           p-day-begin-fact-order = 0
      733         .
      734       end.
      735       else do:
      736         assign
      737           p-day-begin-fact-order = integer(p-fact-date)
      738         .
      739       end.
      740     end.
      741   end procedure.
      742   procedure factord-max-fact-order :
      743     define output parameter p-max-fact-order as decimal   no-undo .
      744     do
      745     on error undo, return error return-value
      746     :
      747       run day-begin-fact-order in this-procedure
      748         (input  date(1, 1, 5000)
      749         ,output p-max-fact-order
      750         ) .
      751     end.
      752   end procedure.
      753   procedure factord-cut-archive :
      754     define input  parameter p-obj-type             as character no-undo .
      755     define input  parameter p-obj-code             as integer   no-undo .
      756     define input  parameter p-fact-date            as date      no-undo .
      757     define output parameter p-shift-on             as logical   no-undo .
      758     define output parameter p-shift-date           as date      no-undo .
      759     define output parameter p-shift-num            as integer   no-undo .
      760     define output parameter p-day-end-fact-order   as decimal   no-undo .
      761     define output parameter p-shift-end-fact-order as decimal   no-undo .
      762     define variable v-fact-order as decimal   no-undo .
      763     define buffer buf_shift-obj for ub.shift-obj .
      764     do
      765     on error undo, return error return-value
      766     :
      767   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      768   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      769     (input  p-obj-type
      770     ,input  p-obj-code
      771     ,input  'shift-on=request'
      772     ,output p-shift-on
      773     ) no-error .
      774       if error-status :error
      775       then do:
      776         message
      777           vss-workfile vss-revision vss-description skip
      778           "Ошибка при определении атрибута объекта" skip
      779           "Объект" p-obj-type p-obj-code skip
      780           error-status :get-message(1) skip
      781           return-value skip
      782           view-as alert-box error .
      783         undo, return error return-value .
      784       end.
      785       if p-shift-on = false
      786       then do:
      787         assign
      788           p-shift-date               = ?
      789           p-shift-num                = 0
      790         .
      791       end.
      792       else do:
      793         find first buf_shift-obj share-lock
      794           where buf_shift-obj.obj-type   = p-obj-type
      795             and buf_shift-obj.obj-code   = p-obj-code
      796             and buf_shift-obj.shift-date > p-fact-date
      797           use-index pi
      798           no-error .
      799         if not available buf_shift-obj
      800         or buf_shift-obj.status_ <> 'зкр':U
      801         then do:
      802           message
      803             vss-workfile vss-revision vss-description skip
      804             "Невозможно вычислить последнюю смену" skip
      805             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      806             "Объект" p-obj-type p-obj-code skip
      807             "Дата" p-fact-date skip
      808             view-as alert-box error .
      809           undo, return error return-value .
      810         end.
      811         find last buf_shift-obj share-lock
      812           where buf_shift-obj.obj-type = p-obj-type
      813             and buf_shift-obj.obj-code = p-obj-code
      814             and buf_shift-obj.shift-date <= p-fact-date
      815           use-index pi
      816           no-error .
      817         if available buf_shift-obj
      818         then do:
      819           if  buf_shift-obj.status_ = 'зкр':U
      820           then do:
      821             assign
      822               p-shift-date = buf_shift-obj.shift-date
      823               p-shift-num  = buf_shift-obj.shift-num
      824             .
      825           end.
      826           else do:
      827             message
      828               vss-workfile vss-revision vss-description skip
      829               "Невозможно вычислить последнюю смену" skip
      830               "Статус смены отличен от статуса" 'зкр':U skip
      831               "Объект" p-obj-type p-obj-code skip
      832               "Дата" p-fact-date skip
      833               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      834               view-as alert-box error .
      835             undo, return error return-value .
      836           end.
      837         end.
      838         else do:
      839           assign
      840             p-shift-date = p-fact-date - 1
      841             p-shift-num  = 1
      842           .
      843         end.
      844       end.
      845       run factord in this-procedure
      846         (input  p-fact-date
      847         ,input  1
      848         ,input  1
      849         ,input  p-shift-date
      850         ,input  p-shift-num
      851         ,input  p-shift-on
      852         ,output v-fact-order
      853         ,output p-shift-end-fact-order
      854         ,output p-day-end-fact-order
      855         ) no-error .
      856       if error-status :error
      857       then do:
      858         message
      859           vss-workfile vss-revision vss-description skip
      860           "Ошибка при вызове процедуры factord"
      861           error-status :get-message(1) skip
      862           return-value skip
      863           view-as alert-box error .
      864         undo, return error return-value .
      865       end.
      866     end.
      867   end procedure.
      868   procedure factord-lock-shift :
      869     define input  parameter p-obj-type  as character no-undo .
      870     define input  parameter p-obj-code  as integer   no-undo .
      871     define input  parameter p-fact-date as date      no-undo .
      872     define parameter buffer buf_shift-obj for ub.shift-obj .
      873     define variable v-shift-on      as logical   no-undo .
      874     define variable v-extra-message as character no-undo .
      875     define variable v-error as character no-undo .
      876     do
      877     on error undo, return error return-value
      878     :
      879   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      880   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      881     (input  p-obj-type
      882     ,input  p-obj-code
      883     ,input  'shift-on=request'
      884     ,output v-shift-on
      885     ) no-error .
      886       if error-status :error
      887       then do:
      888         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      889         undo, return error v-error .
      890       end.
      891       if v-shift-on = true
      892       then do:
      893         find first buf_shift-obj share-lock
      894           where buf_shift-obj.obj-type   = p-obj-type
      895             and buf_shift-obj.obj-code   = p-obj-code
      896             and buf_shift-obj.shift-date > p-fact-date
      897           use-index pi
      898           no-error .
      899         if not available buf_shift-obj
      900         or buf_shift-obj.status_ <> 'зкр':U
      901         then do:
      902           find last buf_shift-obj
      903             where buf_shift-obj.obj-type = p-obj-type
      904               and buf_shift-obj.obj-code = p-obj-code
      905               and buf_shift-obj.status_  = 'зкр':U
      906             use-index stts
      907             no-error .
      908           if available buf_shift-obj
      909           then do:
      910             assign
      911               v-extra-message =
      912                     substitute("Дата начала последеней закрытой смены на объекте &1"
      913                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      914                               )
      915             .
      916           end.
      917           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      918           undo, return error v-error .
      919         end.
      920       end.
      921     end.
      922   end procedure.
      923   procedure factord-end-day :
      924     define input  parameter p-fact-date            as date    no-undo .
      925     define output parameter p-day-end-fact-order   as decimal no-undo .
      926     do
      927     on error undo, return error return-value
      928     :
      929       if p-fact-date = ?
      930       then do:
      931         return error "Не указана фактическая дата" .
      932       end.
      933       assign
      934         p-day-end-fact-order = integer(p-fact-date) + 0.99
      935       .
      936     end.
      937   end procedure.
      938   procedure factord-to-date :
      939     define input  parameter p-fact-order as decimal no-undo .
      940     define output parameter p-fact-date  as date    no-undo .
      941     define variable v-ref-date  as date      no-undo .
      942     define variable v-ref-delta as integer   no-undo .
      943     do
      944     on error undo, return error return-value
      945     :
      946       if p-fact-order = ?
      947       or p-fact-order = 0
      948       then do:
      949         return error "Не указан fact-order" .
      950       end.
      951       assign
      952         v-ref-date  = date(1, 1, 2000)
      953       .
      954       assign
      955         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      956       .
      957       assign
      958         p-fact-date = v-ref-date + v-ref-delta
      959       .
      960     end.
      961   end procedure.
      962   procedure factord-to-fact-num :
      963     define input  parameter p-fact-order as decimal no-undo .
      964     define output parameter p-fact-num   as integer no-undo .
      965     define variable v-fact-order-trunc as decimal no-undo .
      966     do
      967     on error undo, return error return-value
      968     :
      969       if p-fact-order = ?
      970       or p-fact-order = 0
      971       then do:
      972         return error "Не указан fact-order" .
      973       end.
      974       assign
      975        v-fact-order-trunc = truncate(p-fact-order, 2)
      976       .
      977       assign
      978         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      979       .
      980     end.
      981   end procedure.
      982   procedure factord-to-shift-num :
      983     define input  parameter p-fact-order as decimal no-undo .
      984     define output parameter p-shift-num   as integer no-undo .
      985     define variable  p-shift-numd  as decimal   no-undo .
      986     define variable v-fact-order-trunc as decimal no-undo .
      987     do
      988     on error undo, return error return-value
      989     :
      990       if p-fact-order = ?
      991       or p-fact-order = 0
      992       then do:
      993         return error "Не указан fact-order" .
      994       end.
      995       assign
      996        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      997       .
      998       if v-fact-order-trunc < 0.5 then do:
      999         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1000       end.
     1001       assign
     1002         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1003         .
     1004        assign
     1005         p-shift-num = truncate (p-shift-numd , 0)
     1006       .
     1007     end.
     1008   end procedure.
     1009   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1010   define variable v-waitfram-action01         as character   no-undo .
     1011   define variable v-waitfram-action02         as character   no-undo .
     1012   define variable v-waitfram-action03         as character   no-undo .
     1013   define variable mWaitFramTextBeg            as character   no-undo.
     1014   define variable mWaitFramTextEnd            as character   no-undo.
     1015   define variable mWaitFramView               as logical     no-undo.
     1016   define variable mWaitProcEvent              as logical     no-undo init yes.
     1017   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1018   define variable mWaitFramStop               as logical     no-undo.
     1019   define variable mWaitFramStopUser           as logical     no-undo.
     1020   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1021   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1022   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1023   define button B-WaitFramStop auto-end-key
     1024        label "Стоп"
     1025        size 10 by 1 tooltip "Остоновить процесс".
     1026   define button B-viewProcInfo
     1027        label "Информация"
     1028        size 15 by 1 tooltip "Информация о процесс".
     1029   define frame waitfram
     1030     v-waitfram-action01 format "x(72)" no-label skip
     1031     v-waitfram-action02 format "x(72)" no-label skip
     1032     v-waitfram-action03 format "x(72)" no-label skip
     1033     B-viewProcInfo
     1034     B-WaitFramStop at row 4 col 30
     1035     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1036     .
     1037   define new global shared variable mBatchMode as logical no-undo init ?.
     1038   define variable mFramBachModHandle as handle no-undo.
     1039   mFramBachModHandle = frame waitfram:handle.
     1040   define variable mFameOldVis as logical no-undo.
     1041   define variable mVisCUrentVin as logical no-undo.
     1042   if session:batch-mode
     1043   then
     1044      mBatchMode = yes.
     1045   if mBatchMode = ? then do:
     1046     mVisCUrentVin = current-window:visible.
     1047     mFameOldVis = mFramBachModHandle:visible.
     1048     mFramBachModHandle:visible  = yes.
     1049     mBatchMode = mFramBachModHandle:visible ne yes.
     1050     mFramBachModHandle:visible = mFameOldVis.
     1051     current-window:visible = mVisCUrentVin.
     1052   end.
     1053    if  log-manager:logfile-name ne ?
     1054     then DO:
     1055         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1056         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1057         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1058     end.
     1059   on choose of B-WaitFramStop in frame waitfram
     1060   do:
     1061     mWaitFramStop = yes.
     1062     mWaitFramStopUser = yes.
     1063   end.
     1064   function waitfram-check-timeout returns logical():
     1065      define variable vtime as int64 no-undo.
     1066      if mWaitFramStopTimeOut
     1067      then
     1068         return yes.
     1069      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1070      if     mWaitFramTimeOut ne ?
     1071         and mWaitFramTimeOut ne 0
     1072         and mWaitFramTimeOut lt vtime
     1073      then do:
     1074         mWaitFramStopTimeOut = yes.
     1075      end.
     1076      return mWaitFramStopTimeOut.
     1077   end.
     1078   procedure waitfram-hide :
     1079     if not session:batch-mode
     1080     then do
     1081     on error undo, return error return-value
     1082     :
     1083       pause 0 before-hide .
     1084       if not mBatchMode then
     1085         hide frame waitfram .
     1086     if     not mWaitFramView
     1087        and mWaitProcEvent
     1088     then
     1089       process events .
     1090     end.
     1091   end procedure.
     1092   procedure waitfram-show :
     1093     define input  parameter p-message as character no-undo .
     1094     define variable v-left-margin as integer   no-undo .
     1095     if not session:batch-mode
     1096     then do
     1097     on error undo, return error return-value
     1098     :
     1099       if length(p-message) <= 70 then do:
     1100         assign
     1101           v-left-margin = integer((70 - length(p-message)) / 2)
     1102         .
     1103         assign
     1104           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1105         .
     1106         assign
     1107           v-waitfram-action01 = " "
     1108           v-waitfram-action02 = " "
     1109                                    + fill(" ", v-left-margin)
     1110                                    + p-message
     1111           v-waitfram-action03 = " "
     1112         .
     1113       end.
     1114       else do:
     1115         define variable vRindex1 as integer no-undo.
     1116         define variable vRindex2 as integer no-undo.
     1117         vRindex1 = r-index(p-message," ",70).
     1118         if vRindex1 = 0
     1119         then
     1120            vRindex1 = 70.
     1121         if length(p-message)  <= vRindex1 + 70 then do:
     1122           assign
     1123             v-waitfram-action01 = " "
     1124             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1125             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1126           .
     1127         end.
     1128         else do:
     1129           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1130           if vRindex2 <= vRindex1
     1131           then
     1132              vRindex2 = vRindex1 + 70.
     1133           assign
     1134             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1135             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1136             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1137           .
     1138         end.
     1139       end.
     1140       B-viewProcInfo:visible   in frame waitfram = no.
     1141       B-viewProcInfo:sensitive in frame waitfram = no.
     1142       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1143       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1144       if  (   mWaitFramView
     1145          or  mWaitProcEvent)
     1146          and not mBatchMode
     1147       then
     1148          display
     1149             v-waitfram-action01 skip
     1150             v-waitfram-action02 skip
     1151             v-waitfram-action03 skip
     1152          with frame waitfram .
     1153       if     mWaitFramView
     1154          then do:
     1155             if     mWaitFramInterval ne ?
     1156                and not mBatchMode
     1157             then
     1158                wait-for go of frame waitfram pause mWaitFramInterval.
     1159          end.
     1160          else
     1161             if     mWaitProcEvent
     1162                and not mBatchMode
     1163             then
     1164                process events .
     1165     end.
     1166   end procedure.
     1167      procedure waitfram-show-this:
     1168         define input  parameter iInterval as int64 no-undo.
     1169         define variable vtime as int64 no-undo.
     1170         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1171         mWaitFramInterval = iInterval.
     1172         run waitfram-show (substitute("&1&2 &3&4" ,
     1173                                       mWaitFramTextBeg ,
     1174                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1175                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1176                                       mWaitFramTextEnd
     1177                                      )
     1178                           ).
     1179      end.
     1180      procedure WaitFramRunPause:
     1181         define input  parameter iInterval as dec no-undo.
     1182         define variable vStart  as datetime-tz no-undo.
     1183         define variable vend    as datetime-tz no-undo.
     1184         define variable vint as int64 no-undo.
     1185         define variable vOk as logical no-undo.
     1186         vStart = now.
     1187         vend   = vStart.
     1188         publish "WaitFramPause" (iInterval,output vOk).
     1189         vend   =  now.
     1190         vint = vend - vStart.
     1191         vint = iInterval - vint / 1000.
     1192         if     not mWaitFramStop
     1193            and (   vint > 0
     1194                 or (    not vOk
     1195                     and iInterval eq ?
     1196                     )
     1197                 )
     1198         then
     1199            run waitfram-show-this (iInterval).
     1200         vend   =  now.
     1201         vint = vend - vStart.
     1202         vint = iInterval - vint / 1000.
     1203         if     not mWaitFramStop
     1204            and vint > 0
     1205         then do:
     1206            run gbl/pause.p (vint * 1000).
     1207         end.
     1208         if iInterval ne ?
     1209         then
     1210            publish "WaitFramStop".
     1211         waitfram-check-timeout().
     1212      end.
     1213      procedure WaitFramWaitFor:
     1214         define input  parameter iInterval as dec no-undo.
     1215         assign
     1216            mWaitFramStartProc   = now
     1217            mWaitFramStopUser    = no
     1218            mWaitFramStopTimeOut = no
     1219         .
     1220         block-wait:
     1221         do while not mWaitFramStop:
     1222            run WaitFramRunPause (iInterval).
     1223            if  waitfram-check-timeout()
     1224            then do:
     1225               leave block-wait.
     1226            end.
     1227         end.
     1228         run waitfram-hide.
     1229      end.
     1230   procedure waitfram-join :
     1231     define input  parameter p-line-1  as character no-undo .
     1232     define input  parameter p-line-2  as character no-undo .
     1233     define input  parameter p-line-3  as character no-undo .
     1234     define output parameter p-message as character no-undo .
     1235     do
     1236     on error undo, return error return-value
     1237     :
     1238       assign
     1239         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1240                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1241                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1242       .
     1243     end.
     1244   end procedure.
     1245   function waitfram-join-function returns character
     1246     (input p-line-1 as character
     1247     ,input p-line-2 as character
     1248     ,input p-line-3 as character
     1249     ).
     1250     define variable v-message as character no-undo .
     1251     run waitfram-join in this-procedure
     1252       (input  p-line-1
     1253       ,input  p-line-2
     1254       ,input  p-line-3
     1255       ,output v-message
     1256       ) .
     1257     return v-message .
     1258   end function .
     1259   define variable vss-include-info12 as character format "X(65)" no-undo
     1260   initial "@(#)$Workfile$ $Revision$".
     1261   define temp-table temp_p-fmt_string-part no-undo
     1262       field str-key       as integer
     1263       field string-part   as character
     1264       index pi is primary unique
     1265           str-key
     1266   .
     1267   define variable v-p-fmt-12-str-key    as integer      no-undo.
     1268   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
     1269                                     iInput AS INTEGER).
     1270     def var v-start-print as integer no-undo .
     1271     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
     1272     assign
     1273       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
     1274     .
     1275     RETURN v-start-print .
     1276   END FUNCTION.
     1277   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
     1278                                     iInput AS INTEGER).
     1279     def var v-start-print as integer no-undo .
     1280     assign
     1281       v-start-print = INTEGER(iEndPix - 1 - iInput)
     1282     .
     1283     if v-start-print < 0 then return 0.
     1284     RETURN v-start-print .
     1285   END FUNCTION.
     1286   function p-fmt-align-string returns character (
     1287         p-in-string      as character
     1288       , p-page-width     as integer
     1289       , p-align-type     as character
     1290   ).
     1291       define variable v-string-length     as integer      no-undo.
     1292       define variable v-out-string        as character    no-undo.
     1293       assign
     1294           v-string-length = length( trim( p-in-string ) )
     1295       .
     1296       if v-string-length >= p-page-width
     1297       then do:
     1298           assign
     1299               v-out-string = trim( p-in-string )
     1300           .
     1301       end.
     1302       else do:
     1303           case p-align-type
     1304           :
     1305               when 'left':U
     1306               then do:
     1307                   assign
     1308                       v-out-string = trim( p-in-string )
     1309                   .
     1310               end.
     1311               when 'right':U
     1312               then do:
     1313                   assign
     1314                       v-out-string = fill( " ":U, p-page-width - v-string-length ) + trim( p-in-string )
     1315                   .
     1316               end.
     1317               when 'center':U
     1318               then do:
     1319                   assign
     1320                       v-out-string = fill( " ":U, integer( ( p-page-width - v-string-length ) / 2 ) ) + trim( p-in-string )
     1321                   .
     1322               end.
     1323           end case.
     1324       end.
     1325       return v-out-string .
     1326   end function.
     1327   procedure p-fmt-split-string :
     1328   define input parameter p-source-string  as character        no-undo.
     1329   define input parameter p-split-length   as integer          no-undo.
     1330   define output parameter p-string-1      as character        no-undo.
     1331   define output parameter p-string-2      as character        no-undo.
     1332   do
     1333   on error undo, return error
     1334   :
     1335       define variable v-space-pos    as integer      no-undo.
     1336       if length( p-source-string ) <= p-split-length
     1337       then do:
     1338           assign
     1339               p-string-1 = p-source-string
     1340           .
     1341       end.
     1342       else do:
     1343           assign
     1344               v-space-pos = r-index( p-source-string, " ":U, p-split-length )
     1345           .
     1346           if v-space-pos = 0
     1347           then do:
     1348               assign
     1349                   v-space-pos = index( p-source-string, " ":U )
     1350               .
     1351           end.
     1352           if v-space-pos = 0
     1353           then do:
     1354               assign
     1355                   p-string-1 = substring( p-source-string, 1, p-split-length )
     1356                   p-string-2 = trim( substring( p-source-string, p-split-length, p-split-length ) )
     1357               .
     1358           end.
     1359           else do:
     1360               assign
     1361                   p-string-1 = substring( p-source-string, 1, v-space-pos )
     1362                   p-string-2 = trim( substring( p-source-string, v-space-pos ) )
     1363               .
     1364           end.
     1365       end.
     1366   end.
     1367   end procedure.
     1368   procedure p-fmt-round :
     1369   define input parameter p-qnty               as decimal          no-undo.
     1370   define input parameter p-price-no-VAT       as decimal          no-undo.
     1371   define input parameter p-VAT                as decimal          no-undo.
     1372   define input parameter p-SLT                as decimal          no-undo.
     1373   define input parameter p-road-tax           as decimal          no-undo.
     1374   define output parameter p-new-price-no-VAT  as decimal          no-undo.
     1375   define output parameter p-new-VAT           as decimal          no-undo.
     1376   define output parameter p-new-SLT           as decimal          no-undo.
     1377   define output parameter p-new-sum-VAT       as decimal          no-undo.
     1378   define output parameter p-new-sum-SLT       as decimal          no-undo.
     1379   define output parameter p-new-sum-road-tax  as decimal          no-undo.
     1380   define output parameter p-new-sum-no-VAT    as decimal          no-undo.
     1381   define output parameter p-new-sum-full      as decimal          no-undo.
     1382       define variable v-vat-pc    as decimal      no-undo.
     1383       define variable v-slt-pc    as decimal      no-undo.
     1384   do
     1385   on error undo, return error
     1386   :
     1387       if p-price-no-VAT = 0
     1388       then do:
     1389           assign
     1390               p-new-price-no-VAT = 0.0
     1391               p-new-VAT          = ?
     1392               p-new-SLT          = ?
     1393               p-new-sum-VAT      = 0.0
     1394               p-new-sum-SLT      = 0.0
     1395               p-new-sum-no-VAT   = 0.0
     1396               p-new-sum-road-tax = 0.0
     1397               p-new-sum-full     = 0.0
     1398           .
     1399       end.
     1400       else do:
     1401           assign
     1402               v-vat-pc            = p-VAT / p-price-no-VAT
     1403               v-slt-pc            = p-SLT / ( p-price-no-VAT + p-VAT )
     1404               p-new-price-no-VAT  = round( p-price-no-VAT, 2 )
     1405               p-new-VAT           = round( p-new-price-no-VAT * v-vat-pc, 2 )
     1406               p-new-SLT           = round( ( p-new-price-no-VAT + p-new-VAT ) * v-slt-pc, 2 )
     1407               p-new-sum-VAT       = round( p-new-VAT          * p-qnty, 2 )
     1408               p-new-sum-SLT       = round( ( p-new-price-no-VAT + p-new-VAT ) * p-qnty * v-slt-pc, 2 )
     1409               p-new-sum-no-VAT    = round( p-new-price-no-VAT * p-qnty, 2 )
     1410               p-new-sum-road-tax  = round( p-road-tax * p-qnty, 2 )
     1411               p-new-sum-full      = round( ( p-new-price-no-VAT + p-new-VAT + p-new-SLT + p-road-tax ) * p-qnty, 2 )
     1412           .
     1413       end.
     1414   end.
     1415   end procedure.
     1416   procedure p-fmt-split :
     1417   define input parameter p-in-string      as character        no-undo.
     1418   define input parameter p-split-length   as integer          no-undo.
     1419       define variable v-start-pos     as integer      no-undo.
     1420       define variable v-end-pos       as integer      no-undo.
     1421       define buffer buf_temp_p-fmt_string-part        for temp_p-fmt_string-part.
     1422   do
     1423   for buf_temp_p-fmt_string-part
     1424   on error undo, return error
     1425   :
     1426       empty temp-table buf_temp_p-fmt_string-part.
     1427       if p-split-length < 1
     1428       then do:
     1429           undo, return error substitute( "p-fmt-split: Строка не может быть разбита на &1 частей", p-split-length ).
     1430       end.
     1431       assign
     1432           p-in-string                 = trim( p-in-string )
     1433           v-p-fmt-12-str-key   = 0
     1434           v-start-pos                 = 1
     1435           v-end-pos                   = length( p-in-string )
     1436       .
     1437       run p-fmt-get-string-range in this-procedure (
     1438             input p-in-string
     1439           , input p-split-length
     1440           , input v-start-pos
     1441           , output v-start-pos
     1442           , output v-end-pos
     1443       ).
     1444       do while v-end-pos <> 0
     1445       :
     1446           create buf_temp_p-fmt_string-part.
     1447           assign
     1448               v-p-fmt-12-str-key = v-p-fmt-12-str-key + 1
     1449           .
     1450           assign
     1451               buf_temp_p-fmt_string-part.str-key      = v-p-fmt-12-str-key
     1452               buf_temp_p-fmt_string-part.string-part  = substring( p-in-string, v-start-pos, v-end-pos - v-start-pos )
     1453           .
     1454           assign
     1455               v-start-pos = v-end-pos + 1
     1456           .
     1457           run p-fmt-get-string-range in this-procedure (
     1458                 input p-in-string
     1459               , input p-split-length
     1460               , input v-start-pos
     1461               , output v-start-pos
     1462               , output v-end-pos
     1463           ).
     1464       end.
     1465   end.
     1466   end procedure.
     1467   procedure p-fmt-get-string-range :
     1468   define input parameter p-in-string      as character        no-undo.
     1469   define input parameter p-split-length   as integer          no-undo.
     1470   define input parameter p-old-start-pos  as integer          no-undo.
     1471   define output parameter p-start-pos     as integer          no-undo.
     1472   define output parameter p-end-pos       as integer          no-undo.
     1473       define variable v-init-string    as character    no-undo.
     1474       define variable v-temp-char      as character    no-undo.
     1475       define variable v-temp-pos       as integer      no-undo.
     1476       define variable v-counter        as integer      no-undo.
     1477   do
     1478   on error undo, return error
     1479   :
     1480       assign
     1481           p-start-pos   = p-old-start-pos
     1482           v-init-string = substring( p-in-string, p-start-pos )
     1483       no-error.
     1484       if error-status :error
     1485       or trim( v-init-string ) = "":U
     1486       then do:
     1487           assign
     1488               p-end-pos = 0
     1489           .
     1490           undo, return .
     1491       end.
     1492       assign
     1493           v-temp-char   = substring( v-init-string, 1, 1 )
     1494       .
     1495       do
     1496       while trim( v-temp-char ) = "":U
     1497       :
     1498           assign
     1499               p-start-pos     = p-start-pos + 1
     1500               v-init-string   = substring( p-in-string, p-start-pos )
     1501               v-temp-char     = substring( v-init-string, 1, 1 )
     1502           .
     1503       end.
     1504       assign
     1505           v-temp-pos  = p-split-length
     1506           v-temp-char = substring( v-init-string, v-temp-pos, 1 )
     1507           v-counter   = 0
     1508       .
     1509       search-word-end:
     1510       do
     1511       while trim( v-temp-char ) <> "":U
     1512       :
     1513           assign
     1514               v-counter   = v-counter + 1
     1515           .
     1516           if v-counter > 20
     1517           then do:
     1518               assign
     1519                   v-temp-pos  = p-split-length
     1520               .
     1521               leave search-word-end.
     1522           end.
     1523           assign
     1524               v-temp-pos  = v-temp-pos - 1
     1525               v-temp-char = substring( v-init-string, v-temp-pos, 1 )
     1526           .
     1527       end.
     1528       assign
     1529           p-end-pos = p-start-pos + v-temp-pos - 1
     1530       .
     1531   end.
     1532   end procedure.
     1533   define temp-table temp-font no-undo
     1534     field fontnum  as integer
     1535     field fontname as character
     1536     field fontsize as character
     1537     field fonttype as character
     1538     field font-h   as integer
     1539     field font-w   as integer
     1540     field v-row    as integer
     1541     field v-col    as integer
     1542     field v-row-lans as integer
     1543     field v-col-lans as integer
     1544   index pi fontnum
     1545   .
     1546   procedure get-font-ini :
     1547     do
     1548     on error undo, return error return-value
     1549     :
     1550   define variable ii as integer   no-undo .
     1551   define variable v-font7 as character no-undo .
     1552   define variable v-font as character no-undo .
     1553   define variable loc-name as character no-undo .
     1554   define variable loc-size as character no-undo .
     1555   define variable loc-type as character no-undo .
     1556   define variable old_H as integer   no-undo .
     1557   define variable old_w as integer   no-undo .
     1558   define variable old-row  as integer   no-undo .
     1559   define variable old-col  as integer   no-undo .
     1560   define variable old-row-lans  as integer   no-undo .
     1561   define variable old-col-lans  as integer   no-undo .
     1562   define variable vv as integer   no-undo .
     1563   empty temp-table temp-font.
     1564     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     1565       case num-entries (v-font7) :
     1566         when 4 then do:
     1567             assign
     1568               loc-name = entry ( 1 , v-font7 )
     1569               loc-size = entry ( 2 , v-font7 )
     1570               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     1571             .
     1572         end.
     1573         when 3 then do:
     1574             assign
     1575               loc-name = entry ( 1 , v-font7 )
     1576               loc-size = entry ( 2 , v-font7 )
     1577               loc-type = entry ( 3 , v-font7 )
     1578             .
     1579         end.
     1580         when 2 then  do:
     1581             assign
     1582               loc-name = entry ( 1 , v-font7 )
     1583               loc-size = entry ( 2 , v-font7 )
     1584               loc-type = ""
     1585             .
     1586         end.
     1587         when 1 then do:
     1588             assign
     1589               loc-name = trim(entry ( 1 , v-font7 ))
     1590               loc-size = ""
     1591               loc-type = ""
     1592             .
     1593         end.
     1594       end case.
     1595     create temp-font.
     1596     assign
     1597       temp-font.fontnum  = 7
     1598       temp-font.fontname = trim(loc-name)
     1599       temp-font.fontsize = trim(loc-size)
     1600       temp-font.fonttype = trim(loc-type)
     1601       temp-font.v-row    = 62
     1602       temp-font.v-col    = 136
     1603       temp-font.v-row-lans = 43
     1604       temp-font.v-col-lans = 198
     1605     .
     1606     repeat ii = 16 to 100 :
     1607       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     1608       if v-font = "" or v-font = ? then leave.
     1609       case num-entries (v-font) :
     1610         when 4 then do:
     1611             assign
     1612               loc-name = entry ( 1 , v-font )
     1613               loc-size = entry ( 2 , v-font )
     1614               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     1615             .
     1616         end.
     1617         when 3 then do:
     1618             assign
     1619               loc-name = entry ( 1 , v-font )
     1620               loc-size = entry ( 2 , v-font )
     1621               loc-type = entry ( 3 , v-font )
     1622             .
     1623         end.
     1624         when 2 then do:
     1625             assign
     1626               loc-name = entry ( 1 , v-font )
     1627               loc-size = entry ( 2 , v-font )
     1628               loc-type = ""
     1629             .
     1630         end.
     1631         when 1 then do:
     1632             assign
     1633               loc-name = trim(entry ( 1 , v-font ))
     1634               loc-size = ""
     1635               loc-type = ""
     1636             .
     1637         end.
     1638       end case.
     1639     create temp-font.
     1640     assign
     1641       temp-font.fontnum  = ii
     1642       temp-font.fontname = trim(loc-name)
     1643       temp-font.fontsize = trim(loc-size)
     1644       temp-font.fonttype = trim(loc-type)
     1645     .
     1646     end.
     1647       for each temp-font :
     1648          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     1649          if  vv = ? then vv =  0 .
     1650           run rep/exfont.p (
     1651             input   temp-font.fontname ,
     1652             input   vv ,
     1653             input   temp-font.fonttype ,
     1654             output  temp-font.font-h   ,
     1655             output  temp-font.font-w   )
     1656           .
     1657       end.
     1658   find first temp-font where  temp-font.fontnum  = 7  .
     1659   old_H = temp-font.font-H .
     1660   old_w = temp-font.font-W .
     1661   old-row = temp-font.v-row .
     1662   old-col = temp-font.v-col .
     1663   old-row-lans = temp-font.v-row-lans .
     1664   old-col-lans = temp-font.v-col-lans .
     1665       for each temp-font where
     1666                temp-font.fontnum  <> 7 :
     1667           assign
     1668               temp-font.v-row    = old_H * old-row / temp-font.font-h
     1669               temp-font.v-col    = old_W * old-col / temp-font.font-W
     1670               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     1671               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     1672           .
     1673       end.
     1674     end.
     1675   end procedure.
     1676   PROCEDURE How-name :
     1677   define input  parameter h as integer no-undo .
     1678   define input  parameter w as integer no-undo .
     1679   define output parameter n as character  no-undo .
     1680   define variable A4port-H as integer   no-undo init 63.
     1681   define variable A4port-W as integer   no-undo init 136.
     1682   define variable A4lans-H as integer   no-undo init 43.
     1683   define variable A4lans-W as integer   no-undo init 198.
     1684   define variable Strim-W  as integer   no-undo init 278.
     1685   run define-a4-size (
     1686        input ReportFontNum
     1687       ,output A4port-H
     1688       ,output A4port-W
     1689       ,output A4lans-H
     1690       ,output A4lans-W ).
     1691   If w >= 1 and w <= A4port-W Then DO:
     1692     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1693     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     1694     If h > A4port-H              Then n = "to-file":U.
     1695   End.
     1696   If w > A4port-W and w <= A4lans-W Then DO:
     1697     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1698     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1699     If h > A4port-H              Then n = "to-file":U.
     1700   End.
     1701   If w > A4lans-W and w <= Strim-W Then DO:
     1702     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     1703     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1704     If h > A4port-H              Then n = "to-file":U.
     1705   End.
     1706   If w > Strim-W Then DO:
     1707      n = "to-file":U.
     1708   End.
     1709   END PROCEDURE.
     1710   PROCEDURE define-a4-size :
     1711   define input  parameter p-ReportFontNum as integer   no-undo .
     1712   define output parameter A4port-H as integer   no-undo .
     1713   define output parameter A4port-W as integer   no-undo .
     1714   define output parameter A4lans-H as integer   no-undo .
     1715   define output parameter A4lans-W as integer   no-undo .
     1716   if not can-find (first temp-font ) then do:
     1717      run get-font-ini .
     1718   end.
     1719   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     1720   if available temp-font then do:
     1721   assign
     1722     A4port-H = temp-font.v-row
     1723     A4port-W = temp-font.v-col
     1724     A4lans-H = temp-font.v-row-lans
     1725     A4lans-W = temp-font.v-col-lans
     1726   .
     1727   end.
     1728   else do:
     1729   assign
     1730     A4port-H = 63
     1731     A4port-W = 136
     1732     A4lans-H = 43
     1733     A4lans-W = 198
     1734   .
     1735   end.
     1736   END PROCEDURE.
     1737   procedure ost-line :
     1738     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     1739     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     1740     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     1741     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     1742     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     1743     define input  parameter x-tog-shift  as logical no-undo .
     1744     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     1745     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     1746     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     1747     define input  parameter xtog-obj     as logical no-undo .
     1748     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     1749     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     1750     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     1751     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     1752     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     1753     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     1754     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     1755     define buffer buff-obj-list  for obj-list .
     1756     define buffer buff-stk-line  for ub.stk-line .
     1757     assign
     1758       Quantity = 0
     1759       Coast_R  = 0
     1760       Coast_V  = 0
     1761       VAT_R    = 0
     1762       VAT_V    = 0
     1763       SLT_R    = 0
     1764       SLT_V    = 0
     1765     .
     1766     if  x-tog-shift = false then do:
     1767       for each buff-obj-list no-lock
     1768         where xtog-obj = false
     1769            or (buff-obj-list.obj-type = x-store-type
     1770               and buff-obj-list.obj-code = x-store-code
     1771               )
     1772       on error undo, return error
     1773       :
     1774         find last buff-stk-line no-lock
     1775           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1776             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1777             and buff-stk-line.artic      = x-artic
     1778             and buff-stk-line.prod-type  = x-prod-type
     1779             and buff-stk-line.prod-code  = x-prod-code
     1780             and buff-stk-line.sum-type   = x-sum-type
     1781             and buff-stk-line.cat-id     = '##,##':U
     1782             and buff-stk-line.fact-order <= x-fact-order
     1783             and buff-stk-line.shift-num  = 0
     1784           use-index category
     1785           no-error .
     1786         if available buff-stk-line then do:
     1787           assign
     1788             Quantity = Quantity +  buff-stk-line.fact-qnty
     1789             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     1790             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     1791             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     1792             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     1793             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     1794             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     1795           .
     1796         end.
     1797       end.
     1798     end.
     1799     else do:
     1800       for each buff-obj-list no-lock
     1801         where xtog-obj = false
     1802            or (buff-obj-list.obj-type = x-store-type
     1803               and buff-obj-list.obj-code = x-store-code
     1804               )
     1805       on error undo, return error
     1806       :
     1807         find last buff-stk-line no-lock
     1808           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1809             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1810             and buff-stk-line.artic      = x-artic
     1811             and buff-stk-line.prod-type  = x-prod-type
     1812             and buff-stk-line.prod-code  = x-prod-code
     1813             and buff-stk-line.sum-type   = x-sum-type
     1814             and buff-stk-line.cat-id     = '##,##':U
     1815             and buff-stk-line.fact-order <= x-fact-order
     1816             and buff-stk-line.shift-num  > 0
     1817           use-index category
     1818           no-error .
     1819         if available buff-stk-line then do:
     1820           assign
     1821             Quantity = Quantity +  buff-stk-line.fact-qnty
     1822             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     1823             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     1824             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     1825             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     1826             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     1827             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     1828           .
     1829         end.
     1830       end.
     1831     end.
     1832   end procedure.
     1833   procedure ost-lineother-tax :
     1834     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     1835     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     1836     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     1837     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     1838     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     1839     define input  parameter x-tog-shift  as logical no-undo .
     1840     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     1841     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     1842     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     1843     define input  parameter xTog-obj     as logical no-undo .
     1844     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     1845     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     1846     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     1847     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     1848     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     1849     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     1850     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     1851     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     1852     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     1853     define buffer buff-obj-list  for obj-list .
     1854     define buffer buff-stk-line  for ub.stk-line .
     1855     assign
     1856       Quantity = 0
     1857       Coast_R  = 0
     1858       Coast_V  = 0
     1859       VAT_R    = 0
     1860       VAT_V    = 0
     1861       SLT_R    = 0
     1862       SLT_V    = 0
     1863       other_R  = 0
     1864       other_V  = 0
     1865     .
     1866     if  x-tog-shift = false then do:
     1867       for each buff-obj-list no-lock
     1868         where xtog-obj = false
     1869            or (buff-obj-list.obj-type = x-store-type
     1870               and buff-obj-list.obj-code = x-store-code
     1871               )
     1872       on error undo, return error
     1873       :
     1874         find last buff-stk-line no-lock
     1875           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1876             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1877             and buff-stk-line.artic      = x-artic
     1878             and buff-stk-line.prod-type  = x-prod-type
     1879             and buff-stk-line.prod-code  = x-prod-code
     1880             and buff-stk-line.sum-type   = x-sum-type
     1881             and buff-stk-line.cat-id     = '##,##':U
     1882             and buff-stk-line.fact-order <= x-fact-order
     1883             and buff-stk-line.shift-num  = 0
     1884           use-index category
     1885           no-error .
     1886         if available buff-stk-line then do:
     1887           assign
     1888             Quantity = Quantity +  buff-stk-line.fact-qnty
     1889             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     1890             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     1891             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     1892             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     1893             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     1894             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     1895             other_R  = other_R  +  buff-stk-line.other-rubl
     1896             other_V  = other_V  +  buff-stk-line.other-base
     1897           .
     1898         end.
     1899       end.
     1900     end.
     1901     else do:
     1902       for each buff-obj-list no-lock
     1903         where xtog-obj = false
     1904            or (buff-obj-list.obj-type = x-store-type
     1905               and buff-obj-list.obj-code = x-store-code
     1906               )
     1907       on error undo, return error
     1908       :
     1909         find last buff-stk-line no-lock
     1910           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1911             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1912             and buff-stk-line.artic      = x-artic
     1913             and buff-stk-line.prod-type  = x-prod-type
     1914             and buff-stk-line.prod-code  = x-prod-code
     1915             and buff-stk-line.sum-type   = x-sum-type
     1916             and buff-stk-line.cat-id     = '##,##':U
     1917             and buff-stk-line.fact-order <= x-fact-order
     1918             and buff-stk-line.shift-num  > 0
     1919           use-index category
     1920           no-error .
     1921         if available buff-stk-line then do:
     1922           assign
     1923             Quantity = Quantity +  buff-stk-line.fact-qnty
     1924             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     1925             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     1926             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     1927             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     1928             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     1929             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     1930             other_R = other_R   +  buff-stk-line.other-rubl
     1931             other_V = other_V   +  buff-stk-line.other-base
     1932           .
     1933         end.
     1934       end.
     1935     end.
     1936   end procedure.
     1937   procedure ost-line-kg :
     1938     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     1939     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     1940     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     1941     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     1942     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     1943     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     1944     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     1945     define buffer buff-obj-list  for obj-list .
     1946     define buffer buf_doc-line for ub.doc-line .
     1947     define buffer buf_inv-line for ub.inv-line .
     1948     do
     1949     on error undo, return error
     1950     :
     1951       for each buf_doc-line no-lock where
     1952                buf_doc-line.obj-type    = p-obj-type   and
     1953                buf_doc-line.obj-code    = p-obj-code   and
     1954                buf_doc-line.prod-type   = p-prod-type  and
     1955                buf_doc-line.prod-code   = p-prod-code  and
     1956                buf_doc-line.artic       = p-artic      and
     1957                buf_doc-line.status_     = 'факт':U      and
     1958                buf_doc-line.fact-order <= p-fact-order
     1959             by buf_doc-line.fact-order    descending
     1960       :
     1961         find first buf_inv-line no-lock where
     1962                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     1963                    buf_inv-line.artic     = buf_doc-line.artic     and
     1964                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     1965                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     1966         if available buf_inv-line
     1967         then do:
     1968           if buf_inv-line.after-cli-qnty <> ?
     1969           then do:
     1970             assign
     1971               p-quantity-kg = buf_inv-line.after-cli-qnty
     1972             .
     1973             leave .
     1974           end.
     1975         end.
     1976       end.
     1977       if p-quantity-kg = ?
     1978       then do:
     1979         assign
     1980           p-quantity-kg = 0
     1981         .
     1982       end.
     1983     end.
     1984   end procedure.
     1985   define variable vss-include-info13 as character format "X(65)" no-undo
     1986   initial "@(#)$Workfile$ $Revision$".
     1987   procedure grplib-get-full-name :
     1988      define input parameter p-node-code  as integer      no-undo.
     1989      define output parameter p-full-name as character    no-undo.
     1990      do
     1991   on error undo, return error
     1992   :
     1993       define variable v-upper-code    as integer           no-undo.
     1994       define buffer buf_gds-grp       for ub.gds-grp.
     1995       define buffer buf_upper_gds-grp for ub.gds-grp.
     1996       find first buf_gds-grp no-lock
     1997            where buf_gds-grp.node-code = p-node-code
     1998       no-error.
     1999       if not available buf_gds-grp
     2000       then do:
     2001           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     2002       end.
     2003       assign
     2004           p-full-name  = ""
     2005           v-upper-code = 1
     2006       .
     2007       do while buf_gds-grp.upper-code <> 0
     2008       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     2009       :
     2010           assign
     2011               p-full-name  = buf_gds-grp.node-name
     2012                            + (if p-full-name <> "" then chr(47) else "")
     2013                            + p-full-name
     2014               v-upper-code = buf_gds-grp.upper-code
     2015           .
     2016           find first buf_gds-grp no-lock
     2017                where buf_gds-grp.node-code = v-upper-code
     2018           no-error.
     2019           if not available buf_gds-grp
     2020           then do:
     2021               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     2022                                   + string( v-upper-code )
     2023                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     2024           end.
     2025       end.
     2026       assign
     2027       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     2028       .
     2029   end.
     2030   end .
     2031   procedure grplib-get-node-from-full-name :
     2032   define input parameter p-full-name as character no-undo .
     2033   define output parameter p-node-code as integer no-undo .
     2034   define variable v-ii as integer no-undo .
     2035   define variable v-upper-code as integer no-undo .
     2036   define variable v-root-code as integer no-undo .
     2037   define variable v-entry as character no-undo .
     2038   define buffer buf_gds-grp       for ub.gds-grp.
     2039   do
     2040   on error undo, return error
     2041   :
     2042     find first buf_gds-grp no-lock
     2043         where buf_gds-grp.upper-code = 0
     2044     no-error .
     2045     if not available buf_gds-grp
     2046     then do:
     2047         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     2048     end.
     2049     else do:
     2050       assign
     2051       v-root-code = buf_gds-grp.node-code
     2052       .
     2053     end.
     2054     v-upper-code = v-root-code.
     2055     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     2056       assign
     2057       v-entry = entry(v-ii, p-full-name, chr(47)).
     2058       if v-entry = '' then leave.
     2059       find first buf_gds-grp no-lock where
     2060                 buf_gds-grp.node-name = v-entry
     2061             and buf_gds-grp.upper-code = v-upper-code
     2062             no-error.
     2063       if not available buf_gds-grp then do:
     2064         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     2065       end.
     2066       else do:
     2067         p-node-code = buf_gds-grp.node-code.
     2068         v-upper-code = buf_gds-grp.node-code.
     2069       end.
     2070     end.
     2071   end.
     2072   end .
     2073   define variable vss-include-info14 as character format "X(65)" no-undo
     2074   initial "@(#)$Workfile$ $Revision$".
     2075   define variable v-fmtcli-name          as character    no-undo.
     2076   define variable v-fmtcli-engl-name     as character    no-undo.
     2077   define variable v-fmtcli-addres        as character    no-undo.
     2078   define variable v-fmtcli-post-addres   as character    no-undo.
     2079   define variable v-fmtcli-full-addres   as character    no-undo.
     2080   define variable v-fmtcli-phone         as character    no-undo.
     2081   define variable v-fmtcli-inn           as character    no-undo.
     2082   define variable v-fmtcli-kpp           as character    no-undo.
     2083   define variable v-fmtcli-okpo          as character    no-undo.
     2084   define variable v-fmtcli-country       as character    no-undo.
     2085   define variable v-fmtcli-city          as character    no-undo.
     2086   define variable v-fmtcli-index         as character    no-undo.
     2087   define variable v-fmtcli-schet-exists  as logical      no-undo.
     2088   define variable v-fmtcli-bank-exists   as logical      no-undo.
     2089   define variable v-fmtcli-bank-r-schet  as character    no-undo.
     2090   define variable v-fmtcli-bank-c-schet  as character    no-undo.
     2091   define variable v-fmtcli-bank-bik      as character    no-undo.
     2092   define variable v-fmtcli-bank-name     as character    no-undo.
     2093   define variable v-fmtcli-bank-addres   as character    no-undo.
     2094   define variable v-fmtcli-bank-city     as character    no-undo.
     2095   procedure fmtcli-get-bank :
     2096   define input parameter p-host-code      as integer          no-undo.
     2097   define input parameter p-obj-type       as character        no-undo.
     2098   define input parameter p-obj-code       as integer          no-undo.
     2099   define input parameter p-curr-code      as integer          no-undo.
     2100       define buffer buf_fin-schet     for ub.fin-schet.
     2101       define buffer buf_fin-bank      for ub.fin-bank.
     2102   do
     2103   for buf_fin-schet
     2104     , buf_fin-bank
     2105   on error undo, return error
     2106   :
     2107       assign
     2108           v-fmtcli-schet-exists       = no
     2109           v-fmtcli-bank-exists        = no
     2110           v-fmtcli-bank-r-schet       = "":U
     2111           v-fmtcli-bank-c-schet       = "":U
     2112           v-fmtcli-bank-bik           = "":U
     2113           v-fmtcli-bank-name          = "":U
     2114           v-fmtcli-bank-addres        = "":U
     2115           v-fmtcli-bank-city          = "":U
     2116       .
     2117       search-for-schet:
     2118       for each buf_fin-schet no-lock
     2119          where buf_fin-schet.host-code = p-host-code
     2120            and buf_fin-schet.cli-type  = p-obj-type
     2121            and buf_fin-schet.cli-code  = p-obj-code
     2122            and buf_fin-schet.curr-code = p-curr-code
     2123       on error undo, return error
     2124       :
     2125           if buf_fin-schet.status_   = 'удал':U
     2126           then do:
     2127           end.
     2128           else do:
     2129               assign
     2130                   v-fmtcli-schet-exists   = yes
     2131                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
     2132                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
     2133               .
     2134               find first buf_fin-bank no-lock
     2135                    where buf_fin-bank.host-code = p-host-code
     2136                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
     2137               no-error.
     2138               if available buf_fin-bank
     2139               then do:
     2140                   assign
     2141                       v-fmtcli-bank-exists      = yes
     2142                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
     2143                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
     2144                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
     2145                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
     2146                   .
     2147               end.
     2148               else do:
     2149                   assign
     2150                       v-fmtcli-bank-exists    = no
     2151                       v-fmtcli-bank-bik       = "":U
     2152                       v-fmtcli-bank-name      = "":U
     2153                       v-fmtcli-bank-addres    = "":U
     2154                       v-fmtcli-bank-city      = "":U
     2155                   .
     2156               end.
     2157               leave search-for-schet.
     2158           end.
     2159       end.
     2160   end.
     2161   end procedure.
     2162   procedure fmtcli-get-client :
     2163   define input parameter p-obj-type       as character    no-undo.
     2164   define input parameter p-obj-code       as integer      no-undo.
     2165       define variable v-temp-fmtcli-address      as character     no-undo.
     2166       define variable v-num-country-city    as integer      no-undo.
     2167       define buffer buf_clients   for ub.clients.
     2168       define buffer buf_firm      for ub.firm.
     2169       define buffer buf_store     for ub.store.
     2170       define buffer buf_shop      for ub.shop.
     2171       define buffer buf_person    for ub.person.
     2172   do
     2173   for buf_clients
     2174     , buf_firm
     2175     , buf_store
     2176     , buf_shop
     2177     , buf_person
     2178   on error undo, return error
     2179   :
     2180       assign
     2181           v-fmtcli-name           = "":U
     2182           v-fmtcli-addres         = "":U
     2183           v-fmtcli-post-addres    = "":U
     2184           v-fmtcli-full-addres    = "":U
     2185           v-fmtcli-phone          = "":U
     2186           v-fmtcli-inn            = "":U
     2187           v-fmtcli-kpp            = "":U
     2188           v-fmtcli-okpo           = "":U
     2189           v-fmtcli-city           = "":U
     2190           v-fmtcli-index          = "":U
     2191           v-fmtcli-country        = "":U
     2192       .
     2193       find first buf_clients no-lock
     2194            where buf_clients.obj-type = p-obj-type
     2195              and buf_clients.obj-code = p-obj-code
     2196       .
     2197       assign
     2198           v-fmtcli-name = buf_clients.obj-name
     2199       .
     2200       case buf_clients.obj-type:
     2201          when 'орг':U
     2202          then do:
     2203               find first buf_firm no-lock
     2204                    where buf_firm.firm-code = buf_clients.obj-code
     2205                    no-error
     2206               .
     2207               if available buf_firm
     2208               then do:
     2209                   assign
     2210                       v-num-country-city = num-entries( buf_firm.city )
     2211                       v-fmtcli-engl-name = buf_firm.engl-name
     2212                   .
     2213                   if v-num-country-city > 0
     2214                   then do:
     2215                       assign
     2216                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
     2217                       .
     2218                   end.
     2219                   if v-num-country-city > 1
     2220                   then do:
     2221                       assign
     2222                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
     2223                       .
     2224                   end.
     2225                   run fmtcli-concatenate-strings in this-procedure (
     2226                         input v-fmtcli-full-addres
     2227                       , input v-fmtcli-country
     2228                       , input ", ":U
     2229                       , input 50
     2230                       , output v-fmtcli-full-addres
     2231                   ).
     2232                   run fmtcli-concatenate-strings in this-procedure (
     2233                         input v-fmtcli-full-addres
     2234                       , input v-fmtcli-city
     2235                       , input ", ":U
     2236                       , input 50
     2237                       , output v-fmtcli-full-addres
     2238                   ).
     2239                   run fmtcli-concatenate-strings in this-procedure (
     2240                         input v-fmtcli-full-addres
     2241                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
     2242                       , input ", ":U
     2243                       , input 50
     2244                       , output v-fmtcli-full-addres
     2245                   ).
     2246                   run fmtcli-concatenate-strings in this-procedure (
     2247                         input v-fmtcli-post-addres
     2248                       , input v-fmtcli-country
     2249                       , input ", ":U
     2250                       , input 50
     2251                       , output v-fmtcli-post-addres
     2252                   ).
     2253                   run fmtcli-concatenate-strings in this-procedure (
     2254                         input v-fmtcli-post-addres
     2255                       , input v-fmtcli-city
     2256                       , input ", ":U
     2257                       , input 50
     2258                       , output v-fmtcli-post-addres
     2259                   ).
     2260                   run fmtcli-concatenate-strings in this-procedure (
     2261                         input v-fmtcli-post-addres
     2262                       , input string( buf_firm.ind )
     2263                       , input ", ":U
     2264                       , input 50
     2265                       , output v-fmtcli-post-addres
     2266                   ).
     2267                   run fmtcli-concatenate-strings in this-procedure (
     2268                         input substring( buf_firm.addres1, 1, 50 )
     2269                       , input buf_firm.addres2
     2270                       , input " ":U
     2271                       , input 50
     2272                       , output v-temp-fmtcli-address
     2273                   ).
     2274                   run fmtcli-concatenate-strings in this-procedure (
     2275                         input v-temp-fmtcli-address
     2276                       , input substring( buf_firm.addres1, 51, 50 )
     2277                       , input " ":U
     2278                       , input 50
     2279                       , output v-temp-fmtcli-address
     2280                   ).
     2281                   run fmtcli-concatenate-strings in this-procedure (
     2282                         input v-temp-fmtcli-address
     2283                       , input substring( buf_firm.addres1, 101, 50 )
     2284                       , input " ":U
     2285                       , input 50
     2286                       , output v-temp-fmtcli-address
     2287                   ).
     2288                   assign
     2289                       v-fmtcli-addres = v-temp-fmtcli-address
     2290                   .
     2291                   if buf_firm.addres1 <> ?
     2292                   then do:
     2293                       run fmtcli-concatenate-strings in this-procedure (
     2294                             input v-fmtcli-full-addres
     2295                           , input v-fmtcli-addres
     2296                           , input ", ":U
     2297                           , input 0
     2298                           , output v-fmtcli-full-addres
     2299                       ).
     2300                   end.
     2301                   run fmtcli-concatenate-strings in this-procedure (
     2302                         input substring( buf_firm.post-addr1, 1, 50 )
     2303                       , input buf_firm.post-addr2
     2304                       , input " ":U
     2305                       , input 50
     2306                       , output v-fmtcli-post-addres
     2307                   ).
     2308                   run fmtcli-concatenate-strings in this-procedure (
     2309                         input v-fmtcli-post-addres
     2310                       , input substring( buf_firm.post-addr1, 51, 50 )
     2311                       , input " ":U
     2312                       , input 50
     2313                       , output v-fmtcli-post-addres
     2314                   ).
     2315                   run fmtcli-concatenate-strings in this-procedure (
     2316                         input v-fmtcli-post-addres
     2317                       , input substring( buf_firm.post-addr1, 101, 50 )
     2318                       , input " ":U
     2319                       , input 50
     2320                       , output v-fmtcli-post-addres
     2321                   ).
     2322                   assign
     2323                       v-fmtcli-phone         = buf_firm.phone
     2324                       v-fmtcli-inn           = buf_firm.inn
     2325                       v-fmtcli-kpp           = buf_firm.kpp
     2326                       v-fmtcli-okpo          = buf_firm.okpo
     2327                       v-fmtcli-index         = string( buf_firm.ind )
     2328                   .
     2329               end.
     2330          end.
     2331          when 'маг':U
     2332          then do:
     2333               find first buf_shop no-lock
     2334                    where buf_shop.obj-code = buf_clients.obj-code
     2335               .
     2336               if available buf_shop
     2337               then do:
     2338                   run fmtcli-concatenate-strings in this-procedure (
     2339                         input buf_shop.addres1
     2340                       , input buf_shop.addres2
     2341                       , input " ":U
     2342                       , input 50
     2343                       , output v-fmtcli-addres
     2344                   ).
     2345                   assign
     2346                       v-fmtcli-full-addres = v-fmtcli-addres
     2347                       v-fmtcli-post-addres = v-fmtcli-addres
     2348                       v-fmtcli-phone       = buf_shop.phone
     2349                       v-fmtcli-inn         = "":U
     2350                       v-fmtcli-kpp         = "":U
     2351                       v-fmtcli-okpo        = "":U
     2352                       v-fmtcli-city        = "":U
     2353                       v-fmtcli-index       = "":U
     2354                   .
     2355               end.
     2356          end.
     2357          when 'скл':U
     2358          then do:
     2359               find first buf_store no-lock
     2360                    where buf_store.obj-code = buf_clients.obj-code
     2361               .
     2362               if available buf_store
     2363               then do:
     2364                   run fmtcli-concatenate-strings in this-procedure (
     2365                         input buf_store.addres1
     2366                       , input buf_store.addres2
     2367                       , input " ":U
     2368                       , input 50
     2369                       , output v-fmtcli-addres
     2370                   ).
     2371                   assign
     2372                       v-fmtcli-full-addres = v-fmtcli-addres
     2373                       v-fmtcli-phone       = buf_store.phone
     2374                       v-fmtcli-inn         = "":U
     2375                       v-fmtcli-kpp         = "":U
     2376                       v-fmtcli-okpo        = "":U
     2377                       v-fmtcli-city        = "":U
     2378                       v-fmtcli-index       = "":U
     2379                   .
     2380               end.
     2381          end.
     2382          when 'чел':U
     2383          then do:
     2384               find first buf_person no-lock
     2385                    where buf_person.psn-code = buf_clients.obj-code
     2386               .
     2387               if available buf_person
     2388               then do:
     2389                   run fmtcli-concatenate-strings in this-procedure (
     2390                         input ( if buf_person.ind = 0 or buf_person.ind = ?
     2391                                 then "":U
     2392                                 else string( buf_person.ind, "999999")
     2393                                 )
     2394                       , input buf_person.city
     2395                       , input ", ":U
     2396                       , input 0
     2397                       , output v-fmtcli-full-addres
     2398                   ).
     2399                   assign
     2400                       v-fmtcli-addres = buf_person.address
     2401                   .
     2402                   run fmtcli-concatenate-strings in this-procedure (
     2403                         input v-fmtcli-full-addres
     2404                       , input v-fmtcli-addres
     2405                       , input ", ":U
     2406                       , input 0
     2407                       , output v-fmtcli-full-addres
     2408                   ).
     2409                   assign
     2410                       v-fmtcli-phone     = buf_person.phone1
     2411                       v-fmtcli-inn       = buf_person.inn
     2412                       v-fmtcli-kpp       = buf_person.kpp
     2413                       v-fmtcli-okpo      = buf_person.okpo
     2414                       v-fmtcli-city      = buf_person.city
     2415                       v-fmtcli-index     = string( buf_person.ind )
     2416                   .
     2417               end.
     2418          end.
     2419       end case.
     2420   end.
     2421   end procedure.
     2422   procedure fmtcli-concatenate-strings :
     2423   define input parameter p-string-1       as character        no-undo.
     2424   define input parameter p-string-2       as character        no-undo.
     2425   define input parameter p-delimiter      as character        no-undo.
     2426   define input parameter p-length         as integer          no-undo.
     2427   define output parameter p-out-string    as character        no-undo.
     2428   do
     2429   on error undo, return error
     2430   :
     2431       assign
     2432           p-out-string = ( if p-string-1 = ?
     2433                            then "":U
     2434                            else trim( p-string-1 ) )
     2435       .
     2436       assign
     2437           p-out-string = p-out-string
     2438                        + ( if p-out-string = "":U
     2439                            or length( p-out-string ) = p-length
     2440                            or p-string-2 = ?
     2441                            or trim( p-string-2 ) = "":U
     2442                            then "":U
     2443                            else p-delimiter )
     2444                        + ( if p-string-2 = ?
     2445                            or trim( p-string-2 ) = "":U
     2446                            then "":U
     2447                            else trim( p-string-2 ) )
     2448       .
     2449   end.
     2450   end procedure.
     2451   def var vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2452   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     2453   procedure paramls-clear :
     2454     define buffer buf_temp-param for temp-param .
     2455     do
     2456     on error undo, return error return-value
     2457     :
     2458       for each buf_temp-param
     2459       on error undo, return error
     2460       :
     2461         delete buf_temp-param .
     2462       end.
     2463     end.
     2464   end procedure.
     2465   procedure paramls-write :
     2466     define input  parameter p-code     as character no-undo .
     2467     define input  parameter p-sub-code as character no-undo .
     2468     define input  parameter p-value    as character no-undo .
     2469     define buffer buf_temp-param for temp-param .
     2470     do
     2471     on error undo, return error return-value
     2472     :
     2473       find first buf_temp-param
     2474         where buf_temp-param.param-code     = p-code
     2475           and buf_temp-param.param-sub-code = p-sub-code
     2476         no-error .
     2477       if not available buf_temp-param then do:
     2478         create buf_temp-param .
     2479         assign
     2480           buf_temp-param.param-code     = p-code
     2481           buf_temp-param.param-sub-code = p-sub-code
     2482         .
     2483       end.
     2484       assign
     2485         buf_temp-param.param-value = p-value
     2486       .
     2487     end.
     2488   end procedure.
     2489   procedure paramls-read :
     2490     define input  parameter p-code          as character no-undo .
     2491     define input  parameter p-sub-code      as character no-undo .
     2492     define input  parameter p-default-value as character no-undo .
     2493     define output parameter p-value         as character no-undo .
     2494     define buffer buf_temp-param for temp-param .
     2495     do
     2496     on error undo, return error return-value
     2497     :
     2498       find first buf_temp-param
     2499         where buf_temp-param.param-code     = p-code
     2500           and buf_temp-param.param-sub-code = p-sub-code
     2501         no-error .
     2502       if available buf_temp-param then do:
     2503         assign
     2504           p-value = buf_temp-param.param-value
     2505         .
     2506       end.
     2507       else do:
     2508         assign
     2509           p-value = p-default-value
     2510         .
     2511       end.
     2512     end.
     2513   end procedure.
     2514   procedure paramls-append :
     2515     define input  parameter p-code     as character no-undo .
     2516     define input  parameter p-sub-code as character no-undo .
     2517     define input  parameter p-value    as character no-undo .
     2518     define buffer buf_temp-param for temp-param .
     2519     do
     2520     on error undo, return error return-value
     2521     :
     2522       find first buf_temp-param
     2523            where buf_temp-param.param-code     = p-code
     2524              and buf_temp-param.param-sub-code = p-sub-code
     2525         no-error .
     2526       if not available buf_temp-param then do:
     2527         create buf_temp-param .
     2528         assign
     2529           buf_temp-param.param-code     = p-code
     2530           buf_temp-param.param-sub-code = p-sub-code
     2531           buf_temp-param.param-value    = p-value
     2532         .
     2533       end.
     2534       else do:
     2535           assign
     2536               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     2537           .
     2538       end.
     2539     end.
     2540   end procedure.
     2541   define variable parparentproc  as handle  no-undo .
     2542   define variable g#report-num   as integer no-undo .
     2543   assign
     2544     parparentproc = my-handle
     2545   .
     2546   run get-report-num in my-handle (output g#report-num).
     2547   define variable vss-include-info16 as character format "X(65)" no-undo
     2548   initial "@(#)$Workfile$ $Revision$".
