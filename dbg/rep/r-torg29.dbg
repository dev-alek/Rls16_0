     2746           CHR(9)   buf_temp_sheet2_line-data.docdate
     2747           CHR(9)   buf_temp_sheet2_line-data.doccode
     2748           CHR(9)   buf_temp_sheet2_line-data.gdssum
     2749           CHR(9)   buf_temp_sheet2_line-data.tarasum
     2750           CHR(9)   buf_temp_sheet2_line-data.buhone
     2751           CHR(9)   buf_temp_sheet2_line-data.buhtwo
     2752           chr(10)
     2753       .
     2754   end.
