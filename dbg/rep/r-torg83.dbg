     1975   define input parameter p-obj-code           as integer          no-undo.
     1976   define input parameter p-curr-code          as integer          no-undo.
     1977       define variable v-host-code    as integer      no-undo.
     1978   do
     1979   on error undo, return error
     1980   :
     1981       assign
     1982           v-torgconf-ship-type = p-obj-type
     1983           v-torgconf-ship-code = p-obj-code
     1984       .
     1985       if trim(p-obj-type) = ""
     1986       and p-obj-code = 0
     1987       then do:
     1988       assign
     1989           v-torgconf-ship-name         = "":U
     1990           v-torgconf-ship-addres       = "":U
     1991           v-torgconf-ship-post-addres  = "":U
     1992           v-torgconf-ship-phone        = "":U
     1993           v-torgconf-ship-inn          = "":U
     1994           v-torgconf-ship-kpp          = "":U
     1995           v-torgconf-ship-okpo         = "":U
     1996       .
     1997       end.
     1998       else do:
     1999       run fmtcli-get-client in this-procedure (
     2000             input p-obj-type
     2001           , input p-obj-code
     2002       ).
     2003       assign
     2004           v-torgconf-ship-name         = trim( v-fmtcli-name          )
     2005           v-torgconf-ship-engl-name    = trim( v-fmtcli-engl-name          )
     2006           v-torgconf-ship-addres       = trim( v-fmtcli-full-addres   )
     2007           v-torgconf-ship-post-addres  = trim( v-fmtcli-post-addres   )
     2008           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     2009           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     2010           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     2011           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     2012       .
     2013       end.
     2014           run fmtcli-get-bank in this-procedure (
     2015             input p-host-obj-code
     2016           , input p-obj-type
     2017           , input p-obj-code
     2018           , input p-curr-code
     2019       ).
     2020       assign
     2021           v-torgconf-ship-schet-exists = v-fmtcli-schet-exists
     2022           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
     2023           v-torgconf-ship-bank-r-schet = v-fmtcli-bank-r-schet
     2024           v-torgconf-ship-bank-c-schet = v-fmtcli-bank-c-schet
     2025           v-torgconf-ship-bank-bik     = v-fmtcli-bank-bik
     2026           v-torgconf-ship-bank-name    = v-fmtcli-bank-name
     2027           v-torgconf-ship-bank-addres  = v-fmtcli-bank-addres
     2028           v-torgconf-ship-bank-city    = v-fmtcli-bank-city
     2029       .
     2030   end.
     2031   end procedure.
     2032   procedure torgconf-get-holdfirm-code :
     2033   define input parameter p-obj-type   as character        no-undo.
     2034   define input parameter p-obj-code   as integer          no-undo.
     2035   define output parameter p-firm-code as integer          no-undo.
     2036       define variable v-firm-code-str     as character    no-undo.
     2037       define variable v-par-type          as character    no-undo.
     2038       define buffer buf_clients       for ub.clients.
     2039   do
     2040   for buf_clients
     2041   on error undo, return error
     2042   :
     2043       run gbl/clntat-v.p (
     2044             input p-obj-type
     2045           , input p-obj-code
     2046           , input 'holdfirm-code':U
     2047           , output v-firm-code-str
     2048           , output v-par-type
     2049       ).
     2050       assign
     2051           p-firm-code = integer( v-firm-code-str )
     2052       no-error.
     2053       if error-status :error
     2054       then do:
     2055           message
     2056               "Неверно задан код фирмы для печати накладных."
     2057           view-as alert-box warning.
     2058           assign
     2059               p-firm-code = 0
     2060           .
     2061       end.
     2062       else do:
     2063           find first buf_clients no-lock
     2064                where buf_clients.obj-type = 'орг':U
     2065                  and buf_clients.obj-code = p-firm-code
     2066           no-error.
     2067           if not available buf_clients
     2068           then do:
     2069               message
     2070                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     2071                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     2072               view-as alert-box warning.
     2073               assign
     2074                   p-firm-code = 0
     2075               .
     2076           end.
     2077       end.
     2078   end.
     2079   end procedure.
     2080   procedure torgconf-get-post-head:
     2081   define input  parameter p-obj-type             as character        no-undo.
     2082   define input  parameter p-obj-code             as integer          no-undo.
     2083   define output parameter p-torgconf-post-head   as character        no-undo.
     2084      define variable v-host-code         as integer      no-undo.
     2085      define buffer buf_sysconf     for ub.sysconf.
     2086        assign
     2087         p-torgconf-post-head  = ""
     2088        .
     2089   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2090   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2091     (input  p-obj-type
     2092     ,input  p-obj-code
     2093     ,output v-host-code
     2094     )  .
     2095      find first buf_sysconf no-lock
     2096      where buf_sysconf.host-code = v-host-code
     2097      no-error.
     2098      if available buf_sysconf
     2099      then do:
     2100         assign
     2101            p-torgconf-post-head = buf_sysconf.head-position
     2102         .
     2103      end.
     2104   end procedure.
     2105   procedure torgconf-get-storekeeper:
     2106   define input  parameter p-wrkr                   as integer          no-undo.
     2107   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     2108   define output parameter p-torgconf-post          as character        no-undo.
     2109      define buffer buf_sysconf     for ub.sysconf.
     2110      define buffer buf_person      for ub.person.
     2111      define buffer buf_shop        for ub.shop .
     2112      define buffer buf_store       for ub.store .
     2113      if v-torgconf-outC = "no_print"
     2114      then do:
     2115         assign p-torgconf-post = ""
     2116                p-torgconf-wrkr-name = ""
     2117                .
     2118      end.
     2119      if v-torgconf-outC = "clad_doc"
     2120      then do:
     2121         run rep/get-psn.p
     2122               (input  p-wrkr
     2123               ,output p-torgconf-wrkr-name
     2124               ) .
     2125         find first buf_person no-lock
     2126         where buf_person.psn-code = p-wrkr
     2127         no-error.
     2128         if available buf_person
     2129         then do:
     2130           p-torgconf-post = buf_person.position.
     2131         end.
     2132         if p-torgconf-post = "?":U then p-torgconf-post = "".
     2133         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2134      end.
     2135      if v-torgconf-outC = "clad_obj"
     2136      then do:
     2137         CASE v-torgconf-self-obj-type:
     2138         WHEN 'маг':U
     2139         THEN DO:
     2140            find first buf_shop no-lock
     2141            where buf_shop.obj-code = v-torgconf-self-obj-code
     2142            .
     2143            assign
     2144               p-torgconf-wrkr-name = buf_shop.store-man
     2145               p-torgconf-post = ""
     2146            .
     2147            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2148         END.
     2149         WHEN 'скл':U
     2150         THEN DO:
     2151            find first buf_store no-lock
     2152            where buf_store.obj-code = v-torgconf-self-obj-code
     2153            .
     2154            assign
     2155               p-torgconf-wrkr-name = buf_store.store-man
     2156               p-torgconf-post = ""
     2157            .
     2158            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2159         END.
     2160         OTHERWISE DO:
     2161            assign
     2162               p-torgconf-post = "":U
     2163               p-torgconf-wrkr-name = "":U
     2164            .
     2165         END.
     2166         END CASE.
     2167      end.
     2168    end procedure.
     2169   procedure torgconf-get-form-header :
     2170   define input parameter p-for-inverse    as logical          no-undo.
     2171   define input parameter p-doc-code       as character        no-undo.
     2172   define input parameter p-print-doc      as logical          no-undo.
     2173   define input parameter p-doc-date       as date             no-undo.
     2174   define input parameter p-fact-date      as date             no-undo.
     2175   define input parameter p-doc-type       as character        no-undo.
     2176   define input parameter p-status_        as character        no-undo.
     2177   define input parameter p-reverse        as logical          no-undo.
     2178   define input parameter p-sf-par         as logical          no-undo.
     2179       define variable v-attr-type         as character    no-undo.
     2180       define variable v-doc-code-standard as logical      no-undo.
     2181       define variable v-doc-date-standard as logical      no-undo.
     2182       define variable v-par-consignee-addres  as character    no-undo.
     2183       define variable v-host-code         as integer      no-undo.
     2184       define variable v-dcode-attr        as character    no-undo.
     2185       define variable v-ddate-attr        as character    no-undo.
     2186       define variable v-doc-date          as character    no-undo.
     2187       define variable v-doc-code          as character    no-undo.
     2188       define variable v-par-type          as character    no-undo.
     2189       define variable v-attr              as character    no-undo.
     2190       define buffer buf_firm          for ub.firm .
     2191       define buffer buf_clients       for ub.clients .
     2192       define buffer buf_sysconf       for ub.sysconf .
     2193       define buffer buf_shop          for ub.shop .
     2194       define buffer buf_store         for ub.store .
