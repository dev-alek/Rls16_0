     4132   procedure tg83xl-write-line-data :
     4133   define input parameter p-count             as character        no-undo .
     4134   define input parameter p-Name              as character        no-undo .
     4135   define input parameter p-EI                as character        no-undo .
     4136   define input parameter p-doc-qnty          as character        no-undo .
     4137   define input parameter p-doc-price         as character        no-undo .
     4138   define input parameter p-doc-sum           as character        no-undo .
     4139   define input parameter p-fact-qnty         as character        no-undo .
     4140   define input parameter p-fact-price        as character        no-undo .
     4141   define input parameter p-fact-sum          as character        no-undo .
     4142   define input parameter p-qnty-i            as character        no-undo .
     4143   define input parameter p-sum-i             as character        no-undo .
     4144   define input parameter p-qnty-n            as character        no-undo .
     4145   define input parameter p-sum-n             as character        no-undo .
     4146       define buffer buf_temp_line-data        for temp_line-data .
     4147   do
     4148   for buf_temp_line-data
     4149   on error undo, return error
     4150   :
     4151       for each buf_temp_line-data
     4152       :
     4153           delete buf_temp_line-data.
     4154       end.
     4155       create buf_temp_line-data.
     4156       assign
     4157           v-tg83xl-cur-data-row               = v-tg83xl-cur-data-row + 1
     4158           buf_temp_line-data.data-key         = "LD":U
     4159           buf_temp_line-data.count             = p-count
     4160           buf_temp_line-data.Name             = p-Name
     4161           buf_temp_line-data.EI               = p-EI
     4162           buf_temp_line-data.docqnty          = p-doc-qnty
     4163           buf_temp_line-data.docprice         = p-doc-price
     4164           buf_temp_line-data.docsum           = p-doc-sum
     4165           buf_temp_line-data.factqnty         = p-fact-qnty
     4166           buf_temp_line-data.factprice        = p-fact-price
     4167           buf_temp_line-data.factsum          = p-fact-sum
     4168           buf_temp_line-data.qntyi            = p-qnty-i
     4169           buf_temp_line-data.sumi             = p-sum-i
     4170           buf_temp_line-data.qntyn            = p-qnty-n
     4171           buf_temp_line-data.sumn             = p-sum-n
     4172       .
     4173       put stream excel-line unformatted
     4174                           buf_temp_line-data.data-key
     4175           chr(9)   buf_temp_line-data.count
     4176           chr(9)   buf_temp_line-data.Name
     4177           chr(9)   buf_temp_line-data.EI
     4178           chr(9)   buf_temp_line-data.docqnty
     4179           chr(9)   buf_temp_line-data.docprice
     4180           chr(9)   buf_temp_line-data.docsum
     4181           chr(9)   buf_temp_line-data.factqnty
     4182           chr(9)   buf_temp_line-data.factprice
     4183           chr(9)   buf_temp_line-data.factsum
     4184           chr(9)   buf_temp_line-data.qntyi
     4185           chr(9)   buf_temp_line-data.sumi
     4186           chr(9)   buf_temp_line-data.qntyn
     4187           chr(9)   buf_temp_line-data.sumn
     4188           chr(10)
     4189       .
     4190   end.
     4191   end procedure.
     4192   procedure tg83xl-write-cell-data :
     4193   define input parameter p-data-key   as character        no-undo.
     4194   define input parameter p-data-value as character        no-undo.
     4195       define buffer buf_temp_cell-data     for temp_cell-data.
     4196   do
     4197   for buf_temp_cell-data
     4198   on error undo, return error
     4199   :
     4200       find first buf_temp_cell-data
     4201            where buf_temp_cell-data.data-key = p-data-key
     4202       no-error.
     4203       if not available buf_temp_cell-data
     4204       then do:
     4205           create buf_temp_cell-data.
     4206           assign
     4207               buf_temp_cell-data.data-key = p-data-key
     4208           .
     4209       end.
     4210       assign
     4211           buf_temp_cell-data.data-value = p-data-value
     4212       .
     4213       put stream excel-cell unformatted
     4214                           buf_temp_cell-data.data-key
     4215           chr(9)   buf_temp_cell-data.data-value
     4216           chr(10)
     4217       .
     4218   end.
     4219   end procedure.
     4220   procedure tg83xl-run-excel :
     4221   define input parameter p-header-filename    as character    no-undo .
     4222   define input parameter p-data-filename      as character    no-undo .
     4223   define variable v-template-file-name        as character    no-undo .
     4224   define variable v-vb-file-name              as character    no-undo .
     4225       define buffer buf_temp-param for temp-param .
     4226   do
     4227   for buf_temp-param
     4228   on error undo, return error
     4229   :
     4230       create buf_temp-param.
     4231       assign
     4232           v-template-file-name    = search( "exe/tg83.xlt" )
     4233           v-vb-file-name          = search( "exe/t_97.bas")
     4234       .
     4235       if v-template-file-name = ?
     4236       or v-template-file-name = "":U
     4237       then do:
     4238           message
     4239               "Ошибка имени файла шаблона."
     4240           view-as alert-box error.
     4241       end.
     4242       if v-vb-file-name = ?
     4243       or v-vb-file-name = "":U
     4244       then do:
     4245           message
     4246               "Ошибка имени файла кода обработки."
     4247           view-as alert-box error.
     4248       end.
     4249       run paramls-write in this-procedure (
     4250             input "template":U
     4251           , input "template-file-name":U
     4252           , input v-template-file-name
     4253       ).
     4254       run paramls-write in this-procedure (
     4255             input "template":U
     4256           , input "vb-file-name":U
     4257           , input v-vb-file-name
     4258       ).
     4259       run paramls-write in this-procedure (
     4260             input "data":U
     4261           , input "data-header-filename":U
     4262           , input p-header-filename
     4263       ).
     4264       run paramls-write in this-procedure (
     4265             input "data":U
     4266           , input "data-filename":U
     4267           , input p-data-filename
     4268       ).
     4269       run gbl/macroxlt.p (
     4270           input-output table buf_temp-param
     4271       ) no-error.
     4272       if error-status :error
     4273       then do:
     4274           message
     4275                    vss-workfile vss-revision vss-description
     4276               skip(1)
     4277               skip "Ошибка создания файла Excel."
     4278               skip return-value
     4279               skip trim(error-status :get-message(1))
     4280                    trim(error-status :get-message(2))
     4281                    trim(error-status :get-message(3))
     4282           view-as alert-box error.
     4283           undo, return error .
     4284       end.
     4285   end.
     4286   end procedure.
     4287   procedure tg83xl-close :
     4288   do
     4289   on error undo, return error
     4290   :
     4291       output stream excel-line close.
     4292       output stream excel-cell close.
     4293       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     4294           export "exe/tg83.xlt":U.
     4295           export "exe/t_97.bas":U.
     4296           export v-tg83xl-cell-file-name.
     4297           export v-tg83xl-data-file-name.
     4298       output close.
     4299   end.
     4300   end procedure.
