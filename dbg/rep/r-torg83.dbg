     1832   procedure torgconf-get-sup-param :
     1833   define input parameter p-obj-type           as character        no-undo.
     1834   define input parameter p-obj-code           as integer          no-undo.
     1835   define input parameter p-curr-code          as integer          no-undo.
     1836       define variable v-host-code    as integer      no-undo.
     1837       define variable v-par-type     as character    no-undo.
     1838   do
     1839   on error undo, return error
     1840   :
     1841       assign
     1842          v-torgconf-sup-host-code = v-host-code
     1843       .
     1844       if v-torgconf-sup-host-code = 0
     1845       then do:
     1846           assign
     1847               v-torgconf-sup-host-name           = "":U
     1848               v-torgconf-sup-host-addres         = "":U
     1849               v-torgconf-sup-host-post-addres    = "":U
     1850               v-torgconf-sup-host-phone          = "":U
     1851               v-torgconf-sup-host-inn            = "":U
     1852               v-torgconf-sup-host-kpp            = "":U
     1853               v-torgconf-sup-host-okpo           = "":U
     1854               v-torgconf-sup-host-egrip-date     = "":U
     1855               v-torgconf-sup-host-egrip-num      = "":U
     1856           .
     1857       end.
     1858       else do:
     1859           run fmtcli-get-client in this-procedure (
     1860                 input 'орг':U
     1861               , input v-torgconf-sup-host-code
     1862           ).
     1863           assign
     1864               v-torgconf-sup-host-name        = v-fmtcli-name
     1865               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     1866               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     1867               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     1868               v-torgconf-sup-host-phone       = v-fmtcli-phone
     1869               v-torgconf-sup-host-inn         = v-fmtcli-inn
     1870               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     1871               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     1872           .
     1873           run gbl/clntat-v.p (
     1874                 input 'орг':U
     1875               , input v-torgconf-sup-host-code
     1876               , input 'egrip-date':U
     1877               , output v-torgconf-sup-host-egrip-date
     1878               , output v-par-type
     1879           ).
     1880           run gbl/clntat-v.p (
     1881                 input 'орг':U
     1882               , input v-torgconf-sup-host-code
     1883               , input 'egrip-num':U
     1884               , output v-torgconf-sup-host-egrip-num
     1885               , output v-par-type
     1886           ).
     1887           run fmtcli-get-bank in this-procedure (
     1888                 input v-host-code
     1889               , input 'орг':U
     1890               , input v-torgconf-sup-host-code
     1891               , input p-curr-code
     1892           ).
     1893       end.
     1894       assign
     1895           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     1896           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     1897           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     1898           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     1899           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     1900           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     1901           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     1902           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     1903       .
     1904       assign
     1905           v-torgconf-sup-obj-type = p-obj-type
     1906           v-torgconf-sup-obj-code = p-obj-code
     1907       .
     1908       if trim(p-obj-type) <> ""
     1909       and p-obj-code <> 0
     1910       then do:
     1911       run fmtcli-get-client in this-procedure (
     1912             input p-obj-type
     1913           , input p-obj-code
     1914       ).
     1915       assign
     1916           v-torgconf-sup-obj-name        = v-fmtcli-name
     1917           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     1918           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     1919           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1920           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     1921           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     1922           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     1923       .
     1924      end.
     1925      end.
     1926   end procedure.
     1927   procedure torgconf-get-cli-param :
     1928   define input parameter p-host-obj-code      as integer          no-undo.
     1929   define input parameter p-obj-type           as character        no-undo.
     1930   define input parameter p-obj-code           as integer          no-undo.
     1931   define input parameter p-curr-code          as integer          no-undo.
     1932       define variable v-host-code    as integer      no-undo.
     1933   do
     1934   on error undo, return error
     1935   :
     1936       assign
     1937           v-torgconf-cli-type = p-obj-type
     1938           v-torgconf-cli-code = p-obj-code
     1939       .
     1940       run fmtcli-get-client in this-procedure (
     1941             input p-obj-type
     1942           , input p-obj-code
     1943       ).
     1944       assign
     1945           v-torgconf-cli-name         = trim( v-fmtcli-name          )
     1946           v-torgconf-cli-engl-name    = trim( v-fmtcli-engl-name          )
     1947           v-torgconf-cli-addres       = trim( v-fmtcli-full-addres   )
     1948           v-torgconf-cli-post-addres  = trim( v-fmtcli-post-addres   )
     1949           v-torgconf-cli-phone        = trim( v-fmtcli-phone         )
     1950           v-torgconf-cli-inn          = trim( v-fmtcli-inn           )
     1951           v-torgconf-cli-kpp          = trim( v-fmtcli-kpp           )
     1952           v-torgconf-cli-okpo         = trim( v-fmtcli-okpo          )
     1953       .
     1954      run fmtcli-get-bank in this-procedure (
     1955             input p-host-obj-code
     1956           , input p-obj-type
     1957           , input p-obj-code
     1958           , input p-curr-code
     1959       ).
     1960       assign
     1961           v-torgconf-cli-schet-exists = v-fmtcli-schet-exists
     1962           v-torgconf-cli-bank-exists  = v-fmtcli-bank-exists
     1963           v-torgconf-cli-bank-r-schet = v-fmtcli-bank-r-schet
     1964           v-torgconf-cli-bank-c-schet = v-fmtcli-bank-c-schet
     1965           v-torgconf-cli-bank-bik     = v-fmtcli-bank-bik
     1966           v-torgconf-cli-bank-name    = v-fmtcli-bank-name
     1967           v-torgconf-cli-bank-addres  = v-fmtcli-bank-addres
     1968           v-torgconf-cli-bank-city    = v-fmtcli-bank-city
     1969       .
