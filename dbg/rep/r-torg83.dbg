     1492   procedure torgconf-get-self-param :
     1493   define input parameter p-obj-type           as character        no-undo.
     1494   define input parameter p-obj-code           as integer          no-undo.
     1495   define input parameter p-curr-code          as integer          no-undo.
     1496       define variable v-host-code    as integer      no-undo.
     1497       define variable v-par-type     as character    no-undo.
     1498   do
     1499   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1))
     1500   :
     1501   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1502   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1503     (input  p-obj-type
     1504     ,input  p-obj-code
     1505     ,output v-host-code
     1506     )  .
     1507       if v-torgconf-outhold = yes
     1508       then do:
     1509           run torgconf-get-holdfirm-code in this-procedure (
     1510                 input p-obj-type
     1511               , input p-obj-code
     1512               , output v-torgconf-self-host-code
     1513           ).
     1514           if v-torgconf-self-host-code = 0
     1515           then do:
     1516               return error.
     1517           end.
     1518       end.
     1519       else do:
     1520           assign
     1521               v-torgconf-self-host-code = v-host-code
     1522           .
     1523       end.
     1524       if v-torgconf-self-host-code = 0
     1525       then do:
     1526           assign
     1527               v-torgconf-self-host-name           = "":U
     1528               v-torgconf-self-host-addres         = "":U
     1529               v-torgconf-self-host-post-addres    = "":U
     1530               v-torgconf-self-host-phone          = "":U
     1531               v-torgconf-self-host-inn            = "":U
     1532               v-torgconf-self-host-kpp            = "":U
     1533               v-torgconf-self-host-okpo           = "":U
     1534               v-torgconf-self-host-egrip-date     = "":U
     1535               v-torgconf-self-host-egrip-num      = "":U
     1536           .
     1537       end.
     1538       else do:
     1539           run fmtcli-get-client in this-procedure (
     1540                 input 'орг':U
     1541               , input v-torgconf-self-host-code
     1542           ).
     1543           assign
     1544               v-torgconf-self-host-name        = v-fmtcli-name
     1545               v-torgconf-self-host-engl-name   = v-fmtcli-engl-name
     1546               v-torgconf-self-host-addres      = v-fmtcli-full-addres
     1547               v-torgconf-self-host-post-addres = v-fmtcli-post-addres
     1548               v-torgconf-self-host-phone       = v-fmtcli-phone
     1549               v-torgconf-self-host-inn         = v-fmtcli-inn
     1550               v-torgconf-self-host-kpp         = v-fmtcli-kpp
     1551               v-torgconf-self-host-okpo        = v-fmtcli-okpo
     1552           .
     1553           run gbl/clntat-v.p (
     1554                 input 'орг':U
     1555               , input v-torgconf-self-host-code
     1556               , input 'egrip-date':U
     1557               , output v-torgconf-self-host-egrip-date
     1558               , output v-par-type
     1559           ).
     1560           run gbl/clntat-v.p (
     1561                 input 'орг':U
     1562               , input v-torgconf-self-host-code
     1563               , input 'egrip-num':U
     1564               , output v-torgconf-self-host-egrip-num
     1565               , output v-par-type
     1566           ).
     1567           run fmtcli-get-bank in this-procedure (
     1568                 input v-host-code
     1569               , input 'орг':U
     1570               , input v-torgconf-self-host-code
     1571               , input p-curr-code
     1572           ).
     1573       end.
     1574       assign
     1575           v-torgconf-self-schet-exists = v-fmtcli-schet-exists
     1576           v-torgconf-self-bank-exists  = v-fmtcli-bank-exists
     1577           v-torgconf-self-bank-r-schet = v-fmtcli-bank-r-schet
     1578           v-torgconf-self-bank-c-schet = v-fmtcli-bank-c-schet
     1579           v-torgconf-self-bank-bik     = v-fmtcli-bank-bik
     1580           v-torgconf-self-bank-name    = v-fmtcli-bank-name
     1581           v-torgconf-self-bank-addres  = v-fmtcli-bank-addres
     1582           v-torgconf-self-bank-city    = v-fmtcli-bank-city
     1583       .
     1584       assign
     1585           v-torgconf-self-obj-type = p-obj-type
     1586           v-torgconf-self-obj-code = p-obj-code
     1587       .
     1588       run fmtcli-get-client in this-procedure (
     1589             input p-obj-type
     1590           , input p-obj-code
     1591       ).
     1592       assign
     1593           v-torgconf-self-obj-name       = v-fmtcli-name
     1594           v-torgconf-self-obj-engl-name  = v-fmtcli-engl-name
     1595           v-torgconf-self-obj-addres     = v-fmtcli-full-addres
     1596           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1597           v-torgconf-self-obj-phone      = v-fmtcli-phone
     1598           v-torgconf-self-obj-inn        = v-fmtcli-inn
     1599           v-torgconf-self-obj-okpo       = v-fmtcli-okpo
     1600       .
     1601   end.
     1602   end procedure.
     1603   procedure torgconf-get-recepient-param :
     1604   define input parameter torgconfdoc-code   as character                  no-undo.
     1605   define output parameter v-code-rec        as integer                    no-undo .
     1606   define output parameter v-type-rec        as character                  no-undo initial 'C':U.
     1607   define output parameter v-codefirm-rec    as integer                    no-undo .
     1608   define output parameter v-curcode-rec     as integer                    no-undo .
     1609        define variable  v-recipient-code  as character                  no-undo .
     1610        define variable  v-recipient       like ub.doc-attr.attr-value   no-undo.
     1611        define variable  v-trdcattr-type   as character                  no-undo initial 'C':U.
     1612   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input torgconfdoc-code ,
     1613                           input 'Recipient':U ,
     1614                          output v-recipient-code ,
     1615                          output v-trdcattr-type ) no-error .
     1616       if error-status :error then do:
     1617        message
     1618         vss-workfile vss-revision vss-description skip
     1619         "Ошибка при вызове процедуры tdat-val":U skip
     1620         "Документ: " torgconfdoc-code skip
     1621         "Атрибут: " 'Recipient':U skip
     1622         "Значение: " v-recipient skip
     1623         trim( error-status :get-message (1) ) skip
     1624         return-value skip
     1625         view-as alert-box error.
     1626       undo, return error return-value.
     1627       end.
     1628     assign
     1629       v-recipient  = v-recipient-code
     1630       v-type-rec = substring(v-recipient-code,1,3)
     1631       v-code-rec  = int(substring(v-recipient-code,4,15))
     1632       no-error
     1633     .
     1634     if v-type-rec = ? then v-type-rec = "" .
     1635     if v-code-rec  = ? then v-code-rec  =  0 .
     1636     end procedure.
