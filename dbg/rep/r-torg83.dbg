        1   block-level on error undo, throw.
        2   define input parameter p-mainmenu-handle    as handle           no-undo.
        3   define input parameter rec_id               as recid            no-undo.
        4   define input parameter Invers               as logical          no-undo.
        5   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo initial "$Workfile: r-torg83.p $":U .
        9   define variable vss-archive     as character no-undo initial "$Archive: rep/r-torg83.p $":U .
       10   define variable vss-description as character no-undo initial "Акт о расхождении при приемке товара. ТОРГ-8.3 (Кедр-М)":U .
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define new global shared variable g#lib-trn  as handle no-undo .
       72   define new global shared variable g#lib-trn2 as handle no-undo .
       73   define new global shared variable g#lib-trn3 as handle no-undo .
       74   define new global shared variable g#lib-trn4 as handle no-undo .
       75   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       76   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       77   define  shared variable RepPathName        as character no-undo .
       78   define  shared variable PrintRubl          as logical   no-undo .
       79   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   procedure cur-time :
       81      define output parameter p-today as date      no-undo .
       82      define output parameter p-time  as integer   no-undo .
       83     do
       84     on error undo, return error
       85     :
       86       define variable v-date1 as date      no-undo .
       87       define variable v-date2 as date      no-undo .
       88       define variable v-time  as integer   no-undo .
       89       assign
       90         v-date1 = today
       91         v-time  = time
       92         v-date2 = today
       93       .
       94       if v-date1 <> v-date2
       95       then do:
       96         assign
       97           v-date1 = today
       98           v-time  = v-time
       99         .
      100       end.
      101       assign
      102         p-today = v-date1
      103         p-time  = v-time
      104       .
      105     end.
      106   end.
      107   function cur-time-date returns character
      108   :
      109     return string(today, '99/99/9999':U) .
      110   end.
      111   function cur-time-mjd returns decimal
      112   :
      113     define variable v-date as date      no-undo .
      114     define variable v-time as integer   no-undo .
      115     run cur-time in this-procedure
      116       (output v-date
      117       ,output v-time
      118       ) .
      119     return integer(v-date) - 2400002 + (v-time / 86400) .
      120   end.
      121   function cur-time-get-ending-index returns integer
      122   (input p-number as integer
      123   )
      124   :
      125     if p-number < 0
      126     or p-number = ?
      127     then do:
      128       return 1 .
      129     end.
      130     define variable v-rest as integer   no-undo .
      131     assign
      132       p-number = p-number modulo 100
      133     .
      134     if p-number < 20
      135     then do:
      136       assign
      137         v-rest = p-number
      138       .
      139     end.
      140     else do:
      141       assign
      142         v-rest = p-number modulo 10
      143       .
      144     end.
      145     case v-rest :
      146       when 1
      147       then do:
      148         return 2 .
      149       end.
      150       when 2 or
      151       when 3 or
      152       when 4
      153       then do:
      154         return 3 .
      155       end.
      156       otherwise do:
      157         return 1 .
      158       end.
      159     end case .
      160   end.
      161   procedure cur-time-mjd-to-date :
      162      define input  parameter i-mjd-diff as decimal no-undo.
      163      define output parameter o-Date     as date    no-undo.
      164      define output parameter o-Time     as integer no-undo.
      165      define variable v-day-number as integer   no-undo .
      166      if    i-mjd-diff < 0
      167         or i-mjd-diff = ?
      168      then do:
      169         return "?" .
      170      end.
      171      assign
      172         v-day-number = truncate(i-mjd-diff,0).
      173         o-Date = date(v-day-number + 2400002).
      174         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      175     .
      176   end.
      177   function cur-time-mjd-to-string returns character
      178   (input p-mjd-diff as decimal
      179   )
      180   :
      181     define variable v-day-number as integer   no-undo .
      182     define variable v-seconds    as integer   no-undo .
      183     define variable v-hour       as integer   no-undo .
      184     define variable v-min        as integer   no-undo .
      185     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      186     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      187     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      188     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      189     if p-mjd-diff < 0
      190     or p-mjd-diff = ?
      191     then do:
      192       return "?" .
      193     end.
      194     assign
      195       v-day-number = integer(truncate(p-mjd-diff,0))
      196       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      197     .
      198     if v-seconds > 86400
      199     then do:
      200       assign
      201         v-seconds = 86400 - 1
      202       .
      203     end.
      204     if v-seconds < 0
      205     then do:
      206       assign
      207         v-seconds = 0
      208       .
      209     end.
      210     assign
      211       v-hour = truncate(v-seconds / 3600, 0)
      212     .
      213     assign
      214       v-seconds = v-seconds modulo 3600
      215     .
      216     assign
      217       v-min = truncate(v-seconds / 60, 0)
      218     .
      219     assign
      220       v-seconds = v-seconds modulo 60
      221     .
      222     return
      223         (if v-day-number <> 0
      224           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      225           else ""
      226         )
      227       + (if v-day-number <> 0 or v-hour <> 0
      228           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      229           else ""
      230         )
      231       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      232           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      233           else ""
      234         )
      235       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      236       .
      237   end.
      238   function cur-time-string returns character
      239   :
      240     define variable v-date as date      no-undo .
      241     define variable v-time as integer   no-undo .
      242     run cur-time in this-procedure
      243       (output v-date
      244       ,output v-time
      245       ) .
      246     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      247   end.
      248   function cur-time-string-sec returns character
      249   :
      250     define variable v-date as date      no-undo .
      251     define variable v-time as integer   no-undo .
      252     run cur-time in this-procedure
      253       (output v-date
      254       ,output v-time
      255       ) .
      256     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      257   end.
      258   function cur-time-custom  returns character
      259   (input p-prefix as character
      260   ,input p-date-format as character
      261   ,input p-delimiter as character
      262   ,input p-time-format as character
      263   ,input p-suffix as character
      264   )
      265   :
      266     define variable v-date as date      no-undo .
      267     define variable v-time as integer   no-undo .
      268     run cur-time in this-procedure
      269       (output v-date
      270       ,output v-time
      271       ) .
      272     return
      273       p-prefix
      274       + string(v-date, p-date-format)
      275       + p-delimiter
      276       + string(v-time, p-time-format)
      277       + p-suffix
      278       .
      279   end.
      280   function cur-time-print  returns character
      281   :
      282     define variable v-date as date      no-undo .
      283     define variable v-time as integer   no-undo .
      284     run cur-time in this-procedure
      285       (output v-date
      286       ,output v-time
      287       ) .
      288     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      289   end.
      290   function cur-time-datetime returns datetime
      291   :
      292     define variable v-char as character no-undo .
      293     define variable v-datetime as datetime no-undo .
      294     v-char = cur-time-string().
      295     v-datetime = datetime(v-char).
      296     return  v-datetime.
      297   end.
      298   function cur-time-string-msec returns character
      299   :
      300     define variable v-date as datetime  no-undo .
      301     v-date = now.
      302     return string(v-date) .
      303   end.
      304   define variable vss-include-info2 as character format "X(65)" no-undo
      305   initial "@(#)$Workfile$ $Revision$".
      306   define variable v-fmtcli-name          as character    no-undo.
      307   define variable v-fmtcli-engl-name     as character    no-undo.
      308   define variable v-fmtcli-addres        as character    no-undo.
      309   define variable v-fmtcli-post-addres   as character    no-undo.
      310   define variable v-fmtcli-full-addres   as character    no-undo.
      311   define variable v-fmtcli-phone         as character    no-undo.
      312   define variable v-fmtcli-inn           as character    no-undo.
      313   define variable v-fmtcli-kpp           as character    no-undo.
      314   define variable v-fmtcli-okpo          as character    no-undo.
      315   define variable v-fmtcli-country       as character    no-undo.
      316   define variable v-fmtcli-city          as character    no-undo.
      317   define variable v-fmtcli-index         as character    no-undo.
      318   define variable v-fmtcli-schet-exists  as logical      no-undo.
      319   define variable v-fmtcli-bank-exists   as logical      no-undo.
      320   define variable v-fmtcli-bank-r-schet  as character    no-undo.
      321   define variable v-fmtcli-bank-c-schet  as character    no-undo.
      322   define variable v-fmtcli-bank-bik      as character    no-undo.
      323   define variable v-fmtcli-bank-name     as character    no-undo.
      324   define variable v-fmtcli-bank-addres   as character    no-undo.
      325   define variable v-fmtcli-bank-city     as character    no-undo.
      326   procedure fmtcli-get-bank :
      327   define input parameter p-host-code      as integer          no-undo.
      328   define input parameter p-obj-type       as character        no-undo.
      329   define input parameter p-obj-code       as integer          no-undo.
      330   define input parameter p-curr-code      as integer          no-undo.
      331       define buffer buf_fin-schet     for ub.fin-schet.
      332       define buffer buf_fin-bank      for ub.fin-bank.
      333   do
      334   for buf_fin-schet
      335     , buf_fin-bank
      336   on error undo, return error
      337   :
      338       assign
      339           v-fmtcli-schet-exists       = no
      340           v-fmtcli-bank-exists        = no
      341           v-fmtcli-bank-r-schet       = "":U
      342           v-fmtcli-bank-c-schet       = "":U
      343           v-fmtcli-bank-bik           = "":U
      344           v-fmtcli-bank-name          = "":U
      345           v-fmtcli-bank-addres        = "":U
      346           v-fmtcli-bank-city          = "":U
      347       .
      348       search-for-schet:
      349       for each buf_fin-schet no-lock
      350          where buf_fin-schet.host-code = p-host-code
      351            and buf_fin-schet.cli-type  = p-obj-type
      352            and buf_fin-schet.cli-code  = p-obj-code
      353            and buf_fin-schet.curr-code = p-curr-code
      354       on error undo, return error
      355       :
      356           if buf_fin-schet.status_   = 'удал':U
      357           then do:
      358           end.
      359           else do:
      360               assign
      361                   v-fmtcli-schet-exists   = yes
      362                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      363                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      364               .
      365               find first buf_fin-bank no-lock
      366                    where buf_fin-bank.host-code = p-host-code
      367                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      368               no-error.
      369               if available buf_fin-bank
      370               then do:
      371                   assign
      372                       v-fmtcli-bank-exists      = yes
      373                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      374                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      375                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      376                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      377                   .
      378               end.
      379               else do:
      380                   assign
      381                       v-fmtcli-bank-exists    = no
      382                       v-fmtcli-bank-bik       = "":U
      383                       v-fmtcli-bank-name      = "":U
      384                       v-fmtcli-bank-addres    = "":U
      385                       v-fmtcli-bank-city      = "":U
      386                   .
      387               end.
      388               leave search-for-schet.
      389           end.
      390       end.
      391   end.
      392   end procedure.
      393   procedure fmtcli-get-client :
      394   define input parameter p-obj-type       as character    no-undo.
      395   define input parameter p-obj-code       as integer      no-undo.
      396       define variable v-temp-fmtcli-address      as character     no-undo.
      397       define variable v-num-country-city    as integer      no-undo.
      398       define buffer buf_clients   for ub.clients.
      399       define buffer buf_firm      for ub.firm.
      400       define buffer buf_store     for ub.store.
      401       define buffer buf_shop      for ub.shop.
      402       define buffer buf_person    for ub.person.
      403   do
      404   for buf_clients
      405     , buf_firm
      406     , buf_store
      407     , buf_shop
      408     , buf_person
      409   on error undo, return error
      410   :
      411       assign
      412           v-fmtcli-name           = "":U
      413           v-fmtcli-addres         = "":U
      414           v-fmtcli-post-addres    = "":U
      415           v-fmtcli-full-addres    = "":U
      416           v-fmtcli-phone          = "":U
      417           v-fmtcli-inn            = "":U
      418           v-fmtcli-kpp            = "":U
      419           v-fmtcli-okpo           = "":U
      420           v-fmtcli-city           = "":U
      421           v-fmtcli-index          = "":U
      422           v-fmtcli-country        = "":U
      423       .
      424       find first buf_clients no-lock
      425            where buf_clients.obj-type = p-obj-type
      426              and buf_clients.obj-code = p-obj-code
      427       .
      428       assign
      429           v-fmtcli-name = buf_clients.obj-name
      430       .
      431       case buf_clients.obj-type:
      432          when 'орг':U
      433          then do:
      434               find first buf_firm no-lock
      435                    where buf_firm.firm-code = buf_clients.obj-code
      436                    no-error
      437               .
      438               if available buf_firm
      439               then do:
      440                   assign
      441                       v-num-country-city = num-entries( buf_firm.city )
      442                       v-fmtcli-engl-name = buf_firm.engl-name
      443                   .
      444                   if v-num-country-city > 0
      445                   then do:
      446                       assign
      447                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
      448                       .
      449                   end.
      450                   if v-num-country-city > 1
      451                   then do:
      452                       assign
      453                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
      454                       .
      455                   end.
      456                   run fmtcli-concatenate-strings in this-procedure (
      457                         input v-fmtcli-full-addres
      458                       , input v-fmtcli-country
      459                       , input ", ":U
      460                       , input 50
      461                       , output v-fmtcli-full-addres
      462                   ).
      463                   run fmtcli-concatenate-strings in this-procedure (
      464                         input v-fmtcli-full-addres
      465                       , input v-fmtcli-city
      466                       , input ", ":U
      467                       , input 50
      468                       , output v-fmtcli-full-addres
      469                   ).
      470                   run fmtcli-concatenate-strings in this-procedure (
      471                         input v-fmtcli-full-addres
      472                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
      473                       , input ", ":U
      474                       , input 50
      475                       , output v-fmtcli-full-addres
      476                   ).
      477                   run fmtcli-concatenate-strings in this-procedure (
      478                         input v-fmtcli-post-addres
      479                       , input v-fmtcli-country
      480                       , input ", ":U
      481                       , input 50
      482                       , output v-fmtcli-post-addres
      483                   ).
      484                   run fmtcli-concatenate-strings in this-procedure (
      485                         input v-fmtcli-post-addres
      486                       , input v-fmtcli-city
      487                       , input ", ":U
      488                       , input 50
      489                       , output v-fmtcli-post-addres
      490                   ).
      491                   run fmtcli-concatenate-strings in this-procedure (
      492                         input v-fmtcli-post-addres
      493                       , input string( buf_firm.ind )
      494                       , input ", ":U
      495                       , input 50
      496                       , output v-fmtcli-post-addres
      497                   ).
      498                   run fmtcli-concatenate-strings in this-procedure (
      499                         input substring( buf_firm.addres1, 1, 50 )
      500                       , input buf_firm.addres2
      501                       , input " ":U
      502                       , input 50
      503                       , output v-temp-fmtcli-address
      504                   ).
      505                   run fmtcli-concatenate-strings in this-procedure (
      506                         input v-temp-fmtcli-address
      507                       , input substring( buf_firm.addres1, 51, 50 )
      508                       , input " ":U
      509                       , input 50
      510                       , output v-temp-fmtcli-address
      511                   ).
      512                   run fmtcli-concatenate-strings in this-procedure (
      513                         input v-temp-fmtcli-address
      514                       , input substring( buf_firm.addres1, 101, 50 )
      515                       , input " ":U
      516                       , input 50
      517                       , output v-temp-fmtcli-address
      518                   ).
      519                   assign
      520                       v-fmtcli-addres = v-temp-fmtcli-address
      521                   .
      522                   if buf_firm.addres1 <> ?
      523                   then do:
      524                       run fmtcli-concatenate-strings in this-procedure (
      525                             input v-fmtcli-full-addres
      526                           , input v-fmtcli-addres
      527                           , input ", ":U
      528                           , input 0
      529                           , output v-fmtcli-full-addres
      530                       ).
      531                   end.
      532                   run fmtcli-concatenate-strings in this-procedure (
      533                         input substring( buf_firm.post-addr1, 1, 50 )
      534                       , input buf_firm.post-addr2
      535                       , input " ":U
      536                       , input 50
      537                       , output v-fmtcli-post-addres
      538                   ).
      539                   run fmtcli-concatenate-strings in this-procedure (
      540                         input v-fmtcli-post-addres
      541                       , input substring( buf_firm.post-addr1, 51, 50 )
      542                       , input " ":U
      543                       , input 50
      544                       , output v-fmtcli-post-addres
      545                   ).
      546                   run fmtcli-concatenate-strings in this-procedure (
      547                         input v-fmtcli-post-addres
      548                       , input substring( buf_firm.post-addr1, 101, 50 )
      549                       , input " ":U
      550                       , input 50
      551                       , output v-fmtcli-post-addres
      552                   ).
      553                   assign
      554                       v-fmtcli-phone         = buf_firm.phone
      555                       v-fmtcli-inn           = buf_firm.inn
      556                       v-fmtcli-kpp           = buf_firm.kpp
      557                       v-fmtcli-okpo          = buf_firm.okpo
      558                       v-fmtcli-index         = string( buf_firm.ind )
      559                   .
      560               end.
      561          end.
      562          when 'маг':U
      563          then do:
      564               find first buf_shop no-lock
      565                    where buf_shop.obj-code = buf_clients.obj-code
      566               .
      567               if available buf_shop
      568               then do:
      569                   run fmtcli-concatenate-strings in this-procedure (
      570                         input buf_shop.addres1
      571                       , input buf_shop.addres2
      572                       , input " ":U
      573                       , input 50
      574                       , output v-fmtcli-addres
      575                   ).
      576                   assign
      577                       v-fmtcli-full-addres = v-fmtcli-addres
      578                       v-fmtcli-post-addres = v-fmtcli-addres
      579                       v-fmtcli-phone       = buf_shop.phone
      580                       v-fmtcli-inn         = "":U
      581                       v-fmtcli-kpp         = "":U
      582                       v-fmtcli-okpo        = "":U
      583                       v-fmtcli-city        = "":U
      584                       v-fmtcli-index       = "":U
      585                   .
      586               end.
      587          end.
      588          when 'скл':U
      589          then do:
      590               find first buf_store no-lock
      591                    where buf_store.obj-code = buf_clients.obj-code
      592               .
      593               if available buf_store
      594               then do:
      595                   run fmtcli-concatenate-strings in this-procedure (
      596                         input buf_store.addres1
      597                       , input buf_store.addres2
      598                       , input " ":U
      599                       , input 50
      600                       , output v-fmtcli-addres
      601                   ).
      602                   assign
      603                       v-fmtcli-full-addres = v-fmtcli-addres
      604                       v-fmtcli-phone       = buf_store.phone
      605                       v-fmtcli-inn         = "":U
      606                       v-fmtcli-kpp         = "":U
      607                       v-fmtcli-okpo        = "":U
      608                       v-fmtcli-city        = "":U
      609                       v-fmtcli-index       = "":U
      610                   .
      611               end.
      612          end.
      613          when 'чел':U
      614          then do:
      615               find first buf_person no-lock
      616                    where buf_person.psn-code = buf_clients.obj-code
      617               .
      618               if available buf_person
      619               then do:
      620                   run fmtcli-concatenate-strings in this-procedure (
      621                         input ( if buf_person.ind = 0 or buf_person.ind = ?
      622                                 then "":U
      623                                 else string( buf_person.ind, "999999")
      624                                 )
      625                       , input buf_person.city
      626                       , input ", ":U
      627                       , input 0
      628                       , output v-fmtcli-full-addres
      629                   ).
      630                   assign
      631                       v-fmtcli-addres = buf_person.address
      632                   .
      633                   run fmtcli-concatenate-strings in this-procedure (
      634                         input v-fmtcli-full-addres
      635                       , input v-fmtcli-addres
      636                       , input ", ":U
      637                       , input 0
      638                       , output v-fmtcli-full-addres
      639                   ).
      640                   assign
      641                       v-fmtcli-phone     = buf_person.phone1
      642                       v-fmtcli-inn       = buf_person.inn
      643                       v-fmtcli-kpp       = buf_person.kpp
      644                       v-fmtcli-okpo      = buf_person.okpo
      645                       v-fmtcli-city      = buf_person.city
      646                       v-fmtcli-index     = string( buf_person.ind )
      647                   .
      648               end.
      649          end.
      650       end case.
      651   end.
      652   end procedure.
      653   procedure fmtcli-concatenate-strings :
      654   define input parameter p-string-1       as character        no-undo.
      655   define input parameter p-string-2       as character        no-undo.
      656   define input parameter p-delimiter      as character        no-undo.
      657   define input parameter p-length         as integer          no-undo.
      658   define output parameter p-out-string    as character        no-undo.
      659   do
      660   on error undo, return error
      661   :
      662       assign
      663           p-out-string = ( if p-string-1 = ?
      664                            then "":U
      665                            else trim( p-string-1 ) )
      666       .
      667       assign
      668           p-out-string = p-out-string
      669                        + ( if p-out-string = "":U
      670                            or length( p-out-string ) = p-length
      671                            or p-string-2 = ?
      672                            or trim( p-string-2 ) = "":U
      673                            then "":U
      674                            else p-delimiter )
      675                        + ( if p-string-2 = ?
      676                            or trim( p-string-2 ) = "":U
      677                            then "":U
      678                            else trim( p-string-2 ) )
      679       .
      680   end.
      681   end procedure.
