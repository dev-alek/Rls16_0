     4424                           input 'dids':U ,
     4425                          output v-attr-value ,
     4426                          output v-attr-type )  .
     4427       if v-attr-value > "" then do :
     4428               assign v-dnakl = string(date(v-attr-value), "99/99/9999") .
     4429           end.
     4430           else do :
     4431               assign v-dnakl = v-torgconf-doc-date .
     4432           end .
     4433       run gbl/num-monr.p (input substring(v-torgconf-doc-date, 4, 2)
     4434                         , output v-name-month
     4435                         ).
     4436       assign v-docdate = "от " + substring(v-torgconf-doc-date, 1, 2) + " " + v-name-month + " " + substring(v-torgconf-doc-date, 7, 4) + " года".
     4437   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input t-doc.doc-code ,
     4438                           input 'ndog':U ,
     4439                          output v-attr-value ,
     4440                          output v-attr-type )  .
     4441       if v-attr-value > "" then do :
     4442           assign v-ndog = v-attr-value .
     4443       end .
     4444       else do :
     4445         find first buf_contract no-lock
     4446           where buf_Contract.host-code     = t-doc.host-code
     4447             and buf_Contract.contract-code = t-doc.contract-code no-error.
     4448             if available buf_contract then do :
     4449                assign v-ndog = buf_contract.contract-prn-code .
     4450             end .
     4451       end .
     4452   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input t-doc.doc-code ,
     4453                           input 'ddog':U ,
     4454                          output v-attr-value ,
     4455                          output v-attr-type )  .
     4456       if v-attr-value > "" then do :
     4457          assign v-ddog = string(date(v-attr-value), "99/99/9999") .
     4458       end .
     4459       else do :
     4460         find first buf_contract no-lock
     4461           where buf_Contract.host-code     = t-doc.host-code
     4462             and buf_Contract.contract-code = t-doc.contract-code no-error .
     4463             if available buf_contract then do :
     4464                assign v-ddog = string(buf_contract.contract-date, "99/99/9999") .
     4465             end .
     4466       end .
     4467       run rep/get-psn.p
     4468       (input t-doc.wrkr
     4469       ,output v-Wrkr_name
     4470       ) .
     4471   if session :set-wait-state( "compiler" ) then.
     4472   output stream out-stream to value( string( session:temp-directory +
     4473                                        "rpt" + string( g#report-num ) ) )
     4474                                        page-size 62 .
     4475      run tg83xl-init in this-procedure .
     4476     run for-each in this-procedure  .
     4477     run tg83xl-write-cell-data in this-procedure (
     4478           input "h_organization":U
     4479         , input v-organization
     4480     ).
     4481     run tg83xl-write-cell-data in this-procedure (
     4482           input "h_organization2":U
     4483         , input v-organization
     4484     ).
     4485     run tg83xl-write-cell-data in this-procedure (
     4486           input "h_object":U
     4487         , input v-torgconf-self-obj-name
     4488     ).
     4489     run tg83xl-write-cell-data in this-procedure (
     4490           input "h_cargoToValue":U
     4491         , input v-torgconf-cargo-from-value
     4492     ).
     4493     run tg83xl-write-cell-data in this-procedure (
     4494           input "h_supplier":U
     4495         , input v-torgconf-supplier + ' ' + v-torgconf-cli-phone
     4496     ).
     4497     run tg83xl-write-cell-data in this-procedure (
     4498           input "h_docDate":U
     4499         , input v-docdate
     4500     ).
     4501     if v-Wrkr_name > "" and v-Wrkr_name ne "?" then do :
     4502     run tg83xl-write-cell-data in this-procedure (
     4503           input "h_wrkrname":U
     4504         , input v-Wrkr_name
     4505     ).
     4506     end.
     4507     if v-pass > "" and v-pass ne "?" then do :
     4508     run tg83xl-write-cell-data in this-procedure (
     4509           input "h_pass":U
     4510         , input v-pass
     4511     ).
     4512     end.
     4513     if v-dover > "" and v-dover ne "?" then do :
     4514     run tg83xl-write-cell-data in this-procedure (
     4515           input "f_dover":U
     4516         , input v-dover
     4517     ).
     4518     end.
     4519     run tg83xl-write-cell-data in this-procedure (
     4520           input "h_dnakl":U
     4521         , input v-dnakl
     4522     ).
     4523     run tg83xl-write-cell-data in this-procedure (
     4524           input "h_nnakl":U
     4525         , input v-nnakl
     4526     ).
     4527     run tg83xl-write-cell-data in this-procedure (
     4528           input "h_ddog":U
     4529         , input v-ddog
     4530     ).
     4531     run tg83xl-write-cell-data in this-procedure (
     4532           input "h_ndog":U
     4533         , input v-ndog
     4534     ).
     4535     run tg83xl-write-line-data in this-procedure (
     4536           input ""
     4537         , input "ИТОГО"
     4538         , input ""
     4539         , input all-doc-qnty
     4540         , input ""
     4541         , input all-doc-sum
     4542         , input all-fact-qnty
     4543         , input ""
     4544         , input all-fact-sum
     4545         , input all-qnty-i
     4546         , input all-sum-i
     4547         , input all-qnty-n
     4548         , input all-sum-n
     4549     ).
     4550     run tg83xl-close in this-procedure .
     4551     put stream out-stream unformatted
     4552            chr(10)
     4553         + "Печатная форма предназначена только для вывода в Microsoft Excel."
     4554         + chr(10)
     4555      .
     4556     output stream out-stream close.
     4557   if g#quest-print = false
     4558   then do:
     4559     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     4560                                         7, (if 4 >= 8 then 2 else 0), 0, 0,
     4561                                         OUTPUT g#log ).
     4562   end.
     4563   else do:
     4564     os-command silent
     4565       value( "COPY /b " +
     4566         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     4567         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     4568         string( session:temp-directory) +  "$" + string( g#report-num )
     4569                 ) .
     4570     os-command silent
     4571       value( "COPY /b " +
     4572         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     4573         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     4574         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     4575                 ) .
     4576   end.
     4577   if session :set-wait-state( "" ) then.
     4578    end.
     4579   procedure for-each :
     4580     do on error undo, return error return-value :
     4581             for each buf_doc-line no-lock
     4582               where buf_doc-line.doc-code = t-doc.doc-code
     4583               , first buf_goods no-lock
     4584                 where buf_goods.artic      = buf_doc-line.artic
     4585                   and buf_goods.prod-type  = buf_doc-line.prod-type
     4586                   and buf_goods.prod-code  = buf_doc-line.prod-code
     4587               break by buf_goods.gds-name
     4588             :
     4589               run print-line in this-procedure .
     4590    end.
     4591     end.
     4592   end procedure.
     4593   procedure print-line :
     4594     do on error undo, return error return-value :
     4595           if (buf_doc-line.fact-qnty - buf_doc-line.doc-qnty < 0 ) then
     4596             assign qnty-n = buf_doc-line.doc-qnty - buf_doc-line.fact-qnty   qnty-i = 0 .
     4597           else
     4598             assign qnty-i = buf_doc-line.fact-qnty - buf_doc-line.doc-qnty  qnty-n = 0 .
     4599             assign
     4600                 v-count       = v-count + 1
     4601                 v-doc-price   = buf_doc-line.price-cli / buf_doc-line.cli-base-rate
     4602                 v-doc-sum     = buf_doc-line.price-cli * buf_doc-line.doc-qnty / buf_doc-line.cli-base-rate
     4603                 v-fact-price  = buf_doc-line.price-cli / buf_doc-line.cli-base-rate
     4604                 v-fact-sum    = buf_doc-line.price-cli * buf_doc-line.fact-qnty / buf_doc-line.cli-base-rate
     4605                 v-sum-i       = buf_doc-line.price-cli * qnty-i / buf_doc-line.cli-base-rate
     4606                 v-sum-n       = buf_doc-line.price-cli * qnty-n / buf_doc-line.cli-base-rate
     4607               .
     4608               run tg83xl-write-line-data in this-procedure (
     4609                     input v-count
     4610                   , input buf_goods.gds-name
     4611                   , input buf_goods.unit-base
     4612                   , input buf_doc-line.doc-qnty
     4613                   , input v-doc-price
     4614                   , input v-doc-sum
     4615                   , input buf_doc-line.fact-qnty
     4616                   , input v-fact-price
     4617                   , input v-fact-sum
     4618                   , input qnty-i
     4619                   , input v-sum-i
     4620                   , input qnty-n
     4621                   , input v-sum-n
     4622               ).
     4623               assign
     4624                 all-doc-qnty  = all-doc-qnty  + buf_doc-line.doc-qnty
     4625                 all-doc-sum   = all-doc-sum   + v-doc-sum
     4626                 all-fact-qnty = all-fact-qnty + buf_doc-line.fact-qnty
     4627                 all-fact-sum  = all-fact-sum  + v-fact-sum
     4628                 all-qnty-i    = all-qnty-i    + qnty-i
     4629                 all-sum-i     = all-sum-i     + buf_doc-line.price-cli * qnty-i / buf_doc-line.cli-base-rate
     4630                 all-qnty-n    = all-qnty-n    + qnty-n
     4631                 all-sum-n     = all-sum-n     + buf_doc-line.price-cli * qnty-n / buf_doc-line.cli-base-rate
     4632               .
     4633     end.
     4634   end procedure.
