     1175   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1176   procedure wthcattr-sprcli :
     1177   define input parameter parparentproc  as widget-handle no-undo.
     1178   define input parameter p-mode  as character no-undo.
     1179   define input-output parameter p-value as character no-undo .
     1180   define output parameter p-setted as logical no-undo .
     1181     DEFINE VARIABLE v-value as character no-undo .
     1182     define variable v-cli-type as character no-undo .
     1183     define variable v-cli-code as integer no-undo .
     1184     define buffer buf_clients   for ub.clients.
     1185     define variable v_rid as character no-undo.
     1186     define variable ref-rec as recid no-undo .
     1187     do
     1188     on error undo, return error
     1189     :
     1190         v-value = p-value.
     1191      if p-value <> '':U then do:
     1192       assign
     1193       v-cli-type = substring(p-value, 1, 3)
     1194       v-cli-code = integer(substring(p-value, 4))
     1195       no-error.
     1196       if error-status:error then do:
     1197         assign
     1198         v-cli-type = '':U
     1199         v-cli-code = 0
     1200         .
     1201       end.
     1202      end.
     1203      FIND FIRST buf_clients NO-LOCK WHERE
     1204               buf_clients.obj-type = v-cli-type AND
     1205               buf_clients.obj-code = v-cli-code  NO-ERROR.
     1206      IF available(buf_clients) then do:
     1207       run ref/cli-all.w (
     1208                   input parparentproc
     1209                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
     1210                  ,input v-cli-type
     1211                  ,input 'все':U
     1212                  ,input 'все':U
     1213                  ,input RECID( buf_clients )
     1214                  ,input ",,,,,,NO"
     1215                  ,input ?
     1216                  ,OUTPUT v_rid ).
     1217     END.
     1218     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     1219       run ref/cli-all.w (
     1220                    input parparentproc
     1221                   ,INPUT "b-sel":U
     1222                  ,input  v-cli-type
     1223                  ,input 'все':U
     1224                  ,input 'текущие':U
     1225                  ,input ?
     1226                  ,input ",,,,,,NO"
     1227                  ,input ?
     1228                  ,OUTPUT v_rid ).
     1229     END.
     1230     else do:
     1231       message
     1232       if p-value = "":U then 'Атрибут не задан!'
     1233       else substitute('Не найден клиент &1',p-value)
     1234       view-as alert-box warning.
     1235     end.
     1236     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1237       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1238       IF ERROR-STATUS:ERROR THEN DO:
     1239           RETURN NO-APPLY.
     1240       END.
     1241       FIND FIRST buf_clients NO-LOCK WHERE
     1242                  RECID( buf_clients ) = ref-rec NO-ERROR.
     1243       IF AVAIL buf_clients THEN DO:
     1244         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     1245       end.
     1246     end.
     1247     if v-value <> p-value then do:
     1248       p-value = v-value.
     1249       p-setted = yes.
     1250     end.
     1251     end.
     1252   end procedure.
     1253     define new global shared variable g#wthcalib as handle no-undo.
     1254   procedure torgconf-read :
     1255   do
     1256   on error undo, return error
     1257   :
     1258       define input parameter p-form-name  as character    no-undo.
     1259       define input parameter p-host-code  as integer      no-undo.
     1260       define input parameter p-obj-type   as character    no-undo.
     1261       define input parameter p-obj-code   as integer      no-undo.
     1262       define variable v-outdate   as character     no-undo.
     1263       define variable v-outares   as character     no-undo.
     1264       define variable v-outsend   as character     no-undo.
     1265       define variable v-outasend  as character     no-undo.
     1266       define variable v-outprops  as character     no-undo.
     1267       define variable v-outnum    as character     no-undo.
     1268       define variable v-outprim   as character     no-undo.
     1269       define variable v-outdisc   as character     no-undo.
     1270       define variable v-outsubs   as character     no-undo.
     1271       define variable v-outrecv   as character     no-undo.
     1272       define variable v-outegrp   as character     no-undo.
     1273       define variable v-outt12    as character     no-undo.
     1274       define variable v-outappr   as character     no-undo.
     1275       define variable v-outrubl   as character     no-undo.
     1276       define variable v-outhold   as character     no-undo.
     1277       define variable v-outobj    as character     no-undo.
     1278       define variable v-outexlst  as character     no-undo.
     1279       define variable v-outprncd  as character     no-undo.
     1280       define variable v-par-type  as character     no-undo.
     1281       define variable v-outogr    as character     no-undo.
     1282       define variable v-outR      as character     no-undo.
     1283       define variable v-outB      as character     no-undo.
     1284       define variable v-outC      as character     no-undo.
     1285       assign
     1286           v-torgconf-outdate  = no
     1287           v-torgconf-outnum   = no
     1288           v-torgconf-outprim  = no
     1289           v-torgconf-outdisc  = no
     1290           v-torgconf-outsubs  = no
     1291           v-torgconf-outrecv  = no
     1292           v-torgconf-outegrp  = no
     1293           v-torgconf-outt12   = no
     1294           v-torgconf-outappr  = no
     1295           v-torgconf-outrubl  = no
     1296           v-torgconf-outhold  = no
     1297           v-torgconf-outobj   = no
     1298           v-torgconf-outexlst = no
     1299           v-torgconf-outexpas = "":U
     1300           v-torgconf-outprncd = yes
     1301           v-torgconf-outares  = no
     1302           v-torgconf-outsend  = no
     1303           v-torgconf-outasend  = no
     1304           v-torgconf-outprops  = no
     1305           v-form-name          = p-form-name
     1306       .
     1307   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1308   empty temp-table thbjattr_thbj-attr.
     1309   run adm/shattri.p (
     1310      input "get":U
     1311     ,input ''
     1312     ,input 0
     1313     ,input 'prt-glob':U
     1314     ,input  ""
     1315     ,output v-value-character
     1316     ,output v-value-date
     1317     ,output v-value-decimal
     1318     ,output v-value-integer
     1319     ,output v-value-logical
     1320     ,output par-type
     1321     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1322     ) no-error .
     1323   for each thbjattr_thbj-attr :
     1324       if thbjattr_thbj-attr.prop-code = 'outprncd':U then v-outprncd =  string(thbjattr_thbj-attr.property-value-logical) .
     1325       if thbjattr_thbj-attr.prop-code = 'outrecv':U  then v-outrecv  =  thbjattr_thbj-attr.property-value-character .
     1326       if thbjattr_thbj-attr.prop-code = 'outprops':U then v-outprops =  thbjattr_thbj-attr.property-value-character .
     1327   end.
     1328   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1329   empty temp-table thbjattr_thbj-attr.
     1330   run adm/shattri.p (
     1331      input "get":U
     1332     ,input p-obj-type
     1333     ,input p-obj-code
     1334     ,input 'prt-obj':U
     1335     ,input  ""
     1336     ,output v-value-character
     1337     ,output v-value-date
     1338     ,output v-value-decimal
     1339     ,output v-value-integer
     1340     ,output v-value-logical
     1341     ,output par-type
     1342     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1343     ) no-error .
     1344   for each thbjattr_thbj-attr :
     1345       if thbjattr_thbj-attr.prop-code = 'outdate':U  then v-outdate  =  thbjattr_thbj-attr.property-value-character .
     1346       if thbjattr_thbj-attr.prop-code = 'outares':U  then v-outares  =  thbjattr_thbj-attr.property-value-character .
     1347       if thbjattr_thbj-attr.prop-code = 'outnum':U   then v-outnum   =  thbjattr_thbj-attr.property-value-character .
     1348       if thbjattr_thbj-attr.prop-code = 'outprim':U  then v-outprim  =  thbjattr_thbj-attr.property-value-character .
     1349       if thbjattr_thbj-attr.prop-code = 'outdisc':U  then v-outdisc  =  thbjattr_thbj-attr.property-value-character .
     1350       if thbjattr_thbj-attr.prop-code = 'outsubs':U  then v-outsubs  =  thbjattr_thbj-attr.property-value-character .
     1351       if thbjattr_thbj-attr.prop-code = 'outegrp':U  then v-outegrp  =  thbjattr_thbj-attr.property-value-character .
     1352       if thbjattr_thbj-attr.prop-code = 'outt12':U   then v-outt12   =  thbjattr_thbj-attr.property-value-character .
     1353       if thbjattr_thbj-attr.prop-code = 'outappr':U  then v-outappr  =  thbjattr_thbj-attr.property-value-character .
     1354       if thbjattr_thbj-attr.prop-code = 'outrubl':U  then v-outrubl  =  thbjattr_thbj-attr.property-value-character .
     1355       if thbjattr_thbj-attr.prop-code = 'outhold':U  then v-outhold  =  thbjattr_thbj-attr.property-value-character .
     1356       if thbjattr_thbj-attr.prop-code = 'outobj':U   then v-outobj   =  thbjattr_thbj-attr.property-value-character .
     1357       if thbjattr_thbj-attr.prop-code = 'outsend':U  then v-outsend  =  thbjattr_thbj-attr.property-value-character .
     1358       if thbjattr_thbj-attr.prop-code = 'outasend':U then v-outasend =  thbjattr_thbj-attr.property-value-character .
