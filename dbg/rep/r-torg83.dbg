     4119             input "columnList":U
     4120           , input "count,Name,EI,docqnty,docprice,docsum,factqnty,factprice,factsum,qntyi,sumi,qntyn,sumn"
     4121       ).
     4122       run tg83xl-write-cell-data in this-procedure (
     4123             input "columnType":U
     4124           , input "S,S,S,D,D,D,D,D,D,D,D,D,D":U
