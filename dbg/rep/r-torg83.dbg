     3916   procedure torgconf-get-reason  :
     3917   define input parameter  p-doc-code       as character        no-undo.
     3918   define input parameter  p-reason-code    as integer          no-undo .
     3919   define input parameter  p-doc-type       as character        no-undo.
     3920       if p-reason-code > 0
     3921       then do:
     3922           define buffer buf_trn-reason for ub.trn-reason.
     3923           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     3924           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     3925       end.
     3926       else do:
     3927           if p-doc-type = 'при':U
     3928           then  do:
     3929               define variable v-attr-type     as character    no-undo.
     3930               define variable v-attr-value    as character    no-undo.
     3931               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     3932               assign v-torgconf-reason = v-attr-value .
     3933               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     3934               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     3935           end.
     3936       end.
     3937   end procedure.
     3938   def var vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3939   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     3940   procedure paramls-clear :
     3941     define buffer buf_temp-param for temp-param .
     3942     do
     3943     on error undo, return error return-value
     3944     :
     3945       for each buf_temp-param
     3946       on error undo, return error
     3947       :
     3948         delete buf_temp-param .
     3949       end.
     3950     end.
     3951   end procedure.
     3952   procedure paramls-write :
     3953     define input  parameter p-code     as character no-undo .
     3954     define input  parameter p-sub-code as character no-undo .
     3955     define input  parameter p-value    as character no-undo .
     3956     define buffer buf_temp-param for temp-param .
     3957     do
     3958     on error undo, return error return-value
     3959     :
     3960       find first buf_temp-param
     3961         where buf_temp-param.param-code     = p-code
     3962           and buf_temp-param.param-sub-code = p-sub-code
     3963         no-error .
     3964       if not available buf_temp-param then do:
     3965         create buf_temp-param .
     3966         assign
     3967           buf_temp-param.param-code     = p-code
     3968           buf_temp-param.param-sub-code = p-sub-code
     3969         .
     3970       end.
     3971       assign
     3972         buf_temp-param.param-value = p-value
     3973       .
     3974     end.
     3975   end procedure.
     3976   procedure paramls-read :
     3977     define input  parameter p-code          as character no-undo .
     3978     define input  parameter p-sub-code      as character no-undo .
     3979     define input  parameter p-default-value as character no-undo .
     3980     define output parameter p-value         as character no-undo .
     3981     define buffer buf_temp-param for temp-param .
     3982     do
     3983     on error undo, return error return-value
     3984     :
     3985       find first buf_temp-param
     3986         where buf_temp-param.param-code     = p-code
     3987           and buf_temp-param.param-sub-code = p-sub-code
     3988         no-error .
     3989       if available buf_temp-param then do:
     3990         assign
     3991           p-value = buf_temp-param.param-value
     3992         .
     3993       end.
     3994       else do:
     3995         assign
     3996           p-value = p-default-value
     3997         .
     3998       end.
     3999     end.
     4000   end procedure.
     4001   procedure paramls-append :
     4002     define input  parameter p-code     as character no-undo .
     4003     define input  parameter p-sub-code as character no-undo .
     4004     define input  parameter p-value    as character no-undo .
     4005     define buffer buf_temp-param for temp-param .
     4006     do
     4007     on error undo, return error return-value
     4008     :
     4009       find first buf_temp-param
     4010            where buf_temp-param.param-code     = p-code
     4011              and buf_temp-param.param-sub-code = p-sub-code
     4012         no-error .
     4013       if not available buf_temp-param then do:
     4014         create buf_temp-param .
     4015         assign
     4016           buf_temp-param.param-code     = p-code
     4017           buf_temp-param.param-sub-code = p-sub-code
     4018           buf_temp-param.param-value    = p-value
     4019         .
     4020       end.
     4021       else do:
     4022           assign
     4023               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     4024           .
     4025       end.
     4026     end.
     4027   end procedure.
