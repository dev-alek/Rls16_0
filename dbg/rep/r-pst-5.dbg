     5150   if Show-sale  then  ( excel-sum(o-spis         [8]) +  CHR(9))   else ("")
     5151                      ( excel-qnty(o-vzvr         [1]) +  CHR(9))
     5152   if Show-cost  then  ( excel-sum(o-vzvr         [2]) +  CHR(9))   else ("")
     5153   if Show-sale  then  ( excel-sum(o-vzvr         [8]) +  CHR(9))   else ("")
     5154                      ( excel-qnty(o-vzvr-post    [1]) +  CHR(9))
     5155   if Show-cost  then  ( excel-sum(o-vzvr-post    [2]) +  CHR(9))   else ("")
     5156   if Show-sale  then  ( excel-sum(o-vzvr-post    [8]) +  CHR(9))   else ("")
     5157                      ( excel-qnty(o-Ostatok-end  [1]) +  CHR(9))
     5158   if Show-cost  then  ( excel-sum(o-Ostatok-end  [2]) +  CHR(9))   else ("")
     5159   if Show-sale  then  (  "" +                             CHR(9))   else ("")
     5160      chr(10).
     5161                 End.
     5162       End case.
     5163                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     5164    END PROCEDURE.
     5165   procedure Print-Footer :
     5166   define input parameter Nx as integer no-undo .
     5167   define input parameter Name as char no-undo .
     5168       if Nx = 1 Then DO:
     5169            run di-qnty  ( "кол-во", 1,"","Итого по : ",trim ( name),"","b1").
     5170            if show-cost then do : run di  (  "учет." , 2, "","","","","b1" ).  end.
     5171            if show-sale then do : run di  (  "док-т.", 8, "","","","","b1" ).  end.
     5172            if not sums-only then
     5173               run u-line.
     5174            run clear-itemb1- in this-procedure .
     5175            End.
     5176    if Nx = 2 Then DO:
     5177            run di-qnty  ( "кол-во", 1,"","","Итого по : " + trim ( name),"","b2").
     5178            if show-cost then do : run di  (  "учет." , 2, "","","","","b2" ).  end.
     5179            if show-sale then do : run di  (  "док-т.", 8, "","","","","b2" ).  end.
     5180            if not sums-only then run u-line.
     5181            run clear-itemb2-.
     5182           end.
     5183    if nx = 3 then do:
     5184            if not sums-only then run u-line.
     5185            run di-qnty  ( "кол-во", 1,"","Итого по пост-ку" , trim ( name),"","p").
     5186            if show-cost then do : run di  (  "учет." , 2, "","","","","p" ).  end.
     5187            if show-sale then do : run di  (  "док-т.", 8, "","","","","p" ).  end.
     5188            if not sums-only then run u-line.
     5189            run clear-itemp-.
     5190             end.
     5191    if nx = 0 then do:
     5192            run di-qnty  ( "кол-во", 1,"","Итого  объект: " , trim ( name),"","o").
     5193            if show-cost then do : run di  (  "учет." , 2, "","","","","o" ).  end.
     5194            if show-sale then do : run di  (  "док-т.", 8, "","","","","o" ).  end.
     5195            if not sums-only then run u-line.
     5196            run clear-itemo-.
     5197             end.
     5198    END PROCEDURE.
     5199   PROCEDURE Clear-item :
     5200   def var kk as int no-undo.
     5201    REPEAT kk = 1 to 9:
     5202    Assign
     5203       prih             [kk]  = 0
     5204       rash             [kk]  = 0
     5205       kassa            [kk]  = 0
     5206       spis             [kk]  = 0
     5207       Inv              [kk]  = 0
     5208       vzvr             [kk]  = 0
     5209       vzvr-post        [kk]  = 0
     5210        .
     5211          End.
     5212    END PROCEDURE.
     5213   PROCEDURE Clear-itemb1- :
     5214   def var kk as int no-undo.
     5215    REPEAT kk = 1 to 9:
     5216    Assign
     5217      b1-prih             [kk]  = 0
     5218      b1-rash             [kk]  = 0
     5219      b1-kassa            [kk]  = 0
     5220      b1-spis              [kk]  = 0
     5221      b1-Inv              [kk]  = 0
     5222      b1-vzvr             [kk]  = 0
     5223      b1-vzvr-post        [kk]  = 0
     5224      b1-ostatok-end      [kk]  = 0
     5225      b1-ostatok-start    [kk]  = 0
     5226      .
     5227          End.
     5228    END PROCEDURE.
