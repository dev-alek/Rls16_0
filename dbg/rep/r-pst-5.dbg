     5266      o-rash             [kk]  = 0
     5267      o-kassa            [kk]  = 0
     5268      o-Spis             [kk]  = 0
     5269      o-Inv              [kk]  = 0
     5270      o-vzvr             [kk]  = 0
     5271      o-vzvr-post        [kk]  = 0
