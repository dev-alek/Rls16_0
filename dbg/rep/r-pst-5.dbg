      960     find first ub.clients no-lock where
      961                ub.clients.obj-type = 'орг':U and
      962                ub.clients.obj-code = v-cntxt-host-code-obj no-error .
      963   if error-status :error then v-cntxt-host-name-obj = ? .
      964      else v-cntxt-host-name-obj = ub.clients.obj-name.
      965   end.
