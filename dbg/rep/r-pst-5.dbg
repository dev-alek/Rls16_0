     4502                                               by temp-t-post-stk-line.fact-order :
     4503                                       if first-of( (temp-t-post-stk-line.artic + temp-t-post-stk-line.prod-type + string(temp-t-post-stk-line.prod-code)) ) then do : run goods-start. end .
     4504                                       if last-of ( (temp-t-post-stk-line.artic + temp-t-post-stk-line.prod-type + string(temp-t-post-stk-line.prod-code)) ) then do : run goods-end.
     4505                                          run display-line .
     4506                                       end.
     4507                                       if last-of( (temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code)) ) then do :
     4508                                          run tmp-create (temp-t-post-stk-line.cli-code,
     4509                                                          temp-t-post-stk-line.cli-type,
     4510                                                          temp-t-post-stk-line.clients-obj-name,
     4511                                                          obj-list.obj-code,
     4512                                                          obj-list.obj-type ) .
     4513                                          run tmp-clear.
     4514                                       end.
     4515             end.
     4516          end.
     4517          for each tmp-cli-gds no-lock
     4518              break
     4519              by tmp-cli-gds.name
     4520              by (tmp-cli-gds.cli-type + string(tmp-cli-gds.cli-code)) :
     4521              if first-of(tmp-cli-gds.cli-type + string(tmp-cli-gds.cli-code)) then run tmp-clear.
     4522               run tmp-assign.
     4523              if last-of((tmp-cli-gds.cli-type + string(tmp-cli-gds.cli-code))) then do:
     4524                  run print-footer ( 3 ,tmp-cli-gds.name).
     4525              end.
     4526          end.
     4527   End procedure.
     4528   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4529   procedure Goods-start :
     4530    def buffer  b-post-stk-line for ub.stk-supp-line .
     4531    define variable p-fact-order as decimal no-undo .
     4532     p-fact-order = fact-order-1 .
     4533     Find last temp2-post-stk-line  no-lock where
     4534                                       temp2-post-stk-line.artic       =  temp-t-post-stk-line.artic        and
     4535                                       temp2-post-stk-line.prod-type   =  temp-t-post-stk-line.prod-type    and
     4536                                       temp2-post-stk-line.prod-code   =  temp-t-post-stk-line.prod-code    and
     4537                                       temp2-post-stk-line.cli-type    =  temp-t-post-stk-line.cli-type     and
     4538                                       temp2-post-stk-line.cli-code    =  temp-t-post-stk-line.cli-code     and
     4539                                       temp2-post-stk-line.obj-type    =  temp-t-post-stk-line.obj-type     and
     4540                                       temp2-post-stk-line.obj-code    =  temp-t-post-stk-line.obj-code     and
     4541                                       temp2-post-stk-line.fact-order <=  fact-order-1               and
     4542                                       temp2-post-stk-line.sum-type    =  'cost':U                and
     4543                                       temp2-post-stk-line.cat-id      =  '##':U
     4544                                       no-error .
     4545     Find Last a-post-stk-line  where
     4546         a-post-stk-line.fact-order =   ( if avail temp2-post-stk-line then temp2-post-stk-line.fact-order else 0)  and
     4547         a-post-stk-line.cat-id     =  t#cat-id      and
     4548         a-post-stk-line.Sum-type   =  t#sum-type    and
     4549         a-post-stk-line.artic      =  temp-t-post-stk-line.artic       and
     4550         a-post-stk-line.prod-type  =  temp-t-post-stk-line.prod-type   and
     4551         a-post-stk-line.prod-code  =  temp-t-post-stk-line.prod-code   and
     4552         a-post-stk-line.cli-type   =  temp-t-post-stk-line.cli-type  and
     4553         a-post-stk-line.cli-code   =  temp-t-post-stk-line.cli-code  and
     4554         a-post-stk-line.obj-type   =  temp-t-post-stk-line.obj-type  and
     4555         a-post-stk-line.obj-code   =  temp-t-post-stk-line.obj-code
     4556         no-lock no-error .
     4557         if avail  a-post-stk-line Then
     4558         Assign
     4559           p-fact-order     = a-post-stk-line.fact-order
     4560           Ostatok-start[1] = a-post-stk-line.fact-qnty
     4561           Ostatok-start[2] = IF tPrintRubl THEN  a-post-stk-line.sum-rubl
     4562                                            else a-post-stk-line.sum-base.
     4563           Else
     4564         Assign
     4565           Ostatok-start[1] = 0
     4566           Ostatok-start[2] = 0
     4567         Ostatok-start[8] = 0.
     4568        IF Show-Sale  then do:
     4569                For each b-post-stk-line where
     4570                                            b-post-stk-line.fact-order = p-fact-order and
     4571                                            b-post-stk-line.cat-id     = t#cat-id   and
     4572                                            b-post-stk-line.Sum-type   begins 'sadt':U         and
     4573                                            b-post-stk-line.artic      = temp-t-post-stk-line.artic      and
     4574                                            b-post-stk-line.prod-type  = temp-t-post-stk-line.prod-type  and
     4575                                            b-post-stk-line.prod-code  = temp-t-post-stk-line.prod-code  and
     4576                                            b-post-stk-line.cli-type   = temp-t-post-stk-line.cli-type   and
     4577                                            b-post-stk-line.cli-code   = temp-t-post-stk-line.cli-code   and
     4578                                            b-post-stk-line.obj-type   = temp-t-post-stk-line.obj-type   and
     4579                                            b-post-stk-line.obj-code   = temp-t-post-stk-line.obj-code
     4580                                            no-lock :
     4581                         IF  tPrintRubl  THEN
     4582                              ASSIGN  Ostatok-start[8] = Ostatok-start[8]  + b-post-stk-line.sum-rubl .
     4583                           ELSE
     4584                              ASSIGN  Ostatok-start[8] = Ostatok-start[8]  +  b-post-stk-line.sum-base.
     4585                 End.
     4586         End.
     4587    END PROCEDURE.
     4588   procedure Goods-end :
     4589    def buffer  b-post-stk-line for ub.stk-supp-line .
     4590    define variable p-fact-order as decimal no-undo .
     4591     p-fact-order = fact-order-2 .
     4592     Find last temp2-post-stk-line  no-lock where
     4593                                       temp2-post-stk-line.artic       =  temp-t-post-stk-line.artic        and
     4594                                       temp2-post-stk-line.prod-type   =  temp-t-post-stk-line.prod-type    and
     4595                                       temp2-post-stk-line.prod-code   =  temp-t-post-stk-line.prod-code    and
     4596                                       temp2-post-stk-line.cli-type    =  temp-t-post-stk-line.cli-type     and
     4597                                       temp2-post-stk-line.cli-code    =  temp-t-post-stk-line.cli-code     and
     4598                                       temp2-post-stk-line.obj-type    =  temp-t-post-stk-line.obj-type     and
     4599                                       temp2-post-stk-line.obj-code    =  temp-t-post-stk-line.obj-code     and
     4600                                       temp2-post-stk-line.fact-order <=  fact-order-2               and
     4601                                       temp2-post-stk-line.sum-type    =  'cost':U                and
     4602                                       temp2-post-stk-line.cat-id      =  '##':U
     4603                                       no-error .
     4604     Find Last a-post-stk-line  where
     4605         a-post-stk-line.fact-order =   ( if avail temp2-post-stk-line then temp2-post-stk-line.fact-order else 0)  and
     4606         a-post-stk-line.cat-id     =  t#cat-id       and
     4607         a-post-stk-line.Sum-type   =  t#sum-type     and
     4608         a-post-stk-line.artic      =  temp-t-post-stk-line.artic       and
     4609         a-post-stk-line.prod-type  =  temp-t-post-stk-line.prod-type   and
     4610         a-post-stk-line.prod-code  =  temp-t-post-stk-line.prod-code   and
     4611         a-post-stk-line.cli-type   =  temp-t-post-stk-line.cli-type    and
     4612         a-post-stk-line.cli-code   =  temp-t-post-stk-line.cli-code    and
     4613         a-post-stk-line.obj-type   =  temp-t-post-stk-line.obj-type    and
     4614         a-post-stk-line.obj-code   =  temp-t-post-stk-line.obj-code
     4615         no-lock no-error .
     4616     if avail  a-post-stk-line Then do :
     4617         Assign
     4618           p-fact-order     = a-post-stk-line.fact-order
     4619           ostatok-end[1] = a-post-stk-line.fact-qnty
     4620           ostatok-end[2] = if tprintrubl then  a-post-stk-line.sum-rubl
     4621                                          else  a-post-stk-line.sum-base.
     4622           end.
     4623           Else
     4624         Assign
     4625           Ostatok-end[1] = 0
     4626           Ostatok-end[2] = 0.
     4627           Ostatok-end[8] = 0.
     4628        IF Show-Sale  then do:
     4629                For each b-post-stk-line where
     4630                                            b-post-stk-line.fact-order = p-fact-order and
     4631                                            b-post-stk-line.cat-id     = t#cat-id   and
     4632                                            b-post-stk-line.Sum-type    begins 'sadt':U         and                                         b-post-stk-line.artic      = post-stk-line.artic      and
     4633                                            b-post-stk-line.prod-type  = temp-t-post-stk-line.prod-type  and
     4634                                            b-post-stk-line.prod-code  = temp-t-post-stk-line.prod-code  and
     4635                                            b-post-stk-line.cli-type   = temp-t-post-stk-line.cli-type   and
     4636                                            b-post-stk-line.cli-code   = temp-t-post-stk-line.cli-code   and
     4637                                            b-post-stk-line.obj-type   = temp-t-post-stk-line.obj-type   and
     4638                                            b-post-stk-line.obj-code   = temp-t-post-stk-line.obj-code
     4639                                            no-lock :
     4640                         IF  tPrintRubl  THEN
     4641                              ASSIGN  Ostatok-end[8] = Ostatok-end[8]  + b-post-stk-line.sum-rubl .
     4642                           ELSE
     4643                              ASSIGN  Ostatok-end[8] = Ostatok-end[8]  +  b-post-stk-line.sum-base.
     4644                 End.
     4645         End.
     4646   END PROCEDURE.
     4647   PROCEDURE display-line :
     4648     i = i + 1.
     4649   If Integer(10) = 0 Then Temp1  = 100  .
     4650                         Else Temp1 = Integer(10) .
     4651        IF ( i modulo Temp1 = 0 ) AND ( i >= Temp1 ) then
     4652            RUN waitfram-show( "Обработано строк : " + string( i )) .
     4653     run clear-item.
     4654       assign
     4655             gds-zap-gds-name   = temp-t-post-stk-line.gds-name
     4656             gds-zap-unit-base  = temp-t-post-stk-line.unit-base
     4657             gds-zap-prt-root   = temp-t-post-stk-line.prt-root
     4658             gds-zap-prod-type  = temp-t-post-stk-line.prod-type
     4659             gds-zap-prod-code  = temp-t-post-stk-line.prod-code
     4660             gds-zap-artic      = temp-t-post-stk-line.artic
     4661             gds-zap-grp-name   = temp-t-post-stk-line.Goods-grp-name
     4662             gds-zap-b-code     = temp-t-post-stk-line.gds-code
     4663             gds-zap-type       = temp-t-post-stk-line.gds-type
     4664             pos-cli-type       = temp-t-post-stk-line.Cli-type
     4665             pos-cli-code       = temp-t-post-stk-line.Cli-code
     4666             pos-cli-grp-name   = temp-t-post-stk-line.Clients-grp-name.
     4667       run ob-line  (
     4668                temp-t-post-stk-line.obj-code    ,
     4669                temp-t-post-stk-line.obj-type    ,
     4670                temp-t-post-stk-line.cli-code    ,
     4671                temp-t-post-stk-line.cli-type    ,
     4672                temp-t-post-stk-line.artic       ,
     4673                temp-t-post-stk-line.prod-code   ,
     4674                temp-t-post-stk-line.prod-type   ,
     4675                Fact-order-1     ,
     4676                Fact-order-2     ,
     4677                t#sum-type       ,
     4678                t#cat-id         ,
     4679                ""               ,
     4680                yes) .
     4681      if Show-Sale Then  run ob-line  (
     4682                temp-t-post-stk-line.obj-code    ,
     4683                temp-t-post-stk-line.obj-type    ,
     4684                temp-t-post-stk-line.cli-code    ,
     4685                temp-t-post-stk-line.cli-type    ,
     4686                temp-t-post-stk-line.artic       ,
     4687                temp-t-post-stk-line.prod-code   ,
     4688                temp-t-post-stk-line.prod-type   ,
     4689                Fact-order-1   ,
     4690                Fact-order-2   ,
     4691                'sale':U    ,
     4692                '##':U ,
     4693                ""             ,
     4694                yes) .
     4695            run calc-sub-itog ( 0).
     4696                if Show-Sale Then
     4697                   run calc-sub-itog ( 6).
     4698          IF  NOT  ( ( ostatok-start[1] = 0  AND
     4699                                          Prih         [1] = 0  AND
     4700                                          RAsh         [1] = 0  AND
     4701                                          KAssa        [1] = 0  AND
     4702                                          Inv          [1] = 0  AND
     4703                                          vzvr         [1] = 0  AND
     4704                                          vzvr-post    [1] = 0  AND
     4705                                          Ostatok-end  [1] = 0)) then DO:
     4706            IF NOT Sums-Only then DO:
     4707               run display-str1 in this-procedure .
     4708               run clear-item in this-procedure .
     4709            End.
     4710          End.
     4711     END PROCEDURE.
     4712   PROCEDURE display-str1  :
     4713   if   Show-Negativ = true or not  (
     4714       Prih         [1] = 0  AND
     4715       RAsh         [1] = 0  AND
     4716       KAssa        [1] = 0  AND
     4717       Inv          [1] = 0  AND
     4718       vzvr         [1] = 0  AND
     4719       spis         [1] = 0  AND
     4720       vzvr-post    [1] = 0
     4721       ) then DO:
     4722       if not  (  not Show-zero-ost   and
     4723               (  ostatok-end[1] = 0  and
     4724                ostatok-end[2] = 0  and
     4725                ostatok-end[8] = 0 ))  then DO:
     4726            run di-qnty  ( "кол-во", 1, gds-zap-b-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     4727            if show-cost then do : run di  (  "учет." , 2, "","","","","" ).  end.
     4728            if show-sale then do : run di  (  "док-т.", 8, "","","","","" ).  end.
     4729          end.
     4730   end.
     4731   run clear-item in this-procedure .
     4732   END PROCEDURE.
     4733   PROCEDURE Di :
     4734   def input parameter p1 as char no-undo.
     4735   def input parameter p2 as int no-undo.
     4736   def input parameter p3 as char no-undo.
     4737   def input parameter p4 as char no-undo.
     4738   def input parameter p5 as char no-undo.
     4739   def input parameter p6 as char no-undo.
     4740   def input parameter p7 as char no-undo.
     4741    CASE CAPS ( p7) :
     4742      WHEN "B1":U  Then do:
     4743                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym11 sym12 sym13
     4744                   p3 @ gds-zap-b-code
     4745                   p4 @ gds-zap-artic
     4746                   p5 @ gds-zap-gds-name
     4747                   p6 @ gds-zap-unit-base
     4748                   p1 @ gds-type
     4749                   b1-ostatok-start[p2] when ( NOT( Show-SAle = true and p2 = 8 )) @  F-ostatok-start
     4750                   b1-Prih         [p2]  @  F-Prih
     4751                   b1-RAsh         [p2]  @  F-RAsh
     4752                   b1-KAssa        [p2]  @  F-KAssa
     4753                   b1-Inv          [p2]  @  F-Inv
     4754                   b1-spis         [p2]  @  F-spis
     4755                   b1-vzvr         [p2]  @  F-vzvr
     4756                   b1-vzvr-post    [p2]  @  F-vzvr-post
     4757                   b1-Ostatok-end  [p2] when ( NOT( Show-SAle = true and p2 = 8 ))  @  F-Ostatok-end
     4758                  with FRAME ZAPAS .
     4759     end.
     4760      WHEN "B2":U  Then do:
     4761                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym11 sym12 sym13
     4762                   p3 @ gds-zap-b-code
     4763                   p4 @ gds-zap-artic
     4764                   p5 @ gds-zap-gds-name
     4765                   p6 @ gds-zap-unit-base
     4766                   p1 @ gds-type
     4767                   b2-ostatok-start[p2] when ( NOT( Show-SAle = true and p2 = 8 )) @  F-ostatok-start
     4768                   b2-Prih         [p2]  @  F-Prih
     4769                   b2-RAsh         [p2]  @  F-RAsh
     4770                   b2-KAssa        [p2]  @  F-KAssa
     4771                   b2-Inv          [p2]  @  F-Inv
     4772                   b2-spis         [p2]  @  F-spis
     4773                   b2-vzvr         [p2]  @  F-vzvr
     4774                   b2-vzvr-post    [p2]  @  F-vzvr-post
     4775                   b2-Ostatok-end  [p2] when ( NOT( Show-SAle = true and p2 = 8 ))  @  F-Ostatok-end
     4776                  with FRAME ZAPAS .
     4777     end.
     4778      WHEN "BI":U Then do:
     4779                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym11 sym12 sym13
     4780                   p3 @ gds-zap-b-code
     4781                   p4 @ gds-zap-artic
     4782                   p5 @ gds-zap-gds-name
     4783                   p6 @ gds-zap-unit-base
     4784                   p1 @ gds-type
     4785                   bi-ostatok-start[p2] when ( NOT( Show-SAle = true and p2 = 8 )) @  F-ostatok-start
     4786                   bi-Prih         [p2]  @  F-Prih
     4787                   bi-RAsh         [p2]  @  F-RAsh
     4788                   bi-KAssa        [p2]  @  F-KAssa
     4789                   bi-Inv          [p2]  @  F-Inv
     4790                   bi-spis         [p2]  @  F-spis
     4791                   bi-vzvr         [p2]  @  F-vzvr
     4792                   bi-vzvr-post    [p2]  @  F-vzvr-post
     4793                   bi-Ostatok-end  [p2] when ( NOT( Show-SAle = true and p2 = 8 ))  @  F-Ostatok-end
     4794                  with FRAME ZAPAS .
     4795     end.
     4796      WHEN "P":U Then do:
     4797                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym11 sym12 sym13
     4798                   p3 @ gds-zap-b-code
     4799                   p4 @ gds-zap-artic
     4800                   p5 @ gds-zap-gds-name
     4801                   p6 @ gds-zap-unit-base
     4802                   p1 @ gds-type
     4803                   p-ostatok-start[p2] when ( NOT( Show-SAle = true and p2 = 8 )) @  F-ostatok-start
     4804                   p-Prih         [p2]  @  F-Prih
     4805                   p-RAsh         [p2]  @  F-RAsh
     4806                   p-KAssa        [p2]  @  F-KAssa
     4807                   p-Inv          [p2]  @  F-Inv
     4808                   p-spis         [p2]  @  F-spis
     4809                   p-vzvr         [p2]  @  F-vzvr
     4810                   p-vzvr-post    [p2]  @  F-vzvr-post
     4811                   p-Ostatok-end  [p2] when ( NOT( Show-SAle = true and p2 = 8 ))  @  F-Ostatok-end
     4812                  with FRAME ZAPAS .
     4813     end.
     4814      WHEN "O"  Then     DO :
     4815                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym11 sym12 sym13
     4816                   p3 @ gds-zap-b-code
     4817                   p4 @ gds-zap-artic
     4818                   p5 @ gds-zap-gds-name
     4819                   p6 @ gds-zap-unit-base
     4820                   p1 @ gds-type
     4821                   o-ostatok-start[p2] when ( NOT( Show-SAle = true and p2 = 8 )) @  F-ostatok-start
     4822                   o-Prih         [p2]  @  F-Prih
     4823                   o-RAsh         [p2]  @  F-RAsh
     4824                   o-KAssa        [p2]  @  F-KAssa
     4825                   o-Inv          [p2]  @  F-Inv
     4826                   o-spis         [p2]  @  F-spis
     4827                   o-vzvr         [p2]  @  F-vzvr
     4828                   o-vzvr-post    [p2]  @  F-vzvr-post
     4829                   o-Ostatok-end  [p2] when ( NOT( Show-SAle = true and p2 = 8 ))  @  F-Ostatok-end
     4830                  with FRAME ZAPAS .
     4831        End.
     4832      WHEN ""  Then DO:
     4833                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym11 sym12 sym13
     4834                   p3 @ gds-zap-b-code
     4835                   p4 @ gds-zap-artic
     4836                   p5 @ gds-zap-gds-name
     4837                   p6 @ gds-zap-unit-base
     4838                   p1 @ gds-type
     4839                   ostatok-start[p2] when ( NOT( Show-SAle = true and p2 = 8 )) @  F-ostatok-start
     4840                   Prih         [p2]  @  F-Prih
     4841                   RAsh         [p2]  @  F-RAsh
     4842                   KAssa        [p2]  @  F-KAssa
     4843                   Inv          [p2]  @  F-Inv
     4844                   spis         [p2]  @  F-spis
     4845                   vzvr         [p2]  @  F-vzvr
     4846                   vzvr-post    [p2]  @  F-vzvr-post
     4847                   Ostatok-end  [p2] when ( NOT( Show-SAle = true and p2 = 8 ))  @  F-Ostatok-end
     4848                  with FRAME ZAPAS .
     4849        End.
     4850      End case.
     4851        DOWN stream   OutStream 1 with FRAME ZAPAS.
     4852    END PROCEDURE.
     4853   PROCEDURE Di-qnty :
     4854   def input parameter p1 as char no-undo.
