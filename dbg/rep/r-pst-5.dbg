     4178                         By ((temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code)))
     4179                         By temp-t-post-stk-line.gds-name
     4180                         By ((temp-t-post-stk-line.artic + temp-t-post-stk-line.prod-type + string(temp-t-post-stk-line.prod-code)))
     4181                         By Temp-t-post-stk-line.Fact-order
     4182                        :
     4183                  if first-of(  temp-t-post-stk-line.goods-grp-name  )  Then DO : run print-header (1, temp-t-post-stk-line.goods-grp-name ). end.
     4184                  if first-of( (temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code))  )  Then DO : run print-header (2, (temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code)) ). end.
     4185                 if NOT(Sums-Only = true ) then DO:
     4186                     if first-of( (temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code)) ) Then DO : run print-header ( 3,temp-t-post-stk-line.clients-obj-name). end.
     4187                 End.
     4188                                       if first-of( (temp-t-post-stk-line.artic + temp-t-post-stk-line.prod-type + string(temp-t-post-stk-line.prod-code)) ) then do : run goods-start. end .
     4189                                       if last-of ( (temp-t-post-stk-line.artic + temp-t-post-stk-line.prod-type + string(temp-t-post-stk-line.prod-code)) ) then do : run goods-end.
     4190                                            run display-line .
     4191                                       End.
     4192                     if last-of( (temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code)) ) Then DO : run print-footer ( 3 , temp-t-post-stk-line.clients-obj-name). end.
     4193                 if last-of( (temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code)) )  Then DO : run print-footer ( 2 ,(temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code))). end.
     4194                 if last-of( temp-t-post-stk-line.goods-grp-name )  then do : run print-footer ( 1, temp-t-post-stk-line.goods-grp-name ). end.
     4195             End.
     4196            if t#kol-rec-obj > 1 THEN run print-footer ( 0, '(' + obj-list.obj-type + ' ' + trim(string(obj-list.obj-code)) + ') ' + obj-list.obj-name).
     4197           .
     4198          End.
     4199     .
     4200     End.
     4201   End case.
     4202   End procedure.
     4203   procedure Print-Header :
     4204   define input parameter N as integer no-undo .
     4205   define input parameter Name as char no-undo .
     4206   PUT stream  OutStream  UNFORMATTED trim(Name) AT ((N - 1) * 10 ) format "x(100)" skip.
     4207   if Make-Excel then  put   stream ForExcel unformatted fill(" " + CHR(9), N - 1) trim(Name) skip.
     4208   END PROCEDURE.
