     5234      b2-rash             [kk]  = 0
     5235      b2-kassa            [kk]  = 0
     5236      b2-spis             [kk]  = 0
     5237      b2-Inv              [kk]  = 0
     5238      b2-vzvr             [kk]  = 0
     5239      b2-vzvr-post        [kk]  = 0
     5240      b2-ostatok-end      [kk]  = 0
     5241      b2-ostatok-start    [kk]  = 0
     5242      .
     5243      End.
     5244    END PROCEDURE.
     5245   PROCEDURE Clear-itemp- :
     5246   def var kk as int no-undo.
     5247    REPEAT kk = 1 to 9:
     5248    Assign
     5249      p-prih             [kk]  = 0
     5250      p-rash             [kk]  = 0
     5251      p-kassa            [kk]  = 0
     5252      p-spis             [kk]  = 0
     5253      p-Inv              [kk]  = 0
     5254      p-vzvr             [kk]  = 0
     5255      p-vzvr-post        [kk]  = 0
     5256      p-ostatok-end      [kk]  = 0
     5257      p-ostatok-start    [kk]  = 0
