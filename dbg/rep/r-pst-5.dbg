     5277   PROCEDURE ob-line :
     5278   def input  parameter x-store-code     like ub.clients.obj-code          no-undo.
     5279   def input  parameter x-store-type     like ub.clients.obj-type          no-undo.
     5280   def input  parameter x-cli-code       like ub.clients.obj-code          no-undo.
     5281   def input  parameter x-cli-type       like ub.clients.obj-type          no-undo.
     5282   def INPUT  parameter x-artic          like post-ot-line.artic        no-undo.
     5283   def INPUT  parameter x-prod-code      like post-ot-line.prod-code    no-undo.
     5284   def INPUT  parameter x-prod-type      like post-ot-line.prod-type    no-undo.
     5285   def INPUT  parameter x-Fact-order-1   like post-ot-line.Fact-order   no-undo.
     5286   def INPUT  parameter x-Fact-order-2   like post-ot-line.Fact-order   no-undo.
     5287   def input  parameter x-sum-type       like post-ot-line.sum-type     no-undo.
     5288   def input  parameter x-cat-id         like post-ot-line.cat-id       no-undo.
     5289   def input  parameter x-ext-doc-type   like post-ot-line.ext-doc-type no-undo.
     5290   def input  parameter xTog-obj           as log no-undo .
     5291   def var  tt#          as   int                 no-undo .
     5292    if  ( x-sum-type = 'cost':U ) then tt# = 0.
     5293    if  ( x-sum-type = 'sale':U ) then tt# = 6.
     5294        FOR each post-ot-line where
     5295                 post-ot-line.artic        = x-artic
     5296           AND   post-ot-line.fact-order  <= x-fact-order-2
     5297           AND   post-ot-line.fact-order  >= x-fact-order-1
     5298           AND   post-ot-line.obj-code     = x-store-code
     5299           AND   post-ot-line.obj-type     = x-store-type
     5300           AND   post-ot-line.prod-code    = x-prod-code
     5301           AND   post-ot-line.prod-type    = x-prod-type
     5302           AND   post-ot-line.cli-code     = x-cli-code
     5303           AND   post-ot-line.cli-type     = x-cli-type
     5304           AND   post-ot-line.sum-type     = x-sum-type
     5305           AND   post-ot-line.cat-id       = x-cat-id
     5306                  no-lock :
     5307           CASE post-ot-line.ext-doc-type:
     5308                WHEN        'iv':U      OR
     5309                WHEN        'rv':U  OR
     5310                WHEN        'im':U     THEN     DO:
     5311              if t-in then
     5312              ASSIGN prih[1 + tt#]   = prih[1 + tt#]   +  post-ot-line.fact-qnty
     5313                     prih[2 + tt#]   = prih[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     5314                     prih[3 + tt#]   = prih[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base  .
     5315                    End.
     5316                WHEN        'ie':U   THEN     DO:
     5317              ASSIGN prih[1 + tt#]   = prih[1 + tt#]   +  post-ot-line.fact-qnty
     5318                     prih[2 + tt#]   = prih[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     5319                     prih[3 + tt#]   = prih[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base  .
     5320                    End.
     5321                WHEN        're':U  THEN DO:
     5322              ASSIGN vzvr[1 + tt#]   = vzvr[1 + tt#]   +  post-ot-line.fact-qnty
     5323                     vzvr[2 + tt#]   = vzvr[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     5324                     vzvr[3 + tt#]   = vzvr[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base  .
     5325                    End.
     5326                WHEN       'ep':U  THEN DO:
     5327              ASSIGN vzvr-post[1 + tt#]   = vzvr-post[1 + tt#]   +  post-ot-line.fact-qnty
     5328                     vzvr-post[2 + tt#]   = vzvr-post[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     5329                     vzvr-post[3 + tt#]   = vzvr-post[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base  .
     5330                    End.
     5331                WHEN       'ee':U          THEN  DO:
     5332                ASSIGN rash[1 + tt#]   = rash[1 + tt#]   +  post-ot-line.fact-qnty
     5333                     rash[2 + tt#]   = rash[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     5334                     rash[3 + tt#]   = rash[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base  .
     5335                    End.
     5336                WHEN       'ev':U       OR
     5337                WHEN       'em':U        THEN  DO:
     5338              if t-in then
     5339              ASSIGN rash[1 + tt#]   = rash[1 + tt#]   +  post-ot-line.fact-qnty
     5340                     rash[2 + tt#]   = rash[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     5341                     rash[3 + tt#]   = rash[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base  .
     5342                    End.
     5343                WHEN       'es':U  OR
     5344                WHEN       'rs':U THEN  DO:
     5345              ASSIGN kassa[1 + tt#]   = kassa[1 + tt#]   +  post-ot-line.fact-qnty
     5346                     kassa[2 + tt#]   = kassa[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     5347                     kassa[3 + tt#]   = kassa[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base .
     5348                    End.
     5349                WHEN       'vt':U      or
     5350                when       'vp':U   or
     5351                when       'ap':U   or
     5352                when       'mp':U or
     5353                when       'pc':U
     5354        THEN  DO:
     5355              ASSIGN INV[1 + tt#]   = INV[1 + tt#]   +  post-ot-line.fact-qnty
     5356                     Inv[2 + tt#]   = Inv[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     5357                     Inv[3 + tt#]   = Inv[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base  .
     5358                    End.
     5359                WHEN       'we':U       THEN  DO:
     5360              ASSIGN spis[1 + tt#]   = spis[1 + tt#]   +  post-ot-line.fact-qnty
     5361                     spis[2 + tt#]   = spis[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     5362                     spis[3 + tt#]   = spis[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base  .
     5363                    End.
     5364                WHEN       'wm':U       THEN  DO:
     5365              if t-in then
     5366              ASSIGN spis[1 + tt#]   = spis[1 + tt#]   +  post-ot-line.fact-qnty
     5367                     spis[2 + tt#]   = spis[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     5368                     spis[3 + tt#]   = spis[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base  .
     5369                    End.
     5370             End CASE.
     5371      End.
     5372   END PROCEDURE.
     5373   PROCEDURE Calc-Sub-itog :
     5374   def input parameter tt as int no-undo.
     5375   def var b as int no-undo.
     5376   repeat b = 1 to 3 :
     5377     Assign
     5378     B1-Prih[b + TT]    = B1-Prih[b + TT]    +  Prih[b + TT]
     5379     B2-Prih[b + TT]    = B2-Prih[b + TT]    +  Prih[b + TT]
     5380     Bi-Prih[b + TT]    = Bi-Prih[b + TT]    +  Prih[b + TT]
     5381     p-Prih[b + TT]     = p-Prih[b + TT]    +  Prih[b + TT]
     5382     o-Prih[b + TT]     = o-Prih[b + TT]    +  Prih[b + TT]
     5383     B1-RAsh[b + TT]    = B1-RAsh[b + TT]    +  RAsh[b + TT]
     5384     B2-RAsh[b + TT]    = B2-RAsh[b + TT]    +  RAsh[b + TT]
     5385     Bi-RAsh[b + TT]    = Bi-RAsh[b + TT]    +  RAsh[b + TT]
     5386     p-RAsh[b + TT]    = p-RAsh[b + TT]    +  RAsh[b + TT]
     5387     o-RAsh[b + TT]    = o-RAsh[b + TT]    +  RAsh[b + TT]
     5388     B1-KAssa[b + TT]    = B1-KAssa[b + TT]    +  KAssa[b + TT]
     5389     B2-kassa[b + TT]    = B2-kassa[b + TT]    +  kassa[b + TT]
     5390     Bi-kassa[b + TT]     = Bi-kassa[b + TT]     +  kassa[b + TT]
     5391     p-kassa[b + TT]      = p-kassa[b + TT]      +  kassa[b + TT]
     5392     o-kassa[b + TT]      = o-kassa[b + TT]      +  kassa[b + TT]
     5393     B1-Inv[b + TT]    = B1-Inv[b + TT]    +  Inv[b + TT]
     5394     B2-Inv[b + TT]    = B2-Inv[b + TT]    +  Inv[b + TT]
     5395     Bi-Inv[b + TT]    = Bi-Inv[b + TT]    +  Inv[b + TT]
     5396     p-Inv[b + TT]    = p-Inv[b + TT]    +  Inv[b + TT]
     5397     o-Inv[b + TT]    = o-Inv[b + TT]    +  Inv[b + TT]
     5398     B1-spis[b + TT]    = B1-spis[b + TT]    +  spis[b + TT]
     5399     B2-spis[b + TT]    = B2-spis[b + TT]    +  spis[b + TT]
     5400     Bi-spis[b + TT]    = Bi-spis[b + TT]    +  spis[b + TT]
     5401      p-spis[b + TT]    =  p-spis[b + TT]    +  spis[b + TT]
     5402      o-spis[b + TT]    =  o-spis[b + TT]    +  spis[b + TT]
     5403     B1-vzvr[b + TT]    = B1-vzvr[b + TT]    + vzvr[b + TT]
     5404     B2-vzvr[b + TT]    = B2-vzvr[b + TT]    + vzvr[b + TT]
     5405     Bi-vzvr[b + TT]    = Bi-vzvr[b + TT]    + vzvr[b + TT]
     5406     p-vzvr[b + TT]    = p-vzvr[b + TT]    + vzvr[b + TT]
     5407     o-vzvr[b + TT]    = o-vzvr[b + TT]    + vzvr[b + TT]
     5408     B1-vzvr-post[b + TT]    = B1-vzvr-post[b + TT]    + vzvr-post[b + TT]
     5409     B2-vzvr-post[b + TT]    = B2-vzvr-post[b + TT]    + vzvr-post[b + TT]
     5410     Bi-vzvr-post[b + TT]    = Bi-vzvr-post[b + TT]    + vzvr-post[b + TT]
     5411     p-vzvr-post[b + TT]    = p-vzvr-post[b + TT]    + vzvr-post[b + TT]
     5412     o-vzvr-post[b + TT]    = o-vzvr-post[b + TT]    + vzvr-post[b + TT]
     5413     B1-ostatok-start[b + TT]    = B1-ostatok-start[b + TT]    + ostatok-start[b + TT]
     5414     B2-ostatok-start[b + TT]    = B2-ostatok-start[b + TT]    + ostatok-start[b + TT]
     5415     Bi-ostatok-start[b + TT]    = Bi-ostatok-start[b + TT]    + ostatok-start[b + TT]
     5416     p-ostatok-start[b + TT]    = p-ostatok-start[b + TT]    + ostatok-start[b + TT]
     5417     o-ostatok-start[b + TT]    = o-ostatok-start[b + TT]    + ostatok-start[b + TT]
     5418     B1-ostatok-end[b + TT]    = B1-ostatok-end[b + TT]    + ostatok-end[b + TT]
     5419     B2-ostatok-end[b + TT]    = B2-ostatok-end[b + TT]    + ostatok-end[b + TT]
     5420     Bi-ostatok-end[b + TT]    = Bi-ostatok-end[b + TT]    + ostatok-end[b + TT]
     5421     p-ostatok-end[b + TT]    = p-ostatok-end[b + TT]    + ostatok-end[b + TT]
     5422     o-ostatok-end[b + TT]    = o-ostatok-end[b + TT]    + ostatok-end[b + TT]
     5423   .
     5424   End.
     5425   END PROCEDURE.
     5426   PROCEDURE U-LINE :
     5427   UNDERLINE stream OutStream  sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym13
     5428           gds-zap-b-code
     5429           gds-zap-artic
     5430           gds-zap-gds-name
     5431           gds-zap-unit-base
     5432           gds-type
     5433           F-ostatok-start
     5434           F-Prih
     5435           F-Rash
     5436           F-KAssa
     5437           F-Inv
     5438           F-spis
     5439           F-vzvr
     5440           F-vzvr-post
     5441           F-ostatok-end
     5442           with FRAME ZAPAS .
     5443           DOWN stream   OutStream 1 with FRAME ZAPAS.
     5444           END PROCEDURE.
     5445   Procedure Tmp-create :
     5446   define input parameter p1   like ub.clients.obj-code  no-undo .
     5447   define input parameter p2   like ub.clients.obj-type  no-undo .
     5448   define input parameter Name like ub.clients.obj-name  no-undo .
     5449   define input parameter p3   like obj-list.obj-code no-undo .
     5450   define input parameter p4   like obj-list.obj-type no-undo .
     5451     Create tmp-cli-gds.
     5452    def var kk as int no-undo.
     5453    REPEAT kk = 1 to 9 :
     5454      Assign
     5455         tmp-cli-gds.p-ostatok-start[kk]  = p-ostatok-start[kk]
     5456         tmp-cli-gds.p-ostatok-End[kk]    = p-ostatok-End[kk]
     5457         tmp-cli-gds.p-prih[kk]           = p-prih[kk]
     5458         tmp-cli-gds.p-rash[kk]           = p-rash[kk]
     5459         tmp-cli-gds.p-kassa[kk]          = p-kassa[kk]
     5460         tmp-cli-gds.p-Inv[kk]            = p-Inv[kk]
     5461         tmp-cli-gds.p-spis[kk]           = p-spis[kk]
     5462         tmp-cli-gds.p-vzvr[kk]           = p-vzvr[kk]
     5463         tmp-cli-gds.p-vzvr-post[kk]      = p-vzvr-post[kk]
     5464         .
     5465    end.
     5466         assign
     5467         tmp-cli-gds.cli-code         = p1
     5468         tmp-cli-gds.cli-type         = p2
     5469         tmp-cli-gds.Name             = Name
     5470         tmp-cli-gds.obj-code         = p3
     5471         tmp-cli-gds.obj-type         = p4
     5472         .
     5473    END PROCEDURE.
     5474   Procedure Tmp-clear :
     5475    def var kk as int no-undo.
     5476    REPEAT kk = 1 to 9 :
     5477    Assign
     5478        p-ostatok-start[kk] = 0
     5479        p-ostatok-End[kk]   = 0
     5480        p-prih[kk]          = 0
     5481        p-rash[kk]          = 0
     5482        p-kassa[kk]         = 0
     5483        p-Inv[kk]           = 0
     5484        p-spis[kk]          = 0
     5485        p-vzvr[kk]          = 0
     5486        p-vzvr-post[kk]     = 0
     5487       .
     5488       end.
     5489   END PROCEDURE.
     5490   Procedure Tmp-assign :
     5491    def var kk as int no-undo.
     5492    REPEAT kk = 1 to 9 :
     5493       Assign
     5494       p-ostatok-start[kk]  = p-ostatok-start[kk]   + tmp-cli-gds.p-ostatok-start[kk]
     5495       p-ostatok-End[kk]    = p-ostatok-End[kk]     + tmp-cli-gds.p-ostatok-End[kk]
     5496       p-prih[kk]           = p-prih[kk]            + tmp-cli-gds.p-prih[kk]
     5497       p-rash[kk]           = p-rash[kk]            + tmp-cli-gds.p-rash[kk]
     5498       p-kassa[kk]          = p-kassa[kk]           + tmp-cli-gds.p-kassa[kk]
     5499       p-Inv[kk]            = p-Inv[kk]             + tmp-cli-gds.p-Inv[kk]
     5500       p-spis[kk]           = p-spis[kk]            + tmp-cli-gds.p-spis[kk]
     5501       p-vzvr[kk]           = p-vzvr[kk]            + tmp-cli-gds.p-vzvr[kk]
     5502       p-vzvr-post[kk]      = p-vzvr-post[kk]       + tmp-cli-gds.p-vzvr-post[kk]
     5503       .
     5504    end.
     5505   END PROCEDURE.
     5506   procedure Goods-start-O :
     5507    def buffer  b-post-stk-line for ub.stk-supp-line .
     5508    define variable p-fact-order as decimal no-undo .
     5509     p-fact-order = fact-order-1 .
     5510     Find last temp2-post-stk-line  no-lock where
     5511       temp2-post-stk-line.artic       =  temp-t-post-stk-line.artic        and
     5512       temp2-post-stk-line.prod-type   =  temp-t-post-stk-line.prod-type    and
     5513       temp2-post-stk-line.prod-code   =  temp-t-post-stk-line.prod-code    and
     5514       temp2-post-stk-line.cli-type    =  temp-t-post-stk-line.cli-type     and
     5515       temp2-post-stk-line.cli-code    =  temp-t-post-stk-line.cli-code     and
     5516       temp2-post-stk-line.obj-type    =  OBJ-LIST.obj-type     and
     5517       temp2-post-stk-line.obj-code    =  obj-list.obj-code     and
     5518       temp2-post-stk-line.fact-order <=  fact-order-1               and
     5519       temp2-post-stk-line.sum-type    =  'cost':U                and
     5520       temp2-post-stk-line.cat-id      =  '##':U
     5521       no-error .
     5522     Find Last a-post-stk-line  where
     5523         a-post-stk-line.fact-order =  (if avail temp2-post-stk-line then temp2-post-stk-line.fact-order else 0)  and
     5524         a-post-stk-line.cat-id     =  t#cat-id      and
     5525         a-post-stk-line.Sum-type   =  t#sum-type    and
     5526         a-post-stk-line.artic      =  temp-t-post-stk-line.artic       and
     5527         a-post-stk-line.prod-type  =  temp-t-post-stk-line.prod-type   and
     5528         a-post-stk-line.prod-code  =  temp-t-post-stk-line.prod-code   and
     5529         a-post-stk-line.cli-type   =  temp-t-post-stk-line.cli-type  and
     5530         a-post-stk-line.cli-code   =  temp-t-post-stk-line.cli-code  and
     5531         a-post-stk-line.obj-type   =  obj-list.obj-type  and
     5532         a-post-stk-line.obj-code   =  obj-list.obj-code
     5533         no-lock no-error .
     5534         if avail  a-post-stk-line Then do:
     5535           p-fact-order     = a-post-stk-line.fact-order .
     5536           Ostatok-start[1] = Ostatok-start[1] +  a-post-stk-line.fact-qnty   .
     5537           ostatok-start[2] = ostatok-start[2] +  if tprintrubl then  a-post-stk-line.sum-rubl
     5538                                                     else a-post-stk-line.sum-base .
     5539           end.
     5540        IF Show-Sale  then do:
     5541                For each b-post-stk-line where
     5542                                            b-post-stk-line.fact-order = p-fact-order and
     5543                                            b-post-stk-line.cat-id     = t#cat-id   and
     5544                                            b-post-stk-line.Sum-type   begins 'sadt':U         and
     5545                                            b-post-stk-line.artic      = temp-t-post-stk-line.artic      and
     5546                                            b-post-stk-line.prod-type  = temp-t-post-stk-line.prod-type  and
     5547                                            b-post-stk-line.prod-code  = temp-t-post-stk-line.prod-code  and
     5548                                            b-post-stk-line.cli-type   = temp-t-post-stk-line.cli-type   and
     5549                                            b-post-stk-line.cli-code   = temp-t-post-stk-line.cli-code   and
     5550                                            b-post-stk-line.obj-type   = obj-list.obj-type   and
     5551                                            b-post-stk-line.obj-code   = obj-list.obj-code
     5552                                            no-lock :
     5553                         IF  tPrintRubl  THEN
     5554                              ASSIGN  Ostatok-start[8] = Ostatok-start[8]  + b-post-stk-line.sum-rubl .
     5555                           ELSE
     5556                              ASSIGN  Ostatok-start[8] = Ostatok-start[8]  +  b-post-stk-line.sum-base.
     5557                 End.
     5558         End.
     5559   END PROCEDURE.
     5560   procedure Goods-end-O :
     5561    def buffer  b-post-stk-line for ub.stk-supp-line .
     5562    define variable p-fact-order as decimal no-undo .
     5563     p-fact-order = fact-order-2 .
     5564     Find last temp2-post-stk-line  no-lock where
     5565       temp2-post-stk-line.artic       =  temp-t-post-stk-line.artic        and
     5566       temp2-post-stk-line.prod-type   =  temp-t-post-stk-line.prod-type    and
     5567       temp2-post-stk-line.prod-code   =  temp-t-post-stk-line.prod-code    and
     5568       temp2-post-stk-line.cli-type    =  temp-t-post-stk-line.cli-type     and
     5569       temp2-post-stk-line.cli-code    =  temp-t-post-stk-line.cli-code     and
     5570       temp2-post-stk-line.obj-type    =  obj-list.obj-type     and
     5571       temp2-post-stk-line.obj-code    =  obj-list.obj-code     and
     5572       temp2-post-stk-line.fact-order <=  fact-order-2               and
     5573       temp2-post-stk-line.sum-type    =  'cost':U                and
     5574       temp2-post-stk-line.cat-id      =  '##':U
     5575       no-error .
     5576     Find Last a-post-stk-line  where
     5577         a-post-stk-line.fact-order =  (if avail temp2-post-stk-line then temp2-post-stk-line.fact-order else 0)  and
     5578         a-post-stk-line.cat-id     =  t#cat-id       and
     5579         a-post-stk-line.Sum-type   =  t#sum-type     and
     5580         a-post-stk-line.artic      =  temp-t-post-stk-line.artic       and
     5581         a-post-stk-line.prod-type  =  temp-t-post-stk-line.prod-type   and
     5582         a-post-stk-line.prod-code  =  temp-t-post-stk-line.prod-code   and
     5583         a-post-stk-line.cli-type   =  temp-t-post-stk-line.cli-type    and
     5584         a-post-stk-line.cli-code   =  temp-t-post-stk-line.cli-code    and
     5585         a-post-stk-line.obj-type   =  obj-list.obj-type    and
     5586         a-post-stk-line.obj-code   =  obj-list.obj-code
     5587         no-lock no-error .
     5588     if avail  a-post-stk-line Then do :
     5589         Assign
     5590           p-fact-order     = a-post-stk-line.fact-order
     5591           ostatok-end[1] = ostatok-end[1] + a-post-stk-line.fact-qnty
     5592           ostatok-end[2] = ostatok-end[2] + if tprintrubl then  a-post-stk-line.sum-rubl
     5593                                             else  a-post-stk-line.sum-base.
     5594     end.
     5595        IF Show-Sale  then do:
     5596                For each b-post-stk-line where
     5597                     b-post-stk-line.fact-order = p-fact-order and
     5598                     b-post-stk-line.cat-id     = t#cat-id   and
     5599                     b-post-stk-line.Sum-type    begins 'sadt':U         and
     5600                     b-post-stk-line.artic      = post-stk-line.artic      and
     5601                     b-post-stk-line.prod-type  = temp-t-post-stk-line.prod-type  and
     5602                     b-post-stk-line.prod-code  = temp-t-post-stk-line.prod-code  and
     5603                     b-post-stk-line.cli-type   = temp-t-post-stk-line.cli-type   and
     5604                     b-post-stk-line.cli-code   = temp-t-post-stk-line.cli-code   and
     5605                     b-post-stk-line.obj-type   = obj-list.obj-type   and
     5606                     b-post-stk-line.obj-code   = obj-list.obj-code
     5607                     no-lock :
     5608                         IF  tPrintRubl  THEN
     5609                              ASSIGN  Ostatok-end[8] = Ostatok-end[8]  + b-post-stk-line.sum-rubl .
     5610                           ELSE
     5611                              ASSIGN  Ostatok-end[8] = Ostatok-end[8]  +  b-post-stk-line.sum-base.
     5612                 End.
     5613         End.
     5614   END PROCEDURE.
