     2320                                               ub.goods.prod-type = post-stk-line.prod-type and
     2321                                               ub.goods.prod-code = post-stk-line.prod-code and  can-find(first Tmp#grp where  ub.goods.grp-name begins Tmp#grp.grp-name ) = TRUE
     2322                                               :
     2323                    find first  temp-t-post-stk-line where
     2324                      temp-t-post-stk-line.cli-type  = post-stk-line.cli-type  and
