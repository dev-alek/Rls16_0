     2949                                               post-stk-line.cat-id      = '##':U
     2950                                               and  can-find(first G#cli where  post-stk-line.prod-type = G#cli.obj-type and  post-stk-line.prod-code = G#cli.obj-code ) = TRUE
     2951                                               :
     2952                    find first  temp-t-post-stk-line where
     2953                      temp-t-post-stk-line.cli-type  = post-stk-line.cli-type  and
     2954                      temp-t-post-stk-line.cli-code  = post-stk-line.cli-code   and
     2955                      temp-t-post-stk-line.artic     = post-stk-line.artic     and
     2956                      temp-t-post-stk-line.prod-type = post-stk-line.prod-type and
     2957                      temp-t-post-stk-line.prod-code = post-stk-line.prod-code no-lock no-error .
     2958                      if not available  temp-t-post-stk-line then do:
     2959                         find first  ub.goods no-lock where
     2960                                               ub.goods.artic     = post-stk-line.artic     and
     2961                                               ub.goods.prod-type = post-stk-line.prod-type and
     2962                                               ub.goods.prod-code = post-stk-line.prod-code no-error .
     2963                         find first  prod-cli no-lock  where
     2964                                                   prod-cli.obj-type = post-stk-line.prod-type and
     2965                                                   prod-cli.obj-code = post-stk-line.prod-code
     2966                                                   no-error .
     2967                         find first  ub.clients  no-lock  where
     2968                                                   ub.clients.obj-type = post-stk-line.cli-type and
     2969                                                   ub.clients.obj-code = post-stk-line.cli-code no-error .
     2970                           run create-temp-t-post-stk-line .
     2971                    end.
     2972                    else do:
     2973                            assign
     2974                              temp-t-post-stk-line.fact-order = post-stk-line.fact-order  .
     2975                            .
     2976                    end.
     2977             end.
     2978             For each temp-t-post-stk-line no-lock   ,
     2979                    Last temp-post-stk-line  where
     2980                         temp-post-stk-line.fact-order <= fact-order-2   and
     2981                         temp-post-stk-line.cat-id     =  t#cat-id      and
