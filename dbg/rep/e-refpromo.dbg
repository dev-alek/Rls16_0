      864   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      865   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      866   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      867   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      868   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      869   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      870   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      871   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      872       ASSIGN adm-object-hdl = FRAME F-Main:HANDLE.
      873   RUN ensure-broker.
      874   THIS-PROCEDURE:ADM-DATA =
      875        'ADM1.1~`':U +
      876        'SmartObject~`':U +
      877        'FRAME~`':U +
      878        'NO ~`':U +
      879        '~`':U +
      880        '~`':U +
      881        '~`':U +
      882        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      883           + "~`":U +
      884        'Layout,Hide-on-Init~`':U +
      885        '~`':U +
      886        '~`':U +
      887        '~`~`~`~`~`~`~`~`~`~`~`':U +
      888        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      889            THEN "^^":U
      890        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      891             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      892   PROCEDURE adm-apply-entry :
      893     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      894   END PROCEDURE.
      895   PROCEDURE adm-destroy :
      896    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      897   END PROCEDURE.
      898   PROCEDURE adm-disable :
      899       DISABLE rect-3 rect-4 RADIO-SET-1 RADIO-SET-2 editor-promo WITH FRAME F-Main.
      900       RUN dispatch ('disable-fields':U).
      901       RUN set-attribute-list ('ENABLED=no':U).
      902       RETURN.
      903   END PROCEDURE.
      904   PROCEDURE adm-edit-attribute-list :
      905         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
      906         RETURN.
      907   END PROCEDURE.
      908   PROCEDURE adm-enable :
      909       ENABLE UNLESS-HIDDEN rect-3 rect-4 RADIO-SET-1 RADIO-SET-2 editor-promo WITH FRAME F-Main.
      910       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      911       RUN set-attribute-list ('ENABLED=yes':U).
      912       RETURN.
      913   END PROCEDURE.
      914   PROCEDURE adm-exit :
      915        RUN notify ('exit':U).
      916     RETURN.
      917   END PROCEDURE.
      918   PROCEDURE adm-hide :
      919     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      920   END PROCEDURE.
      921   PROCEDURE adm-initialize :
      922     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      923   END PROCEDURE.
      924   PROCEDURE adm-show-errors :
      925       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      926       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      927           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      928       END.
      929       RETURN.
      930   END PROCEDURE.
      931   PROCEDURE adm-UIB-mode :
      932     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      933   END PROCEDURE.
      934   PROCEDURE adm-view :
      935     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      936   END PROCEDURE.
      937   PROCEDURE dispatch :
      938       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      939       RUN broker-dispatch IN adm-broker-hdl
      940           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      941       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      942   END PROCEDURE.
      943   PROCEDURE ensure-broker :
      944   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      945   IF RETURN-VALUE NE "ADM-Broker":U THEN
      946   DO:
      947       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      948       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      949   END.
      950   END PROCEDURE.
      951   PROCEDURE get-attribute :
      952     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      953     RUN broker-get-attribute IN adm-broker-hdl
      954         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      955     RETURN RETURN-VALUE.
      956   END PROCEDURE.
      957   PROCEDURE get-attribute-list :
      958     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      959     RUN broker-get-attribute-list IN adm-broker-hdl
      960         (INPUT THIS-PROCEDURE,
      961          INPUT ?,
      962          OUTPUT p-attr-list) NO-ERROR.
      963     RETURN.
      964   END PROCEDURE.
      965   PROCEDURE new-state :
      966     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      967     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      968     RETURN.
      969   END PROCEDURE.
      970   PROCEDURE notify :
      971     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      972     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      973     IF RETURN-VALUE = "ADM-ERROR":U THEN
      974         RETURN "ADM-ERROR":U.
      975     RETURN.
      976   END PROCEDURE.
      977   PROCEDURE set-attribute-list :
      978     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      979     RUN ensure-broker.
      980     RUN broker-set-attribute-list IN adm-broker-hdl
      981         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      982     RETURN.
      983   END PROCEDURE.
      984   PROCEDURE set-position :
      985       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      986       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      987       IF VALID-HANDLE(adm-object-hdl) THEN
      988       DO:
      989           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
      990           IF adm-object-hdl:TYPE = "WINDOW":U THEN
      991           DO:
      992             IF p-row = 0 THEN p-row =
      993               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
      994             IF p-col = 0 THEN p-col =
      995               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
      996           END.
      997           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
      998           DO:
      999             parent-hdl = adm-object-hdl:PARENT.
     1000             IF p-row = 0 THEN p-row =
     1001               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     1002                 parent-hdl:ROW.
     1003             IF p-col = 0 THEN p-col =
     1004               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     1005                 parent-hdl:COL.
     1006           END.
     1007           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     1008           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     1009         ASSIGN adm-object-hdl:ROW    =   p-row
     1010                adm-object-hdl:COLUMN =   p-col.
     1011       END.
     1012       RETURN.
     1013   END PROCEDURE.
     1014   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
     1015       STRING(adm-object-hdl)).
     1016   PAUSE 0 BEFORE-HIDE.
     1017   PROCEDURE adm-change-page :
     1018     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
     1019     END PROCEDURE.
     1020   PROCEDURE delete-page :
     1021     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
     1022     RUN broker-delete-page IN adm-broker-hdl
     1023         (INPUT THIS-PROCEDURE, INPUT p-page#).
     1024     END PROCEDURE.
     1025   PROCEDURE init-object :
     1026     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
     1027     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
     1028     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
     1029     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
     1030     RUN broker-init-object IN adm-broker-hdl
     1031         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
     1032          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
     1033     RETURN.
     1034   END PROCEDURE.
     1035   PROCEDURE init-pages :
     1036     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
     1037     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1038         INPUT p-page-list) NO-ERROR.
     1039     END PROCEDURE.
     1040   PROCEDURE select-page :
     1041     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
     1042     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1043         INPUT p-page#) NO-ERROR.
     1044     END PROCEDURE.
     1045   PROCEDURE view-page :
     1046     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
     1047     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1048         INPUT p-page#).
     1049     END PROCEDURE.
     1050   ASSIGN
     1051          editor-promo:READ-ONLY IN FRAME F-Main        = TRUE.
     1052   ON CHOOSE OF r-gop-1 IN FRAME F-Main
     1053   DO:
     1054     run ref/promo.p (input my-handle,yes,output vSubs) no-error.
     1055     if not valid-object (vSubs) then return.
     1056     editor-promo = "":U.
     1057     empty temp-table tt-promo.
     1058     v-text-promo = "" .
     1059     vI = 0.
     1060           DO ii = 1 to vSubs:iCounter:
     1061           vSubs:GetItem(ii).
     1062           v-promo-action = vSubs:promoActionObjCurr .
     1063           FIND FIRST ub.PromoAction No-LOCK WHERE
     1064             ub.PromoAction.id = v-promo-action:ID
     1065             No-ERROR.
     1066           IF avail ub.PromoAction then
     1067           do:
     1068             CREATE tt-promo.
     1069             buffer-copy ub.PromoAction to tt-promo .
     1070                 ASSIGN
     1071                   v-text-promo = v-text-promo + chr(10) + ub.PromoAction.nameAction.
     1072                 .
     1073               END.
     1074               ASSIGN
     1075                 v-text-promo = TRIM(v-text-promo, chr(10))
     1076   vI = vI + 1
     1077                 .
     1078             END.
     1079     EDITOR-promo = v-text-promo.
     1080     fill-in-1 = "Выбрано записей " +  string(vI).
     1081     display
     1082       editor-promo
     1083       fill-in-1
     1084       with frame F-Main
     1085     .
     1086   END.
     1087   ON VALUE-CHANGED OF RADIO-SET-1 IN FRAME F-Main
     1088   DO:
     1089   ASSIGN
     1090         Radio-set-1
     1091         .
     1092       CASE RADIO-SET-1:
     1093         WHEN 2
     1094         THEN
     1095           DO:
     1096             enable r-gop-1 with frame F-Main.
     1097             apply "choose" to r-gop-1 in frame F-Main.
     1098           END.
     1099         WHEN 1 THEN
     1100           DO:
     1101             EDITOR-promo = "Все":U.
     1102             fill-in-1 = "".
     1103             EMPTY TEMP-TABLE tt-promo.
     1104             disable r-gop-1 with frame F-Main.
     1105           END.
     1106         OTHERWISE
     1107         DO:
     1108         END.
     1109       END case.
     1110       DISPLAY
     1111         EDITOR-promo
     1112         fill-in-1
     1113         WITH FRAME F-Main.
     1114   END.
     1115   ON VALUE-CHANGED OF RADIO-SET-2 IN FRAME F-Main
     1116   DO:
     1117      assign RADIO-SET-2.
     1118   END.
     1119   PROCEDURE adm-create-objects :
     1120   END PROCEDURE.
     1121   PROCEDURE adm-row-available :
     1122     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1123     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1124     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1125     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1126     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1127     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1128     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1129     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1130     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1131     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1132     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1133     IF adm-updating-record THEN RETURN.
     1134     RUN get-attribute ('FIELDS-ENABLED':U).
     1135     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1136     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1137         OUTPUT link-handle) NO-ERROR.
     1138     IF link-handle = "":U THEN
     1139         RETURN.
     1140     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1141     IF NUM-ENTRIES(link-handle) > 1 THEN
     1142         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1143             "encountered more than one RECORD-SOURCE.":U SKIP
     1144             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1145                VIEW-AS ALERT-BOX ERROR.
     1146     RUN get-attribute ('Key-Name':U).
     1147     key-name = RETURN-VALUE.
     1148     IF key-name = "":U THEN key-name = ?.
     1149     IF key-name NE ? THEN DO:
     1150       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1151         NO-ERROR.
     1152       IF key-value NE ? THEN
     1153         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1154     END.
     1155   IF VALID-HANDLE (adm-object-hdl) THEN
     1156       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1157   RUN notify IN THIS-PROCEDURE ('row-available':U).
     1158   END PROCEDURE.
     1159   PROCEDURE disable_UI :
     1160     HIDE FRAME F-Main.
     1161     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1162   END PROCEDURE.
     1163   PROCEDURE enable_UI :
     1164     DISPLAY RADIO-SET-1 RADIO-SET-2 editor-promo
     1165         WITH FRAME F-Main.
     1166     ENABLE rect-3 rect-4 RADIO-SET-1 RADIO-SET-2 editor-promo
     1167         WITH FRAME F-Main.
     1168   END PROCEDURE.
     1169   PROCEDURE local-initialize :
     1170     run dispatch in this-procedure ( input 'initialize':u ) .
     1171     EDITOR-promo = "Все":U.
     1172     EMPTY TEMP-TABLE tt-promo.
     1173     disable r-gop-1 with frame F-Main.
     1174   end procedure.
     1175   PROCEDURE My-report :
     1176   define variable     det-mode            as integer      no-undo init 0.
     1177       do:
     1178           run rep/r-refpromo.p (input my-handle,
     1179                                 input table tt-promo,
     1180                                 input RADIO-SET-2).
     1181       end.
     1182   end procedure.
     1183   PROCEDURE my-var :
     1184   .
     1185   end procedure.
