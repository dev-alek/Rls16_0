     4012   PROCEDURE Display-title :
     4013      PUT stream  OutStream  UNFORMATTED  string( v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + ObjName) AT 50 format "X(85)" SKIP(2)
     4014             REPORTNAME  AT 1 format "X(133)" SKIP
     4015             Trim(str1)  AT 35 format "X(75)" SKIP.
     4016        Repeat i = 1 to NUM-ENTRIES(str2,chr(10)) :
     4017         PUT stream  OutStream  UNFORMATTED  Entry(i,str2,chr(10))  AT 1 format "X(130)" SKIP.
     4018        End.
     4019       i=0.
     4020        Repeat i = 1 to NUM-ENTRIES(str3,chr(10)) :
     4021         PUT stream  OutStream  UNFORMATTED  Entry(i,str3,chr(10))  AT 1 format "X(130)" SKIP.
     4022        End.
     4023       i=0.
     4024        Repeat i = 1 to NUM-ENTRIES(str4,chr(10)) :
     4025         PUT stream  OutStream  UNFORMATTED  Entry(i,str4,chr(10))  AT 1 format "X(130)" SKIP.
     4026        End.
     4027       i=0.
     4028        Repeat i = 1 to NUM-ENTRIES(ReportHeader,chr(10)) :
     4029         PUT stream  OutStream  UNFORMATTED  Entry(i,ReportHeader,chr(10))  AT 1 format "X(130)" SKIP.
     4030        End.
     4031       i=0.
     4032   END PROCEDURE.
     4033   PROCEDURE ob-line  :
     4034   define input  parameter x-store-code     like ub.clients.obj-code     no-undo.
     4035   define input  parameter x-store-type     like ub.clients.obj-type     no-undo.
     4036   define input  parameter x-artic          like ub.ot-line.artic        no-undo.
     4037   define input  parameter x-prod-code      like ub.ot-line.prod-code    no-undo.
     4038   define input  parameter x-prod-type      like ub.ot-line.prod-type    no-undo.
     4039   define input  parameter x-fact-order-1   like ub.ot-line.fact-order   no-undo.
     4040   define input  parameter x-fact-order-2   like ub.ot-line.fact-order   no-undo.
     4041   define input  parameter x-sum-type       like ub.ot-line.sum-type     no-undo.
     4042   define input  parameter x-cat-id         like ub.ot-line.cat-id       no-undo.
     4043   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type no-undo.
     4044   define input  parameter xtog-obj           as log no-undo.
     4045   define variable  quantity#    like ub.ot-line.fact-qnty   no-undo.
     4046   define variable  coast_r#     like ub.ot-line.sum-rubl    no-undo.
     4047   define variable  coast_v#     like ub.ot-line.sum-rubl    no-undo.
     4048   define variable  vat_r#       like ub.ot-line.sum-rubl    no-undo.
     4049   define variable  vat_v#       like ub.ot-line.sum-rubl    no-undo.
     4050   define variable  slt_r#       like ub.ot-line.sum-rubl    no-undo.
     4051   define variable  slt_v#       like ub.ot-line.sum-rubl    no-undo.
     4052   define variable  v-summa  as decimal extent 4 no-undo .
     4053   define variable  tt#          as int no-undo.
     4054   define variable v-ii as integer no-undo .
     4055   define variable slt  as decimal no-undo .
     4056   define variable disc  as decimal no-undo .
     4057   define variable xi as integer no-undo .
     4058   define variable v-tt as integer no-undo .
     4059    if (x-sum-type = 'cost':U  or x-sum-type = 'cssr':U) then assign tt# = 0 v-tt = 0.
     4060       else
     4061       if (x-sum-type = 'crsa':U  or x-sum-type = 'cgsr':U) then assign tt# = 3  v-tt = 100.
     4062       else
     4063       assign tt# = 6  v-tt = 200.
     4064     if long-p = false then do :
     4065     for each obj-list no-lock:
     4066      if  xtog-obj then
     4067          if   not(x-store-type     = obj-list.obj-type
     4068               and x-store-code    = obj-list.obj-code ) then next.
     4069           for each ub.ot-line where
     4070                     ub.ot-line.artic         = x-artic
     4071               and   ub.ot-line.prod-code    = x-prod-code
     4072               and   ub.ot-line.prod-type    = x-prod-type
     4073               and   ub.ot-line.fact-order   <= x-fact-order-2
     4074               and   ub.ot-line.fact-order   >= x-fact-order-1
     4075               and   ub.ot-line.obj-code     = obj-list.obj-code
     4076               and   ub.ot-line.obj-type     = obj-list.obj-type
     4077               and   ub.ot-line.sum-type     = x-sum-type
     4078               no-lock :
     4079               case ub.ot-line.ext-doc-type:
     4080     WHEN 'ie':U THEN DO:
     4081       ASSIGN oborot-ie[1 + tt#]   = oborot-ie[1 + tt#]   +  ub.ot-line.fact-qnty
     4082             oborot-ie[2 + tt#]   = oborot-ie[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4083             oborot-ie[3 + tt#]   = oborot-ie[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4084         if tt# = 6 Then   assign
     4085             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4086             oborot-ie[10]   = oborot-ie[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4087             End.
     4088     WHEN 'ee':U THEN DO:
     4089       ASSIGN oborot-ee[1 + tt#]   = oborot-ee[1 + tt#]   +  ub.ot-line.fact-qnty
     4090             oborot-ee[2 + tt#]   = oborot-ee[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4091             oborot-ee[3 + tt#]   = oborot-ee[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4092         if tt# = 6 Then   assign
     4093             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4094             oborot-ee[10]   = oborot-ee[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4095             End.
     4096     WHEN 'ep':U THEN DO:
     4097       ASSIGN oborot-ep[1 + tt#]   = oborot-ep[1 + tt#]   +  ub.ot-line.fact-qnty
     4098             oborot-ep[2 + tt#]   = oborot-ep[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4099             oborot-ep[3 + tt#]   = oborot-ep[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4100         if tt# = 6 Then   assign
     4101             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4102             oborot-ep[10]   = oborot-ep[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4103             End.
     4104     WHEN 'es':U THEN DO:
     4105       ASSIGN oborot-es[1 + tt#]   = oborot-es[1 + tt#]   +  ub.ot-line.fact-qnty
     4106             oborot-es[2 + tt#]   = oborot-es[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4107             oborot-es[3 + tt#]   = oborot-es[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4108         if tt# = 6 Then   assign
     4109             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4110             oborot-es[10]   = oborot-es[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4111             End.
     4112     WHEN 're':U THEN DO:
     4113       ASSIGN oborot-re[1 + tt#]   = oborot-re[1 + tt#]   +  ub.ot-line.fact-qnty
     4114             oborot-re[2 + tt#]   = oborot-re[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4115             oborot-re[3 + tt#]   = oborot-re[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4116         if tt# = 6 Then   assign
     4117             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4118             oborot-re[10]   = oborot-re[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4119             End.
     4120     WHEN 'rs':U THEN DO:
     4121       ASSIGN oborot-rs[1 + tt#]   = oborot-rs[1 + tt#]   +  ub.ot-line.fact-qnty
     4122             oborot-rs[2 + tt#]   = oborot-rs[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4123             oborot-rs[3 + tt#]   = oborot-rs[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4124         if tt# = 6 Then   assign
     4125             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4126             oborot-rs[10]   = oborot-rs[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4127             End.
     4128     WHEN 'we':U THEN DO:
     4129       ASSIGN oborot-we[1 + tt#]   = oborot-we[1 + tt#]   +  ub.ot-line.fact-qnty
     4130             oborot-we[2 + tt#]   = oborot-we[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4131             oborot-we[3 + tt#]   = oborot-we[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4132         if tt# = 6 Then   assign
     4133             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4134             oborot-we[10]   = oborot-we[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4135             End.
     4136     WHEN 'vt':U  OR  WHEN 'mp':U OR WHEN 'vp':U THEN DO:
     4137       ASSIGN oborot-vt[1 + tt#]   = oborot-vt[1 + tt#]   +  ub.ot-line.fact-qnty
     4138             oborot-vt[2 + tt#]   = oborot-vt[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4139             oborot-vt[3 + tt#]   = oborot-vt[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4140           if tt# = 6 Then  assign
     4141             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4142             oborot-vt[10]   = oborot-vt[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4143             End.
     4144     WHEN 'iv':U THEN DO:
     4145       ASSIGN oborot-iv[1 + tt#]   = oborot-iv[1 + tt#]   +  ub.ot-line.fact-qnty
     4146             oborot-iv[2 + tt#]   = oborot-iv[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4147             oborot-iv[3 + tt#]   = oborot-iv[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4148         if tt# = 6 Then   assign
     4149             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4150             oborot-iv[10]   = oborot-iv[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4151             End.
     4152     WHEN 'ev':U THEN DO:
     4153       ASSIGN oborot-ev[1 + tt#]   = oborot-ev[1 + tt#]   +  ub.ot-line.fact-qnty
     4154             oborot-ev[2 + tt#]   = oborot-ev[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4155             oborot-ev[3 + tt#]   = oborot-ev[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4156         if tt# = 6 Then   assign
     4157             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4158             oborot-ev[10]   = oborot-ev[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4159             End.
     4160     WHEN 'rv':U THEN DO:
     4161       ASSIGN oborot-rv[1 + tt#]   = oborot-rv[1 + tt#]   +  ub.ot-line.fact-qnty
     4162             oborot-rv[2 + tt#]   = oborot-rv[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4163             oborot-rv[3 + tt#]   = oborot-rv[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4164         if tt# = 6 Then   assign
     4165             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4166             oborot-rv[10]   = oborot-rv[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4167             End.
     4168     WHEN 'wm':U  OR  WHEN 'em':U THEN DO:
     4169       ASSIGN oborot-em[1 + tt#]   = oborot-em[1 + tt#]   +  ub.ot-line.fact-qnty
     4170             oborot-em[2 + tt#]   = oborot-em[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4171             oborot-em[3 + tt#]   = oborot-em[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4172           if tt# = 6 Then  assign
     4173             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4174             oborot-em[10]   = oborot-em[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4175             End.
     4176     WHEN 'im':U THEN DO:
     4177       ASSIGN oborot-im[1 + tt#]   = oborot-im[1 + tt#]   +  ub.ot-line.fact-qnty
     4178             oborot-im[2 + tt#]   = oborot-im[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4179             oborot-im[3 + tt#]   = oborot-im[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4180         if tt# = 6 Then   assign
     4181             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4182             oborot-im[10]   = oborot-im[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4183             End.
     4184     WHEN 'ot':U THEN DO:
     4185       ASSIGN oborot-ot[1 + tt#]   = oborot-ot[1 + tt#]   +  ub.ot-line.fact-qnty
     4186             oborot-ot[2 + tt#]   = oborot-ot[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4187             oborot-ot[3 + tt#]   = oborot-ot[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4188         if tt# = 6 Then   assign
     4189             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4190             oborot-ot[10]   = oborot-ot[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4191             End.
     4192     WHEN 'ap':U THEN DO:
     4193       ASSIGN oborot-ap[1 + tt#]   = oborot-ap[1 + tt#]   +  ub.ot-line.fact-qnty
     4194             oborot-ap[2 + tt#]   = oborot-ap[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4195             oborot-ap[3 + tt#]   = oborot-ap[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4196         if tt# = 6 Then   assign
     4197             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4198             oborot-ap[10]   = oborot-ap[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4199             End.
     4200     WHEN 'pc':U THEN DO:
     4201       ASSIGN oborot-pc[1 + tt#]   = oborot-pc[1 + tt#]   +  ub.ot-line.fact-qnty
     4202             oborot-pc[2 + tt#]   = oborot-pc[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4203             oborot-pc[3 + tt#]   = oborot-pc[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4204         if tt# = 6 Then   assign
     4205             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4206             oborot-pc[10]   = oborot-pc[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4207             End.
     4208               end case.
     4209           end.
     4210      end.
     4211   end.
     4212   else do:
     4213   xi = 1 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-ie [1 + tt#] ,output  oborot-ie [2 + tt#] ,output  oborot-ie [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-ie[10]    = oborot-ie[10]    + slt  .
     4214   xi = 2 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-ee [1 + tt#] ,output  oborot-ee [2 + tt#] ,output  oborot-ee [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-ee[10]    = oborot-ee[10]    + slt  .
     4215   xi = 3 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-ep [1 + tt#] ,output  oborot-ep [2 + tt#] ,output  oborot-ep [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-ep[10]    = oborot-ep[10]    + slt  .
     4216   xi = 4 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-es [1 + tt#] ,output  oborot-es [2 + tt#] ,output  oborot-es [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-es[10]    = oborot-es[10]    + slt  .
     4217   xi = 5 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-re [1 + tt#] ,output  oborot-re [2 + tt#] ,output  oborot-re [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-re[10]    = oborot-re[10]    + slt  .
     4218   xi = 6 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-rs [1 + tt#] ,output  oborot-rs [2 + tt#] ,output  oborot-rs [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-rs[10]    = oborot-rs[10]    + slt  .
     4219   xi = 7 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-we [1 + tt#] ,output  oborot-we [2 + tt#] ,output  oborot-we [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-we[10]    = oborot-we[10]    + slt  .
     4220   xi = 8 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-vt [1 + tt#] ,output  oborot-vt [2 + tt#] ,output  oborot-vt [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-vt[10]    = oborot-vt[10]    + slt  .
     4221   xi = 9 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-iv [1 + tt#] ,output  oborot-iv [2 + tt#] ,output  oborot-iv [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-iv[10]    = oborot-iv[10]    + slt  .
     4222   xi = 10 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-ev [1 + tt#] ,output  oborot-ev [2 + tt#] ,output  oborot-ev [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-ev[10]    = oborot-ev[10]    + slt  .
     4223   xi = 11 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-rv [1 + tt#] ,output  oborot-rv [2 + tt#] ,output  oborot-rv [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-rv[10]    = oborot-rv[10]    + slt  .
     4224   xi = 12 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-em [1 + tt#] ,output  oborot-em [2 + tt#] ,output  oborot-em [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-em[10]    = oborot-em[10]    + slt  .
     4225   xi = 13 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-im [1 + tt#] ,output  oborot-im [2 + tt#] ,output  oborot-im [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-im[10]    = oborot-im[10]    + slt  .
     4226   xi = 14 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-ot [1 + tt#] ,output  oborot-ot [2 + tt#] ,output  oborot-ot [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-ot[10]    = oborot-ot[10]    + slt  .
     4227   xi = 15 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-ap [1 + tt#] ,output  oborot-ap [2 + tt#] ,output  oborot-ap [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-ap[10]    = oborot-ap[10]    + slt  .
     4228   xi = 16 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-pc [1 + tt#] ,output  oborot-pc [2 + tt#] ,output  oborot-pc [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-pc[10]    = oborot-pc[10]    + slt  .
     4229   end.
     4230     if tt# = 6 then do:
     4231     if  xshowmediator = false then
     4232         oborot-sum-cost[1] =
     4233         oborot-ee[2]      +
     4234         oborot-es[2] +
     4235         oborot-re[2]  +
     4236         oborot-rs[2]
     4237         .
     4238         else
     4239         oborot-sum-cost[1] =
     4240         oborot-ee[4]      +
     4241         oborot-es[4] +
     4242         oborot-re[4]  +
     4243         oborot-rs[4]
     4244         .
     4245        repeat v-ii = 1 to 1 :
     4246        v-summa[v-ii ]  =
     4247           oborot-ie[v-ii ] + oborot-ee[v-ii ] + oborot-ep[v-ii ] +
     4248           oborot-es[v-ii ] + oborot-re[v-ii ] + oborot-rs[v-ii ] +
     4249           oborot-we[v-ii ] + oborot-vt[v-ii ] + oborot-iv[v-ii ] +
     4250           oborot-ev[v-ii ] + oborot-rv[v-ii ] + oborot-em[v-ii ] +
     4251           oborot-im[v-ii ] .
     4252        end.
     4253        repeat v-ii = 2 to 4 :
     4254        v-summa[v-ii ]  =
     4255           oborot-ie[v-ii + tt#] + oborot-ee[v-ii + tt#] + oborot-ep[v-ii + tt#] +
     4256           oborot-es[v-ii + tt#] + oborot-re[v-ii + tt#] + oborot-rs[v-ii + tt#] +
     4257           oborot-we[v-ii + tt#] + oborot-vt[v-ii + tt#] + oborot-iv[v-ii + tt#] +
     4258           oborot-ev[v-ii + tt#] + oborot-rv[v-ii + tt#] + oborot-em[v-ii + tt#] +
     4259           oborot-im[v-ii + tt#] .
     4260        end.
     4261         oborot-sum-sale[1] =
     4262         oborot-ee[2 + tt#] +
     4263         oborot-es[2 + tt#] +
     4264         oborot-re[2 + tt#] +
     4265         oborot-rs[2 + tt#]
     4266         .
     4267          assign oborot-ot[1 + tt#] = (ostatok-end[1 + tt#]  - ostatok-start[1 + tt#])  -  (v-summa[1])
     4268           oborot-ot[2 + tt#] = (ostatok-end[2 + tt#]  - ostatok-start[2 + tt#])  -  (v-summa[2])
     4269                                                                                                     -  oborot-disc[1]
     4270           oborot-ot[3 + tt#] = (ostatok-end[3 + tt#]  - ostatok-start[3 + tt#])  -  (v-summa[3])
     4271           oborot-ot[10] = (ostatok-end[10]  - ostatok-start[10])                 -  (v-summa[4])
     4272           .
     4273           oborot-eff[1] = -1 * (oborot-sum-sale[1] - oborot-sum-cost[1]) .
     4274           if oborot-sum-cost[1] <>  0 then
     4275             oborot-prc[1] = 100 * (oborot-sum-sale[1] - oborot-sum-cost[1] ) / oborot-sum-cost[1].
     4276             else oborot-prc[1] = 0.
     4277     end.
     4278   oborot-ie[4]   = Round(oborot-ie[1]   *  p-price-med , 2) .
     4279   oborot-ee[4]   = Round(oborot-ee[1]   *  p-price-med , 2) .
     4280   oborot-ep[4]   = Round(oborot-ep[1]   *  p-price-med , 2) .
     4281   oborot-es[4]   = Round(oborot-es[1]   *  p-price-med , 2) .
     4282   oborot-re[4]   = Round(oborot-re[1]   *  p-price-med , 2) .
     4283   oborot-rs[4]   = Round(oborot-rs[1]   *  p-price-med , 2) .
     4284   oborot-we[4]   = Round(oborot-we[1]   *  p-price-med , 2) .
     4285   oborot-vt[4]   = Round(oborot-vt[1]   *  p-price-med , 2) .
     4286   oborot-iv[4]   = Round(oborot-iv[1]   *  p-price-med , 2) .
     4287   oborot-ev[4]   = Round(oborot-ev[1]   *  p-price-med , 2) .
     4288   oborot-rv[4]   = Round(oborot-rv[1]   *  p-price-med , 2) .
     4289   oborot-em[4]   = Round(oborot-em[1]   *  p-price-med , 2) .
     4290   oborot-im[4]   = Round(oborot-im[1]   *  p-price-med , 2) .
     4291   oborot-ot[4]   = Round(oborot-ot[1]   *  p-price-med , 2) .
     4292   oborot-ap[4]   = Round(oborot-ap[1]   *  p-price-med , 2) .
     4293   oborot-pc[4]   = Round(oborot-pc[1]   *  p-price-med , 2) .
     4294   END PROCEDURE.
     4295   PROCEDURE report-exec1  :
     4296      FIND FIRST clients where x-store-type = clients.obj-type AND
     4297                               x-store-code = clients.obj-code no-lock no-error.
     4298              If available clients then  ObjName = clients.obj-name.
     4299                                            else  ObjName="объект не определен".
     4300     FORM with FRAME zapas .
     4301   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4302   form header
     4303     line format "X(197)" at 1 skip
     4304     "Продолжение - на следующей странице" at 30 skip
     4305     with frame bottomframe width 340 page-bottom no-labels no-box .
     4306   view stream outstream frame bottomframe .
     4307     Run CalcItog  in this-procedure .
     4308     Run Print-Header  in this-procedure .
     4309      CASE RetClassify :
     4310         when "vat-ps":U         then  Run Run7  in this-procedure .
     4311         otherwise do:
     4312           message "" view-as alert-box error .
     4313         end.
     4314      End case.
     4315     HIDE stream OutStream FRAME BottomFrame .
     4316     Run Print-footer  in this-procedure .
     4317     END PROCEDURE.
     4318   PROCEDURE Calc-Sub-itog :
     4319   define input parameter tt as int no-undo.
     4320   define variable tt2 as integer no-undo .
     4321   define variable ji as integer no-undo .
     4322     if tt = 6 then tt2 = 7 .
     4323               else tt2 = tt.
     4324   Repeat i# = 1 + tt to 3 + tt2 :
     4325   run sum-i (
     4326    input oborot-vt[i#]
     4327   ,input tt
     4328   ,input-output b1-oborot-vt[i#]
     4329   ,input-output b2-oborot-vt[i#]
     4330   ,input-output bi-oborot-vt[i#]
     4331   ,input-output bo-oborot-vt[i#]
     4332   ,input oborot-ie[i#]
     4333   ,input-output b1-oborot-ie[i#]
     4334   ,input-output b2-oborot-ie[i#]
     4335   ,input-output bi-oborot-ie[i#]
     4336   ,input-output bo-oborot-ie[i#]
     4337   ) .
     4338   run sum-i (
     4339    input oborot-iv[i#]
     4340   ,input tt
     4341   ,input-output b1-oborot-iv[i#]
     4342   ,input-output b2-oborot-iv[i#]
     4343   ,input-output bi-oborot-iv[i#]
     4344   ,input-output bo-oborot-iv[i#]
     4345   ,input oborot-ee[i#]
     4346   ,input-output b1-oborot-ee[i#]
     4347   ,input-output b2-oborot-ee[i#]
     4348   ,input-output bi-oborot-ee[i#]
     4349   ,input-output bo-oborot-ee[i#]
     4350   ) .
     4351   run sum-i (
     4352    input oborot-ev[i#]
     4353   ,input tt
     4354   ,input-output b1-oborot-ev[i#]
     4355   ,input-output b2-oborot-ev[i#]
     4356   ,input-output bi-oborot-ev[i#]
     4357   ,input-output bo-oborot-ev[i#]
     4358   ,input oborot-ep[i#]
     4359   ,input-output b1-oborot-ep[i#]
     4360   ,input-output b2-oborot-ep[i#]
     4361   ,input-output bi-oborot-ep[i#]
     4362   ,input-output bo-oborot-ep[i#]
     4363   ) .
     4364   run sum-i (
     4365    input oborot-rv[i#]
     4366   ,input tt
     4367   ,input-output b1-oborot-rv[i#]
     4368   ,input-output b2-oborot-rv[i#]
     4369   ,input-output bi-oborot-rv[i#]
     4370   ,input-output bo-oborot-rv[i#]
     4371   ,input oborot-es[i#]
     4372   ,input-output b1-oborot-es[i#]
     4373   ,input-output b2-oborot-es[i#]
     4374   ,input-output bi-oborot-es[i#]
     4375   ,input-output bo-oborot-es[i#]
     4376   ) .
     4377   run sum-i (
     4378    input oborot-em[i#]
     4379   ,input tt
     4380   ,input-output b1-oborot-em[i#]
     4381   ,input-output b2-oborot-em[i#]
     4382   ,input-output bi-oborot-em[i#]
     4383   ,input-output bo-oborot-em[i#]
     4384   ,input oborot-re[i#]
     4385   ,input-output b1-oborot-re[i#]
     4386   ,input-output b2-oborot-re[i#]
     4387   ,input-output bi-oborot-re[i#]
     4388   ,input-output bo-oborot-re[i#]
     4389   ) .
     4390   run sum-i (
     4391    input oborot-im[i#]
     4392   ,input tt
     4393   ,input-output b1-oborot-im[i#]
     4394   ,input-output b2-oborot-im[i#]
     4395   ,input-output bi-oborot-im[i#]
     4396   ,input-output bo-oborot-im[i#]
     4397   ,input oborot-rs[i#]
     4398   ,input-output b1-oborot-rs[i#]
     4399   ,input-output b2-oborot-rs[i#]
     4400   ,input-output bi-oborot-rs[i#]
     4401   ,input-output bo-oborot-rs[i#]
     4402   ) .
     4403   run sum-i (
     4404    input oborot-ap[i#]
     4405   ,input tt
     4406   ,input-output b1-oborot-ap[i#]
     4407   ,input-output b2-oborot-ap[i#]
     4408   ,input-output bi-oborot-ap[i#]
     4409   ,input-output bo-oborot-ap[i#]
     4410   ,input oborot-pc[i#]
     4411   ,input-output b1-oborot-pc[i#]
     4412   ,input-output b2-oborot-pc[i#]
     4413   ,input-output bi-oborot-pc[i#]
     4414   ,input-output bo-oborot-pc[i#]
     4415   ) .
     4416   run sum-i (
     4417    input oborot-ot[i#]
     4418   ,input tt
     4419   ,input-output b1-oborot-ot[i#]
     4420   ,input-output b2-oborot-ot[i#]
     4421   ,input-output bi-oborot-ot[i#]
     4422   ,input-output bo-oborot-ot[i#]
     4423   ,input oborot-we[i#]
     4424   ,input-output b1-oborot-we[i#]
     4425   ,input-output b2-oborot-we[i#]
     4426   ,input-output bi-oborot-we[i#]
     4427   ,input-output bo-oborot-we[i#]
     4428   ) .
     4429     B1-oborot-em[ i#] = B1-oborot-em[ i#] + oborot-wm[ i#].
     4430     B2-oborot-em[ i#] = B2-oborot-em[ i#] + oborot-wm[ i#].
     4431     Bi-oborot-em[ i#] = Bi-oborot-em[ i#] + oborot-wm[ i#].
     4432     Bo-oborot-em[ i#] = Bo-oborot-em[ i#] + oborot-wm[ i#].
     4433     Bo-ostatok-start[ i#]  = Bo-ostatok-start[i#]  + ostatok-start[ i#]  .
     4434     Bo-ostatok-end[ i#]    = Bo-ostatok-end[i#]    + ostatok-end[ i#]    .
     4435     if i# = 7 then B1-oborot-disc[1 ]  = B1-oborot-disc[1]  + oborot-disc[1]  .
     4436     if i# = 7 then B2-oborot-disc[1 ]  = B2-oborot-disc[1]  + oborot-disc[1]  .
     4437     if i# = 7 then Bi-oborot-disc[1 ]  = Bi-oborot-disc[1]  + oborot-disc[1]  .
     4438     if i# = 7 then Bo-oborot-disc[1 ]  = Bo-oborot-disc[1]  + oborot-disc[1]  .
     4439     if i# = 8 then
     4440       assign
     4441         bi-oborot-sum-Sale[ i#]  = Bi-oborot-ee[ i#] +
     4442                                 Bi-oborot-re[ i#]         +
     4443                                 Bi-oborot-rs[ i#]    +
     4444                                 Bi-oborot-es[ i#]
     4445         b1-oborot-sum-Sale[ i#]  = B1-oborot-ee[ i#] +
     4446                                 B1-oborot-re[ i#]         +
     4447                                 B1-oborot-rs[ i#]    +
     4448                                 B1-oborot-es[ i#]
     4449         b2-oborot-sum-Sale[ i#]  = B2-oborot-ee[ i#] +
     4450                                 B2-oborot-re[ i#]         +
     4451                                 B2-oborot-rs[ i#]    +
     4452                                 B2-oborot-es[ i#]
     4453         bo-oborot-sum-Sale[ i#]  = Bo-oborot-ee[ i#] +
     4454                                 Bo-oborot-re[ i#]         +
     4455                                 Bo-oborot-rs[ i#]    +
     4456                                 Bo-oborot-es[ i#]
     4457         .
     4458     if i# = 2 and  xShowmediator = false   then do:
     4459         ji = 2.
     4460         assign
     4461           bi-oborot-sum-cost[ i#]  = Bi-oborot-ee[ ji] +
     4462                                   Bi-oborot-re[ ji]         +
     4463                                   Bi-oborot-rs[ ji]    +
     4464                                   Bi-oborot-es[ ji]
     4465           b1-oborot-sum-cost[ i#]  = B1-oborot-ee[ ji] +
     4466                                   B1-oborot-re[ ji]         +
     4467                                   B1-oborot-rs[ ji]    +
     4468                                   B1-oborot-es[ ji]
     4469           b2-oborot-sum-cost[ i#]  = B2-oborot-ee[ ji] +
     4470                                   B2-oborot-re[ ji]         +
     4471                                   B2-oborot-rs[ ji]    +
     4472                                   B2-oborot-es[ ji]
     4473           bo-oborot-sum-cost[ i#]  = Bo-oborot-ee[ ji] +
     4474                                   Bo-oborot-re[ ji]         +
     4475                                   Bo-oborot-rs[ ji]    +
     4476                                   Bo-oborot-es[ ji]
     4477           .
     4478     end.
     4479     if  xShowmediator = true  then do:
     4480     if i# = 8 then B1-oborot-sum-cost[2 ]  = B1-oborot-sum-cost[2]  + oborot-sum-cost[1]  .
     4481     if i# = 8 then B2-oborot-sum-cost[2 ]  = B2-oborot-sum-cost[2]  + oborot-sum-cost[1]  .
     4482     if i# = 8 then Bi-oborot-sum-cost[2 ]  = Bi-oborot-sum-cost[2]  + oborot-sum-cost[1]  .
     4483     if i# = 8 then Bo-oborot-sum-cost[2 ]  = Bo-oborot-sum-cost[2]  + oborot-sum-cost[1]  .
     4484     end.
     4485     if i# = 8 then B1-oborot-eff[1 ]  = B1-oborot-eff[1]  + oborot-eff[1]  .
     4486     if i# = 8 then B2-oborot-eff[1 ]  = B2-oborot-eff[1]  + oborot-eff[1]  .
     4487     if i# = 8 then Bi-oborot-eff[1 ]  = Bi-oborot-eff[1]  + oborot-eff[1]  .
     4488     if i# = 8 then Bo-oborot-eff[1 ]  = Bo-oborot-eff[1]  + oborot-eff[1]  .
     4489     if i# = 8 then    if  Bi-oborot-sum-cost[2] <>  0 then
     4490                           Bi-oborot-prc[1] = 100 * (BI-oborot-sum-sale[8] - BI-oborot-sum-cost[2] ) / Bi-oborot-sum-cost[2] .
     4491                      else Bi-oborot-prc[1] = 0.
     4492     if i# = 8 then    if  Bo-oborot-sum-cost[2] <>  0 then
     4493                           BO-oborot-prc[1] = 100 * (Bo-oborot-sum-sale[8] - Bo-oborot-sum-cost[2] ) / Bo-oborot-sum-cost[2] .
     4494                      else BO-oborot-prc[1] = 0.
     4495     if i# = 8 then    if  B1-oborot-sum-cost[2] <>  0 then
     4496                           B1-oborot-prc[1] = 100 * (B1-oborot-sum-sale[8] - B1-oborot-sum-cost[2] ) / B1-oborot-sum-cost[2] .
     4497                      else B1-oborot-prc[1] = 0.
     4498     if i# = 8 then    if  B2-oborot-sum-cost[2] <>  0 then
     4499                           B2-oborot-prc[1] = 100 * (B2-oborot-sum-sale[8] - B2-oborot-sum-cost[2] ) / B2-oborot-sum-cost[2] .
     4500                      else B2-oborot-prc[1] = 0.
     4501    End.
     4502   END PROCEDURE.
     4503   PROCEDURE Sum-i :
     4504   define input parameter ob like oborot-ot[1] no-undo.
     4505   define input parameter tt as int  no-undo.
     4506   define input-output parameter b1 like b1-oborot-ot[1] no-undo.
     4507   define input-output parameter b2 like b1-oborot-ot[1] no-undo.
     4508   define input-output parameter bi like b1-oborot-ot[1] no-undo.
     4509   define input-output parameter bo like b1-oborot-ot[1] no-undo.
     4510   define input parameter ob2 like oborot-ot[1] no-undo.
     4511   define input-output parameter b1- like b1-oborot-ot[1] no-undo.
     4512   define input-output parameter b2- like b1-oborot-ot[1] no-undo.
     4513   define input-output parameter bi- like b1-oborot-ot[1] no-undo.
     4514   define input-output parameter bo- like b1-oborot-ot[1] no-undo.
     4515   Assign
     4516     B1 = B1 + ob
     4517     B2 = B2 + ob
     4518     B1- = B1- + ob2
     4519     B2- = B2- + ob2
     4520     Bi = Bi + ob
     4521     Bo = Bo + ob
     4522     Bi- = Bi- + ob2
     4523     Bo- = Bo- + ob2
     4524   .
     4525   END PROCEDURE.
     4526   PROCEDURE Clear-item :
     4527   define variable kk as int no-undo.
     4528    REPEAT kk = 1 to 12 :
     4529    Assign
     4530       oborot-ie                 [kk]    = 0
     4531       oborot-ee                 [kk]    = 0
     4532       oborot-ep              [kk]    = 0
     4533       oborot-es            [kk]    = 0
     4534       oborot-re             [kk]    = 0
     4535       oborot-rs        [kk]    = 0
     4536       oborot-we                 [kk]    = 0
     4537       oborot-vt                       [kk]    = 0
     4538       oborot-iv                 [kk]    = 0
     4539       oborot-ev                 [kk]    = 0
     4540       oborot-rv             [kk]    = 0
     4541       oborot-em                  [kk]    = 0
     4542       oborot-wm                  [kk]    = 0
     4543       oborot-im                  [kk]    = 0
     4544       oborot-ot                  [kk]    = 0
     4545       oborot-disc                            [kk]    = 0
     4546       oborot-eff                            [kk]    = 0
     4547       oborot-prc                            [kk]    = 0
     4548       oborot-ap            [kk]    = 0
     4549       oborot-pc            [kk]    = 0
     4550       oborot-r-v                                    [kk]    = 0
     4551       ostatok-end      [kk] =   0
     4552       ostatok-start    [kk] =   0   .
     4553          End.
     4554    END PROCEDURE.
     4555   PROCEDURE Item-Goods :
     4556    define input parameter  par-3 as char no-undo.
     4557    define input parameter  par-4 as char no-undo.
     4558    if line-counter( OutStream )  > page-size( OutStream ) then DO :
     4559                    display STREAM OutStream    with frame top-frame .
     4560                    display STREAM OutStream    with frame top-2 .
     4561                    end.
     4562        if par-4 = "goods":U  Then  assign
     4563                   gds-zap-unit-base  = goods.unit-base
     4564                   gds-zap-prt-root   = Goods.prt-root
     4565                   gds-zap-prod-type  = Goods.prod-type
     4566                   gds-zap-prod-code  = Goods.prod-code
     4567                   gds-zap-artic      = Goods.artic
     4568                   gds-zap-type       = Goods.gds-type
     4569                   gds-zap-grp-name   = Goods.grp-name
     4570                   gds-zap-b-code     = Goods.gds-code
     4571                   gds-zap-gds-name   = if g#gds-engl then Goods.engl-name
     4572                                                       else Goods.gds-name.
     4573        if par-4 = "gds-list":U  Then  assign
     4574                     gds-zap-unit-base  = gds-list.unit-base
     4575                     gds-zap-prt-root   = gds-list.prt-root
     4576                     gds-zap-prod-type  = gds-list.prod-type
     4577                     gds-zap-prod-code  = gds-list.prod-code
     4578                     gds-zap-artic      = gds-list.artic
     4579                     gds-zap-type       = gds-list.gds-type
     4580                     gds-zap-grp-name   = gds-list.grp-name
     4581                     gds-zap-b-code     = gds-list.gds-code
     4582                     gds-zap-gds-name   = if g#gds-engl then Gds-list.engl-name
     4583                                                         else Gds-list.gds-name.
     4584     Run foreach  in this-procedure .
     4585   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     4586     (input  gds-zap-b-code
     4587     ,input  ?
     4588     ,output v-bar-code
     4589     )  .
     4590   s-bar-code = string (v-bar-code,"999999999").
     4591       If  break_group = true  and par-3 <> "1"  then DO :
     4592            FIND FIRST clients WHERE clients.obj-type = gds-zap-prod-type AND clients.obj-code = gds-zap-prod-code use-index pi NO-LOCK .
     4593            gds-zap-prod-name  = clients.obj-name.
     4594             If break_group1 = true  THEN  DO :
     4595               if (par-3 = "3"  OR  par-3 = "5" ) and  par-3 <> "6"
     4596                 then DO: Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )         b1-name = gds-zap-grp-name . end.
     4597                 else DO: Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) b1-name = gds-zap-prod-name. end.
     4598               if par-3 = "6"  then  dO:
     4599                  if xTog-obj = true then do:
     4600                    var-vat-pc = func-vat (input gds-zap-b-code , input x-store-type, input x-store-code)
     4601                     .
     4602                   end.
     4603                  else do:
     4604                   var-vat-pc = temp-gds-list.vat-pc .
     4605                   end.
     4606                   assign
     4607                       temp-str = string( "СТАВКА НДС : " + string(var-vat-pc) + "%" )
     4608                       b1-name = temp-str.
     4609                   end.
     4610               if NOT xSumsOnly or (par-3 = "4" Or par-3 = "5" ) THEN DO :
     4611                   fr0 = true .
     4612                   tmp#stroka0 = temp-str.
     4613               End.
     4614             End.
     4615               IF (par-3 = "4"  OR  par-3 = "5")  THEN DO:
     4616                 if par-3 = "4"
     4617                   then Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )          b2-name = gds-zap-grp-name .
     4618                   else Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name )  b2-name = gds-zap-prod-name.
     4619                 if NOT xSumsOnly THEN DO:
     4620                     fr = true .
     4621                 End.
     4622                 break_group1 = false.
     4623               END.
     4624          break_group = false.
     4625       End.
     4626     Run display-line   in this-procedure .
     4627   END PROCEDURE.
