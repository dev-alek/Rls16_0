      804   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      805   procedure cur-time :
      806      define output parameter p-today as date      no-undo .
      807      define output parameter p-time  as integer   no-undo .
      808     do
      809     on error undo, return error
      810     :
      811       define variable v-date1 as date      no-undo .
      812       define variable v-date2 as date      no-undo .
      813       define variable v-time  as integer   no-undo .
      814       assign
      815         v-date1 = today
      816         v-time  = time
      817         v-date2 = today
      818       .
      819       if v-date1 <> v-date2
      820       then do:
      821         assign
      822           v-date1 = today
      823           v-time  = v-time
      824         .
      825       end.
      826       assign
      827         p-today = v-date1
      828         p-time  = v-time
      829       .
      830     end.
      831   end.
      832   function cur-time-date returns character
      833   :
      834     return string(today, '99/99/9999':U) .
      835   end.
      836   function cur-time-mjd returns decimal
      837   :
      838     define variable v-date as date      no-undo .
      839     define variable v-time as integer   no-undo .
      840     run cur-time in this-procedure
      841       (output v-date
      842       ,output v-time
      843       ) .
      844     return integer(v-date) - 2400002 + (v-time / 86400) .
      845   end.
      846   function cur-time-get-ending-index returns integer
      847   (input p-number as integer
      848   )
      849   :
      850     if p-number < 0
      851     or p-number = ?
      852     then do:
      853       return 1 .
      854     end.
      855     define variable v-rest as integer   no-undo .
      856     assign
      857       p-number = p-number modulo 100
      858     .
      859     if p-number < 20
      860     then do:
      861       assign
      862         v-rest = p-number
      863       .
      864     end.
      865     else do:
      866       assign
      867         v-rest = p-number modulo 10
      868       .
      869     end.
      870     case v-rest :
      871       when 1
      872       then do:
      873         return 2 .
      874       end.
      875       when 2 or
      876       when 3 or
      877       when 4
      878       then do:
      879         return 3 .
      880       end.
      881       otherwise do:
      882         return 1 .
      883       end.
      884     end case .
      885   end.
      886   procedure cur-time-mjd-to-date :
      887      define input  parameter i-mjd-diff as decimal no-undo.
      888      define output parameter o-Date     as date    no-undo.
      889      define output parameter o-Time     as integer no-undo.
      890      define variable v-day-number as integer   no-undo .
      891      if    i-mjd-diff < 0
      892         or i-mjd-diff = ?
      893      then do:
      894         return "?" .
      895      end.
      896      assign
      897         v-day-number = truncate(i-mjd-diff,0).
      898         o-Date = date(v-day-number + 2400002).
      899         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      900     .
      901   end.
      902   function cur-time-mjd-to-string returns character
      903   (input p-mjd-diff as decimal
      904   )
      905   :
      906     define variable v-day-number as integer   no-undo .
      907     define variable v-seconds    as integer   no-undo .
      908     define variable v-hour       as integer   no-undo .
      909     define variable v-min        as integer   no-undo .
      910     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      911     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      912     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      913     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      914     if p-mjd-diff < 0
      915     or p-mjd-diff = ?
      916     then do:
      917       return "?" .
      918     end.
      919     assign
      920       v-day-number = integer(truncate(p-mjd-diff,0))
      921       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      922     .
      923     if v-seconds > 86400
      924     then do:
      925       assign
      926         v-seconds = 86400 - 1
      927       .
      928     end.
      929     if v-seconds < 0
      930     then do:
      931       assign
      932         v-seconds = 0
      933       .
      934     end.
      935     assign
      936       v-hour = truncate(v-seconds / 3600, 0)
      937     .
      938     assign
      939       v-seconds = v-seconds modulo 3600
      940     .
      941     assign
      942       v-min = truncate(v-seconds / 60, 0)
      943     .
      944     assign
      945       v-seconds = v-seconds modulo 60
      946     .
      947     return
      948         (if v-day-number <> 0
      949           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      950           else ""
      951         )
      952       + (if v-day-number <> 0 or v-hour <> 0
      953           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      954           else ""
      955         )
      956       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      957           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      958           else ""
      959         )
      960       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      961       .
      962   end.
      963   function cur-time-string returns character
      964   :
      965     define variable v-date as date      no-undo .
      966     define variable v-time as integer   no-undo .
      967     run cur-time in this-procedure
      968       (output v-date
      969       ,output v-time
      970       ) .
      971     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      972   end.
      973   function cur-time-string-sec returns character
      974   :
      975     define variable v-date as date      no-undo .
      976     define variable v-time as integer   no-undo .
      977     run cur-time in this-procedure
      978       (output v-date
      979       ,output v-time
      980       ) .
      981     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      982   end.
      983   function cur-time-custom  returns character
      984   (input p-prefix as character
      985   ,input p-date-format as character
      986   ,input p-delimiter as character
      987   ,input p-time-format as character
      988   ,input p-suffix as character
      989   )
      990   :
      991     define variable v-date as date      no-undo .
      992     define variable v-time as integer   no-undo .
      993     run cur-time in this-procedure
      994       (output v-date
      995       ,output v-time
      996       ) .
      997     return
      998       p-prefix
      999       + string(v-date, p-date-format)
     1000       + p-delimiter
     1001       + string(v-time, p-time-format)
     1002       + p-suffix
     1003       .
     1004   end.
     1005   function cur-time-print  returns character
     1006   :
     1007     define variable v-date as date      no-undo .
     1008     define variable v-time as integer   no-undo .
     1009     run cur-time in this-procedure
     1010       (output v-date
     1011       ,output v-time
     1012       ) .
     1013     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1014   end.
     1015   function cur-time-datetime returns datetime
     1016   :
     1017     define variable v-char as character no-undo .
     1018     define variable v-datetime as datetime no-undo .
     1019     v-char = cur-time-string().
     1020     v-datetime = datetime(v-char).
     1021     return  v-datetime.
     1022   end.
     1023   function cur-time-string-msec returns character
     1024   :
     1025     define variable v-date as datetime  no-undo .
     1026     v-date = now.
     1027     return string(v-date) .
     1028   end.
