     3901     if use-column[13] then C-oborot-we:screen-value          = string( B2-oborot-we         [4])  .
     3902     if use-column[14] then C-oborot-es:screen-value     = string( B2-oborot-es    [4])  .
     3903     if use-column[15] then C-oborot-rs:screen-value = string( B2-oborot-rs[4])  .
     3904     if use-column[16] then C-oborot-re:screen-value      = string( B2-oborot-re     [4])  .
     3905     if use-column[17] then C-oborot-ep:screen-value       = string( B2-oborot-ep      [4])  .
     3906     if use-column[18] then C-oborot-rv:screen-value      = string( B2-oborot-rv     [4])  .
     3907     if use-column[19] then C-oborot-vt:screen-value                = string( B2-oborot-vt               [4])  .
     3908     if use-column[20] then C-oborot-ot:screen-value           = string( B2-oborot-ot          [4])  .
     3909     if use-column[22] then C-ostatok-end:screen-value                            = string( B2-ostatok-end                           [4])  .
     3910     if use-column[25] then C-oborot-ap:screen-value     = string( B2-oborot-ap    [4])  .
     3911     if use-column[26] then C-oborot-pc:screen-value     = string( B2-oborot-pc    [4])  .
     3912     if use-column[27] then C-oborot-r-v:screen-value                      = string( B2-oborot-ee         [4] +
     3913                                                                                            B2-oborot-re     [4] +
     3914                                                                                            B2-oborot-es    [4] +
     3915                                                                                            B2-oborot-rs[4] ).
     3916     DISPLAY stream  OutStream  with FRAME ZAPAS .  DOWN stream   OutStream 1 with FRAME ZAPAS.
     3917     End.
     3918     if NOT xSumsOnly THEN Run u-line  in this-procedure .
     3919   end.
     3920   end.
     3921   END PROCEDURE.
