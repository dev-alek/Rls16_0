     1596     run rep/r-in-ob.p (
     1597      input          x-base-type
     1598    , input          x-base-code
     1599    , input          tprintrubl
     1600    , input-output   c-s-bar-code
     1601    , input-output   c-gds-zap-artic
     1602    , input-output   c-gds-zap-gds-name
     1603    , input-output   c-gds-zap-unit-base
     1604    , input-output   c-gds-type
     1605    , input-output   c-ostatok-start
     1606    , input-output   c-ostatok-end
     1607    , input-output   c-oborot-ie
     1608    , input-output   c-oborot-ee
     1609    , input-output   c-oborot-ep
     1610    , input-output   c-oborot-es
     1611    , input-output   c-oborot-re
     1612    , input-output   c-oborot-rs
     1613    , input-output   c-oborot-we
     1614    , input-output   c-oborot-vt
     1615    , input-output   c-oborot-iv
     1616    , input-output   c-oborot-ev
     1617    , input-output   c-oborot-rv
     1618    , input-output   c-oborot-em
     1619    , input-output   c-oborot-wm
     1620    , input-output   c-oborot-im
     1621    , input-output   c-oborot-ot
     1622    , input-output   c-oborot-pc
     1623    , input-output   c-oborot-ap
     1624    , input-output   c-oborot-disc
     1625    , input-output   c-oborot-eff
     1626    , input-output   c-oborot-prc
     1627    , input-output   c-oborot-r-v
     1628    , input-output   c-str-num
     1629    , input-output   l-col-type
     1630    , input-output   l-col-pos
     1631    , input-output   l-col-len
     1632    , input-output   l-col-format
     1633    , input-output   l-col-lable
     1634     ).
     1635     define variable time-start as integer no-undo .
     1636     Run init-proc in this-procedure .
     1637     if f-flag = false then RETURN .
     1638     Run report-execute   in this-procedure .
     1639   procedure init-proc :
     1640    time-start = time.
     1641   assign
     1642     i               = 0
     1643     xlavel          = xvar-lavel
     1644     Select-Good     = x-SelectGood
     1645     PayType         = x-SET_PAY_TYPE
     1646     RetClassify     = xClassify
     1647     RetSortType     = xSortType
     1648     Sums-Only       = xSumsOnly
     1649     Show-Negativ    = xShowZero
     1650     Show-Negativ-2  = xShowZero-2
     1651     FirstLine       = FALSE
     1652     line            = fill('-', MINIMUM(l-col-pos,189))
     1653     line2            = fill('-', l-col-pos - 1)
     1654     .
     1655     if p-is-petrol = true  then
     1656     assign
     1657       Select-Good  = 4
     1658       x-SelectGood = 4
     1659     .
     1660     if  x-date-end  - x-date-start > 400
     1661         then long-p = true    .
     1662         else  long-p = false     .
     1663     x-SelectObject = "".
     1664     find first ub.gds-grp where  ub.gds-grp.upper-code = 0 no-lock no-error .
     1665     if avail ub.gds-grp then   first-lavel = ub.gds-grp.node-code.
     1666                      else first-lavel = 0.
     1667     ValType         = IF (PayType = 1) Then 0  else x-SET_val_TYPE.
     1668     If (ValType=0 and x-base-code=0)  Or ValType=1
     1669       then assign tPrintRubl = yes .
     1670       else assign tPrintRubl = no .
     1671     run rep/ob-sumtp.p (output table temp#sum-type ).
     1672     Run find-mediator  in this-procedure  ( INPUT v-cntxt-host-code-obj ,input xShowmediator, OUTPUT mediator-host-code, OUTPUT f-flag) .
     1673   end procedure.
     1674   PROCEDURE report-execute :
     1675     Case print-o :
     1676     when "A4-lansc":U then DO:
     1677   output stream OutStream to value( string( session:temp-directory +
     1678                                        "rpt" + string( g#report-num ) ) )
     1679                                        page-size  value(43) .
     1680     end.
     1681     when "A4-port":U then DO:
     1682   output stream OutStream to value( string( session:temp-directory +
     1683                                        "rpt" + string( g#report-num ) ) )
     1684                                        page-size  value(63) .
     1685     end.
     1686     when "A3-lansc":U then DO:
     1687   output stream OutStream to value( string( session:temp-directory +
     1688                                        "rpt" + string( g#report-num ) ) )
     1689                                        page-size  value(63) .
     1690     end.
     1691     OTHERWISE DO:
     1692   output stream OutStream to value( string( session:temp-directory +
     1693                                        "rpt" + string( g#report-num ) ) )
     1694                                        page-size  value(43) .
     1695     end.
     1696     end case.
     1697    define variable gj as integer no-undo init 0.
     1698      if xTog-obj  Then DO:
     1699               FOR each obj-list no-lock:
     1700                   x-store-type = obj-list.obj-type.
     1701                   x-store-code = obj-list.obj-code.
     1702                   gj = gj + 1 .
     1703                   Run report-exec1   in this-procedure .
     1704               End.
     1705              if gj > 1 then DO :
     1706                 run display-bo   in this-procedure .
     1707                 run u-line  in this-procedure .
     1708              End.
     1709             End.
     1710     Else  Run report-exec1   in this-procedure .
     1711     put stream outstream " Время составления отчета " string((time - time-start),"hh:mm:ss" ) .
     1712     HIDE   STREAM OutStream FRAME ZAPAS .
     1713     HIDE   STREAM OutStream FRAME top-Frame .
     1714     Output stream OutStream close.
     1715   if mFrameView
     1716   then do:
     1717      HIDE FRAME InfoFrame.
