     4866   PROCEDURE PRICE-VAT :
     4867   define input parameter PP as character no-undo .
     4868   if pp = '' THEN DO:
     4869   if line-counter( OutStream ) > page-size( OutStream ) then DO: display STREAM OutStream with frame top-frame. end.
     4870   p = p + 1.
     4871   if use-column[5] then  c-gds-type:screen-value          = v-name-type.
     4872   if use-column[6]  then C-ostatok-start:screen-value                          = if x-vat then  string(  ostatok-start  [2]                         ) else  string(  ostatok-start  [2]                        -  ostatok-start  [3]                       )  .
     4873   if use-column[7]  then C-oborot-ie:screen-value          = if x-vat then  string(  oborot-ie [2]          ) else  string(  oborot-ie [2]         -  oborot-ie [3]        )  .
     4874   if use-column[8]  then C-oborot-iv:screen-value          = if x-vat then  string(  oborot-iv [2]          ) else  string(  oborot-iv [2]         -  oborot-iv [3]        )  .
     4875   if use-column[9]  then C-oborot-im:screen-value           = if x-vat then  string(  oborot-im  [2]          ) else  string(  oborot-im  [2]         -  oborot-im  [3]        )  .
     4876   if use-column[10] then C-oborot-ee:screen-value          = if x-vat then  string(  oborot-ee [2]          ) else  string(  oborot-ee [2]         -  oborot-ee [3]        )  .
     4877   if use-column[11] then C-oborot-ev:screen-value          = if x-vat then  string(  oborot-ev [2]          ) else  string(  oborot-ev [2]         -  oborot-ev [3]        )  .
     4878   if use-column[12] then C-oborot-em:screen-value           = if x-vat then  string(  oborot-em  [2]          ) else  string(  oborot-em  [2]         -  oborot-em  [3]        )  .
     4879   if use-column[13] then C-oborot-we:screen-value          = if x-vat then  string(  oborot-we         [2]  ) else  string(  oborot-we         [2] -  oborot-we         [3])  .
     4880   if use-column[14] then C-oborot-es:screen-value     = if x-vat then  string(  oborot-es    [2]  ) else  string(  oborot-es    [2] -  oborot-es    [3])  .
     4881   if use-column[15] then C-oborot-rs:screen-value = if x-vat then  string(  oborot-rs[2]  ) else  string(  oborot-rs[2] -  oborot-rs[3])  .
     4882   if use-column[16] then C-oborot-re:screen-value      = if x-vat then  string(  oborot-re     [2]  ) else  string(  oborot-re     [2] -  oborot-re     [3])  .
     4883   if use-column[17] then C-oborot-ep:screen-value       = if x-vat then  string(  oborot-ep      [2]  ) else  string(  oborot-ep      [2] -  oborot-ep      [3])  .
     4884   if use-column[18] then C-oborot-rv:screen-value      = if x-vat then  string(  oborot-rv     [2]  ) else  string(  oborot-rv     [2] -  oborot-rv     [3])  .
     4885   if use-column[19] then C-oborot-vt:screen-value                = if x-vat then  string(  oborot-vt               [2]  ) else  string(  oborot-vt               [2] -  oborot-vt               [3])  .
     4886   if use-column[20] then C-oborot-ot:screen-value           = if x-vat then  string(  oborot-ot          [2]  ) else  string(  oborot-ot          [2] -  oborot-ot          [3])  .
     4887   if use-column[22] then C-ostatok-end:screen-value                            = if x-vat then  string(  ostatok-end                           [2]  ) else  string(  ostatok-end                           [2] -  ostatok-end                           [3])  .
     4888   if use-column[25] then C-oborot-ap:screen-value     = if x-vat then  string(  oborot-ap    [2])   else  string(  oborot-ap [2]    -  oborot-ap [3]   )  .
     4889   if use-column[26] then C-oborot-pc:screen-value     = if x-vat then  string(  oborot-pc    [2])   else  string(  oborot-pc [2]    -  oborot-pc [3]   )  .
     4890   if use-column[27] then C-oborot-r-v:screen-value                             = if x-vat then  string(
     4891                                                                                            oborot-ee         [2] +
     4892                                                                                            oborot-re     [2] +
     4893                                                                                            oborot-es    [2] +
     4894                                                                                            oborot-rs[2]
     4895                                                                                           )
     4896                                                                                            else  string(
     4897                                                                                          ( oborot-ee         [2] +
     4898                                                                                            oborot-re     [2] +
     4899                                                                                            oborot-es    [2] +
     4900                                                                                            oborot-rs[2]) -
     4901                                                                                          ( oborot-ee         [3] +
     4902                                                                                            oborot-re     [3] +
     4903                                                                                            oborot-es    [3] +
     4904                                                                                            oborot-rs[3] )
     4905                                                                                            ).
     4906   DISPLAY stream OutStream with FRAME ZAPAS.  DOWN stream   OutStream 1 with FRAME ZAPAS.
     4907      End.
     4908   run PRICE-VAT-1 (pp).
     4909   END PROCEDURE.
