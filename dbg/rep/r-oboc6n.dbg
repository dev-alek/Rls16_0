     1343   define variable v-button-stop as logical no-undo .
     1344   define variable v-kol-spice as integer no-undo .
     1345   define variable v-kol-spice2 as integer no-undo .
     1346   define variable v-kol-spice3 as integer no-undo .
     1347   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1348   DEFINE BUTTON StopBtn AUTO-END-KEY
     1349        LABEL "Стоп"
     1350        SIZE 10 BY 1.
     1351   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1352        LABEL "Обработано записей"
     1353         VIEW-AS TEXT
     1354        SIZE 14 BY .67 NO-UNDO.
     1355   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1356         VIEW-AS TEXT
     1357        SIZE 53.25 BY .67
     1358        FGCOLOR 1  NO-UNDO.
     1359   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1360         VIEW-AS TEXT
     1361        SIZE 53.25 BY .67
     1362        FGCOLOR 1  NO-UNDO.
     1363   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1364         VIEW-AS TEXT
     1365        SIZE 53.25 BY .67
     1366        FGCOLOR 1  NO-UNDO.
     1367   DEFINE RECTANGLE RECT-1
     1368        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1369        SIZE 55.13 BY 4.46.
     1370   DEFINE FRAME InfoFrame
     1371        StopBtn AT ROW 4.25 COL 21.75
     1372        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1373        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1374        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1375        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1376        RECT-1 AT ROW 1 COL 1
     1377       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1378            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1379            TITLE "Процесс"
     1380            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1381   define variable mFrameView      as logical   no-undo init yes.
     1382     define variable mFramHandle as handle no-undo.
     1383     mFramHandle = frame InfoFrame:handle.
     1384     if  log-manager:logfile-name ne ?
     1385     then DO:
     1386         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1387         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1388         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1389     end.
     1390     mFrameView = not session:batch-mode and mFramHandle:visible.
     1391     if mFrameView
     1392     then do:
     1393       ASSIGN
     1394          FRAME InfoFrame:HIDDEN                           = TRUE
     1395          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1396     end.
     1397   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1398   DO:
     1399     IF not StopProcessing THEN
     1400       Message "Вы действительно хотите прервать" SKIP
     1401               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1402                 UPDATE StopProcessing.
     1403     IF StopProcessing THEN do:
     1404        if mFrameView
     1405        then do:
     1406           HIDE FRAME InfoFrame.
     1407        end.
     1408     End.
     1409   END.
     1410   assign v-account = ( if integer( 25 ) = 0 then 100 else integer( 25 ) ).
     1411     if  log-manager:logfile-name ne ?
     1412     then DO:
     1413         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1414     end.
     1415     if not session:batch-mode then
     1416     do:
     1417       VIEW FRAME InfoFrame.
     1418       mFrameView = true.
     1419     end.
     1420      v-button-stop = false .
     1421         if mFrameView
     1422         then do:
     1423         if v-button-stop then view STOPBTN in frame InfoFrame.
     1424                          else Hide STOPBTN in frame InfoFrame.
     1425         end.
     1426   IF ( i modulo v-account = 0 )  then DO:
     1427    Assign
     1428       v-kol-spice = (50 - LENGTH('Оборотная ведомость по всем типам')) / 2
     1429       RecordsString = fill(' ',v-kol-spice) + string('Оборотная ведомость по всем типам')
     1430       .
     1431    Assign
     1432       v-kol-spice = (50 - LENGTH(objname)) / 2
     1433       RecordsString2 = fill(' ',v-kol-spice) + string(objname)
     1434       .
     1435             if  log-manager:logfile-name ne ?
     1436             then DO:
     1437                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     1438             end.
     1439              if mFrameView
     1440              then do:
     1441               DISPLAY
     1442                 i @ RecordsDone
     1443                 RecordsString   @ RecordsString
     1444                 RecordsString2  @ RecordsString2
     1445                 WITH FRAME InfoFrame.
     1446              end.
     1447   End.
     1448      if v-button-stop then  DO:
     1449            if mFrameView
     1450            then
     1451               PROCESS EVENTS.
     1452            IF StopProcessing THEN DO:
     1453            RETURN error.
     1454            End.
     1455      end.
