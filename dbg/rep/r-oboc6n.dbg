     2206   PROCEDURE display-line :
     2207     i = i + 1.
     2208      IF NOT  (NOT Show-Negativ   AND Null-Str#  = 0  ) then DO:
     2209         IF NOT  (NOT Show-Negativ-2 AND Null-Str2# = 0  ) then DO:
     2210           new-page = PAGE-NUMBER( OutStream).
     2211           If old-page <> new-page then p = 0.
     2212           IF NOT Sums-Only then  do:
     2213               if fr0 = true then do:
     2214                 PUT stream  OutStream  tmp#stroka0 format "X(100)" SKIP.
     2215                 fr0 = false .
     2216               end.
     2217               if fr = true then dO:
     2218                 PUT stream OutStream space(6) temp-str format "X(100)" SKIP.
     2219                 fr = false .
     2220               end.
     2221               Run Display-str1  in this-procedure .
     2222               end.
     2223         End.
     2224       END.
     2225       old-page = new-page.
     2226   END PROCEDURE.
     2227   PROCEDURE print-header :
     2228   if NOT FirstLine Then  Run Display-Title  in this-procedure .
     2229       FirstLine = TRUE .
     2230       if xTog-obj and   x-SelectObject <> "currency":U   Then  DO:
     2231             PUT stream  OutStream  UNFORMATTED
     2232             string(  "ПО ОБЪЕКТУ : (" + x-store-type  + string(x-store-code)  +  ") " + ObjName)
     2233             AT 30 format "X(170)" SKIP.
     2234             End.
     2235             FORM with FRAME ZAPAS .   DOWN stream   OutStream 1 with FRAME ZAPAS .
     2236         RUN Clear-B1  in this-procedure .
     2237         RUN Clear-B2  in this-procedure .
     2238         RUN Clear-Bi  in this-procedure .
     2239         break_group = true.
     2240         break_group1 = true.
     2241         display STREAM OutStream     with frame top-Frame .
     2242         display STREAM OutStream     with frame top-2 .
     2243   END PROCEDURE.
     2244   PROCEDURE Print-Footer :
     2245         If RetClassify = "no-classify":U  then Run U-line  in this-procedure .
     2246          gds-zap-artic = "ИТОГО" .
     2247          Run display-BI  in this-procedure .
     2248          Run U-line  in this-procedure .
     2249          END PROCEDURE.
     2250   PROCEDURE U-LINE :
     2251           PUT stream  OutStream  UNFORMATTED  line2 SKIP.
     2252   END PROCEDURE.
     2253   PROCEDURE P-LINE :
     2254           END PROCEDURE.
     2255   PROCEDURE CalcItog :
     2256       run ostatok   in this-procedure (
     2257           input x-store-code  ,
     2258           input x-store-type  , x-TOG-Shift,
     2259           input x-date-start - 1 ,
     2260           input date('')      , x-Shift-Start,x-Shift-End,
     2261           input 'crsa':U   ,
     2262           input '##,##':U,
     2263           input xTog-obj ,
     2264           output  Quantity1  ,
     2265           output  Coast_R1   ,
     2266           output  Coast_V1   ,
     2267           output  VAT_R1     ,
     2268           output  VAT_V1     ,
     2269           output  Fact-order-1 ).
     2270       run ostatok   in this-procedure (
     2271           input x-store-code  ,
     2272           input x-store-type  , x-TOG-Shift,
     2273           input x-date-start  ,
     2274           input x-date-end    , x-Shift-Start,x-Shift-End,
     2275           input 'crsa':U   ,
     2276           input '##,##':U,
     2277           input xTog-obj ,
     2278           output  Quantity1  ,
     2279           output  Coast_R1   ,
     2280           output  Coast_V1   ,
     2281           output  VAT_R1     ,
     2282           output  VAT_V1     ,
     2283           output  Fact-order-2 ).
     2284             Quantity1  = 0.
     2285             Coast_R1   = 0.
     2286             Coast_V1   = 0.
     2287             VAT_R1     = 0.
     2288             VAT_V1     = 0.
     2289   END PROCEDURE.
     2290   PROCEDURE display-str1  :
     2291     assign
     2292       v-gds-num = v-gds-num + 1
     2293     .
     2294    if line-counter( OutStream )  > page-size( OutStream ) then DO : display STREAM OutStream    with frame top-frame. end.
     2295     p = p + 1.
     2296     if use-column[28] then c-str-num:screen-value           =  string( v-gds-num ) .
     2297     if use-column[1] then  c-s-bar-code:screen-value        = s-bar-code.
     2298     if use-column[2] then  c-gds-zap-artic:screen-value     = gds-zap-artic.
     2299     if use-column[3] then  c-gds-zap-gds-name:screen-value  = gds-zap-gds-name.
     2300     if use-column[4] then  c-gds-zap-unit-base:screen-value = gds-zap-unit-base.
     2301     if use-column[5] then  c-gds-type:screen-value          = "кол-во"   .
     2302     if use-column[21] then C-oborot-disc:screen-value  = string(  oborot-disc [1]) .
     2303     if use-column[23] then C-oborot-eff:screen-value  = string(  oborot-eff [1]) .
     2304     if use-column[24] then C-oborot-prc:screen-value  = string(  oborot-prc [1]) .
     2305     if use-column[6]  then C-ostatok-start:screen-value                          = string(  ostatok-start  [1])                         .
     2306     if use-column[7]  then C-oborot-ie:screen-value          = string(  oborot-ie [1]        )  .
     2307     if use-column[8]  then C-oborot-iv:screen-value          = string(  oborot-iv [1]        )  .
