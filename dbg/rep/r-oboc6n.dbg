     5982   PROCEDURE ob-line-stk  :
     5983   define input  parameter x-store-code     like ub.clients.obj-code      no-undo.
     5984   define input  parameter x-store-type     like ub.clients.obj-type      no-undo.
     5985   define INPUT  parameter x-artic          like ub.stk-line.artic        no-undo.
     5986   define INPUT  parameter x-prod-code      like ub.stk-line.prod-code    no-undo.
     5987   define INPUT  parameter x-prod-type      like ub.stk-line.prod-type    no-undo.
     5988   define INPUT  parameter x-Fact-order-1   like ub.stk-line.Fact-order   no-undo.
     5989   define INPUT  parameter x-Fact-order-2   like ub.stk-line.Fact-order   no-undo.
     5990   define input  parameter x-sum-type       like ub.stk-line.sum-type     no-undo.
     5991   define input  parameter x-cat-id         like ub.stk-line.cat-id       no-undo.
     5992   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type  no-undo.
     5993   define input  parameter xTog-obj         as log                     no-undo.
     5994   define input  parameter xi               as int                     no-undo.
     5995   define output  parameter Quntity         like ub.stk-line.fact-qnty   no-undo.
     5996   define output  parameter sum             like ub.stk-line.sum-base    no-undo.
     5997   define output  parameter vat             like ub.stk-line.sum-base    no-undo.
     5998   define output  parameter slt             like ub.stk-line.sum-base    no-undo.
     5999   define output  parameter disc            like ub.stk-line.sum-base    no-undo.
     6000   define variable  First-qnty   like ub.stk-line.fact-qnty   no-undo.
     6001   define variable  Second-qnty  like ub.stk-line.fact-qnty   no-undo.
     6002   define variable  First-sum   like ub.stk-line.sum-base   no-undo.
     6003   define variable  Second-sum  like ub.stk-line.sum-base   no-undo.
     6004   define variable  First-vat   like ub.stk-line.sum-base   no-undo.
     6005   define variable  Second-vat  like ub.stk-line.sum-base   no-undo.
     6006   define variable  First-slt   like ub.stk-line.sum-base   no-undo.
     6007   define variable  Second-slt  like ub.stk-line.sum-base   no-undo.
     6008   define variable  First-disc   like ub.stk-line.sum-base   no-undo.
     6009   define variable  Second-disc  like ub.stk-line.sum-base   no-undo.
     6010   define buffer stk-line2 for ub.stk-line .
     6011   if x-Fact-order-2 < x-Fact-order-1 Then x-Fact-order-2 = x-Fact-order-1.
     6012    Assign
     6013      First-qnty  = 0
     6014      Second-qnty = 0
     6015      Quntity     = 0
     6016      First-sum  = 0
     6017      Second-sum = 0
     6018      sum        = 0
     6019      First-vat  = 0
     6020      Second-vat = 0
     6021      vat        = 0
     6022      First-slt   = 0
     6023      Second-slt  = 0
     6024      slt         = 0
     6025      First-disc  = 0
     6026      Second-disc = 0
     6027      disc        = 0
     6028     .
     6029     For each obj-list  no-lock :
     6030      if  xTog-obj THEN
     6031          if   NOT(    x-store-type     = obj-list.obj-type
     6032               AND    x-store-code      = obj-list.obj-code ) Then NEXT.
     6033      FOR each temp#sum-type where temp#sum-type.xi = xi no-lock :
     6034         find last ub.stk-line no-lock
     6035           where ub.stk-line.obj-type   = obj-list.obj-type
     6036             and ub.stk-line.obj-code   = obj-list.obj-code
     6037             and ub.stk-line.artic      = x-artic
     6038             and ub.stk-line.prod-type  = x-prod-type
     6039             and ub.stk-line.prod-code  = x-prod-code
     6040             and ub.stk-line.sum-type   = temp#sum-type.sum-type
     6041             and ub.stk-line.cat-id     = '##,##':U
     6042             and ub.stk-line.fact-order <= x-fact-order-1
     6043           use-index category
     6044           no-error .
     6045         if available ub.stk-line then do:
     6046           assign
     6047             First-qnty = First-qnty + ub.stk-line.fact-qnty
     6048             First-sum  = First-sum  + (if tprintrubl then ub.stk-line.sum-rubl   else ub.stk-line.sum-base  )
     6049             First-vat  = First-vat  + (if tprintrubl then ub.stk-line.vat-rubl   else ub.stk-line.vat-base  )
     6050             First-disc = First-disc + (if tprintrubl then ub.stk-line.other-rubl else ub.stk-line.other-base )
     6051             First-slt  = First-slt  + (if tprintrubl then ub.stk-line.slt-rubl   else ub.stk-line.slt-base   )
     6052           .
     6053         end.
     6054         find last stk-line2 no-lock
     6055           where stk-line2.obj-code   = obj-list.obj-code
     6056             and stk-line2.obj-type   = obj-list.obj-type
     6057             and stk-line2.artic      = x-artic
     6058             and stk-line2.prod-type  = x-prod-type
     6059             and stk-line2.prod-code  = x-prod-code
     6060             and stk-line2.sum-type   = temp#sum-type.sum-type
     6061             and stk-line2.cat-id     = '##,##':U
     6062             and stk-line2.fact-order <= x-fact-order-2
     6063           use-index category
     6064           no-error .
     6065         if available stk-line2 then do:
     6066           assign
     6067             Second-qnty = Second-qnty + Stk-line2.fact-qnty
     6068             Second-sum  = Second-sum  + (if tprintrubl then stk-line2.sum-rubl else stk-line2.sum-base    )
     6069             Second-vat  = Second-vat  + (if tprintrubl then stk-line2.vat-rubl else stk-line2.vat-base    )
     6070             second-disc = second-disc + (if tprintrubl then stk-line2.other-rubl else stk-line2.other-base )
     6071             second-slt  = second-slt  + (if tprintrubl then stk-line2.slt-rubl   else stk-line2.slt-base   )
     6072           .
     6073         end.
     6074      end.
     6075    end.
     6076    Assign
     6077      Quntity = Second-qnty - first-qnty
     6078      sum     = Second-sum  - first-sum
     6079      vat     = Second-vat  - first-vat
     6080      slt     = Second-slt  - first-slt
     6081      disc    = Second-disc  - first-disc
     6082      .
     6083   END PROCEDURE.
     6084   procedure create-pul:
     6085   end procedure.
     6086   procedure calc-ms-wt :
     6087   define input        parameter p-oborot-num      as decimal   no-undo .
     6088   define input        parameter p-gds-wt-ms-base  as decimal   no-undo .
     6089   define input-output parameter p-oborot          as decimal   no-undo .
     6090   define input-output parameter p-bi-oborot       as decimal   no-undo .
     6091   define input-output parameter p-bo-oborot       as decimal   no-undo .
     6092   define input-output parameter p-b1-oborot       as decimal   no-undo .
     6093   define input-output parameter p-b2-oborot       as decimal   no-undo .
     6094   do
     6095   on error undo, return error return-value
     6096   :
     6097   if p-is-petrol = true then return .
     6098     assign
     6099       p-oborot    = p-oborot-num * p-gds-wt-ms-base
     6100       p-bi-oborot = p-bi-oborot + p-oborot
     6101       p-bo-oborot = p-bo-oborot + p-oborot
     6102       p-b1-oborot = p-b1-oborot + p-oborot
     6103       p-b2-oborot = p-b2-oborot + p-oborot
     6104     .
     6105   end.
     6106   end procedure.
     6107   procedure calc-pt-ob :
     6108   define input  parameter p-ext-doc-type  as character no-undo .
     6109   define input  parameter x-store-type as character no-undo .
     6110   define input  parameter x-store-code as integer   no-undo .
     6111   define input  parameter p-artic         as character no-undo .
     6112   define input  parameter p-prod-type     as character no-undo .
     6113   define input  parameter p-prod-code     as integer   no-undo .
     6114   define input-output parameter p-oborot          as decimal   no-undo .
     6115   define input-output parameter p-bi-oborot       as decimal   no-undo .
     6116   define input-output parameter p-bo-oborot       as decimal   no-undo .
     6117   define input-output parameter p-b1-oborot       as decimal   no-undo .
     6118   define input-output parameter p-b2-oborot       as decimal   no-undo .
     6119     do
     6120     on error undo, return error return-value
     6121     :
     6122   define variable v-oborot as decimal   no-undo .
     6123   define buffer buf_inv-line for ub.inv-line  .
     6124   define buffer buf_doc-line for ub.doc-line  .
     6125   define buffer buf1_obj-list for obj-list .
     6126   v-oborot = 0 .
     6127   if p-is-petrol = false   then return .
     6128     for each buf1_obj-list no-lock :
     6129      if  xtog-obj then
     6130          if   not(x-store-type     = buf1_obj-list.obj-type
     6131               and x-store-code     = buf1_obj-list.obj-code ) then next.
     6132       for each buf_doc-line  no-lock where
     6133             buf_doc-line.obj-type     = buf1_obj-list.obj-type and
     6134             buf_doc-line.obj-code     = buf1_obj-list.obj-code and
     6135             buf_doc-line.artic        = p-artic and
     6136             buf_doc-line.prod-type    = p-prod-type and
     6137             buf_doc-line.prod-code    = p-prod-code and
     6138             buf_doc-line.ext-doc-type = p-ext-doc-type and
     6139             buf_doc-line.status_      = 'факт':U        and
     6140             buf_doc-line.fact-order   <= fact-order-2  and
     6141             buf_doc-line.fact-order   >= fact-order-1
     6142             :
     6143             for each buf_inv-line no-lock where
     6144                     buf_inv-line.doc-code  =  buf_doc-line.doc-code  and
     6145                     buf_inv-line.artic     =  buf_doc-line.artic     and
     6146                     buf_inv-line.prod-type =  buf_doc-line.prod-type and
     6147                     buf_inv-line.prod-code =  buf_doc-line.prod-code
     6148                     :
     6149                     if p-ext-doc-type = 'vt':U  then v-oborot = v-oborot + buf_doc-line.cli-qnty .
     6150                         else do:
     6151                         if p-ext-doc-type = 'we':U    or
     6152                            p-ext-doc-type = 'ee':U    or
     6153                            p-ext-doc-type = 'ev':U    or
     6154                            p-ext-doc-type = 'ep':U or
     6155                            p-ext-doc-type = 'em':U     or
     6156                            p-ext-doc-type = 'wm':U     or
     6157                            p-ext-doc-type = 'es':U   then
     6158                              v-oborot = v-oborot - buf_inv-line.wast-cli-qnty .
     6159                              else v-oborot = v-oborot + buf_inv-line.wast-cli-qnty .
     6160                         end.
     6161             end.
     6162       end.
     6163       assign
     6164         p-oborot    = v-oborot
     6165         p-bi-oborot = p-bi-oborot + p-oborot
     6166         p-bo-oborot = p-bo-oborot + p-oborot
     6167         p-b1-oborot = p-b1-oborot + p-oborot
     6168         p-b2-oborot = p-b2-oborot + p-oborot
     6169       .
     6170   end.
     6171   end.
     6172   end procedure.
