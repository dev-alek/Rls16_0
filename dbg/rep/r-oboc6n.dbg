     1719     DELETE WIDGET-POOL "My-pool".
     1720      define variable v-user-action as character no-undo .
     1721      define variable v-printed as logical   no-undo .
     1722      define variable DisabledOptions as integer   no-undo .
     1723     Case print-o :
     1724     when "A4-lansc":U then DO:
     1725         DisabledOptions = 8 .
     1726        end.
     1727     when "A4-port":U then DO:
     1728         DisabledOptions = 0 .
     1729        end.
     1730     when "A3-lansc":U then DO:
     1731         DisabledOptions = 8 .
     1732                         end.
     1733     OTHERWISE DO:
     1734         DisabledOptions = 1 .
     1735         end.
     1736      End case.
     1737      run gbl/prnfilen.w
     1738        (input  ""
     1739        ,input  DisabledOptions
     1740        ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     1741        ,input  7
     1742        ,output v-user-action
     1743        ,output v-printed
     1744        ) .
     1745   END PROCEDURE.
     1746   PROCEDURE foreach :
