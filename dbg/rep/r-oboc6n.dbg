     5010   p = p + 1.
     5011   if use-column[1] then  c-s-bar-code:screen-value        = ''.
     5012   if use-column[2] then  c-gds-zap-artic:screen-value     = ''.
     5013   if use-column[3] then  c-gds-zap-gds-name:screen-value  = ''.
     5014   if use-column[4] then  c-gds-zap-unit-base:screen-value = ''.
     5015   if use-column[5] then  c-gds-type:screen-value          = v-name-type.
     5016   if use-column[6]  then C-ostatok-start:screen-value                          = if x-vat then  string( B1-ostatok-start  [2]                         ) else  string( B1-ostatok-start  [2]                        - B1-ostatok-start  [3]                       )  .
     5017   if use-column[7]  then C-oborot-ie:screen-value          = if x-vat then  string( B1-oborot-ie [2]          ) else  string( B1-oborot-ie [2]         - B1-oborot-ie [3]        )  .
     5018   if use-column[8]  then C-oborot-iv:screen-value          = if x-vat then  string( B1-oborot-iv [2]          ) else  string( B1-oborot-iv [2]         - B1-oborot-iv [3]        )  .
     5019   if use-column[9]  then C-oborot-im:screen-value           = if x-vat then  string( B1-oborot-im  [2]          ) else  string( B1-oborot-im  [2]         - B1-oborot-im  [3]        )  .
     5020   if use-column[10] then C-oborot-ee:screen-value          = if x-vat then  string( B1-oborot-ee [2]          ) else  string( B1-oborot-ee [2]         - B1-oborot-ee [3]        )  .
     5021   if use-column[11] then C-oborot-ev:screen-value          = if x-vat then  string( B1-oborot-ev [2]          ) else  string( B1-oborot-ev [2]         - B1-oborot-ev [3]        )  .
     5022   if use-column[12] then C-oborot-em:screen-value           = if x-vat then  string( B1-oborot-em  [2]          ) else  string( B1-oborot-em  [2]         - B1-oborot-em  [3]        )  .
     5023   if use-column[13] then C-oborot-we:screen-value          = if x-vat then  string( B1-oborot-we         [2]  ) else  string( B1-oborot-we         [2] - B1-oborot-we         [3])  .
     5024   if use-column[14] then C-oborot-es:screen-value     = if x-vat then  string( B1-oborot-es    [2]  ) else  string( B1-oborot-es    [2] - B1-oborot-es    [3])  .
     5025   if use-column[15] then C-oborot-rs:screen-value = if x-vat then  string( B1-oborot-rs[2]  ) else  string( B1-oborot-rs[2] - B1-oborot-rs[3])  .
     5026   if use-column[16] then C-oborot-re:screen-value      = if x-vat then  string( B1-oborot-re     [2]  ) else  string( B1-oborot-re     [2] - B1-oborot-re     [3])  .
     5027   if use-column[17] then C-oborot-ep:screen-value       = if x-vat then  string( B1-oborot-ep      [2]  ) else  string( B1-oborot-ep      [2] - B1-oborot-ep      [3])  .
     5028   if use-column[18] then C-oborot-rv:screen-value      = if x-vat then  string( B1-oborot-rv     [2]  ) else  string( B1-oborot-rv     [2] - B1-oborot-rv     [3])  .
     5029   if use-column[19] then C-oborot-vt:screen-value                = if x-vat then  string( B1-oborot-vt               [2]  ) else  string( B1-oborot-vt               [2] - B1-oborot-vt               [3])  .
     5030   if use-column[20] then C-oborot-ot:screen-value           = if x-vat then  string( B1-oborot-ot          [2]  ) else  string( B1-oborot-ot          [2] - B1-oborot-ot          [3])  .
     5031   if use-column[22] then C-ostatok-end:screen-value                            = if x-vat then  string( B1-ostatok-end                           [2]  ) else  string( B1-ostatok-end                           [2] - B1-ostatok-end                           [3])  .
     5032   if use-column[25] then C-oborot-ap:screen-value     = if x-vat then  string( B1-oborot-ap    [2])   else  string( B1-oborot-ap [2]    - B1-oborot-ap [3]   )  .
     5033   if use-column[26] then C-oborot-pc:screen-value     = if x-vat then  string( B1-oborot-pc    [2])   else  string( B1-oborot-pc [2]    - B1-oborot-pc [3]   )  .
     5034   if use-column[27] then C-oborot-r-v:screen-value                             = if x-vat then  string(
     5035                                                                                           B1-oborot-ee         [2] +
     5036                                                                                           B1-oborot-re     [2] +
     5037                                                                                           B1-oborot-es    [2] +
     5038                                                                                           B1-oborot-rs[2]
     5039                                                                                           )
     5040                                                                                            else  string(
     5041                                                                                          (B1-oborot-ee         [2] +
     5042                                                                                           B1-oborot-re     [2] +
     5043                                                                                           B1-oborot-es    [2] +
     5044                                                                                           B1-oborot-rs[2]) -
     5045                                                                                          (B1-oborot-ee         [3] +
     5046                                                                                           B1-oborot-re     [3] +
     5047                                                                                           B1-oborot-es    [3] +
     5048                                                                                           B1-oborot-rs[3] )
     5049                                                                                            ).
     5050   DISPLAY stream OutStream with FRAME ZAPAS.  DOWN stream   OutStream 1 with FRAME ZAPAS.
     5051     End.
     5052   run PRICE-VAT-4(pp).
     5053   END PROCEDURE.
     5054   PROCEDURE PRICE-VAT-4 :
     5055   define input parameter PP as character no-undo .
     5056   if pp =   'B2' THEN DO:
     5057   if line-counter( OutStream ) > page-size( OutStream ) then DO: display STREAM OutStream with frame top-frame. end.
     5058   p = p + 1.
     5059   if use-column[1] then  c-s-bar-code:screen-value        = ''.
     5060   if use-column[2] then  c-gds-zap-artic:screen-value     = ''.
     5061   if use-column[3] then  c-gds-zap-gds-name:screen-value  = ''.
     5062   if use-column[4] then  c-gds-zap-unit-base:screen-value = ''.
     5063   if use-column[5] then  c-gds-type:screen-value          = v-name-type.
     5064   if use-column[6]  then C-ostatok-start:screen-value                          = if x-vat then  string( B2-ostatok-start  [2]                         ) else  string( B2-ostatok-start  [2]                        - B2-ostatok-start  [3]                       )  .
     5065   if use-column[7]  then C-oborot-ie:screen-value          = if x-vat then  string( B2-oborot-ie [2]          ) else  string( B2-oborot-ie [2]         - B2-oborot-ie [3]        )  .
     5066   if use-column[8]  then C-oborot-iv:screen-value          = if x-vat then  string( B2-oborot-iv [2]          ) else  string( B2-oborot-iv [2]         - B2-oborot-iv [3]        )  .
     5067   if use-column[9]  then C-oborot-im:screen-value           = if x-vat then  string( B2-oborot-im  [2]          ) else  string( B2-oborot-im  [2]         - B2-oborot-im  [3]        )  .
     5068   if use-column[10] then C-oborot-ee:screen-value          = if x-vat then  string( B2-oborot-ee [2]          ) else  string( B2-oborot-ee [2]         - B2-oborot-ee [3]        )  .
     5069   if use-column[11] then C-oborot-ev:screen-value          = if x-vat then  string( B2-oborot-ev [2]          ) else  string( B2-oborot-ev [2]         - B2-oborot-ev [3]        )  .
     5070   if use-column[12] then C-oborot-em:screen-value           = if x-vat then  string( B2-oborot-em  [2]          ) else  string( B2-oborot-em  [2]         - B2-oborot-em  [3]        )  .
     5071   if use-column[13] then C-oborot-we:screen-value          = if x-vat then  string( B2-oborot-we         [2]  ) else  string( B2-oborot-we         [2] - B2-oborot-we         [3])  .
     5072   if use-column[14] then C-oborot-es:screen-value     = if x-vat then  string( B2-oborot-es    [2]  ) else  string( B2-oborot-es    [2] - B2-oborot-es    [3])  .
     5073   if use-column[15] then C-oborot-rs:screen-value = if x-vat then  string( B2-oborot-rs[2]  ) else  string( B2-oborot-rs[2] - B2-oborot-rs[3])  .
     5074   if use-column[16] then C-oborot-re:screen-value      = if x-vat then  string( B2-oborot-re     [2]  ) else  string( B2-oborot-re     [2] - B2-oborot-re     [3])  .
     5075   if use-column[17] then C-oborot-ep:screen-value       = if x-vat then  string( B2-oborot-ep      [2]  ) else  string( B2-oborot-ep      [2] - B2-oborot-ep      [3])  .
     5076   if use-column[18] then C-oborot-rv:screen-value      = if x-vat then  string( B2-oborot-rv     [2]  ) else  string( B2-oborot-rv     [2] - B2-oborot-rv     [3])  .
     5077   if use-column[19] then C-oborot-vt:screen-value                = if x-vat then  string( B2-oborot-vt               [2]  ) else  string( B2-oborot-vt               [2] - B2-oborot-vt               [3])  .
     5078   if use-column[20] then C-oborot-ot:screen-value           = if x-vat then  string( B2-oborot-ot          [2]  ) else  string( B2-oborot-ot          [2] - B2-oborot-ot          [3])  .
     5079   if use-column[22] then C-ostatok-end:screen-value                            = if x-vat then  string( B2-ostatok-end                           [2]  ) else  string( B2-ostatok-end                           [2] - B2-ostatok-end                           [3])  .
     5080   if use-column[25] then C-oborot-ap:screen-value     = if x-vat then  string( B2-oborot-ap    [2])   else  string( B2-oborot-ap [2]    - B2-oborot-ap [3]   )  .
     5081   if use-column[26] then C-oborot-pc:screen-value     = if x-vat then  string( B2-oborot-pc    [2])   else  string( B2-oborot-pc [2]    - B2-oborot-pc [3]   )  .
     5082   if use-column[27] then C-oborot-r-v:screen-value                             = if x-vat then  string(
     5083                                                                                           B2-oborot-ee         [2] +
     5084                                                                                           B2-oborot-re     [2] +
     5085                                                                                           B2-oborot-es    [2] +
     5086                                                                                           B2-oborot-rs[2]
     5087                                                                                           )
     5088                                                                                            else  string(
     5089                                                                                          (B2-oborot-ee         [2] +
     5090                                                                                           B2-oborot-re     [2] +
     5091                                                                                           B2-oborot-es    [2] +
     5092                                                                                           B2-oborot-rs[2]) -
     5093                                                                                          (B2-oborot-ee         [3] +
     5094                                                                                           B2-oborot-re     [3] +
     5095                                                                                           B2-oborot-es    [3] +
     5096                                                                                           B2-oborot-rs[3] )
     5097                                                                                            ).
     5098   DISPLAY stream OutStream with FRAME ZAPAS.  DOWN stream   OutStream 1 with FRAME ZAPAS.
     5099   End.
     5100   END PROCEDURE.
     5101   procedure pp :
     5102   define input parameter ll as integer no-undo .
     5103   define input parameter uu as integer no-undo .
     5104   define input parameter ff as character no-undo .
     5105   End procedure.
     5106   procedure find-last-prise-med :
     5107   define input parameter p-artic     like ub.goods.artic no-undo .
     5108   define input parameter p-prod-type like ub.goods.prod-type no-undo .
     5109   define input parameter p-prod-code like ub.goods.prod-code no-undo .
     5110   define input parameter p-host-code like ub.gds-obj.host-code no-undo .
     5111   define output parameter  p-price   like ub.gds-obj.last-base no-undo .
     5112   define buffer p-gds-obj   for  ub.gds-obj .
     5113   define buffer buf_trn-doc for  ub.trn-doc .
     5114   define variable v-fact-order as decimal no-undo .
     5115   p-price = 0 .
     5116     define variable v-in-date as date      no-undo .
     5117     define variable fl as logical no-undo .
     5118     fl = yes.
     5119     v-fact-order = 0 .
     5120     for each tt-obj-list no-lock break by tt-obj-list.obj-type by tt-obj-list.obj-code
     5121     :
     5122       find first p-gds-obj no-lock
     5123         where p-gds-obj.artic     = p-artic         and
     5124                 p-gds-obj.prod-type = p-prod-type     and
     5125                 p-gds-obj.prod-code = p-prod-code     and
     5126                 p-gds-obj.obj-code  = tt-obj-list.obj-code and
     5127                 p-gds-obj.obj-type  = tt-obj-list.obj-type
     5128         no-error .
     5129       if available p-gds-obj then do:
     5130       if p-gds-obj.in-date = ?  then next .
     5131       if fl = yes then do:
     5132         assign
     5133           v-in-date = p-gds-obj.in-date
     5134           p-price   =  if tPrintRubl then  p-gds-obj.last-rubl else  p-gds-obj.last-base
     5135           fl = no
     5136       .
     5137        find first buf_trn-doc no-lock  where buf_trn-doc.doc-code = p-gds-obj.in-code no-error  .
     5138        if available buf_trn-doc  then  v-fact-order = buf_trn-doc.fact-order .
     5139       end.
     5140         if p-gds-obj.in-date >= v-in-date   then do:
     5141            if p-gds-obj.in-date = v-in-date then do:
     5142               find first buf_trn-doc no-lock  where buf_trn-doc.doc-code = p-gds-obj.in-code no-error .
     5143               if available buf_trn-doc  then
     5144                   if buf_trn-doc.fact-order >  v-fact-order   then do:
     5145                     assign
     5146                       v-fact-order = buf_trn-doc.fact-order
     5147                       p-price   =  if tPrintRubl then  p-gds-obj.last-rubl else  p-gds-obj.last-base
     5148                       v-in-date =   p-gds-obj.in-date
     5149                     .
     5150                   end.
     5151            end.
     5152            else do:
     5153             find first buf_trn-doc no-lock  where buf_trn-doc.doc-code = p-gds-obj.in-code no-error .
     5154             if available buf_trn-doc  then
     5155                 assign
     5156                   p-price   =    if tPrintRubl then  p-gds-obj.last-rubl else  p-gds-obj.last-base
     5157                   v-in-date =    p-gds-obj.in-date
     5158                   v-fact-order = buf_trn-doc.fact-order .
     5159                 .
     5160             end.
     5161           if p-price = ? then   p-price  = 0 .
     5162         end.
     5163       end.
     5164     End .
     5165     if p-price = ? then   p-price  = 0 .
     5166   end procedure.
     5167   procedure find-mediator :
     5168   define input  parameter c-host-code as integer no-undo .
     5169   define input  parameter p-Showmediatr as logical no-undo .
     5170   define output parameter p-host-code as integer no-undo .
     5171   define output parameter p-flag as logical no-undo .
     5172   define buffer b-sysconf  for ub.sysconf.
     5173    p-host-code = 0 .
     5174    p-flag  = true .
     5175       if p-Showmediatr = true then do:
     5176       find first ub.sysconf where ub.sysconf.avrg-price = true no-lock no-error .
     5177             if avail ub.sysconf then DO :
     5178               p-host-code = ub.sysconf.host-code.
     5179               if tPrintRubl = false then do:
     5180                     find first b-sysconf where b-sysconf.host-code = c-host-code no-lock no-error .
     5181                           if  ub.sysconf.base-code <> b-sysconf.base-code then DO:
     5182                                 p-flag  = false  .
     5183                                 message "Базовая валюта посредника и базовая валюта текущей фирмы не совпадает . Нельзя получить отчет в валюте !"
     5184                                 view-as alert-box error.
     5185                           end.
     5186               end.
     5187             end.
     5188             for each ub.shop no-lock where ub.shop.host-code = p-host-code :
     5189                 create tt-obj-list no-error .
     5190                 assign tt-obj-list.obj-type = 'маг':U
     5191                        tt-obj-list.obj-code = ub.shop.obj-code no-error .
     5192             end.
     5193             for each ub.store no-lock where ub.store.host-code = p-host-code :
     5194                 create tt-obj-list no-error .
     5195                 assign tt-obj-list.obj-type = 'скл':U
     5196                        tt-obj-list.obj-code = ub.store.obj-code no-error .
     5197             end.
     5198       End.
     5199    End procedure .
     5200   procedure ost-line :
     5201     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     5202     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     5203     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     5204     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     5205     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     5206     define input  parameter x-tog-shift  as logical no-undo .
     5207     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     5208     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     5209     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     5210     define input  parameter xtog-obj     as logical no-undo .
     5211     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     5212     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     5213     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     5214     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     5215     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     5216     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     5217     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     5218     define buffer buff-obj-list  for obj-list .
     5219     define buffer buff-stk-line  for ub.stk-line .
     5220     assign
     5221       Quantity = 0
     5222       Coast_R  = 0
     5223       Coast_V  = 0
     5224       VAT_R    = 0
     5225       VAT_V    = 0
     5226       SLT_R    = 0
     5227       SLT_V    = 0
     5228     .
     5229     if  x-tog-shift = false then do:
     5230       for each buff-obj-list no-lock
     5231       on error undo, return error
     5232       :
     5233         find last buff-stk-line no-lock
     5234           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     5235             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     5236             and buff-stk-line.artic      = x-artic
     5237             and buff-stk-line.prod-type  = x-prod-type
     5238             and buff-stk-line.prod-code  = x-prod-code
     5239             and buff-stk-line.sum-type   = x-sum-type
     5240             and buff-stk-line.cat-id     = '##,##':U
     5241             and buff-stk-line.fact-order <= x-fact-order
     5242             and buff-stk-line.shift-num  = 0
     5243           use-index category
     5244           no-error .
     5245         if available buff-stk-line then do:
     5246           assign
     5247             Quantity = Quantity +  buff-stk-line.fact-qnty
     5248             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     5249             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     5250             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     5251             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     5252             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     5253             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     5254           .
     5255         end.
     5256       end.
     5257     end.
     5258     else do:
     5259       for each buff-obj-list no-lock
     5260         where xtog-obj = false
     5261            or (buff-obj-list.obj-type = x-store-type
     5262               and buff-obj-list.obj-code = x-store-code
     5263               )
     5264       on error undo, return error
     5265       :
     5266         find last buff-stk-line no-lock
     5267           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     5268             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     5269             and buff-stk-line.artic      = x-artic
     5270             and buff-stk-line.prod-type  = x-prod-type
     5271             and buff-stk-line.prod-code  = x-prod-code
     5272             and buff-stk-line.sum-type   = x-sum-type
     5273             and buff-stk-line.cat-id     = '##,##':U
     5274             and buff-stk-line.fact-order <= x-fact-order
     5275             and buff-stk-line.shift-num  > 0
     5276           use-index category
     5277           no-error .
     5278         if available buff-stk-line then do:
     5279           assign
     5280             Quantity = Quantity +  buff-stk-line.fact-qnty
     5281             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     5282             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     5283             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     5284             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     5285             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     5286             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     5287           .
     5288         end.
     5289       end.
     5290     end.
     5291   end procedure.
     5292   procedure ost-lineother-tax :
     5293     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     5294     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     5295     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     5296     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     5297     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     5298     define input  parameter x-tog-shift  as logical no-undo .
     5299     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     5300     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     5301     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     5302     define input  parameter xTog-obj     as logical no-undo .
     5303     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     5304     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     5305     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     5306     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     5307     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     5308     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     5309     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     5310     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     5311     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     5312     define buffer buff-obj-list  for obj-list .
     5313     define buffer buff-stk-line  for ub.stk-line .
     5314     assign
     5315       Quantity = 0
     5316       Coast_R  = 0
     5317       Coast_V  = 0
     5318       VAT_R    = 0
     5319       VAT_V    = 0
     5320       SLT_R    = 0
     5321       SLT_V    = 0
     5322       other_R  = 0
     5323       other_V  = 0
     5324     .
     5325     if  x-tog-shift = false then do:
     5326       for each buff-obj-list no-lock
     5327       on error undo, return error
     5328       :
     5329         find last buff-stk-line no-lock
     5330           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     5331             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     5332             and buff-stk-line.artic      = x-artic
     5333             and buff-stk-line.prod-type  = x-prod-type
     5334             and buff-stk-line.prod-code  = x-prod-code
     5335             and buff-stk-line.sum-type   = x-sum-type
     5336             and buff-stk-line.cat-id     = '##,##':U
     5337             and buff-stk-line.fact-order <= x-fact-order
     5338             and buff-stk-line.shift-num  = 0
     5339           use-index category
     5340           no-error .
     5341         if available buff-stk-line then do:
     5342           assign
     5343             Quantity = Quantity +  buff-stk-line.fact-qnty
     5344             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     5345             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     5346             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     5347             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     5348             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     5349             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     5350             other_R  = other_R  +  buff-stk-line.other-rubl
     5351             other_V  = other_V  +  buff-stk-line.other-base
     5352           .
     5353         end.
     5354       end.
     5355     end.
     5356     else do:
     5357       for each buff-obj-list no-lock
     5358         where xtog-obj = false
     5359            or (buff-obj-list.obj-type = x-store-type
     5360               and buff-obj-list.obj-code = x-store-code
     5361               )
     5362       on error undo, return error
     5363       :
     5364         find last buff-stk-line no-lock
     5365           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     5366             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     5367             and buff-stk-line.artic      = x-artic
     5368             and buff-stk-line.prod-type  = x-prod-type
     5369             and buff-stk-line.prod-code  = x-prod-code
     5370             and buff-stk-line.sum-type   = x-sum-type
     5371             and buff-stk-line.cat-id     = '##,##':U
     5372             and buff-stk-line.fact-order <= x-fact-order
     5373             and buff-stk-line.shift-num  > 0
     5374           use-index category
     5375           no-error .
     5376         if available buff-stk-line then do:
     5377           assign
     5378             Quantity = Quantity +  buff-stk-line.fact-qnty
     5379             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     5380             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     5381             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     5382             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     5383             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     5384             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     5385             other_R = other_R   +  buff-stk-line.other-rubl
     5386             other_V = other_V   +  buff-stk-line.other-base
     5387           .
     5388         end.
     5389       end.
     5390     end.
     5391   end procedure.
     5392   procedure ost-line-kg :
     5393     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     5394     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     5395     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     5396     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     5397     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     5398     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     5399     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     5400     define buffer buff-obj-list  for obj-list .
     5401     define buffer buf_doc-line for ub.doc-line .
     5402     define buffer buf_inv-line for ub.inv-line .
     5403     do
     5404     on error undo, return error
     5405     :
     5406       for each buf_doc-line no-lock where
     5407                buf_doc-line.obj-type    = p-obj-type   and
     5408                buf_doc-line.obj-code    = p-obj-code   and
     5409                buf_doc-line.prod-type   = p-prod-type  and
     5410                buf_doc-line.prod-code   = p-prod-code  and
     5411                buf_doc-line.artic       = p-artic      and
     5412                buf_doc-line.status_     = 'факт':U      and
     5413                buf_doc-line.fact-order <= p-fact-order
     5414             by buf_doc-line.fact-order    descending
     5415       :
     5416         find first buf_inv-line no-lock where
     5417                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     5418                    buf_inv-line.artic     = buf_doc-line.artic     and
     5419                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     5420                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     5421         if available buf_inv-line
     5422         then do:
     5423           if buf_inv-line.after-cli-qnty <> ?
     5424           then do:
     5425             assign
     5426               p-quantity-kg = buf_inv-line.after-cli-qnty
     5427             .
     5428             leave .
     5429           end.
     5430         end.
     5431       end.
     5432       if p-quantity-kg = ?
     5433       then do:
     5434         assign
     5435           p-quantity-kg = 0
     5436         .
     5437       end.
     5438     end.
     5439   end procedure.
     5440   PROCEDURE ostatok :
     5441   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     5442   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     5443   def input parameter x-tog-shift   as   logical             no-undo.
     5444   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     5445   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     5446   def input parameter x-shift-start as integer               no-undo.
     5447   def input parameter x-shift-end   as integer               no-undo.
     5448   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     5449   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     5450   def input parameter xTog-obj   as log no-undo.
     5451   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     5452   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     5453   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     5454   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     5455   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     5456   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     5457   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     5458   def var              Fact-orderS   as char  no-undo.
     5459   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     5460      Assign
     5461         Fact-order   = 0
     5462         Quantity     = 0
     5463         Coast_R      = 0
     5464         Coast_V      = 0
     5465         VAT_R        = 0
     5466         VAT_V        = 0 .
     5467    x-date-start-t  = x-date-start + 1 .
     5468   IF x-date-end = date('') then DO:
     5469      Fact-order = 0 .
     5470      for each obj-list
     5471          where  ( not xtog-obj or
     5472                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     5473                 no-lock :
     5474         if  x-tog-shift = false then do:
     5475                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     5476                               ub.stk-tot.Fact-date <=  x-date-start
     5477                               and ub.stk-tot.shift-num = 0
     5478                               USE-INDEX fact-date no-lock no-error .
     5479              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     5480         End.
     5481         Else  DO :
     5482             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     5483              (ub.stk-tot.shift-date  = x-date-start-t and
     5484               ub.stk-tot.shift-num  < x-shift-start or
     5485               ub.stk-tot.shift-date  < x-date-start-t  )
     5486               and ub.stk-tot.shift-num  > 0
     5487               USE-INDEX Shift-num no-lock no-error .
     5488            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     5489           END.
     5490       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     5491     End.
     5492   End.
     5493   Else DO:
     5494     For each obj-list  WHERE
     5495        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     5496         no-lock :
     5497      IF  x-TOG-Shift = False Then DO:
     5498          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     5499               ub.stk-tot.Fact-date <= x-date-end
     5500               and ub.stk-tot.shift-num = 0
     5501               USE-INDEX fact-date no-lock no-error.
     5502          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     5503      END.
     5504      Else DO:
     5505           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     5506               (ub.stk-tot.shift-date  = x-date-end and
     5507               ub.stk-tot.shift-num  <= x-shift-end or
     5508               ub.stk-tot.shift-date  < x-date-end       ) and
     5509               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     5510               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     5511       End.
     5512       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     5513     End.
     5514   End.
     5515   END PROCEDURE.
     5516   procedure run7 :
     5517     case select-good:
     5518       when 1  then do:
     5519   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5520   IF x-SelectObject = "currency":U  OR  xTog-obj then do :
     5521   define variable first-l17 as logical   no-undo .
     5522     first-l17 = true .
     5523     for each gds-obj
     5524       where gds-obj.obj-type = x-store-type
     5525         and gds-obj.obj-code = x-store-code
     5526             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     5527             no-lock,
     5528         first goods  where  goods.gds-code = gds-obj.gds-code
     5529         no-lock
     5530         break by func-vat (input gds-obj.gds-code , input x-store-type, input x-store-code)
     5531               by (temp-gds-list.gds-code)
     5532               :
     5533         var-vat-pc = func-vat ( input gds-obj.gds-code, input x-store-type, input x-store-code) .
     5534         if last-vat <> var-vat-pc then do:
     5535             if not first-l17 then do:
     5536               Assign
     5537                   s-bar-code    = ""
     5538                   gds-zap-artic = "        Итого по "
     5539                   gds-zap-gds-name = b1-name
     5540                   .
     5541                 run display-b1.
     5542                 run clear-b1  .
     5543             end.
     5544             Assign
     5545               first-l17 = false
     5546               break_group = true
     5547               break_group1 = true
     5548               .
     5549             end.
     5550         first-l17 = false .
     5551         run item-goods ( "6" , "goods" ) .
     5552         last-vat = func-vat (input gds-obj.gds-code , input x-store-type, input x-store-code) .
     5553      end.
     5554       Assign
     5555           s-bar-code   = ""
     5556           gds-zap-artic = "        Итого по "
     5557           gds-zap-gds-name = b1-name
     5558           .
     5559         run display-b1.
     5560         run clear-b1.
     5561   end.
     5562   else do:
     5563      For each obj-list no-lock :
     5564                     FOR EACH gds-obj where
     5565                         gds-obj.obj-type = obj-list.obj-type    and
     5566                         gds-obj.obj-code = obj-list.obj-code
     5567                         and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     5568                         no-lock :
     5569                         find first temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code no-error .
     5570                         if not available temp-gds-list then do:
     5571                             find first goods no-lock  where goods.gds-code  = gds-obj.gds-code .
     5572                             Create temp-gds-list.
     5573   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5574   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     5575     (input  gds-obj.gds-code
     5576     ,input  '1':U
     5577     ,input  ?
     5578     ,input  v-cntxt-host-code-obj
     5579     ,input  gds-obj.obj-type
     5580     ,input  gds-obj.obj-code
     5581     ,output var-vat-pc
     5582     ) no-error .
     5583                             Assign
     5584                               temp-gds-list.prod-code = gds-obj.prod-code
     5585                               temp-gds-list.grp-name  = gds-obj.grp-name
     5586                               temp-gds-list.gds-name  = goods.gds-name
     5587                               temp-gds-list.gds-code  = gds-obj.gds-code
     5588                               temp-gds-list.artic     = gds-obj.artic
     5589                               temp-gds-list.vat-pc    = var-vat-pc
     5590                             .
     5591                         End.
     5592                         else do:
     5593                         if temp-gds-list.vat-pc = 0 or temp-gds-list.vat-pc = ? then do:
     5594   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5595   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     5596     (input  gds-obj.gds-code
     5597     ,input  '1':U
     5598     ,input  ?
     5599     ,input  v-cntxt-host-code-obj
     5600     ,input  gds-obj.obj-type
     5601     ,input  gds-obj.obj-code
     5602     ,output var-vat-pc
     5603     ) no-error .
     5604                               Assign
     5605                                 temp-gds-list.vat-pc    = var-vat-pc
     5606                               .
     5607                         end.
     5608                         end.
     5609               End.
     5610     End.
     5611     for each temp-gds-list no-lock
     5612       , First goods     where goods.gds-code  = temp-gds-list.gds-code no-lock
     5613         BREAK BY temp-gds-list.vat-pc  BY temp-gds-list.gds-code :
     5614       run item-goods ( "6" , "goods" ) .
     5615         if return-value <> "" then NEXT.
     5616           If Last-of(temp-gds-list.vat-pc) Then Do:
     5617           If String(Entry(2,"temp-gds-list.vat-pc",".")) = "Grp-name"
     5618             Then  Assign
     5619                     S-bar-code   = " Итого по "
     5620                     Gds-zap-artic = Substring(
     5621                                         B1-name
     5622                                         ,1,16)
     5623                     Gds-zap-gds-name = Substring(
     5624                                         B1-name
     5625                                         ,17,40)
     5626                                   .
     5627             Else  Assign
     5628                     S-bar-code   = ""
     5629                     Gds-zap-artic = "        Итого по "
     5630                     Gds-zap-gds-name =  B1-name
     5631                                   .
     5632               Run Display-b1 In This-procedure .
     5633               Run Clear-b1 In This-procedure .
     5634               Assign Break_Group = True.
     5635           End.
     5636     End.
     5637   End.
     5638     end.
     5639       when 2  then do:
     5640   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5641   if x-selectobject = "currency":u  or  xtog-obj then do :
     5642   define variable first-l20 as logical   no-undo .
     5643     first-l20 = true .
     5644         for  each gds-obj where
     5645                   gds-obj.obj-code   = x-store-code and
     5646                   gds-obj.obj-type   = x-store-type
     5647                   and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     5648                   no-lock ,
     5649         first  tmp#grp  where gds-obj.grp-name   begins tmp#grp.grp-name   no-lock ,
     5650         first goods       where gds-obj.gds-code   = goods.gds-code  no-lock
     5651         break by func-vat (input gds-obj.gds-code , input x-store-type, input x-store-code)
     5652               by (temp-gds-list.gds-code)
     5653               :
     5654         var-vat-pc = func-vat ( input gds-obj.gds-code, input x-store-type, input x-store-code) .
     5655         if last-vat <> var-vat-pc then do:
     5656             if not first-l20 then do:
     5657               Assign
     5658                   s-bar-code    = ""
     5659                   gds-zap-artic = "        Итого по "
     5660                   gds-zap-gds-name = b1-name
     5661                   .
     5662                 run display-b1.
     5663                 run clear-b1  .
     5664             end.
     5665             Assign
     5666               first-l20 = false
     5667               break_group = true
     5668               break_group1 = true
     5669               .
     5670             end.
     5671         first-l20 = false .
     5672         run item-goods ( "6" , "goods" ) .
     5673         last-vat = func-vat (input gds-obj.gds-code , input x-store-type, input x-store-code) .
     5674      end.
