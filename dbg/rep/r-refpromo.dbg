      803   define  stream PrnLibStream.
      804   procedure prn-lib-prn-file :
      805     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      806     define input parameter p-DIsabledoptions as integer no-undo .
      807     define variable v-report-name as character no-undo .
      808     define variable v-user-action as character no-undo .
      809     define variable v-printed     as logical   no-undo .
      810     define variable v-exist       as logical   no-undo .
      811     do
      812       on error undo, return error
      813       :
      814       run prn-lib-get-report-name  in this-procedure (
      815         input parParentProc
      816         ,output v-report-name
      817         ).
      818   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      819   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      820     (input  v-report-name
      821     ,input  2
      822     ,output v-exist
      823     )  .
      824       if NOT v-exist then
      825       DO:
      826         Message
      827           "Нет заданий на печать ! "
      828           view-as alert-box .
      829         Return  .
      830       End.
      831       run gbl/prnfilen.w
      832         (input  ""
      833         ,input  p-DisabledOptions
      834         ,input  string(v-report-name )
      835         ,input  7
      836         ,output v-user-action
      837         ,output v-printed
      838         ) .
      839       if v-printed then
      840       do:
      841         return "YES" .
      842       end.
      843       else
      844       do:
      845         return "NO" .
      846       end.
      847     end.
      848   end procedure.
      849   procedure prn-lib-open-stream :
      850     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      851     define input parameter p-page-size    as integer no-undo .
      852     define input parameter p-is-stream    as logical no-undo .
      853     define input parameter p-append       as logical no-undo .
      854     define variable v-report-name as character no-undo .
      855     do
      856       on error undo, return error
      857       :
      858       run prn-lib-get-report-name  in this-procedure (
      859         input parParentProc
      860         ,output v-report-name
      861         ).
      862       if p-is-stream then
      863       do:
      864         if p-append then
      865         do:
      866           output stream PrnLibStream to value( v-report-name )
      867             page-size value(p-page-size) append .
      868         end.
      869         if not p-append then
      870         do:
      871           output stream PrnLibStream to value( v-report-name )
      872             page-size value(p-page-size) .
      873         end.
      874       end.
      875       if not p-is-stream then
      876       do:
      877         if p-append then
      878         do:
      879           output to value( v-report-name )
      880             page-size value(p-page-size) append .
      881         end.
      882         if not p-append then
      883         do:
      884           output to value( v-report-name )
      885             page-size value(p-page-size) .
      886         end.
      887       end.
      888     end.
      889   end procedure.
      890   procedure prn-lib-open-exp :
      891     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      892     define input parameter p-is-stream    as logical no-undo .
      893     define input parameter p-is-append    as logical no-undo .
      894     define output parameter p-ReportFileName as char init "report" no-undo.
      895     define output parameter p-process as logical no-undo .
      896     define variable glog as logical no-undo .
      897     do
      898       on error undo, return error
      899       :
      900       SYSTEM-DIALOG GET-FILE p-ReportFileName
      901         TITLE      "Укажите путь"
      902         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      903         ASK-OVERWRITE
      904         CREATE-TEST-FILE
      905         SAVE-AS
      906         USE-FILENAME
      907         DEFAULT-EXTENSION "txt"
      908         UPDATE glog
      909         .
      910       if not glog then  return.
      911       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      912       if p-is-stream then
      913       do:
      914         if p-is-append then
      915         do:
      916           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      917         end.
      918         else
      919         do:
      920           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      921         end.
      922       end.
      923       else
      924       do:
      925         if p-is-append then
      926         do:
      927           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      928         end.
      929         else
      930         do:
      931           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      932         end.
      933       end.
      934       p-process = yes.
      935     end.
      936   end procedure.
      937   procedure prn-lib-get-report-name :
      938     define input parameter parParentProc  as widget-handle no-undo.
      939     define output parameter p-report-name as character no-undo .
      940     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      941   end procedure.
      942   procedure prn-lib-reportviewer-report-name :
      943     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      944     define input parameter p-report-name-html as character no-undo .
      945     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      946   end procedure.
      947   procedure prn-lib-reportviewer :
      948     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      949     define input parameter p-report-name-html as character no-undo .
      950     define input parameter p-param        as character no-undo .
      951     define variable v-excel           as character no-undo init 'TRUE' .
      952     define variable v-value-character as character no-undo .
      953     define variable v-value-integer   as character no-undo .
      954     define variable v-value-date      as date      no-undo .
      955     define variable v-value-decimal   as decimal   no-undo .
      956     define variable rep-excel         as logical   no-undo .
      957     define variable excel-string      as character no-undo .
      958     define variable v-param-type      as character no-undo .
      959     define variable v-tth             as handle    no-undo .
      960     run adm/shattri.p (
      961       input "get":U
      962       ,input  ""
      963       ,input  0
      964       ,input  'report-glob':U
      965       ,input  'rep-excel':U
      966       ,output v-value-character
      967       ,output v-value-date
      968       ,output v-value-decimal
      969       ,output v-value-integer
      970       ,output rep-excel
      971       ,output v-param-type
      972       ,INPUT-OUTPUT table-handle v-tth
      973       )  .
      974     if rep-excel then v-excel = "TRUE" .
      975     else v-excel = "FALSE" .
      976     if p-param eq ""
      977     then
      978        p-param = "EXCEL:" + v-excel.
      979     else
      980        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      981     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      982   end procedure.
      983   function fnc-convert-dot-to-colon returns character
      984       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
      985   function fnc-convert-dot-to-colon returns character
      986   (input p-data as decimal, input p-accur as character, input p-num as integer):
      987       define variable result as character no-undo.
      988       define variable v-str-result as character no-undo.
      989       if p-data = ? then p-data = 0 .
      990       p-data = round(p-data, p-num).
      991       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
      992       return v-str-result.
      993   END FUNCTION.
