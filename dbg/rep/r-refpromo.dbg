     2132   procedure report-body:
     2133       for each tt-info where can-do(vLstSts,tt-info.sts):
     2134           put stream OutStr-html unformatted
     2135               '<TR>' skip
     2136               '<TD text_wrap="true" style="text-align: center;">' + tt-info.obj-name + '</TD>'  skip
     2137               '<TD text_wrap="true" style="text-align: center;">' + string(tt-info.b-code) + '</TD>' skip
     2138               '<TD text_wrap="true" style="text-align: center;">' + tt-info.gds-name + '</TD>' skip
     2139               '<TD text_wrap="true" style="text-align: center;">' + if tt-info.src-price <> 0 then fnc-convert-dot-to-colon(tt-info.src-price,"->>>>>>>>>>>9.99",2) + '</TD>' else "0" + '</TD>' skip
     2140               '<TD text_wrap="true" style="text-align: center;">' + "№" + string(tt-info.shift-num) + " " + string(tt-info.shift-date)  + '</TD>' skip
     2141               '<TD text_wrap="true" style="text-align: center;">' + string(tt-info.chk-date)  + '</TD>' skip
     2142               '<TD text_wrap="true" style="text-align: center;">' + string(tt-info.chk-num)  + '</TD>' skip
     2143               '<TD text_wrap="true" style="text-align: center;">' + tt-info.cashier  + '</TD>' skip
     2144               '<TD text_wrap="true" style="text-align: center;">' + if tt-info.src-qnty <> 0 then fnc-convert-dot-to-colon((tt-info.src-qnty),"->>>>>>>>>>>9.99",2) + '</TD>' else "0.00" + '</TD>' skip
     2145               '<TD text_wrap="true" style="text-align: center;">' + if tt-info.src-sum <> 0 then fnc-convert-dot-to-colon(tt-info.src-sum,"->>>>>>>>>>>9.99",2) + '</TD>' else "0.00" + '</TD>' skip
     2146               '<TD text_wrap="true" style="text-align: center;">' + if tt-info.src-sum-no-disc <> 0 then fnc-convert-dot-to-colon(tt-info.src-sum-no-disc,"->>>>>>>>>>>9.99",2) + '</TD>' else "0.00" + '</TD>' skip
     2147               '<TD text_wrap="true" style="text-align: center;">' + if tt-info.src-sum-disc <> 0 then fnc-convert-dot-to-colon(tt-info.src-sum-disc,"->>>>>>>>>>>9.99",2) + '</TD>' else "0.00" + '</TD>' skip
     2148               .
     2149           if tt-info.ret-doc-code <> "" then
     2150           put stream OutStr-html unformatted
     2151               '<TD text_wrap="true" style="text-align: center;">' + "№" + string(tt-info.ret-shift-num) + " " + string(tt-info.ret-shift-date)  + '</TD>' skip
     2152               '<TD text_wrap="true" style="text-align: center;">' + string(tt-info.ret-chk-date)  + '</TD>' skip
     2153               '<TD text_wrap="true" style="text-align: center;">' + string(tt-info.ret-chk-num)   + '</TD>' skip
     2154               '<TD text_wrap="true" style="text-align: center;">' + tt-info.ret-cashier  + '</TD>' skip
     2155               '<TD text_wrap="true" style="text-align: center;">' + if (tt-info.ret-src-qnty +  + tt-info.ret-promo-qnty) <> 0 then fnc-convert-dot-to-colon((tt-info.ret-src-qnty + tt-info.ret-promo-qnty),"->>>>>>>>>>>9.99",2) + '</TD>' else "0.00" + '</TD>' skip
     2156               '<TD text_wrap="true" style="text-align: center;">' + if tt-info.ret-src-sum <> 0 then fnc-convert-dot-to-colon(tt-info.ret-src-sum,"->>>>>>>>>>>9.99",2) + '</TD>' else "0.00" + '</TD>' skip
     2157               .
     2158           else
     2159           put stream OutStr-html unformatted
     2160               '<TD text_wrap="true" style="text-align: center;">' + "-" + '</TD>' skip
     2161               '<TD text_wrap="true" style="text-align: center;">' + "-" + '</TD>' skip
     2162               '<TD text_wrap="true" style="text-align: center;">' + "-" + '</TD>' skip
     2163               '<TD text_wrap="true" style="text-align: center;">' + "-" + '</TD>' skip
     2164               '<TD text_wrap="true" style="text-align: center;">' + "-" + '</TD>' skip
     2165               '<TD text_wrap="true" style="text-align: center;">' + "-" + '</TD>' skip
     2166               .
     2167           put stream OutStr-html unformatted
     2168               '<TD text_wrap="true" style="text-align: center;">' + tt-info.promo-id + (if tt-info.ext-code > "" then (" / " + tt-info.ext-code) else "") + '</TD>' skip
     2169               '<TD text_wrap="true" style="text-align: center;">' + tt-info.nameAction  + '</TD>' skip
     2170               '<TD text_wrap="true" style="text-align: center;">' + if tt-info.itog-qnty <> 0 then fnc-convert-dot-to-colon(tt-info.itog-qnty,"->>>>>>>>>>>9.99",2) + '</TD>' else "0.00" + '</TD>' skip
     2171               '<TD text_wrap="true" style="text-align: center;">' + if tt-info.itog-sum-no-disc <> 0 then fnc-convert-dot-to-colon(tt-info.itog-sum-no-disc,"->>>>>>>>>>>9.99",2) + '</TD>' else "0.00" + '</TD>' skip
     2172               '<TD text_wrap="true" style="text-align: center;">' + if tt-info.itog-sum <> 0 then fnc-convert-dot-to-colon(tt-info.itog-sum,"->>>>>>>>>>>9.99",2) + '</TD>' else "0.00" + '</TD>' skip
     2173               '<TD text_wrap="true" style="text-align: center;">' + if tt-info.itog-sum-disc <> 0 then fnc-convert-dot-to-colon(tt-info.itog-sum-disc,"->>>>>>>>>>>9.99",2) + '</TD>' else "0.00" + '</TD>' skip
     2174               '<TD text_wrap="true" style="text-align: center;">' + if tt-info.itog-proc <> 0 then fnc-convert-dot-to-colon(tt-info.itog-proc,"->>>>>>>>>>>9.99",2) + '</TD>' else "0.00" + '</TD>' skip
     2175               '<TD text_wrap="true" style="text-align: center;">' + tt-info.sts  + '</TD>' skip
     2176               '<TD text_wrap="true" style="text-align: center;">' + tt-info.change-BL  + '</TD>' skip
     2177               '</TR>'
     2178               skip .
     2179       end.
     2180   end procedure.
     2181   procedure clients-write:
     2182      DEFINE input PARAMETER   p-obj-code      as integer      no-undo .
     2183      DEFINE INPUT PARAMETER   p-obj-type      as character    no-undo .
     2184      DEFINE OUTPUT PARAMETER  p-obj-name      as character    no-undo .
     2185      define buffer buf_clients for ub.clients .
     2186      find first buf_clients no-lock where buf_clients.obj-code = p-obj-code
     2187         and buf_clients.obj-type = p-obj-type no-error .
     2188      if AVAILABLE buf_clients then
     2189      do:
     2190         p-obj-name = buf_clients.obj-name .
     2191      end.
     2192   end.
     2193   procedure ConvertStr-chk-type:
     2194      define input parameter p-chk-type as character no-undo.
     2195      define output parameter p-name-chk-type as character no-undo.
     2196      define variable v-num-element as integer no-undo.
     2197      v-num-element = lookup(p-chk-type, '1,6,8,69,96,14,15,16,36,17,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,43,44':U).
     2198      p-name-chk-type = entry(v-num-element, 'Продажа,Возврат,Аннуляция,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,РазблТрнзкц,ТехПролив,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,_Продажа,_Возврат,_Аннуляция,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_Инвентаризация,_Z-отчет,_РазблТрнзкц,_Закрытие_смены,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Приход_Корр,Расход_Корр':U).
     2199      if p-chk-type <> "" and v-num-element = 0 then
     2200      do:
     2201         message "Ошибка 115." view-as alert-box.
     2202         return.
     2203      end.
     2204   end procedure.
     2205   procedure ConvertStr-pay-type:
     2206      define input parameter p-pay-code as integer no-undo.
     2207      define output parameter p-name-pay-type as character no-undo.
     2208      find first ub.cash-pay no-lock where ub.cash-pay.cdpay-code = p-pay-code and ub.cash-pay.status_ = 'тек':U no-error .
     2209      if available (ub.cash-pay) then p-name-pay-type = ub.cash-pay.obj-name .
     2210   end procedure.
