     1017   define new global shared variable g#lib-trn4 as handle no-undo .
     1018   function ChkGdsPromo returns logical
     1019       (input iDocCode as character)
     1020       :
     1021       define buffer buf_chk-gds for ub.chk-gds.
     1022       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     1023       define variable vPromo as logical no-undo.
     1024       vPromo = no.
     1025       cspr:
     1026       for each buf_chk-gds no-lock where
     1027                    buf_chk-gds.doc-code = iDocCode,
     1028              first buf_chk-gds-attr no-lock where
     1029                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     1030                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     1031                and buf_chk-gds-attr.attr-code = "CSPromo"
     1032                and buf_chk-gds-attr.attr-value <> "0":
     1033          vPromo = yes.
     1034          leave cspr.
     1035       end.
     1036       return vPromo.
     1037   end.
     1038   function ChkPromoLine returns logical
     1039       (input iDocCode as character,
     1040       input iLineNum as integer)
     1041       :
     1042       define buffer buf_chk-gds for ub.chk-gds.
     1043       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     1044       define variable vPromo as logical no-undo.
     1045       vPromo = no.
     1046       find first buf_chk-gds-attr no-lock where
     1047                    buf_chk-gds-attr.doc-code = iDocCode
     1048                and buf_chk-gds-attr.line-num  = iLineNum
     1049                and buf_chk-gds-attr.attr-code = "CSPromo"
     1050                and buf_chk-gds-attr.attr-value <> "0"
     1051       no-error.
     1052       if avail buf_chk-gds-attr then vPromo = yes.
     1053       return vPromo.
     1054   end.
     1055   function ChkPromoSum returns decimal
     1056       (input iDocCode as character,
     1057        input iLineNum as integer)
     1058       :
     1059      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     1060      define variable vSumPromo as decimal no-undo.
     1061      find first buf_chk-gds-attr no-lock where
     1062                 buf_chk-gds-attr.doc-code = iDocCode
     1063             and buf_chk-gds-attr.line-num  = iLineNum
     1064             and buf_chk-gds-attr.attr-code = "CSPromoSum"
     1065         no-error.
     1066      if avail buf_chk-gds-attr then
     1067         vSumPromo = DEC(buf_chk-gds-attr.attr-value) no-error.
     1068      return vSumPromo.
     1069   end function.
     1070   function ChkPromoPrice returns logical
     1071       (input iDocCode as character,
     1072        input iLineNum as integer)
     1073       :
     1074      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     1075      define variable v-is-promo as logical no-undo.
     1076      v-is-promo = no.
     1077      find first buf_chk-gds-attr no-lock where
     1078                 buf_chk-gds-attr.doc-code = iDocCode
     1079             and buf_chk-gds-attr.line-num  = iLineNum
     1080             and buf_chk-gds-attr.attr-code = "CSPromo"
     1081         no-error.
     1082      if avail buf_chk-gds-attr
     1083        and can-do("2,4,5,7", buf_chk-gds-attr.attr-value)
     1084      then v-is-promo = yes.
     1085      return v-is-promo.
     1086   end function.
     1087   function ChkDopLitr returns logical
     1088       (input iDocCode as character,
     1089        input iLineNum as integer)
     1090       :
     1091      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     1092      define variable v-is-promo as logical no-undo.
     1093      v-is-promo = no.
     1094      find first buf_chk-gds-attr no-lock where
     1095                 buf_chk-gds-attr.doc-code = iDocCode
     1096             and buf_chk-gds-attr.line-num  = iLineNum
     1097             and buf_chk-gds-attr.attr-code = "CSPromo"
     1098         no-error.
     1099      if avail buf_chk-gds-attr and
     1100        buf_chk-gds-attr.attr-value = "3"
     1101      then v-is-promo = yes.
     1102      return v-is-promo.
     1103   end function.
     1104   function RoundUp return decimal
     1105       (input iQnty as decimal,
     1106        input iPrice as decimal):
     1107       def var vSum  as decimal no-undo.
     1108       def var vSumR as decimal no-undo.
     1109       vSum = ABSOLUTE(iQnty) * iPrice.
     1110       vSumR = Round(vSum,2).
     1111       if vSumR < vSum then vSumR = vSumR + 0.01.
     1112       if iQnty < 0 then vSumR = - vSumR.
     1113       return vSumR.
     1114   end function.
     1115   function GetPromoSum returns decimal
     1116       (input iDocCode as character)
     1117       :
     1118       define buffer buf_chk-doc for ub.chk-doc.
     1119       define buffer buf2_chk-doc for ub.chk-doc.
     1120       define buffer buf_chk-gds for ub.chk-gds.
     1121       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     1122       define buffer buf2_chk-gds for ub.chk-gds.
     1123       define buffer buf2_chk-gds-attr for ub.chk-gds-attr.
     1124       define variable v-price-base as decimal no-undo.
     1125       define variable v-doc-qnty as decimal no-undo.
     1126       define variable v-sum-base as decimal no-undo.
     1127       define variable v-sum-all as decimal no-undo.
     1128       define variable v-sum-promo as decimal no-undo.
     1129       define variable v-sum-chk as decimal no-undo.
     1130       assign
     1131          v-price-base = 0
     1132          v-doc-qnty = 0
     1133          v-sum-all = 0
     1134          v-sum-chk = 0
     1135          v-sum-promo = 0
     1136          .
     1137       for each buf_chk-gds no-lock where
     1138                buf_chk-gds.doc-code = iDocCode,
     1139          first buf_chk-gds-attr no-lock where
     1140                buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     1141            and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     1142            and buf_chk-gds-attr.attr-code = "CSPromoSum"
     1143          :
     1144          v-sum-promo = Dec(buf_chk-gds-attr.attr-value).
     1145       end.
     1146       if v-sum-promo = 0 then do:
     1147           for each buf_chk-gds no-lock where
     1148                    buf_chk-gds.doc-code = iDocCode,
     1149              first buf_chk-gds-attr no-lock where
     1150                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     1151                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     1152                and buf_chk-gds-attr.attr-code = "CSPromo"
     1153                and can-do("1,6", buf_chk-gds-attr.attr-value)
     1154              :
     1155              assign
     1156                v-price-base = buf_chk-gds.price-base
     1157                v-doc-qnty   = if buf_chk-gds.doc-qnty = ? then buf_chk-gds.src-qnty else buf_chk-gds.doc-qnty
     1158                v-sum-base = if buf_chk-gds.sum-base = ? then round(v-doc-qnty * v-price-base, 2) else buf_chk-gds.sum-base
     1159                .
     1160           end.
     1161           for each buf_chk-gds no-lock where
     1162                    buf_chk-gds.doc-code = iDocCode,
     1163              first buf_chk-gds-attr no-lock where
     1164                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     1165                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     1166                and buf_chk-gds-attr.attr-code = "CSPromo"
     1167                and can-do("2,4,5,7", buf_chk-gds-attr.attr-value)
     1168              :
     1169              if v-price-base = 0 then do:
     1170                 find first buf_chk-doc no-lock where
     1171                            buf_chk-doc.doc-code = iDocCode
     1172                     no-error.
     1173                 if avail buf_chk-doc and
     1174                    buf_chk-doc.chk-type = int('6':U) and
     1175                    buf_chk-doc.doc-num2 > ""  and
     1176                    num-entries(buf_chk-doc.doc-num2,":") = 2
     1177                 then
     1178                 for first buf2_chk-doc no-lock where
     1179                           buf2_chk-doc.obj-code = buf_chk-doc.obj-code
     1180                       and buf2_chk-doc.obj-type = buf_chk-doc.obj-type
     1181                       and buf2_chk-doc.chk-type = int('1':U)
     1182                       and buf2_chk-doc.chk-num = int(entry(1,buf_chk-doc.doc-num2,":"))
     1183                       and buf2_chk-doc.z-number = int(entry(2, buf_chk-doc.doc-num2,":"))
     1184                       :
     1185                   for each buf2_chk-gds no-lock where
     1186                            buf2_chk-gds.doc-code = buf2_chk-doc.doc-code,
     1187                      first buf2_chk-gds-attr no-lock where
     1188                            buf2_chk-gds-attr.doc-code = buf2_chk-gds.doc-code
     1189                        and buf2_chk-gds-attr.line-num  = buf2_chk-gds.line-num
     1190                        and buf2_chk-gds-attr.attr-code = "CSPromo"
     1191                        and can-do("1,6", buf2_chk-gds-attr.attr-value)
     1192                      :
     1193                       v-price-base = buf2_chk-gds.price-base.
     1194                   end.
     1195                 end.
     1196              end.
     1197              if buf_chk-gds.sum-base = ? or buf_chk-gds.src-qnty = 0 then do:
     1198                  assign
     1199                     v-sum-all = (buf_chk-gds.src-qnty + v-doc-qnty) * v-price-base
     1200                     v-sum-chk = v-sum-base + RoundUp(buf_chk-gds.src-qnty, buf_chk-gds.src-price)
     1201                     .
     1202              end.
     1203              else do:
     1204                 assign
     1205                 v-sum-all = (buf_chk-gds.doc-qnty + v-doc-qnty ) * v-price-base
     1206                 v-sum-chk = v-sum-base + buf_chk-gds.sum-base
     1207                 .
     1208              end.
     1209           end.
     1210           v-sum-promo = Round(v-sum-all, 2) - Round(v-sum-chk, 2).
     1211       end.
     1212       return v-sum-promo.
     1213   end function.
     1214   function GetUnBaseSum returns decimal
     1215       (input iDocCode as character,
     1216        input iLineNum as integer,
     1217        input iQnty as decimal,
     1218        input iPrice as decimal):
     1219      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     1220      define variable vBaseSum as decimal no-undo.
     1221      define variable vDiscSum as decimal no-undo.
     1222      vDiscSum = 0.
     1223      find first buf_chk-gds-attr no-lock where
     1224                        buf_chk-gds-attr.doc-code = iDocCode
     1225                    and buf_chk-gds-attr.line-num  = iLineNum
     1226                    and buf_chk-gds-attr.attr-code = "CSPromoSum"
     1227             no-error.
     1228      if avail buf_chk-gds-attr then
     1229         vDiscSum = dec(buf_chk-gds-attr.attr-value) no-error.
     1230      vBaseSum = iQnty * iPrice + vDiscSum.
     1231      if vDiscSum = 0 and ChkPromoPrice(iDocCode, iLineNum) then
     1232         vBaseSum = RoundUp(iQnty, iPrice).
     1233      return vBaseSum.
     1234   end function.
     1235   function GetRoundSum returns decimal
     1236       (input iDocCode as character,
     1237        input iLineNum as integer,
     1238        input iQnty as decimal,
     1239        input iPrice as decimal):
     1240      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     1241      define variable vBaseSum as decimal no-undo.
     1242      if ChkPromoPrice(iDocCode, iLineNum) then
     1243         vBaseSum = RoundUp(iQnty, iPrice).
     1244      else vBaseSum = iQnty * iPrice.
     1245      return vBaseSum.
     1246   end function.
     1247   function GetRoundSumChkDel returns decimal
     1248       (input iDocCode as character,
     1249        input iLineNum as integer,
     1250        input iChipNum as integer,
     1251        input iQnty as decimal,
     1252        input iPrice as decimal):
     1253      define buffer  buf_c-chk-doc-attr for ub.c-chk-doc-attr.
     1254      define variable vBaseSum as decimal no-undo.
     1255      define variable vIsPromo as logical no-undo.
     1256      for each buf_c-chk-doc-attr no-lock where
     1257               buf_c-chk-doc-attr.doc-code = iDocCode
     1258           and buf_c-chk-doc-attr.chip-num = iChipNum
     1259          :
     1260          if num-entries(buf_c-chk-doc-attr.attr-code, chr(4)) > 1
     1261          then do :
     1262            if entry(1, buf_c-chk-doc-attr.attr-code, chr(4)) begins "gds="
     1263            and entry(2, buf_c-chk-doc-attr.attr-code, chr(4)) = "CSPromo"
     1264            and entry(2, entry(1, buf_c-chk-doc-attr.attr-code, chr(4)), "=") = String(iLineNum)
     1265            and can-do("2,4,5,7", buf_c-chk-doc-attr.attr-value)
     1266            then vIsPromo = yes.
     1267          end.
     1268      end.
     1269      if ChkPromoPrice(iDocCode, iLineNum) then
     1270         vBaseSum = RoundUp(iQnty, iPrice).
     1271      else vBaseSum = iQnty * iPrice.
     1272      return vBaseSum.
     1273   end function.
     1274   function GetSaleRetDisc returns decimal
     1275       (input iDocCode as character,
     1276        input iSaleCode as character):
     1277      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     1278      define buffer buf_chk-gds for ub.chk-gds.
     1279      define variable vQntyPromoRet as decimal no-undo.
     1280      define variable vQntyPromoSel as decimal no-undo.
     1281      define variable vDiscSumRet   as decimal no-undo.
     1282      define variable vDiscSumSale  as decimal no-undo.
     1283      vDiscSumRet = 0.
     1284      cspr:
     1285      for each  buf_chk-gds no-lock where
     1286                buf_chk-gds.doc-code = iDocCode,
     1287          first buf_chk-gds-attr no-lock where
     1288                buf_chk-gds-attr.doc-code  = buf_chk-gds.doc-code
     1289            and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     1290            and buf_chk-gds-attr.attr-code = "CSPromo"
     1291            and can-do("2,4,5,7", buf_chk-gds-attr.attr-value)
     1292          :
     1293          vQntyPromoRet = buf_chk-gds.src-qnty.
     1294          leave cspr.
     1295      end.
     1296      if vQntyPromoRet <> 0 then
     1297      for each  buf_chk-gds no-lock where
     1298                buf_chk-gds.doc-code = iSaleCode:
     1299          find first buf_chk-gds-attr no-lock where
     1300                     buf_chk-gds-attr.doc-code  = buf_chk-gds.doc-code
     1301                 and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     1302                 and buf_chk-gds-attr.attr-code = "CSPromo"
     1303          no-error.
     1304          if avail buf_chk-gds-attr
     1305               and can-do("2,4,5,7", buf_chk-gds-attr.attr-value)
     1306          then
     1307            vQntyPromoSel = buf_chk-gds.src-qnty.
     1308          find first buf_chk-gds-attr no-lock where
     1309                    buf_chk-gds-attr.doc-code  = buf_chk-gds.doc-code
     1310                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     1311                and buf_chk-gds-attr.attr-code = "CSPromoSum"
     1312          no-error.
     1313          if avail buf_chk-gds-attr then
     1314             vDiscSumSale = dec(buf_chk-gds-attr.attr-value) no-error.
     1315      end.
     1316      if vQntyPromoRet <> 0 and
     1317         vQntyPromoSel = -1 * vQntyPromoRet
     1318      then vDiscSumRet = -1 * vDiscSumSale.
     1319      return vDiscSumRet.
     1320   end function.
     1321   function SetPromoDisc return logical
     1322    (input iDocCode as character,
     1323        input iLineNum as integer
     1324        )
     1325       :
     1326      define buffer buf_chk-doc for ub.chk-doc.
     1327      define buffer buf2_chk-doc for ub.chk-doc.
     1328      define buffer buf_chk-gds for ub.chk-gds.
     1329      define buffer buf2_chk-gds for ub.chk-gds.
     1330      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     1331      define buffer buf2_chk-gds-attr for ub.chk-gds-attr.
     1332      define buffer buf_chk-discnt for ub.chk-discnt.
     1333      define buffer buf2_chk-discnt for ub.chk-discnt.
     1334      define buffer buf_chk-discnt-attr for ub.chk-discnt-attr.
     1335      define buffer buf2_chk-discnt-attr for ub.chk-discnt-attr.
     1336      define variable v-promo-sum as decimal no-undo.
     1337      define variable v-disc-promo-id as character no-undo.
     1338      define variable var-discnt-id as integer no-undo.
     1339      define variable v-chk-sale as character no-undo.
     1340      find first buf_chk-gds-attr no-lock where
     1341                 buf_chk-gds-attr.doc-code = iDocCode
     1342             and buf_chk-gds-attr.line-num  = iLineNum
     1343             and buf_chk-gds-attr.attr-code = "CSPromo"
     1344         no-error.
     1345      if avail buf_chk-gds-attr
     1346        then do:
     1347        find first buf_chk-discnt no-lock where
     1348                   buf_chk-discnt.doc-code = buf_chk-gds-attr.doc-code
     1349               and buf_chk-discnt.line-num = buf_chk-gds-attr.line-num
     1350               and buf_chk-discnt.record-type = 0
     1351               and buf_chk-discnt.promo-id > ""
     1352               no-error.
     1353        if not avail buf_chk-discnt then do:
     1354           find first buf_chk-doc no-lock where
     1355                      buf_chk-doc.doc-code = iDocCode
     1356              no-error.
     1357           find first buf_chk-gds no-lock where
     1358                      buf_chk-gds.doc-code = iDocCode
     1359                 and  buf_chk-gds.line-num = iLineNum
     1360              no-error.
     1361          for first buf2_chk-doc no-lock where
     1362                    buf2_chk-doc.obj-code = buf_chk-doc.obj-code
     1363                and buf2_chk-doc.obj-type = buf_chk-doc.obj-type
     1364                and buf2_chk-doc.pay-desk = buf_chk-doc.pay-desk
     1365                and buf2_chk-doc.chk-type = int('1':U)
     1366                and buf2_chk-doc.chk-num  = int(entry(1,buf_chk-doc.doc-num2,":"))
     1367                and buf2_chk-doc.z-number = int(entry(2, buf_chk-doc.doc-num2,":"))
     1368              :
     1369              find first buf2_chk-gds no-lock where
     1370                         buf2_chk-gds.doc-code = buf2_chk-doc.doc-code
     1371                    and  buf2_chk-gds.b-code   = buf_chk-gds.b-code
     1372              no-error.
     1373              if not avail buf2_chk-gds then return no.
     1374              v-chk-sale = buf2_chk-doc.doc-code.
     1375              find first buf_chk-discnt no-lock where
     1376                         buf_chk-discnt.doc-code =  buf2_chk-doc.doc-code and
     1377                         buf_chk-discnt.record-type = 1 and
     1378                         buf_chk-discnt.object-line-num = buf2_chk-gds.line-num and
     1379                         buf_chk-discnt.promo-id > ""
     1380              no-error .
     1381              if avail buf_chk-discnt
     1382              then do:
     1383                 v-disc-promo-id = buf_chk-discnt.promo-id.
     1384                 find first buf2_chk-discnt no-lock where
     1385                   buf2_chk-discnt.doc-code = iDocCode and
     1386                   buf2_chk-discnt.record-type = 5 and
     1387                   buf2_chk-discnt.line-num = 0 and
     1388                   buf2_chk-discnt.promo-id =  v-disc-promo-id
     1389                 no-error.
     1390                 find first buf2_chk-discnt-attr no-lock where
     1391                            buf2_chk-discnt-attr.doc-code = iDocCode and
     1392                            buf2_chk-discnt-attr.record-type = 5 and
     1393                            buf2_chk-discnt-attr.line-num = 0 and
     1394                            buf2_chk-discnt-attr.attr-code = "promo-id" and
     1395                            buf2_chk-discnt-attr.attr-value = v-disc-promo-id
     1396                       no-error .
     1397                 if not avail buf2_chk-discnt
     1398                 then do:
     1399                     for each buf_chk-discnt no-lock where
     1400                              buf_chk-discnt.doc-code = buf_chk-gds-attr.doc-code
     1401                          and buf_chk-discnt.record-type = 5:
     1402                          var-discnt-id  = var-discnt-id + 1.
     1403                     end.
     1404                     create buf2_chk-discnt.
     1405                     assign
     1406                       buf2_chk-discnt.doc-code = iDocCode
     1407                       buf2_chk-discnt.record-type = 5
     1408                       buf2_chk-discnt.line-num = 0
     1409                       buf2_chk-discnt.promo-id = v-disc-promo-id
     1410                       buf2_chk-discnt.object-sum = 0
     1411                       buf2_chk-discnt.discnt-id = if avail buf2_chk-discnt-attr
     1412                                                      then buf2_chk-discnt-attr.discnt-id
     1413                                                      else (var-discnt-id + 1)
     1414                       var-discnt-id = 0
     1415                       buf2_chk-discnt.object-line-num = 0
     1416                       buf2_chk-discnt.pay-desk = buf_chk-doc.pay-desk
     1417                       buf2_chk-discnt.obj-code = buf_chk-doc.obj-code
     1418                       buf2_chk-discnt.obj-type = buf_chk-doc.obj-type
     1419                       buf2_chk-discnt.chk-date = buf_chk-doc.chk-date
     1420                       buf2_chk-discnt.shift-date = buf_chk-doc.shift-date
     1421                       buf2_chk-discnt.shift-num = buf_chk-doc.shift-num
     1422                       buf2_chk-discnt.chk-time = buf_chk-doc.chk-time
     1423                       .
     1424                 end.
     1425                 if avail buf2_chk-discnt and
     1426                    not avail buf2_chk-discnt-attr
     1427                 then do:
     1428                    create buf2_chk-discnt-attr.
     1429                    assign
     1430                       buf2_chk-discnt-attr.doc-code = iDocCode
     1431                       buf2_chk-discnt-attr.discnt-id = buf2_chk-discnt.discnt-id
     1432                       buf2_chk-discnt-attr.record-type     = 5
     1433                       buf2_chk-discnt-attr.line-num        = 0
     1434                       buf2_chk-discnt-attr.object-line-num = 0
     1435                       buf2_chk-discnt-attr.attr-code       = "promo-id"
     1436                       buf2_chk-discnt-attr.attr-value      = v-disc-promo-id
     1437                       .
     1438                 end.
     1439              end.
     1440          end.
     1441           v-promo-sum = 0.
     1442           if can-do("1,6,7", buf_chk-gds-attr.attr-value)
     1443           then do:
     1444              if v-chk-sale <> ? and v-chk-sale <> "" then
     1445                 v-promo-sum = GetSaleRetDisc(iDocCode,v-chk-sale).
     1446              v-promo-sum = if v-promo-sum = 0 then GetPromoSum(iDocCode) else v-promo-sum.
     1447              if v-promo-sum <> 0 then do:
     1448                  find first buf2_chk-gds-attr no-lock where
     1449                             buf2_chk-gds-attr.doc-code = iDocCode
     1450                         and buf2_chk-gds-attr.line-num  = iLineNum
     1451                         and buf2_chk-gds-attr.attr-code = "CSPromoSum"
     1452                     no-error.
     1453                  if not avail buf2_chk-gds-attr then do:
     1454                      create buf2_chk-gds-attr.
     1455                      assign
     1456                         buf2_chk-gds-attr.doc-code = iDocCode
     1457                         buf2_chk-gds-attr.line-num  = iLineNum
     1458                         buf2_chk-gds-attr.attr-code = "CSPromoSum"
     1459                         buf2_chk-gds-attr.attr-value = string(Round(v-promo-sum,2))
     1460                         .
     1461                  end.
     1462              end.
     1463           end.
     1464           for each buf_chk-discnt no-lock where
     1465                   buf_chk-discnt.doc-code = buf_chk-gds-attr.doc-code
     1466               and buf_chk-discnt.record-type = 0:
     1467              var-discnt-id  = var-discnt-id + 1.
     1468           end.
     1469           create buf_chk-discnt.
     1470           assign
     1471               buf_chk-discnt.doc-code = iDocCode
     1472               buf_chk-discnt.line-num = iLineNum
     1473               buf_chk-discnt.record-type = 0
     1474               buf_chk-discnt.discnt-id = (var-discnt-id + 1)
     1475               buf_chk-discnt.time-oper = buf_chk-gds.time-oper
     1476               buf_chk-discnt.line-type = integer('1':U)
     1477               buf_chk-discnt.line-sign = no
     1478               buf_chk-discnt.pass-discnt = integer('0':U)
     1479               buf_chk-discnt.value-type = integer('2':U)
     1480               buf_chk-discnt.src-d-card = buf_chk-gds.src-d-card
     1481               buf_chk-discnt.d-card = buf_chk-gds.d-card
     1482               buf_chk-discnt.discnt-value-abs = 0
     1483               buf_chk-discnt.discnt-value-pcnt = 0
     1484               buf_chk-discnt.object-line-num = iLineNum
     1485               buf_chk-discnt.pay-desk = buf_chk-doc.pay-desk
     1486               buf_chk-discnt.obj-code = buf_chk-doc.obj-code
     1487               buf_chk-discnt.obj-type = buf_chk-doc.obj-type
     1488               buf_chk-discnt.chk-date = buf_chk-doc.chk-date
     1489               buf_chk-discnt.chk-time = buf_chk-doc.chk-time
     1490               buf_chk-discnt.shift-date = buf_chk-doc.shift-date
     1491               buf_chk-discnt.shift-num = buf_chk-doc.shift-num
     1492               buf_chk-discnt.object-qnty = buf_chk-gds.src-qnty
     1493               buf_chk-discnt.object-sum = buf_chk-gds.src-sum
     1494               var-discnt-id = var-discnt-id + 1
     1495               buf_chk-discnt.promo-id = v-disc-promo-id
     1496               buf_chk-discnt.discnt-type = integer('7':U)
     1497               .
     1498           find first buf_chk-discnt-attr no-lock where
     1499                      buf_chk-discnt-attr.attr-code = "promo-id"
     1500                  and buf_chk-discnt-attr.discnt-id = buf_chk-discnt.discnt-id
     1501                  and buf_chk-discnt-attr.doc-code = buf_chk-discnt.doc-code
     1502                  and buf_chk-discnt-attr.line-num = buf_chk-discnt.line-num
     1503                  no-error.
     1504           if not avail buf_chk-discnt-attr then
     1505           do:
     1506               create buf_chk-discnt-attr .
     1507               assign
     1508                   buf_chk-discnt-attr.attr-code = "promo-id"
     1509                   buf_chk-discnt-attr.attr-value = buf_chk-discnt.promo-id
     1510                   buf_chk-discnt-attr.discnt-id = buf_chk-discnt.discnt-id
     1511                   buf_chk-discnt-attr.doc-code = buf_chk-discnt.doc-code
     1512                   buf_chk-discnt-attr.line-num = buf_chk-discnt.line-num
     1513                   buf_chk-discnt-attr.object-line-num = buf_chk-discnt.object-line-num
     1514                   buf_chk-discnt-attr.record-type = buf_chk-discnt.record-type
     1515                   .
     1516            end.
     1517        end.
     1518      end.
     1519      return yes.
     1520   end function.
     1521   function GetPromoPriceSum returns decimal
     1522       (input iDocCode as character)
     1523       :
     1524       define buffer buf_chk-gds for ub.chk-gds.
     1525       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     1526       define variable vPromoSum as decimal no-undo.
     1527       vPromoSum = 0.
     1528       cspr:
     1529       for each buf_chk-gds no-lock where
     1530                    buf_chk-gds.doc-code = iDocCode,
     1531              first buf_chk-gds-attr no-lock where
     1532                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     1533                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     1534                and buf_chk-gds-attr.attr-code = "CSPromo"
     1535                and can-do("2,4,5,7", buf_chk-gds-attr.attr-value):
     1536          vPromoSum = RoundUp(buf_chk-gds.src-qnty, buf_chk-gds.src-price).
     1537          leave cspr.
     1538       end.
     1539       return vPromoSum.
     1540   end.
     1541   function GetPromoPriceLine returns integer
     1542       (input iDocCode as character)
     1543       :
     1544       define buffer buf_chk-gds for ub.chk-gds.
     1545       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     1546       define variable vPromoLine as integer no-undo.
     1547       vPromoLine = 0.
     1548       cspr:
     1549       for each buf_chk-gds no-lock where
     1550                    buf_chk-gds.doc-code = iDocCode,
     1551              first buf_chk-gds-attr no-lock where
     1552                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     1553                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     1554                and buf_chk-gds-attr.attr-code = "CSPromo"
     1555                and can-do("2,4,5,7", buf_chk-gds-attr.attr-value):
     1556          vPromoLine = buf_chk-gds-attr.line-num.
     1557          leave cspr.
     1558       end.
     1559       return vPromoLine.
     1560   end.
     1561   define stream Out-Stream.
     1562   define stream OutStr-html.
     1563   define temp-table tt-info
     1564      field obj-code like ub.chk-doc.obj-code
     1565      field obj-type like ub.chk-doc.obj-type
     1566      field obj-name as character
     1567      field pl-code as integer
     1568      field gds-name as character
     1569      field price-base as decimal
     1570      field doc-code like ub.chk-doc.doc-code
     1571      field shift-num like ub.chk-doc.shift-num
     1572      field shift-date like ub.chk-doc.shift-date
     1573      field chk-date as date
     1574      field chk-num as int
     1575      field z-number as int
     1576      field cashier as char
     1577      field src-qnty as dec
     1578      field src-promo-qnty as dec
     1579      field src-price as dec
     1580      field src-sum as dec
     1581      field discnt as dec
     1582      field src-sum-no-disc as dec
     1583      field src-sum-disc as dec
     1584      field ret-doc-code as char
     1585      field ret-shift-num as int
     1586      field ret-shift-date as date
     1587      field ret-chk-date as date
     1588      field ret-chk-num as int
     1589      field ret-cashier as char
     1590      field ret-src-qnty as dec
     1591      field ret-promo-qnty as dec
     1592      field ret-src-price as dec
     1593      field ret-src-sum as dec
     1594      field ret-discnt as dec
     1595      field ret-sum-no-disc as dec
     1596      field dop-qnty as dec
     1597      field dop-sum as dec
     1598      field ret-dop-qnty as dec
     1599      field ret-dop-src-sum as dec
     1600      field promo-id as char
     1601      field nameAction as char
     1602      field itog-qnty as dec
     1603      field itog-price as dec
     1604      field itog-sum as dec
     1605      field itog-sum-no-disc as dec
     1606      field itog-sum-disc as dec
     1607      field itog-proc as dec
     1608      field sts as char
     1609      field b-code as integer
     1610      field change-BL as char
     1611      field ret-nodiscnt as log
     1612      field pay-desk as int
     1613      field ext-code as char
     1614      index sort1 chk-date chk-num.
     1615   define variable v-report-name       as character no-undo .
     1616   define variable v-file-name-rep-htm as character no-undo .
     1617   define variable v-filt-1            as character no-undo .
     1618   define variable v-filt-2            as character no-undo .
     1619   define variable v-date-start        as date      no-undo .
     1620   define variable v-page-name         as character no-undo .
     1621   define variable v-obj-code          as integer   no-undo .
     1622   define variable v-wdaylist          as character no-undo .
     1623   define variable v-timelist          as character extent 7 no-undo .
     1624   define variable v-sdaynum           as character no-undo .
     1625   define variable v-idaynum           as integer   no-undo .
     1626   define variable v-timebeg           as character no-undo .
     1627   define variable v-timeend           as character no-undo .
     1628   define variable vi                  as integer   no-undo .
     1629   define variable vj                  as integer   no-undo .
     1630   define variable ii                  as integer   no-undo .
     1631   define variable kk                  as integer   no-undo .
     1632   define variable v-period            as character no-undo .
     1633   define variable v-list-obj          as character no-undo .
     1634   define variable v-obj-name          as character no-undo .
     1635   define variable v-first             as logical   no-undo .
     1636   define buffer buf_chk-discnt      for ub.chk-discnt .
     1637   define buffer buf_chk-discnt-attr for ub.chk-discnt-attr .
     1638   define buffer buf_chk-doc         for ub.chk-doc .
     1639   define buffer buf_ret-chk-doc     for ub.chk-doc .
     1640   define buffer buf_chk-gds         for ub.chk-gds .
     1641   define buffer buf_promo-chk-gds   for ub.chk-gds .
     1642   define buffer bf_chk-discnt       for ub.chk-discnt .
     1643   define buffer bf_chk-discnt-attr  for ub.chk-discnt-attr .
     1644   define buffer buf_bar-code for ub.bar-code.
     1645   define buffer buf_goods for ub.goods.
     1646   define buffer buf_person for ub.person.
     1647   define buffer buf_clients for ub.clients.
     1648   define buffer buf_PromoAction for ub.PromoAction.
     1649   define VARIABLE p-report-id as character no-undo .
     1650   define variable vPromoName  as character no-undo .
     1651   define variable vStatusCond as character no-undo .
     1652   define variable vAllPromo   as logical   no-undo.
     1653   define variable vPromoPrice as decimal   no-undo.
     1654   define variable vLstSts     as character no-undo.
     1655   vPromoPrice = 0.01.
     1656   if x-TOG-Shift then
     1657   do:
     1658     v-period = string (x-Date-Start,"99.99.9999") + " - " + string (x-Date-End,"99.99.9999") + " Смены: " + string (x-Shift-Start) + " - " + string (x-Shift-End).
     1659   end.
     1660   else
     1661   do:
     1662     v-period = string (x-Date-Start,"99.99.9999") + " - " + string (x-Date-End,"99.99.9999") .
     1663   end.
     1664   vPromoName = "".
     1665   for each tt-promo:
     1666       vPromoName = vPromoName + "," + tt-promo.nameAction.
     1667   end.
     1668   vPromoName = trim(vPromoName,",").
     1669   if vPromoName = "" then
     1670   assign
     1671      vPromoName = "Все"
     1672      vAllPromo = yes.
     1673   else vAllPromo = no.
     1674   case p-cond:
     1675       when 1 then
     1676          assign
     1677             vStatusCond = "Все"
     1678             vLstSts = "*"
     1679             .
     1680       when 2 then
     1681          assign
     1682             vStatusCond = "Не прекращено"
     1683             vLstSts = "0"
     1684             .
     1685       when 3 then
     1686          assign
     1687             vStatusCond = "Прекращено"
     1688             vLstSts = "1"
     1689             .
     1690       otherwise .
     1691   end case.
     1692   run clients-write(INPUT v-cntxt-host-code-obj, INPUT 'орг':U, OUTPUT v-obj-name) no-error .
     1693   for each obj-list no-lock:
     1694     if v-list-obj = "" then v-list-obj = string(obj-list.obj-code).
     1695     else v-list-obj = v-list-obj + ", " + string(obj-list.obj-code).
     1696     if x-TOG-Shift then
     1697     do:
     1698       for each buf_chk-doc no-lock
     1699         where buf_chk-doc.obj-code = obj-list.obj-code
     1700         and buf_chk-doc.obj-type = obj-list.obj-type
     1701         and buf_chk-doc.chk-type = int('1':U)
     1702         and buf_chk-doc.shift-date >= x-Date-Start
     1703         and buf_chk-doc.shift-date <= x-Date-End
     1704         and buf_chk-doc.out-code <> ?:
     1705         if (buf_chk-doc.shift-date = X-date-Start)
     1706           and (buf_chk-doc.shift-num < x-Shift-Start) then next.
     1707         if (buf_chk-doc.shift-date = X-date-End)
     1708           and (buf_chk-doc.shift-num > x-Shift-End) then next.
     1709         run report .
     1710       end.
     1711     end.
     1712     else
     1713     do:
     1714       for each buf_chk-doc no-lock
     1715         where buf_chk-doc.obj-code = obj-list.obj-code
     1716         and buf_chk-doc.obj-type = obj-list.obj-type
     1717         and buf_chk-doc.chk-type  = int('1':U)
     1718         and buf_chk-doc.chk-date >= x-Date-Start
     1719         and buf_chk-doc.chk-date <= x-Date-End
     1720         and buf_chk-doc.out-code <> ?:
     1721         run report .
     1722       end.
     1723     end.
     1724   end.
     1725   run report-itog.
     1726   run gbl/getrpnum.p (output p-report-id).
     1727   v-file-name-rep-htm = session:temp-directory + string(p-report-id) + ".html".
     1728   output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8'.
     1729   put stream OutStr-html unformatted
     1730   "<!DOCTYPE HTML>" skip
     1731   ' <html>' skip
     1732   '  <head>' skip
     1733   '   <meta charset="utf-8">' skip
     1734   '    <style type="text/css">' skip
     1735   '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     1736   '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     1737   '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black;' + chr(125) skip
     1738   '   </style>' skip
     1739   '  </head>' skip
     1740     .
     1741   run report-header.
     1742   run report-body.
     1743   put stream OutStr-html unformatted
     1744      '</tbody>' skip
     1745      '</table>' skip
     1746      '</body>' skip
     1747      '</html>' skip
     1748      .
     1749   output stream OutStr-html close.
     1750   run prn-lib-reportviewer in this-procedure (
     1751      input this-procedure
     1752      ,input v-file-name-rep-htm
     1753      ,input ""
     1754      ) no-error.
     1755   if error-status:error then
     1756   do:
     1757      message return-value view-as alert-box.
     1758      return .
     1759   end.
     1760   procedure report:
     1761     define variable is-petrolium         as logical   no-undo.
     1762     define variable is-pieces            as logical   no-undo.
     1763     define variable v-sum-r              as decimal   no-undo.
     1764     define variable v-sum-no-disc        as decimal   no-undo.
     1765     define variable v-sum-disc           as decimal   no-undo.
     1766     define buffer buf_promoAttr for ub.promoAttr.
     1767     define buffer buf_bar-code for ub.bar-code.
     1768     define buffer buf_goods for ub.goods.
     1769     chkda:
     1770     for each  buf_chk-gds no-lock where
     1771               buf_chk-gds.doc-code = buf_chk-doc.doc-code and
     1772               buf_chk-gds.pl-code <> ?:
     1773       find first buf_chk-discnt no-lock where
     1774                  buf_chk-discnt.doc-code = buf_chk-doc.doc-code and
     1775                  buf_chk-discnt.promo-id > ""   and
     1776                  buf_chk-discnt.record-type = 1 and
     1777                  buf_chk-discnt.object-line-num = buf_chk-gds.line-num
     1778          no-error.
     1779       if not avail buf_chk-discnt then next chkda.
     1780       if not vAllPromo then do:
     1781          if not can-find(first tt-promo where
     1782                                tt-promo.id = int(buf_chk-discnt.promo-id))
     1783          then next chkda.
     1784       end.
     1785       find first buf_bar-code no-lock where buf_bar-code.b-code = buf_chk-gds.b-code no-error .
     1786       find first buf_goods no-lock where buf_goods.gds-code = buf_bar-code.gds-code no-error .
     1787   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     1788     (
     1789        input buf_goods.artic
     1790     ,  input buf_goods.prod-type
     1791     ,  input buf_goods.prod-code
     1792     , output is-petrolium
     1793     , output is-pieces
     1794     ) no-error.
     1795       if not is-petrolium then next .
     1796       find first tt-info no-lock where
     1797                  tt-info.obj-code = buf_chk-doc.obj-code and
     1798                  tt-info.obj-type = buf_chk-doc.obj-type and
     1799                  tt-info.doc-code = buf_chk-gds.doc-code and
     1800                  tt-info.b-code = buf_chk-gds.b-code
     1801           no-error.
     1802       if not avail tt-info
     1803       then do:
     1804         create tt-info.
     1805         assign
     1806            tt-info.obj-code = buf_chk-doc.obj-code
     1807            tt-info.obj-type = buf_chk-doc.obj-type
     1808            tt-info.doc-code = buf_chk-gds.doc-code
     1809            tt-info.chk-num = buf_chk-doc.chk-num
     1810            tt-info.chk-date = buf_chk-doc.chk-date
     1811            tt-info.z-number = buf_chk-doc.z-number
     1812            tt-info.shift-num = buf_chk-doc.shift-num
     1813            tt-info.shift-date = buf_chk-doc.shift-date
     1814            tt-info.pl-code  = buf_chk-gds.pl-code
     1815            tt-info.b-code = buf_chk-gds.b-code
     1816            tt-info.pay-desk = buf_chk-doc.pay-desk
     1817            .
     1818         find first buf_person where
     1819                    buf_person.psn-code = buf_chk-doc.cashier-psn-code
     1820            no-lock no-error.
     1821         if avail buf_person THEN
     1822            tt-info.cashier = buf_person.name1 + ' ' + buf_person.name2 + ' '.
     1823         find first buf_clients where
     1824                    buf_clients.obj-code = buf_chk-doc.cashier-psn-code  and
     1825                    buf_clients.obj-type = 'чел'
     1826            no-lock no-error.
     1827         if avail buf_clients then
     1828            tt-info.cashier = tt-info.cashier + buf_clients.obj-name.
     1829         for first buf_clients no-lock where
     1830                   buf_clients.obj-code = tt-info.obj-code and
     1831                   buf_clients.obj-type = tt-info.obj-type:
     1832             tt-info.obj-name = buf_clients.obj-name .
     1833         end.
     1834         for first buf_bar-code no-lock where
     1835                    buf_bar-code.b-code = buf_chk-gds.b-code:
     1836            find first buf_goods no-lock where
     1837                       buf_goods.gds-code = buf_bar-code.gds-code
     1838               no-error.
     1839            if available buf_goods then
     1840               tt-info.gds-name = buf_goods.gds-name.
     1841         end.
     1842       end.
     1843       if tt-info.promo-id  = "" then do:
     1844         tt-info.promo-id = buf_chk-discnt.promo-id.
     1845         for first buf_PromoAction no-lock where
     1846                   buf_PromoAction.id = int64(tt-info.promo-id):
     1847             assign
     1848                tt-info.nameAction = buf_PromoAction.nameAction
     1849                tt-info.ext-code = buf_PromoAction.ext-code
     1850                .
     1851             find first ub.promoAttr where
     1852                        ub.promoAttr.attr-code = "charge-BL" and
     1853                        ub.promoAttr.tablename = "PromoPay" and
     1854                        buf_PromoAction.id = int64(entry(1,ub.PromoAttr.p-key,chr(3))) and
     1855                        buf_PromoAction.db-num = integer(entry(2,ub.PromoAttr.p-key,chr(3)))
     1856                   no-error.
     1857             if available (ub.PromoAttr) and
     1858                logical(ub.PromoAttr.attr-value) = true
     1859             then tt-info.change-BL = "да" .
     1860             else tt-info.change-BL = "нет" .
     1861         end.
     1862       end.
     1863       if ChkPromoPrice(buf_chk-gds.doc-code, buf_chk-gds.line-num) then
     1864          assign
     1865             tt-info.src-promo-qnty = buf_chk-gds.src-qnty
     1866             tt-info.discnt = 0
     1867             tt-info.src-qnty = tt-info.src-qnty + buf_chk-gds.src-qnty
     1868             v-sum-r = RoundUp(buf_chk-gds.src-qnty, buf_chk-gds.src-price)
     1869             v-sum-no-disc = v-sum-r
     1870             v-sum-disc = 0
     1871             .
     1872       else do:
     1873          if ChkDopLitr(buf_chk-gds.doc-code, buf_chk-gds.line-num)
     1874          then
     1875              assign
     1876                 tt-info.dop-qnty = buf_chk-gds.src-qnty
     1877                 tt-info.dop-sum = Round(buf_chk-gds.src-price * buf_chk-gds.src-qnty, 2)
     1878                 .
     1879          else
     1880              assign
     1881                 tt-info.price-base = buf_chk-gds.price-base
     1882                 tt-info.src-price = buf_chk-gds.src-price
     1883                 .
     1884          assign
     1885             tt-info.src-qnty = tt-info.src-qnty + buf_chk-gds.src-qnty
     1886             tt-info.discnt = buf_chk-discnt.discnt-value-abs / buf_chk-gds.src-qnty
     1887             v-sum-r = Round((buf_chk-gds.src-price - tt-info.discnt) * buf_chk-gds.src-qnty, 2)
     1888             v-sum-disc = ChkPromoSum(buf_chk-gds.doc-code, buf_chk-gds.line-num)
     1889             v-sum-no-disc = Round(buf_chk-gds.src-price * buf_chk-gds.src-qnty, 2) + v-sum-disc
     1890             .
     1891       end.
     1892       assign
     1893          tt-info.src-sum = tt-info.src-sum + v-sum-r
     1894          tt-info.src-sum-no-disc = tt-info.src-sum-no-disc + v-sum-no-disc
     1895          tt-info.src-sum-disc = tt-info.src-sum-no-disc - tt-info.src-sum
     1896          .
     1897     end.
     1898   end procedure .
     1899   procedure report-itog:
     1900       define variable v-sum-r as decimal no-undo.
     1901       define variable v-sum-no-disc        as decimal   no-undo.
     1902       define variable v-sum-disc           as decimal   no-undo.
     1903       define buffer buf_chk-discnt for ub.chk-discnt.
     1904       define buffer buf_chk-doc    for ub.chk-doc.
     1905       define buffer buf_chk-gds    for ub.chk-gds.
     1906       for each tt-info:
     1907           for each buf_chk-doc no-lock where
     1908                    buf_chk-doc.obj-code = tt-info.obj-code
     1909                and buf_chk-doc.obj-type = tt-info.obj-type
     1910                and buf_chk-doc.pay-desk = tt-info.pay-desk
     1911                and buf_chk-doc.chk-type = int('6':U)
     1912                and buf_chk-doc.doc-num2 = substitute("&1:&2",tt-info.chk-num,tt-info.z-number),
     1913                each buf_chk-gds no-lock where
     1914                     buf_chk-gds.doc-code = buf_chk-doc.doc-code and
     1915                     buf_chk-gds.pl-code  = tt-info.pl-code
     1916                     :
     1917                find first buf_chk-discnt no-lock where
     1918                           buf_chk-discnt.doc-code = buf_chk-doc.doc-code and
     1919                           buf_chk-discnt.promo-id > ""   and
     1920                           buf_chk-discnt.record-type = 1 and
     1921                           buf_chk-discnt.object-line-num = buf_chk-gds.line-num
     1922                     no-error.
     1923                assign
     1924                    tt-info.ret-doc-code = buf_chk-gds.doc-code
     1925                    tt-info.ret-chk-num = buf_chk-doc.chk-num
     1926                    tt-info.ret-chk-date = buf_chk-doc.chk-date
     1927                    tt-info.ret-shift-num = buf_chk-doc.shift-num
     1928                    tt-info.ret-shift-date = buf_chk-doc.shift-date
     1929                    .
     1930                 if ChkPromoPrice(buf_chk-gds.doc-code, buf_chk-gds.line-num) then
     1931                   assign
     1932                     tt-info.ret-promo-qnty = -1 * buf_chk-gds.src-qnty
     1933                     v-sum-r = RoundUp(buf_chk-gds.src-qnty, buf_chk-gds.src-price)
     1934                     v-sum-no-disc = v-sum-r
     1935                     v-sum-disc = 0
     1936                     tt-info.ret-nodiscnt = no
     1937                     .
     1938                 else do:
     1939                      if ChkDopLitr(buf_chk-gds.doc-code, buf_chk-gds.line-num)
     1940                      then
     1941                        assign
     1942                           tt-info.dop-qnty = tt-info.dop-qnty - buf_chk-gds.src-qnty
     1943                           tt-info.dop-sum = tt-info.dop-sum - Round(buf_chk-gds.src-price * buf_chk-gds.src-qnty, 2)
     1944                           v-sum-disc = 0
     1945                           tt-info.ret-nodiscnt = no
     1946                           .
     1947                      else
     1948                         assign
     1949                            tt-info.ret-src-price = buf_chk-gds.src-price
     1950                            tt-info.ret-discnt = if avail buf_chk-discnt then buf_chk-discnt.discnt-value-abs / buf_chk-gds.src-qnty else 0
     1951                            v-sum-disc = ChkPromoSum(buf_chk-gds.doc-code, buf_chk-gds.line-num)
     1952                            tt-info.ret-nodiscnt = if (v-sum-disc = 0 and tt-info.ret-discnt = 0) then yes else no.
     1953                            .
     1954                      assign
     1955                         tt-info.ret-discnt = if avail buf_chk-discnt then buf_chk-discnt.discnt-value-abs / buf_chk-gds.src-qnty else 0
     1956                         v-sum-r = Round((buf_chk-gds.src-price - tt-info.ret-discnt) * buf_chk-gds.src-qnty, 2)
     1957                         tt-info.ret-src-qnty = tt-info.ret-src-qnty - buf_chk-gds.src-qnty
     1958                         v-sum-no-disc = if tt-info.ret-nodiscnt then Round(tt-info.src-price * buf_chk-gds.src-qnty, 2)
     1959                                                                 else (Round(buf_chk-gds.src-price * buf_chk-gds.src-qnty, 2) + v-sum-disc)
     1960                         .
     1961                 end.
     1962                 assign
     1963                    tt-info.ret-src-sum = tt-info.ret-src-sum - v-sum-r
     1964                    tt-info.ret-sum-no-disc = tt-info.ret-sum-no-disc - v-sum-no-disc
     1965                    .
     1966                 if tt-info.ret-cashier = "" then do:
     1967                     find first buf_person where
     1968                                buf_person.psn-code = buf_chk-doc.cashier-psn-code
     1969                        no-lock no-error.
     1970                     if avail buf_person THEN
     1971                        tt-info.ret-cashier = buf_person.name1 + ' ' + buf_person.name2 + ' '.
     1972                     find first buf_clients where
     1973                                buf_clients.obj-code = buf_chk-doc.cashier-psn-code  and
     1974                                buf_clients.obj-type = 'чел'
     1975                        no-lock no-error.
     1976                     if avail buf_clients then
     1977                        tt-info.ret-cashier = tt-info.ret-cashier + buf_clients.obj-name.
     1978                 end.
     1979           end.
     1980           assign
     1981              tt-info.itog-qnty = tt-info.src-qnty - tt-info.ret-src-qnty - tt-info.ret-promo-qnty
     1982              tt-info.itog-sum-no-disc = tt-info.src-sum-no-disc - tt-info.ret-sum-no-disc
     1983              tt-info.itog-sum = tt-info.src-sum - tt-info.ret-src-sum
     1984              tt-info.itog-sum-disc = tt-info.itog-sum-no-disc - tt-info.itog-sum
     1985              tt-info.itog-proc = tt-info.itog-sum-disc * 100 / tt-info.itog-sum-no-disc
     1986              tt-info.sts = (if (tt-info.src-promo-qnty > 0 and tt-info.ret-promo-qnty > 0 and tt-info.ret-src-qnty = 0)
     1987                                 or (tt-info.src-promo-qnty > 0 and tt-info.src-promo-qnty = tt-info.ret-promo-qnty)
     1988                                 or tt-info.itog-qnty = 0
     1989                             then "1"
     1990                             else "0")
     1991              .
     1992       end.
     1993   end.
