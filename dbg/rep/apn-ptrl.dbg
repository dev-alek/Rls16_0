     3599   procedure get-ptrl-prop :
     3600     define input  parameter p-obj-type as character no-undo .
     3601     define input  parameter p-obj-code as integer   no-undo .
     3602     do
     3603     on error  undo, return error substitute( "&1 (get-ptrl-prop). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     3604     on stop   undo, return error substitute( "&1 (get-ptrl-prop). stop", vss-workfile )
     3605     on endkey undo, return error substitute( "&1 (get-ptrl-prop). endkey", vss-workfile )
     3606     :
     3607       define variable par-type          as character no-undo.
     3608       define variable v-value-character as character no-undo .
     3609       define variable v-value-date      as date      no-undo .
     3610       define variable v-value-decimal   as decimal   no-undo .
     3611       define variable v-value-integer   as integer   no-undo .
     3612       define variable v-value-logical   as logical   no-undo .
     3613       for each thbjattr_thbj-attr
     3614       :
     3615         delete thbjattr_thbj-attr .
     3616       end.
     3617       run adm/shattri.p
     3618         ( input "get":U
     3619         , input p-obj-type
     3620         , input p-obj-code
     3621         , input 'petrol':U
     3622         , input  ""
     3623         , output v-value-character
     3624         , output v-value-date
     3625         , output v-value-decimal
     3626         , output v-value-integer
     3627         , output v-value-logical
     3628         , output par-type
     3629         , input-output table thbjattr_thbj-attr
     3630         ) no-error .
     3631       for each thbjattr_thbj-attr
     3632       on error undo, return error return-value
     3633       :
     3634         case thbjattr_thbj-attr.prop-code :
     3635           when 'denstclc':U then do:
     3636             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
     3637               assign
     3638                 ptrlprop-denstclc = thbjattr_thbj-attr.property-value-character
     3639               .
     3640             end.
     3641           end.
     3642           when 'expptrl':U then do:
     3643             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
     3644               and thbjattr_thbj-attr.prop-value-type = 'character':U
     3645             then do:
     3646               assign
     3647                 ptrlprop-expptrl = thbjattr_thbj-attr.property-value-character
     3648               .
     3649             end.
     3650           end.
     3651           when 'inpptrl':U then do:
     3652             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
     3653               and thbjattr_thbj-attr.prop-value-type = 'character':U
     3654             then do:
     3655               assign
     3656                 ptrlprop-inpptrl = thbjattr_thbj-attr.property-value-character
     3657               .
     3658             end.
     3659           end.
     3660           when 'autopump':U then do:
     3661             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     3662               assign
     3663                 ptrlprop-autopump = thbjattr_thbj-attr.property-value-logical
     3664               .
     3665             end.
     3666           end.
     3667           when 'rvsnmter':U then do:
