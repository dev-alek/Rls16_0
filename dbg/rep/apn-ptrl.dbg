     4718   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4719   define new global shared variable g#lib-calc as handle no-undo .
     4720   FUNCTION MonthNameRusCase RETURNS CHARACTER ( INPUT i-month AS INTEGER, INPUT i-case AS INTEGER ) :
     4721     DEFINE VARIABLE v-name AS CHARACTER NO-UNDO.
     4722     RUN get-month-name-case IN THIS-PROCEDURE ( INPUT i-month, INPUT i-case, OUTPUT v-name ) NO-ERROR.
     4723     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-name ).
     4724   END FUNCTION.
     4725   PROCEDURE get-month-name-case :
     4726     DEFINE  INPUT PARAMETER p-month AS INTEGER   NO-UNDO.
     4727     DEFINE  INPUT PARAMETER p-case  AS INTEGER   NO-UNDO.
     4728     DEFINE OUTPUT PARAMETER p-name  AS CHARACTER NO-UNDO.
     4729     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO EXTENT 6 INITIAL
     4730       [ "Январь,Февраль,Март,Апрель,Май,Июнь,Июль,Август,Сентябрь,Октябрь,Ноябрь,Декабрь",
     4731         "января,февраля,марта,апреля,мая,июня,июля,августа,сентября,октября,ноября,декабря",
     4732         "Январю,Февралю,Марту,Апрелю,Маю,Июню,Июлю,Августу,Сентябрю,Октябрю,Ноябрю,Декабрю",
     4733         "Январь,Февраль,Март,Апрель,Май,Июнь,Июль,Август,Сентябрь,Октябрь,Ноябрь,Декабрь",
     4734         "Январем,Февралем,Мартом,Апрелем,Маем,Июнем,Июлем,Августом,Сентябрем,Октябрем,Ноябрем,Декабрем",
     4735         "Январе,Феврале,Марте,Апреле,Мае,Июне,Июле,Августе,Сентябре,Октябре,Ноябре,Декабре"              ].
     4736     DO ON ERROR UNDO, RETURN ERROR :
     4737       IF p-month < 1 OR p-month > 12 OR
     4738          p-case  < 1 OR p-case  >  6 THEN DO:
     4739         ASSIGN p-name = ?.
     4740       END.                           ELSE DO:
     4741         ASSIGN p-name = ENTRY( p-month, v-list[ p-case ] ).
     4742       END.
     4743     END.
     4744   END PROCEDURE.
     4745   define variable g#report-num    as integer      no-undo .
     4746   define variable g#quest-print   as logical      no-undo .
     4747   define variable g#log           as logical      no-undo .
     4748   define variable vss-include-info20 as character format "X(65)" no-undo
     4749   initial "@(#)$Workfile$ $Revision$".
     4750   define stream excel-line .
     4751   define stream excel-cell .
     4752   define temp-table temp_cell-data no-undo
     4753       field data-key   as character
     4754       field data-value as character
     4755       index pi is primary unique data-key
     4756   .
     4757   define variable v-apn-xl-cell-file-name  as character    no-undo .
     4758   define variable v-apn-xl-data-file-name  as character    no-undo .
     4759   procedure apn-xl-init :
     4760   do
     4761   on error undo, return error
     4762   :
     4763           run gbl/_tmpfile.p (
     4764             input "xd"
     4765           , input ".txt"
     4766           , output v-apn-xl-data-file-name
     4767       ).
     4768       output stream excel-line to value( v-apn-xl-data-file-name ).
     4769       run gbl/_tmpfile.p (
     4770             input "xc"
     4771           , input ".txt"
     4772           , output v-apn-xl-cell-file-name
     4773       ).
     4774       output stream excel-cell to value( v-apn-xl-cell-file-name ).
     4775       run apn-xl-write-cell-data in this-procedure (
     4776             input "valutCode":U
     4777           , input "0":U
     4778       ).
     4779       run apn-xl-write-cell-data in this-procedure (
     4780             input "columnList":U
     4781           , input "":U
     4782       ).
     4783       run apn-xl-write-cell-data in this-procedure (
     4784             input "columnType":U
     4785           , input "":U
     4786       ).
     4787       run apn-xl-write-cell-data in this-procedure (
     4788             input "columnAmount":U
     4789           , input "0":U
     4790       ).
     4791   end.
     4792   end procedure.
     4793   procedure apn-xl-write-cell-data :
     4794   define input parameter p-data-key   as character        no-undo.
     4795   define input parameter p-data-value as character        no-undo.
     4796       define buffer buf_temp_cell-data     for temp_cell-data.
     4797   do
     4798   for buf_temp_cell-data
     4799   on error undo, return error
     4800   :
     4801       find first buf_temp_cell-data
     4802            where buf_temp_cell-data.data-key = p-data-key
     4803       no-error.
     4804       if not available buf_temp_cell-data
     4805       then do:
     4806           create buf_temp_cell-data.
     4807           assign
     4808               buf_temp_cell-data.data-key = p-data-key
     4809           .
     4810       end.
     4811       assign
     4812           buf_temp_cell-data.data-value = p-data-value
     4813       .
     4814       put stream excel-cell unformatted
     4815                           buf_temp_cell-data.data-key
     4816           chr(9)   buf_temp_cell-data.data-value
     4817           chr(10)
     4818       .
     4819   end.
     4820   end procedure.
     4821   procedure apn-xl-run-excel :
     4822   define input parameter p-header-filename    as character    no-undo .
     4823   define input parameter p-data-filename      as character    no-undo .
     4824   define variable v-template-file-name        as character    no-undo .
     4825   define variable v-vb-file-name              as character    no-undo .
     4826       define buffer buf_temp-param for temp-param .
     4827   do
     4828   for buf_temp-param
     4829   on error undo, return error
     4830   :
     4831       create buf_temp-param.
     4832       assign
     4833           v-template-file-name    = search( "exe/akt-p-n-petrl.xlt" )
     4834           v-vb-file-name          = search( "exe/akt-p-n-petrl.bas")
     4835       .
     4836       if v-template-file-name = ?
     4837       or v-template-file-name = "":U
     4838       then do:
     4839           message
     4840               "Ошибка имени файла шаблона."
     4841           view-as alert-box error.
     4842       end.
     4843       if v-vb-file-name = ?
     4844       or v-vb-file-name = "":U
     4845       then do:
     4846           message
     4847               "Ошибка имени файла кода обработки."
     4848           view-as alert-box error.
     4849       end.
     4850       run paramls-write in this-procedure (
     4851             input "template":U
     4852           , input "template-file-name":U
     4853           , input v-template-file-name
     4854       ).
     4855       run paramls-write in this-procedure (
     4856             input "template":U
     4857           , input "vb-file-name":U
     4858           , input v-vb-file-name
     4859       ).
     4860       run paramls-write in this-procedure (
     4861             input "data":U
     4862           , input "data-header-filename":U
     4863           , input p-header-filename
     4864       ).
     4865       run paramls-write in this-procedure (
     4866             input "data":U
     4867           , input "data-filename":U
     4868           , input p-data-filename
     4869       ).
     4870       run gbl/macroxlt.p (
     4871           input-output table buf_temp-param
     4872       ) no-error.
     4873       if error-status :error
     4874       then do:
     4875           message
     4876                    vss-workfile vss-revision vss-description
     4877               skip(1)
     4878               skip "Ошибка создания файла Excel."
     4879               skip return-value
     4880               skip trim(error-status :get-message(1))
     4881                    trim(error-status :get-message(2))
     4882                    trim(error-status :get-message(3))
     4883           view-as alert-box error.
     4884           undo, return error .
     4885       end.
     4886   end.
     4887   end procedure.
     4888   procedure apn-xl-close :
     4889   do
     4890   on error undo, return error
     4891   :
     4892       output stream excel-line close.
     4893       output stream excel-cell close.
     4894       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     4895           export "exe/akt-p-n-petrl.xlt":U.
     4896           export "exe/akt-p-n-petrl.bas":U.
     4897           export v-apn-xl-cell-file-name.
     4898           export v-apn-xl-data-file-name.
     4899       output close.
     4900   end.
     4901   end procedure.
