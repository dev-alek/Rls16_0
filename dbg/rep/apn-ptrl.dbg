     5586           run apn-xl-write-cell-data in this-procedure (
     5587                 input "diff_qnty_kg":U
     5588               , input fnc-convert-dot-to-colon(
     5589                                               ( - v-InfoSectionsTotal:GetInfoSectionProp(iNum):CliQnty +
     5590                                               ((decimal(v-car-vol) + decimal(v-mouth)) * decimal(v-tank-density)))
     5591                                               , "->>>>>>>>9.999")
     5592           ).
     5593           do:
     5594               v-diff-qnty-kg = (- v-InfoSectionsTotal:GetInfoSectionProp(iNum):CliQnty +
     5595                                ((decimal(v-car-vol) + decimal(v-mouth)) * decimal(v-tank-density))).
     5596               v-error-meas-kg = (((decimal(v-car-vol) + decimal(v-mouth)) * decimal(v-tank-density)) * K1).
     5597               if  false then
     5598               do:
     5599                   v-shortage-surplus-kg = 0.
     5600               end.
     5601               else
     5602               do:
     5603                   if v-diff-qnty-kg < 0 then do:
     5604                     v-shortage-surplus-kg = v-diff-qnty-kg + v-norm-natur-loss .
     5605                   end.
     5606                   else v-shortage-surplus-kg = v-diff-qnty-kg - v-norm-natur-loss.
     5607               end.
     5608           end.
     5609           run apn-xl-write-cell-data in this-procedure (
     5610                 input "shortage_surplus_kg":U
     5611               , input fnc-convert-dot-to-colon(v-shortage-surplus-kg, "->>>>>>>>9.999")
     5612           ).
     5613           run apn-xl-write-cell-data in this-procedure (
     5614                 input "diff_norm_natur_losses":U
     5615               , input fnc-convert-dot-to-colon(
     5616                                               (v-norm-natur-loss)
     5617                                               , "->>>>>>>>9.999")
     5618           ).
     5619           run proc-calc-library-pomi (
     5620               input decimal(buf_doc-line.doc-qnty),
     5621               input decimal(buf_doc-line.doc-qnty),
     5622               input decimal(0),
     5623               input v-diameter,
     5624               input decimal(buf_doc-line.temperature),
     5625               input decimal(buf_doc-line.doc-density),
     5626               input decimal(buf_doc-line.temperature),
     5627               input integer(v-place-si),
     5628               input v-doc-code,
     5629               input v-gds-code,
     5630               output v-tank-density-pomi-dll,
     5631               output v-tank-vol-pomi-dll,
     5632               output v-tank-weight-pomi-dll
     5633           ).
     5634           run apn-xl-write-cell-data in this-procedure (
     5635                 input "tank_vol_pomi_DLL":U
     5636               , input fnc-convert-dot-to-colon(v-tank-vol-pomi-dll, "->>>>>>>>9.999")
     5637           ).
     5638           run apn-xl-write-cell-data in this-procedure (
     5639                 input "tank_density_pomi_DLL":U
     5640               , input fnc-convert-dot-to-colon(v-tank-density-pomi-dll, "->>>>>>>>9.9999")
     5641           ).
     5642           run apn-xl-write-cell-data in this-procedure (
     5643                 input "tank_weight_DLL":U
     5644               , input fnc-convert-dot-to-colon(v-tank-weight-pomi-dll, "->>>>>>>>9.999")
     5645           ).
     5646           run apn-xl-write-cell-data in this-procedure (
     5647                 input "diff_tnk_dens_pomi_15C":U
     5648               , input fnc-convert-dot-to-colon(
     5649                                               (- v-tank-density-pomi-dll + decimal(v-tank-density-pomi))
     5650                                               , "->>>>>>>>9.9999")
     5651           ).
     5652           run apn-xl-write-cell-data in this-procedure (
     5653                 input "diff_tank_vol_pomi_15C":U
     5654               , input fnc-convert-dot-to-colon(
     5655                                               (- v-tank-vol-pomi-dll + decimal(v-tank-vol-pomi))
     5656                                               , "->>>>>>>>9.999")
     5657           ).
     5658           run apn-xl-write-cell-data in this-procedure (
     5659                 input "diff_qnty_kg_15C":U
     5660               , input fnc-convert-dot-to-colon(
     5661                                               (- v-tank-weight-pomi-dll + decimal(v-tank-weight))
     5662                                               , "->>>>>>>>9.999")
     5663           ).
     5664           do:
     5665               v-diff-qnty-kg-15C = - v-tank-weight-pomi-dll + decimal(v-tank-weight).
     5666               v-error-meas-kg-15C = decimal(v-tank-weight) * K1.
     5667               if  false then
     5668               do:
     5669                   v-shortage-surplus-kg-15C = 0.
     5670               end.
     5671               else
     5672               do:
     5673                   if v-diff-qnty-kg-15C < 0 then do:
     5674                   v-shortage-surplus-kg-15C = v-diff-qnty-kg-15C + v-norm-natur-loss-15C .
     5675                   end.
     5676                   else v-shortage-surplus-kg-15C = v-diff-qnty-kg-15C - v-norm-natur-loss-15C.
     5677               end.
     5678           end.
     5679           run apn-xl-write-cell-data in this-procedure (
     5680                 input "shor_surplus_kg_15C":U
     5681               , input fnc-convert-dot-to-colon(v-shortage-surplus-kg-15C, "->>>>>>>>9.999")
     5682           ).
     5683           run apn-xl-write-cell-data in this-procedure (
     5684                 input "diff_norm_nat_los_15C":U
     5685               , input fnc-convert-dot-to-colon(
     5686                                               (v-norm-natur-loss-15C)
     5687                                               , "->>>>>>>>9.999")
     5688           ).
     5689           run apn-xl-write-cell-data in this-procedure (
     5690                 input "driver_name4":U
     5691               , input v-fio
     5692           ).
     5693           run apn-xl-write-cell-data in this-procedure (
     5694                 input "host_name3":U
     5695               , input v-clients-boss-name
     5696           ).
     5697               define variable v-num-doc as character no-undo.
     5698               v-num-doc = v-nakl + "/" + string(buf_doc-line.line-num).
     5699               if v-shortage-surplus-kg > v-norm-natur-loss or v-shortage-surplus-kg-15C > v-norm-natur-loss-15C then
     5700               do:
     5701                   v-num-doc = v-num-doc + "Н".
     5702               end.
     5703               else
     5704               do:
     5705                   v-num-doc = v-num-doc + "Б".
     5706               end.
     5707               run apn-xl-write-cell-data in this-procedure (
     5708                     input "num_doc":U
     5709                   , input (v-num-doc)
     5710               ).
     5711           run apn-xl-close in this-procedure.
     5712       end.
     5713       end.
     5714       end.
     5715   if g#quest-print = false
     5716   then do:
     5717     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     5718                                         7, (if 4 >= 8 then 2 else 0), 0, 0,
     5719                                         OUTPUT g#log ).
     5720   end.
     5721   else do:
     5722     os-command silent
     5723       value( "COPY /b " +
     5724         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     5725         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     5726         string( session:temp-directory) +  "$" + string( g#report-num )
     5727                 ) .
     5728     os-command silent
     5729       value( "COPY /b " +
     5730         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     5731         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     5732         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     5733                 ) .
     5734   end.
     5735   if session :set-wait-state( "" ) then.
     5736   end.
     5737   procedure get-DD-MM-YYYY:
     5738       define input parameter p-dat-date as date no-undo.
     5739       define output parameter p-str-date as character no-undo.
     5740       p-str-date = replace(string(p-dat-date,'99.99.9999'), "/", ".").
     5741   end procedure.
     5742   procedure get-DD-Month-YYYY:
     5743       define input parameter p-dat-date as date no-undo.
     5744       define output parameter p-str-date as character no-undo.
     5745       define variable v-str-date as character no-undo.
     5746       define variable v-str-day as character no-undo.
     5747       define variable v-num-month as character no-undo.
     5748       define variable v-str-month as character no-undo.
     5749       define variable v-str-year as character no-undo.
     5750       v-str-date = string(p-dat-date).
     5751       do:
     5752           v-str-day = string(entry(1, v-str-date, "/")).
     5753       end.
     5754       do:
     5755       v-num-month = entry(2, v-str-date, "/").
     5756       v-str-month = MonthNameRusCase(integer(v-num-month), 2).
     5757       end.
     5758       do:
     5759           v-str-year = string(year(p-dat-date)).
     5760       end.
     5761       p-str-date = v-str-day + " " + v-str-month + " " + v-str-year + "г.".
     5762   end procedure.
     5763   procedure loc-get-set-attr :
     5764     define input  parameter p-mode-attr as character no-undo .
     5765     do
     5766     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     5767     on stop   undo, return error substitute( "&1. stop", vss-workfile )
     5768     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     5769     :
     5770       define buffer buf_doc-line-attr for ub.doc-line-attr .
     5771           find first buf_doc-attr     where buf_doc-attr.doc-code  = v-doc-code       and buf_doc-attr.attr-code = "car-num"     no-error.
     5772       if p-mode-attr = "get-attr":U then do:
     5773         if available buf_doc-attr then do:       assign         v-car-num = buf_doc-attr.attr-value       .     end.
     5774       end.
     5775       else do:
     5776       end.
     5777           find first buf_doc-attr     where buf_doc-attr.doc-code  = v-doc-code       and buf_doc-attr.attr-code = "inspection-cert"     no-error.
     5778       if p-mode-attr = "get-attr":U then do:
     5779         if available buf_doc-attr then do:       assign         v-inspection-cert = buf_doc-attr.attr-value       .     end.
     5780       end.
     5781           find first buf_doc-attr     where buf_doc-attr.doc-code  = v-doc-code       and buf_doc-attr.attr-code = "date-cert"     no-error.
     5782       if p-mode-attr = "get-attr":U then do:
     5783         if available buf_doc-attr then do:       assign         v-date-cert = date(buf_doc-attr.attr-value)       .     end.
     5784       end.
     5785           find first buf_doc-attr     where buf_doc-attr.doc-code  = v-doc-code       and buf_doc-attr.attr-code = "autoent"     no-error.
     5786       if p-mode-attr = "get-attr":U then do:
     5787               assign
     5788           v-autoent-obj-type = entry (1, buf_doc-attr.attr-value, ";")
     5789         no-error.
     5790       end.
     5791           find first buf_doc-attr     where buf_doc-attr.doc-code  = v-doc-code       and buf_doc-attr.attr-code = "autoent"     no-error.
     5792       if p-mode-attr = "get-attr":U then do:
     5793               assign
     5794           v-autoent-obj-code = entry (2, buf_doc-attr.attr-value, ";")
     5795         no-error.
     5796       end.
     5797           find first buf_doc-attr     where buf_doc-attr.doc-code  = v-doc-code       and buf_doc-attr.attr-code = "ptb-item-pour"     no-error.
     5798       if p-mode-attr = "get-attr":U then do:
     5799               if available buf_doc-attr then do:       assign         v-item-pour = buf_doc-attr.attr-value       .     end.
     5800       end.
     5801           find first buf_doc-attr     where buf_doc-attr.doc-code  = v-doc-code       and buf_doc-attr.attr-code = "time-income"     no-error.
     5802       if p-mode-attr = "get-attr":U then do:
     5803         if available buf_doc-attr then do:       assign         v-time-income = buf_doc-attr.attr-value       .     end.
     5804       end.
     5805           find first buf_doc-attr     where buf_doc-attr.doc-code  = v-doc-code       and buf_doc-attr.attr-code = "fio-driver"     no-error.
     5806       if p-mode-attr = "get-attr":U then do:
     5807               if available buf_doc-attr then do:       assign         v-fio = buf_doc-attr.attr-value       .     end.
     5808       end.
     5809       else do:
     5810       end.
     5811           find first buf_doc-attr     where buf_doc-attr.doc-code  = v-doc-code       and buf_doc-attr.attr-code = "ptbobj"     no-error.
     5812       if p-mode-attr = "get-attr":U then do:
     5813               assign
     5814           v-ptbotype = entry (1, buf_doc-attr.attr-value, ";")
     5815         no-error.
     5816       end.
     5817       else do:
     5818       end.
     5819           find first buf_doc-attr     where buf_doc-attr.doc-code  = v-doc-code       and buf_doc-attr.attr-code = "ptbobj"     no-error.
     5820       if p-mode-attr = "get-attr":U then do:
     5821               assign
     5822           v-ptbocode = entry (2, buf_doc-attr.attr-value, ";")
     5823         no-error.
     5824       end.
     5825       else do:
     5826       end.
     5827           find first buf_doc-attr     where buf_doc-attr.doc-code  = v-doc-code       and buf_doc-attr.attr-code = "time-pour"     no-error.
     5828       if p-mode-attr = "get-attr":U then do:
     5829               assign
     5830           v-time-pour = buf_doc-attr.attr-value
     5831         no-error.
     5832       end.
     5833       else do:
     5834       end.
     5835               assign         v-car-vol = string(v-InfoSectionsTotal:GetInfoSectionProp(iNum):CarVol)      .
     5836               assign         v-dens-temp = string(v-InfoSectionsTotal:GetInfoSectionProp(iNum):DensTemp)      .
     5837               assign         v-tank-vol-pomi = string(v-InfoSectionsTotal:GetInfoSectionProp(iNum):TankVolPomi)      .
     5838               assign         v-tank-density-pomi = string(v-InfoSectionsTotal:GetInfoSectionProp(iNum):TankDensityPomi)      .
     5839               assign         v-place-si = string(v-InfoSectionsTotal:GetInfoSectionProp(iNum):PlaceSi)      .
     5840               assign         v-tests = string(v-InfoSectionsTotal:GetInfoSectionProp(iNum):Tests)      .
     5841               assign         v-certif-fuel = string(v-InfoSectionsTotal:GetInfoSectionProp(iNum):CertifFuel)      .
     5842               assign         v-norm-doc = string(v-InfoSectionsTotal:GetInfoSectionProp(iNum):NormDoc)      .
     5843               assign         v-num-passport = string(v-InfoSectionsTotal:GetInfoSectionProp(iNum):NumPassport)      .
     5844               assign         v-validity-certif = string(v-InfoSectionsTotal:GetInfoSectionProp(iNum):ValidityCertif)      .
     5845               assign         v-num-plotn = string(v-InfoSectionsTotal:GetInfoSectionProp(iNum):NumPlotn)      .
     5846               assign         v-passport-plotn = string(v-InfoSectionsTotal:GetInfoSectionProp(iNum):PassportPlotn)      .
     5847               assign         v-date-pov-plotn = v-InfoSectionsTotal:GetInfoSectionProp(iNum):DatePovPlotn      .
     5848               assign         v-date-start = v-InfoSectionsTotal:GetInfoSectionProp(iNum):DateStart      .
     5849               assign         v-time-start = v-InfoSectionsTotal:GetInfoSectionProp(iNum):TimeStart      .
     5850               assign         v-date-end = v-InfoSectionsTotal:GetInfoSectionProp(iNum):DateEnd      .
     5851               assign         v-time-end = v-InfoSectionsTotal:GetInfoSectionProp(iNum):TimeEnd      .
     5852               assign         v-tank-vol = string(v-InfoSectionsTotal:GetInfoSectionProp(iNum):TankVol)      .
     5853               assign         v-tank-temp = string(v-InfoSectionsTotal:GetInfoSectionProp(iNum):TankTemp)      .
     5854               assign         v-tank-water = string(v-InfoSectionsTotal:GetInfoSectionProp(iNum):TankWater)      .
     5855               assign         v-tank-density = string(v-InfoSectionsTotal:GetInfoSectionProp(iNum):TankDensity)      .
     5856               assign         v-tank-weight = string(v-InfoSectionsTotal:GetInfoSectionProp(iNum):TankWeight)      .
     5857               assign         v-mouth = string(v-InfoSectionsTotal:GetInfoSectionProp(iNum):Mouth)      .
     5858               assign         v-a-b-tarir = string(v-InfoSectionsTotal:GetInfoSectionProp(iNum):ABTarir)      .
     5859       return .
     5860     end.
     5861   end procedure.
     5862   procedure proc-calc-library-pomi:
     5863       define input parameter p-car-vol as decimal no-undo.
     5864       define input parameter p-tank-vol as decimal no-undo.
     5865       define input parameter p-a-b-tarir as decimal no-undo.
     5866       define input parameter p-diameter as decimal no-undo.
     5867       define input parameter p-tank-temp as decimal no-undo.
     5868       define input parameter p-tank-density as decimal no-undo.
     5869       define input parameter p-dens-temp as decimal no-undo.
     5870       define input parameter p-place-si as integer no-undo.
     5871       define input parameter p-doc-code like ub.trn-doc.doc-code no-undo.
     5872       define input parameter p-gds-code like ub.goods.gds-code no-undo.
     5873       define output parameter p-tank-density-pomi as decimal no-undo.
     5874       define output parameter p-tank-vol-pomi as decimal no-undo.
     5875       define output parameter p-tank-weight as decimal no-undo.
     5876       define variable ToolType as integer no-undo.
     5877       define variable DeltaAbs_R as decimal no-undo.
     5878       define variable DeltaAbs_Tv as decimal no-undo.
     5879       define variable DeltaAbs_Tr as decimal no-undo.
     5880       define variable temp-for-pomi as integer no-undo.
     5881       define variable error-string as character no-undo.
     5882       define variable v-mm as com-handle.
     5883       define variable v-proc as character no-undo.
     5884       define variable v-gds-attr-value as character no-undo.
     5885       define variable v-gds-attr-type as character no-undo.
     5886       define variable v-fuel-type as character no-undo.
     5887       define variable rdc-dnstvalue as character no-undo.
     5888       define variable rdc-dnsttype as character no-undo.
     5889       define buffer buf_sr-izmerenia for ub.sr-izmerenia .
     5890       run gbl/conf-rd.p ("rdc-dnst", "", "", 0, "", "", "", no, output rdc-dnstvalue, output rdc-dnsttype) no-error.
     5891       case rdc-dnstvalue:
     5892           when "pomi-rn" then
     5893           do:
     5894               _trpomi:
     5895                   do on error undo, return no-apply:
     5896                       find first buf_sr-izmerenia no-lock where buf_sr-izmerenia.node-code = p-place-si no-error.
     5897                       if not available buf_sr-izmerenia then
     5898                       do:
     5899                           message
     5900                               substitute('Не найдено средство измерения с кодом &1', p-place-si) skip
     5901                           view-as alert-box error.
     5902                           undo _trpomi, return no-apply.
     5903                       end.
     5904                       else
     5905                       do:
     5906                           assign
     5907                               ToolType    = buf_sr-izmerenia.sr-type-id
     5908                               DeltaAbs_R  = buf_sr-izmerenia.sr-abs-err-dens
     5909                               DeltaAbs_Tv = buf_sr-izmerenia.sr-abs-err-temp-vol
     5910                               DeltaAbs_Tr = buf_sr-izmerenia.sr-abs-err-temp-dens
     5911                           .
     5912                       end.
     5913                       find first ub.trn-doc no-lock where ub.trn-doc.doc-code = p-doc-code no-error.
     5914   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5915   run get-ptrl-prop in this-procedure
     5916     ( input trn-doc.obj-type
     5917     , input trn-doc.obj-code
     5918     ) .
     5919                       if not error-status :error then
     5920                       do:
     5921                           if ptrlprop-temp-for-pomi = 1 then temp-for-pomi = 15.
     5922                                                         else temp-for-pomi = 20.
     5923                       end.
     5924                       v-proc = "Rosneft.MethodOfMetering31" .
     5925                       release object v-mm no-error.
     5926                       v-mm = ?.
     5927                       create value("Rosneft.MethodOfMetering31") v-mm no-error.
     5928                       if error-status:error or not valid-handle(v-mm) then
     5929                       do:
     5930                           release object v-mm no-error.
     5931                           v-mm = ?.
     5932                           message
     5933                               substitute('Не удается подключиться к COM-серверу библиотеки для работы с ПО МИ ') skip
     5934                           view-as alert-box error.
     5935                           undo _trpomi, return no-apply.
     5936                       end.
     5937                       else
     5938                       do:
     5939                           assign
     5940                               v-mm:V_real         = p-car-vol
     5941                               v-mm:DeltaH         = p-a-b-tarir
     5942                               v-mm:Dgor           = p-diameter
     5943                               v-mm:Tv             = p-tank-temp
     5944                               v-mm:Tr             = p-dens-temp
     5945                               v-mm:R              = (p-tank-density * 1000)
     5946                               v-mm:Tcy            = temp-for-pomi
     5947                               v-mm:ToolType       = ToolType
     5948                               v-mm:A_Reservoir    = 0.0000125
     5949                               v-mm:DeltaOtn_V     = 0.4
     5950                               v-mm:DeltaAbs_R     = DeltaAbs_R
     5951                               v-mm:DeltaAbs_Tv    = DeltaAbs_Tv
     5952                               v-mm:DeltaAbs_Tr    = DeltaAbs_Tr
     5953                           .
     5954                           v-mm:Exec().
     5955                           if v-mm:Result <> 0 then
     5956                           do:
     5957                               error-string = v-mm:ResultDetail.
     5958                               release object v-mm no-error.
     5959                               v-mm = ?.
     5960                               message
     5961                                   substitute('Ошибка работы библиотеки ПО МИ &1',error-string)
     5962                               view-as alert-box error.
     5963                               undo _trpomi, return no-apply.
     5964                           end.
     5965                           else
     5966                           do:
     5967                               assign
     5968                                   p-tank-density-pomi = decimal(v-mm:Rcy) / 1000
     5969                                   p-tank-vol-pomi = v-mm:Vcy
     5970                                   p-tank-weight = v-mm:Mcy
     5971                               .
     5972                               release object v-mm no-error.
     5973                               v-mm = ?.
     5974                           end.
     5975                       end.
     5976                   end.
     5977           end.
     5978           when "th" then
     5979           do:
     5980               run gds-attr-value in this-procedure
     5981                   (  input p-gds-code
     5982                   ,  input 'fuel-type':U
     5983                   , output v-gds-attr-value
     5984                   , output v-gds-attr-type
     5985                   ) no-error.
     5986               if not error-status:error and lookup (v-gds-attr-value, "petrol,diesel-sum,diesel-wint") > 0 then
     5987               do:
     5988                   assign v-fuel-type = v-gds-attr-value.
     5989                   run str/rdcdnst.p (input p-tank-density * 1000
     5990                       ,input p-dens-temp
     5991                       ,input p-tank-vol
     5992                       ,input p-tank-temp
     5993                       ,input v-fuel-type
     5994                       ,output p-tank-density-pomi
     5995                       ,output p-tank-vol-pomi)
     5996                   no-error.
     5997                   if not error-status:error then
     5998                   do:
     5999                       assign p-tank-weight = p-tank-density-pomi * p-tank-vol-pomi.
     6000                   end.
     6001                   else
     6002                   do:
     6003                       message
     6004                           substitute('Ошибка при рассчете приведенных значений плотности и объема: &1', return-value)
     6005                       view-as alert-box error.
     6006                       undo, return no-apply.
     6007                   end.
     6008               end.
     6009               else
     6010               do:
     6011                   message
     6012                       substitute('Ошибка определения типа топлива &1 или не верный тип товлива &2', return-value, v-gds-attr-value)
     6013                   view-as alert-box error.
     6014                   undo, return no-apply.
     6015               end.
     6016           end.
     6017       end case.
     6018   end procedure.
     6019   procedure proc-get-address:
     6020       define input parameter p-cli-obj-type like clients.obj-type no-undo.
     6021       define input parameter p-cli-obj-code like clients.obj-code no-undo.
     6022       define output parameter p-str-address as character no-undo.
     6023       p-cli-obj-type = trim(p-cli-obj-type).
     6024       case p-cli-obj-type:
     6025           when 'орг':U then
     6026           do:
     6027               find first firm where firm.firm-code = p-cli-obj-code no-lock.
     6028               if available firm then
     6029               do:
     6030                   p-str-address =
     6031                   (if trim(firm.post-addr1) = "" then (if trim(firm.post-addr2) = "" then "" else trim(firm.post-addr2) + ".")
     6032                   else (if trim(firm.post-addr2) = "" then trim(firm.post-addr1) + "."
     6033                         else trim(firm.post-addr1) + ", " + trim(firm.post-addr2) + ".")).
     6034               end.
     6035           end.
     6036           when 'маг':U then
     6037           do:
     6038               find first shop where shop.obj-code = p-cli-obj-code no-lock.
     6039                   if available shop then
     6040                   do:
     6041                       p-str-address =
     6042                       (if trim(shop.addres1) = "" then
     6043                           (if trim(shop.addres2) = "" then "" else trim(shop.addres2) + ".")
     6044                        else (if trim(shop.addres2) = "" then trim(shop.addres1) + "."
     6045                              else trim(shop.addres1) + ", " + trim(shop.addres2) + ".")).
     6046                   end.
     6047               end.
     6048           when 'скл':U then
     6049           do:
     6050               find first store where store.obj-code = p-cli-obj-code no-lock.
     6051               if available store then
     6052               do:
     6053                   p-str-address =
     6054                   (if trim(store.addres1) = "" then (if trim(store.addres2) = "" then ""
     6055                                                     else ", " + trim(store.addres2) + ".")
     6056                   else (if trim(store.addres2) = "" then ", " + trim(store.addres1) + "."
     6057                         else ", " + trim(store.addres1) + trim(store.addres2) + ".")).
     6058               end.
     6059           end.
     6060           when 'чел':U then
     6061           do:
     6062               find first person where person.psn-code = p-cli-obj-code no-lock.
     6063               if available person then
     6064               do:
     6065                   p-str-address =
     6066                   (if trim(person.address) = ""  then "" else trim(person.address) + ".").
     6067               end.
     6068           end.
     6069       end case.
     6070   end procedure.
     6071   function fnc-convert-dot-to-colon returns character
     6072   (input p-data as decimal, input p-accur as character):
     6073           define variable result as character no-undo.
     6074       define variable v-str-result as character no-undo.
     6075       p-data = round(p-data, 4).
     6076       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     6077           return v-str-result.
     6078   end function.
     6079   function fnc-DD-MM-YYYY returns character
     6080   (input p-dat-date as date):
     6081       define variable result as character no-undo.
     6082       define variable p-str-date as character no-undo.
     6083       p-str-date = replace(string(p-dat-date,'99.99.9999'), "/", ".").
     6084                   return p-str-date.
     6085   end function.
