      922   gds-brutto.out-wt-brutto COLUMN-LABEL "Расход! вес брутто"   FORMAT "->,>>>,>>9.<<<"
      923   gds-brutto.out-fact-place COLUMN-LABEL "Расход! кол-во мест" FORMAT "->,>>>,>>9.<<<"
      924   gds-brutto.in-qnty - gds-brutto.out-qnty COLUMN-LABEL "Остаток! по приходу"  FORMAT "->,>>>,>>9.<<<"
      925       WITH NO-ROW-MARKERS SEPARATORS SIZE 97.13 BY 11.75.
      926   DEFINE FRAME v-suppl
      927        b-excel at row 1.17 col 45
      928        b-print at row 1.17 col 12
      929        b-help at row 1.17 col 35
      930        b-quit at row 1.17 col 2
