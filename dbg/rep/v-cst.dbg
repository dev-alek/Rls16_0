     1206            sym8
     1207            prt-parts-brutto.unit
     1208            sym9
     1209            prt-parts-brutto.in-qnty
     1210            sym10
     1211            prt-parts-brutto.in-wt-brutto
     1212            sym11
     1213            prt-parts-brutto.out-date
     1214            sym12
     1215            prt-parts-brutto.out-qnty
     1216            sym13
     1217            prt-parts-brutto.out-wt-brutto
     1218            sym14
     1219            varTemp
     1220            sym15
     1221            with FRAME gds-brutto-store.
     1222            DOWN STREAM PrnLibStream 1 with FRAME gds-brutto-store .
     1223         END.
     1224         ELSE DO:
     1225            DISPLAY STREAM PrnLibStream
     1226            sym1
     1227            num-order
     1228            sym2
     1229            prt-parts-brutto.in-date
     1230            sym3
     1231            prt-parts-brutto.cst-code
     1232            sym4
     1233            prt-parts-brutto.tnved
     1234            sym5
     1235            prt-parts-brutto.artic
     1236            sym6
     1237            prt-parts-brutto.gds-name
     1238            sym7
     1239            prt-parts-brutto.nationality
     1240            sym8
     1241            prt-parts-brutto.unit
     1242            sym9
     1243            prt-parts-brutto.in-qnty
     1244            sym10
     1245            prt-parts-brutto.in-fact-place
     1246            sym11
     1247            prt-parts-brutto.in-wt-brutto
     1248            sym12
     1249            prt-parts-brutto.out-qnty
     1250            sym13
     1251            STRING(DECIMAL(prt-parts-brutto.in-qnty) -
     1252            DECIMAL(prt-parts-brutto.out-qnty)) @ in-out-qnty
     1253            sym14
     1254            with FRAME gds-brutto-shop.
