     1144         sym11 column-label ":!:" format "X(1)"
     1145         prt-parts-brutto.in-wt-brutto COLUMN-LABEL "Вес брутто в кг"
     1146         sym12 column-label ":!:" format "X(1)"
     1147         prt-parts-brutto.out-qnty COLUMN-LABEL "Реализовано"
     1148         sym13 column-label ":!:" format "X(1)"
     1149         in-out-qnty COLUMN-LABEL "Остаток"
     1150         sym14 column-label ":!:" format "X(1)"
     1151       HEADER
     1152           cur-time-print() AT 5 format "X(35)"
     1153           string( "Отчет по таможенной позиции: " + partnved) AT 45 format "X(40)"
     1154           string( "Количества указаны в " + (if parcst-units = "Базовая" then "базовых еденицах." else "таможенных еденицах.") ) AT 100 format "X(42)"
     1155           string( "Страница " + string( PAGE-NUMBER( PrnLibStream ), ">>9" ) ) AT 150 format "X(13)" SKIP
     1156           Line format "X(229)" AT 1
     1157       with width 232 down stream-io.
     1158   if session:set-wait-state("COMPILER") then.
     1159   assign Line = fill("-", 232).
     1160   if parkindrep = "OUT" THEN DO:
     1161     run prn-lib-open-stream  in this-procedure (
     1162                                                 input parParentProc
     1163                                                 ,input 43
     1164                                                 ,input yes
     1165                                                 ,input no
     1166                                                 ).
