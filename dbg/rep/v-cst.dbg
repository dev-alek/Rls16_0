      305   define  stream PrnLibStream.
      306   procedure prn-lib-prn-file :
      307     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      308     define input parameter p-DIsabledoptions as integer no-undo .
      309     define variable v-report-name as character no-undo .
      310     define variable v-user-action as character no-undo .
      311     define variable v-printed     as logical   no-undo .
      312     define variable v-exist       as logical   no-undo .
      313     do
      314       on error undo, return error
      315       :
      316       run prn-lib-get-report-name  in this-procedure (
      317         input parParentProc
      318         ,output v-report-name
      319         ).
      320   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      321   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      322     (input  v-report-name
      323     ,input  2
      324     ,output v-exist
      325     )  .
      326       if NOT v-exist then
      327       DO:
      328         Message
      329           "Нет заданий на печать ! "
      330           view-as alert-box .
      331         Return  .
      332       End.
      333       run gbl/prnfilen.w
      334         (input  ""
      335         ,input  p-DisabledOptions
      336         ,input  string(v-report-name )
      337         ,input  7
      338         ,output v-user-action
      339         ,output v-printed
      340         ) .
      341       if v-printed then
      342       do:
      343         return "YES" .
      344       end.
      345       else
      346       do:
      347         return "NO" .
      348       end.
      349     end.
      350   end procedure.
      351   procedure prn-lib-open-stream :
      352     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      353     define input parameter p-page-size    as integer no-undo .
      354     define input parameter p-is-stream    as logical no-undo .
      355     define input parameter p-append       as logical no-undo .
      356     define variable v-report-name as character no-undo .
      357     do
      358       on error undo, return error
      359       :
      360       run prn-lib-get-report-name  in this-procedure (
      361         input parParentProc
      362         ,output v-report-name
      363         ).
      364       if p-is-stream then
      365       do:
      366         if p-append then
      367         do:
      368           output stream PrnLibStream to value( v-report-name )
      369             page-size value(p-page-size) append .
      370         end.
      371         if not p-append then
      372         do:
      373           output stream PrnLibStream to value( v-report-name )
      374             page-size value(p-page-size) .
      375         end.
      376       end.
      377       if not p-is-stream then
      378       do:
      379         if p-append then
      380         do:
      381           output to value( v-report-name )
      382             page-size value(p-page-size) append .
      383         end.
      384         if not p-append then
      385         do:
      386           output to value( v-report-name )
      387             page-size value(p-page-size) .
      388         end.
      389       end.
      390     end.
      391   end procedure.
      392   procedure prn-lib-open-exp :
      393     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      394     define input parameter p-is-stream    as logical no-undo .
      395     define input parameter p-is-append    as logical no-undo .
      396     define output parameter p-ReportFileName as char init "report" no-undo.
      397     define output parameter p-process as logical no-undo .
      398     define variable glog as logical no-undo .
      399     do
      400       on error undo, return error
      401       :
      402       SYSTEM-DIALOG GET-FILE p-ReportFileName
      403         TITLE      "Укажите путь"
      404         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      405         ASK-OVERWRITE
      406         CREATE-TEST-FILE
      407         SAVE-AS
      408         USE-FILENAME
      409         DEFAULT-EXTENSION "txt"
      410         UPDATE glog
      411         .
      412       if not glog then  return.
      413       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      414       if p-is-stream then
      415       do:
      416         if p-is-append then
      417         do:
      418           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      419         end.
      420         else
      421         do:
      422           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      423         end.
      424       end.
      425       else
      426       do:
      427         if p-is-append then
      428         do:
      429           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      430         end.
      431         else
      432         do:
      433           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      434         end.
      435       end.
      436       p-process = yes.
      437     end.
      438   end procedure.
      439   procedure prn-lib-get-report-name :
      440     define input parameter parParentProc  as widget-handle no-undo.
      441     define output parameter p-report-name as character no-undo .
      442     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      443   end procedure.
      444   procedure prn-lib-reportviewer-report-name :
      445     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      446     define input parameter p-report-name-html as character no-undo .
      447     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      448   end procedure.
      449   procedure prn-lib-reportviewer :
      450     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      451     define input parameter p-report-name-html as character no-undo .
      452     define input parameter p-param        as character no-undo .
      453     define variable v-excel           as character no-undo init 'TRUE' .
      454     define variable v-value-character as character no-undo .
      455     define variable v-value-integer   as character no-undo .
      456     define variable v-value-date      as date      no-undo .
      457     define variable v-value-decimal   as decimal   no-undo .
      458     define variable rep-excel         as logical   no-undo .
      459     define variable excel-string      as character no-undo .
      460     define variable v-param-type      as character no-undo .
      461     define variable v-tth             as handle    no-undo .
      462     run adm/shattri.p (
      463       input "get":U
      464       ,input  ""
      465       ,input  0
      466       ,input  'report-glob':U
      467       ,input  'rep-excel':U
      468       ,output v-value-character
      469       ,output v-value-date
      470       ,output v-value-decimal
      471       ,output v-value-integer
      472       ,output rep-excel
      473       ,output v-param-type
      474       ,INPUT-OUTPUT table-handle v-tth
      475       )  .
      476     if rep-excel then v-excel = "TRUE" .
      477     else v-excel = "FALSE" .
      478     if p-param eq ""
      479     then
      480        p-param = "EXCEL:" + v-excel.
      481     else
      482        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      483     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      484   end procedure.
