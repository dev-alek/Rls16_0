     1256         END.
     1257   END.
     1258   IF parkindrep = "OUT" THEN DO:
     1259      PUT STREAM PrnLibStream Line format "X(229)" SKIP.
     1260      DOWN STREAM PrnLibStream 1 with FRAME gds-brutto-store .
     1261   END.
     1262   ELSE DO:
     1263       PUT STREAM PrnLibStream Line format "X(229)" SKIP.
     1264       DOWN STREAM PrnLibStream 1 with FRAME gds-brutto-shop .
     1265   END.
     1266   HIDE STREAM PrnLibStream FRAME BottomFrame .
     1267   OUTPUT STREAM PrnLibStream CLOSE.
     1268   if session:set-wait-state("") then.
     1269   run prn-lib-prn-file in this-procedure (
     1270                                             input parParentProc
     1271                                             ,input 0
     1272                                             ).
     1273   APPLY "ENTRY" TO BROWSE br-gds-brutto.
     1274   END.
     1275   ON MOUSE-SELECT-DBLCLICK OF br-gds-brutto IN FRAME v-suppl
     1276   DO:
     1277     APPLY "CHOOSE" TO b-parts IN FRAME v-suppl.
     1278   END.
     1279   ON RETURN OF br-gds-brutto IN FRAME v-suppl
     1280   DO:
     1281     APPLY "CHOOSE" TO b-parts IN FRAME v-suppl.
     1282   END.
     1283   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME v-suppl:PARENT eq ?
     1284   THEN FRAME v-suppl:PARENT = ACTIVE-WINDOW.
     1285   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1286   define variable varscales-pref6 as character no-undo .
     1287   define variable varpgscales-pref6 as character no-undo.
     1288   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1289   define variable varscales-pref-type7 as character no-undo.
     1290   varscales-pref6  = ?.
     1291   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1292     (input  'sclspref':u
     1293     ,input  '':u
     1294     ,input  '':u
     1295     ,input  0
     1296     ,input  '':u
     1297     ,input  '':u
     1298     ,input  '':u
     1299     ,input  no
     1300     ,output varscales-pref6
     1301     ,output varscales-pref-type7
     1302     ) no-error .
     1303   if varscales-pref6 = ? then do:
     1304     assign
     1305     varscales-pref6 = '21,23,25':U.
     1306   end.
     1307   define variable varpgscales-pref-type7 as character no-undo.
     1308   varpgscales-pref6  = ?.
     1309   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1310     (input  'scpgpref':u
     1311     ,input  '':u
     1312     ,input  '':u
     1313     ,input  0
     1314     ,input  '':u
     1315     ,input  '':u
     1316     ,input  '':u
     1317     ,input  no
     1318     ,output varpgscales-pref6
     1319     ,output varpgscales-pref-type7
     1320     ) no-error .
     1321   if varpgscales-pref6 = ? then do:
     1322     assign
     1323     varpgscales-pref6 = '24IIIIIQQ000C,28IIIIIQQQ00C':U.
     1324   end.
     1325   on value-changed of a-n-c in frame v-suppl do:
     1326     run proc-valchg-a-n-c in this-procedure  no-error.
     1327     return no-apply.
     1328   end.
     1329   on any-printable of br-gds-brutto in frame v-suppl do:
     1330     run proc-any-printable-br-gds-brutto in this-procedure   no-error.
     1331     return no-apply.
     1332   end.
     1333   on backspace of br-gds-brutto in frame v-suppl do:
     1334     run proc-backspace-br-gds-brutto in this-procedure   no-error.
     1335     return no-apply.
     1336   end.
     1337   ON return OF loc-code IN FRAME v-suppl do:
     1338     run proc-mouse-dbl-click-loc-code in this-procedure   no-error.
     1339     return no-apply.
     1340   end.
     1341   ON return, Ctrl-J OF loc-name IN FRAME v-suppl do:
     1342     run proc-mouse-dbl-click-loc-name in this-procedure   no-error.
     1343     return no-apply.
     1344   end.
     1345   PROCEDURE proc-valchg-a-n-c:
     1346     case input frame v-suppl a-n-c :
     1347       when "art" then do:
     1348         apply "entry" to br-gds-brutto in frame v-suppl.
     1349         hide loc-name loc-code
     1350         in frame v-suppl.
     1351         loc-art = "".
     1352       end.
     1353       when "name" then do:
     1354         enable loc-name with frame v-suppl.
     1355         disp loc-name with frame v-suppl.
     1356         hide loc-art loc-code
     1357         in frame v-suppl.
     1358         apply "entry" to loc-name in frame v-suppl.
     1359       end.
     1360       when "code"
     1361    or when "DataMatrix" then
     1362       do:
     1363         enable loc-code with frame v-suppl.
     1364         disp loc-code with frame v-suppl.
     1365         hide loc-art loc-name
     1366         in frame v-suppl.
     1367         apply "entry" to loc-code in frame v-suppl.
     1368       end.
     1369     end CASE.
     1370   END PROCEDURE.
     1371   PROCEDURE proc-any-printable-br-gds-brutto :
     1372     if input frame v-suppl a-n-c = "art" then do:
     1373       if last-event:label = " " and
     1374          loc-art = "" then
     1375       return error.
     1376       find first l-gds-brutto where
     1377                   l-gds-brutto.artic begins (loc-art + last-event:label)
     1378                  no-lock no-error.
     1379       if available l-gds-brutto then do:
     1380         loc-art = loc-art + last-event:label.
     1381         disp loc-art with frame v-suppl.
     1382         line-rec = recid (l-gds-brutto).
     1383         reposition br-gds-brutto to recid line-rec no-error.
     1384       end.
     1385     end.
     1386   END PROCEDURE.
     1387   PROCEDURE proc-backspace-br-gds-brutto:
     1388     if input frame v-suppl a-n-c = "art" then do:
     1389       if loc-art = "" then
     1390         return error.
     1391       loc-art = substr (loc-art, 1, length (loc-art) - 1).
     1392       find first l-gds-brutto where
     1393                   l-gds-brutto.artic begins loc-art
     1394                  no-lock.
     1395       disp loc-art with frame v-suppl.
     1396       line-rec = recid (l-gds-brutto).
     1397       reposition br-gds-brutto to recid line-rec no-error.
     1398     end.
     1399   END PROCEDURE.
     1400   PROCEDURE proc-mouse-dbl-click-loc-code:
     1401   def var str-code as integer no-undo.
     1402   define variable varresult   as character         no-undo.
     1403   define variable vartype-bc  as character         no-undo.
     1404   define variable varweight   as decimal           no-undo.
     1405   define buffer l-goods for ub.goods.
     1406   define buffer l-bar-code for ub.bar-code.
     1407   define buffer buf_bar-code for ub.bar-code .
     1408   define buffer buf_prod-bc for ub.prod-bc.
     1409   define buffer buf_place for ub.place.
     1410     assign
     1411     frame v-suppl
     1412     loc-code
     1413     a-n-c.
     1414     if a-n-c = "datamatrix"
     1415     then do:
     1416   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_dm-rcnz in g#libbcrcn
     1417   (
     1418    input  parparentproc
     1419   ,input  loc-code
     1420   ,input  ?
     1421   ,input  parobj-type
     1422   ,input  parobj-code
     1423   ,input  yes
     1424   ,input  no
     1425   ,input  varscales-pref6
     1426   ,input  varpgscales-pref6
     1427   ,output varresult
     1428   ,output vartype-bc
     1429   ,output varweight
     1430   ,buffer buf_bar-code
     1431   ,buffer buf_prod-bc
     1432   ,buffer buf_place
     1433   ) no-error.
     1434        if varresult eq "prod-bc"
     1435        then
     1436           loc-code:screen-value in frame v-suppl = buf_prod-bc.b-str.
     1437     end.
     1438     else do:
     1439   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
     1440   (
     1441    input  parparentproc
     1442   ,input  loc-code
     1443   ,input  ?
     1444   ,input  parobj-type
     1445   ,input  parobj-code
     1446   ,input  yes
     1447   ,input  no
     1448   ,input  varscales-pref6
     1449   ,input  varpgscales-pref6
     1450   ,output varresult
     1451   ,output vartype-bc
     1452   ,output varweight
     1453   ,buffer buf_bar-code
     1454   ,buffer buf_prod-bc
     1455   ,buffer buf_place
     1456   ) no-error.
     1457   end.
     1458     if available buf_bar-code then do:
     1459           find first l-goods where
     1460                     l-goods.gds-code =
     1461     buf_bar-code.gds-code No-LOCK.
     1462           find first l-gds-brutto where
     1463                     l-gds-brutto.artic = l-goods.artic AND
     1464                     l-gds-brutto.prod-type = l-goods.prod-type AND
     1465                     l-gds-brutto.prod-code = l-goods.prod-code no-lock no-error.
     1466       if available l-gds-brutto then do:
     1467         line-rec = recid (l-gds-brutto).
     1468         reposition br-gds-brutto to recid line-rec no-error.
     1469       end.
     1470       else do:
     1471         message "Строка не найдена."
     1472                 view-as alert-box error.
     1473       end.
     1474     end.
     1475     else
     1476       message "Бар-код не найден."
     1477               view-as alert-box error.
     1478     apply "entry" to loc-code in frame v-suppl.
     1479   END PROCEDURE.
     1480   PROCEDURE  proc-mouse-dbl-click-loc-name:
     1481     assign
     1482     frame v-suppl
     1483     loc-name.
     1484       if last-event:label = "Ctrl-J" then
     1485         find next l-gds-brutto where
     1486                   can-find (ub.goods where ub.goods.artic = l-gds-brutto.artic and
     1487                   ub.goods.prod-type = l-gds-brutto.prod-type and
     1488                   ub.goods.prod-code = l-gds-brutto.prod-code and
     1489                   ub.goods.gds-name begins loc-name no-lock) no-lock no-error.
     1490       else
     1491         find first l-gds-brutto where
     1492                   can-find (ub.goods where ub.goods.artic = l-gds-brutto.artic and
     1493                   ub.goods.prod-type = l-gds-brutto.prod-type and
     1494                   ub.goods.prod-code = l-gds-brutto.prod-code and
     1495                   ub.goods.gds-name begins loc-name no-lock) no-lock no-error.
     1496       if available l-gds-brutto then do:
     1497         line-rec = recid (l-gds-brutto).
     1498         reposition br-gds-brutto to recid line-rec no-error.
     1499       end.
     1500       else do:
     1501         message "Строка не найдена."
     1502                 view-as alert-box error.
     1503       end.
     1504     apply "entry" to loc-name in frame v-suppl.
     1505   END PROCEDURE.
     1506   on value-changed of br-gds-brutto in frame v-suppl do:
     1507   if not available gds-brutto or recid (gds-brutto) <> line-rec then do:
     1508       hide loc-art in frame v-suppl.
     1509       loc-art = "".
     1510   end.
     1511   end.
     1512   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1513   on help of frame v-suppl
     1514   do:
     1515     run gbl/app_help.p
     1516       (input this-procedure :file-name
     1517       ,input ''
     1518       ,input ?
     1519       ) no-error.
     1520     if error-status :error then do:
     1521       message
     1522         "Ошибка при вызове помощи"
     1523         error-status :get-message(1)
     1524         view-as alert-box .
     1525     end.
     1526   end.
     1527   run minbtn-set in this-procedure .
     1528   on choose of b-help in frame v-suppl
     1529   do:
     1530     apply "help":u to frame v-suppl .
     1531   end.
     1532   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1533   procedure minbtn-set :
     1534       do
     1535           on error undo, return error return-value
     1536           :
     1537           define variable ii              as integer       no-undo .
     1538           define variable fh              as widget-handle no-undo .
     1539           define variable hh              as widget-handle no-undo .
     1540           define variable v-h             as handle        extent 4 no-undo .
     1541           define variable v-name-button   as character     no-undo .
     1542           define variable v-help-old-x    as decimal       no-undo .
     1543           define variable v-help-old-y    as decimal       no-undo .
     1544           define variable v-help-old-size as decimal       no-undo .
     1545           define variable v-frame-width   as decimal       no-undo .
     1546           define variable jj              as integer       no-undo .
     1547           do
     1548               on error undo, return error
     1549               :
     1550               assign
     1551                   v-frame-width = frame v-suppl:width - 0.3
     1552                   fh            = frame v-suppl:first-child
     1553                   hh            = fh:first-child
     1554                   ii            = 1
     1555                   .
     1556               do while valid-handle(hh):
     1557                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1558                   do:
     1559                       case lc(hh:name) :
     1560                           when "b-help" then
     1561                               do:
     1562                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1563                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1564                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1565                                   hh:TOOLTIP = "Помощь" .
     1566                                   v-help-old-x = hh:column .
     1567                                   v-help-old-y = hh:row    .
     1568                                   v-help-old-size = hh:width .
     1569                                   hh:width-chars = 2.5 .
     1570                               end.
     1571                           when "b-print" then
     1572                               do:
     1573                                   hh:load-image("cmp/b-print.bmp":u) .
     1574                                   hh:TOOLTIP = "Печать" .
     1575                                   v-h[ii] = hh:handle .
     1576                                   ii = ii + 1 .
     1577                                   hh:width-chars = 3 .
     1578                               end.
     1579                           when "b-history" or
     1580                           when "b-hist" then
     1581                               do:
     1582                                   hh:load-image("cmp/b-hist.bmp":u) .
     1583                                   hh:TOOLTIP = "История" .
     1584                                   v-h[ii] = hh:handle .
     1585                                   ii = ii + 1 .
     1586                                   hh:width-chars = 3 .
     1587                               end.
     1588                           when "b-sch" then
     1589                               do:
     1590                                   hh:load-image("cmp/b-sch.bmp":u) .
     1591                                   hh:TOOLTIP = "Установка Фильтра" .
     1592                                   v-h[ii] = hh:handle .
     1593                                   ii = ii + 1 .
     1594                                   hh:width-chars = 3 .
     1595                               end.
     1596                           when "b-hist-user" then
     1597                               do:
     1598                                   hh:load-image("cmp/b-hist.bmp":u) .
     1599                                   hh:TOOLTIP = "История пользователя" .
     1600                                   ii = ii + 1 .
     1601                               end.
     1602                       end case.
     1603                   end.
     1604                   hh = hh:next-sibling.
     1605               end.
     1606               b-help:column = v-frame-width - b-help:width-chars.
     1607               jj = 0.
     1608               repeat ii = 4 to 1 by -1 :
     1609                   if valid-handle (v-h[ii] ) then
     1610                   do:
     1611                       jj  = jj + 1 .
     1612                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1613                       v-h[ii]:row    = v-help-old-y .
     1614                   end.
     1615               end.
     1616           end.
     1617       end.
     1618   end procedure.
     1619   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1620   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1621   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1622   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1623   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1624   define variable v-diasize-current-frame-height as decimal   no-undo .
     1625   define variable v-diasize-change-size          as logical   no-undo .
     1626   define variable v-diasize-resize-button        as handle    no-undo .
     1627   define variable v-diasize-wndmax               as logical   no-undo .
     1628   define variable v-diasize-wndstore             as logical   no-undo .
     1629   define variable v-diasize-proc-name            as character no-undo .
     1630   define variable v-diasize-browse-handle        as handle    no-undo .
     1631   define variable v-diasize-browse-number        as integer   no-undo .
     1632   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1633   define temp-table temp-diasize-handle no-undo
     1634     field handle-value  as handle
     1635     field save-position as decimal
     1636     index xpk is primary unique handle-value
     1637     .
     1638   define temp-table temp-browse-handle no-undo
     1639     field browse-type   as character
     1640     field browse-number as integer
     1641     field browse-handle as handle
     1642     field original-size as decimal
     1643     index xpk is primary unique browse-type browse-number
     1644     index xie browse-type browse-handle
     1645   .
     1646   procedure diasize_change-height :
     1647     define input  parameter p-change-value  as decimal   no-undo .
     1648     define input  parameter p-move-resize   as logical   no-undo .
     1649     define variable v-field-group-handle    as handle    no-undo .
     1650     define variable v-object-handle         as handle    no-undo .
     1651     define variable v-frame-height          as decimal   no-undo .
     1652     define variable v-frame-virtual-height  as decimal   no-undo .
     1653     define variable v-browse-height         as decimal   no-undo .
     1654     define variable v-window-height         as decimal   no-undo .
     1655     define variable v-window-virtual-height as decimal   no-undo .
     1656     define variable v-change-sign           as integer   no-undo .
     1657     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1658     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1659     if p-change-value > 0
     1660     then do:
     1661       if frame v-suppl :height + p-change-value
     1662           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1663       then do:
     1664         assign
     1665           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1666                           - (frame v-suppl :height-chars)
     1667         .
     1668         if p-change-value <= 0
     1669         then do:
     1670           run diasize_position-resize-button in this-procedure .
     1671           return .
     1672         end.
     1673       end.
     1674     end.
     1675     if p-change-value < 0
     1676     then do:
     1677       if frame v-suppl :height + p-change-value < v-diasize-orig-frame-height
     1678       then do:
     1679         assign
     1680           p-change-value = v-diasize-orig-frame-height
     1681                          - (frame v-suppl :height-chars)
     1682         .
     1683         if p-change-value >= 0
     1684         then do:
     1685           run diasize_position-resize-button in this-procedure .
     1686           return .
     1687         end.
     1688       end.
     1689     end.
     1690     if p-change-value >= 0
     1691     then do:
     1692       assign
     1693         v-change-sign = 1
     1694       .
     1695     end.
     1696     else do:
     1697       assign
     1698         v-change-sign = -1
     1699       .
     1700     end.
     1701     assign
     1702       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1703     .
     1704     if p-change-value = 0
     1705     then do:
     1706       run diasize_position-resize-button in this-procedure .
     1707       return .
     1708     end.
     1709     move_block:
     1710     do
     1711     on error undo move_block, retry move_block
     1712     :
     1713       if retry
     1714       then do:
     1715         do
     1716         on error undo move_block, leave move_block
     1717         :
     1718           if p-change-value > 0
     1719           then do:
     1720             for each buf_temp-diasize-handle
     1721             on error undo, next
     1722             :
     1723               assign
     1724                 v-object-handle = buf_temp-diasize-handle.handle-value
     1725               .
     1726               if v-object-handle <> v-diasize-resize-button
     1727               then do:
     1728                 assign
     1729                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1730                 .
     1731               end.
     1732             end.
     1733             assign
     1734               v-diasize-browse-handle :height = v-browse-height
     1735             .
     1736             for each buf_temp-browse-handle
     1737               where buf_temp-browse-handle.browse-type = 'height':u
     1738             on error undo, next
     1739             :
     1740               assign
     1741                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1742               .
     1743             end.
     1744             assign
     1745               frame v-suppl :height = v-frame-height
     1746             .
     1747             if frame v-suppl :scrollable = true
     1748             then do:
     1749               assign
     1750                 frame v-suppl :virtual-height = v-frame-virtual-height
     1751               .
     1752             end.
     1753             run diasize_position-resize-button in this-procedure .
     1754           end.
     1755           else do:
     1756             if frame v-suppl :scrollable = true
     1757             then do:
     1758               assign
     1759                 frame v-suppl :virtual-height = v-frame-virtual-height
     1760               .
     1761             end.
     1762             assign
     1763               frame v-suppl :height = v-frame-height
     1764             .
     1765             assign
     1766               v-diasize-browse-handle :height = v-browse-height
     1767             .
     1768             for each buf_temp-browse-handle
     1769               where buf_temp-browse-handle.browse-type = 'height':u
     1770             on error undo, next
     1771             :
     1772               assign
     1773                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1774               .
     1775             end.
     1776             for each buf_temp-diasize-handle
     1777             on error undo, next
     1778             :
     1779               assign
     1780                 v-object-handle = buf_temp-diasize-handle.handle-value
     1781               .
     1782               if v-object-handle <> v-diasize-resize-button
     1783               then do:
     1784                 assign
     1785                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1786                 .
     1787               end.
     1788             end.
     1789             run diasize_position-resize-button in this-procedure .
     1790           end.
     1791           assign
     1792             v-diasize-change-size = false
     1793           .
     1794           leave move_block .
     1795         end.
     1796       end.
     1797       assign
     1798         v-diasize-need-full-display = true
     1799       .
     1800       if v-diasize-change-size = false
     1801       then do:
     1802         assign
     1803           v-diasize-change-size = true
     1804         .
     1805       end.
     1806       else do:
     1807         return .
     1808       end.
     1809       assign
     1810         v-frame-height = frame v-suppl :height
     1811         v-frame-virtual-height = frame v-suppl :virtual-height
     1812         v-browse-height = v-diasize-browse-handle :height
     1813       .
     1814       for each buf_temp-browse-handle
     1815         where buf_temp-browse-handle.browse-type = 'height':u
     1816       :
     1817         assign
     1818           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1819         .
     1820       end.
     1821       for each buf_temp-diasize-handle
     1822       :
     1823         delete buf_temp-diasize-handle .
     1824       end.
     1825       assign
     1826         v-field-group-handle = frame v-suppl :first-child
     1827       .
     1828       do while valid-handle(v-field-group-handle)
     1829       :
     1830         assign
     1831           v-object-handle = v-field-group-handle :first-child
     1832         .
     1833         do while valid-handle(v-object-handle)
     1834         :
     1835           if  v-object-handle <> v-diasize-browse-handle :handle
     1836           and can-query(v-object-handle, "row")
     1837           and can-query(v-object-handle, "height")
     1838           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1839           then do:
     1840             find first buf_temp-browse-handle
     1841               where buf_temp-browse-handle.browse-type   = 'height':u
     1842                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1843               no-error .
     1844             if available buf_temp-browse-handle
     1845             then do:
     1846             end.
     1847             else do:
     1848               create buf_temp-diasize-handle .
     1849               assign
     1850                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1851                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1852               .
     1853             end.
     1854           end.
     1855           assign
     1856             v-object-handle = v-object-handle :next-sibling
     1857           .
     1858         end.
     1859         assign
     1860           v-field-group-handle = v-field-group-handle :next-sibling
     1861         .
     1862       end.
     1863       do with frame v-suppl
     1864       :
     1865         hide v-diasize-resize-button .
     1866         assign
     1867           v-diasize-resize-button :row    = 1
     1868           v-diasize-resize-button :column = 1
     1869         .
     1870       end.
     1871       if p-change-value > 0
     1872       then do:
     1873         if frame v-suppl :scrollable = true
     1874         then do:
     1875           assign
     1876             frame v-suppl :virtual-height = frame v-suppl :virtual-height + p-change-value
     1877             no-error .
     1878           if error-status :error
     1879           or error-status :get-message(1) <> ""
     1880           then do:
     1881             undo move_block, retry move_block .
     1882           end.
     1883         end.
     1884         assign
     1885           frame v-suppl :height = frame v-suppl :height + p-change-value
     1886           no-error .
     1887         if error-status :error
     1888         or error-status :get-message(1) <> ""
     1889         then do:
     1890           undo move_block, retry move_block .
     1891         end.
     1892         assign
     1893           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1894           no-error .
     1895         if error-status :error
     1896         or error-status :get-message(1) <> ""
     1897         then do:
     1898           undo move_block, retry move_block .
     1899         end.
     1900         for each buf_temp-browse-handle
     1901           where buf_temp-browse-handle.browse-type = 'height':u
     1902         on error undo move_block, retry move_block
     1903         :
     1904           assign
     1905             buf_temp-browse-handle.browse-handle :height
     1906               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1907             no-error .
     1908           if error-status :error
     1909           or error-status :get-message(1) <> ""
     1910           then do:
     1911             undo move_block, retry move_block .
     1912           end.
     1913         end.
     1914         for each buf_temp-diasize-handle
     1915         on error undo move_block, retry move_block
     1916         :
     1917           assign
     1918             v-object-handle = buf_temp-diasize-handle.handle-value
     1919           .
     1920           if v-object-handle <> v-diasize-resize-button
     1921           then do:
     1922             assign
     1923               v-object-handle :row = v-object-handle :row + p-change-value
     1924               no-error .
     1925             if error-status :error
     1926             or error-status :get-message(1) <> ""
     1927             then do:
     1928               undo move_block, retry move_block .
     1929             end.
     1930           end.
     1931         end.
     1932       end.
     1933       else do:
     1934         for each buf_temp-diasize-handle
     1935         on error undo move_block, retry move_block
     1936         :
     1937           assign
     1938             v-object-handle = buf_temp-diasize-handle.handle-value
     1939           .
     1940           if v-object-handle <> v-diasize-resize-button
     1941           then do:
     1942             assign
     1943               v-object-handle :row = v-object-handle :row + p-change-value
     1944               no-error .
     1945             if error-status :error
     1946             or error-status :get-message(1) <> ""
     1947             then do:
     1948               undo move_block, retry move_block .
     1949             end.
     1950           end.
     1951         end.
     1952         assign
     1953           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1954           no-error .
     1955         if error-status :error
     1956         or error-status :get-message(1) <> ""
     1957         then do:
     1958           undo move_block, retry move_block .
     1959         end.
     1960         for each buf_temp-browse-handle
     1961           where buf_temp-browse-handle.browse-type = 'height':u
     1962         on error undo move_block, retry move_block
     1963         :
     1964           assign
     1965             buf_temp-browse-handle.browse-handle :height
     1966               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1967             no-error .
     1968           if error-status :error
     1969           or error-status :get-message(1) <> ""
     1970           then do:
     1971             undo move_block, retry move_block .
     1972           end.
     1973         end.
     1974         assign
     1975           frame v-suppl :height = frame v-suppl :height + p-change-value
     1976           no-error .
     1977         if error-status :error
     1978         or error-status :get-message(1) <> ""
     1979         then do:
     1980           undo move_block, retry move_block .
     1981         end.
     1982         if frame v-suppl :scrollable = true
     1983         then do:
     1984           assign
     1985             frame v-suppl :virtual-height = frame v-suppl :virtual-height + p-change-value
     1986             no-error .
     1987           if error-status :error
     1988           or error-status :get-message(1) <> ""
     1989           then do:
     1990             undo move_block, retry move_block .
     1991           end.
     1992         end.
     1993       end.
     1994       if p-move-resize = true
     1995       then do:
     1996         run diasize_position-resize-button in this-procedure .
     1997       end.
     1998       if v-diasize-wndstore = true
     1999       then do:
     2000         if connected("ub") = true
     2001         then do:
     2002           define variable v-cntxt-db-num        as integer   no-undo .
     2003           define variable v-cntxt-userid        as character no-undo .
     2004           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2005                                             , OUTPUT v-cntxt-userid
     2006                                             ) .
     2007           run gbl/wndsizew.p
     2008             (input  v-cntxt-db-num
     2009             ,input  v-cntxt-userid
     2010             ,input  v-diasize-proc-name
     2011             ,input  'height':u
     2012             ,input  string(frame v-suppl :height - v-diasize-orig-frame-height)
     2013             ) .
     2014         end.
     2015       end.
     2016     end.
     2017     assign
     2018       v-diasize-change-size = false
     2019     .
     2020   end procedure.
     2021   procedure diasize_set-height :
     2022     define input  parameter p-new-height  as decimal   no-undo .
     2023     define input  parameter p-move-resize as logical   no-undo .
     2024     do
     2025     on error undo, return error return-value
     2026     :
     2027       run diasize_change-height in this-procedure
     2028         (input  (p-new-height - frame v-suppl :height)
     2029         ,input  p-move-resize
     2030         ) .
     2031     end.
     2032   end procedure.
     2033   procedure diasize_change-width :
     2034     define input  parameter p-change-value as decimal   no-undo .
     2035     define input  parameter p-move-resize  as logical   no-undo .
     2036     define variable v-field-group-handle   as handle    no-undo .
     2037     define variable v-object-handle        as handle    no-undo .
     2038     define variable v-frame-width          as decimal   no-undo .
     2039     define variable v-frame-virtual-width  as decimal   no-undo .
     2040     define variable v-browse-width         as decimal   no-undo .
     2041     define variable v-window-width         as decimal   no-undo .
     2042     define variable v-window-virtual-width as decimal   no-undo .
     2043     define variable v-change-sign          as integer   no-undo .
     2044     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2045     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2046     if p-change-value > 0
     2047     then do:
     2048       if frame v-suppl :width + p-change-value >
     2049           session :width-chars
     2050       then do:
     2051         assign
     2052           p-change-value = session :width-chars - frame v-suppl :width
     2053         .
     2054         if p-change-value <= 0
     2055         then do:
     2056           run diasize_position-resize-button in this-procedure .
     2057           return .
     2058         end.
     2059       end.
     2060     end.
     2061     if p-change-value < 0
     2062     then do:
     2063       if frame v-suppl :width + p-change-value < v-diasize-orig-frame-width
     2064       then do:
     2065         assign
     2066           p-change-value = v-diasize-orig-frame-width
     2067                          - frame v-suppl :width
     2068         .
     2069         if p-change-value >= 0
     2070         then do:
     2071           run diasize_position-resize-button in this-procedure .
     2072           return .
     2073         end.
     2074       end.
     2075     end.
     2076     if p-change-value >= 0
     2077     then do:
     2078       assign
     2079         v-change-sign = 1
     2080       .
     2081     end.
     2082     else do:
     2083       assign
     2084         v-change-sign = -1
     2085       .
     2086     end.
     2087     assign
     2088       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2089     .
     2090     if p-change-value = 0
     2091     then do:
     2092       run diasize_position-resize-button in this-procedure .
     2093       return .
     2094     end.
     2095     move_block:
     2096     do
     2097     on error undo move_block, leave move_block
     2098     :
     2099       if retry
     2100       then do:
     2101         do
     2102         on error undo move_block, leave move_block
     2103         :
     2104           if p-change-value > 0
     2105           then do:
     2106             for each buf_temp-diasize-handle
     2107             on error undo, next
     2108             :
     2109               assign
     2110                 v-object-handle = buf_temp-diasize-handle.handle-value
     2111               .
     2112               if v-object-handle <> v-diasize-resize-button
     2113               then do:
     2114                 assign
     2115                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2116                 .
     2117               end.
     2118             end.
     2119             assign
     2120               v-diasize-browse-handle :width = v-browse-width
     2121             .
     2122             for each buf_temp-browse-handle
     2123               where buf_temp-browse-handle.browse-type = 'width':u
     2124             on error undo, next
     2125             :
     2126               assign
     2127                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2128               .
     2129             end.
     2130             assign
     2131               frame v-suppl :width = v-frame-width
     2132             .
     2133             if frame v-suppl :scrollable = true
     2134             then do:
     2135               assign
     2136                 frame v-suppl :virtual-width = v-frame-virtual-width
     2137               .
     2138             end.
     2139             run diasize_position-resize-button in this-procedure .
     2140           end.
     2141           else do:
     2142             if frame v-suppl :scrollable = true
     2143             then do:
     2144               assign
     2145                 frame v-suppl :virtual-width = v-frame-virtual-width
     2146               .
     2147             end.
     2148             assign
     2149               frame v-suppl :width = v-frame-width
     2150             .
     2151             for each buf_temp-browse-handle
     2152               where buf_temp-browse-handle.browse-type = 'width':u
     2153             on error undo, next
     2154             :
     2155               assign
     2156                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2157               .
     2158             end.
     2159             assign
     2160               v-diasize-browse-handle :width = v-browse-width
     2161             .
     2162             for each buf_temp-diasize-handle
     2163             on error undo, next
     2164             :
     2165               assign
     2166                 v-object-handle = buf_temp-diasize-handle.handle-value
     2167               .
     2168               if v-object-handle <> v-diasize-resize-button
     2169               then do:
     2170                 assign
     2171                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2172                 .
     2173               end.
     2174             end.
     2175             run diasize_position-resize-button in this-procedure .
     2176           end.
     2177           assign
     2178             v-diasize-change-size = false
     2179           .
     2180           leave move_block .
     2181         end.
     2182       end.
     2183       assign
     2184         v-diasize-need-full-display = true
     2185       .
     2186       if v-diasize-change-size = false
     2187       then do:
     2188         assign
     2189           v-diasize-change-size = true
     2190         .
     2191       end.
     2192       else do:
     2193         return .
     2194       end.
     2195       assign
     2196         v-frame-width = frame v-suppl :width
     2197         v-frame-virtual-width = frame v-suppl :virtual-width
     2198         v-browse-width = v-diasize-browse-handle :width
     2199       .
     2200       for each buf_temp-browse-handle
     2201         where buf_temp-browse-handle.browse-type = 'width':u
     2202       :
     2203         assign
     2204           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2205         .
     2206       end.
     2207       for each buf_temp-diasize-handle
     2208       :
     2209         delete buf_temp-diasize-handle .
     2210       end.
     2211       assign
     2212         v-field-group-handle = frame v-suppl :first-child
     2213       .
     2214       do while valid-handle(v-field-group-handle)
     2215       :
     2216         assign
     2217           v-object-handle = v-field-group-handle :first-child
     2218         .
     2219         do while valid-handle(v-object-handle)
     2220         :
     2221           if  v-object-handle <> v-diasize-browse-handle :handle
     2222           and v-object-handle <> v-diasize-resize-button
     2223           and can-query(v-object-handle, "row")
     2224           and can-query(v-object-handle, "height")
     2225           and ( v-object-handle :col + v-object-handle :width
     2226                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2227               )
     2228           then do:
     2229             find first buf_temp-browse-handle
     2230               where buf_temp-browse-handle.browse-type   = 'width':u
     2231                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2232               no-error .
     2233             if available buf_temp-browse-handle
     2234             then do:
     2235             end.
     2236             else do:
     2237               create buf_temp-diasize-handle .
     2238               assign
     2239                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2240                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2241               .
     2242             end.
     2243           end.
     2244           assign
     2245             v-object-handle = v-object-handle :next-sibling
     2246           .
     2247         end.
     2248         assign
     2249           v-field-group-handle = v-field-group-handle :next-sibling
     2250         .
     2251       end.
     2252       do with frame v-suppl
     2253       :
     2254         hide v-diasize-resize-button .
     2255         v-diasize-resize-button :row = 1.
     2256         v-diasize-resize-button :column = 1.
     2257       end.
     2258       if p-change-value > 0
     2259       then do:
     2260         if frame v-suppl :scrollable = true
     2261         then do:
     2262           assign
     2263             frame v-suppl :virtual-width = frame v-suppl :virtual-width + p-change-value
     2264             no-error .
     2265           if error-status :error
     2266           or error-status :get-message(1) <> ""
     2267           then do:
     2268             undo move_block, retry move_block.
     2269           end.
     2270         end.
     2271         assign
     2272           frame v-suppl :width = v-frame-width + p-change-value
     2273           no-error .
     2274         if error-status :error
     2275         or error-status :get-message(1) <> ""
     2276         then do:
     2277           undo move_block, retry move_block.
     2278         end.
     2279         assign
     2280           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2281         no-error .
     2282         if error-status :error
     2283         or error-status :get-message(1) <> ""
     2284         then do:
     2285           undo move_block, retry move_block.
     2286         end.
     2287         for each buf_temp-browse-handle
     2288           where buf_temp-browse-handle.browse-type = 'width':u
     2289         on error undo move_block, retry move_block
     2290         :
     2291           assign
     2292             buf_temp-browse-handle.browse-handle :width
     2293               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2294             no-error .
     2295           if error-status :error
     2296           or error-status :get-message(1) <> ""
     2297           then do:
     2298             undo move_block, retry move_block .
     2299           end.
     2300         end.
     2301         for each buf_temp-diasize-handle
     2302         on error undo move_block, retry move_block
     2303         :
     2304           assign
     2305             v-object-handle = buf_temp-diasize-handle.handle-value
     2306           .
     2307           if v-object-handle <> v-diasize-resize-button
     2308           then do:
     2309             assign
     2310               v-object-handle :col = v-object-handle :col + p-change-value
     2311               no-error .
     2312             if error-status :error
     2313             or error-status :get-message(1) <> ""
     2314             then do:
     2315               undo move_block, retry move_block .
     2316             end.
     2317           end.
     2318         end.
     2319       end.
     2320       else do:
     2321         for each buf_temp-diasize-handle
     2322         on error undo move_block, retry move_block
     2323         :
     2324           assign
     2325             v-object-handle = buf_temp-diasize-handle.handle-value
     2326           .
     2327           if v-object-handle <> v-diasize-resize-button
     2328           then do:
     2329             assign
     2330               v-object-handle :col = v-object-handle :col + p-change-value
     2331               no-error .
     2332             if error-status :error
     2333             or error-status :get-message(1) <> ""
     2334             then do:
     2335               undo move_block, retry move_block .
     2336             end.
     2337           end.
     2338         end.
     2339         for each buf_temp-browse-handle
     2340           where buf_temp-browse-handle.browse-type = 'width':u
     2341         on error undo move_block, retry move_block
     2342         :
     2343           assign
     2344             buf_temp-browse-handle.browse-handle :width
     2345               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2346             no-error .
     2347           if error-status :error
     2348           or error-status :get-message(1) <> ""
     2349           then do:
     2350             undo move_block, retry move_block .
     2351           end.
     2352         end.
     2353         assign
     2354           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2355           no-error .
     2356         if error-status :error
     2357         or error-status :get-message(1) <> ""
     2358         then do:
     2359           undo move_block, retry move_block.
     2360         end.
     2361         assign
     2362           frame v-suppl :width = frame v-suppl :width + p-change-value
     2363         no-error .
     2364         if error-status :error
     2365         or error-status :get-message(1) <> ""
     2366         then do:
     2367           undo move_block, retry move_block.
     2368         end.
     2369         if frame v-suppl :scrollable = true
     2370         then do:
     2371           assign
     2372             frame v-suppl :virtual-width = frame v-suppl :virtual-width + p-change-value
     2373           no-error .
     2374           if error-status :error
     2375           or error-status :get-message(1) <> ""
     2376           then do:
     2377             undo move_block, retry move_block.
     2378           end.
     2379         end.
     2380       end.
     2381       if p-move-resize
     2382       then do:
     2383         run diasize_position-resize-button in this-procedure .
     2384       end.
     2385       if v-diasize-wndstore = true
     2386       then do:
     2387         if connected("ub") = true
     2388         then do:
     2389           define variable v-cntxt-db-num        as integer   no-undo .
     2390           define variable v-cntxt-userid        as character no-undo .
     2391           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2392                                             , OUTPUT v-cntxt-userid
     2393                                             ) .
     2394           run gbl/wndsizew.p
     2395             (input  v-cntxt-db-num
     2396             ,input  v-cntxt-userid
     2397             ,input  v-diasize-proc-name
     2398             ,input  'width':u
     2399             ,input  string(frame v-suppl :width - v-diasize-orig-frame-width)
     2400             ) .
     2401         end.
     2402       end.
     2403     end.
     2404     assign
     2405       v-diasize-change-size = false
     2406     .
     2407   end procedure.
     2408   procedure diasize_set-width :
     2409     define input  parameter p-new-width  as decimal   no-undo .
     2410     define input  parameter p-move-resize as logical   no-undo .
     2411     do
     2412     on error undo, return error return-value
     2413     :
     2414       run diasize_change-width in this-procedure
     2415         (input  (p-new-width - frame v-suppl :width)
     2416         ,input  p-move-resize
     2417         ) .
     2418     end.
     2419   end procedure.
     2420   procedure diasize_position-resize-button :
     2421     do with frame v-suppl
     2422     :
     2423       hide v-diasize-resize-button .
     2424       assign
     2425         v-diasize-resize-button :row = frame v-suppl :height - v-diasize-resize-button :height
     2426                     - 1
     2427                     - (frame v-suppl :border-bottom-pixels / session :pixels-per-row)
     2428         v-diasize-resize-button :col = frame v-suppl :width - v-diasize-resize-button :width
     2429                     - 1
     2430                     - (frame v-suppl :border-right-pixels / session :pixels-per-column)
     2431       .
     2432       view v-diasize-resize-button .
     2433     end.
     2434   end procedure.
     2435   on alt-right anywhere
     2436   do:
     2437     run diasize_change-width in this-procedure
     2438       (input 1
     2439       ,input true
     2440       ) .
     2441     return no-apply .
     2442   end.
     2443   on alt-left anywhere
     2444   do:
     2445     run diasize_change-width in this-procedure
     2446       (input -1
     2447       ,input true
     2448       ) .
     2449     return no-apply .
     2450   end.
     2451   on alt-down anywhere
     2452   do:
     2453     run diasize_change-height in this-procedure
     2454       (input 1
     2455       ,input true
     2456       ) .
     2457     return no-apply .
     2458   end.
     2459   on alt-up anywhere
     2460   do:
     2461     run diasize_change-height in this-procedure
     2462       (input -1
     2463       ,input true
     2464       ) .
     2465     return no-apply .
     2466   end.
     2467   on alt-enter of frame v-suppl
     2468   do:
     2469     run diasize_maximize in this-procedure
     2470       (input  ?
     2471       ).
     2472     return no-apply .
     2473   end.
     2474   procedure diasize_end-move :
     2475     do
     2476     on error undo, return error return-value
     2477     :
     2478       define variable v-row-delta as decimal   no-undo .
     2479       define variable v-col-delta as decimal   no-undo .
     2480       define variable v-new-row as decimal   no-undo .
     2481       define variable v-new-col as decimal   no-undo .
     2482       assign
     2483         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2484         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2485       .
     2486       assign
     2487         v-row-delta = v-new-row - frame v-suppl :height
     2488         v-col-delta = v-new-col - frame v-suppl :width
     2489       .
     2490       run diasize_change-height in this-procedure
     2491         (input v-row-delta
     2492         ,input true
     2493         ) .
     2494       run diasize_change-width in this-procedure
     2495         (input v-col-delta
     2496         ,input true
     2497         ) .
     2498     end.
     2499   end procedure.
     2500   procedure diasize_maximize :
     2501     define input  parameter p-action as logical   no-undo .
     2502     do
     2503     on error undo, return error return-value
     2504     :
     2505       if p-action = ?
     2506       then do:
     2507         if v-diasize-need-maximize = true
     2508         then do:
     2509           assign
     2510             p-action = true
     2511           .
     2512         end.
     2513         else do:
     2514           assign
     2515             p-action = false
     2516           .
     2517         end.
     2518       end.
     2519       if p-action = true
     2520       then do:
     2521         run diasize_change-height in this-procedure
     2522           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2523               - frame v-suppl :height-chars
     2524           ,input true
     2525           ) .
     2526         run diasize_change-width in this-procedure
     2527           (input session :width-chars
     2528               - frame v-suppl :width-chars
     2529           ,input true
     2530           ) .
     2531         assign
     2532           v-diasize-need-maximize = false
     2533         .
     2534       end.
     2535       else do:
     2536         run diasize_change-width in this-procedure
     2537           (input v-diasize-orig-frame-width
     2538               - frame v-suppl :width-chars
     2539           ,input true
     2540           ) .
     2541         run diasize_change-height in this-procedure
     2542           (input v-diasize-orig-frame-height
     2543               - frame v-suppl :height-chars
     2544           ,input true
     2545           ) .
     2546         assign
     2547           v-diasize-need-maximize = true
     2548         .
     2549       end.
     2550     end.
     2551   end procedure.
     2552   procedure diasize_restore-orig-size :
     2553     do
     2554     on error undo, return error return-value
     2555     :
     2556       assign
     2557         v-diasize-current-frame-width  = frame v-suppl :width
     2558         v-diasize-current-frame-height = frame v-suppl :height
     2559       .
     2560       run diasize_set-height in this-procedure
     2561         (input  v-diasize-orig-frame-height
     2562         ,input  true
     2563         ) .
     2564       run diasize_set-width in this-procedure
     2565         (input  v-diasize-orig-frame-width
     2566         ,input  true
     2567         ) .
     2568     end.
     2569   end procedure.
     2570   procedure diasize_restore-current-size :
     2571     do
     2572     on error undo, return error return-value
     2573     :
     2574       run diasize_set-height in this-procedure
     2575         (input  v-diasize-current-frame-height
     2576         ,input  true
     2577         ) .
     2578       run diasize_set-width in this-procedure
     2579         (input  v-diasize-current-frame-width
     2580         ,input  true
     2581         ) .
     2582     end.
     2583   end procedure.
     2584   procedure diasize_set-browse-handle :
     2585     define input  parameter p-browse-handle as handle   no-undo .
     2586     define buffer buf_temp-browse-handle for temp-browse-handle .
     2587     do
     2588     on error undo, return error return-value
     2589     :
     2590       assign
     2591         v-diasize-browse-handle = p-browse-handle
     2592       .
     2593       for each buf_temp-browse-handle
     2594       on error undo, return error return-value
     2595       :
     2596         delete buf_temp-browse-handle .
     2597       end.
     2598     end.
     2599   end procedure.
     2600   procedure diasize_add_browse :
     2601     define input  parameter p-browse-type   as character no-undo .
     2602     define input  parameter p-browse-handle as handle    no-undo .
     2603     define buffer buf_temp-browse-handle for temp-browse-handle .
     2604     do
     2605     on error undo, return error return-value
     2606     :
     2607       assign
     2608         v-diasize-browse-number = v-diasize-browse-number + 1
     2609       .
     2610       create buf_temp-browse-handle .
     2611       assign
     2612         buf_temp-browse-handle.browse-type   = p-browse-type
     2613         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2614         buf_temp-browse-handle.browse-handle = p-browse-handle
     2615       .
     2616     end.
     2617   end procedure.
     2618   procedure diasize_init :
     2619     define variable v-default-value    as logical   no-undo .
     2620     define variable v-restore-saved    as logical   no-undo .
     2621     define variable v-resize-value-str as character no-undo .
     2622     do
     2623     on error undo, return error return-value
     2624     :
     2625       do with frame v-suppl
     2626       :
     2627         assign
     2628           v-diasize-orig-frame-height = frame v-suppl :height
     2629           v-diasize-orig-frame-width  = frame v-suppl :width
     2630           v-diasize-browse-handle     = browse br-gds-brutto :handle
     2631         .
     2632         create button v-diasize-resize-button
     2633         assign
     2634           parent        = frame v-suppl :first-child
     2635           label         = "s"
     2636           height-pixels = 16
     2637           width-pixels  = 16
     2638           visible       = true
     2639           sensitive     = true
     2640           movable       = true
     2641           triggers:
     2642             on end-move persistent run diasize_end-move in this-procedure .
     2643           end triggers.
     2644         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2645         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2646         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2647         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2648         assign
     2649           v-diasize-wndmax = false
     2650         .
     2651         if connected("ub") = true
     2652         then do:
     2653           define variable v-cntxt-db-num        as integer   no-undo .
     2654           define variable v-cntxt-userid        as character no-undo .
     2655           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2656                                             , OUTPUT v-cntxt-userid
     2657                                             ) .
     2658           run gbl/wndpar_r.p
     2659             (input  v-cntxt-db-num
     2660             ,input  v-cntxt-userid
     2661             ,input  'wndmax':U
     2662             ,output v-diasize-wndmax
     2663             ,output v-default-value
     2664             ) .
     2665         end.
     2666         assign
     2667           v-diasize-wndstore = false
     2668         .
     2669         if connected("ub") = true
     2670         then do:
     2671           run gbl/wndpar_r.p
     2672             (input  v-cntxt-db-num
     2673             ,input  v-cntxt-userid
     2674             ,input  'wndstore':U
     2675             ,output v-diasize-wndstore
     2676             ,output v-default-value
     2677             ) .
     2678         end.
     2679         assign
     2680           v-diasize-proc-name = entry(1, program-name(2), '.')
     2681         .
     2682         if v-diasize-wndstore = true
     2683         then do:
     2684           assign
     2685             v-restore-saved = false
     2686           .
     2687           if connected("ub") = true
     2688           then do:
     2689             run gbl/wndsizer.p
     2690               (input  v-cntxt-db-num
     2691               ,input  v-cntxt-userid
     2692               ,input  v-diasize-proc-name
     2693               ,input  'height':u
     2694               ,output v-resize-value-str
     2695               ) .
     2696             if v-resize-value-str <> '':U
     2697             then do:
     2698               run diasize_change-height in this-procedure
     2699                 (input  integer(v-resize-value-str)
     2700                 ,input  true
     2701                 ) .
     2702               assign
     2703                 v-restore-saved = true
     2704               .
     2705             end.
     2706           end.
     2707           if connected("ub") = true
     2708           then do:
     2709             run gbl/wndsizer.p
     2710               (input  v-cntxt-db-num
     2711               ,input  v-cntxt-userid
     2712               ,input  v-diasize-proc-name
     2713               ,input  'width':u
     2714               ,output v-resize-value-str
     2715               ) .
     2716             if v-resize-value-str <> '':U
     2717             then do:
     2718               run diasize_change-width in this-procedure
     2719                 (input  integer(v-resize-value-str)
     2720                 ,input  true
     2721                 ) .
     2722               assign
     2723                 v-restore-saved = true
     2724               .
     2725             end.
     2726           end.
     2727           if v-restore-saved <> true
     2728           then do:
     2729             if v-diasize-wndmax = true
     2730             then do:
     2731               run diasize_maximize in this-procedure
     2732                 (input  true
     2733                 ) .
     2734             end.
     2735           end.
     2736         end.
     2737         else do:
     2738           if v-diasize-wndmax = true
     2739           then do:
     2740             run diasize_maximize in this-procedure
     2741               (input  true
     2742               ) .
     2743           end.
     2744         end.
     2745       end.
     2746     end.
     2747   end procedure.
     2748   procedure diasize_need-full-display :
     2749     define output parameter p-need-full-display as logical   no-undo .
     2750     do
     2751     on error undo, return error return-value
     2752     :
     2753       assign
     2754         p-need-full-display = v-diasize-need-full-display
     2755       .
     2756       assign
     2757         v-diasize-need-full-display = false
     2758       .
     2759     end.
     2760   end procedure.
     2761   procedure get-context :
     2762      define output parameter p-db-num as integer          no-undo.
     2763      define output parameter p-user-id as character        no-undo.
     2764      define variable v-login               as character    no-undo.
     2765      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2766      define buffer buf_user-login  for ub.user-login .
     2767      do
     2768      on error undo, return error
     2769      :
     2770            FIND FIRST buf_sys-ctrl no-lock.
     2771            ASSIGN
     2772               v-login = USERID("ub")
     2773               p-db-num = buf_sys-ctrl.db-num
     2774            .
     2775            FIND FIRST buf_user-login
     2776                 WHERE buf_user-login.db-num = p-db-num
     2777                   AND buf_user-login.user-login = v-login
     2778                 no-lock
     2779                 no-error
     2780                 .
     2781            IF AVAILABLE buf_user-login
     2782            THEN DO:
     2783               assign
     2784                  p-user-id = buf_user-login.user-id
     2785               .
     2786            END.
     2787      end.
     2788   end procedure.
     2789       run diasize_init in this-procedure .
     2790   MAIN-BLOCK:
     2791   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2792      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2793   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2794   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2795     (input  parobj-type
     2796     ,input  parobj-code
     2797     ,output v-host-code
     2798     )  .
     2799      IF parobj-type = "all" THEN DO:
     2800         for each ub.store where ub.store.host-code = v-host-code no-lock:
     2801             RUN calc (input 'скл':U, input ub.store.obj-code) no-error.
     2802             IF ERROR-STATUS:ERROR THEN RETURN ERROR.
     2803         end.
     2804         for each ub.shop where ub.shop.host-code = v-host-code no-lock:
     2805             RUN calc (input 'маг':U, input ub.shop.obj-code) no-error.
     2806             IF ERROR-STATUS:ERROR THEN RETURN ERROR.
     2807         end.
     2808     END.
     2809     ELSE RUN calc (input parobj-type, input parobj-code) no-error.
     2810     RUN enable_UI.
     2811     IF parobj-type = "all" THEN
     2812     FRAME v-suppl:TITLE =  "Сводный отчет c: " + string(from-date,"99/99/9999") +
     2813                                  " по: " + string(to-date,"99/99/9999").
     2814     ELSE IF parkindrep = "OUT" THEN
     2815     FRAME v-suppl:TITLE =  "Книга учета товаров на объекте:" + parobj-type + " " + STRING(parobj-code) +
     2816                                  " c: " + string(from-date,"99/99/9999") +
     2817                                  " по: " + string(to-date,"99/99/9999").
     2818     ELSE
     2819     FRAME v-suppl:TITLE =  "Отчет о поступлении и реализации товаров:" + parobj-type + " " + STRING(parobj-code) +
     2820                                  " c: " + string(from-date,"99/99/9999") +
     2821                                  " по: " + string(to-date,"99/99/9999").
     2822     apply "entry" to br-gds-brutto in frame v-suppl.
     2823     WAIT-FOR GO OF FRAME v-suppl.
     2824   END.
     2825   RUN disable_UI.
     2826   PROCEDURE bef-parts :
     2827   DEFINE INPUT PARAMETER basis-parts-type AS CHARACTER NO-UNDO.
     2828   FOR EACH bf-parts-brutto WHERE parts-brutto.part-type = basis-parts-type
     2829       NO-LOCK BREAK BY bf-parts-brutto.host-code
     2830                     BY bf-parts-brutto.obj-code
     2831                     BY bf-parts-brutto.obj-type
     2832                     BY bf-parts-brutto.artic
     2833                     BY bf-parts-brutto.prod-code
     2834                     BY bf-parts-brutto.prod-type
     2835                     BY bf-parts-brutto.in-code:
     2836       IF FIRST-OF(bf-parts-brutto.in-code) THEN DO:
     2837          FOR EACH ub.parts WHERE  ub.parts.host-code  = bf-parts-brutto.host-code
     2838                            AND ub.parts.obj-code   = bf-parts-brutto.obj-code
     2839                            AND ub.parts.obj-type   = bf-parts-brutto.obj-type
     2840                            AND ub.parts.artic      = bf-parts-brutto.artic
     2841                            AND ub.parts.prod-code  = bf-parts-brutto.prod-code
     2842                            AND ub.parts.prod-type  = bf-parts-brutto.prod-type
     2843                            AND ub.parts.status_    = yes
     2844                            AND ub.parts.fact-date  < from-date
     2845                            AND ub.parts.in-code    = bf-parts-brutto.in-code
     2846                            AND ub.parts.doc-type <> 'акт':U
     2847                            NO-LOCK:
     2848                 find first in-doc where in-doc.doc-code  = ub.parts.in-code no-lock no-error.
     2849                 IF AVAILABLE in-doc THEN DO:
     2850                    FIND FIRST in-line WHERE in-line.doc-code  = in-doc.doc-code AND
     2851                                             in-line.artic     = parts.artic     AND
     2852                                             in-line.prod-code = parts.prod-code AND
     2853                                             in-line.prod-type = parts.prod-type NO-LOCK NO-ERROR.
     2854                    IF NOT AVAILABLE in-line THEN DO:
     2855                       MESSAGE "Во внешней приходной накладной:" in-doc.doc-code SKIP
     2856                               "Не найдена строка по товару:" parts.artic " " parts.prod-code " " parts.prod-type SKIP
     2857                       VIEW-AS ALERT-BOX ERROR.
     2858                       RETURN ERROR.
     2859                    END.
     2860                 END.
     2861                 FIND FIRST ub.goods WHERE ub.goods.artic     = ub.parts.artic     AND
     2862                                        ub.goods.prod-code = ub.parts.prod-code AND
     2863                                        ub.goods.prod-type = ub.parts.prod-type NO-LOCK.
     2864                 RUN cr-parts-brutto.
     2865          END.
     2866       END.
     2867   END.
     2868   END PROCEDURE.
     2869   PROCEDURE calc :
     2870   DEFINE INPUT PARAMETER lparobj-type LIKE ub.parts.obj-type NO-UNDO.
     2871   DEFINE INPUT PARAMETER lparobj-code LIKE ub.parts.obj-code NO-UNDO.
     2872   def buffer b-parts for ub.parts.
     2873   if session:set-wait-state("COMPILER") then.
     2874   run waitfram-show in this-procedure
     2875     (input "Подождите..."
     2876     ).
     2877   FOR EACH ub.goods WHERE ub.goods.tnved begins partnved NO-LOCK,
     2878       EACH ub.parts WHERE ub.parts.host-code  = v-host-code
     2879                    AND ub.parts.obj-code   = lparobj-code
     2880                    AND ub.parts.obj-type   = lparobj-type
     2881                    AND ub.parts.artic      = ub.goods.artic
     2882                    AND ub.parts.prod-code  = ub.goods.prod-code
     2883                    AND ub.parts.prod-type  = ub.goods.prod-type
     2884                    AND ub.parts.status_    = yes
     2885                    AND ub.parts.fact-date <= to-date
     2886                    AND ub.parts.fact-date >= from-date
     2887                    AND ub.parts.doc-type <> 'акт':U NO-LOCK:
     2888       IF parobj-type = "all" THEN DO:
     2889          FIND FIRST ub.trn-doc WHERE ub.trn-doc.doc-code = ub.parts.out-code no-lock.
     2890          IF ub.trn-doc.internal = yes THEN NEXT.
     2891       END.
     2892       IF (parcst-units = "Базовая" AND ub.parts.fact-qnty = 0)
     2893          OR (parcst-units <> "Базовая" and ub.parts.fact-qnty * ub.goods.cst-base-rate = 0) THEN NEXT.
     2894       find first in-doc where in-doc.doc-code  = ub.parts.in-code no-lock no-error.
     2895       IF AVAILABLE in-doc THEN DO:
     2896          FIND FIRST in-line WHERE in-line.doc-code  = in-doc.doc-code AND
     2897                                   in-line.artic     = ub.parts.artic     AND
     2898                                   in-line.prod-code = ub.parts.prod-code AND
     2899                                   in-line.prod-type = ub.parts.prod-type NO-LOCK NO-ERROR.
     2900          IF NOT AVAILABLE in-line THEN DO:
     2901             MESSAGE "Во внешней приходной накладной:" in-doc.doc-code SKIP
     2902                     "Не найдена строка по товару:" ub.parts.artic " " ub.parts.prod-code " " ub.parts.prod-type SKIP
     2903             VIEW-AS ALERT-BOX ERROR.
     2904             RETURN ERROR.
     2905          END.
     2906       END.
     2907       ELSE
     2908       FIND FIRST ub.doc-line WHERE ub.doc-line.doc-code  = ub.parts.out-code  AND
     2909                                 ub.doc-line.artic     = ub.parts.artic          AND
     2910                                 ub.doc-line.prod-type = ub.parts.prod-type      AND
     2911                                 ub.doc-line.prod-code = ub.parts.prod-code      NO-LOCK.
     2912       RUN cr-parts-brutto.
     2913       FIND FIRST gds-brutto WHERE gds-brutto.artic    = parts-brutto.artic    AND
     2914                                   gds-brutto.cst-code = parts-brutto.cst-code NO-LOCK NO-ERROR.
     2915       IF NOT AVAILABLE gds-brutto THEN DO:
     2916          CREATE gds-brutto.
     2917          ASSIGN gds-brutto.artic     = parts-brutto.artic
     2918                 gds-brutto.prod-type = parts-brutto.prod-type
     2919                 gds-brutto.prod-code = parts-brutto.prod-code
     2920                 gds-brutto.cst-code  = parts-brutto.cst-code
     2921                 gds-brutto.gds-name  = goods.gds-name
     2922                 gds-brutto.unit      = (IF parcst-units = "Базовая" THEN goods.unit-base ELSE goods.unit-cst).
     2923       END.
     2924       IF (parts.doc-type = 'рас':U OR                           parts.doc-type = 'спи':U OR                          (parts.doc-type = 'инв':U AND parts.fact-qnty < 0)) THEN
     2925       ASSIGN gds-brutto.out-qnty      = gds-brutto.out-qnty      + (IF parcst-units = "Базовая" THEN parts.fact-qnty ELSE parts.fact-qnty * goods.cst-base-rate)
     2926              gds-brutto.out-wt-brutto = gds-brutto.out-wt-brutto +
     2927              (IF AVAILABLE in-doc
     2928               THEN (in-line.wt-brutto  / in-line.fact-qnty) * parts.fact-qnty
     2929               ELSE (doc-line.wt-brutto / doc-line.fact-qnty) * parts.fact-qnty)
     2930              gds-brutto.out-fact-place  = gds-brutto.out-fact-place  +
     2931              (IF AVAILABLE in-doc
     2932               THEN (in-line.num-place  / in-line.fact-qnty) * parts.fact-qnty
     2933               ELSE (doc-line.num-place / doc-line.fact-qnty) * parts.fact-qnty)            .
     2934       ELSE
     2935       ASSIGN gds-brutto.in-qnty       = gds-brutto.in-qnty       + (IF parcst-units = "Базовая" THEN parts.fact-qnty ELSE parts.fact-qnty * goods.cst-base-rate)
     2936              gds-brutto.in-wt-brutto  = gds-brutto.in-wt-brutto  +
     2937              (IF AVAILABLE in-doc
     2938               THEN (in-line.wt-brutto  / in-line.fact-qnty) * parts.fact-qnty
     2939               ELSE (doc-line.wt-brutto / doc-line.fact-qnty) * parts.fact-qnty)
     2940              gds-brutto.in-fact-place  = gds-brutto.in-fact-place  +
     2941              (IF AVAILABLE in-doc
     2942               THEN (in-line.num-place  / in-line.fact-qnty) * parts.fact-qnty
     2943               ELSE (doc-line.num-place / doc-line.fact-qnty) * parts.fact-qnty)            .
     2944   END.
     2945   IF parkindrep = "OUT" then run bef-parts ("OUT").
     2946                         else run bef-parts ("IN").
     2947   FOR EACH parts-brutto WHERE  parts-brutto.part-type = "IN"
     2948       BY parts-brutto.fact-num:
     2949       IF parkindrep = "IN"                 AND
     2950          parts-brutto.fact-date >= from-date THEN DO:
     2951          CREATE prt-parts-brutto.
     2952          ASSIGN
     2953          prt-parts-brutto.des           = STRING(parts-brutto.out-code)
     2954          prt-parts-brutto.in-date       = STRING(parts-brutto.fact-date)
     2955          prt-parts-brutto.cst-code      = parts-brutto.cst-code
     2956          prt-parts-brutto.obj-code      = parts-brutto.obj-code
     2957          prt-parts-brutto.obj-type      = parts-brutto.obj-type
     2958          prt-parts-brutto.host-code     = parts-brutto.host-code
     2959          prt-parts-brutto.artic         = parts-brutto.artic
     2960          prt-parts-brutto.prod-code     = parts-brutto.prod-code
     2961          prt-parts-brutto.prod-type     = parts-brutto.prod-type
     2962          prt-parts-brutto.in-num        = parts-brutto.fact-num
     2963          prt-parts-brutto.tnved         = parts-brutto.tnved
     2964          prt-parts-brutto.gds-name      = parts-brutto.gds-name
     2965          prt-parts-brutto.nationality   = parts-brutto.nationality
     2966          prt-parts-brutto.unit          = parts-brutto.unit
     2967          prt-parts-brutto.in-qnty       = STRING(parts-brutto.fact-qnty)
     2968          prt-parts-brutto.in-qnty-up    = string(parts-brutto.qnty-up)
     2969          prt-parts-brutto.in-wt-brutto  = STRING(parts-brutto.fact-brutto)
     2970          prt-parts-brutto.in-fact-place = STRING(parts-brutto.fact-place)
     2971          prt-parts-brutto.out-qnty      = "0"
     2972          prt-parts-brutto.out-qnty-up   = "0"
     2973          prt-parts-brutto.out-wt-brutto = "0"
     2974          prt-parts-brutto.out-fact-place = "0".
     2975       END.
     2976       IF parkindrep = "OUT" AND
     2977          NOT CAN-FIND (FIRST out-parts-brutto WHERE out-parts-brutto.part-type = "OUT"                   AND
     2978                                                     out-parts-brutto.host-code  = parts-brutto.host-code AND
     2979                                                     out-parts-brutto.obj-code   = parts-brutto.obj-code  AND
     2980                                                     out-parts-brutto.obj-type   = parts-brutto.obj-type  AND
     2981                                                     out-parts-brutto.artic      = parts-brutto.artic     AND
     2982                                                     out-parts-brutto.prod-type  = parts-brutto.prod-type AND
     2983                                                     out-parts-brutto.prod-code  = parts-brutto.prod-code AND
     2984                                                     out-parts-brutto.in-code    = parts-brutto.in-code   AND
     2985                                                     out-parts-brutto.fact-num   > parts-brutto.fact-num  AND
     2986                                                     out-parts-brutto.fact-qnty  - parts-brutto.down-qnty > 0)
     2987                                       THEN DO:
     2988          CREATE prt-parts-brutto.
     2989          ASSIGN
     2990          prt-parts-brutto.des           = STRING(parts-brutto.out-code)
     2991          prt-parts-brutto.in-date       = STRING(parts-brutto.fact-date)
     2992          prt-parts-brutto.cst-code      = parts-brutto.cst-code
     2993          prt-parts-brutto.obj-code      = parts-brutto.obj-code
     2994          prt-parts-brutto.obj-type      = parts-brutto.obj-type
     2995          prt-parts-brutto.host-code     = parts-brutto.host-code
     2996          prt-parts-brutto.artic         = parts-brutto.artic
     2997          prt-parts-brutto.prod-code     = parts-brutto.prod-code
     2998          prt-parts-brutto.prod-type     = parts-brutto.prod-type
     2999          prt-parts-brutto.in-num        = parts-brutto.fact-num
     3000          prt-parts-brutto.out-num       = ?
     3001          prt-parts-brutto.tnved         = parts-brutto.tnved
     3002          prt-parts-brutto.gds-name      = parts-brutto.gds-name
     3003          prt-parts-brutto.nationality   = parts-brutto.nationality
     3004          prt-parts-brutto.unit          = parts-brutto.unit
     3005          prt-parts-brutto.in-qnty       = STRING(parts-brutto.fact-qnty)
     3006          prt-parts-brutto.in-qnty-up    = string(parts-brutto.qnty-up)
     3007          prt-parts-brutto.in-wt-brutto  = STRING(parts-brutto.fact-brutto)
     3008          prt-parts-brutto.in-fact-place = STRING(parts-brutto.fact-place)
     3009          prt-parts-brutto.out-date      = "НЕТ"
     3010          prt-parts-brutto.out-qnty      = ""
     3011          prt-parts-brutto.out-qnty-up   = ""
     3012          prt-parts-brutto.out-wt-brutto = ""
     3013          prt-parts-brutto.out-fact-place = "".
     3014       END.
     3015       FOR EACH out-parts-brutto WHERE out-parts-brutto.part-type  = "OUT"                       AND
     3016                                       out-parts-brutto.host-code  = parts-brutto.host-code      AND
     3017                                       out-parts-brutto.obj-code   = parts-brutto.obj-code       AND
     3018                                       out-parts-brutto.obj-type   = parts-brutto.obj-type       AND
     3019                                       out-parts-brutto.artic      = parts-brutto.artic          AND
     3020                                       out-parts-brutto.prod-type  = parts-brutto.prod-type      AND
     3021                                       out-parts-brutto.prod-code  = parts-brutto.prod-code      AND
     3022                                       out-parts-brutto.in-code    = parts-brutto.in-code        AND
     3023                                       out-parts-brutto.fact-num   > parts-brutto.fact-num       AND
     3024                                       out-parts-brutto.fact-qnty  - parts-brutto.down-qnty > 0
     3025                                       BREAK BY out-parts-brutto.fact-num:
     3026           ASSIGN out-parts-brutto.down-qnty = out-parts-brutto.fact-qnty
     3027                  parts-brutto.down-qnty     = parts-brutto.down-qnty + out-parts-brutto.fact-qnty.
     3028           IF (out-parts-brutto.fact-date >= from-date OR
     3029               parts-brutto.fact-date     >= from-date )
     3030              AND parkindrep = "OUT" THEN DO:
     3031                 CREATE prt-parts-brutto.
     3032                 ASSIGN
     3033                  prt-parts-brutto.des           = STRING(parts-brutto.out-code)
     3034                  prt-parts-brutto.in-date       = IF FIRST(out-parts-brutto.fact-num) THEN STRING(parts-brutto.fact-date) ELSE ""
     3035                  prt-parts-brutto.cst-code      = parts-brutto.cst-code
     3036                  prt-parts-brutto.artic         = parts-brutto.artic
     3037                  prt-parts-brutto.obj-code      = parts-brutto.obj-code
     3038                  prt-parts-brutto.obj-type      = parts-brutto.obj-type
     3039                  prt-parts-brutto.host-code     = parts-brutto.host-code
     3040                  prt-parts-brutto.prod-code     = parts-brutto.prod-code
     3041                  prt-parts-brutto.prod-type     = parts-brutto.prod-type
     3042                  prt-parts-brutto.in-num        = parts-brutto.fact-num
     3043                  prt-parts-brutto.out-num       = out-parts-brutto.fact-num
     3044                  prt-parts-brutto.tnved         = IF FIRST(out-parts-brutto.fact-num) THEN parts-brutto.tnved       ELSE ""
     3045                  prt-parts-brutto.gds-name      = IF FIRST(out-parts-brutto.fact-num) THEN parts-brutto.gds-name    ELSE ""
     3046                  prt-parts-brutto.nationality   = IF FIRST(out-parts-brutto.fact-num) THEN parts-brutto.nationality ELSE ""
     3047                  prt-parts-brutto.unit          = IF FIRST(out-parts-brutto.fact-num) THEN parts-brutto.unit        ELSE ""
     3048                  prt-parts-brutto.in-qnty       = IF FIRST(out-parts-brutto.fact-num)    AND
     3049                                                      parts-brutto.fact-date >= from-date THEN STRING(parts-brutto.fact-qnty) ELSE ""
     3050                  prt-parts-brutto.in-qnty-up    = IF FIRST(out-parts-brutto.fact-num)    AND
     3051                                                      parts-brutto.fact-date >= from-date THEN STRING(parts-brutto.qnty-up) ELSE ""
     3052                  prt-parts-brutto.in-wt-brutto  = IF FIRST(out-parts-brutto.fact-num)    AND
     3053                                                      parts-brutto.fact-date >= from-date THEN STRING(parts-brutto.fact-brutto) ELSE ""
     3054                  prt-parts-brutto.in-fact-place  = IF FIRST(out-parts-brutto.fact-num)    AND
     3055                                                      parts-brutto.fact-date >= from-date THEN STRING(parts-brutto.fact-place) ELSE ""
     3056                  prt-parts-brutto.out-date      = STRING(out-parts-brutto.fact-date)
     3057                  prt-parts-brutto.out-qnty      = STRING(out-parts-brutto.fact-qnty)
     3058                  prt-parts-brutto.out-qnty-up   = STRING(out-parts-brutto.qnty-up)
     3059                  prt-parts-brutto.out-wt-brutto = STRING(out-parts-brutto.fact-brutto)
     3060                  prt-parts-brutto.out-fact-place = STRING(out-parts-brutto.fact-place).
     3061           END.
     3062           ELSE IF parkindrep = "IN"  AND
     3063                   parts-brutto.fact-date >= from-date THEN DO:
     3064                 ASSIGN
     3065                  prt-parts-brutto.out-qnty       = STRING(DECIMAL(prt-parts-brutto.out-qnty) + out-parts-brutto.fact-qnty)
     3066                  prt-parts-brutto.out-wt-brutto  = STRING(DECIMAL(prt-parts-brutto.out-wt-brutto) + out-parts-brutto.fact-brutto)
     3067                  prt-parts-brutto.out-fact-place = STRING(DECIMAL(prt-parts-brutto.out-fact-place) + out-parts-brutto.fact-place).
     3068           END.
     3069           IF parts-brutto.fact-qnty - parts-brutto.down-qnty = 0 THEN LEAVE.
     3070       END.
     3071   END.
     3072   IF parkindrep = "OUT" THEN
     3073   FOR EACH parts-brutto WHERE parts-brutto.part-type = "OUT" AND
     3074                               NOT CAN-FIND(FIRST in-parts-brutto WHERE
     3075                                             in-parts-brutto.part-type  = "IN"                        AND
     3076                                             in-parts-brutto.host-code  = parts-brutto.host-code      AND
     3077                                             in-parts-brutto.obj-code   = parts-brutto.obj-code       AND
     3078                                             in-parts-brutto.obj-type   = parts-brutto.obj-type       AND
     3079                                             in-parts-brutto.artic      = parts-brutto.artic          AND
     3080                                             in-parts-brutto.prod-type  = parts-brutto.prod-type      AND
     3081                                             in-parts-brutto.prod-code  = parts-brutto.prod-code      AND
     3082                                             in-parts-brutto.in-code    = parts-brutto.in-code NO-LOCK) :
     3083          CREATE prt-parts-brutto.
     3084          ASSIGN
     3085          prt-parts-brutto.in-date       = ?
     3086          prt-parts-brutto.des           = STRING(parts-brutto.out-code)
     3087          prt-parts-brutto.cst-code      = parts-brutto.cst-code
     3088          prt-parts-brutto.obj-code      = parts-brutto.obj-code
     3089          prt-parts-brutto.obj-type      = parts-brutto.obj-type
     3090          prt-parts-brutto.host-code     = parts-brutto.host-code
     3091          prt-parts-brutto.artic         = parts-brutto.artic
     3092          prt-parts-brutto.prod-code     = parts-brutto.prod-code
     3093          prt-parts-brutto.prod-type     = parts-brutto.prod-type
     3094          prt-parts-brutto.in-num        = ?
     3095          prt-parts-brutto.out-num       = ?
     3096          prt-parts-brutto.tnved         = parts-brutto.tnved
     3097          prt-parts-brutto.gds-name      = parts-brutto.gds-name
     3098          prt-parts-brutto.nationality   = parts-brutto.nationality
     3099          prt-parts-brutto.unit          = parts-brutto.unit
     3100          prt-parts-brutto.in-qnty       = ?
     3101          prt-parts-brutto.in-qnty-up    = ?
     3102          prt-parts-brutto.in-wt-brutto  = ?
     3103          prt-parts-brutto.in-fact-place = ?
     3104          prt-parts-brutto.out-date      = STRING(parts-brutto.fact-date)
     3105          prt-parts-brutto.out-qnty      = STRING(parts-brutto.fact-qnty)
     3106          prt-parts-brutto.out-qnty-up   = string(parts-brutto.qnty-up)
     3107          prt-parts-brutto.out-wt-brutto = STRING(parts-brutto.fact-brutto)
     3108          prt-parts-brutto.out-fact-place = STRING(parts-brutto.fact-place).
     3109   END.
     3110   output close.
     3111   run waitfram-hide in this-procedure .
     3112   END PROCEDURE.
     3113   PROCEDURE cr-parts-brutto :
     3114       FIND FIRST parts-brutto WHERE
     3115                               parts-brutto.host-code     = ub.parts.host-code  AND
     3116                               parts-brutto.obj-code      = ub.parts.obj-code   AND
     3117                               parts-brutto.obj-type      = ub.parts.obj-type   AND
     3118                               parts-brutto.artic         = ub.parts.artic      AND
     3119                               parts-brutto.prod-type     = ub.parts.prod-type  AND
     3120                               parts-brutto.prod-code     = ub.parts.prod-code  AND
     3121                               parts-brutto.in-code       = ub.parts.in-code    AND
     3122                               parts-brutto.part-type     = IF (parts.doc-type = 'рас':U OR                           parts.doc-type = 'спи':U OR                          (parts.doc-type = 'инв':U AND parts.fact-qnty < 0)) THEN "OUT" ELSE "IN" NO-ERROR.
     3123       IF NOT AVAILABLE parts-brutto THEN DO:
     3124          CREATE parts-brutto.
     3125          ASSIGN
     3126          parts-brutto.in-code       = ub.parts.in-code
     3127          parts-brutto.out-code      = ub.parts.out-code
     3128          parts-brutto.part-code     = ub.parts.part-code
     3129          parts-brutto.host-code     = v-host-code
     3130          parts-brutto.obj-code      = ub.parts.obj-code
     3131          parts-brutto.obj-type      = ub.parts.obj-type
     3132          parts-brutto.artic         = ub.parts.artic
     3133          parts-brutto.prod-type     = ub.parts.prod-type
     3134          parts-brutto.prod-code     = ub.parts.prod-code
     3135          parts-brutto.gds-name      = ub.goods.gds-name
     3136          parts-brutto.tnved         = ub.goods.tnved
     3137          parts-brutto.nationality   = ub.goods.nationality
     3138          parts-brutto.unit          = (IF parcst-units = "Базовая" THEN ub.goods.unit-base ELSE ub.goods.unit-cst)
     3139          parts-brutto.part-type     = (IF (parts.doc-type = 'рас':U OR                           parts.doc-type = 'спи':U OR                          (parts.doc-type = 'инв':U AND parts.fact-qnty < 0)) THEN "OUT" ELSE "IN")
     3140          parts-brutto.fact-date     = if available in-doc then in-doc.exch-date else parts.fact-date
     3141          parts-brutto.fact-num      = ub.parts.fact-num
     3142          parts-brutto.cst-code      = if ub.parts.cst-code <> ? then ub.parts.cst-code else ?.
     3143       END.
     3144       ASSIGN
     3145       parts-brutto.fact-qnty     = parts-brutto.fact-qnty + (IF parcst-units = "Базовая" THEN parts.fact-qnty ELSE parts.fact-qnty * goods.cst-base-rate)
     3146       parts-brutto.qnty-up       = parts-brutto.fact-qnty / ub.goods.qnty-cart
     3147       parts-brutto.fact-brutto   = parts-brutto.fact-brutto +
     3148       (IF AVAILABLE in-doc
     3149        THEN (in-line.wt-brutto  / in-line.fact-qnty) * ub.parts.fact-qnty
     3150        ELSE (ub.doc-line.wt-brutto / ub.doc-line.fact-qnty) * ub.parts.fact-qnty)
     3151       parts-brutto.fact-place   = parts-brutto.fact-place +
     3152       (IF AVAILABLE in-doc
     3153        THEN (in-line.num-place  / in-line.fact-qnty) * ub.parts.fact-qnty
     3154        ELSE (doc-line.num-place / ub.doc-line.fact-qnty) * ub.parts.fact-qnty).
     3155   END PROCEDURE.
     3156   PROCEDURE disable_UI :
     3157     HIDE FRAME v-suppl.
     3158   END PROCEDURE.
     3159   PROCEDURE enable_UI :
     3160     DISPLAY a-n-c
     3161         WITH FRAME v-suppl.
     3162     ENABLE b-excel b-print b-help b-quit b-parts a-n-c br-gds-brutto
     3163         WITH FRAME v-suppl.
     3164     VIEW FRAME v-suppl.
     3165     OPEN QUERY br-gds-brutto FOR EACH gds-brutto.
     3166   END PROCEDURE.
