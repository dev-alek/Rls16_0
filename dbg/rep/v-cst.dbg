      954   ON CHOOSE OF b-excel IN FRAME v-suppl
      955   DO:
      956   DEFINE VARIABLE chExcelApplication      AS COM-HANDLE.
      957   DEFINE VARIABLE chWorkbook              AS COM-HANDLE.
      958   DEFINE VARIABLE chWorksheet             AS COM-HANDLE.
      959   DEFINE VARIABLE iColumn                 AS INTEGER INITIAL 1.
      960   DEFINE VARIABLE cColumn                 AS CHARACTER.
      961   DEFINE VARIABLE cRange                  AS CHARACTER.
      962   CREATE "Excel.Application" chExcelApplication no-error.
      963       if error-status :error then do:
      964           message
      965           "Ошибка при запуске Excel" skip
      966           error-status :get-message(1) skip
      967           view-as alert-box error .
      968           return no-apply .
      969       end.
      970   chExcelApplication:Visible = TRUE.
      971   chWorkbook = chExcelApplication:Workbooks:Add().
      972   chWorkSheet = chExcelApplication:Sheets:Item(1).
      973   chWorkSheet:Columns("A":U):ColumnWidth = 17.
      974   chWorkSheet:Columns("B":U):ColumnWidth = 15.
      975   chWorkSheet:Columns("C":U):ColumnWidth = 22.
      976   chWorkSheet:Columns("D":U):ColumnWidth = 10.
      977   chWorkSheet:Columns("E":U):ColumnWidth = 16.
      978   chWorkSheet:Columns("F":U):ColumnWidth = 40.
      979   chWorkSheet:Columns("G":U):ColumnWidth = 20.
      980   chWorkSheet:Columns("H":U):ColumnWidth = 3.
      981   chWorkSheet:Columns("I":U):ColumnWidth = 25.
      982   chWorkSheet:Columns("J":U):ColumnWidth = 25.
      983   chWorkSheet:Columns("K":U):ColumnWidth = 25.
      984   chWorkSheet:Columns("L":U):ColumnWidth = 25.
      985   chWorkSheet:Columns("M":U):ColumnWidth = 10.
      986   chWorkSheet:Columns("N":U):ColumnWidth = 25.
      987   chWorkSheet:Columns("O":U):ColumnWidth = 25.
      988   chWorkSheet:Columns("P":U):ColumnWidth = 25.
      989   chWorkSheet:Columns("Q":U):ColumnWidth = 25.
      990   chWorkSheet:Columns("R":U):ColumnWidth = 25.
      991   chWorkSheet:Columns("S":U):ColumnWidth = 25.
      992   chWorkSheet:Range("A1:S1"):Font:Bold = TRUE.
      993   chWorkSheet:Range("A1"):Value = "Номер по порядку".
      994   chWorkSheet:Range("B1"):Value = "Дата поступления".
      995   chWorkSheet:Range("C1"):Value = "ГТД".
      996   chWorkSheet:Range("D1"):Value = "ТаможКод".
      997   chWorkSheet:Range("E1"):Value = "Артикул".
      998   chWorkSheet:Range("F1"):Value = "Наименование товара".
      999   chWorkSheet:Range("G1"):Value = "Статус товара".
     1000   chWorkSheet:Range("H1"):Value = "Ед".
     1001   chWorkSheet:Range("I1"):Value = "Кол-во ед. при поступлении".
     1002   chWorkSheet:Range("J1"):Value = "Кол-во уп. при поступлении".
     1003   chWorkSheet:Range("K1"):Value = "Вес при поступлении".
     1004   chWorkSheet:Range("L1"):Value = "Кол-во мест при поступлении".
     1005   chWorkSheet:Range("M1"):Value = "Дата выбытия".
     1006   chWorkSheet:Range("N1"):Value = "Кол-во ед. при выбытии".
     1007   chWorkSheet:Range("O1"):Value = "Кол-во уп. при выбытии".
     1008   chWorkSheet:Range("P1"):Value = "Вес при выбытии".
     1009   chWorkSheet:Range("Q1"):Value = "Кол-во мест при выбытии".
     1010   chWorkSheet:Range("R1"):Value = "Остаток".
     1011   chWorkSheet:Range("S1"):Value = "Примечание".
     1012   FOR EACH prt-parts-brutto:
     1013     iColumn = iColumn + 1.
     1014     cColumn = STRING(iColumn).
     1015     cRange = "A":U + cColumn.
     1016     chWorkSheet:Range(cRange):Value = iColumn - 1.
     1017     cRange = "B":U + cColumn.
     1018     chWorkSheet:Range(cRange):Value = prt-parts-brutto.in-date.
     1019     cRange = "C":U + cColumn.
     1020     chWorkSheet:Range(cRange):NumberFormat = "@" .
     1021     chWorkSheet:Range(cRange):Value = prt-parts-brutto.cst-code.
     1022     cRange = "D":U + cColumn.
