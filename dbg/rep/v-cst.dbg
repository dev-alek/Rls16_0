      561       FIELD out-qnty       AS   CHARACTER
      562       FIELD out-qnty-up    AS   CHARACTER
      563       FIELD out-wt-brutto  AS   CHARACTER
      564       FIELD out-fact-place AS   CHARACTER
      565       FIELD des            AS   CHARACTER
      566       INDEX in-out IS PRIMARY cst-code in-num out-num ASCENDING .
      567   define new global shared variable g#libbcrcn as handle no-undo .
      568   procedure proc-alt-shift-f2:
      569     if not ibs.th.gbl.gbl-var:rcode
      570   then
      571     run gbl\inidebug.p .
      572   end.
      573   procedure proc-alt-shift-f3:
      574     run gbl/prvssinf.p
      575       ( input this-procedure
      576       ) .
      577   end.
      578   define variable v-inform-launched as logical no-undo initial false .
      579   procedure proc-alt-shift-f4:
      580     define variable v-action as character no-undo .
      581     if v-inform-launched = false then do:
      582       assign
      583         v-inform-launched = true
      584       .
      585       run gbl/d-inform.w
      586         (  input self
      587         ,  input this-procedure
      588         , output v-action
      589         ) no-error .
      590       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      591       assign
      592         v-inform-launched = false
      593       .
      594     end.
      595   end.
      596   procedure proc-alt-f1:
      597     run gbl/corrhelp.p
      598       (input this-procedure
      599       ) .
      600   end .
      601   on alt-shift-f2 anywhere do:
      602     run proc-alt-shift-f2.
      603   end.
      604   on alt-shift-f3 anywhere do:
      605     run proc-alt-shift-f3 in this-procedure .
      606   end.
      607   on alt-shift-f4 anywhere do:
      608     run proc-alt-shift-f4 in this-procedure.
      609   end.
      610   on alt-f1 anywhere do:
      611     run proc-alt-f1 in this-procedure .
      612   end.
      613   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      614   define variable v-waitfram-action01         as character   no-undo .
      615   define variable v-waitfram-action02         as character   no-undo .
      616   define variable v-waitfram-action03         as character   no-undo .
      617   define variable mWaitFramTextBeg            as character   no-undo.
      618   define variable mWaitFramTextEnd            as character   no-undo.
      619   define variable mWaitFramView               as logical     no-undo.
      620   define variable mWaitProcEvent              as logical     no-undo init yes.
      621   define variable mWaitFramInterval           as integer     no-undo init 1 .
      622   define variable mWaitFramStop               as logical     no-undo.
      623   define variable mWaitFramStopUser           as logical     no-undo.
      624   define variable mWaitFramStopTimeOut        as logical     no-undo.
      625   define variable mWaitFramStartProc          as datetime-tz no-undo.
      626   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      627   define button B-WaitFramStop auto-end-key
      628        label "Стоп"
      629        size 10 by 1 tooltip "Остоновить процесс".
      630   define button B-viewProcInfo
      631        label "Информация"
      632        size 15 by 1 tooltip "Информация о процесс".
      633   define frame waitfram
      634     v-waitfram-action01 format "x(72)" no-label skip
      635     v-waitfram-action02 format "x(72)" no-label skip
      636     v-waitfram-action03 format "x(72)" no-label skip
      637     B-viewProcInfo
      638     B-WaitFramStop at row 4 col 30
      639     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      640     .
      641   define new global shared variable mBatchMode as logical no-undo init ?.
      642   define variable mFramBachModHandle as handle no-undo.
      643   mFramBachModHandle = frame waitfram:handle.
      644   define variable mFameOldVis as logical no-undo.
      645   define variable mVisCUrentVin as logical no-undo.
      646   if session:batch-mode
      647   then
      648      mBatchMode = yes.
      649   if mBatchMode = ? then do:
      650     mVisCUrentVin = current-window:visible.
      651     mFameOldVis = mFramBachModHandle:visible.
      652     mFramBachModHandle:visible  = yes.
      653     mBatchMode = mFramBachModHandle:visible ne yes.
      654     mFramBachModHandle:visible = mFameOldVis.
      655     current-window:visible = mVisCUrentVin.
      656   end.
      657    if  log-manager:logfile-name ne ?
      658     then DO:
      659         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      660         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      661         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      662     end.
      663   on choose of B-WaitFramStop in frame waitfram
      664   do:
      665     mWaitFramStop = yes.
      666     mWaitFramStopUser = yes.
      667   end.
      668   function waitfram-check-timeout returns logical():
      669      define variable vtime as int64 no-undo.
      670      if mWaitFramStopTimeOut
      671      then
      672         return yes.
      673      vtime = ( now - mWaitFramStartProc ) / 1000 .
      674      if     mWaitFramTimeOut ne ?
      675         and mWaitFramTimeOut ne 0
      676         and mWaitFramTimeOut lt vtime
      677      then do:
      678         mWaitFramStopTimeOut = yes.
      679      end.
      680      return mWaitFramStopTimeOut.
      681   end.
      682   procedure waitfram-hide :
      683     if not session:batch-mode
      684     then do
      685     on error undo, return error return-value
      686     :
      687       pause 0 before-hide .
      688       if not mBatchMode then
      689         hide frame waitfram .
      690     if     not mWaitFramView
      691        and mWaitProcEvent
      692     then
      693       process events .
      694     end.
      695   end procedure.
      696   procedure waitfram-show :
      697     define input  parameter p-message as character no-undo .
      698     define variable v-left-margin as integer   no-undo .
      699     if not session:batch-mode
      700     then do
      701     on error undo, return error return-value
      702     :
      703       if length(p-message) <= 70 then do:
      704         assign
      705           v-left-margin = integer((70 - length(p-message)) / 2)
      706         .
      707         assign
      708           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      709         .
      710         assign
      711           v-waitfram-action01 = " "
      712           v-waitfram-action02 = " "
      713                                    + fill(" ", v-left-margin)
      714                                    + p-message
      715           v-waitfram-action03 = " "
      716         .
      717       end.
      718       else do:
      719         define variable vRindex1 as integer no-undo.
      720         define variable vRindex2 as integer no-undo.
      721         vRindex1 = r-index(p-message," ",70).
      722         if vRindex1 = 0
      723         then
      724            vRindex1 = 70.
      725         if length(p-message)  <= vRindex1 + 70 then do:
      726           assign
      727             v-waitfram-action01 = " "
      728             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      729             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      730           .
      731         end.
      732         else do:
      733           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      734           if vRindex2 <= vRindex1
      735           then
      736              vRindex2 = vRindex1 + 70.
      737           assign
      738             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      739             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      740             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      741           .
      742         end.
      743       end.
      744       B-viewProcInfo:visible   in frame waitfram = no.
      745       B-viewProcInfo:sensitive in frame waitfram = no.
      746       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      747       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      748       if  (   mWaitFramView
      749          or  mWaitProcEvent)
      750          and not mBatchMode
      751       then
      752          display
      753             v-waitfram-action01 skip
      754             v-waitfram-action02 skip
      755             v-waitfram-action03 skip
      756          with frame waitfram .
      757       if     mWaitFramView
      758          then do:
      759             if     mWaitFramInterval ne ?
      760                and not mBatchMode
      761             then
      762                wait-for go of frame waitfram pause mWaitFramInterval.
      763          end.
      764          else
      765             if     mWaitProcEvent
      766                and not mBatchMode
      767             then
      768                process events .
      769     end.
      770   end procedure.
      771      procedure waitfram-show-this:
      772         define input  parameter iInterval as int64 no-undo.
      773         define variable vtime as int64 no-undo.
      774         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      775         mWaitFramInterval = iInterval.
      776         run waitfram-show (substitute("&1&2 &3&4" ,
      777                                       mWaitFramTextBeg ,
      778                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      779                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      780                                       mWaitFramTextEnd
      781                                      )
      782                           ).
      783      end.
      784      procedure WaitFramRunPause:
      785         define input  parameter iInterval as dec no-undo.
      786         define variable vStart  as datetime-tz no-undo.
      787         define variable vend    as datetime-tz no-undo.
      788         define variable vint as int64 no-undo.
      789         define variable vOk as logical no-undo.
      790         vStart = now.
      791         vend   = vStart.
      792         publish "WaitFramPause" (iInterval,output vOk).
      793         vend   =  now.
      794         vint = vend - vStart.
      795         vint = iInterval - vint / 1000.
      796         if     not mWaitFramStop
      797            and (   vint > 0
      798                 or (    not vOk
      799                     and iInterval eq ?
      800                     )
      801                 )
      802         then
      803            run waitfram-show-this (iInterval).
      804         vend   =  now.
      805         vint = vend - vStart.
      806         vint = iInterval - vint / 1000.
      807         if     not mWaitFramStop
      808            and vint > 0
      809         then do:
      810            run gbl/pause.p (vint * 1000).
      811         end.
      812         if iInterval ne ?
      813         then
      814            publish "WaitFramStop".
      815         waitfram-check-timeout().
      816      end.
      817      procedure WaitFramWaitFor:
      818         define input  parameter iInterval as dec no-undo.
      819         assign
      820            mWaitFramStartProc   = now
      821            mWaitFramStopUser    = no
      822            mWaitFramStopTimeOut = no
      823         .
      824         block-wait:
      825         do while not mWaitFramStop:
      826            run WaitFramRunPause (iInterval).
      827            if  waitfram-check-timeout()
      828            then do:
      829               leave block-wait.
      830            end.
      831         end.
      832         run waitfram-hide.
      833      end.
      834   procedure waitfram-join :
      835     define input  parameter p-line-1  as character no-undo .
      836     define input  parameter p-line-2  as character no-undo .
      837     define input  parameter p-line-3  as character no-undo .
      838     define output parameter p-message as character no-undo .
      839     do
      840     on error undo, return error return-value
      841     :
      842       assign
      843         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      844                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      845                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      846       .
      847     end.
      848   end procedure.
      849   function waitfram-join-function returns character
      850     (input p-line-1 as character
      851     ,input p-line-2 as character
      852     ,input p-line-3 as character
      853     ).
      854     define variable v-message as character no-undo .
      855     run waitfram-join in this-procedure
      856       (input  p-line-1
      857       ,input  p-line-2
      858       ,input  p-line-3
      859       ,output v-message
      860       ) .
      861     return v-message .
      862   end function .
      863   define variable line-rec as recid no-undo .
      864   IF partnved = "Всё" THEN ASSIGN partnved = "".
      865   DEFINE BUFFER l-gds-brutto FOR gds-brutto.
      866   DEFINE BUFFER in-doc FOR ub.trn-doc.
      867   DEFINE BUFFER in-line FOR ub.doc-line.
