     1024     cRange = "E":U + cColumn.
     1025     chWorkSheet:Range(cRange):Value = prt-parts-brutto.artic.
     1026     cRange = "F":U + cColumn.
     1027     chWorkSheet:Range(cRange):Value = prt-parts-brutto.gds-name.
     1028     cRange = "G":U + cColumn.
     1029     chWorkSheet:Range(cRange):Value = prt-parts-brutto.nationality.
     1030     cRange = "H":U + cColumn.
     1031     chWorkSheet:Range(cRange):Value = prt-parts-brutto.unit.
     1032     cRange = "I":U + cColumn.
     1033     chWorkSheet:Range(cRange):Value = prt-parts-brutto.in-qnty.
     1034     cRange = "J":U + cColumn.
     1035     chWorkSheet:Range(cRange):Value = prt-parts-brutto.in-qnty-up.
     1036     cRange = "K":U + cColumn.
     1037     chWorkSheet:Range(cRange):Value = prt-parts-brutto.in-wt-brutto.
     1038     cRange = "L":U + cColumn.
     1039     chWorkSheet:Range(cRange):Value = prt-parts-brutto.in-fact-place.
     1040     cRange = "M":U + cColumn.
     1041     chWorkSheet:Range(cRange):Value = prt-parts-brutto.out-date.
     1042     cRange = "M":U + cColumn.
     1043     chWorkSheet:Range(cRange):Value = prt-parts-brutto.out-qnty.
     1044     cRange = "N":U + cColumn.
     1045     chWorkSheet:Range(cRange):Value = prt-parts-brutto.out-qnty-up.
     1046     cRange = "O":U + cColumn.
     1047     chWorkSheet:Range(cRange):Value = prt-parts-brutto.out-wt-brutto.
     1048     cRange = "P":U + cColumn.
     1049     chWorkSheet:Range(cRange):Value = prt-parts-brutto.out-fact-place.
     1050     cRange = "R":U + cColumn.
     1051     chWorkSheet:Range(cRange):Value = decimal(prt-parts-brutto.in-qnty) - decimal(prt-parts-brutto.out-qnty).
     1052     cRange = "S":U + cColumn.
     1053     chWorkSheet:Range(cRange):Value = prt-parts-brutto.des.
     1054   END.
     1055   RELEASE OBJECT chWorksheet NO-ERROR.
     1056   RELEASE OBJECT chWorkbook NO-ERROR.
     1057   chExcelApplication :QUIT().
     1058   RELEASE OBJECT  chExcelApplication  NO-ERROR.
     1059   END.
