     2010     procedure on-same-page :
     2011       define input parameter p-line-number as integer no-undo .
     2012       if p-line-number > page-size( PrnLibstream )
     2013       then do:
     2014         return .
     2015       end.
     2016       if line-counter( PrnLibstream ) + p-line-number > page-size( PrnLibstream )
     2017       then do:
     2018         page stream PrnLibstream .
     2019       end.
     2020     end procedure.
     2021   DEFINE FRAME FRAME-3
