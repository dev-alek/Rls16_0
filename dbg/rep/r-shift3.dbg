     2064   FORM HEADER
     2065   string( p-z-number-list, "x(198)":U ) format "x(198)":U skip "-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------" skip "                    ИНФОРМАЦИЯ О ТОВАРЕ                :                         РАСШИФРОВКА ПОСТУПЛЕНИЯ                    :             РАСШИФРОВКА РЕАЛИЗАЦИИ        :         ОСТАТОК      " skip "-------------------------------------------------------:--------------------------------------------------------------------:-------------------------------------------:         на конец     " skip "           НАИМЕНОВАНИЕ         :   ОСТАТОК НА НАЧАЛО  :            ПОСТАВЩИК         :      НОМЕР     :     ПОСТУПИЛО      :    ТИП РАСХОДА     : КОЛ-ВО  :    СУММА   :----------------------" skip "          группы товаров        :----------------------:------------------------------:    документа   :--------------------:   (тип платежа)    :         : цены док-та: КОЛ-ВО  :    СУММА   " skip "                                : КОЛ-ВО  :   СУММА    :    Наименование    :   Код   :     прихода    : КОЛ-ВО :   СУММА   :                    :         :            :         : прод. цены " skip "                                :         : прод. цены :                    :         :      (ТТН)     :        : учет.цены :                    :         :            :         :            " skip "                                :         :            :                    :         :                :        :           :                    :         :            :         :            " skip "-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------"
     2066   with FRAME TopFrame width 232 PAGE-Top NO-LABELS NO-BOX .
     2067   VIEW STREAM PrnLibstream FRAME TOpFrame .
     2068   for each actreal-3:
     2069     delete actreal-3.
     2070   end.
     2071   FOR EACH t-3 where (pclassify <> "totals":U or t-3.grp-code-sheet = 0) use-index pi:
     2072     assign
     2073     areal-is-pay-qnty1 = 0
     2074     areal-is-pay-netto = 0
     2075     areal-no-pay-qnty1 = 0
     2076     areal-no-pay-netto = 0
     2077     areal-qnty1 = 0
     2078     areal-netto = 0
     2079     aincome-qnty1 = 0
     2080     aincome-netto = 0
     2081     loc-real-ii = 1
     2082     curr-real-ii = 1
     2083     loc-income-ii = 0
     2084     .
     2085     FIND LAST treal-3 No-LOCK WHERE
     2086               treal-3.grp-code-sheet = t-3.grp-code-sheet AND
     2087               treal-3.is-pay = yes use-index vi No-ERROR.
     2088     if avail treal-3 then
     2089     assign
     2090     loc-real-ii = treal-3.ii + 1
     2091     curr-real-ii = treal-3.ii + 1
     2092     .
     2093     IF can-find(first treal-3 WHERE
     2094                       treal-3.grp-code-sheet = t-3.grp-code-sheet) then do:
     2095       FOR EACh  treal-3 where
     2096                 treal-3.grp-code-sheet = t-3.grp-code-sheet use-index pi:
     2097         assign
     2098         areal-qnty1 = areal-qnty1 + treal-3.qnty1
     2099         areal-netto = areal-netto + treal-3.netto
     2100         .
     2101         if treal-3.is-pay then
     2102         assign
     2103         areal-is-pay-qnty1 = areal-is-pay-qnty1 + treal-3.qnty1
     2104         areal-is-pay-netto = areal-is-pay-netto + treal-3.netto
     2105         .
     2106         else
     2107         assign
     2108         rc = recid(treal-3)
     2109         curr-real-ii = (if curr-real-ii = loc-real-ii AND
     2110                            (loc-real-ii > 1   OR
     2111                             can-find(first treal-3 No-LOCK WHERE
     2112                                            treal-3.grp-code-sheet = t-3.grp-code-sheet AND
     2113                                            treal-3.is-pay = no AND
     2114                                            recid(treal-3) <> rc)
     2115                             )
     2116                         then (curr-real-ii + 1)
     2117                         else curr-real-ii
     2118                        )
     2119         treal-3.ii = curr-real-ii
     2120         curr-real-ii = curr-real-ii + 1
     2121         areal-no-pay-qnty1 = areal-no-pay-qnty1 + treal-3.qnty1
     2122         areal-no-pay-netto = areal-no-pay-netto + treal-3.netto
     2123         .
     2124       END.
     2125       if curr-real-ii > 2 then do:
     2126         run create-treal-3 (
     2127                             INPUT t-3.grp-code-sheet,
     2128                             INPUT 0,
     2129                             INPUT 0,
     2130                             INPUT areal-is-pay-qnty1,
     2131                             INPUT areal-is-pay-netto,
     2132                             INPUT "ИТОГО ОПЛАЧ.РАСХОД",
     2133                             INPUT yes,
     2134                             INPUT loc-real-ii) no-error.
     2135         if loc-real-ii = curr-real-ii then
     2136         curr-real-ii = curr-real-ii + 1.
     2137         run create-treal-3 (
     2138                             INPUT t-3.grp-code-sheet,
     2139                             INPUT 0,
     2140                             INPUT 0,
     2141                             INPUT areal-no-pay-qnty1,
     2142                             INPUT areal-no-pay-netto,
     2143                             INPUT "ИТОГО ПРОЧ.РАСХОДОВ",
     2144                             INPUT no,
     2145                             INPUT curr-real-ii) no-error.
     2146         curr-real-ii = curr-real-ii + 1.
     2147         run create-treal-3 (
     2148                             INPUT t-3.grp-code-sheet,
     2149                             INPUT 0,
     2150                             INPUT 0,
     2151                             INPUT areal-qnty1,
     2152                             INPUT areal-netto,
     2153                             INPUT "ВСЕГО  РАСХОД",
     2154                             INPUT ?,
     2155                             INPUT curr-real-ii) no-error.
     2156       END.
     2157       else curr-real-ii = 1.
     2158     END.
     2159     FOR EACh  tincome-3 where
     2160               tincome-3.grp-code-sheet = t-3.grp-code-sheet use-index vi:
     2161       assign
     2162       aincome-qnty1 = aincome-qnty1 + tincome-3.qnty1
     2163       aincome-netto = aincome-netto + tincome-3.netto
     2164       loc-income-ii = tincome-3.ii
     2165       .
     2166     END.
     2167     if loc-income-ii > 1 then do:
     2168       run create-tincome-3 (
     2169                           INPUT t-3.grp-code-sheet,
     2170                           INPUT "",
     2171                           INPUT aincome-qnty1,
     2172                           INPUT aincome-netto,
     2173                           INPUT "ИТОГО ПОСТУПЛЕНИЙ",
     2174                           INPUT 0,
     2175                           INPUT no,
     2176                           INPUT (loc-income-ii + 1)) no-error .
     2177       loc-income-ii = loc-income-ii + 1.
     2178     END.
     2179     assign
     2180     t-3.lines = MAX(curr-real-ii, loc-income-ii, 1)
     2181     .
     2182   END.
     2183   if Make-Excel then  put   stream ForExcel unformatted skip.
     2184   FOR EACH t-3 No-LOCK WHERE (pclassify <> "totals":U or t-3.grp-code-sheet = 0)
     2185       break by grp-name:
     2186     DO jj = 1 to t-3.lines :
     2187       assign
     2188       pol1 = ""
     2189       pol2 = 0
     2190       pol3 = 0
     2191       pol4 = ""
     2192       pol5 = 0
     2193       pol6 = ""
     2194       pol7 = 0
     2195       pol8 = 0
     2196       pol9 = ""
     2197       pol10 = 0
     2198       pol11 = 0
     2199       pol12 = 0
     2200       pol13 = 0
     2201       main-line = no
     2202       supp-line = no
     2203       pay-line = no
     2204       .
     2205       IF jj = 1 then do:
     2206         assign
     2207         pol1 = t-3.grp-name
     2208         pol2 = t-3.qnty1-before
     2209         pol3 = t-3.netto-before
     2210         pol12 = t-3.qnty1-after
     2211         pol13 = t-3.netto-after
     2212         main-line = yes
     2213         .
     2214       END.
     2215       FIND FIRST tincome-3 No-LOCK WHERE
     2216                  tincome-3.grp-code-sheet = t-3.grp-code-sheet AND
     2217                  tincome-3.ii = jj No-ERROR.
     2218       FIND FIRST treal-3 No-LOCK WHERE
     2219                  treal-3.grp-code-sheet = t-3.grp-code-sheet AND
     2220                  treal-3.ii = jj No-ERROR.
     2221       if p-batch > 0
     2222       and (available tincome-3
     2223       or available treal-3)
     2224       and p-report-id  = "53/2040"
     2225       then do:
     2226         find first buf_shift-grp where
     2227                   buf_shift-grp.obj-type = p-obj-type
     2228               and buf_shift-grp.obj-code = p-obj-code
     2229               and buf_shift-grp.shift-date = x-date-end
     2230               and buf_shift-grp.shift-num = x-shift-end
     2231               and buf_shift-grp.grp-code = t-3.grp-code-sheet no-error.
     2232         if not available buf_shift-grp then do:
     2233           create buf_shift-grp.
     2234           assign
     2235           buf_shift-grp.obj-type = p-obj-type
     2236           buf_shift-grp.obj-code = p-obj-code
     2237           buf_shift-grp.shift-date = x-date-end
     2238           buf_shift-grp.shift-num = x-shift-end
     2239           buf_shift-grp.grp-code = t-3.grp-code-sheet
     2240           buf_shift-grp.full-grp-name = t-3.grp-name
     2241           buf_shift-grp.start-qnty = t-3.qnty1-before
     2242           buf_shift-grp.end-qnty = t-3.qnty1-after
     2243           buf_shift-grp.start-sum = t-3.netto-before
     2244           buf_shift-grp.end-sum = t-3.netto-after
     2245           .
     2246           release buf_shift-grp.
     2247         end.
     2248       end.
     2249       IF AVAIl tincome-3 then do:
     2250   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input tincome-3.doc-code ,
     2251                           input 'nids':U ,
     2252                          output v-attr-value ,
     2253                          output v-attr-type )  .
     2254         assign
     2255           pol6 = if v-attr-value = "" or v-attr-value = ?
     2256                  then tincome-3.doc-code
     2257                  else v-attr-value
     2258           pol6-excel = if v-attr-value = "" or v-attr-value = ?
     2259                  then tincome-3.doc-code
     2260                  else '="' + v-attr-value + '"'
     2261         .
     2262         assign
     2263         pol4 = tincome-3.supp-name
     2264         pol5 = tincome-3.supp-code
     2265         pol7 = tincome-3.qnty1
     2266         pol8 = tincome-3.netto
     2267         supp-line = yes
     2268         .
     2269         if p-batch > 0
     2270         and tincome-3.supp-code > 0
     2271         and tincome-3.grp-code > 0
     2272         and p-report-id  = "53/2040"
     2273         then do:
     2274           find first buf_shift-grp-in where
     2275                     buf_shift-grp-in.obj-type = p-obj-type
     2276                 and buf_shift-grp-in.obj-code = p-obj-code
     2277                 and buf_shift-grp-in.shift-date = x-date-end
     2278                 and buf_shift-grp-in.shift-num = x-shift-end
     2279                 and buf_shift-grp-in.grp-code = tincome-3.grp-code-sheet
     2280                 and buf_shift-grp-in.doc-code = tincome-3.doc-code   no-error.
     2281           if not available buf_shift-grp-in then do:
     2282             create buf_shift-grp-in.
     2283             assign
     2284             buf_shift-grp-in.obj-type = p-obj-type
     2285             buf_shift-grp-in.obj-code = p-obj-code
     2286             buf_shift-grp-in.shift-date = x-date-end
     2287             buf_shift-grp-in.shift-num = x-shift-end
     2288             buf_shift-grp-in.grp-code = tincome-3.grp-code-sheet
     2289             buf_shift-grp-in.doc-code = tincome-3.doc-code
     2290             buf_shift-grp-in.cli-type-code = substitute("&1&2", tincome-3.supp-type, tincome-3.supp-code)
     2291             buf_shift-grp-in.cli-name = tincome-3.supp-name
     2292             buf_shift-grp-in.fact-qnty = tincome-3.qnty1
     2293             buf_shift-grp-in.fact-cost-sum = tincome-3.netto
     2294             .
     2295             release buf_shift-grp-in.
     2296           end.
     2297         end.
     2298       END.
     2299       IF AVAIl treal-3 then do:
     2300         if treal-3.cpay-code <> 0 then do:
     2301           FIND FIRST actreal-3 WHERE
     2302                     actreal-3.grp-code-sheet = 0 AND
     2303                     actreal-3.cpay-code = treal-3.cpay-code AND
     2304                     actreal-3.curr-code = treal-3.curr-code AND
     2305                     actreal-3.is-pay = treal-3.is-pay NO-ERROR.
     2306           if not avail actreal-3 then do:
     2307             acii = acii + 1.
     2308             run create-actreal-3 (
     2309                                 INPUT 0,
     2310                                 INPUT treal-3.cpay-code,
     2311                                 INPUT treal-3.curr-code,
     2312                                 INPUT treal-3.qnty1,
     2313                                 INPUT treal-3.netto,
     2314                                 INPUT treal-3.out-name,
     2315                                 INPUT treal-3.is-pay,
     2316                                 INPUT acii) no-error.
     2317           end.
     2318           else
     2319           assign
     2320           actreal-3.qnty1 = actreal-3.qnty1 + treal-3.qnty1
     2321           actreal-3.netto = actreal-3.netto + treal-3.netto
     2322           .
     2323         end.
     2324         assign
     2325         pol9 = treal-3.out-name
     2326         pol10 = treal-3.qnty1
     2327         pol11 = treal-3.netto
     2328         pay-line = yes
     2329         .
     2330         if p-batch > 0
     2331         and (treal-3.curr-code > 0
     2332         or not (treal-3.curr-code = 0 and treal-3.cpay-code = 0))
     2333         and treal-3.grp-code > 0
     2334         and p-report-id  = "53/2040"
     2335         then do:
     2336           find first buf_shift-grp-out where
     2337                     buf_shift-grp-out.obj-type = p-obj-type
     2338                 and buf_shift-grp-out.obj-code = p-obj-code
     2339                 and buf_shift-grp-out.shift-date = x-date-end
     2340                 and buf_shift-grp-out.shift-num = x-shift-end
     2341                 and buf_shift-grp-out.grp-code = treal-3.grp-code-sheet
     2342                 and buf_shift-grp-out.pay-code = treal-3.cpay-code
     2343                 and buf_shift-grp-out.curr-code = treal-3.curr-code
     2344                 no-error.
     2345           if not available buf_shift-grp-out then do:
     2346               find first buf_cash-pay no-lock where
     2347                         buf_cash-pay.cdpay-code = treal-3.cpay-code
     2348                    and  buf_cash-pay.curr-code = treal-3.curr-code no-error.
     2349             create buf_shift-grp-out.
     2350             assign
     2351             buf_shift-grp-out.obj-type = p-obj-type
     2352             buf_shift-grp-out.obj-code = p-obj-code
     2353             buf_shift-grp-out.shift-date = x-date-end
     2354             buf_shift-grp-out.shift-num = x-shift-end
     2355             buf_shift-grp-out.grp-code = treal-3.grp-code-sheet
     2356             buf_shift-grp-out.pay-code = treal-3.cpay-code
     2357             buf_shift-grp-out.curr-code = treal-3.curr-code
     2358             buf_shift-grp-out.out-name = treal-3.out-name
     2359             buf_shift-grp-out.fact-qnty = treal-3.qnty1
     2360             buf_shift-grp-out.fact-sum = treal-3.netto
     2361             buf_shift-grp-out.cp-type = (if available buf_cash-pay
     2362                                           and buf_cash-pay.is-cash
     2363                                           then 1
     2364                                           else 2)
     2365             .
     2366             release buf_shift-grp-out.
     2367           end.
     2368         end.
     2369       END.
     2370       DISPLAY stream PrnLibstream
     2371       pol1
     2372       pol2 when main-line
     2373       pol3 when main-line
     2374       pol4
     2375       pol5 when pol5 <> 0
     2376       pol6
     2377       pol7 when supp-line
     2378       pol8 when supp-line
     2379       pol9
     2380       pol10 when pay-line
     2381       pol11 when pay-line
     2382       pol12 when main-line
     2383       pol13 when main-line
     2384       sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     2385       with frame frame-3 .
     2386       if jj < t-3.lines then
     2387       DOWN stream PrnLibstream
     2388       with frame frame-3 .
     2389       if main-line then do:
     2390         assign
     2391         accum-2 = accum-2 + pol2
     2392         accum-3 = accum-3 + pol3
     2393         accum-12 = accum-12 + pol12
     2394         accum-13 = accum-13 + pol13
     2395         .
     2396         if Make-Excel then  put   stream ForExcel unformatted
     2397         pol1 CHR(9)
     2398         pol2 CHR(9)
     2399         pol3 CHR(9)
     2400         .
     2401       end.
     2402       else do:
     2403         if Make-Excel then  put   stream ForExcel unformatted
     2404         CHR(9)
     2405         CHR(9)
     2406         CHR(9)
     2407         .
     2408       end.
     2409       if supp-line then do:
     2410         if tincome-3.is-fact = yes then
     2411         assign
     2412         accum-7 = accum-7 + pol7
     2413         accum-8 = accum-8 + pol8
     2414         .
     2415         if Make-Excel then  put   stream ForExcel unformatted
     2416         pol4 CHR(9)
     2417         (if pol5 <> 0 then string(pol5) else "") CHR(9)
     2418         pol6-excel CHR(9)
     2419         pol7 CHR(9)
     2420         pol8 CHR(9)
     2421         .
     2422       end.
     2423       else do:
     2424         if Make-Excel then  put   stream ForExcel unformatted
     2425         CHR(9)
     2426         CHR(9)
     2427         CHR(9)
     2428         CHR(9)
     2429         CHR(9)
     2430         .
     2431       end.
     2432       if pay-line then do:
     2433         if treal-3.cpay-code <> 0 then
     2434         assign
     2435         accum-10 = accum-10 + pol10
     2436         accum-11 = accum-11 + pol11
     2437         .
     2438         if Make-Excel then  put   stream ForExcel unformatted
     2439         pol9 CHR(9)
     2440         pol10 CHR(9)
     2441         pol11 CHR(9)
     2442         .
     2443       end.
     2444       else do:
     2445         if Make-Excel then  put   stream ForExcel unformatted
     2446         CHR(9)
     2447         CHR(9)
     2448         CHR(9)
     2449         .
     2450       end.
     2451       if main-line then do:
     2452         if Make-Excel then  put   stream ForExcel unformatted
     2453         pol12 CHR(9)
     2454         pol13
     2455         skip.
     2456       end.
     2457       else do:
     2458         if Make-Excel then  put   stream ForExcel unformatted
     2459         CHR(9)
     2460         skip.
     2461       end.
     2462    END.
     2463     DOWN 1 stream PrnLibstream
     2464     with frame frame-3 .
     2465     if Make-Excel then  put   stream ForExcel unformatted
     2466     fill(CHR(9), 12)
     2467     skip.
     2468     if pclassify <> "totals":U and last(t-3.grp-name) then do:
     2469       assign
     2470       pol1 = "ИТОГО ПО ВСЕМ ГРУППАМ"
     2471       pol2 = accum-2
     2472       pol3 = accum-3
     2473       pol7 = accum-7
     2474       pol8 = accum-8
     2475       pol9 = "ИТОГО РАСХОД"
     2476       pol10 = accum-10
     2477       pol11 = accum-11
     2478       pol12 = accum-12
     2479       pol13 = accum-13
     2480       .
     2481       run on-same-page in this-procedure (1 + 2 + acii +
     2482                                           (if acii = 0 then 0 else 1) +
     2483                                           (if can-find(first actreal-3 where
     2484                                                              actreal-3.is-pay = yes) then 1 else 0
     2485                                           ) +
     2486                                           (if can-find(first actreal-3 where
     2487                                                               actreal-3.is-pay = no) then 1 else 0
     2488                                           )
     2489                                          ) .
     2490       UNDERLINE stream PrnLibstream
     2491       sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 pol1 pol2 pol3 pol4 pol5 pol6 pol7 pol8 pol9 pol10 pol11 pol12 pol13
     2492       with frame frame-3.
     2493       DISPLAY stream PrnLibstream
     2494       pol1
     2495       pol2
     2496       pol3
     2497       pol7
     2498       pol8
     2499       pol9
     2500       pol10
     2501       pol11
     2502       pol12
     2503       pol13
     2504       sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     2505       with frame frame-3.
     2506       if Make-Excel then  put   stream ForExcel unformatted
     2507       pol1 CHR(9)
     2508       pol2 CHR(9)
     2509       pol3 CHR(9)
     2510       CHR(9)
     2511       CHR(9)
     2512       CHR(9)
     2513       pol7 CHR(9)
     2514       pol8 CHR(9)
     2515       pol9 CHR(9)
     2516       pol10 CHR(9)
     2517       pol11 CHR(9)
     2518       pol12 CHR(9)
     2519       pol13 CHR(9)
     2520       skip.
     2521       DOWN 1 stream PrnLibstream
     2522       with frame frame-3 .
     2523       if can-find(first actreal-3 No-LOCK) then do:
     2524         pol9 = "     в том числе:".
     2525         DISPLAY stream PrnLibstream
     2526         pol9
     2527         sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     2528         with frame frame-3.
     2529         if Make-Excel then  put   stream ForExcel unformatted
     2530         CHR(9)
     2531         CHR(9)
     2532         CHR(9)
     2533         CHR(9)
     2534         CHR(9)
     2535         CHR(9)
     2536         CHR(9)
     2537         CHR(9)
     2538         pol9 CHR(9)
     2539         CHR(9)
     2540         CHR(9)
     2541         CHR(9)
     2542         CHR(9)
     2543         skip.
     2544         DOWN 1 stream PrnLibstream
     2545         with frame frame-3 .
     2546         assign
     2547         areal-is-pay-qnty1 = 0
     2548         areal-is-pay-netto = 0
     2549         areal-no-pay-qnty1 = 0
     2550         areal-no-pay-netto = 0
     2551         .
     2552         FOR EACH actreal-3 No-LOCK
     2553         BREAK
     2554         BY actreal-3.grp-code-sheet
     2555         By actreal-3.is-pay descending
     2556         BY actreal-3.cpay-code descending
     2557         BY actreal-3.curr-code:
     2558           if actreal-3.is-pay = yes then
     2559           assign
     2560           areal-is-pay-qnty1 = areal-is-pay-qnty1 + actreal-3.qnty1
     2561           areal-is-pay-netto = areal-is-pay-netto + actreal-3.netto
     2562           .
     2563           else
     2564           assign
     2565           areal-no-pay-qnty1 = areal-no-pay-qnty1 + actreal-3.qnty1
     2566           areal-no-pay-netto = areal-no-pay-netto + actreal-3.netto
     2567           .
     2568           assign
     2569           pol9 = actreal-3.out-name
     2570           pol10 = actreal-3.qnty1
     2571           pol11 = actreal-3.netto
     2572           .
     2573           DISPLAY stream PrnLibstream
     2574           pol9
     2575           pol10
     2576           pol11
     2577           sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     2578           with frame frame-3.
     2579           if Make-Excel then  put   stream ForExcel unformatted
     2580           CHR(9)
     2581           CHR(9)
     2582           CHR(9)
     2583           CHR(9)
     2584           CHR(9)
     2585           CHR(9)
     2586           CHR(9)
     2587           CHR(9)
     2588           pol9 CHR(9)
     2589           pol10 CHR(9)
     2590           pol11 CHR(9)
     2591           CHR(9)
     2592           CHR(9)
     2593           skip.
     2594           DOWN 1 stream PrnLibstream
     2595           with frame frame-3 .
     2596           if Make-Excel then  put   stream ForExcel unformatted
     2597           fill(CHR(9), 12)
     2598           skip.
     2599          if last-of(actreal-3.is-pay)  then do:
     2600             if actreal-3.is-pay = yes then
     2601             assign
     2602             pol9 = "ИТОГО ОПЛАЧ.РАСХОД"
     2603             pol10 = areal-is-pay-qnty1
     2604             pol11 = areal-is-pay-netto
     2605             .
     2606             else
     2607             assign
     2608             pol9 = "ИТОГО ПРОЧ.РАСХОД"
     2609             pol10 = areal-no-pay-qnty1
     2610             pol11 = areal-no-pay-netto
     2611             .
     2612             DISPLAY stream PrnLibstream
     2613             pol9
     2614             pol10
     2615             pol11
     2616             sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     2617             with frame frame-3.
     2618             if Make-Excel then  put   stream ForExcel unformatted
     2619             CHR(9)
     2620             CHR(9)
     2621             CHR(9)
     2622             CHR(9)
     2623             CHR(9)
     2624             CHR(9)
     2625             CHR(9)
     2626             CHR(9)
     2627             pol9 CHR(9)
     2628             pol10 CHR(9)
     2629             pol11 CHR(9)
     2630             CHR(9)
     2631             CHR(9)
     2632             skip.
     2633             DOWN 1 stream PrnLibstream
     2634             with frame frame-3 .
     2635             if Make-Excel then  put   stream ForExcel unformatted
     2636             fill(CHR(9), 12)
     2637             skip.
     2638           end.
     2639         END.
     2640       end.
     2641     end.
     2642   END.
     2643   PROCEDURE create-tincome-3.
     2644   DEFINE INPUT PARAMETER pgrp-code-sheet like ub.gds-grp.node-code no-undo.
     2645   DEFINE INPUT PARAMETER pdoc-code like ub.trn-doc.doc-code no-undo.
     2646   DEFINE INPUT PARAMETER pqnty1 as decimal no-undo.
     2647   DEFINE INPUT PARAMETER pnetto as decimal no-undo.
     2648   DEFINE INPUT PARAMETER psupp-name as character no-undo.
     2649   DEFINE INPUT PARAMETER psupp-code like ub.clients.obj-code no-undo.
     2650   DEFINE INPUT PARAMETER pis-fact as logical no-undo.
     2651   DEFINE INPUT PARAMETER pii as integer no-undo.
     2652   _main:
     2653   DO ON ERROR UNDO _main, return error:
     2654       create tincome-3.
     2655       assign
     2656       tincome-3.grp-code-sheet = pgrp-code-sheet
     2657       tincome-3.doc-code = pdoc-code
     2658       tincome-3.qnty1  =  pqnty1
     2659       tincome-3.netto  = pnetto
     2660       tincome-3.supp-code = psupp-code
     2661       tincome-3.supp-name = psupp-name
     2662       tincome-3.is-fact = pis-fact
     2663       tincome-3.ii = pii
     2664       no-error
     2665       .
     2666       if error-status:error then undo _main, return error.
     2667   END.
     2668   END PROCEDURE.
