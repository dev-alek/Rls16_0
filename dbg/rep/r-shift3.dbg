      658   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      659   PROCEDURE create-treal-3.
      660   DEFINE INPUT PARAMETER pgrp-code-sheet like ub.gds-grp.node-code no-undo.
      661   DEFINE INPUT PARAMETER pcpay-code like ub.cash-pay.cdpay-code no-undo.
      662   DEFINE INPUT PARAMETER pcurr-code like ub.cash-pay.curr-code no-undo.
      663   DEFINE INPUT PARAMETER pqnty1 as decimal no-undo.
      664   DEFINE INPUT PARAMETER pnetto as decimal no-undo.
      665   DEFINE INPUT PARAMETER pout-name as character no-undo.
      666   DEFINE INPUT PARAMETER pis-pay as logical no-undo.
      667   DEFINE INPUT PARAMETER pii as integer no-undo.
      668   _main:
      669   DO ON ERROR UNDO _main, return error:
      670       create treal-3.
      671       assign
      672       treal-3.grp-code-sheet = pgrp-code-sheet
      673       treal-3.cpay-code = pcpay-code
      674       treal-3.curr-code = pcurr-code
      675       treal-3.qnty1  =  pqnty1
      676       treal-3.netto = pnetto
      677       treal-3.out-name = pout-name
      678       treal-3.is-pay = pis-pay
      679       treal-3.ii = pii
      680       treal-3.discnt-type = -99
      681       no-error
      682       .
      683       if error-status:error then undo _main, return error.
      684   END.
      685   END PROCEDURE.
      686   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      687   PROCEDURE create-actreal-3.
      688   DEFINE INPUT PARAMETER pgrp-code-sheet like ub.gds-grp.node-code no-undo.
      689   DEFINE INPUT PARAMETER pcpay-code like ub.cash-pay.cdpay-code no-undo.
      690   DEFINE INPUT PARAMETER pcurr-code like ub.cash-pay.curr-code no-undo.
      691   DEFINE INPUT PARAMETER pqnty1 as decimal no-undo.
      692   DEFINE INPUT PARAMETER pnetto as decimal no-undo.
      693   DEFINE INPUT PARAMETER pout-name as character no-undo.
      694   DEFINE INPUT PARAMETER pis-pay as logical no-undo.
      695   DEFINE INPUT PARAMETER pii as integer no-undo.
      696   _main:
      697   DO ON ERROR UNDO _main, return error:
      698       create actreal-3.
      699       assign
      700       actreal-3.grp-code-sheet = pgrp-code-sheet
      701       actreal-3.cpay-code = pcpay-code
      702       actreal-3.curr-code = pcurr-code
      703       actreal-3.qnty1  =  pqnty1
      704       actreal-3.netto = pnetto
      705       actreal-3.out-name = pout-name
      706       actreal-3.is-pay = pis-pay
      707       actreal-3.ii = pii
      708       actreal-3.discnt-type = -99
      709       no-error
      710       .
      711       if error-status:error then undo _main, return error.
      712   END.
      713   END PROCEDURE.
