     2028     pol4 column-label   "3.4":C20                    FORMAT "x(20)"         space(0)
     2029     sym4 column-label ":" format "x(1)" space(0)
     2030     pol5 column-label   "3.5":C9                     FORMAT ">>>>>>>>9"     space(0)
