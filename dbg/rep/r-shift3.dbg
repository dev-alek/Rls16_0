     2051                   (input p-obj-type,
     2052                    input p-obj-code,
     2053                    input X-date-Start,
     2054                    input X-Shift-Start,
     2055                    input X-date-End,
     2056                    input X-Shift-End,
     2057                    input pClassify,
     2058                    input pSorttype,
