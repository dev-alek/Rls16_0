      103   def
      104    shared
      105   temp-table  obj-list no-undo
      106     field obj-type like ub.clients.obj-type
      107     field obj-code like ub.clients.obj-code
      108     field obj-name like ub.clients.obj-name
      109     field obj-id   as integer
