      113     index ie2 obj-name
      114   .
      115   procedure create_obj-list :
      116      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      117      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      118      do
      119      on error undo, return error return-value
      120      :
      121         define buffer cli-obj for ub.clients .
      122         define variable p-var as integer no-undo .
      123         define buffer buf_obj-list for obj-list .
      124         find last buf_obj-list  use-index pi no-error .
      125         if available buf_obj-list
      126         then
      127            p-var = buf_obj-list.obj-id + 1.
      128         else
      129            p-var = 1.
      130         find first cli-obj where
      131                   cli-obj.obj-type = p-obj-type
      132               and cli-obj.obj-code = p-obj-code
      133         no-lock no-error.
      134         if available cli-obj
      135         then do:
      136            create buf_obj-list.
      137            assign
      138               buf_obj-list.obj-id   = p-var
      139               buf_obj-list.obj-code = cli-obj.obj-code
      140               buf_obj-list.obj-type = cli-obj.obj-type
      141               buf_obj-list.obj-name = cli-obj.obj-name
      142               buf_obj-list.db-num   = cli-obj.db-num
      143            .
      144         end.
      145      end.
      146   end.
