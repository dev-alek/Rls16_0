      824   define variable vss-include-info8 as character format "X(65)" no-undo
      825   initial "@(#)$Workfile$ $Revision$".
      826   procedure grplib-get-full-name :
      827      define input parameter p-node-code  as integer      no-undo.
      828      define output parameter p-full-name as character    no-undo.
      829      do
      830   on error undo, return error
      831   :
      832       define variable v-upper-code    as integer           no-undo.
      833       define buffer buf_gds-grp       for ub.gds-grp.
      834       define buffer buf_upper_gds-grp for ub.gds-grp.
      835       find first buf_gds-grp no-lock
      836            where buf_gds-grp.node-code = p-node-code
      837       no-error.
      838       if not available buf_gds-grp
      839       then do:
      840           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      841       end.
      842       assign
      843           p-full-name  = ""
      844           v-upper-code = 1
      845       .
      846       do while buf_gds-grp.upper-code <> 0
      847       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      848       :
      849           assign
      850               p-full-name  = buf_gds-grp.node-name
      851                            + (if p-full-name <> "" then chr(47) else "")
      852                            + p-full-name
      853               v-upper-code = buf_gds-grp.upper-code
      854           .
      855           find first buf_gds-grp no-lock
      856                where buf_gds-grp.node-code = v-upper-code
      857           no-error.
      858           if not available buf_gds-grp
      859           then do:
      860               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      861                                   + string( v-upper-code )
      862                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      863           end.
      864       end.
      865       assign
      866       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      867       .
      868   end.
      869   end .
      870   procedure grplib-get-node-from-full-name :
      871   define input parameter p-full-name as character no-undo .
      872   define output parameter p-node-code as integer no-undo .
      873   define variable v-ii as integer no-undo .
      874   define variable v-upper-code as integer no-undo .
      875   define variable v-root-code as integer no-undo .
      876   define variable v-entry as character no-undo .
      877   define buffer buf_gds-grp       for ub.gds-grp.
      878   do
      879   on error undo, return error
      880   :
      881     find first buf_gds-grp no-lock
      882         where buf_gds-grp.upper-code = 0
      883     no-error .
      884     if not available buf_gds-grp
      885     then do:
      886         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      887     end.
      888     else do:
      889       assign
      890       v-root-code = buf_gds-grp.node-code
      891       .
      892     end.
      893     v-upper-code = v-root-code.
      894     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      895       assign
      896       v-entry = entry(v-ii, p-full-name, chr(47)).
      897       if v-entry = '' then leave.
      898       find first buf_gds-grp no-lock where
      899                 buf_gds-grp.node-name = v-entry
      900             and buf_gds-grp.upper-code = v-upper-code
      901             no-error.
      902       if not available buf_gds-grp then do:
      903         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      904       end.
      905       else do:
      906         p-node-code = buf_gds-grp.node-code.
      907         v-upper-code = buf_gds-grp.node-code.
      908       end.
      909     end.
      910   end.
      911   end .
