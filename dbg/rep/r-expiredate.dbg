      393   procedure create_obj-list :
      394      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      395      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      396      do
      397      on error undo, return error return-value
      398      :
      399         define buffer cli-obj for ub.clients .
      400         define variable p-var as integer no-undo .
      401         define buffer buf_obj-list for obj-list .
      402         find last buf_obj-list  use-index pi no-error .
      403         if available buf_obj-list
      404         then
      405            p-var = buf_obj-list.obj-id + 1.
      406         else
      407            p-var = 1.
      408         find first cli-obj where
      409                   cli-obj.obj-type = p-obj-type
      410               and cli-obj.obj-code = p-obj-code
      411         no-lock no-error.
      412         if available cli-obj
      413         then do:
      414            create buf_obj-list.
      415            assign
      416               buf_obj-list.obj-id   = p-var
      417               buf_obj-list.obj-code = cli-obj.obj-code
      418               buf_obj-list.obj-type = cli-obj.obj-type
      419               buf_obj-list.obj-name = cli-obj.obj-name
      420               buf_obj-list.db-num   = cli-obj.db-num
      421            .
      422         end.
      423      end.
      424   end.
