      940   function fnc-convert-dot-to-colon returns character
      941       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
      942   function fnc-convert-dot-to-colon returns character
      943   (input p-data as decimal, input p-accur as character, input p-num as integer):
      944       define variable result as character no-undo.
      945       define variable v-str-result as character no-undo.
      946       if p-data = ? then p-data = 0 .
      947       p-data = round(p-data, p-num).
      948       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
      949       return v-str-result.
      950   END FUNCTION.
      951   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      952   define  stream PrnLibStream.
      953   procedure prn-lib-prn-file :
      954     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      955     define input parameter p-DIsabledoptions as integer no-undo .
      956     define variable v-report-name as character no-undo .
      957     define variable v-user-action as character no-undo .
      958     define variable v-printed     as logical   no-undo .
      959     define variable v-exist       as logical   no-undo .
      960     do
      961       on error undo, return error
      962       :
      963       run prn-lib-get-report-name  in this-procedure (
      964         input parParentProc
      965         ,output v-report-name
      966         ).
      967   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      968   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      969     (input  v-report-name
      970     ,input  2
      971     ,output v-exist
      972     )  .
      973       if NOT v-exist then
      974       DO:
      975         Message
      976           "Нет заданий на печать ! "
      977           view-as alert-box .
      978         Return  .
      979       End.
      980       run gbl/prnfilen.w
      981         (input  ""
      982         ,input  p-DisabledOptions
      983         ,input  string(v-report-name )
      984         ,input  7
      985         ,output v-user-action
      986         ,output v-printed
      987         ) .
      988       if v-printed then
      989       do:
      990         return "YES" .
      991       end.
      992       else
      993       do:
      994         return "NO" .
      995       end.
      996     end.
      997   end procedure.
      998   procedure prn-lib-open-stream :
      999     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1000     define input parameter p-page-size    as integer no-undo .
     1001     define input parameter p-is-stream    as logical no-undo .
     1002     define input parameter p-append       as logical no-undo .
     1003     define variable v-report-name as character no-undo .
     1004     do
     1005       on error undo, return error
     1006       :
     1007       run prn-lib-get-report-name  in this-procedure (
     1008         input parParentProc
     1009         ,output v-report-name
     1010         ).
     1011       if p-is-stream then
     1012       do:
     1013         if p-append then
     1014         do:
     1015           output stream PrnLibStream to value( v-report-name )
     1016             page-size value(p-page-size) append .
     1017         end.
     1018         if not p-append then
     1019         do:
     1020           output stream PrnLibStream to value( v-report-name )
     1021             page-size value(p-page-size) .
     1022         end.
     1023       end.
     1024       if not p-is-stream then
     1025       do:
     1026         if p-append then
     1027         do:
     1028           output to value( v-report-name )
     1029             page-size value(p-page-size) append .
     1030         end.
     1031         if not p-append then
     1032         do:
     1033           output to value( v-report-name )
     1034             page-size value(p-page-size) .
     1035         end.
     1036       end.
     1037     end.
     1038   end procedure.
     1039   procedure prn-lib-open-exp :
     1040     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1041     define input parameter p-is-stream    as logical no-undo .
     1042     define input parameter p-is-append    as logical no-undo .
     1043     define output parameter p-ReportFileName as char init "report" no-undo.
     1044     define output parameter p-process as logical no-undo .
     1045     define variable glog as logical no-undo .
     1046     do
     1047       on error undo, return error
     1048       :
     1049       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1050         TITLE      "Укажите путь"
     1051         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1052         ASK-OVERWRITE
     1053         CREATE-TEST-FILE
     1054         SAVE-AS
     1055         USE-FILENAME
     1056         DEFAULT-EXTENSION "txt"
     1057         UPDATE glog
     1058         .
     1059       if not glog then  return.
     1060       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1061       if p-is-stream then
     1062       do:
     1063         if p-is-append then
     1064         do:
     1065           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1066         end.
     1067         else
     1068         do:
     1069           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1070         end.
     1071       end.
     1072       else
     1073       do:
     1074         if p-is-append then
     1075         do:
     1076           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1077         end.
     1078         else
     1079         do:
     1080           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1081         end.
     1082       end.
     1083       p-process = yes.
     1084     end.
     1085   end procedure.
     1086   procedure prn-lib-get-report-name :
     1087     define input parameter parParentProc  as widget-handle no-undo.
     1088     define output parameter p-report-name as character no-undo .
     1089     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1090   end procedure.
     1091   procedure prn-lib-reportviewer-report-name :
     1092     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1093     define input parameter p-report-name-html as character no-undo .
     1094     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1095   end procedure.
     1096   procedure prn-lib-reportviewer :
     1097     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1098     define input parameter p-report-name-html as character no-undo .
     1099     define input parameter p-param        as character no-undo .
     1100     define variable v-excel           as character no-undo init 'TRUE' .
     1101     define variable v-value-character as character no-undo .
     1102     define variable v-value-integer   as character no-undo .
     1103     define variable v-value-date      as date      no-undo .
     1104     define variable v-value-decimal   as decimal   no-undo .
     1105     define variable rep-excel         as logical   no-undo .
     1106     define variable excel-string      as character no-undo .
     1107     define variable v-param-type      as character no-undo .
     1108     define variable v-tth             as handle    no-undo .
     1109     run adm/shattri.p (
     1110       input "get":U
     1111       ,input  ""
     1112       ,input  0
     1113       ,input  'report-glob':U
     1114       ,input  'rep-excel':U
     1115       ,output v-value-character
     1116       ,output v-value-date
     1117       ,output v-value-decimal
     1118       ,output v-value-integer
     1119       ,output rep-excel
     1120       ,output v-param-type
     1121       ,INPUT-OUTPUT table-handle v-tth
     1122       )  .
     1123     if rep-excel then v-excel = "TRUE" .
     1124     else v-excel = "FALSE" .
     1125     if p-param eq ""
     1126     then
     1127        p-param = "EXCEL:" + v-excel.
     1128     else
     1129        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1130     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1131   end procedure.
     1132   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1133     define variable v-cntxt-db-num        as integer   no-undo .
     1134     define variable v-cntxt-userid        as character no-undo .
     1135     define variable v-cntxt-level         as character no-undo .
     1136     define variable v-cntxt-host-code-obj as integer   no-undo .
     1137     define variable v-cntxt-obj-type      as character no-undo .
     1138     define variable v-cntxt-obj-code      as integer   no-undo .
     1139     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1140     define variable v-cntxt-is-admin      as logical   no-undo .
     1141   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1142     run mainmenu_getcntxt in parparentproc
     1143       (output v-cntxt-db-num
     1144       ,output v-cntxt-userid
     1145       ,output v-cntxt-level
     1146       ,output v-cntxt-host-code-obj
     1147       ,output v-cntxt-obj-type
     1148       ,output v-cntxt-obj-code
     1149       ,output v-cntxt-db-num-obj
     1150       ,output v-cntxt-is-admin
     1151       ) .
     1152   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     1153   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     1154   define variable ii                  as integer   no-undo .
     1155   define variable kk                  as integer   no-undo .
     1156   define variable v-full-path-RepView as character no-undo.
     1157   define variable v-file-name-rep-htm as character no-undo.
     1158   define variable v-report-name       as character no-undo.
     1159   define variable v-period            as character no-undo.
     1160   define variable Counter1            as integer   init 0 no-undo .
     1161   define variable v-gds-counter       as integer   no-undo .
     1162   define variable vExpireDateOther    as character no-undo init "-".
     1163   define variable vExpDate            as character no-undo .
     1164   define variable vExpireDate         as character no-undo .
     1165   define stream OutStr-html.
     1166   define variable g#report-num        as integer   no-undo.
     1167   define temp-table tt-exp no-undo
     1168       field mark            as character
     1169       field gds-code        as integer
     1170       field gds-name        as character
     1171       field expireDate      as date
     1172       field expireDateOther as character init "-"
     1173       field fact-qnty       as integer
     1174       field qntyDay         as integer
     1175       index pi gds-code expireDate.
     1176   define temp-table tt-date no-undo
     1177   field date as date .
     1178   define buffer buf_goods        for ub.goods .
     1179   define buffer buf_goods-attr   for ub.goods-attr .
     1180   define buffer buf_marking-attr for ub.marking-attr .
     1181   define buffer buf_marking      for ub.marking .
     1182   define buffer buf_gds-obj      for ub.gds-obj .
     1183   define buffer bf_clients       for ub.clients .
     1184   define buffer bf_marking-attr for ub.marking-attr .
     1185   define buffer buf_exp for tt-exp .
     1186   define temp-table tt-goods no-undo like ub.goods
     1187   field expDate as date
     1188   field expDateOther as character.
     1189   define buffer buf_cli-gds for ub.cli-gds.
     1190   define variable v-curr-grp-name as character no-undo .
     1191   define variable v-host-code     like ub.clients.host-code no-undo .
     1192   do
     1193       on error undo, return error return-value
     1194       :
     1195       run waitfram-show in this-procedure ( "Формирование списка товаров..." ) .
     1196       empty temp-table tt-goods.
     1197       case p-SelectGood :
     1198           when 1 then
     1199               do:
     1200                   for each buf_goods no-lock
     1201                       where buf_goods.stts = 0,
     1202                       first buf_goods-attr no-lock
     1203                       where buf_goods-attr.gds-code = buf_goods.gds-code
     1204                       and buf_goods-attr.attr-code = 'mark-type':U
     1205                       :
     1206                       create tt-goods.
     1207                       buffer-copy buf_goods to tt-goods.
     1208                       assign
     1209                           v-gds-counter = v-gds-counter + 1
     1210                           .
     1211                   end.
     1212               end.
     1213           when 2 then
     1214               do:
     1215                   for each tmp#grp no-lock
     1216                       :
     1217                       run grplib-get-full-name in this-procedure( input tmp#grp.node-code, output v-curr-grp-name ) .
     1218                       for each buf_goods no-lock
     1219                           where buf_goods.grp-name begins v-curr-grp-name,
     1220                           first buf_goods-attr no-lock
     1221                           where buf_goods-attr.gds-code = buf_goods.gds-code
     1222                           and buf_goods-attr.attr-code = 'mark-type':U
     1223                           :
     1224                           find first tt-goods no-lock
     1225                               where tt-goods.artic     = buf_goods.artic
     1226                               and tt-goods.prod-type = buf_goods.prod-type
     1227                               and tt-goods.prod-code = buf_goods.prod-code
     1228                               no-error .
     1229                           if not available tt-goods then
     1230                           do:
     1231                               create tt-goods.
     1232                               buffer-copy buf_goods to tt-goods.
     1233                               assign
     1234                                   v-gds-counter = v-gds-counter + 1
     1235                                   .
     1236                           end.
     1237                       end.
     1238                   end.
     1239               end.
     1240           when 3 then
     1241               do:
     1242                   for each buf_goods no-lock
     1243                       where buf_goods.stts = 0 ,
     1244                       each buf_cli-gds no-lock
     1245                       where buf_cli-gds.prod-type = buf_goods.prod-type
     1246                       and buf_cli-gds.prod-code = buf_goods.prod-code
     1247                       and buf_cli-gds.artic     = buf_goods.artic ,
     1248                       first g#cli
     1249                       where g#cli.obj-type = buf_cli-gds.prod-type
     1250                       and g#cli.obj-code = buf_cli-gds.prod-code,
     1251                       first buf_goods-attr no-lock
     1252                       where buf_goods-attr.gds-code = buf_goods.gds-code
     1253                       and buf_goods-attr.attr-code = 'mark-type':U
     1254                       :
     1255                       find first tt-goods no-lock
     1256                           where tt-goods.prod-type = buf_goods.prod-type
     1257                           and tt-goods.prod-code = buf_goods.prod-code
     1258                           and tt-goods.artic     = buf_goods.artic
     1259                           no-error.
     1260                       if not available tt-goods then
     1261                       do:
     1262                           create tt-goods.
     1263                           buffer-copy buf_goods to tt-goods no-error.
     1264                           assign
     1265                               v-gds-counter = v-gds-counter + 1
     1266                               .
     1267                       end.
     1268                   end.
     1269               end.
     1270           when 4 or
     1271           when 5 then
     1272               do:
     1273                   for each gds-list :
     1274                       for first buf_goods no-lock
     1275                           where buf_goods.gds-code = gds-list.gds-code,
     1276                           first buf_goods-attr no-lock
     1277                           where buf_goods-attr.gds-code = buf_goods.gds-code
     1278                           and buf_goods-attr.attr-code = 'mark-type':U:
     1279                           create tt-goods.
     1280                           buffer-copy buf_goods to tt-goods.
     1281                           assign
     1282                               v-gds-counter = v-gds-counter + 1
     1283                               .
     1284                       end.
     1285                   end.
     1286               end.
     1287           when 7 then
     1288               do:
     1289                   for each tmp#grp no-lock
     1290                       :
     1291                       run grplib-get-full-name in this-procedure( input tmp#grp.node-code, output v-curr-grp-name ) .
     1292                       for each buf_goods no-lock
     1293                           where buf_goods.grp-name begins v-curr-grp-name,
     1294                           first buf_goods-attr no-lock
     1295                           where buf_goods-attr.gds-code = buf_goods.gds-code
     1296                           and buf_goods-attr.attr-code = 'mark-type':U
     1297                           :
     1298                           find first tt-goods no-lock
     1299                               where tt-goods.artic     = buf_goods.artic
     1300                               and tt-goods.prod-type = buf_goods.prod-type
     1301                               and tt-goods.prod-code = buf_goods.prod-code
     1302                               no-error .
     1303                           if not available tt-goods then
     1304                           do:
     1305                               create tt-goods.
     1306                               buffer-copy buf_goods to tt-goods no-error.
     1307                               assign
     1308                                   v-gds-counter = v-gds-counter + 1
     1309                                   .
     1310                           end.
     1311                       end.
     1312                   end.
     1313                   for each buf_goods no-lock
     1314                       where buf_goods.stts = 0 ,
     1315                       each buf_cli-gds no-lock
     1316                       where buf_cli-gds.prod-type = buf_goods.prod-type
     1317                       and buf_cli-gds.prod-code = buf_goods.prod-code
     1318                       and buf_cli-gds.artic     = buf_goods.artic ,
     1319                       first g#cli
     1320                       where g#cli.obj-type = buf_cli-gds.prod-type
     1321                       and g#cli.obj-code = buf_cli-gds.prod-code,
     1322                       first buf_goods-attr no-lock
     1323                       where buf_goods-attr.gds-code = buf_goods.gds-code
     1324                       and buf_goods-attr.attr-code = 'mark-type':U
     1325                       :
     1326                       find first tt-goods no-lock
     1327                           where tt-goods.prod-type = buf_goods.prod-type
     1328                           and tt-goods.prod-code = buf_goods.prod-code
     1329                           and tt-goods.artic     = buf_goods.artic
     1330                           no-error.
     1331                       if not available tt-goods then
     1332                       do:
     1333                           create tt-goods.
     1334                           buffer-copy buf_goods to tt-goods no-error.
     1335                           assign
     1336                               v-gds-counter = v-gds-counter + 1
     1337                               .
     1338                       end.
     1339                   end.
     1340               end.
     1341       end case.
     1342       run waitfram-hide in this-procedure .
     1343   end.
     1344   for each tt-goods:
     1345       for each buf_marking no-lock where buf_marking.gds-code = tt-goods.gds-code and
     1346           buf_marking.box-qnty = 1
     1347           and (buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB or
     1348           buf_marking.sts = objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB)
     1349               :
     1350           if buf_marking.expDate <> ? and buf_marking.expDate <> "" then do:
     1351               vExpireDateOther = "-" .
     1352               if buf_marking.expDateOther <> ? and buf_marking.expDateOther <> "" then
     1353               do:
     1354                   vExpireDateOther = "" .
     1355                   do ii = 1 to num-entries (buf_marking.expDateOther):
     1356                       if vExpireDateOther = "" then vExpireDateOther = string(date(entry(ii,buf_marking.expDateOther)),"99.99.9999") .
     1357                       else vExpireDateOther = vExpireDateOther + ", " + string(date(entry(ii,buf_marking.expDateOther)),"99.99.9999") .
     1358                   end.
     1359                 end.
     1360               find first buf_exp where buf_exp.gds-code = tt-goods.gds-code and
     1361               buf_exp.expireDate = date(buf_marking.expDate) and buf_exp.expireDateOther = vExpireDateOther no-error .
     1362               if not available (buf_exp) then do:
     1363                   create buf_exp .
     1364                   assign
     1365                   buf_exp.gds-code   = tt-goods.gds-code
     1366                   buf_exp.gds-name   = tt-goods.gds-name
     1367                   buf_exp.expireDate = date(buf_marking.expDate)
     1368                   buf_exp.qntyDay    = integer(date(buf_marking.expDate) - today)
     1369                   .
     1370                   if vExpireDateOther <> "" then buf_exp.expireDateOther = vExpireDateOther .
     1371               end.
     1372           buf_exp.fact-qnty = buf_exp.fact-qnty + 1 .
     1373           end.
     1374       end.
     1375   end.
     1376   run get-full-path-RepViewer(output v-full-path-RepView).
     1377   run get-report-num in parParentProc(output g#report-num).
     1378   run define-full-path-Report(input g#report-num, output v-file-name-rep-htm).
     1379   run create-file(v-file-name-rep-htm).
     1380   run waitfram-show in this-procedure ("Подождите ...").
     1381   output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8' .
     1382   put stream OutStr-html unformatted
     1383       "<!DOCTYPE HTML>" skip
     1384       ' <html>' skip
     1385       '  <head>' skip
     1386       '   <meta charset="utf-8">' skip
     1387       '    <style type="text/css">' skip
     1388       '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     1389       '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     1390       '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black; height: 14px;' + chr(125) skip
     1391       '   </style>' skip
     1392       '  </head>' skip
     1393       .
     1394   put stream OutStr-html unformatted
     1395       '<body>' skip
     1396       '<TABLE name="zakaz"  fit_to_page="true" orientation="landscape" CELLSPACING="0" BORDER="0">'skip
     1397       '<thead>' skip
     1398       .
     1399   put stream OutStr-html unformatted
     1400       '<tr class="set_columns">' skip
     1401       '<td style="width: 120px;"></td>' skip
     1402       '<td style="width: 120px;"></td>' skip
     1403       '<td style="width: 200px;"></td>' skip
     1404       '<td style="width: 120px;"></td>' skip
     1405       '<td style="width: 120px;"></td>' skip
     1406       '<td style="width: 150px;"></td>' skip
     1407       '<td style="width: 150px;"></td>' skip
     1408       '</tr>' skip
     1409       .
     1410   find first bf_clients no-lock where bf_clients.obj-code = v-cntxt-obj-code and
     1411       bf_clients.obj-type = v-cntxt-obj-type no-error .
     1412   put stream OutStr-html unformatted
     1413       '<tr>' skip
     1414       '<td colspan="7" style="text-align: left; font-weight:bold;">Отчёт по срокам годности маркированного товара</td>' skip
     1415       '</tr>' skip
     1416       '<tr>' skip
     1417       '<td colspan="7" text_wrap="true" style="text-align: left;">на ' + string(today,"99.99.9999") + '</td>' skip
     1418        '</tr>' skip
     1419       '<tr>' skip
     1420       '<td colspan="5" text_wrap="true" style="text-align: left;">объект: ' + bf_clients.obj-name + '</td>' skip
     1421       '</tr>' skip
     1422       '<tr height = "15px">' skip
     1423       '<td colspan="5" text_wrap="true" style="text-align: left;"></td>' skip
     1424       '</tr>' skip
     1425       '<tr>' skip
     1426       '<td colspan="5" text_wrap="true" style="text-align: left;">Условия формирования:</td>' skip
     1427       '</tr>' skip
     1428       '<tr>' skip
     1429       '<td colspan="5" text_wrap="true" style="text-align: left;">Период контроля: ' + string(p-period-control) + ' дней</td>' skip
     1430       '</tr>' skip
     1431       '<tr>' skip
     1432       '<td colspan="5" text_wrap="true" style="text-align: left;">Показать просроченные товары: ' + if p-expired-goods then "Да"  + '</td>' else "Нет" + '</td>' skip
     1433       '</tr>' skip
     1434       .
     1435   put stream OutStr-html unformatted
     1436       '<tr>' skip
     1437       '<td colspan="8" text_wrap="true" style="text-align: left; font-weight:bold;"><br></td>' skip
     1438       '</tr>' skip
     1439       '<tr>' skip
     1440       '<td colspan="8" text_wrap="true" style="text-align: left; font-weight:bold;"><br></td>' skip
     1441       '</tr>' skip
     1442       '</thead>' skip
     1443       .
     1444   put stream OutStr-html unformatted
     1445       '     <tbody>' skip
     1446       '       <tr>' skip
     1447       '         <th text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">№ п/п</th>' skip
     1448       '         <th text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Код товара</th>' skip
     1449       '         <th text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Наименование ТН</th>' skip
     1450       '         <th text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Дата истечения срока годности</th>' skip
     1451       '         <th text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Дней до истечения срока годности</th>' skip
     1452       '         <th text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Годен до (иные условия хранения)</th>' skip
     1453       '         <th text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Факт. кол-во</th>' skip
     1454       '       </tr>' skip
     1455       .
     1456   ii = 0 .
     1457   for each tt-exp no-lock where tt-exp.qntyDay <= p-period-control break by tt-exp.gds-name by tt-exp.expireDate:
     1458       if not p-expired-goods then do:
     1459         if tt-exp.qntyDay < 0 then next .
     1460       end.
     1461       ii = ii + 1 .
     1462       put stream OutStr-html unformatted
     1463           '       <tr>' skip
     1464           '         <td text_wrap="true" style="text-align: center;">' + string(ii) + '</td>' skip
     1465           '         <td text_wrap="true" style="text-align: center;">' + string(tt-exp.gds-code) + '</td>' skip
     1466           '         <td text_wrap="true" style="text-align: center;">' + string(tt-exp.gds-name) + '</td>' skip
     1467           '         <td text_wrap="true" style="text-align: center;">' + string(tt-exp.expireDate,"99.99.9999") + '</td>' skip
     1468           '         <td text_wrap="true" style="text-align: center;">' + string(tt-exp.qntyDay) + '</td>' skip
     1469           '         <td text_wrap="true" style="text-align: center;">' + string(tt-exp.expireDateOther) + '</td>' skip
     1470           '         <td text_wrap="true" style="text-align: center;">' + string(tt-exp.fact-qnty) + '</td>' skip
     1471           '       </tr>' skip
     1472           .
     1473   end.
     1474   run prn-lib-reportviewer-report-name in this-procedure (
     1475       input THIS-PROCEDURE
     1476       ,input v-file-name-rep-htm
     1477       ).
     1478   procedure get-full-path-RepViewer:
     1479       define output parameter p-fill-path-RepView as character no-undo.
     1480       if search("exe\ReportViewer\reportviewer.exe") <> ? then
     1481       do:
     1482           p-fill-path-RepView = search("exe\ReportViewer\reportviewer.exe").
     1483       end.
     1484       else
     1485       do:
     1486           message "Не найдена программа просмотра отчёта!" view-as alert-box error.
     1487       end.
     1488   end procedure.
     1489   procedure define-full-path-Report:
     1490       define input parameter p-rep-num as integer no-undo.
     1491       define output parameter p-file-name-rep-htm as character no-undo.
     1492       p-file-name-rep-htm = session:temp-directory + "rpt" + string(p-rep-num) + ".html".
     1493   end procedure.
     1494   procedure search-full-path-Report:
     1495       define input parameter p-file-name as character no-undo.
     1496       if search(p-file-name) = ? then
     1497       do:
     1498           message "Не найден файл отчёта: " p-file-name view-as alert-box error.
     1499       end.
     1500       else
     1501       do:
     1502           p-file-name = search(p-file-name).
     1503       end.
     1504   end procedure.
     1505   procedure Report-Viewer:
     1506       define input parameter p-full-path-RepView as character no-undo.
     1507       define input parameter p-file-name-rep-htm as character no-undo.
     1508       os-command no-wait value(p-full-path-RepView + " " + search(p-file-name-rep-htm)).
     1509   end procedure.
     1510   procedure create-file:
     1511       define input parameter p-file-name as character no-undo.
     1512       output to value(string(p-file-name)).
     1513       output close.
     1514   end procedure.
