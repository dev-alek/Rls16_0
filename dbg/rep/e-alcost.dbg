     1848           vss-include-info17 skip
     1849           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
     1850           "Объект" p-obj-type p-obj-code skip
     1851           "Артикул" p-artic p-prod-type p-prod-code skip
     1852           "p-fact-order" p-fact-order skip
     1853           view-as alert-box error .
