     3636   end case.
     3637   run print-header in this-procedure.
     3638   define variable v-account as integer init 0 no-undo .
     3639   define variable v-account-lavel as character no-undo .
     3640   define variable v-button-stop as logical no-undo .
     3641   define variable v-kol-spice as integer no-undo .
     3642   define variable v-kol-spice2 as integer no-undo .
     3643   define variable v-kol-spice3 as integer no-undo .
     3644   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     3645   DEFINE BUTTON StopBtn AUTO-END-KEY
     3646        LABEL "Стоп"
     3647        SIZE 10 BY 1.
     3648   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     3649        LABEL "Обработано записей"
     3650         VIEW-AS TEXT
     3651        SIZE 14 BY .67 NO-UNDO.
     3652   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     3653         VIEW-AS TEXT
     3654        SIZE 53.25 BY .67
     3655        FGCOLOR 1  NO-UNDO.
     3656   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     3657         VIEW-AS TEXT
     3658        SIZE 53.25 BY .67
     3659        FGCOLOR 1  NO-UNDO.
     3660   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     3661         VIEW-AS TEXT
     3662        SIZE 53.25 BY .67
     3663        FGCOLOR 1  NO-UNDO.
     3664   DEFINE RECTANGLE RECT-1
     3665        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     3666        SIZE 55.13 BY 4.46.
     3667   DEFINE FRAME InfoFrame
     3668        StopBtn AT ROW 4.25 COL 21.75
     3669        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     3670        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     3671        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     3672        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     3673        RECT-1 AT ROW 1 COL 1
     3674       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     3675            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     3676            TITLE "Процесс"
     3677            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     3678   define variable mFrameView      as logical   no-undo init yes.
     3679     define variable mFramHandle as handle no-undo.
     3680     mFramHandle = frame InfoFrame:handle.
     3681     if  log-manager:logfile-name ne ?
     3682     then DO:
     3683         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     3684         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     3685         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     3686     end.
     3687     mFrameView = not session:batch-mode and mFramHandle:visible.
     3688     if mFrameView
     3689     then do:
     3690       ASSIGN
     3691          FRAME InfoFrame:HIDDEN                           = TRUE
     3692          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     3693     end.
     3694   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     3695   DO:
     3696     IF not StopProcessing THEN
     3697       Message "Вы действительно хотите прервать" SKIP
     3698               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     3699                 UPDATE StopProcessing.
     3700     IF StopProcessing THEN do:
     3701        if mFrameView
     3702        then do:
     3703           HIDE FRAME InfoFrame.
     3704        end.
     3705     End.
     3706   END.
     3707   assign v-account = 100.
     3708     if  log-manager:logfile-name ne ?
     3709     then DO:
     3710         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     3711     end.
     3712     if not session:batch-mode then
     3713     do:
     3714       VIEW FRAME InfoFrame.
     3715       mFrameView = true.
     3716     end.
     3717      v-button-stop = false .
     3718         if mFrameView
     3719         then do:
     3720         if v-button-stop then view STOPBTN in frame InfoFrame.
     3721                          else Hide STOPBTN in frame InfoFrame.
     3722         end.
     3723   for each temp-str no-lock
     3724     break by temp-str.obj-code
     3725           by temp-str.obj-type
     3726           by temp-str.artic
     3727   :
     3728     assign
     3729       counter = counter + 1
     3730     .
     3731   IF ( counter modulo v-account = 0 )  then DO:
     3732    Assign
     3733       v-kol-spice = (50 - LENGTH(v-repfrm-title)) / 2
     3734       RecordsString = fill(' ',v-kol-spice) + string(v-repfrm-title)
     3735       .
     3736             if  log-manager:logfile-name ne ?
     3737             then DO:
     3738                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     3739             end.
     3740              if mFrameView
     3741              then do:
     3742               DISPLAY
     3743                 counter @ RecordsDone
     3744                 RecordsString   @ RecordsString
     3745                 WITH FRAME InfoFrame.
     3746              end.
     3747   End.
     3748      if v-button-stop then  DO:
     3749            if mFrameView
     3750            then
     3751               PROCESS EVENTS.
     3752            IF StopProcessing THEN DO:
     3753            RETURN error.
     3754            End.
     3755      end.
     3756     run print-temp-str-line in this-procedure.
     3757     accumulate temp-str.fact-qnty ( TOTAL ).
     3758   end.
     3759   if mFrameView
     3760   then do:
     3761      HIDE FRAME InfoFrame.
     3762   end.
     3763   assign
     3764     v-total-qnty = accum TOTAL temp-str.fact-qnty
     3765   .
     3766   run print-itog in this-procedure.
     3767   for each temp-gds:
     3768     delete temp-gds.
     3769   end.
     3770   for each temp-str:
     3771     delete temp-str.
     3772   end.
     3773   hide stream out-stream frame BottomFrame.
     3774   if Make-Excel then output stream ForExcel close.
     3775   output stream out-stream close.
     3776     define variable v-user-action as character no-undo .
     3777     define variable v-printed as logical   no-undo .
     3778     define variable DisabledOptions as integer   no-undo .
     3779     DisabledOptions = 7 .
     3780     run gbl/prnfilen.w
     3781       (input  ""
     3782       ,input  DisabledOptions
     3783       ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     3784       ,input  7
     3785       ,output v-user-action
     3786       ,output v-printed
     3787       ) .
     3788   end.
     3789   procedure print-header :
     3790   do
     3791   on error undo, return error return-value
     3792   :
     3793     put stream out-stream "СКЛАД НАЛИЧИЕ" at 70 skip x-Date-Alone at 120 format "99.99.99" skip.
     3794     put stream out-stream "По объектам:" at 6 skip.
     3795     for each obj-list no-lock
     3796         by obj-list.obj-code
     3797         by obj-list.obj-name
     3798     :
     3799       put stream out-stream substitute( "&1 (&2)" , obj-list.obj-name , obj-list.obj-code) at 19 format "X(100)" skip.
     3800     end.
     3801     assign
     3802       sheetf.Excel-Column-Lable =
     3803       "Артикул" + chr(44) +
     3804       "Описание"  + chr(44) +
     3805       "Остаток"  + chr(44) +
     3806       "Дата выпуска"  + chr(44) +
     3807       "Ед.Из" + chr(44) +
     3808       "Код склада" + chr(44) +
     3809       "Дата прих. док." + chr(44) +
     3810       "Документ прихода" + chr(44) +
     3811       "Спецификация выпуска"
     3812       sheetf.sizes =
     3813       "20"  + chr(44) +
     3814       "40"  + chr(44) +
     3815       "15"  + chr(44) +
     3816       "15"  + chr(44) +
     3817       "15"  + chr(44) +
     3818       "15"  + chr(44) +
     3819       "15"  + chr(44) +
     3820       "15"  + chr(44) +
     3821       "15"
     3822       Sheetf.colformat = "1=@;2=@;3=0,00;4=dd/mm/yy;5=0,00;6=0;7=dd/mm/yy;8=@;9=@;"
     3823     .
     3824     run rep/extitle.p (1).
     3825   end.
     3826   end procedure.
     3827   procedure find-docs:
     3828   define output parameter list-doc  as character no-undo.
     3829   define output parameter list-date as character no-undo.
     3830   define output parameter ext-type  as character no-undo.
     3831   define buffer buf_parts for ub.parts.
     3832   do
     3833   on error undo, return error return-value
     3834   :
     3835     define variable v-doc                as character      no-undo .
     3836     define variable v-date               as character      no-undo .
     3837     assign
     3838       list-doc  = ""
     3839       list-date = ""
     3840       ext-type  = ""
     3841     .
     3842     for each buf_parts no-lock
     3843           where buf_parts.obj-type  = temp-parts.obj-type
     3844             and buf_parts.obj-code  = temp-parts.obj-code
     3845             and buf_parts.artic     = temp-parts.artic
     3846             and buf_parts.prod-type = temp-parts.prod-type
     3847             and buf_parts.prod-code = temp-parts.prod-code
     3848             and buf_parts.in-code   = temp-parts.in-code
     3849             and buf_parts.part-code = temp-parts.part-code,
     3850         first buf_trn-doc no-lock
     3851           where buf_trn-doc.doc-code      = buf_parts.out-code
     3852             and buf_trn-doc.ext-doc-type  = 'ie':U
     3853             and buf_trn-doc.status_       = 'факт':U
     3854             or  buf_trn-doc.doc-code      = buf_parts.out-code
     3855             and buf_trn-doc.ext-doc-type  = 'iv':U
     3856             and buf_trn-doc.status_       = 'факт':U
     3857         on error undo, return error return-value
     3858     :
     3859       assign
     3860         v-doc     = if buf_trn-doc.doc-code <> ? then buf_trn-doc.doc-code else " "
     3861         v-date    = if buf_trn-doc.fact-date <> ? then string( buf_trn-doc.fact-date ) else " "
     3862       .
     3863       if list-doc = "" then do :
     3864         assign
     3865           list-doc  = v-doc
     3866           list-date = v-date
     3867           ext-type  = buf_trn-doc.ext-doc-type
     3868         .
     3869       end.
     3870       else do :
     3871         assign
     3872           list-doc  = list-doc  + "," + v-doc
     3873           list-date = list-date + "," + v-date
     3874           ext-type  = ext-type  + "," + buf_trn-doc.ext-doc-type
     3875         .
     3876       end.
     3877     end.
     3878   end.
     3879   end procedure.
     3880   procedure print-temp-str-line:
     3881   define variable v-log-first               as logical  initial yes   no-undo .
     3882   do
     3883   on error undo, return error
     3884   :
     3885      if ( length( temp-str.mark-code ) + 1 ) > 12 then
     3886       do:
     3887         assign
     3888           v-alc-mark-code = substitute( "&1>" , substring( temp-str.mark-code , 1 , (12 - 1) ) )
     3889         .
     3890      end.
     3891      else
     3892       do:
     3893         assign
     3894           v-alc-mark-code = temp-str.mark-code
     3895         .
     3896       end.
     3897       if length( temp-str.gds-name ) > 40 then
     3898       do:
     3899         assign
     3900           v-gds-name = substitute( "&1>" , substring( temp-str.gds-name , 1 , (40 - 1) ) )
     3901         .
     3902       end.
     3903       else
     3904       do:
     3905         assign
     3906           v-gds-name = temp-str.gds-name
     3907         .
     3908       end.
     3909     if temp-str.list-doc = "" then do:
     3910       display stream out-stream
     3911         sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10
     3912         temp-str.artic
     3913         v-gds-name @ temp-str.gds-name
     3914         temp-str.fact-qnty
     3915         temp-str.out-date
     3916         temp-str.ms-base
     3917         temp-str.obj-code
     3918         temp-str.in-code
     3919         temp-str.fact-date
     3920         v-alc-mark-code @ temp-str.mark-code
     3921       with frame f-doc.
     3922       down stream out-stream with frame f-doc.
     3923       if Make-Excel then  put   stream ForExcel unformatted
     3924         temp-str.artic      CHR(9)
     3925         temp-str.gds-name   CHR(9)
     3926         temp-str.fact-qnty  CHR(9)
     3927         temp-str.out-date   CHR(9)
     3928         temp-str.ms-base    CHR(9)
     3929         temp-str.obj-code   CHR(9)
     3930         temp-str.fact-date  CHR(9)
     3931         temp-str.in-code    CHR(9)
     3932         temp-str.mark-code
     3933       SKIP.
     3934     end.
     3935     else do:
     3936       assign
     3937         v-doc-source      = temp-str.list-doc
     3938         v-date-source     = temp-str.list-date
     3939         v-ext-type-source = temp-str.ext-type
     3940       .
     3941       loop :
     3942         repeat :
     3943           assign
     3944             v-doc   = entry( 1 , v-doc-source , "," )
     3945             v-date  = date( entry( 1 , v-date-source , "," ) )
     3946             v-ext-type = entry( 1 , v-ext-type-source , "," )
     3947           .
     3948           if v-doc = "" then do:
     3949             leave loop .
     3950           end.
     3951           else do:
     3952             view stream out-stream frame BottomFrame .
     3953             if v-log-first = yes then do:
     3954               assign
     3955                 v-log-first = no
     3956               .
     3957               display stream out-stream
     3958                 sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10
     3959                 temp-str.artic
     3960                 v-gds-name @ temp-str.gds-name
     3961                 temp-str.fact-qnty
     3962                 temp-str.out-date
     3963                 temp-str.ms-base
     3964                 temp-str.obj-code
     3965                 v-date @ temp-str.fact-date
     3966                 v-doc @ temp-str.in-code
     3967                 v-alc-mark-code @ temp-str.mark-code
     3968               with frame f-doc.
     3969               down stream out-stream with frame f-doc.
     3970               if Make-Excel then  put   stream ForExcel unformatted
     3971                 temp-str.artic            CHR(9)
     3972                 temp-str.gds-name         CHR(9)
     3973                 temp-str.fact-qnty        CHR(9)
     3974                 temp-str.out-date         CHR(9)
     3975                 temp-str.ms-base          CHR(9)
     3976                 temp-str.obj-code         CHR(9)
     3977                 v-date format "99.99.99"  CHR(9)
     3978                 v-doc                     CHR(9)
     3979                 temp-str.mark-code
     3980               SKIP.
     3981             end.
     3982             else do:
     3983               display stream out-stream
     3984                 sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10
     3985                 v-doc @ temp-str.in-code
     3986                 v-date @ temp-str.fact-date
     3987               with frame f-doc.
     3988               down stream out-stream with frame f-doc.
     3989               if Make-Excel then  put   stream ForExcel unformatted
     3990                 " "   CHR(9)
     3991                 " "   CHR(9)
     3992                 " "   CHR(9)
     3993                 " "   CHR(9)
     3994                 " "   CHR(9)
     3995                 " "   CHR(9)
     3996                 v-date format "99.99.99" CHR(9)
     3997                 v-doc CHR(9)
     3998                 " "
     3999               SKIP.
     4000             end.
     4001           end.
     4002           assign
     4003             v-doc-source      = substring( v-doc-source , length( v-doc ) + 2 )
     4004             v-date-source     = substring( v-date-source , length ( string( v-date ) ) + 2 )
     4005             v-ext-type-source = substring( v-ext-type-source , length ( v-ext-type ) + 2 )
     4006           .
     4007         END.
     4008     end.
     4009   end.
     4010   end procedure.
     4011   procedure print-itog :
     4012   do
     4013   on error undo, return error return-value
     4014   :
     4015   if Make-Excel then  put   stream ForExcel unformatted
     4016     " "           CHR(9)
     4017     " "           CHR(9)
     4018     " "           CHR(9)
     4019     " "           CHR(9)
     4020     " "           CHR(9)
     4021     " "           CHR(9)
     4022     " "           CHR(9)
     4023     " "           CHR(9)
     4024     " "
     4025   skip(1).
     4026   if Make-Excel then  put   stream ForExcel unformatted
     4027     " "           CHR(9)
     4028     "Итого: "     CHR(9)
     4029     v-total-qnty format "->>>,>>>,>>>,>>9.99" CHR(9)
     4030     " "           CHR(9)
     4031     " "           CHR(9)
     4032     " "           CHR(9)
     4033     " "           CHR(9)
     4034     " "           CHR(9)
     4035     " "
     4036   SKIP.
     4037   put stream out-stream v-line at 1 format "X(131)".
     4038   if line-counter( out-stream ) + 5 > page-size( out-stream ) then do :
     4039     page stream out-stream.
     4040     down stream out-stream with frame f-doc.
     4041   end.
     4042   put stream out-stream skip(2) "Итого: " at 19 v-total-qnty at 51 format "->>>,>>>,>>>,>>9.99" .
     4043   end.
     4044   end procedure.
