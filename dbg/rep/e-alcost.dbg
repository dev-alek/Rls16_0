     1971       if error-status :error
     1972       then do:
     1973         message
     1974           vss-workfile vss-revision vss-description skip
     1975           vss-include-info17 skip
     1976           "Ошибка при определении атрибута товара" skip
     1977           "Артикул" p-artic p-prod-type p-prod-code skip
     1978           "gds-goods=request" skip
     1979           error-status :get-message(1) skip
     1980           return-value skip
     1981           view-as alert-box error .
     1982         undo, return error return-value .
     1983       end.
     1984   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1985   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1986     (input  p-artic
     1987     ,input  p-prod-type
     1988     ,input  p-prod-code
     1989     ,input  'twounit=request':u
     1990     ,output v-goods-twounit
     1991     ) no-error .
     1992       if error-status :error
     1993       then do:
     1994         message
     1995           vss-workfile vss-revision vss-description skip
     1996           vss-include-info17 skip
     1997           "Ошибка при определении атрибута товара" skip
     1998           "Артикул" p-artic p-prod-type p-prod-code skip
     1999           "twounit=request" skip
     2000           error-status :get-message(1) skip
     2001           return-value skip
     2002           view-as alert-box error .
     2003         undo, return error return-value .
     2004       end.
     2005       for each buf_doc-line no-lock
     2006         where buf_doc-line.obj-type   = p-obj-type
     2007           and buf_doc-line.obj-code   = p-obj-code
     2008           and buf_doc-line.artic      = p-artic
     2009           and buf_doc-line.prod-type  = p-prod-type
     2010           and buf_doc-line.prod-code  = p-prod-code
     2011           and buf_doc-line.status_    = 'факт':U
     2012           and buf_doc-line.fact-order > p-start-fact-order
     2013           and buf_doc-line.fact-order <= p-end-fact-order
     2014       on error undo, return error
     2015       :
     2016         run partslib-process-document in this-procedure
     2017           (input  buf_doc-line.doc-code
     2018           ,input  p-obj-type
     2019           ,input  p-obj-code
     2020           ,input  p-artic
     2021           ,input  p-prod-type
     2022           ,input  p-prod-code
     2023           ,input  v-goods-gds-goods
     2024           ,input  v-goods-twounit
     2025           ,output v-total-parts-qnty
     2026           ) no-error .
     2027         if error-status :error
     2028         then do:
     2029           message
     2030             vss-workfile vss-revision vss-description skip
     2031             vss-include-info17 skip
     2032             "Ошибка при вызове процедуры partslib-process-document" skip
     2033             "Документ" buf_doc-line.doc-code skip
     2034             "Объект" p-obj-type p-obj-code skip
     2035             "Артикул" p-artic p-prod-type p-prod-code skip
     2036             "p-start-fact-order" p-start-fact-order skip
     2037             "p-end-fact-order" p-end-fact-order skip
     2038             error-status :get-message(1) skip
     2039             return-value skip
     2040             view-as alert-box error .
     2041           undo, return error return-value .
     2042         end.
     2043       end.
     2044     end.
     2045   end procedure.
     2046   procedure partslib-process-document :
     2047     define input  parameter p-doc-code         as character no-undo .
     2048     define input  parameter p-obj-type         as character no-undo .
     2049     define input  parameter p-obj-code         as integer   no-undo .
     2050     define input  parameter p-artic            as character no-undo .
     2051     define input  parameter p-prod-type        as character no-undo .
     2052     define input  parameter p-prod-code        as integer   no-undo .
     2053     define input  parameter p-goods-gds-goods  as logical   no-undo .
     2054     define input  parameter p-goods-twounit    as logical   no-undo .
     2055     define output parameter p-total-parts-qnty as decimal   no-undo .
     2056     define variable v-parts-sign as integer   no-undo .
     2057     define buffer buf_trn-doc    for ub.trn-doc .
     2058     define buffer buf_doc-line   for ub.doc-line .
     2059     define buffer buf_parts      for ub.parts .
     2060     define buffer buf_temp-parts for temp-parts .
     2061     do
     2062     on error undo, return error return-value
     2063     :
     2064       find first buf_trn-doc no-lock
     2065         where buf_trn-doc.doc-code = p-doc-code
     2066         no-error .
     2067       if not available buf_trn-doc
     2068       then do:
     2069         undo, return error substitute("Ошибка при поиске документа. Документ &1"
     2070                                      ,p-doc-code
     2071                                      ) .
     2072       end.
     2073       case buf_trn-doc.doc-type
     2074       :
     2075         when 'при':U or
     2076         when 'возврат':U or
     2077         when 'инв':U
     2078         then do:
     2079           assign
     2080             v-parts-sign = -1
     2081           .
     2082         end.
     2083         when 'рас':U or
     2084         when 'спи':U
     2085         then do:
     2086           assign
     2087             v-parts-sign = 1
     2088           .
     2089         end.
     2090         otherwise do:
     2091           undo, return error substitute("Неизвестный тип документа &1"
     2092                                       ,buf_trn-doc.doc-type
     2093                                       ) .
     2094         end.
     2095       end.
     2096       find first buf_doc-line no-lock
     2097         where buf_doc-line.doc-code  = p-doc-code
     2098           and buf_doc-line.artic     = p-artic
     2099           and buf_doc-line.prod-type = p-prod-type
     2100           and buf_doc-line.prod-code = p-prod-code
     2101         no-error .
     2102       if not available buf_doc-line
     2103       then do:
     2104         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
     2105                                      ,p-doc-code
     2106                                      ,artic
     2107                                      ,prod-type
     2108                                      ,prod-code
     2109                                      ) .
     2110       end.
     2111       assign
     2112         p-total-parts-qnty = 0
     2113       .
     2114       if p-goods-gds-goods = true
     2115       then do:
     2116         for each buf_parts no-lock
     2117           where buf_parts.out-code  = p-doc-code
     2118             and buf_parts.obj-type  = p-obj-type
     2119             and buf_parts.obj-code  = p-obj-code
     2120             and buf_parts.artic     = p-artic
     2121             and buf_parts.prod-type = p-prod-type
     2122             and buf_parts.prod-code = p-prod-code
     2123         on error undo, return error
     2124         :
     2125           run partslib-create-temp-parts in this-procedure
     2126             (buffer buf_parts
     2127             ,buffer buf_temp-parts
     2128             ,input  p-goods-twounit
     2129             ) .
     2130           assign
     2131             p-total-parts-qnty        = p-total-parts-qnty
     2132                                       + v-parts-sign * buf_parts.fact-qnty
     2133             buf_temp-parts.qnty       = buf_temp-parts.qnty
     2134                                       + v-parts-sign * buf_parts.fact-qnty
     2135             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
     2136                                       + v-parts-sign * buf_parts.fact-qnty
     2137             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
     2138                                       + v-parts-sign * buf_parts.cli-qnty
     2139           .
     2140           if buf_temp-parts.qnty = 0
     2141           then do:
     2142             delete buf_temp-parts .
     2143           end.
     2144         end.
     2145       end.
     2146       else do:
     2147         assign
     2148           p-total-parts-qnty = p-total-parts-qnty
     2149                              + v-parts-sign * buf_doc-line.fact-qnty
     2150         .
     2151       end.
     2152     end.
     2153   end procedure.
     2154   procedure partslib-init-temp-parts-by-date :
     2155     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     2156     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     2157     define input parameter p-artic           like ub.parts.artic     no-undo .
     2158     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     2159     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     2160     define input parameter p-fact-date       as date      no-undo .
     2161     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
     2162     do
     2163     on error undo, return error
     2164     :
     2165       define variable v-fact-order                as decimal   no-undo .
     2166       define variable v-shift-end-fact-order      as decimal   no-undo .
     2167       define variable v-day-end-fact-order        as decimal   no-undo .
     2168       run factord in this-procedure
     2169         (input  p-fact-date
     2170         ,input  1
     2171         ,input  1
     2172         ,input  ?
     2173         ,input  0
     2174         ,input  false
     2175         ,output v-fact-order
     2176         ,output v-shift-end-fact-order
     2177         ,output v-day-end-fact-order
     2178         ) no-error .
     2179       if error-status :error
     2180       then do:
     2181         message
     2182           vss-workfile vss-revision vss-description skip
     2183           vss-include-info17 skip
     2184           "Ошибка при определении момента времени, на который требуется остаток" skip
     2185           "Объект" p-obj-type p-obj-code skip
     2186           "Артикул" p-artic p-prod-type p-prod-code skip
     2187           "Дата" p-fact-date skip
     2188           view-as alert-box error .
     2189         undo, return error .
     2190       end.
     2191       run partslib-init-temp-parts-by-factord in this-procedure
     2192         (input p-obj-type
     2193         ,input p-obj-code
     2194         ,input p-artic
     2195         ,input p-prod-type
     2196         ,input p-prod-code
     2197         ,input v-day-end-fact-order
     2198         ,input false
     2199         ) no-error .
     2200       if error-status :error
     2201       then do:
     2202         message
     2203           vss-workfile vss-revision vss-description skip
     2204           vss-include-info17 skip
     2205           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
     2206           "Объект" p-obj-type p-obj-code skip
     2207           "Артикул" p-artic p-prod-type p-prod-code skip
     2208           "Дата" p-fact-date skip
     2209           view-as alert-box error .
     2210         undo, return error .
     2211       end.
     2212     end.
     2213   end procedure.
     2214   procedure partslib-calc-cost :
     2215     define output parameter p-fact-qnty      as decimal   no-undo .
     2216     define output parameter p-vat-pc         as decimal   no-undo .
     2217     define output parameter p-slt-pc         as decimal   no-undo .
     2218     define output parameter p-sum-base       as decimal   no-undo .
     2219     define output parameter p-sum-rubl       as decimal   no-undo .
     2220     define output parameter p-vat-base       as decimal   no-undo .
     2221     define output parameter p-vat-rubl       as decimal   no-undo .
     2222     define output parameter p-slt-base       as decimal   no-undo .
     2223     define output parameter p-slt-rubl       as decimal   no-undo .
     2224     define output parameter p-road-tax-base  as decimal   no-undo .
     2225     define output parameter p-road-tax-rubl  as decimal   no-undo .
     2226     define output parameter p-transport-base as decimal   no-undo .
     2227     define output parameter p-transport-rubl as decimal   no-undo .
     2228     define output parameter p-other-base     as decimal   no-undo .
     2229     define output parameter p-other-rubl     as decimal   no-undo .
     2230     define output parameter p-excise-base    as decimal   no-undo .
     2231     define output parameter p-excise-rubl    as decimal   no-undo .
     2232     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     2233     do
     2234     on error undo, return error return-value
     2235     :
     2236       define buffer buf_temp-parts for temp-parts .
     2237       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     2238       define buffer   in-vatp-parts    for ub.parts   .
     2239       define buffer   in-vatp-doc      for ub.trn-doc .
     2240       define buffer   in-vatp-goods    for ub.goods   .
     2241       define buffer   in-vatp-sysconf  for ub.sysconf .
     2242       define buffer   in-vatp_doc-attr for ub.doc-attr.
     2243       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     2244       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     2245       define variable varinvprb                  as   character              no-undo.
     2246       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     2247       define variable cli-base-rate              as   decimal                no-undo.
     2248       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     2249       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     2250       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     2251       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     2252       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     2253       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     2254       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     2255       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     2256       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     2257       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     2258       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     2259       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     2260       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     2261       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     2262       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     2263       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     2264       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     2265       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     2266       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     2267       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     2268       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     2269       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     2270       define variable varinvatp-envd             as   character              no-undo.
     2271       define variable varinvatp-type             as   character              no-undo.
     2272       for each buf_temp-parts
     2273       on error undo, return error
     2274       :
     2275   assign
     2276     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     2277     price-base-with-tax-loc = buf_temp-parts.price-base
     2278   .
     2279   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2280   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2281     (output varinvprb
     2282     )  .
     2283     if buf_temp-parts.out-code = 'free-zone':U     or
     2284        buf_temp-parts.out-code = 'out-zone':U   or
     2285        buf_temp-parts.doc-type = 'акт':U then do:
     2286       assign
     2287         in-vatp-have-vat-slt = yes.
     2288     end.
     2289     else do:
     2290       find first in-vatp_doc-attr no-lock
     2291         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     2292           and in-vatp_doc-attr.attr-code = 'envd':U
     2293         no-error .
     2294       if not available in-vatp_doc-attr then do:
     2295         assign
     2296           in-vatp-have-vat-slt = yes.
     2297       end.
     2298       else do:
     2299            in-vatp-have-vat-slt = no.
     2300       end.
     2301     end.
     2302     assign
     2303      price-cli-with-tax-loc = buf_temp-parts.price-cli
     2304      cli-base-rate          = buf_temp-parts.cli-base-rate.
     2305     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     2306              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     2307     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     2308             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     2309             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     2310             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     2311             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     2312             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     2313             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     2314       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     2315     assign
     2316       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     2317     assign
     2318       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     2319       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     2320       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     2321       transport-cli-loc  = 0
     2322       other-cli-loc      = 0
     2323     .
     2324   ASSIGN
     2325             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     2326       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     2327   .
     2328         assign
     2329           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     2330           p-vat-pc         = p-vat-pc         + vat-pc-loc
     2331           p-slt-pc         = p-slt-pc         + slt-pc-loc
     2332           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     2333           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     2334           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     2335           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     2336           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     2337           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     2338           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     2339           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     2340           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     2341           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     2342           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     2343           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     2344           p-excise-base    = p-excise-base    + 0
     2345           p-excise-rubl    = p-excise-rubl    + 0
     2346         .
     2347       end.
     2348       if p-fact-qnty      = ?
     2349       or p-sum-base       = ?
     2350       or p-sum-rubl       = ?
     2351       or p-vat-base       = ?
     2352       or p-vat-rubl       = ?
     2353       or p-slt-base       = ?
     2354       or p-slt-rubl       = ?
     2355       or p-road-tax-base  = ?
     2356       or p-road-tax-rubl  = ?
     2357       or p-transport-base = ?
     2358       or p-transport-rubl = ?
     2359       or p-other-base     = ?
     2360       or p-other-rubl     = ?
     2361       or p-excise-base    = ?
     2362       or p-excise-rubl    = ?
     2363       then do:
     2364         message
     2365           vss-workfile vss-revision vss-description skip
     2366           vss-include-info17 skip
     2367           "Программа in-vatp.i вернула неопределенные значения" skip
     2368           "p-fact-qnty"      p-fact-qnty      skip
     2369           "p-sum-base"       p-sum-base       skip
     2370           "p-sum-rubl"       p-sum-rubl       skip
     2371           "p-vat-base"       p-vat-base       skip
     2372           "p-vat-rubl"       p-vat-rubl       skip
     2373           "p-slt-base"       p-slt-base       skip
     2374           "p-slt-rubl"       p-slt-rubl       skip
     2375           "p-road-tax-base"  p-road-tax-base  skip
     2376           "p-road-tax-rubl"  p-road-tax-rubl  skip
     2377           "p-transport-base" p-transport-base skip
     2378           "p-transport-rubl" p-transport-rubl skip
     2379           "p-other-base"     p-other-base     skip
     2380           "p-other-rubl"     p-other-rubl     skip
     2381           "p-excise-base"    p-excise-base    skip
     2382           "p-excise-rubl"    p-excise-rubl    skip
     2383           view-as alert-box error .
     2384         undo, return error .
     2385       end.
     2386     end.
     2387   end procedure.
     2388   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2389   function octal-to-char return character
     2390   ( p-string as character ) :
     2391     def var v-asc     as integer no-undo .
     2392     def var v-new-asc as integer no-undo .
     2393     def var ind       as integer no-undo .
     2394     if length(p-string) <> 3 then do:
     2395       return ? .
     2396     end.
     2397     assign
     2398       v-asc = 0
     2399     .
     2400     do ind = 1 to length(p-string)
     2401     :
     2402       assign
     2403         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
     2404       .
     2405       if v-new-asc < 0 or v-new-asc >= 8 then do:
     2406         return ? .
     2407       end.
     2408       assign
     2409         v-asc = v-asc * 8 + v-new-asc
     2410       .
     2411     end.
     2412     return chr(v-asc) .
     2413   end function .
     2414   function char-to-octal return character
     2415   ( p-chr as character ) :
     2416     def var v-asc    as integer   no-undo .
     2417     def var ind      as integer   no-undo .
     2418     def var v-string as character no-undo .
     2419     if length(p-chr) <> 1 then do:
     2420       return ? .
     2421     end.
     2422     assign
     2423       v-asc    = asc(p-chr)
     2424       v-string = ""
     2425     .
     2426     do ind = 1 to 3
     2427     :
     2428       assign
     2429         v-string = chr( v-asc mod 8 + asc('0')) + v-string
     2430       .
     2431       assign
     2432         v-asc = truncate(v-asc / 8, 0)
     2433       .
     2434     end.
     2435     return v-string .
     2436   end.
     2437   function str-encode return character
     2438   (   p-init-string       as character
     2439     , p-encode-char       as character
     2440     , p-special-char-list as character
     2441   ) :
     2442     def var p-encode-string as character no-undo .
     2443     def var ind                as integer no-undo .
     2444     def var v-num-special-char as integer no-undo .
     2445     def var v-special-char     as character no-undo .
     2446     if p-encode-char = ?
     2447     or p-encode-char = "" then do:
     2448       assign
     2449         p-encode-char = "~~"
     2450       .
     2451     end.
     2452     if p-init-string = ? then do:
     2453       return "?" .
     2454     end.
     2455     if p-init-string = "?" then do:
     2456       return p-encode-char + char-to-octal("?") .
     2457     end.
     2458     assign
     2459       v-num-special-char = length(p-special-char-list)
     2460       p-encode-string    = replace(p-init-string
     2461                                   ,p-encode-char
     2462                                   ,p-encode-char + char-to-octal(p-encode-char)
     2463                                   )
     2464     .
     2465     do ind = 1 to v-num-special-char
     2466     :
     2467       assign
     2468         v-special-char = substring(p-special-char-list, ind, 1)
     2469       .
     2470       if v-special-char <> p-encode-char then do:
     2471         assign
     2472           p-encode-string = replace (p-encode-string
     2473                                     ,v-special-char
     2474                                     ,p-encode-char + char-to-octal(v-special-char)
     2475                                     )
     2476         .
     2477       end.
     2478     end.
     2479     return p-encode-string .
     2480   end.
     2481   function str-decode returns character
     2482     (p-init-string   as character
     2483     ,p-encode-char   as character
     2484     ) :
     2485     def var p-decode-string as character no-undo .
     2486     def var ind                       as integer no-undo .
     2487     def var v-num-entries-init-string as integer no-undo .
     2488     def var v-sub-phrase              as character no-undo .
     2489     def var v-special-char            as character no-undo .
     2490     if p-encode-char = ?
     2491     or p-encode-char = "" then do:
     2492       assign
     2493         p-encode-char = "~~"
     2494       .
     2495     end.
     2496     if p-init-string = "?" then do:
     2497       return ? .
     2498     end.
     2499     assign
     2500       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
     2501     .
     2502     if v-num-entries-init-string > 1 then do:
     2503       assign
     2504         p-decode-string = entry(1, p-init-string, p-encode-char)
     2505       .
     2506       do ind = 2 to v-num-entries-init-string
     2507       :
     2508         assign
     2509           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
     2510         .
     2511         assign
     2512           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
     2513         .
     2514         if v-special-char <> ? then do:
     2515           assign
     2516             p-decode-string = p-decode-string
     2517                             + v-special-char
     2518                             + substring(v-sub-phrase, 4)
     2519           .
     2520         end.
     2521         else do:
     2522           assign
     2523             p-decode-string = p-decode-string
     2524                             + p-encode-char
     2525                             + v-sub-phrase
     2526           .
     2527         end.
     2528       end.
     2529     end.
     2530     else do:
     2531       assign
     2532         p-decode-string = p-init-string
     2533       .
     2534     end.
     2535     return p-decode-string .
     2536   end.
     2537   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2538   procedure integerm :
     2539     define input  parameter p-string      as character no-undo .
     2540     define input  parameter p-allow-sign  as logical   no-undo .
     2541     define input  parameter p-allow-comma as logical   no-undo .
     2542     define output parameter p-value       as integer   no-undo .
     2543     define output parameter p-data-valid  as logical   no-undo .
     2544     define output parameter p-message     as character no-undo .
     2545     define variable v-replace-string as character no-undo .
     2546     do
     2547     on error undo, return error return-value
     2548     :
     2549       if p-string = ?
     2550       then do:
     2551         assign
     2552           p-value      = ?
     2553           p-data-valid = false
     2554           p-message    = "Ошибка задания входных параметров. Не задана строка для преобразования"
     2555         .
     2556         return .
     2557       end.
     2558       if p-string = ""
     2559       then do:
     2560         assign
     2561           p-value      = ?
     2562           p-data-valid = false
     2563           p-message    = "Ошибка задания входных параметров. Задана пустая строка для преобразования"
     2564         .
     2565         return .
     2566       end.
     2567       assign
     2568         p-value = integer(p-string) no-error
     2569       .
     2570       if error-status :error = true
     2571       then do:
     2572         assign
     2573           p-value      = ?
     2574           p-data-valid = false
     2575           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'"
     2576                                    ,p-string
     2577                                    )
     2578         .
     2579         return .
     2580       end.
     2581       if index(p-string, ' ':u) > 0
     2582       then do:
     2583         assign
     2584           p-value      = ?
     2585           p-data-valid = false
     2586           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
     2587                                    + "Строка содержит символы пробела"
     2588                                    ,p-string
     2589                                    )
     2590         .
     2591         return .
     2592       end.
     2593       assign
     2594         v-replace-string = p-string
     2595         v-replace-string = replace(v-replace-string, '0':u, '9':u)
     2596         v-replace-string = replace(v-replace-string, '1':u, '9':u)
     2597         v-replace-string = replace(v-replace-string, '2':u, '9':u)
     2598         v-replace-string = replace(v-replace-string, '3':u, '9':u)
     2599         v-replace-string = replace(v-replace-string, '4':u, '9':u)
     2600         v-replace-string = replace(v-replace-string, '5':u, '9':u)
     2601         v-replace-string = replace(v-replace-string, '6':u, '9':u)
     2602         v-replace-string = replace(v-replace-string, '7':u, '9':u)
     2603         v-replace-string = replace(v-replace-string, '8':u, '9':u)
     2604       .
     2605       if p-allow-sign = true
     2606       then do:
     2607         if index('+-':u, substring(v-replace-string, 1, 1)) > 0
     2608         then do:
     2609           assign
     2610             v-replace-string = substring(v-replace-string, 2)
     2611           .
     2612         end.
     2613       end.
     2614       else do:
     2615         if substring(v-replace-string, 1, 1) = '+':u
     2616         then do:
     2617           assign
     2618             p-value      = ?
     2619             p-data-valid = false
     2620             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
     2621                                     + "Задан параметр недопустимости знака челого числа. "
     2622                                     + "Строка содержит символ плюс. "
     2623                                     ,p-string
     2624                                     )
     2625           .
     2626           return .
     2627         end.
     2628         if substring(v-replace-string, 1, 1) = '-':u
     2629         then do:
     2630           assign
     2631             p-value      = ?
     2632             p-data-valid = false
     2633             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
     2634                                     + "Задан параметр недопустимости знака челого числа. "
     2635                                     + "Строка содержит символ минус. "
     2636                                     ,p-string
     2637                                     )
     2638           .
     2639           return .
     2640         end.
     2641       end.
     2642       if p-allow-comma = true
     2643       then do:
     2644         assign
     2645           v-replace-string = replace(v-replace-string, ',', '')
     2646         .
     2647       end.
     2648       else do:
     2649         if index(v-replace-string, ',') > 0
     2650         then do:
     2651           assign
     2652             p-value      = ?
     2653             p-data-valid = false
     2654             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
     2655                                     + "Задан параметр недопустимости знака разделителя тысяч."
     2656                                     + "Строка содержит знак разделителя тысяч. "
     2657                                     ,p-string
     2658                                     )
     2659           .
     2660           return .
     2661         end.
     2662       end.
     2663       if index(p-string, '.') > 0
     2664       then do:
     2665         assign
     2666           p-value      = ?
     2667           p-data-valid = false
     2668           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
     2669                                    + "Строка содержит знак десятичной точки"
     2670                                    ,p-string
     2671                                    )
     2672         .
     2673         return .
     2674       end.
     2675       if v-replace-string <> fill('9', length(v-replace-string))
     2676       then do:
     2677         assign
     2678           p-value      = ?
     2679           p-data-valid = false
     2680           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
     2681                                    + "Встречены символы, недопустимые для целого числа '&2'"
     2682                                    ,p-string
     2683                                    ,replace(v-replace-string, '9', '')
     2684                                    )
     2685         .
     2686         return .
     2687       end.
     2688       assign
     2689         p-data-valid = true
     2690         p-message    = ""
     2691       .
     2692     end.
     2693   end procedure.
     2694   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2695   procedure alc-lib_mark-name :
     2696     define input  parameter p-mark-db-num   as integer   no-undo .
     2697     define input  parameter p-mark-code     as integer   no-undo .
     2698     define output parameter p-mark-name     as character no-undo .
     2699     define buffer buf_ex-mark for ub.ex-mark .
     2700     do
     2701     on error undo, return error return-value
     2702     :
     2703       if p-mark-db-num = ?
     2704       or p-mark-code   = ?
     2705       then do:
     2706         assign
     2707           p-mark-name = '?':u
     2708         .
     2709         return .
     2710       end.
     2711       if  p-mark-db-num = 0
     2712       and p-mark-code   = 0
     2713       then do:
     2714         assign
     2715           p-mark-name = ""
     2716         .
     2717         return .
     2718       end.
     2719       find first buf_ex-mark no-lock
     2720         where buf_ex-mark.db-num    = p-mark-db-num
     2721           and buf_ex-mark.mark-code = p-mark-code
     2722         no-error .
     2723       if available buf_ex-mark
     2724       then do:
     2725         assign
     2726           p-mark-name = substitute('&1':u
     2727                                   ,buf_ex-mark.mark-name
     2728                                   )
     2729         .
     2730       end.
     2731     end.
     2732   end procedure.
     2733   procedure alc-lib_get-new-part-code :
     2734     define input  parameter p-obj-type       as character no-undo .
     2735     define input  parameter p-obj-code       as integer   no-undo .
     2736     define input  parameter p-prod-type      as character no-undo .
     2737     define input  parameter p-prod-code      as integer   no-undo .
     2738     define input  parameter p-artic          as character no-undo .
     2739     define input  parameter p-doc-code       as character no-undo .
     2740     define output parameter p-new-part-code  as character no-undo .
     2741     define variable v-cur-part-code as integer no-undo.
     2742     define variable v-max-part-code as integer no-undo.
     2743     define variable i               as integer no-undo.
     2744     define buffer bf_parts for ub.parts .
     2745     do
     2746     on error undo, return error return-value
     2747     :
     2748       assign
     2749         v-max-part-code = 0
     2750       .
     2751       for each bf_parts no-lock
     2752             where bf_parts.obj-type  = p-obj-type  and
     2753                   bf_parts.obj-code  = p-obj-code  and
     2754                   bf_parts.prod-type = p-prod-type and
     2755                   bf_parts.prod-code = p-prod-code and
     2756                   bf_parts.artic     = p-artic     and
     2757                   bf_parts.out-code  = p-doc-code
     2758         :
     2759         assign
     2760           v-cur-part-code = integer(bf_parts.part-code)
     2761           no-error.
     2762         if error-status:error = no and v-cur-part-code > v-max-part-code then do:
     2763           assign
     2764             v-max-part-code = v-cur-part-code
     2765           .
     2766         end.
     2767       end.
     2768       assign
     2769         p-new-part-code = string (v-max-part-code + 1)
     2770       .
     2771     end.
     2772   end procedure.
     2773   define temp-table temp-str no-undo
     2774     field artic           like ub.parts.artic
     2775     field part-code       like ub.parts.part-code
     2776     field obj-code        like ub.clients.obj-code
     2777     field obj-type        like ub.clients.obj-type
     2778     field in-code         like ub.parts.in-code
     2779     field out-code        like ub.parts.out-code
     2780     field prod-code       like ub.parts.prod-code
     2781     field prod-type       like ub.parts.prod-type
     2782     field gds-name        like ub.goods.gds-name
     2783     field fact-qnty       like ub.parts.fact-qnty
     2784     field ms-base         like ub.goods.ms-base
     2785     field fact-date       like ub.parts.fact-date format "99.99.99"
     2786     field out-date        as date format "99.99.99"
     2787     field mark-code       as character
     2788     field list-doc        as character
     2789     field list-date       as character
     2790     field ext-type        as character
     2791     index pi is primary artic part-code obj-code obj-type prod-code prod-type in-code out-code
     2792   .
     2793   define stream out-stream.
     2794   define buffer buf_parts         for ub.parts.
     2795   define buffer buf_goods         for ub.goods.
     2796   define buffer buf_cli-gds       for ub.cli-gds.
     2797   define buffer buf_trn-doc       for ub.trn-doc.
     2798   define buffer buf_temp-gds      for temp-gds.
     2799   define variable v-line                    as  character     no-undo.
     2800   define variable g#report-num              as integer        no-undo .
     2801   define variable counter                   as integer        no-undo .
     2802   define variable vardate                   as date           no-undo .
     2803   define variable v-list-doc                as character      no-undo .
     2804   define variable v-list-date               as character      no-undo .
     2805   define variable v-ext-type                as character      no-undo .
     2806   define variable v-end-fact-order          as decimal        no-undo .
     2807   define variable v-shift-end-fact-order    as decimal        no-undo .
     2808   define variable v-day-end-fact-order      as decimal        no-undo .
     2809   define variable v-obj-code                as integer        no-undo .
     2810   define variable v-doc                     like temp-str.in-code     no-undo.
     2811   define variable v-date                    like temp-str.fact-date   no-undo.
     2812   define variable v-doc-source              as character      no-undo.
     2813   define variable v-date-source             as character      no-undo.
     2814   define variable v-ext-type-source         as character      no-undo.
     2815   define variable v-alc-mark-code           as character      no-undo .
     2816   define variable v-alc-bottling-date       as date           no-undo .
     2817   define variable v-total-qnty              like ub.parts.fact-qnty no-undo.
     2818   define variable v-curr-grp-name           as character      no-undo .
     2819   define variable v-repfrm-title            as character  initial "Формирование отчета по партиям...":U no-undo .
     2820   define variable v-gds-name                as character      no-undo .
     2821   define frame f-doc
     2822     sym1 column-label ":!:!:" format "X(1)" space(0)
     2823     temp-str.artic column-label "Артикул ! ! ":C16 format "X(16)" space(0)
     2824     sym2 column-label ":!:!:" format "X(1)" space(0)
     2825     temp-str.gds-name  column-label "Описание! ! ":C40 format "X(40)" space(0)
     2826     sym3 column-label ":!:!:" format "X(1)" space(0)
     2827     temp-str.fact-qnty column-label "Остаток! ! ":C7 format "->>>>>9" space(0)
     2828     sym4 column-label ":!:!:" format "X(1)" space(0)
     2829     temp-str.out-date column-label "Дата!выпуска! ":C8 format "99.99.99" space(0)
     2830     sym5 column-label ":!:!:" format "X(1)" space(0)
     2831     temp-str.ms-base column-label "Ед. из! ! ":C7 format ">>>9.9<<<" space(0)
     2832     sym6 column-label ":!:!:" format "X(1)" space(0)
     2833     temp-str.obj-code column-label "Код!склада! ":C9 format ">>>>>>>>9" space(0)
     2834     sym7 column-label ":!:!:" format "X(1)" space(0)
     2835     temp-str.fact-date column-label  "Дата!прих.!док.":C8 format "99.99.99" space(0)
     2836     sym8 column-label ":!:!:" format "X(1)" space(0)
     2837     temp-str.in-code column-label "Документ!прихода! ":C14 format "X(14)" space(0)
     2838     sym9 column-label ":!:!:" format "X(1)" space(0)
     2839     temp-str.mark-code column-label "Спецификация!выпуска! " format "X(12)" space(0)
     2840     sym10 column-label ":!:!:" format "X(1)" space(0)
     2841   header
     2842     string( "Страница " + string( PAGE-NUMBER( out-stream ), ">>>9" ) ) at 117 format "X(13)" skip
     2843     v-line format "X(131)" at 1
     2844   with width 136 down stream-io.
     2845   form header
     2846           v-line format "X(131)" at 1 SKIP
     2847           "Продолжение - на следующей странице" at 1 SKIP
     2848   with frame BottomFrame width 136 PAGE-BOTTOM NO-LABELS NO-BOX .
     2849   assign
     2850     v-line = fill( "-" , 300 )
     2851   .
     2852   run get-report-num in my-handle (output g#report-num).
     2853   output stream out-stream to value( string( session:temp-directory +
     2854                                        "rpt" + string( g#report-num ) ) )
     2855                                        page-size 62 .
     2856   view stream out-stream frame BottomFrame .
     2857   run waitfram-show in this-procedure ("Формирование списка товаров...").
     2858   for each temp-gds:
     2859     delete temp-gds.
     2860   end.
     2861   case x-SelectGood :
