     1149   procedure prn-lib-reportviewer :
     1150     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1151     define input parameter p-report-name-html as character no-undo .
     1152     define input parameter p-param        as character no-undo .
     1153     define variable v-excel           as character no-undo init 'TRUE' .
     1154     define variable v-value-character as character no-undo .
     1155     define variable v-value-integer   as character no-undo .
     1156     define variable v-value-date      as date      no-undo .
     1157     define variable v-value-decimal   as decimal   no-undo .
     1158     define variable rep-excel         as logical   no-undo .
     1159     define variable excel-string      as character no-undo .
     1160     define variable v-param-type      as character no-undo .
     1161     define variable v-tth             as handle    no-undo .
     1162     run adm/shattri.p (
     1163       input "get":U
     1164       ,input  ""
     1165       ,input  0
     1166       ,input  'report-glob':U
     1167       ,input  'rep-excel':U
     1168       ,output v-value-character
     1169       ,output v-value-date
     1170       ,output v-value-decimal
     1171       ,output v-value-integer
     1172       ,output rep-excel
     1173       ,output v-param-type
     1174       ,INPUT-OUTPUT table-handle v-tth
     1175       )  .
     1176     if rep-excel then v-excel = "TRUE" .
     1177     else v-excel = "FALSE" .
     1178     if p-param eq ""
     1179     then
     1180        p-param = "EXCEL:" + v-excel.
     1181     else
     1182        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1183     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1184   end procedure.
