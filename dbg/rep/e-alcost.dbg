     1952               vss-workfile vss-revision vss-description skip
     1953               vss-include-info17 skip
     1954               "Невозможно найти gds-obj" skip
     1955               error-status :get-message(1) skip
     1956               return-value skip
     1957               view-as alert-box error .
     1958             undo, return error .
     1959           end.
     1960           find current buf_gds-obj exclusive-lock .
     1961         end.
     1962       end.
