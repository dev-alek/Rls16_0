     1249   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1250   procedure factord :
     1251     define input  parameter p-fact-date            as date    no-undo .
     1252     define input  parameter p-fact-time            as integer no-undo .
     1253     define input  parameter p-fact-num             as integer no-undo .
     1254     define input  parameter p-shift-date           as date    no-undo .
     1255     define input  parameter p-shift-num            as integer no-undo .
     1256     define input  parameter p-shift-on             as logical no-undo .
     1257     define output parameter p-fact-order           as decimal no-undo .
     1258     define output parameter p-shift-end-fact-order as decimal no-undo .
     1259     define output parameter p-day-end-fact-order   as decimal no-undo .
     1260     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1261     if p-fact-date = ?
     1262     then do:
     1263       return error "Не указана фактическая дата" .
     1264     end.
     1265     define variable v-fact-date-num as integer no-undo .
     1266     assign
     1267       v-fact-date-num = integer(p-fact-date)
     1268     .
     1269     if p-fact-num = ?
     1270     or p-fact-num = 0
     1271     then do:
     1272       return error "Не задан p-fact-num " + string(p-fact-num) .
     1273     end.
     1274     if p-fact-num < 0
     1275     then do:
     1276       return error "Отрицательный fact-num " + string(p-fact-num) .
     1277     end.
     1278     if p-fact-num >= 100000000
     1279     then do:
     1280       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1281     end.
     1282     if p-shift-on = true
     1283     then do:
     1284       if p-shift-date = ?
     1285       then do:
     1286         return error "Не задана дата смены" .
     1287       end.
     1288       if p-shift-num = ?
     1289       or p-shift-num = 0
     1290       then do:
     1291         return error "Не задан номер смены" .
     1292       end.
     1293     end.
     1294     else do:
     1295       assign
     1296         p-shift-date = p-fact-date
     1297         p-shift-num  = 24
     1298       .
     1299     end.
     1300     define variable v-shift-offset as integer no-undo .
     1301     if p-shift-date = p-fact-date
     1302     then do:
     1303       assign
     1304         v-shift-offset = 1
     1305       .
     1306     end.
     1307     if p-shift-date < p-fact-date
     1308     then do:
     1309       assign
     1310         v-shift-offset = 0
     1311       .
     1312     end.
     1313     if p-shift-date > p-fact-date
     1314     then do:
     1315       message
     1316         vss-workfile vss-revision vss-description skip
     1317         "Неправильная дата закрытия смены" skip
     1318         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1319         view-as alert-box error .
     1320       undo, return error
     1321         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1322           ,string(p-fact-date, '99/99/9999':U)
     1323           ,string(p-shift-date, '99/99/9999':U)
     1324           )
     1325       .
     1326     end.
     1327     if p-shift-num < 1
     1328     or p-shift-num > 24
     1329     then do:
     1330       message
     1331         vss-workfile vss-revision vss-description skip
     1332         "Неправильный номер смены" skip
     1333         "p-shift-num" p-shift-num skip
     1334         view-as alert-box error .
     1335       undo, return error return-value .
     1336     end.
     1337     assign
     1338       p-fact-order           = v-fact-date-num
     1339                              + v-shift-offset * 0.5
     1340                              + p-shift-num    * 0.02 - 0.01
     1341                              + p-fact-num     * 0.0000000001
     1342       p-shift-end-fact-order = v-fact-date-num
     1343                              + v-shift-offset * 0.5
     1344                              + p-shift-num    * 0.02
     1345       p-day-end-fact-order   = v-fact-date-num
     1346                              + 0.99
     1347     .
     1348     if p-fact-order           <= v-fact-date-num
     1349     or p-shift-end-fact-order <= v-fact-date-num
     1350     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1351     or p-shift-end-fact-order >= p-day-end-fact-order
     1352     then do:
     1353       message
     1354         vss-workfile vss-revision vss-description skip
     1355         "Внутренняя ошибка при генерации фактического номера" skip
     1356         "p-fact-date"            p-fact-date            skip
     1357         "p-fact-time"            p-fact-time            skip
     1358         "p-fact-num"             p-fact-num             skip
     1359         "p-shift-date"           p-shift-date           skip
     1360         "p-shift-num"            p-shift-num            skip
     1361         "p-shift-on"             p-shift-on             skip
     1362         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1363         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1364         "v-fact-date-num"        v-fact-date-num        skip
     1365         view-as alert-box error .
     1366       undo, return error return-value .
     1367     end.
     1368   end procedure.
     1369   procedure day-begin-fact-order :
     1370     define input  parameter p-fact-date            as date    no-undo .
     1371     define output parameter p-day-begin-fact-order as decimal no-undo .
     1372     do
     1373     on error undo, return error return-value
     1374     :
     1375       if p-fact-date = ?
     1376       then do:
     1377         assign
     1378           p-day-begin-fact-order = 0
     1379         .
     1380       end.
     1381       else do:
     1382         assign
     1383           p-day-begin-fact-order = integer(p-fact-date)
     1384         .
     1385       end.
     1386     end.
     1387   end procedure.
     1388   procedure factord-max-fact-order :
     1389     define output parameter p-max-fact-order as decimal   no-undo .
     1390     do
     1391     on error undo, return error return-value
     1392     :
     1393       run day-begin-fact-order in this-procedure
     1394         (input  date(1, 1, 5000)
     1395         ,output p-max-fact-order
     1396         ) .
     1397     end.
     1398   end procedure.
     1399   procedure factord-cut-archive :
     1400     define input  parameter p-obj-type             as character no-undo .
     1401     define input  parameter p-obj-code             as integer   no-undo .
     1402     define input  parameter p-fact-date            as date      no-undo .
     1403     define output parameter p-shift-on             as logical   no-undo .
     1404     define output parameter p-shift-date           as date      no-undo .
     1405     define output parameter p-shift-num            as integer   no-undo .
     1406     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1407     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1408     define variable v-fact-order as decimal   no-undo .
     1409     define buffer buf_shift-obj for ub.shift-obj .
     1410     do
     1411     on error undo, return error return-value
     1412     :
     1413   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1414   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1415     (input  p-obj-type
     1416     ,input  p-obj-code
     1417     ,input  'shift-on=request'
     1418     ,output p-shift-on
     1419     ) no-error .
     1420       if error-status :error
     1421       then do:
     1422         message
     1423           vss-workfile vss-revision vss-description skip
     1424           "Ошибка при определении атрибута объекта" skip
     1425           "Объект" p-obj-type p-obj-code skip
     1426           error-status :get-message(1) skip
     1427           return-value skip
     1428           view-as alert-box error .
     1429         undo, return error return-value .
     1430       end.
     1431       if p-shift-on = false
     1432       then do:
     1433         assign
     1434           p-shift-date               = ?
     1435           p-shift-num                = 0
     1436         .
     1437       end.
     1438       else do:
     1439         find first buf_shift-obj share-lock
     1440           where buf_shift-obj.obj-type   = p-obj-type
     1441             and buf_shift-obj.obj-code   = p-obj-code
     1442             and buf_shift-obj.shift-date > p-fact-date
     1443           use-index pi
     1444           no-error .
     1445         if not available buf_shift-obj
     1446         or buf_shift-obj.status_ <> 'зкр':U
     1447         then do:
     1448           message
     1449             vss-workfile vss-revision vss-description skip
     1450             "Невозможно вычислить последнюю смену" skip
     1451             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1452             "Объект" p-obj-type p-obj-code skip
     1453             "Дата" p-fact-date skip
     1454             view-as alert-box error .
     1455           undo, return error return-value .
     1456         end.
     1457         find last buf_shift-obj share-lock
     1458           where buf_shift-obj.obj-type = p-obj-type
     1459             and buf_shift-obj.obj-code = p-obj-code
     1460             and buf_shift-obj.shift-date <= p-fact-date
     1461           use-index pi
     1462           no-error .
     1463         if available buf_shift-obj
     1464         then do:
     1465           if  buf_shift-obj.status_ = 'зкр':U
     1466           then do:
     1467             assign
     1468               p-shift-date = buf_shift-obj.shift-date
     1469               p-shift-num  = buf_shift-obj.shift-num
     1470             .
     1471           end.
     1472           else do:
     1473             message
     1474               vss-workfile vss-revision vss-description skip
     1475               "Невозможно вычислить последнюю смену" skip
     1476               "Статус смены отличен от статуса" 'зкр':U skip
     1477               "Объект" p-obj-type p-obj-code skip
     1478               "Дата" p-fact-date skip
     1479               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1480               view-as alert-box error .
     1481             undo, return error return-value .
     1482           end.
     1483         end.
     1484         else do:
     1485           assign
     1486             p-shift-date = p-fact-date - 1
     1487             p-shift-num  = 1
     1488           .
     1489         end.
     1490       end.
     1491       run factord in this-procedure
     1492         (input  p-fact-date
     1493         ,input  1
     1494         ,input  1
     1495         ,input  p-shift-date
     1496         ,input  p-shift-num
     1497         ,input  p-shift-on
     1498         ,output v-fact-order
     1499         ,output p-shift-end-fact-order
     1500         ,output p-day-end-fact-order
     1501         ) no-error .
     1502       if error-status :error
     1503       then do:
     1504         message
     1505           vss-workfile vss-revision vss-description skip
     1506           "Ошибка при вызове процедуры factord"
     1507           error-status :get-message(1) skip
     1508           return-value skip
     1509           view-as alert-box error .
     1510         undo, return error return-value .
     1511       end.
     1512     end.
     1513   end procedure.
     1514   procedure factord-lock-shift :
     1515     define input  parameter p-obj-type  as character no-undo .
     1516     define input  parameter p-obj-code  as integer   no-undo .
     1517     define input  parameter p-fact-date as date      no-undo .
     1518     define parameter buffer buf_shift-obj for ub.shift-obj .
     1519     define variable v-shift-on      as logical   no-undo .
     1520     define variable v-extra-message as character no-undo .
     1521     define variable v-error as character no-undo .
     1522     do
     1523     on error undo, return error return-value
     1524     :
     1525   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1526   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1527     (input  p-obj-type
     1528     ,input  p-obj-code
     1529     ,input  'shift-on=request'
     1530     ,output v-shift-on
     1531     ) no-error .
     1532       if error-status :error
     1533       then do:
     1534         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1535         undo, return error v-error .
     1536       end.
     1537       if v-shift-on = true
     1538       then do:
     1539         find first buf_shift-obj share-lock
     1540           where buf_shift-obj.obj-type   = p-obj-type
     1541             and buf_shift-obj.obj-code   = p-obj-code
     1542             and buf_shift-obj.shift-date > p-fact-date
     1543           use-index pi
     1544           no-error .
     1545         if not available buf_shift-obj
     1546         or buf_shift-obj.status_ <> 'зкр':U
     1547         then do:
     1548           find last buf_shift-obj
     1549             where buf_shift-obj.obj-type = p-obj-type
     1550               and buf_shift-obj.obj-code = p-obj-code
     1551               and buf_shift-obj.status_  = 'зкр':U
     1552             use-index stts
     1553             no-error .
     1554           if available buf_shift-obj
     1555           then do:
     1556             assign
     1557               v-extra-message =
     1558                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1559                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1560                               )
     1561             .
     1562           end.
     1563           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1564           undo, return error v-error .
     1565         end.
     1566       end.
     1567     end.
     1568   end procedure.
     1569   procedure factord-end-day :
     1570     define input  parameter p-fact-date            as date    no-undo .
     1571     define output parameter p-day-end-fact-order   as decimal no-undo .
     1572     do
     1573     on error undo, return error return-value
     1574     :
     1575       if p-fact-date = ?
     1576       then do:
     1577         return error "Не указана фактическая дата" .
     1578       end.
     1579       assign
     1580         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1581       .
     1582     end.
     1583   end procedure.
     1584   procedure factord-to-date :
     1585     define input  parameter p-fact-order as decimal no-undo .
     1586     define output parameter p-fact-date  as date    no-undo .
     1587     define variable v-ref-date  as date      no-undo .
     1588     define variable v-ref-delta as integer   no-undo .
     1589     do
     1590     on error undo, return error return-value
     1591     :
     1592       if p-fact-order = ?
     1593       or p-fact-order = 0
     1594       then do:
     1595         return error "Не указан fact-order" .
     1596       end.
     1597       assign
     1598         v-ref-date  = date(1, 1, 2000)
     1599       .
     1600       assign
     1601         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1602       .
     1603       assign
     1604         p-fact-date = v-ref-date + v-ref-delta
     1605       .
     1606     end.
     1607   end procedure.
     1608   procedure factord-to-fact-num :
     1609     define input  parameter p-fact-order as decimal no-undo .
     1610     define output parameter p-fact-num   as integer no-undo .
     1611     define variable v-fact-order-trunc as decimal no-undo .
     1612     do
     1613     on error undo, return error return-value
     1614     :
     1615       if p-fact-order = ?
     1616       or p-fact-order = 0
     1617       then do:
     1618         return error "Не указан fact-order" .
     1619       end.
     1620       assign
     1621        v-fact-order-trunc = truncate(p-fact-order, 2)
     1622       .
     1623       assign
     1624         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1625       .
     1626     end.
     1627   end procedure.
     1628   procedure factord-to-shift-num :
     1629     define input  parameter p-fact-order as decimal no-undo .
     1630     define output parameter p-shift-num   as integer no-undo .
     1631     define variable  p-shift-numd  as decimal   no-undo .
     1632     define variable v-fact-order-trunc as decimal no-undo .
     1633     do
     1634     on error undo, return error return-value
     1635     :
     1636       if p-fact-order = ?
     1637       or p-fact-order = 0
     1638       then do:
     1639         return error "Не указан fact-order" .
     1640       end.
     1641       assign
     1642        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1643       .
     1644       if v-fact-order-trunc < 0.5 then do:
     1645         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1646       end.
     1647       assign
     1648         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1649         .
     1650        assign
     1651         p-shift-num = truncate (p-shift-numd , 0)
     1652       .
     1653     end.
     1654   end procedure.
     1655   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1656   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
     1657   procedure partslib-clear-temp-parts :
     1658     define buffer buf_temp-parts for temp-parts .
     1659     do
     1660     on error undo, return error
     1661     :
     1662       for each buf_temp-parts
     1663       on error undo, return error
     1664       :
     1665         delete buf_temp-parts .
     1666       end.
     1667     end.
     1668   end procedure.
     1669   procedure partslib-create-temp-parts :
     1670     define parameter buffer buf_parts       for ub.parts .
     1671     define parameter buffer buf_temp-parts  for temp-parts .
     1672     define input  parameter p-goods-twounit as logical   no-undo .
     1673     define variable v-base-part-code as character no-undo .
     1674     do
     1675     on error undo, return error
     1676     :
     1677       if p-goods-twounit = true
     1678       then do:
     1679         assign
     1680           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
     1681         .
     1682       end.
     1683       else do:
     1684         assign
     1685           v-base-part-code = buf_parts.part-code
     1686         .
     1687       end.
     1688       find first buf_temp-parts exclusive-lock
     1689         where buf_temp-parts.obj-type  = buf_parts.obj-type
     1690           and buf_temp-parts.obj-code  = buf_parts.obj-code
     1691           and buf_temp-parts.artic     = buf_parts.artic
     1692           and buf_temp-parts.prod-type = buf_parts.prod-type
     1693           and buf_temp-parts.prod-code = buf_parts.prod-code
     1694           and buf_temp-parts.in-code   = buf_parts.in-code
     1695           and buf_temp-parts.out-code  = 'free-zone':U
     1696           and buf_temp-parts.part-code = v-base-part-code
     1697         no-error.
     1698       if not available buf_temp-parts
     1699       then do:
     1700         create buf_temp-parts .
     1701         buffer-copy buf_parts to buf_temp-parts
     1702         assign
     1703           buf_temp-parts.out-code  = 'free-zone':U
     1704           buf_temp-parts.part-code = v-base-part-code
     1705           buf_temp-parts.rsrv-free = yes
     1706           buf_temp-parts.status_   = no
     1707           buf_temp-parts.qnty      = 0
     1708           buf_temp-parts.fact-qnty = 0
     1709           buf_temp-parts.real-qnty = 0
     1710           buf_temp-parts.cli-qnty  = 0
     1711         .
     1712       end.
     1713     end.
     1714   end procedure.
     1715   procedure partslib-init-temp-parts :
     1716     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     1717     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     1718     define input parameter p-artic           like ub.parts.artic     no-undo .
     1719     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     1720     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     1721     define buffer buf_parts      for ub.parts .
     1722     define buffer buf_temp-parts for temp-parts .
     1723     define variable v-goods-twounit    as logical   no-undo .
     1724     do
     1725     on error undo, return error
     1726     :
     1727   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1728   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1729     (input  p-artic
     1730     ,input  p-prod-type
     1731     ,input  p-prod-code
     1732     ,input  'twounit=request':u
     1733     ,output v-goods-twounit
     1734     ) no-error .
     1735       if error-status :error
     1736       then do:
     1737         message
     1738           vss-workfile vss-revision vss-description skip
     1739           vss-include-info17 skip
     1740           "Ошибка при определении атрибута товара" skip
     1741           "Артикул" p-artic p-prod-type p-prod-code skip
     1742           "twounit=request" skip
     1743           error-status :get-message(1) skip
     1744           return-value skip
     1745           view-as alert-box error .
     1746         undo, return error return-value .
     1747       end.
     1748       run partslib-clear-temp-parts in this-procedure .
     1749       for each buf_parts
     1750         where buf_parts.obj-type  = p-obj-type
     1751           and buf_parts.obj-code  = p-obj-code
     1752           and buf_parts.artic     = p-artic
     1753           and buf_parts.prod-type = p-prod-type
     1754           and buf_parts.prod-code = p-prod-code
     1755           and buf_parts.rsrv-free = yes
     1756           and buf_parts.status_   = no
     1757           and buf_parts.in-code   <> buf_parts.out-code
     1758       on error undo, return error
     1759       :
     1760         run partslib-create-temp-parts in this-procedure
     1761           (buffer buf_parts
     1762           ,buffer buf_temp-parts
     1763           ,input  v-goods-twounit
     1764           ) .
     1765         define variable v-parts-qnty          as decimal   no-undo .
     1766         define variable v-parts-cli-qnty      as decimal   no-undo .
     1767         define variable v-parts-free-qnty     as decimal   no-undo .
     1768         define variable v-parts-free-cli-qnty as decimal   no-undo .
     1769         if buf_parts.out-code = 'free-zone':U
     1770         then do:
     1771           assign
     1772             v-parts-qnty          = buf_parts.qnty
     1773             v-parts-cli-qnty      = buf_parts.cli-qnty
     1774             v-parts-free-qnty     = buf_parts.qnty
     1775             v-parts-free-cli-qnty = buf_parts.cli-qnty
     1776           .
     1777         end.
     1778         else do:
     1779           assign
     1780             v-parts-qnty          = abs(buf_parts.qnty)
     1781             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
     1782             v-parts-free-qnty     = 0
     1783             v-parts-free-cli-qnty = 0
     1784           .
     1785         end.
     1786         assign
     1787           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
     1788           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
     1789           buf_temp-parts.real-qnty     = 0
     1790           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
     1791           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
     1792           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
     1793         .
     1794       end.
     1795     end.
     1796   end procedure.
     1797   procedure partslib-init-temp-parts-by-factord :
     1798     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     1799     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     1800     define input parameter p-artic              like ub.parts.artic     no-undo .
