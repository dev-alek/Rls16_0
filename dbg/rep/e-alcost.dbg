      577   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      578     if num-entries(string(p-dec), '.') = 2
      579       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      580       else return( string(p-dec)) .
      581   end function.
      582   function format-point-to-comma returns char (input orig as char ) .
      583   define variable rtext as character no-undo .
      584   define variable strt as integer no-undo .
      585   define variable leng as integer no-undo .
      586   assign rtext = orig .
      587   repeat:
      588     strt =  index(rtext,'.').
      589     if strt = 0 then leave.
      590     leng = 1.
      591     substring(rtext,strt,leng,"character") = v-delim .
      592   end.
      593   return rtext.
      594   end function.
      595   function format-excel-text returns char ( input start-text as char ) :
      596   def var  i    as int no-undo.
      597   def var  ch   as char no-undo.
      598   def var  n    as int no-undo.
      599   def var  ipos as int no-undo.
      600     n = num-entries(trim(start-text), chr(10)) - 1 .
      601     do i = 1 to n :
      602       ipos = index( start-text, chr(10)).
      603       if ipos > 0 then
      604         substr( start-text, ipos, 1 ) = ' '.
      605     end.
      606     n = num-entries(trim(start-text), chr(13)) - 1 .
      607     do i = 1 to n :
      608       ipos = index( start-text, chr(13)).
      609       if ipos > 0 then
      610         substr( start-text, ipos, 1 ) = ' '.
      611     end.
      612     if index( start-text, '"' ) = 0 then
      613       start-text =  '="'   + trim( start-text) + '"'   .
      614       else do:
      615         n = num-entries(trim(start-text), '"') - 1.
      616         do i = 1 to n :
      617           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      618         end.
      619         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      620         start-text = '="'  + ch  + '"' .
      621       end.
      622     return start-text.
      623   end.
      624   function excel-sum returns char (input p-dec as decimal ).
      625     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      626   end function.
      627   function excel-qnty returns char (input p-dec as decimal ).
      628     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      629   end function.
      630   function format-excel-text-macr returns char ( input start-text as char ) :
      631   def var  i    as int no-undo.
      632   def var  ch   as char no-undo.
      633   def var  n    as int no-undo.
      634   def var  ipos as int no-undo.
      635     n = num-entries(trim(start-text), chr(10)) - 1 .
      636     do i = 1 to n :
      637       ipos = index( start-text, chr(10)).
      638       if ipos > 0 then
      639         substring( start-text, ipos , 1 ) = ' '.
      640     end.
      641     n = num-entries(trim(start-text), chr(13)) - 1 .
      642     do i = 1 to n :
      643       ipos = index( start-text, chr(13)).
      644       if ipos > 0 then
      645         substring( start-text, ipos, 1 ) = ' '.
      646     end.
      647     if index( start-text, '"' ) = 0 then
      648       start-text =  '"'   + trim( start-text) + '"'   .
      649       else do:
      650         n = num-entries(trim(start-text), '"') - 1.
      651         do i = 1 to n :
      652           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      653         end.
      654         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      655         start-text = '"'  + ch  + '"' .
      656       end.
      657     n = num-entries(trim(start-text), chr(10)) - 1 .
      658     do i = 1 to n :
      659       ipos = index( start-text, chr(10)).
      660       if ipos > 0 then
      661         substring( start-text, ipos , 1 ) = ' '.
      662     end.
      663       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
      664     return start-text.
      665   end.
      666   define variable vss-include-info8 as character format "X(65)" no-undo
      667   initial "@(#)$Workfile$ $Revision$".
      668   procedure grplib-get-full-name :
      669      define input parameter p-node-code  as integer      no-undo.
      670      define output parameter p-full-name as character    no-undo.
      671      do
      672   on error undo, return error
      673   :
      674       define variable v-upper-code    as integer           no-undo.
      675       define buffer buf_gds-grp       for ub.gds-grp.
      676       define buffer buf_upper_gds-grp for ub.gds-grp.
      677       find first buf_gds-grp no-lock
      678            where buf_gds-grp.node-code = p-node-code
      679       no-error.
      680       if not available buf_gds-grp
      681       then do:
      682           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      683       end.
      684       assign
      685           p-full-name  = ""
      686           v-upper-code = 1
      687       .
      688       do while buf_gds-grp.upper-code <> 0
      689       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      690       :
      691           assign
      692               p-full-name  = buf_gds-grp.node-name
      693                            + (if p-full-name <> "" then chr(47) else "")
      694                            + p-full-name
      695               v-upper-code = buf_gds-grp.upper-code
      696           .
      697           find first buf_gds-grp no-lock
      698                where buf_gds-grp.node-code = v-upper-code
      699           no-error.
      700           if not available buf_gds-grp
      701           then do:
      702               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      703                                   + string( v-upper-code )
      704                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      705           end.
      706       end.
      707       assign
      708       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      709       .
      710   end.
      711   end .
      712   procedure grplib-get-node-from-full-name :
      713   define input parameter p-full-name as character no-undo .
      714   define output parameter p-node-code as integer no-undo .
      715   define variable v-ii as integer no-undo .
      716   define variable v-upper-code as integer no-undo .
      717   define variable v-root-code as integer no-undo .
      718   define variable v-entry as character no-undo .
      719   define buffer buf_gds-grp       for ub.gds-grp.
      720   do
      721   on error undo, return error
      722   :
      723     find first buf_gds-grp no-lock
      724         where buf_gds-grp.upper-code = 0
      725     no-error .
      726     if not available buf_gds-grp
      727     then do:
      728         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      729     end.
      730     else do:
      731       assign
      732       v-root-code = buf_gds-grp.node-code
      733       .
      734     end.
      735     v-upper-code = v-root-code.
      736     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      737       assign
      738       v-entry = entry(v-ii, p-full-name, chr(47)).
      739       if v-entry = '' then leave.
      740       find first buf_gds-grp no-lock where
      741                 buf_gds-grp.node-name = v-entry
      742             and buf_gds-grp.upper-code = v-upper-code
      743             no-error.
      744       if not available buf_gds-grp then do:
      745         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      746       end.
      747       else do:
      748         p-node-code = buf_gds-grp.node-code.
      749         v-upper-code = buf_gds-grp.node-code.
      750       end.
      751     end.
      752   end.
      753   end .
      754   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      755   define variable v-waitfram-action01         as character   no-undo .
      756   define variable v-waitfram-action02         as character   no-undo .
      757   define variable v-waitfram-action03         as character   no-undo .
      758   define variable mWaitFramTextBeg            as character   no-undo.
      759   define variable mWaitFramTextEnd            as character   no-undo.
      760   define variable mWaitFramView               as logical     no-undo.
      761   define variable mWaitProcEvent              as logical     no-undo init yes.
      762   define variable mWaitFramInterval           as integer     no-undo init 1 .
      763   define variable mWaitFramStop               as logical     no-undo.
      764   define variable mWaitFramStopUser           as logical     no-undo.
      765   define variable mWaitFramStopTimeOut        as logical     no-undo.
      766   define variable mWaitFramStartProc          as datetime-tz no-undo.
      767   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      768   define button B-WaitFramStop auto-end-key
      769        label "Стоп"
      770        size 10 by 1 tooltip "Остоновить процесс".
      771   define button B-viewProcInfo
      772        label "Информация"
      773        size 15 by 1 tooltip "Информация о процесс".
      774   define frame waitfram
      775     v-waitfram-action01 format "x(72)" no-label skip
      776     v-waitfram-action02 format "x(72)" no-label skip
      777     v-waitfram-action03 format "x(72)" no-label skip
      778     B-viewProcInfo
      779     B-WaitFramStop at row 4 col 30
      780     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      781     .
      782   define new global shared variable mBatchMode as logical no-undo init ?.
      783   define variable mFramBachModHandle as handle no-undo.
      784   mFramBachModHandle = frame waitfram:handle.
      785   define variable mFameOldVis as logical no-undo.
      786   define variable mVisCUrentVin as logical no-undo.
      787   if session:batch-mode
      788   then
      789      mBatchMode = yes.
      790   if mBatchMode = ? then do:
      791     mVisCUrentVin = current-window:visible.
      792     mFameOldVis = mFramBachModHandle:visible.
      793     mFramBachModHandle:visible  = yes.
      794     mBatchMode = mFramBachModHandle:visible ne yes.
      795     mFramBachModHandle:visible = mFameOldVis.
      796     current-window:visible = mVisCUrentVin.
      797   end.
      798    if  log-manager:logfile-name ne ?
      799     then DO:
      800         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      801         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      802         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      803     end.
      804   on choose of B-WaitFramStop in frame waitfram
      805   do:
      806     mWaitFramStop = yes.
      807     mWaitFramStopUser = yes.
      808   end.
      809   function waitfram-check-timeout returns logical():
      810      define variable vtime as int64 no-undo.
      811      if mWaitFramStopTimeOut
      812      then
      813         return yes.
      814      vtime = ( now - mWaitFramStartProc ) / 1000 .
      815      if     mWaitFramTimeOut ne ?
      816         and mWaitFramTimeOut ne 0
      817         and mWaitFramTimeOut lt vtime
      818      then do:
      819         mWaitFramStopTimeOut = yes.
      820      end.
      821      return mWaitFramStopTimeOut.
      822   end.
      823   procedure waitfram-hide :
      824     if not session:batch-mode
      825     then do
      826     on error undo, return error return-value
      827     :
      828       pause 0 before-hide .
      829       if not mBatchMode then
      830         hide frame waitfram .
      831     if     not mWaitFramView
      832        and mWaitProcEvent
      833     then
      834       process events .
      835     end.
      836   end procedure.
      837   procedure waitfram-show :
      838     define input  parameter p-message as character no-undo .
      839     define variable v-left-margin as integer   no-undo .
      840     if not session:batch-mode
      841     then do
      842     on error undo, return error return-value
      843     :
      844       if length(p-message) <= 70 then do:
      845         assign
      846           v-left-margin = integer((70 - length(p-message)) / 2)
      847         .
      848         assign
      849           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      850         .
      851         assign
      852           v-waitfram-action01 = " "
      853           v-waitfram-action02 = " "
      854                                    + fill(" ", v-left-margin)
      855                                    + p-message
      856           v-waitfram-action03 = " "
      857         .
      858       end.
      859       else do:
      860         define variable vRindex1 as integer no-undo.
      861         define variable vRindex2 as integer no-undo.
      862         vRindex1 = r-index(p-message," ",70).
      863         if vRindex1 = 0
      864         then
      865            vRindex1 = 70.
      866         if length(p-message)  <= vRindex1 + 70 then do:
      867           assign
      868             v-waitfram-action01 = " "
      869             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      870             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      871           .
      872         end.
      873         else do:
      874           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      875           if vRindex2 <= vRindex1
      876           then
      877              vRindex2 = vRindex1 + 70.
      878           assign
      879             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      880             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      881             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      882           .
      883         end.
      884       end.
      885       B-viewProcInfo:visible   in frame waitfram = no.
      886       B-viewProcInfo:sensitive in frame waitfram = no.
      887       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      888       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      889       if  (   mWaitFramView
      890          or  mWaitProcEvent)
      891          and not mBatchMode
      892       then
      893          display
      894             v-waitfram-action01 skip
      895             v-waitfram-action02 skip
      896             v-waitfram-action03 skip
      897          with frame waitfram .
      898       if     mWaitFramView
      899          then do:
      900             if     mWaitFramInterval ne ?
      901                and not mBatchMode
      902             then
      903                wait-for go of frame waitfram pause mWaitFramInterval.
      904          end.
      905          else
      906             if     mWaitProcEvent
      907                and not mBatchMode
      908             then
      909                process events .
      910     end.
      911   end procedure.
      912      procedure waitfram-show-this:
      913         define input  parameter iInterval as int64 no-undo.
      914         define variable vtime as int64 no-undo.
      915         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      916         mWaitFramInterval = iInterval.
      917         run waitfram-show (substitute("&1&2 &3&4" ,
      918                                       mWaitFramTextBeg ,
      919                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      920                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      921                                       mWaitFramTextEnd
      922                                      )
      923                           ).
      924      end.
      925      procedure WaitFramRunPause:
      926         define input  parameter iInterval as dec no-undo.
      927         define variable vStart  as datetime-tz no-undo.
      928         define variable vend    as datetime-tz no-undo.
      929         define variable vint as int64 no-undo.
      930         define variable vOk as logical no-undo.
      931         vStart = now.
      932         vend   = vStart.
      933         publish "WaitFramPause" (iInterval,output vOk).
      934         vend   =  now.
      935         vint = vend - vStart.
      936         vint = iInterval - vint / 1000.
      937         if     not mWaitFramStop
      938            and (   vint > 0
      939                 or (    not vOk
      940                     and iInterval eq ?
      941                     )
      942                 )
      943         then
      944            run waitfram-show-this (iInterval).
      945         vend   =  now.
      946         vint = vend - vStart.
      947         vint = iInterval - vint / 1000.
      948         if     not mWaitFramStop
      949            and vint > 0
      950         then do:
      951            run gbl/pause.p (vint * 1000).
      952         end.
      953         if iInterval ne ?
      954         then
      955            publish "WaitFramStop".
      956         waitfram-check-timeout().
      957      end.
      958      procedure WaitFramWaitFor:
      959         define input  parameter iInterval as dec no-undo.
      960         assign
      961            mWaitFramStartProc   = now
      962            mWaitFramStopUser    = no
      963            mWaitFramStopTimeOut = no
      964         .
      965         block-wait:
      966         do while not mWaitFramStop:
      967            run WaitFramRunPause (iInterval).
      968            if  waitfram-check-timeout()
      969            then do:
      970               leave block-wait.
      971            end.
      972         end.
      973         run waitfram-hide.
      974      end.
      975   procedure waitfram-join :
      976     define input  parameter p-line-1  as character no-undo .
      977     define input  parameter p-line-2  as character no-undo .
      978     define input  parameter p-line-3  as character no-undo .
      979     define output parameter p-message as character no-undo .
      980     do
      981     on error undo, return error return-value
      982     :
      983       assign
      984         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      985                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      986                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      987       .
      988     end.
      989   end procedure.
      990   function waitfram-join-function returns character
      991     (input p-line-1 as character
      992     ,input p-line-2 as character
      993     ,input p-line-3 as character
      994     ).
      995     define variable v-message as character no-undo .
      996     run waitfram-join in this-procedure
      997       (input  p-line-1
      998       ,input  p-line-2
      999       ,input  p-line-3
     1000       ,output v-message
     1001       ) .
     1002     return v-message .
     1003   end function .
     1004   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1005   define  stream PrnLibStream.
     1006   procedure prn-lib-prn-file :
     1007     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1008     define input parameter p-DIsabledoptions as integer no-undo .
     1009     define variable v-report-name as character no-undo .
     1010     define variable v-user-action as character no-undo .
     1011     define variable v-printed     as logical   no-undo .
     1012     define variable v-exist       as logical   no-undo .
     1013     do
     1014       on error undo, return error
     1015       :
     1016       run prn-lib-get-report-name  in this-procedure (
     1017         input parParentProc
     1018         ,output v-report-name
     1019         ).
     1020   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1021   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1022     (input  v-report-name
     1023     ,input  2
     1024     ,output v-exist
     1025     )  .
     1026       if NOT v-exist then
     1027       DO:
     1028         Message
     1029           "Нет заданий на печать ! "
     1030           view-as alert-box .
     1031         Return  .
     1032       End.
     1033       run gbl/prnfilen.w
     1034         (input  ""
     1035         ,input  p-DisabledOptions
     1036         ,input  string(v-report-name )
     1037         ,input  7
     1038         ,output v-user-action
     1039         ,output v-printed
     1040         ) .
     1041       if v-printed then
     1042       do:
     1043         return "YES" .
     1044       end.
     1045       else
     1046       do:
     1047         return "NO" .
     1048       end.
     1049     end.
     1050   end procedure.
     1051   procedure prn-lib-open-stream :
     1052     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1053     define input parameter p-page-size    as integer no-undo .
     1054     define input parameter p-is-stream    as logical no-undo .
     1055     define input parameter p-append       as logical no-undo .
     1056     define variable v-report-name as character no-undo .
     1057     do
     1058       on error undo, return error
     1059       :
     1060       run prn-lib-get-report-name  in this-procedure (
     1061         input parParentProc
     1062         ,output v-report-name
     1063         ).
     1064       if p-is-stream then
     1065       do:
     1066         if p-append then
     1067         do:
     1068           output stream PrnLibStream to value( v-report-name )
     1069             page-size value(p-page-size) append .
     1070         end.
     1071         if not p-append then
     1072         do:
     1073           output stream PrnLibStream to value( v-report-name )
     1074             page-size value(p-page-size) .
     1075         end.
     1076       end.
     1077       if not p-is-stream then
     1078       do:
     1079         if p-append then
     1080         do:
     1081           output to value( v-report-name )
     1082             page-size value(p-page-size) append .
     1083         end.
     1084         if not p-append then
     1085         do:
     1086           output to value( v-report-name )
     1087             page-size value(p-page-size) .
     1088         end.
     1089       end.
     1090     end.
     1091   end procedure.
     1092   procedure prn-lib-open-exp :
     1093     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1094     define input parameter p-is-stream    as logical no-undo .
     1095     define input parameter p-is-append    as logical no-undo .
     1096     define output parameter p-ReportFileName as char init "report" no-undo.
     1097     define output parameter p-process as logical no-undo .
     1098     define variable glog as logical no-undo .
     1099     do
     1100       on error undo, return error
     1101       :
     1102       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1103         TITLE      "Укажите путь"
     1104         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1105         ASK-OVERWRITE
     1106         CREATE-TEST-FILE
     1107         SAVE-AS
     1108         USE-FILENAME
     1109         DEFAULT-EXTENSION "txt"
     1110         UPDATE glog
     1111         .
     1112       if not glog then  return.
     1113       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1114       if p-is-stream then
     1115       do:
     1116         if p-is-append then
     1117         do:
     1118           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1119         end.
     1120         else
     1121         do:
     1122           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1123         end.
     1124       end.
     1125       else
     1126       do:
     1127         if p-is-append then
     1128         do:
     1129           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1130         end.
     1131         else
     1132         do:
     1133           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1134         end.
     1135       end.
     1136       p-process = yes.
     1137     end.
     1138   end procedure.
     1139   procedure prn-lib-get-report-name :
     1140     define input parameter parParentProc  as widget-handle no-undo.
     1141     define output parameter p-report-name as character no-undo .
     1142     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1143   end procedure.
     1144   procedure prn-lib-reportviewer-report-name :
     1145     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1146     define input parameter p-report-name-html as character no-undo .
     1147     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
