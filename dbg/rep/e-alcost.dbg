     1924           vss-workfile vss-revision vss-description skip
     1925           vss-include-info17 skip
     1926           "Ошибка задания входных параметров" skip
     1927           "Начало интервала превышает конец интервала" skip
     1928           "Объект" p-obj-type p-obj-code skip
     1929           "Артикул" p-artic p-prod-type p-prod-code skip
     1930           "p-start-fact-order" p-start-fact-order skip
     1931           "p-end-fact-order"   p-end-fact-order skip
     1932           view-as alert-box error .
     1933         undo, return error .
     1934       end.
     1935       if p-lock-gds-obj = true
     1936       then do:
     1937         do transaction
     1938         on error undo, return error
     1939         :
     1940   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1941   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1942     (input  p-obj-type
