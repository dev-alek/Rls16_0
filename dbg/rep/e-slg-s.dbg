      918   PROCEDURE check-modified :
      919   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      920   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      921   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      922   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      923     IF check-state = "check":U THEN
      924     DO:
      925       RUN get-link-handle IN adm-broker-hdl
      926         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      927            OUTPUT group-target-list).
      928       IF group-target-list NE "":U THEN
      929       DO i = 1 TO NUM-ENTRIES(group-target-list):
      930         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      931         RUN check-modified IN curr-widget ('group-check':U).
      932         IF RETURN-VALUE NE "":U THEN
      933         DO:
      934           RUN check-modified-message(RETURN-VALUE).
      935           RETURN "":U.
      936         END.
      937       END.
      938     END.
      939     RETURN "":U.
      940   END PROCEDURE.
      941   PROCEDURE check-modified-message :
      942     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      943        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      944           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      945        IF RETURN-VALUE = "YES":U THEN
      946           RUN notify ('view,CONTAINER-SOURCE':U).
      947        MESSAGE IF p-changed-table NE ? THEN
      948           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      949           ELSE "Current values have been changed."
      950           SKIP "  Do you wish to save those changes?"
      951           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      952        IF ANS THEN
      953        DO:
      954           IF group-assign-target THEN
      955             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      956           ELSE RUN dispatch('update-record':U).
      957           IF RETURN-VALUE = "ADM-ERROR":U THEN
      958           DO:
      959               MESSAGE "Changes to the previous record were not saved."
      960                 VIEW-AS ALERT-BOX ERROR.
      961               IF group-assign-target THEN
      962                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      963               ELSE RUN dispatch ('cancel-record':U).
      964           END.
      965        END.
      966        ELSE DO:
      967          IF group-assign-target THEN
      968             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      969          ELSE RUN dispatch('cancel-record':U).
      970        END.
      971        RETURN.
      972   END PROCEDURE.
      973   PROCEDURE get-rowid :
      974       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
      975       ASSIGN
      976       p-table   =   adm-first-table.
      977       RETURN.
      978   END PROCEDURE.
      979   PROCEDURE init-group-assign :
      980       RUN request-attribute IN adm-broker-hdl
      981         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
      982       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
      983         group-assign-target = yes.
      984       ELSE group-assign-target = no.
      985       RETURN.
      986   END PROCEDURE.
      987   PROCEDURE set-editors :
      988       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
      989       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
      990       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
      991       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
      992       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
      993       DO WHILE VALID-HANDLE (curr-widget):
      994           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
      995              curr-widget:HIDDEN = no THEN DO:
      996             CASE p-field-setting:
      997               WHEN "INITIALIZE":U THEN
      998               DO:
      999                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1000                     read-only-list +
     1001                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1002                        STRING(curr-widget).
     1003               END.
     1004               WHEN "DISABLE":U OR
     1005               WHEN "ENABLE":U THEN
     1006               DO:
     1007                   curr-widget:SENSITIVE = yes.
     1008                   RUN get-attribute ('Read-Only-Editors':U).
     1009                   IF RETURN-VALUE = ? OR
     1010                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1011                       curr-widget:READ-ONLY =
     1012                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1013               END.
     1014               WHEN "CLEAR":U THEN
     1015                   curr-widget:SCREEN-VALUE = "":U.
     1016             END CASE.
     1017           END.
     1018           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1019       END.
     1020       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1021         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1022           + '"':U).
     1023       RETURN.
     1024   END PROCEDURE.
     1025   PROCEDURE use-check-modified-all :
     1026    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1027     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1028     RETURN.
     1029   END PROCEDURE.
     1030   PROCEDURE use-create-on-add :
     1031   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1032      RETURN.
     1033   END PROCEDURE.
     1034   PROCEDURE use-initial-lock :
     1035     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1036     ASSIGN adm-initial-lock = p-attr-value.
     1037     RETURN.
     1038   END PROCEDURE.
     1039     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1040   ASSIGN
     1041          FRAME F-Main:SCROLLABLE       = FALSE
     1042          FRAME F-Main:HIDDEN           = TRUE.
     1043   ON VALUE-CHANGED OF TOGGLE-1 IN FRAME F-Main
     1044   DO:
     1045     assign TOGGLE-1 .
     1046     if TOGGLE-1 = yes then ENABLE  TOGGLE-2 FILL-IN-3 WITH FRAME F-Main.
     1047     else                   DISABLE TOGGLE-2 FILL-IN-3 WITH FRAME F-Main.
     1048   END.
     1049   if not this-procedure :persistent
     1050   then do:
     1051     message
     1052       vss-workfile vss-revision vss-description skip
     1053       "Ошибка при запуске процедуры" skip
     1054       "Данную процедуру следует запускать только с параметром persistent" skip
     1055       view-as alert-box error .
     1056     undo, return error .
     1057   end.
     1058     assign
     1059       FILL-IN-1 :screen-value in frame F-Main = string(TODAY,"99/99/9999")
     1060       FILL-IN-2 :screen-value in frame F-Main = string(TODAY,"99/99/9999")
     1061     .
     1062   PROCEDURE disable_UI :
     1063     HIDE FRAME F-Main.
     1064     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1065   END PROCEDURE.
     1066   PROCEDURE local-apply-layout :
     1067     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     1068   END PROCEDURE.
     1069   PROCEDURE my-report :
     1070   Assign frame F-Main FILL-IN-1 FILL-IN-2 FILL-IN-3 TOGGLE-1 TOGGLE-2 SumObj ShowNull RADIO-sel .
     1071     define variable date1 as date    no-undo .
     1072     define variable date2 as date    no-undo .
     1073     define variable lavel as integer no-undo .
     1074     if TOGGLE-2 = yes then assign lavel = int ( FILL-IN-3 :screen-value ) .
     1075     else                   assign lavel = -1 .
     1076     assign
     1077       date1 = DATE( FILL-IN-1 :screen-value )
     1078       date2 = DATE( FILL-IN-2 :screen-value )
     1079     .
     1080     if date1 > date2 then  message "Дата начала интервала больше даты конца!"  view-as alert-box.
     1081     else  run rep/r-slg-s.p ( date1, date2, TOGGLE-1, lavel, TOGGLE-3, SumObj, ShowNull, RADIO-sel) .
     1082   END PROCEDURE.
     1083   PROCEDURE my-var :
     1084     Assign frame F-Main FILL-IN-1 FILL-IN-2 FILL-IN-3 TOGGLE-1 TOGGLE-2  TOGGLE-3 .
     1085     Assign
     1086       STR-obj-type = ''
     1087       STR-obj-code = ''
     1088       STR-obj-name = ''
     1089       STR-obj      = ''
     1090     .
     1091     For each obj-list no-lock:
     1092       Assign
     1093         STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     1094         STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     1095         STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     1096         STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ','
     1097       .
     1098     End.
     1099     assign
     1100       str1 = "Сравнительный период с " + String(FILL-IN-1,"99/99/9999") + " по " + String(FILL-IN-2,"99/99/9999")
     1101       str2 =  if TOGGLE-3 = yes then "С учетом возвратов."  else  "Без учета возвратов."
     1102       str3 =  if x-SET_PAY_TYPE = 1 then "В ценах продажи."  else  "В учетных ценах."
     1103     .
     1104   END PROCEDURE.
     1105   PROCEDURE state-changed :
     1106     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1107     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1108     CASE p-state:
     1109       when "link-changed":U then  DO:
     1110            Run my-var.
     1111            End.
     1112     END CASE.
     1113   END PROCEDURE.
