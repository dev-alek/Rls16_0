      763   PROCEDURE dispatch :
      764       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      765       RUN broker-dispatch IN adm-broker-hdl
      766           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      767       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      768   END PROCEDURE.
      769   PROCEDURE ensure-broker :
      770   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      771   IF RETURN-VALUE NE "ADM-Broker":U THEN
      772   DO:
      773       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      774       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      775   END.
      776   END PROCEDURE.
      777   PROCEDURE get-attribute :
      778     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      779     RUN broker-get-attribute IN adm-broker-hdl
      780         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      781     RETURN RETURN-VALUE.
      782   END PROCEDURE.
      783   PROCEDURE get-attribute-list :
      784     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      785     RUN broker-get-attribute-list IN adm-broker-hdl
      786         (INPUT THIS-PROCEDURE,
      787          INPUT ?,
      788          OUTPUT p-attr-list) NO-ERROR.
      789     RETURN.
      790   END PROCEDURE.
      791   PROCEDURE new-state :
      792     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      793     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      794     RETURN.
      795   END PROCEDURE.
      796   PROCEDURE notify :
      797     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      798     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      799     IF RETURN-VALUE = "ADM-ERROR":U THEN
      800         RETURN "ADM-ERROR":U.
      801     RETURN.
      802   END PROCEDURE.
      803   PROCEDURE set-attribute-list :
      804     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      805     RUN ensure-broker.
      806     RUN broker-set-attribute-list IN adm-broker-hdl
      807         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      808     RETURN.
      809   END PROCEDURE.
      810   PROCEDURE set-position :
      811       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      812       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      813       IF VALID-HANDLE(adm-object-hdl) THEN
      814       DO:
      815         ASSIGN adm-object-hdl:ROW    =   p-row
      816                adm-object-hdl:COLUMN =   p-col.
      817       END.
      818       RETURN.
