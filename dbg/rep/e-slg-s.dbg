      695   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      696   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      697   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      698         adm-object-hdl = FRAME F-Main:HANDLE.
      699   RUN ensure-broker.
      700   THIS-PROCEDURE:ADM-DATA =
      701        'ADM1.1~`':U +
      702        'SmartViewer~`':U +
      703        '~`':U +
      704        'NO ~`':U +
      705        '~`':U +
      706        '~`':U +
      707        '~`':U +
      708        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      709           + "~`":U +
      710        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      711        'Record-Source,Record-Target,TableIO-Target~`':U +
      712        '~`':U +
      713        '~`~`~`~`~`~`~`~`~`~`~`':U +
      714        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      715            THEN "^^":U
      716        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      717             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      718   PROCEDURE adm-apply-entry :
      719     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      720   END PROCEDURE.
      721   PROCEDURE adm-destroy :
      722    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      723   END PROCEDURE.
      724   PROCEDURE adm-disable :
      725       DISABLE RECT-6 RECT-5 FILL-IN-1 FILL-IN-2 RADIO-sel SumObj ShowNull TOGGLE-3 TOGGLE-1 WITH FRAME F-Main.
      726       RUN dispatch ('disable-fields':U).
      727       RUN set-attribute-list ('ENABLED=no':U).
      728       RETURN.
      729   END PROCEDURE.
