      690   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      691   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      692   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      693   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
