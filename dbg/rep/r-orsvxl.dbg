     1040   procedure r-orsvxl-init :
     1041     define buffer buf_temp_cell-data for temp_cell-data .
     1042     define buffer buf_usr-flt        for ubflt.usr-flt .
     1043     do
     1044     for buf_temp_cell-data
     1045       , buf_usr-flt
     1046     on error undo, return error
     1047     :
     1048       assign
     1049         v-r-orsvxl-current-data-row = 0
     1050       .
     1051       run gbl/_tmpfile.p
     1052         ( input "xd"
     1053         , input ".txt"
     1054         , output v-r-orsvxl-data-file-name
     1055         ) .
     1056       output stream excel-line to value( v-r-orsvxl-data-file-name ) .
     1057       run gbl/_tmpfile.p
     1058         ( input "xc"
     1059         , input ".txt"
     1060         , output v-r-orsvxl-cell-file-name
     1061         ) .
     1062       output stream excel-cell to value( v-r-orsvxl-cell-file-name ) .
     1063       run r-orsvxl-write-cell-data in this-procedure
     1064         ( input "valutCode":U
     1065         , input "0":U
     1066         ) .
     1067       run r-orsvxl-write-cell-data in this-procedure
     1068         ( input "columnList":U
     1069         , input "Num,Name,artic,locate,EdIzm,Price,ExtraQnty,ExtraSum,MissQnty,MissSum,":U
     1070         +       "LossQnty,LossSum,NormQnty,NormSum,XcalcQnty,XcalcSum,LcalcQnty,LcalcSum":U
     1071         ) .
     1072       run r-orsvxl-write-cell-data in this-procedure
     1073         ( input "columnType":U
     1074         , input "I,S,S,I,S,C,D,C,D,C,D,C,D,C,D,C,D,C":U
     1075         ) .
     1076       run r-orsvxl-write-cell-data in this-procedure
     1077         ( input "columnAmount":U
     1078         , input "18":U
     1079         ) .
     1080     end.
     1081   end procedure.
     1082   procedure r-orsvxl-close :
     1083     do
     1084     on error undo, return error
     1085     :
     1086       output stream excel-line close .
     1087       output stream excel-cell close .
     1088       output to value( string( session :temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append .
     1089       export "exe/t33np_97.xlt":U .
     1090       export "exe/t_97.bas":U .
     1091       export v-r-orsvxl-cell-file-name .
     1092       export v-r-orsvxl-data-file-name .
     1093       output close .
     1094     end.
     1095   end procedure.
     1096   procedure r-orsvxl-write-cell-data :
     1097     define input parameter p-data-key   as character no-undo .
     1098     define input parameter p-data-value as character no-undo .
     1099     define buffer buf_temp_cell-data for temp_cell-data .
     1100     do
     1101     for buf_temp_cell-data
     1102     on error undo, return error
     1103     :
     1104       find first buf_temp_cell-data where
     1105                  buf_temp_cell-data.data-key = p-data-key no-error.
     1106       if not available buf_temp_cell-data
     1107       then do:
     1108         create buf_temp_cell-data .
     1109         assign
     1110           buf_temp_cell-data.data-key = p-data-key
     1111         .
     1112       end.
     1113       assign
     1114         buf_temp_cell-data.data-value = p-data-value
     1115       .
     1116       put stream excel-cell unformatted
     1117         buf_temp_cell-data.data-key   chr(9)
     1118         buf_temp_cell-data.data-value chr(10)
     1119       .
     1120     end.
     1121   end procedure.
