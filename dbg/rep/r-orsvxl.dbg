     1622       ) no-error.
     1623     return ( if error-status :error then '':U else v-qty ) .
     1624   end function.
     1625   function OutSum returns character ( input p-sum  as decimal
     1626                                     , input p-hide as logical ) :
     1627     define variable v-sum as character no-undo .
