     1186         buf_temp_line-data.MissQnty  chr(9)
     1187         buf_temp_line-data.MissSum   chr(9)
     1188         buf_temp_line-data.LossQnty  chr(9)
     1189         buf_temp_line-data.LossSum   chr(9)
