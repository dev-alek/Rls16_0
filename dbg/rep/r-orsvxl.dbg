     1199   procedure r-orsvxl-run-excel :
     1200     define input parameter p-header-filename as character no-undo .
     1201     define input parameter p-data-filename   as character no-undo .
     1202     define variable v-template-file-name as character no-undo .
     1203     define variable v-vb-file-name       as character no-undo .
     1204     define buffer buf_temp-param for temp-param .
     1205     do
     1206     for buf_temp-param
     1207     on error undo, return error
     1208     :
     1209       create buf_temp-param.
     1210       assign
     1211         v-template-file-name = search( "exe/t33np_97.xlt" )
     1212         v-vb-file-name       = search( "exe/t_97.bas" )
     1213       .
     1214       if v-template-file-name = ? or
     1215          v-template-file-name = "":U
     1216       then do:
     1217         message
     1218           "Ошибка имени файла шаблона."
     1219         view-as alert-box error .
     1220       end.
     1221       if v-vb-file-name = ? or
     1222          v-vb-file-name = "":U
     1223       then do:
     1224         message
     1225           "Ошибка имени файла кода обработки."
     1226         view-as alert-box error .
     1227       end.
     1228       run paramls-write in this-procedure
     1229         ( input "template":U
     1230         , input "template-file-name":U
     1231         , input v-template-file-name
     1232         ) .
     1233       run paramls-write in this-procedure
     1234         ( input "template":U
     1235         , input "vb-file-name":U
     1236         , input v-vb-file-name
     1237         ) .
     1238       run paramls-write in this-procedure
     1239         ( input "data":U
     1240         , input "data-header-filename":U
     1241         , input p-header-filename
     1242         ) .
     1243       run paramls-write in this-procedure
     1244         ( input "data":U
     1245         , input "data-filename":U
     1246         , input p-data-filename
     1247         ) .
     1248       run gbl/macroxlt.p
     1249         ( input-output table buf_temp-param
     1250         ) no-error .
     1251       if error-status :error
     1252       then do:
     1253         message vss-workfile skip( 0 ) vss-date skip( 0 ) vss-revision skip( 1 ) vss-description skip( 1 )
     1254                 "Ошибка создания файла Excel."  skip( 0 )
     1255                 return-value                    skip( 0 )
     1256                 trim( error-status :get-message( 1 ) )
     1257                 trim( error-status :get-message( 2 ) )
     1258                 trim( error-status :get-message( 3 ) )
     1259         view-as alert-box error .
     1260         undo, return error .
     1261       end.
     1262     end.
     1263   end procedure.
     1264   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1265   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1266   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     1267   define variable ptrlprop-denstclc      as character no-undo initial 'shft_rvs-inc':U .
     1268   define variable ptrlprop-inpptrl       as character no-undo initial 'weight':U .
     1269   define variable ptrlprop-expptrl       as character no-undo initial 'volume':U .
     1270   define variable ptrlprop-autopump      as logical   no-undo initial false .
     1271   define variable ptrlprop-avtinvpm      as logical   no-undo initial false .
     1272   define variable ptrlprop-rvsnmter      as logical   no-undo initial false .
     1273   define variable ptrlprop-olddens       as logical   no-undo initial false .
     1274   define variable ptrlprop-invclipt      as integer   no-undo initial ? .
     1275   define variable ptrlprop-algrvspt      as integer   no-undo initial 1 .
     1276   define variable ptrlprop-temp-for-pomi as integer   no-undo initial 1 .
     1277   define variable ptrlprop-algoincome as integer no-undo init 0.
     1278   define variable ptrlprop-mand-choice-autocar as logical no-undo init false.
     1279   define variable ptrlprop-Delta-mass-horiz      as character no-undo .
     1280   define variable ptrlprop-Delta-mass-vert       as character no-undo .
     1281   define variable ptrlprop-calc-free-vol as logical no-undo init false.
     1282   define variable ptrlprop-calc-free-vol-sug as logical no-undo init false.
     1283   define variable ptrlprop-trn-reas-sug as logical no-undo init true.
     1284   define variable ptrlprop-rvd-own-nb as logical no-undo init false.
     1285   define variable ptrlprop-qr-scan-time as integer no-undo init 5000 .
     1286   define variable ptrlprop-block-nozzle as logical no-undo init false.
     1287   define variable ptrlprop-timeout-block-nozzle as integer no-undo init 5 .
     1288   define variable ptrlprop-autopump-skip-time as integer no-undo init 0 .
     1289   procedure get-ptrl-prop :
     1290     define input  parameter p-obj-type as character no-undo .
     1291     define input  parameter p-obj-code as integer   no-undo .
     1292     do
     1293     on error  undo, return error substitute( "&1 (get-ptrl-prop). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1294     on stop   undo, return error substitute( "&1 (get-ptrl-prop). stop", vss-workfile )
     1295     on endkey undo, return error substitute( "&1 (get-ptrl-prop). endkey", vss-workfile )
     1296     :
     1297       define variable par-type          as character no-undo.
     1298       define variable v-value-character as character no-undo .
     1299       define variable v-value-date      as date      no-undo .
     1300       define variable v-value-decimal   as decimal   no-undo .
     1301       define variable v-value-integer   as integer   no-undo .
     1302       define variable v-value-logical   as logical   no-undo .
     1303       for each thbjattr_thbj-attr
     1304       :
     1305         delete thbjattr_thbj-attr .
     1306       end.
     1307       run adm/shattri.p
     1308         ( input "get":U
     1309         , input p-obj-type
     1310         , input p-obj-code
     1311         , input 'petrol':U
     1312         , input  ""
     1313         , output v-value-character
     1314         , output v-value-date
     1315         , output v-value-decimal
     1316         , output v-value-integer
     1317         , output v-value-logical
     1318         , output par-type
     1319         , input-output table thbjattr_thbj-attr
     1320         ) no-error .
     1321       for each thbjattr_thbj-attr
     1322       on error undo, return error return-value
     1323       :
     1324         case thbjattr_thbj-attr.prop-code :
     1325           when 'denstclc':U then do:
     1326             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
     1327               assign
     1328                 ptrlprop-denstclc = thbjattr_thbj-attr.property-value-character
     1329               .
     1330             end.
     1331           end.
     1332           when 'expptrl':U then do:
     1333             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
     1334               and thbjattr_thbj-attr.prop-value-type = 'character':U
     1335             then do:
     1336               assign
     1337                 ptrlprop-expptrl = thbjattr_thbj-attr.property-value-character
     1338               .
     1339             end.
     1340           end.
     1341           when 'inpptrl':U then do:
     1342             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
     1343               and thbjattr_thbj-attr.prop-value-type = 'character':U
     1344             then do:
     1345               assign
     1346                 ptrlprop-inpptrl = thbjattr_thbj-attr.property-value-character
     1347               .
     1348             end.
     1349           end.
     1350           when 'autopump':U then do:
     1351             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1352               assign
     1353                 ptrlprop-autopump = thbjattr_thbj-attr.property-value-logical
     1354               .
     1355             end.
     1356           end.
     1357           when 'rvsnmter':U then do:
     1358             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1359               assign
     1360                 ptrlprop-rvsnmter = thbjattr_thbj-attr.property-value-logical
     1361               .
     1362             end.
     1363           end.
     1364           when 'avtinvpm':U then do:
     1365             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1366               assign
     1367                 ptrlprop-avtinvpm = thbjattr_thbj-attr.property-value-logical
     1368               .
     1369             end.
     1370           end.
     1371           when 'invclipt':U then do:
     1372             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     1373               assign
     1374                 ptrlprop-invclipt = thbjattr_thbj-attr.property-value-integer
     1375               .
     1376             end.
     1377           end.
     1378           when 'olddens':U then do:
     1379             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1380               assign
     1381                 ptrlprop-olddens = thbjattr_thbj-attr.property-value-logical
     1382               .
     1383             end.
     1384           end.
     1385           when 'algrvspt':U then do:
     1386             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     1387               assign
