     1657                         , p-rec-invent
     1658                         )
     1659       view-as alert-box error .
     1660       undo, return error .
     1661     end.
     1662     if bf_trn-doc.doc-type     <> 'инв':U or
     1663        bf_trn-doc.ext-doc-type <> 'vt':U
     1664     then do:
     1665       run waitfram-hide in this-procedure .
     1666       message
     1667         'Данная форма только для печати инвентаризации.'
     1668       view-as alert-box error .
     1669       undo, return error .
     1670     end.
     1671     find first bf_rvs-doc no-lock where
     1672                bf_rvs-doc.rvs-code = bf_trn-doc.out-code no-error .
     1673     if not available bf_rvs-doc
     1674     then do:
     1675       run waitfram-hide in this-procedure .
     1676       message substitute( 'Не найдена сверка к документу "&1".'
     1677                         , bf_trn-doc.doc-code
     1678                         )
     1679       view-as alert-box error .
     1680       undo, return error .
     1681     end.
     1682     if bf_rvs-doc.rvs-type <> 'контроль':U
     1683     then do:
     1684       run waitfram-hide in this-procedure .
     1685       message substitute( 'Сверка имеет тип "&1", а должен быть "&2".'
     1686                         , bf_rvs-doc.rvs-type
     1687                         , 'контроль':U
     1688                         )
     1689       view-as alert-box error .
     1690       undo, return error .
     1691     end.
     1692     find first bf_object no-lock where
     1693                bf_object.obj-type = bf_trn-doc.obj-type and
     1694                bf_object.obj-code = bf_trn-doc.obj-code .
     1695   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1696   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
     1697     (input  bf_trn-doc.obj-type
     1698     ,input  bf_trn-doc.obj-code
     1699     ,output p-host-code
     1700     ,output v-host-name
     1701     ) no-error .
