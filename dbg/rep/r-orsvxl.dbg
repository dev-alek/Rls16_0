     1553   FUNCTION MonthNameRusCase RETURNS CHARACTER ( INPUT i-month AS INTEGER, INPUT i-case AS INTEGER ) :
     1554     DEFINE VARIABLE v-name AS CHARACTER NO-UNDO.
     1555     RUN get-month-name-case IN THIS-PROCEDURE ( INPUT i-month, INPUT i-case, OUTPUT v-name ) NO-ERROR.
     1556     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-name ).
     1557   END FUNCTION.
     1558   PROCEDURE get-month-name-case :
     1559     DEFINE  INPUT PARAMETER p-month AS INTEGER   NO-UNDO.
     1560     DEFINE  INPUT PARAMETER p-case  AS INTEGER   NO-UNDO.
     1561     DEFINE OUTPUT PARAMETER p-name  AS CHARACTER NO-UNDO.
     1562     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO EXTENT 6 INITIAL
     1563       [ "Январь,Февраль,Март,Апрель,Май,Июнь,Июль,Август,Сентябрь,Октябрь,Ноябрь,Декабрь",
     1564         "января,февраля,марта,апреля,мая,июня,июля,августа,сентября,октября,ноября,декабря",
     1565         "Январю,Февралю,Марту,Апрелю,Маю,Июню,Июлю,Августу,Сентябрю,Октябрю,Ноябрю,Декабрю",
     1566         "Январь,Февраль,Март,Апрель,Май,Июнь,Июль,Август,Сентябрь,Октябрь,Ноябрь,Декабрь",
     1567         "Январем,Февралем,Мартом,Апрелем,Маем,Июнем,Июлем,Августом,Сентябрем,Октябрем,Ноябрем,Декабрем",
     1568         "Январе,Феврале,Марте,Апреле,Мае,Июне,Июле,Августе,Сентябре,Октябре,Ноябре,Декабре"              ].
     1569     DO ON ERROR UNDO, RETURN ERROR :
     1570       IF p-month < 1 OR p-month > 12 OR
     1571          p-case  < 1 OR p-case  >  6 THEN DO:
     1572         ASSIGN p-name = ?.
     1573       END.                           ELSE DO:
     1574         ASSIGN p-name = ENTRY( p-month, v-list[ p-case ] ).
     1575       END.
     1576     END.
     1577   END PROCEDURE.
     1578   FUNCTION Sparse RETURNS CHARACTER ( INPUT p-instring AS CHARACTER ) :
     1579     DEFINE VARIABLE v-outstring AS CHARACTER NO-UNDO.
     1580     RUN get-sparsed-string IN THIS-PROCEDURE ( INPUT p-instring, OUTPUT v-outstring ) NO-ERROR.
     1581     RETURN ( IF ERROR-STATUS :ERROR THEN p-instring ELSE v-outstring ).
     1582   END FUNCTION.
     1583   PROCEDURE get-sparsed-string :
     1584     DEFINE  INPUT PARAMETER p-instring  AS CHARACTER NO-UNDO.
     1585     DEFINE OUTPUT PARAMETER p-outstring AS CHARACTER NO-UNDO INITIAL "":U.
     1586     DEFINE VARIABLE jj AS INTEGER NO-UNDO.
     1587     DO ON ERROR UNDO, RETURN ERROR :
     1588       DO jj = 1 TO LENGTH( p-instring ) :
     1589         ASSIGN p-outstring = p-outstring + ( IF p-outstring = "":U THEN "":U ELSE " ":U ) + SUBSTRING( p-instring, jj, 1 ).
     1590       END.
     1591       ASSIGN p-outstring = CAPS( TRIM( p-outstring ) ).
     1592     END.
     1593   END PROCEDURE.
     1594   function OutDec returns character ( input p-sum  as decimal
     1595                                     , input p-hide as logical ) :
     1596     define variable v-sum as character no-undo .
     1597     run dec2char in this-procedure
     1598       (  input p-sum
     1599       ,  input p-hide
     1600       , output v-sum
     1601       ) no-error.
     1602     return ( if error-status :error then '':U else v-sum ) .
     1603   end function.
     1604   function CenterLine returns character ( input p-in-string as character
