      929   procedure paramls-write :
      930     define input  parameter p-code     as character no-undo .
      931     define input  parameter p-sub-code as character no-undo .
      932     define input  parameter p-value    as character no-undo .
      933     define buffer buf_temp-param for temp-param .
      934     do
      935     on error undo, return error return-value
      936     :
      937       find first buf_temp-param
      938         where buf_temp-param.param-code     = p-code
      939           and buf_temp-param.param-sub-code = p-sub-code
      940         no-error .
      941       if not available buf_temp-param then do:
      942         create buf_temp-param .
      943         assign
      944           buf_temp-param.param-code     = p-code
      945           buf_temp-param.param-sub-code = p-sub-code
      946         .
      947       end.
      948       assign
      949         buf_temp-param.param-value = p-value
      950       .
      951     end.
      952   end procedure.
      953   procedure paramls-read :
      954     define input  parameter p-code          as character no-undo .
      955     define input  parameter p-sub-code      as character no-undo .
      956     define input  parameter p-default-value as character no-undo .
      957     define output parameter p-value         as character no-undo .
      958     define buffer buf_temp-param for temp-param .
      959     do
      960     on error undo, return error return-value
      961     :
      962       find first buf_temp-param
      963         where buf_temp-param.param-code     = p-code
      964           and buf_temp-param.param-sub-code = p-sub-code
      965         no-error .
      966       if available buf_temp-param then do:
      967         assign
      968           p-value = buf_temp-param.param-value
      969         .
      970       end.
      971       else do:
      972         assign
      973           p-value = p-default-value
      974         .
      975       end.
      976     end.
      977   end procedure.
      978   procedure paramls-append :
      979     define input  parameter p-code     as character no-undo .
      980     define input  parameter p-sub-code as character no-undo .
      981     define input  parameter p-value    as character no-undo .
      982     define buffer buf_temp-param for temp-param .
      983     do
      984     on error undo, return error return-value
      985     :
      986       find first buf_temp-param
      987            where buf_temp-param.param-code     = p-code
      988              and buf_temp-param.param-sub-code = p-sub-code
      989         no-error .
      990       if not available buf_temp-param then do:
      991         create buf_temp-param .
      992         assign
      993           buf_temp-param.param-code     = p-code
      994           buf_temp-param.param-sub-code = p-sub-code
      995           buf_temp-param.param-value    = p-value
      996         .
      997       end.
      998       else do:
      999           assign
     1000               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     1001           .
     1002       end.
     1003     end.
     1004   end procedure.
     1005   define variable vss-include-info5 as character no-undo format "x(65)":U
     1006     initial "@(#)$Workfile$ $Revision$":U .
