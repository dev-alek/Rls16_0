     1438               .
     1439             end.
     1440           end.
     1441           when 'calc-free-vol':U then do:
     1442             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1443               assign
     1444                 ptrlprop-calc-free-vol = thbjattr_thbj-attr.property-value-logical
     1445               .
     1446             end.
