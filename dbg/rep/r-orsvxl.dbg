     1421             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     1422               assign
     1423                 ptrlprop-timeout-block-nozzle = thbjattr_thbj-attr.property-value-integer
     1424               .
     1425             end.
     1426           end.
     1427           when 'Delta-mass-horiz':U then do:
     1428             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
     1429               assign
     1430                 ptrlprop-Delta-mass-horiz = thbjattr_thbj-attr.property-value-character
     1431               .
     1432             end.
     1433           end.
     1434           when 'Delta-mass-vert':U then do:
     1435             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
     1436               assign
