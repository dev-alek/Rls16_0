     1450               assign
     1451                 ptrlprop-calc-free-vol-sug = thbjattr_thbj-attr.property-value-logical
     1452               .
     1453             end.
     1454           end.
     1455           when 'trn-reas-sug':U then do:
     1456             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1457               assign
     1458                 ptrlprop-trn-reas-sug = thbjattr_thbj-attr.property-value-logical
     1459               .
     1460             end.
     1461           end.
     1462                 when 'rvd-own-nb':U then do:
     1463             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1464               assign
     1465                 ptrlprop-rvd-own-nb = thbjattr_thbj-attr.property-value-logical
     1466               .
     1467             end.
     1468           end.
     1469           when 'qr-scan-time':U then do:
     1470             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     1471               assign
     1472                 ptrlprop-qr-scan-time = thbjattr_thbj-attr.property-value-integer
     1473               .
     1474             end.
     1475           end.
     1476           when 'autopump-skip-time':U then do:
     1477             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     1478               assign
     1479                 ptrlprop-autopump-skip-time = thbjattr_thbj-attr.property-value-integer
     1480               .
     1481             end.
     1482           end.
     1483         end case.
     1484         delete thbjattr_thbj-attr .
     1485       end.
     1486     end.
     1487     return .
     1488   end procedure.
