     1773     run r-orsvxl-write-cell-data in this-procedure
     1774       ( input "h_ObjCode":U
     1775       , input trim( string( bf_trn-doc.obj-code, ">>>>>>>>9":U ) )
     1776       ) .
     1777     run r-orsvxl-write-cell-data in this-procedure
     1778       ( input "h_FactDate":U
     1779       , input substitute( 'на "&1" &2 &3 г.'
     1780                         , day( t_inv-date )
     1781                         , MonthNameRusCase( month( t_inv-date ), 2 )
     1782                         , year( t_inv-date )
     1783                         )
     1784       ) .
     1785     assign
     1786       tExtra-qnty = 0.00
     1787       tExtra-sum  = 0.00
     1788       tMiss-qnty  = 0.00
     1789       tMiss-sum   = 0.00
     1790       tLoss-qnty  = 0.00
     1791       tLoss-sum   = 0.00
     1792       tNorm-qnty  = 0.00
     1793       tNorm-sum   = 0.00
     1794       tXcalc-qnty = 0.00
     1795       tXcalc-sum  = 0.00
     1796       tLcalc-qnty = 0.00
     1797       tLcalc-sum  = 0.00
     1798       j_LineCount = 0
     1799     .
     1800     for each  bf_rvs-line no-lock where
     1801               bf_rvs-line.rvs-code = bf_rvs-doc.rvs-code  and
     1802               bf_rvs-line.obj-type = bf_rvs-doc.obj-type  and
     1803               bf_rvs-line.obj-code = bf_rvs-doc.obj-code
     1804       , first bf_goods    no-lock where
     1805               bf_goods.gds-code    = bf_rvs-line.gds-code
     1806      break by bf_rvs-line.gds-code
     1807            by bf_rvs-line.pl-code
     1808     :
     1809       if first-of( bf_rvs-line.gds-code )
     1810       then do:
     1811   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1812   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1813     (input  bf_rvs-line.obj-type
     1814     ,input  bf_rvs-line.obj-code
     1815     ,input  bf_rvs-line.gds-code
     1816     ,input  0
     1817     ,input  bf_trn-doc.fact-order
     1818     ,output v-doc-num
     1819     ,output dprice-sale
     1820     ,output droad-tax
     1821     ,output dexcise
     1822     ) no-error .
     1823         if error-status :error
     1824         then do:
     1825           run waitfram-hide in this-procedure .
     1826           message
     1827             'Не могу определить текущие продажные цены.'
     1828           view-as alert-box error .
     1829           undo, return error .
     1830         end.
     1831       end.
     1832       assign
     1833         dLoss-qnty = 0.00
     1834         invent-fo  = 0.00
     1835       .
     1836       run gdsoattr-value in this-procedure
     1837                         ( input  'normal-wastage-o':U
     1838                          ,input  bf_goods.gds-code
     1839                          ,input  bf_rvs-doc.obj-type
     1840                          ,input  bf_rvs-doc.obj-code
     1841                          ,output v-normal-wastage
     1842                          ,output v-type
     1843                         ) no-error .
     1844       if v-normal-wastage <> 0
     1845         and v-normal-wastage <> ?
     1846       then do:
     1847         if bf_trn-doc.status_ = 'факт':U
     1848         then do:
     1849           find last bf_doc-line no-lock where
     1850                     bf_doc-line.obj-type     = bf_rvs-line.obj-type  and
     1851                     bf_doc-line.obj-code     = bf_rvs-line.obj-code  and
     1852                     bf_doc-line.prod-type    = bf_goods.prod-type    and
     1853                     bf_doc-line.prod-code    = bf_goods.prod-code    and
     1854                     bf_doc-line.artic        = bf_goods.artic        and
     1855                     bf_doc-line.ext-doc-type = 'vt':U          and
     1856                     bf_doc-line.status_      = 'факт':U               and
     1857                     bf_doc-line.fact-order   < bf_trn-doc.fact-order use-index dt-fo no-error .
     1858         end.
     1859         else do:
     1860           find last bf_doc-line no-lock where
     1861                     bf_doc-line.obj-type     = bf_rvs-line.obj-type  and
     1862                     bf_doc-line.obj-code     = bf_rvs-line.obj-code  and
     1863                     bf_doc-line.prod-type    = bf_goods.prod-type    and
     1864                     bf_doc-line.prod-code    = bf_goods.prod-code    and
     1865                     bf_doc-line.artic        = bf_goods.artic        and
     1866                     bf_doc-line.ext-doc-type = 'vt':U          and
     1867                     bf_doc-line.status_      = 'факт':U               use-index dt-fo no-error .
     1868         end.
     1869         if available bf_doc-line
     1870         then do:
     1871           assign
     1872             invent-fo = bf_doc-line.fact-order
     1873           .
     1874         end.
     1875         for each bf_doc-line no-lock
     1876           where ( bf_doc-line.obj-type         = bf_rvs-line.obj-type
     1877                   and bf_doc-line.obj-code     = bf_rvs-line.obj-code
     1878                   and bf_doc-line.prod-type    = bf_goods.prod-type
     1879                   and bf_doc-line.prod-code    = bf_goods.prod-code
     1880                   and bf_doc-line.artic        = bf_goods.artic
     1881                   and bf_doc-line.ext-doc-type = 'ie':U
     1882                   and bf_doc-line.status_      = 'факт':U
     1883                   and bf_doc-line.fact-order   > invent-fo
     1884                   and (not can-find (first buf_sale-doc
     1885                                      where buf_sale-doc.doc-code = bf_doc-line.doc-code
     1886                                        and buf_sale-doc.doc-kind = 'itr':U))
     1887                 ) or
     1888                 ( bf_doc-line.obj-type         = bf_rvs-line.obj-type
     1889                   and bf_doc-line.obj-code     = bf_rvs-line.obj-code
     1890                   and bf_doc-line.prod-type    = bf_goods.prod-type
     1891                   and bf_doc-line.prod-code    = bf_goods.prod-code
     1892                   and bf_doc-line.artic        = bf_goods.artic
     1893                   and bf_doc-line.ext-doc-type = 'ep':U
     1894                   and bf_doc-line.status_      = 'факт':U
     1895                   and bf_doc-line.fact-order   > invent-fo
     1896                 )
     1897         ,first bf_doc-pl no-lock
     1898           where bf_doc-pl.obj-type  = bf_rvs-line.obj-type
     1899             and bf_doc-pl.obj-code  = bf_rvs-line.obj-code
     1900             and bf_doc-pl.pl-code   = bf_rvs-line.pl-code
     1901             and bf_doc-pl.out-code  = bf_doc-line.doc-code
     1902             and bf_doc-pl.gds-code  = bf_rvs-line.gds-code
     1903           use-index pi
     1904         on error undo, return error return-value
     1905         :
     1906           if bf_trn-doc.status_    = 'факт':U
     1907             and bf_trn-doc.fact-order < bf_doc-line.fact-order
     1908           then do:
     1909             leave .
     1910           end.
     1911           if ptrlprop-expptrl = 'volume':U
     1912           then do:
     1913             assign
     1914               dLoss-curr-qnty = bf_doc-pl.fact-qnty
     1915             .
     1916           end.
     1917           else do:
     1918             assign
     1919               dLoss-curr-qnty = bf_doc-pl.cli-fact-qnty
     1920             .
     1921           end.
     1922           assign
     1923             dLoss-curr-qnty = dLoss-curr-qnty * v-normal-wastage * 0.001
     1924           .
     1925           if bf_doc-line.ext-doc-type = 'ie':U then do:
     1926             assign
     1927               dLoss-qnty = dLoss-qnty + dLoss-curr-qnty
     1928             .
     1929           end.
     1930           else do:
     1931             assign
     1932               dLoss-qnty = dLoss-qnty - dLoss-curr-qnty
     1933             .
     1934           end.
     1935         end.
     1936       end.
     1937       if ptrlprop-expptrl = 'volume':U
     1938       then do:
     1939         assign
     1940           v-unit-name = trim( bf_goods.unit-base )
     1941           dcurr-price = dprice-sale
     1942           d_FactRest  = bf_rvs-line.state-measure-qnty + bf_rvs-line.state-add-qnty
     1943           d_BookRest  = bf_rvs-line.system-qnty
     1944         .
     1945       end.
     1946       else do:
     1947         assign
     1948           v-unit-name = trim( bf_goods.unit-cli )
     1949           d_FactRest  = bf_rvs-line.state-measure-cli-qnty + bf_rvs-line.state-add-qnty * bf_rvs-line.state-density
     1950           d_BookRest  = bf_rvs-line.system-cli-qnty
     1951         .
     1952         assign
     1953           prc-density = bf_rvs-line.state-density
     1954         .
     1955         assign
     1956           dcurr-price = dprice-sale / prc-density
     1957         .
     1958       end.
     1959       assign
     1960         dExtra-qnty = ( if d_FactRest > d_BookRest then ( d_FactRest - d_BookRest ) else 0.00 )
     1961         dMiss-qnty  = ( if d_FactRest < d_BookRest then ( d_BookRest - d_FactRest ) else 0.00 )
     1962         dNorm-qnty  = d_FactRest * d_pcnt
     1963         dXcalc-qnty = ( if dExtra-qnty > dNorm-qnty then dExtra-qnty - dNorm-qnty else 0.00 )
     1964         dLcalc-qnty = ( if dMiss-qnty  > dLoss-qnty + dNorm-qnty then dMiss-qnty - ( dLoss-qnty + dNorm-qnty ) else 0.00 )
     1965       .
     1966       if dLcalc-qnty < 0.001 then assign dNorm-qnty  = dNorm-qnty + dLcalc-qnty
     1967                                          dLcalc-qnty = 0.
     1968       assign
     1969         dExtra-sum = dExtra-qnty * dcurr-price
     1970         dMiss-sum  = dMiss-qnty  * dcurr-price
     1971         dLoss-sum  = dLoss-qnty  * dcurr-price
     1972         dNorm-sum  = dNorm-qnty  * dcurr-price
     1973         dXcalc-sum = dXcalc-qnty * dcurr-price
     1974         dLcalc-sum = dLcalc-qnty * dcurr-price
     1975       .
     1976       find first bf_place no-lock where
     1977                  bf_place.obj-type = bf_rvs-line.obj-type and
     1978                  bf_place.obj-code = bf_rvs-line.obj-code and
     1979                  bf_place.pl-code  = bf_rvs-line.pl-code  .
     1980       assign
     1981         j_LineCount = j_LineCount + 1
     1982       .
     1983       put stream s-out unformatted
     1984         string( string( j_LineCount,         ">9":U ),        "x(3)":U  ) + ":" +
     1985         string( bf_goods.gds-name,                            "x(15)":U ) + ":" +
     1986         string( bf_goods.artic,                               "x(7)":U  ) + ":" +
     1987         string( string( bf_rvs-line.pl-code, ">>>>>>>>>>9":U ), "x(11)":U  ) + ":" +
     1988         string( ' ':U + v-unit-name + ' ':U,                  "x(5)":U  ) + ":" +
     1989         string( OutSum( dcurr-price, no  ),                   "x(8)":U  ) + ":" +
     1990         string( OutQty( dExtra-qnty, yes ),                   "x(12)":U ) + ":" +
     1991         string( OutSum( dExtra-sum,  yes ),                   "x(8)":U  ) + ":" +
     1992         string( OutQty( dMiss-qnty,  yes ),                   "x(12)":U ) + ":" +
     1993         string( OutSum( dMiss-sum,   yes ),                   "x(11)":U  ) + ":" +
     1994         '            :        :                     :            :        :                     :            :        :            :        :' +
     1995         string( OutQty( dLoss-qnty,  no  ),                   "x(12)":U ) + ":" +
     1996         string( OutSum( dLoss-sum,   no  ),                   "x(7)":U  ) + ":" +
     1997         string( OutQty( dNorm-qnty,  no  ),                   "x(12)":U ) + ":" +
     1998         string( OutSum( dNorm-sum,   no  ),                   "x(8)":U  ) + ":" +
     1999         string( OutQty( dXcalc-qnty, yes ),                   "x(12)":U ) + ":" +
     2000         string( OutSum( dXcalc-sum,  yes ),                   "x(9)":U  ) + ":" +
     2001         '               :' +
     2002         string( OutQty( dLcalc-qnty, yes ),                   "x(12)":U ) + ":" +
     2003         string( OutSum( dLcalc-sum,  yes ),                   "x(9)":U  ) skip
     2004       .
     2005       run r-orsvxl-write-line-data in this-procedure
     2006         (
     2007           input j_LineCount
     2008         , input bf_goods.gds-name
     2009         , input bf_goods.artic
     2010         , input trim( string( bf_rvs-line.pl-code, ">>>>>>>>>>>9":U ) )
     2011         , input v-unit-name
     2012         , input OutDec( dcurr-price, no  )
     2013         , input OutDec( dExtra-qnty, yes )
     2014         , input OutDec( dExtra-sum,  yes )
     2015         , input OutDec( dMiss-qnty,  yes )
     2016         , input OutDec( dMiss-sum,   yes )
     2017         , input OutDec( dLoss-qnty,  no  )
     2018         , input OutDec( dLoss-sum,   no  )
     2019         , input OutDec( dNorm-qnty,  no  )
     2020         , input OutDec( dNorm-sum,   no  )
     2021         , input OutDec( dXcalc-qnty, yes )
     2022         , input OutDec( dXcalc-sum,  yes )
     2023         , input OutDec( dLcalc-qnty, yes )
     2024         , input OutDec( dLcalc-sum,  yes )
     2025       ) .
     2026       assign
     2027         tExtra-qnty = tExtra-qnty + dExtra-qnty
     2028         tExtra-sum  = tExtra-sum  + dExtra-sum
     2029         tMiss-qnty  = tMiss-qnty  + dMiss-qnty
     2030         tMiss-sum   = tMiss-sum   + dMiss-sum
     2031         tLoss-qnty  = tLoss-qnty  + dLoss-qnty
     2032         tLoss-sum   = tLoss-sum   + dLoss-sum
     2033         tNorm-qnty  = tNorm-qnty  + dNorm-qnty
     2034         tNorm-sum   = tNorm-sum   + dNorm-sum
     2035         tXcalc-qnty = tXcalc-qnty + dXcalc-qnty
     2036         tXcalc-sum  = tXcalc-sum  + dXcalc-sum
     2037         tLcalc-qnty = tLcalc-qnty + dLcalc-qnty
     2038         tLcalc-sum  = tLcalc-sum  + dLcalc-sum
     2039       .
     2040       assign
     2041         xExtra-qnty = xExtra-qnty + dExtra-qnty
     2042         xExtra-sum  = xExtra-sum  + dExtra-sum
     2043         xMiss-qnty  = xMiss-qnty  + dMiss-qnty
     2044         xMiss-sum   = xMiss-sum   + dMiss-sum
     2045         xLoss-qnty  = xLoss-qnty  + dLoss-qnty
     2046         xLoss-sum   = xLoss-sum   + dLoss-sum
     2047         xNorm-qnty  = xNorm-qnty  + dNorm-qnty
     2048         xNorm-sum   = xNorm-sum   + dNorm-sum
     2049         xXcalc-qnty = xXcalc-qnty + dXcalc-qnty
     2050         xXcalc-sum  = xXcalc-sum  + dXcalc-sum
     2051         xLcalc-qnty = xLcalc-qnty + dLcalc-qnty
     2052         xLcalc-sum  = xLcalc-sum  + dLcalc-sum
     2053       .
     2054     end.
     2055     put stream s-out unformatted
     2056       '--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------' skip
     2057       '   : ИТОГО:        :           :       :     :        :' +
     2058       string( OutQty( xExtra-qnty, yes ), "x(12)":U ) + ":" +
     2059       string( OutSum( xExtra-sum,  yes ), "x(8)":U  ) + ":" +
     2060       string( OutQty( xMiss-qnty,  yes ), "x(12)":U ) + ":" +
     2061       string( OutSum( xMiss-sum,   yes ), "x(11)":U  ) + ":" +
     2062       '            :        :                     :            :        :                     :            :        :            :        :' +
     2063       string( OutQty( xLoss-qnty,  no  ), "x(12)":U ) + ":" +
     2064       string( OutSum( xLoss-sum,   no  ), "x(7)":U  ) + ":" +
     2065       string( OutQty( xNorm-qnty,  no  ), "x(12)":U ) + ":" +
     2066       string( OutSum( xNorm-sum,   no  ), "x(8)":U  ) + ":" +
     2067       string( OutQty( xXcalc-qnty, yes ), "x(12)":U ) + ":" +
     2068       string( OutSum( xXcalc-sum,  yes ), "x(9)":U  ) + ":" +
     2069         '               :' +
     2070       string( OutQty( xLcalc-qnty, yes ), "x(12)":U ) + ":" +
     2071       string( OutSum( xLcalc-sum,  yes ), "x(9)":U  )                                                                                                                                                                                                                                                                                                 skip
     2072       '--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------' skip( 2 )
     2073     .
     2074     run r-orsvxl-write-cell-data in this-procedure
     2075       ( input "it_ExtraQnty":U
     2076       , input OutDec( tExtra-qnty, yes )
     2077       ) .
     2078     run r-orsvxl-write-cell-data in this-procedure
     2079       ( input "it_ExtraSum":U
     2080       , input OutDec( tExtra-sum,  yes )
     2081       ) .
     2082     run r-orsvxl-write-cell-data in this-procedure
     2083       ( input "it_MissQnty":U
     2084       , input OutDec( tMiss-qnty,  yes )
     2085       ) .
     2086     run r-orsvxl-write-cell-data in this-procedure
     2087       ( input "it_MissSum":U
     2088       , input OutDec( tMiss-sum,   yes )
     2089       ) .
     2090     run r-orsvxl-write-cell-data in this-procedure
     2091       ( input "it_LossQnty":U
     2092       , input OutDec( tLoss-qnty,  no  )
     2093       ) .
     2094     run r-orsvxl-write-cell-data in this-procedure
     2095       ( input "it_LossSum":U
     2096       , input OutDec( tLoss-sum,   no  )
     2097       ) .
     2098     run r-orsvxl-write-cell-data in this-procedure
     2099       ( input "it_NormQnty":U
     2100       , input OutDec( tNorm-qnty,  no  )
     2101       ) .
     2102     run r-orsvxl-write-cell-data in this-procedure
     2103       ( input "it_NormSum":U
     2104       , input OutDec( tNorm-sum,   no  )
     2105       ) .
     2106     run r-orsvxl-write-cell-data in this-procedure
     2107       ( input "it_XcalcQnty":U
     2108       , input OutDec( tXcalc-qnty, yes )
     2109       ) .
     2110     run r-orsvxl-write-cell-data in this-procedure
     2111       ( input "it_XcalcSum":U
     2112       , input OutDec( tXcalc-sum,  yes )
     2113       ) .
     2114     run r-orsvxl-write-cell-data in this-procedure
     2115       ( input "it_LcalcQnty":U
     2116       , input OutDec( tLcalc-qnty, yes )
     2117       ) .
     2118     run r-orsvxl-write-cell-data in this-procedure
     2119       ( input "it_LcalcSum":U
     2120       , input OutDec( tLcalc-sum,  yes )
     2121       ) .
     2122     put stream s-out unformatted
     2123       '                            '
     2124       'Бухгалтер ______________________________'
     2125       '                                                                                                                   '
     2126       'С результатами сличения ознакомлен ___________________________________________________________' skip
     2127       '                            '
     2128       '           (подпись)                    '
     2129       '                                                                                                                   '
     2130       '                                    (подпись)'                                                  skip
     2131     .
     2132     run waitfram-hide  in this-procedure .
     2133     run r-orsvxl-close in this-procedure .
     2134     output stream s-out close .
     2135   if g#quest-print = false
     2136   then do:
     2137     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     2138                                         7, (if 2 >= 8 then 2 else 0), 0, 0,
     2139                                         OUTPUT g#log ).
     2140   end.
     2141   else do:
     2142     os-command silent
     2143       value( "COPY /b " +
     2144         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     2145         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     2146         string( session:temp-directory) +  "$" + string( g#report-num )
     2147                 ) .
     2148     os-command silent
     2149       value( "COPY /b " +
     2150         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     2151         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     2152         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     2153                 ) .
     2154   end.
     2155   end.
     2156   procedure clc-pcnt :
     2157     define output parameter d-percent as decimal no-undo .
     2158     define variable v-stfactpl  as character no-undo initial "":U .
     2159     define variable v-data-type as character no-undo initial "":U .
     2160     define variable v-update    as logical   no-undo initial yes  .
     2161     define variable v-revision  as logical   no-undo initial no   .
     2162     define variable v-percrev   as decimal   no-undo initial ?    .
     2163     define variable v-auto-tank as logical   no-undo initial no   .
     2164     define variable v-percauto  as decimal   no-undo initial ?    .
     2165     define variable v-inv       as logical   no-undo initial no   .
     2166     define variable v-percinv   as decimal   no-undo initial ?    .
     2167     define variable v-inv-set   as logical   no-undo initial no   .
     2168     do
     2169     on error undo, return error return-value
     2170     :
     2171   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     2172     (input  'stfactpl'
     2173     ,input  0
     2174     ,input  ''
     2175     ,input  0
     2176     ,input  ''
     2177     ,input  ''
     2178     ,input  ''
     2179     ,input  no
     2180     ,output v-stfactpl
     2181     ,output v-data-type
     2182     ) no-error .
     2183       if error-status :error
     2184       then do:
     2185         message "Ошибка при чтении параметра stfactpl." skip( 0 )
     2186                 error-status :get-message( 1 ) skip( 0 )
     2187                 return-value
     2188         view-as alert-box error .
     2189         return error .
     2190       end.
     2191   if (valid-handle(g#lib-calc) <> true) then do:   run str/lib-calc.p persistent no-error .   if error-status :error or (valid-handle(g#lib-calc) <> true) then do:     message       "Error starting lib-calc.p" skip       g#lib-calc skip       g#lib-calc :type skip       g#lib-calc :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-calc_chkqtpl in g#lib-calc
     2192     (  input v-stfactpl
     2193     , output v-update
     2194     , output v-revision
     2195     , output v-percrev
     2196     , output v-auto-tank
     2197     , output v-percauto
     2198     , output v-inv
     2199     , output v-percinv
     2200     , output v-inv-set
     2201     ) no-error .
     2202       if error-status :error
     2203       then do:
     2204         message "Ошибка при проверке параметра stfactpl." skip( 0 )
     2205                 error-status :get-message( 1 ) skip( 0 )
     2206                 return-value
     2207         view-as alert-box error .
     2208         return error .
     2209       end.
     2210       if v-revision = yes
     2211       then do:
     2212         assign
     2213           d-percent = v-percrev * 0.01
     2214         .
     2215       end.
     2216       else
     2217       if v-auto-tank = yes
     2218       then do:
     2219         assign
     2220           d-percent = v-percauto * 0.01
     2221         .
     2222       end.
     2223       else
     2224       if v-inv = yes
     2225       then do:
     2226         assign
     2227           d-percent = v-percinv * 0.01
     2228         .
     2229       end.
     2230       if d-percent < 0.00 or
     2231          d-percent > 1.00
     2232       then do:
     2233         message "Ошибка при вычислении процента отклонения." skip( 0 )
     2234                 "stfactpl:" v-stfactpl skip( 0 )
     2235                 "процент:"  d-percent * 100
     2236         view-as alert-box error .
     2237         return error .
     2238       end.
     2239     end.
     2240   end procedure.
     2241   procedure dec2char :
     2242     define  input parameter p-dec  as decimal   no-undo .
     2243     define  input parameter p-hide as logical   no-undo .
     2244     define output parameter p-char as character no-undo .
     2245     do
     2246     on error undo, return error return-value
     2247     :
     2248       if p-dec  = ?
     2249       then do:
     2250         assign
     2251           p-char = "":U
     2252         .
     2253       end.
     2254       else
     2255       if p-dec  = 0.00 and
     2256          p-hide = yes
     2257       then do:
     2258         assign
     2259           p-char = "":U
     2260         .
     2261       end.
     2262       else do:
     2263         assign
     2264           p-char = trim( string( p-dec,  "->>>>>>>>>>>>>9.9<<<<<<<<<":U ) )
     2265         .
     2266       end.
     2267     end.
     2268   end procedure.
     2269   procedure get-center-line :
     2270     define  input parameter p-in-string  as character no-undo .
     2271     define  input parameter p-rep-width  as integer   no-undo .
     2272     define output parameter p-out-string as character no-undo .
     2273     do
     2274     on error undo, return error return-value
     2275     :
     2276       if length( p-in-string ) < p-rep-width
     2277       then do:
     2278         assign
     2279           p-out-string = fill( ' ':U, integer( ( p-rep-width - length( p-in-string ) ) * 0.5 ) ) + p-in-string
     2280         .
     2281       end.
     2282       else do:
     2283         assign
     2284           p-out-string = p-in-string
     2285         .
     2286       end.
     2287     end.
     2288   end procedure.
     2289   procedure get-dec-string :
     2290     define  input parameter p-dec  as decimal   no-undo .
     2291     define  input parameter p-int  as integer   no-undo .
     2292     define  input parameter p-hide as logical   no-undo .
     2293     define output parameter p-char as character no-undo .
     2294     do
     2295     on error undo, return error return-value
     2296     :
     2297       if p-dec  = ?
     2298       then do:
     2299         assign
     2300           p-char = "":U
     2301         .
     2302       end.
     2303       else
     2304       if p-dec  = 0.00 and
     2305          p-hide = yes
     2306       then do:
     2307         assign
     2308           p-char = "":U
     2309         .
     2310       end.
     2311       else do:
     2312         if p-int = 3
     2313         then do:
     2314           assign
     2315             p-char = trim( string( p-dec, "->>>>>>9.999":U ) )
     2316             p-char = fill( ' ':U, 12 - length( p-char ) ) + p-char
     2317           .
     2318         end.
     2319         else do:
     2320           assign
     2321             p-char = trim( string( p-dec, "->>>>>>9.99":U ) )
     2322             p-char = fill( ' ':U,  8 - length( p-char ) ) + p-char
     2323           .
     2324         end.
     2325       end.
     2326     end.
     2327   end procedure.
