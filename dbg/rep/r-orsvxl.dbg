     1629       (  input p-sum
     1630       ,  input 2
     1631       ,  input p-hide
     1632       , output v-sum
     1633       ) no-error.
     1634     return ( if error-status :error then '':U else v-sum ) .
     1635   end function.
     1636   define stream s-out .
     1637   do
