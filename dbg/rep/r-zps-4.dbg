     4491                                               by ((temp-t-post-stk-line.artic + temp-t-post-stk-line.prod-type + string(temp-t-post-stk-line.prod-code)))
     4492                                               by temp-t-post-stk-line.fact-order :
     4493                                       if first-of( (temp-t-post-stk-line.artic + temp-t-post-stk-line.prod-type + string(temp-t-post-stk-line.prod-code)) ) then do : run goods-start. end .
     4494                                       if last-of ( (temp-t-post-stk-line.artic + temp-t-post-stk-line.prod-type + string(temp-t-post-stk-line.prod-code)) ) then do : run goods-end.
     4495                                          run display-line .
     4496                                       end.
     4497                                       if last-of( (temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code)) ) then do :
     4498                                          run tmp-create (temp-t-post-stk-line.cli-code,
     4499                                                          temp-t-post-stk-line.cli-type,
     4500                                                          temp-t-post-stk-line.clients-obj-name,
     4501                                                          obj-list.obj-code,
     4502                                                          obj-list.obj-type ) .
     4503                                          run tmp-clear.
     4504                                       end.
     4505             end.
     4506          end.
     4507          for each tmp-cli-gds no-lock
     4508              break
     4509              by tmp-cli-gds.name
     4510              by (tmp-cli-gds.cli-type + string(tmp-cli-gds.cli-code)) :
     4511              if first-of(tmp-cli-gds.cli-type + string(tmp-cli-gds.cli-code)) then run tmp-clear.
     4512               run tmp-assign.
     4513              if last-of((tmp-cli-gds.cli-type + string(tmp-cli-gds.cli-code))) then do:
     4514                  run print-footer ( 3 ,tmp-cli-gds.name).
     4515              end.
     4516          end.
     4517   End procedure.
     4518   procedure Goods-start :
     4519   END PROCEDURE.
     4520   procedure Goods-end :
     4521     Find last temp2-post-stk-line  no-lock where
     4522                                       temp2-post-stk-line.artic       =  temp-t-post-stk-line.artic        and
     4523                                       temp2-post-stk-line.prod-type   =  temp-t-post-stk-line.prod-type    and
     4524                                       temp2-post-stk-line.prod-code   =  temp-t-post-stk-line.prod-code    and
     4525                                       temp2-post-stk-line.cli-type    =  temp-t-post-stk-line.cli-type     and
     4526                                       temp2-post-stk-line.cli-code    =  temp-t-post-stk-line.cli-code     and
     4527                                       temp2-post-stk-line.obj-type    =  temp-t-post-stk-line.obj-type     and
     4528                                       temp2-post-stk-line.obj-code    =  temp-t-post-stk-line.obj-code     and
     4529                                       temp2-post-stk-line.fact-order <=  fact-order-2               and
     4530                                       temp2-post-stk-line.sum-type    =  'cost':U                and
     4531                                       temp2-post-stk-line.cat-id      =  '##':U
     4532                                       use-index category no-error .
     4533     Find Last a-post-stk-line  where
     4534         a-post-stk-line.fact-order =  (if avail temp2-post-stk-line then temp2-post-stk-line.fact-order else 0)  and
     4535         a-post-stk-line.cat-id     =  t#cat-id      and
     4536         a-post-stk-line.Sum-type   =  t#sum-type    and
     4537         a-post-stk-line.artic      =  temp-t-post-stk-line.artic       and
     4538         a-post-stk-line.prod-type  =  temp-t-post-stk-line.prod-type   and
     4539         a-post-stk-line.prod-code  =  temp-t-post-stk-line.prod-code   and
     4540         a-post-stk-line.cli-type   =  temp-t-post-stk-line.cli-type  and
     4541         a-post-stk-line.cli-code   =  temp-t-post-stk-line.cli-code  and
     4542         a-post-stk-line.obj-type   =  temp-t-post-stk-line.obj-type  and
     4543         a-post-stk-line.obj-code   =  temp-t-post-stk-line.obj-code
     4544         no-lock use-index category no-error .
     4545   END PROCEDURE.
     4546   PROCEDURE display-line :
     4547    def var xx-typeprice as char no-undo.
     4548    def buffer  b-post-stk-line for ub.stk-supp-line .
     4549     ii = ii + 1.
     4550   If Integer(10) = 0 Then Temp1  = 100  .
     4551                         Else Temp1 = Integer(10) .
     4552        IF ( ii modulo Temp1 = 0 ) AND ( ii >= Temp1 ) then
     4553            RUN waitfram-show( "Обработано строк : " + string( ii )) .
     4554          gds-post-artic     = "" .
     4555          find first ub.ext-artic no-lock where
     4556                 ub.ext-artic.gds-code = temp-t-post-stk-line.gds-code and
     4557                 ub.ext-artic.cli-type = temp-t-post-stk-line.Cli-type and
     4558                 ub.ext-artic.cli-code = temp-t-post-stk-line.Cli-code and
     4559                 ub.ext-artic.status_   =  'тек':U no-error .
     4560          if available ub.ext-artic then do:
     4561               assign
     4562                 gds-post-artic     = ub.ext-artic.ext-artic
     4563               .
     4564          end.
     4565         Assign
     4566             gds-zap-gds-name   = temp-t-post-stk-line.gds-name
     4567             gds-zap-unit-base  = temp-t-post-stk-line.unit-base
     4568             gds-zap-prt-root   = temp-t-post-stk-line.prt-root
     4569             gds-zap-prod-type  = temp-t-post-stk-line.prod-type
     4570             gds-zap-prod-code  = temp-t-post-stk-line.prod-code
     4571             gds-zap-artic      = temp-t-post-stk-line.artic
     4572             gds-zap-grp-name   = temp-t-post-stk-line.Goods-grp-name
     4573             gds-zap-b-code     = temp-t-post-stk-line.gds-code
     4574             gds-zap-type       = temp-t-post-stk-line.gds-type
     4575             pos-cli-type       = temp-t-post-stk-line.Cli-type
     4576             pos-cli-code       = temp-t-post-stk-line.Cli-code
     4577             pos-cli-grp-name   = temp-t-post-stk-line.Clients-grp-name
     4578             gds-zap-qnty       = 0
     4579             gds-zap-price-base = 0
     4580             gds-zap-stoim-base = 0
     4581             gds-zap-Nds        = 0
     4582             gds-zap-Np         = 0 .
     4583              if NOT avail a-post-stk-line then
     4584                     ASSIGN gds-zap-qnty       = 0
     4585                           gds-zap-stoim-base  = 0
     4586                           gds-zap-Nds         = 0
     4587                           gds-zap-Np          = 0.
     4588              else do:
     4589               IF  tPrintRubl  THEN
     4590                     ASSIGN gds-zap-qnty       = a-post-stk-line.fact-qnty
     4591                           gds-zap-stoim-base  = a-post-stk-line.sum-rubl
     4592                           gds-zap-Nds         = a-post-stk-line.VAT-rubl
     4593                           gds-zap-Np          = a-post-stk-line.SLT-rubl   .
     4594                 ELSE
     4595                     ASSIGN gds-zap-qnty       =  a-post-stk-line.fact-qnty
     4596                           gds-zap-stoim-base  =  a-post-stk-line.sum-base
     4597                           gds-zap-Nds         =  a-post-stk-line.VAT-base
     4598                           gds-zap-Np          =  a-post-stk-line.SLT-base .
     4599              end.
     4600             IF PayType = 1 then do:
     4601                find last ub.stk-line where
     4602                                            ub.stk-line.fact-order <= fact-order-2 and
     4603                                            ub.stk-line.cat-id     = '##,##':U             and
     4604                                            ub.stk-line.Sum-type   = 'crsa':U                and
     4605                                            ub.stk-line.artic      = temp-t-post-stk-line.artic        and
     4606                                            ub.stk-line.prod-type  = temp-t-post-stk-line.prod-type    and
     4607                                            ub.stk-line.prod-code  = temp-t-post-stk-line.prod-code    and
     4608                                            ub.stk-line.obj-type   = temp-t-post-stk-line.obj-type     and
     4609                                            ub.stk-line.obj-code   = temp-t-post-stk-line.obj-code
     4610                                            no-lock  no-error .
     4611                     if avail ub.stk-line then do:
     4612                         IF  tPrintRubl  THEN
     4613                              ASSIGN
     4614                                     gds-zap-stoim-base  =  ub.stk-line.sum-rubl * (gds-zap-qnty / ub.stk-line.fact-qnty)
     4615                                     gds-zap-Nds         =  ub.stk-line.VAT-rubl * (gds-zap-qnty / ub.stk-line.fact-qnty)
     4616                                     gds-zap-Np          =  ub.stk-line.SLT-rubl * (gds-zap-qnty / ub.stk-line.fact-qnty)           .
     4617                           ELSE
     4618                              ASSIGN
     4619                                     gds-zap-stoim-base  =  ub.stk-line.sum-base * (gds-zap-qnty / ub.stk-line.fact-qnty)
     4620                                     gds-zap-Nds         =  ub.stk-line.VAT-base * (gds-zap-qnty / ub.stk-line.fact-qnty)
     4621                                     gds-zap-Np          =  ub.stk-line.SLT-base * (gds-zap-qnty / ub.stk-line.fact-qnty) .
     4622                     End.
     4623                     Else
     4624                       ASSIGN
     4625                             gds-zap-stoim-base  = 0
     4626                             gds-zap-Nds         = 0
     4627                             gds-zap-Np          = 0 .
     4628                        Assign gds-zap-stoim-base  = if gds-zap-stoim-base <> ? then gds-zap-stoim-base   else 0
     4629                               gds-zap-Nds         = if gds-zap-Nds        <> ? then gds-zap-Nds          else 0
     4630                               gds-zap-Np          = if gds-zap-Np         <> ? then gds-zap-Np           else 0 .
     4631               End.
     4632           Assign
     4633             gds-zap-price-base = if (gds-zap-qnty <> 0) Then (gds-zap-stoim-base / gds-zap-qnty) Else 0
     4634             tot_tqnty          = gds-zap-stoim-base - gds-zap-Nds.
     4635          IF  NOT (NOT Show-Negativ  AND (gds-zap-qnty = 0 and gds-zap-stoim-base = 0)) then DO:
     4636           IF NOT Sums-Only then DO:
     4637                i = i + 1.
     4638                DISPLAY stream  OutStream
     4639                                 gds-zap-b-code
     4640                                 gds-zap-artic
     4641                                 gds-post-artic
     4642                                 gds-zap-gds-name
     4643                                 gds-zap-unit-base
     4644                                 gds-zap-qnty
     4645                                 gds-zap-price-base
     4646                                 gds-zap-stoim-base
     4647                                 gds-zap-Nds
     4648                                 gds-zap-Np
     4649                                 tot_tqnty
     4650                                 with FRAME  zapas    .
     4651               DOWN stream  OutStream 1 with FRAME zapas    .
     4652               if Make-Excel then  put   stream ForExcel unformatted
     4653                 gds-zap-b-code     CHR(9)
     4654                 gds-zap-artic      CHR(9)
     4655                 gds-post-artic      CHR(9)
     4656                 gds-zap-gds-name   CHR(9)
     4657                 gds-zap-unit-base  CHR(9)
     4658                 excel-qnty(gds-zap-qnty)      CHR(9)
     4659                 excel-sum(gds-zap-price-base) CHR(9)
     4660                 excel-sum(gds-zap-stoim-base) CHR(9)
     4661                 excel-sum(gds-zap-Nds)        CHR(9)
     4662                 excel-sum(gds-zap-Np )        CHR(9)
     4663                 excel-sum(tot_tqnty  )         skip.
     4664          End.
     4665               Assign TOT-1   = tot-1   + gds-zap-qnty                TOT-3-1 = tot-3-1 + gds-zap-qnty        TOT-0-1 = tot-0-1 + gds-zap-qnty
     4666                      TOT-2   = tot-2   + gds-zap-stoim-base          TOT-3-2 = tot-3-2 + gds-zap-stoim-base  TOT-0-2 = tot-0-2 + gds-zap-stoim-base
     4667                      TOT-3   = tot-3   + tot_tqnty                   TOT-3-3 = tot-3-3 + tot_tqnty           TOT-0-3 = tot-0-3 + tot_tqnty
     4668                      TOT-4   = tot-4   + gds-zap-Nds                 TOT-3-4 = tot-3-4 + gds-zap-Nds         TOT-0-4 = tot-0-4 + gds-zap-Nds
     4669                      TOT-5   = tot-5   + gds-zap-Np                  TOT-3-5 = tot-3-5 + gds-zap-Np          TOT-0-5 = tot-0-5 + gds-zap-Np
     4670                      TOT-1-1 = tot-1-1 + gds-zap-qnty                TOT-2-1 = tot-2-1 + gds-zap-qnty
     4671                      TOT-1-2 = tot-1-2 + gds-zap-stoim-base          TOT-2-2 = tot-2-2 + gds-zap-stoim-base
     4672                      TOT-1-3 = tot-1-3 + tot_tqnty                   TOT-2-3 = tot-2-3 + tot_tqnty
     4673                      TOT-1-4 = tot-1-4 + gds-zap-Nds                 TOT-2-4 = tot-2-4 + gds-zap-Nds
     4674                      TOT-1-5 = tot-1-5 + gds-zap-Np                  TOT-2-5 = tot-2-5 + gds-zap-Np
     4675                      .
     4676         END.
     4677   END PROCEDURE.
     4678   Procedure Print-Footer :
     4679   define input parameter Nx as integer no-undo .
     4680   define input parameter Name as char no-undo .
     4681   if Nx = 1 Then DO:
     4682                DISPLAY stream  OutStream
     4683                              "Итого по : "  @ gds-zap-artic
     4684                              trim(Name)  @ gds-zap-gds-name
     4685                              Tot-1-1  @ gds-zap-qnty
     4686                              Tot-1-2  @ gds-zap-stoim-base
     4687                              Tot-1-4  @ gds-zap-Nds
     4688                              Tot-1-5  @ gds-zap-Np
     4689                              Tot-1-3  @ tot_tqnty
     4690                                 with FRAME  zapas    .
     4691               DOWN stream  OutStream 1 with FRAME zapas    .
     4692             if Make-Excel then  put   stream ForExcel unformatted  "Итого по : " + trim(Name)
     4693                 CHR(9) CHR(9) CHR(9) CHR(9)
     4694                  CHR(9)
     4695                 excel-qnty(Tot-1-1)         CHR(9)
     4696                                             CHR(9)
     4697                 excel-qnty(Tot-1-2) CHR(9)
     4698                 excel-sum(Tot-1-4)  CHR(9)
     4699                 excel-sum(Tot-1-5)  CHR(9)
     4700                 excel-sum(Tot-1-3)  skip
     4701                   .
     4702               IF NOT Sums-Only THEN Run U-LINE.
     4703                   Assign
     4704                     Tot-1-1 = 0
     4705                     Tot-1-2 = 0
     4706                     Tot-1-3 = 0
     4707                     Tot-1-4 = 0
     4708                     Tot-1-5 = 0 .
     4709             End.
     4710   if Nx = 2 Then DO:
     4711                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11
     4712                              "Итого по : " + trim(Name)  @ gds-zap-gds-name
     4713                              Tot-2-1  @ gds-zap-qnty
     4714                              Tot-2-2  @ gds-zap-stoim-base
     4715                              Tot-2-4  @ gds-zap-Nds
     4716                              Tot-2-5  @ gds-zap-Np
     4717                              Tot-2-3  @ tot_tqnty
     4718                                 with FRAME  zapas    .
     4719           DOWN stream  OutStream 1 with FRAME zapas    .
     4720           if Make-Excel then  put   stream ForExcel unformatted  " "  CHR(9)
     4721                 "Итого по : " + trim(Name)
     4722               CHR(9) CHR(9) CHR(9)   CHR(9)
     4723               excel-qnty(Tot-2-1)  CHR(9) CHR(9)
     4724               excel-sum( Tot-2-2)     CHR(9)
     4725               excel-sum(Tot-2-4)     CHR(9)
     4726               excel-sum(Tot-2-5)     CHR(9)
     4727               excel-sum(Tot-2-3)     skip .
     4728             IF NOT Sums-Only THEN Run U-LINE.
     4729                 Assign
     4730                   Tot-2-1 = 0
     4731                   Tot-2-2 = 0
     4732                   Tot-2-3 = 0
     4733                   Tot-2-4 = 0
     4734                   Tot-2-5 = 0 .
     4735           End.
     4736   if Nx = 3 Then DO:
     4737        IF  ( Show-Negativ = no  AND ( Tot-3-1  = 0 and  Tot-3-2 = 0)) then next.
     4738                DISPLAY stream  OutStream
     4739                              "Итого по пост-ку" @ gds-zap-artic
     4740                              trim(Name)  @ gds-zap-gds-name
     4741                              Tot-3-1  @ gds-zap-qnty
     4742                              Tot-3-2  @ gds-zap-stoim-base
     4743                              Tot-3-4  @ gds-zap-Nds
     4744                              Tot-3-5  @ gds-zap-Np
     4745                              Tot-3-3  @ tot_tqnty
     4746                                 with FRAME  zapas    .
     4747           DOWN stream  OutStream 1 with FRAME zapas    .
     4748             if Make-Excel then  put   stream ForExcel unformatted " "  CHR(9) "Итого" CHR(9)
     4749                   "по пост-ку " + trim(Name)
     4750                  CHR(9) CHR(9) CHR(9)
     4751                 excel-qnty(Tot-3-1)  CHR(9) CHR(9)
     4752                 excel-sum( Tot-3-2)       CHR(9)
     4753                 excel-sum(Tot-3-4 )       CHR(9)
     4754                 excel-sum( Tot-3-5)       CHR(9)
     4755                 excel-sum(Tot-3-3)        skip .
     4756               IF NOT Sums-Only THEN Run U-LINE.
     4757                   Assign
     4758                     Tot-3-1 = 0
     4759                     Tot-3-2 = 0
     4760                     Tot-3-3 = 0
     4761                     Tot-3-4 = 0
     4762                     Tot-3-5 = 0 .
     4763             end.
     4764   if Nx = 0 Then DO:
     4765                DISPLAY stream  OutStream
     4766                              "Итого  объект: "  @ gds-zap-artic
     4767                              trim(Name)  @ gds-zap-gds-name
     4768                              Tot-0-1  @ gds-zap-qnty
     4769                              Tot-0-2  @ gds-zap-stoim-base
     4770                              Tot-0-4  @ gds-zap-Nds
     4771                              Tot-0-5  @ gds-zap-Np
     4772                              Tot-0-3  @ tot_tqnty
     4773                                 with FRAME  zapas    .
     4774               DOWN stream  OutStream 1 with FRAME zapas    .
     4775             if Make-Excel then  put   stream ForExcel unformatted  "Итого по объекту: " + trim(Name)
     4776                 CHR(9) CHR(9) CHR(9) CHR(9)   CHR(9)
     4777                 excel-qnty(Tot-0-1)          CHR(9)
     4778                                                        CHR(9)
     4779                 excel-sum(Tot-0-2 )    CHR(9)
     4780                 excel-sum(Tot-0-4 )   CHR(9)
     4781                 excel-sum(Tot-0-5 )   CHR(9)
     4782                 excel-sum(Tot-0-3 )   skip
     4783                   .
     4784               IF NOT Sums-Only THEN Run U-LINE.
     4785                   Assign
     4786                     Tot-0-1 = 0
     4787                     Tot-0-2 = 0
     4788                     Tot-0-3 = 0
     4789                     Tot-0-4 = 0
     4790                     Tot-0-5 = 0 .
     4791             End.
     4792    END PROCEDURE.
     4793   PROCEDURE U-LINE :
     4794    UNDERLINE stream OutStream
     4795       sym1
     4796       gds-zap-b-code
     4797       sym2
     4798       gds-zap-artic
     4799       sym3
     4800       gds-post-artic
     4801       sym12
     4802       gds-zap-gds-name
     4803       sym4
     4804       gds-zap-unit-base
     4805       sym5
     4806       gds-zap-qnty
     4807       sym6
     4808       gds-zap-price-base
     4809       sym7
     4810       gds-zap-stoim-base
     4811       sym8
     4812       gds-zap-Nds
     4813       sym9
     4814       gds-zap-NP
     4815       sym10
     4816       tot_tqnty
     4817       sym11
     4818     with FRAME zapas .
     4819     DOWN stream  OutStream 1 with FRAME zapas.
     4820   END PROCEDURE.
     4821   Procedure Tmp-create :
     4822   define input parameter p1   like ub.clients.obj-code  no-undo .
     4823   define input parameter p2   like ub.clients.obj-type  no-undo .
     4824   define input parameter Name like ub.clients.obj-name  no-undo .
     4825   define input parameter p3   like obj-list.obj-code no-undo .
     4826   define input parameter p4   like obj-list.obj-type no-undo .
     4827     Create tmp-cli-gds.
     4828     Assign
     4829         tmp-cli-gds.Tot-3-1  = Tot-3-1
     4830         tmp-cli-gds.Tot-3-2  = Tot-3-2
     4831         tmp-cli-gds.Tot-3-4  = Tot-3-4
     4832         tmp-cli-gds.Tot-3-5  = Tot-3-5
     4833         tmp-cli-gds.Tot-3-3  = Tot-3-3
     4834         tmp-cli-gds.cli-code = p1
     4835         tmp-cli-gds.cli-type = p2
     4836         tmp-cli-gds.Name     = Name
     4837         tmp-cli-gds.obj-code = p3
     4838         tmp-cli-gds.obj-type = p4
     4839         .
     4840    END PROCEDURE.
     4841   Procedure Tmp-clear :
     4842    Assign
     4843       Tot-3-1 = 0
     4844       Tot-3-2 = 0
     4845       Tot-3-4 = 0
     4846       Tot-3-5 = 0
     4847       Tot-3-3 = 0
     4848       .
     4849   END PROCEDURE.
     4850   Procedure Tmp-assign :
     4851    Assign
     4852       Tot-3-1 = Tot-3-1 + tmp-cli-gds.Tot-3-1
     4853       Tot-3-2 = Tot-3-2 + tmp-cli-gds.Tot-3-2
     4854       Tot-3-4 = Tot-3-4 + tmp-cli-gds.Tot-3-4
     4855       Tot-3-5 = Tot-3-5 + tmp-cli-gds.Tot-3-5
     4856       Tot-3-3 = Tot-3-3 + tmp-cli-gds.Tot-3-3
     4857       .
     4858   END PROCEDURE.
