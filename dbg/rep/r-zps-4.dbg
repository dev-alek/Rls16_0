     1172   procedure create-temp-t-post-stk-line :
     1173       define variable str  as char      format "X(60)" no-undo.
     1174       define variable str2 as char      no-undo.
     1175       define variable v-r  as character no-undo init "" .
     1176       define variable i#i  as int       no-undo.
     1177    do
     1178    on error undo, return error return-value
     1179    :
     1180    if available ub.goods and
     1181       available ub.clients and
     1182       available prod-cli then do:
     1183     create temp-t-post-stk-line .
     1184     BUFFER-COPY post-stk-line  TO temp-t-post-stk-line
     1185     assign
     1186       temp-t-post-stk-line.goods-grp-name    = ub.goods.grp-name
     1187       temp-t-post-stk-line.gds-code          = ub.goods.gds-code
     1188       temp-t-post-stk-line.unit-base         = ub.goods.unit-base
     1189       temp-t-post-stk-line.prt-root          = ub.goods.prt-root
     1190       temp-t-post-stk-line.gds-type          = ub.goods.gds-type
     1191       temp-t-post-stk-line.gds-name          = if g#gds-engl then ub.goods.engl-name else ub.goods.gds-name
     1192       temp-t-post-stk-line.clients-grp-name  = ub.clients.grp-name
     1193       temp-t-post-stk-line.clients-obj-name  = ub.clients.obj-name
     1194       temp-t-post-stk-line.prod-cli-obj-name = prod-cli.obj-name
     1195       temp-t-post-stk-line.prod-cli-obj-code = prod-cli.obj-code
     1196       temp-t-post-stk-line.prod-cli-obj-type = prod-cli.obj-type
     1197     .
     1198               if xlavel > 0 then
     1199               do:
     1200                   repeat i#i =1 to xlavel:
     1201                       if i#i =1 then str   = entry(1,ub.goods.grp-name, chr(47)) .
     1202                       else
     1203                       do:
     1204                           str2 = entry(i#i,ub.goods.grp-name, chr(47)) no-error.
     1205                           if not error-status:error  and str2 <> "":u then
     1206                               str = str +  chr(47) +  entry(i#i,ub.goods.grp-name, chr(47)) no-error .
     1207                       end.
     1208                   end.
     1209                   if str <> ? then
     1210                   do:
     1211                       temp-t-post-stk-line.goods-grp-name = str + chr(47) .
     1212                   end.
     1213               end.
     1214               else
     1215               do :
     1216                   temp-t-post-stk-line.goods-grp-name = ub.goods.grp-name.
     1217               end.
     1218           end.
     1219    end.
     1220   end procedure.
     1221   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     1222     if num-entries(string(p-dec), '.') = 2
     1223       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     1224       else return( string(p-dec)) .
     1225   end function.
     1226   function format-point-to-comma returns char (input orig as char ) .
     1227   define variable rtext as character no-undo .
     1228   define variable strt as integer no-undo .
     1229   define variable leng as integer no-undo .
     1230   assign rtext = orig .
     1231   repeat:
     1232     strt =  index(rtext,'.').
     1233     if strt = 0 then leave.
     1234     leng = 1.
     1235     substring(rtext,strt,leng,"character") = v-delim .
     1236   end.
     1237   return rtext.
     1238   end function.
     1239   function format-excel-text returns char ( input start-text as char ) :
     1240   def var  i    as int no-undo.
     1241   def var  ch   as char no-undo.
     1242   def var  n    as int no-undo.
     1243   def var  ipos as int no-undo.
     1244     n = num-entries(trim(start-text), chr(10)) - 1 .
     1245     do i = 1 to n :
     1246       ipos = index( start-text, chr(10)).
     1247       if ipos > 0 then
     1248         substr( start-text, ipos, 1 ) = ' '.
     1249     end.
     1250     n = num-entries(trim(start-text), chr(13)) - 1 .
     1251     do i = 1 to n :
     1252       ipos = index( start-text, chr(13)).
     1253       if ipos > 0 then
     1254         substr( start-text, ipos, 1 ) = ' '.
     1255     end.
     1256     if index( start-text, '"' ) = 0 then
     1257       start-text =  '="'   + trim( start-text) + '"'   .
     1258       else do:
     1259         n = num-entries(trim(start-text), '"') - 1.
     1260         do i = 1 to n :
     1261           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1262         end.
     1263         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1264         start-text = '="'  + ch  + '"' .
     1265       end.
     1266     return start-text.
     1267   end.
     1268   function excel-sum returns char (input p-dec as decimal ).
     1269     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     1270   end function.
     1271   function excel-qnty returns char (input p-dec as decimal ).
     1272     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     1273   end function.
     1274   function format-excel-text-macr returns char ( input start-text as char ) :
     1275   def var  i    as int no-undo.
     1276   def var  ch   as char no-undo.
     1277   def var  n    as int no-undo.
     1278   def var  ipos as int no-undo.
     1279     n = num-entries(trim(start-text), chr(10)) - 1 .
     1280     do i = 1 to n :
     1281       ipos = index( start-text, chr(10)).
     1282       if ipos > 0 then
     1283         substring( start-text, ipos , 1 ) = ' '.
     1284     end.
     1285     n = num-entries(trim(start-text), chr(13)) - 1 .
     1286     do i = 1 to n :
     1287       ipos = index( start-text, chr(13)).
     1288       if ipos > 0 then
     1289         substring( start-text, ipos, 1 ) = ' '.
     1290     end.
     1291     if index( start-text, '"' ) = 0 then
     1292       start-text =  '"'   + trim( start-text) + '"'   .
     1293       else do:
     1294         n = num-entries(trim(start-text), '"') - 1.
     1295         do i = 1 to n :
     1296           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1297         end.
     1298         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1299         start-text = '"'  + ch  + '"' .
     1300       end.
     1301     n = num-entries(trim(start-text), chr(10)) - 1 .
     1302     do i = 1 to n :
     1303       ipos = index( start-text, chr(10)).
     1304       if ipos > 0 then
     1305         substring( start-text, ipos , 1 ) = ' '.
     1306     end.
     1307       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     1308     return start-text.
     1309   end.
     1310   FUNCTION n-lavel RETURNS char (INPUT grp-name as char, INPUT lavel# as int ).
     1311   define variable  str  as char format "X(60)"  no-undo.
     1312   define variable  str2 as char no-undo.
     1313   define variable v-r as character no-undo init "" .
     1314   define variable  i#i as int no-undo.
     1315   STR = "".
     1316   repeat i#i =1 to lavel#:
     1317       if i#i =1 then str   = entry(1,grp-name, chr(47)) .
     1318       else do:
     1319           str2 = entry(i#i,grp-name, chr(47)) no-error.
     1320           if not error-status:error  and str2 <> "":u then
     1321                  str = str +  chr(47) +  entry(i#i,grp-name, chr(47)) no-error .
     1322           end.
     1323   end.
     1324   if str <> ? then do:
     1325   v-r = str + chr(47) .
     1326   end.
     1327   RETURN v-r .
     1328   END FUNCTION.
