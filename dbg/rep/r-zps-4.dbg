     4177                                       End.
     4178                     if last-of( (temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code)) ) Then DO : run print-footer ( 3 , temp-t-post-stk-line.clients-obj-name). end.
     4179                 if last-of( (temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code)) )  Then DO : run print-footer ( 2 ,(temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code))). end.
     4180                 if last-of( temp-t-post-stk-line.goods-grp-name )  then do : run print-footer ( 1, temp-t-post-stk-line.goods-grp-name ). end.
     4181             End.
     4182            if t#kol-rec-obj > 1 THEN run print-footer ( 0, '(' + obj-list.obj-type + ' ' + trim(string(obj-list.obj-code)) + ') ' + obj-list.obj-name).
     4183           .
     4184          End.
     4185     .
     4186     End.
     4187   End case.
     4188   End procedure.
     4189   procedure Print-Header :
     4190   define input parameter N as integer no-undo .
     4191   define input parameter Name as char no-undo .
     4192   PUT stream  OutStream  UNFORMATTED trim(Name) AT ((N - 1) * 10 ) format "x(100)" skip.
     4193   if Make-Excel then  put   stream ForExcel unformatted fill(" " + CHR(9), N - 1) trim(Name) skip.
     4194   END PROCEDURE.
