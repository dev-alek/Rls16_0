     3557                                               post-stk-line.fact-order >= null-fact-order   and
     3558                                               post-stk-line.fact-order <= fact-order-2   and
     3559                                               post-stk-line.sum-type    = 'cost':U    and
     3560                                               post-stk-line.cat-id      = '##':U
     3561                                               and can-find(first g#post  where  post-stk-line.cli-type = g#post.obj-type and  post-stk-line.cli-code = g#post.obj-code ) = TRUE
     3562                                               ,
     3563                    each ub.goods no-lock where
     3564                                               ub.goods.artic     = post-stk-line.artic     and
     3565                                               ub.goods.prod-type = post-stk-line.prod-type and
     3566                                               ub.goods.prod-code = post-stk-line.prod-code  and  can-find(first gds-list where  ub.goods.gds-code = gds-list.gds-code ) = TRUE
     3567                                               :
     3568                    find first  temp-t-post-stk-line where
     3569                      temp-t-post-stk-line.cli-type  = post-stk-line.cli-type  and
     3570                      temp-t-post-stk-line.cli-code  = post-stk-line.cli-code   and
     3571                      temp-t-post-stk-line.artic     = post-stk-line.artic     and
     3572                      temp-t-post-stk-line.prod-type = post-stk-line.prod-type and
     3573                      temp-t-post-stk-line.prod-code = post-stk-line.prod-code no-lock no-error .
     3574                      if not available  temp-t-post-stk-line then do:
     3575                         find first  prod-cli no-lock  where
