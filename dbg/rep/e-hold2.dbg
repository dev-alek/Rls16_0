      562   define new global shared variable g#library  as handle no-undo .
      563   define new global shared variable g#library2 as handle no-undo .
      564   define variable var-report-r-b as character no-undo .
      565   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      566   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      567     (output var-report-r-b
      568     )  .
      569   procedure proc-alt-shift-f2:
      570     if not ibs.th.gbl.gbl-var:rcode
      571   then
      572     run gbl\inidebug.p .
      573   end.
      574   procedure proc-alt-shift-f3:
      575     run gbl/prvssinf.p
      576       ( input this-procedure
      577       ) .
      578   end.
      579   define variable v-inform-launched as logical no-undo initial false .
      580   procedure proc-alt-shift-f4:
      581     define variable v-action as character no-undo .
      582     if v-inform-launched = false then do:
      583       assign
      584         v-inform-launched = true
      585       .
      586       run gbl/d-inform.w
      587         (  input self
      588         ,  input this-procedure
      589         , output v-action
      590         ) no-error .
      591       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      592       assign
      593         v-inform-launched = false
      594       .
      595     end.
      596   end.
      597   procedure proc-alt-f1:
      598     run gbl/corrhelp.p
      599       (input this-procedure
      600       ) .
      601   end .
      602   on alt-shift-f2 anywhere do:
      603     run proc-alt-shift-f2.
      604   end.
      605   on alt-shift-f3 anywhere do:
      606     run proc-alt-shift-f3 in this-procedure .
      607   end.
      608   on alt-shift-f4 anywhere do:
      609     run proc-alt-shift-f4 in this-procedure.
      610   end.
      611   on alt-f1 anywhere do:
      612     run proc-alt-f1 in this-procedure .
      613   end.
      614   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      615   procedure holdattr-code :
      616     do
      617     on error undo, return error
      618     :
      619       define input  parameter p-code           as character no-undo .
      620       define output parameter p-type           as character no-undo .
      621       define output parameter p-format         as character no-undo .
      622       define output parameter p-label          as character no-undo .
      623       define output parameter p-user-can-edit  as logical   no-undo .
      624       define output parameter p-output-display as logical   no-undo .
      625       define output parameter p-other          as character no-undo .
      626       case p-code :
      627               when 'begin-date':U then do:     assign     p-label = "Дата начала межфирменного архива"     p-type = 'T':U      p-format = "99/99/9999"     p-label = "Дата начала межфирменного архива"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      628               when 'is-calc':U then do:     assign     p-label = "Произв.расчет арх."     p-type = 'L':U      p-format = "+/-"     p-label = "Произв.расчет арх."     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      629         otherwise do:
      630           undo, return error "неизвестный атрибут межфирменного архива" + " " + p-code .
      631         end.
      632       end.
      633     end.
      634   end procedure.
      635   procedure holdattr-tooltip :
      636     do
      637     on error undo, return error
      638     :
      639       define input  parameter p-code    as character no-undo .
      640       define output parameter p-tooltip as character no-undo .
      641       define output parameter p-label   as character no-undo .
      642       case p-code :
      643               when 'begin-date':U then do:     assign     p-tooltip = "Дата начала межфирменного архива"     p-label = "Дата начала межфирменного архива" .   end.
      644               when 'is-calc':U then do:     assign     p-tooltip = "Производится расчет межфирменного архива"     p-label = "Произв.расчет арх." .   end.
      645         otherwise do:
      646           undo, return error "неизвестный атрибут межфирменного архива" + " " + p-code .
      647         end.
      648       end.
      649     end.
      650   end procedure.
      651   procedure holdattr-value :
      652     do
      653     on error undo, return error
      654     :
      655       define input  parameter p-cat-code  like ub.hold-attr.cat-code     no-undo .
      656       define input  parameter p-code      like ub.hold-attr.attr-code  no-undo .
      657       define output parameter p-value     like ub.hold-attr.attr-value no-undo .
      658       define output parameter p-type      as character no-undo .
      659       define buffer buf_hold-attr for ub.hold-attr .
      660       def var v-format         as character no-undo .
      661       def var v-label          as character no-undo .
      662       def var v-user-can-edit  as logical   no-undo .
      663       def var v-output-display as logical   no-undo .
      664       def var v-other          as character no-undo .
      665       run holdattr-code in this-procedure
      666         (input  p-code
      667         ,output p-type
      668         ,output v-format
      669         ,output v-label
      670         ,output v-user-can-edit
      671         ,output v-output-display
      672         ,output v-other
      673         ) no-error .
      674       if error-status :error then do:
      675         undo, return error return-value .
      676       end.
      677       find first buf_hold-attr no-lock
      678         where buf_hold-attr.cat-code    = p-cat-code
      679           and buf_hold-attr.attr-code = p-code
      680         no-error .
      681       if avail buf_hold-attr then do:
      682         assign
      683           p-value =  buf_hold-attr.attr-value
      684         .
      685       end.
      686       else do:
      687         assign
      688           p-value = if p-type = 'L':U then "no":U else ""
      689         .
      690       end.
      691     end.
      692   end procedure.
      693   procedure holdattr-write :
      694     do
      695     on error undo, return error
      696     :
      697       define input parameter p-cat-code    like ub.hold-attr.cat-code     no-undo .
      698       define input parameter p-code      like ub.hold-attr.attr-code  no-undo .
      699       define input parameter p-value     like ub.hold-attr.attr-value no-undo .
      700       define buffer buf_hold-attr for ub.hold-attr .
      701       def var v-type           as character no-undo .
      702       def var v-format         as character no-undo .
      703       def var v-label          as character no-undo .
      704       def var v-user-can-edit  as logical   no-undo .
      705       def var v-output-display as logical   no-undo .
      706       def var v-other          as character no-undo .
      707       run holdattr-code in this-procedure
      708         (input  p-code
      709         ,output v-type
      710         ,output v-format
      711         ,output v-label
      712         ,output v-user-can-edit
      713         ,output v-output-display
      714         ,output v-other
      715         ) no-error .
      716       if error-status :error then do:
      717         undo, return error return-value .
      718       end.
      719       find first buf_hold-attr exclusive-lock
      720         where buf_hold-attr.cat-code    = p-cat-code
      721           and buf_hold-attr.attr-code = p-code
      722         no-error .
      723       if not available buf_hold-attr then do:
      724         create buf_hold-attr .
      725         assign
      726           buf_hold-attr.cat-code    = p-cat-code
      727           buf_hold-attr.attr-code = p-code
      728         .
      729       end.
      730       assign
      731         buf_hold-attr.attr-value = p-value
      732       .
      733     end.
      734   end procedure.
      735   procedure holdattr-exist :
      736     do
      737     on error undo, return error
      738     :
      739       define input parameter p-cat-code    like ub.hold-attr.cat-code     no-undo .
      740       define input parameter p-code      like ub.hold-attr.attr-code  no-undo .
      741       define output parameter p-exist    as logical  no-undo .
      742       define buffer buf_hold-attr for ub.hold-attr .
      743       def var v-type           as character no-undo .
      744       def var v-format         as character no-undo .
      745       def var v-label          as character no-undo .
      746       def var v-user-can-edit  as logical   no-undo .
      747       def var v-output-display as logical   no-undo .
      748       def var v-other          as character no-undo .
      749       run holdattr-code in this-procedure
      750         (input  p-code
      751         ,output v-type
      752         ,output v-format
      753         ,output v-label
      754         ,output v-user-can-edit
      755         ,output v-output-display
      756         ,output v-other
      757         ) no-error .
      758       if error-status :error then do:
      759         undo, return error return-value .
      760       end.
      761       find first buf_hold-attr no-lock
      762         where buf_hold-attr.cat-code    = p-cat-code
      763           and buf_hold-attr.attr-code = p-code
      764         no-error .
      765       if  available buf_hold-attr then do:
      766         p-exist = yes.
      767       end.
      768     end.
      769   end procedure.
      770   procedure holdattr-delete :
      771     do
      772     on error undo, return error
      773     :
      774       define input parameter p-cat-code   like ub.hold-attr.cat-code     no-undo .
      775       define input parameter p-code     like ub.hold-attr.attr-code  no-undo .
      776       define output parameter p-deleted  as logical no-undo.
      777       define buffer buf_hold-attr for ub.hold-attr .
      778       def var v-type           as character no-undo .
      779       def var v-format         as character no-undo .
      780       def var v-label          as character no-undo .
      781       def var v-user-can-edit  as logical   no-undo .
      782       def var v-output-display as logical   no-undo .
      783       def var v-other          as character no-undo .
      784       run holdattr-code in this-procedure
      785         (input  p-code
      786         ,output v-type
      787         ,output v-format
      788         ,output v-label
      789         ,output v-user-can-edit
      790         ,output v-output-display
      791         ,output v-other
      792         ) no-error .
      793       if error-status :error then do:
      794         undo, return error return-value .
      795       end.
      796       find first buf_hold-attr exclusive-lock
      797         where buf_hold-attr.cat-code    = p-cat-code
      798           and buf_hold-attr.attr-code = p-code
      799         no-error NO-WAIT.
      800       if not available buf_hold-attr then do:
      801         p-deleted = no.
      802       end.
      803       else do:
      804         delete buf_hold-attr.
      805         p-deleted = yes.
      806       end.
      807     end.
      808   end procedure.
      809   procedure holdattr-news :
      810     do
      811     on error undo, return error
      812     :
      813       define input  parameter p-code           as character no-undo .
      814       define output parameter p-news           as logical   no-undo .
      815       case p-code :
      816               when 'begin-date':U then do:     assign     p-news = no.   end.
      817               when 'is-calc':U then do:     assign     p-news = no.   end.
      818         otherwise do:
      819           undo, return error "неизвестный атрибут межфирменного архива" + " " + p-code .
      820         end.
      821       end.
      822     end.
      823   end procedure.
      824   CREATE WIDGET-POOL.
      825   def var State-source as  WIDGET-HANDLE.
      826   def var cli-list as char no-undo.
      827   DEFINE VARIABLE dat AS INTEGER FORMAT "9999":U INITIAL 0
      828        LABEL "Отчетный год"
      829        VIEW-AS FILL-IN
      830        SIZE 6.13 BY 1 NO-UNDO.
      831   DEFINE VARIABLE RADIO-SET-1 AS INTEGER
      832        VIEW-AS RADIO-SET VERTICAL
      833        RADIO-BUTTONS
      834             "Все", 1,
      835   "Выбрать", 2
      836        SIZE 24.88 BY 2.54 NO-UNDO.
      837   DEFINE RECTANGLE RECT-5
      838        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      839        SIZE 35.13 BY 4.13.
      840   DEFINE RECTANGLE RECT-6
      841        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      842        SIZE 35.13 BY 4.13.
      843   DEFINE FRAME F-Main
      844        dat AT ROW 2.54 COL 15.38 COLON-ALIGNED
      845        RADIO-SET-1 AT ROW 6.67 COL 4.63 NO-LABEL
      846        "Поставщики:" VIEW-AS TEXT
      847             SIZE 22.38 BY .67 AT ROW 5.71 COL 4
      848        RECT-6 AT ROW 5.54 COL 1.63
      849        RECT-5 AT ROW 1.08 COL 1.63
      850       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      851            SIDE-LABELS NO-UNDERLINE THREE-D
      852            AT COL 1 ROW 1 SCROLLABLE .
      853   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      854   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      855   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      856   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      857   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      858   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      859   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      860   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      861         adm-object-hdl = FRAME F-Main:HANDLE.
      862   RUN ensure-broker.
      863   THIS-PROCEDURE:ADM-DATA =
      864        'ADM1.1~`':U +
      865        'SmartObject~`':U +
      866        '~`':U +
      867        'NO ~`':U +
      868        '~`':U +
      869        '~`':U +
      870        '~`':U +
      871        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      872           + "~`":U +
      873        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      874        'Record-Source,Record-Target,TableIO-Target~`':U +
      875        '~`':U +
      876        '~`~`~`~`~`~`~`~`~`~`~`':U +
      877        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      878            THEN "^^":U
      879        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      880             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      881   PROCEDURE adm-apply-entry :
      882     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      883   END PROCEDURE.
      884   PROCEDURE adm-destroy :
      885    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      886   END PROCEDURE.
      887   PROCEDURE adm-disable :
      888       DISABLE RECT-6 RECT-5 dat RADIO-SET-1 WITH FRAME F-Main.
      889       RUN dispatch ('disable-fields':U).
      890       RUN set-attribute-list ('ENABLED=no':U).
      891       RETURN.
      892   END PROCEDURE.
      893   PROCEDURE adm-edit-attribute-list :
      894         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      895         RETURN.
      896   END PROCEDURE.
      897   PROCEDURE adm-enable :
      898       ENABLE UNLESS-HIDDEN RECT-6 RECT-5 dat RADIO-SET-1 WITH FRAME F-Main.
      899       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      900       RUN set-attribute-list ('ENABLED=yes':U).
      901       RETURN.
      902   END PROCEDURE.
      903   PROCEDURE adm-exit :
      904        RUN notify ('exit':U).
      905     RETURN.
      906   END PROCEDURE.
      907   PROCEDURE adm-hide :
      908     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      909   END PROCEDURE.
      910   PROCEDURE adm-initialize :
      911     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      912   END PROCEDURE.
      913   PROCEDURE adm-show-errors :
      914       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      915       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      916           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      917       END.
      918       RETURN.
      919   END PROCEDURE.
      920   PROCEDURE adm-UIB-mode :
      921     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      922   END PROCEDURE.
      923   PROCEDURE adm-view :
      924     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      925   END PROCEDURE.
      926   PROCEDURE dispatch :
      927       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      928       RUN broker-dispatch IN adm-broker-hdl
      929           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      930       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      931   END PROCEDURE.
      932   PROCEDURE ensure-broker :
      933   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      934   IF RETURN-VALUE NE "ADM-Broker":U THEN
      935   DO:
      936       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      937       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      938   END.
      939   END PROCEDURE.
      940   PROCEDURE get-attribute :
      941     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      942     RUN broker-get-attribute IN adm-broker-hdl
      943         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      944     RETURN RETURN-VALUE.
      945   END PROCEDURE.
      946   PROCEDURE get-attribute-list :
      947     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      948     RUN broker-get-attribute-list IN adm-broker-hdl
      949         (INPUT THIS-PROCEDURE,
      950          INPUT ?,
      951          OUTPUT p-attr-list) NO-ERROR.
      952     RETURN.
      953   END PROCEDURE.
      954   PROCEDURE new-state :
      955     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      956     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      957     RETURN.
      958   END PROCEDURE.
      959   PROCEDURE notify :
      960     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      961     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      962     IF RETURN-VALUE = "ADM-ERROR":U THEN
      963         RETURN "ADM-ERROR":U.
      964     RETURN.
      965   END PROCEDURE.
      966   PROCEDURE set-attribute-list :
      967     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      968     RUN ensure-broker.
      969     RUN broker-set-attribute-list IN adm-broker-hdl
      970         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      971     RETURN.
      972   END PROCEDURE.
      973   PROCEDURE set-position :
      974       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      975       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      976       IF VALID-HANDLE(adm-object-hdl) THEN
      977       DO:
      978         ASSIGN adm-object-hdl:ROW    =   p-row
      979                adm-object-hdl:COLUMN =   p-col.
      980       END.
      981       RETURN.
      982   END PROCEDURE.
      983   PROCEDURE adm-display-fields :
      984       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      985       RETURN.
      986   END PROCEDURE.
      987   PROCEDURE adm-open-query :
      988     RETURN.
      989   END PROCEDURE.
      990   PROCEDURE adm-row-changed :
      991         IF VALID-HANDLE(adm-object-hdl) THEN
      992           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      993         RUN notify ('row-available':U).
      994         RETURN.
      995   END PROCEDURE.
      996   PROCEDURE reposition-query :
      997       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      998       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      999       RETURN.
     1000   END PROCEDURE.
     1001     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1002     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1003     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1004     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1005     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1006     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1007     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1008     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1009     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1010     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1011     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1012     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1013     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1014     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1015     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1016     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1017     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1018     IF "":U = "":U THEN
     1019       RUN modify-list-attribute IN adm-broker-hdl
     1020         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1021     RUN use-create-on-add(?).
     1022   PROCEDURE adm-add-record :
     1023       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1024          "must have at least one Enabled Table to perform Add.":U
     1025          VIEW-AS ALERT-BOX ERROR.
     1026       RETURN.
     1027   END PROCEDURE.
     1028   PROCEDURE adm-assign-record :
     1029    MESSAGE
     1030          "Object ":U THIS-PROCEDURE:FILE-NAME
     1031            "must have at least one Enabled Table to perform Assign.":U
     1032              VIEW-AS ALERT-BOX ERROR.
     1033      RETURN.
     1034     END PROCEDURE.
     1035   PROCEDURE adm-assign-statement :
     1036     RETURN.
     1037   END PROCEDURE.
     1038   PROCEDURE adm-cancel-record :
     1039      RETURN.
     1040     END PROCEDURE.
     1041   PROCEDURE adm-copy-record :
     1042       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1043        "must have at least one Enabled Table to perform Copy.":U
     1044          VIEW-AS ALERT-BOX ERROR.
     1045       RETURN.
     1046   END PROCEDURE.
     1047   PROCEDURE adm-create-record :
     1048      RETURN.
     1049   END PROCEDURE.
     1050   PROCEDURE adm-current-changed :
     1051     RETURN.
     1052   END PROCEDURE.
     1053   PROCEDURE adm-delete-record :
     1054    MESSAGE
     1055          "Object ":U THIS-PROCEDURE:FILE-NAME
     1056            "must have at least one Enabled Table to perform Delete.":U
     1057              VIEW-AS ALERT-BOX ERROR.
     1058       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1059       RETURN.
     1060   END PROCEDURE.
     1061   PROCEDURE adm-disable-fields :
     1062         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1063       RETURN.
     1064   END PROCEDURE.
     1065   PROCEDURE adm-enable-fields :
     1066       RETURN.
     1067   END PROCEDURE.
     1068   PROCEDURE adm-end-update :
     1069     RETURN.
     1070   END PROCEDURE.
     1071   PROCEDURE adm-reset-record :
     1072       RETURN.
     1073   END PROCEDURE.
     1074   PROCEDURE adm-update-record :
     1075       MESSAGE
     1076         "Object ":U THIS-PROCEDURE:FILE-NAME
     1077           "must have at least one Enabled Table to perform Update.":U
     1078             VIEW-AS ALERT-BOX ERROR.
     1079      RETURN.
     1080   END PROCEDURE.
     1081   PROCEDURE check-modified :
     1082   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1083   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1084   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1085   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1086     IF check-state = "check":U THEN
     1087     DO:
     1088       RUN get-link-handle IN adm-broker-hdl
     1089         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1090            OUTPUT group-target-list).
     1091       IF group-target-list NE "":U THEN
     1092       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1093         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1094         RUN check-modified IN curr-widget ('group-check':U).
     1095         IF RETURN-VALUE NE "":U THEN
     1096         DO:
     1097           RUN check-modified-message(RETURN-VALUE).
     1098           RETURN "":U.
     1099         END.
     1100       END.
     1101     END.
     1102     RETURN "":U.
     1103   END PROCEDURE.
     1104   PROCEDURE check-modified-message :
     1105     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1106        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1107           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1108        IF RETURN-VALUE = "YES":U THEN
     1109           RUN notify ('view,CONTAINER-SOURCE':U).
     1110        MESSAGE IF p-changed-table NE ? THEN
     1111           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1112           ELSE "Current values have been changed."
     1113           SKIP "  Do you wish to save those changes?"
     1114           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1115        IF ANS THEN
     1116        DO:
     1117           IF group-assign-target THEN
     1118             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1119           ELSE RUN dispatch('update-record':U).
     1120           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1121           DO:
     1122               MESSAGE "Changes to the previous record were not saved."
     1123                 VIEW-AS ALERT-BOX ERROR.
     1124               IF group-assign-target THEN
     1125                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1126               ELSE RUN dispatch ('cancel-record':U).
     1127           END.
     1128        END.
     1129        ELSE DO:
     1130          IF group-assign-target THEN
     1131             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1132          ELSE RUN dispatch('cancel-record':U).
     1133        END.
     1134        RETURN.
     1135   END PROCEDURE.
     1136   PROCEDURE get-rowid :
     1137       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1138       ASSIGN
     1139       p-table   =   adm-first-table.
     1140       RETURN.
     1141   END PROCEDURE.
     1142   PROCEDURE init-group-assign :
     1143       RUN request-attribute IN adm-broker-hdl
     1144         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1145       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1146         group-assign-target = yes.
     1147       ELSE group-assign-target = no.
     1148       RETURN.
     1149   END PROCEDURE.
     1150   PROCEDURE set-editors :
     1151       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1152       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1153       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1154       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1155       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1156       DO WHILE VALID-HANDLE (curr-widget):
     1157           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1158              curr-widget:HIDDEN = no THEN DO:
     1159             CASE p-field-setting:
     1160               WHEN "INITIALIZE":U THEN
     1161               DO:
     1162                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1163                     read-only-list +
     1164                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1165                        STRING(curr-widget).
     1166               END.
     1167               WHEN "DISABLE":U OR
     1168               WHEN "ENABLE":U THEN
     1169               DO:
     1170                   curr-widget:SENSITIVE = yes.
     1171                   RUN get-attribute ('Read-Only-Editors':U).
     1172                   IF RETURN-VALUE = ? OR
     1173                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1174                       curr-widget:READ-ONLY =
     1175                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1176               END.
     1177               WHEN "CLEAR":U THEN
     1178                   curr-widget:SCREEN-VALUE = "":U.
     1179             END CASE.
     1180           END.
     1181           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1182       END.
     1183       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1184         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1185           + '"':U).
     1186       RETURN.
     1187   END PROCEDURE.
     1188   PROCEDURE use-check-modified-all :
     1189    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1190     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1191     RETURN.
     1192   END PROCEDURE.
     1193   PROCEDURE use-create-on-add :
     1194   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1195      RETURN.
     1196   END PROCEDURE.
     1197   PROCEDURE use-initial-lock :
     1198     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1199     ASSIGN adm-initial-lock = p-attr-value.
     1200     RETURN.
     1201   END PROCEDURE.
     1202     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1203   ASSIGN
     1204          FRAME F-Main:SCROLLABLE       = FALSE
     1205          FRAME F-Main:HIDDEN           = TRUE.
     1206   ON VALUE-CHANGED OF RADIO-SET-1 IN FRAME F-Main
     1207   DO:
     1208     assign RADIO-SET-1.
     1209     assign
     1210       cli-list = ""
     1211     .
     1212     if RADIO-SET-1 = 2 then do:
     1213       run ref/cli-all.w ( input my-handle
     1214                     ,input "b-mark,b-sel"
     1215                     ,input 'все':U
     1216                     ,input 'все':U
     1217                     ,input 'текущие':U
     1218                     ,input ?
     1219                     ,input "yes,yes,yes,,,,ИЛИ"
     1220                     ,input ?
     1221                     ,output cli-list ) .
     1222       if cli-list = "" or cli-list = ? then do:
     1223         assign RADIO-SET-1 = 1 .
     1224         DISPLAY RADIO-SET-1 WITH FRAME F-Main.
     1225       end.
     1226     end.
     1227   END.
     1228   if not this-procedure :persistent
     1229   then do:
     1230     message
     1231       vss-workfile vss-revision vss-description skip
     1232       "Ошибка при запуске процедуры" skip
     1233       "Данную процедуру следует запускать только с параметром persistent" skip
     1234       view-as alert-box error .
     1235     undo, return error .
     1236   end.
     1237   PROCEDURE disable_UI :
     1238     HIDE FRAME F-Main.
     1239     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1240   END PROCEDURE.
     1241   PROCEDURE local-initialize :
     1242     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1243     assign
     1244       dat :screen-value in frame F-Main = string(year(x-Date-Start))
     1245     .
     1246   END PROCEDURE.
     1247   PROCEDURE my-report :
     1248     define variable v-hold-date-value as character no-undo .
     1249     define variable v-hold-date-type  as character no-undo .
     1250     define variable v-cat-code as integer initial 1 no-undo .
     1251     run holdattr-value in this-procedure (input v-cat-code, input  'begin-date':U, output v-hold-date-value, output v-hold-date-type) .
     1252     define variable dat1 as date   no-undo .
     1253     assign dat1 = date(1,1,dat) .
     1254     if dat1 < date(v-hold-date-value) then message
     1255       "Дата начала отчетного периода "  dat1 " меньше"  skip
     1256       "даты начала рассчитаных архивов " v-hold-date-value "!" skip
     1257       "Отчет будет сформирован начиная с " v-hold-date-value
     1258       view-as alert-box WARNING TITLE "В Н И М А Н И Е ! " .
     1259    run rep/r-hold2.p  ( input dat, input RADIO-SET-1, input cli-list ) .
     1260   END PROCEDURE.
     1261   PROCEDURE my-var :
     1262   assign frame F-Main dat RADIO-SET-1 .
     1263   define variable jj as integer   no-undo .
     1264   define buffer buf_clients for clients.
     1265   ReportNAme = "Динамика закупки за "  + String(dat) + " год." .
     1266   if x-SET_val_TYPE = 1 then ReportHeader = "Цены указаны в: рублях" + chr(10).
     1267   else                       ReportHeader = "Цены указаны в: валюте" + chr(10).
     1268   if RADIO-SET-1 = 1 then assign  ReportHeader = ReportHeader + "Выбор поставщика: все" .
     1269   else do:
     1270     assign  ReportHeader = ReportHeader + "Выбор поставщика: " .
     1271     DO jj = 1 TO num-entries( cli-list ) :
     1272       find first buf_clients where recid(buf_clients) = integer(entry(jj, cli-list)) no-error.
     1273       if not avail buf_clients then next .
     1274       assign  ReportHeader = ReportHeader + buf_clients.obj-name + " (" + buf_clients.obj-type + '#' + string(buf_clients.obj-code) + ")" + ", "  .
     1275     end.
     1276   end.
     1277   END PROCEDURE.
