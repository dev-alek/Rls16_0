      999   PROCEDURE notify :
     1000     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1001     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1002     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1003         RETURN "ADM-ERROR":U.
     1004     RETURN.
     1005   END PROCEDURE.
