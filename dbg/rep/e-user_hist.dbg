     1114   PROCEDURE adm-update-record :
     1115       MESSAGE
     1116         "Object ":U THIS-PROCEDURE:FILE-NAME
     1117           "must have at least one Enabled Table to perform Update.":U
     1118             VIEW-AS ALERT-BOX ERROR.
     1119      RETURN.
     1120   END PROCEDURE.
     1121   PROCEDURE check-modified :
     1122   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1123   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1124   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1125   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1126     IF check-state = "check":U THEN
     1127     DO:
     1128       RUN get-link-handle IN adm-broker-hdl
     1129         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1130            OUTPUT group-target-list).
     1131       IF group-target-list NE "":U THEN
     1132       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1133         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1134         RUN check-modified IN curr-widget ('group-check':U).
     1135         IF RETURN-VALUE NE "":U THEN
     1136         DO:
     1137           RUN check-modified-message(RETURN-VALUE).
     1138           RETURN "":U.
     1139         END.
     1140       END.
     1141     END.
     1142     RETURN "":U.
     1143   END PROCEDURE.
     1144   PROCEDURE check-modified-message :
     1145     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1146        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1147           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1148        IF RETURN-VALUE = "YES":U THEN
     1149           RUN notify ('view,CONTAINER-SOURCE':U).
     1150        MESSAGE IF p-changed-table NE ? THEN
     1151           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1152           ELSE "Current values have been changed."
     1153           SKIP "  Do you wish to save those changes?"
     1154           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1155        IF ANS THEN
     1156        DO:
     1157           IF group-assign-target THEN
     1158             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1159           ELSE RUN dispatch('update-record':U).
     1160           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1161           DO:
     1162               MESSAGE "Changes to the previous record were not saved."
     1163                 VIEW-AS ALERT-BOX ERROR.
     1164               IF group-assign-target THEN
     1165                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1166               ELSE RUN dispatch ('cancel-record':U).
     1167           END.
     1168        END.
     1169        ELSE DO:
     1170          IF group-assign-target THEN
     1171             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1172          ELSE RUN dispatch('cancel-record':U).
     1173        END.
     1174        RETURN.
     1175   END PROCEDURE.
     1176   PROCEDURE get-rowid :
     1177       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1178       ASSIGN
     1179       p-table   =   adm-first-table.
     1180       RETURN.
     1181   END PROCEDURE.
     1182   PROCEDURE init-group-assign :
     1183       RUN request-attribute IN adm-broker-hdl
     1184         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1185       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1186         group-assign-target = yes.
     1187       ELSE group-assign-target = no.
     1188       RETURN.
     1189   END PROCEDURE.
     1190   PROCEDURE set-editors :
     1191       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1192       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1193       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1194       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1195       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1196       DO WHILE VALID-HANDLE (curr-widget):
     1197           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1198              curr-widget:HIDDEN = no THEN DO:
     1199             CASE p-field-setting:
     1200               WHEN "INITIALIZE":U THEN
     1201               DO:
     1202                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1203                     read-only-list +
     1204                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1205                        STRING(curr-widget).
     1206               END.
     1207               WHEN "DISABLE":U OR
     1208               WHEN "ENABLE":U THEN
     1209               DO:
     1210                   curr-widget:SENSITIVE = yes.
     1211                   RUN get-attribute ('Read-Only-Editors':U).
     1212                   IF RETURN-VALUE = ? OR
     1213                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1214                       curr-widget:READ-ONLY =
     1215                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1216               END.
     1217               WHEN "CLEAR":U THEN
     1218                   curr-widget:SCREEN-VALUE = "":U.
     1219             END CASE.
     1220           END.
     1221           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1222       END.
     1223       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1224         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1225           + '"':U).
     1226       RETURN.
     1227   END PROCEDURE.
     1228   PROCEDURE use-check-modified-all :
     1229    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1230     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1231     RETURN.
     1232   END PROCEDURE.
     1233   PROCEDURE use-create-on-add :
     1234   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1235      RETURN.
     1236   END PROCEDURE.
     1237   PROCEDURE use-initial-lock :
     1238     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1239     ASSIGN adm-initial-lock = p-attr-value.
     1240     RETURN.
     1241   END PROCEDURE.
     1242     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1243   ASSIGN
     1244          FRAME F-Main:SCROLLABLE       = FALSE
     1245          FRAME F-Main:HIDDEN           = TRUE.
     1246   ON VALUE-CHANGED OF object-name IN FRAME F-Main
     1247   DO:
     1248     assign object-name .
     1249   END.
     1250   ON VALUE-CHANGED OF user-name IN FRAME F-Main
     1251   DO:
     1252     assign user-name .
     1253   END.
     1254   run inifields .
     1255   PROCEDURE disable_UI :
     1256     HIDE FRAME F-Main.
     1257     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1258   END PROCEDURE.
     1259   PROCEDURE inifields :
     1260   for each obj-list :
     1261   for each user-obj no-lock where user-obj.obj-code = obj-list.obj-code and user-obj.obj-type = obj-list.obj-type,
     1262       each ub.user-account no-lock where ub.user-account.user-id = user-obj.user-id:
     1263         create tt-user-account .
     1264         assign
     1265         tt-user-account.db-num = user-obj.db-num
     1266         tt-user-account.user-id_ = ub.user-account.user-id
     1267         tt-user-account.user_name = "ID: " + ub.user-account.user-id + " ФИО: " + user-account.last-name + " " + user-account.first-name + " " + user-account.second-name
     1268         .
     1269   end.
     1270   end.
     1271   if x-SelectObject = "firm" then user-name:list-item-pairs in frame F-Main = "ВСЕ,-1" .
     1272   if x-SelectObject <> "firm" then do:
     1273   user-name:list-item-pairs in frame F-Main = "ВСЕ,-1" .
     1274   for each tt-user-account no-lock by tt-user-account.user_name:
     1275     assign
     1276                   user-name :list-item-pairs = substitute( "&2&1&3&1&4"
     1277                                          , ","
     1278                                          , user-name :list-item-pairs
     1279                                          , tt-user-account.user_name
     1280                                          , tt-user-account.user-id_
     1281     )
     1282     .
     1283   end.
     1284   End.
     1285           define VARIABLE v-head-table as character no-undo .
     1286           define BUFFER bf_c-user-log for ub.c-user-log .
     1287           define variable v-user-table-name as character no-undo .
     1288           define variable v-user-table      as character no-undo .
     1289           define variable v-table           as character no-undo .
     1290           for each bf_c-user-log no-lock where
     1291           bf_c-user-log.corr-date >= x-Date-Start
     1292           and bf_c-user-log.corr-date <= x-Date-End by bf_c-user-log.head-table :
     1293               v-table = bf_c-user-log.head-table .
     1294               if v-table begins "c-" and v-table <> 'c-usr-hist':U and v-table <> 'c-plc-hist':U then
     1295               do:
     1296                   v-user-table = replace(v-table,"c-","").
     1297               end.
     1298               else v-user-table = v-table .
     1299               find first tt-objects where tt-objects.table_ = v-user-table no-error .
     1300               if not AVAILABLE (tt-objects) then
     1301               do:
     1302   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1303   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run tblnmusr in g#library
     1304     (input  v-user-table
     1305     ,output v-user-table-name
     1306     )  .
     1307                   create tt-objects .
     1308                   assign
     1309                       tt-objects.table_ = v-user-table
     1310                       tt-objects.name_  = v-user-table-name
     1311                       .
     1312               end.
     1313           end.
     1314   object-name:list-item-pairs in frame F-Main = "ВСЕ,-1" .
     1315   for each tt-objects no-lock by tt-objects.name_:
     1316     assign
     1317                   object-name :list-item-pairs = substitute( "&2&1&3&1&4"
     1318                                          , ","
     1319                                          , object-name :list-item-pairs
     1320                                          , tt-objects.name_
     1321                                          , tt-objects.table_
     1322                                                      )
     1323     .
     1324   end.
     1325   END PROCEDURE.
