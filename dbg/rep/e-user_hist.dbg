     1013   PROCEDURE set-position :
     1014       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1015       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1016       IF VALID-HANDLE(adm-object-hdl) THEN
     1017       DO:
     1018         ASSIGN adm-object-hdl:ROW    =   p-row
     1019                adm-object-hdl:COLUMN =   p-col.
     1020       END.
     1021       RETURN.
     1022   END PROCEDURE.
