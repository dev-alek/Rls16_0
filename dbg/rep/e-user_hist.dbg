     1041     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1042     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1043     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1044     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1045     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1046     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1047     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1048     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1049     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1050     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1051     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1052     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1053     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1054     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1055     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1056     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1057     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1058     IF "":U = "":U THEN
     1059       RUN modify-list-attribute IN adm-broker-hdl
     1060         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1061     RUN use-create-on-add(?).
     1062   PROCEDURE adm-add-record :
