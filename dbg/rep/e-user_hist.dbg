      569   function diff-list returns character (
      570     input parfirst-list  as character,
      571     input parsecond-list as character,
      572     input pardelim       as character).
      573     if pardelim = ""
      574     or pardelim = ?
      575     then do:
      576       assign
      577         pardelim = ","
      578       .
      579     end.
      580     def var ind as integer no-undo .
      581     def var v-elem as character no-undo .
      582     def var v-result-list as character no-undo init "".
      583     def var v-num-parfirst-list as integer no-undo .
      584     assign
      585       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      586     .
      587     do ind = 1 to v-num-parfirst-list
      588     :
      589       assign
      590         v-elem = entry(ind, parfirst-list, pardelim)
      591       .
      592       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      593         assign
      594           v-result-list = v-result-list
      595                         + (if v-result-list > "" then pardelim else "")
      596                         + v-elem
      597         .
      598       end.
      599     end.
      600     return v-result-list .
      601   end function.
      602   function add-list returns character (
      603    input parfirst-list  as character,
      604    input parsecond-list as character,
      605    input pardelim       as character).
      606     if pardelim = ""
      607     or pardelim = ?
      608     then do:
      609       assign
      610         pardelim = ","
      611       .
      612     end.
      613     def var ind as integer no-undo .
      614     def var v-elem as character no-undo .
      615     def var v-result-list as character no-undo init "".
      616     def var v-num-parfirst-list as integer no-undo .
      617     assign
      618       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      619     .
      620     do ind = 1 to v-num-parfirst-list
      621     :
      622       assign
      623         v-elem = entry(ind, parfirst-list, pardelim)
      624       .
      625       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      626         assign
      627           v-result-list = v-result-list
      628                         + (if v-result-list > "" then pardelim else "")
      629                         + v-elem
      630         .
      631       end.
      632     end.
      633     def var v-num-parsecond-list as integer no-undo .
      634     assign
      635       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      636     .
      637     do ind = 1 to v-num-parsecond-list
      638     :
      639       assign
      640         v-elem = entry(ind, parsecond-list, pardelim)
      641       .
      642       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      643         assign
      644           v-result-list = v-result-list
      645                         + (if v-result-list > "" then pardelim else "")
      646                         + v-elem
      647         .
      648       end.
      649     end.
      650     return v-result-list .
      651   end function.
      652   function cross-list returns character (
      653    input parfirst-list  as character,
      654    input parsecond-list as character,
      655    input pardelim       as character).
      656     if pardelim = ""
      657     or pardelim = ?
      658     then do:
      659       assign
      660         pardelim = ","
      661       .
      662     end.
      663     def var ind as integer no-undo .
      664     def var v-elem as character no-undo .
      665     def var v-result-list as character no-undo init "".
      666     def var v-num-parfirst-list as integer no-undo .
      667     assign
      668       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      669     .
      670     do ind = 1 to v-num-parfirst-list
      671     :
      672       assign
      673         v-elem = entry(ind, parfirst-list, pardelim)
      674       .
      675       if lookup(v-elem, v-result-list, pardelim) = 0
      676       and lookup(v-elem, parsecond-list, pardelim) > 0
      677       then do:
      678         assign
      679           v-result-list = v-result-list
      680                         + (if v-result-list > "" then pardelim else "")
      681                         + v-elem
      682         .
      683       end.
      684     end.
      685     return v-result-list .
      686   end function.
      687   function radio-label returns character (
      688    input par-rs-value  as character,
      689    input par-rs-radio-buttons as character)
      690    .
      691    DEFINE variable v-result-label as character no-undo.
      692    assign
      693    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      694                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      695                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      696                             ), par-rs-radio-buttons
      697                           )
      698    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      699    .
      700   return v-result-label.
      701   end function.
      702   function m-radio-label returns character (
      703    input par-rs-value  as character,
      704    input par-rs-radio-buttons as character,
      705    input par-delim as character
      706    )
      707    .
      708    DEFINE variable v-result-label as character no-undo.
      709    assign
      710    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      711                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      712                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      713                             ), par-rs-radio-buttons, par-delim
      714                           )
      715    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      716    .
      717   return v-result-label.
      718   end function.
      719   FUNCTION mixlist returns character
      720   (
      721    input parfirst-list  as character
      722    ,input parsecond-list as character
      723    ,input pardelim       as character
      724    ,input pardelim-result as character ) :
      725     if pardelim = ""
      726     or pardelim = ?
      727     then do:
      728       assign
      729         pardelim = ","
      730       .
      731     end.
      732     def var ind as integer no-undo .
      733     def var v-elem1 as character no-undo .
      734     def var v-elem2 as character no-undo .
      735     def var v-result-list as character no-undo init "".
      736     do ind = 1 to num-entries(parfirst-list, pardelim)
      737     :
      738       assign
      739         v-elem1 = entry(ind, parfirst-list, pardelim)
      740         v-elem2 = entry(ind, parsecond-list, pardelim)
      741       .
      742         assign
      743           v-result-list = v-result-list
      744                         + (if v-result-list > "" then pardelim-result else "")
      745                         + v-elem1 + pardelim-result + v-elem2
      746         .
      747     end.
      748     return v-result-list .
      749   END FUNCTION.
