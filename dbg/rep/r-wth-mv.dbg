     2556       else v-chk-type =  ENTRY(LOOKUP(tt-rep-doc.ext-doc-type, 'ie,ee,ii,ei,ij,ej,fj,jj,pj,oj,we,ci,ce,iy,rj,ip,ep,rp,ff,ef,rf,pc,ps,pz,df,dp,dc,de,xc':u), 'приход внешний,расход внешний,приход внутренний,расход внутренний,приход внутри объекта,расход внутри объекта,приход внутриобъектн. в своб. зону,расход внутриобъектн. из своб. зоны,приход внутриобъектн. в зону погаш.,расход внутриобъектн. из зоны погаш.,списание,приход внешний через кассы,возврат покупателю через кассы,инвентаризация,возврат внутренний,приход внутр. в зону погашения,расход внутр. из зоны погашения,возврат внутр. в зону погашения,приход внутр. в своб. зону,расход внутр. из своб. зоны,возврат внутр. в своб зону,погашение через кассу,погашение за реализованное топливо,возврат от покупателя,уничтожение в свободной зоне,уничтожение в зоне погашения,уничтожение в зоне клиента,декларация,обмен':u).
     2557       DISPLAY STREAM PrnLibStream
     2558    '                     '  + v-chk-type
     2559        @ v-wth-name
     2560          with frame f-wth
     2561   .
     2562   end.
     2563   assign
     2564       v-wth-name = wealth.wth-name
     2565       v-doc-date = tt-rep-doc.fact-date
     2566       v-doc-code = tt-rep-doc.doc-code
     2567       v-sum      = (if (tt-rep-doc.doc-type = 'рас':U or tt-rep-doc.doc-type = 'спи':U) then 0 - tt-rep-doc.fact-sum else tt-rep-doc.fact-sum )
     2568       v-type-sum = v-type-sum + v-sum
     2569   .
     2570   if tt-rep-doc.inter_ = yes
     2571   then do:
     2572       find first buf_out_wth-place no-lock
     2573            where buf_out_wth-place.host-code = tt-rep-doc.host-code
     2574             and  buf_out_wth-place.obj-type = tt-rep-doc.obj-type
     2575             and  buf_out_wth-place.obj-code = tt-rep-doc.obj-code
     2576             and  buf_out_wth-place.w-p-code = tt-rep-doc.out-code
     2577       .
     2578       assign
     2579           v-deliver  = (if     tt-rep-doc.doc-type = 'при':U
     2580                           then buf_out_wth-place.w-p-name
     2581                           else buf_wth-place.w-p-name
     2582                        )
     2583           v-receiver = (if     tt-rep-doc.doc-type = 'при':U
     2584                           then buf_wth-place.w-p-name
     2585                           else buf_out_wth-place.w-p-name
     2586                        )
     2587       .
     2588   end.
     2589   else do:
     2590       assign
     2591           v-deliver  = (if     tt-rep-doc.doc-type = 'при':U
     2592                           then tt-rep-doc.cli-name
     2593                           else buf_wth-place.w-p-name
     2594                       )
     2595           v-receiver = (if     tt-rep-doc.doc-type = 'при':U
     2596                           then buf_wth-place.w-p-name
     2597                           else tt-rep-doc.cli-name
     2598                       )
     2599       .
     2600   end.
     2601   DISPLAY STREAM PrnLibStream
     2602           v-doc-date
     2603           v-doc-code
     2604           v-deliver
     2605           v-receiver
     2606           v-sum
     2607           sym1 sym2 sym3 sym4 sym5 sym6 sym7
     2608           with frame f-wth
     2609   .
     2610   DOWN STREAM PrnLibStream 1 with frame f-wth .
     2611   if last-of(tt-rep-doc.chk-type) or
     2612      (last-of(tt-rep-doc.ext-doc-type) and not tt-rep-doc.chk-type = 0)
     2613    then do:
     2614     v-sum = v-type-sum.
     2615       DISPLAY STREAM PrnLibStream
     2616       '               Итого ' + v-chk-type  @ v-wth-name
     2617       v-sum
     2618       sym1 sym2 sym3 sym4 sym5 sym6 sym7
     2619       with frame f-wth
     2620       .
     2621   DOWN STREAM PrnLibStream 1 with frame f-wth .
     2622   end.
     2623   if last-of(tt-rep-doc.w-p-code) then do:
     2624        if x-radio-task <> 4 or x-date-start = x-date-end
     2625     then do:
     2626               run wth-lib_full-inf-shift-place(
     2627                                     input  buf_clients.obj-type
     2628                                   , input  buf_clients.obj-code
     2629                                   , input  tt-rep-doc.wth-code
     2630                                   , input  tt-rep-doc.w-p-code
     2631                                   , input  x-date-end
     2632                                     , input  x-shift-end
     2633                                   , output parstock-start
     2634                                   , output parstock-end
     2635                                   , output parincome
     2636                                   , output parincome-cassa
     2637                                   , output parincome-other
     2638                                   , output parincass
     2639                                   , output parincass-bank
     2640                                   , output parincass-other
     2641                                   , output parincass-cassa
     2642             ).
     2643             display stream PrnLibStream
     2644                     "     Остаток на конец  периода по " + buf_wth-place.w-p-name @ v-wth-name
     2645                     parstock-end @ v-sum
     2646                     sym1 sym2 sym3 sym4 sym5 sym6 sym7
     2647                     with frame f-wth
     2648             .
     2649             down stream PrnLibStream 1 with frame f-wth .
     2650         end.
     2651   end.
     2652   if last-of (tt-rep-doc.wth-code)
     2653   then do:
     2654      if x-radio-task <> 4 or x-date-start = x-date-end
     2655      then do:
     2656         for each wth-place
     2657            where wth-place.host-code = buf_clients.host-code
     2658            and wth-place.obj-type  = buf_clients.obj-type
     2659            and wth-place.obj-code  = buf_clients.obj-code
     2660            and not can-find(first buf_tt-doc where buf_tt-doc.w-p-code = wth-place.w-p-code and buf_tt-doc.wth-code = tt-rep-doc.wth-code):
     2661                   run wth-lib_full-inf-shift-place(
     2662                                         input  buf_clients.obj-type
     2663                                       , input  buf_clients.obj-code
     2664                                       , input  tt-rep-doc.wth-code
     2665                                       , input  wth-place.w-p-code
     2666                                       , input  x-date-end
     2667                                         , input  x-shift-end
     2668                                       , output parstock-start
     2669                                       , output parstock-end
     2670                                       , output parincome
     2671                                       , output parincome-cassa
     2672                                       , output parincome-other
     2673                                       , output parincass
     2674                                       , output parincass-bank
     2675                                       , output parincass-other
     2676                                       , output parincass-cassa
     2677                 ).
     2678                 display stream PrnLibStream
     2679                         "     Остаток на конец  периода по " + wth-place.w-p-name @ v-wth-name
     2680                         parstock-end @ v-sum
     2681                         sym1 sym2 sym3 sym4 sym5 sym6 sym7
     2682                         with frame f-wth
     2683                 .
     2684                 down stream PrnLibStream 1 with frame f-wth .
     2685         end.
     2686           run wth-lib_full-inf-shift (
     2687                                             input buf_clients.obj-type
     2688                                           , input buf_clients.obj-code
     2689                                           , input tt-rep-doc.wth-code
     2690                                           , input x-date-end
     2691                                           , input  x-shift-end
     2692                                           , output  parstock-start
     2693                                           , output  parstock-end
     2694                                           , output  parincome
     2695                                           , output  parincome-cassa
     2696                                           , output  parincome-other
     2697                                           , output  parincass
     2698                                           , output  parincass-bank
     2699                                           , output  parincass-other
     2700                                           , output  parincass-cassa
     2701                                           ).
     2702       display stream PrnLibStream
     2703               "   Остаток на конец  Всего на АЗК" @ v-wth-name
     2704               parstock-end @ v-sum
     2705               sym1 sym2 sym3 sym4 sym5 sym6 sym7
     2706               with frame f-wth
     2707       .
     2708       down stream PrnLibStream 1 with frame f-wth .
     2709     end.
     2710   end.
     2711           end.
     2712   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2713   if x-radio-task <> 4 or x-date-start = x-date-end then do:
     2714    for each buf_wealth no-lock where
     2715         not can-find(first tt-rep-doc where tt-rep-doc.wth-code = buf_wealth.wth-code )
     2716         and ((p-wth-ser and buf_wealth.is-ser = 1) or
     2717             (p-wth-money and buf_wealth.is-money) or
     2718             (p-wth-un and buf_wealth.is-ser = 0 and not buf_wealth.is-money )) :
     2719             DISPLAY STREAM PrnLibStream
     2720                   buf_wealth.wth-name @ v-wth-name
     2721                   sym1 sym2 sym3 sym4 sym5 sym6 sym7
     2722                   with frame f-wth
     2723           .
     2724           down stream PrnLibStream 1 with frame f-wth .
     2725         for each ub.wth-place
     2726            where ub.wth-place.host-code = buf_clients.host-code
     2727            and ub.wth-place.obj-type  = buf_clients.obj-type
     2728            and ub.wth-place.obj-code  = buf_clients.obj-code:
     2729                   run wth-lib_full-inf-shift-place(
     2730                                         input  buf_clients.obj-type
     2731                                       , input  buf_clients.obj-code
     2732                                       , input  buf_wealth.wth-code
     2733                                       , input  wth-place.w-p-code
     2734                                       , input  x-date-end
     2735                                         , input  x-shift-end
     2736                                       , output parstock-start
     2737                                       , output parstock-end
     2738                                       , output parincome
     2739                                       , output parincome-cassa
     2740                                       , output parincome-other
     2741                                       , output parincass
     2742                                       , output parincass-bank
     2743                                       , output parincass-other
     2744                                       , output parincass-cassa
     2745                 ).
     2746                 display stream PrnLibStream
     2747                         "     Остаток на конец  периода по " + wth-place.w-p-name @ v-wth-name
     2748                         parstock-end @ v-sum
     2749                         sym1 sym2 sym3 sym4 sym5 sym6 sym7
     2750                         with frame f-wth
     2751                 .
     2752                 down stream PrnLibStream 1 with frame f-wth .
     2753         end.
     2754               run wth-lib_full-inf-shift (
     2755                                                 input buf_clients.obj-type
     2756                                               , input buf_clients.obj-code
     2757                                               , input buf_wealth.wth-code
     2758                                               , input x-date-end
     2759                                               , input  x-shift-end
     2760                                           , output  parstock-start
     2761                                           , output  parstock-end
     2762                                           , output  parincome
     2763                                           , output  parincome-cassa
     2764                                           , output  parincome-other
     2765                                           , output  parincass
     2766                                           , output  parincass-bank
     2767                                           , output  parincass-other
     2768                                           , output  parincass-cassa
     2769                                           ).
     2770       display stream PrnLibStream
     2771               "   Остаток на конец  Всего на АЗК" @ v-wth-name
     2772               parstock-end @ v-sum
     2773               sym1 sym2 sym3 sym4 sym5 sym6 sym7
     2774               with frame f-wth
     2775       .
     2776       down stream PrnLibStream 1 with frame f-wth .
     2777    end.
     2778   end.
     2779     end.
     2780   end case.
     2781   put stream PrnLibStream
     2782     skip
     2783       v-single-line format "X(178)" at 3 + 1
     2784   .
     2785   hide stream PrnLibStream frame bottomframe .
     2786   output stream PrnLibStream close.
     2787   run prn-lib-prn-file in this-procedure (
     2788                                             input my-handle
     2789                                             ,input 8
     2790                                             ).
     2791   end.
     2792   procedure r-wth-fill-tt:
     2793         if b_wth-doc.doc-type = 'de':U and b_wth-doc.doc-type = 'dc':U then return.
     2794               create tt-rep-doc.
     2795               buffer-copy buf_wth-line to tt-rep-doc.
     2796               buffer-copy b_wth-doc using cli-name host-code inter_ doc-type ext-doc-type exter_ to tt-rep-doc.
     2797               if b_wth-doc.source-type = 'касса':U
     2798               then tt-rep-doc.chk-type = 99.
     2799               else if b_wth-doc.auto-fill and b_wth-doc.borned = no then
     2800               for first buf_chk-doc no-lock
     2801                where buf_chk-doc.out-code = b_wth-doc.doc-code
     2802                and buf_chk-doc.obj-type   = b_wth-doc.obj-type
     2803                and buf_chk-doc.obj-code   = b_wth-doc.obj-code:
     2804                tt-rep-doc.chk-type = buf_chk-doc.chk-type.
     2805                tt-rep-doc.ext-doc-type = ''.
     2806               end.
     2807               else if b_wth-doc.auto-fill and b_wth-doc.borned = yes then
     2808                 for first buf_wth-doc no-lock where
     2809                   buf_wth-doc.doc-code = b_wth-doc.source-ref
     2810                   and buf_wth-doc.auto-fill = yes
     2811                ,first buf_chk-doc no-lock
     2812                where buf_chk-doc.out-code = buf_wth-doc.doc-code
     2813                and buf_chk-doc.obj-type   = buf_wth-doc.obj-type
     2814                and buf_chk-doc.obj-code   = buf_wth-doc.obj-code:
     2815                tt-rep-doc.chk-type = buf_chk-doc.chk-type .
     2816                tt-rep-doc.ext-doc-type = ''.
     2817               end.
     2818               else tt-rep-doc.chk-type = 99.
     2819               if tt-rep-doc.chk-type = 7 then delete tt-rep-doc.
     2820   end procedure.
