     1220   run get-report-num in my-handle ( output g#report-num ).
     1221   run get-gds-engl in my-handle ( output g#gds-engl ) .
     1222   do
     1223   on error undo, return error
     1224   :
     1225   define variable sym1 as char init "|" no-undo.
     1226   define variable sym2 as char init ":" no-undo.
     1227   define variable sym3 as char init ":" no-undo.
     1228   define variable sym4 as char init ":" no-undo.
     1229   define variable sym5 as char init ":" no-undo.
     1230   define variable sym6 as char init ":" no-undo.
     1231   define variable sym7 as char init "|" no-undo.
     1232   define variable v-wth-name like ub.wealth.wth-name    no-undo.
     1233   define variable v-doc-date like ub.wth-line.fact-date no-undo.
     1234   define variable v-chk-type as   char               no-undo.
     1235   define variable v-doc-code like ub.wth-doc.doc-code   no-undo.
     1236   define variable v-deliver  like ub.clients.obj-name   no-undo.
     1237   define variable v-receiver like ub.clients.obj-name   no-undo.
     1238   define variable v-sum      like ub.wth-line.fact-sum  no-undo.
     1239   def frame f-wth
     1240           space(2)
     1241           sym1 column-label "|" format "X(1)" space(1)
     1242           v-wth-name COLUMN-LABEL "                      1" format "X(56)"
     1243           sym2 column-label ":" format "X(1)" space(0)
     1244           v-doc-date COLUMN-LABEL "    2" format "99/99/9999" space(0)
     1245           sym3 column-label ":" format "X(1)" space(1)
     1246           v-doc-code COLUMN-LABEL "        3" format "X(16)" space(1)
     1247           sym4 column-label ":" format "X(1)" space(1)
     1248           v-deliver  COLUMN-LABEL "             4" format "X(31)" space(1)
     1249           sym5 column-label ":" format "X(1)" space(1)
     1250           v-receiver COLUMN-LABEL "             5" format "X(31)" space(1)
     1251           sym6 column-label ":" format "X(1)" space(1)
     1252           v-sum      COLUMN-LABEL "6     " format "->>>,>>>,>>>,>>9.99" space(1)
     1253           sym7 column-label "|" format "X(1)" space(1)
     1254       with width 235 down stream-io
     1255   .
     1256   def temp-table tt-rep-doc     like ub.wth-line
     1257     field chk-type like ub.chk-doc.chk-type
     1258     field host-code like ub.wth-doc.host-code
     1259     field doc-type like ub.wth-doc.doc-type
     1260     field inter_ like ub.wth-doc.inter_
     1261     field exter_ like ub.wth-doc.exter_
     1262     field cli-name like ub.wth-doc.cli-name.
     1263   def buffer buf_tt-doc         for tt-rep-doc.
     1264   def buffer buf_wth-doc        for ub.wth-doc.
     1265   def buffer b_wth-doc          for ub.wth-doc.
     1266   def buffer buf_wth-line       for ub.wth-line.
     1267   def buffer buf_wth-dtl        for ub.wth-dtl.
     1268   def buffer buf_clients        for ub.clients.
     1269   def buffer buf_wth-place      for ub.wth-place.
     1270   def buffer buf_out_wth-place  for ub.wth-place.
     1271   define buffer buf_chk-doc   for ub.chk-doc.
     1272   define buffer buf_wealth      for ub.wealth.
     1273   def stream PrnLibStream .
     1274   define variable v-organization  like ub.clients.obj-name no-undo.
     1275   define variable v-org-to        as char no-undo.
     1276   define variable v-org-from      as char no-undo.
     1277   define variable v-temp-string   as char no-undo.
     1278   define variable v-line-count    as int  no-undo.
     1279   define variable v-single-line   as char no-undo.
     1280   define variable v-type-sum      as dec no-undo.
     1281   define variable parstock-start  like ub.wth-line.income       no-undo.
     1282   define variable parstock-end    like ub.wth-line.income       no-undo.
     1283   define variable parincome       like ub.wth-line.income       no-undo.
     1284   define variable parincome-cassa like ub.wth-line.income-cassa no-undo.
     1285   define variable parincome-other like ub.wth-line.income-other no-undo.
     1286   define variable parincass       like ub.wth-line.incass       no-undo.
     1287   define variable parincass-bank  like ub.wth-line.incass-bank  no-undo.
     1288   define variable parincass-other like ub.wth-line.incass-other no-undo.
     1289   define variable parincass-cassa like ub.wth-line.incass-cassa no-undo.
     1290   assign v-single-line = fill("-", 185).
     1291   if session:set-wait-state("compiler") then.
     1292   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1293     run mainmenu_getcntxt in my-handle
     1294       (output v-cntxt-db-num
     1295       ,output v-cntxt-userid
     1296       ,output v-cntxt-level
     1297       ,output v-cntxt-host-code-obj
     1298       ,output v-cntxt-obj-type
     1299       ,output v-cntxt-obj-code
     1300       ,output v-cntxt-db-num-obj
     1301       ,output v-cntxt-is-admin
     1302       ) .
     1303   run prn-lib-open-stream  in this-procedure (
     1304                                                input my-handle
     1305                                               ,input 43
     1306                                               ,input yes
     1307                                               ,input no
     1308                                               ).
     1309   form header
     1310       v-single-line format "x(185)" at 1 skip
     1311       "продолжение - на следующей странице" AT 30 SKIP
     1312       with frame bottomframe width 235 page-bottom no-labels no-box .
     1313   view stream PrnLibStream frame bottomframe .
     1314   find first buf_clients no-lock
     1315     where buf_clients.obj-type = v-cntxt-obj-type
     1316       and buf_clients.obj-code = v-cntxt-obj-code
     1317   .
     1318   assign
     1319   v-organization = buf_clients.obj-name
     1320   .
     1321   case x-radio-task :
     1322     when 1 then
     1323        assign
     1324           v-temp-string = "период с " + string(x-date-start) + " по " + string(x-date-end)
     1325        .
     1326     when 2 then
     1327        assign
     1328           v-temp-string = "сменные сутки c " + string(x-date-start) + " по " + string(x-date-end)
     1329        .
     1330     when 3 then
     1331        assign
     1332           v-temp-string = "сменные сутки и номера смен, со смены N"
     1333                     + string(x-shift-start) + " " + string(x-date-start) + " по смену N"
     1334                     + string(x-shift-end)   + " " + string(x-date-end)
     1335        .
     1336     when 4 then
     1337        assign
     1338           v-temp-string = "смену N" + string(x-shift-alone) + ", период с "
     1339                           + string(x-date-start) + " по " + string(x-date-end)
     1340        .
     1341   end case.
     1342     put stream PrnLibStream
     1343         skip
     1344           space (3)
     1345           v-cntxt-host-name-obj format "X(120)"
     1346           string( "Страница " + string( page-number( PrnLibStream ), ">>9" ) )
     1347                             format "X(12)"   at right-field(190 - 1, 12)
     1348         skip
     1349             space (3)
     1350             v-organization format "X(185)"
     1351         skip(2)
     1352           "ОТЧЕТ ПО ДВИЖЕНИЮ МАТЕРИАЛЬНЫХ ЦЕННОСТЕЙ НА АЗК"
     1353                             format "X(47)"   at center-field( 3, 190, 47 )
     1354         skip(2)
     1355           space (3)
     1356           "За " + v-temp-string
     1357                             format "X(185)"
     1358     .
     1359     put stream PrnLibStream
     1360       skip
     1361         v-single-line format "X(178)" at 3 + 1
     1362       skip
     1363         "|" at 3
     1364         "|" at 3 + 59
     1365         "Документ" at center-field(3 + 59, 3 + 89, 8)
     1366         "|" at 3 + 89
     1367         "|" at 3 + 123
     1368         "|" at 3 + 157
     1369         "|" at 3 + 178 + 1
     1370       skip
     1371         "|" at 3
     1372         " Наименование"
     1373         "|" at 3 + 59
     1374         v-single-line format "X(29)" at 3 + 59 + 1
     1375         "|" at 3 + 89
     1376         " Получено"
     1377         "|" at 3 + 123
     1378         " Передано"
     1379         "|" at 3 + 157
     1380         " Сумма"
     1381         "|" at 3 + 178 + 1
     1382       skip
     1383         "|" at 3
     1384         "|" at 3 + 59
     1385         "Дата" at center-field(3 + 59, 3 + 70, 4)
     1386         "|" at 3 + 70
     1387         "Номер" at center-field(3 + 70, 3 + 89, 5)
     1388         "|" at 3 + 89
     1389         " из"
     1390         "|" at 3 + 123
     1391         " в"
     1392         "|" at 3 + 157
     1393         "|" at 3 + 178 + 1
     1394       skip
     1395         "|" at 3
     1396         v-single-line format "X(178)"
     1397         "|"
     1398     .
     1399   form with frame f-wth .
     1400   case x-radio-task :
     1401     when 1
     1402     then do:
     1403           for each b_wth-doc no-lock
     1404             where b_wth-doc.obj-type  = buf_clients.obj-type
     1405               and b_wth-doc.obj-code  = buf_clients.obj-code
     1406               and b_wth-doc.fact-date >= x-date-start
     1407               and b_wth-doc.fact-date <= x-date-end
     1408               and b_wth-doc.status_   = 'факт':U
     1409             ,each buf_wth-line
     1410             where buf_wth-line.doc-code = b_wth-doc.doc-code
     1411             break by b_wth-doc.doc-code by buf_wth-line.wth-code by buf_wth-line.w-p-code
     1412             :
     1413              run r-wth-fill-tt in this-procedure.
     1414           end.
     1415           for each tt-rep-doc no-lock
     1416             , each ub.wealth
     1417             where ub.wealth.wth-code = tt-rep-doc.wth-code
     1418             , each buf_wth-place
     1419             where buf_wth-place.host-code = buf_clients.host-code
     1420               and buf_wth-place.obj-type  = buf_clients.obj-type
     1421               and buf_wth-place.obj-code  = buf_clients.obj-code
     1422               and buf_wth-place.w-p-code  = tt-rep-doc.w-p-code
     1423           break by tt-rep-doc.wth-code by tt-rep-doc.w-p-code by tt-rep-doc.chk-type by tt-rep-doc.ext-doc-type
     1424           by tt-rep-doc.fact-date   by tt-rep-doc.cli-name
     1425           :
     1426   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1427   if (p-wth-ser and wealth.is-ser = 1) or
     1428      (p-wth-money and wealth.is-money) or
     1429      (p-wth-un and wealth.is-ser = 0 and not wealth.is-money ) then.
     1430   else next.
     1431   if first-of (tt-rep-doc.wth-code)
     1432   then do:
     1433       if not first(tt-rep-doc.wth-code)
     1434       then put stream PrnLibStream
     1435           skip
     1436             "|" at 3
     1437             v-single-line format "X(178)"
     1438             "|"
     1439       .
     1440           DISPLAY STREAM PrnLibStream
     1441                   wealth.wth-name @ v-wth-name
     1442                   sym1 sym2 sym3 sym4 sym5 sym6 sym7
     1443                   with frame f-wth
     1444           .
     1445           down stream PrnLibStream 1 with frame f-wth .
     1446       if x-radio-task <> 4 or x-date-start = x-date-end
     1447       then do:
     1448           run wth-lib_full-inf-calend-date (
     1449                                                 input buf_clients.obj-type
     1450                                               , input buf_clients.obj-code
     1451                                               , input tt-rep-doc.wth-code
     1452                                               , input x-date-start
     1453                                               , output  parstock-start
     1454                                               , output  parstock-end
     1455                                               , output  parincome
     1456                                               , output  parincome-cassa
     1457                                               , output  parincome-other
     1458                                               , output  parincass
     1459                                               , output  parincass-bank
     1460                                               , output  parincass-other
     1461                                               , output  parincass-cassa
     1462                                     ).
     1463           display stream PrnLibStream
     1464                   "   Остаток на начало Всего на АЗК" @ v-wth-name
     1465                   parstock-start  @ v-sum
     1466                   sym1 sym2 sym3 sym4 sym5 sym6 sym7
     1467                   with frame f-wth
     1468           .
     1469           down stream PrnLibStream 1 with frame f-wth .
     1470       end.
     1471   end.
     1472   if first-of(tt-rep-doc.w-p-code) then do:
     1473     if x-radio-task <> 4 or x-date-start = x-date-end then do:
     1474               run wth-lib_full-inf-calend-date-place(
     1475                                       input  buf_clients.obj-type
     1476                                     , input  buf_clients.obj-code
     1477                                     , input  tt-rep-doc.wth-code
     1478                                     , input  tt-rep-doc.w-p-code
     1479                                     , input  x-date-start
     1480                                     , output parstock-start
     1481                                     , output parstock-end
     1482                                     , output parincome
     1483                                     , output parincome-cassa
     1484                                     , output parincome-other
     1485                                     , output parincass
     1486                                     , output parincass-bank
     1487                                     , output parincass-other
     1488                                     , output parincass-cassa
     1489               ).
     1490               display stream PrnLibStream
     1491                       "     Остаток на начало периода по " + buf_wth-place.w-p-name  @ v-wth-name
     1492                       parstock-start @ v-sum
     1493                       sym1 sym2 sym3 sym4 sym5 sym6 sym7
     1494                       with frame f-wth
     1495               .
     1496               down stream PrnLibStream 1 with frame f-wth .
     1497     end.
     1498     else do:
     1499               display stream PrnLibStream
     1500                       "     " + buf_wth-place.w-p-name  @ v-wth-name
     1501                       parstock-start @ v-sum
     1502                       sym1 sym2 sym3 sym4 sym5 sym6 sym7
     1503                       with frame f-wth
     1504               .
     1505               down stream PrnLibStream 1 with frame f-wth .
     1506     end.
     1507   end.
     1508   if first-of(tt-rep-doc.chk-type) or
     1509      first-of(tt-rep-doc.ext-doc-type)
     1510    then do:
     1511    v-type-sum = 0.
     1512       if tt-rep-doc.chk-type <> 99 then case tt-rep-doc.chk-type:
     1513         when 0 then v-chk-type = 'Реализация'.
     1514         when 2 then v-chk-type = 'Инкассация'.
     1515         when 3 then v-chk-type = 'Кассовый фонд'.
     1516         when 4 then v-chk-type = 'Перевод оплаты'.
     1517         when 5 then v-chk-type = 'Выплата'.
     1518         otherwise  v-chk-type =  'Прочее'.
     1519       end.
     1520       else v-chk-type =  ENTRY(LOOKUP(tt-rep-doc.ext-doc-type, 'ie,ee,ii,ei,ij,ej,fj,jj,pj,oj,we,ci,ce,iy,rj,ip,ep,rp,ff,ef,rf,pc,ps,pz,df,dp,dc,de,xc':u), 'приход внешний,расход внешний,приход внутренний,расход внутренний,приход внутри объекта,расход внутри объекта,приход внутриобъектн. в своб. зону,расход внутриобъектн. из своб. зоны,приход внутриобъектн. в зону погаш.,расход внутриобъектн. из зоны погаш.,списание,приход внешний через кассы,возврат покупателю через кассы,инвентаризация,возврат внутренний,приход внутр. в зону погашения,расход внутр. из зоны погашения,возврат внутр. в зону погашения,приход внутр. в своб. зону,расход внутр. из своб. зоны,возврат внутр. в своб зону,погашение через кассу,погашение за реализованное топливо,возврат от покупателя,уничтожение в свободной зоне,уничтожение в зоне погашения,уничтожение в зоне клиента,декларация,обмен':u).
     1521       DISPLAY STREAM PrnLibStream
     1522    '                     '  + v-chk-type
     1523        @ v-wth-name
     1524          with frame f-wth
     1525   .
     1526   end.
     1527   assign
     1528       v-wth-name = wealth.wth-name
     1529       v-doc-date = tt-rep-doc.fact-date
     1530       v-doc-code = tt-rep-doc.doc-code
     1531       v-sum      = (if (tt-rep-doc.doc-type = 'рас':U or tt-rep-doc.doc-type = 'спи':U) then 0 - tt-rep-doc.fact-sum else tt-rep-doc.fact-sum )
     1532       v-type-sum = v-type-sum + v-sum
     1533   .
     1534   if tt-rep-doc.inter_ = yes
     1535   then do:
     1536       find first buf_out_wth-place no-lock
