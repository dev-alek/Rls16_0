     1538             and  buf_out_wth-place.obj-type = tt-rep-doc.obj-type
     1539             and  buf_out_wth-place.obj-code = tt-rep-doc.obj-code
     1540             and  buf_out_wth-place.w-p-code = tt-rep-doc.out-code
     1541       .
     1542       assign
     1543           v-deliver  = (if     tt-rep-doc.doc-type = 'при':U
     1544                           then buf_out_wth-place.w-p-name
     1545                           else buf_wth-place.w-p-name
     1546                        )
     1547           v-receiver = (if     tt-rep-doc.doc-type = 'при':U
     1548                           then buf_wth-place.w-p-name
     1549                           else buf_out_wth-place.w-p-name
     1550                        )
     1551       .
     1552   end.
     1553   else do:
     1554       assign
     1555           v-deliver  = (if     tt-rep-doc.doc-type = 'при':U
     1556                           then tt-rep-doc.cli-name
     1557                           else buf_wth-place.w-p-name
     1558                       )
     1559           v-receiver = (if     tt-rep-doc.doc-type = 'при':U
     1560                           then buf_wth-place.w-p-name
     1561                           else tt-rep-doc.cli-name
     1562                       )
     1563       .
     1564   end.
     1565   DISPLAY STREAM PrnLibStream
     1566           v-doc-date
     1567           v-doc-code
     1568           v-deliver
     1569           v-receiver
     1570           v-sum
     1571           sym1 sym2 sym3 sym4 sym5 sym6 sym7
     1572           with frame f-wth
     1573   .
     1574   DOWN STREAM PrnLibStream 1 with frame f-wth .
     1575   if last-of(tt-rep-doc.chk-type) or
     1576      (last-of(tt-rep-doc.ext-doc-type) and not tt-rep-doc.chk-type = 0)
     1577    then do:
     1578     v-sum = v-type-sum.
     1579       DISPLAY STREAM PrnLibStream
     1580       '               Итого ' + v-chk-type  @ v-wth-name
     1581       v-sum
     1582       sym1 sym2 sym3 sym4 sym5 sym6 sym7
     1583       with frame f-wth
     1584       .
     1585   DOWN STREAM PrnLibStream 1 with frame f-wth .
     1586   end.
     1587   if last-of(tt-rep-doc.w-p-code) then do:
     1588        if x-radio-task <> 4 or x-date-start = x-date-end
     1589     then do:
     1590               run wth-lib_full-inf-calend-date-place(
     1591                                     input  buf_clients.obj-type
     1592                                   , input  buf_clients.obj-code
     1593                                   , input  tt-rep-doc.wth-code
     1594                                   , input  tt-rep-doc.w-p-code
     1595                                   , input  x-date-end
     1596                                   , output parstock-start
     1597                                   , output parstock-end
     1598                                   , output parincome
     1599                                   , output parincome-cassa
     1600                                   , output parincome-other
     1601                                   , output parincass
     1602                                   , output parincass-bank
     1603                                   , output parincass-other
     1604                                   , output parincass-cassa
     1605             ).
     1606             display stream PrnLibStream
     1607                     "     Остаток на конец  периода по " + buf_wth-place.w-p-name @ v-wth-name
     1608                     parstock-end @ v-sum
     1609                     sym1 sym2 sym3 sym4 sym5 sym6 sym7
     1610                     with frame f-wth
     1611             .
     1612             down stream PrnLibStream 1 with frame f-wth .
     1613         end.
     1614   end.
     1615   if last-of (tt-rep-doc.wth-code)
     1616   then do:
     1617      if x-radio-task <> 4 or x-date-start = x-date-end
     1618      then do:
     1619         for each wth-place
     1620            where wth-place.host-code = buf_clients.host-code
     1621            and wth-place.obj-type  = buf_clients.obj-type
     1622            and wth-place.obj-code  = buf_clients.obj-code
     1623            and not can-find(first buf_tt-doc where buf_tt-doc.w-p-code = wth-place.w-p-code and buf_tt-doc.wth-code = tt-rep-doc.wth-code):
     1624                   run wth-lib_full-inf-calend-date-place(
     1625                                         input  buf_clients.obj-type
     1626                                       , input  buf_clients.obj-code
     1627                                       , input  tt-rep-doc.wth-code
     1628                                       , input  wth-place.w-p-code
     1629                                       , input  x-date-end
     1630                                       , output parstock-start
     1631                                       , output parstock-end
     1632                                       , output parincome
     1633                                       , output parincome-cassa
     1634                                       , output parincome-other
     1635                                       , output parincass
     1636                                       , output parincass-bank
     1637                                       , output parincass-other
     1638                                       , output parincass-cassa
     1639                 ).
     1640                 display stream PrnLibStream
     1641                         "     Остаток на конец  периода по " + wth-place.w-p-name @ v-wth-name
     1642                         parstock-end @ v-sum
     1643                         sym1 sym2 sym3 sym4 sym5 sym6 sym7
     1644                         with frame f-wth
     1645                 .
     1646                 down stream PrnLibStream 1 with frame f-wth .
     1647         end.
     1648       run wth-lib_full-inf-calend-date (
     1649                                             input buf_clients.obj-type
     1650                                           , input buf_clients.obj-code
     1651                                           , input tt-rep-doc.wth-code
     1652                                           , input x-date-end
     1653                                           , output  parstock-start
     1654                                           , output  parstock-end
     1655                                           , output  parincome
     1656                                           , output  parincome-cassa
     1657                                           , output  parincome-other
     1658                                           , output  parincass
     1659                                           , output  parincass-bank
     1660                                           , output  parincass-other
     1661                                           , output  parincass-cassa
