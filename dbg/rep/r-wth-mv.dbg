     1145       (input this-procedure
     1146       ) .
     1147   end .
     1148   on alt-shift-f2 anywhere do:
     1149     run proc-alt-shift-f2.
     1150   end.
     1151   on alt-shift-f3 anywhere do:
     1152     run proc-alt-shift-f3 in this-procedure .
     1153   end.
     1154   on alt-shift-f4 anywhere do:
     1155     run proc-alt-shift-f4 in this-procedure.
     1156   end.
     1157   on alt-f1 anywhere do:
     1158     run proc-alt-f1 in this-procedure .
     1159   end.
     1160   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
