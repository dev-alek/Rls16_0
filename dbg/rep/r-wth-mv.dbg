       76   define  stream PrnLibStream.
       77   procedure prn-lib-prn-file :
       78     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
       79     define input parameter p-DIsabledoptions as integer no-undo .
       80     define variable v-report-name as character no-undo .
       81     define variable v-user-action as character no-undo .
       82     define variable v-printed     as logical   no-undo .
       83     define variable v-exist       as logical   no-undo .
       84     do
       85       on error undo, return error
       86       :
       87       run prn-lib-get-report-name  in this-procedure (
       88         input parParentProc
       89         ,output v-report-name
       90         ).
       91   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       92   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
       93     (input  v-report-name
       94     ,input  2
       95     ,output v-exist
       96     )  .
       97       if NOT v-exist then
       98       DO:
       99         Message
      100           "Нет заданий на печать ! "
      101           view-as alert-box .
      102         Return  .
      103       End.
      104       run gbl/prnfilen.w
      105         (input  ""
      106         ,input  p-DisabledOptions
      107         ,input  string(v-report-name )
      108         ,input  7
      109         ,output v-user-action
      110         ,output v-printed
      111         ) .
      112       if v-printed then
