      122   procedure prn-lib-open-stream :
      123     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      124     define input parameter p-page-size    as integer no-undo .
      125     define input parameter p-is-stream    as logical no-undo .
      126     define input parameter p-append       as logical no-undo .
      127     define variable v-report-name as character no-undo .
      128     do
      129       on error undo, return error
      130       :
      131       run prn-lib-get-report-name  in this-procedure (
      132         input parParentProc
      133         ,output v-report-name
      134         ).
      135       if p-is-stream then
      136       do:
      137         if p-append then
      138         do:
      139           output stream PrnLibStream to value( v-report-name )
      140             page-size value(p-page-size) append .
      141         end.
      142         if not p-append then
      143         do:
      144           output stream PrnLibStream to value( v-report-name )
      145             page-size value(p-page-size) .
      146         end.
      147       end.
      148       if not p-is-stream then
      149       do:
      150         if p-append then
      151         do:
      152           output to value( v-report-name )
      153             page-size value(p-page-size) append .
      154         end.
      155         if not p-append then
      156         do:
      157           output to value( v-report-name )
      158             page-size value(p-page-size) .
      159         end.
      160       end.
      161     end.
      162   end procedure.
      163   procedure prn-lib-open-exp :
      164     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      165     define input parameter p-is-stream    as logical no-undo .
      166     define input parameter p-is-append    as logical no-undo .
      167     define output parameter p-ReportFileName as char init "report" no-undo.
      168     define output parameter p-process as logical no-undo .
      169     define variable glog as logical no-undo .
      170     do
      171       on error undo, return error
      172       :
      173       SYSTEM-DIALOG GET-FILE p-ReportFileName
      174         TITLE      "Укажите путь"
      175         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      176         ASK-OVERWRITE
      177         CREATE-TEST-FILE
      178         SAVE-AS
      179         USE-FILENAME
      180         DEFAULT-EXTENSION "txt"
      181         UPDATE glog
      182         .
      183       if not glog then  return.
      184       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      185       if p-is-stream then
      186       do:
      187         if p-is-append then
      188         do:
      189           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      190         end.
      191         else
      192         do:
      193           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      194         end.
      195       end.
      196       else
      197       do:
      198         if p-is-append then
      199         do:
      200           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      201         end.
      202         else
      203         do:
      204           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      205         end.
      206       end.
      207       p-process = yes.
      208     end.
      209   end procedure.
      210   procedure prn-lib-get-report-name :
