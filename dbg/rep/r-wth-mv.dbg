      220   procedure prn-lib-reportviewer :
      221     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      222     define input parameter p-report-name-html as character no-undo .
      223     define input parameter p-param        as character no-undo .
      224     define variable v-excel           as character no-undo init 'TRUE' .
      225     define variable v-value-character as character no-undo .
      226     define variable v-value-integer   as character no-undo .
      227     define variable v-value-date      as date      no-undo .
      228     define variable v-value-decimal   as decimal   no-undo .
      229     define variable rep-excel         as logical   no-undo .
      230     define variable excel-string      as character no-undo .
      231     define variable v-param-type      as character no-undo .
      232     define variable v-tth             as handle    no-undo .
      233     run adm/shattri.p (
      234       input "get":U
      235       ,input  ""
      236       ,input  0
      237       ,input  'report-glob':U
      238       ,input  'rep-excel':U
      239       ,output v-value-character
      240       ,output v-value-date
      241       ,output v-value-decimal
      242       ,output v-value-integer
      243       ,output rep-excel
      244       ,output v-param-type
      245       ,INPUT-OUTPUT table-handle v-tth
      246       )  .
      247     if rep-excel then v-excel = "TRUE" .
      248     else v-excel = "FALSE" .
      249     if p-param eq ""
      250     then
      251        p-param = "EXCEL:" + v-excel.
      252     else
      253        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      254     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      255   end procedure.
      256   define variable vss-include-info3 as character format "X(65)" no-undo
      257   initial "@(#)$Workfile$ $Revision$".
      258   define temp-table temp_p-fmt_string-part no-undo
      259       field str-key       as integer
      260       field string-part   as character
      261       index pi is primary unique
      262           str-key
      263   .
      264   define variable v-p-fmt-3-str-key    as integer      no-undo.
      265   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
      266                                     iInput AS INTEGER).
      267     def var v-start-print as integer no-undo .
      268     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
      269     assign
      270       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
      271     .
      272     RETURN v-start-print .
      273   END FUNCTION.
      274   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
      275                                     iInput AS INTEGER).
      276     def var v-start-print as integer no-undo .
      277     assign
      278       v-start-print = INTEGER(iEndPix - 1 - iInput)
      279     .
      280     if v-start-print < 0 then return 0.
      281     RETURN v-start-print .
      282   END FUNCTION.
      283   function p-fmt-align-string returns character (
      284         p-in-string      as character
      285       , p-page-width     as integer
      286       , p-align-type     as character
      287   ).
      288       define variable v-string-length     as integer      no-undo.
      289       define variable v-out-string        as character    no-undo.
      290       assign
      291           v-string-length = length( trim( p-in-string ) )
      292       .
      293       if v-string-length >= p-page-width
      294       then do:
      295           assign
      296               v-out-string = trim( p-in-string )
      297           .
      298       end.
      299       else do:
      300           case p-align-type
      301           :
      302               when 'left':U
      303               then do:
      304                   assign
      305                       v-out-string = trim( p-in-string )
      306                   .
      307               end.
      308               when 'right':U
      309               then do:
      310                   assign
      311                       v-out-string = fill( " ":U, p-page-width - v-string-length ) + trim( p-in-string )
      312                   .
      313               end.
      314               when 'center':U
      315               then do:
      316                   assign
      317                       v-out-string = fill( " ":U, integer( ( p-page-width - v-string-length ) / 2 ) ) + trim( p-in-string )
      318                   .
      319               end.
      320           end case.
      321       end.
      322       return v-out-string .
      323   end function.
      324   procedure p-fmt-split-string :
      325   define input parameter p-source-string  as character        no-undo.
      326   define input parameter p-split-length   as integer          no-undo.
      327   define output parameter p-string-1      as character        no-undo.
      328   define output parameter p-string-2      as character        no-undo.
      329   do
      330   on error undo, return error
      331   :
      332       define variable v-space-pos    as integer      no-undo.
      333       if length( p-source-string ) <= p-split-length
      334       then do:
      335           assign
      336               p-string-1 = p-source-string
      337           .
      338       end.
      339       else do:
      340           assign
      341               v-space-pos = r-index( p-source-string, " ":U, p-split-length )
      342           .
      343           if v-space-pos = 0
      344           then do:
      345               assign
      346                   v-space-pos = index( p-source-string, " ":U )
      347               .
      348           end.
      349           if v-space-pos = 0
      350           then do:
      351               assign
      352                   p-string-1 = substring( p-source-string, 1, p-split-length )
      353                   p-string-2 = trim( substring( p-source-string, p-split-length, p-split-length ) )
      354               .
      355           end.
      356           else do:
      357               assign
      358                   p-string-1 = substring( p-source-string, 1, v-space-pos )
      359                   p-string-2 = trim( substring( p-source-string, v-space-pos ) )
      360               .
      361           end.
      362       end.
      363   end.
      364   end procedure.
      365   procedure p-fmt-round :
      366   define input parameter p-qnty               as decimal          no-undo.
      367   define input parameter p-price-no-VAT       as decimal          no-undo.
      368   define input parameter p-VAT                as decimal          no-undo.
      369   define input parameter p-SLT                as decimal          no-undo.
      370   define input parameter p-road-tax           as decimal          no-undo.
      371   define output parameter p-new-price-no-VAT  as decimal          no-undo.
      372   define output parameter p-new-VAT           as decimal          no-undo.
      373   define output parameter p-new-SLT           as decimal          no-undo.
      374   define output parameter p-new-sum-VAT       as decimal          no-undo.
      375   define output parameter p-new-sum-SLT       as decimal          no-undo.
      376   define output parameter p-new-sum-road-tax  as decimal          no-undo.
      377   define output parameter p-new-sum-no-VAT    as decimal          no-undo.
      378   define output parameter p-new-sum-full      as decimal          no-undo.
      379       define variable v-vat-pc    as decimal      no-undo.
      380       define variable v-slt-pc    as decimal      no-undo.
      381   do
      382   on error undo, return error
      383   :
      384       if p-price-no-VAT = 0
      385       then do:
      386           assign
      387               p-new-price-no-VAT = 0.0
      388               p-new-VAT          = ?
      389               p-new-SLT          = ?
      390               p-new-sum-VAT      = 0.0
      391               p-new-sum-SLT      = 0.0
      392               p-new-sum-no-VAT   = 0.0
      393               p-new-sum-road-tax = 0.0
      394               p-new-sum-full     = 0.0
      395           .
      396       end.
      397       else do:
      398           assign
      399               v-vat-pc            = p-VAT / p-price-no-VAT
      400               v-slt-pc            = p-SLT / ( p-price-no-VAT + p-VAT )
      401               p-new-price-no-VAT  = round( p-price-no-VAT, 2 )
      402               p-new-VAT           = round( p-new-price-no-VAT * v-vat-pc, 2 )
      403               p-new-SLT           = round( ( p-new-price-no-VAT + p-new-VAT ) * v-slt-pc, 2 )
      404               p-new-sum-VAT       = round( p-new-VAT          * p-qnty, 2 )
      405               p-new-sum-SLT       = round( ( p-new-price-no-VAT + p-new-VAT ) * p-qnty * v-slt-pc, 2 )
      406               p-new-sum-no-VAT    = round( p-new-price-no-VAT * p-qnty, 2 )
      407               p-new-sum-road-tax  = round( p-road-tax * p-qnty, 2 )
      408               p-new-sum-full      = round( ( p-new-price-no-VAT + p-new-VAT + p-new-SLT + p-road-tax ) * p-qnty, 2 )
      409           .
      410       end.
      411   end.
      412   end procedure.
      413   procedure p-fmt-split :
      414   define input parameter p-in-string      as character        no-undo.
      415   define input parameter p-split-length   as integer          no-undo.
      416       define variable v-start-pos     as integer      no-undo.
      417       define variable v-end-pos       as integer      no-undo.
      418       define buffer buf_temp_p-fmt_string-part        for temp_p-fmt_string-part.
      419   do
      420   for buf_temp_p-fmt_string-part
      421   on error undo, return error
      422   :
      423       empty temp-table buf_temp_p-fmt_string-part.
      424       if p-split-length < 1
      425       then do:
      426           undo, return error substitute( "p-fmt-split: Строка не может быть разбита на &1 частей", p-split-length ).
      427       end.
      428       assign
      429           p-in-string                 = trim( p-in-string )
      430           v-p-fmt-3-str-key   = 0
      431           v-start-pos                 = 1
      432           v-end-pos                   = length( p-in-string )
      433       .
      434       run p-fmt-get-string-range in this-procedure (
      435             input p-in-string
      436           , input p-split-length
      437           , input v-start-pos
      438           , output v-start-pos
      439           , output v-end-pos
      440       ).
      441       do while v-end-pos <> 0
      442       :
      443           create buf_temp_p-fmt_string-part.
      444           assign
      445               v-p-fmt-3-str-key = v-p-fmt-3-str-key + 1
      446           .
      447           assign
      448               buf_temp_p-fmt_string-part.str-key      = v-p-fmt-3-str-key
      449               buf_temp_p-fmt_string-part.string-part  = substring( p-in-string, v-start-pos, v-end-pos - v-start-pos )
      450           .
      451           assign
      452               v-start-pos = v-end-pos + 1
      453           .
      454           run p-fmt-get-string-range in this-procedure (
      455                 input p-in-string
      456               , input p-split-length
      457               , input v-start-pos
      458               , output v-start-pos
      459               , output v-end-pos
      460           ).
      461       end.
      462   end.
      463   end procedure.
      464   procedure p-fmt-get-string-range :
      465   define input parameter p-in-string      as character        no-undo.
      466   define input parameter p-split-length   as integer          no-undo.
      467   define input parameter p-old-start-pos  as integer          no-undo.
      468   define output parameter p-start-pos     as integer          no-undo.
      469   define output parameter p-end-pos       as integer          no-undo.
      470       define variable v-init-string    as character    no-undo.
      471       define variable v-temp-char      as character    no-undo.
      472       define variable v-temp-pos       as integer      no-undo.
      473       define variable v-counter        as integer      no-undo.
      474   do
      475   on error undo, return error
      476   :
      477       assign
      478           p-start-pos   = p-old-start-pos
      479           v-init-string = substring( p-in-string, p-start-pos )
      480       no-error.
      481       if error-status :error
      482       or trim( v-init-string ) = "":U
      483       then do:
      484           assign
      485               p-end-pos = 0
      486           .
      487           undo, return .
      488       end.
      489       assign
      490           v-temp-char   = substring( v-init-string, 1, 1 )
      491       .
      492       do
      493       while trim( v-temp-char ) = "":U
      494       :
      495           assign
      496               p-start-pos     = p-start-pos + 1
      497               v-init-string   = substring( p-in-string, p-start-pos )
      498               v-temp-char     = substring( v-init-string, 1, 1 )
      499           .
      500       end.
      501       assign
      502           v-temp-pos  = p-split-length
      503           v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      504           v-counter   = 0
      505       .
      506       search-word-end:
      507       do
      508       while trim( v-temp-char ) <> "":U
      509       :
      510           assign
      511               v-counter   = v-counter + 1
      512           .
      513           if v-counter > 20
      514           then do:
      515               assign
      516                   v-temp-pos  = p-split-length
      517               .
      518               leave search-word-end.
      519           end.
      520           assign
      521               v-temp-pos  = v-temp-pos - 1
      522               v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      523           .
      524       end.
      525       assign
      526           p-end-pos = p-start-pos + v-temp-pos - 1
      527       .
      528   end.
      529   end procedure.
      530   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      531   define  shared variable gdsgrp_recids      as character no-undo.
      532   define  shared variable fin-schet-recid    as character no-undo.
      533   define  shared variable v-d-report-handle  as handle    no-undo .
      534   define  shared temp-table g#customer no-undo
      535       field obj-type like ub.clients.obj-type
      536       field obj-code like ub.clients.obj-code
      537       field obj-name like ub.clients.obj-name
