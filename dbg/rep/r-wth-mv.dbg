      539   define  shared temp-table g#cli no-undo
      540       field obj-type like ub.clients.obj-type
      541       field obj-code like ub.clients.obj-code
      542       field obj-name like ub.clients.obj-name
      543       index pi is unique primary obj-type obj-code.
      544   define  shared temp-table tmp#grp no-undo
