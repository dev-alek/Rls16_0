     1103   FUNCTION get-curr RETURNS CHARACTER
     1104     (buffer loc-wealth for ub.wealth ) :
     1105   define buffer buf_currency for ub.currency.
     1106   if loc-wealth.curr-code = ? or loc-wealth.is-money = no then
     1107   return loc-wealth.unit-base.
     1108   FIND FIRST buf_currency no-lock where
     1109             buf_currency.curr-code = loc-wealth.curr-code No-ERROR.
     1110   if avail buf_currency then
     1111     RETURN buf_currency.curr-abbr.
     1112   else return "".
     1113   END FUNCTION.
     1114   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1115   procedure proc-alt-shift-f2:
     1116     if not ibs.th.gbl.gbl-var:rcode
     1117   then
     1118     run gbl\inidebug.p .
     1119   end.
     1120   procedure proc-alt-shift-f3:
     1121     run gbl/prvssinf.p
     1122       ( input this-procedure
     1123       ) .
     1124   end.
     1125   define variable v-inform-launched as logical no-undo initial false .
     1126   procedure proc-alt-shift-f4:
     1127     define variable v-action as character no-undo .
     1128     if v-inform-launched = false then do:
     1129       assign
     1130         v-inform-launched = true
     1131       .
     1132       run gbl/d-inform.w
     1133         (  input self
     1134         ,  input this-procedure
     1135         , output v-action
     1136         ) no-error .
     1137       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     1138       assign
     1139         v-inform-launched = false
     1140       .
     1141     end.
     1142   end.
     1143   procedure proc-alt-f1:
