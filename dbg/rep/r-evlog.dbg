      644   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      645   procedure paramls-clear :
      646     define buffer buf_temp-param for temp-param .
      647     do
      648     on error undo, return error return-value
      649     :
      650       for each buf_temp-param
      651       on error undo, return error
      652       :
      653         delete buf_temp-param .
      654       end.
      655     end.
      656   end procedure.
      657   procedure paramls-write :
      658     define input  parameter p-code     as character no-undo .
      659     define input  parameter p-sub-code as character no-undo .
      660     define input  parameter p-value    as character no-undo .
      661     define buffer buf_temp-param for temp-param .
      662     do
      663     on error undo, return error return-value
      664     :
      665       find first buf_temp-param
      666         where buf_temp-param.param-code     = p-code
      667           and buf_temp-param.param-sub-code = p-sub-code
      668         no-error .
      669       if not available buf_temp-param then do:
      670         create buf_temp-param .
      671         assign
      672           buf_temp-param.param-code     = p-code
      673           buf_temp-param.param-sub-code = p-sub-code
      674         .
      675       end.
      676       assign
      677         buf_temp-param.param-value = p-value
      678       .
      679     end.
      680   end procedure.
      681   procedure paramls-read :
      682     define input  parameter p-code          as character no-undo .
      683     define input  parameter p-sub-code      as character no-undo .
      684     define input  parameter p-default-value as character no-undo .
      685     define output parameter p-value         as character no-undo .
      686     define buffer buf_temp-param for temp-param .
      687     do
      688     on error undo, return error return-value
      689     :
      690       find first buf_temp-param
      691         where buf_temp-param.param-code     = p-code
      692           and buf_temp-param.param-sub-code = p-sub-code
      693         no-error .
      694       if available buf_temp-param then do:
      695         assign
      696           p-value = buf_temp-param.param-value
      697         .
      698       end.
      699       else do:
      700         assign
      701           p-value = p-default-value
      702         .
      703       end.
      704     end.
      705   end procedure.
      706   procedure paramls-append :
      707     define input  parameter p-code     as character no-undo .
      708     define input  parameter p-sub-code as character no-undo .
      709     define input  parameter p-value    as character no-undo .
      710     define buffer buf_temp-param for temp-param .
      711     do
      712     on error undo, return error return-value
      713     :
      714       find first buf_temp-param
      715            where buf_temp-param.param-code     = p-code
      716              and buf_temp-param.param-sub-code = p-sub-code
      717         no-error .
      718       if not available buf_temp-param then do:
      719         create buf_temp-param .
      720         assign
      721           buf_temp-param.param-code     = p-code
      722           buf_temp-param.param-sub-code = p-sub-code
      723           buf_temp-param.param-value    = p-value
      724         .
      725       end.
      726       else do:
      727           assign
      728               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      729           .
      730       end.
      731     end.
      732   end procedure.
      733   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      734   define variable v-waitfram-action01         as character   no-undo .
      735   define variable v-waitfram-action02         as character   no-undo .
      736   define variable v-waitfram-action03         as character   no-undo .
      737   define variable mWaitFramTextBeg            as character   no-undo.
      738   define variable mWaitFramTextEnd            as character   no-undo.
      739   define variable mWaitFramView               as logical     no-undo.
      740   define variable mWaitProcEvent              as logical     no-undo init yes.
      741   define variable mWaitFramInterval           as integer     no-undo init 1 .
      742   define variable mWaitFramStop               as logical     no-undo.
      743   define variable mWaitFramStopUser           as logical     no-undo.
      744   define variable mWaitFramStopTimeOut        as logical     no-undo.
      745   define variable mWaitFramStartProc          as datetime-tz no-undo.
      746   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      747   define button B-WaitFramStop auto-end-key
      748        label "Стоп"
      749        size 10 by 1 tooltip "Остоновить процесс".
      750   define button B-viewProcInfo
      751        label "Информация"
      752        size 15 by 1 tooltip "Информация о процесс".
      753   define frame waitfram
      754     v-waitfram-action01 format "x(72)" no-label skip
      755     v-waitfram-action02 format "x(72)" no-label skip
      756     v-waitfram-action03 format "x(72)" no-label skip
      757     B-viewProcInfo
      758     B-WaitFramStop at row 4 col 30
      759     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      760     .
      761   define new global shared variable mBatchMode as logical no-undo init ?.
      762   define variable mFramBachModHandle as handle no-undo.
      763   mFramBachModHandle = frame waitfram:handle.
      764   define variable mFameOldVis as logical no-undo.
      765   define variable mVisCUrentVin as logical no-undo.
      766   if session:batch-mode
      767   then
      768      mBatchMode = yes.
      769   if mBatchMode = ? then do:
      770     mVisCUrentVin = current-window:visible.
      771     mFameOldVis = mFramBachModHandle:visible.
      772     mFramBachModHandle:visible  = yes.
      773     mBatchMode = mFramBachModHandle:visible ne yes.
      774     mFramBachModHandle:visible = mFameOldVis.
      775     current-window:visible = mVisCUrentVin.
      776   end.
      777    if  log-manager:logfile-name ne ?
      778     then DO:
      779         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      780         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      781         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      782     end.
      783   on choose of B-WaitFramStop in frame waitfram
      784   do:
      785     mWaitFramStop = yes.
      786     mWaitFramStopUser = yes.
      787   end.
      788   function waitfram-check-timeout returns logical():
      789      define variable vtime as int64 no-undo.
      790      if mWaitFramStopTimeOut
      791      then
      792         return yes.
      793      vtime = ( now - mWaitFramStartProc ) / 1000 .
      794      if     mWaitFramTimeOut ne ?
      795         and mWaitFramTimeOut ne 0
      796         and mWaitFramTimeOut lt vtime
      797      then do:
      798         mWaitFramStopTimeOut = yes.
      799      end.
      800      return mWaitFramStopTimeOut.
      801   end.
      802   procedure waitfram-hide :
      803     if not session:batch-mode
      804     then do
      805     on error undo, return error return-value
      806     :
      807       pause 0 before-hide .
      808       if not mBatchMode then
      809         hide frame waitfram .
      810     if     not mWaitFramView
      811        and mWaitProcEvent
      812     then
      813       process events .
      814     end.
      815   end procedure.
      816   procedure waitfram-show :
      817     define input  parameter p-message as character no-undo .
      818     define variable v-left-margin as integer   no-undo .
      819     if not session:batch-mode
      820     then do
      821     on error undo, return error return-value
      822     :
      823       if length(p-message) <= 70 then do:
      824         assign
      825           v-left-margin = integer((70 - length(p-message)) / 2)
      826         .
      827         assign
      828           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      829         .
      830         assign
      831           v-waitfram-action01 = " "
      832           v-waitfram-action02 = " "
      833                                    + fill(" ", v-left-margin)
      834                                    + p-message
      835           v-waitfram-action03 = " "
      836         .
      837       end.
      838       else do:
      839         define variable vRindex1 as integer no-undo.
      840         define variable vRindex2 as integer no-undo.
      841         vRindex1 = r-index(p-message," ",70).
      842         if vRindex1 = 0
      843         then
      844            vRindex1 = 70.
      845         if length(p-message)  <= vRindex1 + 70 then do:
      846           assign
      847             v-waitfram-action01 = " "
      848             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      849             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      850           .
      851         end.
      852         else do:
      853           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      854           if vRindex2 <= vRindex1
      855           then
      856              vRindex2 = vRindex1 + 70.
      857           assign
      858             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      859             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      860             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      861           .
      862         end.
      863       end.
      864       B-viewProcInfo:visible   in frame waitfram = no.
      865       B-viewProcInfo:sensitive in frame waitfram = no.
      866       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      867       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      868       if  (   mWaitFramView
      869          or  mWaitProcEvent)
      870          and not mBatchMode
      871       then
      872          display
      873             v-waitfram-action01 skip
      874             v-waitfram-action02 skip
      875             v-waitfram-action03 skip
      876          with frame waitfram .
      877       if     mWaitFramView
      878          then do:
      879             if     mWaitFramInterval ne ?
      880                and not mBatchMode
      881             then
      882                wait-for go of frame waitfram pause mWaitFramInterval.
      883          end.
      884          else
      885             if     mWaitProcEvent
      886                and not mBatchMode
      887             then
      888                process events .
      889     end.
      890   end procedure.
      891      procedure waitfram-show-this:
      892         define input  parameter iInterval as int64 no-undo.
      893         define variable vtime as int64 no-undo.
      894         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      895         mWaitFramInterval = iInterval.
      896         run waitfram-show (substitute("&1&2 &3&4" ,
      897                                       mWaitFramTextBeg ,
      898                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      899                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      900                                       mWaitFramTextEnd
      901                                      )
      902                           ).
      903      end.
      904      procedure WaitFramRunPause:
      905         define input  parameter iInterval as dec no-undo.
      906         define variable vStart  as datetime-tz no-undo.
      907         define variable vend    as datetime-tz no-undo.
      908         define variable vint as int64 no-undo.
      909         define variable vOk as logical no-undo.
      910         vStart = now.
      911         vend   = vStart.
      912         publish "WaitFramPause" (iInterval,output vOk).
      913         vend   =  now.
      914         vint = vend - vStart.
      915         vint = iInterval - vint / 1000.
      916         if     not mWaitFramStop
      917            and (   vint > 0
      918                 or (    not vOk
      919                     and iInterval eq ?
      920                     )
      921                 )
      922         then
      923            run waitfram-show-this (iInterval).
      924         vend   =  now.
      925         vint = vend - vStart.
      926         vint = iInterval - vint / 1000.
      927         if     not mWaitFramStop
      928            and vint > 0
      929         then do:
      930            run gbl/pause.p (vint * 1000).
      931         end.
      932         if iInterval ne ?
      933         then
      934            publish "WaitFramStop".
      935         waitfram-check-timeout().
      936      end.
      937      procedure WaitFramWaitFor:
      938         define input  parameter iInterval as dec no-undo.
      939         assign
      940            mWaitFramStartProc   = now
      941            mWaitFramStopUser    = no
      942            mWaitFramStopTimeOut = no
      943         .
      944         block-wait:
      945         do while not mWaitFramStop:
      946            run WaitFramRunPause (iInterval).
      947            if  waitfram-check-timeout()
      948            then do:
      949               leave block-wait.
      950            end.
      951         end.
      952         run waitfram-hide.
      953      end.
      954   procedure waitfram-join :
      955     define input  parameter p-line-1  as character no-undo .
      956     define input  parameter p-line-2  as character no-undo .
      957     define input  parameter p-line-3  as character no-undo .
      958     define output parameter p-message as character no-undo .
      959     do
      960     on error undo, return error return-value
      961     :
      962       assign
      963         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      964                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      965                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      966       .
      967     end.
      968   end procedure.
      969   function waitfram-join-function returns character
      970     (input p-line-1 as character
      971     ,input p-line-2 as character
      972     ,input p-line-3 as character
      973     ).
      974     define variable v-message as character no-undo .
      975     run waitfram-join in this-procedure
      976       (input  p-line-1
      977       ,input  p-line-2
      978       ,input  p-line-3
      979       ,output v-message
      980       ) .
      981     return v-message .
      982   end function .
      983   define variable vss-include-info10 as character format "X(65)" no-undo
      984   initial "@(#)$Workfile$ $Revision$".
      985   DEFINE TEMP-TABLE tt-line NO-UNDO LIKE ub.cd-event-log
      986         USE-INDEX PI  AS PRIMARY
      987         FIELD event-name AS CHARACTER
      988         index i-print
      989               obj-code
      990               cash-num
      991               event-date
      992               event-time
      993   .
      994   define stream excel-line.
      995   define stream excel-cell.
      996   define temp-table temp_cell-data no-undo
      997       field data-key as character
      998       field data-value as character
      999       index pi is primary unique data-key
     1000   .
     1001   define variable v-evlog-sheet1-cur-data-row     as integer      no-undo.
     1002   define variable v-evlog-cell-file-name       as character    no-undo.
     1003   define variable v-evlog-data-file-name       as character    no-undo.
     1004   procedure evlog-init :
     1005   do
     1006   on error undo, return error
     1007   :
     1008       assign
     1009           v-evlog-sheet1-cur-data-row = 0
     1010       .
     1011       run gbl/_tmpfile.p (
     1012             input "xd"
     1013           , input ".txt"
     1014           , output v-evlog-data-file-name
     1015       ).
     1016       output stream excel-line to value( v-evlog-data-file-name ).
     1017       run gbl/_tmpfile.p (
     1018             input "xc"
     1019           , input ".txt"
     1020           , output v-evlog-cell-file-name
     1021       ).
     1022       output stream excel-cell to value( v-evlog-cell-file-name ).
     1023       run evlog-write-cell-data in this-procedure (
     1024             input "sheetList":U
     1025           , input "Лист1":U
     1026       ).
     1027       if printrubl
     1028       then do:
     1029           run evlog-write-cell-data in this-procedure (
     1030                 input "Лист1_valutCode":U
     1031               , input "0":U
     1032           ).
     1033       end.
     1034       else do:
     1035           run evlog-write-cell-data in this-procedure (
     1036                 input "Лист1_valutCode":U
     1037               , input "1":U
     1038           ).
     1039       end.
     1040       run evlog-write-cell-data in this-procedure (
     1041             input "Лист1_columnList":U
     1042           , input "trans_id,obj_code,pos_type,cash_num,db_num,shift_num,shift_date,shift_name,user_id,event_date,event_time,event_id,event_type,cd_mode,doc_code,chk_type,src_code,gds_code,doc_qnty,d_card,tot_sum,pay_card,discnt,description,action_item_id,price":U
     1043       ).
     1044       run evlog-write-cell-data in this-procedure (
     1045             input "Лист1_columnType":U
     1046           , input "S,S,S,S,S,S,S,S,S,S,S,S,S,S,S,S,S,S,S,S,S,S,S,S,S,S":U
     1047       ).
     1048       run evlog-write-cell-data in this-procedure (
     1049             input "Лист1_subtotalList":U
     1050           , input "":U
     1051       ).
     1052       run evlog-write-cell-data in this-procedure (
     1053             input "Лист1_subtotalType":U
     1054           , input "":U
     1055       ).
     1056   end.
     1057   end procedure.
     1058   procedure evlog-sheet1-write-line-data :
     1059   define buffer buf_tt-line     for tt-line .
     1060   define variable v-total-supp    as decimal  format "->>>>>9.99"     no-undo.
     1061   define variable v-number    as integer      no-undo.
     1062   do
     1063   on error undo, return error
     1064   :
     1065      for each buf_tt-line
     1066          USE-INDEX i-print
     1067         :
     1068               put stream excel-line unformatted
     1069                                    "Лист1":U
     1070                     CHR(9)   "DTA":U
     1071                     CHR(9)   buf_tt-line.trans-id
     1072                     CHR(9)   buf_tt-line.obj-code
     1073                     CHR(9)   buf_tt-line.pos-type
     1074                     CHR(9)   buf_tt-line.cash-num
     1075                     CHR(9)   buf_tt-line.db-num
     1076                     CHR(9)   buf_tt-line.shift-num
     1077                     CHR(9)   buf_tt-line.shift-date
     1078                     CHR(9)   buf_tt-line.shift-name
     1079                     CHR(9)   buf_tt-line.user-id
     1080                     CHR(9)   string(buf_tt-line.event-date, "99/99/9999")
     1081                     CHR(9)   STRING(buf_tt-line.event-time, "HH:MM:SS")
     1082                     CHR(9)   buf_tt-line.event-name
     1083                     CHR(9)   buf_tt-line.event-type
     1084                     CHR(9)   buf_tt-line.cd-mode
     1085                     CHR(9)   buf_tt-line.doc-code
     1086                     CHR(9)   buf_tt-line.chk-type
     1087                     CHR(9)   buf_tt-line.src-code
     1088                     CHR(9)   buf_tt-line.gds-code
     1089                     CHR(9)   buf_tt-line.doc-qnty
     1090                     CHR(9)   buf_tt-line.d-card
     1091                     CHR(9)   buf_tt-line.tot-sum
     1092                     CHR(9)   buf_tt-line.pay-card
     1093                     CHR(9)   buf_tt-line.discnt
     1094                     CHR(9)   buf_tt-line.description
     1095                     CHR(9)   buf_tt-line.action-item-id
     1096                     CHR(9)   buf_tt-line.price
     1097                     chr(10)
     1098               .
     1099      end.
     1100   end.
     1101   end procedure.
     1102   procedure evlog-write-cell-data :
     1103   define input parameter p-data-key   as character        no-undo.
     1104   define input parameter p-data-value as character        no-undo.
     1105       define buffer buf_temp_cell-data     for temp_cell-data.
     1106   do
     1107   for buf_temp_cell-data
     1108   on error undo, return error
     1109   :
     1110       find first buf_temp_cell-data
     1111            where buf_temp_cell-data.data-key = p-data-key
     1112       no-error.
     1113       if not available buf_temp_cell-data
     1114       then do:
     1115           create buf_temp_cell-data.
     1116           assign
     1117               buf_temp_cell-data.data-key = p-data-key
     1118           .
     1119       end.
     1120       assign
     1121           buf_temp_cell-data.data-value = p-data-value
     1122       .
     1123       put stream excel-cell unformatted
     1124                           buf_temp_cell-data.data-key
     1125           CHR(9)   buf_temp_cell-data.data-value
     1126           chr(10)
     1127       .
     1128   end.
     1129   end procedure.
     1130   procedure evlog-run-excel :
     1131   define input parameter p-header-filename    as character        no-undo.
     1132   define input parameter p-data-filename      as character        no-undo.
     1133   define variable v-template-file-name    as character    no-undo.
     1134   define variable v-vb-file-name          as character    no-undo.
     1135   define buffer buf_temp-param for temp-param .
     1136   do
     1137   for buf_temp-param
     1138   on error undo, return error
     1139   :
     1140       create buf_temp-param.
     1141       assign
     1142           v-template-file-name    = search( "exe/evlog.xlt" )
     1143           v-vb-file-name          = search( "exe/t_form.bas" )
     1144       .
     1145       if v-template-file-name = ?
     1146       or v-template-file-name = "":U
     1147       then do:
     1148           message
     1149               "Ошибка имени файла шаблона."
     1150           view-as alert-box error.
     1151       end.
     1152       if v-vb-file-name = ?
     1153       or v-vb-file-name = "":U
     1154       then do:
     1155           message
     1156               "Ошибка имени файла кода обработки."
     1157           view-as alert-box error.
     1158       end.
     1159       run paramls-write in this-procedure (
     1160             input "template":U
     1161           , input "template-file-name":U
     1162           , input v-template-file-name
     1163       ).
     1164       run paramls-write in this-procedure (
     1165             input "template":U
     1166           , input "vb-file-name":U
     1167           , input v-vb-file-name
     1168       ).
     1169       run paramls-write in this-procedure (
     1170             input "data":U
     1171           , input "data-header-filename":U
     1172           , input p-header-filename
     1173       ).
     1174       run paramls-write in this-procedure (
     1175             input "data":U
     1176           , input "data-filename":U
     1177           , input p-data-filename
     1178       ).
     1179       run gbl/macroxlt.p (
     1180           input-output table buf_temp-param
     1181       ) no-error.
     1182       if error-status :error
     1183       then do:
     1184           message
     1185                    vss-workfile vss-revision vss-description
     1186               skip(1)
     1187               skip "Ошибка создания файла Excel."
     1188               skip return-value
     1189               skip trim(error-status :get-message(1))
     1190                    trim(error-status :get-message(2))
     1191                    trim(error-status :get-message(3))
     1192           view-as alert-box error.
     1193           undo, return error .
     1194       end.
     1195   end.
     1196   end procedure.
     1197   procedure evlog-close :
     1198   do
     1199   on error undo, return error
     1200   :
     1201       output stream excel-line close.
     1202       output stream excel-cell close.
     1203       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     1204           export "exe/evlog.xlt" .
     1205           export "exe/t_form.bas" .
     1206           export v-evlog-cell-file-name.
     1207           export v-evlog-data-file-name.
     1208       output close.
     1209   end.
     1210   end procedure.
     1211   define variable v-account as integer init 0 no-undo .
     1212   define variable v-account-lavel as character no-undo .
     1213   define variable v-button-stop as logical no-undo .
     1214   define variable v-kol-spice as integer no-undo .
     1215   define variable v-kol-spice2 as integer no-undo .
     1216   define variable v-kol-spice3 as integer no-undo .
     1217   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1218   DEFINE BUTTON StopBtn AUTO-END-KEY
     1219        LABEL "Стоп"
     1220        SIZE 10 BY 1.
     1221   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1222        LABEL "Обработано записей"
     1223         VIEW-AS TEXT
     1224        SIZE 14 BY .67 NO-UNDO.
     1225   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1226         VIEW-AS TEXT
     1227        SIZE 53.25 BY .67
     1228        FGCOLOR 1  NO-UNDO.
     1229   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1230         VIEW-AS TEXT
     1231        SIZE 53.25 BY .67
     1232        FGCOLOR 1  NO-UNDO.
     1233   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1234         VIEW-AS TEXT
     1235        SIZE 53.25 BY .67
     1236        FGCOLOR 1  NO-UNDO.
     1237   DEFINE RECTANGLE RECT-1
     1238        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1239        SIZE 55.13 BY 4.46.
     1240   DEFINE FRAME InfoFrame
     1241        StopBtn AT ROW 4.25 COL 21.75
     1242        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1243        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1244        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1245        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1246        RECT-1 AT ROW 1 COL 1
     1247       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1248            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1249            TITLE "Процесс"
     1250            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1251   define variable mFrameView      as logical   no-undo init yes.
     1252     define variable mFramHandle as handle no-undo.
     1253     mFramHandle = frame InfoFrame:handle.
     1254     if  log-manager:logfile-name ne ?
     1255     then DO:
     1256         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1257         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1258         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1259     end.
     1260     mFrameView = not session:batch-mode and mFramHandle:visible.
     1261     if mFrameView
     1262     then do:
     1263       ASSIGN
     1264          FRAME InfoFrame:HIDDEN                           = TRUE
     1265          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1266     end.
     1267   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1268   DO:
     1269     IF not StopProcessing THEN
     1270       Message "Вы действительно хотите прервать" SKIP
     1271               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1272                 UPDATE StopProcessing.
     1273     IF StopProcessing THEN do:
     1274        if mFrameView
     1275        then do:
     1276           HIDE FRAME InfoFrame.
     1277        end.
     1278     End.
     1279   END.
     1280   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1281     define variable v-cntxt-db-num        as integer   no-undo .
     1282     define variable v-cntxt-userid        as character no-undo .
     1283     define variable v-cntxt-level         as character no-undo .
     1284     define variable v-cntxt-host-code-obj as integer   no-undo .
     1285     define variable v-cntxt-obj-type      as character no-undo .
     1286     define variable v-cntxt-obj-code      as integer   no-undo .
     1287     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1288     define variable v-cntxt-is-admin      as logical   no-undo .
     1289   do
     1290   on error undo, return error
     1291   :
     1292      RUN fill-tt         IN THIS-PROCEDURE .
     1293      run open-stream     IN THIS-PROCEDURE .
     1294      run print-header    in this-procedure .
     1295      run print-body      in this-procedure .
     1296      run print-footer    in this-procedure .
     1297      run close-stream    IN THIS-PROCEDURE .
     1298   end.
     1299   procedure fill-tt :
     1300   define buffer buf_cd-event-log      for ub.cd-event-log .
     1301   define buffer buf_cd-events         for ub.cd-events .
     1302   define buffer buf_cash-desk         for ub.cash-desk .
     1303   define buffer buf_tt-line           for tt-line .
     1304     DO ii = 1 TO num-entries( p-event-list ) :
     1305                 FIND FIRST buf_cd-events
     1306                       WHERE recid( buf_cd-events ) = int(entry( ii, p-event-list ))
     1307                       NO-LOCK
     1308                       no-error
     1309                       .
     1310             ASSIGN
     1311                       v-events-list = IF v-events-list = "" THEN string(buf_cd-events.event-id)
     1312                                                               ELSE v-events-list + "," + STRING(buf_cd-events.event-id)
     1313                     .
     1314     end.
     1315     DO ii = 1 TO num-entries( p-cd-list ) :
     1316                 FIND FIRST buf_cash-desk
     1317                       WHERE recid( buf_cash-desk ) = int(entry( ii, p-cd-list ))
     1318                       NO-LOCK
     1319                       no-error
     1320                       .
     1321             ASSIGN
     1322                       v-cash-list = IF v-cash-list = "" THEN string(buf_cash-desk.cash-num)
     1323                                                               ELSE v-cash-list + "," + STRING(buf_cash-desk.cash-num)
     1324                     .
     1325     end.
     1326   do
     1327   on error undo, return error
     1328   :
     1329      FOR EACH  buf_cd-event-log
     1330          WHERE
     1331                (
     1332                (buf_cd-event-log.event-date >  X-date-start)  OR
     1333                (buf_cd-event-log.event-date =  X-date-start AND
     1334                 buf_cd-event-log.event-time >= p-time-start)
     1335                 )
     1336            AND
     1337                (
     1338                (buf_cd-event-log.event-date <  X-date-end)  OR
     1339                (buf_cd-event-log.event-date =  X-date-end AND
     1340                 buf_cd-event-log.event-time <= p-time-end)
     1341                )
     1342            AND
     1343               (
     1344                p-user-id = "":U OR
     1345                buf_cd-event-log.user-id = p-user-id
     1346               )
     1347            AND
     1348               (     p-event-list = "All":U
     1349                 OR  p-event-list = "":U
     1350                 OR  LOOKUP(string(buf_cd-event-log.event-id), v-events-list, chr(44) ) > 0
     1351               )
     1352            AND
     1353               (     p-cd-list = "All":U
     1354                 OR  p-cd-list = "":U
     1355                 OR  LOOKUP(string(buf_cd-event-log.cash-num), v-cash-list, chr(44) ) > 0
     1356               )
     1357            AND
     1358               (     p-event-type = "All":U
     1359                 OR  p-event-type = "":U
     1360                 OR  buf_cd-event-log.event-type = p-event-type
     1361               )
     1362            AND
     1363               (     p-supmode-id = "":U
     1364                 OR  buf_cd-event-log.cd-mode = p-supmode-id
     1365               )
     1366            AND
     1367               (     p-doc-num = "":U
     1368                 OR  buf_cd-event-log.doc-code = p-doc-num
     1369               )
     1370            AND
     1371               (     p-b-codes = "":U
     1372                 OR  buf_cd-event-log.src-code = p-b-codes
     1373               )
     1374            AND
     1375               (     p-b-codes = "":U
     1376                 OR  buf_cd-event-log.src-code = p-b-codes
     1377               )
     1378            AND
     1379               (     (p-summ-min = 0 AND p-summ-max = 0)
     1380                 OR  (buf_cd-event-log.tot-sum >= p-summ-min AND
     1381                      buf_cd-event-log.tot-sum <= p-summ-max
     1382                     )
     1383               )
     1384            AND
     1385               (     (p-qnty-min = 0 AND p-qnty-max = 0)
     1386                 OR  (buf_cd-event-log.doc-qnty >= p-qnty-min AND
     1387                      buf_cd-event-log.doc-qnty <= p-qnty-max
     1388                     )
     1389               )
     1390            AND
     1391               (     (p-disc-min = 0 AND p-disc-max = 0)
     1392                 OR  (buf_cd-event-log.discnt >= p-disc-min AND
     1393                      buf_cd-event-log.discnt <= p-disc-max
     1394                     )
     1395               )
     1396            AND
     1397               (     p-dc-num = "":U
     1398                 OR  buf_cd-event-log.d-card   = p-dc-num
     1399               )
     1400            AND
     1401               (     p-bc-num = "":U
     1402                 OR  buf_cd-event-log.pay-card = p-bc-num
     1403               )
     1404            AND
     1405               (     p-disc-type = "1"
     1406                 OR  buf_cd-event-log.dsc-type = p-disc-type
     1407               )
     1408          NO-LOCK
     1409          :
     1410          FIND FIRST buf_cd-events
     1411               WHERE buf_cd-events.event-id = buf_cd-event-log.event-id
     1412               no-lock
     1413               .
     1414          CREATE buf_tt-line.
     1415          BUFFER-COPY buf_cd-event-log TO buf_tt-line.
     1416          ASSIGN
     1417             buf_tt-line.event-name = buf_cd-events.event-name
     1418          .
     1419      END.
     1420   end.
     1421   end procedure.
     1422   procedure open-stream :
     1423   do
     1424   on error undo, return error
     1425   :
     1426   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1427     run mainmenu_getcntxt in parparentproc
     1428       (output v-cntxt-db-num
     1429       ,output v-cntxt-userid
     1430       ,output v-cntxt-level
     1431       ,output v-cntxt-host-code-obj
     1432       ,output v-cntxt-obj-type
     1433       ,output v-cntxt-obj-code
     1434       ,output v-cntxt-db-num-obj
     1435       ,output v-cntxt-is-admin
     1436       ) .
     1437      run get-report-num in parparentproc (output g#report-num).
     1438   if session :set-wait-state( "compiler" ) then.
     1439   output stream out-stream to value( string( session:temp-directory +
     1440                                        "rpt" + string( g#report-num ) ) )
     1441                                        page-size  value(62) .
     1442      put stream out-stream unformatted
     1443            chr(10)
     1444         + "Печатная форма предназначена только для вывода в Microsoft Excel."
     1445         + chr(10)
     1446      .
     1447      output stream out-stream close.
     1448      run evlog-init in this-procedure.
     1449   end.
     1450   end procedure.
     1451   procedure print-header :
     1452   do on error undo, return error
     1453   :
     1454      RUN evlog-write-cell-data IN THIS-PROCEDURE
     1455          ( INPUT "date_start":U
     1456          , INPUT string(X-date-start, "99/99/9999")
     1457          ) .
     1458      RUN evlog-write-cell-data IN THIS-PROCEDURE
     1459          ( INPUT "date_end":U
     1460          , INPUT string(X-date-end, "99/99/9999")
     1461          ) .
     1462      RUN evlog-write-cell-data IN THIS-PROCEDURE
     1463          ( INPUT "h_time_start":U
     1464          , INPUT STRING(p-time-start, "HH:MM:SS")
     1465          ) .
     1466      RUN evlog-write-cell-data IN THIS-PROCEDURE
     1467          ( INPUT "h_time_end":U
     1468          , INPUT STRING(p-time-end, "HH:MM:SS")
     1469          ) .
     1470      IF p-event-list = "":U
     1471      THEN DO:
     1472         RUN evlog-write-cell-data IN THIS-PROCEDURE
     1473            ( INPUT "h_event_list":U
     1474            , INPUT "Все"
     1475            ) .
     1476      END.
     1477      ELSE DO:
     1478         RUN evlog-write-cell-data IN THIS-PROCEDURE
     1479            ( INPUT "h_event_list":U
     1480            , INPUT v-events-list
     1481            ) .
     1482      END.
     1483      IF p-cd-list = "":U
     1484      THEN DO:
     1485         RUN evlog-write-cell-data IN THIS-PROCEDURE
     1486            ( INPUT "h_cd_list":U
     1487            , INPUT "Все"
     1488            ) .
     1489      END.
     1490      ELSE DO:
     1491         RUN evlog-write-cell-data IN THIS-PROCEDURE
     1492            ( INPUT "h_cd_list":U
     1493            , INPUT v-cash-list
     1494            ) .
     1495      END.
     1496      IF p-user-id = "":U
     1497      THEN DO:
     1498         RUN evlog-write-cell-data IN THIS-PROCEDURE
     1499            ( INPUT "h_user_id":U
     1500            , INPUT "Все"
     1501            ) .
     1502      END.
     1503      ELSE DO:
     1504         RUN evlog-write-cell-data IN THIS-PROCEDURE
     1505            ( INPUT "h_user_id":U
     1506            , INPUT p-user-id
     1507            ) .
     1508      END.
     1509      IF p-event-type = "":U
     1510      THEN DO:
     1511         RUN evlog-write-cell-data IN THIS-PROCEDURE
     1512            ( INPUT "h_event_type":U
     1513            , INPUT "Все"
     1514            ) .
     1515      END.
     1516      ELSE DO:
     1517         RUN evlog-write-cell-data IN THIS-PROCEDURE
     1518            ( INPUT "h_event_type":U
     1519            , INPUT p-event-type
     1520            ) .
     1521      END.
     1522      IF p-supmode-id = "":U
     1523      THEN DO:
     1524         RUN evlog-write-cell-data IN THIS-PROCEDURE
     1525            ( INPUT "h_supmode_id":U
     1526            , INPUT "Все"
     1527            ) .
     1528      END.
     1529      ELSE DO:
     1530         RUN evlog-write-cell-data IN THIS-PROCEDURE
     1531            ( INPUT "h_supmode_id":U
     1532            , INPUT p-supmode-id
     1533            ) .
     1534      END.
     1535      IF p-doc-num = "":U
     1536      THEN DO:
     1537         RUN evlog-write-cell-data IN THIS-PROCEDURE
     1538            ( INPUT "h_doc_num":U
     1539            , INPUT "Все"
     1540            ) .
     1541      END.
     1542      ELSE DO:
     1543         RUN evlog-write-cell-data IN THIS-PROCEDURE
     1544            ( INPUT "h_doc_num":U
     1545            , INPUT p-doc-num
     1546            ) .
     1547      END.
     1548      IF p-b-codes = "":U
     1549      THEN DO:
     1550         RUN evlog-write-cell-data IN THIS-PROCEDURE
     1551            ( INPUT "h_b_codes":U
     1552            , INPUT "Все"
     1553            ) .
     1554      END.
     1555      ELSE DO:
     1556         RUN evlog-write-cell-data IN THIS-PROCEDURE
     1557            ( INPUT "h_b_codes":U
     1558            , INPUT p-b-codes
     1559            ) .
     1560      END.
     1561      IF p-summ-min = 0
     1562      THEN DO:
     1563         RUN evlog-write-cell-data IN THIS-PROCEDURE
     1564            ( INPUT "h_summ_min":U
     1565            , INPUT " ":U
     1566            ) .
     1567      END.
     1568      ELSE DO:
     1569         RUN evlog-write-cell-data IN THIS-PROCEDURE
     1570            ( INPUT "h_summ_min":U
     1571            , INPUT p-summ-min
     1572            ) .
     1573      END.
     1574      IF p-summ-max = 0
     1575      THEN DO:
     1576         RUN evlog-write-cell-data IN THIS-PROCEDURE
     1577            ( INPUT "h_summ_max":U
     1578            , INPUT " "
     1579            ) .
     1580      END.
     1581      ELSE DO:
     1582         RUN evlog-write-cell-data IN THIS-PROCEDURE
     1583            ( INPUT "h_summ_max":U
     1584            , INPUT p-summ-max
     1585            ) .
     1586      END.
     1587      IF p-qnty-min = 0
     1588      THEN DO:
     1589         RUN evlog-write-cell-data IN THIS-PROCEDURE
     1590            ( INPUT "h_qnty_min":U
     1591            , INPUT " ":U
     1592            ) .
     1593      END.
     1594      ELSE DO:
     1595         RUN evlog-write-cell-data IN THIS-PROCEDURE
     1596            ( INPUT "h_qnty_min":U
     1597            , INPUT p-qnty-min
     1598            ) .
     1599      END.
     1600      IF p-qnty-max = 0
     1601      THEN DO:
     1602         RUN evlog-write-cell-data IN THIS-PROCEDURE
     1603            ( INPUT "h_qnty_max":U
     1604            , INPUT " ":U
     1605            ) .
     1606      END.
     1607      ELSE DO:
     1608         RUN evlog-write-cell-data IN THIS-PROCEDURE
     1609            ( INPUT "h_qnty_max":U
     1610            , INPUT p-qnty-max
     1611            ) .
     1612      END.
     1613      IF p-dc-num = "":U
     1614      THEN DO:
     1615         RUN evlog-write-cell-data IN THIS-PROCEDURE
     1616            ( INPUT "h_dc_num":U
     1617            , INPUT "Все"
     1618            ) .
     1619      END.
     1620      ELSE DO:
     1621         RUN evlog-write-cell-data IN THIS-PROCEDURE
     1622            ( INPUT "h_dc_num":U
     1623            , INPUT p-dc-num
     1624            ) .
     1625      END.
     1626      IF p-bc-num = "":U
     1627      THEN DO:
     1628         RUN evlog-write-cell-data IN THIS-PROCEDURE
     1629            ( INPUT "h_bc_num":U
     1630            , INPUT "Все"
     1631            ) .
     1632      END.
     1633      ELSE DO:
     1634         RUN evlog-write-cell-data IN THIS-PROCEDURE
     1635            ( INPUT "h_bc_num":U
     1636            , INPUT p-bc-num
     1637            ) .
     1638      END.
     1639      IF p-disc-type = "":U
     1640      THEN DO:
     1641         RUN evlog-write-cell-data IN THIS-PROCEDURE
     1642            ( INPUT "h_disc_type":U
     1643            , INPUT "Все"
     1644            ) .
     1645      END.
     1646      ELSE DO:
     1647         RUN evlog-write-cell-data IN THIS-PROCEDURE
     1648            ( INPUT "h_disc_type":U
     1649            , INPUT p-disc-type
     1650            ) .
     1651      END.
     1652      IF p-disc-min = 0
     1653      THEN DO:
     1654         RUN evlog-write-cell-data IN THIS-PROCEDURE
     1655            ( INPUT "h_disc_min":U
     1656            , INPUT " ":U
     1657            ) .
     1658      END.
     1659      ELSE DO:
     1660         RUN evlog-write-cell-data IN THIS-PROCEDURE
     1661            ( INPUT "h_disc_min":U
     1662            , INPUT p-disc-min
     1663            ) .
     1664      END.
     1665      IF p-disc-max = 0
     1666      THEN DO:
     1667         RUN evlog-write-cell-data IN THIS-PROCEDURE
     1668            ( INPUT "h_disc_max":U
     1669            , INPUT " ":U
     1670            ) .
     1671      END.
     1672      ELSE DO:
     1673         RUN evlog-write-cell-data IN THIS-PROCEDURE
     1674            ( INPUT "h_disc_max":U
     1675            , INPUT p-disc-max
     1676            ) .
     1677      END.
     1678   end.
     1679   end procedure.
     1680   procedure print-body :
     1681   do
     1682   on error undo, return error
     1683   :
     1684       RUN evlog-sheet1-write-line-data IN THIS-PROCEDURE.
     1685   end.
     1686   end procedure.
     1687   procedure print-footer :
     1688   do
     1689   on error undo, return error
     1690   :
     1691   end.
     1692   end procedure.
     1693   procedure close-stream :
     1694   do
     1695   on error undo, return error
     1696   :
     1697      output stream out-stream close.
     1698      run evlog-close in this-procedure .
     1699   if mFrameView
     1700   then do:
     1701      HIDE FRAME InfoFrame.
     1702   end.
     1703   if session :set-wait-state( "" ) then.
     1704      os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )  .
     1705      os-rename
     1706         value( string( session:temp-directory ) + "$" + string( g#report-num ) + ".txl" )
     1707         value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )
     1708      .
     1709      define variable v-user-action   as character no-undo .
     1710      define variable v-printed       as logical   no-undo .
     1711      define variable DisabledOptions as integer   no-undo .
     1712      define variable v-orient-page as character no-undo .
     1713      run gbl/prnfilen.w   ( input "":U
     1714                           , input 20
     1715                           , input string(session :temp-directory) + "rpt" + string( g#report-num )
     1716                           , input ReportFontNum
     1717                           , output v-user-action
     1718                           , output v-printed
     1719                           ) .
     1720      os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )  .
     1721   end.
     1722   end procedure.
