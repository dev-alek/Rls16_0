      210   procedure create_obj-list :
      211      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      212      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      213      do
      214      on error undo, return error return-value
      215      :
      216         define buffer cli-obj for ub.clients .
      217         define variable p-var as integer no-undo .
      218         define buffer buf_obj-list for obj-list .
      219         find last buf_obj-list  use-index pi no-error .
      220         if available buf_obj-list
      221         then
      222            p-var = buf_obj-list.obj-id + 1.
      223         else
      224            p-var = 1.
      225         find first cli-obj where
      226                   cli-obj.obj-type = p-obj-type
      227               and cli-obj.obj-code = p-obj-code
      228         no-lock no-error.
      229         if available cli-obj
      230         then do:
      231            create buf_obj-list.
      232            assign
      233               buf_obj-list.obj-id   = p-var
      234               buf_obj-list.obj-code = cli-obj.obj-code
      235               buf_obj-list.obj-type = cli-obj.obj-type
      236               buf_obj-list.obj-name = cli-obj.obj-name
      237               buf_obj-list.db-num   = cli-obj.db-num
      238            .
      239         end.
      240      end.
      241   end.
