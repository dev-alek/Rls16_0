      198   def
      199    shared
      200   temp-table  obj-list no-undo
      201     field obj-type like ub.clients.obj-type
      202     field obj-code like ub.clients.obj-code
      203     field obj-name like ub.clients.obj-name
      204     field obj-id   as integer
