      962   define variable pol4  as decimal   no-undo .
      963   define variable pol5  as decimal   no-undo .
      964   define variable pol6  as decimal   no-undo .
      965   define variable pol7  as decimal   no-undo .
      966   define variable pol8  as decimal   no-undo.
      967   define variable pol9  as decimal   no-undo.
      968   define variable pol10 as decimal  no-undo .
      969   define variable pol11 as decimal  no-undo .
      970   define variable pol12 as decimal  no-undo .
      971   define variable pol13 as decimal  no-undo .
