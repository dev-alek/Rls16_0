      980                     , INPUT p-shift-date-start
      981                     , INPUT p-shift-num-start
      982                     , INPUT p-shift-date-end
      983                     , INPUT p-shift-num-end
      984                     ) .
      985      _shift-chk:
      986      FOR EACH buf_chk-doc
      987         WHERE buf_chk-doc.obj-type = p-obj-type
      988         AND   buf_chk-doc.obj-code = p-obj-code
      989         AND   buf_chk-doc.shift-date >= p-shift-date-start
      990         AND   buf_chk-doc.shift-date <= p-shift-date-end
      991         AND    ( buf_chk-doc.chk-type = integer('1':U)
      992               OR buf_chk-doc.chk-type = integer('6':U)
      993               OR buf_chk-doc.chk-type = integer('15':U)
      994               OR buf_chk-doc.chk-type = integer('14':U)
      995               OR buf_chk-doc.chk-type = integer('16':U)
      996               OR buf_chk-doc.chk-type = integer('17':U)
      997                )
      998         NO-LOCK
      999         :
     1000         IF ( buf_chk-doc.shift-date = p-shift-date-start
     1001         AND  buf_chk-doc.shift-num  < p-shift-num-start)
     1002         OR ( buf_chk-doc.shift-date = p-shift-date-end
     1003         AND  buf_chk-doc.shift-num  > p-shift-num-end)
     1004         THEN dO:
     1005            NEXT _shift-chk.
     1006         END.
     1007         v-counter = v-counter + 1.
     1008         IF v-counter MODULO 10 = 0
     1009         then DO:
     1010            run waitfram-show in this-procedure (substitute("Ждите... Обработано &1 чеков по топливу", v-counter)).
     1011         END.
     1012         run add-chk in this-procedure ( input buf_chk-doc.obj-type
     1013                                               , input buf_chk-doc.obj-code
     1014                                               , input buf_chk-doc.doc-code
     1015                                               , input buf_chk-doc.chk-type
     1016                                               ) .
     1017      END.
     1018       run post-add-chks.
     1019       output stream OutStr-html to value(v-report-name-html) append convert target 'UTF-8' .
     1020           put stream OutStr-html unformatted
     1021               substitute (
     1022             '<tbody> <!-- Здесь начинается таблица отчета -->
     1023               <tr>
     1024                   <th style="text-align: center;">Наименование топлива</th>
     1025                   <th style="text-align: center;">№ ТРК</th>
     1026                   <th style="text-align: center;">№ пист</th>
     1027                   <th style="text-align: center;">Счетчик на начало</th>
     1028                   <th style="text-align: center;">Счетчик на конец</th>
     1029                   <th style="text-align: center;">Оборот</th>
     1030                   <th style="text-align: center;">Касса</th>
     1031                   <th style="text-align: center;">Техпролив</th>
     1032                   <th style="text-align: center;">Разница</th>
     1033                   <th style="text-align: center;">Сброс (не пролито)</th>
     1034                   <th style="text-align: center;">Сброс (пролито)</th>
     1035                   <th style="text-align: center;">Перелив</th>
     1036                   <th style="text-align: center;">Перевод транзакции</th>
     1037               </tr>
     1038               <tr>
     1039                   <th style="text-align: center;">9.1</th>
     1040                   <th style="text-align: center;">9.2</th>
     1041                   <th style="text-align: center;">9.3</th>
     1042                   <th style="text-align: center;">9.4</th>
     1043                   <th style="text-align: center;">9.5</th>
     1044                   <th style="text-align: center;">9.6</th>
     1045                   <th style="text-align: center;">9.7</th>
     1046                   <th style="text-align: center;">9.8</th>
     1047                   <th style="text-align: center;">9.9</th>
     1048                   <th style="text-align: center;">9.10</th>
     1049                   <th style="text-align: center;">9.11</th>
     1050                   <th style="text-align: center;">9.12</th>
     1051                   <th style="text-align: center;">9.13</th>
     1052               </tr>
     1053               '
     1054               , chr(123), chr(125)
     1055           ).
     1056      for each  bf_t-9
     1057          break by bf_t-9.gds-code
     1058          :
     1059         IF first-of (bf_t-9.gds-code) THEN DO:
     1060            assign
     1061               pol1  = bf_t-9.gds-name
     1062               pol2  = STRING(bf_t-9.pump-code, ">>9")
     1063               pol3  = STRING(bf_t-9.nozzle-code, ">>9")
     1064               pol4  = bf_t-9.start-mh-qnty
     1065               pol5  = bf_t-9.end-mh-qnty
     1066               pol6  = bf_t-9.meas-qnty
     1067               pol7  = bf_t-9.doc-qnty
     1068               pol8  = bf_t-9.tech-refuell-qnty
     1069               pol9  = bf_t-9.delta
     1070               pol10  = bf_t-9.cancell-qnty
     1071               pol11  = bf_t-9.cancell-qnty-notot
     1072               pol12 = bf_t-9.overflow-qnty
     1073               pol13 = bf_t-9.trans-qnty
     1074            .
     1075         end.
     1076         else do:
     1077            assign
     1078               pol1  = "":U
     1079               pol2  = STRING(bf_t-9.pump-code, ">>9")
     1080               pol3  = STRING(bf_t-9.nozzle-code, ">>9")
     1081               pol4  = bf_t-9.start-mh-qnty
     1082               pol5  = bf_t-9.end-mh-qnty
     1083               pol6  = bf_t-9.meas-qnty
     1084               pol7  = bf_t-9.doc-qnty
     1085               pol8  = bf_t-9.tech-refuell-qnty
     1086               pol9  = bf_t-9.delta
     1087               pol10  = bf_t-9.cancell-qnty
     1088               pol11  = bf_t-9.cancell-qnty-notot
     1089               pol12 = bf_t-9.overflow-qnty
     1090               pol13 = bf_t-9.trans-qnty
     1091            .
     1092         end.
     1093             put stream OutStr-html unformatted
     1094               substitute (
     1095               '
     1096               <tr>
     1097                       <td text_wrap="true">&1</td>
     1098                       <td style="text-align: center;">&2</td>
     1099                       <td style="text-align: center;">&3</td>
     1100                       <td style="text-align: right;">&4</td>
     1101                       <td style="text-align: right;">&5</td>
     1102                       <td style="text-align: right;">&6</td>
     1103                       <td style="text-align: right;">&7</td>
     1104                       <td style="text-align: right;">&8</td>
     1105                       <td style="text-align: right;">&9</td>'
     1106               ,
     1107               pol1,
     1108               pol2,
     1109               pol3,
     1110               string(pol4,"->>>>>>>>>>>9.99"),
     1111               string(pol5,"->>>>>>>>>>>9.99"),
     1112               string(pol6,"->>>>>>>>>>>9.99"),
     1113               string(pol7,"->>>>>>>>>>>9.99"),
     1114               string(pol8,"->>>>>>>>>>>9.99"),
     1115               string(pol9,"->>>>>>>>>>>9.99")
     1116               ).
     1117             put stream OutStr-html unformatted
     1118               substitute (
     1119               '  
     1120                       <td style="text-align: right;">&1</td>
     1121                       <td style="text-align: right;">&2</td>
     1122                       <td style="text-align: right;">&3</td>
     1123                       <td style="text-align: right;">&4</td>
     1124                   </tr>'
     1125               ,
     1126               string(pol10,"->>>>>>>>>>>9.99"),
     1127               string(pol11,"->>>>>>>>>>>9.99"),
     1128               string(pol12,"->>>>>>>>>>>9.99"),
     1129               string(pol13,"->>>>>>>>>>>9.99")
     1130               ).
     1131         accumulate bf_t-9.start-mh-qnty       (Total by bf_t-9.gds-code).
     1132         accumulate bf_t-9.end-mh-qnty         (Total by bf_t-9.gds-code).
     1133         accumulate bf_t-9.meas-qnty           (Total by bf_t-9.gds-code).
     1134         accumulate bf_t-9.doc-qnty            (Total by bf_t-9.gds-code).
     1135         accumulate bf_t-9.delta               (Total by bf_t-9.gds-code).
     1136         accumulate bf_t-9.tech-refuell-qnty   (Total by bf_t-9.gds-code).
     1137         accumulate bf_t-9.cancell-qnty        (Total by bf_t-9.gds-code).
     1138         accumulate bf_t-9.cancell-qnty-notot  (Total by bf_t-9.gds-code).
     1139         accumulate bf_t-9.overflow-qnty       (Total by bf_t-9.gds-code).
     1140         accumulate bf_t-9.trans-qnty          (Total by bf_t-9.gds-code).
     1141         IF last-of (bf_t-9.gds-code) THEN DO:
     1142            assign
     1143               pol1  = SUBSTITUTE("Всего по &1", bf_t-9.gds-name)
     1144               pol2  = ""
     1145               pol3  = ""
     1146               pol4  = accum Total by bf_t-9.gds-code bf_t-9.start-mh-qnty
     1147               pol5  = accum Total by bf_t-9.gds-code bf_t-9.end-mh-qnty
     1148               pol6  = accum Total by bf_t-9.gds-code bf_t-9.meas-qnty
     1149               pol7  = accum Total by bf_t-9.gds-code bf_t-9.doc-qnty
     1150               pol8  = accum Total by bf_t-9.gds-code bf_t-9.tech-refuell-qnty
     1151               pol9  = accum Total by bf_t-9.gds-code bf_t-9.delta
     1152               pol10 = accum Total by bf_t-9.gds-code bf_t-9.cancell-qnty
     1153               pol11 = accum Total by bf_t-9.gds-code bf_t-9.cancell-qnty-notot
     1154               pol12 = accum Total by bf_t-9.gds-code bf_t-9.overflow-qnty
     1155               pol13 = accum Total by bf_t-9.gds-code bf_t-9.trans-qnty
     1156            .
     1157             put stream OutStr-html unformatted
     1158               substitute (
     1159               '
     1160               <tr>
     1161                       <td text_wrap="true">&1</td>
     1162                       <td style="text-align: center;">&2</td>
     1163                       <td style="text-align: center;">&3</td>
     1164                       <td style="text-align: right;">&4</td>
     1165                       <td style="text-align: right;">&5</td>
     1166                       <td style="text-align: right;">&6</td>
     1167                       <td style="text-align: right;">&7</td>
     1168                       <td style="text-align: right;">&8</td>
     1169                       <td style="text-align: right;">&9</td>'
     1170               ,
     1171               pol1,
     1172               pol2,
     1173               pol3,
     1174               string(pol4,"->>>>>>>>>>>9.99"),
     1175               string(pol5,"->>>>>>>>>>>9.99"),
     1176               string(pol6,"->>>>>>>>>>>9.99"),
     1177               string(pol7,"->>>>>>>>>>>9.99"),
     1178               string(pol8,"->>>>>>>>>>>9.99"),
     1179               string(pol9,"->>>>>>>>>>>9.99")
     1180               ).
     1181             put stream OutStr-html unformatted
     1182               substitute (
     1183               '  
     1184                       <td style="text-align: right;">&1</td>
     1185                       <td style="text-align: right;">&2</td>
     1186                       <td style="text-align: right;">&3</td>
     1187                       <td style="text-align: right;">&4</td>
     1188                   </tr>'
     1189               ,
     1190               string(pol10,"->>>>>>>>>>>9.99"),
     1191               string(pol11,"->>>>>>>>>>>9.99"),
     1192               string(pol12,"->>>>>>>>>>>9.99"),
     1193               string(pol13,"->>>>>>>>>>>9.99")
     1194               ).
     1195         END.
     1196      end.
     1197   END.
     1198   output stream OutStr-html close.
     1199   procedure post-add-chks:
     1200       def buffer buf_t-9 for t-9.
     1201       for each buf_t-9:
     1202           buf_t-9.delta = buf_t-9.delta + tech-refuell-qnty.
     1203       end.
     1204   end.
     1205   procedure add-chk :
     1206   define input  parameter p-obj-type like ub.chk-doc.obj-type no-undo .
     1207   define input  parameter p-obj-code like ub.chk-doc.obj-code no-undo .
     1208   define input  parameter p-doc-code like ub.chk-doc.doc-code no-undo .
     1209   define input  parameter p-chk-type like ub.chk-doc.chk-type no-undo .
     1210   define buffer buf_chk-gds for ub.chk-gds.
     1211   define buffer buf_bar-code for ub.bar-code.
     1212   define buffer buf_t-9 for t-9.
     1213   define variable v-pump as integer   no-undo .
     1214   define variable v-nozzle-code    as integer      no-undo.
     1215   define variable v-qnty like ub.chk-gds.doc-qnty no-undo init 0.
     1216   do
     1217   on error undo, return error return-value
     1218   :
     1219      for each buf_chk-gds
     1220         where buf_chk-gds.doc-code = p-doc-code
     1221         no-lock
     1222         ,
     1223         first buf_bar-code
     1224         where buf_bar-code.b-code = buf_chk-gds.b-code
     1225         no-lock
     1226         :
     1227         assign
     1228            v-pump        = buf_chk-gds.pump
     1229            v-nozzle-code = buf_chk-gds.nozzle-code
     1230            v-qnty        = buf_chk-gds.doc-qnty
     1231         .
     1232         find first buf_t-9
     1233               WHERE
     1234                   buf_t-9.gds-code    = buf_bar-code.gds-code
     1235               AND buf_t-9.pump        = v-pump
     1236               AND buf_t-9.nozzle-code = v-nozzle-code
     1237         no-error
     1238         .
     1239         if not available buf_t-9 then do:
     1240            find   buf_t-9
     1241                  WHERE
     1242                      buf_t-9.gds-code    = buf_bar-code.gds-code
     1243                  AND buf_t-9.pump        = v-pump
     1244            no-error
     1245            .
     1246            if not available buf_t-9 then do:
     1247               find first buf_t-9
     1248                     WHERE
     1249                         buf_t-9.gds-code    = buf_bar-code.gds-code
     1250               no-error
     1251               .
     1252               if not available buf_t-9 then do:
     1253                 NEXT.
     1254               end.
     1255               else do:
     1256                 find first buf_goods
     1257                   where buf_goods.gds-code = buf_bar-code.gds-code
     1258                   no-lock
     1259                   .
     1260                 create buf_t-9.
     1261                 assign
     1262                   buf_t-9.gds-code    = buf_bar-code.gds-code
     1263                   buf_t-9.pump        = v-pump
     1264                   buf_t-9.nozzle-code = v-nozzle-code
     1265                   buf_t-9.gds-name    = buf_goods.gds-name
     1266                 .
     1267               end.
     1268            END.
     1269            ELSE DO:
     1270            END.
     1271         end.
     1272         case p-chk-type:
     1273         WHEN integer('1':U)
     1274         OR WHEN integer('6':U)
     1275         then do:
     1276            assign
     1277               buf_t-9.doc-qnty      = buf_t-9.doc-qnty + v-qnty
     1278               buf_t-9.delta         = buf_t-9.delta + v-qnty
     1279            .
     1280         end.
     1281         WHEN integer('15':U) THEN DO:
     1282            assign
     1283               buf_t-9.overflow-qnty = buf_t-9.overflow-qnty + v-qnty
     1284            .
     1285         end.
     1286         WHEN integer('14':U) THEN DO:
     1287            if buf_chk-gds.write-off-code = 0 then
     1288            assign
     1289               buf_t-9.cancell-qnty  = buf_t-9.cancell-qnty  + v-qnty
     1290            .
     1291            if buf_chk-gds.write-off-code = 1 then
     1292            assign
     1293               buf_t-9.cancell-qnty-notot  = buf_t-9.cancell-qnty-notot + v-qnty
     1294            .
     1295         end.
     1296         WHEN integer('16':U) THEN DO:
     1297            assign
     1298               buf_t-9.trans-qnty    = buf_t-9.trans-qnty    + v-qnty
     1299            .
     1300         end.
     1301         WHEN integer('17':U) THEN DO:
     1302             assign
     1303               buf_t-9.tech-refuell-qnty = buf_t-9.tech-refuell-qnty + v-qnty
     1304            .
     1305         end.
     1306         OTHERWISE DO:
     1307         end.
     1308         END case.
     1309      end.
     1310   end.
     1311   end procedure.
     1312   procedure calc-rest :
     1313   DEFINE INPUT PARAMETER p-obj-type         like ub.shift-obj.obj-type    no-undo.
     1314   DEFINE INPUT PARAMETER p-obj-code         like ub.shift-obj.obj-code    no-undo.
     1315   DEFINE INPUT PARAMETER p-shift-date-start like ub.shift-obj.shift-date  no-undo.
     1316   DEFINE INPUT PARAMETER p-shift-num-start  like ub.shift-obj.shift-num   no-undo.
     1317   DEFINE INPUT PARAMETER p-shift-date-end   like ub.shift-obj.shift-date  no-undo.
     1318   DEFINE INPUT PARAMETER p-shift-num-end    like ub.shift-obj.shift-num   no-undo.
     1319   define buffer buf_rvs-doc        for rvs-doc .
     1320   define buffer buf_rvs-line-pump  for rvs-line-pump .
     1321   define buffer buf_t-9            for t-9 .
     1322   define buffer buf2_t-9            for t-9 .
     1323   define buffer buf_shift-obj      for shift-obj .
     1324   define variable v-gds-name  as character    no-undo.
     1325   define variable v-dop as decimal no-undo .
     1326   do
     1327   on error undo, return error
     1328   :
     1329      FIND LAST  buf_shift-obj
     1330           WHERE buf_shift-obj.obj-type = p-obj-type
     1331             AND buf_shift-obj.obj-code = p-obj-code
     1332             and (
     1333                 (buf_shift-obj.shift-date = p-shift-date-start
     1334             AND     buf_shift-obj.shift-num < p-shift-num-start)
     1335              OR
     1336                  buf_shift-obj.shift-date < p-shift-date-start)
     1337           use-index pi
     1338           NO-LOCK
     1339           NO-ERROR
     1340           .
     1341      IF AVAILABLE buf_shift-obj THEN DO:
     1342         find first buf_rvs-doc
     1343            where  buf_rvs-doc.obj-type  = p-obj-type
     1344            and   buf_rvs-doc.obj-code   = p-obj-code
     1345            and   buf_rvs-doc.status_    = 'факт':U
     1346            and   buf_rvs-doc.shift-date = buf_shift-obj.shift-date
     1347            and   buf_rvs-doc.shift-num  = buf_shift-obj.shift-num
     1348            and   buf_rvs-doc.rvs-type   = 'смена':U
     1349            no-lock
     1350            no-error
     1351            .
     1352         IF AVAILABLE buf_rvs-doc THEN DO:
     1353            FOR EACH    buf_rvs-line-pump
     1354                  WHERE buf_rvs-line-pump.rvs-code = buf_rvs-doc.rvs-code
     1355                  NO-LOCK
     1356                  :
     1357                  find first buf_t-9
     1358                        WHERE  buf_t-9.gds-code    = buf_rvs-line-pump.gds-code
     1359                           AND buf_t-9.pump        = buf_rvs-line-pump.pump-code
     1360                           AND buf_t-9.nozzle-code = buf_rvs-line-pump.nozzle-code
     1361                  no-error
     1362                  .
     1363                  if not available buf_t-9 then do:
     1364                       find first buf_goods
     1365                            where buf_goods.gds-code = buf_rvs-line-pump.gds-code
     1366                            no-lock
     1367                            no-error
     1368                            .
     1369                       IF AVAILABLE buf_goods THEN DO:
     1370                          assign
     1371                             v-gds-name = buf_goods.gds-name
     1372                           .
     1373                       END.
     1374                       else do:
     1375                          assign
     1376                             v-gds-name = SUBSTITUTE("Товар &1 не найден", buf_rvs-line-pump.gds-code)
     1377                          .
     1378                       end.
     1379                       create buf_t-9.
     1380                       assign
     1381                         buf_t-9.gds-code    = buf_rvs-line-pump.gds-code
     1382                         buf_t-9.pump        = buf_rvs-line-pump.pump-code
     1383                         buf_t-9.nozzle-code = buf_rvs-line-pump.nozzle-code
     1384                         buf_t-9.gds-name    = v-gds-name
     1385                       .
     1386             ASSIGN
     1387             buf_t-9.start-mh-qnty = buf_rvs-line-pump.state-mh-cnt
     1388             buf_t-9.end-mh-qnty = buf_rvs-line-pump.state-mh-cnt
     1389             buf_t-9.prev-start-mh-qnty = buf_rvs-line-pump.state-mh-cnt
     1390             buf_t-9.start-el-qnty = buf_rvs-line-pump.state-el-cnt
     1391             buf_t-9.end-el-qnty = buf_rvs-line-pump.state-el-cnt
     1392             buf_t-9.prev-start-el-qnty = buf_rvs-line-pump.state-el-cnt
     1393             buf_t-9.delta         = - buf_t-9.meas-qnty
     1394             .
     1395           end.
     1396         END.
     1397         RELEASE buf_rvs-doc.
     1398       END.
     1399     END.
     1400     for each buf_shift-obj no-lock where
     1401             buf_shift-obj.obj-type = p-obj-type
     1402         and buf_shift-obj.obj-code = p-obj-code
     1403         and (buf_shift-obj.shift-date > p-shift-date-start
     1404         or (buf_shift-obj.shift-date = p-shift-date-start
     1405             and
     1406             buf_shift-obj.shift-num >= p-shift-num-start))
     1407         and
     1408            (buf_shift-obj.shift-date < p-shift-date-end
     1409         or (buf_shift-obj.shift-date = p-shift-date-end
     1410             and
     1411             buf_shift-obj.shift-num <= p-shift-num-end))
     1412     by buf_shift-obj.shift-date
     1413     by buf_shift-obj.shift-num:
     1414      find first buf_rvs-doc
     1415         where  buf_rvs-doc.obj-type  = p-obj-type
     1416         and   buf_rvs-doc.obj-code   = p-obj-code
     1417         and   buf_rvs-doc.status_    = 'факт':U
     1418         and   buf_rvs-doc.shift-date = buf_shift-obj.shift-date
     1419         and   buf_rvs-doc.shift-num  = buf_shift-obj.shift-num
     1420         and   buf_rvs-doc.rvs-type   = 'смена':U
     1421         no-lock
     1422         no-error
     1423         .
     1424      IF AVAILABLE buf_rvs-doc THEN DO:
     1425         FOR EACH    buf_rvs-line-pump
     1426               WHERE buf_rvs-line-pump.rvs-code = buf_rvs-doc.rvs-code
     1427               NO-LOCK
     1428               :
     1429               find first buf_t-9
     1430                     WHERE  buf_t-9.gds-code    = buf_rvs-line-pump.gds-code
     1431                     AND buf_t-9.pump        = buf_rvs-line-pump.pump-code
     1432                     AND buf_t-9.nozzle-code = buf_rvs-line-pump.nozzle-code
     1433               no-error
     1434               .
     1435               if not available buf_t-9 then do:
     1436             find first buf2_t-9
     1437                   WHERE   buf2_t-9.pump        = buf_rvs-line-pump.pump-code
     1438                   AND buf2_t-9.nozzle-code = buf_rvs-line-pump.nozzle-code
     1439             no-error
     1440           .
     1441                  find first buf_goods
     1442                     where buf_goods.gds-code = buf_rvs-line-pump.gds-code
     1443                     no-lock
     1444                     no-error
     1445                     .
     1446                  IF AVAILABLE buf_goods THEN DO:
     1447                     assign
     1448                        v-gds-name = buf_goods.gds-name
     1449                     .
     1450                  END.
     1451                  else do:
     1452                     assign
     1453                        v-gds-name = SUBSTITUTE("Товар &1 не найден", buf_rvs-line-pump.gds-code)
     1454                     .
     1455                  end.
     1456                  create buf_t-9.
     1457                  assign
     1458                     buf_t-9.gds-code    = buf_rvs-line-pump.gds-code
     1459                     buf_t-9.pump        = buf_rvs-line-pump.pump-code
     1460                     buf_t-9.nozzle-code = buf_rvs-line-pump.nozzle-code
     1461                     buf_t-9.gds-name    = v-gds-name
     1462                  .
     1463             if available buf2_t-9 then do:
     1464               assign
     1465               buf_t-9.start-mh-qnty = buf2_t-9.prev-start-mh-qnty
     1466               buf_t-9.end-mh-qnty = buf2_t-9.prev-start-mh-qnty
     1467               buf_t-9.prev-start-mh-qnty = buf2_t-9.prev-start-mh-qnty
     1468               buf_t-9.start-el-qnty = buf2_t-9.prev-start-el-qnty
     1469               buf_t-9.end-el-qnty = buf2_t-9.prev-start-el-qnty
     1470               buf_t-9.prev-start-el-qnty = buf2_t-9.prev-start-el-qnty
     1471               .
     1472             end.
     1473             else do:
     1474             v-dop = ?.
     1475             run get-state-mh-cnt-from-icnt-doc in this-procedure (
     1476                                                                    input p-obj-type
     1477                                                                   ,input p-obj-code
     1478                                                                   ,input buf_shift-obj.shift-date
     1479                                                                   ,input buf_shift-obj.shift-num
     1480                                                                   ,input buf_rvs-doc.fact-order
     1481                                                                   ,input buf_t-9.gds-code
     1482                                                                   ,input buf_t-9.pump
     1483                                                                   ,input buf_t-9.nozzle-code
     1484                                                                   ,input-output buf_t-9.prev-start-mh-qnty
     1485                                                                   ,input-output buf_t-9.prev-start-el-qnty
     1486                                                                   ).
     1487             ASSIGN
     1488             buf_t-9.start-mh-qnty = buf_t-9.prev-start-mh-qnty
     1489             buf_t-9.end-mh-qnty = buf_t-9.prev-start-mh-qnty
     1490             buf_t-9.start-el-qnty = buf_t-9.prev-start-el-qnty
     1491             buf_t-9.end-el-qnty = buf_t-9.prev-start-el-qnty
     1492             .
     1493             end.
     1494           end.
     1495           if buf_rvs-line-pump.state-mh-cnt <  buf_t-9.end-mh-qnty then do:
     1496               v-dop = ?.
     1497               run get-state-mh-cnt-from-icnt-doc in this-procedure (
     1498                                                                      input p-obj-type
     1499                                                                     ,input p-obj-code
     1500                                                                     ,input buf_shift-obj.shift-date
     1501                                                                     ,input buf_shift-obj.shift-num
     1502                                                                     ,input buf_rvs-doc.fact-order
     1503                                                                     ,input buf_t-9.gds-code
     1504                                                                     ,input buf_t-9.pump
     1505                                                                     ,input buf_t-9.nozzle-code
     1506                                                                     ,input-output buf_t-9.prev-start-mh-qnty
     1507                                                                     ,input-output buf_t-9.prev-start-el-qnty
     1508                                                                     ).
     1509           end.
     1510           ASSIGN
     1511           buf_t-9.end-mh-qnty = buf_rvs-line-pump.state-mh-cnt
     1512           buf_t-9.end-el-qnty = buf_rvs-line-pump.state-el-cnt
     1513           buf_t-9.meas-qnty   = (if p-tog-1-out-pump-with-icnt
     1514                                 then (buf_t-9.meas-qnty + buf_rvs-line-pump.state-el-cnt - buf_t-9.prev-start-el-qnty)
     1515                                 else (buf_t-9.meas-qnty + buf_rvs-line-pump.state-mh-cnt - buf_t-9.prev-start-mh-qnty)
     1516                                 )
     1517           buf_t-9.delta       = - buf_t-9.meas-qnty
     1518           buf_t-9.prev-start-mh-qnty  = buf_rvs-line-pump.state-mh-cnt
     1519           buf_t-9.prev-start-el-qnty  = buf_rvs-line-pump.state-el-cnt
     1520           .
     1521         END.
     1522       END.
     1523     end.
     1524   end.
     1525   end procedure.
     1526        output stream OutStr-html close.
     1527        output stream OutStr-html to value(v-report-name-html) append convert target 'UTF-8' .
     1528        put stream OutStr-html unformatted
     1529           substitute (
     1530           '
     1531           </tbody>
     1532           '
     1533               , chr(123), chr(125)
     1534          ).
     1535         output stream OutStr-html close.
     1536   procedure get-state-mh-cnt-from-icnt-doc :
     1537   define input parameter p-obj-type as character no-undo .
     1538   define input parameter p-obj-code as integer no-undo .
     1539   define input parameter p-from-shift-date as date no-undo.
     1540   define input parameter p-from-shift-num as integer no-undo.
     1541   define input parameter p-fact-order as decimal no-undo.
     1542   define input parameter p-gds-code as integer no-undo .
     1543   define input parameter p-pump-code as integer no-undo .
     1544   define input parameter p-nozzle-code as integer no-undo .
     1545   define input-output parameter p-state-mh-cnt as decimal no-undo .
     1546   define input-output parameter p-state-el-cnt as decimal no-undo .
     1547   define buffer buf_icnt-doc for ub.icnt-doc.
     1548   define buffer buf_icnt-line for ub.icnt-line.
     1549   for each buf_icnt-doc no-lock
     1550     where buf_icnt-doc.obj-type = p-obj-type
     1551       and buf_icnt-doc.obj-code = p-obj-code
     1552       and buf_icnt-doc.status_ = 'факт':U
     1553       and buf_icnt-doc.fact-order < p-fact-order
     1554       by buf_icnt-doc.fact-order
     1555       descending
     1556   on error undo, return error return-value
     1557   :
     1558         find first buf_icnt-line no-lock where
     1559               buf_icnt-line.doc-code = buf_icnt-doc.doc-code
     1560           and buf_icnt-line.obj-code = buf_icnt-doc.obj-code
     1561           and buf_icnt-line.obj-type = buf_icnt-doc.obj-type
     1562           and buf_icnt-line.gds-code = p-gds-code
     1563           and buf_icnt-line.pump-code = p-pump-code
     1564           and buf_icnt-line.nozzle-code = p-nozzle-code no-error.
     1565       if available buf_icnt-line then do:
     1566         assign
     1567         p-state-mh-cnt = buf_icnt-line.state-mh-cnt.
     1568         p-state-el-cnt = buf_icnt-line.state-el-cnt.
     1569         leave.
     1570       end.
     1571   end.
     1572   end procedure.
