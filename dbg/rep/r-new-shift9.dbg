      205   procedure create_obj-list :
      206      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      207      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      208      do
      209      on error undo, return error return-value
      210      :
      211         define buffer cli-obj for ub.clients .
      212         define variable p-var as integer no-undo .
      213         define buffer buf_obj-list for obj-list .
      214         find last buf_obj-list  use-index pi no-error .
      215         if available buf_obj-list
      216         then
      217            p-var = buf_obj-list.obj-id + 1.
      218         else
      219            p-var = 1.
      220         find first cli-obj where
      221                   cli-obj.obj-type = p-obj-type
      222               and cli-obj.obj-code = p-obj-code
      223         no-lock no-error.
      224         if available cli-obj
      225         then do:
      226            create buf_obj-list.
      227            assign
      228               buf_obj-list.obj-id   = p-var
      229               buf_obj-list.obj-code = cli-obj.obj-code
      230               buf_obj-list.obj-type = cli-obj.obj-type
      231               buf_obj-list.obj-name = cli-obj.obj-name
      232               buf_obj-list.db-num   = cli-obj.db-num
      233            .
      234         end.
      235      end.
      236   end.
