        1   block-level on error undo, throw.
        2   define input parameter parparentproc        as widget-handle    no-undo.
        3   define input parameter rec_id               as recid            no-undo.
        4   define input parameter type-doc             as character        no-undo.
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: r-specsr.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: rep/r-specsr.p $":U .
       10   define variable vss-description as character no-undo init " Печать Приложение к документу по серийным номерам   ".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       72   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       73   define  shared variable RepPathName        as character no-undo .
       74   define  shared variable PrintRubl          as logical   no-undo .
       75   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       76   define  stream PrnLibStream.
       77   procedure prn-lib-prn-file :
       78     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
       79     define input parameter p-DIsabledoptions as integer no-undo .
       80     define variable v-report-name as character no-undo .
       81     define variable v-user-action as character no-undo .
       82     define variable v-printed     as logical   no-undo .
       83     define variable v-exist       as logical   no-undo .
       84     do
       85       on error undo, return error
       86       :
       87       run prn-lib-get-report-name  in this-procedure (
       88         input parParentProc
       89         ,output v-report-name
       90         ).
       91   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       92   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
       93     (input  v-report-name
       94     ,input  2
       95     ,output v-exist
       96     )  .
       97       if NOT v-exist then
       98       DO:
       99         Message
      100           "Нет заданий на печать ! "
      101           view-as alert-box .
      102         Return  .
      103       End.
      104       run gbl/prnfilen.w
      105         (input  ""
      106         ,input  p-DisabledOptions
      107         ,input  string(v-report-name )
      108         ,input  7
      109         ,output v-user-action
      110         ,output v-printed
      111         ) .
      112       if v-printed then
      113       do:
      114         return "YES" .
      115       end.
      116       else
      117       do:
      118         return "NO" .
      119       end.
      120     end.
      121   end procedure.
      122   procedure prn-lib-open-stream :
      123     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      124     define input parameter p-page-size    as integer no-undo .
      125     define input parameter p-is-stream    as logical no-undo .
      126     define input parameter p-append       as logical no-undo .
      127     define variable v-report-name as character no-undo .
      128     do
      129       on error undo, return error
      130       :
      131       run prn-lib-get-report-name  in this-procedure (
      132         input parParentProc
      133         ,output v-report-name
      134         ).
      135       if p-is-stream then
      136       do:
      137         if p-append then
      138         do:
      139           output stream PrnLibStream to value( v-report-name )
      140             page-size value(p-page-size) append .
      141         end.
      142         if not p-append then
      143         do:
      144           output stream PrnLibStream to value( v-report-name )
      145             page-size value(p-page-size) .
      146         end.
      147       end.
      148       if not p-is-stream then
      149       do:
      150         if p-append then
      151         do:
      152           output to value( v-report-name )
      153             page-size value(p-page-size) append .
      154         end.
      155         if not p-append then
      156         do:
      157           output to value( v-report-name )
      158             page-size value(p-page-size) .
      159         end.
      160       end.
      161     end.
      162   end procedure.
      163   procedure prn-lib-open-exp :
      164     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      165     define input parameter p-is-stream    as logical no-undo .
      166     define input parameter p-is-append    as logical no-undo .
      167     define output parameter p-ReportFileName as char init "report" no-undo.
      168     define output parameter p-process as logical no-undo .
      169     define variable glog as logical no-undo .
      170     do
      171       on error undo, return error
      172       :
      173       SYSTEM-DIALOG GET-FILE p-ReportFileName
      174         TITLE      "Укажите путь"
      175         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      176         ASK-OVERWRITE
      177         CREATE-TEST-FILE
      178         SAVE-AS
      179         USE-FILENAME
      180         DEFAULT-EXTENSION "txt"
      181         UPDATE glog
      182         .
      183       if not glog then  return.
      184       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      185       if p-is-stream then
      186       do:
      187         if p-is-append then
      188         do:
      189           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      190         end.
      191         else
      192         do:
      193           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      194         end.
      195       end.
      196       else
      197       do:
      198         if p-is-append then
      199         do:
      200           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      201         end.
      202         else
      203         do:
      204           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      205         end.
      206       end.
      207       p-process = yes.
      208     end.
      209   end procedure.
      210   procedure prn-lib-get-report-name :
      211     define input parameter parParentProc  as widget-handle no-undo.
      212     define output parameter p-report-name as character no-undo .
      213     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      214   end procedure.
      215   procedure prn-lib-reportviewer-report-name :
      216     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      217     define input parameter p-report-name-html as character no-undo .
      218     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      219   end procedure.
      220   procedure prn-lib-reportviewer :
      221     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      222     define input parameter p-report-name-html as character no-undo .
      223     define input parameter p-param        as character no-undo .
      224     define variable v-excel           as character no-undo init 'TRUE' .
      225     define variable v-value-character as character no-undo .
      226     define variable v-value-integer   as character no-undo .
      227     define variable v-value-date      as date      no-undo .
      228     define variable v-value-decimal   as decimal   no-undo .
      229     define variable rep-excel         as logical   no-undo .
      230     define variable excel-string      as character no-undo .
      231     define variable v-param-type      as character no-undo .
      232     define variable v-tth             as handle    no-undo .
      233     run adm/shattri.p (
      234       input "get":U
      235       ,input  ""
      236       ,input  0
      237       ,input  'report-glob':U
      238       ,input  'rep-excel':U
      239       ,output v-value-character
      240       ,output v-value-date
      241       ,output v-value-decimal
      242       ,output v-value-integer
      243       ,output rep-excel
      244       ,output v-param-type
      245       ,INPUT-OUTPUT table-handle v-tth
      246       )  .
      247     if rep-excel then v-excel = "TRUE" .
      248     else v-excel = "FALSE" .
      249     if p-param eq ""
      250     then
      251        p-param = "EXCEL:" + v-excel.
      252     else
      253        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      254     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      255   end procedure.
      256   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      257     define variable v-cntxt-db-num        as integer   no-undo .
      258     define variable v-cntxt-userid        as character no-undo .
      259     define variable v-cntxt-level         as character no-undo .
      260     define variable v-cntxt-host-code-obj as integer   no-undo .
      261     define variable v-cntxt-obj-type      as character no-undo .
      262     define variable v-cntxt-obj-code      as integer   no-undo .
      263     define variable v-cntxt-db-num-obj    as integer   no-undo .
      264     define variable v-cntxt-is-admin      as logical   no-undo .
      265   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      266     run mainmenu_getcntxt in parparentproc
      267       (output v-cntxt-db-num
      268       ,output v-cntxt-userid
      269       ,output v-cntxt-level
      270       ,output v-cntxt-host-code-obj
      271       ,output v-cntxt-obj-type
      272       ,output v-cntxt-obj-code
      273       ,output v-cntxt-db-num-obj
      274       ,output v-cntxt-is-admin
      275       ) .
      276   define variable sym1 as char init ":" no-undo.
      277   define variable sym2 as char init ":" no-undo.
      278   define variable sym3 as char init ":" no-undo.
      279   define variable sym4 as char init ":" no-undo.
      280   def buffer cli-store for clients.
      281   def buffer Our_Host for clients.
      282   define variable Line                   as      char    no-undo.
      283   define variable Lines_Counter   as      integer                 no-undo.
      284   if type-doc = 'касс':U then do:
      285     FIND chk-doc WHERE recid( chk-doc ) = rec_id  NO-LOCK.
      286             if lookup(string(chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then do:
      287              message
      288              substitute("Нельзя напечатать данный документ по чекаи типа &1", entry (lookup (string(chk-doc.chk-type), '1,6,8,69,96,14,15,16,36,17,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) + 1, ',' + 'Продажа,Возврат,Аннуляция,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,РазблТрнзкц,ТехПролив,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,_Продажа,_Возврат,_Аннуляция,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_Инвентаризация,_Z-отчет,_РазблТрнзкц,_Закрытие_смены,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ,Приход_Корр,Расход_Корр':U))
      289              view-as alert-box error .
      290              undo, return error .
      291           end.
      292     if chk-doc.obj-type = 'маг':U then do:
      293       FIND shop WHERE shop.obj-code = chk-doc.obj-code NO-LOCK.
      294       FIND Our_Host WHERE Our_Host.obj-type = 'орг':U
      295                                               AND Our_Host.obj-code = shop.host-code NO-LOCK.
      296     end.
      297     else do:
      298       FIND store WHERE store.obj-code = chk-doc.obj-code NO-LOCK.
      299       FIND Our_Host WHERE Our_Host.obj-type = 'орг':U
      300                                               AND Our_Host.obj-code = store.host-code NO-LOCK.
      301     end.
      302   end.
      303   else do:
      304     FIND trn-doc WHERE recid( trn-doc ) = rec_id  NO-LOCK.
      305     FIND Our_Host WHERE Our_Host.obj-type = 'орг':U
      306                                             AND Our_Host.obj-code = trn-doc.host-code NO-LOCK.
      307   end.
      308   DEFINE FRAME parts-print
      309   sym1 column-label ":" format "X(1)"
      310   Lines_Counter COLUMN-LABEL "N п/п" format ">>>>9"
      311   sym2 column-label ":" format "X(1)"
      312   goods.gds-name COLUMN-LABEL "Наименование" format "X(93)"
      313   sym3 column-label ":" format "X(1)"
      314   parts.part-code COLUMN-LABEL "Серийный номер" format "X(27)"
      315   sym4 column-label ":" format "X(1)"
      316   HEADER
      317   "Страница " AT 120 PAGE-NUMBER( PrnLibStream ) AT 130 FORMAT ">>9" SKIP
      318   Line format "X(135)" AT 1
      319   with width 235 down stream-io.
      320   if session:set-wait-state("compiler") then.
      321   Line = fill("-", 200).
      322   assign Lines_Counter = 1.
      323   run prn-lib-open-stream  in this-procedure (
      324                                                input parParentProc
      325                                               ,input 62
      326                                               ,input yes
      327                                               ,input no
      328                                               ).
      329   FORM with FRAME parts-print .
      330   FORM HEADER
      331   Line format "X(135)" AT 1 SKIP
      332   "Продолжение - на следующей странице" AT 30 SKIP
      333   with FRAME BottomFrame width 160 PAGE-BOTTOM NO-LABELS NO-BOX .
      334   VIEW STREAM PrnLibStream FRAME BottomFrame .
      335   CASE type-doc:
      336       WHEN 'касс':U THEN  do:
      337         FIND cli-store WHERE cli-store.obj-type = chk-doc.obj-type AND cli-store.obj-code = chk-doc.obj-code NO-LOCK.
      338         PUT STREAM PrnLibStream "Поставщик : " AT 10
      339             string( trim( Our_Host.obj-name ) + ", " + trim( cli-store.obj-name ) ) format "X(100)" SKIP(1).
      340         PUT STREAM PrnLibStream "ПРИЛОЖЕНИЕ К КАССОВОМУ ЧЕКУ Nr "
      341             AT 37 format "X(37)" string( chk-doc.chk-num ) format "X(10)" "  от  "
      342             chk-doc.chk-date format "99.99.9999" SKIP(1).
      343         FIND dis-card WHERE dis-card.d-card = chk-doc.d-card NO-LOCK .
      344         FIND clients WHERE clients.obj-type = dis-card.cli-type AND
      345                                             clients.obj-code = dis-card.cli-code NO-LOCK .
      346         PUT STREAM PrnLibStream "Получатель : " AT 9 clients.obj-name format "X(50)" SKIP(1).
      347       end.
      348       WHEN 'рас':U THEN  do:
      349         FIND cli-store WHERE cli-store.obj-type = trn-doc.obj-type AND cli-store.obj-code = trn-doc.obj-code NO-LOCK.
      350         PUT STREAM PrnLibStream "Поставщик : " AT 10
      351             string( trim( Our_Host.obj-name ) + ", " + trim( cli-store.obj-name ) ) format "X(100)" SKIP(1).
      352         PUT STREAM PrnLibStream "ПРИЛОЖЕНИЕ К РАСХОДНОЙ НАКЛАДНОЙ Nr "
      353             AT 37 format "X(37)" trn-doc.doc-code format "X(10)" "  от  "
      354             trn-doc.doc-date format "99.99.9999" SKIP(1).
      355         FIND clients WHERE clients.obj-type = trn-doc.cli-type AND clients.obj-code = trn-doc.cli-code NO-LOCK.
      356         PUT STREAM PrnLibStream "Получатель : " AT 9 clients.obj-name format "X(50)" SKIP(1).
      357       end.
      358       WHEN 'при':U THEN do:
      359         FIND clients WHERE clients.obj-type = trn-doc.cli-type AND clients.obj-code = trn-doc.cli-code NO-LOCK.
      360         PUT STREAM PrnLibStream "Поставщик : " AT 10 clients.obj-name format "X(50)" SKIP(1).
      361         PUT STREAM PrnLibStream "ПРИЛОЖЕНИЕ К ПРИХОДНОЙ НАКЛАДНОЙ Nr "
      362             AT 37 format "X(37)" trn-doc.doc-code format "X(10)" "  от  "
      363             trn-doc.doc-date format "99.99.9999" SKIP(1).
      364         FIND clients WHERE clients.obj-type = 'орг':U AND clients.obj-code = Our_Host.obj-code NO-LOCK.
      365         FIND cli-store WHERE cli-store.obj-type = trn-doc.obj-type AND cli-store.obj-code = trn-doc.obj-code NO-LOCK.
      366         PUT STREAM PrnLibStream "Получатель : " AT 9
      367             string( trim( Our_Host.obj-name ) + ", " + trim( cli-store.obj-name ) ) format "X(100)" SKIP(1).
      368       end.
      369   END CASE.
      370   CASE clients.obj-type :
      371       WHEN 'орг':U THEN do:
      372         FIND firm WHERE firm.firm-code = clients.obj-code NO-LOCK.
      373         PUT STREAM PrnLibStream
      374         "Основание :  Лицензия " AT 10 firm.phone1-note format "X(100)" SKIP
      375         "выдана " AT 23 firm.e-mail format "X(100)" SKIP(1) .
      376       end.
      377       WHEN 'чел':U THEN do:
      378           FIND person WHERE person.psn-code = clients.obj-code NO-LOCK.
      379           PUT STREAM PrnLibStream "Адрес : " AT 14
      380           trim( string( trim( person.city ) + " " + trim( person.address ) ) ) format "X(100)" SKIP(1)
      381           "Основание :  Лицензия " AT 10 person.phone1-note format "X(100)" SKIP
      382           "выдана " AT 23 person.e-mail format "X(100)" SKIP(1) .
      383       end.
      384   END CASE.
      385   if type-doc = 'касс':U then do:
      386     FOR EACH chk-gds WHERE chk-gds.doc-code = chk-doc.doc-code NO-LOCK :
      387       FIND bar-code WHERE bar-code.b-code = chk-gds.b-code NO-LOCK NO-ERROR.
      388       IF AVAIL bar-code then do:
      389         FIND goods WHERE goods.gds-code = bar-code.gds-code  NO-LOCK .
      390         FIND units WHERE units.unit-name = goods.unit-base NO-LOCK.
      391         if LOOKUP('сер':U, units.type) = 0 then  NEXT.
      392       end.
      393       DISPLAY STREAM PrnLibStream
      394       sym1 Lines_Counter
      395       sym2 if avail bar-code then goods.gds-name else "" @ goods.gds-name
      396       sym3 if avail bar-code then bar-code.part-code else "" @ parts.part-code
      397       sym4
      398       with FRAME parts-print .
      399       DOWN STREAM PrnLibStream 1 with FRAME parts-print .
      400       assign
      401       Lines_Counter = Lines_Counter + 1 .
      402       .
      403     END.
      404   end.
      405   else do:
      406     FOR EACH doc-line WHERE
      407             doc-line.doc-code = trn-doc.doc-code NO-LOCK
      408     BY doc-line.artic:
      409       FIND goods WHERE goods.prod-type = doc-line.prod-type AND
      410                                         goods.prod-code = doc-line.prod-code AND
      411                                         goods.artic = doc-line.artic NO-LOCK .
      412       FIND units WHERE units.unit-name = goods.unit-base NO-LOCK.
      413       if LOOKUP('сер':U, units.type) = 0 then
      414           NEXT.
      415       FOR EACH parts WHERE
      416                parts.obj-type = cli-store.obj-type
      417           AND parts.obj-code = cli-store.obj-code
      418           AND parts.artic = doc-line.artic
      419           AND parts.prod-type = doc-line.prod-type
      420           AND parts.prod-code = doc-line.prod-code
      421           AND parts.out-code = trn-doc.doc-code
      422       NO-LOCK BY parts.part-code:
      423         DISPLAY STREAM PrnLibStream
      424         sym1 Lines_Counter
      425         sym2 goods.gds-name
      426         sym3 parts.part-code
      427         sym4
      428         with FRAME parts-print .
      429         DOWN STREAM PrnLibStream 1 with FRAME parts-print .
      430         assign
      431         Lines_Counter = Lines_Counter + 1 .
      432         .
      433       END.
      434     END.
      435   end.
      436   PUT STREAM PrnLibStream Line format "X(135)" SKIP(1) .
      437   if type-doc <> 'при':U then
      438   PUT STREAM PrnLibStream
      439   string( "Товар технически исправен, не имеет повреждений, " +
      440                                                             "укомплектован полностью, имеет надлежащий вид." ) format "X(135)" SKIP(1) .
      441   PUT STREAM PrnLibStream
      442   "Поставщик :" AT 15 "Получатель :" AT 95 SKIP(1)
      443   "___________" AT 15 "____________" AT 95 SKIP.
      444   HIDE STREAM PrnLibStream FRAME BottomFrame .
      445   output STREAM PrnLibStream CLOSE.
      446   if session:set-wait-state("") then.
      447   define variable Log-Res as log no-undo .
      448   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      449   do:
      450     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      451       (input  v-cntxt-db-num
      452       ,input  v-cntxt-userid
      453       ,input  0
      454       ,input  'actn_waybills-to-file_print':U
      455       ,input  'firm':U
      456       ,input  Our_Host.obj-code
      457       ,input  '':U
      458       ,input  0
      459       ,input  0
      460       ,input  0
      461       ,input  0
      462       ,input  false
      463       ,output Log-Res
      464       )  .
      465   end.
      466   if type-doc = 'касс':U then DO:
      467     if Log-Res then do:
      468        run prn-lib-prn-file in this-procedure (
      469                                             input parParentProc
      470                                             ,input 0
      471                                             ).
      472     end.
      473     else do:
      474       run prn-lib-prn-file in this-procedure (
      475                                                 input parParentProc
      476                                                 ,input 4
      477                                                 ).
      478     end.
      479   end.
      480   else do:
      481     define variable g#quest-print as logical no-undo .
      482     define variable g#report-num as integer no-undo .
      483     define variable g#log as logical no-undo .
      484     run get-quest-print in parparentproc
      485       (output g#quest-print
      486       ) .
      487     run get-report-num  in parParentProc(output g#report-num).
      488     if Log-Res then DO:
      489   if g#quest-print = false
      490   then do:
      491     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
      492                                         7, (if 0 >= 8 then 2 else 0), 0, 0,
      493                                         OUTPUT g#log ).
      494   end.
      495   else do:
      496     os-command silent
      497       value( "COPY /b " +
      498         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
      499         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
      500         string( session:temp-directory) +  "$" + string( g#report-num )
      501                 ) .
      502     os-command silent
      503       value( "COPY /b " +
      504         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
      505         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
      506         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
      507                 ) .
      508   end.
      509     End.
      510     else  DO:
      511   if g#quest-print = false
      512   then do:
      513     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
      514                                         7, (if 4 >= 8 then 2 else 0), 0, 0,
      515                                         OUTPUT g#log ).
      516   end.
      517   else do:
      518     os-command silent
      519       value( "COPY /b " +
      520         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
      521         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
      522         string( session:temp-directory) +  "$" + string( g#report-num )
      523                 ) .
      524     os-command silent
      525       value( "COPY /b " +
      526         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
      527         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
      528         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
      529                 ) .
      530   end.
      531     End.
      532   end.
