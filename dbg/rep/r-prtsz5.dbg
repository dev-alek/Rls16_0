     5589                                                           f-cost-sum   = determined(ub.gds-obj.fact-rubl)
     5590                                                           f-sale-sum   = ub.gds-obj.fact-sale
     5591                                                           f-free-qnty  = ub.gds-obj.free-qnty
     5592                                                           f-cost-pr   = if f-qnty = 0 then 0 else f-cost-sum / f-qnty
     5593                                                           f-sale-pr   = if f-qnty = 0 then 0 else f-sale-sum / f-qnty
     5594                                                           .
     5595                                           end.
     5596                                       f-sale-other = 100 * determined((f-sale-sum - f-cost-sum) / f-cost-sum).
     5597                                       if c-f-wait-qnty <> ? Then DO :
