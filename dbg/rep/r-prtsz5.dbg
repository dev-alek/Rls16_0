      376   procedure create_obj-list :
      377      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      378      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      379      do
      380      on error undo, return error return-value
      381      :
      382         define buffer cli-obj for ub.clients .
      383         define variable p-var as integer no-undo .
      384         define buffer buf_obj-list for obj-list .
      385         find last buf_obj-list  use-index pi no-error .
      386         if available buf_obj-list
      387         then
      388            p-var = buf_obj-list.obj-id + 1.
      389         else
      390            p-var = 1.
      391         find first cli-obj where
      392                   cli-obj.obj-type = p-obj-type
      393               and cli-obj.obj-code = p-obj-code
      394         no-lock no-error.
      395         if available cli-obj
      396         then do:
      397            create buf_obj-list.
      398            assign
      399               buf_obj-list.obj-id   = p-var
      400               buf_obj-list.obj-code = cli-obj.obj-code
      401               buf_obj-list.obj-type = cli-obj.obj-type
      402               buf_obj-list.obj-name = cli-obj.obj-name
      403               buf_obj-list.db-num   = cli-obj.db-num
      404            .
      405         end.
      406      end.
      407   end.
