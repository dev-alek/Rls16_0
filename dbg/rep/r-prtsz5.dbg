     6918                                                           f-cost-sum   = determined(gds-obj.fact-rubl)
     6919                                                           f-sale-sum   = ub.gds-obj.fact-sale
     6920                                                           f-free-qnty  = ub.gds-obj.free-qnty
     6921                                                           f-cost-pr    = if f-qnty = 0 then 0 else f-cost-sum / f-qnty
     6922                                                           f-sale-pr    = if f-qnty = 0 then 0 else f-sale-sum / f-qnty
     6923                                                        .
     6924                                           end.
