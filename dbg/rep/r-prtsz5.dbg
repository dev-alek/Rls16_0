     7352       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7353           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7354           display STREAM OutStream    with frame top-frame .
     7355       End.
     7356     End.
     7357     if c-f-sale-sum <>  ?  then do :
     7358       c-f-sale-sum:screen-value = string(accum TOTAL f-sale-sum) .
     7359       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7360           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7361           display STREAM OutStream    with frame top-frame .
