     7338       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7339           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7340           display STREAM OutStream    with frame top-frame .
     7341       End.
     7342     End.
     7343     if c-f-qnty <>  ?  then do :
     7344       c-f-qnty:screen-value = string(accum TOTAL f-qnty) .
     7345       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7346           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7347           display STREAM OutStream    with frame top-frame .
