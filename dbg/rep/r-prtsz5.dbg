     7287           display STREAM OutStream    with frame top-frame .
     7288       End.
     7289     End.
     7290     if c-f-sale-other <>  ?  then do :
     7291       c-f-sale-other:screen-value = string(accum TOTAL f-sale-other) .
     7292       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7293           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7294           display STREAM OutStream    with frame top-frame .
     7295       End.
     7296     End.
     7297     if c-f-free-qnty <>  ?  then do :
     7298       c-f-free-qnty:screen-value = string(accum TOTAL f-free-qnty) .
     7299       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7300           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7301           display STREAM OutStream    with frame top-frame .
     7302       End.
     7303     End.
     7304     if c-f-wait-qnty <>  ?  then do :
     7305       c-f-wait-qnty:screen-value = string(accum TOTAL f-wait-qnty) .
     7306       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7307           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7308           display STREAM OutStream    with frame top-frame .
     7309       End.
     7310     End.
     7311           Display stream OutStream no-error.
     7312           DOWN stream OutStream .
     7313           run u-line in this-procedure.
     7314           if Make-Excel then  put   stream ForExcel unformatted
     7315             "ИТОГО"                         CHR(9)
     7316             "по объекту"                    CHR(9)
     7317             obj-list.obj-name               CHR(9)  CHR(9)  CHR(9)
     7318             excel-qnty(accum TOTAL f-qnty           )  CHR(9)
     7319             CHR(9)
     7320             excel-sum (accum TOTAL f-cost-sum       )  CHR(9)
     7321             CHR(9)
     7322             excel-sum (accum TOTAL f-sale-sum       )  CHR(9)
     7323             excel-sum (accum TOTAL f-sale-other    )   CHR(9)
     7324             excel-sum (accum TOTAL f-free-qnty     )   CHR(9)
     7325             excel-sum (accum TOTAL f-wait-qnty     )   CHR(9)
     7326             chr(10) .
     7327   End.
     7328      if n-no > 1 then do:
     7329     if c-nn <>  ?  then do :
     7330       c-nn:screen-value = string('ИТОГО') .
     7331       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7332           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7333           display STREAM OutStream    with frame top-frame .
     7334       End.
     7335     End.
     7336     if c-f-artic <>  ?  then do :
