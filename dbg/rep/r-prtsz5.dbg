     7366       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7367           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7368           display STREAM OutStream    with frame top-frame .
