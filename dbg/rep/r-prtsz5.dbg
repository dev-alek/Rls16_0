     5556                                                           output  SLT_R1    ,
     5557                                                           output  SLT_V1     ).
     5558                                                       Assign
     5559                                                           f-qnty       = Quantity1
     5560                                                           f-sale-sum   = if tprintrubl then Coast_R1 else Coast_V1
     5561                                                           f-sale-pr    = if f-qnty = 0 then 0 else  f-sale-sum  / f-qnty
     5562                                                           .
     5563                                                         RUN ost-line in this-procedure
     5564                                                         (input   ub.gds-obj.obj-code  ,
     5565                                                           input   ub.gds-obj.obj-type  ,
     5566                                                           INPUT   ub.gds-obj.artic     ,
     5567                                                           INPUT   ub.gds-obj.prod-code ,
