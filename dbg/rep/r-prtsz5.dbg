     7373       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7374           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7375           display STREAM OutStream    with frame top-frame .
