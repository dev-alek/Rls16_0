     7402   procedure display-prt :
     7403   define variable pr-cursor as integer no-undo init 0.
     7404   define variable go-work   as logical no-undo init no.
     7405   define variable v-tmp-prt like gds-prt.node-code init -1.
     7406   IF goods.prt-root <> Prtroot Then DO:
     7407       If v-var = "no-today"  then do:
     7408   run  prdoclib-init-prt-obj-by-factord in this-procedure
     7409   ( input gds-obj.obj-type  ,
     7410     input gds-obj.obj-code  ,
     7411     input gds-obj.artic     ,
     7412     input gds-obj.prod-type ,
     7413     input gds-obj.prod-code ,
     7414     input fact-order-2 ,
     7415     input false ) .
     7416       end.
     7417     for each prt-obj where
     7418         prt-obj.artic     = goods.artic     and
     7419         prt-obj.prod-type = goods.prod-type and
     7420         prt-obj.prod-code = goods.prod-code and
     7421         prt-obj.obj-code  = obj-list.obj-code and
     7422         prt-obj.obj-type  = obj-list.obj-type and
     7423         prt-obj.is-term   =  true no-lock
     7424         BREAK BY prt-obj.prt-code with FRAME Zapas :
     7425         pr-cursor = 0.
     7426         go-work = false.
     7427         if v-prizn = "" then do:
     7428           go-work = true.
     7429         end.
     7430         else do:
     7431             do while pr-cursor < num-entries(v-prizn,","):
     7432                 pr-cursor = pr-cursor + 1.
     7433                 if entry(pr-cursor,v-prizn,",") <> "" then do:
     7434                     if integer(entry(pr-cursor,v-prizn,",")) = prt-obj.prt-code then do:
     7435                         pr-cursor = num-entries(v-prizn,",").
     7436                         go-work = true.
     7437                     end.
     7438                 end.
     7439             end.
     7440         end.
     7441         if go-work then do:
     7442             if v-var <> "no-today" then do:
     7443                 Assign
     7444                   p-qnty      = p-qnty       + prt-obj.fact-qnty
     7445                   p-free-qnty = p-free-qnty  + prt-obj.free-qnty
     7446                   p-sale-sum  = p-sale-sum   + prt-obj.fact-qnty * prt-obj.price-sale
     7447                   p-sale-pr   = if p-qnty = 0 then 0 else p-sale-sum / p-qnty
     7448                   .
     7449             End.
     7450             IF last-of(prt-obj.prt-code) THEN DO:
     7451   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     7452     (input  gds-obj.gds-code
     7453     ,input  prt-obj.prt-code
     7454     ,output v-bar-code
     7455     )  .
     7456                 if v-var = "no-today" then do:
     7457                   find first temp-prt-obj no-lock
     7458                        where temp-prt-obj.prt-obj-recid   = recid (prt-obj) no-error .
     7459                        if avail temp-prt-obj then do :
     7460                           run  calc-price-sale-for-prt in this-procedure  (output v-price-sale) .
     7461                           Assign
     7462                             p-qnty      = temp-prt-obj.fact-qnty
     7463                             p-free-qnty = 0
     7464                             p-sale-sum  = temp-prt-obj.fact-qnty * v-price-sale
     7465                             p-sale-pr   = if p-qnty = 0 then 0 else p-sale-sum / p-qnty
     7466                             .
     7467                         End.
     7468                         Else
     7469                           Assign
     7470                             p-qnty      = 0
     7471                             p-free-qnty = 0
     7472                             p-sale-sum  = 0   .
     7473                 End.
     7474           FIND first gds-prt  where gds-prt.node-code = prt-obj.prt-code NO-LOCK no-error .
     7475           if c-f-wait-qnty <> ? Then DO :
     7476             for each trn-doc no-lock  where
     7477                 trn-doc.obj-code        = obj-list.obj-code and
     7478                 trn-doc.obj-type        = obj-list.obj-type and
     7479                 trn-doc.status_         = 'накл':U           and
     7480                 trn-doc.flag_           = true              and
     7481                 trn-doc.ext-doc-type    = 'ie':U :
     7482                 for each gds-dtl no-lock where
     7483                     gds-dtl.doc-code   = trn-doc.doc-code   and
     7484                     gds-dtl.artic      = goods.artic        and
     7485                     gds-dtl.prod-code  = goods.prod-code    and
     7486                     gds-dtl.prod-type  = goods.prod-type    and
     7487                     gds-dtl.prt-code   = prt-obj.prt-code   and
     7488                     gds-dtl.obj-code   = obj-list.obj-code  and
     7489                     gds-dtl.obj-type   = obj-list.obj-type :
     7490                     Assign
     7491                     p-wait-qnty   = p-wait-qnty     + gds-dtl.fact-qnty.
     7492                 end.
     7493             End.
     7494           End.
     7495           if ( f-rez-qnty <> ? or
     7496               f-rez-cost <> ? or
     7497               f-rez-sale <> ? ) and  v-var <> "no-today"
     7498           then do:
     7499                 for each temp_gds-dtl where
     7500                           temp_gds-dtl.prt-code   = prt-obj.prt-code  :
     7501                     assign
     7502                       p-rez-qnty = p-rez-qnty  + temp_gds-dtl.doc-qnty
     7503                       p-rez-cost = p-rez-cost  + temp_gds-dtl.cost-sum
     7504                       p-rez-sale = p-rez-sale  + temp_gds-dtl.sale-sum
     7505                       p-rez-cost-pr = ( if p-rez-qnty = 0 then 0 else p-rez-cost / p-rez-qnty )
     7506                     .
     7507                 end.
     7508           end.
     7509           Assign
     7510           p-cost-sum     = determined( f-cost-sum * p-qnty  / f-qnty)
     7511           p-sale-other   = 100 * determined((p-sale-sum - p-cost-sum) / p-cost-sum)
     7512           p-cost-pr      = if p-qnty = 0 then 0 else p-cost-sum   / p-qnty
     7513           .
     7514           if not (p-zero = false  and
     7515                (p-qnty        =  0  and
     7516                 p-cost-sum    =  0  and
     7517                 p-sale-sum    =  0  and
     7518                 p-sale-other  =  0  and
     7519                 p-free-qnty   =  0  and
     7520                     p-wait-qnty  = 0  ) ) then do:
     7521     if c-nn <>  ?  then do :
     7522       c-nn:screen-value = string('') .
     7523       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7524           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7525           display STREAM OutStream    with frame top-frame .
     7526       End.
     7527     End.
     7528     if c-f-artic <>  ?  then do :
     7529       c-f-artic:screen-value = string('') .
     7530       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7531           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7532           display STREAM OutStream    with frame top-frame .
     7533       End.
     7534     End.
     7535     if c-f-b-code <>  ?  then do :
     7536       c-f-b-code:screen-value = string(string(v-bar-code,'999999999')) .
     7537       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7538           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7539           display STREAM OutStream    with frame top-frame .
     7540       End.
     7541     End.
     7542     if c-f-prt-name <>  ?  then do :
     7543       c-f-prt-name:screen-value = string(gds-prt.f-name) .
     7544       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7545           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7546           display STREAM OutStream    with frame top-frame .
     7547       End.
     7548     End.
     7549     if c-f-qnty <>  ?  then do :
     7550       c-f-qnty:screen-value = string(p-qnty) .
     7551       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7552           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7553           display STREAM OutStream    with frame top-frame .
     7554       End.
     7555     End.
     7556     if c-f-cost-pr <>  ?  then do :
     7557       c-f-cost-pr:screen-value = string(p-cost-pr) .
     7558       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7559           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7560           display STREAM OutStream    with frame top-frame .
     7561       End.
     7562     End.
     7563     if c-f-cost-sum <>  ?  then do :
     7564       c-f-cost-sum:screen-value = string(p-cost-sum) .
     7565       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7566           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7567           display STREAM OutStream    with frame top-frame .
     7568       End.
     7569     End.
     7570     if c-f-sale-pr <>  ?  then do :
     7571       c-f-sale-pr:screen-value = string(p-sale-pr) .
     7572       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7573           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7574           display STREAM OutStream    with frame top-frame .
     7575       End.
     7576     End.
     7577     if c-f-sale-sum <>  ?  then do :
     7578       c-f-sale-sum:screen-value = string(p-sale-sum) .
     7579       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7580           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7581           display STREAM OutStream    with frame top-frame .
     7582       End.
     7583     End.
     7584     if c-f-sale-other <>  ?  then do :
     7585       c-f-sale-other:screen-value = string(p-sale-other) .
     7586       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7587           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7588           display STREAM OutStream    with frame top-frame .
     7589       End.
     7590     End.
     7591     if c-f-free-qnty <>  ?  then do :
     7592       c-f-free-qnty:screen-value = string(p-free-qnty) .
     7593       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7594           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7595           display STREAM OutStream    with frame top-frame .
     7596       End.
     7597     End.
     7598     if c-f-wait-qnty <>  ?  then do :
     7599       c-f-wait-qnty:screen-value = string(p-wait-qnty) .
     7600       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7601           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7602           display STREAM OutStream    with frame top-frame .
     7603       End.
     7604     End.
     7605     if c-f-rez-qnty <>  ?  then do :
     7606       c-f-rez-qnty:screen-value = string(p-rez-qnty) .
     7607       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7608           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7609           display STREAM OutStream    with frame top-frame .
     7610       End.
     7611     End.
     7612     if c-f-rez-cost <>  ?  then do :
     7613       c-f-rez-cost:screen-value = string(p-rez-cost) .
     7614       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7615           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7616           display STREAM OutStream    with frame top-frame .
     7617       End.
     7618     End.
     7619     if c-f-rez-sale <>  ?  then do :
     7620       c-f-rez-sale:screen-value = string(p-rez-sale) .
     7621       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7622           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7623           display STREAM OutStream    with frame top-frame .
     7624       End.
     7625     End.
     7626     if c-f-rez-cost-pr <>  ?  then do :
     7627       c-f-rez-cost-pr:screen-value = string(p-rez-cost-pr) .
     7628       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7629           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7630           display STREAM OutStream    with frame top-frame .
     7631       End.
     7632     End.
     7633               Display stream OutStream no-error.
     7634               DOWN stream OutStream .
     7635               if Make-Excel then  put   stream ForExcel unformatted
     7636               CHR(9)
     7637               string(v-bar-code,"999999999") CHR(9)
     7638                            CHR(9)
     7639                            CHR(9)
     7640                gds-prt.f-name                    CHR(9)
     7641                excel-qnty(p-qnty)                            CHR(9)
     7642                excel-sum(p-cost-pr)                        CHR(9)
     7643                excel-sum(p-cost-sum)                        CHR(9)
     7644                excel-sum(p-sale-pr)                        CHR(9)
     7645                excel-sum(p-sale-sum)                        CHR(9)
     7646                excel-sum(p-sale-other)                      CHR(9)
     7647                excel-sum(p-free-qnty)                       CHR(9)
     7648               excel-sum(p-wait-qnty)   CHR(9)
     7649               excel-sum(p-rez-qnty   ) CHR(9)
     7650               excel-sum(p-rez-cost   ) CHR(9)
     7651               excel-sum(p-rez-sale   ) CHR(9)
     7652               excel-sum(p-rez-cost-pr) CHR(9)
     7653               chr(10) .
     7654           End.
     7655           Assign
     7656             p-qnty        =  0
     7657             p-cost-sum    =  0
     7658             p-sale-sum    =  0
     7659             p-sale-other  =  0
     7660             p-free-qnty   =  0
     7661             p-wait-qnty   =  0
     7662             p-rez-qnty     = 0
     7663             p-rez-cost     = 0
     7664             p-rez-sale     = 0
     7665             p-rez-cost-pr  = 0
     7666             .
     7667       End.
     7668     End.
     7669     end.
     7670   End.
     7671   end procedure.
     7672   PROCEDURE on-same-page :
     7673     define input parameter p-line-number as integer  no-undo .
     7674     if p-line-number > page-size( OutStream ) then do:
     7675       return .
     7676     end.
     7677     if line-counter( OutStream ) + p-line-number > page-size( OutStream ) then do:
     7678       page stream OutStream .
     7679     end.
     7680   end procedure.
     7681   PROCEDURE ostatok :
     7682   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     7683   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     7684   def input parameter x-tog-shift   as   logical             no-undo.
     7685   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     7686   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     7687   def input parameter x-shift-start as integer               no-undo.
     7688   def input parameter x-shift-end   as integer               no-undo.
     7689   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     7690   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     7691   def input parameter xTog-obj   as log no-undo.
     7692   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     7693   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     7694   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     7695   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     7696   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     7697   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     7698   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     7699   def var              Fact-orderS   as char  no-undo.
     7700   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     7701      Assign
     7702         Fact-order   = 0
     7703         Quantity     = 0
     7704         Coast_R      = 0
     7705         Coast_V      = 0
     7706         VAT_R        = 0
     7707         VAT_V        = 0 .
     7708    x-date-start-t  = x-date-start + 1 .
     7709   IF x-date-end = date('') then DO:
     7710      Fact-order = 0 .
     7711      for each obj-list
     7712          where  ( not xtog-obj or
     7713                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     7714                 no-lock :
     7715         if  x-tog-shift = false then do:
     7716                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     7717                               ub.stk-tot.Fact-date <=  x-date-start
     7718                               and ub.stk-tot.shift-num = 0
     7719                               USE-INDEX fact-date no-lock no-error .
     7720              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     7721         End.
     7722         Else  DO :
     7723             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     7724              (ub.stk-tot.shift-date  = x-date-start-t and
     7725               ub.stk-tot.shift-num  < x-shift-start or
     7726               ub.stk-tot.shift-date  < x-date-start-t  )
     7727               and ub.stk-tot.shift-num  > 0
     7728               USE-INDEX Shift-num no-lock no-error .
     7729            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     7730           END.
     7731       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     7732     End.
     7733   End.
     7734   Else DO:
     7735     For each obj-list  WHERE
     7736        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     7737         no-lock :
     7738      IF  x-TOG-Shift = False Then DO:
     7739          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     7740               ub.stk-tot.Fact-date <= x-date-end
     7741               and ub.stk-tot.shift-num = 0
     7742               USE-INDEX fact-date no-lock no-error.
     7743          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     7744      END.
     7745      Else DO:
     7746           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     7747               (ub.stk-tot.shift-date  = x-date-end and
     7748               ub.stk-tot.shift-num  <= x-shift-end or
     7749               ub.stk-tot.shift-date  < x-date-end       ) and
     7750               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     7751               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     7752       End.
     7753       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     7754     End.
     7755   End.
     7756   END PROCEDURE.
     7757   procedure ost-line :
     7758     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     7759     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     7760     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     7761     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     7762     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     7763     define input  parameter x-tog-shift  as logical no-undo .
     7764     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     7765     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     7766     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     7767     define input  parameter xtog-obj     as logical no-undo .
     7768     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     7769     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     7770     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     7771     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     7772     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     7773     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     7774     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     7775     define buffer buff-obj-list  for obj-list .
     7776     define buffer buff-stk-line  for ub.stk-line .
     7777     assign
     7778       Quantity = 0
     7779       Coast_R  = 0
     7780       Coast_V  = 0
     7781       VAT_R    = 0
     7782       VAT_V    = 0
     7783       SLT_R    = 0
     7784       SLT_V    = 0
     7785     .
     7786     if  x-tog-shift = false then do:
     7787       for each buff-obj-list no-lock
     7788         where xtog-obj = false
     7789            or (buff-obj-list.obj-type = x-store-type
     7790               and buff-obj-list.obj-code = x-store-code
     7791               )
     7792       on error undo, return error
     7793       :
     7794       find last buff-stk-line no-lock
     7795         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     7796           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     7797           and buff-stk-line.artic      = x-artic
     7798           and buff-stk-line.prod-type  = x-prod-type
     7799           and buff-stk-line.prod-code  = x-prod-code
     7800           and buff-stk-line.sum-type   = x-sum-type
     7801           and buff-stk-line.cat-id     = '##,##':U
     7802           and buff-stk-line.fact-order <= x-fact-order
     7803           and buff-stk-line.shift-num  = 0
     7804         use-index category
     7805         no-error .
     7806       if available buff-stk-line then do:
     7807         assign
     7808           Quantity = Quantity + buff-stk-line.fact-qnty
     7809           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     7810           Coast_V  = Coast_V  + buff-stk-line.sum-base
     7811           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     7812           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     7813           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     7814           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     7815         .
     7816       end.
     7817      end.
     7818     end.
     7819     else do:
     7820       for each buff-obj-list no-lock
     7821         where xtog-obj = false
     7822            or (buff-obj-list.obj-type = x-store-type
     7823               and buff-obj-list.obj-code = x-store-code
     7824               )
     7825       on error undo, return error
     7826       :
     7827         find last buff-stk-line no-lock
     7828           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     7829             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     7830             and buff-stk-line.artic      = x-artic
     7831             and buff-stk-line.prod-type  = x-prod-type
     7832             and buff-stk-line.prod-code  = x-prod-code
     7833             and buff-stk-line.sum-type   = x-sum-type
     7834             and buff-stk-line.cat-id     = '##,##':U
     7835             and buff-stk-line.fact-order <= x-fact-order
     7836             and buff-stk-line.shift-num  > 0
     7837           use-index category
     7838           no-error .
     7839         if available buff-stk-line then do:
     7840           assign
     7841             Quantity = Quantity +  buff-stk-line.fact-qnty
     7842             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     7843             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     7844             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     7845             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     7846             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     7847             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     7848           .
     7849         end.
     7850       end.
     7851     end.
     7852   end procedure.
     7853   procedure ost-lineother-tax :
     7854     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     7855     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     7856     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     7857     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     7858     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     7859     define input  parameter x-tog-shift  as logical no-undo .
     7860     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     7861     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     7862     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     7863     define input  parameter xTog-obj     as logical no-undo .
     7864     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     7865     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     7866     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     7867     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     7868     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     7869     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     7870     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     7871     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     7872     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     7873     define buffer buff-obj-list  for obj-list .
     7874     define buffer buff-stk-line  for ub.stk-line .
     7875     assign
     7876       Quantity = 0
     7877       Coast_R  = 0
     7878       Coast_V  = 0
     7879       VAT_R    = 0
     7880       VAT_V    = 0
     7881       SLT_R    = 0
     7882       SLT_V    = 0
     7883       other_R  = 0
     7884       other_V  = 0
     7885     .
     7886     if  x-tog-shift = false then do:
     7887       for each buff-obj-list no-lock
     7888         where xtog-obj = false
     7889            or (buff-obj-list.obj-type = x-store-type
     7890               and buff-obj-list.obj-code = x-store-code
     7891               )
     7892       on error undo, return error
     7893       :
     7894       find last buff-stk-line no-lock
     7895         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     7896           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     7897           and buff-stk-line.artic      = x-artic
     7898           and buff-stk-line.prod-type  = x-prod-type
     7899           and buff-stk-line.prod-code  = x-prod-code
     7900           and buff-stk-line.sum-type   = x-sum-type
     7901           and buff-stk-line.cat-id     = '##,##':U
     7902           and buff-stk-line.fact-order <= x-fact-order
     7903           and buff-stk-line.shift-num  = 0
     7904         use-index category
     7905         no-error .
     7906       if available buff-stk-line then do:
     7907         assign
     7908           Quantity = Quantity + buff-stk-line.fact-qnty
     7909           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     7910           Coast_V  = Coast_V  + buff-stk-line.sum-base
     7911           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     7912           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     7913           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     7914           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     7915           other_R  = other_R  + buff-stk-line.other-rubl
     7916           other_V  = other_V  + buff-stk-line.other-base
     7917         .
     7918       end.
     7919    end.
     7920     end.
     7921     else do:
     7922       for each buff-obj-list no-lock
     7923         where xtog-obj = false
     7924            or (buff-obj-list.obj-type = x-store-type
     7925               and buff-obj-list.obj-code = x-store-code
     7926               )
     7927       on error undo, return error
     7928       :
     7929         find last buff-stk-line no-lock
     7930           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     7931             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     7932             and buff-stk-line.artic      = x-artic
     7933             and buff-stk-line.prod-type  = x-prod-type
     7934             and buff-stk-line.prod-code  = x-prod-code
     7935             and buff-stk-line.sum-type   = x-sum-type
     7936             and buff-stk-line.cat-id     = '##,##':U
     7937             and buff-stk-line.fact-order <= x-fact-order
     7938             and buff-stk-line.shift-num  > 0
     7939           use-index category
     7940           no-error .
     7941         if available buff-stk-line then do:
     7942           assign
     7943             Quantity = Quantity +  buff-stk-line.fact-qnty
     7944             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     7945             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     7946             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     7947             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     7948             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     7949             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     7950             other_R = other_R   +  buff-stk-line.other-rubl
     7951             other_V = other_V   +  buff-stk-line.other-base
     7952           .
     7953         end.
     7954       end.
     7955     end.
     7956   end procedure.
     7957   procedure ost-line-kg :
     7958     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     7959     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     7960     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     7961     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     7962     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     7963     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     7964     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     7965     define buffer buff-obj-list  for obj-list .
     7966     define buffer buf_doc-line for ub.doc-line .
     7967     define buffer buf_inv-line for ub.inv-line .
     7968     do
     7969     on error undo, return error
     7970     :
     7971       for each buf_doc-line no-lock where
     7972                buf_doc-line.obj-type    = p-obj-type   and
     7973                buf_doc-line.obj-code    = p-obj-code   and
     7974                buf_doc-line.prod-type   = p-prod-type  and
     7975                buf_doc-line.prod-code   = p-prod-code  and
     7976                buf_doc-line.artic       = p-artic      and
     7977                buf_doc-line.status_     = 'факт':U      and
     7978                buf_doc-line.fact-order <= p-fact-order
     7979             by buf_doc-line.fact-order    descending
     7980       :
     7981         find first buf_inv-line no-lock where
     7982                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     7983                    buf_inv-line.artic     = buf_doc-line.artic     and
     7984                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     7985                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     7986         if available buf_inv-line
     7987         then do:
     7988           if buf_inv-line.after-cli-qnty <> ?
     7989           then do:
     7990             assign
     7991               p-quantity-kg = buf_inv-line.after-cli-qnty
     7992             .
     7993             leave .
     7994           end.
     7995         end.
     7996       end.
     7997       if p-quantity-kg = ?
     7998       then do:
     7999         assign
     8000           p-quantity-kg = 0
     8001         .
     8002       end.
     8003     end.
     8004   end procedure.
     8005   procedure calc-price-sale-for-prt :
     8006   define output parameter v-cur-base as decimal no-undo .
     8007   define variable v-cli-base-rate like ub.bar-code.cli-base-rate no-undo .
     8008   define var parrecid-prl as recid no-undo .
     8009       define  variable price-rubl-with-tax-sale-prl    like ub.doc-line.price-rubl no-undo.
     8010       define  variable price-base-with-tax-sale-prl    like ub.doc-line.price-base no-undo.
     8011       define  variable price-rubl-without-tax-sale-prl like ub.doc-line.price-rubl no-undo.
     8012       define  variable price-base-without-tax-sale-prl like ub.doc-line.price-base no-undo.
     8013       define  variable vat-base-sale-prl               like ub.doc-line.price-base no-undo.
     8014       define  variable vat-rubl-sale-prl               like ub.doc-line.price-rubl no-undo.
     8015       define  variable vat-base-buyer-prl              like ub.doc-line.price-base no-undo.
     8016       define  variable vat-rubl-buyer-prl              like ub.doc-line.price-rubl no-undo.
     8017       define  variable slt-base-sale-prl               like ub.doc-line.price-base no-undo.
     8018       define  variable slt-rubl-sale-prl               like ub.doc-line.price-rubl no-undo.
     8019       define  variable road-tax-base-sale-prl          like ub.doc-line.road-tax   no-undo.
     8020       define  variable road-tax-rubl-sale-prl          like ub.doc-line.road-tax   no-undo.
     8021       define  variable excise-base-sale-prl            like ub.doc-line.price-base no-undo.
     8022       define  variable excise-rubl-sale-prl            like ub.doc-line.price-rubl no-undo.
     8023       define  variable discnt-base-sale-prl            like ub.gds-dtl.discnt-base no-undo.
     8024       define  variable discnt-rubl-sale-prl            like ub.gds-dtl.discnt-rubl no-undo.
     8025       define buffer out-vatp_gds-dtl-prl     for ub.gds-dtl.
     8026       define buffer buf_out-vatp_gds-dtl-prl for ub.gds-dtl.
     8027       define buffer out-vatp_parts-prl       for ub.parts.
     8028       define buffer out-vatp_sysconf-prl     for ub.sysconf.
     8029       define buffer out-vatp_doc-line-prl    for ub.doc-line.
     8030       define buffer out-vatp_goods-prl       for ub.goods.
     8031       define buffer out-vatp_trn-doc-prl     for ub.trn-doc.
     8032       define buffer out-vatp_doc-attr-prl    for ub.doc-attr.
     8033       define variable varprice-base-cons-prl      like ub.doc-line.price-base initial 0.00 no-undo.
     8034       define variable varprice-rubl-cons-prl      like ub.doc-line.price-rubl initial 0.00 no-undo.
     8035       define variable varfrm-cnsv-type-prl         as   character                           no-undo.
     8036       define variable varfrm-cnsv-prl              as   character                           no-undo.
     8037       define variable varroot-node-prl             as   integer                             no-undo.
     8038       define variable varempty-scale-prl           as   logical                             no-undo.
     8039       define variable varis-cons-parts-have-prl    as   logical                             no-undo.
     8040       define variable varsum-base-factovp-prl      like ub.gds-dtl.price-base               no-undo.
     8041       define variable varslt-base-factovp-prl      like ub.gds-dtl.price-base               no-undo.
     8042       define variable varvat-base-factovp-prl      like ub.gds-dtl.price-base               no-undo.
     8043       define variable varvatcons-base-factovp-prl  like ub.gds-dtl.price-base               no-undo.
     8044       define variable vardsc-base-factovp-prl      like ub.gds-dtl.price-base               no-undo.
     8045       define variable varsum-base-docovp-prl       like ub.gds-dtl.price-base               no-undo.
     8046       define variable varslt-base-docovp-prl       like ub.gds-dtl.price-base               no-undo.
