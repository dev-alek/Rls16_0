     5538                         if last-of(ub.gds-season.gds-code) then DO:
     5539                                           IF v-var = "no-today" then DO:
     5540                                                         RUN ost-line in this-procedure
     5541                                                         (input   ub.gds-obj.obj-code  ,
     5542                                                           input   ub.gds-obj.obj-type  ,
     5543                                                           INPUT   ub.gds-obj.artic     ,
