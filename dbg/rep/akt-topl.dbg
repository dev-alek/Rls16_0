        1   using ibs.th.str.*.
        2   block-level on error undo, throw.
        3   define input parameter p-mainmenu-handle as widget-handle no-undo.
        4   define input parameter rec_id            as recid         no-undo.
        5   define input parameter parprint-water    as logical       no-undo.
        6   define variable vss-revision    as character no-undo initial "$Revision: 31d98d0f4d05, 3249, rls $":U .
        7   define variable vss-author      as character no-undo initial "$Author: SSlivenko $":U .
        8   define variable vss-date        as character no-undo initial "$Date: 2023/03/29 08:47:58 $":U .
        9   define variable vss-workfile    as character no-undo initial "$Workfile: akt-topl.p $":U .
       10   define variable vss-archive     as character no-undo initial "$Archive: rep/akt-topl.p $":U .
       11   define variable vss-description as character no-undo initial "Акт несоответствия по топливной накладной":U .
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define new global shared variable g#lib-trn  as handle no-undo .
       73   define new global shared variable g#lib-trn2 as handle no-undo .
       74   define new global shared variable g#lib-trn3 as handle no-undo .
       75   define new global shared variable g#lib-trn4 as handle no-undo .
       76   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       77   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       78   define  shared variable RepPathName        as character no-undo .
       79   define  shared variable PrintRubl          as logical   no-undo .
       80   define variable vss-include-info1 as character format "X(65)" no-undo
       81   initial "@(#)$Workfile$ $Revision$".
       82   define temp-table temp_p-fmt_string-part no-undo
       83       field str-key       as integer
       84       field string-part   as character
       85       index pi is primary unique
       86           str-key
       87   .
       88   define variable v-p-fmt-1-str-key    as integer      no-undo.
       89   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
       90                                     iInput AS INTEGER).
       91     def var v-start-print as integer no-undo .
       92     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
       93     assign
       94       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
       95     .
       96     RETURN v-start-print .
       97   END FUNCTION.
       98   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
       99                                     iInput AS INTEGER).
      100     def var v-start-print as integer no-undo .
      101     assign
      102       v-start-print = INTEGER(iEndPix - 1 - iInput)
      103     .
      104     if v-start-print < 0 then return 0.
      105     RETURN v-start-print .
      106   END FUNCTION.
      107   function p-fmt-align-string returns character (
      108         p-in-string      as character
      109       , p-page-width     as integer
      110       , p-align-type     as character
      111   ).
      112       define variable v-string-length     as integer      no-undo.
      113       define variable v-out-string        as character    no-undo.
      114       assign
      115           v-string-length = length( trim( p-in-string ) )
      116       .
      117       if v-string-length >= p-page-width
      118       then do:
      119           assign
      120               v-out-string = trim( p-in-string )
      121           .
      122       end.
      123       else do:
      124           case p-align-type
      125           :
      126               when 'left':U
      127               then do:
      128                   assign
      129                       v-out-string = trim( p-in-string )
      130                   .
      131               end.
      132               when 'right':U
      133               then do:
      134                   assign
      135                       v-out-string = fill( " ":U, p-page-width - v-string-length ) + trim( p-in-string )
      136                   .
      137               end.
      138               when 'center':U
      139               then do:
      140                   assign
      141                       v-out-string = fill( " ":U, integer( ( p-page-width - v-string-length ) / 2 ) ) + trim( p-in-string )
      142                   .
      143               end.
      144           end case.
      145       end.
      146       return v-out-string .
      147   end function.
      148   procedure p-fmt-split-string :
      149   define input parameter p-source-string  as character        no-undo.
      150   define input parameter p-split-length   as integer          no-undo.
      151   define output parameter p-string-1      as character        no-undo.
      152   define output parameter p-string-2      as character        no-undo.
      153   do
      154   on error undo, return error
      155   :
      156       define variable v-space-pos    as integer      no-undo.
      157       if length( p-source-string ) <= p-split-length
      158       then do:
      159           assign
      160               p-string-1 = p-source-string
      161           .
      162       end.
      163       else do:
      164           assign
      165               v-space-pos = r-index( p-source-string, " ":U, p-split-length )
      166           .
      167           if v-space-pos = 0
      168           then do:
      169               assign
      170                   v-space-pos = index( p-source-string, " ":U )
      171               .
      172           end.
      173           if v-space-pos = 0
      174           then do:
      175               assign
      176                   p-string-1 = substring( p-source-string, 1, p-split-length )
      177                   p-string-2 = trim( substring( p-source-string, p-split-length, p-split-length ) )
      178               .
      179           end.
      180           else do:
      181               assign
      182                   p-string-1 = substring( p-source-string, 1, v-space-pos )
      183                   p-string-2 = trim( substring( p-source-string, v-space-pos ) )
      184               .
      185           end.
      186       end.
      187   end.
      188   end procedure.
      189   procedure p-fmt-round :
      190   define input parameter p-qnty               as decimal          no-undo.
      191   define input parameter p-price-no-VAT       as decimal          no-undo.
      192   define input parameter p-VAT                as decimal          no-undo.
      193   define input parameter p-SLT                as decimal          no-undo.
      194   define input parameter p-road-tax           as decimal          no-undo.
      195   define output parameter p-new-price-no-VAT  as decimal          no-undo.
      196   define output parameter p-new-VAT           as decimal          no-undo.
      197   define output parameter p-new-SLT           as decimal          no-undo.
      198   define output parameter p-new-sum-VAT       as decimal          no-undo.
      199   define output parameter p-new-sum-SLT       as decimal          no-undo.
      200   define output parameter p-new-sum-road-tax  as decimal          no-undo.
      201   define output parameter p-new-sum-no-VAT    as decimal          no-undo.
      202   define output parameter p-new-sum-full      as decimal          no-undo.
      203       define variable v-vat-pc    as decimal      no-undo.
      204       define variable v-slt-pc    as decimal      no-undo.
      205   do
      206   on error undo, return error
      207   :
      208       if p-price-no-VAT = 0
      209       then do:
      210           assign
      211               p-new-price-no-VAT = 0.0
      212               p-new-VAT          = ?
      213               p-new-SLT          = ?
      214               p-new-sum-VAT      = 0.0
      215               p-new-sum-SLT      = 0.0
      216               p-new-sum-no-VAT   = 0.0
      217               p-new-sum-road-tax = 0.0
      218               p-new-sum-full     = 0.0
      219           .
      220       end.
      221       else do:
      222           assign
      223               v-vat-pc            = p-VAT / p-price-no-VAT
      224               v-slt-pc            = p-SLT / ( p-price-no-VAT + p-VAT )
      225               p-new-price-no-VAT  = round( p-price-no-VAT, 2 )
      226               p-new-VAT           = round( p-new-price-no-VAT * v-vat-pc, 2 )
      227               p-new-SLT           = round( ( p-new-price-no-VAT + p-new-VAT ) * v-slt-pc, 2 )
      228               p-new-sum-VAT       = round( p-new-VAT          * p-qnty, 2 )
      229               p-new-sum-SLT       = round( ( p-new-price-no-VAT + p-new-VAT ) * p-qnty * v-slt-pc, 2 )
      230               p-new-sum-no-VAT    = round( p-new-price-no-VAT * p-qnty, 2 )
      231               p-new-sum-road-tax  = round( p-road-tax * p-qnty, 2 )
      232               p-new-sum-full      = round( ( p-new-price-no-VAT + p-new-VAT + p-new-SLT + p-road-tax ) * p-qnty, 2 )
      233           .
      234       end.
      235   end.
      236   end procedure.
      237   procedure p-fmt-split :
      238   define input parameter p-in-string      as character        no-undo.
      239   define input parameter p-split-length   as integer          no-undo.
      240       define variable v-start-pos     as integer      no-undo.
      241       define variable v-end-pos       as integer      no-undo.
      242       define buffer buf_temp_p-fmt_string-part        for temp_p-fmt_string-part.
      243   do
      244   for buf_temp_p-fmt_string-part
      245   on error undo, return error
      246   :
      247       empty temp-table buf_temp_p-fmt_string-part.
      248       if p-split-length < 1
      249       then do:
      250           undo, return error substitute( "p-fmt-split: Строка не может быть разбита на &1 частей", p-split-length ).
      251       end.
      252       assign
      253           p-in-string                 = trim( p-in-string )
      254           v-p-fmt-1-str-key   = 0
      255           v-start-pos                 = 1
      256           v-end-pos                   = length( p-in-string )
      257       .
      258       run p-fmt-get-string-range in this-procedure (
      259             input p-in-string
      260           , input p-split-length
      261           , input v-start-pos
      262           , output v-start-pos
      263           , output v-end-pos
      264       ).
      265       do while v-end-pos <> 0
      266       :
      267           create buf_temp_p-fmt_string-part.
      268           assign
      269               v-p-fmt-1-str-key = v-p-fmt-1-str-key + 1
      270           .
      271           assign
      272               buf_temp_p-fmt_string-part.str-key      = v-p-fmt-1-str-key
      273               buf_temp_p-fmt_string-part.string-part  = substring( p-in-string, v-start-pos, v-end-pos - v-start-pos )
      274           .
      275           assign
      276               v-start-pos = v-end-pos + 1
      277           .
      278           run p-fmt-get-string-range in this-procedure (
      279                 input p-in-string
      280               , input p-split-length
      281               , input v-start-pos
      282               , output v-start-pos
      283               , output v-end-pos
      284           ).
      285       end.
      286   end.
      287   end procedure.
      288   procedure p-fmt-get-string-range :
      289   define input parameter p-in-string      as character        no-undo.
      290   define input parameter p-split-length   as integer          no-undo.
      291   define input parameter p-old-start-pos  as integer          no-undo.
      292   define output parameter p-start-pos     as integer          no-undo.
      293   define output parameter p-end-pos       as integer          no-undo.
      294       define variable v-init-string    as character    no-undo.
      295       define variable v-temp-char      as character    no-undo.
      296       define variable v-temp-pos       as integer      no-undo.
      297       define variable v-counter        as integer      no-undo.
      298   do
      299   on error undo, return error
      300   :
      301       assign
      302           p-start-pos   = p-old-start-pos
      303           v-init-string = substring( p-in-string, p-start-pos )
      304       no-error.
      305       if error-status :error
      306       or trim( v-init-string ) = "":U
      307       then do:
      308           assign
      309               p-end-pos = 0
      310           .
      311           undo, return .
      312       end.
      313       assign
      314           v-temp-char   = substring( v-init-string, 1, 1 )
      315       .
      316       do
      317       while trim( v-temp-char ) = "":U
      318       :
      319           assign
      320               p-start-pos     = p-start-pos + 1
      321               v-init-string   = substring( p-in-string, p-start-pos )
      322               v-temp-char     = substring( v-init-string, 1, 1 )
      323           .
      324       end.
      325       assign
      326           v-temp-pos  = p-split-length
      327           v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      328           v-counter   = 0
      329       .
      330       search-word-end:
      331       do
      332       while trim( v-temp-char ) <> "":U
      333       :
      334           assign
      335               v-counter   = v-counter + 1
      336           .
      337           if v-counter > 20
      338           then do:
      339               assign
      340                   v-temp-pos  = p-split-length
      341               .
      342               leave search-word-end.
      343           end.
      344           assign
      345               v-temp-pos  = v-temp-pos - 1
      346               v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      347           .
      348       end.
      349       assign
      350           p-end-pos = p-start-pos + v-temp-pos - 1
      351       .
      352   end.
      353   end procedure.
