      696           where buf_rvs-doc_before.out-code = buf_trn-doc.doc-code
      697             and buf_rvs-doc_before.rvs-type = 'перед_док':U
      698       no-error.
      699       assign
      700           v-have-rvs-before = ( available buf_rvs-doc_before )
      701       .
      702       if before_real-time = ? then do:
      703         if v-have-rvs-before = yes
      704         then do:
      705             for each buf_rvs-line_before no-lock
      706               where buf_rvs-line_before.rvs-code = buf_rvs-doc_before.rvs-code
      707                 and buf_rvs-line_before.obj-type = buf_trn-doc.obj-type
      708                 and buf_rvs-line_before.obj-code = buf_trn-doc.obj-code
      709                 and buf_rvs-line_before.gds-code = buf_goods.gds-code
      710             :
      711                 if before_real-time = ? or
