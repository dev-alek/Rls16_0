      670         vss-workfile + ". Ошибка преобразования параметра " + "tank-water" + " в число"
      671         view-as alert-box error
      672       .
      673     .
      674       v-car-vol = string (v-InfoSectionsTotal:CarVolTotal).
      675       v-tank-vol-dec = v-InfoSectionsTotal:TankVolTotal.
      676       v-tank-density-dec = v-InfoSectionsTotal:TankWeightTotal / v-InfoSectionsTotal:TankVolTotal.
      677       v-tank-weight-dec = v-InfoSectionsTotal:TankWeightTotal.
      678       v-tank-water-dec = v-InfoSectionsTotal:TankWaterVolTotal.
      679       v-time-start =  string ( v-InfoSectionsTotal:StartRealTime ).
      680       v-time-end =  string ( v-InfoSectionsTotal:EndRealTime ).
      681       find first buf_clients_ship no-lock
      682           where buf_clients_ship.obj-type = v-autoent-obj-type
      683             and buf_clients_ship.obj-code = integer(v-autoent-obj-code)
      684       no-error.
      685       if available buf_clients_ship
      686       then assign
      687           v-ship-org = buf_clients_ship.obj-name
      688       .
      689       else assign
      690           v-ship-org = ""
      691       .
      692         assign
      693           before_real-time = ( if v-time-start <> "":U then integer( v-time-start ) else ? )
      694         .
