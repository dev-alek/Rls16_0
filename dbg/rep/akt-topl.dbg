     1464               ":"         format "X(1)"           at 16 + 40
     1465               ":"         format "X(1)"           at 16 + 50
     1466               ":"         format "X(1)"           at 16 + 74
     1467               ":"         format "X(1)"           at 16 + 94
     1468             skip
     1469               ":"         format "X(1)"           at 16
     1470               "ДО слива"  format "X(8)"           at 16 + 2
     1471               ":"         format "X(1)"           at 16 + 25
     1472           .
     1473       if v-have-rvs-before = yes
     1474       then do:
     1475           if buf_rvs-line_before.state-measure-qnty <> ?
     1476               then put stream out-stream
     1477                   buf_rvs-line_before.state-measure-qnty
     1478                                               format "zz,zz9.999"    at right-field( 16 + 40 - 2, 10)
     1479               .
     1480       end.
     1481       else do:
     1482           put stream out-stream
     1483             "0"
     1484                                         format "X(1)"    at right-field( 16 + 40 - 2, 1)
     1485           .
     1486       end.
     1487       put stream out-stream
     1488           ":"         format "X(1)"           at 16 + 40
     1489       .
     1490       if v-have-rvs-before = yes
     1491       then do:
     1492           if buf_rvs-line_before.state-temperature <> ?
     1493               then put stream out-stream
     1494                   buf_rvs-line_before.state-temperature
     1495                                               format "->>9.99"    at right-field( 16 + 50 - 1, 7)
     1496               .
     1497       end.
     1498       else do:
     1499           put stream out-stream
     1500             "0"
     1501                                         format "X(1)"    at right-field( 16 + 50 - 1, 1)
     1502           .
     1503       end.
     1504       put stream out-stream
     1505           ":"         format "X(1)"           at 16 + 50
     1506       .
     1507       if v-have-rvs-before = yes
     1508       then do:
     1509           if buf_rvs-line_before.state-density <> ?
     1510               then put stream out-stream
     1511                   buf_rvs-line_before.state-density
     1512                                               format "9.9999999999"    at right-field( 16 + 74 - 2, 12)
     1513               .
     1514       end.
     1515       else do:
     1516           put stream out-stream
     1517             "0"
     1518                                         format "X(1)"    at right-field( 16 + 74 - 2, 1)
     1519           .
     1520       end.
     1521       put stream out-stream
     1522           ":"         format "X(1)"           at 16 + 74
     1523       .
     1524       if v-have-rvs-before = yes
     1525       then do:
     1526           if buf_rvs-line_before.state-measure-cli-qnty <> ?
     1527               then put stream out-stream
     1528                   buf_rvs-line_before.state-measure-cli-qnty
     1529                                               format "zzz,zzz,zz9.999"    at right-field( 16 + 94 - 2, 15)
     1530               .
     1531       end.
     1532       else do:
     1533           put stream out-stream
     1534             "0"
     1535                                         format "X(1)"    at right-field( 16 + 94 - 2, 1)
     1536           .
     1537       end.
     1538       put stream out-stream
     1539           ":"         format "X(1)"           at 16 + 94
     1540       .
     1541           end.
     1542           assign
     1543             before_temperature = before_temperature / before_qnty
     1544             before_density     = before_cli-qnty    / before_qnty
     1545           .
     1546       end.
     1547       if doc-line_1st-run = yes
     1548       then do:
     1549         assign
     1550           v-delta-mass = buf_doc-line.doc-qnty * buf_doc-line.doc-density
     1551         .
     1552         if lookup( varstfactpl, "auto-tank,inv" ) > 0 then do:
     1553           assign
     1554             v-delta-mass = v-delta-mass - v-tank-weight-dec.
     1555             doc-line_1st-run = no
     1556           .
     1557         end.
     1558       end.
     1559       if v-have-rvs-after = yes
     1560       then do:
     1561           for each buf_rvs-line_after no-lock
     1562              where buf_rvs-line_after.rvs-code = buf_rvs-doc_after.rvs-code
     1563                and buf_rvs-line_after.obj-type = buf_trn-doc.obj-type
     1564                and buf_rvs-line_after.obj-code = buf_trn-doc.obj-code
     1565                and buf_rvs-line_after.gds-code = buf_goods.gds-code
     1566           :
     1567           assign
     1568             after_qnty        = after_qnty        + buf_rvs-line_after.state-measure-qnty
     1569             after_temperature = after_temperature + buf_rvs-line_after.state-temperature
     1570                                               * buf_rvs-line_after.state-measure-qnty
     1571             after_cli-qnty    = after_cli-qnty    + buf_rvs-line_after.state-measure-cli-qnty
     1572           .
     1573           if lookup( varstfactpl, "auto-tank,inv" ) = 0 then do:
     1574               assign
     1575                 v-delta-mass = v-delta-mass
     1576                   -
     1577                   buf_rvs-line_after.state-measure-cli-qnty
     1578                 doc-line_1st-run = no
     1579               .
     1580           end.
     1581           put stream out-stream
     1582             skip
     1583               ":"         format "X(1)"           at 16
     1584               single-line format "X(93)"
     1585               ":"         format "X(1)"
     1586             skip
     1587               ":"         format "X(1)"           at 16
     1588               "По замеру в резервуаре"    format "X(22)"           at 16 + 2
     1589               ":"         format "X(1)"           at 16 + 25
     1590               ":"         format "X(1)"           at 16 + 40
     1591               ":"         format "X(1)"           at 16 + 50
     1592               ":"         format "X(1)"           at 16 + 74
     1593               ":"         format "X(1)"           at 16 + 94
     1594             skip
     1595               ":"         format "X(1)"           at 16
     1596               "ПОСЛЕ слива"  format "X(11)"       at 16 + 2
     1597               ":"         format "X(1)"           at 16 + 25
     1598           .
     1599       if v-have-rvs-after = yes
     1600       then do:
     1601           if buf_rvs-line_after.state-measure-qnty <> ?
     1602               then put stream out-stream
     1603                   buf_rvs-line_after.state-measure-qnty
     1604                                               format "zz,zz9.999"    at right-field( 16 + 40 - 2, 10)
     1605               .
     1606       end.
     1607       else do:
     1608           put stream out-stream
     1609             "0"
     1610                                         format "X(1)"    at right-field( 16 + 40 - 2, 1)
     1611           .
     1612       end.
     1613       put stream out-stream
     1614           ":"         format "X(1)"           at 16 + 40
     1615       .
     1616       if v-have-rvs-after = yes
     1617       then do:
     1618           if buf_rvs-line_after.state-temperature <> ?
     1619               then put stream out-stream
     1620                   buf_rvs-line_after.state-temperature
     1621                                               format "->>9.99"    at right-field( 16 + 50 - 1, 7)
     1622               .
     1623       end.
     1624       else do:
     1625           put stream out-stream
     1626             "0"
     1627                                         format "X(1)"    at right-field( 16 + 50 - 1, 1)
     1628           .
     1629       end.
     1630       put stream out-stream
     1631           ":"         format "X(1)"           at 16 + 50
     1632       .
     1633       if v-have-rvs-after = yes
     1634       then do:
     1635           if buf_rvs-line_after.state-density <> ?
     1636               then put stream out-stream
     1637                   buf_rvs-line_after.state-density
     1638                                               format "9.9999999999"    at right-field( 16 + 74 - 2, 12)
     1639               .
     1640       end.
     1641       else do:
     1642           put stream out-stream
     1643             "0"
     1644                                         format "X(1)"    at right-field( 16 + 74 - 2, 1)
     1645           .
     1646       end.
     1647       put stream out-stream
     1648           ":"         format "X(1)"           at 16 + 74
     1649       .
     1650       if v-have-rvs-after = yes
     1651       then do:
     1652           if buf_rvs-line_after.state-measure-cli-qnty <> ?
     1653               then put stream out-stream
     1654                   buf_rvs-line_after.state-measure-cli-qnty
     1655                                               format "zzz,zzz,zz9.999"    at right-field( 16 + 94 - 2, 15)
     1656               .
     1657       end.
     1658       else do:
     1659           put stream out-stream
     1660             "0"
     1661                                         format "X(1)"    at right-field( 16 + 94 - 2, 1)
     1662           .
     1663       end.
     1664       put stream out-stream
     1665           ":"         format "X(1)"           at 16 + 94
     1666       .
     1667           end.
     1668           assign
     1669             after_temperature = after_temperature / after_qnty
     1670             after_density     = after_cli-qnty    / after_qnty
     1671           .
     1672       end.
     1673           put stream out-stream
     1674             skip
     1675               single-line        format "X(95)"        at 16
     1676           .
     1677         end.
     1678       put stream out-stream
     1679         skip (2)
     1680         space (15) "Погрешность измерений "
     1681       .
     1682       assign v-mass-pogresh = v-InfoSectionsTotal:TankWeightTotal * pogresh.
     1683       if v-mass-pogresh = ? then assign v-mass-pogresh = 0 .
     1684       put stream out-stream
     1685         v-mass-pogresh        format "zzz,zzz,zz9.999"  at right-field( 90, 15)   " кг"
     1686         skip space (15) "Отличие составило "
     1687       .
     1688       if v-delta-mass = ? then assign v-delta-mass = 0 .
     1689       if v-delta-mass > 0 then do:
     1690         assign
     1691           v-nedost    = yes
     1692           v-delta-res = v-delta-mass - v-mass-pogresh  .
     1693       end.
     1694       else do:
     1695         assign
     1696           v-nedost    = no
     1697           v-delta-res = - v-delta-mass - v-mass-pogresh .
     1698       end.
     1699       if v-delta-res  = ? then assign v-delta-res = 0 .
     1700       if v-delta-mass < 0 then assign v-delta-mass = - v-delta-mass .
     1701       put stream out-stream
     1702         v-delta-mass          format "zzz,zzz,zz9.999"  at right-field( 90, 15)
     1703         " кг"
     1704       .
     1705       if v-delta-mass > v-mass-pogresh then do:
     1706           put stream out-stream
     1707             skip space (15) "Количество, превышающее погрешность "  v-delta-res  format "zzz,zzz,zz9.999"  at right-field( 90, 15)   " кг"
     1708           .
     1709       end.
     1710       put stream out-stream
     1711         skip (2)
     1712         space (15) "Оператор АЗС "
     1713         v-operator   format "X(35)"   at (15 + 25)
     1714         " ________________ (подпись)"
     1715         skip(1)
     1716         space (15) "Менеджер АЗС "
     1717         "________________"   format "X(35)"   at (15 + 25)
     1718         " ________________ (подпись)"
     1719         skip(1)
     1720         space (15) "Водитель автоцистерны _____________________________________ ________________ (фамилия, подпись)"
     1721       .
     1722       run print-footer in this-procedure (
     1723           input buf_trn-doc.host-code
     1724       ).
     1725       page stream out-stream.
     1726       delete object v-InfoSectionsTotal.
     1727   end.
     1728   output stream out-stream close.
     1729   if session :set-wait-state( "" ) then.
     1730   if v-have-petrol = yes
     1731   then do:
     1732   if g#quest-print = false
     1733   then do:
     1734     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     1735                                         7, (if 4 >= 8 then 2 else 0), 0, 0,
     1736                                         OUTPUT g#log ).
     1737   end.
     1738   else do:
     1739     os-command silent
     1740       value( "COPY /b " +
     1741         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     1742         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     1743         string( session:temp-directory) +  "$" + string( g#report-num )
     1744                 ) .
     1745     os-command silent
     1746       value( "COPY /b " +
     1747         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     1748         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     1749         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     1750                 ) .
     1751   end.
     1752   end.
     1753   end.
     1754   procedure print-footer :
     1755   do
     1756   on error undo, return error
     1757   :
     1758   define input parameter p-host-code  as integer      no-undo.
     1759       define variable v-main-boss     as character     no-undo.
     1760       define variable v-main-buh      as character     no-undo.
     1761       define buffer buf_clients       for ub.clients .
     1762       define buffer buf_firm          for ub.firm .
     1763       define buffer buf_sysconf       for ub.sysconf .
     1764       find first buf_clients no-lock
     1765           where buf_clients.obj-type = 'орг':U
     1766           and buf_clients.obj-code = p-host-code
     1767       .
     1768       find first buf_firm no-lock
     1769           where buf_firm.firm-code = buf_clients.obj-code
     1770       .
     1771       assign
     1772           v-main-boss = buf_firm.director
     1773           v-main-buh  = buf_firm.gen-acct
     1774       .
     1775       find first buf_sysconf no-lock
     1776           where buf_sysconf.host-code = p-host-code
     1777       .
     1778       assign
     1779           v-main-buh  = buf_sysconf.snr-accnt
     1780       .
     1781       put stream Out-stream
     1782         skip (1)
     1783         space (15) "Руководитель предприятия "
     1784         v-main-boss   format "X(25)"   at (15 + 35)
     1785         " ________________ (подпись)"
     1786         skip (1)
     1787         space (15) "Гл. бухгалтер            "
     1788         v-main-buh   format "X(25)"   at (15 + 35)
     1789         " ________________ (подпись)"
     1790       .
     1791   end.
     1792   end procedure.
