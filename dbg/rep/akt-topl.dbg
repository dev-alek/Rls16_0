      437   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      438     (input  'stfactpl'
      439     ,input  ''
      440     ,input  ''
      441     ,input  0
      442     ,input  ''
      443     ,input  ''
      444     ,input  ''
      445     ,input  no
      446     ,output varstfactpl
      447     ,output varstfactpltype
      448     ) no-error .
      449   assign
      450     varstfactpl = replace( varstfactpl,  "read-only;", "":U )
      451     varstfactpl = replace( varstfactpl, ";read-only",  "":U )
      452     varstfactpl = replace( varstfactpl,  "read-only",  "":U )
      453     varstfactpl = replace( varstfactpl,  "inv-set;", "":U )
      454     varstfactpl = replace( varstfactpl, ";inv-set",  "":U )
      455     varstfactpl = replace( varstfactpl,  "inv-set",  "":U )
      456   .
      457   if num-entries( varstfactpl, ";" ) > 1
      458   then do:
      459     assign
      460       varstfactpl = entry( 1, varstfactpl, ";" )
      461     .
      462   end.
      463   assign
      464     varstfactpl = replace( varstfactpl, ";",           "":U )
      465   .
      466   assign
      467     pogresh     = ( if num-entries( varstfactpl, '=' ) = 2 then decimal( entry( 2, varstfactpl, '=' ) ) * 0.01 else 0 )
      468     varstfactpl = entry( 1, varstfactpl, "=" )
      469   .
      470   if session :set-wait-state( "compiler" ) then.
      471   output stream out-stream to value( string( session:temp-directory +
      472                                        "rpt" + string( g#report-num ) ) )
      473                                        page-size  value(62) .
      474   find first buf_trn-doc no-lock
      475        where recid( buf_trn-doc ) = rec_id
      476   .
