      478       where buf_clients.obj-type = 'чел':U
      479         and buf_clients.obj-code = buf_trn-doc.wrkr
      480   no-error.
      481   if available buf_clients
      482   then do:
      483       assign
      484           v-operator = buf_clients.obj-name
      485       .
      486   end.
      487   else do:
      488       assign
      489           v-operator = ""
      490       .
      491   end.
      492   find first buf_clients no-lock
      493       where buf_clients.obj-type = buf_trn-doc.obj-type
      494         and buf_clients.obj-code = buf_trn-doc.obj-code
      495   .
      496   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
      497                           input 'dids':U ,
      498                          output v-dids ,
      499                          output v-attr-type )  .
      500   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
      501                           input 'nids':U ,
      502                          output v-nids ,
      503                          output v-attr-type )  .
      504   print-doc-line:
      505   for each buf_doc-line no-lock
      506        where buf_doc-line.doc-code = buf_trn-doc.doc-code
      507   :
      508       assign
      509         doc-line_1st-run = yes
      510       .
      511       assign
      512           v-autoent-obj-code = ""
      513           v-autoent-obj-type = ""
      514           v-car-num          = ""
      515           v-car-vol          = ""
      516           v-item-pour        = ""
      517           v-tank-density     = ""
      518           v-tank-temp        = ""
      519           v-tank-vol         = ""
      520           v-tank-water       = ""
      521           v-tank-weight      = ""
      522           v-time-pour        = ""
      523           v-time-income      = ""
      524           v-time-start       = ""
      525           v-time-end         = ""
      526           v-type-inp-vat     = ""
      527           v-fio              = ""
      528       .
      529       find first buf_goods no-lock
      530           where buf_goods.artic      = buf_doc-line.artic
      531             and buf_goods.prod-type  = buf_doc-line.prod-type
      532             and buf_goods.prod-code  = buf_doc-line.prod-code
      533       .
      534   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
      535     (
      536        input buf_goods.artic
      537     ,  input buf_goods.prod-type
      538     ,  input buf_goods.prod-code
      539     , output v-is-petrol
      540     , output v-is-pieces
      541     ) .
      542       if v-is-petrol <> yes
      543       then do:
      544           next print-doc-line.
      545       end.
      546       assign
      547           v-have-petrol = yes
      548       .
      549       v-InfoSectionsTotal = new InfoSectionsTotal().
      550       v-InfoSectionsTotal:Initialization(buf_trn-doc.doc-code, buf_goods.gds-code).
      551       v-InfoSectionsTotal:GetDBAllAttr().
      552       for each buf_doc-line-attr no-lock
      553          where buf_doc-line-attr.doc-code = buf_trn-doc.doc-code
      554            and buf_doc-line-attr.gds-code = buf_goods.gds-code
      555       :
      556           case buf_doc-line-attr.attr-code:
      557             when "car-vol"
      558             then do:
      559               assign
      560                  v-car-vol = trim(buf_doc-line-attr.attr-value)
      561               .
      562             end.
      563             when "tank-density"
      564             then do:
      565               assign
      566                  v-tank-density = trim(buf_doc-line-attr.attr-value)
      567               .
      568             end.
      569             when "tank-temp"
      570             then do:
      571               assign
      572                  v-tank-temp = trim(buf_doc-line-attr.attr-value)
      573               .
      574             end.
      575             when "tank-vol"
      576             then do:
      577               assign
      578                  v-tank-vol = trim(buf_doc-line-attr.attr-value)
      579               .
      580             end.
      581             when "tank-water"
      582             then do:
      583               assign
      584                  v-tank-water = trim(buf_doc-line-attr.attr-value)
      585               .
      586             end.
      587             when "tank-weight"
      588             then do:
      589               assign
      590                  v-tank-weight = trim(buf_doc-line-attr.attr-value)
      591               .
      592             end.
      593             when "time-start"
      594             then do:
      595               assign
      596                  v-time-start = trim(buf_doc-line-attr.attr-value)
      597               .
      598             end.
      599             when "time-end"
      600             then do:
      601               assign
      602                  v-time-end = trim(buf_doc-line-attr.attr-value)
      603               .
      604             end.
      605             when "time-pour"
      606             then do:
      607               assign
      608                  v-time-pour = trim(buf_doc-line-attr.attr-value)
      609               .
      610             end.
      611             when "type-inp-vat"
      612             then do:
      613               assign
      614                  v-type-inp-vat = trim(buf_doc-line-attr.attr-value)
      615               .
      616             end.
      617           end case.
      618       end.
      619       for each buf_doc-attr no-lock where
      620                buf_doc-attr.doc-code = buf_trn-doc.doc-code:
      621         case buf_doc-attr.attr-code :
      622       when 'autoent':U then do:
      623         assign
      624           v-autoent-obj-type = entry (1, buf_doc-attr.attr-value, ";")
      625           v-autoent-obj-code = entry (2, buf_doc-attr.attr-value, ";")
      626         no-error.
      627       end.
      628       when 'car-num':U then do: assign v-car-num = trim( buf_doc-attr.attr-value ). end.
      629       when 'time-income':U then do: assign v-time-income = trim( buf_doc-attr.attr-value ). end.
      630       when 'ptb-item-pour':U then do: assign v-item-pour = trim( buf_doc-attr.attr-value ). end.
      631       when 'fio-driver':U then do: assign v-fio = trim( buf_doc-attr.attr-value ). end.
      632         end case.
      633       end.
      634     assign
      635       v-tank-vol-dec = decimal(v-tank-vol) no-error.
      636       if error-status :error
      637       then message
      638         vss-workfile + ". Ошибка преобразования параметра " + "tank-vol" + " в число"
      639         view-as alert-box error
      640       .
      641     .
      642     assign
