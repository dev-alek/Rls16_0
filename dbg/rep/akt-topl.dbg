      919             ":"         format "X(1)"           at 16 + 74
      920             buf_doc-line.doc-qnty * buf_doc-line.doc-density
      921                                            format "zzz,zzz,zz9.999"  at right-field( 16 + 94 - 2, 15)
      922             ":"         format "X(1)"           at 16 + 94
