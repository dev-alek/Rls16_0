      671     ,output vv-exch-scale
      672     ,output base-type
      673     )  .
      674   end.
      675   run get-report-num in my-handle ( output g#report-num ).
      676   run get-gds-engl in my-handle ( output g#gds-engl ) .
      677   CREATE WIDGET-POOL.
      678   define variable v-nn as integer   no-undo .
      679   define variable State-source as  WIDGET-HANDLE.
      680   define variable g#log as logical   no-undo .
      681   define buffer cli-post for clients .
      682   define new shared temp-table g#post no-undo
      683       field obj-type like ub.clients.obj-type
      684       field obj-code like ub.clients.obj-code
      685       field obj-name like ub.clients.obj-name
      686       INDEX pi IS UNIQUE PRIMARY obj-type obj-code.
      687   define variable  post-grp_recids as character no-undo .
      688   define variable ii as integer no-undo .
      689   DEFINE VARIABLE PostName AS CHARACTER
      690        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      691        SIZE 31 BY 2.17 TOOLTIP "Список выбранных Поставщиков" NO-UNDO.
      692   DEFINE VARIABLE date1Rash AS DATE FORMAT "99/99/9999":U
      693        LABEL "c"
      694        VIEW-AS FILL-IN
      695        SIZE 11.88 BY 1 NO-UNDO.
      696   DEFINE VARIABLE date2Rash AS DATE FORMAT "99/99/9999":U
      697        LABEL "по"
      698        VIEW-AS FILL-IN
      699        SIZE 11.88 BY 1 NO-UNDO.
      700   DEFINE VARIABLE Str AS CHARACTER FORMAT "X(256)":U INITIAL "Период для РН"
      701         VIEW-AS TEXT
      702        SIZE 14 BY .67
      703        FGCOLOR 4  NO-UNDO.
      704   DEFINE VARIABLE var-lavel AS INTEGER FORMAT ">>9":U INITIAL 1
      705        VIEW-AS FILL-IN NATIVE
      706        SIZE 5 BY .79 NO-UNDO.
      707   DEFINE VARIABLE var-lavel-2 AS INTEGER FORMAT ">>9":U INITIAL 1
      708        VIEW-AS FILL-IN NATIVE
      709        SIZE 5 BY .79 NO-UNDO.
      710   DEFINE VARIABLE Classify AS CHARACTER
      711        VIEW-AS RADIO-SET VERTICAL
      712        RADIO-BUTTONS
      713             "Без классификации", "no-classify":U,
      714   "Группы поставщиков", "post":U,
      715   "Группы товаров", "grp-goods":U,
      716   "Группы поставщиков/Группы товаров", "post/grp-goods":U,
      717   "Группы товаров/Группы поставщиков", "grp-goods/post":U
      718        SIZE 37.38 BY 4.63
      719        BGCOLOR 8 FGCOLOR 0  NO-UNDO.
      720   DEFINE VARIABLE RADPost AS INTEGER
      721        VIEW-AS RADIO-SET VERTICAL
      722        RADIO-BUTTONS
      723             "все", 1,
      724   "Выборочно", 2
      725        SIZE 12 BY 2.17 NO-UNDO.
      726   DEFINE VARIABLE SortType AS CHARACTER
      727        VIEW-AS RADIO-SET VERTICAL
      728        RADIO-BUTTONS
      729             "по коду", "sort-code":U,
      730   "по артикулу", "sort-article":U
      731        SIZE 14 BY 2.17
      732        BGCOLOR 8 FGCOLOR 0  NO-UNDO.
      733   DEFINE VARIABLE type-stor AS INTEGER INITIAL 1
      734        VIEW-AS RADIO-SET VERTICAL
      735        RADIO-BUTTONS
      736             "все", 1,
      737   "выкуп", 2,
      738   "консигнация", 3,
      739   "мат.хранение", 4
      740        SIZE 16.25 BY 3.13 NO-UNDO.
      741   DEFINE RECTANGLE RECT-5
      742        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      743        SIZE 48.38 BY 7.04.
      744   DEFINE RECTANGLE RECT-6
      745        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      746        SIZE 19.63 BY 4.42.
      747   DEFINE RECTANGLE RECT-7
      748        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      749        SIZE 48.38 BY 3.42.
      750   DEFINE RECTANGLE RECT-8
      751        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      752        SIZE 48.38 BY 5.92.
      753   DEFINE RECTANGLE RECT-9
      754        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      755        SIZE 19.63 BY 12.08.
      756   DEFINE VARIABLE Cli-art AS LOGICAL INITIAL no
      757        LABEL "артикул поставщика":L
      758        VIEW-AS TOGGLE-BOX
      759        SIZE 21 BY .83 NO-UNDO.
      760   DEFINE VARIABLE Show-cost-Vat AS LOGICAL INITIAL no
      761        LABEL "НДС в учетных ценах":L
      762        VIEW-AS TOGGLE-BOX
      763        SIZE 22.88 BY .83 NO-UNDO.
      764   DEFINE VARIABLE Show-sale-Vat AS LOGICAL INITIAL no
      765        LABEL "НДС в ценах док-та":L
      766        VIEW-AS TOGGLE-BOX
      767        SIZE 22.88 BY .83 NO-UNDO.
      768   DEFINE VARIABLE Showcost AS LOGICAL INITIAL yes
      769        LABEL "Учетные цены"
      770        VIEW-AS TOGGLE-BOX
      771        SIZE 15.38 BY .83 TOOLTIP "Показать суммы в учетных ценах" NO-UNDO.
      772   DEFINE VARIABLE Showsale AS LOGICAL INITIAL no
      773        LABEL "Цены документа"
      774        VIEW-AS TOGGLE-BOX
      775        SIZE 17.38 BY .83 TOOLTIP "Показать суммы в ценах документа" NO-UNDO.
      776   DEFINE VARIABLE SumsOnly AS LOGICAL INITIAL no
      777        LABEL "Только итоги":L
      778        VIEW-AS TOGGLE-BOX
      779        SIZE 19 BY .83 NO-UNDO.
      780   DEFINE VARIABLE Tog-lavel AS LOGICAL INITIAL no
      781        LABEL "с уровня":L
      782        VIEW-AS TOGGLE-BOX
      783        SIZE 12.63 BY .79
      784        BGCOLOR 8 FGCOLOR 0  NO-UNDO.
      785   DEFINE VARIABLE Tog-lavel-2 AS LOGICAL INITIAL no
      786        LABEL "с уровня":L
      787        VIEW-AS TOGGLE-BOX
      788        SIZE 12.63 BY .79
      789        BGCOLOR 8 FGCOLOR 0  NO-UNDO.
      790   DEFINE VARIABLE Tog-obj AS LOGICAL INITIAL yes
      791        LABEL "Раздельно по объектам":L
      792        VIEW-AS TOGGLE-BOX
      793        SIZE 31 BY 1
      794        BGCOLOR 8 FGCOLOR 0  NO-UNDO.
      795   DEFINE FRAME F-Main
      796        RADPost AT ROW 2 COL 3 NO-LABEL
      797        PostName AT ROW 2 COL 15.38 NO-LABEL
      798        SortType AT ROW 2.54 COL 53 NO-LABEL
      799        Tog-obj AT ROW 5.54 COL 3
      800        Classify AT ROW 6.79 COL 3 NO-LABEL
      801        date1Rash AT ROW 7.29 COL 54 COLON-ALIGNED
      802        Tog-lavel-2 AT ROW 7.75 COL 28.25
      803        var-lavel-2 AT ROW 7.75 COL 39.13 COLON-ALIGNED NO-LABEL
      804        date2Rash AT ROW 8.46 COL 54 COLON-ALIGNED
      805        var-lavel AT ROW 8.58 COL 39.13 COLON-ALIGNED NO-LABEL
      806        Tog-lavel AT ROW 8.63 COL 28.25
      807        Showcost AT ROW 12.5 COL 30.13
      808        Show-cost-Vat AT ROW 12.67 COL 2.63
      809        Showsale AT ROW 13.33 COL 30.13
      810        Show-sale-Vat AT ROW 13.54 COL 2.63
      811        type-stor AT ROW 14.29 COL 30.13 NO-LABEL
      812        Cli-art AT ROW 15.42 COL 2.63
      813        SumsOnly AT ROW 16.33 COL 2.63
      814        Str AT ROW 6.33 COL 51.63 COLON-ALIGNED NO-LABEL
      815        "Выбор поставщика:" VIEW-AS TEXT
      816             SIZE 19.38 BY .67 AT ROW 1.25 COL 7.25
      817             FGCOLOR 4
      818        "Сортировка :" VIEW-AS TEXT
      819             SIZE 13.63 BY .75 AT ROW 1.46 COL 53
      820             FGCOLOR 4
      821        "Классификация :" VIEW-AS TEXT
      822             SIZE 15 BY .75 AT ROW 4.83 COL 7.25
      823             FGCOLOR 4
      824        "Показать :" VIEW-AS TEXT
      825             SIZE 11.5 BY .75 AT ROW 11.83 COL 7.25
      826             FGCOLOR 4
      827        RECT-9 AT ROW 5.5 COL 50.75
      828        RECT-5 AT ROW 4.54 COL 1.75
      829        RECT-6 AT ROW 1.04 COL 50.75
      830        RECT-7 AT ROW 1.04 COL 1.75
      831        RECT-8 AT ROW 11.63 COL 1.75
      832       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      833            SIDE-LABELS NO-UNDERLINE THREE-D
      834            AT COL 1 ROW 1 SCROLLABLE .
      835   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      836   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      837   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      838   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      839   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      840   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      841   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      842   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      843         adm-object-hdl = FRAME F-Main:HANDLE.
      844   RUN ensure-broker.
      845   THIS-PROCEDURE:ADM-DATA =
      846        'ADM1.1~`':U +
      847        'SmartObject~`':U +
      848        '~`':U +
      849        'NO ~`':U +
      850        '~`':U +
      851        '~`':U +
      852        '~`':U +
      853        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      854           + "~`":U +
      855        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      856        'Record-Source,Record-Target,TableIO-Target~`':U +
      857        '~`':U +
      858        '~`~`~`~`~`~`~`~`~`~`~`':U +
      859        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      860            THEN "^^":U
      861        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      862             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      863   PROCEDURE adm-apply-entry :
      864     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      865   END PROCEDURE.
      866   PROCEDURE adm-destroy :
      867    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      868   END PROCEDURE.
      869   PROCEDURE adm-disable :
      870       DISABLE RECT-9 RECT-5 RECT-6 RECT-7 RECT-8 RADPost PostName SortType Tog-obj Classify date1Rash date2Rash Showcost Show-cost-Vat Showsale type-stor Cli-art SumsOnly Str WITH FRAME F-Main.
      871       RUN dispatch ('disable-fields':U).
      872       RUN set-attribute-list ('ENABLED=no':U).
      873       RETURN.
      874   END PROCEDURE.
      875   PROCEDURE adm-edit-attribute-list :
      876         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      877         RETURN.
      878   END PROCEDURE.
      879   PROCEDURE adm-enable :
      880       ENABLE UNLESS-HIDDEN RECT-9 RECT-5 RECT-6 RECT-7 RECT-8 RADPost PostName SortType Tog-obj Classify date1Rash date2Rash Showcost Show-cost-Vat Showsale type-stor Cli-art SumsOnly Str WITH FRAME F-Main.
      881       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      882       RUN set-attribute-list ('ENABLED=yes':U).
      883       RETURN.
      884   END PROCEDURE.
      885   PROCEDURE adm-exit :
      886        RUN notify ('exit':U).
      887     RETURN.
      888   END PROCEDURE.
      889   PROCEDURE adm-hide :
      890     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      891   END PROCEDURE.
      892   PROCEDURE adm-initialize :
      893     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      894   END PROCEDURE.
      895   PROCEDURE adm-show-errors :
      896       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      897       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      898           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      899       END.
      900       RETURN.
      901   END PROCEDURE.
      902   PROCEDURE adm-UIB-mode :
      903     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      904   END PROCEDURE.
      905   PROCEDURE adm-view :
      906     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      907   END PROCEDURE.
      908   PROCEDURE dispatch :
      909       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      910       RUN broker-dispatch IN adm-broker-hdl
      911           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      912       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      913   END PROCEDURE.
      914   PROCEDURE ensure-broker :
      915   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      916   IF RETURN-VALUE NE "ADM-Broker":U THEN
      917   DO:
      918       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      919       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      920   END.
      921   END PROCEDURE.
      922   PROCEDURE get-attribute :
      923     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      924     RUN broker-get-attribute IN adm-broker-hdl
      925         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      926     RETURN RETURN-VALUE.
      927   END PROCEDURE.
      928   PROCEDURE get-attribute-list :
      929     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      930     RUN broker-get-attribute-list IN adm-broker-hdl
      931         (INPUT THIS-PROCEDURE,
      932          INPUT ?,
      933          OUTPUT p-attr-list) NO-ERROR.
      934     RETURN.
      935   END PROCEDURE.
      936   PROCEDURE new-state :
      937     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      938     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      939     RETURN.
      940   END PROCEDURE.
      941   PROCEDURE notify :
      942     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      943     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      944     IF RETURN-VALUE = "ADM-ERROR":U THEN
      945         RETURN "ADM-ERROR":U.
      946     RETURN.
      947   END PROCEDURE.
      948   PROCEDURE set-attribute-list :
      949     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      950     RUN ensure-broker.
      951     RUN broker-set-attribute-list IN adm-broker-hdl
      952         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      953     RETURN.
      954   END PROCEDURE.
      955   PROCEDURE set-position :
      956       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      957       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      958       IF VALID-HANDLE(adm-object-hdl) THEN
      959       DO:
      960         ASSIGN adm-object-hdl:ROW    =   p-row
      961                adm-object-hdl:COLUMN =   p-col.
      962       END.
      963       RETURN.
      964   END PROCEDURE.
      965   PROCEDURE adm-display-fields :
      966       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      967       RETURN.
      968   END PROCEDURE.
      969   PROCEDURE adm-open-query :
      970     RETURN.
      971   END PROCEDURE.
      972   PROCEDURE adm-row-changed :
      973         IF VALID-HANDLE(adm-object-hdl) THEN
      974           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      975         RUN notify ('row-available':U).
      976         RETURN.
      977   END PROCEDURE.
      978   PROCEDURE reposition-query :
      979       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      980       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      981       RETURN.
      982   END PROCEDURE.
      983     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      984     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      985     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      986     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      987     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      988     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      989     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      990     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      991     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      992     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      993     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      994     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      995     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      996     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      997     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      998     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      999     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1000     IF "":U = "":U THEN
     1001       RUN modify-list-attribute IN adm-broker-hdl
     1002         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1003     RUN use-create-on-add(?).
     1004   PROCEDURE adm-add-record :
     1005       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1006          "must have at least one Enabled Table to perform Add.":U
     1007          VIEW-AS ALERT-BOX ERROR.
     1008       RETURN.
     1009   END PROCEDURE.
     1010   PROCEDURE adm-assign-record :
     1011    MESSAGE
     1012          "Object ":U THIS-PROCEDURE:FILE-NAME
     1013            "must have at least one Enabled Table to perform Assign.":U
     1014              VIEW-AS ALERT-BOX ERROR.
     1015      RETURN.
     1016     END PROCEDURE.
     1017   PROCEDURE adm-assign-statement :
     1018     RETURN.
     1019   END PROCEDURE.
     1020   PROCEDURE adm-cancel-record :
     1021      RETURN.
     1022     END PROCEDURE.
     1023   PROCEDURE adm-copy-record :
     1024       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1025        "must have at least one Enabled Table to perform Copy.":U
     1026          VIEW-AS ALERT-BOX ERROR.
     1027       RETURN.
     1028   END PROCEDURE.
     1029   PROCEDURE adm-create-record :
     1030      RETURN.
     1031   END PROCEDURE.
     1032   PROCEDURE adm-current-changed :
     1033     RETURN.
     1034   END PROCEDURE.
     1035   PROCEDURE adm-delete-record :
     1036    MESSAGE
     1037          "Object ":U THIS-PROCEDURE:FILE-NAME
     1038            "must have at least one Enabled Table to perform Delete.":U
     1039              VIEW-AS ALERT-BOX ERROR.
     1040       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1041       RETURN.
     1042   END PROCEDURE.
     1043   PROCEDURE adm-disable-fields :
     1044         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1045       RETURN.
     1046   END PROCEDURE.
     1047   PROCEDURE adm-enable-fields :
     1048       RETURN.
     1049   END PROCEDURE.
     1050   PROCEDURE adm-end-update :
     1051     RETURN.
     1052   END PROCEDURE.
     1053   PROCEDURE adm-reset-record :
     1054       RETURN.
     1055   END PROCEDURE.
     1056   PROCEDURE adm-update-record :
     1057       MESSAGE
     1058         "Object ":U THIS-PROCEDURE:FILE-NAME
     1059           "must have at least one Enabled Table to perform Update.":U
     1060             VIEW-AS ALERT-BOX ERROR.
     1061      RETURN.
     1062   END PROCEDURE.
     1063   PROCEDURE check-modified :
     1064   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1065   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1066   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1067   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1068     IF check-state = "check":U THEN
     1069     DO:
     1070       RUN get-link-handle IN adm-broker-hdl
     1071         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1072            OUTPUT group-target-list).
     1073       IF group-target-list NE "":U THEN
     1074       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1075         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1076         RUN check-modified IN curr-widget ('group-check':U).
     1077         IF RETURN-VALUE NE "":U THEN
     1078         DO:
     1079           RUN check-modified-message(RETURN-VALUE).
     1080           RETURN "":U.
     1081         END.
     1082       END.
     1083     END.
     1084     RETURN "":U.
     1085   END PROCEDURE.
     1086   PROCEDURE check-modified-message :
     1087     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1088        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1089           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1090        IF RETURN-VALUE = "YES":U THEN
     1091           RUN notify ('view,CONTAINER-SOURCE':U).
     1092        MESSAGE IF p-changed-table NE ? THEN
     1093           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1094           ELSE "Current values have been changed."
     1095           SKIP "  Do you wish to save those changes?"
     1096           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1097        IF ANS THEN
     1098        DO:
     1099           IF group-assign-target THEN
     1100             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1101           ELSE RUN dispatch('update-record':U).
     1102           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1103           DO:
     1104               MESSAGE "Changes to the previous record were not saved."
     1105                 VIEW-AS ALERT-BOX ERROR.
     1106               IF group-assign-target THEN
     1107                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1108               ELSE RUN dispatch ('cancel-record':U).
     1109           END.
     1110        END.
     1111        ELSE DO:
     1112          IF group-assign-target THEN
     1113             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1114          ELSE RUN dispatch('cancel-record':U).
     1115        END.
     1116        RETURN.
     1117   END PROCEDURE.
     1118   PROCEDURE get-rowid :
     1119       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1120       ASSIGN
     1121       p-table   =   adm-first-table.
     1122       RETURN.
     1123   END PROCEDURE.
     1124   PROCEDURE init-group-assign :
     1125       RUN request-attribute IN adm-broker-hdl
     1126         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1127       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1128         group-assign-target = yes.
     1129       ELSE group-assign-target = no.
     1130       RETURN.
     1131   END PROCEDURE.
     1132   PROCEDURE set-editors :
     1133       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1134       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1135       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1136       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1137       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1138       DO WHILE VALID-HANDLE (curr-widget):
     1139           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1140              curr-widget:HIDDEN = no THEN DO:
     1141             CASE p-field-setting:
     1142               WHEN "INITIALIZE":U THEN
     1143               DO:
     1144                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1145                     read-only-list +
     1146                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1147                        STRING(curr-widget).
     1148               END.
     1149               WHEN "DISABLE":U OR
     1150               WHEN "ENABLE":U THEN
     1151               DO:
     1152                   curr-widget:SENSITIVE = yes.
     1153                   RUN get-attribute ('Read-Only-Editors':U).
     1154                   IF RETURN-VALUE = ? OR
     1155                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1156                       curr-widget:READ-ONLY =
     1157                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1158               END.
     1159               WHEN "CLEAR":U THEN
     1160                   curr-widget:SCREEN-VALUE = "":U.
     1161             END CASE.
     1162           END.
     1163           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1164       END.
     1165       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1166         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1167           + '"':U).
     1168       RETURN.
     1169   END PROCEDURE.
     1170   PROCEDURE use-check-modified-all :
     1171    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1172     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1173     RETURN.
     1174   END PROCEDURE.
     1175   PROCEDURE use-create-on-add :
     1176   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1177      RETURN.
     1178   END PROCEDURE.
     1179   PROCEDURE use-initial-lock :
     1180     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1181     ASSIGN adm-initial-lock = p-attr-value.
     1182     RETURN.
     1183   END PROCEDURE.
     1184     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1185   ASSIGN
     1186          FRAME F-Main:SCROLLABLE       = FALSE
     1187          FRAME F-Main:HIDDEN           = TRUE.
     1188   ASSIGN
     1189          Cli-art:HIDDEN IN FRAME F-Main           = TRUE.
     1190   ASSIGN
     1191          PostName:READ-ONLY IN FRAME F-Main        = TRUE.
     1192   ON VALUE-CHANGED OF Classify IN FRAME F-Main
     1193   DO:
     1194       Assign Classify.
     1195      if Classify = "grp-goods":U
     1196            Then do:
     1197               display TOG-lavel   with frame F-Main .
     1198               enable  TOG-lavel   with frame F-Main .
     1199           end.
     1200            Else do:
     1201               display  TOG-lavel  var-Lavel with frame F-Main .
     1202               disable  TOG-lavel  var-Lavel with frame F-Main .
     1203           end.
     1204    if Classify = "post":U
     1205            Then do:
     1206               display TOG-lavel-2   with frame F-Main .
     1207               enable  TOG-lavel-2   with frame F-Main .
     1208           end.
     1209            Else do:
     1210               display  TOG-lavel-2  var-Lavel-2 with frame F-Main .
     1211               disable  TOG-lavel-2  var-Lavel-2 with frame F-Main .
     1212           end.
     1213   END.
     1214   ON VALUE-CHANGED OF RADPost IN FRAME F-Main
     1215   DO:
     1216     Assign RadPost.
     1217     for each g#post share-lock : delete g#post. end.
     1218     Case RAdPost :
     1219     when 1 then DO:
     1220             Assign  Postname = 'все':U.
     1221             Display PostName with frame F-Main .
     1222          END.
     1223     when 2 then
     1224           do:
     1225               run ref/cli-all.w
     1226                   ( my-handle
     1227                   , "b-sel,b-mark"
     1228                   , 'про':U
     1229                   , 'все':U
     1230                   , 'текущие':U
     1231                   , ?
     1232                   , ",,,,,,NO,,"
     1233                   , ?
     1234                   , output post-grp_recids ) .
     1235               if post-grp_recids = "" then do:
     1236                    Assign  Postname = 'все':U radpost = 1.
     1237                    Display PostName radpost with frame F-Main .
     1238               end.
     1239               else do:
     1240                   Assign  Postname = ''.
     1241                   v-nn = num-entries( post-grp_recids ) .
     1242                   DO ii = 1 TO num-entries( post-grp_recids ) :
     1243                       FIND cli-post WHERE recid( cli-post ) = int(entry( ii, post-grp_recids )) NO-LOCK.
     1244                       create g#post.
     1245                       assign
     1246                       g#post.obj-type = cli-post.obj-type
     1247                       g#post.obj-code = cli-post.obj-code
     1248                       g#post.obj-name = cli-post.obj-name
     1249                       Postname = PostName + cli-post.obj-name + chr(10).
     1250                   END.
     1251                    Display PostName with frame F-Main .
     1252               end.
     1253           end.
     1254     End case.
     1255     END.
     1256   ON VALUE-CHANGED OF Showsale IN FRAME F-Main
     1257   DO:
     1258   assign Showsale.
     1259     if showsale then DO:
     1260                     type-stor = 1 .
     1261                     type-stor:screen-value = '1' .
     1262                     disable  type-stor with frame F-Main.
     1263                     enable Show-sale-Vat  with frame F-Main.
     1264                     End.
     1265                 else do:
     1266                                        Show-sale-Vat = no.
     1267                      enable  type-stor with frame F-Main.
     1268                      disable Show-Sale-vat  with frame F-Main .
     1269                       display Show-Sale-vat  with frame F-Main.
     1270                      end.
     1271   END.
     1272   ON VALUE-CHANGED OF Tog-lavel IN FRAME F-Main
     1273   DO:
     1274      Assign tog-lavel.
     1275     if tog-lavel =TRUE
     1276           Then do:
     1277               display  var-Lavel  with frame F-Main .
     1278               enable   var-Lavel  with frame F-Main .
     1279           end.
     1280            Else do:
     1281               display    var-Lavel with frame F-Main .
     1282               disable    var-Lavel with frame F-Main .
     1283           end.
     1284   END.
     1285   ON VALUE-CHANGED OF Tog-lavel-2 IN FRAME F-Main
     1286   DO:
     1287      Assign tog-lavel-2.
     1288     if tog-lavel-2 = TRUE
     1289           Then do:
     1290               display  var-Lavel-2  with frame F-Main .
     1291               enable   var-Lavel-2  with frame F-Main .
     1292           end.
     1293            Else do:
     1294               display    var-Lavel-2 with frame F-Main .
     1295               disable    var-Lavel-2 with frame F-Main .
     1296           end.
     1297   END.
     1298   ON VALUE-CHANGED OF Tog-obj IN FRAME F-Main
     1299   DO:
     1300         assign Tog-obj.
     1301     if tog-obj = false then do:
     1302       assign
     1303         Classify    = "no-classify"
     1304         SumsOnly    = true
     1305         type-stor   = 1
     1306         tog-Lavel-2 = false
     1307         tog-Lavel   = false
     1308         .
     1309         display Classify SumsOnly type-stor   var-Lavel-2 var-Lavel tog-Lavel-2 tog-Lavel with frame F-Main.
     1310         disable Classify SumsOnly type-stor  var-Lavel-2 var-Lavel tog-Lavel-2 tog-Lavel  with frame F-Main.
     1311     End.
     1312     Else do:
     1313       display Classify SumsOnly type-stor with frame F-Main.
     1314       enable Classify SumsOnly type-stor  with frame F-Main.
     1315     End.
     1316   END.
     1317   if not this-procedure :persistent
     1318   then do:
     1319     message
     1320       vss-workfile vss-revision vss-description skip
     1321       "Ошибка при запуске процедуры" skip
     1322       "Данную процедуру следует запускать только с параметром persistent" skip
     1323       view-as alert-box error .
     1324     undo, return error .
     1325   end.
     1326   PROCEDURE disable_UI :
     1327     HIDE FRAME F-Main.
     1328     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1329   END PROCEDURE.
     1330   PROCEDURE local-initialize :
     1331     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1332      Tog-obj:screen-value in frame F-Main = 'yes':U.
     1333       var-lavel:screen-value in frame F-Main = '1'.
     1334       var-lavel-2:screen-value in frame F-Main = '1'.
     1335   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1336   run create_obj-list in this-procedure
     1337    ( input v-cntxt-obj-type ,
     1338      input v-cntxt-obj-code )
     1339      .
     1340   str:screen-value in frame F-Main       = 'Период для РН'.
     1341   date1Rash:screen-value in frame F-Main = string(x-Date-Start,"99/99/99").
     1342   date2Rash:screen-value in frame F-Main = string(x-Date-End,"99/99/99")   .
     1343   END PROCEDURE.
     1344   PROCEDURE my-report :
     1345   define variable  g#ok as logical no-undo .
     1346    g#ok = true .
     1347   message "Запускать утилиту <<СОЗДАНИЕ АТРИБУТОВ ПАРТИЙ>>  ?"  view-as alert-box question
     1348      buttons yes-no
     1349      update g#ok.
     1350    if   g#ok then
     1351         run utl/objprtat.p ( my-handle,  false  ).
     1352    run rep/r-prpost.p
     1353       (input v-cntxt-obj-code ,
     1354       input v-cntxt-obj-type ,
     1355       input base-type  ,
     1356       input base-code  ,
     1357       Cli-art,
     1358       date1Rash ,
     1359       date2Rash ,
     1360       PostName,
     1361       type-stor ,
     1362       Show-cost-VAt ,
     1363       Show-sale-VAt ,
     1364       input Classify   ,
     1365       input SortType   ,
     1366       input SumsOnly   ,
     1367       input tog-obj    ,
     1368       input tog-lavel  ,
     1369       input var-lavel  ,
     1370       input tog-lavel-2  ,
     1371       input var-lavel-2  ) .
     1372   END PROCEDURE.
     1373   PROCEDURE my-var :
     1374   assign frame F-Main
     1375   Cli-art date1Rash date2Rash PostName  RADPost Show-cost-VAt Show-sale-VAt
     1376   Classify  SortType Str SumsOnly Tog-obj type-stor showcost  showsale
     1377   Tog-lavel  var-lavel Tog-lavel-2  Var-lavel-2 .
     1378   show-cost =  showcost .
     1379   show-sale =  showsale .
     1380   ReportNAme = "ОБОРОТ ПРИХОДНЫХ ПАРТИЙ ТОВАРОВ ПОСТАВЩИКА" .
     1381   def var t-class as char no-undo.
     1382   def var t-sort as char no-undo.
     1383     case classify:
     1384       when "no-classify":u    then t-class =   "Без классификации" .
     1385       when "prod":u           then t-class =   "Производители"   .
     1386       when "post":u           then t-class =   "Поставщики"   .
     1387       when "grp-goods":u      then t-class =   "Группы товаров"  .
     1388       when "post/grp-goods":u then t-class =   "Поставщики/Группы товаров" .
     1389       when "prod/grp-goods":u then t-class =   "Производители/Группы товаров" .
     1390       when "grp-goods/prod":u then t-class =   "Группы товаров/Производители" .
     1391       when "grp-goods/post":u then t-class =   "Группы товаров/Поставщики" .
     1392       when  "vat-ps":u        then t-class =   "Ставка НДС" .
     1393       when  "sort":u          then t-class =   "Проба(Сорт)" .
     1394       when  "n-level":u       then t-class =   "Группы с уровнем вложенности " .
     1395       when  "t-level":u       then t-class =   "Терминальные группы" .
     1396    end case.
     1397     case sorttype:
     1398       when "sort-pp":u               then t-sort =   "по порядку" .
     1399       when "sort-code":u             then t-sort =   "по коду" .
     1400       when "sort-artic":u            then t-sort =   "по артикулу"  .
     1401       when "sort-qunty":u            then t-sort =   "по реализации".
     1402       when "sort-name":u             then t-sort =   "по наименованию".
     1403       when "sort-type":u             then t-sort =   "по типу ткани".
     1404       when "sort-doc-code":u         then t-sort =   "по номеру документа".
     1405       when "sort-recipe-code":u      then t-sort =   "по номеру рецепта".
     1406    end case.
     1407   ReportHeader = "Поставщики : " + PostName + chr(10).
     1408   ReportHeader = ReportHeader + "Классификация : " + t-Class.
     1409   ReportHeader = ReportHeader +
     1410                  (if tog-lavel  then "    Итоги с уровня товаров "  + String(var-lavel)  else " "    ).
     1411   ReportHeader = ReportHeader +
     1412                  (if tog-lavel-2  then "    Итоги с уровня поставщиков "  + String(var-lavel-2)  else " "    ).
     1413   ReportHeader = ReportHeader  + chr(10).
     1414   ReportHeader = ReportHeader +
     1415                  "Сортировка " + t-Sort + chr(10) +
     1416                  "Показать : " +
     1417                  (if SumsOnly      then "Только итоги, "  else " "             ) +
     1418                  (if Show-Cost     then "Суммы в учетных ценах, "  else " "    ) +
     1419                  (if Show-Cost-vat then "НДС в учетных ценах, "  else " "      ) +
     1420                  (if Show-Sale     then "Суммы в ценах документа, "  else " "  ) +
     1421                  (if Show-Sale-vat then "НДС в ценах документа, "  else " "    ) +
     1422                  (if Cli-art       then "Артиклы поставщика, "  else " "       ) .
     1423   ReportHeader =  ReportHeader  + chr(10) + Entry(((type-stor * 2) - 1), type-stor:RADIO-BUTTONS) .
     1424   ReportHeader =  ReportHeader  + chr(10) + "Период расхода с " + string(date1Rash,"99/99/9999") + ' по ' + string( date2Rash,"99/99/9999").
     1425    sheetf.Excel-Column-Lable = "
     1426    Код,
     1427    Артикул,
     1428    Название товара,
     1429    Ед.изм,
     1430    т/у,
     1431    Приход внешний,,,,,
     1432    Расход внешний,,,,,
     1433    Касса,,,,,
     1434    Возврат внешний,,,,,
     1435    Возврат поставщику,,,,,
     1436    Инвентаризация,,,,,
     1437    Переоценка,,,,,
     1438    Списание,,,,,
     1439    "  + chr(10).
     1440    sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + ",,,,,
     1441    кол-во,учет.сумма,учет.НДС,док-т.сумма ,док-т.НДС,
     1442    кол-во,учет.сумма,учет.НДС,док-т.сумма ,док-т.НДС,
     1443    кол-во,учет.сумма,учет.НДС,док-т.сумма ,док-т.НДС,
     1444    кол-во,учет.сумма,учет.НДС,док-т.сумма ,док-т.НДС,
     1445    кол-во,учет.сумма,учет.НДС,док-т.сумма ,док-т.НДС,
     1446    кол-во,учет.сумма,учет.НДС,док-т.сумма ,док-т.НДС,
     1447    кол-во,учет.сумма,учет.НДС,док-т.сумма ,док-т.НДС,
     1448    кол-во,учет.сумма,учет.НДС,док-т.сумма ,док-т.НДС, ".
     1449    sheetf.Sizes = "10,16,60,7,3," + fill('13,',40).
     1450    Sheetf.ColFOrmat = "2=@;3=@"  .
     1451   END PROCEDURE.
