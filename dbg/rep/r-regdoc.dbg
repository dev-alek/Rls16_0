     6258               and tt-all.obj-code = 0
     6259               and tt-all.col02-num = "zzz":U
     6260               and tt-all.doc-type = p-doc-type
     6261               and tt-all.col08-VAT-PC   = p-vat-pc
     6262            NO-ERROR.
