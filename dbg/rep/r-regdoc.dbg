     6798   procedure print-footer :
     6799   do
     6800   on error undo, return error
     6801   :
     6802   end.
     6803   end procedure.
     6804   procedure create-goods :
     6805   do
     6806   on error undo, return error return-value
     6807   :
     6808      define buffer buf_goods    for ub.goods .
     6809      define buffer buf_cli-gds  for ub.cli-gds .
     6810      define variable v-curr-grp-name as character            no-undo .
     6811      define variable v-host-code     like clients.host-code  no-undo .
     6812      empty temp-table tt-gds.
     6813      case p-sel-gds :
     6814      when 1 then do:
     6815         for EACH  buf_goods
     6816            where  buf_goods.gds-type = 'т':U
     6817            NO-LOCK
     6818            :
     6819            CREATE tt-gds.
     6820            BUFFER-COPY buf_goods TO tt-gds.
     6821         end.
     6822      end.
     6823      when 2 then do:
     6824         for each tmp#grp no-lock
     6825            :
     6826            run grplib-get-full-name in this-procedure ( input tmp#grp.node-code
     6827                                                      , output v-curr-grp-name
     6828                                                      ) .
     6829            for each buf_goods
     6830                  where buf_goods.grp-name begins v-curr-grp-name
     6831                    and buf_goods.gds-type = 'т':U
     6832                  no-lock
     6833            :
     6834               find first tt-gds no-lock
     6835                  where tt-gds.artic     = buf_goods.artic
     6836                    and tt-gds.prod-type = buf_goods.prod-type
     6837                    and tt-gds.prod-code = buf_goods.prod-code
     6838                  no-error .
     6839               if not available tt-gds then do:
     6840                  create tt-gds.
     6841                  buffer-copy buf_goods to tt-gds.
     6842               end.
     6843            end.
     6844         end.
     6845      end.
     6846      when 3 then do:
     6847         for each  buf_goods
     6848             where buf_goods.gds-type = 'т':U
     6849             no-lock
     6850            ,
     6851            each buf_cli-gds
     6852               where buf_cli-gds.prod-type = buf_goods.prod-type
     6853                 and buf_cli-gds.prod-code = buf_goods.prod-code
     6854                 and buf_cli-gds.artic     = buf_goods.artic
     6855               no-lock
     6856               ,
     6857            first g#cli
     6858               where g#cli.obj-type = buf_cli-gds.cli-type
     6859                 and g#cli.obj-code = buf_cli-gds.cli-code
     6860            :
     6861               find first tt-gds no-lock
     6862                  where tt-gds.prod-type = buf_goods.prod-type
     6863                    and tt-gds.prod-code = buf_goods.prod-code
     6864                    and tt-gds.artic     = buf_goods.artic
     6865               no-error.
     6866               if not available tt-gds then do:
     6867                  create tt-gds.
     6868                  buffer-copy buf_goods to tt-gds no-error.
     6869               end.
     6870         end.
     6871      end.
     6872      when 7 then do:
     6873         for each tmp#grp no-lock
     6874            :
     6875            run grplib-get-full-name in this-procedure( input tmp#grp.node-code, output v-curr-grp-name ) .
     6876            for each  buf_goods no-lock
     6877                where buf_goods.grp-name begins v-curr-grp-name
     6878                  and buf_goods.gds-type = 'т':U
     6879               :
     6880               if NOT CAN-find ( first g#cli
     6881                                 where g#cli.obj-type = buf_goods.prod-type
     6882                                   and g#cli.obj-code = buf_goods.prod-code
     6883                              )
     6884               then NEXT .
     6885               find first tt-gds no-lock
     6886                  where tt-gds.artic     = buf_goods.artic
     6887                    and tt-gds.prod-type = buf_goods.prod-type
     6888                    and tt-gds.prod-code = buf_goods.prod-code
     6889                  no-error .
     6890               if not available tt-gds then do:
     6891                  create tt-gds.
     6892                  buffer-copy buf_goods to tt-gds no-error.
     6893               end.
     6894            end.
     6895         end.
     6896      end.
     6897      OTHERWISE do:
     6898         for each gds-list
     6899            where gds-list.gds-type = 'т':U
     6900            :
     6901            create tt-gds.
     6902            buffer-copy gds-list to tt-gds.
     6903         end.
     6904      end.
     6905      end case.
     6906   end.
     6907   end procedure.
     6908   procedure create-favour :
     6909   do
     6910   on error undo, return error return-value
     6911   :
     6912      define buffer buf_goods    for ub.goods .
     6913      define buffer buf_cli-gds  for ub.cli-gds .
     6914      define variable v-curr-grp-name as character            no-undo .
     6915      define variable v-host-code     like clients.host-code  no-undo .
     6916      empty temp-table tt-gds.
     6917      case p-sel-gds :
     6918      when 1 then do:
     6919            for EACH  buf_goods
     6920               where  buf_goods.gds-type = 'у':U
     6921               NO-LOCK
     6922               :
     6923               CREATE tt-gds.
     6924               BUFFER-COPY buf_goods TO tt-gds.
     6925            end.
     6926      end.
     6927      when 2 then do:
     6928         for each tmp#grp no-lock
     6929         :
     6930         run grplib-get-full-name in this-procedure ( input tmp#grp.node-code
     6931                                                      , output v-curr-grp-name
     6932                                                      ) .
     6933         for each buf_goods
     6934               where buf_goods.grp-name begins v-curr-grp-name
     6935                 and buf_goods.gds-type = 'у':U
     6936               no-lock
     6937         :
     6938            find first tt-gds no-lock
     6939               where tt-gds.artic     = buf_goods.artic
     6940                 and tt-gds.prod-type = buf_goods.prod-type
     6941                 and tt-gds.prod-code = buf_goods.prod-code
     6942               no-error .
     6943            if not available tt-gds then do :
     6944               create tt-gds.
     6945               buffer-copy buf_goods to tt-gds.
     6946            end.
     6947         end.
     6948         end.
     6949      end.
     6950      when 3 then do :
     6951         for each  buf_goods
     6952               where
     6953               buf_goods.gds-type = 'у':U
     6954               no-lock
     6955            ,
     6956            each buf_cli-gds no-lock
     6957               where buf_cli-gds.prod-type = buf_goods.prod-type
     6958                 and buf_cli-gds.prod-code = buf_goods.prod-code
     6959                 and buf_cli-gds.artic     = buf_goods.artic ,
     6960            first g#cli
     6961               where g#cli.obj-type = buf_cli-gds.cli-type
     6962                 and g#cli.obj-code = buf_cli-gds.cli-code
     6963         :
     6964            find first tt-gds no-lock
     6965               where tt-gds.prod-type = buf_goods.prod-type
     6966                 and tt-gds.prod-code = buf_goods.prod-code
     6967                 and tt-gds.artic     = buf_goods.artic
     6968            no-error.
     6969            if not available tt-gds then do :
     6970               create tt-gds.
     6971               buffer-copy buf_goods to tt-gds no-error.
     6972            end.
     6973         end.
     6974      end.
     6975      when 7 then do :
     6976         for each tmp#grp no-lock
     6977         :
     6978         run grplib-get-full-name in this-procedure( input tmp#grp.node-code, output v-curr-grp-name ) .
     6979         for each  buf_goods no-lock
     6980             where buf_goods.grp-name begins v-curr-grp-name
     6981               and buf_goods.gds-type = 'у':U
     6982            :
     6983            if NOT CAN-find ( first g#cli
     6984                              where g#cli.obj-type = buf_goods.prod-type
     6985                                and g#cli.obj-code = buf_goods.prod-code
     6986                              )
     6987            then NEXT .
     6988            find first tt-gds no-lock
     6989               where tt-gds.artic     = buf_goods.artic
     6990                 and tt-gds.prod-type = buf_goods.prod-type
     6991                 and tt-gds.prod-code = buf_goods.prod-code
     6992               no-error .
     6993            if not available tt-gds then do :
     6994               create tt-gds.
     6995               buffer-copy buf_goods to tt-gds no-error.
     6996            end.
     6997         end.
     6998         end.
     6999      end.
     7000      OTHERWISE do :
     7001         for each gds-list
     7002            where gds-list.gds-type = 'у':U
     7003            :
     7004            create tt-gds.
     7005            buffer-copy gds-list to tt-gds.
     7006         end.
     7007      end.
     7008      end case.
     7009   end.
     7010   end procedure.
     7011   procedure ostatok :
     7012   define input parameter p-fact-order as decimal no-undo.
     7013   define input parameter p-begin      as logical no-undo.
     7014   define buffer buf_tt-clcparts for tt-clcparts .
     7015   define buffer buf_parts       for ub.parts .
     7016   define buffer buf_goods       for ub.goods .
     7017   define buffer buf_gds-dtl     for ub.gds-dtl .
     7018   define buffer buf_sysconf     for ub.sysconf .
     7019   define buffer buf_tt-itog     for tt-itog .
     7020   define buffer buf_gds-obj     for ub.gds-obj .
     7021   define buffer buf_trn-doc     for ub.trn-doc .
     7022   define variable varb-code              like ub.bar-code.b-code       no-undo .
     7023   define variable vardoc-num             like ub.price-doc.doc-num     no-undo .
     7024   define variable varcur-base            like ub.gds-dtl.price-base    no-undo .
     7025   define variable varcur-road-tax        like ub.doc-line.road-tax     no-undo .
     7026   define variable varcur-excise          like ub.doc-line.excise       no-undo .
     7027   define variable varcur-vat-pc          like ub.doc-line.vat-pc       no-undo .
     7028   define variable varcur-cons-vat-pc     like ub.doc-line.cons-vat-pc  no-undo .
     7029   define variable varcur-slt-pc          like ub.doc-line.slt-pc       no-undo .
     7030   define variable varcur-fact-qnty       like ub.gds-dtl.fact-qnty     no-undo .
     7031   define variable varprice-sale          like ub.price-list.price-sale no-undo .
     7032   define variable varroad-tax            like ub.price-list.road-tax   no-undo .
     7033   define variable varexcise              like ub.price-list.excise     no-undo .
     7034   define variable varlastcur-base        like ub.gds-dtl.price-base    no-undo .
     7035   define variable varlastcur-road-tax    like ub.gds-dtl.price-base    no-undo .
     7036   define variable varlastcur-excise      like ub.gds-dtl.price-base    no-undo .
     7037   define variable v-base-rate  as decimal  no-undo.
     7038   define variable v-base-scale as integer  no-undo.
     7039   define variable v-host-code  as integer  no-undo.
     7040   do
     7041   on error undo, return error
     7042   :
     7043      for EACH obj-list:
     7044          if x-TOG-Shift then
     7045          do:
     7046              run factshift (obj-list.obj-code, obj-list.obj-type) no-error.
     7047              if error-status:error then next .
     7048          end.
     7049          for EACH tt-gds
     7050          :
     7051   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7052   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     7053     (input  obj-list.obj-type
     7054     ,input  obj-list.obj-code
     7055     ,output v-host-code
     7056     )  .
     7057            run partslib-init-temp-parts-by-factord ( input obj-list.obj-type
     7058                                                    , input obj-list.obj-code
     7059                                                    , input tt-gds.artic
     7060                                                    , input tt-gds.prod-type
     7061                                                    , input tt-gds.prod-code
     7062                                                    , input p-fact-order
     7063                                                    , FALSE
     7064                                                    ) .
     7065            for EACH temp-parts where temp-parts.obj-type  = obj-list.obj-type
     7066                                  and temp-parts.obj-code  = obj-list.obj-code
     7067                                  and temp-parts.artic     = tt-gds.artic
     7068                                  and temp-parts.prod-type = tt-gds.prod-type
     7069                                  and temp-parts.prod-code = tt-gds.prod-code
     7070                                 NO-LOCK
     7071                                 :
     7072               for each buf_tt-clcparts
     7073               on error undo, return error return-value
     7074               :
     7075                  delete buf_tt-clcparts .
     7076               end.
     7077               find first buf_trn-doc
     7078                    where buf_trn-doc.doc-code =  temp-parts.in-code
     7079                    no-lock
     7080                    NO-ERROR
     7081                    .
     7082               if AVAILABLE buf_trn-doc
     7083               then do :
     7084                  assign
     7085                     v-base-rate  = buf_trn-doc.base-rate
     7086                     v-base-scale = buf_trn-doc.base-scale
     7087                  .
     7088               end .
     7089               else do :
     7090                  assign
     7091                     v-base-rate  = 0
     7092                     v-base-scale = 0
     7093                  .
     7094               end.
     7095               create buf_tt-clcparts .
     7096               buffer-copy temp-parts to buf_tt-clcparts .
     7097   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     7098     (input  tt-gds.gds-code
     7099     ,input  ?
     7100     ,output varb-code
     7101     )  .
     7102   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7103   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcprcex in g#library
     7104     (input  obj-list.obj-type
     7105     ,input  obj-list.obj-code
     7106     ,input  varb-code
     7107     ,input  0
     7108     ,input  p-fact-order
     7109     ,output vardoc-num
     7110     ,output varprice-sale
     7111     ,output varroad-tax
     7112     ,output varexcise
     7113     ,output varcur-vat-pc
     7114     ,output varcur-slt-pc
     7115     )  .
     7116               if varprice-sale = ?
     7117               then do :
     7118                  assign
     7119                  varcur-vat-pc = 0
     7120                  varcur-slt-pc = 0
     7121                  .
     7122               end.
     7123               for each buf_gds-dtl no-lock
     7124                  where buf_gds-dtl.doc-code  = temp-parts.in-code
     7125                    and buf_gds-dtl.artic     = temp-parts.artic
     7126                    and buf_gds-dtl.prod-type = temp-parts.prod-type
     7127                    and buf_gds-dtl.prod-code = temp-parts.prod-code
     7128               on error undo, return error return-value
     7129               :
     7130   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     7131     (input  tt-gds.gds-code
     7132     ,input  buf_gds-dtl.prt-code
     7133     ,output varb-code
     7134     ) no-error .
     7135   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7136   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     7137     (input  obj-list.obj-type
     7138     ,input  obj-list.obj-code
     7139     ,input  varb-code
     7140     ,input  0
     7141     ,input  p-fact-order
     7142     ,output vardoc-num
     7143     ,output varprice-sale
     7144     ,output varroad-tax
     7145     ,output varexcise
     7146     )  .
     7147                  if varprice-sale = ?
     7148                  then do :
     7149                  assign
     7150                     varprice-sale = 0
     7151                     varroad-tax   = 0
     7152                     varexcise     = 0
     7153                  .
     7154                  end.
     7155                  assign
     7156                     varlastcur-base     = varprice-sale
     7157                     varlastcur-road-tax = varroad-tax
     7158                     varlastcur-excise   = varexcise
     7159                     varcur-base         = varcur-base      + varprice-sale * buf_gds-dtl.fact-qnty
     7160                     varcur-road-tax     = varcur-road-tax  + varroad-tax   * buf_gds-dtl.fact-qnty
     7161                     varcur-excise       = varcur-excise    + varexcise     * buf_gds-dtl.fact-qnty
     7162                     varcur-fact-qnty    = varcur-fact-qnty +                 buf_gds-dtl.fact-qnty
     7163                  .
     7164               end.
     7165               if varcur-fact-qnty = 0 then do :
     7166                  assign
     7167                     varcur-base      = varlastcur-base
     7168                     varcur-road-tax  = varlastcur-road-tax
     7169                     varcur-excise    = varlastcur-excise
     7170                  .
     7171               end.
     7172               else do :
     7173                  assign
     7174                     varcur-base      = varcur-base      / varcur-fact-qnty
     7175                     varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     7176                     varcur-excise    = varcur-excise    / varcur-fact-qnty
     7177                  .
     7178               end.
     7179               find first buf_sysconf
     7180                   where buf_sysconf.host-code = v-host-code
     7181                   no-lock.
     7182               assign varcur-cons-vat-pc = buf_sysconf.cons-vat-pc .
     7183               if varcur-cons-vat-pc = ? then do :
     7184                  assign varcur-cons-vat-pc = 0 .
     7185               end.
     7186               run clcprtsl_calc-ttable in this-procedure
     7187                  ( input TRUE
     7188                  , input TRUE
     7189                  , input 0
     7190                  , input 0
     7191                  , input varcur-vat-pc
     7192                  , input varcur-cons-vat-pc
     7193                  , input 0
     7194                  , input v-base-rate
     7195                  , input v-base-scale
     7196                  , input ( if tPrintRubl = yes then "rubl":U else "base":U )
     7197                  , input varprice-sale
     7198                  , input varcur-road-tax
     7199                  , input varcur-excise
     7200                  , input varcur-vat-pc
     7201                  , input varcur-cons-vat-pc
     7202                  , input varcur-slt-pc
     7203                  ) no-error .
     7204               RUN create-ost-lines ( INPUT temp-parts.obj-type
     7205                                    , INPUT temp-parts.obj-code
     7206                                    , INPUT ROUND(temp-parts.vat-pc, 0)
     7207                                    , INPUT p-begin
     7208                                    ) .
     7209         end.
     7210         end.
     7211      end.
     7212   end.
     7213   end procedure.
     7214   procedure create-ost-lines :
     7215   define input parameter p-obj-type as character        no-undo .
     7216   define input parameter p-obj-code as integer          no-undo .
     7217   define input parameter p-vat-pc   as character        no-undo .
     7218   define input parameter p-begin    as logical          no-undo .
     7219   define buffer buf_tt-itog     for tt-itog .
     7220   define buffer buf_clients     for ub.clients .
     7221   do
     7222   on error undo, return error
     7223   :
     7224      if rz-objecte
     7225      then do :
     7226         find first buf_tt-itog
     7227              where buf_tt-itog.obj-type = p-obj-type
     7228                and buf_tt-itog.obj-code = p-obj-code
     7229                and buf_tt-itog.vat-pc   = "":U
     7230                and buf_tt-itog.begin    = p-begin
     7231              NO-ERROR
     7232              .
     7233         if NOT AVAILABLE buf_tt-itog
     7234         then do :
     7235               find  first buf_clients
     7236                     where buf_clients.obj-type = p-obj-type
     7237                       and buf_clients.obj-code = p-obj-code
     7238                     NO-LOCK
     7239                     NO-ERROR
     7240                     .
     7241               CREATE buf_tt-itog.
     7242               assign
     7243                  buf_tt-itog.obj-type = p-obj-type
     7244                  buf_tt-itog.obj-code = p-obj-code
     7245                  buf_tt-itog.vat-pc   = "":U
     7246                  buf_tt-itog.obj-name = if AVAILABLE buf_clients then SUBSTITUTE("Оcтаток на &1 &2", if p-begin then "начало" else "конец", buf_clients.obj-name)
     7247                                                                  else SUBSTITUTE("Оcтаток на &1 &2 &3", if p-begin then "начало" else "конец", p-obj-type, p-obj-code)
     7248                  buf_tt-itog.begin    = p-begin
     7249               .
     7250         end.
     7251         RUN update-ost-line ( BUFFER buf_tt-itog  ).
     7252         if VAT-PC
     7253         then do :
     7254            find first buf_tt-itog
     7255                 where buf_tt-itog.obj-type = p-obj-type
     7256                   and buf_tt-itog.obj-code = p-obj-code
     7257                   and buf_tt-itog.vat-pc   = p-vat-pc
     7258                   and buf_tt-itog.begin    = p-begin
     7259                  NO-ERROR
     7260                  .
     7261            if NOT AVAILABLE buf_tt-itog
     7262            then do :
     7263                  find  first buf_clients
     7264                        where buf_clients.obj-type = p-obj-type
     7265                          and buf_clients.obj-code = p-obj-code
     7266                        NO-LOCK
     7267                        NO-ERROR
     7268                        .
     7269                  CREATE buf_tt-itog.
     7270                  assign
     7271                     buf_tt-itog.obj-type = p-obj-type
     7272                     buf_tt-itog.obj-code = p-obj-code
     7273                     buf_tt-itog.vat-pc   = p-vat-pc
     7274                     buf_tt-itog.obj-name = if AVAILABLE buf_clients then SUBSTITUTE("Оcтаток на &1 &2", if p-begin then "начало" else "конец", buf_clients.obj-name)
     7275                                                                     else SUBSTITUTE("Оcтаток на &1 &2 &3", if p-begin then "начало" else "конец", p-obj-type, p-obj-code)
     7276                     buf_tt-itog.begin    = p-begin
     7277                  .
     7278            end.
     7279            RUN update-ost-line ( BUFFER buf_tt-itog   ).
     7280         end.
     7281      end.
     7282      find first buf_tt-itog
     7283           where buf_tt-itog.obj-type = "zzz":U
     7284             and buf_tt-itog.obj-code = 0
     7285             and buf_tt-itog.vat-pc   = "":U
     7286             and buf_tt-itog.begin    = p-begin
     7287           NO-ERROR
     7288           .
     7289      if NOT AVAILABLE buf_tt-itog
     7290      then do:
     7291         CREATE buf_tt-itog.
     7292         assign
     7293            buf_tt-itog.obj-type = "zzz":U
     7294            buf_tt-itog.obj-code = 0
     7295            buf_tt-itog.vat-pc   = "":U
     7296            buf_tt-itog.begin    = p-begin
     7297         .
     7298      end.
     7299      RUN update-ost-line ( BUFFER buf_tt-itog  ).
     7300      if VAT-PC
     7301      then do:
     7302         find first buf_tt-itog
     7303              where buf_tt-itog.obj-type = "zzz":U
     7304                and buf_tt-itog.obj-code = 0
     7305                and buf_tt-itog.vat-pc   = p-vat-pc
     7306                and buf_tt-itog.begin    = p-begin
     7307            NO-ERROR
     7308            .
     7309         if NOT AVAILABLE buf_tt-itog
     7310         then do:
     7311            CREATE buf_tt-itog.
     7312            assign
     7313               buf_tt-itog.obj-type = "zzz":U
     7314               buf_tt-itog.obj-code = 0
     7315               buf_tt-itog.vat-pc   = p-vat-pc
     7316               buf_tt-itog.begin    = p-begin
     7317            .
     7318         end.
     7319         RUN update-ost-line ( BUFFER buf_tt-itog  ).
     7320      end.
     7321   end.
     7322   end procedure.
     7323   procedure update-ost-line :
     7324   DEFINE PARAMETER BUFFER bf_tt-itog for tt-itog.
     7325   define buffer buf_tt-allsum-line    for tt-allsum-line .
     7326   do
     7327   on error undo, return error
     7328   :
     7329      find first buf_tt-allsum-line
     7330         where buf_tt-allsum-line.sum-type = 'основная_сумма':U
     7331         no-error .
     7332      if available buf_tt-allsum-line
     7333      then do:
     7334         assign
     7335            bf_tt-itog.col09-qnty      = bf_tt-itog.col09-qnty       + buf_tt-allsum-line.fact-qnty
     7336            bf_tt-itog.SumWithNDS-cost = bf_tt-itog.SumWithNDS-cost  + if tPrintRubl then buf_tt-allsum-line.sum-dsc-rubl-acc else buf_tt-allsum-line.sum-dsc-base-acc
     7337            bf_tt-itog.VAT-cost        = bf_tt-itog.VAT-cost         + if tPrintRubl then buf_tt-allsum-line.vat-rubl-acc     else buf_tt-allsum-line.vat-base-acc
     7338            bf_tt-itog.SumWithNDS-sale = bf_tt-itog.SumWithNDS-sale  + if tPrintRubl then buf_tt-allsum-line.sum-dsc-rubl-doc else buf_tt-allsum-line.sum-dsc-base-doc
     7339            bf_tt-itog.VAT-sale        = bf_tt-itog.VAT-sale         + if tPrintRubl then buf_tt-allsum-line.vat-rubl-doc     else buf_tt-allsum-line.vat-base-doc
     7340            bf_tt-itog.SumWithNDS-crsa = bf_tt-itog.SumWithNDS-crsa  + (if tPrintRubl then buf_tt-allsum-line.sum-dsc-rubl-cur else buf_tt-allsum-line.sum-dsc-base-cur)
     7341            bf_tt-itog.VAT-crsa        = bf_tt-itog.VAT-crsa         + (if tPrintRubl then buf_tt-allsum-line.vat-rubl-cur     else buf_tt-allsum-line.vat-base-cur)
     7342         .
     7343      end.
     7344   end.
     7345   end procedure.
     7346    procedure format-itog :
     7347    if tt-all.col07-clients begins "Итого" then do :
     7348       run print-bold in this-procedure .
     7349    end .
     7350    end procedure.
     7351    procedure print-bold :
     7352          run macr_cell_format in this-procedure
     7353           (input 10
     7354           ,input true
     7355           ,input false
     7356           ,input ?
     7357           ,input num#str#
     7358           ,input num#col#
     7359           ,input ?
     7360           ,input ?
     7361           ) .
     7362    end procedure.
     7363   procedure factshift:
     7364   define input parameter p-obj-code as integer no-undo .
     7365   define input parameter p-obj-type as character no-undo .
     7366   define buffer end_shift-obj      for ub.shift-obj .
     7367   define buffer previous-shift-obj for ub.shift-obj.
     7368   define variable fo      as decimal no-undo init 0.
     7369   define variable prev-fo as decimal no-undo init 0.
     7370   define variable moving  as logical no-undo init yes.
     7371   assign
     7372   pobj-code = p-obj-code .
     7373   pobj-type = p-obj-type .
     7374      find first end_shift-obj share-lock
     7375         where end_shift-obj.obj-type   = pobj-type
     7376         and end_shift-obj.obj-code   = pobj-code
     7377         and end_shift-obj.shift-date = pshift-date1
     7378         and end_shift-obj.shift-num  = pshift-num1
     7379         no-error.
     7380      if not available end_shift-obj then
     7381      do:
     7382         find last end_shift-obj share-lock
     7383            where end_shift-obj.obj-type   = pobj-type
     7384            and end_shift-obj.obj-code   = pobj-code
     7385            and end_shift-obj.shift-date = pshift-date1
     7386            no-error.
     7387         if not available (end_shift-obj) then
     7388         do:
     7389            find last end_shift-obj share-lock
     7390               where end_shift-obj.obj-type   = pobj-type
     7391               and end_shift-obj.obj-code   = pobj-code
     7392               and end_shift-obj.shift-date < pshift-date1
     7393               no-error.
     7394            if not available (end_shift-obj) then
     7395            do:
     7396               return error.
     7397            end.
     7398         end.
     7399      end.
     7400      assign
     7401         fo = end_shift-obj.fact-order
     7402         .
     7403      find last previous-shift-obj share-lock
     7404         where previous-shift-obj.obj-type = pobj-type
     7405         and previous-shift-obj.obj-code = pobj-code
     7406         and (( previous-shift-obj.shift-date = pshift-date
     7407         and previous-shift-obj.shift-num < pshift-num
     7408         )
     7409         or previous-shift-obj.shift-date < pshift-date
     7410         )
     7411         use-index pi no-error.
     7412      if available previous-shift-obj then
     7413      do:
     7414         if  previous-shift-obj.shift-date < p-previous-shift-date then
     7415         do:
     7416            run day-begin-fact-order in this-procedure (
     7417               input  p-previous-shift-date
     7418               ,output prev-fo).
     7419         end.
     7420         else
     7421         do:
     7422            assign
     7423               prev-fo = previous-shift-obj.fact-order
     7424               .
     7425         end.
     7426      end.
     7427   v-fact-order-start = prev-fo.
     7428   if fo > 0 then
     7429   v-fact-order-end = fo .
     7430   else v-fact-order-end = 99999999999999.
     7431   end procedure .
     7432   procedure display-title :
     7433   assign
     7434     num#str# = 1
     7435     num#col# = 1
     7436   .
     7437   put stream outstream  reportname  at 20 format "x(170)" skip
     7438                         trim(str1)  at 20 format "x(75)" .
     7439   run macr_excel_char_with_format in this-procedure
     7440                   (input  reportname
     7441                   ,input  num#str#
     7442                   ,input  num#col#
     7443                   ) .
     7444   run macr_cell_format in this-procedure
     7445     (input 18
     7446     ,input true
     7447     ,input false
     7448     ,input ?
     7449     ,input num#str#
     7450     ,input num#col#
     7451     ,input ?
     7452     ,input ?
     7453     ) .
     7454   assign num#str# = num#str# + 1.
     7455   run macr_excel_char_with_format in this-procedure
     7456                   (input  str1
     7457                   ,input  num#str#
     7458                   ,input  num#col#
     7459                   ) .
     7460   assign num#str# = num#str# + 1.
     7461   repeat i = 1 to num-entries(str2,chr(10)) :
     7462     put stream outstream entry(i,str2,chr(10))  at 1 format "x(170)" skip .
     7463     run macr_excel_char_with_format in this-procedure
     7464                     (input  entry(i,str2,chr(10))
     7465                     ,input  num#str#
     7466                     ,input  num#col#
     7467                     ) .
     7468     assign num#str# = num#str# + 1.
     7469   end.
     7470   put stream outstream trim(str3)  at 1 format "x(75)" skip.
     7471   run macr_excel_char_with_format in this-procedure
     7472                   (input  str3
     7473                   ,input  num#str#
     7474                   ,input  num#col#
     7475                   ) .
     7476   assign num#str# = num#str# + 1.
     7477   repeat i = 1 to num-entries(str4,chr(10)) :
     7478     put stream outstream entry(i,str4,chr(10))  at 1 format "x(170)" skip .
     7479     run macr_excel_char_with_format in this-procedure
     7480                       (input  entry(i,str4,chr(10))
     7481                       ,input  num#str#
     7482                       ,input  num#col#
     7483                       ) .
     7484     assign num#str# = num#str# + 1.
     7485   end.
     7486   repeat i = 1 to num-entries(reportheader,chr(10)) :
     7487     put stream outstream entry(i,reportheader,chr(10))  at 1 format "x(170)" skip .
     7488     run macr_excel_char_with_format in this-procedure
     7489                     (input  entry(i,reportheader,chr(10))
     7490                     ,input  num#str#
     7491                     ,input  num#col#
     7492                     ) .
     7493     assign num#str# = num#str# + 1.
     7494   end.
     7495   end procedure.
     7496   def var vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7497   procedure macr_excel_char :
     7498    do
     7499    on error undo, return error return-value
     7500    :
     7501    define input parameter  p-val as character no-undo .
     7502    define input parameter  p-row as integer no-undo .
     7503    define input parameter  p-col as integer no-undo .
     7504    if p-val = ? then p-val = "" .
     7505       put stream macr_excel unformatted
     7506             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     7507    end.
     7508   end procedure.
     7509   procedure macr_excel_char_with_format :
     7510    do
     7511    on error undo, return error return-value
     7512    :
     7513    define input parameter  p-val as character no-undo .
     7514    define input parameter  p-row as integer no-undo .
     7515    define input parameter  p-col as integer no-undo .
     7516    if p-val = ? then p-val = "" .
     7517       put stream macr_excel unformatted
     7518             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     7519       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     7520       put stream macr_excel unformatted
     7521             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     7522    end.
     7523   end procedure.
     7524   procedure macr_excel_cell_format :
     7525    do
     7526    on error undo, return error return-value
     7527    :
     7528    define input parameter  p-val    as character no-undo .
     7529    define input parameter  p-row    as integer   no-undo .
     7530    define input parameter  p-col    as integer   no-undo .
     7531    define input parameter  p-format as character no-undo .
     7532    if p-val = ? then p-val = "" .
     7533       put stream macr_excel unformatted
     7534             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     7535       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     7536       put stream macr_excel unformatted
     7537             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     7538    end.
     7539   end procedure.
     7540   procedure macr_excel_sum :
     7541    do
     7542    on error undo, return error return-value
     7543    :
     7544    define input parameter  p-row as integer no-undo .
     7545    define input parameter  p-col as integer no-undo .
     7546    define input parameter  p-row1 as integer no-undo .
     7547    define input parameter  p-col1 as integer no-undo .
     7548    define input parameter  p-row2 as integer no-undo .
     7549    define input parameter  p-col2 as integer no-undo .
     7550       put stream macr_excel unformatted
     7551             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     7552    end.
     7553   end procedure.
     7554   procedure macr_excel_dec :
     7555    do
     7556    on error undo, return error return-value
     7557    :
     7558    define input parameter  p-val as character no-undo .
     7559    define input parameter  p-row as integer   no-undo .
     7560    define input parameter  p-col as integer   no-undo .
     7561     if p-val = ? then p-val =  "" .
     7562      put  stream macr_excel unformatted
     7563           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     7564    end.
     7565   end procedure.
     7566   procedure macr_cell_format :
     7567    do
     7568    on error undo, return error return-value
     7569    :
     7570    define input parameter  p-size   as integer   no-undo .
     7571    define input parameter  p-bold   as logical   no-undo .
     7572    define input parameter  p-italic as logical   no-undo .
     7573    define input parameter  p-color  as integer   no-undo .
     7574    define input parameter  p-row    as integer   no-undo .
     7575    define input parameter  p-col    as integer   no-undo .
     7576    define input parameter  p-row-2  as integer   no-undo .
     7577    define input parameter  p-col-2  as integer   no-undo .
     7578     if p-size = ? then p-size = 10 .
     7579     if p-bold = ? then p-bold = false .
     7580     if p-italic = ? then p-italic = false .
     7581     if p-row-2 = ? then p-row-2 = p-row .
     7582     if p-col-2 = ? then p-col-2 = p-col .
     7583     put  stream macr_excel unformatted
     7584      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     7585     if p-color <> ? then do:
     7586        put  stream macr_excel unformatted
     7587          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     7588     end.
     7589     put  stream macr_excel unformatted
     7590          substitute('format.font(,&1,&2,&3)' , p-size,
     7591                                           string ( p-bold  , "true/false" ) ,
     7592                                           string ( p-italic , "true/false" )
     7593                                           ) + chr(10) .
     7594    end.
     7595   end procedure.
     7596   procedure macr_cell_size :
     7597    do
     7598    on error undo, return error return-value
     7599    :
     7600    define input parameter  p-w   as integer   no-undo .
     7601    define input parameter  p-l   as integer   no-undo .
     7602    define input parameter  p-row    as integer   no-undo .
     7603    define input parameter  p-col    as integer   no-undo .
     7604    define input parameter  p-row-2  as integer   no-undo .
     7605    define input parameter  p-col-2  as integer   no-undo .
     7606     if p-row-2 = ? then p-row-2 = p-row .
     7607     if p-col-2 = ? then p-col-2 = p-col .
     7608     if p-w = ? then    p-w = 0 .
     7609     if p-l = ? then    p-l = 0 .
     7610    define variable s-w as character no-undo .
     7611    define variable s-l as character no-undo .
     7612    if p-w = 0 then s-w = "" .
     7613               else s-w = string(p-w)  .
     7614    if p-l = 0 then s-l = "" .
     7615               else s-l = string(p-l)  .
     7616   put  stream macr_excel unformatted
     7617        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     7618   put  stream macr_excel unformatted
     7619        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     7620   put  stream macr_excel unformatted
     7621        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     7622    end.
     7623   end procedure.
     7624   procedure proc-print-header :
     7625    do
     7626    on error undo, return error return-value
     7627    :
     7628      find first sheetf .
     7629        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     7630        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     7631        var-1 =  num#str# .
     7632        repeat c-c = 1 to sheetf.excel-row-title :
     7633        num#str# = num#str# + 1 .
     7634        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     7635        do c-i = 1 to p-var :
     7636           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     7637           str--2 = integer(entry( c-i, sheetf.sizes )) .
     7638           num#col# = c-i .
     7639           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     7640           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     7641        end.
     7642       c-i = 0.
     7643       end.
     7644       run macr_cell_format (
     7645           10       ,
     7646           true     ,
     7647           false    ,
     7648           35       ,
     7649           var-1 + 1,
     7650           1        ,
     7651           num#str# ,
     7652           num#col# )
     7653           .
     7654     put  stream macr_excel unformatted
     7655          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     7656          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     7657          .
     7658    end.
     7659   end procedure.
     7660   procedure end-proc :
     7661    do
     7662    on error undo, return error return-value
     7663    :
     7664     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     7665     OUTPUT to VALUE (v-file-name) .
     7666     for each temp-param :
     7667       export  temp-param  .
     7668     end.
     7669    end.
     7670   end procedure.
