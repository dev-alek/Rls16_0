     5094   end.
     5095   end procedure.
     5096   procedure ColumnTitle :
     5097   do on error undo, return error return-value
     5098   :
     5099      define variable v-column  as character    no-undo .
     5100      define variable v-size    as character    no-undo .
     5101      run col-select in this-procedure.
     5102       assign
     5103         num#col# = 0
     5104      .
     5105      if v-col01 = yes
     5106      then do:
     5107         PUT stream OutStream "|"  "Дата"                     format "X(10)"  .
     5108         assign
     5109            num#col# = num#col# + 1
     5110            v-column = v-column + "Дата"    + chr(44)
     5111            v-size = v-size + "10" + chr(44)
     5112         .
     5113      end.
     5114      if v-col02 = yes  then do: PUT stream OutStream "|"  "Номер"                    format "X(15)"  .
     5115         assign
     5116            num#col# = num#col# + 1
