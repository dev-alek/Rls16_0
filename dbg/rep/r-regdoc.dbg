      667   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      668   procedure paramls-clear :
      669     define buffer buf_temp-param for temp-param .
      670     do
      671     on error undo, return error return-value
      672     :
      673       for each buf_temp-param
      674       on error undo, return error
      675       :
      676         delete buf_temp-param .
      677       end.
      678     end.
      679   end procedure.
      680   procedure paramls-write :
      681     define input  parameter p-code     as character no-undo .
      682     define input  parameter p-sub-code as character no-undo .
      683     define input  parameter p-value    as character no-undo .
      684     define buffer buf_temp-param for temp-param .
      685     do
      686     on error undo, return error return-value
      687     :
      688       find first buf_temp-param
      689         where buf_temp-param.param-code     = p-code
      690           and buf_temp-param.param-sub-code = p-sub-code
      691         no-error .
      692       if not available buf_temp-param then do:
      693         create buf_temp-param .
      694         assign
      695           buf_temp-param.param-code     = p-code
      696           buf_temp-param.param-sub-code = p-sub-code
      697         .
      698       end.
      699       assign
      700         buf_temp-param.param-value = p-value
      701       .
      702     end.
      703   end procedure.
      704   procedure paramls-read :
      705     define input  parameter p-code          as character no-undo .
      706     define input  parameter p-sub-code      as character no-undo .
      707     define input  parameter p-default-value as character no-undo .
      708     define output parameter p-value         as character no-undo .
      709     define buffer buf_temp-param for temp-param .
      710     do
      711     on error undo, return error return-value
      712     :
      713       find first buf_temp-param
      714         where buf_temp-param.param-code     = p-code
      715           and buf_temp-param.param-sub-code = p-sub-code
      716         no-error .
      717       if available buf_temp-param then do:
      718         assign
      719           p-value = buf_temp-param.param-value
      720         .
      721       end.
      722       else do:
      723         assign
      724           p-value = p-default-value
      725         .
      726       end.
      727     end.
      728   end procedure.
      729   procedure paramls-append :
      730     define input  parameter p-code     as character no-undo .
      731     define input  parameter p-sub-code as character no-undo .
      732     define input  parameter p-value    as character no-undo .
      733     define buffer buf_temp-param for temp-param .
      734     do
      735     on error undo, return error return-value
      736     :
      737       find first buf_temp-param
      738            where buf_temp-param.param-code     = p-code
      739              and buf_temp-param.param-sub-code = p-sub-code
      740         no-error .
      741       if not available buf_temp-param then do:
      742         create buf_temp-param .
      743         assign
      744           buf_temp-param.param-code     = p-code
      745           buf_temp-param.param-sub-code = p-sub-code
      746           buf_temp-param.param-value    = p-value
      747         .
      748       end.
      749       else do:
      750           assign
      751               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      752           .
      753       end.
      754     end.
      755   end procedure.
      756   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      757   define variable v-waitfram-action01         as character   no-undo .
      758   define variable v-waitfram-action02         as character   no-undo .
      759   define variable v-waitfram-action03         as character   no-undo .
      760   define variable mWaitFramTextBeg            as character   no-undo.
      761   define variable mWaitFramTextEnd            as character   no-undo.
      762   define variable mWaitFramView               as logical     no-undo.
      763   define variable mWaitProcEvent              as logical     no-undo init yes.
      764   define variable mWaitFramInterval           as integer     no-undo init 1 .
      765   define variable mWaitFramStop               as logical     no-undo.
      766   define variable mWaitFramStopUser           as logical     no-undo.
      767   define variable mWaitFramStopTimeOut        as logical     no-undo.
      768   define variable mWaitFramStartProc          as datetime-tz no-undo.
      769   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      770   define button B-WaitFramStop auto-end-key
      771        label "Стоп"
      772        size 10 by 1 tooltip "Остоновить процесс".
      773   define button B-viewProcInfo
      774        label "Информация"
      775        size 15 by 1 tooltip "Информация о процесс".
      776   define frame waitfram
      777     v-waitfram-action01 format "x(72)" no-label skip
      778     v-waitfram-action02 format "x(72)" no-label skip
      779     v-waitfram-action03 format "x(72)" no-label skip
      780     B-viewProcInfo
      781     B-WaitFramStop at row 4 col 30
      782     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      783     .
      784   define new global shared variable mBatchMode as logical no-undo init ?.
      785   define variable mFramBachModHandle as handle no-undo.
      786   mFramBachModHandle = frame waitfram:handle.
      787   define variable mFameOldVis as logical no-undo.
      788   define variable mVisCUrentVin as logical no-undo.
      789   if session:batch-mode
      790   then
      791      mBatchMode = yes.
      792   if mBatchMode = ? then do:
      793     mVisCUrentVin = current-window:visible.
      794     mFameOldVis = mFramBachModHandle:visible.
      795     mFramBachModHandle:visible  = yes.
      796     mBatchMode = mFramBachModHandle:visible ne yes.
      797     mFramBachModHandle:visible = mFameOldVis.
      798     current-window:visible = mVisCUrentVin.
      799   end.
      800    if  log-manager:logfile-name ne ?
      801     then DO:
      802         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      803         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      804         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      805     end.
      806   on choose of B-WaitFramStop in frame waitfram
      807   do:
      808     mWaitFramStop = yes.
      809     mWaitFramStopUser = yes.
      810   end.
      811   function waitfram-check-timeout returns logical():
      812      define variable vtime as int64 no-undo.
      813      if mWaitFramStopTimeOut
      814      then
      815         return yes.
      816      vtime = ( now - mWaitFramStartProc ) / 1000 .
      817      if     mWaitFramTimeOut ne ?
      818         and mWaitFramTimeOut ne 0
      819         and mWaitFramTimeOut lt vtime
      820      then do:
      821         mWaitFramStopTimeOut = yes.
      822      end.
      823      return mWaitFramStopTimeOut.
      824   end.
      825   procedure waitfram-hide :
      826     if not session:batch-mode
      827     then do
      828     on error undo, return error return-value
      829     :
      830       pause 0 before-hide .
      831       if not mBatchMode then
      832         hide frame waitfram .
      833     if     not mWaitFramView
      834        and mWaitProcEvent
      835     then
      836       process events .
      837     end.
      838   end procedure.
      839   procedure waitfram-show :
      840     define input  parameter p-message as character no-undo .
      841     define variable v-left-margin as integer   no-undo .
      842     if not session:batch-mode
      843     then do
      844     on error undo, return error return-value
      845     :
      846       if length(p-message) <= 70 then do:
      847         assign
      848           v-left-margin = integer((70 - length(p-message)) / 2)
      849         .
      850         assign
      851           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      852         .
      853         assign
      854           v-waitfram-action01 = " "
      855           v-waitfram-action02 = " "
      856                                    + fill(" ", v-left-margin)
      857                                    + p-message
      858           v-waitfram-action03 = " "
      859         .
      860       end.
      861       else do:
      862         define variable vRindex1 as integer no-undo.
      863         define variable vRindex2 as integer no-undo.
      864         vRindex1 = r-index(p-message," ",70).
      865         if vRindex1 = 0
      866         then
      867            vRindex1 = 70.
      868         if length(p-message)  <= vRindex1 + 70 then do:
      869           assign
      870             v-waitfram-action01 = " "
      871             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      872             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      873           .
      874         end.
      875         else do:
      876           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      877           if vRindex2 <= vRindex1
      878           then
      879              vRindex2 = vRindex1 + 70.
      880           assign
      881             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      882             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      883             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      884           .
      885         end.
      886       end.
      887       B-viewProcInfo:visible   in frame waitfram = no.
      888       B-viewProcInfo:sensitive in frame waitfram = no.
      889       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      890       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      891       if  (   mWaitFramView
      892          or  mWaitProcEvent)
      893          and not mBatchMode
      894       then
      895          display
      896             v-waitfram-action01 skip
      897             v-waitfram-action02 skip
      898             v-waitfram-action03 skip
      899          with frame waitfram .
      900       if     mWaitFramView
      901          then do:
      902             if     mWaitFramInterval ne ?
      903                and not mBatchMode
      904             then
      905                wait-for go of frame waitfram pause mWaitFramInterval.
      906          end.
      907          else
      908             if     mWaitProcEvent
      909                and not mBatchMode
      910             then
      911                process events .
      912     end.
      913   end procedure.
      914      procedure waitfram-show-this:
      915         define input  parameter iInterval as int64 no-undo.
      916         define variable vtime as int64 no-undo.
      917         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      918         mWaitFramInterval = iInterval.
      919         run waitfram-show (substitute("&1&2 &3&4" ,
      920                                       mWaitFramTextBeg ,
      921                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      922                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      923                                       mWaitFramTextEnd
      924                                      )
      925                           ).
      926      end.
      927      procedure WaitFramRunPause:
      928         define input  parameter iInterval as dec no-undo.
      929         define variable vStart  as datetime-tz no-undo.
      930         define variable vend    as datetime-tz no-undo.
      931         define variable vint as int64 no-undo.
      932         define variable vOk as logical no-undo.
      933         vStart = now.
      934         vend   = vStart.
      935         publish "WaitFramPause" (iInterval,output vOk).
      936         vend   =  now.
      937         vint = vend - vStart.
      938         vint = iInterval - vint / 1000.
      939         if     not mWaitFramStop
      940            and (   vint > 0
      941                 or (    not vOk
      942                     and iInterval eq ?
      943                     )
      944                 )
      945         then
      946            run waitfram-show-this (iInterval).
      947         vend   =  now.
      948         vint = vend - vStart.
      949         vint = iInterval - vint / 1000.
      950         if     not mWaitFramStop
      951            and vint > 0
      952         then do:
      953            run gbl/pause.p (vint * 1000).
      954         end.
      955         if iInterval ne ?
      956         then
      957            publish "WaitFramStop".
      958         waitfram-check-timeout().
      959      end.
      960      procedure WaitFramWaitFor:
      961         define input  parameter iInterval as dec no-undo.
      962         assign
      963            mWaitFramStartProc   = now
      964            mWaitFramStopUser    = no
      965            mWaitFramStopTimeOut = no
      966         .
      967         block-wait:
      968         do while not mWaitFramStop:
      969            run WaitFramRunPause (iInterval).
      970            if  waitfram-check-timeout()
      971            then do:
      972               leave block-wait.
      973            end.
      974         end.
      975         run waitfram-hide.
      976      end.
      977   procedure waitfram-join :
      978     define input  parameter p-line-1  as character no-undo .
      979     define input  parameter p-line-2  as character no-undo .
      980     define input  parameter p-line-3  as character no-undo .
      981     define output parameter p-message as character no-undo .
      982     do
      983     on error undo, return error return-value
      984     :
      985       assign
      986         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      987                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      988                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      989       .
      990     end.
      991   end procedure.
      992   function waitfram-join-function returns character
      993     (input p-line-1 as character
      994     ,input p-line-2 as character
      995     ,input p-line-3 as character
      996     ).
      997     define variable v-message as character no-undo .
      998     run waitfram-join in this-procedure
      999       (input  p-line-1
     1000       ,input  p-line-2
     1001       ,input  p-line-3
     1002       ,output v-message
     1003       ) .
     1004     return v-message .
     1005   end function .
