     6710                                                                                    else if bf_tt-itog.obj-type = "zzz":U then if p-begin then  "Остаток на начало периода"
     6711                                                                                                                                          else  "Остаток на конец периода"
     6712                                                                                                                          else bf_tt-itog.obj-name
     6713                                                                                          format "X(50)"  .
     6714         if bf_tt-itog.vat-pc = "":U then do :
     6715             if tt-itog.obj-type = "zzz":U then do :
     6716                 if p-begin then do :
     6717                     run macr_excel_char_with_format in this-procedure (input "Остаток на начало периода", input num#str#, input num#col# ) .
     6718                 end.
     6719                 else do :
     6720                     run macr_excel_char_with_format in this-procedure (input "Остаток на конец периода", input num#str#, input num#col# ) .
     6721                 end.
     6722             end.
     6723             else do :
     6724                     run macr_excel_char_with_format in this-procedure (input bf_tt-itog.obj-name, input num#str#, input num#col# ) .
     6725             end.
     6726         end.
