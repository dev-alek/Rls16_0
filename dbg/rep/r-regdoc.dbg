     4678   define variable v-host-code-1        like ub.clients.host-code no-undo .
     4679   define variable v-host-code-2        like ub.clients.host-code no-undo .
     4680   define variable v-log    as logical   no-undo.
     4681   define variable v-col-1  as integer   no-undo .
     4682   define variable v-col-2  as integer   no-undo .
     4683   define variable v-col-3  as integer   no-undo .
