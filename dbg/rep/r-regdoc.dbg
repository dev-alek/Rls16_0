      233   procedure create_obj-list :
      234      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      235      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      236      do
      237      on error undo, return error return-value
      238      :
      239         define buffer cli-obj for ub.clients .
      240         define variable p-var as integer no-undo .
      241         define buffer buf_obj-list for obj-list .
      242         find last buf_obj-list  use-index pi no-error .
      243         if available buf_obj-list
      244         then
      245            p-var = buf_obj-list.obj-id + 1.
      246         else
      247            p-var = 1.
      248         find first cli-obj where
      249                   cli-obj.obj-type = p-obj-type
      250               and cli-obj.obj-code = p-obj-code
      251         no-lock no-error.
      252         if available cli-obj
      253         then do:
      254            create buf_obj-list.
      255            assign
      256               buf_obj-list.obj-id   = p-var
      257               buf_obj-list.obj-code = cli-obj.obj-code
      258               buf_obj-list.obj-type = cli-obj.obj-type
      259               buf_obj-list.obj-name = cli-obj.obj-name
      260               buf_obj-list.db-num   = cli-obj.db-num
      261            .
      262         end.
      263      end.
      264   end.
