     6374   procedure update-line :
     6375   DEFINE PARAMETER BUFFER buf_tt-all for tt-all.
     6376   define input parameter p-doc-type as character  no-undo.
     6377   define input parameter p-qnty     as decimal    no-undo.
     6378   define input parameter p-price    as decimal    no-undo.
     6379   define input parameter p-doc-code as character  no-undo.
     6380   do
     6381   on error undo, return error
     6382   :
     6383      define buffer buf_tt-allsum-line    for tt-allsum-line .
     6384      find first buf_tt-allsum-line
     6385         where buf_tt-allsum-line.sum-type = 'основная_сумма_со_знаком':U
     6386         no-error .
     6387      if available buf_tt-allsum-line
     6388      then do:
     6389         if p-doc-type <> 'ot':U
     6390         then do:
     6391            assign
     6392               buf_tt-all.col09-qnty                = buf_tt-all.col09-qnty             + buf_tt-allsum-line.fact-qnty
     6393               buf_tt-all.col10-SumWithNDS-coast    = buf_tt-all.col10-SumWithNDS-coast + if tPrintRubl then buf_tt-allsum-line.sum-dsc-rubl-acc else buf_tt-allsum-line.sum-dsc-base-acc
     6394               buf_tt-all.col11-VAT-Sum-coast       = buf_tt-all.col11-VAT-Sum-coast    + if tPrintRubl then buf_tt-allsum-line.vat-rubl-acc     else buf_tt-allsum-line.vat-base-acc
     6395               buf_tt-all.col12-SumWithoutNDS-coast = buf_tt-all.col10-SumWithNDS-coast - buf_tt-all.col11-VAT-Sum-coast
     6396               buf_tt-all.col13-SumWithNDS          = buf_tt-all.col13-SumWithNDS       + if tPrintRubl then buf_tt-allsum-line.sum-dsc-rubl-doc else buf_tt-allsum-line.sum-dsc-base-doc
     6397               buf_tt-all.col14-VAT-Sum             = buf_tt-all.col14-VAT-Sum          + if tPrintRubl then buf_tt-allsum-line.vat-rubl-doc     else buf_tt-allsum-line.vat-base-doc
     6398               buf_tt-all.col15-SumWithoutNDS       = buf_tt-all.col13-SumWithNDS       - buf_tt-all.col14-VAT-Sum
     6399               buf_tt-all.col16-SumWithNDS-sp       = buf_tt-all.col16-SumWithNDS-sp    + if tPrintRubl then buf_tt-allsum-line.sum-dsc-rubl-cur else buf_tt-allsum-line.sum-dsc-base-cur
     6400               buf_tt-all.col17-VAT-Sum-sp          = buf_tt-all.col17-VAT-Sum-sp       + if tPrintRubl then buf_tt-allsum-line.vat-rubl-cur     else buf_tt-allsum-line.vat-base-cur
     6401               buf_tt-all.col18-SumWithoutNDS-sp    = buf_tt-all.col16-SumWithNDS-sp    - buf_tt-all.col17-VAT-Sum-sp
     6402               buf_tt-all.col20-SumWithNDS-disp     = buf_tt-all.col16-SumWithNDS-sp    - buf_tt-all.col12-SumWithoutNDS-coast
     6403               buf_tt-all.col21-SumWithoutNDS-disp  = buf_tt-all.col15-SumWithoutNDS    - buf_tt-all.col12-SumWithoutNDS-coast
     6404            .
     6405         end.
     6406         else do:
     6407            assign
     6408               buf_tt-all.col16-SumWithNDS-sp       = buf_tt-all.col16-SumWithNDS-sp      + p-qnty * p-price
     6409            .
     6410         end.
     6411      end.
     6412   end.
     6413   end procedure.
     6414   procedure print-header :
     6415     define buffer buf_clients   for ub.clients.
     6416   do
     6417   on error undo, return error return-value
     6418   :
     6419      find first obj-list no-error .
     6420      if not available obj-list
     6421      then do:
     6422         message
     6423            "Не указан объект для формирования отчета!"
     6424         view-as alert-box error.
     6425         undo, return error.
     6426      end.
     6427   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6428   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     6429     (input  x-store-type
     6430     ,input  x-store-code
     6431     ,output v-host-code-1
     6432     )  .
     6433      for each obj-list :
     6434   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6435   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     6436     (input  obj-list.obj-type
     6437     ,input  obj-list.obj-code
     6438     ,output v-host-code-2
     6439     )  .
     6440         if v-host-code-1 <> v-host-code-2 then do:
     6441            message
     6442            "Отчет формируется по объектам одной фирмы!"
     6443            view-as alert-box error.
     6444            undo, return error.
     6445         end.
     6446      end.
     6447      find first  buf_clients
     6448           where  buf_clients.obj-type = 'орг':U
     6449           and    buf_clients.obj-code = v-host-code-1
     6450           no-lock
     6451           no-error
     6452           .
     6453      if not available buf_clients
     6454      then do :
     6455         message
     6456            "Не найдена фирма с кодом " v-host-code-1 skip
     6457            "Отчет не может быть сформирован"
     6458         view-as alert-box error.
     6459         return error.
     6460      end.
     6461      run fmtcli-get-client in this-procedure ( input  buf_clients.obj-type , input buf_clients.obj-code ).
     6462      PUT stream OutStream unformatted string(v-fmtcli-name) format "x(50)" skip .
     6463      assign
     6464       num#str# = 1
     6465       num#col# = 1
     6466       v-ind = 1
     6467      .
     6468    end.
     6469    end procedure.
     6470   procedure put-line :
     6471   define variable v-out as character no-undo.
     6472   do
     6473   on error undo, return error
     6474   :
     6475      assign
     6476         num#col# = 0
     6477         num#str# = num#str# + 1
     6478      .
     6479      if v-col01 = yes then do :
