     3213     (input  bf_trn-doc.obj-type
     3214     ,input  bf_trn-doc.obj-code
     3215     ,input  varb-code
     3216     ,input  0
     3217     ,input  bf_trn-doc.fact-order
     3218     ,output vardoc-num
     3219     ,output varprice-sale
     3220     ,output varroad-tax
     3221     ,output varexcise
     3222     )  .
     3223             if varprice-sale = ?
     3224             then do:
     3225               assign
     3226                 varprice-sale = 0
     3227                 varroad-tax   = 0
     3228                 varexcise     = 0
     3229               .
     3230             end.
     3231             assign
     3232               varlastcur-base     = varprice-sale
     3233               varlastcur-road-tax = varroad-tax
     3234               varlastcur-excise   = varexcise
     3235               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     3236               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     3237               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     3238               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     3239             .
     3240         end.
     3241       end.
     3242       if varcur-fact-qnty = 0 then do:
     3243         assign
     3244           varcur-base      = varlastcur-base
     3245           varcur-road-tax  = varlastcur-road-tax
     3246           varcur-excise    = varlastcur-excise
     3247         .
     3248       end.
     3249       else do:
     3250         assign
     3251           varcur-base      = varcur-base      / varcur-fact-qnty
     3252           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     3253           varcur-excise    = varcur-excise    / varcur-fact-qnty
     3254         .
     3255       end.
     3256       if varcur-vat-pc = ?
     3257       then do:
     3258         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     3259       end.
