     6268               tt-all.obj-code = 0
     6269               tt-all.col02-num = "zzz":U
     6270               tt-all.doc-type = p-doc-type
     6271               tt-all.col08-VAT-PC   = p-vat-pc
     6272               tt-all.col07-clients        =  "":U
     6273            .
     6274         end.
     6275         RUN update-line ( BUFFER tt-all , INPUT p-doc-type, INPUT p-qnty , INPUT p-price, INPUT p-doc-code).
     6276      end.
     6277      find first tt-all
     6278         where tt-all.obj-type = "zzz":U
     6279           and tt-all.obj-code = 0
     6280           and tt-all.col02-num = "zzz":U
     6281           and tt-all.doc-type = "zzz":U
     6282           and tt-all.col08-VAT-PC   = -1
     6283         NO-ERROR.
