     1024   define variable v-fmtcli-bank-bik      as character    no-undo.
     1025   define variable v-fmtcli-bank-name     as character    no-undo.
     1026   define variable v-fmtcli-bank-addres   as character    no-undo.
     1027   define variable v-fmtcli-bank-city     as character    no-undo.
     1028   procedure fmtcli-get-bank :
     1029   define input parameter p-host-code      as integer          no-undo.
     1030   define input parameter p-obj-type       as character        no-undo.
     1031   define input parameter p-obj-code       as integer          no-undo.
     1032   define input parameter p-curr-code      as integer          no-undo.
     1033       define buffer buf_fin-schet     for ub.fin-schet.
     1034       define buffer buf_fin-bank      for ub.fin-bank.
     1035   do
     1036   for buf_fin-schet
     1037     , buf_fin-bank
     1038   on error undo, return error
     1039   :
     1040       assign
     1041           v-fmtcli-schet-exists       = no
     1042           v-fmtcli-bank-exists        = no
     1043           v-fmtcli-bank-r-schet       = "":U
     1044           v-fmtcli-bank-c-schet       = "":U
     1045           v-fmtcli-bank-bik           = "":U
     1046           v-fmtcli-bank-name          = "":U
     1047           v-fmtcli-bank-addres        = "":U
     1048           v-fmtcli-bank-city          = "":U
     1049       .
     1050       search-for-schet:
     1051       for each buf_fin-schet no-lock
     1052          where buf_fin-schet.host-code = p-host-code
     1053            and buf_fin-schet.cli-type  = p-obj-type
     1054            and buf_fin-schet.cli-code  = p-obj-code
     1055            and buf_fin-schet.curr-code = p-curr-code
     1056       on error undo, return error
     1057       :
     1058           if buf_fin-schet.status_   = 'удал':U
     1059           then do:
     1060           end.
     1061           else do:
     1062               assign
     1063                   v-fmtcli-schet-exists   = yes
     1064                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
     1065                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
     1066               .
     1067               find first buf_fin-bank no-lock
     1068                    where buf_fin-bank.host-code = p-host-code
     1069                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
     1070               no-error.
     1071               if available buf_fin-bank
     1072               then do:
     1073                   assign
     1074                       v-fmtcli-bank-exists      = yes
     1075                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
     1076                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
     1077                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
     1078                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
     1079                   .
     1080               end.
     1081               else do:
     1082                   assign
     1083                       v-fmtcli-bank-exists    = no
     1084                       v-fmtcli-bank-bik       = "":U
     1085                       v-fmtcli-bank-name      = "":U
     1086                       v-fmtcli-bank-addres    = "":U
     1087                       v-fmtcli-bank-city      = "":U
     1088                   .
     1089               end.
     1090               leave search-for-schet.
     1091           end.
     1092       end.
     1093   end.
     1094   end procedure.
     1095   procedure fmtcli-get-client :
     1096   define input parameter p-obj-type       as character    no-undo.
     1097   define input parameter p-obj-code       as integer      no-undo.
     1098       define variable v-temp-fmtcli-address      as character     no-undo.
     1099       define variable v-num-country-city    as integer      no-undo.
     1100       define buffer buf_clients   for ub.clients.
     1101       define buffer buf_firm      for ub.firm.
     1102       define buffer buf_store     for ub.store.
     1103       define buffer buf_shop      for ub.shop.
     1104       define buffer buf_person    for ub.person.
     1105   do
     1106   for buf_clients
     1107     , buf_firm
     1108     , buf_store
     1109     , buf_shop
     1110     , buf_person
     1111   on error undo, return error
     1112   :
     1113       assign
     1114           v-fmtcli-name           = "":U
     1115           v-fmtcli-addres         = "":U
     1116           v-fmtcli-post-addres    = "":U
     1117           v-fmtcli-full-addres    = "":U
     1118           v-fmtcli-phone          = "":U
     1119           v-fmtcli-inn            = "":U
     1120           v-fmtcli-kpp            = "":U
     1121           v-fmtcli-okpo           = "":U
     1122           v-fmtcli-city           = "":U
     1123           v-fmtcli-index          = "":U
     1124           v-fmtcli-country        = "":U
     1125       .
     1126       find first buf_clients no-lock
     1127            where buf_clients.obj-type = p-obj-type
     1128              and buf_clients.obj-code = p-obj-code
     1129       .
     1130       assign
     1131           v-fmtcli-name = buf_clients.obj-name
     1132       .
     1133       case buf_clients.obj-type:
     1134          when 'орг':U
     1135          then do:
     1136               find first buf_firm no-lock
     1137                    where buf_firm.firm-code = buf_clients.obj-code
     1138                    no-error
     1139               .
     1140               if available buf_firm
     1141               then do:
     1142                   assign
     1143                       v-num-country-city = num-entries( buf_firm.city )
     1144                       v-fmtcli-engl-name = buf_firm.engl-name
     1145                   .
     1146                   if v-num-country-city > 0
     1147                   then do:
     1148                       assign
     1149                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
     1150                       .
     1151                   end.
     1152                   if v-num-country-city > 1
     1153                   then do:
     1154                       assign
     1155                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
     1156                       .
     1157                   end.
     1158                   run fmtcli-concatenate-strings in this-procedure (
     1159                         input v-fmtcli-full-addres
     1160                       , input v-fmtcli-country
     1161                       , input ", ":U
     1162                       , input 50
     1163                       , output v-fmtcli-full-addres
     1164                   ).
     1165                   run fmtcli-concatenate-strings in this-procedure (
     1166                         input v-fmtcli-full-addres
     1167                       , input v-fmtcli-city
     1168                       , input ", ":U
     1169                       , input 50
     1170                       , output v-fmtcli-full-addres
     1171                   ).
     1172                   run fmtcli-concatenate-strings in this-procedure (
     1173                         input v-fmtcli-full-addres
     1174                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
     1175                       , input ", ":U
     1176                       , input 50
     1177                       , output v-fmtcli-full-addres
     1178                   ).
     1179                   run fmtcli-concatenate-strings in this-procedure (
     1180                         input v-fmtcli-post-addres
     1181                       , input v-fmtcli-country
     1182                       , input ", ":U
     1183                       , input 50
     1184                       , output v-fmtcli-post-addres
     1185                   ).
     1186                   run fmtcli-concatenate-strings in this-procedure (
     1187                         input v-fmtcli-post-addres
     1188                       , input v-fmtcli-city
     1189                       , input ", ":U
     1190                       , input 50
     1191                       , output v-fmtcli-post-addres
     1192                   ).
     1193                   run fmtcli-concatenate-strings in this-procedure (
     1194                         input v-fmtcli-post-addres
     1195                       , input string( buf_firm.ind )
     1196                       , input ", ":U
     1197                       , input 50
     1198                       , output v-fmtcli-post-addres
     1199                   ).
     1200                   run fmtcli-concatenate-strings in this-procedure (
     1201                         input substring( buf_firm.addres1, 1, 50 )
     1202                       , input buf_firm.addres2
     1203                       , input " ":U
     1204                       , input 50
     1205                       , output v-temp-fmtcli-address
     1206                   ).
     1207                   run fmtcli-concatenate-strings in this-procedure (
     1208                         input v-temp-fmtcli-address
     1209                       , input substring( buf_firm.addres1, 51, 50 )
     1210                       , input " ":U
     1211                       , input 50
     1212                       , output v-temp-fmtcli-address
     1213                   ).
     1214                   run fmtcli-concatenate-strings in this-procedure (
     1215                         input v-temp-fmtcli-address
     1216                       , input substring( buf_firm.addres1, 101, 50 )
     1217                       , input " ":U
     1218                       , input 50
     1219                       , output v-temp-fmtcli-address
     1220                   ).
     1221                   assign
     1222                       v-fmtcli-addres = v-temp-fmtcli-address
     1223                   .
     1224                   if buf_firm.addres1 <> ?
     1225                   then do:
     1226                       run fmtcli-concatenate-strings in this-procedure (
     1227                             input v-fmtcli-full-addres
     1228                           , input v-fmtcli-addres
     1229                           , input ", ":U
     1230                           , input 0
     1231                           , output v-fmtcli-full-addres
     1232                       ).
     1233                   end.
     1234                   run fmtcli-concatenate-strings in this-procedure (
     1235                         input substring( buf_firm.post-addr1, 1, 50 )
     1236                       , input buf_firm.post-addr2
     1237                       , input " ":U
     1238                       , input 50
     1239                       , output v-fmtcli-post-addres
     1240                   ).
     1241                   run fmtcli-concatenate-strings in this-procedure (
     1242                         input v-fmtcli-post-addres
     1243                       , input substring( buf_firm.post-addr1, 51, 50 )
     1244                       , input " ":U
     1245                       , input 50
     1246                       , output v-fmtcli-post-addres
     1247                   ).
     1248                   run fmtcli-concatenate-strings in this-procedure (
     1249                         input v-fmtcli-post-addres
     1250                       , input substring( buf_firm.post-addr1, 101, 50 )
     1251                       , input " ":U
     1252                       , input 50
     1253                       , output v-fmtcli-post-addres
     1254                   ).
     1255                   assign
     1256                       v-fmtcli-phone         = buf_firm.phone
     1257                       v-fmtcli-inn           = buf_firm.inn
     1258                       v-fmtcli-kpp           = buf_firm.kpp
     1259                       v-fmtcli-okpo          = buf_firm.okpo
     1260                       v-fmtcli-index         = string( buf_firm.ind )
     1261                   .
     1262               end.
     1263          end.
     1264          when 'маг':U
     1265          then do:
     1266               find first buf_shop no-lock
     1267                    where buf_shop.obj-code = buf_clients.obj-code
     1268               .
     1269               if available buf_shop
     1270               then do:
     1271                   run fmtcli-concatenate-strings in this-procedure (
     1272                         input buf_shop.addres1
     1273                       , input buf_shop.addres2
     1274                       , input " ":U
     1275                       , input 50
     1276                       , output v-fmtcli-addres
     1277                   ).
     1278                   assign
     1279                       v-fmtcli-full-addres = v-fmtcli-addres
     1280                       v-fmtcli-post-addres = v-fmtcli-addres
     1281                       v-fmtcli-phone       = buf_shop.phone
     1282                       v-fmtcli-inn         = "":U
     1283                       v-fmtcli-kpp         = "":U
     1284                       v-fmtcli-okpo        = "":U
     1285                       v-fmtcli-city        = "":U
     1286                       v-fmtcli-index       = "":U
     1287                   .
     1288               end.
     1289          end.
     1290          when 'скл':U
     1291          then do:
     1292               find first buf_store no-lock
     1293                    where buf_store.obj-code = buf_clients.obj-code
     1294               .
     1295               if available buf_store
     1296               then do:
     1297                   run fmtcli-concatenate-strings in this-procedure (
     1298                         input buf_store.addres1
     1299                       , input buf_store.addres2
     1300                       , input " ":U
     1301                       , input 50
     1302                       , output v-fmtcli-addres
     1303                   ).
     1304                   assign
     1305                       v-fmtcli-full-addres = v-fmtcli-addres
     1306                       v-fmtcli-phone       = buf_store.phone
     1307                       v-fmtcli-inn         = "":U
     1308                       v-fmtcli-kpp         = "":U
     1309                       v-fmtcli-okpo        = "":U
     1310                       v-fmtcli-city        = "":U
     1311                       v-fmtcli-index       = "":U
     1312                   .
     1313               end.
     1314          end.
     1315          when 'чел':U
     1316          then do:
     1317               find first buf_person no-lock
     1318                    where buf_person.psn-code = buf_clients.obj-code
     1319               .
     1320               if available buf_person
     1321               then do:
     1322                   run fmtcli-concatenate-strings in this-procedure (
     1323                         input ( if buf_person.ind = 0 or buf_person.ind = ?
     1324                                 then "":U
     1325                                 else string( buf_person.ind, "999999")
     1326                                 )
     1327                       , input buf_person.city
     1328                       , input ", ":U
     1329                       , input 0
     1330                       , output v-fmtcli-full-addres
     1331                   ).
     1332                   assign
     1333                       v-fmtcli-addres = buf_person.address
     1334                   .
     1335                   run fmtcli-concatenate-strings in this-procedure (
     1336                         input v-fmtcli-full-addres
     1337                       , input v-fmtcli-addres
     1338                       , input ", ":U
     1339                       , input 0
     1340                       , output v-fmtcli-full-addres
     1341                   ).
     1342                   assign
     1343                       v-fmtcli-phone     = buf_person.phone1
     1344                       v-fmtcli-inn       = buf_person.inn
     1345                       v-fmtcli-kpp       = buf_person.kpp
     1346                       v-fmtcli-okpo      = buf_person.okpo
     1347                       v-fmtcli-city      = buf_person.city
     1348                       v-fmtcli-index     = string( buf_person.ind )
     1349                   .
     1350               end.
     1351          end.
     1352       end case.
     1353   end.
     1354   end procedure.
     1355   procedure fmtcli-concatenate-strings :
     1356   define input parameter p-string-1       as character        no-undo.
     1357   define input parameter p-string-2       as character        no-undo.
     1358   define input parameter p-delimiter      as character        no-undo.
     1359   define input parameter p-length         as integer          no-undo.
     1360   define output parameter p-out-string    as character        no-undo.
     1361   do
     1362   on error undo, return error
     1363   :
     1364       assign
     1365           p-out-string = ( if p-string-1 = ?
     1366                            then "":U
     1367                            else trim( p-string-1 ) )
     1368       .
     1369       assign
     1370           p-out-string = p-out-string
     1371                        + ( if p-out-string = "":U
     1372                            or length( p-out-string ) = p-length
     1373                            or p-string-2 = ?
     1374                            or trim( p-string-2 ) = "":U
     1375                            then "":U
     1376                            else p-delimiter )
     1377                        + ( if p-string-2 = ?
     1378                            or trim( p-string-2 ) = "":U
     1379                            then "":U
     1380                            else trim( p-string-2 ) )
     1381       .
     1382   end.
     1383   end procedure.
     1384   define variable vss-include-info13 as character format "X(65)" no-undo
     1385   initial "@(#)$Workfile$ $Revision$".
     1386   procedure grplib-get-full-name :
     1387      define input parameter p-node-code  as integer      no-undo.
     1388      define output parameter p-full-name as character    no-undo.
     1389      do
     1390   on error undo, return error
     1391   :
     1392       define variable v-upper-code    as integer           no-undo.
     1393       define buffer buf_gds-grp       for ub.gds-grp.
     1394       define buffer buf_upper_gds-grp for ub.gds-grp.
     1395       find first buf_gds-grp no-lock
     1396            where buf_gds-grp.node-code = p-node-code
     1397       no-error.
     1398       if not available buf_gds-grp
     1399       then do:
     1400           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1401       end.
     1402       assign
     1403           p-full-name  = ""
     1404           v-upper-code = 1
     1405       .
     1406       do while buf_gds-grp.upper-code <> 0
     1407       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1408       :
     1409           assign
     1410               p-full-name  = buf_gds-grp.node-name
     1411                            + (if p-full-name <> "" then chr(47) else "")
     1412                            + p-full-name
     1413               v-upper-code = buf_gds-grp.upper-code
     1414           .
     1415           find first buf_gds-grp no-lock
     1416                where buf_gds-grp.node-code = v-upper-code
     1417           no-error.
     1418           if not available buf_gds-grp
     1419           then do:
     1420               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     1421                                   + string( v-upper-code )
     1422                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1423           end.
     1424       end.
     1425       assign
     1426       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1427       .
     1428   end.
     1429   end .
     1430   procedure grplib-get-node-from-full-name :
     1431   define input parameter p-full-name as character no-undo .
     1432   define output parameter p-node-code as integer no-undo .
     1433   define variable v-ii as integer no-undo .
     1434   define variable v-upper-code as integer no-undo .
     1435   define variable v-root-code as integer no-undo .
     1436   define variable v-entry as character no-undo .
     1437   define buffer buf_gds-grp       for ub.gds-grp.
     1438   do
     1439   on error undo, return error
     1440   :
     1441     find first buf_gds-grp no-lock
     1442         where buf_gds-grp.upper-code = 0
     1443     no-error .
     1444     if not available buf_gds-grp
     1445     then do:
     1446         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     1447     end.
     1448     else do:
     1449       assign
     1450       v-root-code = buf_gds-grp.node-code
     1451       .
     1452     end.
     1453     v-upper-code = v-root-code.
     1454     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1455       assign
     1456       v-entry = entry(v-ii, p-full-name, chr(47)).
     1457       if v-entry = '' then leave.
     1458       find first buf_gds-grp no-lock where
     1459                 buf_gds-grp.node-name = v-entry
     1460             and buf_gds-grp.upper-code = v-upper-code
     1461             no-error.
     1462       if not available buf_gds-grp then do:
     1463         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1464       end.
     1465       else do:
     1466         p-node-code = buf_gds-grp.node-code.
     1467         v-upper-code = buf_gds-grp.node-code.
     1468       end.
     1469     end.
     1470   end.
     1471   end .
     1472   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1473   define new global shared variable g#trdcalib as handle no-undo.
     1474   def var vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1475   define new global shared variable g#lib-trn  as handle no-undo .
     1476   define new global shared variable g#lib-trn2 as handle no-undo .
     1477   define new global shared variable g#lib-trn3 as handle no-undo .
     1478   define new global shared variable g#lib-trn4 as handle no-undo .
     1479   define temp-table tt-allsum-line      no-undo
     1480   field sum-type           as   character
     1481   field fact-qnty          like ub.doc-line.fact-qnty
     1482   field cli-qnty           like ub.doc-line.cli-qnty
     1483   field sum-dsc-base-doc   like ub.doc-line.price-base
     1484   field sum-dsc-rubl-doc   like ub.doc-line.price-base
     1485   field dsc-base-doc       like ub.doc-line.price-base
     1486   field dsc-rubl-doc       like ub.doc-line.price-base
     1487   field vat-base-doc       like ub.doc-line.price-base
     1488   field vat-rubl-doc       like ub.doc-line.price-base
     1489   field vat-base-buyer-doc like ub.doc-line.price-base
     1490   field vat-rubl-buyer-doc like ub.doc-line.price-base
     1491   field slt-base-doc       like ub.doc-line.price-base
     1492   field slt-rubl-doc       like ub.doc-line.price-base
     1493   field road-tax-base-doc  like ub.doc-line.price-base
     1494   field road-tax-rubl-doc  like ub.doc-line.price-base
     1495   field excise-base-doc    like ub.doc-line.price-base
     1496   field excise-rubl-doc    like ub.doc-line.price-base
     1497   field sum-dsc-base-acc   like ub.doc-line.price-base
     1498   field sum-dsc-rubl-acc   like ub.doc-line.price-base
     1499   field sum-dsc-cli-acc    like ub.doc-line.price-cli
     1500   field dsc-base-acc       like ub.doc-line.price-base
     1501   field dsc-rubl-acc       like ub.doc-line.price-base
     1502   field dsc-cli-acc        like ub.doc-line.price-cli
     1503   field vat-base-acc       like ub.doc-line.price-base
     1504   field vat-rubl-acc       like ub.doc-line.price-base
     1505   field vat-cli-acc        like ub.doc-line.price-cli
     1506   field slt-base-acc       like ub.doc-line.price-base
     1507   field slt-rubl-acc       like ub.doc-line.price-base
     1508   field slt-cli-acc        like ub.doc-line.price-cli
     1509   field road-tax-base-acc  like ub.doc-line.price-base
     1510   field road-tax-rubl-acc  like ub.doc-line.price-base
     1511   field road-tax-cli-acc   like ub.doc-line.price-cli
     1512   field excise-base-acc    like ub.doc-line.price-base
     1513   field excise-rubl-acc    like ub.doc-line.price-base
     1514   field excise-cli-acc     like ub.doc-line.price-cli
     1515   field transport-base-acc like ub.doc-line.price-base
     1516   field transport-rubl-acc like ub.doc-line.price-base
     1517   field transport-cli-acc  like ub.doc-line.price-cli
     1518   field other-base-acc     like ub.doc-line.price-base
     1519   field other-rubl-acc     like ub.doc-line.price-base
     1520   field other-cli-acc      like ub.doc-line.price-cli
     1521   field sum-dsc-base-cur   like ub.doc-line.price-base
     1522   field sum-dsc-rubl-cur   like ub.doc-line.price-base
     1523   field dsc-base-cur       like ub.doc-line.price-base
     1524   field dsc-rubl-cur       like ub.doc-line.price-base
     1525   field vat-base-cur       like ub.doc-line.price-base
     1526   field vat-rubl-cur       like ub.doc-line.price-base
     1527   field vat-base-buyer-cur like ub.doc-line.price-base
     1528   field vat-rubl-buyer-cur like ub.doc-line.price-base
     1529   field slt-base-cur       like ub.doc-line.price-base
