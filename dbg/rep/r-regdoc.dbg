     3495   end.
     3496   end.
     3497   end procedure.
     3498   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3499   procedure factord :
     3500     define input  parameter p-fact-date            as date    no-undo .
     3501     define input  parameter p-fact-time            as integer no-undo .
     3502     define input  parameter p-fact-num             as integer no-undo .
     3503     define input  parameter p-shift-date           as date    no-undo .
     3504     define input  parameter p-shift-num            as integer no-undo .
     3505     define input  parameter p-shift-on             as logical no-undo .
     3506     define output parameter p-fact-order           as decimal no-undo .
     3507     define output parameter p-shift-end-fact-order as decimal no-undo .
     3508     define output parameter p-day-end-fact-order   as decimal no-undo .
     3509     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     3510     if p-fact-date = ?
     3511     then do:
     3512       return error "Не указана фактическая дата" .
     3513     end.
     3514     define variable v-fact-date-num as integer no-undo .
     3515     assign
     3516       v-fact-date-num = integer(p-fact-date)
     3517     .
     3518     if p-fact-num = ?
     3519     or p-fact-num = 0
     3520     then do:
     3521       return error "Не задан p-fact-num " + string(p-fact-num) .
     3522     end.
     3523     if p-fact-num < 0
     3524     then do:
     3525       return error "Отрицательный fact-num " + string(p-fact-num) .
     3526     end.
     3527     if p-fact-num >= 100000000
     3528     then do:
     3529       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     3530     end.
     3531     if p-shift-on = true
     3532     then do:
     3533       if p-shift-date = ?
     3534       then do:
     3535         return error "Не задана дата смены" .
     3536       end.
     3537       if p-shift-num = ?
     3538       or p-shift-num = 0
     3539       then do:
     3540         return error "Не задан номер смены" .
     3541       end.
     3542     end.
     3543     else do:
     3544       assign
     3545         p-shift-date = p-fact-date
     3546         p-shift-num  = 24
     3547       .
     3548     end.
     3549     define variable v-shift-offset as integer no-undo .
     3550     if p-shift-date = p-fact-date
     3551     then do:
     3552       assign
     3553         v-shift-offset = 1
     3554       .
     3555     end.
     3556     if p-shift-date < p-fact-date
     3557     then do:
     3558       assign
     3559         v-shift-offset = 0
     3560       .
     3561     end.
     3562     if p-shift-date > p-fact-date
     3563     then do:
     3564       message
     3565         vss-workfile vss-revision vss-description skip
     3566         "Неправильная дата закрытия смены" skip
     3567         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     3568         view-as alert-box error .
     3569       undo, return error
     3570         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     3571           ,string(p-fact-date, '99/99/9999':U)
     3572           ,string(p-shift-date, '99/99/9999':U)
     3573           )
     3574       .
     3575     end.
     3576     if p-shift-num < 1
     3577     or p-shift-num > 24
     3578     then do:
     3579       message
     3580         vss-workfile vss-revision vss-description skip
     3581         "Неправильный номер смены" skip
     3582         "p-shift-num" p-shift-num skip
     3583         view-as alert-box error .
     3584       undo, return error return-value .
     3585     end.
     3586     assign
     3587       p-fact-order           = v-fact-date-num
     3588                              + v-shift-offset * 0.5
     3589                              + p-shift-num    * 0.02 - 0.01
     3590                              + p-fact-num     * 0.0000000001
     3591       p-shift-end-fact-order = v-fact-date-num
     3592                              + v-shift-offset * 0.5
     3593                              + p-shift-num    * 0.02
     3594       p-day-end-fact-order   = v-fact-date-num
     3595                              + 0.99
     3596     .
     3597     if p-fact-order           <= v-fact-date-num
     3598     or p-shift-end-fact-order <= v-fact-date-num
     3599     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     3600     or p-shift-end-fact-order >= p-day-end-fact-order
     3601     then do:
     3602       message
     3603         vss-workfile vss-revision vss-description skip
     3604         "Внутренняя ошибка при генерации фактического номера" skip
     3605         "p-fact-date"            p-fact-date            skip
     3606         "p-fact-time"            p-fact-time            skip
     3607         "p-fact-num"             p-fact-num             skip
     3608         "p-shift-date"           p-shift-date           skip
     3609         "p-shift-num"            p-shift-num            skip
     3610         "p-shift-on"             p-shift-on             skip
     3611         "p-shift-end-fact-order" p-shift-end-fact-order skip
     3612         "p-day-end-fact-order"   p-day-end-fact-order   skip
     3613         "v-fact-date-num"        v-fact-date-num        skip
     3614         view-as alert-box error .
     3615       undo, return error return-value .
     3616     end.
     3617   end procedure.
     3618   procedure day-begin-fact-order :
     3619     define input  parameter p-fact-date            as date    no-undo .
     3620     define output parameter p-day-begin-fact-order as decimal no-undo .
     3621     do
     3622     on error undo, return error return-value
     3623     :
     3624       if p-fact-date = ?
     3625       then do:
     3626         assign
     3627           p-day-begin-fact-order = 0
     3628         .
     3629       end.
     3630       else do:
     3631         assign
     3632           p-day-begin-fact-order = integer(p-fact-date)
     3633         .
     3634       end.
     3635     end.
     3636   end procedure.
     3637   procedure factord-max-fact-order :
     3638     define output parameter p-max-fact-order as decimal   no-undo .
     3639     do
     3640     on error undo, return error return-value
     3641     :
     3642       run day-begin-fact-order in this-procedure
     3643         (input  date(1, 1, 5000)
     3644         ,output p-max-fact-order
     3645         ) .
     3646     end.
     3647   end procedure.
     3648   procedure factord-cut-archive :
     3649     define input  parameter p-obj-type             as character no-undo .
     3650     define input  parameter p-obj-code             as integer   no-undo .
     3651     define input  parameter p-fact-date            as date      no-undo .
     3652     define output parameter p-shift-on             as logical   no-undo .
     3653     define output parameter p-shift-date           as date      no-undo .
     3654     define output parameter p-shift-num            as integer   no-undo .
     3655     define output parameter p-day-end-fact-order   as decimal   no-undo .
     3656     define output parameter p-shift-end-fact-order as decimal   no-undo .
     3657     define variable v-fact-order as decimal   no-undo .
     3658     define buffer buf_shift-obj for ub.shift-obj .
     3659     do
     3660     on error undo, return error return-value
     3661     :
     3662   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3663   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     3664     (input  p-obj-type
     3665     ,input  p-obj-code
     3666     ,input  'shift-on=request'
     3667     ,output p-shift-on
     3668     ) no-error .
     3669       if error-status :error
     3670       then do:
     3671         message
     3672           vss-workfile vss-revision vss-description skip
     3673           "Ошибка при определении атрибута объекта" skip
     3674           "Объект" p-obj-type p-obj-code skip
     3675           error-status :get-message(1) skip
     3676           return-value skip
     3677           view-as alert-box error .
     3678         undo, return error return-value .
     3679       end.
     3680       if p-shift-on = false
     3681       then do:
     3682         assign
     3683           p-shift-date               = ?
     3684           p-shift-num                = 0
     3685         .
     3686       end.
     3687       else do:
     3688         find first buf_shift-obj share-lock
     3689           where buf_shift-obj.obj-type   = p-obj-type
     3690             and buf_shift-obj.obj-code   = p-obj-code
     3691             and buf_shift-obj.shift-date > p-fact-date
     3692           use-index pi
     3693           no-error .
     3694         if not available buf_shift-obj
     3695         or buf_shift-obj.status_ <> 'зкр':U
     3696         then do:
     3697           message
     3698             vss-workfile vss-revision vss-description skip
     3699             "Невозможно вычислить последнюю смену" skip
     3700             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     3701             "Объект" p-obj-type p-obj-code skip
     3702             "Дата" p-fact-date skip
     3703             view-as alert-box error .
     3704           undo, return error return-value .
     3705         end.
     3706         find last buf_shift-obj share-lock
     3707           where buf_shift-obj.obj-type = p-obj-type
     3708             and buf_shift-obj.obj-code = p-obj-code
     3709             and buf_shift-obj.shift-date <= p-fact-date
     3710           use-index pi
     3711           no-error .
     3712         if available buf_shift-obj
     3713         then do:
     3714           if  buf_shift-obj.status_ = 'зкр':U
     3715           then do:
     3716             assign
     3717               p-shift-date = buf_shift-obj.shift-date
     3718               p-shift-num  = buf_shift-obj.shift-num
     3719             .
     3720           end.
     3721           else do:
     3722             message
     3723               vss-workfile vss-revision vss-description skip
     3724               "Невозможно вычислить последнюю смену" skip
     3725               "Статус смены отличен от статуса" 'зкр':U skip
     3726               "Объект" p-obj-type p-obj-code skip
     3727               "Дата" p-fact-date skip
     3728               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     3729               view-as alert-box error .
     3730             undo, return error return-value .
     3731           end.
     3732         end.
     3733         else do:
     3734           assign
     3735             p-shift-date = p-fact-date - 1
     3736             p-shift-num  = 1
     3737           .
     3738         end.
     3739       end.
     3740       run factord in this-procedure
     3741         (input  p-fact-date
     3742         ,input  1
     3743         ,input  1
     3744         ,input  p-shift-date
     3745         ,input  p-shift-num
     3746         ,input  p-shift-on
     3747         ,output v-fact-order
     3748         ,output p-shift-end-fact-order
     3749         ,output p-day-end-fact-order
     3750         ) no-error .
     3751       if error-status :error
     3752       then do:
     3753         message
     3754           vss-workfile vss-revision vss-description skip
     3755           "Ошибка при вызове процедуры factord"
     3756           error-status :get-message(1) skip
     3757           return-value skip
     3758           view-as alert-box error .
     3759         undo, return error return-value .
     3760       end.
     3761     end.
     3762   end procedure.
     3763   procedure factord-lock-shift :
     3764     define input  parameter p-obj-type  as character no-undo .
     3765     define input  parameter p-obj-code  as integer   no-undo .
     3766     define input  parameter p-fact-date as date      no-undo .
     3767     define parameter buffer buf_shift-obj for ub.shift-obj .
     3768     define variable v-shift-on      as logical   no-undo .
     3769     define variable v-extra-message as character no-undo .
     3770     define variable v-error as character no-undo .
     3771     do
     3772     on error undo, return error return-value
     3773     :
     3774   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3775   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     3776     (input  p-obj-type
     3777     ,input  p-obj-code
     3778     ,input  'shift-on=request'
     3779     ,output v-shift-on
     3780     ) no-error .
     3781       if error-status :error
     3782       then do:
     3783         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     3784         undo, return error v-error .
     3785       end.
     3786       if v-shift-on = true
     3787       then do:
     3788         find first buf_shift-obj share-lock
     3789           where buf_shift-obj.obj-type   = p-obj-type
     3790             and buf_shift-obj.obj-code   = p-obj-code
     3791             and buf_shift-obj.shift-date > p-fact-date
     3792           use-index pi
     3793           no-error .
     3794         if not available buf_shift-obj
     3795         or buf_shift-obj.status_ <> 'зкр':U
     3796         then do:
     3797           find last buf_shift-obj
     3798             where buf_shift-obj.obj-type = p-obj-type
     3799               and buf_shift-obj.obj-code = p-obj-code
     3800               and buf_shift-obj.status_  = 'зкр':U
     3801             use-index stts
     3802             no-error .
     3803           if available buf_shift-obj
     3804           then do:
     3805             assign
     3806               v-extra-message =
     3807                     substitute("Дата начала последеней закрытой смены на объекте &1"
     3808                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     3809                               )
     3810             .
     3811           end.
     3812           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     3813           undo, return error v-error .
     3814         end.
     3815       end.
     3816     end.
     3817   end procedure.
     3818   procedure factord-end-day :
     3819     define input  parameter p-fact-date            as date    no-undo .
     3820     define output parameter p-day-end-fact-order   as decimal no-undo .
     3821     do
     3822     on error undo, return error return-value
     3823     :
     3824       if p-fact-date = ?
     3825       then do:
     3826         return error "Не указана фактическая дата" .
     3827       end.
     3828       assign
     3829         p-day-end-fact-order = integer(p-fact-date) + 0.99
     3830       .
     3831     end.
     3832   end procedure.
     3833   procedure factord-to-date :
     3834     define input  parameter p-fact-order as decimal no-undo .
     3835     define output parameter p-fact-date  as date    no-undo .
     3836     define variable v-ref-date  as date      no-undo .
     3837     define variable v-ref-delta as integer   no-undo .
     3838     do
     3839     on error undo, return error return-value
     3840     :
     3841       if p-fact-order = ?
     3842       or p-fact-order = 0
     3843       then do:
     3844         return error "Не указан fact-order" .
     3845       end.
     3846       assign
     3847         v-ref-date  = date(1, 1, 2000)
     3848       .
     3849       assign
     3850         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     3851       .
     3852       assign
     3853         p-fact-date = v-ref-date + v-ref-delta
     3854       .
     3855     end.
     3856   end procedure.
     3857   procedure factord-to-fact-num :
     3858     define input  parameter p-fact-order as decimal no-undo .
     3859     define output parameter p-fact-num   as integer no-undo .
     3860     define variable v-fact-order-trunc as decimal no-undo .
     3861     do
     3862     on error undo, return error return-value
     3863     :
     3864       if p-fact-order = ?
     3865       or p-fact-order = 0
     3866       then do:
     3867         return error "Не указан fact-order" .
     3868       end.
     3869       assign
     3870        v-fact-order-trunc = truncate(p-fact-order, 2)
     3871       .
     3872       assign
     3873         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     3874       .
     3875     end.
     3876   end procedure.
     3877   procedure factord-to-shift-num :
     3878     define input  parameter p-fact-order as decimal no-undo .
     3879     define output parameter p-shift-num   as integer no-undo .
     3880     define variable  p-shift-numd  as decimal   no-undo .
     3881     define variable v-fact-order-trunc as decimal no-undo .
     3882     do
     3883     on error undo, return error return-value
     3884     :
     3885       if p-fact-order = ?
     3886       or p-fact-order = 0
     3887       then do:
     3888         return error "Не указан fact-order" .
     3889       end.
     3890       assign
     3891        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     3892       .
     3893       if v-fact-order-trunc < 0.5 then do:
     3894         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     3895       end.
     3896       assign
     3897         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     3898         .
     3899        assign
     3900         p-shift-num = truncate (p-shift-numd , 0)
     3901       .
     3902     end.
     3903   end procedure.
     3904   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3905   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
     3906   procedure partslib-clear-temp-parts :
     3907     define buffer buf_temp-parts for temp-parts .
     3908     do
     3909     on error undo, return error
     3910     :
     3911       for each buf_temp-parts
     3912       on error undo, return error
     3913       :
     3914         delete buf_temp-parts .
     3915       end.
     3916     end.
     3917   end procedure.
     3918   procedure partslib-create-temp-parts :
     3919     define parameter buffer buf_parts       for ub.parts .
     3920     define parameter buffer buf_temp-parts  for temp-parts .
     3921     define input  parameter p-goods-twounit as logical   no-undo .
     3922     define variable v-base-part-code as character no-undo .
     3923     do
     3924     on error undo, return error
     3925     :
     3926       if p-goods-twounit = true
     3927       then do:
     3928         assign
     3929           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
     3930         .
     3931       end.
     3932       else do:
     3933         assign
     3934           v-base-part-code = buf_parts.part-code
     3935         .
     3936       end.
     3937       find first buf_temp-parts exclusive-lock
     3938         where buf_temp-parts.obj-type  = buf_parts.obj-type
     3939           and buf_temp-parts.obj-code  = buf_parts.obj-code
     3940           and buf_temp-parts.artic     = buf_parts.artic
     3941           and buf_temp-parts.prod-type = buf_parts.prod-type
     3942           and buf_temp-parts.prod-code = buf_parts.prod-code
     3943           and buf_temp-parts.in-code   = buf_parts.in-code
     3944           and buf_temp-parts.out-code  = 'free-zone':U
     3945           and buf_temp-parts.part-code = v-base-part-code
     3946         no-error.
     3947       if not available buf_temp-parts
     3948       then do:
     3949         create buf_temp-parts .
     3950         buffer-copy buf_parts to buf_temp-parts
     3951         assign
     3952           buf_temp-parts.out-code  = 'free-zone':U
     3953           buf_temp-parts.part-code = v-base-part-code
     3954           buf_temp-parts.rsrv-free = yes
     3955           buf_temp-parts.status_   = no
     3956           buf_temp-parts.qnty      = 0
     3957           buf_temp-parts.fact-qnty = 0
     3958           buf_temp-parts.real-qnty = 0
     3959           buf_temp-parts.cli-qnty  = 0
     3960         .
     3961       end.
     3962     end.
     3963   end procedure.
     3964   procedure partslib-init-temp-parts :
     3965     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     3966     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     3967     define input parameter p-artic           like ub.parts.artic     no-undo .
     3968     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     3969     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     3970     define buffer buf_parts      for ub.parts .
     3971     define buffer buf_temp-parts for temp-parts .
     3972     define variable v-goods-twounit    as logical   no-undo .
     3973     do
     3974     on error undo, return error
     3975     :
     3976   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3977   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     3978     (input  p-artic
     3979     ,input  p-prod-type
     3980     ,input  p-prod-code
     3981     ,input  'twounit=request':u
     3982     ,output v-goods-twounit
     3983     ) no-error .
     3984       if error-status :error
     3985       then do:
     3986         message
     3987           vss-workfile vss-revision vss-description skip
     3988           vss-include-info32 skip
     3989           "Ошибка при определении атрибута товара" skip
     3990           "Артикул" p-artic p-prod-type p-prod-code skip
     3991           "twounit=request" skip
     3992           error-status :get-message(1) skip
     3993           return-value skip
     3994           view-as alert-box error .
     3995         undo, return error return-value .
     3996       end.
     3997       run partslib-clear-temp-parts in this-procedure .
     3998       for each buf_parts
     3999         where buf_parts.obj-type  = p-obj-type
     4000           and buf_parts.obj-code  = p-obj-code
     4001           and buf_parts.artic     = p-artic
     4002           and buf_parts.prod-type = p-prod-type
     4003           and buf_parts.prod-code = p-prod-code
     4004           and buf_parts.rsrv-free = yes
     4005           and buf_parts.status_   = no
     4006           and buf_parts.in-code   <> buf_parts.out-code
     4007       on error undo, return error
     4008       :
     4009         run partslib-create-temp-parts in this-procedure
     4010           (buffer buf_parts
     4011           ,buffer buf_temp-parts
     4012           ,input  v-goods-twounit
     4013           ) .
     4014         define variable v-parts-qnty          as decimal   no-undo .
     4015         define variable v-parts-cli-qnty      as decimal   no-undo .
     4016         define variable v-parts-free-qnty     as decimal   no-undo .
     4017         define variable v-parts-free-cli-qnty as decimal   no-undo .
     4018         if buf_parts.out-code = 'free-zone':U
     4019         then do:
     4020           assign
     4021             v-parts-qnty          = buf_parts.qnty
     4022             v-parts-cli-qnty      = buf_parts.cli-qnty
     4023             v-parts-free-qnty     = buf_parts.qnty
     4024             v-parts-free-cli-qnty = buf_parts.cli-qnty
     4025           .
     4026         end.
     4027         else do:
     4028           assign
     4029             v-parts-qnty          = abs(buf_parts.qnty)
     4030             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
     4031             v-parts-free-qnty     = 0
     4032             v-parts-free-cli-qnty = 0
     4033           .
     4034         end.
     4035         assign
     4036           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
     4037           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
     4038           buf_temp-parts.real-qnty     = 0
     4039           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
     4040           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
     4041           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
     4042         .
     4043       end.
     4044     end.
     4045   end procedure.
     4046   procedure partslib-init-temp-parts-by-factord :
     4047     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     4048     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     4049     define input parameter p-artic              like ub.parts.artic     no-undo .
     4050     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     4051     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     4052     define input parameter p-fact-order         as decimal   no-undo .
     4053     define input parameter p-include-fact-order as logical   no-undo .
     4054     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     4055     define buffer buf_gds-obj  for ub.gds-obj .
     4056     do
     4057     on error undo, return error
     4058     :
     4059       do transaction
     4060       on error undo, return error
     4061       :
     4062   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4063   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     4064     (input  p-obj-type
     4065     ,input  p-obj-code
     4066     ,input  p-artic
     4067     ,input  p-prod-type
     4068     ,input  p-prod-code
     4069     ,buffer buf_gds-obj
     4070     ) no-error .
     4071         if error-status :error
     4072         then do:
     4073           message
     4074             vss-workfile vss-revision vss-description skip
     4075             vss-include-info32 skip
     4076             "Невозможно найти товар на объекте" skip
     4077             "Объект" p-obj-type p-obj-code skip
     4078             "Артикул" p-artic p-prod-type p-prod-code skip
     4079             error-status :get-message(1) skip
     4080             return-value skip
     4081             view-as alert-box error .
     4082           undo, return error .
     4083         end.
     4084         find current buf_gds-obj exclusive-lock .
     4085       end.
     4086       run partslib-init-temp-parts in this-procedure
     4087         (input p-obj-type
     4088         ,input p-obj-code
     4089         ,input p-artic
     4090         ,input p-prod-type
     4091         ,input p-prod-code
     4092         ) no-error .
     4093       if error-status :error
     4094       then do:
     4095         message
     4096           vss-workfile vss-revision vss-description skip
     4097           vss-include-info32 skip
     4098           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
     4099           "Объект" p-obj-type p-obj-code skip
     4100           "Артикул" p-artic p-prod-type p-prod-code skip
     4101           "p-fact-order" p-fact-order skip
     4102           view-as alert-box error .
     4103         undo, return error .
     4104       end.
     4105       if p-include-fact-order = true
     4106       then do:
     4107         assign
     4108           p-fact-order = p-fact-order - 0.0000000001
     4109         .
     4110       end.
     4111       define variable v-max-fact-order as character no-undo .
     4112       run factord-max-fact-order in this-procedure
     4113         (output v-max-fact-order
     4114         ) no-error .
     4115       if error-status :error
     4116       then do:
     4117         message
     4118           vss-workfile vss-revision vss-description skip
     4119           vss-include-info32 skip
     4120           "Ошибка при вызове процедуры factord-max-fact-order" skip
     4121           "Объект" p-obj-type p-obj-code skip
     4122           "Артикул" p-artic p-prod-type p-prod-code skip
     4123           "p-fact-order" p-fact-order skip
     4124           view-as alert-box error .
     4125         undo, return error .
     4126       end.
     4127       run partslib-update-by-factord in this-procedure
     4128         (input p-obj-type
     4129         ,input p-obj-code
     4130         ,input p-artic
     4131         ,input p-prod-type
     4132         ,input p-prod-code
     4133         ,input p-fact-order
     4134         ,input v-max-fact-order
     4135         ,input false
     4136         ) no-error .
     4137       if error-status :error
     4138       then do:
     4139         message
     4140           vss-workfile vss-revision vss-description skip
     4141           vss-include-info32 skip
     4142           "Ошибка при вызове процедуры partslib-update-by-factord" skip
     4143           "Объект" p-obj-type p-obj-code skip
     4144           "Артикул" p-artic p-prod-type p-prod-code skip
     4145           "p-fact-order" p-fact-order skip
     4146           "v-max-fact-order" v-max-fact-order skip
     4147           view-as alert-box error .
     4148         undo, return error .
     4149       end.
     4150     end.
     4151   end procedure.
     4152   procedure partslib-update-by-factord :
     4153     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     4154     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     4155     define input parameter p-artic              like ub.parts.artic     no-undo .
     4156     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     4157     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     4158     define input parameter p-start-fact-order   as decimal   no-undo .
     4159     define input parameter p-end-fact-order     as decimal   no-undo .
     4160     define input parameter p-lock-gds-obj       as logical   no-undo .
     4161     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     4162     define buffer buf_gds-obj  for ub.gds-obj .
     4163     define buffer buf_doc-line for ub.doc-line .
     4164     define variable v-total-parts-qnty as decimal   no-undo .
     4165     define variable v-goods-gds-goods  as logical   no-undo .
     4166     define variable v-goods-twounit    as logical   no-undo .
     4167     do
     4168     on error undo, return error
     4169     :
     4170       if p-start-fact-order > p-end-fact-order
     4171       then do:
     4172         message
     4173           vss-workfile vss-revision vss-description skip
     4174           vss-include-info32 skip
     4175           "Ошибка задания входных параметров" skip
     4176           "Начало интервала превышает конец интервала" skip
     4177           "Объект" p-obj-type p-obj-code skip
     4178           "Артикул" p-artic p-prod-type p-prod-code skip
     4179           "p-start-fact-order" p-start-fact-order skip
     4180           "p-end-fact-order"   p-end-fact-order skip
     4181           view-as alert-box error .
     4182         undo, return error .
     4183       end.
     4184       if p-lock-gds-obj = true
     4185       then do:
     4186         do transaction
     4187         on error undo, return error
     4188         :
     4189   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4190   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     4191     (input  p-obj-type
     4192     ,input  p-obj-code
     4193     ,input  p-artic
     4194     ,input  p-prod-type
     4195     ,input  p-prod-code
     4196     ,buffer buf_gds-obj
     4197     ) no-error .
     4198           if error-status :error
     4199           then do:
     4200             message
     4201               vss-workfile vss-revision vss-description skip
     4202               vss-include-info32 skip
     4203               "Невозможно найти gds-obj" skip
     4204               error-status :get-message(1) skip
     4205               return-value skip
     4206               view-as alert-box error .
     4207             undo, return error .
     4208           end.
     4209           find current buf_gds-obj exclusive-lock .
     4210         end.
     4211       end.
     4212   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4213   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     4214     (input  p-artic
     4215     ,input  p-prod-type
     4216     ,input  p-prod-code
     4217     ,input  'gds-goods=request':u
     4218     ,output v-goods-gds-goods
     4219     ) no-error .
     4220       if error-status :error
     4221       then do:
     4222         message
     4223           vss-workfile vss-revision vss-description skip
     4224           vss-include-info32 skip
     4225           "Ошибка при определении атрибута товара" skip
     4226           "Артикул" p-artic p-prod-type p-prod-code skip
     4227           "gds-goods=request" skip
     4228           error-status :get-message(1) skip
     4229           return-value skip
     4230           view-as alert-box error .
     4231         undo, return error return-value .
     4232       end.
     4233   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4234   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     4235     (input  p-artic
     4236     ,input  p-prod-type
     4237     ,input  p-prod-code
     4238     ,input  'twounit=request':u
     4239     ,output v-goods-twounit
     4240     ) no-error .
     4241       if error-status :error
     4242       then do:
     4243         message
     4244           vss-workfile vss-revision vss-description skip
     4245           vss-include-info32 skip
     4246           "Ошибка при определении атрибута товара" skip
     4247           "Артикул" p-artic p-prod-type p-prod-code skip
     4248           "twounit=request" skip
     4249           error-status :get-message(1) skip
     4250           return-value skip
     4251           view-as alert-box error .
     4252         undo, return error return-value .
     4253       end.
     4254       for each buf_doc-line no-lock
     4255         where buf_doc-line.obj-type   = p-obj-type
     4256           and buf_doc-line.obj-code   = p-obj-code
     4257           and buf_doc-line.artic      = p-artic
     4258           and buf_doc-line.prod-type  = p-prod-type
     4259           and buf_doc-line.prod-code  = p-prod-code
     4260           and buf_doc-line.status_    = 'факт':U
     4261           and buf_doc-line.fact-order > p-start-fact-order
     4262           and buf_doc-line.fact-order <= p-end-fact-order
     4263       on error undo, return error
     4264       :
     4265         run partslib-process-document in this-procedure
     4266           (input  buf_doc-line.doc-code
     4267           ,input  p-obj-type
     4268           ,input  p-obj-code
     4269           ,input  p-artic
     4270           ,input  p-prod-type
     4271           ,input  p-prod-code
     4272           ,input  v-goods-gds-goods
     4273           ,input  v-goods-twounit
     4274           ,output v-total-parts-qnty
     4275           ) no-error .
     4276         if error-status :error
     4277         then do:
     4278           message
     4279             vss-workfile vss-revision vss-description skip
     4280             vss-include-info32 skip
     4281             "Ошибка при вызове процедуры partslib-process-document" skip
     4282             "Документ" buf_doc-line.doc-code skip
     4283             "Объект" p-obj-type p-obj-code skip
     4284             "Артикул" p-artic p-prod-type p-prod-code skip
     4285             "p-start-fact-order" p-start-fact-order skip
     4286             "p-end-fact-order" p-end-fact-order skip
     4287             error-status :get-message(1) skip
     4288             return-value skip
     4289             view-as alert-box error .
     4290           undo, return error return-value .
     4291         end.
     4292       end.
     4293     end.
     4294   end procedure.
     4295   procedure partslib-process-document :
     4296     define input  parameter p-doc-code         as character no-undo .
     4297     define input  parameter p-obj-type         as character no-undo .
     4298     define input  parameter p-obj-code         as integer   no-undo .
     4299     define input  parameter p-artic            as character no-undo .
     4300     define input  parameter p-prod-type        as character no-undo .
     4301     define input  parameter p-prod-code        as integer   no-undo .
     4302     define input  parameter p-goods-gds-goods  as logical   no-undo .
     4303     define input  parameter p-goods-twounit    as logical   no-undo .
     4304     define output parameter p-total-parts-qnty as decimal   no-undo .
     4305     define variable v-parts-sign as integer   no-undo .
     4306     define buffer buf_trn-doc    for ub.trn-doc .
     4307     define buffer buf_doc-line   for ub.doc-line .
     4308     define buffer buf_parts      for ub.parts .
     4309     define buffer buf_temp-parts for temp-parts .
     4310     do
     4311     on error undo, return error return-value
     4312     :
     4313       find first buf_trn-doc no-lock
     4314         where buf_trn-doc.doc-code = p-doc-code
     4315         no-error .
     4316       if not available buf_trn-doc
     4317       then do:
     4318         undo, return error substitute("Ошибка при поиске документа. Документ &1"
     4319                                      ,p-doc-code
     4320                                      ) .
     4321       end.
     4322       case buf_trn-doc.doc-type
     4323       :
     4324         when 'при':U or
     4325         when 'возврат':U or
     4326         when 'инв':U
     4327         then do:
     4328           assign
     4329             v-parts-sign = -1
     4330           .
     4331         end.
     4332         when 'рас':U or
     4333         when 'спи':U
     4334         then do:
     4335           assign
     4336             v-parts-sign = 1
     4337           .
     4338         end.
     4339         otherwise do:
     4340           undo, return error substitute("Неизвестный тип документа &1"
     4341                                       ,buf_trn-doc.doc-type
     4342                                       ) .
     4343         end.
     4344       end.
     4345       find first buf_doc-line no-lock
     4346         where buf_doc-line.doc-code  = p-doc-code
     4347           and buf_doc-line.artic     = p-artic
     4348           and buf_doc-line.prod-type = p-prod-type
     4349           and buf_doc-line.prod-code = p-prod-code
     4350         no-error .
     4351       if not available buf_doc-line
     4352       then do:
     4353         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
     4354                                      ,p-doc-code
     4355                                      ,artic
     4356                                      ,prod-type
     4357                                      ,prod-code
     4358                                      ) .
     4359       end.
     4360       assign
     4361         p-total-parts-qnty = 0
     4362       .
     4363       if p-goods-gds-goods = true
     4364       then do:
     4365         for each buf_parts no-lock
     4366           where buf_parts.out-code  = p-doc-code
     4367             and buf_parts.obj-type  = p-obj-type
     4368             and buf_parts.obj-code  = p-obj-code
     4369             and buf_parts.artic     = p-artic
     4370             and buf_parts.prod-type = p-prod-type
     4371             and buf_parts.prod-code = p-prod-code
     4372         on error undo, return error
     4373         :
     4374           run partslib-create-temp-parts in this-procedure
     4375             (buffer buf_parts
     4376             ,buffer buf_temp-parts
     4377             ,input  p-goods-twounit
     4378             ) .
     4379           assign
     4380             p-total-parts-qnty        = p-total-parts-qnty
     4381                                       + v-parts-sign * buf_parts.fact-qnty
     4382             buf_temp-parts.qnty       = buf_temp-parts.qnty
     4383                                       + v-parts-sign * buf_parts.fact-qnty
     4384             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
     4385                                       + v-parts-sign * buf_parts.fact-qnty
     4386             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
     4387                                       + v-parts-sign * buf_parts.cli-qnty
     4388           .
     4389           if buf_temp-parts.qnty = 0
     4390           then do:
     4391             delete buf_temp-parts .
     4392           end.
     4393         end.
     4394       end.
     4395       else do:
     4396         assign
     4397           p-total-parts-qnty = p-total-parts-qnty
     4398                              + v-parts-sign * buf_doc-line.fact-qnty
     4399         .
     4400       end.
     4401     end.
     4402   end procedure.
     4403   procedure partslib-init-temp-parts-by-date :
     4404     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     4405     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     4406     define input parameter p-artic           like ub.parts.artic     no-undo .
     4407     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     4408     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     4409     define input parameter p-fact-date       as date      no-undo .
     4410     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
     4411     do
     4412     on error undo, return error
     4413     :
     4414       define variable v-fact-order                as decimal   no-undo .
     4415       define variable v-shift-end-fact-order      as decimal   no-undo .
     4416       define variable v-day-end-fact-order        as decimal   no-undo .
     4417       run factord in this-procedure
     4418         (input  p-fact-date
     4419         ,input  1
     4420         ,input  1
     4421         ,input  ?
     4422         ,input  0
     4423         ,input  false
     4424         ,output v-fact-order
     4425         ,output v-shift-end-fact-order
     4426         ,output v-day-end-fact-order
     4427         ) no-error .
     4428       if error-status :error
     4429       then do:
     4430         message
     4431           vss-workfile vss-revision vss-description skip
     4432           vss-include-info32 skip
     4433           "Ошибка при определении момента времени, на который требуется остаток" skip
     4434           "Объект" p-obj-type p-obj-code skip
     4435           "Артикул" p-artic p-prod-type p-prod-code skip
     4436           "Дата" p-fact-date skip
     4437           view-as alert-box error .
     4438         undo, return error .
     4439       end.
     4440       run partslib-init-temp-parts-by-factord in this-procedure
     4441         (input p-obj-type
     4442         ,input p-obj-code
     4443         ,input p-artic
     4444         ,input p-prod-type
     4445         ,input p-prod-code
     4446         ,input v-day-end-fact-order
     4447         ,input false
     4448         ) no-error .
     4449       if error-status :error
     4450       then do:
     4451         message
     4452           vss-workfile vss-revision vss-description skip
     4453           vss-include-info32 skip
     4454           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
     4455           "Объект" p-obj-type p-obj-code skip
     4456           "Артикул" p-artic p-prod-type p-prod-code skip
     4457           "Дата" p-fact-date skip
     4458           view-as alert-box error .
     4459         undo, return error .
     4460       end.
     4461     end.
     4462   end procedure.
     4463   procedure partslib-calc-cost :
     4464     define output parameter p-fact-qnty      as decimal   no-undo .
     4465     define output parameter p-vat-pc         as decimal   no-undo .
     4466     define output parameter p-slt-pc         as decimal   no-undo .
     4467     define output parameter p-sum-base       as decimal   no-undo .
     4468     define output parameter p-sum-rubl       as decimal   no-undo .
     4469     define output parameter p-vat-base       as decimal   no-undo .
     4470     define output parameter p-vat-rubl       as decimal   no-undo .
     4471     define output parameter p-slt-base       as decimal   no-undo .
     4472     define output parameter p-slt-rubl       as decimal   no-undo .
     4473     define output parameter p-road-tax-base  as decimal   no-undo .
     4474     define output parameter p-road-tax-rubl  as decimal   no-undo .
     4475     define output parameter p-transport-base as decimal   no-undo .
     4476     define output parameter p-transport-rubl as decimal   no-undo .
     4477     define output parameter p-other-base     as decimal   no-undo .
     4478     define output parameter p-other-rubl     as decimal   no-undo .
     4479     define output parameter p-excise-base    as decimal   no-undo .
     4480     define output parameter p-excise-rubl    as decimal   no-undo .
     4481     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     4482     do
     4483     on error undo, return error return-value
     4484     :
     4485       define buffer buf_temp-parts for temp-parts .
     4486       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     4487       define buffer   in-vatp-parts    for ub.parts   .
     4488       define buffer   in-vatp-doc      for ub.trn-doc .
     4489       define buffer   in-vatp-goods    for ub.goods   .
     4490       define buffer   in-vatp-sysconf  for ub.sysconf .
     4491       define buffer   in-vatp_doc-attr for ub.doc-attr.
     4492       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     4493       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     4494       define variable varinvprb                  as   character              no-undo.
     4495       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     4496       define variable cli-base-rate              as   decimal                no-undo.
     4497       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     4498       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     4499       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     4500       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     4501       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     4502       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     4503       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     4504       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     4505       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     4506       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     4507       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     4508       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     4509       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     4510       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     4511       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     4512       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     4513       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     4514       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     4515       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     4516       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     4517       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     4518       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     4519       define variable varinvatp-envd             as   character              no-undo.
     4520       define variable varinvatp-type             as   character              no-undo.
     4521       for each buf_temp-parts
     4522       on error undo, return error
     4523       :
     4524   assign
     4525     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     4526     price-base-with-tax-loc = buf_temp-parts.price-base
     4527   .
     4528   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4529   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     4530     (output varinvprb
     4531     )  .
     4532     if buf_temp-parts.out-code = 'free-zone':U     or
     4533        buf_temp-parts.out-code = 'out-zone':U   or
     4534        buf_temp-parts.doc-type = 'акт':U then do:
     4535       assign
     4536         in-vatp-have-vat-slt = yes.
     4537     end.
     4538     else do:
     4539       find first in-vatp_doc-attr no-lock
     4540         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     4541           and in-vatp_doc-attr.attr-code = 'envd':U
     4542         no-error .
     4543       if not available in-vatp_doc-attr then do:
     4544         assign
     4545           in-vatp-have-vat-slt = yes.
     4546       end.
     4547       else do:
     4548            in-vatp-have-vat-slt = no.
     4549       end.
     4550     end.
     4551     assign
     4552      price-cli-with-tax-loc = buf_temp-parts.price-cli
     4553      cli-base-rate          = buf_temp-parts.cli-base-rate.
     4554     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     4555              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     4556     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     4557             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     4558             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     4559             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     4560             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     4561             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     4562             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     4563       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     4564     assign
     4565       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     4566     assign
     4567       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     4568       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     4569       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     4570       transport-cli-loc  = 0
     4571       other-cli-loc      = 0
     4572     .
     4573   ASSIGN
     4574             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     4575       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     4576   .
     4577         assign
     4578           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     4579           p-vat-pc         = p-vat-pc         + vat-pc-loc
     4580           p-slt-pc         = p-slt-pc         + slt-pc-loc
     4581           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     4582           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     4583           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     4584           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     4585           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     4586           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     4587           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     4588           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     4589           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     4590           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     4591           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     4592           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     4593           p-excise-base    = p-excise-base    + 0
     4594           p-excise-rubl    = p-excise-rubl    + 0
     4595         .
     4596       end.
     4597       if p-fact-qnty      = ?
     4598       or p-sum-base       = ?
     4599       or p-sum-rubl       = ?
     4600       or p-vat-base       = ?
     4601       or p-vat-rubl       = ?
     4602       or p-slt-base       = ?
     4603       or p-slt-rubl       = ?
     4604       or p-road-tax-base  = ?
     4605       or p-road-tax-rubl  = ?
     4606       or p-transport-base = ?
     4607       or p-transport-rubl = ?
     4608       or p-other-base     = ?
     4609       or p-other-rubl     = ?
     4610       or p-excise-base    = ?
     4611       or p-excise-rubl    = ?
     4612       then do:
     4613         message
     4614           vss-workfile vss-revision vss-description skip
     4615           vss-include-info32 skip
     4616           "Программа in-vatp.i вернула неопределенные значения" skip
     4617           "p-fact-qnty"      p-fact-qnty      skip
     4618           "p-sum-base"       p-sum-base       skip
     4619           "p-sum-rubl"       p-sum-rubl       skip
     4620           "p-vat-base"       p-vat-base       skip
     4621           "p-vat-rubl"       p-vat-rubl       skip
     4622           "p-slt-base"       p-slt-base       skip
     4623           "p-slt-rubl"       p-slt-rubl       skip
     4624           "p-road-tax-base"  p-road-tax-base  skip
     4625           "p-road-tax-rubl"  p-road-tax-rubl  skip
     4626           "p-transport-base" p-transport-base skip
     4627           "p-transport-rubl" p-transport-rubl skip
     4628           "p-other-base"     p-other-base     skip
     4629           "p-other-rubl"     p-other-rubl     skip
     4630           "p-excise-base"    p-excise-base    skip
     4631           "p-excise-rubl"    p-excise-rubl    skip
     4632           view-as alert-box error .
     4633         undo, return error .
     4634       end.
     4635     end.
     4636   end procedure.
     4637   define variable g#report-num as integer   no-undo .
