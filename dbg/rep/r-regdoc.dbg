     4656   define variable v-col19    as logical      no-undo init "no".
     4657   define variable v-col20    as logical      no-undo init "no".
     4658   define variable v-col21    as logical      no-undo init "no".
     4659   define variable v-col22    as logical      no-undo init "no".
     4660   define variable v-col23    as logical      no-undo init "no".
     4661   define variable ObjName    as character    no-undo .
     4662   define variable i          as integer      no-undo .
     4663   define variable ValType    as integer      no-undo .
     4664   define variable tPrintRubl as logical      no-undo .
     4665   define variable v-fact-order-start like ub.stk-tot.Fact-order no-undo.
     4666   define variable v-fact-order-end   like ub.stk-tot.Fact-order no-undo.
     4667   define variable v-full-type          as character    no-undo.
     4668   define variable v-code-attr          as character    no-undo.
     4669   define variable v-code-attr-post     as character    no-undo.
