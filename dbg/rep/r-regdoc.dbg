     5654                                                    , INPUT buf_price-doc.host-code
     5655                                                    , INPUT 0
     5656                                                    , INPUT 0
     5657                                                    , INPUT 0
     5658                                                    ) .
     5659                  end.
     5660               end.
     5661            end.
     5662         end.
     5663      end.
     5664   define buffer buf_tt-itog for tt-itog .
     5665      for each buf_tt-itog
     5666          where buf_tt-itog.begin = false
     5667          no-lock :
     5668          find first tt-itog
     5669             where tt-itog.begin = true
     5670             and   tt-itog.obj-code = buf_tt-itog.obj-code
     5671             and   tt-itog.obj-type = buf_tt-itog.obj-type
     5672             no-error.
     5673             if not available tt-itog then do :
     5674                 create tt-itog .
     5675                 assign
     5676                   tt-itog.begin = true
     5677                   tt-itog.obj-type = buf_tt-itog.obj-type
     5678                   tt-itog.obj-code = buf_tt-itog.obj-code
     5679                   tt-itog.VAT-pc = ""
     5680                   tt-itog.VAT-cost = 0
     5681                   tt-itog.VAT-crsa = 0
     5682                   tt-itog.col09-qnty = 0
     5683                   tt-itog.sumWithNDS-cost = 0
     5684                   tt-itog.sumWithNDS-crsa = 0
     5685                 .
     5686                 if buf_tt-itog.obj-name ne ""
     5687                 then do :
     5688                     assign tt-itog.obj-name = "Остаток на начало" + substring(buf_tt-itog.obj-name, 17, length(buf_tt-itog.obj-name)) .
     5689                 end .
     5690             end.
     5691      end.
     5692      if CalcRest
     5693      then do :
     5694         for EACH  tt-itog
     5695             where tt-itog.begin = TRUE
     5696               and tt-itog.obj-type = "zzz":U
     5697               and tt-itog.obj-code = 0
     5698            :
     5699            run put-total-line IN THIS-PROCEDURE ( buffer tt-itog, INPUT TRUE).
     5700         end.
     5701      end.
     5702      if rz-objecte
     5703      then do :
     5704         for each tt-all
     5705            where tt-all.obj-type <> "zzz"
     5706            break by tt-all.obj-type
     5707                  by tt-all.obj-code
     5708                  by tt-all.doc-type
     5709                  by tt-all.col02-num
     5710                  by tt-all.col08-VAT-PC
     5711            :
     5712            if (first-OF( tt-all.obj-code )
     5713            OR  first-OF( tt-all.obj-type ))
     5714            then do :
     5715                find first buf_clients
     5716                     where buf_clients.obj-type  = tt-all.obj-type
     5717                        and buf_clients.obj-code = tt-all.obj-code
     5718                     NO-LOCK
     5719                     NO-ERROR
     5720                     .
     5721                RUN put-stick in this-procedure.
     5722                RUN put-head-line (INPUT buf_clients.obj-name) .
     5723                for EACH   tt-itog
     5724                     where tt-itog.begin    = TRUE
     5725                       and tt-itog.obj-type = tt-all.obj-type
     5726                       and tt-itog.obj-code = tt-all.obj-code
     5727                     :
     5728                  run put-total-line IN THIS-PROCEDURE ( buffer tt-itog, INPUT TRUE).
     5729                end.
     5730            end.
     5731            if first-OF( tt-all.doc-type )
     5732            then do :
     5733                RUN put-stick in this-procedure.
     5734                if  tt-all.doc-type <> "":U
     5735                and tt-all.doc-type <> "zzz":U   then
     5736                    RUN put-head-line (INPUT ENTRY( lookup( tt-all.doc-type, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U), 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U)) .
     5737            end.
     5738            if  first-OF( tt-all.col08-VAT-PC )
     5739            and tt-all.col08-VAT-PC <> -1
     5740            then do :
     5741            end.
     5742            if  tt-all.doc-type = 'ot':U
     5743            and tt-all.col16-SumWithNDS-sp      = 0
     5744            and NOT NullPer
     5745            then do :
     5746            end.
     5747            else do :
     5748               run put-line in this-procedure.
     5749            end.
     5750            if (LAST-OF( tt-all.obj-code )
     5751            OR  LAST-OF( tt-all.obj-type ))
     5752            then do:
     5753                for EACH tt-itog
     5754                     where tt-itog.begin    = FALSE
     5755                       and tt-itog.obj-type = tt-all.obj-type
     5756                       and tt-itog.obj-code = tt-all.obj-code
     5757                    :
     5758                  run put-total-line IN THIS-PROCEDURE ( buffer tt-itog, INPUT FALSE).
     5759                end.
     5760                RUN put-stick in this-procedure.
     5761            end.
     5762         end.
     5763         for each tt-all
     5764            where tt-all.obj-type = "zzz"
     5765            :
     5766            run put-line in this-procedure.
     5767         end.
     5768      end.
     5769      else do :
     5770         for each tt-all
     5771            use-index type
     5772            break by tt-all.doc-type
     5773                  by tt-all.obj-type
     5774                  by tt-all.col02-num
     5775                  by tt-all.col08-VAT-PC
     5776            :
     5777            if first-OF( tt-all.doc-type )
     5778            then do :
     5779                RUN put-stick in this-procedure.
     5780                if  tt-all.doc-type <> "":U
     5781                and tt-all.doc-type <> "zzz":U   then
     5782                    RUN put-head-line (INPUT ENTRY( lookup( tt-all.doc-type, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U), 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U)) .
     5783            end.
     5784            if  tt-all.doc-type = 'ot':U
     5785            and tt-all.col16-SumWithNDS-sp = 0
     5786            and NOT NullPer
     5787            then do :
     5788            end.
     5789            else do :
     5790               run put-line in this-procedure.
     5791            end.
     5792         end.
     5793      end.
     5794      if CalcRest
     5795      then do:
     5796         for EACH  tt-itog
     5797            where  tt-itog.begin = FALSE
     5798               and tt-itog.obj-type = "zzz":U
     5799               and tt-itog.obj-code = 0
     5800            :
     5801            run put-total-line IN THIS-PROCEDURE ( buffer tt-itog, INPUT FALSE).
     5802         end.
     5803      end.
     5804   end.
     5805   end procedure.
     5806   procedure calc-doc :
     5807   define input parameter p-doc-type   as character   no-undo.
     5808   define input parameter p-doc-code   as character   no-undo.
     5809   define input parameter p-obj-type   as character   no-undo.
     5810   define input parameter p-obj-code   as integer     no-undo.
     5811   define input parameter p-doc-date   as date        no-undo.
     5812   define input parameter p-cli-name   as character   no-undo.
     5813   define input parameter p-fact-order as decimal     no-undo.
     5814   define input parameter p-host-code  as integer     no-undo.
     5815   define input parameter p-reas-code  as integer     no-undo.
     5816   define input parameter p-base-rate  as decimal     no-undo.
     5817   define input parameter p-base-scale as integer     no-undo.
     5818   define buffer buf_tt-clcparts for tt-clcparts .
     5819   define buffer buf_parts       for ub.parts .
     5820   define buffer buf_goods       for ub.goods .
     5821   define buffer buf_gds-dtl     for ub.gds-dtl .
     5822   define buffer buf_sysconf     for ub.sysconf .
     5823   define buffer buf_trn-reason  for ub.trn-reason .
     5824   define buffer buf_price-list  for ub.price-list .
     5825   define variable varb-code              like ub.bar-code.b-code       no-undo .
     5826   define variable vardoc-num             like ub.price-doc.doc-num     no-undo .
     5827   define variable varcur-base            like ub.gds-dtl.price-base    no-undo .
     5828   define variable varcur-road-tax        like ub.doc-line.road-tax     no-undo .
     5829   define variable varcur-excise          like ub.doc-line.excise       no-undo .
     5830   define variable varcur-vat-pc          like ub.doc-line.vat-pc       no-undo .
     5831   define variable varcur-cons-vat-pc     like ub.doc-line.cons-vat-pc  no-undo .
     5832   define variable varcur-slt-pc          like ub.doc-line.slt-pc       no-undo .
     5833   define variable varcur-fact-qnty       like ub.gds-dtl.fact-qnty     no-undo .
     5834   define variable varprice-sale          like ub.price-list.price-sale no-undo .
     5835   define variable varroad-tax            like ub.price-list.road-tax   no-undo .
     5836   define variable varexcise              like ub.price-list.excise     no-undo .
     5837   define variable varlastcur-base        like ub.gds-dtl.price-base    no-undo .
     5838   define variable varlastcur-road-tax    like ub.gds-dtl.price-base    no-undo .
     5839   define variable varlastcur-excise      like ub.gds-dtl.price-base    no-undo .
     5840   do
     5841   on error undo, return error
     5842   :
     5843       assign
     5844         v-code-attr-post = "":U
     5845         v-date-post      = "":U
     5846         v-code-attr      = "":U
     5847         v-sf-doc-code    = "":U
     5848         v-sf-doc-date    = "":U
     5849         v-reas-name      = "":U
     5850      .
     5851      if  v-col03
     5852      then do :
     5853         run gbl/trdcat-v.p   ( input p-doc-code
     5854                              , input 'nids':U
     5855                              , output v-code-attr-post
     5856                              , output v-attr-type
     5857                              ) NO-ERROR .
     5858      end.
     5859      if  v-col23  then do :
     5860         run gbl/trdcat-v.p   ( input p-doc-code
     5861                              , input 'dids':U
     5862                              , output v-date-post
     5863                              , output v-attr-type
     5864                              ) NO-ERROR .
     5865      end.
     5866      if  v-col22 then do :
     5867         run gbl/trdcat-v.p   ( input p-doc-code
     5868                              , input 'nosn':U
     5869                              , output v-reas-name
     5870                              , output v-attr-type
     5871                              ) NO-ERROR .
     5872         if v-reas-name = "":U
     5873         OR v-reas-name = ?
     5874         then do :
     5875            find first buf_trn-reason
     5876               where buf_trn-reason.reason-code = p-reas-code
     5877               no-lock
     5878               no-error
     5879               .
     5880            if available buf_trn-reason then do:
     5881               assign
     5882                  v-reas-name = buf_trn-reason.reason-name
     5883               .
     5884            end.
     5885         end.
     5886      end.
     5887      if v-col04
     5888      then do :
     5889   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input p-doc-code ,
     5890                           input 'print-num':U ,
     5891                          output v-code-attr ,
     5892                          output v-attr-type ) NO-ERROR .
     5893      end.
     5894      if v-col06
     5895      then do :
     5896   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input p-doc-code ,
     5897                           input 'nsf':U ,
     5898                          output v-sf-doc-code ,
     5899                          output v-attr-type ) NO-ERROR .
     5900      end.
     5901      if v-col05
     5902      then do :
     5903   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input p-doc-code ,
     5904                           input 'dsf':U ,
     5905                          output v-sf-doc-date ,
     5906                          output v-attr-type ) NO-ERROR .
     5907      end.
     5908      if p-doc-type <> 'ot':U
     5909      then
     5910      for each buf_parts
     5911         where buf_parts.out-code  = p-doc-code
     5912           and buf_parts.obj-type  = p-obj-type
     5913           and buf_parts.obj-code  = p-obj-code
     5914         no-lock
     5915         ,
     5916         first tt-gds
     5917         where tt-gds.artic     = buf_parts.artic
     5918           and tt-gds.prod-type = buf_parts.prod-type
     5919           and tt-gds.prod-code = buf_parts.prod-code
     5920         :
     5921         for each buf_tt-clcparts
     5922         on error undo, return error return-value
     5923         :
     5924            delete buf_tt-clcparts .
     5925         end.
     5926         create buf_tt-clcparts .
     5927         buffer-copy buf_parts to buf_tt-clcparts .
     5928   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     5929     (input  tt-gds.gds-code
     5930     ,input  ?
     5931     ,output varb-code
     5932     )  .
     5933   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5934   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcprcex in g#library
     5935     (input  p-obj-type
     5936     ,input  p-obj-code
     5937     ,input  varb-code
     5938     ,input  0
     5939     ,input  p-fact-order
     5940     ,output vardoc-num
     5941     ,output varprice-sale
     5942     ,output varroad-tax
     5943     ,output varexcise
     5944     ,output varcur-vat-pc
     5945     ,output varcur-slt-pc
     5946     )  .
     5947         if varprice-sale = ?
     5948         then do :
     5949            assign
     5950            varcur-vat-pc = 0
     5951            varcur-slt-pc = 0
     5952            .
     5953         end.
     5954         assign
     5955            varlastcur-base     = 0
     5956            varlastcur-road-tax = 0
     5957            varlastcur-excise   = 0
     5958            varcur-base         = 0
     5959            varcur-road-tax     = 0
     5960            varcur-excise       = 0
     5961            varcur-fact-qnty    = 0
     5962         .
     5963         for  each buf_gds-dtl no-lock
     5964             where buf_gds-dtl.doc-code  = p-doc-code
     5965               and buf_gds-dtl.artic     = buf_parts.artic
     5966               and buf_gds-dtl.prod-type = buf_parts.prod-type
     5967               and buf_gds-dtl.prod-code = buf_parts.prod-code
     5968         on error undo, return error return-value
     5969         :
     5970   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     5971     (input  tt-gds.gds-code
     5972     ,input  buf_gds-dtl.prt-code
     5973     ,output varb-code
     5974     ) no-error .
     5975   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5976   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     5977     (input  p-obj-type
     5978     ,input  p-obj-code
     5979     ,input  varb-code
     5980     ,input  0
     5981     ,input  p-fact-order
     5982     ,output vardoc-num
     5983     ,output varprice-sale
     5984     ,output varroad-tax
     5985     ,output varexcise
     5986     )  .
     5987            if varprice-sale = ?
     5988            then do :
     5989               assign
     5990                   varprice-sale = 0
     5991                   varroad-tax   = 0
     5992                   varexcise     = 0
     5993               .
     5994            end.
     5995            assign
     5996               varlastcur-base     = varprice-sale
     5997               varlastcur-road-tax = varroad-tax
     5998               varlastcur-excise   = varexcise
     5999               varcur-base         = varcur-base      + varprice-sale * buf_gds-dtl.fact-qnty
     6000               varcur-road-tax     = varcur-road-tax  + varroad-tax   * buf_gds-dtl.fact-qnty
     6001               varcur-excise       = varcur-excise    + varexcise     * buf_gds-dtl.fact-qnty
     6002               varcur-fact-qnty    = varcur-fact-qnty +                 buf_gds-dtl.fact-qnty
     6003            .
     6004         end.
     6005         if varcur-fact-qnty = 0 then do :
     6006            assign
     6007               varcur-base      = varlastcur-base
     6008               varcur-road-tax  = varlastcur-road-tax
     6009               varcur-excise    = varlastcur-excise
     6010            .
     6011         end.
     6012         else do :
     6013            assign
     6014               varcur-base      = varcur-base      / varcur-fact-qnty
     6015               varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     6016               varcur-excise    = varcur-excise    / varcur-fact-qnty
     6017            .
     6018         end.
     6019         find first buf_sysconf
     6020              where buf_sysconf.host-code = p-host-code
     6021              no-lock
     6022              .
     6023         assign varcur-cons-vat-pc = buf_sysconf.cons-vat-pc .
     6024         if varcur-cons-vat-pc = ? then do :
     6025            assign varcur-cons-vat-pc = 0 .
     6026         end.
     6027         FIND FIRST doc-line WHERE doc-line.doc-code  = buf_parts.out-code
     6028                               AND doc-line.artic     = buf_parts.artic
     6029                               AND doc-line.prod-type = buf_parts.prod-type
     6030                               AND doc-line.prod-code = buf_parts.prod-code
     6031                               NO-LOCK NO-ERROR.
     6032         run clcprtsl_calc-ttable in this-procedure
     6033            ( input TRUE
     6034            , input TRUE
     6035            , input 0
     6036            , input 0
     6037            , input IF (AVAIL doc-line) THEN doc-line.VAT-pc ELSE ?
     6038            , input 0
     6039            , input 0
     6040            , input p-base-rate
     6041            , input p-base-scale
     6042            , input ( if tPrintRubl = yes then "rubl":U else "base":U )
     6043            , input varcur-base
     6044            , input varcur-road-tax
     6045            , input varcur-excise
     6046            , input varcur-vat-pc
     6047            , input varcur-cons-vat-pc
     6048            , input varcur-slt-pc
     6049            ) no-error .
     6050         run create-lines in this-procedure  ( input p-doc-type
     6051                                             , input p-doc-code
     6052                                             , input p-obj-type
     6053                                             , input p-obj-code
     6054                                             , input ROUND(buf_parts.VAT-pc, 0)
     6055                                             , input p-doc-date
     6056                                             , input p-cli-name
     6057                                             , input buf_parts.fact-qnty
     6058                                             , input buf_parts.road-tax-rubl
     6059                                             ) .
     6060      end.
     6061      else
     6062      for each buf_price-list
     6063         where buf_price-list.doc-num    = p-doc-code
     6064           and buf_price-list.main-price = yes
     6065         no-lock
     6066         ,
     6067         first tt-gds
     6068         where tt-gds.artic     = buf_price-list.artic
     6069           and tt-gds.prod-type = buf_price-list.prod-type
     6070           and tt-gds.prod-code = buf_price-list.prod-code
     6071         :
     6072            def var v-price-list-doc-num            like ub.price-list.doc-num     no-undo.
     6073            def var v-price-list-price-sale         like ub.price-list.price-sale  no-undo.
     6074            def var v-price-list-price-sale_old     like ub.price-list.price-sale  no-undo.
     6075            def var v-price-list-road-tax           like ub.price-list.road-tax    no-undo.
     6076            def var v-price-list-excise             like ub.price-list.excise      no-undo.
     6077   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
