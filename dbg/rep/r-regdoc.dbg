     3352   procedure clcprtsl_calc-ttable :
     3353   define input parameter paris-doc           as   logical                 no-undo.
     3354   define input parameter paris-cur           as   logical                 no-undo.
     3355   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     3356   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     3357   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     3358   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     3359   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     3360   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     3361   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     3362   define input parameter parr-b              as   character               no-undo.
     3363   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     3364   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     3365   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     3366   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     3367   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     3368   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     3369   define buffer bf_tt-allsum      for tt-allsum.
     3370   define buffer bf_tt-clcparts    for tt-clcparts.
     3371   define buffer bf_tt-allsum-line for tt-allsum-line.
     3372   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     3373   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     3374   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     3375   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     3376   define variable varexcise          like ub.price-list.excise     no-undo.
     3377   do on error undo, return error return-value :
     3378   for each bf_tt-allsum-line
     3379   on error undo, return error return-value
     3380    :
     3381     delete bf_tt-allsum-line.
     3382   end.
     3383   for each bf_tt-allsum
     3384   on error undo, return error return-value
     3385   :
     3386     delete bf_tt-allsum.
     3387   end.
     3388   for each bf_tt-clcparts
     3389   on error undo, return error return-value
     3390   :
     3391   if v-calcbypart then do:
     3392             assign
     3393             parcur-base =   bf_tt-clcparts.part-cur-base
     3394             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     3395             parcur-excise =   bf_tt-clcparts.part-cur-excise
     3396             .
     3397   end.
     3398      run clcprtsl_calc-parts in this-procedure (
     3399        input recid(bf_tt-clcparts),
     3400        input paris-doc,
     3401        input paris-cur,
     3402        input parroad-tax,
     3403        input parexcise,
     3404        input parvat-pc,
     3405        input parcons-vat-pc,
     3406        input parslt-pc,
     3407        input parbase-rate,
     3408        input parbase-scale,
     3409        input parr-b,
     3410        input parcur-base,
     3411        input parcur-road-tax,
     3412        input parcur-excise,
     3413        input parcur-vat-pc,
     3414        input parcurcons-vat-pc,
     3415        input parcurslt-pc
     3416        ) no-error.
     3417     if error-status:error then do:
     3418       message
     3419         vss-workfile vss-revision vss-description skip
     3420         vss-include-info15 skip
     3421         "Ошибка при обсчете партии" skip
     3422         "Документ партии " bf_tt-clcparts.out-code skip
     3423         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     3424         return-value skip
     3425         error-status:get-message(1) skip
     3426         error-status:get-message(2) skip
     3427         error-status:get-message(3) skip
     3428         view-as alert-box error .
     3429       undo, return error .
     3430     end.
     3431     for each bf_tt-allsum on error undo, return error return-value :
     3432       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     3433       if not available bf_tt-allsum-line then do:
