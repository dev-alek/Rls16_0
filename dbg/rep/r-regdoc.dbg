       57   procedure twowin_add-item :
       58   define input parameter p-ext-key   as character        no-undo.
       59   define input parameter p-item-name as character        no-undo.
       60   define input parameter p-item-desc as character        no-undo.
       61   define input parameter p-selected  as logical          no-undo.
       62       define buffer buf_temp_twowin_items        for temp_twowin_items.
       63   do
       64   for buf_temp_twowin_items
       65   on error undo, return error
       66   :
       67       assign
       68           v-twowin1-itm-key = v-twowin1-itm-key + 1
       69       .
       70       create temp_twowin_items.
       71       assign
       72           temp_twowin_items.itm-key      = v-twowin1-itm-key
       73           temp_twowin_items.itmExtKey    = p-ext-key
       74           temp_twowin_items.itmName      = p-item-name
       75           temp_twowin_items.itmDesc      = p-item-desc
       76           temp_twowin_items.itmSelected  = p-selected
       77           temp_twowin_items.selLeft      = no
       78           temp_twowin_items.selRight     = no
       79       .
       80   end.
       81   end procedure.
