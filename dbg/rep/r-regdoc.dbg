     4775   define temp-table tt-gds LIKE gds-list .
     4776   do
     4777   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1))
     4778   :
     4779      define stream  OutStream  .
     4780      define stream macr_excel .
     4781      define variable parparentproc  as handle  no-undo .
     4782      assign parparentproc = my-handle .
     4783       assign
     4784           pshift-date  = x-date-start
     4785           pshift-num   = x-shift-start
     4786           pshift-date1 = x-date-end
     4787           pshift-num1  = x-shift-end
     4788           .
     4789     run day-begin-fact-order in this-procedure ( input x-date-start      , output v-fact-order-start ).
     4790     run day-begin-fact-order in this-procedure ( input ( x-date-end + 1 ),   output v-fact-order-end ).
     4791      CASE x-SET_val_TYPE :
     4792         WHEN 1 then do:
     4793            assign
     4794               tPrintRubl = YES
     4795            .
     4796         end.
     4797         WHEN 2 then do:
     4798            assign
     4799               tPrintRubl = NO
     4800            .
     4801         end.
     4802      end CASE.
     4803      assign
     4804         i             = 0
     4805         ValType       = if (x-SET_PAY_TYPE = 1) then 0  else x-SET_val_TYPE
     4806      .
     4807      end.
     4808    run report-execute .
     4809   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     4810     if num-entries(string(p-dec), '.') = 2
     4811       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     4812       else return( string(p-dec)) .
     4813   end function.
     4814   function format-point-to-comma returns char (input orig as char ) .
     4815   define variable rtext as character no-undo .
     4816   define variable strt as integer no-undo .
     4817   define variable leng as integer no-undo .
     4818   assign rtext = orig .
     4819   repeat:
     4820     strt =  index(rtext,'.').
     4821     if strt = 0 then leave.
     4822     leng = 1.
     4823     substring(rtext,strt,leng,"character") = v-delim .
     4824   end.
     4825   return rtext.
     4826   end function.
     4827   function format-excel-text returns char ( input start-text as char ) :
     4828   def var  i    as int no-undo.
     4829   def var  ch   as char no-undo.
     4830   def var  n    as int no-undo.
     4831   def var  ipos as int no-undo.
     4832     n = num-entries(trim(start-text), chr(10)) - 1 .
     4833     do i = 1 to n :
     4834       ipos = index( start-text, chr(10)).
     4835       if ipos > 0 then
     4836         substr( start-text, ipos, 1 ) = ' '.
     4837     end.
     4838     n = num-entries(trim(start-text), chr(13)) - 1 .
     4839     do i = 1 to n :
     4840       ipos = index( start-text, chr(13)).
     4841       if ipos > 0 then
     4842         substr( start-text, ipos, 1 ) = ' '.
     4843     end.
     4844     if index( start-text, '"' ) = 0 then
     4845       start-text =  '="'   + trim( start-text) + '"'   .
     4846       else do:
     4847         n = num-entries(trim(start-text), '"') - 1.
     4848         do i = 1 to n :
     4849           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     4850         end.
     4851         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     4852         start-text = '="'  + ch  + '"' .
     4853       end.
     4854     return start-text.
     4855   end.
     4856   function excel-sum returns char (input p-dec as decimal ).
     4857     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     4858   end function.
     4859   function excel-qnty returns char (input p-dec as decimal ).
     4860     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     4861   end function.
     4862   function format-excel-text-macr returns char ( input start-text as char ) :
     4863   def var  i    as int no-undo.
     4864   def var  ch   as char no-undo.
     4865   def var  n    as int no-undo.
     4866   def var  ipos as int no-undo.
     4867     n = num-entries(trim(start-text), chr(10)) - 1 .
     4868     do i = 1 to n :
     4869       ipos = index( start-text, chr(10)).
     4870       if ipos > 0 then
     4871         substring( start-text, ipos , 1 ) = ' '.
     4872     end.
     4873     n = num-entries(trim(start-text), chr(13)) - 1 .
     4874     do i = 1 to n :
     4875       ipos = index( start-text, chr(13)).
     4876       if ipos > 0 then
     4877         substring( start-text, ipos, 1 ) = ' '.
     4878     end.
     4879     if index( start-text, '"' ) = 0 then
     4880       start-text =  '"'   + trim( start-text) + '"'   .
     4881       else do:
     4882         n = num-entries(trim(start-text), '"') - 1.
     4883         do i = 1 to n :
     4884           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     4885         end.
     4886         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     4887         start-text = '"'  + ch  + '"' .
     4888       end.
     4889     n = num-entries(trim(start-text), chr(10)) - 1 .
     4890     do i = 1 to n :
     4891       ipos = index( start-text, chr(10)).
     4892       if ipos > 0 then
     4893         substring( start-text, ipos , 1 ) = ' '.
     4894     end.
     4895       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     4896     return start-text.
     4897   end.
     4898   FUNCTION n-lavel RETURNS char (INPUT grp-name as char, INPUT lavel# as int ).
     4899   define variable  str  as char format "X(60)"  no-undo.
     4900   define variable  str2 as char no-undo.
     4901   define variable v-r as character no-undo init "" .
     4902   define variable  i#i as int no-undo.
     4903   STR = "".
     4904   repeat i#i =1 to lavel#:
     4905       if i#i =1 then str   = entry(1,grp-name, chr(47)) .
     4906       else do:
     4907           str2 = entry(i#i,grp-name, chr(47)) no-error.
     4908           if not error-status:error  and str2 <> "":u then
     4909                  str = str +  chr(47) +  entry(i#i,grp-name, chr(47)) no-error .
     4910           end.
     4911   end.
     4912   if str <> ? then do:
     4913   v-r = str + chr(47) .
     4914   end.
     4915   RETURN v-r .
     4916   END FUNCTION.
     4917    procedure report-execute .
     4918      run waitfram-show in this-procedure ( "Выбор колонок...":U ) .
     4919      run col-select in this-procedure.
     4920      run get-report-num in my-handle ( output g#report-num ).
     4921      if radio-serv = 1
     4922      then do :
     4923         run create-goods in this-procedure.
     4924      end.
     4925      else do:
     4926         run create-favour in this-procedure.
     4927      end.
     4928   output stream OutStream to value( string( session:temp-directory +
     4929                                        "rpt" + string( g#report-num ) ) )
     4930                                        page-size  value(ReportPageHeight) .
     4931     assign
     4932       make-excel      = yes
     4933       v-file-name-ind = 1
     4934     .
     4935      run gbl/_tmpfile.p ("wb", ".txt", output v-file-name) .
     4936      output stream macr_excel to value(v-file-name).
     4937      run waitfram-show in this-procedure ( "Заголовок...":U ) .
     4938      run print-header  in this-procedure.
     4939      run display-title in this-procedure.
     4940      run put-stick     in this-procedure.
     4941      run columntitle   in this-procedure .
     4942      run waitfram-show in this-procedure ( "Расчет":U ) .
     4943      run create-report in this-procedure .
     4944      run put-stick     in this-procedure.
     4945      run waitfram-show in this-procedure ( "Подвал":U ) .
     4946      run waitfram-hide in this-procedure .
     4947      HIDE STREAM OutStream FRAME docsRep .
     4948      output stream OutStream close.
     4949      Output stream Macr_Excel  close .
     4950     run paramls-write  in this-procedure
     4951     (input  "file"
     4952     ,input  string(v-file-name-ind)
     4953     ,input  v-file-name
     4954     ) .
     4955     run end-proc in this-procedure .
     4956     run gbl/prnfilen.w
     4957            ( input  ""
     4958            , input  8
     4959            , input  string(session :temp-directory) + "rpt" + string( g#report-num )
     4960            , input  ReportFontNum
     4961            , output v-user-action
     4962            , output v-printed
     4963            ) .
     4964     os-delete value( string(session :temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )  .
     4965   end procedure.
