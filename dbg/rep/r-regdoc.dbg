     2890       bfsacc_tt-allsum.dsc-rubl-acc        = bfs_tt-allsum.dsc-rubl-acc
     2891       bfsacc_tt-allsum.dsc-cli-acc         = bfs_tt-allsum.dsc-cli-acc
     2892       bfsacc_tt-allsum.vat-base-acc        = bfs_tt-allsum.vat-base-acc
     2893       bfsacc_tt-allsum.vat-rubl-acc        = bfs_tt-allsum.vat-rubl-acc
     2894       bfsacc_tt-allsum.vat-cli-acc         = bfs_tt-allsum.vat-cli-acc
     2895       bfsacc_tt-allsum.slt-base-acc        = bfs_tt-allsum.slt-base-acc
     2896       bfsacc_tt-allsum.slt-rubl-acc        = bfs_tt-allsum.slt-rubl-acc
     2897       bfsacc_tt-allsum.slt-cli-acc         = bfs_tt-allsum.slt-cli-acc
     2898       bfsacc_tt-allsum.excise-base-acc     = bfs_tt-allsum.excise-base-acc
     2899       bfsacc_tt-allsum.excise-rubl-acc     = bfs_tt-allsum.excise-rubl-acc
     2900       bfsacc_tt-allsum.excise-cli-acc      = bfs_tt-allsum.excise-cli-acc
     2901       bfsacc_tt-allsum.road-tax-base-acc   = bfs_tt-allsum.road-tax-base-acc
     2902       bfsacc_tt-allsum.road-tax-rubl-acc   = bfs_tt-allsum.road-tax-rubl-acc
     2903       bfsacc_tt-allsum.road-tax-cli-acc    = bfs_tt-allsum.road-tax-cli-acc
     2904       bfsacc_tt-allsum.transport-base-acc  = bfs_tt-allsum.transport-base-acc
     2905       bfsacc_tt-allsum.transport-rubl-acc  = bfs_tt-allsum.transport-rubl-acc
     2906       bfsacc_tt-allsum.transport-cli-acc   = bfs_tt-allsum.transport-cli-acc
     2907       bfsacc_tt-allsum.other-base-acc      = bfs_tt-allsum.other-base-acc
     2908       bfsacc_tt-allsum.other-rubl-acc      = bfs_tt-allsum.other-rubl-acc
     2909       bfsacc_tt-allsum.other-cli-acc       = bfs_tt-allsum.other-cli-acc
     2910       .
     2911   end.
     2912   otherwise do:
     2913     return error substitute ("Неизвестный тип приобретения &1 по партии с кодом &2 по документу &3, порожденную документом &4 по товару &5 &6 &7.",
     2914                              cl_tt-clcparts.purch-code,
     2915                              cl_tt-clcparts.part-code,
     2916                              cl_tt-clcparts.out-code,
     2917                              cl_tt-clcparts.in-code,
     2918                              cl_tt-clcparts.artic,
     2919                              cl_tt-clcparts.prod-type,
     2920                              cl_tt-clcparts.prod-code).
     2921   end.
     2922   end case.
     2923   end.
     2924   end procedure.
     2925   procedure clcprtsl_calc-line :
     2926   define input  parameter parrec-line as recid no-undo.
     2927   define variable v-tax-date         as   date                     no-undo.
     2928   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     2929   define variable varr-b             as   character                no-undo.
     2930   define variable varr-btype         as   character                no-undo.
     2931   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     2932   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     2933   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     2934   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     2935   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     2936   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     2937   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     2938   define variable varb-code          like ub.bar-code.b-code       no-undo.
     2939   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     2940   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     2941   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     2942   define variable varexcise          like ub.price-list.excise     no-undo.
     2943   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     2944   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     2945   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     2946   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     2947   define variable v-varsum           as decimal                  no-undo.
     2948   define variable varprice-salef as decimal   no-undo .
     2949   define buffer bf_trn-doc             for ub.trn-doc.
     2950   define buffer bf_doc-line            for ub.doc-line.
     2951   define buffer bf_gds-dtl             for ub.gds-dtl.
     2952   define buffer bf_goods               for ub.goods.
     2953   define buffer bf_parts               for ub.parts.
     2954   define buffer bf_sysconf             for ub.sysconf.
     2955   define buffer bf_tt-allsum-line      for tt-allsum-line.
     2956   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     2957   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     2958   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     2959   define buffer buf_parts        for ub.parts.
     2960   v-calcbypart = no.
     2961   do on error undo, return error return-value :
     2962   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2963   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2964     (output varr-b
     2965     )  .
     2966     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     2967     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     2968     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     2969                               bf_goods.prod-type = bf_doc-line.prod-type and
     2970                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     2971     if bf_trn-doc.fact-date <> ?        then do:
     2972       assign v-tax-date = bf_trn-doc.fact-date.
     2973     end.
     2974     else do:
     2975       assign v-tax-date = ?.
     2976     end.
     2977   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2978   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2979     (input  bf_goods.gds-code
     2980     ,input  '1':U
     2981     ,input  v-tax-date
     2982     ,input  bf_trn-doc.host-code
     2983     ,input  bf_trn-doc.obj-type
     2984     ,input  bf_trn-doc.obj-code
     2985     ,output v-vat-pc
     2986     ) no-error .
     2987     if error-status :error
     2988     or v-vat-pc = ? then do:
     2989        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     2990     end.
     2991     if bf_goods.gds-type = 'у':U or
     2992        bf_trn-doc.status_ = 'запрос':U then do:
     2993       for each bf_tt-allsum-line
     2994       on error undo, return error return-value
     2995        :
     2996         delete bf_tt-allsum-line.
     2997       end.
     2998       create bf_tt-allsum-line.
     2999       assign
     3000        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     3001       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     3002                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     3003                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     3004                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     3005         assign
     3006           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     3007           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     3008           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     3009           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     3010           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     3011           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     3012           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     3013           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     3014           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     3015           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     3016           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     3017           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     3018           bf_tt-allsum-line.vat-cli-acc          =  ?
     3019           .
     3020       end.
     3021       assign
     3022         bf_tt-allsum-line.cli-qnty             =  ?
     3023         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     3024         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     3025         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     3026         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     3027         bf_tt-allsum-line.road-tax-base-doc    =  0
     3028         bf_tt-allsum-line.road-tax-rubl-doc    =  0
     3029         bf_tt-allsum-line.excise-base-doc      =  0
     3030         bf_tt-allsum-line.excise-rubl-doc      =  0
     3031         bf_tt-allsum-line.vat-base-doc         =  bf_tt-allsum-line.vat-base-buyer-doc
     3032         bf_tt-allsum-line.vat-rubl-doc         =  bf_tt-allsum-line.vat-rubl-buyer-doc
     3033         bf_tt-allsum-line.dsc-base-cur         =  0
     3034         bf_tt-allsum-line.dsc-rubl-cur         =  0
     3035         bf_tt-allsum-line.slt-base-cur         =  bf_tt-allsum-line.sum-dsc-base-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     3036         bf_tt-allsum-line.slt-rubl-cur         =  bf_tt-allsum-line.sum-dsc-rubl-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     3037         bf_tt-allsum-line.vat-base-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-base-cur - bf_tt-allsum-line.slt-base-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     3038         bf_tt-allsum-line.vat-rubl-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-rubl-cur - bf_tt-allsum-line.slt-rubl-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     3039         bf_tt-allsum-line.road-tax-base-cur    =  0
     3040         bf_tt-allsum-line.road-tax-rubl-cur    =  0
     3041         bf_tt-allsum-line.excise-base-cur      =  0
     3042         bf_tt-allsum-line.excise-rubl-cur      =  0
     3043         bf_tt-allsum-line.vat-base-cur         =  bf_tt-allsum-line.vat-base-buyer-cur
     3044         bf_tt-allsum-line.vat-rubl-cur         =  bf_tt-allsum-line.vat-rubl-buyer-cur
     3045         bf_tt-allsum-line.dsc-base-acc         =  0
     3046         bf_tt-allsum-line.dsc-rubl-acc         =  0
     3047         bf_tt-allsum-line.dsc-cli-acc          =  0
     3048         bf_tt-allsum-line.slt-base-acc         =  0
     3049         bf_tt-allsum-line.slt-rubl-acc         =  0
     3050         bf_tt-allsum-line.slt-cli-acc          =  0
     3051         bf_tt-allsum-line.road-tax-base-acc    =  0
     3052         bf_tt-allsum-line.road-tax-rubl-acc    =  0
     3053         bf_tt-allsum-line.road-tax-cli-acc     =  0
     3054         bf_tt-allsum-line.excise-base-acc      =  0
     3055         bf_tt-allsum-line.excise-rubl-acc      =  0
     3056         bf_tt-allsum-line.excise-cli-acc       =  0
     3057         bf_tt-allsum-line.transport-base-acc   =  0
     3058         bf_tt-allsum-line.transport-rubl-acc   =  0
     3059         bf_tt-allsum-line.transport-cli-acc    =  0
     3060         bf_tt-allsum-line.other-base-acc       =  0
     3061         bf_tt-allsum-line.other-rubl-acc       =  0
     3062         bf_tt-allsum-line.other-cli-acc        =  0
     3063         .
     3064       create bfs_tt-allsum-line.
     3065       assign
     3066       bfs_tt-allsum-line.sum-type = 'основная_сумма_со_знаком':U.
     3067       if bf_trn-doc.doc-type = 'инв':U or
     3068          bf_trn-doc.doc-type = 'при':U    or
     3069          bf_trn-doc.doc-type = 'возврат':U    then do:
     3070          buffer-copy bf_tt-allsum-line except bf_tt-allsum-line.sum-type to bfs_tt-allsum-line.
     3071       end.
     3072       else do:
     3073         assign
     3074           bfs_tt-allsum-line.fact-qnty           =  - bf_tt-allsum-line.fact-qnty
     3075           bfs_tt-allsum-line.cli-qnty            =  - bf_tt-allsum-line.cli-qnty
     3076           bfs_tt-allsum-line.sum-dsc-base-doc    =  - bf_tt-allsum-line.sum-dsc-base-doc
     3077           bfs_tt-allsum-line.sum-dsc-rubl-doc    =  - bf_tt-allsum-line.sum-dsc-rubl-doc
     3078           bfs_tt-allsum-line.dsc-base-doc        =  - bf_tt-allsum-line.dsc-base-doc
     3079           bfs_tt-allsum-line.dsc-rubl-doc        =  - bf_tt-allsum-line.dsc-rubl-doc
     3080           bfs_tt-allsum-line.vat-base-doc        =  - bf_tt-allsum-line.vat-base-doc
     3081           bfs_tt-allsum-line.vat-rubl-doc        =  - bf_tt-allsum-line.vat-rubl-doc
     3082           bfs_tt-allsum-line.vat-base-buyer-doc  =  - bf_tt-allsum-line.vat-base-buyer-doc
     3083           bfs_tt-allsum-line.vat-rubl-buyer-doc  =  - bf_tt-allsum-line.vat-rubl-buyer-doc
     3084           bfs_tt-allsum-line.slt-base-doc        =  - bf_tt-allsum-line.slt-base-doc
     3085           bfs_tt-allsum-line.slt-rubl-doc        =  - bf_tt-allsum-line.slt-rubl-doc
     3086           bfs_tt-allsum-line.road-tax-base-doc   =  - bf_tt-allsum-line.road-tax-base-doc
     3087           bfs_tt-allsum-line.road-tax-rubl-doc   =  - bf_tt-allsum-line.road-tax-rubl-doc
     3088           bfs_tt-allsum-line.excise-base-doc     =  - bf_tt-allsum-line.excise-base-doc
     3089           bfs_tt-allsum-line.excise-rubl-doc     =  - bf_tt-allsum-line.excise-rubl-doc
     3090           bfs_tt-allsum-line.sum-dsc-base-cur    =  - bf_tt-allsum-line.sum-dsc-base-cur
     3091           bfs_tt-allsum-line.sum-dsc-rubl-cur    =  - bf_tt-allsum-line.sum-dsc-rubl-cur
     3092           bfs_tt-allsum-line.dsc-base-cur        =  - bf_tt-allsum-line.dsc-base-cur
     3093           bfs_tt-allsum-line.dsc-rubl-cur        =  - bf_tt-allsum-line.dsc-rubl-cur
     3094           bfs_tt-allsum-line.vat-base-cur        =  - bf_tt-allsum-line.vat-base-cur
     3095           bfs_tt-allsum-line.vat-rubl-cur        =  - bf_tt-allsum-line.vat-rubl-cur
     3096           bfs_tt-allsum-line.vat-base-buyer-cur  =  - bf_tt-allsum-line.vat-base-buyer-cur
     3097           bfs_tt-allsum-line.vat-rubl-buyer-cur  =  - bf_tt-allsum-line.vat-rubl-buyer-cur
     3098           bfs_tt-allsum-line.slt-base-cur        =  - bf_tt-allsum-line.slt-base-cur
     3099           bfs_tt-allsum-line.slt-rubl-cur        =  - bf_tt-allsum-line.slt-rubl-cur
     3100           bfs_tt-allsum-line.road-tax-base-cur   =  - bf_tt-allsum-line.road-tax-base-cur
     3101           bfs_tt-allsum-line.road-tax-rubl-cur   =  - bf_tt-allsum-line.road-tax-rubl-cur
     3102           bfs_tt-allsum-line.excise-base-cur     =  - bf_tt-allsum-line.excise-base-cur
     3103           bfs_tt-allsum-line.excise-rubl-cur     =  - bf_tt-allsum-line.excise-rubl-cur
     3104           bfs_tt-allsum-line.sum-dsc-base-acc    =  - bf_tt-allsum-line.sum-dsc-base-acc
     3105           bfs_tt-allsum-line.sum-dsc-rubl-acc    =  - bf_tt-allsum-line.sum-dsc-rubl-acc
     3106           bfs_tt-allsum-line.sum-dsc-cli-acc     =  - bf_tt-allsum-line.sum-dsc-cli-acc
     3107           bfs_tt-allsum-line.dsc-base-acc        =  - bf_tt-allsum-line.dsc-base-acc
     3108           bfs_tt-allsum-line.dsc-rubl-acc        =  - bf_tt-allsum-line.dsc-rubl-acc
     3109           bfs_tt-allsum-line.dsc-cli-acc         =  - bf_tt-allsum-line.dsc-cli-acc
     3110           bfs_tt-allsum-line.vat-base-acc        =  - bf_tt-allsum-line.vat-base-acc
     3111           bfs_tt-allsum-line.vat-rubl-acc        =  - bf_tt-allsum-line.vat-rubl-acc
     3112           bfs_tt-allsum-line.vat-cli-acc         =  - bf_tt-allsum-line.vat-cli-acc
     3113           bfs_tt-allsum-line.slt-base-acc        =  - bf_tt-allsum-line.slt-base-acc
     3114           bfs_tt-allsum-line.slt-rubl-acc        =  - bf_tt-allsum-line.slt-rubl-acc
     3115           bfs_tt-allsum-line.slt-cli-acc         =  - bf_tt-allsum-line.slt-cli-acc
     3116           bfs_tt-allsum-line.road-tax-base-acc   =  - bf_tt-allsum-line.road-tax-base-acc
     3117           bfs_tt-allsum-line.road-tax-rubl-acc   =  - bf_tt-allsum-line.road-tax-rubl-acc
     3118           bfs_tt-allsum-line.road-tax-cli-acc    =  - bf_tt-allsum-line.road-tax-cli-acc
     3119           bfs_tt-allsum-line.excise-base-acc     =  - bf_tt-allsum-line.excise-base-acc
     3120           bfs_tt-allsum-line.excise-rubl-acc     =  - bf_tt-allsum-line.excise-rubl-acc
     3121           bfs_tt-allsum-line.excise-cli-acc      =  - bf_tt-allsum-line.excise-cli-acc
     3122           bfs_tt-allsum-line.transport-base-acc  =  - bf_tt-allsum-line.transport-base-acc
     3123           bfs_tt-allsum-line.transport-rubl-acc  =  - bf_tt-allsum-line.transport-rubl-acc
