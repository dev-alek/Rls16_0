     3050     define buffer buf_temp-prt-obj for temp-prt-obj .
     3051     do
     3052     on error undo, return error return-value
     3053     :
     3054       run prdoclib-clear-temp-prt-obj in this-procedure .
     3055       for each buf_prt-obj
     3056         where buf_prt-obj.obj-type  = p-obj-type
     3057           and buf_prt-obj.obj-code  = p-obj-code
     3058           and buf_prt-obj.artic     = p-artic
     3059           and buf_prt-obj.prod-type = p-prod-type
     3060           and buf_prt-obj.prod-code = p-prod-code
     3061       on error undo, return error return-value
     3062       :
     3063         run prdoclib-create-temp-prt-obj in this-procedure
     3064           (input  p-root-price-sale
     3065           ,buffer buf_prt-obj
     3066           ,buffer buf_temp-prt-obj
     3067           ).
     3068       end.
     3069     end.
