     4349       field full-name   as character
     4350       field sort-name   as character
     4351       field node-code   as integer
     4352       field level       as integer
     4353       field is-terminal as logical
     4354       index pi is primary unique sort-name
     4355       index fn full-name
     4356       index lv level
     4357       index it is-terminal
     4358   .
     4359   define temp-table temp_found-result-nodelist no-undo
     4360       field node-code     as recid
     4361       field processed     as logical
     4362       field sort-name     as character
     4363       field full-name     as character
     4364       index pi is primary unique node-code
     4365       index ps processed
     4366   .
     4367   define variable v-grplib-not-fill-extra-info        as logical      no-undo.
     4368   define variable v-grplib-no-warning-grp-amount      as logical      no-undo.
     4369   define variable v-grplib-grp-amount-for-load        as integer      no-undo.
     4370   procedure grplib-get-parameters :
     4371   define input parameter p-store-type     as character        no-undo.
     4372   define input parameter p-store-code     as integer          no-undo.
     4373   do
     4374   on error undo, return error
     4375   :
     4376       assign
     4377           v-grplib-not-fill-extra-info = no
     4378       .
     4379   end.
     4380   end procedure.
     4381   procedure grplib-get-sort-name :
     4382   do
     4383   on error undo, return error
     4384   :
     4385   define input parameter p-node-code  as integer      no-undo.
     4386   define output parameter p-sort-name as character    no-undo.
     4387       define variable v-upper-code    as integer           no-undo.
     4388       define buffer buf_gds-grp       for ub.gds-grp.
     4389       define buffer buf_upper_gds-grp for ub.gds-grp.
     4390       find first buf_gds-grp no-lock
     4391            where buf_gds-grp.node-code = p-node-code
     4392       no-error.
     4393       if not available buf_gds-grp
     4394       then do:
     4395           undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     4396       end.
     4397       assign
     4398           p-sort-name  = ""
     4399           v-upper-code = 1
     4400       .
     4401       do while buf_gds-grp.upper-code <> 0
     4402       on error undo, return error "grplib-get-sort-name: Ошибка составления полного имени группы"
     4403       :
     4404           assign
     4405               p-sort-name  = buf_gds-grp.node-name
     4406                            + (if p-sort-name <> "" then chr(2) else "")
     4407                            + p-sort-name
     4408               v-upper-code = buf_gds-grp.upper-code
     4409           .
     4410           find first buf_gds-grp no-lock
     4411                where buf_gds-grp.node-code = v-upper-code
     4412           no-error.
     4413           if not available buf_gds-grp
     4414           then do:
     4415               undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом "
     4416                                   + string( v-upper-code )
     4417                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     4418           end.
     4419       end.
     4420   end.
     4421   end procedure.
     4422   define variable vss-include-info42 as character format "X(65)" no-undo
     4423   initial "@(#)$Workfile$ $Revision$".
     4424   procedure grplib-get-full-name :
     4425      define input parameter p-node-code  as integer      no-undo.
     4426      define output parameter p-full-name as character    no-undo.
     4427      do
     4428   on error undo, return error
     4429   :
     4430       define variable v-upper-code    as integer           no-undo.
     4431       define buffer buf_gds-grp       for ub.gds-grp.
     4432       define buffer buf_upper_gds-grp for ub.gds-grp.
     4433       find first buf_gds-grp no-lock
     4434            where buf_gds-grp.node-code = p-node-code
     4435       no-error.
     4436       if not available buf_gds-grp
     4437       then do:
     4438           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     4439       end.
     4440       assign
     4441           p-full-name  = ""
     4442           v-upper-code = 1
     4443       .
     4444       do while buf_gds-grp.upper-code <> 0
     4445       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     4446       :
     4447           assign
     4448               p-full-name  = buf_gds-grp.node-name
     4449                            + (if p-full-name <> "" then chr(47) else "")
     4450                            + p-full-name
     4451               v-upper-code = buf_gds-grp.upper-code
     4452           .
     4453           find first buf_gds-grp no-lock
     4454                where buf_gds-grp.node-code = v-upper-code
     4455           no-error.
     4456           if not available buf_gds-grp
     4457           then do:
     4458               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     4459                                   + string( v-upper-code )
     4460                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     4461           end.
     4462       end.
     4463       assign
     4464       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     4465       .
     4466   end.
     4467   end .
     4468   procedure grplib-get-node-from-full-name :
     4469   define input parameter p-full-name as character no-undo .
     4470   define output parameter p-node-code as integer no-undo .
     4471   define variable v-ii as integer no-undo .
     4472   define variable v-upper-code as integer no-undo .
     4473   define variable v-root-code as integer no-undo .
     4474   define variable v-entry as character no-undo .
     4475   define buffer buf_gds-grp       for ub.gds-grp.
     4476   do
     4477   on error undo, return error
     4478   :
     4479     find first buf_gds-grp no-lock
     4480         where buf_gds-grp.upper-code = 0
     4481     no-error .
     4482     if not available buf_gds-grp
     4483     then do:
     4484         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     4485     end.
     4486     else do:
     4487       assign
     4488       v-root-code = buf_gds-grp.node-code
     4489       .
     4490     end.
     4491     v-upper-code = v-root-code.
     4492     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     4493       assign
     4494       v-entry = entry(v-ii, p-full-name, chr(47)).
     4495       if v-entry = '' then leave.
     4496       find first buf_gds-grp no-lock where
     4497                 buf_gds-grp.node-name = v-entry
     4498             and buf_gds-grp.upper-code = v-upper-code
     4499             no-error.
     4500       if not available buf_gds-grp then do:
     4501         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     4502       end.
     4503       else do:
     4504         p-node-code = buf_gds-grp.node-code.
     4505         v-upper-code = buf_gds-grp.node-code.
     4506       end.
     4507     end.
     4508   end.
     4509   end .
     4510   procedure grplib-get-root-code :
     4511   do
     4512   on error undo, return error
     4513   :
     4514   define output parameter p-root-code as integer      no-undo.
     4515       define buffer buf_gds-grp       for ub.gds-grp.
     4516       find first buf_gds-grp no-lock
     4517           where buf_gds-grp.upper-code = 0
     4518       no-error .
     4519       if not available buf_gds-grp
     4520       then do:
     4521           undo, return error .
     4522       end.
     4523       else do:
     4524           assign
     4525               p-root-code = buf_gds-grp.node-code
     4526           .
     4527       end.
     4528   end.
     4529   end procedure.
     4530   procedure grplib-find-grp-by-full-name :
     4531   do
     4532   on error undo, return error
     4533   :
     4534   define input parameter p-search-name  as character    no-undo.
     4535   define input parameter p-fill-path    as logical      no-undo.
     4536   define output parameter p-found       as logical      no-undo.
     4537       define variable v-upper-code    as integer          no-undo.
     4538       define variable v-counter       as integer           no-undo.
     4539       define variable v-level         as integer           no-undo.
     4540       define variable v-full-name     as character         no-undo.
     4541       define variable v-sort-name     as character         no-undo.
     4542       define buffer buf_gds-grp       for ub.gds-grp.
     4543       assign
     4544           p-search-name = replace( p-search-name, chr(47), chr(2) )
     4545       .
     4546       run grplib-get-root-code ( output v-upper-code ) no-error .
     4547       if error-status :error
     4548       then do:
     4549           undo, return error "grplib-expand-name: Ошибка при поиске корневого узла".
     4550       end.
     4551       assign
     4552           v-full-name  = ""
     4553           v-level      = num-entries( p-search-name, chr(2) )
     4554       .
     4555       for each temp_grplib_found-grp
     4556       :
     4557           delete temp_grplib_found-grp.
     4558       end.
     4559       start-name-analyze:
     4560       do v-counter = 1 to v-level
     4561       :
     4562           if v-counter < v-level
     4563           then do:
     4564               find first buf_gds-grp no-lock
     4565                    where buf_gds-grp.upper-code = v-upper-code
     4566                      and buf_gds-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
     4567               no-error .
     4568               if not available buf_gds-grp
     4569               then do:
     4570                   assign
     4571                       v-full-name  = p-search-name
     4572                       v-sort-name  = p-search-name
     4573                   .
     4574                   return error "grplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
     4575               end.
     4576               else do:
     4577                   assign
     4578                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_gds-grp.node-name
     4579                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_gds-grp.node-name
     4580                       v-upper-code = buf_gds-grp.node-code
     4581                   .
     4582                   if p-fill-path = yes
     4583                   then do:
     4584                       create temp_grplib_found-grp.
     4585                       assign
     4586                           temp_grplib_found-grp.full-name = v-full-name + chr(47)
     4587                           temp_grplib_found-grp.sort-name = v-sort-name
     4588                           temp_grplib_found-grp.node-code = v-upper-code
     4589                           temp_grplib_found-grp.level     = v-counter
     4590                       .
     4591                   end.
     4592               end.
     4593           end.
     4594           else do:
     4595               for each buf_gds-grp no-lock
     4596                  where buf_gds-grp.upper-code = v-upper-code
     4597                    and buf_gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
     4598               :
     4599                   assign
     4600                       p-found = yes
     4601                   .
     4602                   create temp_grplib_found-grp.
     4603                   assign
     4604                       temp_grplib_found-grp.full-name = v-full-name
     4605                                                           + (if v-full-name = "" then "" else chr(47) )
     4606                                                           + buf_gds-grp.node-name + chr(47)
     4607                       temp_grplib_found-grp.sort-name = v-sort-name
     4608                                                           + ( if v-sort-name = "" then "" else chr(2) )
     4609                                                           + buf_gds-grp.node-name
     4610                       temp_grplib_found-grp.node-code = buf_gds-grp.node-code
     4611                       temp_grplib_found-grp.level     = v-level
     4612                   .
     4613               end.
     4614               if p-found = no
     4615               then do:
     4616                   assign
     4617                       v-full-name  = p-search-name
     4618                       v-sort-name  = p-search-name
     4619                   .
     4620                   for each temp_grplib_found-grp
     4621                   :
     4622                       delete temp_grplib_found-grp.
     4623                   end.
     4624                   assign
     4625                       p-found = no
     4626                   .
     4627               end.
     4628           end.
     4629       end.
     4630   end.
     4631   end procedure.
     4632   procedure grplib-find-all-subgroup :
     4633   do
     4634   on error undo, return error
     4635   :
     4636   define input parameter p-start-node-code    as integer      no-undo.
     4637   define input parameter p-terminal-only      as logical      no-undo.
     4638       define variable v-start-full-name   as character     no-undo.
     4639       define variable v-start-sort-name   as character     no-undo.
     4640       define variable v-not-found         as logical       no-undo.
     4641       define variable v-is-terminal       as logical       no-undo.
     4642       define buffer buf_gds-grp           for ub.gds-grp.
     4643       create temp_found-result-nodelist.
     4644       assign
     4645           temp_found-result-nodelist.node-code = p-start-node-code
     4646           temp_found-result-nodelist.processed = no
     4647       .
     4648       run grplib-get-full-name in this-procedure (
     4649             input p-start-node-code
     4650           , output v-start-full-name
     4651       ).
     4652       run grplib-get-full-name in this-procedure (
     4653             input p-start-node-code
     4654           , output v-start-sort-name
     4655       ).
     4656       process-nodes:
     4657       do while yes
     4658       :
     4659           find first temp_found-result-nodelist
     4660                where temp_found-result-nodelist.node-code = p-start-node-code
     4661           .
     4662           assign
     4663               temp_found-result-nodelist.processed = yes
     4664           .
     4665           for each buf_gds-grp no-lock
     4666              where buf_gds-grp.upper-code = p-start-node-code
     4667           on error undo, return error
     4668           :
     4669               run grplib-is-terminal in this-procedure (
     4670                     input buf_gds-grp.node-code
     4671                   , output v-is-terminal
     4672               ).
     4673               if v-is-terminal = yes
     4674               then do:
     4675                   create temp_grplib_found-grp.
     4676                   assign
     4677                       temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     4678                                                           chr(47) + buf_gds-grp.node-name + chr(47)
     4679                       temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     4680                                                           chr(2) + buf_gds-grp.node-name + chr(2)
     4681                       temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
     4682                       temp_grplib_found-grp.is-terminal = yes
     4683                   .
     4684               end.
     4685               else do:
     4686                   create temp_found-result-nodelist.
     4687                   assign
     4688                       temp_found-result-nodelist.node-code = buf_gds-grp.node-code
     4689                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
     4690                                                              chr(47) + buf_gds-grp.node-name + chr(47)
     4691                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
     4692                                                              chr(2) + buf_gds-grp.node-name + chr(2)
     4693                       temp_found-result-nodelist.processed = no
     4694                   .
     4695                   if p-terminal-only = no
     4696                   then do:
     4697                       create temp_grplib_found-grp.
     4698                       assign
     4699                           temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     4700                                                               chr(47) + buf_gds-grp.node-name + chr(47)
     4701                           temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     4702                                                               chr(2) + buf_gds-grp.node-name + chr(2)
     4703                           temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
     4704                           temp_grplib_found-grp.is-terminal = no
     4705                       .
     4706                   end.
     4707               end.
     4708           end.
     4709           find first temp_found-result-nodelist
     4710                where temp_found-result-nodelist.processed = no
     4711           no-error.
     4712           if not available temp_found-result-nodelist
     4713           then do:
     4714               leave process-nodes.
     4715           end.
     4716           else do:
     4717               assign
     4718                   p-start-node-code = temp_found-result-nodelist.node-code
     4719                   v-start-full-name = temp_found-result-nodelist.full-name
     4720                   v-start-sort-name = temp_found-result-nodelist.sort-name
     4721               .
     4722           end.
     4723       end.
     4724   end.
     4725   end procedure.
     4726   procedure grplib-expand-name :
     4727   define input parameter p-start-name as character        no-undo.
     4728   define output parameter p-end-name  as character        no-undo.
     4729       define variable v-is-terminal   as logical      no-undo.
     4730       define variable v-found         as character    no-undo.
     4731       define buffer buf_temp_grplib_found-grp     for temp_grplib_found-grp.
     4732   do
     4733   for buf_temp_grplib_found-grp
     4734   on error undo, return error
     4735   :
     4736       run grplib-find-grp-by-full-name in this-procedure (
     4737             input p-start-name
     4738           , input no
     4739           , output v-found
     4740       ) no-error.
     4741       run grplib-get-max-substring in this-procedure (
     4742                   input length( p-start-name )
     4743                 , output p-end-name
     4744       ) no-error .
     4745       if error-status :error
     4746       then do:
     4747           assign
     4748               p-end-name = ""
     4749           .
     4750       end.
     4751       else do:
     4752           find first temp_grplib_found-grp
     4753               where temp_grplib_found-grp.full-name = p-end-name
     4754           no-error.
     4755           if available temp_grplib_found-grp
     4756           then do:
     4757               find first buf_temp_grplib_found-grp
     4758                   where buf_temp_grplib_found-grp.full-name begins p-end-name
     4759                   and recid( buf_temp_grplib_found-grp ) <> recid( temp_grplib_found-grp )
     4760               no-error.
     4761               if not available buf_temp_grplib_found-grp
     4762               then do:
     4763                   run grplib-is-terminal in this-procedure (
     4764                       input temp_grplib_found-grp.node-code
     4765                       , output v-is-terminal
     4766                   ).
     4767               end.
     4768           end.
     4769       end.
     4770   end.
     4771   end procedure.
     4772   procedure grplib-get-max-substring :
     4773   do
     4774   on error undo, return error
     4775   :
     4776   define input parameter p-min-substring-length   as integer      no-undo.
     4777   define output parameter p-substring             as character    no-undo.
     4778           define variable v-char-counter  as integer           no-undo.
     4779           define variable v-current-char  as character         no-undo.
     4780           define variable v-names-counter  as integer           no-undo.
     4781           define variable v-base-string   as character         no-undo.
     4782           assign
     4783               v-char-counter  = p-min-substring-length
     4784           .
     4785           find first temp_grplib_found-grp no-error.
     4786           if not available temp_grplib_found-grp
     4787           then do:
     4788               undo, return error "grplib-get-max-substring: Нет строк для вычисления общей подстроки".
     4789           end.
     4790           else do:
     4791               assign
     4792                   v-base-string  = temp_grplib_found-grp.full-name
     4793                   v-char-counter = 0
     4794               .
     4795               counter-block:
     4796               do while yes
     4797               on error undo, return error "grplib-get-max-substring: Ошибка вычисления продолжения имени группы."
     4798               :
     4799                   assign
     4800                       v-char-counter  = v-char-counter + 1
     4801                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
     4802                       v-names-counter = 0
     4803                   .
     4804                   compare-block:
     4805                   for each temp_grplib_found-grp
     4806                   :
     4807                       assign
     4808                           v-names-counter = v-names-counter + 1
     4809                       .
     4810                       if v-names-counter = 1
     4811                       then do:
     4812                           next compare-block.
     4813                       end.
     4814                       if substring( temp_grplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
     4815                       then do:
     4816                           leave counter-block.
     4817                       end.
     4818                   end.
     4819                   if v-names-counter = 1
     4820                   then do:
     4821                       assign
     4822                           p-substring = v-base-string
     4823                       .
     4824                       return.
     4825                   end.
     4826               end.
     4827               assign
     4828                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
     4829               .
     4830           end.
     4831   end.
     4832   end procedure.
     4833   procedure grplib-is-terminal :
     4834   do
     4835   on error undo, return error "Ошибка процедуры grplib-is-terminal"
     4836   :
     4837   define input parameter p-node-code      as integer      no-undo.
     4838   define output parameter p-is-terminal   as logical      no-undo.
     4839       define buffer buf_gds-grp       for ub.gds-grp.
     4840       find first buf_gds-grp no-lock
     4841           where buf_gds-grp.upper-code = p-node-code
     4842       no-error .
     4843       if not available buf_gds-grp
     4844       then do:
     4845           assign
     4846               p-is-terminal = yes
     4847           .
     4848       end.
     4849       else do:
     4850           assign
     4851               p-is-terminal = no
     4852           .
     4853       end.
     4854   end.
     4855   end procedure.
     4856   procedure grplib-have-goods :
     4857   do
     4858   on error undo, return error
     4859   :
     4860   define input parameter p-node-code      as integer      no-undo.
     4861   define output parameter p-have-goods   as logical      no-undo.
     4862       define buffer buf_goods         for ub.goods.
     4863       find first buf_goods no-lock
     4864            where buf_goods.grp-code = p-node-code
     4865       no-error .
     4866       if available buf_goods
     4867       then do:
     4868           assign
     4869               p-have-goods = yes
     4870           .
     4871       end.
     4872       else do:
     4873           assign
     4874               p-have-goods = no
     4875           .
     4876       end.
     4877   end.
     4878   end procedure.
     4879   procedure grplib-find-by-substring :
     4880   do
     4881   on error undo, return error
     4882   :
     4883   define input parameter p-start-code         as integer      no-undo.
     4884   define input parameter p-full-search-string as character    no-undo.
     4885   define output parameter p-found-code        as integer      no-undo.
     4886   define output parameter p-full-name         as character    no-undo.
     4887       define variable v-start-code     as integer           no-undo.
     4888       define variable v-found          as logical  init no  no-undo.
     4889       define buffer buf_gds-grp       for ub.gds-grp.
     4890       search-grp:
     4891       for each buf_gds-grp no-lock
     4892           where buf_gds-grp.node-code > p-start-code
     4893       :
     4894           if index( buf_gds-grp.node-name, p-full-search-string ) <> 0
     4895           then do:
     4896               assign
     4897                   p-found-code = buf_gds-grp.node-code
     4898                   v-found      = yes
     4899               .
     4900               run grplib-get-full-name in this-procedure (
     4901                     input p-found-code
     4902                   , output p-full-name
     4903               ) no-error .
     4904               if error-status :error
     4905               then do:
     4906                   undo, return error "grplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
     4907               end.
     4908               leave search-grp.
     4909           end.
     4910       end.
     4911       if v-found = yes
     4912       then do:
     4913       end.
     4914       else do:
     4915           assign
     4916               p-full-name  = ""
     4917               p-found-code = 0
     4918           .
     4919       end.
     4920   end.
     4921   end procedure.
     4922   procedure grplib-analyze-grp-name :
     4923   do
     4924   on error undo, return error
     4925   :
     4926   define input parameter p-grp-name       as character            no-undo.
     4927   define input parameter p-upper-code     as integer              no-undo.
     4928   define output parameter p-error-message as character init ""    no-undo.
     4929       define variable v-char-list     as character    no-undo.
     4930       define variable v-char-counter  as integer      no-undo.
     4931       define variable v-full-name     as character    no-undo.
     4932       if p-grp-name = "" then do:
     4933           assign
     4934               p-error-message = "Название группы не может быть пустым.".
     4935           .
     4936       end.
     4937       else do:
     4938           assign
     4939               v-char-list = "47,92,58,63,34,60,62,171,187,183"
     4940           .
     4941           do v-char-counter = 1 to num-entries( v-char-list )
     4942           :
     4943               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
     4944               then do:
     4945                   assign
     4946                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
     4947                   .
     4948                   return.
     4949               end.
     4950           end.
     4951           if p-upper-code > 0
     4952           then do:
     4953               run grplib-get-full-name in this-procedure (
     4954                     input p-upper-code
     4955                   , output v-full-name
     4956               ) no-error .
     4957               if error-status :error
     4958               then do:
     4959                   undo, return error "grplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
     4960               end.
     4961               if length( v-full-name ) + 1 + length( p-grp-name ) > 350
     4962               then do:
     4963                   assign
     4964                       p-error-message = 'Полное название группы не может содержать более 350 символов.'
     4965                   .
     4966               end.
     4967           end.
     4968       end.
     4969   end.
     4970   end procedure.
     4971   procedure grplib-get-lvl-num :
     4972   define input parameter p-node-code  as integer      no-undo.
     4973   define output parameter p-lvl-num   as integer      no-undo.
     4974       define variable v-full-name    as character    no-undo.
     4975   do
     4976   on error undo, return error
     4977   :
     4978       run grplib-get-full-name in this-procedure (
     4979             input p-node-code
     4980           , output v-full-name
     4981       ).
     4982       assign
     4983           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
     4984       .
     4985       if p-lvl-num = -1
     4986       then do:
     4987           assign
     4988               p-lvl-num = 0
     4989           .
     4990       end.
     4991   end.
     4992   end procedure.
     4993   define temp-table temp-font no-undo
     4994     field fontnum  as integer
     4995     field fontname as character
     4996     field fontsize as character
     4997     field fonttype as character
     4998     field font-h   as integer
     4999     field font-w   as integer
     5000     field v-row    as integer
     5001     field v-col    as integer
     5002     field v-row-lans as integer
     5003     field v-col-lans as integer
     5004   index pi fontnum
     5005   .
     5006   procedure get-font-ini :
     5007     do
     5008     on error undo, return error return-value
     5009     :
     5010   define variable ii as integer   no-undo .
     5011   define variable v-font7 as character no-undo .
     5012   define variable v-font as character no-undo .
     5013   define variable loc-name as character no-undo .
     5014   define variable loc-size as character no-undo .
     5015   define variable loc-type as character no-undo .
     5016   define variable old_H as integer   no-undo .
     5017   define variable old_w as integer   no-undo .
     5018   define variable old-row  as integer   no-undo .
     5019   define variable old-col  as integer   no-undo .
     5020   define variable old-row-lans  as integer   no-undo .
     5021   define variable old-col-lans  as integer   no-undo .
     5022   define variable vv as integer   no-undo .
     5023   empty temp-table temp-font.
     5024     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     5025       case num-entries (v-font7) :
     5026         when 4 then do:
     5027             assign
     5028               loc-name = entry ( 1 , v-font7 )
     5029               loc-size = entry ( 2 , v-font7 )
     5030               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     5031             .
     5032         end.
     5033         when 3 then do:
     5034             assign
     5035               loc-name = entry ( 1 , v-font7 )
     5036               loc-size = entry ( 2 , v-font7 )
     5037               loc-type = entry ( 3 , v-font7 )
     5038             .
     5039         end.
     5040         when 2 then  do:
     5041             assign
     5042               loc-name = entry ( 1 , v-font7 )
     5043               loc-size = entry ( 2 , v-font7 )
     5044               loc-type = ""
     5045             .
     5046         end.
     5047         when 1 then do:
     5048             assign
     5049               loc-name = trim(entry ( 1 , v-font7 ))
     5050               loc-size = ""
     5051               loc-type = ""
     5052             .
     5053         end.
     5054       end case.
     5055     create temp-font.
     5056     assign
     5057       temp-font.fontnum  = 7
     5058       temp-font.fontname = trim(loc-name)
     5059       temp-font.fontsize = trim(loc-size)
     5060       temp-font.fonttype = trim(loc-type)
     5061       temp-font.v-row    = 62
     5062       temp-font.v-col    = 136
     5063       temp-font.v-row-lans = 43
     5064       temp-font.v-col-lans = 198
     5065     .
     5066     repeat ii = 16 to 100 :
     5067       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     5068       if v-font = "" or v-font = ? then leave.
     5069       case num-entries (v-font) :
     5070         when 4 then do:
     5071             assign
     5072               loc-name = entry ( 1 , v-font )
     5073               loc-size = entry ( 2 , v-font )
     5074               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     5075             .
     5076         end.
     5077         when 3 then do:
     5078             assign
     5079               loc-name = entry ( 1 , v-font )
     5080               loc-size = entry ( 2 , v-font )
     5081               loc-type = entry ( 3 , v-font )
     5082             .
     5083         end.
     5084         when 2 then do:
     5085             assign
     5086               loc-name = entry ( 1 , v-font )
     5087               loc-size = entry ( 2 , v-font )
     5088               loc-type = ""
     5089             .
     5090         end.
     5091         when 1 then do:
     5092             assign
     5093               loc-name = trim(entry ( 1 , v-font ))
     5094               loc-size = ""
     5095               loc-type = ""
     5096             .
     5097         end.
     5098       end case.
     5099     create temp-font.
     5100     assign
     5101       temp-font.fontnum  = ii
     5102       temp-font.fontname = trim(loc-name)
     5103       temp-font.fontsize = trim(loc-size)
     5104       temp-font.fonttype = trim(loc-type)
     5105     .
     5106     end.
     5107       for each temp-font :
     5108          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     5109          if  vv = ? then vv =  0 .
     5110           run rep/exfont.p (
     5111             input   temp-font.fontname ,
     5112             input   vv ,
     5113             input   temp-font.fonttype ,
     5114             output  temp-font.font-h   ,
     5115             output  temp-font.font-w   )
     5116           .
     5117       end.
     5118   find first temp-font where  temp-font.fontnum  = 7  .
     5119   old_H = temp-font.font-H .
     5120   old_w = temp-font.font-W .
     5121   old-row = temp-font.v-row .
     5122   old-col = temp-font.v-col .
     5123   old-row-lans = temp-font.v-row-lans .
     5124   old-col-lans = temp-font.v-col-lans .
     5125       for each temp-font where
     5126                temp-font.fontnum  <> 7 :
     5127           assign
     5128               temp-font.v-row    = old_H * old-row / temp-font.font-h
     5129               temp-font.v-col    = old_W * old-col / temp-font.font-W
     5130               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     5131               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     5132           .
     5133       end.
     5134     end.
     5135   end procedure.
     5136   PROCEDURE How-name :
     5137   define input  parameter h as integer no-undo .
     5138   define input  parameter w as integer no-undo .
     5139   define output parameter n as character  no-undo .
     5140   define variable A4port-H as integer   no-undo init 63.
     5141   define variable A4port-W as integer   no-undo init 136.
     5142   define variable A4lans-H as integer   no-undo init 43.
     5143   define variable A4lans-W as integer   no-undo init 198.
     5144   define variable Strim-W  as integer   no-undo init 278.
     5145   run define-a4-size (
     5146        input ReportFontNum
     5147       ,output A4port-H
     5148       ,output A4port-W
     5149       ,output A4lans-H
     5150       ,output A4lans-W ).
     5151   If w >= 1 and w <= A4port-W Then DO:
     5152     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     5153     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     5154     If h > A4port-H              Then n = "to-file":U.
     5155   End.
     5156   If w > A4port-W and w <= A4lans-W Then DO:
     5157     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     5158     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     5159     If h > A4port-H              Then n = "to-file":U.
     5160   End.
     5161   If w > A4lans-W and w <= Strim-W Then DO:
     5162     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     5163     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     5164     If h > A4port-H              Then n = "to-file":U.
     5165   End.
     5166   If w > Strim-W Then DO:
     5167      n = "to-file":U.
     5168   End.
     5169   END PROCEDURE.
     5170   PROCEDURE define-a4-size :
     5171   define input  parameter p-ReportFontNum as integer   no-undo .
     5172   define output parameter A4port-H as integer   no-undo .
     5173   define output parameter A4port-W as integer   no-undo .
     5174   define output parameter A4lans-H as integer   no-undo .
     5175   define output parameter A4lans-W as integer   no-undo .
     5176   if not can-find (first temp-font ) then do:
     5177      run get-font-ini .
     5178   end.
     5179   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     5180   if available temp-font then do:
     5181   assign
     5182     A4port-H = temp-font.v-row
     5183     A4port-W = temp-font.v-col
     5184     A4lans-H = temp-font.v-row-lans
     5185     A4lans-W = temp-font.v-col-lans
     5186   .
     5187   end.
     5188   else do:
     5189   assign
     5190     A4port-H = 63
     5191     A4port-W = 136
     5192     A4lans-H = 43
     5193     A4lans-W = 198
     5194   .
     5195   end.
     5196   END PROCEDURE.
     5197   do
     5198   on error undo, return error
     5199   :
     5200     DEFINE VARIABLE parParentProc     AS WIDGET-HANDLE NO-UNDO.
