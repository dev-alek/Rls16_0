     5252     define buffer buf_parts    for parts.
     5253     define  variable v-cur-qnty           as decimal   no-undo .
     5254     define  variable v-cur-base           as decimal   no-undo .
     5255     define  variable v-cur-VAT-base       as decimal   no-undo .
     5256     define  variable v-cur-SLT-base       as decimal   no-undo .
     5257     define  variable v-cur-road-tax-base  as decimal   no-undo .
     5258     define  variable v-cur-excise-base    as decimal   no-undo .
     5259     define variable all-fact-qnty  as decimal   no-undo .
     5260     define variable all-free-qnty  as decimal   no-undo .
     5261     define variable all-wait-qnty  as decimal   no-undo .
     5262     define variable all-zak-sum    as decimal   no-undo .
     5263     define variable all-naz-sum    as decimal   no-undo .
     5264     define variable all0-fact-qnty  as decimal   no-undo .
     5265     define variable all0-free-qnty  as decimal   no-undo .
     5266     define variable all0-wait-qnty  as decimal   no-undo .
     5267     define variable all0-zak-sum    as decimal   no-undo .
     5268     define variable all0-naz-sum    as decimal   no-undo .
     5269     define variable all1-fact-qnty  as decimal   no-undo .
     5270     define variable all1-free-qnty  as decimal   no-undo .
     5271     define variable all1-wait-qnty  as decimal   no-undo .
     5272     define variable all1-zak-sum    as decimal   no-undo .
     5273     define variable all1-naz-sum    as decimal   no-undo .
     5274     define variable all2-fact-qnty  as decimal   no-undo .
     5275     define variable all2-free-qnty  as decimal   no-undo .
     5276     define variable all2-wait-qnty  as decimal   no-undo .
     5277     define variable all2-zak-sum    as decimal   no-undo .
     5278     define variable all2-naz-sum    as decimal   no-undo .
     5279   DEFINE temp-table temp-gds no-undo
     5280       field   fact-qnty    as  decimal
     5281       field   free-qnty    as  decimal
     5282       field   wait-qnty    as  decimal
     5283       field   zak-price    as  decimal
     5284       field   prod-price   as  decimal
     5285       field   zak-sum      as  decimal
     5286       field   prod-sum     as  decimal
     5287       field   naz-sum      as  decimal
     5288       field   naz-prc      as  decimal
     5289       field   obj-type         as  char
     5290       field   obj-code         as  integer
     5291       field   obj-name         as  char
     5292       field   prod-type        as  char
     5293       field   prod-code        as  integer
     5294       field   post-type        as  char
     5295       field   post-code        as  integer
