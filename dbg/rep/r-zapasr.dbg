     2093       define variable varroot-nodeprl             as   integer                             no-undo.
     2094       define variable varempty-scaleprl           as   logical                             no-undo.
     2095       define variable varis-cons-parts-haveprl    as   logical                             no-undo.
     2096       define variable varsum-base-factovpprl      like ub.gds-dtl.price-base               no-undo.
     2097       define variable varslt-base-factovpprl      like ub.gds-dtl.price-base               no-undo.
     2098       define variable varvat-base-factovpprl      like ub.gds-dtl.price-base               no-undo.
     2099       define variable varvatcons-base-factovpprl  like ub.gds-dtl.price-base               no-undo.
     2100       define variable vardsc-base-factovpprl      like ub.gds-dtl.price-base               no-undo.
     2101       define variable varsum-base-docovpprl       like ub.gds-dtl.price-base               no-undo.
     2102       define variable varslt-base-docovpprl       like ub.gds-dtl.price-base               no-undo.
     2103       define variable varvat-base-docovpprl       like ub.gds-dtl.price-base               no-undo.
     2104       define variable varvatcons-base-docovpprl   like ub.gds-dtl.price-base               no-undo.
     2105       define variable vardsc-base-docovpprl       like ub.gds-dtl.price-base               no-undo.
     2106       define variable varsum-rubl-factovpprl      like ub.gds-dtl.price-base               no-undo.
     2107       define variable varslt-rubl-factovpprl      like ub.gds-dtl.price-base               no-undo.
     2108       define variable varvat-rubl-factovpprl      like ub.gds-dtl.price-base               no-undo.
     2109       define variable varvatcons-rubl-factovpprl  like ub.gds-dtl.price-base               no-undo.
     2110       define variable vardsc-rubl-factovpprl      like ub.gds-dtl.price-base               no-undo.
     2111       define variable varsum-rubl-docovpprl       like ub.gds-dtl.price-base               no-undo.
     2112       define variable varslt-rubl-docovpprl       like ub.gds-dtl.price-base               no-undo.
     2113       define variable varvat-rubl-docovpprl       like ub.gds-dtl.price-base               no-undo.
     2114       define variable varvatcons-rubl-docovpprl   like ub.gds-dtl.price-base               no-undo.
     2115       define variable vardsc-rubl-docovpprl       like ub.gds-dtl.price-base               no-undo.
     2116       define variable varfact-qntyprl             like ub.parts.fact-qnty                  no-undo.
     2117       define variable varcons-qntyprl             like ub.parts.fact-qnty                  no-undo.
     2118       define variable varis-one-gds-dtlprl        as   logical                             no-undo.
     2119       define variable varcurprlprice-base         like ub.gds-dtl.cur-base                 no-undo.
     2120       define variable varcurprlprice-rubl         like ub.gds-dtl.price-base               no-undo.
     2121       define variable varcurprldiscnt-base        like ub.gds-dtl.cur-base                 no-undo.
     2122       define variable varcurprldiscnt-rubl        like ub.gds-dtl.price-base               no-undo.
     2123       define variable varoutvprbprl               as   character                           no-undo.
     2124       define variable out-vatp-have-vat-sltprl    as   logical initial yes                 no-undo.
     2125       define buffer   in-vatp-trn-docoprl  for ub.trn-doc .
     2126       define buffer   in-vatp-partsoprl    for ub.parts   .
     2127       define buffer   in-vatp-docoprl      for ub.trn-doc .
     2128       define buffer   in-vatp-goodsoprl    for ub.goods   .
     2129       define buffer   in-vatp-sysconfoprl  for ub.sysconf .
     2130       define buffer   in-vatp_doc-attroprl for ub.doc-attr.
     2131       define variable in-vatp-have-vat-sltoprl       as   logical initial yes    no-undo.
     2132       define variable vat-pc-locoprl                 like ub.doc-line.vat-pc     no-undo.
     2133       define variable varinvprboprl                  as   character              no-undo.
     2134       define variable slt-pc-locoprl                 like ub.doc-line.slt-pc     no-undo.
     2135       define variable cli-base-rateoprl              as   decimal                no-undo.
     2136       define variable price-rubl-with-tax-locoprl    like ub.doc-line.price-rubl no-undo.
     2137       define variable price-base-with-tax-locoprl    like ub.doc-line.price-base no-undo.
     2138       define variable price-cli-with-tax-locoprl     like ub.doc-line.price-cli  no-undo.
     2139       define variable price-rubl-without-tax-locoprl like ub.doc-line.price-rubl no-undo.
     2140       define variable price-base-without-tax-locoprl like ub.doc-line.price-base no-undo.
     2141       define variable price-cli-without-tax-locoprl  like ub.doc-line.price-base no-undo.
     2142       define variable vat-base-locoprl               like ub.doc-line.price-base no-undo.
     2143       define variable vat-rubl-locoprl               like ub.doc-line.price-rubl no-undo.
     2144       define variable vat-cli-locoprl                like ub.doc-line.price-rubl no-undo.
     2145       define variable slt-base-locoprl               like ub.doc-line.price-base no-undo.
     2146       define variable slt-rubl-locoprl               like ub.doc-line.price-rubl no-undo.
     2147       define variable slt-cli-locoprl                like ub.doc-line.price-rubl no-undo.
     2148       define variable road-tax-base-locoprl          like ub.doc-line.road-tax   no-undo.
     2149       define variable road-tax-rubl-locoprl          like ub.doc-line.road-tax   no-undo.
     2150       define variable road-tax-cli-locoprl           like ub.doc-line.road-tax   no-undo.
     2151       define variable transport-base-locoprl         like ub.doc-line.price-base no-undo.
     2152       define variable transport-rubl-locoprl         like ub.doc-line.price-rubl no-undo.
     2153       define variable transport-cli-locoprl          like ub.doc-line.price-rubl no-undo.
     2154       define variable other-base-locoprl             like ub.doc-line.price-base no-undo.
     2155       define variable other-rubl-locoprl             like ub.doc-line.price-rubl no-undo.
     2156       define variable other-cli-locoprl              like ub.doc-line.price-rubl no-undo.
     2157       define variable exch-rate-cli-locoprl          like ub.trn-doc.exch-rate   no-undo.
     2158       define variable varinvatp-envdoprl             as   character              no-undo.
     2159       define variable varinvatp-typeoprl             as   character              no-undo.
     2160     define buffer bf_price-list for ub.price-list.
     2161     define buffer bf_goods      for ub.goods.
     2162     define buffer bf_sysconf    for ub.sysconf.
     2163     define buffer bf_parts      for ub.parts.
     2164     define variable varbase-rate   like ub.trn-doc.base-rate     no-undo.
     2165     define variable varbase-scale  like ub.trn-doc.base-scale    no-undo.
     2166     define variable varroad-tax    like ub.price-list.road-tax   no-undo.
     2167     define variable varexcise      like ub.price-list.excise     no-undo.
     2168     define variable varvat-pc      like ub.doc-line.vat-pc       no-undo.
     2169     define variable varslt-pc      like ub.doc-line.slt-pc       no-undo.
     2170     define variable varprice-base  like ub.price-list.price-sale no-undo.
     2171     define variable varprice-rubl  like ub.price-list.price-sale no-undo.
     2172     define variable vardiscnt-base like ub.price-list.price-sale no-undo.
     2173     define variable vardiscnt-rubl like ub.price-list.price-sale no-undo.
     2174     define variable v-host-code    like ub.sysconf.host-code     no-undo.
     2175     define variable vardoc-num     like ub.price-list.doc-num    no-undo.
     2176     define variable vardoc-code    like ub.price-list.doc-num    no-undo.
     2177     define variable varobj-type    like ub.price-list.obj-type   no-undo.
     2178     define variable varobj-code    like ub.price-list.obj-code   no-undo.
     2179     define variable varartic       like ub.price-list.artic      no-undo.
     2180     define variable varprod-type   like ub.price-list.prod-type  no-undo.
     2181     define variable varprod-code   like ub.price-list.prod-code  no-undo.
     2182     define variable varfact-qnty   like ub.price-list.doc-qnty   no-undo.
     2183     define variable varcons-vat-pc like ub.doc-line.vat-pc       no-undo.
     2184     define variable varext-doc-type like ub.trn-doc.ext-doc-type no-undo.
     2185     define variable vardoc-qnty     like ub.price-list.doc-qnty no-undo.
     2186     define variable vardoc-type     as   character              no-undo.
     2187     do
     2188     on error undo, return error "Ошибка при вызове процедуры prl-vat."
     2189     :
     2190       find first bf_price-list no-lock
     2191         where recid(bf_price-list) = parrecid
     2192         no-error .
     2193       if not available bf_price-list
     2194       then do:
     2195         return error "Ошибка во входящих параметрах prl-vat.i" .
     2196       end.
     2197       find first bf_goods no-lock
     2198         where bf_goods.artic     = bf_price-list.artic
     2199           and bf_goods.prod-type = bf_price-list.prod-type
     2200           and bf_goods.prod-code = bf_price-list.prod-code
     2201         no-error .
     2202       if not available bf_goods
     2203       then do:
     2204         undo, return error substitute("Не найден товар &1 &2 &3 для переоценки с кодом &4",bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code,parrecid).
     2205       end.
     2206       assign
     2207         varvat-pc = bf_price-list.vat-pc
     2208         varslt-pc = bf_price-list.slt-pc
     2209       .
     2210       if varvat-pc = ?
     2211       then do:
     2212         undo, return error substitute("В переоценке &1 для товара &2 &3 &4 не задан НДС",bf_price-list.doc-num,bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code).
     2213       end.
     2214       if varslt-pc = ?
     2215       then do:
     2216         undo, return error substitute("В переоценке &1 для товара &2 &3 &4 не задан НП",bf_price-list.doc-num,bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code).
     2217       end.
     2218       assign
     2219         varbase-rate   = 1
     2220         varbase-scale  = 1
     2221         varroad-tax    = bf_price-list.road-tax
     2222         varexcise      = bf_price-list.excise
     2223         varprice-base  = bf_price-list.price-sale
     2224         varprice-rubl  = bf_price-list.price-sale
