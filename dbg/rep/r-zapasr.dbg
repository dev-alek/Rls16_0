     4331       field calc-method   as character
     4332       field round-method  as character
     4333       field increase-pc   as decimal
     4334       field min-marg      as character
     4335       field max-marg      as character
     4336       field cli-type      as character
     4337       field cli-code      as integer
     4338       field notcorr      as character
