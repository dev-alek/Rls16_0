     6253           if last-of(temp-gds.post-code) then do:
     6254             run PrintItog ("Всего по поставщику " + buf_clients.obj-name, all2-fact-qnty, all2-free-qnty, all2-zak-sum, all2-naz-sum, all2-wait-qnty, 2).
     6255           end.
     6256           if last-of(temp-gds.grp-name) then do:
     6257             run PrintItog ("Всего по группе " + temp-gds.grp-name, all1-fact-qnty, all1-free-qnty, all1-zak-sum, all1-naz-sum, all1-wait-qnty, 1).
     6258           end.
     6259         end.
     6260       end.
     6261     end.
     6262   end procedure.
     6263   procedure Run8 :
     6264     do on error undo, return error return-value :
     6265       if tog-obj then do:
     6266         for each temp-gds break by temp-gds.obj-type by temp-gds.obj-code by temp-gds.vat-pc by if xSortType = "sort-code" then  temp-gds.sb-code Else (if xSortType = "sort-artic" then  temp-gds.artic Else  temp-gds.gds-name) :
     6267           if first-of(temp-gds.obj-code) then run PrintName ( temp-gds.obj-name ) .
     6268           if first-of(temp-gds.vat-pc) then run PrintName ( "НДС " + string(temp-gds.vat-pc) + " %" ) .
     6269           run PrintLine        in this-procedure .
     6270           if last-of(temp-gds.vat-pc) then run PrintItog ("Всего по НДС " + string(temp-gds.vat-pc) + " %", all1-fact-qnty, all1-free-qnty, all1-zak-sum, all1-naz-sum, all1-wait-qnty, 1).
     6271           if last-of(temp-gds.obj-code) then  run PrintItog ("Всего по объекту " + temp-gds.obj-name, all0-fact-qnty, all0-free-qnty, all0-zak-sum, all0-naz-sum, all0-wait-qnty, 3).
     6272         end.
     6273       end.
     6274       else do:
     6275         for each temp-gds break by temp-gds.vat-pc by if xSortType = "sort-code" then  temp-gds.sb-code Else (if xSortType = "sort-artic" then  temp-gds.artic Else  temp-gds.gds-name) :
     6276           if first-of(temp-gds.vat-pc) then run PrintName ( "НДС " + string(temp-gds.vat-pc) + " %" ) .
     6277           run PrintLine        in this-procedure .
     6278           if last-of(temp-gds.vat-pc) then run PrintItog ("Всего по НДС " + string(temp-gds.vat-pc) + " %", all1-fact-qnty, all1-free-qnty, all1-zak-sum, all1-naz-sum, all1-wait-qnty, 1).
     6279         end.
     6280       end.
     6281     end.
     6282   end procedure.
     6283   procedure CalcWaitQnty :
     6284     do on error undo, return error return-value :
     6285       define input  parameter p-ext-doc-type as character no-undo .
     6286       define buffer buf_doc-line for doc-line .
     6287       define buffer buf_parts for parts .
     6288       for each buf_doc-line no-lock
     6289         where buf_doc-line.obj-type     = obj-list.obj-type
     6290           and buf_doc-line.obj-code     = obj-list.obj-code
     6291           and buf_doc-line.prod-type    = buf_gds-obj.prod-type
     6292           and buf_doc-line.prod-code    = buf_gds-obj.prod-code
     6293           and buf_doc-line.artic        = buf_gds-obj.artic
     6294           and buf_doc-line.ext-doc-type = p-ext-doc-type
     6295           and buf_doc-line.status_      = 'накл':U
     6296         :
     6297         for each buf_parts no-lock
     6298           where buf_parts.out-code     = buf_doc-line.doc-code
     6299             and buf_parts.obj-type     = buf_doc-line.obj-type
     6300             and buf_parts.obj-code     = buf_doc-line.obj-code
     6301             and buf_parts.prod-type    = buf_doc-line.prod-type
     6302             and buf_parts.prod-code    = buf_doc-line.prod-code
     6303             and buf_parts.artic        = buf_doc-line.artic
     6304           :
     6305           if ( p-ext-doc-type = 'vt':U or p-ext-doc-type = 'vp':U ) and buf_parts.fact-qnty <= 0 then next .
     6306           if tog-obj = true then do:
     6307             find first temp-gds
     6308               where temp-gds.prod-type = buf_parts.prod-type
     6309                 and temp-gds.prod-code = buf_parts.prod-code
     6310                 and temp-gds.artic     = buf_parts.artic
     6311                 and temp-gds.in-code   = buf_parts.in-code
     6312                 and temp-gds.part-code = buf_parts.part-code
     6313                 and temp-gds.obj-type  = buf_parts.obj-type
     6314                 and temp-gds.obj-code  = buf_parts.obj-code
     6315             no-error .
     6316           end.
     6317           else do:
     6318             find first temp-gds
     6319               where temp-gds.prod-type = buf_parts.prod-type
     6320                 and temp-gds.prod-code = buf_parts.prod-code
     6321                 and temp-gds.artic     = buf_parts.artic
     6322                 and temp-gds.in-code   = buf_parts.in-code
     6323                 and temp-gds.part-code = buf_parts.part-code
     6324             no-error .
     6325           end.
     6326           if not available temp-gds then do:
     6327             run CreateGDS ( buf_parts.artic, buf_parts.prod-type, buf_parts.prod-code, buf_parts.in-code, buf_parts.part-code, buf_parts.supp-type, buf_parts.supp-code) .
     6328           end.
     6329           assign temp-gds.wait-qnty = temp-gds.wait-qnty + buf_parts.fact-qnty  .
     6330         end.
     6331       end.
     6332     end.
     6333   end procedure.
     6334   procedure CreateGDS :
     6335     do on error undo, return error return-value :
     6336       define input  parameter p-artic     like parts.artic     no-undo.
     6337       define input  parameter p-prod-type like parts.prod-type no-undo.
     6338       define input  parameter p-prod-code like parts.prod-code no-undo.
     6339       define input  parameter p-in-code   like parts.in-code   no-undo.
     6340       define input  parameter p-part-code like parts.part-code no-undo.
     6341       define input  parameter p-supp-type like parts.supp-type no-undo.
     6342       define input  parameter p-supp-code like parts.supp-code no-undo.
     6343       find first buf_goods no-lock where buf_goods.artic = p-artic and buf_goods.prod-type = p-prod-type and buf_goods.prod-code = p-prod-code .
     6344       create temp-gds .
     6345   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     6346     (input  buf_goods.gds-code
     6347     ,input  ?
     6348     ,output temp-gds.b-code
     6349     ) no-error .
     6350       if error-status :error then do:
     6351         message   vss-workfile vss-revision vss-description skip
     6352           "Ошибка при определении бар-кода товара" skip   "Артикул товара" skip buf_goods.artic
     6353         view-as alert-box error .
     6354       end.
     6355       else assign temp-gds.sb-code = string(temp-gds.b-code) .
     6356   define variable vss-include-info51 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6357   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     6358     (input  buf_goods.gds-code
     6359     ,input  '1':U
     6360     ,input  ?
     6361     ,input  v-cntxt-host-code-obj
     6362     ,input  obj-list.obj-type
     6363     ,input  obj-list.obj-code
     6364     ,output temp-gds.vat-pc
     6365     ) no-error .
     6366       assign
     6367         temp-gds.prod-type = buf_goods.prod-type
     6368         temp-gds.prod-code = buf_goods.prod-code
     6369         temp-gds.post-type = p-supp-type
     6370         temp-gds.post-code = p-supp-code
     6371         temp-gds.artic     = buf_goods.artic
     6372         temp-gds.grp-name  = trim( buf_goods.grp-name )
     6373         temp-gds.grp-code  = buf_goods.grp-code
     6374         temp-gds.obj-type  = obj-list.obj-type
     6375         temp-gds.obj-code  = obj-list.obj-code
     6376         temp-gds.obj-name  = obj-list.obj-name
     6377         temp-gds.unit-base = buf_goods.unit-base
     6378         temp-gds.gds-name1 = buf_goods.engl-name
     6379         temp-gds.gds-name  = buf_goods.gds-name
     6380         temp-gds.in-code   = p-in-code
     6381         temp-gds.part-code = p-part-code
     6382       .
     6383     end.
     6384   end procedure.
     6385   procedure ColumnTitle :
     6386     do on error undo, return error return-value :
     6387       put stream outstream  skip cur-time-print() format "x(35)"   "Цены указаны в "  (if x-SET_val_TYPE = 1 then "РУБ" else x-base-type )  string( "Страница" ) AT 100 PAGE-NUMBER( outstream ) FORMAT ">>>9" SKIP .
     6388       put stream outstream   Line format frmt skip .
     6389       if use-column[1]  = yes then  PUT stream OutStream  "|"  "№ п/п"              format "X(5)"  .
     6390       if use-column[2]  = yes then  PUT stream OutStream  "|"  "  Код"              format "X(10)" .
     6391       if use-column[3]  = yes then  PUT stream OutStream  "|"  "  Артикул"          format "X(16)" .
     6392       if use-column[4]  = yes then  PUT stream OutStream  "|"  "  Название товара"  format "X(40)" .
     6393       if use-column[5]  = yes then  PUT stream OutStream  "|"  "Ед."                format "X(3)"  .
     6394       if use-column[6]  = yes then  PUT stream OutStream  "|"   "Фактическое"       format "X(14)" .
     6395       if use-column[7]  = yes then  PUT stream OutStream  "|"   "Свободное"         format "X(14)" .
     6396       if use-column[8]  = yes then  PUT stream OutStream  "|"   "Учетная"           format "X(15)" .
     6397       if use-column[9]  = yes then  PUT stream OutStream  "|"   "Продажная"         format "X(15)" .
     6398       if use-column[10] = yes then  PUT stream OutStream  "|"   "Сумма в учет."     format "X(15)" .
     6399       if use-column[11] = yes then  PUT stream OutStream  "|"   "Сумма"             format "X(15)" .
     6400       if use-column[12] = yes then  PUT stream OutStream  "|"   "Процент"           format "X(9)"  .
     6401       if use-column[13] = yes then  PUT stream OutStream  "|"   "Ожидаемое"         format "X(13)" .
     6402       PUT stream OutStream "|"   skip .
     6403       if use-column[1]  = yes then  PUT stream OutStream  "|"  ""                   format "X(5)"  .
     6404       if use-column[2]  = yes then  PUT stream OutStream  "|"  ""                   format "X(10)" .
     6405       if use-column[3]  = yes then  PUT stream OutStream  "|"  ""                   format "X(16)" .
     6406       if use-column[4]  = yes then  PUT stream OutStream  "|"  ""                   format "X(40)" .
     6407       if use-column[5]  = yes then  PUT stream OutStream  "|"  "изм"                format "X(3)"  .
     6408       if use-column[6]  = yes then  PUT stream OutStream  "|"   "кол-во"            format "X(14)" .
     6409       if use-column[7]  = yes then  PUT stream OutStream  "|"   "кол-во"            format "X(14)" .
     6410       if use-column[8]  = yes then  PUT stream OutStream  "|"   "цена с НДС"        format "X(15)" .
     6411       if use-column[9]  = yes then  PUT stream OutStream  "|"   "цена"              format "X(15)" .
     6412       if use-column[10] = yes then  PUT stream OutStream  "|"   "ценах с НДС"       format "X(15)" .
     6413       if use-column[11] = yes then  PUT stream OutStream  "|"   "наценки"           format "X(15)" .
     6414       if use-column[12] = yes then  PUT stream OutStream  "|"   "наценки"           format "X(9)"  .
     6415       if use-column[13] = yes then  PUT stream OutStream  "|"   "кол-во"            format "X(13)" .
     6416       put stream outstream "|" skip  Line format frmt skip .
     6417     end.
     6418   end procedure.
     6419   procedure is-page :
     6420     do on error undo, return error return-value :
     6421       if line-counter( Outstream ) + 2 > page-size( Outstream ) then do:
     6422         put stream outstream  skip Line format frmt skip "продолжение - на следующей странице" AT 30 SKIP .
     6423         page stream OutStream .
     6424         run ColumnTitle .
     6425       end.
     6426     end.
     6427   end procedure.
     6428   procedure PrintLine :
     6429     do on error undo, return error return-value :
     6430       if temp-gds.fact-qnty <> 0 then do:
     6431         assign
     6432           temp-gds.zak-price  = temp-gds.zak-sum  / abs ( temp-gds.fact-qnty)
     6433           temp-gds.prod-price = temp-gds.prod-sum / abs ( temp-gds.fact-qnty)
     6434         .
     6435       end.
     6436       assign
     6437         temp-gds.naz-sum    = temp-gds.prod-sum - temp-gds.zak-sum
     6438         temp-gds.naz-prc    = if temp-gds.zak-sum = 0 then 0 else temp-gds.naz-sum * 100 / temp-gds.zak-sum
     6439       .
     6440       if xClassify = "prod/grp-goods":U or xClassify = "grp-goods/prod":U or xClassify = "post/grp-goods":U or xClassify = "grp-goods/post":U then DO:
     6441         assign
     6442           all2-fact-qnty      = all2-fact-qnty + temp-gds.fact-qnty
     6443           all2-free-qnty      = all2-free-qnty + temp-gds.free-qnty
     6444           all2-wait-qnty      = all2-wait-qnty + temp-gds.wait-qnty
     6445           all2-zak-sum        = all2-zak-sum   + temp-gds.zak-sum
     6446           all2-naz-sum        = all2-naz-sum   + temp-gds.naz-sum
     6447         .
     6448       end.
     6449       else do:
     6450         if xClassify = "no-classify":U  then DO:
     6451           assign
     6452             all-fact-qnty      = all-fact-qnty + temp-gds.fact-qnty
     6453             all-free-qnty      = all-free-qnty + temp-gds.free-qnty
     6454             all-wait-qnty      = all-wait-qnty + temp-gds.wait-qnty
     6455             all-zak-sum        = all-zak-sum   + temp-gds.zak-sum
     6456             all-naz-sum        = all-naz-sum   + temp-gds.naz-sum
     6457           .
     6458         end.
     6459         else do:
     6460           assign
     6461             all1-fact-qnty      = all1-fact-qnty + temp-gds.fact-qnty
     6462             all1-free-qnty      = all1-free-qnty + temp-gds.free-qnty
     6463             all1-wait-qnty      = all1-wait-qnty + temp-gds.wait-qnty
     6464             all1-zak-sum        = all1-zak-sum   + temp-gds.zak-sum
     6465             all1-naz-sum        = all1-naz-sum   + temp-gds.naz-sum
     6466           .
     6467         end.
     6468       end.
     6469       assign
     6470         all0-fact-qnty      = all0-fact-qnty + temp-gds.fact-qnty
     6471         all0-free-qnty      = all0-free-qnty + temp-gds.free-qnty
     6472         all0-wait-qnty      = all0-wait-qnty + temp-gds.wait-qnty
     6473         all0-zak-sum        = all0-zak-sum   + temp-gds.zak-sum
     6474         all0-naz-sum        = all0-naz-sum   + temp-gds.naz-sum
     6475       .
     6476       if xSumsOnly = no then do:
     6477         assign num-line = num-line + 1 .
     6478         run is-page .
     6479         if use-column[1]  = yes then do:
     6480           PUT stream OutStream  "|"   num-line   format ">>>>9" .
     6481           if Make-Excel then  put   stream ForExcel unformatted  string(num-line)   CHR(9) .
     6482         end.
     6483         if use-column[2]  = yes then do:
     6484           PUT stream OutStream  "|"   temp-gds.sb-code     format "X(10)" .
     6485           if Make-Excel then  put   stream ForExcel unformatted  temp-gds.sb-code   CHR(9) .
     6486         end.
     6487         if use-column[3]  = yes then do:
     6488           PUT stream OutStream  "|"   temp-gds.artic       format "X(16)" .
     6489           if Make-Excel then  put   stream ForExcel unformatted  temp-gds.artic   CHR(9) .
     6490         end.
     6491         if use-column[4]  = yes then do:
     6492           PUT stream OutStream  "|"   temp-gds.gds-name    format "X(40)" .
     6493           if Make-Excel then  put   stream ForExcel unformatted  temp-gds.gds-name   CHR(9) .
     6494         end.
     6495         if use-column[5]  = yes then do:
     6496           PUT stream OutStream  "|"   temp-gds.unit-base   format "X(3)" .
     6497           if Make-Excel then  put   stream ForExcel unformatted   temp-gds.unit-base  CHR(9) .
     6498         end.
     6499         if use-column[6]  = yes then do:
     6500           PUT stream OutStream  "|"   temp-gds.fact-qnty   format "->>>>>>>>9.999" .
     6501           if Make-Excel then  put   stream ForExcel unformatted  excel-qnty ( temp-gds.fact-qnty )   CHR(9) .
     6502         end.
     6503         if use-column[7]  = yes then do:
     6504           PUT stream OutStream  "|"   temp-gds.free-qnty   format "->>>>>>>>9.999".
     6505           if Make-Excel then  put   stream ForExcel unformatted  excel-qnty ( temp-gds.free-qnty )   CHR(9) .
     6506         end.
     6507         if use-column[8]  = yes then do:
     6508           PUT stream OutStream  "|"   temp-gds.zak-price   format "->>>>>>>>>>9.99" .
     6509           if Make-Excel then  put   stream ForExcel unformatted  excel-sum ( temp-gds.zak-price )  CHR(9) .
     6510         end.
     6511         if use-column[9]  = yes then do:
     6512           PUT stream OutStream  "|"   temp-gds.prod-price  format "->>>>>>>>>>9.99" .
     6513           if Make-Excel then  put   stream ForExcel unformatted  excel-sum ( temp-gds.prod-price )  CHR(9) .
     6514         end.
     6515         if use-column[10] = yes then do:
     6516           PUT stream OutStream  "|"   temp-gds.zak-sum     format "->>>>>>>>>>9.99" .
     6517           if Make-Excel then  put   stream ForExcel unformatted  excel-sum ( temp-gds.zak-sum )  CHR(9) .
     6518         end.
     6519         if use-column[11] = yes then do:
     6520           PUT stream OutStream  "|"   temp-gds.naz-sum     format "->>>>>>>>>>9.99" .
     6521           if Make-Excel then  put   stream ForExcel unformatted  excel-sum ( temp-gds.naz-sum )  CHR(9) .
     6522         end.
     6523         if use-column[12] = yes then do:
     6524           PUT stream OutStream  "|"   temp-gds.naz-prc     format "->>>>9.99" .
     6525           if Make-Excel then  put   stream ForExcel unformatted  excel-sum ( temp-gds.naz-prc )  CHR(9) .
     6526         end.
     6527         if use-column[13] = yes then do:
     6528           PUT stream OutStream  "|"   temp-gds.wait-qnty   format "->>>>>>>9.999" .
     6529          if Make-Excel then  put   stream ForExcel unformatted  excel-qnty ( temp-gds.wait-qnty )   CHR(9) .
     6530         end.
     6531         if Make-Excel then  put   stream ForExcel unformatted chr(10) .
     6532         PUT stream OutStream "|" skip  .
     6533       end.
     6534     end.
     6535   end procedure.
     6536   procedure PrintName :
     6537     do on error undo, return error return-value :
     6538       define input  parameter str           as character no-undo .
     6539       run is-page .
     6540       PUT stream OutStream  "|"  str format frmt1 "|" skip .
     6541       if Make-Excel then  put   stream ForExcel unformatted   str  chr(10) .
     6542     end.
     6543   end procedure.
     6544   procedure PrintItog :
     6545     do on error undo, return error return-value :
     6546     define input  parameter str           as character no-undo .
     6547     define input  parameter sum-fact-qnty as decimal   no-undo .
     6548     define input  parameter sum-free-qnty as decimal   no-undo .
     6549     define input  parameter sum-zak-sum   as decimal   no-undo .
     6550     define input  parameter sum-naz-sum   as decimal   no-undo .
     6551     define input  parameter sum-wait-qnty as decimal   no-undo .
     6552     define input  parameter  level        as integer   no-undo .
     6553       run is-page .
     6554       put stream outstream   Line format frmt skip .
     6555       run is-page .
     6556       PUT stream OutStream  "|"  str  format frmt2 .
     6557       do i = 1 to 5 :
     6558         if i = 3 and use-column[3] then  if Make-Excel then  put   stream ForExcel unformatted   str .
     6559         if use-column[i]  = yes then   if Make-Excel then  put   stream ForExcel unformatted   CHR(9)  .
     6560       end.
     6561       if use-column[6]  = yes then do:
     6562         PUT stream OutStream  "|"   sum-fact-qnty   format "->>>>>>>>9.999" .
     6563        if Make-Excel then  put   stream ForExcel unformatted  excel-qnty ( sum-fact-qnty )   CHR(9) .
     6564       end.
     6565       if use-column[7]  = yes then do:
     6566         PUT stream OutStream  "|"   sum-free-qnty   format "->>>>>>>>9.999".
     6567        if Make-Excel then  put   stream ForExcel unformatted  excel-qnty ( sum-free-qnty )   CHR(9) .
     6568       end.
     6569       if use-column[8]  = yes then do:
     6570         PUT stream OutStream  "|"   format "X(16)" .
     6571        if Make-Excel then  put   stream ForExcel unformatted  CHR(9) .
     6572       end.
     6573       if use-column[9]  = yes then do:
     6574         PUT stream OutStream  "|"   format "X(16)" .
     6575        if Make-Excel then  put   stream ForExcel unformatted  CHR(9) .
     6576       end.
     6577       if use-column[10] = yes then do:
     6578         PUT stream OutStream  "|"   sum-zak-sum     format "->>>>>>>>>>9.99" .
     6579        if Make-Excel then  put   stream ForExcel unformatted  excel-sum ( sum-zak-sum )  CHR(9) .
     6580       end.
     6581       if use-column[11] = yes then do:
     6582         PUT stream OutStream  "|"   sum-naz-sum     format "->>>>>>>>>>9.99" .
     6583        if Make-Excel then  put   stream ForExcel unformatted  excel-sum ( sum-naz-sum )  CHR(9) .
     6584       end.
     6585       if use-column[12] = yes then do:
     6586         PUT stream OutStream  "|"   format "X(10)" .
     6587        if Make-Excel then  put   stream ForExcel unformatted  CHR(9) .
     6588       end.
     6589       if use-column[13] = yes then do:
     6590         PUT stream OutStream  "|"   sum-wait-qnty   format "->>>>>>>9.999" .
     6591        if Make-Excel then  put   stream ForExcel unformatted  excel-qnty ( sum-wait-qnty )   CHR(9) .
     6592       end.
     6593       if Make-Excel then  put   stream ForExcel unformatted chr(10) .
     6594       PUT stream OutStream "|" skip  .
     6595       run is-page .
     6596       put stream outstream   Line format frmt skip .
     6597       case level :
     6598         when 0 then do:
     6599         end.
     6600         when 1 then do:
     6601           assign
     6602             all-fact-qnty  = all-fact-qnty + all1-fact-qnty
     6603             all-free-qnty  = all-free-qnty + all1-free-qnty
     6604             all-wait-qnty  = all-wait-qnty + all1-wait-qnty
     6605             all-zak-sum    = all-zak-sum   + all1-zak-sum
     6606             all-naz-sum    = all-naz-sum   + all1-naz-sum
     6607             all1-fact-qnty = 0
     6608             all1-free-qnty = 0
     6609             all1-wait-qnty = 0
     6610             all1-zak-sum   = 0
     6611             all1-naz-sum   = 0
     6612           .
     6613         end.
     6614         when 2 then do:
     6615           assign
     6616             all1-fact-qnty  = all1-fact-qnty + all2-fact-qnty
     6617             all1-free-qnty  = all1-free-qnty + all2-free-qnty
     6618             all1-wait-qnty  = all1-wait-qnty + all2-wait-qnty
     6619             all1-zak-sum    = all1-zak-sum   + all2-zak-sum
     6620             all1-naz-sum    = all1-naz-sum   + all2-naz-sum
     6621             all2-fact-qnty = 0
     6622             all2-free-qnty = 0
     6623             all2-wait-qnty = 0
     6624             all2-zak-sum   = 0
     6625             all2-naz-sum   = 0
     6626           .
     6627         end.
     6628         when 3 then do:
     6629           assign
     6630             all0-fact-qnty = 0
     6631             all0-free-qnty = 0
     6632             all0-wait-qnty = 0
     6633             all0-zak-sum   = 0
     6634             all0-naz-sum   = 0
     6635           .
     6636         end.
     6637       end case.
     6638     end.
     6639   end procedure.
