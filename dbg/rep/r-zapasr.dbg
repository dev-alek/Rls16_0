     3263           p-fact-qnty         = buf_main_price-list.doc-qnty
     3264           p-cur-base          = price-rubl-with-tax-sale-prl * buf_main_price-list.doc-qnty
     3265           p-cur-VAT-base      = vat-rubl-sale-prl * buf_main_price-list.doc-qnty
     3266           p-cur-SLT-base      = slt-rubl-sale-prl * buf_main_price-list.doc-qnty
     3267           p-cur-road-tax-base = road-tax-rubl-sale-prl * buf_main_price-list.doc-qnty
     3268           p-cur-excise-base   = excise-rubl-sale-prl * buf_main_price-list.doc-qnty
     3269         .
     3270       end.
     3271         define variable v-unit-base like ub.goods.unit-base no-undo .
     3272   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3273   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     3274     (input  buf_goods.gds-code
     3275     ,output v-unit-base
     3276     ) no-error .
     3277         if error-status :error
     3278         then do:
     3279           message
     3280             vss-workfile vss-revision vss-description skip
     3281             vss-include-info24 skip
     3282             "Ошибка при определении базовой единицы измерения товара" skip
     3283             "Код товара" buf_goods.gds-code skip
     3284             error-status :get-message(1) skip
     3285             return-value skip
     3286             view-as alert-box error .
     3287           undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     3288         end.
     3289         for each buf_price-list no-lock
     3290           where buf_price-list.doc-num    = buf_main_price-list.doc-num
     3291             and buf_price-list.main-price = false
     3292             and buf_price-list.artic      = buf_main_price-list.artic
     3293             and buf_price-list.prod-type  = buf_main_price-list.prod-type
     3294             and buf_price-list.prod-code  = buf_main_price-list.prod-code
     3295         :
     3296           if buf_price-list.doc-qnty = ?
     3297           then do:
     3298             find first buf_bar-code no-lock
     3299               where buf_bar-code.b-code = buf_price-list.b-code
     3300               no-error .
     3301             if available buf_bar-code
     3302             and buf_bar-code.unit-cli = v-unit-base
     3303             then do:
     3304               message
     3305                 vss-workfile vss-revision vss-description skip
     3306                 vss-include-info24 skip
     3307                 "Ошибка при закрытии переоценки" skip
     3308                 "Не задано количество для бар-кода с основной единицей измерения" skip
     3309                 "Переоценка" buf_main_price-list.doc-num skip
     3310                 "Бар-код" buf_price-list.b-code skip
     3311                 "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     3312                 "Количество" buf_price-list.doc-qnty skip
     3313                 "Основная единица измерения" v-unit-base skip
     3314                 "Единица измерения бар-кода" buf_bar-code.unit-cli skip
     3315                 view-as alert-box error .
     3316               undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     3317             end.
     3318             next .
     3319           end.
     3320           if not can-find
     3321             (first buf_bar-code
     3322             where buf_bar-code.b-code = buf_price-list.b-code
     3323             )
     3324           then do:
     3325             message
     3326               vss-workfile vss-revision vss-description skip
     3327               vss-include-info24 skip
     3328               "В переоценке задан несуществующий бар-код" skip
     3329               "Переоценка" buf_price-list.doc-num skip
     3330               "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
     3331               "Бар-код" buf_price-list.b-code skip
     3332               view-as alert-box error .
     3333             undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     3334           end.
     3335           if buf_price-list.doc-qnty <> 0
     3336           then do:
     3337             run prl-vat in this-procedure
     3338               (input  recid(buf_price-list)
     3339               ,output price-rubl-with-tax-sale-prl
     3340               ,output price-base-with-tax-sale-prl
     3341               ,output price-rubl-without-tax-sale-prl
     3342               ,output price-base-without-tax-sale-prl
     3343               ,output vat-base-sale-prl
     3344               ,output vat-rubl-sale-prl
     3345               ,output vat-base-buyer-prl
     3346               ,output vat-rubl-buyer-prl
     3347               ,output slt-base-sale-prl
     3348               ,output slt-rubl-sale-prl
     3349               ,output road-tax-base-sale-prl
     3350               ,output road-tax-rubl-sale-prl
     3351               ,output excise-base-sale-prl
     3352               ,output excise-rubl-sale-prl
     3353               ,output discnt-base-sale-prl
     3354               ,output discnt-rubl-sale-prl
     3355               ) no-error .
     3356             if error-status :error
     3357             then do:
     3358               message
     3359                 vss-workfile vss-revision vss-description skip
     3360                 vss-include-info24 skip
     3361                 "Ошибка при вызове процеды prl-vat" skip
     3362                 "Документ" buf_price-list.doc-num skip
     3363                 "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
     3364                 error-status :get-message(1) skip
     3365                 return-value skip
     3366                 view-as alert-box error .
     3367               undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     3368             end.
     3369           end.
     3370           else do:
     3371             assign
     3372               price-rubl-with-tax-sale-prl    = 0
     3373               price-base-with-tax-sale-prl    = 0
     3374               price-rubl-without-tax-sale-prl = 0
     3375               price-base-without-tax-sale-prl = 0
     3376               vat-base-sale-prl               = 0
     3377               vat-rubl-sale-prl               = 0
     3378               vat-base-buyer-prl              = 0
     3379               vat-rubl-buyer-prl              = 0
     3380               slt-base-sale-prl               = 0
     3381               slt-rubl-sale-prl               = 0
     3382               road-tax-base-sale-prl          = 0
     3383               road-tax-rubl-sale-prl          = 0
     3384               excise-base-sale-prl            = 0
     3385               excise-rubl-sale-prl            = 0
     3386               discnt-base-sale-prl            = 0
     3387               discnt-rubl-sale-prl            = 0
     3388             .
     3389           end.
     3390           if v-curr-r-b = 'base':U
     3391           then do:
     3392             assign
     3393               p-fact-qnty         = p-fact-qnty
     3394                                   + buf_price-list.doc-qnty
     3395               p-cur-base          = p-cur-base
     3396                                   + price-base-with-tax-sale-prl * buf_price-list.doc-qnty
     3397               p-cur-VAT-base      = p-cur-VAT-base
     3398                                   + vat-base-sale-prl * buf_price-list.doc-qnty
     3399               p-cur-SLT-base      = p-cur-SLT-base
     3400                                   + slt-base-sale-prl * buf_price-list.doc-qnty
     3401               p-cur-road-tax-base = p-cur-road-tax-base
     3402                                   + road-tax-base-sale-prl * buf_price-list.doc-qnty
     3403               p-cur-excise-base   = p-cur-excise-base
     3404                                   + excise-base-sale-prl * buf_price-list.doc-qnty
     3405             .
     3406           end.
     3407           else do:
     3408             assign
     3409               p-fact-qnty         = p-fact-qnty
     3410                                   + buf_price-list.doc-qnty
     3411               p-cur-base          = p-cur-base
     3412                                   + price-rubl-with-tax-sale-prl * buf_price-list.doc-qnty
     3413               p-cur-VAT-base      = p-cur-VAT-base
     3414                                   + vat-rubl-sale-prl * buf_price-list.doc-qnty
     3415               p-cur-SLT-base      = p-cur-SLT-base
     3416                                   + slt-rubl-sale-prl * buf_price-list.doc-qnty
     3417               p-cur-road-tax-base = p-cur-road-tax-base
     3418                                   + road-tax-rubl-sale-prl * buf_price-list.doc-qnty
     3419               p-cur-excise-base   = p-cur-excise-base
     3420                                   + excise-rubl-sale-prl * buf_price-list.doc-qnty
     3421             .
     3422           end.
     3423         end.
     3424     end.
     3425   end procedure.
     3426   procedure prdoclib-calc-prc :
     3427     define input  parameter p-price-doc-recid as   recid                  no-undo.
     3428     define input  parameter p-cons-pay        as   integer                no-undo.
     3429     define output parameter p-ov-cons         like ub.doc-line.price-base no-undo.
     3430     define output parameter p-ov-VAT-cons     like ub.doc-line.price-base no-undo.
     3431     define output parameter p-ov-SLT-cons     like ub.doc-line.price-base no-undo.
     3432     define output parameter p-ov-prch         like ub.doc-line.price-base no-undo.
     3433     define output parameter p-ov-VAT-prch     like ub.doc-line.price-base no-undo.
     3434     define output parameter p-ov-SLT-prch     like ub.doc-line.price-base no-undo.
     3435     do
     3436     on error undo, return error return-value
     3437     :
     3438       define buffer buf_price-doc       for ub.price-doc .
     3439       define buffer buf_price-list      for ub.price-list .
     3440       define buffer buf_parts           for ub.parts .
     3441       define variable v-ov-qnty     as decimal   no-undo .
     3442       define variable v-ov-base     as decimal   no-undo .
     3443       define variable v-ov-VAT-base as decimal   no-undo .
     3444       define variable v-ov-SLT-base as decimal   no-undo .
     3445       define variable v-cons-qnty   as decimal   no-undo .
     3446       define variable v-prch-qnty   as decimal   no-undo .
     3447       define variable v-cons-mult   as decimal   no-undo .
     3448       define variable v-prch-mult   as decimal   no-undo .
     3449       find first buf_price-doc no-lock
     3450         where recid(buf_price-doc) = p-price-doc-recid
     3451         no-error .
     3452       if not available buf_price-doc
     3453       then do:
     3454         message
     3455           vss-workfile vss-revision vss-description skip
     3456           vss-include-info24 skip
     3457           "Ошибка задания входных параметров" skip
     3458           "Не найден документ переоценки" skip
     3459           "Код записи (recid)" p-price-doc-recid skip
     3460           view-as alert-box error .
     3461         undo, return error .
     3462       end.
     3463       for each buf_price-list no-lock
     3464         where buf_price-list.doc-num    = buf_price-doc.doc-num
     3465           and buf_price-list.main-price = true
     3466       on error undo, return error return-value
     3467       :
     3468         run prdoclib-calc-ov
     3469           (input recid(buf_price-list)
     3470           ,output v-ov-qnty
     3471           ,output v-ov-base
     3472           ,output v-ov-VAT-base
     3473           ,output v-ov-SLT-base
     3474           ) no-error .
     3475         if error-status :error
     3476         then do:
     3477           if error-status :get-message(1) <> ""
     3478           then do:
     3479             message
     3480               vss-workfile vss-revision vss-description skip
     3481               vss-include-info24 skip
     3482               "Ошибка при вызове процедуры prdoclib-calc-ov" skip
     3483               error-status :get-message(1) skip
     3484               return-value skip
     3485               view-as alert-box error .
     3486           end.
     3487           undo, return error return-value .
     3488         end.
     3489         assign
     3490           v-cons-qnty = 0
     3491           v-prch-qnty = 0
     3492         .
     3493         for each buf_parts no-lock
     3494           where buf_parts.out-code  = buf_price-list.doc-num
     3495             and buf_parts.obj-type  = buf_price-list.obj-type
     3496             and buf_parts.obj-code  = buf_price-list.obj-code
     3497             and buf_parts.artic     = buf_price-list.artic
     3498             and buf_parts.prod-type = buf_price-list.prod-type
     3499             and buf_parts.prod-code = buf_price-list.prod-code
     3500         on error undo, return error return-value
     3501         :
     3502           if buf_parts.pay-code = p-cons-pay
     3503           then do:
     3504             assign
     3505               v-cons-qnty = v-cons-qnty + buf_parts.fact-qnty
     3506             .
     3507           end.
     3508           else do:
     3509             assign
     3510               v-prch-qnty = v-prch-qnty + buf_parts.fact-qnty
     3511             .
     3512           end.
     3513         end.
     3514         if (v-cons-qnty + v-prch-qnty) = 0
     3515         then do:
     3516           assign
     3517             v-cons-mult = 0
     3518             v-prch-mult = 1
     3519           .
     3520         end.
     3521         else do:
     3522           assign
     3523             v-cons-mult = v-cons-qnty / (v-cons-qnty + v-prch-qnty)
     3524             v-prch-mult = v-prch-qnty / (v-cons-qnty + v-prch-qnty)
     3525           .
     3526         end.
     3527         assign
     3528           p-ov-cons     = p-ov-cons     + v-ov-base     * v-cons-mult
     3529           p-ov-VAT-cons = p-ov-VAT-cons + v-ov-VAT-base * v-cons-mult
     3530           p-ov-SLT-cons = p-ov-SLT-cons + v-ov-SLT-base * v-cons-mult
     3531           p-ov-prch     = p-ov-prch     + v-ov-base     * v-prch-mult
     3532           p-ov-VAT-prch = p-ov-VAT-prch + v-ov-VAT-base * v-prch-mult
     3533           p-ov-SLT-prch = p-ov-SLT-prch + v-ov-SLT-base * v-prch-mult
     3534         .
     3535       end.
     3536     end.
     3537   end procedure.
     3538   procedure prdoclib-calc-ov :
     3539     define input  parameter p-price-list-recid as recid     no-undo .
     3540     define output parameter p-fact-qnty        as decimal   no-undo .
     3541     define output parameter p-ov-base          as decimal   no-undo .
     3542     define output parameter p-ov-VAT-base      as decimal   no-undo .
     3543     define output parameter p-ov-SLT-base      as decimal   no-undo .
     3544     do
     3545     on error undo, return error return-value
     3546     :
     3547       define buffer buf_main_price-list    for ub.price-list .
     3548       define buffer buf_prev_price-list    for ub.price-list .
     3549       define buffer buf_special_price-list for ub.price-list .
     3550       define buffer buf_goods              for ub.goods .
     3551       define variable v-fact-qnty             like ub.doc-line.price-base no-undo.
     3552       define variable v-cur-base              like ub.doc-line.price-base no-undo.
     3553       define variable v-cur-VAT-base          like ub.doc-line.price-base no-undo.
     3554       define variable v-cur-SLT-base          like ub.doc-line.price-base no-undo.
     3555       define variable v-cur-road-tax-base     like ub.doc-line.price-base no-undo.
     3556       define variable v-cur-excise-base       like ub.doc-line.price-base no-undo.
     3557       define variable v-prev-price-list-recid as   recid                  no-undo.
     3558       define variable v-prev-cli-base-rate    like ub.goods.cli-base-rate no-undo.
     3559       define variable v-prev-fact-qnty        like ub.doc-line.price-base no-undo.
     3560       define variable v-prev-cur-base         like ub.doc-line.price-base no-undo.
     3561       define variable v-prev-cur-VAT-base     like ub.doc-line.price-base no-undo.
     3562       define variable v-prev-cur-SLT-base     like ub.doc-line.price-base no-undo.
     3563       find first buf_main_price-list no-lock
     3564         where recid(buf_main_price-list) = p-price-list-recid
     3565         no-error .
     3566       if not available buf_main_price-list
     3567       then do:
     3568         message
     3569           vss-workfile vss-revision vss-description skip
     3570           vss-include-info24 skip
     3571           "Ошибка задания входных параметров" skip
     3572           "Не найдена строка переоценки" skip
     3573           "Код записи (recid)" p-price-list-recid skip
     3574           view-as alert-box error .
     3575         undo, return error .
     3576       end.
     3577       if buf_main_price-list.main-price <> true
     3578       then do:
     3579         message
     3580           vss-workfile vss-revision vss-description skip
     3581           vss-include-info24 skip
     3582           "Ошибка задания входных параметров" skip
     3583           "Строка переоценки не является основной" skip
     3584           "Код записи (recid)" p-price-list-recid skip
     3585           "Переоценка" buf_main_price-list.doc-num skip
     3586           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     3587           "Бар-код" buf_main_price-list.b-code skip
     3588           view-as alert-box error .
     3589         undo, return error .
     3590       end.
     3591       run prdoclib-calc-fact-sale in this-procedure
     3592         (input  recid(buf_main_price-list)
     3593         ,output v-fact-qnty
     3594         ,output v-cur-base
     3595         ,output v-cur-VAT-base
     3596         ,output v-cur-SLT-base
     3597         ,output v-cur-road-tax-base
     3598         ,output v-cur-excise-base
     3599         ) no-error.
     3600       if error-status :error
     3601       then do:
     3602         message
     3603           vss-workfile vss-revision vss-description skip
     3604           vss-include-info24 skip
     3605           "Ошибка при расчете сумм переоценки." skip
     3606           "Документ переоценки" buf_main_price-list.doc-num skip
     3607           "Товар" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     3608           error-status :get-message(1) skip
     3609           return-value skip
     3610           view-as alert-box error .
     3611         undo, return error .
     3612       end.
     3613   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3614   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     3615     (input  buf_main_price-list.obj-type
     3616     ,input  buf_main_price-list.obj-code
     3617     ,input  buf_main_price-list.b-code
     3618     ,input  buf_main_price-list.b-code
     3619     ,input  buf_main_price-list.fact-order
     3620     ,output v-prev-price-list-recid
     3621     ,output v-prev-cli-base-rate
     3622     ) no-error .
     3623       if error-status :error
     3624       then do:
     3625         message
     3626           vss-workfile vss-revision vss-description skip
     3627           vss-include-info24 skip
     3628           "Ошибка при поиске предыдущей переоценки." skip
     3629           "Документ переоценки " buf_main_price-list.doc-num skip
     3630           "Товар " buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     3631           error-status :get-message(1) skip
     3632           return-value skip
     3633           view-as alert-box error .
     3634         undo, return error .
     3635       end.
     3636       if v-prev-price-list-recid <> ?
     3637       then do:
     3638         find first buf_prev_price-list no-lock
     3639           where recid(buf_prev_price-list) = v-prev-price-list-recid
     3640           .
     3641         find first buf_special_price-list no-lock
     3642           where buf_special_price-list.doc-num    = buf_prev_price-list.doc-num
     3643             and buf_special_price-list.main-price = false
     3644             and buf_special_price-list.artic      = buf_prev_price-list.artic
     3645             and buf_special_price-list.prod-type  = buf_prev_price-list.prod-type
     3646             and buf_special_price-list.prod-code  = buf_prev_price-list.prod-code
     3647             and buf_special_price-list.doc-qnty   <> ?
     3648           no-error .
     3649         if available buf_special_price-list
     3650         then do:
     3651           message
     3652             "Товар имеет специальные цены на признаки" skip
     3653             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     3654             "Переоценка" buf_prev_price-list.doc-num skip
     3655             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     3656             view-as alert-box error .
     3657           undo, return error .
     3658         end.
     3659         find first buf_goods no-lock
     3660           where buf_goods.artic     = buf_main_price-list.artic
     3661             and buf_goods.prod-type = buf_main_price-list.prod-type
     3662             and buf_goods.prod-code = buf_main_price-list.prod-code
     3663           no-error .
     3664         if not available buf_goods
     3665         then do:
     3666           message
     3667             vss-workfile vss-revision vss-description skip
     3668             vss-include-info24 skip
     3669             "Не найден товар" skip
     3670             "Переоценка" buf_main_price-list.doc-num skip
     3671             "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     3672             view-as alert-box error .
     3673           undo, return error .
     3674         end.
     3675         if buf_prev_price-list.vat-pc = ?
     3676         or buf_prev_price-list.slt-pc = ?
     3677         then do:
     3678           message
     3679             "В переоценке не заданы налоги товара" skip
     3680             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     3681             "Переоценка" buf_prev_price-list.doc-num skip
     3682             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     3683             "НДС" buf_prev_price-list.vat-pc skip
     3684             "НП" buf_prev_price-list.slt-pc skip
     3685             view-as alert-box error .
     3686           undo, return error return-value .
     3687         end.
     3688         define variable v-prev-cur-SLT-pc as decimal no-undo .
     3689         assign
     3690           v-prev-cur-SLT-pc   = buf_prev_price-list.price-sale * buf_prev_price-list.slt-pc / (100 + buf_prev_price-list.slt-pc)
     3691         .
     3692         assign
     3693           v-prev-cur-base     = v-fact-qnty * buf_prev_price-list.price-sale
     3694           v-prev-cur-VAT-base = v-fact-qnty
     3695                               * (buf_prev_price-list.price-sale - v-prev-cur-SLT-pc)
     3696                               * buf_prev_price-list.vat-pc / (100 + buf_prev_price-list.vat-pc)
     3697           v-prev-cur-SLT-base = v-fact-qnty * v-prev-cur-SLT-pc
     3698         .
     3699         assign
     3700           p-fact-qnty   = v-fact-qnty
     3701           p-ov-base     = v-cur-base     - v-prev-cur-base
     3702           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     3703           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     3704         .
     3705       end.
     3706       else do:
     3707         assign
     3708           v-prev-cur-base     = 0
     3709           v-prev-cur-VAT-base = 0
     3710           v-prev-cur-SLT-base = 0
     3711           .
     3712         assign
     3713           p-fact-qnty   = v-fact-qnty
     3714           p-ov-base     = v-cur-base     - v-prev-cur-base
     3715           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     3716           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     3717         .
     3718       end.
     3719     end.
     3720   end procedure.
     3721   procedure prdoclib-init-prt-obj-by-factord :
     3722     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     3723     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     3724     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     3725     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     3726     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     3727     define input parameter p-fact-order         as decimal   no-undo .
     3728     define input parameter p-include-fact-order as logical   no-undo .
     3729     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-factord: определение остатков по признакам на любой момент времени".
     3730     define buffer buf_gds-obj      for ub.gds-obj .
     3731     define buffer buf_doc-line     for ub.doc-line .
     3732     define buffer buf_temp-prt-obj for temp-prt-obj .
     3733     define variable v-total-gds-dtl-qnty as decimal   no-undo .
     3734     do
     3735     on error undo, return error return-value
     3736     :
     3737       do transaction
     3738       on error undo, return error return-value
     3739       :
     3740   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3741   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     3742     (input  p-obj-type
     3743     ,input  p-obj-code
     3744     ,input  p-artic
     3745     ,input  p-prod-type
     3746     ,input  p-prod-code
     3747     ,buffer buf_gds-obj
     3748     ) no-error .
     3749         if error-status :error
     3750         then do:
     3751           message
     3752             vss-workfile vss-revision vss-description skip
     3753             vss-include-info24 skip
     3754             "Невозможно найти gds-obj" skip
     3755             error-status :get-message(1) skip
     3756             return-value skip
     3757             view-as alert-box error .
     3758           undo, return error .
     3759         end.
     3760         find current buf_gds-obj exclusive-lock .
     3761       end.
     3762       run prdoclib-init-temp-prt-obj in this-procedure
     3763         (input p-obj-type
     3764         ,input p-obj-code
     3765         ,input p-artic
     3766         ,input p-prod-type
     3767         ,input p-prod-code
     3768         ,input 0
     3769         ) .
     3770       for each buf_temp-prt-obj
     3771         where buf_temp-prt-obj.is-term <> true
     3772       on error undo, return error return-value
     3773       :
     3774         delete buf_temp-prt-obj .
     3775       end.
     3776       if p-include-fact-order = true
     3777       then do:
     3778         assign
     3779          p-fact-order = p-fact-order - 0.0000000001
     3780         .
     3781       end.
     3782       for each buf_doc-line no-lock
     3783         where buf_doc-line.obj-type   = p-obj-type
     3784           and buf_doc-line.obj-code   = p-obj-code
     3785           and buf_doc-line.artic      = p-artic
     3786           and buf_doc-line.prod-type  = p-prod-type
     3787           and buf_doc-line.prod-code  = p-prod-code
     3788           and buf_doc-line.status_    = 'факт':U
     3789           and buf_doc-line.fact-order >= p-fact-order
     3790       on error undo, return error return-value
     3791       :
     3792         run prdoclib-process-document in this-procedure
     3793           (input  buf_doc-line.doc-code
     3794           ,input  p-obj-type
     3795           ,input  p-obj-code
     3796           ,input  p-artic
     3797           ,input  p-prod-type
     3798           ,input  p-prod-code
     3799           ,output v-total-gds-dtl-qnty
     3800           ) .
     3801       end.
     3802     end.
     3803   end procedure.
     3804   procedure prdoclib-process-document :
     3805     define input  parameter p-doc-code           as character no-undo .
     3806     define input  parameter p-obj-type           as character no-undo .
     3807     define input  parameter p-obj-code           as integer   no-undo .
     3808     define input  parameter p-artic              as character no-undo .
     3809     define input  parameter p-prod-type          as character no-undo .
     3810     define input  parameter p-prod-code          as integer   no-undo .
     3811     define output parameter p-total-gds-dtl-qnty as decimal   no-undo .
     3812     define buffer buf_trn-doc      for ub.trn-doc .
     3813     define buffer buf_gds-dtl      for ub.gds-dtl .
     3814     define buffer buf_temp-prt-obj for temp-prt-obj .
     3815     do
     3816     on error undo, return error return-value
     3817     :
     3818       find first buf_trn-doc no-lock
     3819         where buf_trn-doc.doc-code = p-doc-code
     3820         no-error .
     3821       if not available buf_trn-doc then do:
     3822         message
     3823           vss-workfile vss-revision vss-description skip
     3824           vss-include-info24 skip
     3825           "Ошибка при поиске документа" skip
     3826           "Документ" p-doc-code skip
     3827           "Объект" p-obj-type p-obj-code skip
     3828           "Артикул" p-artic p-prod-type p-prod-code skip
     3829           view-as alert-box error .
     3830         undo, return error .
     3831       end.
     3832       assign
     3833         p-total-gds-dtl-qnty = 0
     3834       .
     3835       for each buf_gds-dtl no-lock
     3836         where buf_gds-dtl.doc-code  = p-doc-code
     3837           and buf_gds-dtl.artic     = p-artic
     3838           and buf_gds-dtl.prod-type = p-prod-type
     3839           and buf_gds-dtl.prod-code = p-prod-code
     3840       on error undo, return error
     3841       :
     3842         define variable v-term-node as integer   no-undo .
     3843   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run termnode in g#library
     3844     (input  buf_gds-dtl.prt-code
     3845     ,output v-term-node
     3846     )  .
     3847         run prdoclib-temp-prt-obj-by-prt-root in this-procedure
     3848           (input  v-term-node
     3849           ,buffer buf_temp-prt-obj
     3850           ) .
     3851         if buf_temp-prt-obj.is-term <> true then do:
     3852           undo, return error substitute("Документ ссылается на нетерминальный признак. Код признака &1"
     3853                                        ,buf_gds-dtl.prt-code
     3854                                        ) .
     3855         end.
     3856         case buf_trn-doc.doc-type :
     3857           when 'при':U or
     3858           when 'возврат':U
     3859           then do:
     3860             assign
     3861               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     3862                                           - buf_gds-dtl.fact-qnty
     3863               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     3864                                           - buf_gds-dtl.fact-qnty
     3865             .
     3866           end.
     3867           when 'рас':U or
     3868           when 'спи':U
     3869           then do:
     3870             assign
     3871               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     3872                                           + buf_gds-dtl.fact-qnty
     3873               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     3874                                           + buf_gds-dtl.fact-qnty
     3875             .
     3876           end.
     3877           when 'инв':U
     3878           then do:
     3879             assign
     3880               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     3881                                           - buf_gds-dtl.doc-qnty
     3882               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     3883                                           - buf_gds-dtl.doc-qnty
     3884             .
     3885           end.
     3886           otherwise do:
     3887             undo, return error substitute("Неизвестный тип документа &1"
     3888                                          ,buf_trn-doc.doc-type
     3889                                          ) .
     3890           end.
     3891         end.
     3892       end.
     3893     end.
     3894   end procedure.
     3895   procedure prdoclib-prc-pl-document :
     3896     define input  parameter p-doc-code              as character no-undo .
     3897     define input  parameter p-obj-type              as character no-undo .
     3898     define input  parameter p-obj-code              as integer   no-undo .
     3899     define input  parameter p-gds-code              as integer   no-undo .
     3900     define output parameter p-total-pl-gds-qnty     as decimal   no-undo .
     3901     define output parameter p-total-pl-gds-cli-qnty as decimal   no-undo .
     3902     do
     3903     on error undo, return error return-value
     3904     :
     3905       define buffer buf_trn-doc      for ub.trn-doc .
     3906       define buffer buf_doc-pl       for ub.doc-pl .
     3907       define buffer buf_temp-pl-gds for temp-pl-gds .
     3908       define variable v-sign as decimal   no-undo .
     3909       find first buf_trn-doc no-lock
     3910         where buf_trn-doc.doc-code = p-doc-code
     3911         no-error .
     3912       if not available buf_trn-doc then do:
     3913         message
     3914           vss-workfile vss-revision vss-description skip
     3915           vss-include-info24 skip
     3916           "Ошибка при поиске документа" skip
     3917           "Документ" p-doc-code skip
     3918           "Объект" p-obj-type p-obj-code skip
     3919           "Товар" p-gds-code skip
     3920           view-as alert-box error .
     3921         undo, return error .
     3922       end.
     3923       assign
     3924         p-total-pl-gds-qnty     = 0
     3925         p-total-pl-gds-cli-qnty = 0
     3926       .
     3927       for each buf_doc-pl no-lock
     3928         where buf_doc-pl.out-code  = p-doc-code
     3929           and buf_doc-pl.gds-code  = p-gds-code
     3930       on error undo, return error return-value
     3931       :
     3932         find first buf_temp-pl-gds
     3933           where buf_temp-pl-gds.obj-type = buf_trn-doc.obj-type
     3934             and buf_temp-pl-gds.obj-code = buf_trn-doc.obj-code
     3935             and buf_temp-pl-gds.pl-code  = buf_doc-pl.pl-code
     3936           .
     3937         case buf_trn-doc.doc-type :
     3938           when 'при':U
     3939           or when 'возврат':U
     3940           or when 'инв':U
     3941           then do:
     3942             assign
     3943               v-sign = -1.0
     3944             .
     3945           end.
     3946           when 'рас':U or
     3947           when 'спи':U
     3948           then do:
     3949             assign
     3950               v-sign = 1.0
     3951             .
     3952           end.
     3953           otherwise do:
     3954             undo, return error substitute("(prdoclib-prc-pl-document) Неизвестный тип документа &1", buf_trn-doc.doc-type ) .
     3955           end.
     3956         end case.
     3957         assign
     3958           p-total-pl-gds-qnty           = p-total-pl-gds-qnty           + buf_doc-pl.fact-qnty     * v-sign
     3959           p-total-pl-gds-cli-qnty       = p-total-pl-gds-cli-qnty       + buf_doc-pl.cli-fact-qnty * v-sign
     3960           buf_temp-pl-gds.fact-qnty     = buf_temp-pl-gds.fact-qnty     + buf_doc-pl.fact-qnty     * v-sign
     3961           buf_temp-pl-gds.cli-fact-qnty = buf_temp-pl-gds.cli-fact-qnty + buf_doc-pl.cli-fact-qnty * v-sign
     3962         .
     3963       end.
     3964     end.
     3965   end procedure.
     3966   procedure prdoclib-init-prt-obj-by-date :
     3967     define input parameter p-obj-type   like ub.gds-obj.obj-type  no-undo .
     3968     define input parameter p-obj-code   like ub.gds-obj.obj-code  no-undo .
     3969     define input parameter p-artic      like ub.gds-obj.artic     no-undo .
     3970     define input parameter p-prod-type  like ub.gds-obj.prod-type no-undo .
     3971     define input parameter p-prod-code  like ub.gds-obj.prod-code no-undo .
     3972     define input parameter p-fact-date  as date      no-undo .
     3973     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-date: определение остатков по признакам на конец дня".
     3974     do
     3975     on error undo, return error return-value
     3976     :
     3977       define variable v-fact-order                as decimal   no-undo .
     3978       define variable v-shift-end-fact-order      as decimal   no-undo .
     3979       define variable v-day-end-fact-order        as decimal   no-undo .
     3980       run factord in this-procedure
     3981         (input  p-fact-date
     3982         ,input  1
     3983         ,input  1
     3984         ,input  ?
     3985         ,input  0
     3986         ,input  false
     3987         ,output v-fact-order
     3988         ,output v-shift-end-fact-order
     3989         ,output v-day-end-fact-order
     3990         ) no-error .
     3991       if error-status :error
     3992       then do:
     3993         message
     3994           vss-workfile vss-revision vss-description skip
     3995           vss-include-info24 skip
     3996           "Ошибка при определении момента времени, на который требуется остаток" skip
     3997           "Объект" p-obj-type p-obj-code skip
     3998           "Артикул" p-artic p-prod-type p-prod-code skip
     3999           "Дата" p-fact-date skip
     4000           view-as alert-box error .
     4001         undo, return error .
     4002       end.
     4003       run prdoclib-init-prt-obj-by-date-factord in this-procedure
     4004         (input p-obj-type
     4005         ,input p-obj-code
     4006         ,input p-artic
     4007         ,input p-prod-type
     4008         ,input p-prod-code
     4009         ,input v-day-end-fact-order
     4010         ,input false
     4011         ) no-error .
     4012       if error-status :error
     4013       then do:
     4014         message
     4015           vss-workfile vss-revision vss-description skip
     4016           vss-include-info24 skip
     4017           "Ошибка при вызове метода prdoclib-init-prt-obj-by-date-factord" skip
     4018           "Объект" p-obj-type p-obj-code skip
     4019           "Артикул" p-artic p-prod-type p-prod-code skip
     4020           "Дата" p-fact-date skip
     4021           view-as alert-box error .
     4022         undo, return error .
     4023       end.
     4024     end.
     4025   end procedure.
     4026   procedure prdoclib-calc-temp-fact-sale :
     4027     define input  parameter p-obj-type           as character no-undo .
     4028     define input  parameter p-obj-code           as integer   no-undo .
     4029     define input  parameter p-gds-code           as integer   no-undo .
     4030     define input  parameter p-day-end-fact-order as decimal   no-undo .
     4031     define input  parameter p-curr-r-b           as character no-undo .
     4032     define output parameter p-fact-qnty          as decimal   no-undo .
     4033     define output parameter p-cur-base           as decimal   no-undo .
     4034     define output parameter p-cur-VAT-base       as decimal   no-undo .
     4035     define output parameter p-cur-SLT-base       as decimal   no-undo .
     4036     define output parameter p-cur-road-tax-base  as decimal   no-undo .
     4037     define output parameter p-cur-excise-base    as decimal   no-undo .
     4038     define buffer buf_temp-prt-obj for temp-prt-obj .
     4039     define variable v-prt-b-code        like ub.bar-code.b-code no-undo .
     4040     define variable v-cli-base-rate     like ub.bar-code.cli-base-rate no-undo .
     4041     define variable parrecid-prl        as recid     no-undo .
     4042     define variable v-fact-qnty         as decimal   no-undo .
     4043     define variable v-cur-base          as decimal   no-undo .
     4044     define variable v-cur-VAT-base      as decimal   no-undo .
     4045     define variable v-cur-SLT-base      as decimal   no-undo .
     4046     define variable v-cur-road-tax-base as decimal   no-undo .
     4047     define variable v-cur-excise-base   as decimal   no-undo .
     4048     define variable price-rubl-with-tax-sale-prl    as decimal   no-undo .
     4049     define variable price-base-with-tax-sale-prl    as decimal   no-undo .
     4050     define variable price-rubl-without-tax-sale-prl as decimal   no-undo .
     4051     define variable price-base-without-tax-sale-prl as decimal   no-undo .
     4052     define variable vat-base-sale-prl               as decimal   no-undo .
     4053     define variable vat-rubl-sale-prl               as decimal   no-undo .
     4054     define variable vat-base-buyer-prl              as decimal   no-undo .
     4055     define variable vat-rubl-buyer-prl              as decimal   no-undo .
     4056     define variable slt-base-sale-prl               as decimal   no-undo .
     4057     define variable slt-rubl-sale-prl               as decimal   no-undo .
     4058     define variable road-tax-base-sale-prl          as decimal   no-undo .
     4059     define variable road-tax-rubl-sale-prl          as decimal   no-undo .
     4060     define variable excise-base-sale-prl            as decimal   no-undo .
     4061     define variable excise-rubl-sale-prl            as decimal   no-undo .
     4062     define variable discnt-base-sale-prl            as decimal   no-undo .
     4063     define variable discnt-rubl-sale-prl            as decimal   no-undo .
     4064     do
     4065     on error undo, return error return-value
     4066     :
     4067       for each buf_temp-prt-obj no-lock
     4068       on error undo, return error return-value
     4069       :
     4070   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     4071     (input  p-gds-code
     4072     ,input  buf_temp-prt-obj.prt-code
     4073     ,output v-prt-b-code
     4074     ) no-error .
     4075         if error-status :error
     4076         then do:
     4077           message
     4078             vss-workfile vss-revision vss-description skip
     4079             "Ошибка при определении бар-кода признака" skip
     4080             "Код товара"   p-gds-code skip
     4081             "Код признака" buf_temp-prt-obj.prt-code skip
     4082             error-status :get-message(1) skip
     4083             return-value skip
     4084             view-as alert-box error .
     4085           undo, return error .
     4086         end.
     4087   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4088   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     4089     (input  p-obj-type
     4090     ,input  p-obj-code
     4091     ,input  v-prt-b-code
     4092     ,input  0
     4093     ,input  p-day-end-fact-order
     4094     ,output parrecid-prl
     4095     ,output v-cli-base-rate
     4096     ) no-error .
     4097         if error-status :error
     4098         then do:
     4099           message
     4100             vss-workfile vss-revision vss-description skip
     4101             "Ошибка при определении цены бар-кода" skip
     4102             "Объект" p-obj-type p-obj-code skip
     4103             "Бар-код" v-prt-b-code skip
     4104             "fact-order" p-day-end-fact-order skip
     4105             error-status :get-message(1) skip
     4106             return-value skip
     4107             view-as alert-box error .
     4108           undo, return error .
     4109         end.
     4110         if parrecid-prl <> ?
     4111         then do:
     4112           run prl-vat in this-procedure
     4113             (input  parrecid-prl
     4114             ,output price-rubl-with-tax-sale-prl
     4115             ,output price-base-with-tax-sale-prl
     4116             ,output price-rubl-without-tax-sale-prl
     4117             ,output price-base-without-tax-sale-prl
     4118             ,output vat-base-sale-prl
     4119             ,output vat-rubl-sale-prl
     4120             ,output vat-base-buyer-prl
     4121             ,output vat-rubl-buyer-prl
     4122             ,output slt-base-sale-prl
     4123             ,output slt-rubl-sale-prl
     4124             ,output road-tax-base-sale-prl
     4125             ,output road-tax-rubl-sale-prl
     4126             ,output excise-base-sale-prl
     4127             ,output excise-rubl-sale-prl
     4128             ,output discnt-base-sale-prl
     4129             ,output discnt-rubl-sale-prl
     4130             ) no-error .
     4131           if error-status :error
     4132           then do:
     4133             message
     4134               vss-workfile vss-revision vss-description skip
     4135               "Ошибка при вызове процеды prl-vat" skip
     4136               "Объект" p-obj-type p-obj-code skip
     4137               "Код товара" p-gds-code skip
     4138               "Указатель на запись переоценки" parrecid-prl skip
     4139               error-status :get-message(1) skip
     4140               return-value skip
     4141               view-as alert-box error .
     4142             undo, return error .
     4143           end.
     4144         end.
     4145         else do:
     4146           assign
     4147             price-rubl-with-tax-sale-prl    = 0
     4148             price-base-with-tax-sale-prl    = 0
     4149             price-rubl-without-tax-sale-prl = 0
     4150             price-base-without-tax-sale-prl = 0
     4151             vat-base-sale-prl               = 0
     4152             vat-rubl-sale-prl               = 0
     4153             slt-base-sale-prl               = 0
     4154             slt-rubl-sale-prl               = 0
     4155             road-tax-base-sale-prl          = 0
     4156             road-tax-rubl-sale-prl          = 0
     4157             excise-base-sale-prl            = 0
     4158             excise-rubl-sale-prl            = 0
     4159             discnt-base-sale-prl            = 0
     4160             discnt-rubl-sale-prl            = 0
     4161           .
     4162         end.
     4163         assign
     4164           v-fact-qnty         = v-fact-qnty
     4165                               + buf_temp-prt-obj.fact-qnty
     4166           v-cur-base          = v-cur-base
     4167                               + (if p-curr-r-b = 'base':U
     4168                                   then price-base-with-tax-sale-prl
     4169                                   else price-rubl-with-tax-sale-prl
     4170                                 )
     4171                               * buf_temp-prt-obj.fact-qnty
     4172           v-cur-VAT-base      = v-cur-VAT-base
     4173                               + (if p-curr-r-b = 'base':U
     4174                                   then vat-base-sale-prl
     4175                                   else vat-rubl-sale-prl
     4176                                 )
     4177                               * buf_temp-prt-obj.fact-qnty
     4178           v-cur-SLT-base      = v-cur-SLT-base
     4179                               + (if p-curr-r-b = 'base':U
     4180                                   then slt-base-sale-prl
     4181                                   else slt-rubl-sale-prl
     4182                                 )
     4183                               * buf_temp-prt-obj.fact-qnty
     4184           v-cur-road-tax-base = v-cur-road-tax-base
     4185                               + (if p-curr-r-b = 'base':U
     4186                                   then road-tax-base-sale-prl
     4187                                   else road-tax-rubl-sale-prl
     4188                                 )
     4189                               * buf_temp-prt-obj.fact-qnty
     4190           v-cur-excise-base   = v-cur-excise-base
     4191                               + (if p-curr-r-b = 'base':U
     4192                                   then excise-base-sale-prl
     4193                                   else excise-rubl-sale-prl
     4194                                 )
     4195                               * buf_temp-prt-obj.fact-qnty
     4196         .
     4197       end.
     4198       assign
     4199         p-fact-qnty         = v-fact-qnty
     4200         p-cur-base          = v-cur-base
     4201         p-cur-VAT-base      = v-cur-VAT-base
     4202         p-cur-SLT-base      = v-cur-SLT-base
     4203         p-cur-road-tax-base = v-cur-road-tax-base
     4204         p-cur-excise-base   = v-cur-excise-base
     4205       .
     4206     end.
     4207   end procedure.
     4208   procedure prdoclib-clear-temp-pl-gds :
     4209     define buffer buf_temp-pl-gds for temp-pl-gds .
     4210     do
     4211     on error undo, return error return-value
     4212     :
     4213       for each buf_temp-pl-gds
     4214       on error undo, return error return-value
     4215       :
     4216         delete buf_temp-pl-gds .
     4217       end.
     4218     end.
     4219   end procedure.
     4220   procedure prdoclib-init-temp-pl-gds :
     4221     define input parameter p-obj-type        like ub.pl-gds.obj-type  no-undo .
     4222     define input parameter p-obj-code        like ub.pl-gds.obj-code  no-undo .
     4223     define input parameter p-gds-code        like ub.pl-gds.gds-code  no-undo .
     4224     define buffer buf_pl-gds      for ub.pl-gds .
     4225     define buffer buf_temp-pl-gds for temp-pl-gds .
     4226     do
     4227     on error undo, return error return-value
     4228     :
     4229       run prdoclib-clear-temp-pl-gds in this-procedure .
     4230       for each buf_pl-gds
     4231         where buf_pl-gds.obj-type = p-obj-type
     4232           and buf_pl-gds.obj-code = p-obj-code
     4233           and buf_pl-gds.gds-code = p-gds-code
     4234       on error undo, return error return-value
     4235       :
     4236         create buf_temp-pl-gds .
     4237         buffer-copy buf_pl-gds to buf_temp-pl-gds .
     4238       end.
     4239     end.
     4240   end procedure.
     4241   procedure prdoclib-init-pl-gds-by-factord :
     4242     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     4243     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     4244     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     4245     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     4246     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     4247     define input parameter p-fact-order         as decimal   no-undo .
     4248     define input parameter p-include-fact-order as logical   no-undo .
     4249     define variable vss-description as character no-undo init "prdoclib-init-pl-gds-by-factord: определение остатков по признакам на любой момент времени".
     4250     define buffer buf_goods       for ub.goods .
     4251     define buffer buf_gds-obj     for ub.gds-obj .
     4252     define buffer buf_doc-line    for ub.doc-line .
     4253     define buffer buf_temp-pl-gds for temp-pl-gds .
     4254     define variable v-total-pl-gds-qnty     as decimal   no-undo .
     4255     define variable v-total-pl-gds-cli-qnty as decimal   no-undo .
     4256     do
     4257     on error undo, return error return-value
     4258     :
     4259       do transaction
     4260       on error undo, return error return-value
     4261       :
     4262   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4263   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     4264     (input  p-obj-type
     4265     ,input  p-obj-code
     4266     ,input  p-artic
     4267     ,input  p-prod-type
     4268     ,input  p-prod-code
     4269     ,buffer buf_gds-obj
     4270     ) no-error .
     4271         if error-status :error
     4272         then do:
     4273           message
     4274             vss-workfile vss-revision vss-description skip
     4275             vss-include-info24 skip
     4276             "Невозможно найти gds-obj" skip
     4277             error-status :get-message(1) skip
     4278             return-value skip
     4279             view-as alert-box error .
     4280           undo, return error return-value .
     4281         end.
     4282         find current buf_gds-obj exclusive-lock .
     4283       end.
     4284       find first buf_goods no-lock
     4285         where buf_goods.artic     = p-artic
     4286           and buf_goods.prod-type = p-prod-type
     4287           and buf_goods.prod-code = p-prod-code
     4288         .
     4289       run prdoclib-init-temp-pl-gds in this-procedure
     4290         (input p-obj-type
     4291         ,input p-obj-code
     4292         ,input buf_goods.gds-code
     4293         ) .
     4294       if p-include-fact-order = true
     4295       then do:
     4296         assign
     4297          p-fact-order = p-fact-order - 0.0000000001
     4298         .
     4299       end.
     4300       for each buf_doc-line no-lock
     4301         where buf_doc-line.obj-type   = p-obj-type
     4302           and buf_doc-line.obj-code   = p-obj-code
     4303           and buf_doc-line.artic      = p-artic
     4304           and buf_doc-line.prod-type  = p-prod-type
     4305           and buf_doc-line.prod-code  = p-prod-code
     4306           and buf_doc-line.status_    = 'факт':U
     4307           and buf_doc-line.fact-order >= p-fact-order
     4308       on error undo, return error return-value
     4309       :
     4310         run prdoclib-prc-pl-document in this-procedure
     4311           ( input  buf_doc-line.doc-code
     4312            ,input  p-obj-type
     4313            ,input  p-obj-code
     4314            ,input  buf_goods.gds-code
     4315            ,output v-total-pl-gds-qnty
     4316            ,output v-total-pl-gds-cli-qnty
     4317           ) .
     4318       end.
     4319     end.
     4320   end procedure.
     4321   define variable vss-include-info41 as character format "X(65)" no-undo
     4322   initial "@(#)$Workfile$ $Revision$".
     4323   define temp-table temp_grplib_grp no-undo
     4324       field sel           as character
