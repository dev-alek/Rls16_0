     3042   procedure prdoclib-init-temp-prt-obj :
     3043     define input parameter p-obj-type        like ub.prt-obj.obj-type  no-undo .
     3044     define input parameter p-obj-code        like ub.prt-obj.obj-code  no-undo .
     3045     define input parameter p-artic           like ub.prt-obj.artic     no-undo .
