      609   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      610     if num-entries(string(p-dec), '.') = 2
      611       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      612       else return( string(p-dec)) .
      613   end function.
      614   function format-point-to-comma returns char (input orig as char ) .
      615   define variable rtext as character no-undo .
      616   define variable strt as integer no-undo .
      617   define variable leng as integer no-undo .
      618   assign rtext = orig .
      619   repeat:
      620     strt =  index(rtext,'.').
      621     if strt = 0 then leave.
      622     leng = 1.
      623     substring(rtext,strt,leng,"character") = v-delim .
      624   end.
      625   return rtext.
      626   end function.
      627   function format-excel-text returns char ( input start-text as char ) :
      628   def var  i    as int no-undo.
      629   def var  ch   as char no-undo.
      630   def var  n    as int no-undo.
      631   def var  ipos as int no-undo.
      632     n = num-entries(trim(start-text), chr(10)) - 1 .
      633     do i = 1 to n :
      634       ipos = index( start-text, chr(10)).
      635       if ipos > 0 then
      636         substr( start-text, ipos, 1 ) = ' '.
      637     end.
      638     n = num-entries(trim(start-text), chr(13)) - 1 .
      639     do i = 1 to n :
      640       ipos = index( start-text, chr(13)).
      641       if ipos > 0 then
      642         substr( start-text, ipos, 1 ) = ' '.
      643     end.
      644     if index( start-text, '"' ) = 0 then
      645       start-text =  '="'   + trim( start-text) + '"'   .
      646       else do:
      647         n = num-entries(trim(start-text), '"') - 1.
      648         do i = 1 to n :
      649           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      650         end.
      651         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      652         start-text = '="'  + ch  + '"' .
      653       end.
      654     return start-text.
      655   end.
      656   function excel-sum returns char (input p-dec as decimal ).
      657     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      658   end function.
      659   function excel-qnty returns char (input p-dec as decimal ).
      660     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      661   end function.
      662   function format-excel-text-macr returns char ( input start-text as char ) :
      663   def var  i    as int no-undo.
      664   def var  ch   as char no-undo.
      665   def var  n    as int no-undo.
      666   def var  ipos as int no-undo.
      667     n = num-entries(trim(start-text), chr(10)) - 1 .
      668     do i = 1 to n :
      669       ipos = index( start-text, chr(10)).
      670       if ipos > 0 then
      671         substring( start-text, ipos , 1 ) = ' '.
      672     end.
      673     n = num-entries(trim(start-text), chr(13)) - 1 .
      674     do i = 1 to n :
      675       ipos = index( start-text, chr(13)).
      676       if ipos > 0 then
      677         substring( start-text, ipos, 1 ) = ' '.
      678     end.
      679     if index( start-text, '"' ) = 0 then
      680       start-text =  '"'   + trim( start-text) + '"'   .
      681       else do:
      682         n = num-entries(trim(start-text), '"') - 1.
      683         do i = 1 to n :
      684           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      685         end.
      686         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      687         start-text = '"'  + ch  + '"' .
      688       end.
      689     n = num-entries(trim(start-text), chr(10)) - 1 .
      690     do i = 1 to n :
      691       ipos = index( start-text, chr(10)).
      692       if ipos > 0 then
      693         substring( start-text, ipos , 1 ) = ' '.
      694     end.
      695       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
      696     return start-text.
      697   end.
      698   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      699   procedure cur-time :
      700      define output parameter p-today as date      no-undo .
      701      define output parameter p-time  as integer   no-undo .
      702     do
      703     on error undo, return error
      704     :
      705       define variable v-date1 as date      no-undo .
      706       define variable v-date2 as date      no-undo .
      707       define variable v-time  as integer   no-undo .
      708       assign
      709         v-date1 = today
      710         v-time  = time
      711         v-date2 = today
      712       .
      713       if v-date1 <> v-date2
      714       then do:
      715         assign
      716           v-date1 = today
      717           v-time  = v-time
      718         .
      719       end.
      720       assign
      721         p-today = v-date1
      722         p-time  = v-time
      723       .
      724     end.
      725   end.
      726   function cur-time-date returns character
      727   :
      728     return string(today, '99/99/9999':U) .
      729   end.
      730   function cur-time-mjd returns decimal
      731   :
      732     define variable v-date as date      no-undo .
      733     define variable v-time as integer   no-undo .
      734     run cur-time in this-procedure
      735       (output v-date
      736       ,output v-time
      737       ) .
      738     return integer(v-date) - 2400002 + (v-time / 86400) .
      739   end.
      740   function cur-time-get-ending-index returns integer
      741   (input p-number as integer
      742   )
      743   :
      744     if p-number < 0
      745     or p-number = ?
      746     then do:
      747       return 1 .
      748     end.
      749     define variable v-rest as integer   no-undo .
      750     assign
      751       p-number = p-number modulo 100
      752     .
      753     if p-number < 20
      754     then do:
      755       assign
      756         v-rest = p-number
      757       .
      758     end.
      759     else do:
      760       assign
      761         v-rest = p-number modulo 10
      762       .
      763     end.
      764     case v-rest :
      765       when 1
      766       then do:
      767         return 2 .
      768       end.
      769       when 2 or
      770       when 3 or
      771       when 4
      772       then do:
      773         return 3 .
      774       end.
      775       otherwise do:
      776         return 1 .
      777       end.
      778     end case .
      779   end.
      780   procedure cur-time-mjd-to-date :
      781      define input  parameter i-mjd-diff as decimal no-undo.
      782      define output parameter o-Date     as date    no-undo.
      783      define output parameter o-Time     as integer no-undo.
      784      define variable v-day-number as integer   no-undo .
      785      if    i-mjd-diff < 0
      786         or i-mjd-diff = ?
      787      then do:
      788         return "?" .
      789      end.
      790      assign
      791         v-day-number = truncate(i-mjd-diff,0).
      792         o-Date = date(v-day-number + 2400002).
      793         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      794     .
      795   end.
      796   function cur-time-mjd-to-string returns character
      797   (input p-mjd-diff as decimal
      798   )
      799   :
      800     define variable v-day-number as integer   no-undo .
      801     define variable v-seconds    as integer   no-undo .
      802     define variable v-hour       as integer   no-undo .
      803     define variable v-min        as integer   no-undo .
      804     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      805     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      806     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      807     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      808     if p-mjd-diff < 0
      809     or p-mjd-diff = ?
      810     then do:
      811       return "?" .
      812     end.
      813     assign
      814       v-day-number = integer(truncate(p-mjd-diff,0))
      815       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      816     .
      817     if v-seconds > 86400
      818     then do:
      819       assign
      820         v-seconds = 86400 - 1
      821       .
      822     end.
      823     if v-seconds < 0
      824     then do:
      825       assign
      826         v-seconds = 0
      827       .
      828     end.
      829     assign
      830       v-hour = truncate(v-seconds / 3600, 0)
      831     .
      832     assign
      833       v-seconds = v-seconds modulo 3600
      834     .
      835     assign
      836       v-min = truncate(v-seconds / 60, 0)
      837     .
      838     assign
      839       v-seconds = v-seconds modulo 60
      840     .
      841     return
      842         (if v-day-number <> 0
      843           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      844           else ""
      845         )
      846       + (if v-day-number <> 0 or v-hour <> 0
      847           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      848           else ""
      849         )
      850       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      851           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      852           else ""
      853         )
      854       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      855       .
      856   end.
      857   function cur-time-string returns character
      858   :
      859     define variable v-date as date      no-undo .
      860     define variable v-time as integer   no-undo .
      861     run cur-time in this-procedure
      862       (output v-date
      863       ,output v-time
      864       ) .
      865     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      866   end.
      867   function cur-time-string-sec returns character
      868   :
      869     define variable v-date as date      no-undo .
      870     define variable v-time as integer   no-undo .
      871     run cur-time in this-procedure
      872       (output v-date
      873       ,output v-time
      874       ) .
      875     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      876   end.
      877   function cur-time-custom  returns character
      878   (input p-prefix as character
      879   ,input p-date-format as character
      880   ,input p-delimiter as character
      881   ,input p-time-format as character
      882   ,input p-suffix as character
      883   )
      884   :
      885     define variable v-date as date      no-undo .
      886     define variable v-time as integer   no-undo .
      887     run cur-time in this-procedure
      888       (output v-date
      889       ,output v-time
      890       ) .
      891     return
      892       p-prefix
      893       + string(v-date, p-date-format)
      894       + p-delimiter
      895       + string(v-time, p-time-format)
      896       + p-suffix
      897       .
      898   end.
      899   function cur-time-print  returns character
      900   :
      901     define variable v-date as date      no-undo .
      902     define variable v-time as integer   no-undo .
      903     run cur-time in this-procedure
      904       (output v-date
      905       ,output v-time
      906       ) .
      907     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      908   end.
      909   function cur-time-datetime returns datetime
      910   :
      911     define variable v-char as character no-undo .
      912     define variable v-datetime as datetime no-undo .
      913     v-char = cur-time-string().
      914     v-datetime = datetime(v-char).
      915     return  v-datetime.
      916   end.
      917   function cur-time-string-msec returns character
      918   :
      919     define variable v-date as datetime  no-undo .
      920     v-date = now.
      921     return string(v-date) .
      922   end.
      923   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      924   procedure factord :
      925     define input  parameter p-fact-date            as date    no-undo .
      926     define input  parameter p-fact-time            as integer no-undo .
      927     define input  parameter p-fact-num             as integer no-undo .
      928     define input  parameter p-shift-date           as date    no-undo .
      929     define input  parameter p-shift-num            as integer no-undo .
      930     define input  parameter p-shift-on             as logical no-undo .
      931     define output parameter p-fact-order           as decimal no-undo .
      932     define output parameter p-shift-end-fact-order as decimal no-undo .
      933     define output parameter p-day-end-fact-order   as decimal no-undo .
      934     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      935     if p-fact-date = ?
      936     then do:
      937       return error "Не указана фактическая дата" .
      938     end.
      939     define variable v-fact-date-num as integer no-undo .
      940     assign
      941       v-fact-date-num = integer(p-fact-date)
      942     .
      943     if p-fact-num = ?
      944     or p-fact-num = 0
      945     then do:
      946       return error "Не задан p-fact-num " + string(p-fact-num) .
      947     end.
      948     if p-fact-num < 0
      949     then do:
      950       return error "Отрицательный fact-num " + string(p-fact-num) .
      951     end.
      952     if p-fact-num >= 100000000
      953     then do:
      954       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      955     end.
      956     if p-shift-on = true
      957     then do:
      958       if p-shift-date = ?
      959       then do:
      960         return error "Не задана дата смены" .
      961       end.
      962       if p-shift-num = ?
      963       or p-shift-num = 0
      964       then do:
      965         return error "Не задан номер смены" .
      966       end.
      967     end.
      968     else do:
      969       assign
      970         p-shift-date = p-fact-date
      971         p-shift-num  = 24
      972       .
      973     end.
      974     define variable v-shift-offset as integer no-undo .
      975     if p-shift-date = p-fact-date
      976     then do:
      977       assign
      978         v-shift-offset = 1
      979       .
      980     end.
      981     if p-shift-date < p-fact-date
      982     then do:
      983       assign
      984         v-shift-offset = 0
      985       .
      986     end.
      987     if p-shift-date > p-fact-date
      988     then do:
      989       message
      990         vss-workfile vss-revision vss-description skip
      991         "Неправильная дата закрытия смены" skip
      992         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      993         view-as alert-box error .
      994       undo, return error
      995         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      996           ,string(p-fact-date, '99/99/9999':U)
      997           ,string(p-shift-date, '99/99/9999':U)
      998           )
      999       .
     1000     end.
     1001     if p-shift-num < 1
     1002     or p-shift-num > 24
     1003     then do:
     1004       message
     1005         vss-workfile vss-revision vss-description skip
     1006         "Неправильный номер смены" skip
     1007         "p-shift-num" p-shift-num skip
     1008         view-as alert-box error .
     1009       undo, return error return-value .
     1010     end.
     1011     assign
     1012       p-fact-order           = v-fact-date-num
     1013                              + v-shift-offset * 0.5
     1014                              + p-shift-num    * 0.02 - 0.01
     1015                              + p-fact-num     * 0.0000000001
     1016       p-shift-end-fact-order = v-fact-date-num
     1017                              + v-shift-offset * 0.5
     1018                              + p-shift-num    * 0.02
     1019       p-day-end-fact-order   = v-fact-date-num
     1020                              + 0.99
     1021     .
     1022     if p-fact-order           <= v-fact-date-num
     1023     or p-shift-end-fact-order <= v-fact-date-num
     1024     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1025     or p-shift-end-fact-order >= p-day-end-fact-order
     1026     then do:
     1027       message
     1028         vss-workfile vss-revision vss-description skip
     1029         "Внутренняя ошибка при генерации фактического номера" skip
     1030         "p-fact-date"            p-fact-date            skip
     1031         "p-fact-time"            p-fact-time            skip
     1032         "p-fact-num"             p-fact-num             skip
     1033         "p-shift-date"           p-shift-date           skip
     1034         "p-shift-num"            p-shift-num            skip
     1035         "p-shift-on"             p-shift-on             skip
     1036         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1037         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1038         "v-fact-date-num"        v-fact-date-num        skip
     1039         view-as alert-box error .
     1040       undo, return error return-value .
     1041     end.
     1042   end procedure.
     1043   procedure day-begin-fact-order :
     1044     define input  parameter p-fact-date            as date    no-undo .
     1045     define output parameter p-day-begin-fact-order as decimal no-undo .
     1046     do
     1047     on error undo, return error return-value
     1048     :
     1049       if p-fact-date = ?
     1050       then do:
     1051         assign
     1052           p-day-begin-fact-order = 0
     1053         .
     1054       end.
     1055       else do:
     1056         assign
     1057           p-day-begin-fact-order = integer(p-fact-date)
     1058         .
     1059       end.
     1060     end.
     1061   end procedure.
     1062   procedure factord-max-fact-order :
     1063     define output parameter p-max-fact-order as decimal   no-undo .
     1064     do
     1065     on error undo, return error return-value
     1066     :
     1067       run day-begin-fact-order in this-procedure
     1068         (input  date(1, 1, 5000)
     1069         ,output p-max-fact-order
     1070         ) .
     1071     end.
     1072   end procedure.
     1073   procedure factord-cut-archive :
     1074     define input  parameter p-obj-type             as character no-undo .
     1075     define input  parameter p-obj-code             as integer   no-undo .
     1076     define input  parameter p-fact-date            as date      no-undo .
     1077     define output parameter p-shift-on             as logical   no-undo .
     1078     define output parameter p-shift-date           as date      no-undo .
     1079     define output parameter p-shift-num            as integer   no-undo .
     1080     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1081     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1082     define variable v-fact-order as decimal   no-undo .
     1083     define buffer buf_shift-obj for ub.shift-obj .
     1084     do
     1085     on error undo, return error return-value
     1086     :
     1087   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1088   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1089     (input  p-obj-type
     1090     ,input  p-obj-code
     1091     ,input  'shift-on=request'
     1092     ,output p-shift-on
     1093     ) no-error .
     1094       if error-status :error
     1095       then do:
     1096         message
     1097           vss-workfile vss-revision vss-description skip
     1098           "Ошибка при определении атрибута объекта" skip
     1099           "Объект" p-obj-type p-obj-code skip
     1100           error-status :get-message(1) skip
     1101           return-value skip
     1102           view-as alert-box error .
     1103         undo, return error return-value .
     1104       end.
     1105       if p-shift-on = false
     1106       then do:
     1107         assign
     1108           p-shift-date               = ?
     1109           p-shift-num                = 0
     1110         .
     1111       end.
     1112       else do:
     1113         find first buf_shift-obj share-lock
     1114           where buf_shift-obj.obj-type   = p-obj-type
     1115             and buf_shift-obj.obj-code   = p-obj-code
     1116             and buf_shift-obj.shift-date > p-fact-date
     1117           use-index pi
     1118           no-error .
     1119         if not available buf_shift-obj
     1120         or buf_shift-obj.status_ <> 'зкр':U
     1121         then do:
     1122           message
     1123             vss-workfile vss-revision vss-description skip
     1124             "Невозможно вычислить последнюю смену" skip
     1125             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1126             "Объект" p-obj-type p-obj-code skip
     1127             "Дата" p-fact-date skip
     1128             view-as alert-box error .
     1129           undo, return error return-value .
     1130         end.
     1131         find last buf_shift-obj share-lock
     1132           where buf_shift-obj.obj-type = p-obj-type
     1133             and buf_shift-obj.obj-code = p-obj-code
     1134             and buf_shift-obj.shift-date <= p-fact-date
     1135           use-index pi
     1136           no-error .
     1137         if available buf_shift-obj
     1138         then do:
     1139           if  buf_shift-obj.status_ = 'зкр':U
     1140           then do:
     1141             assign
     1142               p-shift-date = buf_shift-obj.shift-date
     1143               p-shift-num  = buf_shift-obj.shift-num
     1144             .
     1145           end.
     1146           else do:
     1147             message
     1148               vss-workfile vss-revision vss-description skip
     1149               "Невозможно вычислить последнюю смену" skip
     1150               "Статус смены отличен от статуса" 'зкр':U skip
     1151               "Объект" p-obj-type p-obj-code skip
     1152               "Дата" p-fact-date skip
     1153               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1154               view-as alert-box error .
     1155             undo, return error return-value .
     1156           end.
     1157         end.
     1158         else do:
     1159           assign
     1160             p-shift-date = p-fact-date - 1
     1161             p-shift-num  = 1
     1162           .
     1163         end.
     1164       end.
     1165       run factord in this-procedure
     1166         (input  p-fact-date
     1167         ,input  1
     1168         ,input  1
     1169         ,input  p-shift-date
     1170         ,input  p-shift-num
     1171         ,input  p-shift-on
     1172         ,output v-fact-order
     1173         ,output p-shift-end-fact-order
     1174         ,output p-day-end-fact-order
     1175         ) no-error .
     1176       if error-status :error
     1177       then do:
     1178         message
     1179           vss-workfile vss-revision vss-description skip
     1180           "Ошибка при вызове процедуры factord"
     1181           error-status :get-message(1) skip
     1182           return-value skip
     1183           view-as alert-box error .
     1184         undo, return error return-value .
     1185       end.
     1186     end.
     1187   end procedure.
     1188   procedure factord-lock-shift :
     1189     define input  parameter p-obj-type  as character no-undo .
     1190     define input  parameter p-obj-code  as integer   no-undo .
     1191     define input  parameter p-fact-date as date      no-undo .
     1192     define parameter buffer buf_shift-obj for ub.shift-obj .
     1193     define variable v-shift-on      as logical   no-undo .
     1194     define variable v-extra-message as character no-undo .
     1195     define variable v-error as character no-undo .
     1196     do
     1197     on error undo, return error return-value
     1198     :
     1199   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1200   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1201     (input  p-obj-type
     1202     ,input  p-obj-code
     1203     ,input  'shift-on=request'
     1204     ,output v-shift-on
     1205     ) no-error .
     1206       if error-status :error
     1207       then do:
     1208         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1209         undo, return error v-error .
     1210       end.
     1211       if v-shift-on = true
     1212       then do:
     1213         find first buf_shift-obj share-lock
     1214           where buf_shift-obj.obj-type   = p-obj-type
     1215             and buf_shift-obj.obj-code   = p-obj-code
     1216             and buf_shift-obj.shift-date > p-fact-date
     1217           use-index pi
     1218           no-error .
     1219         if not available buf_shift-obj
     1220         or buf_shift-obj.status_ <> 'зкр':U
     1221         then do:
     1222           find last buf_shift-obj
     1223             where buf_shift-obj.obj-type = p-obj-type
     1224               and buf_shift-obj.obj-code = p-obj-code
     1225               and buf_shift-obj.status_  = 'зкр':U
     1226             use-index stts
     1227             no-error .
     1228           if available buf_shift-obj
     1229           then do:
     1230             assign
     1231               v-extra-message =
     1232                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1233                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1234                               )
     1235             .
     1236           end.
     1237           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1238           undo, return error v-error .
     1239         end.
     1240       end.
     1241     end.
     1242   end procedure.
     1243   procedure factord-end-day :
     1244     define input  parameter p-fact-date            as date    no-undo .
     1245     define output parameter p-day-end-fact-order   as decimal no-undo .
     1246     do
     1247     on error undo, return error return-value
     1248     :
     1249       if p-fact-date = ?
     1250       then do:
     1251         return error "Не указана фактическая дата" .
     1252       end.
     1253       assign
     1254         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1255       .
     1256     end.
     1257   end procedure.
     1258   procedure factord-to-date :
     1259     define input  parameter p-fact-order as decimal no-undo .
     1260     define output parameter p-fact-date  as date    no-undo .
     1261     define variable v-ref-date  as date      no-undo .
     1262     define variable v-ref-delta as integer   no-undo .
     1263     do
     1264     on error undo, return error return-value
     1265     :
     1266       if p-fact-order = ?
     1267       or p-fact-order = 0
     1268       then do:
     1269         return error "Не указан fact-order" .
     1270       end.
     1271       assign
     1272         v-ref-date  = date(1, 1, 2000)
     1273       .
     1274       assign
     1275         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1276       .
     1277       assign
     1278         p-fact-date = v-ref-date + v-ref-delta
     1279       .
     1280     end.
     1281   end procedure.
     1282   procedure factord-to-fact-num :
     1283     define input  parameter p-fact-order as decimal no-undo .
     1284     define output parameter p-fact-num   as integer no-undo .
     1285     define variable v-fact-order-trunc as decimal no-undo .
     1286     do
     1287     on error undo, return error return-value
     1288     :
     1289       if p-fact-order = ?
     1290       or p-fact-order = 0
     1291       then do:
     1292         return error "Не указан fact-order" .
     1293       end.
     1294       assign
     1295        v-fact-order-trunc = truncate(p-fact-order, 2)
     1296       .
     1297       assign
     1298         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1299       .
     1300     end.
     1301   end procedure.
     1302   procedure factord-to-shift-num :
     1303     define input  parameter p-fact-order as decimal no-undo .
     1304     define output parameter p-shift-num   as integer no-undo .
     1305     define variable  p-shift-numd  as decimal   no-undo .
     1306     define variable v-fact-order-trunc as decimal no-undo .
     1307     do
     1308     on error undo, return error return-value
     1309     :
     1310       if p-fact-order = ?
     1311       or p-fact-order = 0
     1312       then do:
     1313         return error "Не указан fact-order" .
     1314       end.
     1315       assign
     1316        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1317       .
     1318       if v-fact-order-trunc < 0.5 then do:
     1319         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1320       end.
     1321       assign
     1322         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1323         .
     1324        assign
     1325         p-shift-num = truncate (p-shift-numd , 0)
     1326       .
     1327     end.
     1328   end procedure.
     1329   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1330   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
     1331   procedure partslib-clear-temp-parts :
     1332     define buffer buf_temp-parts for temp-parts .
     1333     do
     1334     on error undo, return error
     1335     :
     1336       for each buf_temp-parts
     1337       on error undo, return error
     1338       :
     1339         delete buf_temp-parts .
     1340       end.
     1341     end.
     1342   end procedure.
     1343   procedure partslib-create-temp-parts :
     1344     define parameter buffer buf_parts       for ub.parts .
     1345     define parameter buffer buf_temp-parts  for temp-parts .
     1346     define input  parameter p-goods-twounit as logical   no-undo .
     1347     define variable v-base-part-code as character no-undo .
     1348     do
     1349     on error undo, return error
     1350     :
     1351       if p-goods-twounit = true
     1352       then do:
     1353         assign
     1354           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
     1355         .
     1356       end.
     1357       else do:
     1358         assign
     1359           v-base-part-code = buf_parts.part-code
     1360         .
     1361       end.
     1362       find first buf_temp-parts exclusive-lock
     1363         where buf_temp-parts.obj-type  = buf_parts.obj-type
     1364           and buf_temp-parts.obj-code  = buf_parts.obj-code
     1365           and buf_temp-parts.artic     = buf_parts.artic
     1366           and buf_temp-parts.prod-type = buf_parts.prod-type
     1367           and buf_temp-parts.prod-code = buf_parts.prod-code
     1368           and buf_temp-parts.in-code   = buf_parts.in-code
     1369           and buf_temp-parts.out-code  = 'free-zone':U
     1370           and buf_temp-parts.part-code = v-base-part-code
     1371         no-error.
     1372       if not available buf_temp-parts
     1373       then do:
     1374         create buf_temp-parts .
     1375         buffer-copy buf_parts to buf_temp-parts
     1376         assign
     1377           buf_temp-parts.out-code  = 'free-zone':U
     1378           buf_temp-parts.part-code = v-base-part-code
     1379           buf_temp-parts.rsrv-free = yes
     1380           buf_temp-parts.status_   = no
     1381           buf_temp-parts.qnty      = 0
     1382           buf_temp-parts.fact-qnty = 0
     1383           buf_temp-parts.real-qnty = 0
     1384           buf_temp-parts.cli-qnty  = 0
     1385         .
     1386       end.
     1387     end.
     1388   end procedure.
     1389   procedure partslib-init-temp-parts :
     1390     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     1391     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     1392     define input parameter p-artic           like ub.parts.artic     no-undo .
     1393     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     1394     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     1395     define buffer buf_parts      for ub.parts .
     1396     define buffer buf_temp-parts for temp-parts .
     1397     define variable v-goods-twounit    as logical   no-undo .
     1398     do
     1399     on error undo, return error
     1400     :
     1401   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1402   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1403     (input  p-artic
     1404     ,input  p-prod-type
     1405     ,input  p-prod-code
     1406     ,input  'twounit=request':u
     1407     ,output v-goods-twounit
     1408     ) no-error .
     1409       if error-status :error
     1410       then do:
     1411         message
     1412           vss-workfile vss-revision vss-description skip
     1413           vss-include-info12 skip
     1414           "Ошибка при определении атрибута товара" skip
     1415           "Артикул" p-artic p-prod-type p-prod-code skip
     1416           "twounit=request" skip
     1417           error-status :get-message(1) skip
     1418           return-value skip
     1419           view-as alert-box error .
     1420         undo, return error return-value .
     1421       end.
     1422       run partslib-clear-temp-parts in this-procedure .
     1423       for each buf_parts
     1424         where buf_parts.obj-type  = p-obj-type
     1425           and buf_parts.obj-code  = p-obj-code
     1426           and buf_parts.artic     = p-artic
     1427           and buf_parts.prod-type = p-prod-type
     1428           and buf_parts.prod-code = p-prod-code
     1429           and buf_parts.rsrv-free = yes
     1430           and buf_parts.status_   = no
     1431           and buf_parts.in-code   <> buf_parts.out-code
     1432       on error undo, return error
     1433       :
     1434         run partslib-create-temp-parts in this-procedure
     1435           (buffer buf_parts
     1436           ,buffer buf_temp-parts
     1437           ,input  v-goods-twounit
     1438           ) .
     1439         define variable v-parts-qnty          as decimal   no-undo .
     1440         define variable v-parts-cli-qnty      as decimal   no-undo .
     1441         define variable v-parts-free-qnty     as decimal   no-undo .
     1442         define variable v-parts-free-cli-qnty as decimal   no-undo .
     1443         if buf_parts.out-code = 'free-zone':U
     1444         then do:
     1445           assign
     1446             v-parts-qnty          = buf_parts.qnty
     1447             v-parts-cli-qnty      = buf_parts.cli-qnty
     1448             v-parts-free-qnty     = buf_parts.qnty
     1449             v-parts-free-cli-qnty = buf_parts.cli-qnty
     1450           .
     1451         end.
     1452         else do:
     1453           assign
     1454             v-parts-qnty          = abs(buf_parts.qnty)
     1455             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
     1456             v-parts-free-qnty     = 0
     1457             v-parts-free-cli-qnty = 0
     1458           .
     1459         end.
     1460         assign
     1461           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
     1462           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
     1463           buf_temp-parts.real-qnty     = 0
     1464           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
     1465           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
     1466           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
     1467         .
     1468       end.
     1469     end.
     1470   end procedure.
     1471   procedure partslib-init-temp-parts-by-factord :
     1472     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     1473     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     1474     define input parameter p-artic              like ub.parts.artic     no-undo .
     1475     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     1476     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     1477     define input parameter p-fact-order         as decimal   no-undo .
     1478     define input parameter p-include-fact-order as logical   no-undo .
     1479     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     1480     define buffer buf_gds-obj  for ub.gds-obj .
     1481     do
     1482     on error undo, return error
     1483     :
     1484       do transaction
     1485       on error undo, return error
     1486       :
     1487   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1488   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1489     (input  p-obj-type
     1490     ,input  p-obj-code
     1491     ,input  p-artic
     1492     ,input  p-prod-type
     1493     ,input  p-prod-code
     1494     ,buffer buf_gds-obj
     1495     ) no-error .
     1496         if error-status :error
     1497         then do:
     1498           message
     1499             vss-workfile vss-revision vss-description skip
     1500             vss-include-info12 skip
     1501             "Невозможно найти товар на объекте" skip
     1502             "Объект" p-obj-type p-obj-code skip
     1503             "Артикул" p-artic p-prod-type p-prod-code skip
     1504             error-status :get-message(1) skip
     1505             return-value skip
     1506             view-as alert-box error .
     1507           undo, return error .
     1508         end.
     1509         find current buf_gds-obj exclusive-lock .
     1510       end.
     1511       run partslib-init-temp-parts in this-procedure
     1512         (input p-obj-type
     1513         ,input p-obj-code
     1514         ,input p-artic
     1515         ,input p-prod-type
     1516         ,input p-prod-code
     1517         ) no-error .
     1518       if error-status :error
     1519       then do:
     1520         message
     1521           vss-workfile vss-revision vss-description skip
     1522           vss-include-info12 skip
     1523           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
     1524           "Объект" p-obj-type p-obj-code skip
     1525           "Артикул" p-artic p-prod-type p-prod-code skip
     1526           "p-fact-order" p-fact-order skip
     1527           view-as alert-box error .
     1528         undo, return error .
     1529       end.
     1530       if p-include-fact-order = true
     1531       then do:
     1532         assign
     1533           p-fact-order = p-fact-order - 0.0000000001
     1534         .
     1535       end.
     1536       define variable v-max-fact-order as character no-undo .
     1537       run factord-max-fact-order in this-procedure
     1538         (output v-max-fact-order
     1539         ) no-error .
     1540       if error-status :error
     1541       then do:
     1542         message
     1543           vss-workfile vss-revision vss-description skip
     1544           vss-include-info12 skip
     1545           "Ошибка при вызове процедуры factord-max-fact-order" skip
     1546           "Объект" p-obj-type p-obj-code skip
     1547           "Артикул" p-artic p-prod-type p-prod-code skip
     1548           "p-fact-order" p-fact-order skip
     1549           view-as alert-box error .
     1550         undo, return error .
     1551       end.
     1552       run partslib-update-by-factord in this-procedure
     1553         (input p-obj-type
     1554         ,input p-obj-code
     1555         ,input p-artic
     1556         ,input p-prod-type
     1557         ,input p-prod-code
     1558         ,input p-fact-order
     1559         ,input v-max-fact-order
     1560         ,input false
     1561         ) no-error .
     1562       if error-status :error
     1563       then do:
     1564         message
     1565           vss-workfile vss-revision vss-description skip
     1566           vss-include-info12 skip
     1567           "Ошибка при вызове процедуры partslib-update-by-factord" skip
     1568           "Объект" p-obj-type p-obj-code skip
     1569           "Артикул" p-artic p-prod-type p-prod-code skip
     1570           "p-fact-order" p-fact-order skip
     1571           "v-max-fact-order" v-max-fact-order skip
     1572           view-as alert-box error .
     1573         undo, return error .
     1574       end.
     1575     end.
     1576   end procedure.
     1577   procedure partslib-update-by-factord :
     1578     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     1579     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     1580     define input parameter p-artic              like ub.parts.artic     no-undo .
     1581     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     1582     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     1583     define input parameter p-start-fact-order   as decimal   no-undo .
     1584     define input parameter p-end-fact-order     as decimal   no-undo .
     1585     define input parameter p-lock-gds-obj       as logical   no-undo .
     1586     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     1587     define buffer buf_gds-obj  for ub.gds-obj .
     1588     define buffer buf_doc-line for ub.doc-line .
     1589     define variable v-total-parts-qnty as decimal   no-undo .
     1590     define variable v-goods-gds-goods  as logical   no-undo .
     1591     define variable v-goods-twounit    as logical   no-undo .
     1592     do
     1593     on error undo, return error
     1594     :
     1595       if p-start-fact-order > p-end-fact-order
     1596       then do:
     1597         message
     1598           vss-workfile vss-revision vss-description skip
     1599           vss-include-info12 skip
     1600           "Ошибка задания входных параметров" skip
     1601           "Начало интервала превышает конец интервала" skip
     1602           "Объект" p-obj-type p-obj-code skip
     1603           "Артикул" p-artic p-prod-type p-prod-code skip
     1604           "p-start-fact-order" p-start-fact-order skip
     1605           "p-end-fact-order"   p-end-fact-order skip
     1606           view-as alert-box error .
     1607         undo, return error .
     1608       end.
     1609       if p-lock-gds-obj = true
     1610       then do:
     1611         do transaction
     1612         on error undo, return error
     1613         :
     1614   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1615   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1616     (input  p-obj-type
     1617     ,input  p-obj-code
     1618     ,input  p-artic
     1619     ,input  p-prod-type
     1620     ,input  p-prod-code
     1621     ,buffer buf_gds-obj
     1622     ) no-error .
     1623           if error-status :error
     1624           then do:
     1625             message
     1626               vss-workfile vss-revision vss-description skip
     1627               vss-include-info12 skip
     1628               "Невозможно найти gds-obj" skip
     1629               error-status :get-message(1) skip
     1630               return-value skip
     1631               view-as alert-box error .
     1632             undo, return error .
     1633           end.
     1634           find current buf_gds-obj exclusive-lock .
     1635         end.
     1636       end.
     1637   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1638   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1639     (input  p-artic
     1640     ,input  p-prod-type
     1641     ,input  p-prod-code
     1642     ,input  'gds-goods=request':u
     1643     ,output v-goods-gds-goods
     1644     ) no-error .
     1645       if error-status :error
     1646       then do:
     1647         message
     1648           vss-workfile vss-revision vss-description skip
     1649           vss-include-info12 skip
     1650           "Ошибка при определении атрибута товара" skip
     1651           "Артикул" p-artic p-prod-type p-prod-code skip
     1652           "gds-goods=request" skip
     1653           error-status :get-message(1) skip
     1654           return-value skip
     1655           view-as alert-box error .
     1656         undo, return error return-value .
     1657       end.
     1658   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1659   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1660     (input  p-artic
     1661     ,input  p-prod-type
     1662     ,input  p-prod-code
     1663     ,input  'twounit=request':u
     1664     ,output v-goods-twounit
     1665     ) no-error .
     1666       if error-status :error
     1667       then do:
     1668         message
     1669           vss-workfile vss-revision vss-description skip
     1670           vss-include-info12 skip
     1671           "Ошибка при определении атрибута товара" skip
     1672           "Артикул" p-artic p-prod-type p-prod-code skip
     1673           "twounit=request" skip
     1674           error-status :get-message(1) skip
     1675           return-value skip
     1676           view-as alert-box error .
     1677         undo, return error return-value .
     1678       end.
     1679       for each buf_doc-line no-lock
     1680         where buf_doc-line.obj-type   = p-obj-type
     1681           and buf_doc-line.obj-code   = p-obj-code
     1682           and buf_doc-line.artic      = p-artic
     1683           and buf_doc-line.prod-type  = p-prod-type
     1684           and buf_doc-line.prod-code  = p-prod-code
     1685           and buf_doc-line.status_    = 'факт':U
     1686           and buf_doc-line.fact-order > p-start-fact-order
     1687           and buf_doc-line.fact-order <= p-end-fact-order
     1688       on error undo, return error
     1689       :
     1690         run partslib-process-document in this-procedure
     1691           (input  buf_doc-line.doc-code
     1692           ,input  p-obj-type
     1693           ,input  p-obj-code
     1694           ,input  p-artic
     1695           ,input  p-prod-type
     1696           ,input  p-prod-code
     1697           ,input  v-goods-gds-goods
     1698           ,input  v-goods-twounit
     1699           ,output v-total-parts-qnty
     1700           ) no-error .
     1701         if error-status :error
     1702         then do:
     1703           message
     1704             vss-workfile vss-revision vss-description skip
     1705             vss-include-info12 skip
     1706             "Ошибка при вызове процедуры partslib-process-document" skip
     1707             "Документ" buf_doc-line.doc-code skip
     1708             "Объект" p-obj-type p-obj-code skip
     1709             "Артикул" p-artic p-prod-type p-prod-code skip
     1710             "p-start-fact-order" p-start-fact-order skip
     1711             "p-end-fact-order" p-end-fact-order skip
     1712             error-status :get-message(1) skip
     1713             return-value skip
     1714             view-as alert-box error .
     1715           undo, return error return-value .
     1716         end.
     1717       end.
     1718     end.
     1719   end procedure.
     1720   procedure partslib-process-document :
     1721     define input  parameter p-doc-code         as character no-undo .
     1722     define input  parameter p-obj-type         as character no-undo .
     1723     define input  parameter p-obj-code         as integer   no-undo .
     1724     define input  parameter p-artic            as character no-undo .
     1725     define input  parameter p-prod-type        as character no-undo .
     1726     define input  parameter p-prod-code        as integer   no-undo .
     1727     define input  parameter p-goods-gds-goods  as logical   no-undo .
     1728     define input  parameter p-goods-twounit    as logical   no-undo .
     1729     define output parameter p-total-parts-qnty as decimal   no-undo .
     1730     define variable v-parts-sign as integer   no-undo .
     1731     define buffer buf_trn-doc    for ub.trn-doc .
     1732     define buffer buf_doc-line   for ub.doc-line .
     1733     define buffer buf_parts      for ub.parts .
     1734     define buffer buf_temp-parts for temp-parts .
     1735     do
     1736     on error undo, return error return-value
     1737     :
     1738       find first buf_trn-doc no-lock
     1739         where buf_trn-doc.doc-code = p-doc-code
     1740         no-error .
     1741       if not available buf_trn-doc
     1742       then do:
     1743         undo, return error substitute("Ошибка при поиске документа. Документ &1"
     1744                                      ,p-doc-code
     1745                                      ) .
     1746       end.
     1747       case buf_trn-doc.doc-type
     1748       :
     1749         when 'при':U or
     1750         when 'возврат':U or
     1751         when 'инв':U
     1752         then do:
     1753           assign
     1754             v-parts-sign = -1
     1755           .
     1756         end.
     1757         when 'рас':U or
     1758         when 'спи':U
     1759         then do:
     1760           assign
     1761             v-parts-sign = 1
     1762           .
     1763         end.
     1764         otherwise do:
     1765           undo, return error substitute("Неизвестный тип документа &1"
     1766                                       ,buf_trn-doc.doc-type
     1767                                       ) .
     1768         end.
     1769       end.
     1770       find first buf_doc-line no-lock
     1771         where buf_doc-line.doc-code  = p-doc-code
     1772           and buf_doc-line.artic     = p-artic
     1773           and buf_doc-line.prod-type = p-prod-type
     1774           and buf_doc-line.prod-code = p-prod-code
     1775         no-error .
     1776       if not available buf_doc-line
     1777       then do:
     1778         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
     1779                                      ,p-doc-code
     1780                                      ,artic
     1781                                      ,prod-type
     1782                                      ,prod-code
     1783                                      ) .
     1784       end.
     1785       assign
     1786         p-total-parts-qnty = 0
     1787       .
     1788       if p-goods-gds-goods = true
     1789       then do:
     1790         for each buf_parts no-lock
     1791           where buf_parts.out-code  = p-doc-code
     1792             and buf_parts.obj-type  = p-obj-type
     1793             and buf_parts.obj-code  = p-obj-code
     1794             and buf_parts.artic     = p-artic
     1795             and buf_parts.prod-type = p-prod-type
     1796             and buf_parts.prod-code = p-prod-code
     1797         on error undo, return error
     1798         :
     1799           run partslib-create-temp-parts in this-procedure
     1800             (buffer buf_parts
     1801             ,buffer buf_temp-parts
     1802             ,input  p-goods-twounit
     1803             ) .
     1804           assign
     1805             p-total-parts-qnty        = p-total-parts-qnty
     1806                                       + v-parts-sign * buf_parts.fact-qnty
     1807             buf_temp-parts.qnty       = buf_temp-parts.qnty
     1808                                       + v-parts-sign * buf_parts.fact-qnty
     1809             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
     1810                                       + v-parts-sign * buf_parts.fact-qnty
     1811             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
     1812                                       + v-parts-sign * buf_parts.cli-qnty
     1813           .
     1814           if buf_temp-parts.qnty = 0
     1815           then do:
     1816             delete buf_temp-parts .
     1817           end.
     1818         end.
     1819       end.
     1820       else do:
     1821         assign
     1822           p-total-parts-qnty = p-total-parts-qnty
     1823                              + v-parts-sign * buf_doc-line.fact-qnty
     1824         .
     1825       end.
     1826     end.
     1827   end procedure.
     1828   procedure partslib-init-temp-parts-by-date :
     1829     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     1830     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     1831     define input parameter p-artic           like ub.parts.artic     no-undo .
     1832     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     1833     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     1834     define input parameter p-fact-date       as date      no-undo .
     1835     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
     1836     do
     1837     on error undo, return error
     1838     :
     1839       define variable v-fact-order                as decimal   no-undo .
     1840       define variable v-shift-end-fact-order      as decimal   no-undo .
     1841       define variable v-day-end-fact-order        as decimal   no-undo .
     1842       run factord in this-procedure
     1843         (input  p-fact-date
     1844         ,input  1
     1845         ,input  1
     1846         ,input  ?
     1847         ,input  0
     1848         ,input  false
     1849         ,output v-fact-order
     1850         ,output v-shift-end-fact-order
     1851         ,output v-day-end-fact-order
     1852         ) no-error .
     1853       if error-status :error
     1854       then do:
     1855         message
     1856           vss-workfile vss-revision vss-description skip
     1857           vss-include-info12 skip
     1858           "Ошибка при определении момента времени, на который требуется остаток" skip
     1859           "Объект" p-obj-type p-obj-code skip
     1860           "Артикул" p-artic p-prod-type p-prod-code skip
     1861           "Дата" p-fact-date skip
     1862           view-as alert-box error .
     1863         undo, return error .
     1864       end.
     1865       run partslib-init-temp-parts-by-factord in this-procedure
     1866         (input p-obj-type
     1867         ,input p-obj-code
     1868         ,input p-artic
     1869         ,input p-prod-type
     1870         ,input p-prod-code
     1871         ,input v-day-end-fact-order
     1872         ,input false
     1873         ) no-error .
     1874       if error-status :error
     1875       then do:
     1876         message
     1877           vss-workfile vss-revision vss-description skip
     1878           vss-include-info12 skip
     1879           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
     1880           "Объект" p-obj-type p-obj-code skip
     1881           "Артикул" p-artic p-prod-type p-prod-code skip
     1882           "Дата" p-fact-date skip
     1883           view-as alert-box error .
     1884         undo, return error .
     1885       end.
     1886     end.
     1887   end procedure.
     1888   procedure partslib-calc-cost :
     1889     define output parameter p-fact-qnty      as decimal   no-undo .
     1890     define output parameter p-vat-pc         as decimal   no-undo .
     1891     define output parameter p-slt-pc         as decimal   no-undo .
     1892     define output parameter p-sum-base       as decimal   no-undo .
     1893     define output parameter p-sum-rubl       as decimal   no-undo .
     1894     define output parameter p-vat-base       as decimal   no-undo .
     1895     define output parameter p-vat-rubl       as decimal   no-undo .
     1896     define output parameter p-slt-base       as decimal   no-undo .
     1897     define output parameter p-slt-rubl       as decimal   no-undo .
     1898     define output parameter p-road-tax-base  as decimal   no-undo .
     1899     define output parameter p-road-tax-rubl  as decimal   no-undo .
     1900     define output parameter p-transport-base as decimal   no-undo .
     1901     define output parameter p-transport-rubl as decimal   no-undo .
     1902     define output parameter p-other-base     as decimal   no-undo .
     1903     define output parameter p-other-rubl     as decimal   no-undo .
     1904     define output parameter p-excise-base    as decimal   no-undo .
     1905     define output parameter p-excise-rubl    as decimal   no-undo .
     1906     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     1907     do
     1908     on error undo, return error return-value
     1909     :
     1910       define buffer buf_temp-parts for temp-parts .
     1911       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     1912       define buffer   in-vatp-parts    for ub.parts   .
     1913       define buffer   in-vatp-doc      for ub.trn-doc .
     1914       define buffer   in-vatp-goods    for ub.goods   .
     1915       define buffer   in-vatp-sysconf  for ub.sysconf .
     1916       define buffer   in-vatp_doc-attr for ub.doc-attr.
     1917       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     1918       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     1919       define variable varinvprb                  as   character              no-undo.
     1920       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     1921       define variable cli-base-rate              as   decimal                no-undo.
     1922       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     1923       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     1924       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     1925       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     1926       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     1927       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     1928       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     1929       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1930       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     1931       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     1932       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1933       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     1934       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     1935       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     1936       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     1937       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     1938       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     1939       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     1940       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     1941       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     1942       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     1943       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     1944       define variable varinvatp-envd             as   character              no-undo.
     1945       define variable varinvatp-type             as   character              no-undo.
     1946       for each buf_temp-parts
     1947       on error undo, return error
     1948       :
     1949   assign
     1950     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     1951     price-base-with-tax-loc = buf_temp-parts.price-base
     1952   .
     1953   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1954   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1955     (output varinvprb
     1956     )  .
     1957     if buf_temp-parts.out-code = 'free-zone':U     or
     1958        buf_temp-parts.out-code = 'out-zone':U   or
     1959        buf_temp-parts.doc-type = 'акт':U then do:
     1960       assign
     1961         in-vatp-have-vat-slt = yes.
     1962     end.
     1963     else do:
     1964       find first in-vatp_doc-attr no-lock
     1965         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     1966           and in-vatp_doc-attr.attr-code = 'envd':U
     1967         no-error .
     1968       if not available in-vatp_doc-attr then do:
     1969         assign
     1970           in-vatp-have-vat-slt = yes.
     1971       end.
     1972       else do:
     1973            in-vatp-have-vat-slt = no.
     1974       end.
     1975     end.
     1976     assign
     1977      price-cli-with-tax-loc = buf_temp-parts.price-cli
     1978      cli-base-rate          = buf_temp-parts.cli-base-rate.
     1979     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     1980              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     1981     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     1982             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     1983             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     1984             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     1985             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     1986             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     1987             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1988       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1989     assign
     1990       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     1991     assign
     1992       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1993       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1994       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1995       transport-cli-loc  = 0
     1996       other-cli-loc      = 0
     1997     .
     1998   ASSIGN
     1999             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     2000       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     2001   .
     2002         assign
     2003           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     2004           p-vat-pc         = p-vat-pc         + vat-pc-loc
     2005           p-slt-pc         = p-slt-pc         + slt-pc-loc
     2006           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     2007           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     2008           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     2009           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     2010           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     2011           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     2012           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     2013           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     2014           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     2015           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     2016           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     2017           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     2018           p-excise-base    = p-excise-base    + 0
     2019           p-excise-rubl    = p-excise-rubl    + 0
     2020         .
     2021       end.
     2022       if p-fact-qnty      = ?
     2023       or p-sum-base       = ?
     2024       or p-sum-rubl       = ?
     2025       or p-vat-base       = ?
     2026       or p-vat-rubl       = ?
     2027       or p-slt-base       = ?
     2028       or p-slt-rubl       = ?
     2029       or p-road-tax-base  = ?
     2030       or p-road-tax-rubl  = ?
     2031       or p-transport-base = ?
     2032       or p-transport-rubl = ?
     2033       or p-other-base     = ?
     2034       or p-other-rubl     = ?
     2035       or p-excise-base    = ?
     2036       or p-excise-rubl    = ?
     2037       then do:
     2038         message
     2039           vss-workfile vss-revision vss-description skip
     2040           vss-include-info12 skip
     2041           "Программа in-vatp.i вернула неопределенные значения" skip
     2042           "p-fact-qnty"      p-fact-qnty      skip
     2043           "p-sum-base"       p-sum-base       skip
     2044           "p-sum-rubl"       p-sum-rubl       skip
     2045           "p-vat-base"       p-vat-base       skip
     2046           "p-vat-rubl"       p-vat-rubl       skip
     2047           "p-slt-base"       p-slt-base       skip
     2048           "p-slt-rubl"       p-slt-rubl       skip
     2049           "p-road-tax-base"  p-road-tax-base  skip
     2050           "p-road-tax-rubl"  p-road-tax-rubl  skip
     2051           "p-transport-base" p-transport-base skip
     2052           "p-transport-rubl" p-transport-rubl skip
     2053           "p-other-base"     p-other-base     skip
     2054           "p-other-rubl"     p-other-rubl     skip
     2055           "p-excise-base"    p-excise-base    skip
     2056           "p-excise-rubl"    p-excise-rubl    skip
     2057           view-as alert-box error .
     2058         undo, return error .
     2059       end.
     2060     end.
     2061   end procedure.
     2062   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2063   procedure prl-vat:
     2064     define input parameter parrecid as recid no-undo.
     2065       define output parameter price-rubl-with-tax-saleprl    like ub.doc-line.price-rubl no-undo.
     2066       define output parameter price-base-with-tax-saleprl    like ub.doc-line.price-base no-undo.
     2067       define output parameter price-rubl-without-tax-saleprl like ub.doc-line.price-rubl no-undo.
     2068       define output parameter price-base-without-tax-saleprl like ub.doc-line.price-base no-undo.
     2069       define output parameter vat-base-saleprl               like ub.doc-line.price-base no-undo.
     2070       define output parameter vat-rubl-saleprl               like ub.doc-line.price-rubl no-undo.
     2071       define output parameter vat-base-buyerprl              like ub.doc-line.price-base no-undo.
     2072       define output parameter vat-rubl-buyerprl              like ub.doc-line.price-rubl no-undo.
     2073       define output parameter slt-base-saleprl               like ub.doc-line.price-base no-undo.
     2074       define output parameter slt-rubl-saleprl               like ub.doc-line.price-rubl no-undo.
     2075       define output parameter road-tax-base-saleprl          like ub.doc-line.road-tax   no-undo.
     2076       define output parameter road-tax-rubl-saleprl          like ub.doc-line.road-tax   no-undo.
     2077       define output parameter excise-base-saleprl            like ub.doc-line.price-base no-undo.
     2078       define output parameter excise-rubl-saleprl            like ub.doc-line.price-rubl no-undo.
     2079       define output parameter discnt-base-saleprl            like ub.gds-dtl.discnt-base no-undo.
     2080       define output parameter discnt-rubl-saleprl            like ub.gds-dtl.discnt-rubl no-undo.
     2081       define buffer out-vatp_gds-dtlprl     for ub.gds-dtl.
     2082       define buffer buf_out-vatp_gds-dtlprl for ub.gds-dtl.
     2083       define buffer out-vatp_partsprl       for ub.parts.
     2084       define buffer out-vatp_sysconfprl     for ub.sysconf.
     2085       define buffer out-vatp_doc-lineprl    for ub.doc-line.
     2086       define buffer out-vatp_goodsprl       for ub.goods.
