     2969   procedure prdoclib-create-temp-prt-obj :
     2970     define input parameter  p-root-price-sale like ub.price-list.price-sale no-undo .
     2971     define parameter buffer buf_prt-obj       for ub.prt-obj .
     2972     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
     2973     define buffer buf_gds-prt for ub.gds-prt .
     2974     do
     2975     on error undo, return error return-value
     2976     :
     2977       find first buf_temp-prt-obj
     2978         where buf_temp-prt-obj.prt-code = buf_prt-obj.prt-code
     2979         no-error .
     2980       if not available buf_temp-prt-obj
     2981       then do:
     2982         create buf_temp-prt-obj .
     2983         assign
     2984           buf_temp-prt-obj.prt-code         = buf_prt-obj.prt-code
     2985           buf_temp-prt-obj.price-sale       = ?
     2986           buf_temp-prt-obj.fact-qnty        = buf_prt-obj.fact-qnty
     2987           buf_temp-prt-obj.price-list-qnty  = ?
     2988           buf_temp-prt-obj.prt-obj-recid    = recid(buf_prt-obj)
     2989           buf_temp-prt-obj.price-list-recid = ?
     2990         .
     2991         find first buf_gds-prt no-lock
     2992           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     2993           .
     2994         assign
     2995           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     2996         .
     2997         if buf_temp-prt-obj.is-term
     2998         then do:
     2999           assign
     3000             buf_temp-prt-obj.price-sale = p-root-price-sale
     3001           .
     3002         end.
     3003       end.
     3004     end.
