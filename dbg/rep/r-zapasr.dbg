     5298       field   part-code        as  char
     5299       field   gds-name         as  char
     5300       field   gds-name1        as  char
     5301       field   grp-name         as  char
     5302       field   unit-base        as  char
     5303       field   sb-code          as  char
     5304       field   b-code           as  integer
     5305       field   grp-code         as  integer
     5306       field   vat-pc           as  decimal
     5307       INDEX pi  IS PRIMARY   obj-type obj-code artic  prod-type prod-code
     5308       INDEX pi1              obj-type obj-code b-code prod-type prod-code
     5309       INDEX pi2              artic  prod-type prod-code
     5310       INDEX pi3              prod-type prod-code
     5311       INDEX pi4              post-type post-code
     5312       INDEX pi5              grp-code
     5313       INDEX pi6              vat-pc
     5314       INDEX pi7              gds-name
     5315   .
     5316     define variable frmt as character no-undo .
     5317     assign frmt = "X(" + string(ReportPageWidth) + ')' .
     5318     define variable frmt1 as character no-undo .
     5319     assign frmt1 = "X(" + string(ReportPageWidth - 2) + ')' .
     5320     define variable frmt2 as character no-undo .
     5321     assign i = 0 .
     5322     if use-column[1]  = yes then assign i = i + 6 .
     5323     if use-column[2]  = yes then assign i = i + 11 .
     5324     if use-column[3]  = yes then assign i = i + 17 .
     5325     if use-column[4]  = yes then assign i = i + 41 .
     5326     if use-column[5]  = yes then assign i = i + 4 .
     5327     if i > 1 then assign i = i - 1 .
     5328     else assign i = 1 .
     5329     assign frmt2 = "X(" + string( i ) + ')' .
     5330     assign  Counter1 = 0 .
     5331   define variable v-account as integer init 0 no-undo .
     5332   define variable v-account-lavel as character no-undo .
     5333   define variable v-button-stop as logical no-undo .
     5334   define variable v-kol-spice as integer no-undo .
     5335   define variable v-kol-spice2 as integer no-undo .
     5336   define variable v-kol-spice3 as integer no-undo .
     5337   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     5338   DEFINE BUTTON StopBtn AUTO-END-KEY
     5339        LABEL "Стоп"
     5340        SIZE 10 BY 1.
     5341   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     5342        LABEL "Обработано записей"
     5343         VIEW-AS TEXT
     5344        SIZE 14 BY .67 NO-UNDO.
     5345   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     5346         VIEW-AS TEXT
     5347        SIZE 53.25 BY .67
     5348        FGCOLOR 1  NO-UNDO.
     5349   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     5350         VIEW-AS TEXT
     5351        SIZE 53.25 BY .67
     5352        FGCOLOR 1  NO-UNDO.
     5353   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     5354         VIEW-AS TEXT
     5355        SIZE 53.25 BY .67
     5356        FGCOLOR 1  NO-UNDO.
     5357   DEFINE RECTANGLE RECT-1
     5358        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     5359        SIZE 55.13 BY 4.46.
     5360   DEFINE FRAME InfoFrame
     5361        StopBtn AT ROW 4.25 COL 21.75
     5362        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     5363        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     5364        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     5365        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     5366        RECT-1 AT ROW 1 COL 1
     5367       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     5368            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     5369            TITLE "Процесс"
     5370            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     5371   define variable mFrameView      as logical   no-undo init yes.
     5372     define variable mFramHandle as handle no-undo.
     5373     mFramHandle = frame InfoFrame:handle.
     5374     if  log-manager:logfile-name ne ?
     5375     then DO:
     5376         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     5377         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     5378         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     5379     end.
     5380     mFrameView = not session:batch-mode and mFramHandle:visible.
     5381     if mFrameView
     5382     then do:
     5383       ASSIGN
     5384          FRAME InfoFrame:HIDDEN                           = TRUE
     5385          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     5386     end.
     5387   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     5388   DO:
     5389     IF not StopProcessing THEN
     5390       Message "Вы действительно хотите прервать" SKIP
     5391               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     5392                 UPDATE StopProcessing.
     5393     IF StopProcessing THEN do:
     5394        if mFrameView
     5395        then do:
     5396           HIDE FRAME InfoFrame.
     5397        end.
     5398     End.
     5399   END.
     5400   assign v-account = ( if integer( 25 ) = 0 then 100 else integer( 25 ) ).
     5401     if  log-manager:logfile-name ne ?
     5402     then DO:
     5403         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     5404     end.
     5405     if not session:batch-mode then
     5406     do:
     5407       VIEW FRAME InfoFrame.
     5408       mFrameView = true.
     5409     end.
     5410      v-button-stop = false .
     5411         if mFrameView
     5412         then do:
     5413         if v-button-stop then view STOPBTN in frame InfoFrame.
     5414                          else Hide STOPBTN in frame InfoFrame.
     5415         end.
     5416     for each obj-list :
     5417       case x-SelectGood :
     5418         when 1 then do:
     5419           for each buf_gds-obj no-lock where buf_gds-obj.obj-type = obj-list.obj-type and buf_gds-obj.obj-code = obj-list.obj-code :
     5420   define variable vss-include-info47 as character format "X(65)" no-undo
     5421   initial "@(#)$Workfile$ $Revision$".
     5422     assign Counter1 = Counter1 + 1.
     5423   IF ( Counter1 modulo v-account = 0 )  then DO:
     5424             if  log-manager:logfile-name ne ?
     5425             then DO:
     5426                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     5427             end.
     5428              if mFrameView
     5429              then do:
     5430               DISPLAY
     5431                 Counter1 @ RecordsDone
     5432                 WITH FRAME InfoFrame.
     5433              end.
     5434   End.
     5435      if v-button-stop then  DO:
     5436            if mFrameView
     5437            then
     5438               PROCESS EVENTS.
     5439            IF StopProcessing THEN DO:
     5440            RETURN error.
     5441            End.
     5442      end.
     5443     if x-date-end < today then do:
     5444       run partslib-init-temp-parts-by-factord in this-procedure( input buf_gds-obj.obj-type, input buf_gds-obj.obj-code, input buf_gds-obj.artic, input buf_gds-obj.prod-type, input buf_gds-obj.prod-code, input v-fact-order-end, input false ) .
     5445     end.
     5446     else do:
     5447       run partslib-init-temp-parts in this-procedure( input buf_gds-obj.obj-type, input buf_gds-obj.obj-code, input buf_gds-obj.artic, input buf_gds-obj.prod-type, input buf_gds-obj.prod-code ) .
     5448     end.
     5449     for each temp-parts :
     5450       if xShowZero = no and temp-parts.fact-qnty = 0 and temp-parts.free-qnty = 0 then next .
     5451       if tog-obj = true then do:
     5452         find first temp-gds
     5453           where temp-gds.prod-type = buf_gds-obj.prod-type
     5454             and temp-gds.prod-code = buf_gds-obj.prod-code
     5455             and temp-gds.artic     = buf_gds-obj.artic
     5456             and temp-gds.in-code   = temp-parts.in-code
     5457             and temp-gds.part-code = temp-parts.part-code
     5458             and temp-gds.obj-type  = buf_gds-obj.obj-type
     5459             and temp-gds.obj-code  = buf_gds-obj.obj-code
     5460         no-error .
     5461       end.
     5462       else do:
     5463         find first temp-gds
     5464           where temp-gds.prod-type = buf_gds-obj.prod-type
     5465             and temp-gds.prod-code = buf_gds-obj.prod-code
     5466             and temp-gds.artic     = buf_gds-obj.artic
     5467             and temp-gds.in-code   = temp-parts.in-code
     5468             and temp-gds.part-code = temp-parts.part-code
     5469         no-error .
     5470       end.
     5471       if not available temp-gds then do:
     5472         run CreateGDS ( buf_gds-obj.artic, buf_gds-obj.prod-type, buf_gds-obj.prod-code, temp-parts.in-code, temp-parts.part-code, temp-parts.supp-type, temp-parts.supp-code) .
     5473       end.
     5474       run prdoclib-init-prt-obj-by-factord in this-procedure ( input buf_gds-obj.obj-type, input buf_gds-obj.obj-code, input buf_gds-obj.artic ,input buf_gds-obj.prod-type, input buf_gds-obj.prod-code, input v-fact-order-end, input false ) .
     5475       run prdoclib-calc-temp-fact-sale in this-procedure (input buf_gds-obj.obj-type, input buf_gds-obj.obj-code, input buf_gds-obj.gds-code, input v-fact-order-end, input v-curr-r-b
     5476         ,output v-cur-qnty
     5477         ,output v-cur-base
     5478         ,output v-cur-VAT-base
     5479         ,output v-cur-SLT-base
     5480         ,output v-cur-road-tax-base
     5481         ,output v-cur-excise-base
     5482         ) no-error .
     5483       if error-status :error
     5484       then do:
     5485         message  vss-workfile vss-revision vss-description skip "Ошибка при вызове процедуры" skip view-as alert-box error .
     5486         undo, return error return-value .
     5487       end.
     5488       assign
     5489         temp-gds.fact-qnty  = temp-gds.fact-qnty  + temp-parts.fact-qnty
     5490         temp-gds.free-qnty  = temp-gds.free-qnty  + temp-parts.free-qnty
     5491       .
     5492       if x-SET_val_TYPE = 1 then do:
     5493         if v-curr-r-b = 'base':U then v-cur-base = v-cur-base * v-base-rate / v-base-scale .
     5494         assign
     5495           temp-gds.zak-sum  = temp-gds.zak-sum  + temp-parts.price-rubl * temp-parts.fact-qnty
     5496         .
     5497       end.
     5498       else do:
     5499         if v-curr-r-b <> 'base':U then v-cur-base = v-cur-base * v-base-scale / v-base-rate .
     5500         assign
     5501           temp-gds.zak-sum  = temp-gds.zak-sum  + temp-parts.price-base * temp-parts.fact-qnty
     5502         .
     5503       end.
     5504       assign temp-gds.prod-sum = temp-gds.prod-sum + abs (v-cur-base * temp-parts.fact-qnty / v-cur-qnty ) .
     5505     end.
     5506     if xShowZero = yes then do:
     5507       for each buf_parts no-lock
     5508         where buf_parts.obj-type  = buf_gds-obj.obj-type
     5509           and buf_parts.obj-code  = buf_gds-obj.obj-code
     5510           and buf_parts.prod-type = buf_gds-obj.prod-type
     5511           and buf_parts.prod-code = buf_gds-obj.prod-code
     5512           and buf_parts.artic     = buf_gds-obj.artic
     5513           and buf_parts.out-code  = 'out-zone':U
     5514         :
     5515         if tog-obj = true then do:
     5516           find first temp-gds
     5517             where temp-gds.prod-type = buf_gds-obj.prod-type
     5518               and temp-gds.prod-code = buf_gds-obj.prod-code
     5519               and temp-gds.artic     = buf_gds-obj.artic
     5520               and temp-gds.obj-type  = buf_gds-obj.obj-type
     5521               and temp-gds.obj-code  = buf_gds-obj.obj-code
     5522           no-error .
     5523         end.
     5524         else do:
     5525           find first temp-gds
     5526             where temp-gds.prod-type = buf_gds-obj.prod-type
     5527               and temp-gds.prod-code = buf_gds-obj.prod-code
     5528               and temp-gds.artic     = buf_gds-obj.artic
     5529           no-error .
     5530         end.
     5531         if not available temp-gds then do:
     5532           run CreateGDS ( buf_gds-obj.artic, buf_gds-obj.prod-type, buf_gds-obj.prod-code, buf_parts.in-code, buf_parts.part-code, buf_parts.supp-type, buf_parts.supp-code) .
     5533           if x-SET_val_TYPE = 1 then assign temp-gds.zak-price = buf_parts.price-rubl .
     5534           else                       assign temp-gds.zak-price = buf_parts.price-base .
     5535         end.
     5536       end.
     5537     end.
     5538     run CalcWaitQnty (input 'ie':U ) .
     5539     run CalcWaitQnty (input 'iv':U ) .
     5540     run CalcWaitQnty (input 're':U ) .
     5541     run CalcWaitQnty (input 'rs':U ) .
     5542     run CalcWaitQnty (input 'im':U ) .
     5543     run CalcWaitQnty (input 'vt':U ) .
     5544     run CalcWaitQnty (input 'vp':U ) .
     5545           end.
     5546         end.
     5547         when 3 then do:
     5548           for each G#cli :
     5549             for each buf_gds-obj  no-lock
     5550               where buf_gds-obj.obj-type  = obj-list.obj-type
     5551                 and buf_gds-obj.obj-code  = obj-list.obj-code
     5552                 and buf_gds-obj.prod-type = G#cli.obj-type
     5553                 and buf_gds-obj.prod-code = G#cli.obj-code
     5554               use-index pi  :
     5555   define variable vss-include-info48 as character format "X(65)" no-undo
     5556   initial "@(#)$Workfile$ $Revision$".
     5557     assign Counter1 = Counter1 + 1.
     5558   IF ( Counter1 modulo v-account = 0 )  then DO:
     5559             if  log-manager:logfile-name ne ?
     5560             then DO:
     5561                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     5562             end.
     5563              if mFrameView
     5564              then do:
     5565               DISPLAY
     5566                 Counter1 @ RecordsDone
     5567                 WITH FRAME InfoFrame.
     5568              end.
     5569   End.
     5570      if v-button-stop then  DO:
     5571            if mFrameView
     5572            then
     5573               PROCESS EVENTS.
     5574            IF StopProcessing THEN DO:
     5575            RETURN error.
