      656   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      657   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      658   procedure paramls-clear :
      659     define buffer buf_temp-param for temp-param .
      660     do
      661     on error undo, return error return-value
      662     :
      663       for each buf_temp-param
      664       on error undo, return error
      665       :
      666         delete buf_temp-param .
      667       end.
      668     end.
      669   end procedure.
      670   procedure paramls-write :
      671     define input  parameter p-code     as character no-undo .
      672     define input  parameter p-sub-code as character no-undo .
      673     define input  parameter p-value    as character no-undo .
      674     define buffer buf_temp-param for temp-param .
      675     do
      676     on error undo, return error return-value
      677     :
      678       find first buf_temp-param
      679         where buf_temp-param.param-code     = p-code
      680           and buf_temp-param.param-sub-code = p-sub-code
      681         no-error .
      682       if not available buf_temp-param then do:
      683         create buf_temp-param .
      684         assign
      685           buf_temp-param.param-code     = p-code
      686           buf_temp-param.param-sub-code = p-sub-code
      687         .
      688       end.
      689       assign
      690         buf_temp-param.param-value = p-value
      691       .
      692     end.
      693   end procedure.
      694   procedure paramls-read :
      695     define input  parameter p-code          as character no-undo .
      696     define input  parameter p-sub-code      as character no-undo .
      697     define input  parameter p-default-value as character no-undo .
      698     define output parameter p-value         as character no-undo .
      699     define buffer buf_temp-param for temp-param .
      700     do
      701     on error undo, return error return-value
      702     :
      703       find first buf_temp-param
      704         where buf_temp-param.param-code     = p-code
      705           and buf_temp-param.param-sub-code = p-sub-code
      706         no-error .
      707       if available buf_temp-param then do:
      708         assign
      709           p-value = buf_temp-param.param-value
      710         .
      711       end.
      712       else do:
      713         assign
      714           p-value = p-default-value
      715         .
      716       end.
      717     end.
      718   end procedure.
      719   procedure paramls-append :
      720     define input  parameter p-code     as character no-undo .
      721     define input  parameter p-sub-code as character no-undo .
      722     define input  parameter p-value    as character no-undo .
      723     define buffer buf_temp-param for temp-param .
      724     do
      725     on error undo, return error return-value
      726     :
      727       find first buf_temp-param
      728            where buf_temp-param.param-code     = p-code
      729              and buf_temp-param.param-sub-code = p-sub-code
      730         no-error .
      731       if not available buf_temp-param then do:
      732         create buf_temp-param .
      733         assign
      734           buf_temp-param.param-code     = p-code
      735           buf_temp-param.param-sub-code = p-sub-code
      736           buf_temp-param.param-value    = p-value
      737         .
      738       end.
      739       else do:
      740           assign
      741               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      742           .
      743       end.
      744     end.
      745   end procedure.
      746   define variable vss-include-info4 as character format "X(65)" no-undo
      747   initial "@(#)$Workfile$ $Revision$".
      748   define variable v-fmtcli-name          as character    no-undo.
      749   define variable v-fmtcli-engl-name     as character    no-undo.
      750   define variable v-fmtcli-addres        as character    no-undo.
      751   define variable v-fmtcli-post-addres   as character    no-undo.
      752   define variable v-fmtcli-full-addres   as character    no-undo.
      753   define variable v-fmtcli-phone         as character    no-undo.
      754   define variable v-fmtcli-inn           as character    no-undo.
      755   define variable v-fmtcli-kpp           as character    no-undo.
      756   define variable v-fmtcli-okpo          as character    no-undo.
      757   define variable v-fmtcli-country       as character    no-undo.
      758   define variable v-fmtcli-city          as character    no-undo.
      759   define variable v-fmtcli-index         as character    no-undo.
      760   define variable v-fmtcli-schet-exists  as logical      no-undo.
      761   define variable v-fmtcli-bank-exists   as logical      no-undo.
      762   define variable v-fmtcli-bank-r-schet  as character    no-undo.
      763   define variable v-fmtcli-bank-c-schet  as character    no-undo.
      764   define variable v-fmtcli-bank-bik      as character    no-undo.
      765   define variable v-fmtcli-bank-name     as character    no-undo.
      766   define variable v-fmtcli-bank-addres   as character    no-undo.
      767   define variable v-fmtcli-bank-city     as character    no-undo.
      768   procedure fmtcli-get-bank :
      769   define input parameter p-host-code      as integer          no-undo.
      770   define input parameter p-obj-type       as character        no-undo.
      771   define input parameter p-obj-code       as integer          no-undo.
      772   define input parameter p-curr-code      as integer          no-undo.
      773       define buffer buf_fin-schet     for ub.fin-schet.
      774       define buffer buf_fin-bank      for ub.fin-bank.
      775   do
      776   for buf_fin-schet
      777     , buf_fin-bank
      778   on error undo, return error
      779   :
      780       assign
      781           v-fmtcli-schet-exists       = no
      782           v-fmtcli-bank-exists        = no
      783           v-fmtcli-bank-r-schet       = "":U
      784           v-fmtcli-bank-c-schet       = "":U
      785           v-fmtcli-bank-bik           = "":U
      786           v-fmtcli-bank-name          = "":U
      787           v-fmtcli-bank-addres        = "":U
      788           v-fmtcli-bank-city          = "":U
      789       .
      790       search-for-schet:
      791       for each buf_fin-schet no-lock
      792          where buf_fin-schet.host-code = p-host-code
      793            and buf_fin-schet.cli-type  = p-obj-type
      794            and buf_fin-schet.cli-code  = p-obj-code
      795            and buf_fin-schet.curr-code = p-curr-code
      796       on error undo, return error
      797       :
      798           if buf_fin-schet.status_   = 'удал':U
      799           then do:
      800           end.
      801           else do:
      802               assign
      803                   v-fmtcli-schet-exists   = yes
      804                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      805                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      806               .
      807               find first buf_fin-bank no-lock
      808                    where buf_fin-bank.host-code = p-host-code
      809                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      810               no-error.
      811               if available buf_fin-bank
      812               then do:
      813                   assign
      814                       v-fmtcli-bank-exists      = yes
      815                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      816                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      817                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      818                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      819                   .
      820               end.
      821               else do:
      822                   assign
      823                       v-fmtcli-bank-exists    = no
      824                       v-fmtcli-bank-bik       = "":U
      825                       v-fmtcli-bank-name      = "":U
      826                       v-fmtcli-bank-addres    = "":U
      827                       v-fmtcli-bank-city      = "":U
      828                   .
      829               end.
      830               leave search-for-schet.
      831           end.
      832       end.
      833   end.
      834   end procedure.
      835   procedure fmtcli-get-client :
      836   define input parameter p-obj-type       as character    no-undo.
      837   define input parameter p-obj-code       as integer      no-undo.
      838       define variable v-temp-fmtcli-address      as character     no-undo.
      839       define variable v-num-country-city    as integer      no-undo.
      840       define buffer buf_clients   for ub.clients.
      841       define buffer buf_firm      for ub.firm.
      842       define buffer buf_store     for ub.store.
      843       define buffer buf_shop      for ub.shop.
      844       define buffer buf_person    for ub.person.
      845   do
      846   for buf_clients
      847     , buf_firm
      848     , buf_store
      849     , buf_shop
      850     , buf_person
      851   on error undo, return error
      852   :
      853       assign
      854           v-fmtcli-name           = "":U
      855           v-fmtcli-addres         = "":U
      856           v-fmtcli-post-addres    = "":U
      857           v-fmtcli-full-addres    = "":U
      858           v-fmtcli-phone          = "":U
      859           v-fmtcli-inn            = "":U
      860           v-fmtcli-kpp            = "":U
      861           v-fmtcli-okpo           = "":U
      862           v-fmtcli-city           = "":U
      863           v-fmtcli-index          = "":U
      864           v-fmtcli-country        = "":U
      865       .
      866       find first buf_clients no-lock
      867            where buf_clients.obj-type = p-obj-type
      868              and buf_clients.obj-code = p-obj-code
      869       .
      870       assign
      871           v-fmtcli-name = buf_clients.obj-name
      872       .
      873       case buf_clients.obj-type:
      874          when 'орг':U
      875          then do:
      876               find first buf_firm no-lock
      877                    where buf_firm.firm-code = buf_clients.obj-code
      878                    no-error
      879               .
      880               if available buf_firm
      881               then do:
      882                   assign
      883                       v-num-country-city = num-entries( buf_firm.city )
      884                       v-fmtcli-engl-name = buf_firm.engl-name
      885                   .
      886                   if v-num-country-city > 0
      887                   then do:
      888                       assign
      889                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
      890                       .
      891                   end.
      892                   if v-num-country-city > 1
      893                   then do:
      894                       assign
      895                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
      896                       .
      897                   end.
      898                   run fmtcli-concatenate-strings in this-procedure (
      899                         input v-fmtcli-full-addres
      900                       , input v-fmtcli-country
      901                       , input ", ":U
      902                       , input 50
      903                       , output v-fmtcli-full-addres
      904                   ).
      905                   run fmtcli-concatenate-strings in this-procedure (
      906                         input v-fmtcli-full-addres
      907                       , input v-fmtcli-city
      908                       , input ", ":U
      909                       , input 50
      910                       , output v-fmtcli-full-addres
      911                   ).
      912                   run fmtcli-concatenate-strings in this-procedure (
      913                         input v-fmtcli-full-addres
      914                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
      915                       , input ", ":U
      916                       , input 50
      917                       , output v-fmtcli-full-addres
      918                   ).
      919                   run fmtcli-concatenate-strings in this-procedure (
      920                         input v-fmtcli-post-addres
      921                       , input v-fmtcli-country
      922                       , input ", ":U
      923                       , input 50
      924                       , output v-fmtcli-post-addres
      925                   ).
      926                   run fmtcli-concatenate-strings in this-procedure (
      927                         input v-fmtcli-post-addres
      928                       , input v-fmtcli-city
      929                       , input ", ":U
      930                       , input 50
      931                       , output v-fmtcli-post-addres
      932                   ).
      933                   run fmtcli-concatenate-strings in this-procedure (
      934                         input v-fmtcli-post-addres
      935                       , input string( buf_firm.ind )
      936                       , input ", ":U
      937                       , input 50
      938                       , output v-fmtcli-post-addres
      939                   ).
      940                   run fmtcli-concatenate-strings in this-procedure (
      941                         input substring( buf_firm.addres1, 1, 50 )
      942                       , input buf_firm.addres2
      943                       , input " ":U
      944                       , input 50
      945                       , output v-temp-fmtcli-address
      946                   ).
      947                   run fmtcli-concatenate-strings in this-procedure (
      948                         input v-temp-fmtcli-address
      949                       , input substring( buf_firm.addres1, 51, 50 )
      950                       , input " ":U
      951                       , input 50
      952                       , output v-temp-fmtcli-address
      953                   ).
      954                   run fmtcli-concatenate-strings in this-procedure (
      955                         input v-temp-fmtcli-address
      956                       , input substring( buf_firm.addres1, 101, 50 )
      957                       , input " ":U
      958                       , input 50
      959                       , output v-temp-fmtcli-address
      960                   ).
      961                   assign
      962                       v-fmtcli-addres = v-temp-fmtcli-address
      963                   .
      964                   if buf_firm.addres1 <> ?
      965                   then do:
      966                       run fmtcli-concatenate-strings in this-procedure (
      967                             input v-fmtcli-full-addres
      968                           , input v-fmtcli-addres
      969                           , input ", ":U
      970                           , input 0
      971                           , output v-fmtcli-full-addres
      972                       ).
      973                   end.
      974                   run fmtcli-concatenate-strings in this-procedure (
      975                         input substring( buf_firm.post-addr1, 1, 50 )
      976                       , input buf_firm.post-addr2
      977                       , input " ":U
      978                       , input 50
      979                       , output v-fmtcli-post-addres
      980                   ).
      981                   run fmtcli-concatenate-strings in this-procedure (
      982                         input v-fmtcli-post-addres
      983                       , input substring( buf_firm.post-addr1, 51, 50 )
      984                       , input " ":U
      985                       , input 50
      986                       , output v-fmtcli-post-addres
      987                   ).
      988                   run fmtcli-concatenate-strings in this-procedure (
      989                         input v-fmtcli-post-addres
      990                       , input substring( buf_firm.post-addr1, 101, 50 )
      991                       , input " ":U
      992                       , input 50
      993                       , output v-fmtcli-post-addres
      994                   ).
      995                   assign
      996                       v-fmtcli-phone         = buf_firm.phone
      997                       v-fmtcli-inn           = buf_firm.inn
      998                       v-fmtcli-kpp           = buf_firm.kpp
      999                       v-fmtcli-okpo          = buf_firm.okpo
     1000                       v-fmtcli-index         = string( buf_firm.ind )
     1001                   .
     1002               end.
     1003          end.
     1004          when 'маг':U
     1005          then do:
     1006               find first buf_shop no-lock
     1007                    where buf_shop.obj-code = buf_clients.obj-code
     1008               .
     1009               if available buf_shop
     1010               then do:
     1011                   run fmtcli-concatenate-strings in this-procedure (
     1012                         input buf_shop.addres1
     1013                       , input buf_shop.addres2
     1014                       , input " ":U
     1015                       , input 50
     1016                       , output v-fmtcli-addres
     1017                   ).
     1018                   assign
     1019                       v-fmtcli-full-addres = v-fmtcli-addres
     1020                       v-fmtcli-post-addres = v-fmtcli-addres
     1021                       v-fmtcli-phone       = buf_shop.phone
     1022                       v-fmtcli-inn         = "":U
     1023                       v-fmtcli-kpp         = "":U
     1024                       v-fmtcli-okpo        = "":U
     1025                       v-fmtcli-city        = "":U
     1026                       v-fmtcli-index       = "":U
     1027                   .
     1028               end.
     1029          end.
     1030          when 'скл':U
     1031          then do:
     1032               find first buf_store no-lock
     1033                    where buf_store.obj-code = buf_clients.obj-code
     1034               .
     1035               if available buf_store
     1036               then do:
     1037                   run fmtcli-concatenate-strings in this-procedure (
     1038                         input buf_store.addres1
     1039                       , input buf_store.addres2
     1040                       , input " ":U
     1041                       , input 50
     1042                       , output v-fmtcli-addres
     1043                   ).
     1044                   assign
     1045                       v-fmtcli-full-addres = v-fmtcli-addres
     1046                       v-fmtcli-phone       = buf_store.phone
     1047                       v-fmtcli-inn         = "":U
     1048                       v-fmtcli-kpp         = "":U
     1049                       v-fmtcli-okpo        = "":U
     1050                       v-fmtcli-city        = "":U
     1051                       v-fmtcli-index       = "":U
     1052                   .
     1053               end.
     1054          end.
     1055          when 'чел':U
     1056          then do:
     1057               find first buf_person no-lock
     1058                    where buf_person.psn-code = buf_clients.obj-code
     1059               .
     1060               if available buf_person
     1061               then do:
     1062                   run fmtcli-concatenate-strings in this-procedure (
     1063                         input ( if buf_person.ind = 0 or buf_person.ind = ?
     1064                                 then "":U
     1065                                 else string( buf_person.ind, "999999")
     1066                                 )
     1067                       , input buf_person.city
     1068                       , input ", ":U
     1069                       , input 0
     1070                       , output v-fmtcli-full-addres
     1071                   ).
     1072                   assign
     1073                       v-fmtcli-addres = buf_person.address
     1074                   .
     1075                   run fmtcli-concatenate-strings in this-procedure (
     1076                         input v-fmtcli-full-addres
     1077                       , input v-fmtcli-addres
     1078                       , input ", ":U
     1079                       , input 0
     1080                       , output v-fmtcli-full-addres
     1081                   ).
     1082                   assign
     1083                       v-fmtcli-phone     = buf_person.phone1
     1084                       v-fmtcli-inn       = buf_person.inn
     1085                       v-fmtcli-kpp       = buf_person.kpp
     1086                       v-fmtcli-okpo      = buf_person.okpo
     1087                       v-fmtcli-city      = buf_person.city
     1088                       v-fmtcli-index     = string( buf_person.ind )
     1089                   .
     1090               end.
     1091          end.
     1092       end case.
     1093   end.
     1094   end procedure.
     1095   procedure fmtcli-concatenate-strings :
     1096   define input parameter p-string-1       as character        no-undo.
     1097   define input parameter p-string-2       as character        no-undo.
     1098   define input parameter p-delimiter      as character        no-undo.
     1099   define input parameter p-length         as integer          no-undo.
     1100   define output parameter p-out-string    as character        no-undo.
     1101   do
     1102   on error undo, return error
     1103   :
     1104       assign
     1105           p-out-string = ( if p-string-1 = ?
     1106                            then "":U
     1107                            else trim( p-string-1 ) )
     1108       .
     1109       assign
     1110           p-out-string = p-out-string
     1111                        + ( if p-out-string = "":U
     1112                            or length( p-out-string ) = p-length
     1113                            or p-string-2 = ?
     1114                            or trim( p-string-2 ) = "":U
     1115                            then "":U
     1116                            else p-delimiter )
     1117                        + ( if p-string-2 = ?
     1118                            or trim( p-string-2 ) = "":U
     1119                            then "":U
     1120                            else trim( p-string-2 ) )
     1121       .
     1122   end.
     1123   end procedure.
     1124   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
