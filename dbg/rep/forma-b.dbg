     2561   procedure torgconf-get-sup-param :
     2562   define input parameter p-obj-type           as character        no-undo.
     2563   define input parameter p-obj-code           as integer          no-undo.
     2564   define input parameter p-curr-code          as integer          no-undo.
     2565       define variable v-host-code    as integer      no-undo.
     2566       define variable v-par-type     as character    no-undo.
     2567   do
     2568   on error undo, return error
     2569   :
     2570       assign
     2571          v-torgconf-sup-host-code = v-host-code
     2572       .
     2573       if v-torgconf-sup-host-code = 0
     2574       then do:
     2575           assign
     2576               v-torgconf-sup-host-name           = "":U
     2577               v-torgconf-sup-host-addres         = "":U
     2578               v-torgconf-sup-host-post-addres    = "":U
     2579               v-torgconf-sup-host-phone          = "":U
     2580               v-torgconf-sup-host-inn            = "":U
     2581               v-torgconf-sup-host-kpp            = "":U
     2582               v-torgconf-sup-host-okpo           = "":U
     2583               v-torgconf-sup-host-egrip-date     = "":U
     2584               v-torgconf-sup-host-egrip-num      = "":U
     2585           .
     2586       end.
     2587       else do:
     2588           run fmtcli-get-client in this-procedure (
     2589                 input 'орг':U
     2590               , input v-torgconf-sup-host-code
     2591           ).
     2592           assign
     2593               v-torgconf-sup-host-name        = v-fmtcli-name
     2594               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     2595               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     2596               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     2597               v-torgconf-sup-host-phone       = v-fmtcli-phone
     2598               v-torgconf-sup-host-inn         = v-fmtcli-inn
     2599               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     2600               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     2601           .
     2602           run gbl/clntat-v.p (
     2603                 input 'орг':U
     2604               , input v-torgconf-sup-host-code
     2605               , input 'egrip-date':U
     2606               , output v-torgconf-sup-host-egrip-date
     2607               , output v-par-type
     2608           ).
     2609           run gbl/clntat-v.p (
     2610                 input 'орг':U
     2611               , input v-torgconf-sup-host-code
     2612               , input 'egrip-num':U
     2613               , output v-torgconf-sup-host-egrip-num
     2614               , output v-par-type
     2615           ).
     2616           run fmtcli-get-bank in this-procedure (
     2617                 input v-host-code
     2618               , input 'орг':U
     2619               , input v-torgconf-sup-host-code
     2620               , input p-curr-code
     2621           ).
     2622       end.
     2623       assign
     2624           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     2625           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     2626           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     2627           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     2628           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     2629           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     2630           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     2631           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     2632       .
     2633       assign
     2634           v-torgconf-sup-obj-type = p-obj-type
     2635           v-torgconf-sup-obj-code = p-obj-code
     2636       .
     2637       if trim(p-obj-type) <> ""
     2638       and p-obj-code <> 0
     2639       then do:
     2640       run fmtcli-get-client in this-procedure (
     2641             input p-obj-type
     2642           , input p-obj-code
     2643       ).
     2644       assign
     2645           v-torgconf-sup-obj-name        = v-fmtcli-name
     2646           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     2647           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     2648           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     2649           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     2650           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     2651           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     2652       .
     2653      end.
     2654      end.
     2655   end procedure.
     2656   procedure torgconf-get-cli-param :
     2657   define input parameter p-host-obj-code      as integer          no-undo.
     2658   define input parameter p-obj-type           as character        no-undo.
     2659   define input parameter p-obj-code           as integer          no-undo.
     2660   define input parameter p-curr-code          as integer          no-undo.
     2661       define variable v-host-code    as integer      no-undo.
     2662   do
     2663   on error undo, return error
     2664   :
     2665       assign
     2666           v-torgconf-cli-type = p-obj-type
     2667           v-torgconf-cli-code = p-obj-code
     2668       .
     2669       run fmtcli-get-client in this-procedure (
     2670             input p-obj-type
     2671           , input p-obj-code
     2672       ).
     2673       assign
     2674           v-torgconf-cli-name         = trim( v-fmtcli-name          )
     2675           v-torgconf-cli-engl-name    = trim( v-fmtcli-engl-name          )
     2676           v-torgconf-cli-addres       = trim( v-fmtcli-full-addres   )
     2677           v-torgconf-cli-post-addres  = trim( v-fmtcli-post-addres   )
     2678           v-torgconf-cli-phone        = trim( v-fmtcli-phone         )
     2679           v-torgconf-cli-inn          = trim( v-fmtcli-inn           )
     2680           v-torgconf-cli-kpp          = trim( v-fmtcli-kpp           )
     2681           v-torgconf-cli-okpo         = trim( v-fmtcli-okpo          )
     2682       .
     2683      run fmtcli-get-bank in this-procedure (
     2684             input p-host-obj-code
     2685           , input p-obj-type
     2686           , input p-obj-code
     2687           , input p-curr-code
     2688       ).
     2689       assign
     2690           v-torgconf-cli-schet-exists = v-fmtcli-schet-exists
     2691           v-torgconf-cli-bank-exists  = v-fmtcli-bank-exists
     2692           v-torgconf-cli-bank-r-schet = v-fmtcli-bank-r-schet
     2693           v-torgconf-cli-bank-c-schet = v-fmtcli-bank-c-schet
     2694           v-torgconf-cli-bank-bik     = v-fmtcli-bank-bik
     2695           v-torgconf-cli-bank-name    = v-fmtcli-bank-name
     2696           v-torgconf-cli-bank-addres  = v-fmtcli-bank-addres
     2697           v-torgconf-cli-bank-city    = v-fmtcli-bank-city
     2698       .
     2699   end.
     2700   end procedure.
     2701   procedure torgconf-get-ship-param :
     2702   define input parameter p-host-obj-code      as integer          no-undo.
     2703   define input parameter p-obj-type           as character        no-undo.
     2704   define input parameter p-obj-code           as integer          no-undo.
     2705   define input parameter p-curr-code          as integer          no-undo.
     2706       define variable v-host-code    as integer      no-undo.
     2707   do
     2708   on error undo, return error
     2709   :
     2710       assign
     2711           v-torgconf-ship-type = p-obj-type
     2712           v-torgconf-ship-code = p-obj-code
     2713       .
     2714       if trim(p-obj-type) = ""
     2715       and p-obj-code = 0
     2716       then do:
     2717       assign
     2718           v-torgconf-ship-name         = "":U
     2719           v-torgconf-ship-addres       = "":U
     2720           v-torgconf-ship-post-addres  = "":U
     2721           v-torgconf-ship-phone        = "":U
     2722           v-torgconf-ship-inn          = "":U
     2723           v-torgconf-ship-kpp          = "":U
     2724           v-torgconf-ship-okpo         = "":U
     2725       .
     2726       end.
     2727       else do:
     2728       run fmtcli-get-client in this-procedure (
     2729             input p-obj-type
     2730           , input p-obj-code
     2731       ).
     2732       assign
     2733           v-torgconf-ship-name         = trim( v-fmtcli-name          )
     2734           v-torgconf-ship-engl-name    = trim( v-fmtcli-engl-name          )
     2735           v-torgconf-ship-addres       = trim( v-fmtcli-full-addres   )
     2736           v-torgconf-ship-post-addres  = trim( v-fmtcli-post-addres   )
     2737           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     2738           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     2739           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     2740           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     2741       .
     2742       end.
     2743           run fmtcli-get-bank in this-procedure (
     2744             input p-host-obj-code
     2745           , input p-obj-type
     2746           , input p-obj-code
     2747           , input p-curr-code
     2748       ).
     2749       assign
     2750           v-torgconf-ship-schet-exists = v-fmtcli-schet-exists
     2751           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
     2752           v-torgconf-ship-bank-r-schet = v-fmtcli-bank-r-schet
     2753           v-torgconf-ship-bank-c-schet = v-fmtcli-bank-c-schet
     2754           v-torgconf-ship-bank-bik     = v-fmtcli-bank-bik
     2755           v-torgconf-ship-bank-name    = v-fmtcli-bank-name
     2756           v-torgconf-ship-bank-addres  = v-fmtcli-bank-addres
     2757           v-torgconf-ship-bank-city    = v-fmtcli-bank-city
     2758       .
     2759   end.
     2760   end procedure.
     2761   procedure torgconf-get-holdfirm-code :
     2762   define input parameter p-obj-type   as character        no-undo.
     2763   define input parameter p-obj-code   as integer          no-undo.
     2764   define output parameter p-firm-code as integer          no-undo.
     2765       define variable v-firm-code-str     as character    no-undo.
     2766       define variable v-par-type          as character    no-undo.
     2767       define buffer buf_clients       for ub.clients.
     2768   do
     2769   for buf_clients
     2770   on error undo, return error
     2771   :
     2772       run gbl/clntat-v.p (
     2773             input p-obj-type
     2774           , input p-obj-code
     2775           , input 'holdfirm-code':U
     2776           , output v-firm-code-str
     2777           , output v-par-type
     2778       ).
     2779       assign
     2780           p-firm-code = integer( v-firm-code-str )
     2781       no-error.
     2782       if error-status :error
     2783       then do:
     2784           message
     2785               "Неверно задан код фирмы для печати накладных."
     2786           view-as alert-box warning.
     2787           assign
     2788               p-firm-code = 0
     2789           .
     2790       end.
     2791       else do:
     2792           find first buf_clients no-lock
     2793                where buf_clients.obj-type = 'орг':U
     2794                  and buf_clients.obj-code = p-firm-code
     2795           no-error.
     2796           if not available buf_clients
     2797           then do:
     2798               message
     2799                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     2800                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     2801               view-as alert-box warning.
     2802               assign
     2803                   p-firm-code = 0
     2804               .
     2805           end.
     2806       end.
     2807   end.
     2808   end procedure.
     2809   procedure torgconf-get-post-head:
     2810   define input  parameter p-obj-type             as character        no-undo.
     2811   define input  parameter p-obj-code             as integer          no-undo.
     2812   define output parameter p-torgconf-post-head   as character        no-undo.
     2813      define variable v-host-code         as integer      no-undo.
     2814      define buffer buf_sysconf     for ub.sysconf.
     2815        assign
     2816         p-torgconf-post-head  = ""
     2817        .
     2818   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2819   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2820     (input  p-obj-type
     2821     ,input  p-obj-code
     2822     ,output v-host-code
     2823     )  .
     2824      find first buf_sysconf no-lock
     2825      where buf_sysconf.host-code = v-host-code
     2826      no-error.
     2827      if available buf_sysconf
     2828      then do:
     2829         assign
     2830            p-torgconf-post-head = buf_sysconf.head-position
     2831         .
     2832      end.
     2833   end procedure.
     2834   procedure torgconf-get-storekeeper:
     2835   define input  parameter p-wrkr                   as integer          no-undo.
     2836   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     2837   define output parameter p-torgconf-post          as character        no-undo.
     2838      define buffer buf_sysconf     for ub.sysconf.
     2839      define buffer buf_person      for ub.person.
     2840      define buffer buf_shop        for ub.shop .
     2841      define buffer buf_store       for ub.store .
     2842      if v-torgconf-outC = "no_print"
     2843      then do:
     2844         assign p-torgconf-post = ""
     2845                p-torgconf-wrkr-name = ""
     2846                .
     2847      end.
     2848      if v-torgconf-outC = "clad_doc"
     2849      then do:
     2850         run rep/get-psn.p
     2851               (input  p-wrkr
     2852               ,output p-torgconf-wrkr-name
     2853               ) .
     2854         find first buf_person no-lock
     2855         where buf_person.psn-code = p-wrkr
     2856         no-error.
     2857         if available buf_person
     2858         then do:
     2859           p-torgconf-post = buf_person.position.
     2860         end.
     2861         if p-torgconf-post = "?":U then p-torgconf-post = "".
     2862         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2863      end.
     2864      if v-torgconf-outC = "clad_obj"
     2865      then do:
     2866         CASE v-torgconf-self-obj-type:
     2867         WHEN 'маг':U
     2868         THEN DO:
     2869            find first buf_shop no-lock
     2870            where buf_shop.obj-code = v-torgconf-self-obj-code
     2871            .
     2872            assign
     2873               p-torgconf-wrkr-name = buf_shop.store-man
     2874               p-torgconf-post = ""
     2875            .
     2876            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2877         END.
     2878         WHEN 'скл':U
     2879         THEN DO:
     2880            find first buf_store no-lock
     2881            where buf_store.obj-code = v-torgconf-self-obj-code
     2882            .
     2883            assign
     2884               p-torgconf-wrkr-name = buf_store.store-man
     2885               p-torgconf-post = ""
     2886            .
     2887            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2888         END.
     2889         OTHERWISE DO:
     2890            assign
     2891               p-torgconf-post = "":U
     2892               p-torgconf-wrkr-name = "":U
     2893            .
     2894         END.
     2895         END CASE.
     2896      end.
     2897    end procedure.
     2898   procedure torgconf-get-form-header :
     2899   define input parameter p-for-inverse    as logical          no-undo.
     2900   define input parameter p-doc-code       as character        no-undo.
     2901   define input parameter p-print-doc      as logical          no-undo.
     2902   define input parameter p-doc-date       as date             no-undo.
     2903   define input parameter p-fact-date      as date             no-undo.
     2904   define input parameter p-doc-type       as character        no-undo.
     2905   define input parameter p-status_        as character        no-undo.
     2906   define input parameter p-reverse        as logical          no-undo.
     2907   define input parameter p-sf-par         as logical          no-undo.
     2908       define variable v-attr-type         as character    no-undo.
     2909       define variable v-doc-code-standard as logical      no-undo.
     2910       define variable v-doc-date-standard as logical      no-undo.
     2911       define variable v-par-consignee-addres  as character    no-undo.
     2912       define variable v-host-code         as integer      no-undo.
     2913       define variable v-dcode-attr        as character    no-undo.
     2914       define variable v-ddate-attr        as character    no-undo.
     2915       define variable v-doc-date          as character    no-undo.
     2916       define variable v-doc-code          as character    no-undo.
     2917       define variable v-par-type          as character    no-undo.
     2918       define variable v-attr              as character    no-undo.
     2919       define buffer buf_firm          for ub.firm .
     2920       define buffer buf_clients       for ub.clients .
     2921       define buffer buf_sysconf       for ub.sysconf .
     2922       define buffer buf_shop          for ub.shop .
     2923       define buffer buf_store         for ub.store .
     2924       define buffer buf_person        for ub.person .
     2925       define buffer buf_trn-doc       for ub.trn-doc .
     2926       define buffer buf_wth-doc       for ub.wth-doc .
     2927       do
     2928   for buf_firm
     2929     , buf_clients
     2930     , buf_sysconf
     2931     , buf_shop
     2932     , buf_trn-doc
     2933     , buf_person
     2934     , buf_wth-doc
     2935   on error undo, return error
     2936   :
     2937       if p-doc-type = 'при':U
     2938       or p-doc-type = 'возврат':U
