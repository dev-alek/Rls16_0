     4645   procedure torgconf-get-reason  :
     4646   define input parameter  p-doc-code       as character        no-undo.
     4647   define input parameter  p-reason-code    as integer          no-undo .
     4648   define input parameter  p-doc-type       as character        no-undo.
     4649       if p-reason-code > 0
     4650       then do:
     4651           define buffer buf_trn-reason for ub.trn-reason.
     4652           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     4653           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     4654       end.
     4655       else do:
     4656           if p-doc-type = 'при':U
     4657           then  do:
     4658               define variable v-attr-type     as character    no-undo.
     4659               define variable v-attr-value    as character    no-undo.
     4660               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     4661               assign v-torgconf-reason = v-attr-value .
     4662               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     4663               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     4664           end.
     4665       end.
     4666   end procedure.
