     2274               v-torgconf-self-host-engl-name   = v-fmtcli-engl-name
     2275               v-torgconf-self-host-addres      = v-fmtcli-full-addres
     2276               v-torgconf-self-host-post-addres = v-fmtcli-post-addres
     2277               v-torgconf-self-host-phone       = v-fmtcli-phone
     2278               v-torgconf-self-host-inn         = v-fmtcli-inn
     2279               v-torgconf-self-host-kpp         = v-fmtcli-kpp
     2280               v-torgconf-self-host-okpo        = v-fmtcli-okpo
     2281           .
     2282           run gbl/clntat-v.p (
     2283                 input 'орг':U
     2284               , input v-torgconf-self-host-code
     2285               , input 'egrip-date':U
     2286               , output v-torgconf-self-host-egrip-date
     2287               , output v-par-type
     2288           ).
     2289           run gbl/clntat-v.p (
     2290                 input 'орг':U
