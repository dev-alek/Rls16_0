     2292               , input 'egrip-num':U
     2293               , output v-torgconf-self-host-egrip-num
     2294               , output v-par-type
     2295           ).
     2296           run fmtcli-get-bank in this-procedure (
     2297                 input v-host-code
     2298               , input 'орг':U
     2299               , input v-torgconf-self-host-code
     2300               , input p-curr-code
     2301           ).
     2302       end.
     2303       assign
     2304           v-torgconf-self-schet-exists = v-fmtcli-schet-exists
     2305           v-torgconf-self-bank-exists  = v-fmtcli-bank-exists
     2306           v-torgconf-self-bank-r-schet = v-fmtcli-bank-r-schet
     2307           v-torgconf-self-bank-c-schet = v-fmtcli-bank-c-schet
