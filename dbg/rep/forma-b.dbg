     4840       input t-doc.obj-type ,
     4841       input t-doc.obj-code
     4842       ).
     4843     run proc-get-country-name in this-procedure
     4844       ( input parts.in-code,
     4845       input parts.part-code
     4846       , input goods.gds-code
     4847       ,output v-country-name
     4848       ) .
     4849     RUN clntattr-value IN THIS-PROCEDURE
     4850       (INPUT t-doc.obj-type,
     4851       INPUT t-doc.obj-code,
     4852       input 'kpp':U,
     4853       OUTPUT v-kpp,
     4854       OUTPUT var-type).
     4855     run gds-attr-value(
     4856       ub.goods.gds-code,
     4857       'alcohol-prod':U,
     4858       output v-par-val,
     4859       output v-par-type
     4860       ).
     4861     if v-par-val <> "" and
     4862       v-par-val <> "no" then
     4863     do:
     4864       v-alc-type-name = "".
     4865       v-alc-type-code = "".
     4866       p-ii = p-ii + 1.
     4867       find first ex-mark no-lock
     4868         where
     4869         ex-mark.mark-code = parts.mark-code
     4870         no-error.
