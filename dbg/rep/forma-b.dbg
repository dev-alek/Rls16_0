     1904   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1905   procedure wthcattr-sprcli :
     1906   define input parameter parparentproc  as widget-handle no-undo.
     1907   define input parameter p-mode  as character no-undo.
     1908   define input-output parameter p-value as character no-undo .
     1909   define output parameter p-setted as logical no-undo .
     1910     DEFINE VARIABLE v-value as character no-undo .
     1911     define variable v-cli-type as character no-undo .
     1912     define variable v-cli-code as integer no-undo .
     1913     define buffer buf_clients   for ub.clients.
     1914     define variable v_rid as character no-undo.
     1915     define variable ref-rec as recid no-undo .
     1916     do
     1917     on error undo, return error
     1918     :
     1919         v-value = p-value.
     1920      if p-value <> '':U then do:
     1921       assign
     1922       v-cli-type = substring(p-value, 1, 3)
     1923       v-cli-code = integer(substring(p-value, 4))
     1924       no-error.
     1925       if error-status:error then do:
     1926         assign
     1927         v-cli-type = '':U
     1928         v-cli-code = 0
     1929         .
     1930       end.
     1931      end.
     1932      FIND FIRST buf_clients NO-LOCK WHERE
     1933               buf_clients.obj-type = v-cli-type AND
     1934               buf_clients.obj-code = v-cli-code  NO-ERROR.
     1935      IF available(buf_clients) then do:
     1936       run ref/cli-all.w (
     1937                   input parparentproc
     1938                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
     1939                  ,input v-cli-type
     1940                  ,input 'все':U
     1941                  ,input 'все':U
     1942                  ,input RECID( buf_clients )
     1943                  ,input ",,,,,,NO"
     1944                  ,input ?
     1945                  ,OUTPUT v_rid ).
     1946     END.
     1947     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     1948       run ref/cli-all.w (
     1949                    input parparentproc
     1950                   ,INPUT "b-sel":U
     1951                  ,input  v-cli-type
     1952                  ,input 'все':U
     1953                  ,input 'текущие':U
     1954                  ,input ?
     1955                  ,input ",,,,,,NO"
     1956                  ,input ?
     1957                  ,OUTPUT v_rid ).
     1958     END.
     1959     else do:
     1960       message
     1961       if p-value = "":U then 'Атрибут не задан!'
     1962       else substitute('Не найден клиент &1',p-value)
     1963       view-as alert-box warning.
     1964     end.
     1965     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1966       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1967       IF ERROR-STATUS:ERROR THEN DO:
     1968           RETURN NO-APPLY.
     1969       END.
     1970       FIND FIRST buf_clients NO-LOCK WHERE
     1971                  RECID( buf_clients ) = ref-rec NO-ERROR.
     1972       IF AVAIL buf_clients THEN DO:
     1973         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     1974       end.
     1975     end.
     1976     if v-value <> p-value then do:
     1977       p-value = v-value.
     1978       p-setted = yes.
     1979     end.
     1980     end.
     1981   end procedure.
     1982     define new global shared variable g#wthcalib as handle no-undo.
     1983   procedure torgconf-read :
     1984   do
     1985   on error undo, return error
     1986   :
     1987       define input parameter p-form-name  as character    no-undo.
     1988       define input parameter p-host-code  as integer      no-undo.
     1989       define input parameter p-obj-type   as character    no-undo.
     1990       define input parameter p-obj-code   as integer      no-undo.
     1991       define variable v-outdate   as character     no-undo.
     1992       define variable v-outares   as character     no-undo.
     1993       define variable v-outsend   as character     no-undo.
     1994       define variable v-outasend  as character     no-undo.
     1995       define variable v-outprops  as character     no-undo.
     1996       define variable v-outnum    as character     no-undo.
     1997       define variable v-outprim   as character     no-undo.
     1998       define variable v-outdisc   as character     no-undo.
     1999       define variable v-outsubs   as character     no-undo.
     2000       define variable v-outrecv   as character     no-undo.
     2001       define variable v-outegrp   as character     no-undo.
     2002       define variable v-outt12    as character     no-undo.
     2003       define variable v-outappr   as character     no-undo.
     2004       define variable v-outrubl   as character     no-undo.
     2005       define variable v-outhold   as character     no-undo.
     2006       define variable v-outobj    as character     no-undo.
     2007       define variable v-outexlst  as character     no-undo.
     2008       define variable v-outprncd  as character     no-undo.
     2009       define variable v-par-type  as character     no-undo.
     2010       define variable v-outogr    as character     no-undo.
     2011       define variable v-outR      as character     no-undo.
     2012       define variable v-outB      as character     no-undo.
     2013       define variable v-outC      as character     no-undo.
     2014       assign
     2015           v-torgconf-outdate  = no
     2016           v-torgconf-outnum   = no
     2017           v-torgconf-outprim  = no
     2018           v-torgconf-outdisc  = no
     2019           v-torgconf-outsubs  = no
     2020           v-torgconf-outrecv  = no
     2021           v-torgconf-outegrp  = no
     2022           v-torgconf-outt12   = no
     2023           v-torgconf-outappr  = no
     2024           v-torgconf-outrubl  = no
     2025           v-torgconf-outhold  = no
     2026           v-torgconf-outobj   = no
     2027           v-torgconf-outexlst = no
     2028           v-torgconf-outexpas = "":U
     2029           v-torgconf-outprncd = yes
     2030           v-torgconf-outares  = no
     2031           v-torgconf-outsend  = no
     2032           v-torgconf-outasend  = no
     2033           v-torgconf-outprops  = no
     2034           v-form-name          = p-form-name
     2035       .
     2036   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2037   empty temp-table thbjattr_thbj-attr.
     2038   run adm/shattri.p (
     2039      input "get":U
     2040     ,input ''
     2041     ,input 0
     2042     ,input 'prt-glob':U
     2043     ,input  ""
     2044     ,output v-value-character
     2045     ,output v-value-date
     2046     ,output v-value-decimal
     2047     ,output v-value-integer
     2048     ,output v-value-logical
     2049     ,output par-type
     2050     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     2051     ) no-error .
     2052   for each thbjattr_thbj-attr :
     2053       if thbjattr_thbj-attr.prop-code = 'outprncd':U then v-outprncd =  string(thbjattr_thbj-attr.property-value-logical) .
     2054       if thbjattr_thbj-attr.prop-code = 'outrecv':U  then v-outrecv  =  thbjattr_thbj-attr.property-value-character .
     2055       if thbjattr_thbj-attr.prop-code = 'outprops':U then v-outprops =  thbjattr_thbj-attr.property-value-character .
     2056   end.
     2057   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2058   empty temp-table thbjattr_thbj-attr.
     2059   run adm/shattri.p (
     2060      input "get":U
     2061     ,input p-obj-type
     2062     ,input p-obj-code
     2063     ,input 'prt-obj':U
     2064     ,input  ""
     2065     ,output v-value-character
     2066     ,output v-value-date
     2067     ,output v-value-decimal
     2068     ,output v-value-integer
     2069     ,output v-value-logical
     2070     ,output par-type
     2071     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     2072     ) no-error .
     2073   for each thbjattr_thbj-attr :
     2074       if thbjattr_thbj-attr.prop-code = 'outdate':U  then v-outdate  =  thbjattr_thbj-attr.property-value-character .
     2075       if thbjattr_thbj-attr.prop-code = 'outares':U  then v-outares  =  thbjattr_thbj-attr.property-value-character .
     2076       if thbjattr_thbj-attr.prop-code = 'outnum':U   then v-outnum   =  thbjattr_thbj-attr.property-value-character .
     2077       if thbjattr_thbj-attr.prop-code = 'outprim':U  then v-outprim  =  thbjattr_thbj-attr.property-value-character .
     2078       if thbjattr_thbj-attr.prop-code = 'outdisc':U  then v-outdisc  =  thbjattr_thbj-attr.property-value-character .
     2079       if thbjattr_thbj-attr.prop-code = 'outsubs':U  then v-outsubs  =  thbjattr_thbj-attr.property-value-character .
     2080       if thbjattr_thbj-attr.prop-code = 'outegrp':U  then v-outegrp  =  thbjattr_thbj-attr.property-value-character .
     2081       if thbjattr_thbj-attr.prop-code = 'outt12':U   then v-outt12   =  thbjattr_thbj-attr.property-value-character .
     2082       if thbjattr_thbj-attr.prop-code = 'outappr':U  then v-outappr  =  thbjattr_thbj-attr.property-value-character .
     2083       if thbjattr_thbj-attr.prop-code = 'outrubl':U  then v-outrubl  =  thbjattr_thbj-attr.property-value-character .
     2084       if thbjattr_thbj-attr.prop-code = 'outhold':U  then v-outhold  =  thbjattr_thbj-attr.property-value-character .
     2085       if thbjattr_thbj-attr.prop-code = 'outobj':U   then v-outobj   =  thbjattr_thbj-attr.property-value-character .
     2086       if thbjattr_thbj-attr.prop-code = 'outsend':U  then v-outsend  =  thbjattr_thbj-attr.property-value-character .
     2087       if thbjattr_thbj-attr.prop-code = 'outasend':U then v-outasend =  thbjattr_thbj-attr.property-value-character .
     2088       if thbjattr_thbj-attr.prop-code = 'outogr':U   then v-torgconf-outogr   =  thbjattr_thbj-attr.property-value-character .
     2089       if thbjattr_thbj-attr.prop-code = 'outR':U     then v-torgconf-outR     =  thbjattr_thbj-attr.property-value-character .
     2090       if thbjattr_thbj-attr.prop-code = 'outB':U     then v-torgconf-outB     =  thbjattr_thbj-attr.property-value-character .
     2091       if thbjattr_thbj-attr.prop-code = 'outssdoc':U then v-torgconf-outssdoc =  thbjattr_thbj-attr.property-value-character .
     2092       if thbjattr_thbj-attr.prop-code = 'outC':U     then v-torgconf-outC     =  thbjattr_thbj-attr.property-value-character .
     2093   end.
