     4769   define buffer buf_ext-classif for ub.ext-classif.
     4770   FUNCTION get-country-name RETURNS CHARACTER
     4771     ( BUFFER buf_parts FOR parts )  FORWARD.
     4772   function fnc-DD-MM-YYYY returns character
     4773     (input p-dat-date as date) forward.
     4774   function fnc-fmt-dec-tc-litres returns character
     4775     (input p-num as decimal) forward.
     4776   function fnc-fmt-dec-tc-qnty returns character
     4777     (input p-num as decimal) forward.
     4778   function fnc-fmt-dec-tc-litres returns character
     4779     (input p-number as decimal):
     4780     define variable result as character no-undo.
     4781     define variable v-str1 as character no-undo.
     4782     v-str1 = trim(replace(string(p-number,'>>>>9.99<'), ".", ",")).
     4783     return v-str1.
     4784   end function.
     4785   function fnc-fmt-dec-tc-qnty returns character
     4786     (input p-number as decimal):
     4787     define variable result as character no-undo.
     4788     define variable v-str1 as character no-undo.
     4789     v-str1 = trim(replace(string(p-number,'->>>>>>>9.99<<'), ".", ",")).
     4790     return v-str1.
     4791   end function.
     4792   for each tt-rep1 no-lock:
     4793     delete tt-rep1.
     4794   end.
     4795   run get-full-path-RepViewer(output v-full-path-RepView).
