     4873       run text-month (input (MONTH(t-doc.fact-date)) , output v-month-text-otgr).
     4874       run text-month (input (MONTH(parts.alc-bottling-date)) , output v-month-text).
     4875       create tt-rep1.
     4876       assign
     4877         tt-rep1.ext-doc-type        = t-doc.ext-doc-type
     4878         tt-rep1.exp-name            = goods.gds-name
     4879         tt-rep1.volume-piece-litres = goods.ms-base
     4880         tt-rep1.fact-qnty           = parts.fact-qnty
     4881         tt-rep1.alc-qnty            = parts.fact-qnty * goods.ms-base / 10
     4882         tt-rep1.date-rozl           = parts.alc-bottling-date
     4883         tt-rep1.date-otgr           = t-doc.fact-date
     4884         tt-rep1.number-otgr         = t-doc.doc-code
     4885         tt-rep1.code_country        = v-country-name
     4886         tt-rep1.mark-code           = v-alc-mark-name
     4887         tt-rep1.name-kontr          = t-doc.cli-name
     4888         tt-rep1.ii                  = p-ii
     4889         tt-rep1.unit-base           = goods.unit-base
     4890         tt-rep1.month-otgr          = v-month-text-otgr
     4891         tt-rep1.month-rozl          = v-month-text
     4892         tt-rep1.name-obj            = v-fmtcli-name
     4893         tt-rep1.obj-adress          = v-fmtcli-full-addres
     4894         tt-rep1.obj-kpp             = v-kpp
     4895         .
     4896       run torgconf-get-warrant in this-procedure(
     4897       input t-doc.doc-code
     4898   ).
     4899     tt-rep1.name-prod = p-torgconf-t_pass-position + " " + p-torgconf-t_pass-fname .
     4900     tt-rep1.name-pol = p-torgconf-accept-position + " " + p-torgconf-accept-fname .
     4901       define var v-prod as char.
     4902       empty temp-table thbjattr_thbj-attr .
     4903       run adm/shattri.p (
     4904         input "get":U
     4905         ,input t-doc.obj-type
     4906         ,input t-doc.obj-code
     4907         ,input 'egais':U
     4908         ,input 'egais-inn':U
     4909         ,output v-value-character
     4910         ,output v-value-date
     4911         ,output v-value-decimal
     4912         ,output v-value-integer
     4913         ,output v-value-logical
     4914         ,output v-value-type
     4915         ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     4916         ) no-error .
     4917       assign
     4918         v-egais-inn = v-value-character .
     4919       run adm/shattri.p (
     4920         input "get":U
     4921         ,input '':U
     4922         ,input 0
     4923         ,input 'egais':U
     4924         ,input 'egais-exsys':U
     4925         ,output v-value-character
     4926         ,output v-value-date
     4927         ,output v-value-decimal
     4928         ,output v-value-integer
     4929         ,output v-value-logical
     4930         ,output v-value-type
     4931         ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     4932         ) no-error .
     4933       assign
     4934         v-ext-sys = v-value-integer .
     4935       find first buf_ext-classif no-lock where buf_ext-classif.classif-subject = 'goods':U
     4936         and buf_ext-classif.classif-name = 'exp-esys-gds-code':U
     4937         and buf_ext-classif.db-num = 0
     4938         and buf_ext-classif.key#_one = goods.gds-code
     4939         and buf_ext-classif.key#_two = v-ext-sys
     4940         no-error.
     4941       if available buf_ext-classif then
     4942       do:
     4943         v-prod = entry (1, buf_ext-classif.CharKey_Two, chr(4)) no-error.
     4944         assign
     4945           tt-rep1.name-proiz   = entry(4, v-prod, chr(5)) + ','
     4946           tt-rep1.adress-proiz = entry(6, v-prod, chr(5))
     4947           tt-rep1.inn          = entry(2, v-prod, chr(5))
     4948           tt-rep1.kpp          = entry(3, v-prod, chr(5))
     4949                   no-error
     4950           .
     4951       end.
     4952       else
