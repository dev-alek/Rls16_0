     2332   procedure torgconf-get-recepient-param :
     2333   define input parameter torgconfdoc-code   as character                  no-undo.
     2334   define output parameter v-code-rec        as integer                    no-undo .
     2335   define output parameter v-type-rec        as character                  no-undo initial 'C':U.
     2336   define output parameter v-codefirm-rec    as integer                    no-undo .
     2337   define output parameter v-curcode-rec     as integer                    no-undo .
     2338        define variable  v-recipient-code  as character                  no-undo .
     2339        define variable  v-recipient       like ub.doc-attr.attr-value   no-undo.
     2340        define variable  v-trdcattr-type   as character                  no-undo initial 'C':U.
     2341   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input torgconfdoc-code ,
     2342                           input 'Recipient':U ,
     2343                          output v-recipient-code ,
     2344                          output v-trdcattr-type ) no-error .
     2345       if error-status :error then do:
     2346        message
     2347         vss-workfile vss-revision vss-description skip
     2348         "Ошибка при вызове процедуры tdat-val":U skip
     2349         "Документ: " torgconfdoc-code skip
     2350         "Атрибут: " 'Recipient':U skip
     2351         "Значение: " v-recipient skip
     2352         trim( error-status :get-message (1) ) skip
     2353         return-value skip
     2354         view-as alert-box error.
     2355       undo, return error return-value.
     2356       end.
     2357     assign
     2358       v-recipient  = v-recipient-code
     2359       v-type-rec = substring(v-recipient-code,1,3)
     2360       v-code-rec  = int(substring(v-recipient-code,4,15))
     2361       no-error
     2362     .
     2363     if v-type-rec = ? then v-type-rec = "" .
     2364     if v-code-rec  = ? then v-code-rec  =  0 .
     2365     end procedure.
