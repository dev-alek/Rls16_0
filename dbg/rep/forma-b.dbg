     5686   run search-full-path-Report(input v-file-name-rep-htm).
     5687   run Report-Viewer(input v-full-path-RepView, input v-file-name-rep-htm).
     5688   procedure get-full-path-RepViewer:
     5689     define output parameter p-fill-path-RepView as character no-undo.
     5690     if search("exe\ReportViewer\reportviewer.exe") <> ? then
     5691     do:
     5692       p-fill-path-RepView = search("exe\ReportViewer\reportviewer.exe").
     5693     end.
     5694     else
     5695     do:
     5696       message "Не найдена программа просмотра отчёта!" view-as alert-box error.
     5697     end.
     5698   end procedure.
     5699   procedure search-full-path-Report:
     5700     define input parameter p-file-name as character no-undo.
     5701     if search(p-file-name) = ? then
     5702     do:
     5703       message "Не найден файл отчёта: " p-file-name view-as alert-box error.
     5704     end.
     5705     else
     5706     do:
     5707       p-file-name = search(p-file-name).
     5708     end.
     5709   end procedure.
     5710   procedure create-file:
     5711     define input parameter p-file-name as character no-undo.
     5712     output to value(string(p-file-name)).
     5713     output close.
     5714   end procedure.
     5715   procedure define-full-path-Report:
     5716     define input parameter p-rep-num as integer no-undo.
     5717     define output parameter p-file-name-rep-htm as character no-undo.
     5718     p-file-name-rep-htm = session:temp-directory  + string(p-rep-num) + ".html".
     5719   end procedure.
     5720   procedure Report-Viewer:
     5721     define input parameter p-full-path-RepView as character no-undo.
     5722     define input parameter p-file-name-rep-htm as character no-undo.
     5723     os-command no-wait value(p-full-path-RepView + " true " + search(p-file-name-rep-htm)).
     5724   end procedure.
     5725   procedure text-month:
     5726     define input parameter month-number as integer.
     5727     define output parameter p-month-text as char.
     5728     if month-number = 1 then p-month-text = "января".
     5729     if month-number = 2 then p-month-text = "февраля".
     5730     if month-number = 3 then p-month-text = "марта".
     5731     if month-number = 4 then p-month-text = "апреля".
     5732     if month-number = 5 then p-month-text = "мая".
     5733     if month-number = 6 then p-month-text = "июня".
     5734     if month-number = 7 then p-month-text = "июля".
     5735     if month-number = 8 then p-month-text = "августа".
     5736     if month-number = 9 then p-month-text = "сентября".
     5737     if month-number = 10 then p-month-text = "октября".
     5738     if month-number = 11 then p-month-text = "ноября".
     5739     if month-number = 12 then p-month-text = "декабря".
     5740   end.
     5741   PROCEDURE proc-get-country-name :
     5742     define input parameter p-in-code as char.
     5743     define input parameter p-part-code  as char.
     5744     define input parameter p-gds-code like goods.gds-code.
     5745     define output parameter p-country-name as character no-undo .
     5746     define buffer buf_parts-attr for ub.parts-attr .
     5747     define buffer buf_country    for ub.country .
     5748     find first buf_parts-attr no-lock
     5749       where buf_parts-attr.in-code   = p-in-code
     5750       and buf_parts-attr.gds-code  = p-gds-code
     5751       and buf_parts-attr.part-code = p-part-code
     5752       no-error .
     5753     if available buf_parts-attr
     5754       then
     5755     do:
     5756       find first buf_country no-lock
     5757         where buf_country.num-code = buf_parts-attr.country-code
     5758         no-error .
     5759       if not available buf_country
     5760         then
     5761       do:
     5762         assign
     5763           p-country-name = "XX Неизвестна"
     5764           .
     5765       end.
     5766       else
     5767       do:
     5768         assign
     5769           p-country-name = buf_country.alpha1
     5770           .
     5771       end.
     5772     end.
     5773   END PROCEDURE.
     5774   function fnc-DD-MM-YYYY returns character
     5775     (input p-dat-date as date):
     5776     define variable result     as character no-undo.
     5777     define variable p-str-date as character no-undo.
     5778     p-str-date = replace(string(p-dat-date,'99.99.9999'), "/", ".").
     5779     return p-str-date.
     5780   end function.
