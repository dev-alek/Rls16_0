     4804   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
     4805     (input  t-doc.obj-type
     4806     ,input  t-doc.obj-code
     4807     ,output v-cntxt-host-code-obj
     4808     ,output v-cntxt-host-name-obj
     4809     )  .
     4810   define variable p-ii as integer.
     4811   find OurObject where OurObject.obj-type = t-doc.obj-type and
     4812     OurObject.obj-code = t-doc.obj-code no-lock no-error.
     4813   case OurObject.obj-type :
     4814     when 'маг':U
     4815     then
     4816       do:
     4817         find shop where shop.obj-code = OurObject.obj-code no-lock no-error .
     4818         tdoc-prt = shop.doc-prt.
     4819       end.
     4820     when 'скл':U
     4821     then
     4822       do:
     4823         find store where store.obj-code = OurObject.obj-code no-lock no-error.
     4824         tdoc-prt = store.doc-prt .
     4825       end.
     4826   end case.
     4827   for each parts no-lock
     4828     where t-doc.doc-code = parts.out-code
     4829     and t-doc.obj-code = parts.obj-code and
     4830     t-doc.obj-type = parts.obj-type
     4831     ,first goods no-lock
     4832     where goods.prod-type    = parts.prod-type
     4833     and goods.prod-code    = parts.prod-code
     4834     and goods.artic        = parts.artic :
     4835     find first buf_clients no-lock
     4836       where buf_clients.obj-type = t-doc.obj-type
     4837       and buf_clients.obj-code = t-doc.obj-code
     4838       no-error .
