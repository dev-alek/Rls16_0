     2221   procedure torgconf-get-self-param :
     2222   define input parameter p-obj-type           as character        no-undo.
     2223   define input parameter p-obj-code           as integer          no-undo.
     2224   define input parameter p-curr-code          as integer          no-undo.
     2225       define variable v-host-code    as integer      no-undo.
     2226       define variable v-par-type     as character    no-undo.
     2227   do
     2228   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1))
     2229   :
     2230   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2231   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2232     (input  p-obj-type
     2233     ,input  p-obj-code
     2234     ,output v-host-code
     2235     )  .
     2236       if v-torgconf-outhold = yes
     2237       then do:
     2238           run torgconf-get-holdfirm-code in this-procedure (
     2239                 input p-obj-type
     2240               , input p-obj-code
     2241               , output v-torgconf-self-host-code
     2242           ).
     2243           if v-torgconf-self-host-code = 0
     2244           then do:
     2245               return error.
     2246           end.
     2247       end.
     2248       else do:
     2249           assign
     2250               v-torgconf-self-host-code = v-host-code
     2251           .
     2252       end.
     2253       if v-torgconf-self-host-code = 0
     2254       then do:
     2255           assign
     2256               v-torgconf-self-host-name           = "":U
     2257               v-torgconf-self-host-addres         = "":U
     2258               v-torgconf-self-host-post-addres    = "":U
     2259               v-torgconf-self-host-phone          = "":U
     2260               v-torgconf-self-host-inn            = "":U
     2261               v-torgconf-self-host-kpp            = "":U
     2262               v-torgconf-self-host-okpo           = "":U
     2263               v-torgconf-self-host-egrip-date     = "":U
     2264               v-torgconf-self-host-egrip-num      = "":U
     2265           .
     2266       end.
     2267       else do:
     2268           run fmtcli-get-client in this-procedure (
     2269                 input 'орг':U
     2270               , input v-torgconf-self-host-code
     2271           ).
     2272           assign
