     4043   run torgconf-read in this-procedure (
     4044         input "torg12z"
     4045       , input v-host-code
     4046       , input t-doc.obj-type
     4047       , input t-doc.obj-code
     4048   ) no-error.
     4049   if error-status :error
     4050   then do:
     4051       message
     4052       vss-workfile vss-revision vss-description
     4053       skip "Ошибка чтения параметров печати формы."
     4054       skip "Форма будет напечатана с параметрами по умолчанию."
     4055       skip return-value
     4056       skip trim(error-status :get-message(1))
     4057           trim(error-status :get-message(2))
     4058           trim(error-status :get-message(3))
