      914   define variable v-doc-code-attr                 as character no-undo.
      915   define variable v-torgconf-doc-date-attr        as character no-undo.
      916   define variable v-torgconf-vdoc-date            as character no-undo.
      917   define variable v-torgconf-main-boss-post       as character no-undo.
