     3405         end.
     3406      end.
     3407      else do:
     3408      find first buf_wth-doc no-lock
     3409         where buf_wth-doc.doc-code = p-doc-code
     3410         no-error.
     3411         if available buf_wth-doc
     3412            then do:
     3413   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3414   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3415     (input  buf_wth-doc.obj-type
     3416     ,input  buf_wth-doc.obj-code
     3417     ,output v-host-code
     3418     )  .
     3419            end.
     3420         if v-torgconf-outogr = "no_print"
     3421            then do:
     3422               assign
     3423                  v-torgconf-ogr-name = ""
     3424                  v-torgconf-ogr-post = ""
     3425               .
     3426            end.
     3427         if v-torgconf-outogr  = "ruk_firm"
     3428               then do:
     3429               find first buf_sysconf no-lock
     3430               where buf_sysconf.host-code = v-host-code
     3431               no-error.
     3432               if available buf_sysconf
     3433               then do:
     3434                  assign
     3435                     v-torgconf-ogr-post = buf_sysconf.head-position
     3436                  .
     3437               end.
     3438               find first buf_clients no-lock
     3439                  where buf_clients.obj-type = 'орг':U
     3440                  and buf_clients.obj-code = v-host-code
     3441               .
     3442               find first buf_firm no-lock
     3443                  where buf_firm.firm-code = buf_clients.obj-code
     3444               .
     3445               assign
     3446                  v-torgconf-ogr-name = buf_firm.director
     3447               .
     3448            end.
     3449            if v-torgconf-outogr = "dir_obj"
     3450               then do:
     3451               find first buf_wth-doc no-lock
     3452               where buf_wth-doc.doc-code = p-doc-code
     3453               no-error.
     3454                  find first buf_shop no-lock
     3455                  where buf_shop.obj-code = buf_wth-doc.obj-code
     3456                  .
     3457                  assign
     3458                     v-torgconf-ogr-name = buf_shop.director
     3459                     v-torgconf-ogr-post = "Директор"
     3460                  .
     3461               end.
     3462         if v-torgconf-outogr = "manag_doc"
     3463            then do:
     3464               find first buf_wth-doc no-lock
     3465               where buf_wth-doc.doc-code = p-doc-code
     3466               no-error.
     3467               if available buf_wth-doc
     3468               then do:
     3469                  run rep/get-psn.p
     3470                  (input buf_wth-doc.deliver
     3471                  ,output v-torgconf-ogr-name
     3472                  ) .
     3473               end.
     3474               find first buf_person no-lock
     3475               where buf_person.psn-code = buf_wth-doc.deliver
     3476               no-error.
     3477               if available buf_person
     3478               then do:
     3479                  v-torgconf-ogr-post = buf_person.position.
     3480               end.
     3481               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3482               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3483            end.
     3484      end.
     3485   end.
     3486   end procedure.
     3487   procedure torgconf-get-outogr-param:
     3488       define input parameter p-form-name  as character    no-undo.
     3489       define input parameter p-host-code  as integer      no-undo.
     3490       define input parameter p-obj-type   as character    no-undo.
     3491       define input parameter p-obj-code   as integer      no-undo.
     3492       define input parameter p-doc-code   as character      no-undo.
     3493       define buffer buf_firm          for ub.firm .
     3494       define buffer buf_clients       for ub.clients .
     3495       define buffer buf_sysconf       for ub.sysconf .
     3496       define buffer buf_shop          for ub.shop .
     3497       define buffer buf_store         for ub.store .
     3498       define buffer buf_person        for ub.person .
     3499       define buffer buf_trn-doc       for ub.trn-doc .
     3500       define buffer buf_wth-doc       for ub.wth-doc .
     3501      if  p-form-name <> 'wthtrg12':U
     3502      and p-form-name <> 'wthfct':U
     3503      and p-form-name <> 'wthm11':U
     3504      then do:
     3505       find first buf_trn-doc no-lock
     3506       where buf_trn-doc.doc-code = p-doc-code
     3507       no-error.
     3508       if v-torgconf-outogr = "no_print"
     3509         then do:
     3510            assign
     3511               v-torgconf-ogr-name = ""
     3512               v-torgconf-ogr-post = ""
     3513            .
     3514         end.
     3515      if v-torgconf-outogr  = "ruk_firm"
     3516            then do:
     3517            find first buf_sysconf no-lock
     3518            where buf_sysconf.host-code = p-host-code
     3519            no-error.
     3520            if available buf_sysconf
     3521            then do:
     3522               assign
     3523                  v-torgconf-ogr-post = buf_sysconf.head-position
     3524               .
     3525            end.
     3526            find first buf_clients no-lock
     3527                where buf_clients.obj-type = 'орг':U
     3528                and buf_clients.obj-code = p-host-code
     3529            .
     3530            find first buf_firm no-lock
     3531                where buf_firm.firm-code = buf_clients.obj-code
     3532            .
     3533            assign
     3534                v-torgconf-ogr-name = buf_firm.director
     3535            .
     3536         end.
     3537         if v-torgconf-outogr = "dir_obj"
     3538            then do:
     3539            find first buf_trn-doc no-lock
     3540            where buf_trn-doc.doc-code = p-doc-code
     3541            no-error.
     3542               CASE buf_trn-doc.obj-type:
     3543               WHEN 'маг':U
     3544               THEN DO:
     3545                  find first buf_shop no-lock
     3546                  where buf_shop.obj-code = buf_trn-doc.obj-code
     3547                  .
     3548                  assign
     3549                     v-torgconf-ogr-name = buf_shop.director
     3550                     v-torgconf-ogr-post = "Директор"
     3551                  .
     3552               END.
     3553               WHEN 'скл':U
     3554               THEN DO:
     3555                  find first buf_store no-lock
     3556                  where buf_store.obj-code = buf_trn-doc.obj-code
     3557                  .
     3558                  assign
     3559                     v-torgconf-ogr-name = buf_store.store-boss
     3560                     v-torgconf-ogr-post = "Директор"
     3561                  .
     3562               END.
     3563               OTHERWISE DO:
     3564                  assign
     3565                     v-torgconf-ogr-name = "":U
     3566                     v-torgconf-ogr-post = "":U
     3567                  .
     3568               END.
     3569               END CASE.
     3570            end.
     3571      if v-torgconf-outogr = "manag_doc"
     3572         then do:
     3573            find first buf_trn-doc no-lock
     3574            where buf_trn-doc.doc-code = p-doc-code
     3575            no-error.
     3576            if available buf_trn-doc
     3577            then do:
     3578               run rep/get-psn.p
     3579               (input buf_trn-doc.boss
     3580               ,output v-torgconf-ogr-name
     3581               ) .
     3582            end.
     3583            find first buf_person no-lock
     3584            where buf_person.psn-code = buf_trn-doc.boss
     3585            no-error.
     3586            if available buf_person
     3587            then do:
     3588               v-torgconf-ogr-post = buf_person.position.
     3589            end.
     3590            if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3591            if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3592         end.
     3593      end.
     3594      else do:
     3595      find first buf_wth-doc no-lock
     3596         where buf_wth-doc.doc-code = p-doc-code
     3597         no-error.
     3598         if v-torgconf-outogr = "no_print"
     3599            then do:
     3600               assign
     3601                  v-torgconf-ogr-name = ""
     3602                  v-torgconf-ogr-post = ""
     3603               .
     3604            end.
     3605         if v-torgconf-outogr  = "ruk_firm"
     3606               then do:
     3607               find first buf_sysconf no-lock
     3608               where buf_sysconf.host-code = p-host-code
     3609               no-error.
     3610               if available buf_sysconf
     3611               then do:
     3612                  assign
     3613                     v-torgconf-ogr-post = buf_sysconf.head-position
     3614                  .
     3615               end.
     3616               find first buf_clients no-lock
     3617                  where buf_clients.obj-type = 'орг':U
     3618                  and buf_clients.obj-code = p-host-code
     3619               .
     3620               find first buf_firm no-lock
     3621                  where buf_firm.firm-code = buf_clients.obj-code
     3622               .
     3623               assign
     3624                  v-torgconf-ogr-name = buf_firm.director
     3625               .
     3626            end.
     3627            if v-torgconf-outogr = "dir_obj"
     3628               then do:
     3629               find first buf_wth-doc no-lock
     3630               where buf_wth-doc.doc-code = p-doc-code
     3631               no-error.
     3632                  find first buf_shop no-lock
     3633                  where buf_shop.obj-code = buf_wth-doc.obj-code
     3634                  .
     3635                  assign
     3636                     v-torgconf-ogr-name = buf_shop.director
     3637                     v-torgconf-ogr-post = "Директор"
     3638                  .
     3639               end.
     3640         if v-torgconf-outogr = "manag_doc"
     3641            then do:
     3642               find first buf_wth-doc no-lock
     3643               where buf_wth-doc.doc-code = p-doc-code
     3644               no-error.
     3645               if available buf_wth-doc
     3646               then do:
     3647                  run rep/get-psn.p
     3648                  (input buf_wth-doc.deliver
     3649                  ,output v-torgconf-ogr-name
     3650                  ) .
     3651               end.
     3652               find first buf_person no-lock
     3653               where buf_person.psn-code = buf_wth-doc.deliver
     3654               no-error.
     3655               if available buf_person
     3656               then do:
     3657                  v-torgconf-ogr-post = buf_person.position.
     3658               end.
     3659               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3660               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3661            end.
     3662      end.
     3663   end.
     3664   procedure torgconf-get-reason  :
     3665   define input parameter  p-doc-code       as character        no-undo.
     3666   define input parameter  p-reason-code    as integer          no-undo .
     3667   define input parameter  p-doc-type       as character        no-undo.
     3668       if p-reason-code > 0
     3669       then do:
     3670           define buffer buf_trn-reason for ub.trn-reason.
     3671           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     3672           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     3673       end.
     3674       else do:
     3675           if p-doc-type = 'при':U
     3676           then  do:
     3677               define variable v-attr-type     as character    no-undo.
     3678               define variable v-attr-value    as character    no-undo.
     3679               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     3680               assign v-torgconf-reason = v-attr-value .
     3681               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     3682               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     3683           end.
     3684       end.
     3685   end procedure.
