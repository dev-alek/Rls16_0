     4095   empty temp-table thbjattr_thbj-attr.
     4096   run adm/shattri.p (
     4097      input "get":U
     4098     ,input t-doc.obj-type
     4099     ,input t-doc.obj-code
     4100     ,input 'prt-firm':U
     4101     ,input  ""
     4102     ,output v-value-character
     4103     ,output v-value-date
     4104     ,output v-value-decimal
     4105     ,output v-value-integer
     4106     ,output v-value-logical
     4107     ,output par-type
     4108     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     4109     ) no-error .
     4110   for each thbjattr_thbj-attr :
     4111       if thbjattr_thbj-attr.prop-code = 'factur01' then v-print-doc =  string(thbjattr_thbj-attr.property-value-logical) .
     4112   end.
     4113   if v-print-doc <> 'yes'  then assign v-print-doc = "no"  .
     4114   run torgconf-get-form-header in this-procedure (
     4115         input Invers
     4116       , input t-doc.doc-code
     4117       , input ( v-print-doc = "yes" )
     4118       , input t-doc.doc-date
     4119       , input t-doc.fact-date
     4120       , input t-doc.doc-type
     4121       , input t-doc.status_
     4122       , input no
     4123       , input no
     4124   ).
     4125   assign
     4126       v-single-line = fill("-", 230)
     4127       UndLine = fill("_", 230)
     4128       LineCounter = 1
     4129   .
     4130   if v-torgconf-outnum = yes
     4131   then do:
     4132       assign
     4133           tdoc-code = "          "
     4134       .
     4135   end.
     4136   else do:
     4137       if invers
     4138       then do:
     4139           assign
     4140               tdoc-code = entry( 1, t-doc.doc-code, "-" )
     4141           no-error.
     4142           if tdoc-code = ""
     4143           then do:
     4144               assign
     4145                   tdoc-code = substr( t-doc.doc-code, 1, 2 )
     4146                               + string( month( t-doc.doc-date ), "99" )
     4147                               + string( day( t-doc.doc-date ), "99" )
     4148               .
     4149           end.
     4150           else
     4151               assign
     4152                   tdoc-code = string( month( t-doc.doc-date ), ">9" )
     4153                               + trim( string( day( t-doc.doc-date ), ">9" ) )
     4154                               + string( integer( tdoc-code ))
     4155               .
     4156       end.
     4157       else do:
     4158           assign
     4159               tdoc-code = t-doc.doc-code
     4160           .
     4161       end.
     4162   end.
     4163   if v-torgconf-outdate = yes
     4164   then do:
     4165       assign
     4166           v-doc-date-string = "          "
     4167       .
     4168   end.
     4169   else do:
     4170       assign
     4171           v-doc-date-string = ( if t-doc.status_ <> 'факт':U
     4172                               then string( t-doc.doc-date, "99/99/9999")
     4173                               else string( t-doc.fact-date, "99/99/9999") )
     4174       .
     4175   end.
     4176   find first OurObject no-lock
     4177        where OurObject.obj-type = t-doc.obj-type
     4178          and OurObject.obj-code = t-doc.obj-code
     4179   no-error.
     4180   CASE OurObject.obj-type :
     4181       when 'маг':U
     4182       then do:
     4183               find first shop no-lock
     4184                    where shop.obj-code = OurObject.obj-code
     4185               .
     4186               assign
     4187                   tdoc-prt = shop.doc-prt
     4188               .
     4189       end.
     4190       when 'скл':U
     4191       then do:
     4192               find first store no-lock
     4193                    where store.obj-code = OurObject.obj-code
     4194               .
     4195               assign
     4196                   tdoc-prt = store.doc-prt
     4197               .
     4198       end.
     4199   end case.
     4200   if Invers
