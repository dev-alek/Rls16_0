     3897             v-cntxp-out-line-discnt = bf-cntxp_shop.out-line-discnt
     3898             v-cntxp-in-ov           = bf-cntxp_shop.in-ov
     3899             v-cntxp-in-perm         = bf-cntxp_shop.in-perm
     3900             v-cntxp-no-eq           = bf-cntxp_shop.no-eq
