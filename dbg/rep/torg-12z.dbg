     5331                                                       else t-doc.tot-calc ) ), ">>>,>>>,>>>,>>>,>>9.99") )
     5332                               else "0.00" )
     5333                           + " (" + trim( ( if PrintRubl then "РУБ" else "баз.вал" ) ) + ")"
     5334                   ) format "X(160)"
     5335       .
     5336   end.
     5337   PUT STREAM Out-Stream
     5338       skip
     5339       space(30) string( "НДС: " + trim( string( (accum total VAT-gds), "->>>,>>>,>>>,>>>,>>9.99") ) +
     5340                                   " (" + trim( ( if PrintRubl then "РУБ" else "баз.вал" ) ) + ")" ) format "X(160)"
     5341   .
     5342   if (accum total SLT-gds) <> 0
     5343   then do:
     5344       PUT STREAM Out-Stream
     5345           SKIP
     5346           space(19) string( "налог с продаж: " + trim( string( (accum total SLT-gds), "->>>,>>>,>>>,>>>,>>9.99") ) +
     5347                                       " (" + trim( ( if PrintRubl then "РУБ" else "баз.вал" ) ) + ")" ) format "X(160)"
     5348       .
     5349   end.
     5350   define variable v-doc-places    as character    no-undo.
     5351   run gbl/trdcat-v.p (
     5352         input t-doc.doc-code
     5353       , input 'QntyPlace':U
     5354       , output v-doc-places
     5355       , output v-attr-type
     5356   ).
     5357   if v-doc-places = "":U
     5358   then do:
     5359       assign
     5360           v-doc-places = UndLine
     5361       .
     5362   end.
     5363   PUT STREAM Out-Stream
     5364       SKIP(2)
     5365       space(10) string( "Товарная накладная имеет приложение на " + UndLine ) format "X(125)" SKIP
     5366       space(10) string( "и содержит " + CAPS( txt-LC ) + " порядковый(ых) номер(ов) записей") format "X(180)" SKIP
     5367       UndLine format "X(29)" AT 151 SKIP
     5368       string( "Масса груза (нетто) " + UndLine ) format "X(85)" AT 60
     5369               string( "|" + UndLine ) format "X(30)" AT 150 "|" SKIP
     5370       space(10) string( "Всего мест " + v-doc-places ) format "X(45)"
     5371               string( "Масса груза (брутто) " + UndLine ) format "X(85)" AT 60
     5372               string( "|" + UndLine ) format "X(30)" AT 150 "|" SKIP(1)
     5373       string( "Приложение (паспорта, сертификаты, и т.д.) на " + string( UndLine, "X(42)" ) + " листах" ) format "X(95)" "|" AT 97
     5374           string( "По доверенности N " + string( UndLine, "X(39)" ) + " от " + UndLine ) format "X(100)" AT 99 SKIP
     5375       "Всего отпущено на сумму " format "X(95)" "|" AT 97 string( "выданной " + UndLine ) format "X(100)" AT 99 SKIP
     5376       space(2) CAPS(s1) format "X(93)" "|" AT 97 SKIP
     5377       string( "Отпуск разрешил " + UndLine ) format "X(95)" "|" AT 97 SKIP
     5378       "|" AT 97 string( "Груз принял " + UndLine ) format "X(100)" AT 99 SKIP
     5379       UndLine format "X(95)" "|" AT 97 string( "Груз получил грузополучатель " + UndLine ) format "X(100)" AT 99 SKIP
     5380       "М.П." AT 15  "|" AT 97 "М.П." AT 99 SKIP
     5381       .
     5382   output STREAM Out-Stream CLOSE.
     5383   if session :set-wait-state( "" ) then.
     5384   if g#quest-print = false
     5385   then do:
     5386     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     5387                                         7, (if 8 >= 8 then 2 else 0), 0, 0,
     5388                                         OUTPUT g#log ).
     5389   end.
     5390   else do:
     5391     os-command silent
     5392       value( "COPY /b " +
     5393         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     5394         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     5395         string( session:temp-directory) +  "$" + string( g#report-num )
     5396                 ) .
     5397     os-command silent
     5398       value( "COPY /b " +
     5399         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     5400         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     5401         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     5402                 ) .
     5403   end.
