      235   procedure partrqst :
      236     define input  parameter p-doc-code                   like ub.doc-line.doc-code  no-undo .
      237     define input  parameter p-obj-type                   like ub.doc-line.obj-type  no-undo .
      238     define input  parameter p-obj-code                   like ub.doc-line.obj-code  no-undo .
      239     define input  parameter p-artic                      like ub.doc-line.artic     no-undo .
      240     define input  parameter p-prod-type                  like ub.doc-line.prod-type no-undo .
      241     define input  parameter p-prod-code                  like ub.doc-line.prod-code no-undo .
      242     define output parameter p-total-parts-qnty           like ub.parts.qnty         no-undo .
      243     define output parameter p-total-parts-fact-qnty      like ub.parts.fact-qnty    no-undo .
      244     define output parameter p-total-parts-cli-qnty       like ub.parts.cli-qnty     no-undo .
      245     define output parameter p-total-parts-fact-cli-qnty  like ub.parts.cli-qnty     no-undo .
      246     define output parameter p-total-parts-price-cli      as decimal                 no-undo .
      247     define output parameter p-total-parts-price-base     as decimal                 no-undo .
      248     define output parameter p-total-parts-price-rubl     as decimal                 no-undo .
      249     define output parameter p-total-parts-transport-base as decimal                 no-undo .
      250     define output parameter p-total-parts-transport-rubl as decimal                 no-undo .
      251     define output parameter p-total-parts-other-base     as decimal                 no-undo .
      252     define output parameter p-total-parts-other-rubl     as decimal                 no-undo .
      253     define variable vss-description as character no-undo init "partrqst: Суммарная информация по всем зарезервированным партиям строки документа".
      254     do
      255     on error undo, return error return-value
      256     :
      257       assign
      258         p-total-parts-qnty           = 0
      259         p-total-parts-fact-qnty      = 0
      260         p-total-parts-cli-qnty       = 0
      261         p-total-parts-fact-cli-qnty  = 0
      262         p-total-parts-price-cli      = 0
      263         p-total-parts-price-base     = 0
      264         p-total-parts-price-rubl     = 0
      265         p-total-parts-transport-base = 0
      266         p-total-parts-transport-rubl = 0
      267         p-total-parts-other-base     = 0
      268         p-total-parts-other-rubl     = 0
      269       .
      270       define buffer buf_parts for ub.parts .
      271       for each buf_parts no-lock
      272         where buf_parts.out-code  = p-doc-code
      273           and buf_parts.obj-type  = p-obj-type
      274           and buf_parts.obj-code  = p-obj-code
      275           and buf_parts.artic     = p-artic
      276           and buf_parts.prod-type = p-prod-type
      277           and buf_parts.prod-code = p-prod-code
      278       on error undo, return error return-value
      279       :
      280         define variable v-parts-fact-multiplier as decimal   no-undo .
      281         assign
      282           v-parts-fact-multiplier = 1
      283         .
      284         if buf_parts.qnty <> 0 then do:
      285           assign
      286             v-parts-fact-multiplier = buf_parts.fact-qnty / buf_parts.qnty
      287           .
      288         end.
      289         assign
      290           p-total-parts-qnty            = p-total-parts-qnty       + buf_parts.qnty
      291           p-total-parts-fact-qnty       = p-total-parts-fact-qnty  + buf_parts.fact-qnty
      292           p-total-parts-cli-qnty        = p-total-parts-cli-qnty   + buf_parts.cli-qnty
      293           p-total-parts-fact-cli-qnty   = p-total-parts-fact-cli-qnty
      294                                         + buf_parts.cli-qnty * v-parts-fact-multiplier
      295           p-total-parts-price-cli       = p-total-parts-price-cli  + buf_parts.cli-qnty  * buf_parts.price-cli
      296           p-total-parts-price-base      = p-total-parts-price-base + buf_parts.fact-qnty * buf_parts.price-base
      297           p-total-parts-price-rubl      = p-total-parts-price-rubl + buf_parts.fact-qnty * buf_parts.price-rubl
      298           p-total-parts-transport-base  = p-total-parts-transport-base
      299                                         + buf_parts.fact-qnty
      300                                           * (if   buf_parts.transport-base <> ?
      301                                             then buf_parts.transport-base
      302                                             else 0
      303                                             )
      304           p-total-parts-transport-rubl  = p-total-parts-transport-rubl
      305                                         + buf_parts.fact-qnty
      306                                           * (if   buf_parts.transport-rubl <> ?
      307                                             then buf_parts.transport-rubl
      308                                             else 0
      309                                             )
      310           p-total-parts-other-base      = p-total-parts-other-base
      311                                         + buf_parts.fact-qnty
      312                                           * (if   buf_parts.other-base <> ?
      313                                             then buf_parts.other-base
      314                                             else 0
      315                                             )
      316           p-total-parts-other-rubl      = p-total-parts-other-rubl
      317                                         + buf_parts.fact-qnty
      318                                           * (if   buf_parts.other-rubl <> ?
      319                                             then buf_parts.other-rubl
      320                                             else 0
      321                                             )
      322         .
      323       end.
      324     end.
      325   end procedure.
