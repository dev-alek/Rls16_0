     1580   procedure torgconf-get-sup-param :
     1581   define input parameter p-obj-type           as character        no-undo.
     1582   define input parameter p-obj-code           as integer          no-undo.
     1583   define input parameter p-curr-code          as integer          no-undo.
     1584       define variable v-host-code    as integer      no-undo.
     1585       define variable v-par-type     as character    no-undo.
     1586   do
     1587   on error undo, return error
     1588   :
     1589       assign
     1590          v-torgconf-sup-host-code = v-host-code
     1591       .
     1592       if v-torgconf-sup-host-code = 0
     1593       then do:
     1594           assign
     1595               v-torgconf-sup-host-name           = "":U
     1596               v-torgconf-sup-host-addres         = "":U
     1597               v-torgconf-sup-host-post-addres    = "":U
     1598               v-torgconf-sup-host-phone          = "":U
     1599               v-torgconf-sup-host-inn            = "":U
     1600               v-torgconf-sup-host-kpp            = "":U
     1601               v-torgconf-sup-host-okpo           = "":U
     1602               v-torgconf-sup-host-egrip-date     = "":U
     1603               v-torgconf-sup-host-egrip-num      = "":U
     1604           .
     1605       end.
     1606       else do:
     1607           run fmtcli-get-client in this-procedure (
     1608                 input 'орг':U
     1609               , input v-torgconf-sup-host-code
     1610           ).
     1611           assign
     1612               v-torgconf-sup-host-name        = v-fmtcli-name
     1613               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     1614               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     1615               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     1616               v-torgconf-sup-host-phone       = v-fmtcli-phone
     1617               v-torgconf-sup-host-inn         = v-fmtcli-inn
     1618               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     1619               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     1620           .
     1621           run gbl/clntat-v.p (
     1622                 input 'орг':U
     1623               , input v-torgconf-sup-host-code
     1624               , input 'egrip-date':U
     1625               , output v-torgconf-sup-host-egrip-date
     1626               , output v-par-type
     1627           ).
     1628           run gbl/clntat-v.p (
     1629                 input 'орг':U
     1630               , input v-torgconf-sup-host-code
     1631               , input 'egrip-num':U
     1632               , output v-torgconf-sup-host-egrip-num
     1633               , output v-par-type
     1634           ).
     1635           run fmtcli-get-bank in this-procedure (
     1636                 input v-host-code
     1637               , input 'орг':U
     1638               , input v-torgconf-sup-host-code
     1639               , input p-curr-code
     1640           ).
     1641       end.
     1642       assign
     1643           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     1644           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     1645           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     1646           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     1647           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     1648           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     1649           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     1650           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     1651       .
     1652       assign
     1653           v-torgconf-sup-obj-type = p-obj-type
     1654           v-torgconf-sup-obj-code = p-obj-code
     1655       .
     1656       if trim(p-obj-type) <> ""
     1657       and p-obj-code <> 0
     1658       then do:
     1659       run fmtcli-get-client in this-procedure (
     1660             input p-obj-type
     1661           , input p-obj-code
     1662       ).
     1663       assign
     1664           v-torgconf-sup-obj-name        = v-fmtcli-name
     1665           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     1666           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     1667           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1668           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     1669           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     1670           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     1671       .
     1672      end.
     1673      end.
     1674   end procedure.
     1675   procedure torgconf-get-cli-param :
     1676   define input parameter p-host-obj-code      as integer          no-undo.
     1677   define input parameter p-obj-type           as character        no-undo.
     1678   define input parameter p-obj-code           as integer          no-undo.
     1679   define input parameter p-curr-code          as integer          no-undo.
     1680       define variable v-host-code    as integer      no-undo.
     1681   do
     1682   on error undo, return error
     1683   :
     1684       assign
     1685           v-torgconf-cli-type = p-obj-type
     1686           v-torgconf-cli-code = p-obj-code
     1687       .
     1688       run fmtcli-get-client in this-procedure (
     1689             input p-obj-type
     1690           , input p-obj-code
     1691       ).
     1692       assign
     1693           v-torgconf-cli-name         = trim( v-fmtcli-name          )
     1694           v-torgconf-cli-engl-name    = trim( v-fmtcli-engl-name          )
     1695           v-torgconf-cli-addres       = trim( v-fmtcli-full-addres   )
     1696           v-torgconf-cli-post-addres  = trim( v-fmtcli-post-addres   )
     1697           v-torgconf-cli-phone        = trim( v-fmtcli-phone         )
     1698           v-torgconf-cli-inn          = trim( v-fmtcli-inn           )
     1699           v-torgconf-cli-kpp          = trim( v-fmtcli-kpp           )
     1700           v-torgconf-cli-okpo         = trim( v-fmtcli-okpo          )
     1701       .
     1702      run fmtcli-get-bank in this-procedure (
     1703             input p-host-obj-code
     1704           , input p-obj-type
     1705           , input p-obj-code
     1706           , input p-curr-code
     1707       ).
     1708       assign
     1709           v-torgconf-cli-schet-exists = v-fmtcli-schet-exists
     1710           v-torgconf-cli-bank-exists  = v-fmtcli-bank-exists
     1711           v-torgconf-cli-bank-r-schet = v-fmtcli-bank-r-schet
     1712           v-torgconf-cli-bank-c-schet = v-fmtcli-bank-c-schet
     1713           v-torgconf-cli-bank-bik     = v-fmtcli-bank-bik
     1714           v-torgconf-cli-bank-name    = v-fmtcli-bank-name
     1715           v-torgconf-cli-bank-addres  = v-fmtcli-bank-addres
     1716           v-torgconf-cli-bank-city    = v-fmtcli-bank-city
     1717       .
     1718   end.
     1719   end procedure.
     1720   procedure torgconf-get-ship-param :
     1721   define input parameter p-host-obj-code      as integer          no-undo.
     1722   define input parameter p-obj-type           as character        no-undo.
     1723   define input parameter p-obj-code           as integer          no-undo.
     1724   define input parameter p-curr-code          as integer          no-undo.
     1725       define variable v-host-code    as integer      no-undo.
     1726   do
     1727   on error undo, return error
     1728   :
     1729       assign
     1730           v-torgconf-ship-type = p-obj-type
     1731           v-torgconf-ship-code = p-obj-code
     1732       .
     1733       if trim(p-obj-type) = ""
     1734       and p-obj-code = 0
     1735       then do:
     1736       assign
     1737           v-torgconf-ship-name         = "":U
     1738           v-torgconf-ship-addres       = "":U
     1739           v-torgconf-ship-post-addres  = "":U
     1740           v-torgconf-ship-phone        = "":U
     1741           v-torgconf-ship-inn          = "":U
     1742           v-torgconf-ship-kpp          = "":U
     1743           v-torgconf-ship-okpo         = "":U
     1744       .
     1745       end.
     1746       else do:
     1747       run fmtcli-get-client in this-procedure (
     1748             input p-obj-type
     1749           , input p-obj-code
     1750       ).
     1751       assign
     1752           v-torgconf-ship-name         = trim( v-fmtcli-name          )
     1753           v-torgconf-ship-engl-name    = trim( v-fmtcli-engl-name          )
     1754           v-torgconf-ship-addres       = trim( v-fmtcli-full-addres   )
     1755           v-torgconf-ship-post-addres  = trim( v-fmtcli-post-addres   )
     1756           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     1757           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     1758           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     1759           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     1760       .
     1761       end.
     1762           run fmtcli-get-bank in this-procedure (
     1763             input p-host-obj-code
     1764           , input p-obj-type
     1765           , input p-obj-code
     1766           , input p-curr-code
     1767       ).
     1768       assign
     1769           v-torgconf-ship-schet-exists = v-fmtcli-schet-exists
     1770           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
     1771           v-torgconf-ship-bank-r-schet = v-fmtcli-bank-r-schet
     1772           v-torgconf-ship-bank-c-schet = v-fmtcli-bank-c-schet
     1773           v-torgconf-ship-bank-bik     = v-fmtcli-bank-bik
     1774           v-torgconf-ship-bank-name    = v-fmtcli-bank-name
     1775           v-torgconf-ship-bank-addres  = v-fmtcli-bank-addres
     1776           v-torgconf-ship-bank-city    = v-fmtcli-bank-city
     1777       .
     1778   end.
     1779   end procedure.
     1780   procedure torgconf-get-holdfirm-code :
     1781   define input parameter p-obj-type   as character        no-undo.
     1782   define input parameter p-obj-code   as integer          no-undo.
     1783   define output parameter p-firm-code as integer          no-undo.
     1784       define variable v-firm-code-str     as character    no-undo.
     1785       define variable v-par-type          as character    no-undo.
     1786       define buffer buf_clients       for ub.clients.
     1787   do
     1788   for buf_clients
     1789   on error undo, return error
     1790   :
     1791       run gbl/clntat-v.p (
     1792             input p-obj-type
     1793           , input p-obj-code
     1794           , input 'holdfirm-code':U
     1795           , output v-firm-code-str
     1796           , output v-par-type
     1797       ).
     1798       assign
     1799           p-firm-code = integer( v-firm-code-str )
     1800       no-error.
     1801       if error-status :error
     1802       then do:
     1803           message
     1804               "Неверно задан код фирмы для печати накладных."
     1805           view-as alert-box warning.
     1806           assign
     1807               p-firm-code = 0
     1808           .
     1809       end.
     1810       else do:
     1811           find first buf_clients no-lock
     1812                where buf_clients.obj-type = 'орг':U
     1813                  and buf_clients.obj-code = p-firm-code
     1814           no-error.
     1815           if not available buf_clients
     1816           then do:
     1817               message
     1818                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     1819                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     1820               view-as alert-box warning.
     1821               assign
     1822                   p-firm-code = 0
     1823               .
     1824           end.
     1825       end.
     1826   end.
     1827   end procedure.
     1828   procedure torgconf-get-post-head:
     1829   define input  parameter p-obj-type             as character        no-undo.
     1830   define input  parameter p-obj-code             as integer          no-undo.
     1831   define output parameter p-torgconf-post-head   as character        no-undo.
     1832      define variable v-host-code         as integer      no-undo.
     1833      define buffer buf_sysconf     for ub.sysconf.
     1834        assign
     1835         p-torgconf-post-head  = ""
     1836        .
     1837   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1838   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1839     (input  p-obj-type
     1840     ,input  p-obj-code
     1841     ,output v-host-code
     1842     )  .
     1843      find first buf_sysconf no-lock
     1844      where buf_sysconf.host-code = v-host-code
     1845      no-error.
     1846      if available buf_sysconf
     1847      then do:
     1848         assign
     1849            p-torgconf-post-head = buf_sysconf.head-position
     1850         .
     1851      end.
     1852   end procedure.
     1853   procedure torgconf-get-storekeeper:
     1854   define input  parameter p-wrkr                   as integer          no-undo.
     1855   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     1856   define output parameter p-torgconf-post          as character        no-undo.
     1857      define buffer buf_sysconf     for ub.sysconf.
     1858      define buffer buf_person      for ub.person.
     1859      define buffer buf_shop        for ub.shop .
     1860      define buffer buf_store       for ub.store .
     1861      if v-torgconf-outC = "no_print"
     1862      then do:
     1863         assign p-torgconf-post = ""
     1864                p-torgconf-wrkr-name = ""
     1865                .
     1866      end.
     1867      if v-torgconf-outC = "clad_doc"
     1868      then do:
     1869         run rep/get-psn.p
     1870               (input  p-wrkr
     1871               ,output p-torgconf-wrkr-name
     1872               ) .
     1873         find first buf_person no-lock
     1874         where buf_person.psn-code = p-wrkr
     1875         no-error.
     1876         if available buf_person
     1877         then do:
     1878           p-torgconf-post = buf_person.position.
     1879         end.
     1880         if p-torgconf-post = "?":U then p-torgconf-post = "".
     1881         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1882      end.
     1883      if v-torgconf-outC = "clad_obj"
     1884      then do:
     1885         CASE v-torgconf-self-obj-type:
     1886         WHEN 'маг':U
     1887         THEN DO:
     1888            find first buf_shop no-lock
     1889            where buf_shop.obj-code = v-torgconf-self-obj-code
     1890            .
     1891            assign
     1892               p-torgconf-wrkr-name = buf_shop.store-man
     1893               p-torgconf-post = ""
     1894            .
     1895            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1896         END.
     1897         WHEN 'скл':U
     1898         THEN DO:
     1899            find first buf_store no-lock
     1900            where buf_store.obj-code = v-torgconf-self-obj-code
     1901            .
     1902            assign
     1903               p-torgconf-wrkr-name = buf_store.store-man
     1904               p-torgconf-post = ""
     1905            .
     1906            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1907         END.
     1908         OTHERWISE DO:
     1909            assign
     1910               p-torgconf-post = "":U
     1911               p-torgconf-wrkr-name = "":U
     1912            .
     1913         END.
     1914         END CASE.
     1915      end.
     1916    end procedure.
     1917   procedure torgconf-get-form-header :
     1918   define input parameter p-for-inverse    as logical          no-undo.
     1919   define input parameter p-doc-code       as character        no-undo.
     1920   define input parameter p-print-doc      as logical          no-undo.
     1921   define input parameter p-doc-date       as date             no-undo.
     1922   define input parameter p-fact-date      as date             no-undo.
     1923   define input parameter p-doc-type       as character        no-undo.
     1924   define input parameter p-status_        as character        no-undo.
     1925   define input parameter p-reverse        as logical          no-undo.
     1926   define input parameter p-sf-par         as logical          no-undo.
     1927       define variable v-attr-type         as character    no-undo.
     1928       define variable v-doc-code-standard as logical      no-undo.
     1929       define variable v-doc-date-standard as logical      no-undo.
     1930       define variable v-par-consignee-addres  as character    no-undo.
     1931       define variable v-host-code         as integer      no-undo.
     1932       define variable v-dcode-attr        as character    no-undo.
     1933       define variable v-ddate-attr        as character    no-undo.
     1934       define variable v-doc-date          as character    no-undo.
     1935       define variable v-doc-code          as character    no-undo.
     1936       define variable v-par-type          as character    no-undo.
     1937       define variable v-attr              as character    no-undo.
     1938       define buffer buf_firm          for ub.firm .
     1939       define buffer buf_clients       for ub.clients .
     1940       define buffer buf_sysconf       for ub.sysconf .
     1941       define buffer buf_shop          for ub.shop .
     1942       define buffer buf_store         for ub.store .
     1943       define buffer buf_person        for ub.person .
     1944       define buffer buf_trn-doc       for ub.trn-doc .
     1945       define buffer buf_wth-doc       for ub.wth-doc .
     1946       do
     1947   for buf_firm
     1948     , buf_clients
     1949     , buf_sysconf
     1950     , buf_shop
     1951     , buf_trn-doc
     1952     , buf_person
     1953     , buf_wth-doc
     1954   on error undo, return error
     1955   :
     1956       if p-doc-type = 'при':U
     1957       or p-doc-type = 'возврат':U
     1958       then do:
     1959           assign
     1960               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     1961                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     1962               v-torgconf-suppi            = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     1963                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     1964               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ),
     1965                                             v-torgconf-self-host-addres, ( if v-torgconf-self-host-phone = "":U then "":U else ", " ),v-torgconf-self-host-phone )
     1966               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-sup-host-name, ( if v-torgconf-sup-host-addres = "":U then "":U else ", " ),
     1967                                             v-torgconf-sup-host-addres, ( if v-torgconf-sup-host-phone = "":U then "":U else ", " ), v-torgconf-sup-host-phone  )
     1968               v-torgconf-supplier-okpo    = v-torgconf-cli-okpo
     1969               v-torgconf-saler-okpo       = v-torgconf-self-host-okpo
     1970               v-torgconf-consignee-okpo   = v-torgconf-sup-host-okpo
     1971               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-cli-code         )
     1972               v-torgconf-supplier-type    = v-torgconf-cli-type
     1973               v-torgconf-saler-code       = substitute( "&1", v-torgconf-self-host-code   )
     1974               v-torgconf-saler-type       = v-torgconf-self-host-type
     1975               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-sup-host-code   )
     1976               v-torgconf-consignee-type   = v-torgconf-sup-host-type
     1977               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-cli-name         )
     1978               v-torgconf-saler-name       = substitute( "&1", v-torgconf-self-host-name   )
     1979               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-sup-host-name   )
     1980               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-cli-addres       )
     1981               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-self-host-addres )
     1982               v-torgconf-consignee-addr   = substitute( "&1", v-torgconf-sup-host-addres )
     1983               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-cli-inn          )
     1984               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-cli-engl-name          )
     1985               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-self-host-inn    )
     1986               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-sup-host-inn    )
     1987               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-cli-kpp          )
     1988               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-self-host-kpp    )
     1989               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-sup-host-kpp    )
     1990           .
     1991           if v-torgconf-cli-schet-exists = yes
     1992           AND v-form-name                  = "torg12":U
     1993           then do:
     1994               assign
     1995                   v-torgconf-supplier = v-torgconf-supplier
     1996                       + substitute( ", р/с &1 к/с &2"
     1997                                   , v-torgconf-cli-bank-r-schet
     1998                                   , v-torgconf-cli-bank-c-schet
     1999                                   )
     2000                   v-torgconf-suppi = v-torgconf-supplier
     2001                       + substitute( ", р/с &1 к/с &2"
     2002                                   , v-torgconf-cli-bank-r-schet
     2003                                   , v-torgconf-cli-bank-c-schet
     2004                                   )
     2005               .
     2006               if v-torgconf-cli-bank-exists = yes
     2007               then do:
     2008                   assign
     2009                       v-torgconf-supplier = v-torgconf-supplier
     2010                           + substitute( " БИК &1 в &2 &3"
     2011                                       , v-torgconf-cli-bank-bik
     2012                                       , v-torgconf-cli-bank-name
     2013                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2014                                       )
     2015                      v-torgconf-suppi = v-torgconf-supplier
     2016                           + substitute( " БИК &1 в &2 &3"
     2017                                       , v-torgconf-cli-bank-bik
     2018                                       , v-torgconf-cli-bank-name
     2019                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2020                                       )
     2021                   .
     2022               end.
     2023           end.
     2024           if v-torgconf-self-schet-exists = yes
     2025           AND v-form-name                  = "torg12":U
     2026           then do:
     2027               assign
     2028                   v-torgconf-saler = v-torgconf-saler
     2029                       + substitute( ", р/с &1 к/с &2"
     2030                                   , v-torgconf-self-bank-r-schet
     2031                                   , v-torgconf-self-bank-c-schet
     2032                                   )
     2033               .
     2034               if v-torgconf-self-bank-exists = yes
     2035               then do:
     2036                   assign
     2037                       v-torgconf-saler = v-torgconf-saler
     2038                           + substitute( " БИК &1 в &2 &3"
     2039                                       , v-torgconf-self-bank-bik
     2040                                       , v-torgconf-self-bank-name
     2041                                       , v-torgconf-self-bank-addres
     2042                                       )
     2043                   .
     2044               end.
     2045           end.
     2046           if v-torgconf-sup-schet-exists = yes
     2047           AND v-form-name                  = "torg12":U
     2048           then do:
     2049               assign
     2050                   v-torgconf-consignee = v-torgconf-consignee
     2051                       + substitute( ", р/с &1 к/с &2"
     2052                                   , v-torgconf-sup-bank-r-schet
     2053                                   , v-torgconf-sup-bank-c-schet
     2054                                   )
     2055               .
