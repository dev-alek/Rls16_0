      357   procedure fmtcli-get-bank :
      358   define input parameter p-host-code      as integer          no-undo.
      359   define input parameter p-obj-type       as character        no-undo.
      360   define input parameter p-obj-code       as integer          no-undo.
      361   define input parameter p-curr-code      as integer          no-undo.
      362       define buffer buf_fin-schet     for ub.fin-schet.
      363       define buffer buf_fin-bank      for ub.fin-bank.
      364   do
      365   for buf_fin-schet
      366     , buf_fin-bank
      367   on error undo, return error
      368   :
      369       assign
      370           v-fmtcli-schet-exists       = no
      371           v-fmtcli-bank-exists        = no
      372           v-fmtcli-bank-r-schet       = "":U
      373           v-fmtcli-bank-c-schet       = "":U
      374           v-fmtcli-bank-bik           = "":U
      375           v-fmtcli-bank-name          = "":U
      376           v-fmtcli-bank-addres        = "":U
      377           v-fmtcli-bank-city          = "":U
      378       .
      379       search-for-schet:
      380       for each buf_fin-schet no-lock
      381          where buf_fin-schet.host-code = p-host-code
      382            and buf_fin-schet.cli-type  = p-obj-type
      383            and buf_fin-schet.cli-code  = p-obj-code
      384            and buf_fin-schet.curr-code = p-curr-code
      385       on error undo, return error
      386       :
      387           if buf_fin-schet.status_   = 'удал':U
      388           then do:
      389           end.
      390           else do:
      391               assign
      392                   v-fmtcli-schet-exists   = yes
      393                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      394                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      395               .
      396               find first buf_fin-bank no-lock
      397                    where buf_fin-bank.host-code = p-host-code
      398                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      399               no-error.
      400               if available buf_fin-bank
      401               then do:
      402                   assign
      403                       v-fmtcli-bank-exists      = yes
      404                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      405                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      406                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      407                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      408                   .
      409               end.
      410               else do:
      411                   assign
      412                       v-fmtcli-bank-exists    = no
      413                       v-fmtcli-bank-bik       = "":U
      414                       v-fmtcli-bank-name      = "":U
      415                       v-fmtcli-bank-addres    = "":U
      416                       v-fmtcli-bank-city      = "":U
      417                   .
      418               end.
      419               leave search-for-schet.
      420           end.
      421       end.
      422   end.
      423   end procedure.
      424   procedure fmtcli-get-client :
      425   define input parameter p-obj-type       as character    no-undo.
      426   define input parameter p-obj-code       as integer      no-undo.
      427       define variable v-temp-fmtcli-address      as character     no-undo.
      428       define variable v-num-country-city    as integer      no-undo.
      429       define buffer buf_clients   for ub.clients.
      430       define buffer buf_firm      for ub.firm.
      431       define buffer buf_store     for ub.store.
      432       define buffer buf_shop      for ub.shop.
      433       define buffer buf_person    for ub.person.
      434   do
      435   for buf_clients
      436     , buf_firm
      437     , buf_store
      438     , buf_shop
      439     , buf_person
      440   on error undo, return error
      441   :
      442       assign
      443           v-fmtcli-name           = "":U
      444           v-fmtcli-addres         = "":U
      445           v-fmtcli-post-addres    = "":U
      446           v-fmtcli-full-addres    = "":U
      447           v-fmtcli-phone          = "":U
      448           v-fmtcli-inn            = "":U
      449           v-fmtcli-kpp            = "":U
      450           v-fmtcli-okpo           = "":U
      451           v-fmtcli-city           = "":U
      452           v-fmtcli-index          = "":U
      453           v-fmtcli-country        = "":U
      454       .
      455       find first buf_clients no-lock
      456            where buf_clients.obj-type = p-obj-type
      457              and buf_clients.obj-code = p-obj-code
      458       .
      459       assign
      460           v-fmtcli-name = buf_clients.obj-name
      461       .
      462       case buf_clients.obj-type:
      463          when 'орг':U
      464          then do:
      465               find first buf_firm no-lock
      466                    where buf_firm.firm-code = buf_clients.obj-code
      467                    no-error
      468               .
      469               if available buf_firm
      470               then do:
      471                   assign
      472                       v-num-country-city = num-entries( buf_firm.city )
      473                       v-fmtcli-engl-name = buf_firm.engl-name
      474                   .
      475                   if v-num-country-city > 0
      476                   then do:
      477                       assign
      478                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
      479                       .
      480                   end.
      481                   if v-num-country-city > 1
      482                   then do:
      483                       assign
      484                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
      485                       .
      486                   end.
      487                   run fmtcli-concatenate-strings in this-procedure (
      488                         input v-fmtcli-full-addres
      489                       , input v-fmtcli-country
      490                       , input ", ":U
      491                       , input 50
      492                       , output v-fmtcli-full-addres
      493                   ).
      494                   run fmtcli-concatenate-strings in this-procedure (
      495                         input v-fmtcli-full-addres
      496                       , input v-fmtcli-city
      497                       , input ", ":U
      498                       , input 50
      499                       , output v-fmtcli-full-addres
      500                   ).
      501                   run fmtcli-concatenate-strings in this-procedure (
      502                         input v-fmtcli-full-addres
      503                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
      504                       , input ", ":U
      505                       , input 50
      506                       , output v-fmtcli-full-addres
      507                   ).
      508                   run fmtcli-concatenate-strings in this-procedure (
      509                         input v-fmtcli-post-addres
      510                       , input v-fmtcli-country
      511                       , input ", ":U
      512                       , input 50
      513                       , output v-fmtcli-post-addres
      514                   ).
      515                   run fmtcli-concatenate-strings in this-procedure (
      516                         input v-fmtcli-post-addres
      517                       , input v-fmtcli-city
      518                       , input ", ":U
      519                       , input 50
      520                       , output v-fmtcli-post-addres
      521                   ).
      522                   run fmtcli-concatenate-strings in this-procedure (
      523                         input v-fmtcli-post-addres
      524                       , input string( buf_firm.ind )
      525                       , input ", ":U
      526                       , input 50
      527                       , output v-fmtcli-post-addres
      528                   ).
      529                   run fmtcli-concatenate-strings in this-procedure (
      530                         input substring( buf_firm.addres1, 1, 50 )
      531                       , input buf_firm.addres2
      532                       , input " ":U
      533                       , input 50
      534                       , output v-temp-fmtcli-address
      535                   ).
      536                   run fmtcli-concatenate-strings in this-procedure (
      537                         input v-temp-fmtcli-address
      538                       , input substring( buf_firm.addres1, 51, 50 )
      539                       , input " ":U
      540                       , input 50
      541                       , output v-temp-fmtcli-address
      542                   ).
      543                   run fmtcli-concatenate-strings in this-procedure (
      544                         input v-temp-fmtcli-address
      545                       , input substring( buf_firm.addres1, 101, 50 )
      546                       , input " ":U
      547                       , input 50
      548                       , output v-temp-fmtcli-address
      549                   ).
      550                   assign
      551                       v-fmtcli-addres = v-temp-fmtcli-address
      552                   .
      553                   if buf_firm.addres1 <> ?
      554                   then do:
      555                       run fmtcli-concatenate-strings in this-procedure (
      556                             input v-fmtcli-full-addres
      557                           , input v-fmtcli-addres
      558                           , input ", ":U
      559                           , input 0
      560                           , output v-fmtcli-full-addres
      561                       ).
      562                   end.
      563                   run fmtcli-concatenate-strings in this-procedure (
      564                         input substring( buf_firm.post-addr1, 1, 50 )
      565                       , input buf_firm.post-addr2
      566                       , input " ":U
      567                       , input 50
      568                       , output v-fmtcli-post-addres
      569                   ).
      570                   run fmtcli-concatenate-strings in this-procedure (
      571                         input v-fmtcli-post-addres
      572                       , input substring( buf_firm.post-addr1, 51, 50 )
      573                       , input " ":U
      574                       , input 50
      575                       , output v-fmtcli-post-addres
      576                   ).
      577                   run fmtcli-concatenate-strings in this-procedure (
      578                         input v-fmtcli-post-addres
      579                       , input substring( buf_firm.post-addr1, 101, 50 )
      580                       , input " ":U
      581                       , input 50
      582                       , output v-fmtcli-post-addres
      583                   ).
      584                   assign
      585                       v-fmtcli-phone         = buf_firm.phone
      586                       v-fmtcli-inn           = buf_firm.inn
      587                       v-fmtcli-kpp           = buf_firm.kpp
      588                       v-fmtcli-okpo          = buf_firm.okpo
      589                       v-fmtcli-index         = string( buf_firm.ind )
      590                   .
      591               end.
      592          end.
      593          when 'маг':U
      594          then do:
      595               find first buf_shop no-lock
      596                    where buf_shop.obj-code = buf_clients.obj-code
      597               .
      598               if available buf_shop
      599               then do:
      600                   run fmtcli-concatenate-strings in this-procedure (
      601                         input buf_shop.addres1
      602                       , input buf_shop.addres2
      603                       , input " ":U
      604                       , input 50
      605                       , output v-fmtcli-addres
      606                   ).
      607                   assign
      608                       v-fmtcli-full-addres = v-fmtcli-addres
      609                       v-fmtcli-post-addres = v-fmtcli-addres
      610                       v-fmtcli-phone       = buf_shop.phone
      611                       v-fmtcli-inn         = "":U
      612                       v-fmtcli-kpp         = "":U
      613                       v-fmtcli-okpo        = "":U
      614                       v-fmtcli-city        = "":U
      615                       v-fmtcli-index       = "":U
      616                   .
      617               end.
      618          end.
      619          when 'скл':U
      620          then do:
      621               find first buf_store no-lock
      622                    where buf_store.obj-code = buf_clients.obj-code
      623               .
      624               if available buf_store
      625               then do:
      626                   run fmtcli-concatenate-strings in this-procedure (
      627                         input buf_store.addres1
      628                       , input buf_store.addres2
      629                       , input " ":U
      630                       , input 50
      631                       , output v-fmtcli-addres
      632                   ).
      633                   assign
      634                       v-fmtcli-full-addres = v-fmtcli-addres
      635                       v-fmtcli-phone       = buf_store.phone
      636                       v-fmtcli-inn         = "":U
      637                       v-fmtcli-kpp         = "":U
      638                       v-fmtcli-okpo        = "":U
      639                       v-fmtcli-city        = "":U
      640                       v-fmtcli-index       = "":U
      641                   .
      642               end.
      643          end.
      644          when 'чел':U
      645          then do:
      646               find first buf_person no-lock
      647                    where buf_person.psn-code = buf_clients.obj-code
      648               .
      649               if available buf_person
      650               then do:
      651                   run fmtcli-concatenate-strings in this-procedure (
      652                         input ( if buf_person.ind = 0 or buf_person.ind = ?
      653                                 then "":U
      654                                 else string( buf_person.ind, "999999")
      655                                 )
      656                       , input buf_person.city
      657                       , input ", ":U
      658                       , input 0
      659                       , output v-fmtcli-full-addres
      660                   ).
      661                   assign
      662                       v-fmtcli-addres = buf_person.address
      663                   .
      664                   run fmtcli-concatenate-strings in this-procedure (
      665                         input v-fmtcli-full-addres
      666                       , input v-fmtcli-addres
      667                       , input ", ":U
      668                       , input 0
      669                       , output v-fmtcli-full-addres
      670                   ).
      671                   assign
      672                       v-fmtcli-phone     = buf_person.phone1
      673                       v-fmtcli-inn       = buf_person.inn
      674                       v-fmtcli-kpp       = buf_person.kpp
      675                       v-fmtcli-okpo      = buf_person.okpo
      676                       v-fmtcli-city      = buf_person.city
      677                       v-fmtcli-index     = string( buf_person.ind )
      678                   .
      679               end.
      680          end.
      681       end case.
      682   end.
      683   end procedure.
      684   procedure fmtcli-concatenate-strings :
      685   define input parameter p-string-1       as character        no-undo.
      686   define input parameter p-string-2       as character        no-undo.
      687   define input parameter p-delimiter      as character        no-undo.
      688   define input parameter p-length         as integer          no-undo.
      689   define output parameter p-out-string    as character        no-undo.
      690   do
      691   on error undo, return error
      692   :
      693       assign
      694           p-out-string = ( if p-string-1 = ?
      695                            then "":U
      696                            else trim( p-string-1 ) )
      697       .
      698       assign
      699           p-out-string = p-out-string
      700                        + ( if p-out-string = "":U
      701                            or length( p-out-string ) = p-length
      702                            or p-string-2 = ?
      703                            or trim( p-string-2 ) = "":U
      704                            then "":U
      705                            else p-delimiter )
      706                        + ( if p-string-2 = ?
      707                            or trim( p-string-2 ) = "":U
      708                            then "":U
      709                            else trim( p-string-2 ) )
      710       .
      711   end.
      712   end procedure.
