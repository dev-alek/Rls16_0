      922   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      923   define new global shared variable g#trdcalib as handle no-undo.
      924   procedure wthcattr-sprcli :
      925   define input parameter parparentproc  as widget-handle no-undo.
      926   define input parameter p-mode  as character no-undo.
      927   define input-output parameter p-value as character no-undo .
      928   define output parameter p-setted as logical no-undo .
      929     DEFINE VARIABLE v-value as character no-undo .
      930     define variable v-cli-type as character no-undo .
      931     define variable v-cli-code as integer no-undo .
      932     define buffer buf_clients   for ub.clients.
      933     define variable v_rid as character no-undo.
      934     define variable ref-rec as recid no-undo .
      935     do
      936     on error undo, return error
      937     :
      938         v-value = p-value.
      939      if p-value <> '':U then do:
      940       assign
      941       v-cli-type = substring(p-value, 1, 3)
      942       v-cli-code = integer(substring(p-value, 4))
      943       no-error.
      944       if error-status:error then do:
      945         assign
      946         v-cli-type = '':U
      947         v-cli-code = 0
      948         .
      949       end.
      950      end.
      951      FIND FIRST buf_clients NO-LOCK WHERE
      952               buf_clients.obj-type = v-cli-type AND
      953               buf_clients.obj-code = v-cli-code  NO-ERROR.
      954      IF available(buf_clients) then do:
      955       run ref/cli-all.w (
      956                   input parparentproc
      957                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
      958                  ,input v-cli-type
      959                  ,input 'все':U
      960                  ,input 'все':U
      961                  ,input RECID( buf_clients )
      962                  ,input ",,,,,,NO"
      963                  ,input ?
      964                  ,OUTPUT v_rid ).
      965     END.
      966     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
      967       run ref/cli-all.w (
      968                    input parparentproc
      969                   ,INPUT "b-sel":U
      970                  ,input  v-cli-type
      971                  ,input 'все':U
      972                  ,input 'текущие':U
      973                  ,input ?
      974                  ,input ",,,,,,NO"
      975                  ,input ?
      976                  ,OUTPUT v_rid ).
      977     END.
      978     else do:
      979       message
      980       if p-value = "":U then 'Атрибут не задан!'
      981       else substitute('Не найден клиент &1',p-value)
      982       view-as alert-box warning.
      983     end.
      984     IF v_rid <> ? AND v_rid <> "":U THEN DO:
      985       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
      986       IF ERROR-STATUS:ERROR THEN DO:
      987           RETURN NO-APPLY.
      988       END.
      989       FIND FIRST buf_clients NO-LOCK WHERE
      990                  RECID( buf_clients ) = ref-rec NO-ERROR.
      991       IF AVAIL buf_clients THEN DO:
      992         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
      993       end.
      994     end.
      995     if v-value <> p-value then do:
      996       p-value = v-value.
      997       p-setted = yes.
      998     end.
      999     end.
     1000   end procedure.
     1001     define new global shared variable g#wthcalib as handle no-undo.
     1002   procedure torgconf-read :
     1003   do
     1004   on error undo, return error
     1005   :
     1006       define input parameter p-form-name  as character    no-undo.
     1007       define input parameter p-host-code  as integer      no-undo.
     1008       define input parameter p-obj-type   as character    no-undo.
     1009       define input parameter p-obj-code   as integer      no-undo.
     1010       define variable v-outdate   as character     no-undo.
     1011       define variable v-outares   as character     no-undo.
     1012       define variable v-outsend   as character     no-undo.
     1013       define variable v-outasend  as character     no-undo.
     1014       define variable v-outprops  as character     no-undo.
     1015       define variable v-outnum    as character     no-undo.
     1016       define variable v-outprim   as character     no-undo.
     1017       define variable v-outdisc   as character     no-undo.
     1018       define variable v-outsubs   as character     no-undo.
     1019       define variable v-outrecv   as character     no-undo.
     1020       define variable v-outegrp   as character     no-undo.
     1021       define variable v-outt12    as character     no-undo.
     1022       define variable v-outappr   as character     no-undo.
     1023       define variable v-outrubl   as character     no-undo.
     1024       define variable v-outhold   as character     no-undo.
     1025       define variable v-outobj    as character     no-undo.
     1026       define variable v-outexlst  as character     no-undo.
     1027       define variable v-outprncd  as character     no-undo.
     1028       define variable v-par-type  as character     no-undo.
     1029       define variable v-outogr    as character     no-undo.
     1030       define variable v-outR      as character     no-undo.
     1031       define variable v-outB      as character     no-undo.
     1032       define variable v-outC      as character     no-undo.
     1033       assign
     1034           v-torgconf-outdate  = no
     1035           v-torgconf-outnum   = no
     1036           v-torgconf-outprim  = no
     1037           v-torgconf-outdisc  = no
     1038           v-torgconf-outsubs  = no
     1039           v-torgconf-outrecv  = no
     1040           v-torgconf-outegrp  = no
     1041           v-torgconf-outt12   = no
     1042           v-torgconf-outappr  = no
     1043           v-torgconf-outrubl  = no
     1044           v-torgconf-outhold  = no
     1045           v-torgconf-outobj   = no
     1046           v-torgconf-outexlst = no
     1047           v-torgconf-outexpas = "":U
     1048           v-torgconf-outprncd = yes
     1049           v-torgconf-outares  = no
     1050           v-torgconf-outsend  = no
     1051           v-torgconf-outasend  = no
     1052           v-torgconf-outprops  = no
     1053           v-form-name          = p-form-name
     1054       .
     1055   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1056   empty temp-table thbjattr_thbj-attr.
     1057   run adm/shattri.p (
     1058      input "get":U
     1059     ,input ''
     1060     ,input 0
     1061     ,input 'prt-glob':U
     1062     ,input  ""
     1063     ,output v-value-character
     1064     ,output v-value-date
     1065     ,output v-value-decimal
     1066     ,output v-value-integer
     1067     ,output v-value-logical
     1068     ,output par-type
     1069     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1070     ) no-error .
     1071   for each thbjattr_thbj-attr :
     1072       if thbjattr_thbj-attr.prop-code = 'outprncd':U then v-outprncd =  string(thbjattr_thbj-attr.property-value-logical) .
     1073       if thbjattr_thbj-attr.prop-code = 'outrecv':U  then v-outrecv  =  thbjattr_thbj-attr.property-value-character .
     1074       if thbjattr_thbj-attr.prop-code = 'outprops':U then v-outprops =  thbjattr_thbj-attr.property-value-character .
     1075   end.
     1076   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1077   empty temp-table thbjattr_thbj-attr.
     1078   run adm/shattri.p (
     1079      input "get":U
     1080     ,input p-obj-type
     1081     ,input p-obj-code
     1082     ,input 'prt-obj':U
     1083     ,input  ""
     1084     ,output v-value-character
     1085     ,output v-value-date
     1086     ,output v-value-decimal
     1087     ,output v-value-integer
     1088     ,output v-value-logical
     1089     ,output par-type
     1090     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1091     ) no-error .
     1092   for each thbjattr_thbj-attr :
     1093       if thbjattr_thbj-attr.prop-code = 'outdate':U  then v-outdate  =  thbjattr_thbj-attr.property-value-character .
     1094       if thbjattr_thbj-attr.prop-code = 'outares':U  then v-outares  =  thbjattr_thbj-attr.property-value-character .
     1095       if thbjattr_thbj-attr.prop-code = 'outnum':U   then v-outnum   =  thbjattr_thbj-attr.property-value-character .
     1096       if thbjattr_thbj-attr.prop-code = 'outprim':U  then v-outprim  =  thbjattr_thbj-attr.property-value-character .
     1097       if thbjattr_thbj-attr.prop-code = 'outdisc':U  then v-outdisc  =  thbjattr_thbj-attr.property-value-character .
     1098       if thbjattr_thbj-attr.prop-code = 'outsubs':U  then v-outsubs  =  thbjattr_thbj-attr.property-value-character .
     1099       if thbjattr_thbj-attr.prop-code = 'outegrp':U  then v-outegrp  =  thbjattr_thbj-attr.property-value-character .
     1100       if thbjattr_thbj-attr.prop-code = 'outt12':U   then v-outt12   =  thbjattr_thbj-attr.property-value-character .
     1101       if thbjattr_thbj-attr.prop-code = 'outappr':U  then v-outappr  =  thbjattr_thbj-attr.property-value-character .
     1102       if thbjattr_thbj-attr.prop-code = 'outrubl':U  then v-outrubl  =  thbjattr_thbj-attr.property-value-character .
     1103       if thbjattr_thbj-attr.prop-code = 'outhold':U  then v-outhold  =  thbjattr_thbj-attr.property-value-character .
     1104       if thbjattr_thbj-attr.prop-code = 'outobj':U   then v-outobj   =  thbjattr_thbj-attr.property-value-character .
     1105       if thbjattr_thbj-attr.prop-code = 'outsend':U  then v-outsend  =  thbjattr_thbj-attr.property-value-character .
     1106       if thbjattr_thbj-attr.prop-code = 'outasend':U then v-outasend =  thbjattr_thbj-attr.property-value-character .
     1107       if thbjattr_thbj-attr.prop-code = 'outogr':U   then v-torgconf-outogr   =  thbjattr_thbj-attr.property-value-character .
     1108       if thbjattr_thbj-attr.prop-code = 'outR':U     then v-torgconf-outR     =  thbjattr_thbj-attr.property-value-character .
     1109       if thbjattr_thbj-attr.prop-code = 'outB':U     then v-torgconf-outB     =  thbjattr_thbj-attr.property-value-character .
     1110       if thbjattr_thbj-attr.prop-code = 'outssdoc':U then v-torgconf-outssdoc =  thbjattr_thbj-attr.property-value-character .
     1111       if thbjattr_thbj-attr.prop-code = 'outC':U     then v-torgconf-outC     =  thbjattr_thbj-attr.property-value-character .
     1112   end.
     1113       run gbl/conf-rd.p ("outexpas", "":U, "":U, 0, "":U, "":U, "":U, no, output v-torgconf-outexpas, output v-par-type) no-error.
     1114       if error-status :error
     1115       then do:
     1116           assign
     1117               v-torgconf-outexpas = "":U
     1118           .
     1119       end.
     1120       assign
     1121           v-torgconf-outprncd = ( v-outprncd = "yes":U )
     1122       .
     1123       if p-form-name <> ""
     1124       and p-form-name <> ?
     1125       then do:
     1126           run gbl/conf-rd.p ("outexlst" , p-host-code, p-obj-type, p-obj-code, "", "", "", no, output v-outexlst , output v-par-type) no-error.
     1127           if error-status :error
     1128           then do:
     1129               assign
     1130                   v-outexlst           = ""
     1131               .
     1132           end.
     1133           if lookup( p-form-name, v-outdate ) <> 0
     1134           then do:
     1135               assign
     1136                   v-torgconf-outdate  = yes
     1137               .
     1138           end.
     1139           if lookup( p-form-name, v-outares ) <> 0
     1140           then do:
     1141               assign
     1142                   v-torgconf-outares  = yes
     1143               .
     1144           end.
     1145           if lookup( p-form-name, v-outnum  ) <> 0
     1146           then do:
     1147               assign
     1148                   v-torgconf-outnum   = yes
     1149               .
     1150           end.
     1151           if lookup( p-form-name, v-outprim ) <> 0
     1152           then do:
     1153               assign
     1154                   v-torgconf-outprim  = yes
     1155               .
     1156           end.
     1157           if lookup( p-form-name, v-outdisc ) <> 0
     1158           then do:
     1159               assign
     1160                   v-torgconf-outdisc  = yes
     1161               .
     1162           end.
     1163           if lookup( p-form-name, v-outsubs ) <> 0
     1164           then do:
     1165               assign
     1166                   v-torgconf-outsubs  = yes
     1167               .
     1168           end.
     1169           if lookup( p-form-name, v-outrecv ) <> 0
     1170           then do:
     1171               assign
     1172                   v-torgconf-outrecv  = yes
     1173               .
     1174           end.
     1175           if lookup( p-form-name, v-outegrp ) <> 0
     1176           then do:
     1177               assign
     1178                   v-torgconf-outegrp  = yes
     1179               .
     1180           end.
     1181           if lookup( p-form-name, v-outt12  ) <> 0
     1182           then do:
     1183               assign
     1184                   v-torgconf-outt12   = yes
     1185               .
     1186           end.
     1187           if lookup( p-form-name, v-outappr  ) <> 0
     1188           then do:
     1189               assign
     1190                   v-torgconf-outappr   = yes
     1191               .
     1192           end.
     1193           if lookup( p-form-name, v-outrubl  ) <> 0
     1194           then do:
     1195               assign
     1196                   v-torgconf-outrubl   = yes
     1197               .
     1198           end.
     1199           if lookup( p-form-name, v-outhold  ) <> 0
     1200           then do:
     1201               assign
     1202                   v-torgconf-outhold   = yes
     1203               .
     1204           end.
     1205           if lookup( p-form-name, v-outobj   ) <> 0
     1206           then do:
     1207               assign
     1208                   v-torgconf-outobj    = yes
     1209               .
     1210           end.
     1211           if lookup( p-form-name, v-outsend   ) <> 0
     1212           then do:
     1213               assign
     1214                   v-torgconf-outsend    = yes
     1215               .
     1216           end.
     1217           if lookup( p-form-name, v-outasend   ) <> 0
     1218           then do:
     1219               assign
     1220                   v-torgconf-outasend    = yes
     1221               .
     1222           end.
     1223           if lookup( p-form-name, v-outprops   ) <> 0
     1224           then do:
     1225               assign
     1226                   v-torgconf-outprops    = yes
     1227               .
     1228           end.
     1229           if lookup( p-form-name, v-outexlst ) <> 0
     1230           then do:
     1231               assign
     1232                   v-torgconf-outexlst  = yes
     1233               .
     1234           end.
     1235        assign
     1236         v-name = p-form-name.
     1237   end.
     1238   end.
     1239   end procedure.
     1240   procedure torgconf-get-self-param :
     1241   define input parameter p-obj-type           as character        no-undo.
     1242   define input parameter p-obj-code           as integer          no-undo.
     1243   define input parameter p-curr-code          as integer          no-undo.
     1244       define variable v-host-code    as integer      no-undo.
     1245       define variable v-par-type     as character    no-undo.
     1246   do
     1247   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1))
     1248   :
     1249   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1250   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1251     (input  p-obj-type
     1252     ,input  p-obj-code
     1253     ,output v-host-code
     1254     )  .
     1255       if v-torgconf-outhold = yes
     1256       then do:
     1257           run torgconf-get-holdfirm-code in this-procedure (
     1258                 input p-obj-type
     1259               , input p-obj-code
     1260               , output v-torgconf-self-host-code
     1261           ).
     1262           if v-torgconf-self-host-code = 0
     1263           then do:
     1264               return error.
     1265           end.
     1266       end.
     1267       else do:
     1268           assign
     1269               v-torgconf-self-host-code = v-host-code
     1270           .
     1271       end.
     1272       if v-torgconf-self-host-code = 0
     1273       then do:
     1274           assign
     1275               v-torgconf-self-host-name           = "":U
     1276               v-torgconf-self-host-addres         = "":U
     1277               v-torgconf-self-host-post-addres    = "":U
