     4061   run torgconf-get-self-param in this-procedure (
     4062         input t-doc.obj-type
     4063       , input t-doc.obj-code
     4064       , input v-curr-code
     4065   ) no-error.
     4066   if error-status :error
     4067   then do:
     4068       message
     4069       vss-workfile vss-revision vss-description
     4070       skip "Ошибка чтения параметров объекта документа."
     4071       skip return-value
