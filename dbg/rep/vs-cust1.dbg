     1226     define variable v-window-width         as decimal   no-undo .
     1227     define variable v-window-virtual-width as decimal   no-undo .
     1228     define variable v-change-sign          as integer   no-undo .
     1229     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1230     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1231     if p-change-value > 0
     1232     then do:
     1233       if frame v-cust :width + p-change-value >
     1234           session :width-chars
     1235       then do:
     1236         assign
     1237           p-change-value = session :width-chars - frame v-cust :width
     1238         .
     1239         if p-change-value <= 0
     1240         then do:
     1241           run diasize_position-resize-button in this-procedure .
     1242           return .
     1243         end.
     1244       end.
     1245     end.
     1246     if p-change-value < 0
     1247     then do:
     1248       if frame v-cust :width + p-change-value < v-diasize-orig-frame-width
     1249       then do:
     1250         assign
     1251           p-change-value = v-diasize-orig-frame-width
     1252                          - frame v-cust :width
     1253         .
     1254         if p-change-value >= 0
     1255         then do:
     1256           run diasize_position-resize-button in this-procedure .
     1257           return .
     1258         end.
     1259       end.
     1260     end.
     1261     if p-change-value >= 0
     1262     then do:
     1263       assign
     1264         v-change-sign = 1
     1265       .
     1266     end.
     1267     else do:
     1268       assign
     1269         v-change-sign = -1
     1270       .
     1271     end.
     1272     assign
     1273       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1274     .
     1275     if p-change-value = 0
     1276     then do:
     1277       run diasize_position-resize-button in this-procedure .
     1278       return .
     1279     end.
