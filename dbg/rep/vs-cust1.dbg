     1582             ,input  v-diasize-proc-name
     1583             ,input  'width':u
     1584             ,input  string(frame v-cust :width - v-diasize-orig-frame-width)
     1585             ) .
     1586         end.
     1587       end.
     1588     end.
     1589     assign
     1590       v-diasize-change-size = false
     1591     .
     1592   end procedure.
     1593   procedure diasize_set-width :
     1594     define input  parameter p-new-width  as decimal   no-undo .
     1595     define input  parameter p-move-resize as logical   no-undo .
     1596     do
     1597     on error undo, return error return-value
     1598     :
     1599       run diasize_change-width in this-procedure
     1600         (input  (p-new-width - frame v-cust :width)
     1601         ,input  p-move-resize
     1602         ) .
     1603     end.
     1604   end procedure.
     1605   procedure diasize_position-resize-button :
     1606     do with frame v-cust
     1607     :
     1608       hide v-diasize-resize-button .
     1609       assign
     1610         v-diasize-resize-button :row = frame v-cust :height - v-diasize-resize-button :height
     1611                     - 1
     1612                     - (frame v-cust :border-bottom-pixels / session :pixels-per-row)
     1613         v-diasize-resize-button :col = frame v-cust :width - v-diasize-resize-button :width
     1614                     - 1
     1615                     - (frame v-cust :border-right-pixels / session :pixels-per-column)
     1616       .
     1617       view v-diasize-resize-button .
     1618     end.
     1619   end procedure.
     1620   on alt-right anywhere
     1621   do:
     1622     run diasize_change-width in this-procedure
     1623       (input 1
     1624       ,input true
     1625       ) .
     1626     return no-apply .
     1627   end.
     1628   on alt-left anywhere
     1629   do:
     1630     run diasize_change-width in this-procedure
     1631       (input -1
     1632       ,input true
     1633       ) .
     1634     return no-apply .
     1635   end.
     1636   on alt-down anywhere
     1637   do:
     1638     run diasize_change-height in this-procedure
     1639       (input 1
     1640       ,input true
     1641       ) .
     1642     return no-apply .
     1643   end.
     1644   on alt-up anywhere
     1645   do:
     1646     run diasize_change-height in this-procedure
     1647       (input -1
     1648       ,input true
     1649       ) .
     1650     return no-apply .
     1651   end.
     1652   on alt-enter of frame v-cust
     1653   do:
     1654     run diasize_maximize in this-procedure
     1655       (input  ?
     1656       ).
     1657     return no-apply .
     1658   end.
     1659   procedure diasize_end-move :
     1660     do
     1661     on error undo, return error return-value
     1662     :
     1663       define variable v-row-delta as decimal   no-undo .
     1664       define variable v-col-delta as decimal   no-undo .
     1665       define variable v-new-row as decimal   no-undo .
     1666       define variable v-new-col as decimal   no-undo .
     1667       assign
     1668         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1669         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1670       .
     1671       assign
     1672         v-row-delta = v-new-row - frame v-cust :height
     1673         v-col-delta = v-new-col - frame v-cust :width
     1674       .
     1675       run diasize_change-height in this-procedure
     1676         (input v-row-delta
     1677         ,input true
     1678         ) .
     1679       run diasize_change-width in this-procedure
     1680         (input v-col-delta
     1681         ,input true
     1682         ) .
     1683     end.
     1684   end procedure.
     1685   procedure diasize_maximize :
     1686     define input  parameter p-action as logical   no-undo .
     1687     do
     1688     on error undo, return error return-value
     1689     :
     1690       if p-action = ?
     1691       then do:
     1692         if v-diasize-need-maximize = true
     1693         then do:
     1694           assign
     1695             p-action = true
     1696           .
     1697         end.
     1698         else do:
     1699           assign
     1700             p-action = false
     1701           .
     1702         end.
     1703       end.
     1704       if p-action = true
     1705       then do:
     1706         run diasize_change-height in this-procedure
     1707           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1708               - frame v-cust :height-chars
     1709           ,input true
     1710           ) .
     1711         run diasize_change-width in this-procedure
     1712           (input session :width-chars
     1713               - frame v-cust :width-chars
     1714           ,input true
     1715           ) .
     1716         assign
     1717           v-diasize-need-maximize = false
     1718         .
     1719       end.
     1720       else do:
     1721         run diasize_change-width in this-procedure
     1722           (input v-diasize-orig-frame-width
     1723               - frame v-cust :width-chars
     1724           ,input true
     1725           ) .
     1726         run diasize_change-height in this-procedure
     1727           (input v-diasize-orig-frame-height
     1728               - frame v-cust :height-chars
     1729           ,input true
     1730           ) .
     1731         assign
     1732           v-diasize-need-maximize = true
     1733         .
     1734       end.
     1735     end.
     1736   end procedure.
     1737   procedure diasize_restore-orig-size :
     1738     do
     1739     on error undo, return error return-value
     1740     :
     1741       assign
     1742         v-diasize-current-frame-width  = frame v-cust :width
     1743         v-diasize-current-frame-height = frame v-cust :height
     1744       .
     1745       run diasize_set-height in this-procedure
     1746         (input  v-diasize-orig-frame-height
     1747         ,input  true
     1748         ) .
     1749       run diasize_set-width in this-procedure
     1750         (input  v-diasize-orig-frame-width
     1751         ,input  true
     1752         ) .
     1753     end.
     1754   end procedure.
     1755   procedure diasize_restore-current-size :
     1756     do
     1757     on error undo, return error return-value
     1758     :
     1759       run diasize_set-height in this-procedure
     1760         (input  v-diasize-current-frame-height
     1761         ,input  true
     1762         ) .
     1763       run diasize_set-width in this-procedure
     1764         (input  v-diasize-current-frame-width
     1765         ,input  true
     1766         ) .
     1767     end.
     1768   end procedure.
     1769   procedure diasize_set-browse-handle :
     1770     define input  parameter p-browse-handle as handle   no-undo .
     1771     define buffer buf_temp-browse-handle for temp-browse-handle .
     1772     do
     1773     on error undo, return error return-value
     1774     :
     1775       assign
     1776         v-diasize-browse-handle = p-browse-handle
     1777       .
     1778       for each buf_temp-browse-handle
     1779       on error undo, return error return-value
     1780       :
     1781         delete buf_temp-browse-handle .
     1782       end.
     1783     end.
     1784   end procedure.
     1785   procedure diasize_add_browse :
     1786     define input  parameter p-browse-type   as character no-undo .
     1787     define input  parameter p-browse-handle as handle    no-undo .
     1788     define buffer buf_temp-browse-handle for temp-browse-handle .
     1789     do
     1790     on error undo, return error return-value
     1791     :
     1792       assign
     1793         v-diasize-browse-number = v-diasize-browse-number + 1
     1794       .
     1795       create buf_temp-browse-handle .
     1796       assign
     1797         buf_temp-browse-handle.browse-type   = p-browse-type
     1798         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1799         buf_temp-browse-handle.browse-handle = p-browse-handle
     1800       .
     1801     end.
     1802   end procedure.
     1803   procedure diasize_init :
     1804     define variable v-default-value    as logical   no-undo .
     1805     define variable v-restore-saved    as logical   no-undo .
     1806     define variable v-resize-value-str as character no-undo .
     1807     do
     1808     on error undo, return error return-value
     1809     :
     1810       do with frame v-cust
     1811       :
     1812         assign
     1813           v-diasize-orig-frame-height = frame v-cust :height
     1814           v-diasize-orig-frame-width  = frame v-cust :width
     1815           v-diasize-browse-handle     = browse br-docs :handle
     1816         .
     1817         create button v-diasize-resize-button
     1818         assign
     1819           parent        = frame v-cust :first-child
     1820           label         = "s"
     1821           height-pixels = 16
     1822           width-pixels  = 16
     1823           visible       = true
     1824           sensitive     = true
     1825           movable       = true
     1826           triggers:
     1827             on end-move persistent run diasize_end-move in this-procedure .
     1828           end triggers.
     1829         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1830         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1831         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1832         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1833         assign
     1834           v-diasize-wndmax = false
     1835         .
     1836         if connected("ub") = true
     1837         then do:
     1838           define variable v-cntxt-db-num        as integer   no-undo .
     1839           define variable v-cntxt-userid        as character no-undo .
     1840           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1841                                             , OUTPUT v-cntxt-userid
     1842                                             ) .
     1843           run gbl/wndpar_r.p
     1844             (input  v-cntxt-db-num
     1845             ,input  v-cntxt-userid
     1846             ,input  'wndmax':U
     1847             ,output v-diasize-wndmax
     1848             ,output v-default-value
     1849             ) .
     1850         end.
     1851         assign
     1852           v-diasize-wndstore = false
     1853         .
     1854         if connected("ub") = true
     1855         then do:
     1856           run gbl/wndpar_r.p
     1857             (input  v-cntxt-db-num
     1858             ,input  v-cntxt-userid
     1859             ,input  'wndstore':U
     1860             ,output v-diasize-wndstore
     1861             ,output v-default-value
     1862             ) .
     1863         end.
     1864         assign
     1865           v-diasize-proc-name = entry(1, program-name(2), '.')
     1866         .
     1867         if v-diasize-wndstore = true
     1868         then do:
     1869           assign
     1870             v-restore-saved = false
     1871           .
     1872           if connected("ub") = true
     1873           then do:
     1874             run gbl/wndsizer.p
     1875               (input  v-cntxt-db-num
     1876               ,input  v-cntxt-userid
     1877               ,input  v-diasize-proc-name
     1878               ,input  'height':u
     1879               ,output v-resize-value-str
     1880               ) .
     1881             if v-resize-value-str <> '':U
     1882             then do:
     1883               run diasize_change-height in this-procedure
     1884                 (input  integer(v-resize-value-str)
     1885                 ,input  true
     1886                 ) .
     1887               assign
     1888                 v-restore-saved = true
     1889               .
     1890             end.
     1891           end.
     1892           if connected("ub") = true
     1893           then do:
     1894             run gbl/wndsizer.p
     1895               (input  v-cntxt-db-num
     1896               ,input  v-cntxt-userid
     1897               ,input  v-diasize-proc-name
     1898               ,input  'width':u
     1899               ,output v-resize-value-str
     1900               ) .
     1901             if v-resize-value-str <> '':U
     1902             then do:
     1903               run diasize_change-width in this-procedure
     1904                 (input  integer(v-resize-value-str)
     1905                 ,input  true
     1906                 ) .
     1907               assign
     1908                 v-restore-saved = true
     1909               .
     1910             end.
     1911           end.
     1912           if v-restore-saved <> true
     1913           then do:
     1914             if v-diasize-wndmax = true
     1915             then do:
     1916               run diasize_maximize in this-procedure
     1917                 (input  true
     1918                 ) .
     1919             end.
     1920           end.
     1921         end.
     1922         else do:
     1923           if v-diasize-wndmax = true
     1924           then do:
     1925             run diasize_maximize in this-procedure
     1926               (input  true
     1927               ) .
     1928           end.
     1929         end.
     1930       end.
     1931     end.
     1932   end procedure.
     1933   procedure diasize_need-full-display :
     1934     define output parameter p-need-full-display as logical   no-undo .
     1935     do
     1936     on error undo, return error return-value
     1937     :
     1938       assign
     1939         p-need-full-display = v-diasize-need-full-display
     1940       .
     1941       assign
     1942         v-diasize-need-full-display = false
     1943       .
     1944     end.
     1945   end procedure.
     1946   procedure get-context :
     1947      define output parameter p-db-num as integer          no-undo.
     1948      define output parameter p-user-id as character        no-undo.
     1949      define variable v-login               as character    no-undo.
     1950      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1951      define buffer buf_user-login  for ub.user-login .
     1952      do
     1953      on error undo, return error
     1954      :
     1955            FIND FIRST buf_sys-ctrl no-lock.
     1956            ASSIGN
     1957               v-login = USERID("ub")
     1958               p-db-num = buf_sys-ctrl.db-num
     1959            .
     1960            FIND FIRST buf_user-login
     1961                 WHERE buf_user-login.db-num = p-db-num
     1962                   AND buf_user-login.user-login = v-login
     1963                 no-lock
     1964                 no-error
     1965                 .
     1966            IF AVAILABLE buf_user-login
     1967            THEN DO:
     1968               assign
     1969                  p-user-id = buf_user-login.user-id
     1970               .
     1971            END.
     1972      end.
     1973   end procedure.
     1974       run diasize_init in this-procedure .
     1975   MAIN-BLOCK:
     1976   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1977      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1978   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1979   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1980     (input  p-curr-obj-type
     1981     ,input  p-curr-obj-code
     1982     ,output v-host-code
     1983     )  .
     1984   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1985   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1986     (input  v-host-code
     1987     ,output v-base-code
     1988     )  .
     1989     find first buf_rep_currency no-lock
     1990     where buf_rep_currency.curr-code = v-base-code
     1991     no-error .
     1992     if available buf_rep_currency then base-type = buf_rep_currency.curr-abbr .
     1993                 else base-type = "б.в." .
     1994     assign
     1995         tot-in-qnty = suppl-parts.in-qnty
     1996         tot-in-sum0-base = suppl-parts.in-sum0-base
     1997         tot-in-sum0-rubl = suppl-parts.in-sum0-rubl
     1998         tot-out-qnty = suppl-parts.out-qnty
     1999         tot-out-sum0-base = suppl-parts.out-sum0-base
     2000         tot-out-sum0-rubl = suppl-parts.out-sum0-rubl
     2001         tot-free-qnty = suppl-parts.free-qnty
     2002         tot-free-sum0-base = suppl-parts.free-sum0-base
     2003         tot-free-sum0-rubl = suppl-parts.free-sum0-rubl
     2004         .
     2005     RUN enable_UI.
     2006     FRAME v-cust:TITLE = string("Документы по партии " + suppl-parts.part-code +
     2007                                        " из " + caps(substring(suppl-parts.doc-type, 1, 1)) + "Н № " + suppl-parts.out-code +
     2008                                        " товара " + suppl-parts.artic + " " + suppl-parts.gds-name ).
     2009     APPLY "ENTRY" TO BROWSE br-docs .
     2010     APPLY "ITERATION-CHANGED" TO BROWSE br-docs .
     2011     WAIT-FOR GO OF FRAME v-cust.
     2012   END.
     2013   RUN disable_UI.
     2014   PROCEDURE disable_UI :
     2015     HIDE FRAME v-cust.
     2016   END PROCEDURE.
     2017   PROCEDURE enable_UI :
     2018     DISPLAY tot-in-qnty tot-out-qnty tot-free-qnty tot-in-sum0-rubl
     2019             tot-out-sum0-rubl tot-free-sum0-rubl tot-in-sum0-base
     2020             tot-out-sum0-base tot-free-sum0-base
     2021         WITH FRAME v-cust.
     2022     ENABLE b-quit b-print b-help br-docs
     2023         WITH FRAME v-cust.
     2024     VIEW FRAME v-cust.
     2025     OPEN QUERY br-docs FOR EACH ub.parts WHERE ub.parts.artic = suppl-parts.artic                      AND ub.parts.prod-type = suppl-parts.prod-type                      AND ub.parts.prod-code = suppl-parts.prod-code                      AND ub.parts.in-code = suppl-parts.in-code                      AND ub.parts.part-code = suppl-parts.part-code                      AND ub.parts.status_ = yes NO-LOCK,            EACH t-doc WHERE t-doc.doc-code = ub.parts.out-code NO-LOCK BY t-doc.fact-date BY t-doc.fact-num.
     2026   END PROCEDURE.
