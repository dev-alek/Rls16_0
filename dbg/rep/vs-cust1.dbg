      996         v-frame-virtual-height = frame v-cust :virtual-height
      997         v-browse-height = v-diasize-browse-handle :height
      998       .
      999       for each buf_temp-browse-handle
     1000         where buf_temp-browse-handle.browse-type = 'height':u
     1001       :
