        1   define input parameter parparentproc as widget-handle no-undo .
        2   define input parameter p-curr-obj-type like ub.clients.obj-type no-undo .
        3   define input parameter p-curr-obj-code like ub.clients.obj-code no-undo .
        4   define input parameter from-date as date no-undo .
        5   define input parameter to-date as date no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Отчет о движении партии товара   СУДЬБА".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   procedure proc-alt-shift-f2:
       71     if not ibs.th.gbl.gbl-var:rcode
       72   then
       73     run gbl\inidebug.p .
       74   end.
       75   procedure proc-alt-shift-f3:
       76     run gbl/prvssinf.p
       77       ( input this-procedure
       78       ) .
       79   end.
       80   define variable v-inform-launched as logical no-undo initial false .
       81   procedure proc-alt-shift-f4:
       82     define variable v-action as character no-undo .
       83     if v-inform-launched = false then do:
       84       assign
       85         v-inform-launched = true
       86       .
       87       run gbl/d-inform.w
       88         (  input self
       89         ,  input this-procedure
       90         , output v-action
       91         ) no-error .
       92       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       93       assign
       94         v-inform-launched = false
       95       .
       96     end.
       97   end.
       98   procedure proc-alt-f1:
       99     run gbl/corrhelp.p
      100       (input this-procedure
      101       ) .
      102   end .
      103   on alt-shift-f2 anywhere do:
      104     run proc-alt-shift-f2.
      105   end.
      106   on alt-shift-f3 anywhere do:
      107     run proc-alt-shift-f3 in this-procedure .
      108   end.
      109   on alt-shift-f4 anywhere do:
      110     run proc-alt-shift-f4 in this-procedure.
      111   end.
      112   on alt-f1 anywhere do:
      113     run proc-alt-f1 in this-procedure .
      114   end.
      115   define new global shared variable g#library  as handle no-undo .
      116   define new global shared variable g#library2 as handle no-undo .
      117   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      118   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      119   define  shared variable RepPathName        as character no-undo .
      120   define  shared variable PrintRubl          as logical   no-undo .
      121   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      122   define  stream PrnLibStream.
      123   procedure prn-lib-prn-file :
      124     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      125     define input parameter p-DIsabledoptions as integer no-undo .
      126     define variable v-report-name as character no-undo .
      127     define variable v-user-action as character no-undo .
      128     define variable v-printed     as logical   no-undo .
      129     define variable v-exist       as logical   no-undo .
      130     do
      131       on error undo, return error
      132       :
      133       run prn-lib-get-report-name  in this-procedure (
      134         input parParentProc
      135         ,output v-report-name
      136         ).
      137   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      138   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      139     (input  v-report-name
      140     ,input  2
      141     ,output v-exist
      142     )  .
      143       if NOT v-exist then
      144       DO:
      145         Message
      146           "Нет заданий на печать ! "
      147           view-as alert-box .
      148         Return  .
      149       End.
      150       run gbl/prnfilen.w
      151         (input  ""
      152         ,input  p-DisabledOptions
      153         ,input  string(v-report-name )
      154         ,input  7
      155         ,output v-user-action
      156         ,output v-printed
      157         ) .
      158       if v-printed then
      159       do:
      160         return "YES" .
      161       end.
      162       else
      163       do:
      164         return "NO" .
      165       end.
      166     end.
      167   end procedure.
      168   procedure prn-lib-open-stream :
      169     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      170     define input parameter p-page-size    as integer no-undo .
      171     define input parameter p-is-stream    as logical no-undo .
      172     define input parameter p-append       as logical no-undo .
      173     define variable v-report-name as character no-undo .
      174     do
      175       on error undo, return error
      176       :
      177       run prn-lib-get-report-name  in this-procedure (
      178         input parParentProc
      179         ,output v-report-name
      180         ).
      181       if p-is-stream then
      182       do:
      183         if p-append then
      184         do:
      185           output stream PrnLibStream to value( v-report-name )
      186             page-size value(p-page-size) append .
      187         end.
      188         if not p-append then
      189         do:
      190           output stream PrnLibStream to value( v-report-name )
      191             page-size value(p-page-size) .
      192         end.
      193       end.
      194       if not p-is-stream then
      195       do:
      196         if p-append then
      197         do:
      198           output to value( v-report-name )
      199             page-size value(p-page-size) append .
      200         end.
      201         if not p-append then
      202         do:
      203           output to value( v-report-name )
      204             page-size value(p-page-size) .
      205         end.
      206       end.
      207     end.
      208   end procedure.
      209   procedure prn-lib-open-exp :
      210     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      211     define input parameter p-is-stream    as logical no-undo .
      212     define input parameter p-is-append    as logical no-undo .
      213     define output parameter p-ReportFileName as char init "report" no-undo.
      214     define output parameter p-process as logical no-undo .
      215     define variable glog as logical no-undo .
      216     do
      217       on error undo, return error
      218       :
      219       SYSTEM-DIALOG GET-FILE p-ReportFileName
      220         TITLE      "Укажите путь"
      221         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      222         ASK-OVERWRITE
      223         CREATE-TEST-FILE
      224         SAVE-AS
      225         USE-FILENAME
      226         DEFAULT-EXTENSION "txt"
      227         UPDATE glog
      228         .
      229       if not glog then  return.
      230       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      231       if p-is-stream then
      232       do:
      233         if p-is-append then
      234         do:
      235           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      236         end.
      237         else
      238         do:
      239           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      240         end.
      241       end.
      242       else
      243       do:
      244         if p-is-append then
      245         do:
      246           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      247         end.
      248         else
      249         do:
      250           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      251         end.
      252       end.
      253       p-process = yes.
      254     end.
      255   end procedure.
      256   procedure prn-lib-get-report-name :
      257     define input parameter parParentProc  as widget-handle no-undo.
      258     define output parameter p-report-name as character no-undo .
      259     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      260   end procedure.
      261   procedure prn-lib-reportviewer-report-name :
      262     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      263     define input parameter p-report-name-html as character no-undo .
      264     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      265   end procedure.
      266   procedure prn-lib-reportviewer :
      267     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      268     define input parameter p-report-name-html as character no-undo .
      269     define input parameter p-param        as character no-undo .
      270     define variable v-excel           as character no-undo init 'TRUE' .
      271     define variable v-value-character as character no-undo .
      272     define variable v-value-integer   as character no-undo .
      273     define variable v-value-date      as date      no-undo .
      274     define variable v-value-decimal   as decimal   no-undo .
      275     define variable rep-excel         as logical   no-undo .
      276     define variable excel-string      as character no-undo .
      277     define variable v-param-type      as character no-undo .
      278     define variable v-tth             as handle    no-undo .
      279     run adm/shattri.p (
      280       input "get":U
      281       ,input  ""
      282       ,input  0
      283       ,input  'report-glob':U
      284       ,input  'rep-excel':U
      285       ,output v-value-character
      286       ,output v-value-date
      287       ,output v-value-decimal
      288       ,output v-value-integer
      289       ,output rep-excel
      290       ,output v-param-type
      291       ,INPUT-OUTPUT table-handle v-tth
      292       )  .
      293     if rep-excel then v-excel = "TRUE" .
      294     else v-excel = "FALSE" .
      295     if p-param eq ""
      296     then
      297        p-param = "EXCEL:" + v-excel.
      298     else
      299        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      300     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      301   end procedure.
