      489        LABEL "сумма ()"
      490        VIEW-AS FILL-IN
      491        SIZE 17 BY 1
      492        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      493   DEFINE VARIABLE tot-out-qnty AS DECIMAL FORMAT "->>>,>>>,>>9.<<<":U INITIAL ?
      494        VIEW-AS FILL-IN
      495        SIZE 17 BY 1
      496        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      497   DEFINE VARIABLE tot-out-sum0-base AS DECIMAL FORMAT "->>>,>>>,>>9.99" INITIAL ?
      498        VIEW-AS FILL-IN
      499        SIZE 17 BY 1
      500        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      501   DEFINE VARIABLE tot-out-sum0-rubl AS DECIMAL FORMAT "->>>,>>>,>>9.99" INITIAL ?
      502        VIEW-AS FILL-IN
      503        SIZE 17 BY 1
      504        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      505   DEFINE QUERY br-docs FOR
      506         ub.parts,
      507         t-doc SCROLLING.
      508   DEFINE BROWSE br-docs
      509     QUERY br-docs DISPLAY
      510         (substring (t-doc.doc-type, 1, 1)) COLUMN-LABEL "Т" FORMAT "x(1)"
      511         t-doc.status_ COLUMN-LABEL "Стат" format "x(4)"
      512         t-doc.flag_ COLUMN-LABEL "OK" FORMAT "+/-"
      513         t-doc.doc-code format "x(12)"
      514         (substring ((string (t-doc.doc-date)), 1, 5)) format "x(5)" column-label "Дата"
      515         t-doc.fact-date COLUMN-LABEL "Факт"
      516         t-doc.internal COLUMN-LABEL "В" FORMAT "+/-"
      517         t-doc.cli-name format "x(27)"
      518         ub.parts.fact-qnty COLUMN-LABEL "Количество" FORMAT "->>>,>>9.<<<"
      519         ub.parts.price-base COLUMN-LABEL "Цена (б.вал)"
      520         ub.parts.price-rubl
      521         (if ub.parts.part-code = "" then "------" else ub.parts.part-code) COLUMN-LABEL "Партия" FORMAT "x(14)"
      522         (trim (t-doc.obj-type) + string (t-doc.obj-code, ">>>>9")) COLUMN-LABEL "Объекты" FORMAT "x(8)"
      523         t-doc.inv-num column-label "Инвойс "
      524         t-doc.ord-num column-label "Заказ"
      525         t-doc.ship-num column-label "Отгрузка"
      526         t-doc.ship-date column-label "Дата"
      527         t-doc.out-code column-label "На док-т" format "x(12)"
      528         t-doc.acc-date column-label "Проводка"
      529         func-get-name-from-ext-type ( t-doc.ext-doc-type , false )   COLUMN-LABEL "Тип" FORMAT "x(20)"
      530       WITH NO-ROW-MARKERS SEPARATORS SIZE 96.5 BY 17.33.
      531   DEFINE FRAME v-cust
      532        b-quit AT ROW 1.17 COL 2
      533        b-print AT ROW 1.17 COL 12
      534        b-help AT ROW 1.17 COL 88.5
      535        br-docs AT ROW 2.33 COL 2
      536        tot-in-qnty AT ROW 20.83 COL 18.5 COLON-ALIGNED
      537        tot-out-qnty AT ROW 20.83 COL 45 COLON-ALIGNED NO-LABEL
      538        tot-free-qnty AT ROW 20.83 COL 72.5 COLON-ALIGNED NO-LABEL
      539        tot-in-sum0-rubl AT ROW 22 COL 18.5 COLON-ALIGNED
      540        tot-out-sum0-rubl AT ROW 22 COL 45 COLON-ALIGNED NO-LABEL
      541        tot-free-sum0-rubl AT ROW 22 COL 72.5 COLON-ALIGNED NO-LABEL
      542        tot-in-sum0-base AT ROW 23.17 COL 18.5 COLON-ALIGNED
      543        tot-out-sum0-base AT ROW 23.17 COL 45 COLON-ALIGNED NO-LABEL
      544        tot-free-sum0-base AT ROW 23.17 COL 72.5 COLON-ALIGNED NO-LABEL
      545        "Остаток" VIEW-AS TEXT
      546             SIZE 10 BY .63 AT ROW 20 COL 77.5
      547        "Расход" VIEW-AS TEXT
      548             SIZE 8.5 BY .63 AT ROW 20 COL 51
      549        "Приход" VIEW-AS TEXT
      550             SIZE 8.5 BY .63 AT ROW 20 COL 25.5
      551        SPACE(65.86) SKIP(4.03)
      552       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      553            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      554            TITLE "Документы"
      555            DEFAULT-BUTTON b-quit.
      556   ASSIGN
      557          FRAME v-cust:SCROLLABLE       = FALSE
      558          FRAME v-cust:HIDDEN           = TRUE.
      559   ON WINDOW-CLOSE OF FRAME v-cust
      560   DO:
      561     APPLY "END-ERROR":U TO SELF.
      562   END.
      563   ON CHOOSE OF b-print IN FRAME v-cust
      564   DO:
      565   def var object as char no-undo.
      566   def var price0 LIKE ub.parts.price-rubl no-undo.
      567   def var stoim0 as decimal no-undo.
      568   def var DocDate as char no-undo.
      569   def var sym1 as char init ":"   no-undo.
      570   def var sym2 as char init ":"   no-undo.
      571   def var sym3 as char init ":"   no-undo.
      572   def var sym4 as char init ":"   no-undo.
      573   def var sym5 as char init ":"   no-undo.
      574   def var sym6 as char init ":"   no-undo.
      575   def var sym7 as char init ":"   no-undo.
      576   def var sym8 as char init ":"   no-undo.
      577   def var sym9 as char init ":"   no-undo.
      578   def var sym10 as char init ":"   no-undo.
      579   def var sym11 as char init ":"   no-undo.
      580   def var sym12 as char init ":"   no-undo.
      581   def var sym13 as char init ":"   no-undo.
      582   def var sym14 as char init ":"   no-undo.
      583   def var Line as char no-undo.
      584   DEFINE FRAME supp-gds
      585         sym1 column-label ":" format "X(1)"
      586         t-doc.doc-type COLUMN-LABEL "Тип" FORMAT "x(3)"
      587         sym2 column-label ":" format "X(1)"
      588         t-doc.status_ COLUMN-LABEL "Стат" format "x(4)"
      589         sym3 column-label ":" format "X(1)"
      590         t-doc.flag_ COLUMN-LABEL "OK" FORMAT "+/-"
      591         sym4 column-label ":" format "X(1)"
      592         t-doc.doc-code COLUMN-LABEL "Номер документа" format "x(16)"
      593         sym5 column-label ":" format "X(1)"
      594         DocDate COLUMN-LABEL "Дата" format "x(5)"
      595         sym6 column-label ":" format "X(1)"
      596         t-doc.fact-date COLUMN-LABEL "Дата закр."  FORMAT "99/99/9999"
      597         sym7 column-label ":" format "X(1)"
      598         t-doc.internal COLUMN-LABEL "В" FORMAT "+/-"
      599         sym8 column-label ":" format "X(1)"
      600         t-doc.cli-name COLUMN-LABEL "Контрагент" format "x(47)"
      601         sym9 column-label ":" format "X(1)"
      602         ub.parts.fact-qnty COLUMN-LABEL "    Количество" FORMAT "->,>>>,>>9.<<<"
      603         sym10 column-label ":" format "X(1)"
      604         price0 COLUMN-LABEL "Учетная цена" FORMAT "->,>>>,>>9.99"
      605         sym11 column-label ":" format "X(1)"
      606         stoim0 COLUMN-LABEL "Сумма учетных цен" FORMAT "->>,>>>,>>>,>>9.99"
      607         sym12 column-label ":" format "X(1)"
      608         ub.parts.part-code COLUMN-LABEL "Партия" FORMAT "x(14)"
      609         sym13 column-label ":" format "X(1)"
      610         object COLUMN-LABEL "Объект" FORMAT "x(8)"
      611         sym14 column-label ":" format "X(1)"
      612       HEADER
      613           string( "Дата печати : " + string(TODAY,"99.99.9999") +  " , " + string(TIME, "HH:MM") ) AT 5 format "X(35)"
      614           string( "Отчет по поставщику: " + supplier.obj-name ) AT 45 format "X(71)"
      615           string( "Cуммы указаны в " + (if PrintRubl then "руб" else base-type) ) AT 145 format "X(20)"
      616           string( "Страница " + string( PAGE-NUMBER( PrnLibStream ), ">>9" ) ) AT 170 format "X(13)" SKIP
      617           Line format "X(195)" AT 1
      618       with width 232 down stream-io.
      619   assign PrintRubl = yes .
      620   if v-base-code <> 0 then
      621   message "Печатать в РУБЛЯХ ?"
      622   VIEW-AS ALERT-BOX QUESTION BUTTONS yes-no TITLE "" UPDATE PrintRubl.
      623   if session:set-wait-state("COMPILER") then.
      624   assign Line = fill("-", 232).
      625   run prn-lib-open-stream  in this-procedure (
      626                                                input parParentProc
      627                                               ,input 43
      628                                               ,input yes
      629                                               ,input no
      630                                               ).
      631   FORM with FRAME supp-gds.
      632   FORM HEADER
      633       Line format "X(195)" AT 1 SKIP
      634       "Продолжение - на следующей странице" AT 60 SKIP
      635       with FRAME BottomFrame width 232
      636       PAGE-BOTTOM no-labels no-box.
      637   VIEW STREAM PrnLibStream FRAME BottomFrame .
      638   PUT STREAM PrnLibStream string( "Д О К У М Е Н Т Ы за период с: " + string(from-date,"99/99/9999") +
      639                                                         " по: " + string(to-date,"99/99/9999") )
      640                                                  AT 69 format "X(195)"
      641                                              SKIP(1)
      642                                              string( "ПОСТАВЩИК: " + supplier.obj-name +
      643                                                         " (" + supplier.obj-type + " " + string(supplier.obj-code) + ")" )
      644                                                  AT 10 format "X(195)"
      645                                              SKIP
      646                                              string( "ТОВАР: " + suppl-parts.artic + ' "' + suppl-parts.gds-name + '"' )
      647                                                  AT 14 format "X(195)"
      648                                              SKIP
      649                                              string( "ПАРТИЯ: " + suppl-parts.part-code +
      650                                                         "из " + caps(substring(suppl-parts.doc-type, 1, 1)) + "Н № " + suppl-parts.out-code )
      651                                                  AT 13 format "X(195)"
      652                                              SKIP(1).
      653       DO WHILE available ub.parts :
      654           GET prev br-docs.
      655       END.
      656       GET next br-docs.
      657       DO WHILE available ub.parts :
      658           assign price0 = (if PrintRubl then suppl-parts.price0-rubl else suppl-parts.price0-base).
      659           assign stoim0 = price0 * ub.parts.fact-qnty.
      660           DISPLAY STREAM PrnLibStream
      661               sym1 t-doc.doc-type
      662               sym2 t-doc.status_
      663               sym3 t-doc.flag_
      664               sym4 t-doc.doc-code
      665               sym5 (substring ((string (t-doc.doc-date)), 1, 5)) @ DocDate
      666               sym6 t-doc.fact-date
      667               sym7 t-doc.internal
      668               sym8 t-doc.cli-name
      669               sym9 ub.parts.fact-qnty
      670               sym10 price0
      671               sym11 stoim0
      672               sym12 (if ub.parts.part-code = "" then "------" else ub.parts.part-code) @ ub.parts.part-code
      673               sym13 (trim (t-doc.obj-type) + string (t-doc.obj-code, ">>>>9")) @ object
      674               sym14
      675               with FRAME supp-gds .
      676           DOWN STREAM PrnLibStream 1 with FRAME supp-gds .
      677           GET next br-docs.
      678       END.
      679   PUT STREAM PrnLibStream Line format "X(195)" SKIP.
      680   DISPLAY STREAM PrnLibStream
      681       "Остаток" @ t-doc.cli-name
      682       tot-free-qnty @ ub.parts.fact-qnty
      683       (if PrintRubl then tot-free-sum0-rubl else tot-free-sum0-base) @ stoim0
      684       with FRAME supp-gds .
      685   DOWN STREAM PrnLibStream 1 with FRAME supp-gds .
      686   HIDE STREAM PrnLibStream FRAME BottomFrame .
      687   OUTPUT STREAM PrnLibStream CLOSE.
      688   if session:set-wait-state("") then.
      689   run prn-lib-prn-file in this-procedure (
      690                                             input parParentProc
      691                                             ,input 8
      692                                             ).
      693   APPLY "ENTRY" TO BROWSE br-docs.
      694   END.
      695   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME v-cust:PARENT eq ?
      696   THEN FRAME v-cust:PARENT = ACTIVE-WINDOW.
      697   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      698   on help of frame v-cust
      699   do:
      700     run gbl/app_help.p
      701       (input this-procedure :file-name
      702       ,input ''
      703       ,input ?
      704       ) no-error.
      705     if error-status :error then do:
      706       message
      707         "Ошибка при вызове помощи"
      708         error-status :get-message(1)
      709         view-as alert-box .
      710     end.
      711   end.
      712   run minbtn-set in this-procedure .
      713   on choose of b-help in frame v-cust
      714   do:
      715     apply "help":u to frame v-cust .
      716   end.
      717   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      718   procedure minbtn-set :
      719       do
      720           on error undo, return error return-value
      721           :
      722           define variable ii              as integer       no-undo .
      723           define variable fh              as widget-handle no-undo .
      724           define variable hh              as widget-handle no-undo .
      725           define variable v-h             as handle        extent 4 no-undo .
      726           define variable v-name-button   as character     no-undo .
      727           define variable v-help-old-x    as decimal       no-undo .
      728           define variable v-help-old-y    as decimal       no-undo .
      729           define variable v-help-old-size as decimal       no-undo .
      730           define variable v-frame-width   as decimal       no-undo .
      731           define variable jj              as integer       no-undo .
      732           do
      733               on error undo, return error
      734               :
      735               assign
      736                   v-frame-width = frame v-cust:width - 0.3
      737                   fh            = frame v-cust:first-child
      738                   hh            = fh:first-child
      739                   ii            = 1
      740                   .
      741               do while valid-handle(hh):
      742                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      743                   do:
      744                       case lc(hh:name) :
      745                           when "b-help" then
      746                               do:
      747                                   hh:load-image-up("cmp/b-help.bmp":u) .
      748                                   hh:load-image-down("cmp/b-help.bmp":u) .
      749                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      750                                   hh:TOOLTIP = "Помощь" .
      751                                   v-help-old-x = hh:column .
      752                                   v-help-old-y = hh:row    .
      753                                   v-help-old-size = hh:width .
      754                                   hh:width-chars = 2.5 .
      755                               end.
      756                           when "b-print" then
      757                               do:
      758                                   hh:load-image("cmp/b-print.bmp":u) .
      759                                   hh:TOOLTIP = "Печать" .
      760                                   v-h[ii] = hh:handle .
      761                                   ii = ii + 1 .
      762                                   hh:width-chars = 3 .
      763                               end.
      764                           when "b-history" or
      765                           when "b-hist" then
      766                               do:
      767                                   hh:load-image("cmp/b-hist.bmp":u) .
      768                                   hh:TOOLTIP = "История" .
      769                                   v-h[ii] = hh:handle .
      770                                   ii = ii + 1 .
      771                                   hh:width-chars = 3 .
      772                               end.
      773                           when "b-sch" then
      774                               do:
      775                                   hh:load-image("cmp/b-sch.bmp":u) .
      776                                   hh:TOOLTIP = "Установка Фильтра" .
      777                                   v-h[ii] = hh:handle .
      778                                   ii = ii + 1 .
      779                                   hh:width-chars = 3 .
      780                               end.
      781                           when "b-hist-user" then
      782                               do:
      783                                   hh:load-image("cmp/b-hist.bmp":u) .
      784                                   hh:TOOLTIP = "История пользователя" .
      785                                   ii = ii + 1 .
      786                               end.
      787                       end case.
      788                   end.
      789                   hh = hh:next-sibling.
      790               end.
      791               b-help:column = v-frame-width - b-help:width-chars.
      792               jj = 0.
      793               repeat ii = 4 to 1 by -1 :
      794                   if valid-handle (v-h[ii] ) then
      795                   do:
      796                       jj  = jj + 1 .
      797                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      798                       v-h[ii]:row    = v-help-old-y .
      799                   end.
      800               end.
      801           end.
      802       end.
      803   end procedure.
      804   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      805   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      806   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      807   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      808   define variable v-diasize-current-frame-width  as decimal   no-undo .
      809   define variable v-diasize-current-frame-height as decimal   no-undo .
      810   define variable v-diasize-change-size          as logical   no-undo .
      811   define variable v-diasize-resize-button        as handle    no-undo .
      812   define variable v-diasize-wndmax               as logical   no-undo .
      813   define variable v-diasize-wndstore             as logical   no-undo .
      814   define variable v-diasize-proc-name            as character no-undo .
      815   define variable v-diasize-browse-handle        as handle    no-undo .
      816   define variable v-diasize-browse-number        as integer   no-undo .
      817   define variable v-diasize-need-full-display    as logical   no-undo init false .
      818   define temp-table temp-diasize-handle no-undo
      819     field handle-value  as handle
      820     field save-position as decimal
      821     index xpk is primary unique handle-value
      822     .
      823   define temp-table temp-browse-handle no-undo
      824     field browse-type   as character
      825     field browse-number as integer
      826     field browse-handle as handle
      827     field original-size as decimal
      828     index xpk is primary unique browse-type browse-number
      829     index xie browse-type browse-handle
      830   .
      831   procedure diasize_change-height :
      832     define input  parameter p-change-value  as decimal   no-undo .
      833     define input  parameter p-move-resize   as logical   no-undo .
      834     define variable v-field-group-handle    as handle    no-undo .
      835     define variable v-object-handle         as handle    no-undo .
      836     define variable v-frame-height          as decimal   no-undo .
      837     define variable v-frame-virtual-height  as decimal   no-undo .
      838     define variable v-browse-height         as decimal   no-undo .
      839     define variable v-window-height         as decimal   no-undo .
      840     define variable v-window-virtual-height as decimal   no-undo .
      841     define variable v-change-sign           as integer   no-undo .
      842     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      843     define buffer buf_temp-browse-handle  for temp-browse-handle .
      844     if p-change-value > 0
      845     then do:
      846       if frame v-cust :height + p-change-value
      847           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      848       then do:
      849         assign
      850           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      851                           - (frame v-cust :height-chars)
      852         .
      853         if p-change-value <= 0
      854         then do:
      855           run diasize_position-resize-button in this-procedure .
      856           return .
      857         end.
      858       end.
      859     end.
      860     if p-change-value < 0
      861     then do:
      862       if frame v-cust :height + p-change-value < v-diasize-orig-frame-height
      863       then do:
      864         assign
      865           p-change-value = v-diasize-orig-frame-height
      866                          - (frame v-cust :height-chars)
      867         .
      868         if p-change-value >= 0
      869         then do:
      870           run diasize_position-resize-button in this-procedure .
      871           return .
      872         end.
      873       end.
      874     end.
      875     if p-change-value >= 0
      876     then do:
      877       assign
      878         v-change-sign = 1
      879       .
      880     end.
      881     else do:
      882       assign
      883         v-change-sign = -1
      884       .
      885     end.
      886     assign
      887       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      888     .
      889     if p-change-value = 0
      890     then do:
      891       run diasize_position-resize-button in this-procedure .
      892       return .
      893     end.
      894     move_block:
      895     do
      896     on error undo move_block, retry move_block
      897     :
      898       if retry
      899       then do:
      900         do
      901         on error undo move_block, leave move_block
      902         :
      903           if p-change-value > 0
      904           then do:
      905             for each buf_temp-diasize-handle
      906             on error undo, next
      907             :
      908               assign
      909                 v-object-handle = buf_temp-diasize-handle.handle-value
      910               .
      911               if v-object-handle <> v-diasize-resize-button
      912               then do:
      913                 assign
      914                   v-object-handle :row = buf_temp-diasize-handle.save-position
      915                 .
      916               end.
      917             end.
      918             assign
      919               v-diasize-browse-handle :height = v-browse-height
      920             .
      921             for each buf_temp-browse-handle
      922               where buf_temp-browse-handle.browse-type = 'height':u
      923             on error undo, next
      924             :
      925               assign
      926                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      927               .
      928             end.
      929             assign
      930               frame v-cust :height = v-frame-height
      931             .
      932             if frame v-cust :scrollable = true
      933             then do:
      934               assign
      935                 frame v-cust :virtual-height = v-frame-virtual-height
      936               .
      937             end.
      938             run diasize_position-resize-button in this-procedure .
      939           end.
      940           else do:
      941             if frame v-cust :scrollable = true
      942             then do:
      943               assign
      944                 frame v-cust :virtual-height = v-frame-virtual-height
      945               .
      946             end.
      947             assign
      948               frame v-cust :height = v-frame-height
      949             .
      950             assign
      951               v-diasize-browse-handle :height = v-browse-height
      952             .
      953             for each buf_temp-browse-handle
      954               where buf_temp-browse-handle.browse-type = 'height':u
      955             on error undo, next
      956             :
      957               assign
      958                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      959               .
      960             end.
      961             for each buf_temp-diasize-handle
      962             on error undo, next
      963             :
      964               assign
      965                 v-object-handle = buf_temp-diasize-handle.handle-value
      966               .
      967               if v-object-handle <> v-diasize-resize-button
      968               then do:
      969                 assign
      970                   v-object-handle :row = buf_temp-diasize-handle.save-position
      971                 .
      972               end.
      973             end.
      974             run diasize_position-resize-button in this-procedure .
      975           end.
      976           assign
