     1206   procedure diasize_set-height :
     1207     define input  parameter p-new-height  as decimal   no-undo .
     1208     define input  parameter p-move-resize as logical   no-undo .
     1209     do
     1210     on error undo, return error return-value
     1211     :
     1212       run diasize_change-height in this-procedure
     1213         (input  (p-new-height - frame v-cust :height)
     1214         ,input  p-move-resize
     1215         ) .
     1216     end.
     1217   end procedure.
     1218   procedure diasize_change-width :
     1219     define input  parameter p-change-value as decimal   no-undo .
     1220     define input  parameter p-move-resize  as logical   no-undo .
     1221     define variable v-field-group-handle   as handle    no-undo .
     1222     define variable v-object-handle        as handle    no-undo .
     1223     define variable v-frame-width          as decimal   no-undo .
     1224     define variable v-frame-virtual-width  as decimal   no-undo .
