      839        SIZE 28 BY 3.33.
      840   DEFINE QUERY br-pl-gds FOR
      841         tt-pl-gds SCROLLING.
      842   DEFINE QUERY br-shift FOR
      843         tt-shift SCROLLING.
      844   DEFINE BROWSE br-pl-gds
      845     QUERY br-pl-gds DISPLAY
      846         tt-pl-gds.loc1 format "X(2)" column-label "Резервуар"
      847       tt-pl-gds.gds-name format "X(30)" column-label "НП"
      848       WITH NO-ROW-MARKERS SEPARATORS SIZE 26.4 BY 7.38 ROW-HEIGHT-CHARS .57 FIT-LAST-COLUMN.
      849   DEFINE BROWSE br-shift
      850     QUERY br-shift DISPLAY
      851         tt-shift.shift-date format "99.99.9999" column-label "Дата"
      852         shift-name (tt-shift.shift-num, tt-shift.shift-name) format "X(6)" column-label "Номер"
      853       WITH NO-ROW-MARKERS SEPARATORS SIZE 26.4 BY 5.19 ROW-HEIGHT-CHARS .57 FIT-LAST-COLUMN.
      854   DEFINE FRAME Dialog-Frame
      855        Btn_OK AT ROW 1.24 COL 2
      856        Btn_Cancel AT ROW 1.24 COL 17
      857        br-shift AT ROW 2.95 COL 33 WIDGET-ID 300
      858        rs-shift AT ROW 3.62 COL 5.8 NO-LABEL WIDGET-ID 4
      859        b-shift-1 AT ROW 3.67 COL 21.6 WIDGET-ID 32
      860        b-shift-2 AT ROW 4.71 COL 21.6 WIDGET-ID 34
      861        rs-obj AT ROW 7.43 COL 5.6 NO-LABEL WIDGET-ID 12
      862        br-pl-gds AT ROW 9.1 COL 33 WIDGET-ID 200
      863        rs-goods AT ROW 9.86 COL 5.4 NO-LABEL WIDGET-ID 20
      864        b-goods AT ROW 11 COL 21.2 WIDGET-ID 36
      865        rs-place AT ROW 13.86 COL 5.4 NO-LABEL WIDGET-ID 26
      866        b-place AT ROW 15.05 COL 21.2 WIDGET-ID 38
      867        " Выбор периода" VIEW-AS TEXT
      868             SIZE 16.4 BY .62 AT ROW 2.57 COL 8.6 WIDGET-ID 2
      869             FGCOLOR 12
      870        " Выбор резервуаров НП" VIEW-AS TEXT
      871             SIZE 22.6 BY .62 AT ROW 12.86 COL 5 WIDGET-ID 30
      872             FGCOLOR 12
      873        " Выбор объекта" VIEW-AS TEXT
      874             SIZE 16.4 BY .62 AT ROW 6.52 COL 7.6 WIDGET-ID 10
      875             FGCOLOR 12
      876        " Выбор топливных товаров" VIEW-AS TEXT
      877             SIZE 25 BY .62 AT ROW 8.86 COL 4.4 WIDGET-ID 18
      878             FGCOLOR 12
      879        RECT-1 AT ROW 2.91 COL 3 WIDGET-ID 8
      880        RECT-2 AT ROW 6.91 COL 3 WIDGET-ID 14
      881        RECT-3 AT ROW 9.19 COL 3 WIDGET-ID 16
      882        RECT-4 AT ROW 13.19 COL 3 WIDGET-ID 24
      883        SPACE(30.39) SKIP(0.47)
      884       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      885            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      886            TITLE "Отчет Контроль плотности НП"
      887            DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Cancel WIDGET-ID 100.
      888   ASSIGN
      889          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      890          FRAME Dialog-Frame:HIDDEN           = TRUE.
      891   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      892   DO:
      893     APPLY "END-ERROR":U TO SELF.
      894   END.
      895   ON CHOOSE OF b-goods IN FRAME Dialog-Frame
      896   DO:
      897     assign rs-goods = 2 .
      898     display rs-goods with frame Dialog-Frame .
      899     run select-gds .
      900     OPEN QUERY br-pl-gds FOR EACH tt-pl-gds by tt-pl-gds.loc1 .    OPEN QUERY br-shift FOR EACH tt-shift by tt-shift.shift-date desc by tt-shift.shift-num desc .
      901   END.
      902   ON CHOOSE OF b-place IN FRAME Dialog-Frame
      903   DO:
      904     define variable ii as integer no-undo .
      905     define variable v-value as character no-undo .
      906     define variable v-type as character no-undo .
      907     define variable v-ok as logical no-undo .
      908     define variable tmp-pl-list as character no-undo .
      909     assign rs-place = 2 .
      910     display rs-place with frame Dialog-Frame .
      911     assign tmp-pl-list = pl-recid-list-full .
      912     empty temp-table tt-place .
      913     run ref/pl-list.w (
      914        input parparentproc
      915       ,input "b-sel,b-mark"
      916       ,input p-obj-type
      917       ,input p-obj-code
      918       ,input 'объект':U + chr(4) + "np-list"
      919       ,input-output tmp-pl-list).
      920     if tmp-pl-list = "cancel"
      921     then do :
      922       return no-apply .
      923     end .
      924     assign
      925       pl-recid-list = tmp-pl-list
      926       pl-recid-list-full = pl-recid-list
      927     .
      928     do ii = 1 to num-entries(pl-recid-list) :
      929       find first buf_place no-lock where recid(buf_place) = integer(entry(ii, pl-recid-list)) no-error .
      930       if available buf_place
      931       then do :
      932         create tt-place .
      933         assign tt-place.pl-code = buf_place.pl-code .
      934       end .
      935     end .
      936     empty temp-table tt-pl-gds .
      937     do ii = 1 to num-entries(gds-recid-list) :
      938       find first buf_goods no-lock where recid(buf_goods) = integer(entry(ii, gds-recid-list)) no-error .
      939       if available buf_goods
      940       then do :
      941         for each buf_pl-gds no-lock where buf_pl-gds.gds-code = buf_goods.gds-code
      942                                       and buf_pl-gds.obj-type = p-obj-type
      943                                       and buf_pl-gds.obj-code = p-obj-code,
      944           first buf_place where buf_place.pl-code = buf_pl-gds.pl-code
      945         :
      946                   if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
      947             (input  buf_pl-gds.gds-code
      948             ,input  'fuel-type':U
      949             ,output v-value
      950             ,output v-type) no-error.
      951           if v-value = "lgas"
      952           or v-value = "metan"
      953           or v-value = "propan"
      954           then next .
      955           run placelib_get-attr  ( input "place-com-tanks"
      956                                   ,input buf_place.obj-code
      957                                   ,input buf_place.obj-type
      958                                   ,input buf_place.pl-code
      959                                   ,output v-value
      960                                   ,output v-ok      ) no-error.
      961           if v-ok
      962           and v-value > ""
      963           then do :
      964             run placelib_get-attr  ( input "place-is-main"
      965                                     ,input buf_place.obj-code
      966                                     ,input buf_place.obj-type
      967                                     ,input buf_place.pl-code
      968                                     ,output v-value
      969                                     ,output v-ok      ) no-error.
      970             if v-ok
      971             and v-value > ""
      972             and logical(v-value)
      973             then do :
      974             end .
      975             else do :
      976               next .
      977             end .
      978           end .
      979           create tt-pl-gds .
      980           assign
      981             tt-pl-gds.pl-code  = buf_place.pl-code
      982             tt-pl-gds.loc1     = buf_place.loc1
      983             tt-pl-gds.gds-code = buf_goods.gds-code
      984             tt-pl-gds.gds-name = buf_goods.gds-name
      985           .
      986         end .
      987       end .
      988     end .
      989     for each tt-pl-gds :
      990       find first tt-place where tt-place.pl-code = tt-pl-gds.pl-code no-error .
      991       if not available tt-place
      992       then delete tt-pl-gds .
      993     end .
      994     run find-old-pl-gds .
      995     OPEN QUERY br-pl-gds FOR EACH tt-pl-gds by tt-pl-gds.loc1 .    OPEN QUERY br-shift FOR EACH tt-shift by tt-shift.shift-date desc by tt-shift.shift-num desc .
      996   END.
      997   ON CHOOSE OF b-shift-1 IN FRAME Dialog-Frame
      998   DO:
      999     assign rs-shift = 1 .
     1000     display rs-shift with frame Dialog-Frame .
     1001     run str/sht-all.w
     1002                     ( input parparentproc
     1003                      ,input p-obj-type
     1004                      ,input p-obj-code
     1005                      ,input "b-sel"
     1006                      ,input "obj":U
     1007                      ,input p-obj-type
     1008                      ,input p-obj-code
     1009                      ,input ""
     1010                      ,input-output shift-recid-list ).
     1011     if error-status:error
     1012     then do :
     1013       message
     1014         vss-workfile vss-revision vss-description skip
     1015         "Ошибка при выборе смены"  skip
     1016         error-status :get-message( 1 ) skip
     1017         return-value skip
     1018         view-as alert-box error
     1019       .
     1020       return no-apply.
     1021     end.
     1022     if shift-recid-list =  "":U
     1023     then do :
     1024       return no-apply .
     1025     end.
     1026     empty temp-table tt-shift-1 .
     1027     assign choosed-shift-recid = integer (shift-recid-list) .
     1028     find first buf_shift-obj where recid (buf_shift-obj) = choosed-shift-recid no-lock.
     1029     if buf_shift-obj.status_ <> 'зкр':U
     1030     then do :
     1031       message "Выберите закрытую смену!" view-as alert-box .
     1032       return no-apply .
     1033     end .
     1034     create tt-shift-1 .
     1035     assign
     1036       tt-shift-1.shift-date = buf_shift-obj.shift-date
     1037       tt-shift-1.shift-num  = buf_shift-obj.shift-num
     1038       tt-shift-1.shift-name = buf_shift-obj.shift-name
     1039       num-rvs = 1
     1040     .
     1041     for each prev_shift-obj no-lock where prev_shift-obj.obj-type = p-obj-type
     1042                                       and prev_shift-obj.obj-code = p-obj-code
     1043                                       and prev_shift-obj.status_  = 'зкр':U
     1044                                       and ( prev_shift-obj.shift-date < buf_shift-obj.shift-date
     1045                                         or prev_shift-obj.shift-date = buf_shift-obj.shift-date
     1046                                           and prev_shift-obj.shift-num  < buf_shift-obj.shift-num
     1047                                       )
     1048                                       by prev_shift-obj.fact-order desc
     1049     :
     1050       create tt-shift-1 .
     1051       assign
     1052         tt-shift-1.shift-date = prev_shift-obj.shift-date
     1053         tt-shift-1.shift-num  = prev_shift-obj.shift-num
     1054         tt-shift-1.shift-name = prev_shift-obj.shift-name
     1055         num-rvs = num-rvs + 1
     1056       .
     1057       if num-rvs = 7
     1058       then leave .
     1059     end .
     1060     empty temp-table tt-shift .
     1061     for each tt-shift-1 :
     1062       create tt-shift .
     1063       buffer-copy tt-shift-1 to tt-shift .
     1064     end .
     1065     run find-old-pl-gds .
     1066     OPEN QUERY br-pl-gds FOR EACH tt-pl-gds by tt-pl-gds.loc1 .    OPEN QUERY br-shift FOR EACH tt-shift by tt-shift.shift-date desc by tt-shift.shift-num desc .
     1067   END.
     1068   ON CHOOSE OF b-shift-2 IN FRAME Dialog-Frame
     1069   DO:
     1070     define variable ii as integer no-undo .
     1071     assign rs-shift = 2 .
     1072     display rs-shift with frame Dialog-Frame .
     1073     run str/sht-all.w
     1074                     ( input parparentproc
     1075                      ,input p-obj-type
     1076                      ,input p-obj-code
     1077                      ,input "b-sel,b-mark"
     1078                      ,input "obj":U
     1079                      ,input p-obj-type
     1080                      ,input p-obj-code
     1081                      ,input ""
     1082                      ,input-output shift-recid-list ).
     1083     if error-status:error
     1084     then do :
     1085       message
     1086         vss-workfile vss-revision vss-description skip
     1087         "Ошибка при выборе смены"  skip
     1088         error-status :get-message( 1 ) skip
     1089         return-value skip
     1090         view-as alert-box error
     1091       .
     1092       return no-apply.
     1093     end.
     1094     if shift-recid-list =  "":U
     1095     then do :
     1096       return no-apply .
     1097     end.
     1098     empty temp-table tt-shift-2 .
     1099     do ii = 1 to num-entries(shift-recid-list) :
     1100       find first buf_shift-obj no-lock where recid(buf_shift-obj) = integer(entry(ii, shift-recid-list)) no-error .
     1101       if available buf_shift-obj
     1102       and buf_shift-obj.status_ = 'зкр':U
     1103       then do :
     1104         create tt-shift-2 .
     1105         assign
     1106           tt-shift-2.shift-date = buf_shift-obj.shift-date
     1107           tt-shift-2.shift-num  = buf_shift-obj.shift-num
     1108           tt-shift-2.shift-name = buf_shift-obj.shift-name
     1109         .
     1110       end .
     1111       if available buf_shift-obj
     1112       and not buf_shift-obj.status_ = 'зкр':U
     1113       then do :
     1114         message "Выберите закрытую смену!" view-as alert-box .
     1115       end .
     1116     end .
     1117     empty temp-table tt-shift .
     1118     for each tt-shift-2 :
     1119       create tt-shift .
     1120       buffer-copy tt-shift-2 to tt-shift .
     1121     end .
     1122     run find-old-pl-gds .
     1123     OPEN QUERY br-pl-gds FOR EACH tt-pl-gds by tt-pl-gds.loc1 .    OPEN QUERY br-shift FOR EACH tt-shift by tt-shift.shift-date desc by tt-shift.shift-num desc .
     1124   END.
     1125   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
     1126   DO:
     1127     empty temp-table tt-shift .
     1128     case rs-shift :
     1129       when 1
     1130       then do :
     1131         find first tt-shift-1 no-error .
     1132         if not available tt-shift-1
     1133         then do :
     1134           message "Не выбрана ни одна смена!" view-as alert-box .
     1135           return no-apply .
     1136         end .
     1137         for each tt-shift-1 :
     1138           create tt-shift .
     1139           buffer-copy tt-shift-1 to tt-shift .
     1140         end .
     1141       end .
     1142       when 2
     1143       then do :
     1144         find first tt-shift-2 no-error .
     1145         if not available tt-shift-2
     1146         then do :
     1147           message "Не выбрана ни одна смена!" view-as alert-box .
     1148           return no-apply .
     1149         end .
     1150         for each tt-shift-2 :
     1151           create tt-shift .
     1152           buffer-copy tt-shift-2 to tt-shift .
     1153         end .
     1154       end .
     1155     end case .
     1156     find first tt-pl-gds no-error .
     1157     if not available tt-pl-gds
     1158     then do :
     1159       message "Список товаров/резервуаров пуст!" view-as alert-box .
     1160       return no-apply .
     1161     end .
     1162     run rep/r-shift-periods.p (input parparentproc,
     1163                                input table tt-shift,
     1164                                input table tt-pl-gds)
     1165                                .
     1166   END.
     1167   ON VALUE-CHANGED OF rs-goods IN FRAME Dialog-Frame
     1168   DO:
     1169     define variable ii as integer no-undo .
     1170     define variable v-value as character no-undo .
     1171     define variable v-type as character no-undo .
     1172     define variable v-ok as logical no-undo .
     1173     assign rs-goods .
     1174     assign rs-place = 1 .
     1175     display rs-place with frame Dialog-Frame .
     1176     if rs-goods = 1
     1177     then do :
     1178       run init-pl-gds .
     1179     end .
     1180     if rs-goods = 2
     1181     then do :
     1182       empty temp-table tt-pl-gds .
     1183       do ii = 1 to num-entries(gds-recid-list):
     1184         find first buf_goods where recid(buf_goods) = integer(entry(ii, gds-recid-list)) no-lock no-error.
     1185         if available buf_goods
     1186         then do:
     1187           for each buf_pl-gds no-lock where buf_pl-gds.gds-code = buf_goods.gds-code
     1188                                         and buf_pl-gds.obj-type = p-obj-type
     1189                                         and buf_pl-gds.obj-code = p-obj-code,
     1190             first buf_place where buf_place.pl-code = buf_pl-gds.pl-code
     1191           :
     1192                       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     1193               (input  buf_pl-gds.gds-code
     1194               ,input  'fuel-type':U
     1195               ,output v-value
     1196               ,output v-type) no-error.
     1197             if v-value = "lgas"
     1198             or v-value = "metan"
     1199             or v-value = "propan"
     1200             then next .
     1201             run placelib_get-attr  ( input "place-com-tanks"
     1202                                     ,input buf_place.obj-code
     1203                                     ,input buf_place.obj-type
     1204                                     ,input buf_place.pl-code
     1205                                     ,output v-value
     1206                                     ,output v-ok      ) no-error.
     1207             if v-ok
     1208             and v-value > ""
     1209             then do :
     1210               run placelib_get-attr  ( input "place-is-main"
     1211                                       ,input buf_place.obj-code
     1212                                       ,input buf_place.obj-type
     1213                                       ,input buf_place.pl-code
     1214                                       ,output v-value
     1215                                       ,output v-ok      ) no-error.
     1216               if v-ok
     1217               and v-value > ""
     1218               and logical(v-value)
     1219               then do :
     1220               end .
     1221               else do :
     1222                 next .
     1223               end .
     1224             end .
     1225             create tt-pl-gds .
     1226             assign
     1227               tt-pl-gds.pl-code  = buf_place.pl-code
     1228               tt-pl-gds.loc1     = buf_place.loc1
     1229               tt-pl-gds.gds-code = buf_goods.gds-code
     1230               tt-pl-gds.gds-name = buf_goods.gds-name
     1231             .
     1232           end .
     1233         end.
     1234       end.
     1235       run find-old-pl-gds .
     1236     end .
     1237     OPEN QUERY br-pl-gds FOR EACH tt-pl-gds by tt-pl-gds.loc1 .    OPEN QUERY br-shift FOR EACH tt-shift by tt-shift.shift-date desc by tt-shift.shift-num desc .
     1238   END.
     1239   ON VALUE-CHANGED OF rs-place IN FRAME Dialog-Frame
     1240   DO:
     1241     define variable ii as integer no-undo .
     1242     define variable v-value as character no-undo .
     1243     define variable v-type as character no-undo .
     1244     define variable v-ok as logical no-undo .
     1245     assign rs-place .
     1246     if rs-place = 1
     1247     then do :
     1248       empty temp-table tt-pl-gds .
     1249       do ii = 1 to num-entries(gds-recid-list) :
     1250         find first buf_goods no-lock where recid(buf_goods) = integer(entry(ii, gds-recid-list)) no-error .
     1251         if available buf_goods
     1252         then do :
     1253           for each buf_pl-gds no-lock where buf_pl-gds.gds-code = buf_goods.gds-code
     1254                                         and buf_pl-gds.obj-type = p-obj-type
     1255                                         and buf_pl-gds.obj-code = p-obj-code,
     1256             first buf_place where buf_place.pl-code = buf_pl-gds.pl-code
     1257           :
     1258                       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     1259               (input  buf_pl-gds.gds-code
     1260               ,input  'fuel-type':U
     1261               ,output v-value
     1262               ,output v-type) no-error.
     1263             if v-value = "lgas"
     1264             or v-value = "metan"
     1265             or v-value = "propan"
     1266             then next .
     1267             run placelib_get-attr  ( input "place-com-tanks"
     1268                                     ,input buf_place.obj-code
     1269                                     ,input buf_place.obj-type
     1270                                     ,input buf_place.pl-code
     1271                                     ,output v-value
     1272                                     ,output v-ok      ) no-error.
     1273             if v-ok
     1274             and v-value > ""
     1275             then do :
     1276               run placelib_get-attr  ( input "place-is-main"
     1277                                       ,input buf_place.obj-code
     1278                                       ,input buf_place.obj-type
     1279                                       ,input buf_place.pl-code
     1280                                       ,output v-value
     1281                                       ,output v-ok      ) no-error.
     1282               if v-ok
     1283               and v-value > ""
     1284               and logical(v-value)
     1285               then do :
     1286               end .
     1287               else do :
     1288                 next .
     1289               end .
     1290             end .
     1291             create tt-pl-gds .
     1292             assign
     1293               tt-pl-gds.pl-code  = buf_place.pl-code
     1294               tt-pl-gds.loc1     = buf_place.loc1
     1295               tt-pl-gds.gds-code = buf_goods.gds-code
     1296               tt-pl-gds.gds-name = buf_goods.gds-name
     1297             .
     1298           end .
     1299         end .
     1300       end .
     1301       assign
     1302         pl-recid-list-full = pl-recid-list
     1303         pl-recid-list = ""
     1304       .
     1305       for each tt-pl-gds no-lock break by tt-pl-gds.pl-code :
     1306         if first-of(tt-pl-gds.pl-code)
     1307         then do :
     1308           for first place where place.pl-code = tt-pl-gds.pl-code :
     1309             assign pl-recid-list = pl-recid-list + string(recid(place)) + "," .
     1310           end .
     1311         end .
     1312       end .
     1313       assign pl-recid-list = trim(pl-recid-list, ",") .
     1314     end .
     1315     if rs-place = 2
     1316     then do :
     1317       empty temp-table tt-place .
     1318       do ii = 1 to num-entries(pl-recid-list) :
     1319         find first buf_place no-lock where recid(buf_place) = integer(entry(ii, pl-recid-list)) no-error .
     1320         if available buf_place
     1321         then do :
     1322           create tt-place .
     1323           assign tt-place.pl-code = buf_place.pl-code .
     1324         end .
     1325       end .
     1326       for each tt-pl-gds :
     1327         find first tt-place where tt-place.pl-code = tt-pl-gds.pl-code no-error .
     1328         if not available tt-place
     1329         then delete tt-pl-gds .
     1330       end .
     1331     end .
     1332     run find-old-pl-gds .
     1333     OPEN QUERY br-pl-gds FOR EACH tt-pl-gds by tt-pl-gds.loc1 .    OPEN QUERY br-shift FOR EACH tt-shift by tt-shift.shift-date desc by tt-shift.shift-num desc .
     1334   END.
     1335   ON VALUE-CHANGED OF rs-shift IN FRAME Dialog-Frame
     1336   DO:
     1337     assign rs-shift .
     1338     if rs-shift = 1
     1339     then do :
     1340       empty temp-table tt-shift .
     1341       for each tt-shift-1 :
     1342         create tt-shift .
     1343         buffer-copy tt-shift-1 to tt-shift .
     1344       end .
     1345     end .
     1346     if rs-shift = 2
     1347     then do :
     1348       empty temp-table tt-shift .
     1349       for each tt-shift-2 :
     1350         create tt-shift .
     1351         buffer-copy tt-shift-2 to tt-shift .
     1352       end .
     1353     end .
     1354   END.
     1355   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1356   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1357   MAIN-BLOCK:
     1358   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1359      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1360     run init_ .
     1361     RUN enable_UI.
     1362     WAIT-FOR GO OF FRAME Dialog-Frame.
     1363   END.
     1364   RUN disable_UI.
     1365   PROCEDURE disable_UI :
     1366     HIDE FRAME Dialog-Frame.
     1367   END PROCEDURE.
     1368   PROCEDURE enable_UI :
     1369     DISPLAY rs-shift rs-obj rs-goods rs-place
     1370         WITH FRAME Dialog-Frame.
     1371     ENABLE RECT-1 RECT-2 RECT-3 RECT-4 Btn_OK Btn_Cancel br-shift rs-shift
     1372            b-shift-1 b-shift-2 rs-obj br-pl-gds rs-goods b-goods rs-place b-place
     1373         WITH FRAME Dialog-Frame.
     1374     VIEW FRAME Dialog-Frame.
     1375     OPEN QUERY br-pl-gds FOR EACH tt-pl-gds by tt-pl-gds.loc1 .    OPEN QUERY br-shift FOR EACH tt-shift by tt-shift.shift-date desc by tt-shift.shift-num desc .
     1376   END PROCEDURE.
     1377   PROCEDURE find-old-pl-gds :
     1378     define variable ii as integer no-undo .
     1379     define buffer buf_shift-period for ub.shift-period .
     1380     define buffer buf_goods for ub.goods .
     1381     define buffer buf_place for ub.place .
     1382     for each tt-shift :
     1383       for each buf_shift-period no-lock where buf_shift-period.obj-type = p-obj-type
     1384                                           and buf_shift-period.obj-code = p-obj-code
     1385                                           and buf_shift-period.shift-date = tt-shift.shift-date
     1386                                           and buf_shift-period.shift-num  = tt-shift.shift-num
     1387       :
     1388         find first tt-pl-gds where tt-pl-gds.gds-code = buf_shift-period.gds-code
     1389                                and tt-pl-gds.pl-code  = buf_shift-period.pl-code
     1390                                no-error .
     1391         if available tt-pl-gds then next .
     1392         do ii = 1 to num-entries(gds-recid-list-full):
     1393           find first buf_goods where recid(buf_goods) = integer(entry(ii, gds-recid-list-full)) no-lock no-error.
     1394           if available buf_goods
     1395           and buf_goods.gds-code = buf_shift-period.gds-code
     1396           then do :
     1397             create tt-pl-gds .
     1398             assign
     1399               tt-pl-gds.gds-code = buf_goods.gds-code
     1400               tt-pl-gds.gds-name = buf_goods.gds-name
     1401             .
     1402             for first buf_place no-lock where buf_place.obj-type = p-obj-type
     1403                                           and buf_place.obj-code = p-obj-code
     1404                                           and buf_place.pl-code  = buf_shift-period.pl-code
     1405             :
     1406               assign
     1407                 tt-pl-gds.pl-code = buf_place.pl-code
     1408                 tt-pl-gds.loc1    = buf_place.loc1
     1409               .
     1410             end .
     1411           end .
     1412         end .
     1413         find first tt-pl-gds where tt-pl-gds.gds-code = buf_shift-period.gds-code
     1414                                and tt-pl-gds.pl-code  = buf_shift-period.pl-code
     1415                                no-error .
     1416         if available tt-pl-gds then next .
     1417         do ii = 1 to num-entries(pl-recid-list-full):
     1418           find first buf_place where recid(buf_place) = integer(entry(ii, pl-recid-list-full)) no-lock no-error.
     1419           if available buf_place
     1420           and buf_place.obj-type = buf_shift-period.obj-type
     1421           and buf_place.obj-code = buf_shift-period.obj-code
     1422           and buf_place.pl-code  = buf_shift-period.pl-code
     1423           then do :
     1424             create tt-pl-gds .
     1425             assign
     1426               tt-pl-gds.pl-code = buf_place.pl-code
     1427               tt-pl-gds.loc1    = buf_place.loc1
     1428             .
     1429             for first buf_goods no-lock where buf_goods.gds-code  = buf_shift-period.gds-code
     1430             :
     1431               assign
     1432                 tt-pl-gds.gds-code = buf_goods.gds-code
     1433                 tt-pl-gds.gds-name = buf_goods.gds-name
     1434               .
     1435             end .
     1436           end .
     1437         end .
     1438       end .
     1439     end .
     1440   END PROCEDURE.
     1441   PROCEDURE init-pl-gds :
     1442     define variable v-value as character no-undo .
     1443     define variable v-type as character no-undo .
     1444     define variable v-ok as logical no-undo .
     1445     define buffer place for ub.place .
     1446     define buffer goods for ub.goods .
     1447     empty temp-table tt-pl-gds .
     1448     assign
     1449       pl-recid-list = ""
     1450       gds-recid-list = ""
     1451     .
     1452     for each buf_place no-lock where buf_place.obj-type = p-obj-type
     1453                                  and buf_place.obj-code = p-obj-code
     1454     :
     1455       find first buf_pl-gds no-lock where buf_pl-gds.pl-code = buf_place.pl-code no-error .
     1456       if not available buf_pl-gds
     1457       then do :
     1458         assign pl-recid-list-full = pl-recid-list-full + string(recid(buf_place)) + "," .
     1459         next .
     1460       end .
     1461           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     1462         (input  buf_pl-gds.gds-code
     1463         ,input  'fuel-type':U
     1464         ,output v-value
     1465         ,output v-type) no-error.
     1466       if v-value = "lgas"
     1467       or v-value = "metan"
     1468       or v-value = "propan"
     1469       then next .
     1470       run placelib_get-attr  ( input "place-com-tanks"
     1471                               ,input buf_place.obj-code
     1472                               ,input buf_place.obj-type
     1473                               ,input buf_place.pl-code
     1474                               ,output v-value
     1475                               ,output v-ok      ) no-error.
     1476       if v-ok
     1477       and v-value > ""
     1478       then do :
     1479         run placelib_get-attr  ( input "place-is-main"
     1480                                 ,input buf_place.obj-code
     1481                                 ,input buf_place.obj-type
     1482                                 ,input buf_place.pl-code
     1483                                 ,output v-value
     1484                                 ,output v-ok      ) no-error.
     1485         if v-ok
     1486         and v-value > ""
     1487         and logical(v-value)
     1488         then do :
     1489         end .
     1490         else do :
     1491           next .
     1492         end .
     1493       end .
     1494       assign pl-recid-list-full = pl-recid-list-full + string(recid(buf_place)) + "," .
     1495       create tt-pl-gds .
     1496       assign
     1497         tt-pl-gds.pl-code  = buf_place.pl-code
     1498         tt-pl-gds.loc1     = buf_place.loc1
     1499         tt-pl-gds.gds-code = buf_pl-gds.gds-code
     1500       .
     1501       for first buf_goods no-lock where buf_goods.gds-code = buf_pl-gds.gds-code :
     1502         assign tt-pl-gds.gds-name = buf_goods.gds-name .
     1503       end .
     1504     end .
     1505     assign pl-recid-list-full = trim(pl-recid-list-full, ",") .
     1506     for each tt-pl-gds no-lock break by tt-pl-gds.pl-code :
     1507       if first-of(tt-pl-gds.pl-code)
     1508       then do :
     1509         for first place where place.pl-code = tt-pl-gds.pl-code :
     1510           assign pl-recid-list = pl-recid-list + string(recid(place)) + "," .
     1511         end .
     1512       end .
     1513     end .
     1514     assign pl-recid-list = trim(pl-recid-list, ",") .
     1515     for each tt-pl-gds no-lock break by tt-pl-gds.gds-code :
     1516       if first-of(tt-pl-gds.gds-code)
     1517       then do :
     1518         for first goods where goods.gds-code = tt-pl-gds.gds-code :
     1519           assign gds-recid-list = gds-recid-list + string(recid(goods)) + "," .
     1520         end .
     1521       end .
     1522     end .
     1523     assign
     1524       gds-recid-list = trim(gds-recid-list, ",")
     1525       gds-recid-list-full = gds-recid-list
     1526     .
     1527     run find-old-pl-gds .
     1528   END PROCEDURE.
     1529   PROCEDURE init_ :
     1530     empty temp-table tt-shift-1 .
     1531     empty temp-table tt-shift-2 .
     1532     find last buf_shift-obj no-lock where buf_shift-obj.obj-type = p-obj-type
     1533                                       and buf_shift-obj.obj-code = p-obj-code
     1534                                       and buf_shift-obj.status_  = 'зкр':U
     1535                                       use-index stts
     1536                                       no-error.
     1537     if not available buf_shift-obj
     1538     then do :
     1539       message "Нет закрытой смены на объекте!" view-as alert-box .
     1540       apply "choose" to Btn_Cancel in frame Dialog-Frame .
     1541     end .
     1542     create tt-shift-1 .
     1543     assign
     1544       tt-shift-1.shift-date = buf_shift-obj.shift-date
     1545       tt-shift-1.shift-num  = buf_shift-obj.shift-num
     1546       tt-shift-1.shift-name = buf_shift-obj.shift-name
     1547       choosed-shift-recid = recid(buf_shift-obj)
     1548       num-rvs = 1
     1549     .
     1550     for each prev_shift-obj no-lock where prev_shift-obj.obj-type = p-obj-type
     1551                                       and prev_shift-obj.obj-code = p-obj-code
     1552                                       and prev_shift-obj.status_  = 'зкр':U
     1553                                       and ( prev_shift-obj.shift-date < buf_shift-obj.shift-date
     1554                                         or prev_shift-obj.shift-date = buf_shift-obj.shift-date
     1555                                           and prev_shift-obj.shift-num  < buf_shift-obj.shift-num
     1556                                       )
     1557                                       by prev_shift-obj.fact-order desc
     1558     :
     1559       create tt-shift-1 .
     1560       assign
     1561         tt-shift-1.shift-date = prev_shift-obj.shift-date
     1562         tt-shift-1.shift-num  = prev_shift-obj.shift-num
     1563         tt-shift-1.shift-name = prev_shift-obj.shift-name
     1564         num-rvs = num-rvs + 1
     1565       .
     1566       if num-rvs = 7
     1567       then leave .
     1568     end .
     1569     for each tt-shift-1 :
     1570       create tt-shift .
     1571       buffer-copy tt-shift-1 to tt-shift .
     1572     end .
     1573     run init-pl-gds .
     1574   END PROCEDURE.
     1575   PROCEDURE select-gds :
     1576     define buffer goods for goods.
     1577     define buffer pl-gds for pl-gds.
     1578     define buffer place for place.
     1579     define variable vRecId        as recid     no-undo.
     1580     define variable vAnswer       as logical   no-undo.
     1581     define variable vI            as integer   no-undo.
     1582     define variable v-value as character no-undo .
     1583     define variable v-type as character no-undo .
     1584     define variable v-ok as logical no-undo .
     1585     run ref/gds-ref.p (
     1586                        input parparentproc
     1587                       ,input "b-mark,b-sel"
     1588                       ,input 'все':U
     1589                       ,input "only-np"
     1590                       ,input ?
     1591                       ,input ?
     1592                       ,input ?
     1593                       ,input ?
     1594                       ,input ?
     1595                       ,input p-obj-type
     1596                       ,input p-obj-code
     1597                       ,input ?
     1598                       ,output gds-recid-list).
     1599     if gds-recid-list = "" and can-find(first tt-pl-gds) then do:
     1600       message "Не было выбрано ни одного товара. Очистить список ранее выбранных товаров?"
     1601       view-as alert-box QUESTION buttons YES-NO update vAnswer.
     1602       if not vAnswer then return .
     1603     end.
     1604     empty temp-table tt-pl-gds .
     1605     do vI = 1 to num-entries(gds-recid-list):
     1606       vRecId = integer(entry(vI, gds-recid-list)).
     1607       find first goods where recid(goods) = vRecId no-lock no-error.
     1608       if available goods
     1609       then do:
     1610         for each pl-gds no-lock where pl-gds.gds-code = goods.gds-code
     1611                                   and pl-gds.obj-type = p-obj-type
     1612                                   and pl-gds.obj-code = p-obj-code,
     1613           first place where place.pl-code = pl-gds.pl-code
     1614         :
     1615                   if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     1616             (input  pl-gds.gds-code
     1617             ,input  'fuel-type':U
     1618             ,output v-value
     1619             ,output v-type) no-error.
     1620           if v-value = "lgas"
     1621           or v-value = "metan"
     1622           or v-value = "propan"
     1623           then next .
     1624           run placelib_get-attr  ( input "place-com-tanks"
     1625                                   ,input place.obj-code
     1626                                   ,input place.obj-type
     1627                                   ,input place.pl-code
     1628                                   ,output v-value
     1629                                   ,output v-ok      ) no-error.
     1630           if v-ok
     1631           and v-value > ""
     1632           then do :
     1633             run placelib_get-attr  ( input "place-is-main"
     1634                                     ,input place.obj-code
     1635                                     ,input place.obj-type
     1636                                     ,input place.pl-code
     1637                                     ,output v-value
     1638                                     ,output v-ok      ) no-error.
     1639             if v-ok
     1640             and v-value > ""
     1641             and logical(v-value)
     1642             then do :
     1643             end .
     1644             else do :
     1645               next .
     1646             end .
     1647           end .
     1648           create tt-pl-gds .
     1649           assign
     1650             tt-pl-gds.pl-code  = place.pl-code
     1651             tt-pl-gds.loc1     = place.loc1
     1652             tt-pl-gds.gds-code = goods.gds-code
     1653             tt-pl-gds.gds-name = goods.gds-name
     1654           .
     1655         end .
     1656       end.
     1657     end.
     1658     assign pl-recid-list = "" .
     1659     for each tt-pl-gds no-lock break by tt-pl-gds.pl-code :
     1660       if first-of(tt-pl-gds.pl-code)
     1661       then do :
     1662         for first place where place.pl-code = tt-pl-gds.pl-code :
     1663           assign pl-recid-list = pl-recid-list + string(recid(place)) + "," .
     1664         end .
     1665       end .
     1666     end .
     1667     assign
     1668       pl-recid-list = trim(pl-recid-list, ",")
     1669       pl-recid-list-full = pl-recid-list
     1670     .
     1671     assign
     1672       gds-recid-list-full = gds-recid-list
     1673       gds-recid-list = ""
     1674     .
     1675     for each tt-pl-gds no-lock break by tt-pl-gds.gds-code :
     1676       if first-of(tt-pl-gds.gds-code)
     1677       then do :
     1678         for first goods where goods.gds-code = tt-pl-gds.gds-code :
     1679           assign gds-recid-list = gds-recid-list + string(recid(goods)) + "," .
     1680         end .
     1681       end .
     1682     end .
     1683     assign gds-recid-list = trim(gds-recid-list, ",") .
     1684     run find-old-pl-gds .
     1685   END PROCEDURE.
     1686   function shift-name returns character
     1687     ( input p-shift-num like ub.shift-obj.shift-num, input p-shift-name  like ub.shift-obj.shift-name ):
     1688     define variable result as character no-undo.
     1689     result = string(p-shift-num, ">9") + " (" + p-shift-name + ")" .
     1690     return result.
     1691   end function.
