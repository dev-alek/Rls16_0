      685   procedure placelib_write-attr:
      686   define input  parameter p-code     like ub.place-attr.attr-code .
      687   define input  parameter p-obj-code like ub.place-attr.obj-code .
      688   define input  parameter p-obj-type like ub.place-attr.obj-type .
      689   define input  parameter p-pl-code  like ub.place-attr.pl-code .
      690   define input  parameter p-value    like ub.place-attr.attr-value .
      691   define output parameter p-ok       as logical.
      692   define buffer buf_place-attr for ub.place-attr .
      693     do on error undo, return error return-value :
      694        p-ok = false.
      695        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      696                                                   and buf_place-attr.obj-code    = p-obj-code
      697                                                   and buf_place-attr.obj-type    = p-obj-type
      698                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      699        if not available buf_place-attr then do :
      700           create buf_place-attr.
      701           assign
      702             buf_place-attr.attr-code   = p-code
      703             buf_place-attr.attr-value  = p-value
      704             buf_place-attr.obj-code    = p-obj-code
      705             buf_place-attr.obj-type    = p-obj-type
      706             buf_place-attr.pl-code     = p-pl-code
      707           .
      708           p-ok = true.
      709        end.
      710        else do:
      711           buf_place-attr.attr-value  = p-value .
      712           p-ok = true.
      713        end.
      714     end.
      715   end.
      716   procedure placelib_get-attr:
      717   define input  parameter  p-code     like ub.place-attr.attr-code .
      718   define input  parameter  p-obj-code like ub.place-attr.obj-code .
      719   define input  parameter  p-obj-type like ub.place-attr.obj-type .
      720   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
      721   define output parameter  p-value    like ub.place-attr.attr-value .
      722   define output parameter  p-ok       as logical.
      723   define buffer buf_place-attr for ub.place-attr .
      724     do on error undo, return error return-value :
      725        p-ok = false.
      726        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
      727                                                   and buf_place-attr.obj-code    = p-obj-code
      728                                                   and buf_place-attr.obj-type    = p-obj-type
      729                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      730        if available buf_place-attr then do :
      731          p-value = buf_place-attr.attr-value.
      732          p-ok = true.
      733        end.
      734        else do :
      735          p-ok = false.
      736        end.
      737     end.
      738   end.
      739   procedure placelib_del-attr:
      740   define input parameter  p-code     like ub.place-attr.attr-code .
      741   define input parameter  p-obj-code like ub.place-attr.obj-code .
      742   define input parameter  p-obj-type like ub.place-attr.obj-type .
      743   define input parameter  p-pl-code  like ub.place-attr.pl-code .
      744   define input parameter  p-value    like ub.place-attr.attr-value .
      745   define output parameter p-ok       as logical.
      746   define buffer buf_place-attr for ub.place-attr .
      747     do on error undo, return error return-value :
      748        p-ok = false.
      749        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      750                                                   and buf_place-attr.obj-code    = p-obj-code
      751                                                   and buf_place-attr.obj-type    = p-obj-type
      752                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      753        if available buf_place-attr then do :
      754           delete buf_place-attr.
      755           p-ok = true.
      756        end.
      757     end.
      758   end.
      759   define variable num-rvs as integer no-undo init 0 .
