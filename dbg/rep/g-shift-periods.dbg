      798        LABEL "Отмена"
      799        SIZE 15 BY 1.14
      800        BGCOLOR 8 .
      801   DEFINE BUTTON Btn_OK
      802        LABEL "Выполнить"
      803        SIZE 15 BY 1.14
      804        BGCOLOR 8 .
      805   DEFINE VARIABLE rs-goods AS INTEGER INITIAL 1
      806        VIEW-AS RADIO-SET VERTICAL
      807        RADIO-BUTTONS
      808             "Все", 1,
      809   "Выборочно", 2
      810        SIZE 15 BY 2.14 NO-UNDO.
