       28   define variable vss-revision    as character no-undo init "$Revision:$":U .
       29   define variable vss-author      as character no-undo init "$Author:$":U .
       30   define variable vss-date        as character no-undo init "$Date:$":U .
       31   define variable vss-workfile    as character no-undo init "$Workfile: r-shift-periods.p $":U .
       32   define variable vss-archive     as character no-undo init "$Archive: rep/r-shift-periods.p $":U .
       33   define variable vss-description as character no-undo init "Отчет Контроль плотности НП".
       34   procedure vss-get-info :
       35     define output parameter p-vss-revision    like vss-revision    no-undo .
       36     define output parameter p-vss-author      like vss-author      no-undo .
       37     define output parameter p-vss-date        like vss-date        no-undo .
       38     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       39     define output parameter p-vss-archive     like vss-archive     no-undo .
       40     define output parameter p-vss-description like vss-description no-undo .
       41     assign
       42       p-vss-revision    = vss-revision
       43       p-vss-author      = vss-author
       44       p-vss-date        = vss-date
       45       p-vss-workfile    = vss-workfile
       46       p-vss-archive     = vss-archive
       47       p-vss-description = vss-description
       48     .
       49   end procedure.
       50   procedure vss-get-parameters :
       51     define output parameter p-vss-parameters as character no-undo .
       52   end procedure.
       53   define new global shared variable g#vssrevis-logger as handle    no-undo .
       54   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       55   define variable v-vssrevis-logger                   as handle    no-undo .
       56   procedure vss-logevent :
       57     define input  parameter p-extra-paramters as character no-undo .
       58     define variable v-vssrevis-parameters as character no-undo .
       59     do
       60     on error undo, return error return-value
       61     :
       62       if  valid-handle(v-vssrevis-logger)
       63       and v-vssrevis-logger :get-signature("logevent") <> ""
       64       then do:
       65         run vss-get-parameters in this-procedure
       66           (output v-vssrevis-parameters
       67           ).
       68         run logevent in v-vssrevis-logger
       69           (input vss-workfile
       70           ,input vss-revision
       71           ,input v-vssrevis-parameters
       72           ,input p-extra-paramters
       73           ).
       74       end.
       75     end.
       76   end procedure.
       77   assign
       78     v-vssrevis-logger = g#vssrevis-logger
       79   .
       80   if  valid-handle(v-vssrevis-logger)
       81   and v-vssrevis-logger :get-signature("logevent") <> ""
       82   then do:
       83     assign
       84       v-vssrevis-logevent = true
       85     .
       86     run vss-logevent in this-procedure (input vss-description) .
       87   end.
