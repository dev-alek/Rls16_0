      306   define  stream PrnLibStream.
      307   procedure prn-lib-prn-file :
      308     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      309     define input parameter p-DIsabledoptions as integer no-undo .
      310     define variable v-report-name as character no-undo .
      311     define variable v-user-action as character no-undo .
      312     define variable v-printed     as logical   no-undo .
      313     define variable v-exist       as logical   no-undo .
      314     do
      315       on error undo, return error
      316       :
      317       run prn-lib-get-report-name  in this-procedure (
      318         input parParentProc
      319         ,output v-report-name
      320         ).
      321   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      322   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      323     (input  v-report-name
      324     ,input  2
      325     ,output v-exist
      326     )  .
      327       if NOT v-exist then
      328       DO:
      329         Message
      330           "Нет заданий на печать ! "
      331           view-as alert-box .
      332         Return  .
      333       End.
      334       run gbl/prnfilen.w
      335         (input  ""
      336         ,input  p-DisabledOptions
      337         ,input  string(v-report-name )
      338         ,input  7
      339         ,output v-user-action
      340         ,output v-printed
      341         ) .
      342       if v-printed then
      343       do:
      344         return "YES" .
      345       end.
      346       else
      347       do:
      348         return "NO" .
      349       end.
      350     end.
      351   end procedure.
      352   procedure prn-lib-open-stream :
      353     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      354     define input parameter p-page-size    as integer no-undo .
      355     define input parameter p-is-stream    as logical no-undo .
      356     define input parameter p-append       as logical no-undo .
      357     define variable v-report-name as character no-undo .
      358     do
      359       on error undo, return error
      360       :
      361       run prn-lib-get-report-name  in this-procedure (
      362         input parParentProc
      363         ,output v-report-name
      364         ).
      365       if p-is-stream then
      366       do:
      367         if p-append then
      368         do:
      369           output stream PrnLibStream to value( v-report-name )
      370             page-size value(p-page-size) append .
      371         end.
      372         if not p-append then
      373         do:
      374           output stream PrnLibStream to value( v-report-name )
      375             page-size value(p-page-size) .
      376         end.
      377       end.
      378       if not p-is-stream then
      379       do:
      380         if p-append then
      381         do:
      382           output to value( v-report-name )
      383             page-size value(p-page-size) append .
      384         end.
      385         if not p-append then
      386         do:
      387           output to value( v-report-name )
      388             page-size value(p-page-size) .
      389         end.
      390       end.
      391     end.
      392   end procedure.
      393   procedure prn-lib-open-exp :
      394     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      395     define input parameter p-is-stream    as logical no-undo .
      396     define input parameter p-is-append    as logical no-undo .
      397     define output parameter p-ReportFileName as char init "report" no-undo.
      398     define output parameter p-process as logical no-undo .
      399     define variable glog as logical no-undo .
      400     do
      401       on error undo, return error
      402       :
      403       SYSTEM-DIALOG GET-FILE p-ReportFileName
      404         TITLE      "Укажите путь"
      405         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      406         ASK-OVERWRITE
      407         CREATE-TEST-FILE
      408         SAVE-AS
      409         USE-FILENAME
      410         DEFAULT-EXTENSION "txt"
      411         UPDATE glog
      412         .
      413       if not glog then  return.
      414       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      415       if p-is-stream then
      416       do:
      417         if p-is-append then
      418         do:
      419           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      420         end.
      421         else
      422         do:
      423           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      424         end.
      425       end.
      426       else
      427       do:
      428         if p-is-append then
      429         do:
      430           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      431         end.
      432         else
      433         do:
      434           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      435         end.
      436       end.
      437       p-process = yes.
      438     end.
      439   end procedure.
      440   procedure prn-lib-get-report-name :
      441     define input parameter parParentProc  as widget-handle no-undo.
      442     define output parameter p-report-name as character no-undo .
      443     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      444   end procedure.
      445   procedure prn-lib-reportviewer-report-name :
      446     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      447     define input parameter p-report-name-html as character no-undo .
      448     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      449   end procedure.
      450   procedure prn-lib-reportviewer :
      451     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      452     define input parameter p-report-name-html as character no-undo .
      453     define input parameter p-param        as character no-undo .
      454     define variable v-excel           as character no-undo init 'TRUE' .
      455     define variable v-value-character as character no-undo .
      456     define variable v-value-integer   as character no-undo .
      457     define variable v-value-date      as date      no-undo .
      458     define variable v-value-decimal   as decimal   no-undo .
      459     define variable rep-excel         as logical   no-undo .
      460     define variable excel-string      as character no-undo .
      461     define variable v-param-type      as character no-undo .
      462     define variable v-tth             as handle    no-undo .
      463     run adm/shattri.p (
      464       input "get":U
      465       ,input  ""
      466       ,input  0
      467       ,input  'report-glob':U
      468       ,input  'rep-excel':U
      469       ,output v-value-character
      470       ,output v-value-date
      471       ,output v-value-decimal
      472       ,output v-value-integer
      473       ,output rep-excel
      474       ,output v-param-type
      475       ,INPUT-OUTPUT table-handle v-tth
      476       )  .
      477     if rep-excel then v-excel = "TRUE" .
      478     else v-excel = "FALSE" .
      479     if p-param eq ""
      480     then
      481        p-param = "EXCEL:" + v-excel.
      482     else
      483        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      484     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      485   end procedure.
      486   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile: frmlib.i $ $Revision: aea5316774be, 0, rls $".
      487   FUNCTION Break-n-line RETURNS CHARACTER
      488     ( INPUT p-ost as char,
      489       INPUT p-lengths  as character,
      490       OUTPUT output-num-lines as integer
      491       ) :
      492   define variable ii as integer no-undo.
      493   define variable jj as integer no-undo.
      494   define variable linei as character no-undo extent 10.
      495   define variable line-length as integer no-undo extent 10.
      496   define variable num-line as integer no-undo .
      497   define variable v-line as character no-undo .
      498   do ii = 1 to MIN(num-entries(p-lengths), 10):
      499     assign
      500     line-length[ii] = integer(entry(ii, p-lengths))
      501     num-line = ii
      502     .
      503   end.
      504   do jj = 1 to num-line:
      505     if Length ( p-ost ) <= line-length[jj] then do:
      506       assign
      507       output-num-lines = jj
      508       v-line = v-line + (if jj = 1 then "":U else chr(4)) + p-ost
      509       .
      510       return v-line.
      511     end.
      512     assign
      513     ii = 1
      514     .
      515     if length( entry( ii, p-ost , chr(32)) ) > line-length[jj]
      516     then do:
      517       assign
      518       linei[jj] = substr( p-ost , 1 , line-length[jj] )
      519       p-ost = trim( substr( p-ost , line-length[jj] + 1 ) )
      520       .
      521     end.
      522     else do:
      523       DO WHILE length( linei[jj] + entry( ii, p-ost , chr(32)) ) < ( line-length[jj] + 1 ) :
      524         assign
      525         linei[jj] = linei[jj] + entry( ii, p-ost , chr(32)) + chr(32)
      526         ii = ii + 1
      527         .
      528         if length( entry( ii, p-ost, chr(32) ) ) > line-length[jj] then
      529         assign
      530         linei[jj] = linei[jj] + substr( p-ost , length( linei[jj] ) , line-length[jj] - length( linei[jj] ) + 1 )
      531         .
      532       END.
      533       assign
      534       p-ost = trim( substr( p-ost , length(linei[jj]) + 1  ))
      535       .
      536     end.
      537     assign
      538     v-line = v-line + (if jj = 1 then "":U else chr(4)) + linei[jj]
      539     .
      540     if p-ost = "":U then LEAVE.
      541   end.
      542   assign
      543   output-num-lines = jj.
      544   RETURN v-line.
      545   END FUNCTION.
      546   FUNCTION Center-Field RETURNS CHARACTER
      547     ( INPUT p-str as char,
      548       INPUT p-format as integer,
      549       INPUT p-Length as integer,
      550       INPUT p-fill as character
      551       ) :
      552   define variable v-str as character no-undo .
      553   define variable v-left as integer no-undo .
      554   define variable v-dop as integer no-undo .
      555   assign
      556   p-str = trim(p-str)
      557   .
      558   if p-str = "":U then return fill(p-fill, p-length).
      559   if length(p-str) >= p-format then
      560   p-str = substr(p-str, 1, p-format).
      561   else do:
      562     p-format = length(p-str).
      563   end.
      564   if p-format < p-length then do:
      565     assign
      566     v-left = (p-length - p-format )
      567     v-dop = (if v-left modulo 2 = 1
      568              then 1
      569              else 0)
      570     v-left = (if (v-left modulo 2 = 1)
      571              then (v-left - 1 ) / 2
      572              else v-left / 2)
      573     v-str =  fill(p-fill, v-left) +
      574              string(p-str, "X(":U + string(p-format) + ")":U) +
      575              fill(p-fill, v-left) + fill(p-fill, v-dop)
      576     .
      577     return v-str.
      578   end.
      579   else do:
      580     return string(p-str, "X(":U + string(p-length) + ")":U).
      581   end.
      582   END FUNCTION.
      583   FUNCTION Left-Field RETURNS CHARACTER
      584     ( INPUT p-str as char,
      585       INPUT p-format as integer,
      586       INPUT p-Length as integer,
      587       INPUT p-fill as character
      588       ) :
      589   define variable v-str as character no-undo .
      590   define variable v-left as integer no-undo .
      591   define variable v-dop as integer no-undo .
      592   assign
      593   p-str = trim(p-str)
      594   .
      595   if p-str = "":U then return fill(p-fill, p-length).
      596   if length(p-str) >= p-format then
      597   p-str = substr(p-str, 1, p-format).
      598   else do:
      599     p-format = length(p-str).
      600   end.
      601   if p-format < p-length then do:
      602     assign
      603     v-dop =  p-length - p-format
      604     v-str =  string(p-str, "X(":U + string(p-format) + ")":U) +
      605              fill(p-fill, v-dop)
      606     .
      607     return v-str.
      608   end.
      609   else do:
      610     return string(p-str, "X(":U + string(p-length) + ")":U).
      611   end.
      612   END FUNCTION.
      613   FUNCTION Sum-Rub-Kop-Digit RETURNS CHARACTER
      614     ( INPUT p-sum as decimal,
      615       INPUT p-rub-length as integer,
      616       INPUT p-kop-length as integer,
      617       INPUT p-fill as character,
      618       INPUT p-razr-delim as character,
      619       INPUT p-rub-str  as character,
      620       INPUT p-kop-str  as character
      621       ) :
      622   define variable v-str as character no-undo .
      623   define variable v-format as character no-undo .
      624   define variable v-dopi as integer no-undo .
      625   define variable v-dopi2 as integer no-undo .
      626   assign
      627   v-dopi = length(string(truncate(ABS(p-sum), 0)))
      628   v-dopi2 = truncate(v-dopi / 3, 0) - (if v-dopi modulo  3 = 0 then 1 else 0)
      629   .
      630   if v-dopi > p-rub-length or p-kop-length < 2 then return "?".
      631   assign
      632   v-format = (if p-sum < 0 then "-":U else "":U) + fill((">>>":U + p-razr-delim), v-dopi2) + ">>9":U
      633   v-dopi = length(trim(string(truncate(p-sum, 0), v-format)))
      634   .
      635   assign
      636   v-str = fill(p-fill, p-rub-length - v-dopi) +
      637           string(truncate(p-sum, 0), v-format) +
      638           p-rub-str +
      639           fill(p-fill, p-kop-length - 2) +
      640           string(truncate((ABS(p-sum) - ABS(truncate(p-sum, 0))), 2) * 100, "99":U) + p-kop-str
      641   .
      642   return v-str.
      643   END FUNCTION.
      644   FUNCTION Sum-Invalut-Digit RETURNS CHARACTER
      645     ( INPUT p-sum as decimal,
      646       INPUT p-sum-length as integer,
      647       INPUT p-curr-code as integer,
      648       INPUT p-fill as character,
      649       INPUT p-razr-delim as character
      650       ) :
      651   define variable v-str as character no-undo .
      652   define variable v-format as character no-undo .
      653   define variable v-dopi as integer no-undo .
      654   define variable v-dopi2 as integer no-undo .
      655   define variable v-curr-name as character no-undo .
      656   define buffer buf_currency for ub.currency.
      657   find first buf_currency no-lock where
      658             buf_currency.curr-code = p-curr-code no-error .
      659   if not avail buf_currency
      660   then v-curr-name = "неизвестная валюта".
      661   else
      662   assign
      663   v-curr-name = buf_currency.curr-name
      664   .
      665   assign
      666   v-dopi = length(string(truncate(ABS(p-sum), 0)))
      667   v-dopi2 = truncate(v-dopi / 3, 0) - (if v-dopi modulo  3 = 0 then 1 else 0)
      668   .
      669   if v-dopi > p-sum-length then return "?".
      670   assign
      671   v-format = (if p-sum < 0 then "-":U else "":U) + fill((">>>":U + p-razr-delim), v-dopi2) + ">>9.99":U
      672   v-dopi = length(trim(string(p-sum, v-format)))
      673   .
      674   assign
      675   v-str = "(":U + chr(32) + v-curr-name +  chr(32) + ")":U +
      676           fill(p-fill, p-sum-length - v-dopi - length(v-curr-name) - 4)  +
      677           trim(string(p-sum, v-format))
      678   .
      679   return v-str.
      680   END FUNCTION.
      681   FUNCTION Sum-in-Words-Without-Dec RETURNS CHARACTER
      682   (input v-sum as decimal
      683   ):
      684   define variable v-str as character no-undo .
      685   run gbl/num-rus.p ( input absolute( v-sum ) , output v-str).
      686   v-str = trim( caps( substring( v-str, 1, 1 ) ) ) + substring( v-str, 2 ).
      687   return v-str.
      688   END FUNCTION.
      689   FUNCTION Sum-in-Words-Invalut RETURNS CHARACTER
      690   (input p-sum as decimal
      691    ,input p-curr-code as integer
      692   ):
      693   define variable v-str as character no-undo .
      694   define variable Copeck as character no-undo.
      695   define variable Rouble as character no-undo.
      696   define variable v-Word as character no-undo.
      697   define variable ii as integer init 18 no-undo.
      698   define variable v-str-rubl as character no-undo .
      699   define variable v-kop as integer no-undo .
      700   define buffer buf_currency for ub.currency.
      701   assign
      702   v-Word = string( absolute( p-sum ) , "999999999999999.99" ).
      703   find first buf_currency no-lock where
      704             buf_currency.curr-code = p-curr-code no-error .
      705   if not available buf_currency then return chr(63).
      706   if decimal( substring(v-Word,1,ii - 3) ) <> 0 then do:
      707     CASE substring(v-Word, ii - 3,1):
      708       WHEN "1" THEN DO:
      709         if substring(v-Word, ii - 4,1) = "1" then
      710             Rouble = buf_currency.curr-name-five .
      711         else
      712             Rouble = buf_currency.curr-name-one .
      713       END.
      714       WHEN "2" OR WHEN "3" OR WHEN "4" THEN  DO:
      715         if substring(v-Word, ii - 4,1) = "1" then
      716            Rouble = buf_currency.curr-name-five .
      717            else
      718            Rouble = buf_currency.curr-name-three .
      719         END.
      720       WHEN "0" OR WHEN "5" OR WHEN "6" OR WHEN "7" OR WHEN "8" OR WHEN "9" THEN  DO:
      721          Rouble = buf_currency.curr-name-five .
      722       END.
      723     END CASE.
      724   end.
      725   CASE substring(v-Word, ii, 1):
      726     WHEN "1" THEN DO:
      727       if substring(v-Word, ii - 1, 1) = "1" then
      728           Copeck = buf_currency.part-name-five .
      729       else
      730           Copeck = buf_currency.part-name-one .
      731     END.
      732     WHEN "2" OR WHEN "3" OR WHEN "4" THEN DO:
      733       if substring(v-Word, ii - 1, 1) = "1" then
      734           Copeck = buf_currency.part-name-five .
      735       else
      736           Copeck = buf_currency.part-name-three .
      737     END.
      738     WHEN "0" OR WHEN "5" OR WHEN "6" OR WHEN "7" OR WHEN "8" OR WHEN "9" THEN DO:
      739       Copeck = buf_currency.part-name-five .
      740     END.
      741   END CASE.
      742   run gbl/num-rus.p ( input absolute( p-sum )
      743                , output v-str-rubl).
      744   assign
      745   v-kop = (absolute( p-sum ) - truncate(absolute(p-sum), 0)
      746           ) * 100
      747   .
      748   v-str = ( if p-Sum < 0 then "- " else "" ) +
      749               caps(substring(v-str-rubl, 1, 1)) +  substring(v-str-rubl, 2) + chr(32) + Rouble + chr(32) +
      750               string(v-kop, "99":U) + chr(32) + Copeck .
      751   return v-str.
      752   END FUNCTION.
      753   FUNCTION Sum-delim-with-defis RETURNS CHARACTER
      754   (input v-sum as decimal,
      755   input v-razr as integer
      756   ):
      757   define variable v-str as character no-undo .
      758   define variable v-dec-separ as character no-undo .
      759   case SESSION:NUMERIC-FORMAT:
      760     when "American":U then do:
      761       assign
      762       v-dec-separ = ".":U
      763       .
      764     end.
      765     when "European":U then do:
      766       assign
      767       v-dec-separ = ",":U
      768       .
      769     end.
      770   END CASE.
      771   assign
      772   v-str = replace(string(v-sum, fill(">":U, v-razr - 1) + "9.99"), v-dec-separ, "-":U)
      773   .
      774   return v-str.
      775   END FUNCTION.
      776   FUNCTION MonthNameRusGen RETURNS CHARACTER ( INPUT i-month AS INTEGER ) :
      777     DEFINE VARIABLE v-name AS CHARACTER NO-UNDO.
      778     RUN get-month-name-gen IN THIS-PROCEDURE ( INPUT i-month, OUTPUT v-name ) NO-ERROR.
      779     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-name ).
      780   END FUNCTION.
      781   PROCEDURE get-month-name-gen :
      782     DEFINE  INPUT PARAMETER p-month AS INTEGER   NO-UNDO.
      783     DEFINE OUTPUT PARAMETER p-name  AS CHARACTER NO-UNDO.
      784     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO INITIAL "Января,Февраля,Марта,Апреля,Мая,Июня,Июля,Августа,Сентября,Октября,Ноября,Декабря".
      785     DO ON ERROR UNDO, RETURN ERROR :
      786       ASSIGN p-name = ( IF p-month >= 1 AND p-month <= 12 THEN ENTRY( p-month, v-list ) ELSE ? ).
      787     END.
      788   END PROCEDURE.
      789   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      790   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      791   procedure paramls-clear :
      792     define buffer buf_temp-param for temp-param .
      793     do
      794     on error undo, return error return-value
      795     :
      796       for each buf_temp-param
      797       on error undo, return error
      798       :
      799         delete buf_temp-param .
      800       end.
      801     end.
      802   end procedure.
      803   procedure paramls-write :
      804     define input  parameter p-code     as character no-undo .
      805     define input  parameter p-sub-code as character no-undo .
      806     define input  parameter p-value    as character no-undo .
      807     define buffer buf_temp-param for temp-param .
      808     do
      809     on error undo, return error return-value
      810     :
      811       find first buf_temp-param
      812         where buf_temp-param.param-code     = p-code
      813           and buf_temp-param.param-sub-code = p-sub-code
      814         no-error .
      815       if not available buf_temp-param then do:
      816         create buf_temp-param .
      817         assign
      818           buf_temp-param.param-code     = p-code
      819           buf_temp-param.param-sub-code = p-sub-code
      820         .
      821       end.
      822       assign
      823         buf_temp-param.param-value = p-value
      824       .
      825     end.
      826   end procedure.
      827   procedure paramls-read :
      828     define input  parameter p-code          as character no-undo .
      829     define input  parameter p-sub-code      as character no-undo .
      830     define input  parameter p-default-value as character no-undo .
      831     define output parameter p-value         as character no-undo .
      832     define buffer buf_temp-param for temp-param .
      833     do
      834     on error undo, return error return-value
      835     :
      836       find first buf_temp-param
      837         where buf_temp-param.param-code     = p-code
      838           and buf_temp-param.param-sub-code = p-sub-code
      839         no-error .
      840       if available buf_temp-param then do:
      841         assign
      842           p-value = buf_temp-param.param-value
      843         .
      844       end.
      845       else do:
      846         assign
      847           p-value = p-default-value
      848         .
      849       end.
      850     end.
      851   end procedure.
      852   procedure paramls-append :
      853     define input  parameter p-code     as character no-undo .
      854     define input  parameter p-sub-code as character no-undo .
      855     define input  parameter p-value    as character no-undo .
      856     define buffer buf_temp-param for temp-param .
      857     do
      858     on error undo, return error return-value
      859     :
      860       find first buf_temp-param
      861            where buf_temp-param.param-code     = p-code
      862              and buf_temp-param.param-sub-code = p-sub-code
      863         no-error .
      864       if not available buf_temp-param then do:
      865         create buf_temp-param .
      866         assign
      867           buf_temp-param.param-code     = p-code
      868           buf_temp-param.param-sub-code = p-sub-code
      869           buf_temp-param.param-value    = p-value
      870         .
      871       end.
      872       else do:
      873           assign
      874               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      875           .
      876       end.
      877     end.
      878   end procedure.
      879   define variable vss-include-info6 as character format "X(65)" no-undo
      880   initial "@(#)$Workfile$ $Revision$".
      881   define stream excel-line.
      882   define stream excel-cell.
      883   define temp-table temp_cell-data no-undo
      884       field data-key as character
      885       field data-value as character
      886       index pi is primary unique data-key
      887   .
      888   define variable v-rpp1xl-current-data-row     as integer      no-undo.
      889   define variable v-rpp1xl-cell-file-name       as character    no-undo.
      890   procedure rpp1xl-init :
      891       define buffer buf_temp_cell-data        for temp_cell-data.
      892       define buffer buf_usr-flt               for ubflt.usr-flt.
      893   do
      894   for buf_temp_cell-data
      895     , buf_usr-flt
      896   on error undo, return error
      897   :
      898       assign
      899           v-rpp1xl-current-data-row = 0
      900       .
      901       run gbl/_tmpfile.p (
      902             input "xc"
      903           , input ".txt"
      904           , output v-rpp1xl-cell-file-name
      905       ).
      906       output stream excel-cell to value( v-rpp1xl-cell-file-name ).
      907       if printrubl = yes
      908       then do:
      909           run rpp1xl-write-cell-data in this-procedure (
      910                 input "valutCode":U
      911               , input "0":U
      912           ).
      913       end.
      914       else do:
      915           run rpp1xl-write-cell-data in this-procedure (
      916                 input "valutCode":U
      917               , input "1":U
      918           ).
      919       end.
      920       run rpp1xl-write-cell-data in this-procedure (
      921             input "columnList":U
      922           , input "":U
      923       ).
      924       run rpp1xl-write-cell-data in this-procedure (
      925             input "columnType":U
      926           , input "":U
      927       ).
      928       run rpp1xl-write-cell-data in this-procedure (
      929             input "columnAmount":U
      930           , input "0":U
      931       ).
      932       run rpp1xl-write-cell-data in this-procedure (
      933             input "subtotalList":U
      934           , input "":U
      935       ).
      936       run rpp1xl-write-cell-data in this-procedure (
      937             input "subtotalType":U
      938           , input "":U
      939       ).
      940       run rpp1xl-write-cell-data in this-procedure (
      941             input "subtotalAmount":U
      942           , input "0":U
      943       ).
      944       run rpp1xl-write-cell-data in this-procedure (
      945           input "subtotalPropisList":U
      946           , input "":U
      947       ).
      948       run rpp1xl-write-cell-data in this-procedure (
      949           input "subtotalPropisAmount":U
      950           , input "0":U
      951       ).
      952   end.
      953   end procedure.
      954   procedure rpp1xl-close :
      955   do
      956   on error undo, return error
      957   :
      958       output stream excel-line close.
      959       output stream excel-cell close.
      960       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
      961           export "exe/pp.xlt":U.
      962           export "exe/t_97.bas":U.
      963           export v-rpp1xl-cell-file-name.
      964           export "":U.
      965       output close.
      966   end.
      967   end procedure.
      968   procedure rpp1xl-write-cell-data :
      969   define input parameter p-data-key   as character        no-undo.
      970   define input parameter p-data-value as character        no-undo.
      971       define buffer buf_temp_cell-data     for temp_cell-data.
      972   do
      973   for buf_temp_cell-data
      974   on error undo, return error
      975   :
      976       find first buf_temp_cell-data
      977            where buf_temp_cell-data.data-key = p-data-key
      978       no-error.
      979       if not available buf_temp_cell-data
      980       then do:
      981           create buf_temp_cell-data.
      982           assign
      983               buf_temp_cell-data.data-key = p-data-key
      984           .
      985       end.
      986       assign
      987           buf_temp_cell-data.data-value = p-data-value
      988       .
      989       put stream excel-cell unformatted
      990                           buf_temp_cell-data.data-key
      991           chr(9)   buf_temp_cell-data.data-value
      992           chr(10)
      993       .
      994   end.
      995   end procedure.
      996   define variable Line as character no-undo .
      997   define variable v-doc-date-f      as character no-undo .
      998   define variable v-pay-date-f      as character no-undo .
      999   define variable v-fact-date-f      as character no-undo .
     1000   define variable num-lines as integer no-undo .
     1001   define variable v-fill as character no-undo init "_".
     1002   define variable v-sum-doc as character no-undo extent 3.
     1003   define variable v-payer-name as character no-undo extent 5.
     1004   define variable v-payer-bank-name as character no-undo extent 3.
     1005   define variable v-receiver-name as character no-undo extent 5.
     1006   define variable v-receiver-bank-name as character no-undo extent 3.
     1007   define variable v-dops as character no-undo .
     1008   define variable v-naznach-pl as character no-undo extent 3.
     1009   define variable ii as integer no-undo .
     1010   define variable v-chernovik as character no-undo .
     1011   define variable v-receiver-bank-name-full     as character    no-undo.
     1012   define variable v-receiver-name-full          as character    no-undo.
     1013   define variable v-payer-bank-name-full        as character    no-undo.
     1014   define variable v-payer-name-full             as character    no-undo.
     1015   define variable v-naznach-pl-full             as character    no-undo.
     1016   define variable g#log as logical no-undo .
     1017   define buffer buf_currency for ub.currency.
     1018   do
     1019   on error undo, return error return-value
     1020   :
     1021      run get-report-num  in parParentProc(output g#report-num).
     1022     run get-quest-print in parParentProc(output g#quest-print).
     1023       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) .
     1024       output close.
     1025       run rpp1xl-init in this-procedure .
     1026    if p-format <> 0
     1027    and p-format <> ?
     1028    and p-append
     1029    then do:
     1030       assign
     1031       p-format = ?
     1032       .
     1033      return.
     1034    end.
     1035     assign
     1036     v-chernovik = if buf_fin-doc.status_ = 'новый':U
     1037                   then "Ч Е Р Н О В И К"
     1038                   else (fill( chr(32), 15))
     1039     .
     1040     assign
     1041     v-doc-date-f = string(buf_fin-doc.doc-date, "99.99.9999":U)
     1042     v-pay-date-f = if buf_fin-doc.pay-date <> ?
     1043                    then string(buf_fin-doc.pay-date, "99.99.9999":U)
     1044                    else "":U
     1045     v-fact-date-f = if buf_fin-doc.fact-date <> ?
     1046                     then string(buf_fin-doc.pay-date, "99.99.9999":U)
     1047                     else "":U
     1048     .
     1049     assign
     1050     v-dops = Sum-in-Words-Invalut(buf_fin-doc.sum-doc, buf_fin-doc.curr-code)
     1051     v-sum-doc[1] =  Break-n-line(v-dops, "76,76,76", output num-lines)
     1052     .
     1053     do ii = 3 to 1 by -1 :
     1054       assign
     1055       v-sum-doc[ii] = If num-lines >= ii
     1056                         then entry(ii, v-sum-doc[1], chr(4))
     1057                         else "":U
     1058       v-sum-doc[ii] =  v-sum-doc[ii] +  fill(chr(32), 76 - length(v-sum-doc[ii]))
     1059       .
     1060     end.
     1061     assign
     1062     v-sum-doc[1] = caps(substring(v-sum-doc[1], 1, 1)) + substring(v-sum-doc[1], 2)
     1063     .
     1064     assign
     1065       v-payer-name-full = buf_fin-doc.payer-name
     1066                           + ( if buf_fin-doc.payer-dop1 = "":U
     1067                               then "":U
     1068                               else ( chr(44)
     1069                                       + chr(32) ) )
     1070                           + buf_Fin-doc.payer-dop1
     1071       v-payer-name[1]   = Break-n-line( v-payer-name-full, "53,53,53,53,53":U, output num-lines)
     1072     .
     1073     do ii = 5 to 1 by -1 :
     1074       assign
     1075       v-payer-name[ii] = If num-lines >= ii
     1076                         then entry(ii, v-payer-name[1], chr(4))
     1077                         else "":U
     1078       v-payer-name[ii] =  v-payer-name[ii] +  fill(chr(32), 53 - length(v-payer-name[ii]))
     1079       .
     1080     end.
     1081     assign
     1082       v-payer-bank-name-full = (buf_fin-doc.payer-bank-name + chr(44) + chr(32) + buf_fin-doc.payer-bank-city)
     1083                                   + ( if buf_fin-doc.payer-dop2 = "":U
     1084                                       then "":U
     1085                                       else ( chr(44)
     1086                                               + chr(32)))
     1087                                   + buf_fin-doc.payer-dop2
     1088       v-payer-bank-name[1]   = Break-n-line( v-payer-bank-name-full, "53,53,53":U, output num-lines)
     1089     .
     1090     do ii = 3 to 1  by -1:
     1091       assign
     1092       v-payer-bank-name[ii] = If num-lines >= ii
     1093                         then entry(ii, v-payer-bank-name[1], chr(4))
     1094                         else "":U
     1095       v-payer-bank-name[ii] =  v-payer-bank-name[ii] +  fill(chr(32), 53 - length(v-payer-bank-name[ii]))
     1096       .
     1097     end.
     1098     assign
     1099       v-receiver-name-full = buf_fin-doc.receiver-name
     1100                               + ( if buf_fin-doc.receiver-dop1 = "":U
     1101                                   then "":U
