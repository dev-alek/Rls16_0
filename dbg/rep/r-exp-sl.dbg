     1053   DEFINE temp-table tt-line no-undo
     1054       field   obj-code    as integer
     1055       field   obj-type    as character
     1056       field   grp-name    as character
     1057       field   grp-code    as integer
     1058       field   prod-name   as character
     1059       field   b-code      as integer
     1060       field   src-code    as character
     1061       field   gds-name    as character
     1062       field   gds-code    as integer
     1063       field   qnty        as decimal
     1064       field   summ        as decimal
     1065       INDEX   pi          IS PRIMARY UNIQUE
     1066               obj-code
     1067               obj-type
     1068               src-code
     1069               b-code.
     1070   define stream out-stream.
     1071   define stream lst-out.
     1072   define stream StreamLog.
     1073   define buffer buf_tt-line        for tt-line .
     1074   define buffer buf_chk-doc  for ub.chk-doc.
     1075   define buffer buf_chk-gds  for ub.chk-gds.
     1076   define buffer buf_bar-code for ub.bar-code.
     1077   define buffer buf_goods          for ub.goods .
     1078   define buffer buf_producer for ub.clients.
     1079   define buffer buf_prod-bc        for ub.prod-bc .
     1080   do
     1081   on error undo, return error
     1082   :
     1083      define variable v-begin-date        as date        no-undo .
     1084      define variable v-end-date          as date        no-undo .
     1085      define variable v-begin-date0       as date        no-undo .
     1086      define variable v-end-date0         as date        no-undo .
     1087      define variable v-par-val           as character   no-undo .
     1088      define variable v-par-type          as character   no-undo .
     1089      define variable v-file-name         as character   no-undo .
     1090      define variable v-file-name-mapping as character   no-undo .
     1091      define variable v-file-name-mapping-new as character   no-undo .
     1092      define variable v-fmt               as character   no-undo .
     1093      define variable v-weekday-today     as integer     no-undo .
     1094      define variable v-b-code            as integer     no-undo .
     1095      define variable v-bar               as character   no-undo .
     1096      define variable v-prod-name         as character   no-undo .
     1097      define variable v-gds-code          as integer     no-undo .
     1098      define variable v-fact-order-start  as decimal     no-undo .
     1099      define variable v-fact-order-end    as decimal     no-undo .
     1100      define variable v-empty-1           as decimal     no-undo .
     1101      define variable v-empty-2           as decimal     no-undo .
     1102      define variable v-gds-name          as character   no-undo .
     1103      define variable v-grp-code          as integer     no-undo .
     1104      define variable v-counter           as integer     no-undo .
     1105      define variable v-label             as character   no-undo .
     1106      define variable v-archive-ok as logical      no-undo.
     1107      define variable v-can-print  as logical      no-undo.
     1108      define variable v-comment    as character    no-undo.
     1109      define variable v-grp-name as character no-undo.
     1110      define frame info
     1111         v-label        label "Этап" format "x(16)" skip
     1112         v-counter      label "Записей" format ">>>,>>>,>>9" skip
     1113         with view-as dialog-box side-labels 1 columns three-d title "Формирование отчета"
     1114      .
     1115      assign
     1116         log-file-name = "Rep_Nielsen.log"
     1117      .
     1118      IF p-date = ?
     1119      THEN DO:
     1120         assign
     1121            v-weekday-today = WEEKDAY(TODAY)
     1122            v-begin-date    = TODAY - v-weekday-today - 5
     1123            v-end-date      = TODAY - v-weekday-today + 1
     1124            v-begin-date0   = v-begin-date
     1125            v-end-date0     = v-end-date
     1126         .
     1127      END.
     1128      ELSE DO:
     1129         assign
     1130            v-weekday-today = WEEKDAY(p-date)
     1131            v-begin-date    = p-date - v-weekday-today - 5
     1132            v-end-date      = p-date - v-weekday-today + 1
     1133            v-end-date0     = v-end-date
     1134            v-begin-date0    = v-begin-date
     1135         .
     1136      END.
     1137      v-file-name-mapping = "mapping".
     1138      output stream out-stream to value(v-file-name-mapping + ".txt") .
     1139      put stream out-stream unformatted
     1140      "Gds-Code"   chr(9)
     1141      "Bar-Code" chr(9)
     1142      "Qnty" chr(10).
     1143       run write-log-and-file in p-log-handle (           input 1                                                               , input log-file-name                                                   , input 1                                                               , input substitute("Создание mapping файла.")).
     1144      for each buf_goods where buf_goods.stts = 0 no-lock:
     1145          for each buf_bar-code where buf_bar-code.gds-code = buf_goods.gds-code
     1146                                  and buf_bar-code.part-code = ""
     1147                                  and buf_bar-code.in-code = "" no-lock:
     1148              if buf_bar-code.stts_ <> 0 then next.
     1149              for each buf_prod-bc where buf_prod-bc.b-code = buf_bar-code.b-code
     1150                                     and buf_prod-bc.b-str NE string(buf_bar-code.b-code)
     1151                                     and buf_prod-bc.bc-on = yes no-lock:
     1152              put stream out-stream unformatted
     1153                   buf_bar-code.gds-code chr(9)
     1154                   buf_goods.qnty-cart chr(9)
     1155                   buf_prod-bc.b-str chr(10).
     1156              end.
     1157              if buf_bar-code.b-code = buf_bar-code.gds-code then next.
     1158                   put stream out-stream unformatted
     1159                       buf_bar-code.gds-code chr(9)
     1160                   buf_goods.qnty-cart chr(9)
     1161                       buf_bar-code.b-code     chr(10).
     1162          end.
     1163      end.
     1164         run write-log-and-file in p-log-handle (           input 1                                                               , input log-file-name                                                   , input 1                                                               , input substitute("Mapping файл создан успешно.")).
     1165      output stream out-stream close.
     1166      tt-obj_arh_loop:
     1167      FOR EACH tt-obj exclusive-lock
     1168          BREAK by tt-obj.host-code
     1169      :
     1170               run write-log-and-file in p-log-handle (           input 1                                                               , input log-file-name                                                   , input 1                                                               , input SUBSTITUTE("Проверка и расчет архивов по объекту: &1 &2.", tt-obj.obj-type, tt-obj.obj-code)).
     1171         assign
     1172         v-begin-date = v-begin-date0
     1173         v-end-date   = v-end-date0
     1174         .
     1175         run rep/chk-ahz.p (
     1176            input        tt-obj.obj-type
     1177            , input        tt-obj.obj-code
     1178            , input        yes
     1179            , input        yes
     1180            , input        no
     1181            , input        no
     1182            , input        no
     1183            , input        0
     1184            , input        "":U
     1185            , input-output v-begin-date
     1186            , input-output v-end-date
     1187            , output       v-archive-ok
     1188            , output       v-comment
     1189            , output       v-can-print
     1190         ) no-error .
     1191         if error-status :error
     1192         or v-can-print  = false
     1193         or (v-can-print  = true
     1194         and (v-begin-date = ?
     1195         or v-end-date = ?
     1196         or v-end-date < v-end-date0
     1197         ))
     1198         then do:
     1199                     run write-log-and-file in p-log-handle (           input 1                                                               , input log-file-name                                                   , input 1                                                               , input v-comment).
     1200           error-status :error = no.
     1201           delete tt-obj.
     1202           next tt-obj_arh_loop.
     1203         end.
     1204      END.
     1205      for each tt-obj no-lock
     1206      BREAK by tt-obj.host-code
     1207      :
     1208         IF FIRST-OF (tt-obj.host-code)
     1209         THEN DO:
     1210               ASSIGN
     1211                  v-file-name =  p-name
     1212                              + STRING(tt-obj.host-code, "99999")
     1213                              + "_"
     1214                              + SUBSTRING(STRING(YEAR(v-begin-date), "9999"),3,2)
     1215                              + STRING(MONTH(v-begin-date), "99")
     1216                              + STRING(DAY(v-begin-date), "99")
     1217                              + SUBSTRING(STRING(YEAR(v-end-date), "9999"),3,2)
     1218                              + STRING(MONTH(v-end-date), "99")
     1219                              + STRING(DAY(v-end-date), "99")
     1220               v-file-name-mapping-new = p-name
     1221                          + string(tt-obj.host-code, "99999")
     1222                          + "_mapping_"
     1223                          + substring(string(year(v-begin-date), "9999"),3,2)
     1224                          + string(month(v-begin-date), "99")
     1225                          + string(day(v-begin-date), "99")
     1226                          + substring(string(year(v-end-date), "9999"),3,2)
     1227                          + string(month(v-end-date), "99")
     1228                          + string(day(v-end-date), "99").
     1229         END.
     1230               run write-log-and-file in p-log-handle (           input 1                                                               , input log-file-name                                                   , input 1                                                               , input substitute("Выгрузка объект: &1 &2", tt-obj.obj-type, tt-obj.obj-code)).
     1231              os-rename value(v-file-name-mapping + ".txt":U) value(v-file-name-mapping-new + ".txt":U).
     1232              v-file-name-mapping = v-file-name-mapping-new.
     1233         for each buf_chk-doc no-lock
     1234           where buf_chk-doc.obj-type = tt-obj.obj-type
     1235             and buf_chk-doc.obj-code = tt-obj.obj-code
     1236             and buf_chk-doc.chk-date <= v-end-date
     1237             and buf_chk-doc.chk-date >= v-begin-date
     1238             and lookup(string(buf_chk-doc.chk-type), '1,69,14,15,16,36':U + '6,96':U) > 0:
     1239            for each buf_chk-gds no-lock where buf_chk-gds.doc-code = buf_chk-doc.doc-code:
     1240                find first  buf_tt-line
     1241                      where buf_tt-line.obj-code = buf_chk-doc.obj-code
     1242                      and   buf_tt-line.obj-type = buf_chk-doc.obj-type
     1243                      and   buf_tt-line.src-code = buf_chk-gds.src-code
     1244                      and   buf_tt-line.b-code   = buf_chk-gds.b-code no-error.
     1245                if not available buf_tt-line then do:
     1246               CREATE buf_tt-line.
     1247               ASSIGN
     1248                      buf_tt-line.obj-code  = buf_chk-doc.obj-code
     1249                      buf_tt-line.obj-type  = buf_chk-doc.obj-type
     1250                      buf_tt-line.src-code  = buf_chk-gds.src-code
     1251                      buf_tt-line.b-code    = buf_chk-gds.b-code
     1252                      buf_tt-line.summ      = (if (lookup(string(buf_chk-doc.chk-type), '1,69,14,15,16,36':U) > 0) then buf_chk-gds.sum-base else buf_chk-gds.sum-base * (-1))
     1253                      buf_tt-line.qnty      = (if (lookup(string(buf_chk-doc.chk-type), '1,69,14,15,16,36':U) > 0) then buf_chk-gds.doc-qnty else buf_chk-gds.doc-qnty * (-1)).
     1254                end.
     1255                else do:
     1256               assign
     1257                      buf_tt-line.summ = buf_tt-line.summ + (if (lookup(string(buf_chk-doc.chk-type), '1,69,14,15,16,36':U) > 0) then buf_chk-gds.sum-base else buf_chk-gds.sum-base * (-1))
     1258                      buf_tt-line.qnty = buf_tt-line.qnty + (if (lookup(string(buf_chk-doc.chk-type), '1,69,14,15,16,36':U) > 0) then buf_chk-gds.doc-qnty else buf_chk-gds.doc-qnty * (-1)).
     1259                end.
     1260            end.
     1261        end.
     1262         if last-of (tt-obj.host-code) then do:
     1263            output stream out-stream TO VALUE(v-file-name + ".txt") .
     1264               put stream out-stream unformatted
     1265                  "ShopCode"     chr(9)
     1266                  "GrpName"      chr(9)
     1267                  "GrpCode"      chr(9)
     1268                  "Manufacture"  chr(9)
     1269                  "Src-Code"     chr(9)
     1270                  "Code"         chr(9)
     1271                  "ProductName"  chr(9)
     1272                  "SalesValue"   chr(9)
     1273                  "SalesItem"    chr(10).
     1274            for each buf_tt-line break by buf_tt-line.b-code:
     1275               if first-of (buf_tt-line.b-code) then do:
     1276                   find first buf_bar-code where buf_bar-code.b-code = buf_tt-line.b-code no-lock no-error.
     1277                   find first buf_goods where buf_goods.gds-code = buf_bar-code.gds-code no-lock no-error.
     1278                   find first buf_producer where buf_producer.obj-type = buf_goods.prod-type
     1279                                             and buf_producer.obj-code = buf_goods.prod-code no-lock no-error.
     1280                  ASSIGN
     1281                   v-grp-name = buf_goods.grp-name
     1282                   v-grp-code = buf_goods.grp-code
     1283                   v-gds-name = buf_goods.gds-name
     1284                   v-prod-name = buf_producer.obj-name
     1285                   v-gds-code = buf_goods.gds-code no-error.
     1286               end.
     1287               assign
     1288               buf_tt-line.grp-name  = v-grp-name
     1289               buf_tt-line.grp-code  = v-grp-code
     1290               buf_tt-line.gds-name  = v-gds-name
     1291               buf_tt-line.prod-name = v-prod-name
     1292               buf_tt-line.gds-code  = v-gds-code no-error.
     1293               put stream out-stream unformatted
     1294                  buf_tt-line.obj-code  chr(9)
     1295                  trim(buf_tt-line.grp-name) chr(9)
     1296                  buf_tt-line.grp-code  chr(9)
     1297                  trim(buf_tt-line.prod-name) chr(9)
     1298                  buf_tt-line.gds-code chr(9)
     1299                  trim(buf_tt-line.src-code) chr(9)
     1300                  trim(buf_tt-line.gds-name) chr(9)
     1301                  trim(string(buf_tt-line.summ,"->>>>>>9.99")) chr(9)
     1302                  trim(string(buf_tt-line.qnty,"->>>>>>9.999")) chr(10).
     1303            END.
     1304            output stream out-stream close.
     1305            run pack-file in this-procedure (input v-file-name, input v-file-name-mapping-new) no-error.
     1306            if error-status:error
     1307            then do:
     1308                           run write-log-and-file in p-log-handle (           input 1                                                               , input log-file-name                                                   , input 1                                                               , input SUBSTITUTE("Ошибка упаковки:&1", RETURN-VALUE)).
     1309               empty temp-table buf_tt-line.
     1310               error-status :error = no.
     1311            end.
     1312            IF p-ftp-address <> "":U
     1313            THEN DO:
     1314               RUN ftp-send IN THIS-PROCEDURE (INPUT (v-file-name  + ".zip")) NO-ERROR .
     1315               if error-status:error
     1316               then do:
     1317                                       run write-log-and-file in p-log-handle (           input 1                                                               , input log-file-name                                                   , input 1                                                               , input SUBSTITUTE("Ошибка отправки по FTP: &1", RETURN-VALUE)).
     1318               end.
     1319               ELSE DO:
     1320                  os-delete value( v-file-name  + ".zip" ) .
     1321               END.
     1322            END.
     1323            empty temp-table buf_tt-line.
     1324         end.
     1325      END.
     1326      os-delete value( STRING(v-file-name-mapping-new + ".txt":U)).
     1327      hide frame info.
     1328         run write-log-and-file in p-log-handle (           input 1                                                               , input log-file-name                                                   , input 1                                                               , input "Выгрузка закончена").
     1329   end.
     1330   procedure pack-file :
     1331     define input parameter  p-file-name as character  no-undo.
     1332     define input parameter  p-file-name-mapping as character no-undo.
     1333     define variable v-arc             as character no-undo .
     1334     define variable v-txt             as character no-undo .
     1335     define variable v-list-file-name  as character no-undo .
     1336     define variable v-arc-file-name   as character no-undo .
     1337   do
     1338   on error undo, return error return-value
     1339   :
     1340      v-arc-file-name  = p-file-name + ".zip":U.
     1341      v-arc = search( "exe/7za.exe" ).
     1342      if v-arc = ? then do:
     1343         return error("Не найдена программа 7za.exe, невозможно упаковать файлы в архив.").
     1344      end.
     1345      if search( v-arc-file-name ) <> ? then do:
     1346         return error substitute ( "Файл &1 уже существует. Создание архива невозможно." , v-arc-file-name ).
     1347      end.
     1348      run gbl/_tmpfile.p ( "lst":u , ".txt":u , output v-list-file-name ).
     1349      output stream lst-out to value(v-list-file-name).
     1350      put stream lst-out unformatted (p-file-name + ".txt":U) skip.
     1351      put stream lst-out unformatted (p-file-name-mapping + ".txt":U) skip.
     1352      output stream lst-out close.
     1353      assign
     1354         v-txt = substitute( "&1 a -tzip &2 @&3"
     1355                           , v-arc
     1356                           , v-arc-file-name
     1357                           , v-list-file-name).
     1358      os-command silent value ( v-txt ) .
     1359      os-delete value( v-list-file-name ) .
     1360      os-delete value( STRING(p-file-name + ".txt":U )) .
     1361   end.
     1362   end procedure.
     1363   procedure ftp-send :
     1364   define input parameter p-file-name as character        no-undo.
     1365   define variable v-parameter    as character    no-undo.
     1366   do
     1367   on error undo, return error
     1368   :
     1369           p-ftp-address = trim(trim(replace(p-ftp-address,'ftp:',""),chr(47)),chr(92)).
     1370           v-parameter = p-ftp-address + chr(4) +
     1371                         p-login + chr(4) +
     1372                         p-password + chr(4) +
     1373                         string(134217728) + chr(4) + ''
     1374                          +
     1375                         p-file-name  + chr(4) +
     1376                          p-file-name + chr(4) +
     1377                         string(no) + chr(4) +
     1378                         log-file-name.
     1379           run gbl/ftp-put.p   ( input this-procedure:handle
     1380                             ,input this-procedure:handle
     1381                           , input p-log-handle
     1382                           , input v-parameter
     1383                           ) no-error.
     1384   end.
     1385   end procedure.
