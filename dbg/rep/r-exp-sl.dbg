        1   block-level on error undo, throw.
        2   define variable vss-include-info0 as character format "X(65)" no-undo
        3   initial "@(#)$Workfile$ $Revision$".
        4   DEFINE temp-table tt-obj no-undo
        5       field   obj-code    as integer
        6       field   obj-type    as character
        7       field   obj-name    as character
        8       field   host-code   as integer
        9       INDEX   pi          IS PRIMARY UNIQUE
       10               obj-type
       11               obj-code
       12     .
       13   define input parameter p-date          as date             no-undo.
       14   define input parameter p-ftp-address   as character        no-undo.
       15   define input parameter p-ftp-path      as character        no-undo.
       16   define input parameter p-ftp-target-dir as character        no-undo.
       17   define input parameter p-login         as character        no-undo.
       18   define input parameter p-password      as character        no-undo.
       19   define input parameter p-name          as character        no-undo.
       20   define input parameter p-log-handle    as handle no-undo .
       21   define input parameter table   FOR tt-obj.
       22   define variable vss-revision    as character no-undo init "$Revision: 20b73597f255, 21, test $":U .
       23   define variable vss-author      as character no-undo init "$Author: SKiryxin $":U .
       24   define variable vss-date        as character no-undo init "$Date: Wed Mar 05 15:13:08 2014 +0300 $":U .
       25   define variable vss-workfile    as character no-undo init "$Workfile: r-exp-sl.p $":U .
       26   define variable vss-archive     as character no-undo init "$Archive: rep/r-exp-sl.p $":U .
       27   define variable vss-description as character no-undo init "Отчет для Nielsen запуск из интерфейса".
       28   procedure vss-get-info :
       29     define output parameter p-vss-revision    like vss-revision    no-undo .
       30     define output parameter p-vss-author      like vss-author      no-undo .
       31     define output parameter p-vss-date        like vss-date        no-undo .
       32     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       33     define output parameter p-vss-archive     like vss-archive     no-undo .
       34     define output parameter p-vss-description like vss-description no-undo .
       35     assign
       36       p-vss-revision    = vss-revision
       37       p-vss-author      = vss-author
       38       p-vss-date        = vss-date
       39       p-vss-workfile    = vss-workfile
       40       p-vss-archive     = vss-archive
       41       p-vss-description = vss-description
       42     .
       43   end procedure.
       44   procedure vss-get-parameters :
       45     define output parameter p-vss-parameters as character no-undo .
       46   end procedure.
       47   define new global shared variable g#vssrevis-logger as handle    no-undo .
       48   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       49   define variable v-vssrevis-logger                   as handle    no-undo .
       50   procedure vss-logevent :
       51     define input  parameter p-extra-paramters as character no-undo .
       52     define variable v-vssrevis-parameters as character no-undo .
       53     do
       54     on error undo, return error return-value
       55     :
       56       if  valid-handle(v-vssrevis-logger)
       57       and v-vssrevis-logger :get-signature("logevent") <> ""
       58       then do:
       59         run vss-get-parameters in this-procedure
       60           (output v-vssrevis-parameters
       61           ).
       62         run logevent in v-vssrevis-logger
       63           (input vss-workfile
       64           ,input vss-revision
       65           ,input v-vssrevis-parameters
       66           ,input p-extra-paramters
       67           ).
       68       end.
       69     end.
       70   end procedure.
       71   assign
       72     v-vssrevis-logger = g#vssrevis-logger
       73   .
       74   if  valid-handle(v-vssrevis-logger)
       75   and v-vssrevis-logger :get-signature("logevent") <> ""
       76   then do:
       77     assign
       78       v-vssrevis-logevent = true
       79     .
       80     run vss-logevent in this-procedure (input vss-description) .
       81   end.
       82   define new global shared variable g#language as character no-undo .
       83   if g#language <> '' and g#language <> 'rus':U then do:
       84     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       85   end.
       86   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       87   define  shared variable g#auto-pid           as integer   no-undo .
       88   define  shared variable conn-par             as character no-undo .
       89   define  shared variable g#auto-user-id       as character no-undo .
       90   define  shared variable g#auto-user-login    as character no-undo .
       91   define  shared variable g#auto-user-password as character no-undo .
       92   define  shared variable v-socket             as logical   no-undo .
       93   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       94   define  shared variable auto-window-h     as handle    no-undo .
       95   define  shared variable auto-log-msg-h    as handle    no-undo .
       96   define  shared variable hand-log-msg-h    as handle    no-undo .
       97   define  shared variable log-file-name     as character no-undo initial ? .
       98   define  shared variable add-log-file-name as character no-undo initial ? .
       99   define  shared variable writelogvalue     as character no-undo initial ? .
      100   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      101   procedure cur-time :
      102      define output parameter p-today as date      no-undo .
      103      define output parameter p-time  as integer   no-undo .
      104     do
      105     on error undo, return error
      106     :
      107       define variable v-date1 as date      no-undo .
      108       define variable v-date2 as date      no-undo .
      109       define variable v-time  as integer   no-undo .
      110       assign
      111         v-date1 = today
      112         v-time  = time
      113         v-date2 = today
      114       .
      115       if v-date1 <> v-date2
      116       then do:
      117         assign
      118           v-date1 = today
      119           v-time  = v-time
      120         .
      121       end.
      122       assign
      123         p-today = v-date1
      124         p-time  = v-time
      125       .
      126     end.
      127   end.
      128   function cur-time-date returns character
      129   :
      130     return string(today, '99/99/9999':U) .
      131   end.
      132   function cur-time-mjd returns decimal
      133   :
      134     define variable v-date as date      no-undo .
      135     define variable v-time as integer   no-undo .
      136     run cur-time in this-procedure
      137       (output v-date
      138       ,output v-time
      139       ) .
      140     return integer(v-date) - 2400002 + (v-time / 86400) .
      141   end.
      142   function cur-time-get-ending-index returns integer
      143   (input p-number as integer
      144   )
      145   :
      146     if p-number < 0
      147     or p-number = ?
      148     then do:
      149       return 1 .
      150     end.
      151     define variable v-rest as integer   no-undo .
      152     assign
      153       p-number = p-number modulo 100
      154     .
      155     if p-number < 20
      156     then do:
      157       assign
      158         v-rest = p-number
      159       .
      160     end.
      161     else do:
      162       assign
      163         v-rest = p-number modulo 10
      164       .
      165     end.
      166     case v-rest :
      167       when 1
      168       then do:
      169         return 2 .
      170       end.
      171       when 2 or
      172       when 3 or
      173       when 4
      174       then do:
      175         return 3 .
      176       end.
      177       otherwise do:
      178         return 1 .
      179       end.
      180     end case .
      181   end.
      182   procedure cur-time-mjd-to-date :
      183      define input  parameter i-mjd-diff as decimal no-undo.
      184      define output parameter o-Date     as date    no-undo.
      185      define output parameter o-Time     as integer no-undo.
      186      define variable v-day-number as integer   no-undo .
      187      if    i-mjd-diff < 0
      188         or i-mjd-diff = ?
      189      then do:
      190         return "?" .
      191      end.
      192      assign
      193         v-day-number = truncate(i-mjd-diff,0).
      194         o-Date = date(v-day-number + 2400002).
      195         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      196     .
      197   end.
      198   function cur-time-mjd-to-string returns character
      199   (input p-mjd-diff as decimal
      200   )
      201   :
      202     define variable v-day-number as integer   no-undo .
      203     define variable v-seconds    as integer   no-undo .
      204     define variable v-hour       as integer   no-undo .
      205     define variable v-min        as integer   no-undo .
      206     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      207     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      208     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      209     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      210     if p-mjd-diff < 0
      211     or p-mjd-diff = ?
      212     then do:
      213       return "?" .
      214     end.
      215     assign
      216       v-day-number = integer(truncate(p-mjd-diff,0))
      217       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      218     .
      219     if v-seconds > 86400
      220     then do:
      221       assign
      222         v-seconds = 86400 - 1
      223       .
      224     end.
      225     if v-seconds < 0
      226     then do:
      227       assign
      228         v-seconds = 0
      229       .
      230     end.
      231     assign
      232       v-hour = truncate(v-seconds / 3600, 0)
      233     .
      234     assign
      235       v-seconds = v-seconds modulo 3600
      236     .
      237     assign
      238       v-min = truncate(v-seconds / 60, 0)
      239     .
      240     assign
      241       v-seconds = v-seconds modulo 60
      242     .
      243     return
      244         (if v-day-number <> 0
      245           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      246           else ""
      247         )
      248       + (if v-day-number <> 0 or v-hour <> 0
      249           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      250           else ""
      251         )
      252       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      253           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      254           else ""
      255         )
      256       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      257       .
      258   end.
      259   function cur-time-string returns character
      260   :
      261     define variable v-date as date      no-undo .
      262     define variable v-time as integer   no-undo .
      263     run cur-time in this-procedure
      264       (output v-date
      265       ,output v-time
      266       ) .
      267     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      268   end.
      269   function cur-time-string-sec returns character
      270   :
      271     define variable v-date as date      no-undo .
      272     define variable v-time as integer   no-undo .
      273     run cur-time in this-procedure
      274       (output v-date
      275       ,output v-time
      276       ) .
      277     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      278   end.
      279   function cur-time-custom  returns character
      280   (input p-prefix as character
      281   ,input p-date-format as character
      282   ,input p-delimiter as character
      283   ,input p-time-format as character
      284   ,input p-suffix as character
      285   )
      286   :
      287     define variable v-date as date      no-undo .
      288     define variable v-time as integer   no-undo .
      289     run cur-time in this-procedure
      290       (output v-date
      291       ,output v-time
      292       ) .
      293     return
      294       p-prefix
      295       + string(v-date, p-date-format)
      296       + p-delimiter
      297       + string(v-time, p-time-format)
      298       + p-suffix
      299       .
      300   end.
      301   function cur-time-print  returns character
      302   :
      303     define variable v-date as date      no-undo .
      304     define variable v-time as integer   no-undo .
      305     run cur-time in this-procedure
      306       (output v-date
      307       ,output v-time
      308       ) .
      309     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      310   end.
      311   function cur-time-datetime returns datetime
      312   :
      313     define variable v-char as character no-undo .
      314     define variable v-datetime as datetime no-undo .
      315     v-char = cur-time-string().
      316     v-datetime = datetime(v-char).
      317     return  v-datetime.
      318   end.
      319   function cur-time-string-msec returns character
      320   :
      321     define variable v-date as datetime  no-undo .
      322     v-date = now.
      323     return string(v-date) .
      324   end.
      325   define stream LogStream .
      326   define variable mNoTime as logical no-undo.
      327   procedure write-to-log-notime :
      328     define input param i-str as character no-undo .
      329     mNoTime = yes.
      330     run write-to-log (i-str).
      331     mNoTime = no.
      332   end.
      333   procedure write-to-log :
      334     define input param p-str as character no-undo .
      335     do
      336     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      337     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      338     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      339     :
      340       define variable log-res        as logical   no-undo .
      341       define variable v-jj           as integer   no-undo .
      342       if    mNoTime
      343          or writelogvalue eq "AsyncProc"
      344       then
      345          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
      346       else
      347          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
      348       if auto-log-msg-h <> ? then do:
      349         log-res = auto-log-msg-h:move-to-eof( ) .
      350         log-res = auto-log-msg-h:insert-string( p-str ).
      351       end.
      352       if hand-log-msg-h <> ? then do:
      353         log-res = hand-log-msg-h:move-to-eof( ) .
      354         log-res = hand-log-msg-h:insert-string( p-str ).
      355       end.
      356       assign
      357         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      358         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      359         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      360       .
      361       if add-log-file-name <> ? then do:
      362         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      363           run gbl/fileapnd.p
      364             ( input entry(v-jj, add-log-file-name, chr(1) )
      365             ,input p-str
      366             ,input 20
      367             ) no-error .
      368           if error-status:error then do:
      369             return error return-value .
      370           end.
      371         end.
      372       end.
      373       if writelogvalue eq "AsyncProc"
      374       then do:
      375          p-str = trim(p-str, (chr(13) + chr(10)) )
      376       .
      377          Publish "WriteLogAsunc" (p-str,yes).
      378       end.
      379       else if writelogvalue <> "yes" then do:
      380         run gbl/fileapnd.p
      381           ( input log-file-name
      382           ,input p-str
      383           ,input 20
      384           ) no-error .
      385         if error-status:error then do:
      386           return error return-value .
      387         end.
      388       end.
      389     end.
      390   end procedure.
      391   procedure write-to-screen :
      392     define input param p-str as character no-undo .
      393     do
      394     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      395     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      396     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      397     :
      398       define variable log-res as logical no-undo.
      399       assign
      400         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
      401       .
      402       if auto-log-msg-h <> ?
      403       then do:
      404         log-res = auto-log-msg-h:move-to-eof( ) .
      405         log-res = auto-log-msg-h:insert-string( p-str ).
      406       end.
      407       if hand-log-msg-h <> ?
      408       then do:
      409         log-res = hand-log-msg-h:move-to-eof( ) .
      410         log-res = hand-log-msg-h:insert-string( p-str ).
      411       end.
      412     end.
      413   end procedure.
      414   procedure send-msg-to-email :
      415     define input  parameter p-subject      as character no-undo .
      416     define input  parameter p-text-err     as character no-undo .
      417     define input  parameter p-attach-files as character no-undo .
      418     do
      419     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      420     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      421     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      422     :
      423       define variable v-tth             as handle    no-undo .
      424       define variable v-value-character as character no-undo .
      425       define variable v-value-date      as date      no-undo .
      426       define variable v-value-decimal   as decimal   no-undo .
      427       define variable v-value-integer   as integer   no-undo .
      428       define variable v-value-logical   as logical   no-undo .
      429       define variable v-param-type      as character no-undo .
      430       define variable v-email       as character no-undo .
      431       define variable v-tmp-str     as character no-undo .
      432       define variable v-tmp1-str    as character no-undo .
      433       define variable v-ind         as integer   no-undo .
      434       define variable v-num-entries as integer   no-undo .
      435       delete object v-tth no-error.
      436       run adm/shattri.p
      437         ( input "get":U
      438          ,input  "":U
      439          ,input  0
      440          ,input  'auto-task':U
      441          ,input  'send-msg-to-email':U
      442          ,output v-value-character
      443          ,output v-value-date
      444          ,output v-value-decimal
      445          ,output v-value-integer
      446          ,output v-value-logical
      447          ,output v-param-type
      448          ,input-output table-handle v-tth
      449         ) no-error .
      450       if not error-status :error  then do:
      451         assign
      452           v-tmp-str = v-value-character
      453         .
      454       end.
      455       delete object v-tth no-error.
      456       assign
      457         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      458         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      459         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      460         v-num-entries = num-entries( v-tmp-str, chr(44) )
      461         v-email       = "":U
      462       .
      463       do v-ind = 1 to v-num-entries
      464       :
      465         assign
      466           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      467         .
      468         if trim( v-tmp1-str ) <> "":U then do:
      469           if v-email = "":U then do:
      470             assign
      471               v-email = v-tmp1-str
      472             .
      473           end.
      474           else do:
      475             assign
      476               v-email = v-email + chr(44) + v-tmp1-str
      477             .
      478           end.
      479         end.
      480       end.
      481       if v-email <> "":U then do:
      482         run gbl/sendmail.p
      483           ( input v-email
      484           , input p-subject
      485           , input p-text-err
      486           , input p-attach-files
      487           ) no-error .
      488         if error-status :error
      489           or return-value <> "":U
      490         then do:
      491           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      492         end.
      493       end.
      494     end.
      495   end procedure.
      496   define new global shared variable g#library  as handle no-undo .
      497   define new global shared variable g#library2 as handle no-undo .
      498   procedure proc-alt-shift-f2:
      499     if not ibs.th.gbl.gbl-var:rcode
      500   then
      501     run gbl\inidebug.p .
      502   end.
      503   procedure proc-alt-shift-f3:
      504     run gbl/prvssinf.p
      505       ( input this-procedure
      506       ) .
      507   end.
      508   define variable v-inform-launched as logical no-undo initial false .
      509   procedure proc-alt-shift-f4:
      510     define variable v-action as character no-undo .
      511     if v-inform-launched = false then do:
      512       assign
      513         v-inform-launched = true
      514       .
      515       run gbl/d-inform.w
      516         (  input self
      517         ,  input this-procedure
      518         , output v-action
      519         ) no-error .
      520       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      521       assign
      522         v-inform-launched = false
      523       .
      524     end.
      525   end.
      526   procedure proc-alt-f1:
      527     run gbl/corrhelp.p
      528       (input this-procedure
      529       ) .
      530   end .
      531   on alt-shift-f2 anywhere do:
      532     run proc-alt-shift-f2.
      533   end.
      534   on alt-shift-f3 anywhere do:
      535     run proc-alt-shift-f3 in this-procedure .
      536   end.
      537   on alt-shift-f4 anywhere do:
      538     run proc-alt-shift-f4 in this-procedure.
      539   end.
      540   on alt-f1 anywhere do:
      541     run proc-alt-f1 in this-procedure .
      542   end.
      543   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      544   procedure factord :
      545     define input  parameter p-fact-date            as date    no-undo .
      546     define input  parameter p-fact-time            as integer no-undo .
      547     define input  parameter p-fact-num             as integer no-undo .
      548     define input  parameter p-shift-date           as date    no-undo .
      549     define input  parameter p-shift-num            as integer no-undo .
      550     define input  parameter p-shift-on             as logical no-undo .
      551     define output parameter p-fact-order           as decimal no-undo .
      552     define output parameter p-shift-end-fact-order as decimal no-undo .
      553     define output parameter p-day-end-fact-order   as decimal no-undo .
      554     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      555     if p-fact-date = ?
      556     then do:
      557       return error "Не указана фактическая дата" .
      558     end.
      559     define variable v-fact-date-num as integer no-undo .
      560     assign
      561       v-fact-date-num = integer(p-fact-date)
      562     .
      563     if p-fact-num = ?
      564     or p-fact-num = 0
      565     then do:
      566       return error "Не задан p-fact-num " + string(p-fact-num) .
      567     end.
      568     if p-fact-num < 0
      569     then do:
      570       return error "Отрицательный fact-num " + string(p-fact-num) .
      571     end.
      572     if p-fact-num >= 100000000
      573     then do:
      574       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      575     end.
      576     if p-shift-on = true
      577     then do:
      578       if p-shift-date = ?
      579       then do:
      580         return error "Не задана дата смены" .
      581       end.
      582       if p-shift-num = ?
      583       or p-shift-num = 0
      584       then do:
      585         return error "Не задан номер смены" .
      586       end.
      587     end.
      588     else do:
      589       assign
      590         p-shift-date = p-fact-date
      591         p-shift-num  = 24
      592       .
      593     end.
      594     define variable v-shift-offset as integer no-undo .
      595     if p-shift-date = p-fact-date
      596     then do:
      597       assign
      598         v-shift-offset = 1
      599       .
      600     end.
      601     if p-shift-date < p-fact-date
      602     then do:
      603       assign
      604         v-shift-offset = 0
      605       .
      606     end.
      607     if p-shift-date > p-fact-date
      608     then do:
      609       message
      610         vss-workfile vss-revision vss-description skip
      611         "Неправильная дата закрытия смены" skip
      612         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      613         view-as alert-box error .
      614       undo, return error
      615         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      616           ,string(p-fact-date, '99/99/9999':U)
      617           ,string(p-shift-date, '99/99/9999':U)
      618           )
      619       .
      620     end.
      621     if p-shift-num < 1
      622     or p-shift-num > 24
      623     then do:
      624       message
      625         vss-workfile vss-revision vss-description skip
      626         "Неправильный номер смены" skip
      627         "p-shift-num" p-shift-num skip
      628         view-as alert-box error .
      629       undo, return error return-value .
      630     end.
      631     assign
      632       p-fact-order           = v-fact-date-num
      633                              + v-shift-offset * 0.5
      634                              + p-shift-num    * 0.02 - 0.01
      635                              + p-fact-num     * 0.0000000001
      636       p-shift-end-fact-order = v-fact-date-num
      637                              + v-shift-offset * 0.5
      638                              + p-shift-num    * 0.02
      639       p-day-end-fact-order   = v-fact-date-num
      640                              + 0.99
      641     .
      642     if p-fact-order           <= v-fact-date-num
      643     or p-shift-end-fact-order <= v-fact-date-num
      644     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      645     or p-shift-end-fact-order >= p-day-end-fact-order
      646     then do:
      647       message
      648         vss-workfile vss-revision vss-description skip
      649         "Внутренняя ошибка при генерации фактического номера" skip
      650         "p-fact-date"            p-fact-date            skip
      651         "p-fact-time"            p-fact-time            skip
      652         "p-fact-num"             p-fact-num             skip
      653         "p-shift-date"           p-shift-date           skip
      654         "p-shift-num"            p-shift-num            skip
      655         "p-shift-on"             p-shift-on             skip
      656         "p-shift-end-fact-order" p-shift-end-fact-order skip
      657         "p-day-end-fact-order"   p-day-end-fact-order   skip
      658         "v-fact-date-num"        v-fact-date-num        skip
      659         view-as alert-box error .
      660       undo, return error return-value .
      661     end.
      662   end procedure.
      663   procedure day-begin-fact-order :
      664     define input  parameter p-fact-date            as date    no-undo .
      665     define output parameter p-day-begin-fact-order as decimal no-undo .
      666     do
      667     on error undo, return error return-value
      668     :
      669       if p-fact-date = ?
      670       then do:
      671         assign
      672           p-day-begin-fact-order = 0
      673         .
      674       end.
      675       else do:
      676         assign
      677           p-day-begin-fact-order = integer(p-fact-date)
      678         .
      679       end.
      680     end.
      681   end procedure.
      682   procedure factord-max-fact-order :
      683     define output parameter p-max-fact-order as decimal   no-undo .
      684     do
      685     on error undo, return error return-value
      686     :
      687       run day-begin-fact-order in this-procedure
      688         (input  date(1, 1, 5000)
      689         ,output p-max-fact-order
      690         ) .
      691     end.
      692   end procedure.
      693   procedure factord-cut-archive :
      694     define input  parameter p-obj-type             as character no-undo .
      695     define input  parameter p-obj-code             as integer   no-undo .
      696     define input  parameter p-fact-date            as date      no-undo .
      697     define output parameter p-shift-on             as logical   no-undo .
      698     define output parameter p-shift-date           as date      no-undo .
      699     define output parameter p-shift-num            as integer   no-undo .
      700     define output parameter p-day-end-fact-order   as decimal   no-undo .
      701     define output parameter p-shift-end-fact-order as decimal   no-undo .
      702     define variable v-fact-order as decimal   no-undo .
      703     define buffer buf_shift-obj for ub.shift-obj .
      704     do
      705     on error undo, return error return-value
      706     :
      707   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      708   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      709     (input  p-obj-type
      710     ,input  p-obj-code
      711     ,input  'shift-on=request'
      712     ,output p-shift-on
      713     ) no-error .
      714       if error-status :error
      715       then do:
      716         message
      717           vss-workfile vss-revision vss-description skip
      718           "Ошибка при определении атрибута объекта" skip
      719           "Объект" p-obj-type p-obj-code skip
      720           error-status :get-message(1) skip
      721           return-value skip
      722           view-as alert-box error .
      723         undo, return error return-value .
      724       end.
      725       if p-shift-on = false
      726       then do:
      727         assign
      728           p-shift-date               = ?
      729           p-shift-num                = 0
      730         .
      731       end.
      732       else do:
      733         find first buf_shift-obj share-lock
      734           where buf_shift-obj.obj-type   = p-obj-type
      735             and buf_shift-obj.obj-code   = p-obj-code
      736             and buf_shift-obj.shift-date > p-fact-date
      737           use-index pi
      738           no-error .
      739         if not available buf_shift-obj
      740         or buf_shift-obj.status_ <> 'зкр':U
      741         then do:
      742           message
      743             vss-workfile vss-revision vss-description skip
      744             "Невозможно вычислить последнюю смену" skip
      745             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      746             "Объект" p-obj-type p-obj-code skip
      747             "Дата" p-fact-date skip
      748             view-as alert-box error .
      749           undo, return error return-value .
      750         end.
      751         find last buf_shift-obj share-lock
      752           where buf_shift-obj.obj-type = p-obj-type
      753             and buf_shift-obj.obj-code = p-obj-code
      754             and buf_shift-obj.shift-date <= p-fact-date
      755           use-index pi
      756           no-error .
      757         if available buf_shift-obj
      758         then do:
      759           if  buf_shift-obj.status_ = 'зкр':U
      760           then do:
      761             assign
      762               p-shift-date = buf_shift-obj.shift-date
      763               p-shift-num  = buf_shift-obj.shift-num
      764             .
      765           end.
      766           else do:
      767             message
      768               vss-workfile vss-revision vss-description skip
      769               "Невозможно вычислить последнюю смену" skip
      770               "Статус смены отличен от статуса" 'зкр':U skip
      771               "Объект" p-obj-type p-obj-code skip
      772               "Дата" p-fact-date skip
      773               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      774               view-as alert-box error .
      775             undo, return error return-value .
      776           end.
      777         end.
      778         else do:
      779           assign
      780             p-shift-date = p-fact-date - 1
      781             p-shift-num  = 1
      782           .
      783         end.
      784       end.
      785       run factord in this-procedure
      786         (input  p-fact-date
      787         ,input  1
      788         ,input  1
      789         ,input  p-shift-date
      790         ,input  p-shift-num
      791         ,input  p-shift-on
      792         ,output v-fact-order
      793         ,output p-shift-end-fact-order
      794         ,output p-day-end-fact-order
      795         ) no-error .
      796       if error-status :error
      797       then do:
      798         message
      799           vss-workfile vss-revision vss-description skip
      800           "Ошибка при вызове процедуры factord"
      801           error-status :get-message(1) skip
      802           return-value skip
      803           view-as alert-box error .
      804         undo, return error return-value .
      805       end.
      806     end.
      807   end procedure.
      808   procedure factord-lock-shift :
      809     define input  parameter p-obj-type  as character no-undo .
      810     define input  parameter p-obj-code  as integer   no-undo .
      811     define input  parameter p-fact-date as date      no-undo .
      812     define parameter buffer buf_shift-obj for ub.shift-obj .
      813     define variable v-shift-on      as logical   no-undo .
      814     define variable v-extra-message as character no-undo .
      815     define variable v-error as character no-undo .
      816     do
      817     on error undo, return error return-value
      818     :
      819   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      820   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      821     (input  p-obj-type
      822     ,input  p-obj-code
      823     ,input  'shift-on=request'
      824     ,output v-shift-on
      825     ) no-error .
      826       if error-status :error
      827       then do:
      828         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      829         undo, return error v-error .
      830       end.
      831       if v-shift-on = true
      832       then do:
      833         find first buf_shift-obj share-lock
      834           where buf_shift-obj.obj-type   = p-obj-type
      835             and buf_shift-obj.obj-code   = p-obj-code
      836             and buf_shift-obj.shift-date > p-fact-date
      837           use-index pi
      838           no-error .
      839         if not available buf_shift-obj
      840         or buf_shift-obj.status_ <> 'зкр':U
      841         then do:
      842           find last buf_shift-obj
      843             where buf_shift-obj.obj-type = p-obj-type
      844               and buf_shift-obj.obj-code = p-obj-code
      845               and buf_shift-obj.status_  = 'зкр':U
      846             use-index stts
      847             no-error .
      848           if available buf_shift-obj
      849           then do:
      850             assign
      851               v-extra-message =
      852                     substitute("Дата начала последеней закрытой смены на объекте &1"
      853                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      854                               )
      855             .
      856           end.
      857           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      858           undo, return error v-error .
      859         end.
      860       end.
      861     end.
      862   end procedure.
      863   procedure factord-end-day :
      864     define input  parameter p-fact-date            as date    no-undo .
      865     define output parameter p-day-end-fact-order   as decimal no-undo .
      866     do
      867     on error undo, return error return-value
      868     :
      869       if p-fact-date = ?
      870       then do:
      871         return error "Не указана фактическая дата" .
      872       end.
      873       assign
      874         p-day-end-fact-order = integer(p-fact-date) + 0.99
      875       .
      876     end.
      877   end procedure.
      878   procedure factord-to-date :
      879     define input  parameter p-fact-order as decimal no-undo .
      880     define output parameter p-fact-date  as date    no-undo .
      881     define variable v-ref-date  as date      no-undo .
      882     define variable v-ref-delta as integer   no-undo .
      883     do
      884     on error undo, return error return-value
      885     :
      886       if p-fact-order = ?
      887       or p-fact-order = 0
      888       then do:
      889         return error "Не указан fact-order" .
      890       end.
      891       assign
      892         v-ref-date  = date(1, 1, 2000)
      893       .
      894       assign
      895         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      896       .
      897       assign
      898         p-fact-date = v-ref-date + v-ref-delta
      899       .
      900     end.
      901   end procedure.
      902   procedure factord-to-fact-num :
      903     define input  parameter p-fact-order as decimal no-undo .
      904     define output parameter p-fact-num   as integer no-undo .
      905     define variable v-fact-order-trunc as decimal no-undo .
      906     do
      907     on error undo, return error return-value
      908     :
      909       if p-fact-order = ?
      910       or p-fact-order = 0
      911       then do:
      912         return error "Не указан fact-order" .
      913       end.
      914       assign
      915        v-fact-order-trunc = truncate(p-fact-order, 2)
      916       .
      917       assign
      918         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      919       .
      920     end.
      921   end procedure.
      922   procedure factord-to-shift-num :
      923     define input  parameter p-fact-order as decimal no-undo .
      924     define output parameter p-shift-num   as integer no-undo .
      925     define variable  p-shift-numd  as decimal   no-undo .
      926     define variable v-fact-order-trunc as decimal no-undo .
      927     do
      928     on error undo, return error return-value
      929     :
      930       if p-fact-order = ?
      931       or p-fact-order = 0
      932       then do:
      933         return error "Не указан fact-order" .
      934       end.
      935       assign
      936        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      937       .
      938       if v-fact-order-trunc < 0.5 then do:
      939         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      940       end.
      941       assign
      942         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      943         .
      944        assign
      945         p-shift-num = truncate (p-shift-numd , 0)
      946       .
      947     end.
      948   end procedure.
      949   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
