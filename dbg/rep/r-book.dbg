     1395   end procedure.
     1396   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1397   procedure cur-time :
     1398      define output parameter p-today as date      no-undo .
     1399      define output parameter p-time  as integer   no-undo .
     1400     do
     1401     on error undo, return error
     1402     :
     1403       define variable v-date1 as date      no-undo .
     1404       define variable v-date2 as date      no-undo .
     1405       define variable v-time  as integer   no-undo .
     1406       assign
     1407         v-date1 = today
     1408         v-time  = time
     1409         v-date2 = today
     1410       .
     1411       if v-date1 <> v-date2
     1412       then do:
     1413         assign
     1414           v-date1 = today
     1415           v-time  = v-time
     1416         .
     1417       end.
     1418       assign
     1419         p-today = v-date1
     1420         p-time  = v-time
     1421       .
     1422     end.
     1423   end.
     1424   function cur-time-date returns character
     1425   :
     1426     return string(today, '99/99/9999':U) .
     1427   end.
     1428   function cur-time-mjd returns decimal
     1429   :
     1430     define variable v-date as date      no-undo .
     1431     define variable v-time as integer   no-undo .
     1432     run cur-time in this-procedure
     1433       (output v-date
     1434       ,output v-time
     1435       ) .
     1436     return integer(v-date) - 2400002 + (v-time / 86400) .
     1437   end.
     1438   function cur-time-get-ending-index returns integer
     1439   (input p-number as integer
     1440   )
     1441   :
     1442     if p-number < 0
     1443     or p-number = ?
     1444     then do:
     1445       return 1 .
     1446     end.
     1447     define variable v-rest as integer   no-undo .
     1448     assign
     1449       p-number = p-number modulo 100
     1450     .
     1451     if p-number < 20
     1452     then do:
     1453       assign
     1454         v-rest = p-number
     1455       .
     1456     end.
     1457     else do:
     1458       assign
     1459         v-rest = p-number modulo 10
     1460       .
     1461     end.
     1462     case v-rest :
     1463       when 1
     1464       then do:
     1465         return 2 .
     1466       end.
     1467       when 2 or
     1468       when 3 or
     1469       when 4
     1470       then do:
     1471         return 3 .
     1472       end.
     1473       otherwise do:
     1474         return 1 .
     1475       end.
     1476     end case .
     1477   end.
     1478   procedure cur-time-mjd-to-date :
     1479      define input  parameter i-mjd-diff as decimal no-undo.
     1480      define output parameter o-Date     as date    no-undo.
     1481      define output parameter o-Time     as integer no-undo.
     1482      define variable v-day-number as integer   no-undo .
     1483      if    i-mjd-diff < 0
     1484         or i-mjd-diff = ?
     1485      then do:
     1486         return "?" .
     1487      end.
     1488      assign
     1489         v-day-number = truncate(i-mjd-diff,0).
     1490         o-Date = date(v-day-number + 2400002).
     1491         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1492     .
     1493   end.
     1494   function cur-time-mjd-to-string returns character
     1495   (input p-mjd-diff as decimal
     1496   )
     1497   :
     1498     define variable v-day-number as integer   no-undo .
     1499     define variable v-seconds    as integer   no-undo .
     1500     define variable v-hour       as integer   no-undo .
     1501     define variable v-min        as integer   no-undo .
     1502     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1503     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1504     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1505     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1506     if p-mjd-diff < 0
     1507     or p-mjd-diff = ?
     1508     then do:
     1509       return "?" .
     1510     end.
     1511     assign
     1512       v-day-number = integer(truncate(p-mjd-diff,0))
     1513       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1514     .
     1515     if v-seconds > 86400
     1516     then do:
     1517       assign
     1518         v-seconds = 86400 - 1
     1519       .
     1520     end.
     1521     if v-seconds < 0
     1522     then do:
     1523       assign
     1524         v-seconds = 0
     1525       .
     1526     end.
     1527     assign
     1528       v-hour = truncate(v-seconds / 3600, 0)
     1529     .
     1530     assign
     1531       v-seconds = v-seconds modulo 3600
     1532     .
     1533     assign
     1534       v-min = truncate(v-seconds / 60, 0)
     1535     .
     1536     assign
     1537       v-seconds = v-seconds modulo 60
     1538     .
     1539     return
     1540         (if v-day-number <> 0
     1541           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1542           else ""
     1543         )
     1544       + (if v-day-number <> 0 or v-hour <> 0
     1545           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1546           else ""
     1547         )
     1548       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1549           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1550           else ""
     1551         )
     1552       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1553       .
     1554   end.
     1555   function cur-time-string returns character
     1556   :
     1557     define variable v-date as date      no-undo .
     1558     define variable v-time as integer   no-undo .
     1559     run cur-time in this-procedure
     1560       (output v-date
     1561       ,output v-time
     1562       ) .
     1563     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1564   end.
     1565   function cur-time-string-sec returns character
     1566   :
     1567     define variable v-date as date      no-undo .
     1568     define variable v-time as integer   no-undo .
     1569     run cur-time in this-procedure
     1570       (output v-date
     1571       ,output v-time
     1572       ) .
     1573     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1574   end.
     1575   function cur-time-custom  returns character
     1576   (input p-prefix as character
     1577   ,input p-date-format as character
     1578   ,input p-delimiter as character
     1579   ,input p-time-format as character
     1580   ,input p-suffix as character
     1581   )
     1582   :
     1583     define variable v-date as date      no-undo .
     1584     define variable v-time as integer   no-undo .
     1585     run cur-time in this-procedure
     1586       (output v-date
     1587       ,output v-time
     1588       ) .
     1589     return
     1590       p-prefix
     1591       + string(v-date, p-date-format)
     1592       + p-delimiter
     1593       + string(v-time, p-time-format)
     1594       + p-suffix
     1595       .
     1596   end.
     1597   function cur-time-print  returns character
     1598   :
     1599     define variable v-date as date      no-undo .
     1600     define variable v-time as integer   no-undo .
     1601     run cur-time in this-procedure
     1602       (output v-date
     1603       ,output v-time
     1604       ) .
     1605     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1606   end.
     1607   function cur-time-datetime returns datetime
     1608   :
     1609     define variable v-char as character no-undo .
     1610     define variable v-datetime as datetime no-undo .
     1611     v-char = cur-time-string().
     1612     v-datetime = datetime(v-char).
     1613     return  v-datetime.
     1614   end.
     1615   function cur-time-string-msec returns character
     1616   :
     1617     define variable v-date as datetime  no-undo .
     1618     v-date = now.
     1619     return string(v-date) .
     1620   end.
     1621   define variable vss-include-info17 as character format "X(65)" no-undo
     1622   initial "@(#)$Workfile$ $Revision$".
     1623   define stream excel-line.
     1624   define stream excel-cell.
     1625   define temp-table temp_cell-data no-undo
     1626       field data-key as character
     1627       field data-value as character
     1628       index pi is primary unique data-key
     1629   .
     1630   define temp-table temp_line-data no-undo
     1631       field data-key     as character
     1632       field xl-line-id   as integer
     1633       field num          as integer
     1634       field docDateCode  as character
     1635       field payDate      as character
     1636       field inDate       as character
     1637       field cliName      as character
     1638       field cliInn       as character
     1639       field cliKPP       as character
     1640       field countryGds   as character
     1641       field sumRubl      as decimal
     1642       field sumVAT20     as decimal
     1643       field VAT20        as decimal
     1644       field sumVAT10     as decimal
     1645       field VAT10        as decimal
     1646       field sumVAT0      as decimal
     1647       field sumVATno     as decimal
     1648       index pi is primary unique xl-line-id
     1649   .
     1650   define variable v-bookxl-current-data-row     as integer      no-undo.
     1651   define variable v-bookxl-cell-file-name       as character    no-undo.
     1652   define variable v-bookxl-data-file-name       as character    no-undo.
     1653   procedure bookxl-init :
     1654       define buffer buf_temp_cell-data        for temp_cell-data.
     1655       define buffer buf_usr-flt               for ubflt.usr-flt.
     1656   do
     1657   for buf_temp_cell-data
     1658     , buf_usr-flt
     1659   on error undo, return error
     1660   :
     1661       assign
     1662           v-bookxl-current-data-row = 0
     1663       .
     1664       run gbl/_tmpfile.p (
     1665             input "xd"
     1666           , input ".txt"
     1667           , output v-bookxl-data-file-name
     1668       ).
     1669       output stream excel-line to value( v-bookxl-data-file-name ).
     1670       run gbl/_tmpfile.p (
     1671             input "xc"
     1672           , input ".txt"
     1673           , output v-bookxl-cell-file-name
     1674       ).
     1675       output stream excel-cell to value( v-bookxl-cell-file-name ).
     1676           run bookxl-write-cell-data in this-procedure (
     1677                 input "valutCode":U
     1678               , input "0":U
     1679           ).
     1680       run bookxl-write-cell-data in this-procedure (
     1681             input "columnList":U
     1682           , input "num,docDateCode,payDate,inDate,cliName,cliInn,cliKPP,countryGds,sumRubl,sumVAT20,VAT20,sumVAT10,VAT10,sumVAT0,sumVATno":U
     1683       ).
     1684       run bookxl-write-cell-data in this-procedure (
     1685             input "columnType":U
     1686           , input "I,S,S,S,S,S,S,S,D,D,D,D,D,D,D":U
     1687       ).
     1688       run bookxl-write-cell-data in this-procedure (
     1689             input "columnAmount":U
     1690           , input "15":U
     1691       ).
     1692   end.
     1693   end procedure.
     1694   procedure bookxl-close :
     1695   do
     1696   on error undo, return error
     1697   :
     1698       output stream excel-line close.
     1699       output stream excel-cell close.
     1700       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     1701           export "exe/book.xlt":U.
     1702           export "exe/t_97.bas":U.
     1703           export v-bookxl-cell-file-name.
     1704           export v-bookxl-data-file-name.
     1705       output close.
     1706   end.
     1707   end procedure.
     1708   procedure bookxl-write-cell-data :
     1709   define input parameter p-data-key   as character        no-undo.
     1710   define input parameter p-data-value as character        no-undo.
     1711       define buffer buf_temp_cell-data     for temp_cell-data.
     1712   do
     1713   for buf_temp_cell-data
     1714   on error undo, return error
     1715   :
     1716       find first buf_temp_cell-data
     1717            where buf_temp_cell-data.data-key = p-data-key
     1718       no-error.
     1719       if not available buf_temp_cell-data
     1720       then do:
     1721           create buf_temp_cell-data.
     1722           assign
     1723               buf_temp_cell-data.data-key = p-data-key
     1724           .
     1725       end.
     1726       assign
     1727           buf_temp_cell-data.data-value = p-data-value
     1728       .
     1729       put stream excel-cell unformatted
     1730                           buf_temp_cell-data.data-key
     1731           CHR(9)   buf_temp_cell-data.data-value
     1732           chr(10)
     1733       .
     1734   end.
     1735   end procedure.
     1736   procedure bookxl-write-line-data :
     1737   define input parameter p-num            as integer          no-undo.
     1738   define input parameter p-docDateCode    as character        no-undo.
     1739   define input parameter p-payDate        as character        no-undo.
     1740   define input parameter p-inDate         as character        no-undo.
     1741   define input parameter p-cliName        as character        no-undo.
     1742   define input parameter p-cliInn         as character        no-undo.
     1743   define input parameter p-cliKpp         as character        no-undo.
     1744   define input parameter p-countryGds     as character        no-undo.
     1745   define input parameter p-sumRubl        as decimal          no-undo .
     1746   define input parameter p-sumVAT20       as decimal          no-undo.
     1747   define input parameter p-VAT20          as decimal          no-undo.
     1748   define input parameter p-sumVAT10       as decimal          no-undo.
     1749   define input parameter p-VAT10          as decimal          no-undo.
     1750   define input parameter p-sumVAT0        as decimal          no-undo.
     1751   define input parameter p-sumVATno       as decimal          no-undo.
     1752       define buffer buf_temp_line-data        for temp_line-data.
     1753   do
     1754   for buf_temp_line-data
     1755   on error undo, return error
     1756   :
     1757       for each buf_temp_line-data
     1758       :
     1759           delete buf_temp_line-data.
     1760       end.
     1761       create buf_temp_line-data.
     1762       assign
     1763           v-bookxl-current-data-row = v-bookxl-current-data-row + 1
     1764       .
     1765       assign
     1766           buf_temp_line-data.data-key      = "LD":U
     1767           buf_temp_line-data.xl-line-id    = v-bookxl-current-data-row
     1768           buf_temp_line-data.num           = p-num
     1769           buf_temp_line-data.docDateCode   = p-docDateCode
     1770           buf_temp_line-data.payDate       = p-payDate
     1771           buf_temp_line-data.inDate        = p-inDate
     1772           buf_temp_line-data.cliName       = p-cliName
     1773           buf_temp_line-data.cliInn        = p-cliInn
     1774           buf_temp_line-data.cliKPP        = p-cliKPP
     1775           buf_temp_line-data.countryGds    = p-countryGds
     1776           buf_temp_line-data.sumRubl       = p-sumRubl
     1777           buf_temp_line-data.sumVAT20      = p-sumVAT20
     1778           buf_temp_line-data.VAT20         = p-VAT20
     1779           buf_temp_line-data.sumVAT10      = p-sumVAT10
     1780           buf_temp_line-data.VAT10         = p-VAT10
     1781           buf_temp_line-data.sumVAT0       = p-sumVAT0
     1782           buf_temp_line-data.sumVATno      = p-sumVATno
     1783       .
     1784       put stream excel-line unformatted
     1785                           buf_temp_line-data.data-key
     1786           CHR(9)   ( if buf_temp_line-data.num = 0 then "":U else string( buf_temp_line-data.num ) )
     1787           CHR(9)   buf_temp_line-data.docDateCode
     1788           CHR(9)   buf_temp_line-data.payDate
     1789           CHR(9)   buf_temp_line-data.inDate
     1790           CHR(9)   buf_temp_line-data.cliName
     1791           CHR(9)   buf_temp_line-data.cliInn
     1792           CHR(9)   buf_temp_line-data.cliKPP
     1793           CHR(9)   buf_temp_line-data.countryGds
     1794           CHR(9)   buf_temp_line-data.sumRubl
     1795           CHR(9)   buf_temp_line-data.sumVAT20
     1796           CHR(9)   buf_temp_line-data.VAT20
     1797           CHR(9)   buf_temp_line-data.sumVAT10
     1798           CHR(9)   buf_temp_line-data.VAT10
     1799           CHR(9)   buf_temp_line-data.sumVAT0
     1800           CHR(9)   buf_temp_line-data.sumVATno
     1801           chr(10)
     1802       .
     1803   end.
     1804   end procedure.
     1805   procedure bookxl-run-excel :
     1806   define input parameter p-header-filename    as character        no-undo.
     1807   define input parameter p-data-filename      as character        no-undo.
     1808       define variable v-template-file-name    as character    no-undo.
     1809       define variable v-vb-file-name          as character    no-undo.
     1810       define buffer buf_temp-param for temp-param .
     1811   do
     1812   for buf_temp-param
     1813   on error undo, return error
     1814   :
     1815       create buf_temp-param.
     1816       assign
     1817           v-template-file-name    = search( "exe/book.xlt" )
     1818           v-vb-file-name          = search( "exe/t_97.bas")
     1819       .
     1820       if v-template-file-name = ?
     1821       or v-template-file-name = "":U
     1822       then do:
     1823           message
     1824               "Ошибка имени файла шаблона."
     1825           view-as alert-box error.
     1826       end.
     1827       if v-vb-file-name = ?
     1828       or v-vb-file-name = "":U
     1829       then do:
     1830           message
     1831               "Ошибка имени файла кода обработки."
     1832           view-as alert-box error.
     1833       end.
     1834       run paramls-write in this-procedure (
     1835             input "template":U
     1836           , input "template-file-name":U
     1837           , input v-template-file-name
     1838       ).
     1839       run paramls-write in this-procedure (
     1840             input "template":U
     1841           , input "vb-file-name":U
     1842           , input v-vb-file-name
     1843       ).
     1844       run paramls-write in this-procedure (
     1845             input "data":U
     1846           , input "data-header-filename":U
     1847           , input p-header-filename
     1848       ).
     1849       run paramls-write in this-procedure (
     1850             input "data":U
     1851           , input "data-filename":U
     1852           , input p-data-filename
     1853       ).
     1854       run gbl/macroxlt.p (
     1855           input-output table buf_temp-param
     1856       ) no-error.
     1857       if error-status :error
     1858       then do:
     1859           message
     1860                    vss-workfile vss-revision vss-description
     1861               skip(1)
     1862               skip "Ошибка создания файла Excel."
     1863               skip return-value
     1864               skip trim(error-status :get-message(1))
     1865                    trim(error-status :get-message(2))
     1866                    trim(error-status :get-message(3))
     1867           view-as alert-box error.
     1868           undo, return error .
     1869       end.
     1870   end.
     1871   end procedure.
     1872     define variable  v-fact-order-start     as decimal   no-undo .
     1873     define variable  v-fact-order-end       as decimal   no-undo .
     1874     run day-begin-fact-order in this-procedure ( input x-date-start,        output v-fact-order-start ).
     1875     run day-begin-fact-order in this-procedure ( input ( x-date-end + 1 ),  output v-fact-order-end ).
     1876     define variable v-ind                  as integer   no-undo .
     1877     define variable ind                    as integer   no-undo .
     1878     define variable ind1                   as integer   no-undo .
     1879     define variable ii                     as integer initial 0  no-undo .
     1880     define variable jj                     as integer initial 0  no-undo .
     1881     define variable kk                     as integer initial 0  no-undo .
     1882     define variable Counter1               as integer   no-undo .
     1883     define variable Line                   as character no-undo .
     1884     define variable v-row                  as integer   no-undo .
     1885     define variable v-col                  as integer   no-undo .
     1886     define variable v-sum1       as decimal   no-undo .
     1887     define variable v-sum2       as decimal   no-undo .
     1888     define variable v-sum3       as decimal   no-undo .
     1889     define variable v-sum4       as decimal   no-undo .
     1890     define variable v-sum5       as decimal   no-undo .
     1891     define variable v-sum6       as decimal   no-undo .
     1892     define variable v-sum7       as decimal   no-undo .
     1893     define variable v-str  as CHAR  no-undo .
     1894     assign  Counter1 = 0 .
     1895   define variable v-account as integer init 0 no-undo .
     1896   define variable v-account-lavel as character no-undo .
     1897   define variable v-button-stop as logical no-undo .
     1898   define variable v-kol-spice as integer no-undo .
     1899   define variable v-kol-spice2 as integer no-undo .
     1900   define variable v-kol-spice3 as integer no-undo .
     1901   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1902   DEFINE BUTTON StopBtn AUTO-END-KEY
     1903        LABEL "Стоп"
     1904        SIZE 10 BY 1.
     1905   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1906        LABEL "Обработано записей"
     1907         VIEW-AS TEXT
     1908        SIZE 14 BY .67 NO-UNDO.
     1909   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1910         VIEW-AS TEXT
     1911        SIZE 53.25 BY .67
     1912        FGCOLOR 1  NO-UNDO.
     1913   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1914         VIEW-AS TEXT
     1915        SIZE 53.25 BY .67
     1916        FGCOLOR 1  NO-UNDO.
     1917   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1918         VIEW-AS TEXT
     1919        SIZE 53.25 BY .67
     1920        FGCOLOR 1  NO-UNDO.
     1921   DEFINE RECTANGLE RECT-1
     1922        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1923        SIZE 55.13 BY 4.46.
     1924   DEFINE FRAME InfoFrame
     1925        StopBtn AT ROW 4.25 COL 21.75
     1926        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1927        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1928        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1929        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1930        RECT-1 AT ROW 1 COL 1
     1931       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1932            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1933            TITLE "Процесс"
     1934            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1935   define variable mFrameView      as logical   no-undo init yes.
     1936     define variable mFramHandle as handle no-undo.
     1937     mFramHandle = frame InfoFrame:handle.
     1938     if  log-manager:logfile-name ne ?
     1939     then DO:
     1940         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1941         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1942         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1943     end.
     1944     mFrameView = not session:batch-mode and mFramHandle:visible.
     1945     if mFrameView
     1946     then do:
     1947       ASSIGN
     1948          FRAME InfoFrame:HIDDEN                           = TRUE
     1949          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1950     end.
     1951   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1952   DO:
     1953     IF not StopProcessing THEN
     1954       Message "Вы действительно хотите прервать" SKIP
     1955               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1956                 UPDATE StopProcessing.
     1957     IF StopProcessing THEN do:
     1958        if mFrameView
     1959        then do:
     1960           HIDE FRAME InfoFrame.
     1961        end.
     1962     End.
     1963   END.
     1964   assign v-account = ( if integer( 1 ) = 0 then 100 else integer( 1 ) ).
     1965     if  log-manager:logfile-name ne ?
     1966     then DO:
     1967         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1968     end.
     1969     if not session:batch-mode then
     1970     do:
     1971       VIEW FRAME InfoFrame.
     1972       mFrameView = true.
     1973     end.
     1974      v-button-stop = false .
     1975         if mFrameView
     1976         then do:
     1977         if v-button-stop then view STOPBTN in frame InfoFrame.
     1978                          else Hide STOPBTN in frame InfoFrame.
     1979         end.
     1980       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) .
     1981       output close.
     1982       output to value( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".txl" ) .
     1983       output close.
     1984     define buffer buf_schet-fact-doc   for schet-fact-doc .
     1985   if session :set-wait-state( "compiler" ) then.
     1986     Line = fill("-", 250).
     1987     run bookxl-init in this-procedure .
     1988     assign v-ind = v-ind + 1 .
     1989     run prn-lib-open-stream  in this-procedure (input parParentProc,input 43,input yes,input no).
     1990     find first clients no-lock where clients.obj-code = v-cntxt-host-code-obj and clients.obj-type = 'орг':U .
     1991     find first firm no-lock where firm.firm-code = v-cntxt-host-code-obj .
     1992     run PrintTitul in this-procedure .
     1993     run bookxl-write-cell-data in this-procedure ( input "h_organization":U, input clients.obj-name ).
     1994     run bookxl-write-cell-data in this-procedure ( input "h_inn":U         , input firm.inn + "/" + firm.kpp ).
     1995     run bookxl-write-cell-data in this-procedure ( input "h_startDate":U   , input string(x-date-start,"99/99/9999") ).
     1996     run bookxl-write-cell-data in this-procedure ( input "h_endDate":U     , input string(x-date-end,"99/99/9999") ).
     1997     define variable list-sf as character no-undo .
     1998     assign list-sf = "" .
     1999     for each buf_schet-fact-doc no-lock
     2000       where buf_schet-fact-doc.host-code  = v-cntxt-host-code-obj
     2001         AND buf_schet-fact-doc.fact-order >= v-fact-order-start
     2002         AND buf_schet-fact-doc.fact-order < v-fact-order-end
     2003         AND buf_schet-fact-doc.status_    = 'факт':U
     2004         AND buf_schet-fact-doc.doc-type   = 'при':U
     2005     :
     2006       if buf_schet-fact-doc.book-code = "" then do:
     2007         if list-sf <> "" then  assign  list-sf = list-sf + ", " .
     2008         assign  list-sf = list-sf + buf_schet-fact-doc.doc-code + " от " + string(buf_schet-fact-doc.doc-date,"99/99/99") .
     2009         next .
     2010       end.
     2011       run is-page in this-procedure .
     2012       assign
     2013         Counter1 = Counter1 + 1
     2014         v-sum1   = v-sum1 + buf_schet-fact-doc.sum-rubl
     2015         v-sum2   = v-sum2 + buf_schet-fact-doc.sum-VAT-20-rubl
     2016         v-sum3   = v-sum3 + buf_schet-fact-doc.VAT-20-rubl
     2017         v-sum4   = v-sum4 + buf_schet-fact-doc.sum-VAT-10-rubl
     2018         v-sum5   = v-sum5 + buf_schet-fact-doc.VAT-10-rubl
     2019         v-sum6   = v-sum6 + buf_schet-fact-doc.sum-VAT-0-rubl
     2020         v-sum7   = v-sum7 + buf_schet-fact-doc.sum-VAT-no-rubl
     2021       .
     2022   IF ( Counter1 modulo v-account = 0 )  then DO:
     2023             if  log-manager:logfile-name ne ?
     2024             then DO:
     2025                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     2026             end.
     2027              if mFrameView
     2028              then do:
     2029               DISPLAY
     2030                 Counter1 @ RecordsDone
     2031                 WITH FRAME InfoFrame.
     2032              end.
     2033   End.
     2034      if v-button-stop then  DO:
     2035            if mFrameView
     2036            then
     2037               PROCESS EVENTS.
     2038            IF StopProcessing THEN DO:
     2039            RETURN error.
     2040            End.
     2041      end.
     2042       run bookxl-write-line-data in this-procedure (
     2043           input string(Counter1)
     2044         , input string(string(buf_schet-fact-doc.doc-date,"99/99/99") + " " + buf_schet-fact-doc.book-code)
     2045         , input (if buf_schet-fact-doc.pay-date = ? then "" else string(buf_schet-fact-doc.pay-date,"99/99/99") )
     2046         , input (if buf_schet-fact-doc.in-date = ? then "" else string(buf_schet-fact-doc.in-date,"99/99/99") )
     2047         , input buf_schet-fact-doc.cli-name
     2048         , input buf_schet-fact-doc.cli-inn
     2049         , input buf_schet-fact-doc.cli-kpp
     2050         , input string(buf_schet-fact-doc.country + " " + buf_schet-fact-doc.gtd)
     2051         , input buf_schet-fact-doc.sum-rubl
     2052         , input buf_schet-fact-doc.sum-VAT-20-rubl
     2053         , input buf_schet-fact-doc.VAT-20-rubl
     2054         , input buf_schet-fact-doc.sum-VAT-10-rubl
     2055         , input buf_schet-fact-doc.VAT-10-rubl
     2056         , input buf_schet-fact-doc.sum-VAT-0-rubl
     2057         , input buf_schet-fact-doc.sum-VAT-no-rubl
     2058       ).
     2059       put stream PrnLibStream
     2060         "|"  at 1   Counter1       format ">>>9"
     2061         "|"  at 6   buf_schet-fact-doc.doc-date format "99/99/99"
     2062         "|"  at 20   buf_schet-fact-doc.pay-date format "99/99/99"
     2063         "|"  at 29   buf_schet-fact-doc.in-date  format "99/99/99"
     2064         "|"  at 38   buf_schet-fact-doc.cli-name format "X(38)"
     2065         "|"  at 77   buf_schet-fact-doc.cli-inn  format "X(15)"
     2066         "|"  at 93   buf_schet-fact-doc.country  format "X(15)"
     2067         "|"  at 109   buf_schet-fact-doc.sum-rubl        format "->>>>>>>>>9.99"
     2068         "|"  at 124   buf_schet-fact-doc.sum-VAT-20-rubl format "->>>>>>>>>9.99"
     2069         "|"  at 139  buf_schet-fact-doc.VAT-20-rubl     format "->>>>>9.99"
     2070         "|"  at 150  buf_schet-fact-doc.sum-VAT-10-rubl format "->>>>>>>>>9.99"
     2071         "|"  at 165  buf_schet-fact-doc.VAT-10-rubl     format "->>>>>9.99"
     2072         "|"  at 176  buf_schet-fact-doc.sum-VAT-0-rubl  format "->>>>>9.99"
     2073         "|"  at 187  buf_schet-fact-doc.sum-VAT-no-rubl format "->>>>>9.99"
     2074         "|"  at 198
     2075         skip
     2076         "|"  at 1
     2077         "|"  at 6   buf_schet-fact-doc.book-code format "X(12)"
     2078         "|"  at 20
     2079         "|"  at 29
     2080         "|"  at 38
     2081         "|"  at 77   buf_schet-fact-doc.cli-kpp  format "X(15)"
     2082         "|"  at 93   buf_schet-fact-doc.gtd  format "X(15)"
     2083         "|"  at 109
     2084         "|"  at 124
     2085         "|"  at 139
     2086         "|"  at 150
     2087         "|"  at 165
     2088         "|"  at 176
     2089         "|"  at 187
     2090         "|"  at 198
     2091         skip  .
     2092     end.
     2093     run bookxl-write-cell-data in this-procedure ( input "it_sum":U ,      input string( v-sum1 ) ).
     2094     run bookxl-write-cell-data in this-procedure ( input "it_sumVAT20":U , input string( v-sum2 ) ).
     2095     run bookxl-write-cell-data in this-procedure ( input "it_VAT20":U ,    input string( v-sum3 ) ).
