      741   procedure prn-lib-reportviewer :
      742     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      743     define input parameter p-report-name-html as character no-undo .
      744     define input parameter p-param        as character no-undo .
      745     define variable v-excel           as character no-undo init 'TRUE' .
      746     define variable v-value-character as character no-undo .
      747     define variable v-value-integer   as character no-undo .
      748     define variable v-value-date      as date      no-undo .
      749     define variable v-value-decimal   as decimal   no-undo .
      750     define variable rep-excel         as logical   no-undo .
      751     define variable excel-string      as character no-undo .
      752     define variable v-param-type      as character no-undo .
      753     define variable v-tth             as handle    no-undo .
      754     run adm/shattri.p (
      755       input "get":U
      756       ,input  ""
      757       ,input  0
      758       ,input  'report-glob':U
      759       ,input  'rep-excel':U
      760       ,output v-value-character
      761       ,output v-value-date
      762       ,output v-value-decimal
      763       ,output v-value-integer
      764       ,output rep-excel
      765       ,output v-param-type
      766       ,INPUT-OUTPUT table-handle v-tth
      767       )  .
      768     if rep-excel then v-excel = "TRUE" .
      769     else v-excel = "FALSE" .
      770     if p-param eq ""
      771     then
      772        p-param = "EXCEL:" + v-excel.
      773     else
      774        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      775     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      776   end procedure.
      777   define variable g#report-num as integer   no-undo .
      778   run  get-report-num in my-handle (output g#report-num).
      779   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      780   procedure factord :
      781     define input  parameter p-fact-date            as date    no-undo .
      782     define input  parameter p-fact-time            as integer no-undo .
      783     define input  parameter p-fact-num             as integer no-undo .
      784     define input  parameter p-shift-date           as date    no-undo .
      785     define input  parameter p-shift-num            as integer no-undo .
      786     define input  parameter p-shift-on             as logical no-undo .
      787     define output parameter p-fact-order           as decimal no-undo .
      788     define output parameter p-shift-end-fact-order as decimal no-undo .
      789     define output parameter p-day-end-fact-order   as decimal no-undo .
      790     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      791     if p-fact-date = ?
      792     then do:
      793       return error "Не указана фактическая дата" .
      794     end.
      795     define variable v-fact-date-num as integer no-undo .
      796     assign
      797       v-fact-date-num = integer(p-fact-date)
      798     .
      799     if p-fact-num = ?
      800     or p-fact-num = 0
      801     then do:
      802       return error "Не задан p-fact-num " + string(p-fact-num) .
      803     end.
      804     if p-fact-num < 0
      805     then do:
      806       return error "Отрицательный fact-num " + string(p-fact-num) .
      807     end.
      808     if p-fact-num >= 100000000
      809     then do:
      810       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      811     end.
      812     if p-shift-on = true
      813     then do:
      814       if p-shift-date = ?
      815       then do:
      816         return error "Не задана дата смены" .
      817       end.
      818       if p-shift-num = ?
      819       or p-shift-num = 0
      820       then do:
      821         return error "Не задан номер смены" .
      822       end.
      823     end.
      824     else do:
      825       assign
      826         p-shift-date = p-fact-date
      827         p-shift-num  = 24
      828       .
      829     end.
      830     define variable v-shift-offset as integer no-undo .
      831     if p-shift-date = p-fact-date
      832     then do:
      833       assign
      834         v-shift-offset = 1
      835       .
      836     end.
      837     if p-shift-date < p-fact-date
      838     then do:
      839       assign
      840         v-shift-offset = 0
      841       .
      842     end.
      843     if p-shift-date > p-fact-date
      844     then do:
      845       message
      846         vss-workfile vss-revision vss-description skip
      847         "Неправильная дата закрытия смены" skip
      848         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      849         view-as alert-box error .
      850       undo, return error
      851         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      852           ,string(p-fact-date, '99/99/9999':U)
      853           ,string(p-shift-date, '99/99/9999':U)
      854           )
      855       .
      856     end.
      857     if p-shift-num < 1
      858     or p-shift-num > 24
      859     then do:
      860       message
      861         vss-workfile vss-revision vss-description skip
      862         "Неправильный номер смены" skip
      863         "p-shift-num" p-shift-num skip
      864         view-as alert-box error .
      865       undo, return error return-value .
      866     end.
      867     assign
      868       p-fact-order           = v-fact-date-num
      869                              + v-shift-offset * 0.5
      870                              + p-shift-num    * 0.02 - 0.01
      871                              + p-fact-num     * 0.0000000001
      872       p-shift-end-fact-order = v-fact-date-num
      873                              + v-shift-offset * 0.5
      874                              + p-shift-num    * 0.02
      875       p-day-end-fact-order   = v-fact-date-num
      876                              + 0.99
      877     .
      878     if p-fact-order           <= v-fact-date-num
      879     or p-shift-end-fact-order <= v-fact-date-num
      880     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      881     or p-shift-end-fact-order >= p-day-end-fact-order
      882     then do:
      883       message
      884         vss-workfile vss-revision vss-description skip
      885         "Внутренняя ошибка при генерации фактического номера" skip
      886         "p-fact-date"            p-fact-date            skip
      887         "p-fact-time"            p-fact-time            skip
      888         "p-fact-num"             p-fact-num             skip
      889         "p-shift-date"           p-shift-date           skip
      890         "p-shift-num"            p-shift-num            skip
      891         "p-shift-on"             p-shift-on             skip
      892         "p-shift-end-fact-order" p-shift-end-fact-order skip
      893         "p-day-end-fact-order"   p-day-end-fact-order   skip
      894         "v-fact-date-num"        v-fact-date-num        skip
      895         view-as alert-box error .
      896       undo, return error return-value .
      897     end.
      898   end procedure.
      899   procedure day-begin-fact-order :
      900     define input  parameter p-fact-date            as date    no-undo .
      901     define output parameter p-day-begin-fact-order as decimal no-undo .
      902     do
      903     on error undo, return error return-value
      904     :
      905       if p-fact-date = ?
      906       then do:
      907         assign
      908           p-day-begin-fact-order = 0
      909         .
      910       end.
      911       else do:
      912         assign
      913           p-day-begin-fact-order = integer(p-fact-date)
      914         .
      915       end.
      916     end.
      917   end procedure.
      918   procedure factord-max-fact-order :
      919     define output parameter p-max-fact-order as decimal   no-undo .
      920     do
      921     on error undo, return error return-value
      922     :
      923       run day-begin-fact-order in this-procedure
      924         (input  date(1, 1, 5000)
      925         ,output p-max-fact-order
      926         ) .
      927     end.
      928   end procedure.
      929   procedure factord-cut-archive :
      930     define input  parameter p-obj-type             as character no-undo .
      931     define input  parameter p-obj-code             as integer   no-undo .
      932     define input  parameter p-fact-date            as date      no-undo .
      933     define output parameter p-shift-on             as logical   no-undo .
      934     define output parameter p-shift-date           as date      no-undo .
      935     define output parameter p-shift-num            as integer   no-undo .
      936     define output parameter p-day-end-fact-order   as decimal   no-undo .
      937     define output parameter p-shift-end-fact-order as decimal   no-undo .
      938     define variable v-fact-order as decimal   no-undo .
      939     define buffer buf_shift-obj for ub.shift-obj .
      940     do
      941     on error undo, return error return-value
      942     :
      943   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      944   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      945     (input  p-obj-type
      946     ,input  p-obj-code
      947     ,input  'shift-on=request'
      948     ,output p-shift-on
      949     ) no-error .
      950       if error-status :error
      951       then do:
      952         message
      953           vss-workfile vss-revision vss-description skip
      954           "Ошибка при определении атрибута объекта" skip
      955           "Объект" p-obj-type p-obj-code skip
      956           error-status :get-message(1) skip
      957           return-value skip
      958           view-as alert-box error .
      959         undo, return error return-value .
      960       end.
      961       if p-shift-on = false
      962       then do:
      963         assign
      964           p-shift-date               = ?
      965           p-shift-num                = 0
      966         .
      967       end.
      968       else do:
      969         find first buf_shift-obj share-lock
      970           where buf_shift-obj.obj-type   = p-obj-type
      971             and buf_shift-obj.obj-code   = p-obj-code
      972             and buf_shift-obj.shift-date > p-fact-date
      973           use-index pi
      974           no-error .
      975         if not available buf_shift-obj
      976         or buf_shift-obj.status_ <> 'зкр':U
      977         then do:
      978           message
      979             vss-workfile vss-revision vss-description skip
      980             "Невозможно вычислить последнюю смену" skip
      981             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      982             "Объект" p-obj-type p-obj-code skip
      983             "Дата" p-fact-date skip
      984             view-as alert-box error .
      985           undo, return error return-value .
      986         end.
      987         find last buf_shift-obj share-lock
      988           where buf_shift-obj.obj-type = p-obj-type
      989             and buf_shift-obj.obj-code = p-obj-code
      990             and buf_shift-obj.shift-date <= p-fact-date
      991           use-index pi
      992           no-error .
      993         if available buf_shift-obj
      994         then do:
      995           if  buf_shift-obj.status_ = 'зкр':U
      996           then do:
      997             assign
      998               p-shift-date = buf_shift-obj.shift-date
      999               p-shift-num  = buf_shift-obj.shift-num
     1000             .
     1001           end.
     1002           else do:
     1003             message
     1004               vss-workfile vss-revision vss-description skip
     1005               "Невозможно вычислить последнюю смену" skip
     1006               "Статус смены отличен от статуса" 'зкр':U skip
     1007               "Объект" p-obj-type p-obj-code skip
     1008               "Дата" p-fact-date skip
     1009               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1010               view-as alert-box error .
     1011             undo, return error return-value .
     1012           end.
     1013         end.
     1014         else do:
     1015           assign
     1016             p-shift-date = p-fact-date - 1
     1017             p-shift-num  = 1
     1018           .
     1019         end.
     1020       end.
     1021       run factord in this-procedure
     1022         (input  p-fact-date
     1023         ,input  1
     1024         ,input  1
     1025         ,input  p-shift-date
     1026         ,input  p-shift-num
     1027         ,input  p-shift-on
     1028         ,output v-fact-order
     1029         ,output p-shift-end-fact-order
     1030         ,output p-day-end-fact-order
     1031         ) no-error .
     1032       if error-status :error
     1033       then do:
     1034         message
     1035           vss-workfile vss-revision vss-description skip
     1036           "Ошибка при вызове процедуры factord"
     1037           error-status :get-message(1) skip
     1038           return-value skip
     1039           view-as alert-box error .
     1040         undo, return error return-value .
     1041       end.
     1042     end.
     1043   end procedure.
     1044   procedure factord-lock-shift :
     1045     define input  parameter p-obj-type  as character no-undo .
     1046     define input  parameter p-obj-code  as integer   no-undo .
     1047     define input  parameter p-fact-date as date      no-undo .
     1048     define parameter buffer buf_shift-obj for ub.shift-obj .
     1049     define variable v-shift-on      as logical   no-undo .
     1050     define variable v-extra-message as character no-undo .
     1051     define variable v-error as character no-undo .
     1052     do
     1053     on error undo, return error return-value
     1054     :
     1055   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1056   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1057     (input  p-obj-type
     1058     ,input  p-obj-code
     1059     ,input  'shift-on=request'
     1060     ,output v-shift-on
     1061     ) no-error .
     1062       if error-status :error
     1063       then do:
     1064         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1065         undo, return error v-error .
     1066       end.
     1067       if v-shift-on = true
     1068       then do:
     1069         find first buf_shift-obj share-lock
     1070           where buf_shift-obj.obj-type   = p-obj-type
     1071             and buf_shift-obj.obj-code   = p-obj-code
     1072             and buf_shift-obj.shift-date > p-fact-date
     1073           use-index pi
     1074           no-error .
     1075         if not available buf_shift-obj
     1076         or buf_shift-obj.status_ <> 'зкр':U
     1077         then do:
     1078           find last buf_shift-obj
     1079             where buf_shift-obj.obj-type = p-obj-type
     1080               and buf_shift-obj.obj-code = p-obj-code
     1081               and buf_shift-obj.status_  = 'зкр':U
     1082             use-index stts
     1083             no-error .
     1084           if available buf_shift-obj
     1085           then do:
     1086             assign
     1087               v-extra-message =
     1088                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1089                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1090                               )
     1091             .
     1092           end.
     1093           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1094           undo, return error v-error .
     1095         end.
     1096       end.
     1097     end.
     1098   end procedure.
     1099   procedure factord-end-day :
     1100     define input  parameter p-fact-date            as date    no-undo .
     1101     define output parameter p-day-end-fact-order   as decimal no-undo .
     1102     do
     1103     on error undo, return error return-value
     1104     :
     1105       if p-fact-date = ?
     1106       then do:
     1107         return error "Не указана фактическая дата" .
     1108       end.
     1109       assign
     1110         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1111       .
     1112     end.
     1113   end procedure.
     1114   procedure factord-to-date :
     1115     define input  parameter p-fact-order as decimal no-undo .
     1116     define output parameter p-fact-date  as date    no-undo .
     1117     define variable v-ref-date  as date      no-undo .
     1118     define variable v-ref-delta as integer   no-undo .
     1119     do
     1120     on error undo, return error return-value
     1121     :
     1122       if p-fact-order = ?
     1123       or p-fact-order = 0
     1124       then do:
     1125         return error "Не указан fact-order" .
     1126       end.
     1127       assign
     1128         v-ref-date  = date(1, 1, 2000)
     1129       .
     1130       assign
     1131         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1132       .
     1133       assign
     1134         p-fact-date = v-ref-date + v-ref-delta
     1135       .
     1136     end.
     1137   end procedure.
     1138   procedure factord-to-fact-num :
     1139     define input  parameter p-fact-order as decimal no-undo .
     1140     define output parameter p-fact-num   as integer no-undo .
     1141     define variable v-fact-order-trunc as decimal no-undo .
     1142     do
     1143     on error undo, return error return-value
     1144     :
     1145       if p-fact-order = ?
     1146       or p-fact-order = 0
     1147       then do:
     1148         return error "Не указан fact-order" .
     1149       end.
     1150       assign
     1151        v-fact-order-trunc = truncate(p-fact-order, 2)
     1152       .
     1153       assign
     1154         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1155       .
     1156     end.
     1157   end procedure.
     1158   procedure factord-to-shift-num :
     1159     define input  parameter p-fact-order as decimal no-undo .
     1160     define output parameter p-shift-num   as integer no-undo .
     1161     define variable  p-shift-numd  as decimal   no-undo .
     1162     define variable v-fact-order-trunc as decimal no-undo .
     1163     do
     1164     on error undo, return error return-value
     1165     :
     1166       if p-fact-order = ?
     1167       or p-fact-order = 0
     1168       then do:
     1169         return error "Не указан fact-order" .
     1170       end.
     1171       assign
     1172        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1173       .
     1174       if v-fact-order-trunc < 0.5 then do:
     1175         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1176       end.
     1177       assign
     1178         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1179         .
     1180        assign
     1181         p-shift-num = truncate (p-shift-numd , 0)
     1182       .
     1183     end.
     1184   end procedure.
