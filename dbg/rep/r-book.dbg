     2099     run bookxl-write-cell-data in this-procedure ( input "it_sumVATno":U , input string( v-sum7 ) ).
     2100     put stream PrnLibStream  Line format "X(198)"
     2101         "|"  at 1
     2102          "ВСЕГО" format "X(29)" at 38
     2103         "|"  at 109   v-sum1 format "->>>>>>>>>9.99"
     2104         "|"  at 124   v-sum2 format "->>>>>>>>>9.99"
     2105         "|"  at 139  v-sum3 format "->>>>>9.99"
     2106         "|"  at 150  v-sum4 format "->>>>>>>>>9.99"
     2107         "|"  at 165  v-sum5 format "->>>>>9.99"
     2108         "|"  at 176  v-sum6 format "->>>>>9.99"
     2109         "|"  at 187  v-sum7 format "->>>>>9.99"
     2110         "|"  at 198
     2111         skip
     2112         Line format "X(198)"   skip   "    Гл. бухгалтер" format "X(30)"
     2113     .
     2114     HIDE stream PrnLibStream FRAME BottomFrame .
     2115     OUTPUT stream PrnLibStream CLOSE.
     2116     run bookxl-close in this-procedure .
     2117   if mFrameView
     2118   then do:
     2119      HIDE FRAME InfoFrame.
     2120   end.
     2121   if session :set-wait-state( "" ) then.
     2122     if list-sf <> "" then
     2123       message
     2124         "В выбранном периоде есть закрытые счета-фактуры "  skip
     2125         list-sf  skip
     2126         "не имеющие номера в книге. Отчет сформирован без них."
     2127         view-as alert-box.
     2128     os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" ) .
     2129     os-rename
     2130         value(  string( session:temp-directory ) + "$" + string( g#report-num ) + ".txl" )
     2131         value(  string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )
     2132     .
     2133     run prn-lib-prn-file in this-procedure (input parParentProc,input 8).
     2134     os-delete value( string( session:temp-directory ) +  "$" + string( g#report-num ) + ".txl" ) .
     2135     os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" ) .
     2136   end.
     2137   procedure is-page :
     2138     do on error undo, return error return-value :
     2139       if line-counter( PrnLibStream ) + 3 > page-size( PrnLibStream ) then do:
     2140         put stream PrnLibStream  skip Line format "X(198)" skip "продолжение - на следующей странице" AT 30 SKIP .
     2141         page stream PrnLibStream .
     2142         run PrintTitul .
     2143       end.
     2144     end.
     2145   end procedure.
     2146   procedure PrintTitul :
     2147     do
     2148     on error undo, return error return-value
     2149     :
     2150       PUT stream PrnLibStream
     2151         SPACE(30) "КНИГА ПОКУПОК" format "X(100)" SKIP
     2152         string("Покупатель: " + clients.obj-name)  format "X(100)" SKIP
     2153         string("Идентификационный номер налогоплательщика-покупателя: " + firm.inn  + "/" + firm.kpp )  format "X(100)" SKIP
     2154         string("Покупка за период с: " + string(x-date-start,"99/99/9999") + "г. по: "  + string(x-date-end, "99/99/9999") + "г.")   format "X(100)" SKIP
     2155       .
     2156       put stream PrnLibStream   string( "Страница" ) AT 145 PAGE-NUMBER( PrnLibStream ) AT 155 FORMAT ">>9" SKIP .
     2157       put stream PrnLibStream  Line format "X(198)"  skip
