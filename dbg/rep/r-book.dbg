     1217   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     1218     if num-entries(string(p-dec), '.') = 2
     1219       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     1220       else return( string(p-dec)) .
     1221   end function.
     1222   function format-point-to-comma returns char (input orig as char ) .
     1223   define variable rtext as character no-undo .
     1224   define variable strt as integer no-undo .
     1225   define variable leng as integer no-undo .
     1226   assign rtext = orig .
     1227   repeat:
     1228     strt =  index(rtext,'.').
     1229     if strt = 0 then leave.
     1230     leng = 1.
     1231     substring(rtext,strt,leng,"character") = v-delim .
     1232   end.
     1233   return rtext.
     1234   end function.
     1235   function format-excel-text returns char ( input start-text as char ) :
     1236   def var  i    as int no-undo.
     1237   def var  ch   as char no-undo.
     1238   def var  n    as int no-undo.
     1239   def var  ipos as int no-undo.
     1240     n = num-entries(trim(start-text), chr(10)) - 1 .
     1241     do i = 1 to n :
     1242       ipos = index( start-text, chr(10)).
     1243       if ipos > 0 then
     1244         substr( start-text, ipos, 1 ) = ' '.
     1245     end.
     1246     n = num-entries(trim(start-text), chr(13)) - 1 .
     1247     do i = 1 to n :
     1248       ipos = index( start-text, chr(13)).
     1249       if ipos > 0 then
     1250         substr( start-text, ipos, 1 ) = ' '.
     1251     end.
     1252     if index( start-text, '"' ) = 0 then
     1253       start-text =  '="'   + trim( start-text) + '"'   .
     1254       else do:
     1255         n = num-entries(trim(start-text), '"') - 1.
     1256         do i = 1 to n :
     1257           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1258         end.
     1259         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1260         start-text = '="'  + ch  + '"' .
     1261       end.
     1262     return start-text.
     1263   end.
     1264   function excel-sum returns char (input p-dec as decimal ).
     1265     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     1266   end function.
     1267   function excel-qnty returns char (input p-dec as decimal ).
     1268     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     1269   end function.
     1270   function format-excel-text-macr returns char ( input start-text as char ) :
     1271   def var  i    as int no-undo.
     1272   def var  ch   as char no-undo.
     1273   def var  n    as int no-undo.
     1274   def var  ipos as int no-undo.
     1275     n = num-entries(trim(start-text), chr(10)) - 1 .
     1276     do i = 1 to n :
     1277       ipos = index( start-text, chr(10)).
     1278       if ipos > 0 then
     1279         substring( start-text, ipos , 1 ) = ' '.
     1280     end.
     1281     n = num-entries(trim(start-text), chr(13)) - 1 .
     1282     do i = 1 to n :
     1283       ipos = index( start-text, chr(13)).
     1284       if ipos > 0 then
     1285         substring( start-text, ipos, 1 ) = ' '.
     1286     end.
     1287     if index( start-text, '"' ) = 0 then
     1288       start-text =  '"'   + trim( start-text) + '"'   .
     1289       else do:
     1290         n = num-entries(trim(start-text), '"') - 1.
     1291         do i = 1 to n :
     1292           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1293         end.
     1294         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1295         start-text = '"'  + ch  + '"' .
     1296       end.
     1297     n = num-entries(trim(start-text), chr(10)) - 1 .
     1298     do i = 1 to n :
     1299       ipos = index( start-text, chr(10)).
     1300       if ipos > 0 then
     1301         substring( start-text, ipos , 1 ) = ' '.
     1302     end.
     1303       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     1304     return start-text.
     1305   end.
     1306   def var vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1307   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     1308   procedure paramls-clear :
     1309     define buffer buf_temp-param for temp-param .
     1310     do
     1311     on error undo, return error return-value
     1312     :
     1313       for each buf_temp-param
     1314       on error undo, return error
     1315       :
     1316         delete buf_temp-param .
     1317       end.
     1318     end.
     1319   end procedure.
     1320   procedure paramls-write :
     1321     define input  parameter p-code     as character no-undo .
     1322     define input  parameter p-sub-code as character no-undo .
     1323     define input  parameter p-value    as character no-undo .
     1324     define buffer buf_temp-param for temp-param .
     1325     do
     1326     on error undo, return error return-value
     1327     :
     1328       find first buf_temp-param
     1329         where buf_temp-param.param-code     = p-code
     1330           and buf_temp-param.param-sub-code = p-sub-code
     1331         no-error .
     1332       if not available buf_temp-param then do:
     1333         create buf_temp-param .
     1334         assign
     1335           buf_temp-param.param-code     = p-code
     1336           buf_temp-param.param-sub-code = p-sub-code
     1337         .
     1338       end.
     1339       assign
     1340         buf_temp-param.param-value = p-value
     1341       .
     1342     end.
     1343   end procedure.
     1344   procedure paramls-read :
     1345     define input  parameter p-code          as character no-undo .
     1346     define input  parameter p-sub-code      as character no-undo .
     1347     define input  parameter p-default-value as character no-undo .
     1348     define output parameter p-value         as character no-undo .
     1349     define buffer buf_temp-param for temp-param .
     1350     do
     1351     on error undo, return error return-value
     1352     :
     1353       find first buf_temp-param
     1354         where buf_temp-param.param-code     = p-code
     1355           and buf_temp-param.param-sub-code = p-sub-code
     1356         no-error .
     1357       if available buf_temp-param then do:
     1358         assign
     1359           p-value = buf_temp-param.param-value
     1360         .
     1361       end.
     1362       else do:
     1363         assign
     1364           p-value = p-default-value
     1365         .
     1366       end.
     1367     end.
     1368   end procedure.
     1369   procedure paramls-append :
     1370     define input  parameter p-code     as character no-undo .
     1371     define input  parameter p-sub-code as character no-undo .
     1372     define input  parameter p-value    as character no-undo .
     1373     define buffer buf_temp-param for temp-param .
     1374     do
     1375     on error undo, return error return-value
     1376     :
     1377       find first buf_temp-param
     1378            where buf_temp-param.param-code     = p-code
     1379              and buf_temp-param.param-sub-code = p-sub-code
     1380         no-error .
     1381       if not available buf_temp-param then do:
     1382         create buf_temp-param .
     1383         assign
     1384           buf_temp-param.param-code     = p-code
     1385           buf_temp-param.param-sub-code = p-sub-code
     1386           buf_temp-param.param-value    = p-value
     1387         .
     1388       end.
     1389       else do:
