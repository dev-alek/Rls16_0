      583   define variable sym6  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      584   define variable sym7  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      585   define variable sym8  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      586   define variable sym9  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      587   define variable sym10 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      588   define variable sym11 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      589   define variable sym12 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      590   define variable sym13 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      591   define variable sym14 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      592   define variable sym15 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      593   define variable sym16 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      594   define variable sym17 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      595   define variable sym18 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      596   define variable sym19 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      597   define variable sym20 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      598   define variable sym21 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      599   define variable sym22 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      600   define variable sym23 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      601   define variable sym24 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      602   define variable sym25 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      603   define variable sym26 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      604   define variable sym27 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      605   define variable temp1 as integer   no-undo.
      606   DEFINE VARIABLE parParentProc     AS WIDGET-HANDLE NO-UNDO.
      607   ASSIGN parParentProc =  my-handle .
      608     define variable g#report-num as integer   no-undo .
      609     run get-report-num  in parParentProc ( output g#report-num ).
      610     define buffer buf_shift-obj  for shift-obj .
      611     define buffer buf_clients    for clients .
      612     define variable Counter1 as integer initial 0   no-undo .
      613     define variable Line     as character no-undo .
      614     define variable name     as character no-undo .
      615     define variable dat      as date      no-undo .
      616     define variable dat1     as date      no-undo .
      617     define variable num      as character no-undo .
      618   define variable v-account as integer init 0 no-undo .
      619   define variable v-account-lavel as character no-undo .
      620   define variable v-button-stop as logical no-undo .
      621   define variable v-kol-spice as integer no-undo .
      622   define variable v-kol-spice2 as integer no-undo .
      623   define variable v-kol-spice3 as integer no-undo .
      624   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
      625   DEFINE BUTTON StopBtn AUTO-END-KEY
      626        LABEL "Стоп"
      627        SIZE 10 BY 1.
      628   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
      629        LABEL "Обработано записей"
      630         VIEW-AS TEXT
      631        SIZE 14 BY .67 NO-UNDO.
      632   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
      633         VIEW-AS TEXT
      634        SIZE 53.25 BY .67
      635        FGCOLOR 1  NO-UNDO.
      636   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
      637         VIEW-AS TEXT
      638        SIZE 53.25 BY .67
      639        FGCOLOR 1  NO-UNDO.
      640   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
      641         VIEW-AS TEXT
      642        SIZE 53.25 BY .67
      643        FGCOLOR 1  NO-UNDO.
      644   DEFINE RECTANGLE RECT-1
      645        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      646        SIZE 55.13 BY 4.46.
      647   DEFINE FRAME InfoFrame
      648        StopBtn AT ROW 4.25 COL 21.75
      649        RecordsString AT ROW 1.21 COL 2 NO-LABEL
      650        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
      651        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
      652        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
      653        RECT-1 AT ROW 1 COL 1
      654       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      655            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      656            TITLE "Процесс"
      657            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
      658   define variable mFrameView      as logical   no-undo init yes.
      659     define variable mFramHandle as handle no-undo.
      660     mFramHandle = frame InfoFrame:handle.
      661     if  log-manager:logfile-name ne ?
      662     then DO:
      663         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      664         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      665         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
      666     end.
      667     mFrameView = not session:batch-mode and mFramHandle:visible.
      668     if mFrameView
      669     then do:
      670       ASSIGN
      671          FRAME InfoFrame:HIDDEN                           = TRUE
      672          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
      673     end.
      674   ON CHOOSE OF StopBtn IN FRAME InfoFrame
      675   DO:
      676     IF not StopProcessing THEN
      677       Message "Вы действительно хотите прервать" SKIP
      678               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
      679                 UPDATE StopProcessing.
      680     IF StopProcessing THEN do:
      681        if mFrameView
      682        then do:
      683           HIDE FRAME InfoFrame.
      684        end.
      685     End.
      686   END.
      687   assign v-account = ( if integer( 1 ) = 0 then 100 else integer( 1 ) ).
      688     if  log-manager:logfile-name ne ?
      689     then DO:
      690         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
      691     end.
      692     if not session:batch-mode then
      693     do:
      694       VIEW FRAME InfoFrame.
      695       mFrameView = true.
      696     end.
      697      v-button-stop = false .
      698         if mFrameView
      699         then do:
      700         if v-button-stop then view STOPBTN in frame InfoFrame.
      701                          else Hide STOPBTN in frame InfoFrame.
      702         end.
      703   if session :set-wait-state( "compiler" ) then.
      704     Line = fill("-", 250).
      705     DEFINE frame f-doc
      706         sym1 at 8  name     column-label " Объект "       format "X(59)"        space(0)
      707         sym2  num           column-label "Номер!смены"    format "X(6)"         space(0)
      708         sym3  dat           column-label "  Дата! смены"  format "99.99.9999"   space(0)
      709         sym4  dat1          column-label "  Дата!объекта" format "99.99.9999"   space(0)
      710         sym5
      711       HEADER
      712         string( "Дата печати : " + string(TODAY , "99.99.9999") + " , " + string(TIME, "HH:MM") ) AT 10 format "X(60)"
      713         string( "Страница " + string( PAGE-NUMBER( OutStream )  , ">>9") ) AT 80 format "X(15)" SKIP
      714         Line at 8 format "X(94)"
      715     with width 160 down stream-io.
      716   output stream OutStream to value( string( session:temp-directory +
      717                                        "rpt" + string( g#report-num ) ) )
      718                                        page-size 62 .
      719     FORM HEADER
      720         "       " Line format "X(94)" AT 1 SKIP
      721         "Продолжение - на следующей странице" AT 30 SKIP
      722         with FRAME BottomFrame width 160 PAGE-BOTTOM NO-LABELS NO-BOX .
      723     VIEW stream OutStream FRAME BottomFrame .
      724     FORM with FRAME f-doc .
      725     PUT stream OutStream SPACE(30) "Отчет о текущих датах на объектах. " format "X(45)"  SKIP .
      726     for each obj-list :
      727       assign Counter1 = Counter1 + 1.
      728   IF ( Counter1 modulo v-account = 0 )  then DO:
      729             if  log-manager:logfile-name ne ?
      730             then DO:
      731                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
      732             end.
      733              if mFrameView
      734              then do:
      735               DISPLAY
      736                 Counter1 @ RecordsDone
      737                 WITH FRAME InfoFrame.
      738              end.
      739   End.
      740      if v-button-stop then  DO:
      741            if mFrameView
      742            then
      743               PROCESS EVENTS.
      744            IF StopProcessing THEN DO:
      745            RETURN error.
      746            End.
      747      end.
      748       find first buf_clients no-lock
      749         where buf_clients.obj-type  = obj-list.obj-type
      750           and buf_clients.obj-code  = obj-list.obj-code
      751       no-error .
      752       assign name = buf_clients.obj-name + " (" + buf_clients.obj-type + '#' + string(buf_clients.obj-code) + ")"  .
      753       find first buf_shift-obj no-lock
      754         where buf_shift-obj.obj-type  = obj-list.obj-type
      755           and buf_shift-obj.obj-code  = obj-list.obj-code
      756           and buf_shift-obj.status_   = 'тек':U
      757       no-error .
      758       if available buf_shift-obj then
      759         assign
      760           dat = buf_shift-obj.shift-date
      761           num = (if buf_shift-obj.shift-name = string (buf_shift-obj.shift-num) then buf_shift-obj.shift-name else buf_shift-obj.shift-name + "(" + string(buf_shift-obj.shift-name) + ")")
      762         .
      763       else
      764         assign
      765           dat = ?
      766           num = ""
      767         .
      768   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      769   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdtget in g#library
      770     (input  obj-list.obj-type
      771     ,input  obj-list.obj-code
      772     ,output dat1
      773     )  .
      774       display stream outstream  sym1 at 8 name sym2  num  sym3 dat sym4 dat1 sym5  with frame f-doc.
      775       down stream outstream with frame f-doc .
      776     end.
      777     PUT STREAM OutStream  Line at 8 format "X(94)"  .
      778     HIDE stream OutStream FRAME BottomFrame .
      779     OUTPUT stream OutStream CLOSE.
      780   if mFrameView
      781   then do:
      782      HIDE FRAME InfoFrame.
      783   end.
      784   if session :set-wait-state( "" ) then.
      785     define variable v-user-action as character no-undo .
      786     define variable v-printed as logical   no-undo .
      787     run gbl/prnfilen.w
      788       (input  ""
      789       ,input  0
      790       ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
      791       ,input  7
      792       ,output v-user-action
      793       ,output v-printed
      794       ) .
      795   end.
