     5705   procedure nutro_proc-get-calories :
     5706     define input  parameter p-artic         as character no-undo .
     5707     define input  parameter p-prod-type     as character no-undo .
     5708     define input  parameter p-prod-code     as integer   no-undo .
     5709     define input  parameter p-obj-type      as character no-undo .
     5710     define input  parameter p-obj-code      as integer   no-undo .
     5711     define output parameter p-calories      as decimal   no-undo .
     5712     define buffer buf_goods    for ub.goods .
     5713     define variable v-attr-value    as character no-undo .
     5714     define variable v-attr-type     as character no-undo .
     5715     define variable v-calories      as decimal   no-undo .
     5716     define variable v-protein       as decimal   no-undo .
     5717     define variable v-carbohydrate  as decimal   no-undo .
