     6136                                if error-status :error then
     6137                                message vss-workfile vss-revision vss-description skip
     6138                                       "Ошибка get-brutto-netto-seson  " skip
     6139                                        skip
     6140                                        error-status :get-message(1) skip
     6141                                        return-value skip
     6142                                        view-as alert-box error
     6143                                .
     6144                                brutto   = v-se-qnty-brutto / recipe.portion-qnty .
     6145                                netto    = v-se-qnty-netto  / recipe.portion-qnty .
     6146                                netto10  = netto * 10  .
     6147                                netto20  = netto * 20  .
     6148                                netto30  = netto * 30  .
     6149                                netto40  = netto * 40  .
     6150                                netto50  = netto * 50  .
     6151                                netto60  = netto * 60  .
     6152                                netto100 = netto * 100 .
     6153               DISPLAY stream OutStream
     6154                               sym1 recipe-gds.artic
     6155                               sym2 goods.gds-name
     6156                               sym3 goods.unit-base
     6157                               sym4 netto
     6158                               sym5 brutto
     6159                               sym6 netto10
     6160                               sym9 netto20
     6161                               sym10 netto30
     6162                               sym11 netto40
     6163                               sym12 netto50
     6164                               sym13 netto60
     6165                               sym7 netto100
     6166                               sym8    with frame teh-card  .
     6167               DOWN stream OutStream 1 with frame teh-card  .
     6168               assign
     6169                 ii =  ii + 1
     6170                 brutto   = 0
     6171                 netto    = 0
     6172                 netto10  = 0
     6173                 netto20  = 0
     6174                 netto30  = 0
     6175                 netto40  = 0
     6176                 netto50  = 0
     6177                 netto60  = 0
     6178                 netto100 = 0
     6179              .
     6180         end.
     6181     put stream  OutStream  Line format "X(157)" AT 1 skip(2).
     6182     run print-nutrition in this-procedure ( input recipe.artic
     6183                                           , input recipe.prod-type
     6184                                           , input recipe.prod-code
     6185                                           ) .
     6186     run on-same-page in this-procedure (input 11) .
     6187     run PrintPodval in this-procedure .
     6188     page stream OutStream .
     6189   end.
     6190   HIDE   STREAM OutStream FRAME teh-card .
     6191   HIDE   stream OutStream FRAME BottomFrame .
     6192   HIDE   stream OutStream FRAME BottomFrame2 .
     6193   output stream OutStream CLOSE .
     6194   if mFrameView
     6195   then do:
     6196      HIDE FRAME InfoFrame.
     6197   end.
     6198     define variable v-user-action as character no-undo .
     6199     define variable v-printed as logical   no-undo .
     6200      if p-type = "recipe":U then
     6201          run gbl/prnfilen.w
     6202            (input  ""
     6203            ,input  8
     6204            ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     6205            ,input  7
     6206            ,output v-user-action
     6207            ,output v-printed
     6208            ) .
     6209      else do:
     6210   if g#quest-print = false
     6211   then do:
     6212     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     6213                                         7, (if 8 >= 8 then 2 else 0), 0, 0,
     6214                                         OUTPUT g#log ).
     6215   end.
     6216   else do:
     6217     os-command silent
     6218       value( "COPY /b " +
     6219         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     6220         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     6221         string( session:temp-directory) +  "$" + string( g#report-num )
     6222                 ) .
     6223     os-command silent
     6224       value( "COPY /b " +
     6225         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     6226         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     6227         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     6228                 ) .
     6229   end.
     6230      end.
     6231   end.
     6232   procedure PrintTitul :
     6233     do  on error undo, return error return-value  :
     6234   define variable v-host-code    as integer      no-undo.
     6235   define variable v-host-name    as character    no-undo.
     6236   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6237   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
     6238     (input  v-cntxt-obj-type
     6239     ,input  v-cntxt-obj-code
     6240     ,output v-host-code
     6241     ,output v-host-name
     6242     )  .
     6243   PUT STREAM OutStream UNFORMATTED
     6244   CAPS( v-host-name )   format "x(30)"
     6245   skip "Название блюда   : " + CAPS( buf_init-goods.gds-name ) + " ( арт. " + buf_init-goods.artic + ")"  format "x(120)"
     6246   skip "Название рецепта : " + CAPS( recipe.recipe-name )                                    format "x(120)"
     6247   skip "Номер рецепта    : " +  string( recipe.recipe-code)                                   format "x(60)"
     6248   skip "Номер блюда по сборнику рецептур : " + string ( recipe.recipe-ref-num )             format "x(60)"
     6249   skip "Вес готового продукта в гр. : " + string (1000 * recipe.portion-weight )                 format "x(60)"
     6250   skip
     6251   .
     6252    PUT STREAM OutStream UNFORMATTED
     6253       space(50) string( " ТЕХНОЛОГИЧЕСКАЯ КАРТА "   )           skip
     6254                         "УТВЕРЖДАЮ"              format "X(9)"  AT 120  skip
     6255                         "______________________" format "X(20)" AT 120  skip
     6256                         "______________________" format "X(20)" AT 120 "/___________________/"
     6257                         "подпись"                               AT 120 "            расшифровка подписи"
     6258                         skip
     6259         .
     6260    if p-type = "recipe":U then
     6261    PUT STREAM OutStream UNFORMATTED
     6262        "Дата составления " + cur-time-date()   at 120 skip   .
     6263        else
     6264    PUT STREAM OutStream UNFORMATTED
     6265        "Дата составления " + p-type   at 120 skip   .
     6266    define variable v-max as integer no-undo .
     6267    define variable v-max-dop as integer no-undo .
     6268    define variable v as integer no-undo .
     6269     define variable vvv as character no-undo .
     6270    PUT STREAM OutStream UNFORMATTED
     6271    "Описание технологии приготовления :  "     format "x(60)"  skip.
     6272    vvv =  recipe.recipe-technique.
     6273    v-max = ( integer (length(vvv) / 225 ) ) .  if (  length(vvv) modulo 225  ) > 0 then  v-max-dop = 1 . else v-max-dop = 0  .  if vvv <> "" then do:      PUT STREAM OutStream UNFORMATTED             space(5) substring( vvv , 1 , 225)  format "x(225)"  skip.     repeat v = 1 to v-max + v-max-dop :         if substring( vvv , 225 * v , 225) <> "" then           PUT STREAM OutStream UNFORMATTED           space(5) substring( vvv , 225 * v , 225)  format "x(225)"  skip.     end.  end.
     6274    PUT STREAM OutStream UNFORMATTED
     6275    "Показатели качества готовой продукции :  "    format "x(60)"  skip.
     6276    vvv =  recipe.recipe-quality.
     6277    v-max = ( integer (length(vvv) / 225 ) ) .  if (  length(vvv) modulo 225  ) > 0 then  v-max-dop = 1 . else v-max-dop = 0  .  if vvv <> "" then do:      PUT STREAM OutStream UNFORMATTED             space(5) substring( vvv , 1 , 225)  format "x(225)"  skip.     repeat v = 1 to v-max + v-max-dop :         if substring( vvv , 225 * v , 225) <> "" then           PUT STREAM OutStream UNFORMATTED           space(5) substring( vvv , 225 * v , 225)  format "x(225)"  skip.     end.  end.
     6278    PUT STREAM OutStream UNFORMATTED
     6279    "Способ оформления блюда :  "    format "x(60)"  skip.
     6280    vvv =  recipe.recipe-design.
     6281    v-max = ( integer (length(vvv) / 225 ) ) .  if (  length(vvv) modulo 225  ) > 0 then  v-max-dop = 1 . else v-max-dop = 0  .  if vvv <> "" then do:      PUT STREAM OutStream UNFORMATTED             space(5) substring( vvv , 1 , 225)  format "x(225)"  skip.     repeat v = 1 to v-max + v-max-dop :         if substring( vvv , 225 * v , 225) <> "" then           PUT STREAM OutStream UNFORMATTED           space(5) substring( vvv , 225 * v , 225)  format "x(225)"  skip.     end.  end.
     6282     end.
     6283   end procedure.
     6284   procedure PrintPodval :
     6285     do on error undo, return error return-value  :
     6286     define variable pp as integer no-undo .
     6287     define variable rr as integer no-undo .
     6288     PUT  STREAM OutStream
     6289           skip (2)
     6290         " Заведующий производством _______________________ " skip
     6291         " Калькуляцию составил     _______________________ " skip
     6292         .
     6293     end.
     6294   end procedure.
     6295   PROCEDURE on-same-page :
     6296     define input parameter p-line-number as integer  no-undo .
     6297     if p-line-number > page-size( OutStream ) then return .
     6298     if line-counter( OutStream ) + p-line-number > page-size( OutStream ) then  page stream OutStream .
     6299   end procedure.
     6300   procedure get-brutto-netto-seson :
     6301    do
     6302    on error undo, return error return-value
     6303    :
     6304   define input parameter p-artic     like  ub.goods.artic      no-undo.
     6305   define input parameter p-prod-type like  ub.goods.prod-type  no-undo.
     6306   define input parameter p-prod-code like  ub.goods.prod-code  no-undo.
     6307   define input parameter p-recipe-code like ub.recipe-gds.recipe-code no-undo.
     6308   define output parameter p-se-qnty as decimal no-undo .
     6309   define output parameter p-se-qnty-netto as decimal no-undo .
     6310   define buffer local-recipe-gds for  ub.recipe-gds  .
     6311   define buffer bf_goods for ub.goods.
     6312   define variable varcoeff as decimal no-undo.
     6313   find first bf_goods no-lock where
     6314             bf_goods.artic     = p-artic and
     6315             bf_goods.prod-type = p-prod-type and
     6316             bf_goods.prod-code = p-prod-code no-error .
     6317   if error-status :error then return error .
     6318   find first local-recipe-gds no-lock where
     6319             local-recipe-gds.recipe-code = p-recipe-code and
     6320             local-recipe-gds.artic       = p-artic and
     6321             local-recipe-gds.prod-type   = p-prod-type and
     6322             local-recipe-gds.prod-code   = p-prod-code no-error .
     6323   if error-status :error then return error .
     6324    run fbrlib-s-coeff-value in this-procedure
     6325      (input bf_goods.gds-code,
     6326       input varobj-date,
     6327       input v-cntxt-obj-type,
     6328       input v-cntxt-obj-code,
     6329       output varcoeff
     6330       ).
     6331    varcoeff = 1.
     6332    p-se-qnty =       local-recipe-gds.brutto-qnty * varcoeff.
     6333    p-se-qnty-netto = local-recipe-gds.qnty        * varcoeff.
     6334    end.
     6335   end procedure.
     6336   procedure print-nutrition :
     6337     define input  parameter p-artic     as character no-undo .
     6338     define input  parameter p-prod-type as character no-undo .
     6339     define input  parameter p-prod-code as integer   no-undo .
     6340     define buffer buf_goods for ub.goods.
     6341     define variable v-calories      as decimal   no-undo .
     6342     define variable v-protein       as decimal   no-undo .
     6343     define variable v-carbohydrate  as decimal   no-undo .
     6344     define variable v-fat           as decimal   no-undo .
     6345   do
     6346   on error undo, return error return-value
     6347   :
     6348     find first buf_goods no-lock
     6349       where buf_goods.artic     = p-artic
     6350         and buf_goods.prod-type = p-prod-type
     6351         and buf_goods.prod-code = p-prod-code
     6352     no-error .
     6353     if not available buf_goods
     6354     then do:
     6355       message
     6356         substitute( "Не найден товар &1 &2 &3"
     6357                   , p-artic
     6358                   , p-prod-type
     6359                   , p-prod-code
     6360                   )
     6361       view-as alert-box error.
     6362       return .
     6363     end.
     6364     run on-same-page in this-procedure (input 9) .
     6365     run nutro_get-nutrition-info in this-procedure ( input  p-artic
     6366                                                    , input  p-prod-type
     6367                                                    , input  p-prod-code
     6368                                                    , input  v-cntxt-obj-type
     6369                                                    , input  v-cntxt-obj-code
     6370                                                    , output v-calories
     6371                                                    , output v-protein
     6372                                                    , output v-carbohydrate
     6373                                                    , output v-fat
     6374                                                    ).
     6375     put stream OutStream
     6376       'Сведения о пищевой и энергетической ценности:':U skip
     6377       'Пищевая и энергетическая ценность на 100 г. готового продукта':U skip
     6378     .
     6379     view frame nutrition-frame.
     6380     display stream OutStream
     6381     v-calories     @ v-tk-calories
     6382     v-protein      @ v-tk-protein
     6383     v-carbohydrate @ v-tk-carbohydrate
     6384     v-fat          @ v-tk-fat
     6385     sym1
     6386     sym2
     6387     sym3
     6388     sym4
     6389     sym5
     6390     with frame nutrition-frame.
     6391     put stream  OutStream  Line format "X(52)" at 1 skip(2).
     6392   end.
     6393   end procedure.
