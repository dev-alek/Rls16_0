     1750   procedure fbrlib_get-default-pay-code :
     1751   define input parameter p-obj-type   as character        no-undo.
     1752   define input parameter p-obj-code   as integer          no-undo.
     1753   define output parameter p-pay-code  as integer          no-undo.
     1754   define variable v-host-code as integer no-undo .
     1755   define buffer buf_shop          for ub.shop.
     1756   define buffer buf_store         for ub.store.
     1757   define buffer buf_sysconf       for ub.sysconf.
     1758   do
     1759   for buf_shop
     1760     , buf_store
     1761     , buf_sysconf
     1762   on error undo, return error
     1763   :
     1764     case p-obj-type  :
     1765       when 'маг':U then do:
     1766           find first buf_shop no-lock
     1767                 where buf_shop.obj-code = p-obj-code
     1768           no-error.
     1769           if available buf_shop
     1770           then do:
     1771               assign
     1772                   p-pay-code = buf_shop.fbr-pay
     1773               .
     1774           end.
     1775       end.
     1776       when 'скл':U then do:
     1777           find first buf_store no-lock
     1778                 where buf_store.obj-code = p-obj-code
     1779           no-error.
     1780           if available buf_store
     1781           then do:
     1782               assign
     1783                   p-pay-code = buf_store.fbr-pay
     1784               .
     1785           end.
     1786       end.
     1787     end case.
     1788     if p-pay-code = ?
     1789     or p-pay-code = 0
     1790     then do:
     1791   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1792   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1793     (input  p-obj-type
     1794     ,input  p-obj-code
     1795     ,output v-host-code
     1796     )  .
     1797         find first buf_sysconf no-lock
     1798               where buf_sysconf.host-code = v-host-code
     1799         no-error.
     1800         if available buf_sysconf
     1801         then do:
     1802             assign
     1803                 p-pay-code = buf_sysconf.fbr-pay
     1804             .
     1805         end.
     1806     end.
     1807     if p-pay-code = ?
     1808     or p-pay-code = 0
     1809     then do:
     1810   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1811   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdnpay in g#library
     1812     (input  p-obj-type
     1813     ,input  p-obj-code
     1814     ,output p-pay-code
     1815     )  .
     1816     end.
     1817   end.
     1818   end procedure.
     1819   procedure fbrlib-fill-and-check-temp_fbrlib_recipe :
     1820   do
     1821   on error undo, return error
     1822   :
     1823   define input parameter p-fbr-doc-code as character    no-undo.
     1824       define variable vss-description as character    no-undo init "fbrlib-fill-and-check-temp_fbrlib_recipe: ".
     1825       define variable v-gds-name      as character    no-undo.
     1826       define buffer buf_fbr-doc               for ub.fbr-doc.
     1827       define buffer buf_fbr-line              for ub.fbr-line.
     1828       define buffer buf_temp_fbrlib_recipe    for temp_fbrlib_recipe.
     1829       define buffer buf_out_temp_fbrlib_recipe    for temp_fbrlib_recipe.
     1830       find first buf_fbr-doc no-lock
     1831            where buf_fbr-doc.doc-code = p-fbr-doc-code
     1832       .
     1833       for each buf_temp_fbrlib_recipe
     1834       :
     1835           delete buf_temp_fbrlib_recipe.
     1836       end.
     1837       for each buf_fbr-line no-lock
     1838          where buf_fbr-line.doc-code = p-fbr-doc-code
     1839       :
     1840           find first buf_temp_fbrlib_recipe
     1841                where buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
     1842           no-error.
     1843           if not available buf_temp_fbrlib_recipe
     1844           then do:
     1845               create buf_temp_fbrlib_recipe.
     1846               assign
     1847                   buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
     1848                   buf_temp_fbrlib_recipe.fbr-doc-code = buf_fbr-line.doc-code
     1849               .
     1850           end.
     1851       end.
     1852       for each buf_temp_fbrlib_recipe
     1853       :
     1854           assign
     1855               buf_temp_fbrlib_recipe.count-income                = 0
     1856               buf_temp_fbrlib_recipe.qnty-income                 = 0
     1857               buf_temp_fbrlib_recipe.sum-income-sale             = 0
     1858               buf_temp_fbrlib_recipe.sum-income-cost-base        = 0
     1859               buf_temp_fbrlib_recipe.sum-income-cost-rubl        = 0
     1860               buf_temp_fbrlib_recipe.sum-income-vat-cost-base    = 0
     1861               buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl    = 0
     1862               buf_temp_fbrlib_recipe.count-write-off             = 0
     1863               buf_temp_fbrlib_recipe.qnty-write-off              = 0
     1864               buf_temp_fbrlib_recipe.sum-write-off-sale          = 0
     1865               buf_temp_fbrlib_recipe.sum-write-off-cost-base     = 0
     1866               buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = 0
     1867               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = 0
     1868               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = 0
     1869           .
     1870           for each buf_fbr-line no-lock
     1871              where buf_fbr-line.doc-code     = p-fbr-doc-code
     1872                and buf_fbr-line.trn-type     = 'при':U
     1873                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
     1874           :
     1875               if ( buf_fbr-line.price-base   = ?
     1876                   or buf_fbr-line.price-rubl = ?
     1877                   or buf_fbr-line.price-base <= 0
     1878                   or buf_fbr-line.price-rubl <= 0 )
     1879               and buf_fbr-line.fact-qnty <> 0
     1880               and buf_fbr-line.rsrv-qnty <> ?
     1881               and buf_fbr-doc.is-free    = no
     1882               then do:
     1883   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1884   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     1885     (input  buf_fbr-line.artic
     1886     ,input  buf_fbr-line.prod-type
     1887     ,input  buf_fbr-line.prod-code
     1888     ,output v-gds-name
     1889     ) no-error .
     1890                   if error-status :error
     1891                   then do:
     1892                       assign
     1893                           v-gds-name = ""
     1894                       .
     1895                   end.
     1896                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
     1897                                                 ,vss-description
     1898                                                 ,buf_fbr-doc.doc-code
     1899                                                 ,chr(10)
     1900                                                 ,buf_fbr-line.recipe-code
     1901                                                 ,buf_fbr-line.artic
     1902                                                 ,v-gds-name).
     1903               end.
     1904               assign
     1905                   buf_temp_fbrlib_recipe.count-income             = buf_temp_fbrlib_recipe.count-income + 1
     1906                   buf_temp_fbrlib_recipe.qnty-income              = buf_temp_fbrlib_recipe.qnty-income
     1907                                                                   + buf_fbr-line.fact-qnty
     1908                   buf_temp_fbrlib_recipe.sum-income-sale          = buf_temp_fbrlib_recipe.sum-income-sale
     1909                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
     1910               .
     1911               if buf_fbr-line.is-waste = no
     1912               then do:
     1913                   assign
     1914                       buf_temp_fbrlib_recipe.sum-income-cost-base     = buf_temp_fbrlib_recipe.sum-income-cost-base
     1915                                                                       + buf_fbr-line.price-sum-base
     1916                       buf_temp_fbrlib_recipe.sum-income-cost-rubl     = buf_temp_fbrlib_recipe.sum-income-cost-rubl
     1917                                                                       + buf_fbr-line.price-sum-rubl
     1918                       buf_temp_fbrlib_recipe.sum-income-vat-cost-base = buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     1919                                                                       + buf_fbr-line.price-sum-vat-base
     1920                       buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     1921                                                                       + buf_fbr-line.price-sum-vat-rubl
     1922                   .
     1923               end.
     1924           end.
     1925           for each buf_fbr-line no-lock
     1926              where buf_fbr-line.doc-code     = p-fbr-doc-code
     1927                and buf_fbr-line.trn-type     = 'спи':U
     1928                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
     1929           :
     1930               if ( buf_fbr-line.price-base   = ?
     1931                   or buf_fbr-line.price-rubl = ?
     1932                   or buf_fbr-line.price-base <= 0
     1933                   or buf_fbr-line.price-rubl <= 0 )
     1934               and buf_fbr-line.fact-qnty <> 0
     1935               and buf_fbr-line.rsrv-qnty <> ?
     1936               and buf_fbr-doc.is-free    = no
     1937               and buf_fbr-doc.status_    = 'разрешен':U
     1938               then do:
     1939   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1940   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     1941     (input  buf_fbr-line.artic
     1942     ,input  buf_fbr-line.prod-type
     1943     ,input  buf_fbr-line.prod-code
     1944     ,output v-gds-name
     1945     ) no-error .
     1946                   if error-status :error
     1947                   then do:
     1948                       assign
     1949                           v-gds-name = ""
     1950                       .
     1951                   end.
     1952                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
     1953                                                 ,vss-description
     1954                                                 ,buf_fbr-doc.doc-code
     1955                                                 ,chr(10)
     1956                                                 ,buf_fbr-line.recipe-code
     1957                                                 ,buf_fbr-line.artic
     1958                                                 ,v-gds-name).
     1959               end.
     1960               assign
     1961                   buf_temp_fbrlib_recipe.count-write-off             = buf_temp_fbrlib_recipe.count-write-off + 1
     1962                   buf_temp_fbrlib_recipe.qnty-write-off              = buf_temp_fbrlib_recipe.qnty-write-off
     1963                                                                   + buf_fbr-line.fact-qnty
     1964                   buf_temp_fbrlib_recipe.sum-write-off-sale          = buf_temp_fbrlib_recipe.sum-write-off-sale
     1965                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
     1966               .
     1967               if buf_fbr-line.is-waste = no
     1968               then do:
     1969                   assign
     1970                       buf_temp_fbrlib_recipe.sum-write-off-cost-base     = buf_temp_fbrlib_recipe.sum-write-off-cost-base
     1971                                                                       + buf_fbr-line.price-sum-base
     1972                       buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     1973                                                                       + buf_fbr-line.price-sum-rubl
     1974                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     1975                                                                       + buf_fbr-line.price-sum-vat-base
     1976                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     1977                                                                       + buf_fbr-line.price-sum-vat-rubl
     1978                   .
     1979               end.
     1980           end.
     1981           if buf_fbr-doc.status_    = 'разрешен':U
     1982           and ( abs( buf_temp_fbrlib_recipe.sum-write-off-cost-base     - buf_temp_fbrlib_recipe.sum-income-cost-base     ) > 0.01
     1983           or abs( buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     - buf_temp_fbrlib_recipe.sum-income-cost-rubl     ) > 0.01
     1984           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base - buf_temp_fbrlib_recipe.sum-income-vat-cost-base ) > 0.01
     1985           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl - buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl ) > 0.01
     1986               )
     1987           then do:
     1988            undo, return error
     1989               substitute("В документе пр-ва &1 Не совпадают суммы учетных цен для списанного и оприходованного по рецепту товара.&2" +
     1990                           "Рецепт: &3&2&4&4по списанному товару&4по оприходованному товару&2"  +
     1991                           "Сумма в баз.вал.&4&5&4&4&6&2" +
     1992                           "Сумма в &9.&4&7&4&4&8&2"
     1993                          , buf_fbr-doc.doc-code
     1994                          , chr(10)
     1995                          , buf_temp_fbrlib_recipe.recipe-code
     1996                          , CHR(9)
     1997                          , buf_temp_fbrlib_recipe.sum-write-off-cost-base
     1998                          , buf_temp_fbrlib_recipe.sum-income-cost-base
     1999                          , buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     2000                          , buf_temp_fbrlib_recipe.sum-income-cost-rubl
     2001                          , "руб"
     2002                          )
     2003              +
     2004              substitute("НДС в баз.вал.&1&2&1&1&3&4" +
     2005                         "НДС в &7.&1&5&1&1&6&4"
     2006                        ,  CHR(9)
     2007                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     2008                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     2009                        ,chr(10)
     2010                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     2011                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     2012                        ,"руб"
     2013                        )       .
     2014           end.
     2015       end.
     2016   end.
     2017   end procedure.
     2018   procedure fbrlib-fill-sum-fbr-doc :
     2019   do
     2020   on error undo, return error
     2021   :
     2022   define input parameter p-fbr-doc-recid  as recid        no-undo.
     2023   define input parameter p-mode           as character    no-undo.
     2024       define variable vss-description as character init "fbrlib-fill-sum-fbr-doc: "  no-undo.
     2025       define buffer buf_fbr-doc           for ub.fbr-doc.
     2026       define buffer buf_fbr-line          for ub.fbr-line.
     2027       define buffer buf_temp_fbrlib_recipe   for temp_fbrlib_recipe.
     2028       define variable v-in-count          as integer       no-undo.
     2029       define variable v-out-count         as integer       no-undo.
     2030       find first buf_fbr-doc exclusive-lock
     2031            where recid ( buf_fbr-doc ) = p-fbr-doc-recid
     2032       .
     2033       find first buf_temp_fbrlib_recipe no-error.
     2034       if not available buf_temp_fbrlib_recipe
     2035       then do:
     2036           run fbrlib-fill-and-check-temp_fbrlib_recipe in this-procedure (
     2037               input buf_fbr-doc.doc-code
     2038           ) no-error.
     2039           if error-status :error
     2040           then do:
     2041               undo, return error substitute("&1 Ошибка расчета сумм при заполнении шапки документа производства.&2&3&2&4"
     2042                                              , vss-description
     2043                                              , chr(10)
     2044                                              , error-status:get-message(1)
     2045                                              , return-value ).
     2046           end.
     2047       end.
     2048       assign
     2049           v-in-count                  = 0
     2050           buf_fbr-doc.in-qnty         = 0
     2051           buf_fbr-doc.in-sale         = 0
     2052           buf_fbr-doc.in-base         = 0
     2053           buf_fbr-doc.in-rubl         = 0
     2054           buf_fbr-doc.in-vat-base     = 0
     2055           buf_fbr-doc.in-vat-rubl     = 0
     2056           v-out-count                 = 0
     2057           buf_fbr-doc.out-qnty        = 0
     2058           buf_fbr-doc.out-sale        = 0
     2059           buf_fbr-doc.out-base        = 0
     2060           buf_fbr-doc.out-rubl        = 0
     2061           buf_fbr-doc.out-vat-base    = 0
     2062           buf_fbr-doc.out-vat-rubl    = 0
     2063       .
     2064       for each buf_temp_fbrlib_recipe
     2065       :
     2066           assign
     2067               v-in-count                  = v-in-count                + buf_temp_fbrlib_recipe.count-income
     2068               buf_fbr-doc.in-qnty         = buf_fbr-doc.in-qnty       + buf_temp_fbrlib_recipe.qnty-income
     2069               buf_fbr-doc.in-sale         = buf_fbr-doc.in-sale       + buf_temp_fbrlib_recipe.sum-income-sale
     2070               buf_fbr-doc.in-base         = buf_fbr-doc.in-base       + buf_temp_fbrlib_recipe.sum-income-cost-base
     2071               buf_fbr-doc.in-rubl         = buf_fbr-doc.in-rubl       + buf_temp_fbrlib_recipe.sum-income-cost-rubl
     2072               buf_fbr-doc.in-vat-base     = buf_fbr-doc.in-vat-base   + buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     2073               buf_fbr-doc.in-vat-rubl     = buf_fbr-doc.in-vat-rubl   + buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     2074               v-out-count                 = v-out-count               + buf_temp_fbrlib_recipe.count-write-off
     2075               buf_fbr-doc.out-qnty        = buf_fbr-doc.out-qnty      + buf_temp_fbrlib_recipe.qnty-write-off
     2076               buf_fbr-doc.out-sale        = buf_fbr-doc.out-sale      + buf_temp_fbrlib_recipe.sum-write-off-sale
     2077               buf_fbr-doc.out-base        = buf_fbr-doc.out-base      + buf_temp_fbrlib_recipe.sum-write-off-cost-base
     2078               buf_fbr-doc.out-rubl        = buf_fbr-doc.out-rubl      + buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     2079               buf_fbr-doc.out-vat-base    = buf_fbr-doc.out-vat-base  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     2080               buf_fbr-doc.out-vat-rubl    = buf_fbr-doc.out-vat-rubl  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     2081           .
     2082       end.
     2083       if ( abs (buf_fbr-doc.in-rubl - buf_fbr-doc.out-rubl) <= 0.01
     2084       and   abs (buf_fbr-doc.in-base - buf_fbr-doc.out-base) <= 0.01 )
     2085       or p-mode <> 'факт':U
     2086       then do:
     2087           if substring( buf_fbr-doc.PS, 1, 1 ) = "@"
     2088           then do:
     2089               assign
     2090                   buf_fbr-doc.PS = "@ Строк полученных товаров : "
     2091                                   + string( v-out-count, ">>>,>>9" )
     2092                                   + chr(10) + "Строк исходных товаров : "
     2093                                   + string( v-in-count, ">>>,>>9" )
     2094               .
     2095           end.
     2096       end.
     2097       else do:
     2098         undo, return error substitute("В док-те пр-ва &1 не совпадают суммы списанных и оприходованных товаров.&2" +
     2099                                       "Сумма списанных товаров в &3 - &4&2" +
     2100                                       "Сумма оприходованных товаров в &3 - &5&2" +
     2101                                       "Сумма оприходованных товаров в &3 - &6&2" +
     2102                                       "Сумма списанных товаров в баз.вал. - &7&2" +
     2103                                       "Сумма оприходованных товаров в баз.вал. - &8&2"
     2104                                       , buf_fbr-doc.doc-code
     2105                                       , chr(10)
     2106                                       , "рублях"
     2107                                       , round( buf_fbr-doc.out-rubl, 2 )
     2108                                       , round( buf_fbr-doc.in-rubl,  2 )
     2109                                       , round( buf_fbr-doc.in-rubl,  2 )
     2110                                       , round( buf_fbr-doc.out-base, 2 )
     2111                                       , round( buf_fbr-doc.in-base,  2 )).
     2112       end.
     2113   end.
     2114   end procedure.
     2115   procedure fbrlib-calc-prices :
     2116   do
     2117   on error undo, return error
     2118   :
     2119   define input parameter p-fbr-line-recid as recid        no-undo.
     2120   define input parameter p-price-obj-type as character    no-undo.
     2121   define input parameter p-price-obj-code as integer      no-undo.
     2122   define output parameter p-current-price as decimal      no-undo.
     2123       define variable v-void          as decimal       no-undo.
     2124       define variable v-void-char     as character     no-undo.
     2125       define variable v-gds-code      as integer       no-undo.
     2126       define variable v-b-code        as integer       no-undo.
     2127       define buffer buf_fbr-doc   for ub.fbr-doc.
     2128       define buffer buf_fbr-line  for ub.fbr-line.
     2129       define buffer buf_gds-prt   for ub.gds-prt.
     2130       define buffer buf_bar-code  for ub.bar-code.
     2131       find first buf_fbr-line no-lock
     2132           where recid( buf_fbr-line ) = p-fbr-line-recid
     2133       .
     2134   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2135   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     2136     (input  buf_fbr-line.artic
     2137     ,input  buf_fbr-line.prod-type
     2138     ,input  buf_fbr-line.prod-code
     2139     ,output v-gds-code
     2140     ) no-error .
     2141       if error-status :error
     2142       then do:
     2143         undo, return error substitute("&1 &2 &3&4Ошибка определения кода товара (артикул &7).&4&5&4&6"
     2144                                         ,vss-workfile
     2145                                         ,vss-revision
     2146                                         ,vss-description
     2147                                         ,chr(10)
     2148                                         , error-status:get-message(1)
     2149                                         , return-value
     2150                                         , buf_fbr-line.artic
     2151                                         ).
     2152       end.
     2153   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2154     (input  v-gds-code
     2155     ,input  ?
     2156     ,output v-b-code
     2157     ) no-error .
     2158       if error-status :error
     2159       then do:
     2160         undo, return error substitute("&1 &2 &3&4Ошибка определения основного бар-кода товара (код товара) &7.&4&5&4&6"
     2161                                         ,vss-workfile
     2162                                         ,vss-revision
     2163                                         ,vss-description
     2164                                         ,chr(10)
     2165                                         , error-status:get-message(1)
     2166                                         , return-value
     2167                                         , v-gds-code
     2168                                         ).
     2169       end.
     2170       if buf_fbr-line.is-calc = no
     2171       then do:
     2172   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2173   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2174     (input  p-price-obj-type
     2175     ,input  p-price-obj-code
     2176     ,input  v-b-code
     2177     ,input  0
     2178     ,input  0
     2179     ,output v-void-char
     2180     ,output p-current-price
     2181     ,output v-void
     2182     ,output v-void
     2183     ) no-error .
     2184           if error-status :error
     2185           then do:
     2186             undo, return error substitute("&1 &2 &3&4Ошибка определения продажной цены основного бар-кода товара (код товара) &7.&4&5&4&6"
     2187                                             ,vss-workfile
     2188                                             ,vss-revision
     2189                                             ,vss-description
     2190                                             ,chr(10)
     2191                                             , error-status:get-message(1)
     2192                                             , return-value
     2193                                             , v-gds-code
     2194                                             ).
     2195           end.
     2196       end.
     2197       else do:
     2198           assign
     2199               p-current-price = buf_fbr-line.price-sale
     2200           .
     2201       end.
     2202   end.
     2203   end procedure.
     2204   procedure fbrlib-put-in-order-recipe :
     2205   do
     2206   on error undo, return error
     2207   :
     2208   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     2209       define variable v-recipe-counter    as integer          no-undo.
     2210       define variable v-recipe-amount     as integer init 0   no-undo.
     2211       define variable v-child-counter     as integer          no-undo.
     2212       define variable v-is-call-cycle     as logical          no-undo.
     2213       define variable v-str as character     no-undo.
     2214       define buffer buf_in_fbr-line       for ub.fbr-line.
     2215       define buffer buf_dress_fbr-line    for ub.fbr-line.
     2216       define buffer buf_fbr-line          for ub.fbr-line.
     2217       define buffer buf_recipe-gds        for ub.recipe-gds.
     2218       define buffer buf_recipe            for ub.recipe.
     2219       for each temp_recipe-childs-qnty
     2220       :
     2221           delete temp_recipe-childs-qnty.
     2222       end.
     2223       for each temp_recipe-childs
     2224       :
     2225           delete temp_recipe-childs.
     2226       end.
     2227       for each temp_recipe-order
     2228       :
     2229           delete temp_recipe-order.
     2230       end.
     2231       for each buf_fbr-line no-lock
     2232          where buf_fbr-line.doc-code = p-fbr-doc-doc-code
     2233       on error undo, return error
     2234       :
     2235           find first temp_recipe-childs-qnty
     2236                where temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     2237           no-error.
     2238           if not available temp_recipe-childs-qnty
     2239           then do:
     2240               create temp_recipe-childs-qnty.
     2241               assign
     2242                   v-recipe-amount                     = v-recipe-amount + 1
     2243                   temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     2244                   temp_recipe-childs-qnty.order       = v-recipe-amount
     2245                   temp_recipe-childs-qnty.childs-qnty = 0
     2246                   v-child-counter                     = 0
     2247               .
     2248           end.
     2249       end.
     2250       for each buf_in_fbr-line no-lock
     2251          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     2252            and buf_in_fbr-line.trn-type = 'спи':U
     2253       on error undo, return error
     2254       :
     2255           for each buf_dress_fbr-line no-lock
     2256              where buf_dress_fbr-line.doc-code    = p-fbr-doc-doc-code
     2257                and buf_dress_fbr-line.trn-type    = 'при':U
     2258                and buf_dress_fbr-line.artic       = buf_in_fbr-line.artic
     2259                and buf_dress_fbr-line.prod-type   = buf_in_fbr-line.prod-type
     2260                and buf_dress_fbr-line.prod-code   = buf_in_fbr-line.prod-code
     2261           on error undo, return error
     2262           :
     2263               find first buf_recipe no-lock
     2264                    where buf_recipe.recipe-code = buf_dress_fbr-line.recipe-code
     2265               .
     2266               if buf_in_fbr-line.is-comp = yes
     2267               then do:
     2268                   find last temp_recipe-childs-qnty
     2269                       where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     2270                   .
     2271                   assign
     2272                       temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     2273                   .
     2274                   create temp_recipe-childs.
     2275                   assign
     2276                       temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     2277                       temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     2278                       temp_recipe-childs.child-recipe-code    = buf_dress_fbr-line.recipe-code
     2279                   .
     2280               end.
     2281               else do:
     2282               end.
     2283           end.
     2284       end.
     2285       for each buf_in_fbr-line no-lock
     2286          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     2287            and buf_in_fbr-line.trn-type = 'при':U
     2288       on error undo, return error
     2289       :
     2290           find first buf_recipe no-lock
     2291                where buf_recipe.recipe-code = buf_in_fbr-line.recipe-code
     2292           no-error.
     2293           if buf_in_fbr-line.is-comp = no
     2294           then do:
     2295           end.
     2296           else do:
     2297               for each buf_recipe-gds no-lock
     2298               where buf_recipe-gds.recipe-code = buf_in_fbr-line.recipe-code
     2299               :
     2300                   for each buf_fbr-line no-lock
     2301                   where buf_fbr-line.doc-code    = p-fbr-doc-doc-code
     2302                       and buf_fbr-line.trn-type    = 'при':U
     2303                       and buf_fbr-line.artic       = buf_recipe-gds.artic
     2304                       and buf_fbr-line.prod-type   = buf_recipe-gds.prod-type
     2305                       and buf_fbr-line.prod-code   = buf_recipe-gds.prod-code
     2306                   on error undo, return error
     2307                   :
     2308                       find first buf_recipe no-lock
     2309                            where buf_recipe.recipe-code = buf_fbr-line.recipe-code
     2310                       .
     2311                       if buf_recipe.recipe-type = 'разделка':U
     2312                       then do:
     2313                       end.
     2314                       else do:
     2315                           find last temp_recipe-childs-qnty
     2316                               where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     2317                           .
     2318                           assign
     2319                               temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     2320                           .
     2321                           create temp_recipe-childs.
     2322                           assign
     2323                               temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     2324                               temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     2325                               temp_recipe-childs.child-recipe-code    = buf_fbr-line.recipe-code
     2326                           .
     2327                       end.
     2328                   end.
     2329               end.
     2330           end.
     2331       end.
     2332       for each temp_recipe-order
     2333       on error undo, return error
     2334       :
     2335           delete temp_recipe-order.
     2336       end.
     2337       assign
     2338           v-fbrlib-recipe-order = 0
     2339       .
     2340       do v-recipe-counter = 1 to v-recipe-amount
     2341       on error undo, return error
     2342       :
     2343           run fbrlib-add-recipe-in-tmp-order in this-procedure (
     2344                 input v-recipe-counter
     2345               , input 0
     2346               , output v-is-call-cycle
     2347           ).
     2348           if v-is-call-cycle = yes
     2349           then do:
     2350               message
     2351                       "Достигнут максимальный уровень вложенности рецептов."
     2352                   skip(1)
     2353                   skip "Невозможно упорядочить рецепты."
     2354                   skip(1)
     2355                   skip "Необходимо изменить структуру рецептов,"
     2356                   skip "используемых при формировании"
     2357                   skip "данного документа производства."
     2358               view-as alert-box error
     2359               title "Невозможно рассчитать документ производства".
     2360               for each temp_recipe-childs-qnty
     2361               :
     2362                   delete temp_recipe-childs-qnty.
     2363               end.
     2364               for each temp_recipe-childs
     2365               :
     2366                   delete temp_recipe-childs.
     2367               end.
     2368               for each temp_recipe-order
     2369               :
     2370                   delete temp_recipe-order.
     2371               end.
     2372               for each temp_recipe-order
     2373               on error undo, return error
     2374               :
     2375                   delete temp_recipe-order.
     2376               end.
     2377               for each temp_fbrlib_recipe
     2378               on error undo, return error
     2379               :
     2380                   delete temp_recipe-order.
     2381               end.
     2382               undo, return error.
     2383           end.
     2384       end.
     2385   end.
     2386   end procedure.
     2387   procedure fbrlib-add-recipe-in-tmp-order :
     2388   do
     2389   on error undo, return error
     2390   :
     2391   define input parameter p-order              as integer      no-undo.
     2392   define input parameter p-call-counter       as integer      no-undo.
     2393   define output parameter p-is-call-cycle     as logical      no-undo.
     2394       define variable v-nodes-counter     as integer       no-undo.
     2395       define buffer buf_c_temp_recipe-childs-qnty for temp_recipe-childs-qnty.
     2396       define buffer buf_temp_recipe-childs-qnty   for temp_recipe-childs-qnty.
     2397       define buffer buf_temp_recipe-childs        for temp_recipe-childs     .
     2398       define buffer buf_temp_recipe-order         for temp_recipe-order.
     2399       assign
     2400           p-call-counter = p-call-counter + 1
     2401       .
     2402       if p-call-counter > 50
     2403       then do:
     2404           assign
     2405               p-is-call-cycle = yes
     2406           .
     2407       end.
     2408       else do:
     2409           find first buf_temp_recipe-childs-qnty
     2410                where buf_temp_recipe-childs-qnty.order = p-order
     2411           .
     2412           find first buf_temp_recipe-order
     2413                where buf_temp_recipe-order.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     2414           no-error.
     2415           if not available buf_temp_recipe-order
     2416           then do:
     2417               do v-nodes-counter = 1 to buf_temp_recipe-childs-qnty.childs-qnty
     2418               :
     2419                   find first buf_temp_recipe-childs
     2420                        where buf_temp_recipe-childs.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     2421                          and buf_temp_recipe-childs.child-code  = v-nodes-counter
     2422                   .
     2423                   find first buf_c_temp_recipe-childs-qnty
     2424                        where buf_c_temp_recipe-childs-qnty.recipe-code = buf_temp_recipe-childs.child-recipe-code
     2425                   .
     2426                   run fbrlib-add-recipe-in-tmp-order in this-procedure (
     2427                         input buf_c_temp_recipe-childs-qnty.order
     2428                       , input p-call-counter
     2429                       , output p-is-call-cycle
     2430                   ).
     2431                   if p-is-call-cycle = yes
     2432                   then do:
     2433                       return.
     2434                   end.
     2435               end.
     2436               assign
     2437                   v-fbrlib-recipe-order = v-fbrlib-recipe-order + 1
     2438               .
     2439               create buf_temp_recipe-order.
     2440               assign
     2441                   buf_temp_recipe-order.recipe-code   = buf_temp_recipe-childs-qnty.recipe-code
     2442                   buf_temp_recipe-order.order         = v-fbrlib-recipe-order
     2443               .
     2444           end.
     2445       end.
     2446   end.
     2447   end procedure.
     2448   procedure fbrlib-get-trn-type :
     2449   define input parameter p-recipe-code    as character    no-undo.
     2450   define input parameter p-goods-recid    as recid        no-undo.
     2451   define input parameter p-is-integration as logical      no-undo.
     2452   define output parameter p-is-comp       as logical      no-undo.
     2453   define output parameter p-trn-type      as character    no-undo.
     2454   define buffer buf_recipe    for ub.recipe.
     2455   define buffer buf_goods     for ub.goods.
     2456   do
     2457   for buf_recipe
     2458     , buf_goods
     2459   on error undo, return error
     2460   :
     2461       find first buf_goods no-lock
     2462            where recid( buf_goods ) = p-goods-recid
     2463       .
     2464       find first buf_recipe no-lock
     2465            where buf_recipe.recipe-code = p-recipe-code
     2466       no-error.
     2467       if not available buf_recipe
     2468       then do:
     2469           assign
     2470               p-is-comp = no
     2471               p-trn-type = "":U
     2472           .
     2473           undo, return.
     2474       end.
     2475       if  buf_recipe.artic        = buf_goods.artic
     2476       and buf_recipe.prod-type    = buf_goods.prod-type
     2477       and buf_recipe.prod-code    = buf_goods.prod-code
     2478       then do:
     2479           assign
     2480               p-is-comp = yes
     2481           .
     2482       end.
     2483       else do:
     2484           assign
     2485               p-is-comp = no
     2486           .
     2487       end.
     2488       case buf_recipe.recipe-type
     2489       :
     2490           when 'производство':U
     2491           then do:
     2492               if p-is-comp = yes
     2493               then do:
     2494                   assign
     2495                       p-trn-type = 'при':U
     2496                   .
     2497               end.
     2498               else do:
     2499                   assign
     2500                       p-trn-type = 'спи':U
     2501                   .
     2502               end.
     2503           end.
     2504           when 'альтернатива':U
     2505           then do:
     2506               if p-is-comp = yes
     2507               then do:
     2508                   assign
     2509                       p-trn-type = 'при':U
     2510                   .
     2511               end.
     2512               else do:
     2513                   assign
     2514                       p-trn-type = 'спи':U
     2515                   .
     2516               end.
     2517           end.
     2518           when 'разделка':U
     2519           then do:
     2520               if p-is-comp = no
     2521               then do:
     2522                   assign
     2523                       p-trn-type = 'при':U
     2524                   .
     2525               end.
     2526               else do:
     2527                   assign
     2528                       p-trn-type = 'спи':U
     2529                   .
     2530               end.
     2531           end.
     2532           when 'комплектация':U
     2533           then do:
     2534               if p-is-integration = ?
     2535               then do:
     2536                   message
     2537                       "Выберите тип операции по рецепту комплектации:"
     2538                       skip (2) "YES - комплектация"
     2539                       skip     "NO - разукомплектация"
     2540                   view-as alert-box question
     2541                   buttons YES-NO
     2542                   update p-is-integration.
     2543               end.
     2544               if p-is-integration = yes
     2545               then do:
     2546                   if p-is-comp = yes
     2547                   then do:
     2548                       assign
     2549                           p-trn-type = 'при':U
     2550                       .
     2551                   end.
     2552                   else do:
     2553                       assign
     2554                           p-trn-type = 'спи':U
     2555                       .
     2556                   end.
     2557               end.
     2558               else do:
     2559                   if p-is-comp = yes
     2560                   then do:
     2561                       assign
     2562                           p-trn-type = 'спи':U
     2563                       .
     2564                   end.
     2565                   else do:
     2566                       assign
     2567                           p-trn-type = 'при':U
     2568                       .
     2569                   end.
     2570               end.
     2571           end.
     2572       end case.
     2573   end.
     2574   end procedure.
     2575   procedure fbrlib-get-mark :
     2576   define input parameter p-recipe-code    as character    no-undo.
     2577   define output parameter p-mark          as logical    no-undo.
     2578   define buffer buf_goods-attr     for ub.goods-attr.
     2579   define buffer buf_recipe-gds for ub.recipe-gds .
     2580       for each buf_recipe-gds no-lock where buf_recipe-gds.recipe-code = p-recipe-code,
     2581            first buf_goods-attr no-lock where buf_goods-attr.gds-code = buf_recipe-gds.gds-code and
     2582                                               buf_goods-attr.attr-code = 'mark-type':U:
     2583            if buf_goods-attr.attr-value <> "" and buf_goods-attr.attr-value <> "not-type" then do:
     2584               p-mark = true .
     2585               return .
     2586            end.
     2587       end.
     2588   end procedure.
     2589   procedure fbrlib-check-temp-tables :
     2590   do
     2591   on error undo, return error
     2592   :
     2593   define input parameter p-title  as character    no-undo.
     2594       define variable v-str               as character        no-undo.
     2595       assign
     2596           v-str = v-str + chr(10) + "temp_recipe-childs-qnty:" + chr(10)
     2597       .
     2598       for each temp_recipe-childs-qnty
     2599       on error undo, return error
     2600       :
     2601           assign
     2602               v-str   = v-str + string( temp_recipe-childs-qnty.recipe-code )
     2603                       + "   " + string( temp_recipe-childs-qnty.childs-qnty )
     2604                       + "   " + string( temp_recipe-childs-qnty.order )
     2605                       + chr(10)
     2606           .
     2607       end.
     2608       assign
     2609           v-str = v-str + "temp_recipe-childs:" + chr(10)
     2610       .
     2611       for each temp_recipe-childs
     2612       on error undo, return error
     2613       :
     2614           assign
     2615               v-str   = v-str + string( temp_recipe-childs.recipe-code )
     2616                       + "   " + string( temp_recipe-childs.child-code )
     2617                       + "   " + string( temp_recipe-childs.child-recipe-code )
     2618                       + chr(10)
     2619           .
     2620       end.
     2621       assign
     2622           v-str = v-str + chr(10) + "temp_recipe-order:" + chr(10)
     2623       .
     2624       for each temp_recipe-order
     2625       on error undo, return error
     2626       :
     2627           assign
     2628               v-str   = v-str + string( temp_recipe-order.recipe-code )
     2629                       + "   " + string( temp_recipe-order.order )
     2630                       + chr(10)
     2631           .
     2632       end.
     2633       assign
     2634           v-str = v-str + chr(10) + "temp_fbrlib_recipe:" + chr(10)
     2635       .
     2636       run writelog in this-procedure ( input "fbr.log", input 0, input p-title ).
     2637       run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     2638       for each temp_fbrlib_recipe
     2639       on error undo, return error
     2640       :
     2641           assign
     2642               v-str   = "recipe-code: "                   + string( temp_fbrlib_recipe.recipe-code                 )
     2643                       + "   " + "count-income: "                  + string( temp_fbrlib_recipe.count-income                )
     2644                       + "   " + "qnty-income: "                   + string( temp_fbrlib_recipe.qnty-income                 )
     2645                       + "   " + "sum-income-sale: "               + string( temp_fbrlib_recipe.sum-income-sale             )
     2646                       + "   " + "sum-income-cost-base: "          + string( temp_fbrlib_recipe.sum-income-cost-base        )
     2647                       + "   " + "sum-income-cost-rubl: "          + string( temp_fbrlib_recipe.sum-income-cost-rubl        )
     2648                       + "   " + "sum-income-vat-cost-base: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-base    )
     2649                       + "   " + "sum-income-vat-cost-rubl: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-rubl    )
     2650                       + "   " + "count-write-off: "               + string( temp_fbrlib_recipe.count-write-off             )
     2651                       + "   " + "qnty-write-off: "                + string( temp_fbrlib_recipe.qnty-write-off              )
     2652                       + "   " + "sum-write-off-sale: "            + string( temp_fbrlib_recipe.sum-write-off-sale          )
     2653                       + "   " + "sum-write-off-cost-base: "       + string( temp_fbrlib_recipe.sum-write-off-cost-base     )
     2654                       + "   " + "sum-write-off-cost-rubl: "       + string( temp_fbrlib_recipe.sum-write-off-cost-rubl     )
     2655                       + "   " + "sum-write-off-vat-cost-base: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-base )
     2656                       + "   " + "sum-write-off-vat-cost-rubl: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-rubl )
     2657                       + chr(10)
     2658           .
     2659           run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     2660       end.
     2661   end.
     2662   end procedure.
     2663   procedure fbrlib-s-coeff-value :
     2664   define input  parameter p-gds-code    as integer        no-undo.
     2665   define input  parameter p-date        as date           no-undo.
     2666   define input  parameter p-obj-type    as character      no-undo.
     2667   define input  parameter p-obj-code    as integer        no-undo.
     2668   define output parameter p-coeff-value as decimal        no-undo.
     2669   define variable vss-description as character init "fbrlib-s-coeff-value-01: определяет значение сезонного коэффициента" no-undo.
     2670       define variable v-date          as date         no-undo.
     2671       define variable v-host-code     as integer      no-undo.
     2672       define buffer buf_goods       for ub.goods.
     2673       define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     2674       define buffer buf_clients     for ub.clients.
     2675       define buffer buf_s-coeff     for ub.s-coeff.
     2676   do
     2677   for buf_goods
     2678     , buf_fbr-gds-obj
     2679     , buf_clients
     2680     , buf_s-coeff
     2681   on error undo, return error return-value
     2682   :
     2683       find first buf_goods no-lock
     2684            where buf_goods.gds-code = p-gds-code
     2685       no-error .
     2686       if not available buf_goods
     2687       then do:
     2688          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден товар с кодом &1", p-gds-code).
     2689       end.
     2690       find first buf_clients no-lock
     2691            where buf_clients.obj-type = p-obj-type
     2692              and buf_clients.obj-code = p-obj-code
     2693       no-error.
     2694       if not available buf_clients
     2695       then do:
     2696          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден объект &1&2", p-obj-type, p-obj-code).
     2697       end.
     2698       assign
     2699           v-date = date(month(p-date), day(p-date), Year(01/01/1996))
     2700       .
     2701       find first buf_fbr-gds-obj no-lock
     2702            where buf_fbr-gds-obj.gds-code = p-gds-code
     2703              and buf_fbr-gds-obj.obj-type = p-obj-type
     2704              and buf_fbr-gds-obj.obj-code = p-obj-code
     2705       no-error.
     2706       if not available buf_fbr-gds-obj
     2707       or buf_fbr-gds-obj.is-season = no
     2708       then do:
     2709           assign
     2710               p-coeff-value = 0
     2711           .
     2712           return.
     2713       end.
     2714   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2715   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2716     (input  p-obj-type
     2717     ,input  p-obj-code
     2718     ,output v-host-code
     2719     )  .
     2720       find last buf_s-coeff no-lock
     2721           where buf_s-coeff.gds-code = p-gds-code
     2722             and buf_s-coeff.host-code = v-host-code
     2723             and buf_s-coeff.obj-type = p-obj-type
     2724             and buf_s-coeff.obj-code = p-obj-code
     2725             and buf_s-coeff.s-date <= v-date
     2726       no-error.
     2727       if available buf_s-coeff
     2728       then do:
     2729           assign
     2730               p-coeff-value = buf_s-coeff.coeff-value
     2731           .
     2732           return.
     2733       end.
     2734       find last buf_s-coeff no-lock
     2735           where buf_s-coeff.gds-code = p-gds-code
     2736             and buf_s-coeff.host-code = v-host-code
     2737             and buf_s-coeff.obj-type = "":U
     2738             and buf_s-coeff.obj-code = 0
     2739             and buf_s-coeff.s-date <= v-date
     2740       no-error.
     2741       if available buf_s-coeff
     2742       then do:
     2743           assign
     2744               p-coeff-value = buf_s-coeff.coeff-value
     2745           .
     2746           return.
     2747       end.
     2748       find last buf_s-coeff no-lock
     2749           where buf_s-coeff.gds-code = p-gds-code
     2750             and buf_s-coeff.host-code = 0
     2751             and buf_s-coeff.obj-type = "":U
     2752             and buf_s-coeff.obj-code = 0
     2753             and buf_s-coeff.s-date <= v-date
     2754       no-error.
     2755       if available buf_s-coeff
     2756       then do:
     2757           assign
     2758               p-coeff-value = buf_s-coeff.coeff-value
     2759           .
     2760       end.
     2761       else do:
     2762           assign
     2763               p-coeff-value = 0
     2764           .
     2765       end.
     2766   end.
     2767   end procedure.
     2768   procedure fbrlib_create-fbr-recipe-gds :
     2769   define input parameter p-doc-code         as character      no-undo.
     2770   define input parameter p-recipe-code      as character      no-undo.
     2771   define input parameter p-prod-type        as character      no-undo.
     2772   define input parameter p-prod-code        as integer        no-undo.
     2773   define input parameter p-artic            as character      no-undo.
     2774   define input parameter p-gds-code         as integer        no-undo.
     2775   define input parameter p-is-waste         as logical        no-undo.
     2776   define input parameter p-proc-number      as integer        no-undo.
     2777   define input parameter p-obj-date         as date           no-undo.
     2778   define input parameter p-obj-type         as character      no-undo.
     2779   define input parameter p-obj-code         as integer        no-undo.
     2780   define input parameter p-calc-method      as decimal        no-undo.
     2781   define input parameter p-coeff-waste      as decimal        no-undo.
     2782   define input parameter p-orig-qnty        as decimal        no-undo.
     2783   define input parameter p-orig-brutto-qnty as decimal        no-undo.
     2784       define variable v-coeff-season  as decimal      no-undo.
     2785       define variable v-void-decimal  as decimal      no-undo.
     2786       define variable v-void-integer  as integer      no-undo.
     2787       define variable v-recipe-type   as character    no-undo.
     2788       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     2789       define buffer buf_goods             for ub.goods.
     2790       define buffer buf_recipe            for ub.recipe.
     2791   do
     2792   for buf_fbr-recipe-gds
     2793     , buf_recipe
     2794     , buf_goods
     2795   on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     2796   :
     2797       find first buf_fbr-recipe-gds exclusive-lock
     2798            where buf_fbr-recipe-gds.doc-code    = p-doc-code
     2799              and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     2800              and buf_fbr-recipe-gds.prod-type   = p-prod-type
     2801              and buf_fbr-recipe-gds.prod-code   = p-prod-code
     2802              and buf_fbr-recipe-gds.artic       = p-artic
     2803       no-error.
     2804       if not available buf_fbr-recipe-gds
     2805       then do:
     2806           create buf_fbr-recipe-gds.
     2807           assign
     2808               buf_fbr-recipe-gds.doc-code           = p-doc-code
     2809               buf_fbr-recipe-gds.recipe-code        = p-recipe-code
     2810               buf_fbr-recipe-gds.prod-type          = p-prod-type
     2811               buf_fbr-recipe-gds.prod-code          = p-prod-code
     2812               buf_fbr-recipe-gds.artic              = p-artic
     2813               buf_fbr-recipe-gds.gds-code           = p-gds-code
     2814               buf_fbr-recipe-gds.is-waste           = p-is-waste
     2815               buf_fbr-recipe-gds.proc-number        = p-proc-number
     2816               buf_fbr-recipe-gds.recipe-qnty        = p-orig-qnty
     2817               buf_fbr-recipe-gds.recipe-brutto-qnty = p-orig-brutto-qnty
     2818           .
     2819           find first buf_goods no-lock
     2820                where buf_goods.prod-type = buf_fbr-recipe-gds.prod-type
     2821                  and buf_goods.prod-code = buf_fbr-recipe-gds.prod-code
     2822                  and buf_goods.artic     = buf_fbr-recipe-gds.artic
     2823           .
     2824           run fbrlib-s-coeff-value in this-procedure (
     2825                 input buf_goods.gds-code
     2826               , input p-obj-date
     2827               , input p-obj-type
     2828               , input p-obj-code
     2829               , output v-coeff-season
     2830           ) no-error.
     2831           if error-status:error
     2832           then do:
     2833               return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)).
     2834           end.
     2835           assign
     2836               buf_fbr-recipe-gds.qnty         = p-orig-qnty
     2837               buf_fbr-recipe-gds.coeff-value  = v-coeff-season
     2838               buf_fbr-recipe-gds.coeff-waste  = p-coeff-waste
     2839           .
     2840           run fbrlib-get-recipe-type in this-procedure (
     2841                 input buf_fbr-recipe-gds.doc-code
     2842               , input buf_fbr-recipe-gds.recipe-code
     2843               , output v-recipe-type
     2844           ).
     2845           if v-recipe-type <> 'производство':U
     2846           then do:
     2847               assign
     2848                   buf_fbr-recipe-gds.coeff-value  = 0
     2849                   buf_fbr-recipe-gds.coeff-waste  = 0
     2850                   buf_fbr-recipe-gds.calc-method  = 1
     2851                   buf_fbr-recipe-gds.brutto-qnty  = buf_fbr-recipe-gds.qnty
     2852               .
     2853           end.
     2854           else do:
     2855               run fbrlib-calc-brutto in this-procedure (
     2856                     input v-recipe-type
     2857                   , input buf_fbr-recipe-gds.qnty
     2858                   , input buf_fbr-recipe-gds.coeff-value
     2859                   , input buf_fbr-recipe-gds.coeff-waste
     2860                   , input 0
     2861                   , input 3
     2862                   , output v-void-decimal
     2863                   , output v-void-decimal
     2864                   , output buf_fbr-recipe-gds.brutto-qnty
     2865                   , output v-void-integer
     2866               ).
     2867               assign
     2868                   buf_fbr-recipe-gds.calc-method  = p-calc-method
     2869               .
     2870               run fbrlib-calc-brutto in this-procedure (
     2871                     input v-recipe-type
     2872                   , input buf_fbr-recipe-gds.qnty
     2873                   , input buf_fbr-recipe-gds.coeff-value
     2874                   , input buf_fbr-recipe-gds.coeff-waste
     2875                   , input buf_fbr-recipe-gds.brutto-qnty
     2876                   , input buf_fbr-recipe-gds.calc-method
     2877                   , output buf_fbr-recipe-gds.qnty
     2878                   , output v-void-decimal
     2879                   , output v-void-decimal
     2880                   , output v-void-integer
     2881               ).
     2882           end.
     2883       end.
     2884   end.
     2885   end procedure.
     2886   procedure fbrlib-set-default-recipe :
     2887   define input parameter p-obj-type   as character    no-undo.
     2888   define input parameter p-obj-code   as integer      no-undo.
     2889   define input parameter p-gds-code   as integer      no-undo.
     2890       define variable v-artic             as character    no-undo.
     2891       define variable v-prod-type         as character    no-undo.
     2892       define variable v-prod-code         as character    no-undo.
     2893       define variable v-recipe-code       as character    no-undo.
     2894       define variable v-fbr-gds-obj-recid as recid        no-undo.
     2895       define variable v-recipe-found      as logical      no-undo.
     2896       define buffer buf_recipe        for ub.recipe.
     2897       define buffer buf_other_recipe  for ub.recipe.
     2898       define buffer buf_goods         for ub.goods.
     2899       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     2900   do
     2901   for buf_recipe
     2902     , buf_goods
     2903     , buf_fbr-gds-obj
     2904   on error undo, return error
     2905   :
     2906       find first buf_goods no-lock
     2907            where buf_goods.gds-code = p-gds-code
     2908       .
     2909       run fbrlib-get-obj-recipe in this-procedure (
     2910             input p-obj-type
     2911           , input p-obj-code
     2912           , input p-gds-code
     2913           , output v-recipe-code
     2914       ).
     2915       if v-recipe-code <> ""
     2916       then do:
     2917           find first buf_recipe no-lock
     2918               where buf_recipe.recipe-code = v-recipe-code
     2919           no-error.
     2920           if not available buf_recipe
     2921           then do:
     2922               assign
     2923                   v-recipe-code = ""
     2924               .
     2925           end.
     2926       end.
     2927       if v-recipe-code = ""
     2928       then do:
     2929           find first buf_fbr-gds-obj exclusive-lock
     2930                where buf_fbr-gds-obj.obj-type = p-obj-type
     2931                  and buf_fbr-gds-obj.obj-code = p-obj-code
     2932                  and buf_fbr-gds-obj.gds-code = p-gds-code
     2933           no-error.
     2934           if not available buf_fbr-gds-obj
     2935           then do:
     2936               run ref/fgdsobj1.p (
     2937                     input-output v-fbr-gds-obj-recid
     2938                   , input 'ДОБАВЛЕНИЕ':U
     2939                   , input no
     2940                   , input p-gds-code
     2941                   , input p-obj-type
     2942                   , input p-obj-code
     2943                   , input 0
     2944                   , input ""
     2945                   , input 0
     2946                   , input no
     2947                   , input no
     2948                   , input no
     2949                   , input no
     2950                   , input no
     2951                   , input no
     2952               ) no-error.
     2953               if error-status:error
     2954               then do:
     2955                   message
     2956                           vss-workfile vss-revision vss-description
     2957                       skip "Ошибка изменения атрибутов товара на объекте"
     2958                       skip return-value
     2959                       skip trim(error-status :get-message(1))
     2960                               trim(error-status :get-message(2))
     2961                               trim(error-status :get-message(3))
     2962                   view-as alert-box error.
     2963                   undo, return error .
     2964               end.
     2965               find first buf_fbr-gds-obj exclusive-lock
     2966                    where recid( buf_fbr-gds-obj ) = v-fbr-gds-obj-recid
     2967               .
     2968           end.
     2969           assign
     2970               v-recipe-found = no
     2971           .
     2972           for first buf_recipe no-lock
     2973               where buf_recipe.obj-type    = p-obj-type
     2974                 and buf_recipe.obj-code    = p-obj-code
     2975                 and buf_recipe.artic       = buf_goods.artic
     2976                 and buf_recipe.prod-type   = buf_goods.prod-type
     2977                 and buf_recipe.prod-code   = buf_goods.prod-code
     2978                 and buf_recipe.recipe-type = 'производство':U
     2979                 or (
     2980                     buf_recipe.obj-type    = ""
     2981                 and buf_recipe.obj-code    = 0
     2982                 and buf_recipe.artic       = buf_goods.artic
     2983                 and buf_recipe.prod-type   = buf_goods.prod-type
     2984                 and buf_recipe.prod-code   = buf_goods.prod-code
     2985                 and buf_recipe.recipe-type = 'производство':U
     2986                     )
     2987           :
     2988               assign
     2989                   v-recipe-found = yes
     2990                   buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     2991               .
     2992           end.
     2993           if v-recipe-found = no
     2994           then do:
     2995               for first buf_recipe no-lock
     2996                   where buf_recipe.obj-type    = p-obj-type
     2997                     and buf_recipe.obj-code    = p-obj-code
     2998                     and buf_recipe.artic       = buf_goods.artic
     2999                     and buf_recipe.prod-type   = buf_goods.prod-type
     3000                     and buf_recipe.prod-code   = buf_goods.prod-code
     3001                     and buf_recipe.recipe-type <> 'альтернатива':U
     3002                     or (
     3003                         buf_recipe.obj-type    = ""
     3004                     and buf_recipe.obj-code    = 0
     3005                     and buf_recipe.artic       = buf_goods.artic
     3006                     and buf_recipe.prod-type   = buf_goods.prod-type
     3007                     and buf_recipe.prod-code   = buf_goods.prod-code
     3008                     and buf_recipe.recipe-type <> 'альтернатива':U
     3009                         )
     3010               :
     3011                   assign
     3012                       v-recipe-found = yes
     3013                       buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     3014                   .
     3015               end.
     3016               if v-recipe-found = no
     3017               then do:
     3018                   for first buf_recipe no-lock
     3019                       where buf_recipe.obj-type    = p-obj-type
     3020                         and buf_recipe.obj-code    = p-obj-code
     3021                         and buf_recipe.artic       = buf_goods.artic
     3022                         and buf_recipe.prod-type   = buf_goods.prod-type
     3023                         and buf_recipe.prod-code   = buf_goods.prod-code
     3024                         or (
     3025                             buf_recipe.obj-type    = ""
     3026                         and buf_recipe.obj-code    = 0
     3027                         and buf_recipe.artic       = buf_goods.artic
     3028                         and buf_recipe.prod-type   = buf_goods.prod-type
     3029                         and buf_recipe.prod-code   = buf_goods.prod-code
     3030                             )
     3031                   :
     3032                       assign
     3033                           v-recipe-found = yes
     3034                           buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     3035                       .
     3036                   end.
     3037                   if v-recipe-found = no
     3038                   then do:
     3039                       assign
     3040                           buf_fbr-gds-obj.default-recipe-code = ""
     3041                       .
     3042                   end.
     3043               end.
     3044           end.
     3045       end.
     3046   end.
     3047   end procedure.
     3048   procedure fbrlib-get-obj-recipe :
     3049   define input parameter p-obj-type       as character    no-undo.
     3050   define input parameter p-obj-code       as integer      no-undo.
     3051   define input parameter p-gds-code       as integer      no-undo.
     3052   define output parameter p-recipe-code   as character    no-undo.
     3053       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     3054   do
     3055   for buf_fbr-gds-obj
     3056   on error undo, return error
     3057   :
     3058       find first buf_fbr-gds-obj no-lock
     3059            where buf_fbr-gds-obj.obj-type = p-obj-type
     3060              and buf_fbr-gds-obj.obj-code = p-obj-code
     3061              and buf_fbr-gds-obj.gds-code = p-gds-code
     3062       no-error.
     3063       if available buf_fbr-gds-obj
     3064       then do:
     3065           assign
     3066               p-recipe-code = buf_fbr-gds-obj.default-recipe-code
     3067           .
     3068       end.
     3069       else do:
     3070           assign
     3071               p-recipe-code = ""
     3072           .
     3073       end.
     3074   end.
     3075   end procedure.
     3076   procedure fbrlib-create-or-update-recipe-gds :
     3077   define input parameter p-recipe-code    as character        no-undo.
     3078   define input parameter p-gds-code       as integer          no-undo.
     3079   define input parameter p-is-waste       as logical          no-undo.
     3080   define input parameter p-qnty           as decimal          no-undo.
     3081   define input parameter p-proc-number    as integer          no-undo.
     3082   define input parameter p-nws-self       as logical          no-undo.
     3083       define variable v-max-proc-num  as integer      no-undo.
     3084       define variable v-recipe-type   as character    no-undo.
     3085       define buffer buf_goods             for ub.goods.
     3086       define buffer buf_recipe-gds        for ub.recipe-gds.
     3087       define buffer buf_recipe            for ub.recipe.
     3088       define buffer buf_proc_recipe-gds   for ub.recipe-gds.
     3089   do
     3090   for buf_goods
     3091     , buf_recipe-gds
     3092     , buf_recipe
     3093     , buf_proc_recipe-gds
     3094   on error undo, return error
     3095   :
     3096       find first buf_recipe no-lock
     3097            where buf_recipe.recipe-code = p-recipe-code
     3098       .
     3099       find first buf_goods no-lock
     3100            where buf_goods.gds-code = p-gds-code
     3101       .
     3102       find first buf_recipe-gds
     3103            where buf_recipe-gds.recipe-code = p-recipe-code
     3104              and buf_recipe-gds.prod-type   = buf_goods.prod-type
     3105              and buf_recipe-gds.prod-code   = buf_goods.prod-code
     3106              and buf_recipe-gds.artic       = buf_goods.artic
     3107       no-error.
     3108       if not available buf_recipe-gds
     3109       then do:
     3110           create buf_recipe-gds.
     3111           assign
     3112               buf_recipe-gds.recipe-code = p-recipe-code
     3113               buf_recipe-gds.gds-code    = p-gds-code
     3114               buf_recipe-gds.prod-type   = buf_goods.prod-type
     3115               buf_recipe-gds.prod-code   = buf_goods.prod-code
     3116               buf_recipe-gds.artic       = buf_goods.artic
     3117           .
     3118           assign
     3119               buf_recipe-gds.is-waste    = no
     3120               buf_recipe-gds.qnty        = 0
     3121               buf_recipe-gds.coeff-waste = 0
     3122               buf_recipe-gds.brutto-qnty = 0
     3123               buf_recipe-gds.proc-number = 0
     3124               buf_recipe-gds.nws-self    = no
     3125           .
     3126       end.
     3127       assign
     3128           buf_recipe-gds.is-waste    = p-is-waste
     3129       .
     3130       run fbrlib-get-recipe-type in this-procedure (
     3131             input "":U
     3132           , input buf_recipe-gds.recipe-code
     3133           , output v-recipe-type
     3134       ).
     3135       if v-recipe-type <> 'производство':U
     3136       then do:
     3137           assign
     3138               buf_recipe-gds.calc-method = 1
     3139               buf_recipe-gds.qnty        = p-qnty
     3140               buf_recipe-gds.brutto-qnty = p-qnty
     3141               buf_recipe-gds.coeff-waste = 0
     3142           .
     3143       end.
     3144       else do:
     3145           assign
     3146               buf_recipe-gds.calc-method = 1
     3147               buf_recipe-gds.brutto-qnty = p-qnty
     3148           .
     3149           run fbrlib-calc-brutto in this-procedure (
     3150                 input v-recipe-type
     3151               , input 0
     3152               , input 0
     3153               , input buf_recipe-gds.coeff-waste
     3154               , input buf_recipe-gds.brutto-qnty
     3155               , input 1
     3156               , output buf_recipe-gds.qnty
     3157               , output buf_recipe-gds.coeff-waste
     3158               , output buf_recipe-gds.brutto-qnty
     3159               , output buf_recipe-gds.calc-method
     3160           ).
     3161       end.
     3162       assign
     3163           buf_recipe-gds.nws-self    = p-nws-self
     3164       .
     3165       if buf_recipe.recipe-type = 'альтернатива':U
     3166       and buf_recipe-gds.proc-number <> 0
     3167       then do:
     3168       end.
     3169       else do:
     3170           if p-proc-number <> 0
     3171           then do:
     3172               assign
     3173                   buf_recipe-gds.proc-number = p-proc-number
     3174               .
     3175           end.
     3176           else do:
     3177               assign
     3178                   v-max-proc-num = 0
     3179               .
     3180               for each buf_proc_recipe-gds no-lock
     3181                  where buf_proc_recipe-gds.recipe-code = p-recipe-code
     3182               :
     3183                   if recid( buf_proc_recipe-gds ) <> recid( buf_recipe-gds )
     3184                   then do:
     3185                       assign
     3186                           v-max-proc-num = ( if v-max-proc-num < buf_proc_recipe-gds.proc-number then buf_proc_recipe-gds.proc-number else v-max-proc-num )
     3187                       .
     3188                   end.
     3189               end.
     3190               assign
     3191                   buf_recipe-gds.proc-number = v-max-proc-num + 1
     3192               .
     3193           end.
     3194       end.
     3195   end.
     3196   end procedure.
     3197   PROCEDURE fbrlib-create-or-update-recipe :
     3198   define input parameter p-mode               as character    no-undo.
     3199   define input parameter p-obj-type           as character    no-undo.
     3200   define input parameter p-obj-code           as integer      no-undo.
     3201   define input parameter p-recipe-code        as character    no-undo.
     3202   define input parameter p-recipe-type        as character    no-undo.
     3203   define input parameter p-gds-code           as integer      no-undo.
     3204   define input parameter p-name               as character    no-undo.
     3205   define input parameter p-design             as character    no-undo.
     3206   define input parameter p-order              as integer      no-undo.
     3207   define input parameter p-quality            as character    no-undo.
     3208   define input parameter p-ref-num            as character    no-undo.
     3209   define input parameter p-technique          as character    no-undo.
     3210   define input parameter p-template           as character    no-undo.
     3211   define input parameter p-qnty               as decimal      no-undo.
     3212   define input parameter p-portion-qnty       as integer      no-undo.
     3213   define input parameter p-portion-weight     as decimal      no-undo.
     3214   define output parameter p-new-recipe-code   as character    no-undo.
     3215       define variable v-host-code         as integer      no-undo.
     3216       define variable v-fbr-gds-obj-recid as recid        no-undo.
     3217       define buffer buf_recipe    for ub.recipe.
     3218       define buffer buf_goods     for ub.goods.
     3219   do
     3220   for buf_recipe
     3221     , buf_goods
     3222   on error undo, return error
     3223   :
     3224       if p-mode <> 'ДОБАВЛЕНИЕ':U
     3225       and p-mode <> 'ИЗМЕНЕНИЕ':U
     3226       then do:
     3227           message
     3228               skip "Ошибка задания типа операции для создания или измения рецепта."
     3229               skip (1)
     3230               skip "Задан тип операции:" p-mode
     3231           view-as alert-box error.
     3232           undo, return error .
     3233       end.
     3234       if p-recipe-code = ""
     3235       then do:
     3236   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3237   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3238     (input  p-obj-type
     3239     ,input  p-obj-code
     3240     ,output v-host-code
     3241     )  .
     3242           find first buf_goods no-lock
     3243                where buf_goods.gds-code = p-gds-code
     3244           .
     3245           create buf_recipe .
     3246           run fbrcode-gen-recipe-code in this-procedure (
     3247                 input p-obj-type
     3248               , input p-obj-code
     3249               , output buf_recipe.recipe-code
     3250           ).
     3251           assign
     3252               buf_recipe.artic               = buf_goods.artic
     3253               buf_recipe.prod-type           = buf_goods.prod-type
     3254               buf_recipe.prod-code           = buf_goods.prod-code
     3255               buf_recipe.recipe-type         = p-recipe-type
     3256               buf_recipe.recipe-name         = ( if p-name = "" then buf_goods.gds-name else p-name )
     3257               buf_recipe.gds-code            = p-gds-code
     3258               buf_recipe.host-code           = v-host-code
     3259               buf_recipe.obj-type            = p-obj-type
     3260               buf_recipe.obj-code            = p-obj-code
     3261               buf_recipe.recipe-design       = ""
     3262               buf_recipe.recipe-order        = 0
     3263               buf_recipe.recipe-quality      = ""
     3264               buf_recipe.recipe-ref-num      = ""
     3265               buf_recipe.recipe-technique    = ""
     3266               buf_recipe.recipe-template     = ""
     3267               buf_recipe.qnty                = 1.0
     3268               buf_recipe.portion-qnty        = 1
     3269               buf_recipe.portion-weight      = 0
     3270           .
     3271       end.
     3272       if p-name <> ""
     3273       then do:
     3274           assign
     3275               buf_recipe.recipe-name = p-name
     3276           .
     3277       end.
     3278       assign
     3279           buf_recipe.recipe-design       = p-design
     3280           buf_recipe.recipe-order        = p-order
     3281           buf_recipe.recipe-quality      = p-quality
     3282           buf_recipe.recipe-ref-num      = p-ref-num
     3283           buf_recipe.recipe-technique    = p-technique
     3284           buf_recipe.recipe-template     = p-template
     3285           buf_recipe.qnty                = p-qnty
     3286           buf_recipe.portion-qnty        = p-portion-qnty
     3287           buf_recipe.portion-weight      = p-portion-weight
     3288       .
     3289       assign
     3290           p-new-recipe-code = buf_recipe.recipe-code
     3291       .
     3292       run fbrlib-set-default-recipe in this-procedure (
     3293             input p-obj-type
     3294           , input p-obj-code
     3295           , input buf_goods.gds-code
     3296       ).
     3297   end.
     3298   END PROCEDURE.
     3299   PROCEDURE fbrlib-delete-fact-fbr-doc :
     3300   define input parameter parparentproc-handle as widget-handle no-undo .
     3301   define input parameter p-doc-code   as character no-undo.
     3302   define input parameter p-chip-num   like ub.c-trn-doc.chip-num no-undo .
     3303       define variable v-shift-on      as logical      no-undo.
     3304       define variable v-shift-date    as date         no-undo.
     3305       define variable v-shift-num     as integer      no-undo.
     3306       define variable v-shift-name    as character    no-undo.
     3307       define variable v-obj-date      as date         no-undo.
     3308       define variable v-chip-num      as integer      no-undo.
     3309       define buffer buf_fbr-doc       for ub.fbr-doc.
     3310       define buffer buf_fbr-line      for ub.fbr-line.
     3311       define buffer buf_c-fbr-doc     for ub.c-fbr-doc.
     3312       define buffer buf_fbr-recipe     for ub.fbr-recipe.
     3313       define buffer buf_fbr-recipe-gds for ub.fbr-recipe-gds.
     3314       define buffer buf_marking-lines for ub.marking-lines .
     3315       define buffer buf_marking       for ub.marking .
     3316       define buffer buf_goods         for ub.goods .
     3317   do
     3318   for buf_fbr-doc
     3319     , buf_fbr-line
     3320     , buf_c-fbr-doc
     3321     , buf_fbr-recipe
     3322     , buf_fbr-recipe-gds
     3323     , buf_goods
     3324     , buf_marking
     3325     , buf_marking-lines
     3326   on error undo, return error
     3327   :
     3328   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3329     define variable v-cntxt-db-num        as integer   no-undo .
     3330     define variable v-cntxt-userid        as character no-undo .
     3331     define variable v-cntxt-level         as character no-undo .
     3332     define variable v-cntxt-host-code-obj as integer   no-undo .
     3333     define variable v-cntxt-obj-type      as character no-undo .
     3334     define variable v-cntxt-obj-code      as integer   no-undo .
     3335     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3336     define variable v-cntxt-is-admin      as logical   no-undo .
     3337   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3338     run mainmenu_getcntxt in parparentproc-handle
     3339       (output v-cntxt-db-num
     3340       ,output v-cntxt-userid
     3341       ,output v-cntxt-level
     3342       ,output v-cntxt-host-code-obj
     3343       ,output v-cntxt-obj-type
     3344       ,output v-cntxt-obj-code
     3345       ,output v-cntxt-db-num-obj
     3346       ,output v-cntxt-is-admin
     3347       ) .
     3348       if search ("delfbr.err") <> ?
     3349       then do:
     3350           os-delete "delfbr.err".
     3351       end.
     3352     _del-block:
     3353       do transaction
     3354     on error undo _del-block, return error return-value
     3355     on endkey undo _del-block , return error return-value
     3356     on stop undo _del-block , return error return-value
     3357       :
     3358           find first buf_fbr-doc exclusive-lock
     3359                where buf_fbr-doc.doc-code = p-doc-code
     3360           no-error.
     3361           if not available buf_fbr-doc
     3362           then do:
     3363         undo _del-block, return error substitute("&1 &2 &3&4Не найден документ производства &5 для удаления."
     3364                                           ,vss-workfile
     3365                                           ,vss-revision
     3366                                           ,vss-description
     3367                                           ,chr(10)
     3368                                           , p-doc-code).
     3369           end.
     3370           run fbrlib-delete-fact-trn-doc in this-procedure (
     3371               input parparentproc-handle
     3372              ,input p-doc-code
     3373              ,input 'при':U
     3374              ,input p-chip-num
     3375              ,output v-chip-num
     3376           ) no-error.
     3377           if error-status :error
     3378           then do:
     3379               run fbrlib-print-del-error-message in this-procedure .
     3380         undo _del-block, return error.
     3381           end.
     3382           assign
     3383           p-chip-num = (if p-chip-num = ?
     3384                         then v-chip-num
     3385                         else p-chip-num).
     3386           run fbrlib-delete-fact-trn-doc in this-procedure (
     3387               input parparentproc-handle
     3388              ,input p-doc-code
     3389              ,input 'рас':U
     3390              ,input p-chip-num
     3391              ,output v-chip-num
     3392           ) no-error.
     3393           if error-status :error
     3394           then do:
     3395               run fbrlib-print-del-error-message in this-procedure .
     3396         undo _del-block, return error.
     3397           end.
     3398           run fbrlib-delete-fact-trn-doc in this-procedure (
     3399               input parparentproc-handle
     3400              ,input p-doc-code
     3401              ,input 'спи':U
     3402              ,input p-chip-num
     3403              ,output v-chip-num
     3404           ) no-error.
     3405           if error-status :error
     3406           then do:
     3407               run fbrlib-print-del-error-message in this-procedure .
     3408         undo _del-block, return error.
     3409           end.
     3410           create buf_c-fbr-doc.
     3411           buffer-copy buf_fbr-doc to buf_c-fbr-doc.
     3412   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3413   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     3414     (input  buf_fbr-doc.obj-type
     3415     ,input  buf_fbr-doc.obj-code
     3416     ,output v-obj-date
     3417     ) no-error .
     3418           if error-status :error
     3419           or v-obj-date = ?
     3420           then do:
     3421         undo _del-block, return error "Нет текущей даты на объекте документа.".
     3422           end.
     3423   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3424   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     3425     (input  buf_fbr-doc.obj-type
     3426     ,input  buf_fbr-doc.obj-code
     3427     ,input  'shift-on=request'
     3428     ,output v-shift-on
     3429     )  .
     3430           if v-shift-on
     3431           then do:
     3432   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3433   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     3434     (input  buf_fbr-doc.obj-type
     3435     ,input  buf_fbr-doc.obj-code
     3436     ,output v-shift-date
     3437     ,output v-shift-num
     3438     ,output v-shift-name
     3439     ) no-error .
     3440               if error-status :error
     3441               then do:
     3442           undo _del-block, return error "Ошибка при поиске текущей смены на объекте".
     3443               end.
     3444           end.
     3445           else do:
     3446               assign
     3447                   v-shift-date = ?
     3448                   v-shift-num  = ?
     3449                   v-shift-name = ?
     3450               .
     3451           end.
     3452           define variable v-today       as date         no-undo.
     3453           define variable v-time        as integer      no-undo.
     3454           run cur-time in this-procedure (
     3455                 output v-today
     3456               , output v-time
     3457           ).
     3458           assign
     3459               buf_c-fbr-doc.chip-num         = (if p-chip-num <> ? then p-chip-num else next-value( s-corr-chip, ub  ))
     3460               buf_c-fbr-doc.corr-user-name   = v-cntxt-userid
     3461               buf_c-fbr-doc.corr-user-db-num = v-cntxt-db-num
     3462               buf_c-fbr-doc.corr-date        = v-today
     3463               buf_c-fbr-doc.corr-time        = v-time
     3464               buf_c-fbr-doc.corr-shift-date  = v-shift-date
     3465               buf_c-fbr-doc.corr-shift-num   = v-shift-num
     3466               buf_c-fbr-doc.corr-shift-name  = v-shift-name
     3467               buf_c-fbr-doc.is-del           = yes
     3468           .
     3469           assign
     3470               buf_fbr-doc.is-del = yes
     3471           .
     3472           for each buf_fbr-line exclusive-lock
     3473              where buf_fbr-line.doc-code = p-doc-code
     3474       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3475       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     3476       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     3477           :
     3478               for first buf_goods no-lock where buf_goods.artic      = buf_fbr-line.artic
     3479                                             and buf_goods.prod-type  = buf_fbr-line.prod-type
     3480                                             and buf_goods.prod-code  = buf_fbr-line.prod-code,
     3481               each buf_marking-lines exclusive-lock where buf_marking-lines.gds-code = buf_goods.gds-code
     3482                                                       and buf_marking-lines.obj-type = buf_fbr-doc.obj-type
     3483                                                       and buf_marking-lines.obj-code = buf_fbr-doc.obj-code
     3484                                                       and buf_marking-lines.in-code  = "manufacturing"
     3485                                                       and buf_marking-lines.out-code = buf_fbr-line.doc-code
     3486                                                       and buf_marking-lines.part-code = buf_fbr-line.recipe-code
     3487                                                       and buf_marking-lines.prt-code = 0
     3488               :
     3489                 for first buf_marking exclusive-lock where buf_marking.mark begins buf_marking-lines.mark :
     3490                   assign
     3491                     buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UsedInProduction:KeyIntDB when buf_fbr-line.is-comp
     3492                   .
     3493                 end .
     3494                 delete buf_marking-lines.
     3495               end .
     3496               delete buf_fbr-line.
     3497           end.
     3498           for each buf_fbr-recipe exclusive-lock
     3499              where buf_fbr-recipe.doc-code = p-doc-code
     3500       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3501       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     3502       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     3503           :
     3504               delete buf_fbr-recipe.
     3505           end.
     3506           for each buf_fbr-recipe-gds exclusive-lock
     3507              where buf_fbr-recipe-gds.doc-code = p-doc-code
     3508       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3509       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     3510       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     3511           :
     3512               delete buf_fbr-recipe-gds.
     3513           end.
     3514           delete buf_fbr-doc.
     3515       end.
     3516   end.
     3517   END PROCEDURE.
     3518   PROCEDURE fbrlib-del-trn-doc :
     3519   do
     3520   on error undo, return error
     3521   :
     3522   define input parameter parparentproc        as widget-handle no-undo .
     3523   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     3524   define input parameter p-trn-doc-type       as character    no-undo.
     3525   define input parameter p-phchip-num         like ub.c-trn-doc.chip-num no-undo .
     3526   define output parameter p-chip-num           like ub.c-trn-doc.chip-num no-undo .
     3527       define variable v-trn-doc-doc-code  as character     no-undo.
     3528       define buffer buf_trn-doc       for ub.trn-doc.
     3529   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3530     define variable v-cntxt-db-num        as integer   no-undo .
     3531     define variable v-cntxt-userid        as character no-undo .
     3532     define variable v-cntxt-level         as character no-undo .
     3533     define variable v-cntxt-host-code-obj as integer   no-undo .
     3534     define variable v-cntxt-obj-type      as character no-undo .
     3535     define variable v-cntxt-obj-code      as integer   no-undo .
     3536     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3537     define variable v-cntxt-is-admin      as logical   no-undo .
     3538   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3539     run mainmenu_getcntxt in parparentproc
     3540       (output v-cntxt-db-num
     3541       ,output v-cntxt-userid
     3542       ,output v-cntxt-level
     3543       ,output v-cntxt-host-code-obj
     3544       ,output v-cntxt-obj-type
     3545       ,output v-cntxt-obj-code
     3546       ,output v-cntxt-db-num-obj
     3547       ,output v-cntxt-is-admin
     3548       ) .
     3549       run fbrcode-trn-doc in this-procedure (
     3550             input 'производство':U
     3551           , input p-fbr-doc-doc-code
     3552           , input p-trn-doc-type
     3553           , output v-trn-doc-doc-code
     3554       ).
     3555       find first buf_trn-doc no-lock
     3556            where buf_trn-doc.doc-code = v-trn-doc-doc-code
     3557       no-error.
     3558       if available buf_trn-doc
     3559       then do:
     3560           run str/del-doc.p (
     3561                 input parparentproc
     3562               , input buf_trn-doc.doc-code
     3563               , input v-cntxt-db-num
     3564               , input "del-doc.err"
     3565               , input ?
     3566               , input p-fbr-doc-doc-code
     3567               , input v-cntxt-userid
     3568               , input 0
     3569               , input p-phchip-num
     3570               , output p-chip-num
     3571           ) no-error.
     3572           if error-status :error
     3573           then do:
     3574             undo, return error substitute("Не удалось удалить складской документ &1, созданный по документу производства &2.&3&4&3&5"
     3575                                           ,v-trn-doc-doc-code
     3576                                           ,p-fbr-doc-doc-code
     3577                                           , chr(10)
     3578                                           , error-status:get-message(1)
     3579                                           , return-value ).
     3580           end.
     3581       end.
     3582   end.
     3583   END PROCEDURE.
     3584   PROCEDURE fbrlib-delete-fact-trn-doc :
     3585   define input parameter parparentproc    as widget-handle    no-undo.
     3586   define input parameter p-fbr-doc-code   as character        no-undo.
     3587   define input parameter p-doc-type       as character    no-undo.
     3588   define input parameter p-ph-chip-num       like ub.c-trn-doc.chip-num no-undo .
     3589   define output parameter p-chip-num      like ub.c-trn-doc.chip-num no-undo .
     3590       define variable v-doc-code          as character        no-undo.
     3591       define variable v-ext-doc-type      as character        no-undo.
     3592       define variable v-trn-doc-recid     as recid            no-undo.
     3593       define variable varchip-code        as integer          no-undo.
     3594       define variable varchip-code2       as integer          no-undo.
     3595       define variable v-chip-counter      as integer          no-undo.
     3596       define buffer buf_trn-doc       for ub.trn-doc.
     3597       define buffer buf_pri_trn-doc   for ub.trn-doc.
     3598       define buffer buf_cons_trn-doc  for ub.trn-doc.
     3599   do
     3600   for buf_trn-doc
     3601     , buf_pri_trn-doc
     3602     , buf_cons_trn-doc
     3603   on error undo, return error
     3604   :
     3605   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3606     define variable v-cntxt-db-num        as integer   no-undo .
     3607     define variable v-cntxt-userid        as character no-undo .
     3608     define variable v-cntxt-level         as character no-undo .
     3609     define variable v-cntxt-host-code-obj as integer   no-undo .
     3610     define variable v-cntxt-obj-type      as character no-undo .
     3611     define variable v-cntxt-obj-code      as integer   no-undo .
     3612     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3613     define variable v-cntxt-is-admin      as logical   no-undo .
     3614   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3615     run mainmenu_getcntxt in parparentproc
     3616       (output v-cntxt-db-num
     3617       ,output v-cntxt-userid
     3618       ,output v-cntxt-level
     3619       ,output v-cntxt-host-code-obj
     3620       ,output v-cntxt-obj-type
     3621       ,output v-cntxt-obj-code
     3622       ,output v-cntxt-db-num-obj
     3623       ,output v-cntxt-is-admin
     3624       ) .
     3625       run fbrcode-trn-doc in this-procedure (
     3626             input 'производство':U
     3627           , input p-fbr-doc-code
     3628           , input p-doc-type
     3629           , output v-doc-code
     3630       ).
     3631       find first buf_trn-doc no-lock
     3632            where buf_trn-doc.doc-code = v-doc-code
     3633       no-error.
     3634       if not available buf_trn-doc
     3635       then do:
     3636           if p-doc-type <> 'спи':U
     3637           then do:
     3638               message
     3639                   "Не найден документ '" p-doc-type "'"
     3640                   "по документу производства " p-fbr-doc-code
     3641               view-as alert-box.
     3642               undo, return error.
     3643           end.
     3644           else do:
     3645           end.
     3646       end.
     3647       else do:
     3648           assign
     3649               v-trn-doc-recid = recid( buf_trn-doc )
     3650               v-ext-doc-type  = buf_trn-doc.ext-doc-type
     3651           .
     3652           if v-ext-doc-type = 'ev':U
     3653           then do:
     3654               find first buf_pri_trn-doc no-lock
     3655                    where buf_pri_trn-doc.out-code     = v-doc-code
     3656                      and buf_pri_trn-doc.ext-doc-type = 'iv':U
     3657               no-error.
     3658               if available buf_pri_trn-doc
     3659               then do:
     3660                   run str/del-doc.p (
     3661                         input parparentproc
     3662                       , input buf_pri_trn-doc.doc-code
     3663                       , input v-cntxt-db-num
     3664                       , input "delfbr.err"
     3665                       , input ?
     3666                       , input p-fbr-doc-code
     3667                       , input v-cntxt-userid
     3668                       , input 0
     3669                       , input (if p-ph-chip-num <> ?
     3670                               then p-ph-chip-num
     3671                               else (if varchip-code <> 0
     3672                                   then varchip-code
     3673                                   else ?)
     3674                               )
     3675                       , output varchip-code2
     3676                   ) no-error.
     3677                   if error-status :error
     3678                   then do:
     3679                     undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     3680                                                   ,buf_pri_trn-doc.doc-code
     3681                                                   ,p-fbr-doc-code
     3682                                                   , chr(10)
     3683                                                   , error-status:get-message(1)
     3684                                                   , return-value ).
     3685                   end.
     3686               end.
     3687           end.
     3688           define buffer buf_out_trn-doc       for ub.trn-doc.
     3689           if p-doc-type = 'при':U
     3690           then do:
     3691               assign
     3692                   v-chip-counter = 0
     3693               .
     3694               for each buf_out_trn-doc exclusive-lock
     3695                  where buf_out_trn-doc.out-code = buf_trn-doc.doc-code
     3696               on error undo, return error
     3697               :
     3698                   assign
     3699                       v-chip-counter = v-chip-counter + 1
     3700                   .
     3701                   if v-chip-counter > 1
     3702                   then do:
     3703                       assign
     3704                           varchip-code = varchip-code2
     3705                       .
     3706                   end.
     3707                   run str/del-doc.p (
     3708                         input parparentproc
     3709                       , input buf_out_trn-doc.doc-code
     3710                       , input v-cntxt-db-num
     3711                       , input "delfbr.err"
     3712                       , input ?
     3713                       , input p-fbr-doc-code
     3714                       , input v-cntxt-userid
     3715                       , input 0
     3716                       , input (if p-ph-chip-num <> ?
     3717                               then p-ph-chip-num
     3718                               else (if varchip-code <> 0
     3719                                   then varchip-code
     3720                                   else ?)
     3721                               )
     3722                       , output varchip-code2
     3723                   ) no-error.
     3724                   if error-status :error
     3725                   then do:
     3726                     undo, return error substitute("Ошибка при удалении складского документа &1, связанного со складским документов прихода &2, созданный по документу производства &3.&4&5&4&6"
     3727                                                   ,buf_out_trn-doc.doc-code
     3728                                                   ,buf_trn-doc.doc-code
     3729                                                   ,p-fbr-doc-code
     3730                                                   , chr(10)
     3731                                                   , error-status:get-message(1)
     3732                                                   , return-value ).
     3733                   end.
     3734               end.
     3735           end.
     3736           run str/del-doc.p (
     3737                 input parparentproc
     3738               , input buf_trn-doc.doc-code
     3739               , input v-cntxt-db-num
     3740               , input "delfbr.err"
     3741               , input ?
     3742               , input p-fbr-doc-code
     3743               , input v-cntxt-userid
     3744               , input 0
     3745               , input (if p-ph-chip-num <> ?
     3746                        then p-ph-chip-num
     3747                        else (if varchip-code <> 0
     3748                              then varchip-code
     3749                              else ?)
     3750                        )
     3751               , output varchip-code2
     3752           ) no-error.
     3753           if error-status :error
     3754           then do:
     3755               undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     3756                                             ,buf_trn-doc.doc-code
     3757                                             ,p-fbr-doc-code
     3758                                             , chr(10)
     3759                                             , error-status:get-message(1)
     3760                                             , return-value ).
     3761           end.
     3762           if p-doc-type = 'рас':U
     3763           or p-doc-type = 'спи':U
     3764           then do:
     3765               assign
     3766                   v-chip-counter = 0
     3767               .
     3768               for each buf_cons_trn-doc no-lock
     3769                  where buf_cons_trn-doc.out-code      = v-doc-code
     3770                    and buf_cons_trn-doc.ext-doc-type  = 'pc':U
     3771               :
     3772                   assign
     3773                       v-trn-doc-recid = recid( buf_cons_trn-doc )
     3774                       v-chip-counter = v-chip-counter + 1
     3775                   .
     3776                   assign
     3777                   varchip-code = if v-chip-counter = 2
     3778                                  then varchip-code2
     3779                                  else varchip-code.
     3780                   run str/del-doc.p (
     3781                         input parparentproc
     3782                       , input buf_cons_trn-doc.doc-code
     3783                       , input v-cntxt-db-num
     3784                       , input "delfbr.err"
     3785                       , input ?
     3786                       , input ?
     3787                       , input v-cntxt-userid
     3788                       , input 0
     3789                       , input (if p-ph-chip-num <> ?
     3790                                then p-ph-chip-num
     3791                                else ( if v-chip-counter = 1
     3792                                       then ?
     3793                                       else varchip-code )
     3794                                )
     3795                       , output varchip-code2
     3796                   ) no-error.
     3797                   if error-status :error
     3798                   then do:
     3799                       undo, return error substitute("Ошибка при удалении складского документа смены типа приобретения &1, созданный по документу производства &2.&3&4&3&5"
     3800                                                     ,buf_cons_trn-doc.doc-code
     3801                                                     ,p-fbr-doc-code
     3802                                                     , chr(10)
     3803                                                     , error-status:get-message(1)
     3804                                                     , return-value ).
     3805                   end.
     3806                   assign
     3807                       p-chip-num = varchip-code2
     3808                   .
     3809               end.
     3810           end.
     3811           assign
     3812               p-chip-num = varchip-code2
     3813           .
     3814       end.
     3815   end.
     3816   END PROCEDURE.
     3817   PROCEDURE fbrlib-print-del-error-message :
     3818   do
     3819   on error undo, return error
     3820   :
     3821       define variable v-user-action   as character    no-undo.
     3822       define variable v-printed       as logical      no-undo.
     3823       message
     3824           vss-workfile vss-revision vss-description
     3825           skip "Ошибка при удалении документа."
     3826           skip return-value
     3827           skip trim(error-status :get-message(1))
     3828           skip trim(error-status :get-message(2))
     3829           skip trim(error-status :get-message(3))
     3830       view-as alert-box error.
     3831       if search ("delfbr.err") <> ?
     3832       then do:
     3833         run gbl/prnfilen.w
     3834           (input  "Ошибки при удалении документа производства"
     3835           ,input  0
     3836           ,input  "delfbr.err"
     3837           ,input  7
     3838           ,output v-user-action
     3839           ,output v-printed
     3840           ).
     3841       end.
     3842   end.
     3843   END PROCEDURE.
     3844   procedure fbrlib-calc-brutto :
     3845   define input parameter p-recipe-type        as character        no-undo.
     3846   define input parameter p-netto              as decimal          no-undo.
     3847   define input parameter p-coeff-value        as decimal          no-undo.
     3848   define input parameter p-coeff-waste        as decimal          no-undo.
     3849   define input parameter p-brutto             as decimal          no-undo.
     3850   define input parameter p-calc-method        as integer          no-undo.
     3851   define output parameter p-new-netto         as decimal          no-undo.
     3852   define output parameter p-new-coeff-waste   as decimal          no-undo.
     3853   define output parameter p-new-brutto        as decimal          no-undo.
     3854   define output parameter p-new-calc-method   as integer          no-undo.
     3855   do
     3856   on error undo, return error
     3857   :
     3858       if p-recipe-type <> 'производство':U
     3859       then do:
     3860           assign
     3861               p-new-coeff-waste = 0
     3862               p-new-calc-method = 1
     3863               p-new-netto       = ( if p-calc-method = 1 then p-brutto else p-netto )
     3864               p-new-brutto      = ( if p-calc-method = 1 then p-brutto else p-netto )
     3865           .
     3866       end.
     3867       else do:
     3868           assign
     3869               p-new-calc-method = p-calc-method
     3870           .
     3871           if p-coeff-waste = 0
     3872           then do:
     3873               assign
     3874                   p-coeff-value = 0
     3875               .
     3876           end.
     3877           case p-calc-method
     3878           :
     3879               when 1
     3880               then do:
     3881                   assign
     3882                       p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     3883                       p-new-coeff-waste   = p-coeff-waste
     3884                       p-new-brutto        = p-brutto
     3885                   .
     3886               end.
     3887               when 2
     3888               then do:
     3889                   assign
     3890                       p-new-netto         = p-netto
     3891                       p-new-coeff-waste   = 100 - p-coeff-value - ( 100 * p-netto / p-brutto )
     3892                       p-new-brutto        = p-brutto
     3893                   .
     3894               end.
     3895               when 3
     3896               then do:
     3897                   assign
     3898                       p-new-netto         = p-netto
     3899                       p-new-coeff-waste   = p-coeff-waste
     3900                       p-new-brutto        = 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste )
     3901                   .
     3902               end.
     3903               otherwise do:
     3904                   define variable v-yesno    as logical      no-undo.
     3905                   assign
     3906                       v-yesno = yes
     3907                   .
     3908                   message
     3909                       "Неверный метод для расчета брутто, нетто и процента потерь."
     3910                       skip "Значение метода должно быть 1, 2 или 3."
     3911                       skip(1)
     3912                       skip "Заданное значение:" p-calc-method
     3913                       skip(1)
     3914                       skip "Установить значение метода расчета 1"
     3915                       skip "(расчет нетто по брутто и проценту потерь)?"
     3916                   view-as alert-box warning
     3917                   buttons yes-no
     3918                   title "Неверное значение метода пересчета в строках документа-производства"
     3919                   update v-yesno
     3920                   .
     3921                   if v-yesno = yes
     3922                   then do:
     3923                       assign
     3924                           p-new-calc-method   = 1
     3925                           p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     3926                           p-new-coeff-waste   = p-coeff-waste
     3927                           p-new-brutto        = p-brutto
     3928                       .
     3929                   end.
     3930                   else do:
     3931                       message
     3932                               vss-workfile vss-revision vss-description
     3933                           skip(1)
     3934                           skip "Ошибка расчета брутто, нетто и процента потерь."
     3935                           skip return-value
     3936                           skip trim(error-status :get-message(1))
     3937                               trim(error-status :get-message(2))
     3938                               trim(error-status :get-message(3))
     3939                       view-as alert-box error
     3940                       title "Неверное значение метода расчета"
     3941                       .
     3942                       undo, return error .
     3943                   end.
     3944               end.
     3945           end case.
     3946       end.
     3947   end.
     3948   end procedure.
     3949   procedure fbrlib-check-brutto :
     3950   define input parameter p-recipe-type        as character        no-undo.
     3951   define input parameter p-netto              as decimal          no-undo.
     3952   define input parameter p-coeff-value        as decimal          no-undo.
     3953   define input parameter p-coeff-waste        as decimal          no-undo.
     3954   define input parameter p-brutto             as decimal          no-undo.
     3955   define input parameter p-calc-method        as integer          no-undo.
     3956   define output parameter p-error-message     as character        no-undo.
     3957   define output parameter p-not-good          as logical          no-undo.
     3958   do
     3959   on error undo, return error
     3960   :
     3961       if p-recipe-type <> 'производство':U
     3962       then do:
     3963           if p-netto <> p-brutto
     3964           or p-coeff-waste <> 0
     3965           then do:
     3966               assign
     3967                   p-not-good      = yes
     3968                   p-error-message = substitute( "Во всех рецептах кроме рецепта производства должно выполняться:&1брутто = нетто и процент потерь = 0.&1&1Тип рецепта: &2&1Брутто: &3&1Нетто: &4&1Процент потерь: &5"
     3969                                           , chr(10), p-recipe-type, p-brutto, p-netto, p-coeff-waste )
     3970               .
     3971           end.
     3972       end.
     3973       else do:
     3974           if p-coeff-waste = 0
     3975           then do:
     3976               assign
     3977                   p-coeff-value = 0
     3978               .
     3979           end.
     3980           case p-calc-method
     3981           :
     3982               when 1
     3983               then do:
     3984                   if round( p-netto, 9 ) <> round( p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100, 9 )
     3985                   then do:
     3986                       assign
     3987                           p-not-good      = yes
     3988                           p-error-message = substitute( "Ошибка расчета нетто ( &2 ) &1 по брутто ( &3 ) &1 и процентам потерь ( &4, &5 )."
     3989                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     3990                       .
     3991                   end.
     3992               end.
     3993               when 2
     3994               then do:
     3995                   if round( p-coeff-waste, 9 ) <> round( 100 - p-coeff-value - ( 100 * p-netto / p-brutto ), 9 )
     3996                   then do:
     3997                       assign
     3998                           p-not-good      = yes
     3999                           p-error-message =  substitute( "Ошибка расчета процента потерь ( &2 ) &1 по нетто ( &3 ) &1 брутто ( &4 ) &1 и cезонному проценту ( &5 )."
     4000                                                   , chr(10), p-coeff-waste, p-netto, p-brutto, p-coeff-value )
     4001                       .
     4002                   end.
     4003               end.
     4004               when 3
     4005               then do:
     4006                   if round( p-brutto, 9 ) <> round( 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste ), 9 )
     4007                   then do:
     4008                       assign
     4009                           p-not-good      = yes
     4010                           p-error-message = substitute( "Ошибка расчета брутто ( &3 ) &1 по нетто ( &2 ) &1 и процентам потерь ( &4, &5 )."
     4011                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     4012                       .
     4013                   end.
     4014               end.
     4015               otherwise do:
     4016                   assign
     4017                       p-not-good      = yes
     4018                       p-error-message = substitute( "Ошибка ввода метода расчета ( &1 ).", p-calc-method )
     4019                   .
     4020               end.
     4021           end case.
     4022       end.
     4023   end.
     4024   end procedure.
     4025   procedure fbrlib-check-fbr-recipe :
     4026   define input parameter p-doc-code       as character        no-undo.
     4027   define input parameter p-recipe-code    as character        no-undo.
     4028   define output parameter p-is-correct    as logical          no-undo.
     4029       define variable v-comp-factor    as decimal      no-undo.
     4030       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     4031       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     4032       define buffer buf_fbr-line          for ub.fbr-line.
     4033   do
     4034   for buf_fbr-recipe
     4035     , buf_fbr-recipe-gds
     4036     , buf_fbr-line
     4037   on error undo, return error
     4038   :
     4039       assign
     4040           p-is-correct = yes
     4041       .
     4042       find first buf_fbr-recipe no-lock
     4043            where buf_fbr-recipe.doc-code    = p-doc-code
     4044              and buf_fbr-recipe.recipe-code = p-recipe-code no-error
     4045       .
     4046       if not available buf_fbr-recipe then do:
     4047         undo, return error substitute("Не найден рецепт (fbr-recipe) с кодом &1 для  документа пр-ва &2", p-recipe-code, p-doc-code).
     4048       end.
     4049       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     4050       then do:
     4051       end.
     4052       else do:
     4053           find first buf_fbr-line no-lock
     4054                where buf_fbr-line.doc-code    = buf_fbr-recipe.doc-code
     4055                  and buf_fbr-line.is-comp     = yes
     4056                  and buf_fbr-line.recipe-code = buf_fbr-recipe.recipe-code
     4057                  and buf_fbr-line.artic       = buf_fbr-recipe.artic
     4058                  and buf_fbr-line.prod-type   = buf_fbr-recipe.prod-type
     4059                  and buf_fbr-line.prod-code   = buf_fbr-recipe.prod-code
     4060           .
     4061           assign
     4062               v-comp-factor = buf_fbr-line.fact-qnty / buf_fbr-recipe.qnty
     4063           .
     4064           recipe-line-cycle:
     4065           for each buf_fbr-recipe-gds no-lock
     4066              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     4067                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     4068           on error undo, return error
     4069           :
     4070               find first buf_fbr-line no-lock
     4071                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     4072                      and buf_fbr-line.is-comp     = no
     4073                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     4074                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4075                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4076                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4077               .
     4078               if absolute( buf_fbr-line.fact-qnty / buf_fbr-recipe-gds.brutto-qnty - v-comp-factor ) > 0.000000001
     4079               then do:
     4080                   assign
     4081                       p-is-correct = no
     4082                   .
     4083                   leave recipe-line-cycle.
     4084               end.
     4085           end.
     4086       end.
     4087   end.
     4088   end procedure.
     4089   procedure fbrlib-get-recipe-type :
     4090   define input parameter p-fbr-doc-code   as character        no-undo.
     4091   define input parameter p-recipe-code    as character        no-undo.
     4092   define output parameter p-recipe-type   as character        no-undo.
     4093       define buffer buf_recipe        for ub.recipe.
     4094       define buffer buf_fbr-recipe    for ub.fbr-recipe.
     4095   do
     4096   for buf_recipe
     4097     , buf_fbr-recipe
     4098   on error undo, return error
     4099   :
     4100       if p-fbr-doc-code = ""
     4101       then do:
     4102           find first buf_recipe no-lock
     4103                where buf_recipe.recipe-code = p-recipe-code
     4104           no-error.
     4105           if available buf_recipe
     4106           then do:
     4107               assign
     4108                   p-recipe-type = buf_recipe.recipe-type
     4109               .
     4110           end.
     4111           else do:
     4112               assign
     4113                   p-recipe-type = "":U
     4114               .
     4115           end.
     4116       end.
     4117       else do:
     4118           find first buf_fbr-recipe no-lock
     4119                where buf_fbr-recipe.doc-code      = p-fbr-doc-code
     4120                  and buf_fbr-recipe.recipe-code   = p-recipe-code
     4121           no-error.
     4122           if available buf_fbr-recipe
     4123           then do:
     4124               assign
     4125                   p-recipe-type = buf_fbr-recipe.recipe-type
     4126               .
     4127           end.
     4128           else do:
     4129               assign
     4130                   p-recipe-type = "":U
     4131               .
     4132           end.
     4133       end.
     4134   end.
     4135   end procedure.
     4136   PROCEDURE calc-comp-from-ingr :
     4137   define input parameter p-fbr-v-fbr-doc-line-recid           as recid        no-undo.
     4138   define input parameter p-fact-qnty                          as decimal      no-undo.
     4139   define output parameter p-comp-fbr-v-fbr-doc-line-recid     as recid        no-undo.
     4140   define output parameter p-comp-qnty                         as decimal      no-undo.
     4141       define variable v-ingr-qnty     as decimal       no-undo.
     4142       define buffer buf_i_fbr-line    for ub.fbr-line.
     4143       define buffer buf_fbr-line      for ub.fbr-line.
     4144       define buffer buf_recipe        for ub.fbr-recipe.
     4145       define buffer buf_recipe-gds    for ub.fbr-recipe-gds.
     4146   do
     4147   for buf_i_fbr-line
     4148     , buf_fbr-line
     4149     , buf_recipe
     4150     , buf_recipe-gds
     4151   on error undo, return error
     4152   :
     4153       find first buf_i_fbr-line no-lock
     4154            where recid( buf_i_fbr-line ) = p-fbr-v-fbr-doc-line-recid
     4155       .
     4156       find first buf_recipe no-lock
     4157            where buf_recipe.doc-code      = buf_i_fbr-line.doc-code
     4158              and buf_recipe.recipe-code   = buf_i_fbr-line.recipe-code
     4159       no-error.
     4160       if not available buf_recipe
     4161       then do:
     4162           message
     4163                   vss-workfile vss-revision vss-description
     4164               skip "В строке производства не указан рецепт."
     4165               skip "Невозможно рассчитать количество составного товара."
     4166               skip return-value
     4167               skip trim(error-status :get-message(1))
     4168                   trim(error-status :get-message(2))
     4169                   trim(error-status :get-message(3))
     4170           view-as alert-box error.
     4171           undo, return error .
     4172       end.
     4173       if buf_recipe.recipe-type = 'альтернатива':U
     4174       then do:
     4175           for each buf_fbr-line no-lock
     4176              where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     4177                and buf_fbr-line.trn-type    = buf_i_fbr-line.trn-type
     4178                and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     4179           on error undo, return error
     4180           :
     4181               find first buf_recipe-gds no-lock
     4182                    where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     4183                      and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     4184                      and buf_recipe-gds.artic       = buf_fbr-line.artic
     4185                      and buf_recipe-gds.prod-type   = buf_fbr-line.prod-type
     4186                      and buf_recipe-gds.prod-code   = buf_fbr-line.prod-code
     4187               .
     4188               assign
     4189                   p-comp-qnty         = p-comp-qnty       + ( buf_fbr-line.fact-qnty * buf_recipe-gds.brutto-qnty )
     4190               .
     4191           end.
     4192           assign
     4193               p-comp-qnty         = p-comp-qnty       / buf_recipe.qnty
     4194           .
     4195       end.
     4196       else do:
     4197           find first buf_recipe-gds no-lock
     4198                where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     4199                  and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     4200                  and buf_recipe-gds.artic       = buf_i_fbr-line.artic
     4201                  and buf_recipe-gds.prod-type   = buf_i_fbr-line.prod-type
     4202                  and buf_recipe-gds.prod-code   = buf_i_fbr-line.prod-code
     4203           .
     4204           assign
     4205               p-comp-qnty = p-fact-qnty / buf_recipe-gds.brutto-qnty * buf_recipe.qnty
     4206           .
     4207       end.
     4208       find first buf_fbr-line no-lock
     4209            where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     4210              and buf_fbr-line.is-comp     = yes
     4211              and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     4212       .
     4213       assign
     4214           p-comp-fbr-v-fbr-doc-line-recid = recid( buf_fbr-line )
     4215       .
     4216   end.
     4217   END PROCEDURE.
     4218   PROCEDURE get-temp_dressing-ingr-used-qnty :
     4219   define input parameter p-recipe-code    as character    no-undo.
     4220   define input parameter p-gds-code       as integer      no-undo.
     4221   define output parameter p-line-qnty     as decimal      no-undo.
     4222   define output parameter p-used-qnty     as decimal      no-undo.
     4223   define output parameter p-recipe-qnty   as decimal      no-undo.
     4224       define buffer buf_temp_dressing-ingr    for temp_dressing-ingr.
     4225   do
     4226   for buf_temp_dressing-ingr
     4227   on error undo, return error
     4228   :
     4229       find first buf_temp_dressing-ingr no-lock
     4230            where buf_temp_dressing-ingr.recipe-code = p-recipe-code
     4231              and buf_temp_dressing-ingr.gds-code    = p-gds-code
     4232       no-error.
     4233       if available buf_temp_dressing-ingr
     4234       then do:
     4235           assign
     4236               p-line-qnty     = buf_temp_dressing-ingr.line-qnty
     4237               p-used-qnty     = buf_temp_dressing-ingr.used-qnty
     4238               p-recipe-qnty   = buf_temp_dressing-ingr.recipe-qnty
     4239           .
     4240       end.
     4241       else do:
     4242           assign
     4243               p-line-qnty     = 0
     4244               p-used-qnty     = 0
     4245               p-recipe-qnty   = 0
     4246           .
     4247       end.
     4248   end.
     4249   END PROCEDURE.
     4250   PROCEDURE fbrlib_adjust-recipe :
     4251   do
     4252   on error undo, return error
     4253   :
     4254   define input parameter parparentproc as widget-handle no-undo .
     4255   define input parameter p-fbrhist-handle as handle no-undo .
     4256   define input parameter p-doc-code       as character    no-undo.
     4257   define input parameter p-recipe-code    as character    no-undo.
     4258   define input parameter p-price-sale-obj-type as character no-undo .
     4259   define input parameter p-price-sale-obj-code as integer no-undo .
     4260       define variable v-recipe-qnty       as decimal      no-undo.
     4261       define variable v-comp-qnty         as decimal      no-undo.
     4262       define variable v-recipe-gds-qnty   as decimal      no-undo.
     4263       define variable v-ingr-qnty         as decimal      no-undo.
     4264       define variable v-qnty              as decimal      no-undo.
     4265       define variable v-coeff-waste       as decimal      no-undo.
     4266       define variable v-brutto-qnty       as decimal      no-undo.
     4267       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     4268       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     4269       define buffer buf_fbr-line          for ub.fbr-line.
     4270       define buffer buf_el_fbr-recipe-gds for ub.fbr-recipe-gds.
     4271       find first buf_fbr-recipe no-lock
     4272            where buf_fbr-recipe.doc-code      = p-doc-code
     4273              and buf_fbr-recipe.recipe-code   = p-recipe-code
     4274       .
     4275       assign
     4276           v-recipe-qnty = buf_fbr-recipe.qnty
     4277       .
     4278       find first buf_fbr-line no-lock
     4279            where buf_fbr-line.doc-code    = p-doc-code
     4280              and buf_fbr-line.is-comp     = yes
     4281              and buf_fbr-line.recipe-code = p-recipe-code
     4282       .
     4283       assign
     4284           v-comp-qnty = buf_fbr-line.fact-qnty
     4285       .
     4286       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     4287       then do:
     4288       end.
     4289       else do:
     4290           for each buf_fbr-recipe-gds no-lock
     4291              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     4292                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     4293           on error undo, return error
     4294           :
     4295               find first buf_fbr-line no-lock
     4296                    where buf_fbr-line.doc-code    = p-doc-code
     4297                      and buf_fbr-line.is-comp     = no
     4298                      and buf_fbr-line.recipe-code = p-recipe-code
     4299                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4300                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4301                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4302               .
     4303               if buf_fbr-line.fact-qnty / v-comp-qnty <> buf_fbr-recipe-gds.brutto-qnty / v-recipe-qnty
     4304               then do:
     4305                   do transaction
     4306                   on error undo, return error
     4307                   :
     4308                       find first buf_el_fbr-recipe-gds exclusive-lock
     4309                            where recid( buf_el_fbr-recipe-gds ) = recid( buf_fbr-recipe-gds )
     4310                       .
     4311                       assign
     4312                           buf_el_fbr-recipe-gds.calc-method   = 1
     4313                           buf_el_fbr-recipe-gds.brutto-qnty   = buf_fbr-line.fact-qnty * v-recipe-qnty / v-comp-qnty
     4314                       .
     4315                       run fbrlib-calc-brutto in this-procedure (
     4316                             input buf_fbr-recipe.recipe-type
     4317                           , input 0
     4318                           , input buf_el_fbr-recipe-gds.coeff-value
     4319                           , input buf_el_fbr-recipe-gds.coeff-waste
     4320                           , input buf_el_fbr-recipe-gds.brutto-qnty
     4321                           , input 1
     4322                           , output buf_el_fbr-recipe-gds.qnty
     4323                           , output buf_el_fbr-recipe-gds.coeff-waste
     4324                           , output buf_el_fbr-recipe-gds.brutto-qnty
     4325                           , output buf_el_fbr-recipe-gds.calc-method
     4326                       ).
     4327                   end.
     4328               end.
     4329           end.
     4330           run fbrlib_adjust-doc-lines in this-procedure (
     4331                 input parparentproc
     4332               , input p-fbrhist-handle
     4333               , input p-doc-code
     4334               , input p-recipe-code
     4335               , input p-price-sale-obj-type
     4336               , input p-price-sale-obj-code
     4337           ).
     4338       end.
     4339   end.
     4340   END PROCEDURE.
     4341   PROCEDURE fbrlib_adjust-doc-lines :
     4342   define input parameter parparentproc as widget-handle no-undo .
     4343   define input parameter p-fbrhist-handle as handle no-undo .
     4344   define input parameter p-doc-code       as character    no-undo.
     4345   define input parameter p-recipe-code    as character    no-undo.
     4346   define input parameter p-price-sale-obj-type as character no-undo .
     4347   define input parameter p-price-sale-obj-code as integer no-undo .
     4348   define variable v-comp-qnty         as decimal      no-undo.
     4349   define variable v-trn-type          as character    no-undo.
     4350   define variable v-ingr-qnty         as decimal      no-undo.
     4351   define variable v-recipe-qnty       as decimal      no-undo.
     4352   define variable v-fbr-v-fbr-doc-line-recid    as recid        no-undo.
     4353   define buffer buf_fbr-recipe        for ub.fbr-recipe.
     4354   define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     4355   define buffer buf_fbr-line          for ub.fbr-line.
     4356   define buffer buf_coeff_fbr-line    for ub.fbr-line.
     4357   define buffer buf_goods             for ub.goods.
     4358   define buffer buf_fbr-doc           for ub.fbr-doc.
     4359   do
     4360   for buf_fbr-recipe
     4361     , buf_fbr-recipe-gds
     4362     , buf_fbr-line
     4363     , buf_coeff_fbr-line
     4364     , buf_goods
     4365     , buf_fbr-doc
     4366   on error undo, return error
     4367   :
     4368       find first buf_fbr-line no-lock
     4369            where buf_fbr-line.doc-code      = p-doc-code
     4370              and buf_fbr-line.is-comp       = yes
     4371              and buf_fbr-line.recipe-code   = p-recipe-code
     4372       .
     4373       find first buf_fbr-doc no-lock
     4374            where buf_fbr-doc.doc-code      = p-doc-code
     4375       .
     4376       assign
     4377           v-comp-qnty = buf_fbr-line.fact-qnty
     4378           v-trn-type  = buf_fbr-line.trn-type
     4379       .
     4380       find first buf_fbr-recipe no-lock
     4381            where buf_fbr-recipe.doc-code    = p-doc-code
     4382              and buf_fbr-recipe.recipe-code = p-recipe-code
     4383       .
     4384       assign
     4385       v-recipe-qnty = buf_fbr-recipe.qnty
     4386       .
     4387       do transaction
     4388       on error undo, return error
     4389       :
     4390           for each buf_fbr-recipe-gds no-lock
     4391              where buf_fbr-recipe-gds.doc-code      = p-doc-code
     4392                and buf_fbr-recipe-gds.recipe-code   = p-recipe-code
     4393           on error undo, return error
     4394           :
     4395               find first buf_fbr-line no-lock
     4396                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     4397                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     4398                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4399                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4400                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4401               no-error.
     4402               if not available buf_fbr-line
     4403               then do:
     4404                   find first buf_goods no-lock
     4405                        where buf_goods.artic      = buf_fbr-recipe-gds.artic
     4406                          and buf_goods.prod-type  = buf_fbr-recipe-gds.prod-type
     4407                          and buf_goods.prod-code  = buf_fbr-recipe-gds.prod-code
     4408                   .
     4409                   run str/fbr-crln.p (
     4410                         input parparentproc
     4411                       , input recid( buf_fbr-doc )
     4412                       , input recid( buf_goods )
     4413                       , input buf_fbr-recipe-gds.recipe-code
     4414                       , input v-trn-type
     4415                       , input no
     4416                       , input no
     4417                       , input buf_fbr-doc.obj-type
     4418                       , input buf_fbr-doc.obj-code
     4419                       , output v-fbr-v-fbr-doc-line-recid
     4420                   ).
     4421                   find first buf_fbr-line no-lock
     4422                        where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     4423                          and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     4424                          and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4425                          and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4426                          and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4427                   no-error.
     4428                   if not available buf_fbr-line
     4429                   then do:
     4430                       undo, return error substitute("Не удалось создать строку документа производства &1 &2&3&4"
     4431                                                      , p-doc-code
     4432                                                      , buf_fbr-recipe-gds.artic
     4433                                                      , buf_fbr-recipe-gds.prod-type
     4434                                                      , buf_fbr-recipe-gds.prod-code).
     4435                   end.
     4436               end.
     4437               find first buf_coeff_fbr-line exclusive-lock
     4438                    where recid( buf_coeff_fbr-line ) = recid( buf_fbr-line )
     4439               .
     4440               if buf_coeff_fbr-line.calc-method <> buf_fbr-recipe-gds.calc-method
     4441               or buf_coeff_fbr-line.coeff-value <> buf_fbr-recipe-gds.coeff-value
     4442               or buf_coeff_fbr-line.coeff-waste <> buf_fbr-recipe-gds.coeff-waste
     4443               then do:
     4444                   assign
     4445                       buf_coeff_fbr-line.calc-method = buf_fbr-recipe-gds.calc-method
     4446                       buf_coeff_fbr-line.coeff-value = buf_fbr-recipe-gds.coeff-value
     4447                       buf_coeff_fbr-line.coeff-waste = buf_fbr-recipe-gds.coeff-waste
     4448                   .
     4449               end.
     4450           end.
     4451       end.
     4452       define variable v-need-goods    as logical       no-undo.
     4453       define variable v-need-goods-list       as character     no-undo.
     4454       define variable v-need-goods-qnty-list  as character     no-undo.
     4455       find first buf_fbr-line no-lock
     4456            where buf_fbr-line.doc-code    = buf_fbr-doc.doc-code
     4457              and buf_fbr-line.is-comp     = yes
     4458              and buf_fbr-line.recipe-code = p-recipe-code
     4459       .
     4460       run str/fbr-qnty.p (
     4461             input parparentproc
     4462           , input p-fbrhist-handle
     4463           , input recid( buf_fbr-doc )
     4464           , input recid( buf_fbr-line )
     4465           , input no
     4466           , input "ingr"
     4467           , input no
     4468           , input p-price-sale-obj-type
     4469           , input p-price-sale-obj-code
     4470           , input no
     4471           , input no
     4472           , input no
     4473           , output v-need-goods
     4474           , output v-need-goods-list
     4475           , output v-need-goods-qnty-list
     4476       ).
     4477   end.
     4478   END PROCEDURE.
     4479   procedure fbrlib_check-before-close :
     4480   define input parameter p-doc-code as character no-undo .
     4481   define variable same-sale as decimal no-undo .
     4482   define variable is-waste as logical no-undo .
     4483   define variable fix-price as logical no-undo .
     4484   define buffer buf_fbr-doc for ub.fbr-doc.
     4485   define buffer buf_fbr-line for ub.fbr-line.
     4486   define buffer buf_goods for ub.goods.
     4487   define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     4488   do
     4489   on error undo, return error
     4490   :
     4491     for each buf_fbr-line no-lock
     4492         where buf_fbr-line.doc-code = p-doc-code
     4493       , each buf_goods no-lock
     4494         where buf_goods.artic     = buf_fbr-line.artic
     4495           and buf_goods.prod-type = buf_fbr-line.prod-type
     4496           and buf_goods.prod-code = buf_fbr-line.prod-code
     4497     break by buf_fbr-line.prod-type
     4498           by buf_fbr-line.prod-code
     4499           by buf_fbr-line.artic
     4500     :
     4501       if first-of (buf_fbr-line.artic)
     4502       then do:
     4503         assign
     4504         same-sale = buf_fbr-line.price-sale
     4505         is-waste = (buf_fbr-line.rsrv-qnty = ?)
     4506         fix-price = buf_fbr-line.is-calc
     4507         .
     4508       end.
     4509       if same-sale <> buf_fbr-line.price-sale
     4510       then do:
     4511           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром должна быть указана одна и та же цена продажи."
     4512                                         ,p-doc-code
     4513                                         ,buf_goods.artic
     4514                                         ,buf_goods.gds-name
     4515                                         ,chr(10)).
     4516       end.
     4517       if fix-price <> buf_fbr-line.is-calc then do:
     4518           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром цена должна быть фиксирована или нет."
     4519                                         ,p-doc-code
     4520                                         ,buf_goods.artic
     4521                                         ,buf_goods.gds-name
     4522                                         ,chr(10)).
     4523       end.
     4524       if is-waste <> (buf_fbr-line.rsrv-qnty = ?)
     4525       then do:
     4526         undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа этот товар должен быть отходом либо не отходом."
     4527                                         ,p-doc-code
     4528                                         ,buf_goods.artic
     4529                                         ,buf_goods.gds-name
     4530                                         ,chr(10)).
     4531       end.
     4532       if buf_fbr-line.rsrv-qnty <> ?
     4533       and buf_goods.gds-type <> 'у':U
     4534       and ( buf_fbr-line.price-sale <= 0 or buf_fbr-line.price-sale = ?  )
     4535       and buf_fbr-line.fact-qnty <> 0
     4536       then do:
     4537         if buf_fbr-line.trn-type     = 'при':U  then for first buf_fbr-doc where buf_fbr-doc.doc-code =  p-doc-code no-lock:
     4538           if  can-find(first buf_fbr-gds-obj no-lock where
     4539                   buf_fbr-gds-obj.gds-code = buf_goods.gds-code
     4540               AND buf_fbr-gds-obj.obj-type = buf_fbr-doc.obj-type
     4541               AND buf_fbr-gds-obj.obj-code = buf_fbr-doc.obj-code
     4542               and buf_fbr-gds-obj.is-null-price  )  then .
     4543                     else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     4544                                         ,p-doc-code
     4545                                         ,buf_goods.artic
     4546                                         ,buf_goods.gds-name
     4547                                         ,chr(10)
     4548                                         ,buf_fbr-line.recipe-code
     4549                                         ).
     4550         end.
     4551         else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     4552                                         ,p-doc-code
     4553                                         ,buf_goods.artic
     4554                                         ,buf_goods.gds-name
     4555                                         ,chr(10)
     4556                                         ,buf_fbr-line.recipe-code
     4557                                         ).
     4558       end.
     4559     end.
