     6053   DEFINE FRAME InfoFrame
     6054        StopBtn AT ROW 4.25 COL 21.75
     6055        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     6056        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     6057        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     6058        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     6059        RECT-1 AT ROW 1 COL 1
     6060       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     6061            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     6062            TITLE "Процесс"
     6063            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     6064   define variable mFrameView      as logical   no-undo init yes.
     6065     define variable mFramHandle as handle no-undo.
     6066     mFramHandle = frame InfoFrame:handle.
     6067     if  log-manager:logfile-name ne ?
     6068     then DO:
     6069         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     6070         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     6071         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     6072     end.
     6073     mFrameView = not session:batch-mode and mFramHandle:visible.
     6074     if mFrameView
     6075     then do:
     6076       ASSIGN
     6077          FRAME InfoFrame:HIDDEN                           = TRUE
     6078          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     6079     end.
     6080   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     6081   DO:
     6082     IF not StopProcessing THEN
     6083       Message "Вы действительно хотите прервать" SKIP
     6084               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     6085                 UPDATE StopProcessing.
     6086     IF StopProcessing THEN do:
     6087        if mFrameView
     6088        then do:
     6089           HIDE FRAME InfoFrame.
     6090        end.
     6091     End.
     6092   END.
     6093   assign v-account = ( if integer( 25 ) = 0 then 100 else integer( 25 ) ).
     6094     if  log-manager:logfile-name ne ?
     6095     then DO:
     6096         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     6097     end.
     6098     if not session:batch-mode then
     6099     do:
     6100       VIEW FRAME InfoFrame.
     6101       mFrameView = true.
     6102     end.
     6103      v-button-stop = false .
     6104         if mFrameView
     6105         then do:
     6106         if v-button-stop then view STOPBTN in frame InfoFrame.
     6107                          else Hide STOPBTN in frame InfoFrame.
     6108         end.
