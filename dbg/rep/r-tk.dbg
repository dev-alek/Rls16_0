     5596     define variable v-attr-value   as character no-undo .
     5597     define variable v-attr-type    as character no-undo .
     5598     define variable v-calories     as decimal   no-undo .
     5599     define variable v-protein      as decimal   no-undo .
     5600     define variable v-carbohydrate as decimal   no-undo .
     5601     define variable v-fat          as decimal   no-undo .
     5602   do
     5603   on error undo, return error return-value
     5604   :
     5605     assign
     5606       p-carbohydrate = ?
     5607     .
