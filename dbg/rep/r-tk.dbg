      369   .
      370   procedure create_obj-list :
      371      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      372      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      373      do
      374      on error undo, return error return-value
      375      :
      376         define buffer cli-obj for ub.clients .
      377         define variable p-var as integer no-undo .
      378         define buffer buf_obj-list for obj-list .
      379         find last buf_obj-list  use-index pi no-error .
      380         if available buf_obj-list
      381         then
      382            p-var = buf_obj-list.obj-id + 1.
      383         else
      384            p-var = 1.
      385         find first cli-obj where
      386                   cli-obj.obj-type = p-obj-type
      387               and cli-obj.obj-code = p-obj-code
      388         no-lock no-error.
      389         if available cli-obj
      390         then do:
      391            create buf_obj-list.
      392            assign
      393               buf_obj-list.obj-id   = p-var
      394               buf_obj-list.obj-code = cli-obj.obj-code
      395               buf_obj-list.obj-type = cli-obj.obj-type
      396               buf_obj-list.obj-name = cli-obj.obj-name
      397               buf_obj-list.db-num   = cli-obj.db-num
      398            .
      399         end.
      400      end.
      401   end.
