     1012         then do:
     1013           message
     1014             vss-workfile vss-revision vss-description skip
     1015             vss-include-info10 skip
     1016             "Невозможно найти товар на объекте" skip
     1017             "Объект" p-obj-type p-obj-code skip
     1018             "Артикул" p-artic p-prod-type p-prod-code skip
     1019             error-status :get-message(1) skip
     1020             return-value skip
     1021             view-as alert-box error .
     1022           undo, return error .
     1023         end.
     1024         find current buf_gds-obj exclusive-lock .
     1025       end.
     1026       run partslib-init-temp-parts in this-procedure
     1027         (input p-obj-type
     1028         ,input p-obj-code
     1029         ,input p-artic
     1030         ,input p-prod-type
     1031         ,input p-prod-code
     1032         ) no-error .
     1033       if error-status :error
     1034       then do:
     1035         message
     1036           vss-workfile vss-revision vss-description skip
     1037           vss-include-info10 skip
     1038           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
     1039           "Объект" p-obj-type p-obj-code skip
     1040           "Артикул" p-artic p-prod-type p-prod-code skip
     1041           "p-fact-order" p-fact-order skip
     1042           view-as alert-box error .
     1043         undo, return error .
     1044       end.
     1045       if p-include-fact-order = true
     1046       then do:
     1047         assign
     1048           p-fact-order = p-fact-order - 0.0000000001
     1049         .
     1050       end.
     1051       define variable v-max-fact-order as character no-undo .
     1052       run factord-max-fact-order in this-procedure
     1053         (output v-max-fact-order
     1054         ) no-error .
     1055       if error-status :error
     1056       then do:
     1057         message
     1058           vss-workfile vss-revision vss-description skip
     1059           vss-include-info10 skip
     1060           "Ошибка при вызове процедуры factord-max-fact-order" skip
     1061           "Объект" p-obj-type p-obj-code skip
     1062           "Артикул" p-artic p-prod-type p-prod-code skip
     1063           "p-fact-order" p-fact-order skip
     1064           view-as alert-box error .
     1065         undo, return error .
     1066       end.
     1067       run partslib-update-by-factord in this-procedure
     1068         (input p-obj-type
     1069         ,input p-obj-code
     1070         ,input p-artic
     1071         ,input p-prod-type
     1072         ,input p-prod-code
     1073         ,input p-fact-order
     1074         ,input v-max-fact-order
     1075         ,input false
     1076         ) no-error .
     1077       if error-status :error
     1078       then do:
     1079         message
     1080           vss-workfile vss-revision vss-description skip
     1081           vss-include-info10 skip
     1082           "Ошибка при вызове процедуры partslib-update-by-factord" skip
     1083           "Объект" p-obj-type p-obj-code skip
     1084           "Артикул" p-artic p-prod-type p-prod-code skip
     1085           "p-fact-order" p-fact-order skip
     1086           "v-max-fact-order" v-max-fact-order skip
     1087           view-as alert-box error .
     1088         undo, return error .
     1089       end.
     1090     end.
     1091   end procedure.
     1092   procedure partslib-update-by-factord :
     1093     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     1094     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     1095     define input parameter p-artic              like ub.parts.artic     no-undo .
     1096     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     1097     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     1098     define input parameter p-start-fact-order   as decimal   no-undo .
     1099     define input parameter p-end-fact-order     as decimal   no-undo .
     1100     define input parameter p-lock-gds-obj       as logical   no-undo .
     1101     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     1102     define buffer buf_gds-obj  for ub.gds-obj .
     1103     define buffer buf_doc-line for ub.doc-line .
     1104     define variable v-total-parts-qnty as decimal   no-undo .
     1105     define variable v-goods-gds-goods  as logical   no-undo .
     1106     define variable v-goods-twounit    as logical   no-undo .
     1107     do
     1108     on error undo, return error
     1109     :
     1110       if p-start-fact-order > p-end-fact-order
     1111       then do:
     1112         message
     1113           vss-workfile vss-revision vss-description skip
     1114           vss-include-info10 skip
     1115           "Ошибка задания входных параметров" skip
     1116           "Начало интервала превышает конец интервала" skip
     1117           "Объект" p-obj-type p-obj-code skip
     1118           "Артикул" p-artic p-prod-type p-prod-code skip
     1119           "p-start-fact-order" p-start-fact-order skip
     1120           "p-end-fact-order"   p-end-fact-order skip
     1121           view-as alert-box error .
     1122         undo, return error .
     1123       end.
     1124       if p-lock-gds-obj = true
     1125       then do:
     1126         do transaction
     1127         on error undo, return error
     1128         :
     1129   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1130   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1131     (input  p-obj-type
     1132     ,input  p-obj-code
     1133     ,input  p-artic
     1134     ,input  p-prod-type
     1135     ,input  p-prod-code
     1136     ,buffer buf_gds-obj
     1137     ) no-error .
     1138           if error-status :error
     1139           then do:
     1140             message
     1141               vss-workfile vss-revision vss-description skip
     1142               vss-include-info10 skip
     1143               "Невозможно найти gds-obj" skip
     1144               error-status :get-message(1) skip
     1145               return-value skip
     1146               view-as alert-box error .
     1147             undo, return error .
     1148           end.
     1149           find current buf_gds-obj exclusive-lock .
     1150         end.
     1151       end.
     1152   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1153   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1154     (input  p-artic
     1155     ,input  p-prod-type
     1156     ,input  p-prod-code
     1157     ,input  'gds-goods=request':u
     1158     ,output v-goods-gds-goods
     1159     ) no-error .
     1160       if error-status :error
     1161       then do:
     1162         message
     1163           vss-workfile vss-revision vss-description skip
     1164           vss-include-info10 skip
     1165           "Ошибка при определении атрибута товара" skip
     1166           "Артикул" p-artic p-prod-type p-prod-code skip
     1167           "gds-goods=request" skip
     1168           error-status :get-message(1) skip
     1169           return-value skip
     1170           view-as alert-box error .
     1171         undo, return error return-value .
     1172       end.
     1173   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1174   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1175     (input  p-artic
     1176     ,input  p-prod-type
     1177     ,input  p-prod-code
     1178     ,input  'twounit=request':u
     1179     ,output v-goods-twounit
     1180     ) no-error .
     1181       if error-status :error
     1182       then do:
     1183         message
     1184           vss-workfile vss-revision vss-description skip
     1185           vss-include-info10 skip
     1186           "Ошибка при определении атрибута товара" skip
     1187           "Артикул" p-artic p-prod-type p-prod-code skip
     1188           "twounit=request" skip
     1189           error-status :get-message(1) skip
     1190           return-value skip
     1191           view-as alert-box error .
     1192         undo, return error return-value .
     1193       end.
     1194       for each buf_doc-line no-lock
     1195         where buf_doc-line.obj-type   = p-obj-type
     1196           and buf_doc-line.obj-code   = p-obj-code
     1197           and buf_doc-line.artic      = p-artic
     1198           and buf_doc-line.prod-type  = p-prod-type
     1199           and buf_doc-line.prod-code  = p-prod-code
     1200           and buf_doc-line.status_    = 'факт':U
     1201           and buf_doc-line.fact-order > p-start-fact-order
     1202           and buf_doc-line.fact-order <= p-end-fact-order
     1203       on error undo, return error
     1204       :
     1205         run partslib-process-document in this-procedure
     1206           (input  buf_doc-line.doc-code
     1207           ,input  p-obj-type
     1208           ,input  p-obj-code
     1209           ,input  p-artic
     1210           ,input  p-prod-type
     1211           ,input  p-prod-code
     1212           ,input  v-goods-gds-goods
     1213           ,input  v-goods-twounit
     1214           ,output v-total-parts-qnty
     1215           ) no-error .
     1216         if error-status :error
     1217         then do:
     1218           message
     1219             vss-workfile vss-revision vss-description skip
     1220             vss-include-info10 skip
     1221             "Ошибка при вызове процедуры partslib-process-document" skip
     1222             "Документ" buf_doc-line.doc-code skip
     1223             "Объект" p-obj-type p-obj-code skip
     1224             "Артикул" p-artic p-prod-type p-prod-code skip
     1225             "p-start-fact-order" p-start-fact-order skip
     1226             "p-end-fact-order" p-end-fact-order skip
     1227             error-status :get-message(1) skip
     1228             return-value skip
     1229             view-as alert-box error .
     1230           undo, return error return-value .
     1231         end.
     1232       end.
     1233     end.
     1234   end procedure.
     1235   procedure partslib-process-document :
     1236     define input  parameter p-doc-code         as character no-undo .
     1237     define input  parameter p-obj-type         as character no-undo .
     1238     define input  parameter p-obj-code         as integer   no-undo .
     1239     define input  parameter p-artic            as character no-undo .
     1240     define input  parameter p-prod-type        as character no-undo .
     1241     define input  parameter p-prod-code        as integer   no-undo .
     1242     define input  parameter p-goods-gds-goods  as logical   no-undo .
     1243     define input  parameter p-goods-twounit    as logical   no-undo .
     1244     define output parameter p-total-parts-qnty as decimal   no-undo .
     1245     define variable v-parts-sign as integer   no-undo .
     1246     define buffer buf_trn-doc    for ub.trn-doc .
     1247     define buffer buf_doc-line   for ub.doc-line .
     1248     define buffer buf_parts      for ub.parts .
     1249     define buffer buf_temp-parts for temp-parts .
     1250     do
     1251     on error undo, return error return-value
     1252     :
     1253       find first buf_trn-doc no-lock
     1254         where buf_trn-doc.doc-code = p-doc-code
     1255         no-error .
     1256       if not available buf_trn-doc
     1257       then do:
     1258         undo, return error substitute("Ошибка при поиске документа. Документ &1"
     1259                                      ,p-doc-code
     1260                                      ) .
     1261       end.
     1262       case buf_trn-doc.doc-type
     1263       :
     1264         when 'при':U or
     1265         when 'возврат':U or
     1266         when 'инв':U
     1267         then do:
     1268           assign
     1269             v-parts-sign = -1
     1270           .
     1271         end.
     1272         when 'рас':U or
     1273         when 'спи':U
     1274         then do:
     1275           assign
     1276             v-parts-sign = 1
     1277           .
     1278         end.
     1279         otherwise do:
     1280           undo, return error substitute("Неизвестный тип документа &1"
     1281                                       ,buf_trn-doc.doc-type
     1282                                       ) .
     1283         end.
     1284       end.
     1285       find first buf_doc-line no-lock
     1286         where buf_doc-line.doc-code  = p-doc-code
     1287           and buf_doc-line.artic     = p-artic
     1288           and buf_doc-line.prod-type = p-prod-type
     1289           and buf_doc-line.prod-code = p-prod-code
     1290         no-error .
     1291       if not available buf_doc-line
     1292       then do:
     1293         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
     1294                                      ,p-doc-code
     1295                                      ,artic
     1296                                      ,prod-type
     1297                                      ,prod-code
     1298                                      ) .
     1299       end.
     1300       assign
     1301         p-total-parts-qnty = 0
     1302       .
     1303       if p-goods-gds-goods = true
     1304       then do:
     1305         for each buf_parts no-lock
     1306           where buf_parts.out-code  = p-doc-code
     1307             and buf_parts.obj-type  = p-obj-type
     1308             and buf_parts.obj-code  = p-obj-code
     1309             and buf_parts.artic     = p-artic
     1310             and buf_parts.prod-type = p-prod-type
     1311             and buf_parts.prod-code = p-prod-code
     1312         on error undo, return error
     1313         :
     1314           run partslib-create-temp-parts in this-procedure
     1315             (buffer buf_parts
     1316             ,buffer buf_temp-parts
     1317             ,input  p-goods-twounit
     1318             ) .
     1319           assign
     1320             p-total-parts-qnty        = p-total-parts-qnty
     1321                                       + v-parts-sign * buf_parts.fact-qnty
     1322             buf_temp-parts.qnty       = buf_temp-parts.qnty
     1323                                       + v-parts-sign * buf_parts.fact-qnty
     1324             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
     1325                                       + v-parts-sign * buf_parts.fact-qnty
     1326             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
     1327                                       + v-parts-sign * buf_parts.cli-qnty
     1328           .
     1329           if buf_temp-parts.qnty = 0
     1330           then do:
     1331             delete buf_temp-parts .
     1332           end.
     1333         end.
     1334       end.
     1335       else do:
     1336         assign
     1337           p-total-parts-qnty = p-total-parts-qnty
     1338                              + v-parts-sign * buf_doc-line.fact-qnty
     1339         .
     1340       end.
     1341     end.
     1342   end procedure.
     1343   procedure partslib-init-temp-parts-by-date :
     1344     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     1345     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     1346     define input parameter p-artic           like ub.parts.artic     no-undo .
     1347     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     1348     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     1349     define input parameter p-fact-date       as date      no-undo .
     1350     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
     1351     do
     1352     on error undo, return error
     1353     :
     1354       define variable v-fact-order                as decimal   no-undo .
     1355       define variable v-shift-end-fact-order      as decimal   no-undo .
     1356       define variable v-day-end-fact-order        as decimal   no-undo .
     1357       run factord in this-procedure
     1358         (input  p-fact-date
     1359         ,input  1
     1360         ,input  1
     1361         ,input  ?
     1362         ,input  0
     1363         ,input  false
     1364         ,output v-fact-order
     1365         ,output v-shift-end-fact-order
     1366         ,output v-day-end-fact-order
     1367         ) no-error .
     1368       if error-status :error
     1369       then do:
     1370         message
     1371           vss-workfile vss-revision vss-description skip
     1372           vss-include-info10 skip
     1373           "Ошибка при определении момента времени, на который требуется остаток" skip
     1374           "Объект" p-obj-type p-obj-code skip
     1375           "Артикул" p-artic p-prod-type p-prod-code skip
     1376           "Дата" p-fact-date skip
     1377           view-as alert-box error .
     1378         undo, return error .
     1379       end.
     1380       run partslib-init-temp-parts-by-factord in this-procedure
     1381         (input p-obj-type
     1382         ,input p-obj-code
     1383         ,input p-artic
     1384         ,input p-prod-type
     1385         ,input p-prod-code
     1386         ,input v-day-end-fact-order
     1387         ,input false
     1388         ) no-error .
     1389       if error-status :error
     1390       then do:
     1391         message
     1392           vss-workfile vss-revision vss-description skip
     1393           vss-include-info10 skip
     1394           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
     1395           "Объект" p-obj-type p-obj-code skip
     1396           "Артикул" p-artic p-prod-type p-prod-code skip
     1397           "Дата" p-fact-date skip
     1398           view-as alert-box error .
     1399         undo, return error .
     1400       end.
     1401     end.
     1402   end procedure.
     1403   procedure partslib-calc-cost :
     1404     define output parameter p-fact-qnty      as decimal   no-undo .
     1405     define output parameter p-vat-pc         as decimal   no-undo .
     1406     define output parameter p-slt-pc         as decimal   no-undo .
     1407     define output parameter p-sum-base       as decimal   no-undo .
     1408     define output parameter p-sum-rubl       as decimal   no-undo .
     1409     define output parameter p-vat-base       as decimal   no-undo .
     1410     define output parameter p-vat-rubl       as decimal   no-undo .
     1411     define output parameter p-slt-base       as decimal   no-undo .
     1412     define output parameter p-slt-rubl       as decimal   no-undo .
     1413     define output parameter p-road-tax-base  as decimal   no-undo .
     1414     define output parameter p-road-tax-rubl  as decimal   no-undo .
     1415     define output parameter p-transport-base as decimal   no-undo .
     1416     define output parameter p-transport-rubl as decimal   no-undo .
     1417     define output parameter p-other-base     as decimal   no-undo .
     1418     define output parameter p-other-rubl     as decimal   no-undo .
     1419     define output parameter p-excise-base    as decimal   no-undo .
     1420     define output parameter p-excise-rubl    as decimal   no-undo .
     1421     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     1422     do
     1423     on error undo, return error return-value
     1424     :
     1425       define buffer buf_temp-parts for temp-parts .
     1426       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     1427       define buffer   in-vatp-parts    for ub.parts   .
     1428       define buffer   in-vatp-doc      for ub.trn-doc .
     1429       define buffer   in-vatp-goods    for ub.goods   .
     1430       define buffer   in-vatp-sysconf  for ub.sysconf .
     1431       define buffer   in-vatp_doc-attr for ub.doc-attr.
     1432       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     1433       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     1434       define variable varinvprb                  as   character              no-undo.
     1435       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     1436       define variable cli-base-rate              as   decimal                no-undo.
     1437       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     1438       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     1439       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     1440       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     1441       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     1442       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     1443       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     1444       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1445       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     1446       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     1447       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1448       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     1449       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     1450       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     1451       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     1452       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     1453       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     1454       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     1455       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     1456       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     1457       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     1458       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     1459       define variable varinvatp-envd             as   character              no-undo.
     1460       define variable varinvatp-type             as   character              no-undo.
     1461       for each buf_temp-parts
     1462       on error undo, return error
     1463       :
     1464   assign
     1465     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     1466     price-base-with-tax-loc = buf_temp-parts.price-base
