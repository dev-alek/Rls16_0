      810   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      811   function breakstr returns character ( input        for-name    as character,
      812                                         input        line-length as integer,
      813                                         input-output line1       as character,
      814                                         input-output line2       as character ) :
      815     define variable ii as integer no-undo.
      816     if length( for-name ) > line-length then do:
      817       assign ii    = 1
      818              line1 = "":u
      819              line2 = "":u.
      820       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
      821         assign line1 =       substring( for-name, 1, line-length     )
      822                line2 = trim( substring( for-name,    line-length + 1 ) ).
      823       end.                                                     else do:
      824         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
      825           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
      826                  ii    = ii    + 1.
      827           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
      828             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
      829           end.
      830         end.
      831         assign line2 = trim( substring( for-name, length( line1 ) ) ).
      832       end.
      833     end.                                else do:
      834       assign line1 = for-name
      835              line2 = "":u.
      836     end.
      837     return ( line1 ).
      838   end function.
      839       def var t-addres        like ub.firm.addres1   no-undo.
      840       def var t-phone         like ub.firm.phone     no-undo.
      841       def var t-inn           like ub.firm.inn       no-undo.
      842       def var t-okpo          like ub.firm.okpo      no-undo.
      843       def var t-temp-address  like ub.firm.addres1   no-undo.
      844   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      845   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
      846   procedure partslib-clear-temp-parts :
      847     define buffer buf_temp-parts for temp-parts .
      848     do
      849     on error undo, return error
      850     :
      851       for each buf_temp-parts
      852       on error undo, return error
      853       :
      854         delete buf_temp-parts .
      855       end.
      856     end.
      857   end procedure.
      858   procedure partslib-create-temp-parts :
      859     define parameter buffer buf_parts       for ub.parts .
      860     define parameter buffer buf_temp-parts  for temp-parts .
      861     define input  parameter p-goods-twounit as logical   no-undo .
      862     define variable v-base-part-code as character no-undo .
      863     do
      864     on error undo, return error
      865     :
      866       if p-goods-twounit = true
      867       then do:
      868         assign
      869           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
      870         .
      871       end.
      872       else do:
      873         assign
      874           v-base-part-code = buf_parts.part-code
      875         .
      876       end.
      877       find first buf_temp-parts exclusive-lock
      878         where buf_temp-parts.obj-type  = buf_parts.obj-type
      879           and buf_temp-parts.obj-code  = buf_parts.obj-code
      880           and buf_temp-parts.artic     = buf_parts.artic
      881           and buf_temp-parts.prod-type = buf_parts.prod-type
      882           and buf_temp-parts.prod-code = buf_parts.prod-code
      883           and buf_temp-parts.in-code   = buf_parts.in-code
      884           and buf_temp-parts.out-code  = 'free-zone':U
      885           and buf_temp-parts.part-code = v-base-part-code
      886         no-error.
      887       if not available buf_temp-parts
      888       then do:
      889         create buf_temp-parts .
      890         buffer-copy buf_parts to buf_temp-parts
      891         assign
      892           buf_temp-parts.out-code  = 'free-zone':U
      893           buf_temp-parts.part-code = v-base-part-code
      894           buf_temp-parts.rsrv-free = yes
      895           buf_temp-parts.status_   = no
      896           buf_temp-parts.qnty      = 0
      897           buf_temp-parts.fact-qnty = 0
      898           buf_temp-parts.real-qnty = 0
      899           buf_temp-parts.cli-qnty  = 0
      900         .
      901       end.
      902     end.
      903   end procedure.
      904   procedure partslib-init-temp-parts :
      905     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      906     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      907     define input parameter p-artic           like ub.parts.artic     no-undo .
      908     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      909     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      910     define buffer buf_parts      for ub.parts .
      911     define buffer buf_temp-parts for temp-parts .
      912     define variable v-goods-twounit    as logical   no-undo .
      913     do
      914     on error undo, return error
      915     :
      916   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      917   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      918     (input  p-artic
      919     ,input  p-prod-type
      920     ,input  p-prod-code
      921     ,input  'twounit=request':u
      922     ,output v-goods-twounit
      923     ) no-error .
      924       if error-status :error
      925       then do:
      926         message
      927           vss-workfile vss-revision vss-description skip
      928           vss-include-info10 skip
      929           "Ошибка при определении атрибута товара" skip
      930           "Артикул" p-artic p-prod-type p-prod-code skip
      931           "twounit=request" skip
      932           error-status :get-message(1) skip
      933           return-value skip
      934           view-as alert-box error .
      935         undo, return error return-value .
      936       end.
      937       run partslib-clear-temp-parts in this-procedure .
      938       for each buf_parts
      939         where buf_parts.obj-type  = p-obj-type
      940           and buf_parts.obj-code  = p-obj-code
      941           and buf_parts.artic     = p-artic
      942           and buf_parts.prod-type = p-prod-type
      943           and buf_parts.prod-code = p-prod-code
      944           and buf_parts.rsrv-free = yes
      945           and buf_parts.status_   = no
      946           and buf_parts.in-code   <> buf_parts.out-code
      947       on error undo, return error
      948       :
      949         run partslib-create-temp-parts in this-procedure
      950           (buffer buf_parts
      951           ,buffer buf_temp-parts
      952           ,input  v-goods-twounit
      953           ) .
      954         define variable v-parts-qnty          as decimal   no-undo .
      955         define variable v-parts-cli-qnty      as decimal   no-undo .
      956         define variable v-parts-free-qnty     as decimal   no-undo .
      957         define variable v-parts-free-cli-qnty as decimal   no-undo .
      958         if buf_parts.out-code = 'free-zone':U
      959         then do:
      960           assign
      961             v-parts-qnty          = buf_parts.qnty
      962             v-parts-cli-qnty      = buf_parts.cli-qnty
      963             v-parts-free-qnty     = buf_parts.qnty
      964             v-parts-free-cli-qnty = buf_parts.cli-qnty
      965           .
      966         end.
      967         else do:
      968           assign
      969             v-parts-qnty          = abs(buf_parts.qnty)
      970             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
      971             v-parts-free-qnty     = 0
      972             v-parts-free-cli-qnty = 0
      973           .
      974         end.
      975         assign
      976           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
      977           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
      978           buf_temp-parts.real-qnty     = 0
      979           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
      980           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
      981           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
      982         .
      983       end.
      984     end.
      985   end procedure.
      986   procedure partslib-init-temp-parts-by-factord :
      987     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      988     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      989     define input parameter p-artic              like ub.parts.artic     no-undo .
      990     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      991     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      992     define input parameter p-fact-order         as decimal   no-undo .
      993     define input parameter p-include-fact-order as logical   no-undo .
      994     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      995     define buffer buf_gds-obj  for ub.gds-obj .
      996     do
      997     on error undo, return error
      998     :
      999       do transaction
     1000       on error undo, return error
     1001       :
     1002   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1003   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1004     (input  p-obj-type
