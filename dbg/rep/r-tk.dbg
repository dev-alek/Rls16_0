     5744   procedure nutro_get-nutrition-info :
     5745     define input  parameter p-artic         as character no-undo .
     5746     define input  parameter p-prod-type     as character no-undo .
     5747     define input  parameter p-prod-code     as integer   no-undo .
     5748     define input  parameter p-obj-type      as character no-undo .
     5749     define input  parameter p-obj-code      as integer   no-undo .
     5750     define output parameter p-calories      as decimal   no-undo .
     5751     define output parameter p-protein       as decimal   no-undo .
     5752     define output parameter p-carbohydrate  as decimal   no-undo .
     5753     define output parameter p-fat           as decimal   no-undo .
     5754     define buffer buf_goods    for ub.goods .
     5755     define variable v-attr-value    as character no-undo .
     5756     define variable v-attr-type     as character no-undo .
     5757     define variable v-attr-code     as character no-undo .
     5758     define variable v-exist         as logical   no-undo .
     5759     define variable v-is-global     as logical   no-undo .
     5760     define variable v-nutro-value   as decimal   no-undo .
     5761     define buffer buf_fbr-gds-obj  for ub.fbr-gds-obj.
     5762     define buffer buf_recipe       for ub.recipe.
     5763   do
     5764   on error undo, return error return-value
     5765   :
     5766     assign
     5767       p-carbohydrate  = ?
     5768       p-fat           = ?
     5769       p-protein       = ?
     5770       p-calories      = ?
     5771     .
     5772     find first buf_goods no-lock
     5773       where buf_goods.artic     = p-artic
     5774         and buf_goods.prod-type = p-prod-type
     5775         and buf_goods.prod-code = p-prod-code
     5776     no-error .
     5777     if not available buf_goods
     5778     then do:
     5779       return .
     5780     end.
     5781     assign
     5782       v-is-global = yes
     5783     .
     5784     find first buf_fbr-gds-obj no-lock
     5785       where buf_fbr-gds-obj.obj-type = p-obj-type
     5786         and buf_fbr-gds-obj.obj-code = p-obj-code
     5787         and buf_fbr-gds-obj.gds-code = buf_goods.gds-code
     5788     no-error .
     5789     if available buf_fbr-gds-obj
     5790     then do:
     5791       if  buf_fbr-gds-obj.is-semi-finished or
     5792           buf_fbr-gds-obj.is-menu
     5793       then do:
     5794         assign
     5795           v-is-global = no
     5796         .
     5797         find first buf_recipe no-lock
     5798           where buf_recipe.recipe-code = buf_fbr-gds-obj.default-recipe-code
     5799         no-error .
     5800         if available buf_recipe
     5801         then do:
     5802           assign
     5803             v-is-global = ( buf_recipe.host-code = 0    ) and
     5804                           ( buf_recipe.obj-type  = "":U ) and
     5805                           ( buf_recipe.obj-code  = 0    )
     5806           .
     5807         end.
     5808       end.
     5809     end.
     5810     if v-is-global = yes
     5811     then do:
     5812       assign
     5813         v-attr-code = 'calories':U
     5814       .
