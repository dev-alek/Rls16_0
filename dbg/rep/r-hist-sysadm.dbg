      595   define new global shared variable g#library  as handle no-undo .
      596   define new global shared variable g#library2 as handle no-undo .
      597   define variable var-report-r-b as character no-undo .
      598   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      599   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      600     (output var-report-r-b
      601     )  .
      602   def var vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      603   procedure gen-key-rec :
      604     define input  parameter p-tbl-name    as character no-undo.
      605     define input  parameter p-bh_tbl-name as handle    no-undo.
      606     define output parameter p-key-rec     as character no-undo.
      607     do
      608     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      609     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      610     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      611     :
      612       define variable fh               as handle    no-undo .
      613       define variable v-ok             as logical   no-undo .
      614       define variable v-inform         as character no-undo .
      615       define variable v-ind            as integer   no-undo .
      616       define variable v-idx-field-qnty as integer   no-undo .
      617       if p-tbl-name = ?
      618         or p-tbl-name = "":U
      619       then do:
      620         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info7 ).
      621       end.
      622       if not p-bh_tbl-name:available then do:
      623         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info7, p-tbl-name ).
      624       end.
      625       assign
      626         p-key-rec = p-tbl-name
      627         v-inform  = p-bh_tbl-name:index-information(1)
      628         v-ind     = 2
      629       .
      630       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      631       on error undo, return error
      632       :
      633         assign
      634           v-inform = p-bh_tbl-name:index-information( v-ind )
      635           v-ind    = v-ind + 1
      636         .
      637       end.
      638       if v-inform = ?
      639         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      640         or entry( 3, v-inform, ",":U ) <> "1":U
      641       then do:
      642         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info7, p-tbl-name ).
      643       end.
      644       else do:
      645         assign
      646           v-idx-field-qnty = num-entries( v-inform ) - 4
      647         .
      648         if v-idx-field-qnty < 2 then do:
      649           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, p-tbl-name ).
      650         end.
      651         do v-ind = 1 to v-idx-field-qnty by 2
      652         on error undo, return error
      653         :
      654           assign
      655             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      656             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      657           .
      658         end.
      659       end.
      660       if p-key-rec = ? then do:
      661         assign
      662           p-key-rec = "":U
      663         .
      664         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info7, p-tbl-name ).
      665       end.
      666     end.
      667     return.
      668   end procedure.
      669   procedure gen-where-keyr-tab :
      670     define input  parameter i-tableSerach as character no-undo.
      671     define input  parameter i-tablekey   as character  no-undo.
      672     define input  parameter p-key-rec    as character  no-undo.
      673     define input  parameter p-key-handle as handle     no-undo .
      674     define input  parameter p-db-name    as character  no-undo .
      675     define input  parameter p-tt-handle  as handle     no-undo .
      676     define output parameter o-Where      as character  no-undo.
      677     do
      678     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      679     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      680     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      681     :
      682       define variable v-full-tbl-name  as character no-undo .
      683       define variable bh_tbl-name      as handle    no-undo .
      684       define variable fh_key           as handle    no-undo .
      685       define variable fh_search        as handle    no-undo .
      686       define variable v-field-num      as integer   no-undo .
      687       define variable v-count-fld      as integer   no-undo .
      688       define variable v-inform         as character no-undo .
      689       define variable v-ind            as integer   no-undo .
      690       define variable v-idx-field-qnty as integer   no-undo .
      691       define variable v-field-name     as character no-undo .
      692       define variable v-field-val      as character no-undo .
      693       define variable v-word-link      as character no-undo .
      694       define variable vTable           as character no-undo.
      695       define variable bh_tbl-key       as handle    no-undo .
      696       assign
      697         p-key-rec = trim( p-key-rec )
      698       .
      699       if p-key-handle <> ? then do:
      700         if not valid-handle(p-key-handle)
      701            or p-key-handle:type <> "buffer"
      702         then do:
      703           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info7 ).
      704         end.
      705         if num-entries( p-key-rec, chr(3) ) > 1
      706           or p-key-rec = ?
      707           or p-key-rec = "":U
      708         then do:
      709           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info7, p-key-rec ).
      710         end.
      711       end.
      712       else do:
      713         if p-key-rec = ?
      714           or p-key-rec = "":U
      715         then do:
      716           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info7 ).
      717         end.
      718       end.
      719       assign
      720         vTable = entry( 1 , p-key-rec, chr(3) )
      721       .
      722       if p-tt-handle <> ?
      723         and ( not valid-handle(p-tt-handle)
      724               or p-tt-handle:type <> "buffer"
      725             )
      726       then do:
      727         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info7, vTable, chr(10) ).
      728       end.
      729       if p-tt-handle = ? then do:
      730         assign
      731           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      732         .
      733         create buffer bh_tbl-name for table v-full-tbl-name .
      734       end.
      735       else do:
      736         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      737       end.
      738       assign
      739         v-inform = bh_tbl-name:index-information(1)
      740         v-ind    = 2
      741       .
      742       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      743       on error undo, return error
      744       :
      745         assign
      746           v-inform = bh_tbl-name:index-information( v-ind )
      747           v-ind    = v-ind + 1
      748         .
      749       end.
      750       if v-inform = ?
      751         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      752         or entry( 3, v-inform, ",":U ) <> "1":U
      753       then do:
      754         delete object bh_tbl-name no-error.
      755         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info7, vTable ).
      756       end.
      757       assign
      758         v-idx-field-qnty = num-entries( v-inform ) - 4
      759       .
      760       if v-idx-field-qnty < 2 then do:
      761         delete object bh_tbl-name no-error.
      762         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, vTable ).
      763       end.
      764       assign
      765         o-where     = "where":U
      766         v-word-link = "":U
      767         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      768         v-count-fld = 0
      769       .
      770       if i-tablekey ne "" and i-tablekey ne ?
      771       then do:
      772         assign
      773           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      774         .
      775         create buffer bh_tbl-key for table v-full-tbl-name .
      776       end.
      777       if i-tableSerach ne "" and i-tableSerach ne ?
      778       then do:
      779         delete object bh_tbl-name no-error.
      780         assign
      781           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      782         .
      783         create buffer bh_tbl-name for table v-full-tbl-name .
      784       end.
      785       block_where:
      786       do v-ind = 1 to v-idx-field-qnty by 2
      787       on error undo, return error
      788       :
      789         assign
      790           v-count-fld = v-count-fld + 1
      791         .
      792         if p-key-handle = ?
      793           and v-count-fld > v-field-num
      794         then do:
      795           leave block_where.
      796         end.
      797         define variable VfieldKeyTable as handle no-undo.
      798         assign
      799           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      800           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      801         .
      802         if     bh_tbl-key ne ?
      803         then do:
      804            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      805            if VfieldKeyTable eq ?
      806            then next block_where.
      807         end.
      808         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      809         then
      810            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      811         else
      812            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      813         if p-key-handle = ? then do:
      814           assign
      815             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      816           .
      817         end.
      818         else do:
      819           assign
      820             fh_key = p-key-handle:buffer-field( v-field-name )
      821           .
      822           if fh_key = ?
      823             or not valid-handle( fh_key )
      824           then do:
      825             delete object bh_tbl-name.
      826             if     bh_tbl-key ne ?
      827             then
      828                delete object bh_tbl-key.
      829             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info7, p-key-handle:name, v-field-name ).
      830           end.
      831           assign
      832             v-field-val = fh_key:buffer-value
      833           .
      834         end.
      835         if fh_search:data-type ="character":U then do:
      836           assign
      837             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      838             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      839             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      840             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      841             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      842             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      843             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      844             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      845             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      846             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      847             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      848             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      849             v-field-val = substitute( '"&1"', v-field-val )
      850           .
      851         end.
      852         assign
      853           o-where = substitute( "&1 &2", o-where, v-field-val )
      854         .
      855         if v-word-link = "":U then do:
      856           assign
      857             v-word-link = "and":U
      858           .
      859         end.
      860       end.
      861       delete object bh_tbl-name.
      862       if     bh_tbl-key ne ?
      863       then
      864          delete object bh_tbl-key.
      865       if p-key-handle = ?
      866         and v-count-fld <> v-field-num
      867       then do:
      868         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info7, vTable ).
      869       end.
      870     end.
      871   end procedure.
      872   procedure gen-hn-keyr-tab :
      873     define input  parameter i-tableSerach as character no-undo.
      874     define input  parameter i-tablekey   as character no-undo.
      875     define input  parameter p-key-rec    as character no-undo.
      876     define input  parameter p-key-handle as handle    no-undo .
      877     define input  parameter p-db-name    as character no-undo .
      878     define input  parameter p-tt-handle  as handle    no-undo .
      879     define input  parameter p-stts-lock  as integer   no-undo .
      880     define output parameter o-hn         as handle    no-undo.
      881     define variable v-full-tbl-name as character no-undo.
      882     define variable v-where         as character no-undo.
      883     define variable bh_tbl-name     as handle    no-undo.
      884     define variable vTable          as character no-undo.
      885     do
      886     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      887     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      888     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      889         run gen-where-keyr-tab(i-tableSerach,
      890                                i-tablekey,
      891                                p-key-rec,
      892                                p-key-handle,
      893                                p-db-name,
      894                                p-tt-handle,
      895                                output v-where).
      896         if i-tableSerach ne "" and i-tableSerach ne ?
      897         then do:
      898            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      899            create buffer bh_tbl-name for table v-full-tbl-name .
      900         end.
      901         else do:
      902            if p-tt-handle = ? then do:
      903               assign
      904                  vTable = entry( 1 , p-key-rec, chr(3) )
      905               .
      906               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      907               create buffer bh_tbl-name for table v-full-tbl-name .
      908            end.
      909            else do:
      910               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      911            end.
      912         end.
      913         if p-tt-handle = ? then do:
      914            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      915         end.
      916         else do:
      917            bh_tbl-name:find-first( v-where ) no-error .
      918         end.
      919         o-hn = bh_tbl-name.
      920      end.
      921   end procedure.
      922   procedure gen-hn-keyr :
      923     define input  parameter p-key-rec    as character no-undo.
      924     define input  parameter p-key-handle as handle    no-undo .
      925     define input  parameter p-db-name    as character no-undo .
      926     define input  parameter p-tt-handle  as handle    no-undo .
      927     define input  parameter p-stts-lock  as integer   no-undo .
      928     define output parameter o-hn         as handle    no-undo.
      929     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      930   end.
      931   procedure gen-row-keyr :
      932     define input  parameter p-key-rec    as character no-undo.
      933     define input  parameter p-key-handle as handle    no-undo .
      934     define input  parameter p-db-name    as character no-undo .
      935     define input  parameter p-tt-handle  as handle    no-undo .
      936     define input  parameter p-stts-lock  as integer   no-undo .
      937     define output parameter p-tbl-row    as rowid     no-undo.
      938     define output parameter p-tbl-name   as character no-undo.
      939     define variable vHn as handle no-undo.
      940       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      941       p-tbl-row = if vHn:available then vHn:rowid else ?.
      942       p-tbl-name =  vHn:table.
      943       delete object vHn no-error.
      944     if p-tbl-row = ? then do:
      945       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info7, p-tbl-name, p-key-rec ).
      946     end.
      947     else do:
      948       return.
      949     end.
      950   end procedure.
      951   procedure gen-key-fv :
      952     define input  parameter p-key-rec    as character no-undo .
      953     define output parameter p-field-list as character no-undo .
      954     define output parameter p-value-list as character no-undo.
      955     do
      956     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      957     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      958     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      959     :
      960       define variable v-full-tbl-name  as character no-undo .
      961       define variable bh_tbl-name      as handle    no-undo .
      962       define variable v-tbl-name       as character no-undo .
      963       define variable v-field-num      as integer   no-undo .
      964       define variable v-count-fld      as integer   no-undo .
      965       define variable v-inform         as character no-undo .
      966       define variable v-ind            as integer   no-undo .
      967       define variable v-idx-field-qnty as integer   no-undo .
      968       define variable v-delim-key      as character no-undo .
      969       if p-key-rec = ?
      970         or p-key-rec = "":U
      971       then do:
      972         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info7 ).
      973       end.
      974       assign
      975         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      976         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      977       .
      978       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      979       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info7 ).
      980       assign
      981         v-inform = bh_tbl-name:index-information(1)
      982         v-ind    = 2
      983       .
      984       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      985       on error undo, return error
      986       :
      987         assign
      988           v-inform = bh_tbl-name:index-information( v-ind )
      989           v-ind    = v-ind + 1
      990         .
      991       end.
      992       if v-inform = ?
      993         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      994         or entry( 3, v-inform, ",":U ) <> "1":U
      995       then do:
      996         delete object bh_tbl-name no-error.
      997         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info7, v-tbl-name ).
      998       end.
      999       assign
     1000         v-idx-field-qnty = num-entries( v-inform ) - 4
     1001       .
     1002       if v-idx-field-qnty < 2 then do:
     1003         delete object bh_tbl-name no-error.
     1004         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, v-tbl-name ).
     1005       end.
     1006       assign
     1007         p-field-list = "":U
     1008         p-value-list = "":U
     1009         v-delim-key  = "":U
     1010         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1011         v-count-fld  = 0
     1012       .
     1013       block_where:
     1014       do v-ind = 1 to v-idx-field-qnty by 2
     1015       on error undo, return error
     1016       :
     1017         assign
     1018           v-count-fld = v-count-fld + 1
     1019         .
     1020         if v-count-fld > v-field-num then do:
     1021           leave block_where.
     1022         end.
     1023         assign
     1024           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1025           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1026         .
     1027         if v-ind = 1 then do:
     1028           assign
     1029             v-delim-key = chr(3)
     1030           .
     1031         end.
     1032       end.
     1033       delete object bh_tbl-name.
     1034       if v-count-fld <> v-field-num then do:
     1035         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info7, v-tbl-name ).
     1036       end.
     1037     end.
     1038   end procedure.
     1039   procedure gen-key-field :
     1040     define input  parameter p-table      as character no-undo .
     1041     define output parameter p-field-list as character no-undo .
     1042     do
     1043     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1044     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1045     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1046     :
     1047       define variable v-full-tbl-name  as character no-undo .
     1048       define variable bh_tbl-name      as handle    no-undo .
     1049       define variable v-tbl-name       as character no-undo .
     1050       define variable v-field-num      as integer   no-undo .
     1051       define variable v-count-fld      as integer   no-undo .
     1052       define variable v-inform         as character no-undo .
     1053       define variable v-ind            as integer   no-undo .
     1054       define variable v-idx-field-qnty as integer   no-undo .
     1055       define variable v-delim-key      as character no-undo .
     1056       if p-table = ?
     1057         or p-table = "":U
     1058       then do:
     1059         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info7 ).
     1060       end.
     1061       assign
     1062         v-tbl-name      = p-table
     1063         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1064       .
     1065       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1066       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info7 ).
     1067       assign
     1068         v-inform = bh_tbl-name:index-information(1)
     1069         v-ind    = 2
     1070       .
     1071       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1072       on error undo, return error
     1073       :
     1074         assign
     1075           v-inform = bh_tbl-name:index-information( v-ind )
     1076           v-ind    = v-ind + 1
     1077         .
     1078       end.
     1079       if v-inform = ?
     1080         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1081         or entry( 3, v-inform, ",":U ) <> "1":U
     1082       then do:
     1083         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info7, v-tbl-name ).
     1084       end.
     1085       assign
     1086         v-idx-field-qnty = num-entries( v-inform ) - 4
     1087       .
     1088       if v-idx-field-qnty < 2 then do:
     1089         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, v-tbl-name ).
     1090       end.
     1091       assign
     1092         p-field-list = "":U
     1093         v-delim-key  = "":U
     1094         v-count-fld  = 0
     1095       .
     1096       block_where:
     1097       do v-ind = 1 to v-idx-field-qnty by 2
     1098       on error undo, return error
     1099       :
     1100         assign
     1101           v-count-fld = v-count-fld + 1
     1102         .
     1103         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1104         if v-ind = 1 then do:
     1105           assign
     1106             v-delim-key = chr(3)
     1107           .
     1108         end.
     1109       end.
     1110       delete object bh_tbl-name.
     1111     end.
     1112   end procedure.
     1113   procedure proc-alt-shift-f2:
     1114     if not ibs.th.gbl.gbl-var:rcode
     1115   then
     1116     run gbl\inidebug.p .
     1117   end.
     1118   procedure proc-alt-shift-f3:
     1119     run gbl/prvssinf.p
     1120       ( input this-procedure
     1121       ) .
     1122   end.
     1123   define variable v-inform-launched as logical no-undo initial false .
     1124   procedure proc-alt-shift-f4:
     1125     define variable v-action as character no-undo .
     1126     if v-inform-launched = false then do:
     1127       assign
     1128         v-inform-launched = true
     1129       .
     1130       run gbl/d-inform.w
     1131         (  input self
     1132         ,  input this-procedure
     1133         , output v-action
     1134         ) no-error .
     1135       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     1136       assign
     1137         v-inform-launched = false
     1138       .
     1139     end.
     1140   end.
     1141   procedure proc-alt-f1:
     1142     run gbl/corrhelp.p
     1143       (input this-procedure
     1144       ) .
     1145   end .
     1146   on alt-shift-f2 anywhere do:
     1147     run proc-alt-shift-f2.
     1148   end.
     1149   on alt-shift-f3 anywhere do:
     1150     run proc-alt-shift-f3 in this-procedure .
     1151   end.
     1152   on alt-shift-f4 anywhere do:
     1153     run proc-alt-shift-f4 in this-procedure.
     1154   end.
     1155   on alt-f1 anywhere do:
     1156     run proc-alt-f1 in this-procedure .
     1157   end.
     1158   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1159   define  stream PrnLibStream.
     1160   procedure prn-lib-prn-file :
     1161     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1162     define input parameter p-DIsabledoptions as integer no-undo .
     1163     define variable v-report-name as character no-undo .
     1164     define variable v-user-action as character no-undo .
     1165     define variable v-printed     as logical   no-undo .
     1166     define variable v-exist       as logical   no-undo .
     1167     do
     1168       on error undo, return error
     1169       :
     1170       run prn-lib-get-report-name  in this-procedure (
     1171         input parParentProc
     1172         ,output v-report-name
     1173         ).
     1174   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1175   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1176     (input  v-report-name
     1177     ,input  2
     1178     ,output v-exist
     1179     )  .
     1180       if NOT v-exist then
     1181       DO:
     1182         Message
     1183           "Нет заданий на печать ! "
     1184           view-as alert-box .
     1185         Return  .
     1186       End.
     1187       run gbl/prnfilen.w
     1188         (input  ""
     1189         ,input  p-DisabledOptions
     1190         ,input  string(v-report-name )
     1191         ,input  7
     1192         ,output v-user-action
     1193         ,output v-printed
     1194         ) .
     1195       if v-printed then
     1196       do:
     1197         return "YES" .
     1198       end.
     1199       else
     1200       do:
     1201         return "NO" .
     1202       end.
     1203     end.
     1204   end procedure.
     1205   procedure prn-lib-open-stream :
     1206     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1207     define input parameter p-page-size    as integer no-undo .
     1208     define input parameter p-is-stream    as logical no-undo .
     1209     define input parameter p-append       as logical no-undo .
     1210     define variable v-report-name as character no-undo .
     1211     do
     1212       on error undo, return error
     1213       :
     1214       run prn-lib-get-report-name  in this-procedure (
     1215         input parParentProc
     1216         ,output v-report-name
     1217         ).
     1218       if p-is-stream then
     1219       do:
     1220         if p-append then
     1221         do:
     1222           output stream PrnLibStream to value( v-report-name )
     1223             page-size value(p-page-size) append .
     1224         end.
     1225         if not p-append then
     1226         do:
     1227           output stream PrnLibStream to value( v-report-name )
     1228             page-size value(p-page-size) .
     1229         end.
     1230       end.
     1231       if not p-is-stream then
     1232       do:
     1233         if p-append then
     1234         do:
     1235           output to value( v-report-name )
     1236             page-size value(p-page-size) append .
     1237         end.
     1238         if not p-append then
     1239         do:
     1240           output to value( v-report-name )
     1241             page-size value(p-page-size) .
     1242         end.
     1243       end.
     1244     end.
     1245   end procedure.
     1246   procedure prn-lib-open-exp :
     1247     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1248     define input parameter p-is-stream    as logical no-undo .
     1249     define input parameter p-is-append    as logical no-undo .
     1250     define output parameter p-ReportFileName as char init "report" no-undo.
     1251     define output parameter p-process as logical no-undo .
     1252     define variable glog as logical no-undo .
     1253     do
     1254       on error undo, return error
     1255       :
     1256       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1257         TITLE      "Укажите путь"
     1258         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1259         ASK-OVERWRITE
     1260         CREATE-TEST-FILE
     1261         SAVE-AS
     1262         USE-FILENAME
     1263         DEFAULT-EXTENSION "txt"
     1264         UPDATE glog
     1265         .
     1266       if not glog then  return.
     1267       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1268       if p-is-stream then
     1269       do:
     1270         if p-is-append then
     1271         do:
     1272           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1273         end.
     1274         else
     1275         do:
     1276           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1277         end.
     1278       end.
     1279       else
     1280       do:
     1281         if p-is-append then
     1282         do:
     1283           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1284         end.
     1285         else
     1286         do:
     1287           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1288         end.
     1289       end.
     1290       p-process = yes.
     1291     end.
     1292   end procedure.
     1293   procedure prn-lib-get-report-name :
     1294     define input parameter parParentProc  as widget-handle no-undo.
     1295     define output parameter p-report-name as character no-undo .
     1296     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1297   end procedure.
     1298   procedure prn-lib-reportviewer-report-name :
     1299     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1300     define input parameter p-report-name-html as character no-undo .
     1301     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1302   end procedure.
     1303   procedure prn-lib-reportviewer :
     1304     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1305     define input parameter p-report-name-html as character no-undo .
     1306     define input parameter p-param        as character no-undo .
     1307     define variable v-excel           as character no-undo init 'TRUE' .
     1308     define variable v-value-character as character no-undo .
     1309     define variable v-value-integer   as character no-undo .
     1310     define variable v-value-date      as date      no-undo .
     1311     define variable v-value-decimal   as decimal   no-undo .
     1312     define variable rep-excel         as logical   no-undo .
     1313     define variable excel-string      as character no-undo .
     1314     define variable v-param-type      as character no-undo .
     1315     define variable v-tth             as handle    no-undo .
     1316     run adm/shattri.p (
     1317       input "get":U
     1318       ,input  ""
     1319       ,input  0
     1320       ,input  'report-glob':U
     1321       ,input  'rep-excel':U
     1322       ,output v-value-character
     1323       ,output v-value-date
     1324       ,output v-value-decimal
     1325       ,output v-value-integer
     1326       ,output rep-excel
     1327       ,output v-param-type
     1328       ,INPUT-OUTPUT table-handle v-tth
     1329       )  .
     1330     if rep-excel then v-excel = "TRUE" .
     1331     else v-excel = "FALSE" .
     1332     if p-param eq ""
     1333     then
     1334        p-param = "EXCEL:" + v-excel.
     1335     else
     1336        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1337     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1338   end procedure.
     1339   function fnc-convert-dot-to-colon returns character
     1340       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
     1341   function fnc-convert-dot-to-colon returns character
     1342   (input p-data as decimal, input p-accur as character, input p-num as integer):
     1343       define variable result as character no-undo.
     1344       define variable v-str-result as character no-undo.
     1345       if p-data = ? then p-data = 0 .
     1346       p-data = round(p-data, p-num).
     1347       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     1348       return v-str-result.
     1349   END FUNCTION.
     1350   FUNCTION get-unique-key RETURNS CHARACTER
     1351     ( p-head-table as character,
     1352     p-unique-key-rec as character )  FORWARD.
     1353   define BUFFER bf_c-user-log for ub.c-user-log .
     1354   define variable v-user-table-name as character no-undo .
     1355   define variable v-user-table      as character no-undo .
     1356   define variable v-table           as character no-undo .
     1357   define temp-table tt-usr-hist like ub.c-user-log
     1358     field time_     as character
     1359     field name-bd   as character
     1360     field user-name as character
     1361     field table_    as character
     1362     field info_     as character
     1363     INDEX p1 corr-user-db-num corr-user-name table_.
     1364   define variable v-usrlg-ush-key as integer no-undo.
     1365   define variable v-usrlg-usl-key as integer no-undo.
     1366   define stream out-stream.
     1367   define stream OutStr-html.
     1368   define variable p-report-id             as integer   no-undo .
     1369   define variable v-report-name-html      as CHARACTER no-undo .
     1370   define variable v-report-name-html-list as CHARACTER no-undo .
     1371   run get-report-num in parParentProc (
     1372     output p-report-id
     1373     ).
     1374   v-report-name-html-list = session:temp-directory + "rpt" + string(p-report-id) + "_hist" + ".html".
     1375   for each bf_c-user-log no-lock where bf_c-user-log.corr-date >= Date-Start
     1376     and bf_c-user-log.corr-date <= Date-End by bf_c-user-log.head-table  :
     1377     v-table = bf_c-user-log.head-table .
     1378     if v-table begins "c-" and v-table <> 'c-usr-hist':U and v-table <> 'c-plc-hist':U then
     1379     do:
     1380       v-user-table = replace(v-table,"c-","").
     1381     end.
     1382     else v-user-table = v-table .
     1383   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1384   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run tblnmusr in g#library
     1385     (input  v-user-table
     1386     ,output v-user-table-name
     1387     )  .
     1388     create tt-usr-hist .
     1389     assign
     1390       tt-usr-hist.corr-date        = bf_c-user-log.corr-date
     1391       tt-usr-hist.corr-time        = bf_c-user-log.corr-time
     1392       tt-usr-hist.time_            = string(truncate (bf_c-user-log.corr-time / 3600, 0)) + ":" + string((bf_c-user-log.corr-time modulo 3600) / 60,"99")  + ":" + string((bf_c-user-log.corr-time modulo 3600) / 360,"99")
     1393       tt-usr-hist.corr-user-db-num = bf_c-user-log.corr-user-db-num
     1394       tt-usr-hist.corr-user-name   = bf_c-user-log.corr-user-name
     1395       tt-usr-hist.head-table       = v-user-table-name
     1396       tt-usr-hist.des              = bf_c-user-log.des
     1397       tt-usr-hist.table_           = v-user-table
     1398       tt-usr-hist.uniq-key-rec     = get-unique-key(bf_c-user-log.head-table,bf_c-user-log.uniq-key-rec)
     1399       tt-usr-hist.name-bd = if bf_c-user-log.corr-user-db-num = 0 then "ГБД"
     1400                              else if bf_c-user-log.corr-user-db-num = ? then "Неизвестная БД"
     1401                              else "АЗК " + string (bf_c-user-log.corr-user-db-num).
     1402     for first ub.user-account no-lock where ub.user-account.user-id = bf_c-user-log.corr-user-name :
     1403       tt-usr-hist.user-name = ub.user-account.last-name + " " + ub.user-account.first-name + " " + ub.user-account.second-name .
     1404     end .
     1405     if bf_c-user-log.head-table = 'schedule':U
     1406     then do :
     1407       assign
     1408         tt-usr-hist.des           = "Изменение расписания автоматического задания"
     1409         tt-usr-hist.head-table    = entry(5, bf_c-user-log.head-table-key, chr(6))
     1410         tt-usr-hist.uniq-key-rec  = entry(4, bf_c-user-log.des, ";")
     1411       .
     1412       if entry(5, bf_c-user-log.head-table-key, chr(6)) = 'autofree':U
     1413       then
     1414         tt-usr-hist.head-table = tt-usr-hist.head-table + " - " + entry(6, bf_c-user-log.head-table-key, chr(6))
     1415       .
     1416       if entry(15, bf_c-user-log.head-table-key, chr(6)) = "del"
     1417       then
     1418         tt-usr-hist.des = "Удаление расписания автоматического задания"
     1419       .
     1420   end.
     1421   end.
     1422   do:
     1423     for each tt-usr-hist:
     1424       find first tt-user-account where tt-user-account.user-id_ = tt-usr-hist.corr-user-name no-error.
     1425           if not AVAILABLE tt-user-account then
     1426            do:
     1427               delete tt-usr-hist .
     1428            end.
     1429     end.
     1430   end.
     1431   do:
     1432     for each tt-usr-hist:
     1433     find first tt-objects where tt-objects.table_ = tt-usr-hist.table_ no-error.
     1434           if not AVAILABLE tt-objects  then
     1435           do:
     1436             delete tt-usr-hist .
     1437           end.
     1438     end.
     1439   end.
     1440   run PROC-print-list in this-procedure.
     1441   PROCEDURE proc-print-list :
     1442     define buffer buf_c-user-log for ub.c-user-log .
     1443     do
     1444       on error undo, return error
     1445       :
     1446       output stream OutStr-html to value(v-report-name-html-list) convert target 'UTF-8'.
     1447       put stream OutStr-html unformatted
     1448         "<!DOCTYPE HTML>" skip
     1449         ' <html>' skip
     1450         '  <head>' skip
     1451         '   <meta charset="utf-8">' skip
     1452         '    <style type="text/css">' skip
     1453         '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     1454         '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     1455         '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black; height: 14px;' + chr(125) skip
     1456         '   </style>' skip
     1457         '  </head>' skip
     1458         .
     1459       put stream OutStr-html unformatted
     1460         '<body>' skip
     1461         '<TABLE name="1"  fit_to_page="true" orientation="landscape" CELLSPACING="0" BORDER="0">'skip
     1462         '<thead>' skip
     1463         .
     1464       put stream OutStr-html unformatted
     1465         '<tr>' skip
     1466         '<td style="width: 80px;"></td>' skip
     1467         '<td style="width: 70px;"></td>' skip
     1468         '<td style="width: 40px;"></td>' skip
     1469         '<td style="width: 50px;"></td>' skip
     1470         '<td style="width: 100px;"></td>' skip
     1471         '<td style="width: 50px;"></td>' skip
     1472         '<td style="width: 200px;"></td>' skip
     1473         '<td style="width: 100px;"></td>' skip
     1474         '<td style="width: 200px;"></td>' skip
     1475         '</tr>' skip
     1476         .
     1477       put stream OutStr-html unformatted
     1478         '<tr>' skip
     1479         '<td colspan="9" style="text-align: center;">История действий пользователя за период с ' + string(date-start,"99.99.99") + ' по ' + string(date-end,"99.99.99") + ' </td>' skip
     1480         '</tr>' skip
     1481         '</thead>' skip .
     1482       put stream OutStr-html unformatted
     1483         '<tbody>' skip
     1484         '<TR>' skip
     1485         '<TD text_wrap="true" style="text-align: center;">Дата события</TD>' skip
     1486         '<TD text_wrap="true" style="text-align: center;">Время события</TD>' skip
     1487         '<TD text_wrap="true" style="text-align: center;">БД</TD>' skip
     1488         '<TD text_wrap="true" style="text-align: center;">Наз. БД</TD>' skip
     1489         '<TD text_wrap="true" style="text-align: center;">Пользователь</TD>' skip
     1490         '<TD text_wrap="true" style="text-align: center;">ID польз.</TD>' skip
     1491         '<TD text_wrap="true" style="text-align: center;">Описание</TD>' skip
     1492         '<TD text_wrap="true" style="text-align: center;">Объект</TD>' skip
     1493         '<TD text_wrap="true" style="text-align: center;">Информация</TD>' skip
     1494         '</TR>'skip
     1495         .
     1496       FOR EACH tt-usr-hist NO-LOCK
     1497         by tt-usr-hist.corr-user-db-num
     1498         by tt-usr-hist.corr-date
     1499         by tt-usr-hist.corr-time:
     1500         put stream OutStr-html unformatted
     1501           '<TR>' skip
     1502           '<TD text_wrap="true" style="text-align: center;">' + string(tt-usr-hist.corr-date,"99.99.9999") + '</TD>' skip
     1503           '<TD text_wrap="true" style="text-align: center;">' + tt-usr-hist.time_ + '</TD>' skip
     1504           '<TD text_wrap="true" style="text-align: center;">' + string(tt-usr-hist.corr-user-db-num) + '</TD>' skip
     1505           '<TD text_wrap="true" style="text-align: center;">' + tt-usr-hist.name-bd + '</TD>' skip
     1506           '<TD text_wrap="true" style="text-align: center;">' + tt-usr-hist.user-name + '</TD>' skip
     1507           '<TD text_wrap="true" style="text-align: center;">' + STRING(tt-usr-hist.corr-user-name) + '</TD>' skip
     1508           '<TD text_wrap="true" style="text-align: center;">' + STRING(tt-usr-hist.des) + '</TD>' skip
     1509           '<TD text_wrap="true" style="text-align: center;">' + STRING(tt-usr-hist.head-table) + '</TD>' skip
     1510           '<TD text_wrap="true" style="text-align: center;">' + if tt-usr-hist.uniq-key-rec <> ? then  STRING(tt-usr-hist.uniq-key-rec) + '</TD>' else " " + '</TD>' skip
     1511           '</TR>'skip
     1512           .
     1513       end.
     1514       output stream OutStr-html close.
     1515       run prn-lib-reportviewer-report-name in this-procedure (
     1516         input parParentProc
     1517         ,input v-report-name-html-list
     1518         ).
     1519     end.
     1520   END PROCEDURE.
     1521   FUNCTION get-unique-key RETURNS CHARACTER
     1522     ( p-head-table as character,
     1523     p-unique-key-rec as character ) :
     1524     DEFINE variable v-unique-key-string AS CHARACTER NO-UNDO.
     1525     if p-unique-key-rec begins 'report':U
     1526       or p-unique-key-rec begins 'utl':U
     1527       or p-head-table begins 'run-proc':U
     1528       or p-head-table begins 'run_proc':U
     1529       or p-unique-key-rec begins 'prtdoc:':U
     1530       then return p-unique-key-rec.
     1531     run get-unique-key-proc in this-procedure (
     1532       input p-unique-key-rec
     1533       , output v-unique-key-string
     1534       ).
     1535     RETURN v-unique-key-string.
     1536   END FUNCTION.
     1537   PROCEDURE get-unique-key-proc :
     1538     DEFINE INPUT  PARAMETER p-unique-key-rec    AS CHARACTER   NO-UNDO.
     1539     DEFINE OUTPUT PARAMETER p-unique-key-string AS CHARACTER   NO-UNDO.
     1540     define variable v-field-list       as character no-undo.
     1541     define variable v-field-value-list as character no-undo.
     1542     do
     1543       on error undo, return error
     1544       :
     1545       run gen-key-fv in this-procedure (
     1546         input p-unique-key-rec
     1547         , output v-field-list
     1548         , output v-field-value-list
     1549         ).
     1550       assign
     1551         p-unique-key-string = replace( v-field-value-list, chr(3), ",":U )
     1552         .
     1553     end.
     1554   END PROCEDURE.
