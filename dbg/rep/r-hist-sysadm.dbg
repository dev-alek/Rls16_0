      566     Col-name[231]=   'HW':U
      567     Col-name[232]=   'HX':U
      568     Col-name[233]=   'HY':U
      569     Col-name[234]=   'HZ':U
      570     Col-name[235]=   'IA':U
      571     Col-name[236]=   'IB':U
      572     Col-name[237]=   'IC':U
      573     Col-name[238]=   'ID':U
