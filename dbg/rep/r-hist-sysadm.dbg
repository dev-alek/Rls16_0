      171   procedure create_obj-list :
      172      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      173      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      174      do
      175      on error undo, return error return-value
      176      :
      177         define buffer cli-obj for ub.clients .
      178         define variable p-var as integer no-undo .
      179         define buffer buf_obj-list for obj-list .
      180         find last buf_obj-list  use-index pi no-error .
      181         if available buf_obj-list
      182         then
      183            p-var = buf_obj-list.obj-id + 1.
      184         else
      185            p-var = 1.
      186         find first cli-obj where
      187                   cli-obj.obj-type = p-obj-type
      188               and cli-obj.obj-code = p-obj-code
      189         no-lock no-error.
      190         if available cli-obj
      191         then do:
      192            create buf_obj-list.
      193            assign
      194               buf_obj-list.obj-id   = p-var
      195               buf_obj-list.obj-code = cli-obj.obj-code
      196               buf_obj-list.obj-type = cli-obj.obj-type
      197               buf_obj-list.obj-name = cli-obj.obj-name
      198               buf_obj-list.db-num   = cli-obj.db-num
      199            .
      200         end.
      201      end.
      202   end.
