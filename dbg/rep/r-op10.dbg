     1875     assign
     1876       slt-cli-loccl        = slt-rubl-loccl       / exch-rate-cli-loccl
     1877       vat-cli-loccl        = vat-rubl-loccl       / exch-rate-cli-loccl
     1878       road-tax-cli-loccl   = road-tax-rubl-loccl  / exch-rate-cli-loccl
     1879       transport-cli-loccl  = 0
     1880       other-cli-loccl      = 0
     1881     .
