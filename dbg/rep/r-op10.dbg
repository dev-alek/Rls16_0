     3137         return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3 документ &4", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code, bf_trn-doc.doc-code).
     3138       end.
     3139       v-calcbypart = no.
     3140       if bf_doc-line.whole-send-news = integer('1':U)   then
     3141       v-calcbypart = yes.
     3142       else do:
     3143       for each bf_gds-dtl no-lock
     3144         where bf_gds-dtl.doc-code  = bf_doc-line.doc-code
     3145           and bf_gds-dtl.artic     = bf_doc-line.artic
     3146           and bf_gds-dtl.prod-type = bf_doc-line.prod-type
     3147           and bf_gds-dtl.prod-code = bf_doc-line.prod-code
     3148       on error undo, return error return-value
     3149       :
     3150   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3151     (input  bf_goods.gds-code
     3152     ,input  bf_gds-dtl.prt-code
     3153     ,output varb-code
     3154     ) no-error .
     3155   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3156   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     3157     (input  bf_trn-doc.obj-type
     3158     ,input  bf_trn-doc.obj-code
     3159     ,input  varb-code
     3160     ,input  0
     3161     ,input  bf_trn-doc.fact-order
     3162     ,output vardoc-num
     3163     ,output varprice-sale
     3164     ,output varroad-tax
     3165     ,output varexcise
     3166     )  .
     3167             if varprice-sale = ?
     3168             then do:
     3169               assign
     3170                 varprice-sale = 0
     3171                 varroad-tax   = 0
     3172                 varexcise     = 0
     3173               .
     3174             end.
     3175             assign
     3176               varlastcur-base     = varprice-sale
     3177               varlastcur-road-tax = varroad-tax
     3178               varlastcur-excise   = varexcise
     3179               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     3180               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     3181               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     3182               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     3183             .
     3184         end.
     3185       end.
     3186       if varcur-fact-qnty = 0 then do:
     3187         assign
     3188           varcur-base      = varlastcur-base
     3189           varcur-road-tax  = varlastcur-road-tax
     3190           varcur-excise    = varlastcur-excise
     3191         .
     3192       end.
     3193       else do:
     3194         assign
     3195           varcur-base      = varcur-base      / varcur-fact-qnty
     3196           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     3197           varcur-excise    = varcur-excise    / varcur-fact-qnty
     3198         .
     3199       end.
     3200       if varcur-vat-pc = ?
     3201       then do:
     3202         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     3203       end.
     3204       if varcur-slt-pc = ?
     3205       then do:
     3206         return error substitute ("Нет текущего продажного НП по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     3207       end.
     3208       find first bf_sysconf where bf_sysconf.host-code = bf_trn-doc.host-code no-lock.
     3209       assign
     3210         varcur-cons-vat-pc = bf_sysconf.cons-vat-pc.
     3211       if varcur-cons-vat-pc = ? then do:
     3212         return error substitute ("Нет текущего продажного консигнационного НДС по фирме &1", bf_trn-doc.host-code).
     3213       end.
     3214       define buffer buf_tt-clcparts for tt-clcparts .
     3215       for each buf_tt-clcparts
     3216       on error undo, return error return-value
     3217       :
     3218         delete buf_tt-clcparts.
     3219       end.
     3220       for each bf_parts no-lock
     3221         where bf_parts.out-code  = bf_doc-line.doc-code
     3222           and bf_parts.obj-type  = bf_doc-line.obj-type
     3223           and bf_parts.obj-code  = bf_doc-line.obj-code
     3224           and bf_parts.artic     = bf_doc-line.artic
     3225           and bf_parts.prod-type = bf_doc-line.prod-type
     3226           and bf_parts.prod-code = bf_doc-line.prod-code
     3227       on error undo, return error return-value
     3228       :
     3229         create buf_tt-clcparts .
     3230         buffer-copy bf_parts to buf_tt-clcparts .
     3231         if v-calcbypart = yes   then do:
     3232   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partbcod in g#library
     3233     (buffer bf_parts
     3234     ,output v-b-pcode
     3235     ) no-error .
     3236   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3237   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     3238     (input  bf_parts.obj-type
     3239     ,input  bf_parts.obj-code
     3240     ,input  v-b-pcode
     3241     ,input  0
     3242     ,input  bf_trn-doc.fact-order
     3243     ,output vardoc-num
     3244     ,output varprice-salef
     3245     ,output varroad-tax
     3246     ,output varexcise
     3247     ) no-error .
     3248             if varprice-sale = ?
     3249             then do:
     3250               assign
     3251                 varprice-salef = 0
     3252                 varroad-tax   = 0
     3253                 varexcise     = 0
     3254               .
     3255             end.
     3256             assign
     3257             part-cur-base  = varprice-salef
     3258             part-cur-road-tax  = varroad-tax
     3259             part-cur-excise = varexcise.
     3260         end.
     3261       end.
     3262       run clcprtsl_calc-ttable in this-procedure
     3263         (input yes,
     3264          input yes,
     3265          input bf_doc-line.road-tax,
     3266          input bf_doc-line.excise,
     3267          input bf_doc-line.vat-pc,
     3268          input bf_doc-line.cons-vat-pc,
     3269          input bf_doc-line.slt-pc,
     3270          input bf_trn-doc.base-rate,
     3271          input bf_trn-doc.base-scale,
     3272          input varr-b,
     3273          input varcur-base,
     3274          input varcur-road-tax,
     3275          input varcur-excise,
     3276          input varcur-vat-pc,
     3277          input varcur-cons-vat-pc,
     3278          input varcur-slt-pc
     3279          ) no-error.
     3280       if error-status:error then do:
     3281         message
     3282           vss-workfile vss-revision vss-description skip
     3283           "Ошибка при вызове процедуры clcprtsl_calc-ttable." skip
     3284           return-value skip
     3285           trim(error-status :get-message(1))
     3286           trim(error-status :get-message(2))
     3287           trim(error-status :get-message(3))
     3288           trim(error-status :get-message(4))
     3289           trim(error-status :get-message(5)) skip
     3290           view-as alert-box error.
     3291         undo, return error .
     3292       end.
     3293     end.
     3294   end.
     3295   end.
     3296   procedure clcprtsl_calc-ttable :
     3297   define input parameter paris-doc           as   logical                 no-undo.
     3298   define input parameter paris-cur           as   logical                 no-undo.
     3299   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     3300   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     3301   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     3302   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     3303   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     3304   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     3305   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     3306   define input parameter parr-b              as   character               no-undo.
     3307   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     3308   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     3309   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     3310   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     3311   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     3312   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     3313   define buffer bf_tt-allsum      for tt-allsum.
     3314   define buffer bf_tt-clcparts    for tt-clcparts.
     3315   define buffer bf_tt-allsum-line for tt-allsum-line.
     3316   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     3317   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     3318   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     3319   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     3320   define variable varexcise          like ub.price-list.excise     no-undo.
     3321   do on error undo, return error return-value :
     3322   for each bf_tt-allsum-line
     3323   on error undo, return error return-value
     3324    :
     3325     delete bf_tt-allsum-line.
     3326   end.
     3327   for each bf_tt-allsum
     3328   on error undo, return error return-value
     3329   :
     3330     delete bf_tt-allsum.
     3331   end.
     3332   for each bf_tt-clcparts
     3333   on error undo, return error return-value
     3334   :
     3335   if v-calcbypart then do:
     3336             assign
     3337             parcur-base =   bf_tt-clcparts.part-cur-base
     3338             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     3339             parcur-excise =   bf_tt-clcparts.part-cur-excise
     3340             .
     3341   end.
     3342      run clcprtsl_calc-parts in this-procedure (
     3343        input recid(bf_tt-clcparts),
     3344        input paris-doc,
     3345        input paris-cur,
     3346        input parroad-tax,
     3347        input parexcise,
     3348        input parvat-pc,
     3349        input parcons-vat-pc,
     3350        input parslt-pc,
     3351        input parbase-rate,
     3352        input parbase-scale,
     3353        input parr-b,
     3354        input parcur-base,
     3355        input parcur-road-tax,
     3356        input parcur-excise,
     3357        input parcur-vat-pc,
     3358        input parcurcons-vat-pc,
     3359        input parcurslt-pc
     3360        ) no-error.
     3361     if error-status:error then do:
     3362       message
     3363         vss-workfile vss-revision vss-description skip
     3364         vss-include-info14 skip
     3365         "Ошибка при обсчете партии" skip
     3366         "Документ партии " bf_tt-clcparts.out-code skip
     3367         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     3368         return-value skip
     3369         error-status:get-message(1) skip
     3370         error-status:get-message(2) skip
     3371         error-status:get-message(3) skip
     3372         view-as alert-box error .
     3373       undo, return error .
     3374     end.
     3375     for each bf_tt-allsum on error undo, return error return-value :
     3376       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     3377       if not available bf_tt-allsum-line then do:
     3378         create bf_tt-allsum-line.
     3379         assign
     3380           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     3381       end.
     3382       assign
     3383         bf_tt-allsum-line.fact-qnty              = bf_tt-allsum-line.fact-qnty            + bf_tt-allsum.fact-qnty
     3384         bf_tt-allsum-line.cli-qnty               = bf_tt-allsum-line.cli-qnty             + bf_tt-allsum.cli-qnty
     3385         bf_tt-allsum-line.sum-dsc-base-doc       = bf_tt-allsum-line.sum-dsc-base-doc     + bf_tt-allsum.sum-dsc-base-doc
     3386         bf_tt-allsum-line.sum-dsc-rubl-doc       = bf_tt-allsum-line.sum-dsc-rubl-doc     + bf_tt-allsum.sum-dsc-rubl-doc
     3387         bf_tt-allsum-line.dsc-base-doc           = bf_tt-allsum-line.dsc-base-doc         + bf_tt-allsum.dsc-base-doc
     3388         bf_tt-allsum-line.dsc-rubl-doc           = bf_tt-allsum-line.dsc-rubl-doc         + bf_tt-allsum.dsc-rubl-doc
     3389         bf_tt-allsum-line.vat-base-doc           = bf_tt-allsum-line.vat-base-doc         + bf_tt-allsum.vat-base-doc
     3390         bf_tt-allsum-line.vat-rubl-doc           = bf_tt-allsum-line.vat-rubl-doc         + bf_tt-allsum.vat-rubl-doc
     3391         bf_tt-allsum-line.vat-base-buyer-doc     = bf_tt-allsum-line.vat-base-buyer-doc   + bf_tt-allsum.vat-base-buyer-doc
     3392         bf_tt-allsum-line.vat-rubl-buyer-doc     = bf_tt-allsum-line.vat-rubl-buyer-doc   + bf_tt-allsum.vat-rubl-buyer-doc
     3393         bf_tt-allsum-line.slt-base-doc           = bf_tt-allsum-line.slt-base-doc         + bf_tt-allsum.slt-base-doc
     3394         bf_tt-allsum-line.slt-rubl-doc           = bf_tt-allsum-line.slt-rubl-doc         + bf_tt-allsum.slt-rubl-doc
     3395         bf_tt-allsum-line.road-tax-base-doc      = bf_tt-allsum-line.road-tax-base-doc    + bf_tt-allsum.road-tax-base-doc
     3396         bf_tt-allsum-line.road-tax-rubl-doc      = bf_tt-allsum-line.road-tax-rubl-doc    + bf_tt-allsum.road-tax-rubl-doc
     3397         bf_tt-allsum-line.excise-base-doc        = bf_tt-allsum-line.excise-base-doc      + bf_tt-allsum.excise-base-doc
     3398         bf_tt-allsum-line.excise-rubl-doc        = bf_tt-allsum-line.excise-rubl-doc      + bf_tt-allsum.excise-rubl-doc
     3399         bf_tt-allsum-line.sum-dsc-base-cur       = bf_tt-allsum-line.sum-dsc-base-cur     + bf_tt-allsum.sum-dsc-base-cur
     3400         bf_tt-allsum-line.sum-dsc-rubl-cur       = bf_tt-allsum-line.sum-dsc-rubl-cur     + bf_tt-allsum.sum-dsc-rubl-cur
     3401         bf_tt-allsum-line.dsc-base-cur           = bf_tt-allsum-line.dsc-base-cur         + bf_tt-allsum.dsc-base-cur
     3402         bf_tt-allsum-line.dsc-rubl-cur           = bf_tt-allsum-line.dsc-rubl-cur         + bf_tt-allsum.dsc-rubl-cur
     3403         bf_tt-allsum-line.vat-base-cur           = bf_tt-allsum-line.vat-base-cur         + bf_tt-allsum.vat-base-cur
     3404         bf_tt-allsum-line.vat-rubl-cur           = bf_tt-allsum-line.vat-rubl-cur         + bf_tt-allsum.vat-rubl-cur
     3405         bf_tt-allsum-line.vat-base-buyer-cur     = bf_tt-allsum-line.vat-base-buyer-cur   + bf_tt-allsum.vat-base-buyer-cur
     3406         bf_tt-allsum-line.vat-rubl-buyer-cur     = bf_tt-allsum-line.vat-rubl-buyer-cur   + bf_tt-allsum.vat-rubl-buyer-cur
     3407         bf_tt-allsum-line.slt-base-cur           = bf_tt-allsum-line.slt-base-cur         + bf_tt-allsum.slt-base-cur
     3408         bf_tt-allsum-line.slt-rubl-cur           = bf_tt-allsum-line.slt-rubl-cur         + bf_tt-allsum.slt-rubl-cur
     3409         bf_tt-allsum-line.road-tax-base-cur      = bf_tt-allsum-line.road-tax-base-cur    + bf_tt-allsum.road-tax-base-cur
     3410         bf_tt-allsum-line.road-tax-rubl-cur      = bf_tt-allsum-line.road-tax-rubl-cur    + bf_tt-allsum.road-tax-rubl-cur
     3411         bf_tt-allsum-line.excise-base-cur        = bf_tt-allsum-line.excise-base-cur      + bf_tt-allsum.excise-base-cur
     3412         bf_tt-allsum-line.excise-rubl-cur        = bf_tt-allsum-line.excise-rubl-cur      + bf_tt-allsum.excise-rubl-cur
     3413         bf_tt-allsum-line.sum-dsc-base-acc       = bf_tt-allsum-line.sum-dsc-base-acc     + bf_tt-allsum.sum-dsc-base-acc
     3414         bf_tt-allsum-line.sum-dsc-rubl-acc       = bf_tt-allsum-line.sum-dsc-rubl-acc     + bf_tt-allsum.sum-dsc-rubl-acc
     3415         bf_tt-allsum-line.sum-dsc-cli-acc        = bf_tt-allsum-line.sum-dsc-cli-acc      + bf_tt-allsum.sum-dsc-cli-acc
     3416         bf_tt-allsum-line.dsc-base-acc           = bf_tt-allsum-line.dsc-base-acc         + bf_tt-allsum.dsc-base-acc
     3417         bf_tt-allsum-line.dsc-rubl-acc           = bf_tt-allsum-line.dsc-rubl-acc         + bf_tt-allsum.dsc-rubl-acc
     3418         bf_tt-allsum-line.dsc-cli-acc            = bf_tt-allsum-line.dsc-cli-acc          + bf_tt-allsum.dsc-cli-acc
     3419         bf_tt-allsum-line.vat-base-acc           = bf_tt-allsum-line.vat-base-acc         + bf_tt-allsum.vat-base-acc
     3420         bf_tt-allsum-line.vat-rubl-acc           = bf_tt-allsum-line.vat-rubl-acc         + bf_tt-allsum.vat-rubl-acc
     3421         bf_tt-allsum-line.vat-cli-acc            = bf_tt-allsum-line.vat-cli-acc          + bf_tt-allsum.vat-cli-acc
     3422         bf_tt-allsum-line.slt-base-acc           = bf_tt-allsum-line.slt-base-acc         + bf_tt-allsum.slt-base-acc
     3423         bf_tt-allsum-line.slt-rubl-acc           = bf_tt-allsum-line.slt-rubl-acc         + bf_tt-allsum.slt-rubl-acc
     3424         bf_tt-allsum-line.slt-cli-acc            = bf_tt-allsum-line.slt-cli-acc          + bf_tt-allsum.slt-cli-acc
     3425         bf_tt-allsum-line.road-tax-base-acc      = bf_tt-allsum-line.road-tax-base-acc    + bf_tt-allsum.road-tax-base-acc
     3426         bf_tt-allsum-line.road-tax-rubl-acc      = bf_tt-allsum-line.road-tax-rubl-acc    + bf_tt-allsum.road-tax-rubl-acc
     3427         bf_tt-allsum-line.road-tax-cli-acc       = bf_tt-allsum-line.road-tax-cli-acc     + bf_tt-allsum.road-tax-cli-acc
     3428         bf_tt-allsum-line.excise-base-acc        = bf_tt-allsum-line.excise-base-acc      + bf_tt-allsum.excise-base-acc
     3429         bf_tt-allsum-line.excise-rubl-acc        = bf_tt-allsum-line.excise-rubl-acc      + bf_tt-allsum.excise-rubl-acc
     3430         bf_tt-allsum-line.excise-cli-acc         = bf_tt-allsum-line.excise-cli-acc       + bf_tt-allsum.excise-cli-acc
     3431         bf_tt-allsum-line.transport-base-acc     = bf_tt-allsum-line.transport-base-acc   + bf_tt-allsum.transport-base-acc
     3432         bf_tt-allsum-line.transport-rubl-acc     = bf_tt-allsum-line.transport-rubl-acc   + bf_tt-allsum.transport-rubl-acc
     3433         bf_tt-allsum-line.transport-cli-acc      = bf_tt-allsum-line.transport-cli-acc    + bf_tt-allsum.transport-cli-acc
     3434         bf_tt-allsum-line.other-base-acc         = bf_tt-allsum-line.other-base-acc       + bf_tt-allsum.other-base-acc
     3435         bf_tt-allsum-line.other-rubl-acc         = bf_tt-allsum-line.other-rubl-acc       + bf_tt-allsum.other-rubl-acc
     3436         bf_tt-allsum-line.other-cli-acc          = bf_tt-allsum-line.other-cli-acc        + bf_tt-allsum.other-cli-acc
     3437         .
     3438     end.
     3439   end.
     3440   end.
     3441   end procedure.
     3442   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3443   procedure proc-alt-shift-f2:
     3444     if not ibs.th.gbl.gbl-var:rcode
     3445   then
     3446     run gbl\inidebug.p .
     3447   end.
     3448   procedure proc-alt-shift-f3:
     3449     run gbl/prvssinf.p
     3450       ( input this-procedure
     3451       ) .
     3452   end.
     3453   define variable v-inform-launched as logical no-undo initial false .
     3454   procedure proc-alt-shift-f4:
     3455     define variable v-action as character no-undo .
     3456     if v-inform-launched = false then do:
     3457       assign
     3458         v-inform-launched = true
     3459       .
     3460       run gbl/d-inform.w
     3461         (  input self
     3462         ,  input this-procedure
     3463         , output v-action
     3464         ) no-error .
     3465       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     3466       assign
     3467         v-inform-launched = false
     3468       .
     3469     end.
     3470   end.
     3471   procedure proc-alt-f1:
     3472     run gbl/corrhelp.p
     3473       (input this-procedure
     3474       ) .
     3475   end .
     3476   on alt-shift-f2 anywhere do:
     3477     run proc-alt-shift-f2.
     3478   end.
     3479   on alt-shift-f3 anywhere do:
     3480     run proc-alt-shift-f3 in this-procedure .
     3481   end.
     3482   on alt-shift-f4 anywhere do:
     3483     run proc-alt-shift-f4 in this-procedure.
     3484   end.
     3485   on alt-f1 anywhere do:
     3486     run proc-alt-f1 in this-procedure .
     3487   end.
