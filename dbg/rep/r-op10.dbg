      833   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      834   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      835   procedure paramls-clear :
      836     define buffer buf_temp-param for temp-param .
      837     do
      838     on error undo, return error return-value
      839     :
      840       for each buf_temp-param
      841       on error undo, return error
      842       :
      843         delete buf_temp-param .
      844       end.
      845     end.
      846   end procedure.
      847   procedure paramls-write :
      848     define input  parameter p-code     as character no-undo .
      849     define input  parameter p-sub-code as character no-undo .
      850     define input  parameter p-value    as character no-undo .
      851     define buffer buf_temp-param for temp-param .
      852     do
      853     on error undo, return error return-value
      854     :
      855       find first buf_temp-param
      856         where buf_temp-param.param-code     = p-code
      857           and buf_temp-param.param-sub-code = p-sub-code
      858         no-error .
      859       if not available buf_temp-param then do:
      860         create buf_temp-param .
      861         assign
      862           buf_temp-param.param-code     = p-code
      863           buf_temp-param.param-sub-code = p-sub-code
      864         .
      865       end.
      866       assign
      867         buf_temp-param.param-value = p-value
      868       .
      869     end.
      870   end procedure.
      871   procedure paramls-read :
      872     define input  parameter p-code          as character no-undo .
      873     define input  parameter p-sub-code      as character no-undo .
      874     define input  parameter p-default-value as character no-undo .
      875     define output parameter p-value         as character no-undo .
      876     define buffer buf_temp-param for temp-param .
      877     do
      878     on error undo, return error return-value
      879     :
      880       find first buf_temp-param
      881         where buf_temp-param.param-code     = p-code
      882           and buf_temp-param.param-sub-code = p-sub-code
      883         no-error .
      884       if available buf_temp-param then do:
      885         assign
      886           p-value = buf_temp-param.param-value
      887         .
      888       end.
      889       else do:
      890         assign
      891           p-value = p-default-value
      892         .
      893       end.
      894     end.
      895   end procedure.
      896   procedure paramls-append :
      897     define input  parameter p-code     as character no-undo .
      898     define input  parameter p-sub-code as character no-undo .
      899     define input  parameter p-value    as character no-undo .
      900     define buffer buf_temp-param for temp-param .
      901     do
      902     on error undo, return error return-value
      903     :
      904       find first buf_temp-param
      905            where buf_temp-param.param-code     = p-code
      906              and buf_temp-param.param-sub-code = p-sub-code
      907         no-error .
      908       if not available buf_temp-param then do:
      909         create buf_temp-param .
      910         assign
      911           buf_temp-param.param-code     = p-code
      912           buf_temp-param.param-sub-code = p-sub-code
      913           buf_temp-param.param-value    = p-value
      914         .
      915       end.
      916       else do:
      917           assign
      918               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      919           .
      920       end.
      921     end.
      922   end procedure.
      923   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      924     if num-entries(string(p-dec), '.') = 2
      925       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      926       else return( string(p-dec)) .
      927   end function.
      928   function format-point-to-comma returns char (input orig as char ) .
      929   define variable rtext as character no-undo .
      930   define variable strt as integer no-undo .
      931   define variable leng as integer no-undo .
      932   assign rtext = orig .
      933   repeat:
      934     strt =  index(rtext,'.').
      935     if strt = 0 then leave.
      936     leng = 1.
      937     substring(rtext,strt,leng,"character") = v-delim .
      938   end.
      939   return rtext.
      940   end function.
      941   function format-excel-text returns char ( input start-text as char ) :
      942   def var  i    as int no-undo.
      943   def var  ch   as char no-undo.
      944   def var  n    as int no-undo.
      945   def var  ipos as int no-undo.
      946     n = num-entries(trim(start-text), chr(10)) - 1 .
      947     do i = 1 to n :
      948       ipos = index( start-text, chr(10)).
      949       if ipos > 0 then
      950         substr( start-text, ipos, 1 ) = ' '.
      951     end.
      952     n = num-entries(trim(start-text), chr(13)) - 1 .
      953     do i = 1 to n :
      954       ipos = index( start-text, chr(13)).
      955       if ipos > 0 then
      956         substr( start-text, ipos, 1 ) = ' '.
      957     end.
      958     if index( start-text, '"' ) = 0 then
      959       start-text =  '="'   + trim( start-text) + '"'   .
      960       else do:
      961         n = num-entries(trim(start-text), '"') - 1.
      962         do i = 1 to n :
      963           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      964         end.
      965         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      966         start-text = '="'  + ch  + '"' .
      967       end.
      968     return start-text.
      969   end.
      970   function excel-sum returns char (input p-dec as decimal ).
      971     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      972   end function.
      973   function excel-qnty returns char (input p-dec as decimal ).
      974     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      975   end function.
      976   function format-excel-text-macr returns char ( input start-text as char ) :
      977   def var  i    as int no-undo.
      978   def var  ch   as char no-undo.
      979   def var  n    as int no-undo.
      980   def var  ipos as int no-undo.
      981     n = num-entries(trim(start-text), chr(10)) - 1 .
      982     do i = 1 to n :
      983       ipos = index( start-text, chr(10)).
      984       if ipos > 0 then
      985         substring( start-text, ipos , 1 ) = ' '.
      986     end.
      987     n = num-entries(trim(start-text), chr(13)) - 1 .
      988     do i = 1 to n :
      989       ipos = index( start-text, chr(13)).
      990       if ipos > 0 then
      991         substring( start-text, ipos, 1 ) = ' '.
      992     end.
      993     if index( start-text, '"' ) = 0 then
      994       start-text =  '"'   + trim( start-text) + '"'   .
      995       else do:
      996         n = num-entries(trim(start-text), '"') - 1.
      997         do i = 1 to n :
      998           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      999         end.
     1000         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1001         start-text = '"'  + ch  + '"' .
     1002       end.
     1003     n = num-entries(trim(start-text), chr(10)) - 1 .
     1004     do i = 1 to n :
     1005       ipos = index( start-text, chr(10)).
     1006       if ipos > 0 then
     1007         substring( start-text, ipos , 1 ) = ' '.
     1008     end.
     1009       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     1010     return start-text.
     1011   end.
     1012   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1013   procedure factord :
     1014     define input  parameter p-fact-date            as date    no-undo .
     1015     define input  parameter p-fact-time            as integer no-undo .
     1016     define input  parameter p-fact-num             as integer no-undo .
     1017     define input  parameter p-shift-date           as date    no-undo .
     1018     define input  parameter p-shift-num            as integer no-undo .
     1019     define input  parameter p-shift-on             as logical no-undo .
     1020     define output parameter p-fact-order           as decimal no-undo .
     1021     define output parameter p-shift-end-fact-order as decimal no-undo .
     1022     define output parameter p-day-end-fact-order   as decimal no-undo .
     1023     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1024     if p-fact-date = ?
     1025     then do:
     1026       return error "Не указана фактическая дата" .
     1027     end.
     1028     define variable v-fact-date-num as integer no-undo .
     1029     assign
     1030       v-fact-date-num = integer(p-fact-date)
     1031     .
     1032     if p-fact-num = ?
     1033     or p-fact-num = 0
     1034     then do:
     1035       return error "Не задан p-fact-num " + string(p-fact-num) .
     1036     end.
     1037     if p-fact-num < 0
     1038     then do:
     1039       return error "Отрицательный fact-num " + string(p-fact-num) .
     1040     end.
     1041     if p-fact-num >= 100000000
     1042     then do:
     1043       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1044     end.
     1045     if p-shift-on = true
     1046     then do:
     1047       if p-shift-date = ?
     1048       then do:
     1049         return error "Не задана дата смены" .
     1050       end.
     1051       if p-shift-num = ?
     1052       or p-shift-num = 0
     1053       then do:
     1054         return error "Не задан номер смены" .
     1055       end.
     1056     end.
     1057     else do:
     1058       assign
     1059         p-shift-date = p-fact-date
     1060         p-shift-num  = 24
     1061       .
     1062     end.
     1063     define variable v-shift-offset as integer no-undo .
     1064     if p-shift-date = p-fact-date
     1065     then do:
     1066       assign
     1067         v-shift-offset = 1
     1068       .
     1069     end.
     1070     if p-shift-date < p-fact-date
     1071     then do:
     1072       assign
     1073         v-shift-offset = 0
     1074       .
     1075     end.
     1076     if p-shift-date > p-fact-date
     1077     then do:
     1078       message
     1079         vss-workfile vss-revision vss-description skip
     1080         "Неправильная дата закрытия смены" skip
     1081         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1082         view-as alert-box error .
     1083       undo, return error
     1084         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1085           ,string(p-fact-date, '99/99/9999':U)
     1086           ,string(p-shift-date, '99/99/9999':U)
     1087           )
     1088       .
     1089     end.
     1090     if p-shift-num < 1
     1091     or p-shift-num > 24
     1092     then do:
     1093       message
     1094         vss-workfile vss-revision vss-description skip
     1095         "Неправильный номер смены" skip
     1096         "p-shift-num" p-shift-num skip
     1097         view-as alert-box error .
     1098       undo, return error return-value .
     1099     end.
     1100     assign
     1101       p-fact-order           = v-fact-date-num
     1102                              + v-shift-offset * 0.5
     1103                              + p-shift-num    * 0.02 - 0.01
     1104                              + p-fact-num     * 0.0000000001
     1105       p-shift-end-fact-order = v-fact-date-num
     1106                              + v-shift-offset * 0.5
     1107                              + p-shift-num    * 0.02
     1108       p-day-end-fact-order   = v-fact-date-num
     1109                              + 0.99
     1110     .
     1111     if p-fact-order           <= v-fact-date-num
     1112     or p-shift-end-fact-order <= v-fact-date-num
     1113     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1114     or p-shift-end-fact-order >= p-day-end-fact-order
     1115     then do:
     1116       message
     1117         vss-workfile vss-revision vss-description skip
     1118         "Внутренняя ошибка при генерации фактического номера" skip
     1119         "p-fact-date"            p-fact-date            skip
     1120         "p-fact-time"            p-fact-time            skip
     1121         "p-fact-num"             p-fact-num             skip
     1122         "p-shift-date"           p-shift-date           skip
     1123         "p-shift-num"            p-shift-num            skip
     1124         "p-shift-on"             p-shift-on             skip
     1125         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1126         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1127         "v-fact-date-num"        v-fact-date-num        skip
     1128         view-as alert-box error .
     1129       undo, return error return-value .
     1130     end.
     1131   end procedure.
     1132   procedure day-begin-fact-order :
     1133     define input  parameter p-fact-date            as date    no-undo .
     1134     define output parameter p-day-begin-fact-order as decimal no-undo .
     1135     do
     1136     on error undo, return error return-value
     1137     :
     1138       if p-fact-date = ?
     1139       then do:
     1140         assign
     1141           p-day-begin-fact-order = 0
     1142         .
     1143       end.
     1144       else do:
     1145         assign
     1146           p-day-begin-fact-order = integer(p-fact-date)
     1147         .
     1148       end.
     1149     end.
     1150   end procedure.
     1151   procedure factord-max-fact-order :
     1152     define output parameter p-max-fact-order as decimal   no-undo .
     1153     do
     1154     on error undo, return error return-value
     1155     :
     1156       run day-begin-fact-order in this-procedure
     1157         (input  date(1, 1, 5000)
     1158         ,output p-max-fact-order
     1159         ) .
     1160     end.
     1161   end procedure.
     1162   procedure factord-cut-archive :
     1163     define input  parameter p-obj-type             as character no-undo .
     1164     define input  parameter p-obj-code             as integer   no-undo .
     1165     define input  parameter p-fact-date            as date      no-undo .
     1166     define output parameter p-shift-on             as logical   no-undo .
     1167     define output parameter p-shift-date           as date      no-undo .
     1168     define output parameter p-shift-num            as integer   no-undo .
     1169     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1170     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1171     define variable v-fact-order as decimal   no-undo .
     1172     define buffer buf_shift-obj for ub.shift-obj .
     1173     do
     1174     on error undo, return error return-value
     1175     :
     1176   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1177   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1178     (input  p-obj-type
     1179     ,input  p-obj-code
     1180     ,input  'shift-on=request'
     1181     ,output p-shift-on
     1182     ) no-error .
     1183       if error-status :error
     1184       then do:
     1185         message
     1186           vss-workfile vss-revision vss-description skip
     1187           "Ошибка при определении атрибута объекта" skip
     1188           "Объект" p-obj-type p-obj-code skip
     1189           error-status :get-message(1) skip
     1190           return-value skip
     1191           view-as alert-box error .
     1192         undo, return error return-value .
     1193       end.
     1194       if p-shift-on = false
     1195       then do:
     1196         assign
     1197           p-shift-date               = ?
     1198           p-shift-num                = 0
     1199         .
     1200       end.
     1201       else do:
     1202         find first buf_shift-obj share-lock
     1203           where buf_shift-obj.obj-type   = p-obj-type
     1204             and buf_shift-obj.obj-code   = p-obj-code
     1205             and buf_shift-obj.shift-date > p-fact-date
     1206           use-index pi
     1207           no-error .
     1208         if not available buf_shift-obj
     1209         or buf_shift-obj.status_ <> 'зкр':U
     1210         then do:
     1211           message
     1212             vss-workfile vss-revision vss-description skip
     1213             "Невозможно вычислить последнюю смену" skip
     1214             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1215             "Объект" p-obj-type p-obj-code skip
     1216             "Дата" p-fact-date skip
     1217             view-as alert-box error .
     1218           undo, return error return-value .
     1219         end.
     1220         find last buf_shift-obj share-lock
     1221           where buf_shift-obj.obj-type = p-obj-type
     1222             and buf_shift-obj.obj-code = p-obj-code
     1223             and buf_shift-obj.shift-date <= p-fact-date
     1224           use-index pi
     1225           no-error .
     1226         if available buf_shift-obj
     1227         then do:
     1228           if  buf_shift-obj.status_ = 'зкр':U
     1229           then do:
     1230             assign
     1231               p-shift-date = buf_shift-obj.shift-date
     1232               p-shift-num  = buf_shift-obj.shift-num
     1233             .
     1234           end.
     1235           else do:
     1236             message
     1237               vss-workfile vss-revision vss-description skip
     1238               "Невозможно вычислить последнюю смену" skip
     1239               "Статус смены отличен от статуса" 'зкр':U skip
     1240               "Объект" p-obj-type p-obj-code skip
     1241               "Дата" p-fact-date skip
     1242               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1243               view-as alert-box error .
     1244             undo, return error return-value .
     1245           end.
     1246         end.
     1247         else do:
     1248           assign
     1249             p-shift-date = p-fact-date - 1
     1250             p-shift-num  = 1
     1251           .
     1252         end.
     1253       end.
     1254       run factord in this-procedure
     1255         (input  p-fact-date
     1256         ,input  1
     1257         ,input  1
     1258         ,input  p-shift-date
     1259         ,input  p-shift-num
     1260         ,input  p-shift-on
     1261         ,output v-fact-order
     1262         ,output p-shift-end-fact-order
     1263         ,output p-day-end-fact-order
     1264         ) no-error .
     1265       if error-status :error
     1266       then do:
     1267         message
     1268           vss-workfile vss-revision vss-description skip
     1269           "Ошибка при вызове процедуры factord"
     1270           error-status :get-message(1) skip
     1271           return-value skip
     1272           view-as alert-box error .
     1273         undo, return error return-value .
     1274       end.
     1275     end.
     1276   end procedure.
     1277   procedure factord-lock-shift :
     1278     define input  parameter p-obj-type  as character no-undo .
     1279     define input  parameter p-obj-code  as integer   no-undo .
     1280     define input  parameter p-fact-date as date      no-undo .
     1281     define parameter buffer buf_shift-obj for ub.shift-obj .
     1282     define variable v-shift-on      as logical   no-undo .
     1283     define variable v-extra-message as character no-undo .
     1284     define variable v-error as character no-undo .
     1285     do
     1286     on error undo, return error return-value
     1287     :
     1288   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1289   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1290     (input  p-obj-type
     1291     ,input  p-obj-code
     1292     ,input  'shift-on=request'
     1293     ,output v-shift-on
     1294     ) no-error .
     1295       if error-status :error
     1296       then do:
     1297         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1298         undo, return error v-error .
     1299       end.
     1300       if v-shift-on = true
     1301       then do:
     1302         find first buf_shift-obj share-lock
     1303           where buf_shift-obj.obj-type   = p-obj-type
     1304             and buf_shift-obj.obj-code   = p-obj-code
     1305             and buf_shift-obj.shift-date > p-fact-date
     1306           use-index pi
     1307           no-error .
     1308         if not available buf_shift-obj
     1309         or buf_shift-obj.status_ <> 'зкр':U
     1310         then do:
     1311           find last buf_shift-obj
     1312             where buf_shift-obj.obj-type = p-obj-type
     1313               and buf_shift-obj.obj-code = p-obj-code
     1314               and buf_shift-obj.status_  = 'зкр':U
     1315             use-index stts
     1316             no-error .
     1317           if available buf_shift-obj
     1318           then do:
     1319             assign
     1320               v-extra-message =
     1321                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1322                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1323                               )
     1324             .
     1325           end.
     1326           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1327           undo, return error v-error .
     1328         end.
     1329       end.
     1330     end.
     1331   end procedure.
     1332   procedure factord-end-day :
     1333     define input  parameter p-fact-date            as date    no-undo .
     1334     define output parameter p-day-end-fact-order   as decimal no-undo .
     1335     do
     1336     on error undo, return error return-value
     1337     :
     1338       if p-fact-date = ?
     1339       then do:
     1340         return error "Не указана фактическая дата" .
     1341       end.
     1342       assign
     1343         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1344       .
     1345     end.
     1346   end procedure.
     1347   procedure factord-to-date :
     1348     define input  parameter p-fact-order as decimal no-undo .
     1349     define output parameter p-fact-date  as date    no-undo .
     1350     define variable v-ref-date  as date      no-undo .
     1351     define variable v-ref-delta as integer   no-undo .
     1352     do
     1353     on error undo, return error return-value
     1354     :
     1355       if p-fact-order = ?
     1356       or p-fact-order = 0
     1357       then do:
     1358         return error "Не указан fact-order" .
     1359       end.
     1360       assign
     1361         v-ref-date  = date(1, 1, 2000)
     1362       .
     1363       assign
     1364         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1365       .
     1366       assign
     1367         p-fact-date = v-ref-date + v-ref-delta
     1368       .
     1369     end.
     1370   end procedure.
     1371   procedure factord-to-fact-num :
     1372     define input  parameter p-fact-order as decimal no-undo .
     1373     define output parameter p-fact-num   as integer no-undo .
     1374     define variable v-fact-order-trunc as decimal no-undo .
     1375     do
     1376     on error undo, return error return-value
     1377     :
     1378       if p-fact-order = ?
     1379       or p-fact-order = 0
     1380       then do:
     1381         return error "Не указан fact-order" .
     1382       end.
     1383       assign
     1384        v-fact-order-trunc = truncate(p-fact-order, 2)
     1385       .
     1386       assign
     1387         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1388       .
     1389     end.
     1390   end procedure.
     1391   procedure factord-to-shift-num :
     1392     define input  parameter p-fact-order as decimal no-undo .
     1393     define output parameter p-shift-num   as integer no-undo .
     1394     define variable  p-shift-numd  as decimal   no-undo .
     1395     define variable v-fact-order-trunc as decimal no-undo .
     1396     do
     1397     on error undo, return error return-value
     1398     :
     1399       if p-fact-order = ?
     1400       or p-fact-order = 0
     1401       then do:
     1402         return error "Не указан fact-order" .
     1403       end.
     1404       assign
     1405        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1406       .
     1407       if v-fact-order-trunc < 0.5 then do:
     1408         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1409       end.
     1410       assign
     1411         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1412         .
     1413        assign
     1414         p-shift-num = truncate (p-shift-numd , 0)
     1415       .
     1416     end.
     1417   end procedure.
