     1952     (output varoutvprbcl
     1953     )  .
     1954   if varoutvprbcl = "base":u then do:
     1955     assign
     1956           road-tax-base-salecl    =  (if parroad-tax = ? then 0 else parroad-tax * 1)
     1957       excise-base-salecl      =  (if parexcise   = ? then 0 else parexcise   * 1)
     1958     .
     1959   end.
     1960   else do:
     1961     assign
     1962           road-tax-base-salecl    =  (if parroad-tax = ? then 0 else parroad-tax / parbase-rate * parbase-scale)
     1963       excise-base-salecl      =  (if parexcise   = ? then 0 else parexcise   / parbase-rate * parbase-scale)
     1964     .
     1965   end.
     1966   if varoutvprbcl = "rubl":u then do:
     1967     assign
