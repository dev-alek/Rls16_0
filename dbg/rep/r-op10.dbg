     1996                                  and out-vatp_partscl.obj-code   = parobj-code
     1997                                  and out-vatp_partscl.artic      = parartic
     1998                                  and out-vatp_partscl.prod-type  = parprod-type
     1999                                  and out-vatp_partscl.prod-code  = parprod-code no-lock :
     2000       if out-vatp_partscl.purch-code = 2 then do:
