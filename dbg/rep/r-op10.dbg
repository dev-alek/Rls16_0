     3550   define temp-table temp-font no-undo
     3551     field fontnum  as integer
     3552     field fontname as character
     3553     field fontsize as character
     3554     field fonttype as character
     3555     field font-h   as integer
     3556     field font-w   as integer
     3557     field v-row    as integer
     3558     field v-col    as integer
     3559     field v-row-lans as integer
     3560     field v-col-lans as integer
     3561   index pi fontnum
     3562   .
     3563   procedure get-font-ini :
     3564     do
     3565     on error undo, return error return-value
     3566     :
     3567   define variable ii as integer   no-undo .
     3568   define variable v-font7 as character no-undo .
     3569   define variable v-font as character no-undo .
     3570   define variable loc-name as character no-undo .
     3571   define variable loc-size as character no-undo .
     3572   define variable loc-type as character no-undo .
     3573   define variable old_H as integer   no-undo .
     3574   define variable old_w as integer   no-undo .
     3575   define variable old-row  as integer   no-undo .
     3576   define variable old-col  as integer   no-undo .
     3577   define variable old-row-lans  as integer   no-undo .
     3578   define variable old-col-lans  as integer   no-undo .
     3579   define variable vv as integer   no-undo .
     3580   empty temp-table temp-font.
     3581     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     3582       case num-entries (v-font7) :
     3583         when 4 then do:
     3584             assign
     3585               loc-name = entry ( 1 , v-font7 )
     3586               loc-size = entry ( 2 , v-font7 )
     3587               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     3588             .
     3589         end.
     3590         when 3 then do:
     3591             assign
     3592               loc-name = entry ( 1 , v-font7 )
     3593               loc-size = entry ( 2 , v-font7 )
     3594               loc-type = entry ( 3 , v-font7 )
     3595             .
     3596         end.
     3597         when 2 then  do:
     3598             assign
     3599               loc-name = entry ( 1 , v-font7 )
     3600               loc-size = entry ( 2 , v-font7 )
     3601               loc-type = ""
     3602             .
     3603         end.
     3604         when 1 then do:
     3605             assign
     3606               loc-name = trim(entry ( 1 , v-font7 ))
     3607               loc-size = ""
     3608               loc-type = ""
     3609             .
     3610         end.
     3611       end case.
     3612     create temp-font.
     3613     assign
     3614       temp-font.fontnum  = 7
     3615       temp-font.fontname = trim(loc-name)
     3616       temp-font.fontsize = trim(loc-size)
     3617       temp-font.fonttype = trim(loc-type)
     3618       temp-font.v-row    = 62
     3619       temp-font.v-col    = 136
     3620       temp-font.v-row-lans = 43
     3621       temp-font.v-col-lans = 198
     3622     .
     3623     repeat ii = 16 to 100 :
     3624       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     3625       if v-font = "" or v-font = ? then leave.
     3626       case num-entries (v-font) :
     3627         when 4 then do:
     3628             assign
     3629               loc-name = entry ( 1 , v-font )
     3630               loc-size = entry ( 2 , v-font )
     3631               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     3632             .
     3633         end.
     3634         when 3 then do:
     3635             assign
     3636               loc-name = entry ( 1 , v-font )
     3637               loc-size = entry ( 2 , v-font )
     3638               loc-type = entry ( 3 , v-font )
     3639             .
     3640         end.
     3641         when 2 then do:
     3642             assign
     3643               loc-name = entry ( 1 , v-font )
     3644               loc-size = entry ( 2 , v-font )
     3645               loc-type = ""
     3646             .
     3647         end.
     3648         when 1 then do:
     3649             assign
     3650               loc-name = trim(entry ( 1 , v-font ))
     3651               loc-size = ""
     3652               loc-type = ""
     3653             .
     3654         end.
     3655       end case.
     3656     create temp-font.
     3657     assign
     3658       temp-font.fontnum  = ii
     3659       temp-font.fontname = trim(loc-name)
     3660       temp-font.fontsize = trim(loc-size)
     3661       temp-font.fonttype = trim(loc-type)
     3662     .
     3663     end.
     3664       for each temp-font :
     3665          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     3666          if  vv = ? then vv =  0 .
     3667           run rep/exfont.p (
     3668             input   temp-font.fontname ,
     3669             input   vv ,
     3670             input   temp-font.fonttype ,
     3671             output  temp-font.font-h   ,
     3672             output  temp-font.font-w   )
     3673           .
     3674       end.
     3675   find first temp-font where  temp-font.fontnum  = 7  .
     3676   old_H = temp-font.font-H .
     3677   old_w = temp-font.font-W .
     3678   old-row = temp-font.v-row .
     3679   old-col = temp-font.v-col .
     3680   old-row-lans = temp-font.v-row-lans .
     3681   old-col-lans = temp-font.v-col-lans .
     3682       for each temp-font where
     3683                temp-font.fontnum  <> 7 :
     3684           assign
     3685               temp-font.v-row    = old_H * old-row / temp-font.font-h
     3686               temp-font.v-col    = old_W * old-col / temp-font.font-W
     3687               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     3688               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     3689           .
     3690       end.
     3691     end.
     3692   end procedure.
     3693   PROCEDURE How-name :
     3694   define input  parameter h as integer no-undo .
     3695   define input  parameter w as integer no-undo .
     3696   define output parameter n as character  no-undo .
     3697   define variable A4port-H as integer   no-undo init 63.
     3698   define variable A4port-W as integer   no-undo init 136.
     3699   define variable A4lans-H as integer   no-undo init 43.
     3700   define variable A4lans-W as integer   no-undo init 198.
     3701   define variable Strim-W  as integer   no-undo init 278.
     3702   run define-a4-size (
     3703        input ReportFontNum
     3704       ,output A4port-H
     3705       ,output A4port-W
     3706       ,output A4lans-H
     3707       ,output A4lans-W ).
     3708   If w >= 1 and w <= A4port-W Then DO:
     3709     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     3710     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     3711     If h > A4port-H              Then n = "to-file":U.
     3712   End.
     3713   If w > A4port-W and w <= A4lans-W Then DO:
     3714     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     3715     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     3716     If h > A4port-H              Then n = "to-file":U.
     3717   End.
     3718   If w > A4lans-W and w <= Strim-W Then DO:
     3719     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     3720     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     3721     If h > A4port-H              Then n = "to-file":U.
     3722   End.
     3723   If w > Strim-W Then DO:
     3724      n = "to-file":U.
     3725   End.
     3726   END PROCEDURE.
     3727   PROCEDURE define-a4-size :
     3728   define input  parameter p-ReportFontNum as integer   no-undo .
     3729   define output parameter A4port-H as integer   no-undo .
     3730   define output parameter A4port-W as integer   no-undo .
     3731   define output parameter A4lans-H as integer   no-undo .
     3732   define output parameter A4lans-W as integer   no-undo .
     3733   if not can-find (first temp-font ) then do:
     3734      run get-font-ini .
     3735   end.
     3736   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     3737   if available temp-font then do:
     3738   assign
     3739     A4port-H = temp-font.v-row
     3740     A4port-W = temp-font.v-col
     3741     A4lans-H = temp-font.v-row-lans
     3742     A4lans-W = temp-font.v-col-lans
     3743   .
     3744   end.
     3745   else do:
     3746   assign
     3747     A4port-H = 63
     3748     A4port-W = 136
     3749     A4lans-H = 43
     3750     A4lans-W = 198
     3751   .
     3752   end.
     3753   END PROCEDURE.
