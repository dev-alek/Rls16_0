     1898      out-vatp-have-vat-sltcl = yes.
     1899   end.
     1900   else do:
     1901     find first out-vatp_doc-attrcl no-lock
     1902       where out-vatp_doc-attrcl.doc-code  = pardoc-code
     1903         and out-vatp_doc-attrcl.attr-code = 'envd':U
     1904         no-error .
     1905     if not available out-vatp_doc-attrcl then do:
