     1524             v-cntxp-out-pay         = bf-cntxp_store.out-pay
     1525             v-cntxp-ret-pay         = bf-cntxp_store.ret-pay
     1526             v-cntxp-ret-sup-pay     = bf-cntxp_store.ret-sup-pay
     1527             v-cntxp-down-pay        = bf-cntxp_store.down-pay
     1528             v-cntxp-inv-pay         = bf-cntxp_store.inv-pay
     1529             v-cntxp-chk-pay         = bf-cntxp_store.chk-pay
