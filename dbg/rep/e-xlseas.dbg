     1561       end case.
     1562     end.
     1563   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1564   PROCEDURE no-benq.
     1565   DEFINE OUTPUT PARAMETER found as logical init no.
     1566   define buffer buf_chk-doc for ub.chk-doc.
     1567   FOR EACH obj-list WHERE
     1568           obj-list.obj-type = 'маг':U NO-LOCK :
     1569     CASE X-Radio-Task > 1 :
     1570       WHEN YES THEN DO:
     1571         FOR EACH buf_chk-doc NO-LOCK WHERE
     1572                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1573                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1574                 (
     1575                   buf_chk-doc.shift-date >= X-date-start AND
     1576                   buf_chk-doc.shift-date <= X-date-end)
     1577                   AND
     1578                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1579           IF X-Radio-Task = 3 AND
     1580           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     1581             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     1582           IF X-Radio-Task = 4 AND
     1583           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1584           found = yes.
     1585           return.
     1586         END.
     1587       END.
     1588       WHEN NO THEN DO:
     1589         FOR EACH buf_chk-doc NO-LOCK WHERE
     1590               buf_chk-doc.obj-type = obj-list.obj-type AND
     1591               buf_chk-doc.obj-code = obj-list.obj-code AND
     1592               buf_chk-doc.chk-date >= X-date-start AND
     1593               buf_chk-doc.chk-date <= X-date-end   AND
     1594               (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1595           found = yes.
     1596           return.
     1597         END.
     1598        END.
     1599      END CASE.
     1600    END.
     1601   END PROCEDURE.
     1602   PROCEDURE no-benqi.
     1603   DEFINE OUTPUT PARAMETER found as logical init no.
     1604   define buffer buf_chk-doc for ub.chk-doc.
     1605   define buffer buf_inkas for ub.inkas.
     1606   FOR EACH obj-list WHERE
     1607         obj-list.obj-type = 'маг':U NO-LOCK :
     1608     CASE X-Radio-Task > 1 :
     1609       WHEN YES THEN DO:
     1610         FOR EACH buf_chk-doc No-LOCK WHERE
     1611                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1612                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1613                 (
     1614                   buf_chk-doc.shift-date >= X-date-start AND
     1615                   buf_chk-doc.shift-date <= X-date-end)
     1616                   AND
     1617                   buf_Chk-doc.out-code = ? AND
     1618                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1619           IF X-Radio-Task = 3 AND
     1620           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     1621             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     1622           IF X-Radio-Task = 4 AND
     1623           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1624           found = yes.
     1625           return.
     1626         END.
     1627         FOR EACH buf_inkas No-LOCK WHERE
     1628                   buf_inkas.obj-type = obj-list.obj-type AND
     1629                   buf_inkas.obj-code = obj-list.obj-code AND
     1630                   (
     1631                   buf_inkas.shift-date >= X-date-start AND
     1632                   buf_inkas.shift-date <= X-date-end):
     1633           if buf_inkas.status_ = 'факт':U
     1634           or buf_inkas.status_ = 'запрос':U then next.
     1635           IF X-Radio-Task = 3 AND
     1636           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
     1637             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
     1638           IF X-Radio-Task = 4 AND
     1639           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
     1640           found = yes.
     1641           return.
     1642         END.
     1643       END.
     1644       WHEN NO THEN DO:
     1645         FOR EACH buf_chk-doc NO-LOCK WHERE
     1646                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1647                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1648                 buf_chk-doc.chk-date >= X-date-start AND
     1649                 buf_chk-doc.chk-date <= X-date-end   AND
     1650                 buf_Chk-doc.out-code = ? AND
     1651                 (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1652           found = yes.
     1653           return.
     1654         END.
     1655         FOR EACH buf_inkas NO-LOCK WHERE
     1656                 buf_inkas.obj-type = obj-list.obj-type AND
     1657                 buf_inkas.obj-code = obj-list.obj-code AND
     1658                 buf_inkas.doc-date >= X-date-start AND
     1659                 buf_inkas.doc-date <= X-date-end :
     1660           if buf_inkas.status_ = 'факт':U
     1661           or buf_inkas.status_ = 'запрос':U then next.
     1662           found = yes.
     1663           return.
     1664         END.
     1665       END.
     1666     END CASE.
     1667   END.
     1668   END PROCEDURE.
     1669   PROCEDURE no-benq-i.
     1670   DEFINE OUTPUT PARAMETER found as logical init no.
     1671   define buffer buf_inkas for ub.inkas.
     1672   CASE X-Radio-Task > 1:
     1673     WHEN YES then do:
     1674       FOR EACH obj-list WHERE
     1675               obj-list.obj-type = 'маг':U NO-LOCK :
     1676         FOR EACH buf_inkas NO-LOCK WHERE
     1677                 buf_inkas.obj-type = obj-list.obj-type AND
     1678                 buf_inkas.obj-code = obj-list.obj-code AND
     1679                 buf_inkas.status_ = 'факт':U AND
     1680                 (
     1681                 buf_inkas.shift-date >= X-date-start AND
     1682                 buf_inkas.shift-date <= X-date-end):
     1683           IF X-Radio-Task = 3 AND
     1684           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
     1685             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
     1686           IF X-Radio-Task = 4 AND
     1687           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
     1688           found = yes.
     1689           return.
     1690         END.
     1691     END.
     1692     END.
     1693     WHEN NO THEN DO:
     1694       FOR EACH obj-list WHERE
     1695               obj-list.obj-type = 'маг':U NO-LOCK :
     1696         FOR EACH buf_inkas NO-LOCK WHERE
     1697                 buf_inkas.obj-type = obj-list.obj-type AND
     1698                 buf_inkas.obj-code = obj-list.obj-code AND
     1699                 buf_inkas.status_ = 'факт':U AND
     1700                 buf_inkas.doc-date >= X-date-start AND
     1701                 buf_inkas.doc-date <= X-date-end :
     1702            found = yes.
     1703            return.
     1704         END.
     1705       END.
     1706     END.
     1707   END CASE.
     1708   END PROCEDURE.
     1709   PROCEDURE no-benq-i-office.
     1710   DEFINE OUTPUT PARAMETER found as logical init no.
     1711   define buffer buf_sale-doc for ub.sale-doc.
     1712   CASE X-Radio-Task > 1:
     1713     WHEN YES then do:
     1714       FOR EACH obj-list WHERE
     1715               obj-list.obj-type = 'маг':U NO-LOCK :
     1716         FOR EACH buf_sale-doc NO-LOCK WHERE
     1717                  buf_Sale-doc.obj-type = obj-list.obj-type
     1718              AND buf_sale-doc.obj-code = obj-list.obj-code
     1719              AND buf_sale-doc.status_ = 'факт':U
     1720              AND buf_sale-doc.chr-office = 'у':U
     1721              AND (
     1722                 buf_sale-doc.shift-date >= X-date-start
     1723                 AND
     1724                 buf_sale-doc.shift-date <= X-date-end):
     1725           IF X-Radio-Task = 3 AND
     1726           ((buf_sale-doc.shift-date = X-date-start AND buf_sale-doc.shift-num < X-shift-Start) OR
     1727             (buf_sale-doc.shift-date = X-date-end AND  buf_sale-doc.shift-num > X-shift-End) ) THEN NEXT.
     1728           IF X-Radio-Task = 4 AND
     1729           (buf_sale-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1730           found = yes.
     1731           return.
     1732         END.
     1733       END.
     1734     END.
     1735     WHEN NO THEN DO:
     1736       FOR EACH obj-list WHERE
     1737               obj-list.obj-type = 'маг':U NO-LOCK :
     1738         FOR EACH buf_sale-doc NO-LOCK WHERE
     1739                 buf_sale-doc.obj-type = obj-list.obj-type
     1740            AND  buf_sale-doc.obj-code = obj-list.obj-code
     1741            AND  buf_sale-doc.status_ = 'факт':U
     1742            AND  buf_sale-doc.chr-office = 'у':U
     1743            AND  buf_sale-doc.doc-date >= X-date-start
     1744            AND  buf_sale-doc.doc-date <= X-date-end :
     1745           found = yes.
