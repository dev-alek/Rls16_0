     1751   END PROCEDURE.
     1752   PROCEDURE adm-create-objects :
     1753     DEFINE VARIABLE adm-current-page  AS INTEGER NO-UNDO.
     1754     RUN get-attribute IN THIS-PROCEDURE ('Current-Page':U).
     1755     ASSIGN adm-current-page = INTEGER(RETURN-VALUE).
     1756     CASE adm-current-page:
     1757       WHEN 0 THEN DO:
     1758          RUN init-object IN THIS-PROCEDURE (
     1759                INPUT  'rep/s-month.w':U ,
     1760                INPUT  FRAME F-Main:HANDLE ,
     1761                INPUT  '':U ,
     1762                OUTPUT h_s-month ).
     1763           RUN adjust-tab-order IN adm-broker-hdl ( h_s-month ,
     1764             button-prod:HANDLE IN FRAME F-Main , 'BEFORE':U ).
     1765       END.
     1766     END CASE.
     1767   END PROCEDURE.
     1768   PROCEDURE adm-row-available :
     1769     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1770     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1771     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1772     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1773     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1774     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1775     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1776     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1777     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1778     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1779     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1780     IF adm-updating-record THEN RETURN.
     1781     RUN get-attribute ('FIELDS-ENABLED':U).
     1782     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1783     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1784         OUTPUT link-handle) NO-ERROR.
     1785     IF link-handle = "":U THEN
     1786         RETURN.
     1787     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1788     IF NUM-ENTRIES(link-handle) > 1 THEN
     1789         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1790             "encountered more than one RECORD-SOURCE.":U SKIP
     1791             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1792                VIEW-AS ALERT-BOX ERROR.
     1793     RUN get-attribute ('Key-Name':U).
     1794     key-name = RETURN-VALUE.
     1795     IF key-name = "":U THEN key-name = ?.
     1796     IF key-name NE ? THEN DO:
     1797       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1798         NO-ERROR.
     1799       IF key-value NE ? THEN
     1800         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1801     END.
     1802   IF VALID-HANDLE (adm-object-hdl) THEN
     1803       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1804   RUN notify IN THIS-PROCEDURE ('row-available':U).
     1805   END PROCEDURE.
     1806   PROCEDURE disable_UI :
     1807     HIDE FRAME F-Main.
     1808     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1809   END PROCEDURE.
     1810   PROCEDURE enable_UI :
     1811     DISPLAY E-prod
     1812         WITH FRAME F-Main.
     1813     ENABLE RECT-1 button-prod E-prod
     1814         WITH FRAME F-Main.
     1815   END PROCEDURE.
     1816   PROCEDURE My-report :
     1817   DEFINE VAR StrBuf as char no-undo.
     1818   DEFINE VAR XLStrBuf as char no-undo.
     1819   def var     NotInc          as  log     no-undo.
     1820   define variable v-grp as character no-undo .
     1821   define variable glog as logical no-undo .
     1822   define variable v-curr-r-b as character no-undo .
     1823   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1824   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1825     (output v-curr-r-b
     1826     )  .
     1827   define variable p-XL-delim as character no-undo .
     1828   define variable type-par1 as character no-undo .
     1829   define variable tmp-var1  as character no-undo .
     1830   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1831   empty temp-table thbjattr_thbj-attr.
     1832   run adm/shattri.p (
     1833      input "get":U
     1834     ,input v-cntxt-obj-type
     1835     ,input v-cntxt-obj-code
     1836     ,input 'report-firm':U
     1837     ,input  ""
     1838     ,output v-value-character
     1839     ,output v-value-date
     1840     ,output v-value-decimal
     1841     ,output v-value-integer
     1842     ,output v-value-logical
     1843     ,output par-type
     1844     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1845     ) no-error .
     1846   for each thbjattr_thbj-attr :
     1847       if thbjattr_thbj-attr.prop-code = 'XL-delim'  then tmp-var1   = thbjattr_thbj-attr.property-value-character.
     1848   end.
     1849   IF tmp-var1 = "" then p-XL-delim = ";".
     1850   else p-XL-delim = tmp-var1.
     1851   if NOT avail cli-prod then do:
     1852       message "Не выбран производитель"
     1853       view-as alert-box ERROR.
     1854       return.
     1855   end.
     1856   run Assign-Frame in h_s-month.
     1857   FOR EACH grp_sum :
     1858      delete grp_sum .
     1859   END.
     1860   FOR EACH objects :
     1861      delete objects .
     1862   END.
     1863   assign
     1864   glog = FALSE
     1865   .
     1866   if X-SelectGood = 1 then do:
     1867       message "Вас действительно интересуют" skip
     1868               "ВСЕ ГРУППЫ товаров ?"
     1869       view-as alert-box question buttons YES-NO update glog .
     1870   end.
     1871   else
     1872   glog = TRUE .
     1873   if NOT glog then
     1874   return .
     1875   run waitfram-show in this-procedure ( "Подождите ..." ) .
     1876   run no-benqi(OUTPUT NotInc).
     1877   FOR EACH obj-list :
     1878       FIND FIRST ub.clients WHERE ub.clients.obj-type = obj-list.obj-type AND
     1879                                ub.clients.obj-code = obj-list.obj-code NO-LOCK .
     1880       CREATE objects .
     1881       assign
     1882       objects.obj-type = obj-list.obj-type
     1883       objects.obj-code = obj-list.obj-code
     1884       objects.obj-name = REPLACE(REPLACE(ub.clients.obj-name, chr(44), ""), p-XL-delim, "")
     1885       .
     1886       if X-SelectGood = 1 then
     1887           FOR EACH ub.gds-grp NO-LOCK :
     1888               if NOT can-find( first b-gds-grp where
     1889                                      b-gds-grp.upper-code = ub.gds-grp.node-code ) then do:
     1890                   v-grp = "" .
     1891                   RUN grplib-get-full-name in this-procedure( ub.gds-grp.node-code, output v-grp ) .
     1892                   CREATE grp_sum .
     1893                   assign
     1894                   grp_sum.obj-type = obj-list.obj-type
     1895                   grp_sum.obj-code = obj-list.obj-code
     1896                   grp_sum.grp-name = v-grp
     1897                   grp_sum.grp-code = ub.gds-grp.node-code
     1898                   .
     1899               end.
     1900           END.
     1901       else do:
     1902           FOR EACH tmp#grp NO-LOCK:
     1903               CREATE grp_sum .
     1904               assign
     1905               grp_sum.obj-type = obj-list.obj-type
     1906               grp_sum.obj-code = obj-list.obj-code
     1907               grp_sum.grp-code = tmp#grp.node-code
     1908               grp_sum.grp-name = tmp#grp.grp-name
     1909               .
     1910           END.
     1911       end.
     1912       if can-find( FIRST ub.inkas WHERE
     1913                          ub.inkas.obj-type = obj-list.obj-type AND
     1914                          ub.inkas.obj-code = obj-list.obj-code AND
     1915                          ub.inkas.doc-date >= vStartPoint AND
     1916                          ub.inkas.doc-date <= vEndPoint AND
     1917                          ub.inkas.status_ = 'факт':U ) then
     1918           FOR EACH ub.inkas WHERE
     1919                    ub.inkas.obj-type = obj-list.obj-type AND
     1920                    ub.inkas.obj-code = obj-list.obj-code AND
     1921                    ub.inkas.doc-date >= vStartPoint AND
     1922                    ub.inkas.doc-date <= vEndPoint AND
     1923                    ub.inkas.status_ = 'факт':U NO-LOCK :
     1924             PROCESS EVENTS .
     1925             ACCUMULATE     ub.inkas.inkas-code ( COUNT ) .
     1926             if ( ( ACCUM COUNT ub.inkas.inkas-code ) modulo 5 ) = 0 AND
     1927                  ( ACCUM COUNT ub.inkas.inkas-code ) >= 5
     1928             then
     1929             run waitfram-show in this-procedure ( obj-list.obj-type + " N" + string( obj-list.obj-code ) +
     1930                             ", обработано отчетов о продаже : " +
     1931                             string( ACCUM COUNT ub.inkas.inkas-code ) ) .
     1932             FIND FIRST ub.trn-doc where ub.trn-doc.doc-code = ub.inkas.inkas-code no-lock no-error.
     1933             FIND FIRST ret-doc where ret-doc.doc-code = ub.trn-doc.out-code no-lock no-error.
     1934             FOR EACH ub.gds-dtl NO-LOCK WHERE ub.gds-dtl.doc-code = trn-doc.doc-code
     1935               BREAK BY ub.gds-dtl.prod-type
     1936                            BY ub.gds-dtl.prod-code:
     1937               FIND FIRST ub.goods WHERE ub.goods.prod-type = ub.gds-dtl.prod-type AND
     1938                                                            ub.goods.prod-code = ub.gds-dtl.prod-code AND
     1939                                                            ub.goods.artic = ub.gds-dtl.artic NO-ERROR .
     1940               if available ub.goods then do:
     1941                   FIND FIRST grp_sum WHERE
     1942                              grp_sum.grp-code = ub.goods.grp-code AND
     1943                              grp_sum.obj-type = obj-list.obj-type AND
     1944                              grp_sum.obj-code = obj-list.obj-code NO-ERROR .
     1945                   if available grp_sum then do:
     1946                      grp_sum.tot-sum = grp_sum.tot-sum + ub.gds-dtl.doc-qnty * ub.gds-dtl.cur-base.
     1947                   end.
     1948               end.
     1949            END.
     1950            if available ret-doc then do:
     1951             FOR EACH ub.gds-dtl NO-LOCK WHERE ub.gds-dtl.doc-code = ret-doc.doc-code
     1952                 BREAK BY ub.gds-dtl.prod-type
     1953                             BY ub.gds-dtl.prod-code:
     1954                 FIND FIRST ub.goods WHERE ub.goods.prod-type = ub.gds-dtl.prod-type AND
     1955                                                             ub.goods.prod-code = ub.gds-dtl.prod-code AND
     1956                                                             ub.goods.artic = ub.gds-dtl.artic NO-ERROR .
     1957                 if available ub.goods then do:
     1958                     FIND FIRST grp_sum WHERE
     1959                               grp_sum.grp-code = ub.goods.grp-code AND
     1960                               grp_sum.obj-type = obj-list.obj-type AND
     1961                               grp_sum.obj-code = obj-list.obj-code NO-ERROR .
     1962                     if available grp_sum then do:
     1963                         grp_sum.tot-sum = grp_sum.tot-sum - gds-dtl.doc-qnty * gds-dtl.cur-base.
     1964                     end.
     1965                 end.
     1966             END.
     1967           end.
     1968       END.
     1969       if can-find( FIRST ub.trn-doc WHERE
     1970                          ub.trn-doc.obj-type = obj-list.obj-type AND
     1971                          ub.trn-doc.obj-code = obj-list.obj-code AND
     1972                          ub.trn-doc.internal = no AND
     1973                        ( ub.trn-doc.doc-type = 'рас':U OR trn-doc.doc-type = 'возврат':U ) AND
     1974                          ub.trn-doc.status_ = 'факт':U AND
     1975                          ub.trn-doc.fact-date >= vStartPoint AND
     1976                          ub.trn-doc.fact-date <= vEndPoint AND
     1977                          ub.trn-doc.ext-doc-type <> 'ep':U AND
     1978                          ub.trn-doc.discnt-type <> 'касс':U ) then
     1979           FOR EACH ub.trn-doc WHERE
     1980                    ub.trn-doc.obj-type = obj-list.obj-type AND
     1981                    ub.trn-doc.obj-code = obj-list.obj-code AND
     1982                    ub.trn-doc.internal = no AND
     1983                  ( ub.trn-doc.doc-type = 'рас':U OR ub.trn-doc.doc-type = 'возврат':U ) AND
     1984                    ub.trn-doc.status_ = 'факт':U AND
     1985                    ub.trn-doc.fact-date >= vStartPoint AND
     1986                    ub.trn-doc.fact-date <= vEndPoint AND
     1987                    ub.trn-doc.ext-doc-type <> 'ep':U AND
     1988                    ub.trn-doc.discnt-type <> 'касс':U NO-LOCK :
     1989               PROCESS EVENTS .
     1990               ACCUMULATE     ub.trn-doc.doc-code ( COUNT ) .
     1991               if ( ( ACCUM COUNT ub.trn-doc.doc-code ) modulo 10 ) = 0 AND
     1992                    ( ACCUM COUNT ub.trn-doc.doc-code ) >= 10
     1993               then
     1994               run waitfram-show in this-procedure (obj-list.obj-type + " N" + string( obj-list.obj-code ) +
     1995                               ", обработано накладных : " +
     1996                               string( ACCUM COUNT ub.trn-doc.doc-code ) ) .
     1997               FOR EACH ub.doc-line WHERE ub.doc-line.doc-code = ub.trn-doc.doc-code AND
     1998                                       ub.doc-line.prod-type = cli-prod.obj-type AND
     1999                                       ub.doc-line.prod-code = cli-prod.obj-code NO-LOCK :
     2000                   FIND FIRST ub.goods WHERE ub.goods.prod-type = ub.doc-line.prod-type AND
     2001                                                                ub.goods.prod-code = ub.doc-line.prod-code AND
     2002                                                                ub.goods.artic = ub.doc-line.artic NO-ERROR .
     2003                   if available ub.goods then do:
     2004                       FIND FIRST grp_sum WHERE
     2005                                           grp_sum.grp-code = ub.goods.grp-code AND
     2006                                           grp_sum.obj-type = obj-list.obj-type AND
     2007                                           grp_sum.obj-code = obj-list.obj-code NO-ERROR .
     2008                       if available grp_sum then do:
     2009                           FOR EACH ub.gds-dtl WHERE
     2010                                    ub.gds-dtl.doc-code = ub.doc-line.doc-code AND
     2011                                    ub.gds-dtl.prod-code = ub.doc-line.prod-code AND
     2012                                    ub.gds-dtl.prod-type = ub.doc-line.prod-type AND
     2013                                    ub.gds-dtl.artic = ub.doc-line.artic    NO-LOCK :
     2014                               ACCUMULATE
     2015                               (if v-curr-r-b = 'base':U
     2016                               then ub.gds-dtl.price-base
     2017                               else ub.gds-dtl.price-rubl )
     2018                               * ub.gds-dtl.fact-qnty ( TOTAL ) .
     2019                           END .
     2020                           assign
     2021                           grp_sum.tot-sum = grp_sum.tot-sum +
     2022                                            ( if can-do( 'рас':U, ub.trn-doc.doc-type )
     2023                                             then ( ACCUM TOTAL
     2024                                                   (if v-curr-r-b = 'base':U
     2025                                                   then ub.gds-dtl.price-base
     2026                                                   else ub.gds-dtl.price-rubl )
     2027                                                   * ub.gds-dtl.fact-qnty )
     2028                                             else ( - ( ACCUM TOTAL
     2029                                                       (if v-curr-r-b = 'base':U
     2030                                                       then ub.gds-dtl.price-base
     2031                                                       else ub.gds-dtl.price-rubl )
     2032                                                        * ub.gds-dtl.fact-qnty ) ) ) .
     2033                       end.
     2034                    end.
     2035               END.
     2036           END .
     2037   END.
     2038   run waitfram-hide in this-procedure .
     2039   if can-find( first grp_sum where grp_sum.tot-sum <> 0 ) then do:
     2040       run gbl/numtomon.p ( month( vStartPoint ), output StrBuf ) .
     2041       run prn-lib-open-stream  in this-procedure (
     2042                                                   input my-handle
     2043                                                   ,input 0
     2044                                                   ,input yes
     2045                                                   ,input no
     2046                                                   ).
     2047       PUT stream PrnLibStream space(10)
     2048       string( "Реализация товаров производителя ( фирмы )   " +
     2049               cli-prod.obj-name ) format "x(100)" skip
     2050       space(25) "в действовавших продажных ценах" skip
     2051       space(29) "за  " StrBuf format "x(9)" string( year( vStartPoint ), ">>>9" ) format "x(4)"
     2052       " года  " skip(1)
     2053       space(25) ( if NotInc then "( сформирован НЕ ПО ВСЕМ ЧЕКАМ )" else " " ) format "x(40)" skip
     2054       .
     2055       assign
     2056       StrBuf = string( p-XL-delim + string( "Группа товаров", "x(49)" ) + p-XL-delim )
     2057       sheetf.Excel-COlumn-Lable = string( string( "Группа товаров", "x(49)" ) + chr(44) )
     2058       sheetf.sizes = "49" + chr(44)
     2059       .
     2060       FOR EACH objects BY objects.obj-type BY objects.obj-code :
     2061           assign
     2062           StrBuf = StrBuf + string( caps( trim( objects.obj-type ) ) + ".  N " +
     2063                    string ( objects.obj-code, ">>>>>>9" ) + p-XL-delim , "x(16)" )
     2064           sheetf.Excel-Column-Lable = sheetf.Excel-COlumn-Lable + string( caps( trim( objects.obj-type ) ) + ".  N " +
     2065                    string ( objects.obj-code, ">>>>>>9" ) + chr(44) , "x(16)" )
     2066           sheetf.SIzes = sheetf.Sizes + "16" + chr(44)
     2067           .
     2068       END .
     2069       assign
     2070       StrBuf = StrBuf + "     ИТОГО" + fill( " ", 5 ) + p-XL-delim
     2071       sheetf.Excel-COlumn-Lable = sheetf.Excel-Column-lable + "     ИТОГО" + fill( " ", 5 ) + chr(44)
     2072       sheetf.SIzes = sheetf.SIzes + "16" + chr(44)
     2073       .
     2074       EXPORT stream PrnLibStream StrBuf .
     2075       assign
     2076       StrBuf = p-XL-delim + fill( " ", 49 ) + p-XL-delim
     2077       sheetf.Excel-Column-Lable = sheetf.EXcel-COlumn-Lable + chr(10) + chr(44)
     2078       .
     2079       FOR EACH objects BY objects.obj-type BY objects.obj-code :
     2080           assign
     2081           StrBuf = StrBuf + string( string( objects.obj-name, "x(15)" ) + p-XL-delim , "x(16)" )
     2082           sheetf.Excel-COlumn-Lable = sheetf.Excel-COlumn-Lable +  string( replace(objects.obj-name, chr(44), "":U), "x(16)" ) + chr(44)
     2083           .
     2084       END .
     2085       assign
     2086       StrBuf = StrBuf + fill( " ", 15 ) + p-XL-delim
     2087       sheetf.Excel-COlumn-Lable = sheetf.Excel-COlumn-Lable + chr(44)
     2088       str3 = " "
     2089       .
     2090       EXPORT stream PrnLibStream StrBuf .
     2091       PUT stream PrnLibStream "" skip .
     2092       run rep/extitle.p (1).
     2093       FOR EACH grp_sum BREAK BY grp_sum.grp-name
     2094                              BY grp_sum.obj-type
     2095                              BY grp_sum.obj-code :
     2096         if first-of( grp_sum.grp-name )
     2097         then
     2098         assign
     2099         StrBuf = string( p-XL-delim + string( grp_sum.grp-name, "X(49)" ) + p-XL-delim )
     2100         XLStrBuf = string( string( grp_sum.grp-name, "X(49)" ) + CHR(9))
     2101         .
     2102         ACCUMULATE grp_sum.tot-sum ( SUB-TOTAL BY grp_sum.grp-name ) .
     2103         assign
     2104         StrBuf = StrBuf + ( if grp_sum.tot-sum <> 0
     2105                             then string( grp_sum.tot-sum, "->>>,>>>,>>9.99" )
     2106                             else fill( " ", 15 ) ) +   p-XL-delim
     2107         XLStrBuf = XLStrBuf + ( if grp_sum.tot-sum <> 0
     2108                             then string( grp_sum.tot-sum )
     2109                             else "":U ) +   CHR(9)
     2110         .
     2111         if last-of( grp_sum.grp-name ) then do:
     2112             assign
     2113             StrBuf = StrBuf + ( if ( ACCUM SUB-TOTAL BY grp_sum.grp-name grp_sum.tot-sum ) <> 0
     2114                                 then string( ACCUM SUB-TOTAL BY grp_sum.grp-name
     2115                                           grp_sum.tot-sum, "->>>,>>>,>>9.99" )
     2116                                 else fill( " ", 15 ) ) + p-XL-delim
     2117             XLStrBuf = XLStrBuf + ( if ( ACCUM SUB-TOTAL BY grp_sum.grp-name grp_sum.tot-sum ) <> 0
     2118                                 then string( ACCUM SUB-TOTAL BY grp_sum.grp-name
     2119                                           grp_sum.tot-sum )
     2120                                 else "":U) + CHR(9)
     2121             .
     2122             EXPORT stream PrnLibStream StrBuf .
     2123             if Make-Excel then  put   stream ForExcel unformatted
     2124             XLStrbuf
     2125             SKIP.
     2126         end.
     2127      END.
     2128      PUT stream PrnLibStream "" skip .
     2129      assign
     2130      StrBuf = p-XL-delim + string("ИТОГО:", "X(49)") + p-XL-delim
     2131      XLStrBuf = string("ИТОГО:", "X(49)") + CHR(9)
     2132      .
     2133      FOR EACH grp_sum BREAK BY grp_sum.obj-type BY grp_sum.obj-code :
     2134         ACCUMULATE
     2135         grp_sum.tot-sum ( SUB-TOTAL BY grp_sum.obj-code )
     2136         grp_sum.tot-sum ( TOTAL ) .
     2137         if last-of( grp_sum.obj-code )
     2138         then
     2139         assign
     2140         StrBuf = StrBuf +
     2141                  string( ACCUM SUB-TOTAL BY grp_sum.obj-code grp_sum.tot-sum, "->>>,>>>,>>9.99" ) +
     2142                  p-XL-delim
     2143         XLStrBuf = XLStrBuf +
     2144                  string( ACCUM SUB-TOTAL BY grp_sum.obj-code grp_sum.tot-sum) +
     2145                  CHR(9)
     2146         .
     2147      END.
     2148      assign
     2149      StrBuf = StrBuf +
     2150               string( ACCUM TOTAL grp_sum.tot-sum, "->>>,>>>,>>9.99" ) +
     2151               p-XL-delim
     2152      XLStrBuf = XLStrBuf +
     2153               string( ACCUM TOTAL grp_sum.tot-sum ) +
     2154               CHR(9)
     2155      .
     2156      EXPORT stream PrnLibStream StrBuf .
     2157      PUT stream PrnLibStream " " SKIP.
     2158      if Make-Excel then  put   stream ForExcel unformatted
     2159      XlStrBuf
     2160      SKIP.
     2161      output stream PrnLibStream CLOSE .
     2162      if Make-Excel then output stream ForExcel close.
     2163       run prn-lib-prn-file in this-procedure (
     2164                                                 input my-handle
     2165                                                 ,input 11
     2166                                                 ).
     2167   end.
     2168   else do:
     2169       run waitfram-hide in this-procedure .
     2170       message "Не было никакой выручки на выбранных объектах" skip
     2171               "в течение заданного Вами периода времени."
     2172       view-as alert-box INFORMATION .
     2173   end.
     2174   END PROCEDURE.
     2175   PROCEDURE My-var :
     2176   DEFINE VAR StrBuf as char no-undo.
     2177   def var     NotInc          as  log     no-undo.
     2178   run Assign-Frame in h_s-month.
     2179   Assign
     2180    STR-obj-type = ''
     2181    STR-obj-code = ''
     2182    STR-obj-name = ''
     2183    STR-obj      = ''.
     2184   IF X-SelectGood = 1
     2185   then
     2186   str2 = "По всем группам товаров".
     2187   For each obj-list no-lock:
     2188    Assign
     2189    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     2190    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     2191    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     2192    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     2193   End.
     2194   ReportNAme = "Помесячный оборот по производителю и классификатору в ценах продаж".
     2195   run gbl/numtomon.p ( month( vStartPoint ), output StrBuf ) .
     2196   run no-benqi(OUTPUT NotInc).
     2197   ReportHeader = "За " + StrBuf  + " " + ENTRY(NUm-entries(vStrBuf, " "), vStrBuf, " ") +
     2198                 chr(10) +
     2199                 "Производитель: " + (if avail cli-prod then cli-prod.obj-name  else "") +
     2200                 chr(10) +  ( if NotInc then "( сформирован НЕ ПО ВСЕМ ЧЕКАМ )" else " " ).
     2201   END PROCEDURE.
     2202   PROCEDURE send-records :
     2203   END PROCEDURE.
     2204   PROCEDURE state-changed :
     2205     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
     2206     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     2207   END PROCEDURE.
