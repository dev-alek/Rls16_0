      631   procedure prn-lib-prn-file :
      632     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      633     define input parameter p-DIsabledoptions as integer no-undo .
      634     define variable v-report-name as character no-undo .
      635     define variable v-user-action as character no-undo .
      636     define variable v-printed     as logical   no-undo .
      637     define variable v-exist       as logical   no-undo .
      638     do
      639       on error undo, return error
      640       :
      641       run prn-lib-get-report-name  in this-procedure (
      642         input parParentProc
      643         ,output v-report-name
      644         ).
      645   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      646   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      647     (input  v-report-name
      648     ,input  2
      649     ,output v-exist
      650     )  .
      651       if NOT v-exist then
      652       DO:
      653         Message
      654           "Нет заданий на печать ! "
      655           view-as alert-box .
      656         Return  .
      657       End.
      658       run gbl/prnfilen.w
      659         (input  ""
      660         ,input  p-DisabledOptions
      661         ,input  string(v-report-name )
      662         ,input  7
      663         ,output v-user-action
      664         ,output v-printed
      665         ) .
      666       if v-printed then
      667       do:
      668         return "YES" .
      669       end.
      670       else
      671       do:
      672         return "NO" .
      673       end.
      674     end.
      675   end procedure.
      676   procedure prn-lib-open-stream :
      677     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      678     define input parameter p-page-size    as integer no-undo .
      679     define input parameter p-is-stream    as logical no-undo .
      680     define input parameter p-append       as logical no-undo .
      681     define variable v-report-name as character no-undo .
      682     do
      683       on error undo, return error
      684       :
      685       run prn-lib-get-report-name  in this-procedure (
      686         input parParentProc
      687         ,output v-report-name
      688         ).
      689       if p-is-stream then
      690       do:
      691         if p-append then
      692         do:
      693           output stream PrnLibStream to value( v-report-name )
      694             page-size value(p-page-size) append .
      695         end.
      696         if not p-append then
      697         do:
      698           output stream PrnLibStream to value( v-report-name )
      699             page-size value(p-page-size) .
      700         end.
      701       end.
      702       if not p-is-stream then
      703       do:
      704         if p-append then
      705         do:
      706           output to value( v-report-name )
      707             page-size value(p-page-size) append .
      708         end.
      709         if not p-append then
      710         do:
      711           output to value( v-report-name )
      712             page-size value(p-page-size) .
      713         end.
      714       end.
      715     end.
      716   end procedure.
      717   procedure prn-lib-open-exp :
      718     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      719     define input parameter p-is-stream    as logical no-undo .
      720     define input parameter p-is-append    as logical no-undo .
      721     define output parameter p-ReportFileName as char init "report" no-undo.
      722     define output parameter p-process as logical no-undo .
      723     define variable glog as logical no-undo .
      724     do
      725       on error undo, return error
      726       :
      727       SYSTEM-DIALOG GET-FILE p-ReportFileName
      728         TITLE      "Укажите путь"
      729         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      730         ASK-OVERWRITE
      731         CREATE-TEST-FILE
      732         SAVE-AS
      733         USE-FILENAME
      734         DEFAULT-EXTENSION "txt"
      735         UPDATE glog
      736         .
      737       if not glog then  return.
      738       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      739       if p-is-stream then
      740       do:
      741         if p-is-append then
      742         do:
      743           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      744         end.
      745         else
      746         do:
      747           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      748         end.
      749       end.
      750       else
      751       do:
      752         if p-is-append then
      753         do:
      754           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      755         end.
      756         else
      757         do:
      758           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      759         end.
      760       end.
      761       p-process = yes.
      762     end.
      763   end procedure.
      764   procedure prn-lib-get-report-name :
      765     define input parameter parParentProc  as widget-handle no-undo.
      766     define output parameter p-report-name as character no-undo .
      767     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      768   end procedure.
      769   procedure prn-lib-reportviewer-report-name :
      770     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      771     define input parameter p-report-name-html as character no-undo .
      772     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      773   end procedure.
      774   procedure prn-lib-reportviewer :
      775     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      776     define input parameter p-report-name-html as character no-undo .
      777     define input parameter p-param        as character no-undo .
      778     define variable v-excel           as character no-undo init 'TRUE' .
      779     define variable v-value-character as character no-undo .
      780     define variable v-value-integer   as character no-undo .
      781     define variable v-value-date      as date      no-undo .
      782     define variable v-value-decimal   as decimal   no-undo .
      783     define variable rep-excel         as logical   no-undo .
      784     define variable excel-string      as character no-undo .
      785     define variable v-param-type      as character no-undo .
      786     define variable v-tth             as handle    no-undo .
      787     run adm/shattri.p (
      788       input "get":U
      789       ,input  ""
      790       ,input  0
      791       ,input  'report-glob':U
      792       ,input  'rep-excel':U
      793       ,output v-value-character
      794       ,output v-value-date
      795       ,output v-value-decimal
      796       ,output v-value-integer
      797       ,output rep-excel
      798       ,output v-param-type
      799       ,INPUT-OUTPUT table-handle v-tth
      800       )  .
      801     if rep-excel then v-excel = "TRUE" .
      802     else v-excel = "FALSE" .
      803     if p-param eq ""
      804     then
      805        p-param = "EXCEL:" + v-excel.
      806     else
      807        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      808     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      809   end procedure.
      810   define variable vss-include-info11 as character format "X(65)" no-undo
      811   initial "@(#)$Workfile$ $Revision$".
      812   procedure grplib-get-full-name :
      813      define input parameter p-node-code  as integer      no-undo.
      814      define output parameter p-full-name as character    no-undo.
      815      do
      816   on error undo, return error
      817   :
      818       define variable v-upper-code    as integer           no-undo.
      819       define buffer buf_gds-grp       for ub.gds-grp.
      820       define buffer buf_upper_gds-grp for ub.gds-grp.
      821       find first buf_gds-grp no-lock
      822            where buf_gds-grp.node-code = p-node-code
      823       no-error.
      824       if not available buf_gds-grp
      825       then do:
      826           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      827       end.
      828       assign
      829           p-full-name  = ""
      830           v-upper-code = 1
      831       .
      832       do while buf_gds-grp.upper-code <> 0
      833       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      834       :
      835           assign
      836               p-full-name  = buf_gds-grp.node-name
      837                            + (if p-full-name <> "" then chr(47) else "")
      838                            + p-full-name
      839               v-upper-code = buf_gds-grp.upper-code
      840           .
      841           find first buf_gds-grp no-lock
      842                where buf_gds-grp.node-code = v-upper-code
      843           no-error.
      844           if not available buf_gds-grp
      845           then do:
      846               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      847                                   + string( v-upper-code )
      848                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      849           end.
      850       end.
      851       assign
      852       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      853       .
      854   end.
      855   end .
      856   procedure grplib-get-node-from-full-name :
      857   define input parameter p-full-name as character no-undo .
      858   define output parameter p-node-code as integer no-undo .
      859   define variable v-ii as integer no-undo .
      860   define variable v-upper-code as integer no-undo .
      861   define variable v-root-code as integer no-undo .
      862   define variable v-entry as character no-undo .
      863   define buffer buf_gds-grp       for ub.gds-grp.
      864   do
      865   on error undo, return error
      866   :
      867     find first buf_gds-grp no-lock
      868         where buf_gds-grp.upper-code = 0
      869     no-error .
      870     if not available buf_gds-grp
      871     then do:
      872         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      873     end.
      874     else do:
      875       assign
      876       v-root-code = buf_gds-grp.node-code
      877       .
      878     end.
      879     v-upper-code = v-root-code.
      880     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      881       assign
      882       v-entry = entry(v-ii, p-full-name, chr(47)).
      883       if v-entry = '' then leave.
      884       find first buf_gds-grp no-lock where
      885                 buf_gds-grp.node-name = v-entry
      886             and buf_gds-grp.upper-code = v-upper-code
      887             no-error.
      888       if not available buf_gds-grp then do:
      889         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      890       end.
      891       else do:
      892         p-node-code = buf_gds-grp.node-code.
      893         v-upper-code = buf_gds-grp.node-code.
      894       end.
      895     end.
      896   end.
      897   end .
      898   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      899   define variable v-waitfram-action01         as character   no-undo .
      900   define variable v-waitfram-action02         as character   no-undo .
      901   define variable v-waitfram-action03         as character   no-undo .
      902   define variable mWaitFramTextBeg            as character   no-undo.
      903   define variable mWaitFramTextEnd            as character   no-undo.
      904   define variable mWaitFramView               as logical     no-undo.
      905   define variable mWaitProcEvent              as logical     no-undo init yes.
      906   define variable mWaitFramInterval           as integer     no-undo init 1 .
      907   define variable mWaitFramStop               as logical     no-undo.
      908   define variable mWaitFramStopUser           as logical     no-undo.
      909   define variable mWaitFramStopTimeOut        as logical     no-undo.
      910   define variable mWaitFramStartProc          as datetime-tz no-undo.
      911   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      912   define button B-WaitFramStop auto-end-key
      913        label "Стоп"
      914        size 10 by 1 tooltip "Остоновить процесс".
      915   define button B-viewProcInfo
      916        label "Информация"
      917        size 15 by 1 tooltip "Информация о процесс".
      918   define frame waitfram
      919     v-waitfram-action01 format "x(72)" no-label skip
      920     v-waitfram-action02 format "x(72)" no-label skip
      921     v-waitfram-action03 format "x(72)" no-label skip
      922     B-viewProcInfo
      923     B-WaitFramStop at row 4 col 30
      924     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      925     .
      926   define new global shared variable mBatchMode as logical no-undo init ?.
      927   define variable mFramBachModHandle as handle no-undo.
      928   mFramBachModHandle = frame waitfram:handle.
      929   define variable mFameOldVis as logical no-undo.
      930   define variable mVisCUrentVin as logical no-undo.
      931   if session:batch-mode
      932   then
      933      mBatchMode = yes.
      934   if mBatchMode = ? then do:
      935     mVisCUrentVin = current-window:visible.
      936     mFameOldVis = mFramBachModHandle:visible.
      937     mFramBachModHandle:visible  = yes.
      938     mBatchMode = mFramBachModHandle:visible ne yes.
      939     mFramBachModHandle:visible = mFameOldVis.
      940     current-window:visible = mVisCUrentVin.
      941   end.
      942    if  log-manager:logfile-name ne ?
      943     then DO:
      944         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      945         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      946         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      947     end.
      948   on choose of B-WaitFramStop in frame waitfram
      949   do:
      950     mWaitFramStop = yes.
      951     mWaitFramStopUser = yes.
      952   end.
      953   function waitfram-check-timeout returns logical():
      954      define variable vtime as int64 no-undo.
      955      if mWaitFramStopTimeOut
      956      then
      957         return yes.
      958      vtime = ( now - mWaitFramStartProc ) / 1000 .
      959      if     mWaitFramTimeOut ne ?
      960         and mWaitFramTimeOut ne 0
      961         and mWaitFramTimeOut lt vtime
      962      then do:
      963         mWaitFramStopTimeOut = yes.
      964      end.
      965      return mWaitFramStopTimeOut.
      966   end.
      967   procedure waitfram-hide :
      968     if not session:batch-mode
      969     then do
      970     on error undo, return error return-value
      971     :
      972       pause 0 before-hide .
      973       if not mBatchMode then
      974         hide frame waitfram .
      975     if     not mWaitFramView
      976        and mWaitProcEvent
      977     then
      978       process events .
      979     end.
      980   end procedure.
      981   procedure waitfram-show :
      982     define input  parameter p-message as character no-undo .
      983     define variable v-left-margin as integer   no-undo .
      984     if not session:batch-mode
      985     then do
      986     on error undo, return error return-value
      987     :
      988       if length(p-message) <= 70 then do:
      989         assign
      990           v-left-margin = integer((70 - length(p-message)) / 2)
      991         .
      992         assign
      993           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      994         .
      995         assign
      996           v-waitfram-action01 = " "
      997           v-waitfram-action02 = " "
      998                                    + fill(" ", v-left-margin)
      999                                    + p-message
     1000           v-waitfram-action03 = " "
     1001         .
     1002       end.
     1003       else do:
     1004         define variable vRindex1 as integer no-undo.
     1005         define variable vRindex2 as integer no-undo.
     1006         vRindex1 = r-index(p-message," ",70).
     1007         if vRindex1 = 0
     1008         then
     1009            vRindex1 = 70.
     1010         if length(p-message)  <= vRindex1 + 70 then do:
     1011           assign
     1012             v-waitfram-action01 = " "
     1013             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1014             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1015           .
     1016         end.
     1017         else do:
     1018           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1019           if vRindex2 <= vRindex1
     1020           then
     1021              vRindex2 = vRindex1 + 70.
     1022           assign
     1023             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1024             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1025             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1026           .
     1027         end.
     1028       end.
     1029       B-viewProcInfo:visible   in frame waitfram = no.
     1030       B-viewProcInfo:sensitive in frame waitfram = no.
     1031       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1032       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1033       if  (   mWaitFramView
     1034          or  mWaitProcEvent)
     1035          and not mBatchMode
     1036       then
     1037          display
     1038             v-waitfram-action01 skip
     1039             v-waitfram-action02 skip
     1040             v-waitfram-action03 skip
     1041          with frame waitfram .
     1042       if     mWaitFramView
     1043          then do:
     1044             if     mWaitFramInterval ne ?
     1045                and not mBatchMode
     1046             then
     1047                wait-for go of frame waitfram pause mWaitFramInterval.
     1048          end.
     1049          else
     1050             if     mWaitProcEvent
     1051                and not mBatchMode
     1052             then
     1053                process events .
     1054     end.
     1055   end procedure.
     1056      procedure waitfram-show-this:
     1057         define input  parameter iInterval as int64 no-undo.
     1058         define variable vtime as int64 no-undo.
     1059         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1060         mWaitFramInterval = iInterval.
     1061         run waitfram-show (substitute("&1&2 &3&4" ,
     1062                                       mWaitFramTextBeg ,
     1063                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1064                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1065                                       mWaitFramTextEnd
     1066                                      )
     1067                           ).
     1068      end.
     1069      procedure WaitFramRunPause:
     1070         define input  parameter iInterval as dec no-undo.
     1071         define variable vStart  as datetime-tz no-undo.
     1072         define variable vend    as datetime-tz no-undo.
     1073         define variable vint as int64 no-undo.
     1074         define variable vOk as logical no-undo.
     1075         vStart = now.
     1076         vend   = vStart.
     1077         publish "WaitFramPause" (iInterval,output vOk).
     1078         vend   =  now.
     1079         vint = vend - vStart.
     1080         vint = iInterval - vint / 1000.
     1081         if     not mWaitFramStop
     1082            and (   vint > 0
     1083                 or (    not vOk
     1084                     and iInterval eq ?
     1085                     )
     1086                 )
     1087         then
     1088            run waitfram-show-this (iInterval).
     1089         vend   =  now.
     1090         vint = vend - vStart.
     1091         vint = iInterval - vint / 1000.
     1092         if     not mWaitFramStop
     1093            and vint > 0
     1094         then do:
     1095            run gbl/pause.p (vint * 1000).
     1096         end.
     1097         if iInterval ne ?
     1098         then
     1099            publish "WaitFramStop".
     1100         waitfram-check-timeout().
     1101      end.
     1102      procedure WaitFramWaitFor:
     1103         define input  parameter iInterval as dec no-undo.
     1104         assign
     1105            mWaitFramStartProc   = now
     1106            mWaitFramStopUser    = no
     1107            mWaitFramStopTimeOut = no
     1108         .
     1109         block-wait:
     1110         do while not mWaitFramStop:
     1111            run WaitFramRunPause (iInterval).
     1112            if  waitfram-check-timeout()
     1113            then do:
     1114               leave block-wait.
     1115            end.
     1116         end.
     1117         run waitfram-hide.
     1118      end.
     1119   procedure waitfram-join :
     1120     define input  parameter p-line-1  as character no-undo .
     1121     define input  parameter p-line-2  as character no-undo .
     1122     define input  parameter p-line-3  as character no-undo .
     1123     define output parameter p-message as character no-undo .
     1124     do
     1125     on error undo, return error return-value
     1126     :
     1127       assign
     1128         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1129                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1130                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1131       .
     1132     end.
     1133   end procedure.
     1134   function waitfram-join-function returns character
     1135     (input p-line-1 as character
     1136     ,input p-line-2 as character
     1137     ,input p-line-3 as character
     1138     ).
     1139     define variable v-message as character no-undo .
     1140     run waitfram-join in this-procedure
     1141       (input  p-line-1
     1142       ,input  p-line-2
     1143       ,input  p-line-3
     1144       ,output v-message
     1145       ) .
     1146     return v-message .
     1147   end function .
