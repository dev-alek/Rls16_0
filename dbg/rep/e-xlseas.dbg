     1433   ASSIGN
     1434          E-prod:READ-ONLY IN FRAME F-Main        = TRUE.
     1435   ON CHOOSE OF button-prod IN FRAME F-Main
     1436   DO:
     1437       assign
     1438       cli-list = ""
     1439       .
     1440       run ref/cli-all.w ( input my-handle
     1441                     ,input  "b-sel"
     1442                     ,input 'про':U
     1443                     ,input 'все':U
     1444                     ,input 'текущие':U
     1445                     ,input ?
     1446                     ,input ",,,,,,NO,,"
     1447                    , input ?
     1448       , output cli-list ) .
     1449       if cli-list <> ""
     1450       then do:
     1451           FIND FIRST cli-prod WHERE recid( cli-prod ) = int( cli-list ) NO-LOCK .
     1452           assign
     1453           E-prod:screen-value = cli-prod.obj-name.
     1454       end.
     1455       else do:
     1456           assign
     1457           E-prod:screen-value = "".
     1458       end.
     1459   END.
     1460   if not this-procedure :persistent
     1461   then do:
     1462     message
     1463       vss-workfile vss-revision vss-description skip
     1464       "Ошибка при запуске процедуры" skip
     1465       "Данную процедуру следует запускать только с параметром persistent" skip
     1466       view-as alert-box error .
     1467     undo, return error .
     1468   end.
     1469   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1470     run mainmenu_getcntxt in my-handle
     1471       (output v-cntxt-db-num
     1472       ,output v-cntxt-userid
     1473       ,output v-cntxt-level
     1474       ,output v-cntxt-host-code-obj
     1475       ,output v-cntxt-obj-type
     1476       ,output v-cntxt-obj-code
     1477       ,output v-cntxt-db-num-obj
     1478       ,output v-cntxt-is-admin
     1479       ) .
     1480   parparentproc = my-handle.
     1481   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1482     run mainmenu_getcntxt in parparentproc
     1483       (output v-cntxp-db-num
