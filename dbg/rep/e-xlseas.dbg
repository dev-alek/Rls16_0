     1234        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1235        SIZE 34.88 BY 4.33.
     1236   DEFINE FRAME F-Main
     1237        button-prod AT ROW 12.13 COL 28.13
     1238        E-prod AT ROW 13.42 COL 3 NO-LABEL
     1239        "Выбор производителя" VIEW-AS TEXT
     1240             SIZE 20.25 BY .88 AT ROW 12.04 COL 3.13
     1241             FGCOLOR 4
     1242        RECT-1 AT ROW 11.88 COL 1.75
     1243       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1244            SIDE-LABELS NO-UNDERLINE THREE-D
     1245            AT COL 1 ROW 1
     1246            SIZE 35.88 BY 15.29.
     1247   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1248   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1249   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1250   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1251   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1252   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1253   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1254   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1255       ASSIGN adm-object-hdl = FRAME F-Main:HANDLE.
     1256   RUN ensure-broker.
     1257   THIS-PROCEDURE:ADM-DATA =
     1258        'ADM1.1~`':U +
     1259        'SmartObject~`':U +
     1260        'FRAME~`':U +
     1261        'NO ~`':U +
     1262        '~`':U +
     1263        '~`':U +
     1264        '~`':U +
     1265        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1266           + "~`":U +
     1267        'Layout,Hide-on-Init~`':U +
     1268        '~`':U +
     1269        '~`':U +
     1270        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1271        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1272            THEN "^^":U
     1273        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1274             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1275   PROCEDURE adm-apply-entry :
     1276     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1277   END PROCEDURE.
     1278   PROCEDURE adm-destroy :
     1279    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1280   END PROCEDURE.
     1281   PROCEDURE adm-disable :
     1282       DISABLE RECT-1 button-prod E-prod WITH FRAME F-Main.
     1283       RUN dispatch ('disable-fields':U).
