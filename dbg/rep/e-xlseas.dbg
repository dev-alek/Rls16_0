     1316   END PROCEDURE.
     1317   PROCEDURE adm-view :
     1318     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1319   END PROCEDURE.
     1320   PROCEDURE dispatch :
     1321       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1322       RUN broker-dispatch IN adm-broker-hdl
     1323           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1324       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1325   END PROCEDURE.
     1326   PROCEDURE ensure-broker :
     1327   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1328   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1329   DO:
     1330       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1331       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1332   END.
     1333   END PROCEDURE.
     1334   PROCEDURE get-attribute :
     1335     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1336     RUN broker-get-attribute IN adm-broker-hdl
     1337         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1338     RETURN RETURN-VALUE.
     1339   END PROCEDURE.
     1340   PROCEDURE get-attribute-list :
     1341     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1342     RUN broker-get-attribute-list IN adm-broker-hdl
     1343         (INPUT THIS-PROCEDURE,
     1344          INPUT ?,
     1345          OUTPUT p-attr-list) NO-ERROR.
     1346     RETURN.
     1347   END PROCEDURE.
     1348   PROCEDURE new-state :
     1349     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1350     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1351     RETURN.
     1352   END PROCEDURE.
     1353   PROCEDURE notify :
     1354     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1355     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1356     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1357         RETURN "ADM-ERROR":U.
     1358     RETURN.
     1359   END PROCEDURE.
     1360   PROCEDURE set-attribute-list :
     1361     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1362     RUN ensure-broker.
     1363     RUN broker-set-attribute-list IN adm-broker-hdl
     1364         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1365     RETURN.
     1366   END PROCEDURE.
     1367   PROCEDURE set-position :
     1368       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1369       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1370       IF VALID-HANDLE(adm-object-hdl) THEN
     1371       DO:
     1372           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     1373           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     1374           DO:
     1375             IF p-row = 0 THEN p-row =
     1376               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     1377             IF p-col = 0 THEN p-col =
     1378               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     1379           END.
     1380           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     1381           DO:
     1382             parent-hdl = adm-object-hdl:PARENT.
     1383             IF p-row = 0 THEN p-row =
     1384               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     1385                 parent-hdl:ROW.
     1386             IF p-col = 0 THEN p-col =
     1387               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     1388                 parent-hdl:COL.
     1389           END.
     1390           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     1391           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     1392         ASSIGN adm-object-hdl:ROW    =   p-row
     1393                adm-object-hdl:COLUMN =   p-col.
     1394       END.
     1395       RETURN.
     1396   END PROCEDURE.
     1397   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
     1398       STRING(adm-object-hdl)).
     1399   PAUSE 0 BEFORE-HIDE.
     1400   PROCEDURE adm-change-page :
