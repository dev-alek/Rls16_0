     1542             v-cntxp-out-rate        = bf-cntxp_shop.out-rate
     1543             v-cntxp-out-line-discnt = bf-cntxp_shop.out-line-discnt
     1544             v-cntxp-in-ov           = bf-cntxp_shop.in-ov
     1545             v-cntxp-in-perm         = bf-cntxp_shop.in-perm
     1546             v-cntxp-no-eq           = bf-cntxp_shop.no-eq
     1547             v-cntxp-rsrv-time       = bf-cntxp_shop.rsrv-time
     1548             v-cntxp-load-time       = bf-cntxp_shop.load-time
     1549             v-cntxp-holidays        = bf-cntxp_shop.holidays
     1550             v-cntxp-in-pay          = bf-cntxp_shop.in-pay
     1551             v-cntxp-out-pay         = bf-cntxp_shop.out-pay
     1552             v-cntxp-ret-pay         = bf-cntxp_shop.ret-pay
     1553             v-cntxp-ret-sup-pay     = bf-cntxp_shop.ret-sup-pay
     1554             v-cntxp-down-pay        = bf-cntxp_shop.down-pay
     1555             v-cntxp-inv-pay         = bf-cntxp_shop.inv-pay
     1556             v-cntxp-chk-pay         = bf-cntxp_shop.chk-pay
     1557             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
     1558             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
     1559             .
