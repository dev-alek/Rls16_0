     1512             v-cntxp-price-calc      = bf-cntxp_store.price-calc
     1513             v-cntxp-inout-price     = bf-cntxp_store.inout-price
     1514             v-cntxp-unit-cli-perm   = bf-cntxp_store.unit-cli-perm
     1515             v-cntxp-out-rate        = bf-cntxp_store.out-rate
     1516             v-cntxp-out-line-discnt = bf-cntxp_store.out-line-discnt
     1517             v-cntxp-in-ov           = bf-cntxp_store.in-ov
