        1   using Progress.Lang.*.
        2   using Ibs.Th.Gbl.Rep-Out.
        3   block-level on error undo, throw.
        4   define variable vss-revision    as character no-undo init "$Revision: 3cf06c882ecc, 131, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author $":U .
        6   define variable vss-date        as character no-undo init "$Date: Thu Feb 13 13:48:38 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: rep/r-rnk-oss.p $":U .
        9   define variable vss-description as character no-undo init "Сверка транзакций ОСС (Кубаньнефтепродукт))".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define new global shared variable g#lib-trn  as handle no-undo .
       71   define new global shared variable g#lib-trn2 as handle no-undo .
       72   define new global shared variable g#lib-trn3 as handle no-undo .
       73   define new global shared variable g#lib-trn4 as handle no-undo .
       74   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       75   procedure factord :
       76     define input  parameter p-fact-date            as date    no-undo .
       77     define input  parameter p-fact-time            as integer no-undo .
       78     define input  parameter p-fact-num             as integer no-undo .
       79     define input  parameter p-shift-date           as date    no-undo .
       80     define input  parameter p-shift-num            as integer no-undo .
       81     define input  parameter p-shift-on             as logical no-undo .
       82     define output parameter p-fact-order           as decimal no-undo .
       83     define output parameter p-shift-end-fact-order as decimal no-undo .
       84     define output parameter p-day-end-fact-order   as decimal no-undo .
       85     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
       86     if p-fact-date = ?
       87     then do:
       88       return error "Не указана фактическая дата" .
       89     end.
       90     define variable v-fact-date-num as integer no-undo .
       91     assign
       92       v-fact-date-num = integer(p-fact-date)
       93     .
       94     if p-fact-num = ?
       95     or p-fact-num = 0
       96     then do:
       97       return error "Не задан p-fact-num " + string(p-fact-num) .
       98     end.
       99     if p-fact-num < 0
      100     then do:
      101       return error "Отрицательный fact-num " + string(p-fact-num) .
      102     end.
      103     if p-fact-num >= 100000000
      104     then do:
      105       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      106     end.
      107     if p-shift-on = true
      108     then do:
      109       if p-shift-date = ?
      110       then do:
      111         return error "Не задана дата смены" .
      112       end.
      113       if p-shift-num = ?
      114       or p-shift-num = 0
      115       then do:
      116         return error "Не задан номер смены" .
      117       end.
      118     end.
      119     else do:
      120       assign
      121         p-shift-date = p-fact-date
      122         p-shift-num  = 24
      123       .
      124     end.
      125     define variable v-shift-offset as integer no-undo .
      126     if p-shift-date = p-fact-date
      127     then do:
      128       assign
      129         v-shift-offset = 1
      130       .
      131     end.
      132     if p-shift-date < p-fact-date
      133     then do:
      134       assign
      135         v-shift-offset = 0
      136       .
      137     end.
      138     if p-shift-date > p-fact-date
      139     then do:
      140       message
      141         vss-workfile vss-revision vss-description skip
      142         "Неправильная дата закрытия смены" skip
      143         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      144         view-as alert-box error .
      145       undo, return error
      146         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      147           ,string(p-fact-date, '99/99/9999':U)
      148           ,string(p-shift-date, '99/99/9999':U)
      149           )
      150       .
      151     end.
      152     if p-shift-num < 1
      153     or p-shift-num > 24
      154     then do:
      155       message
      156         vss-workfile vss-revision vss-description skip
      157         "Неправильный номер смены" skip
      158         "p-shift-num" p-shift-num skip
      159         view-as alert-box error .
      160       undo, return error return-value .
      161     end.
      162     assign
      163       p-fact-order           = v-fact-date-num
      164                              + v-shift-offset * 0.5
      165                              + p-shift-num    * 0.02 - 0.01
      166                              + p-fact-num     * 0.0000000001
      167       p-shift-end-fact-order = v-fact-date-num
      168                              + v-shift-offset * 0.5
      169                              + p-shift-num    * 0.02
      170       p-day-end-fact-order   = v-fact-date-num
      171                              + 0.99
      172     .
      173     if p-fact-order           <= v-fact-date-num
      174     or p-shift-end-fact-order <= v-fact-date-num
      175     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      176     or p-shift-end-fact-order >= p-day-end-fact-order
      177     then do:
      178       message
      179         vss-workfile vss-revision vss-description skip
      180         "Внутренняя ошибка при генерации фактического номера" skip
      181         "p-fact-date"            p-fact-date            skip
      182         "p-fact-time"            p-fact-time            skip
      183         "p-fact-num"             p-fact-num             skip
      184         "p-shift-date"           p-shift-date           skip
      185         "p-shift-num"            p-shift-num            skip
      186         "p-shift-on"             p-shift-on             skip
      187         "p-shift-end-fact-order" p-shift-end-fact-order skip
      188         "p-day-end-fact-order"   p-day-end-fact-order   skip
      189         "v-fact-date-num"        v-fact-date-num        skip
      190         view-as alert-box error .
      191       undo, return error return-value .
      192     end.
      193   end procedure.
      194   procedure day-begin-fact-order :
      195     define input  parameter p-fact-date            as date    no-undo .
      196     define output parameter p-day-begin-fact-order as decimal no-undo .
      197     do
      198     on error undo, return error return-value
      199     :
      200       if p-fact-date = ?
      201       then do:
      202         assign
      203           p-day-begin-fact-order = 0
      204         .
      205       end.
      206       else do:
      207         assign
      208           p-day-begin-fact-order = integer(p-fact-date)
      209         .
      210       end.
      211     end.
      212   end procedure.
      213   procedure factord-max-fact-order :
      214     define output parameter p-max-fact-order as decimal   no-undo .
      215     do
      216     on error undo, return error return-value
      217     :
      218       run day-begin-fact-order in this-procedure
      219         (input  date(1, 1, 5000)
      220         ,output p-max-fact-order
      221         ) .
      222     end.
      223   end procedure.
      224   procedure factord-cut-archive :
      225     define input  parameter p-obj-type             as character no-undo .
      226     define input  parameter p-obj-code             as integer   no-undo .
      227     define input  parameter p-fact-date            as date      no-undo .
      228     define output parameter p-shift-on             as logical   no-undo .
      229     define output parameter p-shift-date           as date      no-undo .
      230     define output parameter p-shift-num            as integer   no-undo .
      231     define output parameter p-day-end-fact-order   as decimal   no-undo .
      232     define output parameter p-shift-end-fact-order as decimal   no-undo .
      233     define variable v-fact-order as decimal   no-undo .
      234     define buffer buf_shift-obj for ub.shift-obj .
      235     do
      236     on error undo, return error return-value
      237     :
      238   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      239   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      240     (input  p-obj-type
      241     ,input  p-obj-code
      242     ,input  'shift-on=request'
      243     ,output p-shift-on
      244     ) no-error .
      245       if error-status :error
      246       then do:
      247         message
      248           vss-workfile vss-revision vss-description skip
      249           "Ошибка при определении атрибута объекта" skip
      250           "Объект" p-obj-type p-obj-code skip
      251           error-status :get-message(1) skip
      252           return-value skip
      253           view-as alert-box error .
      254         undo, return error return-value .
      255       end.
      256       if p-shift-on = false
      257       then do:
      258         assign
      259           p-shift-date               = ?
      260           p-shift-num                = 0
      261         .
      262       end.
      263       else do:
      264         find first buf_shift-obj share-lock
      265           where buf_shift-obj.obj-type   = p-obj-type
      266             and buf_shift-obj.obj-code   = p-obj-code
      267             and buf_shift-obj.shift-date > p-fact-date
      268           use-index pi
      269           no-error .
      270         if not available buf_shift-obj
      271         or buf_shift-obj.status_ <> 'зкр':U
      272         then do:
      273           message
      274             vss-workfile vss-revision vss-description skip
      275             "Невозможно вычислить последнюю смену" skip
      276             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      277             "Объект" p-obj-type p-obj-code skip
      278             "Дата" p-fact-date skip
      279             view-as alert-box error .
      280           undo, return error return-value .
      281         end.
      282         find last buf_shift-obj share-lock
      283           where buf_shift-obj.obj-type = p-obj-type
      284             and buf_shift-obj.obj-code = p-obj-code
      285             and buf_shift-obj.shift-date <= p-fact-date
      286           use-index pi
      287           no-error .
      288         if available buf_shift-obj
      289         then do:
      290           if  buf_shift-obj.status_ = 'зкр':U
      291           then do:
      292             assign
      293               p-shift-date = buf_shift-obj.shift-date
      294               p-shift-num  = buf_shift-obj.shift-num
      295             .
      296           end.
      297           else do:
      298             message
      299               vss-workfile vss-revision vss-description skip
      300               "Невозможно вычислить последнюю смену" skip
      301               "Статус смены отличен от статуса" 'зкр':U skip
      302               "Объект" p-obj-type p-obj-code skip
      303               "Дата" p-fact-date skip
      304               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      305               view-as alert-box error .
      306             undo, return error return-value .
      307           end.
      308         end.
      309         else do:
      310           assign
      311             p-shift-date = p-fact-date - 1
      312             p-shift-num  = 1
      313           .
      314         end.
      315       end.
      316       run factord in this-procedure
      317         (input  p-fact-date
      318         ,input  1
      319         ,input  1
      320         ,input  p-shift-date
      321         ,input  p-shift-num
      322         ,input  p-shift-on
      323         ,output v-fact-order
      324         ,output p-shift-end-fact-order
      325         ,output p-day-end-fact-order
      326         ) no-error .
      327       if error-status :error
      328       then do:
      329         message
      330           vss-workfile vss-revision vss-description skip
      331           "Ошибка при вызове процедуры factord"
      332           error-status :get-message(1) skip
      333           return-value skip
      334           view-as alert-box error .
      335         undo, return error return-value .
      336       end.
      337     end.
      338   end procedure.
      339   procedure factord-lock-shift :
      340     define input  parameter p-obj-type  as character no-undo .
      341     define input  parameter p-obj-code  as integer   no-undo .
      342     define input  parameter p-fact-date as date      no-undo .
      343     define parameter buffer buf_shift-obj for ub.shift-obj .
      344     define variable v-shift-on      as logical   no-undo .
      345     define variable v-extra-message as character no-undo .
      346     define variable v-error as character no-undo .
      347     do
      348     on error undo, return error return-value
      349     :
      350   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      351   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      352     (input  p-obj-type
      353     ,input  p-obj-code
      354     ,input  'shift-on=request'
      355     ,output v-shift-on
      356     ) no-error .
      357       if error-status :error
      358       then do:
      359         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      360         undo, return error v-error .
      361       end.
      362       if v-shift-on = true
      363       then do:
      364         find first buf_shift-obj share-lock
      365           where buf_shift-obj.obj-type   = p-obj-type
      366             and buf_shift-obj.obj-code   = p-obj-code
      367             and buf_shift-obj.shift-date > p-fact-date
      368           use-index pi
      369           no-error .
      370         if not available buf_shift-obj
      371         or buf_shift-obj.status_ <> 'зкр':U
      372         then do:
      373           find last buf_shift-obj
      374             where buf_shift-obj.obj-type = p-obj-type
      375               and buf_shift-obj.obj-code = p-obj-code
      376               and buf_shift-obj.status_  = 'зкр':U
      377             use-index stts
      378             no-error .
      379           if available buf_shift-obj
      380           then do:
      381             assign
      382               v-extra-message =
      383                     substitute("Дата начала последеней закрытой смены на объекте &1"
      384                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      385                               )
      386             .
      387           end.
      388           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      389           undo, return error v-error .
      390         end.
      391       end.
      392     end.
      393   end procedure.
      394   procedure factord-end-day :
      395     define input  parameter p-fact-date            as date    no-undo .
      396     define output parameter p-day-end-fact-order   as decimal no-undo .
      397     do
      398     on error undo, return error return-value
      399     :
      400       if p-fact-date = ?
      401       then do:
      402         return error "Не указана фактическая дата" .
      403       end.
      404       assign
      405         p-day-end-fact-order = integer(p-fact-date) + 0.99
      406       .
      407     end.
      408   end procedure.
      409   procedure factord-to-date :
      410     define input  parameter p-fact-order as decimal no-undo .
      411     define output parameter p-fact-date  as date    no-undo .
      412     define variable v-ref-date  as date      no-undo .
      413     define variable v-ref-delta as integer   no-undo .
      414     do
      415     on error undo, return error return-value
      416     :
      417       if p-fact-order = ?
      418       or p-fact-order = 0
      419       then do:
      420         return error "Не указан fact-order" .
      421       end.
      422       assign
      423         v-ref-date  = date(1, 1, 2000)
      424       .
      425       assign
      426         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      427       .
      428       assign
      429         p-fact-date = v-ref-date + v-ref-delta
      430       .
      431     end.
      432   end procedure.
      433   procedure factord-to-fact-num :
      434     define input  parameter p-fact-order as decimal no-undo .
      435     define output parameter p-fact-num   as integer no-undo .
      436     define variable v-fact-order-trunc as decimal no-undo .
      437     do
      438     on error undo, return error return-value
      439     :
      440       if p-fact-order = ?
      441       or p-fact-order = 0
      442       then do:
      443         return error "Не указан fact-order" .
      444       end.
      445       assign
      446        v-fact-order-trunc = truncate(p-fact-order, 2)
      447       .
      448       assign
      449         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      450       .
      451     end.
      452   end procedure.
      453   procedure factord-to-shift-num :
      454     define input  parameter p-fact-order as decimal no-undo .
      455     define output parameter p-shift-num   as integer no-undo .
      456     define variable  p-shift-numd  as decimal   no-undo .
      457     define variable v-fact-order-trunc as decimal no-undo .
      458     do
      459     on error undo, return error return-value
      460     :
      461       if p-fact-order = ?
      462       or p-fact-order = 0
      463       then do:
      464         return error "Не указан fact-order" .
      465       end.
      466       assign
      467        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      468       .
      469       if v-fact-order-trunc < 0.5 then do:
      470         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      471       end.
      472       assign
      473         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      474         .
      475        assign
      476         p-shift-num = truncate (p-shift-numd , 0)
      477       .
      478     end.
      479   end procedure.
      480   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      481   define  shared variable gdsgrp_recids      as character no-undo.
      482   define  shared variable fin-schet-recid    as character no-undo.
      483   define  shared variable v-d-report-handle  as handle    no-undo .
      484   define  shared temp-table g#customer no-undo
      485       field obj-type like ub.clients.obj-type
      486       field obj-code like ub.clients.obj-code
      487       field obj-name like ub.clients.obj-name
      488       index pi is unique primary obj-type obj-code.
      489   define  shared temp-table g#cli no-undo
      490       field obj-type like ub.clients.obj-type
      491       field obj-code like ub.clients.obj-code
      492       field obj-name like ub.clients.obj-name
      493       index pi is unique primary obj-type obj-code.
      494   define  shared temp-table tmp#grp no-undo
      495       field node-code like ub.gds-grp.node-code
      496       field grp-name like ub.gds-grp.node-name
      497       field lvl-num  like ub.gds-grp.lvl-num
      498       field is-term  like ub.gds-grp.is-term
      499       index pi is unique primary grp-name node-code
      500       index i-node-code    node-code
      501       index level-num   lvl-num  grp-name
      502       index is-term is-term  grp-name
      503       .
      504   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      505   define  shared temp-table gds-list no-undo like ub.goods
      506     field qnty   as decimal
      507     field to-del as logical
      508     field order-num as integer
      509     field to-sel as logical
      510     field promo-code as character
      511     field ActionId  as int64
      512     field db-num as integer
      513     index art  is primary unique artic prod-type prod-code
      514     index code is         unique gds-code
      515     index oi order-num
      516     index isel to-sel
      517     .
      518   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      519   define   shared  temp-table gds-list-hist no-undo
      520   field list-table as character
      521   field id as integer
