      541   def
      542    shared
      543   temp-table  obj-list no-undo
      544     field obj-type like ub.clients.obj-type
      545     field obj-code like ub.clients.obj-code
      546     field obj-name like ub.clients.obj-name
      547     field obj-id   as integer
      548     field db-num   as integer
      549     index pi is primary unique obj-id
      550     index ie1 obj-type obj-code
      551     index ie2 obj-name
      552   .
      553   procedure create_obj-list :
      554      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      555      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      556      do
      557      on error undo, return error return-value
      558      :
      559         define buffer cli-obj for ub.clients .
      560         define variable p-var as integer no-undo .
      561         define buffer buf_obj-list for obj-list .
      562         find last buf_obj-list  use-index pi no-error .
      563         if available buf_obj-list
      564         then
      565            p-var = buf_obj-list.obj-id + 1.
      566         else
      567            p-var = 1.
      568         find first cli-obj where
      569                   cli-obj.obj-type = p-obj-type
      570               and cli-obj.obj-code = p-obj-code
      571         no-lock no-error.
      572         if available cli-obj
      573         then do:
      574            create buf_obj-list.
      575            assign
      576               buf_obj-list.obj-id   = p-var
      577               buf_obj-list.obj-code = cli-obj.obj-code
      578               buf_obj-list.obj-type = cli-obj.obj-type
      579               buf_obj-list.obj-name = cli-obj.obj-name
      580               buf_obj-list.db-num   = cli-obj.db-num
      581            .
      582         end.
      583      end.
      584   end.
