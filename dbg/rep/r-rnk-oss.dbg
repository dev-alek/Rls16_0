      998   def input parameter xTog-obj   as log no-undo.
      999   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     1000   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     1001   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     1002   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     1003   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     1004   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     1005   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     1006   def var              Fact-orderS   as char  no-undo.
     1007   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     1008      Assign
     1009         Fact-order   = 0
     1010         Quantity     = 0
     1011         Coast_R      = 0
     1012         Coast_V      = 0
     1013         VAT_R        = 0
     1014         VAT_V        = 0 .
     1015    x-date-start-t  = x-date-start + 1 .
     1016   IF x-date-end = date('') then DO:
     1017      Fact-order = 0 .
     1018      for each obj-list
     1019          where  ( not xtog-obj or
     1020                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     1021                 no-lock :
     1022         if  x-tog-shift = false then do:
     1023                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1024                               ub.stk-tot.Fact-date <=  x-date-start
     1025                               and ub.stk-tot.shift-num = 0
     1026                               USE-INDEX fact-date no-lock no-error .
     1027              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1028         End.
     1029         Else  DO :
     1030             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1031              (ub.stk-tot.shift-date  = x-date-start-t and
     1032               ub.stk-tot.shift-num  < x-shift-start or
     1033               ub.stk-tot.shift-date  < x-date-start-t  )
     1034               and ub.stk-tot.shift-num  > 0
     1035               USE-INDEX Shift-num no-lock no-error .
     1036            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1037           END.
     1038       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     1039     End.
     1040   End.
     1041   Else DO:
     1042     For each obj-list  WHERE
     1043        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     1044         no-lock :
     1045      IF  x-TOG-Shift = False Then DO:
     1046          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1047               ub.stk-tot.Fact-date <= x-date-end
     1048               and ub.stk-tot.shift-num = 0
     1049               USE-INDEX fact-date no-lock no-error.
     1050          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1051      END.
     1052      Else DO:
     1053           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1054               (ub.stk-tot.shift-date  = x-date-end and
     1055               ub.stk-tot.shift-num  <= x-shift-end or
     1056               ub.stk-tot.shift-date  < x-date-end       ) and
     1057               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     1058               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1059       End.
     1060       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     1061     End.
     1062   End.
     1063   END PROCEDURE.
     1064   procedure get-factord:
     1065       define input parameter  p-obj-type       as character no-undo.
     1066       define input parameter  p-obj-code       as integer   no-undo.
     1067       define input parameter  p-shift-date     as date    format "99/99/9999" no-undo.
     1068       define input parameter  p-shift-num      as integer   no-undo.
     1069       define input parameter  p-type           as integer   no-undo.
     1070       define output parameter p-factord        as decimal   no-undo.
     1071       define variable tmp as decimal no-undo.
     1072       if p-type = 1 and p-shift-num > 0 then do:
     1073           run ostatok(
     1074               p-obj-code,
     1075               p-obj-type,
     1076               true,
     1077               p-shift-date - 1,
     1078               date(''),
     1079               p-shift-num,
     1080               p-shift-num,
     1081               'cost':U,
     1082               '##,##':U,
     1083               true,
     1084               output tmp,
     1085               output tmp,
     1086               output tmp,
     1087               output tmp,
     1088               output tmp,
     1089               output p-factord
     1090           ).
     1091       end.
     1092       else if p-type = 2 and p-shift-num > 0 then
     1093           run ostatok(
     1094               p-obj-code,
     1095               p-obj-type,
     1096               true,
     1097               p-shift-date,
     1098               date(''),
     1099               p-shift-num,
     1100               p-shift-num,
     1101               'cost':U,
     1102               '##,##':U,
     1103               true,
     1104               output tmp,
     1105               output tmp,
     1106               output tmp,
     1107               output tmp,
     1108               output tmp,
     1109               output p-factord
     1110           ).
     1111       else if p-type = 1 then
     1112           run day-begin-fact-order(p-shift-date, output p-factord).
     1113       else if p-type = 2 then
     1114           run factord-end-day(p-shift-date, output p-factord).
     1115   end.
     1116   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1117   define variable v-waitfram-action01         as character   no-undo .
     1118   define variable v-waitfram-action02         as character   no-undo .
     1119   define variable v-waitfram-action03         as character   no-undo .
     1120   define variable mWaitFramTextBeg            as character   no-undo.
     1121   define variable mWaitFramTextEnd            as character   no-undo.
     1122   define variable mWaitFramView               as logical     no-undo.
     1123   define variable mWaitProcEvent              as logical     no-undo init yes.
     1124   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1125   define variable mWaitFramStop               as logical     no-undo.
     1126   define variable mWaitFramStopUser           as logical     no-undo.
     1127   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1128   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1129   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1130   define button B-WaitFramStop auto-end-key
     1131        label "Стоп"
     1132        size 10 by 1 tooltip "Остоновить процесс".
     1133   define button B-viewProcInfo
     1134        label "Информация"
     1135        size 15 by 1 tooltip "Информация о процесс".
     1136   define frame waitfram
     1137     v-waitfram-action01 format "x(72)" no-label skip
     1138     v-waitfram-action02 format "x(72)" no-label skip
     1139     v-waitfram-action03 format "x(72)" no-label skip
     1140     B-viewProcInfo
     1141     B-WaitFramStop at row 4 col 30
     1142     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1143     .
     1144   define new global shared variable mBatchMode as logical no-undo init ?.
     1145   define variable mFramBachModHandle as handle no-undo.
     1146   mFramBachModHandle = frame waitfram:handle.
     1147   define variable mFameOldVis as logical no-undo.
     1148   define variable mVisCUrentVin as logical no-undo.
     1149   if session:batch-mode
     1150   then
     1151      mBatchMode = yes.
     1152   if mBatchMode = ? then do:
     1153     mVisCUrentVin = current-window:visible.
     1154     mFameOldVis = mFramBachModHandle:visible.
     1155     mFramBachModHandle:visible  = yes.
     1156     mBatchMode = mFramBachModHandle:visible ne yes.
     1157     mFramBachModHandle:visible = mFameOldVis.
     1158     current-window:visible = mVisCUrentVin.
     1159   end.
     1160    if  log-manager:logfile-name ne ?
     1161     then DO:
     1162         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1163         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1164         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1165     end.
     1166   on choose of B-WaitFramStop in frame waitfram
     1167   do:
     1168     mWaitFramStop = yes.
     1169     mWaitFramStopUser = yes.
     1170   end.
     1171   function waitfram-check-timeout returns logical():
     1172      define variable vtime as int64 no-undo.
     1173      if mWaitFramStopTimeOut
     1174      then
     1175         return yes.
     1176      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1177      if     mWaitFramTimeOut ne ?
     1178         and mWaitFramTimeOut ne 0
     1179         and mWaitFramTimeOut lt vtime
     1180      then do:
     1181         mWaitFramStopTimeOut = yes.
     1182      end.
     1183      return mWaitFramStopTimeOut.
     1184   end.
     1185   procedure waitfram-hide :
     1186     if not session:batch-mode
     1187     then do
     1188     on error undo, return error return-value
     1189     :
     1190       pause 0 before-hide .
     1191       if not mBatchMode then
     1192         hide frame waitfram .
     1193     if     not mWaitFramView
     1194        and mWaitProcEvent
     1195     then
     1196       process events .
     1197     end.
     1198   end procedure.
     1199   procedure waitfram-show :
     1200     define input  parameter p-message as character no-undo .
     1201     define variable v-left-margin as integer   no-undo .
     1202     if not session:batch-mode
     1203     then do
     1204     on error undo, return error return-value
     1205     :
     1206       if length(p-message) <= 70 then do:
     1207         assign
     1208           v-left-margin = integer((70 - length(p-message)) / 2)
     1209         .
     1210         assign
     1211           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1212         .
     1213         assign
     1214           v-waitfram-action01 = " "
     1215           v-waitfram-action02 = " "
     1216                                    + fill(" ", v-left-margin)
     1217                                    + p-message
     1218           v-waitfram-action03 = " "
     1219         .
     1220       end.
     1221       else do:
     1222         define variable vRindex1 as integer no-undo.
     1223         define variable vRindex2 as integer no-undo.
     1224         vRindex1 = r-index(p-message," ",70).
     1225         if vRindex1 = 0
     1226         then
     1227            vRindex1 = 70.
     1228         if length(p-message)  <= vRindex1 + 70 then do:
     1229           assign
     1230             v-waitfram-action01 = " "
     1231             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1232             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1233           .
     1234         end.
     1235         else do:
     1236           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1237           if vRindex2 <= vRindex1
     1238           then
     1239              vRindex2 = vRindex1 + 70.
     1240           assign
     1241             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1242             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1243             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1244           .
     1245         end.
     1246       end.
     1247       B-viewProcInfo:visible   in frame waitfram = no.
     1248       B-viewProcInfo:sensitive in frame waitfram = no.
     1249       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1250       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1251       if  (   mWaitFramView
     1252          or  mWaitProcEvent)
     1253          and not mBatchMode
     1254       then
     1255          display
     1256             v-waitfram-action01 skip
     1257             v-waitfram-action02 skip
     1258             v-waitfram-action03 skip
     1259          with frame waitfram .
     1260       if     mWaitFramView
     1261          then do:
     1262             if     mWaitFramInterval ne ?
     1263                and not mBatchMode
     1264             then
     1265                wait-for go of frame waitfram pause mWaitFramInterval.
     1266          end.
     1267          else
     1268             if     mWaitProcEvent
     1269                and not mBatchMode
     1270             then
     1271                process events .
     1272     end.
     1273   end procedure.
     1274      procedure waitfram-show-this:
     1275         define input  parameter iInterval as int64 no-undo.
     1276         define variable vtime as int64 no-undo.
     1277         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1278         mWaitFramInterval = iInterval.
     1279         run waitfram-show (substitute("&1&2 &3&4" ,
     1280                                       mWaitFramTextBeg ,
     1281                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1282                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1283                                       mWaitFramTextEnd
     1284                                      )
     1285                           ).
     1286      end.
     1287      procedure WaitFramRunPause:
     1288         define input  parameter iInterval as dec no-undo.
     1289         define variable vStart  as datetime-tz no-undo.
     1290         define variable vend    as datetime-tz no-undo.
     1291         define variable vint as int64 no-undo.
     1292         define variable vOk as logical no-undo.
     1293         vStart = now.
     1294         vend   = vStart.
     1295         publish "WaitFramPause" (iInterval,output vOk).
     1296         vend   =  now.
     1297         vint = vend - vStart.
     1298         vint = iInterval - vint / 1000.
     1299         if     not mWaitFramStop
     1300            and (   vint > 0
     1301                 or (    not vOk
     1302                     and iInterval eq ?
     1303                     )
     1304                 )
     1305         then
     1306            run waitfram-show-this (iInterval).
     1307         vend   =  now.
     1308         vint = vend - vStart.
     1309         vint = iInterval - vint / 1000.
     1310         if     not mWaitFramStop
     1311            and vint > 0
     1312         then do:
     1313            run gbl/pause.p (vint * 1000).
     1314         end.
     1315         if iInterval ne ?
     1316         then
     1317            publish "WaitFramStop".
     1318         waitfram-check-timeout().
     1319      end.
     1320      procedure WaitFramWaitFor:
     1321         define input  parameter iInterval as dec no-undo.
     1322         assign
     1323            mWaitFramStartProc   = now
     1324            mWaitFramStopUser    = no
     1325            mWaitFramStopTimeOut = no
     1326         .
     1327         block-wait:
     1328         do while not mWaitFramStop:
     1329            run WaitFramRunPause (iInterval).
     1330            if  waitfram-check-timeout()
     1331            then do:
     1332               leave block-wait.
     1333            end.
     1334         end.
     1335         run waitfram-hide.
     1336      end.
     1337   procedure waitfram-join :
     1338     define input  parameter p-line-1  as character no-undo .
     1339     define input  parameter p-line-2  as character no-undo .
     1340     define input  parameter p-line-3  as character no-undo .
     1341     define output parameter p-message as character no-undo .
     1342     do
     1343     on error undo, return error return-value
     1344     :
     1345       assign
     1346         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1347                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1348                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1349       .
     1350     end.
     1351   end procedure.
     1352   function waitfram-join-function returns character
     1353     (input p-line-1 as character
     1354     ,input p-line-2 as character
     1355     ,input p-line-3 as character
     1356     ).
     1357     define variable v-message as character no-undo .
     1358     run waitfram-join in this-procedure
     1359       (input  p-line-1
     1360       ,input  p-line-2
     1361       ,input  p-line-3
     1362       ,output v-message
     1363       ) .
     1364     return v-message .
     1365   end function .
     1366   define variable g#report-num as integer   no-undo .
     1367   run get-report-num  in my-handle ( output g#report-num ).
     1368   def stream ListStream .
     1369   output stream ListStream to value( string( session:temp-directory +
     1370                                        "rpt" + string( g#report-num ) ) )
     1371                                        page-size 62 .
     1372   if x-TOG-Shift then do:
     1373         for each obj-list
     1374             :
     1375             for each ub.chk-doc
     1376             where  ub.chk-doc.obj-type = obj-list.obj-type
     1377             and   ub.chk-doc.obj-code = obj-list.obj-code
     1378             and   (ub.chk-doc.shift-date > x-Date-Start or
     1379             (ub.chk-doc.shift-date = x-Date-Start and ub.chk-doc.shift-num >= x-Shift-Start))
     1380             and   (ub.chk-doc.shift-date < x-Date-End or
     1381             (ub.chk-doc.shift-date = x-Date-End and ub.chk-doc.shift-num <= x-Shift-End))
     1382                  :
     1383                  for each ub.chk-pay-attr
     1384                      where   ub.chk-pay-attr.doc-code = ub.chk-doc.doc-code
     1385                      and     ub.chk-pay-attr.attr-code ="RTA_RefundExport"
     1386                      :
     1387                      PUT  stream ListStream UNFORMATTED  ub.chk-pay-attr.attr-value skip .
     1388                      end.
     1389              end.
     1390         end.
     1391   end.
     1392   else do:
     1393       for each obj-list
     1394           :
     1395           for each ub.chk-doc
     1396           where  ub.chk-doc.obj-type = obj-list.obj-type
     1397           and   ub.chk-doc.obj-code = obj-list.obj-code
     1398           and   ub.chk-doc.chk-date >= x-Date-Start
     1399           and   ub.chk-doc.chk-date <= x-Date-End
     1400               :
     1401               for each ub.chk-pay-attr
     1402               where   ub.chk-pay-attr.doc-code = ub.chk-doc.doc-code
     1403               and     ub.chk-pay-attr.attr-code ="RTA_RefundExport"
     1404                   :
     1405                   PUT  stream ListStream UNFORMATTED  ub.chk-pay-attr.attr-value skip .
     1406               end.
     1407           end.
     1408       end.
     1409   end.
     1410   output stream ListStream close .
     1411   define variable v-user-action as character no-undo .
     1412   define variable v-printed as logical   no-undo .
     1413   define variable DisabledOptions as integer   no-undo .
     1414   DisabledOptions = 0 .
     1415   run gbl/prnfilen.w
     1416     (input  ""
     1417     ,input  DisabledOptions
     1418     ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     1419     ,input  7
     1420     ,output v-user-action
     1421     ,output v-printed
     1422     ) .
