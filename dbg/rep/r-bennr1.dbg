      867   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      868   define variable v-waitfram-action01         as character   no-undo .
      869   define variable v-waitfram-action02         as character   no-undo .
      870   define variable v-waitfram-action03         as character   no-undo .
      871   define variable mWaitFramTextBeg            as character   no-undo.
      872   define variable mWaitFramTextEnd            as character   no-undo.
      873   define variable mWaitFramView               as logical     no-undo.
      874   define variable mWaitProcEvent              as logical     no-undo init yes.
      875   define variable mWaitFramInterval           as integer     no-undo init 1 .
      876   define variable mWaitFramStop               as logical     no-undo.
      877   define variable mWaitFramStopUser           as logical     no-undo.
      878   define variable mWaitFramStopTimeOut        as logical     no-undo.
      879   define variable mWaitFramStartProc          as datetime-tz no-undo.
      880   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      881   define button B-WaitFramStop auto-end-key
      882        label "Стоп"
      883        size 10 by 1 tooltip "Остоновить процесс".
      884   define button B-viewProcInfo
      885        label "Информация"
      886        size 15 by 1 tooltip "Информация о процесс".
      887   define frame waitfram
      888     v-waitfram-action01 format "x(72)" no-label skip
      889     v-waitfram-action02 format "x(72)" no-label skip
      890     v-waitfram-action03 format "x(72)" no-label skip
      891     B-viewProcInfo
      892     B-WaitFramStop at row 4 col 30
      893     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      894     .
      895   define new global shared variable mBatchMode as logical no-undo init ?.
      896   define variable mFramBachModHandle as handle no-undo.
      897   mFramBachModHandle = frame waitfram:handle.
      898   define variable mFameOldVis as logical no-undo.
      899   define variable mVisCUrentVin as logical no-undo.
      900   if session:batch-mode
      901   then
      902      mBatchMode = yes.
      903   if mBatchMode = ? then do:
      904     mVisCUrentVin = current-window:visible.
      905     mFameOldVis = mFramBachModHandle:visible.
      906     mFramBachModHandle:visible  = yes.
      907     mBatchMode = mFramBachModHandle:visible ne yes.
      908     mFramBachModHandle:visible = mFameOldVis.
      909     current-window:visible = mVisCUrentVin.
      910   end.
      911    if  log-manager:logfile-name ne ?
      912     then DO:
      913         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      914         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      915         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      916     end.
      917   on choose of B-WaitFramStop in frame waitfram
      918   do:
      919     mWaitFramStop = yes.
      920     mWaitFramStopUser = yes.
      921   end.
      922   function waitfram-check-timeout returns logical():
      923      define variable vtime as int64 no-undo.
      924      if mWaitFramStopTimeOut
      925      then
      926         return yes.
      927      vtime = ( now - mWaitFramStartProc ) / 1000 .
      928      if     mWaitFramTimeOut ne ?
      929         and mWaitFramTimeOut ne 0
      930         and mWaitFramTimeOut lt vtime
      931      then do:
      932         mWaitFramStopTimeOut = yes.
      933      end.
      934      return mWaitFramStopTimeOut.
      935   end.
      936   procedure waitfram-hide :
      937     if not session:batch-mode
      938     then do
      939     on error undo, return error return-value
      940     :
      941       pause 0 before-hide .
      942       if not mBatchMode then
      943         hide frame waitfram .
      944     if     not mWaitFramView
      945        and mWaitProcEvent
      946     then
      947       process events .
      948     end.
      949   end procedure.
      950   procedure waitfram-show :
      951     define input  parameter p-message as character no-undo .
      952     define variable v-left-margin as integer   no-undo .
      953     if not session:batch-mode
      954     then do
      955     on error undo, return error return-value
      956     :
      957       if length(p-message) <= 70 then do:
      958         assign
      959           v-left-margin = integer((70 - length(p-message)) / 2)
      960         .
      961         assign
      962           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      963         .
      964         assign
      965           v-waitfram-action01 = " "
      966           v-waitfram-action02 = " "
      967                                    + fill(" ", v-left-margin)
      968                                    + p-message
      969           v-waitfram-action03 = " "
      970         .
      971       end.
      972       else do:
      973         define variable vRindex1 as integer no-undo.
      974         define variable vRindex2 as integer no-undo.
      975         vRindex1 = r-index(p-message," ",70).
      976         if vRindex1 = 0
      977         then
      978            vRindex1 = 70.
      979         if length(p-message)  <= vRindex1 + 70 then do:
      980           assign
      981             v-waitfram-action01 = " "
      982             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      983             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      984           .
      985         end.
      986         else do:
      987           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      988           if vRindex2 <= vRindex1
      989           then
      990              vRindex2 = vRindex1 + 70.
      991           assign
      992             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      993             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      994             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      995           .
      996         end.
      997       end.
      998       B-viewProcInfo:visible   in frame waitfram = no.
      999       B-viewProcInfo:sensitive in frame waitfram = no.
     1000       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1001       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1002       if  (   mWaitFramView
     1003          or  mWaitProcEvent)
     1004          and not mBatchMode
     1005       then
     1006          display
     1007             v-waitfram-action01 skip
     1008             v-waitfram-action02 skip
     1009             v-waitfram-action03 skip
     1010          with frame waitfram .
     1011       if     mWaitFramView
     1012          then do:
     1013             if     mWaitFramInterval ne ?
     1014                and not mBatchMode
     1015             then
     1016                wait-for go of frame waitfram pause mWaitFramInterval.
     1017          end.
     1018          else
     1019             if     mWaitProcEvent
     1020                and not mBatchMode
     1021             then
     1022                process events .
     1023     end.
     1024   end procedure.
     1025      procedure waitfram-show-this:
     1026         define input  parameter iInterval as int64 no-undo.
     1027         define variable vtime as int64 no-undo.
     1028         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1029         mWaitFramInterval = iInterval.
     1030         run waitfram-show (substitute("&1&2 &3&4" ,
     1031                                       mWaitFramTextBeg ,
     1032                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1033                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1034                                       mWaitFramTextEnd
     1035                                      )
     1036                           ).
     1037      end.
     1038      procedure WaitFramRunPause:
     1039         define input  parameter iInterval as dec no-undo.
     1040         define variable vStart  as datetime-tz no-undo.
     1041         define variable vend    as datetime-tz no-undo.
     1042         define variable vint as int64 no-undo.
     1043         define variable vOk as logical no-undo.
     1044         vStart = now.
     1045         vend   = vStart.
     1046         publish "WaitFramPause" (iInterval,output vOk).
     1047         vend   =  now.
     1048         vint = vend - vStart.
     1049         vint = iInterval - vint / 1000.
     1050         if     not mWaitFramStop
     1051            and (   vint > 0
     1052                 or (    not vOk
     1053                     and iInterval eq ?
     1054                     )
     1055                 )
     1056         then
     1057            run waitfram-show-this (iInterval).
     1058         vend   =  now.
     1059         vint = vend - vStart.
     1060         vint = iInterval - vint / 1000.
     1061         if     not mWaitFramStop
     1062            and vint > 0
     1063         then do:
     1064            run gbl/pause.p (vint * 1000).
     1065         end.
     1066         if iInterval ne ?
     1067         then
     1068            publish "WaitFramStop".
     1069         waitfram-check-timeout().
     1070      end.
     1071      procedure WaitFramWaitFor:
     1072         define input  parameter iInterval as dec no-undo.
     1073         assign
     1074            mWaitFramStartProc   = now
     1075            mWaitFramStopUser    = no
     1076            mWaitFramStopTimeOut = no
     1077         .
     1078         block-wait:
     1079         do while not mWaitFramStop:
     1080            run WaitFramRunPause (iInterval).
     1081            if  waitfram-check-timeout()
     1082            then do:
     1083               leave block-wait.
     1084            end.
     1085         end.
     1086         run waitfram-hide.
     1087      end.
     1088   procedure waitfram-join :
     1089     define input  parameter p-line-1  as character no-undo .
     1090     define input  parameter p-line-2  as character no-undo .
     1091     define input  parameter p-line-3  as character no-undo .
     1092     define output parameter p-message as character no-undo .
     1093     do
     1094     on error undo, return error return-value
     1095     :
     1096       assign
     1097         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1098                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1099                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1100       .
     1101     end.
     1102   end procedure.
     1103   function waitfram-join-function returns character
     1104     (input p-line-1 as character
     1105     ,input p-line-2 as character
     1106     ,input p-line-3 as character
     1107     ).
     1108     define variable v-message as character no-undo .
     1109     run waitfram-join in this-procedure
     1110       (input  p-line-1
     1111       ,input  p-line-2
     1112       ,input  p-line-3
     1113       ,output v-message
     1114       ) .
     1115     return v-message .
     1116   end function .
