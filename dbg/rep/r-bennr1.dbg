     1240   PROCEDURE no-benq.
     1241   DEFINE OUTPUT PARAMETER found as logical init no.
     1242   define buffer buf_chk-doc for ub.chk-doc.
     1243   FOR EACH obj-list WHERE
     1244           obj-list.obj-type = 'маг':U NO-LOCK :
     1245     CASE X-Radio-Task > 1 :
     1246       WHEN YES THEN DO:
     1247         FOR EACH buf_chk-doc NO-LOCK WHERE
     1248                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1249                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1250                 (
     1251                   buf_chk-doc.shift-date >= X-date-start AND
     1252                   buf_chk-doc.shift-date <= X-date-end)
     1253                   AND
     1254                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1255           IF X-Radio-Task = 3 AND
     1256           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     1257             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     1258           IF X-Radio-Task = 4 AND
     1259           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1260           found = yes.
     1261           return.
     1262         END.
     1263       END.
     1264       WHEN NO THEN DO:
     1265         FOR EACH buf_chk-doc NO-LOCK WHERE
     1266               buf_chk-doc.obj-type = obj-list.obj-type AND
     1267               buf_chk-doc.obj-code = obj-list.obj-code AND
     1268               buf_chk-doc.chk-date >= X-date-start AND
     1269               buf_chk-doc.chk-date <= X-date-end   AND
     1270               (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1271           found = yes.
     1272           return.
     1273         END.
     1274        END.
     1275      END CASE.
     1276    END.
     1277   END PROCEDURE.
     1278   PROCEDURE no-benqi.
     1279   DEFINE OUTPUT PARAMETER found as logical init no.
     1280   define buffer buf_chk-doc for ub.chk-doc.
     1281   define buffer buf_inkas for ub.inkas.
     1282   FOR EACH obj-list WHERE
     1283         obj-list.obj-type = 'маг':U NO-LOCK :
     1284     CASE X-Radio-Task > 1 :
     1285       WHEN YES THEN DO:
     1286         FOR EACH buf_chk-doc No-LOCK WHERE
     1287                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1288                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1289                 (
     1290                   buf_chk-doc.shift-date >= X-date-start AND
     1291                   buf_chk-doc.shift-date <= X-date-end)
     1292                   AND
     1293                   buf_Chk-doc.out-code = ? AND
     1294                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1295           IF X-Radio-Task = 3 AND
     1296           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     1297             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     1298           IF X-Radio-Task = 4 AND
     1299           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1300           found = yes.
     1301           return.
     1302         END.
     1303         FOR EACH buf_inkas No-LOCK WHERE
     1304                   buf_inkas.obj-type = obj-list.obj-type AND
     1305                   buf_inkas.obj-code = obj-list.obj-code AND
     1306                   (
     1307                   buf_inkas.shift-date >= X-date-start AND
     1308                   buf_inkas.shift-date <= X-date-end):
     1309           if buf_inkas.status_ = 'факт':U
     1310           or buf_inkas.status_ = 'запрос':U then next.
     1311           IF X-Radio-Task = 3 AND
     1312           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
     1313             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
     1314           IF X-Radio-Task = 4 AND
     1315           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
     1316           found = yes.
     1317           return.
     1318         END.
     1319       END.
     1320       WHEN NO THEN DO:
     1321         FOR EACH buf_chk-doc NO-LOCK WHERE
     1322                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1323                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1324                 buf_chk-doc.chk-date >= X-date-start AND
     1325                 buf_chk-doc.chk-date <= X-date-end   AND
     1326                 buf_Chk-doc.out-code = ? AND
     1327                 (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1328           found = yes.
     1329           return.
     1330         END.
     1331         FOR EACH buf_inkas NO-LOCK WHERE
     1332                 buf_inkas.obj-type = obj-list.obj-type AND
     1333                 buf_inkas.obj-code = obj-list.obj-code AND
     1334                 buf_inkas.doc-date >= X-date-start AND
     1335                 buf_inkas.doc-date <= X-date-end :
     1336           if buf_inkas.status_ = 'факт':U
     1337           or buf_inkas.status_ = 'запрос':U then next.
     1338           found = yes.
     1339           return.
     1340         END.
     1341       END.
     1342     END CASE.
     1343   END.
     1344   END PROCEDURE.
