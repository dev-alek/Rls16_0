     1454           sym7 column-label ":" format "X(1)"
     1455           benefits.pcnt column-label "% от суммы" format "->>>>9.99%"
     1456           sym8 column-label ":" format "X(1)"
     1457       HEADER  date_string format "X(35)" AT 5
     1458                           string( " " ) format "X(20)" AT 42
     1459                           "Страница " AT 65 PAGE-NUMBER( PrnLibStream )  AT 75 FORMAT ">>9" SKIP
     1460                       Line format "X(82)" AT 1
     1461       with width 160 down stream-io use-text .
     1462   DEFINE FRAME ZUM-PayCodes-rubl
     1463           sym1 column-label ":" format "X(1)"
     1464           benefits.pay-name column-label "Вид оплаты" format "X(41)"
     1465           sym6 column-label ":" format "X(1)"
     1466           benefits.tot-r-b column-label "Сумма (вал.продаж)"  format "->,>>>,>>>,>>>,>>9.99"
     1467           sym7 column-label ":" format "X(1)"
     1468           benefits.pcnt column-label "% от суммы" format "->>>>9.99%"
     1469           sym8 column-label ":" format "X(1)"
     1470       with width 160 down stream-io use-text NO-LABELS.
     1471   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1472   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1473   procedure cur-time :
     1474      define output parameter p-today as date      no-undo .
     1475      define output parameter p-time  as integer   no-undo .
     1476     do
     1477     on error undo, return error
     1478     :
     1479       define variable v-date1 as date      no-undo .
     1480       define variable v-date2 as date      no-undo .
     1481       define variable v-time  as integer   no-undo .
     1482       assign
     1483         v-date1 = today
     1484         v-time  = time
     1485         v-date2 = today
     1486       .
     1487       if v-date1 <> v-date2
     1488       then do:
     1489         assign
     1490           v-date1 = today
     1491           v-time  = v-time
     1492         .
     1493       end.
     1494       assign
     1495         p-today = v-date1
     1496         p-time  = v-time
     1497       .
     1498     end.
     1499   end.
     1500   function cur-time-date returns character
     1501   :
     1502     return string(today, '99/99/9999':U) .
     1503   end.
     1504   function cur-time-mjd returns decimal
     1505   :
     1506     define variable v-date as date      no-undo .
     1507     define variable v-time as integer   no-undo .
     1508     run cur-time in this-procedure
     1509       (output v-date
     1510       ,output v-time
     1511       ) .
     1512     return integer(v-date) - 2400002 + (v-time / 86400) .
     1513   end.
     1514   function cur-time-get-ending-index returns integer
     1515   (input p-number as integer
     1516   )
     1517   :
     1518     if p-number < 0
     1519     or p-number = ?
     1520     then do:
     1521       return 1 .
     1522     end.
     1523     define variable v-rest as integer   no-undo .
     1524     assign
     1525       p-number = p-number modulo 100
     1526     .
     1527     if p-number < 20
     1528     then do:
     1529       assign
     1530         v-rest = p-number
     1531       .
     1532     end.
     1533     else do:
     1534       assign
     1535         v-rest = p-number modulo 10
     1536       .
     1537     end.
     1538     case v-rest :
     1539       when 1
     1540       then do:
     1541         return 2 .
     1542       end.
     1543       when 2 or
     1544       when 3 or
     1545       when 4
     1546       then do:
     1547         return 3 .
     1548       end.
     1549       otherwise do:
     1550         return 1 .
     1551       end.
     1552     end case .
     1553   end.
     1554   procedure cur-time-mjd-to-date :
     1555      define input  parameter i-mjd-diff as decimal no-undo.
     1556      define output parameter o-Date     as date    no-undo.
     1557      define output parameter o-Time     as integer no-undo.
     1558      define variable v-day-number as integer   no-undo .
     1559      if    i-mjd-diff < 0
     1560         or i-mjd-diff = ?
     1561      then do:
     1562         return "?" .
     1563      end.
     1564      assign
     1565         v-day-number = truncate(i-mjd-diff,0).
     1566         o-Date = date(v-day-number + 2400002).
     1567         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1568     .
     1569   end.
     1570   function cur-time-mjd-to-string returns character
     1571   (input p-mjd-diff as decimal
     1572   )
     1573   :
     1574     define variable v-day-number as integer   no-undo .
     1575     define variable v-seconds    as integer   no-undo .
     1576     define variable v-hour       as integer   no-undo .
     1577     define variable v-min        as integer   no-undo .
     1578     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1579     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1580     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1581     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1582     if p-mjd-diff < 0
     1583     or p-mjd-diff = ?
     1584     then do:
     1585       return "?" .
     1586     end.
     1587     assign
     1588       v-day-number = integer(truncate(p-mjd-diff,0))
     1589       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1590     .
     1591     if v-seconds > 86400
     1592     then do:
     1593       assign
     1594         v-seconds = 86400 - 1
     1595       .
     1596     end.
     1597     if v-seconds < 0
     1598     then do:
     1599       assign
     1600         v-seconds = 0
     1601       .
     1602     end.
     1603     assign
     1604       v-hour = truncate(v-seconds / 3600, 0)
     1605     .
     1606     assign
     1607       v-seconds = v-seconds modulo 3600
     1608     .
     1609     assign
     1610       v-min = truncate(v-seconds / 60, 0)
     1611     .
     1612     assign
     1613       v-seconds = v-seconds modulo 60
     1614     .
     1615     return
     1616         (if v-day-number <> 0
     1617           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1618           else ""
     1619         )
     1620       + (if v-day-number <> 0 or v-hour <> 0
     1621           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1622           else ""
     1623         )
     1624       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1625           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1626           else ""
     1627         )
     1628       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1629       .
     1630   end.
     1631   function cur-time-string returns character
     1632   :
     1633     define variable v-date as date      no-undo .
     1634     define variable v-time as integer   no-undo .
     1635     run cur-time in this-procedure
     1636       (output v-date
     1637       ,output v-time
     1638       ) .
     1639     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1640   end.
     1641   function cur-time-string-sec returns character
     1642   :
     1643     define variable v-date as date      no-undo .
     1644     define variable v-time as integer   no-undo .
     1645     run cur-time in this-procedure
     1646       (output v-date
     1647       ,output v-time
     1648       ) .
     1649     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1650   end.
     1651   function cur-time-custom  returns character
     1652   (input p-prefix as character
     1653   ,input p-date-format as character
     1654   ,input p-delimiter as character
     1655   ,input p-time-format as character
     1656   ,input p-suffix as character
     1657   )
     1658   :
     1659     define variable v-date as date      no-undo .
     1660     define variable v-time as integer   no-undo .
     1661     run cur-time in this-procedure
     1662       (output v-date
     1663       ,output v-time
     1664       ) .
     1665     return
     1666       p-prefix
     1667       + string(v-date, p-date-format)
     1668       + p-delimiter
     1669       + string(v-time, p-time-format)
     1670       + p-suffix
     1671       .
     1672   end.
     1673   function cur-time-print  returns character
     1674   :
     1675     define variable v-date as date      no-undo .
     1676     define variable v-time as integer   no-undo .
     1677     run cur-time in this-procedure
     1678       (output v-date
     1679       ,output v-time
     1680       ) .
     1681     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1682   end.
     1683   function cur-time-datetime returns datetime
     1684   :
     1685     define variable v-char as character no-undo .
     1686     define variable v-datetime as datetime no-undo .
     1687     v-char = cur-time-string().
     1688     v-datetime = datetime(v-char).
     1689     return  v-datetime.
     1690   end.
     1691   function cur-time-string-msec returns character
     1692   :
     1693     define variable v-date as datetime  no-undo .
     1694     v-date = now.
     1695     return string(v-date) .
     1696   end.
     1697   function fnc-convert-dot-to-colon returns character
     1698       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
     1699   function fnc-convert-dot-to-colon returns character
     1700   (input p-data as decimal, input p-accur as character, input p-num as integer):
     1701       define variable result as character no-undo.
     1702       define variable v-str-result as character no-undo.
     1703       if p-data = ? then p-data = 0 .
     1704       p-data = round(p-data, p-num).
     1705       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     1706       return v-str-result.
     1707   END FUNCTION.
     1708   function putRowAmount1 returns character private
     1709   (input p-curr-name as character
     1710   ,input p-total1    as decimal
     1711   ) :
     1712   define variable v-row-amount as character no-undo .
     1713   define variable v-curr-name  as character no-undo .
     1714     v-curr-name = if p-curr-name > "" then p-curr-name else "<br />":U .
     1715     v-row-amount = substitute (
     1716         '<td>&1</td><td num="0.00" val="&2">&2</td><td><br /></td><td><br /></td>'
     1717         , v-curr-name
     1718         , fnc-convert-dot-to-colon(p-total1, "->>>>>>>>>>>9.99", 2)
     1719     ) .
     1720     return v-row-amount .
     1721   end function .
     1722   function putRowAmount returns character private
     1723   (input p-curr-name as character
     1724   ,input p-total1    as decimal
     1725   ,input p-total2    as decimal
     1726   ,input p-total3    as decimal
     1727   ) :
     1728   define variable v-row-amount as character no-undo .
     1729   define variable v-curr-name  as character no-undo .
     1730     v-curr-name = if p-curr-name > "" then p-curr-name else "<br />":U .
     1731     v-row-amount = substitute (
     1732         '<td>&1</td><td num="0.00" val="&2">&2</td><td num="0.00" val="&3">&3</td><td num="0.00" val="&4">&4</td>'
     1733         , v-curr-name
     1734         , fnc-convert-dot-to-colon(p-total1, "->>>>>>>>>>>9.99", 2)
     1735         , fnc-convert-dot-to-colon(p-total2, "->>>>>>>>>>>9.99", 2)
     1736         , fnc-convert-dot-to-colon(p-total3, "->>>>>>>>>>>9.99", 2)
     1737     ) .
     1738     return v-row-amount .
     1739   end function .
     1740   function putRowDayTotal1 returns character private
     1741   (input p-numchk-fisc as integer
     1742   ,input p-total1    as decimal
     1743   ) :
     1744   define variable v-day-amount as character no-undo .
     1745     v-day-amount = substitute (
     1746       '<td colspan="3">средн.чек: &1</td><td num="0.00" val="&2" class="sumtotal">&2</td><td><br /></td><td><br /></td>'
     1747       , ROUND(p-total1 / p-numchk-fisc, 2)
     1748       , fnc-convert-dot-to-colon(p-total1, "->>>>>>>>>>>9.99", 2)
     1749     ) .
     1750     return v-day-amount .
     1751   end function .
     1752   function putRowDayTotal returns character private
     1753   (input p-numchk-fisc as integer
     1754   ,input p-total1    as decimal
     1755   ,input p-total2    as decimal
     1756   ) :
     1757   define variable v-day-amount as character no-undo .
     1758     v-day-amount = substitute (
     1759       '<td colspan="3">средн.чек: &1</td><td num="0.00" val="&2" class="sumtotal">&2</td><td><br /></td><td num="0.00" val="&3" class="sumtotal">&3</td>'
     1760       , ROUND(p-total1 / p-numchk-fisc, 2)
     1761       , fnc-convert-dot-to-colon(p-total1, "->>>>>>>>>>>9.99", 2)
     1762       , fnc-convert-dot-to-colon(p-total2, "->>>>>>>>>>>9.99", 2)
     1763     ) .
     1764     return v-day-amount .
     1765   end function .
     1766   define VARIABLE v-report-id         as integer   no-undo .
     1767   define variable v-report-name       as character no-undo .
     1768   define variable v-file-name-rep-htm as character no-undo .
     1769   define stream OutStr-html.
     1770   define variable v-vsex-cas  as character no-undo.
     1771   define variable v-avg-chk   as decimal decimals  2 no-undo .
     1772   define variable v-times     as character no-undo.
     1773   define variable v-td-date   as character no-undo.
     1774   define variable v-pcnt      as decimal decimals  2 no-undo .
     1775   define variable v-accum     as decimal no-undo .
     1776   define variable v-accum-b   as decimal no-undo .
     1777   define variable v-accum-r   as decimal no-undo .
     1778   define variable v-accum-t   as decimal no-undo .
     1779   define variable v-accum-s   as decimal no-undo .
     1780   define variable v-chk-count as integer no-undo .
     1781   define variable v-err-message as character no-undo .
     1782   define query qben-chk-count for ben-chk-count .
     1783   empty temp-table benefits .
     1784   empty temp-table inkas-num .
     1785   empty temp-table day_sum .
     1786   empty temp-table all-days_sum .
     1787   empty temp-table ben-chk-count .
     1788   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1789   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1790     (output v-curr-r-b
     1791     )  .
     1792   if v-curr-r-b = 'base':U then do:
     1793       sale-price-type = "рублей".
     1794   end.
     1795   else sale-price-type = "рублей".
     1796   run no-benqi(output NotInc).
     1797     run rep/r-bennq1.p (
     1798                    input parparentproc
     1799                   ,input cas-num
     1800                   ,input T-time
     1801                   ,input v-curr-r-b
     1802                   ,output allday-basesum
     1803                   ,output allday-Rublsum
     1804                   ,output ObjAmount
     1805                   ,output ChkAmount
     1806                   ) no-error.
     1807     if error-status:error then do :
     1808       v-err-message = substitute("Ошибка формирования отчёта&1&2&1&3&1всего ошибок &4",
     1809                                  chr(10), return-value, error-status:get-message(1), error-status:num-messages) .
     1810       message v-err-message view-as alert-box.
     1811       return error return-value.
     1812     end .
     1813   if not can-find (first benefits) then do:
     1814     message "Не было никакой выручки на выбранных объектах в течение заданного Вами периода времени." view-as alert-box information .
     1815     return.
     1816   end.
     1817   if x-date-start = x-date-end
     1818   then choice = TRUE .
     1819   else choice = HowBreak .
     1820       run prn-lib-get-report-name  in this-procedure (
     1821                                                          input parParentProc
     1822                                                         ,output v-report-name
     1823                                                       ).
     1824     assign
     1825       v-file-name-rep-htm = v-report-name + ".html"
     1826       date_string = cur-time-print()
     1827       v-vsex-cas = IF cas-num = 0 then "ВСЕХ КАСС" ELSE ("КАССЫ " + string(cas-num))
     1828       v-avg-chk  = if ChkAmount > 0 then round(
     1829    AllDay-RublSum / ChkAmount
     1830                          , 2 ) else 0
     1831     .
     1832     v-times = "" .
     1833     IF T-time then
     1834       FOR EACH times No-LOCK :
     1835         v-times = v-times + times + chr(32) .
     1836       END .
     1837   do :
     1838     output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8' .
     1839     put stream OutStr-html unformatted
     1840       "<!DOCTYPE HTML>" skip
     1841       '<html>' skip
     1842       '<head>' skip
     1843       '  <meta charset="utf-8">' skip
     1844       '  <style type="text/css">' skip
     1845       '      table ~{border-collapse: collapse~;~}' skip
     1846       '      tbody td, th ~{border: 1px solid black~; height: 14px~;}' skip
     1847       '      tbody td:nth-child(4), tbody td:nth-child(5), tbody td:nth-child(6) ~{text-align: right~; padding-right: 4px~;~}' skip
     1848       '      tfoot td ~{height: 14px~;}' skip
     1849       '      .sumtotal ~{text-align: right~; padding-right: 4px~;~}' skip
     1850       '  </style>' skip
     1851       '</head>' skip
     1852       '<body>' skip
     1853       '<TABLE name="1" fit_to_page="true" orientation="portrait">' skip
     1854       '<thead>' skip
     1855       '  <tr class="set_columns">' skip
     1856       '    <td style="width:  53px;"></td>' skip
     1857       '    <td style="width: 124px;"></td>' skip
     1858       '    <td style="width: 31px;"></td>' skip
     1859       '    <td style="width: 71px;"></td>' skip
     1860       '    <td style="width: 63px;"></td>' skip
     1861       '    <td style="width: 63px;"></td>' skip
     1862       '    <td style="width: 49px;"></td>' skip
     1863       '    <td style="width: 41px;"></td>' skip
     1864       '  </tr>' skip
     1865       '  <tr>' skip
     1866       '    <td colspan="8">' + date_string + '</td>' skip
     1867       '  </tr>' skip
     1868       '  <tr>' skip
     1869       '    <td colspan="8">ОТЧЕТ  О  ВЫРУЧКЕ  ' + str1
     1870            + '<br />' + str4
     1871            + '<br />( сформирован по ВСЕМ ЧЕКАМ '
     1872            + (IF NotInc then v-vsex-cas + ", включая невошедшие в отчеты о продажах" else v-vsex-cas )
     1873            + ' )'
     1874            + '<br />'
     1875            + substitute("( всего чеков : &1, в среднем &2 &3 / чек )",  ChkAmount,  v-avg-chk,  sale-price-type  )
     1876            + '</td>' skip
     1877       '  </tr>' skip
     1878     .
     1879     IF T-time then do:
     1880       put stream OutStr-html unformatted
     1881         '  <tr>' skip
     1882         '    <td colspan="8">Выборочно по времени: '
     1883            + v-times
     1884            + '</td>' skip
     1885         '  </tr>' skip
     1886       .
     1887     end.
     1888     put stream OutStr-html unformatted
     1889       '</thead>' skip
     1890       '<tbody>' skip
     1891       '  <tr>' skip
     1892       '    <th>Дата</th>' skip
     1893       '    <th>Вид оплаты</th>' skip
     1894       '    <th></th>' skip
     1895       '    <th>Сумма в рублях</th>' skip
     1896       '    <th></th>' skip
     1897       '    <th></th>' skip
     1898       '    <th>~% от суммы</th>' skip
     1899       '    <th>Кол-во фиск. чеков</th>' skip
     1900       '  </tr>' skip
     1901     .
     1902   end .
     1903   FOR EACH obj-list WHERE
     1904             obj-list.obj-type = 'маг':U ,
     1905       EACH all-days_sum WHERE
     1906             all-days_sum.obj-type = obj-list.obj-type AND
     1907             all-days_sum.obj-code = obj-list.obj-code
     1908   BREAK
     1909   BY obj-list.obj-type
     1910   BY obj-list.obj-code :
     1911     ACCUMULATE
     1912     all-days_sum.tot-base ( TOTAL )
     1913     all-days_sum.tot-rubl ( TOTAL )
     1914     all-days_sum.tot-r-b  ( TOTAL )
     1915     all-days_sum.chk-cnt-all ( TOTAL )
     1916     all-days_sum.chk-cnt-nf  ( TOTAL )
     1917     obj-list.obj-code ( COUNT ) .
     1918       run waitfram-show in this-procedure ( obj-list.obj-type + string( obj-list.obj-code ) +
     1919                                     ", компоновка отчёта " ) .
     1920       FIND FIRST clients no-lock
     1921            WHERE clients.obj-type = obj-list.obj-type
     1922              AND clients.obj-code = obj-list.obj-code no-error .
     1923       put stream OutStr-html unformatted
     1924         '  <tr><td colspan="8">'
     1925         if available clients then clients.obj-name else '<br />'
     1926         '</td></tr>' skip
     1927       .
     1928     if choice then do:
     1929       FOR EACH benefits WHERE
     1930                 benefits.obj-type = obj-list.obj-type AND
     1931                 benefits.obj-code = obj-list.obj-code
     1932       BREAK
     1933       BY benefits.obj-type
     1934       BY benefits.obj-code
     1935       BY benefits.date_
     1936       BY benefits.pay-code
     1937       BY benefits.curr-code :
     1938         if first-of( benefits.date_ ) then do:
     1939           FIND FIRST day_sum WHERE
     1940                     day_sum.obj-type = obj-list.obj-type AND
     1941                     day_sum.obj-code = obj-list.obj-code AND
     1942                     day_sum.date_ = benefits.date_   NO-ERROR.
     1943           DatePrinted = FALSE .
     1944         end.
     1945         benefits.pcnt = round( benefits.tot-r-b / day_sum.tot-r-b * 100 , 2 ) .
     1946         if benefits.tot-base <> 0 or day_sum.chk-cnt-all > 0 or day_sum.chk-cnt-nf > 0
     1947         then do:
     1948           if DatePrinted then assign
     1949             v-td-date = '<br />'
     1950           .
     1951           else assign
     1952             v-td-date   = string(benefits.date_)
     1953             DatePrinted = TRUE
     1954           .
     1955           open query qben-chk-count
     1956            preselect each ben-chk-count
     1957                     where ben-chk-count.date_     = benefits.date_
     1958                       and ben-chk-count.pay-code  = benefits.pay-code
     1959                       and ben-chk-count.obj-code  = obj-list.obj-code
     1960                       and ben-chk-count.obj-type  = obj-list.obj-type
     1961                       and ben-chk-count.curr-code = benefits.curr-code.
     1962           v-chk-count = query qben-chk-count:num-results .
     1963           close query qben-chk-count.
     1964           put stream OutStr-html unformatted
     1965             '  <tr>'
     1966                 '<td>' + v-td-date + '</td>'
     1967                 '<td>' + benefits.pay-name + '</td>'
     1968                 putRowAmount1 ("", benefits.tot-rubl)
     1969             substitute(  '<td num="0.00" val="&1">&1</td>',  fnc-convert-dot-to-colon(benefits.pcnt,    "->>9.99",2)  )
     1970             substitute(  '<td num="0" val="&1" class="sumtotal">&1</td>',  v-chk-count  )
     1971             '</tr>' skip
     1972           .
     1973         end.
     1974         if last-of( benefits.date_ ) then  do:
     1975           if day_sum.chk-cnt-all > day_sum.chk-cnt-nf then do:
     1976             put stream OutStr-html unformatted
     1977               '  <tr>'
     1978               putRowDayTotal1 ( day_sum.chk-cnt-all - day_sum.chk-cnt-nf, day_sum.tot-rubl )
     1979               '<td>100.00%</td>'
     1980               substitute(  '<td num="0" val="&1" class="sumtotal">&1</td>',  day_sum.chk-cnt-all - day_sum.chk-cnt-nf  )
     1981               '</tr>' skip
     1982             .
     1983           end.
     1984         end.
     1985         if last-of (benefits.obj-code) then do:
     1986           put stream OutStr-html unformatted
     1987               '<tr><td colspan="3">ИТОГО:</td>'
     1988               substitute(  '<td num="0.00" val="&1" class="sumtotal">&1</td>',  fnc-convert-dot-to-colon(all-days_sum.tot-rubl,"->>>>>>>>>>>9.99",2)  )
     1989               '<td></td>'
     1990               '<td></td>'
     1991               '<td>100.00%</td>'
     1992               substitute(  '<td num="0" val="&1" class="sumtotal">&1</td>',  all-days_sum.chk-cnt-all - all-days_sum.chk-cnt-nf  )
     1993               '</tr>' skip
     1994           .
     1995         end.
     1996       END.
     1997     end.
     1998     else do:
     1999       FOR EACH benefits WHERE
     2000                benefits.obj-type = obj-list.obj-type AND
     2001                benefits.obj-code = obj-list.obj-code
     2002       BREAK
     2003       BY benefits.obj-type
     2004       BY benefits.obj-code
     2005       BY benefits.pay-code
     2006       BY benefits.curr-code :
     2007         ACCUMULATE
     2008           benefits.tot-base ( TOTAL )
     2009           benefits.tot-rubl ( TOTAL )
     2010           benefits.tot-r-b ( TOTAL )
     2011           benefits.tot-sum ( SUB-TOTAL BY benefits.curr-code )
     2012           benefits.tot-base ( SUB-TOTAL BY benefits.curr-code )
     2013           benefits.tot-rubl ( SUB-TOTAL BY benefits.curr-code )
     2014           benefits.tot-r-b ( SUB-TOTAL BY benefits.curr-code )
     2015         .
     2016         if first-of( benefits.curr-code ) then do:
     2017           v-accum-b = 0 .
     2018           v-accum-t = 0 .
     2019           define buffer buf_benefits for benefits .
     2020           for each buf_benefits where buf_benefits.obj-type  = benefits.obj-type
     2021                                   and buf_benefits.obj-code  = benefits.obj-code
     2022                                   and buf_benefits.pay-code  = benefits.pay-code
     2023                                   and buf_benefits.curr-code = benefits.curr-code :
     2024             v-accum-b = v-accum-b + buf_benefits.tot-base .
     2025             v-accum-t = v-accum-t + buf_benefits.tot-r-b .
     2026           end .
     2027         end.
     2028         if last-of( benefits.curr-code ) then do:
     2029           define variable v-if-accum as decimal no-undo .
     2030             v-if-accum = v-accum-t .
     2031           if v-if-accum <> 0 then do :
     2032           open query qben-chk-count
     2033            preselect each ben-chk-count
     2034                     where ben-chk-count.obj-type  = obj-list.obj-type
     2035                       and ben-chk-count.obj-code  = obj-list.obj-code
     2036                       and ben-chk-count.pay-code  = benefits.pay-code
     2037                       and ben-chk-count.curr-code = benefits.curr-code.
     2038           v-chk-count = query qben-chk-count:num-results .
     2039           close query qben-chk-count.
     2040           put stream OutStr-html unformatted
     2041             '  <tr>'
     2042                 '<td></td>'
     2043                 '<td>' + benefits.pay-name + '</td>'
     2044           .
     2045           v-accum-r = ACCUM SUB-TOTAL BY benefits.CURR-code benefits.tot-rubl .
     2046           v-pcnt = round(  v-accum-r  /  all-days_sum.tot-rubl  *  100    , 2 ) .
     2047           v-accum = v-accum-r .
     2048           put stream OutStr-html unformatted
     2049             putRowAmount1 ("", v-accum)
     2050           .
     2051             put stream OutStr-html unformatted
     2052               substitute(  '<td num="0.00" val="&1">&1</td>',  fnc-convert-dot-to-colon(v-pcnt,"->>9.99",2)  )
     2053               substitute(  '<td num="0" val="&1" class="sumtotal">&1</td>',  v-chk-count  )
     2054               '</tr>' skip
     2055             .
     2056           end.
     2057         end.
     2058         if last-of (benefits.obj-code) then do:
     2059           put stream OutStr-html unformatted
     2060               '  <tr><td colspan="3">ИТОГО:</td>'
     2061               substitute(  '<td num="0.00" val="&1" class="sumtotal">&1</td>',  fnc-convert-dot-to-colon(ACCUM TOTAL benefits.tot-rubl,"->>>>>>>>>>>9.99",2)  )
     2062               '<td></td>'
     2063               '<td></td>'
     2064               '<td>100.00%</td>'
     2065               substitute(  '<td num="0" val="&1" class="sumtotal">&1</td>',  all-days_sum.chk-cnt-all - all-days_sum.chk-cnt-nf  )
     2066               '</tr>' skip
     2067           .
     2068         end.
     2069       END.
     2070     end.
     2071     if last( obj-list.obj-code ) AND ( ACCUM COUNT obj-list.obj-code ) > 1 then  do:
     2072       put stream OutStr-html unformatted
     2073         '<tr><td colspan="3">ИТОГО по всем</td>' +
     2074         substitute(  '<td num="0.00" val="&1" class="sumtotal">&1</td>',  fnc-convert-dot-to-colon(ACCUM TOTAL all-days_sum.tot-rubl,"->>>>>>>>>>>9.99",2)  )
     2075         '<td></td>'
     2076         '<td></td>'
     2077         '<td></td>'
     2078         substitute(  '<td num="0" val="&1" class="sumtotal">&1</td>',
     2079           (ACCUM TOTAL all-days_sum.chk-cnt-all) - (ACCUM TOTAL all-days_sum.chk-cnt-nf)  )
     2080         '</tr>' skip
     2081       .
     2082     end.
     2083   END.
     2084   if choice AND ( ObjAmount > 1 ) then do:
     2085     FOR EACH benefits
     2086     BREAK
     2087     BY benefits.pay-code :
     2088       ACCUMULATE
     2089       benefits.tot-base ( SUB-TOTAL BY benefits.pay-code )
     2090       benefits.tot-rubl ( SUB-TOTAL BY benefits.pay-code )
     2091       benefits.tot-r-b  ( SUB-TOTAL BY benefits.pay-code )
     2092       .
     2093       if last-of( benefits.pay-code ) AND
     2094           ( ACCUM SUB-TOTAL BY benefits.pay-code benefits.tot-base ) <> 0 then do:
     2095         open query qben-chk-count
     2096          preselect each ben-chk-count
     2097                   where ben-chk-count.pay-code  = benefits.pay-code.
     2098         v-chk-count = query qben-chk-count:num-results .
     2099         close query qben-chk-count.
     2100         put stream OutStr-html unformatted
     2101           substitute(  '  <tr><td colspan="3">/итого по &1</td>',  benefits.pay-name  )
     2102           substitute(  '<td num="0.00" val="&1" class="sumtotal">&1</td>',  fnc-convert-dot-to-colon(ACCUM SUB-TOTAL BY benefits.pay-code benefits.tot-rubl,"->>>>>>>>>>>9.99",2)  )
     2103           '<td></td>'
     2104           '<td></td>'
     2105           '<td></td>'
     2106           substitute(  '<td num="0" val="&1" class="sumtotal">&1</td>',  v-chk-count  )
     2107           '</tr>' skip
     2108         .
     2109       end.
     2110     END.
     2111   end.
     2112   put stream OutStr-html unformatted
     2113     '</tbody>' skip
     2114     '<tfoot>' skip
     2115   .
     2116   if ( ACCUM COUNT obj-list.obj-code ) < 2 then do:
     2117     put stream OutStr-html unformatted
     2118       '  <tr><td colspan="8"><br /></td></tr>' skip
     2119       '  <tr><td colspan="4">Директор _______________</td><td colspan="4">Старший продавец ______________</td></tr>' skip
     2120       '  <tr><td colspan="8"><br /></td></tr>' skip
     2121       '  <tr><td colspan="4">Бухгалтер ______________</td><td colspan="4">Кассир ________________________</td></tr>' skip
     2122     .
     2123   end.
     2124   put stream OutStr-html unformatted
     2125     '</tfoot>' skip
     2126     '</table>' skip
     2127     '</body>' skip
     2128     '</html>' skip
     2129   .
     2130   output stream OutStr-html close.
     2131   run prn-lib-reportviewer in this-procedure (
     2132       input this-procedure
     2133       ,input v-file-name-rep-htm
     2134       ,input ""
     2135       ) no-error.
     2136   if error-status:error then
     2137   do:
     2138       message return-value view-as alert-box.
     2139       return .
     2140   end.
