     1483   ReportHeader = (ReportHeader) +  chr(10).
     1484   ReportHeader = (ReportHeader)               + IF  rs then      (rs:label) + ","  else " ".
     1485   ReportHeader = (ReportHeader)               + IF  we THen      (we:label) + ","  else " ".
     1486   ReportHeader = (ReportHeader)               + IF  iv then      (iv:label) + ","  else " ".
     1487   ReportHeader = (ReportHeader)               + IF  ev THen      (ev:label) + ","  else " ".
     1488   ReportHeader = (ReportHeader) +  chr(10).
     1489   ReportHeader = (ReportHeader)               + IF  rv then      (rv:label) + ","  else " ".
     1490   ReportHeader = (ReportHeader)               + IF  em then      (em:label) + ","  else " " .
     1491   ReportHeader = (ReportHeader)               + IF  wm THen      wm:label + ","  else " " .
     1492   ReportHeader = (ReportHeader)               + IF  im then      im:label + ","  else " ".
