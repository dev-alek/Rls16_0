     1293   PROCEDURE local-initialize :
     1294     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1295   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1296   do:
     1297     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1298       (input  v-cntxt-db-num
     1299       ,input  v-cntxt-userid
     1300       ,input  0
     1301       ,input  'actn_reports_lookup-cost':U
