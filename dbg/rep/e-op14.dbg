      770        VIEW-AS TOGGLE-BOX
      771        size 26.38 by 0.75 NO-UNDO.
      772   DEFINE VARIABLE re AS LOGICAL INITIAL no
      773        LABEL "возврат внешний":L
      774        VIEW-AS TOGGLE-BOX
      775        size 26.38 by 0.75 NO-UNDO.
      776   DEFINE VARIABLE rs AS LOGICAL INITIAL no
