     1062   PROCEDURE check-modified :
     1063   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1064   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1065   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1066   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1067     IF check-state = "check":U THEN
     1068     DO:
     1069       RUN get-link-handle IN adm-broker-hdl
     1070         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1071            OUTPUT group-target-list).
     1072       IF group-target-list NE "":U THEN
     1073       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1074         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1075         RUN check-modified IN curr-widget ('group-check':U).
     1076         IF RETURN-VALUE NE "":U THEN
     1077         DO:
     1078           RUN check-modified-message(RETURN-VALUE).
     1079           RETURN "":U.
     1080         END.
     1081       END.
     1082     END.
     1083     RETURN "":U.
     1084   END PROCEDURE.
     1085   PROCEDURE check-modified-message :
     1086     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1087        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1088           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1089        IF RETURN-VALUE = "YES":U THEN
     1090           RUN notify ('view,CONTAINER-SOURCE':U).
     1091        MESSAGE IF p-changed-table NE ? THEN
     1092           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1093           ELSE "Current values have been changed."
     1094           SKIP "  Do you wish to save those changes?"
     1095           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1096        IF ANS THEN
     1097        DO:
     1098           IF group-assign-target THEN
     1099             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1100           ELSE RUN dispatch('update-record':U).
     1101           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1102           DO:
     1103               MESSAGE "Changes to the previous record were not saved."
     1104                 VIEW-AS ALERT-BOX ERROR.
     1105               IF group-assign-target THEN
     1106                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1107               ELSE RUN dispatch ('cancel-record':U).
     1108           END.
     1109        END.
     1110        ELSE DO:
     1111          IF group-assign-target THEN
     1112             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1113          ELSE RUN dispatch('cancel-record':U).
     1114        END.
     1115        RETURN.
     1116   END PROCEDURE.
     1117   PROCEDURE get-rowid :
     1118       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1119       ASSIGN
     1120       p-table   =   adm-first-table.
     1121       RETURN.
     1122   END PROCEDURE.
     1123   PROCEDURE init-group-assign :
     1124       RUN request-attribute IN adm-broker-hdl
     1125         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1126       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1127         group-assign-target = yes.
     1128       ELSE group-assign-target = no.
     1129       RETURN.
     1130   END PROCEDURE.
     1131   PROCEDURE set-editors :
     1132       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1133       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1134       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1135       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1136       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1137       DO WHILE VALID-HANDLE (curr-widget):
     1138           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1139              curr-widget:HIDDEN = no THEN DO:
     1140             CASE p-field-setting:
     1141               WHEN "INITIALIZE":U THEN
     1142               DO:
     1143                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1144                     read-only-list +
     1145                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1146                        STRING(curr-widget).
     1147               END.
     1148               WHEN "DISABLE":U OR
     1149               WHEN "ENABLE":U THEN
     1150               DO:
     1151                   curr-widget:SENSITIVE = yes.
     1152                   RUN get-attribute ('Read-Only-Editors':U).
     1153                   IF RETURN-VALUE = ? OR
     1154                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1155                       curr-widget:READ-ONLY =
     1156                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1157               END.
     1158               WHEN "CLEAR":U THEN
     1159                   curr-widget:SCREEN-VALUE = "":U.
     1160             END CASE.
     1161           END.
     1162           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1163       END.
     1164       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1165         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1166           + '"':U).
     1167       RETURN.
     1168   END PROCEDURE.
     1169   PROCEDURE use-check-modified-all :
     1170    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1171     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1172     RETURN.
     1173   END PROCEDURE.
     1174   PROCEDURE use-create-on-add :
