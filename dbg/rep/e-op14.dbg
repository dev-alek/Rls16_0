     1304       ,input  v-cntxt-obj-type
     1305       ,input  v-cntxt-obj-code
     1306       ,input  0
     1307       ,input  0
     1308       ,input  0
     1309       ,input  false
     1310       ,output g#log
     1311       )  .
     1312   end.
     1313      if not  g#log then do :
     1314    end.
     1315   define variable lab-handle as handle no-undo .
     1316   define variable i as integer no-undo .
     1317   define variable v-code as character no-undo .
     1318   define variable v-nn as integer   no-undo .
     1319   v-nn = num-entries (list-com-hand) .
     1320   do i = 1 to v-nn :
     1321    lab-handle = widget-handle (entry( i , list-com-hand) ) no-error .
     1322    if valid-handle(lab-handle) = true and  error-status :error = false   then do:
     1323       v-code = lab-handle:name.
     1324       lab-handle:label = func-get-name-from-ext-type ( v-code, true  ) .
     1325       end.
     1326   end.
     1327   END PROCEDURE.
