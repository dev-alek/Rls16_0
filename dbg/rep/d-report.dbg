     1143   define stream str-export .
     1144   DEFINE VARIABLE h_folder AS HANDLE NO-UNDO.
     1145   DEFINE VARIABLE h_format AS HANDLE NO-UNDO.
     1146   DEFINE VARIABLE h_list AS HANDLE NO-UNDO.
     1147   DEFINE VARIABLE h_main AS HANDLE NO-UNDO.
     1148   DEFINE VARIABLE h_special AS HANDLE NO-UNDO.
     1149   DEFINE BUTTON b-exit AUTO-END-KEY
     1150        LABEL "&Выход"
     1151        SIZE 10 BY 1
     1152        BGCOLOR 8 .
     1153   DEFINE BUTTON B-Help
     1154        LABEL "Помо&щь"
     1155        SIZE 10 BY 1
     1156        BGCOLOR 8 .
     1157   DEFINE BUTTON B-lkp
     1158        LABEL "&Просмотр"
     1159        SIZE 10 BY 1
     1160        BGCOLOR 8 .
     1161   DEFINE BUTTON Btn_OK AUTO-GO
     1162        LABEL "_ В&ыполнить"
     1163        SIZE 12 BY 1
     1164        BGCOLOR 8 .
     1165   DEFINE BUTTON i-exit
     1166        IMAGE-UP FILE "cmp/i-run.bmp":U
     1167        IMAGE-DOWN FILE "cmp/i-run.bmp":U
     1168        IMAGE-INSENSITIVE FILE "cmp/i-rund.bmp":U
     1169        LABEL ""
     1170        SIZE 2.5 BY .75.
     1171   DEFINE FRAME D-Dialog
     1172        b-exit AT ROW 1 COL 1
     1173        Btn_OK AT ROW 1 COL 11
     1174        i-exit AT ROW 1.08 COL 11.13 NO-TAB-STOP
     1175        B-lkp  AT ROW 1 COL 61
     1176        B-Help AT ROW 1 COL 71
     1177        SPACE(14.24) SKIP(20.66)
     1178       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1179            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1180            TITLE "<insert SmartDialog title>"
     1181            DEFAULT-BUTTON Btn_OK CANCEL-BUTTON b-exit.
     1182   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1183   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1184   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1185   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1186   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1187   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1188   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1189   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1190       ASSIGN adm-object-hdl = FRAME D-Dialog:HANDLE.
     1191   RUN ensure-broker.
     1192   THIS-PROCEDURE:ADM-DATA =
     1193        'ADM1.1~`':U +
     1194        'SmartDialog~`':U +
     1195        'DIALOG-BOX~`':U +
     1196        'NO ~`':U +
     1197        '~`':U +
     1198        '~`':U +
     1199        '~`':U +
     1200        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1201           + "~`":U +
     1202        'Layout,Hide-on-Init~`':U +
     1203        'Record-Target~`':U +
     1204        '~`':U +
     1205        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1206        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1207            THEN "^^":U
     1208        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1209             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1210   PROCEDURE adm-apply-entry :
     1211     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1212   END PROCEDURE.
     1213   PROCEDURE adm-destroy :
     1214    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1215   END PROCEDURE.
     1216   PROCEDURE adm-disable :
     1217       DISABLE b-exit Btn_OK B-lkp B-Help i-exit WITH FRAME D-Dialog.
     1218       RUN dispatch ('disable-fields':U).
     1219       RUN set-attribute-list ('ENABLED=no':U).
     1220       RETURN.
     1221   END PROCEDURE.
     1222   PROCEDURE adm-edit-attribute-list :
     1223         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
     1224         RETURN.
     1225   END PROCEDURE.
     1226   PROCEDURE adm-enable :
     1227       ENABLE UNLESS-HIDDEN b-exit Btn_OK B-lkp B-Help i-exit WITH FRAME D-Dialog.
     1228       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1229       RUN set-attribute-list ('ENABLED=yes':U).
     1230       RETURN.
     1231   END PROCEDURE.
     1232   PROCEDURE adm-exit :
     1233        RUN notify ('exit':U).
     1234     RETURN.
     1235   END PROCEDURE.
     1236   PROCEDURE adm-hide :
     1237     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1238   END PROCEDURE.
     1239   PROCEDURE adm-initialize :
     1240     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1241   END PROCEDURE.
     1242   PROCEDURE adm-show-errors :
     1243       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1244       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1245           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1246       END.
     1247       RETURN.
     1248   END PROCEDURE.
     1249   PROCEDURE adm-UIB-mode :
     1250     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1251   END PROCEDURE.
     1252   PROCEDURE adm-view :
     1253     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1254   END PROCEDURE.
     1255   PROCEDURE dispatch :
     1256       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1257       RUN broker-dispatch IN adm-broker-hdl
     1258           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1259       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1260   END PROCEDURE.
     1261   PROCEDURE ensure-broker :
     1262   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1263   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1264   DO:
     1265       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1266       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1267   END.
     1268   END PROCEDURE.
     1269   PROCEDURE get-attribute :
     1270     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1271     RUN broker-get-attribute IN adm-broker-hdl
     1272         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1273     RETURN RETURN-VALUE.
     1274   END PROCEDURE.
     1275   PROCEDURE get-attribute-list :
     1276     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1277     RUN broker-get-attribute-list IN adm-broker-hdl
     1278         (INPUT THIS-PROCEDURE,
     1279          INPUT ?,
     1280          OUTPUT p-attr-list) NO-ERROR.
     1281     RETURN.
     1282   END PROCEDURE.
     1283   PROCEDURE new-state :
     1284     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1285     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1286     RETURN.
     1287   END PROCEDURE.
     1288   PROCEDURE notify :
     1289     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1290     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1291     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1292         RETURN "ADM-ERROR":U.
     1293     RETURN.
     1294   END PROCEDURE.
     1295   PROCEDURE set-attribute-list :
     1296     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1297     RUN ensure-broker.
     1298     RUN broker-set-attribute-list IN adm-broker-hdl
     1299         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1300     RETURN.
     1301   END PROCEDURE.
     1302   PROCEDURE set-position :
     1303       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1304       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1305       IF VALID-HANDLE(adm-object-hdl) THEN
     1306       DO:
     1307           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     1308           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     1309           DO:
     1310             IF p-row = 0 THEN p-row =
     1311               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     1312             IF p-col = 0 THEN p-col =
     1313               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     1314           END.
     1315           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     1316           DO:
     1317             parent-hdl = adm-object-hdl:PARENT.
     1318             IF p-row = 0 THEN p-row =
     1319               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     1320                 parent-hdl:ROW.
     1321             IF p-col = 0 THEN p-col =
     1322               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     1323                 parent-hdl:COL.
     1324           END.
     1325           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     1326           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     1327         ASSIGN adm-object-hdl:ROW    =   p-row
     1328                adm-object-hdl:COLUMN =   p-col.
     1329       END.
     1330       RETURN.
     1331   END PROCEDURE.
     1332   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
     1333       STRING(adm-object-hdl)).
     1334   PAUSE 0 BEFORE-HIDE.
     1335   PROCEDURE adm-change-page :
     1336     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
     1337     END PROCEDURE.
     1338   PROCEDURE delete-page :
     1339     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
     1340     RUN broker-delete-page IN adm-broker-hdl
     1341         (INPUT THIS-PROCEDURE, INPUT p-page#).
     1342     END PROCEDURE.
     1343   PROCEDURE init-object :
     1344     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
     1345     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
     1346     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
     1347     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
     1348     RUN broker-init-object IN adm-broker-hdl
     1349         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
     1350          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
     1351     RETURN.
     1352   END PROCEDURE.
     1353   PROCEDURE init-pages :
     1354     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
     1355     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1356         INPUT p-page-list) NO-ERROR.
     1357     END PROCEDURE.
     1358   PROCEDURE select-page :
     1359     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
     1360     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1361         INPUT p-page#) NO-ERROR.
     1362     END PROCEDURE.
     1363   PROCEDURE view-page :
     1364     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
     1365     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1366         INPUT p-page#).
     1367     END PROCEDURE.
     1368   ASSIGN
     1369          FRAME D-Dialog:SCROLLABLE       = FALSE
     1370          FRAME D-Dialog:HIDDEN           = TRUE.
     1371   ON WINDOW-CLOSE OF FRAME D-Dialog
     1372   DO:
     1373     APPLY "END-ERROR":U TO SELF.
     1374   END.
     1375   ON CHOOSE OF B-lkp IN FRAME D-Dialog
     1376   DO:
     1377     run verify-obj in h_main.
     1378     run assign-frame in  h_main.
     1379     if not param-alon
     1380     then do:
     1381           if format-folder
     1382           then do:
     1383              run get-var-2 in h_format no-error.
     1384       IF ERROR-STATUS:ERROR then
     1385        DO:
     1386        message "Необходимо сходить на закладку <Формат...> !" view-as alert-box information .
     1387        RUN select-page IN THIS-PROCEDURE ( 3 ).
     1388        return no-apply.
     1389        END.
     1390           end.
     1391        run my-var in h_special no-error.
     1392       IF ERROR-STATUS:ERROR then
     1393        DO:
     1394           run CloseForExcel in this-procedure  .
     1395           CASE RETURN-VALUE:
     1396           When 'First-page':U THEN  DO:
     1397                   return no-apply.
     1398                                     END.
     1399           When 'Second-page':U THEN  DO:
     1400                       message "Проверьте правильность заполнения формы!".
     1401                       RUN select-page IN THIS-PROCEDURE ( 2 ).
     1402                       return  no-apply .
     1403                                      END.
     1404           when 'format-page' then DO:
     1405                       message "На закладке <Формат...> необходимо выбрать поля для печати !".
     1406                       RUN select-page IN THIS-PROCEDURE ( 3 ).
     1407                       return no-apply.
     1408                       END.
     1409           OTHERWISE  DO:
     1410                       message "Необходимо сходить на закладку <Продолжение...> !".
     1411                       RUN select-page IN THIS-PROCEDURE ( 2 ).
     1412                       return no-apply.
     1413                       END.
     1414           End case.
     1415        End.
     1416        ELSE
     1417           CASE RETURN-VALUE:
     1418           When 'First-page':U THEN  DO:
     1419                   RUN select-page IN THIS-PROCEDURE ( 1 ).
     1420                   return no-apply.
     1421                                       END.
     1422           When 'Second-page':U THEN  DO:
     1423                       message "Проверьте правильность заполнения формы!".
     1424                       RUN select-page IN THIS-PROCEDURE ( 2 ).
     1425                       return  no-apply .
     1426                                       END.
     1427           When 'format-page':U THEN  DO:
     1428                       message "Проверьте правильность заполнения формы!".
     1429                       RUN select-page IN THIS-PROCEDURE ( 3 ).
     1430                       return  no-apply .
     1431                                       END.
     1432           End case.
     1433     end.
     1434     run rep/r-prev.w .
     1435     return no-apply.
     1436   END.
     1437   ON CHOOSE OF Btn_OK IN FRAME D-Dialog
     1438   DO:
     1439     define buffer buf_sys-ctrl for ub.sys-ctrl.
     1440     find first buf_sys-ctrl no-lock no-error.
     1441     if (X-Date-Alone <> ? and
     1442        X-date-alone < buf_sys-ctrl.sys-date)
     1443     or (X-Date-Start <> ? and
     1444        X-Date-Start < buf_sys-ctrl.sys-date)
     1445     or (X-Date-End <> ? and
     1446        X-Date-End < buf_sys-ctrl.sys-date) then
     1447     do:
     1448       message "Нельзя сформировать отчет на дату меньше," skip
     1449               "чем дата чистки БД " string(buf_sys-ctrl.sys-date, "99/99/9999") "."
     1450       view-as alert-box.
     1451       return no-apply.
     1452     end.
     1453     if params-only then do:
     1454        run proc-save-param-RUM in this-procedure no-error .
     1455        if error-status :error then do:
     1456           return no-apply .
     1457        end.
     1458     end.
     1459     else do:
     1460       run trg/userlog.p (
     1461             input "report":U
     1462           , input namereport + chr(3) + procname
     1463           , input ?
     1464           , input ?
     1465           , input ""
     1466       ) no-error.
     1467       if error-status :error
     1468       then do:
     1469           message return-value + error-status:get-message(1) view-as alert-box title "Ошибка записи истории действий пользователя".
     1470       end.
     1471       run print-report in this-procedure no-error .
     1472       if error-status :error
     1473       then do:
     1474         return no-apply .
     1475       end.
     1476       return no-apply .
     1477     end.
     1478   END.
     1479   ON CHOOSE OF i-exit IN FRAME D-Dialog
     1480   DO:
     1481     APPLY "choose" TO btn_ok.
     1482   END.
     1483   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1484   procedure minbtn-set :
     1485       do
     1486           on error undo, return error return-value
     1487           :
     1488           define variable ii              as integer       no-undo .
     1489           define variable fh              as widget-handle no-undo .
     1490           define variable hh              as widget-handle no-undo .
     1491           define variable v-h             as handle        extent 4 no-undo .
     1492           define variable v-name-button   as character     no-undo .
     1493           define variable v-help-old-x    as decimal       no-undo .
     1494           define variable v-help-old-y    as decimal       no-undo .
     1495           define variable v-help-old-size as decimal       no-undo .
     1496           define variable v-frame-width   as decimal       no-undo .
     1497           define variable jj              as integer       no-undo .
     1498           do
     1499               on error undo, return error
     1500               :
     1501               assign
     1502                   v-frame-width = frame D-Dialog:width - 0.3
     1503                   fh            = frame D-Dialog:first-child
     1504                   hh            = fh:first-child
     1505                   ii            = 1
     1506                   .
     1507               do while valid-handle(hh):
     1508                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1509                   do:
     1510                       case lc(hh:name) :
     1511                           when "b-help" then
     1512                               do:
     1513                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1514                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1515                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1516                                   hh:TOOLTIP = "Помощь" .
     1517                                   v-help-old-x = hh:column .
     1518                                   v-help-old-y = hh:row    .
     1519                                   v-help-old-size = hh:width .
     1520                                   hh:width-chars = 2.5 .
     1521                               end.
     1522                           when "b-print" then
     1523                               do:
     1524                                   hh:load-image("cmp/b-print.bmp":u) .
     1525                                   hh:TOOLTIP = "Печать" .
     1526                                   v-h[ii] = hh:handle .
     1527                                   ii = ii + 1 .
     1528                                   hh:width-chars = 3 .
     1529                               end.
     1530                           when "b-history" or
     1531                           when "b-hist" then
     1532                               do:
     1533                                   hh:load-image("cmp/b-hist.bmp":u) .
     1534                                   hh:TOOLTIP = "История" .
     1535                                   v-h[ii] = hh:handle .
     1536                                   ii = ii + 1 .
     1537                                   hh:width-chars = 3 .
     1538                               end.
     1539                           when "b-sch" then
     1540                               do:
     1541                                   hh:load-image("cmp/b-sch.bmp":u) .
     1542                                   hh:TOOLTIP = "Установка Фильтра" .
     1543                                   v-h[ii] = hh:handle .
     1544                                   ii = ii + 1 .
     1545                                   hh:width-chars = 3 .
     1546                               end.
     1547                           when "b-hist-user" then
     1548                               do:
     1549                                   hh:load-image("cmp/b-hist.bmp":u) .
     1550                                   hh:TOOLTIP = "История пользователя" .
     1551                                   ii = ii + 1 .
     1552                               end.
     1553                       end case.
     1554                   end.
     1555                   hh = hh:next-sibling.
     1556               end.
     1557               b-help:column = v-frame-width - b-help:width-chars.
     1558               jj = 0.
     1559               repeat ii = 4 to 1 by -1 :
     1560                   if valid-handle (v-h[ii] ) then
     1561                   do:
     1562                       jj  = jj + 1 .
     1563                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1564                       v-h[ii]:row    = v-help-old-y .
     1565                   end.
     1566               end.
     1567           end.
     1568       end.
     1569   end procedure.
     1570   run minbtn-set in this-procedure .
     1571   on help of frame D-Dialog
     1572   do:
     1573     run gbl/app_help.p
     1574       (input procname
     1575       ,input ''
     1576       ,input ?
     1577       ) no-error.
     1578     if error-status :error
     1579     then do:
     1580       message
     1581         "Ошибка при вызове помощи" skip
     1582         error-status :get-message(1) skip
     1583         return-value skip
     1584         view-as alert-box .
     1585     end.
     1586   end.
     1587   on choose of b-help in frame D-Dialog
     1588   do:
     1589     apply "help":u to frame D-Dialog .
     1590   end.
     1591   IF THIS-PROCEDURE:PERSISTENT THEN DO:
     1592       MESSAGE "A SmartDialog is not intended ":U SKIP
     1593               "to be run Persistent or to be placed ":U SKIP
     1594               "in another SmartObject at UIB design time.":U
     1595               VIEW-AS ALERT-BOX ERROR.
     1596       RUN disable_UI.
     1597       DELETE PROCEDURE THIS-PROCEDURE.
     1598       RETURN.
     1599   END.
     1600   RUN dispatch ('create-objects':U).
     1601   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME D-Dialog:PARENT eq ?
     1602   THEN FRAME D-Dialog:PARENT = ACTIVE-WINDOW.
     1603   MAIN-BLOCK:
     1604   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1605      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1606     RUN dispatch IN THIS-PROCEDURE ('initialize':U).
     1607     WAIT-FOR GO OF FRAME D-Dialog.
     1608   END.
     1609   RUN dispatch IN THIS-PROCEDURE ('destroy':U).
     1610   PROCEDURE adm-create-objects :
     1611     DEFINE VARIABLE adm-current-page  AS INTEGER NO-UNDO.
     1612     RUN get-attribute IN THIS-PROCEDURE ('Current-Page':U).
     1613     ASSIGN adm-current-page = INTEGER(RETURN-VALUE).
     1614     CASE adm-current-page:
     1615       WHEN 0 THEN DO:
     1616          RUN init-object IN THIS-PROCEDURE (
     1617                INPUT  'adm/objects/folder.w':U ,
     1618                INPUT  FRAME D-Dialog:HANDLE ,
     1619                INPUT  'FOLDER-LABELS = ':U + 'Параметры|Продолжение|Формат' + ',
     1620                        FOLDER-TAB-TYPE = 1':U ,
     1621                OUTPUT h_folder ).
     1622          RUN set-position IN h_folder ( 2.04 , 1.00 ) NO-ERROR.
     1623          RUN set-size IN h_folder ( 20.38 , 93.63 ) NO-ERROR.
     1624          RUN init-object IN THIS-PROCEDURE (
     1625                INPUT  'rep/b-listf.w':U ,
     1626                INPUT  FRAME D-Dialog:HANDLE ,
     1627                INPUT  '':U ,
     1628                OUTPUT h_list ).
     1629          RUN init-object IN THIS-PROCEDURE (
     1630                INPUT PROCNAME ,
     1631                INPUT  FRAME D-Dialog:HANDLE ,
     1632                INPUT  '':U ,
     1633                OUTPUT h_special ).
     1634          RUN init-object IN THIS-PROCEDURE (
     1635                INPUT  'rep/s-format.w':U ,
     1636                INPUT  FRAME D-Dialog:HANDLE ,
     1637                INPUT  '':U ,
     1638                OUTPUT h_format ).
     1639          RUN init-object IN THIS-PROCEDURE (
     1640                INPUT  'rep/s-object.w':U ,
     1641                INPUT  FRAME D-Dialog:HANDLE ,
     1642                INPUT  '':U ,
     1643                OUTPUT h_main ).
     1644          RUN add-link IN adm-broker-hdl ( h_folder , 'Page':U , THIS-PROCEDURE ).
     1645          RUN add-link IN adm-broker-hdl ( THIS-PROCEDURE , 'Record':U , h_list ).
     1646          RUN add-link IN adm-broker-hdl ( h_main , 'State':U , h_special ).
     1647          RUN add-link IN adm-broker-hdl ( THIS-PROCEDURE , 'Record':U , h_special ).
     1648          RUN add-link IN adm-broker-hdl ( THIS-PROCEDURE , 'Record':U , h_format ).
     1649          RUN add-link IN adm-broker-hdl ( THIS-PROCEDURE , 'Record':U , h_main ).
     1650          RUN adjust-tab-order IN adm-broker-hdl ( h_folder ,
     1651                B-Help:HANDLE , 'AFTER':U ).
     1652       END.
     1653     END CASE.
     1654     IF adm-current-page eq 0
     1655     THEN RUN select-page IN THIS-PROCEDURE ( 1 ).
     1656   END PROCEDURE.
     1657   PROCEDURE adm-row-available :
     1658     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1659     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1660     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1661     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1662     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1663     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1664     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1665     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1666     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1667     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1668     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1669     IF adm-updating-record THEN RETURN.
     1670     RUN get-attribute ('FIELDS-ENABLED':U).
     1671     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1672     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1673         OUTPUT link-handle) NO-ERROR.
     1674     IF link-handle = "":U THEN
     1675         RETURN.
     1676     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1677     IF NUM-ENTRIES(link-handle) > 1 THEN
     1678         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1679             "encountered more than one RECORD-SOURCE.":U SKIP
     1680             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1681                VIEW-AS ALERT-BOX ERROR.
     1682     RUN get-attribute ('Key-Name':U).
     1683     key-name = RETURN-VALUE.
     1684     IF key-name = "":U THEN key-name = ?.
     1685     IF key-name NE ? THEN DO:
     1686       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1687         NO-ERROR.
     1688       IF key-value NE ? THEN
     1689         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1690     END.
     1691   IF VALID-HANDLE (adm-object-hdl) THEN
     1692       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1693   RUN notify IN THIS-PROCEDURE ('row-available':U).
     1694   END PROCEDURE.
     1695   PROCEDURE disable_UI :
     1696     HIDE FRAME D-Dialog.
     1697   END PROCEDURE.
     1698   PROCEDURE enable_UI :
     1699     ENABLE b-exit Btn_OK B-lkp B-Help i-exit
     1700         WITH FRAME D-Dialog.
     1701     VIEW FRAME D-Dialog.
     1702   END PROCEDURE.
     1703   PROCEDURE Get-Var :
     1704   define output parameter  temp-str as char no-undo.
     1705   define output parameter  temp-param-date as int no-undo.
     1706   define output parameter  temp-param-date-type-period as character no-undo.
     1707   DEFINE output PARAMETER  temp-param-goods as char.
     1708   DEFINE output PARAMETER  temp-param-obj as char.
     1709   DEFINE output PARAMETER  temp-param-Pay as char.
     1710   DEFINE output PARAMETER  temp-param-Pay-hide as char.
     1711   DEFINE output PARAMETER  temp-param-obj-type as char.
     1712   DEFINE output PARAMETER  temp-param-alon as log.
     1713   DEFINE output PARAMETER  temp-param-customer as character no-undo .
     1714   DEFINE output PARAMETER  temp-param-customer-type as character no-undo .
     1715   DEFINE output PARAMETER  temp-param-schet        as character no-undo .
     1716   DEFINE output PARAMETER  temp-param-schet-hide   as character no-undo .
     1717   DEFINE output PARAMETER  temp-param-schet-init   as character no-undo .
     1718   DEFINE output PARAMETER  temp-param-schet-mode   as character no-undo .
     1719   define output parameter  all-object            as logical   no-undo .
     1720   define variable customer-yes as logical init false no-undo .
     1721   define variable customer-name as character INIT "" no-undo .
     1722   define variable customer-type as character INIT "" no-undo .
     1723   define variable schet-yes  as logical init false no-undo .
     1724   define variable schet-name as character INIT "" no-undo .
     1725   define variable schet-hide as character INIT "" no-undo .
     1726   define variable schet-init as character INIT "" no-undo .
     1727   define variable ed_date-ref as character no-undo .
     1728   define variable Jv as integer no-undo.
     1729   define variable v-ii as integer no-undo .
     1730   define variable plase-cost as integer no-undo .
     1731   define variable plase-crsa as integer no-undo .
     1732   define variable plase-sale as integer no-undo .
     1733   define variable radio-period as character   no-undo .
     1734   param-universal = param-universal + ",".
     1735   temp-param-obj-type  = "".
     1736   all-object = false .
     1737   assign temp-param-schet-mode = 'фирма':U .
     1738   v-nn3 = NUM-ENTRIES(param-universal).
     1739   REPEAT Jv = 1 to v-nn3:
     1740       CASE Entry(Jv,param-universal ) :
     1741           WHEN  "all":U OR
     1742           WHEN  "shop":U OR
     1743           WHEN  "stok":U Then temp-param-obj-type    =  Entry(Jv,param-universal ).
     1744           WHEN  String(1)             Then Make-Excel       = TRUE.
     1745           WHEN  String(9)         Then Make-Excel-com   = TRUE.
     1746           WHEN  String(12)           Then Verify-Arc-aht   = TRUE.
     1747           WHEN  String(2)            Then Verify-Arc-ot    = TRUE.
     1748           WHEN  String(3)           Then Verify-Arc-stk   = TRUE.
     1749           WHEN  String(8)          Then Verify-Arc-supp  = TRUE.
     1750           WHEN  String(11)          Then Verify-Arc-hold  = TRUE.
     1751           WHEN  String(24)        Then Verify-Arc-strong  = TRUE.
     1752           WHEN  String(4)            Then Verify-send-check = TRUE.
     1753           WHEN  String(5)             Then Show-Crsa = TRUE.
     1754           WHEN  String(6)             Then show-cost = TRUE.
     1755           WHEN  String(7)             Then show-sale = TRUE.
     1756           WHEN  String(10)         Then format-folder = TRUE.
     1757           WHEN  String(13)          Then customer-yes = TRUE.
     1758           WHEN  String(14)             Then schet-yes = TRUE.
     1759           WHEN  String(15)   Then schet-hide = schet-hide + string( 1   ) + "," .
     1760           WHEN  String(16)       Then schet-hide = schet-hide + string( 2       ) + "," .
     1761           WHEN  String(17)     Then schet-hide = schet-hide + string( 3     ) + "," .
     1762           WHEN  String(18)        Then schet-hide = schet-hide + string( 4        ) + "," .
     1763           WHEN  String(19)       Then schet-hide = schet-hide + string( 5       ) + "," .
     1764           WHEN  String(20)    Then schet-hide = schet-hide + string( 6    ) + "," .
     1765           WHEN  String(21) Then schet-hide = schet-hide + string( 7 ) + "," .
     1766           WHEN  "X-OWN-CMP":U Then temp-param-schet-mode = "company-host":U .
     1767           WHEN  String(22)    Then Print-List-Hist   = TRUE.
     1768           WHEN  String(23)            Then verify-arc-fin    = TRUE.
     1769       END Case.
     1770      if trim(Entry(Jv,param-universal)) begins "name-sale" then  name-sale-price = Entry(2,Entry(Jv,param-universal ),"=") .
     1771      if CAPS(trim(Entry(Jv,param-universal))) begins "X-DATE-START"      then  init-DATE-START  = date(Entry(2,Entry(Jv,param-universal ),"="))  .
     1772      if CAPS(trim(Entry(Jv,param-universal))) begins "X-DATE-END"        then  init-DATE-END    = date(Entry(2,Entry(Jv,param-universal ),"=")) .
     1773      if CAPS(trim(Entry(Jv,param-universal))) begins "X-DATE-ALONE"      then  init-DATE-ALONE  = date(Entry(2,Entry(Jv,param-universal ),"=")) .
     1774      if CAPS(trim(Entry(Jv,param-universal))) begins "X-SHIFT-ALONE"     then  init-Shift-ALONE = int(Entry(2,Entry(Jv,param-universal ),"=")) .
     1775      if CAPS(trim(Entry(Jv,param-universal))) begins "X-SHIFT-START"     then  init-Shift-Start = int(Entry(2,Entry(Jv,param-universal ),"=")) .
     1776      if CAPS(trim(Entry(Jv,param-universal))) begins "X-SHIFT-END"       then  init-Shift-End   = int(Entry(2,Entry(Jv,param-universal ),"=")) .
     1777      if CAPS(trim(Entry(Jv,param-universal))) begins "X-CUSTOMER-NAME"   then  customer-name    = Entry(2,Entry(Jv,param-universal ),"=") .
     1778      if CAPS(trim(Entry(Jv,param-universal))) begins "X-CUSTOMER-TYPE"   then  customer-type    = Entry(2,Entry(Jv,param-universal ),"=") .
     1779      if CAPS(trim(Entry(Jv,param-universal))) begins "X-SCHET-NAME"      then  schet-name       = Entry(2,Entry(Jv,param-universal ),"=") .
     1780      if CAPS(trim(Entry(Jv,param-universal))) begins "X-SCHET-INIT"      then  schet-init       = Entry(2,Entry(Jv,param-universal ),"=") .
     1781      if CAPS(trim(Entry(Jv,param-universal))) begins "X-SET_PAY_TYPE"    then  init-SET_PAY_TYPE = int(Entry(2,Entry(Jv,param-universal ),"=")) .
     1782      if CAPS(trim(Entry(Jv,param-universal))) begins "X-SET_VAL_TYPE"    then  init-SET_VAL_TYPE = int(Entry(2,Entry(Jv,param-universal ),"=")) .
     1783      if CAPS(trim(Entry(Jv,param-universal))) begins "ED_DATE-REF="      then  ed_date-ref       = Entry(2,Entry(Jv,param-universal ),"=") .
     1784      if CAPS(trim(Entry(Jv,param-universal))) begins "parent-handle="    then  parent-handle     = widget-handle(Entry(2,Entry(Jv,param-universal ),"=")) .
     1785      if CAPS(trim(Entry(Jv,param-universal))) begins "all-object"        then  all-object        = true  .
     1786      if CAPS(trim(Entry(Jv,param-universal))) begins "params-only="      then  params-only       = logical(Entry(2,Entry(Jv,param-universal ),"=")) .
     1787      if CAPS(trim(Entry(Jv,param-universal))) begins "params-only-mode=" then  params-only-mode  = Entry(2,Entry(Jv,param-universal ),"=") .
     1788      if CAPS(trim(Entry(Jv,param-universal))) begins "call="             then  place-call        = Entry(2,Entry(Jv,param-universal ),"=") .
     1789      if CAPS(trim(Entry(Jv,param-universal))) begins "radio-period="     then  radio-period      = Entry(2,Entry(Jv,param-universal ),"=") .
     1790    End.
     1791     run local-pre-initialize in this-procedure no-error .
     1792     if params-only then do:
     1793        Btn_OK:label in frame D-Dialog = '&Ввод' .
     1794        b-exit:label in frame D-Dialog = '&Отмена' .
     1795        if params-only-mode  = "'ПРОСМОТР':U" or  params-only-mode  = 'ПРОСМОТР':U then do:
     1796           params-only-mode  = 'ПРОСМОТР':U.
     1797           b-exit:label in frame D-Dialog = '&Выход' .
     1798           hide Btn_OK i-exit in frame D-Dialog .
     1799        end.
     1800     end.
     1801     if customer-yes = TRUE then do:
     1802         if trim(customer-name) = "" then temp-param-customer =  "Выбор контрагента" .
     1803                                     else temp-param-customer =  customer-name .
     1804         temp-param-customer-type =  customer-type .
     1805     end.
     1806     else
     1807       assign
     1808         temp-param-customer =  ""
     1809         temp-param-customer-type =  ""
     1810       .
     1811     if schet-yes = TRUE then do:
     1812         if trim(schet-name) = "" then temp-param-schet =  "Выбор счета" .
     1813                                  else temp-param-schet =  schet-name .
     1814         temp-param-schet-hide =  schet-hide .
     1815         temp-param-schet-init =  schet-init .
     1816     end.
     1817     else do:
     1818       assign
     1819         temp-param-schet =  ""
     1820         temp-param-schet-hide = ""
     1821         temp-param-schet-init = ""
     1822       .
     1823     end.
     1824     if ed_date-ref <> '':U then do:
     1825       do v-ii = 1 to num-entries(ed_date-ref, ';'):
     1826         if entry(1, entry(v-ii, ed_date-ref, ';'), chr(3)) = 'X-DATE-START':U then do:
     1827           assign
     1828           ref_date-start = entry(2, entry(v-ii, ed_date-ref, ';'), chr(3)).
     1829         end.
     1830         if entry(v-ii, ed_date-ref, ';') begins 'X-DATE-END':U then do:
     1831           assign
     1832           ref_date-end = entry(2, entry(v-ii, ed_date-ref, ';'), chr(3)).
     1833         end.
     1834         if entry(v-ii, ed_date-ref, ';') begins 'X-DATE-ALONE':U then do:
     1835           assign
     1836           ref_date-alone = entry(2, entry(v-ii, ed_date-ref, ';'), chr(3)).
     1837         end.
     1838       end.
     1839     end.
     1840   temp-param-date     = param-date .
     1841   temp-param-goods    = param-goods.
     1842   temp-param-obj      = param-obj.
     1843   temp-param-pay      = param-pay.
     1844   temp-param-pay-hide = param-pay-hide.
     1845   temp-param-alon     = param-alon.
     1846   temp-str =  ReportHeader.
     1847   g#log = true .
     1848   if show-cost = true
     1849   or lookup( "2" , temp-param-pay ) > 0
     1850   then do:
     1851   define variable vss-include-info25 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1852   do:
     1853     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1854       (input  v-cntxt-db-num
     1855       ,input  v-cntxt-userid
     1856       ,input  0
     1857       ,input  'actn_reports_lookup-cost':U
     1858       ,input  'object':U
     1859       ,input  v-cntxt-host-code-obj
     1860       ,input  v-cntxt-obj-type
     1861       ,input  v-cntxt-obj-code
     1862       ,input  0
     1863       ,input  0
     1864       ,input  0
     1865       ,input  true
     1866       ,output g#log
     1867       )  .
     1868   end.
     1869     if not g#log
     1870     then do:
     1871         Assign
     1872           show-cost  = false
     1873           plase-cost = INDEX (temp-param-Pay , "2" )
     1874           substring(temp-param-Pay,plase-cost) = "0"
     1875           no-error .
     1876     end.
     1877   end.
     1878   if  show-crsa = true
     1879   or lookup( "1" , temp-param-pay ) > 0
     1880   then do:
     1881   define variable vss-include-info26 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1882   do:
     1883     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1884       (input  v-cntxt-db-num
     1885       ,input  v-cntxt-userid
     1886       ,input  0
     1887       ,input  'actn_reports_lookup-crsa':U
     1888       ,input  'object':U
     1889       ,input  v-cntxt-host-code-obj
     1890       ,input  v-cntxt-obj-type
     1891       ,input  v-cntxt-obj-code
     1892       ,input  0
     1893       ,input  0
     1894       ,input  0
     1895       ,input  no
     1896       ,output g#log
     1897       )  .
     1898   end.
     1899     if not g#log
     1900     then do:
     1901       assign
     1902         show-crsa  = false
     1903         plase-crsa = index (temp-param-pay , "1" )
     1904         substring(temp-param-pay,plase-crsa) = "0"
     1905         no-error
     1906         .
     1907     end.
     1908   end.
     1909   if  show-sale = true
     1910   or lookup( "3" , temp-param-pay ) > 0
     1911   then do:
     1912   define variable vss-include-info27 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1913   do:
     1914     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1915       (input  v-cntxt-db-num
     1916       ,input  v-cntxt-userid
     1917       ,input  0
     1918       ,input  'actn_reports_lookup-sale':U
     1919       ,input  'object':U
     1920       ,input  v-cntxt-host-code-obj
     1921       ,input  v-cntxt-obj-type
     1922       ,input  v-cntxt-obj-code
     1923       ,input  0
     1924       ,input  0
     1925       ,input  0
     1926       ,input  no
     1927       ,output g#log
     1928       )  .
     1929   end.
     1930     if not g#log
     1931     then do:
     1932         assign
     1933           show-sale  = false
     1934           plase-sale = index (temp-param-pay , "3" )
     1935           substring(temp-param-pay,plase-sale) = "0"
     1936           no-error .
     1937     end.
     1938   End.
     1939   run initilize-page-3 in this-procedure .
     1940   END PROCEDURE .
     1941   procedure initilize-page-3:
     1942   define variable temp-str- as character no-undo .
     1943   define variable temp-i as integer no-undo .
     1944   define variable  l-ind as integer no-undo .
     1945    find first ubflt.usr-flt no-lock where
     1946            ubflt.usr-flt.user-name  = v-cntxt-userid and
     1947            ubflt.usr-flt.call-point = ReportProc  no-error .
     1948        if available ubflt.usr-flt then  DO:
     1949             v-nn = num-entries( ubflt.usr-flt.list_) .
     1950             repeat l-ind = 1 to v-nn :
     1951                       if entry(1,entry(l-ind, ubflt.usr-flt.list_),"=")  = "ReportPageHeight":U then
     1952                          ReportPageHeight = integer(entry(2,entry(l-ind, ubflt.usr-flt.list_),"=")) no-error .
     1953                          if error-status :error  then message "qq1" .
     1954                       if entry(1,entry(l-ind,ubflt.usr-flt.list_),"=")  = "ReportPageWidth":U then
     1955                          ReportPageWidth = integer(entry(2,entry(l-ind, ubflt.usr-flt.list_),"=")) no-error .
     1956                          if error-status :error  then message "qq2" .
     1957                       if entry(1,entry(l-ind, ubflt.usr-flt.list_ ),"=")  = "Use-Column":U then
     1958                       do :
     1959                           temp-str- = entry( 2 , entry(l-ind, ubflt.usr-flt.list_)  ,"=" ) no-error .
     1960                           v-nn2 = num-entries ( temp-str- , ";") .
     1961                           repeat temp-i = 1 to v-nn2:
     1962                               if temp-i <= 50 then
     1963                               use-column[temp-i] = ( if trim(entry(temp-i,temp-str-,";")) = "true" then true else false) .
     1964                           end.
     1965                       end.
     1966                       if error-status :error  then message "qq3" .
     1967                  End.
     1968             End.
     1969         Else assign ReportPageHeight = 0 ReportPageWidth  = 0.
     1970       run op-br in h_list no-error .
     1971   END PROCEDURE.
     1972   PROCEDURE local-create-objects :
     1973     DEFINE VARIABLE adm-current-page  AS INTEGER NO-UNDO.
     1974     RUN get-attribute IN THIS-PROCEDURE ('Current-Page':U).
     1975     ASSIGN adm-current-page = INTEGER(RETURN-VALUE).
     1976     If Lookup("10",param-universal) <> 0 then format-folder = true .
     1977                                                            else format-folder = false .
     1978     If format-folder then
     1979     Assign  v-type-folder-list =
     1980     (if param-alon THEN 'FOLDER-LABELS = ':U + 'Параметры||Формат' + ', FOLDER-TAB-TYPE = 1':U
     1981                    ELSE 'FOLDER-LABELS = ':U + 'Параметры|Продолжение|Формат' + ', FOLDER-TAB-TYPE = 1':U  )
     1982                   .
     1983     Else
     1984     Assign  v-type-folder-list =
     1985     (if param-alon THEN 'FOLDER-LABELS = ':U + 'Параметры' + ', FOLDER-TAB-TYPE = 1':U
     1986                    ELSE 'FOLDER-LABELS = ':U + 'Параметры|Продолжение' + ', FOLDER-TAB-TYPE = 1':U  )
     1987                   .
     1988     CASE adm-current-page:
     1989       WHEN 0
     1990       THEN DO:
     1991          RUN init-object IN THIS-PROCEDURE (
     1992                INPUT  'adm/objects/folder.w':U ,
     1993                INPUT  FRAME D-Dialog:HANDLE ,
     1994                INPUT  v-type-folder-list ,
     1995                OUTPUT h_folder ).
     1996          RUN set-position IN h_folder ( 2.04 , 1.00 ) NO-ERROR.
     1997          RUN set-size IN h_folder ( 20.38 , 93.63 ) NO-ERROR.
     1998          RUN add-link IN adm-broker-hdl ( h_folder , 'Page':U , THIS-PROCEDURE ).
     1999       END.
     2000       WHEN 1
     2001       THEN DO:
     2002          RUN init-object IN THIS-PROCEDURE (
     2003                INPUT  'rep/s-object.w':U ,
     2004                INPUT  FRAME D-Dialog:HANDLE ,
     2005                INPUT  'Layout = ':U ,
     2006                OUTPUT h_main ).
     2007          RUN set-position IN h_main ( 3.67 , 1.50 ) NO-ERROR.
     2008          RUN add-link IN adm-broker-hdl ( THIS-PROCEDURE , 'Record':U , h_main ).
     2009       END.
     2010       WHEN 2
     2011       THEN DO:
     2012          RUN init-object IN THIS-PROCEDURE (
     2013                INPUT PROCNAME ,
     2014                INPUT  FRAME D-Dialog:HANDLE ,
     2015                INPUT  'Layout = ':U ,
     2016                OUTPUT h_special ).
     2017          RUN set-position IN h_special ( 3.54 , 2.00 ) NO-ERROR.
     2018          RUN init-pages IN THIS-PROCEDURE ('1') NO-ERROR.
     2019          RUN add-link IN adm-broker-hdl ( h_main , 'State':U , h_special ).
     2020          RUN add-link IN adm-broker-hdl ( THIS-PROCEDURE , 'Record':U , h_special ).
     2021       END.
     2022       WHEN 3
     2023       THEN DO:
     2024           Run my-var in h_special no-error.
     2025       IF ERROR-STATUS:ERROR then
     2026        DO:
     2027           run CloseForExcel in this-procedure  .
     2028           CASE RETURN-VALUE:
     2029           When 'First-page':U THEN  DO:
     2030                   return no-apply.
     2031                                     END.
     2032           When 'Second-page':U THEN  DO:
     2033                       message "Проверьте правильность заполнения формы!".
     2034                       RUN select-page IN THIS-PROCEDURE ( 2 ).
     2035                       return  no-apply .
     2036                                      END.
     2037           when 'format-page' then DO:
     2038                       message "На закладке <Формат...> необходимо выбрать поля для печати !".
     2039                       RUN select-page IN THIS-PROCEDURE ( 3 ).
     2040                       return no-apply.
     2041                       END.
     2042           OTHERWISE  DO:
     2043                       message "Необходимо сходить на закладку <Продолжение...> !".
     2044                       RUN select-page IN THIS-PROCEDURE ( 2 ).
     2045                       return no-apply.
     2046                       END.
     2047           End case.
     2048        End.
     2049        ELSE
     2050           CASE RETURN-VALUE:
     2051           When 'First-page':U THEN  DO:
     2052                   RUN select-page IN THIS-PROCEDURE ( 1 ).
     2053                   return no-apply.
     2054                                       END.
     2055           When 'Second-page':U THEN  DO:
     2056                       message "Проверьте правильность заполнения формы!".
     2057                       RUN select-page IN THIS-PROCEDURE ( 2 ).
     2058                       return  no-apply .
     2059                                       END.
     2060           When 'format-page':U THEN  DO:
     2061                       message "Проверьте правильность заполнения формы!".
     2062                       RUN select-page IN THIS-PROCEDURE ( 3 ).
     2063                       return  no-apply .
     2064                                       END.
     2065           End case.
     2066           RUN init-object IN THIS-PROCEDURE (
     2067                 INPUT  'rep/b-listf.w':U ,
     2068                 INPUT  FRAME D-Dialog:HANDLE ,
     2069                 INPUT  'Layout = ':U ,
     2070                 OUTPUT h_list ).
     2071           RUN set-position IN h_list ( 3.50 , 19.63 ) NO-ERROR.
     2072          RUN init-object IN THIS-PROCEDURE (
     2073                INPUT  'rep/s-format.w':U ,
     2074                INPUT  FRAME D-Dialog:HANDLE ,
     2075                INPUT  'Layout = ':U ,
     2076                OUTPUT h_format ).
     2077          RUN set-position IN h_format ( 3.63 , 2.13 ) NO-ERROR.
     2078          RUN add-link IN adm-broker-hdl ( THIS-PROCEDURE , 'Record':U , h_list ).
     2079          RUN add-link IN adm-broker-hdl ( THIS-PROCEDURE , 'Record':U , h_format ).
     2080          RUN add-link IN adm-broker-hdl ( h_format , 'State':U , h_list ).
     2081       END.
     2082     END CASE.
     2083     IF adm-current-page eq 0
     2084     THEN RUN select-page IN THIS-PROCEDURE ( 1 ).
     2085   END PROCEDURE.
     2086   PROCEDURE local-initialize :
     2087   define variable par-type  as character no-undo .
     2088   define variable p-actuate as logical   no-undo .
     2089   run get-report-num   in parParentProc(output g#report-num).
     2090   my-handle = parParentProc .
     2091   RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     2092   Assign
     2093     ReportName = namereport
     2094     ReportProc = procname
     2095   .
     2096   Frame D-Dialog:Title  = Trim(namereport).
     2097   if params-only then do:
     2098       if params-only-mode  = 'ПРОСМОТР':U then do:
     2099         Frame D-Dialog:Title  = substitute("Просмотр ПАРАМЕТРОВ отчета:  &1" ,  Trim( namereport ) ) .
     2100       end.
     2101       else do:
     2102         Frame D-Dialog:Title  = substitute("Задание ПАРАМЕТРОВ отчета:  &1" ,  Trim( namereport ) ) .
     2103       end.
     2104   end.
     2105   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2106   empty temp-table thbjattr_thbj-attr.
     2107   run adm/shattri.p (
     2108      input "get":U
     2109     ,input ''
     2110     ,input 0
     2111     ,input 'report-glob':U
     2112     ,input  ""
     2113     ,output v-value-character
     2114     ,output v-value-date
     2115     ,output v-value-decimal
     2116     ,output v-value-integer
     2117     ,output v-value-logical
     2118     ,output par-type
     2119     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     2120     ) no-error .
     2121     for each thbjattr_thbj-attr :
     2122         if thbjattr_thbj-attr.prop-code = 'actuate'  then p-actuate   = thbjattr_thbj-attr.property-value-logical .
     2123     end.
     2124      if p-actuate
     2125      then do:
     2126      if param-Alon = false
     2127      then do:
     2128         run select-page in this-procedure ( 2 ) no-error.
     2129         run select-page in this-procedure ( 1 ) no-error.
     2130         run make-btn    in this-procedure  no-error.
     2131       end.
     2132      end.
     2133      else do:
     2134        run select-page in this-procedure
     2135          (input 1
     2136          ) no-error .
     2137      end.
     2138      if params-only  then do:
     2139         if param-Alon = false
     2140         then do:
     2141             run select-page in this-procedure ( 2 ) no-error.
     2142         end.
     2143         run select-page in this-procedure ( 1 ) no-error .
     2144         run my-params in h_special ( input "get" ) no-error .
     2145         run local-apply-layout in h_main no-error .
     2146     end.
     2147   END PROCEDURE.
     2148   PROCEDURE local-pre-initialize :
     2149     define variable v-today as date      no-undo .
     2150     define variable v-time  as integer   no-undo .
     2151     define variable v-ok    as logical   no-undo .
     2152     run cur-time in this-procedure
     2153       (output v-today
     2154       ,output v-time
     2155       ).
     2156      if init-date-start = date("") or init-date-start = ? then init-date-start  = v-today .
     2157      if init-date-end = date("") or init-date-end = ? then  init-date-end    = v-today .
     2158      if init-date-alone = date("") or init-date-alone = ? then  init-date-alone  = v-today.
     2159      if init-shift-alone = ? then init-shift-alone = 0 .
     2160      if init-shift-start = ? then init-shift-start = 0 .
     2161      if init-shift-end   = ? then init-shift-end   = 0 .
     2162   END PROCEDURE.
     2163   PROCEDURE make-btn :
     2164    do
     2165    on error undo, return error return-value
     2166    :
     2167      run report-to-ach in h_special
     2168        (input-output table param-to-export ) no-error.
     2169      if not error-status :error
     2170      then do:
     2171           create button b_ach
     2172           assign row = 1
     2173           column = 23
     2174           height-chars = 1
     2175           width-chars  = 15
     2176           label = "Actuate"
     2177           tooltip = "выполнение отчета при помощи внешней программы"
     2178           frame = frame D-Dialog:handle
     2179           sensitive = true
     2180           visible = true
     2181           triggers:
     2182                 on choose persistent run make-ach.
     2183           end triggers.
     2184      end.
     2185     end.
     2186   END PROCEDURE.
     2187   PROCEDURE print-report :
     2188   define variable choice             as logical   no-undo .
     2189   define variable v-total-archive-ok as logical   no-undo .
     2190   define variable v-archive-ok       as logical init true  no-undo .
     2191   define variable v-comment          as character no-undo .
     2192   define variable v-can-print        as logical   no-undo .
     2193   define variable temp-date      as date no-undo.
     2194   define variable temp-shift     as integer no-undo .
     2195   define variable v-date-start as date      no-undo .
     2196   define variable v-date-end   as date      no-undo .
     2197   define variable spis-obj     as character no-undo .
     2198     run verify-date in h_main no-error .
     2199     if error-status :error
     2200     then do:
     2201       undo, return error return-value .
     2202     end.
     2203     run verify-obj in h_main no-error .
     2204     if error-status :error
     2205     then do:
     2206       undo, return error return-value .
     2207     end.
     2208     run assign-frame in h_main .
     2209     run make-6-gds-list in h_main .
     2210     assign
     2211       v-total-archive-ok = true
     2212     .
     2213     if verify-arc-fin = true then do:
     2214       define variable p-status       as integer   no-undo .
     2215       define variable p-cut-date     as date      no-undo .
     2216       define variable p-cut-fin-date as date      no-undo .
     2217   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run cutd-db in g#library
     2218     (input  v-cntxt-db-num
     2219     ,output p-status
     2220     ,output p-cut-date
     2221     ,output p-cut-fin-date
     2222     ) no-error .
     2223         if param-date = 1
     2224         then do:
     2225           assign
     2226             v-date-start = x-date-alone
     2227             v-date-end   = x-date-alone
     2228           .
     2229         end.
     2230         else do:
     2231           assign
     2232             v-date-start = x-date-start
     2233             v-date-end   = x-date-end
     2234           .
     2235         end.
     2236       if p-cut-date <> ? and ( v-date-start < p-cut-date  or v-date-end < p-cut-date) then do:
     2237         message
     2238           "ВНИМАНИЕ!" skip
     2239           "БД была обрезана на " string(p-cut-fin-date, "99/99/9999")  skip
     2240           "Данные в отчете будут не корректны." skip
     2241           "Продолжить формирование отчета?" skip
     2242           view-as alert-box question
     2243               buttons yes-no
     2244               title "Финансовые архивы"
     2245               update choice .
     2246         if choice = false
     2247         then do:
     2248           assign
     2249             v-total-archive-ok = false
     2250           .
     2251           undo, return error return-value .
     2252         end.
     2253         else do:
     2254             if param-date = 1 then do:
     2255             v-date-end = p-cut-fin-date .
     2256             end .
     2257             else do:
     2258               v-date-start = p-cut-fin-date .
     2259               v-date-end   = p-cut-fin-date .
     2260             end.
     2261           assign
     2262             v-total-archive-ok = true
     2263           .
     2264         end.
     2265       end.
     2266     end.
     2267     if verify-arc-hold = true
     2268     then do:
     2269       iF param-date = 1
     2270       then do:
     2271         assign
     2272           temp-date = x-date-alone
     2273         .
     2274       end.
     2275       else do:
     2276         assign
     2277           TEMP-DATE = x-Date-End
     2278         .
     2279       end.
     2280        run trg/bt_hold.p
     2281         (input  temp-date
     2282         ,input  true
     2283         ,input  v-cntxt-db-num
     2284         ,input  v-cntxt-userid
     2285         ) no-error .
     2286       if error-status :error
     2287       then do:
     2288         message
     2289           "ВНИМАНИЕ!" skip
     2290           "Межфирменные архивы" skip
     2291           return-value skip
     2292           "Данные по выбранному периоду могут быть неполными или некорректными."
     2293           "Продолжить формирование отчета?" skip
     2294           view-as alert-box question buttons yes-no update choice .
     2295         if choice = false
     2296         then do:
     2297           assign
     2298             v-total-archive-ok = false
     2299           .
     2300         end.
     2301         else do:
     2302           assign
     2303             v-total-archive-ok = true
     2304           .
     2305         end.
     2306       end.
     2307     end.
     2308     if verify-arc-ot   = true
     2309         or verify-arc-stk  = true
     2310         or verify-arc-aht  = true
     2311         or verify-arc-supp = true
     2312         then do:
     2313           if  verify-arc-ot = true
     2314           and verify-arc-stk <> true
     2315           then do:
     2316             assign
     2317               verify-arc-stk = true
     2318             .
     2319           end.
     2320       spis-obj = "" .
     2321       v-total-archive-ok  = true .
     2322       for each obj-list no-lock :
     2323         if param-date = 1
     2324         then do:
     2325           assign
     2326             v-date-start = x-date-alone
     2327             v-date-end   = x-date-alone
     2328           .
     2329         end.
     2330         else do:
     2331           assign
     2332             v-date-start = x-date-start
     2333             v-date-end   = x-date-end
     2334           .
     2335         end.
     2336         run rep/chk-ahz.p
     2337           (input        obj-list.obj-type
     2338           ,input        obj-list.obj-code
     2339           ,input        verify-arc-ot
     2340           ,input        verify-arc-stk
     2341           ,input        verify-arc-supp
     2342           ,input        verify-arc-aht
     2343           ,input        true
     2344           ,input        v-cntxt-db-num
     2345           ,input        v-cntxt-userid
     2346           ,input-output v-date-start
     2347           ,input-output v-date-end
     2348           ,output       v-archive-ok
     2349           ,output       v-comment
     2350           ,output       v-can-print
     2351           ) .
     2352         if v-archive-ok = false
     2353         then do:
     2354           if v-can-print = false or verify-arc-strong  = true
     2355           then do:
     2356             message
     2357               "ВНИМАНИЕ !!!" skip
     2358               "Отчет не может быть сформирован!" skip
     2359               "На запрошенную дату нет архивов или они сжаты" skip
     2360               v-comment skip
     2361               view-as alert-box information .
     2362             run select-page in this-procedure
     2363               (input 0
     2364               ).
     2365             run select-page in this-procedure
     2366               (input 1
     2367               ).
     2368             undo, return error return-value .
     2369           end.
     2370           else do:
     2371             assign
     2372               v-total-archive-ok = false
     2373               spis-obj =  spis-obj + substitute("&1&2," , obj-list.obj-type , obj-list.obj-code)
     2374             .
     2375           end.
     2376         end.
     2377       end.
     2378       spis-obj = trim(spis-obj, ',') .
     2379       if v-total-archive-ok = false
     2380       then do:
     2381         define variable v-period-description as character no-undo .
     2382         if param-date = 1
     2383         then do:
     2384           assign
     2385             v-period-description = substitute("на конец дня &1"
     2386                                              ,string(x-date-end, '99/99/9999':u)
     2387                                              )
     2388           .
     2389         end.
     2390         else do:
     2391           assign
     2392             v-period-description = substitute("с начала дня &1 по конец дня &2"
     2393                                              ,string(x-date-start, '99/99/9999':u)
     2394                                              ,string(x-date-end,   '99/99/9999':u)
     2395                                              )
     2396           .
     2397         end.
     2398         message
     2399           "ВНИМАНИЕ!" skip
     2400           v-comment skip
     2401           spis-obj skip
     2402           "" skip
     2403           "Данные по выбранному периоду" v-period-description "могут быть неполными или некорректными." skip
     2404           "Продолжить формирование отчета?" skip
     2405           view-as alert-box question buttons yes-no update choice .
     2406         if choice = false
     2407         then do:
     2408           assign
     2409             v-archive-ok = false
     2410           .
     2411           return.
     2412         end.
     2413         else do:
     2414           assign
     2415             v-total-archive-ok = true
     2416           .
     2417         end.
     2418       end.
     2419     end.
     2420     if v-total-archive-ok = true
     2421     then do:
     2422       if param-alon = false
     2423       then do:
     2424         run initilize-page-3 in this-procedure .
     2425         run return-var in this-procedure .
     2426         if  (reportpageheight = 0  or reportpagewidth = 0)
     2427         and format-folder
     2428         then do:
     2429           run get-var-2 in h_format no-error.
     2430           if (reportpageheight = 0  or reportpagewidth = 0)
     2431           then do:
     2432             run select-page in this-procedure
     2433               (input 3
     2434               ) no-error .
     2435             undo, return error return-value .
     2436           end.
     2437         end.
     2438         run my-var in h_special no-error.
     2439       IF ERROR-STATUS:ERROR then
     2440        DO:
     2441           run CloseForExcel in this-procedure  .
     2442           CASE RETURN-VALUE:
     2443           When 'First-page':U THEN  DO:
     2444                   return no-apply.
     2445                                     END.
     2446           When 'Second-page':U THEN  DO:
     2447                       message "Проверьте правильность заполнения формы!".
     2448                       RUN select-page IN THIS-PROCEDURE ( 2 ).
     2449                       return  no-apply .
     2450                                      END.
     2451           when 'format-page' then DO:
     2452                       message "На закладке <Формат...> необходимо выбрать поля для печати !".
     2453                       RUN select-page IN THIS-PROCEDURE ( 3 ).
     2454                       return no-apply.
     2455                       END.
     2456           OTHERWISE  DO:
     2457                       message "Необходимо сходить на закладку <Продолжение...> !".
     2458                       RUN select-page IN THIS-PROCEDURE ( 2 ).
     2459                       return no-apply.
     2460                       END.
     2461           End case.
     2462        End.
     2463        ELSE
     2464           CASE RETURN-VALUE:
     2465           When 'First-page':U THEN  DO:
     2466                   RUN select-page IN THIS-PROCEDURE ( 1 ).
     2467                   return no-apply.
     2468                                       END.
     2469           When 'Second-page':U THEN  DO:
     2470                       message "Проверьте правильность заполнения формы!".
     2471                       RUN select-page IN THIS-PROCEDURE ( 2 ).
     2472                       return  no-apply .
     2473                                       END.
     2474           When 'format-page':U THEN  DO:
     2475                       message "Проверьте правильность заполнения формы!".
     2476                       RUN select-page IN THIS-PROCEDURE ( 3 ).
     2477                       return  no-apply .
     2478                                       END.
     2479           End case.
     2480       end.
     2481       if v-archive-ok = false and
     2482           (  verify-arc-ot   = true
     2483           or verify-arc-stk  = true
     2484           or verify-arc-aht  = true
     2485           or verify-arc-supp = true )
     2486       then do:
     2487         assign
     2488           reportheader = reportheader + chr(10)
     2489                        + "Архивы рассчитаны не полностью. Информация в отчете может быть неполной или некорректной."
     2490                        + chr(10) +
     2491                        (if spis-obj <> "" then substitute("Не корректная информация об архивах на объектах: &1" ,spis-obj ) else "")
     2492         .
     2493       end.
     2494       assign
     2495         G#rep-updflds = ReportName + " " + str1
     2496       .
     2497       assign
     2498         v-d-report-handle = this-procedure
     2499       .
     2500       RUN set-cursor IN adm-broker-hdl ("WAIT").
     2501       If param-Alon
     2502       then do:
     2503         run openforexcel in this-procedure .
     2504         if num-entries (trim(procname), " " ) > 1  then do:
     2505             define variable p-proc-par1 as character no-undo .
     2506             define variable p-proc-par2 as character no-undo .
     2507             assign
     2508               p-proc-par1 = entry(1, procname, " ")
     2509               p-proc-par2 = entry(2, procname, " ")
     2510             .
     2511             run value ( p-proc-par1 )
     2512               (input p-proc-par2
     2513               ).
     2514         end.
     2515         else do:
     2516             run value ( procname ) .
     2517         end.
     2518         run CloseForExcel in this-procedure .
     2519       End.
     2520       else do:
     2521         run OpenForExcel in this-procedure  .
     2522         run my-report in h_special no-error .
     2523       IF ERROR-STATUS:ERROR then
     2524        DO:
     2525           run CloseForExcel in this-procedure  .
     2526           CASE RETURN-VALUE:
     2527           When 'First-page':U THEN  DO:
     2528                   return no-apply.
     2529                                     END.
     2530           When 'Second-page':U THEN  DO:
     2531                       message "Проверьте правильность заполнения формы!".
     2532                       RUN select-page IN THIS-PROCEDURE ( 2 ).
     2533                       return  no-apply .
     2534                                      END.
     2535           when 'format-page' then DO:
     2536                       message "На закладке <Формат...> необходимо выбрать поля для печати !".
     2537                       RUN select-page IN THIS-PROCEDURE ( 3 ).
     2538                       return no-apply.
     2539                       END.
     2540           OTHERWISE  DO:
     2541                       message "Необходимо сходить на закладку <Продолжение...> !".
     2542                       RUN select-page IN THIS-PROCEDURE ( 2 ).
     2543                       return no-apply.
     2544                       END.
     2545           End case.
     2546        End.
     2547        ELSE
     2548           CASE RETURN-VALUE:
     2549           When 'First-page':U THEN  DO:
     2550                   RUN select-page IN THIS-PROCEDURE ( 1 ).
     2551                   return no-apply.
     2552                                       END.
     2553           When 'Second-page':U THEN  DO:
     2554                       message "Проверьте правильность заполнения формы!".
     2555                       RUN select-page IN THIS-PROCEDURE ( 2 ).
     2556                       return  no-apply .
     2557                                       END.
     2558           When 'format-page':U THEN  DO:
     2559                       message "Проверьте правильность заполнения формы!".
     2560                       RUN select-page IN THIS-PROCEDURE ( 3 ).
     2561                       return  no-apply .
     2562                                       END.
     2563           End case.
     2564         run CloseForExcel in this-procedure  .
     2565       end.
     2566       run set-cursor in adm-broker-hdl ("").
     2567     End.
     2568     assign
     2569       v-d-report-handle = ?
     2570     .
     2571     run prg-bar_delete-progress-bar in this-procedure .
     2572   END PROCEDURE.
     2573   PROCEDURE return-var :
     2574     run read-table IN h_list no-error.
     2575     run get-var-2 IN h_format no-error.
     2576     run my-var IN h_special no-error.
     2577   END PROCEDURE.
     2578   PROCEDURE send-records :
     2579   END PROCEDURE.
     2580   PROCEDURE state-changed :
     2581     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
     2582     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     2583   END PROCEDURE.
     2584   PROCEDURE make-ach :
     2585    do
     2586    on error undo, return error return-value
     2587    :
     2588     run my-var in h_special  no-error.
     2589     run assign-frame in h_main no-error .
     2590     run report-to-ach  in h_special (input-output table param-to-export ) no-error.
     2591     if error-status :error = true then return error .
     2592     define variable exp-name as character no-undo .
     2593     run gbl/_tmpfile.p ( "t", ".par", output exp-name) .
     2594     OUTPUT STREAM str-export TO  VALUE(exp-name).
     2595         for each param-to-export :
     2596           EXPORT STREAM str-export param-to-export .
     2597         end.
     2598     OUTPUT STREAM str-export CLOSE.
     2599   define variable res as integer no-undo .
     2600   define variable name-exe as character no-undo .
     2601     assign
     2602       file-info:file-name = "exe/run-act.bat".
     2603       name-exe = file-info:full-pathname
     2604     no-error .
     2605     if error-status :error then return error .
     2606   run gbl/syn.p ( input name-exe , input  exp-name , input  "Запуск " + name-exe , output res ).
     2607   if  res > 0
     2608   then do:
     2609     message  "Ошибка  при выполнении команды в ОС "  res .
     2610   end.
     2611     end.
     2612   END PROCEDURE.
     2613   PROCEDURE proc-save-param-RUM :
     2614     run verify-date in h_main no-error .
     2615     if error-status :error
     2616     then do:
     2617       undo, return error return-value .
     2618     end.
     2619     run verify-obj in h_main no-error .
     2620     if error-status :error
     2621     then do:
     2622       undo, return error return-value .
     2623     end.
     2624     run assign-frame in h_main .
     2625     run make-6-gds-list in h_main .
     2626     if param-alon = false   then do:
     2627       run initilize-page-3 in this-procedure .
     2628       run return-var in this-procedure .
     2629       if  (reportpageheight = 0  or reportpagewidth = 0)
     2630       and format-folder
     2631       then do:
     2632         run get-var-2 in h_format no-error.
     2633         if (reportpageheight = 0  or reportpagewidth = 0)
     2634         then do:
     2635           run select-page in this-procedure
     2636             (input 3
     2637             ) no-error .
     2638           undo, return error return-value .
     2639         end.
     2640       end.
     2641       run my-var in h_special no-error.
     2642       if error-status:error then
     2643        do:
     2644           case return-value:
     2645               When 'First-page':U then  do:
     2646                   return error.
     2647               end.
     2648               When 'Second-page':U then  do:
     2649                     message "Проверьте правильность заполнения формы!".
     2650                     run select-page in this-procedure ( 2 ).
     2651                     return  error .
     2652               end.
     2653               when 'format-page' then DO:
     2654                     message "Необходимо сходить на закладку <Формат...> !".
     2655                     run select-page in this-procedure ( 3 ).
     2656                     return error.
     2657               end.
     2658               otherwise  do:
     2659                   message "Необходимо сходить на закладку <Продолжение...> !".
     2660                   run select-page in this-procedure ( 2 ).
     2661                   return error.
     2662               end.
     2663           end case.
     2664        end.
     2665     end.
     2666     run my-params in h_special ( input "set" ) no-error .
     2667       IF ERROR-STATUS:ERROR then
     2668        DO:
     2669           run CloseForExcel in this-procedure  .
     2670           CASE RETURN-VALUE:
     2671           When 'First-page':U THEN  DO:
     2672                   return no-apply.
     2673                                     END.
     2674           When 'Second-page':U THEN  DO:
     2675                       message "Проверьте правильность заполнения формы!".
     2676                       RUN select-page IN THIS-PROCEDURE ( 2 ).
     2677                       return  no-apply .
     2678                                      END.
     2679           when 'format-page' then DO:
     2680                       message "На закладке <Формат...> необходимо выбрать поля для печати !".
     2681                       RUN select-page IN THIS-PROCEDURE ( 3 ).
     2682                       return no-apply.
     2683                       END.
     2684           OTHERWISE  DO:
     2685                       message "Необходимо сходить на закладку <Продолжение...> !".
     2686                       RUN select-page IN THIS-PROCEDURE ( 2 ).
     2687                       return no-apply.
     2688                       END.
     2689           End case.
     2690        End.
     2691        ELSE
     2692           CASE RETURN-VALUE:
     2693           When 'First-page':U THEN  DO:
     2694                   RUN select-page IN THIS-PROCEDURE ( 1 ).
     2695                   return no-apply.
     2696                                       END.
     2697           When 'Second-page':U THEN  DO:
     2698                       message "Проверьте правильность заполнения формы!".
     2699                       RUN select-page IN THIS-PROCEDURE ( 2 ).
     2700                       return  no-apply .
     2701                                       END.
     2702           When 'format-page':U THEN  DO:
     2703                       message "Проверьте правильность заполнения формы!".
     2704                       RUN select-page IN THIS-PROCEDURE ( 3 ).
     2705                       return  no-apply .
     2706                                       END.
     2707           End case.
     2708   END PROCEDURE.
