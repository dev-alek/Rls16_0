      721   procedure OpenForExcel :
      722      define variable v-ch#ExcelApplication as com-handle no-undo .
      723      define variable v-ch#Workbook         as com-handle no-undo .
      724      define variable v-ch#Worksheet        as com-handle no-undo .
      725      os-delete value( string( session:temp-directory ) +
      726                                 "rpt" + string( g#report-num ) + ".txt":U ) .
      727      os-delete value( string( session:temp-directory ) +
      728                                 "rpt" + string( g#report-num ) + ".frm":U ) .
      729      os-delete value( string( session:temp-directory ) +
      730                                 "rpt" + string( g#report-num ) + ".txl":U ) .
      731      if Make-Excel
      732      then do:
      733         output stream ForExcel to value( string( session:temp-directory +
      734                                        "rpt" + string( g#report-num ) + ".txt":U ) ) .
      735         assign
      736            v-excel-file = string( session:temp-directory + "rpt" + string( g#report-num ) )
      737            number-list = 1
      738         .
      739         if make-excel-com
      740         then do:
      741   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      742   if valid-handle(ch#WorkSheet) then
      743   RELEASE OBJECT ch#WorkSheet no-error.
      744   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      745   if valid-handle(ch#Workbook) then
      746   RELEASE OBJECT ch#Workbook no-error.
      747   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      748   if valid-handle(ch#ExcelApplication) then
      749   RELEASE OBJECT ch#ExcelApplication no-error.
      750            create "Excel.Application" ch#excelApplication connect no-error.
      751            if error-status:error
      752            then do :
      753           create "Excel.Application" ch#excelApplication no-error.
      754       if error-status :error then do:
      755           message
      756           "Ошибка при запуске Excel" skip
      757           error-status :get-message(1) skip
      758           view-as alert-box error .
      759           undo, return error .
      760       end.
      761            end.
      762            assign
      763               num#str#  = 0.
      764               v-ch#excelApplication  = ch#excelApplication.
      765               v-ch#excelApplication:Interactive = false.
      766               v-ch#excelApplication:ScreenUpdating = false.
      767               v-ch#excelApplication:Visible = false.
      768               ch#Workbook  = v-ch#excelApplication:Workbooks:add ().
      769               ch#WorkSheet = v-ch#excelApplication:Sheets:Item (1).
      770               v-ch#Worksheet = ch#WorkSheet.
      771               v-ch#Worksheet:Range ("A1"):Font:Bold = true.
      772               v-ch#Worksheet:Range ("A1"):Font:Size = 14.
      773               v-ch#Worksheet:Range ("A1"):HorizontalAlignment = -4131.
      774               v-ch#Worksheet:Range ("A1"):VerticalAlignment   = -4160
      775            no-error .
      776            if error-status:error
      777            then do:
      778               Make-Excel-com = false .
      779               Make-Excel = false .
      780               output Stream  ForExcel close.
      781               os-delete value( string( session:temp-directory ) +
      782                              "rpt" + string( g#report-num ) + ".txt":U ) .
      783               os-delete value( string( session:temp-directory ) +
      784                              "rpt" + string( g#report-num ) + ".frm":U ) .
      785               return.
      786            end.
      787         end.
      788      end.
      789   end.
      790   procedure CloseForExcel :
      791      define variable ii as integer no-undo .
      792      define variable vsheet-num as integer no-undo.
      793      if Make-Excel
      794      then  do:
      795         output Stream  ForExcel close.
      796         os-delete value( string( session:temp-directory ) +
      797                                "rpt" + string( g#report-num ) + ".txt":U ) .
      798         os-delete value( string( session:temp-directory ) +
      799                                "rpt" + string( g#report-num ) + ".frm":U ) .
      800         define buffer buf_sheetf for sheetf.
      801         find last buf_sheetf no-error .
      802         if available buf_sheetf
      803         then
      804            vsheet-num = buf_sheetf.sheet-num.
      805         if vsheet-num > 1
      806         then do:
      807            do ii = 2 to vsheet-num:
      808               os-delete value( string( session:temp-directory ) +
      809                                     "rpt" + string( g#report-num ) + ".":U  + string(ii)) .
      810            end.
      811         end.
      812   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      813   if valid-handle(ch#WorkSheet) then
      814   RELEASE OBJECT ch#WorkSheet no-error.
      815   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      816   if valid-handle(ch#Workbook) then
      817   RELEASE OBJECT ch#Workbook no-error.
      818   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      819   if valid-handle(ch#ExcelApplication) then
      820   RELEASE OBJECT ch#ExcelApplication no-error.
      821      end.
      822   end.
      823   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      824   procedure cur-time :
      825      define output parameter p-today as date      no-undo .
      826      define output parameter p-time  as integer   no-undo .
      827     do
      828     on error undo, return error
      829     :
      830       define variable v-date1 as date      no-undo .
      831       define variable v-date2 as date      no-undo .
      832       define variable v-time  as integer   no-undo .
      833       assign
      834         v-date1 = today
      835         v-time  = time
      836         v-date2 = today
      837       .
      838       if v-date1 <> v-date2
      839       then do:
      840         assign
      841           v-date1 = today
      842           v-time  = v-time
      843         .
      844       end.
      845       assign
      846         p-today = v-date1
      847         p-time  = v-time
      848       .
      849     end.
      850   end.
      851   function cur-time-date returns character
      852   :
      853     return string(today, '99/99/9999':U) .
      854   end.
      855   function cur-time-mjd returns decimal
      856   :
      857     define variable v-date as date      no-undo .
      858     define variable v-time as integer   no-undo .
      859     run cur-time in this-procedure
      860       (output v-date
      861       ,output v-time
      862       ) .
      863     return integer(v-date) - 2400002 + (v-time / 86400) .
      864   end.
      865   function cur-time-get-ending-index returns integer
      866   (input p-number as integer
      867   )
      868   :
      869     if p-number < 0
      870     or p-number = ?
      871     then do:
      872       return 1 .
      873     end.
      874     define variable v-rest as integer   no-undo .
      875     assign
      876       p-number = p-number modulo 100
      877     .
      878     if p-number < 20
      879     then do:
      880       assign
      881         v-rest = p-number
      882       .
      883     end.
      884     else do:
      885       assign
      886         v-rest = p-number modulo 10
      887       .
      888     end.
      889     case v-rest :
      890       when 1
      891       then do:
      892         return 2 .
      893       end.
      894       when 2 or
      895       when 3 or
      896       when 4
      897       then do:
      898         return 3 .
      899       end.
      900       otherwise do:
      901         return 1 .
      902       end.
      903     end case .
      904   end.
      905   procedure cur-time-mjd-to-date :
      906      define input  parameter i-mjd-diff as decimal no-undo.
      907      define output parameter o-Date     as date    no-undo.
      908      define output parameter o-Time     as integer no-undo.
      909      define variable v-day-number as integer   no-undo .
      910      if    i-mjd-diff < 0
      911         or i-mjd-diff = ?
      912      then do:
      913         return "?" .
      914      end.
      915      assign
      916         v-day-number = truncate(i-mjd-diff,0).
      917         o-Date = date(v-day-number + 2400002).
      918         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      919     .
      920   end.
      921   function cur-time-mjd-to-string returns character
      922   (input p-mjd-diff as decimal
      923   )
      924   :
      925     define variable v-day-number as integer   no-undo .
      926     define variable v-seconds    as integer   no-undo .
      927     define variable v-hour       as integer   no-undo .
      928     define variable v-min        as integer   no-undo .
      929     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      930     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      931     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      932     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      933     if p-mjd-diff < 0
      934     or p-mjd-diff = ?
      935     then do:
      936       return "?" .
      937     end.
      938     assign
      939       v-day-number = integer(truncate(p-mjd-diff,0))
      940       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      941     .
      942     if v-seconds > 86400
      943     then do:
      944       assign
      945         v-seconds = 86400 - 1
      946       .
      947     end.
      948     if v-seconds < 0
      949     then do:
      950       assign
      951         v-seconds = 0
      952       .
      953     end.
      954     assign
      955       v-hour = truncate(v-seconds / 3600, 0)
      956     .
      957     assign
      958       v-seconds = v-seconds modulo 3600
      959     .
      960     assign
      961       v-min = truncate(v-seconds / 60, 0)
      962     .
      963     assign
      964       v-seconds = v-seconds modulo 60
      965     .
      966     return
      967         (if v-day-number <> 0
      968           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      969           else ""
      970         )
      971       + (if v-day-number <> 0 or v-hour <> 0
      972           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      973           else ""
      974         )
      975       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      976           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      977           else ""
      978         )
      979       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      980       .
      981   end.
      982   function cur-time-string returns character
      983   :
      984     define variable v-date as date      no-undo .
      985     define variable v-time as integer   no-undo .
      986     run cur-time in this-procedure
      987       (output v-date
      988       ,output v-time
      989       ) .
      990     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      991   end.
      992   function cur-time-string-sec returns character
      993   :
      994     define variable v-date as date      no-undo .
      995     define variable v-time as integer   no-undo .
      996     run cur-time in this-procedure
      997       (output v-date
      998       ,output v-time
      999       ) .
     1000     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1001   end.
     1002   function cur-time-custom  returns character
     1003   (input p-prefix as character
     1004   ,input p-date-format as character
     1005   ,input p-delimiter as character
     1006   ,input p-time-format as character
     1007   ,input p-suffix as character
     1008   )
     1009   :
     1010     define variable v-date as date      no-undo .
     1011     define variable v-time as integer   no-undo .
     1012     run cur-time in this-procedure
     1013       (output v-date
     1014       ,output v-time
     1015       ) .
     1016     return
     1017       p-prefix
     1018       + string(v-date, p-date-format)
     1019       + p-delimiter
     1020       + string(v-time, p-time-format)
     1021       + p-suffix
     1022       .
     1023   end.
     1024   function cur-time-print  returns character
     1025   :
     1026     define variable v-date as date      no-undo .
     1027     define variable v-time as integer   no-undo .
     1028     run cur-time in this-procedure
     1029       (output v-date
     1030       ,output v-time
     1031       ) .
     1032     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1033   end.
     1034   function cur-time-datetime returns datetime
     1035   :
     1036     define variable v-char as character no-undo .
     1037     define variable v-datetime as datetime no-undo .
     1038     v-char = cur-time-string().
     1039     v-datetime = datetime(v-char).
     1040     return  v-datetime.
     1041   end.
     1042   function cur-time-string-msec returns character
     1043   :
     1044     define variable v-date as datetime  no-undo .
     1045     v-date = now.
     1046     return string(v-date) .
     1047   end.
     1048   define temp-table param-to-export no-undo
     1049   field param-code     as character
     1050   field param-sub-code as character
     1051   field param-type     as character
     1052   field param-value    as character
     1053   field param-comment  as character
     1054   index pi is unique primary  param-code     param-sub-code
     1055   .
     1056   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1057     define variable v-prg-bar_progress-bar  as class ProgressBar  no-undo .
     1058     procedure prg-bar_new-progress-bar :
     1059       define input  parameter p-min as int64   no-undo .
     1060       define input  parameter p-max as int64   no-undo .
     1061     do
     1062     on error undo, return error return-value
     1063     :
     1064       if v-prg-bar_progress-bar <> ?
     1065       then do:
     1066         run prg-bar_delete-progress-bar in this-procedure .
     1067       end.
     1068       v-prg-bar_progress-bar = new progressbar( p-min , p-max ).
     1069     end.
     1070     end procedure.
     1071     procedure prg-bar_delete-progress-bar :
     1072     do
     1073     on error undo, return error return-value
     1074     :
     1075       if v-prg-bar_progress-bar <> ?
     1076       then do:
     1077         delete object v-prg-bar_progress-bar.
     1078         assign
     1079           v-prg-bar_progress-bar = ?
     1080         .
     1081       end.
     1082     end.
     1083     end procedure.
     1084     procedure prg-bar_show-progress-bar :
     1085     do
     1086     on error undo, return error return-value
     1087     :
     1088       if v-prg-bar_progress-bar <> ?
     1089       then do:
     1090         v-prg-bar_progress-bar :show-bar() .
     1091       end.
     1092     end.
     1093     end procedure.
     1094     procedure prg-bar_increment-progress-bar :
     1095     do
     1096     on error undo, return error return-value
     1097     :
     1098       if v-prg-bar_progress-bar <> ?
     1099       then do:
     1100         v-prg-bar_progress-bar :increment() .
     1101       end.
     1102     end.
     1103     end procedure.
     1104     procedure prg-bar_title-progress-bar :
     1105       define input  parameter p-str as character no-undo .
     1106     do
     1107     on error undo, return error return-value
     1108     :
     1109       if v-prg-bar_progress-bar <> ?
     1110       then do:
     1111         assign
     1112           v-prg-bar_progress-bar :frame-title = p-str
     1113         .
     1114       end.
     1115     end.
     1116     end procedure.
     1117     procedure prg-bar_stepto-progress-bar :
     1118       define input  parameter p-val as integer   no-undo .
     1119     do
     1120     on error undo, return error return-value
     1121     :
     1122       if v-prg-bar_progress-bar <> ?
     1123       then do:
     1124           v-prg-bar_progress-bar :stepto( p-val ) .
     1125       end.
     1126     end.
     1127     end procedure.
     1128   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1129   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1130   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     1131   define variable par-type          as character no-undo.
     1132   define variable v-value-character as character no-undo .
     1133   define variable v-value-date      as date      no-undo .
     1134   define variable v-value-decimal   as decimal   no-undo .
     1135   define variable v-value-integer   as integer   no-undo .
     1136   define variable v-value-logical   as logical   no-undo .
     1137   define variable v-type-folder-list  as character no-undo .
     1138   define variable b_ach as handle no-undo .
     1139   define variable g#log as logical no-undo .
