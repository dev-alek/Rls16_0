      156   def
      157   NEW shared
      158   temp-table  obj-list no-undo
      159     field obj-type like ub.clients.obj-type
      160     field obj-code like ub.clients.obj-code
      161     field obj-name like ub.clients.obj-name
      162     field obj-id   as integer
