      168   procedure create_obj-list :
      169      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      170      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      171      do
      172      on error undo, return error return-value
      173      :
      174         define buffer cli-obj for ub.clients .
      175         define variable p-var as integer no-undo .
      176         define buffer buf_obj-list for obj-list .
      177         find last buf_obj-list  use-index pi no-error .
      178         if available buf_obj-list
      179         then
      180            p-var = buf_obj-list.obj-id + 1.
      181         else
      182            p-var = 1.
      183         find first cli-obj where
      184                   cli-obj.obj-type = p-obj-type
      185               and cli-obj.obj-code = p-obj-code
      186         no-lock no-error.
      187         if available cli-obj
      188         then do:
      189            create buf_obj-list.
      190            assign
      191               buf_obj-list.obj-id   = p-var
      192               buf_obj-list.obj-code = cli-obj.obj-code
      193               buf_obj-list.obj-type = cli-obj.obj-type
      194               buf_obj-list.obj-name = cli-obj.obj-name
      195               buf_obj-list.db-num   = cli-obj.db-num
      196            .
      197         end.
      198      end.
      199   end.
