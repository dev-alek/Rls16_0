     6872           display STREAM OutStream    with frame top-frame .
     6873       End.
     6874     End.
     6875     if c-f-sale-pr <>  ?  then do :
     6876       c-f-sale-pr:screen-value = string(f-sale-pr) .
     6877       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6878           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6879           display STREAM OutStream    with frame top-frame .
     6880       End.
     6881     End.
     6882     if c-f-sale-sum <>  ?  then do :
     6883       c-f-sale-sum:screen-value = string(f-sale-sum) .
     6884       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6885           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6886           display STREAM OutStream    with frame top-frame .
     6887       End.
     6888     End.
     6889     if c-f-sale-other <>  ?  then do :
     6890       c-f-sale-other:screen-value = string(f-sale-other) .
     6891       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
