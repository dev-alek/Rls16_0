     5178       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     5179           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     5180           display STREAM OutStream    with frame top-frame .
     5181       End.
     5182     End.
     5183   if c-f-qnty <>  ?  then do :
     5184   Assign
