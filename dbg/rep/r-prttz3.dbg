     6136                       buff_doc-line.prod-code  = bufd_gds-dtl.prod-code
     6137                       :
     6138                       assign
     6139                         f-rez-qnty = f-rez-qnty  + bufd_gds-dtl.doc-qnty
     6140                         f-rez-cost = f-rez-cost  + ( bufd_gds-dtl.doc-qnty * buff_doc-line.price-rubl )
     6141                         f-rez-sale = f-rez-sale  + ( bufd_gds-dtl.doc-qnty * bufd_gds-dtl.price-rubl )
     6142                         f-rez-cost-pr = ( if f-rez-qnty = 0 then 0 else f-rez-cost / f-rez-qnty )
     6143                       .
     6144                       create temp_gds-dtl.
     6145                       buffer-copy bufd_gds-dtl to temp_gds-dtl
     6146                       assign
     6147                           temp_gds-dtl.cost-sum = bufd_gds-dtl.doc-qnty * buff_doc-line.price-rubl
     6148                           temp_gds-dtl.sale-sum = bufd_gds-dtl.doc-qnty * bufd_gds-dtl.price-rubl
     6149                       .
     6150             end.
     6151      end.
     6152   end.
     6153                 f-sale-other = 100 * determined((f-sale-sum - f-cost-sum) / f-cost-sum).
     6154                 if c-f-wait-qnty <> ? Then DO :
