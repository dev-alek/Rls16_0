     6912       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6913           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6914           display STREAM OutStream    with frame top-frame .
     6915       End.
     6916     End.
     6917     if c-f-rez-cost <>  ?  then do :
     6918       c-f-rez-cost:screen-value = string(f-rez-cost) .
     6919       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
