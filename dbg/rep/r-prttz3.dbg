     5789                 accumulate f-wait-qnty      (TOTAL ) .
     5790       accumulate f-rez-qnty   (TOTAL ) .
     5791       accumulate f-rez-cost   (TOTAL ) .
     5792       accumulate f-rez-sale   (TOTAL ) .
     5793         Assign
     5794           f-qnty          = 0
     5795           f-cost-sum      = 0
     5796           f-sale-sum      = 0
     5797           f-sale-other    = 0
     5798           f-free-qnty     = 0
     5799           f-wait-qnty     = 0
     5800           f-rez-qnty      = 0
     5801           f-rez-cost      = 0
     5802           f-rez-sale      = 0
     5803           .
     5804    End.
