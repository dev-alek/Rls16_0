     7188   procedure foreach4t :
     7189   define variable pr-cursor as integer no-undo init 0.
     7190   define variable go-work   as logical no-undo init no.
     7191    For Each gds-obj no-lock  where
     7192             gds-obj.obj-code    = obj-list.obj-code and
     7193             gds-obj.obj-type    = obj-list.obj-type,
     7194             first goods no-lock where
     7195                   goods.prod-type = gds-obj.prod-type and
     7196                   goods.prod-code = gds-obj.prod-code and
     7197                   goods.artic     = gds-obj.artic
     7198                   :
     7199        find first gds-list where gds-list.gds-code = gds-obj.gds-code  no-error .
     7200        if not available  gds-list then create gds-list .
     7201        buffer-copy goods to gds-list
     7202        assign
     7203          gds-list.qnty = func-vat ( input gds-obj.gds-code , input gds-obj.obj-type, input gds-obj.obj-code)
     7204        .
     7205    end.
     7206   .
     7207    For each obj-list ,
     7208        each gds-obj where
     7209             gds-obj.obj-code    = obj-list.obj-code and
     7210             gds-obj.obj-type    = obj-list.obj-type
     7211             no-lock,
     7212       first goods where
     7213             goods.prod-type = gds-obj.prod-type and
     7214             goods.prod-code = gds-obj.prod-code and
     7215             goods.artic     = gds-obj.artic  and
     7216             goods.gds-type    = 'т':U
     7217             no-lock
     7218             , first gds-list where
     7219                     gds-list.prod-type = gds-obj.prod-type and
     7220                     gds-list.prod-code = gds-obj.prod-code and
     7221                     gds-list.artic     = gds-obj.artic
     7222                     no-lock
     7223                   break
     7224                   by gds-list.qnty
     7225                    by ( gds-obj.artic + gds-obj.prod-type + string ( gds-obj.prod-code ))
     7226                     by gds-obj.artic
     7227                    with FRAME Zapas :
     7228                    pr-cursor = 0.
     7229                    go-work = false.
     7230                    if v-prizn = "" then go-work = true.
     7231                     else if goods.prt-root <> Prtroot then
     7232                     do while pr-cursor < num-entries(v-prizn,","):
     7233                         pr-cursor = pr-cursor + 1.
     7234                         if entry(pr-cursor,v-prizn,",") <> "" then do:
     7235                             for first prt-obj where
     7236                             prt-obj.artic     = goods.artic     and
     7237                             prt-obj.prod-type = goods.prod-type and
     7238                             prt-obj.prod-code = goods.prod-code and
     7239                             prt-obj.obj-code  = obj-list.obj-code and
     7240                             prt-obj.obj-type  = obj-list.obj-type and
     7241                             prt-obj.is-term   =  true  and
     7242                             prt-obj.prt-code  = integer(entry(pr-cursor,v-prizn,","))
     7243                             no-lock:
     7244                                 pr-cursor = num-entries(v-prizn,",").
     7245                                 go-work = true.
     7246                             end.
     7247                         end.
     7248                     end.
     7249                     if go-work then do:
     7250                 n-nm = n-nm + 1.
     7251   IF ( n-nm modulo v-account = 0 )  then DO:
     7252             if  log-manager:logfile-name ne ?
     7253             then DO:
     7254                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     7255             end.
     7256              if mFrameView
     7257              then do:
     7258               DISPLAY
     7259                 n-nm @ RecordsDone
     7260                 WITH FRAME InfoFrame.
     7261              end.
     7262   End.
     7263      if v-button-stop then  DO:
     7264            if mFrameView
     7265            then
     7266               PROCESS EVENTS.
     7267            IF StopProcessing THEN DO:
     7268            RETURN error.
     7269            End.
     7270      end.
     7271                 IF first-of(gds-obj.artic) then DO:
     7272                   assign
     7273                     f-qnty         = 0
     7274                     f-cost-sum     = 0
     7275                     f-sale-sum     = 0
     7276                     f-cost-pr      = 0
     7277                     f-sale-pr      = 0
     7278                     f-sale-other   = 0
     7279                     f-free-qnty    = 0
     7280                     f-wait-qnty    = 0
     7281                     f-rez-qnty     = 0
     7282                     f-rez-cost     = 0
     7283                     f-rez-sale     = 0
     7284                     f-rez-cost-pr  = 0
     7285                     tot-v-sale-sum = 0
     7286                     tot-v-cost-sum = 0
     7287                     .
     7288               End.
     7289       if first-of(gds-list.qnty) then do:
     7290           var-client = string(gds-list.qnty) + '%'.
     7291           if  itog = false then do:
     7292     if c-f-gds-name <>  ?  then do :
     7293       c-f-gds-name:screen-value = string('Ставка НДС ' + string(gds-list.qnty) + '%') .
     7294       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7295           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7296           display STREAM OutStream    with frame top-frame .
     7297       End.
     7298     End.
     7299             display stream outstream .
     7300             down stream outstream .
     7301             if Make-Excel then  put   stream ForExcel unformatted 'Ставка НДС ' + string(gds-list.qnty) + '%' chr(10) .
     7302           end.
     7303       end.
     7304   if last-of(gds-obj.artic) then DO:
     7305    IF v-var = "no-today" then DO:
     7306                  run ost-line in this-procedure
     7307                  (input   gds-obj.obj-code  ,
     7308                   input   gds-obj.obj-type  ,
     7309                   input   gds-obj.artic     ,
     7310                   input   gds-obj.prod-code ,
     7311                   input   gds-obj.prod-type ,
     7312                   input   0                 ,
     7313                   input   fact-order-2      ,
     7314                   input   'crsa':U       ,
     7315                   input   '##,##':U    ,
     7316                   input   false             ,
     7317                   output  quantity1         ,
     7318                   output  coast_r1          ,
     7319                   output  coast_v1          ,
     7320                   output  vat_r1            ,
     7321                   output  vat_v1            ,
     7322                   output  slt_r1            ,
     7323                   output  slt_v1            ).
     7324                Assign
     7325                   f-qnty       = Quantity1
     7326                   f-sale-sum   = if tprintrubl then Coast_R1 else Coast_V1
     7327                   f-sale-pr    = if f-qnty = 0 then 0 else f-sale-sum / f-qnty
     7328                   .
     7329                  run ost-line in this-procedure
     7330                  (input   gds-obj.obj-code  ,
     7331                   input   gds-obj.obj-type  ,
     7332                   input   gds-obj.artic     ,
     7333                   input   gds-obj.prod-code ,
     7334                   input   gds-obj.prod-type ,
     7335                   input   0                 ,
     7336                   input   fact-order-2      ,
     7337                   input   'cost':U       ,
     7338                   input   '##,##':U    ,
     7339                   input   false             ,
     7340                   output  quantity1   ,
     7341                   output  coast_r1  ,
     7342                   output  coast_v1  ,
     7343                   output  vat_r1    ,
     7344                   output  vat_v1    ,
     7345                   output  slt_r1    ,
     7346                   output  slt_v1    ).
     7347                Assign
     7348                   f-cost-sum   = if tprintrubl then Coast_R1 else Coast_V1
     7349                   f-cost-pr    = if Quantity1 = 0 then 0 else ( f-cost-sum / Quantity1 )
     7350                   .
     7351   end.
     7352   else do:
     7353      empty temp-table t-trn-doc .
     7354      empty temp-table temp_gds-dtl .
     7355      if v-prizn <> "" and goods.prt-root <> Prtroot then do:
     7356        pr-cursor = 0.
     7357        f-qnty = 0.
     7358        do while pr-cursor < num-entries(v-prizn,","):
     7359            pr-cursor = pr-cursor + 1.
     7360            if entry(pr-cursor,v-prizn,",") <> "" then do:
     7361                for each sl-obj-list,
     7362                first buf_gds-obj no-lock where
     7363                buf_gds-obj.gds-code =  goods.gds-code and
     7364                buf_gds-obj.obj-type =  sl-obj-list.obj-type and
     7365                buf_gds-obj.obj-code =  sl-obj-list.obj-code :
     7366                    for each prt-obj no-lock where prt-obj.prt-code = integer(entry(pr-cursor,v-prizn,","))
     7367                    and prt-obj.artic = buf_gds-obj.artic
     7368                    and prt-obj.obj-code = buf_gds-obj.obj-code
     7369                    and prt-obj.obj-type = buf_gds-obj.obj-type
     7370                    and prt-obj.is-term   =  true
     7371                    :
     7372                    assign
     7373                       f-qnty       =  f-qnty + prt-obj.fact-qnty
     7374                       f-cost-sum   = f-cost-sum + if buf_gds-obj.fact-qnty = 0 then 0 else prt-obj.fact-qnty * determined(buf_gds-obj.fact-rubl) / buf_gds-obj.fact-qnty
     7375                       f-sale-sum   = f-sale-sum + if buf_gds-obj.fact-qnty = 0 then 0 else prt-obj.fact-qnty * buf_gds-obj.fact-sale / buf_gds-obj.fact-qnty
     7376                       f-free-qnty  = f-free-qnty + prt-obj.free-qnty
     7377                       f-cost-pr   = if prt-obj.fact-qnty  = 0 then 0 else determined(buf_gds-obj.fact-rubl) / buf_gds-obj.fact-qnty
     7378                       f-sale-pr   = if prt-obj.fact-qnty  = 0 then 0 else prt-obj.price-sale
     7379                       .
     7380                    end.
     7381                end.
     7382            end.
     7383        end.
     7384      end.
     7385      else do:
     7386          for each sl-obj-list,
     7387              first buf_gds-obj no-lock where
     7388                    buf_gds-obj.gds-code =  goods.gds-code and
     7389                    buf_gds-obj.obj-type =  sl-obj-list.obj-type and
     7390                    buf_gds-obj.obj-code =  sl-obj-list.obj-code :
     7391              assign
     7392               f-qnty       = f-qnty      + buf_gds-obj.fact-qnty
     7393               f-cost-sum   = f-cost-sum  + determined(buf_gds-obj.fact-rubl)
     7394               f-sale-sum   = f-sale-sum  + buf_gds-obj.fact-sale
     7395               f-free-qnty  = f-free-qnty + buf_gds-obj.free-qnty
     7396               f-cost-pr   = if f-qnty = 0 then 0 else f-cost-sum / f-qnty
     7397               f-sale-pr   = if f-qnty = 0 then 0 else f-sale-sum / f-qnty
     7398             .
     7399       end.
     7400         for each buf_parts no-lock where
     7401                   buf_parts.artic      = buf_gds-obj.artic       and
     7402                   buf_parts.prod-type  = buf_gds-obj.prod-type   and
     7403                   buf_parts.prod-code  = buf_gds-obj.prod-code   and
     7404                   buf_parts.obj-type   = buf_gds-obj.obj-type    and
     7405                   buf_parts.obj-code   = buf_gds-obj.obj-code    and
     7406                   buf_parts.status_    = false               and
     7407                   buf_parts.rsrv-free  = true    ,
     7408           first bufi_trn-doc no-lock where
     7409                 bufi_trn-doc.doc-code = buf_parts.out-code
     7410                 and
     7411               ( bufi_trn-doc.doc-type = 'рас':U or
     7412                 bufi_trn-doc.doc-type = 'спи':U )
     7413                 :
     7414                 if not can-find( first t-trn-doc where t-trn-doc.doc-code = bufi_trn-doc.doc-code) then do:
     7415                     create t-trn-doc.
     7416                     assign
     7417                     t-trn-doc.doc-code = bufi_trn-doc.doc-code .
     7418                     .
     7419                 end.
     7420               end.
     7421      end.
     7422         for each t-trn-doc :
     7423             for each  bufd_gds-dtl no-lock where
     7424                       bufd_gds-dtl.doc-code   = t-trn-doc.doc-code  and
     7425                       bufd_gds-dtl.artic      = buf_gds-obj.artic       and
     7426                       bufd_gds-dtl.prod-type  = buf_gds-obj.prod-type   and
     7427                       bufd_gds-dtl.prod-code  = buf_gds-obj.prod-code ,
     7428                 first buff_doc-line no-lock where
     7429                       buff_doc-line.doc-code   = bufd_gds-dtl.doc-code  and
     7430                       buff_doc-line.artic      = bufd_gds-dtl.artic     and
     7431                       buff_doc-line.prod-type  = bufd_gds-dtl.prod-type and
     7432                       buff_doc-line.prod-code  = bufd_gds-dtl.prod-code
     7433                       :
     7434                       assign
     7435                         f-rez-qnty = f-rez-qnty  + bufd_gds-dtl.doc-qnty
     7436                         f-rez-cost = f-rez-cost  + ( bufd_gds-dtl.doc-qnty * buff_doc-line.price-rubl )
     7437                         f-rez-sale = f-rez-sale  + ( bufd_gds-dtl.doc-qnty * bufd_gds-dtl.price-rubl )
     7438                         f-rez-cost-pr = ( if f-rez-qnty = 0 then 0 else f-rez-cost / f-rez-qnty )
     7439                       .
     7440                       create temp_gds-dtl.
     7441                       buffer-copy bufd_gds-dtl to temp_gds-dtl
     7442                       assign
     7443                           temp_gds-dtl.cost-sum = bufd_gds-dtl.doc-qnty * buff_doc-line.price-rubl
     7444                           temp_gds-dtl.sale-sum = bufd_gds-dtl.doc-qnty * bufd_gds-dtl.price-rubl
     7445                       .
     7446             end.
     7447      end.
     7448   end.
     7449                 f-sale-other = 100 * determined((f-sale-sum - f-cost-sum) / f-cost-sum).
     7450                 if c-f-wait-qnty <> ? Then DO :
     7451                  for each sl-obj-list :
     7452                   for each trn-doc no-lock  where
     7453                       trn-doc.obj-code        = sl-obj-list.obj-code and
     7454                       trn-doc.obj-type        = sl-obj-list.obj-type and
     7455                       trn-doc.status_         = 'накл':U           and
     7456                       trn-doc.flag_           = true              and
     7457                       trn-doc.Fact-order      <= fact-order-2     and
     7458                       trn-doc.ext-doc-type    = 'ie':U :
     7459                       for each doc-line no-lock where
     7460                           doc-line.doc-code   = trn-doc.doc-code   and
     7461                           doc-line.artic      = goods.artic        and
     7462                           doc-line.prod-code  = goods.prod-code    and
     7463                           doc-line.prod-type  = goods.prod-type    :
     7464                               Assign
     7465                                 f-wait-qnty   = f-wait-qnty     + doc-line.fact-qnty.
     7466                       end.
     7467                   End.
     7468                  End.
     7469                 End.
     7470                if itog = false and
     7471                ( p-zero-ost = true or
     7472                   not(f-qnty         = 0 and
     7473                       f-cost-sum     = 0 and
     7474                       f-sale-sum     = 0 and
     7475                       f-sale-other   = 0 and
     7476                       f-free-qnty    = 0 and
     7477                       f-wait-qnty    = 0  ))
     7478                   Then DO:
     7479                       n-nn = n-nn + 1 .
     7480   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
