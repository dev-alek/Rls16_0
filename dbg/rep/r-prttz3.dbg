     6893           display STREAM OutStream    with frame top-frame .
     6894       End.
     6895     End.
     6896     if c-f-free-qnty <>  ?  then do :
     6897       c-f-free-qnty:screen-value = string(f-free-qnty) .
     6898       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6899           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6900           display STREAM OutStream    with frame top-frame .
     6901       End.
     6902     End.
     6903     if c-f-wait-qnty <>  ?  then do :
     6904       c-f-wait-qnty:screen-value = string(f-wait-qnty) .
     6905       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
