     6497       c-f-free-qnty:screen-value = string(accum TOTAL f-free-qnty) .
     6498       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6499           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6500           display STREAM OutStream    with frame top-frame .
     6501       End.
     6502     End.
     6503     if c-f-wait-qnty <>  ?  then do :
     6504       c-f-wait-qnty:screen-value = string(accum TOTAL f-wait-qnty) .
     6505       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6506           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6507           display STREAM OutStream    with frame top-frame .
     6508       End.
     6509     End.
     6510     if c-f-rez-qnty <>  ?  then do :
     6511       c-f-rez-qnty:screen-value = string(accum TOTAL f-rez-qnty) .
     6512       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6513           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6514           display STREAM OutStream    with frame top-frame .
     6515       End.
     6516     End.
     6517     if c-f-rez-cost <>  ?  then do :
     6518       c-f-rez-cost:screen-value = string(accum TOTAL f-rez-cost) .
     6519       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6520           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6521           display STREAM OutStream    with frame top-frame .
     6522       End.
     6523     End.
     6524     if c-f-rez-sale <>  ?  then do :
     6525       c-f-rez-sale:screen-value = string(accum TOTAL f-rez-sale) .
     6526       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6527           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6528           display STREAM OutStream    with frame top-frame .
     6529       End.
     6530     End.
     6531   dIsplay stream OutStream with FRAME Zapas no-error .
     6532   down stream OutStream with FRAME Zapas.
     6533   run u-line in this-procedure.
     6534   if Make-Excel then  put   stream ForExcel unformatted
     6535   "ИТОГО"                       CHR(9)
     6536   "ПО ВСЕМ ОБЬЕКТАМ"            CHR(9) CHR(9) CHR(9)
     6537    CHR(9)
     6538   excel-qnty(accum TOTAL f-qnty           )   CHR(9)
     6539   CHR(9)
     6540   excel-sum (accum TOTAL f-cost-sum       )   CHR(9)
     6541   CHR(9)
     6542   excel-sum (accum TOTAL f-sale-sum       )   CHR(9)
     6543   excel-sum (accum TOTAL f-sale-other     )   CHR(9)
     6544   excel-sum (accum TOTAL f-free-qnty      )   CHR(9)
     6545   excel-sum (accum TOTAL f-wait-qnty      )   CHR(9)
     6546   excel-sum (accum TOTAL f-rez-qnty   )   CHR(9)
     6547   excel-sum (accum TOTAL f-rez-cost   )   CHR(9)
     6548   excel-sum (accum TOTAL f-rez-sale   )   CHR(9)
     6549   chr(10) .
     6550   end procedure.
     6551   procedure foreach3t :
     6552   define variable pr-cursor as integer no-undo init 0.
     6553   define variable go-work   as logical no-undo init no.
     6554   .
     6555    For each obj-list ,
     6556        each gds-obj where
     6557             gds-obj.obj-code    = obj-list.obj-code and
     6558             gds-obj.obj-type    = obj-list.obj-type
     6559             no-lock,
     6560       first goods where
     6561             goods.prod-type = gds-obj.prod-type and
     6562             goods.prod-code = gds-obj.prod-code and
     6563             goods.artic     = gds-obj.artic  and
     6564             goods.gds-type    = 'т':U
     6565             no-lock
     6566             , first gds-list where
     6567                     gds-list.prod-type = gds-obj.prod-type and
     6568                     gds-list.prod-code = gds-obj.prod-code and
     6569                     gds-list.artic     = gds-obj.artic
     6570                     no-lock
     6571                   break
     6572                   by goods.grp-name
     6573                    by ( gds-obj.artic + gds-obj.prod-type + string ( gds-obj.prod-code ))
     6574                     by gds-obj.artic
     6575                    with FRAME Zapas :
     6576                    pr-cursor = 0.
     6577                    go-work = false.
     6578                    if v-prizn = "" then go-work = true.
     6579                     else if goods.prt-root <> Prtroot then
     6580                     do while pr-cursor < num-entries(v-prizn,","):
     6581                         pr-cursor = pr-cursor + 1.
     6582                         if entry(pr-cursor,v-prizn,",") <> "" then do:
     6583                             for first prt-obj where
     6584                             prt-obj.artic     = goods.artic     and
     6585                             prt-obj.prod-type = goods.prod-type and
     6586                             prt-obj.prod-code = goods.prod-code and
     6587                             prt-obj.obj-code  = obj-list.obj-code and
     6588                             prt-obj.obj-type  = obj-list.obj-type and
     6589                             prt-obj.is-term   =  true  and
     6590                             prt-obj.prt-code  = integer(entry(pr-cursor,v-prizn,","))
     6591                             no-lock:
     6592                                 pr-cursor = num-entries(v-prizn,",").
     6593                                 go-work = true.
     6594                             end.
     6595                         end.
     6596                     end.
     6597                     if go-work then do:
     6598                 n-nm = n-nm + 1.
     6599   IF ( n-nm modulo v-account = 0 )  then DO:
     6600             if  log-manager:logfile-name ne ?
     6601             then DO:
     6602                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     6603             end.
     6604              if mFrameView
     6605              then do:
     6606               DISPLAY
     6607                 n-nm @ RecordsDone
     6608                 WITH FRAME InfoFrame.
     6609              end.
     6610   End.
     6611      if v-button-stop then  DO:
     6612            if mFrameView
     6613            then
     6614               PROCESS EVENTS.
     6615            IF StopProcessing THEN DO:
     6616            RETURN error.
     6617            End.
     6618      end.
     6619                 IF first-of(gds-obj.artic) then DO:
     6620                   assign
     6621                     f-qnty         = 0
     6622                     f-cost-sum     = 0
     6623                     f-sale-sum     = 0
     6624                     f-cost-pr      = 0
     6625                     f-sale-pr      = 0
     6626                     f-sale-other   = 0
     6627                     f-free-qnty    = 0
     6628                     f-wait-qnty    = 0
     6629                     f-rez-qnty     = 0
     6630                     f-rez-cost     = 0
     6631                     f-rez-sale     = 0
     6632                     f-rez-cost-pr  = 0
     6633                     tot-v-sale-sum = 0
     6634                     tot-v-cost-sum = 0
     6635                     .
     6636               End.
     6637             if first-of(goods.grp-name) then  DO:
     6638                var-client = goods.grp-name.
     6639                     if  Itog = false Then do:
     6640                       PUT stream OutStream  goods.grp-name  AT 1 format "X(160)" SKIP.
     6641                       DOWN stream OutStream .
     6642                       if Make-Excel then  put   stream ForExcel unformatted goods.grp-name chr(10) .
     6643                     End.
     6644             End.
     6645   if last-of(gds-obj.artic) then DO:
     6646    IF v-var = "no-today" then DO:
     6647                  run ost-line in this-procedure
     6648                  (input   gds-obj.obj-code  ,
     6649                   input   gds-obj.obj-type  ,
     6650                   input   gds-obj.artic     ,
     6651                   input   gds-obj.prod-code ,
     6652                   input   gds-obj.prod-type ,
     6653                   input   0                 ,
     6654                   input   fact-order-2      ,
     6655                   input   'crsa':U       ,
     6656                   input   '##,##':U    ,
     6657                   input   false             ,
     6658                   output  quantity1         ,
     6659                   output  coast_r1          ,
     6660                   output  coast_v1          ,
     6661                   output  vat_r1            ,
     6662                   output  vat_v1            ,
     6663                   output  slt_r1            ,
     6664                   output  slt_v1            ).
     6665                Assign
     6666                   f-qnty       = Quantity1
     6667                   f-sale-sum   = if tprintrubl then Coast_R1 else Coast_V1
     6668                   f-sale-pr    = if f-qnty = 0 then 0 else f-sale-sum / f-qnty
     6669                   .
     6670                  run ost-line in this-procedure
     6671                  (input   gds-obj.obj-code  ,
     6672                   input   gds-obj.obj-type  ,
     6673                   input   gds-obj.artic     ,
     6674                   input   gds-obj.prod-code ,
     6675                   input   gds-obj.prod-type ,
     6676                   input   0                 ,
     6677                   input   fact-order-2      ,
     6678                   input   'cost':U       ,
     6679                   input   '##,##':U    ,
     6680                   input   false             ,
     6681                   output  quantity1   ,
     6682                   output  coast_r1  ,
     6683                   output  coast_v1  ,
     6684                   output  vat_r1    ,
     6685                   output  vat_v1    ,
     6686                   output  slt_r1    ,
     6687                   output  slt_v1    ).
     6688                Assign
     6689                   f-cost-sum   = if tprintrubl then Coast_R1 else Coast_V1
     6690                   f-cost-pr    = if Quantity1 = 0 then 0 else ( f-cost-sum / Quantity1 )
     6691                   .
     6692   end.
     6693   else do:
     6694      empty temp-table t-trn-doc .
     6695      empty temp-table temp_gds-dtl .
     6696      if v-prizn <> "" and goods.prt-root <> Prtroot then do:
     6697        pr-cursor = 0.
     6698        f-qnty = 0.
     6699        do while pr-cursor < num-entries(v-prizn,","):
     6700            pr-cursor = pr-cursor + 1.
     6701            if entry(pr-cursor,v-prizn,",") <> "" then do:
     6702                for each sl-obj-list,
     6703                first buf_gds-obj no-lock where
     6704                buf_gds-obj.gds-code =  goods.gds-code and
     6705                buf_gds-obj.obj-type =  sl-obj-list.obj-type and
     6706                buf_gds-obj.obj-code =  sl-obj-list.obj-code :
     6707                    for each prt-obj no-lock where prt-obj.prt-code = integer(entry(pr-cursor,v-prizn,","))
     6708                    and prt-obj.artic = buf_gds-obj.artic
     6709                    and prt-obj.obj-code = buf_gds-obj.obj-code
     6710                    and prt-obj.obj-type = buf_gds-obj.obj-type
     6711                    and prt-obj.is-term   =  true
     6712                    :
     6713                    assign
     6714                       f-qnty       =  f-qnty + prt-obj.fact-qnty
     6715                       f-cost-sum   = f-cost-sum + if buf_gds-obj.fact-qnty = 0 then 0 else prt-obj.fact-qnty * determined(buf_gds-obj.fact-rubl) / buf_gds-obj.fact-qnty
     6716                       f-sale-sum   = f-sale-sum + if buf_gds-obj.fact-qnty = 0 then 0 else prt-obj.fact-qnty * buf_gds-obj.fact-sale / buf_gds-obj.fact-qnty
     6717                       f-free-qnty  = f-free-qnty + prt-obj.free-qnty
     6718                       f-cost-pr   = if prt-obj.fact-qnty  = 0 then 0 else determined(buf_gds-obj.fact-rubl) / buf_gds-obj.fact-qnty
     6719                       f-sale-pr   = if prt-obj.fact-qnty  = 0 then 0 else prt-obj.price-sale
     6720                       .
     6721                    end.
     6722                end.
     6723            end.
     6724        end.
     6725      end.
     6726      else do:
     6727          for each sl-obj-list,
     6728              first buf_gds-obj no-lock where
     6729                    buf_gds-obj.gds-code =  goods.gds-code and
     6730                    buf_gds-obj.obj-type =  sl-obj-list.obj-type and
     6731                    buf_gds-obj.obj-code =  sl-obj-list.obj-code :
     6732              assign
     6733               f-qnty       = f-qnty      + buf_gds-obj.fact-qnty
     6734               f-cost-sum   = f-cost-sum  + determined(buf_gds-obj.fact-rubl)
     6735               f-sale-sum   = f-sale-sum  + buf_gds-obj.fact-sale
     6736               f-free-qnty  = f-free-qnty + buf_gds-obj.free-qnty
     6737               f-cost-pr   = if f-qnty = 0 then 0 else f-cost-sum / f-qnty
     6738               f-sale-pr   = if f-qnty = 0 then 0 else f-sale-sum / f-qnty
     6739             .
     6740       end.
     6741         for each buf_parts no-lock where
     6742                   buf_parts.artic      = buf_gds-obj.artic       and
     6743                   buf_parts.prod-type  = buf_gds-obj.prod-type   and
     6744                   buf_parts.prod-code  = buf_gds-obj.prod-code   and
     6745                   buf_parts.obj-type   = buf_gds-obj.obj-type    and
     6746                   buf_parts.obj-code   = buf_gds-obj.obj-code    and
     6747                   buf_parts.status_    = false               and
     6748                   buf_parts.rsrv-free  = true    ,
     6749           first bufi_trn-doc no-lock where
     6750                 bufi_trn-doc.doc-code = buf_parts.out-code
     6751                 and
     6752               ( bufi_trn-doc.doc-type = 'рас':U or
     6753                 bufi_trn-doc.doc-type = 'спи':U )
     6754                 :
     6755                 if not can-find( first t-trn-doc where t-trn-doc.doc-code = bufi_trn-doc.doc-code) then do:
     6756                     create t-trn-doc.
     6757                     assign
     6758                     t-trn-doc.doc-code = bufi_trn-doc.doc-code .
     6759                     .
     6760                 end.
     6761               end.
     6762      end.
     6763         for each t-trn-doc :
     6764             for each  bufd_gds-dtl no-lock where
     6765                       bufd_gds-dtl.doc-code   = t-trn-doc.doc-code  and
     6766                       bufd_gds-dtl.artic      = buf_gds-obj.artic       and
     6767                       bufd_gds-dtl.prod-type  = buf_gds-obj.prod-type   and
     6768                       bufd_gds-dtl.prod-code  = buf_gds-obj.prod-code ,
     6769                 first buff_doc-line no-lock where
     6770                       buff_doc-line.doc-code   = bufd_gds-dtl.doc-code  and
     6771                       buff_doc-line.artic      = bufd_gds-dtl.artic     and
     6772                       buff_doc-line.prod-type  = bufd_gds-dtl.prod-type and
     6773                       buff_doc-line.prod-code  = bufd_gds-dtl.prod-code
     6774                       :
     6775                       assign
     6776                         f-rez-qnty = f-rez-qnty  + bufd_gds-dtl.doc-qnty
     6777                         f-rez-cost = f-rez-cost  + ( bufd_gds-dtl.doc-qnty * buff_doc-line.price-rubl )
     6778                         f-rez-sale = f-rez-sale  + ( bufd_gds-dtl.doc-qnty * bufd_gds-dtl.price-rubl )
     6779                         f-rez-cost-pr = ( if f-rez-qnty = 0 then 0 else f-rez-cost / f-rez-qnty )
     6780                       .
     6781                       create temp_gds-dtl.
     6782                       buffer-copy bufd_gds-dtl to temp_gds-dtl
     6783                       assign
     6784                           temp_gds-dtl.cost-sum = bufd_gds-dtl.doc-qnty * buff_doc-line.price-rubl
     6785                           temp_gds-dtl.sale-sum = bufd_gds-dtl.doc-qnty * bufd_gds-dtl.price-rubl
     6786                       .
     6787             end.
     6788      end.
     6789   end.
     6790                 f-sale-other = 100 * determined((f-sale-sum - f-cost-sum) / f-cost-sum).
     6791                 if c-f-wait-qnty <> ? Then DO :
     6792                  for each sl-obj-list :
     6793                   for each trn-doc no-lock  where
     6794                       trn-doc.obj-code        = sl-obj-list.obj-code and
     6795                       trn-doc.obj-type        = sl-obj-list.obj-type and
     6796                       trn-doc.status_         = 'накл':U           and
     6797                       trn-doc.flag_           = true              and
     6798                       trn-doc.Fact-order      <= fact-order-2     and
     6799                       trn-doc.ext-doc-type    = 'ie':U :
     6800                       for each doc-line no-lock where
     6801                           doc-line.doc-code   = trn-doc.doc-code   and
     6802                           doc-line.artic      = goods.artic        and
     6803                           doc-line.prod-code  = goods.prod-code    and
     6804                           doc-line.prod-type  = goods.prod-type    :
     6805                               Assign
     6806                                 f-wait-qnty   = f-wait-qnty     + doc-line.fact-qnty.
     6807                       end.
     6808                   End.
     6809                  End.
     6810                 End.
     6811                if itog = false and
     6812                ( p-zero-ost = true or
     6813                   not(f-qnty         = 0 and
     6814                       f-cost-sum     = 0 and
     6815                       f-sale-sum     = 0 and
     6816                       f-sale-other   = 0 and
     6817                       f-free-qnty    = 0 and
     6818                       f-wait-qnty    = 0  ))
     6819                   Then DO:
     6820                       n-nn = n-nn + 1 .
     6821   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     6822     (input  goods.gds-code
     6823     ,input  ?
     6824     ,output v-bar-code
     6825     )  .
     6826     if c-nn <>  ?  then do :
     6827       c-nn:screen-value = string(string(n-nn)) .
     6828       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6829           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6830           display STREAM OutStream    with frame top-frame .
     6831       End.
     6832     End.
     6833     if c-f-artic <>  ?  then do :
     6834       c-f-artic:screen-value = string(gds-obj.artic) .
     6835       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6836           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6837           display STREAM OutStream    with frame top-frame .
     6838       End.
     6839     End.
     6840     if c-f-b-code <>  ?  then do :
     6841       c-f-b-code:screen-value = string(string(v-bar-code,'999999999')) .
     6842       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6843           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6844           display STREAM OutStream    with frame top-frame .
     6845       End.
     6846     End.
     6847     if c-f-gds-name <>  ?  then do :
     6848       c-f-gds-name:screen-value = string(goods.gds-name) .
     6849       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6850           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6851           display STREAM OutStream    with frame top-frame .
     6852       End.
     6853     End.
     6854     if c-f-qnty <>  ?  then do :
     6855       c-f-qnty:screen-value = string(f-qnty) .
     6856       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6857           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6858           display STREAM OutStream    with frame top-frame .
     6859       End.
     6860     End.
     6861     if c-f-cost-pr <>  ?  then do :
     6862       c-f-cost-pr:screen-value = string(f-cost-pr) .
     6863       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6864           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6865           display STREAM OutStream    with frame top-frame .
     6866       End.
     6867     End.
