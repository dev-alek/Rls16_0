     5227       c-f-sale-other:DATA-TYPE = "CHARACTER"
     5228       c-f-sale-other:FORMAT    = "x(" + string(C-f-sale-other:WIDTH-CHARS) + ")"
     5229       c-f-sale-other:screen-value = string(ff)  .
     5230   End.
     5231   if c-f-free-qnty <>  ?  then do :
     5232   Assign
     5233       l1f-free-qnty  = c-f-free-qnty:DATA-TYPE
     5234       l2f-free-qnty  = c-f-free-qnty:FORMAT
     5235       c-f-free-qnty:DATA-TYPE = "CHARACTER"
     5236       c-f-free-qnty:FORMAT    = "x(" + string(C-f-free-qnty:WIDTH-CHARS) + ")"
     5237       c-f-free-qnty:screen-value = string(ff)  .
     5238   End.
     5239   if c-f-wait-qnty <>  ?  then do :
     5240   Assign
     5241       l1f-wait-qnty  = c-f-wait-qnty:DATA-TYPE
     5242       l2f-wait-qnty  = c-f-wait-qnty:FORMAT
     5243       c-f-wait-qnty:DATA-TYPE = "CHARACTER"
     5244       c-f-wait-qnty:FORMAT    = "x(" + string(C-f-wait-qnty:WIDTH-CHARS) + ")"
     5245       c-f-wait-qnty:screen-value = string(ff)  .
     5246   End.
     5247   if c-f-rez-qnty <>  ?  then do :
     5248   Assign
     5249       l1f-rez-qnty  = c-f-rez-qnty:DATA-TYPE
     5250       l2f-rez-qnty  = c-f-rez-qnty:FORMAT
     5251       c-f-rez-qnty:DATA-TYPE = "CHARACTER"
     5252       c-f-rez-qnty:FORMAT    = "x(" + string(C-f-rez-qnty:WIDTH-CHARS) + ")"
     5253       c-f-rez-qnty:screen-value = string(ff)  .
     5254   End.
     5255   if c-f-rez-cost <>  ?  then do :
     5256   Assign
     5257       l1f-rez-cost  = c-f-rez-cost:DATA-TYPE
     5258       l2f-rez-cost  = c-f-rez-cost:FORMAT
     5259       c-f-rez-cost:DATA-TYPE = "CHARACTER"
     5260       c-f-rez-cost:FORMAT    = "x(" + string(C-f-rez-cost:WIDTH-CHARS) + ")"
     5261       c-f-rez-cost:screen-value = string(ff)  .
     5262   End.
     5263   if c-f-rez-sale <>  ?  then do :
     5264   Assign
     5265       l1f-rez-sale  = c-f-rez-sale:DATA-TYPE
     5266       l2f-rez-sale  = c-f-rez-sale:FORMAT
     5267       c-f-rez-sale:DATA-TYPE = "CHARACTER"
     5268       c-f-rez-sale:FORMAT    = "x(" + string(C-f-rez-sale:WIDTH-CHARS) + ")"
     5269       c-f-rez-sale:screen-value = string(ff)  .
     5270   End.
     5271   if c-f-rez-cost-pr <>  ?  then do :
     5272   Assign
     5273       l1f-rez-cost-pr  = c-f-rez-cost-pr:DATA-TYPE
     5274       l2f-rez-cost-pr  = c-f-rez-cost-pr:FORMAT
     5275       c-f-rez-cost-pr:DATA-TYPE = "CHARACTER"
     5276       c-f-rez-cost-pr:FORMAT    = "x(" + string(C-f-rez-cost-pr:WIDTH-CHARS) + ")"
     5277       c-f-rez-cost-pr:screen-value = string(ff)  .
     5278   End.
     5279     Display stream OutStream  with FRAME Zapas no-error .
     5280     DOWN stream OutStream  with FRAME Zapas .
     5281   if c-f-qnty <>  ?  then do :
     5282   Assign
     5283       c-f-qnty:DATA-TYPE = l1f-qnty
     5284       c-f-qnty:FORMAT    = l2f-qnty.
     5285   End.
     5286   if c-f-cost-pr <>  ?  then do :
     5287   Assign
     5288       c-f-cost-pr:DATA-TYPE = l1f-cost-pr
     5289       c-f-cost-pr:FORMAT    = l2f-cost-pr.
     5290   End.
     5291   if c-f-cost-sum <>  ?  then do :
     5292   Assign
     5293       c-f-cost-sum:DATA-TYPE = l1f-cost-sum
     5294       c-f-cost-sum:FORMAT    = l2f-cost-sum.
     5295   End.
     5296   if c-f-sale-pr <>  ?  then do :
     5297   Assign
     5298       c-f-sale-pr:DATA-TYPE = l1f-sale-pr
     5299       c-f-sale-pr:FORMAT    = l2f-sale-pr.
     5300   End.
     5301   if c-f-sale-sum <>  ?  then do :
     5302   Assign
     5303       c-f-sale-sum:DATA-TYPE = l1f-sale-sum
     5304       c-f-sale-sum:FORMAT    = l2f-sale-sum.
     5305   End.
     5306   if c-f-sale-other <>  ?  then do :
     5307   Assign
     5308       c-f-sale-other:DATA-TYPE = l1f-sale-other
     5309       c-f-sale-other:FORMAT    = l2f-sale-other.
     5310   End.
     5311   if c-f-free-qnty <>  ?  then do :
     5312   Assign
     5313       c-f-free-qnty:DATA-TYPE = l1f-free-qnty
     5314       c-f-free-qnty:FORMAT    = l2f-free-qnty.
     5315   End.
     5316   if c-f-wait-qnty <>  ?  then do :
     5317   Assign
     5318       c-f-wait-qnty:DATA-TYPE = l1f-wait-qnty
     5319       c-f-wait-qnty:FORMAT    = l2f-wait-qnty.
     5320   End.
     5321   if c-f-rez-qnty <>  ?  then do :
     5322   Assign
     5323       c-f-rez-qnty:DATA-TYPE = l1f-rez-qnty
     5324       c-f-rez-qnty:FORMAT    = l2f-rez-qnty.
     5325   End.
     5326   if c-f-rez-cost <>  ?  then do :
     5327   Assign
     5328       c-f-rez-cost:DATA-TYPE = l1f-rez-cost
     5329       c-f-rez-cost:FORMAT    = l2f-rez-cost.
     5330   End.
     5331   if c-f-rez-sale <>  ?  then do :
     5332   Assign
     5333       c-f-rez-sale:DATA-TYPE = l1f-rez-sale
     5334       c-f-rez-sale:FORMAT    = l2f-rez-sale.
     5335   End.
     5336   if c-f-rez-cost-pr <>  ?  then do :
     5337   Assign
     5338       c-f-rez-cost-pr:DATA-TYPE = l1f-rez-cost-pr
     5339       c-f-rez-cost-pr:FORMAT    = l2f-rez-cost-pr.
     5340   End.
     5341   End.
     5342   END PROCEDURE.
     5343   PROCEDURE CalcItog :
     5344   run ostatok  in this-procedure (
     5345       input x-store-code  ,
     5346       input x-store-type  , x-TOG-Shift,
     5347       input x-date-start - 1 ,
     5348       input date('')      , x-Shift-Start,x-Shift-End,
     5349       input 'crsa':U   ,
     5350       input '##,##':U,
     5351       input xTog-obj ,
     5352       output  Quantity1  ,
     5353       output  Coast_R1   ,
     5354       output  Coast_V1   ,
     5355       output  VAT_R1     ,
     5356       output  VAT_V1     ,
     5357       output  Fact-order-1 ).
     5358       Quantity1  = 0.
     5359       Coast_R1   = 0.
     5360       Coast_V1   = 0.
     5361       VAT_R1     = 0.
     5362       VAT_V1     = 0.
     5363   define variable max-val like trn-doc.fact-order no-undo .
     5364   define variable max-val-old like trn-doc.fact-order no-undo .
     5365   max-val-old  = 0 .
     5366   for each obj-list :
     5367     fact-order-2 = 0 .
     5368     find last trn-doc no-lock where
     5369         trn-doc.status_  = 'факт':U and
     5370         trn-doc.flag_    = true  and
     5371         trn-doc.obj-code = obj-list.obj-code and
     5372         trn-doc.obj-type = obj-list.obj-type
     5373         use-index fact-order .
     5374      if available trn-doc then   fact-order-2 = trn-doc.fact-order  .
     5375          max-val = fact-order-2 .
     5376      if  max-val < max-val-old then max-val =  max-val-old .
     5377          max-val-old  =  fact-order-2.
     5378    end.
     5379    fact-order-2  = max-val .
     5380   END PROCEDURE.
     5381   procedure foreach1t :
     5382   define variable pr-cursor as integer no-undo init 0.
     5383   define variable go-work   as logical no-undo init no.
     5384   .
     5385    For each obj-list ,
     5386        each gds-obj where
     5387             gds-obj.obj-code    = obj-list.obj-code and
     5388             gds-obj.obj-type    = obj-list.obj-type
     5389             no-lock,
     5390       first goods where
     5391             goods.prod-type = gds-obj.prod-type and
     5392             goods.prod-code = gds-obj.prod-code and
     5393             goods.artic     = gds-obj.artic  and
     5394             goods.gds-type    = 'т':U
     5395             no-lock
     5396             , first gds-list where
     5397                     gds-list.prod-type = gds-obj.prod-type and
     5398                     gds-list.prod-code = gds-obj.prod-code and
     5399                     gds-list.artic     = gds-obj.artic
     5400                     no-lock
     5401                   break
     5402                   by ( gds-obj.artic + gds-obj.prod-type + string ( gds-obj.prod-code ))
     5403                    by gds-obj.prod-type
     5404                     by gds-obj.prod-code
     5405                      by gds-obj.artic
     5406                    with FRAME Zapas :
     5407                    pr-cursor = 0.
     5408                    go-work = false.
     5409                    if v-prizn = "" then go-work = true.
     5410                     else if goods.prt-root <> Prtroot then
     5411                     do while pr-cursor < num-entries(v-prizn,","):
     5412                         pr-cursor = pr-cursor + 1.
     5413                         if entry(pr-cursor,v-prizn,",") <> "" then do:
     5414                             for first prt-obj where
     5415                             prt-obj.artic     = goods.artic     and
     5416                             prt-obj.prod-type = goods.prod-type and
     5417                             prt-obj.prod-code = goods.prod-code and
     5418                             prt-obj.obj-code  = obj-list.obj-code and
     5419                             prt-obj.obj-type  = obj-list.obj-type and
     5420                             prt-obj.is-term   =  true  and
     5421                             prt-obj.prt-code  = integer(entry(pr-cursor,v-prizn,","))
     5422                             no-lock:
     5423                                 pr-cursor = num-entries(v-prizn,",").
     5424                                 go-work = true.
     5425                             end.
     5426                         end.
     5427                     end.
     5428                     if go-work then do:
     5429                 n-nm = n-nm + 1.
     5430   IF ( n-nm modulo v-account = 0 )  then DO:
     5431             if  log-manager:logfile-name ne ?
     5432             then DO:
     5433                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     5434             end.
     5435              if mFrameView
     5436              then do:
     5437               DISPLAY
     5438                 n-nm @ RecordsDone
     5439                 WITH FRAME InfoFrame.
     5440              end.
     5441   End.
     5442      if v-button-stop then  DO:
     5443            if mFrameView
     5444            then
     5445               PROCESS EVENTS.
     5446            IF StopProcessing THEN DO:
     5447            RETURN error.
     5448            End.
     5449      end.
     5450                 IF first-of(gds-obj.artic) then DO:
     5451                   assign
     5452                     f-qnty         = 0
     5453                     f-cost-sum     = 0
     5454                     f-sale-sum     = 0
     5455                     f-cost-pr      = 0
     5456                     f-sale-pr      = 0
     5457                     f-sale-other   = 0
     5458                     f-free-qnty    = 0
     5459                     f-wait-qnty    = 0
     5460                     f-rez-qnty     = 0
     5461                     f-rez-cost     = 0
     5462                     f-rez-sale     = 0
     5463                     f-rez-cost-pr  = 0
     5464                     tot-v-sale-sum = 0
     5465                     tot-v-cost-sum = 0
     5466                     .
     5467               End.
     5468   if last-of(gds-obj.artic) then DO:
     5469    IF v-var = "no-today" then DO:
     5470                  run ost-line in this-procedure
     5471                  (input   gds-obj.obj-code  ,
     5472                   input   gds-obj.obj-type  ,
     5473                   input   gds-obj.artic     ,
     5474                   input   gds-obj.prod-code ,
     5475                   input   gds-obj.prod-type ,
     5476                   input   0                 ,
     5477                   input   fact-order-2      ,
     5478                   input   'crsa':U       ,
     5479                   input   '##,##':U    ,
     5480                   input   false             ,
     5481                   output  quantity1         ,
     5482                   output  coast_r1          ,
     5483                   output  coast_v1          ,
     5484                   output  vat_r1            ,
     5485                   output  vat_v1            ,
     5486                   output  slt_r1            ,
     5487                   output  slt_v1            ).
     5488                Assign
     5489                   f-qnty       = Quantity1
     5490                   f-sale-sum   = if tprintrubl then Coast_R1 else Coast_V1
     5491                   f-sale-pr    = if f-qnty = 0 then 0 else f-sale-sum / f-qnty
     5492                   .
     5493                  run ost-line in this-procedure
     5494                  (input   gds-obj.obj-code  ,
     5495                   input   gds-obj.obj-type  ,
     5496                   input   gds-obj.artic     ,
     5497                   input   gds-obj.prod-code ,
     5498                   input   gds-obj.prod-type ,
     5499                   input   0                 ,
     5500                   input   fact-order-2      ,
     5501                   input   'cost':U       ,
     5502                   input   '##,##':U    ,
     5503                   input   false             ,
     5504                   output  quantity1   ,
     5505                   output  coast_r1  ,
     5506                   output  coast_v1  ,
     5507                   output  vat_r1    ,
     5508                   output  vat_v1    ,
     5509                   output  slt_r1    ,
     5510                   output  slt_v1    ).
     5511                Assign
     5512                   f-cost-sum   = if tprintrubl then Coast_R1 else Coast_V1
     5513                   f-cost-pr    = if Quantity1 = 0 then 0 else ( f-cost-sum / Quantity1 )
     5514                   .
     5515   end.
     5516   else do:
     5517      empty temp-table t-trn-doc .
     5518      empty temp-table temp_gds-dtl .
     5519      if v-prizn <> "" and goods.prt-root <> Prtroot then do:
     5520        pr-cursor = 0.
     5521        f-qnty = 0.
     5522        do while pr-cursor < num-entries(v-prizn,","):
     5523            pr-cursor = pr-cursor + 1.
     5524            if entry(pr-cursor,v-prizn,",") <> "" then do:
     5525                for each sl-obj-list,
     5526                first buf_gds-obj no-lock where
     5527                buf_gds-obj.gds-code =  goods.gds-code and
     5528                buf_gds-obj.obj-type =  sl-obj-list.obj-type and
     5529                buf_gds-obj.obj-code =  sl-obj-list.obj-code :
     5530                    for each prt-obj no-lock where prt-obj.prt-code = integer(entry(pr-cursor,v-prizn,","))
     5531                    and prt-obj.artic = buf_gds-obj.artic
     5532                    and prt-obj.obj-code = buf_gds-obj.obj-code
     5533                    and prt-obj.obj-type = buf_gds-obj.obj-type
     5534                    and prt-obj.is-term   =  true
     5535                    :
     5536                    assign
     5537                       f-qnty       =  f-qnty + prt-obj.fact-qnty
     5538                       f-cost-sum   = f-cost-sum + if buf_gds-obj.fact-qnty = 0 then 0 else prt-obj.fact-qnty * determined(buf_gds-obj.fact-rubl) / buf_gds-obj.fact-qnty
     5539                       f-sale-sum   = f-sale-sum + if buf_gds-obj.fact-qnty = 0 then 0 else prt-obj.fact-qnty * buf_gds-obj.fact-sale / buf_gds-obj.fact-qnty
     5540                       f-free-qnty  = f-free-qnty + prt-obj.free-qnty
     5541                       f-cost-pr   = if prt-obj.fact-qnty  = 0 then 0 else determined(buf_gds-obj.fact-rubl) / buf_gds-obj.fact-qnty
     5542                       f-sale-pr   = if prt-obj.fact-qnty  = 0 then 0 else prt-obj.price-sale
     5543                       .
     5544                    end.
     5545                end.
     5546            end.
     5547        end.
     5548      end.
     5549      else do:
     5550          for each sl-obj-list,
     5551              first buf_gds-obj no-lock where
     5552                    buf_gds-obj.gds-code =  goods.gds-code and
     5553                    buf_gds-obj.obj-type =  sl-obj-list.obj-type and
     5554                    buf_gds-obj.obj-code =  sl-obj-list.obj-code :
     5555              assign
     5556               f-qnty       = f-qnty      + buf_gds-obj.fact-qnty
     5557               f-cost-sum   = f-cost-sum  + determined(buf_gds-obj.fact-rubl)
     5558               f-sale-sum   = f-sale-sum  + buf_gds-obj.fact-sale
     5559               f-free-qnty  = f-free-qnty + buf_gds-obj.free-qnty
     5560               f-cost-pr   = if f-qnty = 0 then 0 else f-cost-sum / f-qnty
     5561               f-sale-pr   = if f-qnty = 0 then 0 else f-sale-sum / f-qnty
     5562             .
     5563       end.
     5564         for each buf_parts no-lock where
     5565                   buf_parts.artic      = buf_gds-obj.artic       and
     5566                   buf_parts.prod-type  = buf_gds-obj.prod-type   and
     5567                   buf_parts.prod-code  = buf_gds-obj.prod-code   and
     5568                   buf_parts.obj-type   = buf_gds-obj.obj-type    and
     5569                   buf_parts.obj-code   = buf_gds-obj.obj-code    and
     5570                   buf_parts.status_    = false               and
     5571                   buf_parts.rsrv-free  = true    ,
     5572           first bufi_trn-doc no-lock where
     5573                 bufi_trn-doc.doc-code = buf_parts.out-code
     5574                 and
     5575               ( bufi_trn-doc.doc-type = 'рас':U or
     5576                 bufi_trn-doc.doc-type = 'спи':U )
     5577                 :
     5578                 if not can-find( first t-trn-doc where t-trn-doc.doc-code = bufi_trn-doc.doc-code) then do:
     5579                     create t-trn-doc.
     5580                     assign
     5581                     t-trn-doc.doc-code = bufi_trn-doc.doc-code .
     5582                     .
     5583                 end.
     5584               end.
     5585      end.
     5586         for each t-trn-doc :
     5587             for each  bufd_gds-dtl no-lock where
     5588                       bufd_gds-dtl.doc-code   = t-trn-doc.doc-code  and
     5589                       bufd_gds-dtl.artic      = buf_gds-obj.artic       and
     5590                       bufd_gds-dtl.prod-type  = buf_gds-obj.prod-type   and
     5591                       bufd_gds-dtl.prod-code  = buf_gds-obj.prod-code ,
     5592                 first buff_doc-line no-lock where
     5593                       buff_doc-line.doc-code   = bufd_gds-dtl.doc-code  and
     5594                       buff_doc-line.artic      = bufd_gds-dtl.artic     and
     5595                       buff_doc-line.prod-type  = bufd_gds-dtl.prod-type and
     5596                       buff_doc-line.prod-code  = bufd_gds-dtl.prod-code
     5597                       :
     5598                       assign
     5599                         f-rez-qnty = f-rez-qnty  + bufd_gds-dtl.doc-qnty
     5600                         f-rez-cost = f-rez-cost  + ( bufd_gds-dtl.doc-qnty * buff_doc-line.price-rubl )
     5601                         f-rez-sale = f-rez-sale  + ( bufd_gds-dtl.doc-qnty * bufd_gds-dtl.price-rubl )
     5602                         f-rez-cost-pr = ( if f-rez-qnty = 0 then 0 else f-rez-cost / f-rez-qnty )
     5603                       .
     5604                       create temp_gds-dtl.
     5605                       buffer-copy bufd_gds-dtl to temp_gds-dtl
     5606                       assign
     5607                           temp_gds-dtl.cost-sum = bufd_gds-dtl.doc-qnty * buff_doc-line.price-rubl
     5608                           temp_gds-dtl.sale-sum = bufd_gds-dtl.doc-qnty * bufd_gds-dtl.price-rubl
     5609                       .
     5610             end.
     5611      end.
     5612   end.
     5613                 f-sale-other = 100 * determined((f-sale-sum - f-cost-sum) / f-cost-sum).
     5614                 if c-f-wait-qnty <> ? Then DO :
     5615                  for each sl-obj-list :
     5616                   for each trn-doc no-lock  where
     5617                       trn-doc.obj-code        = sl-obj-list.obj-code and
     5618                       trn-doc.obj-type        = sl-obj-list.obj-type and
     5619                       trn-doc.status_         = 'накл':U           and
     5620                       trn-doc.flag_           = true              and
     5621                       trn-doc.Fact-order      <= fact-order-2     and
     5622                       trn-doc.ext-doc-type    = 'ie':U :
     5623                       for each doc-line no-lock where
     5624                           doc-line.doc-code   = trn-doc.doc-code   and
     5625                           doc-line.artic      = goods.artic        and
     5626                           doc-line.prod-code  = goods.prod-code    and
     5627                           doc-line.prod-type  = goods.prod-type    :
     5628                               Assign
     5629                                 f-wait-qnty   = f-wait-qnty     + doc-line.fact-qnty.
     5630                       end.
     5631                   End.
     5632                  End.
     5633                 End.
     5634                if itog = false and
     5635                ( p-zero-ost = true or
     5636                   not(f-qnty         = 0 and
     5637                       f-cost-sum     = 0 and
     5638                       f-sale-sum     = 0 and
     5639                       f-sale-other   = 0 and
     5640                       f-free-qnty    = 0 and
     5641                       f-wait-qnty    = 0  ))
     5642                   Then DO:
     5643                       n-nn = n-nn + 1 .
     5644   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     5645     (input  goods.gds-code
     5646     ,input  ?
     5647     ,output v-bar-code
     5648     )  .
     5649     if c-nn <>  ?  then do :
     5650       c-nn:screen-value = string(string(n-nn)) .
     5651       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     5652           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     5653           display STREAM OutStream    with frame top-frame .
     5654       End.
     5655     End.
     5656     if c-f-artic <>  ?  then do :
     5657       c-f-artic:screen-value = string(gds-obj.artic) .
     5658       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     5659           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     5660           display STREAM OutStream    with frame top-frame .
     5661       End.
     5662     End.
     5663     if c-f-b-code <>  ?  then do :
