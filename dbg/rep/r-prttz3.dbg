     7749   run u-line in this-procedure.
     7750     if c-nn <>  ?  then do :
     7751       c-nn:screen-value = string('ИТОГО') .
     7752       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7753           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7754           display STREAM OutStream    with frame top-frame .
     7755       End.
     7756     End.
     7757     if c-f-artic <>  ?  then do :
     7758       c-f-artic:screen-value = string('ПО ВСЕМ ОБЬЕКТАМ') .
     7759       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7760           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7761           display STREAM OutStream    with frame top-frame .
     7762       End.
     7763     End.
     7764     if c-f-qnty <>  ?  then do :
     7765       c-f-qnty:screen-value = string(accum TOTAL f-qnty) .
     7766       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7767           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7768           display STREAM OutStream    with frame top-frame .
     7769       End.
     7770     End.
     7771     if c-f-cost-sum <>  ?  then do :
     7772       c-f-cost-sum:screen-value = string(accum TOTAL f-cost-sum) .
     7773       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7774           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7775           display STREAM OutStream    with frame top-frame .
     7776       End.
     7777     End.
     7778     if c-f-sale-sum <>  ?  then do :
     7779       c-f-sale-sum:screen-value = string(accum TOTAL f-sale-sum) .
     7780       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7781           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7782           display STREAM OutStream    with frame top-frame .
     7783       End.
     7784     End.
     7785     if c-f-sale-other <>  ?  then do :
     7786       c-f-sale-other:screen-value = string(accum TOTAL f-sale-other) .
     7787       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7788           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7789           display STREAM OutStream    with frame top-frame .
     7790       End.
     7791     End.
     7792     if c-f-free-qnty <>  ?  then do :
     7793       c-f-free-qnty:screen-value = string(accum TOTAL f-free-qnty) .
     7794       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7795           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7796           display STREAM OutStream    with frame top-frame .
     7797       End.
     7798     End.
     7799     if c-f-wait-qnty <>  ?  then do :
     7800       c-f-wait-qnty:screen-value = string(accum TOTAL f-wait-qnty) .
     7801       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7802           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7803           display STREAM OutStream    with frame top-frame .
     7804       End.
     7805     End.
     7806     if c-f-rez-qnty <>  ?  then do :
     7807       c-f-rez-qnty:screen-value = string(accum TOTAL f-rez-qnty) .
     7808       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7809           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7810           display STREAM OutStream    with frame top-frame .
     7811       End.
     7812     End.
     7813     if c-f-rez-cost <>  ?  then do :
     7814       c-f-rez-cost:screen-value = string(accum TOTAL f-rez-cost) .
     7815       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7816           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7817           display STREAM OutStream    with frame top-frame .
     7818       End.
     7819     End.
     7820     if c-f-rez-sale <>  ?  then do :
     7821       c-f-rez-sale:screen-value = string(accum TOTAL f-rez-sale) .
     7822       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7823           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7824           display STREAM OutStream    with frame top-frame .
     7825       End.
     7826     End.
     7827   dIsplay stream OutStream with FRAME Zapas no-error .
     7828   down stream OutStream with FRAME Zapas.
     7829   run u-line in this-procedure.
     7830   if Make-Excel then  put   stream ForExcel unformatted
     7831   "ИТОГО"                       CHR(9)
     7832   "ПО ВСЕМ ОБЬЕКТАМ"            CHR(9) CHR(9) CHR(9)
     7833    CHR(9)
     7834   excel-qnty(accum TOTAL f-qnty           )   CHR(9)
     7835   CHR(9)
     7836   excel-sum (accum TOTAL f-cost-sum       )   CHR(9)
     7837   CHR(9)
     7838   excel-sum (accum TOTAL f-sale-sum       )   CHR(9)
     7839   excel-sum (accum TOTAL f-sale-other     )   CHR(9)
     7840   excel-sum (accum TOTAL f-free-qnty      )   CHR(9)
     7841   excel-sum (accum TOTAL f-wait-qnty      )   CHR(9)
     7842   excel-sum (accum TOTAL f-rez-qnty   )   CHR(9)
     7843   excel-sum (accum TOTAL f-rez-cost   )   CHR(9)
     7844   excel-sum (accum TOTAL f-rez-sale   )   CHR(9)
     7845   chr(10) .
     7846   end procedure.
     7847   procedure display-prt-t :
     7848   define variable pr-cursor as integer no-undo init 0.
     7849   define variable go-work   as logical no-undo init no.
     7850   IF goods.prt-root <> Prtroot Then DO:
     7851     for each sl-obj-list ,
     7852       each prt-obj where
     7853         prt-obj.artic     = goods.artic     and
     7854         prt-obj.prod-type = goods.prod-type and
     7855         prt-obj.prod-code = goods.prod-code and
     7856         prt-obj.obj-code  = sl-obj-list.obj-code and
     7857         prt-obj.obj-type  = sl-obj-list.obj-type and
     7858         prt-obj.IS-term   =  true no-lock
     7859             break by prt-obj.prt-code with frame zapas :
     7860             pr-cursor = 0.
     7861             go-work = false.
     7862             if v-prizn = "" then go-work = true.
     7863             else
     7864             do while pr-cursor < num-entries(v-prizn,","):
     7865                 pr-cursor = pr-cursor + 1.
     7866                 if entry(pr-cursor,v-prizn,",") <> "" then do:
     7867                     if integer(entry(pr-cursor,v-prizn,",")) = prt-obj.prt-code then do:
     7868                         pr-cursor = num-entries(v-prizn,",").
     7869                         go-work = true.
     7870                     end.
     7871                 end.
     7872             end.
     7873             if go-work then do:
     7874                 if v-var <> "no-today" then do:
     7875                     assign
     7876                       p-qnty      = p-qnty       + prt-obj.fact-qnty
     7877                       p-free-qnty = p-free-qnty  + prt-obj.free-qnty
     7878                       p-sale-sum  = p-sale-sum   + prt-obj.fact-qnty * prt-obj.price-sale
     7879                       p-sale-pr   = if p-qnty = 0 then 0 else p-sale-sum / p-qnty
     7880                       .
     7881                 end.
     7882       if last-of (prt-obj.prt-code) then do:
     7883   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     7884     (input  gds-obj.gds-code
     7885     ,input  prt-obj.prt-code
     7886     ,output v-bar-code
     7887     )  .
     7888                 if v-var = "no-today" then do:
     7889                 for each buf_sl-obj-list ,
     7890                     first buf_prt-obj no-lock where
     7891                           buf_prt-obj.artic     = prt-obj.artic     and
     7892                           buf_prt-obj.prod-type = prt-obj.prod-type and
     7893                           buf_prt-obj.prod-code = prt-obj.prod-code and
     7894                           buf_prt-obj.prt-code  = prt-obj.prt-code  and
     7895                           buf_prt-obj.obj-code  = buf_sl-obj-list.obj-code and
     7896                           buf_prt-obj.obj-type  = buf_sl-obj-list.obj-type and
     7897                           buf_prt-obj.IS-term   = prt-obj.IS-term
     7898                           :
     7899                    run  prdoclib-init-prt-obj-by-factord in this-procedure
     7900                     ( input buf_sl-obj-list.obj-type  ,
     7901                       input buf_sl-obj-list.obj-code  ,
     7902                       input gds-obj.artic     ,
     7903                       input gds-obj.prod-type ,
     7904                       input gds-obj.prod-code ,
     7905                       input fact-order-2 ,
     7906                       input false ) .
     7907                   find first temp-prt-obj no-lock
     7908                        where temp-prt-obj.prt-obj-recid   = recid (buf_prt-obj) no-error .
     7909                        if available temp-prt-obj then do :
     7910                          run  calc-price-sale-for-prt in this-procedure  (output v-price-sale) .
     7911                           assign
     7912                             p-qnty      = p-qnty   +   temp-prt-obj.fact-qnty
     7913                             p-free-qnty =  0
     7914                             p-sale-sum  = p-sale-sum + temp-prt-obj.fact-qnty * v-price-sale
     7915                             p-sale-pr   = if p-qnty = 0 then 0 else p-sale-sum / p-qnty
     7916                             .
     7917                         end.
     7918                 end.
     7919               end.
     7920           find first gds-prt  where gds-prt.node-code = prt-obj.prt-code no-lock no-error .
     7921           if c-f-wait-qnty <> ? then do :
     7922             for each buf_sl-obj-list ,
     7923                 each trn-doc no-lock  where
     7924                 trn-doc.obj-code        = buf_sl-obj-list.obj-code and
     7925                 trn-doc.obj-type        = buf_sl-obj-list.obj-type and
     7926                 trn-doc.status_         = 'накл':U           and
     7927                 trn-doc.flag_           = true              and
     7928                 trn-doc.ext-doc-type    = 'ie':U :
     7929                 for each gds-dtl no-lock where
     7930                           gds-dtl.doc-code   = trn-doc.doc-code   and
     7931                           gds-dtl.artic      = goods.artic        and
     7932                           gds-dtl.prod-code  = goods.prod-code    and
     7933                           gds-dtl.prod-type  = goods.prod-type    and
     7934                           gds-dtl.prt-code   = prt-obj.prt-code   and
     7935                           gds-dtl.obj-code   = buf_sl-obj-list.obj-code  and
     7936                           gds-dtl.obj-type   = buf_sl-obj-list.obj-type
     7937                           :
     7938                           assign
     7939                             p-wait-qnty   = p-wait-qnty     + gds-dtl.fact-qnty
     7940                             .
     7941                 end.
     7942             end.
     7943           end.
     7944           assign
     7945             p-cost-sum     = determined( f-cost-sum * p-qnty  / f-qnty)
     7946             p-sale-other   = 100 * determined((p-sale-sum - p-cost-sum) / p-cost-sum)
     7947             p-cost-pr      = if p-qnty = 0 then 0 else p-cost-sum   / p-qnty
     7948             .
     7949           if ( f-rez-qnty <> ? or
     7950                f-rez-cost <> ? or
     7951                f-rez-sale <> ? ) and  v-var <> "no-today"
     7952           then do:
     7953                 for each temp_gds-dtl where
     7954                          temp_gds-dtl.prt-code   = prt-obj.prt-code  :
     7955                     assign
     7956                       p-rez-qnty = p-rez-qnty  + temp_gds-dtl.doc-qnty
     7957                       p-rez-cost = p-rez-cost  + temp_gds-dtl.cost-sum
     7958                       p-rez-sale = p-rez-sale  + temp_gds-dtl.sale-sum
     7959                       p-rez-cost-pr = ( if p-rez-qnty = 0 then 0 else p-rez-cost / p-rez-qnty )
     7960                     .
     7961                 end.
     7962           end.
     7963               if not (p-zero = false  and
     7964                    (p-qnty        =  0  and
     7965                     p-cost-sum    =  0  and
     7966                     p-sale-sum    =  0  and
     7967                     p-sale-other  =  0  and
     7968                     p-free-qnty   =  0  and
     7969                     p-wait-qnty  =  0  ) ) then do:
     7970     if c-nn <>  ?  then do :
     7971       c-nn:screen-value = string('') .
     7972       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7973           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7974           display STREAM OutStream    with frame top-frame .
     7975       End.
     7976     End.
     7977     if c-f-artic <>  ?  then do :
     7978       c-f-artic:screen-value = string('') .
     7979       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7980           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7981           display STREAM OutStream    with frame top-frame .
     7982       End.
     7983     End.
     7984     if c-f-b-code <>  ?  then do :
     7985       c-f-b-code:screen-value = string(string(v-bar-code,'999999999')) .
     7986       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7987           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7988           display STREAM OutStream    with frame top-frame .
     7989       End.
     7990     End.
     7991     if c-f-prt-name <>  ?  then do :
     7992       c-f-prt-name:screen-value = string(gds-prt.f-name) .
     7993       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7994           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7995           display STREAM OutStream    with frame top-frame .
     7996       End.
     7997     End.
     7998     if c-f-qnty <>  ?  then do :
     7999       c-f-qnty:screen-value = string(p-qnty) .
     8000       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8001           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8002           display STREAM OutStream    with frame top-frame .
     8003       End.
     8004     End.
     8005     if c-f-sale-pr <>  ?  then do :
     8006       c-f-sale-pr:screen-value = string(p-sale-pr) .
     8007       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8008           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8009           display STREAM OutStream    with frame top-frame .
     8010       End.
     8011     End.
     8012     if c-f-sale-sum <>  ?  then do :
     8013       c-f-sale-sum:screen-value = string(p-sale-sum) .
     8014       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8015           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8016           display STREAM OutStream    with frame top-frame .
     8017       End.
     8018     End.
     8019     if c-f-sale-other <>  ?  then do :
     8020       c-f-sale-other:screen-value = string(p-sale-other) .
     8021       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8022           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8023           display STREAM OutStream    with frame top-frame .
     8024       End.
     8025     End.
     8026     if c-f-free-qnty <>  ?  then do :
     8027       c-f-free-qnty:screen-value = string(p-free-qnty) .
     8028       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8029           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8030           display STREAM OutStream    with frame top-frame .
     8031       End.
     8032     End.
     8033     if c-f-wait-qnty <>  ?  then do :
     8034       c-f-wait-qnty:screen-value = string(p-wait-qnty) .
     8035       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8036           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8037           display STREAM OutStream    with frame top-frame .
     8038       End.
     8039     End.
     8040     if c-f-rez-qnty <>  ?  then do :
     8041       c-f-rez-qnty:screen-value = string(p-rez-qnty) .
     8042       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8043           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8044           display STREAM OutStream    with frame top-frame .
     8045       End.
     8046     End.
     8047     if c-f-rez-cost <>  ?  then do :
     8048       c-f-rez-cost:screen-value = string(p-rez-cost) .
     8049       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8050           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8051           display STREAM OutStream    with frame top-frame .
     8052       End.
     8053     End.
     8054     if c-f-rez-sale <>  ?  then do :
     8055       c-f-rez-sale:screen-value = string(p-rez-sale) .
     8056       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8057           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8058           display STREAM OutStream    with frame top-frame .
     8059       End.
     8060     End.
     8061                   Display stream OutStream no-error.
     8062                   DOWN stream OutStream .
     8063                   if Make-Excel then  put   stream ForExcel unformatted
     8064                   CHR(9)
     8065                   string(v-bar-code,"999999999")
     8066                   CHR(9)
     8067                   CHR(9)
     8068                   CHR(9)
     8069                   gds-prt.f-name                 CHR(9)
     8070                   excel-qnty(p-qnty)             CHR(9)
     8071                                            CHR(9)
     8072                                            CHR(9)
     8073                   excel-sum(p-sale-pr)          CHR(9)
     8074                   excel-sum(p-sale-sum)         CHR(9)
     8075                   excel-sum(p-sale-other)       CHR(9)
     8076                   excel-sum(p-free-qnty)        CHR(9)
     8077                   excel-sum(p-wait-qnty)   CHR(9)
     8078                   excel-sum(p-rez-qnty)    CHR(9)
     8079                   excel-sum(p-rez-cost)    CHR(9)
     8080                   excel-sum(p-rez-sale)    CHR(9)
     8081                   chr(10) .
     8082               end.
     8083           Assign
     8084             p-qnty        =  0
     8085             p-cost-sum    =  0
     8086             p-sale-sum    =  0
     8087             p-sale-other  =  0
     8088             p-free-qnty   =  0
     8089             p-wait-qnty   =  0
     8090             p-rez-qnty   = 0
     8091             p-rez-cost   = 0
     8092             p-rez-sale   = 0
     8093             .
     8094       End.
     8095       end.
     8096     End.
     8097   End.
     8098   end procedure.
     8099   PROCEDURE on-same-page :
     8100     define input parameter p-line-number as integer  no-undo .
     8101     if p-line-number > page-size( OutStream ) then do:
     8102       return .
     8103     end.
     8104     if line-counter( OutStream ) + p-line-number > page-size( OutStream ) then do:
     8105       page stream OutStream .
     8106     end.
     8107   end procedure.
     8108   PROCEDURE ostatok :
     8109   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     8110   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     8111   def input parameter x-tog-shift   as   logical             no-undo.
     8112   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     8113   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     8114   def input parameter x-shift-start as integer               no-undo.
     8115   def input parameter x-shift-end   as integer               no-undo.
     8116   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     8117   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     8118   def input parameter xTog-obj   as log no-undo.
     8119   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     8120   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     8121   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     8122   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     8123   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     8124   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     8125   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     8126   def var              Fact-orderS   as char  no-undo.
     8127   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     8128      Assign
     8129         Fact-order   = 0
     8130         Quantity     = 0
     8131         Coast_R      = 0
     8132         Coast_V      = 0
     8133         VAT_R        = 0
     8134         VAT_V        = 0 .
     8135    x-date-start-t  = x-date-start + 1 .
     8136   IF x-date-end = date('') then DO:
     8137      Fact-order = 0 .
     8138      for each obj-list
     8139          where  ( not xtog-obj or
     8140                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     8141                 no-lock :
     8142         if  x-tog-shift = false then do:
     8143                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     8144                               ub.stk-tot.Fact-date <=  x-date-start
     8145                               and ub.stk-tot.shift-num = 0
     8146                               USE-INDEX fact-date no-lock no-error .
     8147              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     8148         End.
     8149         Else  DO :
     8150             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     8151              (ub.stk-tot.shift-date  = x-date-start-t and
     8152               ub.stk-tot.shift-num  < x-shift-start or
     8153               ub.stk-tot.shift-date  < x-date-start-t  )
     8154               and ub.stk-tot.shift-num  > 0
     8155               USE-INDEX Shift-num no-lock no-error .
     8156            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     8157           END.
     8158       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     8159     End.
     8160   End.
     8161   Else DO:
     8162     For each obj-list  WHERE
     8163        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     8164         no-lock :
     8165      IF  x-TOG-Shift = False Then DO:
     8166          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     8167               ub.stk-tot.Fact-date <= x-date-end
     8168               and ub.stk-tot.shift-num = 0
     8169               USE-INDEX fact-date no-lock no-error.
     8170          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     8171      END.
     8172      Else DO:
     8173           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     8174               (ub.stk-tot.shift-date  = x-date-end and
     8175               ub.stk-tot.shift-num  <= x-shift-end or
     8176               ub.stk-tot.shift-date  < x-date-end       ) and
     8177               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     8178               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     8179       End.
     8180       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     8181     End.
     8182   End.
     8183   END PROCEDURE.
     8184   procedure ost-line :
     8185     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     8186     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     8187     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     8188     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     8189     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     8190     define input  parameter x-tog-shift  as logical no-undo .
     8191     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     8192     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     8193     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     8194     define input  parameter xtog-obj     as logical no-undo .
     8195     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     8196     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     8197     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     8198     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     8199     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     8200     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     8201     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     8202     define buffer buff-obj-list  for obj-list .
     8203     define buffer buff-stk-line  for ub.stk-line .
     8204     assign
     8205       Quantity = 0
     8206       Coast_R  = 0
     8207       Coast_V  = 0
     8208       VAT_R    = 0
     8209       VAT_V    = 0
     8210       SLT_R    = 0
     8211       SLT_V    = 0
     8212     .
     8213     if  x-tog-shift = false then do:
     8214       for each buff-obj-list no-lock
     8215         where xtog-obj = false
     8216            or (buff-obj-list.obj-type = x-store-type
     8217               and buff-obj-list.obj-code = x-store-code
     8218               )
     8219       on error undo, return error
     8220       :
     8221       find last buff-stk-line no-lock
     8222         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     8223           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     8224           and buff-stk-line.artic      = x-artic
     8225           and buff-stk-line.prod-type  = x-prod-type
     8226           and buff-stk-line.prod-code  = x-prod-code
     8227           and buff-stk-line.sum-type   = x-sum-type
     8228           and buff-stk-line.cat-id     = '##,##':U
     8229           and buff-stk-line.fact-order <= x-fact-order
     8230           and buff-stk-line.shift-num  = 0
     8231         use-index category
     8232         no-error .
     8233       if available buff-stk-line then do:
     8234         assign
     8235           Quantity = Quantity + buff-stk-line.fact-qnty
     8236           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     8237           Coast_V  = Coast_V  + buff-stk-line.sum-base
     8238           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     8239           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     8240           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     8241           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     8242         .
     8243       end.
     8244      end.
     8245     end.
     8246     else do:
     8247       for each buff-obj-list no-lock
     8248         where xtog-obj = false
     8249            or (buff-obj-list.obj-type = x-store-type
     8250               and buff-obj-list.obj-code = x-store-code
     8251               )
     8252       on error undo, return error
     8253       :
     8254         find last buff-stk-line no-lock
     8255           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     8256             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     8257             and buff-stk-line.artic      = x-artic
     8258             and buff-stk-line.prod-type  = x-prod-type
     8259             and buff-stk-line.prod-code  = x-prod-code
     8260             and buff-stk-line.sum-type   = x-sum-type
     8261             and buff-stk-line.cat-id     = '##,##':U
     8262             and buff-stk-line.fact-order <= x-fact-order
     8263             and buff-stk-line.shift-num  > 0
     8264           use-index category
     8265           no-error .
     8266         if available buff-stk-line then do:
     8267           assign
     8268             Quantity = Quantity +  buff-stk-line.fact-qnty
     8269             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     8270             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     8271             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     8272             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     8273             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     8274             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     8275           .
     8276         end.
     8277       end.
     8278     end.
     8279   end procedure.
     8280   procedure ost-lineother-tax :
     8281     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     8282     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     8283     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     8284     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     8285     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     8286     define input  parameter x-tog-shift  as logical no-undo .
     8287     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     8288     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     8289     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     8290     define input  parameter xTog-obj     as logical no-undo .
     8291     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     8292     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     8293     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     8294     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     8295     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     8296     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     8297     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     8298     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     8299     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     8300     define buffer buff-obj-list  for obj-list .
     8301     define buffer buff-stk-line  for ub.stk-line .
     8302     assign
     8303       Quantity = 0
     8304       Coast_R  = 0
     8305       Coast_V  = 0
     8306       VAT_R    = 0
     8307       VAT_V    = 0
     8308       SLT_R    = 0
     8309       SLT_V    = 0
     8310       other_R  = 0
     8311       other_V  = 0
     8312     .
     8313     if  x-tog-shift = false then do:
     8314       for each buff-obj-list no-lock
     8315         where xtog-obj = false
     8316            or (buff-obj-list.obj-type = x-store-type
     8317               and buff-obj-list.obj-code = x-store-code
     8318               )
     8319       on error undo, return error
     8320       :
     8321       find last buff-stk-line no-lock
     8322         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     8323           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     8324           and buff-stk-line.artic      = x-artic
     8325           and buff-stk-line.prod-type  = x-prod-type
     8326           and buff-stk-line.prod-code  = x-prod-code
     8327           and buff-stk-line.sum-type   = x-sum-type
     8328           and buff-stk-line.cat-id     = '##,##':U
     8329           and buff-stk-line.fact-order <= x-fact-order
     8330           and buff-stk-line.shift-num  = 0
     8331         use-index category
     8332         no-error .
     8333       if available buff-stk-line then do:
     8334         assign
     8335           Quantity = Quantity + buff-stk-line.fact-qnty
     8336           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     8337           Coast_V  = Coast_V  + buff-stk-line.sum-base
     8338           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     8339           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     8340           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     8341           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     8342           other_R  = other_R  + buff-stk-line.other-rubl
     8343           other_V  = other_V  + buff-stk-line.other-base
     8344         .
     8345       end.
     8346    end.
     8347     end.
     8348     else do:
     8349       for each buff-obj-list no-lock
     8350         where xtog-obj = false
     8351            or (buff-obj-list.obj-type = x-store-type
     8352               and buff-obj-list.obj-code = x-store-code
     8353               )
     8354       on error undo, return error
     8355       :
     8356         find last buff-stk-line no-lock
     8357           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     8358             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     8359             and buff-stk-line.artic      = x-artic
     8360             and buff-stk-line.prod-type  = x-prod-type
     8361             and buff-stk-line.prod-code  = x-prod-code
     8362             and buff-stk-line.sum-type   = x-sum-type
     8363             and buff-stk-line.cat-id     = '##,##':U
     8364             and buff-stk-line.fact-order <= x-fact-order
     8365             and buff-stk-line.shift-num  > 0
     8366           use-index category
     8367           no-error .
     8368         if available buff-stk-line then do:
     8369           assign
     8370             Quantity = Quantity +  buff-stk-line.fact-qnty
     8371             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     8372             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     8373             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     8374             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     8375             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     8376             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     8377             other_R = other_R   +  buff-stk-line.other-rubl
     8378             other_V = other_V   +  buff-stk-line.other-base
     8379           .
     8380         end.
     8381       end.
     8382     end.
     8383   end procedure.
     8384   procedure ost-line-kg :
     8385     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     8386     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     8387     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     8388     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     8389     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     8390     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     8391     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     8392     define buffer buff-obj-list  for obj-list .
     8393     define buffer buf_doc-line for ub.doc-line .
     8394     define buffer buf_inv-line for ub.inv-line .
     8395     do
     8396     on error undo, return error
     8397     :
     8398       for each buf_doc-line no-lock where
     8399                buf_doc-line.obj-type    = p-obj-type   and
     8400                buf_doc-line.obj-code    = p-obj-code   and
     8401                buf_doc-line.prod-type   = p-prod-type  and
     8402                buf_doc-line.prod-code   = p-prod-code  and
     8403                buf_doc-line.artic       = p-artic      and
     8404                buf_doc-line.status_     = 'факт':U      and
     8405                buf_doc-line.fact-order <= p-fact-order
     8406             by buf_doc-line.fact-order    descending
     8407       :
     8408         find first buf_inv-line no-lock where
     8409                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     8410                    buf_inv-line.artic     = buf_doc-line.artic     and
     8411                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     8412                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     8413         if available buf_inv-line
     8414         then do:
     8415           if buf_inv-line.after-cli-qnty <> ?
     8416           then do:
     8417             assign
     8418               p-quantity-kg = buf_inv-line.after-cli-qnty
     8419             .
     8420             leave .
     8421           end.
     8422         end.
     8423       end.
     8424       if p-quantity-kg = ?
     8425       then do:
     8426         assign
     8427           p-quantity-kg = 0
     8428         .
     8429       end.
     8430     end.
     8431   end procedure.
