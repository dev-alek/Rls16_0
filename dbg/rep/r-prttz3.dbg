     5157       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     5158           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     5159           display STREAM OutStream    with frame top-frame .
