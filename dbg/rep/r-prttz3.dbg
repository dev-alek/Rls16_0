     8469       define variable varvat-base-factovp-prl      like ub.gds-dtl.price-base               no-undo.
     8470       define variable varvatcons-base-factovp-prl  like ub.gds-dtl.price-base               no-undo.
     8471       define variable vardsc-base-factovp-prl      like ub.gds-dtl.price-base               no-undo.
     8472       define variable varsum-base-docovp-prl       like ub.gds-dtl.price-base               no-undo.
     8473       define variable varslt-base-docovp-prl       like ub.gds-dtl.price-base               no-undo.
     8474       define variable varvat-base-docovp-prl       like ub.gds-dtl.price-base               no-undo.
     8475       define variable varvatcons-base-docovp-prl   like ub.gds-dtl.price-base               no-undo.
