     5901   excel-sum (accum TOTAL f-rez-cost   )   CHR(9)
     5902   excel-sum (accum TOTAL f-rez-sale   )   CHR(9)
     5903   chr(10) .
     5904   end procedure.
     5905   procedure foreach2t :
     5906   define variable pr-cursor as integer no-undo init 0.
     5907   define variable go-work   as logical no-undo init no.
     5908   .
     5909    For each obj-list ,
     5910        each gds-obj where
     5911             gds-obj.obj-code    = obj-list.obj-code and
     5912             gds-obj.obj-type    = obj-list.obj-type
     5913             no-lock,
     5914       first goods where
     5915             goods.prod-type = gds-obj.prod-type and
     5916             goods.prod-code = gds-obj.prod-code and
     5917             goods.artic     = gds-obj.artic  and
     5918             goods.gds-type    = 'т':U
     5919             no-lock
     5920             , first gds-list where
     5921                     gds-list.prod-type = gds-obj.prod-type and
     5922                     gds-list.prod-code = gds-obj.prod-code and
     5923                     gds-list.artic     = gds-obj.artic
     5924                     no-lock
     5925                   break
     5926                   by gds-obj.prod-type
     5927                    by gds-obj.prod-code
     5928                     by gds-obj.artic
     5929                    with FRAME Zapas :
     5930                    pr-cursor = 0.
     5931                    go-work = false.
     5932                    if v-prizn = "" then go-work = true.
     5933                     else if goods.prt-root <> Prtroot then
     5934                     do while pr-cursor < num-entries(v-prizn,","):
     5935                         pr-cursor = pr-cursor + 1.
     5936                         if entry(pr-cursor,v-prizn,",") <> "" then do:
     5937                             for first prt-obj where
     5938                             prt-obj.artic     = goods.artic     and
     5939                             prt-obj.prod-type = goods.prod-type and
     5940                             prt-obj.prod-code = goods.prod-code and
     5941                             prt-obj.obj-code  = obj-list.obj-code and
     5942                             prt-obj.obj-type  = obj-list.obj-type and
     5943                             prt-obj.is-term   =  true  and
     5944                             prt-obj.prt-code  = integer(entry(pr-cursor,v-prizn,","))
     5945                             no-lock:
     5946                                 pr-cursor = num-entries(v-prizn,",").
     5947                                 go-work = true.
     5948                             end.
     5949                         end.
     5950                     end.
     5951                     if go-work then do:
     5952                 n-nm = n-nm + 1.
     5953   IF ( n-nm modulo v-account = 0 )  then DO:
     5954             if  log-manager:logfile-name ne ?
     5955             then DO:
     5956                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     5957             end.
     5958              if mFrameView
     5959              then do:
     5960               DISPLAY
     5961                 n-nm @ RecordsDone
     5962                 WITH FRAME InfoFrame.
     5963              end.
     5964   End.
     5965      if v-button-stop then  DO:
     5966            if mFrameView
     5967            then
     5968               PROCESS EVENTS.
     5969            IF StopProcessing THEN DO:
     5970            RETURN error.
     5971            End.
     5972      end.
     5973                 IF first-of(gds-obj.artic) then DO:
     5974                   assign
     5975                     f-qnty         = 0
     5976                     f-cost-sum     = 0
     5977                     f-sale-sum     = 0
     5978                     f-cost-pr      = 0
     5979                     f-sale-pr      = 0
     5980                     f-sale-other   = 0
     5981                     f-free-qnty    = 0
     5982                     f-wait-qnty    = 0
     5983                     f-rez-qnty     = 0
     5984                     f-rez-cost     = 0
     5985                     f-rez-sale     = 0
     5986                     f-rez-cost-pr  = 0
     5987                     tot-v-sale-sum = 0
     5988                     tot-v-cost-sum = 0
     5989                     .
     5990               End.
     5991             if first-of(gds-obj.prod-code)  and classify = 2 then DO:
     5992                 FIND FIRST clients-p where  gds-obj.prod-type = clients-p.obj-type AND
     5993                                             gds-obj.prod-code = clients-p.obj-code no-lock no-error.
     5994                  if avail clients-p then var-client = Clients-p.obj-name.
     5995                     if  Itog = false Then do:
     5996     if c-f-gds-name <>  ?  then do :
     5997       c-f-gds-name:screen-value = string(var-client) .
     5998       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     5999           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6000           display STREAM OutStream    with frame top-frame .
     6001       End.
     6002     End.
     6003                       Display stream OutStream .
     6004                       DOWN stream OutStream .
     6005                       if Make-Excel then  put   stream ForExcel unformatted var-client chr(10) .
     6006                     End.
     6007             End.
     6008   if last-of(gds-obj.artic) then DO:
     6009    IF v-var = "no-today" then DO:
     6010                  run ost-line in this-procedure
     6011                  (input   gds-obj.obj-code  ,
     6012                   input   gds-obj.obj-type  ,
     6013                   input   gds-obj.artic     ,
     6014                   input   gds-obj.prod-code ,
     6015                   input   gds-obj.prod-type ,
     6016                   input   0                 ,
     6017                   input   fact-order-2      ,
     6018                   input   'crsa':U       ,
     6019                   input   '##,##':U    ,
     6020                   input   false             ,
     6021                   output  quantity1         ,
     6022                   output  coast_r1          ,
     6023                   output  coast_v1          ,
     6024                   output  vat_r1            ,
     6025                   output  vat_v1            ,
     6026                   output  slt_r1            ,
     6027                   output  slt_v1            ).
     6028                Assign
     6029                   f-qnty       = Quantity1
     6030                   f-sale-sum   = if tprintrubl then Coast_R1 else Coast_V1
     6031                   f-sale-pr    = if f-qnty = 0 then 0 else f-sale-sum / f-qnty
     6032                   .
     6033                  run ost-line in this-procedure
     6034                  (input   gds-obj.obj-code  ,
     6035                   input   gds-obj.obj-type  ,
     6036                   input   gds-obj.artic     ,
     6037                   input   gds-obj.prod-code ,
     6038                   input   gds-obj.prod-type ,
     6039                   input   0                 ,
     6040                   input   fact-order-2      ,
     6041                   input   'cost':U       ,
     6042                   input   '##,##':U    ,
     6043                   input   false             ,
     6044                   output  quantity1   ,
     6045                   output  coast_r1  ,
     6046                   output  coast_v1  ,
     6047                   output  vat_r1    ,
     6048                   output  vat_v1    ,
     6049                   output  slt_r1    ,
     6050                   output  slt_v1    ).
     6051                Assign
     6052                   f-cost-sum   = if tprintrubl then Coast_R1 else Coast_V1
     6053                   f-cost-pr    = if Quantity1 = 0 then 0 else ( f-cost-sum / Quantity1 )
     6054                   .
     6055   end.
     6056   else do:
     6057      empty temp-table t-trn-doc .
     6058      empty temp-table temp_gds-dtl .
     6059      if v-prizn <> "" and goods.prt-root <> Prtroot then do:
     6060        pr-cursor = 0.
     6061        f-qnty = 0.
     6062        do while pr-cursor < num-entries(v-prizn,","):
     6063            pr-cursor = pr-cursor + 1.
     6064            if entry(pr-cursor,v-prizn,",") <> "" then do:
     6065                for each sl-obj-list,
     6066                first buf_gds-obj no-lock where
     6067                buf_gds-obj.gds-code =  goods.gds-code and
     6068                buf_gds-obj.obj-type =  sl-obj-list.obj-type and
     6069                buf_gds-obj.obj-code =  sl-obj-list.obj-code :
     6070                    for each prt-obj no-lock where prt-obj.prt-code = integer(entry(pr-cursor,v-prizn,","))
     6071                    and prt-obj.artic = buf_gds-obj.artic
     6072                    and prt-obj.obj-code = buf_gds-obj.obj-code
     6073                    and prt-obj.obj-type = buf_gds-obj.obj-type
     6074                    and prt-obj.is-term   =  true
     6075                    :
     6076                    assign
     6077                       f-qnty       =  f-qnty + prt-obj.fact-qnty
     6078                       f-cost-sum   = f-cost-sum + if buf_gds-obj.fact-qnty = 0 then 0 else prt-obj.fact-qnty * determined(buf_gds-obj.fact-rubl) / buf_gds-obj.fact-qnty
     6079                       f-sale-sum   = f-sale-sum + if buf_gds-obj.fact-qnty = 0 then 0 else prt-obj.fact-qnty * buf_gds-obj.fact-sale / buf_gds-obj.fact-qnty
     6080                       f-free-qnty  = f-free-qnty + prt-obj.free-qnty
     6081                       f-cost-pr   = if prt-obj.fact-qnty  = 0 then 0 else determined(buf_gds-obj.fact-rubl) / buf_gds-obj.fact-qnty
     6082                       f-sale-pr   = if prt-obj.fact-qnty  = 0 then 0 else prt-obj.price-sale
     6083                       .
     6084                    end.
     6085                end.
     6086            end.
     6087        end.
     6088      end.
     6089      else do:
     6090          for each sl-obj-list,
     6091              first buf_gds-obj no-lock where
     6092                    buf_gds-obj.gds-code =  goods.gds-code and
     6093                    buf_gds-obj.obj-type =  sl-obj-list.obj-type and
     6094                    buf_gds-obj.obj-code =  sl-obj-list.obj-code :
     6095              assign
     6096               f-qnty       = f-qnty      + buf_gds-obj.fact-qnty
     6097               f-cost-sum   = f-cost-sum  + determined(buf_gds-obj.fact-rubl)
     6098               f-sale-sum   = f-sale-sum  + buf_gds-obj.fact-sale
     6099               f-free-qnty  = f-free-qnty + buf_gds-obj.free-qnty
     6100               f-cost-pr   = if f-qnty = 0 then 0 else f-cost-sum / f-qnty
     6101               f-sale-pr   = if f-qnty = 0 then 0 else f-sale-sum / f-qnty
