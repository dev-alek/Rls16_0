      569   define variable var-report-r-b as character no-undo .
      570   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      571   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      572     (output var-report-r-b
      573     )  .
      574   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      575   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      576   define  shared variable RepPathName        as character no-undo .
      577   define  shared variable PrintRubl          as logical   no-undo .
      578   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      579   define variable v-waitfram-action01         as character   no-undo .
      580   define variable v-waitfram-action02         as character   no-undo .
      581   define variable v-waitfram-action03         as character   no-undo .
      582   define variable mWaitFramTextBeg            as character   no-undo.
      583   define variable mWaitFramTextEnd            as character   no-undo.
      584   define variable mWaitFramView               as logical     no-undo.
      585   define variable mWaitProcEvent              as logical     no-undo init yes.
      586   define variable mWaitFramInterval           as integer     no-undo init 1 .
      587   define variable mWaitFramStop               as logical     no-undo.
      588   define variable mWaitFramStopUser           as logical     no-undo.
      589   define variable mWaitFramStopTimeOut        as logical     no-undo.
      590   define variable mWaitFramStartProc          as datetime-tz no-undo.
      591   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      592   define button B-WaitFramStop auto-end-key
      593        label "Стоп"
      594        size 10 by 1 tooltip "Остоновить процесс".
      595   define button B-viewProcInfo
      596        label "Информация"
      597        size 15 by 1 tooltip "Информация о процесс".
      598   define frame waitfram
      599     v-waitfram-action01 format "x(72)" no-label skip
      600     v-waitfram-action02 format "x(72)" no-label skip
      601     v-waitfram-action03 format "x(72)" no-label skip
      602     B-viewProcInfo
      603     B-WaitFramStop at row 4 col 30
      604     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      605     .
      606   define new global shared variable mBatchMode as logical no-undo init ?.
      607   define variable mFramBachModHandle as handle no-undo.
      608   mFramBachModHandle = frame waitfram:handle.
      609   define variable mFameOldVis as logical no-undo.
      610   define variable mVisCUrentVin as logical no-undo.
      611   if session:batch-mode
      612   then
      613      mBatchMode = yes.
      614   if mBatchMode = ? then do:
      615     mVisCUrentVin = current-window:visible.
      616     mFameOldVis = mFramBachModHandle:visible.
      617     mFramBachModHandle:visible  = yes.
      618     mBatchMode = mFramBachModHandle:visible ne yes.
      619     mFramBachModHandle:visible = mFameOldVis.
      620     current-window:visible = mVisCUrentVin.
      621   end.
      622    if  log-manager:logfile-name ne ?
      623     then DO:
      624         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      625         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      626         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      627     end.
      628   on choose of B-WaitFramStop in frame waitfram
      629   do:
      630     mWaitFramStop = yes.
      631     mWaitFramStopUser = yes.
      632   end.
      633   function waitfram-check-timeout returns logical():
      634      define variable vtime as int64 no-undo.
      635      if mWaitFramStopTimeOut
      636      then
      637         return yes.
      638      vtime = ( now - mWaitFramStartProc ) / 1000 .
      639      if     mWaitFramTimeOut ne ?
      640         and mWaitFramTimeOut ne 0
      641         and mWaitFramTimeOut lt vtime
      642      then do:
      643         mWaitFramStopTimeOut = yes.
      644      end.
      645      return mWaitFramStopTimeOut.
      646   end.
      647   procedure waitfram-hide :
      648     if not session:batch-mode
      649     then do
      650     on error undo, return error return-value
      651     :
      652       pause 0 before-hide .
      653       if not mBatchMode then
      654         hide frame waitfram .
      655     if     not mWaitFramView
      656        and mWaitProcEvent
      657     then
      658       process events .
      659     end.
      660   end procedure.
      661   procedure waitfram-show :
      662     define input  parameter p-message as character no-undo .
      663     define variable v-left-margin as integer   no-undo .
      664     if not session:batch-mode
      665     then do
      666     on error undo, return error return-value
      667     :
      668       if length(p-message) <= 70 then do:
      669         assign
      670           v-left-margin = integer((70 - length(p-message)) / 2)
      671         .
      672         assign
      673           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      674         .
      675         assign
      676           v-waitfram-action01 = " "
      677           v-waitfram-action02 = " "
      678                                    + fill(" ", v-left-margin)
      679                                    + p-message
      680           v-waitfram-action03 = " "
      681         .
      682       end.
      683       else do:
      684         define variable vRindex1 as integer no-undo.
      685         define variable vRindex2 as integer no-undo.
      686         vRindex1 = r-index(p-message," ",70).
      687         if vRindex1 = 0
      688         then
      689            vRindex1 = 70.
      690         if length(p-message)  <= vRindex1 + 70 then do:
      691           assign
      692             v-waitfram-action01 = " "
      693             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      694             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      695           .
      696         end.
      697         else do:
      698           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      699           if vRindex2 <= vRindex1
      700           then
      701              vRindex2 = vRindex1 + 70.
      702           assign
      703             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      704             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      705             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      706           .
      707         end.
      708       end.
      709       B-viewProcInfo:visible   in frame waitfram = no.
      710       B-viewProcInfo:sensitive in frame waitfram = no.
      711       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      712       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      713       if  (   mWaitFramView
      714          or  mWaitProcEvent)
      715          and not mBatchMode
      716       then
      717          display
      718             v-waitfram-action01 skip
      719             v-waitfram-action02 skip
      720             v-waitfram-action03 skip
      721          with frame waitfram .
      722       if     mWaitFramView
      723          then do:
      724             if     mWaitFramInterval ne ?
      725                and not mBatchMode
      726             then
      727                wait-for go of frame waitfram pause mWaitFramInterval.
      728          end.
      729          else
      730             if     mWaitProcEvent
      731                and not mBatchMode
      732             then
      733                process events .
      734     end.
      735   end procedure.
      736      procedure waitfram-show-this:
      737         define input  parameter iInterval as int64 no-undo.
      738         define variable vtime as int64 no-undo.
      739         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      740         mWaitFramInterval = iInterval.
      741         run waitfram-show (substitute("&1&2 &3&4" ,
      742                                       mWaitFramTextBeg ,
      743                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      744                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      745                                       mWaitFramTextEnd
      746                                      )
      747                           ).
      748      end.
      749      procedure WaitFramRunPause:
      750         define input  parameter iInterval as dec no-undo.
      751         define variable vStart  as datetime-tz no-undo.
      752         define variable vend    as datetime-tz no-undo.
      753         define variable vint as int64 no-undo.
      754         define variable vOk as logical no-undo.
      755         vStart = now.
      756         vend   = vStart.
      757         publish "WaitFramPause" (iInterval,output vOk).
      758         vend   =  now.
      759         vint = vend - vStart.
      760         vint = iInterval - vint / 1000.
      761         if     not mWaitFramStop
      762            and (   vint > 0
      763                 or (    not vOk
      764                     and iInterval eq ?
      765                     )
      766                 )
      767         then
      768            run waitfram-show-this (iInterval).
      769         vend   =  now.
      770         vint = vend - vStart.
      771         vint = iInterval - vint / 1000.
      772         if     not mWaitFramStop
      773            and vint > 0
      774         then do:
      775            run gbl/pause.p (vint * 1000).
      776         end.
      777         if iInterval ne ?
      778         then
      779            publish "WaitFramStop".
      780         waitfram-check-timeout().
      781      end.
      782      procedure WaitFramWaitFor:
      783         define input  parameter iInterval as dec no-undo.
      784         assign
      785            mWaitFramStartProc   = now
      786            mWaitFramStopUser    = no
      787            mWaitFramStopTimeOut = no
      788         .
      789         block-wait:
      790         do while not mWaitFramStop:
      791            run WaitFramRunPause (iInterval).
      792            if  waitfram-check-timeout()
      793            then do:
      794               leave block-wait.
      795            end.
      796         end.
      797         run waitfram-hide.
      798      end.
      799   procedure waitfram-join :
      800     define input  parameter p-line-1  as character no-undo .
      801     define input  parameter p-line-2  as character no-undo .
      802     define input  parameter p-line-3  as character no-undo .
      803     define output parameter p-message as character no-undo .
      804     do
      805     on error undo, return error return-value
      806     :
      807       assign
      808         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      809                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      810                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      811       .
      812     end.
      813   end procedure.
      814   function waitfram-join-function returns character
      815     (input p-line-1 as character
      816     ,input p-line-2 as character
      817     ,input p-line-3 as character
      818     ).
      819     define variable v-message as character no-undo .
      820     run waitfram-join in this-procedure
      821       (input  p-line-1
      822       ,input  p-line-2
      823       ,input  p-line-3
      824       ,output v-message
      825       ) .
      826     return v-message .
      827   end function .
      828   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      829   procedure factord :
      830     define input  parameter p-fact-date            as date    no-undo .
      831     define input  parameter p-fact-time            as integer no-undo .
      832     define input  parameter p-fact-num             as integer no-undo .
      833     define input  parameter p-shift-date           as date    no-undo .
      834     define input  parameter p-shift-num            as integer no-undo .
      835     define input  parameter p-shift-on             as logical no-undo .
      836     define output parameter p-fact-order           as decimal no-undo .
      837     define output parameter p-shift-end-fact-order as decimal no-undo .
      838     define output parameter p-day-end-fact-order   as decimal no-undo .
      839     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      840     if p-fact-date = ?
      841     then do:
      842       return error "Не указана фактическая дата" .
      843     end.
      844     define variable v-fact-date-num as integer no-undo .
      845     assign
      846       v-fact-date-num = integer(p-fact-date)
      847     .
      848     if p-fact-num = ?
      849     or p-fact-num = 0
      850     then do:
      851       return error "Не задан p-fact-num " + string(p-fact-num) .
      852     end.
      853     if p-fact-num < 0
      854     then do:
      855       return error "Отрицательный fact-num " + string(p-fact-num) .
      856     end.
      857     if p-fact-num >= 100000000
      858     then do:
      859       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      860     end.
      861     if p-shift-on = true
      862     then do:
      863       if p-shift-date = ?
      864       then do:
      865         return error "Не задана дата смены" .
      866       end.
      867       if p-shift-num = ?
      868       or p-shift-num = 0
      869       then do:
      870         return error "Не задан номер смены" .
      871       end.
      872     end.
      873     else do:
      874       assign
      875         p-shift-date = p-fact-date
      876         p-shift-num  = 24
      877       .
      878     end.
      879     define variable v-shift-offset as integer no-undo .
      880     if p-shift-date = p-fact-date
      881     then do:
      882       assign
      883         v-shift-offset = 1
      884       .
      885     end.
      886     if p-shift-date < p-fact-date
      887     then do:
      888       assign
      889         v-shift-offset = 0
      890       .
      891     end.
      892     if p-shift-date > p-fact-date
      893     then do:
      894       message
      895         vss-workfile vss-revision vss-description skip
      896         "Неправильная дата закрытия смены" skip
      897         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      898         view-as alert-box error .
      899       undo, return error
      900         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      901           ,string(p-fact-date, '99/99/9999':U)
      902           ,string(p-shift-date, '99/99/9999':U)
      903           )
      904       .
      905     end.
      906     if p-shift-num < 1
      907     or p-shift-num > 24
      908     then do:
      909       message
      910         vss-workfile vss-revision vss-description skip
      911         "Неправильный номер смены" skip
      912         "p-shift-num" p-shift-num skip
      913         view-as alert-box error .
      914       undo, return error return-value .
      915     end.
      916     assign
      917       p-fact-order           = v-fact-date-num
      918                              + v-shift-offset * 0.5
      919                              + p-shift-num    * 0.02 - 0.01
      920                              + p-fact-num     * 0.0000000001
      921       p-shift-end-fact-order = v-fact-date-num
      922                              + v-shift-offset * 0.5
      923                              + p-shift-num    * 0.02
      924       p-day-end-fact-order   = v-fact-date-num
      925                              + 0.99
      926     .
      927     if p-fact-order           <= v-fact-date-num
      928     or p-shift-end-fact-order <= v-fact-date-num
      929     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      930     or p-shift-end-fact-order >= p-day-end-fact-order
      931     then do:
      932       message
      933         vss-workfile vss-revision vss-description skip
      934         "Внутренняя ошибка при генерации фактического номера" skip
      935         "p-fact-date"            p-fact-date            skip
      936         "p-fact-time"            p-fact-time            skip
      937         "p-fact-num"             p-fact-num             skip
      938         "p-shift-date"           p-shift-date           skip
      939         "p-shift-num"            p-shift-num            skip
      940         "p-shift-on"             p-shift-on             skip
      941         "p-shift-end-fact-order" p-shift-end-fact-order skip
      942         "p-day-end-fact-order"   p-day-end-fact-order   skip
      943         "v-fact-date-num"        v-fact-date-num        skip
      944         view-as alert-box error .
      945       undo, return error return-value .
      946     end.
      947   end procedure.
      948   procedure day-begin-fact-order :
      949     define input  parameter p-fact-date            as date    no-undo .
      950     define output parameter p-day-begin-fact-order as decimal no-undo .
      951     do
      952     on error undo, return error return-value
      953     :
      954       if p-fact-date = ?
      955       then do:
      956         assign
      957           p-day-begin-fact-order = 0
      958         .
      959       end.
      960       else do:
      961         assign
      962           p-day-begin-fact-order = integer(p-fact-date)
      963         .
      964       end.
      965     end.
      966   end procedure.
      967   procedure factord-max-fact-order :
      968     define output parameter p-max-fact-order as decimal   no-undo .
      969     do
      970     on error undo, return error return-value
      971     :
      972       run day-begin-fact-order in this-procedure
      973         (input  date(1, 1, 5000)
      974         ,output p-max-fact-order
      975         ) .
      976     end.
      977   end procedure.
      978   procedure factord-cut-archive :
      979     define input  parameter p-obj-type             as character no-undo .
      980     define input  parameter p-obj-code             as integer   no-undo .
      981     define input  parameter p-fact-date            as date      no-undo .
      982     define output parameter p-shift-on             as logical   no-undo .
      983     define output parameter p-shift-date           as date      no-undo .
      984     define output parameter p-shift-num            as integer   no-undo .
      985     define output parameter p-day-end-fact-order   as decimal   no-undo .
      986     define output parameter p-shift-end-fact-order as decimal   no-undo .
      987     define variable v-fact-order as decimal   no-undo .
      988     define buffer buf_shift-obj for ub.shift-obj .
      989     do
      990     on error undo, return error return-value
      991     :
      992   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      993   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      994     (input  p-obj-type
      995     ,input  p-obj-code
      996     ,input  'shift-on=request'
      997     ,output p-shift-on
      998     ) no-error .
      999       if error-status :error
     1000       then do:
     1001         message
     1002           vss-workfile vss-revision vss-description skip
     1003           "Ошибка при определении атрибута объекта" skip
     1004           "Объект" p-obj-type p-obj-code skip
     1005           error-status :get-message(1) skip
     1006           return-value skip
     1007           view-as alert-box error .
     1008         undo, return error return-value .
     1009       end.
     1010       if p-shift-on = false
     1011       then do:
     1012         assign
     1013           p-shift-date               = ?
     1014           p-shift-num                = 0
     1015         .
     1016       end.
     1017       else do:
     1018         find first buf_shift-obj share-lock
     1019           where buf_shift-obj.obj-type   = p-obj-type
     1020             and buf_shift-obj.obj-code   = p-obj-code
     1021             and buf_shift-obj.shift-date > p-fact-date
     1022           use-index pi
     1023           no-error .
     1024         if not available buf_shift-obj
     1025         or buf_shift-obj.status_ <> 'зкр':U
     1026         then do:
     1027           message
     1028             vss-workfile vss-revision vss-description skip
     1029             "Невозможно вычислить последнюю смену" skip
     1030             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1031             "Объект" p-obj-type p-obj-code skip
     1032             "Дата" p-fact-date skip
     1033             view-as alert-box error .
     1034           undo, return error return-value .
     1035         end.
     1036         find last buf_shift-obj share-lock
     1037           where buf_shift-obj.obj-type = p-obj-type
     1038             and buf_shift-obj.obj-code = p-obj-code
     1039             and buf_shift-obj.shift-date <= p-fact-date
     1040           use-index pi
     1041           no-error .
     1042         if available buf_shift-obj
     1043         then do:
     1044           if  buf_shift-obj.status_ = 'зкр':U
     1045           then do:
     1046             assign
     1047               p-shift-date = buf_shift-obj.shift-date
     1048               p-shift-num  = buf_shift-obj.shift-num
     1049             .
     1050           end.
     1051           else do:
     1052             message
     1053               vss-workfile vss-revision vss-description skip
     1054               "Невозможно вычислить последнюю смену" skip
     1055               "Статус смены отличен от статуса" 'зкр':U skip
     1056               "Объект" p-obj-type p-obj-code skip
     1057               "Дата" p-fact-date skip
     1058               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1059               view-as alert-box error .
     1060             undo, return error return-value .
     1061           end.
     1062         end.
     1063         else do:
     1064           assign
     1065             p-shift-date = p-fact-date - 1
     1066             p-shift-num  = 1
     1067           .
     1068         end.
     1069       end.
     1070       run factord in this-procedure
     1071         (input  p-fact-date
     1072         ,input  1
     1073         ,input  1
     1074         ,input  p-shift-date
     1075         ,input  p-shift-num
     1076         ,input  p-shift-on
     1077         ,output v-fact-order
     1078         ,output p-shift-end-fact-order
     1079         ,output p-day-end-fact-order
     1080         ) no-error .
     1081       if error-status :error
     1082       then do:
     1083         message
     1084           vss-workfile vss-revision vss-description skip
     1085           "Ошибка при вызове процедуры factord"
     1086           error-status :get-message(1) skip
     1087           return-value skip
     1088           view-as alert-box error .
     1089         undo, return error return-value .
     1090       end.
     1091     end.
     1092   end procedure.
     1093   procedure factord-lock-shift :
     1094     define input  parameter p-obj-type  as character no-undo .
     1095     define input  parameter p-obj-code  as integer   no-undo .
     1096     define input  parameter p-fact-date as date      no-undo .
     1097     define parameter buffer buf_shift-obj for ub.shift-obj .
     1098     define variable v-shift-on      as logical   no-undo .
     1099     define variable v-extra-message as character no-undo .
     1100     define variable v-error as character no-undo .
     1101     do
     1102     on error undo, return error return-value
     1103     :
     1104   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1105   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1106     (input  p-obj-type
     1107     ,input  p-obj-code
     1108     ,input  'shift-on=request'
     1109     ,output v-shift-on
     1110     ) no-error .
     1111       if error-status :error
     1112       then do:
     1113         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1114         undo, return error v-error .
     1115       end.
     1116       if v-shift-on = true
     1117       then do:
     1118         find first buf_shift-obj share-lock
     1119           where buf_shift-obj.obj-type   = p-obj-type
     1120             and buf_shift-obj.obj-code   = p-obj-code
     1121             and buf_shift-obj.shift-date > p-fact-date
     1122           use-index pi
     1123           no-error .
     1124         if not available buf_shift-obj
     1125         or buf_shift-obj.status_ <> 'зкр':U
     1126         then do:
     1127           find last buf_shift-obj
     1128             where buf_shift-obj.obj-type = p-obj-type
     1129               and buf_shift-obj.obj-code = p-obj-code
     1130               and buf_shift-obj.status_  = 'зкр':U
     1131             use-index stts
     1132             no-error .
     1133           if available buf_shift-obj
     1134           then do:
     1135             assign
     1136               v-extra-message =
     1137                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1138                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1139                               )
     1140             .
     1141           end.
     1142           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1143           undo, return error v-error .
     1144         end.
     1145       end.
     1146     end.
     1147   end procedure.
     1148   procedure factord-end-day :
     1149     define input  parameter p-fact-date            as date    no-undo .
     1150     define output parameter p-day-end-fact-order   as decimal no-undo .
     1151     do
     1152     on error undo, return error return-value
     1153     :
     1154       if p-fact-date = ?
     1155       then do:
     1156         return error "Не указана фактическая дата" .
     1157       end.
     1158       assign
     1159         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1160       .
     1161     end.
     1162   end procedure.
     1163   procedure factord-to-date :
     1164     define input  parameter p-fact-order as decimal no-undo .
     1165     define output parameter p-fact-date  as date    no-undo .
     1166     define variable v-ref-date  as date      no-undo .
     1167     define variable v-ref-delta as integer   no-undo .
     1168     do
     1169     on error undo, return error return-value
     1170     :
     1171       if p-fact-order = ?
     1172       or p-fact-order = 0
     1173       then do:
     1174         return error "Не указан fact-order" .
     1175       end.
     1176       assign
     1177         v-ref-date  = date(1, 1, 2000)
     1178       .
     1179       assign
     1180         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1181       .
     1182       assign
     1183         p-fact-date = v-ref-date + v-ref-delta
     1184       .
     1185     end.
     1186   end procedure.
     1187   procedure factord-to-fact-num :
     1188     define input  parameter p-fact-order as decimal no-undo .
     1189     define output parameter p-fact-num   as integer no-undo .
     1190     define variable v-fact-order-trunc as decimal no-undo .
     1191     do
     1192     on error undo, return error return-value
     1193     :
     1194       if p-fact-order = ?
     1195       or p-fact-order = 0
     1196       then do:
     1197         return error "Не указан fact-order" .
     1198       end.
     1199       assign
     1200        v-fact-order-trunc = truncate(p-fact-order, 2)
     1201       .
     1202       assign
     1203         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1204       .
     1205     end.
     1206   end procedure.
     1207   procedure factord-to-shift-num :
     1208     define input  parameter p-fact-order as decimal no-undo .
     1209     define output parameter p-shift-num   as integer no-undo .
     1210     define variable  p-shift-numd  as decimal   no-undo .
     1211     define variable v-fact-order-trunc as decimal no-undo .
     1212     do
     1213     on error undo, return error return-value
     1214     :
     1215       if p-fact-order = ?
     1216       or p-fact-order = 0
     1217       then do:
     1218         return error "Не указан fact-order" .
     1219       end.
     1220       assign
     1221        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1222       .
     1223       if v-fact-order-trunc < 0.5 then do:
     1224         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1225       end.
     1226       assign
     1227         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1228         .
     1229        assign
     1230         p-shift-num = truncate (p-shift-numd , 0)
     1231       .
     1232     end.
     1233   end procedure.
     1234   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1235   procedure cur-time :
     1236      define output parameter p-today as date      no-undo .
     1237      define output parameter p-time  as integer   no-undo .
     1238     do
     1239     on error undo, return error
     1240     :
     1241       define variable v-date1 as date      no-undo .
     1242       define variable v-date2 as date      no-undo .
     1243       define variable v-time  as integer   no-undo .
     1244       assign
     1245         v-date1 = today
     1246         v-time  = time
     1247         v-date2 = today
     1248       .
     1249       if v-date1 <> v-date2
     1250       then do:
     1251         assign
     1252           v-date1 = today
     1253           v-time  = v-time
     1254         .
     1255       end.
     1256       assign
     1257         p-today = v-date1
     1258         p-time  = v-time
     1259       .
     1260     end.
     1261   end.
     1262   function cur-time-date returns character
     1263   :
     1264     return string(today, '99/99/9999':U) .
     1265   end.
     1266   function cur-time-mjd returns decimal
     1267   :
     1268     define variable v-date as date      no-undo .
     1269     define variable v-time as integer   no-undo .
     1270     run cur-time in this-procedure
     1271       (output v-date
     1272       ,output v-time
     1273       ) .
     1274     return integer(v-date) - 2400002 + (v-time / 86400) .
     1275   end.
     1276   function cur-time-get-ending-index returns integer
     1277   (input p-number as integer
     1278   )
     1279   :
     1280     if p-number < 0
     1281     or p-number = ?
     1282     then do:
     1283       return 1 .
     1284     end.
     1285     define variable v-rest as integer   no-undo .
     1286     assign
     1287       p-number = p-number modulo 100
     1288     .
     1289     if p-number < 20
     1290     then do:
     1291       assign
     1292         v-rest = p-number
     1293       .
     1294     end.
     1295     else do:
     1296       assign
     1297         v-rest = p-number modulo 10
     1298       .
     1299     end.
     1300     case v-rest :
     1301       when 1
     1302       then do:
     1303         return 2 .
     1304       end.
     1305       when 2 or
     1306       when 3 or
     1307       when 4
     1308       then do:
     1309         return 3 .
     1310       end.
     1311       otherwise do:
     1312         return 1 .
     1313       end.
     1314     end case .
     1315   end.
     1316   procedure cur-time-mjd-to-date :
     1317      define input  parameter i-mjd-diff as decimal no-undo.
     1318      define output parameter o-Date     as date    no-undo.
     1319      define output parameter o-Time     as integer no-undo.
     1320      define variable v-day-number as integer   no-undo .
     1321      if    i-mjd-diff < 0
     1322         or i-mjd-diff = ?
     1323      then do:
     1324         return "?" .
     1325      end.
     1326      assign
     1327         v-day-number = truncate(i-mjd-diff,0).
     1328         o-Date = date(v-day-number + 2400002).
     1329         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1330     .
     1331   end.
     1332   function cur-time-mjd-to-string returns character
     1333   (input p-mjd-diff as decimal
     1334   )
     1335   :
     1336     define variable v-day-number as integer   no-undo .
     1337     define variable v-seconds    as integer   no-undo .
     1338     define variable v-hour       as integer   no-undo .
     1339     define variable v-min        as integer   no-undo .
     1340     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1341     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1342     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1343     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1344     if p-mjd-diff < 0
     1345     or p-mjd-diff = ?
     1346     then do:
     1347       return "?" .
     1348     end.
     1349     assign
     1350       v-day-number = integer(truncate(p-mjd-diff,0))
     1351       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1352     .
     1353     if v-seconds > 86400
     1354     then do:
     1355       assign
     1356         v-seconds = 86400 - 1
     1357       .
     1358     end.
     1359     if v-seconds < 0
     1360     then do:
     1361       assign
     1362         v-seconds = 0
     1363       .
     1364     end.
     1365     assign
     1366       v-hour = truncate(v-seconds / 3600, 0)
     1367     .
     1368     assign
     1369       v-seconds = v-seconds modulo 3600
     1370     .
     1371     assign
     1372       v-min = truncate(v-seconds / 60, 0)
     1373     .
     1374     assign
     1375       v-seconds = v-seconds modulo 60
     1376     .
     1377     return
     1378         (if v-day-number <> 0
     1379           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1380           else ""
     1381         )
     1382       + (if v-day-number <> 0 or v-hour <> 0
     1383           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1384           else ""
     1385         )
     1386       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1387           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1388           else ""
     1389         )
     1390       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1391       .
     1392   end.
     1393   function cur-time-string returns character
     1394   :
     1395     define variable v-date as date      no-undo .
     1396     define variable v-time as integer   no-undo .
     1397     run cur-time in this-procedure
     1398       (output v-date
     1399       ,output v-time
     1400       ) .
     1401     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1402   end.
     1403   function cur-time-string-sec returns character
     1404   :
     1405     define variable v-date as date      no-undo .
     1406     define variable v-time as integer   no-undo .
     1407     run cur-time in this-procedure
     1408       (output v-date
     1409       ,output v-time
     1410       ) .
     1411     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1412   end.
     1413   function cur-time-custom  returns character
     1414   (input p-prefix as character
     1415   ,input p-date-format as character
     1416   ,input p-delimiter as character
     1417   ,input p-time-format as character
     1418   ,input p-suffix as character
     1419   )
     1420   :
     1421     define variable v-date as date      no-undo .
     1422     define variable v-time as integer   no-undo .
     1423     run cur-time in this-procedure
     1424       (output v-date
     1425       ,output v-time
     1426       ) .
     1427     return
     1428       p-prefix
     1429       + string(v-date, p-date-format)
     1430       + p-delimiter
     1431       + string(v-time, p-time-format)
     1432       + p-suffix
     1433       .
     1434   end.
     1435   function cur-time-print  returns character
     1436   :
     1437     define variable v-date as date      no-undo .
     1438     define variable v-time as integer   no-undo .
     1439     run cur-time in this-procedure
     1440       (output v-date
     1441       ,output v-time
     1442       ) .
     1443     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1444   end.
     1445   function cur-time-datetime returns datetime
     1446   :
     1447     define variable v-char as character no-undo .
     1448     define variable v-datetime as datetime no-undo .
     1449     v-char = cur-time-string().
     1450     v-datetime = datetime(v-char).
     1451     return  v-datetime.
     1452   end.
     1453   function cur-time-string-msec returns character
     1454   :
     1455     define variable v-date as datetime  no-undo .
     1456     v-date = now.
     1457     return string(v-date) .
     1458   end.
     1459   define temp-table temp-font no-undo
     1460     field fontnum  as integer
     1461     field fontname as character
     1462     field fontsize as character
     1463     field fonttype as character
     1464     field font-h   as integer
     1465     field font-w   as integer
     1466     field v-row    as integer
     1467     field v-col    as integer
     1468     field v-row-lans as integer
     1469     field v-col-lans as integer
     1470   index pi fontnum
     1471   .
     1472   procedure get-font-ini :
     1473     do
     1474     on error undo, return error return-value
     1475     :
     1476   define variable ii as integer   no-undo .
     1477   define variable v-font7 as character no-undo .
     1478   define variable v-font as character no-undo .
     1479   define variable loc-name as character no-undo .
     1480   define variable loc-size as character no-undo .
     1481   define variable loc-type as character no-undo .
     1482   define variable old_H as integer   no-undo .
     1483   define variable old_w as integer   no-undo .
     1484   define variable old-row  as integer   no-undo .
     1485   define variable old-col  as integer   no-undo .
     1486   define variable old-row-lans  as integer   no-undo .
     1487   define variable old-col-lans  as integer   no-undo .
     1488   define variable vv as integer   no-undo .
     1489   empty temp-table temp-font.
     1490     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     1491       case num-entries (v-font7) :
     1492         when 4 then do:
     1493             assign
     1494               loc-name = entry ( 1 , v-font7 )
     1495               loc-size = entry ( 2 , v-font7 )
     1496               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     1497             .
     1498         end.
     1499         when 3 then do:
     1500             assign
     1501               loc-name = entry ( 1 , v-font7 )
     1502               loc-size = entry ( 2 , v-font7 )
     1503               loc-type = entry ( 3 , v-font7 )
     1504             .
     1505         end.
     1506         when 2 then  do:
     1507             assign
     1508               loc-name = entry ( 1 , v-font7 )
     1509               loc-size = entry ( 2 , v-font7 )
     1510               loc-type = ""
     1511             .
     1512         end.
     1513         when 1 then do:
     1514             assign
     1515               loc-name = trim(entry ( 1 , v-font7 ))
     1516               loc-size = ""
     1517               loc-type = ""
     1518             .
     1519         end.
     1520       end case.
     1521     create temp-font.
     1522     assign
     1523       temp-font.fontnum  = 7
     1524       temp-font.fontname = trim(loc-name)
     1525       temp-font.fontsize = trim(loc-size)
     1526       temp-font.fonttype = trim(loc-type)
     1527       temp-font.v-row    = 62
     1528       temp-font.v-col    = 136
     1529       temp-font.v-row-lans = 43
     1530       temp-font.v-col-lans = 198
     1531     .
     1532     repeat ii = 16 to 100 :
     1533       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     1534       if v-font = "" or v-font = ? then leave.
     1535       case num-entries (v-font) :
     1536         when 4 then do:
     1537             assign
     1538               loc-name = entry ( 1 , v-font )
     1539               loc-size = entry ( 2 , v-font )
     1540               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     1541             .
     1542         end.
     1543         when 3 then do:
     1544             assign
     1545               loc-name = entry ( 1 , v-font )
     1546               loc-size = entry ( 2 , v-font )
     1547               loc-type = entry ( 3 , v-font )
     1548             .
     1549         end.
     1550         when 2 then do:
     1551             assign
     1552               loc-name = entry ( 1 , v-font )
     1553               loc-size = entry ( 2 , v-font )
     1554               loc-type = ""
     1555             .
     1556         end.
     1557         when 1 then do:
     1558             assign
     1559               loc-name = trim(entry ( 1 , v-font ))
     1560               loc-size = ""
     1561               loc-type = ""
     1562             .
     1563         end.
     1564       end case.
     1565     create temp-font.
     1566     assign
     1567       temp-font.fontnum  = ii
     1568       temp-font.fontname = trim(loc-name)
     1569       temp-font.fontsize = trim(loc-size)
     1570       temp-font.fonttype = trim(loc-type)
     1571     .
     1572     end.
     1573       for each temp-font :
     1574          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     1575          if  vv = ? then vv =  0 .
     1576           run rep/exfont.p (
     1577             input   temp-font.fontname ,
     1578             input   vv ,
     1579             input   temp-font.fonttype ,
     1580             output  temp-font.font-h   ,
     1581             output  temp-font.font-w   )
     1582           .
     1583       end.
     1584   find first temp-font where  temp-font.fontnum  = 7  .
     1585   old_H = temp-font.font-H .
     1586   old_w = temp-font.font-W .
     1587   old-row = temp-font.v-row .
     1588   old-col = temp-font.v-col .
     1589   old-row-lans = temp-font.v-row-lans .
     1590   old-col-lans = temp-font.v-col-lans .
     1591       for each temp-font where
     1592                temp-font.fontnum  <> 7 :
     1593           assign
     1594               temp-font.v-row    = old_H * old-row / temp-font.font-h
     1595               temp-font.v-col    = old_W * old-col / temp-font.font-W
     1596               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     1597               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     1598           .
     1599       end.
     1600     end.
     1601   end procedure.
     1602   PROCEDURE How-name :
     1603   define input  parameter h as integer no-undo .
     1604   define input  parameter w as integer no-undo .
     1605   define output parameter n as character  no-undo .
     1606   define variable A4port-H as integer   no-undo init 63.
     1607   define variable A4port-W as integer   no-undo init 136.
     1608   define variable A4lans-H as integer   no-undo init 43.
     1609   define variable A4lans-W as integer   no-undo init 198.
     1610   define variable Strim-W  as integer   no-undo init 278.
     1611   run define-a4-size (
     1612        input ReportFontNum
     1613       ,output A4port-H
     1614       ,output A4port-W
     1615       ,output A4lans-H
     1616       ,output A4lans-W ).
     1617   If w >= 1 and w <= A4port-W Then DO:
     1618     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1619     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     1620     If h > A4port-H              Then n = "to-file":U.
     1621   End.
     1622   If w > A4port-W and w <= A4lans-W Then DO:
     1623     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1624     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1625     If h > A4port-H              Then n = "to-file":U.
     1626   End.
     1627   If w > A4lans-W and w <= Strim-W Then DO:
     1628     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     1629     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1630     If h > A4port-H              Then n = "to-file":U.
     1631   End.
     1632   If w > Strim-W Then DO:
     1633      n = "to-file":U.
     1634   End.
     1635   END PROCEDURE.
     1636   PROCEDURE define-a4-size :
     1637   define input  parameter p-ReportFontNum as integer   no-undo .
     1638   define output parameter A4port-H as integer   no-undo .
     1639   define output parameter A4port-W as integer   no-undo .
     1640   define output parameter A4lans-H as integer   no-undo .
     1641   define output parameter A4lans-W as integer   no-undo .
     1642   if not can-find (first temp-font ) then do:
     1643      run get-font-ini .
     1644   end.
     1645   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     1646   if available temp-font then do:
     1647   assign
     1648     A4port-H = temp-font.v-row
     1649     A4port-W = temp-font.v-col
     1650     A4lans-H = temp-font.v-row-lans
     1651     A4lans-W = temp-font.v-col-lans
     1652   .
     1653   end.
     1654   else do:
     1655   assign
     1656     A4port-H = 63
     1657     A4port-W = 136
     1658     A4lans-H = 43
     1659     A4lans-W = 198
     1660   .
     1661   end.
     1662   END PROCEDURE.
     1663   define stream out-stream.
     1664   define buffer buf_shift-obj_from  for ub.shift-obj.
     1665   define buffer buf_shift-obj_till  for ub.shift-obj.
     1666   define buffer buf_shift-obj       for ub.shift-obj.
     1667   define buffer buf_rvs-doc         for ub.rvs-doc.
     1668   define buffer buf_rvs-line-pump   for ub.rvs-line-pump.
     1669   define buffer buf_goods           for ub.goods.
     1670   define variable g#report-num      as integer   no-undo .
     1671   define variable v-obj-counter     as integer   no-undo .
     1672   define variable v-i               as integer   no-undo .
     1673   define variable v-j               as integer   no-undo .
     1674   define variable v-column-count    as integer   no-undo .
     1675   define variable v-start-gds-count as integer   no-undo .
     1676   define variable v-line-1          as character no-undo .
     1677   define variable v-line-2          as character no-undo .
     1678   define variable v-line-v          as character no-undo .
     1679   define variable v-clmn-label-1    as character no-undo .
     1680   define variable v-clmn-label-2    as character no-undo .
     1681   define variable v-clmn-label-3    as character no-undo .
     1682   define variable v-clmn-label-4    as character no-undo .
     1683   define variable v-clmn-format     as character no-undo .
     1684   define variable v-clmn-sizes      as character no-undo .
     1685   define temp-table tt-ptrl-goods no-undo like ub.goods
     1686     field obj-type      like ub.shift-obj.obj-type
     1687     field obj-code      like ub.shift-obj.obj-code
     1688   index pi is primary unique
     1689     obj-type
     1690     obj-code
     1691     gds-code
     1692   .
     1693   define temp-table tt-rep-line no-undo
     1694     field obj-type      like ub.rvs-line-pump.obj-type
     1695     field obj-code      like ub.rvs-line-pump.obj-code
     1696     field rvs-code      like ub.rvs-line-pump.rvs-code
     1697     field pump-code     like ub.rvs-line-pump.pump-code
     1698     field gds-code      like ub.rvs-line-pump.gds-code
     1699     field meas-el-cnt   like ub.rvs-line-pump.meas-el-cnt
     1700     field meas-mh-qnty  like ub.rvs-line-pump.meas-mh-qnty
     1701     field shift-date    like ub.shift-obj.shift-date
     1702     field shift-num     like ub.shift-obj.shift-num
     1703   index pi is unique primary
     1704     obj-type
     1705     obj-code
     1706     rvs-code
     1707     gds-code
     1708     pump-code
     1709   index print
     1710     shift-date
     1711     shift-num
     1712     rvs-code
     1713     gds-code
     1714     pump-code
     1715   .
     1716   define temp-table tt-rep-head no-undo
     1717     field obj-type      like ub.shift-obj.obj-type
     1718     field obj-code      like ub.shift-obj.obj-code
     1719     field gds-code      like ub.goods.gds-code
     1720     field pump-code     like ub.pump.pump-code
     1721     field ptrl-name     like ub.goods.gds-name
     1722     field pump-name     as character
     1723   index pi is primary unique
     1724     obj-type
     1725     obj-code
     1726     gds-code
     1727     pump-code
     1728   .
     1729   function str-format returns character ( val as decimal ) forward.
     1730   do on error undo, return error return-value :
     1731     run waitfram-show in this-procedure ( "Формирование отчета..." ) .
     1732     empty temp-table tt-rep-head.
     1733     empty temp-table tt-rep-line.
     1734     empty temp-table tt-ptrl-goods.
     1735     run get-report-num in my-handle (output g#report-num).
     1736   output stream out-stream to value( string( session:temp-directory +
     1737                                        "rpt" + string( g#report-num ) ) )
     1738                                        page-size  value(62) .
     1739     run fill-tt-rep-line in this-procedure .
     1740     assign
     1741       v-obj-counter     = 0
     1742       v-start-gds-count = 3
     1743       v-column-count    = v-start-gds-count - 1
     1744     .
     1745     for each tt-rep-head no-lock
     1746       break by tt-rep-head.gds-code
     1747             by tt-rep-head.pump-code
     1748     :
     1749         assign
     1750           v-column-count    = v-column-count + 1
     1751           v-start-gds-count = if first-of( tt-rep-head.gds-code ) then v-column-count else v-start-gds-count
     1752           v-line-2          = v-line-2 + substitute(",&1:&2" , v-column-count, v-column-count + 1 )
     1753           v-clmn-format     = v-clmn-format + substitute("&1=@;&2=@;", v-column-count, v-column-count + 1)
     1754           v-column-count    = v-column-count + 1
     1755           v-clmn-label-1    = v-clmn-label-1 + if first-of( tt-rep-head.gds-code ) then tt-rep-head.ptrl-name + chr(44) + chr(44) else chr(44) + chr(44)
     1756           v-clmn-label-2    = v-clmn-label-2 + substitute( "ТРК &1" , tt-rep-head.pump-code ) + chr(44) + chr(44)
     1757           v-clmn-label-3    = v-clmn-label-3 + "Измеряемые счетчики" + chr(44) + "Измеряемые обороты" + chr(44)
     1758           v-clmn-sizes      = v-clmn-sizes + "20"  + chr(44) + "20"  + chr(44)
     1759         .
     1760       if last-of( tt-rep-head.gds-code ) then do :
     1761         assign
     1762           v-column-count    = v-column-count + 1
     1763           v-line-1          = v-line-1 + substitute(",&1:&2", v-start-gds-count ,  v-column-count )
     1764           v-clmn-format     = v-clmn-format + substitute("&1=@;", v-column-count )
     1765           v-start-gds-count = v-column-count
     1766           v-line-v          = v-line-v + substitute("&1=2:3/" , v-column-count )
     1767           v-clmn-label-1    = v-clmn-label-1 + chr(44)
     1768           v-clmn-label-2    = v-clmn-label-2 + "Сумма измеряемых оборотов" + chr(44)
     1769           v-clmn-label-3    = v-clmn-label-3 + chr(44)
     1770           v-clmn-sizes      = v-clmn-sizes + "20"  + chr(44)
     1771         .
     1772       end.
     1773     end.
     1774     if v-column-count = 2 then do:
     1775       message
     1776         "В выбраном диапазоне нет ни одной сверки."
     1777       view-as alert-box information.
     1778       run clear-all in this-procedure .
     1779       return .
     1780     end.
     1781     do v-i = 1 to v-column-count :
     1782       assign
     1783         v-clmn-label-4 = v-clmn-label-4 + string(v-i) + chr(44)
     1784       .
     1785     end.
     1786     assign
     1787       v-line-1      = trim( v-line-1 , chr(44) )
     1788       v-line-2      = trim( v-line-2 , chr(44) )
     1789       v-line-v      = trim( v-line-v , "/" )
     1790       v-clmn-sizes  = trim( v-clmn-sizes , chr(44) )
     1791       v-clmn-format = trim( v-clmn-format , ";" )
     1792     .
     1793     assign
     1794       sheetf.sheet-num          = 1
     1795       sheetf.MergeCellsH        = v-line-1 + '/' + v-line-2 + '/'
     1796       sheetf.MergeCellsV        = "1=1:3/2=1:3/" + v-line-v
     1797       sheetf.Excel-Column-Lable = "Смена / Дата"  + chr(44) + "Номер документа сверки" + chr(44) + v-clmn-label-1
     1798                                   + chr(10)
     1799                                                   + chr(44)                            + chr(44) + v-clmn-label-2
     1800                                   + chr(10)
     1801                                                   + chr(44)                            + chr(44) + v-clmn-label-3
     1802                                   + chr(10)
     1803                                                                                                              + v-clmn-label-4
     1804       sheetf.colformat          = "1=@;2=@" + chr(4) + v-clmn-format + chr(4) + "Отчет"
     1805       sheetf.Sizes              = "20" + chr(44) + "20" + chr(44) + v-clmn-sizes
     1806     .
     1807     put stream out-stream unformatted 1 skip 1 skip 1 skip.
     1808     run rep/extitle.p (1).
     1809     for each tt-rep-line no-lock
     1810       break by tt-rep-line.shift-date
     1811             by tt-rep-line.shift-num
     1812             by tt-rep-line.rvs-code
     1813             by tt-rep-line.gds-code
     1814             by tt-rep-line.pump-code
     1815     :
     1816       if first-of(tt-rep-line.rvs-code) then do :
     1817         if Make-Excel then  put   stream ForExcel unformatted
     1818           substitute("№&1 &2" , tt-rep-line.shift-num , string( tt-rep-line.shift-date , "99.99.99" ) )  CHR(9)
     1819           tt-rep-line.rvs-code CHR(9)
     1820         .
     1821       end.
     1822       if Make-Excel then  put   stream ForExcel unformatted
     1823          tt-rep-line.meas-el-cnt   CHR(9)
     1824          tt-rep-line.meas-mh-qnty  CHR(9)
     1825       .
     1826       accumulate tt-rep-line.meas-mh-qnty ( TOTAL by tt-rep-line.gds-code ) .
     1827       if last-of(tt-rep-line.gds-code) then do:
     1828         if Make-Excel then  put   stream ForExcel unformatted accum total by tt-rep-line.gds-code tt-rep-line.meas-mh-qnty.
     1829         if not last-of(tt-rep-line.rvs-code) then if Make-Excel then  put   stream ForExcel unformatted CHR(9).
     1830       end.
     1831       if last-of(tt-rep-line.rvs-code) then do:
     1832           if Make-Excel then  put   stream ForExcel unformatted skip.
     1833       end.
     1834     end.
     1835     run clear-all in this-procedure .
     1836     define variable v-user-action   as character no-undo .
     1837     define variable v-printed       as logical   no-undo .
     1838     define variable DisabledOptions as integer   no-undo .
     1839     define variable v-orient-page as character no-undo .
     1840     run How-name in this-procedure (
     1841         input ReportPageHeight,
     1842         input ReportPageWidth,
     1843         output v-orient-page )
     1844         .
     1845     if v-orient-page = "A4-lans":U then DisabledOptions = 8 .
     1846                                   else DisabledOptions = 0 .
     1847     run gbl/prnfilen.w
     1848         (input  ""
     1849         ,input  DisabledOptions
     1850         ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     1851         ,input  ReportFontNum
     1852         ,output v-user-action
     1853         ,output v-printed
     1854         ) .
     1855   end.
     1856   procedure get-fo-range :
     1857     define  input parameter p-obj-type   as character no-undo .
     1858     define  input parameter p-obj-code   as integer   no-undo .
     1859     define  input parameter p-date-from  as date      no-undo .
     1860     define  input parameter p-date-till  as date      no-undo .
     1861     define  input parameter p-shift-from as integer   no-undo .
     1862     define  input parameter p-shift-till as integer   no-undo .
     1863     define  input parameter p-is-shift   as logical   no-undo .
     1864     define output parameter p-fo-from    as decimal   no-undo initial 0.00 .
     1865     define output parameter p-fo-till    as decimal   no-undo initial 0.00 .
     1866     define variable v-shift-end-fact-order as decimal no-undo .
     1867     define variable v-day-end-fact-order   as decimal no-undo .
     1868     define variable v-fact-order           as decimal no-undo .
     1869     do
     1870     on error undo, return error return-value
     1871     :
     1872       if p-is-shift = yes
     1873       then do:
     1874         run factord in this-procedure
     1875           (
     1876              input p-date-from
     1877           ,  input 1
     1878           ,  input 1
     1879           ,  input p-date-from
     1880           ,  input p-shift-from
     1881           ,  input p-is-shift
     1882           , output p-fo-from
     1883           , output v-shift-end-fact-order
     1884           , output v-day-end-fact-order
     1885           ) no-error .
     1886         if error-status :error
     1887         then do:
     1888           message vss-workfile skip( 0 ) vss-date skip( 0 ) vss-revision skip( 1 ) vss-description skip( 1 )
     1889                   "Ошибка при вызове процедуры factord" skip( 0 )
     1890                   error-status :get-message( 1 ) skip( 0 )
     1891                   return-value skip( 1 )
     1892           view-as alert-box error .
     1893           return error return-value .
     1894         end.
     1895         run factord in this-procedure
     1896           (
     1897              input p-date-till
     1898           ,  input 1
     1899           ,  input 1
     1900           ,  input p-date-till
     1901           ,  input p-shift-till
     1902           ,  input p-is-shift
     1903           , output v-fact-order
     1904           , output p-fo-till
     1905           , output v-day-end-fact-order
     1906           ) no-error .
     1907         if error-status :error
     1908         then do:
     1909           message vss-workfile skip( 0 ) vss-date skip( 0 ) vss-revision skip( 1 ) vss-description skip( 1 )
     1910                   "Ошибка при вызове процедуры factord" skip( 0 )
     1911                   error-status :get-message( 1 ) skip( 0 )
     1912                   return-value skip( 1 )
     1913           view-as alert-box error .
     1914           return error return-value .
     1915         end.
     1916       end.
     1917       else do:
     1918         run day-begin-fact-order in this-procedure
     1919           (
     1920              input p-date-from
     1921           , output p-fo-from
     1922           ) no-error .
     1923         if error-status :error or
     1924            p-fo-from = ?
     1925         then do:
     1926           assign
     1927             p-fo-from = 0.00
     1928           .
     1929         end.
     1930         run factord-end-day in this-procedure
     1931           (
     1932              input p-date-till
     1933           , output p-fo-till
     1934           ) no-error .
     1935         if error-status :error or
     1936            p-fo-till = ?
     1937         then do:
     1938           assign
     1939             p-fo-till = truncate( p-fo-from, 0 ) + 0.99
     1940           .
     1941         end.
     1942       end.
     1943       if p-fo-till < p-fo-from
     1944       then do:
     1945         assign
     1946           p-fo-till = p-fo-from
     1947         .
     1948       end.
     1949     end.
     1950   end procedure.
     1951   procedure fill-petrl-goods-on-object :
     1952   define buffer buf_goods         for ub.goods.
     1953   define buffer buf_units         for ub.units.
     1954   define buffer buf_gds-obj       for ub.gds-obj.
     1955   define buffer buf_tt-ptrl-goods for tt-ptrl-goods.
     1956   define variable v-fact-order-from as decimal   no-undo .
     1957   define variable v-fact-order-till as decimal   no-undo .
     1958   define variable v-is-petrol as logical   no-undo .
     1959   define variable v-is-pieces as logical   no-undo .
     1960   do
     1961   on error undo, return error return-value
     1962   :
     1963     for each obj-list no-lock ,
     1964         each buf_gds-obj no-lock
     1965           where buf_gds-obj.obj-type = obj-list.obj-type
     1966             and buf_gds-obj.obj-code = obj-list.obj-code ,
     1967         each buf_goods no-lock
     1968           where buf_goods.artic     = buf_gds-obj.artic
     1969             and buf_goods.prod-type = buf_gds-obj.prod-type
     1970             and buf_goods.prod-code = buf_gds-obj.prod-code
     1971     :
     1972   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     1973     (
     1974        input buf_goods.artic
     1975     ,  input buf_goods.prod-type
     1976     ,  input buf_goods.prod-code
     1977     , output v-is-petrol
     1978     , output v-is-pieces
     1979     ) no-error.
     1980         if error-status :error or
     1981             v-is-petrol <> yes   or
     1982             v-is-pieces <> no
     1983         then do:
     1984           next .
     1985         end.
     1986         buffer-copy buf_goods to buf_tt-ptrl-goods
     1987           assign
     1988             buf_tt-ptrl-goods.obj-type = obj-list.obj-type
     1989             buf_tt-ptrl-goods.obj-code = obj-list.obj-code
     1990         .
     1991     end.
     1992   end.
     1993   end procedure.
     1994   procedure fill-tt-rep-line :
     1995   define buffer buf_goods       for ub.goods.
     1996   define buffer buf_tt-rep-line for tt-rep-line.
     1997   define buffer cur_tt-rep-line for tt-rep-line.
     1998   define variable v-is-petrol as logical   no-undo .
     1999   define variable v-is-pieces as logical   no-undo .
     2000   do
     2001   on error undo, return error return-value
     2002   :
     2003   for each obj-list no-lock :
     2004     find first buf_shift-obj_from no-lock
     2005       where buf_shift-obj_from.obj-type    = obj-list.obj-type
     2006         and buf_shift-obj_from.obj-code    = obj-list.obj-code
     2007         and buf_shift-obj_from.shift-date  = x-Date-Start
     2008         and buf_shift-obj_from.shift-num   = x-Shift-Start
     2009     no-error .
     2010     if not available buf_shift-obj_from then do:
     2011         message "Не найдена смена начала отчета." skip
     2012                 "Дата:" string( x-Date-Start, "99/99/9999":U ) skip
     2013                 "Порядок:" x-Shift-Start
     2014         view-as alert-box error .
     2015         return error .
     2016     end.
     2017     find first buf_shift-obj_till no-lock
     2018       where buf_shift-obj_till.obj-type    = obj-list.obj-type
     2019         and buf_shift-obj_till.obj-code    = obj-list.obj-code
     2020         and buf_shift-obj_till.shift-date  = x-Date-End
     2021         and buf_shift-obj_till.shift-num   = x-Shift-End
     2022     no-error .
     2023     if not available buf_shift-obj_till then do:
     2024         message "Не найдена смена окончания отчета." skip
     2025                 "Дата:" string( x-Date-End, "99/99/9999":U ) skip
     2026                 "Порядок:" x-Shift-End
     2027         view-as alert-box error .
     2028         return error .
     2029     end.
     2030     for each buf_rvs-doc no-lock
     2031         where buf_rvs-doc.obj-type    = obj-list.obj-type
     2032           and buf_rvs-doc.obj-code    = obj-list.obj-code
     2033           and buf_rvs-doc.shift-date >= x-Date-Start
     2034           and buf_rvs-doc.shift-date <= x-Date-End
     2035           and buf_rvs-doc.status_     = 'факт':U ,
     2036         each buf_rvs-line-pump no-lock
     2037         where buf_rvs-line-pump.rvs-code = buf_rvs-doc.rvs-code
     2038     :
     2039       if buf_rvs-doc.shift-date = x-Date-Start and buf_rvs-doc.shift-num  < x-Shift-Start then next .
     2040       if buf_rvs-doc.shift-date = x-Date-End   and buf_rvs-doc.shift-num  > x-Shift-End   then next .
     2041       find first buf_goods no-lock
     2042         where buf_goods.gds-code = buf_rvs-line-pump.gds-code
     2043       no-error .
     2044       if not available buf_goods then do:
     2045         message
     2046           "Не найден товар с кодом " buf_rvs-line-pump.gds-code
     2047         view-as alert-box error.
     2048         return error return-value.
     2049       end.
     2050   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     2051     (
     2052        input buf_goods.artic
     2053     ,  input buf_goods.prod-type
     2054     ,  input buf_goods.prod-code
     2055     , output v-is-petrol
     2056     , output v-is-pieces
     2057     ) no-error.
     2058       if error-status :error or
     2059           v-is-petrol <> yes   or
     2060           v-is-pieces <> no
     2061       then do:
     2062         next .
     2063       end.
     2064       find first buf_shift-obj no-lock
     2065         where buf_shift-obj.obj-type     = obj-list.obj-type
     2066           and buf_shift-obj.obj-code     = obj-list.obj-code
     2067           and buf_shift-obj.shift-date   = buf_rvs-doc.shift-date
     2068           and buf_shift-obj.shift-num    = buf_rvs-doc.shift-num
     2069       no-error .
     2070       if not available buf_shift-obj then do :
     2071         message
     2072           "Не найдена смена для документа " buf_rvs-line-pump.rvs-code
     2073         view-as alert-box error.
     2074         return error return-value.
     2075       end.
     2076       find first tt-rep-line no-lock
     2077         where tt-rep-line.obj-type    = obj-list.obj-type
     2078           and tt-rep-line.obj-code    = obj-list.obj-code
     2079           and tt-rep-line.rvs-code    = buf_rvs-line-pump.rvs-code
     2080           and tt-rep-line.gds-code    = buf_rvs-line-pump.gds-code
     2081           and tt-rep-line.pump-code   = buf_rvs-line-pump.pump-code
     2082       no-error .
     2083       if not available tt-rep-line then do:
     2084         create tt-rep-line.
     2085         assign
     2086           tt-rep-line.obj-type      = obj-list.obj-type
     2087           tt-rep-line.obj-code      = obj-list.obj-code
     2088           tt-rep-line.rvs-code      = buf_rvs-line-pump.rvs-code
     2089           tt-rep-line.gds-code      = buf_rvs-line-pump.gds-code
     2090           tt-rep-line.pump-code     = buf_rvs-line-pump.pump-code
     2091           tt-rep-line.shift-date    = buf_shift-obj.shift-date
     2092           tt-rep-line.shift-num     = buf_shift-obj.shift-num
     2093           tt-rep-line.meas-el-cnt   = if buf_rvs-line-pump.meas-el-cnt = ? then 0 else buf_rvs-line-pump.meas-el-cnt
     2094           tt-rep-line.meas-mh-qnty  = if buf_rvs-line-pump.meas-mh-qnty = ? then 0 else buf_rvs-line-pump.meas-mh-qnty
     2095         .
     2096         find first tt-rep-head no-lock
     2097           where tt-rep-head.obj-type  = obj-list.obj-type
     2098             and tt-rep-head.obj-code  = obj-list.obj-code
     2099             and tt-rep-head.gds-code  = buf_goods.gds-code
     2100             and tt-rep-head.pump-code = buf_rvs-line-pump.pump-code
     2101         no-error.
     2102         if not available tt-rep-head then do :
     2103           create tt-rep-head.
     2104           assign
     2105             tt-rep-head.obj-type  = obj-list.obj-type
     2106             tt-rep-head.obj-code  = obj-list.obj-code
     2107             tt-rep-head.gds-code  = buf_goods.gds-code
     2108             tt-rep-head.pump-code = buf_rvs-line-pump.pump-code
     2109             tt-rep-head.ptrl-name = replace( buf_goods.gds-name , chr(44) , " " )
     2110           .
     2111         end.
     2112       end.
     2113       else do :
     2114         assign
     2115           tt-rep-line.meas-el-cnt   = tt-rep-line.meas-el-cnt +
     2116                                       if buf_rvs-line-pump.meas-el-cnt = ? then 0 else buf_rvs-line-pump.meas-el-cnt
     2117           tt-rep-line.meas-mh-qnty  = tt-rep-line.meas-mh-qnty +
     2118                                       if buf_rvs-line-pump.meas-mh-qnty = ? then 0 else buf_rvs-line-pump.meas-mh-qnty
     2119         .
     2120       end.
     2121     end.
     2122     for each buf_rvs-doc no-lock
     2123         where buf_rvs-doc.obj-type    = obj-list.obj-type
     2124           and buf_rvs-doc.obj-code    = obj-list.obj-code
     2125           and buf_rvs-doc.shift-date >= x-Date-Start
     2126           and buf_rvs-doc.shift-date <= x-Date-End
     2127           and buf_rvs-doc.status_     = 'факт':U ,
     2128         first buf_rvs-line-pump no-lock
     2129         where buf_rvs-line-pump.rvs-code = buf_rvs-doc.rvs-code
     2130     :
     2131       if buf_rvs-doc.shift-date = x-Date-Start and buf_rvs-doc.shift-num  < x-Shift-Start then next .
     2132       if buf_rvs-doc.shift-date = x-Date-End   and buf_rvs-doc.shift-num  > x-Shift-End   then next .
     2133       for each tt-rep-head no-lock
     2134         where tt-rep-head.obj-type = obj-list.obj-type
     2135           and tt-rep-head.obj-code = obj-list.obj-code
     2136       :
     2137         find first tt-rep-line no-lock
     2138           where tt-rep-line.obj-type      = obj-list.obj-type
     2139             and tt-rep-line.obj-code      = obj-list.obj-code
     2140             and tt-rep-line.rvs-code      = buf_rvs-doc.rvs-code
     2141             and tt-rep-line.gds-code      = tt-rep-head.gds-code
     2142             and tt-rep-line.pump-code     = tt-rep-head.pump-code
     2143         no-error .
     2144         if not available tt-rep-line then do:
     2145           find first cur_tt-rep-line no-lock
     2146             where cur_tt-rep-line.obj-type      = obj-list.obj-type
     2147               and cur_tt-rep-line.obj-code      = obj-list.obj-code
     2148               and cur_tt-rep-line.rvs-code      = buf_rvs-doc.rvs-code
     2149           no-error .
     2150           if not available cur_tt-rep-line then do:
     2151             message
     2152               "Ошибка при формировании отчета. Не найден документ " buf_rvs-doc.rvs-code
     2153             view-as alert-box error.
     2154             run clear-all in this-procedure .
     2155             return error.
     2156           end.
     2157           create buf_tt-rep-line.
     2158           assign
     2159             buf_tt-rep-line.obj-type      = obj-list.obj-type
     2160             buf_tt-rep-line.obj-code      = obj-list.obj-code
     2161             buf_tt-rep-line.rvs-code      = buf_rvs-doc.rvs-code
     2162             buf_tt-rep-line.gds-code      = tt-rep-head.gds-code
     2163             buf_tt-rep-line.pump-code     = tt-rep-head.pump-code
     2164             buf_tt-rep-line.shift-date    = cur_tt-rep-line.shift-date
     2165             buf_tt-rep-line.shift-num     = cur_tt-rep-line.shift-num
     2166             buf_tt-rep-line.meas-el-cnt   = 0
     2167             buf_tt-rep-line.meas-mh-qnty  = 0
     2168           .
     2169         end.
     2170       end.
     2171     end.
     2172   end.
     2173   end.
     2174   end procedure.
     2175   procedure clear-all :
     2176   do
     2177   on error undo, return error return-value
     2178   :
     2179     empty temp-table tt-rep-head.
     2180     empty temp-table tt-rep-line.
     2181     empty temp-table tt-ptrl-goods.
     2182     output stream out-stream close.
     2183     if Make-Excel then output stream ForExcel close.
     2184     run waitfram-hide in this-procedure .
     2185   end.
     2186   end procedure.
     2187   function str-format returns character (val as decimal):
     2188     return trim( replace( string( val , ">>>>>>>>9.99" ) , "." , "," ) ) .
     2189   end function.
