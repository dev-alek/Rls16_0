     1507   end.
     1508   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1509   run create_obj-list in this-procedure
     1510    ( input v-cntxt-obj-type ,
     1511      input v-cntxt-obj-code )
     1512      .
     1513   assign rest-date = date( v-date ).
     1514   define variable tmp#var  like ub.stk-tot.fact-qnty   no-undo.
     1515   Run ostatok  (
     1516       input  v-cntxt-obj-code ,
     1517       input  v-cntxt-obj-type ,
     1518       input  false   ,
     1519       input  rest-date ,
     1520       input  ""        ,
     1521       input  ?          ,
     1522       input  ?           ,
     1523       input  'crsa':U ,
     1524       input  '##,##':U ,
     1525       input  false     ,
     1526       output  tmp#var  ,
     1527       output  tmp#var  ,
     1528       output  tmp#var  ,
     1529       output  tmp#var  ,
     1530       output  tmp#var  ,
     1531       output  Fact-order1 ).
     1532   message
     1533   "Печатать по всем поставщикам?"
     1534   view-as alert-box QUESTION BUTTONS YES-NO TITLE "" UPDATE CliAll.
     1535   if NOT CliAll then do:
     1536     run ref/cli-all.w ( input parparentproc
     1537                   ,input "b-sel"
     1538                   ,input 'все':U
     1539                   ,input 'все':U
     1540                   ,input 'текущие':U
     1541                   ,input ?
     1542                   ,input "yes,yes,yes,,,,ИЛИ"
     1543                   ,input ?
     1544                   ,output ri-list ) .
     1545     if ri-list = "" then assign CliAll = no.
     1546     else do:
     1547         find b-clients where recid ( b-clients ) = integer( ri-list ) no-lock .
     1548     end.
     1549   end.
     1550   run waitfram-show in this-procedure ( "Подождите..." ).
     1551   FOR EACH ub.trn-doc WHERE
     1552           ub.trn-doc.host-code = v-cntxt-host-code-obj
     1553       AND ub.trn-doc.status_ = 'факт':U
     1554       AND ub.trn-doc.fact-date >= v-from-date
     1555       AND ub.trn-doc.fact-date <= v-to-date
     1556       AND ub.trn-doc.doc-type = 'при':U
     1557       AND
     1558           ( ub.trn-doc.internal = no
     1559             OR ( ub.trn-doc.internal = yes AND ub.trn-doc.discnt-type = 'прво':U )
     1560           )
     1561       OR
     1562           ub.trn-doc.host-code = v-cntxt-host-code-obj
     1563       AND ub.trn-doc.status_ = 'факт':U
     1564       AND ub.trn-doc.fact-date >= v-from-date
     1565       AND ub.trn-doc.fact-date <= v-to-date
     1566       AND ub.trn-doc.doc-type = 'инв':U
     1567       NO-LOCK:
     1568     if NOT CliAll AND NOT( ub.trn-doc.cli-type = b-clients.obj-type AND ub.trn-doc.cli-code = b-clients.obj-code ) then
     1569           NEXT.
     1570     FOR EACH ub.doc-line WHERE
     1571             ub.doc-line.doc-code = ub.trn-doc.doc-code NO-LOCK:
     1572       if ub.trn-doc.doc-type = 'инв':U and ub.doc-line.fact-qnty <= 0 then next.
     1573       FIND ub.goods WHERE ub.goods.artic = ub.doc-line.artic
     1574                                         AND ub.goods.prod-type = ub.doc-line.prod-type
     1575                                         AND ub.goods.prod-code = ub.doc-line.prod-code NO-LOCK.
     1576       FIND ub.gds-prt WHERE ub.gds-prt.upper-code = ub.goods.prt-root NO-LOCK.
     1577       assign
     1578       sale-price-rubl = 0
     1579       sale-price-base = 0
     1580       .
     1581       FIND LAST ub.price-list WHERE ub.price-list.obj-type = ub.trn-doc.obj-type
     1582                                                       AND ub.price-list.obj-code = ub.trn-doc.obj-code
     1583                                                       AND ub.price-list.artic = ub.goods.artic
     1584                                                       AND ub.price-list.prod-type =  ub.goods.prod-type
     1585                                                       AND ub.price-list.prod-code = ub.goods.prod-code
     1586                                                       AND ub.price-list.b-code = ub.goods.gds-code
     1587                                                       AND ub.price-list.fact-order <= fact-order1
     1588                                                       USE-INDEX fact-close
     1589                                                       NO-LOCK NO-ERROR.
     1590       if available ub.price-list then do:
     1591         if v-curr-r-b = 'rubl':U then do:
     1592             assign sale-price-rubl = ub.price-list.price-sale.
     1593         end.
     1594         else do:
     1595             assign sale-price-base = ub.price-list.price-sale.
     1596         end.
     1597       end.
     1598       FOR EACH ub.gds-dtl WHERE
     1599               ub.gds-dtl.doc-code = ub.trn-doc.doc-code
     1600           AND ub.gds-dtl.artic = ub.doc-line.artic
     1601           AND ub.gds-dtl.prod-type = ub.doc-line.prod-type
     1602           AND ub.gds-dtl.prod-code = ub.doc-line.prod-code
     1603           NO-LOCK:
     1604         ACCUMULATE
     1605         ub.gds-dtl.cur-base * ub.gds-dtl.fact-qnty (TOTAL)
     1606         ub.gds-dtl.fact-qnty (TOTAL)
     1607         .
     1608       END.
     1609       if v-curr-r-b = 'rubl':U then do:
     1610         assign
     1611         avrg-price-rubl = ( ACCUM TOTAL ub.gds-dtl.cur-base * ub.gds-dtl.fact-qnty ) / ( ACCUM TOTAL ub.gds-dtl.fact-qnty )
     1612         avrg-price-base = avrg-price-rubl / ( ub.trn-doc.base-rate * ub.trn-doc.base-scale )
     1613         .
     1614       end.
     1615       else do:
     1616         assign
     1617         avrg-price-base = ( ACCUM TOTAL ub.gds-dtl.cur-base * ub.gds-dtl.fact-qnty ) / ( ACCUM TOTAL ub.gds-dtl.fact-qnty )
     1618         avrg-price-rubl = avrg-price-base * ( ub.trn-doc.base-rate * ub.trn-doc.base-scale )
     1619         .
     1620       end.
     1621       FOR EACH ub.parts WHERE
     1622               ub.parts.obj-type = ub.trn-doc.obj-type
     1623             AND ub.parts.obj-code = ub.trn-doc.obj-code
     1624             AND ub.parts.artic = ub.doc-line.artic
     1625             AND ub.parts.prod-type = ub.doc-line.prod-type
     1626             AND ub.parts.prod-code = ub.doc-line.prod-code
     1627             AND ub.parts.in-code = ub.trn-doc.doc-code
     1628             AND ub.parts.out-code = ub.trn-doc.doc-code
     1629             NO-LOCK:
     1630         if ub.trn-doc.discnt-type = 'прво':U then
     1631         assign s-pay = 'производство':U.
     1632         else do:
     1633           if ub.parts.pay-code = integer('2':U) then
     1634               assign s-pay = "консигнация".
     1635           else
     1636               assign s-pay = "выкуп".
     1637         end.
     1638   assign
     1639     price-rubl-with-tax-loc = parts.price-rubl
     1640     price-base-with-tax-loc = parts.price-base
     1641   .
     1642   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1643   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1644     (output varinvprb
