     1730           suppl-gds.in-NDS0-rubl = suppl-gds.in-NDS0-rubl + ub.parts.fact-qnty * vat-rubl-loc
     1731           suppl-gds.in-NDS0-base = suppl-gds.in-NDS0-base + ub.parts.fact-qnty * vat-base-loc
     1732           suppl-gds.in-sum0-rubl = suppl-gds.in-sum0-rubl + ub.parts.fact-qnty * price-rubl-with-tax-loc
     1733           suppl-gds.in-sum0-base = suppl-gds.in-sum0-base + ub.parts.fact-qnty * price-base-with-tax-loc
     1734           suppl-gds.free-qnty = suppl-gds.free-qnty + ub.parts.fact-qnty
     1735           suppl-gds.free-NDS0-rubl = suppl-gds.free-NDS0-rubl + ub.parts.fact-qnty * vat-rubl-loc
     1736           suppl-gds.free-NDS0-base = suppl-gds.free-NDS0-base + ub.parts.fact-qnty * vat-base-loc
     1737           suppl-gds.free-sum0-rubl = suppl-gds.free-sum0-rubl + ub.parts.fact-qnty * price-rubl-with-tax-loc
     1738           suppl-gds.free-sum0-base = suppl-gds.free-sum0-base + ub.parts.fact-qnty * price-base-with-tax-loc
     1739           suppl-gds.in-sum-rubl = suppl-gds.in-sum-rubl + ub.parts.fact-qnty * avrg-price-rubl
     1740           suppl-gds.in-sum-base = suppl-gds.in-sum-base + ub.parts.fact-qnty * avrg-price-base
     1741           .
