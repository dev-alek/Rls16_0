     1720           suppl-gds.in-sum-rubl = ub.parts.fact-qnty * avrg-price-rubl
     1721           suppl-gds.in-sum-base = ub.parts.fact-qnty * avrg-price-base
     1722           suppl-gds.out-sum-rubl = 0
     1723           suppl-gds.out-sum-base = 0
     1724           suppl-gds.price-sale = (if v-curr-r-b = 'base':U then sale-price-base else sale-price-rubl)
     1725           .
     1726         end.
     1727         else do:
     1728           assign
