     1746             AND buf-parts.prod-code = ub.parts.prod-code
     1747             AND buf-parts.in-code = ub.parts.in-code
     1748             AND buf-parts.out-code <> ub.parts.out-code
     1749             AND buf-parts.part-code = ub.parts.part-code
     1750             AND buf-parts.rsrv-free = ?
     1751             AND buf-parts.doc-type <> 'акт':U
     1752             AND buf-parts.status_ = yes
     1753             NO-LOCK:
