     1796             vat-pc-loc         = (if buf-parts.vat-pc         = ? then 0 else buf-parts.vat-pc)
     1797             slt-pc-loc         = (if buf-parts.slt-pc         = ? then 0 else buf-parts.slt-pc).
     1798             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1799       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1800     assign
     1801       exch-rate-cli-loc = (buf-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf-parts.price-cli .
     1802     assign
     1803       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1804       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1805       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1806       transport-cli-loc  = 0
     1807       other-cli-loc      = 0
     1808     .
     1809   ASSIGN
     1810             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1811       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1812   .
     1813               CASE b-trn-doc.doc-type:
     1814                 WHEN 'рас':U
     1815                 OR WHEN 'спи':U
     1816                 THEN do:
     1817                     assign
     1818                     suppl-gds.out-qnty = suppl-gds.out-qnty + buf-parts.fact-qnty
     1819                     suppl-gds.out-NDS0-rubl = suppl-gds.out-NDS0-rubl + buf-parts.fact-qnty * vat-rubl-loc
     1820                     suppl-gds.out-NDS0-base = suppl-gds.out-NDS0-base + buf-parts.fact-qnty * vat-base-loc
     1821                     suppl-gds.out-sum0-rubl = suppl-gds.out-sum0-rubl + buf-parts.fact-qnty * price-rubl-with-tax-loc
     1822                     suppl-gds.out-sum0-base = suppl-gds.out-sum0-base + buf-parts.fact-qnty * price-base-with-tax-loc
     1823                     suppl-gds.free-qnty = suppl-gds.free-qnty - buf-parts.fact-qnty
     1824                     suppl-gds.free-NDS0-rubl = suppl-gds.free-NDS0-rubl - buf-parts.fact-qnty * vat-rubl-loc
     1825                     suppl-gds.free-NDS0-base = suppl-gds.free-NDS0-base - buf-parts.fact-qnty * vat-base-loc
     1826                     suppl-gds.free-sum0-rubl = suppl-gds.free-sum0-rubl - buf-parts.fact-qnty * price-rubl-with-tax-loc
     1827                     suppl-gds.free-sum0-base = suppl-gds.free-sum0-base - buf-parts.fact-qnty * price-base-with-tax-loc
     1828                     .
     1829                 end.
     1830                 WHEN 'при':U
     1831                 OR
     1832                 WHEN 'возврат':U
     1833                 OR
     1834                 WHEN 'инв':U
     1835                 THEN do:
     1836                   assign
     1837                   suppl-gds.out-qnty = suppl-gds.out-qnty - buf-parts.fact-qnty
     1838                   suppl-gds.out-NDS0-rubl = suppl-gds.out-NDS0-rubl - buf-parts.fact-qnty * vat-rubl-loc
     1839                   suppl-gds.out-NDS0-base = suppl-gds.out-NDS0-base - buf-parts.fact-qnty * vat-base-loc
     1840                   suppl-gds.out-sum0-rubl = suppl-gds.out-sum0-rubl - buf-parts.fact-qnty * price-rubl-with-tax-loc
     1841                   suppl-gds.out-sum0-base = suppl-gds.out-sum0-base - buf-parts.fact-qnty * price-base-with-tax-loc
     1842                   suppl-gds.free-qnty = suppl-gds.free-qnty + buf-parts.fact-qnty
     1843                   suppl-gds.free-NDS0-rubl = suppl-gds.free-NDS0-rubl + buf-parts.fact-qnty * vat-rubl-loc
     1844                   suppl-gds.free-NDS0-base = suppl-gds.free-NDS0-base + buf-parts.fact-qnty * vat-base-loc
     1845                   suppl-gds.free-sum0-rubl = suppl-gds.free-sum0-rubl + buf-parts.fact-qnty * price-rubl-with-tax-loc
     1846                   suppl-gds.free-sum0-base = suppl-gds.free-sum0-base + buf-parts.fact-qnty * price-base-with-tax-loc
     1847                   .
     1848                 end.
     1849               END CASE.
     1850             end.
     1851           END.
     1852         END.
     1853       END.
     1854       assign counter = counter + 1.
     1855       run waitfram-show in this-procedure ( string( "Просмотрено документов: " + string( counter ) ) ).
     1856     END.
     1857   if session:set-wait-state("COMPILER") then.
     1858   assign Line = fill("-", 232).
     1859   run prn-lib-open-stream  in this-procedure (
     1860                                                input parParentProc
     1861                                               ,input 43
     1862                                               ,input yes
     1863                                               ,input no
     1864                                               ).
     1865   FORM with FRAME supp-gds.
     1866   FORM HEADER
     1867   Line format "X(198)" AT 1 SKIP
     1868   "Продолжение - на следующей странице" AT 60 SKIP
     1869   with FRAME BottomFrame width 232
     1870   PAGE-BOTTOM no-labels no-box.
     1871   VIEW STREAM PrnLibStream FRAME BottomFrame .
     1872   PUT STREAM PrnLibStream
     1873   string( "О Т Ч Е Т   П О   О С Т А Т К А М  на: " + string(rest-date,"99/99/9999") ) AT 62 format "X(198)"
     1874   SKIP
     1875   string( "Период поставок с: " + string(v-from-date,"99/99/9999") + " по: " + string(v-to-date,"99/99/9999") )
     1876               AT 62 format "X(198)"
     1877   SKIP(1)
     1878   .
     1879   PUT STREAM PrnLibStream " " SKIP.
     1880   FOR EACH suppl-gds NO-LOCK,
     1881           EACH ub.goods WHERE
     1882               ub.goods.artic = suppl-gds.artic
     1883           AND ub.goods.prod-type = suppl-gds.prod-type
     1884           AND ub.goods.prod-code = suppl-gds.prod-code
     1885           NO-LOCK
     1886   BREAK
     1887   BY ub.goods.grp-name
     1888   BY suppl-gds.s-pay-type:
     1889     if FIRST-OF (ub.goods.grp-name) then do:
     1890       DOWN STREAM PrnLibStream 1 with FRAME supp-gds .
     1891       PUT STREAM PrnLibStream SPACE(20) string("Группа: " + ub.goods.grp-name) format "X(100)".
     1892     end.
     1893     ACCUMULATE
     1894     suppl-gds.in-qnty (TOTAL)
     1895     suppl-gds.in-NDS0-rubl (TOTAL)
     1896     suppl-gds.in-NDS0-base (TOTAL)
     1897     suppl-gds.in-sum0-rubl (TOTAL)
     1898     suppl-gds.in-sum0-base (TOTAL)
     1899     suppl-gds.in-sum-rubl (TOTAL)
     1900     suppl-gds.in-sum-base (TOTAL)
     1901     suppl-gds.out-qnty (TOTAL)
     1902     suppl-gds.out-NDS0-rubl (TOTAL)
     1903     suppl-gds.out-NDS0-base (TOTAL)
     1904     suppl-gds.out-sum0-rubl (TOTAL)
     1905     suppl-gds.out-sum0-base (TOTAL)
     1906     suppl-gds.free-qnty (TOTAL)
     1907     suppl-gds.free-NDS0-rubl (TOTAL)
     1908     suppl-gds.free-NDS0-base (TOTAL)
     1909     suppl-gds.free-sum0-rubl (TOTAL)
     1910     suppl-gds.free-sum0-base (TOTAL)
     1911     (suppl-gds.free-qnty * suppl-gds.price-sale) (TOTAL)
     1912     suppl-gds.in-qnty (SUB-TOTAL BY ub.goods.grp-name )
     1913     suppl-gds.in-NDS0-rubl (SUB-TOTAL BY ub.goods.grp-name )
     1914     suppl-gds.in-NDS0-base (SUB-TOTAL BY ub.goods.grp-name )
     1915     suppl-gds.in-sum0-rubl (SUB-TOTAL BY ub.goods.grp-name )
     1916     suppl-gds.in-sum0-base (SUB-TOTAL BY ub.goods.grp-name )
     1917     suppl-gds.in-sum-rubl (SUB-TOTAL BY ub.goods.grp-name )
     1918     suppl-gds.in-sum-base (SUB-TOTAL BY ub.goods.grp-name )
     1919     suppl-gds.out-qnty (SUB-TOTAL BY ub.goods.grp-name )
     1920     suppl-gds.out-NDS0-rubl (SUB-TOTAL BY ub.goods.grp-name )
     1921     suppl-gds.out-NDS0-base (SUB-TOTAL BY ub.goods.grp-name )
     1922     suppl-gds.out-sum0-rubl (SUB-TOTAL BY ub.goods.grp-name )
     1923     suppl-gds.out-sum0-base (SUB-TOTAL BY ub.goods.grp-name )
     1924     suppl-gds.free-qnty (SUB-TOTAL BY ub.goods.grp-name )
     1925     suppl-gds.free-NDS0-rubl (SUB-TOTAL BY ub.goods.grp-name )
     1926     suppl-gds.free-NDS0-base (SUB-TOTAL BY ub.goods.grp-name )
     1927     suppl-gds.free-sum0-rubl (SUB-TOTAL BY ub.goods.grp-name )
     1928     suppl-gds.free-sum0-base (SUB-TOTAL BY ub.goods.grp-name )
     1929     (suppl-gds.free-qnty * suppl-gds.price-sale) (SUB-TOTAL BY ub.goods.grp-name )
     1930     suppl-gds.in-qnty (SUB-TOTAL BY suppl-gds.s-pay-type )
     1931     suppl-gds.in-NDS0-rubl (SUB-TOTAL BY suppl-gds.s-pay-type )
     1932     suppl-gds.in-NDS0-base (SUB-TOTAL BY suppl-gds.s-pay-type )
     1933     suppl-gds.in-sum0-rubl (SUB-TOTAL BY suppl-gds.s-pay-type )
     1934     suppl-gds.in-sum0-base (SUB-TOTAL BY suppl-gds.s-pay-type )
     1935     suppl-gds.in-sum-rubl (SUB-TOTAL BY suppl-gds.s-pay-type )
     1936     suppl-gds.in-sum-base (SUB-TOTAL BY suppl-gds.s-pay-type )
     1937     suppl-gds.out-qnty (SUB-TOTAL BY suppl-gds.s-pay-type )
     1938     suppl-gds.out-NDS0-rubl (SUB-TOTAL BY suppl-gds.s-pay-type )
     1939     suppl-gds.out-NDS0-base (SUB-TOTAL BY suppl-gds.s-pay-type )
     1940     suppl-gds.out-sum0-rubl (SUB-TOTAL BY suppl-gds.s-pay-type )
     1941     suppl-gds.out-sum0-base (SUB-TOTAL BY suppl-gds.s-pay-type )
     1942     suppl-gds.free-qnty (SUB-TOTAL BY suppl-gds.s-pay-type )
     1943     suppl-gds.free-NDS0-rubl (SUB-TOTAL BY suppl-gds.s-pay-type )
     1944     suppl-gds.free-NDS0-base (SUB-TOTAL BY suppl-gds.s-pay-type )
     1945     suppl-gds.free-sum0-rubl (SUB-TOTAL BY suppl-gds.s-pay-type )
     1946     suppl-gds.free-sum0-base (SUB-TOTAL BY suppl-gds.s-pay-type )
     1947     (suppl-gds.free-qnty * suppl-gds.price-sale) (SUB-TOTAL BY suppl-gds.s-pay-type )
     1948     .
     1949     if LAST-OF (suppl-gds.s-pay-type) then do:
     1950       if PrintRubl then do:
     1951         assign
     1952         in-sum0 = (ACCUM SUB-TOTAL BY suppl-gds.s-pay-type suppl-gds.in-sum0-rubl)
     1953         in-sum = (ACCUM SUB-TOTAL BY suppl-gds.s-pay-type suppl-gds.in-sum-rubl)
     1954         out-sum0 = (ACCUM SUB-TOTAL BY suppl-gds.s-pay-type suppl-gds.out-sum0-rubl)
     1955         free-NDS0 = (ACCUM SUB-TOTAL BY suppl-gds.s-pay-type suppl-gds.free-NDS0-rubl)
     1956         free-sum0 = (ACCUM SUB-TOTAL BY suppl-gds.s-pay-type suppl-gds.free-sum0-rubl)
     1957         free-sum = if v-curr-r-b = 'rubl':U
     1958                     then  (ACCUM SUB-TOTAL BY suppl-gds.s-pay-type (suppl-gds.free-qnty * suppl-gds.price-sale) )
     1959                     else 0
     1960         free-noNDS0 = free-sum0 - free-NDS0
     1961         .
     1962       end.
     1963       else do:
     1964         assign
     1965         in-sum0 = (ACCUM SUB-TOTAL BY suppl-gds.s-pay-type suppl-gds.in-sum0-base)
     1966         in-sum = (ACCUM SUB-TOTAL BY suppl-gds.s-pay-type suppl-gds.in-sum-base)
     1967         out-sum0 = (ACCUM SUB-TOTAL BY suppl-gds.s-pay-type suppl-gds.out-sum0-base)
     1968         free-NDS0 = (ACCUM SUB-TOTAL BY suppl-gds.s-pay-type suppl-gds.free-NDS0-base)
     1969         free-sum0 = (ACCUM SUB-TOTAL BY suppl-gds.s-pay-type suppl-gds.free-sum0-base)
     1970         free-sum = if v-curr-r-b = 'base':U
     1971                     then (ACCUM SUB-TOTAL BY suppl-gds.s-pay-type (suppl-gds.free-qnty * suppl-gds.price-sale) )
     1972                     else 0
     1973         free-noNDS0 = free-sum0 - free-NDS0
     1974         .
     1975       end.
     1976       DISPLAY STREAM PrnLibStream
     1977       sym1
     1978       suppl-gds.s-pay-type @ s-pay
     1979       sym2
     1980       (ACCUM SUB-TOTAL BY suppl-gds.s-pay-type suppl-gds.in-qnty) @ suppl-gds.in-qnty
     1981       sym3
     1982       in-sum0
     1983       sym4
     1984       in-sum
     1985       sym5
     1986       (ACCUM SUB-TOTAL BY suppl-gds.s-pay-type suppl-gds.free-qnty) @ suppl-gds.free-qnty
     1987       sym6
     1988       free-noNDS0
     1989       sym7
     1990       free-NDS0
     1991       sym8
     1992       free-sum0
     1993       sym9
     1994       free-sum
     1995       sym10
     1996       with FRAME supp-gds .
     1997       DOWN STREAM PrnLibStream 1 with FRAME supp-gds .
     1998     end.
     1999     if LAST-OF (ub.goods.grp-name) then do:
     2000       if PrintRubl then do:
     2001         assign
     2002         in-sum0 = (ACCUM SUB-TOTAL BY ub.goods.grp-name suppl-gds.in-sum0-rubl)
     2003         in-sum = (ACCUM SUB-TOTAL BY ub.goods.grp-name suppl-gds.in-sum-rubl)
     2004         out-sum0 = (ACCUM SUB-TOTAL BY ub.goods.grp-name suppl-gds.out-sum0-rubl)
     2005         free-NDS0 = (ACCUM SUB-TOTAL BY ub.goods.grp-name suppl-gds.free-NDS0-rubl)
     2006         free-sum0 = (ACCUM SUB-TOTAL BY ub.goods.grp-name suppl-gds.free-sum0-rubl)
     2007         free-sum = if v-curr-r-b = 'rubl':U
     2008                     then (ACCUM SUB-TOTAL BY ub.goods.grp-name (suppl-gds.free-qnty * suppl-gds.price-sale) )
     2009                     else 0
     2010         free-noNDS0 = free-sum0 - free-NDS0
     2011         .
     2012       end.
     2013       else do:
     2014         assign
     2015         in-sum0 = (ACCUM SUB-TOTAL BY ub.goods.grp-name suppl-gds.in-sum0-base)
     2016         in-sum = (ACCUM SUB-TOTAL BY ub.goods.grp-name suppl-gds.in-sum-base)
     2017         out-sum0 = (ACCUM SUB-TOTAL BY ub.goods.grp-name suppl-gds.out-sum0-base)
     2018         free-NDS0 = (ACCUM SUB-TOTAL BY ub.goods.grp-name suppl-gds.free-NDS0-base)
     2019         free-sum0 = (ACCUM SUB-TOTAL BY ub.goods.grp-name suppl-gds.free-sum0-base)
     2020         free-sum = (if v-curr-r-b = 'base':U
     2021                     then (ACCUM SUB-TOTAL BY ub.goods.grp-name (suppl-gds.free-qnty * suppl-gds.price-sale) )
     2022                     else 0)
     2023         free-noNDS0 = free-sum0 - free-NDS0
     2024         .
     2025       end.
     2026       DISPLAY STREAM PrnLibStream
     2027       "Итого" @ s-pay
     2028       (ACCUM SUB-TOTAL BY ub.goods.grp-name suppl-gds.in-qnty) @ suppl-gds.in-qnty
     2029       in-sum0
     2030       in-sum
     2031       (ACCUM SUB-TOTAL BY ub.goods.grp-name suppl-gds.free-qnty) @ suppl-gds.free-qnty
     2032       free-noNDS0
     2033       free-NDS0
     2034       free-sum0
     2035       free-sum
     2036       with FRAME supp-gds .
     2037       DOWN STREAM PrnLibStream 1 with FRAME supp-gds .
     2038     end.
     2039   END.
     2040   if PrintRubl then do:
     2041     assign
     2042     in-sum0 = (ACCUM TOTAL suppl-gds.in-sum0-rubl)
     2043     in-sum = (ACCUM TOTAL suppl-gds.in-sum-rubl)
     2044     out-sum0 = (ACCUM TOTAL suppl-gds.out-sum0-rubl)
     2045     free-NDS0 = (ACCUM TOTAL suppl-gds.free-NDS0-rubl)
     2046     free-sum0 = (ACCUM TOTAL suppl-gds.free-sum0-rubl)
     2047     free-sum = (if v-curr-r-b = 'rubl':U
     2048                 then (ACCUM TOTAL (suppl-gds.free-qnty * suppl-gds.price-sale) )
     2049                 else 0)
     2050     free-noNDS0 = free-sum0 - free-NDS0
     2051     .
     2052   end.
     2053   else do:
     2054     assign
     2055     in-sum0 = (ACCUM TOTAL suppl-gds.in-sum0-base)
     2056     in-sum = (ACCUM TOTAL suppl-gds.in-sum-base)
     2057     out-sum0 = (ACCUM TOTAL suppl-gds.out-sum0-base)
     2058     free-NDS0 = (ACCUM TOTAL suppl-gds.free-NDS0-base)
     2059     free-sum0 = (ACCUM TOTAL suppl-gds.free-sum0-base)
     2060     free-sum = (if v-curr-r-b = 'base':U
     2061                     then (ACCUM TOTAL (suppl-gds.free-qnty * suppl-gds.price-sale) )
     2062                     else 0)
     2063     free-noNDS0 = free-sum0 - free-NDS0
     2064     .
     2065   end.
     2066   DOWN STREAM PrnLibStream 1 with FRAME supp-gds .
     2067   DISPLAY STREAM PrnLibStream
     2068   "Итого по всем" @ s-pay
     2069   (ACCUM TOTAL suppl-gds.in-qnty) @ suppl-gds.in-qnty
     2070   in-sum0
     2071   in-sum
     2072   (ACCUM TOTAL suppl-gds.free-qnty) @ suppl-gds.free-qnty
     2073   free-noNDS0
     2074   free-NDS0
     2075   free-sum0
     2076   free-sum
     2077   with FRAME supp-gds .
     2078   DOWN STREAM PrnLibStream 1 with FRAME supp-gds .
     2079   OUTPUT STREAM PrnLibStream CLOSE.
     2080   run waitfram-hide in this-procedure .
     2081   run prn-lib-prn-file in this-procedure (
     2082                                             input parParentProc
     2083                                             ,input 8
     2084                                             ).
     2085   PROCEDURE ostatok :
     2086   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     2087   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     2088   def input parameter x-tog-shift   as   logical             no-undo.
     2089   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     2090   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     2091   def input parameter x-shift-start as integer               no-undo.
     2092   def input parameter x-shift-end   as integer               no-undo.
     2093   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     2094   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     2095   def input parameter xTog-obj   as log no-undo.
     2096   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     2097   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     2098   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     2099   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     2100   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     2101   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     2102   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     2103   def var              Fact-orderS   as char  no-undo.
     2104   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     2105      Assign
     2106         Fact-order   = 0
     2107         Quantity     = 0
     2108         Coast_R      = 0
     2109         Coast_V      = 0
     2110         VAT_R        = 0
     2111         VAT_V        = 0 .
     2112    x-date-start-t  = x-date-start + 1 .
     2113   IF x-date-end = date('') then DO:
     2114      Fact-order = 0 .
     2115      for each obj-list
     2116          where  ( not xtog-obj or
     2117                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     2118                 no-lock :
     2119         if  x-tog-shift = false then do:
     2120                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2121                               ub.stk-tot.Fact-date <=  x-date-start
     2122                               and ub.stk-tot.shift-num = 0
     2123                               USE-INDEX fact-date no-lock no-error .
     2124              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2125         End.
     2126         Else  DO :
     2127             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2128              (ub.stk-tot.shift-date  = x-date-start-t and
     2129               ub.stk-tot.shift-num  < x-shift-start or
     2130               ub.stk-tot.shift-date  < x-date-start-t  )
     2131               and ub.stk-tot.shift-num  > 0
     2132               USE-INDEX Shift-num no-lock no-error .
     2133            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2134           END.
     2135       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     2136     End.
     2137   End.
     2138   Else DO:
     2139     For each obj-list  WHERE
     2140        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     2141         no-lock :
     2142      IF  x-TOG-Shift = False Then DO:
     2143          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2144               ub.stk-tot.Fact-date <= x-date-end
     2145               and ub.stk-tot.shift-num = 0
     2146               USE-INDEX fact-date no-lock no-error.
     2147          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2148      END.
     2149      Else DO:
     2150           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2151               (ub.stk-tot.shift-date  = x-date-end and
     2152               ub.stk-tot.shift-num  <= x-shift-end or
     2153               ub.stk-tot.shift-date  < x-date-end       ) and
     2154               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     2155               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2156       End.
     2157       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     2158     End.
     2159   End.
     2160   END PROCEDURE.
