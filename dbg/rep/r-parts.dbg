      975     )  .
      976       if NOT v-exist then
      977       DO:
      978         Message
      979           "Нет заданий на печать ! "
      980           view-as alert-box .
      981         Return  .
      982       End.
      983       run gbl/prnfilen.w
      984         (input  ""
      985         ,input  p-DisabledOptions
      986         ,input  string(v-report-name )
      987         ,input  7
      988         ,output v-user-action
      989         ,output v-printed
      990         ) .
      991       if v-printed then
      992       do:
      993         return "YES" .
      994       end.
      995       else
      996       do:
      997         return "NO" .
      998       end.
      999     end.
     1000   end procedure.
     1001   procedure prn-lib-open-stream :
     1002     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1003     define input parameter p-page-size    as integer no-undo .
     1004     define input parameter p-is-stream    as logical no-undo .
     1005     define input parameter p-append       as logical no-undo .
     1006     define variable v-report-name as character no-undo .
     1007     do
     1008       on error undo, return error
     1009       :
     1010       run prn-lib-get-report-name  in this-procedure (
     1011         input parParentProc
     1012         ,output v-report-name
     1013         ).
     1014       if p-is-stream then
     1015       do:
     1016         if p-append then
     1017         do:
     1018           output stream PrnLibStream to value( v-report-name )
     1019             page-size value(p-page-size) append .
     1020         end.
     1021         if not p-append then
     1022         do:
     1023           output stream PrnLibStream to value( v-report-name )
     1024             page-size value(p-page-size) .
     1025         end.
     1026       end.
     1027       if not p-is-stream then
     1028       do:
     1029         if p-append then
     1030         do:
     1031           output to value( v-report-name )
     1032             page-size value(p-page-size) append .
     1033         end.
     1034         if not p-append then
     1035         do:
     1036           output to value( v-report-name )
     1037             page-size value(p-page-size) .
     1038         end.
     1039       end.
     1040     end.
     1041   end procedure.
     1042   procedure prn-lib-open-exp :
     1043     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1044     define input parameter p-is-stream    as logical no-undo .
     1045     define input parameter p-is-append    as logical no-undo .
     1046     define output parameter p-ReportFileName as char init "report" no-undo.
     1047     define output parameter p-process as logical no-undo .
     1048     define variable glog as logical no-undo .
     1049     do
     1050       on error undo, return error
     1051       :
     1052       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1053         TITLE      "Укажите путь"
     1054         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1055         ASK-OVERWRITE
     1056         CREATE-TEST-FILE
     1057         SAVE-AS
     1058         USE-FILENAME
     1059         DEFAULT-EXTENSION "txt"
     1060         UPDATE glog
     1061         .
     1062       if not glog then  return.
     1063       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1064       if p-is-stream then
     1065       do:
     1066         if p-is-append then
     1067         do:
     1068           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1069         end.
     1070         else
     1071         do:
     1072           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1073         end.
     1074       end.
     1075       else
     1076       do:
     1077         if p-is-append then
     1078         do:
     1079           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1080         end.
     1081         else
     1082         do:
     1083           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1084         end.
     1085       end.
     1086       p-process = yes.
     1087     end.
     1088   end procedure.
     1089   procedure prn-lib-get-report-name :
     1090     define input parameter parParentProc  as widget-handle no-undo.
     1091     define output parameter p-report-name as character no-undo .
     1092     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1093   end procedure.
     1094   procedure prn-lib-reportviewer-report-name :
     1095     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1096     define input parameter p-report-name-html as character no-undo .
     1097     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1098   end procedure.
     1099   procedure prn-lib-reportviewer :
     1100     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1101     define input parameter p-report-name-html as character no-undo .
     1102     define input parameter p-param        as character no-undo .
     1103     define variable v-excel           as character no-undo init 'TRUE' .
     1104     define variable v-value-character as character no-undo .
     1105     define variable v-value-integer   as character no-undo .
     1106     define variable v-value-date      as date      no-undo .
     1107     define variable v-value-decimal   as decimal   no-undo .
     1108     define variable rep-excel         as logical   no-undo .
     1109     define variable excel-string      as character no-undo .
     1110     define variable v-param-type      as character no-undo .
     1111     define variable v-tth             as handle    no-undo .
     1112     run adm/shattri.p (
     1113       input "get":U
     1114       ,input  ""
     1115       ,input  0
     1116       ,input  'report-glob':U
     1117       ,input  'rep-excel':U
     1118       ,output v-value-character
     1119       ,output v-value-date
     1120       ,output v-value-decimal
     1121       ,output v-value-integer
     1122       ,output rep-excel
     1123       ,output v-param-type
     1124       ,INPUT-OUTPUT table-handle v-tth
     1125       )  .
     1126     if rep-excel then v-excel = "TRUE" .
     1127     else v-excel = "FALSE" .
     1128     if p-param eq ""
     1129     then
     1130        p-param = "EXCEL:" + v-excel.
     1131     else
     1132        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1133     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1134   end procedure.
     1135   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1136   define variable v-waitfram-action01         as character   no-undo .
     1137   define variable v-waitfram-action02         as character   no-undo .
     1138   define variable v-waitfram-action03         as character   no-undo .
     1139   define variable mWaitFramTextBeg            as character   no-undo.
     1140   define variable mWaitFramTextEnd            as character   no-undo.
     1141   define variable mWaitFramView               as logical     no-undo.
     1142   define variable mWaitProcEvent              as logical     no-undo init yes.
     1143   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1144   define variable mWaitFramStop               as logical     no-undo.
     1145   define variable mWaitFramStopUser           as logical     no-undo.
     1146   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1147   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1148   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1149   define button B-WaitFramStop auto-end-key
     1150        label "Стоп"
     1151        size 10 by 1 tooltip "Остоновить процесс".
     1152   define button B-viewProcInfo
     1153        label "Информация"
     1154        size 15 by 1 tooltip "Информация о процесс".
     1155   define frame waitfram
     1156     v-waitfram-action01 format "x(72)" no-label skip
     1157     v-waitfram-action02 format "x(72)" no-label skip
     1158     v-waitfram-action03 format "x(72)" no-label skip
     1159     B-viewProcInfo
     1160     B-WaitFramStop at row 4 col 30
     1161     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1162     .
     1163   define new global shared variable mBatchMode as logical no-undo init ?.
     1164   define variable mFramBachModHandle as handle no-undo.
     1165   mFramBachModHandle = frame waitfram:handle.
     1166   define variable mFameOldVis as logical no-undo.
     1167   define variable mVisCUrentVin as logical no-undo.
     1168   if session:batch-mode
     1169   then
     1170      mBatchMode = yes.
     1171   if mBatchMode = ? then do:
     1172     mVisCUrentVin = current-window:visible.
     1173     mFameOldVis = mFramBachModHandle:visible.
     1174     mFramBachModHandle:visible  = yes.
     1175     mBatchMode = mFramBachModHandle:visible ne yes.
     1176     mFramBachModHandle:visible = mFameOldVis.
     1177     current-window:visible = mVisCUrentVin.
     1178   end.
     1179    if  log-manager:logfile-name ne ?
     1180     then DO:
     1181         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1182         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1183         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1184     end.
     1185   on choose of B-WaitFramStop in frame waitfram
     1186   do:
     1187     mWaitFramStop = yes.
     1188     mWaitFramStopUser = yes.
     1189   end.
     1190   function waitfram-check-timeout returns logical():
     1191      define variable vtime as int64 no-undo.
     1192      if mWaitFramStopTimeOut
     1193      then
     1194         return yes.
     1195      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1196      if     mWaitFramTimeOut ne ?
     1197         and mWaitFramTimeOut ne 0
     1198         and mWaitFramTimeOut lt vtime
     1199      then do:
     1200         mWaitFramStopTimeOut = yes.
     1201      end.
     1202      return mWaitFramStopTimeOut.
     1203   end.
     1204   procedure waitfram-hide :
     1205     if not session:batch-mode
     1206     then do
     1207     on error undo, return error return-value
     1208     :
     1209       pause 0 before-hide .
     1210       if not mBatchMode then
     1211         hide frame waitfram .
     1212     if     not mWaitFramView
     1213        and mWaitProcEvent
     1214     then
     1215       process events .
     1216     end.
     1217   end procedure.
     1218   procedure waitfram-show :
     1219     define input  parameter p-message as character no-undo .
     1220     define variable v-left-margin as integer   no-undo .
     1221     if not session:batch-mode
     1222     then do
     1223     on error undo, return error return-value
     1224     :
     1225       if length(p-message) <= 70 then do:
     1226         assign
     1227           v-left-margin = integer((70 - length(p-message)) / 2)
     1228         .
     1229         assign
     1230           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1231         .
     1232         assign
     1233           v-waitfram-action01 = " "
     1234           v-waitfram-action02 = " "
     1235                                    + fill(" ", v-left-margin)
     1236                                    + p-message
     1237           v-waitfram-action03 = " "
     1238         .
     1239       end.
     1240       else do:
     1241         define variable vRindex1 as integer no-undo.
     1242         define variable vRindex2 as integer no-undo.
     1243         vRindex1 = r-index(p-message," ",70).
     1244         if vRindex1 = 0
     1245         then
     1246            vRindex1 = 70.
     1247         if length(p-message)  <= vRindex1 + 70 then do:
     1248           assign
     1249             v-waitfram-action01 = " "
     1250             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1251             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1252           .
     1253         end.
     1254         else do:
     1255           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1256           if vRindex2 <= vRindex1
     1257           then
     1258              vRindex2 = vRindex1 + 70.
     1259           assign
     1260             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1261             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1262             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1263           .
     1264         end.
     1265       end.
     1266       B-viewProcInfo:visible   in frame waitfram = no.
     1267       B-viewProcInfo:sensitive in frame waitfram = no.
     1268       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1269       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1270       if  (   mWaitFramView
     1271          or  mWaitProcEvent)
     1272          and not mBatchMode
     1273       then
     1274          display
     1275             v-waitfram-action01 skip
     1276             v-waitfram-action02 skip
     1277             v-waitfram-action03 skip
     1278          with frame waitfram .
     1279       if     mWaitFramView
     1280          then do:
     1281             if     mWaitFramInterval ne ?
     1282                and not mBatchMode
     1283             then
     1284                wait-for go of frame waitfram pause mWaitFramInterval.
     1285          end.
     1286          else
     1287             if     mWaitProcEvent
     1288                and not mBatchMode
     1289             then
     1290                process events .
     1291     end.
     1292   end procedure.
     1293      procedure waitfram-show-this:
     1294         define input  parameter iInterval as int64 no-undo.
     1295         define variable vtime as int64 no-undo.
     1296         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1297         mWaitFramInterval = iInterval.
     1298         run waitfram-show (substitute("&1&2 &3&4" ,
     1299                                       mWaitFramTextBeg ,
     1300                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1301                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1302                                       mWaitFramTextEnd
     1303                                      )
     1304                           ).
     1305      end.
     1306      procedure WaitFramRunPause:
     1307         define input  parameter iInterval as dec no-undo.
     1308         define variable vStart  as datetime-tz no-undo.
     1309         define variable vend    as datetime-tz no-undo.
     1310         define variable vint as int64 no-undo.
     1311         define variable vOk as logical no-undo.
     1312         vStart = now.
     1313         vend   = vStart.
     1314         publish "WaitFramPause" (iInterval,output vOk).
     1315         vend   =  now.
     1316         vint = vend - vStart.
     1317         vint = iInterval - vint / 1000.
     1318         if     not mWaitFramStop
     1319            and (   vint > 0
     1320                 or (    not vOk
     1321                     and iInterval eq ?
     1322                     )
     1323                 )
     1324         then
     1325            run waitfram-show-this (iInterval).
     1326         vend   =  now.
     1327         vint = vend - vStart.
     1328         vint = iInterval - vint / 1000.
     1329         if     not mWaitFramStop
     1330            and vint > 0
     1331         then do:
     1332            run gbl/pause.p (vint * 1000).
     1333         end.
     1334         if iInterval ne ?
     1335         then
     1336            publish "WaitFramStop".
     1337         waitfram-check-timeout().
     1338      end.
     1339      procedure WaitFramWaitFor:
     1340         define input  parameter iInterval as dec no-undo.
     1341         assign
     1342            mWaitFramStartProc   = now
     1343            mWaitFramStopUser    = no
     1344            mWaitFramStopTimeOut = no
     1345         .
     1346         block-wait:
     1347         do while not mWaitFramStop:
     1348            run WaitFramRunPause (iInterval).
     1349            if  waitfram-check-timeout()
     1350            then do:
     1351               leave block-wait.
     1352            end.
     1353         end.
     1354         run waitfram-hide.
     1355      end.
     1356   procedure waitfram-join :
     1357     define input  parameter p-line-1  as character no-undo .
     1358     define input  parameter p-line-2  as character no-undo .
     1359     define input  parameter p-line-3  as character no-undo .
     1360     define output parameter p-message as character no-undo .
     1361     do
     1362     on error undo, return error return-value
     1363     :
     1364       assign
     1365         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1366                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1367                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1368       .
     1369     end.
     1370   end procedure.
     1371   function waitfram-join-function returns character
     1372     (input p-line-1 as character
     1373     ,input p-line-2 as character
     1374     ,input p-line-3 as character
     1375     ).
     1376     define variable v-message as character no-undo .
     1377     run waitfram-join in this-procedure
     1378       (input  p-line-1
     1379       ,input  p-line-2
     1380       ,input  p-line-3
     1381       ,output v-message
     1382       ) .
     1383     return v-message .
     1384   end function .
