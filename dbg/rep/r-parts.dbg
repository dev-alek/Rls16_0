      501   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      502   def
      503   new shared
      504   temp-table  obj-list no-undo
      505     field obj-type like ub.clients.obj-type
      506     field obj-code like ub.clients.obj-code
      507     field obj-name like ub.clients.obj-name
      508     field obj-id   as integer
      509     field db-num   as integer
      510     index pi is primary unique obj-id
      511     index ie1 obj-type obj-code
      512     index ie2 obj-name
      513   .
      514   procedure create_obj-list :
      515      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      516      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      517      do
      518      on error undo, return error return-value
      519      :
      520         define buffer cli-obj for ub.clients .
      521         define variable p-var as integer no-undo .
      522         define buffer buf_obj-list for obj-list .
      523         find last buf_obj-list  use-index pi no-error .
      524         if available buf_obj-list
      525         then
      526            p-var = buf_obj-list.obj-id + 1.
      527         else
      528            p-var = 1.
      529         find first cli-obj where
      530                   cli-obj.obj-type = p-obj-type
      531               and cli-obj.obj-code = p-obj-code
      532         no-lock no-error.
      533         if available cli-obj
      534         then do:
      535            create buf_obj-list.
      536            assign
      537               buf_obj-list.obj-id   = p-var
      538               buf_obj-list.obj-code = cli-obj.obj-code
      539               buf_obj-list.obj-type = cli-obj.obj-type
      540               buf_obj-list.obj-name = cli-obj.obj-name
      541               buf_obj-list.db-num   = cli-obj.db-num
      542            .
      543         end.
      544      end.
      545   end.
