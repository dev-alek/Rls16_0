     1707           suppl-gds.in-NDS0-base = ub.parts.fact-qnty * vat-base-loc
     1708           suppl-gds.in-sum0-rubl = ub.parts.fact-qnty * price-rubl-with-tax-loc
     1709           suppl-gds.in-sum0-base = ub.parts.fact-qnty * price-base-with-tax-loc
     1710           suppl-gds.out-qnty = 0
     1711           suppl-gds.out-NDS0-rubl = 0
     1712           suppl-gds.out-NDS0-base = 0
     1713           suppl-gds.out-sum0-rubl = 0
     1714           suppl-gds.out-sum0-base = 0
     1715           suppl-gds.free-qnty = ub.parts.fact-qnty
     1716           suppl-gds.free-NDS0-rubl = ub.parts.fact-qnty * vat-rubl-loc
     1717           suppl-gds.free-NDS0-base = ub.parts.fact-qnty * vat-base-loc
     1718           suppl-gds.free-sum0-rubl = ub.parts.fact-qnty * price-rubl-with-tax-loc
