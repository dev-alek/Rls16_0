     1477   string( "Отчет по остаткам товаров" ) AT 45 format "X(95)"
     1478   string( "Cуммы указаны в " + (if PrintRubl then "руб" else base-type) ) AT 145 format "X(20)"
     1479   string( "Страница " + string( PAGE-NUMBER( PrnLibStream ), ">>9" ) ) AT 170 format "X(13)" SKIP
     1480   Line format "X(198)" AT 1
     1481   with width 232 down stream-io.
     1482   assign PrintRubl = yes .
     1483   run gbl/get-per.w (output glog, input-output v-from-date, input-output v-to-date) .
