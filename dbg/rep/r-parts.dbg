     1701           suppl-gds.prod-code = ub.goods.prod-code
     1702           suppl-gds.gds-name = ub.goods.gds-name
     1703           suppl-gds.unit-base = ub.goods.unit-base
     1704           suppl-gds.s-pay-type = s-pay
     1705           suppl-gds.in-qnty = ub.parts.fact-qnty
