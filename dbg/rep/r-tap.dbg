     2928   procedure create-tt :
     2929     do
     2930     on error undo, return error return-value
     2931     :
     2932     case p-SelectGood :
     2933       when  1    then do:
     2934             for each buf_price-list  where buf_price-list.doc-num = buf_price-doc.doc-num:
     2935               create temp-price-list.
     2936               buffer-copy buf_price-list to temp-price-list.
     2937             end.
     2938       end.
     2939       when  2    then do:
     2940           for each buf_price-list  where buf_price-list.doc-num = buf_price-doc.doc-num:
     2941             find first ub.goods where
     2942                        ub.goods.artic = buf_price-list.artic and
     2943                        ub.goods.prod-type = buf_price-list.prod-type and
     2944                        ub.goods.prod-code = buf_price-list.prod-code no-error .
     2945             if not available ub.goods then next.
     2946             find first  tmp#grp  where ub.goods.grp-name   begins tmp#grp.grp-name  no-error .
     2947             if not available tmp#grp then next.
     2948             create temp-price-list.
     2949             buffer-copy buf_price-list to temp-price-list.
     2950           end.
     2951       end.
     2952       when  4 or
     2953       when  5    then do:
     2954           for each buf_price-list  where buf_price-list.doc-num = buf_price-doc.doc-num:
     2955             find first gds-list where
     2956                        gds-list.artic = buf_price-list.artic and
     2957                        gds-list.prod-type = buf_price-list.prod-type and
     2958                        gds-list.prod-code = buf_price-list.prod-code no-error .
     2959             if not available gds-list then next.
     2960             create temp-price-list.
     2961             buffer-copy buf_price-list to temp-price-list.
     2962           end.
     2963      end.
     2964     end case.
     2965     end.
     2966   end procedure.
     2967   PROCEDURE on-same-page :
     2968     define input parameter p-line-number as integer  no-undo .
     2969     if p-line-number > page-size( OutStream ) then do:
     2970       return .
     2971     end.
     2972     if line-counter( OutStream ) + p-line-number > page-size( OutStream ) then do:
     2973       page stream OutStream .
     2974     end.
     2975   end procedure.
