      687   function hvrdtax return logical (input parrecid as recid):
      688   define variable varresult as logical no-undo.
      689   run hvrdtax-proc (input parrecid, output varresult).
      690   return varresult.
      691   end function.
      692   procedure hvrdtax-proc:
      693   define input  parameter parrecid  as recid   no-undo.
      694   define output parameter parresult as logical no-undo.
      695   define buffer bf_goods for ub.goods.
      696   define buffer bf_units for ub.units.
      697   define buffer rt_tax   for ub.tax.
      698   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
      699   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
      700   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
      701   if available rt_tax and
      702       can-find(first ub.tax-units No-LOCK WHERE
      703                      ub.tax-units.tax-code = rt_tax.tax-code AND
      704                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
      705                                                       else assign parresult = no.
      706   end procedure.
      707   def var vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      708   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      709   procedure paramls-clear :
      710     define buffer buf_temp-param for temp-param .
      711     do
      712     on error undo, return error return-value
      713     :
      714       for each buf_temp-param
      715       on error undo, return error
      716       :
      717         delete buf_temp-param .
      718       end.
      719     end.
      720   end procedure.
      721   procedure paramls-write :
      722     define input  parameter p-code     as character no-undo .
      723     define input  parameter p-sub-code as character no-undo .
      724     define input  parameter p-value    as character no-undo .
      725     define buffer buf_temp-param for temp-param .
      726     do
      727     on error undo, return error return-value
      728     :
      729       find first buf_temp-param
      730         where buf_temp-param.param-code     = p-code
      731           and buf_temp-param.param-sub-code = p-sub-code
      732         no-error .
      733       if not available buf_temp-param then do:
      734         create buf_temp-param .
      735         assign
      736           buf_temp-param.param-code     = p-code
      737           buf_temp-param.param-sub-code = p-sub-code
      738         .
      739       end.
      740       assign
      741         buf_temp-param.param-value = p-value
      742       .
      743     end.
      744   end procedure.
      745   procedure paramls-read :
      746     define input  parameter p-code          as character no-undo .
      747     define input  parameter p-sub-code      as character no-undo .
      748     define input  parameter p-default-value as character no-undo .
      749     define output parameter p-value         as character no-undo .
      750     define buffer buf_temp-param for temp-param .
      751     do
      752     on error undo, return error return-value
      753     :
      754       find first buf_temp-param
      755         where buf_temp-param.param-code     = p-code
      756           and buf_temp-param.param-sub-code = p-sub-code
      757         no-error .
      758       if available buf_temp-param then do:
      759         assign
      760           p-value = buf_temp-param.param-value
      761         .
      762       end.
      763       else do:
      764         assign
      765           p-value = p-default-value
      766         .
      767       end.
      768     end.
      769   end procedure.
      770   procedure paramls-append :
      771     define input  parameter p-code     as character no-undo .
      772     define input  parameter p-sub-code as character no-undo .
      773     define input  parameter p-value    as character no-undo .
      774     define buffer buf_temp-param for temp-param .
      775     do
      776     on error undo, return error return-value
      777     :
      778       find first buf_temp-param
      779            where buf_temp-param.param-code     = p-code
      780              and buf_temp-param.param-sub-code = p-sub-code
      781         no-error .
      782       if not available buf_temp-param then do:
      783         create buf_temp-param .
      784         assign
      785           buf_temp-param.param-code     = p-code
      786           buf_temp-param.param-sub-code = p-sub-code
      787           buf_temp-param.param-value    = p-value
      788         .
      789       end.
      790       else do:
      791           assign
      792               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      793           .
      794       end.
      795     end.
      796   end procedure.
