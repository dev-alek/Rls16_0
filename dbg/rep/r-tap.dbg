      816   define variable vss-include-info16 as character format "X(65)" no-undo
      817   initial "@(#)$Workfile$ $Revision$".
      818   define stream excel-line.
      819   define stream excel-cell.
      820   define temp-table temp_cell-data no-undo
      821       field data-key as character
      822       field data-value as character
      823       index pi is primary unique data-key
      824   .
      825   define variable v-tap1-sheet1-cur-data-row     as integer      no-undo.
      826   define variable v-tap1-cell-file-name       as character    no-undo.
      827   define variable v-tap1-data-file-name       as character    no-undo.
      828   procedure tap1-init :
      829   do
      830   on error undo, return error
      831   :
      832       assign
      833           v-tap1-sheet1-cur-data-row = 0
      834       .
      835       run gbl/_tmpfile.p (
      836             input "xd"
      837           , input ".txt"
      838           , output v-tap1-data-file-name
      839       ).
      840       output stream excel-line to value( v-tap1-data-file-name ).
      841       run gbl/_tmpfile.p (
      842             input "xc"
      843           , input ".txt"
      844           , output v-tap1-cell-file-name
      845       ).
      846       output stream excel-cell to value( v-tap1-cell-file-name ).
      847       run tap1-write-cell-data in this-procedure (
      848             input "sheetList":U
      849           , input "Лист1":U
      850       ).
      851       if printrubl
      852       then do:
      853           run tap1-write-cell-data in this-procedure (
      854                 input "Лист1_valutCode":U
      855               , input "0":U
      856           ).
      857       end.
      858       else do:
      859           run tap1-write-cell-data in this-procedure (
      860                 input "Лист1_valutCode":U
      861               , input "1":U
      862           ).
      863       end.
      864       run tap1-write-cell-data in this-procedure (
      865             input "Лист1_columnList":U
      866           , input "number,artic,name,chrt,meas,qnty,price_before,summ_before,price_after,summ_after,delta":U
      867       ).
      868       run tap1-write-cell-data in this-procedure (
      869             input "Лист1_columnType":U
      870           , input "S,S,S,S,S,S,S,S,S,S,S":U
      871       ).
      872       run tap1-write-cell-data in this-procedure (
      873             input "Лист1_subtotalList":U
      874           , input "":U
      875       ).
      876       run tap1-write-cell-data in this-procedure (
      877             input "Лист1_subtotalType":U
      878           , input "":U
      879       ).
      880   end.
      881   end procedure.
      882   procedure tap1-sheet1-write-line-data :
      883   define input parameter p-number       as character        no-undo.
      884   define input parameter p-artic        as character        no-undo.
      885   define input parameter p-name         as character        no-undo.
      886   define input parameter p-chrt         as character        no-undo.
      887   define input parameter p-meas         as character        no-undo.
      888   define input parameter p-qnty         as character        no-undo.
      889   define input parameter p-price_before as character        no-undo.
      890   define input parameter p-summ_before  as character        no-undo.
      891   define input parameter p-price_after  as character        no-undo.
      892   define input parameter p-summ_after   as character        no-undo.
      893   define input parameter p-delta        as character        no-undo.
      894   do
      895   on error undo, return error
      896   :
      897      put stream excel-line unformatted
      898                           "Лист1":U
      899            CHR(9)  "DTA":U
      900            CHR(9)  p-number
      901            CHR(9)  p-artic
      902            CHR(9)  p-name
      903            CHR(9)  p-chrt
      904            CHR(9)  p-meas
      905            CHR(9)  p-qnty
      906            CHR(9)  p-price_before
      907            CHR(9)  p-summ_before
      908            CHR(9)  p-price_after
      909            CHR(9)  p-summ_after
      910            CHR(9)  p-delta
      911            chr(10)
      912      .
      913   end.
      914   end procedure.
      915   procedure tap1-write-cell-data :
      916   define input parameter p-data-key   as character        no-undo.
      917   define input parameter p-data-value as character        no-undo.
      918       define buffer buf_temp_cell-data     for temp_cell-data.
      919   do
      920   for buf_temp_cell-data
      921   on error undo, return error
      922   :
      923       find first buf_temp_cell-data
      924            where buf_temp_cell-data.data-key = p-data-key
      925       no-error.
      926       if not available buf_temp_cell-data
      927       then do:
      928           create buf_temp_cell-data.
      929           assign
      930               buf_temp_cell-data.data-key = p-data-key
      931           .
      932       end.
      933       assign
      934           buf_temp_cell-data.data-value = p-data-value
      935       .
      936       put stream excel-cell unformatted
      937                           buf_temp_cell-data.data-key
      938           CHR(9)   buf_temp_cell-data.data-value
      939           chr(10)
      940       .
      941   end.
      942   end procedure.
      943   procedure tap1-run-excel :
      944   define input parameter p-header-filename    as character        no-undo.
      945   define input parameter p-data-filename      as character        no-undo.
      946   define variable v-template-file-name    as character    no-undo.
      947   define variable v-vb-file-name          as character    no-undo.
      948   define buffer buf_temp-param for temp-param .
      949   do
      950   for buf_temp-param
      951   on error undo, return error
      952   :
      953       create buf_temp-param.
      954       assign
      955           v-template-file-name    = search( "exe/wth-tap1.xlt" )
      956           v-vb-file-name          = search( "exe/t_form.bas" )
      957       .
      958       if v-template-file-name = ?
      959       or v-template-file-name = "":U
      960       then do:
      961           message
      962               "Ошибка имени файла шаблона."
      963           view-as alert-box error.
      964       end.
      965       if v-vb-file-name = ?
      966       or v-vb-file-name = "":U
      967       then do:
      968           message
      969               "Ошибка имени файла кода обработки."
      970           view-as alert-box error.
      971       end.
      972       run paramls-write in this-procedure (
      973             input "template":U
      974           , input "template-file-name":U
      975           , input v-template-file-name
      976       ).
      977       run paramls-write in this-procedure (
      978             input "template":U
      979           , input "vb-file-name":U
      980           , input v-vb-file-name
      981       ).
      982       run paramls-write in this-procedure (
      983             input "data":U
      984           , input "data-header-filename":U
      985           , input p-header-filename
      986       ).
      987       run paramls-write in this-procedure (
      988             input "data":U
      989           , input "data-filename":U
      990           , input p-data-filename
      991       ).
      992       run gbl/macroxlt.p (
      993           input-output table buf_temp-param
      994       ) no-error.
      995       if error-status :error
      996       then do:
      997           message
      998                    vss-workfile vss-revision vss-description
      999               skip(1)
     1000               skip "Ошибка создания файла Excel."
     1001               skip return-value
     1002               skip trim(error-status :get-message(1))
     1003                    trim(error-status :get-message(2))
     1004                    trim(error-status :get-message(3))
     1005           view-as alert-box error.
     1006           undo, return error .
     1007       end.
     1008   end.
     1009   end procedure.
     1010   procedure tap1-close :
     1011   do
     1012   on error undo, return error
     1013   :
     1014       output stream excel-line close.
     1015       output stream excel-cell close.
     1016       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     1017           export "exe/wth-tap1.xlt" .
     1018           export "exe/t_form.bas" .
     1019           export v-tap1-cell-file-name.
     1020           export v-tap1-data-file-name.
     1021       output close.
     1022   end.
     1023   end procedure.
     1024   def var vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1025   procedure tax-name:
     1026   define input  parameter pardef-tax  as character           no-undo.
     1027   define output parameter parname-tax as character initial ? no-undo.
     1028   define buffer bf_tax for ub.tax.
     1029   do on error undo, return error :
     1030      case pardef-tax:
     1031         when 'vat':U then do:
     1032                     find first bf_tax where bf_tax.tax-code = integer('1':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '1':U(не задействован)".
     1033         end.
     1034         when 'slt':U then do:
     1035                     find first bf_tax where bf_tax.tax-code = integer('2':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '2':U(не задействован)".
     1036         end.
     1037         when 'rdt':U then do:
     1038                     find first bf_tax where bf_tax.tax-code = integer('3':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '3':U(не задействован)".
     1039         end.
     1040         when 'exc':U then do:
     1041                     find first bf_tax where bf_tax.tax-code = integer('4':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '4':U(не задействован)".
     1042         end.
     1043         otherwise do:
     1044            return error "Задан неверный параметр " + pardef-tax + " .".
     1045         end.
     1046      end case.
     1047   end.
     1048   end procedure.
     1049   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1050   procedure factord :
     1051     define input  parameter p-fact-date            as date    no-undo .
     1052     define input  parameter p-fact-time            as integer no-undo .
     1053     define input  parameter p-fact-num             as integer no-undo .
     1054     define input  parameter p-shift-date           as date    no-undo .
     1055     define input  parameter p-shift-num            as integer no-undo .
     1056     define input  parameter p-shift-on             as logical no-undo .
     1057     define output parameter p-fact-order           as decimal no-undo .
     1058     define output parameter p-shift-end-fact-order as decimal no-undo .
     1059     define output parameter p-day-end-fact-order   as decimal no-undo .
     1060     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1061     if p-fact-date = ?
     1062     then do:
     1063       return error "Не указана фактическая дата" .
     1064     end.
     1065     define variable v-fact-date-num as integer no-undo .
     1066     assign
     1067       v-fact-date-num = integer(p-fact-date)
     1068     .
     1069     if p-fact-num = ?
     1070     or p-fact-num = 0
     1071     then do:
     1072       return error "Не задан p-fact-num " + string(p-fact-num) .
     1073     end.
     1074     if p-fact-num < 0
     1075     then do:
     1076       return error "Отрицательный fact-num " + string(p-fact-num) .
     1077     end.
     1078     if p-fact-num >= 100000000
     1079     then do:
     1080       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1081     end.
     1082     if p-shift-on = true
     1083     then do:
     1084       if p-shift-date = ?
     1085       then do:
     1086         return error "Не задана дата смены" .
     1087       end.
     1088       if p-shift-num = ?
     1089       or p-shift-num = 0
     1090       then do:
     1091         return error "Не задан номер смены" .
     1092       end.
     1093     end.
     1094     else do:
     1095       assign
     1096         p-shift-date = p-fact-date
     1097         p-shift-num  = 24
     1098       .
     1099     end.
     1100     define variable v-shift-offset as integer no-undo .
     1101     if p-shift-date = p-fact-date
     1102     then do:
     1103       assign
     1104         v-shift-offset = 1
     1105       .
     1106     end.
     1107     if p-shift-date < p-fact-date
     1108     then do:
     1109       assign
     1110         v-shift-offset = 0
     1111       .
     1112     end.
     1113     if p-shift-date > p-fact-date
     1114     then do:
     1115       message
     1116         vss-workfile vss-revision vss-description skip
     1117         "Неправильная дата закрытия смены" skip
     1118         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1119         view-as alert-box error .
     1120       undo, return error
     1121         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1122           ,string(p-fact-date, '99/99/9999':U)
     1123           ,string(p-shift-date, '99/99/9999':U)
     1124           )
     1125       .
     1126     end.
     1127     if p-shift-num < 1
     1128     or p-shift-num > 24
     1129     then do:
     1130       message
     1131         vss-workfile vss-revision vss-description skip
     1132         "Неправильный номер смены" skip
     1133         "p-shift-num" p-shift-num skip
     1134         view-as alert-box error .
     1135       undo, return error return-value .
     1136     end.
     1137     assign
     1138       p-fact-order           = v-fact-date-num
     1139                              + v-shift-offset * 0.5
     1140                              + p-shift-num    * 0.02 - 0.01
     1141                              + p-fact-num     * 0.0000000001
     1142       p-shift-end-fact-order = v-fact-date-num
     1143                              + v-shift-offset * 0.5
     1144                              + p-shift-num    * 0.02
     1145       p-day-end-fact-order   = v-fact-date-num
     1146                              + 0.99
     1147     .
     1148     if p-fact-order           <= v-fact-date-num
     1149     or p-shift-end-fact-order <= v-fact-date-num
     1150     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1151     or p-shift-end-fact-order >= p-day-end-fact-order
     1152     then do:
     1153       message
     1154         vss-workfile vss-revision vss-description skip
     1155         "Внутренняя ошибка при генерации фактического номера" skip
     1156         "p-fact-date"            p-fact-date            skip
     1157         "p-fact-time"            p-fact-time            skip
     1158         "p-fact-num"             p-fact-num             skip
     1159         "p-shift-date"           p-shift-date           skip
     1160         "p-shift-num"            p-shift-num            skip
     1161         "p-shift-on"             p-shift-on             skip
     1162         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1163         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1164         "v-fact-date-num"        v-fact-date-num        skip
     1165         view-as alert-box error .
     1166       undo, return error return-value .
     1167     end.
     1168   end procedure.
     1169   procedure day-begin-fact-order :
     1170     define input  parameter p-fact-date            as date    no-undo .
     1171     define output parameter p-day-begin-fact-order as decimal no-undo .
     1172     do
     1173     on error undo, return error return-value
     1174     :
     1175       if p-fact-date = ?
     1176       then do:
     1177         assign
     1178           p-day-begin-fact-order = 0
     1179         .
     1180       end.
     1181       else do:
     1182         assign
     1183           p-day-begin-fact-order = integer(p-fact-date)
     1184         .
     1185       end.
     1186     end.
     1187   end procedure.
     1188   procedure factord-max-fact-order :
     1189     define output parameter p-max-fact-order as decimal   no-undo .
     1190     do
     1191     on error undo, return error return-value
     1192     :
     1193       run day-begin-fact-order in this-procedure
     1194         (input  date(1, 1, 5000)
     1195         ,output p-max-fact-order
     1196         ) .
     1197     end.
     1198   end procedure.
     1199   procedure factord-cut-archive :
     1200     define input  parameter p-obj-type             as character no-undo .
     1201     define input  parameter p-obj-code             as integer   no-undo .
     1202     define input  parameter p-fact-date            as date      no-undo .
     1203     define output parameter p-shift-on             as logical   no-undo .
     1204     define output parameter p-shift-date           as date      no-undo .
     1205     define output parameter p-shift-num            as integer   no-undo .
     1206     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1207     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1208     define variable v-fact-order as decimal   no-undo .
     1209     define buffer buf_shift-obj for ub.shift-obj .
     1210     do
     1211     on error undo, return error return-value
     1212     :
     1213   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1214   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1215     (input  p-obj-type
     1216     ,input  p-obj-code
     1217     ,input  'shift-on=request'
     1218     ,output p-shift-on
     1219     ) no-error .
     1220       if error-status :error
     1221       then do:
     1222         message
     1223           vss-workfile vss-revision vss-description skip
     1224           "Ошибка при определении атрибута объекта" skip
     1225           "Объект" p-obj-type p-obj-code skip
     1226           error-status :get-message(1) skip
     1227           return-value skip
     1228           view-as alert-box error .
     1229         undo, return error return-value .
     1230       end.
     1231       if p-shift-on = false
     1232       then do:
     1233         assign
     1234           p-shift-date               = ?
     1235           p-shift-num                = 0
     1236         .
     1237       end.
     1238       else do:
     1239         find first buf_shift-obj share-lock
     1240           where buf_shift-obj.obj-type   = p-obj-type
     1241             and buf_shift-obj.obj-code   = p-obj-code
     1242             and buf_shift-obj.shift-date > p-fact-date
     1243           use-index pi
     1244           no-error .
     1245         if not available buf_shift-obj
     1246         or buf_shift-obj.status_ <> 'зкр':U
     1247         then do:
     1248           message
     1249             vss-workfile vss-revision vss-description skip
     1250             "Невозможно вычислить последнюю смену" skip
     1251             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1252             "Объект" p-obj-type p-obj-code skip
     1253             "Дата" p-fact-date skip
     1254             view-as alert-box error .
     1255           undo, return error return-value .
     1256         end.
     1257         find last buf_shift-obj share-lock
     1258           where buf_shift-obj.obj-type = p-obj-type
     1259             and buf_shift-obj.obj-code = p-obj-code
     1260             and buf_shift-obj.shift-date <= p-fact-date
     1261           use-index pi
     1262           no-error .
     1263         if available buf_shift-obj
     1264         then do:
     1265           if  buf_shift-obj.status_ = 'зкр':U
     1266           then do:
     1267             assign
     1268               p-shift-date = buf_shift-obj.shift-date
     1269               p-shift-num  = buf_shift-obj.shift-num
     1270             .
     1271           end.
     1272           else do:
     1273             message
     1274               vss-workfile vss-revision vss-description skip
     1275               "Невозможно вычислить последнюю смену" skip
     1276               "Статус смены отличен от статуса" 'зкр':U skip
     1277               "Объект" p-obj-type p-obj-code skip
     1278               "Дата" p-fact-date skip
     1279               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1280               view-as alert-box error .
     1281             undo, return error return-value .
     1282           end.
     1283         end.
     1284         else do:
     1285           assign
     1286             p-shift-date = p-fact-date - 1
     1287             p-shift-num  = 1
     1288           .
     1289         end.
     1290       end.
     1291       run factord in this-procedure
     1292         (input  p-fact-date
     1293         ,input  1
     1294         ,input  1
     1295         ,input  p-shift-date
     1296         ,input  p-shift-num
     1297         ,input  p-shift-on
     1298         ,output v-fact-order
     1299         ,output p-shift-end-fact-order
     1300         ,output p-day-end-fact-order
     1301         ) no-error .
     1302       if error-status :error
     1303       then do:
     1304         message
     1305           vss-workfile vss-revision vss-description skip
     1306           "Ошибка при вызове процедуры factord"
     1307           error-status :get-message(1) skip
     1308           return-value skip
     1309           view-as alert-box error .
     1310         undo, return error return-value .
     1311       end.
     1312     end.
     1313   end procedure.
     1314   procedure factord-lock-shift :
     1315     define input  parameter p-obj-type  as character no-undo .
     1316     define input  parameter p-obj-code  as integer   no-undo .
     1317     define input  parameter p-fact-date as date      no-undo .
     1318     define parameter buffer buf_shift-obj for ub.shift-obj .
     1319     define variable v-shift-on      as logical   no-undo .
     1320     define variable v-extra-message as character no-undo .
     1321     define variable v-error as character no-undo .
     1322     do
     1323     on error undo, return error return-value
     1324     :
     1325   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1326   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1327     (input  p-obj-type
     1328     ,input  p-obj-code
     1329     ,input  'shift-on=request'
     1330     ,output v-shift-on
     1331     ) no-error .
     1332       if error-status :error
     1333       then do:
     1334         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1335         undo, return error v-error .
     1336       end.
     1337       if v-shift-on = true
     1338       then do:
     1339         find first buf_shift-obj share-lock
     1340           where buf_shift-obj.obj-type   = p-obj-type
     1341             and buf_shift-obj.obj-code   = p-obj-code
     1342             and buf_shift-obj.shift-date > p-fact-date
     1343           use-index pi
     1344           no-error .
     1345         if not available buf_shift-obj
     1346         or buf_shift-obj.status_ <> 'зкр':U
     1347         then do:
     1348           find last buf_shift-obj
     1349             where buf_shift-obj.obj-type = p-obj-type
     1350               and buf_shift-obj.obj-code = p-obj-code
     1351               and buf_shift-obj.status_  = 'зкр':U
     1352             use-index stts
     1353             no-error .
     1354           if available buf_shift-obj
     1355           then do:
     1356             assign
     1357               v-extra-message =
     1358                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1359                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1360                               )
     1361             .
     1362           end.
     1363           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1364           undo, return error v-error .
     1365         end.
     1366       end.
     1367     end.
     1368   end procedure.
     1369   procedure factord-end-day :
     1370     define input  parameter p-fact-date            as date    no-undo .
     1371     define output parameter p-day-end-fact-order   as decimal no-undo .
     1372     do
     1373     on error undo, return error return-value
     1374     :
     1375       if p-fact-date = ?
     1376       then do:
     1377         return error "Не указана фактическая дата" .
     1378       end.
     1379       assign
     1380         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1381       .
     1382     end.
     1383   end procedure.
     1384   procedure factord-to-date :
     1385     define input  parameter p-fact-order as decimal no-undo .
     1386     define output parameter p-fact-date  as date    no-undo .
     1387     define variable v-ref-date  as date      no-undo .
     1388     define variable v-ref-delta as integer   no-undo .
     1389     do
     1390     on error undo, return error return-value
     1391     :
     1392       if p-fact-order = ?
     1393       or p-fact-order = 0
     1394       then do:
     1395         return error "Не указан fact-order" .
     1396       end.
     1397       assign
     1398         v-ref-date  = date(1, 1, 2000)
     1399       .
     1400       assign
     1401         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1402       .
     1403       assign
     1404         p-fact-date = v-ref-date + v-ref-delta
     1405       .
     1406     end.
     1407   end procedure.
     1408   procedure factord-to-fact-num :
     1409     define input  parameter p-fact-order as decimal no-undo .
     1410     define output parameter p-fact-num   as integer no-undo .
     1411     define variable v-fact-order-trunc as decimal no-undo .
     1412     do
     1413     on error undo, return error return-value
     1414     :
     1415       if p-fact-order = ?
     1416       or p-fact-order = 0
     1417       then do:
     1418         return error "Не указан fact-order" .
     1419       end.
     1420       assign
     1421        v-fact-order-trunc = truncate(p-fact-order, 2)
     1422       .
     1423       assign
     1424         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1425       .
     1426     end.
     1427   end procedure.
     1428   procedure factord-to-shift-num :
     1429     define input  parameter p-fact-order as decimal no-undo .
     1430     define output parameter p-shift-num   as integer no-undo .
     1431     define variable  p-shift-numd  as decimal   no-undo .
     1432     define variable v-fact-order-trunc as decimal no-undo .
     1433     do
     1434     on error undo, return error return-value
     1435     :
     1436       if p-fact-order = ?
     1437       or p-fact-order = 0
     1438       then do:
     1439         return error "Не указан fact-order" .
     1440       end.
     1441       assign
     1442        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1443       .
     1444       if v-fact-order-trunc < 0.5 then do:
     1445         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1446       end.
     1447       assign
     1448         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1449         .
     1450        assign
     1451         p-shift-num = truncate (p-shift-numd , 0)
     1452       .
     1453     end.
     1454   end procedure.
     1455   define temp-table temp-font no-undo
     1456     field fontnum  as integer
     1457     field fontname as character
     1458     field fontsize as character
     1459     field fonttype as character
     1460     field font-h   as integer
     1461     field font-w   as integer
     1462     field v-row    as integer
     1463     field v-col    as integer
     1464     field v-row-lans as integer
     1465     field v-col-lans as integer
     1466   index pi fontnum
     1467   .
     1468   procedure get-font-ini :
     1469     do
     1470     on error undo, return error return-value
     1471     :
     1472   define variable ii as integer   no-undo .
     1473   define variable v-font7 as character no-undo .
     1474   define variable v-font as character no-undo .
     1475   define variable loc-name as character no-undo .
     1476   define variable loc-size as character no-undo .
     1477   define variable loc-type as character no-undo .
     1478   define variable old_H as integer   no-undo .
     1479   define variable old_w as integer   no-undo .
     1480   define variable old-row  as integer   no-undo .
     1481   define variable old-col  as integer   no-undo .
     1482   define variable old-row-lans  as integer   no-undo .
     1483   define variable old-col-lans  as integer   no-undo .
     1484   define variable vv as integer   no-undo .
     1485   empty temp-table temp-font.
     1486     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     1487       case num-entries (v-font7) :
     1488         when 4 then do:
     1489             assign
     1490               loc-name = entry ( 1 , v-font7 )
     1491               loc-size = entry ( 2 , v-font7 )
     1492               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     1493             .
     1494         end.
     1495         when 3 then do:
     1496             assign
     1497               loc-name = entry ( 1 , v-font7 )
     1498               loc-size = entry ( 2 , v-font7 )
     1499               loc-type = entry ( 3 , v-font7 )
     1500             .
     1501         end.
     1502         when 2 then  do:
     1503             assign
     1504               loc-name = entry ( 1 , v-font7 )
     1505               loc-size = entry ( 2 , v-font7 )
     1506               loc-type = ""
     1507             .
     1508         end.
     1509         when 1 then do:
     1510             assign
     1511               loc-name = trim(entry ( 1 , v-font7 ))
     1512               loc-size = ""
     1513               loc-type = ""
     1514             .
     1515         end.
     1516       end case.
     1517     create temp-font.
     1518     assign
     1519       temp-font.fontnum  = 7
     1520       temp-font.fontname = trim(loc-name)
     1521       temp-font.fontsize = trim(loc-size)
     1522       temp-font.fonttype = trim(loc-type)
     1523       temp-font.v-row    = 62
     1524       temp-font.v-col    = 136
     1525       temp-font.v-row-lans = 43
     1526       temp-font.v-col-lans = 198
     1527     .
     1528     repeat ii = 16 to 100 :
     1529       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     1530       if v-font = "" or v-font = ? then leave.
     1531       case num-entries (v-font) :
     1532         when 4 then do:
     1533             assign
     1534               loc-name = entry ( 1 , v-font )
     1535               loc-size = entry ( 2 , v-font )
     1536               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     1537             .
     1538         end.
     1539         when 3 then do:
     1540             assign
     1541               loc-name = entry ( 1 , v-font )
     1542               loc-size = entry ( 2 , v-font )
     1543               loc-type = entry ( 3 , v-font )
     1544             .
     1545         end.
     1546         when 2 then do:
     1547             assign
     1548               loc-name = entry ( 1 , v-font )
     1549               loc-size = entry ( 2 , v-font )
     1550               loc-type = ""
     1551             .
     1552         end.
     1553         when 1 then do:
     1554             assign
     1555               loc-name = trim(entry ( 1 , v-font ))
     1556               loc-size = ""
     1557               loc-type = ""
     1558             .
     1559         end.
     1560       end case.
     1561     create temp-font.
     1562     assign
     1563       temp-font.fontnum  = ii
     1564       temp-font.fontname = trim(loc-name)
     1565       temp-font.fontsize = trim(loc-size)
     1566       temp-font.fonttype = trim(loc-type)
     1567     .
     1568     end.
     1569       for each temp-font :
     1570          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     1571          if  vv = ? then vv =  0 .
     1572           run rep/exfont.p (
     1573             input   temp-font.fontname ,
     1574             input   vv ,
     1575             input   temp-font.fonttype ,
     1576             output  temp-font.font-h   ,
     1577             output  temp-font.font-w   )
     1578           .
     1579       end.
     1580   find first temp-font where  temp-font.fontnum  = 7  .
     1581   old_H = temp-font.font-H .
     1582   old_w = temp-font.font-W .
     1583   old-row = temp-font.v-row .
     1584   old-col = temp-font.v-col .
     1585   old-row-lans = temp-font.v-row-lans .
     1586   old-col-lans = temp-font.v-col-lans .
     1587       for each temp-font where
     1588                temp-font.fontnum  <> 7 :
     1589           assign
     1590               temp-font.v-row    = old_H * old-row / temp-font.font-h
     1591               temp-font.v-col    = old_W * old-col / temp-font.font-W
     1592               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     1593               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     1594           .
     1595       end.
     1596     end.
     1597   end procedure.
     1598   PROCEDURE How-name :
     1599   define input  parameter h as integer no-undo .
     1600   define input  parameter w as integer no-undo .
     1601   define output parameter n as character  no-undo .
     1602   define variable A4port-H as integer   no-undo init 63.
     1603   define variable A4port-W as integer   no-undo init 136.
     1604   define variable A4lans-H as integer   no-undo init 43.
     1605   define variable A4lans-W as integer   no-undo init 198.
     1606   define variable Strim-W  as integer   no-undo init 278.
     1607   run define-a4-size (
     1608        input ReportFontNum
     1609       ,output A4port-H
     1610       ,output A4port-W
     1611       ,output A4lans-H
     1612       ,output A4lans-W ).
     1613   If w >= 1 and w <= A4port-W Then DO:
     1614     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1615     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     1616     If h > A4port-H              Then n = "to-file":U.
     1617   End.
     1618   If w > A4port-W and w <= A4lans-W Then DO:
     1619     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1620     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1621     If h > A4port-H              Then n = "to-file":U.
     1622   End.
     1623   If w > A4lans-W and w <= Strim-W Then DO:
     1624     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     1625     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1626     If h > A4port-H              Then n = "to-file":U.
     1627   End.
     1628   If w > Strim-W Then DO:
     1629      n = "to-file":U.
     1630   End.
     1631   END PROCEDURE.
     1632   PROCEDURE define-a4-size :
     1633   define input  parameter p-ReportFontNum as integer   no-undo .
     1634   define output parameter A4port-H as integer   no-undo .
     1635   define output parameter A4port-W as integer   no-undo .
     1636   define output parameter A4lans-H as integer   no-undo .
     1637   define output parameter A4lans-W as integer   no-undo .
     1638   if not can-find (first temp-font ) then do:
     1639      run get-font-ini .
     1640   end.
     1641   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     1642   if available temp-font then do:
     1643   assign
     1644     A4port-H = temp-font.v-row
     1645     A4port-W = temp-font.v-col
     1646     A4lans-H = temp-font.v-row-lans
     1647     A4lans-W = temp-font.v-col-lans
     1648   .
     1649   end.
     1650   else do:
     1651   assign
     1652     A4port-H = 63
     1653     A4port-W = 136
     1654     A4lans-H = 43
     1655     A4lans-W = 198
     1656   .
     1657   end.
     1658   END PROCEDURE.
     1659   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1660   define variable v-waitfram-action01         as character   no-undo .
     1661   define variable v-waitfram-action02         as character   no-undo .
     1662   define variable v-waitfram-action03         as character   no-undo .
     1663   define variable mWaitFramTextBeg            as character   no-undo.
     1664   define variable mWaitFramTextEnd            as character   no-undo.
     1665   define variable mWaitFramView               as logical     no-undo.
     1666   define variable mWaitProcEvent              as logical     no-undo init yes.
     1667   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1668   define variable mWaitFramStop               as logical     no-undo.
     1669   define variable mWaitFramStopUser           as logical     no-undo.
     1670   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1671   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1672   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1673   define button B-WaitFramStop auto-end-key
     1674        label "Стоп"
     1675        size 10 by 1 tooltip "Остоновить процесс".
     1676   define button B-viewProcInfo
     1677        label "Информация"
     1678        size 15 by 1 tooltip "Информация о процесс".
     1679   define frame waitfram
     1680     v-waitfram-action01 format "x(72)" no-label skip
     1681     v-waitfram-action02 format "x(72)" no-label skip
     1682     v-waitfram-action03 format "x(72)" no-label skip
     1683     B-viewProcInfo
     1684     B-WaitFramStop at row 4 col 30
     1685     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1686     .
     1687   define new global shared variable mBatchMode as logical no-undo init ?.
     1688   define variable mFramBachModHandle as handle no-undo.
     1689   mFramBachModHandle = frame waitfram:handle.
     1690   define variable mFameOldVis as logical no-undo.
     1691   define variable mVisCUrentVin as logical no-undo.
     1692   if session:batch-mode
     1693   then
     1694      mBatchMode = yes.
     1695   if mBatchMode = ? then do:
     1696     mVisCUrentVin = current-window:visible.
     1697     mFameOldVis = mFramBachModHandle:visible.
     1698     mFramBachModHandle:visible  = yes.
     1699     mBatchMode = mFramBachModHandle:visible ne yes.
     1700     mFramBachModHandle:visible = mFameOldVis.
     1701     current-window:visible = mVisCUrentVin.
     1702   end.
     1703    if  log-manager:logfile-name ne ?
     1704     then DO:
     1705         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1706         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1707         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1708     end.
     1709   on choose of B-WaitFramStop in frame waitfram
     1710   do:
     1711     mWaitFramStop = yes.
     1712     mWaitFramStopUser = yes.
     1713   end.
     1714   function waitfram-check-timeout returns logical():
     1715      define variable vtime as int64 no-undo.
     1716      if mWaitFramStopTimeOut
     1717      then
     1718         return yes.
     1719      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1720      if     mWaitFramTimeOut ne ?
     1721         and mWaitFramTimeOut ne 0
     1722         and mWaitFramTimeOut lt vtime
     1723      then do:
     1724         mWaitFramStopTimeOut = yes.
     1725      end.
     1726      return mWaitFramStopTimeOut.
     1727   end.
     1728   procedure waitfram-hide :
     1729     if not session:batch-mode
     1730     then do
     1731     on error undo, return error return-value
     1732     :
     1733       pause 0 before-hide .
     1734       if not mBatchMode then
     1735         hide frame waitfram .
     1736     if     not mWaitFramView
     1737        and mWaitProcEvent
     1738     then
     1739       process events .
     1740     end.
     1741   end procedure.
     1742   procedure waitfram-show :
     1743     define input  parameter p-message as character no-undo .
     1744     define variable v-left-margin as integer   no-undo .
     1745     if not session:batch-mode
     1746     then do
     1747     on error undo, return error return-value
     1748     :
     1749       if length(p-message) <= 70 then do:
     1750         assign
     1751           v-left-margin = integer((70 - length(p-message)) / 2)
     1752         .
     1753         assign
     1754           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1755         .
     1756         assign
     1757           v-waitfram-action01 = " "
     1758           v-waitfram-action02 = " "
     1759                                    + fill(" ", v-left-margin)
     1760                                    + p-message
     1761           v-waitfram-action03 = " "
     1762         .
     1763       end.
     1764       else do:
     1765         define variable vRindex1 as integer no-undo.
     1766         define variable vRindex2 as integer no-undo.
     1767         vRindex1 = r-index(p-message," ",70).
     1768         if vRindex1 = 0
     1769         then
     1770            vRindex1 = 70.
     1771         if length(p-message)  <= vRindex1 + 70 then do:
     1772           assign
     1773             v-waitfram-action01 = " "
     1774             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1775             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1776           .
     1777         end.
     1778         else do:
     1779           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1780           if vRindex2 <= vRindex1
     1781           then
     1782              vRindex2 = vRindex1 + 70.
     1783           assign
     1784             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1785             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1786             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1787           .
     1788         end.
     1789       end.
     1790       B-viewProcInfo:visible   in frame waitfram = no.
     1791       B-viewProcInfo:sensitive in frame waitfram = no.
     1792       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1793       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1794       if  (   mWaitFramView
     1795          or  mWaitProcEvent)
     1796          and not mBatchMode
     1797       then
     1798          display
     1799             v-waitfram-action01 skip
     1800             v-waitfram-action02 skip
     1801             v-waitfram-action03 skip
     1802          with frame waitfram .
     1803       if     mWaitFramView
     1804          then do:
     1805             if     mWaitFramInterval ne ?
     1806                and not mBatchMode
     1807             then
     1808                wait-for go of frame waitfram pause mWaitFramInterval.
     1809          end.
     1810          else
     1811             if     mWaitProcEvent
     1812                and not mBatchMode
     1813             then
     1814                process events .
     1815     end.
     1816   end procedure.
     1817      procedure waitfram-show-this:
     1818         define input  parameter iInterval as int64 no-undo.
     1819         define variable vtime as int64 no-undo.
     1820         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1821         mWaitFramInterval = iInterval.
     1822         run waitfram-show (substitute("&1&2 &3&4" ,
     1823                                       mWaitFramTextBeg ,
     1824                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1825                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1826                                       mWaitFramTextEnd
     1827                                      )
     1828                           ).
     1829      end.
     1830      procedure WaitFramRunPause:
     1831         define input  parameter iInterval as dec no-undo.
     1832         define variable vStart  as datetime-tz no-undo.
     1833         define variable vend    as datetime-tz no-undo.
     1834         define variable vint as int64 no-undo.
     1835         define variable vOk as logical no-undo.
     1836         vStart = now.
     1837         vend   = vStart.
     1838         publish "WaitFramPause" (iInterval,output vOk).
     1839         vend   =  now.
     1840         vint = vend - vStart.
     1841         vint = iInterval - vint / 1000.
     1842         if     not mWaitFramStop
     1843            and (   vint > 0
     1844                 or (    not vOk
     1845                     and iInterval eq ?
     1846                     )
     1847                 )
     1848         then
     1849            run waitfram-show-this (iInterval).
     1850         vend   =  now.
     1851         vint = vend - vStart.
     1852         vint = iInterval - vint / 1000.
     1853         if     not mWaitFramStop
     1854            and vint > 0
     1855         then do:
     1856            run gbl/pause.p (vint * 1000).
     1857         end.
     1858         if iInterval ne ?
     1859         then
     1860            publish "WaitFramStop".
     1861         waitfram-check-timeout().
     1862      end.
     1863      procedure WaitFramWaitFor:
     1864         define input  parameter iInterval as dec no-undo.
     1865         assign
     1866            mWaitFramStartProc   = now
     1867            mWaitFramStopUser    = no
     1868            mWaitFramStopTimeOut = no
     1869         .
     1870         block-wait:
     1871         do while not mWaitFramStop:
     1872            run WaitFramRunPause (iInterval).
     1873            if  waitfram-check-timeout()
     1874            then do:
     1875               leave block-wait.
     1876            end.
     1877         end.
     1878         run waitfram-hide.
     1879      end.
     1880   procedure waitfram-join :
     1881     define input  parameter p-line-1  as character no-undo .
     1882     define input  parameter p-line-2  as character no-undo .
     1883     define input  parameter p-line-3  as character no-undo .
     1884     define output parameter p-message as character no-undo .
     1885     do
     1886     on error undo, return error return-value
     1887     :
     1888       assign
     1889         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1890                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1891                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1892       .
     1893     end.
     1894   end procedure.
     1895   function waitfram-join-function returns character
     1896     (input p-line-1 as character
     1897     ,input p-line-2 as character
     1898     ,input p-line-3 as character
     1899     ).
     1900     define variable v-message as character no-undo .
     1901     run waitfram-join in this-procedure
     1902       (input  p-line-1
     1903       ,input  p-line-2
     1904       ,input  p-line-3
     1905       ,output v-message
     1906       ) .
     1907     return v-message .
     1908   end function .
