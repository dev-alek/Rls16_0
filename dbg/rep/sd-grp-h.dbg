     2785   Line = fill( "-" , 60 ) .
     2786   for each obj-list no-lock:
     2787     assign
     2788     accum-obj-list = accum-obj-list + 1.
     2789     if accum-obj-list > 1 then LEAVE.
     2790   end.
     2791   if nc > 15 then do:
     2792     run prn-lib-open-stream  in this-procedure (
     2793                                                 input parParentProc
     2794                                                 ,input 62
     2795                                                 ,input yes
     2796                                                 ,input no
     2797                                                 ).
     2798   end.
     2799   else do:
     2800     run prn-lib-open-stream  in this-procedure (
     2801                                                 input parParentProc
     2802                                                 ,input 43
     2803                                                 ,input yes
     2804                                                 ,input no
     2805                                                 ).
     2806   end.
     2807   FORM with FRAME Hour .
     2808   FORM HEADER
     2809   Line format "X(60)" AT 1 SKIP
     2810   string( "Продолжение - на следующей странице" ) FORMAT "X(40)" AT 10 SKIP
     2811   with FRAME NBottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     2812   VIEW stream PrnLibStream FRAME NBottomFrame .
     2813   PUT stream PrnLibStream
     2814   SPACE(10)
     2815   "Почасовая статистика розничных продаж" format "x(80)" SKIP(0)
     2816   ("( ПО ВЕЛИЧИНЕ СУММ ПРОДАЖ - ЧЕКИ) ЗА ПЕРИОД c " +
     2817    string( startdate, "99/99/9999" ) + " по " + string( enddate, "99/99/9999" ) + ".")      format "x(80)" SKIP(0)
     2818   (IF RETS
     2819   then "ВОЗВРАТЫ УЧТЕНЫ"
     2820   ELSE "") format "x(80)" SKIP(0).
     2821   if t-dis-card then do:
     2822     PUT stream PrnLibStream UNFORMATTED
     2823     SPACE(10)
     2824     "Только покупки по дисконтным картам" skip.
     2825     if rs-dis-card = 1 then do:
     2826       for each temp-dis-card-type No-LOCK:
     2827         PUT stream PrnLibStream UNFORMATTED
     2828         SPACE(10)
     2829         temp-dis-card-type.type
     2830         skip.
     2831       END.
     2832     end.
     2833   end.
     2834   PUT stream PrnLibStream UNFORMATTED
     2835   SPACE(10) SelectObject  skip(0)
     2836   (if byobject then "С разбивкой по объектам" else '':U) skip(1)
     2837   .
     2838   display STREAM PrnLibStream with frame top-Frame .
     2839   _cycle:
     2840   do cycle = 1 to 0 by -1:
     2841     if byobject and cycle = 0 and accum-obj-list = 1 then LEAVE _cycle.
     2842     _obj-list:
     2843     for each obj-list no-lock:
     2844       if not byobject and cycle = 1 then LEAVE _obj-list.
     2845       if cycle = 1 then v-obj-code = obj-list.obj-code.
     2846       if cycle = 0 then v-obj-code = 0.
     2847       assign
     2848       tot-nc = 0
     2849       accum-num-chk[1] =  0
     2850       accum-num-chk[2] =  0
     2851       accum-num-chk[3] =  0
     2852       accum-num-chk[4] =  0
     2853       accum-num-chk[5] =  0
     2854       accum-num-chk[6] =  0
     2855       accum-num-chk[7] =  0
     2856       accum-num-chk[8] =  0
     2857       accum-num-chk[9] =  0
     2858       accum-num-chk[10] = 0
     2859       accum-num-chk[11] = 0
     2860       accum-num-chk[12] = 0
     2861       accum-num-chk[13] = 0
     2862       accum-num-chk[14] = 0
     2863       accum-num-chk[15] = 0
     2864       accum-num-chk[16] = 0
     2865       accum-num-chk[17] = 0
     2866       accum-num-chk[18] = 0
     2867       accum-num-chk[19] = 0
     2868       accum-num-chk[20] = 0
     2869       accum-num-chk[21] = 0
     2870       accum-num-chk[22] = 0
     2871       accum-num-chk[23] = 0
     2872       accum-num-chk[24] = 0
     2873       accum-tot-nc = 0
     2874       .
     2875       if cycle = 1 then do:
     2876         FIND FIRST ub.clients NO-LOCK WHERE
     2877                   ub.clients.obj-code = v-obj-code AND
     2878                   ub.clients.obj-type = 'маг':U NO-ERROR.
     2879         if available ub.clients then do:
     2880           v-obj-name = ub.clients.obj-name.
     2881         end.
     2882         else v-obj-name = string(v-obj-code).
     2883       end.
     2884       if byobject and cycle = 0 then do:
     2885         v-obj-name = "ПО_ВСЕМ_ОБЪЕКТАМ".
     2886       end.
     2887     if use-column[1]
     2888     then  C-sym1:screen-value = string(sym1, entry(1, c-sym1:private-data, chr(4))).
     2889     if use-column[2]
     2890     then  C-full-name:screen-value = string(v-obj-name, entry(1, c-full-name:private-data, chr(4))).
     2891     if use-column[3]
     2892     then  C-sym2:screen-value = string(sym2, entry(1, c-sym2:private-data, chr(4))).
     2893       DISPLAY stream  PrnLibStream with frame HOUR.                               DOWN 1 stream PrnLibStream with FRAME Hour .
     2894       _sum-vals:
     2895       for each sum-vals:
     2896          find first grp-h WHERE
     2897                    grp-h.obj-code = v-obj-code
     2898               AND  grp-h.sum = sum-vals.sum1 no-error .
     2899         if not available grp-h and v-obj-code > 0 and accum-obj-list > 1 then next.
     2900         if available grp-h then do:
     2901           tot-nc = 0.
     2902           DO ii = 1 to 24:
     2903             if use-column[ii + 3] = yes then
     2904             tot-nc = tot-nc + grp-h.num-chk[ii].
     2905           end.
     2906           ASSIGN
     2907           accum-num-chk[1] = accum-num-chk[1] + grp-h.num-chk[1]
     2908           accum-num-chk[2] = accum-num-chk[2] + grp-h.num-chk[2]
     2909           accum-num-chk[3] = accum-num-chk[3] + grp-h.num-chk[3]
     2910           accum-num-chk[4] = accum-num-chk[4] + grp-h.num-chk[4]
     2911           accum-num-chk[5] = accum-num-chk[5] + grp-h.num-chk[5]
     2912           accum-num-chk[6] = accum-num-chk[6] + grp-h.num-chk[6]
     2913           accum-num-chk[7] = accum-num-chk[7] + grp-h.num-chk[7]
     2914           accum-num-chk[8] = accum-num-chk[8] + grp-h.num-chk[8]
     2915           accum-num-chk[9] = accum-num-chk[9] + grp-h.num-chk[9]
     2916           accum-num-chk[10] = accum-num-chk[10] + grp-h.num-chk[10]
     2917           accum-num-chk[11] = accum-num-chk[11] + grp-h.num-chk[11]
     2918           accum-num-chk[12] = accum-num-chk[12] + grp-h.num-chk[12]
     2919           accum-num-chk[13] = accum-num-chk[13] + grp-h.num-chk[13]
     2920           accum-num-chk[14] = accum-num-chk[14] + grp-h.num-chk[14]
     2921           accum-num-chk[15] = accum-num-chk[15] + grp-h.num-chk[15]
     2922           accum-num-chk[16] = accum-num-chk[16] + grp-h.num-chk[16]
     2923           accum-num-chk[17] = accum-num-chk[17] + grp-h.num-chk[17]
     2924           accum-num-chk[18] = accum-num-chk[18] + grp-h.num-chk[18]
     2925           accum-num-chk[19] = accum-num-chk[19] + grp-h.num-chk[19]
     2926           accum-num-chk[20] = accum-num-chk[20] + grp-h.num-chk[20]
     2927           accum-num-chk[21] = accum-num-chk[21] + grp-h.num-chk[21]
     2928           accum-num-chk[22] = accum-num-chk[22] + grp-h.num-chk[22]
     2929           accum-num-chk[23] = accum-num-chk[23] + grp-h.num-chk[23]
     2930           accum-num-chk[24] = accum-num-chk[24] + grp-h.num-chk[24]
     2931           accum-tot-nc = accum-tot-nc + tot-nc
     2932           .
     2933         end.
     2934     if use-column[1]
     2935     then  C-sym1:screen-value = string(sym1, entry(1, c-sym1:private-data, chr(4))).
     2936     if use-column[2]
     2937     then  C-full-name:screen-value = string((string(sum-vals.sum1) + '-' + string(sum-vals.sum2) ), entry(1, c-full-name:private-data, chr(4))).
     2938     if use-column[3]
     2939     then  C-sym2:screen-value = string(sym2, entry(1, c-sym2:private-data, chr(4))).
     2940     if use-column[4]
     2941     then  C-num-chk1:screen-value = string((if available grp-h then grp-h.num-chk[1] else 0), entry(1, c-num-chk1:private-data, chr(4))).
     2942     if use-column[5]
     2943     then  C-num-chk2:screen-value = string((if available grp-h then grp-h.num-chk[2] else 0), entry(1, c-num-chk2:private-data, chr(4))).
     2944     if use-column[6]
     2945     then  C-num-chk3:screen-value = string((if available grp-h then grp-h.num-chk[3] else 0), entry(1, c-num-chk3:private-data, chr(4))).
