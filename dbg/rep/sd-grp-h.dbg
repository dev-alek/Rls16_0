      462   procedure prn-lib-reportviewer :
      463     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      464     define input parameter p-report-name-html as character no-undo .
      465     define input parameter p-param        as character no-undo .
      466     define variable v-excel           as character no-undo init 'TRUE' .
      467     define variable v-value-character as character no-undo .
      468     define variable v-value-integer   as character no-undo .
      469     define variable v-value-date      as date      no-undo .
      470     define variable v-value-decimal   as decimal   no-undo .
      471     define variable rep-excel         as logical   no-undo .
      472     define variable excel-string      as character no-undo .
      473     define variable v-param-type      as character no-undo .
      474     define variable v-tth             as handle    no-undo .
      475     run adm/shattri.p (
      476       input "get":U
      477       ,input  ""
      478       ,input  0
      479       ,input  'report-glob':U
      480       ,input  'rep-excel':U
      481       ,output v-value-character
      482       ,output v-value-date
      483       ,output v-value-decimal
      484       ,output v-value-integer
      485       ,output rep-excel
      486       ,output v-param-type
      487       ,INPUT-OUTPUT table-handle v-tth
      488       )  .
      489     if rep-excel then v-excel = "TRUE" .
      490     else v-excel = "FALSE" .
      491     if p-param eq ""
      492     then
      493        p-param = "EXCEL:" + v-excel.
      494     else
      495        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      496     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      497   end procedure.
