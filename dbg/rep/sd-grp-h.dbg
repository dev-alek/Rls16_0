      318   define  stream PrnLibStream.
      319   procedure prn-lib-prn-file :
      320     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      321     define input parameter p-DIsabledoptions as integer no-undo .
      322     define variable v-report-name as character no-undo .
      323     define variable v-user-action as character no-undo .
      324     define variable v-printed     as logical   no-undo .
      325     define variable v-exist       as logical   no-undo .
      326     do
      327       on error undo, return error
      328       :
      329       run prn-lib-get-report-name  in this-procedure (
      330         input parParentProc
      331         ,output v-report-name
      332         ).
      333   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      334   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      335     (input  v-report-name
      336     ,input  2
      337     ,output v-exist
      338     )  .
      339       if NOT v-exist then
      340       DO:
      341         Message
      342           "Нет заданий на печать ! "
      343           view-as alert-box .
      344         Return  .
      345       End.
      346       run gbl/prnfilen.w
      347         (input  ""
      348         ,input  p-DisabledOptions
      349         ,input  string(v-report-name )
      350         ,input  7
      351         ,output v-user-action
      352         ,output v-printed
      353         ) .
      354       if v-printed then
      355       do:
      356         return "YES" .
      357       end.
      358       else
      359       do:
      360         return "NO" .
      361       end.
      362     end.
      363   end procedure.
      364   procedure prn-lib-open-stream :
      365     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      366     define input parameter p-page-size    as integer no-undo .
      367     define input parameter p-is-stream    as logical no-undo .
      368     define input parameter p-append       as logical no-undo .
      369     define variable v-report-name as character no-undo .
      370     do
      371       on error undo, return error
      372       :
      373       run prn-lib-get-report-name  in this-procedure (
      374         input parParentProc
      375         ,output v-report-name
      376         ).
      377       if p-is-stream then
      378       do:
      379         if p-append then
      380         do:
      381           output stream PrnLibStream to value( v-report-name )
      382             page-size value(p-page-size) append .
      383         end.
      384         if not p-append then
      385         do:
      386           output stream PrnLibStream to value( v-report-name )
      387             page-size value(p-page-size) .
      388         end.
      389       end.
      390       if not p-is-stream then
      391       do:
      392         if p-append then
      393         do:
      394           output to value( v-report-name )
      395             page-size value(p-page-size) append .
      396         end.
      397         if not p-append then
      398         do:
      399           output to value( v-report-name )
      400             page-size value(p-page-size) .
      401         end.
      402       end.
      403     end.
      404   end procedure.
      405   procedure prn-lib-open-exp :
      406     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      407     define input parameter p-is-stream    as logical no-undo .
      408     define input parameter p-is-append    as logical no-undo .
      409     define output parameter p-ReportFileName as char init "report" no-undo.
      410     define output parameter p-process as logical no-undo .
      411     define variable glog as logical no-undo .
      412     do
      413       on error undo, return error
      414       :
      415       SYSTEM-DIALOG GET-FILE p-ReportFileName
      416         TITLE      "Укажите путь"
      417         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      418         ASK-OVERWRITE
      419         CREATE-TEST-FILE
      420         SAVE-AS
      421         USE-FILENAME
      422         DEFAULT-EXTENSION "txt"
      423         UPDATE glog
      424         .
      425       if not glog then  return.
      426       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      427       if p-is-stream then
      428       do:
      429         if p-is-append then
      430         do:
      431           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      432         end.
      433         else
      434         do:
      435           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      436         end.
      437       end.
      438       else
      439       do:
      440         if p-is-append then
      441         do:
      442           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      443         end.
      444         else
      445         do:
      446           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      447         end.
      448       end.
      449       p-process = yes.
      450     end.
      451   end procedure.
      452   procedure prn-lib-get-report-name :
      453     define input parameter parParentProc  as widget-handle no-undo.
      454     define output parameter p-report-name as character no-undo .
      455     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      456   end procedure.
      457   procedure prn-lib-reportviewer-report-name :
      458     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      459     define input parameter p-report-name-html as character no-undo .
      460     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
