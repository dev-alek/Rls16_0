      571   procedure create_obj-list :
      572      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      573      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      574      do
      575      on error undo, return error return-value
      576      :
      577         define buffer cli-obj for ub.clients .
      578         define variable p-var as integer no-undo .
      579         define buffer buf_obj-list for obj-list .
      580         find last buf_obj-list  use-index pi no-error .
      581         if available buf_obj-list
      582         then
      583            p-var = buf_obj-list.obj-id + 1.
      584         else
      585            p-var = 1.
      586         find first cli-obj where
      587                   cli-obj.obj-type = p-obj-type
      588               and cli-obj.obj-code = p-obj-code
      589         no-lock no-error.
      590         if available cli-obj
      591         then do:
      592            create buf_obj-list.
      593            assign
      594               buf_obj-list.obj-id   = p-var
      595               buf_obj-list.obj-code = cli-obj.obj-code
      596               buf_obj-list.obj-type = cli-obj.obj-type
      597               buf_obj-list.obj-name = cli-obj.obj-name
      598               buf_obj-list.db-num   = cli-obj.db-num
      599            .
      600         end.
      601      end.
      602   end.
      603   define  shared temp-table X-init_obj-list no-undo
      604   field obj-type like ub.clients.obj-type
      605   field obj-code like ub.clients.obj-code
      606   index pi is unique primary obj-type obj-code.
