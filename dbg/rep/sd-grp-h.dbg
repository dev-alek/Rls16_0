     1011   run gbl/getlocal.p (
     1012                     output v-dec-sep
     1013                    ,output v-th-sep
     1014                    ,output v-sdate
     1015                    ,output v-shortdate
     1016                    ) no-error .
     1017   assign
     1018   v-reg-replace = NOT (v-dec-sep = ".":U and v-th-sep = chr(44))
     1019                   AND (v-dec-sep <> ? and v-th-sep <> ?)
     1020   .
     1021     FUNCTION supress-null RETURNS CHARACTER ( INPUT p-string  AS CHARACTER,
     1022                                               INPUT p-dec-sep AS CHARACTER  ) :
     1023       DEFINE VARIABLE v-string AS CHARACTER NO-UNDO.
     1024       IF TRIM( p-string ) = "0"                    OR
     1025          TRIM( p-string ) = "0" + p-dec-sep + "00" OR
     1026          TRIM( p-string ) =       p-dec-sep + "00" OR
     1027          TRIM( p-string ) =       p-dec-sep + "0"  OR
     1028          TRIM( p-string ) = "0" + p-dec-sep + "0"  THEN DO: ASSIGN v-string = "":U.     END.
     1029                                                    ELSE DO: ASSIGN v-string = p-string. END.
     1030       RETURN ( TRIM( v-string ) ).
     1031     END FUNCTION.
     1032   FUNCTION reg-output returns character( input p-string as character
     1033                                         ,input p-private-data as character
     1034                                         ,input p-replace as logical
     1035                                         ,input p-supress as logical
     1036                                         ,input p-dec-sep as character
     1037                                         ,input p-th-sep as character
     1038                                         ):
     1039   DEFINE VARIABLE v-reg-output as character no-undo .
     1040   DEFINE VARIABLE v-data-type as character no-undo .
     1041   DEFINE VARIABLE v-progress-format as character no-undo .
     1042   assign
     1043   v-progress-format = entry(1, p-private-data, chr(4))
     1044   v-data-type = entry(2, p-private-data, chr(4))
     1045   .
     1046   if p-string = ? then return chr(63).
     1047   if (v-data-type = "INTEGER"
     1048       OR v-data-type = "DECIMAL" ) THEN DO:
     1049     IF p-replace THEN DO:
     1050       assign
     1051         v-reg-output = replace( p-string
     1052                                         ,chr(44)
     1053                                         ,"":U
     1054                                       )
     1055         v-reg-output = trim(v-reg-output)
     1056       .
     1057     END.
     1058     else do:
     1059       v-reg-output = p-string.
     1060     end.
     1061     IF p-supress THEN DO: ASSIGN v-reg-output = supress-null( TRIM( v-reg-output ), p-dec-sep ). END.
     1062     return v-reg-output.
     1063   end.
     1064     return p-string.
     1065   END FUNCTION.
