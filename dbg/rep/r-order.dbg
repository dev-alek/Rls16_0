      735       '         <th style="text-align: center;  font-weight:bold; background-color: silver;"></th>' skip
      736       '         <th style="text-align: center;  font-weight:bold; background-color: silver;"></th>' skip
      737       '         <th colspan="3" style="text-align: center;  font-weight:bold; background-color: silver;">ФАКТИЧЕСКИЕ ДАННЫЕ</th>' skip
      738       '         <th style="text-align: center;  font-weight:bold; background-color: silver;">ЗАКАЗ</th>' skip
