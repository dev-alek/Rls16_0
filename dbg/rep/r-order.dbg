      408   procedure prn-lib-open-stream :
      409     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      410     define input parameter p-page-size    as integer no-undo .
      411     define input parameter p-is-stream    as logical no-undo .
      412     define input parameter p-append       as logical no-undo .
      413     define variable v-report-name as character no-undo .
      414     do
      415       on error undo, return error
      416       :
      417       run prn-lib-get-report-name  in this-procedure (
      418         input parParentProc
      419         ,output v-report-name
      420         ).
      421       if p-is-stream then
      422       do:
      423         if p-append then
      424         do:
      425           output stream PrnLibStream to value( v-report-name )
      426             page-size value(p-page-size) append .
      427         end.
      428         if not p-append then
      429         do:
      430           output stream PrnLibStream to value( v-report-name )
      431             page-size value(p-page-size) .
      432         end.
      433       end.
      434       if not p-is-stream then
      435       do:
      436         if p-append then
      437         do:
      438           output to value( v-report-name )
      439             page-size value(p-page-size) append .
      440         end.
      441         if not p-append then
      442         do:
      443           output to value( v-report-name )
      444             page-size value(p-page-size) .
      445         end.
      446       end.
      447     end.
      448   end procedure.
      449   procedure prn-lib-open-exp :
      450     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      451     define input parameter p-is-stream    as logical no-undo .
      452     define input parameter p-is-append    as logical no-undo .
      453     define output parameter p-ReportFileName as char init "report" no-undo.
      454     define output parameter p-process as logical no-undo .
      455     define variable glog as logical no-undo .
      456     do
      457       on error undo, return error
      458       :
      459       SYSTEM-DIALOG GET-FILE p-ReportFileName
      460         TITLE      "Укажите путь"
      461         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      462         ASK-OVERWRITE
      463         CREATE-TEST-FILE
      464         SAVE-AS
      465         USE-FILENAME
      466         DEFAULT-EXTENSION "txt"
      467         UPDATE glog
      468         .
      469       if not glog then  return.
      470       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      471       if p-is-stream then
      472       do:
      473         if p-is-append then
      474         do:
      475           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      476         end.
      477         else
      478         do:
      479           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      480         end.
      481       end.
      482       else
      483       do:
      484         if p-is-append then
      485         do:
      486           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      487         end.
      488         else
      489         do:
      490           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      491         end.
      492       end.
      493       p-process = yes.
      494     end.
      495   end procedure.
      496   procedure prn-lib-get-report-name :
      497     define input parameter parParentProc  as widget-handle no-undo.
      498     define output parameter p-report-name as character no-undo .
      499     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      500   end procedure.
      501   procedure prn-lib-reportviewer-report-name :
      502     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      503     define input parameter p-report-name-html as character no-undo .
      504     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      505   end procedure.
      506   procedure prn-lib-reportviewer :
      507     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      508     define input parameter p-report-name-html as character no-undo .
      509     define input parameter p-param        as character no-undo .
      510     define variable v-excel           as character no-undo init 'TRUE' .
      511     define variable v-value-character as character no-undo .
      512     define variable v-value-integer   as character no-undo .
      513     define variable v-value-date      as date      no-undo .
      514     define variable v-value-decimal   as decimal   no-undo .
      515     define variable rep-excel         as logical   no-undo .
      516     define variable excel-string      as character no-undo .
      517     define variable v-param-type      as character no-undo .
      518     define variable v-tth             as handle    no-undo .
      519     run adm/shattri.p (
      520       input "get":U
      521       ,input  ""
      522       ,input  0
      523       ,input  'report-glob':U
      524       ,input  'rep-excel':U
      525       ,output v-value-character
      526       ,output v-value-date
      527       ,output v-value-decimal
      528       ,output v-value-integer
      529       ,output rep-excel
      530       ,output v-param-type
      531       ,INPUT-OUTPUT table-handle v-tth
      532       )  .
      533     if rep-excel then v-excel = "TRUE" .
      534     else v-excel = "FALSE" .
      535     if p-param eq ""
      536     then
      537        p-param = "EXCEL:" + v-excel.
      538     else
      539        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      540     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      541   end procedure.
      542   define new shared temp-table tt-zakaz like ub.order-line
      543       field gds-name          as character
      544       field minZapas          as decimal
      545       field volMinZapas       as integer
      546       field ostatokDay        as decimal
      547       field qntyDaySale       as integer
      548       field qntyDayGoods      as integer
      549       field ostatokGoods      as decimal
      550       field qntyDay           as integer
      551       field contract-prn-code as character
      552       field contract-code     as integer
      553       index pi    gds-code          contract-code
      554       index artic artic             prod-type         prod-code
      555       index contr contract-prn-code.
      556   define new shared temp-table temp-gds-qnty no-undo
      557       field day      as date
      558       field ost      as decimal
      559       field gds-code as integer
      560       index pi is unique primary day gds-code
      561       index by-ost               ost .
      562   define buffer buf_order-doc  for ub.order-doc .
      563   define buffer buf_order-line for ub.order-line .
      564   define variable v-full-path-RepView as character no-undo.
      565   define variable v-file-name-rep-htm as character no-undo.
      566   define variable g#report-num        as integer   no-undo.
      567   define variable v-report-name       as character no-undo.
      568   define variable v-period            as character no-undo.
      569   define variable vDaySale            as character no-undo .
      570   define variable vGarantDay          as character no-undo .
      571   define variable vDelDayGoods        as logical   no-undo .
      572   define variable periodDay           as character no-undo .
      573   define variable vDateOrder          as date      no-undo .
      574   define stream OutStr-html.
      575   define buffer buf_goods   for ub.goods .
      576   define buffer buf_clients for ub.clients .
      577   define buffer bf_clients  for ub.clients .
      578   find first buf_order-doc no-lock where buf_order-doc.doc-code = p-docCode and
      579       buf_order-doc.db-num = p-dbNum no-error .
      580   run get-full-path-RepViewer(output v-full-path-RepView).
      581   run get-report-num in parParentProc(output g#report-num).
      582   run define-full-path-Report(input g#report-num, output v-file-name-rep-htm).
      583   run create-file(v-file-name-rep-htm).
      584   run waitfram-show in this-procedure ("Подождите ...").
      585   output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8' .
      586   put stream OutStr-html unformatted
      587       "<!DOCTYPE HTML>" skip
      588       ' <html>' skip
      589       '  <head>' skip
      590       '   <meta charset="utf-8">' skip
      591       '    <style type="text/css">' skip
      592       '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
      593       '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
      594       '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black; height: 14px;' + chr(125) skip
      595       '   </style>' skip
      596       '  </head>' skip
      597       .
      598   put stream OutStr-html unformatted
      599       '<body>' skip
      600       '<TABLE name="zakaz"  fit_to_page="true" orientation="landscape" CELLSPACING="0" BORDER="0">'skip
      601       '<thead>' skip
      602       .
      603   put stream OutStr-html unformatted
      604       '<tr class="set_columns">' skip
      605       '<td style="width: 120px;"></td>' skip
      606       '<td style="width: 120px;"></td>' skip
      607       '<td style="width: 200px;"></td>' skip
      608       '<td style="width: 120px;"></td>' skip
      609       '<td style="width: 120px;"></td>' skip
      610       '<td style="width: 150px;"></td>' skip
      611       '<td style="width: 150px;"></td>' skip
      612       '<td style="width: 150px;"></td>' skip
      613       '<td style="width: 150px;"></td>' skip
      614       '<td style="width: 150px;"></td>' skip
      615       '<td style="width: 150px;"></td>' skip
      616       '<td style="width: 150px;"></td>' skip
      617       '<td style="width: 150px;"></td>' skip
      618       '</tr>' skip
      619       .
      620   find first bf_clients no-lock where bf_clients.obj-code = buf_order-doc.obj-code and
      621       bf_clients.obj-type = buf_order-doc.obj-type no-error .
      622   find first buf_clients no-lock where buf_clients.obj-code = buf_order-doc.cli-code and
      623       buf_clients.obj-type = buf_order-doc.cli-type no-error .
      624   vDateOrder = date(entry(1,p-param,chr(4))) no-error .
      625   vDaySale = entry(3,p-param,chr(4)) no-error .
      626   vGarantDay = entry(4,p-param,chr(4)) no-error .
      627   periodDay = entry(8,p-param,chr(4)) no-error.
      628   v-period = entry(9,p-param,chr(4)) no-error.
      629   vDelDayGoods = logical(entry(5,p-param,chr(4))) no-error.
      630   put stream OutStr-html unformatted
      631       '<tr style="font-size:11px;">' skip
      632       '<td colspan="13" style="text-align: left; font-weight:bold;">Отчет по планированию заказа товаров Магазина и готовой продукции Кафе</td>' skip
      633       '</tr>' skip
      634       '<tr style="font-size:11px;">' skip
      635       '<td colspan="5" text_wrap="true" style="text-align: left;">на ' + string(vDateOrder,"99/99/9999") + '</td>' skip
      636       '<td colspan="8" text_wrap="true" style="text-align: left; font-style: italic;"><b>Остаток товара, шт (О)</b> Количество товара на остатке в штуках на текущий момент (4).</td>' skip
      637       '</tr>' skip
      638       '<tr style="font-size:11px;">' skip
      639       '<td colspan="5" text_wrap="true" style="text-align: left;">объект: ' + bf_clients.obj-name + '</td>' skip
      640       '<td colspan="8" text_wrap="true" style="text-align: left; font-style: italic;"><b>Продажи за период, шт (Vпр)</b> Количество продаж товара (с учетом возвратов) за выбранный период (5).</td>' skip
      641       '</tr>' skip
      642       '<tr style="font-size:11px;">' skip
      643       '<td colspan="5" text_wrap="true" style="text-align: left;">контрагент: ' + buf_clients.obj-name + '</td>' skip
      644       '<td colspan="8" text_wrap="true" style="text-align: left; font-style: italic;"><b>Среднесуточные продажи за период, шт (Тпр)</b> Среднесуточное количество проданного товара за выбранный период времени Тпр = Vпр / P, где Р – период продаж в днях (6).</td>' skip
      645       '</tr>' skip
      646       .
      647   put stream OutStr-html unformatted
      648       '<tr style="font-size:11px;">' skip
      649       '<td colspan="5" text_wrap="true" style="text-align: left;">заказ формируется на : ' + string(vDaySale) + ' дней(дня), с учетом гарантийного запаса на ' + string(vGarantDay) + ' дней(дня)</td>' skip
      650       '<td colspan="8" text_wrap="true" style="text-align: left; font-style: italic;"><b>Рекомендованный объем заказа с учетом минимального и гарантийного запасов, шт (Vзг)</b> Vзг = Vз + М + G  (7).</td>' skip
      651       '</tr>' skip .
      652   put stream OutStr-html unformatted
      653       '<tr style="font-size:11px;">' skip
      654       '<td colspan="5" text_wrap="true" style="text-align: left;">период анализа : ' + string(periodDay) + ' дней(дня) ' + v-period + '</td>' skip
      655       '<td colspan="8" text_wrap="true" style="text-align: left; font-style: italic;"><b>Запас товара, в днях (Од)</b> Количество дней, на которое должно хватить остатков товара на текущий момент с учетом среднесуточных продаж за период Од = О / Тпр (8).</td>' skip
      656       '</tr>' skip
      657       '<tr style="font-size:11px;">' skip
      658       .
      659   if vDelDayGoods then
      660   do:
      661       put stream OutStr-html unformatted
      662           '<td colspan="5" text_wrap="true" style="text-align: left;">исключены дни, когда товара не было на остатках</td>' skip
      663           .
      664   end.
      665   else
      666   do:
      667       put stream OutStr-html unformatted
      668           '<td colspan="5" style="text-align: left;"></td>' skip
      669           .
      670   end.
      671   put stream OutStr-html unformatted
      672       '<td colspan="8" text_wrap="true" style="text-align: left; font-style: italic;"><b>Расчетный объем заказа с учетом темпа продаж, шт (Vз)</b> Vз = Тпр * Q - Ост, где Q – период, на который формируется заказ в днях,</td>' skip
      673       '</tr>' skip
      674       '<tr style="font-size:11px;">' skip
      675       '<td colspan="5" text_wrap="true" style="text-align: left;"></td>' skip
      676       '<td colspan="8" text_wrap="true" style="text-align: left; font-style: italic;">если Ост < 0, то при расчете Ост не учитывается. Ост – Остаток товара на день заказа: Ост = О - (Dз-D) * Тпр, где Dз – дата заказа, D – текущая дата (9).</td>' skip
      677       '</tr>' skip
      678       '<tr style="font-size:11px;">' skip
      679       '<td colspan="5" text_wrap="true" style="text-align: left;"></td>' skip
      680       '<td colspan="8" text_wrap="true" style="text-align: left; font-style: italic;"><strong>Расчетный объем заказа с учетом минимального запаса,шт (Vзм)</strong> Vзм = Vз + М  (10).</td>' skip
      681       '</tr>' skip
      682       '<tr style="font-size:11px;">' skip
      683       '<td colspan="5" text_wrap="true" style="text-align: left;"></td>' skip
      684       '<td colspan="8" text_wrap="true" style="text-align: left; font-style: italic;"><b>Минимальный запас, шт (М)</b> Количество товара, необходимое для выкладки (11). </td>' skip
      685       '</tr>' skip
      686       '<tr style="font-size:11px;">' skip
      687       '<td colspan="5" text_wrap="true" style="text-align: left;"></td>' skip
      688       '<td colspan="8" text_wrap="true" style="text-align: left; font-style: italic;"><b>Гарантийный запас, шт (G)</b> G = S * Тпр, где   S – гарантийный запас в днях (12).</td>' skip
      689       '</tr>' skip
      690       '<tr style="font-size:11px;">' skip
      691       '<td colspan="5" text_wrap="true" style="text-align: left;"></td>' skip
      692       '<td colspan="8" text_wrap="true" style="text-align: left; font-style: italic;"><b>Товар участвует в промоакции</b> Участие товара в промоакции в статусе «Активная» в ТН на момент формирования отчета. </td>' skip
      693       '</tr>' skip
      694       '<tr style="font-size:11px;">' skip
      695       '<td colspan="5" text_wrap="true" style="text-align: left;"></td>' skip
      696       '<td colspan="8" text_wrap="true" style="text-align: left; font-style: italic;">Информация справочная, необходимо учитывать при подтверждении заказа (13).</td>' skip
      697       '</tr>' skip
      698       '<tr height:15px;  style="font-size:11px;">' skip
      699       '<td colspan="5" text_wrap="true" style="text-align: left;"></td>' skip
      700       '<td colspan="8" text_wrap="true" style="text-align: left;"></td>' skip
      701       '</tr>' skip
