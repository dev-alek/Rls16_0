      754       '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">13</th>' skip
      755       '       </tr>' skip
      756       .
      757   put stream OutStr-html unformatted
      758       '     <tbody>' skip
      759       .
      760   put stream OutStr-html unformatted
      761       '<tr style="font-size:11px;">' skip
      762       '<td colspan="13" style="text-align: left; font-weight:bold;"><br>' + if buf_order-doc.contract-prn-code = "" then '   БЕЗ ДОГОВОРА</td>' else '   ' + buf_order-doc.contract-prn-code + '<br></td>' skip
      763       '</tr>' skip
      764       .
      765   for each buf_order-line no-lock where buf_order-line.doc-code = buf_order-doc.doc-code and
      766       buf_order-line.db-num = buf_order-line.db-num:
      767       find first tt-zakaz no-lock where tt-zakaz.gds-code = buf_order-line.gds-code no-error .
      768       if available (tt-zakaz) then next .
      769       find first buf_goods no-lock where buf_goods.gds-code = buf_order-line.gds-code no-error .
      770       put stream OutStr-html unformatted
      771           '       <tr style="font-size:11px;">' skip
      772           '         <td text_wrap="true" style="text-align: center;">' + string(buf_order-line.gds-code) + '</td>' skip
      773           '         <td text_wrap="true" style="text-align: center;">' + string(buf_order-line.artic) + '</td>' skip
      774           '         <td text_wrap="true" style="text-align: center;">' + string(buf_goods.gds-name) + '</td>' skip
      775           '         <td text_wrap="true" num="0" val="' + fnc-convert-dot-to-colon(buf_order-line.rest,"->>>>>>>>>>>>>9",0) + '"  style="text-align: center;">' + fnc-convert-dot-to-colon(buf_order-line.rest,"->>>>>>>>>>>9",0) + '</td>' skip
      776           '         <td text_wrap="true" num="0" val="' + fnc-convert-dot-to-colon(buf_order-line.sales,"->>>>>>>>>>>>>9.",0) + '" style="text-align: center;">' + fnc-convert-dot-to-colon(buf_order-line.sales,"->>>>>>>>>>>>>9",0) + '</td>' skip
      777           '         <td text_wrap="true" num="0.0" val="' + fnc-convert-dot-to-colon(buf_order-line.average-sales,"->>>>>>>>>>>>>9.9",1) + '" style="text-align: center;">' + fnc-convert-dot-to-colon(buf_order-line.average-sales,"->>>>>>>>>>>>>9.9",1) + '</TD>' skip
      778           '         <td text_wrap="true" style="text-align: center; font-weight:bold; font-size:12px;">' + string(buf_order-line.order-qnty) + '</td>' skip
      779           '         <td text_wrap="true" style="text-align: center;">' + string(buf_order-line.stock-goods) + '</td>' skip
