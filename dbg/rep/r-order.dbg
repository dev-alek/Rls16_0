      787   end.
      788   run prn-lib-reportviewer-report-name in this-procedure (
      789       input THIS-PROCEDURE
      790       ,input v-file-name-rep-htm
      791       ).
      792   procedure get-full-path-RepViewer:
      793       define output parameter p-fill-path-RepView as character no-undo.
      794       if search("exe\ReportViewer\reportviewer.exe") <> ? then
      795       do:
      796           p-fill-path-RepView = search("exe\ReportViewer\reportviewer.exe").
      797       end.
      798       else
      799       do:
      800           message "Не найдена программа просмотра отчёта!" view-as alert-box error.
      801       end.
      802   end procedure.
      803   procedure define-full-path-Report:
      804       define input parameter p-rep-num as integer no-undo.
      805       define output parameter p-file-name-rep-htm as character no-undo.
      806       p-file-name-rep-htm = session:temp-directory + "rpt" + string(p-rep-num) + ".html".
      807   end procedure.
      808   procedure search-full-path-Report:
      809       define input parameter p-file-name as character no-undo.
      810       if search(p-file-name) = ? then
      811       do:
      812           message "Не найден файл отчёта: " p-file-name view-as alert-box error.
      813       end.
      814       else
      815       do:
      816           p-file-name = search(p-file-name).
      817       end.
      818   end procedure.
      819   procedure Report-Viewer:
      820       define input parameter p-full-path-RepView as character no-undo.
      821       define input parameter p-file-name-rep-htm as character no-undo.
      822       os-command no-wait value(p-full-path-RepView + " " + search(p-file-name-rep-htm)).
      823   end procedure.
      824   procedure create-file:
      825       define input parameter p-file-name as character no-undo.
      826       output to value(string(p-file-name)).
      827       output close.
      828   end procedure.
