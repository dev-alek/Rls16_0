     2192     temp-serv.obj-code
     2193     temp-serv.fact-date
     2194     temp-serv.fact-qnty
     2195     temp-serv.tot-doc
     2196     temp-serv.discnt
     2197     pcnt
     2198     temp-serv.netto
     2199     temp-serv.num-chk
     2200     with FRAME temprep
     2201     .
     2202   END.
     2203   find first tot_temp-serv where
     2204             tot_temp-serv.fact-date = 01/01/1990
     2205         and  tot_temp-serv.obj-type = ''
     2206         and  tot_temp-serv.obj-code = 0
     2207         and  tot_temp-serv.gds-code = 0
     2208         .
     2209   pcnt = round( tot_temp-serv.discnt / tot_temp-serv.tot-doc * 100, 1 ) .
     2210   if pcnt = ? then pcnt = 0.
