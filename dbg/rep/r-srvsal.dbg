     2395             gdsobj_temp-serv.fact-date = 01/01/1990
     2396         and gdsobj_temp-serv.obj-type = obj-list.obj-type
     2397         and gdsobj_temp-serv.obj-code = obj-list.obj-code
     2398         and gdsobj_temp-serv.gds-code > 0
     2399     break
     2400     by gdsobj_temp-serv.gds-code
     2401     with FRAME GoodsRep
     2402     :
