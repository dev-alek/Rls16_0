     2212   sym1 "ИТОГО" @ temp-serv.fact-date
     2213   sym11
     2214   sym2 tot_temp-serv.fact-qnty @ temp-serv.fact-qnty
     2215   sym3 tot_temp-serv.tot-doc @ temp-serv.tot-doc
