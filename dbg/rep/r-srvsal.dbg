     2545   PROCEDURE ByGoodsDate:
     2546   run prn-lib-open-stream  in this-procedure (
     2547                                                input my-handle
     2548                                               ,input 43
     2549                                               ,input yes
     2550                                               ,input no
     2551                                               ).
     2552   FORM HEADER
     2553   Line format "X(231)" AT 1 SKIP
     2554   "Продолжение - на следующей странице" AT 90 SKIP
     2555   with FRAME NBottomFrame width 232
     2556   PAGE-BOTTOM NO-LABELS NO-BOX .
     2557   VIEW stream PrnLibStream FRAME NBottomFrame .
     2558   PUT stream PrnLibStream SPACE(30)
     2559   "РЕАЛИЗАЦИЯ  УСЛУГ  " str1 format "x(110)" SKIP(1).
     2560   put stream prnlibstream unformatted str2 skip(0).
     2561   PUT stream PrnLibStream SPACE(30) "По объектам :"
     2562               format "X(198)" SKIP(1).
     2563   FOR EACH obj-list :
     2564           FIND cli-obj WHERE cli-obj.obj-type = obj-list.obj-type AND
     2565                                             cli-obj.obj-code = obj-list.obj-code NO-LOCK .
     2566           PUT stream PrnLibStream SPACE(30) cli-obj.obj-name format "X(100)" SKIP.
     2567   END.
     2568   Put stream Prnlibstream unformatted p-report-header skip.
     2569   PUT stream PrnLibStream " " SKIP(1) .
     2570   FOR each date_temp-serv where
     2571           date_temp-serv.gds-code = 0
     2572       and date_temp-serv.obj-type = ''
     2573       and date_temp-serv.obj-code = 0
     2574       and date_temp-serv.fact-date > 01/01/1990
     2575   break
     2576   by date_temp-serv.fact-date
     2577   with FRAME goodsdaterep
     2578   :
     2579     pcnt = round(  date_temp-serv.discnt /  date_temp-serv.tot-doc * 100, 1 ) .
     2580     if pcnt = ? then pcnt = 0.
     2581     DISPLAY stream PrnLibStream
     2582     sym1 date_temp-serv.fact-date @ temp-serv.fact-date
     2583     sym11
     2584     sym9
     2585     sym10
     2586     sym2
     2587     date_temp-serv.fact-qnty @ temp-serv.fact-qnty
     2588     sym3
     2589     date_temp-serv.tot-doc @ temp-serv.tot-doc
     2590     sym4
     2591     date_temp-serv.discnt @ temp-serv.discnt
     2592     sym8 pcnt    when pcnt <> 0
     2593     sym5 date_temp-serv.netto @ temp-serv.netto
     2594     sym6
     2595     date_temp-serv.num-chk @ temp-serv.num-chk
     2596     sym7    with FRAME goodsdaterep.
     2597     .
     2598     DOWN stream PrnLibStream 1  with FRAME goodsdaterep.
     2599     if can-find(first gds_temp-serv where
     2600                       gds_temp-serv.fact-date = date_temp-serv.fact-date
     2601                   and gds_temp-serv.obj-type = ''
     2602                   and gds_temp-serv.obj-code = 0
     2603                   and gds_temp-serv.gds-code > 0) then do:
     2604       for each gds_temp-serv where
     2605               gds_temp-serv.fact-date = date_temp-serv.fact-date
     2606           and gds_temp-serv.obj-type = ''
     2607           and gds_temp-serv.obj-code = 0
     2608           and gds_temp-serv.gds-code > 0:
     2609         find first buf_goods no-lock where
     2610                   buf_goods.gds-code = gds_temp-serv.gds-code no-error.
     2611         DISPLAY stream PrnLibStream
     2612         sym1
     2613         sym11
     2614         sym2
     2615         sym9 gds_temp-serv.gds-code @ temp-serv.gds-code
     2616         sym10 (if available buf_goods then buf_goods.gds-name else '') @ v-gds-name
     2617         gds_temp-serv.fact-qnty @ temp-serv.fact-qnty
     2618         sym3
     2619         gds_temp-serv.tot-doc @ temp-serv.tot-doc
     2620         sym4
     2621         gds_temp-serv.discnt @ temp-serv.discnt
     2622         sym8 pcnt    when pcnt <> 0
     2623         sym5 gds_temp-serv.netto @ temp-serv.netto
     2624         sym6
     2625         sym7    with FRAME goodsdaterep.
     2626         .
     2627         DOWN stream PrnLibStream 1  with FRAME goodsdaterep.
     2628       end.
     2629       UNDERLINE stream PrnLibStream
     2630       temp-serv.fact-date
     2631       temp-serv.obj-code
     2632       temp-serv.gds-code
     2633       v-gds-name
     2634       temp-serv.fact-qnty
     2635       temp-serv.tot-doc
     2636       temp-serv.discnt
     2637       pcnt
     2638       temp-serv.netto
     2639       temp-serv.num-chk
     2640       with FRAME GoodsdateRep
     2641       .
     2642     end.
     2643     if last( date_temp-serv.fact-date ) then do:
     2644       if can-find(first gdstot_temp-serv where
     2645                         gdstot_temp-serv.fact-date = 01/01/1990
     2646                     and gdstot_temp-serv.obj-type = ''
     2647                     and gdstot_temp-serv.obj-code = 0
     2648                     and gdstot_temp-serv.gds-code > 0) then do:
     2649         for each gdstot_temp-serv where
     2650                 gdstot_temp-serv.fact-date = 01/01/1990
     2651             and gdstot_temp-serv.obj-type = ''
     2652             and gdstot_temp-serv.obj-code = 0
     2653             and gdstot_temp-serv.gds-code > 0 :
     2654           pcnt = round( gdstot_temp-serv.discnt / gdstot_temp-serv.tot-doc * 100, 1 ) .
     2655           if pcnt = ? then pcnt = 0.
     2656           find first buf_goods no-lock where
     2657                     buf_goods.gds-code = gdstot_temp-serv.gds-code no-error.
     2658           DISPLAY stream PrnLibStream
     2659           sym1 "по услуге" @ temp-serv.fact-date
     2660           sym11
     2661           sym2
     2662           sym10 gdstot_temp-serv.gds-code @ temp-serv.gds-code
     2663           sym9 (if available buf_goods then buf_goods.gds-name else '') @ v-gds-name
     2664           sym3 gdstot_temp-serv.fact-qnty @ temp-serv.fact-qnty
     2665           sym4 gdstot_temp-serv.tot-doc @ temp-serv.tot-doc
     2666           sym5 gdstot_temp-serv.discnt @ temp-serv.discnt
     2667           sym6 pcnt    when pcnt <> 0
     2668           sym7 gdstot_temp-serv.netto @ temp-serv.netto
     2669           sym8
     2670           with FRAME GoodsDateRep
     2671           .
     2672           DOWN stream PrnLibStream 1  with FRAME GoodsdateRep.
     2673         end.
     2674         UNDERLINE stream PrnLibStream
     2675         temp-serv.fact-date
     2676         temp-serv.obj-code
     2677         temp-serv.gds-code
     2678         v-gds-name
     2679         temp-serv.fact-qnty
     2680         temp-serv.tot-doc
     2681         temp-serv.discnt
     2682         pcnt
     2683         temp-serv.netto
     2684         temp-serv.num-chk
     2685         with FRAME GoodsdateRep
     2686         .
     2687       end.
     2688       if num-objs > 1 then do:
     2689         UNDERLINE stream PrnLibStream
     2690         temp-serv.obj-code
     2691         temp-serv.fact-date
     2692         temp-serv.gds-code
     2693         v-gds-name
     2694         temp-serv.fact-qnty
     2695         temp-serv.tot-doc
     2696         temp-serv.discnt
     2697         pcnt
     2698         temp-serv.netto
     2699         temp-serv.num-chk
     2700         with FRAME goodsdaterep
     2701         .
     2702         for each obj_temp-serv where
     2703                 obj_temp-serv.fact-date = 01/01/1990
     2704               and obj_temp-serv.obj-type > ''
     2705               and obj_temp-serv.gds-code = 0
     2706         by obj_temp-serv.obj-type
     2707         by obj_temp-serv.obj-code:
     2708           pcnt = round( obj_temp-serv.discnt / obj_temp-serv.tot-doc * 100, 1 ) .
     2709           if pcnt = ? then pcnt = 0.
     2710           DISPLAY stream PrnLibStream
     2711           sym1  "по маг" @ temp-serv.fact-date
     2712           sym9
     2713           sym10
     2714           sym11 obj_temp-serv.obj-code @ temp-serv.obj-code
     2715           sym2
     2716           sym3 obj_temp-serv.fact-qnty @ temp-serv.fact-qnty
     2717           sym4 obj_temp-serv.tot-doc @ temp-serv.tot-doc
     2718           sym5 obj_temp-serv.discnt @ temp-serv.discnt
     2719           sym6 pcnt    when pcnt <> 0
     2720           sym7 obj_temp-serv.netto @ temp-serv.netto
     2721           sym8 obj_temp-serv.num-chk @ temp-serv.num-chk
     2722           with FRAME goodsdaterep
     2723           .
     2724           DOWN stream PrnLibStream 1  with FRAME goodsdaterep. .
     2725         end.
     2726       end.
     2727       UNDERLINE stream PrnLibStream
     2728       temp-serv.obj-code
     2729       temp-serv.fact-date
     2730       temp-serv.gds-code
     2731       v-gds-name
     2732       temp-serv.fact-qnty
     2733       temp-serv.tot-doc
     2734       temp-serv.discnt
     2735       pcnt
     2736       temp-serv.netto
     2737       temp-serv.num-chk
     2738       with FRAME goodsdaterep
     2739       .
     2740       find first tot_temp-serv where
     2741                 tot_temp-serv.fact-date = 01/01/1990
     2742             and  tot_temp-serv.obj-type = ''
     2743             and  tot_temp-serv.obj-code = 0
     2744             and  tot_temp-serv.gds-code = 0
     2745             .
     2746       pcnt = round( tot_temp-serv.discnt / tot_temp-serv.tot-doc * 100, 1 ) .
     2747       if pcnt = ? then pcnt = 0.
     2748       DISPLAY stream PrnLibStream
     2749       sym1 "ИТОГО" @ temp-serv.fact-date
     2750       sym9
     2751       sym10
     2752       sym11
     2753       sym2 tot_temp-serv.fact-qnty @ temp-serv.fact-qnty
     2754       sym3 tot_temp-serv.tot-doc @ temp-serv.tot-doc
     2755       sym4 tot_temp-serv.discnt @ temp-serv.discnt
     2756       sym5 pcnt    when pcnt <> 0
     2757       sym6 tot_temp-serv.netto @ temp-serv.netto
     2758       sym7 tot_temp-serv.num-chk @ temp-serv.num-chk
     2759       sym8
     2760       with FRAME goodsdaterep
     2761       .
     2762     end.
     2763   END.
     2764   HIDE stream PrnLibStream FRAME NBottomFrame .
     2765   run waitfram-hide in this-procedure .
     2766   output stream PrnLibStream CLOSE .
     2767   run prn-lib-prn-file in this-procedure (
     2768                                             input my-handle
     2769                                             ,input 0
     2770                                             ).
     2771   END PROCEDURE.
