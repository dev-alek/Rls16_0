     2139       sym4
     2140       dateobj_temp-serv.discnt @ temp-serv.discnt
     2141       sym8 pcnt    when pcnt <> 0
     2142       sym5 dateobj_temp-serv.netto @ temp-serv.netto
     2143       sym6
     2144       dateobj_temp-serv.num-chk @ temp-serv.num-chk
     2145       sym7     with FRAME temprep.
     2146       .
     2147       DOWN stream PrnLibStream 1 with FRAME temprep.
     2148       if last(dateobj_temp-serv.fact-date) then do:
     2149         UNDERLINE stream PrnLibStream
     2150         temp-serv.obj-code
     2151         temp-serv.fact-date
     2152         temp-serv.fact-qnty
     2153         temp-serv.tot-doc
     2154         temp-serv.discnt
     2155         pcnt
     2156         temp-serv.netto
     2157         temp-serv.num-chk
     2158         with FRAME temprep
     2159         .
     2160       end.
     2161     end.
     2162     find first obj_temp-serv where
     2163             obj_temp-serv.gds-code = 0
     2164           and obj_temp-serv.fact-date = 01/01/1990
     2165           and obj_temp-serv.obj-type = obj-list.obj-type
     2166           and obj_temp-serv.obj-code = obj-list.obj-code no-error.
     2167     if not available obj_temp-serv then do:
     2168      create obj_temp-serv.
     2169      assign
     2170      obj_temp-serv.gds-code = 0
     2171      obj_temp-serv.fact-date = 01/01/1990
     2172      obj_temp-serv.obj-type = obj-list.obj-type
     2173      obj_temp-serv.obj-code = obj-list.obj-code
     2174      .
     2175     end.
     2176     pcnt = round( obj_temp-serv.discnt / obj_temp-serv.tot-doc * 100, 1 ) .
     2177     if pcnt = ? then pcnt = 0.
     2178     DISPLAY stream PrnLibStream
     2179     sym1 "по маг" @ temp-serv.fact-date
     2180     sym11 obj_temp-serv.obj-code @ temp-serv.obj-code
     2181     sym2
     2182     sym3 obj_temp-serv.fact-qnty @ temp-serv.fact-qnty
     2183     sym4 obj_temp-serv.tot-doc @ temp-serv.tot-doc
     2184     sym5 obj_temp-serv.discnt @ temp-serv.discnt
     2185     sym6 pcnt    when pcnt <> 0
     2186     sym7 obj_temp-serv.netto @ temp-serv.netto
     2187     sym8 obj_temp-serv.num-chk @ temp-serv.num-chk
     2188     with FRAME temprep
     2189     .
