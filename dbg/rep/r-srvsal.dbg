      377   procedure create_obj-list :
      378      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      379      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      380      do
      381      on error undo, return error return-value
      382      :
      383         define buffer cli-obj for ub.clients .
      384         define variable p-var as integer no-undo .
      385         define buffer buf_obj-list for obj-list .
      386         find last buf_obj-list  use-index pi no-error .
      387         if available buf_obj-list
      388         then
      389            p-var = buf_obj-list.obj-id + 1.
      390         else
      391            p-var = 1.
      392         find first cli-obj where
      393                   cli-obj.obj-type = p-obj-type
      394               and cli-obj.obj-code = p-obj-code
      395         no-lock no-error.
      396         if available cli-obj
      397         then do:
      398            create buf_obj-list.
      399            assign
      400               buf_obj-list.obj-id   = p-var
      401               buf_obj-list.obj-code = cli-obj.obj-code
      402               buf_obj-list.obj-type = cli-obj.obj-type
      403               buf_obj-list.obj-name = cli-obj.obj-name
      404               buf_obj-list.db-num   = cli-obj.db-num
      405            .
      406         end.
      407      end.
      408   end.
