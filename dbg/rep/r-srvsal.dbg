     2245   "РЕАЛИЗАЦИЯ  УСЛУГ  " str1 format "x(110)" SKIP(1).
     2246   put stream prnlibstream unformatted str2 skip(0).
     2247   PUT stream PrnLibStream SPACE(30) "По объектам :"
     2248               format "X(198)" SKIP(1).
     2249   FOR EACH obj-list :
     2250           FIND cli-obj WHERE cli-obj.obj-type = obj-list.obj-type AND
     2251                                             cli-obj.obj-code = obj-list.obj-code NO-LOCK .
     2252           PUT stream PrnLibStream SPACE(30) cli-obj.obj-name format "X(100)" SKIP.
     2253   END.
     2254   Put stream Prnlibstream unformatted p-report-header skip.
     2255   PUT stream PrnLibStream " " SKIP(1) .
     2256   FOR each gdstot_temp-serv where
     2257           gdstot_temp-serv.fact-date = 01/01/1990
     2258       and gdstot_temp-serv.obj-type = ''
     2259       and gdstot_temp-serv.obj-code = 0
     2260       and gdstot_temp-serv.gds-code > 0
     2261   break
     2262   by gdstot_temp-serv.gds-code
     2263   with FRAME GoodsRep
     2264   :
     2265     pcnt = round(  gdstot_temp-serv.discnt /  gdstot_temp-serv.tot-doc * 100, 1 ) .
     2266     if pcnt = ? then pcnt = 0.
     2267     find first buf_goods no-lock where
     2268               buf_goods.gds-code = gdstot_temp-serv.gds-code no-error.
     2269     DISPLAY stream PrnLibStream
     2270     sym1 gdstot_temp-serv.gds-code @ temp-serv.gds-code
     2271     sym11
     2272     sym2
     2273     (if available buf_goods then buf_goods.gds-name else '') @ v-gds-name
     2274     sym9
     2275     gdstot_temp-serv.fact-qnty @ temp-serv.fact-qnty
     2276     sym3
     2277     gdstot_temp-serv.tot-doc @ temp-serv.tot-doc
     2278     sym4
     2279     gdstot_temp-serv.discnt @ temp-serv.discnt
     2280     sym8 pcnt    when pcnt <> 0
     2281     sym5 gdstot_temp-serv.netto @ temp-serv.netto
     2282     sym6
     2283     sym8
     2284     sym7     with FRAME GoodsRep.
     2285     .
     2286     DOWN stream PrnLibStream 1  with FRAME GoodsRep.
     2287     if last( gdstot_temp-serv.gds-code ) then do:
     2288       if num-objs > 1 then do:
     2289         UNDERLINE stream PrnLibStream
     2290         temp-serv.obj-code
     2291         temp-serv.gds-code
     2292         v-gds-name
     2293         temp-serv.fact-qnty
     2294         temp-serv.tot-doc
     2295         temp-serv.discnt
     2296         pcnt
     2297         temp-serv.netto
     2298         temp-serv.num-chk
     2299         with FRAME GoodsRep
     2300         .
     2301         for each obj_temp-serv where
     2302                 obj_temp-serv.fact-date = 01/01/1990
     2303               and obj_temp-serv.obj-type > ''
     2304               and obj_temp-serv.gds-code = 0
     2305         by obj_temp-serv.obj-type
     2306         by obj_temp-serv.obj-code:
     2307           pcnt = round( obj_temp-serv.discnt / obj_temp-serv.tot-doc * 100, 1 ) .
     2308           if pcnt = ? then pcnt = 0.
     2309           DISPLAY stream PrnLibStream
     2310           sym1 "по маг" @ temp-serv.gds-code
     2311           sym11 obj_temp-serv.obj-code @ temp-serv.obj-code
     2312           sym2
     2313           sym9
     2314           sym3 obj_temp-serv.fact-qnty @ temp-serv.fact-qnty
     2315           sym4 obj_temp-serv.tot-doc @ temp-serv.tot-doc
     2316           sym5 obj_temp-serv.discnt @ temp-serv.discnt
     2317           sym6 pcnt    when pcnt <> 0
     2318           sym7 obj_temp-serv.netto @ temp-serv.netto
     2319           sym8 obj_temp-serv.num-chk @ temp-serv.num-chk
     2320           with FRAME GoodsRep
     2321           .
     2322           DOWN stream PrnLibStream 1  with FRAME GoodsRep.
     2323         end.
     2324       end.
     2325       UNDERLINE stream PrnLibStream
     2326       temp-serv.obj-code
     2327       temp-serv.gds-code
     2328       v-gds-name
     2329       temp-serv.fact-qnty
     2330       temp-serv.tot-doc
     2331       temp-serv.discnt
     2332       pcnt
     2333       temp-serv.netto
     2334       temp-serv.num-chk
     2335       with FRAME GoodsRep
     2336       .
     2337       find first tot_temp-serv where
     2338                 tot_temp-serv.fact-date = 01/01/1990
     2339             and  tot_temp-serv.obj-type = ''
     2340             and  tot_temp-serv.obj-code = 0
     2341             and  tot_temp-serv.gds-code = 0
     2342             .
     2343       pcnt = round( tot_temp-serv.discnt / tot_temp-serv.tot-doc * 100, 1 ) .
     2344       if pcnt = ? then pcnt = 0.
     2345       DISPLAY stream PrnLibStream
     2346       sym1  "ИТОГО" @ temp-serv.gds-code
     2347       sym11
     2348       sym9
     2349       sym2 tot_temp-serv.fact-qnty @ temp-serv.fact-qnty
     2350       sym3 tot_temp-serv.tot-doc @ temp-serv.tot-doc
     2351       sym4 tot_temp-serv.discnt @ temp-serv.discnt
     2352       sym5 pcnt    when pcnt <> 0
     2353       sym6 tot_temp-serv.netto @ temp-serv.netto
     2354       sym7 tot_temp-serv.num-chk @ temp-serv.num-chk
     2355       sym8
     2356       with FRAME GoodsRep
     2357       .
     2358     end.
     2359   END.
