     2890      assign
     2891      obj_temp-serv.gds-code = 0
     2892      obj_temp-serv.fact-date = 01/01/1990
     2893      obj_temp-serv.obj-type = obj-list.obj-type
     2894      obj_temp-serv.obj-code = obj-list.obj-code
     2895      .
     2896     end.
     2897     pcnt = round( obj_temp-serv.discnt / obj_temp-serv.tot-doc * 100, 1 ) .
     2898     if pcnt = ? then pcnt = 0.
     2899     DISPLAY stream PrnLibStream
     2900     sym1
     2901     sym9
     2902     sym10
     2903     sym11 obj_temp-serv.obj-code @ temp-serv.obj-code
     2904     sym2
     2905     sym3 obj_temp-serv.fact-qnty @ temp-serv.fact-qnty
     2906     sym4 obj_temp-serv.tot-doc @ temp-serv.tot-doc
     2907     sym5 obj_temp-serv.discnt @ temp-serv.discnt
     2908     sym6 pcnt    when pcnt <> 0
     2909     sym7 obj_temp-serv.netto @ temp-serv.netto
     2910     sym8 obj_temp-serv.num-chk @ temp-serv.num-chk
     2911     with FRAME goodsdaterep
     2912     .
     2913     DOWN stream PrnLibStream 1  with FRAME goodsdaterep. .
     2914     UNDERLINE stream PrnLibStream
     2915     temp-serv.obj-code
     2916     temp-serv.gds-code
     2917     v-gds-name
     2918     temp-serv.fact-date
     2919     temp-serv.fact-qnty
     2920     temp-serv.tot-doc
     2921     temp-serv.discnt
     2922     pcnt
     2923     temp-serv.netto
     2924     temp-serv.num-chk
     2925     with FRAME goodsdaterep
     2926     .
     2927   END.
     2928   if can-find(first gdstot_temp-serv where
     2929                     gdstot_temp-serv.fact-date = 01/01/1990
     2930                 and gdstot_temp-serv.obj-type = ''
     2931                 and gdstot_temp-serv.obj-code = 0
     2932                 and gdstot_temp-serv.gds-code > 0) then do:
     2933     for each gdstot_temp-serv where
     2934             gdstot_temp-serv.fact-date = 01/01/1990
     2935         and gdstot_temp-serv.obj-type = ''
     2936         and gdstot_temp-serv.obj-code = 0
     2937         and gdstot_temp-serv.gds-code > 0 :
     2938       pcnt = round( gdstot_temp-serv.discnt / gdstot_temp-serv.tot-doc * 100, 1 ) .
     2939       if pcnt = ? then pcnt = 0.
     2940       find first buf_goods no-lock where
     2941                 buf_goods.gds-code = gdstot_temp-serv.gds-code no-error.
     2942       DISPLAY stream PrnLibStream
     2943       sym1 "по услуге" @ temp-serv.fact-date
     2944       sym9
     2945       sym10
     2946       sym11
     2947       sym2
     2948       sym10 gdstot_temp-serv.gds-code @ temp-serv.gds-code
     2949       sym9 (if available buf_goods then buf_goods.gds-name else '') @ v-gds-name
     2950       sym3 gdstot_temp-serv.fact-qnty @ temp-serv.fact-qnty
     2951       sym4 gdstot_temp-serv.tot-doc @ temp-serv.tot-doc
     2952       sym5 gdstot_temp-serv.discnt @ temp-serv.discnt
     2953       sym6 pcnt    when pcnt <> 0
     2954       sym7 gdstot_temp-serv.netto @ temp-serv.netto
     2955       sym8
     2956       with FRAME GoodsdateRep
     2957       .
     2958       DOWN stream PrnLibStream 1  with FRAME GoodsdateRep.
     2959     end.
     2960     UNDERLINE stream PrnLibStream
     2961     temp-serv.fact-date
     2962     temp-serv.obj-code
     2963     temp-serv.gds-code
     2964     v-gds-name
     2965     temp-serv.fact-qnty
     2966     temp-serv.tot-doc
     2967     temp-serv.discnt
     2968     pcnt
     2969     temp-serv.netto
     2970     temp-serv.num-chk
     2971     with FRAME GoodsdateRep
     2972     .
     2973   end.
     2974   find first tot_temp-serv where
     2975             tot_temp-serv.fact-date = 01/01/1990
     2976         and  tot_temp-serv.obj-type = ''
     2977         and  tot_temp-serv.obj-code = 0
     2978         and  tot_temp-serv.gds-code = 0
     2979         .
     2980   pcnt = round( tot_temp-serv.discnt / tot_temp-serv.tot-doc * 100, 1 ) .
     2981   if pcnt = ? then pcnt = 0.
     2982   DISPLAY stream PrnLibStream
     2983   sym1 "ИТОГО" @ temp-serv.fact-date
     2984   sym11
     2985   sym9
     2986   sym10
     2987   sym2 tot_temp-serv.fact-qnty @ temp-serv.fact-qnty
     2988   sym3 tot_temp-serv.tot-doc @ temp-serv.tot-doc
     2989   sym4 tot_temp-serv.discnt @ temp-serv.discnt
     2990   sym5 pcnt    when pcnt <> 0
     2991   sym6 tot_temp-serv.netto @ temp-serv.netto
     2992   sym7 tot_temp-serv.num-chk @ temp-serv.num-chk
     2993   sym8
     2994   with FRAME goodsdaterep
     2995   .
     2996   HIDE stream PrnLibStream FRAME NBottomFrame .
     2997   run waitfram-hide in this-procedure .
     2998   output stream PrnLibStream CLOSE .
     2999   run prn-lib-prn-file in this-procedure (
     3000                                             input my-handle
     3001                                             ,input 0
     3002                                             ).
     3003   END PROCEDURE.
