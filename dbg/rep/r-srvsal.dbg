     1103   procedure prn-lib-open-stream :
     1104     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1105     define input parameter p-page-size    as integer no-undo .
     1106     define input parameter p-is-stream    as logical no-undo .
     1107     define input parameter p-append       as logical no-undo .
     1108     define variable v-report-name as character no-undo .
     1109     do
     1110       on error undo, return error
     1111       :
     1112       run prn-lib-get-report-name  in this-procedure (
     1113         input parParentProc
     1114         ,output v-report-name
     1115         ).
     1116       if p-is-stream then
     1117       do:
     1118         if p-append then
     1119         do:
     1120           output stream PrnLibStream to value( v-report-name )
     1121             page-size value(p-page-size) append .
     1122         end.
     1123         if not p-append then
     1124         do:
     1125           output stream PrnLibStream to value( v-report-name )
     1126             page-size value(p-page-size) .
     1127         end.
     1128       end.
     1129       if not p-is-stream then
     1130       do:
     1131         if p-append then
     1132         do:
     1133           output to value( v-report-name )
     1134             page-size value(p-page-size) append .
     1135         end.
     1136         if not p-append then
     1137         do:
     1138           output to value( v-report-name )
     1139             page-size value(p-page-size) .
     1140         end.
     1141       end.
     1142     end.
     1143   end procedure.
     1144   procedure prn-lib-open-exp :
     1145     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1146     define input parameter p-is-stream    as logical no-undo .
     1147     define input parameter p-is-append    as logical no-undo .
     1148     define output parameter p-ReportFileName as char init "report" no-undo.
     1149     define output parameter p-process as logical no-undo .
     1150     define variable glog as logical no-undo .
     1151     do
     1152       on error undo, return error
     1153       :
     1154       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1155         TITLE      "Укажите путь"
     1156         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1157         ASK-OVERWRITE
     1158         CREATE-TEST-FILE
     1159         SAVE-AS
     1160         USE-FILENAME
     1161         DEFAULT-EXTENSION "txt"
     1162         UPDATE glog
     1163         .
     1164       if not glog then  return.
     1165       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1166       if p-is-stream then
     1167       do:
     1168         if p-is-append then
     1169         do:
     1170           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1171         end.
     1172         else
     1173         do:
     1174           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1175         end.
     1176       end.
     1177       else
     1178       do:
     1179         if p-is-append then
     1180         do:
     1181           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1182         end.
     1183         else
     1184         do:
     1185           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1186         end.
     1187       end.
     1188       p-process = yes.
     1189     end.
     1190   end procedure.
