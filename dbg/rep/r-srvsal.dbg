     1215       input "get":U
     1216       ,input  ""
     1217       ,input  0
     1218       ,input  'report-glob':U
     1219       ,input  'rep-excel':U
     1220       ,output v-value-character
     1221       ,output v-value-date
     1222       ,output v-value-decimal
     1223       ,output v-value-integer
     1224       ,output rep-excel
     1225       ,output v-param-type
     1226       ,INPUT-OUTPUT table-handle v-tth
     1227       )  .
     1228     if rep-excel then v-excel = "TRUE" .
