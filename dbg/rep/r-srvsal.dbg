     2435     with FRAME GoodsRep
     2436     .
     2437     find first obj_temp-serv where
     2438             obj_temp-serv.fact-date = 01/01/1990
     2439           and obj_temp-serv.obj-type = obj-list.obj-type
     2440           and obj_temp-serv.obj-code = obj-list.obj-code
     2441           and obj_temp-serv.gds-code = 0 no-error.
     2442     if not available obj_temp-serv then do:
     2443       create obj_temp-serv.
     2444       assign
     2445       obj_temp-serv.fact-date = 01/01/1990
     2446       obj_temp-serv.obj-type = obj-list.obj-type
     2447       obj_temp-serv.obj-code = obj-list.obj-code
