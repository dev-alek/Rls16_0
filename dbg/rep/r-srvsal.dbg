     1480   PROCEDURE no-benq.
     1481   DEFINE OUTPUT PARAMETER found as logical init no.
     1482   define buffer buf_chk-doc for ub.chk-doc.
     1483   FOR EACH obj-list WHERE
     1484           obj-list.obj-type = 'маг':U NO-LOCK :
     1485     CASE X-Radio-Task > 1 :
     1486       WHEN YES THEN DO:
     1487         FOR EACH buf_chk-doc NO-LOCK WHERE
     1488                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1489                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1490                 (
     1491                   buf_chk-doc.shift-date >= X-date-start AND
     1492                   buf_chk-doc.shift-date <= X-date-end)
     1493                   AND
     1494                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1495           IF X-Radio-Task = 3 AND
     1496           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     1497             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     1498           IF X-Radio-Task = 4 AND
     1499           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1500           found = yes.
     1501           return.
     1502         END.
     1503       END.
     1504       WHEN NO THEN DO:
     1505         FOR EACH buf_chk-doc NO-LOCK WHERE
     1506               buf_chk-doc.obj-type = obj-list.obj-type AND
     1507               buf_chk-doc.obj-code = obj-list.obj-code AND
     1508               buf_chk-doc.chk-date >= X-date-start AND
     1509               buf_chk-doc.chk-date <= X-date-end   AND
     1510               (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1511           found = yes.
     1512           return.
     1513         END.
     1514        END.
     1515      END CASE.
     1516    END.
     1517   END PROCEDURE.
     1518   PROCEDURE no-benqi.
     1519   DEFINE OUTPUT PARAMETER found as logical init no.
     1520   define buffer buf_chk-doc for ub.chk-doc.
     1521   define buffer buf_inkas for ub.inkas.
     1522   FOR EACH obj-list WHERE
     1523         obj-list.obj-type = 'маг':U NO-LOCK :
     1524     CASE X-Radio-Task > 1 :
     1525       WHEN YES THEN DO:
     1526         FOR EACH buf_chk-doc No-LOCK WHERE
     1527                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1528                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1529                 (
     1530                   buf_chk-doc.shift-date >= X-date-start AND
     1531                   buf_chk-doc.shift-date <= X-date-end)
     1532                   AND
     1533                   buf_Chk-doc.out-code = ? AND
     1534                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1535           IF X-Radio-Task = 3 AND
     1536           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     1537             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     1538           IF X-Radio-Task = 4 AND
     1539           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1540           found = yes.
     1541           return.
     1542         END.
     1543         FOR EACH buf_inkas No-LOCK WHERE
     1544                   buf_inkas.obj-type = obj-list.obj-type AND
     1545                   buf_inkas.obj-code = obj-list.obj-code AND
     1546                   (
     1547                   buf_inkas.shift-date >= X-date-start AND
     1548                   buf_inkas.shift-date <= X-date-end):
     1549           if buf_inkas.status_ = 'факт':U
     1550           or buf_inkas.status_ = 'запрос':U then next.
     1551           IF X-Radio-Task = 3 AND
     1552           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
     1553             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
     1554           IF X-Radio-Task = 4 AND
     1555           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
     1556           found = yes.
     1557           return.
     1558         END.
     1559       END.
     1560       WHEN NO THEN DO:
     1561         FOR EACH buf_chk-doc NO-LOCK WHERE
     1562                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1563                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1564                 buf_chk-doc.chk-date >= X-date-start AND
     1565                 buf_chk-doc.chk-date <= X-date-end   AND
     1566                 buf_Chk-doc.out-code = ? AND
     1567                 (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1568           found = yes.
     1569           return.
     1570         END.
     1571         FOR EACH buf_inkas NO-LOCK WHERE
     1572                 buf_inkas.obj-type = obj-list.obj-type AND
     1573                 buf_inkas.obj-code = obj-list.obj-code AND
     1574                 buf_inkas.doc-date >= X-date-start AND
     1575                 buf_inkas.doc-date <= X-date-end :
     1576           if buf_inkas.status_ = 'факт':U
     1577           or buf_inkas.status_ = 'запрос':U then next.
     1578           found = yes.
     1579           return.
     1580         END.
     1581       END.
     1582     END CASE.
     1583   END.
     1584   END PROCEDURE.
     1585   PROCEDURE no-benq-i.
     1586   DEFINE OUTPUT PARAMETER found as logical init no.
     1587   define buffer buf_inkas for ub.inkas.
     1588   CASE X-Radio-Task > 1:
     1589     WHEN YES then do:
     1590       FOR EACH obj-list WHERE
     1591               obj-list.obj-type = 'маг':U NO-LOCK :
     1592         FOR EACH buf_inkas NO-LOCK WHERE
     1593                 buf_inkas.obj-type = obj-list.obj-type AND
     1594                 buf_inkas.obj-code = obj-list.obj-code AND
     1595                 buf_inkas.status_ = 'факт':U AND
     1596                 (
     1597                 buf_inkas.shift-date >= X-date-start AND
     1598                 buf_inkas.shift-date <= X-date-end):
     1599           IF X-Radio-Task = 3 AND
     1600           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
     1601             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
     1602           IF X-Radio-Task = 4 AND
     1603           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
     1604           found = yes.
     1605           return.
     1606         END.
     1607     END.
     1608     END.
     1609     WHEN NO THEN DO:
     1610       FOR EACH obj-list WHERE
     1611               obj-list.obj-type = 'маг':U NO-LOCK :
     1612         FOR EACH buf_inkas NO-LOCK WHERE
     1613                 buf_inkas.obj-type = obj-list.obj-type AND
     1614                 buf_inkas.obj-code = obj-list.obj-code AND
     1615                 buf_inkas.status_ = 'факт':U AND
     1616                 buf_inkas.doc-date >= X-date-start AND
     1617                 buf_inkas.doc-date <= X-date-end :
     1618            found = yes.
     1619            return.
     1620         END.
     1621       END.
     1622     END.
     1623   END CASE.
     1624   END PROCEDURE.
     1625   PROCEDURE no-benq-i-office.
     1626   DEFINE OUTPUT PARAMETER found as logical init no.
     1627   define buffer buf_sale-doc for ub.sale-doc.
     1628   CASE X-Radio-Task > 1:
     1629     WHEN YES then do:
     1630       FOR EACH obj-list WHERE
     1631               obj-list.obj-type = 'маг':U NO-LOCK :
     1632         FOR EACH buf_sale-doc NO-LOCK WHERE
     1633                  buf_Sale-doc.obj-type = obj-list.obj-type
     1634              AND buf_sale-doc.obj-code = obj-list.obj-code
     1635              AND buf_sale-doc.status_ = 'факт':U
     1636              AND buf_sale-doc.chr-office = 'у':U
     1637              AND (
     1638                 buf_sale-doc.shift-date >= X-date-start
     1639                 AND
     1640                 buf_sale-doc.shift-date <= X-date-end):
     1641           IF X-Radio-Task = 3 AND
     1642           ((buf_sale-doc.shift-date = X-date-start AND buf_sale-doc.shift-num < X-shift-Start) OR
     1643             (buf_sale-doc.shift-date = X-date-end AND  buf_sale-doc.shift-num > X-shift-End) ) THEN NEXT.
     1644           IF X-Radio-Task = 4 AND
     1645           (buf_sale-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1646           found = yes.
     1647           return.
     1648         END.
     1649       END.
     1650     END.
     1651     WHEN NO THEN DO:
     1652       FOR EACH obj-list WHERE
     1653               obj-list.obj-type = 'маг':U NO-LOCK :
     1654         FOR EACH buf_sale-doc NO-LOCK WHERE
     1655                 buf_sale-doc.obj-type = obj-list.obj-type
     1656            AND  buf_sale-doc.obj-code = obj-list.obj-code
     1657            AND  buf_sale-doc.status_ = 'факт':U
     1658            AND  buf_sale-doc.chr-office = 'у':U
     1659            AND  buf_sale-doc.doc-date >= X-date-start
     1660            AND  buf_sale-doc.doc-date <= X-date-end :
     1661           found = yes.
     1662           return.
     1663         END.
     1664       END.
     1665     END.
     1666   END CASE.
     1667   END PROCEDURE.
     1668   assign
     1669       date_string = cur-time-print()
     1670       Line = fill( "-", 250 ).
     1671   run no-benq-i-office in this-procedure ( output found).
     1672   if not found then do:
     1673     run waitfram-hide in this-procedure .
     1674     message "Не было никакой реализации услуг на выбранных объектах в течение заданного Вами периода времени." view-as alert-box information .
     1675     return.
     1676   end.
     1677   run waitfram-show in this-procedure ('Подождите ...' ) .
     1678   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1679   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1680     (output v-curr-r-b
     1681     )  .
     1682   v-curr-r-b = 'base':U.
     1683   for each temp-serv:
     1684     delete temp-serv.
     1685   end.
     1686   create tot_temp-serv.
     1687   assign
     1688   tot_temp-serv.gds-code = 0
     1689   tot_temp-serv.fact-date = 01/01/1990
     1690   tot_temp-serv.obj-type  = ''
     1691   tot_temp-serv.obj-code  = 0
     1692   .
     1693   FOR EACH obj-list ,
     1694     each buf_Sale-doc no-lock where
     1695        buf_sale-doc.obj-type = obj-list.obj-type
     1696    and buf_sale-doc.obj-code = obj-list.obj-code
     1697    and buf_sale-doc.chr-office = 'у':U
     1698    and buf_sale-doc.status_ = 'факт':U
     1699    and buf_sale-doc.doc-date >= X-date-start
     1700    and buf_sale-doc.doc-date <= X-date-end
     1701    ,
     1702     first buf_trn-doc no-lock WHERE
     1703       buf_trn-doc.doc-code = buf_sale-doc.doc-code
     1704     BREAK
     1705     BY  buf_trn-doc.obj-type
     1706     BY  buf_trn-doc.obj-code
     1707     BY  buf_trn-doc.status_
     1708     BY  buf_trn-doc.fact-date
     1709      :
     1710     if first-of(buf_trn-doc.fact-date) then do:
     1711       if p-tot-objects
     1712       and (p-rs-by = 0 or p-rs-by = 2)
     1713       then do:
     1714         find first dateobj_temp-serv where
     1715                   dateobj_temp-serv.gds-code = 0
     1716               and dateobj_temp-serv.fact-date = buf_trn-doc.fact-date
     1717               and dateobj_temp-serv.obj-type  = buf_trn-doc.obj-type
     1718               and dateobj_temp-serv.obj-code  = buf_trn-doc.obj-code no-error.
     1719         if not available dateobj_temp-serv then do:
     1720           create dateobj_temp-serv.
     1721           assign
     1722           dateobj_temp-serv.gds-code = 0
     1723           dateobj_temp-serv.fact-date = buf_trn-doc.fact-date
     1724           dateobj_temp-serv.obj-type  = buf_trn-doc.obj-type
     1725           dateobj_temp-serv.obj-code  = buf_trn-doc.obj-code
     1726           .
     1727         end.
     1728       end.
     1729       if not p-tot-objects
     1730       and (p-rs-by = 0 or p-rs-by = 2)
     1731       then do:
     1732         find first date_temp-serv where
     1733                   date_temp-serv.gds-code = 0
     1734               and date_temp-serv.fact-date = buf_trn-doc.fact-date
     1735               and date_temp-serv.obj-type  = ''
     1736               and date_temp-serv.obj-code  = 0 no-error.
     1737         if not available date_temp-serv then do:
     1738           create date_temp-serv.
     1739           assign
     1740           date_temp-serv.gds-code = 0
     1741           date_temp-serv.fact-date = buf_trn-doc.fact-date
     1742           date_temp-serv.obj-type  = ''
     1743           date_temp-serv.obj-code  = 0
     1744           .
     1745         end.
     1746       end.
     1747     end.
     1748     if first-of(buf_trn-doc.obj-code) then do:
     1749       find first obj_temp-serv where
     1750                 obj_temp-serv.gds-code = 0
     1751             and obj_temp-serv.fact-date = 01/01/1990
     1752             and obj_temp-serv.obj-type  = buf_trn-doc.obj-type
     1753             and obj_temp-serv.obj-code  = buf_trn-doc.obj-code no-error.
     1754       if not available obj_temp-serv then do:
     1755         create obj_temp-serv.
     1756         assign
     1757         obj_temp-serv.gds-code = 0
     1758         obj_temp-serv.fact-date = 01/01/1990
     1759         obj_temp-serv.obj-type  = buf_trn-doc.obj-type
     1760         obj_temp-serv.obj-code  = buf_trn-doc.obj-code
     1761         .
     1762       end.
     1763     end.
     1764     if p-tot-objects
     1765     and (p-rs-by = 0 or p-rs-by = 2)
     1766     then do:
     1767       assign
     1768       dateobj_temp-serv.tot-doc   = dateobj_temp-serv.tot-doc + buf_trn-doc.tot-doc * buf_sale-doc.dir
     1769       dateobj_temp-serv.netto     = dateobj_temp-serv.netto   +
     1770                             (if v-curr-r-b = 'rubl':U
     1771                             then buf_trn-doc.tot-sale - buf_trn-doc.discnt-rubl
     1772                             else buf_trn-doc.tot-fact - buf_trn-doc.tot-calc) * buf_sale-doc.dir
     1773       dateobj_temp-serv.discnt    = dateobj_temp-serv.tot-doc - dateobj_temp-serv.netto
     1774       dateobj_temp-serv.num-chk   = dateobj_temp-serv.num-chk + buf_sale-doc.chk-amount
     1775       dateobj_temp-serv.fact-qnty = dateobj_temp-serv.fact-qnty + buf_sale-doc.fact-qnty
     1776       .
     1777     end.
     1778     if not p-tot-objects
     1779     and (p-rs-by = 0 or p-rs-by = 2)
     1780     then do:
     1781       assign
     1782       date_temp-serv.tot-doc   = date_temp-serv.tot-doc + buf_trn-doc.tot-doc * buf_sale-doc.dir
     1783       date_temp-serv.netto     = date_temp-serv.netto   +
     1784                             (if v-curr-r-b = 'rubl':U
     1785                             then buf_trn-doc.tot-sale - buf_trn-doc.discnt-rubl
     1786                             else buf_trn-doc.tot-fact - buf_trn-doc.tot-calc) * buf_sale-doc.dir
     1787       date_temp-serv.discnt    = date_temp-serv.tot-doc - date_temp-serv.netto
     1788       date_temp-serv.num-chk   = date_temp-serv.num-chk + buf_sale-doc.chk-amount
     1789       date_temp-serv.fact-qnty = date_temp-serv.fact-qnty + buf_sale-doc.fact-qnty
     1790       .
     1791     end.
     1792     assign
     1793     obj_temp-serv.tot-doc   = obj_temp-serv.tot-doc + buf_trn-doc.tot-doc * buf_sale-doc.dir
     1794     obj_temp-serv.netto     = obj_temp-serv.netto   +
     1795                           (if v-curr-r-b = 'rubl':U
     1796                           then buf_trn-doc.tot-sale - buf_trn-doc.discnt-rubl
     1797                           else buf_trn-doc.tot-fact - buf_trn-doc.tot-calc) * buf_sale-doc.dir
     1798     obj_temp-serv.discnt    = obj_temp-serv.tot-doc - obj_temp-serv.netto
     1799     obj_temp-serv.num-chk   = obj_temp-serv.num-chk + buf_sale-doc.chk-amount
     1800     obj_temp-serv.fact-qnty = obj_temp-serv.fact-qnty + buf_sale-doc.fact-qnty
     1801     tot_temp-serv.tot-doc   = tot_temp-serv.tot-doc + buf_trn-doc.tot-doc * buf_sale-doc.dir
     1802     tot_temp-serv.netto     = tot_temp-serv.netto   +
     1803                           (if v-curr-r-b = 'rubl':U
     1804                           then buf_trn-doc.tot-sale - buf_trn-doc.discnt-rubl
     1805                           else buf_trn-doc.tot-fact - buf_trn-doc.tot-calc) * buf_sale-doc.dir
     1806     tot_temp-serv.discnt    = tot_temp-serv.tot-doc - tot_temp-serv.netto
     1807     tot_temp-serv.num-chk   = tot_temp-serv.num-chk + buf_sale-doc.chk-amount
     1808     tot_temp-serv.fact-qnty = tot_temp-serv.fact-qnty + buf_sale-doc.fact-qnty
     1809     .
     1810     PROCESS EVENTS .
     1811     if p-rs-by > 0 then do:
     1812       _goods:
     1813       for each buf_gds-dtl no-lock where
     1814               buf_gds-dtl.doc-code = buf_trn-doc.doc-code,
     1815           first buf_goods no-lock where
     1816                 buf_goods.artic = buf_gds-dtl.artic
     1817             and buf_goods.prod-type = buf_gds-dtl.prod-type
     1818             and buf_goods.prod-code = buf_gds-dtl.prod-code:
     1819         case p-select-good :
     1820           when 3 then do:
     1821             FIND FIRST g#cli WHERE
     1822                         g#cli.obj-type = buf_goods.prod-type
     1823                     AND g#cli.obj-code = buf_goods.prod-code NO-LOCK NO-ERROR.
     1824             if not available g#cli then do:
     1825               next _goods.
     1826             end.
     1827           end.
     1828           when  4 then do:
     1829             find first gds-list where
     1830                       gds-list.gds-code = buf_goods.gds-code no-error.
     1831             if not available gds-list then do:
     1832               next _goods.
     1833             end.
     1834           end.
     1835           when 1 then do:
     1836           end.
     1837         end case.
     1838         if not p-tot-objects
     1839         then do:
     1840           if p-rs-by = 2 then do:
     1841             find first gds_temp-serv where
     1842                       gds_temp-serv.gds-code = buf_goods.gds-code
     1843                   and gds_temp-serv.fact-date = buf_trn-doc.fact-date
     1844                   and gds_temp-serv.obj-type  = ""
     1845                   and gds_temp-serv.obj-code  = 0 no-error.
     1846             if not available gds_temp-serv then do:
     1847               create gds_temp-serv.
     1848               assign
     1849               gds_temp-serv.gds-code = buf_goods.gds-code
     1850               gds_temp-serv.fact-date = buf_trn-doc.fact-date
     1851               gds_temp-serv.obj-type  = ""
     1852               gds_temp-serv.obj-code  = 0
     1853               .
     1854             end.
     1855             assign
     1856             gds_temp-serv.tot-doc   = gds_temp-serv.tot-doc + (if v-curr-r-b = 'base':U
     1857                                                               then buf_gds-dtl.price-base
     1858                                                               else buf_gds-dtl.price-rubl)
     1859                                                               * buf_gds-dtl.fact-qnty * buf_sale-doc.dir
     1860             gds_temp-serv.netto     = gds_temp-serv.netto   + (if v-curr-r-b = 'base':U
     1861                                                               then (buf_gds-dtl.price-base - buf_gds-dtl.discnt-base)
     1862                                                               else (buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl)
     1863                                                               )
     1864                                                               * buf_gds-dtl.fact-qnty * buf_sale-doc.dir
     1865             gds_temp-serv.discnt    = gds_temp-serv.tot-doc - gds_temp-serv.netto
     1866             gds_temp-serv.fact-qnty = gds_temp-serv.fact-qnty + buf_gds-dtl.fact-qnty
     1867             .
     1868           end.
     1869         end.
     1870         else do:
     1871           if p-rs-by = 1 then do:
     1872             find first gdsobj_temp-serv where
     1873                       gdsobj_temp-serv.gds-code = buf_goods.gds-code
     1874                   and gdsobj_temp-serv.fact-date = 01/01/1990
     1875                   and gdsobj_temp-serv.obj-type  = buf_trn-doc.obj-type
     1876                   and gdsobj_temp-serv.obj-code  = buf_trn-doc.obj-code no-error.
     1877             if not available gdsobj_temp-serv then do:
     1878               create gdsobj_temp-serv.
     1879               assign
     1880               gdsobj_temp-serv.gds-code = buf_goods.gds-code
     1881               gdsobj_temp-serv.fact-date = 01/01/1990
     1882               gdsobj_temp-serv.obj-type  = buf_trn-doc.obj-type
     1883               gdsobj_temp-serv.obj-code  = buf_trn-doc.obj-code
     1884               .
     1885             end.
     1886             assign
     1887             gdsobj_temp-serv.tot-doc   = gdsobj_temp-serv.tot-doc + (if v-curr-r-b = 'base':U
     1888                                                               then buf_gds-dtl.price-base
     1889                                                               else buf_gds-dtl.price-rubl)
     1890                                                               * buf_gds-dtl.fact-qnty * buf_sale-doc.dir
     1891             gdsobj_temp-serv.netto     = gdsobj_temp-serv.netto   + (if v-curr-r-b = 'base':U
     1892                                                               then (buf_gds-dtl.price-base - buf_gds-dtl.discnt-base)
     1893                                                               else (buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl)
     1894                                                               )
     1895                                                               * buf_gds-dtl.fact-qnty * buf_sale-doc.dir
     1896             gdsobj_temp-serv.discnt    = gdsobj_temp-serv.tot-doc - gdsobj_temp-serv.netto
     1897             gdsobj_temp-serv.fact-qnty = gdsobj_temp-serv.fact-qnty + buf_gds-dtl.fact-qnty
     1898             .
     1899           end.
     1900         end.
     1901         find first gdstot_temp-serv where
     1902                   gdstot_temp-serv.gds-code = buf_goods.gds-code
     1903               and gdstot_temp-serv.fact-date = 01/01/1990
     1904               and gdstot_temp-serv.obj-type  = ""
     1905               and gdstot_temp-serv.obj-code  = 0 no-error.
     1906         if not available gdstot_temp-serv then do:
     1907           create gdstot_temp-serv.
     1908           assign
     1909           gdstot_temp-serv.gds-code = buf_goods.gds-code
     1910           gdstot_temp-serv.fact-date = 01/01/1990
     1911           gdstot_temp-serv.obj-type  = ""
     1912           gdstot_temp-serv.obj-code  = 0
     1913           .
     1914         end.
     1915         assign
     1916         gdstot_temp-serv.tot-doc   = gdstot_temp-serv.tot-doc + (if v-curr-r-b = 'base':U
     1917                                                           then buf_gds-dtl.price-base
     1918                                                           else buf_gds-dtl.price-rubl)
     1919                                                           * buf_gds-dtl.fact-qnty * buf_sale-doc.dir
     1920         gdstot_temp-serv.netto     = gdstot_temp-serv.netto   + (if v-curr-r-b = 'base':U
     1921                                                           then (buf_gds-dtl.price-base - buf_gds-dtl.discnt-base)
     1922                                                           else (buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl)
     1923                                                           )
     1924                                                           * buf_gds-dtl.fact-qnty * buf_sale-doc.dir
     1925         gdstot_temp-serv.discnt    = gdstot_temp-serv.tot-doc - gdstot_temp-serv.netto
     1926         gdstot_temp-serv.fact-qnty = gdstot_temp-serv.fact-qnty + buf_gds-dtl.fact-qnty
     1927         .
     1928       end.
     1929     end.
     1930     if last-of( buf_trn-doc.fact-date ) then do:
     1931       accum-count = accum-count + 1.
     1932       if accum-count modulo 2  = 0
     1933       AND accum-count >= 2
     1934       then do:
     1935         run waitfram-show in this-procedure ( substitute("Обработано дней : &1" , accum-count)).
     1936       end.
     1937     end.
     1938     if last-of( buf_trn-doc.obj-code ) then do:
     1939       num-objs = num-objs + 1.
     1940     end.
     1941   end.
     1942   if p-rs-by = 0 then do:
     1943     if p-tot-objects then do:
     1944       Run ByTempObj in this-procedure .
     1945     end.
     1946     else do:
     1947       Run ByTemp in this-procedure .
     1948     end.
     1949   end.
     1950   if p-rs-by = 1 then do:
     1951     if p-tot-objects then do:
     1952       Run ByGoodsObj in this-procedure .
     1953     end.
     1954     else do:
     1955       Run ByGoods in this-procedure .
     1956     end.
     1957   end.
     1958   if p-rs-by = 2 then do:
     1959     if p-tot-objects then do:
     1960       Run ByGoodsDateObj in this-procedure .
     1961     end.
     1962     else do:
     1963       Run ByGoodsDate in this-procedure .
     1964     end.
     1965   end.
     1966   PROCEDURE ByTemp:
     1967   run prn-lib-open-stream  in this-procedure (
     1968                                                input my-handle
     1969                                               ,input 62
     1970                                               ,input yes
     1971                                               ,input no
     1972                                               ).
     1973   FORM HEADER
     1974   Line format "X(231)" AT 1 SKIP
     1975   "Продолжение - на следующей странице" AT 90 SKIP
     1976   with FRAME NBottomFrame width 232
     1977   PAGE-BOTTOM NO-LABELS NO-BOX .
     1978   VIEW stream PrnLibStream FRAME NBottomFrame .
     1979   PUT stream PrnLibStream SPACE(30)
     1980   "РЕАЛИЗАЦИЯ  УСЛУГ  " str1 format "x(110)" SKIP(1).
     1981   put stream prnlibstream unformatted str2 skip(0).
     1982   PUT stream PrnLibStream SPACE(30) "По объектам :"
     1983               format "X(130)" SKIP(1).
     1984   FOR EACH obj-list :
     1985           FIND cli-obj WHERE cli-obj.obj-type = obj-list.obj-type AND
     1986                                             cli-obj.obj-code = obj-list.obj-code NO-LOCK .
     1987           PUT stream PrnLibStream SPACE(30) cli-obj.obj-name format "X(100)" SKIP.
     1988   END.
     1989   Put stream Prnlibstream unformatted p-report-header skip.
     1990   PUT stream PrnLibStream " " SKIP(1) .
     1991   FOR each date_temp-serv where
     1992           date_temp-serv.gds-code = 0
     1993       and date_temp-serv.obj-type = ''
     1994       and date_temp-serv.obj-code = 0
     1995       and date_temp-serv.fact-date > 01/01/1990
     1996   break
     1997   by date_temp-serv.fact-date
     1998   with FRAME temprep
     1999   :
     2000     pcnt = round(  date_temp-serv.discnt /  date_temp-serv.tot-doc * 100, 1 ) .
     2001     if pcnt = ? then pcnt = 0.
     2002     DISPLAY stream PrnLibStream
     2003     sym1 date_temp-serv.fact-date @ temp-serv.fact-date
     2004     sym11
     2005     sym2
     2006     date_temp-serv.fact-qnty @ temp-serv.fact-qnty
     2007     sym3
     2008     date_temp-serv.tot-doc @ temp-serv.tot-doc
     2009     sym4
     2010     date_temp-serv.discnt @ temp-serv.discnt
     2011     sym8 pcnt    when pcnt <> 0
     2012     sym5 date_temp-serv.netto @ temp-serv.netto
     2013     sym6
     2014     date_temp-serv.num-chk @ temp-serv.num-chk
     2015     sym7     with FRAME temprep.
     2016     .
     2017     DOWN stream PrnLibStream 1  with FRAME temprep.
     2018     if last( date_temp-serv.fact-date ) then do:
     2019       if num-objs > 1 then do:
     2020         UNDERLINE stream PrnLibStream
     2021         temp-serv.obj-code
     2022         temp-serv.fact-date
     2023         temp-serv.fact-qnty
     2024         temp-serv.tot-doc
     2025         temp-serv.discnt
     2026         pcnt
     2027         temp-serv.netto
     2028         temp-serv.num-chk
     2029         with FRAME temprep
     2030         .
     2031         for each obj_temp-serv where
     2032                 obj_temp-serv.fact-date = 01/01/1990
     2033               and obj_temp-serv.obj-type > ''
     2034               and obj_temp-serv.gds-code = 0
     2035         by obj_temp-serv.obj-type
     2036         by obj_temp-serv.obj-code:
     2037           pcnt = round( obj_temp-serv.discnt / obj_temp-serv.tot-doc * 100, 1 ) .
     2038           if pcnt = ? then pcnt = 0.
     2039           DISPLAY stream PrnLibStream
     2040           sym1  "по маг" @ temp-serv.fact-date
     2041           sym11 obj_temp-serv.obj-code @ temp-serv.obj-code
     2042           sym2
     2043           sym3 obj_temp-serv.fact-qnty @ temp-serv.fact-qnty
     2044           sym4 obj_temp-serv.tot-doc @ temp-serv.tot-doc
     2045           sym5 obj_temp-serv.discnt @ temp-serv.discnt
     2046           sym6 pcnt    when pcnt <> 0
     2047           sym7 obj_temp-serv.netto @ temp-serv.netto
     2048           sym8 obj_temp-serv.num-chk @ temp-serv.num-chk
     2049           with FRAME temprep
     2050           .
     2051           DOWN stream PrnLibStream 1  with FRAME temprep. .
     2052         end.
     2053       end.
     2054       UNDERLINE stream PrnLibStream
     2055       temp-serv.obj-code
     2056       temp-serv.fact-date
     2057       temp-serv.fact-qnty
     2058       temp-serv.tot-doc
     2059       temp-serv.discnt
     2060       pcnt
     2061       temp-serv.netto
     2062       temp-serv.num-chk
     2063       with FRAME temprep
     2064       .
     2065       find first tot_temp-serv where
     2066                 tot_temp-serv.fact-date = 01/01/1990
     2067             and  tot_temp-serv.obj-type = ''
     2068             and  tot_temp-serv.obj-code = 0
     2069             and  tot_temp-serv.gds-code = 0
     2070             .
     2071       pcnt = round( tot_temp-serv.discnt / tot_temp-serv.tot-doc * 100, 1 ) .
     2072       if pcnt = ? then pcnt = 0.
     2073       DISPLAY stream PrnLibStream
     2074       sym1 "ИТОГО" @ temp-serv.fact-date
     2075       sym11
     2076       sym2 tot_temp-serv.fact-qnty @ temp-serv.fact-qnty
     2077       sym3 tot_temp-serv.tot-doc @ temp-serv.tot-doc
     2078       sym4 tot_temp-serv.discnt @ temp-serv.discnt
     2079       sym5 pcnt    when pcnt <> 0
     2080       sym6 tot_temp-serv.netto @ temp-serv.netto
     2081       sym7 tot_temp-serv.num-chk @ temp-serv.num-chk
     2082       sym8
     2083       with FRAME temprep
     2084       .
     2085     end.
     2086   END.
     2087   HIDE stream PrnLibStream FRAME NBottomFrame .
     2088   run waitfram-hide in this-procedure .
     2089   output stream PrnLibStream CLOSE .
     2090   run prn-lib-prn-file in this-procedure (
     2091                                             input my-handle
     2092                                             ,input 0
     2093                                             ).
     2094   END PROCEDURE.
     2095   PROCEDURE ByTempObj:
     2096   run prn-lib-open-stream  in this-procedure (
