     1154   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1155   procedure factord :
     1156     define input  parameter p-fact-date            as date    no-undo .
     1157     define input  parameter p-fact-time            as integer no-undo .
     1158     define input  parameter p-fact-num             as integer no-undo .
     1159     define input  parameter p-shift-date           as date    no-undo .
     1160     define input  parameter p-shift-num            as integer no-undo .
     1161     define input  parameter p-shift-on             as logical no-undo .
     1162     define output parameter p-fact-order           as decimal no-undo .
     1163     define output parameter p-shift-end-fact-order as decimal no-undo .
     1164     define output parameter p-day-end-fact-order   as decimal no-undo .
     1165     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1166     if p-fact-date = ?
     1167     then do:
     1168       return error "Не указана фактическая дата" .
     1169     end.
     1170     define variable v-fact-date-num as integer no-undo .
     1171     assign
     1172       v-fact-date-num = integer(p-fact-date)
     1173     .
     1174     if p-fact-num = ?
     1175     or p-fact-num = 0
     1176     then do:
     1177       return error "Не задан p-fact-num " + string(p-fact-num) .
     1178     end.
     1179     if p-fact-num < 0
     1180     then do:
     1181       return error "Отрицательный fact-num " + string(p-fact-num) .
     1182     end.
     1183     if p-fact-num >= 100000000
     1184     then do:
     1185       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1186     end.
     1187     if p-shift-on = true
     1188     then do:
     1189       if p-shift-date = ?
     1190       then do:
     1191         return error "Не задана дата смены" .
     1192       end.
     1193       if p-shift-num = ?
     1194       or p-shift-num = 0
     1195       then do:
     1196         return error "Не задан номер смены" .
     1197       end.
     1198     end.
     1199     else do:
     1200       assign
     1201         p-shift-date = p-fact-date
     1202         p-shift-num  = 24
     1203       .
     1204     end.
     1205     define variable v-shift-offset as integer no-undo .
     1206     if p-shift-date = p-fact-date
     1207     then do:
     1208       assign
     1209         v-shift-offset = 1
     1210       .
     1211     end.
     1212     if p-shift-date < p-fact-date
     1213     then do:
     1214       assign
     1215         v-shift-offset = 0
     1216       .
     1217     end.
     1218     if p-shift-date > p-fact-date
     1219     then do:
     1220       message
     1221         vss-workfile vss-revision vss-description skip
     1222         "Неправильная дата закрытия смены" skip
     1223         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1224         view-as alert-box error .
     1225       undo, return error
     1226         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1227           ,string(p-fact-date, '99/99/9999':U)
     1228           ,string(p-shift-date, '99/99/9999':U)
     1229           )
     1230       .
     1231     end.
     1232     if p-shift-num < 1
     1233     or p-shift-num > 24
     1234     then do:
     1235       message
     1236         vss-workfile vss-revision vss-description skip
     1237         "Неправильный номер смены" skip
     1238         "p-shift-num" p-shift-num skip
     1239         view-as alert-box error .
     1240       undo, return error return-value .
     1241     end.
     1242     assign
     1243       p-fact-order           = v-fact-date-num
     1244                              + v-shift-offset * 0.5
     1245                              + p-shift-num    * 0.02 - 0.01
     1246                              + p-fact-num     * 0.0000000001
     1247       p-shift-end-fact-order = v-fact-date-num
     1248                              + v-shift-offset * 0.5
     1249                              + p-shift-num    * 0.02
     1250       p-day-end-fact-order   = v-fact-date-num
     1251                              + 0.99
     1252     .
     1253     if p-fact-order           <= v-fact-date-num
     1254     or p-shift-end-fact-order <= v-fact-date-num
     1255     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1256     or p-shift-end-fact-order >= p-day-end-fact-order
     1257     then do:
     1258       message
     1259         vss-workfile vss-revision vss-description skip
     1260         "Внутренняя ошибка при генерации фактического номера" skip
     1261         "p-fact-date"            p-fact-date            skip
     1262         "p-fact-time"            p-fact-time            skip
     1263         "p-fact-num"             p-fact-num             skip
     1264         "p-shift-date"           p-shift-date           skip
     1265         "p-shift-num"            p-shift-num            skip
     1266         "p-shift-on"             p-shift-on             skip
     1267         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1268         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1269         "v-fact-date-num"        v-fact-date-num        skip
     1270         view-as alert-box error .
     1271       undo, return error return-value .
     1272     end.
     1273   end procedure.
     1274   procedure day-begin-fact-order :
     1275     define input  parameter p-fact-date            as date    no-undo .
     1276     define output parameter p-day-begin-fact-order as decimal no-undo .
     1277     do
     1278     on error undo, return error return-value
     1279     :
     1280       if p-fact-date = ?
     1281       then do:
     1282         assign
     1283           p-day-begin-fact-order = 0
     1284         .
     1285       end.
     1286       else do:
     1287         assign
     1288           p-day-begin-fact-order = integer(p-fact-date)
     1289         .
     1290       end.
     1291     end.
     1292   end procedure.
     1293   procedure factord-max-fact-order :
     1294     define output parameter p-max-fact-order as decimal   no-undo .
     1295     do
     1296     on error undo, return error return-value
     1297     :
     1298       run day-begin-fact-order in this-procedure
     1299         (input  date(1, 1, 5000)
     1300         ,output p-max-fact-order
     1301         ) .
     1302     end.
     1303   end procedure.
     1304   procedure factord-cut-archive :
     1305     define input  parameter p-obj-type             as character no-undo .
     1306     define input  parameter p-obj-code             as integer   no-undo .
     1307     define input  parameter p-fact-date            as date      no-undo .
     1308     define output parameter p-shift-on             as logical   no-undo .
     1309     define output parameter p-shift-date           as date      no-undo .
     1310     define output parameter p-shift-num            as integer   no-undo .
     1311     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1312     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1313     define variable v-fact-order as decimal   no-undo .
     1314     define buffer buf_shift-obj for ub.shift-obj .
     1315     do
     1316     on error undo, return error return-value
     1317     :
     1318   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1319   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1320     (input  p-obj-type
     1321     ,input  p-obj-code
     1322     ,input  'shift-on=request'
     1323     ,output p-shift-on
     1324     ) no-error .
     1325       if error-status :error
     1326       then do:
     1327         message
     1328           vss-workfile vss-revision vss-description skip
     1329           "Ошибка при определении атрибута объекта" skip
     1330           "Объект" p-obj-type p-obj-code skip
     1331           error-status :get-message(1) skip
     1332           return-value skip
     1333           view-as alert-box error .
     1334         undo, return error return-value .
     1335       end.
     1336       if p-shift-on = false
     1337       then do:
     1338         assign
     1339           p-shift-date               = ?
     1340           p-shift-num                = 0
     1341         .
     1342       end.
     1343       else do:
     1344         find first buf_shift-obj share-lock
     1345           where buf_shift-obj.obj-type   = p-obj-type
     1346             and buf_shift-obj.obj-code   = p-obj-code
     1347             and buf_shift-obj.shift-date > p-fact-date
     1348           use-index pi
     1349           no-error .
     1350         if not available buf_shift-obj
     1351         or buf_shift-obj.status_ <> 'зкр':U
     1352         then do:
     1353           message
     1354             vss-workfile vss-revision vss-description skip
     1355             "Невозможно вычислить последнюю смену" skip
     1356             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1357             "Объект" p-obj-type p-obj-code skip
     1358             "Дата" p-fact-date skip
     1359             view-as alert-box error .
     1360           undo, return error return-value .
     1361         end.
     1362         find last buf_shift-obj share-lock
     1363           where buf_shift-obj.obj-type = p-obj-type
     1364             and buf_shift-obj.obj-code = p-obj-code
     1365             and buf_shift-obj.shift-date <= p-fact-date
     1366           use-index pi
     1367           no-error .
     1368         if available buf_shift-obj
     1369         then do:
     1370           if  buf_shift-obj.status_ = 'зкр':U
     1371           then do:
     1372             assign
     1373               p-shift-date = buf_shift-obj.shift-date
     1374               p-shift-num  = buf_shift-obj.shift-num
     1375             .
     1376           end.
     1377           else do:
     1378             message
     1379               vss-workfile vss-revision vss-description skip
     1380               "Невозможно вычислить последнюю смену" skip
     1381               "Статус смены отличен от статуса" 'зкр':U skip
     1382               "Объект" p-obj-type p-obj-code skip
     1383               "Дата" p-fact-date skip
     1384               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1385               view-as alert-box error .
     1386             undo, return error return-value .
     1387           end.
     1388         end.
     1389         else do:
     1390           assign
     1391             p-shift-date = p-fact-date - 1
     1392             p-shift-num  = 1
     1393           .
     1394         end.
     1395       end.
     1396       run factord in this-procedure
     1397         (input  p-fact-date
     1398         ,input  1
     1399         ,input  1
     1400         ,input  p-shift-date
     1401         ,input  p-shift-num
     1402         ,input  p-shift-on
     1403         ,output v-fact-order
     1404         ,output p-shift-end-fact-order
     1405         ,output p-day-end-fact-order
     1406         ) no-error .
     1407       if error-status :error
     1408       then do:
     1409         message
     1410           vss-workfile vss-revision vss-description skip
     1411           "Ошибка при вызове процедуры factord"
     1412           error-status :get-message(1) skip
     1413           return-value skip
     1414           view-as alert-box error .
     1415         undo, return error return-value .
     1416       end.
     1417     end.
     1418   end procedure.
     1419   procedure factord-lock-shift :
     1420     define input  parameter p-obj-type  as character no-undo .
     1421     define input  parameter p-obj-code  as integer   no-undo .
     1422     define input  parameter p-fact-date as date      no-undo .
     1423     define parameter buffer buf_shift-obj for ub.shift-obj .
     1424     define variable v-shift-on      as logical   no-undo .
     1425     define variable v-extra-message as character no-undo .
     1426     define variable v-error as character no-undo .
     1427     do
     1428     on error undo, return error return-value
     1429     :
     1430   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1431   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1432     (input  p-obj-type
     1433     ,input  p-obj-code
     1434     ,input  'shift-on=request'
     1435     ,output v-shift-on
     1436     ) no-error .
     1437       if error-status :error
     1438       then do:
     1439         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1440         undo, return error v-error .
     1441       end.
     1442       if v-shift-on = true
     1443       then do:
     1444         find first buf_shift-obj share-lock
     1445           where buf_shift-obj.obj-type   = p-obj-type
     1446             and buf_shift-obj.obj-code   = p-obj-code
     1447             and buf_shift-obj.shift-date > p-fact-date
     1448           use-index pi
     1449           no-error .
     1450         if not available buf_shift-obj
     1451         or buf_shift-obj.status_ <> 'зкр':U
     1452         then do:
     1453           find last buf_shift-obj
     1454             where buf_shift-obj.obj-type = p-obj-type
     1455               and buf_shift-obj.obj-code = p-obj-code
     1456               and buf_shift-obj.status_  = 'зкр':U
     1457             use-index stts
     1458             no-error .
     1459           if available buf_shift-obj
     1460           then do:
     1461             assign
     1462               v-extra-message =
     1463                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1464                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1465                               )
     1466             .
     1467           end.
     1468           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1469           undo, return error v-error .
     1470         end.
     1471       end.
     1472     end.
     1473   end procedure.
     1474   procedure factord-end-day :
     1475     define input  parameter p-fact-date            as date    no-undo .
     1476     define output parameter p-day-end-fact-order   as decimal no-undo .
     1477     do
     1478     on error undo, return error return-value
     1479     :
     1480       if p-fact-date = ?
     1481       then do:
     1482         return error "Не указана фактическая дата" .
     1483       end.
     1484       assign
     1485         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1486       .
     1487     end.
     1488   end procedure.
     1489   procedure factord-to-date :
     1490     define input  parameter p-fact-order as decimal no-undo .
     1491     define output parameter p-fact-date  as date    no-undo .
     1492     define variable v-ref-date  as date      no-undo .
     1493     define variable v-ref-delta as integer   no-undo .
     1494     do
     1495     on error undo, return error return-value
     1496     :
     1497       if p-fact-order = ?
     1498       or p-fact-order = 0
     1499       then do:
     1500         return error "Не указан fact-order" .
     1501       end.
     1502       assign
     1503         v-ref-date  = date(1, 1, 2000)
     1504       .
     1505       assign
     1506         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1507       .
     1508       assign
     1509         p-fact-date = v-ref-date + v-ref-delta
     1510       .
     1511     end.
     1512   end procedure.
     1513   procedure factord-to-fact-num :
     1514     define input  parameter p-fact-order as decimal no-undo .
     1515     define output parameter p-fact-num   as integer no-undo .
     1516     define variable v-fact-order-trunc as decimal no-undo .
     1517     do
     1518     on error undo, return error return-value
     1519     :
     1520       if p-fact-order = ?
     1521       or p-fact-order = 0
     1522       then do:
     1523         return error "Не указан fact-order" .
     1524       end.
     1525       assign
     1526        v-fact-order-trunc = truncate(p-fact-order, 2)
     1527       .
     1528       assign
     1529         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1530       .
     1531     end.
     1532   end procedure.
     1533   procedure factord-to-shift-num :
     1534     define input  parameter p-fact-order as decimal no-undo .
     1535     define output parameter p-shift-num   as integer no-undo .
     1536     define variable  p-shift-numd  as decimal   no-undo .
     1537     define variable v-fact-order-trunc as decimal no-undo .
     1538     do
     1539     on error undo, return error return-value
     1540     :
     1541       if p-fact-order = ?
     1542       or p-fact-order = 0
     1543       then do:
     1544         return error "Не указан fact-order" .
     1545       end.
     1546       assign
     1547        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1548       .
     1549       if v-fact-order-trunc < 0.5 then do:
     1550         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1551       end.
     1552       assign
     1553         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1554         .
     1555        assign
     1556         p-shift-num = truncate (p-shift-numd , 0)
     1557       .
     1558     end.
     1559   end procedure.
     1560   def var vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1561   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     1562   procedure paramls-clear :
     1563     define buffer buf_temp-param for temp-param .
     1564     do
     1565     on error undo, return error return-value
     1566     :
     1567       for each buf_temp-param
     1568       on error undo, return error
     1569       :
     1570         delete buf_temp-param .
     1571       end.
     1572     end.
     1573   end procedure.
     1574   procedure paramls-write :
     1575     define input  parameter p-code     as character no-undo .
     1576     define input  parameter p-sub-code as character no-undo .
     1577     define input  parameter p-value    as character no-undo .
     1578     define buffer buf_temp-param for temp-param .
     1579     do
     1580     on error undo, return error return-value
     1581     :
     1582       find first buf_temp-param
     1583         where buf_temp-param.param-code     = p-code
     1584           and buf_temp-param.param-sub-code = p-sub-code
     1585         no-error .
     1586       if not available buf_temp-param then do:
     1587         create buf_temp-param .
     1588         assign
     1589           buf_temp-param.param-code     = p-code
     1590           buf_temp-param.param-sub-code = p-sub-code
     1591         .
     1592       end.
     1593       assign
     1594         buf_temp-param.param-value = p-value
     1595       .
     1596     end.
     1597   end procedure.
     1598   procedure paramls-read :
     1599     define input  parameter p-code          as character no-undo .
     1600     define input  parameter p-sub-code      as character no-undo .
     1601     define input  parameter p-default-value as character no-undo .
     1602     define output parameter p-value         as character no-undo .
     1603     define buffer buf_temp-param for temp-param .
     1604     do
     1605     on error undo, return error return-value
     1606     :
     1607       find first buf_temp-param
     1608         where buf_temp-param.param-code     = p-code
     1609           and buf_temp-param.param-sub-code = p-sub-code
     1610         no-error .
     1611       if available buf_temp-param then do:
     1612         assign
     1613           p-value = buf_temp-param.param-value
     1614         .
     1615       end.
     1616       else do:
     1617         assign
     1618           p-value = p-default-value
     1619         .
     1620       end.
     1621     end.
     1622   end procedure.
     1623   procedure paramls-append :
     1624     define input  parameter p-code     as character no-undo .
     1625     define input  parameter p-sub-code as character no-undo .
     1626     define input  parameter p-value    as character no-undo .
     1627     define buffer buf_temp-param for temp-param .
     1628     do
     1629     on error undo, return error return-value
     1630     :
     1631       find first buf_temp-param
     1632            where buf_temp-param.param-code     = p-code
     1633              and buf_temp-param.param-sub-code = p-sub-code
     1634         no-error .
     1635       if not available buf_temp-param then do:
     1636         create buf_temp-param .
     1637         assign
     1638           buf_temp-param.param-code     = p-code
     1639           buf_temp-param.param-sub-code = p-sub-code
     1640           buf_temp-param.param-value    = p-value
     1641         .
     1642       end.
     1643       else do:
     1644           assign
     1645               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     1646           .
     1647       end.
     1648     end.
     1649   end procedure.
     1650   define variable vss-include-info13 as character format "X(65)" no-undo
     1651   initial "@(#)$Workfile$ $Revision$".
     1652   define variable v-fmtcli-name          as character    no-undo.
     1653   define variable v-fmtcli-engl-name     as character    no-undo.
     1654   define variable v-fmtcli-addres        as character    no-undo.
     1655   define variable v-fmtcli-post-addres   as character    no-undo.
     1656   define variable v-fmtcli-full-addres   as character    no-undo.
     1657   define variable v-fmtcli-phone         as character    no-undo.
     1658   define variable v-fmtcli-inn           as character    no-undo.
     1659   define variable v-fmtcli-kpp           as character    no-undo.
     1660   define variable v-fmtcli-okpo          as character    no-undo.
     1661   define variable v-fmtcli-country       as character    no-undo.
     1662   define variable v-fmtcli-city          as character    no-undo.
     1663   define variable v-fmtcli-index         as character    no-undo.
     1664   define variable v-fmtcli-schet-exists  as logical      no-undo.
     1665   define variable v-fmtcli-bank-exists   as logical      no-undo.
     1666   define variable v-fmtcli-bank-r-schet  as character    no-undo.
     1667   define variable v-fmtcli-bank-c-schet  as character    no-undo.
     1668   define variable v-fmtcli-bank-bik      as character    no-undo.
     1669   define variable v-fmtcli-bank-name     as character    no-undo.
     1670   define variable v-fmtcli-bank-addres   as character    no-undo.
     1671   define variable v-fmtcli-bank-city     as character    no-undo.
     1672   procedure fmtcli-get-bank :
     1673   define input parameter p-host-code      as integer          no-undo.
     1674   define input parameter p-obj-type       as character        no-undo.
     1675   define input parameter p-obj-code       as integer          no-undo.
     1676   define input parameter p-curr-code      as integer          no-undo.
     1677       define buffer buf_fin-schet     for ub.fin-schet.
     1678       define buffer buf_fin-bank      for ub.fin-bank.
     1679   do
     1680   for buf_fin-schet
     1681     , buf_fin-bank
     1682   on error undo, return error
     1683   :
     1684       assign
     1685           v-fmtcli-schet-exists       = no
     1686           v-fmtcli-bank-exists        = no
     1687           v-fmtcli-bank-r-schet       = "":U
     1688           v-fmtcli-bank-c-schet       = "":U
     1689           v-fmtcli-bank-bik           = "":U
     1690           v-fmtcli-bank-name          = "":U
     1691           v-fmtcli-bank-addres        = "":U
     1692           v-fmtcli-bank-city          = "":U
     1693       .
     1694       search-for-schet:
     1695       for each buf_fin-schet no-lock
     1696          where buf_fin-schet.host-code = p-host-code
     1697            and buf_fin-schet.cli-type  = p-obj-type
     1698            and buf_fin-schet.cli-code  = p-obj-code
     1699            and buf_fin-schet.curr-code = p-curr-code
     1700       on error undo, return error
     1701       :
     1702           if buf_fin-schet.status_   = 'удал':U
     1703           then do:
     1704           end.
     1705           else do:
     1706               assign
     1707                   v-fmtcli-schet-exists   = yes
     1708                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
     1709                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
     1710               .
     1711               find first buf_fin-bank no-lock
     1712                    where buf_fin-bank.host-code = p-host-code
     1713                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
     1714               no-error.
     1715               if available buf_fin-bank
     1716               then do:
     1717                   assign
     1718                       v-fmtcli-bank-exists      = yes
     1719                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
     1720                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
     1721                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
     1722                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
     1723                   .
     1724               end.
     1725               else do:
     1726                   assign
     1727                       v-fmtcli-bank-exists    = no
     1728                       v-fmtcli-bank-bik       = "":U
     1729                       v-fmtcli-bank-name      = "":U
     1730                       v-fmtcli-bank-addres    = "":U
     1731                       v-fmtcli-bank-city      = "":U
     1732                   .
     1733               end.
     1734               leave search-for-schet.
     1735           end.
     1736       end.
     1737   end.
     1738   end procedure.
     1739   procedure fmtcli-get-client :
     1740   define input parameter p-obj-type       as character    no-undo.
     1741   define input parameter p-obj-code       as integer      no-undo.
     1742       define variable v-temp-fmtcli-address      as character     no-undo.
     1743       define variable v-num-country-city    as integer      no-undo.
     1744       define buffer buf_clients   for ub.clients.
     1745       define buffer buf_firm      for ub.firm.
     1746       define buffer buf_store     for ub.store.
     1747       define buffer buf_shop      for ub.shop.
     1748       define buffer buf_person    for ub.person.
     1749   do
     1750   for buf_clients
     1751     , buf_firm
     1752     , buf_store
     1753     , buf_shop
     1754     , buf_person
     1755   on error undo, return error
     1756   :
     1757       assign
     1758           v-fmtcli-name           = "":U
     1759           v-fmtcli-addres         = "":U
     1760           v-fmtcli-post-addres    = "":U
     1761           v-fmtcli-full-addres    = "":U
     1762           v-fmtcli-phone          = "":U
     1763           v-fmtcli-inn            = "":U
     1764           v-fmtcli-kpp            = "":U
     1765           v-fmtcli-okpo           = "":U
     1766           v-fmtcli-city           = "":U
     1767           v-fmtcli-index          = "":U
     1768           v-fmtcli-country        = "":U
     1769       .
     1770       find first buf_clients no-lock
     1771            where buf_clients.obj-type = p-obj-type
     1772              and buf_clients.obj-code = p-obj-code
     1773       .
     1774       assign
     1775           v-fmtcli-name = buf_clients.obj-name
     1776       .
     1777       case buf_clients.obj-type:
     1778          when 'орг':U
     1779          then do:
     1780               find first buf_firm no-lock
     1781                    where buf_firm.firm-code = buf_clients.obj-code
     1782                    no-error
     1783               .
     1784               if available buf_firm
     1785               then do:
     1786                   assign
     1787                       v-num-country-city = num-entries( buf_firm.city )
     1788                       v-fmtcli-engl-name = buf_firm.engl-name
     1789                   .
     1790                   if v-num-country-city > 0
     1791                   then do:
     1792                       assign
     1793                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
     1794                       .
     1795                   end.
     1796                   if v-num-country-city > 1
     1797                   then do:
     1798                       assign
     1799                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
     1800                       .
     1801                   end.
     1802                   run fmtcli-concatenate-strings in this-procedure (
     1803                         input v-fmtcli-full-addres
     1804                       , input v-fmtcli-country
     1805                       , input ", ":U
     1806                       , input 50
     1807                       , output v-fmtcli-full-addres
     1808                   ).
     1809                   run fmtcli-concatenate-strings in this-procedure (
     1810                         input v-fmtcli-full-addres
     1811                       , input v-fmtcli-city
     1812                       , input ", ":U
     1813                       , input 50
     1814                       , output v-fmtcli-full-addres
     1815                   ).
     1816                   run fmtcli-concatenate-strings in this-procedure (
     1817                         input v-fmtcli-full-addres
     1818                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
     1819                       , input ", ":U
     1820                       , input 50
     1821                       , output v-fmtcli-full-addres
     1822                   ).
     1823                   run fmtcli-concatenate-strings in this-procedure (
     1824                         input v-fmtcli-post-addres
     1825                       , input v-fmtcli-country
     1826                       , input ", ":U
     1827                       , input 50
     1828                       , output v-fmtcli-post-addres
     1829                   ).
     1830                   run fmtcli-concatenate-strings in this-procedure (
     1831                         input v-fmtcli-post-addres
     1832                       , input v-fmtcli-city
     1833                       , input ", ":U
     1834                       , input 50
     1835                       , output v-fmtcli-post-addres
     1836                   ).
     1837                   run fmtcli-concatenate-strings in this-procedure (
     1838                         input v-fmtcli-post-addres
     1839                       , input string( buf_firm.ind )
     1840                       , input ", ":U
     1841                       , input 50
     1842                       , output v-fmtcli-post-addres
     1843                   ).
     1844                   run fmtcli-concatenate-strings in this-procedure (
     1845                         input substring( buf_firm.addres1, 1, 50 )
     1846                       , input buf_firm.addres2
     1847                       , input " ":U
     1848                       , input 50
     1849                       , output v-temp-fmtcli-address
     1850                   ).
     1851                   run fmtcli-concatenate-strings in this-procedure (
     1852                         input v-temp-fmtcli-address
     1853                       , input substring( buf_firm.addres1, 51, 50 )
     1854                       , input " ":U
     1855                       , input 50
     1856                       , output v-temp-fmtcli-address
     1857                   ).
     1858                   run fmtcli-concatenate-strings in this-procedure (
     1859                         input v-temp-fmtcli-address
     1860                       , input substring( buf_firm.addres1, 101, 50 )
     1861                       , input " ":U
     1862                       , input 50
     1863                       , output v-temp-fmtcli-address
     1864                   ).
     1865                   assign
     1866                       v-fmtcli-addres = v-temp-fmtcli-address
     1867                   .
     1868                   if buf_firm.addres1 <> ?
     1869                   then do:
     1870                       run fmtcli-concatenate-strings in this-procedure (
     1871                             input v-fmtcli-full-addres
     1872                           , input v-fmtcli-addres
     1873                           , input ", ":U
     1874                           , input 0
     1875                           , output v-fmtcli-full-addres
     1876                       ).
     1877                   end.
     1878                   run fmtcli-concatenate-strings in this-procedure (
     1879                         input substring( buf_firm.post-addr1, 1, 50 )
     1880                       , input buf_firm.post-addr2
     1881                       , input " ":U
     1882                       , input 50
     1883                       , output v-fmtcli-post-addres
     1884                   ).
     1885                   run fmtcli-concatenate-strings in this-procedure (
     1886                         input v-fmtcli-post-addres
     1887                       , input substring( buf_firm.post-addr1, 51, 50 )
     1888                       , input " ":U
     1889                       , input 50
     1890                       , output v-fmtcli-post-addres
     1891                   ).
     1892                   run fmtcli-concatenate-strings in this-procedure (
     1893                         input v-fmtcli-post-addres
     1894                       , input substring( buf_firm.post-addr1, 101, 50 )
     1895                       , input " ":U
     1896                       , input 50
     1897                       , output v-fmtcli-post-addres
     1898                   ).
     1899                   assign
     1900                       v-fmtcli-phone         = buf_firm.phone
     1901                       v-fmtcli-inn           = buf_firm.inn
     1902                       v-fmtcli-kpp           = buf_firm.kpp
     1903                       v-fmtcli-okpo          = buf_firm.okpo
     1904                       v-fmtcli-index         = string( buf_firm.ind )
     1905                   .
     1906               end.
     1907          end.
     1908          when 'маг':U
     1909          then do:
     1910               find first buf_shop no-lock
     1911                    where buf_shop.obj-code = buf_clients.obj-code
     1912               .
     1913               if available buf_shop
     1914               then do:
     1915                   run fmtcli-concatenate-strings in this-procedure (
     1916                         input buf_shop.addres1
     1917                       , input buf_shop.addres2
     1918                       , input " ":U
     1919                       , input 50
     1920                       , output v-fmtcli-addres
     1921                   ).
     1922                   assign
     1923                       v-fmtcli-full-addres = v-fmtcli-addres
     1924                       v-fmtcli-post-addres = v-fmtcli-addres
     1925                       v-fmtcli-phone       = buf_shop.phone
     1926                       v-fmtcli-inn         = "":U
     1927                       v-fmtcli-kpp         = "":U
     1928                       v-fmtcli-okpo        = "":U
     1929                       v-fmtcli-city        = "":U
     1930                       v-fmtcli-index       = "":U
     1931                   .
     1932               end.
     1933          end.
     1934          when 'скл':U
     1935          then do:
     1936               find first buf_store no-lock
     1937                    where buf_store.obj-code = buf_clients.obj-code
     1938               .
     1939               if available buf_store
     1940               then do:
     1941                   run fmtcli-concatenate-strings in this-procedure (
     1942                         input buf_store.addres1
     1943                       , input buf_store.addres2
     1944                       , input " ":U
     1945                       , input 50
     1946                       , output v-fmtcli-addres
     1947                   ).
     1948                   assign
     1949                       v-fmtcli-full-addres = v-fmtcli-addres
     1950                       v-fmtcli-phone       = buf_store.phone
     1951                       v-fmtcli-inn         = "":U
     1952                       v-fmtcli-kpp         = "":U
     1953                       v-fmtcli-okpo        = "":U
     1954                       v-fmtcli-city        = "":U
     1955                       v-fmtcli-index       = "":U
     1956                   .
     1957               end.
     1958          end.
     1959          when 'чел':U
     1960          then do:
     1961               find first buf_person no-lock
     1962                    where buf_person.psn-code = buf_clients.obj-code
     1963               .
     1964               if available buf_person
     1965               then do:
     1966                   run fmtcli-concatenate-strings in this-procedure (
     1967                         input ( if buf_person.ind = 0 or buf_person.ind = ?
     1968                                 then "":U
     1969                                 else string( buf_person.ind, "999999")
     1970                                 )
     1971                       , input buf_person.city
     1972                       , input ", ":U
     1973                       , input 0
     1974                       , output v-fmtcli-full-addres
     1975                   ).
     1976                   assign
     1977                       v-fmtcli-addres = buf_person.address
     1978                   .
     1979                   run fmtcli-concatenate-strings in this-procedure (
     1980                         input v-fmtcli-full-addres
     1981                       , input v-fmtcli-addres
     1982                       , input ", ":U
     1983                       , input 0
     1984                       , output v-fmtcli-full-addres
     1985                   ).
     1986                   assign
     1987                       v-fmtcli-phone     = buf_person.phone1
     1988                       v-fmtcli-inn       = buf_person.inn
     1989                       v-fmtcli-kpp       = buf_person.kpp
     1990                       v-fmtcli-okpo      = buf_person.okpo
     1991                       v-fmtcli-city      = buf_person.city
     1992                       v-fmtcli-index     = string( buf_person.ind )
     1993                   .
     1994               end.
     1995          end.
     1996       end case.
     1997   end.
     1998   end procedure.
     1999   procedure fmtcli-concatenate-strings :
     2000   define input parameter p-string-1       as character        no-undo.
     2001   define input parameter p-string-2       as character        no-undo.
     2002   define input parameter p-delimiter      as character        no-undo.
     2003   define input parameter p-length         as integer          no-undo.
     2004   define output parameter p-out-string    as character        no-undo.
     2005   do
     2006   on error undo, return error
     2007   :
     2008       assign
     2009           p-out-string = ( if p-string-1 = ?
     2010                            then "":U
     2011                            else trim( p-string-1 ) )
     2012       .
     2013       assign
     2014           p-out-string = p-out-string
     2015                        + ( if p-out-string = "":U
     2016                            or length( p-out-string ) = p-length
     2017                            or p-string-2 = ?
     2018                            or trim( p-string-2 ) = "":U
     2019                            then "":U
     2020                            else p-delimiter )
     2021                        + ( if p-string-2 = ?
     2022                            or trim( p-string-2 ) = "":U
     2023                            then "":U
     2024                            else trim( p-string-2 ) )
     2025       .
     2026   end.
     2027   end procedure.
     2028   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2029   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
     2030   define new shared variable RepPathName        as character no-undo .
     2031   define new shared variable PrintRubl          as logical   no-undo .
     2032   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2033   define input parameter parParentProc as handle no-undo.
     2034   DEFINE INPUT PARAMETER v-operator AS CHARACTER NO-UNDO.
     2035   DEFINE INPUT PARAMETER v-classified AS INTEGER NO-UNDO.
     2036   define stream Out-Stream.
     2037   define stream OutStr-html.
     2038   DEFINE BUFFER buf_shift-obj_from FOR ub.shift-obj.
     2039   DEFINE BUFFER buf_shift-obj_till FOR ub.shift-obj.
     2040   DEFINE BUFFER buf_shift-obj      FOR ub.shift-obj.
     2041   DEFINE BUFFER buf_chk-doc        FOR ub.chk-doc.
     2042   DEFINE BUFFER buf_goods-attr     FOR ub.goods-attr.
     2043   DEFINE BUFFER buf_chk-gds-pay    FOR ub.chk-gds-pay.
     2044   DEFINE BUFFER buf_bar-code       FOR ub.bar-code.
     2045   DEFINE BUFFER buf_chk-gds-attr   FOR ub.chk-gds-attr.
     2046   DEFINE BUFFER buf_ext-classif    FOR ub.ext-classif.
     2047   DEFINE TEMP-TABLE tt-ref NO-UNDO
     2048   field obj-name like obj-list.obj-name
     2049       FIELD obj-code LIKE obj-list.obj-code
     2050       field obj-type like obj-list.obj-type
     2051       FIELD oss-name LIKE ub.ext-classif.charkey_one
     2052       FIELD chk-num AS INTEGER
     2053       FIELD chk-sum AS DECIMAL
     2054       field tot-r-b as decimal
     2055       .
     2056   define variable v-choice-obj as character no-undo.
     2057   DEFINE VARIABLE v-attr-value AS CHARACTER NO-UNDO.
     2058   DEFINE VARIABLE v-attr-type AS CHARACTER NO-UNDO.
     2059   DEFINE VARIABLE v-oss-name AS CHARACTER NO-UNDO.
     2060   define variable v-chk-num as integer.
     2061   DEFINE VARIABLE g#report-num AS INTEGER NO-UNDO.
     2062   DEFINE VARIABLE v-file-name-rep-htm AS CHARACTER NO-UNDO.
     2063   DEFINE VARIABLE v-fill-path-RepView AS CHARACTER NO-UNDO.
     2064   define variable p-operator as char no-undo.
     2065   function fnc-DD-MM-YYYY returns character
     2066   (input p-dat-date as date) forward.
     2067   function fnc-convert-dot-to-colon returns character
     2068   (input p-data as decimal, input p-accur as character) forward.
     2069   PROCEDURE proc-create-HTML:
     2070    define parameter buffer buf_tt for tt-ref.
     2071     str4 = replace(str4, chr(10), " ").
     2072       str4 = replace(str4, chr(13), " ").
     2073       str4 = replace(str4, chr(9), " ").
     2074       str4 =  left-trim(str4, "Выбор объекта:" ).
     2075       if length(str4) > 115 then
     2076       do:
     2077           v-choice-obj = substring(str4, 1, 115) + "...".
     2078       end.
     2079       else
     2080       do:
     2081           v-choice-obj = str4.
     2082       end.
     2083   str1 = (if X-TOG-Shift then "С " + fnc-DD-MM-YYYY(date(string(X-Date-Start,"99/99/9999"))) + ", смена № "  + string(X-Shift-Start) +
     2084                                   " по " + fnc-DD-MM-YYYY(date(string(X-Date-End,"99/99/9999"))) + ", смена № " + string(X-Shift-End)
     2085                              else
     2086                                   "период с " + fnc-DD-MM-YYYY(date(string(X-Date-Start,"99/99/9999"))) + " по " + fnc-DD-MM-YYYY(date(string(X-Date-End,"99/99/9999")))
     2087                                      ).
     2088    FOR EACH buf_tt where buf_tt.tot-r-b = 0 and  buf_tt.obj-code = 0 NO-LOCK BY buf_tt.oss-name :
     2089        p-operator = p-operator + " " + buf_tt.oss-name.
     2090       end.
     2091   do:
     2092       output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8' .
     2093           put stream OutStr-html unformatted
     2094          "<!DOCTYPE HTML>" skip
     2095                   ' <html>' skip
     2096                   '  <head>' skip
     2097                   '   <meta charset="utf-8">' skip
     2098             '    <style type="text/css">' skip
     2099                   '      table ' + chr(123) + ' border-collapse: collapse; font-size:9pt; font-family:Calibri; table-layout: fixed; width: 540px; hight:  padding: 8px;  ' + chr(125) skip
     2100                   '      td ' + chr(123) ' border: 1px black solid; word-wrap:break-word; ' + chr(125) skip
     2101                   '      htm' skip
     2102                   '      .rotate ' + chr(123) skip
     2103                   '        -webkit-transform: rotate(-90deg);' skip
     2104                   '        -moz-transform: rotate(-90deg);' skip
     2105                   '        -ms-transform: rotate(-90deg);' skip
     2106                   '        -o-transform: rotate(-90deg);' skip
     2107                   '        transform: rotate(-90deg);' skip
     2108                   '        -webkit-transform-origin: 50% 50%;' skip
     2109                   '        -moz-transform-origin: 50% 50%;' skip
     2110                   '        -ms-transform-origin: 50% 50%;' skip
     2111                   '        -o-transform-origin: 50% 50%;' skip
     2112                   '        transform-origin: 50% 50%;' skip
     2113                   '        filter: progid:DXImageTransform.Microsoft.BasicImage(rotation=3);' skip
     2114                   '          ' + chr(125) skip
     2115                   '            th' + ' ' + chr(123) skip
     2116                   '            border: 1px black solid;' skip
     2117                   '            word-wrap: break-word;' skip
     2118                   '          ' + chr(125) skip
     2119                   '   </style>' skip
     2120                   '  </head>' skip.
     2121            end.
     2122            do:
     2123                   put stream OutStr-html unformatted
     2124                    ' <body>' skip
     2125            '   <table name="Лист1" outline_below="false">' skip
     2126                          '     <thead>' skip
     2127            '       <tr class="set_columns">' skip
     2128            '         <td style="width: 100px; border: none;"></td>' skip
     2129            '         <td style="width: 150px; border: none;"></td>' skip
     2130            '         <td style="width: 100px; border: none;"></td>' skip
     2131            '         <td style="width: 100px; border: none;"></td>' skip
     2132                      '       </tr>' skip
     2133            .
     2134            end.
     2135            do:
     2136                       put stream OutStr-html unformatted
     2137               '       <tr>' skip
     2138               '         <td colspan="4" style="border: none; text-align: center; height: 11px; font-size: 11pt; font-weight: bold"> Отчет по переводу средств ОСС   </td>' skip
     2139               '         <td style="border: none"></td>' skip
     2140               '         <td style="border: none"></td>' skip
     2141               '         <td style="border: none"></td>' skip
     2142               '</tr>' skip
     2143                 '       <tr>' skip
     2144               '         <td colspan="4" style="border: none; text-align: center; height: 11px; font-size: 11pt; font-weight: bold">' +  str1 + '</td>' skip
     2145               '         <td style="border: none"></td>' skip
     2146               '         <td style="border: none"></td>' skip
     2147               '         <td style="border: none"></td>' skip
     2148               '</tr>' skip
     2149                 '       <tr>' skip
     2150               '         <td style="border: none; text-align: left; height: 11px; font-size: 11pt; font-weight: bold">Объекты: </td>' skip
     2151               '         <td colspan="3" style="border: none"> ' + v-choice-obj +  '</td>' skip
     2152               '</tr>' skip
     2153                           '       <tr>' skip
     2154               '         <td style="border: none; text-align: left; height: 11px; font-size: 11pt; font-weight: bold">Операторы: </td>' skip
     2155               '         <td colspan="3" style="border: none"> '+ p-operator + '</td>' skip
     2156               '</tr>' skip
     2157                  '       <tr>' skip
     2158               '         <td colspan="4" style="border: none; text-align: left; height: 11px; font-size: 11pt; font-weight: bold">  </td>' skip
     2159               '         <td style="border: none"></td>' skip
     2160               '         <td style="border: none"></td>' skip
     2161               '         <td style="border: none"></td>' skip
     2162               '</tr>' skip
     2163               .
     2164               end.
     2165                     do:
     2166               put stream OutStr-html unformatted
     2167               '     <tbody>' skip
     2168               '       <tr>' skip
     2169                              ' <th style="text-align: center;">Объект</th>' skip
     2170                               '<th style="text-align: center;">Оператор</th>'skip
     2171                              ' <th style="text-align: center;">Количество чеков</th>'skip
     2172                               '<th style="text-align: center;">Сумма</th>' skip
     2173                          ' </tr>' skip
     2174           .
     2175           end.
     2176           do:
     2177       output stream OutStr-html close.
     2178       IF v-classified = 1 THEN DO:
     2179            OUTPUT STREAM OutStr-html TO VALUE(v-file-name-rep-htm) APPEND CONVERT TARGET 'UTF-8'.
     2180           FOR EACH buf_tt where buf_tt.tot-r-b = 0 NO-LOCK BY buf_tt.oss-name BY buf_tt.obj-name:
     2181               PUT STREAM OutStr-html UNFORMATTED
     2182                     ' <tr level="1"> ' skip
     2183                         ' <td style="display: yes; text-align:  left; font-weight: bold">' + buf_tt.obj-name + '</td>' skip
     2184                         ' <td style="display: yes; text-align:  left; font-weight: bold">'  + buf_tt.oss-name + '</td>' skip
     2185                       '         <td style="display: yes; text-align:  left; font-weight: bold">'   + if buf_tt.chk-num <> ? then fnc-convert-dot-to-colon( buf_tt.chk-num, "->>>>>>>9.99")   + '</td>' else "?" + '</td>' skip
     2186                       '         <td style="display: yes; text-align:  left; font-weight: bold">'   + if  buf_tt.chk-sum <> ? then fnc-convert-dot-to-colon(  buf_tt.chk-sum, "->>>>>>>9.99")   + '</td>' else "?" + '</td>' skip
     2187                       ' </tr>' skip.
     2188           END.
     2189            FOR EACH buf_tt where buf_tt.tot-r-b <> 0 NO-LOCK BY buf_tt.oss-name BY buf_tt.obj-name:
     2190                  PUT STREAM OutStr-html UNFORMATTED
     2191            ' <tr level="2"> ' skip
     2192                         ' <td style="display: yes; text-align:left">'  + buf_tt.obj-name + '</td>' skip
     2193                         ' <td style="display: yes; text-align:right ">' + if buf_tt.tot-r-b <> ? then fnc-convert-dot-to-colon( buf_tt.tot-r-b, "->>>>>>>9.99")   + '</td>' else "?" + '</td>' skip
     2194                       '         <td style="display: yes; text-align:left ">'   + if buf_tt.chk-num <> ? then fnc-convert-dot-to-colon( buf_tt.chk-num, "->>>>>>>9.99")   + '</td>' else "?" + '</td>' skip
     2195                       '         <td style="display: yes; text-align:left ">'   + if  buf_tt.chk-sum <> ? then fnc-convert-dot-to-colon(  buf_tt.chk-sum, "->>>>>>>9.99")   + '</td>' else "?" + '</td>' skip
     2196                       ' </tr>' skip.
     2197           end.
     2198       END.
     2199       ELSE IF v-classified = 2 THEN DO:
     2200            OUTPUT STREAM OutStr-html TO VALUE(v-file-name-rep-htm) APPEND CONVERT TARGET 'UTF-8'.
     2201           FOR EACH buf_tt where buf_tt.tot-r-b = 0 NO-LOCK BY buf_tt.obj-name BY buf_tt.oss-name:
     2202               PUT STREAM OutStr-html UNFORMATTED
     2203                     ' <tr level="1"> ' skip
     2204                         ' <td style="display: yes; text-align:  left; font-weight: bold">'  + buf_tt.obj-name + '</td>' skip
     2205                         ' <td style="display: yes; text-align:  left; font-weight: bold">'  + buf_tt.oss-name + '</td>' skip
     2206                       '         <td style="display: yes; text-align:  left; font-weight: bold">'   + if buf_tt.chk-num <> ? then fnc-convert-dot-to-colon( buf_tt.chk-num, "->>>>>>>9.99")   + '</td>' else "?" + '</td>' skip
     2207                       '         <td style="display: yes; text-align:  left; font-weight: bold">'   + if  buf_tt.chk-sum <> ? then fnc-convert-dot-to-colon(  buf_tt.chk-sum, "->>>>>>>9.99")   + '</td>' else "?" + '</td>' skip
     2208                       ' </tr>' skip.
     2209           END.
     2210           FOR EACH buf_tt where buf_tt.tot-r-b <> 0 NO-LOCK BY buf_tt.oss-name BY buf_tt.obj-name:
     2211                   PUT STREAM OutStr-html UNFORMATTED
     2212            '<tr level="2"> 'skip
     2213                               ' <td style="display: yes; text-align:  left">'  + buf_tt.obj-name + '</td>' skip
     2214                         ' <td style="display: yes; text-align:  right">' + if buf_tt.tot-r-b <> ? then fnc-convert-dot-to-colon( buf_tt.tot-r-b, "->>>>>>>9.99")   + '</td>' else "?" + '</td>' skip
     2215                       '         <td style="display: yes; text-align:  left">'   + if buf_tt.chk-num <> ? then fnc-convert-dot-to-colon( buf_tt.chk-num, "->>>>>>>9.99")   + '</td>' else "?" + '</td>' skip
     2216                       '         <td style="display: yes; text-align:  left">'   + if  buf_tt.chk-sum <> ? then fnc-convert-dot-to-colon(  buf_tt.chk-sum, "->>>>>>>9.99")   + '</td>' else "?" + '</td>' skip
     2217                       ' </tr>' skip.
     2218           end.
     2219       END.
     2220    .
     2221           PUT STREAM OutStr-html UNFORMATTED
     2222                       '</table>
     2223               </body>
     2224           </html>'
     2225           .
     2226       OUTPUT STREAM OutStr-html CLOSE.
     2227   end.
     2228   END PROCEDURE.
     2229   DO:
     2230       DO:
     2231           FOR EACH tt-ref EXCLUSIVE-LOCK:
     2232               DELETE tt-ref.
     2233           END.
     2234           RUN get-report-num IN parParentProc (
     2235               OUTPUT g#report-num
     2236           ).
     2237           v-file-name-rep-htm = SESSION:TEMP-DIRECTORY + "rpt" + STRING(g#report-num) + ".html".
     2238           OUTPUT TO VALUE(v-file-name-rep-htm).
     2239           OUTPUT CLOSE.
     2240           IF SEARCH("exe\ReportViewer\reportviewer.exe") <> ? THEN
     2241               DO:
     2242                   v-fill-path-RepView = SEARCH("exe\ReportViewer\reportviewer.exe").
     2243               END.
     2244           ELSE
     2245               DO:
     2246                   MESSAGE "Не найдена программа просмотра отчёта!" VIEW-AS ALERT-BOX ERROR.
     2247               END.
     2248       END.
     2249       DO:
     2250           FOR EACH obj-list NO-LOCK:
     2251             run rep/rpychk0.p ( input "r-shftc2"
     2252                       ,input obj-list.obj-type
     2253                       ,input obj-list.obj-code
     2254                       ,input ?
     2255                       ,input ?
     2256                       ,input X-date-start
     2257                       ,input X-date-end
     2258                       ,input 1
     2259                       ,input 99
     2260                       ,input ?
     2261                       ) no-error.
     2262                       FOR EACH buf_goods-attr WHERE buf_goods-attr.attr-value = 'oss-pay'
     2263                                         AND buf_goods-attr.attr-code = 'office-type':U No-LOCK,
     2264                           EACH buf_bar-code WHERE buf_bar-code.gds-code = buf_goods-attr.gds-code NO-LOCK:
     2265                       FOR EACH buf_chk-gds-pay WHERE buf_chk-gds-pay.obj-type = obj-list.obj-type
     2266                                                          AND buf_chk-gds-pay.obj-code = obj-list.obj-code
     2267                                                  AND ((x-TOG-Shift = YES
     2268                                                      AND buf_chk-gds-pay.shift-num >= x-Shift-Start
     2269                                                      AND buf_chk-gds-pay.shift-num >= x-Shift-End
     2270                                                      AND buf_chk-gds-pay.shift-date >= x-Date-Start
     2271                                                      AND buf_chk-gds-pay.shift-date <= x-Date-End)
     2272                                                      OR (x-TOG-Shift = NO
     2273                                                      AND buf_chk-gds-pay.chk-date >= x-Date-Start
     2274                                                      AND buf_chk-gds-pay.chk-date <= x-Date-End))
     2275                                                  AND buf_chk-gds-pay.b-code = buf_bar-code.b-code NO-LOCK:
     2276                           FIND FIRST buf_chk-gds-attr WHERE buf_chk-gds-attr.doc-code = buf_chk-gds-pay.doc-code
     2277                                                         AND buf_chk-gds-attr.line-num = buf_chk-gds-pay.line-num
     2278                                                         AND buf_chk-gds-attr.attr-code = 'oss-code' NO-LOCK NO-ERROR.
     2279                           IF AVAILABLE buf_chk-gds-attr THEN DO:
     2280                               v-oss-name = string(int(buf_chk-gds-attr.attr-value)) no-error.
     2281                               FIND FIRST ext-classif WHERE ext-classif.classif-subject = 'oss-ref':U
     2282                                                        AND ext-classif.Key#_One = int(v-oss-name) NO-LOCK NO-ERROR.
     2283                               IF AVAILABLE ext-classif THEN DO:
     2284                                   v-oss-name = ENTRY(1, ext-classif.charkey_two,chr(4)).
     2285                               END.
     2286                               ELSE DO:
     2287                                   v-oss-name = 'Нет информации'.
     2288                               END.
     2289                           END.
     2290                           ELSE DO:
     2291                               ASSIGN
     2292                                   v-oss-name = 'Не определено'.
     2293                           END.
     2294                           IF v-operator = '0' OR (LOOKUP(STRING(v-oss-name), v-operator) > 0) THEN DO:
     2295                               IF v-classified = 2 THEN DO:
     2296                                   FIND FIRST tt-ref WHERE tt-ref.obj-code = obj-list.obj-code and
     2297                                   tt-ref.obj-type = obj-list.obj-type
     2298                                                       AND tt-ref.oss-name = '-' EXCLUSIVE-LOCK NO-ERROR.
     2299                                                   IF NOT AVAILABLE tt-ref THEN DO:
     2300                                                           CREATE tt-ref.
     2301                                                           ASSIGN
     2302                                                           tt-ref.obj-code = obj-list.obj-code
     2303                                                           tt-ref.obj-type = obj-list.obj-type
     2304                                                                   tt-ref.obj-name = obj-list.obj-name
     2305                                           tt-ref.oss-name = '-'
     2306                                           tt-ref.chk-num  = 0
     2307                                           tt-ref.chk-sum  = 0
     2308                                           .
     2309                                                   END.
     2310                                   ASSIGN
     2311                                       tt-ref.chk-num = tt-ref.chk-num + 1
     2312                                       tt-ref.chk-sum = tt-ref.chk-sum + buf_chk-gds-pay.tot-r-b.
     2313                               END.
     2314                               ELSE IF v-classified = 1 THEN DO:
     2315                                   FIND FIRST tt-ref WHERE tt-ref.obj-type = "" and tt-ref.obj-code = 0
     2316                                                       AND tt-ref.oss-name = v-oss-name EXCLUSIVE-LOCK NO-ERROR.
     2317                                                   IF NOT AVAILABLE tt-ref THEN DO:
     2318                                                           CREATE tt-ref.
     2319                                                           ASSIGN
     2320                                                           tt-ref.obj-type = ""
     2321                                                           tt-ref.obj-code = 0
     2322                                                                   tt-ref.obj-name = '-'
     2323                                           tt-ref.oss-name = v-oss-name
     2324                                           tt-ref.chk-num  = 0
     2325                                           tt-ref.chk-sum  = 0
     2326                                           .
     2327                                                   END.
     2328                                   ASSIGN
     2329                                       tt-ref.chk-num = tt-ref.chk-num + 1
     2330                                       tt-ref.chk-sum = tt-ref.chk-sum + buf_chk-gds-pay.tot-r-b.
     2331                               END.
     2332                                           FIND FIRST tt-ref WHERE tt-ref.obj-code = obj-list.obj-code
     2333                                           and tt-ref.obj-type = obj-list.obj-type
     2334                                                   AND tt-ref.oss-name = v-oss-name EXCLUSIVE-LOCK NO-ERROR.
     2335                                               IF NOT AVAILABLE tt-ref THEN DO:
     2336                                                   CREATE tt-ref.
     2337                                                   ASSIGN
     2338                                                     tt-ref.obj-code = obj-list.obj-code
     2339                                       tt-ref.obj-type = obj-list.obj-type
     2340                                                           tt-ref.obj-name = obj-list.obj-name
     2341                                       tt-ref.oss-name = v-oss-name
     2342                                       tt-ref.chk-num  = 0
     2343                                       tt-ref.chk-sum  = 0
     2344                                       .
     2345                                           END.
     2346                               ASSIGN
     2347                                   tt-ref.chk-num = tt-ref.chk-num + 1
     2348                                 tt-ref.chk-sum = tt-ref.chk-sum + buf_chk-gds-pay.tot-r-b.
     2349                         find first tt-ref where tt-ref.obj-code = obj-list.obj-code and
     2350                         tt-ref.obj-type = obj-list.obj-type and
     2351                         tt-ref.tot-r-b = buf_chk-gds-pay.tot-r-b
     2352                         and tt-ref.oss-name  = v-oss-name
     2353                          NO-ERROR.
     2354                                   IF NOT AVAILABLE tt-ref THEN DO:
     2355                                   CREATE tt-ref.
     2356                                    ASSIGN
     2357                                    tt-ref.obj-code = obj-list.obj-code
     2358                                       tt-ref.obj-type = obj-list.obj-type
     2359                                       tt-ref.obj-name = obj-list.obj-name
     2360                                       tt-ref.oss-name = v-oss-name
     2361                                       tt-ref.tot-r-b =  buf_chk-gds-pay.tot-r-b.
     2362                                    end.
     2363                                     ASSIGN
     2364                                   tt-ref.chk-num = tt-ref.chk-num + 1
     2365                                 tt-ref.chk-sum = tt-ref.chk-sum + buf_chk-gds-pay.tot-r-b.
     2366                           END.
     2367                       END.
     2368                   END.
     2369           END.
     2370       END.
     2371       FIND FIRST tt-ref NO-LOCK NO-ERROR.
     2372       IF ERROR-STATUS:ERROR THEN DO:
     2373               MESSAGE "Для установленных параметров отчета" SKIP "- данные отсутствуют!" VIEW-AS ALERT-BOX WARNING.
     2374       END.
     2375       ELSE DO:
     2376           RUN proc-create-HTML (BUFFER tt-ref).
     2377           IF SEARCH(v-file-name-rep-htm) = ? THEN DO:
     2378               MESSAGE "Не найден файл отчёта: " v-file-name-rep-htm VIEW-AS ALERT-BOX ERROR.
     2379           END.
     2380           ELSE DO:
     2381               v-file-name-rep-htm = SEARCH(v-file-name-rep-htm).
     2382           END.
     2383           os-command no-wait value(v-fill-path-RepView + " true " + v-file-name-rep-htm).
     2384       END.
     2385   END.
     2386   function fnc-DD-MM-YYYY returns character
     2387   (input p-dat-date as date):
     2388       define variable result as character no-undo.
     2389       define variable p-str-date as character no-undo.
     2390       p-str-date = replace(string(p-dat-date,'99.99.9999'), "/", ".").
     2391           return p-str-date.
     2392   end function.
     2393   function fnc-convert-dot-to-colon returns character
     2394   (input p-data as decimal, input p-accur as character):
     2395       define variable result as character no-undo.
     2396       define variable v-str-result as character no-undo.
     2397       p-data = round(p-data, 2).
     2398       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     2399       return v-str-result.
     2400   end function.
