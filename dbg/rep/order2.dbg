     1626     (output varoutvprb
     1627     )  .
     1628   if varoutvprb = "base":u then do:
     1629     assign
     1630           road-tax-base-sale    =  (if ub.doc-line.road-tax = ? then 0 else ub.doc-line.road-tax * 1)
     1631       excise-base-sale      =  (if ub.doc-line.excise   = ? then 0 else ub.doc-line.excise   * 1)
     1632     .
     1633   end.
     1634   else do:
