     2127           varprice-rubl-cons = varprice-rubl-cons + (price-rubl-with-tax-loco - (if road-tax-rubl-loco = ? then 0 else road-tax-rubl-loco))* out-vatp_parts.fact-qnty.
     2128         assign
     2129           varis-cons-parts-have = yes
     2130           varcons-qnty          = varcons-qnty + out-vatp_parts.fact-qnty.
     2131       end.
     2132       assign
     2133         varfact-qnty = varfact-qnty + out-vatp_parts.fact-qnty.
     2134     end.
     2135   end.
     2136   assign
     2137     varprice-base-cons = varprice-base-cons / varcons-qnty
     2138     varprice-rubl-cons = varprice-rubl-cons / varcons-qnty.
     2139   if varprice-base-cons = ? then do:
     2140     assign
     2141       varprice-base-cons = 0.
     2142   end.
     2143   if varprice-rubl-cons = ? then do:
     2144     assign
     2145       varprice-rubl-cons = 0.
