      945   if session:batch-mode
      946   then
      947      mBatchMode = yes.
      948   if mBatchMode = ? then do:
      949     mVisCUrentVin = current-window:visible.
      950     mFameOldVis = mFramBachModHandle:visible.
      951     mFramBachModHandle:visible  = yes.
      952     mBatchMode = mFramBachModHandle:visible ne yes.
      953     mFramBachModHandle:visible = mFameOldVis.
      954     current-window:visible = mVisCUrentVin.
      955   end.
      956    if  log-manager:logfile-name ne ?
      957     then DO:
      958         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      959         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      960         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      961     end.
      962   on choose of B-WaitFramStop in frame waitfram
      963   do:
      964     mWaitFramStop = yes.
      965     mWaitFramStopUser = yes.
      966   end.
      967   function waitfram-check-timeout returns logical():
      968      define variable vtime as int64 no-undo.
      969      if mWaitFramStopTimeOut
      970      then
      971         return yes.
      972      vtime = ( now - mWaitFramStartProc ) / 1000 .
      973      if     mWaitFramTimeOut ne ?
      974         and mWaitFramTimeOut ne 0
      975         and mWaitFramTimeOut lt vtime
      976      then do:
      977         mWaitFramStopTimeOut = yes.
      978      end.
      979      return mWaitFramStopTimeOut.
      980   end.
      981   procedure waitfram-hide :
      982     if not session:batch-mode
      983     then do
      984     on error undo, return error return-value
      985     :
      986       pause 0 before-hide .
      987       if not mBatchMode then
      988         hide frame waitfram .
      989     if     not mWaitFramView
      990        and mWaitProcEvent
      991     then
      992       process events .
      993     end.
      994   end procedure.
      995   procedure waitfram-show :
      996     define input  parameter p-message as character no-undo .
      997     define variable v-left-margin as integer   no-undo .
      998     if not session:batch-mode
      999     then do
     1000     on error undo, return error return-value
     1001     :
     1002       if length(p-message) <= 70 then do:
     1003         assign
     1004           v-left-margin = integer((70 - length(p-message)) / 2)
     1005         .
     1006         assign
     1007           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1008         .
     1009         assign
     1010           v-waitfram-action01 = " "
     1011           v-waitfram-action02 = " "
     1012                                    + fill(" ", v-left-margin)
     1013                                    + p-message
     1014           v-waitfram-action03 = " "
     1015         .
     1016       end.
     1017       else do:
     1018         define variable vRindex1 as integer no-undo.
     1019         define variable vRindex2 as integer no-undo.
     1020         vRindex1 = r-index(p-message," ",70).
     1021         if vRindex1 = 0
     1022         then
     1023            vRindex1 = 70.
     1024         if length(p-message)  <= vRindex1 + 70 then do:
     1025           assign
     1026             v-waitfram-action01 = " "
     1027             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1028             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1029           .
     1030         end.
     1031         else do:
     1032           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1033           if vRindex2 <= vRindex1
     1034           then
     1035              vRindex2 = vRindex1 + 70.
     1036           assign
     1037             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1038             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1039             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1040           .
     1041         end.
     1042       end.
     1043       B-viewProcInfo:visible   in frame waitfram = no.
     1044       B-viewProcInfo:sensitive in frame waitfram = no.
     1045       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1046       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1047       if  (   mWaitFramView
     1048          or  mWaitProcEvent)
     1049          and not mBatchMode
     1050       then
     1051          display
     1052             v-waitfram-action01 skip
     1053             v-waitfram-action02 skip
     1054             v-waitfram-action03 skip
     1055          with frame waitfram .
     1056       if     mWaitFramView
     1057          then do:
     1058             if     mWaitFramInterval ne ?
     1059                and not mBatchMode
     1060             then
     1061                wait-for go of frame waitfram pause mWaitFramInterval.
     1062          end.
     1063          else
     1064             if     mWaitProcEvent
     1065                and not mBatchMode
     1066             then
     1067                process events .
     1068     end.
     1069   end procedure.
     1070      procedure waitfram-show-this:
     1071         define input  parameter iInterval as int64 no-undo.
     1072         define variable vtime as int64 no-undo.
     1073         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1074         mWaitFramInterval = iInterval.
     1075         run waitfram-show (substitute("&1&2 &3&4" ,
     1076                                       mWaitFramTextBeg ,
     1077                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1078                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1079                                       mWaitFramTextEnd
     1080                                      )
     1081                           ).
     1082      end.
     1083      procedure WaitFramRunPause:
     1084         define input  parameter iInterval as dec no-undo.
     1085         define variable vStart  as datetime-tz no-undo.
     1086         define variable vend    as datetime-tz no-undo.
     1087         define variable vint as int64 no-undo.
     1088         define variable vOk as logical no-undo.
     1089         vStart = now.
     1090         vend   = vStart.
     1091         publish "WaitFramPause" (iInterval,output vOk).
     1092         vend   =  now.
     1093         vint = vend - vStart.
     1094         vint = iInterval - vint / 1000.
     1095         if     not mWaitFramStop
     1096            and (   vint > 0
     1097                 or (    not vOk
     1098                     and iInterval eq ?
     1099                     )
     1100                 )
     1101         then
     1102            run waitfram-show-this (iInterval).
     1103         vend   =  now.
     1104         vint = vend - vStart.
     1105         vint = iInterval - vint / 1000.
     1106         if     not mWaitFramStop
     1107            and vint > 0
     1108         then do:
     1109            run gbl/pause.p (vint * 1000).
     1110         end.
     1111         if iInterval ne ?
     1112         then
     1113            publish "WaitFramStop".
     1114         waitfram-check-timeout().
     1115      end.
     1116      procedure WaitFramWaitFor:
     1117         define input  parameter iInterval as dec no-undo.
     1118         assign
     1119            mWaitFramStartProc   = now
     1120            mWaitFramStopUser    = no
     1121            mWaitFramStopTimeOut = no
     1122         .
     1123         block-wait:
     1124         do while not mWaitFramStop:
     1125            run WaitFramRunPause (iInterval).
     1126            if  waitfram-check-timeout()
     1127            then do:
     1128               leave block-wait.
     1129            end.
     1130         end.
     1131         run waitfram-hide.
     1132      end.
     1133   procedure waitfram-join :
     1134     define input  parameter p-line-1  as character no-undo .
     1135     define input  parameter p-line-2  as character no-undo .
     1136     define input  parameter p-line-3  as character no-undo .
     1137     define output parameter p-message as character no-undo .
     1138     do
     1139     on error undo, return error return-value
     1140     :
     1141       assign
     1142         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1143                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1144                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1145       .
     1146     end.
     1147   end procedure.
     1148   function waitfram-join-function returns character
     1149     (input p-line-1 as character
     1150     ,input p-line-2 as character
     1151     ,input p-line-3 as character
     1152     ).
     1153     define variable v-message as character no-undo .
     1154     run waitfram-join in this-procedure
     1155       (input  p-line-1
     1156       ,input  p-line-2
     1157       ,input  p-line-3
     1158       ,output v-message
     1159       ) .
     1160     return v-message .
     1161   end function .
