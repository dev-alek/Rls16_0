     2116       vat-cli-loco        = vat-rubl-loco       / exch-rate-cli-loco
     2117       road-tax-cli-loco   = road-tax-rubl-loco  / exch-rate-cli-loco
     2118       transport-cli-loco  = 0
     2119       other-cli-loco      = 0
     2120     .
