     1244   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     1245     if num-entries(string(p-dec), '.') = 2
     1246       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     1247       else return( string(p-dec)) .
     1248   end function.
     1249   function format-point-to-comma returns char (input orig as char ) .
     1250   define variable rtext as character no-undo .
     1251   define variable strt as integer no-undo .
     1252   define variable leng as integer no-undo .
     1253   assign rtext = orig .
     1254   repeat:
     1255     strt =  index(rtext,'.').
     1256     if strt = 0 then leave.
     1257     leng = 1.
     1258     substring(rtext,strt,leng,"character") = v-delim .
     1259   end.
     1260   return rtext.
     1261   end function.
     1262   function format-excel-text returns char ( input start-text as char ) :
     1263   def var  i    as int no-undo.
     1264   def var  ch   as char no-undo.
     1265   def var  n    as int no-undo.
     1266   def var  ipos as int no-undo.
     1267     n = num-entries(trim(start-text), chr(10)) - 1 .
     1268     do i = 1 to n :
     1269       ipos = index( start-text, chr(10)).
     1270       if ipos > 0 then
     1271         substr( start-text, ipos, 1 ) = ' '.
     1272     end.
     1273     n = num-entries(trim(start-text), chr(13)) - 1 .
     1274     do i = 1 to n :
     1275       ipos = index( start-text, chr(13)).
     1276       if ipos > 0 then
     1277         substr( start-text, ipos, 1 ) = ' '.
     1278     end.
     1279     if index( start-text, '"' ) = 0 then
     1280       start-text =  '="'   + trim( start-text) + '"'   .
     1281       else do:
     1282         n = num-entries(trim(start-text), '"') - 1.
     1283         do i = 1 to n :
     1284           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1285         end.
     1286         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1287         start-text = '="'  + ch  + '"' .
     1288       end.
     1289     return start-text.
     1290   end.
     1291   function excel-sum returns char (input p-dec as decimal ).
     1292     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     1293   end function.
     1294   function excel-qnty returns char (input p-dec as decimal ).
     1295     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     1296   end function.
     1297   function format-excel-text-macr returns char ( input start-text as char ) :
     1298   def var  i    as int no-undo.
     1299   def var  ch   as char no-undo.
     1300   def var  n    as int no-undo.
     1301   def var  ipos as int no-undo.
     1302     n = num-entries(trim(start-text), chr(10)) - 1 .
     1303     do i = 1 to n :
     1304       ipos = index( start-text, chr(10)).
     1305       if ipos > 0 then
     1306         substring( start-text, ipos , 1 ) = ' '.
     1307     end.
     1308     n = num-entries(trim(start-text), chr(13)) - 1 .
     1309     do i = 1 to n :
     1310       ipos = index( start-text, chr(13)).
     1311       if ipos > 0 then
     1312         substring( start-text, ipos, 1 ) = ' '.
     1313     end.
     1314     if index( start-text, '"' ) = 0 then
     1315       start-text =  '"'   + trim( start-text) + '"'   .
     1316       else do:
     1317         n = num-entries(trim(start-text), '"') - 1.
     1318         do i = 1 to n :
     1319           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1320         end.
     1321         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1322         start-text = '"'  + ch  + '"' .
     1323       end.
     1324     n = num-entries(trim(start-text), chr(10)) - 1 .
     1325     do i = 1 to n :
     1326       ipos = index( start-text, chr(10)).
     1327       if ipos > 0 then
     1328         substring( start-text, ipos , 1 ) = ' '.
     1329     end.
     1330       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     1331     return start-text.
     1332   end.
