     1360           UndLine format "X(136)" AT 1
     1361           with width 136 down stream-io use-text NO-BOX.
     1362   FIND ub.trn-doc WHERE recid(ub.trn-doc) = rec_id NO-LOCK .
     1363   assign
     1364       tdoc-date = (if ub.trn-doc.status_ <> 'факт':U then ub.trn-doc.doc-date else ub.trn-doc.fact-date)
     1365       tdoc-code = ub.trn-doc.doc-code .
     1366   if PrintRubl = ? AND CostPrice = ? AND PrintScale = ? then
     1367       RETURN.
     1368   if NOT ub.trn-doc.internal and PrintScale then DO:
     1369      message "Внешние запросы печатаются без разбиения по признакам !" view-as alert-box . PrintScale = false .
     1370   End.
     1371   output STREAM OutStream to value( string( session:temp-directory +
     1372                                        "rpt" + string( g#report-num ) ) )
     1373                                        page-size  value(63) .
     1374   Make-Excel = true .
     1375   Assign
     1376     Line    = fill("-", 136)
     1377     UndLine = fill("_", 136)
     1378     LineBuf = fill("_", 136) .
     1379    if  CostPrice then DO:
     1380                      IF PrintRubl
     1381                        THEN Assign PP = "Учетные цены ".
     1382                        Else Assign PP = "Учетные цены (б.в.)" .
     1383                      End.
     1384      Else DO:
     1385                   IF PrintRubl
     1386                        THEN Assign PP = "Цены док-та".
     1387                        Else Assign PP = "Цены док-та (б.в.)" .
     1388           End.
     1389   run waitfram-show in this-procedure ( 'Подождите ...' ) .
     1390   FIND This_Object  WHERE This_Object.obj-type = ub.trn-doc.obj-type
     1391                       AND This_Object.obj-code = ub.trn-doc.obj-code NO-LOCK.
     1392   FIND ub.clients  WHERE ub.clients.obj-type = 'орг':U
     1393                   AND ub.clients.obj-code = ub.trn-doc.host-code NO-LOCK.
     1394   Case ub.trn-doc.cli-type :
     1395       when  'орг':U then do :
     1396           FIND ub.firm  WHERE ub.firm.firm-code = ub.trn-doc.cli-code NO-LOCK.
     1397           Assign
     1398             B-adress = ub.firm.addres1
     1399             b-phone  = ub.firm.phone .
     1400           end.
     1401       when  'чел':U then do :
     1402           FIND ub.person  WHERE ub.person.psn-code = ub.trn-doc.cli-code NO-LOCK.
     1403           Assign
     1404             B-adress = ub.person.address
     1405             b-phone  = ub.person.phone1 .
     1406           end.
     1407       when  'маг':U then do :
     1408           FIND ub.shop  WHERE ub.shop.obj-code = ub.trn-doc.cli-code NO-LOCK.
     1409           Assign
     1410             B-adress = ub.shop.addres1
     1411             b-phone  = ub.shop.phone .
     1412           end.
     1413       when  'скл':U then do :
     1414           FIND ub.store  WHERE ub.store.obj-code = ub.trn-doc.cli-code NO-LOCK.
     1415           Assign
     1416             B-adress = ub.store.addres1
     1417             b-phone  = ub.store.phone .
     1418           end.
     1419    End case.
     1420    IF ub.trn-doc.doc-type = 'при':U Then
     1421     Assign
     1422      NAme1   = "ИНН " + t-inn + " " + CAPS( ub.clients.obj-name ) + " (" + string(ub.clients.obj-code) + ")"
     1423      Adres1 = t-addres + " " + t-phone
     1424      NAme2   = ub.trn-doc.cli-name
     1425      Adres2  = b-adress + '  ' + b-phone .
     1426      Else
     1427     Assign
     1428      NAme2   = "ИНН " + t-inn + " " + CAPS( ub.clients.obj-name ) + " (" + string(ub.clients.obj-code) + ")"
     1429      Adres2 = t-addres + " " + t-phone
     1430      NAme1   = ub.trn-doc.cli-name
     1431      Adres1  = b-adress + '  ' + b-phone .
     1432       case clients.obj-type:
     1433          when 'орг':U
     1434          then do:
     1435               FIND ub.firm WHERE ub.firm.firm-code = clients.obj-code NO-LOCK .
     1436               if available ub.firm
     1437               then do:
     1438                   assign
     1439                       t-addres = ( if ub.firm.ind = 0 or ub.firm.ind = ? then "" else string( ub.firm.ind ) )
     1440                       t-addres = t-addres
     1441                           + ( if ub.firm.city = ? or trim(ub.firm.city) = ""
     1442                               then ""
     1443                               else ( (if t-addres = "" then "" else ", ") + trim( ub.firm.city ) )
     1444                             )
     1445                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 1, 50 ) ) )
     1446                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     1447                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     1448                           + ( if  ub.firm.addres2 = ? or trim(ub.firm.addres2) = "" then "" else ( ", " + trim( ub.firm.addres2 ) ) )
     1449                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 51, 50 ) ) )
     1450                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     1451                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     1452                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 101, 50 ) ) )
     1453                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     1454                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     1455                       t-phone = ub.firm.phone
     1456                       t-inn   = ub.firm.inn
     1457                       t-okpo  = ub.firm.okpo
     1458                   .
     1459               end.
     1460          end.
     1461          when 'маг':U
     1462          then do:
     1463               FIND ub.shop WHERE ub.shop.obj-code = clients.obj-code NO-LOCK .
     1464               if available ub.shop
     1465               then do:
     1466                   assign
     1467                       t-addres = ( if trim( shop.addres1 ) <> "" then ( trim( shop.addres1 ) ) else "" )
     1468                               + ( if trim( shop.addres2 ) <> "" then ( ", " + trim( shop.addres2 ) ) else "" )
     1469                       t-phone = shop.phone
     1470                       t-inn = ""
     1471                       t-okpo = ""
     1472                   .
     1473               end.
     1474          end.
     1475          when 'скл':U
     1476          then do:
     1477               FIND ub.store WHERE ub.store.obj-code = clients.obj-code NO-LOCK .
     1478               if available ub.store
     1479               then do:
     1480                   assign
     1481                       t-addres = ( if trim( ub.store.addres1 ) <> "" then ( trim( ub.store.addres1 ) ) else "" )
     1482                               + ( if trim( ub.store.addres2 ) <> "" then ( ", " + trim( ub.store.addres2 ) ) else "" )
     1483                       t-phone = ub.store.phone
     1484                       t-inn = ""
     1485                       t-okpo = ""
     1486                   .
     1487               end.
     1488          end.
     1489          when 'чел':U
     1490          then do:
     1491               find ub.person where ub.person.psn-code = clients.obj-code no-lock .
     1492               if available ub.person
     1493               then do:
     1494                   assign
     1495                       t-addres = ( if ub.person.ind <> 0 and ub.person.ind <> ? then string( ub.person.ind ) else "" )
     1496                                   + ( if  ub.person.city <> ? and trim(ub.person.city) <> "" then ( ", " + trim( ub.person.city ) ) else "" )
     1497                                   + ( if  ub.person.address <> ? and trim(ub.person.address) <> "" then ( ", " + trim( ub.person.address ) ) else "" )
     1498                       t-phone = ub.person.phone1
     1499                       t-inn = ub.person.inn
     1500                       t-okpo = ub.person.okpo
     1501                   .
     1502               end.
     1503          end.
     1504       end case.
