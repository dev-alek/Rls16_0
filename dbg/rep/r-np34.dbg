     2710       .
     2711   end.
     2712   otherwise do:
     2713     return error substitute ("Неизвестный тип приобретения &1 по партии с кодом &2 по документу &3, порожденную документом &4 по товару &5 &6 &7.",
     2714                              cl_tt-clcparts.purch-code,
     2715                              cl_tt-clcparts.part-code,
     2716                              cl_tt-clcparts.out-code,
     2717                              cl_tt-clcparts.in-code,
     2718                              cl_tt-clcparts.artic,
     2719                              cl_tt-clcparts.prod-type,
     2720                              cl_tt-clcparts.prod-code).
     2721   end.
     2722   end case.
     2723   end.
     2724   end procedure.
     2725   procedure clcprtsl_calc-line :
     2726   define input  parameter parrec-line as recid no-undo.
     2727   define variable v-tax-date         as   date                     no-undo.
     2728   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     2729   define variable varr-b             as   character                no-undo.
     2730   define variable varr-btype         as   character                no-undo.
     2731   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     2732   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     2733   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     2734   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     2735   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     2736   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     2737   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     2738   define variable varb-code          like ub.bar-code.b-code       no-undo.
     2739   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     2740   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     2741   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     2742   define variable varexcise          like ub.price-list.excise     no-undo.
     2743   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     2744   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     2745   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     2746   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     2747   define variable v-varsum           as decimal                  no-undo.
     2748   define variable varprice-salef as decimal   no-undo .
     2749   define buffer bf_trn-doc             for ub.trn-doc.
     2750   define buffer bf_doc-line            for ub.doc-line.
     2751   define buffer bf_gds-dtl             for ub.gds-dtl.
     2752   define buffer bf_goods               for ub.goods.
     2753   define buffer bf_parts               for ub.parts.
     2754   define buffer bf_sysconf             for ub.sysconf.
     2755   define buffer bf_tt-allsum-line      for tt-allsum-line.
     2756   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     2757   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     2758   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     2759   define buffer buf_parts        for ub.parts.
     2760   v-calcbypart = no.
     2761   do on error undo, return error return-value :
     2762   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2763   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2764     (output varr-b
     2765     )  .
     2766     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     2767     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     2768     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     2769                               bf_goods.prod-type = bf_doc-line.prod-type and
     2770                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     2771     if bf_trn-doc.fact-date <> ?        then do:
     2772       assign v-tax-date = bf_trn-doc.fact-date.
     2773     end.
     2774     else do:
     2775       assign v-tax-date = ?.
     2776     end.
     2777   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2778   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2779     (input  bf_goods.gds-code
     2780     ,input  '1':U
     2781     ,input  v-tax-date
     2782     ,input  bf_trn-doc.host-code
     2783     ,input  bf_trn-doc.obj-type
     2784     ,input  bf_trn-doc.obj-code
     2785     ,output v-vat-pc
     2786     ) no-error .
     2787     if error-status :error
     2788     or v-vat-pc = ? then do:
     2789        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     2790     end.
     2791     if bf_goods.gds-type = 'у':U or
     2792        bf_trn-doc.status_ = 'запрос':U then do:
     2793       for each bf_tt-allsum-line
     2794       on error undo, return error return-value
     2795        :
     2796         delete bf_tt-allsum-line.
     2797       end.
     2798       create bf_tt-allsum-line.
     2799       assign
     2800        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     2801       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     2802                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     2803                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     2804                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     2805         assign
     2806           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     2807           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     2808           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     2809           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     2810           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     2811           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     2812           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     2813           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     2814           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     2815           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     2816           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     2817           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     2818           bf_tt-allsum-line.vat-cli-acc          =  ?
     2819           .
     2820       end.
     2821       assign
     2822         bf_tt-allsum-line.cli-qnty             =  ?
     2823         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2824         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2825         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2826         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2827         bf_tt-allsum-line.road-tax-base-doc    =  0
     2828         bf_tt-allsum-line.road-tax-rubl-doc    =  0
     2829         bf_tt-allsum-line.excise-base-doc      =  0
     2830         bf_tt-allsum-line.excise-rubl-doc      =  0
     2831         bf_tt-allsum-line.vat-base-doc         =  bf_tt-allsum-line.vat-base-buyer-doc
