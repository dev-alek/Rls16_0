     1813       excise-base-salecl      =  (if parexcise   = ? then 0 else parexcise   * 1)
     1814     .
     1815   end.
     1816   else do:
     1817     assign
     1818           road-tax-base-salecl    =  (if parroad-tax = ? then 0 else parroad-tax / parbase-rate * parbase-scale)
     1819       excise-base-salecl      =  (if parexcise   = ? then 0 else parexcise   / parbase-rate * parbase-scale)
     1820     .
     1821   end.
     1822   if varoutvprbcl = "rubl":u then do:
     1823     assign
