     2657       bfsacc_tt-allsum.cli-qnty            = bfs_tt-allsum.cli-qnty
     2658       bfsacc_tt-allsum.sum-dsc-base-doc    = bfs_tt-allsum.sum-dsc-base-acc
     2659       bfsacc_tt-allsum.sum-dsc-rubl-doc    = bfs_tt-allsum.sum-dsc-rubl-acc
     2660       bfsacc_tt-allsum.dsc-base-doc        = bfs_tt-allsum.dsc-base-acc
     2661       bfsacc_tt-allsum.dsc-rubl-doc        = bfs_tt-allsum.dsc-rubl-acc
     2662       bfsacc_tt-allsum.vat-base-doc        = 0
     2663       bfsacc_tt-allsum.vat-rubl-doc        = 0
