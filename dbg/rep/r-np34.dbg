        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-rec-id      as recid.
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: r-np34.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: rep/r-np34.p $":U .
        9   define variable vss-description as character no-undo init "Форма НП-34".
       10   define variable g#report-num  as integer      no-undo .
       11   define variable g#quest-print as logical no-undo .
       12   define variable g#log         as logical no-undo .
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       72   procedure cur-time :
       73      define output parameter p-today as date      no-undo .
       74      define output parameter p-time  as integer   no-undo .
       75     do
       76     on error undo, return error
       77     :
       78       define variable v-date1 as date      no-undo .
       79       define variable v-date2 as date      no-undo .
       80       define variable v-time  as integer   no-undo .
       81       assign
       82         v-date1 = today
       83         v-time  = time
       84         v-date2 = today
       85       .
       86       if v-date1 <> v-date2
       87       then do:
       88         assign
       89           v-date1 = today
       90           v-time  = v-time
       91         .
       92       end.
       93       assign
       94         p-today = v-date1
       95         p-time  = v-time
       96       .
       97     end.
       98   end.
       99   function cur-time-date returns character
      100   :
      101     return string(today, '99/99/9999':U) .
      102   end.
      103   function cur-time-mjd returns decimal
      104   :
      105     define variable v-date as date      no-undo .
      106     define variable v-time as integer   no-undo .
      107     run cur-time in this-procedure
      108       (output v-date
      109       ,output v-time
      110       ) .
      111     return integer(v-date) - 2400002 + (v-time / 86400) .
      112   end.
      113   function cur-time-get-ending-index returns integer
      114   (input p-number as integer
      115   )
      116   :
      117     if p-number < 0
      118     or p-number = ?
      119     then do:
      120       return 1 .
      121     end.
      122     define variable v-rest as integer   no-undo .
      123     assign
      124       p-number = p-number modulo 100
      125     .
      126     if p-number < 20
      127     then do:
      128       assign
      129         v-rest = p-number
      130       .
      131     end.
      132     else do:
      133       assign
      134         v-rest = p-number modulo 10
      135       .
      136     end.
      137     case v-rest :
      138       when 1
      139       then do:
      140         return 2 .
      141       end.
      142       when 2 or
      143       when 3 or
      144       when 4
      145       then do:
      146         return 3 .
      147       end.
      148       otherwise do:
      149         return 1 .
      150       end.
      151     end case .
      152   end.
      153   procedure cur-time-mjd-to-date :
      154      define input  parameter i-mjd-diff as decimal no-undo.
      155      define output parameter o-Date     as date    no-undo.
      156      define output parameter o-Time     as integer no-undo.
      157      define variable v-day-number as integer   no-undo .
      158      if    i-mjd-diff < 0
      159         or i-mjd-diff = ?
      160      then do:
      161         return "?" .
      162      end.
      163      assign
      164         v-day-number = truncate(i-mjd-diff,0).
      165         o-Date = date(v-day-number + 2400002).
      166         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      167     .
      168   end.
      169   function cur-time-mjd-to-string returns character
      170   (input p-mjd-diff as decimal
      171   )
      172   :
      173     define variable v-day-number as integer   no-undo .
      174     define variable v-seconds    as integer   no-undo .
      175     define variable v-hour       as integer   no-undo .
      176     define variable v-min        as integer   no-undo .
      177     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      178     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      179     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      180     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      181     if p-mjd-diff < 0
      182     or p-mjd-diff = ?
      183     then do:
      184       return "?" .
      185     end.
      186     assign
      187       v-day-number = integer(truncate(p-mjd-diff,0))
      188       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      189     .
      190     if v-seconds > 86400
      191     then do:
      192       assign
      193         v-seconds = 86400 - 1
      194       .
      195     end.
      196     if v-seconds < 0
      197     then do:
      198       assign
      199         v-seconds = 0
      200       .
      201     end.
      202     assign
      203       v-hour = truncate(v-seconds / 3600, 0)
      204     .
      205     assign
      206       v-seconds = v-seconds modulo 3600
      207     .
      208     assign
      209       v-min = truncate(v-seconds / 60, 0)
      210     .
      211     assign
      212       v-seconds = v-seconds modulo 60
      213     .
      214     return
      215         (if v-day-number <> 0
      216           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      217           else ""
      218         )
      219       + (if v-day-number <> 0 or v-hour <> 0
      220           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      221           else ""
      222         )
      223       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      224           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      225           else ""
      226         )
      227       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      228       .
      229   end.
      230   function cur-time-string returns character
      231   :
      232     define variable v-date as date      no-undo .
      233     define variable v-time as integer   no-undo .
      234     run cur-time in this-procedure
      235       (output v-date
      236       ,output v-time
      237       ) .
      238     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      239   end.
      240   function cur-time-string-sec returns character
      241   :
      242     define variable v-date as date      no-undo .
      243     define variable v-time as integer   no-undo .
      244     run cur-time in this-procedure
      245       (output v-date
      246       ,output v-time
      247       ) .
      248     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      249   end.
      250   function cur-time-custom  returns character
      251   (input p-prefix as character
      252   ,input p-date-format as character
      253   ,input p-delimiter as character
      254   ,input p-time-format as character
      255   ,input p-suffix as character
      256   )
      257   :
      258     define variable v-date as date      no-undo .
      259     define variable v-time as integer   no-undo .
      260     run cur-time in this-procedure
      261       (output v-date
      262       ,output v-time
      263       ) .
      264     return
      265       p-prefix
      266       + string(v-date, p-date-format)
      267       + p-delimiter
      268       + string(v-time, p-time-format)
      269       + p-suffix
      270       .
      271   end.
      272   function cur-time-print  returns character
      273   :
      274     define variable v-date as date      no-undo .
      275     define variable v-time as integer   no-undo .
      276     run cur-time in this-procedure
      277       (output v-date
      278       ,output v-time
      279       ) .
      280     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      281   end.
      282   function cur-time-datetime returns datetime
      283   :
      284     define variable v-char as character no-undo .
      285     define variable v-datetime as datetime no-undo .
      286     v-char = cur-time-string().
      287     v-datetime = datetime(v-char).
      288     return  v-datetime.
      289   end.
      290   function cur-time-string-msec returns character
      291   :
      292     define variable v-date as datetime  no-undo .
      293     v-date = now.
      294     return string(v-date) .
      295   end.
      296   define new global shared variable g#library  as handle no-undo .
      297   define new global shared variable g#library2 as handle no-undo .
      298   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      299   define variable v-waitfram-action01         as character   no-undo .
      300   define variable v-waitfram-action02         as character   no-undo .
      301   define variable v-waitfram-action03         as character   no-undo .
      302   define variable mWaitFramTextBeg            as character   no-undo.
      303   define variable mWaitFramTextEnd            as character   no-undo.
      304   define variable mWaitFramView               as logical     no-undo.
      305   define variable mWaitProcEvent              as logical     no-undo init yes.
      306   define variable mWaitFramInterval           as integer     no-undo init 1 .
      307   define variable mWaitFramStop               as logical     no-undo.
      308   define variable mWaitFramStopUser           as logical     no-undo.
      309   define variable mWaitFramStopTimeOut        as logical     no-undo.
      310   define variable mWaitFramStartProc          as datetime-tz no-undo.
      311   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      312   define button B-WaitFramStop auto-end-key
      313        label "Стоп"
      314        size 10 by 1 tooltip "Остоновить процесс".
      315   define button B-viewProcInfo
      316        label "Информация"
      317        size 15 by 1 tooltip "Информация о процесс".
      318   define frame waitfram
      319     v-waitfram-action01 format "x(72)" no-label skip
      320     v-waitfram-action02 format "x(72)" no-label skip
      321     v-waitfram-action03 format "x(72)" no-label skip
      322     B-viewProcInfo
      323     B-WaitFramStop at row 4 col 30
      324     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      325     .
      326   define new global shared variable mBatchMode as logical no-undo init ?.
      327   define variable mFramBachModHandle as handle no-undo.
      328   mFramBachModHandle = frame waitfram:handle.
      329   define variable mFameOldVis as logical no-undo.
      330   define variable mVisCUrentVin as logical no-undo.
      331   if session:batch-mode
      332   then
      333      mBatchMode = yes.
      334   if mBatchMode = ? then do:
      335     mVisCUrentVin = current-window:visible.
      336     mFameOldVis = mFramBachModHandle:visible.
      337     mFramBachModHandle:visible  = yes.
      338     mBatchMode = mFramBachModHandle:visible ne yes.
      339     mFramBachModHandle:visible = mFameOldVis.
      340     current-window:visible = mVisCUrentVin.
      341   end.
      342    if  log-manager:logfile-name ne ?
      343     then DO:
      344         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      345         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      346         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      347     end.
      348   on choose of B-WaitFramStop in frame waitfram
      349   do:
      350     mWaitFramStop = yes.
      351     mWaitFramStopUser = yes.
      352   end.
      353   function waitfram-check-timeout returns logical():
      354      define variable vtime as int64 no-undo.
      355      if mWaitFramStopTimeOut
      356      then
      357         return yes.
      358      vtime = ( now - mWaitFramStartProc ) / 1000 .
      359      if     mWaitFramTimeOut ne ?
      360         and mWaitFramTimeOut ne 0
      361         and mWaitFramTimeOut lt vtime
      362      then do:
      363         mWaitFramStopTimeOut = yes.
      364      end.
      365      return mWaitFramStopTimeOut.
      366   end.
      367   procedure waitfram-hide :
      368     if not session:batch-mode
      369     then do
      370     on error undo, return error return-value
      371     :
      372       pause 0 before-hide .
      373       if not mBatchMode then
      374         hide frame waitfram .
      375     if     not mWaitFramView
      376        and mWaitProcEvent
      377     then
      378       process events .
      379     end.
      380   end procedure.
      381   procedure waitfram-show :
      382     define input  parameter p-message as character no-undo .
      383     define variable v-left-margin as integer   no-undo .
      384     if not session:batch-mode
      385     then do
      386     on error undo, return error return-value
      387     :
      388       if length(p-message) <= 70 then do:
      389         assign
      390           v-left-margin = integer((70 - length(p-message)) / 2)
      391         .
      392         assign
      393           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      394         .
      395         assign
      396           v-waitfram-action01 = " "
      397           v-waitfram-action02 = " "
      398                                    + fill(" ", v-left-margin)
      399                                    + p-message
      400           v-waitfram-action03 = " "
      401         .
      402       end.
      403       else do:
      404         define variable vRindex1 as integer no-undo.
      405         define variable vRindex2 as integer no-undo.
      406         vRindex1 = r-index(p-message," ",70).
      407         if vRindex1 = 0
      408         then
      409            vRindex1 = 70.
      410         if length(p-message)  <= vRindex1 + 70 then do:
      411           assign
      412             v-waitfram-action01 = " "
      413             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      414             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      415           .
      416         end.
      417         else do:
      418           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      419           if vRindex2 <= vRindex1
      420           then
      421              vRindex2 = vRindex1 + 70.
      422           assign
      423             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      424             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      425             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      426           .
      427         end.
      428       end.
      429       B-viewProcInfo:visible   in frame waitfram = no.
      430       B-viewProcInfo:sensitive in frame waitfram = no.
      431       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      432       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      433       if  (   mWaitFramView
      434          or  mWaitProcEvent)
      435          and not mBatchMode
      436       then
      437          display
      438             v-waitfram-action01 skip
      439             v-waitfram-action02 skip
      440             v-waitfram-action03 skip
      441          with frame waitfram .
      442       if     mWaitFramView
      443          then do:
      444             if     mWaitFramInterval ne ?
      445                and not mBatchMode
      446             then
      447                wait-for go of frame waitfram pause mWaitFramInterval.
      448          end.
      449          else
      450             if     mWaitProcEvent
      451                and not mBatchMode
      452             then
      453                process events .
      454     end.
      455   end procedure.
      456      procedure waitfram-show-this:
      457         define input  parameter iInterval as int64 no-undo.
      458         define variable vtime as int64 no-undo.
      459         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      460         mWaitFramInterval = iInterval.
      461         run waitfram-show (substitute("&1&2 &3&4" ,
      462                                       mWaitFramTextBeg ,
      463                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      464                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      465                                       mWaitFramTextEnd
      466                                      )
      467                           ).
      468      end.
      469      procedure WaitFramRunPause:
      470         define input  parameter iInterval as dec no-undo.
      471         define variable vStart  as datetime-tz no-undo.
      472         define variable vend    as datetime-tz no-undo.
      473         define variable vint as int64 no-undo.
      474         define variable vOk as logical no-undo.
      475         vStart = now.
      476         vend   = vStart.
      477         publish "WaitFramPause" (iInterval,output vOk).
      478         vend   =  now.
      479         vint = vend - vStart.
      480         vint = iInterval - vint / 1000.
      481         if     not mWaitFramStop
      482            and (   vint > 0
      483                 or (    not vOk
      484                     and iInterval eq ?
      485                     )
      486                 )
      487         then
      488            run waitfram-show-this (iInterval).
      489         vend   =  now.
      490         vint = vend - vStart.
      491         vint = iInterval - vint / 1000.
      492         if     not mWaitFramStop
      493            and vint > 0
      494         then do:
      495            run gbl/pause.p (vint * 1000).
      496         end.
      497         if iInterval ne ?
      498         then
      499            publish "WaitFramStop".
      500         waitfram-check-timeout().
      501      end.
      502      procedure WaitFramWaitFor:
      503         define input  parameter iInterval as dec no-undo.
      504         assign
      505            mWaitFramStartProc   = now
      506            mWaitFramStopUser    = no
      507            mWaitFramStopTimeOut = no
      508         .
      509         block-wait:
      510         do while not mWaitFramStop:
      511            run WaitFramRunPause (iInterval).
      512            if  waitfram-check-timeout()
      513            then do:
      514               leave block-wait.
      515            end.
      516         end.
      517         run waitfram-hide.
      518      end.
      519   procedure waitfram-join :
      520     define input  parameter p-line-1  as character no-undo .
      521     define input  parameter p-line-2  as character no-undo .
      522     define input  parameter p-line-3  as character no-undo .
      523     define output parameter p-message as character no-undo .
      524     do
      525     on error undo, return error return-value
      526     :
      527       assign
      528         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      529                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      530                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      531       .
      532     end.
      533   end procedure.
      534   function waitfram-join-function returns character
      535     (input p-line-1 as character
      536     ,input p-line-2 as character
      537     ,input p-line-3 as character
      538     ).
      539     define variable v-message as character no-undo .
      540     run waitfram-join in this-procedure
      541       (input  p-line-1
      542       ,input  p-line-2
      543       ,input  p-line-3
      544       ,output v-message
      545       ) .
      546     return v-message .
      547   end function .
      548   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      549   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      550   define  shared variable RepPathName        as character no-undo .
      551   define  shared variable PrintRubl          as logical   no-undo .
      552   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      553   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      554   procedure paramls-clear :
      555     define buffer buf_temp-param for temp-param .
      556     do
      557     on error undo, return error return-value
      558     :
      559       for each buf_temp-param
      560       on error undo, return error
      561       :
      562         delete buf_temp-param .
      563       end.
      564     end.
      565   end procedure.
      566   procedure paramls-write :
      567     define input  parameter p-code     as character no-undo .
      568     define input  parameter p-sub-code as character no-undo .
      569     define input  parameter p-value    as character no-undo .
      570     define buffer buf_temp-param for temp-param .
      571     do
      572     on error undo, return error return-value
      573     :
      574       find first buf_temp-param
      575         where buf_temp-param.param-code     = p-code
      576           and buf_temp-param.param-sub-code = p-sub-code
      577         no-error .
      578       if not available buf_temp-param then do:
      579         create buf_temp-param .
      580         assign
      581           buf_temp-param.param-code     = p-code
      582           buf_temp-param.param-sub-code = p-sub-code
      583         .
      584       end.
      585       assign
      586         buf_temp-param.param-value = p-value
      587       .
      588     end.
      589   end procedure.
      590   procedure paramls-read :
      591     define input  parameter p-code          as character no-undo .
      592     define input  parameter p-sub-code      as character no-undo .
      593     define input  parameter p-default-value as character no-undo .
      594     define output parameter p-value         as character no-undo .
      595     define buffer buf_temp-param for temp-param .
      596     do
      597     on error undo, return error return-value
      598     :
      599       find first buf_temp-param
      600         where buf_temp-param.param-code     = p-code
      601           and buf_temp-param.param-sub-code = p-sub-code
      602         no-error .
      603       if available buf_temp-param then do:
      604         assign
      605           p-value = buf_temp-param.param-value
      606         .
      607       end.
      608       else do:
      609         assign
      610           p-value = p-default-value
      611         .
      612       end.
      613     end.
      614   end procedure.
      615   procedure paramls-append :
      616     define input  parameter p-code     as character no-undo .
      617     define input  parameter p-sub-code as character no-undo .
      618     define input  parameter p-value    as character no-undo .
      619     define buffer buf_temp-param for temp-param .
      620     do
      621     on error undo, return error return-value
      622     :
      623       find first buf_temp-param
      624            where buf_temp-param.param-code     = p-code
      625              and buf_temp-param.param-sub-code = p-sub-code
      626         no-error .
      627       if not available buf_temp-param then do:
      628         create buf_temp-param .
      629         assign
      630           buf_temp-param.param-code     = p-code
      631           buf_temp-param.param-sub-code = p-sub-code
      632           buf_temp-param.param-value    = p-value
      633         .
      634       end.
      635       else do:
      636           assign
      637               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      638           .
      639       end.
      640     end.
      641   end procedure.
      642   define variable vss-include-info4 as character format "X(65)" no-undo
      643   initial "@(#)$Workfile$ $Revision$".
      644   DEFINE VARIABLE v-np34-xl-current-data-row AS INTEGER   NO-UNDO.
      645   DEFINE VARIABLE v-np34-xl-cell-file-name   AS CHARACTER NO-UNDO.
      646   DEFINE VARIABLE v-np34-xl-data-file-name   AS CHARACTER NO-UNDO.
      647   DEFINE STREAM excel-line.
      648   DEFINE STREAM excel-cell.
      649   define temp-table temp_cell-data no-undo
      650       field data-key as character
      651       field data-value as character
      652       index pi is primary unique data-key
      653   .
      654   define temp-table temp_line-data no-undo
      655       field data-key      as character
      656       field xl-line-id    as integer
      657       field number             as character
      658       field gds_name           as character
      659       field gds_code           as character
      660       field auto               as character
      661       field income_qnty_t      as character
      662       field normal_wastage     as character
      663       field wastage_qnty       as character
      664       field total_wast_qnty      as character
      665       field price              as character
      666       field summ               as character
      667       index pi is primary unique
      668           xl-line-id
      669   .
      670   PROCEDURE np34-xl-init :
      671   DO
      672   ON ERROR UNDO, RETURN ERROR
      673   :
      674      ASSIGN
      675         v-np34-xl-current-data-row = 0
      676      .
      677      run gbl/_tmpfile.p (
      678            INPUT "xd"
      679         , INPUT ".txt"
      680         , OUTPUT v-np34-xl-data-file-name
      681      ).
      682      OUTPUT STREAM excel-line TO value( v-np34-xl-data-file-name ).
      683      run gbl/_tmpfile.p (
      684            INPUT "xc"
      685         , INPUT ".txt"
      686         , OUTPUT v-np34-xl-cell-file-name
      687      ).
      688      OUTPUT STREAM excel-cell TO value( v-np34-xl-cell-file-name ).
      689      run np34-xl-write-cell-data in this-procedure (
      690            input "valutCode":U
      691         , input "1":U
      692      ).
      693      RUN np34-xl-write-cell-data IN THIS-PROCEDURE (
      694            INPUT "columnList":U
      695         , INPUT "number,gds_name,gds_code,auto,income_qnty_t,normal_wastage,wastage_qnty,total_wast_qnty,price,summ":U
      696      ).
      697      RUN np34-xl-write-cell-data IN THIS-PROCEDURE (
      698            INPUT "columnType":U
      699         , INPUT "S,S,S,S,S,S,S,S,S,S":U
      700      ).
      701      RUN np34-xl-write-cell-data IN THIS-PROCEDURE (
      702            INPUT "columnAmount":U
      703         , INPUT "10":U
      704      ).
      705   END.
      706   END PROCEDURE.
      707   PROCEDURE np34-xl-close :
      708   DO
      709   ON ERROR UNDO, RETURN ERROR
      710   :
      711       OUTPUT STREAM excel-line CLOSE.
      712       OUTPUT STREAM excel-cell CLOSE.
      713       OUTPUT TO value( STRING( SESSION:temp-directory + "rpt" + STRING( g#report-num ) ) + ".txl" )  .
      714           EXPORT "exe/rep-np34.xlt":U.
      715           EXPORT "exe/t_97.bas":U.
      716           EXPORT v-np34-xl-cell-file-name.
      717           EXPORT v-np34-xl-data-file-name.
      718       OUTPUT CLOSE.
      719   END.
      720   END PROCEDURE.
      721   PROCEDURE np34-xl-write-cell-data :
      722   DEFINE INPUT PARAMETER p-data-key   AS CHARACTER NO-UNDO.
      723   DEFINE INPUT PARAMETER p-data-value AS CHARACTER NO-UNDO.
      724   define buffer buf_temp_cell-data     for temp_cell-data.
      725   DO
      726   ON ERROR UNDO, RETURN ERROR
      727   :
      728       find first buf_temp_cell-data
      729            where buf_temp_cell-data.data-key = p-data-key
      730       no-error.
      731       if not available buf_temp_cell-data
      732       then do:
      733           create buf_temp_cell-data.
      734           assign
      735               buf_temp_cell-data.data-key = p-data-key
      736           .
      737       end.
      738       assign
      739           buf_temp_cell-data.data-value = p-data-value
      740       .
      741       put stream excel-cell unformatted
      742                           buf_temp_cell-data.data-key
      743           chr(9)   buf_temp_cell-data.data-value
      744           chr(10)
      745       .
      746   end.
      747   end procedure.
      748   PROCEDURE np34-xl-write-line-data :
      749   DEFINE INPUT PARAMETER p-number         AS CHARACTER NO-UNDO.
      750   DEFINE INPUT PARAMETER p-gds_name       AS CHARACTER NO-UNDO.
      751   DEFINE INPUT PARAMETER p-gds_code       AS CHARACTER NO-UNDO.
      752   DEFINE INPUT PARAMETER p-auto           AS CHARACTER NO-UNDO.
      753   DEFINE INPUT PARAMETER p-income_qnty_t  AS CHARACTER NO-UNDO.
      754   DEFINE INPUT PARAMETER p-normal_wastage AS CHARACTER NO-UNDO.
      755   DEFINE INPUT PARAMETER p-wastage_qnty   AS CHARACTER NO-UNDO.
      756   DEFINE INPUT PARAMETER p-total_wast_qnty  AS CHARACTER NO-UNDO.
      757   DEFINE INPUT PARAMETER p-price          AS CHARACTER NO-UNDO.
      758   DEFINE INPUT PARAMETER p-summ           AS CHARACTER NO-UNDO.
      759   define buffer buf_temp_line-data        for temp_line-data.
      760   DO
      761   ON ERROR UNDO, RETURN ERROR
      762   :
      763       for each buf_temp_line-data
      764       :
      765           delete buf_temp_line-data.
      766       end.
      767       create buf_temp_line-data.
      768       assign
      769           v-np34-xl-current-data-row = v-np34-xl-current-data-row + 1
      770       .
      771       assign
      772           buf_temp_line-data.data-key   = "LD":U
      773           buf_temp_line-data.xl-line-id = v-np34-xl-current-data-row
      774           buf_temp_line-data.number          = p-number
      775           buf_temp_line-data.gds_name        = p-gds_name
      776           buf_temp_line-data.gds_code        = p-gds_code
      777           buf_temp_line-data.auto            = p-auto
      778           buf_temp_line-data.income_qnty_t   = p-income_qnty_t
      779           buf_temp_line-data.normal_wastage  = p-normal_wastage
      780           buf_temp_line-data.wastage_qnty    = p-wastage_qnty
      781           buf_temp_line-data.total_wast_qnty   = p-total_wast_qnty
      782           buf_temp_line-data.price           = p-price
      783           buf_temp_line-data.summ            = p-summ
      784       .
      785       PUT STREAM excel-line UNFORMATTED
      786                           buf_temp_line-data.data-key
      787           chr(9)   p-number
      788           chr(9)   p-gds_name
      789           chr(9)   p-gds_code
      790           chr(9)   p-auto
      791           chr(9)   p-income_qnty_t
      792           chr(9)   p-normal_wastage
      793           chr(9)   p-wastage_qnty
      794           chr(9)   p-total_wast_qnty
      795           chr(9)   p-price
      796           chr(9)   p-summ
      797           chr(10)
      798       .
      799   END.
      800   END PROCEDURE.
      801   PROCEDURE np34-xl-run-excel :
      802   DEFINE INPUT PARAMETER p-header-filename    AS CHARACTER        NO-UNDO.
      803   DEFINE INPUT PARAMETER p-data-filename      AS CHARACTER        NO-UNDO.
      804   DEFINE VARIABLE v-template-file-name    AS CHARACTER    NO-UNDO.
      805   DEFINE VARIABLE v-vb-file-name          AS CHARACTER    NO-UNDO.
      806   DEFINE BUFFER buf_temp-param FOR temp-param .
      807   DO
      808   FOR buf_temp-param
      809   ON ERROR UNDO, RETURN ERROR
      810   :
      811       CREATE buf_temp-param.
      812       ASSIGN
      813           v-template-file-name    = SEARCH( "exe/rep-np34.xlt" )
      814           v-vb-file-name          = SEARCH( "exe/t_97.bas")
      815       .
      816       IF v-template-file-name = ?
      817       OR v-template-file-name = "":U
      818       THEN DO:
      819           MESSAGE
      820               "Ошибка имени файла шаблона."
      821           VIEW-AS ALERT-BOX ERROR.
      822       END.
      823       IF v-vb-file-name = ?
      824       OR v-vb-file-name = "":U
      825       THEN DO:
      826           MESSAGE
      827               "Ошибка имени файла кода обработки."
      828           VIEW-AS ALERT-BOX ERROR.
      829       END.
      830       RUN paramls-write IN THIS-PROCEDURE (
      831             INPUT "template":U
      832           , INPUT "template-file-name":U
      833           , INPUT v-template-file-name
      834       ).
      835       RUN paramls-write IN THIS-PROCEDURE (
      836             INPUT "template":U
      837           , INPUT "vb-file-name":U
      838           , INPUT v-vb-file-name
      839       ).
      840       RUN PARAMLS-WRITE IN THIS-PROCEDURE (
      841             INPUT "data":U
      842           , INPUT "data-header-filename":U
      843           , INPUT p-header-filename
      844       ).
      845       RUN paramls-write IN THIS-PROCEDURE (
      846             INPUT "data":U
      847           , INPUT "data-filename":U
      848           , INPUT p-data-filename
      849       ).
      850       run gbl/macroxlt.p (
      851           INPUT-OUTPUT table buf_temp-param
      852       ) NO-ERROR.
      853       IF ERROR-STATUS :ERROR
      854       THEN DO:
      855           MESSAGE
      856                    vss-workfile vss-revision vss-description
      857               SKIP(1)
      858               SKIP "Ошибка создания файла Excel."
      859               SKIP RETURN-VALUE
      860               SKIP TRIM(ERROR-STATUS :GET-MESSAGE(1))
      861                    TRIM(ERROR-STATUS :GET-MESSAGE(2))
      862                    TRIM(ERROR-STATUS :GET-MESSAGE(3))
      863           VIEW-AS ALERT-BOX ERROR.
      864           UNDO, RETURN ERROR .
      865       END.
      866   END.
      867   END PROCEDURE.
      868   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      869   procedure factord :
      870     define input  parameter p-fact-date            as date    no-undo .
      871     define input  parameter p-fact-time            as integer no-undo .
      872     define input  parameter p-fact-num             as integer no-undo .
      873     define input  parameter p-shift-date           as date    no-undo .
      874     define input  parameter p-shift-num            as integer no-undo .
      875     define input  parameter p-shift-on             as logical no-undo .
      876     define output parameter p-fact-order           as decimal no-undo .
      877     define output parameter p-shift-end-fact-order as decimal no-undo .
      878     define output parameter p-day-end-fact-order   as decimal no-undo .
      879     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      880     if p-fact-date = ?
      881     then do:
      882       return error "Не указана фактическая дата" .
      883     end.
      884     define variable v-fact-date-num as integer no-undo .
      885     assign
      886       v-fact-date-num = integer(p-fact-date)
      887     .
      888     if p-fact-num = ?
      889     or p-fact-num = 0
      890     then do:
      891       return error "Не задан p-fact-num " + string(p-fact-num) .
      892     end.
      893     if p-fact-num < 0
      894     then do:
      895       return error "Отрицательный fact-num " + string(p-fact-num) .
      896     end.
      897     if p-fact-num >= 100000000
      898     then do:
      899       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      900     end.
      901     if p-shift-on = true
      902     then do:
      903       if p-shift-date = ?
      904       then do:
      905         return error "Не задана дата смены" .
      906       end.
      907       if p-shift-num = ?
      908       or p-shift-num = 0
      909       then do:
      910         return error "Не задан номер смены" .
      911       end.
      912     end.
      913     else do:
      914       assign
      915         p-shift-date = p-fact-date
      916         p-shift-num  = 24
      917       .
      918     end.
      919     define variable v-shift-offset as integer no-undo .
      920     if p-shift-date = p-fact-date
      921     then do:
      922       assign
      923         v-shift-offset = 1
      924       .
      925     end.
      926     if p-shift-date < p-fact-date
      927     then do:
      928       assign
      929         v-shift-offset = 0
      930       .
      931     end.
      932     if p-shift-date > p-fact-date
      933     then do:
      934       message
      935         vss-workfile vss-revision vss-description skip
      936         "Неправильная дата закрытия смены" skip
      937         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      938         view-as alert-box error .
      939       undo, return error
      940         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      941           ,string(p-fact-date, '99/99/9999':U)
      942           ,string(p-shift-date, '99/99/9999':U)
      943           )
      944       .
      945     end.
      946     if p-shift-num < 1
      947     or p-shift-num > 24
      948     then do:
      949       message
      950         vss-workfile vss-revision vss-description skip
      951         "Неправильный номер смены" skip
      952         "p-shift-num" p-shift-num skip
      953         view-as alert-box error .
      954       undo, return error return-value .
      955     end.
      956     assign
      957       p-fact-order           = v-fact-date-num
      958                              + v-shift-offset * 0.5
      959                              + p-shift-num    * 0.02 - 0.01
      960                              + p-fact-num     * 0.0000000001
      961       p-shift-end-fact-order = v-fact-date-num
      962                              + v-shift-offset * 0.5
      963                              + p-shift-num    * 0.02
      964       p-day-end-fact-order   = v-fact-date-num
      965                              + 0.99
      966     .
      967     if p-fact-order           <= v-fact-date-num
      968     or p-shift-end-fact-order <= v-fact-date-num
      969     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      970     or p-shift-end-fact-order >= p-day-end-fact-order
      971     then do:
      972       message
      973         vss-workfile vss-revision vss-description skip
      974         "Внутренняя ошибка при генерации фактического номера" skip
      975         "p-fact-date"            p-fact-date            skip
      976         "p-fact-time"            p-fact-time            skip
      977         "p-fact-num"             p-fact-num             skip
      978         "p-shift-date"           p-shift-date           skip
      979         "p-shift-num"            p-shift-num            skip
      980         "p-shift-on"             p-shift-on             skip
      981         "p-shift-end-fact-order" p-shift-end-fact-order skip
      982         "p-day-end-fact-order"   p-day-end-fact-order   skip
      983         "v-fact-date-num"        v-fact-date-num        skip
      984         view-as alert-box error .
      985       undo, return error return-value .
      986     end.
      987   end procedure.
      988   procedure day-begin-fact-order :
      989     define input  parameter p-fact-date            as date    no-undo .
      990     define output parameter p-day-begin-fact-order as decimal no-undo .
      991     do
      992     on error undo, return error return-value
      993     :
      994       if p-fact-date = ?
      995       then do:
      996         assign
      997           p-day-begin-fact-order = 0
      998         .
      999       end.
     1000       else do:
     1001         assign
     1002           p-day-begin-fact-order = integer(p-fact-date)
     1003         .
     1004       end.
     1005     end.
     1006   end procedure.
     1007   procedure factord-max-fact-order :
     1008     define output parameter p-max-fact-order as decimal   no-undo .
     1009     do
     1010     on error undo, return error return-value
     1011     :
     1012       run day-begin-fact-order in this-procedure
     1013         (input  date(1, 1, 5000)
     1014         ,output p-max-fact-order
     1015         ) .
     1016     end.
     1017   end procedure.
     1018   procedure factord-cut-archive :
     1019     define input  parameter p-obj-type             as character no-undo .
     1020     define input  parameter p-obj-code             as integer   no-undo .
     1021     define input  parameter p-fact-date            as date      no-undo .
     1022     define output parameter p-shift-on             as logical   no-undo .
     1023     define output parameter p-shift-date           as date      no-undo .
     1024     define output parameter p-shift-num            as integer   no-undo .
     1025     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1026     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1027     define variable v-fact-order as decimal   no-undo .
     1028     define buffer buf_shift-obj for ub.shift-obj .
     1029     do
     1030     on error undo, return error return-value
     1031     :
     1032   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1033   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1034     (input  p-obj-type
     1035     ,input  p-obj-code
     1036     ,input  'shift-on=request'
     1037     ,output p-shift-on
     1038     ) no-error .
     1039       if error-status :error
     1040       then do:
     1041         message
     1042           vss-workfile vss-revision vss-description skip
     1043           "Ошибка при определении атрибута объекта" skip
     1044           "Объект" p-obj-type p-obj-code skip
     1045           error-status :get-message(1) skip
     1046           return-value skip
     1047           view-as alert-box error .
     1048         undo, return error return-value .
     1049       end.
     1050       if p-shift-on = false
     1051       then do:
     1052         assign
     1053           p-shift-date               = ?
     1054           p-shift-num                = 0
     1055         .
     1056       end.
     1057       else do:
     1058         find first buf_shift-obj share-lock
     1059           where buf_shift-obj.obj-type   = p-obj-type
     1060             and buf_shift-obj.obj-code   = p-obj-code
     1061             and buf_shift-obj.shift-date > p-fact-date
     1062           use-index pi
     1063           no-error .
     1064         if not available buf_shift-obj
     1065         or buf_shift-obj.status_ <> 'зкр':U
     1066         then do:
     1067           message
     1068             vss-workfile vss-revision vss-description skip
     1069             "Невозможно вычислить последнюю смену" skip
     1070             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1071             "Объект" p-obj-type p-obj-code skip
     1072             "Дата" p-fact-date skip
     1073             view-as alert-box error .
     1074           undo, return error return-value .
     1075         end.
     1076         find last buf_shift-obj share-lock
     1077           where buf_shift-obj.obj-type = p-obj-type
     1078             and buf_shift-obj.obj-code = p-obj-code
     1079             and buf_shift-obj.shift-date <= p-fact-date
     1080           use-index pi
     1081           no-error .
     1082         if available buf_shift-obj
     1083         then do:
     1084           if  buf_shift-obj.status_ = 'зкр':U
     1085           then do:
     1086             assign
     1087               p-shift-date = buf_shift-obj.shift-date
     1088               p-shift-num  = buf_shift-obj.shift-num
     1089             .
     1090           end.
     1091           else do:
     1092             message
     1093               vss-workfile vss-revision vss-description skip
     1094               "Невозможно вычислить последнюю смену" skip
     1095               "Статус смены отличен от статуса" 'зкр':U skip
     1096               "Объект" p-obj-type p-obj-code skip
     1097               "Дата" p-fact-date skip
     1098               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1099               view-as alert-box error .
     1100             undo, return error return-value .
     1101           end.
     1102         end.
     1103         else do:
     1104           assign
     1105             p-shift-date = p-fact-date - 1
     1106             p-shift-num  = 1
     1107           .
     1108         end.
     1109       end.
     1110       run factord in this-procedure
     1111         (input  p-fact-date
     1112         ,input  1
     1113         ,input  1
     1114         ,input  p-shift-date
     1115         ,input  p-shift-num
     1116         ,input  p-shift-on
     1117         ,output v-fact-order
     1118         ,output p-shift-end-fact-order
     1119         ,output p-day-end-fact-order
     1120         ) no-error .
     1121       if error-status :error
     1122       then do:
     1123         message
     1124           vss-workfile vss-revision vss-description skip
     1125           "Ошибка при вызове процедуры factord"
     1126           error-status :get-message(1) skip
     1127           return-value skip
     1128           view-as alert-box error .
     1129         undo, return error return-value .
     1130       end.
     1131     end.
     1132   end procedure.
     1133   procedure factord-lock-shift :
     1134     define input  parameter p-obj-type  as character no-undo .
     1135     define input  parameter p-obj-code  as integer   no-undo .
     1136     define input  parameter p-fact-date as date      no-undo .
     1137     define parameter buffer buf_shift-obj for ub.shift-obj .
     1138     define variable v-shift-on      as logical   no-undo .
     1139     define variable v-extra-message as character no-undo .
     1140     define variable v-error as character no-undo .
     1141     do
     1142     on error undo, return error return-value
     1143     :
     1144   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1145   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1146     (input  p-obj-type
     1147     ,input  p-obj-code
     1148     ,input  'shift-on=request'
     1149     ,output v-shift-on
     1150     ) no-error .
     1151       if error-status :error
     1152       then do:
     1153         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1154         undo, return error v-error .
     1155       end.
     1156       if v-shift-on = true
     1157       then do:
     1158         find first buf_shift-obj share-lock
     1159           where buf_shift-obj.obj-type   = p-obj-type
     1160             and buf_shift-obj.obj-code   = p-obj-code
     1161             and buf_shift-obj.shift-date > p-fact-date
     1162           use-index pi
     1163           no-error .
     1164         if not available buf_shift-obj
     1165         or buf_shift-obj.status_ <> 'зкр':U
     1166         then do:
     1167           find last buf_shift-obj
     1168             where buf_shift-obj.obj-type = p-obj-type
     1169               and buf_shift-obj.obj-code = p-obj-code
     1170               and buf_shift-obj.status_  = 'зкр':U
     1171             use-index stts
     1172             no-error .
     1173           if available buf_shift-obj
     1174           then do:
     1175             assign
     1176               v-extra-message =
     1177                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1178                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1179                               )
     1180             .
     1181           end.
     1182           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1183           undo, return error v-error .
     1184         end.
     1185       end.
     1186     end.
     1187   end procedure.
     1188   procedure factord-end-day :
     1189     define input  parameter p-fact-date            as date    no-undo .
     1190     define output parameter p-day-end-fact-order   as decimal no-undo .
     1191     do
     1192     on error undo, return error return-value
     1193     :
     1194       if p-fact-date = ?
     1195       then do:
     1196         return error "Не указана фактическая дата" .
     1197       end.
     1198       assign
     1199         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1200       .
     1201     end.
     1202   end procedure.
     1203   procedure factord-to-date :
     1204     define input  parameter p-fact-order as decimal no-undo .
     1205     define output parameter p-fact-date  as date    no-undo .
     1206     define variable v-ref-date  as date      no-undo .
     1207     define variable v-ref-delta as integer   no-undo .
     1208     do
     1209     on error undo, return error return-value
     1210     :
     1211       if p-fact-order = ?
     1212       or p-fact-order = 0
     1213       then do:
     1214         return error "Не указан fact-order" .
     1215       end.
     1216       assign
     1217         v-ref-date  = date(1, 1, 2000)
     1218       .
     1219       assign
     1220         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1221       .
     1222       assign
     1223         p-fact-date = v-ref-date + v-ref-delta
     1224       .
     1225     end.
     1226   end procedure.
     1227   procedure factord-to-fact-num :
     1228     define input  parameter p-fact-order as decimal no-undo .
     1229     define output parameter p-fact-num   as integer no-undo .
     1230     define variable v-fact-order-trunc as decimal no-undo .
     1231     do
     1232     on error undo, return error return-value
     1233     :
     1234       if p-fact-order = ?
     1235       or p-fact-order = 0
     1236       then do:
     1237         return error "Не указан fact-order" .
     1238       end.
     1239       assign
     1240        v-fact-order-trunc = truncate(p-fact-order, 2)
     1241       .
     1242       assign
     1243         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1244       .
     1245     end.
     1246   end procedure.
     1247   procedure factord-to-shift-num :
     1248     define input  parameter p-fact-order as decimal no-undo .
     1249     define output parameter p-shift-num   as integer no-undo .
     1250     define variable  p-shift-numd  as decimal   no-undo .
     1251     define variable v-fact-order-trunc as decimal no-undo .
     1252     do
     1253     on error undo, return error return-value
     1254     :
     1255       if p-fact-order = ?
     1256       or p-fact-order = 0
     1257       then do:
     1258         return error "Не указан fact-order" .
     1259       end.
     1260       assign
     1261        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1262       .
     1263       if v-fact-order-trunc < 0.5 then do:
     1264         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1265       end.
     1266       assign
     1267         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1268         .
     1269        assign
     1270         p-shift-num = truncate (p-shift-numd , 0)
     1271       .
     1272     end.
     1273   end procedure.
