     3145           trim(error-status :get-message(5)) skip
     3146           view-as alert-box error.
     3147         undo, return error .
     3148       end.
     3149     end.
     3150   end.
     3151   end.
     3152   procedure clcprtsl_calc-ttable :
     3153   define input parameter paris-doc           as   logical                 no-undo.
     3154   define input parameter paris-cur           as   logical                 no-undo.
     3155   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     3156   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     3157   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     3158   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     3159   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     3160   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     3161   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     3162   define input parameter parr-b              as   character               no-undo.
     3163   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     3164   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     3165   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     3166   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     3167   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     3168   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     3169   define buffer bf_tt-allsum      for tt-allsum.
     3170   define buffer bf_tt-clcparts    for tt-clcparts.
     3171   define buffer bf_tt-allsum-line for tt-allsum-line.
     3172   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     3173   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     3174   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     3175   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     3176   define variable varexcise          like ub.price-list.excise     no-undo.
     3177   do on error undo, return error return-value :
     3178   for each bf_tt-allsum-line
     3179   on error undo, return error return-value
     3180    :
     3181     delete bf_tt-allsum-line.
     3182   end.
     3183   for each bf_tt-allsum
     3184   on error undo, return error return-value
     3185   :
     3186     delete bf_tt-allsum.
     3187   end.
     3188   for each bf_tt-clcparts
     3189   on error undo, return error return-value
     3190   :
     3191   if v-calcbypart then do:
     3192             assign
     3193             parcur-base =   bf_tt-clcparts.part-cur-base
     3194             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     3195             parcur-excise =   bf_tt-clcparts.part-cur-excise
     3196             .
     3197   end.
     3198      run clcprtsl_calc-parts in this-procedure (
     3199        input recid(bf_tt-clcparts),
     3200        input paris-doc,
     3201        input paris-cur,
     3202        input parroad-tax,
     3203        input parexcise,
     3204        input parvat-pc,
     3205        input parcons-vat-pc,
     3206        input parslt-pc,
     3207        input parbase-rate,
     3208        input parbase-scale,
     3209        input parr-b,
     3210        input parcur-base,
     3211        input parcur-road-tax,
     3212        input parcur-excise,
     3213        input parcur-vat-pc,
     3214        input parcurcons-vat-pc,
     3215        input parcurslt-pc
     3216        ) no-error.
     3217     if error-status:error then do:
     3218       message
     3219         vss-workfile vss-revision vss-description skip
     3220         vss-include-info8 skip
     3221         "Ошибка при обсчете партии" skip
     3222         "Документ партии " bf_tt-clcparts.out-code skip
     3223         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     3224         return-value skip
     3225         error-status:get-message(1) skip
     3226         error-status:get-message(2) skip
     3227         error-status:get-message(3) skip
     3228         view-as alert-box error .
     3229       undo, return error .
     3230     end.
     3231     for each bf_tt-allsum on error undo, return error return-value :
     3232       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     3233       if not available bf_tt-allsum-line then do:
     3234         create bf_tt-allsum-line.
     3235         assign
     3236           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     3237       end.
     3238       assign
     3239         bf_tt-allsum-line.fact-qnty              = bf_tt-allsum-line.fact-qnty            + bf_tt-allsum.fact-qnty
     3240         bf_tt-allsum-line.cli-qnty               = bf_tt-allsum-line.cli-qnty             + bf_tt-allsum.cli-qnty
