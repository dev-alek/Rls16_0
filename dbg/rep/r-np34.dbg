     3298   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3299     define variable v-cntxt-db-num        as integer   no-undo .
     3300     define variable v-cntxt-userid        as character no-undo .
     3301     define variable v-cntxt-level         as character no-undo .
     3302     define variable v-cntxt-host-code-obj as integer   no-undo .
     3303     define variable v-cntxt-obj-type      as character no-undo .
     3304     define variable v-cntxt-obj-code      as integer   no-undo .
     3305     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3306     define variable v-cntxt-is-admin      as logical   no-undo .
     3307   define variable v-account as integer init 0 no-undo .
     3308   define variable v-account-lavel as character no-undo .
     3309   define variable v-button-stop as logical no-undo .
     3310   define variable v-kol-spice as integer no-undo .
     3311   define variable v-kol-spice2 as integer no-undo .
     3312   define variable v-kol-spice3 as integer no-undo .
     3313   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     3314   DEFINE BUTTON StopBtn AUTO-END-KEY
     3315        LABEL "Стоп"
     3316        SIZE 10 BY 1.
     3317   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     3318        LABEL "Обработано записей"
     3319         VIEW-AS TEXT
     3320        SIZE 14 BY .67 NO-UNDO.
     3321   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     3322         VIEW-AS TEXT
     3323        SIZE 53.25 BY .67
     3324        FGCOLOR 1  NO-UNDO.
     3325   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     3326         VIEW-AS TEXT
     3327        SIZE 53.25 BY .67
     3328        FGCOLOR 1  NO-UNDO.
     3329   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     3330         VIEW-AS TEXT
     3331        SIZE 53.25 BY .67
     3332        FGCOLOR 1  NO-UNDO.
     3333   DEFINE RECTANGLE RECT-1
     3334        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     3335        SIZE 55.13 BY 4.46.
     3336   DEFINE FRAME InfoFrame
     3337        StopBtn AT ROW 4.25 COL 21.75
     3338        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     3339        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     3340        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     3341        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     3342        RECT-1 AT ROW 1 COL 1
     3343       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     3344            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     3345            TITLE "Процесс"
     3346            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     3347   define variable mFrameView      as logical   no-undo init yes.
     3348     define variable mFramHandle as handle no-undo.
     3349     mFramHandle = frame InfoFrame:handle.
     3350     if  log-manager:logfile-name ne ?
     3351     then DO:
     3352         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     3353         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     3354         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     3355     end.
     3356     mFrameView = not session:batch-mode and mFramHandle:visible.
     3357     if mFrameView
     3358     then do:
     3359       ASSIGN
     3360          FRAME InfoFrame:HIDDEN                           = TRUE
     3361          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     3362     end.
     3363   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     3364   DO:
     3365     IF not StopProcessing THEN
     3366       Message "Вы действительно хотите прервать" SKIP
     3367               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     3368                 UPDATE StopProcessing.
     3369     IF StopProcessing THEN do:
     3370        if mFrameView
     3371        then do:
     3372           HIDE FRAME InfoFrame.
     3373        end.
     3374     End.
     3375   END.
     3376   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3377   define new global shared variable g#attr-lib  as handle no-undo .
     3378   define variable v-attr-lib-variable as handle no-undo .
     3379   procedure gdsoattr-name :
     3380     define input  parameter p-code           as character no-undo .
     3381     define output parameter p-type           as character no-undo .
     3382     define output parameter p-format         as character no-undo .
     3383     define output parameter p-label          as character no-undo .
     3384     define output parameter p-user-can-edit  as logical   no-undo .
     3385     define output parameter p-output-display as logical   no-undo .
     3386     define output parameter p-other          as character no-undo .
     3387     do
     3388     on error undo, return error
     3389     :
     3390           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsoattr-name in g#attr-lib
     3391         (input  p-code
     3392         ,output p-type
     3393         ,output p-format
     3394         ,output p-label
     3395         ,output p-user-can-edit
     3396         ,output p-output-display
     3397         ,output p-other
     3398         ) no-error .
     3399       if error-status :error
     3400       then do:
     3401         undo, return error return-value .
     3402       end.
     3403     end.
     3404   end.
