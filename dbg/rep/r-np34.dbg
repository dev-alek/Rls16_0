     3027                 varroad-tax   = 0
     3028                 varexcise     = 0
     3029               .
     3030             end.
     3031             assign
     3032               varlastcur-base     = varprice-sale
     3033               varlastcur-road-tax = varroad-tax
     3034               varlastcur-excise   = varexcise
     3035               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     3036               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     3037               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     3038               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     3039             .
     3040         end.
     3041       end.
     3042       if varcur-fact-qnty = 0 then do:
     3043         assign
     3044           varcur-base      = varlastcur-base
     3045           varcur-road-tax  = varlastcur-road-tax
     3046           varcur-excise    = varlastcur-excise
     3047         .
     3048       end.
     3049       else do:
     3050         assign
     3051           varcur-base      = varcur-base      / varcur-fact-qnty
     3052           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     3053           varcur-excise    = varcur-excise    / varcur-fact-qnty
     3054         .
     3055       end.
