     4208           v-torgconf-cli-engl-name    = trim( v-fmtcli-engl-name          )
     4209           v-torgconf-cli-addres       = trim( v-fmtcli-full-addres   )
     4210           v-torgconf-cli-post-addres  = trim( v-fmtcli-post-addres   )
     4211           v-torgconf-cli-phone        = trim( v-fmtcli-phone         )
     4212           v-torgconf-cli-inn          = trim( v-fmtcli-inn           )
     4213           v-torgconf-cli-kpp          = trim( v-fmtcli-kpp           )
     4214           v-torgconf-cli-okpo         = trim( v-fmtcli-okpo          )
     4215       .
     4216      run fmtcli-get-bank in this-procedure (
     4217             input p-host-obj-code
     4218           , input p-obj-type
     4219           , input p-obj-code
     4220           , input p-curr-code
     4221       ).
     4222       assign
     4223           v-torgconf-cli-schet-exists = v-fmtcli-schet-exists
     4224           v-torgconf-cli-bank-exists  = v-fmtcli-bank-exists
     4225           v-torgconf-cli-bank-r-schet = v-fmtcli-bank-r-schet
     4226           v-torgconf-cli-bank-c-schet = v-fmtcli-bank-c-schet
     4227           v-torgconf-cli-bank-bik     = v-fmtcli-bank-bik
     4228           v-torgconf-cli-bank-name    = v-fmtcli-bank-name
     4229           v-torgconf-cli-bank-addres  = v-fmtcli-bank-addres
     4230           v-torgconf-cli-bank-city    = v-fmtcli-bank-city
     4231       .
     4232   end.
     4233   end procedure.
     4234   procedure torgconf-get-ship-param :
     4235   define input parameter p-host-obj-code      as integer          no-undo.
