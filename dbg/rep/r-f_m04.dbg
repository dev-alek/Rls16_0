     3437   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3438   procedure wthcattr-sprcli :
     3439   define input parameter parparentproc  as widget-handle no-undo.
     3440   define input parameter p-mode  as character no-undo.
     3441   define input-output parameter p-value as character no-undo .
     3442   define output parameter p-setted as logical no-undo .
     3443     DEFINE VARIABLE v-value as character no-undo .
     3444     define variable v-cli-type as character no-undo .
     3445     define variable v-cli-code as integer no-undo .
     3446     define buffer buf_clients   for ub.clients.
     3447     define variable v_rid as character no-undo.
     3448     define variable ref-rec as recid no-undo .
     3449     do
     3450     on error undo, return error
     3451     :
     3452         v-value = p-value.
     3453      if p-value <> '':U then do:
     3454       assign
     3455       v-cli-type = substring(p-value, 1, 3)
     3456       v-cli-code = integer(substring(p-value, 4))
     3457       no-error.
     3458       if error-status:error then do:
     3459         assign
     3460         v-cli-type = '':U
     3461         v-cli-code = 0
     3462         .
     3463       end.
     3464      end.
     3465      FIND FIRST buf_clients NO-LOCK WHERE
     3466               buf_clients.obj-type = v-cli-type AND
     3467               buf_clients.obj-code = v-cli-code  NO-ERROR.
     3468      IF available(buf_clients) then do:
     3469       run ref/cli-all.w (
     3470                   input parparentproc
     3471                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
     3472                  ,input v-cli-type
     3473                  ,input 'все':U
     3474                  ,input 'все':U
     3475                  ,input RECID( buf_clients )
     3476                  ,input ",,,,,,NO"
     3477                  ,input ?
     3478                  ,OUTPUT v_rid ).
     3479     END.
     3480     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     3481       run ref/cli-all.w (
     3482                    input parparentproc
     3483                   ,INPUT "b-sel":U
     3484                  ,input  v-cli-type
     3485                  ,input 'все':U
     3486                  ,input 'текущие':U
     3487                  ,input ?
     3488                  ,input ",,,,,,NO"
     3489                  ,input ?
     3490                  ,OUTPUT v_rid ).
     3491     END.
     3492     else do:
     3493       message
     3494       if p-value = "":U then 'Атрибут не задан!'
     3495       else substitute('Не найден клиент &1',p-value)
     3496       view-as alert-box warning.
     3497     end.
     3498     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     3499       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     3500       IF ERROR-STATUS:ERROR THEN DO:
     3501           RETURN NO-APPLY.
     3502       END.
     3503       FIND FIRST buf_clients NO-LOCK WHERE
     3504                  RECID( buf_clients ) = ref-rec NO-ERROR.
     3505       IF AVAIL buf_clients THEN DO:
     3506         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     3507       end.
     3508     end.
     3509     if v-value <> p-value then do:
     3510       p-value = v-value.
     3511       p-setted = yes.
     3512     end.
     3513     end.
     3514   end procedure.
     3515     define new global shared variable g#wthcalib as handle no-undo.
     3516   procedure torgconf-read :
     3517   do
     3518   on error undo, return error
     3519   :
     3520       define input parameter p-form-name  as character    no-undo.
     3521       define input parameter p-host-code  as integer      no-undo.
     3522       define input parameter p-obj-type   as character    no-undo.
     3523       define input parameter p-obj-code   as integer      no-undo.
     3524       define variable v-outdate   as character     no-undo.
     3525       define variable v-outares   as character     no-undo.
     3526       define variable v-outsend   as character     no-undo.
     3527       define variable v-outasend  as character     no-undo.
     3528       define variable v-outprops  as character     no-undo.
     3529       define variable v-outnum    as character     no-undo.
     3530       define variable v-outprim   as character     no-undo.
     3531       define variable v-outdisc   as character     no-undo.
     3532       define variable v-outsubs   as character     no-undo.
     3533       define variable v-outrecv   as character     no-undo.
     3534       define variable v-outegrp   as character     no-undo.
     3535       define variable v-outt12    as character     no-undo.
     3536       define variable v-outappr   as character     no-undo.
     3537       define variable v-outrubl   as character     no-undo.
     3538       define variable v-outhold   as character     no-undo.
     3539       define variable v-outobj    as character     no-undo.
     3540       define variable v-outexlst  as character     no-undo.
     3541       define variable v-outprncd  as character     no-undo.
     3542       define variable v-par-type  as character     no-undo.
     3543       define variable v-outogr    as character     no-undo.
     3544       define variable v-outR      as character     no-undo.
     3545       define variable v-outB      as character     no-undo.
     3546       define variable v-outC      as character     no-undo.
     3547       assign
     3548           v-torgconf-outdate  = no
     3549           v-torgconf-outnum   = no
     3550           v-torgconf-outprim  = no
     3551           v-torgconf-outdisc  = no
     3552           v-torgconf-outsubs  = no
     3553           v-torgconf-outrecv  = no
     3554           v-torgconf-outegrp  = no
     3555           v-torgconf-outt12   = no
     3556           v-torgconf-outappr  = no
     3557           v-torgconf-outrubl  = no
     3558           v-torgconf-outhold  = no
     3559           v-torgconf-outobj   = no
     3560           v-torgconf-outexlst = no
     3561           v-torgconf-outexpas = "":U
     3562           v-torgconf-outprncd = yes
     3563           v-torgconf-outares  = no
     3564           v-torgconf-outsend  = no
     3565           v-torgconf-outasend  = no
     3566           v-torgconf-outprops  = no
     3567           v-form-name          = p-form-name
     3568       .
     3569   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3570   empty temp-table thbjattr_thbj-attr.
     3571   run adm/shattri.p (
     3572      input "get":U
     3573     ,input ''
     3574     ,input 0
     3575     ,input 'prt-glob':U
     3576     ,input  ""
     3577     ,output v-value-character
     3578     ,output v-value-date
     3579     ,output v-value-decimal
     3580     ,output v-value-integer
     3581     ,output v-value-logical
     3582     ,output par-type
     3583     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     3584     ) no-error .
     3585   for each thbjattr_thbj-attr :
     3586       if thbjattr_thbj-attr.prop-code = 'outprncd':U then v-outprncd =  string(thbjattr_thbj-attr.property-value-logical) .
     3587       if thbjattr_thbj-attr.prop-code = 'outrecv':U  then v-outrecv  =  thbjattr_thbj-attr.property-value-character .
     3588       if thbjattr_thbj-attr.prop-code = 'outprops':U then v-outprops =  thbjattr_thbj-attr.property-value-character .
     3589   end.
     3590   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3591   empty temp-table thbjattr_thbj-attr.
     3592   run adm/shattri.p (
     3593      input "get":U
     3594     ,input p-obj-type
     3595     ,input p-obj-code
     3596     ,input 'prt-obj':U
     3597     ,input  ""
     3598     ,output v-value-character
     3599     ,output v-value-date
     3600     ,output v-value-decimal
     3601     ,output v-value-integer
     3602     ,output v-value-logical
     3603     ,output par-type
     3604     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     3605     ) no-error .
     3606   for each thbjattr_thbj-attr :
     3607       if thbjattr_thbj-attr.prop-code = 'outdate':U  then v-outdate  =  thbjattr_thbj-attr.property-value-character .
     3608       if thbjattr_thbj-attr.prop-code = 'outares':U  then v-outares  =  thbjattr_thbj-attr.property-value-character .
     3609       if thbjattr_thbj-attr.prop-code = 'outnum':U   then v-outnum   =  thbjattr_thbj-attr.property-value-character .
     3610       if thbjattr_thbj-attr.prop-code = 'outprim':U  then v-outprim  =  thbjattr_thbj-attr.property-value-character .
     3611       if thbjattr_thbj-attr.prop-code = 'outdisc':U  then v-outdisc  =  thbjattr_thbj-attr.property-value-character .
     3612       if thbjattr_thbj-attr.prop-code = 'outsubs':U  then v-outsubs  =  thbjattr_thbj-attr.property-value-character .
     3613       if thbjattr_thbj-attr.prop-code = 'outegrp':U  then v-outegrp  =  thbjattr_thbj-attr.property-value-character .
     3614       if thbjattr_thbj-attr.prop-code = 'outt12':U   then v-outt12   =  thbjattr_thbj-attr.property-value-character .
     3615       if thbjattr_thbj-attr.prop-code = 'outappr':U  then v-outappr  =  thbjattr_thbj-attr.property-value-character .
     3616       if thbjattr_thbj-attr.prop-code = 'outrubl':U  then v-outrubl  =  thbjattr_thbj-attr.property-value-character .
     3617       if thbjattr_thbj-attr.prop-code = 'outhold':U  then v-outhold  =  thbjattr_thbj-attr.property-value-character .
     3618       if thbjattr_thbj-attr.prop-code = 'outobj':U   then v-outobj   =  thbjattr_thbj-attr.property-value-character .
     3619       if thbjattr_thbj-attr.prop-code = 'outsend':U  then v-outsend  =  thbjattr_thbj-attr.property-value-character .
     3620       if thbjattr_thbj-attr.prop-code = 'outasend':U then v-outasend =  thbjattr_thbj-attr.property-value-character .
     3621       if thbjattr_thbj-attr.prop-code = 'outogr':U   then v-torgconf-outogr   =  thbjattr_thbj-attr.property-value-character .
     3622       if thbjattr_thbj-attr.prop-code = 'outR':U     then v-torgconf-outR     =  thbjattr_thbj-attr.property-value-character .
     3623       if thbjattr_thbj-attr.prop-code = 'outB':U     then v-torgconf-outB     =  thbjattr_thbj-attr.property-value-character .
     3624       if thbjattr_thbj-attr.prop-code = 'outssdoc':U then v-torgconf-outssdoc =  thbjattr_thbj-attr.property-value-character .
     3625       if thbjattr_thbj-attr.prop-code = 'outC':U     then v-torgconf-outC     =  thbjattr_thbj-attr.property-value-character .
     3626   end.
     3627       run gbl/conf-rd.p ("outexpas", "":U, "":U, 0, "":U, "":U, "":U, no, output v-torgconf-outexpas, output v-par-type) no-error.
     3628       if error-status :error
     3629       then do:
     3630           assign
