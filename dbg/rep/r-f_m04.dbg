     2262               .
     2263             end.
     2264             assign
     2265               varlastcur-base     = varprice-sale
     2266               varlastcur-road-tax = varroad-tax
     2267               varlastcur-excise   = varexcise
     2268               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     2269               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     2270               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     2271               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     2272             .
     2273         end.
     2274       end.
     2275       if varcur-fact-qnty = 0 then do:
     2276         assign
     2277           varcur-base      = varlastcur-base
     2278           varcur-road-tax  = varlastcur-road-tax
     2279           varcur-excise    = varlastcur-excise
     2280         .
     2281       end.
     2282       else do:
     2283         assign
     2284           varcur-base      = varcur-base      / varcur-fact-qnty
     2285           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     2286           varcur-excise    = varcur-excise    / varcur-fact-qnty
     2287         .
