     6221   DEFINE VARIABLE v-unit-code AS CHARACTER NO-UNDO FORMAT "x(3)":U.
     6222   DEFINE VARIABLE v-unit-name AS CHARACTER NO-UNDO FORMAT "x(13)":U.
     6223   DEFINE VARIABLE v-quantity1 AS DECIMAL   NO-UNDO FORMAT ">>,>>9.999":U.
     6224   DEFINE VARIABLE v-quantity2 AS DECIMAL   NO-UNDO FORMAT ">>,>>9.999":U.
     6225   DEFINE VARIABLE cost-rubl   AS DECIMAL   NO-UNDO FORMAT ">>>,>>>,>>>,>>9.99":U.
