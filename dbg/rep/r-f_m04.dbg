     2482         bf_tt-allsum-line.slt-base-doc           = bf_tt-allsum-line.slt-base-doc         + bf_tt-allsum.slt-base-doc
     2483         bf_tt-allsum-line.slt-rubl-doc           = bf_tt-allsum-line.slt-rubl-doc         + bf_tt-allsum.slt-rubl-doc
     2484         bf_tt-allsum-line.road-tax-base-doc      = bf_tt-allsum-line.road-tax-base-doc    + bf_tt-allsum.road-tax-base-doc
     2485         bf_tt-allsum-line.road-tax-rubl-doc      = bf_tt-allsum-line.road-tax-rubl-doc    + bf_tt-allsum.road-tax-rubl-doc
     2486         bf_tt-allsum-line.excise-base-doc        = bf_tt-allsum-line.excise-base-doc      + bf_tt-allsum.excise-base-doc
     2487         bf_tt-allsum-line.excise-rubl-doc        = bf_tt-allsum-line.excise-rubl-doc      + bf_tt-allsum.excise-rubl-doc
     2488         bf_tt-allsum-line.sum-dsc-base-cur       = bf_tt-allsum-line.sum-dsc-base-cur     + bf_tt-allsum.sum-dsc-base-cur
     2489         bf_tt-allsum-line.sum-dsc-rubl-cur       = bf_tt-allsum-line.sum-dsc-rubl-cur     + bf_tt-allsum.sum-dsc-rubl-cur
     2490         bf_tt-allsum-line.dsc-base-cur           = bf_tt-allsum-line.dsc-base-cur         + bf_tt-allsum.dsc-base-cur
     2491         bf_tt-allsum-line.dsc-rubl-cur           = bf_tt-allsum-line.dsc-rubl-cur         + bf_tt-allsum.dsc-rubl-cur
     2492         bf_tt-allsum-line.vat-base-cur           = bf_tt-allsum-line.vat-base-cur         + bf_tt-allsum.vat-base-cur
     2493         bf_tt-allsum-line.vat-rubl-cur           = bf_tt-allsum-line.vat-rubl-cur         + bf_tt-allsum.vat-rubl-cur
     2494         bf_tt-allsum-line.vat-base-buyer-cur     = bf_tt-allsum-line.vat-base-buyer-cur   + bf_tt-allsum.vat-base-buyer-cur
     2495         bf_tt-allsum-line.vat-rubl-buyer-cur     = bf_tt-allsum-line.vat-rubl-buyer-cur   + bf_tt-allsum.vat-rubl-buyer-cur
     2496         bf_tt-allsum-line.slt-base-cur           = bf_tt-allsum-line.slt-base-cur         + bf_tt-allsum.slt-base-cur
     2497         bf_tt-allsum-line.slt-rubl-cur           = bf_tt-allsum-line.slt-rubl-cur         + bf_tt-allsum.slt-rubl-cur
     2498         bf_tt-allsum-line.road-tax-base-cur      = bf_tt-allsum-line.road-tax-base-cur    + bf_tt-allsum.road-tax-base-cur
     2499         bf_tt-allsum-line.road-tax-rubl-cur      = bf_tt-allsum-line.road-tax-rubl-cur    + bf_tt-allsum.road-tax-rubl-cur
     2500         bf_tt-allsum-line.excise-base-cur        = bf_tt-allsum-line.excise-base-cur      + bf_tt-allsum.excise-base-cur
     2501         bf_tt-allsum-line.excise-rubl-cur        = bf_tt-allsum-line.excise-rubl-cur      + bf_tt-allsum.excise-rubl-cur
     2502         bf_tt-allsum-line.sum-dsc-base-acc       = bf_tt-allsum-line.sum-dsc-base-acc     + bf_tt-allsum.sum-dsc-base-acc
     2503         bf_tt-allsum-line.sum-dsc-rubl-acc       = bf_tt-allsum-line.sum-dsc-rubl-acc     + bf_tt-allsum.sum-dsc-rubl-acc
     2504         bf_tt-allsum-line.sum-dsc-cli-acc        = bf_tt-allsum-line.sum-dsc-cli-acc      + bf_tt-allsum.sum-dsc-cli-acc
     2505         bf_tt-allsum-line.dsc-base-acc           = bf_tt-allsum-line.dsc-base-acc         + bf_tt-allsum.dsc-base-acc
     2506         bf_tt-allsum-line.dsc-rubl-acc           = bf_tt-allsum-line.dsc-rubl-acc         + bf_tt-allsum.dsc-rubl-acc
     2507         bf_tt-allsum-line.dsc-cli-acc            = bf_tt-allsum-line.dsc-cli-acc          + bf_tt-allsum.dsc-cli-acc
     2508         bf_tt-allsum-line.vat-base-acc           = bf_tt-allsum-line.vat-base-acc         + bf_tt-allsum.vat-base-acc
     2509         bf_tt-allsum-line.vat-rubl-acc           = bf_tt-allsum-line.vat-rubl-acc         + bf_tt-allsum.vat-rubl-acc
     2510         bf_tt-allsum-line.vat-cli-acc            = bf_tt-allsum-line.vat-cli-acc          + bf_tt-allsum.vat-cli-acc
     2511         bf_tt-allsum-line.slt-base-acc           = bf_tt-allsum-line.slt-base-acc         + bf_tt-allsum.slt-base-acc
     2512         bf_tt-allsum-line.slt-rubl-acc           = bf_tt-allsum-line.slt-rubl-acc         + bf_tt-allsum.slt-rubl-acc
     2513         bf_tt-allsum-line.slt-cli-acc            = bf_tt-allsum-line.slt-cli-acc          + bf_tt-allsum.slt-cli-acc
     2514         bf_tt-allsum-line.road-tax-base-acc      = bf_tt-allsum-line.road-tax-base-acc    + bf_tt-allsum.road-tax-base-acc
     2515         bf_tt-allsum-line.road-tax-rubl-acc      = bf_tt-allsum-line.road-tax-rubl-acc    + bf_tt-allsum.road-tax-rubl-acc
     2516         bf_tt-allsum-line.road-tax-cli-acc       = bf_tt-allsum-line.road-tax-cli-acc     + bf_tt-allsum.road-tax-cli-acc
     2517         bf_tt-allsum-line.excise-base-acc        = bf_tt-allsum-line.excise-base-acc      + bf_tt-allsum.excise-base-acc
     2518         bf_tt-allsum-line.excise-rubl-acc        = bf_tt-allsum-line.excise-rubl-acc      + bf_tt-allsum.excise-rubl-acc
     2519         bf_tt-allsum-line.excise-cli-acc         = bf_tt-allsum-line.excise-cli-acc       + bf_tt-allsum.excise-cli-acc
     2520         bf_tt-allsum-line.transport-base-acc     = bf_tt-allsum-line.transport-base-acc   + bf_tt-allsum.transport-base-acc
     2521         bf_tt-allsum-line.transport-rubl-acc     = bf_tt-allsum-line.transport-rubl-acc   + bf_tt-allsum.transport-rubl-acc
     2522         bf_tt-allsum-line.transport-cli-acc      = bf_tt-allsum-line.transport-cli-acc    + bf_tt-allsum.transport-cli-acc
     2523         bf_tt-allsum-line.other-base-acc         = bf_tt-allsum-line.other-base-acc       + bf_tt-allsum.other-base-acc
     2524         bf_tt-allsum-line.other-rubl-acc         = bf_tt-allsum-line.other-rubl-acc       + bf_tt-allsum.other-rubl-acc
     2525         bf_tt-allsum-line.other-cli-acc          = bf_tt-allsum-line.other-cli-acc        + bf_tt-allsum.other-cli-acc
     2526         .
     2527     end.
     2528   end.
     2529   end.
     2530   end procedure.
     2531   FUNCTION get-decade-word RETURNS CHARACTER ( INPUT i-dec AS INTEGER, INPUT i-num AS INTEGER ) :
     2532     DEFINE VARIABLE v-grade AS CHARACTER NO-UNDO.
     2533     RUN get-number-grade IN THIS-PROCEDURE ( INPUT i-dec, INPUT i-num, OUTPUT v-grade ) NO-ERROR.
     2534     RETURN ( IF ERROR-STATUS :ERROR THEN "":U ELSE v-grade ).
     2535   END FUNCTION.
     2536   FUNCTION Word-Sum RETURNS CHARACTER ( INPUT i-sum AS DECIMAL ) :
     2537     DEFINE VARIABLE OutSum AS CHARACTER NO-UNDO.
     2538     RUN conv-sum-to-word IN THIS-PROCEDURE ( INPUT i-sum, OUTPUT OutSum ) NO-ERROR.
     2539     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE OutSum ).
     2540   END FUNCTION.
     2541   PROCEDURE get-number-grade :
     2542     DEFINE  INPUT PARAMETER p-dec AS INTEGER   NO-UNDO.
     2543     DEFINE  INPUT PARAMETER p-num AS INTEGER   NO-UNDO.
     2544     DEFINE OUTPUT PARAMETER p-res AS CHARACTER NO-UNDO.
     2545     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO.
     2546     DO ON ERROR UNDO, RETURN ERROR :
     2547       IF      p-dec = 1 THEN DO: ASSIGN v-list = ",один,два,три,четыре,пять,шесть,семь,восемь,девять".    END.
     2548       ELSE IF p-dec = 2 THEN DO: ASSIGN v-list = "десять,одиннадцать,двенадцать,тринадцать,четырнадцать,пятнадцать,шестнадцать,семнадцать,восемнадцать,девятнадцать".    END.
     2549       ELSE IF p-dec = 3 THEN DO: ASSIGN v-list = ",,двадцать,тридцать,сорок,пятьдесят,шестьдесят,семьдесят,восемьдесят,девяносто".   END.
     2550       ELSE IF p-dec = 4 THEN DO: ASSIGN v-list = ",сто,двести,триста,четыреста,пятьсот,шестьсот,семьсот,восемьсот,девятьсот".  END.
     2551                         ELSE DO: ASSIGN v-list = ",,,,,,,,,". END.
     2552       ASSIGN p-res = ENTRY( p-num + 1, v-list ).
     2553     END.
     2554   END PROCEDURE.
     2555   PROCEDURE conv-sum-to-word :
     2556     DEFINE  INPUT PARAMETER p-sum AS DECIMAL   NO-UNDO.
     2557     DEFINE OUTPUT PARAMETER p-res AS CHARACTER NO-UNDO.
     2558     DEFINE VARIABLE Formatted  AS CHARACTER NO-UNDO.
     2559     DEFINE VARIABLE Word       AS CHARACTER NO-UNDO.
     2560     DEFINE VARIABLE OutSum     AS CHARACTER NO-UNDO.
     2561     DEFINE VARIABLE jj         AS INTEGER   NO-UNDO.
     2562     DO ON ERROR UNDO, RETURN ERROR :
     2563       ASSIGN Formatted = STRING( ABS( p-sum ), "999999999999999.99":U ) NO-ERROR.
     2564       IF ERROR-STATUS :ERROR THEN DO:
     2565         ASSIGN p-res = ?.
     2566         UNDO, RETURN ERROR.
     2567       END.
     2568       DO jj = ( LENGTH( Formatted ) - 3 ) TO 3 BY -3 :
     2569         IF SUBSTRING( Formatted, jj - 2, 3 ) = "000" THEN DO: NEXT. END.
     2570         IF jj < 15 THEN DO:
     2571           ASSIGN Word = ENTRY( jj, ",,триллион,,,миллиард,,,миллион,,,тысяч" ).
     2572           IF SUBSTRING( Formatted, jj,     1 )  = "1" AND
     2573              SUBSTRING( Formatted, jj - 1, 1 ) <> "1" AND jj = 12 THEN DO: ASSIGN Word = TRIM( Word ) + "а". END.
     2574           IF SUBSTRING( Formatted, jj, 1 ) = "2" OR
     2575              SUBSTRING( Formatted, jj, 1 ) = "3" OR
     2576              SUBSTRING( Formatted, jj, 1 ) = "4" THEN DO:
     2577             IF jj = 12 THEN DO:
     2578               IF SUBSTRING( Formatted, jj - 1, 1 ) <> "1" THEN DO: ASSIGN Word = TRIM( Word ) + "и". END.
     2579             END.       ELSE DO:
     2580               IF SUBSTRING( Formatted, jj - 1, 1 ) <> "1" THEN DO: ASSIGN Word = TRIM( Word ) + "а". END.
     2581             END.
     2582           END.
     2583           IF ( SUBSTRING( Formatted, jj,     1 ) <> "1" AND
     2584                SUBSTRING( Formatted, jj,     1 ) <> "2" AND
     2585                SUBSTRING( Formatted, jj,     1 ) <> "3" AND
     2586                SUBSTRING( Formatted, jj,     1 ) <> "4" AND jj <> 12 ) OR
     2587              ( SUBSTRING( Formatted, jj - 1, 1 )  = "1" AND jj <  12 ) THEN DO: ASSIGN Word = TRIM( Word ) + "ов". END.
     2588           IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
     2589         END.
     2590         IF SUBSTRING( Formatted, jj - 1, 1 ) <> "1" THEN DO:
     2591           IF      jj = 12 AND SUBSTRING( Formatted, jj, 1 ) = "1" THEN DO: ASSIGN Word = "одна". END.
     2592           ELSE IF jj = 12 AND SUBSTRING( Formatted, jj, 1 ) = "2" THEN DO: ASSIGN Word = "две".  END.
     2593           ELSE DO: ASSIGN Word = get-decade-word( 1, INTEGER( SUBSTRING( Formatted, jj, 1 ) ) ). END.
     2594           IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
     2595           ASSIGN Word = get-decade-word( 3, INTEGER( SUBSTRING( Formatted, jj - 1, 1 ) ) ).
     2596         END.                                        ELSE DO:
     2597           ASSIGN Word = get-decade-word( 2, INTEGER( SUBSTRING( Formatted, jj,     1 ) ) ).
     2598         END.
     2599         IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
     2600         ASSIGN Word = get-decade-word( 4, INTEGER( SUBSTRING( Formatted, jj - 2, 1 ) ) ).
     2601         IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
     2602       END.
     2603       ASSIGN OutSum = CAPS( SUBSTRING( OutSum, 1, 1 ) ) + SUBSTRING( OutSum, 2 ).
     2604       IF OutSum = "":U AND TRUNCATE( p-sum, 0 ) = 0 THEN DO: ASSIGN OutSum = "Ноль". END.
     2605       ASSIGN p-res = TRIM( OutSum ).
     2606     END.
     2607   END PROCEDURE.
     2608   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2609   define new global shared variable g#trdcalib as handle no-undo.
     2610   FUNCTION LastMonthDate RETURNS DATE    ( INPUT i-date AS DATE ) :
     2611     DEFINE VARIABLE t_date AS DATE NO-UNDO.
     2612     RUN get-last-month-date IN THIS-PROCEDURE ( INPUT i-date, OUTPUT t_date ) NO-ERROR.
     2613     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE t_date ).
     2614   END FUNCTION.
     2615   PROCEDURE get-last-month-date :
     2616     DEFINE  INPUT PARAMETER p-curr-date AS DATE NO-UNDO.
     2617     DEFINE OUTPUT PARAMETER p-last-date AS DATE NO-UNDO.
     2618     DO ON ERROR UNDO, RETURN ERROR :
     2619       ASSIGN p-last-date = DATE( MONTH( p-curr-date ), 28,  YEAR( p-curr-date ) ).
     2620       ASSIGN p-last-date = p-last-date - DAY( p-last-date + 4 ) + 4.
     2621     END.
     2622   END PROCEDURE.
     2623   FUNCTION LastMonthDay  RETURNS INTEGER ( INPUT i-date AS DATE ) :
     2624     DEFINE VARIABLE j_day AS INTEGER NO-UNDO.
     2625     RUN get-last-month-day IN THIS-PROCEDURE ( INPUT i-date, OUTPUT j_day ) NO-ERROR.
     2626     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_day ).
     2627   END FUNCTION.
     2628   PROCEDURE get-last-month-day :
     2629     DEFINE  INPUT PARAMETER p-date AS DATE    NO-UNDO.
     2630     DEFINE OUTPUT PARAMETER p-day  AS INTEGER NO-UNDO.
     2631     DEFINE VARIABLE t_date AS DATE NO-UNDO.
     2632     DO ON ERROR UNDO, RETURN ERROR :
     2633       ASSIGN t_date = DATE( MONTH( p-date ), 28,  YEAR( p-date ) ).
     2634       ASSIGN p-day  = DAY( t_date - DAY( t_date + 4 ) + 4 ).
     2635     END.
     2636   END PROCEDURE.
     2637   FUNCTION LastDay-MY  RETURNS INTEGER ( INPUT i-month AS INTEGER, INPUT i-year AS INTEGER ) :
     2638     DEFINE VARIABLE j_day AS INTEGER NO-UNDO.
     2639     RUN get-last-day-MY IN THIS-PROCEDURE ( INPUT i-month, INPUT i-year, OUTPUT j_day ) NO-ERROR.
     2640     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_day ).
     2641   END FUNCTION.
     2642   PROCEDURE get-last-day-MY :
     2643     DEFINE  INPUT PARAMETER p-month AS INTEGER NO-UNDO.
     2644     DEFINE  INPUT PARAMETER p-year  AS INTEGER NO-UNDO.
     2645     DEFINE OUTPUT PARAMETER p-day   AS INTEGER NO-UNDO.
     2646     DEFINE VARIABLE t_date AS DATE NO-UNDO.
     2647     DO ON ERROR UNDO, RETURN ERROR :
     2648       ASSIGN t_date = DATE( p-month, 28, p-year ).
     2649       ASSIGN p-day  = DAY( t_date - DAY( t_date + 4 ) + 4 ).
     2650     END.
     2651   END PROCEDURE.
     2652   FUNCTION LastDate-MY RETURNS DATE    ( INPUT i-month AS INTEGER, INPUT i-year AS INTEGER ) :
     2653     DEFINE VARIABLE t_date AS DATE NO-UNDO.
     2654     RUN get-last-date-MY IN THIS-PROCEDURE ( INPUT i-month, INPUT i-year, OUTPUT t_date ) NO-ERROR.
     2655     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE t_date ).
     2656   END FUNCTION.
     2657   PROCEDURE get-last-date-MY :
     2658     DEFINE  INPUT PARAMETER p-month AS INTEGER NO-UNDO.
     2659     DEFINE  INPUT PARAMETER p-year  AS INTEGER NO-UNDO.
     2660     DEFINE OUTPUT PARAMETER p-date  AS DATE    NO-UNDO.
     2661     DO ON ERROR UNDO, RETURN ERROR :
     2662       ASSIGN p-date = DATE( p-month, 28, p-year ).
     2663       ASSIGN p-date = p-date - DAY( p-date + 4 ) + 4.
     2664     END.
     2665   END PROCEDURE.
     2666   FUNCTION NextMonth RETURNS INTEGER ( INPUT i-date AS DATE ) :
     2667     DEFINE VARIABLE j_month AS INTEGER NO-UNDO.
     2668     RUN get-next-month IN THIS-PROCEDURE ( INPUT i-date, OUTPUT j_month ) NO-ERROR.
     2669     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_month ).
     2670   END FUNCTION.
     2671   PROCEDURE get-next-month :
     2672     DEFINE  INPUT PARAMETER p-date  AS DATE    NO-UNDO.
     2673     DEFINE OUTPUT PARAMETER p-month AS INTEGER NO-UNDO.
     2674     DO ON ERROR UNDO, RETURN ERROR :
     2675       ASSIGN p-month = ( MONTH( p-date ) MODULO 12 ) + 1.
     2676     END.
     2677   END PROCEDURE.
     2678   FUNCTION NextYear  RETURNS INTEGER ( INPUT i-date AS DATE ) :
     2679     DEFINE VARIABLE j_year AS INTEGER NO-UNDO.
     2680     RUN get-next-year IN THIS-PROCEDURE ( INPUT i-date, OUTPUT j_year ) NO-ERROR.
     2681     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_year ).
     2682   END FUNCTION.
     2683   PROCEDURE get-next-year :
     2684     DEFINE  INPUT PARAMETER p-date AS DATE    NO-UNDO.
     2685     DEFINE OUTPUT PARAMETER p-year AS INTEGER NO-UNDO.
     2686     DO ON ERROR UNDO, RETURN ERROR :
     2687       ASSIGN p-year = YEAR( p-date ) + ( IF MONTH( p-date ) < 12 THEN 0 ELSE 1 ).
     2688     END.
     2689   END PROCEDURE.
     2690   FUNCTION PrevMonth RETURNS INTEGER ( INPUT i-date AS DATE ) :
     2691     DEFINE VARIABLE j_month AS INTEGER NO-UNDO.
     2692     RUN get-prev-month IN THIS-PROCEDURE ( INPUT i-date, OUTPUT j_month ) NO-ERROR.
     2693     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_month ).
     2694   END FUNCTION.
     2695   PROCEDURE get-prev-month :
     2696     DEFINE  INPUT PARAMETER p-date  AS DATE    NO-UNDO.
     2697     DEFINE OUTPUT PARAMETER p-month AS INTEGER NO-UNDO.
     2698     DO ON ERROR UNDO, RETURN ERROR :
     2699       ASSIGN p-month = ( ( ( MONTH( p-date ) + 10 ) MODULO 12 ) MODULO 12 ) + 1.
     2700     END.
     2701   END PROCEDURE.
     2702   FUNCTION PrevYear  RETURNS INTEGER ( INPUT i-date AS DATE ) :
     2703     DEFINE VARIABLE j_year AS INTEGER NO-UNDO.
     2704     RUN get-prev-year IN THIS-PROCEDURE ( INPUT i-date, OUTPUT j_year ) NO-ERROR.
     2705     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_year ).
     2706   END FUNCTION.
     2707   PROCEDURE get-prev-year :
     2708     DEFINE  INPUT PARAMETER p-date AS DATE    NO-UNDO.
     2709     DEFINE OUTPUT PARAMETER p-year AS INTEGER NO-UNDO.
     2710     DO ON ERROR UNDO, RETURN ERROR :
     2711       ASSIGN p-year = YEAR( p-date ) + ( IF MONTH( p-date ) = 1 THEN -1 ELSE 0 ).
     2712     END.
     2713   END PROCEDURE.
     2714   FUNCTION NextMonth-MY RETURNS INTEGER ( INPUT i-month AS INTEGER ) :
     2715     DEFINE VARIABLE j_month AS INTEGER NO-UNDO.
     2716     RUN get-next-month-MY IN THIS-PROCEDURE ( INPUT i-month, OUTPUT j_month ) NO-ERROR.
     2717     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_month ).
     2718   END FUNCTION.
     2719   PROCEDURE get-next-month-MY :
     2720     DEFINE  INPUT PARAMETER p-curr-month AS INTEGER NO-UNDO.
     2721     DEFINE OUTPUT PARAMETER p-next-month AS INTEGER NO-UNDO.
     2722     DO ON ERROR UNDO, RETURN ERROR :
     2723       ASSIGN p-next-month = ( p-curr-month MODULO 12 ) + 1.
     2724     END.
     2725   END PROCEDURE.
     2726   FUNCTION NextYear-MY  RETURNS INTEGER ( INPUT i-month AS INTEGER, INPUT i-year AS INTEGER ) :
     2727     DEFINE VARIABLE j_year AS INTEGER NO-UNDO.
     2728     RUN get-next-year-MY IN THIS-PROCEDURE ( INPUT i-month, INPUT i-year, OUTPUT j_year ) NO-ERROR.
     2729     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_year ).
     2730   END FUNCTION.
     2731   PROCEDURE get-next-year-MY :
     2732     DEFINE  INPUT PARAMETER p-curr-month AS INTEGER NO-UNDO.
     2733     DEFINE  INPUT PARAMETER p-curr-year  AS INTEGER NO-UNDO.
     2734     DEFINE OUTPUT PARAMETER p-next-year  AS INTEGER NO-UNDO.
     2735     DO ON ERROR UNDO, RETURN ERROR :
     2736       ASSIGN p-next-year = p-curr-year + ( IF p-curr-month < 12 THEN 0 ELSE 1 ).
     2737     END.
     2738   END PROCEDURE.
     2739   FUNCTION MonthNameRus RETURNS CHARACTER ( INPUT i-month AS INTEGER ) :
     2740     DEFINE VARIABLE v-name AS CHARACTER NO-UNDO.
     2741     RUN get-month-name-rus IN THIS-PROCEDURE ( INPUT i-month, OUTPUT v-name ) NO-ERROR.
     2742     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-name ).
     2743   END FUNCTION.
     2744   PROCEDURE get-month-name-rus :
     2745     DEFINE  INPUT PARAMETER p-month AS INTEGER   NO-UNDO.
     2746     DEFINE OUTPUT PARAMETER p-name  AS CHARACTER NO-UNDO.
     2747     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO INITIAL "Январь,Февраль,Март,Апрель,Май,Июнь,Июль,Август,Сентябрь,Октябрь,Ноябрь,Декабрь".
     2748     DO ON ERROR UNDO, RETURN ERROR :
     2749       ASSIGN p-name = ( IF p-month >= 1 AND p-month <= 12 THEN ENTRY( p-month, v-list ) ELSE ? ).
     2750     END.
     2751   END PROCEDURE.
     2752   FUNCTION MonthNameRusGen RETURNS CHARACTER ( INPUT i-month AS INTEGER ) :
     2753     DEFINE VARIABLE v-name AS CHARACTER NO-UNDO.
     2754     RUN get-month-name-gen IN THIS-PROCEDURE ( INPUT i-month, OUTPUT v-name ) NO-ERROR.
     2755     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-name ).
     2756   END FUNCTION.
     2757   PROCEDURE get-month-name-gen :
     2758     DEFINE  INPUT PARAMETER p-month AS INTEGER   NO-UNDO.
     2759     DEFINE OUTPUT PARAMETER p-name  AS CHARACTER NO-UNDO.
     2760     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO INITIAL "Января,Февраля,Марта,Апреля,Мая,Июня,Июля,Августа,Сентября,Октября,Ноября,Декабря".
     2761     DO ON ERROR UNDO, RETURN ERROR :
     2762       ASSIGN p-name = ( IF p-month >= 1 AND p-month <= 12 THEN ENTRY( p-month, v-list ) ELSE ? ).
     2763     END.
     2764   END PROCEDURE.
     2765   FUNCTION CalcMonthes  RETURNS INTEGER ( INPUT i-date-from AS DATE, INPUT i-date-till AS DATE ) :
     2766     DEFINE VARIABLE j_month-num AS INTEGER NO-UNDO.
     2767     RUN get-month-number IN THIS-PROCEDURE ( INPUT i-date-from, INPUT i-date-till, OUTPUT j_month-num ) NO-ERROR.
     2768     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_month-num ).
     2769   END FUNCTION.
     2770   PROCEDURE get-month-number :
     2771     DEFINE  INPUT PARAMETER p-date-from AS DATE    NO-UNDO.
     2772     DEFINE  INPUT PARAMETER p-date-till AS DATE    NO-UNDO.
     2773     DEFINE OUTPUT PARAMETER p-month-num AS INTEGER NO-UNDO.
     2774     DO ON ERROR UNDO, RETURN ERROR :
     2775       ASSIGN p-month-num = ( YEAR(  p-date-till ) - YEAR(  p-date-from ) ) * 12 +
     2776                              MONTH( p-date-till ) - MONTH( p-date-from )   +  1 .
     2777     END.
     2778   END PROCEDURE.
     2779   FUNCTION CalcMonth-MY RETURNS INTEGER ( INPUT i-year-from  AS INTEGER,
     2780                                           INPUT i-month-from AS INTEGER,
     2781                                           INPUT i-year-till  AS INTEGER,
     2782                                           INPUT i-month-till AS INTEGER  ) :
     2783     DEFINE VARIABLE j_month-num AS INTEGER NO-UNDO.
     2784     RUN get-month-num-MY IN THIS-PROCEDURE (  INPUT i-year-from,
     2785                                               INPUT i-month-from,
     2786                                               INPUT i-year-till,
     2787                                               INPUT i-month-till,
     2788                                              OUTPUT j_month-num   ) NO-ERROR.
     2789     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_month-num ).
     2790   END FUNCTION.
     2791   PROCEDURE get-month-num-MY :
     2792     DEFINE  INPUT PARAMETER p-year-from  AS INTEGER NO-UNDO.
     2793     DEFINE  INPUT PARAMETER p-month-from AS INTEGER NO-UNDO.
     2794     DEFINE  INPUT PARAMETER p-year-till  AS INTEGER NO-UNDO.
     2795     DEFINE  INPUT PARAMETER p-month-till AS INTEGER NO-UNDO.
     2796     DEFINE OUTPUT PARAMETER p-month-num  AS INTEGER NO-UNDO.
     2797     DO ON ERROR UNDO, RETURN ERROR :
     2798       ASSIGN p-month-num = ( p-year-till - p-year-from ) * 12 + p-month-till - p-month-from + 1.
     2799     END.
     2800   END PROCEDURE.
     2801   FUNCTION DateTimeHeader RETURNS CHARACTER ( INPUT i-date AS DATE ) :
     2802     DEFINE VARIABLE v-header AS CHARACTER NO-UNDO.
     2803     RUN get-date-time-header IN THIS-PROCEDURE ( INPUT i-date, OUTPUT v-header ) NO-ERROR.
     2804     RETURN ( IF ERROR-STATUS :ERROR THEN "":U ELSE v-header ).
     2805   END FUNCTION.
     2806   PROCEDURE get-date-time-header :
     2807     DEFINE  INPUT PARAMETER p-date AS DATE      NO-UNDO.
     2808     DEFINE OUTPUT PARAMETER p-head AS CHARACTER NO-UNDO.
     2809     DO ON ERROR UNDO, RETURN ERROR :
     2810       IF p-date = ? THEN DO: ASSIGN p-date = TODAY. END.
     2811       ASSIGN p-head = "Дата печати: " + STRING( p-date, "99.99.9999":U ) + ", ":U + STRING( TIME, "HH:MM":U ).
     2812     END.
     2813   END PROCEDURE.
     2814   FUNCTION Leap-Year RETURNS LOGICAL ( INPUT i-year AS INTEGER ) :
     2815     DEFINE VARIABLE bissextile AS LOGICAL NO-UNDO.
     2816     RUN get-leap-year-sign IN THIS-PROCEDURE ( INPUT i-year, OUTPUT bissextile ) NO-ERROR.
     2817     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE bissextile ).
     2818   END FUNCTION.
     2819   PROCEDURE get-leap-year-sign :
     2820     DEFINE  INPUT PARAMETER p-year AS INTEGER NO-UNDO.
     2821     DEFINE OUTPUT PARAMETER p-sign AS LOGICAL NO-UNDO.
     2822     DEFINE VARIABLE t_date AS DATE NO-UNDO.
     2823     DO ON ERROR UNDO, RETURN ERROR :
     2824       IF p-year = ? OR p-year = 0 THEN DO:
     2825         ASSIGN t_date = TODAY.
     2826         IF t_date <> TODAY THEN DO: ASSIGN t_date = TODAY. END.
     2827         ASSIGN p-year = YEAR( t_date ).
     2828       END.
     2829       ASSIGN p-sign = ( INTEGER( TRUNCATE( p-year * 0.25, 0 ) ) * 4 = p-year ).
     2830     END.
     2831   END PROCEDURE.
     2832   FUNCTION Leap-Year-d RETURNS LOGICAL ( INPUT i-date AS DATE ) :
     2833     DEFINE VARIABLE bissextile AS LOGICAL NO-UNDO.
     2834     RUN get-leap-year-sign-d IN THIS-PROCEDURE ( INPUT i-date, OUTPUT bissextile ) NO-ERROR.
     2835     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE bissextile ).
     2836   END FUNCTION.
     2837   PROCEDURE get-leap-year-sign-d :
     2838     DEFINE  INPUT PARAMETER p-date AS DATE    NO-UNDO.
     2839     DEFINE OUTPUT PARAMETER p-sign AS LOGICAL NO-UNDO.
     2840     DEFINE VARIABLE j-year AS INTEGER NO-UNDO.
     2841     DO ON ERROR UNDO, RETURN ERROR :
     2842       IF p-date = ? THEN DO:
     2843         ASSIGN p-date = TODAY.
     2844         IF p-date <> TODAY THEN DO: ASSIGN p-date = TODAY. END.
     2845       END.
     2846       ASSIGN j-year = YEAR( p-date ).
     2847       ASSIGN p-sign = ( INTEGER( TRUNCATE( j-year * 0.25, 0 ) ) * 4 = j-year ).
     2848     END.
     2849   END PROCEDURE.
     2850   define variable vss-include-info19 as character format "X(65)" no-undo
     2851   initial "@(#)$Workfile$ $Revision$".
     2852   define variable v-fmtcli-name          as character    no-undo.
     2853   define variable v-fmtcli-engl-name     as character    no-undo.
     2854   define variable v-fmtcli-addres        as character    no-undo.
     2855   define variable v-fmtcli-post-addres   as character    no-undo.
     2856   define variable v-fmtcli-full-addres   as character    no-undo.
     2857   define variable v-fmtcli-phone         as character    no-undo.
     2858   define variable v-fmtcli-inn           as character    no-undo.
     2859   define variable v-fmtcli-kpp           as character    no-undo.
     2860   define variable v-fmtcli-okpo          as character    no-undo.
     2861   define variable v-fmtcli-country       as character    no-undo.
     2862   define variable v-fmtcli-city          as character    no-undo.
     2863   define variable v-fmtcli-index         as character    no-undo.
     2864   define variable v-fmtcli-schet-exists  as logical      no-undo.
     2865   define variable v-fmtcli-bank-exists   as logical      no-undo.
     2866   define variable v-fmtcli-bank-r-schet  as character    no-undo.
     2867   define variable v-fmtcli-bank-c-schet  as character    no-undo.
     2868   define variable v-fmtcli-bank-bik      as character    no-undo.
     2869   define variable v-fmtcli-bank-name     as character    no-undo.
     2870   define variable v-fmtcli-bank-addres   as character    no-undo.
     2871   define variable v-fmtcli-bank-city     as character    no-undo.
     2872   procedure fmtcli-get-bank :
     2873   define input parameter p-host-code      as integer          no-undo.
     2874   define input parameter p-obj-type       as character        no-undo.
     2875   define input parameter p-obj-code       as integer          no-undo.
     2876   define input parameter p-curr-code      as integer          no-undo.
     2877       define buffer buf_fin-schet     for ub.fin-schet.
     2878       define buffer buf_fin-bank      for ub.fin-bank.
     2879   do
     2880   for buf_fin-schet
     2881     , buf_fin-bank
     2882   on error undo, return error
     2883   :
     2884       assign
     2885           v-fmtcli-schet-exists       = no
     2886           v-fmtcli-bank-exists        = no
     2887           v-fmtcli-bank-r-schet       = "":U
     2888           v-fmtcli-bank-c-schet       = "":U
     2889           v-fmtcli-bank-bik           = "":U
     2890           v-fmtcli-bank-name          = "":U
     2891           v-fmtcli-bank-addres        = "":U
     2892           v-fmtcli-bank-city          = "":U
     2893       .
     2894       search-for-schet:
     2895       for each buf_fin-schet no-lock
     2896          where buf_fin-schet.host-code = p-host-code
     2897            and buf_fin-schet.cli-type  = p-obj-type
     2898            and buf_fin-schet.cli-code  = p-obj-code
     2899            and buf_fin-schet.curr-code = p-curr-code
     2900       on error undo, return error
     2901       :
     2902           if buf_fin-schet.status_   = 'удал':U
     2903           then do:
     2904           end.
     2905           else do:
     2906               assign
     2907                   v-fmtcli-schet-exists   = yes
     2908                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
     2909                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
     2910               .
     2911               find first buf_fin-bank no-lock
     2912                    where buf_fin-bank.host-code = p-host-code
     2913                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
     2914               no-error.
     2915               if available buf_fin-bank
     2916               then do:
     2917                   assign
     2918                       v-fmtcli-bank-exists      = yes
     2919                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
     2920                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
     2921                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
     2922                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
     2923                   .
     2924               end.
     2925               else do:
     2926                   assign
     2927                       v-fmtcli-bank-exists    = no
     2928                       v-fmtcli-bank-bik       = "":U
     2929                       v-fmtcli-bank-name      = "":U
     2930                       v-fmtcli-bank-addres    = "":U
     2931                       v-fmtcli-bank-city      = "":U
     2932                   .
     2933               end.
     2934               leave search-for-schet.
     2935           end.
     2936       end.
     2937   end.
     2938   end procedure.
     2939   procedure fmtcli-get-client :
     2940   define input parameter p-obj-type       as character    no-undo.
     2941   define input parameter p-obj-code       as integer      no-undo.
     2942       define variable v-temp-fmtcli-address      as character     no-undo.
     2943       define variable v-num-country-city    as integer      no-undo.
     2944       define buffer buf_clients   for ub.clients.
     2945       define buffer buf_firm      for ub.firm.
     2946       define buffer buf_store     for ub.store.
     2947       define buffer buf_shop      for ub.shop.
     2948       define buffer buf_person    for ub.person.
     2949   do
     2950   for buf_clients
     2951     , buf_firm
     2952     , buf_store
     2953     , buf_shop
     2954     , buf_person
     2955   on error undo, return error
     2956   :
     2957       assign
     2958           v-fmtcli-name           = "":U
     2959           v-fmtcli-addres         = "":U
     2960           v-fmtcli-post-addres    = "":U
     2961           v-fmtcli-full-addres    = "":U
     2962           v-fmtcli-phone          = "":U
     2963           v-fmtcli-inn            = "":U
     2964           v-fmtcli-kpp            = "":U
     2965           v-fmtcli-okpo           = "":U
     2966           v-fmtcli-city           = "":U
     2967           v-fmtcli-index          = "":U
     2968           v-fmtcli-country        = "":U
     2969       .
     2970       find first buf_clients no-lock
     2971            where buf_clients.obj-type = p-obj-type
     2972              and buf_clients.obj-code = p-obj-code
     2973       .
     2974       assign
     2975           v-fmtcli-name = buf_clients.obj-name
     2976       .
     2977       case buf_clients.obj-type:
     2978          when 'орг':U
     2979          then do:
     2980               find first buf_firm no-lock
     2981                    where buf_firm.firm-code = buf_clients.obj-code
     2982                    no-error
     2983               .
     2984               if available buf_firm
     2985               then do:
     2986                   assign
     2987                       v-num-country-city = num-entries( buf_firm.city )
     2988                       v-fmtcli-engl-name = buf_firm.engl-name
     2989                   .
     2990                   if v-num-country-city > 0
     2991                   then do:
     2992                       assign
     2993                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
     2994                       .
     2995                   end.
     2996                   if v-num-country-city > 1
     2997                   then do:
     2998                       assign
     2999                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
     3000                       .
     3001                   end.
     3002                   run fmtcli-concatenate-strings in this-procedure (
     3003                         input v-fmtcli-full-addres
     3004                       , input v-fmtcli-country
     3005                       , input ", ":U
     3006                       , input 50
     3007                       , output v-fmtcli-full-addres
     3008                   ).
     3009                   run fmtcli-concatenate-strings in this-procedure (
     3010                         input v-fmtcli-full-addres
     3011                       , input v-fmtcli-city
     3012                       , input ", ":U
     3013                       , input 50
     3014                       , output v-fmtcli-full-addres
     3015                   ).
     3016                   run fmtcli-concatenate-strings in this-procedure (
     3017                         input v-fmtcli-full-addres
     3018                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
     3019                       , input ", ":U
     3020                       , input 50
     3021                       , output v-fmtcli-full-addres
     3022                   ).
     3023                   run fmtcli-concatenate-strings in this-procedure (
     3024                         input v-fmtcli-post-addres
     3025                       , input v-fmtcli-country
     3026                       , input ", ":U
     3027                       , input 50
     3028                       , output v-fmtcli-post-addres
     3029                   ).
     3030                   run fmtcli-concatenate-strings in this-procedure (
     3031                         input v-fmtcli-post-addres
     3032                       , input v-fmtcli-city
     3033                       , input ", ":U
     3034                       , input 50
     3035                       , output v-fmtcli-post-addres
     3036                   ).
     3037                   run fmtcli-concatenate-strings in this-procedure (
     3038                         input v-fmtcli-post-addres
     3039                       , input string( buf_firm.ind )
     3040                       , input ", ":U
     3041                       , input 50
     3042                       , output v-fmtcli-post-addres
     3043                   ).
     3044                   run fmtcli-concatenate-strings in this-procedure (
     3045                         input substring( buf_firm.addres1, 1, 50 )
     3046                       , input buf_firm.addres2
     3047                       , input " ":U
     3048                       , input 50
     3049                       , output v-temp-fmtcli-address
     3050                   ).
     3051                   run fmtcli-concatenate-strings in this-procedure (
     3052                         input v-temp-fmtcli-address
     3053                       , input substring( buf_firm.addres1, 51, 50 )
     3054                       , input " ":U
     3055                       , input 50
     3056                       , output v-temp-fmtcli-address
     3057                   ).
     3058                   run fmtcli-concatenate-strings in this-procedure (
     3059                         input v-temp-fmtcli-address
     3060                       , input substring( buf_firm.addres1, 101, 50 )
     3061                       , input " ":U
     3062                       , input 50
     3063                       , output v-temp-fmtcli-address
     3064                   ).
     3065                   assign
     3066                       v-fmtcli-addres = v-temp-fmtcli-address
     3067                   .
     3068                   if buf_firm.addres1 <> ?
     3069                   then do:
     3070                       run fmtcli-concatenate-strings in this-procedure (
     3071                             input v-fmtcli-full-addres
     3072                           , input v-fmtcli-addres
     3073                           , input ", ":U
     3074                           , input 0
     3075                           , output v-fmtcli-full-addres
     3076                       ).
     3077                   end.
     3078                   run fmtcli-concatenate-strings in this-procedure (
     3079                         input substring( buf_firm.post-addr1, 1, 50 )
     3080                       , input buf_firm.post-addr2
     3081                       , input " ":U
     3082                       , input 50
     3083                       , output v-fmtcli-post-addres
     3084                   ).
     3085                   run fmtcli-concatenate-strings in this-procedure (
     3086                         input v-fmtcli-post-addres
     3087                       , input substring( buf_firm.post-addr1, 51, 50 )
     3088                       , input " ":U
     3089                       , input 50
     3090                       , output v-fmtcli-post-addres
     3091                   ).
     3092                   run fmtcli-concatenate-strings in this-procedure (
     3093                         input v-fmtcli-post-addres
     3094                       , input substring( buf_firm.post-addr1, 101, 50 )
     3095                       , input " ":U
     3096                       , input 50
     3097                       , output v-fmtcli-post-addres
     3098                   ).
     3099                   assign
     3100                       v-fmtcli-phone         = buf_firm.phone
     3101                       v-fmtcli-inn           = buf_firm.inn
     3102                       v-fmtcli-kpp           = buf_firm.kpp
     3103                       v-fmtcli-okpo          = buf_firm.okpo
     3104                       v-fmtcli-index         = string( buf_firm.ind )
     3105                   .
     3106               end.
     3107          end.
     3108          when 'маг':U
     3109          then do:
     3110               find first buf_shop no-lock
     3111                    where buf_shop.obj-code = buf_clients.obj-code
     3112               .
     3113               if available buf_shop
     3114               then do:
     3115                   run fmtcli-concatenate-strings in this-procedure (
     3116                         input buf_shop.addres1
     3117                       , input buf_shop.addres2
     3118                       , input " ":U
     3119                       , input 50
     3120                       , output v-fmtcli-addres
     3121                   ).
     3122                   assign
     3123                       v-fmtcli-full-addres = v-fmtcli-addres
     3124                       v-fmtcli-post-addres = v-fmtcli-addres
     3125                       v-fmtcli-phone       = buf_shop.phone
     3126                       v-fmtcli-inn         = "":U
     3127                       v-fmtcli-kpp         = "":U
     3128                       v-fmtcli-okpo        = "":U
     3129                       v-fmtcli-city        = "":U
     3130                       v-fmtcli-index       = "":U
     3131                   .
     3132               end.
     3133          end.
     3134          when 'скл':U
     3135          then do:
     3136               find first buf_store no-lock
     3137                    where buf_store.obj-code = buf_clients.obj-code
     3138               .
     3139               if available buf_store
     3140               then do:
     3141                   run fmtcli-concatenate-strings in this-procedure (
     3142                         input buf_store.addres1
     3143                       , input buf_store.addres2
     3144                       , input " ":U
     3145                       , input 50
     3146                       , output v-fmtcli-addres
     3147                   ).
     3148                   assign
     3149                       v-fmtcli-full-addres = v-fmtcli-addres
     3150                       v-fmtcli-phone       = buf_store.phone
     3151                       v-fmtcli-inn         = "":U
     3152                       v-fmtcli-kpp         = "":U
     3153                       v-fmtcli-okpo        = "":U
     3154                       v-fmtcli-city        = "":U
     3155                       v-fmtcli-index       = "":U
     3156                   .
     3157               end.
     3158          end.
     3159          when 'чел':U
     3160          then do:
     3161               find first buf_person no-lock
     3162                    where buf_person.psn-code = buf_clients.obj-code
     3163               .
     3164               if available buf_person
     3165               then do:
     3166                   run fmtcli-concatenate-strings in this-procedure (
     3167                         input ( if buf_person.ind = 0 or buf_person.ind = ?
     3168                                 then "":U
     3169                                 else string( buf_person.ind, "999999")
     3170                                 )
     3171                       , input buf_person.city
     3172                       , input ", ":U
     3173                       , input 0
     3174                       , output v-fmtcli-full-addres
     3175                   ).
     3176                   assign
     3177                       v-fmtcli-addres = buf_person.address
     3178                   .
     3179                   run fmtcli-concatenate-strings in this-procedure (
     3180                         input v-fmtcli-full-addres
     3181                       , input v-fmtcli-addres
     3182                       , input ", ":U
     3183                       , input 0
     3184                       , output v-fmtcli-full-addres
     3185                   ).
     3186                   assign
     3187                       v-fmtcli-phone     = buf_person.phone1
     3188                       v-fmtcli-inn       = buf_person.inn
     3189                       v-fmtcli-kpp       = buf_person.kpp
     3190                       v-fmtcli-okpo      = buf_person.okpo
     3191                       v-fmtcli-city      = buf_person.city
     3192                       v-fmtcli-index     = string( buf_person.ind )
     3193                   .
     3194               end.
     3195          end.
     3196       end case.
     3197   end.
     3198   end procedure.
     3199   procedure fmtcli-concatenate-strings :
     3200   define input parameter p-string-1       as character        no-undo.
     3201   define input parameter p-string-2       as character        no-undo.
     3202   define input parameter p-delimiter      as character        no-undo.
     3203   define input parameter p-length         as integer          no-undo.
     3204   define output parameter p-out-string    as character        no-undo.
     3205   do
     3206   on error undo, return error
     3207   :
     3208       assign
     3209           p-out-string = ( if p-string-1 = ?
     3210                            then "":U
     3211                            else trim( p-string-1 ) )
     3212       .
     3213       assign
     3214           p-out-string = p-out-string
     3215                        + ( if p-out-string = "":U
     3216                            or length( p-out-string ) = p-length
     3217                            or p-string-2 = ?
     3218                            or trim( p-string-2 ) = "":U
     3219                            then "":U
     3220                            else p-delimiter )
     3221                        + ( if p-string-2 = ?
     3222                            or trim( p-string-2 ) = "":U
     3223                            then "":U
     3224                            else trim( p-string-2 ) )
     3225       .
     3226   end.
     3227   end procedure.
     3228   define variable vss-include-info20 as character format "X(65)" no-undo
     3229   initial "@(#)$Workfile$ $Revision$".
     3230   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3231   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3232   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     3233   define variable par-type          as character no-undo.
     3234   define variable v-value-character as character no-undo .
     3235   define variable v-value-date      as date      no-undo .
     3236   define variable v-value-decimal   as decimal   no-undo .
     3237   define variable v-value-integer   as integer   no-undo .
