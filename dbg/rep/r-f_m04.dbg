     3754   procedure torgconf-get-self-param :
     3755   define input parameter p-obj-type           as character        no-undo.
     3756   define input parameter p-obj-code           as integer          no-undo.
     3757   define input parameter p-curr-code          as integer          no-undo.
     3758       define variable v-host-code    as integer      no-undo.
     3759       define variable v-par-type     as character    no-undo.
     3760   do
     3761   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1))
     3762   :
     3763   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3764   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3765     (input  p-obj-type
     3766     ,input  p-obj-code
     3767     ,output v-host-code
     3768     )  .
     3769       if v-torgconf-outhold = yes
     3770       then do:
     3771           run torgconf-get-holdfirm-code in this-procedure (
     3772                 input p-obj-type
     3773               , input p-obj-code
     3774               , output v-torgconf-self-host-code
     3775           ).
     3776           if v-torgconf-self-host-code = 0
     3777           then do:
     3778               return error.
     3779           end.
     3780       end.
     3781       else do:
     3782           assign
     3783               v-torgconf-self-host-code = v-host-code
     3784           .
     3785       end.
     3786       if v-torgconf-self-host-code = 0
     3787       then do:
     3788           assign
     3789               v-torgconf-self-host-name           = "":U
     3790               v-torgconf-self-host-addres         = "":U
     3791               v-torgconf-self-host-post-addres    = "":U
     3792               v-torgconf-self-host-phone          = "":U
     3793               v-torgconf-self-host-inn            = "":U
     3794               v-torgconf-self-host-kpp            = "":U
     3795               v-torgconf-self-host-okpo           = "":U
     3796               v-torgconf-self-host-egrip-date     = "":U
     3797               v-torgconf-self-host-egrip-num      = "":U
     3798           .
     3799       end.
     3800       else do:
     3801           run fmtcli-get-client in this-procedure (
     3802                 input 'орг':U
     3803               , input v-torgconf-self-host-code
     3804           ).
     3805           assign
     3806               v-torgconf-self-host-name        = v-fmtcli-name
     3807               v-torgconf-self-host-engl-name   = v-fmtcli-engl-name
     3808               v-torgconf-self-host-addres      = v-fmtcli-full-addres
     3809               v-torgconf-self-host-post-addres = v-fmtcli-post-addres
     3810               v-torgconf-self-host-phone       = v-fmtcli-phone
     3811               v-torgconf-self-host-inn         = v-fmtcli-inn
     3812               v-torgconf-self-host-kpp         = v-fmtcli-kpp
     3813               v-torgconf-self-host-okpo        = v-fmtcli-okpo
     3814           .
     3815           run gbl/clntat-v.p (
     3816                 input 'орг':U
     3817               , input v-torgconf-self-host-code
     3818               , input 'egrip-date':U
     3819               , output v-torgconf-self-host-egrip-date
     3820               , output v-par-type
     3821           ).
     3822           run gbl/clntat-v.p (
     3823                 input 'орг':U
     3824               , input v-torgconf-self-host-code
     3825               , input 'egrip-num':U
     3826               , output v-torgconf-self-host-egrip-num
     3827               , output v-par-type
     3828           ).
     3829           run fmtcli-get-bank in this-procedure (
     3830                 input v-host-code
     3831               , input 'орг':U
     3832               , input v-torgconf-self-host-code
     3833               , input p-curr-code
     3834           ).
     3835       end.
     3836       assign
     3837           v-torgconf-self-schet-exists = v-fmtcli-schet-exists
     3838           v-torgconf-self-bank-exists  = v-fmtcli-bank-exists
     3839           v-torgconf-self-bank-r-schet = v-fmtcli-bank-r-schet
     3840           v-torgconf-self-bank-c-schet = v-fmtcli-bank-c-schet
     3841           v-torgconf-self-bank-bik     = v-fmtcli-bank-bik
     3842           v-torgconf-self-bank-name    = v-fmtcli-bank-name
     3843           v-torgconf-self-bank-addres  = v-fmtcli-bank-addres
     3844           v-torgconf-self-bank-city    = v-fmtcli-bank-city
     3845       .
     3846       assign
     3847           v-torgconf-self-obj-type = p-obj-type
     3848           v-torgconf-self-obj-code = p-obj-code
     3849       .
     3850       run fmtcli-get-client in this-procedure (
     3851             input p-obj-type
     3852           , input p-obj-code
     3853       ).
     3854       assign
     3855           v-torgconf-self-obj-name       = v-fmtcli-name
     3856           v-torgconf-self-obj-engl-name  = v-fmtcli-engl-name
     3857           v-torgconf-self-obj-addres     = v-fmtcli-full-addres
     3858           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     3859           v-torgconf-self-obj-phone      = v-fmtcli-phone
     3860           v-torgconf-self-obj-inn        = v-fmtcli-inn
     3861           v-torgconf-self-obj-okpo       = v-fmtcli-okpo
     3862       .
     3863   end.
     3864   end procedure.
     3865   procedure torgconf-get-recepient-param :
     3866   define input parameter torgconfdoc-code   as character                  no-undo.
     3867   define output parameter v-code-rec        as integer                    no-undo .
     3868   define output parameter v-type-rec        as character                  no-undo initial 'C':U.
     3869   define output parameter v-codefirm-rec    as integer                    no-undo .
     3870   define output parameter v-curcode-rec     as integer                    no-undo .
     3871        define variable  v-recipient-code  as character                  no-undo .
     3872        define variable  v-recipient       like ub.doc-attr.attr-value   no-undo.
     3873        define variable  v-trdcattr-type   as character                  no-undo initial 'C':U.
     3874   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input torgconfdoc-code ,
     3875                           input 'Recipient':U ,
     3876                          output v-recipient-code ,
     3877                          output v-trdcattr-type ) no-error .
     3878       if error-status :error then do:
     3879        message
     3880         vss-workfile vss-revision vss-description skip
     3881         "Ошибка при вызове процедуры tdat-val":U skip
     3882         "Документ: " torgconfdoc-code skip
     3883         "Атрибут: " 'Recipient':U skip
     3884         "Значение: " v-recipient skip
     3885         trim( error-status :get-message (1) ) skip
     3886         return-value skip
     3887         view-as alert-box error.
     3888       undo, return error return-value.
     3889       end.
     3890     assign
     3891       v-recipient  = v-recipient-code
     3892       v-type-rec = substring(v-recipient-code,1,3)
     3893       v-code-rec  = int(substring(v-recipient-code,4,15))
     3894       no-error
     3895     .
     3896     if v-type-rec = ? then v-type-rec = "" .
     3897     if v-code-rec  = ? then v-code-rec  =  0 .
     3898     end procedure.
