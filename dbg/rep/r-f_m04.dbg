        1   block-level on error undo, throw.
        2   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        3   DEFINE INPUT PARAMETER p-rec-id      AS RECID         NO-UNDO.
        4   define input parameter p-yukos       as logical       no-undo.
        5   define input parameter p-form-num     as integer       no-undo.
        6   DEFINE VARIABLE vss-revision    AS CHARACTER NO-UNDO INITIAL "$Revision: aea5316774be, 0, rls $":U.
        7   DEFINE VARIABLE vss-author      AS CHARACTER NO-UNDO INITIAL "$Author: expertek $":U.
        8   DEFINE VARIABLE vss-date        AS CHARACTER NO-UNDO INITIAL "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U.
        9   DEFINE VARIABLE vss-workfile    AS CHARACTER NO-UNDO INITIAL "$Workfile: r-f_m04.p $":U.
       10   DEFINE VARIABLE vss-archive     AS CHARACTER NO-UNDO INITIAL "$Archive: rep/r-f_m04.p $":U.
       11   DEFINE VARIABLE vss-description AS CHARACTER NO-UNDO INITIAL "печать приходного ордера (форма М-4)":U.
       12   procedure vss-get-info :
