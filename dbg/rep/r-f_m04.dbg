     1910       bfsacc_tt-allsum.vat-rubl-cur        = 0
     1911       bfsacc_tt-allsum.vat-base-buyer-cur  = bfs_tt-allsum.vat-base-acc
     1912       bfsacc_tt-allsum.vat-rubl-buyer-cur  = bfs_tt-allsum.vat-rubl-acc
     1913       bfsacc_tt-allsum.slt-base-cur        = bfs_tt-allsum.slt-base-acc
     1914       bfsacc_tt-allsum.slt-rubl-cur        = bfs_tt-allsum.slt-rubl-acc
     1915       bfsacc_tt-allsum.road-tax-base-cur   = bfs_tt-allsum.road-tax-base-acc
     1916       bfsacc_tt-allsum.road-tax-rubl-cur   = bfs_tt-allsum.road-tax-rubl-acc
     1917       bfsacc_tt-allsum.excise-base-cur     = bfs_tt-allsum.excise-base-acc
     1918       bfsacc_tt-allsum.excise-rubl-cur     = bfs_tt-allsum.excise-rubl-acc
     1919       bfsacc_tt-allsum.sum-dsc-base-acc    = bfs_tt-allsum.sum-dsc-base-acc
     1920       bfsacc_tt-allsum.sum-dsc-rubl-acc    = bfs_tt-allsum.sum-dsc-rubl-acc
     1921       bfsacc_tt-allsum.sum-dsc-cli-acc     = bfs_tt-allsum.sum-dsc-cli-acc
     1922       bfsacc_tt-allsum.dsc-base-acc        = bfs_tt-allsum.dsc-base-acc
     1923       bfsacc_tt-allsum.dsc-rubl-acc        = bfs_tt-allsum.dsc-rubl-acc
     1924       bfsacc_tt-allsum.dsc-cli-acc         = bfs_tt-allsum.dsc-cli-acc
     1925       bfsacc_tt-allsum.vat-base-acc        = bfs_tt-allsum.vat-base-acc
     1926       bfsacc_tt-allsum.vat-rubl-acc        = bfs_tt-allsum.vat-rubl-acc
     1927       bfsacc_tt-allsum.vat-cli-acc         = bfs_tt-allsum.vat-cli-acc
     1928       bfsacc_tt-allsum.slt-base-acc        = bfs_tt-allsum.slt-base-acc
     1929       bfsacc_tt-allsum.slt-rubl-acc        = bfs_tt-allsum.slt-rubl-acc
     1930       bfsacc_tt-allsum.slt-cli-acc         = bfs_tt-allsum.slt-cli-acc
     1931       bfsacc_tt-allsum.excise-base-acc     = bfs_tt-allsum.excise-base-acc
     1932       bfsacc_tt-allsum.excise-rubl-acc     = bfs_tt-allsum.excise-rubl-acc
     1933       bfsacc_tt-allsum.excise-cli-acc      = bfs_tt-allsum.excise-cli-acc
     1934       bfsacc_tt-allsum.road-tax-base-acc   = bfs_tt-allsum.road-tax-base-acc
     1935       bfsacc_tt-allsum.road-tax-rubl-acc   = bfs_tt-allsum.road-tax-rubl-acc
     1936       bfsacc_tt-allsum.road-tax-cli-acc    = bfs_tt-allsum.road-tax-cli-acc
     1937       bfsacc_tt-allsum.transport-base-acc  = bfs_tt-allsum.transport-base-acc
     1938       bfsacc_tt-allsum.transport-rubl-acc  = bfs_tt-allsum.transport-rubl-acc
     1939       bfsacc_tt-allsum.transport-cli-acc   = bfs_tt-allsum.transport-cli-acc
     1940       bfsacc_tt-allsum.other-base-acc      = bfs_tt-allsum.other-base-acc
     1941       bfsacc_tt-allsum.other-rubl-acc      = bfs_tt-allsum.other-rubl-acc
     1942       bfsacc_tt-allsum.other-cli-acc       = bfs_tt-allsum.other-cli-acc
     1943       .
     1944   end.
     1945   otherwise do:
     1946     return error substitute ("Неизвестный тип приобретения &1 по партии с кодом &2 по документу &3, порожденную документом &4 по товару &5 &6 &7.",
     1947                              cl_tt-clcparts.purch-code,
     1948                              cl_tt-clcparts.part-code,
     1949                              cl_tt-clcparts.out-code,
     1950                              cl_tt-clcparts.in-code,
     1951                              cl_tt-clcparts.artic,
     1952                              cl_tt-clcparts.prod-type,
     1953                              cl_tt-clcparts.prod-code).
     1954   end.
     1955   end case.
     1956   end.
     1957   end procedure.
     1958   procedure clcprtsl_calc-line :
     1959   define input  parameter parrec-line as recid no-undo.
     1960   define variable v-tax-date         as   date                     no-undo.
     1961   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     1962   define variable varr-b             as   character                no-undo.
     1963   define variable varr-btype         as   character                no-undo.
     1964   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     1965   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     1966   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     1967   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     1968   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     1969   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     1970   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     1971   define variable varb-code          like ub.bar-code.b-code       no-undo.
     1972   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     1973   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     1974   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     1975   define variable varexcise          like ub.price-list.excise     no-undo.
     1976   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     1977   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     1978   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     1979   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     1980   define variable v-varsum           as decimal                  no-undo.
     1981   define variable varprice-salef as decimal   no-undo .
     1982   define buffer bf_trn-doc             for ub.trn-doc.
     1983   define buffer bf_doc-line            for ub.doc-line.
     1984   define buffer bf_gds-dtl             for ub.gds-dtl.
     1985   define buffer bf_goods               for ub.goods.
     1986   define buffer bf_parts               for ub.parts.
     1987   define buffer bf_sysconf             for ub.sysconf.
     1988   define buffer bf_tt-allsum-line      for tt-allsum-line.
     1989   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     1990   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     1991   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     1992   define buffer buf_parts        for ub.parts.
     1993   v-calcbypart = no.
     1994   do on error undo, return error return-value :
     1995   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1996   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1997     (output varr-b
     1998     )  .
     1999     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     2000     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     2001     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     2002                               bf_goods.prod-type = bf_doc-line.prod-type and
     2003                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     2004     if bf_trn-doc.fact-date <> ?        then do:
     2005       assign v-tax-date = bf_trn-doc.fact-date.
     2006     end.
     2007     else do:
     2008       assign v-tax-date = ?.
     2009     end.
     2010   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2011   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2012     (input  bf_goods.gds-code
     2013     ,input  '1':U
     2014     ,input  v-tax-date
     2015     ,input  bf_trn-doc.host-code
     2016     ,input  bf_trn-doc.obj-type
     2017     ,input  bf_trn-doc.obj-code
     2018     ,output v-vat-pc
     2019     ) no-error .
     2020     if error-status :error
     2021     or v-vat-pc = ? then do:
     2022        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     2023     end.
     2024     if bf_goods.gds-type = 'у':U or
     2025        bf_trn-doc.status_ = 'запрос':U then do:
     2026       for each bf_tt-allsum-line
     2027       on error undo, return error return-value
     2028        :
     2029         delete bf_tt-allsum-line.
     2030       end.
     2031       create bf_tt-allsum-line.
     2032       assign
     2033        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     2034       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     2035                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     2036                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     2037                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     2038         assign
     2039           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     2040           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     2041           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     2042           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     2043           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     2044           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     2045           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     2046           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     2047           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     2048           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     2049           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     2050           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     2051           bf_tt-allsum-line.vat-cli-acc          =  ?
     2052           .
     2053       end.
     2054       assign
     2055         bf_tt-allsum-line.cli-qnty             =  ?
     2056         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2057         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2058         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2059         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2060         bf_tt-allsum-line.road-tax-base-doc    =  0
     2061         bf_tt-allsum-line.road-tax-rubl-doc    =  0
     2062         bf_tt-allsum-line.excise-base-doc      =  0
     2063         bf_tt-allsum-line.excise-rubl-doc      =  0
     2064         bf_tt-allsum-line.vat-base-doc         =  bf_tt-allsum-line.vat-base-buyer-doc
     2065         bf_tt-allsum-line.vat-rubl-doc         =  bf_tt-allsum-line.vat-rubl-buyer-doc
     2066         bf_tt-allsum-line.dsc-base-cur         =  0
     2067         bf_tt-allsum-line.dsc-rubl-cur         =  0
     2068         bf_tt-allsum-line.slt-base-cur         =  bf_tt-allsum-line.sum-dsc-base-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2069         bf_tt-allsum-line.slt-rubl-cur         =  bf_tt-allsum-line.sum-dsc-rubl-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2070         bf_tt-allsum-line.vat-base-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-base-cur - bf_tt-allsum-line.slt-base-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2071         bf_tt-allsum-line.vat-rubl-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-rubl-cur - bf_tt-allsum-line.slt-rubl-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2072         bf_tt-allsum-line.road-tax-base-cur    =  0
     2073         bf_tt-allsum-line.road-tax-rubl-cur    =  0
     2074         bf_tt-allsum-line.excise-base-cur      =  0
     2075         bf_tt-allsum-line.excise-rubl-cur      =  0
     2076         bf_tt-allsum-line.vat-base-cur         =  bf_tt-allsum-line.vat-base-buyer-cur
     2077         bf_tt-allsum-line.vat-rubl-cur         =  bf_tt-allsum-line.vat-rubl-buyer-cur
     2078         bf_tt-allsum-line.dsc-base-acc         =  0
     2079         bf_tt-allsum-line.dsc-rubl-acc         =  0
     2080         bf_tt-allsum-line.dsc-cli-acc          =  0
     2081         bf_tt-allsum-line.slt-base-acc         =  0
     2082         bf_tt-allsum-line.slt-rubl-acc         =  0
     2083         bf_tt-allsum-line.slt-cli-acc          =  0
     2084         bf_tt-allsum-line.road-tax-base-acc    =  0
     2085         bf_tt-allsum-line.road-tax-rubl-acc    =  0
     2086         bf_tt-allsum-line.road-tax-cli-acc     =  0
     2087         bf_tt-allsum-line.excise-base-acc      =  0
     2088         bf_tt-allsum-line.excise-rubl-acc      =  0
     2089         bf_tt-allsum-line.excise-cli-acc       =  0
     2090         bf_tt-allsum-line.transport-base-acc   =  0
     2091         bf_tt-allsum-line.transport-rubl-acc   =  0
     2092         bf_tt-allsum-line.transport-cli-acc    =  0
     2093         bf_tt-allsum-line.other-base-acc       =  0
     2094         bf_tt-allsum-line.other-rubl-acc       =  0
     2095         bf_tt-allsum-line.other-cli-acc        =  0
     2096         .
     2097       create bfs_tt-allsum-line.
     2098       assign
     2099       bfs_tt-allsum-line.sum-type = 'основная_сумма_со_знаком':U.
     2100       if bf_trn-doc.doc-type = 'инв':U or
     2101          bf_trn-doc.doc-type = 'при':U    or
     2102          bf_trn-doc.doc-type = 'возврат':U    then do:
     2103          buffer-copy bf_tt-allsum-line except bf_tt-allsum-line.sum-type to bfs_tt-allsum-line.
     2104       end.
     2105       else do:
     2106         assign
     2107           bfs_tt-allsum-line.fact-qnty           =  - bf_tt-allsum-line.fact-qnty
     2108           bfs_tt-allsum-line.cli-qnty            =  - bf_tt-allsum-line.cli-qnty
     2109           bfs_tt-allsum-line.sum-dsc-base-doc    =  - bf_tt-allsum-line.sum-dsc-base-doc
     2110           bfs_tt-allsum-line.sum-dsc-rubl-doc    =  - bf_tt-allsum-line.sum-dsc-rubl-doc
     2111           bfs_tt-allsum-line.dsc-base-doc        =  - bf_tt-allsum-line.dsc-base-doc
     2112           bfs_tt-allsum-line.dsc-rubl-doc        =  - bf_tt-allsum-line.dsc-rubl-doc
     2113           bfs_tt-allsum-line.vat-base-doc        =  - bf_tt-allsum-line.vat-base-doc
     2114           bfs_tt-allsum-line.vat-rubl-doc        =  - bf_tt-allsum-line.vat-rubl-doc
     2115           bfs_tt-allsum-line.vat-base-buyer-doc  =  - bf_tt-allsum-line.vat-base-buyer-doc
     2116           bfs_tt-allsum-line.vat-rubl-buyer-doc  =  - bf_tt-allsum-line.vat-rubl-buyer-doc
     2117           bfs_tt-allsum-line.slt-base-doc        =  - bf_tt-allsum-line.slt-base-doc
     2118           bfs_tt-allsum-line.slt-rubl-doc        =  - bf_tt-allsum-line.slt-rubl-doc
     2119           bfs_tt-allsum-line.road-tax-base-doc   =  - bf_tt-allsum-line.road-tax-base-doc
     2120           bfs_tt-allsum-line.road-tax-rubl-doc   =  - bf_tt-allsum-line.road-tax-rubl-doc
     2121           bfs_tt-allsum-line.excise-base-doc     =  - bf_tt-allsum-line.excise-base-doc
     2122           bfs_tt-allsum-line.excise-rubl-doc     =  - bf_tt-allsum-line.excise-rubl-doc
     2123           bfs_tt-allsum-line.sum-dsc-base-cur    =  - bf_tt-allsum-line.sum-dsc-base-cur
     2124           bfs_tt-allsum-line.sum-dsc-rubl-cur    =  - bf_tt-allsum-line.sum-dsc-rubl-cur
     2125           bfs_tt-allsum-line.dsc-base-cur        =  - bf_tt-allsum-line.dsc-base-cur
     2126           bfs_tt-allsum-line.dsc-rubl-cur        =  - bf_tt-allsum-line.dsc-rubl-cur
     2127           bfs_tt-allsum-line.vat-base-cur        =  - bf_tt-allsum-line.vat-base-cur
     2128           bfs_tt-allsum-line.vat-rubl-cur        =  - bf_tt-allsum-line.vat-rubl-cur
     2129           bfs_tt-allsum-line.vat-base-buyer-cur  =  - bf_tt-allsum-line.vat-base-buyer-cur
     2130           bfs_tt-allsum-line.vat-rubl-buyer-cur  =  - bf_tt-allsum-line.vat-rubl-buyer-cur
     2131           bfs_tt-allsum-line.slt-base-cur        =  - bf_tt-allsum-line.slt-base-cur
     2132           bfs_tt-allsum-line.slt-rubl-cur        =  - bf_tt-allsum-line.slt-rubl-cur
     2133           bfs_tt-allsum-line.road-tax-base-cur   =  - bf_tt-allsum-line.road-tax-base-cur
     2134           bfs_tt-allsum-line.road-tax-rubl-cur   =  - bf_tt-allsum-line.road-tax-rubl-cur
     2135           bfs_tt-allsum-line.excise-base-cur     =  - bf_tt-allsum-line.excise-base-cur
     2136           bfs_tt-allsum-line.excise-rubl-cur     =  - bf_tt-allsum-line.excise-rubl-cur
     2137           bfs_tt-allsum-line.sum-dsc-base-acc    =  - bf_tt-allsum-line.sum-dsc-base-acc
     2138           bfs_tt-allsum-line.sum-dsc-rubl-acc    =  - bf_tt-allsum-line.sum-dsc-rubl-acc
     2139           bfs_tt-allsum-line.sum-dsc-cli-acc     =  - bf_tt-allsum-line.sum-dsc-cli-acc
     2140           bfs_tt-allsum-line.dsc-base-acc        =  - bf_tt-allsum-line.dsc-base-acc
     2141           bfs_tt-allsum-line.dsc-rubl-acc        =  - bf_tt-allsum-line.dsc-rubl-acc
     2142           bfs_tt-allsum-line.dsc-cli-acc         =  - bf_tt-allsum-line.dsc-cli-acc
     2143           bfs_tt-allsum-line.vat-base-acc        =  - bf_tt-allsum-line.vat-base-acc
     2144           bfs_tt-allsum-line.vat-rubl-acc        =  - bf_tt-allsum-line.vat-rubl-acc
     2145           bfs_tt-allsum-line.vat-cli-acc         =  - bf_tt-allsum-line.vat-cli-acc
     2146           bfs_tt-allsum-line.slt-base-acc        =  - bf_tt-allsum-line.slt-base-acc
     2147           bfs_tt-allsum-line.slt-rubl-acc        =  - bf_tt-allsum-line.slt-rubl-acc
     2148           bfs_tt-allsum-line.slt-cli-acc         =  - bf_tt-allsum-line.slt-cli-acc
     2149           bfs_tt-allsum-line.road-tax-base-acc   =  - bf_tt-allsum-line.road-tax-base-acc
