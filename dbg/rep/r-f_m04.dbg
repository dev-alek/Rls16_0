     6101            then do:
     6102               v-torgconf-ogr-post = buf_person.position.
     6103            end.
     6104            if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     6105            if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
