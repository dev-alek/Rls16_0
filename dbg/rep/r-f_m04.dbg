     4294   procedure torgconf-get-holdfirm-code :
     4295   define input parameter p-obj-type   as character        no-undo.
     4296   define input parameter p-obj-code   as integer          no-undo.
     4297   define output parameter p-firm-code as integer          no-undo.
     4298       define variable v-firm-code-str     as character    no-undo.
     4299       define variable v-par-type          as character    no-undo.
     4300       define buffer buf_clients       for ub.clients.
     4301   do
     4302   for buf_clients
     4303   on error undo, return error
     4304   :
     4305       run gbl/clntat-v.p (
     4306             input p-obj-type
     4307           , input p-obj-code
     4308           , input 'holdfirm-code':U
     4309           , output v-firm-code-str
     4310           , output v-par-type
     4311       ).
     4312       assign
     4313           p-firm-code = integer( v-firm-code-str )
     4314       no-error.
     4315       if error-status :error
     4316       then do:
     4317           message
     4318               "Неверно задан код фирмы для печати накладных."
     4319           view-as alert-box warning.
     4320           assign
     4321               p-firm-code = 0
     4322           .
     4323       end.
     4324       else do:
     4325           find first buf_clients no-lock
     4326                where buf_clients.obj-type = 'орг':U
     4327                  and buf_clients.obj-code = p-firm-code
     4328           no-error.
     4329           if not available buf_clients
     4330           then do:
     4331               message
     4332                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     4333                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     4334               view-as alert-box warning.
     4335               assign
     4336                   p-firm-code = 0
     4337               .
     4338           end.
     4339       end.
     4340   end.
     4341   end procedure.
     4342   procedure torgconf-get-post-head:
     4343   define input  parameter p-obj-type             as character        no-undo.
     4344   define input  parameter p-obj-code             as integer          no-undo.
     4345   define output parameter p-torgconf-post-head   as character        no-undo.
     4346      define variable v-host-code         as integer      no-undo.
     4347      define buffer buf_sysconf     for ub.sysconf.
     4348        assign
     4349         p-torgconf-post-head  = ""
     4350        .
     4351   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4352   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4353     (input  p-obj-type
     4354     ,input  p-obj-code
     4355     ,output v-host-code
     4356     )  .
     4357      find first buf_sysconf no-lock
     4358      where buf_sysconf.host-code = v-host-code
     4359      no-error.
     4360      if available buf_sysconf
     4361      then do:
     4362         assign
     4363            p-torgconf-post-head = buf_sysconf.head-position
     4364         .
     4365      end.
     4366   end procedure.
     4367   procedure torgconf-get-storekeeper:
     4368   define input  parameter p-wrkr                   as integer          no-undo.
     4369   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     4370   define output parameter p-torgconf-post          as character        no-undo.
     4371      define buffer buf_sysconf     for ub.sysconf.
     4372      define buffer buf_person      for ub.person.
     4373      define buffer buf_shop        for ub.shop .
     4374      define buffer buf_store       for ub.store .
     4375      if v-torgconf-outC = "no_print"
     4376      then do:
     4377         assign p-torgconf-post = ""
     4378                p-torgconf-wrkr-name = ""
     4379                .
     4380      end.
     4381      if v-torgconf-outC = "clad_doc"
     4382      then do:
     4383         run rep/get-psn.p
     4384               (input  p-wrkr
     4385               ,output p-torgconf-wrkr-name
     4386               ) .
     4387         find first buf_person no-lock
     4388         where buf_person.psn-code = p-wrkr
     4389         no-error.
     4390         if available buf_person
     4391         then do:
     4392           p-torgconf-post = buf_person.position.
     4393         end.
     4394         if p-torgconf-post = "?":U then p-torgconf-post = "".
     4395         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     4396      end.
     4397      if v-torgconf-outC = "clad_obj"
     4398      then do:
     4399         CASE v-torgconf-self-obj-type:
     4400         WHEN 'маг':U
     4401         THEN DO:
     4402            find first buf_shop no-lock
     4403            where buf_shop.obj-code = v-torgconf-self-obj-code
     4404            .
     4405            assign
     4406               p-torgconf-wrkr-name = buf_shop.store-man
     4407               p-torgconf-post = ""
     4408            .
     4409            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     4410         END.
     4411         WHEN 'скл':U
     4412         THEN DO:
     4413            find first buf_store no-lock
     4414            where buf_store.obj-code = v-torgconf-self-obj-code
     4415            .
     4416            assign
     4417               p-torgconf-wrkr-name = buf_store.store-man
     4418               p-torgconf-post = ""
     4419            .
     4420            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     4421         END.
     4422         OTHERWISE DO:
     4423            assign
     4424               p-torgconf-post = "":U
     4425               p-torgconf-wrkr-name = "":U
     4426            .
     4427         END.
     4428         END CASE.
     4429      end.
     4430    end procedure.
     4431   procedure torgconf-get-form-header :
     4432   define input parameter p-for-inverse    as logical          no-undo.
     4433   define input parameter p-doc-code       as character        no-undo.
     4434   define input parameter p-print-doc      as logical          no-undo.
     4435   define input parameter p-doc-date       as date             no-undo.
     4436   define input parameter p-fact-date      as date             no-undo.
     4437   define input parameter p-doc-type       as character        no-undo.
     4438   define input parameter p-status_        as character        no-undo.
     4439   define input parameter p-reverse        as logical          no-undo.
     4440   define input parameter p-sf-par         as logical          no-undo.
     4441       define variable v-attr-type         as character    no-undo.
     4442       define variable v-doc-code-standard as logical      no-undo.
     4443       define variable v-doc-date-standard as logical      no-undo.
     4444       define variable v-par-consignee-addres  as character    no-undo.
     4445       define variable v-host-code         as integer      no-undo.
     4446       define variable v-dcode-attr        as character    no-undo.
     4447       define variable v-ddate-attr        as character    no-undo.
     4448       define variable v-doc-date          as character    no-undo.
     4449       define variable v-doc-code          as character    no-undo.
     4450       define variable v-par-type          as character    no-undo.
     4451       define variable v-attr              as character    no-undo.
     4452       define buffer buf_firm          for ub.firm .
     4453       define buffer buf_clients       for ub.clients .
     4454       define buffer buf_sysconf       for ub.sysconf .
     4455       define buffer buf_shop          for ub.shop .
     4456       define buffer buf_store         for ub.store .
     4457       define buffer buf_person        for ub.person .
     4458       define buffer buf_trn-doc       for ub.trn-doc .
     4459       define buffer buf_wth-doc       for ub.wth-doc .
     4460       do
     4461   for buf_firm
     4462     , buf_clients
     4463     , buf_sysconf
     4464     , buf_shop
     4465     , buf_trn-doc
     4466     , buf_person
     4467     , buf_wth-doc
     4468   on error undo, return error
     4469   :
     4470       if p-doc-type = 'при':U
     4471       or p-doc-type = 'возврат':U
     4472       then do:
     4473           assign
     4474               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
