     4094   procedure torgconf-get-sup-param :
     4095   define input parameter p-obj-type           as character        no-undo.
     4096   define input parameter p-obj-code           as integer          no-undo.
     4097   define input parameter p-curr-code          as integer          no-undo.
     4098       define variable v-host-code    as integer      no-undo.
     4099       define variable v-par-type     as character    no-undo.
     4100   do
     4101   on error undo, return error
     4102   :
     4103       assign
     4104          v-torgconf-sup-host-code = v-host-code
     4105       .
     4106       if v-torgconf-sup-host-code = 0
     4107       then do:
     4108           assign
     4109               v-torgconf-sup-host-name           = "":U
     4110               v-torgconf-sup-host-addres         = "":U
     4111               v-torgconf-sup-host-post-addres    = "":U
     4112               v-torgconf-sup-host-phone          = "":U
     4113               v-torgconf-sup-host-inn            = "":U
     4114               v-torgconf-sup-host-kpp            = "":U
     4115               v-torgconf-sup-host-okpo           = "":U
     4116               v-torgconf-sup-host-egrip-date     = "":U
     4117               v-torgconf-sup-host-egrip-num      = "":U
     4118           .
     4119       end.
     4120       else do:
     4121           run fmtcli-get-client in this-procedure (
     4122                 input 'орг':U
     4123               , input v-torgconf-sup-host-code
     4124           ).
     4125           assign
     4126               v-torgconf-sup-host-name        = v-fmtcli-name
     4127               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     4128               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     4129               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     4130               v-torgconf-sup-host-phone       = v-fmtcli-phone
     4131               v-torgconf-sup-host-inn         = v-fmtcli-inn
     4132               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     4133               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     4134           .
     4135           run gbl/clntat-v.p (
     4136                 input 'орг':U
     4137               , input v-torgconf-sup-host-code
     4138               , input 'egrip-date':U
     4139               , output v-torgconf-sup-host-egrip-date
     4140               , output v-par-type
     4141           ).
     4142           run gbl/clntat-v.p (
     4143                 input 'орг':U
     4144               , input v-torgconf-sup-host-code
     4145               , input 'egrip-num':U
     4146               , output v-torgconf-sup-host-egrip-num
     4147               , output v-par-type
     4148           ).
     4149           run fmtcli-get-bank in this-procedure (
     4150                 input v-host-code
     4151               , input 'орг':U
     4152               , input v-torgconf-sup-host-code
     4153               , input p-curr-code
     4154           ).
     4155       end.
     4156       assign
     4157           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     4158           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     4159           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     4160           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     4161           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     4162           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     4163           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     4164           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     4165       .
     4166       assign
     4167           v-torgconf-sup-obj-type = p-obj-type
     4168           v-torgconf-sup-obj-code = p-obj-code
     4169       .
     4170       if trim(p-obj-type) <> ""
     4171       and p-obj-code <> 0
     4172       then do:
     4173       run fmtcli-get-client in this-procedure (
     4174             input p-obj-type
     4175           , input p-obj-code
     4176       ).
     4177       assign
     4178           v-torgconf-sup-obj-name        = v-fmtcli-name
     4179           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     4180           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     4181           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     4182           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     4183           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     4184           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     4185       .
     4186      end.
     4187      end.
     4188   end procedure.
     4189   procedure torgconf-get-cli-param :
     4190   define input parameter p-host-obj-code      as integer          no-undo.
     4191   define input parameter p-obj-type           as character        no-undo.
     4192   define input parameter p-obj-code           as integer          no-undo.
     4193   define input parameter p-curr-code          as integer          no-undo.
     4194       define variable v-host-code    as integer      no-undo.
