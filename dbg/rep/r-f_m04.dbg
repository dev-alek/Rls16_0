     3239   define variable v-torgconf-ext-doc-type as character    no-undo.
     3240   define variable v-torgconf-outdate   as logical  init no    no-undo.
     3241   define variable v-torgconf-outnum    as logical  init no    no-undo.
     3242   define variable v-torgconf-outprim   as logical  init no    no-undo.
     3243   define variable v-torgconf-outdisc   as logical  init no    no-undo.
     3244   define variable v-torgconf-outsubs   as logical  init no    no-undo.
     3245   define variable v-torgconf-outrecv   as logical  init no    no-undo.
     3246   define variable v-torgconf-outegrp   as logical  init no    no-undo.
     3247   define variable v-torgconf-outt12    as logical  init no    no-undo.
     3248   define variable v-torgconf-outappr   as logical  init no    no-undo.
     3249   define variable v-torgconf-outrubl   as logical  init no    no-undo.
     3250   define variable v-torgconf-outhold   as logical  init no    no-undo.
     3251   define variable v-torgconf-outobj    as logical  init no    no-undo.
     3252   define variable v-torgconf-outexlst  as logical  init no    no-undo.
     3253   define variable v-torgconf-outexpas  as character  init no    no-undo.
     3254   define variable v-torgconf-outprncd  as logical  init no    no-undo.
     3255   define variable v-torgconf-outares   as logical  init no    no-undo.
     3256   define variable v-torgconf-outsend   as logical  init no    no-undo.
     3257   define variable v-torgconf-outasend  as logical  init no    no-undo.
     3258   define variable v-torgconf-outprops  as logical  init no    no-undo.
     3259   define variable v-torgconf-outogr    as character no-undo.
     3260   define variable v-torgconf-outR      as character no-undo.
     3261   define variable v-torgconf-outB      as character no-undo.
     3262   define variable v-torgconf-outC      as character no-undo.
     3263   define variable v-torgconf-outssdoc  as character init "":U no-undo.
     3264   define variable v-torgconf-self-host-code           as integer      no-undo.
     3265   define variable v-torgconf-self-host-type           as character    INITIAL 'орг':U  no-undo.
     3266   define variable v-torgconf-self-host-name           as character    no-undo.
     3267   define variable v-torgconf-self-host-engl-name           as character    no-undo.
     3268   define variable v-torgconf-self-host-addres         as character    no-undo.
     3269   define variable v-torgconf-self-host-post-addres    as character    no-undo.
     3270   define variable v-torgconf-self-host-phone          as character    no-undo.
     3271   define variable v-torgconf-self-host-inn            as character    no-undo.
     3272   define variable v-torgconf-self-host-kpp            as character    no-undo.
     3273   define variable v-torgconf-self-host-okpo           as character    no-undo.
     3274   define variable v-torgconf-self-host-egrip-date     as character    no-undo.
     3275   define variable v-torgconf-self-host-egrip-num      as character    no-undo.
     3276   define variable v-torgconf-sup-host-code            as integer      no-undo.
     3277   define variable v-torgconf-sup-host-type            as character  INITIAL 'орг':U  no-undo.
