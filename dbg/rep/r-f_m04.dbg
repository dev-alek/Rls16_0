     4279           , input p-obj-code
     4280           , input p-curr-code
     4281       ).
     4282       assign
     4283           v-torgconf-ship-schet-exists = v-fmtcli-schet-exists
     4284           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
     4285           v-torgconf-ship-bank-r-schet = v-fmtcli-bank-r-schet
     4286           v-torgconf-ship-bank-c-schet = v-fmtcli-bank-c-schet
     4287           v-torgconf-ship-bank-bik     = v-fmtcli-bank-bik
     4288           v-torgconf-ship-bank-name    = v-fmtcli-bank-name
     4289           v-torgconf-ship-bank-addres  = v-fmtcli-bank-addres
     4290           v-torgconf-ship-bank-city    = v-fmtcli-bank-city
     4291       .
