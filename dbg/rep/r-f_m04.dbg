     2385   procedure clcprtsl_calc-ttable :
     2386   define input parameter paris-doc           as   logical                 no-undo.
     2387   define input parameter paris-cur           as   logical                 no-undo.
     2388   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     2389   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     2390   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     2391   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     2392   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     2393   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     2394   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     2395   define input parameter parr-b              as   character               no-undo.
     2396   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     2397   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     2398   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     2399   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     2400   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     2401   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     2402   define buffer bf_tt-allsum      for tt-allsum.
     2403   define buffer bf_tt-clcparts    for tt-clcparts.
     2404   define buffer bf_tt-allsum-line for tt-allsum-line.
     2405   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     2406   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     2407   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     2408   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     2409   define variable varexcise          like ub.price-list.excise     no-undo.
     2410   do on error undo, return error return-value :
     2411   for each bf_tt-allsum-line
     2412   on error undo, return error return-value
     2413    :
     2414     delete bf_tt-allsum-line.
     2415   end.
     2416   for each bf_tt-allsum
     2417   on error undo, return error return-value
     2418   :
     2419     delete bf_tt-allsum.
     2420   end.
     2421   for each bf_tt-clcparts
     2422   on error undo, return error return-value
     2423   :
     2424   if v-calcbypart then do:
     2425             assign
     2426             parcur-base =   bf_tt-clcparts.part-cur-base
     2427             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     2428             parcur-excise =   bf_tt-clcparts.part-cur-excise
     2429             .
     2430   end.
     2431      run clcprtsl_calc-parts in this-procedure (
     2432        input recid(bf_tt-clcparts),
     2433        input paris-doc,
     2434        input paris-cur,
     2435        input parroad-tax,
     2436        input parexcise,
     2437        input parvat-pc,
     2438        input parcons-vat-pc,
     2439        input parslt-pc,
     2440        input parbase-rate,
     2441        input parbase-scale,
     2442        input parr-b,
     2443        input parcur-base,
     2444        input parcur-road-tax,
     2445        input parcur-excise,
     2446        input parcur-vat-pc,
     2447        input parcurcons-vat-pc,
     2448        input parcurslt-pc
     2449        ) no-error.
     2450     if error-status:error then do:
     2451       message
     2452         vss-workfile vss-revision vss-description skip
     2453         vss-include-info4 skip
     2454         "Ошибка при обсчете партии" skip
     2455         "Документ партии " bf_tt-clcparts.out-code skip
     2456         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     2457         return-value skip
     2458         error-status:get-message(1) skip
     2459         error-status:get-message(2) skip
     2460         error-status:get-message(3) skip
     2461         view-as alert-box error .
     2462       undo, return error .
     2463     end.
     2464     for each bf_tt-allsum on error undo, return error return-value :
     2465       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     2466       if not available bf_tt-allsum-line then do:
     2467         create bf_tt-allsum-line.
