     4270           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     4271           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     4272           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     4273           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     4274       .
     4275       end.
     4276           run fmtcli-get-bank in this-procedure (
     4277             input p-host-obj-code
