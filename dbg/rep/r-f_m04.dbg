     5759               v-torgconf-main-boss = ""
     5760               v-torgconf-main-boss-post = ""
     5761            .
     5762         end.
     5763      if v-torgconf-outR = "ruk_firm"
     5764         then do:
     5765            find first buf_sysconf no-lock
     5766            where buf_sysconf.host-code = v-torgconf-self-host-code
     5767            no-error.
     5768            if available buf_sysconf
     5769            then do:
     5770               assign
     5771                  v-torgconf-main-boss-post = buf_sysconf.head-position
     5772               .
     5773            end.
     5774            find first buf_clients no-lock
     5775            where buf_clients.obj-type = 'орг':U
     5776            and buf_clients.obj-code = v-torgconf-self-host-code
     5777            .
     5778            find first buf_firm no-lock
     5779            where buf_firm.firm-code = buf_clients.obj-code
     5780            no-error.
     5781            if available buf_firm
     5782            then do:
     5783               assign
     5784                  v-torgconf-main-boss = buf_firm.director
     5785               .
     5786            end.
     5787         end.
     5788      if v-torgconf-outR = "dir_obj"
     5789         then do:
     5790            CASE v-torgconf-self-obj-type:
     5791            WHEN 'маг':U
     5792            THEN DO:
     5793               find first buf_shop no-lock
     5794               where buf_shop.obj-code = v-torgconf-self-obj-code
     5795               .
     5796               assign
     5797                  v-torgconf-main-boss = buf_shop.director
     5798                  v-torgconf-main-boss-post = "Директор"
     5799               .
     5800            END.
     5801            WHEN 'скл':U
     5802            THEN DO:
     5803               find first buf_store no-lock
     5804               where buf_store.obj-code = v-torgconf-self-obj-code
     5805               .
     5806               assign
     5807                  v-torgconf-main-boss = buf_store.store-boss
     5808                  v-torgconf-main-boss-post = "Директор"
     5809               .
     5810            END.
     5811            OTHERWISE DO:
     5812               assign
     5813                  v-torgconf-main-boss       = "":U
     5814                  v-torgconf-main-boss-post  = "":U
     5815               .
     5816            END.
     5817            END CASE.
     5818         end.
     5819      if  v-name <> 'wthtrg12':U
     5820      and v-name <> 'wthfct':U
     5821      and v-name <> 'wthm11':U
     5822      then do:
     5823       find first buf_trn-doc no-lock
     5824       where buf_trn-doc.doc-code = p-doc-code
     5825       no-error.
     5826       if available buf_trn-doc
     5827         then do:
     5828   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5829   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     5830     (input  buf_trn-doc.obj-type
     5831     ,input  buf_trn-doc.obj-code
     5832     ,output v-host-code
     5833     )  .
     5834         end.
     5835       if v-torgconf-outogr = "no_print"
     5836         then do:
