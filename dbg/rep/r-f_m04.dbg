     6178   procedure torgconf-get-reason  :
     6179   define input parameter  p-doc-code       as character        no-undo.
     6180   define input parameter  p-reason-code    as integer          no-undo .
     6181   define input parameter  p-doc-type       as character        no-undo.
     6182       if p-reason-code > 0
     6183       then do:
     6184           define buffer buf_trn-reason for ub.trn-reason.
     6185           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     6186           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     6187       end.
     6188       else do:
     6189           if p-doc-type = 'при':U
     6190           then  do:
     6191               define variable v-attr-type     as character    no-undo.
     6192               define variable v-attr-value    as character    no-undo.
     6193               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     6194               assign v-torgconf-reason = v-attr-value .
     6195               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     6196               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     6197           end.
     6198       end.
     6199   end procedure.
     6200   define variable g#report-num          as integer   no-undo .
     6201   run get-report-num  in parparentproc (output g#report-num ).
     6202   define variable g#quest-print         as logical   no-undo .
     6203   run get-quest-print in parparentproc (output g#quest-print ).
     6204   DEFINE VARIABLE v-host-name AS CHARACTER NO-UNDO.
     6205   DEFINE VARIABLE v-obj-name  AS CHARACTER NO-UNDO.
