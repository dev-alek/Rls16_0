     3390   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3391   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     3392     (input  bf_goods.gds-code
     3393     ,input  '1':U
     3394     ,input  bf_trn-doc.fact-date
     3395     ,input  bf_trn-doc.host-code
     3396     ,input  bf_trn-doc.obj-type
     3397     ,input  bf_trn-doc.obj-code
     3398     ,output varcur-vat-pc
     3399     ) no-error .
     3400       if varcur-vat-pc = ?
     3401       then do:
     3402         return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3 документ &4", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code, bf_trn-doc.doc-code).
     3403       end.
     3404       if varcur-slt-pc = ?
     3405       then do:
     3406         return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3 документ &4", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code, bf_trn-doc.doc-code).
     3407       end.
     3408       v-calcbypart = no.
     3409       if bf_doc-line.whole-send-news = integer('1':U)   then
     3410       v-calcbypart = yes.
     3411       else do:
     3412       for each bf_gds-dtl no-lock
     3413         where bf_gds-dtl.doc-code  = bf_doc-line.doc-code
     3414           and bf_gds-dtl.artic     = bf_doc-line.artic
     3415           and bf_gds-dtl.prod-type = bf_doc-line.prod-type
     3416           and bf_gds-dtl.prod-code = bf_doc-line.prod-code
     3417       on error undo, return error return-value
     3418       :
     3419   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3420     (input  bf_goods.gds-code
     3421     ,input  bf_gds-dtl.prt-code
     3422     ,output varb-code
     3423     ) no-error .
     3424   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3425   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     3426     (input  bf_trn-doc.obj-type
     3427     ,input  bf_trn-doc.obj-code
     3428     ,input  varb-code
     3429     ,input  0
     3430     ,input  bf_trn-doc.fact-order
     3431     ,output vardoc-num
     3432     ,output varprice-sale
     3433     ,output varroad-tax
     3434     ,output varexcise
     3435     )  .
     3436             if varprice-sale = ?
     3437             then do:
     3438               assign
     3439                 varprice-sale = 0
     3440                 varroad-tax   = 0
     3441                 varexcise     = 0
     3442               .
     3443             end.
     3444             assign
     3445               varlastcur-base     = varprice-sale
     3446               varlastcur-road-tax = varroad-tax
     3447               varlastcur-excise   = varexcise
     3448               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     3449               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     3450               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     3451               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     3452             .
     3453         end.
     3454       end.
     3455       if varcur-fact-qnty = 0 then do:
     3456         assign
     3457           varcur-base      = varlastcur-base
     3458           varcur-road-tax  = varlastcur-road-tax
     3459           varcur-excise    = varlastcur-excise
     3460         .
     3461       end.
     3462       else do:
     3463         assign
     3464           varcur-base      = varcur-base      / varcur-fact-qnty
     3465           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     3466           varcur-excise    = varcur-excise    / varcur-fact-qnty
     3467         .
     3468       end.
     3469       if varcur-vat-pc = ?
     3470       then do:
     3471         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     3472       end.
     3473       if varcur-slt-pc = ?
     3474       then do:
     3475         return error substitute ("Нет текущего продажного НП по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     3476       end.
     3477       find first bf_sysconf where bf_sysconf.host-code = bf_trn-doc.host-code no-lock.
     3478       assign
     3479         varcur-cons-vat-pc = bf_sysconf.cons-vat-pc.
     3480       if varcur-cons-vat-pc = ? then do:
     3481         return error substitute ("Нет текущего продажного консигнационного НДС по фирме &1", bf_trn-doc.host-code).
     3482       end.
     3483       define buffer buf_tt-clcparts for tt-clcparts .
     3484       for each buf_tt-clcparts
     3485       on error undo, return error return-value
     3486       :
     3487         delete buf_tt-clcparts.
     3488       end.
     3489       for each bf_parts no-lock
     3490         where bf_parts.out-code  = bf_doc-line.doc-code
     3491           and bf_parts.obj-type  = bf_doc-line.obj-type
     3492           and bf_parts.obj-code  = bf_doc-line.obj-code
     3493           and bf_parts.artic     = bf_doc-line.artic
     3494           and bf_parts.prod-type = bf_doc-line.prod-type
     3495           and bf_parts.prod-code = bf_doc-line.prod-code
     3496       on error undo, return error return-value
     3497       :
     3498         create buf_tt-clcparts .
     3499         buffer-copy bf_parts to buf_tt-clcparts .
     3500         if v-calcbypart = yes   then do:
     3501   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partbcod in g#library
     3502     (buffer bf_parts
     3503     ,output v-b-pcode
     3504     ) no-error .
     3505   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3506   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     3507     (input  bf_parts.obj-type
     3508     ,input  bf_parts.obj-code
     3509     ,input  v-b-pcode
     3510     ,input  0
     3511     ,input  bf_trn-doc.fact-order
     3512     ,output vardoc-num
     3513     ,output varprice-salef
     3514     ,output varroad-tax
     3515     ,output varexcise
     3516     ) no-error .
     3517             if varprice-sale = ?
     3518             then do:
     3519               assign
     3520                 varprice-salef = 0
     3521                 varroad-tax   = 0
     3522                 varexcise     = 0
     3523               .
     3524             end.
     3525             assign
     3526             part-cur-base  = varprice-salef
     3527             part-cur-road-tax  = varroad-tax
     3528             part-cur-excise = varexcise.
     3529         end.
     3530       end.
     3531       run clcprtsl_calc-ttable in this-procedure
     3532         (input yes,
     3533          input yes,
     3534          input bf_doc-line.road-tax,
     3535          input bf_doc-line.excise,
     3536          input bf_doc-line.vat-pc,
     3537          input bf_doc-line.cons-vat-pc,
     3538          input bf_doc-line.slt-pc,
     3539          input bf_trn-doc.base-rate,
     3540          input bf_trn-doc.base-scale,
     3541          input varr-b,
     3542          input varcur-base,
     3543          input varcur-road-tax,
     3544          input varcur-excise,
     3545          input varcur-vat-pc,
     3546          input varcur-cons-vat-pc,
     3547          input varcur-slt-pc
     3548          ) no-error.
     3549       if error-status:error then do:
     3550         message
     3551           vss-workfile vss-revision vss-description skip
     3552           "Ошибка при вызове процедуры clcprtsl_calc-ttable." skip
     3553           return-value skip
     3554           trim(error-status :get-message(1))
     3555           trim(error-status :get-message(2))
     3556           trim(error-status :get-message(3))
     3557           trim(error-status :get-message(4))
     3558           trim(error-status :get-message(5)) skip
     3559           view-as alert-box error.
     3560         undo, return error .
     3561       end.
     3562     end.
     3563   end.
     3564   end.
     3565   procedure clcprtsl_calc-ttable :
     3566   define input parameter paris-doc           as   logical                 no-undo.
     3567   define input parameter paris-cur           as   logical                 no-undo.
     3568   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     3569   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     3570   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     3571   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     3572   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     3573   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     3574   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     3575   define input parameter parr-b              as   character               no-undo.
     3576   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     3577   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     3578   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     3579   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     3580   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     3581   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     3582   define buffer bf_tt-allsum      for tt-allsum.
     3583   define buffer bf_tt-clcparts    for tt-clcparts.
     3584   define buffer bf_tt-allsum-line for tt-allsum-line.
     3585   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     3586   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     3587   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     3588   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     3589   define variable varexcise          like ub.price-list.excise     no-undo.
     3590   do on error undo, return error return-value :
     3591   for each bf_tt-allsum-line
     3592   on error undo, return error return-value
     3593    :
     3594     delete bf_tt-allsum-line.
     3595   end.
     3596   for each bf_tt-allsum
     3597   on error undo, return error return-value
     3598   :
     3599     delete bf_tt-allsum.
     3600   end.
     3601   for each bf_tt-clcparts
     3602   on error undo, return error return-value
     3603   :
     3604   if v-calcbypart then do:
     3605             assign
     3606             parcur-base =   bf_tt-clcparts.part-cur-base
     3607             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     3608             parcur-excise =   bf_tt-clcparts.part-cur-excise
     3609             .
     3610   end.
     3611      run clcprtsl_calc-parts in this-procedure (
     3612        input recid(bf_tt-clcparts),
     3613        input paris-doc,
     3614        input paris-cur,
     3615        input parroad-tax,
     3616        input parexcise,
     3617        input parvat-pc,
     3618        input parcons-vat-pc,
     3619        input parslt-pc,
     3620        input parbase-rate,
     3621        input parbase-scale,
     3622        input parr-b,
     3623        input parcur-base,
     3624        input parcur-road-tax,
     3625        input parcur-excise,
     3626        input parcur-vat-pc,
     3627        input parcurcons-vat-pc,
     3628        input parcurslt-pc
     3629        ) no-error.
     3630     if error-status:error then do:
     3631       message
     3632         vss-workfile vss-revision vss-description skip
     3633         vss-include-info14 skip
     3634         "Ошибка при обсчете партии" skip
     3635         "Документ партии " bf_tt-clcparts.out-code skip
     3636         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     3637         return-value skip
     3638         error-status:get-message(1) skip
     3639         error-status:get-message(2) skip
     3640         error-status:get-message(3) skip
     3641         view-as alert-box error .
     3642       undo, return error .
     3643     end.
     3644     for each bf_tt-allsum on error undo, return error return-value :
     3645       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     3646       if not available bf_tt-allsum-line then do:
     3647         create bf_tt-allsum-line.
     3648         assign
     3649           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     3650       end.
     3651       assign
     3652         bf_tt-allsum-line.fact-qnty              = bf_tt-allsum-line.fact-qnty            + bf_tt-allsum.fact-qnty
     3653         bf_tt-allsum-line.cli-qnty               = bf_tt-allsum-line.cli-qnty             + bf_tt-allsum.cli-qnty
     3654         bf_tt-allsum-line.sum-dsc-base-doc       = bf_tt-allsum-line.sum-dsc-base-doc     + bf_tt-allsum.sum-dsc-base-doc
     3655         bf_tt-allsum-line.sum-dsc-rubl-doc       = bf_tt-allsum-line.sum-dsc-rubl-doc     + bf_tt-allsum.sum-dsc-rubl-doc
     3656         bf_tt-allsum-line.dsc-base-doc           = bf_tt-allsum-line.dsc-base-doc         + bf_tt-allsum.dsc-base-doc
     3657         bf_tt-allsum-line.dsc-rubl-doc           = bf_tt-allsum-line.dsc-rubl-doc         + bf_tt-allsum.dsc-rubl-doc
     3658         bf_tt-allsum-line.vat-base-doc           = bf_tt-allsum-line.vat-base-doc         + bf_tt-allsum.vat-base-doc
     3659         bf_tt-allsum-line.vat-rubl-doc           = bf_tt-allsum-line.vat-rubl-doc         + bf_tt-allsum.vat-rubl-doc
     3660         bf_tt-allsum-line.vat-base-buyer-doc     = bf_tt-allsum-line.vat-base-buyer-doc   + bf_tt-allsum.vat-base-buyer-doc
     3661         bf_tt-allsum-line.vat-rubl-buyer-doc     = bf_tt-allsum-line.vat-rubl-buyer-doc   + bf_tt-allsum.vat-rubl-buyer-doc
     3662         bf_tt-allsum-line.slt-base-doc           = bf_tt-allsum-line.slt-base-doc         + bf_tt-allsum.slt-base-doc
     3663         bf_tt-allsum-line.slt-rubl-doc           = bf_tt-allsum-line.slt-rubl-doc         + bf_tt-allsum.slt-rubl-doc
     3664         bf_tt-allsum-line.road-tax-base-doc      = bf_tt-allsum-line.road-tax-base-doc    + bf_tt-allsum.road-tax-base-doc
     3665         bf_tt-allsum-line.road-tax-rubl-doc      = bf_tt-allsum-line.road-tax-rubl-doc    + bf_tt-allsum.road-tax-rubl-doc
     3666         bf_tt-allsum-line.excise-base-doc        = bf_tt-allsum-line.excise-base-doc      + bf_tt-allsum.excise-base-doc
     3667         bf_tt-allsum-line.excise-rubl-doc        = bf_tt-allsum-line.excise-rubl-doc      + bf_tt-allsum.excise-rubl-doc
     3668         bf_tt-allsum-line.sum-dsc-base-cur       = bf_tt-allsum-line.sum-dsc-base-cur     + bf_tt-allsum.sum-dsc-base-cur
     3669         bf_tt-allsum-line.sum-dsc-rubl-cur       = bf_tt-allsum-line.sum-dsc-rubl-cur     + bf_tt-allsum.sum-dsc-rubl-cur
     3670         bf_tt-allsum-line.dsc-base-cur           = bf_tt-allsum-line.dsc-base-cur         + bf_tt-allsum.dsc-base-cur
     3671         bf_tt-allsum-line.dsc-rubl-cur           = bf_tt-allsum-line.dsc-rubl-cur         + bf_tt-allsum.dsc-rubl-cur
     3672         bf_tt-allsum-line.vat-base-cur           = bf_tt-allsum-line.vat-base-cur         + bf_tt-allsum.vat-base-cur
     3673         bf_tt-allsum-line.vat-rubl-cur           = bf_tt-allsum-line.vat-rubl-cur         + bf_tt-allsum.vat-rubl-cur
     3674         bf_tt-allsum-line.vat-base-buyer-cur     = bf_tt-allsum-line.vat-base-buyer-cur   + bf_tt-allsum.vat-base-buyer-cur
     3675         bf_tt-allsum-line.vat-rubl-buyer-cur     = bf_tt-allsum-line.vat-rubl-buyer-cur   + bf_tt-allsum.vat-rubl-buyer-cur
     3676         bf_tt-allsum-line.slt-base-cur           = bf_tt-allsum-line.slt-base-cur         + bf_tt-allsum.slt-base-cur
     3677         bf_tt-allsum-line.slt-rubl-cur           = bf_tt-allsum-line.slt-rubl-cur         + bf_tt-allsum.slt-rubl-cur
     3678         bf_tt-allsum-line.road-tax-base-cur      = bf_tt-allsum-line.road-tax-base-cur    + bf_tt-allsum.road-tax-base-cur
     3679         bf_tt-allsum-line.road-tax-rubl-cur      = bf_tt-allsum-line.road-tax-rubl-cur    + bf_tt-allsum.road-tax-rubl-cur
     3680         bf_tt-allsum-line.excise-base-cur        = bf_tt-allsum-line.excise-base-cur      + bf_tt-allsum.excise-base-cur
     3681         bf_tt-allsum-line.excise-rubl-cur        = bf_tt-allsum-line.excise-rubl-cur      + bf_tt-allsum.excise-rubl-cur
     3682         bf_tt-allsum-line.sum-dsc-base-acc       = bf_tt-allsum-line.sum-dsc-base-acc     + bf_tt-allsum.sum-dsc-base-acc
     3683         bf_tt-allsum-line.sum-dsc-rubl-acc       = bf_tt-allsum-line.sum-dsc-rubl-acc     + bf_tt-allsum.sum-dsc-rubl-acc
     3684         bf_tt-allsum-line.sum-dsc-cli-acc        = bf_tt-allsum-line.sum-dsc-cli-acc      + bf_tt-allsum.sum-dsc-cli-acc
     3685         bf_tt-allsum-line.dsc-base-acc           = bf_tt-allsum-line.dsc-base-acc         + bf_tt-allsum.dsc-base-acc
     3686         bf_tt-allsum-line.dsc-rubl-acc           = bf_tt-allsum-line.dsc-rubl-acc         + bf_tt-allsum.dsc-rubl-acc
     3687         bf_tt-allsum-line.dsc-cli-acc            = bf_tt-allsum-line.dsc-cli-acc          + bf_tt-allsum.dsc-cli-acc
     3688         bf_tt-allsum-line.vat-base-acc           = bf_tt-allsum-line.vat-base-acc         + bf_tt-allsum.vat-base-acc
     3689         bf_tt-allsum-line.vat-rubl-acc           = bf_tt-allsum-line.vat-rubl-acc         + bf_tt-allsum.vat-rubl-acc
     3690         bf_tt-allsum-line.vat-cli-acc            = bf_tt-allsum-line.vat-cli-acc          + bf_tt-allsum.vat-cli-acc
     3691         bf_tt-allsum-line.slt-base-acc           = bf_tt-allsum-line.slt-base-acc         + bf_tt-allsum.slt-base-acc
     3692         bf_tt-allsum-line.slt-rubl-acc           = bf_tt-allsum-line.slt-rubl-acc         + bf_tt-allsum.slt-rubl-acc
     3693         bf_tt-allsum-line.slt-cli-acc            = bf_tt-allsum-line.slt-cli-acc          + bf_tt-allsum.slt-cli-acc
     3694         bf_tt-allsum-line.road-tax-base-acc      = bf_tt-allsum-line.road-tax-base-acc    + bf_tt-allsum.road-tax-base-acc
     3695         bf_tt-allsum-line.road-tax-rubl-acc      = bf_tt-allsum-line.road-tax-rubl-acc    + bf_tt-allsum.road-tax-rubl-acc
     3696         bf_tt-allsum-line.road-tax-cli-acc       = bf_tt-allsum-line.road-tax-cli-acc     + bf_tt-allsum.road-tax-cli-acc
     3697         bf_tt-allsum-line.excise-base-acc        = bf_tt-allsum-line.excise-base-acc      + bf_tt-allsum.excise-base-acc
     3698         bf_tt-allsum-line.excise-rubl-acc        = bf_tt-allsum-line.excise-rubl-acc      + bf_tt-allsum.excise-rubl-acc
     3699         bf_tt-allsum-line.excise-cli-acc         = bf_tt-allsum-line.excise-cli-acc       + bf_tt-allsum.excise-cli-acc
     3700         bf_tt-allsum-line.transport-base-acc     = bf_tt-allsum-line.transport-base-acc   + bf_tt-allsum.transport-base-acc
     3701         bf_tt-allsum-line.transport-rubl-acc     = bf_tt-allsum-line.transport-rubl-acc   + bf_tt-allsum.transport-rubl-acc
     3702         bf_tt-allsum-line.transport-cli-acc      = bf_tt-allsum-line.transport-cli-acc    + bf_tt-allsum.transport-cli-acc
     3703         bf_tt-allsum-line.other-base-acc         = bf_tt-allsum-line.other-base-acc       + bf_tt-allsum.other-base-acc
     3704         bf_tt-allsum-line.other-rubl-acc         = bf_tt-allsum-line.other-rubl-acc       + bf_tt-allsum.other-rubl-acc
     3705         bf_tt-allsum-line.other-cli-acc          = bf_tt-allsum-line.other-cli-acc        + bf_tt-allsum.other-cli-acc
     3706         .
     3707     end.
     3708   end.
     3709   end.
     3710   end procedure.
     3711   define temp-table temp-font no-undo
     3712     field fontnum  as integer
     3713     field fontname as character
     3714     field fontsize as character
     3715     field fonttype as character
     3716     field font-h   as integer
     3717     field font-w   as integer
     3718     field v-row    as integer
     3719     field v-col    as integer
     3720     field v-row-lans as integer
     3721     field v-col-lans as integer
     3722   index pi fontnum
     3723   .
     3724   procedure get-font-ini :
     3725     do
     3726     on error undo, return error return-value
     3727     :
     3728   define variable ii as integer   no-undo .
     3729   define variable v-font7 as character no-undo .
     3730   define variable v-font as character no-undo .
     3731   define variable loc-name as character no-undo .
     3732   define variable loc-size as character no-undo .
     3733   define variable loc-type as character no-undo .
     3734   define variable old_H as integer   no-undo .
     3735   define variable old_w as integer   no-undo .
     3736   define variable old-row  as integer   no-undo .
     3737   define variable old-col  as integer   no-undo .
     3738   define variable old-row-lans  as integer   no-undo .
     3739   define variable old-col-lans  as integer   no-undo .
     3740   define variable vv as integer   no-undo .
     3741   empty temp-table temp-font.
     3742     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     3743       case num-entries (v-font7) :
     3744         when 4 then do:
     3745             assign
     3746               loc-name = entry ( 1 , v-font7 )
     3747               loc-size = entry ( 2 , v-font7 )
     3748               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     3749             .
     3750         end.
     3751         when 3 then do:
     3752             assign
     3753               loc-name = entry ( 1 , v-font7 )
     3754               loc-size = entry ( 2 , v-font7 )
     3755               loc-type = entry ( 3 , v-font7 )
     3756             .
     3757         end.
     3758         when 2 then  do:
     3759             assign
     3760               loc-name = entry ( 1 , v-font7 )
     3761               loc-size = entry ( 2 , v-font7 )
     3762               loc-type = ""
     3763             .
     3764         end.
     3765         when 1 then do:
     3766             assign
     3767               loc-name = trim(entry ( 1 , v-font7 ))
     3768               loc-size = ""
     3769               loc-type = ""
     3770             .
     3771         end.
     3772       end case.
     3773     create temp-font.
     3774     assign
     3775       temp-font.fontnum  = 7
     3776       temp-font.fontname = trim(loc-name)
     3777       temp-font.fontsize = trim(loc-size)
     3778       temp-font.fonttype = trim(loc-type)
     3779       temp-font.v-row    = 62
     3780       temp-font.v-col    = 136
     3781       temp-font.v-row-lans = 43
     3782       temp-font.v-col-lans = 198
     3783     .
     3784     repeat ii = 16 to 100 :
     3785       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     3786       if v-font = "" or v-font = ? then leave.
     3787       case num-entries (v-font) :
     3788         when 4 then do:
     3789             assign
     3790               loc-name = entry ( 1 , v-font )
     3791               loc-size = entry ( 2 , v-font )
     3792               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     3793             .
     3794         end.
     3795         when 3 then do:
     3796             assign
     3797               loc-name = entry ( 1 , v-font )
     3798               loc-size = entry ( 2 , v-font )
     3799               loc-type = entry ( 3 , v-font )
     3800             .
     3801         end.
     3802         when 2 then do:
     3803             assign
     3804               loc-name = entry ( 1 , v-font )
     3805               loc-size = entry ( 2 , v-font )
     3806               loc-type = ""
     3807             .
     3808         end.
     3809         when 1 then do:
     3810             assign
     3811               loc-name = trim(entry ( 1 , v-font ))
     3812               loc-size = ""
     3813               loc-type = ""
     3814             .
     3815         end.
     3816       end case.
     3817     create temp-font.
     3818     assign
     3819       temp-font.fontnum  = ii
     3820       temp-font.fontname = trim(loc-name)
     3821       temp-font.fontsize = trim(loc-size)
     3822       temp-font.fonttype = trim(loc-type)
     3823     .
     3824     end.
     3825       for each temp-font :
     3826          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     3827          if  vv = ? then vv =  0 .
     3828           run rep/exfont.p (
     3829             input   temp-font.fontname ,
     3830             input   vv ,
     3831             input   temp-font.fonttype ,
     3832             output  temp-font.font-h   ,
     3833             output  temp-font.font-w   )
     3834           .
     3835       end.
     3836   find first temp-font where  temp-font.fontnum  = 7  .
     3837   old_H = temp-font.font-H .
     3838   old_w = temp-font.font-W .
     3839   old-row = temp-font.v-row .
     3840   old-col = temp-font.v-col .
     3841   old-row-lans = temp-font.v-row-lans .
     3842   old-col-lans = temp-font.v-col-lans .
     3843       for each temp-font where
     3844                temp-font.fontnum  <> 7 :
     3845           assign
     3846               temp-font.v-row    = old_H * old-row / temp-font.font-h
     3847               temp-font.v-col    = old_W * old-col / temp-font.font-W
     3848               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     3849               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     3850           .
     3851       end.
     3852     end.
     3853   end procedure.
     3854   PROCEDURE How-name :
     3855   define input  parameter h as integer no-undo .
     3856   define input  parameter w as integer no-undo .
     3857   define output parameter n as character  no-undo .
     3858   define variable A4port-H as integer   no-undo init 63.
     3859   define variable A4port-W as integer   no-undo init 136.
     3860   define variable A4lans-H as integer   no-undo init 43.
     3861   define variable A4lans-W as integer   no-undo init 198.
     3862   define variable Strim-W  as integer   no-undo init 278.
     3863   run define-a4-size (
     3864        input ReportFontNum
     3865       ,output A4port-H
     3866       ,output A4port-W
     3867       ,output A4lans-H
     3868       ,output A4lans-W ).
     3869   If w >= 1 and w <= A4port-W Then DO:
     3870     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     3871     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     3872     If h > A4port-H              Then n = "to-file":U.
     3873   End.
     3874   If w > A4port-W and w <= A4lans-W Then DO:
     3875     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     3876     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     3877     If h > A4port-H              Then n = "to-file":U.
     3878   End.
     3879   If w > A4lans-W and w <= Strim-W Then DO:
     3880     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     3881     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     3882     If h > A4port-H              Then n = "to-file":U.
     3883   End.
     3884   If w > Strim-W Then DO:
     3885      n = "to-file":U.
     3886   End.
     3887   END PROCEDURE.
     3888   PROCEDURE define-a4-size :
     3889   define input  parameter p-ReportFontNum as integer   no-undo .
     3890   define output parameter A4port-H as integer   no-undo .
     3891   define output parameter A4port-W as integer   no-undo .
     3892   define output parameter A4lans-H as integer   no-undo .
     3893   define output parameter A4lans-W as integer   no-undo .
     3894   if not can-find (first temp-font ) then do:
     3895      run get-font-ini .
     3896   end.
     3897   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     3898   if available temp-font then do:
     3899   assign
     3900     A4port-H = temp-font.v-row
     3901     A4port-W = temp-font.v-col
     3902     A4lans-H = temp-font.v-row-lans
     3903     A4lans-W = temp-font.v-col-lans
     3904   .
     3905   end.
     3906   else do:
     3907   assign
     3908     A4port-H = 63
     3909     A4port-W = 136
     3910     A4lans-H = 43
     3911     A4lans-W = 198
     3912   .
     3913   end.
     3914   END PROCEDURE.
     3915   define variable vss-include-info28 as character format "X(65)" no-undo
     3916   initial "@(#)$Workfile$ $Revision$".
     3917   define variable v-fmtcli-name          as character    no-undo.
     3918   define variable v-fmtcli-engl-name     as character    no-undo.
     3919   define variable v-fmtcli-addres        as character    no-undo.
     3920   define variable v-fmtcli-post-addres   as character    no-undo.
     3921   define variable v-fmtcli-full-addres   as character    no-undo.
     3922   define variable v-fmtcli-phone         as character    no-undo.
     3923   define variable v-fmtcli-inn           as character    no-undo.
     3924   define variable v-fmtcli-kpp           as character    no-undo.
     3925   define variable v-fmtcli-okpo          as character    no-undo.
     3926   define variable v-fmtcli-country       as character    no-undo.
     3927   define variable v-fmtcli-city          as character    no-undo.
     3928   define variable v-fmtcli-index         as character    no-undo.
     3929   define variable v-fmtcli-schet-exists  as logical      no-undo.
     3930   define variable v-fmtcli-bank-exists   as logical      no-undo.
     3931   define variable v-fmtcli-bank-r-schet  as character    no-undo.
     3932   define variable v-fmtcli-bank-c-schet  as character    no-undo.
     3933   define variable v-fmtcli-bank-bik      as character    no-undo.
     3934   define variable v-fmtcli-bank-name     as character    no-undo.
     3935   define variable v-fmtcli-bank-addres   as character    no-undo.
     3936   define variable v-fmtcli-bank-city     as character    no-undo.
     3937   procedure fmtcli-get-bank :
     3938   define input parameter p-host-code      as integer          no-undo.
     3939   define input parameter p-obj-type       as character        no-undo.
     3940   define input parameter p-obj-code       as integer          no-undo.
     3941   define input parameter p-curr-code      as integer          no-undo.
     3942       define buffer buf_fin-schet     for ub.fin-schet.
     3943       define buffer buf_fin-bank      for ub.fin-bank.
     3944   do
     3945   for buf_fin-schet
     3946     , buf_fin-bank
     3947   on error undo, return error
     3948   :
     3949       assign
     3950           v-fmtcli-schet-exists       = no
     3951           v-fmtcli-bank-exists        = no
     3952           v-fmtcli-bank-r-schet       = "":U
     3953           v-fmtcli-bank-c-schet       = "":U
     3954           v-fmtcli-bank-bik           = "":U
     3955           v-fmtcli-bank-name          = "":U
     3956           v-fmtcli-bank-addres        = "":U
     3957           v-fmtcli-bank-city          = "":U
     3958       .
     3959       search-for-schet:
     3960       for each buf_fin-schet no-lock
     3961          where buf_fin-schet.host-code = p-host-code
     3962            and buf_fin-schet.cli-type  = p-obj-type
     3963            and buf_fin-schet.cli-code  = p-obj-code
     3964            and buf_fin-schet.curr-code = p-curr-code
     3965       on error undo, return error
     3966       :
     3967           if buf_fin-schet.status_   = 'удал':U
     3968           then do:
     3969           end.
     3970           else do:
     3971               assign
     3972                   v-fmtcli-schet-exists   = yes
     3973                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
     3974                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
     3975               .
     3976               find first buf_fin-bank no-lock
     3977                    where buf_fin-bank.host-code = p-host-code
     3978                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
     3979               no-error.
     3980               if available buf_fin-bank
     3981               then do:
     3982                   assign
     3983                       v-fmtcli-bank-exists      = yes
     3984                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
     3985                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
     3986                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
     3987                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
     3988                   .
     3989               end.
     3990               else do:
     3991                   assign
     3992                       v-fmtcli-bank-exists    = no
     3993                       v-fmtcli-bank-bik       = "":U
     3994                       v-fmtcli-bank-name      = "":U
     3995                       v-fmtcli-bank-addres    = "":U
     3996                       v-fmtcli-bank-city      = "":U
     3997                   .
     3998               end.
     3999               leave search-for-schet.
     4000           end.
     4001       end.
     4002   end.
     4003   end procedure.
     4004   procedure fmtcli-get-client :
     4005   define input parameter p-obj-type       as character    no-undo.
     4006   define input parameter p-obj-code       as integer      no-undo.
     4007       define variable v-temp-fmtcli-address      as character     no-undo.
     4008       define variable v-num-country-city    as integer      no-undo.
     4009       define buffer buf_clients   for ub.clients.
     4010       define buffer buf_firm      for ub.firm.
     4011       define buffer buf_store     for ub.store.
     4012       define buffer buf_shop      for ub.shop.
     4013       define buffer buf_person    for ub.person.
     4014   do
     4015   for buf_clients
     4016     , buf_firm
     4017     , buf_store
     4018     , buf_shop
     4019     , buf_person
     4020   on error undo, return error
     4021   :
     4022       assign
     4023           v-fmtcli-name           = "":U
     4024           v-fmtcli-addres         = "":U
     4025           v-fmtcli-post-addres    = "":U
     4026           v-fmtcli-full-addres    = "":U
     4027           v-fmtcli-phone          = "":U
     4028           v-fmtcli-inn            = "":U
     4029           v-fmtcli-kpp            = "":U
     4030           v-fmtcli-okpo           = "":U
     4031           v-fmtcli-city           = "":U
     4032           v-fmtcli-index          = "":U
     4033           v-fmtcli-country        = "":U
     4034       .
     4035       find first buf_clients no-lock
     4036            where buf_clients.obj-type = p-obj-type
     4037              and buf_clients.obj-code = p-obj-code
     4038       .
     4039       assign
     4040           v-fmtcli-name = buf_clients.obj-name
     4041       .
     4042       case buf_clients.obj-type:
     4043          when 'орг':U
     4044          then do:
     4045               find first buf_firm no-lock
     4046                    where buf_firm.firm-code = buf_clients.obj-code
     4047                    no-error
     4048               .
     4049               if available buf_firm
     4050               then do:
     4051                   assign
     4052                       v-num-country-city = num-entries( buf_firm.city )
     4053                       v-fmtcli-engl-name = buf_firm.engl-name
     4054                   .
     4055                   if v-num-country-city > 0
     4056                   then do:
     4057                       assign
     4058                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
     4059                       .
     4060                   end.
     4061                   if v-num-country-city > 1
     4062                   then do:
     4063                       assign
     4064                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
     4065                       .
     4066                   end.
     4067                   run fmtcli-concatenate-strings in this-procedure (
     4068                         input v-fmtcli-full-addres
     4069                       , input v-fmtcli-country
     4070                       , input ", ":U
     4071                       , input 50
     4072                       , output v-fmtcli-full-addres
     4073                   ).
     4074                   run fmtcli-concatenate-strings in this-procedure (
     4075                         input v-fmtcli-full-addres
     4076                       , input v-fmtcli-city
     4077                       , input ", ":U
     4078                       , input 50
     4079                       , output v-fmtcli-full-addres
     4080                   ).
     4081                   run fmtcli-concatenate-strings in this-procedure (
     4082                         input v-fmtcli-full-addres
     4083                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
     4084                       , input ", ":U
     4085                       , input 50
     4086                       , output v-fmtcli-full-addres
     4087                   ).
     4088                   run fmtcli-concatenate-strings in this-procedure (
     4089                         input v-fmtcli-post-addres
     4090                       , input v-fmtcli-country
     4091                       , input ", ":U
     4092                       , input 50
     4093                       , output v-fmtcli-post-addres
     4094                   ).
     4095                   run fmtcli-concatenate-strings in this-procedure (
     4096                         input v-fmtcli-post-addres
     4097                       , input v-fmtcli-city
     4098                       , input ", ":U
     4099                       , input 50
     4100                       , output v-fmtcli-post-addres
     4101                   ).
     4102                   run fmtcli-concatenate-strings in this-procedure (
     4103                         input v-fmtcli-post-addres
     4104                       , input string( buf_firm.ind )
     4105                       , input ", ":U
     4106                       , input 50
     4107                       , output v-fmtcli-post-addres
     4108                   ).
     4109                   run fmtcli-concatenate-strings in this-procedure (
     4110                         input substring( buf_firm.addres1, 1, 50 )
     4111                       , input buf_firm.addres2
     4112                       , input " ":U
     4113                       , input 50
     4114                       , output v-temp-fmtcli-address
     4115                   ).
     4116                   run fmtcli-concatenate-strings in this-procedure (
     4117                         input v-temp-fmtcli-address
     4118                       , input substring( buf_firm.addres1, 51, 50 )
     4119                       , input " ":U
     4120                       , input 50
     4121                       , output v-temp-fmtcli-address
     4122                   ).
     4123                   run fmtcli-concatenate-strings in this-procedure (
     4124                         input v-temp-fmtcli-address
     4125                       , input substring( buf_firm.addres1, 101, 50 )
     4126                       , input " ":U
     4127                       , input 50
     4128                       , output v-temp-fmtcli-address
     4129                   ).
     4130                   assign
     4131                       v-fmtcli-addres = v-temp-fmtcli-address
     4132                   .
     4133                   if buf_firm.addres1 <> ?
     4134                   then do:
     4135                       run fmtcli-concatenate-strings in this-procedure (
     4136                             input v-fmtcli-full-addres
     4137                           , input v-fmtcli-addres
     4138                           , input ", ":U
     4139                           , input 0
     4140                           , output v-fmtcli-full-addres
     4141                       ).
     4142                   end.
     4143                   run fmtcli-concatenate-strings in this-procedure (
     4144                         input substring( buf_firm.post-addr1, 1, 50 )
     4145                       , input buf_firm.post-addr2
     4146                       , input " ":U
     4147                       , input 50
     4148                       , output v-fmtcli-post-addres
     4149                   ).
     4150                   run fmtcli-concatenate-strings in this-procedure (
     4151                         input v-fmtcli-post-addres
     4152                       , input substring( buf_firm.post-addr1, 51, 50 )
     4153                       , input " ":U
     4154                       , input 50
     4155                       , output v-fmtcli-post-addres
     4156                   ).
     4157                   run fmtcli-concatenate-strings in this-procedure (
     4158                         input v-fmtcli-post-addres
     4159                       , input substring( buf_firm.post-addr1, 101, 50 )
     4160                       , input " ":U
     4161                       , input 50
     4162                       , output v-fmtcli-post-addres
     4163                   ).
     4164                   assign
     4165                       v-fmtcli-phone         = buf_firm.phone
     4166                       v-fmtcli-inn           = buf_firm.inn
     4167                       v-fmtcli-kpp           = buf_firm.kpp
     4168                       v-fmtcli-okpo          = buf_firm.okpo
     4169                       v-fmtcli-index         = string( buf_firm.ind )
     4170                   .
     4171               end.
     4172          end.
     4173          when 'маг':U
     4174          then do:
     4175               find first buf_shop no-lock
     4176                    where buf_shop.obj-code = buf_clients.obj-code
     4177               .
     4178               if available buf_shop
     4179               then do:
     4180                   run fmtcli-concatenate-strings in this-procedure (
     4181                         input buf_shop.addres1
     4182                       , input buf_shop.addres2
     4183                       , input " ":U
     4184                       , input 50
     4185                       , output v-fmtcli-addres
     4186                   ).
     4187                   assign
     4188                       v-fmtcli-full-addres = v-fmtcli-addres
     4189                       v-fmtcli-post-addres = v-fmtcli-addres
     4190                       v-fmtcli-phone       = buf_shop.phone
     4191                       v-fmtcli-inn         = "":U
     4192                       v-fmtcli-kpp         = "":U
     4193                       v-fmtcli-okpo        = "":U
     4194                       v-fmtcli-city        = "":U
     4195                       v-fmtcli-index       = "":U
     4196                   .
     4197               end.
     4198          end.
     4199          when 'скл':U
     4200          then do:
     4201               find first buf_store no-lock
     4202                    where buf_store.obj-code = buf_clients.obj-code
     4203               .
     4204               if available buf_store
     4205               then do:
     4206                   run fmtcli-concatenate-strings in this-procedure (
     4207                         input buf_store.addres1
     4208                       , input buf_store.addres2
     4209                       , input " ":U
     4210                       , input 50
     4211                       , output v-fmtcli-addres
     4212                   ).
     4213                   assign
     4214                       v-fmtcli-full-addres = v-fmtcli-addres
     4215                       v-fmtcli-phone       = buf_store.phone
     4216                       v-fmtcli-inn         = "":U
     4217                       v-fmtcli-kpp         = "":U
     4218                       v-fmtcli-okpo        = "":U
     4219                       v-fmtcli-city        = "":U
     4220                       v-fmtcli-index       = "":U
     4221                   .
     4222               end.
     4223          end.
     4224          when 'чел':U
     4225          then do:
     4226               find first buf_person no-lock
     4227                    where buf_person.psn-code = buf_clients.obj-code
     4228               .
     4229               if available buf_person
     4230               then do:
     4231                   run fmtcli-concatenate-strings in this-procedure (
     4232                         input ( if buf_person.ind = 0 or buf_person.ind = ?
     4233                                 then "":U
     4234                                 else string( buf_person.ind, "999999")
     4235                                 )
     4236                       , input buf_person.city
     4237                       , input ", ":U
     4238                       , input 0
     4239                       , output v-fmtcli-full-addres
     4240                   ).
     4241                   assign
     4242                       v-fmtcli-addres = buf_person.address
     4243                   .
     4244                   run fmtcli-concatenate-strings in this-procedure (
     4245                         input v-fmtcli-full-addres
     4246                       , input v-fmtcli-addres
     4247                       , input ", ":U
     4248                       , input 0
     4249                       , output v-fmtcli-full-addres
     4250                   ).
     4251                   assign
     4252                       v-fmtcli-phone     = buf_person.phone1
     4253                       v-fmtcli-inn       = buf_person.inn
     4254                       v-fmtcli-kpp       = buf_person.kpp
     4255                       v-fmtcli-okpo      = buf_person.okpo
     4256                       v-fmtcli-city      = buf_person.city
     4257                       v-fmtcli-index     = string( buf_person.ind )
     4258                   .
     4259               end.
     4260          end.
     4261       end case.
     4262   end.
     4263   end procedure.
     4264   procedure fmtcli-concatenate-strings :
     4265   define input parameter p-string-1       as character        no-undo.
     4266   define input parameter p-string-2       as character        no-undo.
     4267   define input parameter p-delimiter      as character        no-undo.
     4268   define input parameter p-length         as integer          no-undo.
     4269   define output parameter p-out-string    as character        no-undo.
     4270   do
     4271   on error undo, return error
     4272   :
     4273       assign
     4274           p-out-string = ( if p-string-1 = ?
     4275                            then "":U
     4276                            else trim( p-string-1 ) )
     4277       .
     4278       assign
     4279           p-out-string = p-out-string
     4280                        + ( if p-out-string = "":U
     4281                            or length( p-out-string ) = p-length
     4282                            or p-string-2 = ?
     4283                            or trim( p-string-2 ) = "":U
     4284                            then "":U
     4285                            else p-delimiter )
     4286                        + ( if p-string-2 = ?
     4287                            or trim( p-string-2 ) = "":U
     4288                            then "":U
     4289                            else trim( p-string-2 ) )
     4290       .
     4291   end.
     4292   end procedure.
     4293   def var vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4294   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     4295   procedure paramls-clear :
     4296     define buffer buf_temp-param for temp-param .
     4297     do
     4298     on error undo, return error return-value
     4299     :
     4300       for each buf_temp-param
     4301       on error undo, return error
     4302       :
     4303         delete buf_temp-param .
     4304       end.
     4305     end.
     4306   end procedure.
     4307   procedure paramls-write :
     4308     define input  parameter p-code     as character no-undo .
     4309     define input  parameter p-sub-code as character no-undo .
     4310     define input  parameter p-value    as character no-undo .
     4311     define buffer buf_temp-param for temp-param .
     4312     do
     4313     on error undo, return error return-value
     4314     :
     4315       find first buf_temp-param
     4316         where buf_temp-param.param-code     = p-code
     4317           and buf_temp-param.param-sub-code = p-sub-code
     4318         no-error .
     4319       if not available buf_temp-param then do:
     4320         create buf_temp-param .
     4321         assign
     4322           buf_temp-param.param-code     = p-code
     4323           buf_temp-param.param-sub-code = p-sub-code
     4324         .
     4325       end.
     4326       assign
     4327         buf_temp-param.param-value = p-value
     4328       .
     4329     end.
     4330   end procedure.
     4331   procedure paramls-read :
     4332     define input  parameter p-code          as character no-undo .
     4333     define input  parameter p-sub-code      as character no-undo .
     4334     define input  parameter p-default-value as character no-undo .
     4335     define output parameter p-value         as character no-undo .
     4336     define buffer buf_temp-param for temp-param .
     4337     do
     4338     on error undo, return error return-value
     4339     :
     4340       find first buf_temp-param
     4341         where buf_temp-param.param-code     = p-code
     4342           and buf_temp-param.param-sub-code = p-sub-code
     4343         no-error .
     4344       if available buf_temp-param then do:
     4345         assign
     4346           p-value = buf_temp-param.param-value
     4347         .
     4348       end.
     4349       else do:
     4350         assign
     4351           p-value = p-default-value
     4352         .
     4353       end.
     4354     end.
     4355   end procedure.
     4356   procedure paramls-append :
     4357     define input  parameter p-code     as character no-undo .
     4358     define input  parameter p-sub-code as character no-undo .
     4359     define input  parameter p-value    as character no-undo .
     4360     define buffer buf_temp-param for temp-param .
     4361     do
     4362     on error undo, return error return-value
     4363     :
     4364       find first buf_temp-param
     4365            where buf_temp-param.param-code     = p-code
     4366              and buf_temp-param.param-sub-code = p-sub-code
     4367         no-error .
     4368       if not available buf_temp-param then do:
     4369         create buf_temp-param .
     4370         assign
     4371           buf_temp-param.param-code     = p-code
     4372           buf_temp-param.param-sub-code = p-sub-code
     4373           buf_temp-param.param-value    = p-value
     4374         .
     4375       end.
     4376       else do:
     4377           assign
     4378               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     4379           .
     4380       end.
     4381     end.
     4382   end procedure.
     4383   define variable g#report-num  as integer    no-undo .
     4384   define variable vss-include-info30 as character format "X(65)" no-undo
     4385   initial "@(#)$Workfile$ $Revision$".
     4386   define stream excel-line.
     4387   define stream excel-cell.
     4388   define temp-table temp_cell-data no-undo
     4389       field data-key as character
     4390       field data-value as character
     4391       index pi is primary unique data-key
     4392   .
     4393   define temp-table temp_sheet1_line-data no-undo
     4394       field sheet-name    as character
     4395       field xl-line-id    as integer
     4396       field alc-type-num  as character
     4397       field alc-type-name as character
     4398       field alc-type-code as character
     4399       field ost-begin     as character
     4400       field purchase      as character
     4401       field sell          as character
     4402       field ret           as character
     4403       field other         as character
     4404       field ras-total     as character
     4405       field ost-end       as character
     4406   index pi is primary unique
     4407           xl-line-id
     4408   .
     4409   define variable v-alc04xl-sheet1-cur-data-row  as integer      no-undo.
     4410   define variable v-alc04xl-cell-file-name       as character    no-undo.
     4411   define variable v-alc04xl-data-file-name       as character    no-undo.
     4412   procedure alc04xl-init :
     4413   do
     4414   on error undo, return error
     4415   :
     4416       assign
     4417           v-alc04xl-sheet1-cur-data-row = 0
     4418       .
     4419       run gbl/_tmpfile.p (
     4420             input "xd"
     4421           , input ".txt"
     4422           , output v-alc04xl-data-file-name
     4423       ).
     4424       output stream excel-line to value( v-alc04xl-data-file-name ).
     4425       run gbl/_tmpfile.p (
     4426             input "xc"
     4427           , input ".txt"
     4428           , output v-alc04xl-cell-file-name
     4429       ).
     4430       output stream excel-cell to value( v-alc04xl-cell-file-name ).
     4431       run alc04xl-write-cell-data in this-procedure (
     4432             input "sheetList":U
     4433           , input "Декларация":U
     4434       ).
     4435       if printrubl
     4436       then do:
     4437           run alc04xl-write-cell-data in this-procedure (
     4438                 input "Декларация_valutCode":U
     4439               , input "0":U
     4440           ).
     4441       end.
     4442       else do:
     4443           run alc04xl-write-cell-data in this-procedure (
     4444                 input "Декларация_valutCode":U
     4445               , input "1":U
     4446           ).
     4447       end.
     4448       run alc04xl-write-cell-data in this-procedure (
     4449             input "Декларация_columnList":U
     4450           , input "alctypenum,alctypename,alctypecode,ostbegin,purchase,sell,ret,other,rastotal,ostend":U
     4451       ).
     4452       run alc04xl-write-cell-data in this-procedure (
     4453             input "Декларация_columnType":U
     4454           , input "S,S,S,S,S,S,S,S,S,S":U
     4455       ).
     4456       run alc04xl-write-cell-data in this-procedure (
     4457             input "Декларация_subtotalList":U
     4458           , input "":U
     4459       ).
     4460       run alc04xl-write-cell-data in this-procedure (
     4461             input "Декларация_subtotalType":U
     4462           , input "":U
     4463       ).
     4464   end.
     4465   end procedure.
     4466   procedure alc04xl-sheet1-write-line-data :
     4467   define input parameter p-alc-type-num  as character no-undo .
     4468   define input parameter p-alc-type-name as character no-undo .
     4469   define input parameter p-alc-type-code as character no-undo .
     4470   define input parameter p-ost-begin     as character no-undo .
     4471   define input parameter p-purchase      as character no-undo .
     4472   define input parameter p-sell          as character no-undo .
     4473   define input parameter p-ret           as character no-undo .
     4474   define input parameter p-other         as character no-undo .
     4475   define input parameter p-ras-total     as character no-undo .
     4476   define input parameter p-ost-end       as character no-undo .
     4477   define buffer buf_temp_sheet1_line-data  for temp_sheet1_line-data.
     4478   do
     4479   for buf_temp_sheet1_line-data
     4480   on error undo, return error
     4481   :
     4482       for each buf_temp_sheet1_line-data
     4483       :
     4484           delete buf_temp_sheet1_line-data.
     4485       end.
     4486       create buf_temp_sheet1_line-data.
     4487       assign
     4488           v-alc04xl-sheet1-cur-data-row           = v-alc04xl-sheet1-cur-data-row + 1
     4489           buf_temp_sheet1_line-data.sheet-name    = "Декларация":U
     4490           buf_temp_sheet1_line-data.xl-line-id    = v-alc04xl-sheet1-cur-data-row
     4491           buf_temp_sheet1_line-data.alc-type-num  = p-alc-type-num
     4492           buf_temp_sheet1_line-data.alc-type-name = p-alc-type-name
     4493           buf_temp_sheet1_line-data.alc-type-code = p-alc-type-code
     4494           buf_temp_sheet1_line-data.ost-begin     = p-ost-begin
     4495           buf_temp_sheet1_line-data.purchase      = p-purchase
     4496           buf_temp_sheet1_line-data.sell          = p-sell
     4497           buf_temp_sheet1_line-data.ret           = p-ret
     4498           buf_temp_sheet1_line-data.other         = p-other
     4499           buf_temp_sheet1_line-data.ras-total     = p-ras-total
     4500           buf_temp_sheet1_line-data.ost-end       = p-ost-end
     4501       .
     4502       put stream excel-line unformatted
     4503                           buf_temp_sheet1_line-data.sheet-name
     4504           CHR(9)   "DTA":U
     4505           CHR(9)   buf_temp_sheet1_line-data.alc-type-num
     4506           CHR(9)   buf_temp_sheet1_line-data.alc-type-name
     4507           CHR(9)   buf_temp_sheet1_line-data.alc-type-code
     4508           CHR(9)   buf_temp_sheet1_line-data.ost-begin
     4509           CHR(9)   buf_temp_sheet1_line-data.purchase
     4510           CHR(9)   buf_temp_sheet1_line-data.sell
     4511           CHR(9)   buf_temp_sheet1_line-data.ret
     4512           CHR(9)   buf_temp_sheet1_line-data.other
     4513           CHR(9)   buf_temp_sheet1_line-data.ras-total
     4514           CHR(9)   buf_temp_sheet1_line-data.ost-end
     4515           chr(10)
     4516       .
     4517       .
     4518   end.
     4519   end procedure.
     4520   procedure alc04xl-sheet1-write-line-format :
     4521   define input parameter p-fmt-label       as character  no-undo.
     4522       define buffer buf_temp_sheet1_line-data        for temp_sheet1_line-data.
     4523   do
     4524   for buf_temp_sheet1_line-data
     4525   on error undo, return error
     4526   :
     4527       put stream excel-line unformatted
     4528                           "Декларация":U
     4529           CHR(9)   "FMT":U
     4530           CHR(9)   p-fmt-label
     4531           chr(10)
     4532       .
     4533   end.
     4534   end procedure.
     4535   procedure alc04xl-write-cell-data :
     4536   define input parameter p-data-key   as character        no-undo.
     4537   define input parameter p-data-value as character        no-undo.
     4538       define buffer buf_temp_cell-data     for temp_cell-data.
     4539   do
     4540   for buf_temp_cell-data
     4541   on error undo, return error
     4542   :
     4543       find first buf_temp_cell-data
     4544            where buf_temp_cell-data.data-key = p-data-key
     4545       no-error.
     4546       if not available buf_temp_cell-data
     4547       then do:
     4548           create buf_temp_cell-data.
     4549           assign
     4550               buf_temp_cell-data.data-key = p-data-key
     4551           .
     4552       end.
     4553       assign
     4554           buf_temp_cell-data.data-value = p-data-value
     4555       .
     4556       put stream excel-cell unformatted
     4557                           buf_temp_cell-data.data-key
     4558           CHR(9)   buf_temp_cell-data.data-value
     4559           chr(10)
     4560       .
     4561   end.
     4562   end procedure.
     4563   procedure alc04xl-run-excel :
     4564   define input parameter p-header-filename    as character        no-undo.
     4565   define input parameter p-data-filename      as character        no-undo.
     4566       define variable v-Template-file-name    as character    no-undo.
     4567       define variable v-vb-file-name          as character    no-undo.
     4568       define buffer buf_temp-param for temp-param .
     4569   do
     4570   for buf_temp-param
     4571   on error undo, return error
     4572   :
     4573       create buf_temp-param.
     4574       assign
     4575           v-Template-file-name    = search( "exe/alcdcl04.xlt" )
     4576           v-vb-file-name          = search( "exe/t_form.bas")
     4577       .
     4578       if v-Template-file-name = ?
     4579       or v-Template-file-name = "":U
     4580       then do:
     4581           message
     4582               "Ошибка имени файла шаблона."
     4583           view-as alert-box error.
     4584       end.
     4585       if v-vb-file-name = ?
     4586       or v-vb-file-name = "":U
     4587       then do:
     4588           message
     4589               "Ошибка имени файла кода обработки."
     4590           view-as alert-box error.
     4591       end.
     4592       run paramls-write in this-procedure (
     4593             input "template":U
     4594           , input "template-file-name":U
     4595           , input v-Template-file-name
     4596       ).
     4597       run paramls-write in this-procedure (
     4598             input "template":U
     4599           , input "vb-file-name":U
     4600           , input v-vb-file-name
     4601       ).
     4602       run paramls-write in this-procedure (
     4603             input "data":U
     4604           , input "data-header-filename":U
     4605           , input p-header-filename
     4606       ).
     4607       run paramls-write in this-procedure (
     4608             input "data":U
     4609           , input "data-filename":U
     4610           , input p-data-filename
     4611       ).
     4612       run gbl/macroxlt.p (
     4613           input-output table buf_temp-param
     4614       ) no-error.
     4615       if error-status :error
     4616       then do:
     4617           message
     4618                    vss-workfile vss-revision vss-description
     4619               skip(1)
     4620               skip "Ошибка создания файла Excel."
     4621               skip return-value
     4622               skip trim(error-status :get-message(1))
     4623                    trim(error-status :get-message(2))
     4624                    trim(error-status :get-message(3))
     4625           view-as alert-box error.
     4626           undo, return error .
     4627       end.
     4628   end.
     4629   end procedure.
     4630   procedure alc04xl-close :
     4631   do
     4632   on error undo, return error
     4633   :
     4634       output stream excel-line close.
     4635       output stream excel-cell close.
     4636       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     4637           export "exe/alcdcl04.xlt":U.
     4638           export "exe/t_form.bas":U.
     4639           export v-alc04xl-cell-file-name.
     4640           export v-alc04xl-data-file-name.
     4641       output close.
     4642   end.
     4643   end procedure.
