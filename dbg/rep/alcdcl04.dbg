     4759     ) no-error .
     4760   for each thbjattr_thbj-attr :
     4761       if thbjattr_thbj-attr.prop-code = 'ardecldt' then v-par-val =  string(thbjattr_thbj-attr.property-value-date,"99/99/9999") .
     4762   end.
     4763     find first obj-list no-lock .
     4764     if not available obj-list then do:
