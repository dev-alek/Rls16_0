      569   define variable var-report-r-b as character no-undo .
      570   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      571   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      572     (output var-report-r-b
      573     )  .
      574   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      575   define variable v-waitfram-action01         as character   no-undo .
      576   define variable v-waitfram-action02         as character   no-undo .
      577   define variable v-waitfram-action03         as character   no-undo .
      578   define variable mWaitFramTextBeg            as character   no-undo.
      579   define variable mWaitFramTextEnd            as character   no-undo.
      580   define variable mWaitFramView               as logical     no-undo.
      581   define variable mWaitProcEvent              as logical     no-undo init yes.
      582   define variable mWaitFramInterval           as integer     no-undo init 1 .
      583   define variable mWaitFramStop               as logical     no-undo.
      584   define variable mWaitFramStopUser           as logical     no-undo.
      585   define variable mWaitFramStopTimeOut        as logical     no-undo.
      586   define variable mWaitFramStartProc          as datetime-tz no-undo.
      587   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      588   define button B-WaitFramStop auto-end-key
      589        label "Стоп"
      590        size 10 by 1 tooltip "Остоновить процесс".
      591   define button B-viewProcInfo
      592        label "Информация"
      593        size 15 by 1 tooltip "Информация о процесс".
      594   define frame waitfram
      595     v-waitfram-action01 format "x(72)" no-label skip
      596     v-waitfram-action02 format "x(72)" no-label skip
      597     v-waitfram-action03 format "x(72)" no-label skip
      598     B-viewProcInfo
      599     B-WaitFramStop at row 4 col 30
      600     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      601     .
      602   define new global shared variable mBatchMode as logical no-undo init ?.
      603   define variable mFramBachModHandle as handle no-undo.
      604   mFramBachModHandle = frame waitfram:handle.
      605   define variable mFameOldVis as logical no-undo.
      606   define variable mVisCUrentVin as logical no-undo.
      607   if session:batch-mode
      608   then
      609      mBatchMode = yes.
      610   if mBatchMode = ? then do:
      611     mVisCUrentVin = current-window:visible.
      612     mFameOldVis = mFramBachModHandle:visible.
      613     mFramBachModHandle:visible  = yes.
      614     mBatchMode = mFramBachModHandle:visible ne yes.
      615     mFramBachModHandle:visible = mFameOldVis.
      616     current-window:visible = mVisCUrentVin.
      617   end.
      618    if  log-manager:logfile-name ne ?
      619     then DO:
      620         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      621         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      622         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      623     end.
      624   on choose of B-WaitFramStop in frame waitfram
      625   do:
      626     mWaitFramStop = yes.
      627     mWaitFramStopUser = yes.
      628   end.
      629   function waitfram-check-timeout returns logical():
      630      define variable vtime as int64 no-undo.
      631      if mWaitFramStopTimeOut
      632      then
      633         return yes.
      634      vtime = ( now - mWaitFramStartProc ) / 1000 .
      635      if     mWaitFramTimeOut ne ?
      636         and mWaitFramTimeOut ne 0
      637         and mWaitFramTimeOut lt vtime
      638      then do:
      639         mWaitFramStopTimeOut = yes.
      640      end.
      641      return mWaitFramStopTimeOut.
      642   end.
      643   procedure waitfram-hide :
      644     if not session:batch-mode
      645     then do
      646     on error undo, return error return-value
      647     :
      648       pause 0 before-hide .
      649       if not mBatchMode then
      650         hide frame waitfram .
      651     if     not mWaitFramView
      652        and mWaitProcEvent
      653     then
      654       process events .
      655     end.
      656   end procedure.
      657   procedure waitfram-show :
      658     define input  parameter p-message as character no-undo .
      659     define variable v-left-margin as integer   no-undo .
      660     if not session:batch-mode
      661     then do
      662     on error undo, return error return-value
      663     :
      664       if length(p-message) <= 70 then do:
      665         assign
      666           v-left-margin = integer((70 - length(p-message)) / 2)
      667         .
      668         assign
      669           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      670         .
      671         assign
      672           v-waitfram-action01 = " "
      673           v-waitfram-action02 = " "
      674                                    + fill(" ", v-left-margin)
      675                                    + p-message
      676           v-waitfram-action03 = " "
      677         .
      678       end.
      679       else do:
      680         define variable vRindex1 as integer no-undo.
      681         define variable vRindex2 as integer no-undo.
      682         vRindex1 = r-index(p-message," ",70).
      683         if vRindex1 = 0
      684         then
      685            vRindex1 = 70.
      686         if length(p-message)  <= vRindex1 + 70 then do:
      687           assign
      688             v-waitfram-action01 = " "
      689             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      690             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      691           .
      692         end.
      693         else do:
      694           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      695           if vRindex2 <= vRindex1
      696           then
      697              vRindex2 = vRindex1 + 70.
      698           assign
      699             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      700             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      701             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      702           .
      703         end.
      704       end.
      705       B-viewProcInfo:visible   in frame waitfram = no.
      706       B-viewProcInfo:sensitive in frame waitfram = no.
      707       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      708       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      709       if  (   mWaitFramView
      710          or  mWaitProcEvent)
      711          and not mBatchMode
      712       then
      713          display
      714             v-waitfram-action01 skip
      715             v-waitfram-action02 skip
      716             v-waitfram-action03 skip
      717          with frame waitfram .
      718       if     mWaitFramView
      719          then do:
      720             if     mWaitFramInterval ne ?
      721                and not mBatchMode
      722             then
      723                wait-for go of frame waitfram pause mWaitFramInterval.
      724          end.
      725          else
      726             if     mWaitProcEvent
      727                and not mBatchMode
      728             then
      729                process events .
      730     end.
      731   end procedure.
      732      procedure waitfram-show-this:
      733         define input  parameter iInterval as int64 no-undo.
      734         define variable vtime as int64 no-undo.
      735         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      736         mWaitFramInterval = iInterval.
      737         run waitfram-show (substitute("&1&2 &3&4" ,
      738                                       mWaitFramTextBeg ,
      739                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      740                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      741                                       mWaitFramTextEnd
      742                                      )
      743                           ).
      744      end.
      745      procedure WaitFramRunPause:
      746         define input  parameter iInterval as dec no-undo.
      747         define variable vStart  as datetime-tz no-undo.
      748         define variable vend    as datetime-tz no-undo.
      749         define variable vint as int64 no-undo.
      750         define variable vOk as logical no-undo.
      751         vStart = now.
      752         vend   = vStart.
      753         publish "WaitFramPause" (iInterval,output vOk).
      754         vend   =  now.
      755         vint = vend - vStart.
      756         vint = iInterval - vint / 1000.
      757         if     not mWaitFramStop
      758            and (   vint > 0
      759                 or (    not vOk
      760                     and iInterval eq ?
      761                     )
      762                 )
      763         then
      764            run waitfram-show-this (iInterval).
      765         vend   =  now.
      766         vint = vend - vStart.
      767         vint = iInterval - vint / 1000.
      768         if     not mWaitFramStop
      769            and vint > 0
      770         then do:
      771            run gbl/pause.p (vint * 1000).
      772         end.
      773         if iInterval ne ?
      774         then
      775            publish "WaitFramStop".
      776         waitfram-check-timeout().
      777      end.
      778      procedure WaitFramWaitFor:
      779         define input  parameter iInterval as dec no-undo.
      780         assign
      781            mWaitFramStartProc   = now
      782            mWaitFramStopUser    = no
      783            mWaitFramStopTimeOut = no
      784         .
      785         block-wait:
      786         do while not mWaitFramStop:
      787            run WaitFramRunPause (iInterval).
      788            if  waitfram-check-timeout()
      789            then do:
      790               leave block-wait.
      791            end.
      792         end.
      793         run waitfram-hide.
      794      end.
      795   procedure waitfram-join :
      796     define input  parameter p-line-1  as character no-undo .
      797     define input  parameter p-line-2  as character no-undo .
      798     define input  parameter p-line-3  as character no-undo .
      799     define output parameter p-message as character no-undo .
      800     do
      801     on error undo, return error return-value
      802     :
      803       assign
      804         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      805                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      806                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      807       .
      808     end.
      809   end procedure.
      810   function waitfram-join-function returns character
      811     (input p-line-1 as character
      812     ,input p-line-2 as character
      813     ,input p-line-3 as character
      814     ).
      815     define variable v-message as character no-undo .
      816     run waitfram-join in this-procedure
      817       (input  p-line-1
      818       ,input  p-line-2
      819       ,input  p-line-3
      820       ,output v-message
      821       ) .
      822     return v-message .
      823   end function .
      824   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      825   define  stream PrnLibStream.
      826   procedure prn-lib-prn-file :
      827     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      828     define input parameter p-DIsabledoptions as integer no-undo .
      829     define variable v-report-name as character no-undo .
      830     define variable v-user-action as character no-undo .
      831     define variable v-printed     as logical   no-undo .
      832     define variable v-exist       as logical   no-undo .
      833     do
      834       on error undo, return error
      835       :
      836       run prn-lib-get-report-name  in this-procedure (
      837         input parParentProc
      838         ,output v-report-name
      839         ).
      840   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      841   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      842     (input  v-report-name
      843     ,input  2
      844     ,output v-exist
      845     )  .
      846       if NOT v-exist then
      847       DO:
      848         Message
      849           "Нет заданий на печать ! "
      850           view-as alert-box .
      851         Return  .
      852       End.
      853       run gbl/prnfilen.w
      854         (input  ""
      855         ,input  p-DisabledOptions
      856         ,input  string(v-report-name )
      857         ,input  7
      858         ,output v-user-action
      859         ,output v-printed
      860         ) .
      861       if v-printed then
      862       do:
      863         return "YES" .
      864       end.
      865       else
      866       do:
      867         return "NO" .
      868       end.
      869     end.
      870   end procedure.
      871   procedure prn-lib-open-stream :
      872     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      873     define input parameter p-page-size    as integer no-undo .
      874     define input parameter p-is-stream    as logical no-undo .
      875     define input parameter p-append       as logical no-undo .
      876     define variable v-report-name as character no-undo .
      877     do
      878       on error undo, return error
      879       :
      880       run prn-lib-get-report-name  in this-procedure (
      881         input parParentProc
      882         ,output v-report-name
      883         ).
      884       if p-is-stream then
      885       do:
      886         if p-append then
      887         do:
      888           output stream PrnLibStream to value( v-report-name )
      889             page-size value(p-page-size) append .
      890         end.
      891         if not p-append then
      892         do:
      893           output stream PrnLibStream to value( v-report-name )
      894             page-size value(p-page-size) .
      895         end.
      896       end.
      897       if not p-is-stream then
      898       do:
      899         if p-append then
      900         do:
      901           output to value( v-report-name )
      902             page-size value(p-page-size) append .
      903         end.
      904         if not p-append then
      905         do:
      906           output to value( v-report-name )
      907             page-size value(p-page-size) .
      908         end.
      909       end.
      910     end.
      911   end procedure.
      912   procedure prn-lib-open-exp :
      913     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      914     define input parameter p-is-stream    as logical no-undo .
      915     define input parameter p-is-append    as logical no-undo .
      916     define output parameter p-ReportFileName as char init "report" no-undo.
      917     define output parameter p-process as logical no-undo .
      918     define variable glog as logical no-undo .
      919     do
      920       on error undo, return error
      921       :
      922       SYSTEM-DIALOG GET-FILE p-ReportFileName
      923         TITLE      "Укажите путь"
      924         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      925         ASK-OVERWRITE
      926         CREATE-TEST-FILE
      927         SAVE-AS
      928         USE-FILENAME
      929         DEFAULT-EXTENSION "txt"
      930         UPDATE glog
      931         .
      932       if not glog then  return.
      933       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      934       if p-is-stream then
      935       do:
      936         if p-is-append then
      937         do:
      938           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      939         end.
      940         else
      941         do:
      942           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      943         end.
      944       end.
      945       else
      946       do:
      947         if p-is-append then
      948         do:
      949           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      950         end.
      951         else
      952         do:
      953           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      954         end.
      955       end.
      956       p-process = yes.
      957     end.
      958   end procedure.
      959   procedure prn-lib-get-report-name :
      960     define input parameter parParentProc  as widget-handle no-undo.
      961     define output parameter p-report-name as character no-undo .
      962     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      963   end procedure.
      964   procedure prn-lib-reportviewer-report-name :
      965     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      966     define input parameter p-report-name-html as character no-undo .
      967     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      968   end procedure.
      969   procedure prn-lib-reportviewer :
      970     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      971     define input parameter p-report-name-html as character no-undo .
      972     define input parameter p-param        as character no-undo .
      973     define variable v-excel           as character no-undo init 'TRUE' .
      974     define variable v-value-character as character no-undo .
      975     define variable v-value-integer   as character no-undo .
      976     define variable v-value-date      as date      no-undo .
      977     define variable v-value-decimal   as decimal   no-undo .
      978     define variable rep-excel         as logical   no-undo .
      979     define variable excel-string      as character no-undo .
      980     define variable v-param-type      as character no-undo .
      981     define variable v-tth             as handle    no-undo .
      982     run adm/shattri.p (
      983       input "get":U
      984       ,input  ""
      985       ,input  0
      986       ,input  'report-glob':U
      987       ,input  'rep-excel':U
      988       ,output v-value-character
      989       ,output v-value-date
      990       ,output v-value-decimal
      991       ,output v-value-integer
      992       ,output rep-excel
      993       ,output v-param-type
      994       ,INPUT-OUTPUT table-handle v-tth
      995       )  .
      996     if rep-excel then v-excel = "TRUE" .
      997     else v-excel = "FALSE" .
      998     if p-param eq ""
      999     then
     1000        p-param = "EXCEL:" + v-excel.
     1001     else
     1002        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1003     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1004   end procedure.
     1005   define variable sym1  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1006   define variable sym2  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1007   define variable sym3  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
