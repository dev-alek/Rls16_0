     2862       bfs_tt-allsum.other-base-acc      =  - bf_tt-allsum.other-base-acc
     2863       bfs_tt-allsum.other-rubl-acc      =  - bf_tt-allsum.other-rubl-acc
     2864       bfs_tt-allsum.other-cli-acc       =  - bf_tt-allsum.other-cli-acc.
     2865   end.
     2866   create bfpc_tt-allsum.
     2867   create bfspc_tt-allsum.
     2868   case cl_tt-clcparts.purch-code :
     2869   when 1           then do:
     2870     assign
     2871       bfpc_tt-allsum.sum-type  = 'сумма_по_выкупу':U
     2872       bfspc_tt-allsum.sum-type = 'сумма_по_выкупу_со_знаком':U.
     2873     buffer-copy bf_tt-allsum  except bf_tt-allsum.sum-type  to bfpc_tt-allsum.
     2874     buffer-copy bfs_tt-allsum except bfs_tt-allsum.sum-type to bfspc_tt-allsum.
     2875   end.
     2876   when 4    then do:
     2877     assign
     2878       bfpc_tt-allsum.sum-type  = 'сумма_по_старой_консигнации':U
     2879       bfspc_tt-allsum.sum-type = 'сумма_по_старой_консигнации_со_знаком':U.
     2880     buffer-copy bf_tt-allsum  except bf_tt-allsum.sum-type  to bfpc_tt-allsum.
     2881     buffer-copy bfs_tt-allsum except bfs_tt-allsum.sum-type to bfspc_tt-allsum.
     2882   end.
     2883   when 3 then do:
     2884     assign
     2885       bfpc_tt-allsum.sum-type  = 'сумма_по_ответственному_хранению':U
     2886       bfspc_tt-allsum.sum-type = 'сумма_по_ответственному_хранению_со_знаком':U.
     2887     buffer-copy bf_tt-allsum  except bf_tt-allsum.sum-type  to bfpc_tt-allsum.
     2888     buffer-copy bfs_tt-allsum except bfs_tt-allsum.sum-type to bfspc_tt-allsum.
     2889   end.
     2890   when 2 then do:
     2891     assign
     2892       bfpc_tt-allsum.sum-type  = 'сумма_по_консигнации_выгода':U
     2893       bfspc_tt-allsum.sum-type = 'сумма_по_консигнации_выгода_со_знаком':U.
     2894     assign
     2895       bfpc_tt-allsum.fact-qnty           = bf_tt-allsum.fact-qnty
     2896       bfpc_tt-allsum.cli-qnty            = bf_tt-allsum.cli-qnty
     2897       bfpc_tt-allsum.sum-dsc-base-doc    = bf_tt-allsum.sum-dsc-base-doc    - bf_tt-allsum.sum-dsc-base-acc
     2898       bfpc_tt-allsum.sum-dsc-rubl-doc    = bf_tt-allsum.sum-dsc-rubl-doc    - bf_tt-allsum.sum-dsc-rubl-acc
