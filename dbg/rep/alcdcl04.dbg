     2115     end.
     2116     else do:
     2117       find first in-vatp_doc-attrcl no-lock
     2118         where in-vatp_doc-attrcl.doc-code  = cl_tt-clcparts.out-code
     2119           and in-vatp_doc-attrcl.attr-code = 'envd':U
     2120         no-error .
     2121       if not available in-vatp_doc-attrcl then do:
     2122         assign
