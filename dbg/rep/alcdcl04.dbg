     3138   procedure clcprtsl_calc-line :
     3139   define input  parameter parrec-line as recid no-undo.
     3140   define variable v-tax-date         as   date                     no-undo.
     3141   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     3142   define variable varr-b             as   character                no-undo.
     3143   define variable varr-btype         as   character                no-undo.
     3144   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     3145   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     3146   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     3147   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     3148   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     3149   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     3150   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     3151   define variable varb-code          like ub.bar-code.b-code       no-undo.
     3152   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     3153   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     3154   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     3155   define variable varexcise          like ub.price-list.excise     no-undo.
     3156   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     3157   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     3158   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     3159   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     3160   define variable v-varsum           as decimal                  no-undo.
     3161   define variable varprice-salef as decimal   no-undo .
     3162   define buffer bf_trn-doc             for ub.trn-doc.
     3163   define buffer bf_doc-line            for ub.doc-line.
     3164   define buffer bf_gds-dtl             for ub.gds-dtl.
     3165   define buffer bf_goods               for ub.goods.
     3166   define buffer bf_parts               for ub.parts.
     3167   define buffer bf_sysconf             for ub.sysconf.
     3168   define buffer bf_tt-allsum-line      for tt-allsum-line.
     3169   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     3170   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     3171   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     3172   define buffer buf_parts        for ub.parts.
     3173   v-calcbypart = no.
     3174   do on error undo, return error return-value :
     3175   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3176   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3177     (output varr-b
     3178     )  .
     3179     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     3180     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     3181     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     3182                               bf_goods.prod-type = bf_doc-line.prod-type and
     3183                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     3184     if bf_trn-doc.fact-date <> ?        then do:
     3185       assign v-tax-date = bf_trn-doc.fact-date.
     3186     end.
     3187     else do:
     3188       assign v-tax-date = ?.
     3189     end.
     3190   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3191   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     3192     (input  bf_goods.gds-code
     3193     ,input  '1':U
     3194     ,input  v-tax-date
     3195     ,input  bf_trn-doc.host-code
     3196     ,input  bf_trn-doc.obj-type
     3197     ,input  bf_trn-doc.obj-code
     3198     ,output v-vat-pc
     3199     ) no-error .
     3200     if error-status :error
     3201     or v-vat-pc = ? then do:
     3202        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     3203     end.
     3204     if bf_goods.gds-type = 'у':U or
     3205        bf_trn-doc.status_ = 'запрос':U then do:
     3206       for each bf_tt-allsum-line
     3207       on error undo, return error return-value
     3208        :
     3209         delete bf_tt-allsum-line.
     3210       end.
     3211       create bf_tt-allsum-line.
     3212       assign
     3213        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     3214       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     3215                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     3216                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     3217                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     3218         assign
     3219           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     3220           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     3221           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     3222           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     3223           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     3224           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     3225           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     3226           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     3227           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     3228           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     3229           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     3230           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     3231           bf_tt-allsum-line.vat-cli-acc          =  ?
     3232           .
     3233       end.
     3234       assign
     3235         bf_tt-allsum-line.cli-qnty             =  ?
     3236         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     3237         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
