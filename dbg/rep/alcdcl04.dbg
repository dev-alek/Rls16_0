     2578     .
     2579   end.
     2580   else do:
     2581     assign
     2582           road-tax-base-salecur    =  (if parcurroad-tax = ? then 0 else parcurroad-tax / parcurbase-rate * parcurbase-scale)
     2583       excise-base-salecur      =  (if parcurexcise   = ? then 0 else parcurexcise   / parcurbase-rate * parcurbase-scale)
     2584     .
     2585   end.
     2586   if varoutvprbcur = "rubl":u then do:
     2587     assign
     2588           road-tax-rubl-salecur    = (if parcurroad-tax = ? then 0 else parcurroad-tax * 1)
     2589       excise-rubl-salecur      = (if parcurexcise   = ? then 0 else parcurexcise   * 1) .
     2590   end.
     2591   else do:
     2592     assign
     2593           road-tax-rubl-salecur    = (if parcurroad-tax = ? then 0 else parcurroad-tax * parcurbase-rate / parcurbase-scale)
     2594       excise-rubl-salecur      = (if parcurexcise   = ? then 0 else parcurexcise   * parcurbase-rate / parcurbase-scale) .
     2595   end.
     2596   assign
     2597     varis-cons-parts-havecur =  no.
     2598   assign
     2599     varfact-qntycur       = 0
     2600     varcons-qntycur       = 0
     2601     varprice-base-conscur = 0
     2602     varprice-rubl-conscur = 0.
     2603   if cl_tt-clcparts.purch-code = 2 then do:
     2604   assign
     2605     price-rubl-with-tax-lococur = cl_tt-clcparts.price-rubl
     2606     price-base-with-tax-lococur = cl_tt-clcparts.price-base
     2607   .
     2608   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2609   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2610     (output varinvprbocur
     2611     )  .
     2612     if cl_tt-clcparts.out-code = 'free-zone':U     or
     2613        cl_tt-clcparts.out-code = 'out-zone':U   or
     2614        cl_tt-clcparts.doc-type = 'акт':U then do:
     2615       assign
     2616         in-vatp-have-vat-sltocur = yes.
     2617     end.
     2618     else do:
     2619       find first in-vatp_doc-attrocur no-lock
     2620         where in-vatp_doc-attrocur.doc-code  = cl_tt-clcparts.out-code
     2621           and in-vatp_doc-attrocur.attr-code = 'envd':U
     2622         no-error .
     2623       if not available in-vatp_doc-attrocur then do:
     2624         assign
     2625           in-vatp-have-vat-sltocur = yes.
     2626       end.
     2627       else do:
     2628            in-vatp-have-vat-sltocur = no.
     2629       end.
     2630     end.
     2631     assign
     2632      price-cli-with-tax-lococur = cl_tt-clcparts.price-cli
     2633      cli-base-rateocur          = cl_tt-clcparts.cli-base-rate.
     2634     ASSIGN   road-tax-base-lococur  = (if cl_tt-clcparts.road-tax-base  = ? then 0 else cl_tt-clcparts.road-tax-base)
     2635              road-tax-rubl-lococur  = (if cl_tt-clcparts.road-tax-rubl  = ? then 0 else cl_tt-clcparts.road-tax-rubl).
     2636     ASSIGN  transport-base-lococur = (if cl_tt-clcparts.transport-base = ? then 0 else cl_tt-clcparts.transport-base)
     2637             transport-rubl-lococur = (if cl_tt-clcparts.transport-rubl = ? then 0 else cl_tt-clcparts.transport-rubl)
     2638             other-base-lococur     = (if cl_tt-clcparts.other-base     = ? then 0 else cl_tt-clcparts.other-base)
     2639             other-rubl-lococur     = (if cl_tt-clcparts.other-rubl     = ? then 0 else cl_tt-clcparts.other-rubl)
     2640             vat-pc-lococur         = (if cl_tt-clcparts.vat-pc         = ? then 0 else cl_tt-clcparts.vat-pc)
     2641             slt-pc-lococur         = (if cl_tt-clcparts.slt-pc         = ? then 0 else cl_tt-clcparts.slt-pc).
     2642             ASSIGN   slt-base-lococur    = (if in-vatp-have-vat-sltocur = no then 0 else (price-base-with-tax-lococur - ((if road-tax-base-lococur  = ? then 0 else road-tax-base-lococur) + (if transport-base-lococur = ? then 0 else transport-base-lococur) + (if other-base-lococur = ? then 0 else other-base-lococur)))                           * slt-pc-lococur / (100 + slt-pc-lococur))                        vat-base-lococur    = (if in-vatp-have-vat-sltocur = no then 0 else (price-base-with-tax-lococur - ((if road-tax-base-lococur  = ? then 0 else road-tax-base-lococur) + (if transport-base-lococur = ? then 0 else transport-base-lococur) + (if other-base-lococur = ? then 0 else other-base-lococur))) * (1 - slt-pc-lococur / (100 + slt-pc-lococur)) * vat-pc-lococur / (100 + vat-pc-lococur)).
     2643       ASSIGN   slt-rubl-lococur    = (if in-vatp-have-vat-sltocur = no then 0 else (price-rubl-with-tax-lococur - ((if road-tax-rubl-lococur  = ? then 0 else road-tax-rubl-lococur) + (if transport-rubl-lococur = ? then 0 else transport-rubl-lococur) + (if other-rubl-lococur = ? then 0 else other-rubl-lococur)))                           * slt-pc-lococur / (100 + slt-pc-lococur))                        vat-rubl-lococur    = (if in-vatp-have-vat-sltocur = no then 0 else (price-rubl-with-tax-lococur - ((if road-tax-rubl-lococur  = ? then 0 else road-tax-rubl-lococur) + (if transport-rubl-lococur = ? then 0 else transport-rubl-lococur) + (if other-rubl-lococur = ? then 0 else other-rubl-lococur))) * (1 - slt-pc-lococur / (100 + slt-pc-lococur)) * vat-pc-lococur / (100 + vat-pc-lococur)).
     2644     assign
     2645       exch-rate-cli-lococur = (cl_tt-clcparts.price-rubl - transport-rubl-lococur - other-rubl-lococur - road-tax-rubl-lococur - (if cl_tt-clcparts.vat-type <> 'в т. ч.':U then vat-rubl-lococur else 0) - (if cl_tt-clcparts.slt-type <> 'в т. ч.':U then slt-rubl-lococur else 0)) / cl_tt-clcparts.price-cli .
     2646     assign
     2647       slt-cli-lococur        = slt-rubl-lococur       / exch-rate-cli-lococur
     2648       vat-cli-lococur        = vat-rubl-lococur       / exch-rate-cli-lococur
     2649       road-tax-cli-lococur   = road-tax-rubl-lococur  / exch-rate-cli-lococur
     2650       transport-cli-lococur  = 0
     2651       other-cli-lococur      = 0
     2652     .
     2653   ASSIGN
     2654             price-base-without-tax-lococur = price-base-with-tax-lococur - vat-base-lococur - slt-base-lococur - ((if road-tax-base-lococur  = ? then 0 else road-tax-base-lococur) + (if transport-base-lococur = ? then 0 else transport-base-lococur) + (if other-base-lococur = ? then 0 else other-base-lococur))
     2655       price-rubl-without-tax-lococur = price-rubl-with-tax-lococur - vat-rubl-lococur - slt-rubl-lococur - ((if road-tax-rubl-lococur  = ? then 0 else road-tax-rubl-lococur) + (if transport-rubl-lococur = ? then 0 else transport-rubl-lococur) + (if other-rubl-lococur = ? then 0 else other-rubl-lococur))
     2656   .
     2657     assign
     2658       varprice-base-conscur    = varprice-base-conscur + (price-base-with-tax-lococur - (if road-tax-base-lococur = ? then 0 else road-tax-base-lococur))* cl_tt-clcparts.fact-qnty
     2659       varprice-rubl-conscur    = varprice-rubl-conscur + (price-rubl-with-tax-lococur - (if road-tax-rubl-lococur = ? then 0 else road-tax-rubl-lococur))* cl_tt-clcparts.fact-qnty
     2660       varis-cons-parts-havecur = yes
