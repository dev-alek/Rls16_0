     4833   procedure clear-all :
     4834   do
     4835   on error undo, return error return-value
     4836   :
     4837     empty temp-table tt-gds.
     4838     empty temp-table tt-report.
     4839   end.
     4840   end procedure.
     4841   procedure find-alc-goods :
     4842   do
     4843   on error undo, return error return-value
     4844   :
     4845     define buffer buf_alc-type      for ub.alc-type.
     4846     define buffer buf_alc-type-gds  for ub.alc-type-gds.
     4847     define buffer buf_goods         for ub.goods.
     4848     empty temp-table tt-gds.
     4849     for each buf_alc-type no-lock
     4850           where buf_alc-type.alc-type-status = 0
     4851     :
     4852       for each buf_alc-type-gds no-lock
     4853             where buf_alc-type-gds.alc-type-inner-code = buf_alc-type.alc-type-inner-code
     4854               AND buf_alc-type-gds.create-user-db-num  = buf_alc-type.create-user-db-num
     4855         , first buf_goods no-lock
     4856             where buf_goods.gds-code = buf_alc-type-gds.gds-code
     4857       :
     4858         find first tt-gds no-lock where tt-gds.gds-code = buf_goods.gds-code no-error .
     4859         if not available tt-gds then do:
     4860           create tt-gds.
     4861           buffer-copy buf_goods to tt-gds
     4862           assign
     4863             tt-gds.alc-type-inner-code = buf_alc-type.alc-type-inner-code
     4864             tt-gds.create-user-db-num  = buf_alc-type.create-user-db-num
     4865             tt-gds.alc-type-code       = buf_alc-type.alc-type-code
     4866             tt-gds.alc-type-name       = buf_alc-type.alc-type-name
     4867           .
     4868         end.
     4869       end.
     4870     end.
     4871   end.
     4872   end procedure.
     4873   procedure fill-tt-report :
     4874     define buffer buf_alc-type    for ub.alc-type.
     4875     define buffer buf_trn-doc     for ub.trn-doc.
     4876     define buffer t-doc           for ub.trn-doc.
     4877     define buffer buf_doc-line    for ub.doc-line.
     4878     define buffer buf_parts       for ub.parts.
     4879     define buffer buf_tt-clcparts for tt-clcparts .
     4880     define buffer buf_goods       for ub.goods.
     4881     define buffer buf_ot-line     for ub.ot-line.
     4882     define buffer buf_obj-list    for obj-list.
     4883     define variable var-x-store-code    like ub.clients.obj-code    no-undo.
     4884     define variable var-x-store-type    like ub.clients.obj-type    no-undo.
     4885     define variable var-x-date-start    like ub.stk-tot.Fact-date   no-undo.
     4886     define variable var-x-date-endt     like ub.stk-tot.Fact-date   no-undo.
     4887     define variable var-x-sum-type      like ub.stk-tot.sum-type    no-undo.
     4888     define variable var-x-ost-sum-type  like ub.stk-tot.sum-type    no-undo.
     4889     define variable var-x-cat-id        like ub.stk-tot.cat-id      no-undo.
     4890     define variable var-xTog-obj        as   logical             no-undo.
     4891     define variable var-Quantity        like ub.stk-tot.fact-qnty   initial ? no-undo.
     4892     define variable var-Coast_R         like ub.stk-tot.sum-rubl    no-undo.
     4893     define variable var-Coast_V         like ub.stk-tot.sum-rubl    no-undo.
     4894     define variable var-VAT_R           like ub.stk-tot.sum-rubl    no-undo.
     4895     define variable var-VAT_V           like ub.stk-tot.sum-rubl    no-undo.
     4896     define variable var-Fact-order      like ub.stk-tot.Fact-order  no-undo.
     4897     define variable var-x-artic         like ub.stk-line.artic        no-undo.
     4898     define variable var-x-prod-code     like ub.stk-line.prod-code    no-undo.
     4899     define variable var-x-prod-type     like ub.stk-line.prod-type    no-undo.
     4900     define variable var-SLT_R           like ub.stk-tot.sum-rubl    no-undo.
     4901     define variable var-SLT_V           like ub.stk-tot.sum-rubl    no-undo.
     4902     define variable v-fact-order-1      like ub.ot-line.fact-order no-undo .
     4903     define variable v-fact-order-2      like ub.ot-line.fact-order no-undo .
     4904     define variable v-shift-end-fact-order          as decimal    no-undo .
     4905     define variable v-day-end-fact-order            as decimal    no-undo .
     4906     define variable v-part-qnty                     as decimal   no-undo .
     4907     define variable v-ot-line-qnty                  as decimal   no-undo .
     4908     define variable v-ost-begin-qnty  as decimal   no-undo .
     4909     define variable v-purchase-qnty   as decimal   no-undo .
     4910     define variable v-sell-qnty       as decimal   no-undo .
     4911     define variable v-ret-qnty        as decimal   no-undo .
     4912     define variable v-other-qnty      as decimal   no-undo .
     4913     define variable v-ost-end-qnty    as decimal   no-undo .
     4914     define variable v-income-doc-code like ub.trn-doc.doc-code no-undo .
     4915   do
     4916   on error undo, return error return-value
     4917   :
     4918     run factord in this-procedure
     4919       ( input  v-begin-date
     4920       , input  1
     4921       , input  1
     4922       , input  ?
     4923       , input  0
     4924       , input  false
     4925       , output v-fact-order-1
     4926       , output v-shift-end-fact-order
     4927       , output v-day-end-fact-order
     4928       ) no-error .
     4929     if error-status:error then do:
     4930       message error-status :get-message(1) view-as alert-box error .
     4931       return error.
     4932     end.
     4933     run factord in this-procedure
     4934       ( input  v-end-date + 1
     4935       , input  1
     4936       , input  1
     4937       , input  ?
     4938       , input  0
     4939       , input  false
     4940       , output v-fact-order-2
     4941       , output v-shift-end-fact-order
     4942       , output v-day-end-fact-order
     4943       ) no-error .
     4944     if error-status:error then do:
     4945       message error-status :get-message(1) view-as alert-box error .
     4946       return error.
     4947     end.
     4948     assign
     4949       var-x-sum-type      = 'cost':U
     4950       var-x-ost-sum-type  = 'cost':U
     4951     .
     4952     run waitfram-show in this-procedure ( "Расчет остатков на начало" ).
     4953     for each buf_alc-type no-lock
     4954           where buf_alc-type.alc-type-status = 0
     4955     break by buf_alc-type.alc-type-code
     4956     :
     4957       for each obj-list no-lock ,
     4958           each tt-gds no-lock
     4959             where tt-gds.alc-type-code = buf_alc-type.alc-type-code
     4960       :
     4961           assign
     4962             var-x-store-code  = obj-list.obj-code
     4963             var-x-store-type  = obj-list.obj-type
     4964             var-x-artic       = tt-gds.artic
     4965             var-x-prod-code   = tt-gds.prod-code
     4966             var-x-prod-type   = tt-gds.prod-type
     4967             var-x-cat-id      = '##,##':U
     4968             var-xTog-obj      = yes
     4969           .
     4970           RUN ost-line  (
     4971               input   var-x-store-code,
     4972               input   var-x-store-type,
     4973               INPUT   var-x-artic     ,
     4974               INPUT   var-x-prod-code ,
     4975               INPUT   var-x-prod-type ,
     4976               input   no              ,
     4977               input   v-fact-order-1  ,
     4978               input   var-x-ost-sum-type  ,
     4979               input   var-x-cat-id    ,
     4980               input   var-xTog-obj    ,
     4981               output  var-Quantity    ,
     4982               output  var-Coast_R     ,
     4983               output  var-Coast_V     ,
     4984               output  var-VAT_R       ,
     4985               output  var-VAT_V       ,
     4986               output  var-SLT_R       ,
     4987               output  var-SLT_V       ).
     4988           assign
     4989             v-ost-begin-qnty = v-ost-begin-qnty + (var-Quantity * tt-gds.ms-base / 10 )
     4990           .
     4991           RUN ost-line  (
     4992               input   var-x-store-code,
     4993               input   var-x-store-type,
     4994               INPUT   var-x-artic     ,
     4995               INPUT   var-x-prod-code ,
     4996               INPUT   var-x-prod-type ,
     4997               input   no              ,
     4998               input   v-fact-order-2  ,
     4999               input   var-x-ost-sum-type  ,
     5000               input   var-x-cat-id    ,
     5001               input   var-xTog-obj    ,
     5002               output  var-Quantity    ,
     5003               output  var-Coast_R     ,
     5004               output  var-Coast_V     ,
     5005               output  var-VAT_R       ,
     5006               output  var-VAT_V       ,
     5007               output  var-SLT_R       ,
     5008               output  var-SLT_V       ).
     5009           assign
     5010             v-ost-end-qnty = v-ost-end-qnty + + (var-Quantity * tt-gds.ms-base / 10 )
     5011           .
     5012       end.
     5013       for each obj-list no-lock ,
     5014           each tt-gds no-lock
     5015             where tt-gds.alc-type-inner-code = buf_alc-type.alc-type-inner-code
     5016               and tt-gds.create-user-db-num  = buf_alc-type.create-user-db-num ,
     5017             each buf_ot-line no-lock
     5018               where   buf_ot-line.artic        = tt-gds.artic
     5019                 and   buf_ot-line.prod-code    = tt-gds.prod-code
     5020                 and   buf_ot-line.prod-type    = tt-gds.prod-type
     5021                 and   buf_ot-line.fact-order   <= v-fact-order-2
     5022                 and   buf_ot-line.fact-order   >= v-fact-order-1
     5023                 and   buf_ot-line.obj-code     = obj-list.obj-code
     5024                 and   buf_ot-line.obj-type     = obj-list.obj-type
     5025                 and   buf_ot-line.sum-type     = var-x-sum-type
     5026       :
     5027         run waitfram-show in this-procedure (input substitute("Расчет оборота по объекту: &1" , obj-list.obj-name ) ).
     5028         find first buf_trn-doc no-lock
     5029           where buf_trn-doc.doc-code = buf_ot-line.doc-code
     5030         no-error .
     5031         if not available buf_trn-doc then do:
     5032           message
     5033             vss-workfile vss-revision vss-description skip
     5034             substitute( "Не найден складской документ &1.&2Документ не будет учтен в отчете." , buf_ot-line.doc-code , chr(10) )
     5035           view-as alert-box error .
     5036           next.
     5037         end.
     5038           assign
     5039             v-ot-line-qnty  = abs(buf_ot-line.fact-qnty * tt-gds.ms-base / 10)
     5040           .
     5041         case buf_ot-line.ext-doc-type:
     5042           when 'ie':U  then do :
     5043             assign
     5044               v-purchase-qnty = v-purchase-qnty + v-ot-line-qnty
     5045             .
     5046           end.
     5047           when 'iv':U then do :
     5048             assign
     5049               v-other-qnty = v-other-qnty - v-ot-line-qnty
     5050             .
     5051           end.
     5052           when 'ee':U  then do :
     5053             assign
     5054               v-sell-qnty = v-sell-qnty + v-ot-line-qnty
     5055             .
     5056           end.
     5057           when 'es':U  then do :
     5058             assign
     5059               v-sell-qnty = v-sell-qnty + v-ot-line-qnty
     5060             .
     5061           end.
     5062           when 're':U  then do :
     5063             assign
     5064               v-ret-qnty = v-ret-qnty + v-ot-line-qnty
     5065             .
     5066           end.
     5067           when 'rs':U  then do :
     5068             assign
     5069               v-ret-qnty = v-ret-qnty - v-ot-line-qnty
     5070             .
     5071           end.
     5072           when 'ep':U then do :
     5073             assign
     5074               v-ret-qnty = v-ret-qnty + v-ot-line-qnty
     5075             .
     5076           end.
     5077           when 'we':U  then do :
     5078             assign
     5079               v-other-qnty = v-other-qnty + v-ot-line-qnty
     5080             .
     5081           end.
     5082           when 'ev':U then do :
     5083             assign
     5084               v-other-qnty = v-other-qnty + v-ot-line-qnty
     5085             .
     5086           end.
     5087           when 'rv':U then do :
     5088             assign
     5089               v-other-qnty = v-other-qnty - v-ot-line-qnty
     5090             .
     5091           end.
     5092           when 'vt':U or when 'vp':U or when 'im':U then do:
     5093             assign
     5094               v-other-qnty = v-other-qnty - v-ot-line-qnty
     5095             .
     5096           end.
     5097           otherwise do:
     5098             assign
     5099               v-other-qnty = v-other-qnty + v-ot-line-qnty
     5100             .
     5101           end.
     5102         end case.
     5103       end.
     5104       if last-of( buf_alc-type.alc-type-code ) then do:
     5105         find first tt-report
     5106           where tt-report.alc-type-code = buf_alc-type.alc-type-code
     5107         no-error .
     5108         if not available tt-report then do:
     5109           create tt-report.
     5110         end.
     5111         assign
     5112           tt-report.alc-type-code = buf_alc-type.alc-type-code
     5113           tt-report.alc-type-name = buf_alc-type.alc-type-name + ( if buf_alc-type.alc-type-code = "460" then " *" else "" )
     5114           tt-report.ost-begin     = v-ost-begin-qnty
     5115           tt-report.purchase      = v-purchase-qnty
     5116           tt-report.sell          = v-sell-qnty
     5117           tt-report.ret           = v-ret-qnty
     5118           tt-report.other         = v-other-qnty
     5119           tt-report.ras-total     = v-sell-qnty + v-ret-qnty + v-other-qnty
     5120           tt-report.ost-end       = v-ost-end-qnty
     5121           v-ost-begin-qnty        = 0
     5122           v-purchase-qnty         = 0
     5123           v-sell-qnty             = 0
     5124           v-ret-qnty              = 0
     5125           v-other-qnty            = 0
     5126           v-ost-end-qnty          = 0
     5127         .
     5128       end.
     5129     end.
     5130   end.
     5131   end procedure.
     5132   procedure find-income-doc-code :
     5133     define input  parameter p-in-code         like ub.parts.in-code    no-undo .
     5134     define input  parameter p-gds-code        like ub.goods.gds-code   no-undo .
     5135     define input  parameter p-part-code       like ub.parts.part-code  no-undo .
     5136     define output parameter p-income-doc-code like ub.parts.in-code    no-undo .
     5137   define buffer buf_parts-attr        for ub.parts-attr .
     5138   define buffer buf_income_parts-attr for ub.parts-attr .
     5139   do on error undo, return error return-value :
     5140     assign
     5141       p-income-doc-code = ?
     5142     .
     5143     find first buf_parts-attr no-lock
     5144       where buf_parts-attr.in-code   = p-in-code
     5145         and buf_parts-attr.gds-code  = p-gds-code
     5146         and buf_parts-attr.part-code = p-part-code
     5147     no-error .
     5148     if available buf_parts-attr then do:
     5149       find first buf_income_parts-attr no-lock
     5150         where buf_income_parts-attr.in-code   = buf_parts-attr.income-in-code
     5151           and buf_income_parts-attr.gds-code  = buf_parts-attr.income-gds-code
     5152           and buf_income_parts-attr.part-code = buf_parts-attr.income-part-code
     5153         no-error .
     5154       if available buf_income_parts-attr then do:
     5155         assign
     5156           p-income-doc-code = buf_parts-attr.income-in-code
     5157         .
     5158       end.
     5159       else do:
     5160         assign
     5161           p-income-doc-code = ?
     5162         .
     5163       end.
     5164     end.
     5165     else do:
     5166       assign
     5167         p-income-doc-code = ?
     5168       .
     5169     end.
     5170   end.
     5171   end procedure.
     5172   procedure print-report :
     5173     define variable v-alc-type-code-int       as integer   no-undo .
     5174     define variable v-alc-type-code-int-prev  as integer   no-undo .
     5175     define variable v-section                 as integer   no-undo .
     5176     define variable v-subsection              as integer   no-undo .
     5177     define variable v-ost-begin-tot-qnty      as decimal   no-undo .
     5178     define variable v-purchase-tot-qnty       as decimal   no-undo .
     5179     define variable v-sell-tot-qnty           as decimal   no-undo .
     5180     define variable v-ret-tot-qnty            as decimal   no-undo .
     5181     define variable v-other-tot-qnty          as decimal   no-undo .
     5182     define variable v-ras-tot-qnty            as decimal   no-undo .
     5183     define variable v-ost-end-tot-qnty        as decimal   no-undo .
     5184     define variable v-row-counter             as integer   no-undo .
     5185     define variable v-offset                  as integer   no-undo .
     5186     define variable v-i                       as integer   no-undo .
     5187     define variable v-alc-type-name           as character no-undo .
     5188   do
     5189   on error undo, return error return-value
     5190   :
     5191     assign
     5192       v-section                = 1
     5193       v-subsection             = 1
     5194       v-alc-type-num           = substitute( "&1.&2" , v-section , v-subsection )
     5195       v-alc-type-code-int-prev = 0
     5196     .
     5197     for each tt-report
     5198       break by tt-report.alc-type-code
     5199     :
     5200       if first-of(tt-report.alc-type-code) then do:
     5201         assign
     5202           v-alc-type-code-int-prev  = v-alc-type-code-int
     5203           v-alc-type-code-int       = integer(tt-report.alc-type-code)
     5204         no-error .
     5205         if error-status :error then do:
     5206           assign
     5207             v-alc-type-code-int = 0
     5208           .
     5209         end.
     5210         if v-alc-type-code-int-prev < 200 and v-alc-type-code-int >= 200 then do:
     5211           assign
     5212             v-alc-type-name = "Спиртные напитки, в том числе:"
     5213           .
     5214           display stream out-stream
     5215             "1"  @ v-alc-type-num
     5216             v-alc-type-name @ tt-report.alc-type-name
     5217             "x" @ tt-report.alc-type-code
     5218             sym1
     5219             sym2
     5220             sym3
     5221             sym4
     5222             sym5
     5223             sym6
     5224             sym7
     5225             sym8
     5226             sym9
     5227             sym10
     5228             sym11
     5229           with frame f-decl.
     5230           down stream out-stream with frame f-decl.
     5231           run alc04xl-sheet1-write-line-data in this-procedure
     5232                 ( input "1"
     5233                 , input v-alc-type-name
     5234                 , input "x"
     5235                 , input " "
     5236                 , input " "
     5237                 , input " "
     5238                 , input " "
     5239                 , input " "
     5240                 , input " "
     5241                 , input " "
     5242                 ).
     5243         end.
     5244         if v-alc-type-code-int-prev < 400 and v-alc-type-code-int >= 400 then do:
     5245             assign
     5246               v-section = v-section + 1
     5247               v-subsection    = 1
     5248               v-alc-type-num  = substitute( "&1.&2" , v-section , v-subsection )
     5249               v-alc-type-name = "Вина, в том числе:"
     5250             .
     5251             display stream out-stream
     5252               "2"  @ v-alc-type-num
     5253               v-alc-type-name @ tt-report.alc-type-name
     5254               "x" @ tt-report.alc-type-code
     5255               sym1
     5256               sym2
     5257               sym3
     5258               sym4
     5259               sym5
     5260               sym6
     5261               sym7
     5262               sym8
     5263               sym9
     5264               sym10
     5265               sym11
     5266             with frame f-decl.
     5267             down stream out-stream with frame f-decl.
     5268             run alc04xl-sheet1-write-line-data in this-procedure
     5269                   ( input "2"
     5270                   , input v-alc-type-name
     5271                   , input "x"
     5272                   , input " "
     5273                   , input " "
     5274                   , input " "
     5275                   , input " "
     5276                   , input " "
     5277                   , input " "
     5278                   , input " "
     5279                   ).
     5280         end.
     5281       end.
     5282       assign
     5283         v-row-counter = integer( truncate( ( length(tt-report.alc-type-name) / 56 ) , 0) + 1 )
     5284       .
     5285       if line-counter(out-stream) + v-row-counter - 1 > page-size(out-stream) then do:
     5286         page stream out-stream.
     5287       end.
     5288       do v-i = 1 to v-row-counter :
     5289         display stream out-stream
     5290           v-alc-type-num          when v-i = 1
     5291           substring( tt-report.alc-type-name , (v-i - 1) * 56 + 1 , 56 ) @ tt-report.alc-type-name
     5292           tt-report.alc-type-code when v-i = 1
     5293           tt-report.ost-begin     when v-i = 1
     5294           tt-report.purchase      when v-i = 1
     5295           tt-report.sell          when v-i = 1
     5296           tt-report.ret           when v-i = 1
     5297           tt-report.other         when v-i = 1
     5298           tt-report.ras-total     when v-i = 1
     5299           tt-report.ost-end       when v-i = 1
     5300           sym1
     5301           sym2
     5302           sym3
     5303           sym4
     5304           sym5
     5305           sym6
     5306           sym7
     5307           sym8
     5308           sym9
     5309           sym10
     5310           sym11
     5311         with frame f-decl.
     5312         down stream out-stream with frame f-decl.
     5313       end.
     5314       run alc04xl-sheet1-write-line-data in this-procedure
     5315             ( input v-alc-type-num
     5316             , input tt-report.alc-type-name
     5317             , input tt-report.alc-type-code
     5318             , input string( tt-report.ost-begin )
     5319             , input string( tt-report.purchase  )
     5320             , input string( tt-report.sell      )
     5321             , input string( tt-report.ret       )
     5322             , input string( tt-report.other     )
     5323             , input string( tt-report.ras-total )
     5324             , input string( tt-report.ost-end   )
     5325             ).
     5326       assign
     5327         v-ost-begin-tot-qnty = v-ost-begin-tot-qnty + tt-report.ost-begin
     5328         v-purchase-tot-qnty  = v-purchase-tot-qnty  + tt-report.purchase
     5329         v-sell-tot-qnty      = v-sell-tot-qnty      + tt-report.sell
     5330         v-ret-tot-qnty       = v-ret-tot-qnty       + tt-report.ret
     5331         v-other-tot-qnty     = v-other-tot-qnty     + tt-report.other
     5332         v-ras-tot-qnty       = v-ras-tot-qnty       + tt-report.ras-total
     5333         v-ost-end-tot-qnty   = v-ost-end-tot-qnty   + tt-report.ost-end
     5334         v-subsection    = v-subsection + 1
     5335         v-alc-type-num  = substitute( "&1.&2" , v-section , v-subsection )
     5336       .
     5337     end.
     5338     if line-counter(out-stream) + 2 > page-size(out-stream) then do:
     5339       page stream out-stream.
     5340     end.
     5341     put stream out-stream v-line format "X(197)" skip.
     5342     display stream out-stream
     5343         "ИТОГО по видам"      @ tt-report.alc-type-name
     5344         v-ost-begin-tot-qnty  @ tt-report.ost-begin
     5345         v-purchase-tot-qnty   @ tt-report.purchase
     5346         v-sell-tot-qnty       @ tt-report.sell
     5347         v-ret-tot-qnty        @ tt-report.ret
     5348         v-other-tot-qnty      @ tt-report.other
     5349         v-ras-tot-qnty        @ tt-report.ras-total
     5350         v-ost-end-tot-qnty    @ tt-report.ost-end
     5351         sym1
     5352         sym2
     5353         sym3
     5354         sym4
     5355         sym5
     5356         sym6
