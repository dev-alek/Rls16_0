     5889   procedure get-DD-MM-YYYY:
     5890       define input parameter p-dat-date as date no-undo.
     5891       define output parameter p-str-date as character no-undo.
     5892       p-str-date = replace(string(p-dat-date,'99.99.9999'), "/", ".").
     5893   end procedure.
     5894   procedure get-DD-Month-YYYY:
     5895       define input parameter p-dat-date as date no-undo.
     5896       define output parameter p-str-date as character no-undo.
     5897       define variable v-str-date as character no-undo.
     5898       define variable v-str-day as character no-undo.
     5899       define variable v-num-month as character no-undo.
     5900       define variable v-str-month as character no-undo.
     5901       define variable v-str-year as character no-undo.
     5902       v-str-date = string(p-dat-date).
     5903       do:
     5904           v-str-day = string(entry(1, v-str-date, "/")).
     5905       end.
     5906       do:
     5907       v-num-month = entry(2, v-str-date, "/").
     5908       v-str-month = MonthNameRusCase(integer(v-num-month), 2).
     5909       end.
     5910       do:
     5911           v-str-year = string(year(p-dat-date)).
     5912       end.
     5913       p-str-date = v-str-day + " " + v-str-month + " " + v-str-year + "г.".
     5914   end procedure.
     5915   procedure loc-get-set-attr :
     5916     define input  parameter p-mode-attr as character no-undo .
     5917     do
     5918     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     5919     on stop   undo, return error substitute( "&1. stop", vss-workfile )
     5920     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     5921     :
     5922       define buffer buf_doc-line-attr for ub.doc-line-attr .
     5923           find first buf_doc-attr     where buf_doc-attr.doc-code  = v-doc-code       and buf_doc-attr.attr-code = "car-num"     no-error.
     5924       if p-mode-attr = "get-attr":U then do:
     5925         if available buf_doc-attr then do:       assign         v-car-num = buf_doc-attr.attr-value       .     end.
     5926       end.
     5927       else do:
     5928       end.
     5929           find first buf_doc-attr     where buf_doc-attr.doc-code  = v-doc-code       and buf_doc-attr.attr-code = "inspection-cert"     no-error.
     5930       if p-mode-attr = "get-attr":U then do:
     5931         if available buf_doc-attr then do:       assign         v-inspection-cert = buf_doc-attr.attr-value       .     end.
     5932       end.
     5933           find first buf_doc-attr     where buf_doc-attr.doc-code  = v-doc-code       and buf_doc-attr.attr-code = "date-cert"     no-error.
     5934       if p-mode-attr = "get-attr":U then do:
     5935         if available buf_doc-attr then do:       assign         v-date-cert = date(buf_doc-attr.attr-value)       .     end.
     5936       end.
     5937           find first buf_doc-attr     where buf_doc-attr.doc-code  = v-doc-code       and buf_doc-attr.attr-code = "autoent"     no-error.
     5938       if p-mode-attr = "get-attr":U then do:
     5939               assign
     5940           v-autoent-obj-type = entry (1, buf_doc-attr.attr-value, ";")
     5941         no-error.
     5942       end.
     5943           find first buf_doc-attr     where buf_doc-attr.doc-code  = v-doc-code       and buf_doc-attr.attr-code = "autoent"     no-error.
     5944       if p-mode-attr = "get-attr":U then do:
     5945               assign
     5946           v-autoent-obj-code = entry (2, buf_doc-attr.attr-value, ";")
     5947         no-error.
     5948       end.
     5949           find first buf_doc-attr     where buf_doc-attr.doc-code  = v-doc-code       and buf_doc-attr.attr-code = "ptb-item-pour"     no-error.
     5950       if p-mode-attr = "get-attr":U then do:
     5951               if available buf_doc-attr then do:       assign         v-item-pour = buf_doc-attr.attr-value       .     end.
     5952       end.
     5953           find first buf_doc-attr     where buf_doc-attr.doc-code  = v-doc-code       and buf_doc-attr.attr-code = "time-income"     no-error.
     5954       if p-mode-attr = "get-attr":U then do:
     5955         if available buf_doc-attr then do:       assign         v-time-income = buf_doc-attr.attr-value       .     end.
     5956       end.
     5957           find first buf_doc-attr     where buf_doc-attr.doc-code  = v-doc-code       and buf_doc-attr.attr-code = "fio-driver"     no-error.
     5958       if p-mode-attr = "get-attr":U then do:
     5959               if available buf_doc-attr then do:       assign         v-fio = buf_doc-attr.attr-value       .     end.
     5960       end.
     5961       else do:
     5962       end.
     5963           find first buf_doc-attr     where buf_doc-attr.doc-code  = v-doc-code       and buf_doc-attr.attr-code = "ptbobj"     no-error.
     5964       if p-mode-attr = "get-attr":U then do:
     5965               assign
     5966           v-ptbotype = entry (1, buf_doc-attr.attr-value, ";")
     5967         no-error.
     5968       end.
     5969       else do:
     5970       end.
     5971           find first buf_doc-attr     where buf_doc-attr.doc-code  = v-doc-code       and buf_doc-attr.attr-code = "ptbobj"     no-error.
     5972       if p-mode-attr = "get-attr":U then do:
     5973               assign
     5974           v-ptbocode = entry (2, buf_doc-attr.attr-value, ";")
     5975         no-error.
     5976       end.
     5977       else do:
     5978       end.
     5979           find first buf_doc-attr     where buf_doc-attr.doc-code  = v-doc-code       and buf_doc-attr.attr-code = "time-pour"     no-error.
     5980       if p-mode-attr = "get-attr":U then do:
     5981               assign
     5982           v-time-pour = buf_doc-attr.attr-value
     5983         no-error.
     5984       end.
     5985       else do:
     5986       end.
     5987           find first buf_doc-attr     where buf_doc-attr.doc-code  = v-doc-code       and buf_doc-attr.attr-code = "doc-not"     no-error.
     5988       if p-mode-attr = "get-attr":U then do:
     5989               assign
     5990           v-doc-not = logical(buf_doc-attr.attr-value)
     5991         no-error.
     5992       end.
     5993       else do:
     5994       end.
     5995           find first buf_doc-attr     where buf_doc-attr.doc-code  = v-doc-code       and buf_doc-attr.attr-code = "spisok-not-doc"     no-error.
     5996       if p-mode-attr = "get-attr":U then do:
     5997               assign
     5998           v-spisok-not-doc = buf_doc-attr.attr-value
     5999         no-error.
     6000       end.
     6001       else do:
     6002       end.
     6003               assign         v-car-vol = string(v-InfoSectionsTotal:GetInfoSectionProp(iNum):CarVol)      .
     6004               assign         v-dens-temp = string(v-InfoSectionsTotal:GetInfoSectionProp(iNum):DensTemp)      .
     6005               assign         v-tank-vol-pomi = string(v-InfoSectionsTotal:GetInfoSectionProp(iNum):TankVolPomi)      .
     6006               assign         v-tank-density-pomi = string(v-InfoSectionsTotal:GetInfoSectionProp(iNum):TankDensityPomi)      .
     6007               assign         v-place-si = string(v-InfoSectionsTotal:GetInfoSectionProp(iNum):PlaceSi)      .
     6008               assign         v-tests = string(v-InfoSectionsTotal:GetInfoSectionProp(iNum):Tests)      .
     6009               assign         v-certif-fuel = string(v-InfoSectionsTotal:GetInfoSectionProp(iNum):CertifFuel)      .
     6010               assign         v-norm-doc = string(v-InfoSectionsTotal:GetInfoSectionProp(iNum):NormDoc)      .
     6011               assign         v-num-passport = string(v-InfoSectionsTotal:GetInfoSectionProp(iNum):NumPassport)      .
     6012               assign         v-validity-certif = string(v-InfoSectionsTotal:GetInfoSectionProp(iNum):ValidityCertif)      .
     6013               assign         v-num-plotn = string(v-InfoSectionsTotal:GetInfoSectionProp(iNum):NumPlotn)      .
     6014               assign         v-passport-plotn = string(v-InfoSectionsTotal:GetInfoSectionProp(iNum):PassportPlotn)      .
     6015               assign         v-date-pov-plotn = v-InfoSectionsTotal:GetInfoSectionProp(iNum):DatePovPlotn      .
     6016               assign         v-date-start = v-InfoSectionsTotal:GetInfoSectionProp(iNum):DateStart      .
     6017               assign         v-time-start = v-InfoSectionsTotal:GetInfoSectionProp(iNum):TimeStart      .
     6018               assign         v-date-end = v-InfoSectionsTotal:GetInfoSectionProp(iNum):DateEnd      .
     6019               assign         v-time-end = v-InfoSectionsTotal:GetInfoSectionProp(iNum):TimeEnd      .
     6020               assign         v-tank-vol = string(v-InfoSectionsTotal:GetInfoSectionProp(iNum):TankVol)      .
     6021               assign         v-tank-temp = string(v-InfoSectionsTotal:GetInfoSectionProp(iNum):TankTemp)      .
     6022               assign         v-tank-water = string(v-InfoSectionsTotal:GetInfoSectionProp(iNum):TankWater)      .
     6023               assign         v-tank-density = string(v-InfoSectionsTotal:GetInfoSectionProp(iNum):TankDensity)      .
     6024               assign         v-tank-weight = string(v-InfoSectionsTotal:GetInfoSectionProp(iNum):TankWeight)      .
     6025               assign         v-mouth = string(v-InfoSectionsTotal:GetInfoSectionProp(iNum):Mouth)      .
     6026               assign         v-a-b-tarir = string(v-InfoSectionsTotal:GetInfoSectionProp(iNum):ABTarir)      .
     6027       return .
     6028     end.
     6029   end procedure.
     6030   procedure proc-calc-library-pomi:
     6031       define input parameter p-car-vol as decimal no-undo.
     6032       define input parameter p-tank-vol as decimal no-undo.
     6033       define input parameter p-a-b-tarir as decimal no-undo.
     6034       define input parameter p-diameter as decimal no-undo.
     6035       define input parameter p-tank-temp as decimal no-undo.
     6036       define input parameter p-tank-density as decimal no-undo.
     6037       define input parameter p-dens-temp as decimal no-undo.
     6038       define input parameter p-place-si as integer no-undo.
     6039       define input parameter p-doc-code like ub.trn-doc.doc-code no-undo.
     6040       define input parameter p-gds-code like ub.goods.gds-code no-undo.
     6041       define output parameter p-tank-density-pomi as decimal no-undo.
     6042       define output parameter p-tank-vol-pomi as decimal no-undo.
     6043       define output parameter p-tank-weight as decimal no-undo.
     6044       define variable ToolType as integer no-undo.
     6045       define variable DeltaAbs_R as decimal no-undo.
     6046       define variable DeltaAbs_Tv as decimal no-undo.
     6047       define variable DeltaAbs_Tr as decimal no-undo.
     6048       define variable temp-for-pomi as integer no-undo.
     6049       define variable error-string as character no-undo.
     6050       define variable v-mm as com-handle.
     6051       define variable v-proc as character no-undo.
     6052       define variable v-gds-attr-value as character no-undo.
     6053       define variable v-gds-attr-type as character no-undo.
     6054       define variable v-fuel-type as character no-undo.
     6055       define variable rdc-dnstvalue as character no-undo.
     6056       define variable rdc-dnsttype as character no-undo.
     6057       define buffer buf_clob-bind for ub.clob-bind.
     6058       run gbl/conf-rd.p ("rdc-dnst", "", "", 0, "", "", "", no, output rdc-dnstvalue, output rdc-dnsttype) no-error.
     6059       case rdc-dnstvalue:
     6060           when "pomi-rn" then
     6061           do:
     6062               _trpomi:
     6063                   do on error undo, return no-apply:
     6064                       run sr-izmerenia_fill-sr-izm in this-procedure (input 'ПРОСМОТР':U, buffer buf_clob-bind).
     6065                       find first sr-izmerenia no-lock where sr-izmerenia.node-code = p-place-si no-error.
     6066                       if error-status :error or not available sr-izmerenia then
     6067                       do:
     6068                           message
     6069                               substitute('Не найдено средство измерения с кодом &1', p-place-si) skip
     6070                           view-as alert-box error.
     6071                           undo _trpomi, return no-apply.
     6072                       end.
     6073                       else
     6074                       do:
     6075                           assign
     6076                               ToolType = sr-izmerenia.sr-type-id
     6077                               DeltaAbs_R = sr-izmerenia.sr-abs-err-dens
     6078                               DeltaAbs_Tv = sr-izmerenia.sr-abs-err-temp-vol
     6079                               DeltaAbs_Tr = sr-izmerenia.sr-abs-err-temp-dens
     6080                           .
     6081                       end.
     6082                       find first ub.trn-doc no-lock where ub.trn-doc.doc-code = p-doc-code no-error.
     6083   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6084   run get-ptrl-prop in this-procedure
     6085     ( input trn-doc.obj-type
     6086     , input trn-doc.obj-code
     6087     ) .
     6088                       if not error-status :error then
     6089                       do:
     6090                           if ptrlprop-temp-for-pomi = 1 then temp-for-pomi = 15.
     6091                                                         else temp-for-pomi = 20.
     6092                       end.
     6093                       v-proc = "ADMM.MethodOfMetering31N" .
     6094                       release object v-mm no-error.
     6095                       v-mm = ?.
     6096                       create value("ADMM.MethodOfMetering31N") v-mm no-error.
     6097                       if error-status:error or not valid-handle(v-mm) then
     6098                       do:
     6099                           release object v-mm no-error.
     6100                           v-mm = ?.
     6101                           message
     6102                               substitute('Не удается подключиться к COM-серверу библиотеки для работы с ПО МИ ') skip
     6103                           view-as alert-box error.
     6104                           undo _trpomi, return no-apply.
     6105                       end.
     6106                       else
     6107                       do:
     6108                               v-mm:V_real         = if p-car-vol <> ? then p-car-vol else 0.
     6109                               v-mm:DeltaH         = if p-a-b-tarir <> ? then p-a-b-tarir else 0 .
     6110                               v-mm:Dgor           = if p-diameter <> ? then p-diameter else 0 .
     6111                               v-mm:Tv             = if p-tank-temp <> ? then p-tank-temp else 0 .
     6112                               v-mm:Tr             = if p-dens-temp <> ? then p-dens-temp else 0 .
     6113                               v-mm:R              = if p-tank-density <> ? then (p-tank-density * 1000) else 0 .
     6114                               v-mm:Tcy            = if temp-for-pomi <> ? then temp-for-pomi else 0 .
     6115                               v-mm:ToolType       = if ToolType <> ? then ToolType else 0 .
     6116                               v-mm:DeltaOtn_V     = 0.4 .
     6117                               v-mm:DeltaAbs_R     = if DeltaAbs_R <> ? then DeltaAbs_R else 0 .
     6118                               v-mm:DeltaAbs_Tv    = if DeltaAbs_Tv <> ? then DeltaAbs_Tv else 0 .
     6119                               v-mm:DeltaAbs_Tr    = if DeltaAbs_Tr <> ? then DeltaAbs_Tr else 0 .
     6120                           .
     6121                           v-mm:Exec().
     6122                           if v-mm:Result <> 0 then
     6123                           do:
     6124                               error-string = v-mm:ResultDetail.
     6125                               release object v-mm no-error.
     6126                               v-mm = ?.
     6127                               message
     6128                                   substitute('Ошибка работы библиотеки ПО МИ &1',error-string)
     6129                               view-as alert-box error.
     6130                               undo _trpomi, return no-apply.
     6131                           end.
     6132                           else
     6133                           do:
     6134                               assign
     6135                                   p-tank-density-pomi = decimal(v-mm:Rcy) / 1000
     6136                                   p-tank-vol-pomi = v-mm:Vcy
     6137                                   p-tank-weight = v-mm:Mcy
     6138                               .
     6139                               release object v-mm no-error.
     6140                               v-mm = ?.
     6141                           end.
     6142                       end.
     6143                   end.
     6144           end.
     6145           when "th" then
     6146           do:
     6147               run gds-attr-value in this-procedure
     6148                   (  input p-gds-code
     6149                   ,  input 'fuel-type':U
     6150                   , output v-gds-attr-value
     6151                   , output v-gds-attr-type
     6152                   ) no-error.
     6153               if not error-status:error and lookup (v-gds-attr-value, "petrol,diesel-sum,diesel-wint") > 0 then
     6154               do:
     6155                   assign v-fuel-type = v-gds-attr-value.
     6156                   run str/rdcdnst.p (input p-tank-density * 1000
     6157                       ,input p-dens-temp
     6158                       ,input p-tank-vol
     6159                       ,input p-tank-temp
     6160                       ,input v-fuel-type
     6161                       ,output p-tank-density-pomi
     6162                       ,output p-tank-vol-pomi)
     6163                   no-error.
     6164                   if not error-status:error then
     6165                   do:
     6166                       assign p-tank-weight = p-tank-density-pomi * p-tank-vol-pomi.
     6167                   end.
     6168                   else
     6169                   do:
     6170                       message
     6171                           substitute('Ошибка при рассчете приведенных значений плотности и объема: &1', return-value)
     6172                       view-as alert-box error.
     6173                       undo, return no-apply.
     6174                   end.
     6175               end.
     6176               else
     6177               do:
     6178                   message
     6179                       substitute('Ошибка определения типа топлива &1 или не верный тип товлива &2', return-value, v-gds-attr-value)
     6180                   view-as alert-box error.
     6181                   undo, return no-apply.
     6182               end.
     6183           end.
     6184       end case.
     6185   end procedure.
     6186   procedure proc-get-address:
     6187       define input parameter p-cli-obj-type like clients.obj-type no-undo.
     6188       define input parameter p-cli-obj-code like clients.obj-code no-undo.
     6189       define output parameter p-str-address as character no-undo.
     6190       p-cli-obj-type = trim(p-cli-obj-type).
     6191       case p-cli-obj-type:
     6192           when 'орг':U then
     6193           do:
     6194               find first firm where firm.firm-code = p-cli-obj-code no-lock.
     6195               if available firm then
     6196               do:
     6197                   p-str-address =
     6198                   (if trim(firm.post-addr1) = "" then (if trim(firm.post-addr2) = "" then "" else trim(firm.post-addr2) + ".")
     6199                   else (if trim(firm.post-addr2) = "" then trim(firm.post-addr1) + "."
     6200                         else trim(firm.post-addr1) + ", " + trim(firm.post-addr2) + ".")).
     6201               end.
     6202           end.
     6203           when 'маг':U then
     6204           do:
     6205               find first shop where shop.obj-code = p-cli-obj-code no-lock.
     6206                   if available shop then
     6207                   do:
     6208                       p-str-address =
     6209                       (if trim(shop.addres1) = "" then
     6210                           (if trim(shop.addres2) = "" then "" else trim(shop.addres2) + ".")
     6211                        else (if trim(shop.addres2) = "" then trim(shop.addres1) + "."
     6212                              else trim(shop.addres1) + ", " + trim(shop.addres2) + ".")).
     6213                   end.
     6214               end.
     6215           when 'скл':U then
     6216           do:
     6217               find first store where store.obj-code = p-cli-obj-code no-lock.
     6218               if available store then
     6219               do:
     6220                   p-str-address =
     6221                   (if trim(store.addres1) = "" then (if trim(store.addres2) = "" then ""
     6222                                                     else ", " + trim(store.addres2) + ".")
     6223                   else (if trim(store.addres2) = "" then ", " + trim(store.addres1) + "."
     6224                         else ", " + trim(store.addres1) + trim(store.addres2) + ".")).
     6225               end.
     6226           end.
     6227           when 'чел':U then
     6228           do:
     6229               find first person where person.psn-code = p-cli-obj-code no-lock.
     6230               if available person then
     6231               do:
     6232                   p-str-address =
     6233                   (if trim(person.address) = ""  then "" else trim(person.address) + ".").
     6234               end.
     6235           end.
     6236       end case.
     6237   end procedure.
     6238   function fnc-convert-dot-to-colon returns character
     6239   (input p-data as decimal, input p-accur as character):
     6240           define variable result as character no-undo.
     6241       define variable v-str-result as character no-undo.
     6242       p-data = round(p-data, 4).
     6243       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     6244           return v-str-result.
     6245   end function.
     6246   function fnc-DD-MM-YYYY returns character
     6247   (input p-dat-date as date):
     6248       define variable result as character no-undo.
     6249       define variable p-str-date as character no-undo.
     6250       p-str-date = replace(string(p-dat-date,'99.99.9999'), "/", ".").
     6251                   return p-str-date.
     6252   end function.
