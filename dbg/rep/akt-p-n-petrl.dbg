     4856   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4857   define new global shared variable g#lib-calc as handle no-undo .
     4858   FUNCTION MonthNameRusCase RETURNS CHARACTER ( INPUT i-month AS INTEGER, INPUT i-case AS INTEGER ) :
     4859     DEFINE VARIABLE v-name AS CHARACTER NO-UNDO.
     4860     RUN get-month-name-case IN THIS-PROCEDURE ( INPUT i-month, INPUT i-case, OUTPUT v-name ) NO-ERROR.
     4861     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-name ).
     4862   END FUNCTION.
     4863   PROCEDURE get-month-name-case :
     4864     DEFINE  INPUT PARAMETER p-month AS INTEGER   NO-UNDO.
     4865     DEFINE  INPUT PARAMETER p-case  AS INTEGER   NO-UNDO.
     4866     DEFINE OUTPUT PARAMETER p-name  AS CHARACTER NO-UNDO.
     4867     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO EXTENT 6 INITIAL
     4868       [ "Январь,Февраль,Март,Апрель,Май,Июнь,Июль,Август,Сентябрь,Октябрь,Ноябрь,Декабрь",
     4869         "января,февраля,марта,апреля,мая,июня,июля,августа,сентября,октября,ноября,декабря",
     4870         "Январю,Февралю,Марту,Апрелю,Маю,Июню,Июлю,Августу,Сентябрю,Октябрю,Ноябрю,Декабрю",
     4871         "Январь,Февраль,Март,Апрель,Май,Июнь,Июль,Август,Сентябрь,Октябрь,Ноябрь,Декабрь",
     4872         "Январем,Февралем,Мартом,Апрелем,Маем,Июнем,Июлем,Августом,Сентябрем,Октябрем,Ноябрем,Декабрем",
     4873         "Январе,Феврале,Марте,Апреле,Мае,Июне,Июле,Августе,Сентябре,Октябре,Ноябре,Декабре"              ].
     4874     DO ON ERROR UNDO, RETURN ERROR :
     4875       IF p-month < 1 OR p-month > 12 OR
     4876          p-case  < 1 OR p-case  >  6 THEN DO:
     4877         ASSIGN p-name = ?.
     4878       END.                           ELSE DO:
     4879         ASSIGN p-name = ENTRY( p-month, v-list[ p-case ] ).
     4880       END.
     4881     END.
     4882   END PROCEDURE.
     4883   define variable g#report-num    as integer      no-undo .
     4884   define variable g#quest-print   as logical      no-undo .
     4885   define variable g#log           as logical      no-undo .
     4886   define variable vss-include-info24 as character format "X(65)" no-undo
     4887   initial "@(#)$Workfile$ $Revision$".
     4888   define stream excel-line .
     4889   define stream excel-cell .
     4890   define temp-table temp_cell-data no-undo
     4891       field data-key   as character
     4892       field data-value as character
     4893       index pi is primary unique data-key
     4894   .
     4895   define variable v-apn-xl-cell-file-name  as character    no-undo .
     4896   define variable v-apn-xl-data-file-name  as character    no-undo .
     4897   procedure apn-xl-init :
     4898   do
     4899   on error undo, return error
     4900   :
     4901           run gbl/_tmpfile.p (
     4902             input "xd"
     4903           , input ".txt"
     4904           , output v-apn-xl-data-file-name
     4905       ).
     4906       output stream excel-line to value( v-apn-xl-data-file-name ).
     4907       run gbl/_tmpfile.p (
     4908             input "xc"
     4909           , input ".txt"
     4910           , output v-apn-xl-cell-file-name
     4911       ).
     4912       output stream excel-cell to value( v-apn-xl-cell-file-name ).
     4913       run apn-xl-write-cell-data in this-procedure (
     4914             input "valutCode":U
     4915           , input "0":U
     4916       ).
     4917       run apn-xl-write-cell-data in this-procedure (
     4918             input "columnList":U
     4919           , input "":U
     4920       ).
     4921       run apn-xl-write-cell-data in this-procedure (
     4922             input "columnType":U
     4923           , input "":U
     4924       ).
     4925       run apn-xl-write-cell-data in this-procedure (
     4926             input "columnAmount":U
     4927           , input "0":U
     4928       ).
     4929   end.
     4930   end procedure.
     4931   procedure apn-xl-write-cell-data :
     4932   define input parameter p-data-key   as character        no-undo.
     4933   define input parameter p-data-value as character        no-undo.
     4934       define buffer buf_temp_cell-data     for temp_cell-data.
     4935   do
     4936   for buf_temp_cell-data
     4937   on error undo, return error
     4938   :
     4939       find first buf_temp_cell-data
     4940            where buf_temp_cell-data.data-key = p-data-key
     4941       no-error.
     4942       if not available buf_temp_cell-data
     4943       then do:
     4944           create buf_temp_cell-data.
     4945           assign
     4946               buf_temp_cell-data.data-key = p-data-key
     4947           .
     4948       end.
     4949       assign
     4950           buf_temp_cell-data.data-value = p-data-value
     4951       .
     4952       put stream excel-cell unformatted
     4953                           buf_temp_cell-data.data-key
     4954           chr(9)   buf_temp_cell-data.data-value
     4955           chr(10)
     4956       .
     4957   end.
     4958   end procedure.
     4959   procedure apn-xl-run-excel :
     4960   define input parameter p-header-filename    as character    no-undo .
     4961   define input parameter p-data-filename      as character    no-undo .
     4962   define variable v-template-file-name        as character    no-undo .
     4963   define variable v-vb-file-name              as character    no-undo .
     4964       define buffer buf_temp-param for temp-param .
     4965   do
     4966   for buf_temp-param
     4967   on error undo, return error
     4968   :
     4969       create buf_temp-param.
     4970       assign
     4971           v-template-file-name    = search( "exe/akt-p-n-petrl.xlt" )
     4972           v-vb-file-name          = search( "exe/akt-p-n-petrl.bas")
     4973       .
     4974       if v-template-file-name = ?
     4975       or v-template-file-name = "":U
     4976       then do:
     4977           message
     4978               "Ошибка имени файла шаблона."
     4979           view-as alert-box error.
     4980       end.
     4981       if v-vb-file-name = ?
     4982       or v-vb-file-name = "":U
     4983       then do:
     4984           message
     4985               "Ошибка имени файла кода обработки."
     4986           view-as alert-box error.
     4987       end.
     4988       run paramls-write in this-procedure (
     4989             input "template":U
     4990           , input "template-file-name":U
     4991           , input v-template-file-name
     4992       ).
     4993       run paramls-write in this-procedure (
     4994             input "template":U
     4995           , input "vb-file-name":U
     4996           , input v-vb-file-name
     4997       ).
     4998       run paramls-write in this-procedure (
     4999             input "data":U
     5000           , input "data-header-filename":U
     5001           , input p-header-filename
     5002       ).
     5003       run paramls-write in this-procedure (
     5004             input "data":U
     5005           , input "data-filename":U
     5006           , input p-data-filename
     5007       ).
     5008       run gbl/macroxlt.p (
     5009           input-output table buf_temp-param
     5010       ) no-error.
     5011       if error-status :error
     5012       then do:
     5013           message
     5014                    vss-workfile vss-revision vss-description
     5015               skip(1)
     5016               skip "Ошибка создания файла Excel."
     5017               skip return-value
     5018               skip trim(error-status :get-message(1))
     5019                    trim(error-status :get-message(2))
     5020                    trim(error-status :get-message(3))
     5021           view-as alert-box error.
     5022           undo, return error .
     5023       end.
     5024   end.
     5025   end procedure.
     5026   procedure apn-xl-close :
     5027   do
     5028   on error undo, return error
     5029   :
     5030       output stream excel-line close.
     5031       output stream excel-cell close.
     5032       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     5033           export "exe/akt-p-n-petrl.xlt":U.
     5034           export "exe/akt-p-n-petrl.bas":U.
     5035           export v-apn-xl-cell-file-name.
     5036           export v-apn-xl-data-file-name.
     5037       output close.
     5038   end.
     5039   end procedure.
