     3883             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
     3884               assign
     3885                 ptrlprop-Delta-mass-vert = thbjattr_thbj-attr.property-value-character
     3886               .
     3887             end.
     3888           end.
     3889           when 'calc-free-vol':U then do:
     3890             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     3891               assign
     3892                 ptrlprop-calc-free-vol = thbjattr_thbj-attr.property-value-logical
     3893               .
     3894             end.
     3895           end.
     3896           when 'calc-free-vol-sug':U then do:
     3897             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     3898               assign
     3899                 ptrlprop-calc-free-vol-sug = thbjattr_thbj-attr.property-value-logical
     3900               .
     3901             end.
     3902           end.
     3903           when 'trn-reas-sug':U then do:
     3904             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     3905               assign
     3906                 ptrlprop-trn-reas-sug = thbjattr_thbj-attr.property-value-logical
     3907               .
     3908             end.
     3909           end.
     3910                 when 'rvd-own-nb':U then do:
     3911             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     3912               assign
     3913                 ptrlprop-rvd-own-nb = thbjattr_thbj-attr.property-value-logical
     3914               .
     3915             end.
     3916           end.
     3917           when 'qr-scan-time':U then do:
     3918             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     3919               assign
     3920                 ptrlprop-qr-scan-time = thbjattr_thbj-attr.property-value-integer
     3921               .
     3922             end.
     3923           end.
     3924           when 'autopump-skip-time':U then do:
