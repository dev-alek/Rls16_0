     3665   define dataset sr-izmerenia-ds for sr-izmerenia.
     3666   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3667   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile: sr-izm.i $ $Revision: 0425b3e124f6, 2861, rls $".
     3668   procedure sr-izmerenia_fill-sr-izm :
     3669   define input parameter p-mode as character no-undo .
     3670   define parameter buffer buf_clob-bind for ub.clob-bind.
     3671   define buffer buf_clob-data for ub.clob-data.
     3672   define variable v-longchar as longchar no-undo .
     3673   define variable glog as logical no-undo .
     3674   case p-mode:
     3675     when  'ИЗМЕНЕНИЕ':U then do:
     3676      find first buf_clob-bind exclusive-lock where
     3677               buf_clob-bind.resource-type = 'ref':U
     3678          and buf_clob-bind.uniq-key-rec = "sr-izmerenia.xml"
     3679          and buf_clob-bind.field-name = "" no-error.
     3680     end.
     3681     otherwise do:
     3682       find first buf_clob-bind no-lock where
     3683               buf_clob-bind.resource-type = 'ref':U
     3684          and buf_clob-bind.uniq-key-rec = "sr-izmerenia.xml"
     3685          and buf_clob-bind.field-name = "" no-error.
     3686     end.
     3687   end case.
     3688   if available buf_clob-bind then do:
     3689     find first buf_clob-data no-lock where
     3690               buf_clob-data.db-num = buf_clob-bind.db-num
     3691           and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
     3692     if available buf_clob-data then do:
     3693       v-longchar = buf_clob-data.cdata.
     3694       glog = DATASET sr-izmerenia-ds:HANDLE:read-XML("LONGCHAR"
     3695                                                     , v-longchar
     3696                                                     , "EMPTY"
     3697                                                     , ?
     3698                                                     , ?
     3699                                                     , ?
     3700                                                     , "loose"   )  no-error .
     3701       if error-status:error
     3702       or not glog then do:
     3703         MESSAGE
     3704         "НЕ удается прочитать справочник из БД " skip
     3705         ERROR-STATUS:GET-MESSAGE(1) SKIP
     3706         RETURN-VALUE
     3707         VIEW-AS ALERT-BOX ERROR.
     3708         UNDO, RETURN ERROR.
     3709       end.
     3710     end.
     3711   end.
     3712   end procedure.
     3713   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3714   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3715   define variable ptrlprop-denstclc      as character no-undo initial 'shft_rvs-inc':U .
     3716   define variable ptrlprop-inpptrl       as character no-undo initial 'weight':U .
     3717   define variable ptrlprop-expptrl       as character no-undo initial 'volume':U .
     3718   define variable ptrlprop-autopump      as logical   no-undo initial false .
     3719   define variable ptrlprop-avtinvpm      as logical   no-undo initial false .
     3720   define variable ptrlprop-rvsnmter      as logical   no-undo initial false .
     3721   define variable ptrlprop-olddens       as logical   no-undo initial false .
     3722   define variable ptrlprop-invclipt      as integer   no-undo initial ? .
     3723   define variable ptrlprop-algrvspt      as integer   no-undo initial 1 .
     3724   define variable ptrlprop-temp-for-pomi as integer   no-undo initial 1 .
     3725   define variable ptrlprop-algoincome as integer no-undo init 0.
     3726   define variable ptrlprop-mand-choice-autocar as logical no-undo init false.
