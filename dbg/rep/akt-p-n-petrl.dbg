     3737   procedure get-ptrl-prop :
     3738     define input  parameter p-obj-type as character no-undo .
     3739     define input  parameter p-obj-code as integer   no-undo .
     3740     do
     3741     on error  undo, return error substitute( "&1 (get-ptrl-prop). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     3742     on stop   undo, return error substitute( "&1 (get-ptrl-prop). stop", vss-workfile )
     3743     on endkey undo, return error substitute( "&1 (get-ptrl-prop). endkey", vss-workfile )
     3744     :
     3745       define variable par-type          as character no-undo.
     3746       define variable v-value-character as character no-undo .
     3747       define variable v-value-date      as date      no-undo .
     3748       define variable v-value-decimal   as decimal   no-undo .
     3749       define variable v-value-integer   as integer   no-undo .
     3750       define variable v-value-logical   as logical   no-undo .
     3751       for each thbjattr_thbj-attr
     3752       :
     3753         delete thbjattr_thbj-attr .
     3754       end.
     3755       run adm/shattri.p
     3756         ( input "get":U
     3757         , input p-obj-type
     3758         , input p-obj-code
     3759         , input 'petrol':U
     3760         , input  ""
     3761         , output v-value-character
     3762         , output v-value-date
     3763         , output v-value-decimal
     3764         , output v-value-integer
     3765         , output v-value-logical
     3766         , output par-type
     3767         , input-output table thbjattr_thbj-attr
     3768         ) no-error .
     3769       for each thbjattr_thbj-attr
     3770       on error undo, return error return-value
     3771       :
     3772         case thbjattr_thbj-attr.prop-code :
     3773           when 'denstclc':U then do:
     3774             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
     3775               assign
     3776                 ptrlprop-denstclc = thbjattr_thbj-attr.property-value-character
     3777               .
     3778             end.
     3779           end.
     3780           when 'expptrl':U then do:
     3781             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
     3782               and thbjattr_thbj-attr.prop-value-type = 'character':U
     3783             then do:
     3784               assign
     3785                 ptrlprop-expptrl = thbjattr_thbj-attr.property-value-character
     3786               .
     3787             end.
     3788           end.
     3789           when 'inpptrl':U then do:
     3790             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
     3791               and thbjattr_thbj-attr.prop-value-type = 'character':U
     3792             then do:
     3793               assign
     3794                 ptrlprop-inpptrl = thbjattr_thbj-attr.property-value-character
     3795               .
     3796             end.
     3797           end.
     3798           when 'autopump':U then do:
     3799             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     3800               assign
     3801                 ptrlprop-autopump = thbjattr_thbj-attr.property-value-logical
     3802               .
     3803             end.
     3804           end.
     3805           when 'rvsnmter':U then do:
     3806             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     3807               assign
     3808                 ptrlprop-rvsnmter = thbjattr_thbj-attr.property-value-logical
     3809               .
     3810             end.
     3811           end.
     3812           when 'avtinvpm':U then do:
     3813             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     3814               assign
     3815                 ptrlprop-avtinvpm = thbjattr_thbj-attr.property-value-logical
     3816               .
     3817             end.
     3818           end.
     3819           when 'invclipt':U then do:
     3820             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     3821               assign
     3822                 ptrlprop-invclipt = thbjattr_thbj-attr.property-value-integer
     3823               .
     3824             end.
     3825           end.
     3826           when 'olddens':U then do:
