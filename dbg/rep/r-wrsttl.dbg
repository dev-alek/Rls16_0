      571   define variable var-report-r-b as character no-undo .
      572   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      573   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      574     (output var-report-r-b
      575     )  .
      576   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      577   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      578   define  shared variable RepPathName        as character no-undo .
      579   define  shared variable PrintRubl          as logical   no-undo .
      580   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      581   define variable v-waitfram-action01         as character   no-undo .
      582   define variable v-waitfram-action02         as character   no-undo .
      583   define variable v-waitfram-action03         as character   no-undo .
      584   define variable mWaitFramTextBeg            as character   no-undo.
      585   define variable mWaitFramTextEnd            as character   no-undo.
      586   define variable mWaitFramView               as logical     no-undo.
      587   define variable mWaitProcEvent              as logical     no-undo init yes.
      588   define variable mWaitFramInterval           as integer     no-undo init 1 .
      589   define variable mWaitFramStop               as logical     no-undo.
      590   define variable mWaitFramStopUser           as logical     no-undo.
      591   define variable mWaitFramStopTimeOut        as logical     no-undo.
      592   define variable mWaitFramStartProc          as datetime-tz no-undo.
      593   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      594   define button B-WaitFramStop auto-end-key
      595        label "Стоп"
      596        size 10 by 1 tooltip "Остоновить процесс".
      597   define button B-viewProcInfo
      598        label "Информация"
      599        size 15 by 1 tooltip "Информация о процесс".
      600   define frame waitfram
      601     v-waitfram-action01 format "x(72)" no-label skip
      602     v-waitfram-action02 format "x(72)" no-label skip
      603     v-waitfram-action03 format "x(72)" no-label skip
      604     B-viewProcInfo
      605     B-WaitFramStop at row 4 col 30
      606     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      607     .
      608   define new global shared variable mBatchMode as logical no-undo init ?.
      609   define variable mFramBachModHandle as handle no-undo.
      610   mFramBachModHandle = frame waitfram:handle.
      611   define variable mFameOldVis as logical no-undo.
      612   define variable mVisCUrentVin as logical no-undo.
      613   if session:batch-mode
      614   then
      615      mBatchMode = yes.
      616   if mBatchMode = ? then do:
      617     mVisCUrentVin = current-window:visible.
      618     mFameOldVis = mFramBachModHandle:visible.
      619     mFramBachModHandle:visible  = yes.
      620     mBatchMode = mFramBachModHandle:visible ne yes.
      621     mFramBachModHandle:visible = mFameOldVis.
      622     current-window:visible = mVisCUrentVin.
      623   end.
      624    if  log-manager:logfile-name ne ?
      625     then DO:
      626         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      627         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      628         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      629     end.
      630   on choose of B-WaitFramStop in frame waitfram
      631   do:
      632     mWaitFramStop = yes.
      633     mWaitFramStopUser = yes.
      634   end.
      635   function waitfram-check-timeout returns logical():
      636      define variable vtime as int64 no-undo.
      637      if mWaitFramStopTimeOut
      638      then
      639         return yes.
      640      vtime = ( now - mWaitFramStartProc ) / 1000 .
      641      if     mWaitFramTimeOut ne ?
      642         and mWaitFramTimeOut ne 0
      643         and mWaitFramTimeOut lt vtime
      644      then do:
      645         mWaitFramStopTimeOut = yes.
      646      end.
      647      return mWaitFramStopTimeOut.
      648   end.
      649   procedure waitfram-hide :
      650     if not session:batch-mode
      651     then do
      652     on error undo, return error return-value
      653     :
      654       pause 0 before-hide .
      655       if not mBatchMode then
      656         hide frame waitfram .
      657     if     not mWaitFramView
      658        and mWaitProcEvent
      659     then
      660       process events .
      661     end.
      662   end procedure.
      663   procedure waitfram-show :
      664     define input  parameter p-message as character no-undo .
      665     define variable v-left-margin as integer   no-undo .
      666     if not session:batch-mode
      667     then do
      668     on error undo, return error return-value
      669     :
      670       if length(p-message) <= 70 then do:
      671         assign
      672           v-left-margin = integer((70 - length(p-message)) / 2)
      673         .
      674         assign
      675           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      676         .
      677         assign
      678           v-waitfram-action01 = " "
      679           v-waitfram-action02 = " "
      680                                    + fill(" ", v-left-margin)
      681                                    + p-message
      682           v-waitfram-action03 = " "
      683         .
      684       end.
      685       else do:
      686         define variable vRindex1 as integer no-undo.
      687         define variable vRindex2 as integer no-undo.
      688         vRindex1 = r-index(p-message," ",70).
      689         if vRindex1 = 0
      690         then
      691            vRindex1 = 70.
      692         if length(p-message)  <= vRindex1 + 70 then do:
      693           assign
      694             v-waitfram-action01 = " "
      695             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      696             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      697           .
      698         end.
      699         else do:
      700           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      701           if vRindex2 <= vRindex1
      702           then
      703              vRindex2 = vRindex1 + 70.
      704           assign
      705             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      706             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      707             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      708           .
      709         end.
      710       end.
      711       B-viewProcInfo:visible   in frame waitfram = no.
      712       B-viewProcInfo:sensitive in frame waitfram = no.
      713       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      714       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      715       if  (   mWaitFramView
      716          or  mWaitProcEvent)
      717          and not mBatchMode
      718       then
      719          display
      720             v-waitfram-action01 skip
      721             v-waitfram-action02 skip
      722             v-waitfram-action03 skip
      723          with frame waitfram .
      724       if     mWaitFramView
      725          then do:
      726             if     mWaitFramInterval ne ?
      727                and not mBatchMode
      728             then
      729                wait-for go of frame waitfram pause mWaitFramInterval.
      730          end.
      731          else
      732             if     mWaitProcEvent
      733                and not mBatchMode
      734             then
      735                process events .
      736     end.
      737   end procedure.
      738      procedure waitfram-show-this:
      739         define input  parameter iInterval as int64 no-undo.
      740         define variable vtime as int64 no-undo.
      741         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      742         mWaitFramInterval = iInterval.
      743         run waitfram-show (substitute("&1&2 &3&4" ,
      744                                       mWaitFramTextBeg ,
      745                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      746                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      747                                       mWaitFramTextEnd
      748                                      )
      749                           ).
      750      end.
      751      procedure WaitFramRunPause:
      752         define input  parameter iInterval as dec no-undo.
      753         define variable vStart  as datetime-tz no-undo.
      754         define variable vend    as datetime-tz no-undo.
      755         define variable vint as int64 no-undo.
      756         define variable vOk as logical no-undo.
      757         vStart = now.
      758         vend   = vStart.
      759         publish "WaitFramPause" (iInterval,output vOk).
      760         vend   =  now.
      761         vint = vend - vStart.
      762         vint = iInterval - vint / 1000.
      763         if     not mWaitFramStop
      764            and (   vint > 0
      765                 or (    not vOk
      766                     and iInterval eq ?
      767                     )
      768                 )
      769         then
      770            run waitfram-show-this (iInterval).
      771         vend   =  now.
      772         vint = vend - vStart.
      773         vint = iInterval - vint / 1000.
      774         if     not mWaitFramStop
      775            and vint > 0
      776         then do:
      777            run gbl/pause.p (vint * 1000).
      778         end.
      779         if iInterval ne ?
      780         then
      781            publish "WaitFramStop".
      782         waitfram-check-timeout().
      783      end.
      784      procedure WaitFramWaitFor:
      785         define input  parameter iInterval as dec no-undo.
      786         assign
      787            mWaitFramStartProc   = now
      788            mWaitFramStopUser    = no
      789            mWaitFramStopTimeOut = no
      790         .
      791         block-wait:
      792         do while not mWaitFramStop:
      793            run WaitFramRunPause (iInterval).
      794            if  waitfram-check-timeout()
      795            then do:
      796               leave block-wait.
      797            end.
      798         end.
      799         run waitfram-hide.
      800      end.
      801   procedure waitfram-join :
      802     define input  parameter p-line-1  as character no-undo .
      803     define input  parameter p-line-2  as character no-undo .
      804     define input  parameter p-line-3  as character no-undo .
      805     define output parameter p-message as character no-undo .
      806     do
      807     on error undo, return error return-value
      808     :
      809       assign
      810         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      811                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      812                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      813       .
      814     end.
      815   end procedure.
      816   function waitfram-join-function returns character
      817     (input p-line-1 as character
      818     ,input p-line-2 as character
      819     ,input p-line-3 as character
      820     ).
      821     define variable v-message as character no-undo .
      822     run waitfram-join in this-procedure
      823       (input  p-line-1
      824       ,input  p-line-2
      825       ,input  p-line-3
      826       ,output v-message
      827       ) .
      828     return v-message .
      829   end function .
      830   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      831   procedure factord :
      832     define input  parameter p-fact-date            as date    no-undo .
      833     define input  parameter p-fact-time            as integer no-undo .
      834     define input  parameter p-fact-num             as integer no-undo .
      835     define input  parameter p-shift-date           as date    no-undo .
      836     define input  parameter p-shift-num            as integer no-undo .
      837     define input  parameter p-shift-on             as logical no-undo .
      838     define output parameter p-fact-order           as decimal no-undo .
      839     define output parameter p-shift-end-fact-order as decimal no-undo .
      840     define output parameter p-day-end-fact-order   as decimal no-undo .
      841     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      842     if p-fact-date = ?
      843     then do:
      844       return error "Не указана фактическая дата" .
      845     end.
      846     define variable v-fact-date-num as integer no-undo .
      847     assign
      848       v-fact-date-num = integer(p-fact-date)
      849     .
      850     if p-fact-num = ?
      851     or p-fact-num = 0
      852     then do:
      853       return error "Не задан p-fact-num " + string(p-fact-num) .
      854     end.
      855     if p-fact-num < 0
      856     then do:
      857       return error "Отрицательный fact-num " + string(p-fact-num) .
      858     end.
      859     if p-fact-num >= 100000000
      860     then do:
      861       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      862     end.
      863     if p-shift-on = true
      864     then do:
      865       if p-shift-date = ?
      866       then do:
      867         return error "Не задана дата смены" .
      868       end.
      869       if p-shift-num = ?
      870       or p-shift-num = 0
      871       then do:
      872         return error "Не задан номер смены" .
      873       end.
      874     end.
      875     else do:
      876       assign
      877         p-shift-date = p-fact-date
      878         p-shift-num  = 24
      879       .
      880     end.
      881     define variable v-shift-offset as integer no-undo .
      882     if p-shift-date = p-fact-date
      883     then do:
      884       assign
      885         v-shift-offset = 1
      886       .
      887     end.
      888     if p-shift-date < p-fact-date
      889     then do:
      890       assign
      891         v-shift-offset = 0
      892       .
      893     end.
      894     if p-shift-date > p-fact-date
      895     then do:
      896       message
      897         vss-workfile vss-revision vss-description skip
      898         "Неправильная дата закрытия смены" skip
      899         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      900         view-as alert-box error .
      901       undo, return error
      902         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      903           ,string(p-fact-date, '99/99/9999':U)
      904           ,string(p-shift-date, '99/99/9999':U)
      905           )
      906       .
      907     end.
      908     if p-shift-num < 1
      909     or p-shift-num > 24
      910     then do:
      911       message
      912         vss-workfile vss-revision vss-description skip
      913         "Неправильный номер смены" skip
      914         "p-shift-num" p-shift-num skip
      915         view-as alert-box error .
      916       undo, return error return-value .
      917     end.
      918     assign
      919       p-fact-order           = v-fact-date-num
      920                              + v-shift-offset * 0.5
      921                              + p-shift-num    * 0.02 - 0.01
      922                              + p-fact-num     * 0.0000000001
      923       p-shift-end-fact-order = v-fact-date-num
      924                              + v-shift-offset * 0.5
      925                              + p-shift-num    * 0.02
      926       p-day-end-fact-order   = v-fact-date-num
      927                              + 0.99
      928     .
      929     if p-fact-order           <= v-fact-date-num
      930     or p-shift-end-fact-order <= v-fact-date-num
      931     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      932     or p-shift-end-fact-order >= p-day-end-fact-order
      933     then do:
      934       message
      935         vss-workfile vss-revision vss-description skip
      936         "Внутренняя ошибка при генерации фактического номера" skip
      937         "p-fact-date"            p-fact-date            skip
      938         "p-fact-time"            p-fact-time            skip
      939         "p-fact-num"             p-fact-num             skip
      940         "p-shift-date"           p-shift-date           skip
      941         "p-shift-num"            p-shift-num            skip
      942         "p-shift-on"             p-shift-on             skip
      943         "p-shift-end-fact-order" p-shift-end-fact-order skip
      944         "p-day-end-fact-order"   p-day-end-fact-order   skip
      945         "v-fact-date-num"        v-fact-date-num        skip
      946         view-as alert-box error .
      947       undo, return error return-value .
      948     end.
      949   end procedure.
      950   procedure day-begin-fact-order :
      951     define input  parameter p-fact-date            as date    no-undo .
      952     define output parameter p-day-begin-fact-order as decimal no-undo .
      953     do
      954     on error undo, return error return-value
      955     :
      956       if p-fact-date = ?
      957       then do:
      958         assign
      959           p-day-begin-fact-order = 0
      960         .
      961       end.
      962       else do:
      963         assign
      964           p-day-begin-fact-order = integer(p-fact-date)
      965         .
      966       end.
      967     end.
      968   end procedure.
      969   procedure factord-max-fact-order :
      970     define output parameter p-max-fact-order as decimal   no-undo .
      971     do
      972     on error undo, return error return-value
      973     :
      974       run day-begin-fact-order in this-procedure
      975         (input  date(1, 1, 5000)
      976         ,output p-max-fact-order
      977         ) .
      978     end.
      979   end procedure.
      980   procedure factord-cut-archive :
      981     define input  parameter p-obj-type             as character no-undo .
      982     define input  parameter p-obj-code             as integer   no-undo .
      983     define input  parameter p-fact-date            as date      no-undo .
      984     define output parameter p-shift-on             as logical   no-undo .
      985     define output parameter p-shift-date           as date      no-undo .
      986     define output parameter p-shift-num            as integer   no-undo .
      987     define output parameter p-day-end-fact-order   as decimal   no-undo .
      988     define output parameter p-shift-end-fact-order as decimal   no-undo .
      989     define variable v-fact-order as decimal   no-undo .
      990     define buffer buf_shift-obj for ub.shift-obj .
      991     do
      992     on error undo, return error return-value
      993     :
      994   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      995   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      996     (input  p-obj-type
      997     ,input  p-obj-code
      998     ,input  'shift-on=request'
      999     ,output p-shift-on
     1000     ) no-error .
     1001       if error-status :error
     1002       then do:
     1003         message
     1004           vss-workfile vss-revision vss-description skip
     1005           "Ошибка при определении атрибута объекта" skip
     1006           "Объект" p-obj-type p-obj-code skip
     1007           error-status :get-message(1) skip
     1008           return-value skip
     1009           view-as alert-box error .
     1010         undo, return error return-value .
     1011       end.
     1012       if p-shift-on = false
     1013       then do:
     1014         assign
     1015           p-shift-date               = ?
     1016           p-shift-num                = 0
     1017         .
     1018       end.
     1019       else do:
     1020         find first buf_shift-obj share-lock
     1021           where buf_shift-obj.obj-type   = p-obj-type
     1022             and buf_shift-obj.obj-code   = p-obj-code
     1023             and buf_shift-obj.shift-date > p-fact-date
     1024           use-index pi
     1025           no-error .
     1026         if not available buf_shift-obj
     1027         or buf_shift-obj.status_ <> 'зкр':U
     1028         then do:
     1029           message
     1030             vss-workfile vss-revision vss-description skip
     1031             "Невозможно вычислить последнюю смену" skip
     1032             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1033             "Объект" p-obj-type p-obj-code skip
     1034             "Дата" p-fact-date skip
     1035             view-as alert-box error .
     1036           undo, return error return-value .
     1037         end.
     1038         find last buf_shift-obj share-lock
     1039           where buf_shift-obj.obj-type = p-obj-type
     1040             and buf_shift-obj.obj-code = p-obj-code
     1041             and buf_shift-obj.shift-date <= p-fact-date
     1042           use-index pi
     1043           no-error .
     1044         if available buf_shift-obj
     1045         then do:
     1046           if  buf_shift-obj.status_ = 'зкр':U
     1047           then do:
     1048             assign
     1049               p-shift-date = buf_shift-obj.shift-date
     1050               p-shift-num  = buf_shift-obj.shift-num
     1051             .
     1052           end.
     1053           else do:
     1054             message
     1055               vss-workfile vss-revision vss-description skip
     1056               "Невозможно вычислить последнюю смену" skip
     1057               "Статус смены отличен от статуса" 'зкр':U skip
     1058               "Объект" p-obj-type p-obj-code skip
     1059               "Дата" p-fact-date skip
     1060               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1061               view-as alert-box error .
     1062             undo, return error return-value .
     1063           end.
     1064         end.
     1065         else do:
     1066           assign
     1067             p-shift-date = p-fact-date - 1
     1068             p-shift-num  = 1
     1069           .
     1070         end.
     1071       end.
     1072       run factord in this-procedure
     1073         (input  p-fact-date
     1074         ,input  1
     1075         ,input  1
     1076         ,input  p-shift-date
     1077         ,input  p-shift-num
     1078         ,input  p-shift-on
     1079         ,output v-fact-order
     1080         ,output p-shift-end-fact-order
     1081         ,output p-day-end-fact-order
     1082         ) no-error .
     1083       if error-status :error
     1084       then do:
     1085         message
     1086           vss-workfile vss-revision vss-description skip
     1087           "Ошибка при вызове процедуры factord"
     1088           error-status :get-message(1) skip
     1089           return-value skip
     1090           view-as alert-box error .
     1091         undo, return error return-value .
     1092       end.
     1093     end.
     1094   end procedure.
     1095   procedure factord-lock-shift :
     1096     define input  parameter p-obj-type  as character no-undo .
     1097     define input  parameter p-obj-code  as integer   no-undo .
     1098     define input  parameter p-fact-date as date      no-undo .
     1099     define parameter buffer buf_shift-obj for ub.shift-obj .
     1100     define variable v-shift-on      as logical   no-undo .
     1101     define variable v-extra-message as character no-undo .
     1102     define variable v-error as character no-undo .
     1103     do
     1104     on error undo, return error return-value
     1105     :
     1106   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1107   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1108     (input  p-obj-type
     1109     ,input  p-obj-code
     1110     ,input  'shift-on=request'
     1111     ,output v-shift-on
     1112     ) no-error .
     1113       if error-status :error
     1114       then do:
     1115         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1116         undo, return error v-error .
     1117       end.
     1118       if v-shift-on = true
     1119       then do:
     1120         find first buf_shift-obj share-lock
     1121           where buf_shift-obj.obj-type   = p-obj-type
     1122             and buf_shift-obj.obj-code   = p-obj-code
     1123             and buf_shift-obj.shift-date > p-fact-date
     1124           use-index pi
     1125           no-error .
     1126         if not available buf_shift-obj
     1127         or buf_shift-obj.status_ <> 'зкр':U
     1128         then do:
     1129           find last buf_shift-obj
     1130             where buf_shift-obj.obj-type = p-obj-type
     1131               and buf_shift-obj.obj-code = p-obj-code
     1132               and buf_shift-obj.status_  = 'зкр':U
     1133             use-index stts
     1134             no-error .
     1135           if available buf_shift-obj
     1136           then do:
     1137             assign
     1138               v-extra-message =
     1139                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1140                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1141                               )
     1142             .
     1143           end.
     1144           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1145           undo, return error v-error .
     1146         end.
     1147       end.
     1148     end.
     1149   end procedure.
     1150   procedure factord-end-day :
     1151     define input  parameter p-fact-date            as date    no-undo .
     1152     define output parameter p-day-end-fact-order   as decimal no-undo .
     1153     do
     1154     on error undo, return error return-value
     1155     :
     1156       if p-fact-date = ?
     1157       then do:
     1158         return error "Не указана фактическая дата" .
     1159       end.
     1160       assign
     1161         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1162       .
     1163     end.
     1164   end procedure.
     1165   procedure factord-to-date :
     1166     define input  parameter p-fact-order as decimal no-undo .
     1167     define output parameter p-fact-date  as date    no-undo .
     1168     define variable v-ref-date  as date      no-undo .
     1169     define variable v-ref-delta as integer   no-undo .
     1170     do
     1171     on error undo, return error return-value
     1172     :
     1173       if p-fact-order = ?
     1174       or p-fact-order = 0
     1175       then do:
     1176         return error "Не указан fact-order" .
     1177       end.
     1178       assign
     1179         v-ref-date  = date(1, 1, 2000)
     1180       .
     1181       assign
     1182         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1183       .
     1184       assign
     1185         p-fact-date = v-ref-date + v-ref-delta
     1186       .
     1187     end.
     1188   end procedure.
     1189   procedure factord-to-fact-num :
     1190     define input  parameter p-fact-order as decimal no-undo .
     1191     define output parameter p-fact-num   as integer no-undo .
     1192     define variable v-fact-order-trunc as decimal no-undo .
     1193     do
     1194     on error undo, return error return-value
     1195     :
     1196       if p-fact-order = ?
     1197       or p-fact-order = 0
     1198       then do:
     1199         return error "Не указан fact-order" .
     1200       end.
     1201       assign
     1202        v-fact-order-trunc = truncate(p-fact-order, 2)
     1203       .
     1204       assign
     1205         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1206       .
     1207     end.
     1208   end procedure.
     1209   procedure factord-to-shift-num :
     1210     define input  parameter p-fact-order as decimal no-undo .
     1211     define output parameter p-shift-num   as integer no-undo .
     1212     define variable  p-shift-numd  as decimal   no-undo .
     1213     define variable v-fact-order-trunc as decimal no-undo .
     1214     do
     1215     on error undo, return error return-value
     1216     :
     1217       if p-fact-order = ?
     1218       or p-fact-order = 0
     1219       then do:
     1220         return error "Не указан fact-order" .
     1221       end.
     1222       assign
     1223        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1224       .
     1225       if v-fact-order-trunc < 0.5 then do:
     1226         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1227       end.
     1228       assign
     1229         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1230         .
     1231        assign
     1232         p-shift-num = truncate (p-shift-numd , 0)
     1233       .
     1234     end.
     1235   end procedure.
     1236   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1237   procedure cur-time :
     1238      define output parameter p-today as date      no-undo .
     1239      define output parameter p-time  as integer   no-undo .
     1240     do
     1241     on error undo, return error
     1242     :
     1243       define variable v-date1 as date      no-undo .
     1244       define variable v-date2 as date      no-undo .
     1245       define variable v-time  as integer   no-undo .
     1246       assign
     1247         v-date1 = today
     1248         v-time  = time
     1249         v-date2 = today
     1250       .
     1251       if v-date1 <> v-date2
     1252       then do:
     1253         assign
     1254           v-date1 = today
     1255           v-time  = v-time
     1256         .
     1257       end.
     1258       assign
     1259         p-today = v-date1
     1260         p-time  = v-time
     1261       .
     1262     end.
     1263   end.
     1264   function cur-time-date returns character
     1265   :
     1266     return string(today, '99/99/9999':U) .
     1267   end.
     1268   function cur-time-mjd returns decimal
     1269   :
     1270     define variable v-date as date      no-undo .
     1271     define variable v-time as integer   no-undo .
     1272     run cur-time in this-procedure
     1273       (output v-date
     1274       ,output v-time
     1275       ) .
     1276     return integer(v-date) - 2400002 + (v-time / 86400) .
     1277   end.
     1278   function cur-time-get-ending-index returns integer
     1279   (input p-number as integer
     1280   )
     1281   :
     1282     if p-number < 0
     1283     or p-number = ?
     1284     then do:
     1285       return 1 .
     1286     end.
     1287     define variable v-rest as integer   no-undo .
     1288     assign
     1289       p-number = p-number modulo 100
     1290     .
     1291     if p-number < 20
     1292     then do:
     1293       assign
     1294         v-rest = p-number
     1295       .
     1296     end.
     1297     else do:
     1298       assign
     1299         v-rest = p-number modulo 10
     1300       .
     1301     end.
     1302     case v-rest :
     1303       when 1
     1304       then do:
     1305         return 2 .
     1306       end.
     1307       when 2 or
     1308       when 3 or
     1309       when 4
     1310       then do:
     1311         return 3 .
     1312       end.
     1313       otherwise do:
     1314         return 1 .
     1315       end.
     1316     end case .
     1317   end.
     1318   procedure cur-time-mjd-to-date :
     1319      define input  parameter i-mjd-diff as decimal no-undo.
     1320      define output parameter o-Date     as date    no-undo.
     1321      define output parameter o-Time     as integer no-undo.
     1322      define variable v-day-number as integer   no-undo .
     1323      if    i-mjd-diff < 0
     1324         or i-mjd-diff = ?
     1325      then do:
     1326         return "?" .
     1327      end.
     1328      assign
     1329         v-day-number = truncate(i-mjd-diff,0).
     1330         o-Date = date(v-day-number + 2400002).
     1331         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1332     .
     1333   end.
     1334   function cur-time-mjd-to-string returns character
     1335   (input p-mjd-diff as decimal
     1336   )
     1337   :
     1338     define variable v-day-number as integer   no-undo .
     1339     define variable v-seconds    as integer   no-undo .
     1340     define variable v-hour       as integer   no-undo .
     1341     define variable v-min        as integer   no-undo .
     1342     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1343     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1344     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1345     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1346     if p-mjd-diff < 0
     1347     or p-mjd-diff = ?
     1348     then do:
     1349       return "?" .
     1350     end.
     1351     assign
     1352       v-day-number = integer(truncate(p-mjd-diff,0))
     1353       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1354     .
     1355     if v-seconds > 86400
     1356     then do:
     1357       assign
     1358         v-seconds = 86400 - 1
     1359       .
     1360     end.
     1361     if v-seconds < 0
     1362     then do:
     1363       assign
     1364         v-seconds = 0
     1365       .
     1366     end.
     1367     assign
     1368       v-hour = truncate(v-seconds / 3600, 0)
     1369     .
     1370     assign
     1371       v-seconds = v-seconds modulo 3600
     1372     .
     1373     assign
     1374       v-min = truncate(v-seconds / 60, 0)
     1375     .
     1376     assign
     1377       v-seconds = v-seconds modulo 60
     1378     .
     1379     return
     1380         (if v-day-number <> 0
     1381           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1382           else ""
     1383         )
     1384       + (if v-day-number <> 0 or v-hour <> 0
     1385           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1386           else ""
     1387         )
     1388       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1389           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1390           else ""
     1391         )
     1392       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1393       .
     1394   end.
     1395   function cur-time-string returns character
     1396   :
     1397     define variable v-date as date      no-undo .
     1398     define variable v-time as integer   no-undo .
     1399     run cur-time in this-procedure
     1400       (output v-date
     1401       ,output v-time
     1402       ) .
     1403     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1404   end.
     1405   function cur-time-string-sec returns character
     1406   :
     1407     define variable v-date as date      no-undo .
     1408     define variable v-time as integer   no-undo .
     1409     run cur-time in this-procedure
     1410       (output v-date
     1411       ,output v-time
     1412       ) .
     1413     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1414   end.
     1415   function cur-time-custom  returns character
     1416   (input p-prefix as character
     1417   ,input p-date-format as character
     1418   ,input p-delimiter as character
     1419   ,input p-time-format as character
     1420   ,input p-suffix as character
     1421   )
     1422   :
     1423     define variable v-date as date      no-undo .
     1424     define variable v-time as integer   no-undo .
     1425     run cur-time in this-procedure
     1426       (output v-date
     1427       ,output v-time
     1428       ) .
     1429     return
     1430       p-prefix
     1431       + string(v-date, p-date-format)
     1432       + p-delimiter
     1433       + string(v-time, p-time-format)
     1434       + p-suffix
     1435       .
     1436   end.
     1437   function cur-time-print  returns character
     1438   :
     1439     define variable v-date as date      no-undo .
     1440     define variable v-time as integer   no-undo .
     1441     run cur-time in this-procedure
     1442       (output v-date
     1443       ,output v-time
     1444       ) .
     1445     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1446   end.
     1447   function cur-time-datetime returns datetime
     1448   :
     1449     define variable v-char as character no-undo .
     1450     define variable v-datetime as datetime no-undo .
     1451     v-char = cur-time-string().
     1452     v-datetime = datetime(v-char).
     1453     return  v-datetime.
     1454   end.
     1455   function cur-time-string-msec returns character
     1456   :
     1457     define variable v-date as datetime  no-undo .
     1458     v-date = now.
     1459     return string(v-date) .
     1460   end.
     1461   define temp-table temp-font no-undo
     1462     field fontnum  as integer
     1463     field fontname as character
     1464     field fontsize as character
     1465     field fonttype as character
     1466     field font-h   as integer
     1467     field font-w   as integer
     1468     field v-row    as integer
     1469     field v-col    as integer
     1470     field v-row-lans as integer
     1471     field v-col-lans as integer
     1472   index pi fontnum
     1473   .
     1474   procedure get-font-ini :
     1475     do
     1476     on error undo, return error return-value
     1477     :
     1478   define variable ii as integer   no-undo .
     1479   define variable v-font7 as character no-undo .
     1480   define variable v-font as character no-undo .
     1481   define variable loc-name as character no-undo .
     1482   define variable loc-size as character no-undo .
     1483   define variable loc-type as character no-undo .
     1484   define variable old_H as integer   no-undo .
     1485   define variable old_w as integer   no-undo .
     1486   define variable old-row  as integer   no-undo .
     1487   define variable old-col  as integer   no-undo .
     1488   define variable old-row-lans  as integer   no-undo .
     1489   define variable old-col-lans  as integer   no-undo .
     1490   define variable vv as integer   no-undo .
     1491   empty temp-table temp-font.
     1492     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     1493       case num-entries (v-font7) :
     1494         when 4 then do:
     1495             assign
     1496               loc-name = entry ( 1 , v-font7 )
     1497               loc-size = entry ( 2 , v-font7 )
     1498               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     1499             .
     1500         end.
     1501         when 3 then do:
     1502             assign
     1503               loc-name = entry ( 1 , v-font7 )
     1504               loc-size = entry ( 2 , v-font7 )
     1505               loc-type = entry ( 3 , v-font7 )
     1506             .
     1507         end.
     1508         when 2 then  do:
     1509             assign
     1510               loc-name = entry ( 1 , v-font7 )
     1511               loc-size = entry ( 2 , v-font7 )
     1512               loc-type = ""
     1513             .
     1514         end.
     1515         when 1 then do:
     1516             assign
     1517               loc-name = trim(entry ( 1 , v-font7 ))
     1518               loc-size = ""
     1519               loc-type = ""
     1520             .
     1521         end.
     1522       end case.
     1523     create temp-font.
     1524     assign
     1525       temp-font.fontnum  = 7
     1526       temp-font.fontname = trim(loc-name)
     1527       temp-font.fontsize = trim(loc-size)
     1528       temp-font.fonttype = trim(loc-type)
     1529       temp-font.v-row    = 62
     1530       temp-font.v-col    = 136
     1531       temp-font.v-row-lans = 43
     1532       temp-font.v-col-lans = 198
     1533     .
     1534     repeat ii = 16 to 100 :
     1535       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     1536       if v-font = "" or v-font = ? then leave.
     1537       case num-entries (v-font) :
     1538         when 4 then do:
     1539             assign
     1540               loc-name = entry ( 1 , v-font )
     1541               loc-size = entry ( 2 , v-font )
     1542               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     1543             .
     1544         end.
     1545         when 3 then do:
     1546             assign
     1547               loc-name = entry ( 1 , v-font )
     1548               loc-size = entry ( 2 , v-font )
     1549               loc-type = entry ( 3 , v-font )
     1550             .
     1551         end.
     1552         when 2 then do:
     1553             assign
     1554               loc-name = entry ( 1 , v-font )
     1555               loc-size = entry ( 2 , v-font )
     1556               loc-type = ""
     1557             .
     1558         end.
     1559         when 1 then do:
     1560             assign
     1561               loc-name = trim(entry ( 1 , v-font ))
     1562               loc-size = ""
     1563               loc-type = ""
     1564             .
     1565         end.
     1566       end case.
     1567     create temp-font.
     1568     assign
     1569       temp-font.fontnum  = ii
     1570       temp-font.fontname = trim(loc-name)
     1571       temp-font.fontsize = trim(loc-size)
     1572       temp-font.fonttype = trim(loc-type)
     1573     .
     1574     end.
     1575       for each temp-font :
     1576          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     1577          if  vv = ? then vv =  0 .
     1578           run rep/exfont.p (
     1579             input   temp-font.fontname ,
     1580             input   vv ,
     1581             input   temp-font.fonttype ,
     1582             output  temp-font.font-h   ,
     1583             output  temp-font.font-w   )
     1584           .
     1585       end.
     1586   find first temp-font where  temp-font.fontnum  = 7  .
     1587   old_H = temp-font.font-H .
     1588   old_w = temp-font.font-W .
     1589   old-row = temp-font.v-row .
     1590   old-col = temp-font.v-col .
     1591   old-row-lans = temp-font.v-row-lans .
     1592   old-col-lans = temp-font.v-col-lans .
     1593       for each temp-font where
     1594                temp-font.fontnum  <> 7 :
     1595           assign
     1596               temp-font.v-row    = old_H * old-row / temp-font.font-h
     1597               temp-font.v-col    = old_W * old-col / temp-font.font-W
     1598               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     1599               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     1600           .
     1601       end.
     1602     end.
     1603   end procedure.
     1604   PROCEDURE How-name :
     1605   define input  parameter h as integer no-undo .
     1606   define input  parameter w as integer no-undo .
     1607   define output parameter n as character  no-undo .
     1608   define variable A4port-H as integer   no-undo init 63.
     1609   define variable A4port-W as integer   no-undo init 136.
     1610   define variable A4lans-H as integer   no-undo init 43.
     1611   define variable A4lans-W as integer   no-undo init 198.
     1612   define variable Strim-W  as integer   no-undo init 278.
     1613   run define-a4-size (
     1614        input ReportFontNum
     1615       ,output A4port-H
     1616       ,output A4port-W
     1617       ,output A4lans-H
     1618       ,output A4lans-W ).
     1619   If w >= 1 and w <= A4port-W Then DO:
     1620     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1621     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     1622     If h > A4port-H              Then n = "to-file":U.
     1623   End.
     1624   If w > A4port-W and w <= A4lans-W Then DO:
     1625     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1626     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1627     If h > A4port-H              Then n = "to-file":U.
     1628   End.
     1629   If w > A4lans-W and w <= Strim-W Then DO:
     1630     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     1631     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1632     If h > A4port-H              Then n = "to-file":U.
     1633   End.
     1634   If w > Strim-W Then DO:
     1635      n = "to-file":U.
     1636   End.
     1637   END PROCEDURE.
     1638   PROCEDURE define-a4-size :
     1639   define input  parameter p-ReportFontNum as integer   no-undo .
     1640   define output parameter A4port-H as integer   no-undo .
     1641   define output parameter A4port-W as integer   no-undo .
     1642   define output parameter A4lans-H as integer   no-undo .
     1643   define output parameter A4lans-W as integer   no-undo .
     1644   if not can-find (first temp-font ) then do:
     1645      run get-font-ini .
     1646   end.
     1647   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     1648   if available temp-font then do:
     1649   assign
     1650     A4port-H = temp-font.v-row
     1651     A4port-W = temp-font.v-col
     1652     A4lans-H = temp-font.v-row-lans
     1653     A4lans-W = temp-font.v-col-lans
     1654   .
     1655   end.
     1656   else do:
     1657   assign
     1658     A4port-H = 63
     1659     A4port-W = 136
     1660     A4lans-H = 43
     1661     A4lans-W = 198
     1662   .
     1663   end.
     1664   END PROCEDURE.
     1665   define stream out-stream.
     1666   define temp-table tt-cli-grp no-undo
     1667     field grp-name    as character
     1668     field grp-code    as integer
     1669   index pi is primary unique
     1670     grp-code
     1671   .
     1672   define temp-table tt-cli-grp-clients no-undo like ub.clients.
     1673   define temp-table tt-cli-grp-out no-undo
     1674     field grp-name    as character
     1675     field grp-code    as integer
     1676   index pi is primary unique
     1677     grp-code
     1678   .
     1679   define temp-table tt-cli-grp-out-clients no-undo like ub.clients.
     1680   define temp-table tt-wealth no-undo like ub.wealth.
     1681   define temp-table tt-report no-undo
     1682     field grp-code      as integer
     1683     field sale-grp-code as integer
     1684     field wth-code      as integer
     1685     field par-code      as integer
     1686     field grp-name      as character
     1687     field sale-grp-name as character
     1688     field wth-name      as character
     1689     field par-name      as character
     1690     field qnty          as decimal
     1691     field sum           as decimal
     1692   index pi is primary unique
     1693     grp-code
     1694     sale-grp-code
     1695     wth-code
     1696     par-code
     1697   index sgc
     1698     sale-grp-code
     1699     wth-code
     1700     par-code
     1701     grp-code
     1702   index wpg
     1703     wth-code
     1704     par-code
     1705     grp-code
     1706   .
     1707   define temp-table tt-report-price no-undo
     1708     field grp-code      as integer
     1709     field sale-grp-code as integer
     1710     field wth-code      as integer
     1711     field par-code      as integer
     1712     field price-rubl    as decimal
     1713     field grp-name      as character
     1714     field sale-grp-name as character
     1715     field wth-name      as character
     1716     field par-name      as character
     1717     field qnty          as decimal
     1718     field sum           as decimal
     1719   index pi is primary unique
     1720     grp-code
     1721     sale-grp-code
     1722     wth-code
     1723     par-code
     1724     price-rubl
     1725   index sgc
     1726     sale-grp-code
     1727     wth-code
     1728     price-rubl
     1729     par-code
     1730     grp-code
     1731   index wpg
     1732     wth-code
     1733     par-code
     1734     grp-code
     1735   index wg
     1736     wth-code
     1737     par-code
     1738     price-rubl
     1739     grp-code
     1740   index price
     1741     price-rubl
     1742   .
     1743   define variable g#report-num      as integer   no-undo .
     1744   define variable v-fo-start        as decimal   no-undo .
     1745   define variable v-fo-end          as decimal   no-undo .
     1746   define variable v-date-begin      as date      no-undo .
     1747   define variable v-date-end        as date      no-undo .
     1748   define variable v-host-code     as integer   no-undo .
     1749   function to-string returns character (val as decimal, type as character) forward.
     1750   do
     1751   on error undo, return error return-value
     1752   :
     1753     run waitfram-show in this-procedure ( "Формирование отчета..." ) .
     1754     run clear-tt in this-procedure .
     1755     run get-report-num in parparentproc (output g#report-num).
     1756   output stream out-stream to value( string( session:temp-directory +
     1757                                        "rpt" + string( g#report-num ) ) )
     1758                                        page-size  value(62) .
     1759     assign
     1760       v-date-begin  = x-Date-Start
     1761       v-date-end    = x-Date-End
     1762     .
     1763     run day-begin-fact-order in this-procedure ( input x-Date-Start , output v-fo-start ) .
     1764     run factord-end-day in this-procedure ( input x-Date-End , output v-fo-end ) .
     1765     run fill-tt-tables in this-procedure .
     1766     run print-report in this-procedure .
     1767     put stream out-stream unformatted " " skip.
     1768     output stream out-stream close.
     1769     if Make-Excel then output stream ForExcel close.
     1770     run clear-tt in this-procedure .
     1771     run waitfram-hide in this-procedure .
     1772     define variable v-user-action   as character no-undo .
     1773     define variable v-printed       as logical   no-undo .
     1774     define variable DisabledOptions as integer   no-undo .
     1775     define variable v-orient-page as character no-undo .
     1776     run How-name in this-procedure (
     1777         input ReportPageHeight,
     1778         input ReportPageWidth,
     1779         output v-orient-page )
     1780         .
     1781     run gbl/prnfilen.w
     1782         (input  ""
     1783         ,input  20
     1784         ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     1785         ,input  ReportFontNum
     1786         ,output v-user-action
     1787         ,output v-printed
     1788         ) .
     1789   end.
     1790   procedure clear-tt :
     1791   do
     1792   on error undo, return error return-value
     1793   :
     1794     empty temp-table tt-cli-grp.
     1795     empty temp-table tt-cli-grp-out.
     1796     empty temp-table tt-cli-grp-clients.
     1797     empty temp-table tt-wealth.
     1798     empty temp-table tt-report.
     1799     empty temp-table tt-report-price.
     1800   end.
     1801   end procedure.
     1802   procedure fill-tt-tables :
     1803   do
     1804   on error undo, return error return-value
     1805   :
     1806     define buffer buf_wealth                  for ub.wealth .
     1807     define buffer buf_cli-grp                 for ub.cli-grp .
     1808     define buffer buf_clients                 for ub.clients .
     1809     define buffer buf_tt-cli-grp              for tt-cli-grp.
     1810     define buffer buf_tt-cli-grp-out          for tt-cli-grp-out.
     1811     define buffer buf_tt-wealth               for tt-wealth.
     1812     define buffer buf_tt-cli-grp-clients      for tt-cli-grp-clients.
     1813     define buffer buf_tt-cli-grp-out-clients  for tt-cli-grp-out-clients.
     1814     define variable v-i            as integer   no-undo .
     1815     define variable v-host-code-1  as integer   no-undo .
     1816     define variable v-host-code-2  as integer   no-undo .
     1817     do v-i = 1 to num-entries( p-cli-grp-list )
     1818     :
     1819       find first buf_cli-grp no-lock
     1820         where buf_cli-grp.node-code = integer( entry( v-i , p-cli-grp-list ) )
     1821       no-error .
     1822       if available buf_cli-grp
     1823       then do:
     1824         find first buf_tt-cli-grp
     1825           where buf_tt-cli-grp.grp-code = buf_cli-grp.node-code
     1826         no-error .
     1827         if not available buf_tt-cli-grp
     1828         then do:
     1829           create buf_tt-cli-grp.
     1830           assign
     1831             buf_tt-cli-grp.grp-code = buf_cli-grp.node-code
     1832             buf_tt-cli-grp.grp-name = buf_cli-grp.node-name
     1833           .
     1834         end.
     1835         for each buf_clients no-lock
     1836           where buf_clients.grp-code = buf_cli-grp.node-code
     1837         :
     1838           find first buf_tt-cli-grp-clients no-lock
     1839             where buf_tt-cli-grp-clients.obj-type = buf_clients.obj-type
     1840               and buf_tt-cli-grp-clients.obj-code = buf_clients.obj-code
     1841           no-error .
     1842           if not available buf_tt-cli-grp-clients
     1843           then do:
     1844             create buf_tt-cli-grp-clients.
     1845             buffer-copy buf_clients to buf_tt-cli-grp-clients .
     1846           end.
     1847         end.
     1848       end.
     1849     end.
     1850     _cli-grp-out-list:
     1851     do v-i = 1 to num-entries( p-cli-grp-out-list )
     1852     :
     1853       if p-cli-out-type = 3
     1854       then do:
     1855         define variable v-obj-type  as character no-undo .
     1856         define variable v-obj-code  as integer   no-undo .
     1857         define variable v-tmp-str   as character no-undo .
     1858         assign
     1859           v-tmp-str = entry( v-i , p-cli-grp-out-list )
     1860         .
     1861         if num-entries( v-tmp-str , ':' ) <> 2
     1862         then do:
     1863           next _cli-grp-out-list.
     1864         end.
     1865         assign
     1866           v-obj-type = entry( 1 , v-tmp-str , ':' )
     1867           v-obj-code = integer( entry( 2 , v-tmp-str , ':' ) )
     1868         .
     1869         find first buf_clients no-lock
     1870           where buf_clients.obj-type = v-obj-type
     1871             and buf_clients.obj-code = v-obj-code
     1872         no-error .
     1873         if available buf_clients
     1874         then do:
     1875           find first buf_tt-cli-grp-out
     1876             where buf_tt-cli-grp-out.grp-code = buf_clients.grp-code
     1877           no-error .
     1878           if not available buf_tt-cli-grp-out
     1879           then do:
     1880             find first buf_cli-grp no-lock
     1881               where buf_cli-grp.node-code = buf_clients.grp-code
     1882             no-error .
     1883             if available buf_cli-grp
     1884             then do:
     1885               create buf_tt-cli-grp-out.
     1886               assign
     1887                 buf_tt-cli-grp-out.grp-code = buf_cli-grp.node-code
     1888                 buf_tt-cli-grp-out.grp-name = buf_cli-grp.node-name
     1889               .
     1890             end.
     1891           end.
     1892           find first buf_tt-cli-grp-out-clients no-lock
     1893             where buf_tt-cli-grp-out-clients.obj-type = buf_clients.obj-type
     1894               and buf_tt-cli-grp-out-clients.obj-code = buf_clients.obj-code
     1895           no-error .
     1896           if not available buf_tt-cli-grp-out-clients
     1897           then do:
     1898             create buf_tt-cli-grp-out-clients.
     1899             buffer-copy buf_clients to buf_tt-cli-grp-out-clients
     1900             assign
     1901               buf_tt-cli-grp-out-clients.grp-code = buf_tt-cli-grp-out.grp-code
     1902               buf_tt-cli-grp-out-clients.grp-name = buf_tt-cli-grp-out.grp-name
     1903             .
     1904           end.
     1905         end.
     1906       end.
     1907       else do:
     1908         find first buf_cli-grp no-lock
     1909           where buf_cli-grp.node-code = integer( entry( v-i , p-cli-grp-out-list ) )
     1910         no-error .
     1911         if available buf_cli-grp
     1912         then do:
     1913           find first buf_tt-cli-grp-out
     1914             where buf_tt-cli-grp-out.grp-code = buf_cli-grp.node-code
     1915           no-error .
     1916           if not available buf_tt-cli-grp-out
     1917           then do:
     1918             create buf_tt-cli-grp-out.
     1919             assign
     1920               buf_tt-cli-grp-out.grp-code = buf_cli-grp.node-code
     1921               buf_tt-cli-grp-out.grp-name = buf_cli-grp.node-name
     1922             .
     1923           end.
     1924           for each buf_clients no-lock
     1925             where buf_clients.grp-code = buf_cli-grp.node-code
     1926               and buf_clients.obj-type = 'маг':U
     1927           :
     1928             find first buf_tt-cli-grp-out-clients no-lock
     1929               where buf_tt-cli-grp-out-clients.obj-type = buf_clients.obj-type
     1930                 and buf_tt-cli-grp-out-clients.obj-code = buf_clients.obj-code
     1931             no-error .
     1932             if not available buf_tt-cli-grp-out-clients
     1933             then do:
     1934               create buf_tt-cli-grp-out-clients.
     1935               buffer-copy buf_clients to buf_tt-cli-grp-out-clients
     1936               assign
     1937                 buf_tt-cli-grp-out-clients.grp-code = buf_tt-cli-grp-out.grp-code
     1938                 buf_tt-cli-grp-out-clients.grp-name = buf_tt-cli-grp-out.grp-name
     1939               .
     1940             end.
     1941           end.
     1942         end.
     1943       end.
     1944     end.
     1945     do v-i = 1 to num-entries( p-wth-list )
     1946     :
     1947       find first buf_wealth no-lock
     1948         where buf_wealth.wth-code = integer( entry( v-i , p-wth-list ) )
     1949       no-error .
     1950       if available buf_wealth
     1951       then do:
     1952         find first buf_tt-wealth
     1953           where buf_tt-wealth.wth-code = buf_wealth.wth-code
     1954         no-error .
     1955         if not available buf_tt-wealth
     1956         then do:
     1957           buffer-copy buf_wealth to buf_tt-wealth.
     1958         end.
     1959       end.
     1960     end.
     1961     if p-price-detail = yes
     1962     then do:
     1963       run fill-tt-tables-with-price in this-procedure .
     1964     end.
     1965     else do:
     1966       run fill-tt-tables-no-price in this-procedure .
     1967     end.
     1968   end.
     1969   end procedure.
     1970   procedure fill-tt-tables-no-price :
     1971     define buffer buf_wealth                  for ub.wealth .
     1972     define buffer buf_wth-doc                 for ub.wth-doc.
     1973     define buffer buf_wth-par                 for ub.wth-par .
     1974     define buffer buf_wth-parts               for ub.wth-parts .
     1975     define buffer buf_clients                 for ub.clients .
     1976     define buffer buf_tt-cli-grp              for tt-cli-grp.
     1977     define buffer buf_tt-cli-grp-out          for tt-cli-grp-out.
     1978     define buffer buf_tt-wealth               for tt-wealth.
     1979     define buffer buf_tt-cli-grp-clients      for tt-cli-grp-clients.
     1980     define buffer buf_tt-cli-grp-out-clients  for tt-cli-grp-out-clients.
     1981     define buffer buf_tt-report               for tt-report.
     1982   do
     1983   on error undo, return error return-value
     1984   :
     1985     for each buf_tt-cli-grp-out ,
     1986         each buf_tt-cli-grp ,
     1987         each buf_tt-wealth ,
     1988         each buf_wth-par no-lock
     1989           where buf_wth-par.wth-code = buf_tt-wealth.wth-code
     1990     :
     1991       find first buf_tt-report
     1992         where buf_tt-report.grp-code      = buf_tt-cli-grp.grp-code
     1993           and buf_tt-report.sale-grp-code = buf_tt-cli-grp-out.grp-code
     1994           and buf_tt-report.wth-code      = buf_tt-wealth.wth-code
     1995           and buf_tt-report.par-code      = buf_wth-par.par-code
     1996       no-error .
     1997       if not available buf_tt-report
     1998       then do:
     1999         create buf_tt-report.
     2000         assign
     2001           buf_tt-report.grp-code      = buf_tt-cli-grp.grp-code
     2002           buf_tt-report.sale-grp-code = buf_tt-cli-grp-out.grp-code
     2003           buf_tt-report.wth-code      = buf_tt-wealth.wth-code
     2004           buf_tt-report.par-code      = buf_wth-par.par-code
     2005           buf_tt-report.grp-name      = buf_tt-cli-grp.grp-name
     2006           buf_tt-report.sale-grp-name = buf_tt-cli-grp-out.grp-name
     2007           buf_tt-report.wth-name      = buf_tt-wealth.wth-name
     2008           buf_tt-report.par-name      = substitute( "&1 &2" , buf_wth-par.par-val , buf_wth-par.par-unit )
     2009         .
     2010       end.
     2011     end.
     2012     for each buf_tt-cli-grp-out-clients
     2013     :
     2014   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2015   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2016     (input  buf_tt-cli-grp-out-clients.obj-type
     2017     ,input  buf_tt-cli-grp-out-clients.obj-code
     2018     ,output v-host-code
     2019     )  .
     2020       for each buf_wth-doc no-lock
     2021         where buf_wth-doc.host-code     = v-host-code
     2022           and buf_wth-doc.obj-type      = buf_tt-cli-grp-out-clients.obj-type
     2023           and buf_wth-doc.obj-code      = buf_tt-cli-grp-out-clients.obj-code
     2024           and buf_wth-doc.status_       = 'факт':U
     2025           and buf_wth-doc.fact-order   >= v-fo-start
     2026           and buf_wth-doc.fact-order   <= v-fo-end
     2027           and buf_wth-doc.ext-doc-type  = 'pc':U
     2028       :
     2029         for each buf_tt-wealth ,
     2030             each buf_wth-par no-lock
     2031               where buf_wth-par.wth-code = buf_tt-wealth.wth-code
     2032         :
     2033           for each buf_wth-parts no-lock
     2034             where buf_wth-parts.out-code  = buf_wth-doc.doc-code
     2035               and buf_wth-parts.obj-type  = buf_wth-doc.obj-type
     2036               and buf_wth-parts.obj-code  = buf_wth-doc.obj-code
     2037               and buf_wth-parts.wth-code  = buf_tt-wealth.wth-code
     2038               and buf_wth-parts.par-code  = buf_wth-par.par-code
     2039           :
     2040             find first buf_tt-cli-grp-clients
     2041               where buf_tt-cli-grp-clients.obj-type = buf_wth-parts.sale-obj-type
     2042                 and buf_tt-cli-grp-clients.obj-code = buf_wth-parts.sale-obj-code
     2043             no-error .
     2044             if available buf_tt-cli-grp-clients
     2045             then do:
     2046               find first buf_tt-report
     2047                 where buf_tt-report.grp-code      = buf_tt-cli-grp-clients.grp-code
     2048                   and buf_tt-report.sale-grp-code = buf_tt-cli-grp-out-clients.grp-code
     2049                   and buf_tt-report.wth-code      = buf_wth-parts.wth-code
     2050                   and buf_tt-report.par-code      = buf_wth-parts.par-code
     2051               no-error .
     2052               if not available buf_tt-report
     2053               then do:
     2054                 find first buf_tt-cli-grp
     2055                   where buf_tt-cli-grp.grp-code = buf_tt-cli-grp-clients.grp-code
     2056                 no-error .
     2057                 if available buf_tt-cli-grp
     2058                 then do:
     2059                   create buf_tt-report.
     2060                   assign
     2061                     buf_tt-report.grp-code      = buf_tt-cli-grp.grp-code
     2062                     buf_tt-report.sale-grp-code = buf_tt-cli-grp-out-clients.grp-code
     2063                     buf_tt-report.wth-code      = buf_wth-parts.wth-code
     2064                     buf_tt-report.par-code      = buf_wth-parts.par-code
     2065                     buf_tt-report.grp-name      = buf_tt-cli-grp.grp-name
     2066                     buf_tt-report.sale-grp-name = buf_tt-cli-grp-out-clients.grp-name
     2067                     buf_tt-report.wth-name      = buf_tt-wealth.wth-name
     2068                     buf_tt-report.par-name      = substitute( "&1 &2" , buf_wth-par.par-val , buf_wth-par.par-unit )
     2069                   .
     2070                 end.
     2071               end.
     2072               assign
     2073                 buf_tt-report.qnty = buf_tt-report.qnty + ( buf_wth-parts.fact-qnty * buf_wth-par.par-val )
     2074                 buf_tt-report.sum  = buf_tt-report.sum  + (buf_wth-parts.price-rubl *  buf_wth-parts.fact-qnty)
     2075               .
     2076             end.
     2077           end.
     2078         end.
     2079       end.
     2080       for each buf_wth-doc no-lock
     2081         where buf_wth-doc.host-code     = v-host-code
     2082           and buf_wth-doc.cli-type      = buf_tt-cli-grp-out-clients.obj-type
     2083           and buf_wth-doc.cli-code      = buf_tt-cli-grp-out-clients.obj-code
     2084           and buf_wth-doc.status_       = 'факт':U
     2085           and buf_wth-doc.fact-order   >= v-fo-start
     2086           and buf_wth-doc.fact-order   <= v-fo-end
     2087           and buf_wth-doc.ext-doc-type  = 'ps':U
     2088       :
     2089         for each buf_tt-wealth ,
     2090             each buf_wth-par no-lock
     2091               where buf_wth-par.wth-code = buf_tt-wealth.wth-code
     2092         :
     2093           for each buf_wth-parts no-lock
     2094             where buf_wth-parts.out-code  = buf_wth-doc.doc-code
     2095               and buf_wth-parts.obj-type  = buf_wth-doc.obj-type
     2096               and buf_wth-parts.obj-code  = buf_wth-doc.obj-code
     2097               and buf_wth-parts.wth-code  = buf_tt-wealth.wth-code
     2098               and buf_wth-parts.par-code  = buf_wth-par.par-code
     2099           :
     2100             find first buf_tt-cli-grp-clients
     2101               where buf_tt-cli-grp-clients.obj-type = buf_wth-parts.sale-obj-type
     2102                 and buf_tt-cli-grp-clients.obj-code = buf_wth-parts.sale-obj-code
     2103             no-error .
     2104             if available buf_tt-cli-grp-clients
     2105             then do:
     2106               find first buf_tt-report
     2107                 where buf_tt-report.grp-code      = buf_tt-cli-grp-clients.grp-code
     2108                   and buf_tt-report.sale-grp-code = buf_tt-cli-grp-out-clients.grp-code
     2109                   and buf_tt-report.wth-code      = buf_wth-parts.wth-code
     2110                   and buf_tt-report.par-code      = buf_wth-parts.par-code
     2111               no-error .
     2112               if not available buf_tt-report
     2113               then do:
     2114                 find first buf_tt-cli-grp
     2115                   where buf_tt-cli-grp.grp-code = buf_tt-cli-grp-clients.grp-code
     2116                 no-error .
     2117                 if available buf_tt-cli-grp
     2118                 then do:
     2119                   create buf_tt-report.
     2120                   assign
     2121                     buf_tt-report.grp-code      = buf_tt-cli-grp.grp-code
     2122                     buf_tt-report.sale-grp-code = buf_tt-cli-grp-out-clients.grp-code
     2123                     buf_tt-report.wth-code      = buf_wth-parts.wth-code
     2124                     buf_tt-report.par-code      = buf_wth-parts.par-code
     2125                     buf_tt-report.grp-name      = buf_tt-cli-grp.grp-name
     2126                     buf_tt-report.sale-grp-name = buf_tt-cli-grp-out-clients.grp-name
     2127                     buf_tt-report.wth-name      = buf_tt-wealth.wth-name
     2128                     buf_tt-report.par-name      = substitute( "&1 &2" , buf_wth-par.par-val , buf_wth-par.par-unit )
     2129                   .
     2130                 end.
     2131               end.
     2132               assign
     2133                 buf_tt-report.qnty = buf_tt-report.qnty + ( buf_wth-parts.fact-qnty * buf_wth-par.par-val )
     2134                 buf_tt-report.sum  = buf_tt-report.sum  + (buf_wth-parts.price-rubl *  buf_wth-parts.fact-qnty)
     2135               .
     2136             end.
     2137           end.
     2138         end.
     2139       end.
     2140     end.
     2141   end.
     2142   end procedure.
     2143   procedure fill-tt-tables-with-price :
     2144     define buffer buf_wealth                  for ub.wealth .
     2145     define buffer buf_wth-doc                 for ub.wth-doc.
     2146     define buffer buf_wth-par                 for ub.wth-par .
     2147     define buffer buf_wth-parts               for ub.wth-parts .
     2148     define buffer buf_clients                 for ub.clients .
