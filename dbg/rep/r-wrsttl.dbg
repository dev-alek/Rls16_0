     2157     define variable v-price-rubl   as decimal   no-undo .
     2158   do
     2159   on error undo, return error return-value
     2160   :
     2161     for each buf_tt-cli-grp-out ,
     2162         each buf_tt-cli-grp ,
     2163         each buf_tt-wealth ,
     2164         each buf_wth-par no-lock
     2165           where buf_wth-par.wth-code = buf_tt-wealth.wth-code
     2166     :
     2167       find first buf_tt-report-price
     2168         where buf_tt-report-price.grp-code      = buf_tt-cli-grp.grp-code
     2169           and buf_tt-report-price.sale-grp-code = buf_tt-cli-grp-out.grp-code
     2170           and buf_tt-report-price.wth-code      = buf_tt-wealth.wth-code
     2171           and buf_tt-report-price.par-code      = buf_wth-par.par-code
     2172       no-error .
     2173       if not available buf_tt-report-price
     2174       then do:
     2175         create buf_tt-report-price.
     2176         assign
     2177           buf_tt-report-price.grp-code      = buf_tt-cli-grp.grp-code
     2178           buf_tt-report-price.sale-grp-code = buf_tt-cli-grp-out.grp-code
     2179           buf_tt-report-price.wth-code      = buf_tt-wealth.wth-code
     2180           buf_tt-report-price.par-code      = buf_wth-par.par-code
     2181           buf_tt-report-price.grp-name      = buf_tt-cli-grp.grp-name
     2182           buf_tt-report-price.sale-grp-name = buf_tt-cli-grp-out.grp-name
     2183           buf_tt-report-price.wth-name      = buf_tt-wealth.wth-name
     2184           buf_tt-report-price.par-name      = substitute( "&1 &2" , buf_wth-par.par-val , buf_wth-par.par-unit )
     2185         .
     2186       end.
     2187     end.
     2188     for each buf_tt-cli-grp-out-clients
     2189     :
     2190   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2191   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2192     (input  buf_tt-cli-grp-out-clients.obj-type
     2193     ,input  buf_tt-cli-grp-out-clients.obj-code
     2194     ,output v-host-code
     2195     )  .
     2196       for each buf_wth-doc no-lock
     2197         where buf_wth-doc.host-code     = v-host-code
     2198           and buf_wth-doc.obj-type      = buf_tt-cli-grp-out-clients.obj-type
     2199           and buf_wth-doc.obj-code      = buf_tt-cli-grp-out-clients.obj-code
     2200           and buf_wth-doc.status_       = 'факт':U
     2201           and buf_wth-doc.fact-order   >= v-fo-start
     2202           and buf_wth-doc.fact-order   <= v-fo-end
     2203           and buf_wth-doc.ext-doc-type  = 'pc':U
     2204       :
     2205         for each buf_tt-wealth ,
     2206             each buf_wth-par no-lock
     2207               where buf_wth-par.wth-code = buf_tt-wealth.wth-code
     2208         :
     2209           for each buf_wth-parts no-lock
     2210             where buf_wth-parts.out-code  = buf_wth-doc.doc-code
     2211               and buf_wth-parts.obj-type  = buf_wth-doc.obj-type
     2212               and buf_wth-parts.obj-code  = buf_wth-doc.obj-code
     2213               and buf_wth-parts.wth-code  = buf_tt-wealth.wth-code
     2214               and buf_wth-parts.par-code  = buf_wth-par.par-code
     2215           :
     2216             find first buf_tt-cli-grp-clients
     2217               where buf_tt-cli-grp-clients.obj-type = buf_wth-parts.sale-obj-type
     2218                 and buf_tt-cli-grp-clients.obj-code = buf_wth-parts.sale-obj-code
     2219             no-error .
     2220             if available buf_tt-cli-grp-clients
     2221             then do:
     2222               assign
     2223                 v-price-rubl = buf_wth-parts.price-rubl / buf_wth-par.par-val
     2224               .
     2225               find first buf_tt-report-price
     2226                 where buf_tt-report-price.grp-code      = buf_tt-cli-grp-clients.grp-code
     2227                   and buf_tt-report-price.sale-grp-code = buf_tt-cli-grp-out-clients.grp-code
     2228                   and buf_tt-report-price.wth-code      = buf_wth-parts.wth-code
     2229                   and buf_tt-report-price.par-code      = buf_wth-parts.par-code
     2230                   and buf_tt-report-price.price-rubl    = v-price-rubl
     2231               no-error .
     2232               if not available buf_tt-report-price
     2233               then do:
     2234                 find first buf_tt-cli-grp
     2235                   where buf_tt-cli-grp.grp-code = buf_tt-cli-grp-clients.grp-code
     2236                 no-error .
     2237                 if available buf_tt-cli-grp
     2238                 then do:
     2239                   create buf_tt-report-price.
     2240                   assign
     2241                     buf_tt-report-price.grp-code      = buf_tt-cli-grp.grp-code
     2242                     buf_tt-report-price.sale-grp-code = buf_tt-cli-grp-out-clients.grp-code
     2243                     buf_tt-report-price.wth-code      = buf_wth-parts.wth-code
     2244                     buf_tt-report-price.par-code      = buf_wth-parts.par-code
     2245                     buf_tt-report-price.price-rubl    = v-price-rubl
     2246                     buf_tt-report-price.grp-name      = buf_tt-cli-grp.grp-name
     2247                     buf_tt-report-price.sale-grp-name = buf_tt-cli-grp-out-clients.grp-name
     2248                     buf_tt-report-price.wth-name      = buf_tt-wealth.wth-name
     2249                     buf_tt-report-price.par-name      = substitute( "&1 &2" , buf_wth-par.par-val , buf_wth-par.par-unit )
     2250                   .
     2251                 end.
     2252               end.
     2253               assign
     2254                 buf_tt-report-price.qnty = buf_tt-report-price.qnty + ( buf_wth-parts.fact-qnty * buf_wth-par.par-val )
     2255                 buf_tt-report-price.sum  = buf_tt-report-price.sum  + (buf_wth-parts.price-rubl *  buf_wth-parts.fact-qnty)
     2256               .
     2257             end.
     2258           end.
     2259         end.
     2260       end.
     2261       for each buf_wth-doc no-lock
     2262         where buf_wth-doc.host-code     = v-host-code
     2263           and buf_wth-doc.cli-type      = buf_tt-cli-grp-out-clients.obj-type
     2264           and buf_wth-doc.cli-code      = buf_tt-cli-grp-out-clients.obj-code
     2265           and buf_wth-doc.status_       = 'факт':U
     2266           and buf_wth-doc.fact-order   >= v-fo-start
     2267           and buf_wth-doc.fact-order   <= v-fo-end
     2268           and buf_wth-doc.ext-doc-type  = 'ps':U
     2269       :
     2270         for each buf_tt-wealth ,
     2271             each buf_wth-par no-lock
     2272               where buf_wth-par.wth-code = buf_tt-wealth.wth-code
     2273         :
     2274           for each buf_wth-parts no-lock
     2275             where buf_wth-parts.out-code  = buf_wth-doc.doc-code
     2276               and buf_wth-parts.obj-type  = buf_wth-doc.obj-type
     2277               and buf_wth-parts.obj-code  = buf_wth-doc.obj-code
     2278               and buf_wth-parts.wth-code  = buf_tt-wealth.wth-code
     2279               and buf_wth-parts.par-code  = buf_wth-par.par-code
     2280           :
     2281             find first buf_tt-cli-grp-clients
     2282               where buf_tt-cli-grp-clients.obj-type = buf_wth-parts.sale-obj-type
     2283                 and buf_tt-cli-grp-clients.obj-code = buf_wth-parts.sale-obj-code
     2284             no-error .
     2285             if available buf_tt-cli-grp-clients
     2286             then do:
     2287               assign
     2288                 v-price-rubl = buf_wth-parts.price-rubl / buf_wth-par.par-val
     2289               .
     2290               find first buf_tt-report-price
     2291                 where buf_tt-report-price.grp-code      = buf_tt-cli-grp-clients.grp-code
     2292                   and buf_tt-report-price.sale-grp-code = buf_tt-cli-grp-out-clients.grp-code
     2293                   and buf_tt-report-price.wth-code      = buf_wth-parts.wth-code
     2294                   and buf_tt-report-price.par-code      = buf_wth-parts.par-code
     2295                   and buf_tt-report-price.price-rubl    = v-price-rubl
     2296               no-error .
     2297               if not available buf_tt-report-price
     2298               then do:
     2299                 find first buf_tt-cli-grp
     2300                   where buf_tt-cli-grp.grp-code = buf_tt-cli-grp-clients.grp-code
     2301                 no-error .
     2302                 if available buf_tt-cli-grp
     2303                 then do:
     2304                   create buf_tt-report-price.
     2305                   assign
     2306                     buf_tt-report-price.grp-code      = buf_tt-cli-grp.grp-code
     2307                     buf_tt-report-price.sale-grp-code = buf_tt-cli-grp-out-clients.grp-code
     2308                     buf_tt-report-price.wth-code      = buf_wth-parts.wth-code
     2309                     buf_tt-report-price.par-code      = buf_wth-parts.par-code
     2310                     buf_tt-report-price.price-rubl    = v-price-rubl
     2311                     buf_tt-report-price.grp-name      = buf_tt-cli-grp.grp-name
     2312                     buf_tt-report-price.sale-grp-name = buf_tt-cli-grp-out-clients.grp-name
     2313                     buf_tt-report-price.wth-name      = buf_tt-wealth.wth-name
     2314                     buf_tt-report-price.par-name      = substitute( "&1 &2" , buf_wth-par.par-val , buf_wth-par.par-unit )
     2315                   .
     2316                 end.
     2317               end.
     2318               assign
     2319                 buf_tt-report-price.qnty = buf_tt-report-price.qnty + ( buf_wth-parts.fact-qnty * buf_wth-par.par-val )
     2320                 buf_tt-report-price.sum  = buf_tt-report-price.sum  + (buf_wth-parts.price-rubl *  buf_wth-parts.fact-qnty)
     2321               .
     2322             end.
     2323           end.
     2324         end.
     2325       end.
     2326     end.
     2327     for each buf_tt-report-price
     2328     :
     2329       for each sch_tt-report-price
     2330         where sch_tt-report-price.sale-grp-code = buf_tt-report-price.sale-grp-code
     2331           and sch_tt-report-price.wth-code      = buf_tt-report-price.wth-code
     2332           and sch_tt-report-price.par-code      = buf_tt-report-price.par-code
     2333       :
     2334         find first new_tt-report-price
     2335           where new_tt-report-price.grp-code      = sch_tt-report-price.grp-code
     2336             and new_tt-report-price.sale-grp-code = buf_tt-report-price.sale-grp-code
     2337             and new_tt-report-price.wth-code      = buf_tt-report-price.wth-code
     2338             and new_tt-report-price.par-code      = buf_tt-report-price.par-code
     2339             and new_tt-report-price.price-rubl    = buf_tt-report-price.price-rubl
     2340         no-error .
     2341         if not available new_tt-report-price
     2342         then do:
     2343           create new_tt-report-price.
     2344           assign
     2345             new_tt-report-price.grp-code      = sch_tt-report-price.grp-code
     2346             new_tt-report-price.sale-grp-code = buf_tt-report-price.sale-grp-code
     2347             new_tt-report-price.wth-code      = buf_tt-report-price.wth-code
     2348             new_tt-report-price.par-code      = buf_tt-report-price.par-code
     2349             new_tt-report-price.price-rubl    = buf_tt-report-price.price-rubl
     2350             new_tt-report-price.grp-name      = buf_tt-report-price.grp-name
     2351             new_tt-report-price.sale-grp-name = buf_tt-report-price.sale-grp-name
     2352             new_tt-report-price.wth-name      = buf_tt-report-price.wth-name
     2353             new_tt-report-price.par-name      = buf_tt-report-price.par-name
     2354           .
     2355         end.
     2356       end.
     2357     end.
     2358     for each buf_tt-report-price
     2359       where buf_tt-report-price.price-rubl = 0
     2360     :
     2361       find first sch_tt-report-price
     2362         where sch_tt-report-price.sale-grp-code = buf_tt-report-price.sale-grp-code
     2363           and sch_tt-report-price.wth-code      = buf_tt-report-price.wth-code
     2364           and sch_tt-report-price.par-code      = buf_tt-report-price.par-code
     2365           and sch_tt-report-price.price-rubl    > 0
     2366       no-error .
     2367       if available sch_tt-report-price
     2368       then do:
     2369         delete buf_tt-report-price.
     2370       end.
     2371     end.
     2372   end.
     2373   end procedure.
     2374   procedure print-report :
     2375   do
     2376   on error undo, return error return-value
     2377   :
     2378     if p-price-detail = yes
     2379     then do:
     2380       run print-report-with-price in this-procedure .
     2381     end.
     2382     else do:
     2383       run print-report-no-price in this-procedure .
     2384     end.
     2385   end.
     2386   end procedure.
     2387   procedure print-report-with-price :
     2388     define buffer buf_tt-report-price               for tt-report-price.
     2389     define buffer buf_wth-par                 for ub.wth-par .
     2390     define buffer buf_tt-cli-grp              for tt-cli-grp.
     2391     define buffer buf_tt-wealth               for tt-wealth.
     2392     define variable v-i               as integer   no-undo .
     2393     define variable v-line-1          as character no-undo .
     2394     define variable v-clmn-label-1    as character no-undo .
     2395     define variable v-clmn-label-2    as character no-undo .
     2396     define variable v-clmn-label-3    as character no-undo .
     2397     define variable v-clmn-format     as character no-undo .
     2398     define variable v-clmn-sizes      as character no-undo .
     2399     define variable v-row-count       as integer   no-undo .
     2400     define variable v-tot-qnty        as decimal   no-undo .
     2401     define variable v-tot-sum         as decimal   no-undo .
     2402     define variable v-all-qnty        as decimal   no-undo .
     2403     define variable v-all-sum         as decimal   no-undo .
     2404     define variable v-price-qnty      as decimal   no-undo .
     2405     define variable v-price-sum       as decimal   no-undo .
     2406     define variable v-wth-qnty        as decimal   no-undo .
     2407     define variable v-wth-sum         as decimal   no-undo .
     2408   do
     2409   on error undo, return error return-value
     2410   :
     2411     assign
     2412       v-clmn-label-3 = "1" + chr(44) + "2" + chr(44) + "3" + chr(44) + "4" + chr(44)
     2413       v-i = 5
     2414     .
     2415     for each tt-cli-grp
     2416       by tt-cli-grp.grp-code
     2417     :
     2418       assign
     2419         v-clmn-label-1 = v-clmn-label-1 + tt-cli-grp.grp-name + chr(44) + chr(44)
     2420         v-clmn-label-2 = v-clmn-label-2 + "Кол-во" + chr(44) + "Сумма" + chr(44)
     2421         v-clmn-label-3 = v-clmn-label-3 + string(v-i) + chr(44) + string(v-i + 1) + chr(44)
     2422         v-clmn-format  = v-clmn-format  + substitute("&1=@;&2=@", v-i , (v-i + 1) )
     2423         v-clmn-sizes   = v-clmn-sizes   + "12" + chr(44) + "12" + chr(44)
     2424         v-line-1       = v-line-1       + substitute("&1:&2,", v-i ,  (v-i + 1) )
     2425         v-i            = v-i + 2
     2426       .
     2427     end.
     2428     assign
     2429       v-clmn-label-2 = v-clmn-label-2 + "Кол-во" + chr(44) + "Сумма" + chr(44)
     2430       v-clmn-label-3 = v-clmn-label-3 + string(v-i) + chr(44) + string(v-i + 1) + chr(44)
     2431       v-clmn-format  = v-clmn-format  + substitute("&1=@;&2=@", v-i , (v-i + 1) )
     2432       v-clmn-sizes   = v-clmn-sizes   + "12" + chr(44) + "12" + chr(44)
     2433       v-line-1       = v-line-1       + substitute("&1:&2,", v-i ,  (v-i + 1) )
     2434     .
     2435     assign
     2436       v-clmn-label-3  = trim(v-clmn-label-3 , chr(44) )
     2437       v-clmn-format   = trim(v-clmn-format , ";")
     2438       v-clmn-sizes    = trim(v-clmn-sizes  , chr(44) )
     2439       v-line-1        = trim(v-line-1 , ",")
     2440     .
     2441     assign
     2442       sheetf.sheet-num          = 1
     2443       sheetf.MergeCellsH        = v-line-1
     2444       sheetf.MergeCellsV        = "1=1:2/2=1:2/3=1:2"
     2445       sheetf.Excel-Column-Lable = "№ п/п"  + chr(44) + "Наименование" + chr(44) + "Номинал" + chr(44) + "Цена" + chr(44) + v-clmn-label-1 + "Итого" + chr(44) + chr(44)
     2446                                   + chr(10)
     2447                                            + chr(44)                  + chr(44)             + chr(44)          + chr(44) + v-clmn-label-2
     2448                                   + chr(10)
     2449                                                                                                                                                  + v-clmn-label-3
     2450       sheetf.colformat          = "1=@;2=@;3=@;4=@;" + v-clmn-format
     2451       sheetf.Sizes              = "5" + chr(44) + "32" + chr(44) + "10" + chr(44) + "10" + chr(44)
     2452                                   + v-clmn-sizes
     2453     .
     2454     run rep/extitle.p (1).
     2455     assign
     2456       v-row-count = 1
     2457     .
     2458     for each tt-report-price
     2459         break by tt-report-price.sale-grp-code
     2460               by tt-report-price.wth-code
     2461               by tt-report-price.price-rubl descending
     2462               by tt-report-price.par-code
     2463               by tt-report-price.grp-code
     2464     :
     2465       if first-of(tt-report-price.sale-grp-code)
     2466       then do:
     2467         if Make-Excel then  put   stream ForExcel unformatted
     2468           " "                     CHR(9)
     2469           tt-report-price.sale-grp-name CHR(9)
     2470           " "                     CHR(9)
     2471         .
     2472         for each tt-cli-grp
     2473         :
     2474           if Make-Excel then  put   stream ForExcel unformatted
     2475             " "                     CHR(9)
     2476             " "                     CHR(9)
     2477           .
     2478         end.
     2479         if Make-Excel then  put   stream ForExcel unformatted skip.
     2480       end.
     2481       if first-of(tt-report-price.wth-code) or first-of(tt-report-price.par-code) or first-of(tt-report-price.price-rubl)
     2482       then do:
     2483         if Make-Excel then  put   stream ForExcel unformatted
     2484           string(v-row-count, ">9")             CHR(9)
     2485           tt-report-price.wth-name              CHR(9)
     2486           tt-report-price.par-name              CHR(9)
     2487           to-string(tt-report-price.price-rubl,"D":u) CHR(9)
     2488         .
     2489         assign
     2490           v-row-count = v-row-count + 1
     2491         .
     2492       end.
     2493       if Make-Excel then  put   stream ForExcel unformatted
     2494         to-string(tt-report-price.qnty,"I":u) CHR(9)
     2495         to-string(tt-report-price.sum,"D":u) CHR(9)
     2496       .
     2497       if last-of(tt-report-price.par-code) or last-of(tt-report-price.wth-code) or last-of(tt-report-price.price-rubl)
     2498       then do:
     2499         assign
     2500           v-tot-qnty = 0
     2501           v-tot-sum  = 0
     2502         .
     2503         for each buf_tt-report-price
     2504           where buf_tt-report-price.sale-grp-code = tt-report-price.sale-grp-code
     2505             and buf_tt-report-price.wth-code      = tt-report-price.wth-code
     2506             and buf_tt-report-price.price-rubl    = tt-report-price.price-rubl
     2507             and buf_tt-report-price.par-code      = tt-report-price.par-code
     2508         :
     2509           assign
     2510             v-tot-qnty = v-tot-qnty + buf_tt-report-price.qnty
     2511             v-tot-sum  = v-tot-sum  + buf_tt-report-price.sum
     2512           .
     2513         end.
     2514         if Make-Excel then  put   stream ForExcel unformatted
     2515           to-string(v-tot-qnty,"I":u) CHR(9)
     2516           to-string(v-tot-sum,"D":u)  CHR(9)
     2517         skip.
     2518       end.
     2519       if last-of(tt-report-price.price-rubl)
     2520       then do:
     2521         if Make-Excel then  put   stream ForExcel unformatted
     2522           " "               CHR(9)
     2523           "Итого по ценам"  CHR(9)
     2524           " "               CHR(9)
     2525           " "               CHR(9)
     2526         .
     2527         for each buf_tt-report-price
     2528           where buf_tt-report-price.sale-grp-code = tt-report-price.sale-grp-code
     2529             and buf_tt-report-price.wth-code      = tt-report-price.wth-code
     2530             and buf_tt-report-price.price-rubl    = tt-report-price.price-rubl
     2531         break by buf_tt-report-price.grp-code
     2532         :
     2533           assign
     2534             v-price-qnty = v-price-qnty + buf_tt-report-price.qnty
     2535             v-price-sum  = v-price-sum  + buf_tt-report-price.sum
     2536           .
     2537           if last-of(buf_tt-report-price.grp-code)
     2538           then do:
     2539             if Make-Excel then  put   stream ForExcel unformatted
     2540               to-string(v-price-qnty,"I":u) CHR(9)
     2541               to-string(v-price-sum,"D":u)  CHR(9)
     2542             .
     2543             assign
     2544               v-price-qnty = 0
     2545               v-price-sum  = 0
     2546             .
     2547           end.
     2548         end.
     2549         if Make-Excel then  put   stream ForExcel unformatted
     2550         skip.
     2551       end.
     2552       if last-of(tt-report-price.wth-code)
     2553       then do:
     2554         if Make-Excel then  put   stream ForExcel unformatted
     2555           " "                                                     CHR(9)
     2556           substitute( "Итого по &1 " , tt-report-price.wth-name)  CHR(9)
     2557           " "                                                     CHR(9)
     2558           " "                                                     CHR(9)
     2559         .
     2560         for each buf_tt-report-price
     2561           where buf_tt-report-price.sale-grp-code = tt-report-price.sale-grp-code
     2562             and buf_tt-report-price.wth-code      = tt-report-price.wth-code
     2563         break by buf_tt-report-price.grp-code
     2564         :
     2565           assign
     2566             v-wth-qnty = v-wth-qnty + buf_tt-report-price.qnty
     2567             v-wth-sum  = v-wth-sum  + buf_tt-report-price.sum
     2568           .
     2569           if last-of(buf_tt-report-price.grp-code)
     2570           then do:
     2571             if Make-Excel then  put   stream ForExcel unformatted
     2572               to-string(v-wth-qnty,"I":u) CHR(9)
     2573               to-string(v-wth-sum,"D":u)  CHR(9)
     2574             .
     2575             assign
     2576               v-wth-qnty = 0
     2577               v-wth-sum  = 0
     2578             .
     2579           end.
     2580         end.
     2581         if Make-Excel then  put   stream ForExcel unformatted
     2582         skip.
     2583       end.
     2584       if last-of(tt-report-price.sale-grp-code)
     2585       then do:
     2586         if Make-Excel then  put   stream ForExcel unformatted
     2587           " "     CHR(9)
     2588           "Итого" CHR(9)
     2589           " "     CHR(9)
     2590           " "     CHR(9)
     2591         .
     2592         assign
     2593           v-tot-qnty = 0
     2594           v-tot-sum  = 0
     2595         .
     2596         for each buf_tt-report-price
     2597           where buf_tt-report-price.sale-grp-code = tt-report-price.sale-grp-code
     2598             break by buf_tt-report-price.grp-code
     2599         :
     2600           assign
     2601             v-tot-qnty = v-tot-qnty + buf_tt-report-price.qnty
     2602             v-tot-sum  = v-tot-sum  + buf_tt-report-price.sum
     2603           .
     2604           if last-of(buf_tt-report-price.grp-code)
     2605           then do:
     2606             if Make-Excel then  put   stream ForExcel unformatted
     2607               to-string(v-tot-qnty,"I":u) CHR(9)
     2608               to-string(v-tot-sum,"D":u) CHR(9)
     2609             .
     2610             assign
     2611               v-tot-qnty = 0
     2612               v-tot-sum  = 0
     2613             .
     2614           end.
     2615         end.
     2616         if Make-Excel then  put   stream ForExcel unformatted skip.
     2617         assign
     2618           v-row-count = 1
     2619         .
     2620       end.
     2621     end.
     2622     if Make-Excel then  put   stream ForExcel unformatted
     2623       " "             CHR(9)
     2624       "Итого по МЦ:"  CHR(9)
     2625       " "             CHR(9)
     2626     skip.
     2627     assign
     2628       v-row-count   = 1
     2629       v-tot-qnty    = 0
     2630       v-tot-sum     = 0
     2631       v-price-qnty  = 0
     2632       v-price-sum   = 0
     2633       v-wth-qnty    = 0
     2634       v-wth-sum     = 0
     2635     .
     2636     for each tt-report-price
     2637       break by tt-report-price.wth-code
     2638             by tt-report-price.price-rubl descending
     2639             by tt-report-price.par-code
     2640             by tt-report-price.grp-code
     2641     :
     2642       if first-of(tt-report-price.wth-code) or first-of(tt-report-price.par-code) or first-of(tt-report-price.price-rubl)
     2643       then do:
     2644         if Make-Excel then  put   stream ForExcel unformatted
     2645           string(v-row-count, ">9")       CHR(9)
     2646           tt-report-price.wth-name        CHR(9)
     2647           tt-report-price.par-name        CHR(9)
     2648           to-string(tt-report-price.price-rubl,"D":u) CHR(9)
     2649         .
     2650         assign
     2651           v-row-count = v-row-count + 1
     2652           v-tot-qnty  = 0
     2653           v-tot-sum   = 0
     2654         .
     2655       end.
     2656       assign
     2657         v-tot-qnty = v-tot-qnty + tt-report-price.qnty
     2658         v-tot-sum  = v-tot-sum  + tt-report-price.sum
     2659       .
     2660       if last-of(tt-report-price.grp-code)
     2661       then do:
     2662         if Make-Excel then  put   stream ForExcel unformatted
     2663           to-string(v-tot-qnty,"I":u) CHR(9)
     2664           to-string(v-tot-sum,"D":u)   CHR(9)
     2665         .
     2666         assign
     2667           v-tot-qnty  = 0
     2668           v-tot-sum   = 0
     2669         .
     2670       end.
     2671       if last-of(tt-report-price.wth-code) or last-of(tt-report-price.par-code)
     2672       then do:
     2673         assign
     2674           v-tot-qnty = 0
     2675           v-tot-sum  = 0
     2676         .
     2677         for each buf_tt-report-price
     2678           where buf_tt-report-price.wth-code      = tt-report-price.wth-code
     2679             and buf_tt-report-price.par-code      = tt-report-price.par-code
     2680         :
     2681           assign
     2682             v-tot-qnty = v-tot-qnty + buf_tt-report-price.qnty
     2683             v-tot-sum  = v-tot-sum  + buf_tt-report-price.sum
     2684           .
     2685         end.
     2686         if Make-Excel then  put   stream ForExcel unformatted
     2687           to-string(v-tot-qnty,"I":u) CHR(9)
     2688           to-string(v-tot-sum,"D":u)   CHR(9)
     2689         skip.
     2690       end.
     2691       if last-of(tt-report-price.price-rubl)
     2692       then do:
     2693         if Make-Excel then  put   stream ForExcel unformatted
     2694           " "               CHR(9)
     2695           "Итого по ценам"  CHR(9)
     2696           " "               CHR(9)
     2697           " "               CHR(9)
     2698         .
     2699         for each buf_tt-report-price
     2700           where buf_tt-report-price.wth-code    = tt-report-price.wth-code
     2701             and buf_tt-report-price.price-rubl  = tt-report-price.price-rubl
     2702         break by buf_tt-report-price.grp-code
     2703         :
     2704           assign
     2705             v-price-qnty  = v-price-qnty + buf_tt-report-price.qnty
     2706             v-price-sum  = v-price-sum  + buf_tt-report-price.sum
     2707           .
     2708           if last-of(buf_tt-report-price.grp-code)
     2709           then do:
     2710             if Make-Excel then  put   stream ForExcel unformatted
     2711               to-string(v-price-qnty,"I":u) CHR(9)
     2712               to-string(v-price-sum,"D":u)  CHR(9)
     2713             .
     2714             assign
     2715               v-price-qnty = 0
     2716               v-price-sum  = 0
     2717             .
     2718           end.
     2719         end.
     2720         if Make-Excel then  put   stream ForExcel unformatted
     2721         skip.
     2722       end.
     2723       if last-of(tt-report-price.wth-code)
     2724       then do:
     2725         if Make-Excel then  put   stream ForExcel unformatted
     2726           " "                                                     CHR(9)
     2727           substitute( "Итого по &1 " , tt-report-price.wth-name)  CHR(9)
     2728           " "                                                     CHR(9)
     2729           " "                                                     CHR(9)
     2730         .
     2731         for each buf_tt-report-price
     2732           where buf_tt-report-price.wth-code      = tt-report-price.wth-code
     2733         break by buf_tt-report-price.grp-code
     2734         :
     2735           assign
     2736             v-wth-qnty = v-wth-qnty + buf_tt-report-price.qnty
     2737             v-wth-sum  = v-wth-sum  + buf_tt-report-price.sum
     2738           .
     2739           if last-of(buf_tt-report-price.grp-code)
     2740           then do:
     2741             if Make-Excel then  put   stream ForExcel unformatted
     2742               to-string(v-wth-qnty,"I":u) CHR(9)
     2743               to-string(v-wth-sum,"D":u)  CHR(9)
     2744             .
     2745             assign
     2746               v-wth-qnty = 0
     2747               v-wth-sum  = 0
     2748             .
     2749           end.
     2750         end.
     2751         if Make-Excel then  put   stream ForExcel unformatted
     2752         skip.
     2753       end.
     2754     end.
     2755     assign
     2756       v-tot-qnty = 0
     2757       v-tot-sum  = 0
     2758     .
     2759     if Make-Excel then  put   stream ForExcel unformatted
     2760       " "       CHR(9)
     2761       "ВСЕГО:"  CHR(9)
     2762       " "       CHR(9)
     2763       " "       CHR(9)
     2764     .
     2765     for each tt-report-price
     2766       break by tt-report-price.grp-code
     2767     :
     2768       assign
     2769         v-tot-qnty = v-tot-qnty + tt-report-price.qnty
     2770         v-tot-sum  = v-tot-sum  + tt-report-price.sum
     2771       .
     2772       if last-of(tt-report-price.grp-code)
     2773       then do:
     2774         if Make-Excel then  put   stream ForExcel unformatted
     2775           to-string(v-tot-qnty,"I":u) CHR(9)
     2776           to-string(v-tot-sum,"D":u)  CHR(9)
     2777         .
     2778         assign
     2779           v-all-qnty = v-all-qnty + v-tot-qnty
     2780           v-all-sum  = v-all-sum  + v-tot-sum
     2781           v-tot-qnty = 0
     2782           v-tot-sum  = 0
     2783         .
     2784       end.
     2785     end.
     2786     if Make-Excel then  put   stream ForExcel unformatted
     2787       to-string(v-all-qnty,"I":u) CHR(9)
     2788       to-string(v-all-sum,"D":u)  CHR(9)
     2789     skip.
     2790   end.
     2791   end procedure.
     2792   procedure print-report-no-price :
     2793   do
     2794   on error undo, return error return-value
     2795   :
     2796     define buffer buf_tt-report               for tt-report.
     2797     define buffer buf_wth-par                 for ub.wth-par .
     2798     define buffer buf_tt-cli-grp              for tt-cli-grp.
     2799     define buffer buf_tt-wealth               for tt-wealth.
     2800     define variable v-i               as integer   no-undo .
     2801     define variable v-line-1          as character no-undo .
     2802     define variable v-clmn-label-1    as character no-undo .
     2803     define variable v-clmn-label-2    as character no-undo .
     2804     define variable v-clmn-label-3    as character no-undo .
     2805     define variable v-clmn-format     as character no-undo .
     2806     define variable v-clmn-sizes      as character no-undo .
     2807     define variable v-row-count       as integer   no-undo .
     2808     define variable v-tot-qnty        as decimal   no-undo .
     2809     define variable v-tot-sum         as decimal   no-undo .
     2810     define variable v-all-qnty        as decimal   no-undo .
     2811     define variable v-all-sum         as decimal   no-undo .
     2812     assign
     2813       v-clmn-label-3 = "1" + chr(44) + "2" + chr(44) + "3" + chr(44)
     2814       v-i = 4
     2815     .
     2816     for each tt-cli-grp
     2817       by tt-cli-grp.grp-code
     2818     :
     2819       assign
     2820         v-clmn-label-1 = v-clmn-label-1 + tt-cli-grp.grp-name + chr(44) + chr(44)
     2821         v-clmn-label-2 = v-clmn-label-2 + "Кол-во" + chr(44) + "Сумма" + chr(44)
     2822         v-clmn-label-3 = v-clmn-label-3 + string(v-i) + chr(44) + string(v-i + 1) + chr(44)
     2823         v-clmn-format  = v-clmn-format  + substitute("&1=@;&2=@", v-i , (v-i + 1) )
     2824         v-clmn-sizes   = v-clmn-sizes   + "12" + chr(44) + "12" + chr(44)
     2825         v-line-1       = v-line-1       + substitute("&1:&2,", v-i ,  (v-i + 1) )
     2826         v-i            = v-i + 2
     2827       .
     2828     end.
     2829     assign
     2830       v-clmn-label-2 = v-clmn-label-2 + "Кол-во" + chr(44) + "Сумма" + chr(44)
     2831       v-clmn-label-3 = v-clmn-label-3 + string(v-i) + chr(44) + string(v-i + 1) + chr(44)
     2832       v-clmn-format  = v-clmn-format  + substitute("&1=@;&2=@", v-i , (v-i + 1) )
     2833       v-clmn-sizes   = v-clmn-sizes   + "12" + chr(44) + "12" + chr(44)
     2834       v-line-1       = v-line-1       + substitute("&1:&2,", v-i ,  (v-i + 1) )
     2835     .
     2836     assign
     2837       v-clmn-label-3  = trim(v-clmn-label-3 , chr(44) )
     2838       v-clmn-format   = trim(v-clmn-format , ";")
     2839       v-clmn-sizes    = trim(v-clmn-sizes  , chr(44) )
     2840       v-line-1        = trim(v-line-1 , ",")
     2841     .
     2842     assign
     2843       sheetf.sheet-num          = 1
     2844       sheetf.MergeCellsH        = v-line-1
     2845       sheetf.MergeCellsV        = "1=1:2/2=1:2/3=1:2"
     2846       sheetf.Excel-Column-Lable = "№ п/п"  + chr(44) + "Наименование" + chr(44) + "Номинал" + chr(44) + v-clmn-label-1 + "Итого" + chr(44) + chr(44)
     2847                                   + chr(10)
     2848                                            + chr(44)                  + chr(44)             + chr(44) + v-clmn-label-2
     2849                                   + chr(10)
     2850                                                                                                                         + v-clmn-label-3
     2851       sheetf.colformat          = "1=@;2=@;3=@;" + v-clmn-format
     2852       sheetf.Sizes              = "5" + chr(44) + "32" + chr(44) + "10" + chr(44)
     2853                                   + v-clmn-sizes
     2854     .
     2855     run rep/extitle.p (1).
     2856     assign
     2857       v-row-count = 1
     2858     .
     2859     for each tt-report
     2860         break by tt-report.sale-grp-code
     2861               by tt-report.wth-code
     2862               by tt-report.par-code
     2863               by tt-report.grp-code
     2864     :
     2865       if first-of(tt-report.sale-grp-code)
     2866       then do:
     2867         if Make-Excel then  put   stream ForExcel unformatted
     2868           " "                     CHR(9)
     2869           tt-report.sale-grp-name CHR(9)
     2870           " "                     CHR(9)
     2871         .
     2872         for each tt-cli-grp
     2873         :
     2874           if Make-Excel then  put   stream ForExcel unformatted
     2875             " "                     CHR(9)
     2876             " "                     CHR(9)
     2877           .
     2878         end.
     2879         if Make-Excel then  put   stream ForExcel unformatted skip.
     2880       end.
     2881       if first-of(tt-report.wth-code) or first-of(tt-report.par-code)
     2882       then do:
     2883         if Make-Excel then  put   stream ForExcel unformatted
     2884           string(v-row-count, ">9") CHR(9)
     2885           tt-report.wth-name        CHR(9)
     2886           tt-report.par-name        CHR(9)
     2887         .
     2888         assign
     2889           v-row-count = v-row-count + 1
     2890         .
     2891       end.
     2892       if Make-Excel then  put   stream ForExcel unformatted
     2893         to-string(tt-report.qnty,"I":u) CHR(9)
     2894         to-string(tt-report.sum,"D":u) CHR(9)
     2895       .
     2896       if last-of(tt-report.par-code) or last-of(tt-report.wth-code)
     2897       then do:
     2898         assign
     2899           v-tot-qnty = 0
     2900           v-tot-sum  = 0
     2901         .
     2902         for each buf_tt-report
     2903           where buf_tt-report.sale-grp-code = tt-report.sale-grp-code
     2904             and buf_tt-report.wth-code      = tt-report.wth-code
     2905             and buf_tt-report.par-code      = tt-report.par-code
     2906         :
     2907           assign
     2908             v-tot-qnty = v-tot-qnty + buf_tt-report.qnty
     2909             v-tot-sum  = v-tot-sum  + buf_tt-report.sum
     2910           .
     2911         end.
     2912         if Make-Excel then  put   stream ForExcel unformatted
     2913           to-string(v-tot-qnty,"I":u) CHR(9)
     2914           to-string(v-tot-sum,"D":u)  CHR(9)
     2915         skip.
     2916       end.
     2917       if last-of(tt-report.sale-grp-code)
     2918       then do:
     2919         if Make-Excel then  put   stream ForExcel unformatted
     2920           " "     CHR(9)
     2921           "Итого" CHR(9)
     2922           " "     CHR(9)
     2923         .
     2924         assign
     2925           v-tot-qnty = 0
     2926           v-tot-sum  = 0
     2927         .
     2928         for each buf_tt-report
     2929           where buf_tt-report.sale-grp-code = tt-report.sale-grp-code
     2930             break by buf_tt-report.grp-code
     2931         :
     2932           assign
     2933             v-tot-qnty = v-tot-qnty + buf_tt-report.qnty
     2934             v-tot-sum  = v-tot-sum  + buf_tt-report.sum
     2935           .
     2936           if last-of(buf_tt-report.grp-code)
     2937           then do:
     2938             if Make-Excel then  put   stream ForExcel unformatted
     2939               to-string(v-tot-qnty,"I":u) CHR(9)
     2940               to-string(v-tot-sum,"D":u)   CHR(9)
     2941             .
     2942             assign
     2943               v-tot-qnty = 0
     2944               v-tot-sum  = 0
     2945             .
     2946           end.
     2947         end.
     2948         if Make-Excel then  put   stream ForExcel unformatted skip.
     2949         assign
     2950           v-row-count = 1
     2951         .
     2952       end.
     2953     end.
     2954     if Make-Excel then  put   stream ForExcel unformatted
     2955       " "             CHR(9)
     2956       "Итого по МЦ:" CHR(9)
     2957     skip.
     2958     assign
     2959       v-row-count = 1
     2960     .
     2961     for each tt-report
     2962       break by tt-report.wth-code
     2963             by tt-report.par-code
     2964             by tt-report.grp-code
     2965     :
     2966       if first-of(tt-report.wth-code) or first-of(tt-report.par-code)
     2967       then do:
     2968         if Make-Excel then  put   stream ForExcel unformatted
     2969           string(v-row-count, ">9") CHR(9)
     2970           tt-report.wth-name        CHR(9)
     2971           tt-report.par-name        CHR(9)
     2972         .
     2973         assign
     2974           v-row-count = v-row-count + 1
     2975           v-tot-qnty  = 0
     2976           v-tot-sum   = 0
     2977         .
     2978       end.
     2979       assign
     2980         v-tot-qnty = v-tot-qnty + tt-report.qnty
     2981         v-tot-sum  = v-tot-sum  + tt-report.sum
     2982       .
     2983       if last-of(tt-report.grp-code)
     2984       then do:
     2985         if Make-Excel then  put   stream ForExcel unformatted
     2986           to-string(v-tot-qnty,"I":u) CHR(9)
     2987           to-string(v-tot-sum,"D":u)   CHR(9)
     2988         .
     2989         assign
     2990           v-tot-qnty  = 0
     2991           v-tot-sum   = 0
     2992         .
     2993       end.
     2994       if last-of(tt-report.wth-code) or last-of(tt-report.par-code)
     2995       then do:
     2996         assign
     2997           v-tot-qnty = 0
     2998           v-tot-sum  = 0
     2999         .
     3000         for each buf_tt-report
     3001           where buf_tt-report.wth-code      = tt-report.wth-code
     3002             and buf_tt-report.par-code      = tt-report.par-code
     3003         :
     3004           assign
     3005             v-tot-qnty = v-tot-qnty + buf_tt-report.qnty
     3006             v-tot-sum  = v-tot-sum  + buf_tt-report.sum
     3007           .
     3008         end.
     3009         if Make-Excel then  put   stream ForExcel unformatted
     3010           to-string(v-tot-qnty,"I":u) CHR(9)
     3011           to-string(v-tot-sum,"D":u)   CHR(9)
     3012         skip.
     3013       end.
     3014     end.
     3015     assign
     3016       v-tot-qnty = 0
     3017       v-tot-sum  = 0
     3018     .
     3019     if Make-Excel then  put   stream ForExcel unformatted
     3020       " "       CHR(9)
     3021       "ВСЕГО:"  CHR(9)
     3022       " "       CHR(9)
     3023     .
     3024     for each tt-report
     3025       break by tt-report.grp-code
     3026     :
     3027       assign
     3028         v-tot-qnty = v-tot-qnty + tt-report.qnty
     3029         v-tot-sum  = v-tot-sum  + tt-report.sum
     3030       .
     3031       if last-of(tt-report.grp-code)
     3032       then do:
     3033         if Make-Excel then  put   stream ForExcel unformatted
     3034           to-string(v-tot-qnty,"I":u) CHR(9)
     3035           to-string(v-tot-sum,"D":u)   CHR(9)
     3036         .
     3037         assign
     3038           v-all-qnty = v-all-qnty + v-tot-qnty
     3039           v-all-sum  = v-all-sum  + v-tot-sum
     3040           v-tot-qnty = 0
     3041           v-tot-sum  = 0
     3042         .
     3043       end.
     3044     end.
     3045     if Make-Excel then  put   stream ForExcel unformatted
     3046       to-string(v-all-qnty,"I":u) CHR(9)
     3047       to-string(v-all-sum,"D":u)   CHR(9)
     3048     skip.
     3049   end.
     3050   end procedure.
     3051   function to-string returns character (p-val as decimal , p-type as character) :
     3052     define variable v-ret-val as character no-undo .
     3053     run proc-to-string  in this-procedure ( input p-val
     3054                                           , input p-type
     3055                                           , output v-ret-val
     3056                                           ) .
     3057     return v-ret-val.
     3058   end function.
     3059   procedure proc-to-string :
     3060     define input  parameter p-val   as decimal   no-undo .
     3061     define input  parameter p-type  as character no-undo .
     3062     define output parameter p-ret-val   as character no-undo .
     3063     define variable v-format as character no-undo .
     3064   do
     3065   on error undo, return error return-value
     3066   :
     3067     case p-type
     3068     :
     3069       when "D"
     3070       then do:
     3071         assign
     3072           v-format = ">>>>>>>>>9.99"
     3073         .
     3074       end.
     3075       when "I"
     3076       then do:
     3077         assign
     3078           v-format = ">>>>>>>>>9"
     3079         .
     3080       end.
     3081       otherwise do:
     3082         undo, return error "Процедуре proc-to-string передано неверное значение параметра p-type.".
     3083       end.
     3084     end case.
     3085     assign
     3086       p-ret-val = ( if p-val = 0 then " " else trim(replace(string(p-val, v-format) , '.' , ',')) )
     3087     .
     3088   end.
     3089   end procedure.
