      358   def
      359   new shared
      360   temp-table  obj-list no-undo
      361     field obj-type like ub.clients.obj-type
      362     field obj-code like ub.clients.obj-code
      363     field obj-name like ub.clients.obj-name
      364     field obj-id   as integer
