      130   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      131   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      132   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      133   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      134   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      135   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      136   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      137   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      138   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
