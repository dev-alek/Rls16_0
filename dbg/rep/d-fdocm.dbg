      144   define temp-table Tmp#List no-undo like ub.ord-blank
      145   field id                        as integer
      146   field proc-name                 as character
      147   field proc-param                as character
      148   field print-options             as character
      149   field orient                    as character
      150   field orient-orientation        as character
      151   field orient-font-num           as integer
      152   field font-num                  as character
      153   field filtr                     as character
      154   field view_                     as integer  init 1
      155   field sys-key                   as character
      156   field sys-key-black             as character
      157   field type-val                  as character
      158   field type-val-enabled          as logical
      159   index pi is primary unique id
      160   index in-name
      161   blank-name
      162   index lu
      163   last-use
      164   .
      165   define temp-table temp_form-list no-undo
      166   field host-code as integer
      167   field fin-doc-code  as integer
      168   field id        as integer
      169   field fin-doc-type  as character
      170   field status_   as character
      171   index pi is primary unique
      172   host-code
      173   fin-doc-code
      174   id
      175   index idx
      176   id
      177   .
      178   define temp-table temp_menu-doc_disabled-doc-list no-undo
      179   field host-code      as integer
      180   field fin-doc-code      as integer
      181   field blank-name    as character
      182   field reason        as character
      183   index pi is primary unique
      184   host-code
      185   fin-doc-code
      186   blank-name
      187   .
      188   define variable v-menu-doc-sys-key              as character    no-undo.
      189   define variable v-menu-doc-fin-doc-code         as integer      no-undo.
      190   define variable v-menu-doc-host-code            as integer      no-undo .
      191   define variable v-menu-doc-fin-doc-type         as character    no-undo.
      192   define variable v-menu-doc-fin-ext-doc-type     as character    no-undo.
      193   define variable v-menu-doc-status_              as character    no-undo.
      194   define variable v-menu-doc-item-counter         as integer      no-undo.
      195   define variable v-menu-doc-item-disabled        as logical      no-undo.
      196   define variable vss-include-info3 as character format "X(65)":U no-undo initial "@(#)$Workfile$ $Revision$".
      197   function check-entry-with-mask returns logical ( input p-element as character, input p-list as character, input p-delimiter as character ) :
      198     define variable p-entry   as logical   no-undo .
      199     define variable v-ind as integer   no-undo .
      200     if p-delimiter = "*":U then do:
      201       message
      202         vss-workfile "(check-entry-with-mask)" vss-revision vss-description skip
      203         substitute('Разделитель не может быть равный "&1"', p-delimiter ) skip
      204         view-as alert-box error .
      205       return ? .
      206     end.
      207     assign
      208       p-entry = true
      209     .
      210     if lookup( p-element, p-list, p-delimiter ) = 0 then do:
      211       assign
      212         p-entry = false
      213       .
      214       if num-entries( p-list, "*":U ) > 1 then do:
      215         block_check-list:
      216         do v-ind = 1 to num-entries( p-list, p-delimiter )
      217         :
      218           if p-element matches entry( v-ind, p-list, p-delimiter ) then do:
      219             assign
      220               p-entry = true
      221             .
      222             leave block_check-list .
      223           end.
      224         end.
      225       end.
      226     end.
      227     return p-entry .
      228   end function .
      229   procedure menufdoc-create-menu-item
      230   :
      231   define input parameter p-type   as   character no-undo.
      232   define input parameter p-stat   as   character no-undo.
      233   define input parameter param-1  as   character no-undo.
      234   define input parameter param-2  as   character no-undo.
      235   define input parameter param-5  as   character no-undo.
      236   define input parameter param-6  as   character no-undo.
      237   define input parameter param-7  as   character no-undo.
      238   define input parameter param-8  as   character no-undo.
      239   define input parameter param-9  as   character no-undo.
      240   define input parameter param-10 as   character no-undo.
      241   define input parameter param-11 as   character no-undo.
      242   define input parameter param-12 as   character no-undo.
      243   do
      244   on error undo, return error
      245   :
      246     assign
      247     v-menu-doc-item-disabled = yes
      248       .
      249     if v-menu-doc-sys-key <> 'ExpertekIBS':U
      250     and ( ( param-10 <> "":U
      251             and check-entry-with-mask( v-menu-doc-sys-key, param-10, chr(44) ) = false
      252           )
      253           or ( param-12 <> "":U
      254                 and check-entry-with-mask( v-menu-doc-sys-key, param-12, chr(44) ) = true )
      255               )
      256     then do:
      257       undo, return .
      258     end.
      259     if param-7 = "":U
      260     then do:
      261       undo, return .
      262     end.
      263     if param-1 = '*':U
      264     or lookup( p-type, param-1 ) > 0
      265     then do:
      266       if param-2 = '*':U
      267       or lookup( p-stat, param-2 ) > 0
      268       then do:
      269         assign
      270        v-menu-doc-item-disabled = no
      271         .
      272         find first tmp#list
      273               where tmp#list.blank-name     = param-5
      274                 and tmp#list.filtr          = param-6
      275                 and tmp#list.proc-name      = param-7
      276                 and tmp#list.proc-param     = param-8
      277                 and tmp#list.print-options  = param-9
      278                 and tmp#list.sys-key        = param-10
      279                 and tmp#list.orient         = param-11
      280                 and tmp#list.sys-key-black  = param-12
      281         no-error.
      282         if not available tmp#list
      283         then do:
      284           assign
      285           v-menu-doc-item-counter = v-menu-doc-item-counter + 1
      286           .
      287           create tmp#list.
      288           assign
      289           tmp#list.id             = v-menu-doc-item-counter
      290           tmp#list.cli-code       = v-menu-doc-item-counter
      291           tmp#list.blank-name     = param-5
      292           tmp#list.filtr          = param-6
      293           tmp#list.proc-name      = param-7
      294           tmp#list.proc-param     = param-8
      295           tmp#list.print-options  = param-9
      296           tmp#list.sys-key        = param-10
      297           tmp#list.orient         = param-11
      298           tmp#list.sys-key-black  = param-12
      299           .
      300           assign
      301           tmp#list.orient-orientation     = entry( 1, tmp#list.orient )
      302           tmp#list.orient-font-num        = 7
      303           .
      304           assign
      305           tmp#list.orient-font-num      = ( if num-entries( tmp#list.orient ) > 1
      306                                             then integer( entry( 2, tmp#list.orient ) )
      307                                             else 7 )
      308           no-error.
      309           if error-status :error
      310           then do:
      311             assign
      312             tmp#list.orient-font-num = 7
      313             .
      314           end.
      315           run menufdoc-set-visible-options in this-procedure (
      316                 input tmp#list.print-options
      317               , output tmp#list.type-val-enabled
      318           ).
      319         end.
      320       end.
      321     end.
      322     if v-menu-doc-item-disabled = yes then do:
      323       find first tmp#list
      324             where tmp#list.blank-name     = param-5
      325               and tmp#list.filtr          = param-6
      326               and tmp#list.proc-name      = param-7
      327               and tmp#list.proc-param     = param-8
      328               and tmp#list.print-options  = param-9
      329               and tmp#list.sys-key        = param-10
      330               and tmp#list.orient         = param-11
      331               and tmp#list.sys-key-black  = param-12
      332         no-error.
      333     if available tmp#list
      334     then do:
      335       find first temp_menu-doc_disabled-doc-list
      336             where temp_menu-doc_disabled-doc-list.host-code     = v-menu-doc-host-code
      337               and temp_menu-doc_disabled-doc-list.fin-doc-code     = v-menu-doc-fin-doc-code
      338               and temp_menu-doc_disabled-doc-list.blank-name   = param-5
      339       no-error.
      340       if not available temp_menu-doc_disabled-doc-list
      341       then do:
      342         create temp_menu-doc_disabled-doc-list.
      343         assign
      344         temp_menu-doc_disabled-doc-list.host-code    = v-menu-doc-host-code
      345         temp_menu-doc_disabled-doc-list.fin-doc-code    = v-menu-doc-fin-doc-code
      346         temp_menu-doc_disabled-doc-list.blank-name  = param-5
      347         .
      348       end.
      349       if param-1 <> '*':U
      350       and lookup( p-type, param-1 ) > 0
      351       then do:
      352         assign
      353         temp_menu-doc_disabled-doc-list.reason   = "type":U
      354         .
      355       end.
      356       assign
      357       temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + ",":U
      358       .
      359       if param-2 <> '*':U
      360       and lookup( p-stat, param-2 ) > 0
      361       then do:
      362         assign
      363         temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + "stat":U
      364         .
      365       end.
      366       assign
      367       temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + ",":U
      368       .
      369       assign
      370       temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + ",":U
      371       .
      372       if v-menu-doc-sys-key = 'ExpertekIBS':U
      373       then do:
      374         run menufdoc-extend-blank-name-for-IBS in this-procedure (
      375                 input tmp#list.blank-name
      376               , input tmp#list.sys-key
      377               , input Tmp#List.sys-key-black
      378               , output tmp#list.blank-name
      379           ).
      380       end.
      381     end.
      382     else do:
      383       assign
      384       v-menu-doc-item-disabled = no
      385       .
      386     end.
      387   end.
      388     if v-menu-doc-item-disabled = no
      389     then do:
      390       find first tmp#list
      391             where tmp#list.blank-name     = param-5
      392               and tmp#list.filtr          = param-6
      393               and tmp#list.proc-name      = param-7
      394               and tmp#list.proc-param     = param-8
      395               and tmp#list.print-options  = param-9
      396               and tmp#list.sys-key        = param-10
      397               and tmp#list.orient         = param-11
      398               and tmp#list.sys-key-black  = param-12
      399       no-error.
      400       if available tmp#list
      401       then do:
      402         find first temp_form-list
      403               where temp_form-list.host-code  = v-menu-doc-host-code
      404                 and temp_form-list.fin-doc-code  = v-menu-doc-fin-doc-code
      405                 and temp_form-list.id        = tmp#list.id
      406         no-error.
      407         if not available temp_form-list then do:
      408           create temp_form-list.
      409           assign
      410           temp_form-list.host-code      = v-menu-doc-host-code
      411           temp_form-list.fin-doc-code  = v-menu-doc-fin-doc-code
      412           temp_form-list.id        = tmp#list.id
      413           temp_form-list.fin-doc-type  = v-menu-doc-fin-doc-type
      414           temp_form-list.status_   = v-menu-doc-status_
      415           .
      416          end.
      417          if v-menu-doc-sys-key = 'ExpertekIBS':U
      418          then do:
      419            run menufdoc-extend-blank-name-for-IBS in this-procedure (
      420                         input tmp#list.blank-name
      421                       , input tmp#list.sys-key
      422                       , input Tmp#List.sys-key-black
      423                       , output tmp#list.blank-name
      424                   ).
      425          end.
      426        end.
      427     end.
      428   end.
      429   end procedure.
      430   procedure menufdoc-set-visible-options :
      431   define input parameter p-print-options          as character        no-undo.
      432   define output parameter p-type-val-enabled      as logical          no-undo.
      433   do
      434   on error undo, return error
      435   :
      436     assign
      437     p-type-val-enabled      = ( if substring( p-print-options, 1, 1 ) = "+" then yes else no )
      438     .
      439   end.
      440   end procedure.
      441   procedure menufdoc-create-options-string :
      442   define input parameter p-tmp-list-id        as integer          no-undo.
      443   define output parameter p-options-string    as character        no-undo.
      444   define buffer buf_tmp#list      for tmp#list.
      445   do
      446   for buf_tmp#list
      447   on error undo, return error
      448   :
      449     find first buf_tmp#list
      450           where buf_tmp#list.id = p-tmp-list-id
      451     .
      452     assign
      453     p-options-string =  ( if trim( buf_tmp#list.type-val    ) = "+":U then "+":U else "-":U )
      454     .
      455   end.
      456   end procedure.
      457   procedure menufdoc-set-options-string :
      458   define input parameter p-tmp-list-id            as integer          no-undo.
      459   define input parameter p-options-string         as character        no-undo.
      460   define buffer buf_tmp#list      for tmp#list.
      461   do
      462   for buf_tmp#list
      463   on error undo, return error
      464   :
      465     find first buf_tmp#list
      466           where buf_tmp#list.id = p-tmp-list-id
      467     .
      468     assign
      469     buf_tmp#list.type-val    = ( if buf_tmp#list.type-val-enabled       = yes then substitute( "  &1", substring( p-options-string, 1, 1 ) ) else " ":U )
      470       .
      471   end.
      472   end procedure.
      473   procedure menufdoc-create-options-enabled-string :
      474   define input parameter p-tmp-list-id                as integer          no-undo.
      475   define output parameter p-options-enabled-string    as character        no-undo.
      476   define buffer buf_tmp#list      for tmp#list.
      477   do
      478   for buf_tmp#list
      479   on error undo, return error
      480   :
      481     find first buf_tmp#list
      482           where buf_tmp#list.id = p-tmp-list-id
      483       .
      484    assign
      485     p-options-enabled-string =  ( if buf_tmp#list.type-val-enabled    = yes then "+":U else "-":U )
      486                                   .
      487   end.
      488   end procedure.
      489   procedure menufdoc-extend-blank-name-for-IBS :
      490   define input parameter p-in-blank-name      as character        no-undo.
      491   define input parameter p-sys-key            as character        no-undo.
      492   define input parameter p-sys-key-black      as character        no-undo.
      493   define output parameter p-out-blank-name    as character        no-undo.
      494   do
      495   on error undo, return error
      496   :
      497     assign
      498     p-out-blank-name = p-in-blank-name
      499     .
      500     if p-sys-key <> "":U
      501     then do:
      502       assign
      503       p-out-blank-name = substring( p-in-blank-name + " '" + p-sys-key + "'" , 1, 120 )
      504       .
      505     end.
      506     if p-sys-key-black <> ""
      507     then do:
      508       assign
      509       p-out-blank-name = substring( p-in-blank-name + " no-'" + p-sys-key-black + "'", 1, 120 )
      510       .
      511     end.
      512   end.
      513   end procedure.
