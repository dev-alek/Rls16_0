     2314   PROCEDURE disable_UI :
     2315     HIDE FRAME Dialog-Frame.
     2316   END PROCEDURE.
     2317   PROCEDURE enable_UI :
     2318     DISPLAY fi-default-printer
     2319         WITH FRAME Dialog-Frame.
     2320     ENABLE b-exit b-chg b-print-doc b-help i-print br-table fi-default-printer
     2321         WITH FRAME Dialog-Frame.
     2322     VIEW FRAME Dialog-Frame.
     2323     run local-open-query in this-procedure .
     2324   END PROCEDURE.
     2325   PROCEDURE get-call-point :
     2326   define input parameter p-tmp#list-id as integer          no-undo.
     2327   define output parameter p-call-point as character        no-undo.
     2328   define variable v-doc-type        as character    no-undo.
     2329   define variable v-doc-status      as character    no-undo.
     2330   define buffer buf_temp_form-list        for temp_form-list.
     2331   do
     2332   for buf_temp_form-list
     2333   on error undo, return error
     2334   :
     2335     assign
     2336     v-doc-type     = "":U
     2337     v-doc-status   = "":U
     2338     .
     2339     for each buf_temp_form-list
     2340         where buf_temp_form-list.id = Tmp#List.id
     2341     :
     2342       if lookup( buf_temp_form-list.fin-doc-type, v-doc-type ) = 0
     2343       then do:
     2344         assign
     2345         v-doc-type = ( if v-doc-type = "":U then "":U else "_":U ) + buf_temp_form-list.fin-doc-type
     2346         .
     2347       end.
     2348       if lookup( buf_temp_form-list.status_, v-doc-status ) = 0
     2349       then do:
     2350         assign
     2351         v-doc-status = ( if v-doc-status = "":U then "":U else "_":U ) + buf_temp_form-list.status_
     2352               .
     2353       end.
     2354     end.
     2355     assign
     2356     p-call-point = substitute( "&1,&2", v-doc-type, v-doc-status )
     2357     .
     2358   end.
     2359   END PROCEDURE.
     2360   PROCEDURE get-handle-all-docs :
     2361   define output parameter p-handle as handle no-undo .
     2362   p-handle =  p-call-handle .
     2363   END PROCEDURE.
     2364   PROCEDURE get-saved-character :
     2365   define input parameter p-list           as character        no-undo.
     2366   define input parameter p-name           as character        no-undo.
     2367   define output parameter p-character     as character        no-undo.
     2368   define variable v-position    as integer      no-undo.
     2369   do
     2370   on error undo, return error
     2371   :
     2372     assign
     2373     v-position = lookup( p-name, p-list )
     2374     .
     2375     if v-position = 0
     2376     then do:
     2377       assign
     2378       p-character = "":U
     2379           .
     2380     end.
     2381     else do:
     2382       if num-entries( p-list ) > v-position
     2383       then do:
     2384         assign
     2385         p-character = entry( v-position + 1, p-list )
     2386         .
     2387       end.
     2388       else do:
     2389         assign
     2390         p-character = "":U
     2391         .
     2392       end.
     2393     end.
     2394   end.
     2395   END PROCEDURE.
     2396   PROCEDURE get-saved-logical :
     2397   define input parameter p-list       as character        no-undo.
     2398   define input parameter p-name       as character        no-undo.
     2399   define output parameter p-logical   as character        no-undo.
     2400   define variable v-position    as integer      no-undo.
     2401   do
     2402   on error undo, return error
     2403   :
     2404     assign
     2405         v-position = lookup( p-name, p-list )
     2406     .
     2407     if v-position = 0
     2408     then do:
     2409       assign
     2410       p-logical = "  -":U
     2411       .
     2412     end.
     2413     else do:
     2414       if num-entries( p-list ) > v-position
     2415       then do:
     2416         assign
     2417         p-logical = "  ":U + entry( v-position + 1, p-list )
     2418         .
     2419         if trim( p-logical ) = "":U
     2420         then do:
     2421           assign
     2422           p-logical = "  -":U
     2423           .
     2424         end.
     2425       end.
     2426       else do:
     2427         assign
     2428         p-logical = "  -":U
     2429         .
     2430       end.
     2431     end.
     2432   end.
     2433   END PROCEDURE.
     2434   PROCEDURE init-fields :
     2435   define variable xtype        as character    no-undo.
     2436   define variable xstatus      as character    no-undo.
     2437   define variable v-temp-char     as character    no-undo.
     2438   define variable v-par-type      as character    no-undo.
     2439   define variable v-call-point    as character    no-undo.
     2440   define variable v-doc-counter   as integer      no-undo.
     2441   define variable v-form-title    as character    no-undo.
     2442   define buffer buf_fin-doc           for ub.fin-doc.
     2443   define buffer buf_usr-flt           for ubflt.usr-flt.
     2444   do
     2445   for buf_fin-doc
     2446     , buf_usr-flt
     2447   with frame Dialog-Frame
     2448   on error undo, return error
     2449   :
     2450     assign
     2451    fi-default-printer = session :printer-name
     2452     .
     2453   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile:currsysk.i $ $Revision: $".
     2454   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currsysk in g#library
     2455     (output v-menu-doc-sys-key
     2456     ) no-error .
     2457     for each temp_fin-doc-code
     2458     on error undo, return error
     2459     :
     2460       assign
     2461       v-doc-counter = v-doc-counter + 1
     2462       .
     2463       find first buf_fin-doc no-lock
     2464             where buf_fin-doc.host-code = temp_fin-doc-code.host-code
     2465              and  buf_fin-doc.fin-doc-code = temp_fin-doc-code.fin-doc-code
     2466       .
     2467       run create-menu-items1 in this-procedure (
     2468             input buf_fin-doc.host-code
     2469           , input buf_fin-doc.fin-doc-code
     2470           , input buf_fin-doc.fin-doc-type
     2471           , input buf_fin-doc.fin-ext-doc-type
     2472           , input buf_fin-doc.status_
     2473         ).
     2474     end.
     2475     if v-doc-counter = 1
     2476     then do:
     2477       assign
     2478       v-form-title = substitute( "Печать документа   Тип: &1 Статус: &2  Фирма &3 вн. № &4"
     2479           , v-menu-doc-fin-doc-type
     2480           , v-menu-doc-status_
     2481           , v-menu-doc-host-code
     2482           , v-menu-doc-fin-doc-code )
     2483       .
     2484     end.
     2485     else do:
     2486       assign
     2487       v-form-title = substitute( "Печать выбранных документов по списку" )
     2488       .
     2489     end.
     2490     assign
     2491     frame Dialog-Frame :title = v-form-title
     2492     .
     2493     for each Tmp#List
     2494     :
     2495       run get-call-point in this-procedure (
     2496             input Tmp#List.id
     2497           , output v-call-point
     2498       ).
     2499       find first buf_usr-flt no-lock
     2500             where buf_usr-flt.user-name  = v-cntxt-userid
     2501               and buf_usr-flt.call-point = substitute( "&1,&2,&3,&4"
     2502                                           , Tmp#List.blank-name
     2503                                           , Tmp#List.sys-key
     2504                                           , Tmp#List.sys-key-black
     2505                                           , v-call-point )
     2506       no-error.
     2507       if available buf_usr-flt
     2508       then do:
     2509         run get-saved-logical in this-procedure (
     2510               input buf_usr-flt.list_
     2511             , input "type-val":U
     2512             , output Tmp#List.type-val
     2513         ).
     2514         assign
     2515         v-temp-char = "":U
     2516         .
     2517         run get-saved-logical in this-procedure (
     2518               input buf_usr-flt.list_
     2519             , input "selection":U
     2520             , output v-temp-char
     2521         ).
     2522         if v-temp-char = "  +":U
     2523         then do:
     2524           assign
     2525           Tmp#List.last-use = yes
     2526           .
     2527         end.
     2528       end.
     2529       else do:
     2530         assign
     2531         Tmp#List.type-val     = "  -":U
     2532         .
     2533       end.
     2534       if Tmp#List.type-val-enabled = no
     2535       then do:
     2536         assign
     2537         Tmp#List.type-val     = " ":U
     2538         .
     2539       end.
     2540       if v-doc-counter > 1 then do:
     2541         if lookup("no-print-many" ,Tmp#List.filtr )  > 0 then do:
     2542           Tmp#List.view_ = 0.
     2543         end.
     2544       end.
     2545     end.
     2546   end.
     2547   END PROCEDURE.
     2548   PROCEDURE local-open-query :
     2549   open query br-table
     2550   for each Tmp#List no-lock
     2551       where Tmp#List.view_ <> 0
     2552   by Tmp#List.blank-name
     2553   .
     2554   END PROCEDURE.
     2555   PROCEDURE print-docs :
     2556   define variable v-doc-type          as character    no-undo.
     2557   define variable v-status            as character    no-undo.
     2558   define variable v-form-amount       as integer      no-undo.
     2559   define variable v-user-action       as character    no-undo.
     2560   define variable v-printed           as logical      no-undo.
     2561   define buffer buf_fin-doc       for ub.fin-doc.
     2562   define buffer buf_t_tmp#list    for tmp#list.
     2563   define buffer buf_tmp#list      for tmp#list.
     2564   do
     2565   for buf_fin-doc
     2566     , buf_t_tmp#list
     2567     , buf_tmp#list
     2568   with frame Dialog-Frame
     2569   on error undo, return error
     2570   :
     2571   if g#quest-print = yes
     2572   then do:
     2573     output  to value( string( session:temp-directory + "$" + string( g#report-num ) ) ) .
     2574     output close.
     2575   End.
     2576   output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) .
     2577   output close.
     2578   output to value( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".txl" ) .
     2579   output close.
     2580   for each temp_form-list
     2581   by temp_form-list.fin-doc-code
     2582   on error undo, return error
     2583   :
     2584     for each buf_tmp#list
     2585         where buf_tmp#list.id = temp_form-list.id
     2586     on error undo, return error
     2587      :
     2588       if buf_tmp#list.last-use <> no
     2589       then do:
     2590         find first buf_t_tmp#list no-lock
     2591               where buf_t_tmp#list.id = temp_form-list.id
     2592         .
     2593         assign
     2594         v-form-amount = v-form-amount + 1
     2595         .
     2596         find first buf_fin-doc
     2597               where buf_fin-doc.host-code = temp_form-list.host-code
     2598               and buf_fin-doc.fin-doc-code = temp_form-list.fin-doc-code
     2599         no-lock.
     2600         assign
     2601         v-doc-type = buf_fin-doc.fin-doc-type
     2602         v-status   = string( buf_fin-doc.status_  )
     2603         .
     2604         assign
     2605         PrintRubl   = ( trim( buf_tmp#list.type-val    ) = "+":U )
     2606         .
     2607         case num-entries( buf_tmp#list.proc-param )
     2608         :
     2609           when 0
     2610           then do:
     2611             run value ( buf_tmp#list.proc-name )  (
     2612                   input parparentproc
     2613                 , input recid( buf_fin-doc )
     2614               ).
     2615           end.
     2616           when 1
     2617           then do:
     2618             run value ( buf_tmp#list.proc-name ) (
     2619                   input parparentproc
     2620                 , input recid( buf_fin-doc )
     2621                 , input buf_tmp#list.proc-param
     2622               ).
     2623           end.
     2624           when 2
     2625           then do:
     2626             run value ( buf_tmp#list.proc-name )  (
     2627                   input parparentproc
     2628                 , input recid( buf_fin-doc )
     2629                 , input entry( 1, buf_tmp#list.proc-param )
     2630                 , input entry( 2, buf_tmp#list.proc-param )
     2631               ).
     2632           end.
     2633           when 3
     2634           then do:
     2635             run value ( buf_tmp#list.proc-name )  (
     2636                   input parparentproc
     2637                 , input recid( buf_fin-doc )
     2638                 , input entry( 1, buf_tmp#list.proc-param )
     2639                 , input entry( 2, buf_tmp#list.proc-param )
     2640                 , input entry( 3, buf_tmp#list.proc-param )
     2641               ).
     2642           end.
     2643           when 4
     2644           then do:
     2645             run value ( buf_tmp#list.proc-name )  (
     2646                     input parparentproc
     2647                   , input recid( buf_fin-doc )
     2648                   , input entry( 1, buf_tmp#list.proc-param )
     2649                   , input entry( 2, buf_tmp#list.proc-param )
     2650                   , input entry( 3, buf_tmp#list.proc-param )
     2651                   , input entry( 4, buf_tmp#list.proc-param )
     2652               ).
     2653           end.
     2654           when 5
     2655           then do:
     2656               run value ( buf_tmp#list.proc-name )  (
     2657                     input parparentproc
     2658                   , input recid( buf_fin-doc )
     2659                   , input entry( 1, buf_tmp#list.proc-param )
     2660                   , input entry( 2, buf_tmp#list.proc-param )
     2661                   , input entry( 3, buf_tmp#list.proc-param )
     2662                   , input entry( 4, buf_tmp#list.proc-param )
     2663                   , input entry( 5, buf_tmp#list.proc-param )
     2664               ).
     2665             end.
     2666             when 6
     2667             then do:
     2668                 run value ( buf_tmp#list.proc-name )  (
     2669                       input parparentproc
     2670                     , input recid( buf_fin-doc )
     2671                     , input entry( 1, buf_tmp#list.proc-param )
     2672                     , input entry( 2, buf_tmp#list.proc-param )
     2673                     , input entry( 3, buf_tmp#list.proc-param )
     2674                     , input entry( 4, buf_tmp#list.proc-param )
     2675                     , input entry( 5, buf_tmp#list.proc-param )
     2676                     , input entry( 6, buf_tmp#list.proc-param )
     2677                 ).
     2678             end.
     2679           end case.
     2680         end.
     2681       end.
     2682     end.
     2683     if g#quest-print = yes
     2684     Then do:
     2685       os-delete  value( string( session:temp-directory ) + "rpt" + string( g#report-num ) )
     2686         .
     2687       os-rename
     2688           value(  string( session:temp-directory ) + "$" + string( g#report-num ) )
     2689           value(  string( session:temp-directory ) + "rpt" + string( g#report-num ) )
     2690       .
     2691       os-delete
     2692             value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )
     2693         .
     2694       os-rename
     2695             value(  string( session:temp-directory ) + "$" + string( g#report-num ) + ".txl" )
     2696             value(  string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )
     2697         .
     2698       find first buf_tmp#list
     2699             where buf_tmp#list.last-use = yes
     2700       no-error.
     2701       if available buf_tmp#list
     2702       then do:
     2703         if buf_tmp#list.orient-orientation = "runexcelport":U
     2704         or buf_tmp#list.orient-orientation = "runexcellans":U
     2705         then do:
     2706           os-rename
     2707               value(  string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )
     2708               value(  string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".tx_" )
     2709           .
     2710         end.
     2711         case buf_tmp#list.orient-orientation
     2712         :
     2713           when "A4port":U
     2714           or when "runexcelport":U
     2715           then do:
     2716             run gbl/prnfilen.w (
     2717                   input "":U
     2718                 , input 0
     2719                 , input string( session :temp-directory )
     2720                             + "rpt"
     2721                             + string( g#report-num )
     2722                 , input buf_tmp#list.orient-font-num
     2723                 , output v-user-action
     2724                 , output v-printed
     2725             ) .
     2726           end.
     2727           when "A4lans":U
     2728           or when "runexcellans":U
     2729           or when "":U
     2730           then do:
     2731             run gbl/prnfilen.w (
     2732                   input "":U
     2733                 , input 8
     2734                 , input string( session :temp-directory )
     2735                             + "rpt"
     2736                             + string( g#report-num )
     2737                 , input buf_tmp#list.orient-font-num
     2738                 , output v-user-action
     2739                 , output v-printed
     2740             ) .
     2741           end.
     2742         end case.
     2743         if buf_tmp#list.orient-orientation = "runexcelport":U
     2744         or buf_tmp#list.orient-orientation = "runexcellans":U
     2745         then do:
     2746           os-rename
     2747               value(  string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".tx_" )
     2748               value(  string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )
     2749           .
     2750         end.
     2751       end.
     2752     end.
     2753     else do:
     2754      Message 'Задание распечатано'.
     2755     end.
     2756   end.
     2757   END PROCEDURE.
     2758   PROCEDURE reposition-browse :
     2759   do
     2760   with frame Dialog-Frame
     2761   on error undo, return error
     2762   :
     2763     define variable v-focused-row    as integer      no-undo.
     2764     assign
     2765    v-focused-row     = br-table :focused-row in frame Dialog-Frame.
     2766     .
     2767     get next br-table.
     2768     if available tmp#list
     2769     then do:
     2770       if v-focused-row >= br-table :height-chars - 4
     2771       then do:
     2772         br-table :set-repositioned-row( v-focused-row, "ALWAYS" ) in frame Dialog-Frame.
     2773       end.
     2774       else do:
     2775         br-table :set-repositioned-row( v-focused-row + 1, "ALWAYS" ) in frame Dialog-Frame.
     2776       end.
     2777       reposition br-table to rowid rowid( tmp#list ) no-error.
     2778     end.
     2779     else do:
     2780       get last br-table.
     2781     end.
     2782   end.
     2783   END PROCEDURE.
     2784   PROCEDURE reposition-to-recid :
     2785   define input parameter p-ext-system-recid  as recid        no-undo.
     2786   do
     2787   on error undo, return error
     2788   :
     2789     if p-ext-system-recid <> ?
     2790     then do:
     2791       reposition br-table to recid p-ext-system-recid no-error .
     2792     end.
     2793     do with frame Dialog-Frame
     2794     :
     2795       apply "entry":u to browse br-table .
     2796     end.
     2797   end.
     2798   END PROCEDURE.
     2799   PROCEDURE save-form-parameters :
     2800   define variable v-call-point    as character    no-undo.
     2801   define buffer buf_tmp#list          for tmp#list.
     2802   define buffer buf_usr-flt           for ubflt.usr-flt.
     2803   define buffer buf_temp_form-list    for temp_form-list.
     2804   do
     2805   for buf_tmp#list
     2806     , buf_usr-flt
     2807     , buf_temp_form-list
     2808   on error undo, return error
     2809   :
     2810     for each buf_tmp#list
     2811     :
     2812       run get-call-point in this-procedure (
     2813             input buf_tmp#list.id
     2814           , output v-call-point
     2815       ).
     2816       find first buf_usr-flt exclusive-lock
     2817             where buf_usr-flt.user-name  = v-cntxt-userid
     2818               and buf_usr-flt.call-point = substitute( "&1,&2,&3,&4"
     2819                                           , buf_tmp#list.blank-name
     2820                                           , buf_tmp#list.sys-key
     2821                                           , buf_tmp#list.sys-key-black
     2822                                           , v-call-point )
     2823       no-error.
     2824       if not available buf_usr-flt
     2825       then do:
     2826         create buf_usr-flt.
     2827         assign
     2828         buf_usr-flt.user-name  = v-cntxt-userid
     2829         buf_usr-flt.call-point = substitute( "&1,&2,&3,&4"
     2830                                     , buf_tmp#list.blank-name
     2831                                     , buf_tmp#list.sys-key
     2832                                     , buf_tmp#list.sys-key-black
     2833                                     , v-call-point )
     2834         .
     2835       end.
     2836       assign
     2837       buf_usr-flt.list_ = substitute( "selection,&1,type-val,&2":U
     2838                               , ( if buf_tmp#list.last-use = yes then "+":U else "-":U )
     2839                               , ( if index( buf_tmp#list.type-val   , "+":U ) <> 0 then "+":U else "-":U )
     2840                               )
     2841       .
     2842     end.
     2843   end.
     2844   END PROCEDURE.
     2845   PROCEDURE select-or-deselect-item :
     2846   define input  parameter p-id as integer    no-undo.
     2847   define buffer buf_tmp#list for tmp#list.
     2848   do
     2849   for buf_tmp#list
     2850   on error undo, return error
     2851   :
     2852     find first buf_tmp#list
     2853           where buf_tmp#list.id = p-id
     2854     .
     2855     if buf_tmp#list.last-use = yes
     2856     then do:
     2857       assign
     2858       buf_tmp#list.last-use = no
     2859       .
     2860     end.
     2861     else do:
     2862       assign
     2863       buf_tmp#list.last-use = yes
     2864       .
     2865     end.
     2866   end.
     2867   END PROCEDURE.
     2868   PROCEDURE test-temp-tables :
     2869       define buffer buf_t_tmp#list      for tmp#list.
     2870   do
     2871   for buf_t_tmp#list
     2872   on error undo, return error
     2873   :
     2874     output to "D:\111.txt".
     2875     for each temp_fin-doc-code no-lock
     2876     :
     2877       put unformatted
     2878       skip substitute( "&1", temp_fin-doc-code.fin-doc-code )
     2879       .
     2880     end.
     2881     put unformatted
     2882     skip "================================================================================"
     2883     .
     2884     for each temp_form-list no-lock
     2885     on error undo, return error
     2886     :
     2887       find first buf_t_tmp#list no-lock
     2888             where buf_t_tmp#list.id = temp_form-list.id
     2889       .
     2890       put unformatted
     2891       skip substitute( "&1 &2 &3 &4 &5 &6", temp_form-list.fin-doc-code, temp_form-list.fin-doc-type, temp_form-list.status_, temp_form-list.id, buf_t_tmp#list.blank-name, buf_t_tmp#list.last-use )
     2892       .
     2893     end.
     2894     put unformatted
     2895     skip "================================================================================"
     2896     .
     2897     for each temp_menu-doc_disabled-doc-list no-lock
     2898     on error undo, return error
     2899     :
     2900       put unformatted
     2901       skip substitute( "&1 &2 &3", temp_menu-doc_disabled-doc-list.fin-doc-code, temp_menu-doc_disabled-doc-list.blank-name, temp_menu-doc_disabled-doc-list.reason )
     2902       .
     2903     end.
     2904     output close.
     2905   end.
     2906   END PROCEDURE.
     2907   PROCEDURE ui-disable-all :
     2908   do
     2909   on error undo, return error
     2910   :
     2911   end.
     2912   END PROCEDURE.
     2913   PROCEDURE ui-enable :
     2914   define buffer buf_clients       for clients.
     2915   do
     2916   for buf_clients
     2917   on error undo, return error
     2918   :
     2919     enable
     2920     b-sel
     2921     b-deselect
     2922     with frame Dialog-Frame .
     2923     Tmp#List.blank-name:width in browse br-table = 53.
     2924     Tmp#List.blank-name:resizable in browse br-table = yes.
     2925   end.
     2926   END PROCEDURE.
