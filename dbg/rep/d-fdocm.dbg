      545        BGCOLOR 8 .
      546   DEFINE BUTTON b-help
      547        LABEL "Помощ&ь"
      548        SIZE 3.6 BY 1
      549        BGCOLOR 8 .
      550   DEFINE BUTTON b-print-doc
      551        LABEL ".   Пе&чать":L
      552        SIZE 11.8 BY 1.1
      553        BGCOLOR 8 .
      554   DEFINE BUTTON b-sel
      555        LABEL "*"
      556        SIZE 3 BY 1.1.
      557   DEFINE BUTTON i-print
      558        IMAGE-UP FILE "cmp/b-print.bmp":U
      559        IMAGE-DOWN FILE "cmp/b-print.bmp":U
      560        IMAGE-INSENSITIVE FILE "cmp/b-print.bmp":U
      561        LABEL ""
      562        SIZE 4 BY .95.
      563   DEFINE VARIABLE fi-default-printer AS CHARACTER FORMAT "X(256)":U
      564         VIEW-AS TEXT
      565        SIZE 97 BY .67
      566        FGCOLOR 4  NO-UNDO.
      567   DEFINE QUERY br-table FOR
      568         Tmp#List SCROLLING.
      569   DEFINE BROWSE br-table
      570     QUERY br-table NO-LOCK DISPLAY
      571         Tmp#List.last-use COLUMN-LABEL "*" FORMAT "*/"
      572       Tmp#List.blank-name COLUMN-LABEL "Название печатной формы":C53 FORMAT "X(255)"
      573       Tmp#List.type-val       column-label "в ..."    format "X(5)"
      574       WITH NO-ROW-MARKERS SEPARATORS SIZE 97.8 BY 20.24 FIT-LAST-COLUMN.
      575   DEFINE FRAME Dialog-Frame
      576        b-exit AT ROW 1 COL 1.6
      577        b-sel AT ROW 1 COL 11.6
      578        b-deselect AT ROW 1 COL 14.6
      579        b-chg AT ROW 1 COL 24.8
      580        b-print-doc AT ROW 1 COL 34.8
      581        b-help AT ROW 1 COL 96
      582        i-print AT ROW 1.05 COL 35 WIDGET-ID 2 NO-TAB-STOP
      583        br-table AT ROW 2.24 COL 1.6
      584        fi-default-printer AT ROW 22.76 COL 1.6 NO-LABEL
      585        SPACE(1.27) SKIP(0.19)
      586       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      587            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      588            TITLE "Список печатных форм".
      589   ASSIGN
      590          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      591          FRAME Dialog-Frame:HIDDEN           = TRUE.
      592   ASSIGN
      593          fi-default-printer:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      594   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      595   DO:
      596     APPLY "END-ERROR":U TO SELF.
      597   END.
      598   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
      599   DO:
      600   define variable v-options-string            as character    no-undo.
      601   define variable v-options-string-new        as character    no-undo.
      602   define variable v-options-enabled-string    as character    no-undo.
      603   if available tmp#list
      604   then do:
      605     run menufdoc-create-options-string in this-procedure (
      606           input tmp#list.id
      607         , output v-options-string
      608     ).
      609     run menufdoc-create-options-enabled-string in this-procedure (
      610           input tmp#list.id
      611         , output v-options-enabled-string
      612     ).
      613     run rep/d-docmd.w (
      614           input tmp#list.blank-name
      615         , input v-options-string
      616         , input v-options-enabled-string
      617         , output v-options-string-new
      618     ) no-error.
      619     if error-status :error
      620     then do:
      621       message
      622       vss-workfile vss-revision vss-description
      623       skip(1)
      624       skip "Ошибка изменения параметров печати."
      625       skip return-value
      626       skip trim(error-status :get-message(1))
      627       view-as alert-box error.
      628       undo, return no-apply .
      629     end.
      630     if v-options-string-new <> v-options-string
      631     then do:
      632         run menufdoc-set-options-string in this-procedure (
      633                 input tmp#list.id
      634               , input v-options-string-new
      635         ).
      636       browse br-table :refresh().
      637       apply "entry" to br-table in frame Dialog-Frame.
      638     end.
      639   end.
      640   END.
      641   ON CHOOSE OF b-deselect IN FRAME Dialog-Frame
      642   DO:
      643     for each tmp#list no-lock
      644     :
      645       assign
      646       tmp#list.last-use = no
      647       .
      648     end.
      649     browse br-table :refresh().
      650   END.
      651   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      652   DO:
      653     run save-form-parameters in this-procedure no-error.
      654     if error-status :error
      655     then do:
      656         message
      657         vss-workfile vss-revision vss-description
      658         skip(1)
      659         skip "Ошибка при сохранении параметров"
      660         skip "списка печатных форм."
      661         skip return-value
      662         skip trim(error-status :get-message(1))
      663         view-as alert-box error.
      664     end.
      665   END.
      666   ON CHOOSE OF b-print-doc IN FRAME Dialog-Frame
      667   DO:
      668   define variable v-is-selected   as logical      no-undo.
      669   define buffer buf_temp_tmp#list      for tmp#list.
      670   assign
      671   v-is-selected = no
      672   .
      673   test-selecting:
      674   for each buf_temp_tmp#list
      675   :
      676     if buf_temp_tmp#list.last-use <> no
      677     then do:
      678       assign
      679       v-is-selected = yes
      680       .
      681       leave test-selecting.
      682     end.
      683   end.
      684   if v-is-selected = no
      685   then do:
      686     message
      687     "Не выбрано ни одной формы"
      688     skip "для печати."
      689     view-as alert-box information
      690     title "Печать невозможна"
      691     .
      692     undo, return no-apply.
      693   end.
      694   else do:
      695     run print-docs in this-procedure no-error.
      696     if error-status :error
      697     then do:
      698       message
      699       vss-workfile vss-revision vss-description
      700       skip(1)
      701       skip "Ошибка печати документов."
      702       skip return-value
      703       skip trim(error-status :get-message(1))
      704       view-as alert-box error.
      705       undo, return no-apply .
      706     end.
      707   end.
      708   END.
      709   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
      710   DO:
      711     if available tmp#list
      712     then do:
      713       assign
      714       tmp#list.last-use = ( if tmp#list.last-use = yes then no else yes )
      715       .
      716       run reposition-browse in this-procedure .
      717       browse br-table :refresh().
      718     end.
      719   END.
      720   ON 1 OF br-table IN FRAME Dialog-Frame
      721   DO:
      722     if available tmp#list
      723     then do:
      724       if tmp#list.type-val = "  +":U
      725       or tmp#list.type-val = "  -":U
      726       then do:
      727         assign
      728         tmp#list.type-val = ( if tmp#list.type-val = "  +":U then "  -":U else "  +":U )
      729         .
      730       end.
      731       br-table :refresh().
      732     end.
      733   END.
      734   ON MOUSE-SELECT-DBLCLICK OF br-table IN FRAME Dialog-Frame
      735   DO:
      736     if available Tmp#List
      737     then do:
      738       run select-or-deselect-item in this-procedure (
      739           input Tmp#List.id
      740       ) no-error.
      741       if error-status :error
      742       then do:
      743           message
      744               vss-workfile vss-revision vss-description
      745               skip "Ошибка выбора или отмены выбора."
      746               skip return-value
      747               skip trim(error-status :get-message(1))
      748               trim(error-status :get-message(2))
      749               trim(error-status :get-message(3))
      750           view-as alert-box error.
      751           undo, return no-apply .
      752       end.
      753       br-table :refresh().
      754     end.
      755   END.
      756   ON ROW-DISPLAY OF br-table IN FRAME Dialog-Frame
      757   DO:
      758     if tmp#list.type-val-enabled = no
      759     then do:
      760       assign
      761       Tmp#List.type-val :bgcolor in browse br-table = GREY_COLOR
      762       .
      763     end.
      764     if lookup("other", tmp#list.filtr) > 0  then do:
      765       assign
      766       Tmp#List.last-use          :bgcolor in browse br-table = yellow_COLOR
      767       Tmp#List.blank-name        :bgcolor in browse br-table = yellow_COLOR
      768       .
      769     end.
      770     else do:
      771       assign
      772       Tmp#List.last-use          :bgcolor in browse br-table = ?
      773       Tmp#List.blank-name        :bgcolor in browse br-table = ?
      774       .
      775     end.
      776     if Tmp#List.orient-font-num <> 7
      777     then do:
      778       assign
      779       Tmp#List.last-use          :fgcolor in browse br-table = DARK_GREEN_COLOR
      780       Tmp#List.blank-name        :fgcolor in browse br-table = DARK_GREEN_COLOR
      781       .
      782     end.
      783     else do:
      784       if Tmp#List.orient-orientation = 'A4port':U
      785       or Tmp#List.orient-orientation = 'A3port':U
      786       then do:
      787         Tmp#List.last-use          :fgcolor in browse br-table = BLUE_COLOR.
      788         Tmp#List.blank-name        :fgcolor in browse br-table = BLUE_COLOR.
      789       end.
      790       else do:
      791         if Tmp#List.orient-orientation = 'EXCEL':U
      792         or Tmp#List.orient-orientation = 'self':U
      793         then do:
      794           Tmp#List.last-use   :fgcolor in browse br-table = CYAN_COLOR.
      795           Tmp#List.blank-name :fgcolor in browse br-table = CYAN_COLOR.
      796         end.
      797         else do:
      798           Tmp#List.last-use   :fgcolor in browse br-table = BLACK_COLOR.
      799           Tmp#List.blank-name :fgcolor in browse br-table = BLACK_COLOR.
      800         end.
      801       end.
      802     end.
      803   END.
      804   ON CHOOSE OF i-print IN FRAME Dialog-Frame
      805   DO:
      806     APPLY "choose" TO b-print-doc.
      807   END.
      808   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      809   on help of frame Dialog-Frame
      810   do:
      811     run gbl/app_help.p
      812       (input this-procedure :file-name
      813       ,input ''
      814       ,input ?
      815       ) no-error.
      816     if error-status :error then do:
      817       message
      818         "Ошибка при вызове помощи"
      819         error-status :get-message(1)
      820         view-as alert-box .
      821     end.
      822   end.
      823   run minbtn-set in this-procedure .
      824   on choose of b-help in frame Dialog-Frame
      825   do:
      826     apply "help":u to frame Dialog-Frame .
      827   end.
      828   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      829   procedure minbtn-set :
      830       do
      831           on error undo, return error return-value
      832           :
      833           define variable ii              as integer       no-undo .
      834           define variable fh              as widget-handle no-undo .
      835           define variable hh              as widget-handle no-undo .
      836           define variable v-h             as handle        extent 4 no-undo .
      837           define variable v-name-button   as character     no-undo .
      838           define variable v-help-old-x    as decimal       no-undo .
      839           define variable v-help-old-y    as decimal       no-undo .
      840           define variable v-help-old-size as decimal       no-undo .
      841           define variable v-frame-width   as decimal       no-undo .
      842           define variable jj              as integer       no-undo .
      843           do
      844               on error undo, return error
      845               :
      846               assign
      847                   v-frame-width = frame Dialog-Frame:width - 0.3
      848                   fh            = frame Dialog-Frame:first-child
      849                   hh            = fh:first-child
      850                   ii            = 1
      851                   .
      852               do while valid-handle(hh):
      853                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      854                   do:
      855                       case lc(hh:name) :
      856                           when "b-help" then
      857                               do:
      858                                   hh:load-image-up("cmp/b-help.bmp":u) .
      859                                   hh:load-image-down("cmp/b-help.bmp":u) .
      860                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      861                                   hh:TOOLTIP = "Помощь" .
      862                                   v-help-old-x = hh:column .
      863                                   v-help-old-y = hh:row    .
      864                                   v-help-old-size = hh:width .
      865                                   hh:width-chars = 2.5 .
      866                               end.
      867                           when "b-print" then
      868                               do:
      869                                   hh:load-image("cmp/b-print.bmp":u) .
      870                                   hh:TOOLTIP = "Печать" .
      871                                   v-h[ii] = hh:handle .
      872                                   ii = ii + 1 .
      873                                   hh:width-chars = 3 .
      874                               end.
      875                           when "b-history" or
      876                           when "b-hist" then
      877                               do:
      878                                   hh:load-image("cmp/b-hist.bmp":u) .
      879                                   hh:TOOLTIP = "История" .
      880                                   v-h[ii] = hh:handle .
      881                                   ii = ii + 1 .
      882                                   hh:width-chars = 3 .
      883                               end.
      884                           when "b-sch" then
      885                               do:
      886                                   hh:load-image("cmp/b-sch.bmp":u) .
      887                                   hh:TOOLTIP = "Установка Фильтра" .
      888                                   v-h[ii] = hh:handle .
      889                                   ii = ii + 1 .
      890                                   hh:width-chars = 3 .
      891                               end.
      892                           when "b-hist-user" then
      893                               do:
      894                                   hh:load-image("cmp/b-hist.bmp":u) .
      895                                   hh:TOOLTIP = "История пользователя" .
      896                                   ii = ii + 1 .
      897                               end.
      898                       end case.
      899                   end.
      900                   hh = hh:next-sibling.
      901               end.
      902               b-help:column = v-frame-width - b-help:width-chars.
      903               jj = 0.
      904               repeat ii = 4 to 1 by -1 :
      905                   if valid-handle (v-h[ii] ) then
      906                   do:
      907                       jj  = jj + 1 .
      908                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      909                       v-h[ii]:row    = v-help-old-y .
      910                   end.
      911               end.
      912           end.
      913       end.
      914   end procedure.
      915   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      916   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      917   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      918   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      919   define variable v-diasize-current-frame-width  as decimal   no-undo .
      920   define variable v-diasize-current-frame-height as decimal   no-undo .
      921   define variable v-diasize-change-size          as logical   no-undo .
      922   define variable v-diasize-resize-button        as handle    no-undo .
      923   define variable v-diasize-wndmax               as logical   no-undo .
      924   define variable v-diasize-wndstore             as logical   no-undo .
      925   define variable v-diasize-proc-name            as character no-undo .
      926   define variable v-diasize-browse-handle        as handle    no-undo .
      927   define variable v-diasize-browse-number        as integer   no-undo .
      928   define variable v-diasize-need-full-display    as logical   no-undo init false .
      929   define temp-table temp-diasize-handle no-undo
      930     field handle-value  as handle
      931     field save-position as decimal
      932     index xpk is primary unique handle-value
      933     .
      934   define temp-table temp-browse-handle no-undo
      935     field browse-type   as character
      936     field browse-number as integer
      937     field browse-handle as handle
      938     field original-size as decimal
      939     index xpk is primary unique browse-type browse-number
      940     index xie browse-type browse-handle
      941   .
      942   procedure diasize_change-height :
      943     define input  parameter p-change-value  as decimal   no-undo .
      944     define input  parameter p-move-resize   as logical   no-undo .
      945     define variable v-field-group-handle    as handle    no-undo .
      946     define variable v-object-handle         as handle    no-undo .
      947     define variable v-frame-height          as decimal   no-undo .
      948     define variable v-frame-virtual-height  as decimal   no-undo .
      949     define variable v-browse-height         as decimal   no-undo .
      950     define variable v-window-height         as decimal   no-undo .
      951     define variable v-window-virtual-height as decimal   no-undo .
      952     define variable v-change-sign           as integer   no-undo .
      953     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      954     define buffer buf_temp-browse-handle  for temp-browse-handle .
      955     if p-change-value > 0
      956     then do:
      957       if frame Dialog-Frame :height + p-change-value
      958           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      959       then do:
      960         assign
      961           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      962                           - (frame Dialog-Frame :height-chars)
      963         .
      964         if p-change-value <= 0
      965         then do:
      966           run diasize_position-resize-button in this-procedure .
      967           return .
      968         end.
      969       end.
      970     end.
      971     if p-change-value < 0
      972     then do:
      973       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      974       then do:
      975         assign
      976           p-change-value = v-diasize-orig-frame-height
      977                          - (frame Dialog-Frame :height-chars)
      978         .
      979         if p-change-value >= 0
      980         then do:
      981           run diasize_position-resize-button in this-procedure .
      982           return .
      983         end.
      984       end.
      985     end.
      986     if p-change-value >= 0
      987     then do:
      988       assign
      989         v-change-sign = 1
      990       .
      991     end.
      992     else do:
      993       assign
      994         v-change-sign = -1
      995       .
      996     end.
      997     assign
      998       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      999     .
     1000     if p-change-value = 0
     1001     then do:
     1002       run diasize_position-resize-button in this-procedure .
     1003       return .
     1004     end.
     1005     move_block:
     1006     do
     1007     on error undo move_block, retry move_block
     1008     :
     1009       if retry
     1010       then do:
     1011         do
     1012         on error undo move_block, leave move_block
     1013         :
     1014           if p-change-value > 0
     1015           then do:
     1016             for each buf_temp-diasize-handle
     1017             on error undo, next
     1018             :
     1019               assign
     1020                 v-object-handle = buf_temp-diasize-handle.handle-value
     1021               .
     1022               if v-object-handle <> v-diasize-resize-button
     1023               then do:
     1024                 assign
     1025                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1026                 .
     1027               end.
     1028             end.
     1029             assign
     1030               v-diasize-browse-handle :height = v-browse-height
     1031             .
     1032             for each buf_temp-browse-handle
     1033               where buf_temp-browse-handle.browse-type = 'height':u
     1034             on error undo, next
     1035             :
     1036               assign
     1037                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1038               .
     1039             end.
     1040             assign
     1041               frame Dialog-Frame :height = v-frame-height
     1042             .
     1043             if frame Dialog-Frame :scrollable = true
     1044             then do:
     1045               assign
     1046                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1047               .
     1048             end.
     1049             run diasize_position-resize-button in this-procedure .
     1050           end.
     1051           else do:
     1052             if frame Dialog-Frame :scrollable = true
     1053             then do:
     1054               assign
     1055                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1056               .
     1057             end.
     1058             assign
     1059               frame Dialog-Frame :height = v-frame-height
     1060             .
     1061             assign
     1062               v-diasize-browse-handle :height = v-browse-height
     1063             .
     1064             for each buf_temp-browse-handle
     1065               where buf_temp-browse-handle.browse-type = 'height':u
     1066             on error undo, next
     1067             :
     1068               assign
     1069                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1070               .
     1071             end.
     1072             for each buf_temp-diasize-handle
     1073             on error undo, next
     1074             :
     1075               assign
     1076                 v-object-handle = buf_temp-diasize-handle.handle-value
     1077               .
     1078               if v-object-handle <> v-diasize-resize-button
     1079               then do:
     1080                 assign
     1081                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1082                 .
     1083               end.
     1084             end.
     1085             run diasize_position-resize-button in this-procedure .
     1086           end.
     1087           assign
     1088             v-diasize-change-size = false
     1089           .
     1090           leave move_block .
     1091         end.
     1092       end.
     1093       assign
     1094         v-diasize-need-full-display = true
     1095       .
     1096       if v-diasize-change-size = false
     1097       then do:
     1098         assign
     1099           v-diasize-change-size = true
     1100         .
     1101       end.
     1102       else do:
     1103         return .
     1104       end.
     1105       assign
     1106         v-frame-height = frame Dialog-Frame :height
     1107         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1108         v-browse-height = v-diasize-browse-handle :height
     1109       .
     1110       for each buf_temp-browse-handle
     1111         where buf_temp-browse-handle.browse-type = 'height':u
     1112       :
     1113         assign
     1114           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1115         .
     1116       end.
     1117       for each buf_temp-diasize-handle
     1118       :
     1119         delete buf_temp-diasize-handle .
     1120       end.
     1121       assign
     1122         v-field-group-handle = frame Dialog-Frame :first-child
     1123       .
     1124       do while valid-handle(v-field-group-handle)
     1125       :
     1126         assign
     1127           v-object-handle = v-field-group-handle :first-child
     1128         .
     1129         do while valid-handle(v-object-handle)
     1130         :
     1131           if  v-object-handle <> v-diasize-browse-handle :handle
     1132           and can-query(v-object-handle, "row")
     1133           and can-query(v-object-handle, "height")
     1134           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1135           then do:
     1136             find first buf_temp-browse-handle
     1137               where buf_temp-browse-handle.browse-type   = 'height':u
     1138                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1139               no-error .
     1140             if available buf_temp-browse-handle
     1141             then do:
     1142             end.
     1143             else do:
     1144               create buf_temp-diasize-handle .
     1145               assign
     1146                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1147                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1148               .
     1149             end.
     1150           end.
     1151           assign
     1152             v-object-handle = v-object-handle :next-sibling
     1153           .
     1154         end.
     1155         assign
     1156           v-field-group-handle = v-field-group-handle :next-sibling
     1157         .
     1158       end.
     1159       do with frame Dialog-Frame
     1160       :
     1161         hide v-diasize-resize-button .
     1162         assign
     1163           v-diasize-resize-button :row    = 1
     1164           v-diasize-resize-button :column = 1
     1165         .
     1166       end.
     1167       if p-change-value > 0
     1168       then do:
     1169         if frame Dialog-Frame :scrollable = true
     1170         then do:
     1171           assign
     1172             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1173             no-error .
     1174           if error-status :error
     1175           or error-status :get-message(1) <> ""
     1176           then do:
     1177             undo move_block, retry move_block .
     1178           end.
     1179         end.
     1180         assign
     1181           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1182           no-error .
     1183         if error-status :error
     1184         or error-status :get-message(1) <> ""
     1185         then do:
     1186           undo move_block, retry move_block .
     1187         end.
     1188         assign
     1189           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1190           no-error .
     1191         if error-status :error
     1192         or error-status :get-message(1) <> ""
     1193         then do:
     1194           undo move_block, retry move_block .
     1195         end.
     1196         for each buf_temp-browse-handle
     1197           where buf_temp-browse-handle.browse-type = 'height':u
     1198         on error undo move_block, retry move_block
     1199         :
     1200           assign
     1201             buf_temp-browse-handle.browse-handle :height
     1202               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1203             no-error .
     1204           if error-status :error
     1205           or error-status :get-message(1) <> ""
     1206           then do:
     1207             undo move_block, retry move_block .
     1208           end.
     1209         end.
     1210         for each buf_temp-diasize-handle
     1211         on error undo move_block, retry move_block
     1212         :
     1213           assign
     1214             v-object-handle = buf_temp-diasize-handle.handle-value
     1215           .
     1216           if v-object-handle <> v-diasize-resize-button
     1217           then do:
     1218             assign
     1219               v-object-handle :row = v-object-handle :row + p-change-value
     1220               no-error .
     1221             if error-status :error
     1222             or error-status :get-message(1) <> ""
     1223             then do:
     1224               undo move_block, retry move_block .
     1225             end.
     1226           end.
     1227         end.
     1228       end.
     1229       else do:
     1230         for each buf_temp-diasize-handle
     1231         on error undo move_block, retry move_block
     1232         :
     1233           assign
     1234             v-object-handle = buf_temp-diasize-handle.handle-value
     1235           .
     1236           if v-object-handle <> v-diasize-resize-button
     1237           then do:
     1238             assign
     1239               v-object-handle :row = v-object-handle :row + p-change-value
     1240               no-error .
     1241             if error-status :error
     1242             or error-status :get-message(1) <> ""
     1243             then do:
     1244               undo move_block, retry move_block .
     1245             end.
     1246           end.
     1247         end.
     1248         assign
     1249           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1250           no-error .
     1251         if error-status :error
     1252         or error-status :get-message(1) <> ""
     1253         then do:
     1254           undo move_block, retry move_block .
     1255         end.
     1256         for each buf_temp-browse-handle
     1257           where buf_temp-browse-handle.browse-type = 'height':u
     1258         on error undo move_block, retry move_block
     1259         :
     1260           assign
     1261             buf_temp-browse-handle.browse-handle :height
     1262               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1263             no-error .
     1264           if error-status :error
     1265           or error-status :get-message(1) <> ""
     1266           then do:
     1267             undo move_block, retry move_block .
     1268           end.
     1269         end.
     1270         assign
     1271           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1272           no-error .
     1273         if error-status :error
     1274         or error-status :get-message(1) <> ""
     1275         then do:
     1276           undo move_block, retry move_block .
     1277         end.
     1278         if frame Dialog-Frame :scrollable = true
     1279         then do:
     1280           assign
     1281             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1282             no-error .
     1283           if error-status :error
     1284           or error-status :get-message(1) <> ""
     1285           then do:
     1286             undo move_block, retry move_block .
     1287           end.
     1288         end.
     1289       end.
     1290       if p-move-resize = true
     1291       then do:
     1292         run diasize_position-resize-button in this-procedure .
     1293       end.
     1294       if v-diasize-wndstore = true
     1295       then do:
     1296         if connected("ub") = true
     1297         then do:
     1298           define variable v-cntxt-db-num        as integer   no-undo .
     1299           define variable v-cntxt-userid        as character no-undo .
     1300           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1301                                             , OUTPUT v-cntxt-userid
     1302                                             ) .
     1303           run gbl/wndsizew.p
     1304             (input  v-cntxt-db-num
     1305             ,input  v-cntxt-userid
     1306             ,input  v-diasize-proc-name
     1307             ,input  'height':u
     1308             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1309             ) .
     1310         end.
     1311       end.
     1312     end.
     1313     assign
     1314       v-diasize-change-size = false
     1315     .
     1316   end procedure.
     1317   procedure diasize_set-height :
     1318     define input  parameter p-new-height  as decimal   no-undo .
     1319     define input  parameter p-move-resize as logical   no-undo .
     1320     do
     1321     on error undo, return error return-value
     1322     :
     1323       run diasize_change-height in this-procedure
     1324         (input  (p-new-height - frame Dialog-Frame :height)
     1325         ,input  p-move-resize
     1326         ) .
     1327     end.
     1328   end procedure.
     1329   procedure diasize_change-width :
     1330     define input  parameter p-change-value as decimal   no-undo .
     1331     define input  parameter p-move-resize  as logical   no-undo .
     1332     define variable v-field-group-handle   as handle    no-undo .
     1333     define variable v-object-handle        as handle    no-undo .
     1334     define variable v-frame-width          as decimal   no-undo .
     1335     define variable v-frame-virtual-width  as decimal   no-undo .
     1336     define variable v-browse-width         as decimal   no-undo .
     1337     define variable v-window-width         as decimal   no-undo .
     1338     define variable v-window-virtual-width as decimal   no-undo .
     1339     define variable v-change-sign          as integer   no-undo .
     1340     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1341     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1342     if p-change-value > 0
     1343     then do:
     1344       if frame Dialog-Frame :width + p-change-value >
     1345           session :width-chars
     1346       then do:
     1347         assign
     1348           p-change-value = session :width-chars - frame Dialog-Frame :width
     1349         .
     1350         if p-change-value <= 0
     1351         then do:
     1352           run diasize_position-resize-button in this-procedure .
     1353           return .
     1354         end.
     1355       end.
     1356     end.
     1357     if p-change-value < 0
     1358     then do:
     1359       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1360       then do:
     1361         assign
     1362           p-change-value = v-diasize-orig-frame-width
     1363                          - frame Dialog-Frame :width
     1364         .
     1365         if p-change-value >= 0
     1366         then do:
     1367           run diasize_position-resize-button in this-procedure .
     1368           return .
     1369         end.
     1370       end.
     1371     end.
     1372     if p-change-value >= 0
     1373     then do:
     1374       assign
     1375         v-change-sign = 1
     1376       .
     1377     end.
     1378     else do:
     1379       assign
     1380         v-change-sign = -1
     1381       .
     1382     end.
     1383     assign
     1384       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1385     .
     1386     if p-change-value = 0
     1387     then do:
     1388       run diasize_position-resize-button in this-procedure .
     1389       return .
     1390     end.
     1391     move_block:
     1392     do
     1393     on error undo move_block, leave move_block
     1394     :
     1395       if retry
     1396       then do:
     1397         do
     1398         on error undo move_block, leave move_block
     1399         :
     1400           if p-change-value > 0
     1401           then do:
     1402             for each buf_temp-diasize-handle
     1403             on error undo, next
     1404             :
     1405               assign
     1406                 v-object-handle = buf_temp-diasize-handle.handle-value
     1407               .
     1408               if v-object-handle <> v-diasize-resize-button
     1409               then do:
     1410                 assign
     1411                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1412                 .
     1413               end.
     1414             end.
     1415             assign
     1416               v-diasize-browse-handle :width = v-browse-width
     1417             .
     1418             for each buf_temp-browse-handle
     1419               where buf_temp-browse-handle.browse-type = 'width':u
     1420             on error undo, next
     1421             :
     1422               assign
     1423                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1424               .
     1425             end.
     1426             assign
     1427               frame Dialog-Frame :width = v-frame-width
     1428             .
     1429             if frame Dialog-Frame :scrollable = true
     1430             then do:
     1431               assign
     1432                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1433               .
     1434             end.
     1435             run diasize_position-resize-button in this-procedure .
     1436           end.
     1437           else do:
     1438             if frame Dialog-Frame :scrollable = true
     1439             then do:
     1440               assign
     1441                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1442               .
     1443             end.
     1444             assign
     1445               frame Dialog-Frame :width = v-frame-width
     1446             .
     1447             for each buf_temp-browse-handle
     1448               where buf_temp-browse-handle.browse-type = 'width':u
     1449             on error undo, next
     1450             :
     1451               assign
     1452                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1453               .
     1454             end.
     1455             assign
     1456               v-diasize-browse-handle :width = v-browse-width
     1457             .
     1458             for each buf_temp-diasize-handle
     1459             on error undo, next
     1460             :
     1461               assign
     1462                 v-object-handle = buf_temp-diasize-handle.handle-value
     1463               .
     1464               if v-object-handle <> v-diasize-resize-button
     1465               then do:
     1466                 assign
     1467                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1468                 .
     1469               end.
     1470             end.
     1471             run diasize_position-resize-button in this-procedure .
     1472           end.
     1473           assign
     1474             v-diasize-change-size = false
     1475           .
     1476           leave move_block .
     1477         end.
     1478       end.
     1479       assign
     1480         v-diasize-need-full-display = true
     1481       .
     1482       if v-diasize-change-size = false
     1483       then do:
     1484         assign
     1485           v-diasize-change-size = true
     1486         .
     1487       end.
     1488       else do:
     1489         return .
     1490       end.
     1491       assign
     1492         v-frame-width = frame Dialog-Frame :width
     1493         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1494         v-browse-width = v-diasize-browse-handle :width
     1495       .
     1496       for each buf_temp-browse-handle
     1497         where buf_temp-browse-handle.browse-type = 'width':u
     1498       :
     1499         assign
     1500           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1501         .
     1502       end.
     1503       for each buf_temp-diasize-handle
     1504       :
     1505         delete buf_temp-diasize-handle .
     1506       end.
     1507       assign
     1508         v-field-group-handle = frame Dialog-Frame :first-child
     1509       .
     1510       do while valid-handle(v-field-group-handle)
     1511       :
     1512         assign
     1513           v-object-handle = v-field-group-handle :first-child
     1514         .
     1515         do while valid-handle(v-object-handle)
     1516         :
     1517           if  v-object-handle <> v-diasize-browse-handle :handle
     1518           and v-object-handle <> v-diasize-resize-button
     1519           and can-query(v-object-handle, "row")
     1520           and can-query(v-object-handle, "height")
     1521           and ( v-object-handle :col + v-object-handle :width
     1522                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1523               )
     1524           then do:
     1525             find first buf_temp-browse-handle
     1526               where buf_temp-browse-handle.browse-type   = 'width':u
     1527                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1528               no-error .
     1529             if available buf_temp-browse-handle
     1530             then do:
     1531             end.
     1532             else do:
     1533               create buf_temp-diasize-handle .
     1534               assign
     1535                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1536                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1537               .
     1538             end.
     1539           end.
     1540           assign
     1541             v-object-handle = v-object-handle :next-sibling
     1542           .
     1543         end.
     1544         assign
     1545           v-field-group-handle = v-field-group-handle :next-sibling
     1546         .
     1547       end.
     1548       do with frame Dialog-Frame
     1549       :
     1550         hide v-diasize-resize-button .
     1551         v-diasize-resize-button :row = 1.
     1552         v-diasize-resize-button :column = 1.
     1553       end.
     1554       if p-change-value > 0
     1555       then do:
     1556         if frame Dialog-Frame :scrollable = true
     1557         then do:
     1558           assign
     1559             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1560             no-error .
     1561           if error-status :error
     1562           or error-status :get-message(1) <> ""
     1563           then do:
     1564             undo move_block, retry move_block.
     1565           end.
     1566         end.
     1567         assign
     1568           frame Dialog-Frame :width = v-frame-width + p-change-value
     1569           no-error .
     1570         if error-status :error
     1571         or error-status :get-message(1) <> ""
     1572         then do:
     1573           undo move_block, retry move_block.
     1574         end.
     1575         assign
     1576           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1577         no-error .
     1578         if error-status :error
     1579         or error-status :get-message(1) <> ""
     1580         then do:
     1581           undo move_block, retry move_block.
     1582         end.
     1583         for each buf_temp-browse-handle
     1584           where buf_temp-browse-handle.browse-type = 'width':u
     1585         on error undo move_block, retry move_block
     1586         :
     1587           assign
     1588             buf_temp-browse-handle.browse-handle :width
     1589               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1590             no-error .
     1591           if error-status :error
     1592           or error-status :get-message(1) <> ""
     1593           then do:
     1594             undo move_block, retry move_block .
     1595           end.
     1596         end.
     1597         for each buf_temp-diasize-handle
     1598         on error undo move_block, retry move_block
     1599         :
     1600           assign
     1601             v-object-handle = buf_temp-diasize-handle.handle-value
     1602           .
     1603           if v-object-handle <> v-diasize-resize-button
     1604           then do:
     1605             assign
     1606               v-object-handle :col = v-object-handle :col + p-change-value
     1607               no-error .
     1608             if error-status :error
     1609             or error-status :get-message(1) <> ""
     1610             then do:
     1611               undo move_block, retry move_block .
     1612             end.
     1613           end.
     1614         end.
     1615       end.
     1616       else do:
     1617         for each buf_temp-diasize-handle
     1618         on error undo move_block, retry move_block
     1619         :
     1620           assign
     1621             v-object-handle = buf_temp-diasize-handle.handle-value
     1622           .
     1623           if v-object-handle <> v-diasize-resize-button
     1624           then do:
     1625             assign
     1626               v-object-handle :col = v-object-handle :col + p-change-value
     1627               no-error .
     1628             if error-status :error
     1629             or error-status :get-message(1) <> ""
     1630             then do:
     1631               undo move_block, retry move_block .
     1632             end.
     1633           end.
     1634         end.
     1635         for each buf_temp-browse-handle
     1636           where buf_temp-browse-handle.browse-type = 'width':u
     1637         on error undo move_block, retry move_block
     1638         :
     1639           assign
     1640             buf_temp-browse-handle.browse-handle :width
     1641               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1642             no-error .
     1643           if error-status :error
     1644           or error-status :get-message(1) <> ""
     1645           then do:
     1646             undo move_block, retry move_block .
     1647           end.
     1648         end.
     1649         assign
     1650           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1651           no-error .
     1652         if error-status :error
     1653         or error-status :get-message(1) <> ""
     1654         then do:
     1655           undo move_block, retry move_block.
     1656         end.
     1657         assign
     1658           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1659         no-error .
     1660         if error-status :error
     1661         or error-status :get-message(1) <> ""
     1662         then do:
     1663           undo move_block, retry move_block.
     1664         end.
     1665         if frame Dialog-Frame :scrollable = true
     1666         then do:
     1667           assign
     1668             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1669           no-error .
     1670           if error-status :error
     1671           or error-status :get-message(1) <> ""
     1672           then do:
     1673             undo move_block, retry move_block.
     1674           end.
     1675         end.
     1676       end.
     1677       if p-move-resize
     1678       then do:
     1679         run diasize_position-resize-button in this-procedure .
     1680       end.
     1681       if v-diasize-wndstore = true
     1682       then do:
     1683         if connected("ub") = true
     1684         then do:
     1685           define variable v-cntxt-db-num        as integer   no-undo .
     1686           define variable v-cntxt-userid        as character no-undo .
     1687           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1688                                             , OUTPUT v-cntxt-userid
     1689                                             ) .
     1690           run gbl/wndsizew.p
     1691             (input  v-cntxt-db-num
     1692             ,input  v-cntxt-userid
     1693             ,input  v-diasize-proc-name
     1694             ,input  'width':u
     1695             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1696             ) .
     1697         end.
     1698       end.
     1699     end.
     1700     assign
     1701       v-diasize-change-size = false
     1702     .
     1703   end procedure.
     1704   procedure diasize_set-width :
     1705     define input  parameter p-new-width  as decimal   no-undo .
     1706     define input  parameter p-move-resize as logical   no-undo .
     1707     do
     1708     on error undo, return error return-value
     1709     :
     1710       run diasize_change-width in this-procedure
     1711         (input  (p-new-width - frame Dialog-Frame :width)
     1712         ,input  p-move-resize
     1713         ) .
     1714     end.
     1715   end procedure.
     1716   procedure diasize_position-resize-button :
     1717     do with frame Dialog-Frame
     1718     :
     1719       hide v-diasize-resize-button .
     1720       assign
     1721         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1722                     - 1
     1723                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1724         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1725                     - 1
     1726                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1727       .
     1728       view v-diasize-resize-button .
     1729     end.
     1730   end procedure.
     1731   on alt-right anywhere
     1732   do:
     1733     run diasize_change-width in this-procedure
     1734       (input 1
     1735       ,input true
     1736       ) .
     1737     return no-apply .
     1738   end.
     1739   on alt-left anywhere
     1740   do:
     1741     run diasize_change-width in this-procedure
     1742       (input -1
     1743       ,input true
     1744       ) .
     1745     return no-apply .
     1746   end.
     1747   on alt-down anywhere
     1748   do:
     1749     run diasize_change-height in this-procedure
     1750       (input 1
     1751       ,input true
     1752       ) .
     1753     return no-apply .
     1754   end.
     1755   on alt-up anywhere
     1756   do:
     1757     run diasize_change-height in this-procedure
     1758       (input -1
     1759       ,input true
     1760       ) .
     1761     return no-apply .
     1762   end.
     1763   on alt-enter of frame Dialog-Frame
     1764   do:
     1765     run diasize_maximize in this-procedure
     1766       (input  ?
     1767       ).
     1768     return no-apply .
     1769   end.
     1770   procedure diasize_end-move :
     1771     do
     1772     on error undo, return error return-value
     1773     :
     1774       define variable v-row-delta as decimal   no-undo .
     1775       define variable v-col-delta as decimal   no-undo .
     1776       define variable v-new-row as decimal   no-undo .
     1777       define variable v-new-col as decimal   no-undo .
     1778       assign
     1779         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1780         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1781       .
     1782       assign
     1783         v-row-delta = v-new-row - frame Dialog-Frame :height
     1784         v-col-delta = v-new-col - frame Dialog-Frame :width
     1785       .
     1786       run diasize_change-height in this-procedure
     1787         (input v-row-delta
     1788         ,input true
     1789         ) .
     1790       run diasize_change-width in this-procedure
     1791         (input v-col-delta
     1792         ,input true
     1793         ) .
     1794     end.
     1795   end procedure.
     1796   procedure diasize_maximize :
     1797     define input  parameter p-action as logical   no-undo .
     1798     do
     1799     on error undo, return error return-value
     1800     :
     1801       if p-action = ?
     1802       then do:
     1803         if v-diasize-need-maximize = true
     1804         then do:
     1805           assign
     1806             p-action = true
     1807           .
     1808         end.
     1809         else do:
     1810           assign
     1811             p-action = false
     1812           .
     1813         end.
     1814       end.
     1815       if p-action = true
     1816       then do:
     1817         run diasize_change-height in this-procedure
     1818           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1819               - frame Dialog-Frame :height-chars
     1820           ,input true
     1821           ) .
     1822         run diasize_change-width in this-procedure
     1823           (input session :width-chars
     1824               - frame Dialog-Frame :width-chars
     1825           ,input true
     1826           ) .
     1827         assign
     1828           v-diasize-need-maximize = false
     1829         .
     1830       end.
     1831       else do:
     1832         run diasize_change-width in this-procedure
     1833           (input v-diasize-orig-frame-width
     1834               - frame Dialog-Frame :width-chars
     1835           ,input true
     1836           ) .
     1837         run diasize_change-height in this-procedure
     1838           (input v-diasize-orig-frame-height
     1839               - frame Dialog-Frame :height-chars
     1840           ,input true
     1841           ) .
     1842         assign
     1843           v-diasize-need-maximize = true
     1844         .
     1845       end.
     1846     end.
     1847   end procedure.
     1848   procedure diasize_restore-orig-size :
     1849     do
     1850     on error undo, return error return-value
     1851     :
     1852       assign
     1853         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1854         v-diasize-current-frame-height = frame Dialog-Frame :height
     1855       .
     1856       run diasize_set-height in this-procedure
     1857         (input  v-diasize-orig-frame-height
     1858         ,input  true
     1859         ) .
     1860       run diasize_set-width in this-procedure
     1861         (input  v-diasize-orig-frame-width
     1862         ,input  true
     1863         ) .
     1864     end.
     1865   end procedure.
     1866   procedure diasize_restore-current-size :
     1867     do
     1868     on error undo, return error return-value
     1869     :
     1870       run diasize_set-height in this-procedure
     1871         (input  v-diasize-current-frame-height
     1872         ,input  true
     1873         ) .
     1874       run diasize_set-width in this-procedure
     1875         (input  v-diasize-current-frame-width
     1876         ,input  true
     1877         ) .
     1878     end.
     1879   end procedure.
     1880   procedure diasize_set-browse-handle :
     1881     define input  parameter p-browse-handle as handle   no-undo .
     1882     define buffer buf_temp-browse-handle for temp-browse-handle .
     1883     do
     1884     on error undo, return error return-value
     1885     :
     1886       assign
     1887         v-diasize-browse-handle = p-browse-handle
     1888       .
     1889       for each buf_temp-browse-handle
     1890       on error undo, return error return-value
     1891       :
     1892         delete buf_temp-browse-handle .
     1893       end.
     1894     end.
     1895   end procedure.
     1896   procedure diasize_add_browse :
     1897     define input  parameter p-browse-type   as character no-undo .
     1898     define input  parameter p-browse-handle as handle    no-undo .
     1899     define buffer buf_temp-browse-handle for temp-browse-handle .
     1900     do
     1901     on error undo, return error return-value
     1902     :
     1903       assign
     1904         v-diasize-browse-number = v-diasize-browse-number + 1
     1905       .
     1906       create buf_temp-browse-handle .
     1907       assign
     1908         buf_temp-browse-handle.browse-type   = p-browse-type
     1909         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1910         buf_temp-browse-handle.browse-handle = p-browse-handle
     1911       .
     1912     end.
     1913   end procedure.
     1914   procedure diasize_init :
     1915     define variable v-default-value    as logical   no-undo .
     1916     define variable v-restore-saved    as logical   no-undo .
     1917     define variable v-resize-value-str as character no-undo .
     1918     do
     1919     on error undo, return error return-value
     1920     :
     1921       do with frame Dialog-Frame
     1922       :
     1923         assign
     1924           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1925           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1926           v-diasize-browse-handle     = browse br-table :handle
     1927         .
     1928         create button v-diasize-resize-button
     1929         assign
     1930           parent        = frame Dialog-Frame :first-child
     1931           label         = "s"
     1932           height-pixels = 16
     1933           width-pixels  = 16
     1934           visible       = true
     1935           sensitive     = true
     1936           movable       = true
     1937           triggers:
     1938             on end-move persistent run diasize_end-move in this-procedure .
     1939           end triggers.
     1940         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1941         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1942         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1943         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1944         assign
     1945           v-diasize-wndmax = false
     1946         .
     1947         if connected("ub") = true
     1948         then do:
     1949           define variable v-cntxt-db-num        as integer   no-undo .
     1950           define variable v-cntxt-userid        as character no-undo .
     1951           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1952                                             , OUTPUT v-cntxt-userid
     1953                                             ) .
     1954           run gbl/wndpar_r.p
     1955             (input  v-cntxt-db-num
     1956             ,input  v-cntxt-userid
     1957             ,input  'wndmax':U
     1958             ,output v-diasize-wndmax
     1959             ,output v-default-value
     1960             ) .
     1961         end.
     1962         assign
     1963           v-diasize-wndstore = false
     1964         .
     1965         if connected("ub") = true
     1966         then do:
     1967           run gbl/wndpar_r.p
     1968             (input  v-cntxt-db-num
     1969             ,input  v-cntxt-userid
     1970             ,input  'wndstore':U
     1971             ,output v-diasize-wndstore
     1972             ,output v-default-value
     1973             ) .
     1974         end.
     1975         assign
     1976           v-diasize-proc-name = entry(1, program-name(2), '.')
     1977         .
     1978         if v-diasize-wndstore = true
     1979         then do:
     1980           assign
     1981             v-restore-saved = false
     1982           .
     1983           if connected("ub") = true
     1984           then do:
     1985             run gbl/wndsizer.p
     1986               (input  v-cntxt-db-num
     1987               ,input  v-cntxt-userid
     1988               ,input  v-diasize-proc-name
     1989               ,input  'height':u
     1990               ,output v-resize-value-str
     1991               ) .
     1992             if v-resize-value-str <> '':U
     1993             then do:
     1994               run diasize_change-height in this-procedure
     1995                 (input  integer(v-resize-value-str)
     1996                 ,input  true
     1997                 ) .
     1998               assign
     1999                 v-restore-saved = true
     2000               .
     2001             end.
     2002           end.
     2003           if connected("ub") = true
     2004           then do:
     2005             run gbl/wndsizer.p
     2006               (input  v-cntxt-db-num
     2007               ,input  v-cntxt-userid
     2008               ,input  v-diasize-proc-name
     2009               ,input  'width':u
     2010               ,output v-resize-value-str
     2011               ) .
     2012             if v-resize-value-str <> '':U
     2013             then do:
     2014               run diasize_change-width in this-procedure
     2015                 (input  integer(v-resize-value-str)
     2016                 ,input  true
     2017                 ) .
     2018               assign
     2019                 v-restore-saved = true
     2020               .
     2021             end.
     2022           end.
     2023           if v-restore-saved <> true
     2024           then do:
     2025             if v-diasize-wndmax = true
     2026             then do:
     2027               run diasize_maximize in this-procedure
     2028                 (input  true
     2029                 ) .
     2030             end.
     2031           end.
     2032         end.
     2033         else do:
     2034           if v-diasize-wndmax = true
     2035           then do:
     2036             run diasize_maximize in this-procedure
     2037               (input  true
     2038               ) .
     2039           end.
     2040         end.
     2041       end.
     2042     end.
     2043   end procedure.
     2044   procedure diasize_need-full-display :
     2045     define output parameter p-need-full-display as logical   no-undo .
     2046     do
     2047     on error undo, return error return-value
     2048     :
     2049       assign
     2050         p-need-full-display = v-diasize-need-full-display
     2051       .
     2052       assign
     2053         v-diasize-need-full-display = false
     2054       .
     2055     end.
     2056   end procedure.
     2057   procedure get-context :
     2058      define output parameter p-db-num as integer          no-undo.
     2059      define output parameter p-user-id as character        no-undo.
     2060      define variable v-login               as character    no-undo.
     2061      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2062      define buffer buf_user-login  for ub.user-login .
     2063      do
     2064      on error undo, return error
     2065      :
     2066            FIND FIRST buf_sys-ctrl no-lock.
     2067            ASSIGN
     2068               v-login = USERID("ub")
     2069               p-db-num = buf_sys-ctrl.db-num
     2070            .
     2071            FIND FIRST buf_user-login
     2072                 WHERE buf_user-login.db-num = p-db-num
     2073                   AND buf_user-login.user-login = v-login
     2074                 no-lock
     2075                 no-error
     2076                 .
     2077            IF AVAILABLE buf_user-login
     2078            THEN DO:
     2079               assign
     2080                  p-user-id = buf_user-login.user-id
     2081               .
     2082            END.
     2083      end.
     2084   end procedure.
     2085       run diasize_init in this-procedure .
     2086   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2087   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2088   MAIN-BLOCK:
     2089   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2090      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2091     Tmp#List.type-val:label =  "в руб"  .
     2092   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2093     run mainmenu_getcntxt in parparentproc
     2094       (output v-cntxt-db-num
     2095       ,output v-cntxt-userid
     2096       ,output v-cntxt-level
     2097       ,output v-cntxt-host-code-obj
     2098       ,output v-cntxt-obj-type
     2099       ,output v-cntxt-obj-code
     2100       ,output v-cntxt-db-num-obj
     2101       ,output v-cntxt-is-admin
     2102       ) .
     2103     run get-quest-print in parparentproc (
     2104         output g#quest-print
     2105     ).
     2106     run get-report-num in parparentproc (
     2107         output g#report-num
     2108     ).
     2109     run init-fields in this-procedure.
     2110     RUN enable_UI.
     2111     run ui-disable-all in this-procedure.
     2112     run ui-enable in this-procedure.
     2113     apply "value-changed" to br-table.
     2114     apply "entry" to br-table.
     2115     WAIT-FOR GO OF FRAME Dialog-Frame.
     2116   END.
     2117   RUN disable_UI.
