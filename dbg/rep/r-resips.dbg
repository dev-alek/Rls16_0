     1058   end procedure.
     1059   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     1060     if num-entries(string(p-dec), '.') = 2
     1061       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     1062       else return( string(p-dec)) .
     1063   end function.
     1064   function format-point-to-comma returns char (input orig as char ) .
     1065   define variable rtext as character no-undo .
     1066   define variable strt as integer no-undo .
     1067   define variable leng as integer no-undo .
     1068   assign rtext = orig .
     1069   repeat:
     1070     strt =  index(rtext,'.').
     1071     if strt = 0 then leave.
     1072     leng = 1.
     1073     substring(rtext,strt,leng,"character") = v-delim .
     1074   end.
     1075   return rtext.
     1076   end function.
     1077   function format-excel-text returns char ( input start-text as char ) :
     1078   def var  i    as int no-undo.
     1079   def var  ch   as char no-undo.
     1080   def var  n    as int no-undo.
     1081   def var  ipos as int no-undo.
     1082     n = num-entries(trim(start-text), chr(10)) - 1 .
     1083     do i = 1 to n :
     1084       ipos = index( start-text, chr(10)).
     1085       if ipos > 0 then
     1086         substr( start-text, ipos, 1 ) = ' '.
     1087     end.
     1088     n = num-entries(trim(start-text), chr(13)) - 1 .
     1089     do i = 1 to n :
     1090       ipos = index( start-text, chr(13)).
     1091       if ipos > 0 then
     1092         substr( start-text, ipos, 1 ) = ' '.
     1093     end.
     1094     if index( start-text, '"' ) = 0 then
     1095       start-text =  '="'   + trim( start-text) + '"'   .
     1096       else do:
     1097         n = num-entries(trim(start-text), '"') - 1.
     1098         do i = 1 to n :
     1099           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1100         end.
     1101         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1102         start-text = '="'  + ch  + '"' .
     1103       end.
     1104     return start-text.
     1105   end.
     1106   function excel-sum returns char (input p-dec as decimal ).
     1107     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     1108   end function.
     1109   function excel-qnty returns char (input p-dec as decimal ).
     1110     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     1111   end function.
     1112   function format-excel-text-macr returns char ( input start-text as char ) :
     1113   def var  i    as int no-undo.
     1114   def var  ch   as char no-undo.
     1115   def var  n    as int no-undo.
     1116   def var  ipos as int no-undo.
     1117     n = num-entries(trim(start-text), chr(10)) - 1 .
     1118     do i = 1 to n :
     1119       ipos = index( start-text, chr(10)).
     1120       if ipos > 0 then
     1121         substring( start-text, ipos , 1 ) = ' '.
     1122     end.
     1123     n = num-entries(trim(start-text), chr(13)) - 1 .
     1124     do i = 1 to n :
     1125       ipos = index( start-text, chr(13)).
     1126       if ipos > 0 then
     1127         substring( start-text, ipos, 1 ) = ' '.
     1128     end.
     1129     if index( start-text, '"' ) = 0 then
     1130       start-text =  '"'   + trim( start-text) + '"'   .
     1131       else do:
     1132         n = num-entries(trim(start-text), '"') - 1.
     1133         do i = 1 to n :
     1134           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1135         end.
     1136         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1137         start-text = '"'  + ch  + '"' .
     1138       end.
     1139     n = num-entries(trim(start-text), chr(10)) - 1 .
     1140     do i = 1 to n :
     1141       ipos = index( start-text, chr(10)).
     1142       if ipos > 0 then
     1143         substring( start-text, ipos , 1 ) = ' '.
     1144     end.
     1145       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     1146     return start-text.
     1147   end.
     1148   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1149   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
     1150   procedure partslib-clear-temp-parts :
     1151     define buffer buf_temp-parts for temp-parts .
     1152     do
     1153     on error undo, return error
     1154     :
     1155       for each buf_temp-parts
     1156       on error undo, return error
     1157       :
     1158         delete buf_temp-parts .
     1159       end.
     1160     end.
     1161   end procedure.
     1162   procedure partslib-create-temp-parts :
     1163     define parameter buffer buf_parts       for ub.parts .
     1164     define parameter buffer buf_temp-parts  for temp-parts .
     1165     define input  parameter p-goods-twounit as logical   no-undo .
     1166     define variable v-base-part-code as character no-undo .
     1167     do
     1168     on error undo, return error
     1169     :
     1170       if p-goods-twounit = true
     1171       then do:
     1172         assign
     1173           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
     1174         .
     1175       end.
     1176       else do:
     1177         assign
     1178           v-base-part-code = buf_parts.part-code
     1179         .
     1180       end.
     1181       find first buf_temp-parts exclusive-lock
     1182         where buf_temp-parts.obj-type  = buf_parts.obj-type
     1183           and buf_temp-parts.obj-code  = buf_parts.obj-code
     1184           and buf_temp-parts.artic     = buf_parts.artic
     1185           and buf_temp-parts.prod-type = buf_parts.prod-type
     1186           and buf_temp-parts.prod-code = buf_parts.prod-code
     1187           and buf_temp-parts.in-code   = buf_parts.in-code
     1188           and buf_temp-parts.out-code  = 'free-zone':U
     1189           and buf_temp-parts.part-code = v-base-part-code
     1190         no-error.
     1191       if not available buf_temp-parts
     1192       then do:
     1193         create buf_temp-parts .
     1194         buffer-copy buf_parts to buf_temp-parts
     1195         assign
     1196           buf_temp-parts.out-code  = 'free-zone':U
     1197           buf_temp-parts.part-code = v-base-part-code
     1198           buf_temp-parts.rsrv-free = yes
     1199           buf_temp-parts.status_   = no
     1200           buf_temp-parts.qnty      = 0
     1201           buf_temp-parts.fact-qnty = 0
     1202           buf_temp-parts.real-qnty = 0
     1203           buf_temp-parts.cli-qnty  = 0
     1204         .
     1205       end.
     1206     end.
     1207   end procedure.
     1208   procedure partslib-init-temp-parts :
     1209     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     1210     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     1211     define input parameter p-artic           like ub.parts.artic     no-undo .
     1212     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     1213     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     1214     define buffer buf_parts      for ub.parts .
     1215     define buffer buf_temp-parts for temp-parts .
     1216     define variable v-goods-twounit    as logical   no-undo .
     1217     do
     1218     on error undo, return error
     1219     :
     1220   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1221   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1222     (input  p-artic
     1223     ,input  p-prod-type
     1224     ,input  p-prod-code
     1225     ,input  'twounit=request':u
     1226     ,output v-goods-twounit
     1227     ) no-error .
     1228       if error-status :error
     1229       then do:
     1230         message
     1231           vss-workfile vss-revision vss-description skip
     1232           vss-include-info17 skip
     1233           "Ошибка при определении атрибута товара" skip
     1234           "Артикул" p-artic p-prod-type p-prod-code skip
     1235           "twounit=request" skip
     1236           error-status :get-message(1) skip
     1237           return-value skip
     1238           view-as alert-box error .
     1239         undo, return error return-value .
     1240       end.
     1241       run partslib-clear-temp-parts in this-procedure .
     1242       for each buf_parts
     1243         where buf_parts.obj-type  = p-obj-type
     1244           and buf_parts.obj-code  = p-obj-code
     1245           and buf_parts.artic     = p-artic
     1246           and buf_parts.prod-type = p-prod-type
     1247           and buf_parts.prod-code = p-prod-code
     1248           and buf_parts.rsrv-free = yes
     1249           and buf_parts.status_   = no
     1250           and buf_parts.in-code   <> buf_parts.out-code
     1251       on error undo, return error
     1252       :
     1253         run partslib-create-temp-parts in this-procedure
     1254           (buffer buf_parts
     1255           ,buffer buf_temp-parts
     1256           ,input  v-goods-twounit
     1257           ) .
     1258         define variable v-parts-qnty          as decimal   no-undo .
     1259         define variable v-parts-cli-qnty      as decimal   no-undo .
     1260         define variable v-parts-free-qnty     as decimal   no-undo .
     1261         define variable v-parts-free-cli-qnty as decimal   no-undo .
     1262         if buf_parts.out-code = 'free-zone':U
     1263         then do:
     1264           assign
     1265             v-parts-qnty          = buf_parts.qnty
     1266             v-parts-cli-qnty      = buf_parts.cli-qnty
     1267             v-parts-free-qnty     = buf_parts.qnty
     1268             v-parts-free-cli-qnty = buf_parts.cli-qnty
     1269           .
     1270         end.
     1271         else do:
     1272           assign
     1273             v-parts-qnty          = abs(buf_parts.qnty)
     1274             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
     1275             v-parts-free-qnty     = 0
     1276             v-parts-free-cli-qnty = 0
     1277           .
     1278         end.
     1279         assign
     1280           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
     1281           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
     1282           buf_temp-parts.real-qnty     = 0
     1283           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
     1284           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
     1285           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
     1286         .
     1287       end.
     1288     end.
     1289   end procedure.
     1290   procedure partslib-init-temp-parts-by-factord :
     1291     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     1292     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     1293     define input parameter p-artic              like ub.parts.artic     no-undo .
