      799   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      800   procedure proc-alt-shift-f2:
      801     if not ibs.th.gbl.gbl-var:rcode
      802   then
      803     run gbl\inidebug.p .
      804   end.
      805   procedure proc-alt-shift-f3:
      806     run gbl/prvssinf.p
      807       ( input this-procedure
      808       ) .
      809   end.
      810   define variable v-inform-launched as logical no-undo initial false .
      811   procedure proc-alt-shift-f4:
      812     define variable v-action as character no-undo .
      813     if v-inform-launched = false then do:
      814       assign
      815         v-inform-launched = true
      816       .
      817       run gbl/d-inform.w
      818         (  input self
      819         ,  input this-procedure
      820         , output v-action
      821         ) no-error .
      822       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      823       assign
      824         v-inform-launched = false
      825       .
      826     end.
      827   end.
      828   procedure proc-alt-f1:
      829     run gbl/corrhelp.p
      830       (input this-procedure
      831       ) .
      832   end .
      833   on alt-shift-f2 anywhere do:
      834     run proc-alt-shift-f2.
      835   end.
      836   on alt-shift-f3 anywhere do:
      837     run proc-alt-shift-f3 in this-procedure .
      838   end.
      839   on alt-shift-f4 anywhere do:
      840     run proc-alt-shift-f4 in this-procedure.
      841   end.
      842   on alt-f1 anywhere do:
      843     run proc-alt-f1 in this-procedure .
      844   end.
