     1388           "Артикул" p-artic p-prod-type p-prod-code skip
     1389           "p-fact-order" p-fact-order skip
     1390           "v-max-fact-order" v-max-fact-order skip
     1391           view-as alert-box error .
     1392         undo, return error .
     1393       end.
     1394     end.
     1395   end procedure.
     1396   procedure partslib-update-by-factord :
     1397     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     1398     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     1399     define input parameter p-artic              like ub.parts.artic     no-undo .
