      936   function breakstr returns character ( input        for-name    as character,
      937                                         input        line-length as integer,
      938                                         input-output line1       as character,
      939                                         input-output line2       as character ) :
      940     define variable ii as integer no-undo.
      941     if length( for-name ) > line-length then do:
      942       assign ii    = 1
      943              line1 = "":u
      944              line2 = "":u.
      945       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
      946         assign line1 =       substring( for-name, 1, line-length     )
      947                line2 = trim( substring( for-name,    line-length + 1 ) ).
      948       end.                                                     else do:
      949         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
      950           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
      951                  ii    = ii    + 1.
      952           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
      953             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
      954           end.
      955         end.
      956         assign line2 = trim( substring( for-name, length( line1 ) ) ).
      957       end.
      958     end.                                else do:
      959       assign line1 = for-name
      960              line2 = "":u.
      961     end.
      962     return ( line1 ).
      963   end function.
