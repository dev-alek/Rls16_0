     1455       end.
     1456   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1457   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1458     (input  p-artic
     1459     ,input  p-prod-type
     1460     ,input  p-prod-code
     1461     ,input  'gds-goods=request':u
     1462     ,output v-goods-gds-goods
     1463     ) no-error .
     1464       if error-status :error
     1465       then do:
     1466         message
     1467           vss-workfile vss-revision vss-description skip
     1468           vss-include-info17 skip
     1469           "Ошибка при определении атрибута товара" skip
     1470           "Артикул" p-artic p-prod-type p-prod-code skip
     1471           "gds-goods=request" skip
     1472           error-status :get-message(1) skip
     1473           return-value skip
     1474           view-as alert-box error .
     1475         undo, return error return-value .
     1476       end.
     1477   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1478   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1479     (input  p-artic
     1480     ,input  p-prod-type
     1481     ,input  p-prod-code
     1482     ,input  'twounit=request':u
     1483     ,output v-goods-twounit
     1484     ) no-error .
     1485       if error-status :error
     1486       then do:
     1487         message
     1488           vss-workfile vss-revision vss-description skip
     1489           vss-include-info17 skip
     1490           "Ошибка при определении атрибута товара" skip
     1491           "Артикул" p-artic p-prod-type p-prod-code skip
     1492           "twounit=request" skip
     1493           error-status :get-message(1) skip
     1494           return-value skip
     1495           view-as alert-box error .
     1496         undo, return error return-value .
     1497       end.
     1498       for each buf_doc-line no-lock
     1499         where buf_doc-line.obj-type   = p-obj-type
     1500           and buf_doc-line.obj-code   = p-obj-code
     1501           and buf_doc-line.artic      = p-artic
     1502           and buf_doc-line.prod-type  = p-prod-type
     1503           and buf_doc-line.prod-code  = p-prod-code
     1504           and buf_doc-line.status_    = 'факт':U
     1505           and buf_doc-line.fact-order > p-start-fact-order
     1506           and buf_doc-line.fact-order <= p-end-fact-order
     1507       on error undo, return error
     1508       :
     1509         run partslib-process-document in this-procedure
     1510           (input  buf_doc-line.doc-code
     1511           ,input  p-obj-type
     1512           ,input  p-obj-code
     1513           ,input  p-artic
     1514           ,input  p-prod-type
     1515           ,input  p-prod-code
     1516           ,input  v-goods-gds-goods
     1517           ,input  v-goods-twounit
     1518           ,output v-total-parts-qnty
     1519           ) no-error .
     1520         if error-status :error
     1521         then do:
     1522           message
     1523             vss-workfile vss-revision vss-description skip
     1524             vss-include-info17 skip
     1525             "Ошибка при вызове процедуры partslib-process-document" skip
     1526             "Документ" buf_doc-line.doc-code skip
     1527             "Объект" p-obj-type p-obj-code skip
     1528             "Артикул" p-artic p-prod-type p-prod-code skip
     1529             "p-start-fact-order" p-start-fact-order skip
     1530             "p-end-fact-order" p-end-fact-order skip
     1531             error-status :get-message(1) skip
     1532             return-value skip
     1533             view-as alert-box error .
     1534           undo, return error return-value .
     1535         end.
     1536       end.
     1537     end.
     1538   end procedure.
     1539   procedure partslib-process-document :
     1540     define input  parameter p-doc-code         as character no-undo .
     1541     define input  parameter p-obj-type         as character no-undo .
     1542     define input  parameter p-obj-code         as integer   no-undo .
     1543     define input  parameter p-artic            as character no-undo .
     1544     define input  parameter p-prod-type        as character no-undo .
     1545     define input  parameter p-prod-code        as integer   no-undo .
     1546     define input  parameter p-goods-gds-goods  as logical   no-undo .
     1547     define input  parameter p-goods-twounit    as logical   no-undo .
     1548     define output parameter p-total-parts-qnty as decimal   no-undo .
     1549     define variable v-parts-sign as integer   no-undo .
     1550     define buffer buf_trn-doc    for ub.trn-doc .
     1551     define buffer buf_doc-line   for ub.doc-line .
     1552     define buffer buf_parts      for ub.parts .
     1553     define buffer buf_temp-parts for temp-parts .
     1554     do
     1555     on error undo, return error return-value
     1556     :
     1557       find first buf_trn-doc no-lock
     1558         where buf_trn-doc.doc-code = p-doc-code
     1559         no-error .
     1560       if not available buf_trn-doc
     1561       then do:
     1562         undo, return error substitute("Ошибка при поиске документа. Документ &1"
     1563                                      ,p-doc-code
     1564                                      ) .
     1565       end.
     1566       case buf_trn-doc.doc-type
     1567       :
     1568         when 'при':U or
     1569         when 'возврат':U or
     1570         when 'инв':U
     1571         then do:
     1572           assign
     1573             v-parts-sign = -1
     1574           .
     1575         end.
     1576         when 'рас':U or
     1577         when 'спи':U
     1578         then do:
     1579           assign
     1580             v-parts-sign = 1
     1581           .
     1582         end.
     1583         otherwise do:
     1584           undo, return error substitute("Неизвестный тип документа &1"
     1585                                       ,buf_trn-doc.doc-type
     1586                                       ) .
     1587         end.
     1588       end.
     1589       find first buf_doc-line no-lock
     1590         where buf_doc-line.doc-code  = p-doc-code
     1591           and buf_doc-line.artic     = p-artic
     1592           and buf_doc-line.prod-type = p-prod-type
     1593           and buf_doc-line.prod-code = p-prod-code
     1594         no-error .
     1595       if not available buf_doc-line
     1596       then do:
     1597         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
     1598                                      ,p-doc-code
     1599                                      ,artic
     1600                                      ,prod-type
     1601                                      ,prod-code
     1602                                      ) .
     1603       end.
     1604       assign
     1605         p-total-parts-qnty = 0
     1606       .
     1607       if p-goods-gds-goods = true
     1608       then do:
     1609         for each buf_parts no-lock
     1610           where buf_parts.out-code  = p-doc-code
     1611             and buf_parts.obj-type  = p-obj-type
     1612             and buf_parts.obj-code  = p-obj-code
     1613             and buf_parts.artic     = p-artic
     1614             and buf_parts.prod-type = p-prod-type
     1615             and buf_parts.prod-code = p-prod-code
     1616         on error undo, return error
     1617         :
     1618           run partslib-create-temp-parts in this-procedure
     1619             (buffer buf_parts
     1620             ,buffer buf_temp-parts
     1621             ,input  p-goods-twounit
     1622             ) .
     1623           assign
     1624             p-total-parts-qnty        = p-total-parts-qnty
     1625                                       + v-parts-sign * buf_parts.fact-qnty
     1626             buf_temp-parts.qnty       = buf_temp-parts.qnty
     1627                                       + v-parts-sign * buf_parts.fact-qnty
     1628             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
     1629                                       + v-parts-sign * buf_parts.fact-qnty
     1630             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
     1631                                       + v-parts-sign * buf_parts.cli-qnty
     1632           .
     1633           if buf_temp-parts.qnty = 0
     1634           then do:
     1635             delete buf_temp-parts .
     1636           end.
     1637         end.
     1638       end.
     1639       else do:
     1640         assign
     1641           p-total-parts-qnty = p-total-parts-qnty
     1642                              + v-parts-sign * buf_doc-line.fact-qnty
     1643         .
     1644       end.
     1645     end.
     1646   end procedure.
     1647   procedure partslib-init-temp-parts-by-date :
     1648     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     1649     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     1650     define input parameter p-artic           like ub.parts.artic     no-undo .
     1651     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     1652     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     1653     define input parameter p-fact-date       as date      no-undo .
     1654     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
     1655     do
     1656     on error undo, return error
     1657     :
     1658       define variable v-fact-order                as decimal   no-undo .
     1659       define variable v-shift-end-fact-order      as decimal   no-undo .
     1660       define variable v-day-end-fact-order        as decimal   no-undo .
     1661       run factord in this-procedure
     1662         (input  p-fact-date
     1663         ,input  1
     1664         ,input  1
     1665         ,input  ?
     1666         ,input  0
     1667         ,input  false
     1668         ,output v-fact-order
     1669         ,output v-shift-end-fact-order
     1670         ,output v-day-end-fact-order
     1671         ) no-error .
     1672       if error-status :error
     1673       then do:
     1674         message
     1675           vss-workfile vss-revision vss-description skip
     1676           vss-include-info17 skip
     1677           "Ошибка при определении момента времени, на который требуется остаток" skip
     1678           "Объект" p-obj-type p-obj-code skip
     1679           "Артикул" p-artic p-prod-type p-prod-code skip
     1680           "Дата" p-fact-date skip
     1681           view-as alert-box error .
     1682         undo, return error .
     1683       end.
     1684       run partslib-init-temp-parts-by-factord in this-procedure
     1685         (input p-obj-type
     1686         ,input p-obj-code
     1687         ,input p-artic
     1688         ,input p-prod-type
     1689         ,input p-prod-code
     1690         ,input v-day-end-fact-order
     1691         ,input false
     1692         ) no-error .
     1693       if error-status :error
     1694       then do:
     1695         message
     1696           vss-workfile vss-revision vss-description skip
     1697           vss-include-info17 skip
     1698           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
     1699           "Объект" p-obj-type p-obj-code skip
     1700           "Артикул" p-artic p-prod-type p-prod-code skip
     1701           "Дата" p-fact-date skip
     1702           view-as alert-box error .
     1703         undo, return error .
     1704       end.
     1705     end.
     1706   end procedure.
     1707   procedure partslib-calc-cost :
     1708     define output parameter p-fact-qnty      as decimal   no-undo .
     1709     define output parameter p-vat-pc         as decimal   no-undo .
     1710     define output parameter p-slt-pc         as decimal   no-undo .
     1711     define output parameter p-sum-base       as decimal   no-undo .
     1712     define output parameter p-sum-rubl       as decimal   no-undo .
     1713     define output parameter p-vat-base       as decimal   no-undo .
     1714     define output parameter p-vat-rubl       as decimal   no-undo .
     1715     define output parameter p-slt-base       as decimal   no-undo .
     1716     define output parameter p-slt-rubl       as decimal   no-undo .
     1717     define output parameter p-road-tax-base  as decimal   no-undo .
     1718     define output parameter p-road-tax-rubl  as decimal   no-undo .
     1719     define output parameter p-transport-base as decimal   no-undo .
     1720     define output parameter p-transport-rubl as decimal   no-undo .
     1721     define output parameter p-other-base     as decimal   no-undo .
     1722     define output parameter p-other-rubl     as decimal   no-undo .
     1723     define output parameter p-excise-base    as decimal   no-undo .
     1724     define output parameter p-excise-rubl    as decimal   no-undo .
     1725     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     1726     do
     1727     on error undo, return error return-value
     1728     :
     1729       define buffer buf_temp-parts for temp-parts .
     1730       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     1731       define buffer   in-vatp-parts    for ub.parts   .
     1732       define buffer   in-vatp-doc      for ub.trn-doc .
     1733       define buffer   in-vatp-goods    for ub.goods   .
     1734       define buffer   in-vatp-sysconf  for ub.sysconf .
     1735       define buffer   in-vatp_doc-attr for ub.doc-attr.
     1736       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     1737       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     1738       define variable varinvprb                  as   character              no-undo.
     1739       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     1740       define variable cli-base-rate              as   decimal                no-undo.
     1741       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     1742       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     1743       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     1744       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     1745       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     1746       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     1747       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     1748       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1749       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     1750       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     1751       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1752       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     1753       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     1754       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     1755       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     1756       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     1757       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     1758       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     1759       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     1760       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     1761       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     1762       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     1763       define variable varinvatp-envd             as   character              no-undo.
     1764       define variable varinvatp-type             as   character              no-undo.
     1765       for each buf_temp-parts
     1766       on error undo, return error
     1767       :
     1768   assign
     1769     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     1770     price-base-with-tax-loc = buf_temp-parts.price-base
     1771   .
     1772   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1773   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1774     (output varinvprb
     1775     )  .
     1776     if buf_temp-parts.out-code = 'free-zone':U     or
     1777        buf_temp-parts.out-code = 'out-zone':U   or
     1778        buf_temp-parts.doc-type = 'акт':U then do:
     1779       assign
     1780         in-vatp-have-vat-slt = yes.
     1781     end.
     1782     else do:
     1783       find first in-vatp_doc-attr no-lock
     1784         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     1785           and in-vatp_doc-attr.attr-code = 'envd':U
     1786         no-error .
     1787       if not available in-vatp_doc-attr then do:
     1788         assign
     1789           in-vatp-have-vat-slt = yes.
     1790       end.
     1791       else do:
     1792            in-vatp-have-vat-slt = no.
     1793       end.
     1794     end.
     1795     assign
     1796      price-cli-with-tax-loc = buf_temp-parts.price-cli
     1797      cli-base-rate          = buf_temp-parts.cli-base-rate.
     1798     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     1799              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     1800     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     1801             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     1802             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     1803             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     1804             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     1805             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     1806             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1807       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1808     assign
     1809       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     1810     assign
     1811       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1812       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1813       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1814       transport-cli-loc  = 0
     1815       other-cli-loc      = 0
     1816     .
     1817   ASSIGN
     1818             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1819       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1820   .
     1821         assign
     1822           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     1823           p-vat-pc         = p-vat-pc         + vat-pc-loc
     1824           p-slt-pc         = p-slt-pc         + slt-pc-loc
     1825           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     1826           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     1827           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     1828           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     1829           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     1830           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     1831           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     1832           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     1833           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     1834           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     1835           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     1836           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     1837           p-excise-base    = p-excise-base    + 0
     1838           p-excise-rubl    = p-excise-rubl    + 0
     1839         .
     1840       end.
     1841       if p-fact-qnty      = ?
     1842       or p-sum-base       = ?
     1843       or p-sum-rubl       = ?
     1844       or p-vat-base       = ?
     1845       or p-vat-rubl       = ?
     1846       or p-slt-base       = ?
     1847       or p-slt-rubl       = ?
     1848       or p-road-tax-base  = ?
