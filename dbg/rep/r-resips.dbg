     2054   procedure fbrlib_get-default-pay-code :
     2055   define input parameter p-obj-type   as character        no-undo.
     2056   define input parameter p-obj-code   as integer          no-undo.
     2057   define output parameter p-pay-code  as integer          no-undo.
     2058   define variable v-host-code as integer no-undo .
     2059   define buffer buf_shop          for ub.shop.
     2060   define buffer buf_store         for ub.store.
     2061   define buffer buf_sysconf       for ub.sysconf.
     2062   do
     2063   for buf_shop
     2064     , buf_store
     2065     , buf_sysconf
     2066   on error undo, return error
     2067   :
     2068     case p-obj-type  :
     2069       when 'маг':U then do:
     2070           find first buf_shop no-lock
     2071                 where buf_shop.obj-code = p-obj-code
     2072           no-error.
     2073           if available buf_shop
     2074           then do:
     2075               assign
     2076                   p-pay-code = buf_shop.fbr-pay
     2077               .
     2078           end.
     2079       end.
     2080       when 'скл':U then do:
     2081           find first buf_store no-lock
     2082                 where buf_store.obj-code = p-obj-code
     2083           no-error.
     2084           if available buf_store
     2085           then do:
     2086               assign
     2087                   p-pay-code = buf_store.fbr-pay
     2088               .
     2089           end.
     2090       end.
     2091     end case.
     2092     if p-pay-code = ?
     2093     or p-pay-code = 0
     2094     then do:
     2095   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2096   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2097     (input  p-obj-type
     2098     ,input  p-obj-code
     2099     ,output v-host-code
     2100     )  .
     2101         find first buf_sysconf no-lock
     2102               where buf_sysconf.host-code = v-host-code
     2103         no-error.
     2104         if available buf_sysconf
     2105         then do:
     2106             assign
     2107                 p-pay-code = buf_sysconf.fbr-pay
     2108             .
     2109         end.
     2110     end.
     2111     if p-pay-code = ?
     2112     or p-pay-code = 0
     2113     then do:
     2114   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2115   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdnpay in g#library
     2116     (input  p-obj-type
     2117     ,input  p-obj-code
     2118     ,output p-pay-code
     2119     )  .
     2120     end.
     2121   end.
