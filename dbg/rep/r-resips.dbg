     1422           "Артикул" p-artic p-prod-type p-prod-code skip
     1423           "p-start-fact-order" p-start-fact-order skip
     1424           "p-end-fact-order"   p-end-fact-order skip
     1425           view-as alert-box error .
     1426         undo, return error .
     1427       end.
     1428       if p-lock-gds-obj = true
     1429       then do:
     1430         do transaction
     1431         on error undo, return error
     1432         :
     1433   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
