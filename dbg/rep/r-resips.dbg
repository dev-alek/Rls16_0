     2123   procedure fbrlib-fill-and-check-temp_fbrlib_recipe :
     2124   do
     2125   on error undo, return error
     2126   :
     2127   define input parameter p-fbr-doc-code as character    no-undo.
     2128       define variable vss-description as character    no-undo init "fbrlib-fill-and-check-temp_fbrlib_recipe: ".
     2129       define variable v-gds-name      as character    no-undo.
     2130       define buffer buf_fbr-doc               for ub.fbr-doc.
     2131       define buffer buf_fbr-line              for ub.fbr-line.
     2132       define buffer buf_temp_fbrlib_recipe    for temp_fbrlib_recipe.
     2133       define buffer buf_out_temp_fbrlib_recipe    for temp_fbrlib_recipe.
     2134       find first buf_fbr-doc no-lock
     2135            where buf_fbr-doc.doc-code = p-fbr-doc-code
     2136       .
     2137       for each buf_temp_fbrlib_recipe
     2138       :
     2139           delete buf_temp_fbrlib_recipe.
     2140       end.
     2141       for each buf_fbr-line no-lock
     2142          where buf_fbr-line.doc-code = p-fbr-doc-code
     2143       :
     2144           find first buf_temp_fbrlib_recipe
     2145                where buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
     2146           no-error.
     2147           if not available buf_temp_fbrlib_recipe
     2148           then do:
     2149               create buf_temp_fbrlib_recipe.
     2150               assign
     2151                   buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
     2152                   buf_temp_fbrlib_recipe.fbr-doc-code = buf_fbr-line.doc-code
     2153               .
     2154           end.
     2155       end.
     2156       for each buf_temp_fbrlib_recipe
     2157       :
     2158           assign
     2159               buf_temp_fbrlib_recipe.count-income                = 0
     2160               buf_temp_fbrlib_recipe.qnty-income                 = 0
     2161               buf_temp_fbrlib_recipe.sum-income-sale             = 0
     2162               buf_temp_fbrlib_recipe.sum-income-cost-base        = 0
     2163               buf_temp_fbrlib_recipe.sum-income-cost-rubl        = 0
     2164               buf_temp_fbrlib_recipe.sum-income-vat-cost-base    = 0
     2165               buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl    = 0
     2166               buf_temp_fbrlib_recipe.count-write-off             = 0
     2167               buf_temp_fbrlib_recipe.qnty-write-off              = 0
     2168               buf_temp_fbrlib_recipe.sum-write-off-sale          = 0
     2169               buf_temp_fbrlib_recipe.sum-write-off-cost-base     = 0
     2170               buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = 0
     2171               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = 0
     2172               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = 0
     2173           .
     2174           for each buf_fbr-line no-lock
     2175              where buf_fbr-line.doc-code     = p-fbr-doc-code
     2176                and buf_fbr-line.trn-type     = 'при':U
     2177                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
     2178           :
     2179               if ( buf_fbr-line.price-base   = ?
     2180                   or buf_fbr-line.price-rubl = ?
     2181                   or buf_fbr-line.price-base <= 0
     2182                   or buf_fbr-line.price-rubl <= 0 )
     2183               and buf_fbr-line.fact-qnty <> 0
     2184               and buf_fbr-line.rsrv-qnty <> ?
     2185               and buf_fbr-doc.is-free    = no
     2186               then do:
     2187   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2188   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     2189     (input  buf_fbr-line.artic
     2190     ,input  buf_fbr-line.prod-type
     2191     ,input  buf_fbr-line.prod-code
     2192     ,output v-gds-name
     2193     ) no-error .
     2194                   if error-status :error
     2195                   then do:
     2196                       assign
     2197                           v-gds-name = ""
     2198                       .
     2199                   end.
     2200                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
     2201                                                 ,vss-description
     2202                                                 ,buf_fbr-doc.doc-code
     2203                                                 ,chr(10)
     2204                                                 ,buf_fbr-line.recipe-code
     2205                                                 ,buf_fbr-line.artic
     2206                                                 ,v-gds-name).
     2207               end.
     2208               assign
     2209                   buf_temp_fbrlib_recipe.count-income             = buf_temp_fbrlib_recipe.count-income + 1
     2210                   buf_temp_fbrlib_recipe.qnty-income              = buf_temp_fbrlib_recipe.qnty-income
     2211                                                                   + buf_fbr-line.fact-qnty
     2212                   buf_temp_fbrlib_recipe.sum-income-sale          = buf_temp_fbrlib_recipe.sum-income-sale
     2213                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
     2214               .
     2215               if buf_fbr-line.is-waste = no
     2216               then do:
     2217                   assign
     2218                       buf_temp_fbrlib_recipe.sum-income-cost-base     = buf_temp_fbrlib_recipe.sum-income-cost-base
     2219                                                                       + buf_fbr-line.price-sum-base
     2220                       buf_temp_fbrlib_recipe.sum-income-cost-rubl     = buf_temp_fbrlib_recipe.sum-income-cost-rubl
     2221                                                                       + buf_fbr-line.price-sum-rubl
     2222                       buf_temp_fbrlib_recipe.sum-income-vat-cost-base = buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     2223                                                                       + buf_fbr-line.price-sum-vat-base
     2224                       buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     2225                                                                       + buf_fbr-line.price-sum-vat-rubl
     2226                   .
     2227               end.
     2228           end.
     2229           for each buf_fbr-line no-lock
     2230              where buf_fbr-line.doc-code     = p-fbr-doc-code
     2231                and buf_fbr-line.trn-type     = 'спи':U
     2232                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
     2233           :
     2234               if ( buf_fbr-line.price-base   = ?
     2235                   or buf_fbr-line.price-rubl = ?
     2236                   or buf_fbr-line.price-base <= 0
     2237                   or buf_fbr-line.price-rubl <= 0 )
     2238               and buf_fbr-line.fact-qnty <> 0
     2239               and buf_fbr-line.rsrv-qnty <> ?
     2240               and buf_fbr-doc.is-free    = no
     2241               and buf_fbr-doc.status_    = 'разрешен':U
     2242               then do:
     2243   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2244   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     2245     (input  buf_fbr-line.artic
     2246     ,input  buf_fbr-line.prod-type
     2247     ,input  buf_fbr-line.prod-code
     2248     ,output v-gds-name
     2249     ) no-error .
     2250                   if error-status :error
     2251                   then do:
     2252                       assign
     2253                           v-gds-name = ""
     2254                       .
     2255                   end.
     2256                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
     2257                                                 ,vss-description
     2258                                                 ,buf_fbr-doc.doc-code
     2259                                                 ,chr(10)
     2260                                                 ,buf_fbr-line.recipe-code
     2261                                                 ,buf_fbr-line.artic
     2262                                                 ,v-gds-name).
     2263               end.
     2264               assign
     2265                   buf_temp_fbrlib_recipe.count-write-off             = buf_temp_fbrlib_recipe.count-write-off + 1
     2266                   buf_temp_fbrlib_recipe.qnty-write-off              = buf_temp_fbrlib_recipe.qnty-write-off
     2267                                                                   + buf_fbr-line.fact-qnty
     2268                   buf_temp_fbrlib_recipe.sum-write-off-sale          = buf_temp_fbrlib_recipe.sum-write-off-sale
     2269                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
     2270               .
     2271               if buf_fbr-line.is-waste = no
     2272               then do:
     2273                   assign
     2274                       buf_temp_fbrlib_recipe.sum-write-off-cost-base     = buf_temp_fbrlib_recipe.sum-write-off-cost-base
     2275                                                                       + buf_fbr-line.price-sum-base
     2276                       buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     2277                                                                       + buf_fbr-line.price-sum-rubl
     2278                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     2279                                                                       + buf_fbr-line.price-sum-vat-base
     2280                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     2281                                                                       + buf_fbr-line.price-sum-vat-rubl
     2282                   .
     2283               end.
     2284           end.
     2285           if buf_fbr-doc.status_    = 'разрешен':U
     2286           and ( abs( buf_temp_fbrlib_recipe.sum-write-off-cost-base     - buf_temp_fbrlib_recipe.sum-income-cost-base     ) > 0.01
     2287           or abs( buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     - buf_temp_fbrlib_recipe.sum-income-cost-rubl     ) > 0.01
     2288           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base - buf_temp_fbrlib_recipe.sum-income-vat-cost-base ) > 0.01
     2289           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl - buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl ) > 0.01
     2290               )
     2291           then do:
     2292            undo, return error
     2293               substitute("В документе пр-ва &1 Не совпадают суммы учетных цен для списанного и оприходованного по рецепту товара.&2" +
     2294                           "Рецепт: &3&2&4&4по списанному товару&4по оприходованному товару&2"  +
     2295                           "Сумма в баз.вал.&4&5&4&4&6&2" +
     2296                           "Сумма в &9.&4&7&4&4&8&2"
     2297                          , buf_fbr-doc.doc-code
     2298                          , chr(10)
     2299                          , buf_temp_fbrlib_recipe.recipe-code
     2300                          , CHR(9)
     2301                          , buf_temp_fbrlib_recipe.sum-write-off-cost-base
     2302                          , buf_temp_fbrlib_recipe.sum-income-cost-base
     2303                          , buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     2304                          , buf_temp_fbrlib_recipe.sum-income-cost-rubl
     2305                          , "руб"
     2306                          )
     2307              +
     2308              substitute("НДС в баз.вал.&1&2&1&1&3&4" +
     2309                         "НДС в &7.&1&5&1&1&6&4"
     2310                        ,  CHR(9)
     2311                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     2312                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     2313                        ,chr(10)
     2314                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     2315                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     2316                        ,"руб"
     2317                        )       .
     2318           end.
     2319       end.
     2320   end.
     2321   end procedure.
     2322   procedure fbrlib-fill-sum-fbr-doc :
     2323   do
     2324   on error undo, return error
     2325   :
     2326   define input parameter p-fbr-doc-recid  as recid        no-undo.
     2327   define input parameter p-mode           as character    no-undo.
     2328       define variable vss-description as character init "fbrlib-fill-sum-fbr-doc: "  no-undo.
     2329       define buffer buf_fbr-doc           for ub.fbr-doc.
     2330       define buffer buf_fbr-line          for ub.fbr-line.
     2331       define buffer buf_temp_fbrlib_recipe   for temp_fbrlib_recipe.
     2332       define variable v-in-count          as integer       no-undo.
     2333       define variable v-out-count         as integer       no-undo.
     2334       find first buf_fbr-doc exclusive-lock
     2335            where recid ( buf_fbr-doc ) = p-fbr-doc-recid
     2336       .
     2337       find first buf_temp_fbrlib_recipe no-error.
     2338       if not available buf_temp_fbrlib_recipe
     2339       then do:
     2340           run fbrlib-fill-and-check-temp_fbrlib_recipe in this-procedure (
     2341               input buf_fbr-doc.doc-code
     2342           ) no-error.
     2343           if error-status :error
     2344           then do:
     2345               undo, return error substitute("&1 Ошибка расчета сумм при заполнении шапки документа производства.&2&3&2&4"
     2346                                              , vss-description
     2347                                              , chr(10)
     2348                                              , error-status:get-message(1)
     2349                                              , return-value ).
     2350           end.
     2351       end.
     2352       assign
     2353           v-in-count                  = 0
     2354           buf_fbr-doc.in-qnty         = 0
     2355           buf_fbr-doc.in-sale         = 0
     2356           buf_fbr-doc.in-base         = 0
     2357           buf_fbr-doc.in-rubl         = 0
     2358           buf_fbr-doc.in-vat-base     = 0
     2359           buf_fbr-doc.in-vat-rubl     = 0
     2360           v-out-count                 = 0
     2361           buf_fbr-doc.out-qnty        = 0
     2362           buf_fbr-doc.out-sale        = 0
     2363           buf_fbr-doc.out-base        = 0
     2364           buf_fbr-doc.out-rubl        = 0
     2365           buf_fbr-doc.out-vat-base    = 0
     2366           buf_fbr-doc.out-vat-rubl    = 0
     2367       .
     2368       for each buf_temp_fbrlib_recipe
     2369       :
     2370           assign
     2371               v-in-count                  = v-in-count                + buf_temp_fbrlib_recipe.count-income
     2372               buf_fbr-doc.in-qnty         = buf_fbr-doc.in-qnty       + buf_temp_fbrlib_recipe.qnty-income
     2373               buf_fbr-doc.in-sale         = buf_fbr-doc.in-sale       + buf_temp_fbrlib_recipe.sum-income-sale
     2374               buf_fbr-doc.in-base         = buf_fbr-doc.in-base       + buf_temp_fbrlib_recipe.sum-income-cost-base
     2375               buf_fbr-doc.in-rubl         = buf_fbr-doc.in-rubl       + buf_temp_fbrlib_recipe.sum-income-cost-rubl
     2376               buf_fbr-doc.in-vat-base     = buf_fbr-doc.in-vat-base   + buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     2377               buf_fbr-doc.in-vat-rubl     = buf_fbr-doc.in-vat-rubl   + buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     2378               v-out-count                 = v-out-count               + buf_temp_fbrlib_recipe.count-write-off
     2379               buf_fbr-doc.out-qnty        = buf_fbr-doc.out-qnty      + buf_temp_fbrlib_recipe.qnty-write-off
     2380               buf_fbr-doc.out-sale        = buf_fbr-doc.out-sale      + buf_temp_fbrlib_recipe.sum-write-off-sale
     2381               buf_fbr-doc.out-base        = buf_fbr-doc.out-base      + buf_temp_fbrlib_recipe.sum-write-off-cost-base
     2382               buf_fbr-doc.out-rubl        = buf_fbr-doc.out-rubl      + buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     2383               buf_fbr-doc.out-vat-base    = buf_fbr-doc.out-vat-base  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     2384               buf_fbr-doc.out-vat-rubl    = buf_fbr-doc.out-vat-rubl  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     2385           .
     2386       end.
     2387       if ( abs (buf_fbr-doc.in-rubl - buf_fbr-doc.out-rubl) <= 0.01
     2388       and   abs (buf_fbr-doc.in-base - buf_fbr-doc.out-base) <= 0.01 )
     2389       or p-mode <> 'факт':U
     2390       then do:
     2391           if substring( buf_fbr-doc.PS, 1, 1 ) = "@"
     2392           then do:
     2393               assign
     2394                   buf_fbr-doc.PS = "@ Строк полученных товаров : "
     2395                                   + string( v-out-count, ">>>,>>9" )
     2396                                   + chr(10) + "Строк исходных товаров : "
     2397                                   + string( v-in-count, ">>>,>>9" )
     2398               .
     2399           end.
     2400       end.
     2401       else do:
     2402         undo, return error substitute("В док-те пр-ва &1 не совпадают суммы списанных и оприходованных товаров.&2" +
     2403                                       "Сумма списанных товаров в &3 - &4&2" +
     2404                                       "Сумма оприходованных товаров в &3 - &5&2" +
     2405                                       "Сумма оприходованных товаров в &3 - &6&2" +
     2406                                       "Сумма списанных товаров в баз.вал. - &7&2" +
     2407                                       "Сумма оприходованных товаров в баз.вал. - &8&2"
     2408                                       , buf_fbr-doc.doc-code
     2409                                       , chr(10)
     2410                                       , "рублях"
     2411                                       , round( buf_fbr-doc.out-rubl, 2 )
     2412                                       , round( buf_fbr-doc.in-rubl,  2 )
     2413                                       , round( buf_fbr-doc.in-rubl,  2 )
     2414                                       , round( buf_fbr-doc.out-base, 2 )
     2415                                       , round( buf_fbr-doc.in-base,  2 )).
     2416       end.
     2417   end.
     2418   end procedure.
     2419   procedure fbrlib-calc-prices :
     2420   do
     2421   on error undo, return error
     2422   :
     2423   define input parameter p-fbr-line-recid as recid        no-undo.
     2424   define input parameter p-price-obj-type as character    no-undo.
     2425   define input parameter p-price-obj-code as integer      no-undo.
     2426   define output parameter p-current-price as decimal      no-undo.
     2427       define variable v-void          as decimal       no-undo.
     2428       define variable v-void-char     as character     no-undo.
     2429       define variable v-gds-code      as integer       no-undo.
     2430       define variable v-b-code        as integer       no-undo.
     2431       define buffer buf_fbr-doc   for ub.fbr-doc.
     2432       define buffer buf_fbr-line  for ub.fbr-line.
     2433       define buffer buf_gds-prt   for ub.gds-prt.
     2434       define buffer buf_bar-code  for ub.bar-code.
     2435       find first buf_fbr-line no-lock
     2436           where recid( buf_fbr-line ) = p-fbr-line-recid
     2437       .
     2438   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2439   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     2440     (input  buf_fbr-line.artic
     2441     ,input  buf_fbr-line.prod-type
     2442     ,input  buf_fbr-line.prod-code
     2443     ,output v-gds-code
     2444     ) no-error .
     2445       if error-status :error
     2446       then do:
     2447         undo, return error substitute("&1 &2 &3&4Ошибка определения кода товара (артикул &7).&4&5&4&6"
     2448                                         ,vss-workfile
     2449                                         ,vss-revision
     2450                                         ,vss-description
     2451                                         ,chr(10)
     2452                                         , error-status:get-message(1)
     2453                                         , return-value
     2454                                         , buf_fbr-line.artic
     2455                                         ).
     2456       end.
     2457   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2458     (input  v-gds-code
     2459     ,input  ?
     2460     ,output v-b-code
     2461     ) no-error .
     2462       if error-status :error
     2463       then do:
     2464         undo, return error substitute("&1 &2 &3&4Ошибка определения основного бар-кода товара (код товара) &7.&4&5&4&6"
     2465                                         ,vss-workfile
     2466                                         ,vss-revision
     2467                                         ,vss-description
     2468                                         ,chr(10)
     2469                                         , error-status:get-message(1)
     2470                                         , return-value
     2471                                         , v-gds-code
     2472                                         ).
     2473       end.
     2474       if buf_fbr-line.is-calc = no
     2475       then do:
     2476   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2477   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2478     (input  p-price-obj-type
     2479     ,input  p-price-obj-code
     2480     ,input  v-b-code
     2481     ,input  0
     2482     ,input  0
     2483     ,output v-void-char
     2484     ,output p-current-price
     2485     ,output v-void
     2486     ,output v-void
     2487     ) no-error .
     2488           if error-status :error
     2489           then do:
     2490             undo, return error substitute("&1 &2 &3&4Ошибка определения продажной цены основного бар-кода товара (код товара) &7.&4&5&4&6"
     2491                                             ,vss-workfile
     2492                                             ,vss-revision
     2493                                             ,vss-description
     2494                                             ,chr(10)
     2495                                             , error-status:get-message(1)
     2496                                             , return-value
     2497                                             , v-gds-code
     2498                                             ).
     2499           end.
     2500       end.
     2501       else do:
     2502           assign
     2503               p-current-price = buf_fbr-line.price-sale
     2504           .
     2505       end.
     2506   end.
     2507   end procedure.
     2508   procedure fbrlib-put-in-order-recipe :
     2509   do
     2510   on error undo, return error
     2511   :
     2512   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     2513       define variable v-recipe-counter    as integer          no-undo.
     2514       define variable v-recipe-amount     as integer init 0   no-undo.
     2515       define variable v-child-counter     as integer          no-undo.
     2516       define variable v-is-call-cycle     as logical          no-undo.
     2517       define variable v-str as character     no-undo.
     2518       define buffer buf_in_fbr-line       for ub.fbr-line.
     2519       define buffer buf_dress_fbr-line    for ub.fbr-line.
     2520       define buffer buf_fbr-line          for ub.fbr-line.
     2521       define buffer buf_recipe-gds        for ub.recipe-gds.
     2522       define buffer buf_recipe            for ub.recipe.
     2523       for each temp_recipe-childs-qnty
     2524       :
     2525           delete temp_recipe-childs-qnty.
     2526       end.
     2527       for each temp_recipe-childs
     2528       :
     2529           delete temp_recipe-childs.
     2530       end.
     2531       for each temp_recipe-order
     2532       :
     2533           delete temp_recipe-order.
     2534       end.
     2535       for each buf_fbr-line no-lock
     2536          where buf_fbr-line.doc-code = p-fbr-doc-doc-code
     2537       on error undo, return error
     2538       :
     2539           find first temp_recipe-childs-qnty
     2540                where temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     2541           no-error.
     2542           if not available temp_recipe-childs-qnty
     2543           then do:
     2544               create temp_recipe-childs-qnty.
     2545               assign
     2546                   v-recipe-amount                     = v-recipe-amount + 1
     2547                   temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     2548                   temp_recipe-childs-qnty.order       = v-recipe-amount
     2549                   temp_recipe-childs-qnty.childs-qnty = 0
     2550                   v-child-counter                     = 0
     2551               .
     2552           end.
     2553       end.
     2554       for each buf_in_fbr-line no-lock
     2555          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     2556            and buf_in_fbr-line.trn-type = 'спи':U
     2557       on error undo, return error
     2558       :
     2559           for each buf_dress_fbr-line no-lock
     2560              where buf_dress_fbr-line.doc-code    = p-fbr-doc-doc-code
     2561                and buf_dress_fbr-line.trn-type    = 'при':U
     2562                and buf_dress_fbr-line.artic       = buf_in_fbr-line.artic
     2563                and buf_dress_fbr-line.prod-type   = buf_in_fbr-line.prod-type
     2564                and buf_dress_fbr-line.prod-code   = buf_in_fbr-line.prod-code
     2565           on error undo, return error
     2566           :
     2567               find first buf_recipe no-lock
     2568                    where buf_recipe.recipe-code = buf_dress_fbr-line.recipe-code
     2569               .
     2570               if buf_in_fbr-line.is-comp = yes
     2571               then do:
     2572                   find last temp_recipe-childs-qnty
     2573                       where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     2574                   .
     2575                   assign
     2576                       temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     2577                   .
     2578                   create temp_recipe-childs.
     2579                   assign
     2580                       temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     2581                       temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     2582                       temp_recipe-childs.child-recipe-code    = buf_dress_fbr-line.recipe-code
     2583                   .
     2584               end.
     2585               else do:
     2586               end.
     2587           end.
     2588       end.
     2589       for each buf_in_fbr-line no-lock
     2590          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     2591            and buf_in_fbr-line.trn-type = 'при':U
     2592       on error undo, return error
     2593       :
     2594           find first buf_recipe no-lock
     2595                where buf_recipe.recipe-code = buf_in_fbr-line.recipe-code
     2596           no-error.
     2597           if buf_in_fbr-line.is-comp = no
     2598           then do:
     2599           end.
     2600           else do:
     2601               for each buf_recipe-gds no-lock
     2602               where buf_recipe-gds.recipe-code = buf_in_fbr-line.recipe-code
     2603               :
     2604                   for each buf_fbr-line no-lock
     2605                   where buf_fbr-line.doc-code    = p-fbr-doc-doc-code
     2606                       and buf_fbr-line.trn-type    = 'при':U
     2607                       and buf_fbr-line.artic       = buf_recipe-gds.artic
     2608                       and buf_fbr-line.prod-type   = buf_recipe-gds.prod-type
     2609                       and buf_fbr-line.prod-code   = buf_recipe-gds.prod-code
     2610                   on error undo, return error
     2611                   :
     2612                       find first buf_recipe no-lock
     2613                            where buf_recipe.recipe-code = buf_fbr-line.recipe-code
     2614                       .
     2615                       if buf_recipe.recipe-type = 'разделка':U
     2616                       then do:
     2617                       end.
     2618                       else do:
     2619                           find last temp_recipe-childs-qnty
     2620                               where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     2621                           .
     2622                           assign
     2623                               temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     2624                           .
     2625                           create temp_recipe-childs.
     2626                           assign
     2627                               temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     2628                               temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     2629                               temp_recipe-childs.child-recipe-code    = buf_fbr-line.recipe-code
     2630                           .
     2631                       end.
     2632                   end.
     2633               end.
     2634           end.
     2635       end.
     2636       for each temp_recipe-order
     2637       on error undo, return error
     2638       :
     2639           delete temp_recipe-order.
     2640       end.
     2641       assign
     2642           v-fbrlib-recipe-order = 0
     2643       .
     2644       do v-recipe-counter = 1 to v-recipe-amount
     2645       on error undo, return error
     2646       :
     2647           run fbrlib-add-recipe-in-tmp-order in this-procedure (
     2648                 input v-recipe-counter
     2649               , input 0
     2650               , output v-is-call-cycle
     2651           ).
     2652           if v-is-call-cycle = yes
     2653           then do:
     2654               message
     2655                       "Достигнут максимальный уровень вложенности рецептов."
     2656                   skip(1)
     2657                   skip "Невозможно упорядочить рецепты."
     2658                   skip(1)
     2659                   skip "Необходимо изменить структуру рецептов,"
     2660                   skip "используемых при формировании"
     2661                   skip "данного документа производства."
     2662               view-as alert-box error
     2663               title "Невозможно рассчитать документ производства".
     2664               for each temp_recipe-childs-qnty
     2665               :
     2666                   delete temp_recipe-childs-qnty.
     2667               end.
     2668               for each temp_recipe-childs
     2669               :
     2670                   delete temp_recipe-childs.
     2671               end.
     2672               for each temp_recipe-order
     2673               :
     2674                   delete temp_recipe-order.
     2675               end.
     2676               for each temp_recipe-order
     2677               on error undo, return error
     2678               :
     2679                   delete temp_recipe-order.
     2680               end.
     2681               for each temp_fbrlib_recipe
     2682               on error undo, return error
     2683               :
     2684                   delete temp_recipe-order.
     2685               end.
     2686               undo, return error.
     2687           end.
     2688       end.
     2689   end.
     2690   end procedure.
     2691   procedure fbrlib-add-recipe-in-tmp-order :
     2692   do
     2693   on error undo, return error
     2694   :
     2695   define input parameter p-order              as integer      no-undo.
     2696   define input parameter p-call-counter       as integer      no-undo.
     2697   define output parameter p-is-call-cycle     as logical      no-undo.
     2698       define variable v-nodes-counter     as integer       no-undo.
     2699       define buffer buf_c_temp_recipe-childs-qnty for temp_recipe-childs-qnty.
     2700       define buffer buf_temp_recipe-childs-qnty   for temp_recipe-childs-qnty.
     2701       define buffer buf_temp_recipe-childs        for temp_recipe-childs     .
     2702       define buffer buf_temp_recipe-order         for temp_recipe-order.
     2703       assign
     2704           p-call-counter = p-call-counter + 1
     2705       .
     2706       if p-call-counter > 50
     2707       then do:
     2708           assign
     2709               p-is-call-cycle = yes
     2710           .
     2711       end.
     2712       else do:
     2713           find first buf_temp_recipe-childs-qnty
     2714                where buf_temp_recipe-childs-qnty.order = p-order
     2715           .
     2716           find first buf_temp_recipe-order
     2717                where buf_temp_recipe-order.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     2718           no-error.
     2719           if not available buf_temp_recipe-order
     2720           then do:
     2721               do v-nodes-counter = 1 to buf_temp_recipe-childs-qnty.childs-qnty
     2722               :
     2723                   find first buf_temp_recipe-childs
     2724                        where buf_temp_recipe-childs.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     2725                          and buf_temp_recipe-childs.child-code  = v-nodes-counter
     2726                   .
     2727                   find first buf_c_temp_recipe-childs-qnty
     2728                        where buf_c_temp_recipe-childs-qnty.recipe-code = buf_temp_recipe-childs.child-recipe-code
     2729                   .
     2730                   run fbrlib-add-recipe-in-tmp-order in this-procedure (
     2731                         input buf_c_temp_recipe-childs-qnty.order
     2732                       , input p-call-counter
     2733                       , output p-is-call-cycle
     2734                   ).
     2735                   if p-is-call-cycle = yes
     2736                   then do:
     2737                       return.
     2738                   end.
     2739               end.
     2740               assign
     2741                   v-fbrlib-recipe-order = v-fbrlib-recipe-order + 1
     2742               .
     2743               create buf_temp_recipe-order.
     2744               assign
     2745                   buf_temp_recipe-order.recipe-code   = buf_temp_recipe-childs-qnty.recipe-code
     2746                   buf_temp_recipe-order.order         = v-fbrlib-recipe-order
     2747               .
     2748           end.
     2749       end.
     2750   end.
     2751   end procedure.
     2752   procedure fbrlib-get-trn-type :
     2753   define input parameter p-recipe-code    as character    no-undo.
     2754   define input parameter p-goods-recid    as recid        no-undo.
     2755   define input parameter p-is-integration as logical      no-undo.
     2756   define output parameter p-is-comp       as logical      no-undo.
     2757   define output parameter p-trn-type      as character    no-undo.
     2758   define buffer buf_recipe    for ub.recipe.
     2759   define buffer buf_goods     for ub.goods.
     2760   do
     2761   for buf_recipe
     2762     , buf_goods
     2763   on error undo, return error
     2764   :
     2765       find first buf_goods no-lock
     2766            where recid( buf_goods ) = p-goods-recid
     2767       .
     2768       find first buf_recipe no-lock
     2769            where buf_recipe.recipe-code = p-recipe-code
     2770       no-error.
     2771       if not available buf_recipe
     2772       then do:
     2773           assign
     2774               p-is-comp = no
     2775               p-trn-type = "":U
     2776           .
     2777           undo, return.
     2778       end.
     2779       if  buf_recipe.artic        = buf_goods.artic
     2780       and buf_recipe.prod-type    = buf_goods.prod-type
     2781       and buf_recipe.prod-code    = buf_goods.prod-code
     2782       then do:
     2783           assign
     2784               p-is-comp = yes
     2785           .
     2786       end.
     2787       else do:
     2788           assign
     2789               p-is-comp = no
     2790           .
     2791       end.
     2792       case buf_recipe.recipe-type
     2793       :
     2794           when 'производство':U
     2795           then do:
     2796               if p-is-comp = yes
     2797               then do:
     2798                   assign
     2799                       p-trn-type = 'при':U
     2800                   .
     2801               end.
     2802               else do:
     2803                   assign
     2804                       p-trn-type = 'спи':U
     2805                   .
     2806               end.
     2807           end.
     2808           when 'альтернатива':U
     2809           then do:
     2810               if p-is-comp = yes
     2811               then do:
     2812                   assign
     2813                       p-trn-type = 'при':U
     2814                   .
     2815               end.
     2816               else do:
     2817                   assign
     2818                       p-trn-type = 'спи':U
     2819                   .
     2820               end.
     2821           end.
     2822           when 'разделка':U
     2823           then do:
     2824               if p-is-comp = no
     2825               then do:
     2826                   assign
     2827                       p-trn-type = 'при':U
     2828                   .
     2829               end.
     2830               else do:
     2831                   assign
     2832                       p-trn-type = 'спи':U
     2833                   .
     2834               end.
     2835           end.
     2836           when 'комплектация':U
     2837           then do:
     2838               if p-is-integration = ?
     2839               then do:
     2840                   message
     2841                       "Выберите тип операции по рецепту комплектации:"
     2842                       skip (2) "YES - комплектация"
     2843                       skip     "NO - разукомплектация"
     2844                   view-as alert-box question
     2845                   buttons YES-NO
     2846                   update p-is-integration.
     2847               end.
     2848               if p-is-integration = yes
     2849               then do:
     2850                   if p-is-comp = yes
     2851                   then do:
     2852                       assign
     2853                           p-trn-type = 'при':U
     2854                       .
     2855                   end.
     2856                   else do:
     2857                       assign
     2858                           p-trn-type = 'спи':U
     2859                       .
     2860                   end.
     2861               end.
     2862               else do:
     2863                   if p-is-comp = yes
     2864                   then do:
     2865                       assign
     2866                           p-trn-type = 'спи':U
     2867                       .
     2868                   end.
     2869                   else do:
     2870                       assign
     2871                           p-trn-type = 'при':U
     2872                       .
     2873                   end.
     2874               end.
     2875           end.
     2876       end case.
     2877   end.
     2878   end procedure.
     2879   procedure fbrlib-get-mark :
     2880   define input parameter p-recipe-code    as character    no-undo.
     2881   define output parameter p-mark          as logical    no-undo.
     2882   define buffer buf_goods-attr     for ub.goods-attr.
     2883   define buffer buf_recipe-gds for ub.recipe-gds .
     2884       for each buf_recipe-gds no-lock where buf_recipe-gds.recipe-code = p-recipe-code,
     2885            first buf_goods-attr no-lock where buf_goods-attr.gds-code = buf_recipe-gds.gds-code and
     2886                                               buf_goods-attr.attr-code = 'mark-type':U:
     2887            if buf_goods-attr.attr-value <> "" and buf_goods-attr.attr-value <> "not-type" then do:
     2888               p-mark = true .
     2889               return .
     2890            end.
     2891       end.
     2892   end procedure.
     2893   procedure fbrlib-check-temp-tables :
     2894   do
     2895   on error undo, return error
     2896   :
     2897   define input parameter p-title  as character    no-undo.
     2898       define variable v-str               as character        no-undo.
     2899       assign
     2900           v-str = v-str + chr(10) + "temp_recipe-childs-qnty:" + chr(10)
     2901       .
     2902       for each temp_recipe-childs-qnty
     2903       on error undo, return error
     2904       :
     2905           assign
     2906               v-str   = v-str + string( temp_recipe-childs-qnty.recipe-code )
     2907                       + "   " + string( temp_recipe-childs-qnty.childs-qnty )
     2908                       + "   " + string( temp_recipe-childs-qnty.order )
     2909                       + chr(10)
     2910           .
     2911       end.
     2912       assign
     2913           v-str = v-str + "temp_recipe-childs:" + chr(10)
     2914       .
     2915       for each temp_recipe-childs
     2916       on error undo, return error
     2917       :
     2918           assign
     2919               v-str   = v-str + string( temp_recipe-childs.recipe-code )
     2920                       + "   " + string( temp_recipe-childs.child-code )
     2921                       + "   " + string( temp_recipe-childs.child-recipe-code )
     2922                       + chr(10)
     2923           .
     2924       end.
     2925       assign
     2926           v-str = v-str + chr(10) + "temp_recipe-order:" + chr(10)
     2927       .
     2928       for each temp_recipe-order
     2929       on error undo, return error
     2930       :
     2931           assign
     2932               v-str   = v-str + string( temp_recipe-order.recipe-code )
     2933                       + "   " + string( temp_recipe-order.order )
     2934                       + chr(10)
     2935           .
     2936       end.
     2937       assign
     2938           v-str = v-str + chr(10) + "temp_fbrlib_recipe:" + chr(10)
     2939       .
     2940       run writelog in this-procedure ( input "fbr.log", input 0, input p-title ).
     2941       run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     2942       for each temp_fbrlib_recipe
     2943       on error undo, return error
     2944       :
     2945           assign
     2946               v-str   = "recipe-code: "                   + string( temp_fbrlib_recipe.recipe-code                 )
     2947                       + "   " + "count-income: "                  + string( temp_fbrlib_recipe.count-income                )
     2948                       + "   " + "qnty-income: "                   + string( temp_fbrlib_recipe.qnty-income                 )
     2949                       + "   " + "sum-income-sale: "               + string( temp_fbrlib_recipe.sum-income-sale             )
     2950                       + "   " + "sum-income-cost-base: "          + string( temp_fbrlib_recipe.sum-income-cost-base        )
     2951                       + "   " + "sum-income-cost-rubl: "          + string( temp_fbrlib_recipe.sum-income-cost-rubl        )
     2952                       + "   " + "sum-income-vat-cost-base: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-base    )
     2953                       + "   " + "sum-income-vat-cost-rubl: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-rubl    )
     2954                       + "   " + "count-write-off: "               + string( temp_fbrlib_recipe.count-write-off             )
     2955                       + "   " + "qnty-write-off: "                + string( temp_fbrlib_recipe.qnty-write-off              )
     2956                       + "   " + "sum-write-off-sale: "            + string( temp_fbrlib_recipe.sum-write-off-sale          )
     2957                       + "   " + "sum-write-off-cost-base: "       + string( temp_fbrlib_recipe.sum-write-off-cost-base     )
     2958                       + "   " + "sum-write-off-cost-rubl: "       + string( temp_fbrlib_recipe.sum-write-off-cost-rubl     )
     2959                       + "   " + "sum-write-off-vat-cost-base: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-base )
     2960                       + "   " + "sum-write-off-vat-cost-rubl: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-rubl )
     2961                       + chr(10)
     2962           .
     2963           run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     2964       end.
     2965   end.
     2966   end procedure.
     2967   procedure fbrlib-s-coeff-value :
     2968   define input  parameter p-gds-code    as integer        no-undo.
     2969   define input  parameter p-date        as date           no-undo.
     2970   define input  parameter p-obj-type    as character      no-undo.
     2971   define input  parameter p-obj-code    as integer        no-undo.
     2972   define output parameter p-coeff-value as decimal        no-undo.
     2973   define variable vss-description as character init "fbrlib-s-coeff-value-01: определяет значение сезонного коэффициента" no-undo.
     2974       define variable v-date          as date         no-undo.
     2975       define variable v-host-code     as integer      no-undo.
     2976       define buffer buf_goods       for ub.goods.
     2977       define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     2978       define buffer buf_clients     for ub.clients.
     2979       define buffer buf_s-coeff     for ub.s-coeff.
     2980   do
     2981   for buf_goods
     2982     , buf_fbr-gds-obj
     2983     , buf_clients
     2984     , buf_s-coeff
     2985   on error undo, return error return-value
     2986   :
     2987       find first buf_goods no-lock
     2988            where buf_goods.gds-code = p-gds-code
     2989       no-error .
     2990       if not available buf_goods
     2991       then do:
     2992          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден товар с кодом &1", p-gds-code).
     2993       end.
     2994       find first buf_clients no-lock
     2995            where buf_clients.obj-type = p-obj-type
     2996              and buf_clients.obj-code = p-obj-code
     2997       no-error.
     2998       if not available buf_clients
     2999       then do:
     3000          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден объект &1&2", p-obj-type, p-obj-code).
     3001       end.
     3002       assign
     3003           v-date = date(month(p-date), day(p-date), Year(01/01/1996))
     3004       .
     3005       find first buf_fbr-gds-obj no-lock
     3006            where buf_fbr-gds-obj.gds-code = p-gds-code
     3007              and buf_fbr-gds-obj.obj-type = p-obj-type
     3008              and buf_fbr-gds-obj.obj-code = p-obj-code
     3009       no-error.
     3010       if not available buf_fbr-gds-obj
     3011       or buf_fbr-gds-obj.is-season = no
     3012       then do:
     3013           assign
     3014               p-coeff-value = 0
     3015           .
     3016           return.
     3017       end.
     3018   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3019   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3020     (input  p-obj-type
     3021     ,input  p-obj-code
     3022     ,output v-host-code
     3023     )  .
     3024       find last buf_s-coeff no-lock
     3025           where buf_s-coeff.gds-code = p-gds-code
     3026             and buf_s-coeff.host-code = v-host-code
     3027             and buf_s-coeff.obj-type = p-obj-type
     3028             and buf_s-coeff.obj-code = p-obj-code
     3029             and buf_s-coeff.s-date <= v-date
     3030       no-error.
     3031       if available buf_s-coeff
     3032       then do:
     3033           assign
     3034               p-coeff-value = buf_s-coeff.coeff-value
     3035           .
     3036           return.
     3037       end.
     3038       find last buf_s-coeff no-lock
     3039           where buf_s-coeff.gds-code = p-gds-code
     3040             and buf_s-coeff.host-code = v-host-code
     3041             and buf_s-coeff.obj-type = "":U
     3042             and buf_s-coeff.obj-code = 0
     3043             and buf_s-coeff.s-date <= v-date
     3044       no-error.
     3045       if available buf_s-coeff
     3046       then do:
     3047           assign
     3048               p-coeff-value = buf_s-coeff.coeff-value
     3049           .
     3050           return.
     3051       end.
     3052       find last buf_s-coeff no-lock
     3053           where buf_s-coeff.gds-code = p-gds-code
     3054             and buf_s-coeff.host-code = 0
     3055             and buf_s-coeff.obj-type = "":U
     3056             and buf_s-coeff.obj-code = 0
     3057             and buf_s-coeff.s-date <= v-date
     3058       no-error.
     3059       if available buf_s-coeff
     3060       then do:
     3061           assign
     3062               p-coeff-value = buf_s-coeff.coeff-value
     3063           .
     3064       end.
     3065       else do:
     3066           assign
     3067               p-coeff-value = 0
     3068           .
     3069       end.
     3070   end.
     3071   end procedure.
     3072   procedure fbrlib_create-fbr-recipe-gds :
     3073   define input parameter p-doc-code         as character      no-undo.
     3074   define input parameter p-recipe-code      as character      no-undo.
     3075   define input parameter p-prod-type        as character      no-undo.
     3076   define input parameter p-prod-code        as integer        no-undo.
     3077   define input parameter p-artic            as character      no-undo.
     3078   define input parameter p-gds-code         as integer        no-undo.
     3079   define input parameter p-is-waste         as logical        no-undo.
     3080   define input parameter p-proc-number      as integer        no-undo.
     3081   define input parameter p-obj-date         as date           no-undo.
     3082   define input parameter p-obj-type         as character      no-undo.
     3083   define input parameter p-obj-code         as integer        no-undo.
     3084   define input parameter p-calc-method      as decimal        no-undo.
     3085   define input parameter p-coeff-waste      as decimal        no-undo.
     3086   define input parameter p-orig-qnty        as decimal        no-undo.
     3087   define input parameter p-orig-brutto-qnty as decimal        no-undo.
     3088       define variable v-coeff-season  as decimal      no-undo.
     3089       define variable v-void-decimal  as decimal      no-undo.
     3090       define variable v-void-integer  as integer      no-undo.
     3091       define variable v-recipe-type   as character    no-undo.
     3092       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     3093       define buffer buf_goods             for ub.goods.
     3094       define buffer buf_recipe            for ub.recipe.
     3095   do
     3096   for buf_fbr-recipe-gds
     3097     , buf_recipe
     3098     , buf_goods
     3099   on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     3100   :
     3101       find first buf_fbr-recipe-gds exclusive-lock
     3102            where buf_fbr-recipe-gds.doc-code    = p-doc-code
     3103              and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     3104              and buf_fbr-recipe-gds.prod-type   = p-prod-type
     3105              and buf_fbr-recipe-gds.prod-code   = p-prod-code
     3106              and buf_fbr-recipe-gds.artic       = p-artic
     3107       no-error.
     3108       if not available buf_fbr-recipe-gds
     3109       then do:
     3110           create buf_fbr-recipe-gds.
     3111           assign
     3112               buf_fbr-recipe-gds.doc-code           = p-doc-code
     3113               buf_fbr-recipe-gds.recipe-code        = p-recipe-code
     3114               buf_fbr-recipe-gds.prod-type          = p-prod-type
     3115               buf_fbr-recipe-gds.prod-code          = p-prod-code
     3116               buf_fbr-recipe-gds.artic              = p-artic
     3117               buf_fbr-recipe-gds.gds-code           = p-gds-code
     3118               buf_fbr-recipe-gds.is-waste           = p-is-waste
     3119               buf_fbr-recipe-gds.proc-number        = p-proc-number
     3120               buf_fbr-recipe-gds.recipe-qnty        = p-orig-qnty
     3121               buf_fbr-recipe-gds.recipe-brutto-qnty = p-orig-brutto-qnty
     3122           .
     3123           find first buf_goods no-lock
     3124                where buf_goods.prod-type = buf_fbr-recipe-gds.prod-type
     3125                  and buf_goods.prod-code = buf_fbr-recipe-gds.prod-code
     3126                  and buf_goods.artic     = buf_fbr-recipe-gds.artic
     3127           .
     3128           run fbrlib-s-coeff-value in this-procedure (
     3129                 input buf_goods.gds-code
     3130               , input p-obj-date
     3131               , input p-obj-type
     3132               , input p-obj-code
     3133               , output v-coeff-season
     3134           ) no-error.
     3135           if error-status:error
     3136           then do:
     3137               return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)).
     3138           end.
     3139           assign
     3140               buf_fbr-recipe-gds.qnty         = p-orig-qnty
     3141               buf_fbr-recipe-gds.coeff-value  = v-coeff-season
     3142               buf_fbr-recipe-gds.coeff-waste  = p-coeff-waste
     3143           .
     3144           run fbrlib-get-recipe-type in this-procedure (
     3145                 input buf_fbr-recipe-gds.doc-code
     3146               , input buf_fbr-recipe-gds.recipe-code
     3147               , output v-recipe-type
     3148           ).
     3149           if v-recipe-type <> 'производство':U
     3150           then do:
     3151               assign
     3152                   buf_fbr-recipe-gds.coeff-value  = 0
     3153                   buf_fbr-recipe-gds.coeff-waste  = 0
     3154                   buf_fbr-recipe-gds.calc-method  = 1
     3155                   buf_fbr-recipe-gds.brutto-qnty  = buf_fbr-recipe-gds.qnty
     3156               .
     3157           end.
     3158           else do:
     3159               run fbrlib-calc-brutto in this-procedure (
     3160                     input v-recipe-type
     3161                   , input buf_fbr-recipe-gds.qnty
     3162                   , input buf_fbr-recipe-gds.coeff-value
     3163                   , input buf_fbr-recipe-gds.coeff-waste
     3164                   , input 0
     3165                   , input 3
     3166                   , output v-void-decimal
     3167                   , output v-void-decimal
     3168                   , output buf_fbr-recipe-gds.brutto-qnty
     3169                   , output v-void-integer
     3170               ).
     3171               assign
     3172                   buf_fbr-recipe-gds.calc-method  = p-calc-method
     3173               .
     3174               run fbrlib-calc-brutto in this-procedure (
     3175                     input v-recipe-type
     3176                   , input buf_fbr-recipe-gds.qnty
     3177                   , input buf_fbr-recipe-gds.coeff-value
     3178                   , input buf_fbr-recipe-gds.coeff-waste
     3179                   , input buf_fbr-recipe-gds.brutto-qnty
     3180                   , input buf_fbr-recipe-gds.calc-method
     3181                   , output buf_fbr-recipe-gds.qnty
     3182                   , output v-void-decimal
     3183                   , output v-void-decimal
     3184                   , output v-void-integer
     3185               ).
     3186           end.
     3187       end.
     3188   end.
     3189   end procedure.
     3190   procedure fbrlib-set-default-recipe :
     3191   define input parameter p-obj-type   as character    no-undo.
     3192   define input parameter p-obj-code   as integer      no-undo.
     3193   define input parameter p-gds-code   as integer      no-undo.
     3194       define variable v-artic             as character    no-undo.
     3195       define variable v-prod-type         as character    no-undo.
     3196       define variable v-prod-code         as character    no-undo.
     3197       define variable v-recipe-code       as character    no-undo.
     3198       define variable v-fbr-gds-obj-recid as recid        no-undo.
     3199       define variable v-recipe-found      as logical      no-undo.
     3200       define buffer buf_recipe        for ub.recipe.
     3201       define buffer buf_other_recipe  for ub.recipe.
     3202       define buffer buf_goods         for ub.goods.
     3203       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     3204   do
     3205   for buf_recipe
     3206     , buf_goods
     3207     , buf_fbr-gds-obj
     3208   on error undo, return error
     3209   :
     3210       find first buf_goods no-lock
     3211            where buf_goods.gds-code = p-gds-code
     3212       .
     3213       run fbrlib-get-obj-recipe in this-procedure (
     3214             input p-obj-type
     3215           , input p-obj-code
     3216           , input p-gds-code
     3217           , output v-recipe-code
     3218       ).
     3219       if v-recipe-code <> ""
     3220       then do:
     3221           find first buf_recipe no-lock
     3222               where buf_recipe.recipe-code = v-recipe-code
     3223           no-error.
     3224           if not available buf_recipe
     3225           then do:
     3226               assign
     3227                   v-recipe-code = ""
     3228               .
     3229           end.
     3230       end.
     3231       if v-recipe-code = ""
     3232       then do:
     3233           find first buf_fbr-gds-obj exclusive-lock
     3234                where buf_fbr-gds-obj.obj-type = p-obj-type
     3235                  and buf_fbr-gds-obj.obj-code = p-obj-code
     3236                  and buf_fbr-gds-obj.gds-code = p-gds-code
     3237           no-error.
     3238           if not available buf_fbr-gds-obj
     3239           then do:
     3240               run ref/fgdsobj1.p (
     3241                     input-output v-fbr-gds-obj-recid
     3242                   , input 'ДОБАВЛЕНИЕ':U
     3243                   , input no
     3244                   , input p-gds-code
     3245                   , input p-obj-type
     3246                   , input p-obj-code
     3247                   , input 0
     3248                   , input ""
     3249                   , input 0
     3250                   , input no
     3251                   , input no
     3252                   , input no
     3253                   , input no
     3254                   , input no
     3255                   , input no
     3256               ) no-error.
     3257               if error-status:error
     3258               then do:
     3259                   message
     3260                           vss-workfile vss-revision vss-description
     3261                       skip "Ошибка изменения атрибутов товара на объекте"
     3262                       skip return-value
     3263                       skip trim(error-status :get-message(1))
     3264                               trim(error-status :get-message(2))
     3265                               trim(error-status :get-message(3))
     3266                   view-as alert-box error.
     3267                   undo, return error .
     3268               end.
     3269               find first buf_fbr-gds-obj exclusive-lock
     3270                    where recid( buf_fbr-gds-obj ) = v-fbr-gds-obj-recid
     3271               .
     3272           end.
     3273           assign
     3274               v-recipe-found = no
     3275           .
     3276           for first buf_recipe no-lock
     3277               where buf_recipe.obj-type    = p-obj-type
     3278                 and buf_recipe.obj-code    = p-obj-code
     3279                 and buf_recipe.artic       = buf_goods.artic
     3280                 and buf_recipe.prod-type   = buf_goods.prod-type
     3281                 and buf_recipe.prod-code   = buf_goods.prod-code
     3282                 and buf_recipe.recipe-type = 'производство':U
     3283                 or (
     3284                     buf_recipe.obj-type    = ""
     3285                 and buf_recipe.obj-code    = 0
     3286                 and buf_recipe.artic       = buf_goods.artic
     3287                 and buf_recipe.prod-type   = buf_goods.prod-type
     3288                 and buf_recipe.prod-code   = buf_goods.prod-code
     3289                 and buf_recipe.recipe-type = 'производство':U
     3290                     )
     3291           :
     3292               assign
     3293                   v-recipe-found = yes
     3294                   buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     3295               .
     3296           end.
     3297           if v-recipe-found = no
     3298           then do:
     3299               for first buf_recipe no-lock
     3300                   where buf_recipe.obj-type    = p-obj-type
     3301                     and buf_recipe.obj-code    = p-obj-code
     3302                     and buf_recipe.artic       = buf_goods.artic
     3303                     and buf_recipe.prod-type   = buf_goods.prod-type
     3304                     and buf_recipe.prod-code   = buf_goods.prod-code
     3305                     and buf_recipe.recipe-type <> 'альтернатива':U
     3306                     or (
     3307                         buf_recipe.obj-type    = ""
     3308                     and buf_recipe.obj-code    = 0
     3309                     and buf_recipe.artic       = buf_goods.artic
     3310                     and buf_recipe.prod-type   = buf_goods.prod-type
     3311                     and buf_recipe.prod-code   = buf_goods.prod-code
     3312                     and buf_recipe.recipe-type <> 'альтернатива':U
     3313                         )
     3314               :
     3315                   assign
     3316                       v-recipe-found = yes
     3317                       buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     3318                   .
     3319               end.
     3320               if v-recipe-found = no
     3321               then do:
     3322                   for first buf_recipe no-lock
     3323                       where buf_recipe.obj-type    = p-obj-type
     3324                         and buf_recipe.obj-code    = p-obj-code
     3325                         and buf_recipe.artic       = buf_goods.artic
     3326                         and buf_recipe.prod-type   = buf_goods.prod-type
     3327                         and buf_recipe.prod-code   = buf_goods.prod-code
     3328                         or (
     3329                             buf_recipe.obj-type    = ""
     3330                         and buf_recipe.obj-code    = 0
     3331                         and buf_recipe.artic       = buf_goods.artic
     3332                         and buf_recipe.prod-type   = buf_goods.prod-type
     3333                         and buf_recipe.prod-code   = buf_goods.prod-code
     3334                             )
     3335                   :
     3336                       assign
     3337                           v-recipe-found = yes
     3338                           buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     3339                       .
     3340                   end.
     3341                   if v-recipe-found = no
     3342                   then do:
     3343                       assign
     3344                           buf_fbr-gds-obj.default-recipe-code = ""
     3345                       .
     3346                   end.
     3347               end.
     3348           end.
     3349       end.
     3350   end.
     3351   end procedure.
     3352   procedure fbrlib-get-obj-recipe :
     3353   define input parameter p-obj-type       as character    no-undo.
     3354   define input parameter p-obj-code       as integer      no-undo.
     3355   define input parameter p-gds-code       as integer      no-undo.
     3356   define output parameter p-recipe-code   as character    no-undo.
     3357       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     3358   do
     3359   for buf_fbr-gds-obj
     3360   on error undo, return error
     3361   :
     3362       find first buf_fbr-gds-obj no-lock
     3363            where buf_fbr-gds-obj.obj-type = p-obj-type
     3364              and buf_fbr-gds-obj.obj-code = p-obj-code
     3365              and buf_fbr-gds-obj.gds-code = p-gds-code
     3366       no-error.
     3367       if available buf_fbr-gds-obj
     3368       then do:
     3369           assign
     3370               p-recipe-code = buf_fbr-gds-obj.default-recipe-code
     3371           .
     3372       end.
     3373       else do:
     3374           assign
     3375               p-recipe-code = ""
     3376           .
     3377       end.
     3378   end.
     3379   end procedure.
     3380   procedure fbrlib-create-or-update-recipe-gds :
     3381   define input parameter p-recipe-code    as character        no-undo.
     3382   define input parameter p-gds-code       as integer          no-undo.
     3383   define input parameter p-is-waste       as logical          no-undo.
     3384   define input parameter p-qnty           as decimal          no-undo.
     3385   define input parameter p-proc-number    as integer          no-undo.
     3386   define input parameter p-nws-self       as logical          no-undo.
     3387       define variable v-max-proc-num  as integer      no-undo.
     3388       define variable v-recipe-type   as character    no-undo.
     3389       define buffer buf_goods             for ub.goods.
     3390       define buffer buf_recipe-gds        for ub.recipe-gds.
     3391       define buffer buf_recipe            for ub.recipe.
     3392       define buffer buf_proc_recipe-gds   for ub.recipe-gds.
     3393   do
     3394   for buf_goods
     3395     , buf_recipe-gds
     3396     , buf_recipe
     3397     , buf_proc_recipe-gds
     3398   on error undo, return error
     3399   :
     3400       find first buf_recipe no-lock
     3401            where buf_recipe.recipe-code = p-recipe-code
     3402       .
     3403       find first buf_goods no-lock
     3404            where buf_goods.gds-code = p-gds-code
     3405       .
     3406       find first buf_recipe-gds
     3407            where buf_recipe-gds.recipe-code = p-recipe-code
     3408              and buf_recipe-gds.prod-type   = buf_goods.prod-type
     3409              and buf_recipe-gds.prod-code   = buf_goods.prod-code
     3410              and buf_recipe-gds.artic       = buf_goods.artic
     3411       no-error.
     3412       if not available buf_recipe-gds
     3413       then do:
     3414           create buf_recipe-gds.
     3415           assign
     3416               buf_recipe-gds.recipe-code = p-recipe-code
     3417               buf_recipe-gds.gds-code    = p-gds-code
     3418               buf_recipe-gds.prod-type   = buf_goods.prod-type
     3419               buf_recipe-gds.prod-code   = buf_goods.prod-code
     3420               buf_recipe-gds.artic       = buf_goods.artic
     3421           .
     3422           assign
     3423               buf_recipe-gds.is-waste    = no
     3424               buf_recipe-gds.qnty        = 0
     3425               buf_recipe-gds.coeff-waste = 0
     3426               buf_recipe-gds.brutto-qnty = 0
     3427               buf_recipe-gds.proc-number = 0
     3428               buf_recipe-gds.nws-self    = no
     3429           .
     3430       end.
     3431       assign
     3432           buf_recipe-gds.is-waste    = p-is-waste
     3433       .
     3434       run fbrlib-get-recipe-type in this-procedure (
     3435             input "":U
     3436           , input buf_recipe-gds.recipe-code
     3437           , output v-recipe-type
     3438       ).
     3439       if v-recipe-type <> 'производство':U
     3440       then do:
     3441           assign
     3442               buf_recipe-gds.calc-method = 1
     3443               buf_recipe-gds.qnty        = p-qnty
     3444               buf_recipe-gds.brutto-qnty = p-qnty
     3445               buf_recipe-gds.coeff-waste = 0
     3446           .
     3447       end.
     3448       else do:
     3449           assign
     3450               buf_recipe-gds.calc-method = 1
     3451               buf_recipe-gds.brutto-qnty = p-qnty
     3452           .
     3453           run fbrlib-calc-brutto in this-procedure (
     3454                 input v-recipe-type
     3455               , input 0
     3456               , input 0
     3457               , input buf_recipe-gds.coeff-waste
     3458               , input buf_recipe-gds.brutto-qnty
     3459               , input 1
     3460               , output buf_recipe-gds.qnty
     3461               , output buf_recipe-gds.coeff-waste
     3462               , output buf_recipe-gds.brutto-qnty
     3463               , output buf_recipe-gds.calc-method
     3464           ).
     3465       end.
     3466       assign
     3467           buf_recipe-gds.nws-self    = p-nws-self
     3468       .
     3469       if buf_recipe.recipe-type = 'альтернатива':U
     3470       and buf_recipe-gds.proc-number <> 0
     3471       then do:
     3472       end.
     3473       else do:
     3474           if p-proc-number <> 0
     3475           then do:
     3476               assign
     3477                   buf_recipe-gds.proc-number = p-proc-number
     3478               .
     3479           end.
     3480           else do:
     3481               assign
     3482                   v-max-proc-num = 0
     3483               .
     3484               for each buf_proc_recipe-gds no-lock
     3485                  where buf_proc_recipe-gds.recipe-code = p-recipe-code
     3486               :
     3487                   if recid( buf_proc_recipe-gds ) <> recid( buf_recipe-gds )
     3488                   then do:
     3489                       assign
     3490                           v-max-proc-num = ( if v-max-proc-num < buf_proc_recipe-gds.proc-number then buf_proc_recipe-gds.proc-number else v-max-proc-num )
     3491                       .
     3492                   end.
     3493               end.
     3494               assign
     3495                   buf_recipe-gds.proc-number = v-max-proc-num + 1
     3496               .
     3497           end.
     3498       end.
     3499   end.
     3500   end procedure.
     3501   PROCEDURE fbrlib-create-or-update-recipe :
     3502   define input parameter p-mode               as character    no-undo.
     3503   define input parameter p-obj-type           as character    no-undo.
     3504   define input parameter p-obj-code           as integer      no-undo.
     3505   define input parameter p-recipe-code        as character    no-undo.
     3506   define input parameter p-recipe-type        as character    no-undo.
     3507   define input parameter p-gds-code           as integer      no-undo.
     3508   define input parameter p-name               as character    no-undo.
     3509   define input parameter p-design             as character    no-undo.
     3510   define input parameter p-order              as integer      no-undo.
     3511   define input parameter p-quality            as character    no-undo.
     3512   define input parameter p-ref-num            as character    no-undo.
     3513   define input parameter p-technique          as character    no-undo.
     3514   define input parameter p-template           as character    no-undo.
     3515   define input parameter p-qnty               as decimal      no-undo.
     3516   define input parameter p-portion-qnty       as integer      no-undo.
     3517   define input parameter p-portion-weight     as decimal      no-undo.
     3518   define output parameter p-new-recipe-code   as character    no-undo.
     3519       define variable v-host-code         as integer      no-undo.
     3520       define variable v-fbr-gds-obj-recid as recid        no-undo.
     3521       define buffer buf_recipe    for ub.recipe.
     3522       define buffer buf_goods     for ub.goods.
     3523   do
     3524   for buf_recipe
     3525     , buf_goods
     3526   on error undo, return error
     3527   :
     3528       if p-mode <> 'ДОБАВЛЕНИЕ':U
     3529       and p-mode <> 'ИЗМЕНЕНИЕ':U
     3530       then do:
     3531           message
     3532               skip "Ошибка задания типа операции для создания или измения рецепта."
     3533               skip (1)
     3534               skip "Задан тип операции:" p-mode
     3535           view-as alert-box error.
     3536           undo, return error .
     3537       end.
     3538       if p-recipe-code = ""
     3539       then do:
     3540   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3541   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3542     (input  p-obj-type
     3543     ,input  p-obj-code
     3544     ,output v-host-code
     3545     )  .
     3546           find first buf_goods no-lock
     3547                where buf_goods.gds-code = p-gds-code
     3548           .
     3549           create buf_recipe .
     3550           run fbrcode-gen-recipe-code in this-procedure (
     3551                 input p-obj-type
     3552               , input p-obj-code
     3553               , output buf_recipe.recipe-code
     3554           ).
     3555           assign
     3556               buf_recipe.artic               = buf_goods.artic
     3557               buf_recipe.prod-type           = buf_goods.prod-type
     3558               buf_recipe.prod-code           = buf_goods.prod-code
     3559               buf_recipe.recipe-type         = p-recipe-type
     3560               buf_recipe.recipe-name         = ( if p-name = "" then buf_goods.gds-name else p-name )
     3561               buf_recipe.gds-code            = p-gds-code
     3562               buf_recipe.host-code           = v-host-code
     3563               buf_recipe.obj-type            = p-obj-type
     3564               buf_recipe.obj-code            = p-obj-code
     3565               buf_recipe.recipe-design       = ""
     3566               buf_recipe.recipe-order        = 0
     3567               buf_recipe.recipe-quality      = ""
     3568               buf_recipe.recipe-ref-num      = ""
     3569               buf_recipe.recipe-technique    = ""
     3570               buf_recipe.recipe-template     = ""
     3571               buf_recipe.qnty                = 1.0
     3572               buf_recipe.portion-qnty        = 1
     3573               buf_recipe.portion-weight      = 0
     3574           .
     3575       end.
     3576       if p-name <> ""
     3577       then do:
     3578           assign
     3579               buf_recipe.recipe-name = p-name
     3580           .
     3581       end.
     3582       assign
     3583           buf_recipe.recipe-design       = p-design
     3584           buf_recipe.recipe-order        = p-order
     3585           buf_recipe.recipe-quality      = p-quality
     3586           buf_recipe.recipe-ref-num      = p-ref-num
     3587           buf_recipe.recipe-technique    = p-technique
     3588           buf_recipe.recipe-template     = p-template
     3589           buf_recipe.qnty                = p-qnty
     3590           buf_recipe.portion-qnty        = p-portion-qnty
     3591           buf_recipe.portion-weight      = p-portion-weight
     3592       .
     3593       assign
     3594           p-new-recipe-code = buf_recipe.recipe-code
     3595       .
     3596       run fbrlib-set-default-recipe in this-procedure (
     3597             input p-obj-type
     3598           , input p-obj-code
     3599           , input buf_goods.gds-code
     3600       ).
     3601   end.
     3602   END PROCEDURE.
     3603   PROCEDURE fbrlib-delete-fact-fbr-doc :
     3604   define input parameter parparentproc-handle as widget-handle no-undo .
     3605   define input parameter p-doc-code   as character no-undo.
     3606   define input parameter p-chip-num   like ub.c-trn-doc.chip-num no-undo .
     3607       define variable v-shift-on      as logical      no-undo.
     3608       define variable v-shift-date    as date         no-undo.
     3609       define variable v-shift-num     as integer      no-undo.
     3610       define variable v-shift-name    as character    no-undo.
     3611       define variable v-obj-date      as date         no-undo.
     3612       define variable v-chip-num      as integer      no-undo.
     3613       define buffer buf_fbr-doc       for ub.fbr-doc.
     3614       define buffer buf_fbr-line      for ub.fbr-line.
     3615       define buffer buf_c-fbr-doc     for ub.c-fbr-doc.
     3616       define buffer buf_fbr-recipe     for ub.fbr-recipe.
     3617       define buffer buf_fbr-recipe-gds for ub.fbr-recipe-gds.
     3618       define buffer buf_marking-lines for ub.marking-lines .
     3619       define buffer buf_marking       for ub.marking .
     3620       define buffer buf_goods         for ub.goods .
     3621   do
     3622   for buf_fbr-doc
     3623     , buf_fbr-line
     3624     , buf_c-fbr-doc
     3625     , buf_fbr-recipe
     3626     , buf_fbr-recipe-gds
     3627     , buf_goods
     3628     , buf_marking
     3629     , buf_marking-lines
     3630   on error undo, return error
     3631   :
     3632   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3633     define variable v-cntxt-db-num        as integer   no-undo .
     3634     define variable v-cntxt-userid        as character no-undo .
     3635     define variable v-cntxt-level         as character no-undo .
     3636     define variable v-cntxt-host-code-obj as integer   no-undo .
     3637     define variable v-cntxt-obj-type      as character no-undo .
     3638     define variable v-cntxt-obj-code      as integer   no-undo .
     3639     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3640     define variable v-cntxt-is-admin      as logical   no-undo .
     3641   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3642     run mainmenu_getcntxt in parparentproc-handle
     3643       (output v-cntxt-db-num
     3644       ,output v-cntxt-userid
     3645       ,output v-cntxt-level
     3646       ,output v-cntxt-host-code-obj
     3647       ,output v-cntxt-obj-type
     3648       ,output v-cntxt-obj-code
     3649       ,output v-cntxt-db-num-obj
     3650       ,output v-cntxt-is-admin
     3651       ) .
     3652       if search ("delfbr.err") <> ?
     3653       then do:
     3654           os-delete "delfbr.err".
     3655       end.
     3656     _del-block:
     3657       do transaction
     3658     on error undo _del-block, return error return-value
     3659     on endkey undo _del-block , return error return-value
     3660     on stop undo _del-block , return error return-value
     3661       :
     3662           find first buf_fbr-doc exclusive-lock
     3663                where buf_fbr-doc.doc-code = p-doc-code
     3664           no-error.
     3665           if not available buf_fbr-doc
     3666           then do:
     3667         undo _del-block, return error substitute("&1 &2 &3&4Не найден документ производства &5 для удаления."
     3668                                           ,vss-workfile
     3669                                           ,vss-revision
     3670                                           ,vss-description
     3671                                           ,chr(10)
     3672                                           , p-doc-code).
     3673           end.
     3674           run fbrlib-delete-fact-trn-doc in this-procedure (
     3675               input parparentproc-handle
     3676              ,input p-doc-code
     3677              ,input 'при':U
     3678              ,input p-chip-num
     3679              ,output v-chip-num
     3680           ) no-error.
     3681           if error-status :error
     3682           then do:
     3683               run fbrlib-print-del-error-message in this-procedure .
     3684         undo _del-block, return error.
     3685           end.
     3686           assign
     3687           p-chip-num = (if p-chip-num = ?
     3688                         then v-chip-num
     3689                         else p-chip-num).
     3690           run fbrlib-delete-fact-trn-doc in this-procedure (
     3691               input parparentproc-handle
     3692              ,input p-doc-code
     3693              ,input 'рас':U
     3694              ,input p-chip-num
     3695              ,output v-chip-num
     3696           ) no-error.
     3697           if error-status :error
     3698           then do:
     3699               run fbrlib-print-del-error-message in this-procedure .
     3700         undo _del-block, return error.
     3701           end.
     3702           run fbrlib-delete-fact-trn-doc in this-procedure (
     3703               input parparentproc-handle
     3704              ,input p-doc-code
     3705              ,input 'спи':U
     3706              ,input p-chip-num
     3707              ,output v-chip-num
     3708           ) no-error.
     3709           if error-status :error
     3710           then do:
     3711               run fbrlib-print-del-error-message in this-procedure .
     3712         undo _del-block, return error.
     3713           end.
     3714           create buf_c-fbr-doc.
     3715           buffer-copy buf_fbr-doc to buf_c-fbr-doc.
     3716   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3717   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     3718     (input  buf_fbr-doc.obj-type
     3719     ,input  buf_fbr-doc.obj-code
     3720     ,output v-obj-date
     3721     ) no-error .
     3722           if error-status :error
     3723           or v-obj-date = ?
     3724           then do:
     3725         undo _del-block, return error "Нет текущей даты на объекте документа.".
     3726           end.
     3727   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3728   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     3729     (input  buf_fbr-doc.obj-type
     3730     ,input  buf_fbr-doc.obj-code
     3731     ,input  'shift-on=request'
     3732     ,output v-shift-on
     3733     )  .
     3734           if v-shift-on
     3735           then do:
     3736   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3737   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     3738     (input  buf_fbr-doc.obj-type
     3739     ,input  buf_fbr-doc.obj-code
     3740     ,output v-shift-date
     3741     ,output v-shift-num
     3742     ,output v-shift-name
     3743     ) no-error .
     3744               if error-status :error
     3745               then do:
     3746           undo _del-block, return error "Ошибка при поиске текущей смены на объекте".
     3747               end.
     3748           end.
     3749           else do:
     3750               assign
     3751                   v-shift-date = ?
     3752                   v-shift-num  = ?
     3753                   v-shift-name = ?
     3754               .
     3755           end.
     3756           define variable v-today       as date         no-undo.
     3757           define variable v-time        as integer      no-undo.
     3758           run cur-time in this-procedure (
     3759                 output v-today
     3760               , output v-time
     3761           ).
     3762           assign
     3763               buf_c-fbr-doc.chip-num         = (if p-chip-num <> ? then p-chip-num else next-value( s-corr-chip, ub  ))
     3764               buf_c-fbr-doc.corr-user-name   = v-cntxt-userid
     3765               buf_c-fbr-doc.corr-user-db-num = v-cntxt-db-num
     3766               buf_c-fbr-doc.corr-date        = v-today
     3767               buf_c-fbr-doc.corr-time        = v-time
     3768               buf_c-fbr-doc.corr-shift-date  = v-shift-date
     3769               buf_c-fbr-doc.corr-shift-num   = v-shift-num
     3770               buf_c-fbr-doc.corr-shift-name  = v-shift-name
     3771               buf_c-fbr-doc.is-del           = yes
     3772           .
     3773           assign
     3774               buf_fbr-doc.is-del = yes
     3775           .
     3776           for each buf_fbr-line exclusive-lock
     3777              where buf_fbr-line.doc-code = p-doc-code
     3778       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3779       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     3780       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     3781           :
     3782               for first buf_goods no-lock where buf_goods.artic      = buf_fbr-line.artic
     3783                                             and buf_goods.prod-type  = buf_fbr-line.prod-type
     3784                                             and buf_goods.prod-code  = buf_fbr-line.prod-code,
     3785               each buf_marking-lines exclusive-lock where buf_marking-lines.gds-code = buf_goods.gds-code
     3786                                                       and buf_marking-lines.obj-type = buf_fbr-doc.obj-type
     3787                                                       and buf_marking-lines.obj-code = buf_fbr-doc.obj-code
     3788                                                       and buf_marking-lines.in-code  = "manufacturing"
     3789                                                       and buf_marking-lines.out-code = buf_fbr-line.doc-code
     3790                                                       and buf_marking-lines.part-code = buf_fbr-line.recipe-code
     3791                                                       and buf_marking-lines.prt-code = 0
     3792               :
     3793                 for first buf_marking exclusive-lock where buf_marking.mark begins buf_marking-lines.mark :
     3794                   assign
     3795                     buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UsedInProduction:KeyIntDB when buf_fbr-line.is-comp
     3796                   .
     3797                 end .
     3798                 delete buf_marking-lines.
     3799               end .
     3800               delete buf_fbr-line.
     3801           end.
     3802           for each buf_fbr-recipe exclusive-lock
     3803              where buf_fbr-recipe.doc-code = p-doc-code
     3804       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3805       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     3806       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     3807           :
     3808               delete buf_fbr-recipe.
     3809           end.
     3810           for each buf_fbr-recipe-gds exclusive-lock
     3811              where buf_fbr-recipe-gds.doc-code = p-doc-code
     3812       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3813       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     3814       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     3815           :
     3816               delete buf_fbr-recipe-gds.
     3817           end.
     3818           delete buf_fbr-doc.
     3819       end.
     3820   end.
     3821   END PROCEDURE.
     3822   PROCEDURE fbrlib-del-trn-doc :
     3823   do
     3824   on error undo, return error
     3825   :
     3826   define input parameter parparentproc        as widget-handle no-undo .
     3827   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     3828   define input parameter p-trn-doc-type       as character    no-undo.
     3829   define input parameter p-phchip-num         like ub.c-trn-doc.chip-num no-undo .
     3830   define output parameter p-chip-num           like ub.c-trn-doc.chip-num no-undo .
     3831       define variable v-trn-doc-doc-code  as character     no-undo.
     3832       define buffer buf_trn-doc       for ub.trn-doc.
     3833   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3834     define variable v-cntxt-db-num        as integer   no-undo .
     3835     define variable v-cntxt-userid        as character no-undo .
     3836     define variable v-cntxt-level         as character no-undo .
     3837     define variable v-cntxt-host-code-obj as integer   no-undo .
     3838     define variable v-cntxt-obj-type      as character no-undo .
     3839     define variable v-cntxt-obj-code      as integer   no-undo .
     3840     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3841     define variable v-cntxt-is-admin      as logical   no-undo .
     3842   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3843     run mainmenu_getcntxt in parparentproc
     3844       (output v-cntxt-db-num
     3845       ,output v-cntxt-userid
     3846       ,output v-cntxt-level
     3847       ,output v-cntxt-host-code-obj
     3848       ,output v-cntxt-obj-type
     3849       ,output v-cntxt-obj-code
     3850       ,output v-cntxt-db-num-obj
     3851       ,output v-cntxt-is-admin
     3852       ) .
     3853       run fbrcode-trn-doc in this-procedure (
     3854             input 'производство':U
     3855           , input p-fbr-doc-doc-code
     3856           , input p-trn-doc-type
     3857           , output v-trn-doc-doc-code
     3858       ).
     3859       find first buf_trn-doc no-lock
     3860            where buf_trn-doc.doc-code = v-trn-doc-doc-code
     3861       no-error.
     3862       if available buf_trn-doc
     3863       then do:
     3864           run str/del-doc.p (
     3865                 input parparentproc
     3866               , input buf_trn-doc.doc-code
     3867               , input v-cntxt-db-num
     3868               , input "del-doc.err"
     3869               , input ?
     3870               , input p-fbr-doc-doc-code
     3871               , input v-cntxt-userid
     3872               , input 0
     3873               , input p-phchip-num
     3874               , output p-chip-num
     3875           ) no-error.
     3876           if error-status :error
     3877           then do:
     3878             undo, return error substitute("Не удалось удалить складской документ &1, созданный по документу производства &2.&3&4&3&5"
     3879                                           ,v-trn-doc-doc-code
     3880                                           ,p-fbr-doc-doc-code
     3881                                           , chr(10)
     3882                                           , error-status:get-message(1)
     3883                                           , return-value ).
     3884           end.
     3885       end.
     3886   end.
     3887   END PROCEDURE.
     3888   PROCEDURE fbrlib-delete-fact-trn-doc :
     3889   define input parameter parparentproc    as widget-handle    no-undo.
     3890   define input parameter p-fbr-doc-code   as character        no-undo.
     3891   define input parameter p-doc-type       as character    no-undo.
     3892   define input parameter p-ph-chip-num       like ub.c-trn-doc.chip-num no-undo .
     3893   define output parameter p-chip-num      like ub.c-trn-doc.chip-num no-undo .
     3894       define variable v-doc-code          as character        no-undo.
     3895       define variable v-ext-doc-type      as character        no-undo.
     3896       define variable v-trn-doc-recid     as recid            no-undo.
     3897       define variable varchip-code        as integer          no-undo.
     3898       define variable varchip-code2       as integer          no-undo.
     3899       define variable v-chip-counter      as integer          no-undo.
     3900       define buffer buf_trn-doc       for ub.trn-doc.
     3901       define buffer buf_pri_trn-doc   for ub.trn-doc.
     3902       define buffer buf_cons_trn-doc  for ub.trn-doc.
     3903   do
     3904   for buf_trn-doc
     3905     , buf_pri_trn-doc
     3906     , buf_cons_trn-doc
     3907   on error undo, return error
     3908   :
     3909   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3910     define variable v-cntxt-db-num        as integer   no-undo .
     3911     define variable v-cntxt-userid        as character no-undo .
     3912     define variable v-cntxt-level         as character no-undo .
     3913     define variable v-cntxt-host-code-obj as integer   no-undo .
     3914     define variable v-cntxt-obj-type      as character no-undo .
     3915     define variable v-cntxt-obj-code      as integer   no-undo .
     3916     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3917     define variable v-cntxt-is-admin      as logical   no-undo .
     3918   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3919     run mainmenu_getcntxt in parparentproc
     3920       (output v-cntxt-db-num
     3921       ,output v-cntxt-userid
     3922       ,output v-cntxt-level
     3923       ,output v-cntxt-host-code-obj
     3924       ,output v-cntxt-obj-type
     3925       ,output v-cntxt-obj-code
     3926       ,output v-cntxt-db-num-obj
     3927       ,output v-cntxt-is-admin
     3928       ) .
     3929       run fbrcode-trn-doc in this-procedure (
     3930             input 'производство':U
     3931           , input p-fbr-doc-code
     3932           , input p-doc-type
     3933           , output v-doc-code
     3934       ).
     3935       find first buf_trn-doc no-lock
     3936            where buf_trn-doc.doc-code = v-doc-code
     3937       no-error.
     3938       if not available buf_trn-doc
     3939       then do:
     3940           if p-doc-type <> 'спи':U
     3941           then do:
     3942               message
     3943                   "Не найден документ '" p-doc-type "'"
     3944                   "по документу производства " p-fbr-doc-code
     3945               view-as alert-box.
     3946               undo, return error.
     3947           end.
     3948           else do:
     3949           end.
     3950       end.
     3951       else do:
     3952           assign
     3953               v-trn-doc-recid = recid( buf_trn-doc )
     3954               v-ext-doc-type  = buf_trn-doc.ext-doc-type
     3955           .
     3956           if v-ext-doc-type = 'ev':U
     3957           then do:
     3958               find first buf_pri_trn-doc no-lock
     3959                    where buf_pri_trn-doc.out-code     = v-doc-code
     3960                      and buf_pri_trn-doc.ext-doc-type = 'iv':U
     3961               no-error.
     3962               if available buf_pri_trn-doc
     3963               then do:
     3964                   run str/del-doc.p (
     3965                         input parparentproc
     3966                       , input buf_pri_trn-doc.doc-code
     3967                       , input v-cntxt-db-num
     3968                       , input "delfbr.err"
     3969                       , input ?
     3970                       , input p-fbr-doc-code
     3971                       , input v-cntxt-userid
     3972                       , input 0
     3973                       , input (if p-ph-chip-num <> ?
     3974                               then p-ph-chip-num
     3975                               else (if varchip-code <> 0
     3976                                   then varchip-code
     3977                                   else ?)
     3978                               )
     3979                       , output varchip-code2
     3980                   ) no-error.
     3981                   if error-status :error
     3982                   then do:
     3983                     undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     3984                                                   ,buf_pri_trn-doc.doc-code
     3985                                                   ,p-fbr-doc-code
     3986                                                   , chr(10)
     3987                                                   , error-status:get-message(1)
     3988                                                   , return-value ).
     3989                   end.
     3990               end.
     3991           end.
     3992           define buffer buf_out_trn-doc       for ub.trn-doc.
     3993           if p-doc-type = 'при':U
     3994           then do:
     3995               assign
     3996                   v-chip-counter = 0
     3997               .
     3998               for each buf_out_trn-doc exclusive-lock
     3999                  where buf_out_trn-doc.out-code = buf_trn-doc.doc-code
     4000               on error undo, return error
     4001               :
     4002                   assign
     4003                       v-chip-counter = v-chip-counter + 1
     4004                   .
     4005                   if v-chip-counter > 1
     4006                   then do:
     4007                       assign
     4008                           varchip-code = varchip-code2
     4009                       .
     4010                   end.
     4011                   run str/del-doc.p (
     4012                         input parparentproc
     4013                       , input buf_out_trn-doc.doc-code
     4014                       , input v-cntxt-db-num
     4015                       , input "delfbr.err"
     4016                       , input ?
     4017                       , input p-fbr-doc-code
     4018                       , input v-cntxt-userid
     4019                       , input 0
     4020                       , input (if p-ph-chip-num <> ?
     4021                               then p-ph-chip-num
     4022                               else (if varchip-code <> 0
     4023                                   then varchip-code
     4024                                   else ?)
     4025                               )
     4026                       , output varchip-code2
     4027                   ) no-error.
     4028                   if error-status :error
     4029                   then do:
     4030                     undo, return error substitute("Ошибка при удалении складского документа &1, связанного со складским документов прихода &2, созданный по документу производства &3.&4&5&4&6"
     4031                                                   ,buf_out_trn-doc.doc-code
     4032                                                   ,buf_trn-doc.doc-code
     4033                                                   ,p-fbr-doc-code
     4034                                                   , chr(10)
     4035                                                   , error-status:get-message(1)
     4036                                                   , return-value ).
     4037                   end.
     4038               end.
     4039           end.
     4040           run str/del-doc.p (
     4041                 input parparentproc
     4042               , input buf_trn-doc.doc-code
     4043               , input v-cntxt-db-num
     4044               , input "delfbr.err"
     4045               , input ?
     4046               , input p-fbr-doc-code
     4047               , input v-cntxt-userid
     4048               , input 0
     4049               , input (if p-ph-chip-num <> ?
     4050                        then p-ph-chip-num
     4051                        else (if varchip-code <> 0
     4052                              then varchip-code
     4053                              else ?)
     4054                        )
     4055               , output varchip-code2
     4056           ) no-error.
     4057           if error-status :error
     4058           then do:
     4059               undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     4060                                             ,buf_trn-doc.doc-code
     4061                                             ,p-fbr-doc-code
     4062                                             , chr(10)
     4063                                             , error-status:get-message(1)
     4064                                             , return-value ).
     4065           end.
     4066           if p-doc-type = 'рас':U
     4067           or p-doc-type = 'спи':U
     4068           then do:
     4069               assign
     4070                   v-chip-counter = 0
     4071               .
     4072               for each buf_cons_trn-doc no-lock
     4073                  where buf_cons_trn-doc.out-code      = v-doc-code
     4074                    and buf_cons_trn-doc.ext-doc-type  = 'pc':U
     4075               :
     4076                   assign
     4077                       v-trn-doc-recid = recid( buf_cons_trn-doc )
     4078                       v-chip-counter = v-chip-counter + 1
     4079                   .
     4080                   assign
     4081                   varchip-code = if v-chip-counter = 2
     4082                                  then varchip-code2
     4083                                  else varchip-code.
     4084                   run str/del-doc.p (
     4085                         input parparentproc
     4086                       , input buf_cons_trn-doc.doc-code
     4087                       , input v-cntxt-db-num
     4088                       , input "delfbr.err"
     4089                       , input ?
     4090                       , input ?
     4091                       , input v-cntxt-userid
     4092                       , input 0
     4093                       , input (if p-ph-chip-num <> ?
     4094                                then p-ph-chip-num
     4095                                else ( if v-chip-counter = 1
     4096                                       then ?
     4097                                       else varchip-code )
     4098                                )
     4099                       , output varchip-code2
     4100                   ) no-error.
     4101                   if error-status :error
     4102                   then do:
     4103                       undo, return error substitute("Ошибка при удалении складского документа смены типа приобретения &1, созданный по документу производства &2.&3&4&3&5"
     4104                                                     ,buf_cons_trn-doc.doc-code
     4105                                                     ,p-fbr-doc-code
     4106                                                     , chr(10)
     4107                                                     , error-status:get-message(1)
     4108                                                     , return-value ).
     4109                   end.
     4110                   assign
     4111                       p-chip-num = varchip-code2
     4112                   .
     4113               end.
     4114           end.
     4115           assign
     4116               p-chip-num = varchip-code2
     4117           .
     4118       end.
     4119   end.
     4120   END PROCEDURE.
     4121   PROCEDURE fbrlib-print-del-error-message :
     4122   do
     4123   on error undo, return error
     4124   :
     4125       define variable v-user-action   as character    no-undo.
     4126       define variable v-printed       as logical      no-undo.
     4127       message
     4128           vss-workfile vss-revision vss-description
     4129           skip "Ошибка при удалении документа."
     4130           skip return-value
     4131           skip trim(error-status :get-message(1))
     4132           skip trim(error-status :get-message(2))
     4133           skip trim(error-status :get-message(3))
     4134       view-as alert-box error.
     4135       if search ("delfbr.err") <> ?
     4136       then do:
     4137         run gbl/prnfilen.w
     4138           (input  "Ошибки при удалении документа производства"
     4139           ,input  0
     4140           ,input  "delfbr.err"
     4141           ,input  7
     4142           ,output v-user-action
     4143           ,output v-printed
     4144           ).
     4145       end.
     4146   end.
     4147   END PROCEDURE.
     4148   procedure fbrlib-calc-brutto :
     4149   define input parameter p-recipe-type        as character        no-undo.
     4150   define input parameter p-netto              as decimal          no-undo.
     4151   define input parameter p-coeff-value        as decimal          no-undo.
     4152   define input parameter p-coeff-waste        as decimal          no-undo.
     4153   define input parameter p-brutto             as decimal          no-undo.
     4154   define input parameter p-calc-method        as integer          no-undo.
     4155   define output parameter p-new-netto         as decimal          no-undo.
     4156   define output parameter p-new-coeff-waste   as decimal          no-undo.
     4157   define output parameter p-new-brutto        as decimal          no-undo.
     4158   define output parameter p-new-calc-method   as integer          no-undo.
     4159   do
     4160   on error undo, return error
     4161   :
     4162       if p-recipe-type <> 'производство':U
     4163       then do:
     4164           assign
     4165               p-new-coeff-waste = 0
     4166               p-new-calc-method = 1
     4167               p-new-netto       = ( if p-calc-method = 1 then p-brutto else p-netto )
     4168               p-new-brutto      = ( if p-calc-method = 1 then p-brutto else p-netto )
     4169           .
     4170       end.
     4171       else do:
     4172           assign
     4173               p-new-calc-method = p-calc-method
     4174           .
     4175           if p-coeff-waste = 0
     4176           then do:
     4177               assign
     4178                   p-coeff-value = 0
     4179               .
     4180           end.
     4181           case p-calc-method
     4182           :
     4183               when 1
     4184               then do:
     4185                   assign
     4186                       p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     4187                       p-new-coeff-waste   = p-coeff-waste
     4188                       p-new-brutto        = p-brutto
     4189                   .
     4190               end.
     4191               when 2
     4192               then do:
     4193                   assign
     4194                       p-new-netto         = p-netto
     4195                       p-new-coeff-waste   = 100 - p-coeff-value - ( 100 * p-netto / p-brutto )
     4196                       p-new-brutto        = p-brutto
     4197                   .
     4198               end.
     4199               when 3
     4200               then do:
     4201                   assign
     4202                       p-new-netto         = p-netto
     4203                       p-new-coeff-waste   = p-coeff-waste
     4204                       p-new-brutto        = 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste )
     4205                   .
     4206               end.
     4207               otherwise do:
     4208                   define variable v-yesno    as logical      no-undo.
     4209                   assign
     4210                       v-yesno = yes
     4211                   .
     4212                   message
     4213                       "Неверный метод для расчета брутто, нетто и процента потерь."
     4214                       skip "Значение метода должно быть 1, 2 или 3."
     4215                       skip(1)
     4216                       skip "Заданное значение:" p-calc-method
     4217                       skip(1)
     4218                       skip "Установить значение метода расчета 1"
     4219                       skip "(расчет нетто по брутто и проценту потерь)?"
     4220                   view-as alert-box warning
     4221                   buttons yes-no
     4222                   title "Неверное значение метода пересчета в строках документа-производства"
     4223                   update v-yesno
     4224                   .
     4225                   if v-yesno = yes
     4226                   then do:
     4227                       assign
     4228                           p-new-calc-method   = 1
     4229                           p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     4230                           p-new-coeff-waste   = p-coeff-waste
     4231                           p-new-brutto        = p-brutto
     4232                       .
     4233                   end.
     4234                   else do:
     4235                       message
     4236                               vss-workfile vss-revision vss-description
     4237                           skip(1)
     4238                           skip "Ошибка расчета брутто, нетто и процента потерь."
     4239                           skip return-value
     4240                           skip trim(error-status :get-message(1))
     4241                               trim(error-status :get-message(2))
     4242                               trim(error-status :get-message(3))
     4243                       view-as alert-box error
     4244                       title "Неверное значение метода расчета"
     4245                       .
     4246                       undo, return error .
     4247                   end.
     4248               end.
     4249           end case.
     4250       end.
     4251   end.
     4252   end procedure.
     4253   procedure fbrlib-check-brutto :
     4254   define input parameter p-recipe-type        as character        no-undo.
     4255   define input parameter p-netto              as decimal          no-undo.
     4256   define input parameter p-coeff-value        as decimal          no-undo.
     4257   define input parameter p-coeff-waste        as decimal          no-undo.
     4258   define input parameter p-brutto             as decimal          no-undo.
     4259   define input parameter p-calc-method        as integer          no-undo.
     4260   define output parameter p-error-message     as character        no-undo.
     4261   define output parameter p-not-good          as logical          no-undo.
     4262   do
     4263   on error undo, return error
     4264   :
     4265       if p-recipe-type <> 'производство':U
     4266       then do:
     4267           if p-netto <> p-brutto
     4268           or p-coeff-waste <> 0
     4269           then do:
     4270               assign
     4271                   p-not-good      = yes
     4272                   p-error-message = substitute( "Во всех рецептах кроме рецепта производства должно выполняться:&1брутто = нетто и процент потерь = 0.&1&1Тип рецепта: &2&1Брутто: &3&1Нетто: &4&1Процент потерь: &5"
     4273                                           , chr(10), p-recipe-type, p-brutto, p-netto, p-coeff-waste )
     4274               .
     4275           end.
     4276       end.
     4277       else do:
     4278           if p-coeff-waste = 0
     4279           then do:
     4280               assign
     4281                   p-coeff-value = 0
     4282               .
     4283           end.
     4284           case p-calc-method
     4285           :
     4286               when 1
     4287               then do:
     4288                   if round( p-netto, 9 ) <> round( p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100, 9 )
     4289                   then do:
     4290                       assign
     4291                           p-not-good      = yes
     4292                           p-error-message = substitute( "Ошибка расчета нетто ( &2 ) &1 по брутто ( &3 ) &1 и процентам потерь ( &4, &5 )."
     4293                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     4294                       .
     4295                   end.
     4296               end.
     4297               when 2
     4298               then do:
     4299                   if round( p-coeff-waste, 9 ) <> round( 100 - p-coeff-value - ( 100 * p-netto / p-brutto ), 9 )
     4300                   then do:
     4301                       assign
     4302                           p-not-good      = yes
     4303                           p-error-message =  substitute( "Ошибка расчета процента потерь ( &2 ) &1 по нетто ( &3 ) &1 брутто ( &4 ) &1 и cезонному проценту ( &5 )."
     4304                                                   , chr(10), p-coeff-waste, p-netto, p-brutto, p-coeff-value )
     4305                       .
     4306                   end.
     4307               end.
     4308               when 3
     4309               then do:
     4310                   if round( p-brutto, 9 ) <> round( 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste ), 9 )
     4311                   then do:
     4312                       assign
     4313                           p-not-good      = yes
     4314                           p-error-message = substitute( "Ошибка расчета брутто ( &3 ) &1 по нетто ( &2 ) &1 и процентам потерь ( &4, &5 )."
     4315                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     4316                       .
     4317                   end.
     4318               end.
     4319               otherwise do:
     4320                   assign
     4321                       p-not-good      = yes
     4322                       p-error-message = substitute( "Ошибка ввода метода расчета ( &1 ).", p-calc-method )
     4323                   .
     4324               end.
     4325           end case.
     4326       end.
     4327   end.
     4328   end procedure.
     4329   procedure fbrlib-check-fbr-recipe :
     4330   define input parameter p-doc-code       as character        no-undo.
     4331   define input parameter p-recipe-code    as character        no-undo.
     4332   define output parameter p-is-correct    as logical          no-undo.
     4333       define variable v-comp-factor    as decimal      no-undo.
     4334       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     4335       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     4336       define buffer buf_fbr-line          for ub.fbr-line.
     4337   do
     4338   for buf_fbr-recipe
     4339     , buf_fbr-recipe-gds
     4340     , buf_fbr-line
     4341   on error undo, return error
     4342   :
     4343       assign
     4344           p-is-correct = yes
     4345       .
     4346       find first buf_fbr-recipe no-lock
     4347            where buf_fbr-recipe.doc-code    = p-doc-code
     4348              and buf_fbr-recipe.recipe-code = p-recipe-code no-error
     4349       .
     4350       if not available buf_fbr-recipe then do:
     4351         undo, return error substitute("Не найден рецепт (fbr-recipe) с кодом &1 для  документа пр-ва &2", p-recipe-code, p-doc-code).
     4352       end.
     4353       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     4354       then do:
     4355       end.
     4356       else do:
     4357           find first buf_fbr-line no-lock
     4358                where buf_fbr-line.doc-code    = buf_fbr-recipe.doc-code
     4359                  and buf_fbr-line.is-comp     = yes
     4360                  and buf_fbr-line.recipe-code = buf_fbr-recipe.recipe-code
     4361                  and buf_fbr-line.artic       = buf_fbr-recipe.artic
     4362                  and buf_fbr-line.prod-type   = buf_fbr-recipe.prod-type
     4363                  and buf_fbr-line.prod-code   = buf_fbr-recipe.prod-code
     4364           .
     4365           assign
     4366               v-comp-factor = buf_fbr-line.fact-qnty / buf_fbr-recipe.qnty
     4367           .
     4368           recipe-line-cycle:
     4369           for each buf_fbr-recipe-gds no-lock
     4370              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     4371                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     4372           on error undo, return error
     4373           :
     4374               find first buf_fbr-line no-lock
     4375                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     4376                      and buf_fbr-line.is-comp     = no
     4377                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     4378                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4379                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4380                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4381               .
     4382               if absolute( buf_fbr-line.fact-qnty / buf_fbr-recipe-gds.brutto-qnty - v-comp-factor ) > 0.000000001
     4383               then do:
     4384                   assign
     4385                       p-is-correct = no
     4386                   .
     4387                   leave recipe-line-cycle.
     4388               end.
     4389           end.
     4390       end.
     4391   end.
     4392   end procedure.
     4393   procedure fbrlib-get-recipe-type :
     4394   define input parameter p-fbr-doc-code   as character        no-undo.
     4395   define input parameter p-recipe-code    as character        no-undo.
     4396   define output parameter p-recipe-type   as character        no-undo.
     4397       define buffer buf_recipe        for ub.recipe.
     4398       define buffer buf_fbr-recipe    for ub.fbr-recipe.
     4399   do
     4400   for buf_recipe
     4401     , buf_fbr-recipe
     4402   on error undo, return error
     4403   :
     4404       if p-fbr-doc-code = ""
     4405       then do:
     4406           find first buf_recipe no-lock
     4407                where buf_recipe.recipe-code = p-recipe-code
     4408           no-error.
     4409           if available buf_recipe
     4410           then do:
     4411               assign
     4412                   p-recipe-type = buf_recipe.recipe-type
     4413               .
     4414           end.
     4415           else do:
     4416               assign
     4417                   p-recipe-type = "":U
     4418               .
     4419           end.
     4420       end.
     4421       else do:
     4422           find first buf_fbr-recipe no-lock
     4423                where buf_fbr-recipe.doc-code      = p-fbr-doc-code
     4424                  and buf_fbr-recipe.recipe-code   = p-recipe-code
     4425           no-error.
     4426           if available buf_fbr-recipe
     4427           then do:
     4428               assign
     4429                   p-recipe-type = buf_fbr-recipe.recipe-type
     4430               .
     4431           end.
     4432           else do:
     4433               assign
     4434                   p-recipe-type = "":U
     4435               .
     4436           end.
     4437       end.
     4438   end.
     4439   end procedure.
     4440   PROCEDURE calc-comp-from-ingr :
     4441   define input parameter p-fbr-v-fbr-doc-line-recid           as recid        no-undo.
     4442   define input parameter p-fact-qnty                          as decimal      no-undo.
     4443   define output parameter p-comp-fbr-v-fbr-doc-line-recid     as recid        no-undo.
     4444   define output parameter p-comp-qnty                         as decimal      no-undo.
     4445       define variable v-ingr-qnty     as decimal       no-undo.
     4446       define buffer buf_i_fbr-line    for ub.fbr-line.
     4447       define buffer buf_fbr-line      for ub.fbr-line.
     4448       define buffer buf_recipe        for ub.fbr-recipe.
     4449       define buffer buf_recipe-gds    for ub.fbr-recipe-gds.
     4450   do
     4451   for buf_i_fbr-line
     4452     , buf_fbr-line
     4453     , buf_recipe
     4454     , buf_recipe-gds
     4455   on error undo, return error
     4456   :
     4457       find first buf_i_fbr-line no-lock
     4458            where recid( buf_i_fbr-line ) = p-fbr-v-fbr-doc-line-recid
     4459       .
     4460       find first buf_recipe no-lock
     4461            where buf_recipe.doc-code      = buf_i_fbr-line.doc-code
     4462              and buf_recipe.recipe-code   = buf_i_fbr-line.recipe-code
     4463       no-error.
     4464       if not available buf_recipe
     4465       then do:
     4466           message
     4467                   vss-workfile vss-revision vss-description
     4468               skip "В строке производства не указан рецепт."
     4469               skip "Невозможно рассчитать количество составного товара."
     4470               skip return-value
     4471               skip trim(error-status :get-message(1))
     4472                   trim(error-status :get-message(2))
     4473                   trim(error-status :get-message(3))
     4474           view-as alert-box error.
     4475           undo, return error .
     4476       end.
     4477       if buf_recipe.recipe-type = 'альтернатива':U
     4478       then do:
     4479           for each buf_fbr-line no-lock
     4480              where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     4481                and buf_fbr-line.trn-type    = buf_i_fbr-line.trn-type
     4482                and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     4483           on error undo, return error
     4484           :
     4485               find first buf_recipe-gds no-lock
     4486                    where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     4487                      and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     4488                      and buf_recipe-gds.artic       = buf_fbr-line.artic
     4489                      and buf_recipe-gds.prod-type   = buf_fbr-line.prod-type
     4490                      and buf_recipe-gds.prod-code   = buf_fbr-line.prod-code
     4491               .
     4492               assign
     4493                   p-comp-qnty         = p-comp-qnty       + ( buf_fbr-line.fact-qnty * buf_recipe-gds.brutto-qnty )
     4494               .
     4495           end.
     4496           assign
     4497               p-comp-qnty         = p-comp-qnty       / buf_recipe.qnty
     4498           .
     4499       end.
     4500       else do:
     4501           find first buf_recipe-gds no-lock
     4502                where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     4503                  and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     4504                  and buf_recipe-gds.artic       = buf_i_fbr-line.artic
     4505                  and buf_recipe-gds.prod-type   = buf_i_fbr-line.prod-type
     4506                  and buf_recipe-gds.prod-code   = buf_i_fbr-line.prod-code
     4507           .
     4508           assign
     4509               p-comp-qnty = p-fact-qnty / buf_recipe-gds.brutto-qnty * buf_recipe.qnty
     4510           .
     4511       end.
     4512       find first buf_fbr-line no-lock
     4513            where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     4514              and buf_fbr-line.is-comp     = yes
     4515              and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     4516       .
     4517       assign
     4518           p-comp-fbr-v-fbr-doc-line-recid = recid( buf_fbr-line )
     4519       .
     4520   end.
     4521   END PROCEDURE.
     4522   PROCEDURE get-temp_dressing-ingr-used-qnty :
     4523   define input parameter p-recipe-code    as character    no-undo.
     4524   define input parameter p-gds-code       as integer      no-undo.
     4525   define output parameter p-line-qnty     as decimal      no-undo.
     4526   define output parameter p-used-qnty     as decimal      no-undo.
     4527   define output parameter p-recipe-qnty   as decimal      no-undo.
     4528       define buffer buf_temp_dressing-ingr    for temp_dressing-ingr.
     4529   do
     4530   for buf_temp_dressing-ingr
     4531   on error undo, return error
     4532   :
     4533       find first buf_temp_dressing-ingr no-lock
     4534            where buf_temp_dressing-ingr.recipe-code = p-recipe-code
     4535              and buf_temp_dressing-ingr.gds-code    = p-gds-code
     4536       no-error.
     4537       if available buf_temp_dressing-ingr
     4538       then do:
     4539           assign
     4540               p-line-qnty     = buf_temp_dressing-ingr.line-qnty
     4541               p-used-qnty     = buf_temp_dressing-ingr.used-qnty
     4542               p-recipe-qnty   = buf_temp_dressing-ingr.recipe-qnty
     4543           .
     4544       end.
     4545       else do:
     4546           assign
     4547               p-line-qnty     = 0
     4548               p-used-qnty     = 0
     4549               p-recipe-qnty   = 0
     4550           .
     4551       end.
     4552   end.
     4553   END PROCEDURE.
     4554   PROCEDURE fbrlib_adjust-recipe :
     4555   do
     4556   on error undo, return error
     4557   :
     4558   define input parameter parparentproc as widget-handle no-undo .
     4559   define input parameter p-fbrhist-handle as handle no-undo .
     4560   define input parameter p-doc-code       as character    no-undo.
     4561   define input parameter p-recipe-code    as character    no-undo.
     4562   define input parameter p-price-sale-obj-type as character no-undo .
     4563   define input parameter p-price-sale-obj-code as integer no-undo .
     4564       define variable v-recipe-qnty       as decimal      no-undo.
     4565       define variable v-comp-qnty         as decimal      no-undo.
     4566       define variable v-recipe-gds-qnty   as decimal      no-undo.
     4567       define variable v-ingr-qnty         as decimal      no-undo.
     4568       define variable v-qnty              as decimal      no-undo.
     4569       define variable v-coeff-waste       as decimal      no-undo.
     4570       define variable v-brutto-qnty       as decimal      no-undo.
     4571       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     4572       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     4573       define buffer buf_fbr-line          for ub.fbr-line.
     4574       define buffer buf_el_fbr-recipe-gds for ub.fbr-recipe-gds.
     4575       find first buf_fbr-recipe no-lock
     4576            where buf_fbr-recipe.doc-code      = p-doc-code
     4577              and buf_fbr-recipe.recipe-code   = p-recipe-code
     4578       .
     4579       assign
     4580           v-recipe-qnty = buf_fbr-recipe.qnty
     4581       .
     4582       find first buf_fbr-line no-lock
     4583            where buf_fbr-line.doc-code    = p-doc-code
     4584              and buf_fbr-line.is-comp     = yes
     4585              and buf_fbr-line.recipe-code = p-recipe-code
     4586       .
     4587       assign
     4588           v-comp-qnty = buf_fbr-line.fact-qnty
     4589       .
     4590       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     4591       then do:
     4592       end.
     4593       else do:
     4594           for each buf_fbr-recipe-gds no-lock
     4595              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     4596                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     4597           on error undo, return error
     4598           :
     4599               find first buf_fbr-line no-lock
     4600                    where buf_fbr-line.doc-code    = p-doc-code
     4601                      and buf_fbr-line.is-comp     = no
     4602                      and buf_fbr-line.recipe-code = p-recipe-code
     4603                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4604                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4605                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4606               .
     4607               if buf_fbr-line.fact-qnty / v-comp-qnty <> buf_fbr-recipe-gds.brutto-qnty / v-recipe-qnty
     4608               then do:
     4609                   do transaction
     4610                   on error undo, return error
     4611                   :
     4612                       find first buf_el_fbr-recipe-gds exclusive-lock
     4613                            where recid( buf_el_fbr-recipe-gds ) = recid( buf_fbr-recipe-gds )
     4614                       .
     4615                       assign
     4616                           buf_el_fbr-recipe-gds.calc-method   = 1
     4617                           buf_el_fbr-recipe-gds.brutto-qnty   = buf_fbr-line.fact-qnty * v-recipe-qnty / v-comp-qnty
     4618                       .
     4619                       run fbrlib-calc-brutto in this-procedure (
     4620                             input buf_fbr-recipe.recipe-type
     4621                           , input 0
     4622                           , input buf_el_fbr-recipe-gds.coeff-value
     4623                           , input buf_el_fbr-recipe-gds.coeff-waste
     4624                           , input buf_el_fbr-recipe-gds.brutto-qnty
     4625                           , input 1
     4626                           , output buf_el_fbr-recipe-gds.qnty
     4627                           , output buf_el_fbr-recipe-gds.coeff-waste
     4628                           , output buf_el_fbr-recipe-gds.brutto-qnty
     4629                           , output buf_el_fbr-recipe-gds.calc-method
     4630                       ).
     4631                   end.
     4632               end.
     4633           end.
     4634           run fbrlib_adjust-doc-lines in this-procedure (
     4635                 input parparentproc
     4636               , input p-fbrhist-handle
     4637               , input p-doc-code
     4638               , input p-recipe-code
     4639               , input p-price-sale-obj-type
     4640               , input p-price-sale-obj-code
     4641           ).
     4642       end.
     4643   end.
     4644   END PROCEDURE.
     4645   PROCEDURE fbrlib_adjust-doc-lines :
     4646   define input parameter parparentproc as widget-handle no-undo .
     4647   define input parameter p-fbrhist-handle as handle no-undo .
     4648   define input parameter p-doc-code       as character    no-undo.
     4649   define input parameter p-recipe-code    as character    no-undo.
     4650   define input parameter p-price-sale-obj-type as character no-undo .
     4651   define input parameter p-price-sale-obj-code as integer no-undo .
     4652   define variable v-comp-qnty         as decimal      no-undo.
     4653   define variable v-trn-type          as character    no-undo.
     4654   define variable v-ingr-qnty         as decimal      no-undo.
     4655   define variable v-recipe-qnty       as decimal      no-undo.
     4656   define variable v-fbr-v-fbr-doc-line-recid    as recid        no-undo.
     4657   define buffer buf_fbr-recipe        for ub.fbr-recipe.
     4658   define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     4659   define buffer buf_fbr-line          for ub.fbr-line.
     4660   define buffer buf_coeff_fbr-line    for ub.fbr-line.
     4661   define buffer buf_goods             for ub.goods.
     4662   define buffer buf_fbr-doc           for ub.fbr-doc.
     4663   do
     4664   for buf_fbr-recipe
     4665     , buf_fbr-recipe-gds
     4666     , buf_fbr-line
     4667     , buf_coeff_fbr-line
     4668     , buf_goods
     4669     , buf_fbr-doc
     4670   on error undo, return error
     4671   :
     4672       find first buf_fbr-line no-lock
     4673            where buf_fbr-line.doc-code      = p-doc-code
     4674              and buf_fbr-line.is-comp       = yes
     4675              and buf_fbr-line.recipe-code   = p-recipe-code
     4676       .
     4677       find first buf_fbr-doc no-lock
     4678            where buf_fbr-doc.doc-code      = p-doc-code
     4679       .
     4680       assign
     4681           v-comp-qnty = buf_fbr-line.fact-qnty
     4682           v-trn-type  = buf_fbr-line.trn-type
     4683       .
     4684       find first buf_fbr-recipe no-lock
     4685            where buf_fbr-recipe.doc-code    = p-doc-code
     4686              and buf_fbr-recipe.recipe-code = p-recipe-code
     4687       .
     4688       assign
     4689       v-recipe-qnty = buf_fbr-recipe.qnty
     4690       .
     4691       do transaction
     4692       on error undo, return error
     4693       :
     4694           for each buf_fbr-recipe-gds no-lock
     4695              where buf_fbr-recipe-gds.doc-code      = p-doc-code
     4696                and buf_fbr-recipe-gds.recipe-code   = p-recipe-code
     4697           on error undo, return error
     4698           :
     4699               find first buf_fbr-line no-lock
     4700                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     4701                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     4702                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4703                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4704                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4705               no-error.
     4706               if not available buf_fbr-line
     4707               then do:
     4708                   find first buf_goods no-lock
     4709                        where buf_goods.artic      = buf_fbr-recipe-gds.artic
     4710                          and buf_goods.prod-type  = buf_fbr-recipe-gds.prod-type
     4711                          and buf_goods.prod-code  = buf_fbr-recipe-gds.prod-code
     4712                   .
     4713                   run str/fbr-crln.p (
     4714                         input parparentproc
     4715                       , input recid( buf_fbr-doc )
     4716                       , input recid( buf_goods )
     4717                       , input buf_fbr-recipe-gds.recipe-code
     4718                       , input v-trn-type
     4719                       , input no
     4720                       , input no
     4721                       , input buf_fbr-doc.obj-type
     4722                       , input buf_fbr-doc.obj-code
     4723                       , output v-fbr-v-fbr-doc-line-recid
     4724                   ).
     4725                   find first buf_fbr-line no-lock
     4726                        where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     4727                          and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     4728                          and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4729                          and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4730                          and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4731                   no-error.
     4732                   if not available buf_fbr-line
     4733                   then do:
     4734                       undo, return error substitute("Не удалось создать строку документа производства &1 &2&3&4"
     4735                                                      , p-doc-code
     4736                                                      , buf_fbr-recipe-gds.artic
     4737                                                      , buf_fbr-recipe-gds.prod-type
     4738                                                      , buf_fbr-recipe-gds.prod-code).
     4739                   end.
     4740               end.
     4741               find first buf_coeff_fbr-line exclusive-lock
     4742                    where recid( buf_coeff_fbr-line ) = recid( buf_fbr-line )
     4743               .
     4744               if buf_coeff_fbr-line.calc-method <> buf_fbr-recipe-gds.calc-method
     4745               or buf_coeff_fbr-line.coeff-value <> buf_fbr-recipe-gds.coeff-value
     4746               or buf_coeff_fbr-line.coeff-waste <> buf_fbr-recipe-gds.coeff-waste
     4747               then do:
     4748                   assign
     4749                       buf_coeff_fbr-line.calc-method = buf_fbr-recipe-gds.calc-method
     4750                       buf_coeff_fbr-line.coeff-value = buf_fbr-recipe-gds.coeff-value
     4751                       buf_coeff_fbr-line.coeff-waste = buf_fbr-recipe-gds.coeff-waste
     4752                   .
     4753               end.
     4754           end.
     4755       end.
     4756       define variable v-need-goods    as logical       no-undo.
     4757       define variable v-need-goods-list       as character     no-undo.
     4758       define variable v-need-goods-qnty-list  as character     no-undo.
     4759       find first buf_fbr-line no-lock
     4760            where buf_fbr-line.doc-code    = buf_fbr-doc.doc-code
     4761              and buf_fbr-line.is-comp     = yes
     4762              and buf_fbr-line.recipe-code = p-recipe-code
     4763       .
     4764       run str/fbr-qnty.p (
     4765             input parparentproc
     4766           , input p-fbrhist-handle
     4767           , input recid( buf_fbr-doc )
     4768           , input recid( buf_fbr-line )
     4769           , input no
     4770           , input "ingr"
     4771           , input no
     4772           , input p-price-sale-obj-type
     4773           , input p-price-sale-obj-code
     4774           , input no
     4775           , input no
     4776           , input no
     4777           , output v-need-goods
     4778           , output v-need-goods-list
     4779           , output v-need-goods-qnty-list
     4780       ).
     4781   end.
     4782   END PROCEDURE.
     4783   procedure fbrlib_check-before-close :
     4784   define input parameter p-doc-code as character no-undo .
     4785   define variable same-sale as decimal no-undo .
     4786   define variable is-waste as logical no-undo .
     4787   define variable fix-price as logical no-undo .
     4788   define buffer buf_fbr-doc for ub.fbr-doc.
     4789   define buffer buf_fbr-line for ub.fbr-line.
     4790   define buffer buf_goods for ub.goods.
     4791   define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     4792   do
     4793   on error undo, return error
     4794   :
     4795     for each buf_fbr-line no-lock
     4796         where buf_fbr-line.doc-code = p-doc-code
     4797       , each buf_goods no-lock
     4798         where buf_goods.artic     = buf_fbr-line.artic
     4799           and buf_goods.prod-type = buf_fbr-line.prod-type
     4800           and buf_goods.prod-code = buf_fbr-line.prod-code
     4801     break by buf_fbr-line.prod-type
     4802           by buf_fbr-line.prod-code
     4803           by buf_fbr-line.artic
     4804     :
     4805       if first-of (buf_fbr-line.artic)
     4806       then do:
     4807         assign
     4808         same-sale = buf_fbr-line.price-sale
     4809         is-waste = (buf_fbr-line.rsrv-qnty = ?)
     4810         fix-price = buf_fbr-line.is-calc
     4811         .
     4812       end.
     4813       if same-sale <> buf_fbr-line.price-sale
     4814       then do:
     4815           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром должна быть указана одна и та же цена продажи."
     4816                                         ,p-doc-code
     4817                                         ,buf_goods.artic
     4818                                         ,buf_goods.gds-name
     4819                                         ,chr(10)).
     4820       end.
     4821       if fix-price <> buf_fbr-line.is-calc then do:
     4822           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром цена должна быть фиксирована или нет."
     4823                                         ,p-doc-code
     4824                                         ,buf_goods.artic
     4825                                         ,buf_goods.gds-name
     4826                                         ,chr(10)).
     4827       end.
     4828       if is-waste <> (buf_fbr-line.rsrv-qnty = ?)
     4829       then do:
     4830         undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа этот товар должен быть отходом либо не отходом."
     4831                                         ,p-doc-code
     4832                                         ,buf_goods.artic
     4833                                         ,buf_goods.gds-name
     4834                                         ,chr(10)).
     4835       end.
     4836       if buf_fbr-line.rsrv-qnty <> ?
     4837       and buf_goods.gds-type <> 'у':U
     4838       and ( buf_fbr-line.price-sale <= 0 or buf_fbr-line.price-sale = ?  )
     4839       and buf_fbr-line.fact-qnty <> 0
     4840       then do:
     4841         if buf_fbr-line.trn-type     = 'при':U  then for first buf_fbr-doc where buf_fbr-doc.doc-code =  p-doc-code no-lock:
     4842           if  can-find(first buf_fbr-gds-obj no-lock where
     4843                   buf_fbr-gds-obj.gds-code = buf_goods.gds-code
     4844               AND buf_fbr-gds-obj.obj-type = buf_fbr-doc.obj-type
     4845               AND buf_fbr-gds-obj.obj-code = buf_fbr-doc.obj-code
     4846               and buf_fbr-gds-obj.is-null-price  )  then .
     4847                     else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     4848                                         ,p-doc-code
     4849                                         ,buf_goods.artic
     4850                                         ,buf_goods.gds-name
     4851                                         ,chr(10)
     4852                                         ,buf_fbr-line.recipe-code
     4853                                         ).
     4854         end.
     4855         else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     4856                                         ,p-doc-code
     4857                                         ,buf_goods.artic
     4858                                         ,buf_goods.gds-name
     4859                                         ,chr(10)
     4860                                         ,buf_fbr-line.recipe-code
     4861                                         ).
     4862       end.
     4863     end.
     4864   end.
     4865   end procedure.
     4866     define input parameter p-SortType as character no-undo .
     4867    do
     4868    on error undo, return error return-value
     4869    :
     4870   define variable   sort-name   as logical no-undo.
     4871   define variable   sort-gr     as logical no-undo.
     4872   define variable   print-graft as logical no-undo.
     4873   define variable   summ as decimal no-undo .
     4874   define variable pp-r as character no-undo .
     4875   sort-gr     = true  .
     4876   sort-name   = false .
     4877   print-graft = true .
     4878   define variable sort-group as logical   no-undo .
     4879   if sort-gr                  then assign sort-group = yes .
     4880   else                             assign sort-group = no .
     4881   DEFINE temp-table temp-str no-undo
     4882     field  nn           as integer
     4883     field  fact-date    like fbr-doc.fact-date
     4884     field  doc-code     like  fbr-doc.doc-code
     4885     field  recipe-code  like  recipe.recipe-code
     4886     field  gds-name     like  goods.gds-name
     4887     field  gds-code     like  goods.gds-code
     4888     field  artic        like  goods.artic
     4889     field  prod-type    like  goods.prod-type
     4890     field  prod-code    like  goods.prod-code
     4891     field  crsa         AS DECIMAL
     4892     field  cost         as decimal
     4893     field  dis          as decimal
     4894     field  dis-proc     as decimal
     4895     field  porc         as decimal
     4896     field  ei            as char
     4897     index pi   nn
     4898     index pi1  FACT-DATE doc-code
     4899     index pi2  recipe-code FACT-DATE
     4900     index pi3  gds-name recipe-code FACT-DATE
     4901   .
     4902   define stream  OutStream  .
     4903   define stream  macr_excel .
     4904   define variable v-file-name as character no-undo .
     4905   define variable v-ind       as integer   no-undo .
     4906   define variable num#col#    as integer no-undo .
     4907   define variable C-c    as integer no-undo .
     4908   define variable C-str  as character no-undo .
     4909   define variable str--1 as character Format "x(60)" no-undo.
     4910   define variable str--2 as integer no-undo .
     4911   define variable C-i    as integer no-undo .
     4912   define variable p-var  as integer no-undo .
     4913   define variable var-1  as integer no-undo .
     4914   define variable var-2  as integer no-undo .
     4915   define variable n-recipe-code  as character no-undo .
     4916   define variable n-porc as integer no-undo .
     4917   define variable num-re as character no-undo .
     4918   define variable qnt-delta as decimal no-undo .
     4919   define buffer buf_clients for  clients .
     4920   define buffer This_Object for  clients .
     4921   define variable qnty as decimal   no-undo .
     4922   define variable sum  as decimal   no-undo .
     4923   define variable num-ln as integer   no-undo .
     4924   define variable FullNameGds as character no-undo .
     4925   define variable gds-str as char no-undo.
     4926   define variable gds-str1 as char no-undo.
     4927   define variable gds-str2 as char no-undo.
     4928   define variable i as int no-undo.
     4929   define variable j as int no-undo.
     4930   define variable Counter1 as integer init 0  no-undo .
     4931   define variable LineBuf       as char    no-undo.
     4932   define variable Line       as char    no-undo.
     4933   define variable UndLine    as char    no-undo.
     4934   define variable     Lines_Counter as   int  init 0  no-undo.
     4935   define variable     Tmp_Counter   as   int  init 0  no-undo.
     4936   DEFINE FRAME plan-menu
     4937       sym1                  COLUMN-LABEL ":!:!:" space(0)
     4938       temp-str.nn           column-label " !   №   ! п/п  "  format ">>>>>>9"     space(0)
     4939       sym2                  COLUMN-LABEL ":!:!:" space(0)
     4940       temp-str.fact-date    column-label "Дата!документа!пр-ва"              space(0)
     4941       sym3                  COLUMN-LABEL ":!:!:" space(0)
     4942       temp-str.doc-code     column-label "№!документа!пр-ва"                 space(0)
     4943       sym4                  COLUMN-LABEL ":!:!:" space(0)
     4944       temp-str.gds-name     column-label " !Название блюда! "                space(0)
     4945       sym5                  COLUMN-LABEL ":!:!:" space(0)
     4946       temp-str.ei           column-label "Ед.!изм.! "  format "x(4)"         space(0)
     4947       sym6                  COLUMN-LABEL ":!:!:" space(0)
     4948       temp-str.crsa         column-label  "Цена !реализации !за 1 ед.изм."   space(0)
     4949       sym7                  COLUMN-LABEL ":!:!:" space(0)
     4950       temp-str.cost         column-label  "Учетная !цена по до-!кументу"     space(0)
     4951       sym8                  COLUMN-LABEL ":!:!:" space(0)
     4952       temp-str.dis          column-label  " !Наценка ! "                     space(0)
     4953       sym9                  COLUMN-LABEL ":!:!:" space(0)
     4954       temp-str.dis-proc     column-label  "%   !наценки ! "                  space(0)
     4955       sym10                 COLUMN-LABEL ":!:!:" space(0)
     4956       temp-str.porc         column-label  "Количество!в ед.изм.!"            space(0)
     4957       sym11                 COLUMN-LABEL ":!:!:" space(0)
     4958       temp-str.recipe-code  column-label  " ! № рецепта ! "                  space(0)
     4959       sym12                 COLUMN-LABEL ":!:!:" space(0)
     4960       HEADER
     4961       string( "Лист " + string( PAGE-NUMBER(OutStream) , ">>>>9") ) AT 160 format "X(13)" SKIP
     4962       Line format "X(158)" AT 1
     4963       with width 232 down stream-io use-text  NO-BOX .
     4964     if session:set-wait-state("compiler") then.
     4965   output STREAM OutStream to value( string( session:temp-directory +
     4966                                        "rpt" + string( g#report-num ) ) )
     4967                                        page-size  value(43) .
     4968     define variable v-prn0 as character no-undo .
     4969     assign
     4970       Line    = fill("-", 230)
     4971       UndLine = fill("_", 230)
     4972       LineBuf = fill("_", 240)
     4973     .
     4974     IF var-report-r-b = "rubl" THEN Assign pp-r = "руб".
     4975                                Else Assign pp-r = "баз.вал" .
     4976   define variable varobj-date as date no-undo .
     4977   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4978   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     4979     (input  v-cntxt-obj-type
     4980     ,input  v-cntxt-obj-code
     4981     ,output varobj-date
     4982     ) no-error .
     4983   define variable v-account as integer init 0 no-undo .
     4984   define variable v-account-lavel as character no-undo .
     4985   define variable v-button-stop as logical no-undo .
     4986   define variable v-kol-spice as integer no-undo .
     4987   define variable v-kol-spice2 as integer no-undo .
     4988   define variable v-kol-spice3 as integer no-undo .
     4989   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     4990   DEFINE BUTTON StopBtn AUTO-END-KEY
     4991        LABEL "Стоп"
     4992        SIZE 10 BY 1.
     4993   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     4994        LABEL "Обработано записей"
     4995         VIEW-AS TEXT
     4996        SIZE 14 BY .67 NO-UNDO.
     4997   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     4998         VIEW-AS TEXT
     4999        SIZE 53.25 BY .67
     5000        FGCOLOR 1  NO-UNDO.
     5001   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     5002         VIEW-AS TEXT
     5003        SIZE 53.25 BY .67
     5004        FGCOLOR 1  NO-UNDO.
     5005   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     5006         VIEW-AS TEXT
     5007        SIZE 53.25 BY .67
     5008        FGCOLOR 1  NO-UNDO.
     5009   DEFINE RECTANGLE RECT-1
     5010        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     5011        SIZE 55.13 BY 4.46.
     5012   DEFINE FRAME InfoFrame
     5013        StopBtn AT ROW 4.25 COL 21.75
     5014        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     5015        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     5016        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     5017        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     5018        RECT-1 AT ROW 1 COL 1
     5019       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     5020            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     5021            TITLE "Процесс"
     5022            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     5023   define variable mFrameView      as logical   no-undo init yes.
     5024     define variable mFramHandle as handle no-undo.
     5025     mFramHandle = frame InfoFrame:handle.
     5026     if  log-manager:logfile-name ne ?
     5027     then DO:
     5028         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     5029         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     5030         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     5031     end.
     5032     mFrameView = not session:batch-mode and mFramHandle:visible.
     5033     if mFrameView
     5034     then do:
     5035       ASSIGN
     5036          FRAME InfoFrame:HIDDEN                           = TRUE
     5037          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     5038     end.
     5039   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     5040   DO:
     5041     IF not StopProcessing THEN
     5042       Message "Вы действительно хотите прервать" SKIP
     5043               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     5044                 UPDATE StopProcessing.
     5045     IF StopProcessing THEN do:
     5046        if mFrameView
     5047        then do:
     5048           HIDE FRAME InfoFrame.
     5049        end.
     5050     End.
     5051   END.
     5052   assign v-account = ( if integer( 25 ) = 0 then 100 else integer( 25 ) ).
     5053     if  log-manager:logfile-name ne ?
     5054     then DO:
     5055         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     5056     end.
     5057     if not session:batch-mode then
     5058     do:
     5059       VIEW FRAME InfoFrame.
     5060       mFrameView = true.
     5061     end.
     5062      v-button-stop = false .
     5063         if mFrameView
     5064         then do:
     5065         if v-button-stop then view STOPBTN in frame InfoFrame.
     5066                          else Hide STOPBTN in frame InfoFrame.
     5067         end.
     5068   v-ind = 0    .
     5069       Output stream Macr_Excel  close .
     5070       num#str# = 0 .
     5071       run gbl/_tmpfile.p ("wb", ".txt", output v-file-name) .
     5072       output stream macr_excel to value(v-file-name)   .
     5073       v-ind = v-ind + 1.
     5074   FORM with frame plan-menu .
     5075   define variable v-type-goods as character no-undo .
     5076   define variable v-ves        as logical no-undo .
     5077   run PrintTitul in this-procedure .
     5078     run make-tt.
     5079     case p-sorttype :
     5080       when "sort-doc-code" then do:
     5081           for each temp-str no-lock  use-index pi1 :
     5082               run print-line in this-procedure .
     5083           end.
     5084       end.
     5085       when "sort-recipe-code" then do:
     5086           for each temp-str no-lock  use-index pi2  :
     5087               run print-line in this-procedure .
     5088           end.
     5089       end.
     5090       when "sort-name" then do:
     5091           for each temp-str no-lock use-index pi3  :
     5092               run print-line in this-procedure .
     5093           end.
     5094       end.
     5095     end case.
     5096     run print-all-itog in this-procedure .
     5097     run on-same-page in this-procedure (input 11) .
     5098     run PrintPodval in this-procedure .
     5099     run paramls-write in this-procedure
     5100       (input "file"
     5101       ,input string(v-ind)
     5102       ,input v-file-name
     5103       ) .
     5104        page stream OutStream .
     5105   HIDE STREAM OutStream FRAME plan-menu.
     5106   HIDE stream OutStream FRAME BottomFrame .
     5107   HIDE stream OutStream FRAME BottomFrame2 .
     5108   output stream OutStream CLOSE .
     5109   Output stream Macr_Excel  close .
     5110   if mFrameView
     5111   then do:
     5112      HIDE FRAME InfoFrame.
     5113   end.
     5114       run paramls-write in this-procedure
     5115           (input "charcol"
     5116           ,input ""
     5117           ,input "2,3,4,5,11"
     5118           ) .
     5119     run end-proc .
     5120      define variable v-user-action as character no-undo .
     5121      define variable v-printed as logical   no-undo .
     5122      define variable DisabledOptions as integer   no-undo .
     5123      DisabledOptions = 8 .
     5124      run gbl/prnfilen.w
     5125        (input  ""
     5126        ,input  DisabledOptions
     5127        ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     5128        ,input 7
     5129        ,output v-user-action
     5130        ,output v-printed
     5131        ) .
     5132   end.
     5133   procedure print-line :
     5134     do on error undo, return error return-value :
     5135     define buffer buf_fbr-line       for fbr-line .
     5136     define buffer buf_fbr-recipe-gds for fbr-recipe-gds .
     5137     define buffer buf_recipe-gds     for recipe-gds .
     5138     define buffer buf_fbr-recipe     for fbr-recipe .
     5139     define variable p-norma as decimal format "->>>>>>>>>9.999"  no-undo .
     5140     define variable p-price as decimal format ">>>>>>>>>>9.99" no-undo .
     5141     define variable p-sum   as decimal format "->>>>>>>>>9.99"  no-undo .
     5142     define variable s-plus  as logical init false  no-undo .
     5143     define variable s-minus as logical init false no-undo .
     5144     define variable var-season-qnty1 as decimal no-undo .
     5145     assign
     5146        Lines_Counter = Lines_Counter + 1
     5147       .
     5148     if line-counter( OutStream ) + 2 > page-size( OutStream ) then page stream OutStream.
     5149     if line-counter( OutStream ) < Tmp_Counter then
     5150       assign
     5151       .
     5152     assign
     5153       Tmp_Counter  = line-counter( OutStream )
     5154       num-ln = num-ln + 1
     5155     .
     5156     if line-counter( OutStream ) + j > page-size( OutStream ) then  PAGE STREAM OutStream.
     5157   num#str# = num#str# + 1.
     5158   num#col# = 1.
     5159   run macr_excel_char( num-ln      , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     5160   run macr_excel_char(  string(temp-str.fact-date , "99/99/9999") , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     5161   run macr_excel_char(     temp-str.doc-code  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     5162   run macr_excel_char(     temp-str.gds-name  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     5163   run macr_excel_char(     temp-str.ei        , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     5164   run macr_excel_dec (round(temp-str.crsa , 2)     , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     5165   run macr_excel_dec (round(temp-str.cost  , 2)    , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     5166   run macr_excel_dec (round(temp-str.dis   , 2)    , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     5167   run macr_excel_dec (round(temp-str.dis-proc, 2)  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     5168   run macr_excel_dec (round(temp-str.porc   , 3)   , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     5169   run macr_excel_char(      temp-str.recipe-code , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     5170    display stream OutStream
     5171       num-ln @ temp-str.nn                sym1
     5172       temp-str.fact-date         sym2
     5173       temp-str.doc-code          sym3
     5174       temp-str.gds-name          sym4
     5175       temp-str.ei                sym5
     5176       temp-str.crsa              sym6
     5177       temp-str.cost              sym7
     5178       temp-str.dis               sym8
     5179       temp-str.dis-proc          sym9
     5180       temp-str.porc              sym10
     5181       temp-str.recipe-code       sym11
     5182                                  sym12
     5183       with frame plan-menu.
     5184       down stream OutStream 1 with frame plan-menu.
     5185     end.
     5186   end procedure.
     5187   procedure print-all-itog :
     5188    PUT STREAM OutStream UNFORMATTED
     5189         line format "x(158)" skip.
     5190   end procedure.
     5191   procedure PrintTitul :
     5192     do  on error undo, return error return-value  :
     5193     define variable cc as integer no-undo .
     5194     define variable tt as integer no-undo .
     5195     define variable pp as integer no-undo .
     5196    PUT STREAM OutStream UNFORMATTED
     5197           space(5) string( caps(reportname) ) +
     5198                    string( " C " )  + string(x-date-start, "99/99/9999" )  +
     5199                    string( " ПО " ) + string(x-date-end, "99/99/9999" )
     5200                    format "X(160)"  skip
     5201                    "Дата составления " + cur-time-date() at 165 skip
     5202         .
     5203         num#str# = num#str# + 1 .
     5204         num#col# =  1 .
     5205         run macr_excel_char_with_format( caps(reportname) +
     5206                    string( " C " )  + string(x-date-start, "99/99/9999" )  +
     5207                    string( " ПО " ) + string(x-date-end, "99/99/9999" )
     5208         , num#str# , num#col#  ).
     5209         run macr_cell_format
     5210             ( 12    ,
     5211               true  ,
     5212               false ,
     5213               ?     ,
     5214               num#str# ,
     5215               num#col# ,
     5216               ? ,
     5217               ?         ) .
     5218   define variable l-ii  as integer no-undo .
     5219   define variable l-jj  as integer no-undo .
     5220   define variable l-len as integer no-undo .
     5221   define variable l-m   as integer no-undo .
     5222   do l-ii = 1 to num-entries( str1 , "chr(10)"  )    :        l-len = length (entry( l-ii , str1  , "chr(10)")) .                       l-m = integer( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format(                                                                        substring(entry( l-ii , str1  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .          PUT STREAM OutStream UNFORMATTED substring(entry( l-ii , str1  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )            skip.        end.                                                                                                         end.
     5223   do l-ii = 1 to num-entries( str2 , "chr(10)"  )    :        l-len = length (entry( l-ii , str2  , "chr(10)")) .                       l-m = integer( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format(                                                                        substring(entry( l-ii , str2  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .          PUT STREAM OutStream UNFORMATTED substring(entry( l-ii , str2  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )            skip.        end.                                                                                                         end.
     5224   do l-ii = 1 to num-entries( str3 , "chr(10)"  )    :        l-len = length (entry( l-ii , str3  , "chr(10)")) .                       l-m = integer( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format(                                                                        substring(entry( l-ii , str3  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .          PUT STREAM OutStream UNFORMATTED substring(entry( l-ii , str3  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )            skip.        end.                                                                                                         end.
     5225   do l-ii = 1 to num-entries( str4 , "chr(10)"  )    :        l-len = length (entry( l-ii , str4  , "chr(10)")) .                       l-m = integer( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format(                                                                        substring(entry( l-ii , str4  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .          PUT STREAM OutStream UNFORMATTED substring(entry( l-ii , str4  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )            skip.        end.                                                                                                         end.
     5226   do l-ii = 1 to num-entries( reportheader , "chr(10)"  )    :        l-len = length (entry( l-ii , reportheader  , "chr(10)")) .                       l-m = integer( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format(                                                                        substring(entry( l-ii , reportheader  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .          PUT STREAM OutStream UNFORMATTED substring(entry( l-ii , reportheader  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )            skip.        end.                                                                                                         end.
     5227     num#str# = num#str# + 1.
     5228     num#col# = 1.
     5229       run proc-print-header .
     5230     end.
     5231   end procedure.
     5232   procedure PrintPodval :
     5233     do on error undo, return error return-value  :
     5234     end.
     5235   end procedure.
     5236   PROCEDURE on-same-page :
     5237     define input parameter p-line-number as integer  no-undo .
     5238     if p-line-number > page-size( OutStream ) then return .
     5239     if line-counter( OutStream ) + p-line-number > page-size( OutStream ) then  page stream OutStream .
     5240   end procedure.
     5241   procedure make-tt :
     5242     do
     5243     on error undo, return error return-value
     5244     :
     5245   define buffer buf_fbr-doc for fbr-doc.
     5246   define buffer buf_fbr-line for fbr-line.
     5247   define variable ii as integer no-undo .
     5248   define buffer buf_recipe for recipe.
     5249   define buffer buf_goods for goods.
     5250   for each  buf_fbr-doc no-lock where
     5251             buf_fbr-doc.host-code  = v-cntxt-host-code-obj and
     5252             buf_fbr-doc.fact-date <= x-date-end  and
     5253             buf_fbr-doc.fact-date >= x-date-start
     5254             break by buf_fbr-doc.fact-date
     5255       on error undo, return error :
     5256       run fbrlib-put-in-order-recipe (input buf_fbr-doc.doc-code ) .
     5257       for each temp_recipe-order where temp_recipe-order.recipe-code <> ""  break by temp_recipe-order.order
     5258           on error undo, return error :
     5259           find first buf_recipe no-lock where buf_recipe.recipe-code = temp_recipe-order.recipe-code no-error .
     5260           if error-status :error then
     5261              message vss-workfile vss-revision vss-description skip
     5262                     "Ошибка поиска recipce № " temp_recipe-order.recipe-code skip
     5263                      skip
     5264                      error-status :get-message(1) skip
     5265                      return-value skip
     5266                      view-as alert-box error
     5267              .
     5268           if buf_recipe.recipe-type = 'производство':U then do:
     5269               find first buf_goods no-lock
     5270                   where buf_goods.artic      = buf_recipe.artic
     5271                     and buf_goods.prod-type  = buf_recipe.prod-type
     5272                     and buf_goods.prod-code  = buf_recipe.prod-code .
     5273               find first buf_fbr-line no-lock where
     5274                         buf_fbr-line.artic        = buf_recipe.artic
     5275                     and buf_fbr-line.prod-type    = buf_recipe.prod-type
     5276                     and buf_fbr-line.prod-code    = buf_recipe.prod-code
     5277                     and buf_fbr-line.recipe-code  = buf_recipe.recipe-code
     5278                     and buf_fbr-line.doc-code     = buf_fbr-doc.doc-code
     5279                     .
     5280              ii = ii + 1 .
     5281              create temp-str.
     5282              assign
     5283                temp-str.nn           = ii
     5284                temp-str.fact-date    = buf_fbr-doc.fact-date
     5285                temp-str.doc-code     = buf_fbr-doc.doc-code
     5286                temp-str.recipe-code  = buf_recipe.recipe-code
     5287                temp-str.gds-name     = buf_goods.gds-name
     5288                temp-str.gds-code     = buf_goods.gds-code
     5289                temp-str.artic        = buf_goods.artic
     5290                temp-str.prod-type    = buf_goods.prod-type
     5291                temp-str.prod-code    = buf_goods.prod-code
     5292                temp-str.ei           = buf_goods.unit-base
     5293                temp-str.crsa         = buf_fbr-line.price-sale
     5294                temp-str.cost         = buf_fbr-line.price-rubl
     5295                temp-str.dis          = temp-str.crsa - temp-str.cost
     5296                temp-str.dis-proc     = temp-str.dis * 100 / temp-str.cost
     5297                temp-str.porc         = buf_fbr-line.fact-qnty
     5298               .
     5299           end.
     5300       end.
     5301   end.
     5302     end.
     5303    end procedure.
     5304   def var vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5305   procedure macr_excel_char :
     5306    do
     5307    on error undo, return error return-value
     5308    :
     5309    define input parameter  p-val as character no-undo .
     5310    define input parameter  p-row as integer no-undo .
     5311    define input parameter  p-col as integer no-undo .
     5312    if p-val = ? then p-val = "" .
     5313       put stream macr_excel unformatted
     5314             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     5315    end.
     5316   end procedure.
     5317   procedure macr_excel_char_with_format :
     5318    do
     5319    on error undo, return error return-value
     5320    :
     5321    define input parameter  p-val as character no-undo .
     5322    define input parameter  p-row as integer no-undo .
     5323    define input parameter  p-col as integer no-undo .
     5324    if p-val = ? then p-val = "" .
     5325       put stream macr_excel unformatted
     5326             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     5327       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     5328       put stream macr_excel unformatted
     5329             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     5330    end.
     5331   end procedure.
     5332   procedure macr_excel_cell_format :
     5333    do
     5334    on error undo, return error return-value
     5335    :
     5336    define input parameter  p-val    as character no-undo .
     5337    define input parameter  p-row    as integer   no-undo .
     5338    define input parameter  p-col    as integer   no-undo .
     5339    define input parameter  p-format as character no-undo .
     5340    if p-val = ? then p-val = "" .
     5341       put stream macr_excel unformatted
     5342             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     5343       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     5344       put stream macr_excel unformatted
     5345             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     5346    end.
     5347   end procedure.
     5348   procedure macr_excel_sum :
     5349    do
     5350    on error undo, return error return-value
     5351    :
     5352    define input parameter  p-row as integer no-undo .
     5353    define input parameter  p-col as integer no-undo .
     5354    define input parameter  p-row1 as integer no-undo .
     5355    define input parameter  p-col1 as integer no-undo .
     5356    define input parameter  p-row2 as integer no-undo .
     5357    define input parameter  p-col2 as integer no-undo .
     5358       put stream macr_excel unformatted
     5359             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     5360    end.
     5361   end procedure.
     5362   procedure macr_excel_dec :
     5363    do
     5364    on error undo, return error return-value
     5365    :
     5366    define input parameter  p-val as character no-undo .
     5367    define input parameter  p-row as integer   no-undo .
     5368    define input parameter  p-col as integer   no-undo .
     5369     if p-val = ? then p-val =  "" .
     5370      put  stream macr_excel unformatted
     5371           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     5372    end.
     5373   end procedure.
     5374   procedure macr_cell_format :
     5375    do
     5376    on error undo, return error return-value
     5377    :
     5378    define input parameter  p-size   as integer   no-undo .
     5379    define input parameter  p-bold   as logical   no-undo .
     5380    define input parameter  p-italic as logical   no-undo .
     5381    define input parameter  p-color  as integer   no-undo .
     5382    define input parameter  p-row    as integer   no-undo .
     5383    define input parameter  p-col    as integer   no-undo .
     5384    define input parameter  p-row-2  as integer   no-undo .
     5385    define input parameter  p-col-2  as integer   no-undo .
     5386     if p-size = ? then p-size = 10 .
     5387     if p-bold = ? then p-bold = false .
     5388     if p-italic = ? then p-italic = false .
     5389     if p-row-2 = ? then p-row-2 = p-row .
     5390     if p-col-2 = ? then p-col-2 = p-col .
     5391     put  stream macr_excel unformatted
     5392      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     5393     if p-color <> ? then do:
     5394        put  stream macr_excel unformatted
     5395          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     5396     end.
     5397     put  stream macr_excel unformatted
     5398          substitute('format.font(,&1,&2,&3)' , p-size,
     5399                                           string ( p-bold  , "true/false" ) ,
     5400                                           string ( p-italic , "true/false" )
     5401                                           ) + chr(10) .
     5402    end.
     5403   end procedure.
     5404   procedure macr_cell_size :
     5405    do
     5406    on error undo, return error return-value
     5407    :
     5408    define input parameter  p-w   as integer   no-undo .
     5409    define input parameter  p-l   as integer   no-undo .
     5410    define input parameter  p-row    as integer   no-undo .
     5411    define input parameter  p-col    as integer   no-undo .
     5412    define input parameter  p-row-2  as integer   no-undo .
     5413    define input parameter  p-col-2  as integer   no-undo .
     5414     if p-row-2 = ? then p-row-2 = p-row .
     5415     if p-col-2 = ? then p-col-2 = p-col .
     5416     if p-w = ? then    p-w = 0 .
     5417     if p-l = ? then    p-l = 0 .
     5418    define variable s-w as character no-undo .
     5419    define variable s-l as character no-undo .
     5420    if p-w = 0 then s-w = "" .
     5421               else s-w = string(p-w)  .
     5422    if p-l = 0 then s-l = "" .
     5423               else s-l = string(p-l)  .
     5424   put  stream macr_excel unformatted
     5425        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     5426   put  stream macr_excel unformatted
     5427        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     5428   put  stream macr_excel unformatted
     5429        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     5430    end.
     5431   end procedure.
     5432   procedure proc-print-header :
     5433    do
     5434    on error undo, return error return-value
     5435    :
     5436      find first sheetf .
     5437        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     5438        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     5439        var-1 =  num#str# .
     5440        repeat c-c = 1 to sheetf.excel-row-title :
     5441        num#str# = num#str# + 1 .
     5442        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     5443        do c-i = 1 to p-var :
     5444           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     5445           str--2 = integer(entry( c-i, sheetf.sizes )) .
     5446           num#col# = c-i .
     5447           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     5448           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     5449        end.
     5450       c-i = 0.
     5451       end.
     5452       run macr_cell_format (
     5453           10       ,
     5454           true     ,
     5455           false    ,
     5456           35       ,
     5457           var-1 + 1,
     5458           1        ,
     5459           num#str# ,
     5460           num#col# )
     5461           .
     5462     put  stream macr_excel unformatted
     5463          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     5464          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     5465          .
     5466    end.
     5467   end procedure.
     5468   procedure end-proc :
     5469    do
     5470    on error undo, return error return-value
     5471    :
     5472     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     5473     OUTPUT to VALUE (v-file-name) .
     5474     for each temp-param :
     5475       export  temp-param  .
     5476     end.
     5477    end.
     5478   end procedure.
