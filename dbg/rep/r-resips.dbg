     1852       or p-other-base     = ?
     1853       or p-other-rubl     = ?
     1854       or p-excise-base    = ?
     1855       or p-excise-rubl    = ?
     1856       then do:
     1857         message
     1858           vss-workfile vss-revision vss-description skip
     1859           vss-include-info17 skip
     1860           "Программа in-vatp.i вернула неопределенные значения" skip
     1861           "p-fact-qnty"      p-fact-qnty      skip
     1862           "p-sum-base"       p-sum-base       skip
     1863           "p-sum-rubl"       p-sum-rubl       skip
     1864           "p-vat-base"       p-vat-base       skip
     1865           "p-vat-rubl"       p-vat-rubl       skip
     1866           "p-slt-base"       p-slt-base       skip
     1867           "p-slt-rubl"       p-slt-rubl       skip
     1868           "p-road-tax-base"  p-road-tax-base  skip
     1869           "p-road-tax-rubl"  p-road-tax-rubl  skip
     1870           "p-transport-base" p-transport-base skip
     1871           "p-transport-rubl" p-transport-rubl skip
     1872           "p-other-base"     p-other-base     skip
     1873           "p-other-rubl"     p-other-rubl     skip
     1874           "p-excise-base"    p-excise-base    skip
     1875           "p-excise-rubl"    p-excise-rubl    skip
     1876           view-as alert-box error .
     1877         undo, return error .
     1878       end.
     1879     end.
     1880   end procedure.
