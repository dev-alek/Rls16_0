      970   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      971   procedure paramls-clear :
      972     define buffer buf_temp-param for temp-param .
      973     do
      974     on error undo, return error return-value
      975     :
      976       for each buf_temp-param
      977       on error undo, return error
      978       :
      979         delete buf_temp-param .
      980       end.
      981     end.
      982   end procedure.
      983   procedure paramls-write :
      984     define input  parameter p-code     as character no-undo .
      985     define input  parameter p-sub-code as character no-undo .
      986     define input  parameter p-value    as character no-undo .
      987     define buffer buf_temp-param for temp-param .
      988     do
      989     on error undo, return error return-value
      990     :
      991       find first buf_temp-param
      992         where buf_temp-param.param-code     = p-code
      993           and buf_temp-param.param-sub-code = p-sub-code
      994         no-error .
      995       if not available buf_temp-param then do:
      996         create buf_temp-param .
      997         assign
      998           buf_temp-param.param-code     = p-code
      999           buf_temp-param.param-sub-code = p-sub-code
     1000         .
     1001       end.
     1002       assign
     1003         buf_temp-param.param-value = p-value
     1004       .
     1005     end.
     1006   end procedure.
     1007   procedure paramls-read :
     1008     define input  parameter p-code          as character no-undo .
     1009     define input  parameter p-sub-code      as character no-undo .
     1010     define input  parameter p-default-value as character no-undo .
     1011     define output parameter p-value         as character no-undo .
     1012     define buffer buf_temp-param for temp-param .
     1013     do
     1014     on error undo, return error return-value
     1015     :
     1016       find first buf_temp-param
     1017         where buf_temp-param.param-code     = p-code
     1018           and buf_temp-param.param-sub-code = p-sub-code
     1019         no-error .
     1020       if available buf_temp-param then do:
     1021         assign
     1022           p-value = buf_temp-param.param-value
     1023         .
     1024       end.
     1025       else do:
     1026         assign
     1027           p-value = p-default-value
     1028         .
     1029       end.
     1030     end.
     1031   end procedure.
     1032   procedure paramls-append :
     1033     define input  parameter p-code     as character no-undo .
     1034     define input  parameter p-sub-code as character no-undo .
     1035     define input  parameter p-value    as character no-undo .
     1036     define buffer buf_temp-param for temp-param .
     1037     do
     1038     on error undo, return error return-value
     1039     :
     1040       find first buf_temp-param
     1041            where buf_temp-param.param-code     = p-code
     1042              and buf_temp-param.param-sub-code = p-sub-code
     1043         no-error .
     1044       if not available buf_temp-param then do:
     1045         create buf_temp-param .
     1046         assign
     1047           buf_temp-param.param-code     = p-code
     1048           buf_temp-param.param-sub-code = p-sub-code
     1049           buf_temp-param.param-value    = p-value
     1050         .
     1051       end.
     1052       else do:
