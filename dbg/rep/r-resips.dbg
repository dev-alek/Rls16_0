     1318             vss-workfile vss-revision vss-description skip
     1319             vss-include-info17 skip
     1320             "Невозможно найти товар на объекте" skip
     1321             "Объект" p-obj-type p-obj-code skip
     1322             "Артикул" p-artic p-prod-type p-prod-code skip
     1323             error-status :get-message(1) skip
     1324             return-value skip
     1325             view-as alert-box error .
     1326           undo, return error .
     1327         end.
     1328         find current buf_gds-obj exclusive-lock .
     1329       end.
     1330       run partslib-init-temp-parts in this-procedure
     1331         (input p-obj-type
     1332         ,input p-obj-code
     1333         ,input p-artic
     1334         ,input p-prod-type
     1335         ,input p-prod-code
     1336         ) no-error .
     1337       if error-status :error
     1338       then do:
     1339         message
     1340           vss-workfile vss-revision vss-description skip
     1341           vss-include-info17 skip
     1342           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
     1343           "Объект" p-obj-type p-obj-code skip
     1344           "Артикул" p-artic p-prod-type p-prod-code skip
     1345           "p-fact-order" p-fact-order skip
     1346           view-as alert-box error .
     1347         undo, return error .
     1348       end.
     1349       if p-include-fact-order = true
     1350       then do:
     1351         assign
     1352           p-fact-order = p-fact-order - 0.0000000001
     1353         .
     1354       end.
     1355       define variable v-max-fact-order as character no-undo .
     1356       run factord-max-fact-order in this-procedure
     1357         (output v-max-fact-order
     1358         ) no-error .
     1359       if error-status :error
     1360       then do:
     1361         message
     1362           vss-workfile vss-revision vss-description skip
     1363           vss-include-info17 skip
     1364           "Ошибка при вызове процедуры factord-max-fact-order" skip
     1365           "Объект" p-obj-type p-obj-code skip
     1366           "Артикул" p-artic p-prod-type p-prod-code skip
     1367           "p-fact-order" p-fact-order skip
     1368           view-as alert-box error .
     1369         undo, return error .
     1370       end.
     1371       run partslib-update-by-factord in this-procedure
     1372         (input p-obj-type
     1373         ,input p-obj-code
     1374         ,input p-artic
     1375         ,input p-prod-type
     1376         ,input p-prod-code
     1377         ,input p-fact-order
     1378         ,input v-max-fact-order
     1379         ,input false
     1380         ) no-error .
     1381       if error-status :error
     1382       then do:
     1383         message
     1384           vss-workfile vss-revision vss-description skip
     1385           vss-include-info17 skip
     1386           "Ошибка при вызове процедуры partslib-update-by-factord" skip
