       67   def
       68    shared
       69   temp-table  obj-list no-undo
       70     field obj-type like ub.clients.obj-type
       71     field obj-code like ub.clients.obj-code
       72     field obj-name like ub.clients.obj-name
       73     field obj-id   as integer
