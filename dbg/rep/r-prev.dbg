       78   .
       79   procedure create_obj-list :
       80      define input parameter p-obj-type like ub.clients.obj-type no-undo .
       81      define input parameter p-obj-code like ub.clients.obj-code no-undo .
       82      do
       83      on error undo, return error return-value
       84      :
       85         define buffer cli-obj for ub.clients .
       86         define variable p-var as integer no-undo .
       87         define buffer buf_obj-list for obj-list .
       88         find last buf_obj-list  use-index pi no-error .
       89         if available buf_obj-list
       90         then
       91            p-var = buf_obj-list.obj-id + 1.
       92         else
       93            p-var = 1.
       94         find first cli-obj where
       95                   cli-obj.obj-type = p-obj-type
       96               and cli-obj.obj-code = p-obj-code
       97         no-lock no-error.
       98         if available cli-obj
       99         then do:
      100            create buf_obj-list.
      101            assign
      102               buf_obj-list.obj-id   = p-var
      103               buf_obj-list.obj-code = cli-obj.obj-code
      104               buf_obj-list.obj-type = cli-obj.obj-type
      105               buf_obj-list.obj-name = cli-obj.obj-name
      106               buf_obj-list.db-num   = cli-obj.db-num
      107            .
      108         end.
      109      end.
      110   end.
