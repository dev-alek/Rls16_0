      498     Col-name[255]=   'IU':U
      499     Col-name[256]=   'IV':U
      500     .
      501    end.
      502   end procedure.
      503   define new global shared variable g#library  as handle no-undo .
      504   define new global shared variable g#library2 as handle no-undo .
      505   define variable var-report-r-b as character no-undo .
      506   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      507   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      508     (output var-report-r-b
      509     )  .
      510   procedure proc-alt-shift-f2:
      511     if not ibs.th.gbl.gbl-var:rcode
      512   then
      513     run gbl\inidebug.p .
      514   end.
      515   procedure proc-alt-shift-f3:
      516     run gbl/prvssinf.p
      517       ( input this-procedure
      518       ) .
      519   end.
      520   define variable v-inform-launched as logical no-undo initial false .
      521   procedure proc-alt-shift-f4:
      522     define variable v-action as character no-undo .
      523     if v-inform-launched = false then do:
      524       assign
      525         v-inform-launched = true
      526       .
      527       run gbl/d-inform.w
      528         (  input self
      529         ,  input this-procedure
      530         , output v-action
      531         ) no-error .
      532       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      533       assign
      534         v-inform-launched = false
      535       .
      536     end.
      537   end.
      538   procedure proc-alt-f1:
      539     run gbl/corrhelp.p
      540       (input this-procedure
      541       ) .
      542   end .
      543   on alt-shift-f2 anywhere do:
      544     run proc-alt-shift-f2.
      545   end.
      546   on alt-shift-f3 anywhere do:
      547     run proc-alt-shift-f3 in this-procedure .
      548   end.
      549   on alt-shift-f4 anywhere do:
      550     run proc-alt-shift-f4 in this-procedure.
      551   end.
      552   on alt-f1 anywhere do:
      553     run proc-alt-f1 in this-procedure .
      554   end.
      555   DEFINE BUTTON b-exit AUTO-END-KEY
      556        LABEL "Выход"
      557        SIZE 15 BY 1.13
      558        BGCOLOR 8 .
      559   DEFINE BUTTON b-help
      560        LABEL "Помо&щь"
      561        SIZE 15 BY 1.13
      562        BGCOLOR 8 .
      563   DEFINE VARIABLE Report-preview AS CHARACTER
      564        VIEW-AS EDITOR NO-WORD-WRAP SCROLLBAR-HORIZONTAL SCROLLBAR-VERTICAL
      565        SIZE 84.75 BY 10.29
      566        FONT 4 NO-UNDO.
      567   DEFINE FRAME t-title
      568        b-exit AT ROW 1.21 COL 2
      569        b-help AT ROW 1.21 COL 70.63
      570        Report-preview AT ROW 2.54 COL 1.25 NO-LABEL
      571        SPACE(0.24) SKIP(0.04)
      572       WITH CENTERED VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      573            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      574            TITLE "Предварительный просмотр отчета"
      575            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-exit.
      576   ASSIGN
      577          FRAME t-title:SCROLLABLE       = FALSE
      578          FRAME t-title:HIDDEN           = TRUE.
      579   ASSIGN
      580          Report-preview:READ-ONLY IN FRAME t-title        = TRUE.
      581   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      582   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      583   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      584   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      585   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      586   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      587   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      588   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      589       ASSIGN adm-object-hdl = FRAME t-title:HANDLE.
      590   RUN ensure-broker.
      591   THIS-PROCEDURE:ADM-DATA =
      592        'ADM1.1~`':U +
      593        'SmartDialog~`':U +
      594        'DIALOG-BOX~`':U +
      595        'NO ~`':U +
      596        '~`':U +
      597        '~`':U +
      598        '~`':U +
      599        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      600           + "~`":U +
      601        'Layout,Hide-on-Init~`':U +
      602        '~`':U +
      603        '~`':U +
      604        '~`~`~`~`~`~`~`~`~`~`~`':U +
      605        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      606            THEN "^^":U
      607        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      608             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      609   PROCEDURE adm-apply-entry :
      610     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      611   END PROCEDURE.
      612   PROCEDURE adm-destroy :
      613    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      614   END PROCEDURE.
      615   PROCEDURE adm-disable :
      616       DISABLE b-exit b-help Report-preview WITH FRAME t-title.
      617       RUN dispatch ('disable-fields':U).
      618       RUN set-attribute-list ('ENABLED=no':U).
      619       RETURN.
      620   END PROCEDURE.
      621   PROCEDURE adm-edit-attribute-list :
      622         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
      623         RETURN.
      624   END PROCEDURE.
      625   PROCEDURE adm-enable :
      626       ENABLE UNLESS-HIDDEN b-exit b-help Report-preview WITH FRAME t-title.
      627       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      628       RUN set-attribute-list ('ENABLED=yes':U).
      629       RETURN.
      630   END PROCEDURE.
      631   PROCEDURE adm-exit :
      632        RUN notify ('exit':U).
      633     RETURN.
      634   END PROCEDURE.
      635   PROCEDURE adm-hide :
      636     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      637   END PROCEDURE.
      638   PROCEDURE adm-initialize :
      639     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      640   END PROCEDURE.
      641   PROCEDURE adm-show-errors :
      642       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      643       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      644           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      645       END.
      646       RETURN.
      647   END PROCEDURE.
      648   PROCEDURE adm-UIB-mode :
      649     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      650   END PROCEDURE.
      651   PROCEDURE adm-view :
      652     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      653   END PROCEDURE.
      654   PROCEDURE dispatch :
      655       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      656       RUN broker-dispatch IN adm-broker-hdl
      657           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      658       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      659   END PROCEDURE.
      660   PROCEDURE ensure-broker :
      661   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      662   IF RETURN-VALUE NE "ADM-Broker":U THEN
      663   DO:
      664       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      665       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      666   END.
      667   END PROCEDURE.
      668   PROCEDURE get-attribute :
      669     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      670     RUN broker-get-attribute IN adm-broker-hdl
      671         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      672     RETURN RETURN-VALUE.
      673   END PROCEDURE.
      674   PROCEDURE get-attribute-list :
      675     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      676     RUN broker-get-attribute-list IN adm-broker-hdl
      677         (INPUT THIS-PROCEDURE,
      678          INPUT ?,
      679          OUTPUT p-attr-list) NO-ERROR.
      680     RETURN.
      681   END PROCEDURE.
      682   PROCEDURE new-state :
      683     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      684     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      685     RETURN.
      686   END PROCEDURE.
      687   PROCEDURE notify :
      688     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      689     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      690     IF RETURN-VALUE = "ADM-ERROR":U THEN
      691         RETURN "ADM-ERROR":U.
      692     RETURN.
      693   END PROCEDURE.
      694   PROCEDURE set-attribute-list :
      695     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      696     RUN ensure-broker.
      697     RUN broker-set-attribute-list IN adm-broker-hdl
      698         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      699     RETURN.
      700   END PROCEDURE.
      701   PROCEDURE set-position :
      702       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      703       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      704       IF VALID-HANDLE(adm-object-hdl) THEN
      705       DO:
      706           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
      707           IF adm-object-hdl:TYPE = "WINDOW":U THEN
      708           DO:
      709             IF p-row = 0 THEN p-row =
      710               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
      711             IF p-col = 0 THEN p-col =
      712               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
      713           END.
      714           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
      715           DO:
      716             parent-hdl = adm-object-hdl:PARENT.
      717             IF p-row = 0 THEN p-row =
      718               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
      719                 parent-hdl:ROW.
      720             IF p-col = 0 THEN p-col =
      721               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
      722                 parent-hdl:COL.
      723           END.
      724           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
      725           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
      726         ASSIGN adm-object-hdl:ROW    =   p-row
      727                adm-object-hdl:COLUMN =   p-col.
      728       END.
      729       RETURN.
      730   END PROCEDURE.
      731   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
      732       STRING(adm-object-hdl)).
      733   PAUSE 0 BEFORE-HIDE.
      734   PROCEDURE adm-change-page :
      735     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
      736     END PROCEDURE.
      737   PROCEDURE delete-page :
      738     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
      739     RUN broker-delete-page IN adm-broker-hdl
      740         (INPUT THIS-PROCEDURE, INPUT p-page#).
      741     END PROCEDURE.
      742   PROCEDURE init-object :
      743     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
      744     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
      745     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
      746     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
      747     RUN broker-init-object IN adm-broker-hdl
      748         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
      749          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
      750     RETURN.
      751   END PROCEDURE.
      752   PROCEDURE init-pages :
      753     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
      754     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      755         INPUT p-page-list) NO-ERROR.
      756     END PROCEDURE.
      757   PROCEDURE select-page :
      758     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
      759     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      760         INPUT p-page#) NO-ERROR.
      761     END PROCEDURE.
      762   PROCEDURE view-page :
      763     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
      764     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      765         INPUT p-page#).
      766     END PROCEDURE.
      767   ON WINDOW-CLOSE OF FRAME t-title
      768   DO:
      769     APPLY "END-ERROR":U TO SELF.
      770   END.
      771   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      772   on help of frame t-title
      773   do:
      774     run gbl/app_help.p
      775       (input this-procedure :file-name
      776       ,input ''
      777       ,input ?
      778       ) no-error.
      779     if error-status :error then do:
      780       message
      781         "Ошибка при вызове помощи"
      782         error-status :get-message(1)
      783         view-as alert-box .
      784     end.
      785   end.
      786   run minbtn-set in this-procedure .
      787   on choose of b-help in frame t-title
      788   do:
      789     apply "help":u to frame t-title .
      790   end.
      791   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      792   procedure minbtn-set :
      793       do
      794           on error undo, return error return-value
      795           :
      796           define variable ii              as integer       no-undo .
      797           define variable fh              as widget-handle no-undo .
      798           define variable hh              as widget-handle no-undo .
      799           define variable v-h             as handle        extent 4 no-undo .
      800           define variable v-name-button   as character     no-undo .
      801           define variable v-help-old-x    as decimal       no-undo .
      802           define variable v-help-old-y    as decimal       no-undo .
      803           define variable v-help-old-size as decimal       no-undo .
      804           define variable v-frame-width   as decimal       no-undo .
      805           define variable jj              as integer       no-undo .
      806           do
      807               on error undo, return error
      808               :
      809               assign
      810                   v-frame-width = frame t-title:width - 0.3
      811                   fh            = frame t-title:first-child
      812                   hh            = fh:first-child
      813                   ii            = 1
      814                   .
      815               do while valid-handle(hh):
      816                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      817                   do:
      818                       case lc(hh:name) :
      819                           when "b-help" then
      820                               do:
      821                                   hh:load-image-up("cmp/b-help.bmp":u) .
      822                                   hh:load-image-down("cmp/b-help.bmp":u) .
      823                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      824                                   hh:TOOLTIP = "Помощь" .
      825                                   v-help-old-x = hh:column .
      826                                   v-help-old-y = hh:row    .
      827                                   v-help-old-size = hh:width .
      828                                   hh:width-chars = 2.5 .
      829                               end.
      830                           when "b-print" then
      831                               do:
      832                                   hh:load-image("cmp/b-print.bmp":u) .
      833                                   hh:TOOLTIP = "Печать" .
      834                                   v-h[ii] = hh:handle .
      835                                   ii = ii + 1 .
      836                                   hh:width-chars = 3 .
      837                               end.
      838                           when "b-history" or
      839                           when "b-hist" then
      840                               do:
      841                                   hh:load-image("cmp/b-hist.bmp":u) .
      842                                   hh:TOOLTIP = "История" .
      843                                   v-h[ii] = hh:handle .
      844                                   ii = ii + 1 .
      845                                   hh:width-chars = 3 .
      846                               end.
      847                           when "b-sch" then
      848                               do:
      849                                   hh:load-image("cmp/b-sch.bmp":u) .
      850                                   hh:TOOLTIP = "Установка Фильтра" .
      851                                   v-h[ii] = hh:handle .
      852                                   ii = ii + 1 .
      853                                   hh:width-chars = 3 .
      854                               end.
      855                           when "b-hist-user" then
      856                               do:
      857                                   hh:load-image("cmp/b-hist.bmp":u) .
      858                                   hh:TOOLTIP = "История пользователя" .
      859                                   ii = ii + 1 .
      860                               end.
      861                       end case.
      862                   end.
      863                   hh = hh:next-sibling.
      864               end.
      865               b-help:column = v-frame-width - b-help:width-chars.
      866               jj = 0.
      867               repeat ii = 4 to 1 by -1 :
      868                   if valid-handle (v-h[ii] ) then
      869                   do:
      870                       jj  = jj + 1 .
      871                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      872                       v-h[ii]:row    = v-help-old-y .
      873                   end.
      874               end.
      875           end.
      876       end.
      877   end procedure.
      878   IF THIS-PROCEDURE:PERSISTENT THEN DO:
      879       MESSAGE "A SmartDialog is not intended ":U SKIP
      880               "to be run Persistent or to be placed ":U SKIP
      881               "in another SmartObject at UIB design time.":U
      882               VIEW-AS ALERT-BOX ERROR.
      883       RUN disable_UI.
      884       DELETE PROCEDURE THIS-PROCEDURE.
      885       RETURN.
      886   END.
      887   RUN dispatch ('create-objects':U).
      888   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME t-title:PARENT eq ?
      889   THEN FRAME t-title:PARENT = ACTIVE-WINDOW.
      890   MAIN-BLOCK:
      891   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      892      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      893     RUN dispatch IN THIS-PROCEDURE ('initialize':U).
      894     WAIT-FOR GO OF FRAME t-title.
      895   END.
      896   RUN dispatch IN THIS-PROCEDURE ('destroy':U).
      897   PROCEDURE adm-create-objects :
      898   END PROCEDURE.
      899   PROCEDURE adm-row-available :
      900     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
      901     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
      902     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
      903     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
      904     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
      905     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
      906     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
      907     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
      908     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
      909     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
      910     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
      911     IF adm-updating-record THEN RETURN.
      912     RUN get-attribute ('FIELDS-ENABLED':U).
      913     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
      914     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
      915         OUTPUT link-handle) NO-ERROR.
      916     IF link-handle = "":U THEN
      917         RETURN.
      918     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
      919     IF NUM-ENTRIES(link-handle) > 1 THEN
      920         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
      921             "encountered more than one RECORD-SOURCE.":U SKIP
      922             "The first - ":U record-source-hdl:file-name " - will be used.":U
      923                VIEW-AS ALERT-BOX ERROR.
      924     RUN get-attribute ('Key-Name':U).
      925     key-name = RETURN-VALUE.
      926     IF key-name = "":U THEN key-name = ?.
      927     IF key-name NE ? THEN DO:
      928       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
      929         NO-ERROR.
      930       IF key-value NE ? THEN
      931         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
      932     END.
      933   IF VALID-HANDLE (adm-object-hdl) THEN
      934       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      935   RUN notify IN THIS-PROCEDURE ('row-available':U).
      936   END PROCEDURE.
      937   PROCEDURE disable_UI :
      938     HIDE FRAME t-title.
      939   END PROCEDURE.
      940   PROCEDURE enable_UI :
      941     DISPLAY Report-preview
      942         WITH FRAME t-title.
      943     ENABLE b-exit b-help Report-preview
      944         WITH FRAME t-title.
      945     VIEW FRAME t-title.
      946   END PROCEDURE.
      947   PROCEDURE local-initialize :
      948     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
      949   Report-preview = reportNAme + chr(10)
      950                   +  str1 + chr(10)
      951                   + str2 + chr(10)
      952                   + str3 + chr(10)
      953                   + str4 + chr(10)
      954                   + ReportHeader.
      955   display Report-preview with frame t-title.
      956   END PROCEDURE.
      957   PROCEDURE send-records :
      958   END PROCEDURE.
      959   PROCEDURE state-changed :
      960     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
      961     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      962   END PROCEDURE.
