     1563       .
     1564   DEFINE FRAME TopsF
     1565   tops.sale-date column-label "Дата " format "99.99.99"
     1566   tops.shift-name column-label "Смена" format "X(2)"
     1567   tops.gds-code column-label "Код топлива" forMAT ">>>>>>>>>9"
     1568   tops.gds-name column-label "Топливо" format "X(25)"
     1569   tops.qnty column-label "Кол-во"
     1570   tops.tot-r-b column-label "Сумма брутто" format "->>>,>>>,>>9.99"
     1571   tops.discnt-r-b column-label "Сумма скидок" format "->>>,>>>,>>9.99"
     1572   for-netto column-label "Сумма нетто" format "->>>,>>>,>>9.99"
     1573   tops.pl-code column-label "Танк"
     1574   tops.doc-code column-label "Док-нт"
     1575   tops.doc-type column-label "Тип док."
     1576   HEADER  date_string format "X(35)" AT 5
     1577   v-header-base-curr        format "X(20)" AT 42
     1578   "Страница " AT 65 PAGE-NUMBER( PrnLibStream )  AT 75 FORMAT ">>9" SKIP
     1579   Line format "X(82)" AT 1
     1580   with width 232 down stream-io use-text .
     1581   DEFINE VARIABLE RS-By AS INTEGER INITIAL 1
     1582        VIEW-AS RADIO-SET VERTICAL
     1583        RADIO-BUTTONS
     1584             "Без разбиения по бакам и документам", 0,
     1585   "C разбиением по бакам и документам", 1
     1586        SIZE 38.5 BY 1.79 NO-UNDO.
     1587   DEFINE FRAME F-Main
     1588        RS-By AT ROW 2.79 COL 1 NO-LABEL
     1589       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1590            SIDE-LABELS NO-UNDERLINE THREE-D
     1591            AT COL 1 ROW 1
     1592            SIZE 38.63 BY 11.88.
     1593   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1594   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1595   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1596   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1597   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1598   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1599   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1600   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1601       ASSIGN adm-object-hdl = FRAME F-Main:HANDLE.
     1602   RUN ensure-broker.
     1603   THIS-PROCEDURE:ADM-DATA =
     1604        'ADM1.1~`':U +
     1605        'SmartObject~`':U +
     1606        'FRAME~`':U +
     1607        'NO ~`':U +
     1608        '~`':U +
     1609        '~`':U +
     1610        '~`':U +
     1611        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1612           + "~`":U +
     1613        'Layout,Hide-on-Init~`':U +
     1614        '~`':U +
     1615        '~`':U +
     1616        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1617        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1618            THEN "^^":U
     1619        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1620             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1621   PROCEDURE adm-apply-entry :
     1622     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1623   END PROCEDURE.
     1624   PROCEDURE adm-destroy :
     1625    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1626   END PROCEDURE.
     1627   PROCEDURE adm-disable :
     1628       DISABLE RS-By WITH FRAME F-Main.
     1629       RUN dispatch ('disable-fields':U).
     1630       RUN set-attribute-list ('ENABLED=no':U).
     1631       RETURN.
     1632   END PROCEDURE.
     1633   PROCEDURE adm-edit-attribute-list :
     1634         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
     1635         RETURN.
     1636   END PROCEDURE.
     1637   PROCEDURE adm-enable :
     1638       ENABLE UNLESS-HIDDEN RS-By WITH FRAME F-Main.
     1639       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1640       RUN set-attribute-list ('ENABLED=yes':U).
     1641       RETURN.
     1642   END PROCEDURE.
     1643   PROCEDURE adm-exit :
     1644        RUN notify ('exit':U).
     1645     RETURN.
     1646   END PROCEDURE.
     1647   PROCEDURE adm-hide :
     1648     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1649   END PROCEDURE.
     1650   PROCEDURE adm-initialize :
     1651     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1652   END PROCEDURE.
     1653   PROCEDURE adm-show-errors :
     1654       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1655       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1656           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1657       END.
     1658       RETURN.
     1659   END PROCEDURE.
     1660   PROCEDURE adm-UIB-mode :
     1661     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1662   END PROCEDURE.
     1663   PROCEDURE adm-view :
     1664     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1665   END PROCEDURE.
     1666   PROCEDURE dispatch :
     1667       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1668       RUN broker-dispatch IN adm-broker-hdl
     1669           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1670       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1671   END PROCEDURE.
     1672   PROCEDURE ensure-broker :
     1673   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1674   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1675   DO:
     1676       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1677       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1678   END.
     1679   END PROCEDURE.
     1680   PROCEDURE get-attribute :
     1681     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1682     RUN broker-get-attribute IN adm-broker-hdl
     1683         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1684     RETURN RETURN-VALUE.
     1685   END PROCEDURE.
     1686   PROCEDURE get-attribute-list :
     1687     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1688     RUN broker-get-attribute-list IN adm-broker-hdl
     1689         (INPUT THIS-PROCEDURE,
     1690          INPUT ?,
     1691          OUTPUT p-attr-list) NO-ERROR.
     1692     RETURN.
     1693   END PROCEDURE.
     1694   PROCEDURE new-state :
     1695     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1696     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1697     RETURN.
     1698   END PROCEDURE.
     1699   PROCEDURE notify :
     1700     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1701     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1702     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1703         RETURN "ADM-ERROR":U.
     1704     RETURN.
     1705   END PROCEDURE.
     1706   PROCEDURE set-attribute-list :
     1707     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1708     RUN ensure-broker.
     1709     RUN broker-set-attribute-list IN adm-broker-hdl
     1710         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1711     RETURN.
     1712   END PROCEDURE.
     1713   PROCEDURE set-position :
     1714       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1715       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1716       IF VALID-HANDLE(adm-object-hdl) THEN
     1717       DO:
     1718           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     1719           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     1720           DO:
     1721             IF p-row = 0 THEN p-row =
     1722               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     1723             IF p-col = 0 THEN p-col =
     1724               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     1725           END.
     1726           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     1727           DO:
     1728             parent-hdl = adm-object-hdl:PARENT.
     1729             IF p-row = 0 THEN p-row =
     1730               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     1731                 parent-hdl:ROW.
     1732             IF p-col = 0 THEN p-col =
     1733               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     1734                 parent-hdl:COL.
     1735           END.
     1736           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     1737           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     1738         ASSIGN adm-object-hdl:ROW    =   p-row
     1739                adm-object-hdl:COLUMN =   p-col.
     1740       END.
     1741       RETURN.
     1742   END PROCEDURE.
     1743   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
     1744       STRING(adm-object-hdl)).
     1745   PAUSE 0 BEFORE-HIDE.
     1746   PROCEDURE adm-change-page :
     1747     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
     1748     END PROCEDURE.
     1749   PROCEDURE delete-page :
     1750     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
     1751     RUN broker-delete-page IN adm-broker-hdl
     1752         (INPUT THIS-PROCEDURE, INPUT p-page#).
     1753     END PROCEDURE.
     1754   PROCEDURE init-object :
     1755     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
     1756     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
     1757     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
     1758     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
     1759     RUN broker-init-object IN adm-broker-hdl
     1760         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
     1761          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
     1762     RETURN.
     1763   END PROCEDURE.
     1764   PROCEDURE init-pages :
     1765     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
     1766     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1767         INPUT p-page-list) NO-ERROR.
     1768     END PROCEDURE.
     1769   PROCEDURE select-page :
     1770     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
     1771     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1772         INPUT p-page#) NO-ERROR.
     1773     END PROCEDURE.
     1774   PROCEDURE view-page :
     1775     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
     1776     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1777         INPUT p-page#).
     1778     END PROCEDURE.
     1779   if not this-procedure :persistent
     1780   then do:
     1781     message
     1782       vss-workfile vss-revision vss-description skip
     1783       "Ошибка при запуске процедуры" skip
     1784       "Данную процедуру следует запускать только с параметром persistent" skip
     1785       view-as alert-box error .
     1786     undo, return error .
     1787   end.
     1788   PROCEDURE adm-create-objects :
     1789   END PROCEDURE.
     1790   PROCEDURE adm-row-available :
     1791     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1792     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1793     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1794     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1795     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1796     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1797     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1798     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1799     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1800     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1801     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1802     IF adm-updating-record THEN RETURN.
     1803     RUN get-attribute ('FIELDS-ENABLED':U).
     1804     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1805     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1806         OUTPUT link-handle) NO-ERROR.
     1807     IF link-handle = "":U THEN
     1808         RETURN.
     1809     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1810     IF NUM-ENTRIES(link-handle) > 1 THEN
     1811         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1812             "encountered more than one RECORD-SOURCE.":U SKIP
     1813             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1814                VIEW-AS ALERT-BOX ERROR.
     1815     RUN get-attribute ('Key-Name':U).
     1816     key-name = RETURN-VALUE.
     1817     IF key-name = "":U THEN key-name = ?.
     1818     IF key-name NE ? THEN DO:
     1819       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1820         NO-ERROR.
     1821       IF key-value NE ? THEN
     1822         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1823     END.
     1824   IF VALID-HANDLE (adm-object-hdl) THEN
     1825       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1826   RUN notify IN THIS-PROCEDURE ('row-available':U).
     1827   END PROCEDURE.
     1828   PROCEDURE disable_UI :
     1829     HIDE FRAME F-Main.
     1830     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1831   END PROCEDURE.
     1832   PROCEDURE enable_UI :
     1833     DISPLAY RS-By
     1834         WITH FRAME F-Main.
     1835     ENABLE RS-By
     1836         WITH FRAME F-Main.
     1837   END PROCEDURE.
     1838   PROCEDURE My-report :
     1839   assign
     1840   FRAME F-Main RS-BY
     1841   .
     1842   run My-var.
     1843   assign
     1844   date_string = cur-time-print()
     1845   Line = fill( "-", 140 ).
     1846   run waitfram-show in this-procedure ( 'Подождите ...' ) .
     1847   IF RS-By > 0 then HowBreak = YES.
     1848   ELSE HowBreak = No.
     1849   if v-curr-r-b = 'base':U then do:
     1850     sale-price-type = base-type.
     1851   end.
     1852   else do:
     1853     sale-price-type = "рублей".
     1854   end.
     1855   FOR EACH tops:
     1856       delete tops.
     1857   END.
     1858   RUN petnaklq(input X-Radio-Task,
     1859                input shft,
     1860                input X-date-start,
     1861                input X-date-end,
     1862                input X-shift-start,
     1863                input X-shift-end,
     1864                input HowBreak) .
     1865   RUN Print-no-break.
     1866   if return-value = "error" then return.
     1867   run prn-lib-prn-file in this-procedure (
     1868                                             input my-handle
     1869                                             ,input 8
     1870                                             ).
     1871   END PROCEDURE.
     1872   PROCEDURE My-var :
     1873   assign frame F-Main
     1874   RS-by.
     1875   Assign
     1876    STR-obj-type = ''
     1877    STR-obj-code = ''
     1878    STR-obj-name = ''
     1879    STR-obj      = ''.
     1880   For each obj-list no-lock:
     1881    Assign
     1882    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     1883    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     1884    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     1885    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     1886   End.
     1887   ReportNAme = "Расход нефтепродуктов по документам".
     1888   ReportHeader =  radio-label(string(RS-by), RS-by:radio-buttons) .
     1889   END PROCEDURE.
     1890   PROCEDURE petnaklq :
     1891   DEFINE INPUT PARAMETER period-type as integer no-undo.
     1892   DEFINE INPUT PARAMETER shft as logical no-undo.
     1893   DEFINE INPUT PARAMETER X-date-start as date no-undo.
     1894   DEFINE INPUT PARAMETER X-date-end as date no-undo.
     1895   DEFINE INPUT PARAMETER X-shift-start as integer no-undo.
     1896   DEFINE INPUT PARAMETER X-shift-end as integer no-undo.
     1897   DEFINE INPUT PARAMETER HOWBREAK as logical No-undo.
     1898   define variable dt like ub.trn-doc.doc-type no-undo.
     1899   FOR EACH obj-list NO-LOCK :
     1900       ACCUMULATE obj-list.obj-code ( COUNT ) .
     1901           CASE (Period-Type > 1 and shft):
     1902               WHEN yes then do:
     1903                       FOR EACH ub.trn-doc WHERE ub.trn-doc.obj-type = obj-list.obj-type AND
     1904                                                                   ub.trn-doc.obj-code = obj-list.obj-code AND
     1905                                                                   ub.trn-doc.internal = no AND
     1906                                                                     ub.trn-doc.status_ = 'факт':U AND
     1907                                                                      (
     1908                                                                      ub.trn-doc.shift-date >= X-date-start AND
     1909                                                                      ub.trn-doc.shift-date <= X-date-end)
     1910                                                                     NO-LOCK use-index shift:
     1911                              IF Period-Type = 3 AND
     1912                                   ((trn-doc.shift-date = x-date-start AND trn-doc.shift-num < x-shift-start) OR
     1913                                    (trn-doc.shift-date = x-date-end AND  trn-doc.shift-num > x-shift-end) ) THEN NEXT.
     1914                              IF Period-type = 4 AND
     1915                                    trn-doc.shift-num <> X-Shift-Alone then NEXT.
     1916                               IF NOT (trn-doc.doc-type = 'рас':U OR
     1917                                            trn-doc.doc-type = 'спи':U) THEN  NEXT.
     1918                               if trn-doc.ext-doc-type =  'es':U or
     1919                               trn-doc.office
     1920                               then NEXT.
     1921                               if trn-doc.ext-doc-type =  'ep':U then dt = 'возврат пост.':U.
     1922                               else dt = "".
     1923              FOR EACH ub.doc-pl No-LOCK where ub.doc-pl.out-code = ub.trn-doc.doc-code,
     1924                   FIRST ub.goods No-LOCK WHERE ub.goods.gds-code = ub.doc-pl.gds-code,
     1925                   FIRST ub.gds-dtl No-LOCK WHERE ub.gds-dtl.doc-code = ub.trn-doc.doc-code AND
     1926                                                                       ub.gds-dtl.artic = ub.goods.artic AND
     1927                                                                       ub.gds-dtl.prod-type = ub.goods.prod-type AND
     1928                                                                       ub.gds-dtl.prod-code = ub.goods.prod-code:
     1929                   if HOWBREAK then do:
     1930                       FIND FIRST tops WHERE tops.gds-code = ub.goods.gds-code AND
     1931                                                                 tops.obj-type = ub.trn-doc.obj-type AND
     1932                                                                 tops.obj-code = ub.trn-doc.obj-code AND
     1933                                                                 tops.shift-num = ub.trn-doc.shift-num AND
     1934                                                                 tops.sale-date = ub.trn-doc.fact-date AND
     1935                                                                 tops.doc-code  = ub.doc-pl.out-code AND
     1936                                                                 tops.pl-code = ub.doc-pl.pl-code No-ERROR.
     1937                   END.
     1938                   ELSE do:
     1939                       FIND FIRST tops WHERE tops.gds-code = ub.goods.gds-code AND
     1940                                                                 tops.obj-type = "" AND
     1941                                                                 tops.obj-code = 0 AND
     1942                                                                 tops.shift-num = ub.trn-doc.shift-num AND
     1943                                                                 tops.sale-date = ub.trn-doc.doc-date AND
     1944                                                                 tops.pl-code = 0 No-ERROR.
     1945                   END.
     1946                      IF NOT AVAIL tops then do:
     1947                           create tops.
     1948                           assign
     1949                           tops.gds-code = ub.doc-pl.gds-code
     1950                           tops.gds-name = ub.goods.gds-name
     1951                           tops.obj-type = if HowBreak then ub.trn-doc.obj-type else ""
     1952                           tops.obj-code = if HowBreak then ub.trn-doc.obj-code else 0
     1953                           tops.shift-num = ub.trn-doc.shift-num
     1954                           tops.shift-name = ub.trn-doc.shift-name
     1955                           tops.sale-date = ub.trn-doc.doc-date
     1956                           tops.doc-code = if HowBreak then  ub.trn-doc.doc-code else ""
     1957                           tops.doc-type = if HowBreak
     1958                                                     then (if dt = ""
     1959                                                              then ub.trn-doc.doc-type
     1960                                                              else dt)
     1961                                                     else ""
     1962                           tops.pl-code = if HowBreak then ub.doc-pl.pl-code else 0
     1963                           .
     1964                      END.
     1965                      assign
     1966                      tops.qnty = tops.qnty + 1 * ub.doc-pl.fact-qnty
     1967                      tops.tot-r-b = tops.tot-r-b +
     1968                                     (if v-curr-r-b = 'base':U
     1969                                      then ub.gds-dtl.price-base
     1970                                      else ub.gds-dtl.price-rubl ) * 1 * ub.doc-pl.fact-qnty
     1971                      tops.discnt-r-b = tops.discnt-r-b +
     1972                                     (if v-curr-r-b = 'base':U
     1973                                      then ub.gds-dtl.discnt-base
     1974                                      else ub.gds-dtl.discnt-rubl ) *  1 * ub.doc-pl.fact-qnty
     1975                      .
     1976           END.
     1977                       END.
     1978               END.
     1979               WHEN no then do:
     1980                       ACCUMULATE obj-list.obj-code ( COUNT ) .
     1981                       FOR EACH trn-doc WHERE trn-doc.obj-type = obj-list.obj-type AND
     1982                                                                   trn-doc.obj-code = obj-list.obj-code AND
     1983                                                                   trn-doc.internal = no AND
     1984                                                                   trn-doc.status_ = 'факт':U AND
     1985                                                                   trn-doc.fact-date >= x-date-start AND
     1986                                                                   trn-doc.fact-date <= x-date-end
     1987                                                                   NO-LOCK:
     1988                           IF NOT (trn-doc.doc-type = 'рас':U OR
     1989                                        trn-doc.doc-type = 'спи':U) THEN  NEXT.
     1990                            if trn-doc.ext-doc-type = 'es':U OR
     1991                            trn-doc.office
     1992                            then NEXT.
     1993                            if trn-doc.ext-doc-type =  'ep':U then dt = 'возврат пост.':U.
     1994                            else dt = "".
     1995              FOR EACH ub.doc-pl No-LOCK where ub.doc-pl.out-code = ub.trn-doc.doc-code,
     1996                   FIRST ub.goods No-LOCK WHERE ub.goods.gds-code = ub.doc-pl.gds-code,
     1997                   FIRST ub.gds-dtl No-LOCK WHERE ub.gds-dtl.doc-code = ub.trn-doc.doc-code AND
     1998                                                                       ub.gds-dtl.artic = ub.goods.artic AND
     1999                                                                       ub.gds-dtl.prod-type = ub.goods.prod-type AND
     2000                                                                       ub.gds-dtl.prod-code = ub.goods.prod-code:
     2001                   if HOWBREAK then do:
     2002                       FIND FIRST tops WHERE tops.gds-code = ub.goods.gds-code AND
     2003                                                                 tops.obj-type = ub.trn-doc.obj-type AND
     2004                                                                 tops.obj-code = ub.trn-doc.obj-code AND
     2005                                                                 tops.shift-num = ub.trn-doc.shift-num AND
     2006                                                                 tops.sale-date = ub.trn-doc.fact-date AND
     2007                                                                 tops.doc-code  = ub.doc-pl.out-code AND
     2008                                                                 tops.pl-code = ub.doc-pl.pl-code No-ERROR.
     2009                   END.
     2010                   ELSE do:
     2011                       FIND FIRST tops WHERE tops.gds-code = ub.goods.gds-code AND
     2012                                                                 tops.obj-type = "" AND
     2013                                                                 tops.obj-code = 0 AND
     2014                                                                 tops.shift-num = ub.trn-doc.shift-num AND
     2015                                                                 tops.sale-date = ub.trn-doc.doc-date AND
     2016                                                                 tops.pl-code = 0 No-ERROR.
     2017                   END.
     2018                      IF NOT AVAIL tops then do:
     2019                           create tops.
     2020                           assign
     2021                           tops.gds-code = ub.doc-pl.gds-code
     2022                           tops.gds-name = ub.goods.gds-name
     2023                           tops.obj-type = if HowBreak then ub.trn-doc.obj-type else ""
     2024                           tops.obj-code = if HowBreak then ub.trn-doc.obj-code else 0
     2025                           tops.shift-num = ub.trn-doc.shift-num
     2026                           tops.shift-name = ub.trn-doc.shift-name
     2027                           tops.sale-date = ub.trn-doc.doc-date
     2028                           tops.doc-code = if HowBreak then  ub.trn-doc.doc-code else ""
     2029                           tops.doc-type = if HowBreak
     2030                                                     then (if dt = ""
     2031                                                              then ub.trn-doc.doc-type
     2032                                                              else dt)
     2033                                                     else ""
     2034                           tops.pl-code = if HowBreak then ub.doc-pl.pl-code else 0
     2035                           .
     2036                      END.
     2037                      assign
     2038                      tops.qnty = tops.qnty + 1 * ub.doc-pl.fact-qnty
     2039                      tops.tot-r-b = tops.tot-r-b +
     2040                                     (if v-curr-r-b = 'base':U
     2041                                      then ub.gds-dtl.price-base
     2042                                      else ub.gds-dtl.price-rubl ) * 1 * ub.doc-pl.fact-qnty
     2043                      tops.discnt-r-b = tops.discnt-r-b +
     2044                                     (if v-curr-r-b = 'base':U
     2045                                      then ub.gds-dtl.discnt-base
     2046                                      else ub.gds-dtl.discnt-rubl ) *  1 * ub.doc-pl.fact-qnty
     2047                      .
     2048           END.
     2049                       END.
     2050               END.
     2051           END CASE.
     2052   END.
     2053   END PROCEDURE.
     2054   PROCEDURE Print-no-break :
     2055   define variable    acc-qnty-gds  as decimal no-undo.
     2056   define variable    acc-tot-r-b-gds  as decimal no-undo.
     2057   define variable    acc-discnt-r-b-gds  as decimal no-undo.
     2058   define variable    acc-netto-r-b-gds  as decimal no-undo.
     2059   define variable    acc-qnty-obj  as decimal no-undo.
     2060   define variable    acc-tot-r-b-obj  as decimal no-undo.
     2061   define variable    acc-discnt-r-b-obj  as decimal no-undo.
     2062   define variable    acc-netto-r-b-obj  as decimal no-undo.
     2063   define variable    acc-qnty  as decimal no-undo.
     2064   define variable    acc-tot-r-b  as decimal no-undo.
     2065   define variable    acc-discnt-r-b  as decimal no-undo.
     2066   define variable    acc-netto-r-b  as decimal no-undo.
     2067   if NOT can-find(first tops) then do:
     2068       message "Не было расхода топлива на выбранных объектах в течение заданного Вами периода времени."
     2069       view-as alert-box.
     2070       run waitfram-hide in this-procedure .
     2071       return "error".
     2072   end.
     2073   run prn-lib-open-stream  in this-procedure (
     2074                                                input my-handle
     2075                                               ,input 43
     2076                                               ,input yes
     2077                                               ,input no
     2078                                               ).
     2079   FORM HEADER
     2080       Line format "X(136)" AT 1 SKIP
     2081       "Продолжение - на следующей странице" AT 30 SKIP
     2082           with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     2083   VIEW stream PrnLibStream FRAME BottomFrame .
     2084   PUT stream PrnLibStream
     2085   space(5) string( "РАСХОД НЕФТЕПРОДУКТОВ ПО ДОКУМЕНТАМ " + str1) format "X(140)"
     2086   SKIP(0)
     2087   Radio-Label(string(frame F-Main Rs-by), Rs-by:radio-buttons) format "X(40)" skip(0)
     2088   .
     2089   FOR EACH obj-list No-LOCK :
     2090       FIND FIRST ub.clients No-LOCK WHERE ub.clients.obj-type = obj-list.obj-type AND
     2091                                                                        ub.clients.obj-code = obj-list.obj-code No-ERROR.
     2092       PUT STREAM PrnLibStream
     2093       clients.obj-name
     2094       skip(0)
     2095       .
     2096   END.
     2097   PUT stream PrnLibStream skip(1).
     2098   FOR EACH tops No-LOCK break BY tops.obj-type
     2099                                                       BY tops.obj-code
     2100                                                       BY tops.gds-code
     2101                                                       BY tops.sale-date
     2102                                                       By tops.shift-num
     2103                                                       BY tops.pl-code:
     2104       IF HowBReak AND FIRST-OF(tops.obj-code) then do:
     2105           FIND FIRST clients No-LOCK WHERE clients.obj-type = tops.obj-type AND
     2106                                            clients.obj-code = tops.obj-code No-ERROR.
     2107                  assign
     2108                  acc-qnty-obj = 0
     2109                  acc-tot-r-b-obj = 0
     2110                  acc-discnt-r-b-obj = 0
     2111                  acc-netto-r-b-obj = 0
     2112                   .
     2113                   DISPLAY STREAM PrnLibStream
     2114                   clients.obj-name @ tops.gds-name
     2115                   WITH FRAME TopsF.
     2116                   UNDERLINE STREAM PrnLibStream
     2117                   tops.sale-date
     2118                   tops.shift-name
     2119                   tops.gds-code
     2120                   tops.gds-name
     2121                   tops.doc-code
     2122                   tops.doc-type
     2123                   tops.pl-code
     2124                   tops.qnty
     2125                   tops.tot-r-b
     2126                   tops.discnt-r-b
     2127                   for-netto
     2128                   WITH FRAME TopsF.
     2129               END.
     2130               IF FIRST-of(tops.gds-code) then
     2131               assign
     2132               acc-qnty-gds = 0
     2133               acc-tot-r-b-gds = 0
     2134               acc-discnt-r-b-gds = 0
     2135               acc-netto-r-b-gds = 0
     2136               .
     2137               IF HowBreak then do:
     2138                   DISPLAY STREAM PrnLibStream
     2139                   tops.sale-date
     2140                   tops.shift-name
     2141                   tops.gds-code
     2142                   tops.gds-name
     2143                   tops.doc-code
     2144                   tops.doc-type
     2145                   tops.pl-code
     2146                   tops.qnty
     2147                   tops.tot-r-b
     2148                   tops.discnt-r-b
     2149                   (tops.tot-r-b - tops.discnt-r-b) @ for-netto
     2150                   WITH FRAME TopsF.
     2151                   DOWN STREAM PrnLibStream 1 with frame TopsF.
     2152               end.
     2153               else do:
     2154                   DISPLAY STREAM PrnLibStream
     2155                   tops.sale-date
     2156                   tops.shift-name
     2157                   tops.gds-code
     2158                   tops.gds-name
     2159                   tops.qnty
     2160                   tops.tot-r-b
     2161                   tops.discnt-r-b
     2162                   (tops.tot-r-b - tops.discnt-r-b) @ for-netto
     2163                   WITH FRAME Topsf.
     2164                   DOWN STREAM PrnLibStream 1 with frame Topsf.
     2165               end.
     2166               assign
     2167               acc-qnty-gds = acc-qnty-gds + tops.qnty
     2168               acc-tot-r-b-gds = acc-tot-r-b-gds + tops.tot-r-b
     2169               acc-discnt-r-b-gds = acc-discnt-r-b-gds + tops.discnt-r-b
     2170               acc-netto-r-b-gds = acc-netto-r-b-gds + (tops.tot-r-b - tops.discnt-r-b)
     2171               acc-qnty-obj = acc-qnty-obj + tops.qnty
     2172               acc-tot-r-b-obj = acc-tot-r-b-obj + tops.tot-r-b
     2173               acc-discnt-r-b-obj = acc-discnt-r-b-obj + tops.discnt-r-b
     2174               acc-netto-r-b-obj = acc-netto-r-b-obj + (tops.tot-r-b - tops.discnt-r-b)
     2175               acc-qnty = acc-qnty + tops.qnty
     2176               acc-tot-r-b = acc-tot-r-b + tops.tot-r-b
     2177               acc-discnt-r-b = acc-discnt-r-b + tops.discnt-r-b
     2178               acc-netto-r-b = acc-netto-r-b + (tops.tot-r-b - tops.discnt-r-b)
     2179               .
     2180               IF LAST-OF(tops.gds-code) then do:
     2181                   if HowBreak then do:
     2182                       UNDERLINE STREAM PrnLibStream
     2183                       tops.sale-date
     2184                       tops.shift-name
     2185                       tops.gds-code
     2186                       tops.gds-name
     2187                       tops.doc-code
     2188                       tops.doc-type
     2189                       tops.pl-code
     2190                       tops.qnty
     2191                       tops.tot-r-b
     2192                       tops.discnt-r-b
     2193                       for-netto
     2194                       WITH FRAME TopsF.
     2195                       DISPLAY STREAM PrnLibStream
     2196                       "Итого по товару" @ tops.sale-date
     2197                       tops.gds-code
     2198                       tops.gds-name
     2199                       acc-qnty-gds @ tops.qnty
     2200                       acc-tot-r-b-gds @ tops.tot-r-b
     2201                       acc-discnt-r-b-gds @ tops.discnt-r-b
     2202                       acc-netto-r-b-gds @ for-netto
     2203                       WITH FRAME TopsF.
     2204                       DOWN STREAM PrnLibStream 1 with frame TopsF.
     2205                       UNDERLINE STREAM PrnLibStream
     2206                       tops.sale-date
     2207                       tops.shift-name
     2208                       tops.gds-code
     2209                       tops.gds-name
     2210                       tops.doc-code
     2211                       tops.doc-type
     2212                       tops.pl-code
     2213                       tops.qnty
     2214                       tops.tot-r-b
     2215                       tops.discnt-r-b
     2216                       for-netto
     2217                       WITH FRAME TopsF.
     2218                   end.
     2219                   else do:
     2220                       UNDERLINE STREAM PrnLibStream
     2221                       tops.sale-date
     2222                       tops.shift-name
     2223                       tops.gds-code
     2224                       tops.gds-name
     2225                       tops.qnty
     2226                       tops.tot-r-b
     2227                       tops.discnt-r-b
     2228                       for-netto
     2229                       WITH FRAME Topsf.
     2230                       DISPLAY STREAM PrnLibStream
     2231                       "Итого по товару" @ tops.sale-date
     2232                       tops.gds-code
     2233                       tops.gds-name
     2234                       acc-qnty-gds @ tops.qnty
     2235                       acc-tot-r-b-gds @ tops.tot-r-b
     2236                       acc-discnt-r-b-gds @ tops.discnt-r-b
     2237                       acc-netto-r-b-gds @ for-netto
     2238                       WITH FRAME Topsf.
     2239                       DOWN STREAM PrnLibStream 1 with frame Topsf.
     2240                       UNDERLINE STREAM PrnLibStream
     2241                       tops.sale-date
     2242                       tops.shift-name
     2243                       tops.gds-code
     2244                       tops.gds-name
     2245                       tops.qnty
     2246                       tops.tot-r-b
     2247                       tops.discnt-r-b
     2248                       for-netto
     2249                       WITH FRAME Topsf.
     2250                   end.
     2251               END.
     2252               IF HOWBREAK AND LAST-OF(tops.obj-code) then do:
     2253                   UNDERLINE STREAM PrnLibStream
     2254                   tops.sale-date
     2255                   tops.shift-name
     2256                   tops.gds-code
     2257                   tops.gds-name
     2258                   tops.doc-code
     2259                   tops.doc-type
     2260                   tops.pl-code
     2261                   tops.qnty
     2262                   tops.tot-r-b
     2263                   tops.discnt-r-b
     2264                   for-netto
     2265                   WITH FRAME TopsF.
     2266                   DISPLAY STREAM PrnLibStream
     2267                   "Итого по объекту" @ tops.sale-date
     2268                   acc-qnty-obj @ tops.qnty
     2269                   acc-tot-r-b-obj @ tops.tot-r-b
     2270                   acc-discnt-r-b-obj @ tops.discnt-r-b
     2271                   acc-netto-r-b-obj @ for-netto
     2272                   WITH FRAME TopsF.
     2273                   DOWN STREAM PrnLibStream 1 with frame TopsF.
     2274                   UNDERLINE STREAM PrnLibStream
     2275                   tops.sale-date
     2276                   tops.shift-name
     2277                   tops.gds-code
     2278                   tops.gds-name
     2279                   tops.doc-code
     2280                   tops.doc-type
     2281                   tops.pl-code
     2282                   tops.qnty
     2283                   tops.tot-r-b
     2284                   tops.discnt-r-b
     2285                   for-netto
     2286                   WITH FRAME TopsF.
     2287               end.
     2288           END.
     2289           DISPLAY STREAM PrnLibStream
     2290           "ИТОГO" @ tops.sale-date
     2291           acc-qnty @ tops.qnty
     2292           acc-tot-r-b @ tops.tot-r-b
     2293           acc-discnt-r-b @ tops.discnt-r-b
     2294           acc-netto-r-b @ for-netto
     2295           WITH FRAME Topsf.
     2296           DOWN STREAM PrnLibStream 1 with frame TopsF.
     2297           output stream PrnLibStream CLOSE.
     2298           run waitfram-hide in this-procedure .
     2299   END PROCEDURE.
     2300   PROCEDURE send-records :
     2301   END PROCEDURE.
     2302   PROCEDURE state-changed :
     2303     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
     2304     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     2305   END PROCEDURE.
