     1177   define new global shared variable g#library  as handle no-undo .
     1178   define new global shared variable g#library2 as handle no-undo .
     1179   define variable var-report-r-b as character no-undo .
     1180   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1181   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1182     (output var-report-r-b
     1183     )  .
     1184   define variable l-col-type         as character no-undo .
     1185   define variable l-col-pos          as integer no-undo .
     1186   define variable l-col-len          as integer no-undo .
     1187   define variable l-col-format       as character no-undo .
     1188   define variable l-col-lable        as character no-undo .
     1189   define variable v-dec-sep          as character no-undo init ? .
     1190   define variable v-th-sep           as character no-undo init ? .
     1191   define variable v-r-col-num        as integer no-undo .
     1192   define variable v-reg-replace      as logical no-undo .
     1193   define variable v-date-col-format  as character no-undo .
     1194   DEFINE VARIABLE last-col-num as integer no-undo.
     1195   run gbl/getlocal.p (
     1196                     output v-dec-sep
     1197                    ,output v-th-sep
     1198                    ,output v-sdate
     1199                    ,output v-shortdate
     1200                    ) no-error .
     1201   assign
     1202   v-reg-replace = NOT (v-dec-sep = ".":U and v-th-sep = chr(44))
     1203                   AND (v-dec-sep <> ? and v-th-sep <> ?)
     1204   .
     1205     FUNCTION supress-null RETURNS CHARACTER ( INPUT p-string  AS CHARACTER,
     1206                                               INPUT p-dec-sep AS CHARACTER  ) :
     1207       DEFINE VARIABLE v-string AS CHARACTER NO-UNDO.
     1208       IF TRIM( p-string ) = "0"                    OR
     1209          TRIM( p-string ) = "0" + p-dec-sep + "00" OR
     1210          TRIM( p-string ) =       p-dec-sep + "00" OR
     1211          TRIM( p-string ) =       p-dec-sep + "0"  OR
     1212          TRIM( p-string ) = "0" + p-dec-sep + "0"  THEN DO: ASSIGN v-string = "":U.     END.
     1213                                                    ELSE DO: ASSIGN v-string = p-string. END.
     1214       RETURN ( TRIM( v-string ) ).
     1215     END FUNCTION.
     1216   FUNCTION reg-output returns character( input p-string as character
     1217                                         ,input p-private-data as character
     1218                                         ,input p-replace as logical
     1219                                         ,input p-supress as logical
     1220                                         ,input p-dec-sep as character
     1221                                         ,input p-th-sep as character
     1222                                         ):
     1223   DEFINE VARIABLE v-reg-output as character no-undo .
     1224   DEFINE VARIABLE v-data-type as character no-undo .
     1225   DEFINE VARIABLE v-progress-format as character no-undo .
     1226   assign
     1227   v-progress-format = entry(1, p-private-data, chr(4))
     1228   v-data-type = entry(2, p-private-data, chr(4))
     1229   .
     1230   if p-string = ? then return chr(63).
     1231   if (v-data-type = "INTEGER"
     1232       OR v-data-type = "DECIMAL" ) THEN DO:
     1233     IF p-replace THEN DO:
     1234       assign
     1235         v-reg-output = replace( p-string
     1236                                         ,chr(44)
     1237                                         ,"":U
     1238                                       )
     1239         v-reg-output = trim(v-reg-output)
     1240       .
     1241     END.
     1242     else do:
     1243       v-reg-output = p-string.
     1244     end.
     1245     IF p-supress THEN DO: ASSIGN v-reg-output = supress-null( TRIM( v-reg-output ), p-dec-sep ). END.
     1246     return v-reg-output.
     1247   end.
     1248     return p-string.
     1249   END FUNCTION.
     1250   procedure OpenForExcel :
     1251      define variable v-ch#ExcelApplication as com-handle no-undo .
     1252      define variable v-ch#Workbook         as com-handle no-undo .
     1253      define variable v-ch#Worksheet        as com-handle no-undo .
     1254      os-delete value( string( session:temp-directory ) +
     1255                                 "rpt" + string( g#report-num ) + ".txt":U ) .
     1256      os-delete value( string( session:temp-directory ) +
     1257                                 "rpt" + string( g#report-num ) + ".frm":U ) .
     1258      os-delete value( string( session:temp-directory ) +
     1259                                 "rpt" + string( g#report-num ) + ".txl":U ) .
     1260      if Make-Excel
     1261      then do:
     1262         output stream ForExcel to value( string( session:temp-directory +
     1263                                        "rpt" + string( g#report-num ) + ".txt":U ) ) .
     1264         assign
     1265            v-excel-file = string( session:temp-directory + "rpt" + string( g#report-num ) )
     1266            number-list = 1
     1267         .
     1268         if make-excel-com
     1269         then do:
     1270   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1271   if valid-handle(ch#WorkSheet) then
     1272   RELEASE OBJECT ch#WorkSheet no-error.
     1273   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1274   if valid-handle(ch#Workbook) then
     1275   RELEASE OBJECT ch#Workbook no-error.
     1276   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1277   if valid-handle(ch#ExcelApplication) then
     1278   RELEASE OBJECT ch#ExcelApplication no-error.
     1279            create "Excel.Application" ch#excelApplication connect no-error.
     1280            if error-status:error
     1281            then do :
     1282           create "Excel.Application" ch#excelApplication no-error.
     1283       if error-status :error then do:
     1284           message
     1285           "Ошибка при запуске Excel" skip
     1286           error-status :get-message(1) skip
     1287           view-as alert-box error .
     1288           undo, return error .
     1289       end.
     1290            end.
     1291            assign
     1292               num#str#  = 0.
     1293               v-ch#excelApplication  = ch#excelApplication.
     1294               v-ch#excelApplication:Interactive = false.
     1295               v-ch#excelApplication:ScreenUpdating = false.
     1296               v-ch#excelApplication:Visible = false.
     1297               ch#Workbook  = v-ch#excelApplication:Workbooks:add ().
     1298               ch#WorkSheet = v-ch#excelApplication:Sheets:Item (1).
     1299               v-ch#Worksheet = ch#WorkSheet.
     1300               v-ch#Worksheet:Range ("A1"):Font:Bold = true.
     1301               v-ch#Worksheet:Range ("A1"):Font:Size = 14.
     1302               v-ch#Worksheet:Range ("A1"):HorizontalAlignment = -4131.
     1303               v-ch#Worksheet:Range ("A1"):VerticalAlignment   = -4160
     1304            no-error .
     1305            if error-status:error
     1306            then do:
     1307               Make-Excel-com = false .
     1308               Make-Excel = false .
     1309               output Stream  ForExcel close.
     1310               os-delete value( string( session:temp-directory ) +
     1311                              "rpt" + string( g#report-num ) + ".txt":U ) .
     1312               os-delete value( string( session:temp-directory ) +
     1313                              "rpt" + string( g#report-num ) + ".frm":U ) .
     1314               return.
     1315            end.
     1316         end.
     1317      end.
     1318   end.
     1319   procedure CloseForExcel :
     1320      define variable ii as integer no-undo .
     1321      define variable vsheet-num as integer no-undo.
     1322      if Make-Excel
     1323      then  do:
     1324         output Stream  ForExcel close.
     1325         os-delete value( string( session:temp-directory ) +
     1326                                "rpt" + string( g#report-num ) + ".txt":U ) .
     1327         os-delete value( string( session:temp-directory ) +
     1328                                "rpt" + string( g#report-num ) + ".frm":U ) .
     1329         define buffer buf_sheetf for sheetf.
     1330         find last buf_sheetf no-error .
     1331         if available buf_sheetf
     1332         then
     1333            vsheet-num = buf_sheetf.sheet-num.
     1334         if vsheet-num > 1
     1335         then do:
     1336            do ii = 2 to vsheet-num:
     1337               os-delete value( string( session:temp-directory ) +
     1338                                     "rpt" + string( g#report-num ) + ".":U  + string(ii)) .
     1339            end.
     1340         end.
     1341   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1342   if valid-handle(ch#WorkSheet) then
     1343   RELEASE OBJECT ch#WorkSheet no-error.
     1344   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1345   if valid-handle(ch#Workbook) then
     1346   RELEASE OBJECT ch#Workbook no-error.
     1347   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1348   if valid-handle(ch#ExcelApplication) then
     1349   RELEASE OBJECT ch#ExcelApplication no-error.
     1350      end.
     1351   end.
