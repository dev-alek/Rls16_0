      194   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      195   procedure cur-time :
      196      define output parameter p-today as date      no-undo .
      197      define output parameter p-time  as integer   no-undo .
      198     do
      199     on error undo, return error
      200     :
      201       define variable v-date1 as date      no-undo .
      202       define variable v-date2 as date      no-undo .
      203       define variable v-time  as integer   no-undo .
      204       assign
      205         v-date1 = today
      206         v-time  = time
      207         v-date2 = today
      208       .
      209       if v-date1 <> v-date2
      210       then do:
      211         assign
      212           v-date1 = today
      213           v-time  = v-time
      214         .
      215       end.
      216       assign
      217         p-today = v-date1
      218         p-time  = v-time
      219       .
      220     end.
      221   end.
      222   function cur-time-date returns character
      223   :
      224     return string(today, '99/99/9999':U) .
      225   end.
      226   function cur-time-mjd returns decimal
      227   :
      228     define variable v-date as date      no-undo .
      229     define variable v-time as integer   no-undo .
      230     run cur-time in this-procedure
      231       (output v-date
      232       ,output v-time
      233       ) .
      234     return integer(v-date) - 2400002 + (v-time / 86400) .
      235   end.
      236   function cur-time-get-ending-index returns integer
      237   (input p-number as integer
      238   )
      239   :
      240     if p-number < 0
      241     or p-number = ?
      242     then do:
      243       return 1 .
      244     end.
      245     define variable v-rest as integer   no-undo .
      246     assign
      247       p-number = p-number modulo 100
      248     .
      249     if p-number < 20
      250     then do:
      251       assign
      252         v-rest = p-number
      253       .
      254     end.
      255     else do:
      256       assign
      257         v-rest = p-number modulo 10
      258       .
      259     end.
      260     case v-rest :
      261       when 1
      262       then do:
      263         return 2 .
      264       end.
      265       when 2 or
      266       when 3 or
      267       when 4
      268       then do:
      269         return 3 .
      270       end.
      271       otherwise do:
      272         return 1 .
      273       end.
      274     end case .
      275   end.
      276   procedure cur-time-mjd-to-date :
      277      define input  parameter i-mjd-diff as decimal no-undo.
      278      define output parameter o-Date     as date    no-undo.
      279      define output parameter o-Time     as integer no-undo.
      280      define variable v-day-number as integer   no-undo .
      281      if    i-mjd-diff < 0
      282         or i-mjd-diff = ?
      283      then do:
      284         return "?" .
      285      end.
      286      assign
      287         v-day-number = truncate(i-mjd-diff,0).
      288         o-Date = date(v-day-number + 2400002).
      289         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      290     .
      291   end.
      292   function cur-time-mjd-to-string returns character
      293   (input p-mjd-diff as decimal
      294   )
      295   :
      296     define variable v-day-number as integer   no-undo .
      297     define variable v-seconds    as integer   no-undo .
      298     define variable v-hour       as integer   no-undo .
      299     define variable v-min        as integer   no-undo .
      300     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      301     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      302     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      303     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      304     if p-mjd-diff < 0
      305     or p-mjd-diff = ?
      306     then do:
      307       return "?" .
      308     end.
      309     assign
      310       v-day-number = integer(truncate(p-mjd-diff,0))
      311       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      312     .
      313     if v-seconds > 86400
      314     then do:
      315       assign
      316         v-seconds = 86400 - 1
      317       .
      318     end.
      319     if v-seconds < 0
      320     then do:
      321       assign
      322         v-seconds = 0
      323       .
      324     end.
      325     assign
      326       v-hour = truncate(v-seconds / 3600, 0)
      327     .
      328     assign
      329       v-seconds = v-seconds modulo 3600
      330     .
      331     assign
      332       v-min = truncate(v-seconds / 60, 0)
      333     .
      334     assign
      335       v-seconds = v-seconds modulo 60
      336     .
      337     return
      338         (if v-day-number <> 0
      339           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      340           else ""
      341         )
      342       + (if v-day-number <> 0 or v-hour <> 0
      343           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      344           else ""
      345         )
      346       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      347           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      348           else ""
      349         )
      350       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      351       .
      352   end.
      353   function cur-time-string returns character
      354   :
      355     define variable v-date as date      no-undo .
      356     define variable v-time as integer   no-undo .
      357     run cur-time in this-procedure
      358       (output v-date
      359       ,output v-time
      360       ) .
      361     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      362   end.
      363   function cur-time-string-sec returns character
      364   :
      365     define variable v-date as date      no-undo .
      366     define variable v-time as integer   no-undo .
      367     run cur-time in this-procedure
      368       (output v-date
      369       ,output v-time
      370       ) .
      371     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      372   end.
      373   function cur-time-custom  returns character
      374   (input p-prefix as character
      375   ,input p-date-format as character
      376   ,input p-delimiter as character
      377   ,input p-time-format as character
      378   ,input p-suffix as character
      379   )
      380   :
      381     define variable v-date as date      no-undo .
      382     define variable v-time as integer   no-undo .
      383     run cur-time in this-procedure
      384       (output v-date
      385       ,output v-time
      386       ) .
      387     return
      388       p-prefix
      389       + string(v-date, p-date-format)
      390       + p-delimiter
      391       + string(v-time, p-time-format)
      392       + p-suffix
      393       .
      394   end.
      395   function cur-time-print  returns character
      396   :
      397     define variable v-date as date      no-undo .
      398     define variable v-time as integer   no-undo .
      399     run cur-time in this-procedure
      400       (output v-date
      401       ,output v-time
      402       ) .
      403     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      404   end.
      405   function cur-time-datetime returns datetime
      406   :
      407     define variable v-char as character no-undo .
      408     define variable v-datetime as datetime no-undo .
      409     v-char = cur-time-string().
      410     v-datetime = datetime(v-char).
      411     return  v-datetime.
      412   end.
      413   function cur-time-string-msec returns character
      414   :
      415     define variable v-date as datetime  no-undo .
      416     v-date = now.
      417     return string(v-date) .
      418   end.
      419   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      420   define variable v-waitfram-action01         as character   no-undo .
      421   define variable v-waitfram-action02         as character   no-undo .
      422   define variable v-waitfram-action03         as character   no-undo .
      423   define variable mWaitFramTextBeg            as character   no-undo.
      424   define variable mWaitFramTextEnd            as character   no-undo.
      425   define variable mWaitFramView               as logical     no-undo.
      426   define variable mWaitProcEvent              as logical     no-undo init yes.
      427   define variable mWaitFramInterval           as integer     no-undo init 1 .
      428   define variable mWaitFramStop               as logical     no-undo.
      429   define variable mWaitFramStopUser           as logical     no-undo.
      430   define variable mWaitFramStopTimeOut        as logical     no-undo.
      431   define variable mWaitFramStartProc          as datetime-tz no-undo.
      432   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      433   define button B-WaitFramStop auto-end-key
      434        label "Стоп"
      435        size 10 by 1 tooltip "Остоновить процесс".
      436   define button B-viewProcInfo
      437        label "Информация"
      438        size 15 by 1 tooltip "Информация о процесс".
      439   define frame waitfram
      440     v-waitfram-action01 format "x(72)" no-label skip
      441     v-waitfram-action02 format "x(72)" no-label skip
      442     v-waitfram-action03 format "x(72)" no-label skip
      443     B-viewProcInfo
      444     B-WaitFramStop at row 4 col 30
      445     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      446     .
      447   define new global shared variable mBatchMode as logical no-undo init ?.
      448   define variable mFramBachModHandle as handle no-undo.
      449   mFramBachModHandle = frame waitfram:handle.
      450   define variable mFameOldVis as logical no-undo.
      451   define variable mVisCUrentVin as logical no-undo.
      452   if session:batch-mode
      453   then
      454      mBatchMode = yes.
      455   if mBatchMode = ? then do:
      456     mVisCUrentVin = current-window:visible.
      457     mFameOldVis = mFramBachModHandle:visible.
      458     mFramBachModHandle:visible  = yes.
      459     mBatchMode = mFramBachModHandle:visible ne yes.
      460     mFramBachModHandle:visible = mFameOldVis.
      461     current-window:visible = mVisCUrentVin.
      462   end.
      463    if  log-manager:logfile-name ne ?
      464     then DO:
      465         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      466         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      467         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      468     end.
      469   on choose of B-WaitFramStop in frame waitfram
      470   do:
      471     mWaitFramStop = yes.
      472     mWaitFramStopUser = yes.
      473   end.
      474   function waitfram-check-timeout returns logical():
      475      define variable vtime as int64 no-undo.
      476      if mWaitFramStopTimeOut
      477      then
      478         return yes.
      479      vtime = ( now - mWaitFramStartProc ) / 1000 .
      480      if     mWaitFramTimeOut ne ?
      481         and mWaitFramTimeOut ne 0
      482         and mWaitFramTimeOut lt vtime
      483      then do:
      484         mWaitFramStopTimeOut = yes.
      485      end.
      486      return mWaitFramStopTimeOut.
      487   end.
      488   procedure waitfram-hide :
      489     if not session:batch-mode
      490     then do
      491     on error undo, return error return-value
      492     :
      493       pause 0 before-hide .
      494       if not mBatchMode then
      495         hide frame waitfram .
      496     if     not mWaitFramView
      497        and mWaitProcEvent
      498     then
      499       process events .
      500     end.
      501   end procedure.
      502   procedure waitfram-show :
      503     define input  parameter p-message as character no-undo .
      504     define variable v-left-margin as integer   no-undo .
      505     if not session:batch-mode
      506     then do
      507     on error undo, return error return-value
      508     :
      509       if length(p-message) <= 70 then do:
      510         assign
      511           v-left-margin = integer((70 - length(p-message)) / 2)
      512         .
      513         assign
      514           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      515         .
      516         assign
      517           v-waitfram-action01 = " "
      518           v-waitfram-action02 = " "
      519                                    + fill(" ", v-left-margin)
      520                                    + p-message
      521           v-waitfram-action03 = " "
      522         .
      523       end.
      524       else do:
      525         define variable vRindex1 as integer no-undo.
      526         define variable vRindex2 as integer no-undo.
      527         vRindex1 = r-index(p-message," ",70).
      528         if vRindex1 = 0
      529         then
      530            vRindex1 = 70.
      531         if length(p-message)  <= vRindex1 + 70 then do:
      532           assign
      533             v-waitfram-action01 = " "
      534             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      535             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      536           .
      537         end.
      538         else do:
      539           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      540           if vRindex2 <= vRindex1
      541           then
      542              vRindex2 = vRindex1 + 70.
      543           assign
      544             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      545             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      546             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      547           .
      548         end.
      549       end.
      550       B-viewProcInfo:visible   in frame waitfram = no.
      551       B-viewProcInfo:sensitive in frame waitfram = no.
      552       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      553       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      554       if  (   mWaitFramView
      555          or  mWaitProcEvent)
      556          and not mBatchMode
      557       then
      558          display
      559             v-waitfram-action01 skip
      560             v-waitfram-action02 skip
      561             v-waitfram-action03 skip
      562          with frame waitfram .
      563       if     mWaitFramView
      564          then do:
      565             if     mWaitFramInterval ne ?
      566                and not mBatchMode
      567             then
      568                wait-for go of frame waitfram pause mWaitFramInterval.
      569          end.
      570          else
      571             if     mWaitProcEvent
      572                and not mBatchMode
      573             then
      574                process events .
      575     end.
      576   end procedure.
      577      procedure waitfram-show-this:
      578         define input  parameter iInterval as int64 no-undo.
      579         define variable vtime as int64 no-undo.
      580         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      581         mWaitFramInterval = iInterval.
      582         run waitfram-show (substitute("&1&2 &3&4" ,
      583                                       mWaitFramTextBeg ,
      584                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      585                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      586                                       mWaitFramTextEnd
      587                                      )
      588                           ).
      589      end.
      590      procedure WaitFramRunPause:
      591         define input  parameter iInterval as dec no-undo.
      592         define variable vStart  as datetime-tz no-undo.
      593         define variable vend    as datetime-tz no-undo.
      594         define variable vint as int64 no-undo.
      595         define variable vOk as logical no-undo.
      596         vStart = now.
      597         vend   = vStart.
      598         publish "WaitFramPause" (iInterval,output vOk).
      599         vend   =  now.
      600         vint = vend - vStart.
      601         vint = iInterval - vint / 1000.
      602         if     not mWaitFramStop
      603            and (   vint > 0
      604                 or (    not vOk
      605                     and iInterval eq ?
      606                     )
      607                 )
      608         then
      609            run waitfram-show-this (iInterval).
      610         vend   =  now.
      611         vint = vend - vStart.
      612         vint = iInterval - vint / 1000.
      613         if     not mWaitFramStop
      614            and vint > 0
      615         then do:
      616            run gbl/pause.p (vint * 1000).
      617         end.
      618         if iInterval ne ?
      619         then
      620            publish "WaitFramStop".
      621         waitfram-check-timeout().
      622      end.
      623      procedure WaitFramWaitFor:
      624         define input  parameter iInterval as dec no-undo.
      625         assign
      626            mWaitFramStartProc   = now
      627            mWaitFramStopUser    = no
      628            mWaitFramStopTimeOut = no
      629         .
      630         block-wait:
      631         do while not mWaitFramStop:
      632            run WaitFramRunPause (iInterval).
      633            if  waitfram-check-timeout()
      634            then do:
      635               leave block-wait.
      636            end.
      637         end.
      638         run waitfram-hide.
      639      end.
      640   procedure waitfram-join :
      641     define input  parameter p-line-1  as character no-undo .
      642     define input  parameter p-line-2  as character no-undo .
      643     define input  parameter p-line-3  as character no-undo .
      644     define output parameter p-message as character no-undo .
      645     do
      646     on error undo, return error return-value
      647     :
      648       assign
      649         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      650                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      651                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      652       .
      653     end.
      654   end procedure.
      655   function waitfram-join-function returns character
      656     (input p-line-1 as character
      657     ,input p-line-2 as character
      658     ,input p-line-3 as character
      659     ).
      660     define variable v-message as character no-undo .
      661     run waitfram-join in this-procedure
      662       (input  p-line-1
      663       ,input  p-line-2
      664       ,input  p-line-3
      665       ,output v-message
      666       ) .
      667     return v-message .
      668   end function .
