     1396   DEFINE VARIABLE t-1 AS CHARACTER INITIAL "||||"
     1397        VIEW-AS EDITOR
     1398        SIZE 1 BY 5 NO-UNDO.
     1399   DEFINE FRAME top-frame
     1400   t-1       AT ROW 1 COL 1 no-label
     1401   HEADER
     1402   cur-time-print() AT 5 format "x(35)"
     1403   string( "Страница" ) AT 45 PAGE-NUMBER( DOcsStream ) AT 55 FORMAT ">>>,>>9" SKIP
     1404       with width 232 down stream-io use-text NO-BOX.
     1405   DEFINE FRAME x1
     1406   with width 232 down stream-io use-text NO-BOX.
     1407   assign
     1408     use-column[1] =  yes
     1409     use-column[2] =  yes
     1410     use-column[3] =  yes
     1411     use-column[4] =  yes
     1412     use-column[5] =  yes
     1413     use-column[6] =  pNums
     1414     use-column[7] =  pVal-BruttoSaleSum
     1415     use-column[8] =  pRubl-BruttoSaleSum
     1416     use-column[9] =  pVal-NettoSaleSum
     1417     use-column[10] = pRubl-NettoSaleSum
     1418     use-column[11] = pVal-DiscntSum
     1419     use-column[12] = pRubl-DiscntSum
     1420     use-column[13] = pVal-CostSum
     1421     use-column[14] = pRubl-CostSum
     1422     use-column[15] = pVal-Effect
     1423     use-column[16] = pRubl-Effect
     1424     use-column[17] = pNDS-VAL
     1425     use-column[18] = pNDs-RUbl
     1426     use-column[19] = PDiscnt-PC
