     1433     use-column[26] = pKurs
     1434     use-column[27] = pOur-Obj
     1435     use-column[28] = pPayWaitDate
     1436   .
     1437   assign
     1438     fill8  = fill("-", 8)
     1439     fill11 = fill("-", 11)
     1440     fill12 = fill("-", 12)
     1441     fill15 = fill("-", 15)
     1442     fill18 = fill("-", 18)
     1443     fill19 = fill("-", 19)
     1444     fill21 = fill("-", 21)
     1445   .
     1446   FOR EACH sheetf where sheetf.sheet-num > 1:
     1447     delete sheetf.
     1448   end.
     1449   FIND FIRST sheetf where
     1450              sheetf.sheet-num = 1 No-ERROR.
     1451   assign
     1452   ReportName = p-title
     1453   sheetf.Excel-Column-Lable =  ""
     1454   sheetf.sizes = ""
     1455   Make-Excel = yes.
     1456   .
     1457   CREATE WIDGET-POOL "My-pool" PERSISTENT no-error .
     1458   l-col-pos = 1.
     1459   Assign l-col-type="CHARACTER" l-col-len=4 l-col-format= "x(4)"            l-col-lable="Док. атр.".
     1460     define variable ed1 as handle no-undo.
     1461     define variable l-1 as handle no-undo.
     1462     define variable ll-1 as handle no-undo.
     1463     define variable c-for-doc-attr as widget-handle no-undo.
     1464      if l-col-pos > 320 then l-col-pos = 320 .
     1465     if use-column[1] = true then DO:
     1466           CREATE EDITOR LL-1 IN WIDGET-POOL "My-pool"
     1467             ASSIGN
     1468               FRAME = FRAME top-Frame:HANDLE
     1469               ROW = 1
     1470               COLUMN = l-col-pos
     1471               screen-value = Fill("-", l-col-len)
     1472               WIDTH-CHARS = l-col-len
     1473               HEIGHT-CHARS = 4
     1474           .
     1475           CREATE EDITOR ed1 IN WIDGET-POOL "My-pool"
     1476             ASSIGN
     1477               FRAME = FRAME top-Frame:HANDLE
     1478               ROW = 2
     1479               COLUMN = l-col-pos
     1480               screen-value = l-col-lable
     1481               WIDTH-CHARS = l-col-len
     1482               HEIGHT-CHARS = 4
     1483           .
     1484           CREATE EDITOR L-1 IN WIDGET-POOL "My-pool"
     1485             ASSIGN
