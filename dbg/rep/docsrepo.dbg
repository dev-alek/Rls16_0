     3402               ROW = 2
     3403               COLUMN = l-col-pos
     3404               screen-value = l-col-lable
     3405               WIDTH-CHARS = l-col-len
     3406               HEIGHT-CHARS = 4
     3407           .
     3408           CREATE EDITOR L-27 IN WIDGET-POOL "My-pool"
     3409             ASSIGN
     3410               FRAME = FRAME top-Frame:HANDLE
     3411               ROW = 4 + 1
     3412               COLUMN = l-col-pos
     3413               screen-value = Fill("-", l-col-len)
     3414               WIDTH-CHARS = l-col-len
     3415               HEIGHT-CHARS = 4
     3416           .
     3417           CREATE FILL-IN C-Our-Obj IN WIDGET-POOL "My-pool"
     3418             ASSIGN
     3419               FRAME = FRAME x1:HANDLE
     3420               DATA-TYPE = "CHARACTER"
     3421               FORMAT = "X(":U + string(l-col-len) + ")":U
     3422               PRIVATE-DATA =  l-col-format + chr(4) + l-col-type
     3423               ROW = 1
     3424               COLUMN = l-col-pos
     3425           .
     3426        assign
     3427        l-col-pos =  l-col-pos + l-col-len + 1
     3428        v-r-col-num = v-r-col-num + 1
     3429        .
     3430     end.
     3431   if use-column[27] then
     3432   assign
     3433   sheetf.Excel-Column-Lable =  (if sheetf.Excel-Column-Lable = ""
     3434                                 then (sheetf.Excel-Column-Lable + l-col-lable )
     3435                                 else (sheetf.Excel-Column-Lable + chr(44) + l-col-lable )
     3436                                )
     3437   sheetf.sizes =  (if sheetf.sizes = ""
     3438                    then (sheetf.sizes + string(l-col-len))
     3439                    else (sheetf.sizes + chr(44) + string(l-col-len))
     3440                   )
     3441   last-col-num = 27
     3442   entry(1, sheetf.colformat, chr(4)) = entry(1, sheetf.colformat, chr(4)) +
     3443                                              (if l-col-type = "DATE"
     3444                                               then (
     3445                                                     (if entry(1, sheetf.colformat, chr(4)) <> "":U
     3446                                                      then ";":U
     3447                                                      else "":U) +
     3448                                                      string(v-r-col-num) + "=":U + "dd/mm/yyyy":U
     3449                                                     )
     3450                                               else (if l-col-type = "CHARACTER"
     3451                                                     then ((if entry(1, sheetf.colformat, chr(4)) <> "":U
     3452                                                           then ";":U
     3453                                                           else "":U) + (string(v-r-col-num) + "=":U + "@":U))
     3454                                                     else "":U)
     3455                                               )
     3456   .
     3457   Assign l-col-type="DATE" l-col-len=10 l-col-format= "99/99/9999"                 l-col-lable="Дата ожид-мой оплаты".
     3458     define variable ed28 as handle no-undo.
     3459     define variable l-28 as handle no-undo.
     3460     define variable ll-28 as handle no-undo.
     3461     define variable c-PayWaitDate as widget-handle no-undo.
     3462      if l-col-pos > 320 then l-col-pos = 320 .
     3463     if use-column[28] = true then DO:
     3464           CREATE EDITOR LL-28 IN WIDGET-POOL "My-pool"
     3465             ASSIGN
     3466               FRAME = FRAME top-Frame:HANDLE
     3467               ROW = 1
     3468               COLUMN = l-col-pos
     3469               screen-value = Fill("-", l-col-len)
     3470               WIDTH-CHARS = l-col-len
     3471               HEIGHT-CHARS = 4
     3472           .
     3473           CREATE EDITOR ed28 IN WIDGET-POOL "My-pool"
     3474             ASSIGN
     3475               FRAME = FRAME top-Frame:HANDLE
     3476               ROW = 2
     3477               COLUMN = l-col-pos
     3478               screen-value = l-col-lable
     3479               WIDTH-CHARS = l-col-len
     3480               HEIGHT-CHARS = 4
     3481           .
     3482           CREATE EDITOR L-28 IN WIDGET-POOL "My-pool"
     3483             ASSIGN
     3484               FRAME = FRAME top-Frame:HANDLE
     3485               ROW = 4 + 1
     3486               COLUMN = l-col-pos
     3487               screen-value = Fill("-", l-col-len)
     3488               WIDTH-CHARS = l-col-len
     3489               HEIGHT-CHARS = 4
     3490           .
     3491           CREATE FILL-IN C-PayWaitDate IN WIDGET-POOL "My-pool"
     3492             ASSIGN
     3493               FRAME = FRAME x1:HANDLE
     3494               DATA-TYPE = "CHARACTER"
     3495               FORMAT = "X(":U + string(l-col-len) + ")":U
     3496               PRIVATE-DATA =  l-col-format + chr(4) + l-col-type
     3497               ROW = 1
     3498               COLUMN = l-col-pos
     3499           .
     3500        assign
     3501        l-col-pos =  l-col-pos + l-col-len + 1
     3502        v-r-col-num = v-r-col-num + 1
     3503        .
     3504     end.
     3505   if use-column[28] then
     3506   assign
     3507   sheetf.Excel-Column-Lable =  (if sheetf.Excel-Column-Lable = ""
     3508                                 then (sheetf.Excel-Column-Lable + l-col-lable )
     3509                                 else (sheetf.Excel-Column-Lable + chr(44) + l-col-lable )
     3510                                )
     3511   sheetf.sizes =  (if sheetf.sizes = ""
     3512                    then (sheetf.sizes + string(l-col-len))
     3513                    else (sheetf.sizes + chr(44) + string(l-col-len))
     3514                   )
     3515   last-col-num = 28
     3516   entry(1, sheetf.colformat, chr(4)) = entry(1, sheetf.colformat, chr(4)) +
     3517                                              (if l-col-type = "DATE"
     3518                                               then (
     3519                                                     (if entry(1, sheetf.colformat, chr(4)) <> "":U
     3520                                                      then ";":U
     3521                                                      else "":U) +
     3522                                                      string(v-r-col-num) + "=":U + "dd/mm/yyyy":U
     3523                                                     )
     3524                                               else (if l-col-type = "CHARACTER"
     3525                                                     then ((if entry(1, sheetf.colformat, chr(4)) <> "":U
     3526                                                           then ";":U
     3527                                                           else "":U) + (string(v-r-col-num) + "=":U + "@":U))
     3528                                                     else "":U)
     3529                                               )
     3530   .
     3531   assign
     3532   p-frame-width = l-col-pos - 1
     3533   Line = fill("-", p-frame-width)
     3534   .
     3535   if p-frame-width > 137 and p-frame-width <= 232  then do:
     3536   output stream DocsStream to value( string( session:temp-directory +
     3537                                        "rpt" + string( g#report-num ) ) )
     3538                                        page-size  value(43) .
     3539   end.
     3540   else do:
     3541   output stream DocsStream to value( string( session:temp-directory +
     3542                                        "rpt" + string( g#report-num ) ) )
     3543                                        page-size 62 .
     3544   end.
     3545   if Make-Excel then
     3546   run openforexcel in this-procedure .
     3547   FORM with FRAME x1 .
     3548   FORM HEADER
     3549   Line format "X(76)" AT 1 SKIP
     3550   "Продолжение на следующей странице" AT 30 SKIP
     3551   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     3552   VIEW stream DocsStream FRAME BottomFrame .
     3553   PUT stream DocsStream SPACE(10) p-title format "X(125)" SKIP(2).
     3554   display STREAM DOcsStream
     3555   with frame top-Frame .
     3556   run rep/extitle.p ( 1 ).
     3557   FIND FIRST wt-docs NO-LOCK .
     3558   if can-find( first b-wt-docs where b-wt-docs.doc-type <> wt-docs.doc-type ) then do:
     3559     assign
     3560       DifferentTypes = TRUE
     3561     .
     3562   end.
     3563   run waitfram-show in this-procedure ( "Печать списка документов " ) .
     3564   assign
     3565     v-ind = 0
     3566   .
     3567   FOR EACH wt-docs with frame x1
     3568   :
     3569     assign
     3570       v-ind = v-ind + 1
     3571     .
     3572     if v-ind modulo 10 = 0
     3573     then do:
     3574       run waitfram-show ( "Печать списка документов " + string( v-ind ) ) .
     3575     end.
     3576     if wt-docs.status_ <> 'факт':U then do:
     3577       for each doc-line no-lock
     3578         where doc-line.doc-code = wt-docs.doc-code
     3579       :
     3580           accumulate
     3581             doc-line.doc-qnty * doc-line.price-base ( total )
     3582             doc-line.doc-qnty * doc-line.price-rubl ( total )
     3583           .
     3584       end.
     3585     end.
     3586     assign
     3587                   Qnty = ( if can-do( 'факт':U, wt-docs.status_ )
     3588                                then wt-docs.fact-qnty else wt-docs.doc-qnty )
     3589                   Val-BruttoSaleSum =
     3590                       ( if can-do( 'инв':U, wt-docs.doc-type )
     3591                         then ( if can-do( 'факт':U, wt-docs.status_ )
     3592                                   then wt-docs.tot-doc
     3593                                   else 0 )
     3594                         else ( if can-do( 'при':U, wt-docs.doc-type ) AND ( NOT wt-docs.internal )
     3595                                   then ( if can-do( 'факт':U, wt-docs.status_ )
     3596                                             then wt-docs.fact-base
     3597                                             else ( ACCUM TOTAL doc-line.doc-qnty * doc-line.price-base ) )
     3598                                   else ( if can-do( 'факт':U, wt-docs.status_ )
     3599                                             then ( wt-docs.tot-fact  )
     3600                                             else wt-docs.tot-doc ) ) )
     3601                   Rubl-BruttoSaleSum =
     3602                       ( if can-do( 'инв':U, wt-docs.doc-type )
     3603                         then 0
     3604                         else ( if can-do( 'при':U, wt-docs.doc-type ) AND ( NOT wt-docs.internal )
     3605                                   then ( if can-do( 'факт':U, wt-docs.status_ )
     3606                                             then wt-docs.fact-rubl
     3607                                             else ( ACCUM TOTAL doc-line.doc-qnty * doc-line.price-rubl ) )
     3608                                   else ( if can-do( 'факт':U, wt-docs.status_ )
     3609                                             then wt-docs.tot-sale
     3610                                             else wt-docs.tot-rubl ) ) )
     3611                   Val-NettoSaleSum =
     3612                       ( if can-do( 'инв':U, wt-docs.doc-type )
     3613                         then ( if can-do( 'факт':U, wt-docs.status_ )
     3614                                   then wt-docs.tot-doc
     3615                                   else 0 )
     3616                         else ( if can-do( 'при':U, wt-docs.doc-type ) AND ( NOT wt-docs.internal )
     3617                                   then ( if can-do( 'факт':U, wt-docs.status_ )
     3618                                             then wt-docs.fact-base
     3619                                             else ( ACCUM TOTAL doc-line.doc-qnty * doc-line.price-base ) )
     3620                                   else ( wt-docs.tot-fact - wt-docs.tot-calc ) ) )
     3621                   Rubl-NettoSaleSum =
     3622                       ( if can-do( 'инв':U, wt-docs.doc-type )
     3623                         then ( if can-do( 'факт':U, wt-docs.status_ )
     3624                                   then wt-docs.tot-rubl
     3625                                   else 0 )
     3626                         else ( if can-do( 'при':U, wt-docs.doc-type ) AND ( NOT wt-docs.internal )
     3627                                   then ( if can-do( 'факт':U, wt-docs.status_ )
     3628                                             then wt-docs.fact-rubl
     3629                                             else ( ACCUM TOTAL doc-line.doc-qnty * doc-line.price-rubl ) )
     3630                                   else ( wt-docs.tot-sale - wt-docs.discnt-rubl ) ) )
     3631                   Val-DiscntSum = ( if can-do( 'инв':U, wt-docs.doc-type ) OR
     3632                                                   ( can-do( 'при':U, wt-docs.doc-type ) AND ( NOT wt-docs.internal ) )
     3633                                                then 0    else wt-docs.tot-calc )
     3634                   Rubl-DiscntSum = ( if can-do( 'инв':U, wt-docs.doc-type ) OR
     3635                                                   ( can-do( 'при':U, wt-docs.doc-type ) AND ( NOT wt-docs.internal ) )
     3636                                                   then 0     else wt-docs.discnt-rubl )
     3637                   Val-CostSum = ( if can-do( 'инв':U, wt-docs.doc-type )
     3638                                             then ( if can-do( 'факт':U, wt-docs.status_ )
     3639                                                       then wt-docs.fact-base     else 0 )
     3640                                             else ( if can-do( 'факт':U, wt-docs.status_ )
     3641                                                       then wt-docs.fact-base
     3642                                                       else ( ACCUM TOTAL doc-line.doc-qnty * doc-line.price-base ) ) )
     3643                   Rubl-CostSum =
     3644                       ( if can-do( 'инв':U, wt-docs.doc-type )
     3645                         then ( if can-do( 'факт':U, wt-docs.status_ )
     3646                                   then wt-docs.fact-rubl
     3647                                   else 0 )
     3648                         else ( if can-do( 'факт':U, wt-docs.status_ )
     3649                                   then wt-docs.fact-rubl
     3650                                   else ( ACCUM TOTAL doc-line.doc-qnty * doc-line.price-rubl ) ) )
     3651                   NDS-Val = wt-docs.VAT-base
     3652                   NDS-Rubl = wt-docs.VAT-rubl
     3653                   TorgPred = wt-docs.Mngr_Name
     3654                   Operator = wt-docs.Oper_Name
     3655                   PayType = wt-docs.pay-name
     3656                   Kurs = wt-docs.Course
     3657                   Our-Obj = wt-docs.OurObjectName
     3658                   KladovName = wt-docs.Wrkr_name
     3659                   IspName = wt-docs.Isp-Name
     3660                   PayWaitDate = wt-docs.pay-waitdate
     3661                   .
     3662           if Qnty = ? then Qnty = 0 .
     3663           if Val-BruttoSaleSum = ? then Val-BruttoSaleSum = 0 .
     3664           if Rubl-BruttoSaleSum = ? then Rubl-BruttoSaleSum = 0 .
     3665           if Val-NettoSaleSum = ? then Val-NettoSaleSum = 0 .
     3666           if Rubl-NettoSaleSum = ? then Rubl-NettoSaleSum = 0 .
     3667           if Val-DiscntSum = ? then Val-DiscntSum = 0 .
     3668           if Rubl-DiscntSum = ? then Rubl-DiscntSum = 0 .
     3669           if Val-CostSum = ? then Val-CostSum = 0 .
     3670           if Rubl-CostSum = ? then Rubl-CostSum = 0 .
     3671           if NDS-Val = ? then NDS-Val = 0 .
     3672           if NDS-Rubl = ? then NDS-Rubl = 0 .
     3673           if DifferentTypes AND can-do( 'рас,спи':U, wt-docs.doc-type ) then do:
     3674               assign
     3675                   Qnty = - Qnty
     3676                   Val-BruttoSaleSum = - Val-BruttoSaleSum
     3677                   Rubl-BruttoSaleSum = - Rubl-BruttoSaleSum
     3678                   Val-NettoSaleSum = - Val-NettoSaleSum
     3679                   Rubl-NettoSaleSum = - Rubl-NettoSaleSum
     3680                   Val-DiscntSum = - Val-DiscntSum
     3681                   Rubl-DiscntSum = - Rubl-DiscntSum
     3682                   Val-CostSum = - Val-CostSum
     3683                   Rubl-CostSum = - Rubl-CostSum
     3684                   NDS-Val = - NDS-Val
     3685                   NDS-Rubl = - NDS-Rubl .
     3686           end.
     3687           if DifferentTypes then do:
     3688               if NOT wt-docs.internal then
     3689                   CASE wt-docs.doc-type :
     3690                       when 'рас':U OR when 'возврат':U then
     3691                           assign
     3692                               Val-Effect = - ( Val-NettoSaleSum - Val-CostSum )
     3693                               Rubl-Effect = - ( Rubl-NettoSaleSum - Rubl-CostSum ) .
     3694                       when 'спи':U then
     3695                           assign
     3696                               Val-Effect = Val-CostSum
     3697                               Rubl-Effect = Rubl-CostSum .
     3698                       when 'инв':U then
     3699                           if can-do( 'факт':U, wt-docs.status_ ) AND ( wt-docs.tot-doc <> 0 ) then
     3700                               assign
     3701                                   Val-Effect = ( Val-NettoSaleSum - Val-CostSum )
     3702                                   Rubl-Effect = ( Rubl-NettoSaleSum - Rubl-CostSum ) .
     3703                           else
     3704                               assign     Val-Effect = 0    Rubl-Effect = 0 .
     3705                       otherwise
     3706                           assign     Val-Effect = 0    Rubl-Effect = 0 .
     3707                   END CASE .
     3708               else
     3709                   assign      Val-Effect = 0    Rubl-Effect = 0 .
     3710           end.
     3711           else do:
     3712               if NOT wt-docs.internal then
     3713                   CASE wt-docs.doc-type :
     3714                       when 'рас':U then
     3715                           assign
     3716                               Val-Effect = ( Val-NettoSaleSum - Val-CostSum )
     3717                               Rubl-Effect = ( Rubl-NettoSaleSum - Rubl-CostSum ) .
     3718                           when 'спи':U then
     3719                               assign
     3720                                   Val-Effect = - Val-CostSum
     3721                                   Rubl-Effect = - Rubl-CostSum .
     3722                           when 'возврат':U then
     3723                               assign
     3724                                   Val-Effect = - ( Val-NettoSaleSum - Val-CostSum )
     3725                                   Rubl-Effect = - ( Rubl-NettoSaleSum - Rubl-CostSum ) .
     3726                           when 'инв':U then
     3727                               if can-do( 'факт':U, wt-docs.status_ ) AND ( wt-docs.tot-doc <> 0 ) then
     3728                                   assign
     3729                                       Val-Effect = ( Val-NettoSaleSum - Val-CostSum )
     3730                                       Rubl-Effect = ( Rubl-NettoSaleSum - Rubl-CostSum ) .
     3731                               else
     3732                                   assign     Val-Effect = 0    Rubl-Effect = 0 .
     3733                           otherwise
     3734                               assign     Val-Effect = 0    Rubl-Effect = 0 .
     3735                       END CASE .
     3736               else
     3737                   assign      Val-Effect = 0    Rubl-Effect = 0 .
     3738           end.
     3739           if Val-BruttoSaleSum <> 0 then do:
     3740               if ( ( Val-DiscntSum / Val-BruttoSaleSum ) < 100 ) AND
     3741                  ( ( Val-DiscntSum / Val-BruttoSaleSum ) > -100 ) then
     3742                   Discnt-PC =
     3743                       string( Val-DiscntSum / Val-BruttoSaleSum * 100 , "->>>9.9" ) + "%" .
     3744               else
     3745                   if ( Val-DiscntSum / Val-BruttoSaleSum < -99.99 ) then
     3746                       Discnt-PC = string( -9999.9 , "->>>9.9" ) + "%" .
     3747                   else
     3748                       Discnt-PC = string( 9999.9 , "->>>9.9" ) + "%" .
     3749           end.
     3750           else do:
     3751               Discnt-PC = string( 0, "->>>9.9" ) + "%" .
     3752           end.
     3753           if Val-CostSum <> 0 then do:
     3754             if  ( Val-Effect / abs( Val-CostSum ) ) < 100
     3755             AND ( Val-Effect / abs( Val-CostSum ) ) > -100 then do:
     3756               assign
     3757                 Up-PC = string( Val-Effect / abs( Val-CostSum ) * 100 , "->>>9.9" ) + "%"
     3758               .
     3759             end.
     3760             else do:
     3761               if ( Val-Effect / abs( Val-CostSum ) ) < -99.99 then do:
     3762                 assign
     3763                   Up-PC = string( -9999.9 , "->>>9.9" ) + "%"
     3764                 .
     3765               end.
     3766               else do:
     3767                 assign
     3768                   Up-PC = string( 9999.9 , "->>>9.9" ) + "%"
     3769                 .
     3770               end.
     3771             end.
     3772           end.
     3773           else do:
     3774             assign
     3775               Up-PC = string( 0 , "->>>9.9" ) + "%"
     3776             .
     3777           end.
     3778           ACCUMULATE
     3779             Qnty               ( TOTAL )
     3780             Val-BruttoSaleSum  ( TOTAL )
     3781             Rubl-BruttoSaleSum ( TOTAL )
     3782             Val-NettoSaleSum   ( TOTAL )
     3783             Rubl-NettoSaleSum  ( TOTAL )
     3784             Val-DiscntSum      ( TOTAL )
     3785             Rubl-DiscntSum     ( TOTAL )
     3786             Val-CostSum        ( TOTAL )
     3787             Rubl-CostSum       ( TOTAL )
     3788             NDS-Val            ( TOTAL )
     3789             NDS-Rubl           ( TOTAL )
     3790             Val-Effect         ( TOTAL )
     3791             Rubl-Effect        ( TOTAL )
     3792             for-doc-code       ( count )
     3793             .
     3794     if use-column[1]
     3795     then  C-for-doc-attr:screen-value = string(wt-docs.doc-attr, entry(1, c-for-doc-attr:private-data, chr(4))).
     3796     if use-column[2]
     3797     then  C-for-doc-date:screen-value = string(wt-docs.doc-date, entry(1, c-for-doc-date:private-data, chr(4))).
     3798     if use-column[3]
     3799     then  C-for-fact-date:screen-value = string(wt-docs.fact-date, entry(1, c-for-fact-date:private-data, chr(4))).
     3800     if use-column[4]
     3801     then  C-for-doc-code:screen-value = string(wt-docs.doc-code, entry(1, c-for-doc-code:private-data, chr(4))).
     3802     if use-column[5]
     3803     then  C-for-cli-name:screen-value = string(wt-docs.cli-name, entry(1, c-for-cli-name:private-data, chr(4))).
     3804     if use-column[6]
     3805     then  C-Qnty:screen-value = string(Qnty, entry(1, c-Qnty:private-data, chr(4))).
     3806     if use-column[7]
     3807     then  C-Val-BruttoSaleSum:screen-value = string(Val-BruttoSaleSum, entry(1, c-Val-BruttoSaleSum:private-data, chr(4))).
     3808     if use-column[8]
     3809     then  C-Rubl-BruttoSaleSum:screen-value = string(Rubl-BruttoSaleSum, entry(1, c-Rubl-BruttoSaleSum:private-data, chr(4))).
     3810     if use-column[9]
     3811     then  C-Val-NettoSaleSum:screen-value = string(Val-NettoSaleSum, entry(1, c-Val-NettoSaleSum:private-data, chr(4))).
     3812     if use-column[10]
     3813     then  C-Rubl-NettoSaleSum:screen-value = string(Rubl-NettoSaleSum, entry(1, c-Rubl-NettoSaleSum:private-data, chr(4))).
     3814     if use-column[11]
     3815     then  C-Val-DiscntSum:screen-value = string(Val-DiscntSum, entry(1, c-Val-DiscntSum:private-data, chr(4))).
     3816     if use-column[12]
     3817     then  C-RUbl-DiscntSum:screen-value = string(Rubl-DiscntSum, entry(1, c-RUbl-DiscntSum:private-data, chr(4))).
     3818     if use-column[13]
     3819     then  C-Val-CostSum:screen-value = string(Val-CostSum, entry(1, c-Val-CostSum:private-data, chr(4))).
     3820     if use-column[14]
     3821     then  C-RUbl-CostSum:screen-value = string(Rubl-CostSum, entry(1, c-RUbl-CostSum:private-data, chr(4))).
     3822     if use-column[15]
     3823     then  C-Val-Effect:screen-value = string(Val-Effect, entry(1, c-Val-Effect:private-data, chr(4))).
     3824     if use-column[16]
     3825     then  C-RUbl-Effect:screen-value = string(Rubl-Effect, entry(1, c-RUbl-Effect:private-data, chr(4))).
     3826     if use-column[17]
     3827     then  C-Nds-Val:screen-value = string(Nds-Val, entry(1, c-Nds-Val:private-data, chr(4))).
     3828     if use-column[18]
