     4431   run waitfram-hide in this-procedure  .
     4432   HIDE stream DocsStream FRAME BottomFrame .
     4433   HIDE stream DocsStream FRAME x1 .
     4434   HIDE stream DocsStream FRAME top-frame .
     4435   delete widget-pool "My-pool".
     4436   output stream DocsStream CLOSE.
     4437   if Make-Excel then output stream ForExcel close.
     4438   run waitfram-hide in this-procedure .
     4439   define variable v-user-action as character no-undo .
     4440   define variable v-printed as logical   no-undo .
     4441   define variable DisabledOptions as integer   no-undo .
     4442   DisabledOptions = if p-frame-width > 137 AND  p-frame-width <= 232  then 8
     4443                     else (if p-frame-width > 232
     4444                               then 9
     4445                               else 0 ) .
     4446   run gbl/prnfilen.w
     4447     (input  ""
     4448     ,input  DisabledOptions
     4449     ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     4450     ,input  7
     4451     ,output v-user-action
     4452     ,output v-printed
     4453     ) .
