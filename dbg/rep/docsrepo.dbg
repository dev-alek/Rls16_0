       29   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       30   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       31   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       32   define variable vss-workfile    as character no-undo init "$Workfile: docsrepo.p $":U .
