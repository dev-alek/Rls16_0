      742   procedure create_obj-list :
      743      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      744      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      745      do
      746      on error undo, return error return-value
      747      :
      748         define buffer cli-obj for ub.clients .
      749         define variable p-var as integer no-undo .
      750         define buffer buf_obj-list for obj-list .
      751         find last buf_obj-list  use-index pi no-error .
      752         if available buf_obj-list
      753         then
      754            p-var = buf_obj-list.obj-id + 1.
      755         else
      756            p-var = 1.
      757         find first cli-obj where
      758                   cli-obj.obj-type = p-obj-type
      759               and cli-obj.obj-code = p-obj-code
      760         no-lock no-error.
      761         if available cli-obj
      762         then do:
      763            create buf_obj-list.
      764            assign
      765               buf_obj-list.obj-id   = p-var
      766               buf_obj-list.obj-code = cli-obj.obj-code
      767               buf_obj-list.obj-type = cli-obj.obj-type
      768               buf_obj-list.obj-name = cli-obj.obj-name
      769               buf_obj-list.db-num   = cli-obj.db-num
      770            .
      771         end.
      772      end.
      773   end.
