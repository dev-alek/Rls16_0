     1065   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1066   define variable v-uf-List_        like ubflt.usr-flt.List_        no-undo .
     1067   define variable v-uf-Naim         like ubflt.usr-flt.Naim         no-undo .
     1068   define variable v-uf-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1069   define variable v-uf-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1070   define variable v-uf-type-price   like ubflt.usr-flt.type-price   no-undo .
     1071   define variable v-uf-type-val     like ubflt.usr-flt.type-val     no-undo .
