     1169   end procedure.
     1170   procedure uf-get :
     1171     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1172     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1173     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1174     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1175     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1176     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1177     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1178     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1179     do
     1180     on error undo, return error
     1181     :
     1182       define buffer buf_usr-flt for ubflt.usr-flt .
     1183       define variable v-use-List_     as logical   no-undo .
     1184       define variable v-type-List_     as character no-undo .
     1185       define variable v-format-List_   as character no-undo .
     1186       define variable v-use-Naim      as logical   no-undo .
     1187       define variable v-type-Naim      as character no-undo .
     1188       define variable v-format-Naim    as character no-undo .
     1189       define variable v-use-print-graft as logical   no-undo .
     1190       define variable v-use-sort-gr     as logical   no-undo .
     1191       define variable v-use-type-price  as logical   no-undo .
     1192       define variable v-use-type-val    as logical   no-undo .
     1193       define variable v-label          as character no-undo .
     1194       define variable v-tooltip        as character no-undo .
     1195       define variable v-user-can-edit  as logical   no-undo .
     1196       define variable v-output-display as logical   no-undo .
     1197       define variable v-other          as character no-undo .
     1198       run uf-name in this-procedure
     1199          (input  entry(1, p-code, chr(4))
     1200         ,output v-use-List_
     1201         ,output v-type-List_
     1202         ,output v-format-List_
     1203         ,output v-use-Naim
     1204         ,output v-type-Naim
     1205         ,output v-format-Naim
     1206         ,output v-use-print-graft
     1207         ,output v-use-sort-gr
     1208         ,output v-use-type-price
     1209         ,output v-use-type-val
     1210         ,output v-label
     1211         ,output v-tooltip
     1212         ,output v-user-can-edit
     1213         ,output v-output-display
     1214         ,output v-other
     1215         ) no-error .
     1216       if error-status :error then do:
     1217         undo, return error return-value .
     1218       end.
     1219       find first buf_usr-flt no-lock where
     1220                  buf_usr-flt.Call-point     = p-code AND
     1221                  buf_usr-flt.user-name       = p-user-name
     1222         no-error .
     1223       if avail buf_usr-flt then do:
     1224         assign
     1225         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
     1226         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
     1227         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
     1228         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
     1229         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
     1230         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
     1231         .
     1232       end.
     1233       else do:
     1234         assign
     1235         p-List_        = (if v-use-List_       then "":U                    else ?)
     1236         p-Naim         = (if v-use-Naim        then "":U                    else ?)
     1237         p-print-graft  = (if v-use-print-graft then no                      else ?)
     1238         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
     1239         p-type-price   = (if v-use-type-price  then no                      else ?)
     1240         p-type-val     = (if v-use-List_       then no                      else ?)
     1241         .
     1242       end.
     1243     end.
     1244   end procedure.
     1245   procedure uf-set :
     1246     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1247     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1248     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1249     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1250     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1251     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1252     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1253     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1254     do
     1255     on error undo, return error
     1256     :
     1257       define buffer buf_usr-flt for ubflt.usr-flt .
     1258       define variable v-use-List_     as logical   no-undo .
     1259       define variable v-type-List_     as character no-undo .
     1260       define variable v-format-List_   as character no-undo .
     1261       define variable v-use-Naim      as logical   no-undo .
     1262       define variable v-type-Naim      as character no-undo .
     1263       define variable v-format-Naim    as character no-undo .
     1264       define variable v-use-print-graft as logical   no-undo .
     1265       define variable v-use-sort-gr   as logical   no-undo .
     1266       define variable v-use-type-price as logical   no-undo .
     1267       define variable v-use-type-val  as logical   no-undo .
     1268       define variable v-tooltip        as character no-undo .
     1269       define variable v-label          as character no-undo .
     1270       define variable v-user-can-edit  as logical   no-undo .
     1271       define variable v-output-display as logical   no-undo .
     1272       define variable v-other          as character no-undo .
     1273       run uf-name in this-procedure
     1274         (input  entry(1, p-code, chr(4))
     1275         ,output v-use-List_
     1276         ,output v-type-List_
     1277         ,output v-format-List_
     1278         ,output v-use-Naim
     1279         ,output v-type-Naim
     1280         ,output v-format-Naim
     1281         ,output v-use-print-graft
     1282         ,output v-use-sort-gr
     1283         ,output v-use-type-price
     1284         ,output v-use-type-val
     1285         ,output v-label
     1286         ,output v-tooltip
     1287         ,output v-user-can-edit
     1288         ,output v-output-display
     1289         ,output v-other
     1290         ) no-error .
     1291       if error-status :error then do:
     1292         undo, return error return-value .
     1293       end.
     1294       find first buf_usr-flt where
     1295                  buf_usr-flt.Call-point     = p-code AND
     1296                  buf_usr-flt.user-name       = p-user-name
     1297         no-error .
     1298       if not avail buf_usr-flt then do:
     1299           create buf_usr-flt .
     1300           assign
     1301           buf_usr-flt.call-point = p-code
     1302           buf_usr-flt.user-name  = p-user-name
     1303           .
     1304       end.
     1305       if avail buf_usr-flt then do:
     1306        assign
     1307        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
     1308        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
     1309        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
     1310        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
     1311        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
     1312        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
     1313       .
     1314       release buf_usr-flt.
     1315       end.
     1316       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
     1317     end.
     1318   end procedure.
     1319   CREATE WIDGET-POOL.
     1320   define variable v-wth-pl-list     as character    no-undo.
     1321   define variable v-wth-list         as character    no-undo.
     1322   DEFINE BUTTON bt-wth-pl
     1323        IMAGE-UP FILE "btn-down-arrow":U
     1324        IMAGE-DOWN FILE "btn-down-arrow":U
     1325        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1326        LABEL "&Изменить"
     1327        SIZE 3 BY 1.
     1328   DEFINE BUTTON bt-wth
     1329        IMAGE-UP FILE "btn-down-arrow":U
     1330        IMAGE-DOWN FILE "btn-down-arrow":U
     1331        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1332        LABEL "&Изменить"
     1333        SIZE 3 BY 1.
     1334   DEFINE VARIABLE ed-wth-pl AS CHARACTER
     1335        VIEW-AS EDITOR NO-WORD-WRAP SCROLLBAR-HORIZONTAL SCROLLBAR-VERTICAL
     1336        SIZE 43.5 BY 7.25
     1337        FGCOLOR 4  NO-UNDO.
     1338   DEFINE VARIABLE ed-wth AS CHARACTER
     1339        VIEW-AS EDITOR NO-WORD-WRAP SCROLLBAR-HORIZONTAL SCROLLBAR-VERTICAL
     1340        SIZE 43.5 BY 7.25
     1341        FGCOLOR 4  NO-UNDO.
     1342   DEFINE VARIABLE rs-wth-pl AS INTEGER
     1343        VIEW-AS RADIO-SET VERTICAL
     1344        RADIO-BUTTONS
     1345             "Все", 1,
     1346   "Выборочно", 2
     1347        SIZE 12 BY 2 NO-UNDO.
     1348   DEFINE VARIABLE rs-wth AS INTEGER
     1349        VIEW-AS RADIO-SET VERTICAL
     1350        RADIO-BUTTONS
     1351             "Все", 1,
     1352   "Выборочно", 2
     1353        SIZE 12 BY 2 NO-UNDO.
     1354   DEFINE RECTANGLE RECT-7
     1355        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1356        SIZE 71.38 BY 16.25.
     1357   DEFINE FRAME F-Main
     1358        "Материальные ценности:" VIEW-AS TEXT
     1359             SIZE 21 BY .67 AT ROW 2.25 COL 4 WIDGET-ID 2
     1360             FGCOLOR 4
     1361        ed-wth AT ROW 2 COL 28.5 NO-LABEL WIDGET-ID 20
     1362        rs-wth AT ROW 3 COL 4 NO-LABEL WIDGET-ID 30
     1363        bt-wth AT ROW 4 COL 16 WIDGET-ID 14
     1364        "Места хранения:" VIEW-AS TEXT
     1365             SIZE 22.5 BY .67 AT ROW 10.25 COL 4
     1366             FGCOLOR 4
     1367        ed-wth-pl AT ROW 10 COL 28.5 NO-LABEL WIDGET-ID 28
     1368        rs-wth-pl AT ROW 11 COL 4 NO-LABEL WIDGET-ID 34
     1369        bt-wth-pl AT ROW 12 COL 16 WIDGET-ID 18
     1370        RECT-7 AT ROW 1.25 COL 2
     1371       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1372            SIDE-LABELS NO-UNDERLINE THREE-D
     1373            AT COL 1 ROW 1 SCROLLABLE
     1374            BGCOLOR 8 .
     1375   IF NOT THIS-PROCEDURE:PERSISTENT THEN DO:
     1376     MESSAGE "c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\rep\e-wthres.w should only be RUN PERSISTENT.":U
     1377             VIEW-AS ALERT-BOX ERROR BUTTONS OK.
     1378     RETURN.
     1379   END.
     1380   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1381   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1382   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1383   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1384   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1385   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1386   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1387   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1388         adm-object-hdl = FRAME F-Main:HANDLE.
     1389   RUN ensure-broker.
     1390   THIS-PROCEDURE:ADM-DATA =
     1391        'ADM1.1~`':U +
     1392        'SmartViewer~`':U +
     1393        '~`':U +
     1394        'NO ~`':U +
     1395        '~`':U +
     1396        '~`':U +
     1397        '~`':U +
     1398        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1399           + "~`":U +
     1400        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
     1401        'Record-Source,Record-Target,TableIO-Target~`':U +
     1402        '~`':U +
     1403        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1404        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1405            THEN "^^":U
     1406        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1407             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1408   PROCEDURE adm-apply-entry :
     1409     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1410   END PROCEDURE.
     1411   PROCEDURE adm-destroy :
     1412    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1413   END PROCEDURE.
     1414   PROCEDURE adm-disable :
     1415       DISABLE RECT-7 ed-wth-pl rs-wth-pl bt-wth-pl ed-wth rs-wth bt-wth WITH FRAME F-Main.
     1416       RUN dispatch ('disable-fields':U).
     1417       RUN set-attribute-list ('ENABLED=no':U).
     1418       RETURN.
     1419   END PROCEDURE.
     1420   PROCEDURE adm-edit-attribute-list :
     1421         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
     1422         RETURN.
     1423   END PROCEDURE.
     1424   PROCEDURE adm-enable :
     1425       ENABLE UNLESS-HIDDEN RECT-7 ed-wth-pl rs-wth-pl bt-wth-pl ed-wth rs-wth bt-wth WITH FRAME F-Main.
     1426       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1427       RUN set-attribute-list ('ENABLED=yes':U).
     1428       RETURN.
     1429   END PROCEDURE.
     1430   PROCEDURE adm-exit :
     1431        RUN notify ('exit':U).
     1432     RETURN.
     1433   END PROCEDURE.
     1434   PROCEDURE adm-hide :
     1435     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1436   END PROCEDURE.
     1437   PROCEDURE adm-initialize :
     1438     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1439   END PROCEDURE.
     1440   PROCEDURE adm-show-errors :
     1441       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1442       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1443           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1444       END.
     1445       RETURN.
     1446   END PROCEDURE.
     1447   PROCEDURE adm-UIB-mode :
     1448     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1449   END PROCEDURE.
     1450   PROCEDURE adm-view :
     1451     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1452   END PROCEDURE.
     1453   PROCEDURE dispatch :
     1454       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1455       RUN broker-dispatch IN adm-broker-hdl
     1456           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1457       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1458   END PROCEDURE.
     1459   PROCEDURE ensure-broker :
     1460   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1461   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1462   DO:
     1463       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1464       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1465   END.
     1466   END PROCEDURE.
     1467   PROCEDURE get-attribute :
     1468     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1469     RUN broker-get-attribute IN adm-broker-hdl
     1470         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1471     RETURN RETURN-VALUE.
     1472   END PROCEDURE.
     1473   PROCEDURE get-attribute-list :
     1474     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1475     RUN broker-get-attribute-list IN adm-broker-hdl
     1476         (INPUT THIS-PROCEDURE,
     1477          INPUT ?,
     1478          OUTPUT p-attr-list) NO-ERROR.
     1479     RETURN.
     1480   END PROCEDURE.
     1481   PROCEDURE new-state :
     1482     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1483     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1484     RETURN.
     1485   END PROCEDURE.
     1486   PROCEDURE notify :
     1487     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1488     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1489     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1490         RETURN "ADM-ERROR":U.
     1491     RETURN.
     1492   END PROCEDURE.
     1493   PROCEDURE set-attribute-list :
     1494     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1495     RUN ensure-broker.
     1496     RUN broker-set-attribute-list IN adm-broker-hdl
     1497         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1498     RETURN.
     1499   END PROCEDURE.
     1500   PROCEDURE set-position :
     1501       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1502       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1503       IF VALID-HANDLE(adm-object-hdl) THEN
     1504       DO:
     1505         ASSIGN adm-object-hdl:ROW    =   p-row
     1506                adm-object-hdl:COLUMN =   p-col.
     1507       END.
     1508       RETURN.
     1509   END PROCEDURE.
     1510   PROCEDURE adm-display-fields :
     1511       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1512       RETURN.
     1513   END PROCEDURE.
     1514   PROCEDURE adm-open-query :
     1515     RETURN.
     1516   END PROCEDURE.
     1517   PROCEDURE adm-row-changed :
     1518         IF VALID-HANDLE(adm-object-hdl) THEN
     1519           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1520         RUN notify ('row-available':U).
     1521         RETURN.
     1522   END PROCEDURE.
     1523   PROCEDURE reposition-query :
     1524       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1525       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1526       RETURN.
     1527   END PROCEDURE.
     1528     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1529     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1530     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1531     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1532     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1533     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1534     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1535     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1536     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1537     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1538     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1539     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1540     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1541     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1542     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1543     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1544     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1545     IF "":U = "":U THEN
     1546       RUN modify-list-attribute IN adm-broker-hdl
     1547         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1548     RUN use-create-on-add(?).
     1549   PROCEDURE adm-add-record :
     1550       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1551          "must have at least one Enabled Table to perform Add.":U
     1552          VIEW-AS ALERT-BOX ERROR.
     1553       RETURN.
     1554   END PROCEDURE.
     1555   PROCEDURE adm-assign-record :
     1556    MESSAGE
     1557          "Object ":U THIS-PROCEDURE:FILE-NAME
     1558            "must have at least one Enabled Table to perform Assign.":U
     1559              VIEW-AS ALERT-BOX ERROR.
     1560      RETURN.
     1561     END PROCEDURE.
     1562   PROCEDURE adm-assign-statement :
     1563     RETURN.
     1564   END PROCEDURE.
     1565   PROCEDURE adm-cancel-record :
     1566      RETURN.
     1567     END PROCEDURE.
     1568   PROCEDURE adm-copy-record :
     1569       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1570        "must have at least one Enabled Table to perform Copy.":U
     1571          VIEW-AS ALERT-BOX ERROR.
     1572       RETURN.
     1573   END PROCEDURE.
     1574   PROCEDURE adm-create-record :
     1575      RETURN.
     1576   END PROCEDURE.
     1577   PROCEDURE adm-current-changed :
     1578     RETURN.
     1579   END PROCEDURE.
     1580   PROCEDURE adm-delete-record :
     1581    MESSAGE
     1582          "Object ":U THIS-PROCEDURE:FILE-NAME
     1583            "must have at least one Enabled Table to perform Delete.":U
     1584              VIEW-AS ALERT-BOX ERROR.
     1585       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1586       RETURN.
     1587   END PROCEDURE.
     1588   PROCEDURE adm-disable-fields :
     1589         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1590       RETURN.
     1591   END PROCEDURE.
     1592   PROCEDURE adm-enable-fields :
     1593       RETURN.
     1594   END PROCEDURE.
     1595   PROCEDURE adm-end-update :
     1596     RETURN.
     1597   END PROCEDURE.
     1598   PROCEDURE adm-reset-record :
     1599       RETURN.
     1600   END PROCEDURE.
     1601   PROCEDURE adm-update-record :
     1602       MESSAGE
     1603         "Object ":U THIS-PROCEDURE:FILE-NAME
     1604           "must have at least one Enabled Table to perform Update.":U
     1605             VIEW-AS ALERT-BOX ERROR.
     1606      RETURN.
     1607   END PROCEDURE.
     1608   PROCEDURE check-modified :
     1609   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1610   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1611   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1612   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1613     IF check-state = "check":U THEN
     1614     DO:
     1615       RUN get-link-handle IN adm-broker-hdl
     1616         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1617            OUTPUT group-target-list).
     1618       IF group-target-list NE "":U THEN
     1619       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1620         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1621         RUN check-modified IN curr-widget ('group-check':U).
     1622         IF RETURN-VALUE NE "":U THEN
     1623         DO:
     1624           RUN check-modified-message(RETURN-VALUE).
     1625           RETURN "":U.
     1626         END.
     1627       END.
     1628     END.
     1629     RETURN "":U.
     1630   END PROCEDURE.
     1631   PROCEDURE check-modified-message :
     1632     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1633        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1634           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1635        IF RETURN-VALUE = "YES":U THEN
     1636           RUN notify ('view,CONTAINER-SOURCE':U).
     1637        MESSAGE IF p-changed-table NE ? THEN
     1638           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1639           ELSE "Current values have been changed."
     1640           SKIP "  Do you wish to save those changes?"
     1641           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1642        IF ANS THEN
     1643        DO:
     1644           IF group-assign-target THEN
     1645             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1646           ELSE RUN dispatch('update-record':U).
     1647           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1648           DO:
     1649               MESSAGE "Changes to the previous record were not saved."
     1650                 VIEW-AS ALERT-BOX ERROR.
     1651               IF group-assign-target THEN
     1652                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1653               ELSE RUN dispatch ('cancel-record':U).
     1654           END.
     1655        END.
     1656        ELSE DO:
     1657          IF group-assign-target THEN
     1658             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1659          ELSE RUN dispatch('cancel-record':U).
     1660        END.
     1661        RETURN.
     1662   END PROCEDURE.
     1663   PROCEDURE get-rowid :
     1664       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1665       ASSIGN
     1666       p-table   =   adm-first-table.
     1667       RETURN.
     1668   END PROCEDURE.
     1669   PROCEDURE init-group-assign :
     1670       RUN request-attribute IN adm-broker-hdl
     1671         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1672       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1673         group-assign-target = yes.
     1674       ELSE group-assign-target = no.
     1675       RETURN.
     1676   END PROCEDURE.
     1677   PROCEDURE set-editors :
     1678       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1679       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1680       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1681       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1682       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1683       DO WHILE VALID-HANDLE (curr-widget):
     1684           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1685              curr-widget:HIDDEN = no THEN DO:
     1686             CASE p-field-setting:
     1687               WHEN "INITIALIZE":U THEN
     1688               DO:
     1689                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1690                     read-only-list +
     1691                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1692                        STRING(curr-widget).
     1693               END.
     1694               WHEN "DISABLE":U OR
     1695               WHEN "ENABLE":U THEN
     1696               DO:
     1697                   curr-widget:SENSITIVE = yes.
     1698                   RUN get-attribute ('Read-Only-Editors':U).
     1699                   IF RETURN-VALUE = ? OR
     1700                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1701                       curr-widget:READ-ONLY =
     1702                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1703               END.
     1704               WHEN "CLEAR":U THEN
     1705                   curr-widget:SCREEN-VALUE = "":U.
     1706             END CASE.
     1707           END.
     1708           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1709       END.
     1710       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1711         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1712           + '"':U).
     1713       RETURN.
     1714   END PROCEDURE.
     1715   PROCEDURE use-check-modified-all :
     1716    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1717     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1718     RETURN.
     1719   END PROCEDURE.
     1720   PROCEDURE use-create-on-add :
     1721   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1722      RETURN.
     1723   END PROCEDURE.
     1724   PROCEDURE use-initial-lock :
     1725     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1726     ASSIGN adm-initial-lock = p-attr-value.
     1727     RETURN.
     1728   END PROCEDURE.
     1729     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1730   ASSIGN
     1731          FRAME F-Main:SCROLLABLE       = FALSE
     1732          FRAME F-Main:HIDDEN           = TRUE.
     1733   ASSIGN
     1734          ed-wth-pl:READ-ONLY IN FRAME F-Main        = TRUE.
     1735   ASSIGN
     1736          ed-wth:READ-ONLY IN FRAME F-Main        = TRUE.
     1737   ON CHOOSE OF bt-wth-pl IN FRAME F-Main
     1738   DO:
     1739       assign
     1740         rs-wth-pl = 2
     1741       .
     1742       run select-wth-pl in this-procedure.
     1743       display
     1744         rs-wth-pl
     1745         ed-wth-pl
     1746       with frame F-Main.
     1747   END.
     1748   ON CHOOSE OF bt-wth IN FRAME F-Main
     1749   DO:
     1750       assign
     1751         rs-wth = 2
     1752       .
     1753       run select-wth in this-procedure.
     1754       display
     1755         rs-wth
     1756         ed-wth
     1757       with frame F-Main.
     1758   END.
     1759   ON VALUE-CHANGED OF rs-wth-pl IN FRAME F-Main
     1760   DO:
     1761     assign
     1762       rs-wth-pl
     1763     .
     1764     case rs-wth-pl:
     1765       when 1 then do:
     1766         assign
     1767           ed-wth-pl      = "Все"
     1768         .
     1769         display
     1770           ed-wth-pl
     1771         with frame F-Main.
     1772       end.
     1773       when 2 then do:
     1774         apply "choose" to bt-wth-pl.
     1775       end.
     1776       otherwise do:
     1777         return no-apply.
     1778       end.
     1779     end case.
     1780   END.
     1781   ON VALUE-CHANGED OF rs-wth IN FRAME F-Main
     1782   DO:
     1783     define buffer buf_wealth for ub.wealth.
     1784     assign
     1785       rs-wth
     1786     .
     1787     case rs-wth :
     1788       when 1 then do:
     1789         assign
     1790           ed-wth      = "Все"
     1791           v-wth-list  = ""
     1792         .
     1793         for each buf_wealth
     1794           where buf_wealth.is-ser = 1
     1795             and buf_wealth.stts   = 0
     1796            no-lock
     1797         :
     1798           assign
     1799             v-wth-list = v-wth-list + string(buf_wealth.wth-code) + chr(44)
     1800           .
     1801         end.
     1802         display
     1803           ed-wth
     1804         with frame F-Main.
     1805       end.
     1806       when 2 then do:
     1807         apply "choose" to bt-wth.
     1808       end.
     1809       otherwise do:
     1810         return no-apply.
     1811       end.
     1812     end case.
     1813   END.
     1814   PROCEDURE convert-wth-code :
     1815     define input  parameter p-code-list   as character no-undo .
     1816     define output parameter p-recid-list  as character no-undo .
     1817     define buffer buf_wealth for ub.wealth.
     1818     define variable v-i               as integer   no-undo .
     1819     do
     1820     on error undo, return error return-value
     1821     :
     1822       do v-i = 1 to num-entries( p-code-list )
     1823       :
     1824         find first buf_wealth
     1825           where buf_wealth.wth-code = integer( entry( v-i, p-code-list ) )
     1826            no-lock
     1827            no-error
     1828            .
     1829         if available buf_wealth
     1830         then do:
     1831           assign
     1832             p-recid-list = p-recid-list + string( recid(buf_wealth) ) + chr(44)
     1833           .
     1834         end.
     1835       end.
     1836       assign
     1837         p-recid-list = trim( p-recid-list, chr(44) )
     1838       .
     1839     end.
     1840   END PROCEDURE.
     1841   PROCEDURE convert-wth-recid :
     1842     define input  parameter p-recid-list  as character no-undo .
     1843     define output parameter p-code-list   as character no-undo .
     1844     define buffer buf_wealth for ub.wealth.
     1845     define variable v-i               as integer   no-undo .
     1846     do
     1847     on error undo, return error return-value
     1848     :
     1849       do v-i = 1 to num-entries( p-recid-list )
     1850       :
     1851         find first buf_wealth no-lock
     1852           where recid(buf_wealth) = integer( entry( v-i, p-recid-list ) )
     1853         no-error .
     1854         if available buf_wealth
     1855         then do:
     1856           assign
     1857             p-code-list = p-code-list + string( buf_wealth.wth-code ) + chr(44)
     1858           .
     1859         end.
     1860       end.
     1861       assign
     1862         p-code-list = trim( p-code-list, chr(44) )
     1863       .
     1864     end.
     1865   END PROCEDURE.
     1866   PROCEDURE disable_UI :
     1867     HIDE FRAME F-Main.
     1868     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1869   END PROCEDURE.
     1870   PROCEDURE local-apply-layout :
     1871     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     1872   END PROCEDURE.
     1873   PROCEDURE local-initialize :
     1874       define buffer buf_wealth  for ub.wealth.
     1875       define buffer buf_wth-place for ub.wth-place .
     1876      define variable v-value-character as character no-undo .
     1877      define variable v-value-date as date no-undo .
     1878      define variable v-value-decimal as decimal no-undo .
     1879      define variable v-value-integer as INTEGER no-undo .
     1880      define variable v-value-logical AS LOGICAL no-undo .
     1881      define variable v-param-type as character no-undo .
     1882       define variable v-rs-wth-pl      as logical   no-undo.
     1883       define variable v-rs-wth          as logical   no-undo.
     1884       define variable v-void-logical-3        as logical      no-undo.
     1885       define variable v-void-logical-4        as logical      no-undo.
     1886       define variable v-found                 as logical      no-undo.
     1887       define variable v-i               as integer   no-undo .
     1888      define variable v-wth-pl-lst     as character    no-undo.
     1889      define variable v-wth-lst         as character    no-undo.
     1890   do
     1891   on error undo, return error
     1892   :
     1893      RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1894       run uf-get (
     1895             input "wthres":U
     1896           , input v-cntxt-userid
     1897           , output v-wth-pl-lst
     1898           , output v-wth-list
     1899           , output v-rs-wth-pl
     1900           , output v-rs-wth
     1901           , output v-void-logical-3
     1902           , output v-void-logical-4
     1903       ) no-error.
     1904       if error-status :error = false
     1905       then do:
     1906         if v-rs-wth-pl = no
     1907         then do:
     1908           assign
     1909             rs-wth-pl  = 1
     1910             ed-wth-pl  = "Все":u
     1911           .
     1912         end.
     1913         else do:
     1914            assign
     1915               rs-wth-pl = 2
     1916               v-wth-pl-list = "":U
     1917            .
     1918            _flt-grp-load:
     1919            do v-i = 1 to num-entries(v-wth-pl-lst)
     1920            :
     1921               find first buf_wth-place
     1922                  where RECID(buf_wth-place) = integer( entry( v-i, v-wth-pl-lst, chr(44) ) )
     1923                  no-lock
     1924                  no-error
     1925                  .
     1926               if available buf_wth-place
     1927               then do:
     1928                  assign
     1929                  ed-wth-pl = ed-wth-pl + buf_wth-place.w-p-name + chr(10)
     1930                  v-wth-pl-list = IF v-wth-pl-list = "":U THEN entry( v-i, v-wth-pl-lst, chr(44) )
     1931                                                            ELSE v-wth-pl-list + chr(44) + entry( v-i, v-wth-pl-lst, chr(44) )
     1932                  .
     1933               end.
     1934            end.
     1935            end.
     1936         if v-rs-wth = no
     1937         then do:
     1938           assign
     1939             rs-wth  = 1
     1940             ed-wth  = "Все":u
     1941           .
     1942         end.
     1943         else do:
     1944           assign
     1945             rs-wth = 2
     1946             v-wth-list = "":U
     1947           .
     1948            do v-i = 1 to num-entries(v-wth-lst)
     1949            :
     1950               find first buf_wealth
     1951                  where buf_wealth.wth-code = integer( entry( v-i, v-wth-lst, chr(44) ) )
     1952                  no-lock
     1953                  no-error
     1954                  .
     1955               if available buf_wealth
     1956               then do:
     1957                  assign
     1958                  ed-wth = ed-wth + buf_wealth.wth-name + chr(10)
     1959                  v-wth-list = IF v-wth-list = "":U THEN entry( v-i, v-wth-lst, chr(44) )
     1960                                                   ELSE v-wth-list + chr(44) + entry( v-i, v-wth-lst, chr(44) )
     1961                  .
     1962               end.
     1963            end.
     1964            end.
     1965         display
     1966           rs-wth-pl
     1967           rs-wth
     1968           ed-wth-pl
     1969           ed-wth
     1970         with frame F-Main.
     1971       end.
     1972   end.
     1973   END PROCEDURE.
     1974   PROCEDURE my-report :
     1975       define variable v-begin-date            as date         no-undo.
     1976       define variable v-end-date              as date         no-undo.
     1977       define variable v-begin-shift           as integer      no-undo.
     1978       define variable v-end-shift             as integer      no-undo.
     1979       define variable v-counter               as integer      no-undo.
     1980       define variable v-ext-doc-type-list     as character    no-undo.
     1981   do
     1982   on error undo, return error
     1983   :
     1984      IF v-wth-pl-list = "":U
     1985      THEN DO:
     1986         message
     1987            "Не выбран список мест хранения"
     1988            skip
     1989         view-as alert-box information.
     1990         return no-apply.
     1991      END.
     1992      IF v-wth-list = "":U
     1993      THEN DO:
     1994         message
     1995            "Не выбран список материальных ценностей"
     1996            skip
     1997         view-as alert-box information.
     1998         return no-apply.
     1999      END.
     2000      assign
     2001         v-begin-date  = x-Date-Start
     2002         v-end-date    = x-Date-End
     2003         v-begin-shift = x-Shift-Start
     2004         v-end-shift   = x-Shift-End
     2005      .
     2006      run uf-set (
     2007            input "wthres":U
     2008         , input  v-cntxt-userid
     2009         , input v-wth-pl-list
     2010         , input v-wth-list
     2011         , input ( if rs-wth-pl = 1 then no else yes )
     2012         , input ( if rs-wth    = 1 then no else yes )
     2013         , input no
     2014         , input no
     2015      ) .
     2016      run rep/r-wthres.p  ( input my-handle
     2017                          , input (rs-wth    = 1)
     2018                          , input (rs-wth-pl = 1)
     2019                          , input v-wth-list
     2020                          , input v-wth-pl-list
     2021                          ) .
     2022   end.
     2023   END PROCEDURE.
     2024   PROCEDURE my-var :
     2025     assign
     2026       ReportHeader =  ReportHeader + "Группы объектов: " + chr(10) + ed-wth-pl + chr(10) + chr(10) +
     2027                       "Материальные ценности: " + chr(10) + ed-wth
     2028   .
     2029   END PROCEDURE.
     2030   PROCEDURE select-wth-pl :
     2031   define buffer buf_wth-place     for ub.wth-place .
     2032   define variable v-count    as integer      no-undo.
     2033      define variable v-wth-pl-lst    as character    no-undo.
     2034      define variable v-i    as integer      no-undo.
     2035   do
     2036   on error undo, return error
     2037   :
     2038       IF v-cntxt-db-num = 0
     2039       THEN DO:
     2040       run ref/wthplref.w
     2041         (input my-handle
     2042         ,input 'b-sel,b-mark'
     2043         ,input v-cntxt-host-code-obj
     2044         ,input v-cntxt-obj-type
     2045         ,input v-cntxt-obj-code
     2046         ,input 'фирма':U
     2047         ,input-output v-wth-pl-lst
     2048         ).
     2049       END.
     2050       ELSE DO:
     2051         run ref/wthplref.w
     2052           (input my-handle
     2053           ,input 'b-sel,b-mark':u
     2054           ,input v-cntxt-host-code-obj
     2055           ,input v-cntxt-obj-type
     2056           ,input v-cntxt-obj-code
     2057           ,input 'объект':U
     2058           ,input-output v-wth-pl-lst
     2059           ).
     2060       END.
     2061       do v-i = 1 to num-entries(v-wth-pl-lst)
     2062         :
     2063         find first buf_wth-place
     2064               where RECID(buf_wth-place) = integer( entry( v-i, v-wth-pl-lst, chr(44) ) )
     2065               no-lock
     2066               no-error
     2067               .
     2068            if available buf_wth-place
     2069            then do:
     2070            assign
     2071               ed-wth-pl = ed-wth-pl + buf_wth-place.w-p-name + chr(10)
     2072               v-wth-pl-list = IF v-wth-pl-list = "":U THEN entry( v-i, v-wth-pl-lst, chr(44) )
     2073                                                      ELSE v-wth-pl-list + chr(44) + entry( v-i, v-wth-pl-lst, chr(44) )
     2074            .
     2075            end.
     2076       end.
     2077   end.
     2078   END PROCEDURE.
     2079   PROCEDURE select-wth :
     2080   do
     2081   on error undo, return error
     2082   :
     2083     define buffer buf_wealth for ub.wealth.
     2084     define variable v-wth-recid-list  as character no-undo .
     2085     define variable v-i               as integer   no-undo .
     2086     run convert-wth-code in this-procedure ( input v-wth-list
     2087                                            , output v-wth-recid-list
     2088                                            ).
     2089      run ref/wth-ref.w ( INPUT my-handle
     2090                        , INPUT "b-sel,b-mark"
     2091                        , INPUT v-cntxt-host-code-obj
     2092                        , INPUT v-cntxt-obj-type
     2093                        , INPUT v-cntxt-obj-code
     2094                        , INPUT 'wth-ser'
     2095                       , INPUT-OUTPUT v-wth-recid-list
     2096                       ) .
     2097     assign
     2098       ed-wth = "":u
     2099     .
     2100     do v-i = 1 to num-entries( v-wth-recid-list )
     2101     :
     2102       find first buf_wealth no-lock
     2103         where recid(buf_wealth) = integer( entry( v-i, v-wth-recid-list ) )
     2104       no-error .
     2105       if available buf_wealth
     2106       then do:
     2107         assign
     2108           ed-wth = ed-wth + buf_wealth.wth-name + chr(10)
     2109         .
     2110       end.
     2111     end.
     2112     run convert-wth-recid in this-procedure ( input v-wth-recid-list
     2113                                             , output v-wth-list
     2114                        ) .
     2115     display
     2116       ed-wth
     2117     with frame F-Main.
     2118   end.
     2119   END PROCEDURE.
