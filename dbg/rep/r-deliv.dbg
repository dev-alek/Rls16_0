      681   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      682   procedure cur-time :
      683      define output parameter p-today as date      no-undo .
      684      define output parameter p-time  as integer   no-undo .
      685     do
      686     on error undo, return error
      687     :
      688       define variable v-date1 as date      no-undo .
      689       define variable v-date2 as date      no-undo .
      690       define variable v-time  as integer   no-undo .
      691       assign
      692         v-date1 = today
      693         v-time  = time
      694         v-date2 = today
      695       .
      696       if v-date1 <> v-date2
      697       then do:
      698         assign
      699           v-date1 = today
      700           v-time  = v-time
      701         .
      702       end.
      703       assign
      704         p-today = v-date1
      705         p-time  = v-time
      706       .
      707     end.
      708   end.
      709   function cur-time-date returns character
      710   :
      711     return string(today, '99/99/9999':U) .
      712   end.
      713   function cur-time-mjd returns decimal
      714   :
      715     define variable v-date as date      no-undo .
      716     define variable v-time as integer   no-undo .
      717     run cur-time in this-procedure
      718       (output v-date
      719       ,output v-time
      720       ) .
      721     return integer(v-date) - 2400002 + (v-time / 86400) .
      722   end.
      723   function cur-time-get-ending-index returns integer
      724   (input p-number as integer
      725   )
      726   :
      727     if p-number < 0
      728     or p-number = ?
      729     then do:
      730       return 1 .
      731     end.
      732     define variable v-rest as integer   no-undo .
      733     assign
      734       p-number = p-number modulo 100
      735     .
      736     if p-number < 20
      737     then do:
      738       assign
      739         v-rest = p-number
      740       .
      741     end.
      742     else do:
      743       assign
      744         v-rest = p-number modulo 10
      745       .
      746     end.
      747     case v-rest :
      748       when 1
      749       then do:
      750         return 2 .
      751       end.
      752       when 2 or
      753       when 3 or
      754       when 4
      755       then do:
      756         return 3 .
      757       end.
      758       otherwise do:
      759         return 1 .
      760       end.
      761     end case .
      762   end.
      763   procedure cur-time-mjd-to-date :
      764      define input  parameter i-mjd-diff as decimal no-undo.
      765      define output parameter o-Date     as date    no-undo.
      766      define output parameter o-Time     as integer no-undo.
      767      define variable v-day-number as integer   no-undo .
      768      if    i-mjd-diff < 0
      769         or i-mjd-diff = ?
      770      then do:
      771         return "?" .
      772      end.
      773      assign
      774         v-day-number = truncate(i-mjd-diff,0).
      775         o-Date = date(v-day-number + 2400002).
      776         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      777     .
      778   end.
      779   function cur-time-mjd-to-string returns character
      780   (input p-mjd-diff as decimal
      781   )
      782   :
      783     define variable v-day-number as integer   no-undo .
      784     define variable v-seconds    as integer   no-undo .
      785     define variable v-hour       as integer   no-undo .
      786     define variable v-min        as integer   no-undo .
      787     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      788     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      789     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      790     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      791     if p-mjd-diff < 0
      792     or p-mjd-diff = ?
      793     then do:
      794       return "?" .
      795     end.
      796     assign
      797       v-day-number = integer(truncate(p-mjd-diff,0))
      798       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      799     .
      800     if v-seconds > 86400
      801     then do:
      802       assign
      803         v-seconds = 86400 - 1
      804       .
      805     end.
      806     if v-seconds < 0
      807     then do:
      808       assign
      809         v-seconds = 0
      810       .
      811     end.
      812     assign
      813       v-hour = truncate(v-seconds / 3600, 0)
      814     .
      815     assign
      816       v-seconds = v-seconds modulo 3600
      817     .
      818     assign
      819       v-min = truncate(v-seconds / 60, 0)
      820     .
      821     assign
      822       v-seconds = v-seconds modulo 60
      823     .
      824     return
      825         (if v-day-number <> 0
      826           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      827           else ""
      828         )
      829       + (if v-day-number <> 0 or v-hour <> 0
      830           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      831           else ""
      832         )
      833       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      834           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      835           else ""
      836         )
      837       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      838       .
      839   end.
      840   function cur-time-string returns character
      841   :
      842     define variable v-date as date      no-undo .
      843     define variable v-time as integer   no-undo .
      844     run cur-time in this-procedure
      845       (output v-date
      846       ,output v-time
      847       ) .
      848     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      849   end.
      850   function cur-time-string-sec returns character
      851   :
      852     define variable v-date as date      no-undo .
      853     define variable v-time as integer   no-undo .
      854     run cur-time in this-procedure
      855       (output v-date
      856       ,output v-time
      857       ) .
      858     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      859   end.
      860   function cur-time-custom  returns character
      861   (input p-prefix as character
      862   ,input p-date-format as character
      863   ,input p-delimiter as character
      864   ,input p-time-format as character
      865   ,input p-suffix as character
      866   )
      867   :
      868     define variable v-date as date      no-undo .
      869     define variable v-time as integer   no-undo .
      870     run cur-time in this-procedure
      871       (output v-date
      872       ,output v-time
      873       ) .
      874     return
      875       p-prefix
      876       + string(v-date, p-date-format)
      877       + p-delimiter
      878       + string(v-time, p-time-format)
      879       + p-suffix
      880       .
      881   end.
      882   function cur-time-print  returns character
      883   :
      884     define variable v-date as date      no-undo .
      885     define variable v-time as integer   no-undo .
      886     run cur-time in this-procedure
      887       (output v-date
      888       ,output v-time
      889       ) .
      890     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      891   end.
      892   function cur-time-datetime returns datetime
      893   :
      894     define variable v-char as character no-undo .
      895     define variable v-datetime as datetime no-undo .
      896     v-char = cur-time-string().
      897     v-datetime = datetime(v-char).
      898     return  v-datetime.
      899   end.
      900   function cur-time-string-msec returns character
      901   :
      902     define variable v-date as datetime  no-undo .
      903     v-date = now.
      904     return string(v-date) .
      905   end.
