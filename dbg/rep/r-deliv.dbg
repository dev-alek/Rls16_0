      907   define new global shared variable g#trdcalib as handle no-undo.
      908   define input parameter parparentproc   as    handle  no-undo.
      909   define input parameter p-start-hour    as    integer no-undo.
      910   define input parameter p-start-min     as    integer no-undo.
      911   define input parameter p-end-hour      as    integer no-undo.
