      943   .
      944   function in-time-period returns logical
      945           ( input del-time as character ):
      946       define variable start-param  as integer no-undo.
      947       define variable end-param    as integer no-undo.
      948       define variable start-period as integer no-undo.
      949       define variable end-period   as integer no-undo.
      950       if del-time = ? or del-time = "" then return yes.
      951       start-param = p-start-hour * 60 + p-start-min.
      952       end-param = p-end-hour * 60 + p-end-min.
      953       start-period = int(entry(1, entry(1, del-time, "-"), ":")) * 60 + int(entry(2, entry(1, del-time, "-"), ":")).
      954       end-period = int(entry(1, entry(2, del-time, "-"), ":")) * 60 + int(entry(2, entry(2, del-time, "-"), ":")).
      955       if start-period >= start-param  and start-period <= end-param then return yes.
      956       if end-period >= start-param and end-period <= end-param then return yes.
      957       if start-period <= start-param and end-period >= end-param then return yes.
      958       return no.
      959   end function.
      960   procedure fill-table:
      961       define input parameter trn-doc-code as character no-undo.
      962       define variable dost as character no-undo.
      963       define variable nodate  as logical no-undo init no.
      964       define variable data-vyp as character no-undo.
      965       dost = "no".
      966   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input trn-doc.doc-code ,
      967                           input '4ord_dl':U ,
      968                          output dost ,
      969                          output p-type )  .
      970       if dost <> "yes" then return.
      971       for first trn-doc no-lock where trn-doc.doc-code = trn-doc-code:
      972           p-value = "".
      973           in-time-in = "".
      974   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input trn-doc.doc-code ,
      975                           input 'delivery-time':U ,
      976                          output in-time-in ,
