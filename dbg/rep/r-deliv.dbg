      935       field   cont-name   as character    format "X(100)":u
      936       field   cont-phone  as character    format "X(50)":u
      937       field   obj-deprtmt as character    format "x(20)":u
      938       field   nakl-summ   as decimal      format "->>>,>>>,>>9.99"
      939       field   deliv-summ  as decimal      format "->>>,>>>,>>9.99"
      940       field   pos-quan    like trn-doc.cli-qnty
      941       field   cargo-dtrm  as character    format "X(255)":u
