      927   define variable tmp-date        as character no-undo.
      928   define new shared temp-table   t-report-tmp no-undo
      929       field   deliv-date  as date         format "99.99.9999"
      930       field   deliv-time  as character    format "X(16)":u
      931       field   docum-num   like trn-doc.doc-code
      932       field   docum-stat  like trn-doc.status_
      933       field   deliv-addr  as character    format "X(255)":u
