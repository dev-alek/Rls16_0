     5118                   p6 CHR(9)
     5119                      ( excel-qnty(p-ostatok-start[1]) +  CHR(9))
     5120   if Show-cost  then  ( excel-sum(p-ostatok-start[2]) +  CHR(9))   else ("")
     5121   if Show-sale  then  ( "" +                              CHR(9))   else ("")
     5122                      ( excel-qnty(p-Prih         [1]) +  CHR(9))
     5123   if Show-cost  then  ( excel-sum(p-Prih         [2]) +  CHR(9))   else ("")
     5124   if Show-sale  then  ( excel-sum(p-Prih         [8]) +  CHR(9))   else ("")
     5125                      ( excel-qnty(p-RAsh         [1]) +  CHR(9))
     5126   if Show-cost  then  ( excel-sum(p-RAsh         [2]) +  CHR(9))   else ("")
     5127   if Show-sale  then  ( excel-sum(p-RAsh         [8]) +  CHR(9))   else ("")
     5128                      ( excel-qnty(p-KAssa        [1]) +  CHR(9))
     5129   if Show-cost  then  ( excel-sum(p-KAssa        [2]) +  CHR(9))   else ("")
     5130   if Show-sale  then  ( excel-sum(p-KAssa        [8]) +  CHR(9))   else ("")
     5131                      ( excel-qnty(p-Inv          [1]) +  CHR(9))
     5132   if Show-cost  then  ( excel-sum(p-Inv          [2]) +  CHR(9))   else ("")
     5133   if Show-sale  then  ( excel-sum(p-Inv          [8]) +  CHR(9))   else ("")
     5134                      ( excel-qnty(p-spis         [1]) +  CHR(9))
     5135   if Show-cost  then  ( excel-sum(p-spis         [2]) +  CHR(9))   else ("")
     5136   if Show-sale  then  ( excel-sum(p-spis         [8]) +  CHR(9))   else ("")
     5137                      ( excel-qnty(p-vzvr         [1]) +  CHR(9))
     5138   if Show-cost  then  ( excel-sum(p-vzvr         [2]) +  CHR(9))   else ("")
     5139   if Show-sale  then  ( excel-sum(p-vzvr         [8]) +  CHR(9))   else ("")
     5140                      ( excel-qnty(p-vzvr-post    [1]) +  CHR(9))
     5141   if Show-cost  then  ( excel-sum(p-vzvr-post    [2]) +  CHR(9))   else ("")
     5142   if Show-sale  then  ( excel-sum(p-vzvr-post    [8]) +  CHR(9))   else ("")
     5143                      ( excel-qnty(p-Ostatok-end  [1]) +  CHR(9))
     5144   if Show-cost  then  ( excel-sum(p-Ostatok-end  [2]) +  CHR(9))   else ("")
     5145   if Show-sale  then  (  "" +                             CHR(9))   else ("")
     5146      chr(10).
     5147                 End.
     5148      WHEN "O"  Then     DO :
     5149                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym11 sym12 sym13
     5150                   p3 @ gds-zap-b-code
     5151                   p4 @ gds-zap-artic
     5152                   p5 @ gds-zap-gds-name
     5153                   p6 @ gds-zap-unit-base
     5154                   p1 @ gds-type
     5155                   o-ostatok-start[p2] when ( NOT( Show-SAle = true and p2 = 8 )) @  F-ostatok-start
     5156                   o-Prih         [p2]  @  F-Prih
     5157                   o-RAsh         [p2]  @  F-RAsh
     5158                   o-KAssa        [p2]  @  F-KAssa
     5159                   o-Inv          [p2]  @  F-Inv
     5160                   o-spis         [p2]  @  F-spis
     5161                   o-vzvr         [p2]  @  F-vzvr
     5162                   o-vzvr-post    [p2]  @  F-vzvr-post
     5163                   o-Ostatok-end  [p2] when ( NOT( Show-SAle = true and p2 = 8 ))  @  F-Ostatok-end
     5164                  with FRAME ZAPAS .
     5165       if Make-Excel then  put   stream ForExcel unformatted p3 CHR(9)
     5166                   p4 CHR(9)
     5167                   p5 CHR(9)
     5168                   p6 CHR(9)
     5169                      ( excel-qnty(o-ostatok-start[1]) +  CHR(9))
     5170   if Show-cost  then  ( excel-sum(o-ostatok-start[2]) +  CHR(9))   else ("")
     5171   if Show-sale  then  ( "" +                              CHR(9))   else ("")
     5172                      ( excel-qnty(o-Prih         [1]) +  CHR(9))
     5173   if Show-cost  then  ( excel-sum(o-Prih         [2]) +  CHR(9))   else ("")
     5174   if Show-sale  then  ( excel-sum(o-Prih         [8]) +  CHR(9))   else ("")
     5175                      ( excel-qnty(o-RAsh         [1]) +  CHR(9))
     5176   if Show-cost  then  ( excel-sum(o-RAsh         [2]) +  CHR(9))   else ("")
     5177   if Show-sale  then  ( excel-sum(o-RAsh         [8]) +  CHR(9))   else ("")
     5178                      ( excel-qnty(o-KAssa        [1]) +  CHR(9))
     5179   if Show-cost  then  ( excel-sum(o-KAssa        [2]) +  CHR(9))   else ("")
     5180   if Show-sale  then  ( excel-sum(o-KAssa        [8]) +  CHR(9))   else ("")
     5181                      ( excel-qnty(o-Inv          [1]) +  CHR(9))
     5182   if Show-cost  then  ( excel-sum(o-Inv          [2]) +  CHR(9))   else ("")
     5183   if Show-sale  then  ( excel-sum(o-Inv          [8]) +  CHR(9))   else ("")
     5184                      ( excel-qnty(o-spis         [1]) +  CHR(9))
     5185   if Show-cost  then  ( excel-sum(o-spis         [2]) +  CHR(9))   else ("")
     5186   if Show-sale  then  ( excel-sum(o-spis         [8]) +  CHR(9))   else ("")
     5187                      ( excel-qnty(o-vzvr         [1]) +  CHR(9))
     5188   if Show-cost  then  ( excel-sum(o-vzvr         [2]) +  CHR(9))   else ("")
     5189   if Show-sale  then  ( excel-sum(o-vzvr         [8]) +  CHR(9))   else ("")
     5190                      ( excel-qnty(o-vzvr-post    [1]) +  CHR(9))
     5191   if Show-cost  then  ( excel-sum(o-vzvr-post    [2]) +  CHR(9))   else ("")
     5192   if Show-sale  then  ( excel-sum(o-vzvr-post    [8]) +  CHR(9))   else ("")
     5193                      ( excel-qnty(o-Ostatok-end  [1]) +  CHR(9))
     5194   if Show-cost  then  ( excel-sum(o-Ostatok-end  [2]) +  CHR(9))   else ("")
     5195   if Show-sale  then  (  "" +                             CHR(9))   else ("")
     5196      chr(10).
     5197                 End.
     5198       End case.
     5199                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     5200    END PROCEDURE.
     5201   procedure Print-Footer :
     5202   define input parameter Nx as integer no-undo .
     5203   define input parameter Name as char no-undo .
     5204       if Nx = 1 Then DO:
     5205            run di-qnty  ( "кол-во", 1,"","Итого по : ",trim ( name),"","b1").
     5206            if show-cost then do : run di  (  "учет." , 2, "","","","","b1" ).  end.
     5207            if show-sale then do : run di  (  "док-т.", 8, "","","","","b1" ).  end.
     5208            if not sums-only then
     5209               run u-line.
     5210            run clear-itemb1- in this-procedure .
     5211            End.
     5212    if Nx = 2 Then DO:
     5213            run di-qnty  ( "кол-во", 1,"","","Итого по : " + trim ( name),"","b2").
     5214            if show-cost then do : run di  (  "учет." , 2, "","","","","b2" ).  end.
     5215            if show-sale then do : run di  (  "док-т.", 8, "","","","","b2" ).  end.
     5216            if not sums-only then run u-line.
     5217            run clear-itemb2-.
     5218           end.
     5219    if nx = 3 then do:
     5220            if not sums-only then run u-line.
     5221            run di-qnty  ( "кол-во", 1,"","Итого по пост-ку" , trim ( name),"","p").
     5222            if show-cost then do : run di  (  "учет." , 2, "","","","","p" ).  end.
     5223            if show-sale then do : run di  (  "док-т.", 8, "","","","","p" ).  end.
     5224            if not sums-only then run u-line.
     5225            run clear-itemp-.
     5226             end.
     5227    if nx = 0 then do:
     5228            run di-qnty  ( "кол-во", 1,"","Итого  объект: " , trim ( name),"","o").
     5229            if show-cost then do : run di  (  "учет." , 2, "","","","","o" ).  end.
     5230            if show-sale then do : run di  (  "док-т.", 8, "","","","","o" ).  end.
     5231            if not sums-only then run u-line.
     5232            run clear-itemo-.
     5233             end.
     5234    END PROCEDURE.
     5235   PROCEDURE Clear-item :
     5236   def var kk as int no-undo.
     5237    REPEAT kk = 1 to 9:
     5238    Assign
     5239       prih             [kk]  = 0
     5240       rash             [kk]  = 0
     5241       kassa            [kk]  = 0
     5242       spis             [kk]  = 0
     5243       Inv              [kk]  = 0
     5244       vzvr             [kk]  = 0
     5245       vzvr-post        [kk]  = 0
     5246        .
     5247          End.
     5248    END PROCEDURE.
     5249   PROCEDURE Clear-itemb1- :
     5250   def var kk as int no-undo.
     5251    REPEAT kk = 1 to 9:
     5252    Assign
     5253      b1-prih             [kk]  = 0
     5254      b1-rash             [kk]  = 0
     5255      b1-kassa            [kk]  = 0
     5256      b1-spis              [kk]  = 0
     5257      b1-Inv              [kk]  = 0
     5258      b1-vzvr             [kk]  = 0
     5259      b1-vzvr-post        [kk]  = 0
     5260      b1-ostatok-end      [kk]  = 0
     5261      b1-ostatok-start    [kk]  = 0
     5262      .
     5263          End.
     5264    END PROCEDURE.
     5265   PROCEDURE Clear-itemb2- :
     5266   def var kk as int no-undo.
     5267    REPEAT kk = 1 to 9:
     5268    Assign
     5269      b2-prih             [kk]  = 0
     5270      b2-rash             [kk]  = 0
     5271      b2-kassa            [kk]  = 0
     5272      b2-spis             [kk]  = 0
     5273      b2-Inv              [kk]  = 0
     5274      b2-vzvr             [kk]  = 0
     5275      b2-vzvr-post        [kk]  = 0
     5276      b2-ostatok-end      [kk]  = 0
     5277      b2-ostatok-start    [kk]  = 0
     5278      .
     5279      End.
     5280    END PROCEDURE.
     5281   PROCEDURE Clear-itemp- :
     5282   def var kk as int no-undo.
     5283    REPEAT kk = 1 to 9:
     5284    Assign
     5285      p-prih             [kk]  = 0
     5286      p-rash             [kk]  = 0
     5287      p-kassa            [kk]  = 0
     5288      p-spis             [kk]  = 0
     5289      p-Inv              [kk]  = 0
     5290      p-vzvr             [kk]  = 0
     5291      p-vzvr-post        [kk]  = 0
     5292      p-ostatok-end      [kk]  = 0
     5293      p-ostatok-start    [kk]  = 0
     5294      .
     5295      End.
     5296    END PROCEDURE.
     5297   PROCEDURE Clear-itemo- :
     5298   def var kk as int no-undo.
     5299    REPEAT kk = 1 to 9:
     5300    Assign
     5301      o-prih             [kk]  = 0
     5302      o-rash             [kk]  = 0
     5303      o-kassa            [kk]  = 0
     5304      o-Spis             [kk]  = 0
     5305      o-Inv              [kk]  = 0
     5306      o-vzvr             [kk]  = 0
     5307      o-vzvr-post        [kk]  = 0
     5308      o-ostatok-end      [kk]  = 0
     5309      o-ostatok-start    [kk]  = 0
     5310      .
     5311      End.
     5312    END PROCEDURE.
     5313   PROCEDURE ob-line :
     5314   def input  parameter x-store-code     like ub.clients.obj-code          no-undo.
     5315   def input  parameter x-store-type     like ub.clients.obj-type          no-undo.
     5316   def input  parameter x-cli-code       like ub.clients.obj-code          no-undo.
     5317   def input  parameter x-cli-type       like ub.clients.obj-type          no-undo.
     5318   def INPUT  parameter x-artic          like post-ot-line.artic        no-undo.
     5319   def INPUT  parameter x-prod-code      like post-ot-line.prod-code    no-undo.
     5320   def INPUT  parameter x-prod-type      like post-ot-line.prod-type    no-undo.
     5321   def INPUT  parameter x-Fact-order-1   like post-ot-line.Fact-order   no-undo.
     5322   def INPUT  parameter x-Fact-order-2   like post-ot-line.Fact-order   no-undo.
     5323   def input  parameter x-sum-type       like post-ot-line.sum-type     no-undo.
     5324   def input  parameter x-cat-id         like post-ot-line.cat-id       no-undo.
     5325   def input  parameter x-ext-doc-type   like post-ot-line.ext-doc-type no-undo.
     5326   def input  parameter xTog-obj           as log no-undo .
     5327   def var  tt#          as   int                 no-undo .
     5328    if  ( x-sum-type = 'cost':U ) then tt# = 0.
     5329    if  ( x-sum-type = 'sale':U ) then tt# = 6.
     5330        FOR each post-ot-line where
     5331                 post-ot-line.artic        = x-artic
     5332           AND   post-ot-line.fact-order  <= x-fact-order-2
     5333           AND   post-ot-line.fact-order  >= x-fact-order-1
     5334           AND   post-ot-line.obj-code     = x-store-code
     5335           AND   post-ot-line.obj-type     = x-store-type
     5336           AND   post-ot-line.prod-code    = x-prod-code
     5337           AND   post-ot-line.prod-type    = x-prod-type
     5338           AND   post-ot-line.cli-code     = x-cli-code
     5339           AND   post-ot-line.cli-type     = x-cli-type
     5340           AND   post-ot-line.sum-type     = x-sum-type
     5341           AND   post-ot-line.cat-id       = x-cat-id
     5342                  no-lock :
     5343           CASE post-ot-line.ext-doc-type:
     5344                WHEN        'iv':U      OR
     5345                WHEN        'rv':U  OR
     5346                WHEN        'im':U     THEN     DO:
     5347              if t-in then
     5348              ASSIGN prih[1 + tt#]   = prih[1 + tt#]   +  post-ot-line.fact-qnty
     5349                     prih[2 + tt#]   = prih[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     5350                     prih[3 + tt#]   = prih[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base  .
     5351                    End.
     5352                WHEN        'ie':U   THEN     DO:
     5353              ASSIGN prih[1 + tt#]   = prih[1 + tt#]   +  post-ot-line.fact-qnty
     5354                     prih[2 + tt#]   = prih[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     5355                     prih[3 + tt#]   = prih[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base  .
     5356                    End.
     5357                WHEN        're':U  THEN DO:
     5358              ASSIGN vzvr[1 + tt#]   = vzvr[1 + tt#]   +  post-ot-line.fact-qnty
     5359                     vzvr[2 + tt#]   = vzvr[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     5360                     vzvr[3 + tt#]   = vzvr[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base  .
     5361                    End.
     5362                WHEN       'ep':U  THEN DO:
     5363              ASSIGN vzvr-post[1 + tt#]   = vzvr-post[1 + tt#]   +  post-ot-line.fact-qnty
     5364                     vzvr-post[2 + tt#]   = vzvr-post[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     5365                     vzvr-post[3 + tt#]   = vzvr-post[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base  .
     5366                    End.
     5367                WHEN       'ee':U          THEN  DO:
     5368                ASSIGN rash[1 + tt#]   = rash[1 + tt#]   +  post-ot-line.fact-qnty
     5369                     rash[2 + tt#]   = rash[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     5370                     rash[3 + tt#]   = rash[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base  .
     5371                    End.
     5372                WHEN       'ev':U       OR
     5373                WHEN       'em':U        THEN  DO:
     5374              if t-in then
     5375              ASSIGN rash[1 + tt#]   = rash[1 + tt#]   +  post-ot-line.fact-qnty
     5376                     rash[2 + tt#]   = rash[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     5377                     rash[3 + tt#]   = rash[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base  .
     5378                    End.
     5379                WHEN       'es':U  OR
     5380                WHEN       'rs':U THEN  DO:
     5381              ASSIGN kassa[1 + tt#]   = kassa[1 + tt#]   +  post-ot-line.fact-qnty
     5382                     kassa[2 + tt#]   = kassa[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     5383                     kassa[3 + tt#]   = kassa[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base .
     5384                    End.
     5385                WHEN       'vt':U      or
     5386                when       'vp':U   or
     5387                when       'ap':U   or
     5388                when       'mp':U or
     5389                when       'pc':U
     5390        THEN  DO:
     5391              ASSIGN INV[1 + tt#]   = INV[1 + tt#]   +  post-ot-line.fact-qnty
     5392                     Inv[2 + tt#]   = Inv[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     5393                     Inv[3 + tt#]   = Inv[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base  .
     5394                    End.
     5395                WHEN       'we':U       THEN  DO:
     5396              ASSIGN spis[1 + tt#]   = spis[1 + tt#]   +  post-ot-line.fact-qnty
     5397                     spis[2 + tt#]   = spis[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     5398                     spis[3 + tt#]   = spis[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base  .
     5399                    End.
     5400                WHEN       'wm':U       THEN  DO:
     5401              if t-in then
     5402              ASSIGN spis[1 + tt#]   = spis[1 + tt#]   +  post-ot-line.fact-qnty
     5403                     spis[2 + tt#]   = spis[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     5404                     spis[3 + tt#]   = spis[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base  .
     5405                    End.
     5406             End CASE.
     5407      End.
     5408   END PROCEDURE.
     5409   PROCEDURE Calc-Sub-itog :
     5410   def input parameter tt as int no-undo.
     5411   def var b as int no-undo.
     5412   repeat b = 1 to 3 :
     5413     Assign
     5414     B1-Prih[b + TT]    = B1-Prih[b + TT]    +  Prih[b + TT]
     5415     B2-Prih[b + TT]    = B2-Prih[b + TT]    +  Prih[b + TT]
     5416     Bi-Prih[b + TT]    = Bi-Prih[b + TT]    +  Prih[b + TT]
     5417     p-Prih[b + TT]     = p-Prih[b + TT]    +  Prih[b + TT]
     5418     o-Prih[b + TT]     = o-Prih[b + TT]    +  Prih[b + TT]
     5419     B1-RAsh[b + TT]    = B1-RAsh[b + TT]    +  RAsh[b + TT]
     5420     B2-RAsh[b + TT]    = B2-RAsh[b + TT]    +  RAsh[b + TT]
     5421     Bi-RAsh[b + TT]    = Bi-RAsh[b + TT]    +  RAsh[b + TT]
     5422     p-RAsh[b + TT]    = p-RAsh[b + TT]    +  RAsh[b + TT]
     5423     o-RAsh[b + TT]    = o-RAsh[b + TT]    +  RAsh[b + TT]
     5424     B1-KAssa[b + TT]    = B1-KAssa[b + TT]    +  KAssa[b + TT]
     5425     B2-kassa[b + TT]    = B2-kassa[b + TT]    +  kassa[b + TT]
     5426     Bi-kassa[b + TT]     = Bi-kassa[b + TT]     +  kassa[b + TT]
     5427     p-kassa[b + TT]      = p-kassa[b + TT]      +  kassa[b + TT]
     5428     o-kassa[b + TT]      = o-kassa[b + TT]      +  kassa[b + TT]
     5429     B1-Inv[b + TT]    = B1-Inv[b + TT]    +  Inv[b + TT]
     5430     B2-Inv[b + TT]    = B2-Inv[b + TT]    +  Inv[b + TT]
     5431     Bi-Inv[b + TT]    = Bi-Inv[b + TT]    +  Inv[b + TT]
     5432     p-Inv[b + TT]    = p-Inv[b + TT]    +  Inv[b + TT]
     5433     o-Inv[b + TT]    = o-Inv[b + TT]    +  Inv[b + TT]
     5434     B1-spis[b + TT]    = B1-spis[b + TT]    +  spis[b + TT]
     5435     B2-spis[b + TT]    = B2-spis[b + TT]    +  spis[b + TT]
     5436     Bi-spis[b + TT]    = Bi-spis[b + TT]    +  spis[b + TT]
     5437      p-spis[b + TT]    =  p-spis[b + TT]    +  spis[b + TT]
     5438      o-spis[b + TT]    =  o-spis[b + TT]    +  spis[b + TT]
     5439     B1-vzvr[b + TT]    = B1-vzvr[b + TT]    + vzvr[b + TT]
     5440     B2-vzvr[b + TT]    = B2-vzvr[b + TT]    + vzvr[b + TT]
     5441     Bi-vzvr[b + TT]    = Bi-vzvr[b + TT]    + vzvr[b + TT]
     5442     p-vzvr[b + TT]    = p-vzvr[b + TT]    + vzvr[b + TT]
     5443     o-vzvr[b + TT]    = o-vzvr[b + TT]    + vzvr[b + TT]
     5444     B1-vzvr-post[b + TT]    = B1-vzvr-post[b + TT]    + vzvr-post[b + TT]
     5445     B2-vzvr-post[b + TT]    = B2-vzvr-post[b + TT]    + vzvr-post[b + TT]
     5446     Bi-vzvr-post[b + TT]    = Bi-vzvr-post[b + TT]    + vzvr-post[b + TT]
     5447     p-vzvr-post[b + TT]    = p-vzvr-post[b + TT]    + vzvr-post[b + TT]
     5448     o-vzvr-post[b + TT]    = o-vzvr-post[b + TT]    + vzvr-post[b + TT]
     5449     B1-ostatok-start[b + TT]    = B1-ostatok-start[b + TT]    + ostatok-start[b + TT]
     5450     B2-ostatok-start[b + TT]    = B2-ostatok-start[b + TT]    + ostatok-start[b + TT]
     5451     Bi-ostatok-start[b + TT]    = Bi-ostatok-start[b + TT]    + ostatok-start[b + TT]
     5452     p-ostatok-start[b + TT]    = p-ostatok-start[b + TT]    + ostatok-start[b + TT]
     5453     o-ostatok-start[b + TT]    = o-ostatok-start[b + TT]    + ostatok-start[b + TT]
     5454     B1-ostatok-end[b + TT]    = B1-ostatok-end[b + TT]    + ostatok-end[b + TT]
     5455     B2-ostatok-end[b + TT]    = B2-ostatok-end[b + TT]    + ostatok-end[b + TT]
     5456     Bi-ostatok-end[b + TT]    = Bi-ostatok-end[b + TT]    + ostatok-end[b + TT]
     5457     p-ostatok-end[b + TT]    = p-ostatok-end[b + TT]    + ostatok-end[b + TT]
     5458     o-ostatok-end[b + TT]    = o-ostatok-end[b + TT]    + ostatok-end[b + TT]
     5459   .
     5460   End.
     5461   END PROCEDURE.
     5462   PROCEDURE U-LINE :
     5463   UNDERLINE stream OutStream  sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym13
     5464           gds-zap-b-code
     5465           gds-zap-artic
     5466           gds-zap-gds-name
     5467           gds-zap-unit-base
     5468           gds-type
     5469           F-ostatok-start
     5470           F-Prih
     5471           F-Rash
     5472           F-KAssa
     5473           F-Inv
     5474           F-spis
     5475           F-vzvr
     5476           F-vzvr-post
     5477           F-ostatok-end
     5478           with FRAME ZAPAS .
     5479           DOWN stream   OutStream 1 with FRAME ZAPAS.
     5480           END PROCEDURE.
     5481   Procedure Tmp-create :
     5482   define input parameter p1   like ub.clients.obj-code  no-undo .
     5483   define input parameter p2   like ub.clients.obj-type  no-undo .
     5484   define input parameter Name like ub.clients.obj-name  no-undo .
     5485   define input parameter p3   like obj-list.obj-code no-undo .
     5486   define input parameter p4   like obj-list.obj-type no-undo .
     5487     Create tmp-cli-gds.
     5488    def var kk as int no-undo.
     5489    REPEAT kk = 1 to 9 :
     5490      Assign
     5491         tmp-cli-gds.p-ostatok-start[kk]  = p-ostatok-start[kk]
     5492         tmp-cli-gds.p-ostatok-End[kk]    = p-ostatok-End[kk]
     5493         tmp-cli-gds.p-prih[kk]           = p-prih[kk]
     5494         tmp-cli-gds.p-rash[kk]           = p-rash[kk]
     5495         tmp-cli-gds.p-kassa[kk]          = p-kassa[kk]
     5496         tmp-cli-gds.p-Inv[kk]            = p-Inv[kk]
     5497         tmp-cli-gds.p-spis[kk]           = p-spis[kk]
     5498         tmp-cli-gds.p-vzvr[kk]           = p-vzvr[kk]
     5499         tmp-cli-gds.p-vzvr-post[kk]      = p-vzvr-post[kk]
     5500         .
     5501    end.
     5502         assign
     5503         tmp-cli-gds.cli-code         = p1
     5504         tmp-cli-gds.cli-type         = p2
     5505         tmp-cli-gds.Name             = Name
     5506         tmp-cli-gds.obj-code         = p3
     5507         tmp-cli-gds.obj-type         = p4
     5508         .
     5509    END PROCEDURE.
     5510   Procedure Tmp-clear :
     5511    def var kk as int no-undo.
     5512    REPEAT kk = 1 to 9 :
     5513    Assign
     5514        p-ostatok-start[kk] = 0
     5515        p-ostatok-End[kk]   = 0
     5516        p-prih[kk]          = 0
     5517        p-rash[kk]          = 0
     5518        p-kassa[kk]         = 0
     5519        p-Inv[kk]           = 0
     5520        p-spis[kk]          = 0
     5521        p-vzvr[kk]          = 0
     5522        p-vzvr-post[kk]     = 0
     5523       .
     5524       end.
     5525   END PROCEDURE.
     5526   Procedure Tmp-assign :
     5527    def var kk as int no-undo.
     5528    REPEAT kk = 1 to 9 :
     5529       Assign
     5530       p-ostatok-start[kk]  = p-ostatok-start[kk]   + tmp-cli-gds.p-ostatok-start[kk]
     5531       p-ostatok-End[kk]    = p-ostatok-End[kk]     + tmp-cli-gds.p-ostatok-End[kk]
     5532       p-prih[kk]           = p-prih[kk]            + tmp-cli-gds.p-prih[kk]
     5533       p-rash[kk]           = p-rash[kk]            + tmp-cli-gds.p-rash[kk]
     5534       p-kassa[kk]          = p-kassa[kk]           + tmp-cli-gds.p-kassa[kk]
     5535       p-Inv[kk]            = p-Inv[kk]             + tmp-cli-gds.p-Inv[kk]
     5536       p-spis[kk]           = p-spis[kk]            + tmp-cli-gds.p-spis[kk]
     5537       p-vzvr[kk]           = p-vzvr[kk]            + tmp-cli-gds.p-vzvr[kk]
     5538       p-vzvr-post[kk]      = p-vzvr-post[kk]       + tmp-cli-gds.p-vzvr-post[kk]
     5539       .
     5540    end.
     5541   END PROCEDURE.
     5542   procedure Goods-start-O :
     5543    def buffer  b-post-stk-line for ub.stk-supp-line .
     5544    define variable p-fact-order as decimal no-undo .
     5545     p-fact-order = fact-order-1 .
     5546     Find last temp2-post-stk-line  no-lock where
     5547       temp2-post-stk-line.artic       =  temp-t-post-stk-line.artic        and
     5548       temp2-post-stk-line.prod-type   =  temp-t-post-stk-line.prod-type    and
     5549       temp2-post-stk-line.prod-code   =  temp-t-post-stk-line.prod-code    and
     5550       temp2-post-stk-line.cli-type    =  temp-t-post-stk-line.cli-type     and
     5551       temp2-post-stk-line.cli-code    =  temp-t-post-stk-line.cli-code     and
     5552       temp2-post-stk-line.obj-type    =  OBJ-LIST.obj-type     and
     5553       temp2-post-stk-line.obj-code    =  obj-list.obj-code     and
     5554       temp2-post-stk-line.fact-order <=  fact-order-1               and
     5555       temp2-post-stk-line.sum-type    =  'cost':U                and
     5556       temp2-post-stk-line.cat-id      =  '##':U
     5557       no-error .
     5558     Find Last a-post-stk-line  where
     5559         a-post-stk-line.fact-order =  (if avail temp2-post-stk-line then temp2-post-stk-line.fact-order else 0)  and
     5560         a-post-stk-line.cat-id     =  t#cat-id      and
     5561         a-post-stk-line.Sum-type   =  t#sum-type    and
     5562         a-post-stk-line.artic      =  temp-t-post-stk-line.artic       and
     5563         a-post-stk-line.prod-type  =  temp-t-post-stk-line.prod-type   and
     5564         a-post-stk-line.prod-code  =  temp-t-post-stk-line.prod-code   and
     5565         a-post-stk-line.cli-type   =  temp-t-post-stk-line.cli-type  and
     5566         a-post-stk-line.cli-code   =  temp-t-post-stk-line.cli-code  and
     5567         a-post-stk-line.obj-type   =  obj-list.obj-type  and
     5568         a-post-stk-line.obj-code   =  obj-list.obj-code
     5569         no-lock no-error .
     5570         if avail  a-post-stk-line Then do:
     5571           p-fact-order     = a-post-stk-line.fact-order .
     5572           Ostatok-start[1] = Ostatok-start[1] +  a-post-stk-line.fact-qnty   .
     5573           ostatok-start[2] = ostatok-start[2] +  if tprintrubl then  a-post-stk-line.sum-rubl
     5574                                                     else a-post-stk-line.sum-base .
     5575           end.
     5576        IF Show-Sale  then do:
     5577                For each b-post-stk-line where
     5578                                            b-post-stk-line.fact-order = p-fact-order and
     5579                                            b-post-stk-line.cat-id     = t#cat-id   and
     5580                                            b-post-stk-line.Sum-type   begins 'sadt':U         and
     5581                                            b-post-stk-line.artic      = temp-t-post-stk-line.artic      and
     5582                                            b-post-stk-line.prod-type  = temp-t-post-stk-line.prod-type  and
     5583                                            b-post-stk-line.prod-code  = temp-t-post-stk-line.prod-code  and
     5584                                            b-post-stk-line.cli-type   = temp-t-post-stk-line.cli-type   and
     5585                                            b-post-stk-line.cli-code   = temp-t-post-stk-line.cli-code   and
     5586                                            b-post-stk-line.obj-type   = obj-list.obj-type   and
     5587                                            b-post-stk-line.obj-code   = obj-list.obj-code
     5588                                            no-lock :
     5589                         IF  tPrintRubl  THEN
     5590                              ASSIGN  Ostatok-start[8] = Ostatok-start[8]  + b-post-stk-line.sum-rubl .
     5591                           ELSE
     5592                              ASSIGN  Ostatok-start[8] = Ostatok-start[8]  +  b-post-stk-line.sum-base.
     5593                 End.
     5594         End.
     5595   END PROCEDURE.
     5596   procedure Goods-end-O :
     5597    def buffer  b-post-stk-line for ub.stk-supp-line .
     5598    define variable p-fact-order as decimal no-undo .
     5599     p-fact-order = fact-order-2 .
     5600     Find last temp2-post-stk-line  no-lock where
     5601       temp2-post-stk-line.artic       =  temp-t-post-stk-line.artic        and
     5602       temp2-post-stk-line.prod-type   =  temp-t-post-stk-line.prod-type    and
     5603       temp2-post-stk-line.prod-code   =  temp-t-post-stk-line.prod-code    and
     5604       temp2-post-stk-line.cli-type    =  temp-t-post-stk-line.cli-type     and
     5605       temp2-post-stk-line.cli-code    =  temp-t-post-stk-line.cli-code     and
     5606       temp2-post-stk-line.obj-type    =  obj-list.obj-type     and
     5607       temp2-post-stk-line.obj-code    =  obj-list.obj-code     and
     5608       temp2-post-stk-line.fact-order <=  fact-order-2               and
     5609       temp2-post-stk-line.sum-type    =  'cost':U                and
     5610       temp2-post-stk-line.cat-id      =  '##':U
     5611       no-error .
     5612     Find Last a-post-stk-line  where
     5613         a-post-stk-line.fact-order =  (if avail temp2-post-stk-line then temp2-post-stk-line.fact-order else 0)  and
     5614         a-post-stk-line.cat-id     =  t#cat-id       and
     5615         a-post-stk-line.Sum-type   =  t#sum-type     and
     5616         a-post-stk-line.artic      =  temp-t-post-stk-line.artic       and
     5617         a-post-stk-line.prod-type  =  temp-t-post-stk-line.prod-type   and
     5618         a-post-stk-line.prod-code  =  temp-t-post-stk-line.prod-code   and
     5619         a-post-stk-line.cli-type   =  temp-t-post-stk-line.cli-type    and
     5620         a-post-stk-line.cli-code   =  temp-t-post-stk-line.cli-code    and
     5621         a-post-stk-line.obj-type   =  obj-list.obj-type    and
     5622         a-post-stk-line.obj-code   =  obj-list.obj-code
     5623         no-lock no-error .
     5624     if avail  a-post-stk-line Then do :
     5625         Assign
     5626           p-fact-order     = a-post-stk-line.fact-order
     5627           ostatok-end[1] = ostatok-end[1] + a-post-stk-line.fact-qnty
     5628           ostatok-end[2] = ostatok-end[2] + if tprintrubl then  a-post-stk-line.sum-rubl
     5629                                             else  a-post-stk-line.sum-base.
     5630     end.
     5631        IF Show-Sale  then do:
     5632                For each b-post-stk-line where
     5633                     b-post-stk-line.fact-order = p-fact-order and
     5634                     b-post-stk-line.cat-id     = t#cat-id   and
     5635                     b-post-stk-line.Sum-type    begins 'sadt':U         and
     5636                     b-post-stk-line.artic      = post-stk-line.artic      and
     5637                     b-post-stk-line.prod-type  = temp-t-post-stk-line.prod-type  and
     5638                     b-post-stk-line.prod-code  = temp-t-post-stk-line.prod-code  and
     5639                     b-post-stk-line.cli-type   = temp-t-post-stk-line.cli-type   and
     5640                     b-post-stk-line.cli-code   = temp-t-post-stk-line.cli-code   and
     5641                     b-post-stk-line.obj-type   = obj-list.obj-type   and
     5642                     b-post-stk-line.obj-code   = obj-list.obj-code
     5643                     no-lock :
     5644                         IF  tPrintRubl  THEN
     5645                              ASSIGN  Ostatok-end[8] = Ostatok-end[8]  + b-post-stk-line.sum-rubl .
     5646                           ELSE
     5647                              ASSIGN  Ostatok-end[8] = Ostatok-end[8]  +  b-post-stk-line.sum-base.
     5648                 End.
     5649         End.
     5650   END PROCEDURE.
