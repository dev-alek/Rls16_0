     4457                                               by temp-t-post-stk-line.fact-order :
     4458                                       if first-of( (temp-t-post-stk-line.artic + temp-t-post-stk-line.prod-type + string(temp-t-post-stk-line.prod-code)) ) then do : run goods-start. end .
     4459                                       if last-of ( (temp-t-post-stk-line.artic + temp-t-post-stk-line.prod-type + string(temp-t-post-stk-line.prod-code)) ) then do : run goods-end.
     4460                                          run display-line .
     4461                                       end.
     4462                                       if last-of( (temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code)) ) then do :
     4463                                          run tmp-create (temp-t-post-stk-line.cli-code,
     4464                                                          temp-t-post-stk-line.cli-type,
     4465                                                          temp-t-post-stk-line.clients-obj-name,
     4466                                                          obj-list.obj-code,
     4467                                                          obj-list.obj-type ) .
     4468                                          run tmp-clear.
     4469                                       end.
     4470             end.
     4471          end.
     4472          for each tmp-cli-gds no-lock
     4473              break
     4474              by tmp-cli-gds.name
     4475              by (tmp-cli-gds.cli-type + string(tmp-cli-gds.cli-code)) :
     4476              if first-of(tmp-cli-gds.cli-type + string(tmp-cli-gds.cli-code)) then run tmp-clear.
     4477               run tmp-assign.
     4478              if last-of((tmp-cli-gds.cli-type + string(tmp-cli-gds.cli-code))) then do:
     4479                  run print-footer ( 3 ,tmp-cli-gds.name).
     4480              end.
     4481          end.
     4482   End procedure.
     4483   procedure run45-0 :
     4484          for each obj-list no-lock :
     4485             for each temp-t-post-stk-line : delete temp-t-post-stk-line. end.
     4486             for each post-stk-line  no-lock where
     4487                     post-stk-line.obj-type = obj-list.obj-type and
     4488                     post-stk-line.obj-code = obj-list.obj-code and
     4489                     post-stk-line.fact-order >= null-fact-order   and
     4490                     post-stk-line.fact-order <= fact-order-2   and
     4491                     post-stk-line.sum-type    = 'cost':U    and
     4492                     post-stk-line.cat-id      = '##':U
     4493                     and can-find(first g#post  where  post-stk-line.cli-type = g#post.obj-type and  post-stk-line.cli-code = g#post.obj-code ) = TRUE
     4494                     ,
     4495                    each ub.goods no-lock where
     4496                         ub.goods.artic     = post-stk-line.artic     and
     4497                         ub.goods.prod-type = post-stk-line.prod-type and
     4498                         ub.goods.prod-code = post-stk-line.prod-code  and  can-find(first gds-list where  ub.goods.gds-code = gds-list.gds-code ) = TRUE
     4499                         :
     4500                    find first  temp-t-post-stk-line where
     4501                      temp-t-post-stk-line.cli-type  = post-stk-line.cli-type  and
     4502                      temp-t-post-stk-line.cli-code  = post-stk-line.cli-code   and
     4503                      temp-t-post-stk-line.artic     = post-stk-line.artic     and
     4504                      temp-t-post-stk-line.prod-type = post-stk-line.prod-type and
     4505                      temp-t-post-stk-line.prod-code = post-stk-line.prod-code no-lock no-error .
     4506                      if not available temp-t-post-stk-line then do:
     4507                         find first  prod-cli no-lock  where
     4508                                                   prod-cli.obj-type = post-stk-line.prod-type and
     4509                                                   prod-cli.obj-code = post-stk-line.prod-code
     4510                                                   no-error .
     4511                         find first  ub.clients  no-lock  where
     4512                                                   ub.clients.obj-type = post-stk-line.cli-type and
     4513                                                   ub.clients.obj-code = post-stk-line.cli-code no-error .
     4514                           run create-temp-t-post-stk-line .
     4515                    end.
     4516                    else do:
     4517                            assign
     4518                              temp-t-post-stk-line.fact-order = post-stk-line.fact-order  .
     4519                            .
     4520                    end.
     4521             end.
     4522             for each temp-t-post-stk-line no-lock   ,
     4523                    last temp-post-stk-line  where
     4524                                               temp-post-stk-line.fact-order <=  fact-order-2 and
     4525                                               temp-post-stk-line.cat-id     =  t#cat-id                         and
     4526                                               temp-post-stk-line.sum-type   =  t#sum-type                       and
     4527                                               temp-post-stk-line.artic      =  temp-t-post-stk-line.artic       and
     4528                                               temp-post-stk-line.prod-type  =  temp-t-post-stk-line.prod-type   and
     4529                                               temp-post-stk-line.prod-code  =  temp-t-post-stk-line.prod-code   and
     4530                                               temp-post-stk-line.obj-type   =  temp-t-post-stk-line.obj-type    and
     4531                                               temp-post-stk-line.obj-code   =  temp-t-post-stk-line.obj-code    and
     4532                                               temp-post-stk-line.cli-type   =  temp-t-post-stk-line.cli-type    and
     4533                                               temp-post-stk-line.cli-code   =  temp-t-post-stk-line.cli-code
     4534                                               no-lock
     4535                                               break
     4536                                               by ((temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code)))
     4537                                               by ((temp-t-post-stk-line.artic + temp-t-post-stk-line.prod-type + string(temp-t-post-stk-line.prod-code)))
     4538                                               by temp-t-post-stk-line.fact-order :
     4539                                       if first-of( (temp-t-post-stk-line.artic + temp-t-post-stk-line.prod-type + string(temp-t-post-stk-line.prod-code)) ) then do : run goods-start. end .
     4540                                       if last-of ( (temp-t-post-stk-line.artic + temp-t-post-stk-line.prod-type + string(temp-t-post-stk-line.prod-code)) ) then do : run goods-end.
     4541                                          run display-line .
     4542                                       end.
     4543                                       if last-of( (temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code)) ) then do :
     4544                                          run tmp-create (temp-t-post-stk-line.cli-code,
     4545                                                          temp-t-post-stk-line.cli-type,
     4546                                                          temp-t-post-stk-line.clients-obj-name,
     4547                                                          obj-list.obj-code,
     4548                                                          obj-list.obj-type ) .
     4549                                          run tmp-clear.
     4550                                       end.
     4551             end.
     4552          end.
     4553          for each tmp-cli-gds no-lock
     4554              break
     4555              by tmp-cli-gds.name
     4556              by (tmp-cli-gds.cli-type + string(tmp-cli-gds.cli-code)) :
     4557              if first-of(tmp-cli-gds.cli-type + string(tmp-cli-gds.cli-code)) then run tmp-clear.
     4558               run tmp-assign.
     4559              if last-of((tmp-cli-gds.cli-type + string(tmp-cli-gds.cli-code))) then do:
     4560                  run print-footer ( 3 ,tmp-cli-gds.name).
     4561              end.
     4562          end.
     4563   End procedure.
     4564   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4565   procedure Goods-start :
     4566    def buffer  b-post-stk-line for ub.stk-supp-line .
     4567    define variable p-fact-order as decimal no-undo .
     4568     p-fact-order = fact-order-1 .
     4569     Find last temp2-post-stk-line  no-lock where
     4570                                       temp2-post-stk-line.artic       =  temp-t-post-stk-line.artic        and
     4571                                       temp2-post-stk-line.prod-type   =  temp-t-post-stk-line.prod-type    and
     4572                                       temp2-post-stk-line.prod-code   =  temp-t-post-stk-line.prod-code    and
     4573                                       temp2-post-stk-line.cli-type    =  temp-t-post-stk-line.cli-type     and
     4574                                       temp2-post-stk-line.cli-code    =  temp-t-post-stk-line.cli-code     and
     4575                                       temp2-post-stk-line.obj-type    =  temp-t-post-stk-line.obj-type     and
     4576                                       temp2-post-stk-line.obj-code    =  temp-t-post-stk-line.obj-code     and
     4577                                       temp2-post-stk-line.fact-order <=  fact-order-1               and
     4578                                       temp2-post-stk-line.sum-type    =  'cost':U                and
     4579                                       temp2-post-stk-line.cat-id      =  '##':U
     4580                                       no-error .
     4581     Find Last a-post-stk-line  where
     4582         a-post-stk-line.fact-order =   ( if avail temp2-post-stk-line then temp2-post-stk-line.fact-order else 0)  and
     4583         a-post-stk-line.cat-id     =  t#cat-id      and
     4584         a-post-stk-line.Sum-type   =  t#sum-type    and
     4585         a-post-stk-line.artic      =  temp-t-post-stk-line.artic       and
     4586         a-post-stk-line.prod-type  =  temp-t-post-stk-line.prod-type   and
     4587         a-post-stk-line.prod-code  =  temp-t-post-stk-line.prod-code   and
     4588         a-post-stk-line.cli-type   =  temp-t-post-stk-line.cli-type  and
     4589         a-post-stk-line.cli-code   =  temp-t-post-stk-line.cli-code  and
     4590         a-post-stk-line.obj-type   =  temp-t-post-stk-line.obj-type  and
     4591         a-post-stk-line.obj-code   =  temp-t-post-stk-line.obj-code
     4592         no-lock no-error .
     4593         if avail  a-post-stk-line Then
     4594         Assign
     4595           p-fact-order     = a-post-stk-line.fact-order
     4596           Ostatok-start[1] = a-post-stk-line.fact-qnty
     4597           Ostatok-start[2] = IF tPrintRubl THEN  a-post-stk-line.sum-rubl
     4598                                            else a-post-stk-line.sum-base.
     4599           Else
     4600         Assign
     4601           Ostatok-start[1] = 0
     4602           Ostatok-start[2] = 0
     4603         Ostatok-start[8] = 0.
     4604        IF Show-Sale  then do:
     4605                For each b-post-stk-line where
     4606                                            b-post-stk-line.fact-order = p-fact-order and
     4607                                            b-post-stk-line.cat-id     = t#cat-id   and
     4608                                            b-post-stk-line.Sum-type   begins 'sadt':U         and
     4609                                            b-post-stk-line.artic      = temp-t-post-stk-line.artic      and
     4610                                            b-post-stk-line.prod-type  = temp-t-post-stk-line.prod-type  and
     4611                                            b-post-stk-line.prod-code  = temp-t-post-stk-line.prod-code  and
     4612                                            b-post-stk-line.cli-type   = temp-t-post-stk-line.cli-type   and
     4613                                            b-post-stk-line.cli-code   = temp-t-post-stk-line.cli-code   and
     4614                                            b-post-stk-line.obj-type   = temp-t-post-stk-line.obj-type   and
     4615                                            b-post-stk-line.obj-code   = temp-t-post-stk-line.obj-code
     4616                                            no-lock :
     4617                         IF  tPrintRubl  THEN
     4618                              ASSIGN  Ostatok-start[8] = Ostatok-start[8]  + b-post-stk-line.sum-rubl .
     4619                           ELSE
     4620                              ASSIGN  Ostatok-start[8] = Ostatok-start[8]  +  b-post-stk-line.sum-base.
     4621                 End.
     4622         End.
     4623    END PROCEDURE.
     4624   procedure Goods-end :
     4625    def buffer  b-post-stk-line for ub.stk-supp-line .
     4626    define variable p-fact-order as decimal no-undo .
     4627     p-fact-order = fact-order-2 .
     4628     Find last temp2-post-stk-line  no-lock where
     4629                                       temp2-post-stk-line.artic       =  temp-t-post-stk-line.artic        and
     4630                                       temp2-post-stk-line.prod-type   =  temp-t-post-stk-line.prod-type    and
     4631                                       temp2-post-stk-line.prod-code   =  temp-t-post-stk-line.prod-code    and
     4632                                       temp2-post-stk-line.cli-type    =  temp-t-post-stk-line.cli-type     and
     4633                                       temp2-post-stk-line.cli-code    =  temp-t-post-stk-line.cli-code     and
     4634                                       temp2-post-stk-line.obj-type    =  temp-t-post-stk-line.obj-type     and
     4635                                       temp2-post-stk-line.obj-code    =  temp-t-post-stk-line.obj-code     and
     4636                                       temp2-post-stk-line.fact-order <=  fact-order-2               and
     4637                                       temp2-post-stk-line.sum-type    =  'cost':U                and
     4638                                       temp2-post-stk-line.cat-id      =  '##':U
     4639                                       no-error .
     4640     Find Last a-post-stk-line  where
     4641         a-post-stk-line.fact-order =   ( if avail temp2-post-stk-line then temp2-post-stk-line.fact-order else 0)  and
     4642         a-post-stk-line.cat-id     =  t#cat-id       and
     4643         a-post-stk-line.Sum-type   =  t#sum-type     and
     4644         a-post-stk-line.artic      =  temp-t-post-stk-line.artic       and
     4645         a-post-stk-line.prod-type  =  temp-t-post-stk-line.prod-type   and
     4646         a-post-stk-line.prod-code  =  temp-t-post-stk-line.prod-code   and
     4647         a-post-stk-line.cli-type   =  temp-t-post-stk-line.cli-type    and
     4648         a-post-stk-line.cli-code   =  temp-t-post-stk-line.cli-code    and
     4649         a-post-stk-line.obj-type   =  temp-t-post-stk-line.obj-type    and
     4650         a-post-stk-line.obj-code   =  temp-t-post-stk-line.obj-code
     4651         no-lock no-error .
     4652     if avail  a-post-stk-line Then do :
     4653         Assign
     4654           p-fact-order     = a-post-stk-line.fact-order
     4655           ostatok-end[1] = a-post-stk-line.fact-qnty
     4656           ostatok-end[2] = if tprintrubl then  a-post-stk-line.sum-rubl
     4657                                          else  a-post-stk-line.sum-base.
     4658           end.
     4659           Else
     4660         Assign
     4661           Ostatok-end[1] = 0
     4662           Ostatok-end[2] = 0.
     4663           Ostatok-end[8] = 0.
     4664        IF Show-Sale  then do:
     4665                For each b-post-stk-line where
     4666                                            b-post-stk-line.fact-order = p-fact-order and
     4667                                            b-post-stk-line.cat-id     = t#cat-id   and
     4668                                            b-post-stk-line.Sum-type    begins 'sadt':U         and                                         b-post-stk-line.artic      = post-stk-line.artic      and
     4669                                            b-post-stk-line.prod-type  = temp-t-post-stk-line.prod-type  and
     4670                                            b-post-stk-line.prod-code  = temp-t-post-stk-line.prod-code  and
     4671                                            b-post-stk-line.cli-type   = temp-t-post-stk-line.cli-type   and
     4672                                            b-post-stk-line.cli-code   = temp-t-post-stk-line.cli-code   and
     4673                                            b-post-stk-line.obj-type   = temp-t-post-stk-line.obj-type   and
     4674                                            b-post-stk-line.obj-code   = temp-t-post-stk-line.obj-code
     4675                                            no-lock :
     4676                         IF  tPrintRubl  THEN
     4677                              ASSIGN  Ostatok-end[8] = Ostatok-end[8]  + b-post-stk-line.sum-rubl .
     4678                           ELSE
     4679                              ASSIGN  Ostatok-end[8] = Ostatok-end[8]  +  b-post-stk-line.sum-base.
     4680                 End.
     4681         End.
     4682   END PROCEDURE.
     4683   PROCEDURE display-line :
     4684     i = i + 1.
     4685   If Integer(10) = 0 Then Temp1  = 100  .
     4686                         Else Temp1 = Integer(10) .
     4687        IF ( i modulo Temp1 = 0 ) AND ( i >= Temp1 ) then
     4688            RUN waitfram-show( "Обработано строк : " + string( i )) .
     4689     run clear-item.
     4690       assign
     4691             gds-zap-gds-name   = temp-t-post-stk-line.gds-name
     4692             gds-zap-unit-base  = temp-t-post-stk-line.unit-base
     4693             gds-zap-prt-root   = temp-t-post-stk-line.prt-root
     4694             gds-zap-prod-type  = temp-t-post-stk-line.prod-type
     4695             gds-zap-prod-code  = temp-t-post-stk-line.prod-code
     4696             gds-zap-artic      = temp-t-post-stk-line.artic
     4697             gds-zap-grp-name   = temp-t-post-stk-line.Goods-grp-name
     4698             gds-zap-b-code     = temp-t-post-stk-line.gds-code
     4699             gds-zap-type       = temp-t-post-stk-line.gds-type
     4700             pos-cli-type       = temp-t-post-stk-line.Cli-type
     4701             pos-cli-code       = temp-t-post-stk-line.Cli-code
     4702             pos-cli-grp-name   = temp-t-post-stk-line.Clients-grp-name.
     4703       run ob-line  (
     4704                temp-t-post-stk-line.obj-code    ,
     4705                temp-t-post-stk-line.obj-type    ,
     4706                temp-t-post-stk-line.cli-code    ,
     4707                temp-t-post-stk-line.cli-type    ,
     4708                temp-t-post-stk-line.artic       ,
     4709                temp-t-post-stk-line.prod-code   ,
     4710                temp-t-post-stk-line.prod-type   ,
     4711                Fact-order-1     ,
     4712                Fact-order-2     ,
     4713                t#sum-type       ,
     4714                t#cat-id         ,
     4715                ""               ,
     4716                yes) .
     4717      if Show-Sale Then  run ob-line  (
     4718                temp-t-post-stk-line.obj-code    ,
     4719                temp-t-post-stk-line.obj-type    ,
     4720                temp-t-post-stk-line.cli-code    ,
     4721                temp-t-post-stk-line.cli-type    ,
     4722                temp-t-post-stk-line.artic       ,
     4723                temp-t-post-stk-line.prod-code   ,
     4724                temp-t-post-stk-line.prod-type   ,
     4725                Fact-order-1   ,
     4726                Fact-order-2   ,
     4727                'sale':U    ,
     4728                '##':U ,
     4729                ""             ,
     4730                yes) .
     4731            run calc-sub-itog ( 0).
     4732                if Show-Sale Then
     4733                   run calc-sub-itog ( 6).
     4734          IF  NOT  ( ( ostatok-start[1] = 0  AND
     4735                                          Prih         [1] = 0  AND
     4736                                          RAsh         [1] = 0  AND
     4737                                          KAssa        [1] = 0  AND
     4738                                          Inv          [1] = 0  AND
     4739                                          vzvr         [1] = 0  AND
     4740                                          vzvr-post    [1] = 0  AND
     4741                                          Ostatok-end  [1] = 0)) then DO:
     4742            IF NOT Sums-Only then DO:
     4743               run display-str1 in this-procedure .
     4744               run clear-item in this-procedure .
     4745            End.
     4746          End.
     4747     END PROCEDURE.
     4748   PROCEDURE display-str1  :
     4749   if   Show-Negativ = true or not  (
     4750       Prih         [1] = 0  AND
     4751       RAsh         [1] = 0  AND
     4752       KAssa        [1] = 0  AND
     4753       Inv          [1] = 0  AND
     4754       vzvr         [1] = 0  AND
     4755       spis         [1] = 0  AND
     4756       vzvr-post    [1] = 0
     4757       ) then DO:
     4758       if not  (  not Show-zero-ost   and
     4759               (  ostatok-end[1] = 0  and
     4760                ostatok-end[2] = 0  and
     4761                ostatok-end[8] = 0 ))  then DO:
     4762            run di-qnty  ( "кол-во", 1, gds-zap-b-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     4763            if show-cost then do : run di  (  "учет." , 2, "","","","","" ).  end.
     4764            if show-sale then do : run di  (  "док-т.", 8, "","","","","" ).  end.
     4765          end.
     4766   end.
     4767   run clear-item in this-procedure .
     4768   END PROCEDURE.
     4769   PROCEDURE Di :
     4770   def input parameter p1 as char no-undo.
     4771   def input parameter p2 as int no-undo.
     4772   def input parameter p3 as char no-undo.
     4773   def input parameter p4 as char no-undo.
     4774   def input parameter p5 as char no-undo.
     4775   def input parameter p6 as char no-undo.
     4776   def input parameter p7 as char no-undo.
     4777    CASE CAPS ( p7) :
     4778      WHEN "B1":U  Then do:
     4779                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym11 sym12 sym13
     4780                   p3 @ gds-zap-b-code
     4781                   p4 @ gds-zap-artic
     4782                   p5 @ gds-zap-gds-name
     4783                   p6 @ gds-zap-unit-base
     4784                   p1 @ gds-type
     4785                   b1-ostatok-start[p2] when ( NOT( Show-SAle = true and p2 = 8 )) @  F-ostatok-start
     4786                   b1-Prih         [p2]  @  F-Prih
     4787                   b1-RAsh         [p2]  @  F-RAsh
     4788                   b1-KAssa        [p2]  @  F-KAssa
     4789                   b1-Inv          [p2]  @  F-Inv
     4790                   b1-spis         [p2]  @  F-spis
     4791                   b1-vzvr         [p2]  @  F-vzvr
     4792                   b1-vzvr-post    [p2]  @  F-vzvr-post
     4793                   b1-Ostatok-end  [p2] when ( NOT( Show-SAle = true and p2 = 8 ))  @  F-Ostatok-end
     4794                  with FRAME ZAPAS .
     4795     end.
     4796      WHEN "B2":U  Then do:
     4797                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym11 sym12 sym13
     4798                   p3 @ gds-zap-b-code
     4799                   p4 @ gds-zap-artic
