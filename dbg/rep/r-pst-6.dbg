     4227             End.
     4228            if t#kol-rec-obj > 1 THEN run print-footer ( 0, '(' + obj-list.obj-type + ' ' + trim(string(obj-list.obj-code)) + ') ' + obj-list.obj-name).
     4229           .
     4230          End.
     4231     .
     4232     End.
     4233   End case.
     4234   End procedure.
     4235   procedure Print-Header :
     4236   define input parameter N as integer no-undo .
     4237   define input parameter Name as char no-undo .
     4238   PUT stream  OutStream  UNFORMATTED trim(Name) AT ((N - 1) * 10 ) format "x(100)" skip.
     4239   if Make-Excel then  put   stream ForExcel unformatted fill(" " + CHR(9), N - 1) trim(Name) skip.
     4240   END PROCEDURE.
