     1217   procedure create-temp-t-post-stk-line :
     1218       define variable str  as char      format "X(60)" no-undo.
     1219       define variable str2 as char      no-undo.
     1220       define variable v-r  as character no-undo init "" .
     1221       define variable i#i  as int       no-undo.
     1222    do
     1223    on error undo, return error return-value
     1224    :
     1225    if available ub.goods and
     1226       available ub.clients and
     1227       available prod-cli then do:
     1228     create temp-t-post-stk-line .
     1229     BUFFER-COPY post-stk-line  TO temp-t-post-stk-line
     1230     assign
     1231       temp-t-post-stk-line.goods-grp-name    = ub.goods.grp-name
     1232       temp-t-post-stk-line.gds-code          = ub.goods.gds-code
     1233       temp-t-post-stk-line.unit-base         = ub.goods.unit-base
     1234       temp-t-post-stk-line.prt-root          = ub.goods.prt-root
     1235       temp-t-post-stk-line.gds-type          = ub.goods.gds-type
     1236       temp-t-post-stk-line.gds-name          = if g#gds-engl then ub.goods.engl-name else ub.goods.gds-name
     1237       temp-t-post-stk-line.clients-grp-name  = ub.clients.grp-name
     1238       temp-t-post-stk-line.clients-obj-name  = ub.clients.obj-name
     1239       temp-t-post-stk-line.prod-cli-obj-name = prod-cli.obj-name
     1240       temp-t-post-stk-line.prod-cli-obj-code = prod-cli.obj-code
     1241       temp-t-post-stk-line.prod-cli-obj-type = prod-cli.obj-type
     1242     .
     1243               if xlavel > 0 then
     1244               do:
     1245                   repeat i#i =1 to xlavel:
     1246                       if i#i =1 then str   = entry(1,ub.goods.grp-name, chr(47)) .
     1247                       else
     1248                       do:
     1249                           str2 = entry(i#i,ub.goods.grp-name, chr(47)) no-error.
     1250                           if not error-status:error  and str2 <> "":u then
     1251                               str = str +  chr(47) +  entry(i#i,ub.goods.grp-name, chr(47)) no-error .
     1252                       end.
     1253                   end.
     1254                   if str <> ? then
     1255                   do:
     1256                       temp-t-post-stk-line.goods-grp-name = str + chr(47) .
     1257                   end.
     1258               end.
     1259               else
     1260               do :
     1261                   temp-t-post-stk-line.goods-grp-name = ub.goods.grp-name.
     1262               end.
     1263           end.
     1264    end.
     1265   end procedure.
     1266   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     1267     if num-entries(string(p-dec), '.') = 2
     1268       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     1269       else return( string(p-dec)) .
     1270   end function.
     1271   function format-point-to-comma returns char (input orig as char ) .
     1272   define variable rtext as character no-undo .
     1273   define variable strt as integer no-undo .
     1274   define variable leng as integer no-undo .
     1275   assign rtext = orig .
     1276   repeat:
     1277     strt =  index(rtext,'.').
     1278     if strt = 0 then leave.
     1279     leng = 1.
     1280     substring(rtext,strt,leng,"character") = v-delim .
     1281   end.
     1282   return rtext.
     1283   end function.
     1284   function format-excel-text returns char ( input start-text as char ) :
     1285   def var  i    as int no-undo.
     1286   def var  ch   as char no-undo.
     1287   def var  n    as int no-undo.
     1288   def var  ipos as int no-undo.
     1289     n = num-entries(trim(start-text), chr(10)) - 1 .
     1290     do i = 1 to n :
     1291       ipos = index( start-text, chr(10)).
     1292       if ipos > 0 then
     1293         substr( start-text, ipos, 1 ) = ' '.
     1294     end.
     1295     n = num-entries(trim(start-text), chr(13)) - 1 .
     1296     do i = 1 to n :
     1297       ipos = index( start-text, chr(13)).
     1298       if ipos > 0 then
     1299         substr( start-text, ipos, 1 ) = ' '.
     1300     end.
     1301     if index( start-text, '"' ) = 0 then
     1302       start-text =  '="'   + trim( start-text) + '"'   .
     1303       else do:
     1304         n = num-entries(trim(start-text), '"') - 1.
     1305         do i = 1 to n :
     1306           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1307         end.
     1308         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1309         start-text = '="'  + ch  + '"' .
     1310       end.
     1311     return start-text.
     1312   end.
     1313   function excel-sum returns char (input p-dec as decimal ).
     1314     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     1315   end function.
     1316   function excel-qnty returns char (input p-dec as decimal ).
     1317     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     1318   end function.
     1319   function format-excel-text-macr returns char ( input start-text as char ) :
     1320   def var  i    as int no-undo.
     1321   def var  ch   as char no-undo.
     1322   def var  n    as int no-undo.
     1323   def var  ipos as int no-undo.
     1324     n = num-entries(trim(start-text), chr(10)) - 1 .
     1325     do i = 1 to n :
     1326       ipos = index( start-text, chr(10)).
     1327       if ipos > 0 then
     1328         substring( start-text, ipos , 1 ) = ' '.
     1329     end.
     1330     n = num-entries(trim(start-text), chr(13)) - 1 .
     1331     do i = 1 to n :
     1332       ipos = index( start-text, chr(13)).
     1333       if ipos > 0 then
     1334         substring( start-text, ipos, 1 ) = ' '.
     1335     end.
     1336     if index( start-text, '"' ) = 0 then
     1337       start-text =  '"'   + trim( start-text) + '"'   .
     1338       else do:
     1339         n = num-entries(trim(start-text), '"') - 1.
     1340         do i = 1 to n :
     1341           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1342         end.
     1343         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1344         start-text = '"'  + ch  + '"' .
     1345       end.
     1346     n = num-entries(trim(start-text), chr(10)) - 1 .
     1347     do i = 1 to n :
     1348       ipos = index( start-text, chr(10)).
     1349       if ipos > 0 then
     1350         substring( start-text, ipos , 1 ) = ' '.
     1351     end.
     1352       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     1353     return start-text.
     1354   end.
     1355   FUNCTION n-lavel RETURNS char (INPUT grp-name as char, INPUT lavel# as int ).
     1356   define variable  str  as char format "X(60)"  no-undo.
     1357   define variable  str2 as char no-undo.
     1358   define variable v-r as character no-undo init "" .
     1359   define variable  i#i as int no-undo.
     1360   STR = "".
     1361   repeat i#i =1 to lavel#:
     1362       if i#i =1 then str   = entry(1,grp-name, chr(47)) .
     1363       else do:
     1364           str2 = entry(i#i,grp-name, chr(47)) no-error.
     1365           if not error-status:error  and str2 <> "":u then
     1366                  str = str +  chr(47) +  entry(i#i,grp-name, chr(47)) no-error .
     1367           end.
     1368   end.
     1369   if str <> ? then do:
     1370   v-r = str + chr(47) .
     1371   end.
     1372   RETURN v-r .
     1373   END FUNCTION.
     1374   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1375   define variable v-waitfram-action01         as character   no-undo .
     1376   define variable v-waitfram-action02         as character   no-undo .
     1377   define variable v-waitfram-action03         as character   no-undo .
     1378   define variable mWaitFramTextBeg            as character   no-undo.
     1379   define variable mWaitFramTextEnd            as character   no-undo.
     1380   define variable mWaitFramView               as logical     no-undo.
     1381   define variable mWaitProcEvent              as logical     no-undo init yes.
     1382   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1383   define variable mWaitFramStop               as logical     no-undo.
     1384   define variable mWaitFramStopUser           as logical     no-undo.
     1385   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1386   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1387   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1388   define button B-WaitFramStop auto-end-key
     1389        label "Стоп"
     1390        size 10 by 1 tooltip "Остоновить процесс".
     1391   define button B-viewProcInfo
     1392        label "Информация"
     1393        size 15 by 1 tooltip "Информация о процесс".
     1394   define frame waitfram
     1395     v-waitfram-action01 format "x(72)" no-label skip
     1396     v-waitfram-action02 format "x(72)" no-label skip
     1397     v-waitfram-action03 format "x(72)" no-label skip
     1398     B-viewProcInfo
     1399     B-WaitFramStop at row 4 col 30
     1400     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1401     .
     1402   define new global shared variable mBatchMode as logical no-undo init ?.
     1403   define variable mFramBachModHandle as handle no-undo.
     1404   mFramBachModHandle = frame waitfram:handle.
     1405   define variable mFameOldVis as logical no-undo.
     1406   define variable mVisCUrentVin as logical no-undo.
     1407   if session:batch-mode
     1408   then
     1409      mBatchMode = yes.
     1410   if mBatchMode = ? then do:
     1411     mVisCUrentVin = current-window:visible.
     1412     mFameOldVis = mFramBachModHandle:visible.
     1413     mFramBachModHandle:visible  = yes.
     1414     mBatchMode = mFramBachModHandle:visible ne yes.
     1415     mFramBachModHandle:visible = mFameOldVis.
     1416     current-window:visible = mVisCUrentVin.
     1417   end.
     1418    if  log-manager:logfile-name ne ?
     1419     then DO:
     1420         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1421         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1422         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1423     end.
     1424   on choose of B-WaitFramStop in frame waitfram
     1425   do:
     1426     mWaitFramStop = yes.
     1427     mWaitFramStopUser = yes.
     1428   end.
     1429   function waitfram-check-timeout returns logical():
     1430      define variable vtime as int64 no-undo.
     1431      if mWaitFramStopTimeOut
     1432      then
     1433         return yes.
     1434      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1435      if     mWaitFramTimeOut ne ?
     1436         and mWaitFramTimeOut ne 0
     1437         and mWaitFramTimeOut lt vtime
     1438      then do:
     1439         mWaitFramStopTimeOut = yes.
     1440      end.
     1441      return mWaitFramStopTimeOut.
     1442   end.
     1443   procedure waitfram-hide :
     1444     if not session:batch-mode
     1445     then do
     1446     on error undo, return error return-value
     1447     :
     1448       pause 0 before-hide .
     1449       if not mBatchMode then
     1450         hide frame waitfram .
     1451     if     not mWaitFramView
     1452        and mWaitProcEvent
     1453     then
     1454       process events .
     1455     end.
     1456   end procedure.
     1457   procedure waitfram-show :
     1458     define input  parameter p-message as character no-undo .
     1459     define variable v-left-margin as integer   no-undo .
     1460     if not session:batch-mode
     1461     then do
     1462     on error undo, return error return-value
     1463     :
     1464       if length(p-message) <= 70 then do:
     1465         assign
     1466           v-left-margin = integer((70 - length(p-message)) / 2)
     1467         .
     1468         assign
     1469           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1470         .
     1471         assign
     1472           v-waitfram-action01 = " "
     1473           v-waitfram-action02 = " "
     1474                                    + fill(" ", v-left-margin)
     1475                                    + p-message
     1476           v-waitfram-action03 = " "
     1477         .
     1478       end.
     1479       else do:
     1480         define variable vRindex1 as integer no-undo.
     1481         define variable vRindex2 as integer no-undo.
     1482         vRindex1 = r-index(p-message," ",70).
     1483         if vRindex1 = 0
     1484         then
     1485            vRindex1 = 70.
     1486         if length(p-message)  <= vRindex1 + 70 then do:
     1487           assign
     1488             v-waitfram-action01 = " "
     1489             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1490             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1491           .
     1492         end.
     1493         else do:
     1494           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1495           if vRindex2 <= vRindex1
     1496           then
     1497              vRindex2 = vRindex1 + 70.
     1498           assign
     1499             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1500             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1501             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1502           .
     1503         end.
     1504       end.
     1505       B-viewProcInfo:visible   in frame waitfram = no.
     1506       B-viewProcInfo:sensitive in frame waitfram = no.
     1507       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1508       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1509       if  (   mWaitFramView
     1510          or  mWaitProcEvent)
     1511          and not mBatchMode
     1512       then
     1513          display
     1514             v-waitfram-action01 skip
     1515             v-waitfram-action02 skip
     1516             v-waitfram-action03 skip
     1517          with frame waitfram .
     1518       if     mWaitFramView
     1519          then do:
     1520             if     mWaitFramInterval ne ?
     1521                and not mBatchMode
     1522             then
     1523                wait-for go of frame waitfram pause mWaitFramInterval.
     1524          end.
     1525          else
     1526             if     mWaitProcEvent
     1527                and not mBatchMode
     1528             then
     1529                process events .
     1530     end.
     1531   end procedure.
     1532      procedure waitfram-show-this:
     1533         define input  parameter iInterval as int64 no-undo.
     1534         define variable vtime as int64 no-undo.
     1535         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1536         mWaitFramInterval = iInterval.
     1537         run waitfram-show (substitute("&1&2 &3&4" ,
     1538                                       mWaitFramTextBeg ,
     1539                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1540                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1541                                       mWaitFramTextEnd
     1542                                      )
     1543                           ).
     1544      end.
     1545      procedure WaitFramRunPause:
     1546         define input  parameter iInterval as dec no-undo.
     1547         define variable vStart  as datetime-tz no-undo.
     1548         define variable vend    as datetime-tz no-undo.
     1549         define variable vint as int64 no-undo.
     1550         define variable vOk as logical no-undo.
     1551         vStart = now.
     1552         vend   = vStart.
     1553         publish "WaitFramPause" (iInterval,output vOk).
     1554         vend   =  now.
     1555         vint = vend - vStart.
     1556         vint = iInterval - vint / 1000.
     1557         if     not mWaitFramStop
     1558            and (   vint > 0
     1559                 or (    not vOk
     1560                     and iInterval eq ?
     1561                     )
     1562                 )
     1563         then
     1564            run waitfram-show-this (iInterval).
     1565         vend   =  now.
     1566         vint = vend - vStart.
     1567         vint = iInterval - vint / 1000.
     1568         if     not mWaitFramStop
     1569            and vint > 0
     1570         then do:
     1571            run gbl/pause.p (vint * 1000).
     1572         end.
     1573         if iInterval ne ?
     1574         then
     1575            publish "WaitFramStop".
     1576         waitfram-check-timeout().
     1577      end.
     1578      procedure WaitFramWaitFor:
     1579         define input  parameter iInterval as dec no-undo.
     1580         assign
     1581            mWaitFramStartProc   = now
     1582            mWaitFramStopUser    = no
     1583            mWaitFramStopTimeOut = no
     1584         .
     1585         block-wait:
     1586         do while not mWaitFramStop:
     1587            run WaitFramRunPause (iInterval).
     1588            if  waitfram-check-timeout()
     1589            then do:
     1590               leave block-wait.
     1591            end.
     1592         end.
     1593         run waitfram-hide.
     1594      end.
     1595   procedure waitfram-join :
     1596     define input  parameter p-line-1  as character no-undo .
     1597     define input  parameter p-line-2  as character no-undo .
     1598     define input  parameter p-line-3  as character no-undo .
     1599     define output parameter p-message as character no-undo .
     1600     do
     1601     on error undo, return error return-value
     1602     :
     1603       assign
     1604         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1605                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1606                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1607       .
     1608     end.
     1609   end procedure.
     1610   function waitfram-join-function returns character
     1611     (input p-line-1 as character
     1612     ,input p-line-2 as character
     1613     ,input p-line-3 as character
     1614     ).
     1615     define variable v-message as character no-undo .
     1616     run waitfram-join in this-procedure
     1617       (input  p-line-1
     1618       ,input  p-line-2
     1619       ,input  p-line-3
     1620       ,output v-message
     1621       ) .
     1622     return v-message .
     1623   end function .
     1624   define buffer goods   for ub.goods  .
     1625   define buffer gds-obj for ub.gds-obj  .
     1626   define buffer clients for ub.clients  .
     1627   define variable ii like i init 0 no-undo .
     1628   define variable t#cat-id like stk-line.cat-id no-undo .
     1629   define variable t#Sum-type like stk-line.Sum-type no-undo .
     1630   define variable t#kol-rec-obj like i init 0  no-undo .
     1631   if Show-Negativ then null-fact-order = 0 .
     1632      else  null-fact-order = fact-order-1 .
     1633   null-fact-order = 0 .
     1634   for each obj-list no-lock :
     1635     t#kol-rec-obj = t#kol-rec-obj + 1.
     1636   End.
     1637   case type-stor  :
     1638     when 1 then  do:
     1639       Assign
     1640         t#cat-id   = '##':U
     1641         t#sum-type = 'cost':U  .
     1642     end.
     1643     when 2 then do:
     1644       Assign
     1645         t#cat-id   = 'prch':U
     1646         t#sum-type = 'cost':U + 'p':U .
     1647     end.
     1648     when 3 then do:
     1649       Assign
     1650         t#cat-id   = 'cacc':U
     1651         t#sum-type = 'cost':U + 'p':U .
     1652     end.
     1653     when 4 then do:
     1654       Assign
     1655         t#cat-id   = 'stor':U
     1656         t#sum-type = 'cost':U + 'p':U .
     1657     end.
     1658     when 5 then do:
     1659       Assign
     1660         t#cat-id   = 'cons':U
     1661         t#sum-type = 'cost':U + 'p':U .
     1662     end.
     1663   End case.
     1664   if xTogobj = false  then DO:
     1665     Case Select-Good :
     1666       when 1   then    RUN Run1-0.
     1667       when 2   then    run run2-0.
     1668       when 3  then    run run3-0.
     1669       otherwise do:
     1670           run run45-0.
     1671       end.
     1672     End case.
     1673   End.
     1674   Else do:
     1675     Case Select-Good :
     1676       when 1  then    RUN Run1.
     1677       when 2  then    run run2.
     1678       when 3 then    run run3.
     1679       otherwise do:
     1680         run run45.
     1681       end.
     1682     End case.
     1683   End.
     1684   procedure run1 :
     1685   CASE RetClassify :
     1686     when "no-classify":U then  DO:
     1687          For each obj-list no-lock :
     1688            for each temp-t-post-stk-line : delete temp-t-post-stk-line. end.
     1689            if t#kol-rec-obj > 1 THEN run print-header (1, '(' + obj-list.obj-type + ' ' + trim(string(obj-list.obj-code)) + ') ' + obj-list.obj-name).
     1690             For each post-stk-line  no-lock where
     1691                                               post-stk-line.obj-type = obj-list.obj-type and
     1692                                               post-stk-line.obj-code = obj-list.obj-code and
     1693                                               post-stk-line.fact-order >= null-fact-order   and
     1694                                               post-stk-line.fact-order <= fact-order-2   and
     1695                                               post-stk-line.sum-type    = 'cost':U    and
     1696                                               post-stk-line.cat-id      = '##':U
     1697                                               and can-find(first g#post  where  post-stk-line.cli-type = g#post.obj-type and  post-stk-line.cli-code = g#post.obj-code ) = TRUE
     1698                                               :
     1699                    find first  temp-t-post-stk-line where
     1700                      temp-t-post-stk-line.cli-type  = post-stk-line.cli-type  and
     1701                      temp-t-post-stk-line.cli-code  = post-stk-line.cli-code   and
     1702                      temp-t-post-stk-line.artic     = post-stk-line.artic     and
     1703                      temp-t-post-stk-line.prod-type = post-stk-line.prod-type and
     1704                      temp-t-post-stk-line.prod-code = post-stk-line.prod-code no-lock no-error .
     1705                      if not available  temp-t-post-stk-line then do:
     1706                         find first  ub.goods no-lock where
     1707                                               ub.goods.artic     = post-stk-line.artic     and
     1708                                               ub.goods.prod-type = post-stk-line.prod-type and
     1709                                               ub.goods.prod-code = post-stk-line.prod-code no-error .
     1710                         find first  prod-cli no-lock  where
     1711                                                   prod-cli.obj-type = post-stk-line.prod-type and
     1712                                                   prod-cli.obj-code = post-stk-line.prod-code
     1713                                                   no-error .
     1714                         find first  ub.clients  no-lock  where
     1715                                                   ub.clients.obj-type = post-stk-line.cli-type and
     1716                                                   ub.clients.obj-code = post-stk-line.cli-code no-error .
     1717                           run create-temp-t-post-stk-line .
     1718                    end.
     1719                    else do:
     1720                            assign
     1721                              temp-t-post-stk-line.fact-order = post-stk-line.fact-order  .
     1722                            .
     1723                    end.
     1724             end.
     1725             For each temp-t-post-stk-line no-lock   ,
     1726                    Last temp-post-stk-line  where
     1727                         temp-post-stk-line.fact-order <= fact-order-2   and
     1728                         temp-post-stk-line.cat-id     =  t#cat-id      and
     1729                         temp-post-stk-line.Sum-type   =  t#sum-type    and
     1730                         temp-post-stk-line.artic      =  temp-t-post-stk-line.artic       and
     1731                         temp-post-stk-line.prod-type  =  temp-t-post-stk-line.prod-type   and
     1732                         temp-post-stk-line.prod-code  =  temp-t-post-stk-line.prod-code   and
     1733                         temp-post-stk-line.obj-type   =  temp-t-post-stk-line.obj-type    and
     1734                         temp-post-stk-line.obj-code   =  temp-t-post-stk-line.obj-code and
     1735                         temp-post-stk-line.cli-type   =  temp-t-post-stk-line.cli-type  and
     1736                         temp-post-stk-line.cli-code   =  temp-t-post-stk-line.cli-code
     1737                         no-lock
     1738                         on error undo , next
     1739                         break
     1740                         By ((temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code)))
     1741                         By temp-t-post-stk-line.gds-name
     1742                         By ((temp-t-post-stk-line.artic + temp-t-post-stk-line.prod-type + string(temp-t-post-stk-line.prod-code)))
     1743                         By Temp-t-post-stk-line.Fact-order
     1744                        :
     1745                 if NOT(Sums-Only = true ) then DO:
     1746                     if first-of( (temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code)) ) Then DO : run print-header ( 3,temp-t-post-stk-line.clients-obj-name). end.
     1747                 End.
     1748                                       if first-of( (temp-t-post-stk-line.artic + temp-t-post-stk-line.prod-type + string(temp-t-post-stk-line.prod-code)) ) then do : run goods-start. end .
     1749                                       if last-of ( (temp-t-post-stk-line.artic + temp-t-post-stk-line.prod-type + string(temp-t-post-stk-line.prod-code)) ) then do : run goods-end.
     1750                                            run display-line .
     1751                                       End.
     1752                     if last-of( (temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code)) ) Then DO : run print-footer ( 3 , temp-t-post-stk-line.clients-obj-name). end.
     1753             End.
     1754            if t#kol-rec-obj > 1 THEN run print-footer ( 0, '(' + obj-list.obj-type + ' ' + trim(string(obj-list.obj-code)) + ') ' + obj-list.obj-name).
     1755           .
     1756          End.
     1757     End.
     1758     when "grp-goods":U  then     DO:
     1759       if xLavel = 0 THEN  DO:
     1760          For each obj-list no-lock :
     1761            for each temp-t-post-stk-line : delete temp-t-post-stk-line. end.
     1762            if t#kol-rec-obj > 1 THEN run print-header (1, '(' + obj-list.obj-type + ' ' + trim(string(obj-list.obj-code)) + ') ' + obj-list.obj-name).
     1763             For each post-stk-line  no-lock where
     1764                                               post-stk-line.obj-type = obj-list.obj-type and
     1765                                               post-stk-line.obj-code = obj-list.obj-code and
     1766                                               post-stk-line.fact-order >= null-fact-order   and
     1767                                               post-stk-line.fact-order <= fact-order-2   and
     1768                                               post-stk-line.sum-type    = 'cost':U    and
     1769                                               post-stk-line.cat-id      = '##':U
     1770                                               and can-find(first g#post  where  post-stk-line.cli-type = g#post.obj-type and  post-stk-line.cli-code = g#post.obj-code ) = TRUE
     1771                                               :
     1772                    find first  temp-t-post-stk-line where
     1773                      temp-t-post-stk-line.cli-type  = post-stk-line.cli-type  and
