     2958            if t#kol-rec-obj > 1 THEN run print-header (1, '(' + obj-list.obj-type + ' ' + trim(string(obj-list.obj-code)) + ') ' + obj-list.obj-name).
     2959             For each post-stk-line  no-lock where
     2960                                               post-stk-line.obj-type = obj-list.obj-type and
     2961                                               post-stk-line.obj-code = obj-list.obj-code and
     2962                                               post-stk-line.fact-order >= null-fact-order   and
     2963                                               post-stk-line.fact-order <= fact-order-2   and
