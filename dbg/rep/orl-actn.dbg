      776             v-cntxp-out-rate        = bf-cntxp_shop.out-rate
      777             v-cntxp-out-line-discnt = bf-cntxp_shop.out-line-discnt
      778             v-cntxp-in-ov           = bf-cntxp_shop.in-ov
      779             v-cntxp-in-perm         = bf-cntxp_shop.in-perm
      780             v-cntxp-no-eq           = bf-cntxp_shop.no-eq
      781             v-cntxp-rsrv-time       = bf-cntxp_shop.rsrv-time
      782             v-cntxp-load-time       = bf-cntxp_shop.load-time
      783             v-cntxp-holidays        = bf-cntxp_shop.holidays
      784             v-cntxp-in-pay          = bf-cntxp_shop.in-pay
      785             v-cntxp-out-pay         = bf-cntxp_shop.out-pay
      786             v-cntxp-ret-pay         = bf-cntxp_shop.ret-pay
