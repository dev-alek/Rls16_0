      758             v-cntxp-out-pay         = bf-cntxp_store.out-pay
      759             v-cntxp-ret-pay         = bf-cntxp_store.ret-pay
      760             v-cntxp-ret-sup-pay     = bf-cntxp_store.ret-sup-pay
      761             v-cntxp-down-pay        = bf-cntxp_store.down-pay
      762             v-cntxp-inv-pay         = bf-cntxp_store.inv-pay
      763             v-cntxp-chk-pay         = bf-cntxp_store.chk-pay
