      765             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
      766             .
      767         end.
      768         when 'маг':U then do:
      769           find first bf-cntxp_shop where bf-cntxp_shop.obj-code = v-cntxp-obj-code no-lock.
      770           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_shop.host-code no-lock.
      771           assign
      772             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_shop.doc-prt
      773             v-cntxp-price-calc      = bf-cntxp_shop.price-calc
