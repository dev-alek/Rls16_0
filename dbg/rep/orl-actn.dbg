      438   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      439   define new global shared variable g#trdcalib as handle no-undo.
      440   define new global shared variable g#lib-trn  as handle no-undo .
      441   define new global shared variable g#lib-trn2 as handle no-undo .
      442   define new global shared variable g#lib-trn3 as handle no-undo .
      443   define new global shared variable g#lib-trn4 as handle no-undo .
      444   FUNCTION RedLine RETURNS CHARACTER ( INPUT i-str AS CHARACTER ) :
      445     DEFINE VARIABLE v-str AS CHARACTER NO-UNDO.
      446     RUN get-red-line IN THIS-PROCEDURE ( INPUT i-str, OUTPUT v-str ) NO-ERROR.
      447     RETURN ( IF ERROR-STATUS :ERROR THEN i-str ELSE v-str ).
      448   END FUNCTION.
      449   PROCEDURE get-red-line :
      450     DEFINE  INPUT PARAMETER p-str AS CHARACTER NO-UNDO.
      451     DEFINE OUTPUT PARAMETER p-res AS CHARACTER NO-UNDO.
      452     DO ON ERROR UNDO, RETURN ERROR :
      453       ASSIGN p-res = CAPS( SUBSTRING( p-str, 1, 1 ) ) + LC( SUBSTRING( p-str, 2 ) ).
      454     END.
      455   END PROCEDURE.
      456   FUNCTION Roubles RETURNS CHARACTER ( INPUT i-sum AS DECIMAL ) :
      457     DEFINE VARIABLE Rouble AS CHARACTER NO-UNDO.
      458     RUN get-roubles IN THIS-PROCEDURE ( INPUT i-sum, OUTPUT Rouble ) NO-ERROR.
      459     RETURN ( IF ERROR-STATUS :ERROR THEN "":U ELSE Rouble ).
      460   END FUNCTION.
      461   PROCEDURE get-roubles :
      462     DEFINE  INPUT PARAMETER p-sum AS DECIMAL   NO-UNDO.
      463     DEFINE OUTPUT PARAMETER p-rub AS CHARACTER NO-UNDO.
      464     DEFINE VARIABLE Word   AS CHARACTER NO-UNDO.
      465     DEFINE VARIABLE jj     AS INTEGER   NO-UNDO.
      466     DEFINE VARIABLE j_last AS INTEGER   NO-UNDO.
      467     DEFINE VARIABLE l_prev AS LOGICAL   NO-UNDO.
      468     DO ON ERROR UNDO, RETURN ERROR :
      469       ASSIGN Word   = STRING( ABS( p-sum ), "999999999999999999999999999999.99":U )
      470              jj     = LENGTH( Word )
      471              j_last = INTEGER( SUBSTRING( Word, jj - 3, 1 ) )
      472              l_prev =        ( SUBSTRING( Word, jj - 4, 1 ) = "1" ).
      473       IF      j_last = 1                THEN DO: ASSIGN p-rub = ( IF l_prev = YES THEN "рублей" ELSE "рубль" ).  END.
      474       ELSE IF j_last > 1 AND j_last < 5 THEN DO: ASSIGN p-rub = ( IF l_prev = YES THEN "рублей" ELSE "рубля" ). END.
      475                                         ELSE DO: ASSIGN p-rub = "рублей". END.
      476     END.
      477   END PROCEDURE.
      478   FUNCTION Copecks RETURNS CHARACTER ( INPUT i-sum AS DECIMAL ) :
      479     DEFINE VARIABLE Copeck AS CHARACTER NO-UNDO.
      480     RUN get-copecks IN THIS-PROCEDURE ( INPUT i-sum, OUTPUT Copeck ) NO-ERROR.
      481     RETURN ( IF ERROR-STATUS :ERROR THEN "":U ELSE Copeck ).
      482   END FUNCTION.
      483   PROCEDURE get-copecks :
      484     DEFINE  INPUT PARAMETER p-sum AS DECIMAL   NO-UNDO.
      485     DEFINE OUTPUT PARAMETER p-kop AS CHARACTER NO-UNDO.
      486     DEFINE VARIABLE Word   AS CHARACTER NO-UNDO.
      487     DEFINE VARIABLE jj     AS INTEGER   NO-UNDO.
      488     DEFINE VARIABLE j_last AS INTEGER   NO-UNDO.
      489     DEFINE VARIABLE l_prev AS LOGICAL   NO-UNDO.
      490     DO ON ERROR UNDO, RETURN ERROR :
      491       ASSIGN  Word   = STRING( ABS( p-sum ), "999999999999999999999999999999.99":U )
      492               jj     = LENGTH( Word )
      493               j_last = INTEGER( SUBSTRING( Word, jj,     1 ) )
      494               l_prev =        ( SUBSTRING( Word, jj - 1, 1 ) = "1" ).
      495       IF           j_last = 1                THEN DO:
      496         ASSIGN p-kop = ( IF l_prev = YES THEN "копеек" ELSE "копейка" ).
      497       END. ELSE IF j_last > 1 AND j_last < 5 THEN DO:
      498         ASSIGN p-kop = ( IF l_prev = YES THEN "копеек" ELSE "копейки" ).
      499       END.                                   ELSE DO:
      500         ASSIGN p-kop = "копеек".
      501       END.
      502     END.
      503   END PROCEDURE.
      504   FUNCTION get-decade-word RETURNS CHARACTER ( INPUT i-dec AS INTEGER, INPUT i-num AS INTEGER ) :
      505     DEFINE VARIABLE v-grade AS CHARACTER NO-UNDO.
      506     RUN get-number-grade IN THIS-PROCEDURE ( INPUT i-dec, INPUT i-num, OUTPUT v-grade ) NO-ERROR.
      507     RETURN ( IF ERROR-STATUS :ERROR THEN "":U ELSE v-grade ).
      508   END FUNCTION.
      509   FUNCTION Word-Sum RETURNS CHARACTER ( INPUT i-sum AS DECIMAL ) :
      510     DEFINE VARIABLE OutSum AS CHARACTER NO-UNDO.
      511     RUN conv-sum-to-word IN THIS-PROCEDURE ( INPUT i-sum, OUTPUT OutSum ) NO-ERROR.
      512     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE OutSum ).
      513   END FUNCTION.
      514   PROCEDURE get-number-grade :
      515     DEFINE  INPUT PARAMETER p-dec AS INTEGER   NO-UNDO.
      516     DEFINE  INPUT PARAMETER p-num AS INTEGER   NO-UNDO.
      517     DEFINE OUTPUT PARAMETER p-res AS CHARACTER NO-UNDO.
      518     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO.
      519     DO ON ERROR UNDO, RETURN ERROR :
      520       IF      p-dec = 1 THEN DO: ASSIGN v-list = ",один,два,три,четыре,пять,шесть,семь,восемь,девять".    END.
      521       ELSE IF p-dec = 2 THEN DO: ASSIGN v-list = "десять,одиннадцать,двенадцать,тринадцать,четырнадцать,пятнадцать,шестнадцать,семнадцать,восемнадцать,девятнадцать".    END.
      522       ELSE IF p-dec = 3 THEN DO: ASSIGN v-list = ",,двадцать,тридцать,сорок,пятьдесят,шестьдесят,семьдесят,восемьдесят,девяносто".   END.
      523       ELSE IF p-dec = 4 THEN DO: ASSIGN v-list = ",сто,двести,триста,четыреста,пятьсот,шестьсот,семьсот,восемьсот,девятьсот".  END.
      524                         ELSE DO: ASSIGN v-list = ",,,,,,,,,". END.
      525       ASSIGN p-res = ENTRY( p-num + 1, v-list ).
      526     END.
      527   END PROCEDURE.
      528   PROCEDURE conv-sum-to-word :
      529     DEFINE  INPUT PARAMETER p-sum AS DECIMAL   NO-UNDO.
      530     DEFINE OUTPUT PARAMETER p-res AS CHARACTER NO-UNDO.
      531     DEFINE VARIABLE Formatted  AS CHARACTER NO-UNDO.
      532     DEFINE VARIABLE Word       AS CHARACTER NO-UNDO.
      533     DEFINE VARIABLE OutSum     AS CHARACTER NO-UNDO.
      534     DEFINE VARIABLE jj         AS INTEGER   NO-UNDO.
      535     DO ON ERROR UNDO, RETURN ERROR :
      536       ASSIGN Formatted = STRING( ABS( p-sum ), "999999999999999.99":U ) NO-ERROR.
      537       IF ERROR-STATUS :ERROR THEN DO:
      538         ASSIGN p-res = ?.
      539         UNDO, RETURN ERROR.
      540       END.
      541       DO jj = ( LENGTH( Formatted ) - 3 ) TO 3 BY -3 :
      542         IF SUBSTRING( Formatted, jj - 2, 3 ) = "000" THEN DO: NEXT. END.
      543         IF jj < 15 THEN DO:
      544           ASSIGN Word = ENTRY( jj, ",,триллион,,,миллиард,,,миллион,,,тысяч" ).
      545           IF SUBSTRING( Formatted, jj,     1 )  = "1" AND
      546              SUBSTRING( Formatted, jj - 1, 1 ) <> "1" AND jj = 12 THEN DO: ASSIGN Word = TRIM( Word ) + "а". END.
      547           IF SUBSTRING( Formatted, jj, 1 ) = "2" OR
      548              SUBSTRING( Formatted, jj, 1 ) = "3" OR
      549              SUBSTRING( Formatted, jj, 1 ) = "4" THEN DO:
      550             IF jj = 12 THEN DO:
      551               IF SUBSTRING( Formatted, jj - 1, 1 ) <> "1" THEN DO: ASSIGN Word = TRIM( Word ) + "и". END.
      552             END.       ELSE DO:
      553               IF SUBSTRING( Formatted, jj - 1, 1 ) <> "1" THEN DO: ASSIGN Word = TRIM( Word ) + "а". END.
      554             END.
      555           END.
      556           IF ( SUBSTRING( Formatted, jj,     1 ) <> "1" AND
      557                SUBSTRING( Formatted, jj,     1 ) <> "2" AND
      558                SUBSTRING( Formatted, jj,     1 ) <> "3" AND
      559                SUBSTRING( Formatted, jj,     1 ) <> "4" AND jj <> 12 ) OR
      560              ( SUBSTRING( Formatted, jj - 1, 1 )  = "1" AND jj <  12 ) THEN DO: ASSIGN Word = TRIM( Word ) + "ов". END.
      561           IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
      562         END.
      563         IF SUBSTRING( Formatted, jj - 1, 1 ) <> "1" THEN DO:
      564           IF      jj = 12 AND SUBSTRING( Formatted, jj, 1 ) = "1" THEN DO: ASSIGN Word = "одна". END.
      565           ELSE IF jj = 12 AND SUBSTRING( Formatted, jj, 1 ) = "2" THEN DO: ASSIGN Word = "две".  END.
      566           ELSE DO: ASSIGN Word = get-decade-word( 1, INTEGER( SUBSTRING( Formatted, jj, 1 ) ) ). END.
      567           IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
      568           ASSIGN Word = get-decade-word( 3, INTEGER( SUBSTRING( Formatted, jj - 1, 1 ) ) ).
      569         END.                                        ELSE DO:
      570           ASSIGN Word = get-decade-word( 2, INTEGER( SUBSTRING( Formatted, jj,     1 ) ) ).
      571         END.
      572         IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
      573         ASSIGN Word = get-decade-word( 4, INTEGER( SUBSTRING( Formatted, jj - 2, 1 ) ) ).
      574         IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
      575       END.
      576       ASSIGN OutSum = CAPS( SUBSTRING( OutSum, 1, 1 ) ) + SUBSTRING( OutSum, 2 ).
      577       IF OutSum = "":U AND TRUNCATE( p-sum, 0 ) = 0 THEN DO: ASSIGN OutSum = "Ноль". END.
      578       ASSIGN p-res = TRIM( OutSum ).
      579     END.
      580   END PROCEDURE.
      581   FUNCTION Total-Word RETURNS CHARACTER ( INPUT i-sum AS DECIMAL, INPUT i-curr AS CHARACTER, INPUT i-part AS CHARACTER ) :
      582     DEFINE VARIABLE word_sum AS CHARACTER NO-UNDO.
      583     RUN get-total-word IN THIS-PROCEDURE ( INPUT i-sum, INPUT i-curr, INPUT i-part, OUTPUT word_sum ) NO-ERROR.
      584     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE word_sum ).
      585   END FUNCTION.
      586   PROCEDURE get-total-word :
      587     DEFINE  INPUT PARAMETER p-sum  AS DECIMAL   NO-UNDO.
      588     DEFINE  INPUT PARAMETER p-curr AS CHARACTER NO-UNDO.
      589     DEFINE  INPUT PARAMETER p-part AS CHARACTER NO-UNDO.
      590     DEFINE OUTPUT PARAMETER p-word AS CHARACTER NO-UNDO.
      591     DO ON ERROR UNDO, RETURN ERROR :
      592       ASSIGN p-word = Word-Sum( p-sum ).
      593                  ASSIGN p-word = ( IF p-sum < 0 THEN "- " ELSE "":U ) + TRIM(
      594                         RedLine( p-word )
      595                  ) +
      596                         " ":U + p-curr + " ":U +
      597                         SUBSTRING( STRING( ABS( p-sum ), "999999999999999999999999999999.99" ), 32, 2 ) +
      598                         " ":U + p-part + ".".
      599                           END.
      600   END PROCEDURE.
      601       if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end.
      602         function invlnsum_sale-price returns decimal ( input p-doc-code   as character,
      603                                                          input p-artic      as character,
      604                                                          input p-prod-type  as character,
      605                                                          input p-prod-code  as integer,
      606                                                          input p-print-rubl as logical    ) :
      607           define variable d_out-kg-sale-price as decimal no-undo initial ?.
      608           if valid-handle( g#lib-trn3 ) = yes then do on error undo, return error :
      609             run lib-trn3_invlnprc in g#lib-trn3 (
      610                                                    input p-doc-code
      611                                                 ,  input p-artic
      612                                                 ,  input p-prod-type
      613                                                 ,  input p-prod-code
      614                                                 ,  input "sale"
      615                                                 ,  input p-print-rubl
      616                                                 , output d_out-kg-sale-price
      617                                                 ) .
      618             return ( if error-status :error then ? else d_out-kg-sale-price ).
      619           end.
      620         end function.
      621         function invlnsum_cli-qnty returns decimal ( input p-doc-code  as character,
      622                                                          input p-artic     as character,
      623                                                          input p-prod-type as character,
      624                                                          input p-prod-code as integer     ) :
      625           define variable d_out-qnty-kg as decimal no-undo initial ?.
      626                   if valid-handle( g#lib-trn3 ) = yes then do on error undo, return error :
      627             run lib-trn3_invlnqty in g#lib-trn3 (
      628                                                    input p-doc-code
      629                                                 ,  input p-artic
      630                                                 ,  input p-prod-type
      631                                                 ,  input p-prod-code
      632                                                 ,  input no
      633                                                 , output d_out-qnty-kg
      634           ) .
      635             return ( if error-status :error then ? else d_out-qnty-kg ).
      636           end.
      637         end function.
      638     function valid-density returns logical ( input p-density as decimal, input p-unit-base-cli-eq as logical ) :
      639       define variable v-answ as logical no-undo .
      640       if ( p-unit-base-cli-eq = true
      641            and p-density = 1.0
      642          )
      643         or ( p-unit-base-cli-eq = false
      644              and p-density <> ?
      645              and p-density > 0.0
      646              and p-density < 1.0
      647            )
      648       then do:
      649         assign
      650           v-answ = true
      651         .
      652       end.
      653       else do:
      654         assign
      655           v-answ = false
      656         .
      657       end.
      658       return v-answ.
      659     end function.
