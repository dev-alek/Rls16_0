     1297     price-base-with-tax-loco = out-vatp_parts.price-base
     1298   .
     1299   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1300   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1301     (output varinvprbo
     1302     )  .
     1303     if out-vatp_parts.out-code = 'free-zone':U     or
     1304        out-vatp_parts.out-code = 'out-zone':U   or
     1305        out-vatp_parts.doc-type = 'акт':U then do:
     1306       assign
     1307         in-vatp-have-vat-slto = yes.
     1308     end.
     1309     else do:
     1310       find first in-vatp_doc-attro no-lock
     1311         where in-vatp_doc-attro.doc-code  = out-vatp_parts.out-code
     1312           and in-vatp_doc-attro.attr-code = 'envd':U
     1313         no-error .
     1314       if not available in-vatp_doc-attro then do:
     1315         assign
     1316           in-vatp-have-vat-slto = yes.
     1317       end.
     1318       else do:
     1319            in-vatp-have-vat-slto = no.
     1320       end.
     1321     end.
     1322     assign
     1323      price-cli-with-tax-loco = out-vatp_parts.price-cli
     1324      cli-base-rateo          = out-vatp_parts.cli-base-rate.
     1325     ASSIGN   road-tax-base-loco  = (if out-vatp_parts.road-tax-base  = ? then 0 else out-vatp_parts.road-tax-base)
     1326              road-tax-rubl-loco  = (if out-vatp_parts.road-tax-rubl  = ? then 0 else out-vatp_parts.road-tax-rubl).
     1327     ASSIGN  transport-base-loco = (if out-vatp_parts.transport-base = ? then 0 else out-vatp_parts.transport-base)
     1328             transport-rubl-loco = (if out-vatp_parts.transport-rubl = ? then 0 else out-vatp_parts.transport-rubl)
     1329             other-base-loco     = (if out-vatp_parts.other-base     = ? then 0 else out-vatp_parts.other-base)
     1330             other-rubl-loco     = (if out-vatp_parts.other-rubl     = ? then 0 else out-vatp_parts.other-rubl)
     1331             vat-pc-loco         = (if out-vatp_parts.vat-pc         = ? then 0 else out-vatp_parts.vat-pc)
     1332             slt-pc-loco         = (if out-vatp_parts.slt-pc         = ? then 0 else out-vatp_parts.slt-pc).
     1333             ASSIGN   slt-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     1334       ASSIGN   slt-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     1335     assign
     1336       exch-rate-cli-loco = (out-vatp_parts.price-rubl - transport-rubl-loco - other-rubl-loco - road-tax-rubl-loco - (if out-vatp_parts.vat-type <> 'в т. ч.':U then vat-rubl-loco else 0) - (if out-vatp_parts.slt-type <> 'в т. ч.':U then slt-rubl-loco else 0)) / out-vatp_parts.price-cli .
     1337     assign
     1338       slt-cli-loco        = slt-rubl-loco       / exch-rate-cli-loco
     1339       vat-cli-loco        = vat-rubl-loco       / exch-rate-cli-loco
     1340       road-tax-cli-loco   = road-tax-rubl-loco  / exch-rate-cli-loco
     1341       transport-cli-loco  = 0
     1342       other-cli-loco      = 0
     1343     .
     1344   ASSIGN
     1345             price-base-without-tax-loco = price-base-with-tax-loco - vat-base-loco - slt-base-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))
     1346       price-rubl-without-tax-loco = price-rubl-with-tax-loco - vat-rubl-loco - slt-rubl-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))
     1347   .
     1348         assign
     1349           varprice-base-cons = varprice-base-cons + (price-base-with-tax-loco - (if road-tax-base-loco = ? then 0 else road-tax-base-loco))* out-vatp_parts.fact-qnty
     1350           varprice-rubl-cons = varprice-rubl-cons + (price-rubl-with-tax-loco - (if road-tax-rubl-loco = ? then 0 else road-tax-rubl-loco))* out-vatp_parts.fact-qnty.
     1351         assign
     1352           varis-cons-parts-have = yes
     1353           varcons-qnty          = varcons-qnty + out-vatp_parts.fact-qnty.
     1354       end.
     1355       assign
     1356         varfact-qnty = varfact-qnty + out-vatp_parts.fact-qnty.
     1357     end.
     1358   end.
     1359   assign
     1360     varprice-base-cons = varprice-base-cons / varcons-qnty
     1361     varprice-rubl-cons = varprice-rubl-cons / varcons-qnty.
     1362   if varprice-base-cons = ? then do:
     1363     assign
     1364       varprice-base-cons = 0.
     1365   end.
     1366   if varprice-rubl-cons = ? then do:
     1367     assign
     1368       varprice-rubl-cons = 0.
     1369   end.
     1370   assign
     1371       slt-base-sale               = (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-base - ub.gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc)
     1372     vat-base-buyer              = (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-base - ub.gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-base - ub.gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-base-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc)
     1373     discnt-base-sale            = ub.gds-dtl.discnt-base
     1374     price-base-with-tax-sale    = (ub.gds-dtl.price-base - ub.gds-dtl.discnt-base)
     1375       slt-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc)
     1376     vat-rubl-buyer              = (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-rubl-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc)
     1377     discnt-rubl-sale            = ub.gds-dtl.discnt-rubl
     1378     price-rubl-with-tax-sale    = (ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl)
     1379     .
     1380   if t-doc.doc-type = 'инв':U then do:
     1381     assign
     1382       varfact-qnty = ub.gds-dtl.doc-qnty.
     1383   end.
     1384   else do:
     1385     assign
     1386       varfact-qnty = ub.gds-dtl.fact-qnty.
     1387   end.
     1388   if varis-cons-parts-have = no then do:
     1389     assign
     1390           vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-base - ub.gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-base - ub.gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-base-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc)
     1391           vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-rubl-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc).
     1392   end.
     1393   else do:
     1394     if t-doc.doc-type = 'инв':U then do:
     1395       assign
     1396               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((ub.gds-dtl.price-base - ub.gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-base - ub.gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * ub.doc-line.cons-vat-pc / (100 + ub.doc-line.cons-vat-pc) * ub.gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((ub.gds-dtl.price-base - ub.gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-base - ub.gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-base-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc) * ub.gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     1397               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * ub.doc-line.cons-vat-pc / (100 + ub.doc-line.cons-vat-pc) * ub.gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-rubl-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc) * ub.gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     1398        .
     1399     end.
     1400     else do:
     1401       assign
     1402               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((ub.gds-dtl.price-base - ub.gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-base - ub.gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * ub.doc-line.cons-vat-pc / (100 + ub.doc-line.cons-vat-pc) * ub.gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((ub.gds-dtl.price-base - ub.gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-base - ub.gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - varprice-base-cons) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc) * ub.gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     1403               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * ub.doc-line.cons-vat-pc / (100 + ub.doc-line.cons-vat-pc) * ub.gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - varprice-rubl-cons) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc) * ub.gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     1404        .
     1405     end.
     1406   end.
     1407   assign
     1408   price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     1409   price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     1410         assign doc-price = ( if v-rb-is-base = yes then ( price-base-with-tax-sale - vat-rubl-sale )
     1411                                                    else ( price-rubl-with-tax-sale - vat-rubl-sale ) ) / v-density.
     1412       end.
     1413       assign VAT-gds = ( price-lst - ( price-lst - ub.doc-line.road-tax * 1 / v-density ) * t-doc-line.SLT-pc / ( 100 + t-doc-line.SLT-pc ) - v-tax-sum ) * t-doc-line.vat-pc / ( 100 + t-doc-line.vat-pc )
     1414              marg    =   price-lst -   doc-price    - VAT-gds     - ( price-lst - ub.doc-line.road-tax * 1 / v-density ) * t-doc-line.SLT-pc / ( 100 + t-doc-line.SLT-pc ).
     1415       assign v-price-rb     = ( if print_rubl = yes then ub.gds-dtl.price-rubl else ub.gds-dtl.price-base ) / v-density
     1416              j_total        =   j_total       + 1
     1417              v-fact-qnty-kg =
     1418       invlnsum_cli-qnty (
     1419                      ub.gds-dtl.doc-code
     1420                    , ub.goods.artic
     1421                    , ub.goods.prod-type
     1422                    , ub.goods.prod-code
     1423                    )
     1424              sum-no-VAT     =   v-fact-qnty-kg *   doc-price
     1425              doc-sum        =   v-fact-qnty-kg *   v-price-rb
     1426              obj-sum        =   v-fact-qnty-kg *   price-lst
     1427              SLT-sum        =   v-fact-qnty-kg * ( price-lst - ub.doc-line.road-tax * 1 / v-density ) * t-doc-line.SLT-pc / ( 100 + t-doc-line.SLT-pc )
     1428              VAT-sum        =   v-fact-qnty-kg *   VAT-gds
     1429              d_delta        =   obj-sum        -   doc-sum.
     1430       assign total_qnty-kg  =   total_qnty-kg + v-fact-qnty-kg
     1431              total_SLT-sum  =   total_SLT-sum + SLT-sum
     1432              total_VAT-sum  =   total_VAT-sum + VAT-sum
     1433              total_no-VAT   =   total_no-VAT  + sum-no-VAT
     1434              total_obj-sum  =   total_obj-sum + obj-sum
     1435              total_doc-sum  =   total_doc-sum + doc-sum
     1436              total_delta    =   total_delta   + d_delta
     1437              total_up-fact  =   total_up-fact + v-fact-qnty-kg * marg.
     1438       display stream s-out
     1439         sym1 trim( string( ub.bar-code.b-code ) )                             @ tb-code
     1440                            ub.gds-dtl.artic
     1441                            ub.goods.gds-name
     1442                            v-fact-qnty-kg                                     @ ub.gds-dtl.fact-qnty
     1443                            doc-price
     1444                            sum-no-VAT
     1445                            doc-sum
     1446                            price-lst
     1447                            obj-sum
     1448                            SLT-sum
     1449                            t-doc-line.vat-pc
     1450                            VAT-sum
     1451              string( string( marg    / doc-price * 100, "->>>9.9":U ) + "%" ) @ UpFact
     1452              string( string( d_delta / doc-sum   * 100, "->>>9.9":U ) + "%" ) @ Delt   sym2.
     1453       if last( ub.gds-dtl.artic ) then do:
     1454         down stream s-out 1.
     1455         put  stream s-out Line format "x(178)":U skip.
     1456         display stream s-out
     1457                           "  ИТОГО"                                                  @ ub.goods.gds-name
     1458                           total_qnty-kg                                              @ ub.gds-dtl.fact-qnty
     1459                           total_no-VAT                                               @ sum-no-VAT
     1460                           total_doc-sum                                              @ doc-sum
     1461                           total_obj-sum                                              @ obj-sum
     1462                           total_SLT-sum                                              @ SLT-sum
     1463                           total_VAT-sum                                              @ VAT-sum
     1464           string( string( total_up-fact / total_no-VAT  * 100, "->>>9.9":U ) + "%" ) @ UpFact
     1465           string( string( total_delta   / total_doc-sum * 100, "->>>9.9":U ) + "%" ) @ Delt.
     1466         underline stream s-out ub.goods.gds-name ub.gds-dtl.fact-qnty sum-no-VAT doc-sum obj-sum SLT-sum UpFact Delt VAT-sum.
     1467         down stream s-out 2.
     1468       end.
     1469     end.
     1470     hide stream s-out frame BottomFrame.
     1471     if v-rb-is-base = yes then do:
     1472       assign propis = Total-Word( total_obj-sum, base-type, base-part )
     1473              abbr   = base-type.
     1474     end.                  else do:
     1475       assign propis = Total-Word( total_obj-sum, Roubles( total_obj-sum ), Copecks( total_obj-sum ) )
     1476              abbr   = " руб.".
     1477     end.
     1478     put stream s-out
     1479         space( 10 ) "Всего  " j_total format ">>>>9":U " наименований." format "x(15)":U skip( 1 )
     1480         space( 10 ) string( "Сумма цен по объекту составила : " +
     1481                       trim( string( total_obj-sum, "->>>,>>>,>>>,>>>,>>9.99":U ) ) + " ":U + trim( abbr ) +
     1482                             ", в том числе налог с продаж : "   +
     1483                       trim( string( total_SLT-sum, "->>>,>>>,>>>,>>>,>>9.99":U ) ) + " ":U + trim( abbr ) +
     1484                             ", НДС : "                          +
     1485                       trim( string( total_VAT-sum, "->>>,>>>,>>>,>>>,>>9.99":U ) ) + " ":U + trim( abbr ) ) format "x(126)":U skip( 1 )
     1486         space( 10 ) "Разница между суммой в продажных ценах по объекту и суммой в ценах документа без НДС составила: "
     1487                     + trim( string( total_obj-sum - total_no-VAT, "->>>,>>>,>>>,>>>,>>9.99":U ) )
     1488                     + " ":U + trim( abbr ) format "x(126)":U skip( 1 ).
     1489     if line-counter( s-out ) + 4 > page-size( s-out ) then do: page stream s-out. end.
     1490     put stream s-out
     1491       space( 10 ) string( "ИТОГО по акту передано товаров на сумму  " +
     1492       ( if trim( propis ) begins trim( abbr ) then "0 " else "":U ) + caps( propis ) ) format "x(126)":U skip( 1 ).
     1493     run get-boss-and-buh in this-procedure ( input t-doc.obj-type, input t-doc.obj-code, output v-main-boss, output v-main-buh ).
     1494     put stream s-out space( 20 ) "От владельца : "
     1495                                  "От эксплуататора : " at 80
     1496                                  v-storeman                    format "x(20)":U skip( 1 )
     1497                      space( 20 ) "Руководитель предприятия:                                             / "
     1498                                  string( v-main-boss  + " /" ) format "x(40)":U skip( 1 )
     1499                      space( 20 ) "Главный бухгалтер:                                                    / "
     1500                                  string( v-main-buh  + " /" )  format "x(40)":U.
     1501     output stream s-out close.
     1502   if g#quest-print = false
     1503   then do:
     1504     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     1505                                         7, (if 8 >= 8 then 2 else 0), 0, 0,
     1506                                         OUTPUT g#log ).
     1507   end.
     1508   else do:
     1509     os-command silent
     1510       value( "COPY /b " +
     1511         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     1512         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     1513         string( session:temp-directory) +  "$" + string( g#report-num )
     1514                 ) .
     1515     os-command silent
     1516       value( "COPY /b " +
     1517         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     1518         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     1519         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     1520                 ) .
     1521   end.
     1522   end.
     1523   procedure get-boss-and-buh :
     1524     define  input parameter p-obj-type  as character no-undo.
     1525     define  input parameter p-obj-code  as integer   no-undo.
     1526     define output parameter p-main-boss as character no-undo.
     1527     define output parameter p-main-buh  as character no-undo.
     1528     define variable j_host-code as integer no-undo.
     1529     define buffer buf_clients for ub.clients.
     1530     define buffer buf_firm    for ub.firm.
     1531     define buffer buf_sysconf for ub.sysconf.
     1532     do on error undo, return error :
     1533   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1534   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1535     (input  p-obj-type
     1536     ,input  p-obj-code
     1537     ,output j_host-code
     1538     )  .
     1539       find first buf_clients no-lock where
     1540                  buf_clients.obj-type = 'орг':U and
     1541                  buf_clients.obj-code = j_host-code.
     1542       find first buf_firm no-lock where buf_firm.firm-code = buf_clients.obj-code.
     1543       assign p-main-boss = buf_firm.director.
     1544       find first buf_sysconf no-lock where buf_sysconf.host-code = buf_firm.firm-code.
     1545       assign p-main-buh  = buf_sysconf.snr-accnt.
     1546     end.
     1547   end procedure.
     1548   procedure get-expl-store :
     1549     define  input parameter p-obj-type like ub.trn-doc.obj-type no-undo.
     1550     define  input parameter p-obj-code like ub.trn-doc.obj-code no-undo.
     1551     define output parameter p-explname as   character           no-undo initial ?.
     1552     define output parameter p-storeman as   character           no-undo initial ?.
     1553     define buffer buf_clients for ub.clients.
     1554     define buffer buf_shop    for ub.shop.
     1555     define buffer buf_store   for ub.store.
     1556     do on error undo, return error :
     1557       find first buf_clients no-lock where
     1558                  buf_clients.obj-type = p-obj-type and
     1559                  buf_clients.obj-code = p-obj-code.
     1560       case buf_clients.obj-type :
     1561         when 'маг':U  then do:
     1562           find first buf_shop no-lock where buf_shop.obj-code = buf_clients.obj-code.
     1563           assign p-explname = buf_shop.director
     1564                  p-storeman = buf_shop.store-man.
     1565         end.
     1566         when 'скл':U then do:
     1567           find first buf_store no-lock where buf_store.obj-code = buf_clients.obj-code.
     1568           assign p-explname = buf_store.store-boss
     1569                  p-storeman = buf_store.store-man.
     1570         end.
     1571       end case.
     1572     end.
     1573   end procedure.
