     3870   PROCEDURE do-zuka :
     3871   define input parameter p-year as integer no-undo.
     3872   define input parameter p-month as integer no-undo.
     3873   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     3874   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     3875   DEFINE VARIABLE v-doc-ext-doc-type as character no-undo .
     3876   DEFINE VARIABLE jj as integer no-undo .
     3877   define buffer buf_t-dinamo for t-dinamo.
     3878   define buffer z_t-dinamo for t-dinamo.
     3879   do jj = 1 to num-entries ('ee':U + chr(44) +                               'es':U + chr(44) +                               're':U + chr(44) +                               'rs':U):
     3880     assign
     3881     v-doc-ext-doc-type = entry(jj, ('ee':U + chr(44) +                               'es':U + chr(44) +                               're':U + chr(44) +                               'rs':U))
     3882     .
     3883     find first buf_t-dinamo no-lock where
     3884               buf_t-dinamo.ym = p-year * 100 + p-month
     3885           AND buf_t-dinamo.ext-doc-type = v-doc-ext-doc-type .
     3886     find first z_t-dinamo where
     3887                z_t-dinamo.ym = buf_t-dinamo.ym
     3888            AND z_t-dinamo.ext-doc-type =  (buf_t-dinamo.ext-doc-type + chr(44) + "discount":U)
     3889            no-error .
     3890     if not avail z_t-dinamo then do:
     3891       create z_t-dinamo.
     3892       buffer-copy buf_t-dinamo except doc-type-full to z_t-dinamo
     3893       assign
     3894       z_t-dinamo.ext-doc-type = buf_t-dinamo.ext-doc-type + chr(44) + "discount":U
     3895       z_t-dinamo.doc-type-full = fill(chr(32), 5) +  "Скидка"
     3896       z_t-dinamo.is-zuka = yes
     3897       .
     3898     end.
     3899     assign
     3900     z_t-dinamo.sale-sum-rubl =  if buf_t-dinamo.sale-sum-rubl = 0
     3901                                 then 0
     3902                                 else
     3903                                 (buf_t-dinamo.sale-sum-rubl - buf_t-dinamo.doc-sum-rubl) / buf_t-dinamo.sale-sum-rubl * 100
     3904     z_t-dinamo.cost-sum-rubl = buf_t-dinamo.sale-sum-rubl - buf_t-dinamo.doc-sum-rubl
     3905     z_t-dinamo.sale-sum-base = if buf_t-dinamo.sale-sum-base = 0
     3906                               then 0
     3907                               else
     3908                               (buf_t-dinamo.sale-sum-base - buf_t-dinamo.doc-sum-base) / buf_t-dinamo.sale-sum-base * 100
     3909     z_t-dinamo.cost-sum-base = buf_t-dinamo.sale-sum-base - buf_t-dinamo.doc-sum-base
     3910     .
     3911     find first z_t-dinamo where
     3912                z_t-dinamo.ym = buf_t-dinamo.ym
     3913            AND z_t-dinamo.ext-doc-type = (buf_t-dinamo.ext-doc-type + chr(44) + "benefit":U)
     3914            no-error .
     3915     if not avail z_t-dinamo then do:
     3916       create z_t-dinamo.
     3917       buffer-copy buf_t-dinamo except ext-doc-type to z_t-dinamo
     3918       assign
     3919       z_t-dinamo.ext-doc-type = buf_t-dinamo.ext-doc-type + chr(44) + "benefit":U
     3920       z_t-dinamo.doc-type-full = fill(chr(32), 5) +  "Доход"
     3921       z_t-dinamo.is-zuka = yes
     3922       .
     3923     end.
     3924     assign
     3925     z_t-dinamo.sale-sum-rubl = if buf_t-dinamo.cost-sum-rubl = 0
     3926                               then 0
     3927                               else
     3928                               (buf_t-dinamo.doc-sum-rubl - buf_t-dinamo.cost-sum-rubl) / buf_t-dinamo.cost-sum-rubl * 100
     3929     z_t-dinamo.cost-sum-rubl = buf_t-dinamo.doc-sum-rubl - buf_t-dinamo.cost-sum-rubl
     3930     z_t-dinamo.sale-sum-base = if buf_t-dinamo.cost-sum-rubl = 0
     3931                               then 0
     3932                               else
     3933                               (buf_t-dinamo.doc-sum-base - buf_t-dinamo.cost-sum-base) / buf_t-dinamo.cost-sum-base * 100
     3934     z_t-dinamo.cost-sum-base = buf_t-dinamo.doc-sum-base - buf_t-dinamo.cost-sum-base
     3935     .
     3936   end.
     3937   END PROCEDURE.
     3938   PROCEDURE enable_UI :
     3939     DISPLAY T-cost RS-curr f-date-start F-unit-base
     3940         WITH FRAME Dialog-Frame.
     3941     ENABLE b-quit B-Help RECT-2 BR-dinamo RS-curr BR-month BR-stk B-uchet
     3942            B-objects B-print
     3943         WITH FRAME Dialog-Frame.
     3944     VIEW FRAME Dialog-Frame.
     3945     OPEN QUERY BR-dinamo FOR EACH t-dinamo no-lock where t-dinamo.ym = t-month.ym.    define variable v-last-ym as integer no-undo. if not can-find(first t-month no-lock where                         t-month.ym > v-cut-ym) and          can-find(first t-month no-lock where                         t-month.ym <= v-cut-ym) then do:     find last t-month no-lock where                 t-month.ym < v-cut-ym .     assign     v-last-ym = t-month.ym     .     OPEN QUERY BR-month FOR EACH t-month no-lock where t-month .ym = v-last-ym.  end.  else do: OPEN QUERY BR-month FOR EACH t-month no-lock where t-month.ym >= v-cut-ym. end.    OPEN QUERY BR-stk FOR EACH t-stk no-lock where t-stk.ym = t-month.ym.
     3946   END PROCEDURE.
     3947   PROCEDURE fill-dinamo :
     3948   define input parameter p-year as integer no-undo .
     3949   define input parameter p-month as integer no-undo .
     3950   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     3951   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     3952   if lookup( string( p-year * 100 + p-month ), v-MontYear_List ) > 0 then
     3953     return.
     3954   v-MontYear_List = v-MontYear_List + (if v-MontYear_List = '' then '' else ',' )
     3955                   + string( p-year * 100 + p-month ).
     3956   DEFINE VARIABLE ii as integer no-undo .
     3957   DEFINE VARIABLE jj as integer no-undo .
     3958   DEFINE VARIABLE v-ext-doc-type as character no-undo .
     3959   DEFINE VARIABLE v-ext-doc-type-full as character no-undo .
     3960   DEFINE VARIABLE v-doc-type as character no-undo .
     3961   DEFINE VARIABLE v-doc-type-full as character no-undo .
     3962   DEFINE VARIABLE v-idoc-type as character no-undo .
     3963   DEFINE VARIABLE v-sign as character no-undo .
     3964   DEFINE VARIABLE v-sign-int as integer no-undo .
     3965   DEFINE VARIABLE v-sale-sum-type as character no-undo .
     3966   DEFINE VARIABLE v-cost-sum-type as character no-undo .
     3967   DEFINE VARIABLE v-doc-sum-type as character no-undo .
     3968   DEFINE VARIABLE v-last-day as integer no-undo .
     3969   DEFINE VARIABLE bfact-order like ub.ot-line.fact-order no-undo .
     3970   DEFINE VARIABLE afact-order like ub.ot-line.fact-order no-undo .
     3971   define buffer m_t-dinamo  for t-dinamo.
     3972   define buffer sale_ot-line for ub.ot-line  .
     3973   define buffer cost_ot-line for ub.ot-line  .
     3974   define buffer doc_ot-line for ub.ot-line.
     3975   assign
     3976   v-sign = string(0)
     3977   .
     3978   _ii:
     3979   do ii = 1 to num-entries('ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U):
     3980     assign
     3981     v-ext-doc-type = entry(ii, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     3982     v-doc-type = get-doc-type(input ii, input-output v-ext-doc-type, input-output v-sign, output v-ext-doc-type-full, output v-doc-type-full, output v-idoc-type)
     3983     .
     3984     if v-idoc-type = "0" then next _ii.
     3985     do jj = 1 to num-entries(v-ext-doc-type):
     3986       find first t-dinamo where
     3987                 t-dinamo.ym = p-year * 100 + p-month
     3988             AND t-dinamo.ext-doc-type = entry(jj, v-ext-doc-type)
     3989             AND t-dinamo.idoc-type = integer(entry(jj, v-idoc-type))
     3990             AND t-dinamo.sign_ = integer(entry(jj, v-sign)) no-error .
     3991       if not available t-dinamo then do:
     3992         create t-dinamo.
     3993         assign
     3994         t-dinamo.ym = p-year * 100 + p-month
     3995         t-dinamo.year_ = p-year
     3996         t-dinamo.month_ = p-month
     3997         t-dinamo.ext-doc-type = entry(jj, v-ext-doc-type)
     3998         t-dinamo.doc-type = entry(jj, v-doc-type)
     3999         t-dinamo.ext-doc-type-full = entry(jj, v-ext-doc-type-full)
     4000         t-dinamo.doc-type-full = t-dinamo.ext-doc-type-full
     4001         t-dinamo.idoc-type = integer(entry(jj, v-idoc-type))
     4002         t-dinamo.sign_ = integer(entry(jj, v-sign))
     4003         .
     4004         find first m_t-dinamo no-lock where
     4005                    m_t-dinamo.ym = t-dinamo.ym
     4006               AND m_t-dinamo.idoc-type = t-dinamo.idoc-type
     4007               AND m_t-dinamo.ext-doc-type = "":U no-error .
     4008         if not avail m_t-dinamo then do:
     4009           create m_t-dinamo.
     4010           assign
     4011           m_t-dinamo.ym = p-year * 100 + p-month
     4012           m_t-dinamo.year_ = p-year
     4013           m_t-dinamo.month_ = p-month
     4014           m_t-dinamo.ext-doc-type = "":U
     4015           m_t-dinamo.doc-type = entry(jj, v-doc-type)
     4016           m_t-dinamo.ext-doc-type-full = "":U
     4017           m_t-dinamo.doc-type-full = v-doc-type-full
     4018           m_t-dinamo.idoc-type = integer(entry(jj, v-idoc-type))
     4019           m_t-dinamo.sign = 0
     4020           .
     4021         end.
     4022       end.
     4023     end.
     4024   end.
     4025   ASSIGN v-last-day = last-day( date( p-month, 1, p-year ) ).
     4026   run day-begin-fact-order in this-procedure (
     4027                                                input date(p-month, 1, p-year)
     4028                                                ,output bfact-order).
     4029   run factord-end-day  in this-procedure (
     4030                                                input  date(p-month, v-last-day, p-year)
     4031                                                ,output afact-order).
     4032   if buf_goods.gds-type = 'т':U then do:
     4033     assign
     4034     v-sale-sum-type = 'crsa':U
     4035     v-cost-sum-type = 'cost':U
     4036     v-doc-sum-type = 'sale':U
     4037     .
     4038   end.
     4039   else do:
     4040     assign
     4041     v-sale-sum-type = 'cgsr':U
     4042     v-cost-sum-type = 'cssr':U
     4043     v-doc-sum-type = 'sasr':U
     4044     .
     4045   end.
     4046   find first t-fo no-lock where
     4047              t-fo.obj-type = p-obj-type
     4048          AND t-fo.obj-code = p-obj-code no-error .
     4049   if avail t-fo and t-fo.fact-order <> 0 then do:
     4050     assign
     4051     bfact-order = min(bfact-order, t-fo.fact-order)
     4052     afact-order = min(afact-order, t-fo.fact-order)
     4053     .
     4054   end.
     4055   _sale:
     4056   for each sale_ot-line no-lock where
     4057            sale_ot-line.artic = buf_goods.artic
     4058        AND sale_ot-line.prod-type = buf_goods.prod-type
     4059        AND sale_ot-line.prod-code = buf_goods.prod-code
     4060        AND sale_ot-line.obj-type = p-obj-type
     4061        AND sale_ot-line.obj-code = p-obj-code
     4062        AND sale_ot-line.sum-type = v-sale-sum-type
     4063        and sale_ot-line.fact-order >= bfact-order
     4064        and sale_ot-line.fact-order <= afact-order
     4065        :
     4066     find first cost_ot-line no-lock where
     4067            cost_ot-line.artic = buf_goods.artic
     4068        AND cost_ot-line.prod-type = buf_goods.prod-type
     4069        AND cost_ot-line.prod-code = buf_goods.prod-code
     4070        AND cost_ot-line.obj-type = p-obj-type
     4071        AND cost_ot-line.obj-code = p-obj-code
     4072        AND cost_ot-line.cat-id = '##,##':U
     4073        AND cost_ot-line.sum-type = v-cost-sum-type
     4074        and cost_ot-line.doc-code = sale_ot-line.doc-code no-error .
     4075     assign
     4076     v-sign = string(if (sale_ot-line.fact-qnty >= 0) then 1 else -1)
     4077     v-ext-doc-type = sale_ot-line.ext-doc-type
     4078     ii = lookup(v-ext-doc-type, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     4079     v-doc-type = get-doc-type(input ii,
     4080                               input-output v-ext-doc-type,
     4081                               input-output v-sign,
     4082                               output v-ext-doc-type-full,
     4083                               output v-doc-type-full,
     4084                               output v-idoc-type)
     4085     v-sign-int = integer(v-sign)
     4086     .
     4087     if v-idoc-type = "0" then next _sale.
     4088     find first t-dinamo where
     4089                t-dinamo.ym = p-year * 100 + p-month
     4090            AND t-dinamo.ext-doc-type = sale_ot-line.ext-doc-type
     4091            AND t-dinamo.sign_ = v-sign-int no-error .
     4092     if avail t-dinamo then do:
     4093       assign
     4094       t-dinamo.fact-qnty = t-dinamo.fact-qnty + sale_ot-line.fact-qnty
     4095       t-dinamo.sale-sum-rubl = t-dinamo.sale-sum-rubl + sale_ot-line.sum-rubl
     4096       t-dinamo.sale-sum-base = t-dinamo.sale-sum-base +  sale_ot-line.sum-base
     4097       t-dinamo.cost-sum-rubl = t-dinamo.cost-sum-rubl +  (if avail cost_ot-line then cost_ot-line.sum-rubl else 0)
     4098       t-dinamo.cost-sum-base = t-dinamo.cost-sum-base +  (if avail cost_ot-line then cost_ot-line.sum-base else 0)
     4099       .
     4100     end.
     4101   end.
     4102   do jj = 1 to num-entries(('ee':U + chr(44) +                               'es':U + chr(44) +                               're':U + chr(44) +                               'rs':U)):
     4103     find first t-dinamo where
     4104               t-dinamo.ym =p-year * 100 + p-month
     4105           AND t-dinamo.ext-doc-type = entry(jj, ('ee':U + chr(44) +                               'es':U + chr(44) +                               're':U + chr(44) +                               'rs':U)) .
     4106     for each doc_ot-line no-lock where
     4107             doc_ot-line.artic = buf_goods.artic
     4108         AND doc_ot-line.prod-type = buf_goods.prod-type
     4109         AND doc_ot-line.prod-code = buf_goods.prod-code
     4110         AND doc_ot-line.obj-type = p-obj-type
     4111         AND doc_ot-line.obj-code = p-obj-code
     4112         AND doc_ot-line.sum-type = v-doc-sum-type
     4113         and doc_ot-line.ext-doc-type = entry(jj, ('ee':U + chr(44) +                               'es':U + chr(44) +                               're':U + chr(44) +                               'rs':U))
     4114         and doc_ot-line.fact-order >= bfact-order
     4115         and doc_ot-line.fact-order <= afact-order
     4116         :
     4117       assign
     4118       t-dinamo.doc-sum-rubl = t-dinamo.doc-sum-rubl + doc_ot-line.sum-rubl
     4119       t-dinamo.doc-sum-base = t-dinamo.doc-sum-base + doc_ot-line.sum-base
     4120       .
     4121     end.
     4122   end.
     4123   run do-zuka in this-procedure (p-year, p-month, p-obj-type, p-obj-code).
     4124   END PROCEDURE.
     4125   PROCEDURE fill-tables :
     4126   DEFINE VARIABLE v-before-fact-date      like ub.stk-line.fact-date no-undo .
     4127   DEFINE VARIABLE v-before-ym             as integer no-undo .
     4128   DEFINE VARIABLE v-before-fact-order     like ub.stk-line.fact-order no-undo .
     4129   DEFINE VARIABLE v-before-fact-qnty      like ub.stk-line.fact-qnty no-undo .
     4130   DEFINE VARIABLE v-before-sale-sum-rubl  like ub.stk-line.sum-rubl no-undo .
     4131   DEFINE VARIABLE v-before-sale-sum-base  like ub.stk-line.sum-base no-undo .
     4132   DEFINE VARIABLE v-before-cost-sum-rubl  like ub.stk-line.sum-rubl no-undo .
     4133   DEFINE VARIABLE v-before-cost-sum-base  like ub.stk-line.sum-base no-undo .
     4134   DEFINE VARIABLE v-after-fact-qnty      like ub.stk-line.fact-qnty no-undo .
     4135   DEFINE VARIABLE v-after-sale-sum-rubl  like ub.stk-line.sum-rubl no-undo .
     4136   DEFINE VARIABLE v-after-sale-sum-base  like ub.stk-line.sum-base no-undo .
     4137   DEFINE VARIABLE v-after-cost-sum-rubl  like ub.stk-line.sum-rubl no-undo .
     4138   DEFINE VARIABLE v-after-cost-sum-base  like ub.stk-line.sum-base no-undo .
     4139   DEFINE VARIABLE v-date-start           as date no-undo init 01/01/1990.
     4140   DEFINE VARIABLE v-date-end             as date no-undo  init 12/31/9999.
     4141   DEFINE VARIABLE v-ret                  as logical no-undo .
     4142   define variable p-comment              as character no-undo .
     4143   define variable v-can-print            as logical   no-undo .
     4144   define buffer sale_stk-line for ub.stk-line.
     4145   define buffer cost_stk-line for ub.stk-line.
     4146   define buffer before_t-stk-obj for t-stk-obj.
     4147   define buffer after_t-stk-obj for t-stk-obj.
     4148   define buffer skip_t-stk for t-stk .
     4149   run waitfram-show in this-procedure ( "Ждите" ).
     4150   for each t-month:
     4151     delete t-month.
     4152   end.
     4153   for each t-stk:
     4154     delete t-stk.
     4155   end.
     4156   for each t-stk-obj:
     4157     delete t-stk-obj.
     4158   end.
     4159   for each t-dinamo:
     4160     delete t-dinamo.
     4161   end.
     4162   for each t-fo:
     4163     delete t-fo.
     4164   end.
     4165   assign
     4166   f-date-start = 01/01/1990
     4167   .
     4168   for each obj-list no-lock
     4169   :
     4170     run rep/chk-ahz.p
     4171       (input        obj-list.obj-type
     4172       ,input        obj-list.obj-code
     4173       ,input        false
     4174       ,input        yes
     4175       ,input        no
     4176       ,input        no
     4177       ,input        yes
     4178       ,input        v-cntxt-db-num
     4179       ,input        v-cntxt-userid
     4180       ,input-output v-date-start
     4181       ,input-output v-date-end
     4182       ,output       v-ret
     4183       ,output       p-comment
     4184       ,output       v-can-print
     4185       ) no-error .
     4186     if error-status :error = yes then do:
     4187       error-status :error = no.
     4188     end.
     4189     create t-fo.
     4190     assign
     4191     t-fo.obj-type = obj-list.obj-type
     4192     t-fo.obj-code = obj-list.obj-code
     4193     t-fo.cfact-date = v-date-start
     4194     t-fo.ym = year(v-date-start) * 100 + month(v-date-start)
     4195     v-cut-ym = maximum(v-cut-ym, t-fo.ym)
     4196     f-date-start = maximum(f-date-start, v-date-start)
     4197     .
     4198   end.
     4199   if buf_goods.gds-type = 'т':U then do:
     4200     for each obj-list no-lock,
     4201       each sale_stk-line no-lock
     4202         where sale_stk-line.obj-type = obj-list.obj-type
     4203           AND sale_stk-line.obj-code = obj-list.obj-code
     4204           AND sale_stk-line.artic = buf_goods.artic
     4205           AND sale_stk-line.prod-type = buf_goods.prod-type
     4206           AND sale_stk-line.prod-code = buf_goods.prod-code
     4207           AND sale_stk-line.cat-id = '##,##':U
     4208           AND sale_stk-line.sum-type = 'crsa':U
     4209     break
     4210     by sale_stk-line.obj-type
     4211     by sale_stk-line.obj-code
     4212     by sale_stk-line.fact-order
     4213     :
     4214       if first-of(sale_stk-line.obj-code) then do:
     4215         assign
     4216         v-before-fact-date = ?
     4217         v-before-ym  = 0
     4218         v-before-fact-order = 0
     4219         v-before-fact-qnty  = 0
     4220         v-after-fact-qnty  = 0
     4221         v-before-cost-sum-rubl = 0
     4222         v-before-cost-sum-base = 0
     4223         v-after-cost-sum-rubl = 0
     4224         v-after-cost-sum-base = 0
     4225         v-before-sale-sum-rubl = 0
     4226         v-before-sale-sum-base = 0
     4227         v-after-sale-sum-rubl = 0
     4228         v-after-sale-sum-base = 0
     4229         v-MontYear_List = ''
     4230         .
     4231       end.
     4232       find first t-month where
     4233                 t-month.ym = year(sale_stk-line.fact-date) * 100 +  month(sale_stk-line.fact-date)
     4234                 no-error .
     4235       if not avail t-month then do:
     4236         find first cost_stk-line no-lock where
     4237                   cost_stk-line.artic = buf_goods.artic
     4238               AND cost_stk-line.prod-type = buf_goods.prod-type
     4239               AND cost_stk-line.prod-code = buf_goods.prod-code
     4240               AND cost_stk-line.obj-type = obj-list.obj-type
     4241               AND cost_stk-line.obj-code = obj-list.obj-code
     4242               AND cost_stk-line.sum-type = 'cost':U
     4243               AND cost_stk-line.fact-order = v-before-fact-order no-error .
     4244         if avail cost_stk-line then do:
     4245           assign
     4246             v-before-cost-sum-rubl = cost_stk-line.sum-rubl
     4247             v-before-cost-sum-base = cost_stk-line.sum-base
     4248             v-after-cost-sum-rubl = cost_stk-line.sum-rubl
     4249             v-after-cost-sum-base = cost_stk-line.sum-base
     4250           .
     4251         end.
     4252         create t-month.
     4253         assign
     4254           t-month.month_ = month(sale_stk-line.fact-date)
     4255           t-month.year_ = year(sale_stk-line.fact-date)
     4256           t-month.ym = t-month.year_ * 100 + t-month.month_
     4257           t-month.obj-type = obj-list.obj-type
     4258           t-month.obj-code = obj-list.obj-code
     4259         .
     4260         create t-stk-obj.
     4261         assign
     4262           t-stk-obj.month_ = month(sale_stk-line.fact-date)
     4263           t-stk-obj.year_ = year(sale_stk-line.fact-date)
     4264           t-stk-obj.ym = t-stk-obj.year_ * 100 + t-stk-obj.month_
     4265           t-stk-obj.b-a = 0
     4266           t-stk-obj.b-a-full = "Начало месяца"
     4267           t-stk-obj.fact-qnty  = v-before-fact-qnty
     4268           t-stk-obj.sale-sum-rubl = v-before-sale-sum-rubl
     4269           t-stk-obj.sale-sum-base  = v-before-sale-sum-base
     4270           t-stk-obj.cost-sum-rubl = v-before-cost-sum-rubl
     4271           t-stk-obj.cost-sum-base  = v-before-cost-sum-base
     4272           t-stk-obj.obj-type = obj-list.obj-type
     4273           t-stk-obj.obj-code = obj-list.obj-code
     4274         .
     4275         run fill-dinamo in this-procedure (t-stk-obj.year_, t-stk-obj.month_, obj-list.obj-type, obj-list.obj-code) .
     4276         if v-before-ym > 0 then do:
     4277           find first before_t-stk-obj
     4278             where before_t-stk-obj.ym = v-before-ym
     4279               AND before_t-stk-obj.b-a = 0
     4280               AND before_t-stk-obj.obj-type = obj-list.obj-type
     4281               AND before_t-stk-obj.obj-code = obj-list.obj-code
     4282             no-error .
     4283         end.
     4284         else do:
     4285           if avail before_t-stk-obj then do:
     4286             release before_t-stk-obj.
     4287           end.
     4288         end.
     4289         if not avail before_t-stk-obj then do:
     4290         end.
     4291         else do:
     4292           find first after_t-stk-obj
     4293             where after_t-stk-obj.ym = before_t-stk-obj.ym
     4294               AND after_t-stk-obj.b-a = 1
     4295               AND after_t-stk-obj.obj-type = obj-list.obj-type
     4296               AND after_t-stk-obj.obj-code = obj-list.obj-code
     4297             no-error .
     4298           if not avail after_t-stk-obj then do:
     4299             create after_t-stk-obj.
     4300             assign
     4301             after_t-stk-obj.ym = before_t-stk-obj.ym
     4302             after_t-stk-obj.year_ = before_t-stk-obj.year_
     4303             after_t-stk-obj.month_ = before_t-stk-obj.month_
     4304             after_t-stk-obj.b-a = 1
     4305             after_t-stk-obj.b-a-full = "Конец месяца"
     4306             after_t-stk-obj.obj-type = obj-list.obj-type
     4307             after_t-stk-obj.obj-code = obj-list.obj-code
     4308             .
     4309             run fill-dinamo in this-procedure (after_t-stk-obj.year_, after_t-stk-obj.month_, obj-list.obj-type, obj-list.obj-code) .
     4310           end.
     4311           assign
     4312           after_t-stk-obj.fact-qnty     =  after_t-stk-obj.fact-qnty     +   v-after-fact-qnty
     4313           after_t-stk-obj.sale-sum-rubl =  after_t-stk-obj.sale-sum-rubl +   v-after-sale-sum-rubl
     4314           after_t-stk-obj.sale-sum-base =  after_t-stk-obj.sale-sum-base +   v-after-sale-sum-base
     4315           after_t-stk-obj.cost-sum-rubl =  after_t-stk-obj.cost-sum-rubl +   v-after-cost-sum-rubl
     4316           after_t-stk-obj.cost-sum-base =  after_t-stk-obj.cost-sum-base +   v-after-cost-sum-base
     4317           .
     4318         end.
     4319       end.
     4320       else do:
     4321         if t-month.obj-type = obj-list.obj-type AND
     4322           t-month.obj-code = obj-list.obj-code then do:
     4323         end.
     4324         else do:
     4325           assign
     4326             t-month.obj-type = obj-list.obj-type
     4327             t-month.obj-code = obj-list.obj-code
     4328           .
     4329           find first t-stk-obj
     4330             where t-stk-obj.ym = year(sale_stk-line.fact-date) * 100 +  month(sale_stk-line.fact-date)
     4331               AND t-stk-obj.b-a = 0
     4332               AND t-stk-obj.obj-type = obj-list.obj-type
     4333               AND t-stk-obj.obj-code = obj-list.obj-code
     4334             no-error.
     4335           if not available t-stk-obj then do:
     4336             create t-stk-obj.
     4337             assign
     4338             t-stk-obj.ym = year(sale_stk-line.fact-date) * 100 +  month(sale_stk-line.fact-date)
     4339             t-stk-obj.year_ = year(sale_stk-line.fact-date)
     4340             t-stk-obj.month_ = month(sale_stk-line.fact-date)
     4341             t-stk-obj.b-a = 0
     4342             t-stk-obj.b-a-full = "Начало месяца"
     4343             t-stk-obj.obj-type = obj-list.obj-type
     4344             t-stk-obj.obj-code = obj-list.obj-code
     4345             .
     4346             run fill-dinamo in this-procedure (t-stk-obj.year_, t-stk-obj.month_, obj-list.obj-type, obj-list.obj-code) .
     4347           end.
     4348           find first cost_stk-line no-lock where
     4349                     cost_stk-line.artic = buf_goods.artic
     4350                 AND cost_stk-line.prod-type = buf_goods.prod-type
     4351                 AND cost_stk-line.prod-code = buf_goods.prod-code
     4352                 AND cost_stk-line.obj-type = obj-list.obj-type
     4353                 AND cost_stk-line.obj-code = obj-list.obj-code
     4354                 AND cost_stk-line.sum-type = 'cost':U
     4355                 AND cost_stk-line.fact-order = v-before-fact-order no-error .
     4356           if avail cost_stk-line then do:
     4357             assign
     4358               v-before-cost-sum-rubl = cost_stk-line.sum-rubl
     4359               v-before-cost-sum-base = cost_stk-line.sum-base
     4360               v-after-cost-sum-rubl = cost_stk-line.sum-rubl
     4361               v-after-cost-sum-base = cost_stk-line.sum-base
     4362             .
     4363           end.
     4364           assign
     4365             t-stk-obj.fact-qnty  = t-stk-obj.fact-qnty + v-before-fact-qnty
     4366             t-stk-obj.sale-sum-rubl = t-stk-obj.sale-sum-rubl + v-before-sale-sum-rubl
     4367             t-stk-obj.sale-sum-base  = t-stk-obj.sale-sum-base + v-before-sale-sum-base
     4368             t-stk-obj.cost-sum-rubl = t-stk-obj.cost-sum-rubl + v-before-cost-sum-rubl
     4369             t-stk-obj.cost-sum-base  = t-stk-obj.cost-sum-base + v-before-cost-sum-base
     4370           .
     4371           find first after_t-stk-obj
     4372             where after_t-stk-obj.ym = v-before-ym
     4373               AND after_t-stk-obj.b-a = 1
     4374               AND after_t-stk-obj.obj-type = obj-list.obj-type
     4375               AND after_t-stk-obj.obj-code = obj-list.obj-code
     4376             no-error .
     4377           if not avail after_t-stk-obj and v-before-ym <> 0 then do:
     4378             create after_t-stk-obj.
     4379             assign
     4380               after_t-stk-obj.year_ = year(v-before-fact-date)
     4381               after_t-stk-obj.month_ = month(v-before-fact-date)
     4382               after_t-stk-obj.ym = v-before-ym
     4383               after_t-stk-obj.b-a = 1
     4384               after_t-stk-obj.b-a-full = "Конец месяца"
     4385               after_t-stk-obj.obj-type = obj-list.obj-type
     4386               after_t-stk-obj.obj-code = obj-list.obj-code
     4387             .
     4388             run fill-dinamo in this-procedure (after_t-stk-obj.year_, after_t-stk-obj.month_, obj-list.obj-type, obj-list.obj-code) .
     4389           end.
     4390           if avail after_t-stk-obj then do:
     4391             assign
     4392               after_t-stk-obj.fact-qnty  = after_t-stk-obj.fact-qnty + v-after-fact-qnty
     4393               after_t-stk-obj.sale-sum-rubl = after_t-stk-obj.sale-sum-rubl + v-after-sale-sum-rubl
     4394               after_t-stk-obj.sale-sum-base  = after_t-stk-obj.sale-sum-base + v-after-sale-sum-base
     4395               after_t-stk-obj.cost-sum-rubl = after_t-stk-obj.cost-sum-rubl + v-after-cost-sum-rubl
     4396               after_t-stk-obj.cost-sum-base  = after_t-stk-obj.cost-sum-base + v-after-cost-sum-base
     4397             .
     4398           end.
     4399         end.
     4400       end.
     4401       assign
     4402         v-before-fact-date      = sale_stk-line.fact-date
     4403         v-before-ym             = year(sale_stk-line.fact-date) * 100 + month(sale_stk-line.fact-date)
     4404         v-before-fact-order     = sale_stk-line.fact-order
     4405         v-before-fact-qnty     = sale_stk-line.fact-qnty
     4406         v-before-sale-sum-rubl = sale_stk-line.sum-rubl
     4407         v-before-sale-sum-base = sale_stk-line.sum-base
     4408         v-after-fact-qnty     =  sale_stk-line.fact-qnty
     4409         v-after-sale-sum-rubl =  sale_stk-line.sum-rubl
     4410         v-after-sale-sum-base =  sale_stk-line.sum-base
     4411       .
     4412       if last-of(sale_stk-line.obj-code) then do:
     4413         find first cost_stk-line no-lock where
     4414                   cost_stk-line.artic = buf_goods.artic
     4415               AND cost_stk-line.prod-type = buf_goods.prod-type
     4416               AND cost_stk-line.prod-code = buf_goods.prod-code
     4417               AND cost_stk-line.obj-type = obj-list.obj-type
     4418               AND cost_stk-line.obj-code = obj-list.obj-code
     4419               AND cost_stk-line.sum-type = 'cost':U
     4420               AND cost_stk-line.fact-order = v-before-fact-order no-error .
     4421         if avail cost_stk-line then do:
     4422           assign
     4423             v-after-cost-sum-rubl =  cost_stk-line.sum-rubl
     4424             v-after-cost-sum-base =  cost_stk-line.sum-base
     4425           .
     4426         end.
     4427         else do:
     4428           assign
     4429             v-after-cost-sum-rubl =  0
     4430             v-after-cost-sum-base =  0
     4431           .
     4432         end.
     4433         find first after_t-stk-obj
     4434           where after_t-stk-obj.ym = year(sale_stk-line.fact-date) * 100 + month(sale_stk-line.fact-date)
     4435             AND after_t-stk-obj.b-a = 1
     4436             AND after_t-stk-obj.obj-type = obj-list.obj-type
     4437             AND after_t-stk-obj.obj-code = obj-list.obj-code
     4438           no-error .
     4439         if not available after_t-stk-obj then do:
     4440           create after_t-stk-obj.
     4441           assign
     4442             after_t-stk-obj.ym = year(sale_stk-line.fact-date) * 100 + month(sale_stk-line.fact-date)
     4443             after_t-stk-obj.year_ = year(sale_stk-line.fact-date)
     4444             after_t-stk-obj.month_ =  month(sale_stk-line.fact-date)
     4445             after_t-stk-obj.b-a = 1
     4446             after_t-stk-obj.b-a-full = "Конец месяца"
     4447             after_t-stk-obj.obj-type = obj-list.obj-type
     4448             after_t-stk-obj.obj-code = obj-list.obj-code
     4449           .
     4450         end.
     4451         assign
     4452           after_t-stk-obj.fact-qnty = after_t-stk-obj.fact-qnty + v-after-fact-qnty
     4453           after_t-stk-obj.sale-sum-rubl = after_t-stk-obj.sale-sum-rubl + v-after-sale-sum-rubl
     4454           after_t-stk-obj.sale-sum-base  = after_t-stk-obj.sale-sum-base + v-after-sale-sum-base
     4455           after_t-stk-obj.cost-sum-rubl = after_t-stk-obj.cost-sum-rubl + v-after-cost-sum-rubl
     4456           after_t-stk-obj.cost-sum-base  = after_t-stk-obj.cost-sum-base + v-after-cost-sum-base
     4457         .
     4458         find first t-fo where
     4459                     t-fo.obj-type = obj-list.obj-type
     4460                 AND t-fo.obj-code = obj-list.obj-code no-error .
     4461         if not avail t-fo then do:
     4462           create t-fo.
     4463           assign
     4464           t-fo.obj-type = obj-list.obj-type
     4465           t-fo.obj-code = obj-list.obj-code
     4466           .
     4467         end.
     4468         assign
     4469         t-fo.fact-order = sale_stk-line.fact-order
     4470         .
     4471       end.
     4472     end.
     4473       for each t-month no-lock,
     4474         each obj-list no-lock,
     4475         first t-stk-obj where
     4476              t-stk-obj.obj-type = obj-list.obj-type
     4477          AND t-stk-obj.obj-code = obj-list.obj-code
     4478          AND (
     4479               (t-stk-obj.ym = t-month.ym
     4480           AND  t-stk-obj.b-a = 0 )
     4481          OR   t-stk-obj.ym < t-month.ym
     4482               )
     4483              by t-stk-obj.ym descending
     4484              by t-stk-obj.b-a descending
     4485              :
     4486       find first t-stk where
     4487                   t-stk.ym = t-month.ym
     4488               AND t-stk.b-a = 0 no-error .
     4489       if not avail t-stk then do:
     4490         create t-stk.
     4491         assign
     4492         t-stk.ym = t-month.ym
     4493         t-stk.year_ = t-month.year_
     4494         t-stk.month_ = t-month.month_
     4495         t-stk.b-a = 0
     4496         t-stk.b-a-full = "Начало месяца"
     4497         .
     4498       end.
     4499       assign
     4500       t-stk.fact-qnty     = t-stk.fact-qnty     + t-stk-obj.fact-qnty
     4501       t-stk.sale-sum-rubl = t-stk.sale-sum-rubl + t-stk-obj.sale-sum-rubl
     4502       t-stk.sale-sum-base = t-stk.sale-sum-base + t-stk-obj.sale-sum-base
     4503       t-stk.cost-sum-rubl = t-stk.cost-sum-rubl + t-stk-obj.cost-sum-rubl
     4504       t-stk.cost-sum-base = t-stk.cost-sum-base + t-stk-obj.cost-sum-base
     4505       .
     4506     end.
     4507     for each t-month no-lock,
     4508         each obj-list no-lock,
     4509         first t-stk-obj where
     4510              t-stk-obj.obj-type = obj-list.obj-type
     4511          AND t-stk-obj.obj-code = obj-list.obj-code
     4512          AND
     4513              (
     4514              (t-stk-obj.ym = t-month.ym
     4515          AND t-stk-obj.b-a = 1)
     4516           OR t-stk-obj.ym < t-month.ym
     4517              )
     4518          by t-stk-obj.ym descending
     4519          by t-stk-obj.b-a descending
     4520              :
     4521       find first t-stk where
     4522                   t-stk.ym = t-month.ym
     4523               AND t-stk.b-a = 1 no-error .
     4524       if not avail t-stk then do:
     4525         create t-stk.
     4526         assign
     4527         t-stk.ym = t-month.ym
     4528         t-stk.year_ = t-month.year_
     4529         t-stk.month_ = t-month.month_
     4530         t-stk.b-a = 1
     4531         t-stk.b-a-full = "Конец месяца"
     4532         .
     4533       end.
     4534       assign
     4535       t-stk.fact-qnty     = t-stk.fact-qnty     + t-stk-obj.fact-qnty
     4536       t-stk.sale-sum-rubl = t-stk.sale-sum-rubl + t-stk-obj.sale-sum-rubl
     4537       t-stk.sale-sum-base = t-stk.sale-sum-base + t-stk-obj.sale-sum-base
     4538       t-stk.cost-sum-rubl = t-stk.cost-sum-rubl + t-stk-obj.cost-sum-rubl
     4539       t-stk.cost-sum-base = t-stk.cost-sum-base + t-stk-obj.cost-sum-base
     4540       .
     4541     end.
     4542   end.
     4543   else do:
     4544     for each obj-list no-lock,
     4545         each sale_stk-line no-lock where
     4546             sale_stk-line.obj-type = obj-list.obj-type AND
     4547             sale_stk-line.obj-code = obj-list.obj-code AND
     4548             sale_stk-line.artic = buf_goods.artic AND
     4549             sale_stk-line.prod-type = buf_goods.prod-type AND
     4550             sale_stk-line.prod-code = buf_goods.prod-code AND
     4551             sale_stk-line.cat-id = '##,##':U AND
     4552             sale_stk-line.sum-type begins  'cgdt':U
     4553     break
     4554     by sale_stk-line.obj-type
     4555     by sale_stk-line.obj-code
     4556     by sale_stk-line.fact-order:
     4557       find first t-month where
     4558                 t-month.ym = year(sale_stk-line.fact-date) * 100 +  month(sale_stk-line.fact-date)
     4559                 no-error .
     4560       if not avail t-month then do:
     4561         create t-month.
     4562         assign
     4563         t-month.month_ = month(sale_stk-line.fact-date)
     4564         t-month.year_ = year(sale_stk-line.fact-date)
     4565         t-month.ym = t-month.year_ * 100 + t-month.month_
     4566         t-month.obj-type = obj-list.obj-type
     4567         t-month.obj-code = obj-list.obj-code
     4568         .
     4569       end.
     4570       if last-of (sale_stk-line.obj-code) then do:
     4571         find first t-fo where
     4572                     t-fo.obj-type = obj-list.obj-type
     4573                 AND t-fo.obj-code = obj-list.obj-code no-error .
     4574         if not avail t-fo then do:
     4575           create t-fo.
     4576           assign
     4577           t-fo.obj-type = obj-list.obj-type
     4578           t-fo.obj-code = obj-list.obj-code
     4579           .
     4580         end.
     4581         assign
     4582         t-fo.fact-order = sale_stk-line.fact-order
     4583         .
     4584       end.
     4585       run fill-dinamo in this-procedure (t-month.year_, t-month.month_, obj-list.obj-type, obj-list.obj-code) .
     4586     end.
     4587   end.
     4588   run waitfram-hide in this-procedure .
     4589   END PROCEDURE.
     4590   PROCEDURE Myenable :
     4591   DISPLAY T-cost RS-curr
     4592   buf_goods.unit-base @ f-unit-base
     4593   f-date-start
     4594         WITH FRAME Dialog-Frame.
     4595     ENABLE b-quit B-Help BR-dinamo RS-curr BR-month BR-stk B-uchet B-objects
     4596     T-cost when v-enable-cost
     4597            B-print
     4598         WITH FRAME Dialog-Frame.
     4599     VIEW FRAME Dialog-Frame.
     4600    define variable v-last-ym as integer no-undo. if not can-find(first t-month no-lock where                         t-month.ym > v-cut-ym) and          can-find(first t-month no-lock where                         t-month.ym <= v-cut-ym) then do:     find last t-month no-lock where                 t-month.ym < v-cut-ym .     assign     v-last-ym = t-month.ym     .     OPEN QUERY BR-month FOR EACH t-month no-lock where t-month .ym = v-last-ym.  end.  else do: OPEN QUERY BR-month FOR EACH t-month no-lock where t-month.ym >= v-cut-ym. end.
     4601    if avail t-month then do:
     4602       OPEN QUERY BR-dinamo FOR EACH t-dinamo no-lock where t-dinamo.ym = t-month.ym.
     4603         OPEN QUERY BR-stk FOR EACH t-stk no-lock where t-stk.ym = t-month.ym.
     4604     end.
     4605   END PROCEDURE.
     4606   PROCEDURE proc-b-print :
     4607   define input parameter p-year as integer no-undo.
     4608   define input parameter p-month as integer no-undo.
     4609   DEFINE VARIABLE v-fact-qnty-s as character no-undo .
     4610   DEFINE VARIABLE v-sale-sum-s as character no-undo .
     4611   DEFINE VARIABLE v-cost-sum-s as character no-undo .
     4612   DEFINE VARIABLE Line as character no-undo .
     4613   DEFINE VARIABLE date_string as character no-undo .
     4614   DEFINE VARIABLE v-ym as integer no-undo .
     4615   define buffer buf_t-dinamo for t-dinamo.
     4616   define buffer buf_t-stk for t-stk.
     4617   define frame Fdinamo
     4618   buf_t-dinamo.doc-type-full FORMAT "X(18)" column-label "":U
     4619   v-fact-qnty-s column-label "Кол-во" format "X(15)"
     4620   v-sale-sum-s COLUMn-LABEL "Сумма продаж. цен" format "X(22)"
     4621   v-cost-sum-s COLUMn-LABEL "Сумма учетных цен" format "X(22)"
     4622   HEADER  date_string AT 5 format "X(35)"
     4623   string( "Страница " ) format "X(9)" AT 50 PAGE-NUMBER(PrnLibStream) AT 60 FORMAT ">>9" SKIP
     4624   Line format "X(80)" AT 1
     4625   with width 232 down stream-io use-text    .
     4626   Line = fill("-", 80).
     4627   date_string = cur-time-print() .
     4628   run prn-lib-open-stream  in this-procedure (
     4629                                                input parParentProc
     4630                                               ,input 62
     4631                                               ,input yes
     4632                                               ,input no
     4633                                               ).
     4634   PUT  STREAM PrnLibStream unformatted
     4635   frame Dialog-Frame:title format "x(90)" chr(10)
     4636   (fill(chr(32), 20) +
     4637    "(":U +  (if RS-curr = "rubl":U then "Рубли" else "Баз.вал.") + ")":U) skip
     4638    str4
     4639    SKIP(1) .
     4640   FORM HEADER
     4641   Line format "X(80)" AT 1 SKIP
     4642   "Продолжение - на следующей странице" AT 30 SKIP
     4643   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     4644   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     4645   FORM with FRAME FDinamo  .
     4646   run waitfram-show in this-procedure("Ждите...").
     4647   assign
     4648   v-ym = p-year * 100 + p-month
     4649   .
     4650   for each buf_t-dinamo no-lock where
     4651            buf_t-dinamo.ym = v-ym
     4652   break
     4653   by buf_t-dinamo.idoc-type
     4654   by buf_t-dinamo.ext-doc-type:
     4655     display stream PrnLibStream
     4656     buf_t-dinamo.doc-type-full
     4657     (if buf_t-dinamo.ext-doc-type <> "":U and not buf_t-dinamo.is-zuka
     4658     then string(buf_t-dinamo.fact-qnty, "->>,>>>,>>9.999")
     4659     else "":U)      @  v-fact-qnty-s
     4660     (if buf_t-dinamo.ext-doc-type <> "":U
     4661     then string((if RS-curr = "rubl":U then buf_t-dinamo.sale-sum-rubl else buf_t-dinamo.sale-sum-base),
     4662                 (if buf_t-dinamo.is-zuka
     4663                 then "->>,>>9.99%"
     4664                 else "->>,>>>,>>>,>>>,>>9.99")
     4665                 )
     4666     else "":U) @ v-sale-sum-s
     4667     (if v-cost-view then
     4668     (if buf_t-dinamo.ext-doc-type <> "":U
     4669     then string((if RS-curr = "rubl":U then buf_t-dinamo.cost-sum-rubl else buf_t-dinamo.cost-sum-base), "->>,>>>,>>>,>>>,>>9.99")
     4670     else "":U)
     4671     else "":U)
     4672     @  v-cost-sum-s
     4673     WITH FRAME Fdinamo.
     4674     if last-of(buf_t-dinamo.idoc-type) then do:
     4675       DOWN STREAM PrnLibStream 2 with FRAME FDinamo .
     4676     end.
     4677     else do:
     4678       DOWN STREAM PrnLibStream 1 with FRAME FDinamo .
     4679     end.
     4680   END.
     4681   UNDERLINE stream PrnLibStream
     4682   buf_t-dinamo.doc-type-full
     4683   v-fact-qnty-s
     4684   v-sale-sum-s
     4685   v-cost-sum-s
     4686   WITH FRAME Fdinamo.
     4687   DOWN STREAM PrnLibStream 1 with FRAME FDinamo .
     4688   DISPLAY stream PrnLibStream
     4689   "Остатки"  @ buf_t-dinamo.doc-type-full
     4690   WITH FRAME Fdinamo.
     4691   DOWN STREAM PrnLibStream 1 with FRAME FDinamo .
     4692   for each buf_t-stk no-lock where
     4693            buf_t-stk.ym = v-ym:
     4694     DISPLAY stream PrnLibStream
     4695     buf_t-stk.b-a-full
     4696       @ buf_t-dinamo.doc-type-full
     4697     string(buf_t-stk.fact-qnty, "->>,>>>,>>9.999")
     4698       @  v-fact-qnty-s
     4699     string((if RS-curr = "rubl":U then buf_t-stk.sale-sum-rubl else buf_t-stk.sale-sum-base), "->>,>>>,>>>,>>>,>>9.99")
     4700       @ v-sale-sum-s
     4701    (if v-cost-view then
     4702     string((if RS-curr = "rubl":U then buf_t-stk.cost-sum-rubl else buf_t-stk.cost-sum-base), "->>,>>>,>>>,>>>,>>9.99")
     4703     else "":U)
     4704       @  v-cost-sum-s
     4705     WITH FRAME Fdinamo.
     4706     DOWN STREAM PrnLibStream 1 with FRAME FDinamo .
     4707   end.
     4708   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     4709   HIDE  STREAM PrnLibStream FRAME Fdinamo.
     4710   output STREAM PrnLibStream CLOSE.
     4711   run waitfram-hide in this-procedure.
     4712   run prn-lib-prn-file in this-procedure (
     4713                                             input parParentProc
     4714                                             ,input 0
     4715                                             ).
     4716   END PROCEDURE.
     4717   PROCEDURE proc-c-dinamo :
     4718   DEFINE VARIABLE v-curr as character no-undo .
     4719   define variable v-doc-rec as recid no-undo .
     4720   define variable next-prev as logical no-undo .
     4721   if t-dinamo.ext-doc-type = "":U then return error.
     4722   if num-entries(t-dinamo.doc-type-full) > 1 then return error.
     4723   br-handle = br-month:handle in frame Dialog-Frame.
     4724   v-curr = RS-curr.
     4725   assign
     4726   v-doc-rec = ?
     4727   next-prev = yes
     4728   .
     4729          run rep/c-dinamo.w
     4730                         (
     4731                          input parparentproc
     4732                         ,input t-dinamo.ext-doc-type
     4733                         ,input t-dinamo.sign_
     4734                         ,input p-gds-code
     4735                         ,input v-cost-view
     4736                         ,input-output v-curr
     4737                         ,input-output v-doc-rec
     4738                         ,input-output br-handle
     4739                         ,input-output next-prev
     4740                                       ) no-error.
     4741       if error-status:error then return error.
     4742       rs-curr = v-curr.
     4743       display RS-curr
     4744       with frame Dialog-Frame .
     4745       apply "VALUE-CHANGED" to Rs-curr.
     4746   END PROCEDURE.
     4747   PROCEDURE proc-uchet-card :
     4748   DEFINE VARIABLE v-curr as character no-undo .
     4749   define variable v-doc-rec as recid no-undo .
     4750   define variable next-prev as logical no-undo .
     4751       assign
     4752       next-prev = yes.
     4753       br-handle = br-month:handle in frame Dialog-Frame.
     4754       v-curr = RS-curr.
     4755       DO WHILE next-prev <> ?:
     4756           if NOT available t-month then do:
     4757                   message "Неправильно выбран месяц." view-as alert-box ERROR.
     4758                   return error.
     4759           end.
     4760           v-doc-rec = recid (t-month).
     4761           .
     4762          run rep/c-dinamo.w
     4763                         (
     4764                          input parparentproc
     4765                         ,input 'все':U
     4766                         ,input 0
     4767                         ,input p-gds-code
     4768                         ,input v-cost-view
     4769                         ,input-output v-curr
     4770                         ,input-output v-doc-rec
     4771                         ,input-output br-handle
     4772                         ,input-output next-prev
     4773                                       ) no-error
     4774           .
     4775       END .
     4776       if br-handle = ? then
     4777       reposition br-month to recid v-doc-rec no-error.
     4778       rs-curr = v-curr.
     4779       display RS-curr
     4780       with frame Dialog-Frame .
     4781       apply "VALUE-CHANGED" to Rs-curr.
     4782       apply "entry" to br-month in frame Dialog-Frame.
     4783       apply "value-changed" to br-month in frame Dialog-Frame.
     4784   END PROCEDURE.
     4785   PROCEDURE proc-value-change :
     4786   define variable v-month-name as character no-undo.
     4787   if available t-month then do:
     4788       assign
     4789       v-month-name = string(t-month.month_).
     4790       run gbl/monthnam.p (input t-month.month_, output v-month-name) no-error.
     4791   end.
     4792   assign
     4793   frame Dialog-Frame:title = ("код товара:" + chr(32) +              string(buf_goods.gds-code) + chr(32) + "артикул:" + chr(32) +              buf_goods.artic + chr(32) +              buf_goods.prod-type + string(buf_goods.prod-code) + chr(32) +              string(buf_goods.gds-name, "X(20)") + chr(32) +              (if avail t-month then              ("Динамика за":U + chr(32) + v-month-name +              chr(32) + string(t-month.year_))              else "":U)).
     4794   if available t-month and t-month.ym >= v-cut-ym then do:
     4795       OPEN QUERY br-dinamo FOR EACH t-dinamo no-lock where t-dinamo.ym = t-month.ym.
     4796       OPEN QUERY br-stk FOR EACH t-stk no-lock where t-stk.ym = t-month.ym .
     4797   end.
     4798   else do:
     4799     if not can-find(first t-month no-lock where
     4800                           t-month.ym > v-cut-ym) and
     4801            can-find(first t-month no-lock where
     4802                           t-month.ym <= v-cut-ym) then do:
     4803       OPEN QUERY br-dinamo FOR EACH t-dinamo no-lock where false.
     4804       OPEN QUERY br-stk FOR EACH t-stk no-lock where
     4805                                  t-stk.ym = t-month.ym
     4806                              AND t-stk.b-a = 1 .
     4807     end.
     4808     else do:
     4809       OPEN QUERY br-dinamo FOR EACH t-dinamo no-lock where false.
     4810       OPEN QUERY br-stk FOR EACH t-stk no-lock where false .
     4811     end.
     4812   end.
     4813   REPOSITION br-dinamo to row v-row no-error.
     4814   br-dinamo :SET-REPOSITIONED-ROW(5, "CONDITIONAL").
     4815   END PROCEDURE.
     4816   PROCEDURE set-row-color :
     4817   DEF VAR iFGColor AS INTEGER NO-UNDO.
     4818     DEF VAR iBGColor AS INTEGER NO-UNDO.
     4819     IF t-dinamo.ext-doc-type = "":U THEN DO:
     4820         ASSIGN
     4821           iFGColor = WHITE_COLOR
     4822           iBGColor = DARK_GREEN_COLOR
     4823         .
     4824       end.
     4825       ELSE do:
     4826         ASSIGN
     4827           iFGColor = Black_COLOR
     4828           iBGColor = White_COLOR
     4829         .
     4830       end.
     4831       ASSIGN
     4832         t-dinamo.doc-type-full:FGCOLOR IN BROWSE BR-dinamo = iFGColor
     4833         t-dinamo.doc-type-full:BGCOLOR IN BROWSE BR-dinamo = iBGColor
     4834       .
     4835   END PROCEDURE.
