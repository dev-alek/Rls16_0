      627   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      628   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      629   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
