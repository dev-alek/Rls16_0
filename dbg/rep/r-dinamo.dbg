     2488       assign
     2489       v-row = br-dinamo:focused-row in frame Dialog-Frame.
     2490   end.
     2491   END.
     2492   ON LEFT-MOUSE-DBLCLICK OF BR-month IN FRAME Dialog-Frame
     2493   DO:
     2494      if not avail t-month then return no-apply.
     2495     run proc-uchet-card in this-procedure no-error.
     2496     if error-status:error then return no-apply.
     2497   END.
     2498   ON RETURN OF BR-month IN FRAME Dialog-Frame
     2499   DO:
     2500      if not avail t-month then return no-apply.
     2501     run proc-uchet-card in this-procedure no-error.
     2502     if error-status:error then return no-apply.
     2503   END.
     2504   ON VALUE-CHANGED OF BR-month IN FRAME Dialog-Frame
     2505   DO:
     2506     run proc-value-change in this-procedure no-error.
     2507   END.
     2508   ON VALUE-CHANGED OF RS-curr IN FRAME Dialog-Frame
     2509   DO:
     2510     assign
     2511     Rs-curr.
     2512     run proc-value-change in this-procedure no-error.
     2513   END.
     2514   ON VALUE-CHANGED OF T-cost IN FRAME Dialog-Frame
     2515   DO:
     2516     assign
     2517     T-cost.
     2518     assign
     2519     v-cost-view = T-cost AND v-enable-cost
     2520     .
     2521     run proc-value-change in this-procedure no-error.
     2522   END.
     2523   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2524   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2525   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2526   on help of frame Dialog-Frame
     2527   do:
     2528     run gbl/app_help.p
     2529       (input this-procedure :file-name
     2530       ,input ''
     2531       ,input ?
     2532       ) no-error.
     2533     if error-status :error then do:
     2534       message
     2535         "Ошибка при вызове помощи"
     2536         error-status :get-message(1)
     2537         view-as alert-box .
     2538     end.
     2539   end.
     2540   run minbtn-set in this-procedure .
     2541   on choose of b-help in frame Dialog-Frame
     2542   do:
     2543     apply "help":u to frame Dialog-Frame .
     2544   end.
     2545   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2546   procedure minbtn-set :
     2547       do
     2548           on error undo, return error return-value
     2549           :
     2550           define variable ii              as integer       no-undo .
     2551           define variable fh              as widget-handle no-undo .
     2552           define variable hh              as widget-handle no-undo .
     2553           define variable v-h             as handle        extent 4 no-undo .
     2554           define variable v-name-button   as character     no-undo .
     2555           define variable v-help-old-x    as decimal       no-undo .
     2556           define variable v-help-old-y    as decimal       no-undo .
     2557           define variable v-help-old-size as decimal       no-undo .
     2558           define variable v-frame-width   as decimal       no-undo .
     2559           define variable jj              as integer       no-undo .
     2560           do
     2561               on error undo, return error
     2562               :
     2563               assign
     2564                   v-frame-width = frame Dialog-Frame:width - 0.3
     2565                   fh            = frame Dialog-Frame:first-child
     2566                   hh            = fh:first-child
     2567                   ii            = 1
     2568                   .
     2569               do while valid-handle(hh):
     2570                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2571                   do:
     2572                       case lc(hh:name) :
     2573                           when "b-help" then
     2574                               do:
     2575                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2576                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2577                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2578                                   hh:TOOLTIP = "Помощь" .
     2579                                   v-help-old-x = hh:column .
     2580                                   v-help-old-y = hh:row    .
     2581                                   v-help-old-size = hh:width .
     2582                                   hh:width-chars = 2.5 .
     2583                               end.
     2584                           when "b-print" then
     2585                               do:
     2586                                   hh:load-image("cmp/b-print.bmp":u) .
     2587                                   hh:TOOLTIP = "Печать" .
     2588                                   v-h[ii] = hh:handle .
     2589                                   ii = ii + 1 .
     2590                                   hh:width-chars = 3 .
     2591                               end.
     2592                           when "b-history" or
     2593                           when "b-hist" then
     2594                               do:
     2595                                   hh:load-image("cmp/b-hist.bmp":u) .
     2596                                   hh:TOOLTIP = "История" .
     2597                                   v-h[ii] = hh:handle .
     2598                                   ii = ii + 1 .
     2599                                   hh:width-chars = 3 .
     2600                               end.
     2601                           when "b-sch" then
     2602                               do:
     2603                                   hh:load-image("cmp/b-sch.bmp":u) .
     2604                                   hh:TOOLTIP = "Установка Фильтра" .
     2605                                   v-h[ii] = hh:handle .
     2606                                   ii = ii + 1 .
     2607                                   hh:width-chars = 3 .
     2608                               end.
     2609                           when "b-hist-user" then
     2610                               do:
     2611                                   hh:load-image("cmp/b-hist.bmp":u) .
     2612                                   hh:TOOLTIP = "История пользователя" .
     2613                                   ii = ii + 1 .
     2614                               end.
     2615                       end case.
     2616                   end.
     2617                   hh = hh:next-sibling.
     2618               end.
     2619               b-help:column = v-frame-width - b-help:width-chars.
     2620               jj = 0.
     2621               repeat ii = 4 to 1 by -1 :
     2622                   if valid-handle (v-h[ii] ) then
     2623                   do:
     2624                       jj  = jj + 1 .
     2625                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2626                       v-h[ii]:row    = v-help-old-y .
     2627                   end.
     2628               end.
     2629           end.
     2630       end.
     2631   end procedure.
     2632   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2633   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2634   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2635   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2636   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2637   define variable v-diasize-current-frame-height as decimal   no-undo .
     2638   define variable v-diasize-change-size          as logical   no-undo .
     2639   define variable v-diasize-resize-button        as handle    no-undo .
     2640   define variable v-diasize-wndmax               as logical   no-undo .
     2641   define variable v-diasize-wndstore             as logical   no-undo .
     2642   define variable v-diasize-proc-name            as character no-undo .
     2643   define variable v-diasize-browse-handle        as handle    no-undo .
     2644   define variable v-diasize-browse-number        as integer   no-undo .
     2645   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2646   define temp-table temp-diasize-handle no-undo
     2647     field handle-value  as handle
     2648     field save-position as decimal
     2649     index xpk is primary unique handle-value
     2650     .
     2651   define temp-table temp-browse-handle no-undo
     2652     field browse-type   as character
     2653     field browse-number as integer
     2654     field browse-handle as handle
     2655     field original-size as decimal
     2656     index xpk is primary unique browse-type browse-number
     2657     index xie browse-type browse-handle
     2658   .
     2659   procedure diasize_change-height :
     2660     define input  parameter p-change-value  as decimal   no-undo .
     2661     define input  parameter p-move-resize   as logical   no-undo .
     2662     define variable v-field-group-handle    as handle    no-undo .
     2663     define variable v-object-handle         as handle    no-undo .
     2664     define variable v-frame-height          as decimal   no-undo .
     2665     define variable v-frame-virtual-height  as decimal   no-undo .
     2666     define variable v-browse-height         as decimal   no-undo .
     2667     define variable v-window-height         as decimal   no-undo .
     2668     define variable v-window-virtual-height as decimal   no-undo .
     2669     define variable v-change-sign           as integer   no-undo .
     2670     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2671     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2672     if p-change-value > 0
     2673     then do:
     2674       if frame Dialog-Frame :height + p-change-value
     2675           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2676       then do:
     2677         assign
     2678           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2679                           - (frame Dialog-Frame :height-chars)
     2680         .
     2681         if p-change-value <= 0
     2682         then do:
     2683           run diasize_position-resize-button in this-procedure .
     2684           return .
     2685         end.
     2686       end.
     2687     end.
     2688     if p-change-value < 0
     2689     then do:
     2690       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2691       then do:
     2692         assign
     2693           p-change-value = v-diasize-orig-frame-height
     2694                          - (frame Dialog-Frame :height-chars)
     2695         .
     2696         if p-change-value >= 0
     2697         then do:
     2698           run diasize_position-resize-button in this-procedure .
     2699           return .
     2700         end.
     2701       end.
     2702     end.
     2703     if p-change-value >= 0
     2704     then do:
     2705       assign
     2706         v-change-sign = 1
     2707       .
     2708     end.
     2709     else do:
     2710       assign
     2711         v-change-sign = -1
     2712       .
     2713     end.
     2714     assign
     2715       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2716     .
     2717     if p-change-value = 0
     2718     then do:
     2719       run diasize_position-resize-button in this-procedure .
     2720       return .
     2721     end.
     2722     move_block:
     2723     do
     2724     on error undo move_block, retry move_block
     2725     :
     2726       if retry
     2727       then do:
     2728         do
     2729         on error undo move_block, leave move_block
     2730         :
     2731           if p-change-value > 0
     2732           then do:
     2733             for each buf_temp-diasize-handle
     2734             on error undo, next
     2735             :
     2736               assign
     2737                 v-object-handle = buf_temp-diasize-handle.handle-value
     2738               .
     2739               if v-object-handle <> v-diasize-resize-button
     2740               then do:
     2741                 assign
     2742                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2743                 .
     2744               end.
     2745             end.
     2746             assign
     2747               v-diasize-browse-handle :height = v-browse-height
     2748             .
     2749             for each buf_temp-browse-handle
     2750               where buf_temp-browse-handle.browse-type = 'height':u
     2751             on error undo, next
     2752             :
     2753               assign
     2754                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2755               .
     2756             end.
     2757             assign
     2758               frame Dialog-Frame :height = v-frame-height
     2759             .
     2760             if frame Dialog-Frame :scrollable = true
     2761             then do:
     2762               assign
     2763                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2764               .
     2765             end.
     2766             run diasize_position-resize-button in this-procedure .
     2767           end.
     2768           else do:
     2769             if frame Dialog-Frame :scrollable = true
     2770             then do:
     2771               assign
     2772                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2773               .
     2774             end.
     2775             assign
     2776               frame Dialog-Frame :height = v-frame-height
     2777             .
     2778             assign
     2779               v-diasize-browse-handle :height = v-browse-height
     2780             .
     2781             for each buf_temp-browse-handle
     2782               where buf_temp-browse-handle.browse-type = 'height':u
     2783             on error undo, next
     2784             :
     2785               assign
     2786                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2787               .
     2788             end.
     2789             for each buf_temp-diasize-handle
     2790             on error undo, next
     2791             :
     2792               assign
     2793                 v-object-handle = buf_temp-diasize-handle.handle-value
     2794               .
     2795               if v-object-handle <> v-diasize-resize-button
     2796               then do:
     2797                 assign
     2798                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2799                 .
     2800               end.
     2801             end.
     2802             run diasize_position-resize-button in this-procedure .
     2803           end.
     2804           assign
     2805             v-diasize-change-size = false
     2806           .
     2807           leave move_block .
     2808         end.
     2809       end.
     2810       assign
     2811         v-diasize-need-full-display = true
     2812       .
     2813       if v-diasize-change-size = false
     2814       then do:
     2815         assign
     2816           v-diasize-change-size = true
     2817         .
     2818       end.
     2819       else do:
     2820         return .
     2821       end.
     2822       assign
     2823         v-frame-height = frame Dialog-Frame :height
     2824         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2825         v-browse-height = v-diasize-browse-handle :height
     2826       .
     2827       for each buf_temp-browse-handle
     2828         where buf_temp-browse-handle.browse-type = 'height':u
     2829       :
     2830         assign
     2831           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2832         .
     2833       end.
     2834       for each buf_temp-diasize-handle
     2835       :
     2836         delete buf_temp-diasize-handle .
     2837       end.
     2838       assign
     2839         v-field-group-handle = frame Dialog-Frame :first-child
     2840       .
     2841       do while valid-handle(v-field-group-handle)
     2842       :
     2843         assign
     2844           v-object-handle = v-field-group-handle :first-child
     2845         .
     2846         do while valid-handle(v-object-handle)
     2847         :
     2848           if  v-object-handle <> v-diasize-browse-handle :handle
     2849           and can-query(v-object-handle, "row")
     2850           and can-query(v-object-handle, "height")
     2851           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2852           then do:
     2853             find first buf_temp-browse-handle
     2854               where buf_temp-browse-handle.browse-type   = 'height':u
     2855                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2856               no-error .
     2857             if available buf_temp-browse-handle
     2858             then do:
     2859             end.
     2860             else do:
     2861               create buf_temp-diasize-handle .
     2862               assign
     2863                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2864                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2865               .
     2866             end.
     2867           end.
     2868           assign
     2869             v-object-handle = v-object-handle :next-sibling
     2870           .
     2871         end.
     2872         assign
     2873           v-field-group-handle = v-field-group-handle :next-sibling
     2874         .
     2875       end.
     2876       do with frame Dialog-Frame
     2877       :
     2878         hide v-diasize-resize-button .
     2879         assign
     2880           v-diasize-resize-button :row    = 1
     2881           v-diasize-resize-button :column = 1
     2882         .
     2883       end.
     2884       if p-change-value > 0
     2885       then do:
     2886         if frame Dialog-Frame :scrollable = true
     2887         then do:
     2888           assign
     2889             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2890             no-error .
     2891           if error-status :error
     2892           or error-status :get-message(1) <> ""
     2893           then do:
     2894             undo move_block, retry move_block .
     2895           end.
     2896         end.
     2897         assign
     2898           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2899           no-error .
     2900         if error-status :error
     2901         or error-status :get-message(1) <> ""
     2902         then do:
     2903           undo move_block, retry move_block .
     2904         end.
     2905         assign
     2906           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2907           no-error .
     2908         if error-status :error
     2909         or error-status :get-message(1) <> ""
     2910         then do:
     2911           undo move_block, retry move_block .
     2912         end.
     2913         for each buf_temp-browse-handle
     2914           where buf_temp-browse-handle.browse-type = 'height':u
     2915         on error undo move_block, retry move_block
     2916         :
     2917           assign
     2918             buf_temp-browse-handle.browse-handle :height
     2919               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2920             no-error .
     2921           if error-status :error
     2922           or error-status :get-message(1) <> ""
     2923           then do:
     2924             undo move_block, retry move_block .
     2925           end.
     2926         end.
     2927         for each buf_temp-diasize-handle
     2928         on error undo move_block, retry move_block
     2929         :
     2930           assign
     2931             v-object-handle = buf_temp-diasize-handle.handle-value
     2932           .
     2933           if v-object-handle <> v-diasize-resize-button
     2934           then do:
     2935             assign
     2936               v-object-handle :row = v-object-handle :row + p-change-value
     2937               no-error .
     2938             if error-status :error
     2939             or error-status :get-message(1) <> ""
     2940             then do:
     2941               undo move_block, retry move_block .
     2942             end.
     2943           end.
     2944         end.
     2945       end.
     2946       else do:
     2947         for each buf_temp-diasize-handle
     2948         on error undo move_block, retry move_block
     2949         :
     2950           assign
     2951             v-object-handle = buf_temp-diasize-handle.handle-value
     2952           .
     2953           if v-object-handle <> v-diasize-resize-button
     2954           then do:
     2955             assign
     2956               v-object-handle :row = v-object-handle :row + p-change-value
     2957               no-error .
     2958             if error-status :error
     2959             or error-status :get-message(1) <> ""
     2960             then do:
     2961               undo move_block, retry move_block .
     2962             end.
     2963           end.
     2964         end.
     2965         assign
     2966           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2967           no-error .
     2968         if error-status :error
     2969         or error-status :get-message(1) <> ""
     2970         then do:
     2971           undo move_block, retry move_block .
     2972         end.
     2973         for each buf_temp-browse-handle
     2974           where buf_temp-browse-handle.browse-type = 'height':u
     2975         on error undo move_block, retry move_block
     2976         :
     2977           assign
     2978             buf_temp-browse-handle.browse-handle :height
     2979               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2980             no-error .
     2981           if error-status :error
     2982           or error-status :get-message(1) <> ""
     2983           then do:
     2984             undo move_block, retry move_block .
     2985           end.
     2986         end.
     2987         assign
     2988           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2989           no-error .
     2990         if error-status :error
     2991         or error-status :get-message(1) <> ""
     2992         then do:
     2993           undo move_block, retry move_block .
     2994         end.
     2995         if frame Dialog-Frame :scrollable = true
     2996         then do:
     2997           assign
     2998             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2999             no-error .
     3000           if error-status :error
     3001           or error-status :get-message(1) <> ""
     3002           then do:
     3003             undo move_block, retry move_block .
     3004           end.
     3005         end.
     3006       end.
     3007       if p-move-resize = true
     3008       then do:
     3009         run diasize_position-resize-button in this-procedure .
     3010       end.
     3011       if v-diasize-wndstore = true
     3012       then do:
     3013         if connected("ub") = true
     3014         then do:
     3015           define variable v-cntxt-db-num        as integer   no-undo .
     3016           define variable v-cntxt-userid        as character no-undo .
     3017           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3018                                             , OUTPUT v-cntxt-userid
     3019                                             ) .
     3020           run gbl/wndsizew.p
     3021             (input  v-cntxt-db-num
     3022             ,input  v-cntxt-userid
     3023             ,input  v-diasize-proc-name
     3024             ,input  'height':u
     3025             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     3026             ) .
     3027         end.
     3028       end.
     3029     end.
     3030     assign
     3031       v-diasize-change-size = false
     3032     .
     3033   end procedure.
     3034   procedure diasize_set-height :
     3035     define input  parameter p-new-height  as decimal   no-undo .
     3036     define input  parameter p-move-resize as logical   no-undo .
     3037     do
     3038     on error undo, return error return-value
     3039     :
     3040       run diasize_change-height in this-procedure
     3041         (input  (p-new-height - frame Dialog-Frame :height)
     3042         ,input  p-move-resize
     3043         ) .
     3044     end.
     3045   end procedure.
     3046   procedure diasize_change-width :
     3047     define input  parameter p-change-value as decimal   no-undo .
     3048     define input  parameter p-move-resize  as logical   no-undo .
     3049     define variable v-field-group-handle   as handle    no-undo .
     3050     define variable v-object-handle        as handle    no-undo .
     3051     define variable v-frame-width          as decimal   no-undo .
     3052     define variable v-frame-virtual-width  as decimal   no-undo .
     3053     define variable v-browse-width         as decimal   no-undo .
     3054     define variable v-window-width         as decimal   no-undo .
     3055     define variable v-window-virtual-width as decimal   no-undo .
     3056     define variable v-change-sign          as integer   no-undo .
     3057     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3058     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3059     if p-change-value > 0
     3060     then do:
     3061       if frame Dialog-Frame :width + p-change-value >
     3062           session :width-chars
     3063       then do:
     3064         assign
     3065           p-change-value = session :width-chars - frame Dialog-Frame :width
     3066         .
     3067         if p-change-value <= 0
     3068         then do:
     3069           run diasize_position-resize-button in this-procedure .
     3070           return .
     3071         end.
     3072       end.
     3073     end.
     3074     if p-change-value < 0
     3075     then do:
     3076       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     3077       then do:
     3078         assign
     3079           p-change-value = v-diasize-orig-frame-width
     3080                          - frame Dialog-Frame :width
     3081         .
     3082         if p-change-value >= 0
     3083         then do:
     3084           run diasize_position-resize-button in this-procedure .
     3085           return .
     3086         end.
     3087       end.
     3088     end.
     3089     if p-change-value >= 0
     3090     then do:
     3091       assign
     3092         v-change-sign = 1
     3093       .
     3094     end.
     3095     else do:
     3096       assign
     3097         v-change-sign = -1
     3098       .
     3099     end.
     3100     assign
     3101       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3102     .
     3103     if p-change-value = 0
     3104     then do:
     3105       run diasize_position-resize-button in this-procedure .
     3106       return .
     3107     end.
     3108     move_block:
     3109     do
     3110     on error undo move_block, leave move_block
     3111     :
     3112       if retry
     3113       then do:
     3114         do
     3115         on error undo move_block, leave move_block
     3116         :
     3117           if p-change-value > 0
     3118           then do:
     3119             for each buf_temp-diasize-handle
     3120             on error undo, next
     3121             :
     3122               assign
     3123                 v-object-handle = buf_temp-diasize-handle.handle-value
     3124               .
     3125               if v-object-handle <> v-diasize-resize-button
     3126               then do:
     3127                 assign
     3128                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3129                 .
     3130               end.
     3131             end.
     3132             assign
     3133               v-diasize-browse-handle :width = v-browse-width
     3134             .
     3135             for each buf_temp-browse-handle
     3136               where buf_temp-browse-handle.browse-type = 'width':u
     3137             on error undo, next
     3138             :
     3139               assign
     3140                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3141               .
     3142             end.
     3143             assign
     3144               frame Dialog-Frame :width = v-frame-width
     3145             .
     3146             if frame Dialog-Frame :scrollable = true
     3147             then do:
     3148               assign
     3149                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3150               .
     3151             end.
     3152             run diasize_position-resize-button in this-procedure .
     3153           end.
     3154           else do:
     3155             if frame Dialog-Frame :scrollable = true
     3156             then do:
     3157               assign
     3158                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3159               .
     3160             end.
     3161             assign
     3162               frame Dialog-Frame :width = v-frame-width
     3163             .
     3164             for each buf_temp-browse-handle
     3165               where buf_temp-browse-handle.browse-type = 'width':u
     3166             on error undo, next
     3167             :
     3168               assign
     3169                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3170               .
     3171             end.
     3172             assign
     3173               v-diasize-browse-handle :width = v-browse-width
     3174             .
     3175             for each buf_temp-diasize-handle
     3176             on error undo, next
     3177             :
     3178               assign
     3179                 v-object-handle = buf_temp-diasize-handle.handle-value
     3180               .
     3181               if v-object-handle <> v-diasize-resize-button
     3182               then do:
     3183                 assign
     3184                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3185                 .
     3186               end.
     3187             end.
     3188             run diasize_position-resize-button in this-procedure .
     3189           end.
     3190           assign
     3191             v-diasize-change-size = false
     3192           .
     3193           leave move_block .
     3194         end.
     3195       end.
     3196       assign
     3197         v-diasize-need-full-display = true
     3198       .
     3199       if v-diasize-change-size = false
     3200       then do:
     3201         assign
     3202           v-diasize-change-size = true
     3203         .
     3204       end.
     3205       else do:
     3206         return .
     3207       end.
     3208       assign
     3209         v-frame-width = frame Dialog-Frame :width
     3210         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     3211         v-browse-width = v-diasize-browse-handle :width
     3212       .
     3213       for each buf_temp-browse-handle
     3214         where buf_temp-browse-handle.browse-type = 'width':u
     3215       :
     3216         assign
     3217           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3218         .
     3219       end.
     3220       for each buf_temp-diasize-handle
     3221       :
     3222         delete buf_temp-diasize-handle .
     3223       end.
     3224       assign
     3225         v-field-group-handle = frame Dialog-Frame :first-child
     3226       .
     3227       do while valid-handle(v-field-group-handle)
     3228       :
     3229         assign
     3230           v-object-handle = v-field-group-handle :first-child
     3231         .
     3232         do while valid-handle(v-object-handle)
     3233         :
     3234           if  v-object-handle <> v-diasize-browse-handle :handle
     3235           and v-object-handle <> v-diasize-resize-button
     3236           and can-query(v-object-handle, "row")
     3237           and can-query(v-object-handle, "height")
     3238           and ( v-object-handle :col + v-object-handle :width
     3239                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3240               )
     3241           then do:
     3242             find first buf_temp-browse-handle
     3243               where buf_temp-browse-handle.browse-type   = 'width':u
     3244                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3245               no-error .
     3246             if available buf_temp-browse-handle
     3247             then do:
     3248             end.
     3249             else do:
     3250               create buf_temp-diasize-handle .
     3251               assign
     3252                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3253                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3254               .
     3255             end.
     3256           end.
     3257           assign
     3258             v-object-handle = v-object-handle :next-sibling
     3259           .
     3260         end.
     3261         assign
     3262           v-field-group-handle = v-field-group-handle :next-sibling
     3263         .
     3264       end.
     3265       do with frame Dialog-Frame
     3266       :
     3267         hide v-diasize-resize-button .
     3268         v-diasize-resize-button :row = 1.
     3269         v-diasize-resize-button :column = 1.
     3270       end.
     3271       if p-change-value > 0
     3272       then do:
     3273         if frame Dialog-Frame :scrollable = true
     3274         then do:
     3275           assign
     3276             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3277             no-error .
     3278           if error-status :error
     3279           or error-status :get-message(1) <> ""
     3280           then do:
     3281             undo move_block, retry move_block.
     3282           end.
     3283         end.
     3284         assign
     3285           frame Dialog-Frame :width = v-frame-width + p-change-value
     3286           no-error .
     3287         if error-status :error
     3288         or error-status :get-message(1) <> ""
     3289         then do:
     3290           undo move_block, retry move_block.
     3291         end.
     3292         assign
     3293           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3294         no-error .
     3295         if error-status :error
     3296         or error-status :get-message(1) <> ""
     3297         then do:
     3298           undo move_block, retry move_block.
     3299         end.
     3300         for each buf_temp-browse-handle
     3301           where buf_temp-browse-handle.browse-type = 'width':u
     3302         on error undo move_block, retry move_block
     3303         :
     3304           assign
     3305             buf_temp-browse-handle.browse-handle :width
     3306               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3307             no-error .
     3308           if error-status :error
     3309           or error-status :get-message(1) <> ""
     3310           then do:
     3311             undo move_block, retry move_block .
     3312           end.
     3313         end.
     3314         for each buf_temp-diasize-handle
     3315         on error undo move_block, retry move_block
     3316         :
     3317           assign
     3318             v-object-handle = buf_temp-diasize-handle.handle-value
     3319           .
     3320           if v-object-handle <> v-diasize-resize-button
     3321           then do:
     3322             assign
     3323               v-object-handle :col = v-object-handle :col + p-change-value
     3324               no-error .
     3325             if error-status :error
     3326             or error-status :get-message(1) <> ""
     3327             then do:
     3328               undo move_block, retry move_block .
     3329             end.
     3330           end.
     3331         end.
     3332       end.
     3333       else do:
     3334         for each buf_temp-diasize-handle
     3335         on error undo move_block, retry move_block
     3336         :
     3337           assign
     3338             v-object-handle = buf_temp-diasize-handle.handle-value
     3339           .
     3340           if v-object-handle <> v-diasize-resize-button
     3341           then do:
     3342             assign
     3343               v-object-handle :col = v-object-handle :col + p-change-value
     3344               no-error .
     3345             if error-status :error
     3346             or error-status :get-message(1) <> ""
     3347             then do:
     3348               undo move_block, retry move_block .
     3349             end.
     3350           end.
     3351         end.
     3352         for each buf_temp-browse-handle
     3353           where buf_temp-browse-handle.browse-type = 'width':u
     3354         on error undo move_block, retry move_block
     3355         :
     3356           assign
     3357             buf_temp-browse-handle.browse-handle :width
     3358               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3359             no-error .
     3360           if error-status :error
     3361           or error-status :get-message(1) <> ""
     3362           then do:
     3363             undo move_block, retry move_block .
     3364           end.
     3365         end.
     3366         assign
     3367           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3368           no-error .
     3369         if error-status :error
     3370         or error-status :get-message(1) <> ""
     3371         then do:
     3372           undo move_block, retry move_block.
     3373         end.
     3374         assign
     3375           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3376         no-error .
     3377         if error-status :error
     3378         or error-status :get-message(1) <> ""
     3379         then do:
     3380           undo move_block, retry move_block.
     3381         end.
     3382         if frame Dialog-Frame :scrollable = true
     3383         then do:
     3384           assign
     3385             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3386           no-error .
     3387           if error-status :error
     3388           or error-status :get-message(1) <> ""
     3389           then do:
     3390             undo move_block, retry move_block.
     3391           end.
     3392         end.
     3393       end.
     3394       if p-move-resize
     3395       then do:
     3396         run diasize_position-resize-button in this-procedure .
     3397       end.
     3398       if v-diasize-wndstore = true
     3399       then do:
     3400         if connected("ub") = true
     3401         then do:
     3402           define variable v-cntxt-db-num        as integer   no-undo .
     3403           define variable v-cntxt-userid        as character no-undo .
     3404           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3405                                             , OUTPUT v-cntxt-userid
     3406                                             ) .
     3407           run gbl/wndsizew.p
     3408             (input  v-cntxt-db-num
     3409             ,input  v-cntxt-userid
     3410             ,input  v-diasize-proc-name
     3411             ,input  'width':u
     3412             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3413             ) .
     3414         end.
     3415       end.
     3416     end.
     3417     assign
     3418       v-diasize-change-size = false
     3419     .
     3420   end procedure.
     3421   procedure diasize_set-width :
     3422     define input  parameter p-new-width  as decimal   no-undo .
     3423     define input  parameter p-move-resize as logical   no-undo .
     3424     do
     3425     on error undo, return error return-value
     3426     :
     3427       run diasize_change-width in this-procedure
     3428         (input  (p-new-width - frame Dialog-Frame :width)
     3429         ,input  p-move-resize
     3430         ) .
     3431     end.
     3432   end procedure.
     3433   procedure diasize_position-resize-button :
     3434     do with frame Dialog-Frame
     3435     :
     3436       hide v-diasize-resize-button .
     3437       assign
     3438         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3439                     - 1
     3440                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3441         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3442                     - 1
     3443                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3444       .
     3445       view v-diasize-resize-button .
     3446     end.
     3447   end procedure.
     3448   on alt-right anywhere
     3449   do:
     3450     run diasize_change-width in this-procedure
     3451       (input 1
     3452       ,input true
     3453       ) .
     3454     return no-apply .
     3455   end.
     3456   on alt-left anywhere
     3457   do:
     3458     run diasize_change-width in this-procedure
     3459       (input -1
     3460       ,input true
     3461       ) .
     3462     return no-apply .
     3463   end.
     3464   on alt-down anywhere
     3465   do:
     3466     run diasize_change-height in this-procedure
     3467       (input 1
     3468       ,input true
     3469       ) .
     3470     return no-apply .
     3471   end.
     3472   on alt-up anywhere
     3473   do:
     3474     run diasize_change-height in this-procedure
     3475       (input -1
     3476       ,input true
     3477       ) .
     3478     return no-apply .
     3479   end.
     3480   on alt-enter of frame Dialog-Frame
     3481   do:
     3482     run diasize_maximize in this-procedure
     3483       (input  ?
     3484       ).
     3485     return no-apply .
     3486   end.
     3487   procedure diasize_end-move :
     3488     do
     3489     on error undo, return error return-value
     3490     :
     3491       define variable v-row-delta as decimal   no-undo .
     3492       define variable v-col-delta as decimal   no-undo .
     3493       define variable v-new-row as decimal   no-undo .
     3494       define variable v-new-col as decimal   no-undo .
     3495       assign
     3496         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3497         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3498       .
     3499       assign
     3500         v-row-delta = v-new-row - frame Dialog-Frame :height
     3501         v-col-delta = v-new-col - frame Dialog-Frame :width
     3502       .
     3503       run diasize_change-height in this-procedure
     3504         (input v-row-delta
     3505         ,input true
     3506         ) .
     3507       run diasize_change-width in this-procedure
     3508         (input v-col-delta
     3509         ,input true
     3510         ) .
     3511     end.
     3512   end procedure.
     3513   procedure diasize_maximize :
     3514     define input  parameter p-action as logical   no-undo .
     3515     do
     3516     on error undo, return error return-value
     3517     :
     3518       if p-action = ?
     3519       then do:
     3520         if v-diasize-need-maximize = true
     3521         then do:
     3522           assign
     3523             p-action = true
     3524           .
     3525         end.
     3526         else do:
     3527           assign
     3528             p-action = false
     3529           .
     3530         end.
     3531       end.
     3532       if p-action = true
     3533       then do:
     3534         run diasize_change-height in this-procedure
     3535           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3536               - frame Dialog-Frame :height-chars
     3537           ,input true
     3538           ) .
     3539         run diasize_change-width in this-procedure
     3540           (input session :width-chars
     3541               - frame Dialog-Frame :width-chars
     3542           ,input true
     3543           ) .
     3544         assign
     3545           v-diasize-need-maximize = false
     3546         .
     3547       end.
     3548       else do:
     3549         run diasize_change-width in this-procedure
     3550           (input v-diasize-orig-frame-width
     3551               - frame Dialog-Frame :width-chars
     3552           ,input true
     3553           ) .
     3554         run diasize_change-height in this-procedure
     3555           (input v-diasize-orig-frame-height
     3556               - frame Dialog-Frame :height-chars
     3557           ,input true
     3558           ) .
     3559         assign
     3560           v-diasize-need-maximize = true
     3561         .
     3562       end.
     3563     end.
     3564   end procedure.
     3565   procedure diasize_restore-orig-size :
     3566     do
     3567     on error undo, return error return-value
     3568     :
     3569       assign
     3570         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3571         v-diasize-current-frame-height = frame Dialog-Frame :height
     3572       .
     3573       run diasize_set-height in this-procedure
     3574         (input  v-diasize-orig-frame-height
     3575         ,input  true
     3576         ) .
     3577       run diasize_set-width in this-procedure
     3578         (input  v-diasize-orig-frame-width
     3579         ,input  true
     3580         ) .
     3581     end.
     3582   end procedure.
     3583   procedure diasize_restore-current-size :
     3584     do
     3585     on error undo, return error return-value
     3586     :
     3587       run diasize_set-height in this-procedure
     3588         (input  v-diasize-current-frame-height
     3589         ,input  true
     3590         ) .
     3591       run diasize_set-width in this-procedure
     3592         (input  v-diasize-current-frame-width
     3593         ,input  true
     3594         ) .
     3595     end.
     3596   end procedure.
     3597   procedure diasize_set-browse-handle :
     3598     define input  parameter p-browse-handle as handle   no-undo .
     3599     define buffer buf_temp-browse-handle for temp-browse-handle .
     3600     do
     3601     on error undo, return error return-value
     3602     :
     3603       assign
     3604         v-diasize-browse-handle = p-browse-handle
     3605       .
     3606       for each buf_temp-browse-handle
     3607       on error undo, return error return-value
     3608       :
     3609         delete buf_temp-browse-handle .
     3610       end.
     3611     end.
     3612   end procedure.
     3613   procedure diasize_add_browse :
     3614     define input  parameter p-browse-type   as character no-undo .
     3615     define input  parameter p-browse-handle as handle    no-undo .
     3616     define buffer buf_temp-browse-handle for temp-browse-handle .
     3617     do
     3618     on error undo, return error return-value
     3619     :
     3620       assign
     3621         v-diasize-browse-number = v-diasize-browse-number + 1
     3622       .
     3623       create buf_temp-browse-handle .
     3624       assign
     3625         buf_temp-browse-handle.browse-type   = p-browse-type
     3626         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3627         buf_temp-browse-handle.browse-handle = p-browse-handle
     3628       .
     3629     end.
     3630   end procedure.
     3631   procedure diasize_init :
     3632     define variable v-default-value    as logical   no-undo .
     3633     define variable v-restore-saved    as logical   no-undo .
     3634     define variable v-resize-value-str as character no-undo .
     3635     do
     3636     on error undo, return error return-value
     3637     :
     3638       do with frame Dialog-Frame
     3639       :
     3640         assign
     3641           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3642           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3643           v-diasize-browse-handle     = browse BR-dinamo :handle
     3644         .
     3645         create button v-diasize-resize-button
     3646         assign
     3647           parent        = frame Dialog-Frame :first-child
     3648           label         = "s"
     3649           height-pixels = 16
     3650           width-pixels  = 16
     3651           visible       = true
     3652           sensitive     = true
     3653           movable       = true
     3654           triggers:
     3655             on end-move persistent run diasize_end-move in this-procedure .
     3656           end triggers.
     3657         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3658         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3659         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3660         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3661         assign
     3662           v-diasize-wndmax = false
     3663         .
     3664         if connected("ub") = true
     3665         then do:
     3666           define variable v-cntxt-db-num        as integer   no-undo .
     3667           define variable v-cntxt-userid        as character no-undo .
     3668           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3669                                             , OUTPUT v-cntxt-userid
     3670                                             ) .
     3671           run gbl/wndpar_r.p
     3672             (input  v-cntxt-db-num
     3673             ,input  v-cntxt-userid
     3674             ,input  'wndmax':U
     3675             ,output v-diasize-wndmax
     3676             ,output v-default-value
     3677             ) .
     3678         end.
     3679         assign
     3680           v-diasize-wndstore = false
     3681         .
     3682         if connected("ub") = true
     3683         then do:
     3684           run gbl/wndpar_r.p
     3685             (input  v-cntxt-db-num
     3686             ,input  v-cntxt-userid
     3687             ,input  'wndstore':U
     3688             ,output v-diasize-wndstore
     3689             ,output v-default-value
     3690             ) .
     3691         end.
     3692         assign
     3693           v-diasize-proc-name = entry(1, program-name(2), '.')
     3694         .
     3695         if v-diasize-wndstore = true
     3696         then do:
     3697           assign
     3698             v-restore-saved = false
     3699           .
     3700           if connected("ub") = true
     3701           then do:
     3702             run gbl/wndsizer.p
     3703               (input  v-cntxt-db-num
     3704               ,input  v-cntxt-userid
     3705               ,input  v-diasize-proc-name
     3706               ,input  'height':u
     3707               ,output v-resize-value-str
     3708               ) .
     3709             if v-resize-value-str <> '':U
     3710             then do:
     3711               run diasize_change-height in this-procedure
     3712                 (input  integer(v-resize-value-str)
     3713                 ,input  true
     3714                 ) .
     3715               assign
     3716                 v-restore-saved = true
     3717               .
     3718             end.
     3719           end.
     3720           if connected("ub") = true
     3721           then do:
     3722             run gbl/wndsizer.p
     3723               (input  v-cntxt-db-num
     3724               ,input  v-cntxt-userid
     3725               ,input  v-diasize-proc-name
     3726               ,input  'width':u
     3727               ,output v-resize-value-str
     3728               ) .
     3729             if v-resize-value-str <> '':U
     3730             then do:
     3731               run diasize_change-width in this-procedure
     3732                 (input  integer(v-resize-value-str)
     3733                 ,input  true
     3734                 ) .
     3735               assign
     3736                 v-restore-saved = true
     3737               .
     3738             end.
     3739           end.
     3740           if v-restore-saved <> true
     3741           then do:
     3742             if v-diasize-wndmax = true
     3743             then do:
     3744               run diasize_maximize in this-procedure
     3745                 (input  true
     3746                 ) .
     3747             end.
     3748           end.
     3749         end.
     3750         else do:
     3751           if v-diasize-wndmax = true
     3752           then do:
     3753             run diasize_maximize in this-procedure
     3754               (input  true
     3755               ) .
     3756           end.
     3757         end.
     3758       end.
     3759     end.
     3760   end procedure.
     3761   procedure diasize_need-full-display :
     3762     define output parameter p-need-full-display as logical   no-undo .
     3763     do
     3764     on error undo, return error return-value
     3765     :
     3766       assign
     3767         p-need-full-display = v-diasize-need-full-display
     3768       .
     3769       assign
     3770         v-diasize-need-full-display = false
     3771       .
     3772     end.
     3773   end procedure.
     3774   procedure get-context :
     3775      define output parameter p-db-num as integer          no-undo.
     3776      define output parameter p-user-id as character        no-undo.
     3777      define variable v-login               as character    no-undo.
     3778      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3779      define buffer buf_user-login  for ub.user-login .
     3780      do
     3781      on error undo, return error
     3782      :
     3783            FIND FIRST buf_sys-ctrl no-lock.
     3784            ASSIGN
     3785               v-login = USERID("ub")
     3786               p-db-num = buf_sys-ctrl.db-num
     3787            .
     3788            FIND FIRST buf_user-login
     3789                 WHERE buf_user-login.db-num = p-db-num
     3790                   AND buf_user-login.user-login = v-login
     3791                 no-lock
     3792                 no-error
     3793                 .
     3794            IF AVAILABLE buf_user-login
     3795            THEN DO:
     3796               assign
     3797                  p-user-id = buf_user-login.user-id
     3798               .
     3799            END.
     3800      end.
     3801   end procedure.
     3802       run diasize_init in this-procedure .
