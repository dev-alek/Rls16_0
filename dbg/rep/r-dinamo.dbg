     1540   FUNCTION get-doc-type RETURNS CHARACTER
     1541     ( input p-ii as integer, input-output p-ext-doc-type as character, input-output p-sign as character, output p-ext-doc-type-full as character, output p-doc-type-full as character, output p-idoc-type as character ) :
     1542   DEFINE VARIABLE v-doc-type as character no-undo .
     1543   assign
     1544   p-ext-doc-type-full = entry(p-ii, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U)
     1545   .
     1546     CASE p-ext-doc-type:
     1547       when 'ie':U
     1548    or when 'iv':U
     1549    or when 'im':U
     1550    then do:
     1551         assign
     1552         v-doc-type = 'при':U
     1553         p-doc-type-full = "Приход"
     1554         p-idoc-type = string(1)
     1555         p-sign = string(0)
     1556         .
     1557       end.
     1558       when 'ee':U
     1559    or when 'es':U
     1560    or when 'we':U
     1561    or when 'ep':U
     1562    or when 'ev':U
     1563    or when 'wm':U then do:
     1564         assign
     1565         v-doc-type = 'рас':U
     1566         p-doc-type-full = "Расход"
     1567         p-idoc-type  = string(2)
     1568         p-sign = string(0)
     1569         .
     1570       end.
     1571       when 're':U
     1572    or when 'rs':U
     1573    or when 'rv':U then do:
     1574         assign
     1575         v-doc-type = 'возврат':U
     1576         p-doc-type-full = "Возврат"
     1577         p-idoc-type = string(3)
     1578         p-sign = string(0)
     1579         .
     1580       end.
     1581       when 'ap':U then do:
     1582         assign
     1583         v-doc-type = 'ap':U
     1584         p-doc-type-full = "Переоц.уч.цен"
     1585         p-idoc-type = string(6)
     1586         p-sign = string(0)
     1587         .
     1588       end.
     1589       when 'pc':U then do:
     1590         assign
     1591         v-doc-type = 'pc':U
     1592         p-doc-type-full = "Смена типа приобр."
     1593         p-idoc-type = string( 5)
     1594         p-sign = string(0)
     1595         .
     1596       end.
     1597       when 'ot':U then do:
     1598         assign
     1599         v-doc-type = 'ot':U
     1600         p-doc-type-full = "Переоценка"
     1601         p-idoc-type = string(4)
     1602         p-sign = string(0)
     1603        .
     1604       end.
     1605       when 'vt':U      or
     1606       when 'vp':U then do:
     1607         CASE p-sign:
     1608           when string(0) then do:
     1609             assign
     1610             p-ext-doc-type = p-ext-doc-type + chr(44) + p-ext-doc-type
     1611             v-doc-type = 'рас':U + chr(44) + 'при':U
     1612             p-doc-type-full = "Расход" + chr(44) + "Приход"
     1613             p-ext-doc-type-full = p-ext-doc-type-full + "(-)":U + chr(44) + p-ext-doc-type-full + "(+)":U
     1614             p-idoc-type = string(2) + chr(44) + string(1)
     1615             p-sign = string(-1) + chr(44) + string( 1)
     1616             .
     1617           end.
     1618           when string(- 1) then do:
     1619             assign
     1620             v-doc-type = 'рас':U
     1621             p-doc-type-full = "Расход"
     1622             p-ext-doc-type-full = p-ext-doc-type-full + "(-)":U
     1623             p-idoc-type = string(2)
     1624             p-sign = string( - 1)
     1625             .
     1626           end.
     1627           when string(1) then do:
     1628             assign
     1629             v-doc-type = 'при':U
     1630             p-doc-type-full = "Приход"
     1631             p-ext-doc-type-full = p-ext-doc-type-full + "(+)":U
     1632             p-idoc-type =  string(1)
     1633             p-sign = string(1)
     1634             .
     1635           end.
     1636         END CASE.
     1637       end.
     1638       when 'em':U then do:
     1639         assign
     1640         v-doc-type = "":U
     1641         p-doc-type-full = ""
     1642         p-idoc-type = string( 0)
     1643         p-sign = string(0)
     1644         .
     1645       end.
     1646     END CASE.
     1647     RETURN v-doc-type.
     1648   END FUNCTION.
     1649   procedure proc-view-objects :
     1650   DEFINE VARIABLE v-attr-codes as character no-undo .
     1651   DEFINE VARIABLE v-attr-labels as character no-undo .
     1652   DEFINE VARIABLE v-output as character no-undo .
     1653     do
     1654     on error undo, return error
     1655     :
     1656       for each obj-list no-lock,
     1657           first t-fo0 no-lock where
     1658                t-fo0.obj-type = obj-list.obj-type
     1659            AND t-fo0.obj-code = obj-list.obj-code
     1660           :
     1661         assign
     1662         v-attr-codes = v-attr-codes + obj-list.obj-type + string(obj-list.obj-code) + chr(44)
     1663         v-attr-labels = v-attr-labels + obj-list.obj-type + string(obj-list.obj-code) + fill( chr(32), 5) +
     1664                         "Данные c" + chr(32) + string(t-fo0.cfact-date, "99/99/9999") + chr(44)
     1665         .
     1666       end.
     1667       assign
     1668       v-attr-codes = right-trim(v-attr-codes, chr(44))
     1669       v-attr-labels = right-trim(v-attr-labels, chr(44))
     1670       .
     1671       run gbl/d-list.w (
     1672                     input "":U
     1673                    ,input "Объекты, выбранные для показа динамики товара"
     1674                    ,input v-attr-codes
     1675                    ,input v-attr-labels
     1676                    ,input chr(44)
     1677                    ,input "":U
     1678                    ,output v-output).
     1679     end.
     1680   end procedure.
     1681   procedure proc-print-oborot :
     1682   define input parameter p-artic like ub.goods.artic no-undo .
     1683   define input parameter p-prod-type like ub.goods.prod-type no-undo .
     1684   define input parameter p-prod-code like ub.goods.prod-code no-undo .
     1685   define input parameter p-date-start as date no-undo .
     1686   define input parameter p-date-end as date no-undo .
     1687   DEFINE VARIABLE v-attr-codes as character no-undo .
     1688   DEFINE VARIABLE v-attr-labels as character no-undo .
     1689   DEFINE VARIABLE v-output as character no-undo .
     1690   DEFINE VARIABLE v-obj-type like ub.clients.obj-type no-undo .
     1691   DEFINE VARIABLE v-obj-code like ub.clients.obj-code no-undo .
     1692     do
     1693     on error undo, return error
     1694     :
     1695       for each obj-list no-lock:
     1696         assign
     1697         v-attr-codes = v-attr-codes + obj-list.obj-type + string(obj-list.obj-code) + chr(44).
     1698       end.
     1699       assign
     1700       v-attr-codes = right-trim(v-attr-codes, chr(44))
     1701       .
     1702       if num-entries(v-attr-codes) <> 1 then do:
     1703         run gbl/d-list.w (
     1704                       input "b-sel":U
     1705                     ,input "Выберите объект для печати оборотной ведомости"
     1706                     ,input v-attr-codes
     1707                     ,input v-attr-codes
     1708                     ,input chr(44)
     1709                     ,input "":U
     1710                     ,output v-output).
     1711         if v-output = "":U then return.
     1712         assign
     1713         v-obj-type = substr(v-output, 1, 3)
     1714         v-obj-code = integer(substr(v-output, 4))
     1715         .
     1716       end.
     1717       else do:
     1718         assign
     1719         v-obj-type = substr(v-attr-codes, 1, 3)
     1720         v-obj-code = integer(substr(v-attr-codes, 4))
     1721         .
     1722       end.
     1723       run rep/e-good2.w (parParentProc,
     1724                     p-artic,
     1725                     p-prod-type,
     1726                     p-prod-code,
     1727                     p-date-start,
     1728                     p-date-end,
     1729                     v-obj-type,
     1730                     v-obj-code
     1731                       ) no-error.
     1732     end.
     1733   end procedure.
     1734   procedure proc-print-crd :
     1735   define input parameter p-artic like ub.goods.artic no-undo .
     1736   define input parameter p-prod-type like ub.goods.prod-type no-undo .
