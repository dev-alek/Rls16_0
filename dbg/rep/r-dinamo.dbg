     1184   procedure prn-lib-reportviewer-report-name :
     1185     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1186     define input parameter p-report-name-html as character no-undo .
     1187     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1188   end procedure.
     1189   procedure prn-lib-reportviewer :
     1190     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1191     define input parameter p-report-name-html as character no-undo .
     1192     define input parameter p-param        as character no-undo .
     1193     define variable v-excel           as character no-undo init 'TRUE' .
     1194     define variable v-value-character as character no-undo .
     1195     define variable v-value-integer   as character no-undo .
     1196     define variable v-value-date      as date      no-undo .
     1197     define variable v-value-decimal   as decimal   no-undo .
     1198     define variable rep-excel         as logical   no-undo .
     1199     define variable excel-string      as character no-undo .
     1200     define variable v-param-type      as character no-undo .
     1201     define variable v-tth             as handle    no-undo .
     1202     run adm/shattri.p (
     1203       input "get":U
     1204       ,input  ""
     1205       ,input  0
     1206       ,input  'report-glob':U
     1207       ,input  'rep-excel':U
     1208       ,output v-value-character
     1209       ,output v-value-date
     1210       ,output v-value-decimal
     1211       ,output v-value-integer
     1212       ,output rep-excel
     1213       ,output v-param-type
     1214       ,INPUT-OUTPUT table-handle v-tth
     1215       )  .
     1216     if rep-excel then v-excel = "TRUE" .
     1217     else v-excel = "FALSE" .
     1218     if p-param eq ""
     1219     then
     1220        p-param = "EXCEL:" + v-excel.
     1221     else
     1222        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1223     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1224   end procedure.
     1225   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1226   procedure cur-time :
     1227      define output parameter p-today as date      no-undo .
     1228      define output parameter p-time  as integer   no-undo .
     1229     do
     1230     on error undo, return error
     1231     :
     1232       define variable v-date1 as date      no-undo .
     1233       define variable v-date2 as date      no-undo .
     1234       define variable v-time  as integer   no-undo .
     1235       assign
     1236         v-date1 = today
     1237         v-time  = time
     1238         v-date2 = today
     1239       .
     1240       if v-date1 <> v-date2
     1241       then do:
     1242         assign
     1243           v-date1 = today
     1244           v-time  = v-time
     1245         .
     1246       end.
     1247       assign
     1248         p-today = v-date1
     1249         p-time  = v-time
     1250       .
     1251     end.
     1252   end.
     1253   function cur-time-date returns character
     1254   :
     1255     return string(today, '99/99/9999':U) .
     1256   end.
     1257   function cur-time-mjd returns decimal
     1258   :
     1259     define variable v-date as date      no-undo .
     1260     define variable v-time as integer   no-undo .
     1261     run cur-time in this-procedure
     1262       (output v-date
     1263       ,output v-time
     1264       ) .
     1265     return integer(v-date) - 2400002 + (v-time / 86400) .
     1266   end.
     1267   function cur-time-get-ending-index returns integer
     1268   (input p-number as integer
     1269   )
     1270   :
     1271     if p-number < 0
     1272     or p-number = ?
     1273     then do:
     1274       return 1 .
     1275     end.
     1276     define variable v-rest as integer   no-undo .
     1277     assign
     1278       p-number = p-number modulo 100
     1279     .
     1280     if p-number < 20
     1281     then do:
     1282       assign
     1283         v-rest = p-number
     1284       .
     1285     end.
     1286     else do:
     1287       assign
     1288         v-rest = p-number modulo 10
     1289       .
     1290     end.
     1291     case v-rest :
     1292       when 1
     1293       then do:
     1294         return 2 .
     1295       end.
     1296       when 2 or
     1297       when 3 or
     1298       when 4
     1299       then do:
     1300         return 3 .
     1301       end.
     1302       otherwise do:
     1303         return 1 .
     1304       end.
     1305     end case .
     1306   end.
     1307   procedure cur-time-mjd-to-date :
     1308      define input  parameter i-mjd-diff as decimal no-undo.
     1309      define output parameter o-Date     as date    no-undo.
     1310      define output parameter o-Time     as integer no-undo.
     1311      define variable v-day-number as integer   no-undo .
     1312      if    i-mjd-diff < 0
     1313         or i-mjd-diff = ?
     1314      then do:
     1315         return "?" .
     1316      end.
     1317      assign
     1318         v-day-number = truncate(i-mjd-diff,0).
     1319         o-Date = date(v-day-number + 2400002).
     1320         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1321     .
     1322   end.
     1323   function cur-time-mjd-to-string returns character
     1324   (input p-mjd-diff as decimal
     1325   )
     1326   :
     1327     define variable v-day-number as integer   no-undo .
     1328     define variable v-seconds    as integer   no-undo .
     1329     define variable v-hour       as integer   no-undo .
     1330     define variable v-min        as integer   no-undo .
     1331     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1332     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1333     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1334     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1335     if p-mjd-diff < 0
     1336     or p-mjd-diff = ?
     1337     then do:
     1338       return "?" .
     1339     end.
     1340     assign
     1341       v-day-number = integer(truncate(p-mjd-diff,0))
     1342       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1343     .
     1344     if v-seconds > 86400
     1345     then do:
     1346       assign
     1347         v-seconds = 86400 - 1
     1348       .
     1349     end.
     1350     if v-seconds < 0
     1351     then do:
     1352       assign
     1353         v-seconds = 0
     1354       .
     1355     end.
     1356     assign
     1357       v-hour = truncate(v-seconds / 3600, 0)
     1358     .
     1359     assign
     1360       v-seconds = v-seconds modulo 3600
     1361     .
     1362     assign
     1363       v-min = truncate(v-seconds / 60, 0)
     1364     .
     1365     assign
     1366       v-seconds = v-seconds modulo 60
     1367     .
     1368     return
     1369         (if v-day-number <> 0
     1370           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1371           else ""
     1372         )
     1373       + (if v-day-number <> 0 or v-hour <> 0
     1374           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1375           else ""
     1376         )
     1377       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1378           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1379           else ""
     1380         )
     1381       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1382       .
     1383   end.
     1384   function cur-time-string returns character
     1385   :
     1386     define variable v-date as date      no-undo .
     1387     define variable v-time as integer   no-undo .
     1388     run cur-time in this-procedure
     1389       (output v-date
     1390       ,output v-time
     1391       ) .
     1392     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1393   end.
     1394   function cur-time-string-sec returns character
     1395   :
     1396     define variable v-date as date      no-undo .
     1397     define variable v-time as integer   no-undo .
     1398     run cur-time in this-procedure
     1399       (output v-date
     1400       ,output v-time
     1401       ) .
     1402     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1403   end.
     1404   function cur-time-custom  returns character
     1405   (input p-prefix as character
     1406   ,input p-date-format as character
     1407   ,input p-delimiter as character
     1408   ,input p-time-format as character
     1409   ,input p-suffix as character
     1410   )
     1411   :
     1412     define variable v-date as date      no-undo .
     1413     define variable v-time as integer   no-undo .
     1414     run cur-time in this-procedure
     1415       (output v-date
     1416       ,output v-time
     1417       ) .
     1418     return
     1419       p-prefix
     1420       + string(v-date, p-date-format)
     1421       + p-delimiter
     1422       + string(v-time, p-time-format)
     1423       + p-suffix
     1424       .
     1425   end.
     1426   function cur-time-print  returns character
     1427   :
     1428     define variable v-date as date      no-undo .
     1429     define variable v-time as integer   no-undo .
     1430     run cur-time in this-procedure
     1431       (output v-date
     1432       ,output v-time
     1433       ) .
     1434     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1435   end.
     1436   function cur-time-datetime returns datetime
     1437   :
     1438     define variable v-char as character no-undo .
     1439     define variable v-datetime as datetime no-undo .
     1440     v-char = cur-time-string().
     1441     v-datetime = datetime(v-char).
     1442     return  v-datetime.
     1443   end.
     1444   function cur-time-string-msec returns character
     1445   :
     1446     define variable v-date as datetime  no-undo .
     1447     v-date = now.
     1448     return string(v-date) .
     1449   end.
