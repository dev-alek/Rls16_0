     2069   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2070   define variable v-waitfram-action01         as character   no-undo .
     2071   define variable v-waitfram-action02         as character   no-undo .
     2072   define variable v-waitfram-action03         as character   no-undo .
     2073   define variable mWaitFramTextBeg            as character   no-undo.
     2074   define variable mWaitFramTextEnd            as character   no-undo.
     2075   define variable mWaitFramView               as logical     no-undo.
     2076   define variable mWaitProcEvent              as logical     no-undo init yes.
     2077   define variable mWaitFramInterval           as integer     no-undo init 1 .
     2078   define variable mWaitFramStop               as logical     no-undo.
     2079   define variable mWaitFramStopUser           as logical     no-undo.
     2080   define variable mWaitFramStopTimeOut        as logical     no-undo.
     2081   define variable mWaitFramStartProc          as datetime-tz no-undo.
     2082   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     2083   define button B-WaitFramStop auto-end-key
     2084        label "Стоп"
     2085        size 10 by 1 tooltip "Остоновить процесс".
     2086   define button B-viewProcInfo
     2087        label "Информация"
     2088        size 15 by 1 tooltip "Информация о процесс".
     2089   define frame waitfram
     2090     v-waitfram-action01 format "x(72)" no-label skip
     2091     v-waitfram-action02 format "x(72)" no-label skip
     2092     v-waitfram-action03 format "x(72)" no-label skip
     2093     B-viewProcInfo
     2094     B-WaitFramStop at row 4 col 30
     2095     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     2096     .
     2097   define new global shared variable mBatchMode as logical no-undo init ?.
     2098   define variable mFramBachModHandle as handle no-undo.
     2099   mFramBachModHandle = frame waitfram:handle.
     2100   define variable mFameOldVis as logical no-undo.
     2101   define variable mVisCUrentVin as logical no-undo.
     2102   if session:batch-mode
     2103   then
     2104      mBatchMode = yes.
     2105   if mBatchMode = ? then do:
     2106     mVisCUrentVin = current-window:visible.
     2107     mFameOldVis = mFramBachModHandle:visible.
     2108     mFramBachModHandle:visible  = yes.
     2109     mBatchMode = mFramBachModHandle:visible ne yes.
     2110     mFramBachModHandle:visible = mFameOldVis.
     2111     current-window:visible = mVisCUrentVin.
     2112   end.
     2113    if  log-manager:logfile-name ne ?
     2114     then DO:
     2115         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     2116         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     2117         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     2118     end.
     2119   on choose of B-WaitFramStop in frame waitfram
     2120   do:
     2121     mWaitFramStop = yes.
     2122     mWaitFramStopUser = yes.
     2123   end.
     2124   function waitfram-check-timeout returns logical():
     2125      define variable vtime as int64 no-undo.
     2126      if mWaitFramStopTimeOut
     2127      then
     2128         return yes.
     2129      vtime = ( now - mWaitFramStartProc ) / 1000 .
     2130      if     mWaitFramTimeOut ne ?
     2131         and mWaitFramTimeOut ne 0
     2132         and mWaitFramTimeOut lt vtime
     2133      then do:
     2134         mWaitFramStopTimeOut = yes.
     2135      end.
     2136      return mWaitFramStopTimeOut.
     2137   end.
     2138   procedure waitfram-hide :
     2139     if not session:batch-mode
     2140     then do
     2141     on error undo, return error return-value
     2142     :
     2143       pause 0 before-hide .
     2144       if not mBatchMode then
     2145         hide frame waitfram .
     2146     if     not mWaitFramView
     2147        and mWaitProcEvent
     2148     then
     2149       process events .
     2150     end.
     2151   end procedure.
     2152   procedure waitfram-show :
     2153     define input  parameter p-message as character no-undo .
     2154     define variable v-left-margin as integer   no-undo .
     2155     if not session:batch-mode
     2156     then do
     2157     on error undo, return error return-value
     2158     :
     2159       if length(p-message) <= 70 then do:
     2160         assign
     2161           v-left-margin = integer((70 - length(p-message)) / 2)
     2162         .
     2163         assign
     2164           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     2165         .
     2166         assign
     2167           v-waitfram-action01 = " "
     2168           v-waitfram-action02 = " "
     2169                                    + fill(" ", v-left-margin)
     2170                                    + p-message
     2171           v-waitfram-action03 = " "
     2172         .
     2173       end.
     2174       else do:
     2175         define variable vRindex1 as integer no-undo.
     2176         define variable vRindex2 as integer no-undo.
     2177         vRindex1 = r-index(p-message," ",70).
     2178         if vRindex1 = 0
     2179         then
     2180            vRindex1 = 70.
     2181         if length(p-message)  <= vRindex1 + 70 then do:
     2182           assign
     2183             v-waitfram-action01 = " "
     2184             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     2185             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     2186           .
     2187         end.
     2188         else do:
     2189           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     2190           if vRindex2 <= vRindex1
     2191           then
     2192              vRindex2 = vRindex1 + 70.
     2193           assign
     2194             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     2195             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     2196             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     2197           .
     2198         end.
     2199       end.
     2200       B-viewProcInfo:visible   in frame waitfram = no.
     2201       B-viewProcInfo:sensitive in frame waitfram = no.
     2202       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     2203       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     2204       if  (   mWaitFramView
     2205          or  mWaitProcEvent)
     2206          and not mBatchMode
     2207       then
     2208          display
     2209             v-waitfram-action01 skip
     2210             v-waitfram-action02 skip
     2211             v-waitfram-action03 skip
     2212          with frame waitfram .
     2213       if     mWaitFramView
     2214          then do:
     2215             if     mWaitFramInterval ne ?
     2216                and not mBatchMode
     2217             then
     2218                wait-for go of frame waitfram pause mWaitFramInterval.
     2219          end.
     2220          else
     2221             if     mWaitProcEvent
     2222                and not mBatchMode
     2223             then
     2224                process events .
     2225     end.
     2226   end procedure.
     2227      procedure waitfram-show-this:
     2228         define input  parameter iInterval as int64 no-undo.
     2229         define variable vtime as int64 no-undo.
     2230         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     2231         mWaitFramInterval = iInterval.
     2232         run waitfram-show (substitute("&1&2 &3&4" ,
     2233                                       mWaitFramTextBeg ,
     2234                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     2235                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     2236                                       mWaitFramTextEnd
     2237                                      )
     2238                           ).
     2239      end.
     2240      procedure WaitFramRunPause:
     2241         define input  parameter iInterval as dec no-undo.
     2242         define variable vStart  as datetime-tz no-undo.
     2243         define variable vend    as datetime-tz no-undo.
     2244         define variable vint as int64 no-undo.
     2245         define variable vOk as logical no-undo.
     2246         vStart = now.
     2247         vend   = vStart.
     2248         publish "WaitFramPause" (iInterval,output vOk).
     2249         vend   =  now.
     2250         vint = vend - vStart.
     2251         vint = iInterval - vint / 1000.
     2252         if     not mWaitFramStop
     2253            and (   vint > 0
     2254                 or (    not vOk
     2255                     and iInterval eq ?
     2256                     )
     2257                 )
     2258         then
     2259            run waitfram-show-this (iInterval).
     2260         vend   =  now.
     2261         vint = vend - vStart.
     2262         vint = iInterval - vint / 1000.
     2263         if     not mWaitFramStop
     2264            and vint > 0
     2265         then do:
     2266            run gbl/pause.p (vint * 1000).
     2267         end.
     2268         if iInterval ne ?
     2269         then
     2270            publish "WaitFramStop".
     2271         waitfram-check-timeout().
     2272      end.
     2273      procedure WaitFramWaitFor:
     2274         define input  parameter iInterval as dec no-undo.
     2275         assign
     2276            mWaitFramStartProc   = now
     2277            mWaitFramStopUser    = no
     2278            mWaitFramStopTimeOut = no
     2279         .
     2280         block-wait:
     2281         do while not mWaitFramStop:
     2282            run WaitFramRunPause (iInterval).
     2283            if  waitfram-check-timeout()
     2284            then do:
     2285               leave block-wait.
     2286            end.
     2287         end.
     2288         run waitfram-hide.
     2289      end.
     2290   procedure waitfram-join :
     2291     define input  parameter p-line-1  as character no-undo .
     2292     define input  parameter p-line-2  as character no-undo .
     2293     define input  parameter p-line-3  as character no-undo .
     2294     define output parameter p-message as character no-undo .
     2295     do
     2296     on error undo, return error return-value
     2297     :
     2298       assign
     2299         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     2300                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     2301                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     2302       .
     2303     end.
     2304   end procedure.
     2305   function waitfram-join-function returns character
     2306     (input p-line-1 as character
     2307     ,input p-line-2 as character
     2308     ,input p-line-3 as character
     2309     ).
     2310     define variable v-message as character no-undo .
     2311     run waitfram-join in this-procedure
     2312       (input  p-line-1
     2313       ,input  p-line-2
     2314       ,input  p-line-3
     2315       ,output v-message
     2316       ) .
     2317     return v-message .
     2318   end function .
