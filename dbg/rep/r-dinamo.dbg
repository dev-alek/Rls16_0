     1045   define  stream PrnLibStream.
     1046   procedure prn-lib-prn-file :
     1047     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1048     define input parameter p-DIsabledoptions as integer no-undo .
     1049     define variable v-report-name as character no-undo .
     1050     define variable v-user-action as character no-undo .
     1051     define variable v-printed     as logical   no-undo .
     1052     define variable v-exist       as logical   no-undo .
     1053     do
     1054       on error undo, return error
     1055       :
     1056       run prn-lib-get-report-name  in this-procedure (
     1057         input parParentProc
     1058         ,output v-report-name
     1059         ).
     1060   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1061   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1062     (input  v-report-name
     1063     ,input  2
     1064     ,output v-exist
     1065     )  .
     1066       if NOT v-exist then
     1067       DO:
     1068         Message
     1069           "Нет заданий на печать ! "
     1070           view-as alert-box .
     1071         Return  .
     1072       End.
     1073       run gbl/prnfilen.w
     1074         (input  ""
     1075         ,input  p-DisabledOptions
     1076         ,input  string(v-report-name )
     1077         ,input  7
     1078         ,output v-user-action
     1079         ,output v-printed
     1080         ) .
     1081       if v-printed then
     1082       do:
     1083         return "YES" .
     1084       end.
     1085       else
     1086       do:
     1087         return "NO" .
     1088       end.
     1089     end.
     1090   end procedure.
     1091   procedure prn-lib-open-stream :
     1092     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1093     define input parameter p-page-size    as integer no-undo .
     1094     define input parameter p-is-stream    as logical no-undo .
     1095     define input parameter p-append       as logical no-undo .
     1096     define variable v-report-name as character no-undo .
     1097     do
     1098       on error undo, return error
     1099       :
     1100       run prn-lib-get-report-name  in this-procedure (
     1101         input parParentProc
     1102         ,output v-report-name
     1103         ).
     1104       if p-is-stream then
     1105       do:
     1106         if p-append then
     1107         do:
     1108           output stream PrnLibStream to value( v-report-name )
     1109             page-size value(p-page-size) append .
     1110         end.
     1111         if not p-append then
     1112         do:
     1113           output stream PrnLibStream to value( v-report-name )
     1114             page-size value(p-page-size) .
     1115         end.
     1116       end.
     1117       if not p-is-stream then
     1118       do:
     1119         if p-append then
     1120         do:
     1121           output to value( v-report-name )
     1122             page-size value(p-page-size) append .
     1123         end.
     1124         if not p-append then
     1125         do:
     1126           output to value( v-report-name )
     1127             page-size value(p-page-size) .
     1128         end.
     1129       end.
     1130     end.
     1131   end procedure.
     1132   procedure prn-lib-open-exp :
     1133     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1134     define input parameter p-is-stream    as logical no-undo .
     1135     define input parameter p-is-append    as logical no-undo .
     1136     define output parameter p-ReportFileName as char init "report" no-undo.
     1137     define output parameter p-process as logical no-undo .
     1138     define variable glog as logical no-undo .
     1139     do
     1140       on error undo, return error
     1141       :
     1142       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1143         TITLE      "Укажите путь"
     1144         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1145         ASK-OVERWRITE
     1146         CREATE-TEST-FILE
     1147         SAVE-AS
     1148         USE-FILENAME
     1149         DEFAULT-EXTENSION "txt"
     1150         UPDATE glog
     1151         .
     1152       if not glog then  return.
     1153       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1154       if p-is-stream then
     1155       do:
     1156         if p-is-append then
     1157         do:
     1158           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1159         end.
     1160         else
     1161         do:
     1162           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1163         end.
     1164       end.
     1165       else
     1166       do:
     1167         if p-is-append then
     1168         do:
     1169           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1170         end.
     1171         else
     1172         do:
     1173           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1174         end.
     1175       end.
     1176       p-process = yes.
     1177     end.
     1178   end procedure.
     1179   procedure prn-lib-get-report-name :
