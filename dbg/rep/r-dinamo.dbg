     2472   END.
     2473   ON LEFT-MOUSE-DBLCLICK OF BR-dinamo IN FRAME Dialog-Frame
     2474   DO:
     2475   if not avail t-dinamo then return no-apply.
     2476     run proc-c-dinamo in this-procedure no-error.
     2477     if error-status:error then return no-apply.
     2478   END.
     2479   ON RETURN OF BR-dinamo IN FRAME Dialog-Frame
     2480   DO:
     2481     if not avail t-dinamo then return no-apply.
     2482     run proc-c-dinamo in this-procedure no-error.
     2483     if error-status:error then return no-apply.
     2484   END.
     2485   ON VALUE-CHANGED OF BR-dinamo IN FRAME Dialog-Frame
     2486   DO:
