     2328   FUNCTION Last-Day RETURNS INTEGER ( INPUT i-date AS DATE ) :
     2329     DEFINE VARIABLE t_date AS DATE NO-UNDO.
     2330     ASSIGN t_date = DATE( MONTH( i-date ), 28, YEAR( i-date ) ).
     2331     RETURN ( DAY( t_date - DAY( t_date + 4 ) + 4 ) ).
     2332   END FUNCTION.
     2333   DEFINE NEW SHARED var br-handle as handle no-undo.
