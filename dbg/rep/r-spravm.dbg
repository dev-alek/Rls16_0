     2054         varlastcur-excise    = 0
     2055         varcur-base          = 0
     2056         varcur-road-tax      = 0
     2057         varcur-excise        = 0
     2058         varcur-vat-pc        = 0
     2059         varcur-slt-pc        = 0
     2060         varcur-fact-qnty     = 0
     2061       .
     2062   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2063     (input  bf_goods.gds-code
     2064     ,input  ?
     2065     ,output varb-code
     2066     )  .
     2067   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2068   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcprcex in g#library
     2069     (input  bf_trn-doc.obj-type
     2070     ,input  bf_trn-doc.obj-code
     2071     ,input  varb-code
     2072     ,input  0
     2073     ,input  bf_trn-doc.fact-order
     2074     ,output vardoc-num
     2075     ,output varprice-sale
     2076     ,output varroad-tax
     2077     ,output varexcise
     2078     ,output varcur-vat-pc
     2079     ,output varcur-slt-pc
     2080     )  .
     2081       if varprice-sale = ?
     2082       then do:
     2083         assign
     2084           varcur-vat-pc = 0
     2085           varcur-slt-pc = 0
     2086         .
     2087       end.
     2088   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2089   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2090     (input  bf_goods.gds-code
     2091     ,input  '1':U
     2092     ,input  bf_trn-doc.fact-date
     2093     ,input  bf_trn-doc.host-code
     2094     ,input  bf_trn-doc.obj-type
     2095     ,input  bf_trn-doc.obj-code
     2096     ,output varcur-vat-pc
     2097     ) no-error .
     2098       if varcur-vat-pc = ?
     2099       then do:
     2100         return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3 документ &4", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code, bf_trn-doc.doc-code).
     2101       end.
     2102       if varcur-slt-pc = ?
     2103       then do:
     2104         return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3 документ &4", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code, bf_trn-doc.doc-code).
     2105       end.
     2106       v-calcbypart = no.
     2107       if bf_doc-line.whole-send-news = integer('1':U)   then
     2108       v-calcbypart = yes.
     2109       else do:
     2110       for each bf_gds-dtl no-lock
     2111         where bf_gds-dtl.doc-code  = bf_doc-line.doc-code
     2112           and bf_gds-dtl.artic     = bf_doc-line.artic
     2113           and bf_gds-dtl.prod-type = bf_doc-line.prod-type
     2114           and bf_gds-dtl.prod-code = bf_doc-line.prod-code
     2115       on error undo, return error return-value
     2116       :
     2117   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2118     (input  bf_goods.gds-code
     2119     ,input  bf_gds-dtl.prt-code
     2120     ,output varb-code
     2121     ) no-error .
     2122   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2123   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2124     (input  bf_trn-doc.obj-type
     2125     ,input  bf_trn-doc.obj-code
     2126     ,input  varb-code
     2127     ,input  0
     2128     ,input  bf_trn-doc.fact-order
     2129     ,output vardoc-num
     2130     ,output varprice-sale
     2131     ,output varroad-tax
     2132     ,output varexcise
     2133     )  .
     2134             if varprice-sale = ?
     2135             then do:
     2136               assign
     2137                 varprice-sale = 0
     2138                 varroad-tax   = 0
     2139                 varexcise     = 0
     2140               .
     2141             end.
     2142             assign
     2143               varlastcur-base     = varprice-sale
     2144               varlastcur-road-tax = varroad-tax
     2145               varlastcur-excise   = varexcise
     2146               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     2147               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     2148               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     2149               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     2150             .
     2151         end.
     2152       end.
     2153       if varcur-fact-qnty = 0 then do:
     2154         assign
     2155           varcur-base      = varlastcur-base
     2156           varcur-road-tax  = varlastcur-road-tax
     2157           varcur-excise    = varlastcur-excise
     2158         .
     2159       end.
     2160       else do:
     2161         assign
     2162           varcur-base      = varcur-base      / varcur-fact-qnty
     2163           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     2164           varcur-excise    = varcur-excise    / varcur-fact-qnty
     2165         .
     2166       end.
     2167       if varcur-vat-pc = ?
     2168       then do:
     2169         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     2170       end.
     2171       if varcur-slt-pc = ?
     2172       then do:
     2173         return error substitute ("Нет текущего продажного НП по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     2174       end.
     2175       find first bf_sysconf where bf_sysconf.host-code = bf_trn-doc.host-code no-lock.
     2176       assign
     2177         varcur-cons-vat-pc = bf_sysconf.cons-vat-pc.
     2178       if varcur-cons-vat-pc = ? then do:
     2179         return error substitute ("Нет текущего продажного консигнационного НДС по фирме &1", bf_trn-doc.host-code).
     2180       end.
     2181       define buffer buf_tt-clcparts for tt-clcparts .
     2182       for each buf_tt-clcparts
     2183       on error undo, return error return-value
     2184       :
     2185         delete buf_tt-clcparts.
     2186       end.
     2187       for each bf_parts no-lock
     2188         where bf_parts.out-code  = bf_doc-line.doc-code
     2189           and bf_parts.obj-type  = bf_doc-line.obj-type
     2190           and bf_parts.obj-code  = bf_doc-line.obj-code
     2191           and bf_parts.artic     = bf_doc-line.artic
     2192           and bf_parts.prod-type = bf_doc-line.prod-type
     2193           and bf_parts.prod-code = bf_doc-line.prod-code
     2194       on error undo, return error return-value
     2195       :
     2196         create buf_tt-clcparts .
     2197         buffer-copy bf_parts to buf_tt-clcparts .
     2198         if v-calcbypart = yes   then do:
     2199   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partbcod in g#library
     2200     (buffer bf_parts
     2201     ,output v-b-pcode
     2202     ) no-error .
     2203   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2204   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2205     (input  bf_parts.obj-type
     2206     ,input  bf_parts.obj-code
     2207     ,input  v-b-pcode
     2208     ,input  0
     2209     ,input  bf_trn-doc.fact-order
     2210     ,output vardoc-num
     2211     ,output varprice-salef
     2212     ,output varroad-tax
     2213     ,output varexcise
     2214     ) no-error .
     2215             if varprice-sale = ?
     2216             then do:
     2217               assign
     2218                 varprice-salef = 0
     2219                 varroad-tax   = 0
     2220                 varexcise     = 0
     2221               .
     2222             end.
     2223             assign
     2224             part-cur-base  = varprice-salef
     2225             part-cur-road-tax  = varroad-tax
     2226             part-cur-excise = varexcise.
     2227         end.
     2228       end.
     2229       run clcprtsl_calc-ttable in this-procedure
     2230         (input yes,
     2231          input yes,
     2232          input bf_doc-line.road-tax,
     2233          input bf_doc-line.excise,
     2234          input bf_doc-line.vat-pc,
     2235          input bf_doc-line.cons-vat-pc,
     2236          input bf_doc-line.slt-pc,
     2237          input bf_trn-doc.base-rate,
     2238          input bf_trn-doc.base-scale,
     2239          input varr-b,
     2240          input varcur-base,
     2241          input varcur-road-tax,
     2242          input varcur-excise,
     2243          input varcur-vat-pc,
     2244          input varcur-cons-vat-pc,
     2245          input varcur-slt-pc
     2246          ) no-error.
     2247       if error-status:error then do:
     2248         message
     2249           vss-workfile vss-revision vss-description skip
     2250           "Ошибка при вызове процедуры clcprtsl_calc-ttable." skip
     2251           return-value skip
     2252           trim(error-status :get-message(1))
     2253           trim(error-status :get-message(2))
     2254           trim(error-status :get-message(3))
     2255           trim(error-status :get-message(4))
     2256           trim(error-status :get-message(5)) skip
     2257           view-as alert-box error.
     2258         undo, return error .
     2259       end.
     2260     end.
     2261   end.
     2262   end.
     2263   procedure clcprtsl_calc-ttable :
     2264   define input parameter paris-doc           as   logical                 no-undo.
     2265   define input parameter paris-cur           as   logical                 no-undo.
     2266   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     2267   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     2268   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     2269   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     2270   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     2271   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     2272   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     2273   define input parameter parr-b              as   character               no-undo.
     2274   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     2275   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     2276   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     2277   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     2278   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     2279   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     2280   define buffer bf_tt-allsum      for tt-allsum.
     2281   define buffer bf_tt-clcparts    for tt-clcparts.
     2282   define buffer bf_tt-allsum-line for tt-allsum-line.
     2283   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     2284   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     2285   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     2286   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     2287   define variable varexcise          like ub.price-list.excise     no-undo.
     2288   do on error undo, return error return-value :
     2289   for each bf_tt-allsum-line
     2290   on error undo, return error return-value
     2291    :
     2292     delete bf_tt-allsum-line.
     2293   end.
     2294   for each bf_tt-allsum
     2295   on error undo, return error return-value
     2296   :
     2297     delete bf_tt-allsum.
     2298   end.
     2299   for each bf_tt-clcparts
     2300   on error undo, return error return-value
     2301   :
     2302   if v-calcbypart then do:
     2303             assign
     2304             parcur-base =   bf_tt-clcparts.part-cur-base
     2305             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     2306             parcur-excise =   bf_tt-clcparts.part-cur-excise
     2307             .
     2308   end.
     2309      run clcprtsl_calc-parts in this-procedure (
     2310        input recid(bf_tt-clcparts),
     2311        input paris-doc,
     2312        input paris-cur,
     2313        input parroad-tax,
     2314        input parexcise,
     2315        input parvat-pc,
     2316        input parcons-vat-pc,
     2317        input parslt-pc,
     2318        input parbase-rate,
     2319        input parbase-scale,
     2320        input parr-b,
     2321        input parcur-base,
     2322        input parcur-road-tax,
     2323        input parcur-excise,
     2324        input parcur-vat-pc,
     2325        input parcurcons-vat-pc,
     2326        input parcurslt-pc
     2327        ) no-error.
     2328     if error-status:error then do:
     2329       message
     2330         vss-workfile vss-revision vss-description skip
     2331         vss-include-info3 skip
     2332         "Ошибка при обсчете партии" skip
     2333         "Документ партии " bf_tt-clcparts.out-code skip
     2334         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     2335         return-value skip
     2336         error-status:get-message(1) skip
     2337         error-status:get-message(2) skip
     2338         error-status:get-message(3) skip
     2339         view-as alert-box error .
     2340       undo, return error .
     2341     end.
     2342     for each bf_tt-allsum on error undo, return error return-value :
     2343       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     2344       if not available bf_tt-allsum-line then do:
     2345         create bf_tt-allsum-line.
     2346         assign
