     2045       create bfos_tt-allsum-line.
     2046       assign
     2047         bfos_tt-allsum-line.sum-type = 'сумма_по_услуге_со_знаком':U.
     2048       buffer-copy bfs_tt-allsum-line except bfs_tt-allsum-line.sum-type to bfos_tt-allsum-line.
     2049     end.
     2050     else do:
     2051       assign
     2052         varlastcur-base      = 0
