     1423     bf_tt-allsum.dsc-base-doc       =  (if discnt-base-salecl          = ? then 0 else discnt-base-salecl          * cl_tt-clcparts.fact-qnty)
     1424     bf_tt-allsum.dsc-rubl-doc       =  (if discnt-rubl-salecl          = ? then 0 else discnt-rubl-salecl          * cl_tt-clcparts.fact-qnty)
     1425     bf_tt-allsum.slt-base-doc       =  (if slt-base-salecl             = ? then 0 else slt-base-salecl             * cl_tt-clcparts.fact-qnty)
     1426     bf_tt-allsum.slt-rubl-doc       =  (if slt-rubl-salecl             = ? then 0 else slt-rubl-salecl             * cl_tt-clcparts.fact-qnty)
     1427     bf_tt-allsum.vat-base-buyer-doc =  (if vat-base-buyercl            = ? then 0 else vat-base-buyercl            * cl_tt-clcparts.fact-qnty)
     1428     bf_tt-allsum.vat-rubl-buyer-doc =  (if vat-rubl-buyercl            = ? then 0 else vat-rubl-buyercl            * cl_tt-clcparts.fact-qnty)
     1429     bf_tt-allsum.road-tax-base-doc  =  (if road-tax-base-salecl        = ? then 0 else road-tax-base-salecl        * cl_tt-clcparts.fact-qnty)
     1430     bf_tt-allsum.road-tax-rubl-doc  =  (if road-tax-rubl-salecl        = ? then 0 else road-tax-rubl-salecl        * cl_tt-clcparts.fact-qnty)
     1431     bf_tt-allsum.excise-base-doc    =  (if excise-base-salecl          = ? then 0 else excise-base-salecl          * cl_tt-clcparts.fact-qnty)
     1432     bf_tt-allsum.excise-rubl-doc    =  (if excise-rubl-salecl          = ? then 0 else excise-rubl-salecl          * cl_tt-clcparts.fact-qnty)
     1433     bf_tt-allsum.sum-dsc-base-cur   =  (if price-base-with-tax-salecur = ? then 0 else price-base-with-tax-salecur * cl_tt-clcparts.fact-qnty)
     1434     bf_tt-allsum.sum-dsc-rubl-cur   =  (if price-rubl-with-tax-salecur = ? then 0 else price-rubl-with-tax-salecur * cl_tt-clcparts.fact-qnty)
     1435     bf_tt-allsum.dsc-base-cur       =  (if discnt-base-salecur         = ? then 0 else discnt-base-salecur         * cl_tt-clcparts.fact-qnty)
     1436     bf_tt-allsum.dsc-rubl-cur       =  (if discnt-rubl-salecur         = ? then 0 else discnt-rubl-salecur         * cl_tt-clcparts.fact-qnty)
     1437     bf_tt-allsum.slt-base-cur       =  (if slt-base-salecur            = ? then 0 else slt-base-salecur            * cl_tt-clcparts.fact-qnty)
     1438     bf_tt-allsum.slt-rubl-cur       =  (if slt-rubl-salecur            = ? then 0 else slt-rubl-salecur            * cl_tt-clcparts.fact-qnty)
     1439     bf_tt-allsum.vat-base-buyer-cur =  (if vat-base-buyercur           = ? then 0 else vat-base-buyercur           * cl_tt-clcparts.fact-qnty)
     1440     bf_tt-allsum.vat-rubl-buyer-cur =  (if vat-rubl-buyercur           = ? then 0 else vat-rubl-buyercur           * cl_tt-clcparts.fact-qnty)
     1441     bf_tt-allsum.road-tax-base-cur  =  (if road-tax-base-salecur       = ? then 0 else road-tax-base-salecur       * cl_tt-clcparts.fact-qnty)
     1442     bf_tt-allsum.road-tax-rubl-cur  =  (if road-tax-rubl-salecur       = ? then 0 else road-tax-rubl-salecur       * cl_tt-clcparts.fact-qnty)
     1443     bf_tt-allsum.excise-base-cur    =  (if excise-base-salecur         = ? then 0 else excise-base-salecur         * cl_tt-clcparts.fact-qnty)
     1444     bf_tt-allsum.excise-rubl-cur    =  (if excise-rubl-salecur         = ? then 0 else excise-rubl-salecur         * cl_tt-clcparts.fact-qnty)
     1445     .
     1446   if cl_tt-clcparts.purch-code = integer('2':U) then do:
     1447     assign
     1448       bf_tt-allsum.vat-base-doc = (if out-vatp-have-vat-sltcur <> yes then 0 else (price-base-with-tax-salecl  - road-tax-base-salecl  - slt-base-salecl  - (cl_tt-clcparts.price-base - cl_tt-clcparts.road-tax-base)) * parcons-vat-pc / (100 + parcons-vat-pc) * cl_tt-clcparts.fact-qnty)
     1449       bf_tt-allsum.vat-rubl-doc = (if out-vatp-have-vat-sltcur <> yes then 0 else (price-rubl-with-tax-salecl  - road-tax-rubl-salecl  - slt-rubl-salecl  - (cl_tt-clcparts.price-rubl - cl_tt-clcparts.road-tax-rubl)) * parcons-vat-pc / (100 + parcons-vat-pc) * cl_tt-clcparts.fact-qnty)
     1450       bf_tt-allsum.vat-base-cur = (if out-vatp-have-vat-sltcur <> yes then 0 else (price-base-with-tax-salecur - road-tax-base-salecur - slt-base-salecur - (cl_tt-clcparts.price-base - cl_tt-clcparts.road-tax-base)) * parcurcons-vat-pc / (100 + parcurcons-vat-pc) * cl_tt-clcparts.fact-qnty)
     1451       bf_tt-allsum.vat-rubl-cur = (if out-vatp-have-vat-sltcur <> yes then 0 else (price-rubl-with-tax-salecur - road-tax-rubl-salecur - slt-rubl-salecur - (cl_tt-clcparts.price-rubl - cl_tt-clcparts.road-tax-rubl)) * parcurcons-vat-pc / (100 + parcurcons-vat-pc) * cl_tt-clcparts.fact-qnty)
     1452       .
     1453   end.
     1454   else do:
     1455     assign
     1456       bf_tt-allsum.vat-base-doc = (if out-vatp-have-vat-sltcur <> yes then 0 else (price-base-with-tax-salecl  - road-tax-base-salecl  - slt-base-salecl ) * parvat-pc / (100 + parvat-pc) * cl_tt-clcparts.fact-qnty)
     1457       bf_tt-allsum.vat-rubl-doc = (if out-vatp-have-vat-sltcur <> yes then 0 else (price-rubl-with-tax-salecl  - road-tax-rubl-salecl  - slt-rubl-salecl ) * parvat-pc / (100 + parvat-pc) * cl_tt-clcparts.fact-qnty)
     1458       bf_tt-allsum.vat-base-cur = (if out-vatp-have-vat-sltcur <> yes then 0 else (price-base-with-tax-salecur - road-tax-base-salecur - slt-base-salecur) * parcurvat-pc / (100 + parcurvat-pc) * cl_tt-clcparts.fact-qnty)
     1459       bf_tt-allsum.vat-rubl-cur = (if out-vatp-have-vat-sltcur <> yes then 0 else (price-rubl-with-tax-salecur - road-tax-rubl-salecur - slt-rubl-salecur) * parcurvat-pc / (100 + parcurvat-pc) * cl_tt-clcparts.fact-qnty)
     1460       .
     1461   end.
     1462   if bf_tt-allsum.vat-base-doc = ? then bf_tt-allsum.vat-base-doc = 0.
     1463   if bf_tt-allsum.vat-rubl-doc = ? then bf_tt-allsum.vat-rubl-doc = 0.
     1464   assign
     1465     bf_tt-allsum.sum-dsc-base-acc     = (if price-base-with-tax-loccl    = ? then 0 else price-base-with-tax-loccl    * cl_tt-clcparts.fact-qnty)
     1466     bf_tt-allsum.sum-dsc-rubl-acc     = (if price-rubl-with-tax-loccl    = ? then 0 else price-rubl-with-tax-loccl    * cl_tt-clcparts.fact-qnty)
     1467     bf_tt-allsum.sum-dsc-cli-acc      = (if (price-cli-with-tax-loccl +
     1468                                              road-tax-cli-loccl       +
     1469                                              (if cl_tt-clcparts.vat-type <> 'в т. ч.':U then vat-cli-loccl else 0) +
     1470                                              (if cl_tt-clcparts.slt-type <> 'в т. ч.':U then slt-cli-loccl else 0)
     1471                                              ) / cli-base-ratecl = ? then 0
     1472                                           else
     1473                                             (price-cli-with-tax-loccl +
     1474                                              road-tax-cli-loccl       +
     1475                                              (if cl_tt-clcparts.vat-type <> 'в т. ч.':U then vat-cli-loccl else 0) +
     1476                                              (if cl_tt-clcparts.slt-type <> 'в т. ч.':U then slt-cli-loccl else 0)
     1477                                              ) / cli-base-ratecl * cl_tt-clcparts.fact-qnty)
     1478     bf_tt-allsum.dsc-base-acc         = 0
     1479     bf_tt-allsum.dsc-rubl-acc         = 0
     1480     bf_tt-allsum.dsc-cli-acc          = 0
     1481     bf_tt-allsum.vat-base-acc         = (if vat-base-loccl      = ? then 0 else vat-base-loccl      * cl_tt-clcparts.fact-qnty)
     1482     bf_tt-allsum.vat-rubl-acc         = (if vat-rubl-loccl      = ? then 0 else vat-rubl-loccl      * cl_tt-clcparts.fact-qnty)
     1483     bf_tt-allsum.vat-cli-acc          = (if vat-cli-loccl / cli-base-ratecl      = ? then 0 else vat-cli-loccl / cli-base-ratecl      * cl_tt-clcparts.fact-qnty)
     1484     bf_tt-allsum.slt-base-acc         = (if slt-base-loccl      = ? then 0 else slt-base-loccl      * cl_tt-clcparts.fact-qnty)
     1485     bf_tt-allsum.slt-rubl-acc         = (if slt-rubl-loccl      = ? then 0 else slt-rubl-loccl      * cl_tt-clcparts.fact-qnty)
     1486     bf_tt-allsum.slt-cli-acc          = (if slt-cli-loccl / cli-base-ratecl      = ? then 0 else slt-cli-loccl / cli-base-ratecl      * cl_tt-clcparts.fact-qnty)
     1487     bf_tt-allsum.road-tax-base-acc    = (if road-tax-base-loccl = ? then 0 else road-tax-base-loccl * cl_tt-clcparts.fact-qnty)
     1488     bf_tt-allsum.road-tax-rubl-acc    = (if road-tax-rubl-loccl = ? then 0 else road-tax-rubl-loccl * cl_tt-clcparts.fact-qnty)
     1489     bf_tt-allsum.road-tax-cli-acc     = (if road-tax-cli-loccl / cli-base-ratecl = ? then 0 else road-tax-cli-loccl / cli-base-ratecl * cl_tt-clcparts.fact-qnty)
     1490     bf_tt-allsum.excise-base-acc      = 0
     1491     bf_tt-allsum.excise-rubl-acc      = 0
     1492     bf_tt-allsum.excise-cli-acc       = 0
     1493     bf_tt-allsum.transport-base-acc   = (if transport-base-loccl   = ? then 0 else transport-base-loccl  * cl_tt-clcparts.fact-qnty)
     1494     bf_tt-allsum.transport-rubl-acc   = (if transport-rubl-loccl   = ? then 0 else transport-rubl-loccl  * cl_tt-clcparts.fact-qnty)
     1495     bf_tt-allsum.transport-cli-acc    = (if transport-cli-loccl / cli-base-ratecl   = ? then 0 else transport-cli-loccl / cli-base-ratecl  * cl_tt-clcparts.fact-qnty)
     1496     bf_tt-allsum.other-base-acc       = (if other-base-loccl       = ? then 0 else other-base-loccl      * cl_tt-clcparts.fact-qnty)
     1497     bf_tt-allsum.other-rubl-acc       = (if other-rubl-loccl       = ? then 0 else other-rubl-loccl      * cl_tt-clcparts.fact-qnty)
     1498     bf_tt-allsum.other-cli-acc        = (if other-cli-loccl / cli-base-ratecl       = ? then 0 else other-cli-loccl     / cli-base-ratecl  * cl_tt-clcparts.fact-qnty).
     1499   create bfs_tt-allsum.
     1500   assign
     1501     bfs_tt-allsum.sum-type = 'основная_сумма_со_знаком':U.
     1502   if pardoc-type = 'инв':U or
     1503      pardoc-type = 'при':U    or
     1504      pardoc-type = 'возврат':U    then do:
     1505      buffer-copy bf_tt-allsum except bf_tt-allsum.sum-type to bfs_tt-allsum.
     1506   end.
     1507   else do:
     1508     assign
     1509       bfs_tt-allsum.fact-qnty           =  - bf_tt-allsum.fact-qnty
     1510       bfs_tt-allsum.cli-qnty            =  - bf_tt-allsum.cli-qnty
     1511       bfs_tt-allsum.sum-dsc-base-doc    =  - bf_tt-allsum.sum-dsc-base-doc
     1512       bfs_tt-allsum.sum-dsc-rubl-doc    =  - bf_tt-allsum.sum-dsc-rubl-doc
     1513       bfs_tt-allsum.dsc-base-doc        =  - bf_tt-allsum.dsc-base-doc
     1514       bfs_tt-allsum.dsc-rubl-doc        =  - bf_tt-allsum.dsc-rubl-doc
     1515       bfs_tt-allsum.vat-base-doc        =  - bf_tt-allsum.vat-base-doc
     1516       bfs_tt-allsum.vat-rubl-doc        =  - bf_tt-allsum.vat-rubl-doc
     1517       bfs_tt-allsum.vat-base-buyer-doc  =  - bf_tt-allsum.vat-base-buyer-doc
     1518       bfs_tt-allsum.vat-rubl-buyer-doc  =  - bf_tt-allsum.vat-rubl-buyer-doc
     1519       bfs_tt-allsum.slt-base-doc        =  - bf_tt-allsum.slt-base-doc
     1520       bfs_tt-allsum.slt-rubl-doc        =  - bf_tt-allsum.slt-rubl-doc
     1521       bfs_tt-allsum.road-tax-base-doc   =  - bf_tt-allsum.road-tax-base-doc
     1522       bfs_tt-allsum.road-tax-rubl-doc   =  - bf_tt-allsum.road-tax-rubl-doc
     1523       bfs_tt-allsum.excise-base-doc     =  - bf_tt-allsum.excise-base-doc
     1524       bfs_tt-allsum.excise-rubl-doc     =  - bf_tt-allsum.excise-rubl-doc
     1525       bfs_tt-allsum.sum-dsc-base-cur    =  - bf_tt-allsum.sum-dsc-base-cur
     1526       bfs_tt-allsum.sum-dsc-rubl-cur    =  - bf_tt-allsum.sum-dsc-rubl-cur
     1527       bfs_tt-allsum.dsc-base-cur        =  - bf_tt-allsum.dsc-base-cur
     1528       bfs_tt-allsum.dsc-rubl-cur        =  - bf_tt-allsum.dsc-rubl-cur
     1529       bfs_tt-allsum.vat-base-cur        =  - bf_tt-allsum.vat-base-cur
     1530       bfs_tt-allsum.vat-rubl-cur        =  - bf_tt-allsum.vat-rubl-cur
     1531       bfs_tt-allsum.vat-base-buyer-cur  =  - bf_tt-allsum.vat-base-buyer-cur
     1532       bfs_tt-allsum.vat-rubl-buyer-cur  =  - bf_tt-allsum.vat-rubl-buyer-cur
     1533       bfs_tt-allsum.slt-base-cur        =  - bf_tt-allsum.slt-base-cur
     1534       bfs_tt-allsum.slt-rubl-cur        =  - bf_tt-allsum.slt-rubl-cur
     1535       bfs_tt-allsum.road-tax-base-cur   =  - bf_tt-allsum.road-tax-base-cur
     1536       bfs_tt-allsum.road-tax-rubl-cur   =  - bf_tt-allsum.road-tax-rubl-cur
     1537       bfs_tt-allsum.excise-base-cur     =  - bf_tt-allsum.excise-base-cur
     1538       bfs_tt-allsum.excise-rubl-cur     =  - bf_tt-allsum.excise-rubl-cur
     1539       bfs_tt-allsum.sum-dsc-base-acc    =  - bf_tt-allsum.sum-dsc-base-acc
     1540       bfs_tt-allsum.sum-dsc-rubl-acc    =  - bf_tt-allsum.sum-dsc-rubl-acc
     1541       bfs_tt-allsum.sum-dsc-cli-acc     =  - bf_tt-allsum.sum-dsc-cli-acc
     1542       bfs_tt-allsum.dsc-base-acc        =  - bf_tt-allsum.dsc-base-acc
     1543       bfs_tt-allsum.dsc-rubl-acc        =  - bf_tt-allsum.dsc-rubl-acc
     1544       bfs_tt-allsum.dsc-cli-acc         =  - bf_tt-allsum.dsc-cli-acc
     1545       bfs_tt-allsum.vat-base-acc        =  - bf_tt-allsum.vat-base-acc
     1546       bfs_tt-allsum.vat-rubl-acc        =  - bf_tt-allsum.vat-rubl-acc
     1547       bfs_tt-allsum.vat-cli-acc         =  - bf_tt-allsum.vat-cli-acc
     1548       bfs_tt-allsum.slt-base-acc        =  - bf_tt-allsum.slt-base-acc
     1549       bfs_tt-allsum.slt-rubl-acc        =  - bf_tt-allsum.slt-rubl-acc
     1550       bfs_tt-allsum.slt-cli-acc         =  - bf_tt-allsum.slt-cli-acc
     1551       bfs_tt-allsum.road-tax-base-acc   =  - bf_tt-allsum.road-tax-base-acc
     1552       bfs_tt-allsum.road-tax-rubl-acc   =  - bf_tt-allsum.road-tax-rubl-acc
     1553       bfs_tt-allsum.road-tax-cli-acc    =  - bf_tt-allsum.road-tax-cli-acc
     1554       bfs_tt-allsum.excise-base-acc     =  - bf_tt-allsum.excise-base-acc
     1555       bfs_tt-allsum.excise-rubl-acc     =  - bf_tt-allsum.excise-rubl-acc
     1556       bfs_tt-allsum.excise-cli-acc      =  - bf_tt-allsum.excise-cli-acc
     1557       bfs_tt-allsum.transport-base-acc  =  - bf_tt-allsum.transport-base-acc
     1558       bfs_tt-allsum.transport-rubl-acc  =  - bf_tt-allsum.transport-rubl-acc
     1559       bfs_tt-allsum.transport-cli-acc   =  - bf_tt-allsum.transport-cli-acc
     1560       bfs_tt-allsum.other-base-acc      =  - bf_tt-allsum.other-base-acc
     1561       bfs_tt-allsum.other-rubl-acc      =  - bf_tt-allsum.other-rubl-acc
     1562       bfs_tt-allsum.other-cli-acc       =  - bf_tt-allsum.other-cli-acc.
     1563   end.
     1564   create bfpc_tt-allsum.
     1565   create bfspc_tt-allsum.
     1566   case cl_tt-clcparts.purch-code :
     1567   when 1           then do:
     1568     assign
     1569       bfpc_tt-allsum.sum-type  = 'сумма_по_выкупу':U
     1570       bfspc_tt-allsum.sum-type = 'сумма_по_выкупу_со_знаком':U.
     1571     buffer-copy bf_tt-allsum  except bf_tt-allsum.sum-type  to bfpc_tt-allsum.
     1572     buffer-copy bfs_tt-allsum except bfs_tt-allsum.sum-type to bfspc_tt-allsum.
     1573   end.
     1574   when 4    then do:
     1575     assign
     1576       bfpc_tt-allsum.sum-type  = 'сумма_по_старой_консигнации':U
     1577       bfspc_tt-allsum.sum-type = 'сумма_по_старой_консигнации_со_знаком':U.
     1578     buffer-copy bf_tt-allsum  except bf_tt-allsum.sum-type  to bfpc_tt-allsum.
     1579     buffer-copy bfs_tt-allsum except bfs_tt-allsum.sum-type to bfspc_tt-allsum.
     1580   end.
     1581   when 3 then do:
     1582     assign
     1583       bfpc_tt-allsum.sum-type  = 'сумма_по_ответственному_хранению':U
     1584       bfspc_tt-allsum.sum-type = 'сумма_по_ответственному_хранению_со_знаком':U.
     1585     buffer-copy bf_tt-allsum  except bf_tt-allsum.sum-type  to bfpc_tt-allsum.
     1586     buffer-copy bfs_tt-allsum except bfs_tt-allsum.sum-type to bfspc_tt-allsum.
     1587   end.
     1588   when 2 then do:
     1589     assign
     1590       bfpc_tt-allsum.sum-type  = 'сумма_по_консигнации_выгода':U
     1591       bfspc_tt-allsum.sum-type = 'сумма_по_консигнации_выгода_со_знаком':U.
     1592     assign
     1593       bfpc_tt-allsum.fact-qnty           = bf_tt-allsum.fact-qnty
     1594       bfpc_tt-allsum.cli-qnty            = bf_tt-allsum.cli-qnty
     1595       bfpc_tt-allsum.sum-dsc-base-doc    = bf_tt-allsum.sum-dsc-base-doc    - bf_tt-allsum.sum-dsc-base-acc
     1596       bfpc_tt-allsum.sum-dsc-rubl-doc    = bf_tt-allsum.sum-dsc-rubl-doc    - bf_tt-allsum.sum-dsc-rubl-acc
     1597       bfpc_tt-allsum.dsc-base-doc        = bf_tt-allsum.dsc-base-doc        - bf_tt-allsum.dsc-base-acc
     1598       bfpc_tt-allsum.dsc-rubl-doc        = bf_tt-allsum.dsc-rubl-doc        - bf_tt-allsum.dsc-rubl-acc
     1599       bfpc_tt-allsum.vat-base-doc        = bf_tt-allsum.vat-base-doc
     1600       bfpc_tt-allsum.vat-rubl-doc        = bf_tt-allsum.vat-rubl-doc
     1601       bfpc_tt-allsum.vat-base-buyer-doc  = bf_tt-allsum.vat-base-buyer-doc  - bf_tt-allsum.vat-base-acc
     1602       bfpc_tt-allsum.vat-rubl-buyer-doc  = bf_tt-allsum.vat-rubl-buyer-doc  - bf_tt-allsum.vat-rubl-acc
     1603       bfpc_tt-allsum.slt-base-doc        = bf_tt-allsum.slt-base-doc        - bf_tt-allsum.slt-base-acc
     1604       bfpc_tt-allsum.slt-rubl-doc        = bf_tt-allsum.slt-rubl-doc        - bf_tt-allsum.slt-rubl-acc
     1605       bfpc_tt-allsum.road-tax-base-doc   = bf_tt-allsum.road-tax-base-doc   - bf_tt-allsum.road-tax-base-acc
     1606       bfpc_tt-allsum.road-tax-rubl-doc   = bf_tt-allsum.road-tax-rubl-doc   - bf_tt-allsum.road-tax-rubl-acc
     1607       bfpc_tt-allsum.excise-base-doc     = bf_tt-allsum.excise-base-doc
     1608       bfpc_tt-allsum.excise-rubl-doc     = bf_tt-allsum.excise-rubl-doc
     1609       bfpc_tt-allsum.sum-dsc-base-cur    = bf_tt-allsum.sum-dsc-base-cur    - bf_tt-allsum.sum-dsc-base-acc
     1610       bfpc_tt-allsum.sum-dsc-rubl-cur    = bf_tt-allsum.sum-dsc-rubl-cur    - bf_tt-allsum.sum-dsc-rubl-acc
     1611       bfpc_tt-allsum.dsc-base-cur        = bf_tt-allsum.dsc-base-cur        - bf_tt-allsum.dsc-base-acc
     1612       bfpc_tt-allsum.dsc-rubl-cur        = bf_tt-allsum.dsc-rubl-cur        - bf_tt-allsum.dsc-rubl-acc
