     2431   procedure fmtcli-get-bank :
     2432   define input parameter p-host-code      as integer          no-undo.
     2433   define input parameter p-obj-type       as character        no-undo.
     2434   define input parameter p-obj-code       as integer          no-undo.
     2435   define input parameter p-curr-code      as integer          no-undo.
     2436       define buffer buf_fin-schet     for ub.fin-schet.
     2437       define buffer buf_fin-bank      for ub.fin-bank.
     2438   do
     2439   for buf_fin-schet
     2440     , buf_fin-bank
     2441   on error undo, return error
     2442   :
     2443       assign
     2444           v-fmtcli-schet-exists       = no
     2445           v-fmtcli-bank-exists        = no
     2446           v-fmtcli-bank-r-schet       = "":U
     2447           v-fmtcli-bank-c-schet       = "":U
     2448           v-fmtcli-bank-bik           = "":U
     2449           v-fmtcli-bank-name          = "":U
     2450           v-fmtcli-bank-addres        = "":U
     2451           v-fmtcli-bank-city          = "":U
     2452       .
     2453       search-for-schet:
     2454       for each buf_fin-schet no-lock
     2455          where buf_fin-schet.host-code = p-host-code
     2456            and buf_fin-schet.cli-type  = p-obj-type
     2457            and buf_fin-schet.cli-code  = p-obj-code
     2458            and buf_fin-schet.curr-code = p-curr-code
     2459       on error undo, return error
     2460       :
     2461           if buf_fin-schet.status_   = 'удал':U
     2462           then do:
     2463           end.
     2464           else do:
     2465               assign
     2466                   v-fmtcli-schet-exists   = yes
     2467                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
     2468                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
     2469               .
     2470               find first buf_fin-bank no-lock
     2471                    where buf_fin-bank.host-code = p-host-code
     2472                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
     2473               no-error.
     2474               if available buf_fin-bank
     2475               then do:
     2476                   assign
     2477                       v-fmtcli-bank-exists      = yes
     2478                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
     2479                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
     2480                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
     2481                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
     2482                   .
     2483               end.
     2484               else do:
     2485                   assign
     2486                       v-fmtcli-bank-exists    = no
     2487                       v-fmtcli-bank-bik       = "":U
     2488                       v-fmtcli-bank-name      = "":U
     2489                       v-fmtcli-bank-addres    = "":U
     2490                       v-fmtcli-bank-city      = "":U
     2491                   .
     2492               end.
     2493               leave search-for-schet.
     2494           end.
     2495       end.
     2496   end.
     2497   end procedure.
     2498   procedure fmtcli-get-client :
     2499   define input parameter p-obj-type       as character    no-undo.
     2500   define input parameter p-obj-code       as integer      no-undo.
     2501       define variable v-temp-fmtcli-address      as character     no-undo.
     2502       define variable v-num-country-city    as integer      no-undo.
     2503       define buffer buf_clients   for ub.clients.
     2504       define buffer buf_firm      for ub.firm.
     2505       define buffer buf_store     for ub.store.
     2506       define buffer buf_shop      for ub.shop.
     2507       define buffer buf_person    for ub.person.
     2508   do
     2509   for buf_clients
     2510     , buf_firm
     2511     , buf_store
     2512     , buf_shop
     2513     , buf_person
     2514   on error undo, return error
     2515   :
     2516       assign
     2517           v-fmtcli-name           = "":U
     2518           v-fmtcli-addres         = "":U
     2519           v-fmtcli-post-addres    = "":U
     2520           v-fmtcli-full-addres    = "":U
     2521           v-fmtcli-phone          = "":U
     2522           v-fmtcli-inn            = "":U
     2523           v-fmtcli-kpp            = "":U
     2524           v-fmtcli-okpo           = "":U
     2525           v-fmtcli-city           = "":U
     2526           v-fmtcli-index          = "":U
     2527           v-fmtcli-country        = "":U
     2528       .
     2529       find first buf_clients no-lock
     2530            where buf_clients.obj-type = p-obj-type
     2531              and buf_clients.obj-code = p-obj-code
     2532       .
     2533       assign
     2534           v-fmtcli-name = buf_clients.obj-name
     2535       .
     2536       case buf_clients.obj-type:
     2537          when 'орг':U
     2538          then do:
     2539               find first buf_firm no-lock
     2540                    where buf_firm.firm-code = buf_clients.obj-code
     2541                    no-error
     2542               .
     2543               if available buf_firm
     2544               then do:
     2545                   assign
     2546                       v-num-country-city = num-entries( buf_firm.city )
     2547                       v-fmtcli-engl-name = buf_firm.engl-name
     2548                   .
     2549                   if v-num-country-city > 0
     2550                   then do:
     2551                       assign
     2552                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
     2553                       .
     2554                   end.
     2555                   if v-num-country-city > 1
     2556                   then do:
     2557                       assign
     2558                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
     2559                       .
     2560                   end.
     2561                   run fmtcli-concatenate-strings in this-procedure (
     2562                         input v-fmtcli-full-addres
     2563                       , input v-fmtcli-country
     2564                       , input ", ":U
     2565                       , input 50
     2566                       , output v-fmtcli-full-addres
     2567                   ).
     2568                   run fmtcli-concatenate-strings in this-procedure (
     2569                         input v-fmtcli-full-addres
     2570                       , input v-fmtcli-city
     2571                       , input ", ":U
     2572                       , input 50
     2573                       , output v-fmtcli-full-addres
     2574                   ).
     2575                   run fmtcli-concatenate-strings in this-procedure (
     2576                         input v-fmtcli-full-addres
     2577                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
     2578                       , input ", ":U
     2579                       , input 50
     2580                       , output v-fmtcli-full-addres
     2581                   ).
     2582                   run fmtcli-concatenate-strings in this-procedure (
     2583                         input v-fmtcli-post-addres
     2584                       , input v-fmtcli-country
     2585                       , input ", ":U
     2586                       , input 50
     2587                       , output v-fmtcli-post-addres
     2588                   ).
     2589                   run fmtcli-concatenate-strings in this-procedure (
     2590                         input v-fmtcli-post-addres
     2591                       , input v-fmtcli-city
     2592                       , input ", ":U
     2593                       , input 50
     2594                       , output v-fmtcli-post-addres
     2595                   ).
     2596                   run fmtcli-concatenate-strings in this-procedure (
     2597                         input v-fmtcli-post-addres
     2598                       , input string( buf_firm.ind )
     2599                       , input ", ":U
     2600                       , input 50
     2601                       , output v-fmtcli-post-addres
     2602                   ).
     2603                   run fmtcli-concatenate-strings in this-procedure (
     2604                         input substring( buf_firm.addres1, 1, 50 )
     2605                       , input buf_firm.addres2
     2606                       , input " ":U
     2607                       , input 50
     2608                       , output v-temp-fmtcli-address
     2609                   ).
     2610                   run fmtcli-concatenate-strings in this-procedure (
     2611                         input v-temp-fmtcli-address
     2612                       , input substring( buf_firm.addres1, 51, 50 )
     2613                       , input " ":U
     2614                       , input 50
     2615                       , output v-temp-fmtcli-address
     2616                   ).
     2617                   run fmtcli-concatenate-strings in this-procedure (
     2618                         input v-temp-fmtcli-address
     2619                       , input substring( buf_firm.addres1, 101, 50 )
     2620                       , input " ":U
     2621                       , input 50
     2622                       , output v-temp-fmtcli-address
     2623                   ).
     2624                   assign
     2625                       v-fmtcli-addres = v-temp-fmtcli-address
     2626                   .
     2627                   if buf_firm.addres1 <> ?
     2628                   then do:
     2629                       run fmtcli-concatenate-strings in this-procedure (
     2630                             input v-fmtcli-full-addres
     2631                           , input v-fmtcli-addres
     2632                           , input ", ":U
     2633                           , input 0
     2634                           , output v-fmtcli-full-addres
     2635                       ).
     2636                   end.
     2637                   run fmtcli-concatenate-strings in this-procedure (
     2638                         input substring( buf_firm.post-addr1, 1, 50 )
     2639                       , input buf_firm.post-addr2
     2640                       , input " ":U
     2641                       , input 50
     2642                       , output v-fmtcli-post-addres
     2643                   ).
     2644                   run fmtcli-concatenate-strings in this-procedure (
     2645                         input v-fmtcli-post-addres
     2646                       , input substring( buf_firm.post-addr1, 51, 50 )
     2647                       , input " ":U
     2648                       , input 50
     2649                       , output v-fmtcli-post-addres
     2650                   ).
     2651                   run fmtcli-concatenate-strings in this-procedure (
     2652                         input v-fmtcli-post-addres
     2653                       , input substring( buf_firm.post-addr1, 101, 50 )
     2654                       , input " ":U
     2655                       , input 50
     2656                       , output v-fmtcli-post-addres
     2657                   ).
     2658                   assign
     2659                       v-fmtcli-phone         = buf_firm.phone
     2660                       v-fmtcli-inn           = buf_firm.inn
     2661                       v-fmtcli-kpp           = buf_firm.kpp
     2662                       v-fmtcli-okpo          = buf_firm.okpo
     2663                       v-fmtcli-index         = string( buf_firm.ind )
     2664                   .
     2665               end.
     2666          end.
     2667          when 'маг':U
     2668          then do:
     2669               find first buf_shop no-lock
     2670                    where buf_shop.obj-code = buf_clients.obj-code
     2671               .
     2672               if available buf_shop
     2673               then do:
     2674                   run fmtcli-concatenate-strings in this-procedure (
     2675                         input buf_shop.addres1
     2676                       , input buf_shop.addres2
     2677                       , input " ":U
     2678                       , input 50
     2679                       , output v-fmtcli-addres
     2680                   ).
     2681                   assign
     2682                       v-fmtcli-full-addres = v-fmtcli-addres
     2683                       v-fmtcli-post-addres = v-fmtcli-addres
     2684                       v-fmtcli-phone       = buf_shop.phone
     2685                       v-fmtcli-inn         = "":U
     2686                       v-fmtcli-kpp         = "":U
     2687                       v-fmtcli-okpo        = "":U
     2688                       v-fmtcli-city        = "":U
     2689                       v-fmtcli-index       = "":U
     2690                   .
     2691               end.
     2692          end.
     2693          when 'скл':U
     2694          then do:
     2695               find first buf_store no-lock
     2696                    where buf_store.obj-code = buf_clients.obj-code
     2697               .
     2698               if available buf_store
     2699               then do:
     2700                   run fmtcli-concatenate-strings in this-procedure (
     2701                         input buf_store.addres1
     2702                       , input buf_store.addres2
     2703                       , input " ":U
     2704                       , input 50
     2705                       , output v-fmtcli-addres
     2706                   ).
     2707                   assign
     2708                       v-fmtcli-full-addres = v-fmtcli-addres
     2709                       v-fmtcli-phone       = buf_store.phone
     2710                       v-fmtcli-inn         = "":U
     2711                       v-fmtcli-kpp         = "":U
     2712                       v-fmtcli-okpo        = "":U
     2713                       v-fmtcli-city        = "":U
     2714                       v-fmtcli-index       = "":U
     2715                   .
     2716               end.
     2717          end.
     2718          when 'чел':U
     2719          then do:
     2720               find first buf_person no-lock
     2721                    where buf_person.psn-code = buf_clients.obj-code
     2722               .
     2723               if available buf_person
     2724               then do:
     2725                   run fmtcli-concatenate-strings in this-procedure (
     2726                         input ( if buf_person.ind = 0 or buf_person.ind = ?
     2727                                 then "":U
     2728                                 else string( buf_person.ind, "999999")
     2729                                 )
     2730                       , input buf_person.city
     2731                       , input ", ":U
     2732                       , input 0
     2733                       , output v-fmtcli-full-addres
     2734                   ).
     2735                   assign
     2736                       v-fmtcli-addres = buf_person.address
     2737                   .
     2738                   run fmtcli-concatenate-strings in this-procedure (
     2739                         input v-fmtcli-full-addres
     2740                       , input v-fmtcli-addres
     2741                       , input ", ":U
     2742                       , input 0
     2743                       , output v-fmtcli-full-addres
     2744                   ).
     2745                   assign
     2746                       v-fmtcli-phone     = buf_person.phone1
     2747                       v-fmtcli-inn       = buf_person.inn
     2748                       v-fmtcli-kpp       = buf_person.kpp
     2749                       v-fmtcli-okpo      = buf_person.okpo
     2750                       v-fmtcli-city      = buf_person.city
     2751                       v-fmtcli-index     = string( buf_person.ind )
     2752                   .
     2753               end.
     2754          end.
     2755       end case.
     2756   end.
     2757   end procedure.
     2758   procedure fmtcli-concatenate-strings :
     2759   define input parameter p-string-1       as character        no-undo.
     2760   define input parameter p-string-2       as character        no-undo.
     2761   define input parameter p-delimiter      as character        no-undo.
     2762   define input parameter p-length         as integer          no-undo.
     2763   define output parameter p-out-string    as character        no-undo.
     2764   do
     2765   on error undo, return error
     2766   :
     2767       assign
     2768           p-out-string = ( if p-string-1 = ?
     2769                            then "":U
     2770                            else trim( p-string-1 ) )
     2771       .
     2772       assign
     2773           p-out-string = p-out-string
     2774                        + ( if p-out-string = "":U
     2775                            or length( p-out-string ) = p-length
     2776                            or p-string-2 = ?
     2777                            or trim( p-string-2 ) = "":U
     2778                            then "":U
     2779                            else p-delimiter )
     2780                        + ( if p-string-2 = ?
     2781                            or trim( p-string-2 ) = "":U
     2782                            then "":U
     2783                            else trim( p-string-2 ) )
     2784       .
     2785   end.
     2786   end procedure.
     2787       define stream out-stream.
     2788       define temp-table temp_manager no-undo
     2789           field manager-id    as integer
     2790           field manager-name  as character
     2791           field sum-all-base  as decimal
     2792           field sum-all-rubl  as decimal
     2793           field sum-vat-base  as decimal
     2794           field sum-vat-rubl  as decimal
     2795           field is-selected   as logical
     2796           index pi is primary unique
     2797               manager-id
     2798       .
     2799       define temp-table temp_manager-vat no-undo
     2800           field manager-id    as integer
     2801           field vat-pc        as character
     2802           field sum-vat-base  as decimal
     2803           field sum-vat-rubl  as decimal
     2804           index pi is primary unique manager-id vat-pc
     2805       .
     2806       define variable v-host-code         as integer      no-undo.
     2807       define variable v-host-name         as character    no-undo.
     2808       define variable v-manager-name      as character    no-undo.
     2809       define variable v-operator-name     as character    no-undo.
     2810       define variable v-store-boss        as character    no-undo.
     2811       define variable v-supp-name         as character    no-undo.
     2812       define variable v-supp-inn          as character    no-undo.
     2813       define variable v-propis            as character    no-undo.
     2814       define variable v-propis-cop        as character    no-undo.
     2815       define variable v-attr-value        as character    no-undo.
     2816       define variable v-attr-type         as character    no-undo.
     2817       define variable v-factur-string     as character    no-undo.
     2818       define variable v-obj-name          as character    no-undo.
     2819       define variable g#report-num    as integer      no-undo.
     2820       define variable g#quest-print   as logical      no-undo.
     2821       define variable g#log           as logical      no-undo.
     2822       define buffer buf_trn-doc           for trn-doc.
     2823       define buffer buf_clients           for clients.
     2824       define buffer buf_store             for store.
     2825       define buffer buf_shop              for shop.
     2826       define buffer buf_temp_manager      for temp_manager.
     2827   do
     2828   for buf_trn-doc
     2829     , buf_clients
     2830     , buf_store
     2831     , buf_shop
     2832     , buf_temp_manager
     2833   on error undo, return error
     2834   :
     2835   if session :set-wait-state( "compiler" ) then.
     2836       run get-report-num in p-mainmenu-handle (
     2837           output g#report-num
     2838       ).
     2839       run get-quest-print in p-mainmenu-handle (
     2840           output g#quest-print
     2841       ).
     2842       find first buf_trn-doc no-lock
     2843            where recid( buf_trn-doc ) = p-trn-doc-recid
     2844       .
     2845       message
     2846           "Вы можете распечатать справку"
     2847           skip "по всем менеджерам"
     2848           skip "или выбрать одного менеджера."
     2849           skip(1)
     2850           skip "Распечатать справку по всем менеджерам?"
     2851       view-as alert-box buttons yes-no-cancel
     2852       update v-1 as logical.
     2853       if v-1 = ?
     2854       then do:
     2855           undo, return.
     2856       end.
     2857       if v-1 = yes
     2858       then do:
     2859           run fill-manager-list in this-procedure (
     2860                 input 'все':U
     2861               , input buf_trn-doc.doc-code
     2862           ).
     2863       end.
     2864       else do:
     2865           run fill-manager-list in this-procedure (
     2866                 input "":U
     2867               , input buf_trn-doc.doc-code
     2868           ).
     2869       end.
     2870   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2871   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2872     (input  buf_trn-doc.obj-type
     2873     ,input  buf_trn-doc.obj-code
     2874     ,output v-host-code
     2875     )  .
     2876       find first buf_clients no-lock
     2877            where buf_clients.obj-type = buf_trn-doc.obj-type
     2878              and buf_clients.obj-code = buf_trn-doc.obj-code
     2879       .
     2880       assign
     2881           v-obj-name = substitute( "Объект: &1 &2 &3"
     2882               , buf_clients.obj-type
     2883               , buf_clients.obj-code
     2884               , trim( buf_clients.obj-name ) )
     2885       .
     2886       find first buf_clients no-lock
     2887            where buf_clients.obj-type = 'орг':U
     2888              and buf_clients.obj-code = v-host-code
     2889       .
     2890       assign
     2891           v-host-name = substitute( "Фирма: &1", trim( buf_clients.obj-name ) )
     2892       .
     2893       find first buf_clients no-lock
     2894            where buf_clients.obj-type = 'чел':U
     2895              and buf_clients.obj-code = buf_trn-doc.boss
     2896       no-error.
     2897   define variable vss-include-info19 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2898   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrnick in g#library
     2899     (input  buf_trn-doc.creid
     2900     ,output v-operator-name
     2901     )  .
     2902       assign
     2903           v-manager-name  = ( if available buf_clients then trim( buf_clients.obj-name ) else "" )
     2904       .
     2905       if buf_trn-doc.obj-type = 'скл':U
     2906       then do:
     2907           find first buf_store no-lock
     2908                where buf_store.obj-code = buf_trn-doc.obj-code
     2909           .
     2910           assign
     2911               v-store-boss = trim( buf_store.store-boss )
     2912           .
     2913       end.
     2914       if buf_trn-doc.obj-type = 'маг':U
     2915       then do:
     2916           find first buf_shop no-lock
     2917                where buf_shop.obj-code = buf_trn-doc.obj-code
     2918           .
     2919           assign
     2920               v-store-boss = trim( buf_shop.store-boss )
     2921           .
     2922       end.
     2923       run fmtcli-get-client in this-procedure (
     2924             input buf_trn-doc.cli-type
     2925           , input buf_trn-doc.cli-code
     2926       ) no-error.
     2927       if error-status :error
     2928       then do:
     2929           message
     2930                    vss-workfile vss-revision vss-description
     2931               skip(1)
     2932               skip "Ошибка вычисления параметров фирмы - контрагента"
     2933               skip return-value
     2934               skip trim( error-status :get-message( 1 ) )
     2935                    trim( error-status :get-message( 2 ) )
     2936                    trim( error-status :get-message( 3 ) )
     2937           view-as alert-box error.
     2938           undo, return error substitute( "Ошибка вычисления параметров фирмы - контрагента. &1. &2"
     2939                                       , return-value
     2940                                       , trim( error-status :get-message( 1 ) ) ).
     2941       end.
     2942       assign
     2943           v-supp-name = v-fmtcli-name
     2944           v-supp-inn  = v-fmtcli-inn
     2945       .
     2946       if v-supp-inn <> "":U
     2947       then do:
     2948       assign
     2949               v-supp-inn = substitute( "ИНН: &1", v-supp-inn )
     2950       .
     2951       end.
     2952   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     2953                           input 'nsf':U ,
     2954                          output v-attr-value ,
     2955                          output v-attr-type )  .
     2956       if v-attr-value = ""
     2957       then do:
     2958           assign
     2959               v-factur-string = buf_trn-doc.ord-num
     2960           .
     2961       end.
     2962       else do:
     2963           assign
     2964               v-factur-string = v-attr-value
     2965           .
     2966   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     2967                           input 'dsf':U ,
     2968                          output v-attr-value ,
     2969                          output v-attr-type )  .
     2970           assign
     2971               v-factur-string = v-factur-string + " от " + v-attr-value
     2972           .
     2973       end.
     2974       define variable v-page-counter    as integer      no-undo.
     2975       assign
     2976           v-page-counter = 0
     2977       .
     2978   output stream out-stream to value( string( session:temp-directory +
     2979                                        "rpt" + string( g#report-num ) ) )
     2980                                        page-size  value(62) .
     2981       for each buf_temp_manager
     2982          where buf_temp_manager.is-selected = yes
     2983       :
     2984           if v-page-counter <> 0
     2985           then do:
     2986               page stream out-stream.
     2987           end.
     2988           run print-manager-page in this-procedure (
     2989                 input buf_trn-doc.doc-code
     2990               , input buf_temp_manager.manager-id
     2991           ).
     2992           assign
     2993               v-page-counter = v-page-counter + 1
     2994           .
     2995       end.
     2996       output stream out-stream close.
     2997   if session :set-wait-state( "" ) then.
     2998   if g#quest-print = false
     2999   then do:
     3000     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     3001                                         7, (if 4 >= 8 then 2 else 0), 0, 0,
     3002                                         OUTPUT g#log ).
     3003   end.
     3004   else do:
     3005     os-command silent
     3006       value( "COPY /b " +
     3007         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     3008         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     3009         string( session:temp-directory) +  "$" + string( g#report-num )
     3010                 ) .
     3011     os-command silent
     3012       value( "COPY /b " +
     3013         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     3014         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     3015         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     3016                 ) .
     3017   end.
     3018   end.
     3019   procedure fill-temp-VAT :
     3020   define input parameter p-doc-line-recid as recid            no-undo.
     3021   define input parameter p-manager-id     as integer          no-undo.
     3022       define buffer buf_parts     for parts.
     3023       define buffer buf_doc-line  for doc-line.
     3024       define buffer buf_temp_manager-vat  for temp_manager-vat.
     3025   do
     3026   for buf_parts
     3027     , buf_doc-line
     3028     , buf_temp_manager-vat
     3029   on error undo, return error
     3030   :
     3031       find first buf_doc-line no-lock
     3032            where recid( buf_doc-line ) = p-doc-line-recid
     3033       .
     3034       for each buf_parts no-lock
     3035          where buf_parts.out-code   = buf_doc-line.doc-code
     3036            and buf_parts.obj-type   = buf_doc-line.obj-type
     3037            and buf_parts.obj-code   = buf_doc-line.obj-code
     3038            and buf_parts.prod-type  = buf_doc-line.prod-type
     3039            and buf_parts.prod-code  = buf_doc-line.prod-code
     3040            and buf_parts.artic      = buf_doc-line.artic
     3041            and buf_parts.status_    = true
     3042       on error undo, return error return-value
     3043       :
     3044           find first buf_temp_manager-vat
     3045                where buf_temp_manager-vat.manager-id  = p-manager-id
     3046                  and buf_temp_manager-vat.vat-pc      = trim( string( buf_parts.VAT-pc, ">>9" ) )
     3047           no-error.
     3048           if not available buf_temp_manager-vat
     3049           then do:
     3050               create buf_temp_manager-vat.
     3051               assign
     3052                   buf_temp_manager-vat.manager-id     = p-manager-id
     3053                   buf_temp_manager-vat.vat-pc         = trim( string( buf_parts.VAT-pc, ">>9" ) )
     3054                   buf_temp_manager-vat.sum-vat-base   = 0
     3055                   buf_temp_manager-vat.sum-vat-rubl   = 0
     3056               .
     3057           end.
     3058   assign
     3059     price-rubl-with-tax-loc = buf_parts.price-rubl
     3060     price-base-with-tax-loc = buf_parts.price-base
     3061   .
     3062   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3063   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3064     (output varinvprb
     3065     )  .
     3066     if buf_parts.out-code = 'free-zone':U     or
     3067        buf_parts.out-code = 'out-zone':U   or
     3068        buf_parts.doc-type = 'акт':U then do:
     3069       assign
     3070         in-vatp-have-vat-slt = yes.
     3071     end.
     3072     else do:
     3073       find first in-vatp_doc-attr no-lock
     3074         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
     3075           and in-vatp_doc-attr.attr-code = 'envd':U
     3076         no-error .
     3077       if not available in-vatp_doc-attr then do:
     3078         assign
     3079           in-vatp-have-vat-slt = yes.
     3080       end.
     3081       else do:
     3082            in-vatp-have-vat-slt = no.
     3083       end.
     3084     end.
     3085     assign
     3086      price-cli-with-tax-loc = buf_parts.price-cli
     3087      cli-base-rate          = buf_parts.cli-base-rate.
     3088     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
     3089              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
     3090     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
     3091             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
     3092             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
     3093             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
     3094             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
     3095             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
     3096             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     3097       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     3098     assign
     3099       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
     3100     assign
     3101       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     3102       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     3103       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     3104       transport-cli-loc  = 0
     3105       other-cli-loc      = 0
     3106     .
     3107   ASSIGN
     3108             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     3109       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     3110   .
     3111           assign
     3112               buf_temp_manager-vat.sum-vat-base = buf_temp_manager-vat.sum-vat-base + ( vat-base-loc * buf_parts.fact-qnty )
     3113               buf_temp_manager-vat.sum-vat-rubl = buf_temp_manager-vat.sum-vat-rubl + ( vat-rubl-loc * buf_parts.fact-qnty )
     3114           .
     3115       end.
     3116       for each buf_temp_manager-vat
     3117          where buf_temp_manager-vat.manager-id  = p-manager-id
     3118       on error undo, return error
     3119       :
     3120           if buf_temp_manager-vat.sum-vat-base = 0
     3121           and buf_temp_manager-vat.sum-vat-rubl = 0
     3122           then do:
     3123               delete buf_temp_manager-vat.
     3124           end.
     3125       end.
     3126   end.
     3127   end procedure.
     3128   procedure fill-manager-list :
     3129   define input parameter p-mode           as character        no-undo.
     3130   define input parameter p-trn-doc-code   as character        no-undo.
     3131       define variable v-grp-code      as integer      no-undo.
     3132       define variable v-upper-code    as integer      no-undo.
     3133       define variable v-success       as logical      no-undo.
     3134       define buffer buf_doc-line              for doc-line.
     3135       define buffer buf_gds-grp               for gds-grp.
     3136       define buffer buf_goods                 for goods.
     3137       define buffer buf_temp_manager          for temp_manager.
     3138       define buffer buf_tt-allsum-line        for tt-allsum-line.
     3139   do
     3140   for buf_doc-line
     3141     , buf_gds-grp
     3142     , buf_goods
     3143     , buf_temp_manager
     3144     , buf_tt-allsum-line
     3145   on error undo, return error
     3146   :
     3147       for each buf_doc-line no-lock
     3148          where buf_doc-line.doc-code = p-trn-doc-code
     3149       on error undo, return error
     3150       :
     3151           find first buf_goods no-lock
     3152                   where buf_goods.artic      = buf_doc-line.artic
     3153                   and buf_goods.prod-type  = buf_doc-line.prod-type
     3154                   and buf_goods.prod-code  = buf_doc-line.prod-code
     3155           .
     3156           find first buf_gds-grp no-lock
     3157                   where buf_gds-grp.node-code = buf_goods.grp-code
     3158           .
     3159           assign
     3160               v-upper-code = buf_gds-grp.upper-code
     3161           .
     3162           do while buf_gds-grp.lvl-num > 1
     3163           on error undo, return error
     3164           :
     3165               find first buf_gds-grp no-lock
     3166                       where buf_gds-grp.node-code = v-upper-code
     3167               .
     3168               assign
     3169                   v-upper-code = buf_gds-grp.upper-code
     3170               .
     3171           end.
     3172           if buf_gds-grp.lvl-num = 1
     3173           then do:
     3174               find first buf_temp_manager
     3175                    where buf_temp_manager.manager-id = buf_gds-grp.node-code
     3176               no-error.
     3177               if not available buf_temp_manager
     3178               then do:
     3179                   create buf_temp_manager.
     3180                   assign
     3181                       buf_temp_manager.manager-id     = buf_gds-grp.node-code
     3182                       buf_temp_manager.manager-name   = buf_gds-grp.node-name
     3183                       buf_temp_manager.sum-all-base   = 0
     3184                       buf_temp_manager.sum-all-rubl   = 0
     3185                       buf_temp_manager.is-selected       = no
     3186                   .
     3187               end.
     3188               run clcprtsl_calc-line in this-procedure (
     3189                   input recid( buf_doc-line )
     3190               ).
     3191               find first buf_tt-allsum-line
     3192                       where buf_tt-allsum-line.sum-type = 'основная_сумма':U
     3193               .
     3194               assign
     3195                   buf_temp_manager.sum-all-base        = buf_temp_manager.sum-all-base + buf_tt-allsum-line.sum-dsc-base-acc
     3196                   buf_temp_manager.sum-all-rubl        = buf_temp_manager.sum-all-rubl + buf_tt-allsum-line.sum-dsc-rubl-acc
     3197               .
     3198               run fill-temp-vat in this-procedure (
     3199                     input recid( buf_doc-line )
     3200                   , input buf_temp_manager.manager-id
     3201               ).
     3202           end.
     3203       end.
     3204       if p-mode = 'все':U
     3205       then do:
     3206           for each buf_temp_manager
     3207           on error undo, return error
     3208           :
     3209               assign
     3210                   buf_temp_manager.is-selected = yes
     3211               .
     3212           end.
     3213       end.
     3214       else do:
     3215           run rep/r-spravd.w (
     3216                 input p-trn-doc-code
     3217               , output v-grp-code
     3218               , output v-success
     3219           ).
     3220           if v-success = yes
     3221           then do:
     3222               find first buf_temp_manager
     3223                    where buf_temp_manager.manager-id = v-grp-code
     3224               .
     3225               assign
     3226                   buf_temp_manager.is-selected     = yes
     3227               .
     3228           end.
     3229       end.
     3230   end.
     3231   end procedure.
     3232   procedure print-manager-page :
     3233   define input parameter p-trn-doc-code   as character        no-undo.
     3234   define input parameter p-manager-id     as integer          no-undo.
     3235       define variable v-sum-all    as decimal      no-undo.
     3236       define variable v-sum-vat    as decimal      no-undo.
     3237       define buffer buf_trn-doc           for trn-doc.
     3238       define buffer buf_temp_manager      for temp_manager.
     3239       define buffer buf_temp_manager-vat  for temp_manager-vat.
     3240   do
     3241   for buf_trn-doc
     3242     , buf_temp_manager
     3243     , buf_temp_manager-vat
     3244   on error undo, return error
     3245   :
     3246       find first buf_trn-doc no-lock
     3247            where buf_trn-doc.doc-code = p-trn-doc-code
     3248       .
     3249       find first buf_temp_manager
     3250            where buf_temp_manager.manager-id = p-manager-id
     3251       .
     3252       assign
     3253           v-sum-all = ( if PrintRubl then buf_temp_manager.sum-all-rubl else buf_temp_manager.sum-all-base )
     3254       .
     3255       put stream out-stream
     3256           skip
     3257           p-fmt-align-string( v-host-name, 124, 'right':U )
     3258                                                       format "X(124)"
     3259           skip
     3260           p-fmt-align-string( v-obj-name, 124, 'right':U )
     3261                                                       format "X(124)"
     3262           skip(2) space( 5 )
     3263               "Срок оплаты: ___________________"
     3264           skip(1) space( 5 )
     3265               "Менеджер:    "
     3266               buf_temp_manager.manager-name           format "X(124)"
     3267           skip(2)
     3268               p-fmt-align-string( substitute( "С П Р А В К А    &1", p-trn-doc-code ) , 124, 'center':U )
     3269                                                       format "X(124)"
     3270           skip(1) space( 5 )
     3271               p-fmt-align-string( v-supp-name, 124, 'center':U )
     3272                                                       format "X(124)"
     3273           skip    space( 5 )
     3274               p-fmt-align-string( v-supp-inn, 124, 'center':U )
     3275                                                       format "X(124)"
     3276           skip(1) space( 5 )
     3277               "Товар на сумму: "
     3278               string( v-sum-all, ">>>>>>>>>9.99" )   format "X(13)"
     3279               space( 1 )
     3280               ( if PrintRubl then "РУБ" else "баз.вал" )
     3281       .
     3282       if PrintRubl
     3283       then do:
     3284           run rep/wp-rub.p (
     3285                 input v-sum-all
     3286               , output v-propis
     3287               , output v-propis-cop
     3288           ).
     3289           put stream out-stream
     3290               space(2)
     3291               "( " + v-propis + " )"  format "X(100)"
     3292           .
     3293       end.
     3294       put stream out-stream
     3295           skip space( 5 )
     3296               space( 4 ) "по фактуре: "
     3297               v-factur-string         format "X(100)"
     3298       .
     3299       find first buf_temp_manager-vat
     3300            where buf_temp_manager-vat.manager-id = p-manager-id
     3301       no-error.
     3302       if not available buf_temp_manager-vat
     3303       then do:
     3304           put stream out-stream
     3305               skip space( 5 )
     3306                   space( 8 ) "без НДС"
     3307           .
     3308       end.
     3309       else do:
     3310           put stream out-stream
     3311               skip space( 5 )
     3312                    space( 8 ) "в том числе:"
     3313           .
     3314           for each buf_temp_manager-vat
     3315              where buf_temp_manager-vat.manager-id = p-manager-id
     3316           on error undo, return error
     3317           :
     3318               put stream out-stream
     3319                   skip space( 5 )
     3320                       substitute( "                    НДС &1%:    &2 &3"
     3321                               , buf_temp_manager-vat.vat-pc
     3322                               , string( ( if PrintRubl
     3323                                   then buf_temp_manager-vat.sum-vat-rubl
     3324                                   else buf_temp_manager-vat.sum-vat-base ), ">>>,>>>,>>9.99" )
     3325                               , ( if PrintRubl then "РУБ" else "баз.вал" )
     3326                       )                                                   format "X(110)"
     3327               .
     3328           end.
     3329       end.
     3330       put stream out-stream
     3331           skip( 2 ) space( 5 )
     3332               "Зав. магазином: "                    at 50
     3333               v-store-boss    format "X(60)"
     3334       .
     3335   end.
     3336   end procedure.
