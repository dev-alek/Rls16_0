     1943         bf_tt-allsum-line.vat-rubl-doc         =  bf_tt-allsum-line.vat-rubl-buyer-doc
     1944         bf_tt-allsum-line.dsc-base-cur         =  0
     1945         bf_tt-allsum-line.dsc-rubl-cur         =  0
     1946         bf_tt-allsum-line.slt-base-cur         =  bf_tt-allsum-line.sum-dsc-base-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1947         bf_tt-allsum-line.slt-rubl-cur         =  bf_tt-allsum-line.sum-dsc-rubl-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1948         bf_tt-allsum-line.vat-base-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-base-cur - bf_tt-allsum-line.slt-base-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1949         bf_tt-allsum-line.vat-rubl-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-rubl-cur - bf_tt-allsum-line.slt-rubl-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1950         bf_tt-allsum-line.road-tax-base-cur    =  0
     1951         bf_tt-allsum-line.road-tax-rubl-cur    =  0
     1952         bf_tt-allsum-line.excise-base-cur      =  0
     1953         bf_tt-allsum-line.excise-rubl-cur      =  0
