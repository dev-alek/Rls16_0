     1859   define variable varprice-salef as decimal   no-undo .
     1860   define buffer bf_trn-doc             for ub.trn-doc.
     1861   define buffer bf_doc-line            for ub.doc-line.
     1862   define buffer bf_gds-dtl             for ub.gds-dtl.
     1863   define buffer bf_goods               for ub.goods.
     1864   define buffer bf_parts               for ub.parts.
     1865   define buffer bf_sysconf             for ub.sysconf.
     1866   define buffer bf_tt-allsum-line      for tt-allsum-line.
     1867   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     1868   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     1869   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     1870   define buffer buf_parts        for ub.parts.
     1871   v-calcbypart = no.
     1872   do on error undo, return error return-value :
     1873   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1874   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1875     (output varr-b
     1876     )  .
     1877     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     1878     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     1879     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     1880                               bf_goods.prod-type = bf_doc-line.prod-type and
     1881                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     1882     if bf_trn-doc.fact-date <> ?        then do:
     1883       assign v-tax-date = bf_trn-doc.fact-date.
     1884     end.
     1885     else do:
     1886       assign v-tax-date = ?.
     1887     end.
     1888   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1889   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1890     (input  bf_goods.gds-code
     1891     ,input  '1':U
     1892     ,input  v-tax-date
     1893     ,input  bf_trn-doc.host-code
     1894     ,input  bf_trn-doc.obj-type
     1895     ,input  bf_trn-doc.obj-code
