      467   define new global shared variable g#attr-lib  as handle no-undo .
      468   define variable v-attr-lib-variable as handle no-undo .
      469   procedure gds-attr-name :
      470     define input  parameter p-code           as character no-undo .
      471     define output parameter p-type           as character no-undo .
      472     define output parameter p-format         as character no-undo .
      473     define output parameter p-label          as character no-undo .
      474     define output parameter p-user-can-edit  as logical   no-undo .
      475     define output parameter p-output-display as logical   no-undo .
      476     define output parameter p-other          as character no-undo .
      477     do
      478     on error undo, return error
      479     :
      480           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-name in g#attr-lib
      481         (input  p-code
      482         ,output p-type
      483         ,output p-format
      484         ,output p-label
      485         ,output p-user-can-edit
      486         ,output p-output-display
      487         ,output p-other
      488         ) no-error .
      489       if error-status :error
      490       then do:
      491         undo, return error return-value .
      492       end.
      493     end.
      494   end procedure.
      495   procedure gds-attr-tooltip :
      496     define input  parameter p-code    as character no-undo .
      497     define output parameter p-tooltip as character no-undo .
      498     define output parameter p-label   as character no-undo .
      499     do
      500     on error undo, return error
      501     :
      502           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-tooltip in g#attr-lib
      503         (input  p-code
      504         ,output p-tooltip
      505         ,output p-label
      506         ) no-error .
