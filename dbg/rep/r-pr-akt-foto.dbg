     1935   run search-full-path-Report(input v-report-name-html).
     1936   run Report-Viewer(input v-full-path-RepView, input v-report-name-html).
     1937    function fnc-DD-MM-YYYY returns character
     1938   (input p-dat-date as date):
     1939       define variable result as character no-undo.
     1940       define variable p-str-date as character no-undo.
     1941       p-str-date = replace(string(p-dat-date,'99.99.9999'), "/", ".").
     1942           return p-str-date.
     1943   end function.
     1944   function fnc-convert-dot-to-colon returns character
     1945       (input p-data as decimal, input p-accur as character):
     1946       define variable result       as character no-undo.
     1947       define variable v-str-result as character no-undo.
     1948       p-data = round(p-data, 2).
     1949       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     1950       return v-str-result.
     1951   end function.
     1952   procedure create-file:
     1953       define input parameter p-file-name as character no-undo.
     1954       output to value(string(p-file-name)).
     1955       output close.
     1956   end procedure.
     1957   procedure search-full-path-Report:
     1958       define input parameter p-file-name as character no-undo.
     1959       if search(p-file-name) = ? then
     1960       do:
     1961           message "Не найден файл отчёта: " p-file-name view-as alert-box error.
     1962       end.
     1963       else
     1964       do:
     1965           p-file-name = search(p-file-name).
     1966       end.
     1967   end procedure.
     1968   procedure define-full-path-Report:
     1969       define input parameter p-rep-num as integer no-undo.
     1970       define output parameter p-file-name-rep-htm as character no-undo.
     1971       p-file-name-rep-htm = session:temp-directory + "rpt" + string(p-rep-num) + ".html".
     1972   end procedure.
     1973   procedure Report-Viewer:
     1974       define input parameter p-full-path-RepView as character no-undo.
     1975       define input parameter p-file-name-rep-htm as character no-undo.
     1976       os-command no-wait value(p-full-path-RepView + " true " + search(p-file-name-rep-htm)).
     1977   end procedure.
     1978   procedure get-full-path-RepViewer:
     1979       define output parameter p-fill-path-RepView as character no-undo.
     1980       if search("exe\ReportViewer\reportviewer.exe") <> ? then
     1981       do:
     1982           p-fill-path-RepView = search("exe\ReportViewer\reportviewer.exe").
     1983       end.
     1984       else
     1985       do:
     1986           message "Не найдена программа просмотра отчёта!" view-as alert-box error.
     1987       end.
     1988   end procedure.
