      880   define variable b2-sum_1  as   decimal  format "->>>>>>>>>>>9.<<<" no-undo.
      881   define variable b2-sum_2  as   decimal  format "->>>>>>>>>>>9.<<<" no-undo.
      882   define variable bi-sum_1  as   decimal  format "->>>>>>>>>>>9.<<<" no-undo.
      883   define variable bi-sum_2  as   decimal  format "->>>>>>>>>>>9.<<<" no-undo.
      884   define variable bo-sum_1  as   decimal  format "->>>>>>>>>>>9.<<<" no-undo.
      885   define variable bo-sum_2  as   decimal  format "->>>>>>>>>>>9.<<<" no-undo.
      886   PROCEDURE ostatok :
      887   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
      888   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
      889   def input parameter x-tog-shift   as   logical             no-undo.
      890   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
      891   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
      892   def input parameter x-shift-start as integer               no-undo.
      893   def input parameter x-shift-end   as integer               no-undo.
      894   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
      895   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
      896   def input parameter xTog-obj   as log no-undo.
      897   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
      898   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
      899   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
      900   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
      901   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
      902   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
      903   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
      904   def var              Fact-orderS   as char  no-undo.
      905   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
      906      Assign
      907         Fact-order   = 0
      908         Quantity     = 0
      909         Coast_R      = 0
      910         Coast_V      = 0
      911         VAT_R        = 0
      912         VAT_V        = 0 .
      913    x-date-start-t  = x-date-start + 1 .
      914   IF x-date-end = date('') then DO:
      915      Fact-order = 0 .
      916      for each obj-list
      917          where  ( not xtog-obj or
      918                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
      919                 no-lock :
      920         if  x-tog-shift = false then do:
      921                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
      922                               ub.stk-tot.Fact-date <=  x-date-start
      923                               and ub.stk-tot.shift-num = 0
      924                               USE-INDEX fact-date no-lock no-error .
      925              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
      926         End.
      927         Else  DO :
      928             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
      929              (ub.stk-tot.shift-date  = x-date-start-t and
      930               ub.stk-tot.shift-num  < x-shift-start or
      931               ub.stk-tot.shift-date  < x-date-start-t  )
      932               and ub.stk-tot.shift-num  > 0
      933               USE-INDEX Shift-num no-lock no-error .
      934            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
      935           END.
      936       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
      937     End.
      938   End.
      939   Else DO:
      940     For each obj-list  WHERE
      941        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
      942         no-lock :
      943      IF  x-TOG-Shift = False Then DO:
      944          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
      945               ub.stk-tot.Fact-date <= x-date-end
      946               and ub.stk-tot.shift-num = 0
      947               USE-INDEX fact-date no-lock no-error.
      948          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
      949      END.
      950      Else DO:
      951           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
      952               (ub.stk-tot.shift-date  = x-date-end and
      953               ub.stk-tot.shift-num  <= x-shift-end or
      954               ub.stk-tot.shift-date  < x-date-end       ) and
      955               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
      956               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
      957       End.
      958       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
      959     End.
      960   End.
      961   END PROCEDURE.
      962   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      963   define stream ahtlog .
      964   define temp-table temp-aht-ot-tot no-undo like ub.aht-ot-tot .
      965   define temp-table temp-aht-ot-line no-undo like ub.aht-ot-line .
      966   define temp-table temp-aht-stk-tot no-undo like ub.aht-stk-tot .
      967   define temp-table temp-aht-stk-line no-undo like ub.aht-stk-line .
      968   procedure aht_get-sum-type :
      969     define input  parameter p-aht-type        as character no-undo .
      970     define output parameter p-allsum-sum-type as character no-undo .
      971     do
      972     on error undo, return error return-value
      973     :
      974       case p-aht-type :
      975         when 'r':U then do:
      976           assign
      977             p-allsum-sum-type = 'сумма_по_выкупу_со_знаком':U
      978           .
      979         end.
      980         when 'c':U then do:
      981           assign
      982             p-allsum-sum-type = 'сумма_по_консигнации_закупка_со_знаком':U
      983           .
      984         end.
      985         when 'b':U then do:
      986           assign
      987             p-allsum-sum-type = 'сумма_по_консигнации_выгода_со_знаком':U
      988           .
      989         end.
      990         when 's':U then do:
      991           assign
      992             p-allsum-sum-type = 'сумма_по_ответственному_хранению_со_знаком':U
      993           .
      994         end.
      995         when 'o':U then do:
      996           assign
      997             p-allsum-sum-type = 'сумма_по_старой_консигнации_со_знаком':U
      998           .
      999         end.
     1000         when 'v':U then do:
     1001           assign
     1002             p-allsum-sum-type = 'сумма_по_услуге_со_знаком':U
     1003           .
     1004         end.
     1005         otherwise do:
     1006           message
     1007             vss-workfile vss-revision vss-description skip
     1008             vss-include-info9 skip
     1009             "Неизвестное значение типа приобретения" skip
     1010             "Тип приобретения" p-aht-type skip
     1011             view-as alert-box error .
     1012           undo, return error .
     1013         end.
     1014       end.
     1015     end.
     1016   end procedure.
     1017   procedure aht_get-stk-sum-type :
     1018     define input  parameter p-ot-sum-type      as character no-undo .
     1019     define input  parameter p-ext-doc-type     as character no-undo .
     1020     define output parameter p-stk-ext-sum-type as character no-undo .
     1021     do
     1022     on error undo, return error return-value
     1023     :
     1024       assign
     1025         p-stk-ext-sum-type = p-ot-sum-type + p-ext-doc-type
     1026       .
     1027     end.
     1028   end procedure.
