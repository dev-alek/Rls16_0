     1398   procedure aht_add-document :
     1399     define input  parameter p-doc-code     like ub.aht-doc.doc-code     no-undo .
     1400     define input  parameter p-obj-type     like ub.aht-doc.obj-type     no-undo .
     1401     define input  parameter p-obj-code     like ub.aht-doc.obj-code     no-undo .
     1402     define input  parameter p-ext-doc-type like ub.aht-doc.ext-doc-type no-undo .
     1403     define input  parameter p-is-trn-doc   like ub.aht-doc.is-trn-doc   no-undo .
     1404     define input  parameter p-fact-order   like ub.aht-doc.fact-order   no-undo .
     1405     define input  parameter p-fact-date    like ub.aht-doc.fact-date    no-undo .
     1406     define input  parameter p-shift-date   like ub.aht-doc.shift-date   no-undo .
     1407     define input  parameter p-shift-num    like ub.aht-doc.shift-num    no-undo .
     1408     define buffer buf_aht-doc for ub.aht-doc .
     1409     do
     1410     on error undo, return error return-value
     1411     :
     1412       find first buf_aht-doc exclusive-lock
     1413         where buf_aht-doc.doc-code = p-doc-code
     1414         no-error .
     1415       if available buf_aht-doc then do:
     1416         message
     1417           vss-workfile vss-revision vss-description skip
     1418           vss-include-info9 skip
     1419           "Попытка повторного создания записи" skip
     1420           "Документ" p-doc-code skip
     1421           view-as alert-box error .
     1422         undo, return error .
     1423       end.
     1424       if p-fact-order = ?
     1425       or p-fact-order = 0
     1426       then do:
     1427         message
     1428           vss-workfile vss-revision vss-description skip
     1429           vss-include-info9 skip
     1430           "Ошибка задания входных параметров" skip
     1431           "Не задан номер документа" skip
     1432           "Документ" p-doc-code skip
     1433           "Номер документа" p-fact-order skip
     1434           view-as alert-box error .
     1435         undo, return error .
     1436       end.
     1437       create buf_aht-doc .
     1438       assign
     1439         buf_aht-doc.doc-code     = p-doc-code
     1440         buf_aht-doc.obj-type     = p-obj-type
     1441         buf_aht-doc.obj-code     = p-obj-code
     1442         buf_aht-doc.ext-doc-type = p-ext-doc-type
     1443         buf_aht-doc.is-trn-doc   = p-is-trn-doc
     1444         buf_aht-doc.fact-order   = p-fact-order
     1445         buf_aht-doc.fact-date    = p-fact-date
     1446         buf_aht-doc.shift-date   = p-shift-date
     1447         buf_aht-doc.shift-num    = p-shift-num
     1448       .
     1449     end.
     1450   end procedure.
     1451   procedure aht_add-date :
     1452     define input  parameter p-obj-type     like ub.aht-stk.obj-type     no-undo .
     1453     define input  parameter p-obj-code     like ub.aht-stk.obj-code     no-undo .
     1454     define input  parameter p-stk-type     like ub.aht-stk.stk-type     no-undo .
     1455     define input  parameter p-fact-order   like ub.aht-stk.fact-order   no-undo .
     1456     define input  parameter p-fact-date    like ub.aht-stk.fact-date    no-undo .
     1457     define input  parameter p-shift-date   like ub.aht-stk.shift-date   no-undo .
     1458     define input  parameter p-shift-num    like ub.aht-stk.shift-num    no-undo .
     1459     define buffer buf_aht-stk for ub.aht-stk .
     1460     do
     1461     on error undo, return error return-value
     1462     :
     1463       find first buf_aht-stk no-lock
     1464         where buf_aht-stk.obj-type   = p-obj-type
     1465           and buf_aht-stk.obj-code   = p-obj-code
     1466           and buf_aht-stk.stk-type   = p-stk-type
     1467           and buf_aht-stk.fact-order = p-fact-order
     1468         no-error .
     1469       if not available buf_aht-stk then do:
     1470         create buf_aht-stk .
     1471         assign
     1472           buf_aht-stk.obj-type   = p-obj-type
     1473           buf_aht-stk.obj-code   = p-obj-code
     1474           buf_aht-stk.stk-type   = p-stk-type
     1475           buf_aht-stk.fact-order = p-fact-order
     1476           buf_aht-stk.fact-date  = p-fact-date
     1477           buf_aht-stk.shift-date = p-shift-date
     1478           buf_aht-stk.shift-num  = p-shift-num
     1479         .
     1480       end.
     1481     end.
     1482   end procedure.
     1483   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1484   PROCEDURE aht-ostatok :
     1485   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     1486   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     1487   def input parameter x-tog-shift   as   logical             no-undo.
     1488   def input parameter x-date-start  like ub.aht-stk.Fact-date   no-undo.
     1489   def input parameter x-date-end    like ub.aht-stk.Fact-date   no-undo.
     1490   def input parameter x-shift-start as integer               no-undo.
     1491   def input parameter x-shift-end   as integer               no-undo.
     1492   def input parameter x-sum-type    like ub.aht-stk.stk-type    no-undo.
     1493   def input parameter xTog-obj   as log no-undo.
     1494   def output parameter Fact-order  like ub.aht-stk.Fact-order  no-undo.
     1495   def var              Fact-order#   like ub.aht-stk.Fact-order  no-undo.
     1496   def var              Fact-orderS   as char  no-undo.
     1497   def var x-date-start-t  like ub.aht-stk.shift-date   no-undo.
     1498       Assign
     1499         Fact-order   = 0
     1500        .
     1501    x-date-start-t  = x-date-start + 1 .
     1502   IF x-date-end = date('') then DO:
     1503      Fact-order = 0 .
     1504      For each obj-list
     1505          WHERE  (NOT xTog-obj OR
     1506                 (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     1507                 no-lock :
     1508         IF  x-TOG-Shift = False Then DO:
     1509                          find last ub.aht-stk where ub.aht-stk.obj-type = obj-list.obj-type and                                             ub.aht-stk.obj-code = obj-list.obj-code and                                             ub.aht-stk.stk-type = x-sum-type
     1510                               and ub.aht-stk.Fact-date <=  x-date-start
     1511                               and ub.aht-stk.shift-num = 0
     1512                               USE-INDEX obj-date no-lock no-error .
     1513              if Available ub.aht-stk THEN  Assign  Fact-order#  = ub.aht-stk.Fact-order .
     1514         End.
     1515         Else  DO :
     1516             find last ub.aht-stk where ub.aht-stk.obj-type = obj-list.obj-type and                                             ub.aht-stk.obj-code = obj-list.obj-code and                                             ub.aht-stk.stk-type = x-sum-type and
     1517               (ub.aht-stk.shift-date  = x-date-start-t and
     1518               ub.aht-stk.shift-num  < x-shift-start or
     1519               ub.aht-stk.shift-date  < x-date-start-t  )
     1520               and ub.aht-stk.shift-num  > 0
     1521               USE-INDEX obj-Shift no-lock no-error .
     1522            If Available ub.aht-stk then  Assign  Fact-order#  = ub.aht-stk.Fact-order .
     1523           END.
     1524       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     1525     End.
     1526   End.
     1527   Else DO:
     1528     For each obj-list  WHERE
     1529        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     1530         no-lock :
     1531      IF  x-TOG-Shift = False Then DO:
     1532          find last ub.aht-stk where ub.aht-stk.obj-type = obj-list.obj-type and                                             ub.aht-stk.obj-code = obj-list.obj-code and                                             ub.aht-stk.stk-type = x-sum-type and
     1533               ub.aht-stk.Fact-date <= x-date-end
     1534               and ub.aht-stk.shift-num = 0
     1535               USE-INDEX obj-date no-lock no-error.
     1536          If Available ub.aht-stk then  Assign  Fact-order#  = ub.aht-stk.Fact-order .
     1537      END.
     1538      Else DO:
     1539           find last ub.aht-stk where ub.aht-stk.obj-type = obj-list.obj-type and                                             ub.aht-stk.obj-code = obj-list.obj-code and                                             ub.aht-stk.stk-type = x-sum-type and
     1540               (ub.aht-stk.shift-date  = x-date-end and
     1541               ub.aht-stk.shift-num  <= x-shift-end or
     1542               ub.aht-stk.shift-date  < x-date-end       ) and
     1543               ub.aht-stk.shift-num   > 0      use-index obj-Shift no-lock no-error.
     1544               if Available ub.aht-stk THEN Assign  Fact-order#  = ub.aht-stk.Fact-order .
     1545       End.
     1546       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     1547     End.
     1548   End.
     1549   END PROCEDURE.
     1550   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1551   procedure proc-alt-shift-f2:
     1552     if not ibs.th.gbl.gbl-var:rcode
     1553   then
     1554     run gbl\inidebug.p .
     1555   end.
     1556   procedure proc-alt-shift-f3:
     1557     run gbl/prvssinf.p
     1558       ( input this-procedure
     1559       ) .
     1560   end.
     1561   define variable v-inform-launched as logical no-undo initial false .
     1562   procedure proc-alt-shift-f4:
     1563     define variable v-action as character no-undo .
     1564     if v-inform-launched = false then do:
     1565       assign
     1566         v-inform-launched = true
     1567       .
     1568       run gbl/d-inform.w
     1569         (  input self
     1570         ,  input this-procedure
     1571         , output v-action
     1572         ) no-error .
     1573       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     1574       assign
     1575         v-inform-launched = false
     1576       .
     1577     end.
     1578   end.
     1579   procedure proc-alt-f1:
     1580     run gbl/corrhelp.p
     1581       (input this-procedure
     1582       ) .
     1583   end .
     1584   on alt-shift-f2 anywhere do:
     1585     run proc-alt-shift-f2.
     1586   end.
     1587   on alt-shift-f3 anywhere do:
     1588     run proc-alt-shift-f3 in this-procedure .
     1589   end.
     1590   on alt-shift-f4 anywhere do:
     1591     run proc-alt-shift-f4 in this-procedure.
     1592   end.
     1593   on alt-f1 anywhere do:
     1594     run proc-alt-f1 in this-procedure .
     1595   end.
