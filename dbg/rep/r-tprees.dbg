     1107   procedure aht_update-stk-table :
     1108     define input  parameter p-fact-order     like ub.trn-doc.fact-order   no-undo .
     1109     define input  parameter p-cut-fact-order like ub.trn-doc.fact-order   no-undo .
     1110     define input  parameter p-ext-doc-type   like ub.trn-doc.ext-doc-type no-undo .
     1111     define input  parameter p-trn-doc        as logical   no-undo .
     1112     define buffer buf_temp-aht-ot-tot for temp-aht-ot-tot .
     1113     define buffer buf_temp-aht-ot-line for temp-aht-ot-line .
     1114     define variable v-stk-ext-sum-type as character no-undo .
     1115     do
     1116     on error undo, return error
     1117     :
     1118       for each buf_temp-aht-ot-tot
     1119       on error undo, return error
     1120       :
     1121         run aht_get-stk-sum-type in this-procedure
     1122           (input  buf_temp-aht-ot-tot.sum-type
     1123           ,input  p-ext-doc-type
     1124           ,output v-stk-ext-sum-type
     1125           ) .
     1126         run aht_store-stk-tot in this-procedure
     1127           (buffer buf_temp-aht-ot-tot
     1128           ,input buf_temp-aht-ot-tot.sum-type
     1129           ,input p-fact-order
     1130           ,input p-cut-fact-order
     1131           ,input p-ext-doc-type
     1132           ,input false
     1133           ) .
     1134         run aht_store-stk-tot in this-procedure
     1135           (buffer buf_temp-aht-ot-tot
     1136           ,input v-stk-ext-sum-type
     1137           ,input p-fact-order
     1138           ,input p-cut-fact-order
     1139           ,input p-ext-doc-type
     1140           ,input p-trn-doc
     1141           ) .
     1142       end.
     1143       for each buf_temp-aht-ot-line
     1144       on error undo, return error
     1145       :
     1146         run aht_get-stk-sum-type in this-procedure
     1147           (input  buf_temp-aht-ot-line.sum-type
     1148           ,input  p-ext-doc-type
     1149           ,output v-stk-ext-sum-type
     1150           ) .
     1151         run aht_store-stk-line in this-procedure
     1152           (buffer buf_temp-aht-ot-line
     1153           ,input buf_temp-aht-ot-line.sum-type
     1154           ,input p-fact-order
     1155           ,input p-cut-fact-order
     1156           ,input p-ext-doc-type
     1157           ,input false
     1158           ) .
     1159         run aht_store-stk-line in this-procedure
     1160           (buffer buf_temp-aht-ot-line
     1161           ,input v-stk-ext-sum-type
     1162           ,input p-fact-order
     1163           ,input p-cut-fact-order
     1164           ,input p-ext-doc-type
     1165           ,input p-trn-doc
     1166           ) .
     1167       end.
     1168     end.
     1169   end procedure.
     1170   procedure aht_store-stk-tot :
     1171     define parameter buffer buf_temp-aht-ot-tot for temp-aht-ot-tot .
     1172     define input  parameter p-stk-sum-type      as character no-undo .
     1173     define input  parameter p-fact-order        like ub.trn-doc.fact-order   no-undo .
     1174     define input  parameter p-cut-fact-order    like ub.trn-doc.fact-order   no-undo .
     1175     define input  parameter p-ext-doc-type      like ub.trn-doc.ext-doc-type no-undo .
     1176     define input  parameter p-update-sale       as logical   no-undo .
     1177     define buffer buf_aht-stk-tot for ub.aht-stk-tot .
     1178     define buffer new-buf_aht-stk-tot for ub.aht-stk-tot .
     1179     do
     1180     on error undo, return error return-value
     1181     :
     1182       find last buf_aht-stk-tot exclusive-lock
     1183         where buf_aht-stk-tot.obj-type   = buf_temp-aht-ot-tot.obj-type
     1184           and buf_aht-stk-tot.obj-code   = buf_temp-aht-ot-tot.obj-code
     1185           and buf_aht-stk-tot.sum-type   = p-stk-sum-type
     1186           and buf_aht-stk-tot.fact-order <= p-fact-order
     1187         use-index category
     1188         no-error .
     1189       if not available buf_aht-stk-tot
     1190       or buf_aht-stk-tot.fact-order <> p-fact-order
     1191       then do:
     1192         create new-buf_aht-stk-tot .
     1193         assign
     1194           new-buf_aht-stk-tot.obj-type   = buf_temp-aht-ot-tot.obj-type
     1195           new-buf_aht-stk-tot.obj-code   = buf_temp-aht-ot-tot.obj-code
     1196           new-buf_aht-stk-tot.fact-order = p-fact-order
     1197           new-buf_aht-stk-tot.sum-type   = p-stk-sum-type
     1198         .
     1199         if available buf_aht-stk-tot then do:
     1200           assign
     1201             new-buf_aht-stk-tot.fact-qnty = buf_aht-stk-tot.fact-qnty
     1202                                                                         new-buf_aht-stk-tot.cost-sum-base       = buf_aht-stk-tot.cost-sum-base             new-buf_aht-stk-tot.cost-sum-rubl       = buf_aht-stk-tot.cost-sum-rubl             new-buf_aht-stk-tot.cost-vat-base       = buf_aht-stk-tot.cost-vat-base             new-buf_aht-stk-tot.cost-vat-rubl       = buf_aht-stk-tot.cost-vat-rubl             new-buf_aht-stk-tot.cost-slt-base       = buf_aht-stk-tot.cost-slt-base             new-buf_aht-stk-tot.cost-slt-rubl       = buf_aht-stk-tot.cost-slt-rubl             new-buf_aht-stk-tot.cost-road-tax-base  = buf_aht-stk-tot.cost-road-tax-base        new-buf_aht-stk-tot.cost-road-tax-rubl  = buf_aht-stk-tot.cost-road-tax-rubl        new-buf_aht-stk-tot.cost-excise-base    = buf_aht-stk-tot.cost-excise-base          new-buf_aht-stk-tot.cost-excise-rubl    = buf_aht-stk-tot.cost-excise-rubl          new-buf_aht-stk-tot.cost-transport-base = buf_aht-stk-tot.cost-transport-base       new-buf_aht-stk-tot.cost-transport-rubl = buf_aht-stk-tot.cost-transport-rubl       new-buf_aht-stk-tot.cost-other-base     = buf_aht-stk-tot.cost-other-base           new-buf_aht-stk-tot.cost-other-rubl     = buf_aht-stk-tot.cost-other-rubl           new-buf_aht-stk-tot.cost-discnt-base    = buf_aht-stk-tot.cost-discnt-base          new-buf_aht-stk-tot.cost-discnt-rubl    = buf_aht-stk-tot.cost-discnt-rubl
     1203                                                                         new-buf_aht-stk-tot.crsa-sum-base       = buf_aht-stk-tot.crsa-sum-base             new-buf_aht-stk-tot.crsa-sum-rubl       = buf_aht-stk-tot.crsa-sum-rubl             new-buf_aht-stk-tot.crsa-vat-base       = buf_aht-stk-tot.crsa-vat-base             new-buf_aht-stk-tot.crsa-vat-rubl       = buf_aht-stk-tot.crsa-vat-rubl             new-buf_aht-stk-tot.crsa-slt-base       = buf_aht-stk-tot.crsa-slt-base             new-buf_aht-stk-tot.crsa-slt-rubl       = buf_aht-stk-tot.crsa-slt-rubl             new-buf_aht-stk-tot.crsa-road-tax-base  = buf_aht-stk-tot.crsa-road-tax-base        new-buf_aht-stk-tot.crsa-road-tax-rubl  = buf_aht-stk-tot.crsa-road-tax-rubl        new-buf_aht-stk-tot.crsa-excise-base    = buf_aht-stk-tot.crsa-excise-base          new-buf_aht-stk-tot.crsa-excise-rubl    = buf_aht-stk-tot.crsa-excise-rubl          new-buf_aht-stk-tot.crsa-transport-base = buf_aht-stk-tot.crsa-transport-base       new-buf_aht-stk-tot.crsa-transport-rubl = buf_aht-stk-tot.crsa-transport-rubl       new-buf_aht-stk-tot.crsa-other-base     = buf_aht-stk-tot.crsa-other-base           new-buf_aht-stk-tot.crsa-other-rubl     = buf_aht-stk-tot.crsa-other-rubl           new-buf_aht-stk-tot.crsa-discnt-base    = buf_aht-stk-tot.crsa-discnt-base          new-buf_aht-stk-tot.crsa-discnt-rubl    = buf_aht-stk-tot.crsa-discnt-rubl
     1204           .
     1205           if p-update-sale then do:
     1206             assign
     1207                                                                                       new-buf_aht-stk-tot.sale-sum-base       = buf_aht-stk-tot.sale-sum-base             new-buf_aht-stk-tot.sale-sum-rubl       = buf_aht-stk-tot.sale-sum-rubl             new-buf_aht-stk-tot.sale-vat-base       = buf_aht-stk-tot.sale-vat-base             new-buf_aht-stk-tot.sale-vat-rubl       = buf_aht-stk-tot.sale-vat-rubl             new-buf_aht-stk-tot.sale-slt-base       = buf_aht-stk-tot.sale-slt-base             new-buf_aht-stk-tot.sale-slt-rubl       = buf_aht-stk-tot.sale-slt-rubl             new-buf_aht-stk-tot.sale-road-tax-base  = buf_aht-stk-tot.sale-road-tax-base        new-buf_aht-stk-tot.sale-road-tax-rubl  = buf_aht-stk-tot.sale-road-tax-rubl        new-buf_aht-stk-tot.sale-excise-base    = buf_aht-stk-tot.sale-excise-base          new-buf_aht-stk-tot.sale-excise-rubl    = buf_aht-stk-tot.sale-excise-rubl          new-buf_aht-stk-tot.sale-transport-base = buf_aht-stk-tot.sale-transport-base       new-buf_aht-stk-tot.sale-transport-rubl = buf_aht-stk-tot.sale-transport-rubl       new-buf_aht-stk-tot.sale-other-base     = buf_aht-stk-tot.sale-other-base           new-buf_aht-stk-tot.sale-other-rubl     = buf_aht-stk-tot.sale-other-rubl           new-buf_aht-stk-tot.sale-discnt-base    = buf_aht-stk-tot.sale-discnt-base          new-buf_aht-stk-tot.sale-discnt-rubl    = buf_aht-stk-tot.sale-discnt-rubl
     1208             .
     1209           end.
     1210         end.
     1211       end.
     1212       if p-stk-sum-type <> 'v':U
     1213       then do:
     1214         for each buf_aht-stk-tot exclusive-lock
     1215           where buf_aht-stk-tot.obj-type   = buf_temp-aht-ot-tot.obj-type
     1216             and buf_aht-stk-tot.obj-code   = buf_temp-aht-ot-tot.obj-code
     1217             and buf_aht-stk-tot.sum-type   = p-stk-sum-type
     1218             and buf_aht-stk-tot.fact-order >= p-fact-order
     1219             and buf_aht-stk-tot.fact-order <= p-cut-fact-order
     1220         :
     1221           assign
     1222             buf_aht-stk-tot.fact-qnty = buf_aht-stk-tot.fact-qnty + buf_temp-aht-ot-tot.fact-qnty
