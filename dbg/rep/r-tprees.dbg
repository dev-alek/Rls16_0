     1070   procedure aht_update-ot-tot :
     1071     define input  parameter p-obj-type            like ub.trn-doc.obj-type     no-undo .
     1072     define input  parameter p-obj-code            like ub.trn-doc.obj-code     no-undo .
     1073     define input  parameter p-fact-order          like ub.trn-doc.fact-order   no-undo .
     1074     define input  parameter p-ext-doc-type        like ub.trn-doc.ext-doc-type no-undo .
     1075     define buffer buf_temp-aht-ot-line for temp-aht-ot-line .
     1076     define buffer buf_temp-aht-ot-tot for temp-aht-ot-tot .
     1077     do
     1078     on error undo, return error
     1079     :
     1080       for each buf_temp-aht-ot-line
     1081       on error undo, return error
     1082       :
     1083         find first buf_temp-aht-ot-tot
     1084           where buf_temp-aht-ot-tot.doc-code = buf_temp-aht-ot-line.doc-code
     1085             and buf_temp-aht-ot-tot.sum-type = buf_temp-aht-ot-line.sum-type
     1086           no-error .
     1087         if not available buf_temp-aht-ot-tot then do:
     1088           create buf_temp-aht-ot-tot .
     1089           assign
     1090             buf_temp-aht-ot-tot.doc-code     = buf_temp-aht-ot-line.doc-code
     1091             buf_temp-aht-ot-tot.sum-type     = buf_temp-aht-ot-line.sum-type
     1092             buf_temp-aht-ot-tot.ext-doc-type = p-ext-doc-type
     1093             buf_temp-aht-ot-tot.obj-type     = p-obj-type
     1094             buf_temp-aht-ot-tot.obj-code     = p-obj-code
     1095             buf_temp-aht-ot-tot.fact-order   = p-fact-order
     1096           .
     1097         end.
     1098         assign
     1099           buf_temp-aht-ot-tot.fact-qnty = buf_temp-aht-ot-tot.fact-qnty + buf_temp-aht-ot-line.fact-qnty
