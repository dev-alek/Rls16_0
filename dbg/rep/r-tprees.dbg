     1671   procedure get-font-ini :
     1672     do
     1673     on error undo, return error return-value
     1674     :
     1675   define variable ii as integer   no-undo .
     1676   define variable v-font7 as character no-undo .
     1677   define variable v-font as character no-undo .
     1678   define variable loc-name as character no-undo .
     1679   define variable loc-size as character no-undo .
     1680   define variable loc-type as character no-undo .
     1681   define variable old_H as integer   no-undo .
     1682   define variable old_w as integer   no-undo .
     1683   define variable old-row  as integer   no-undo .
     1684   define variable old-col  as integer   no-undo .
     1685   define variable old-row-lans  as integer   no-undo .
     1686   define variable old-col-lans  as integer   no-undo .
     1687   define variable vv as integer   no-undo .
     1688   empty temp-table temp-font.
     1689     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     1690       case num-entries (v-font7) :
     1691         when 4 then do:
     1692             assign
     1693               loc-name = entry ( 1 , v-font7 )
     1694               loc-size = entry ( 2 , v-font7 )
     1695               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     1696             .
     1697         end.
     1698         when 3 then do:
     1699             assign
     1700               loc-name = entry ( 1 , v-font7 )
     1701               loc-size = entry ( 2 , v-font7 )
     1702               loc-type = entry ( 3 , v-font7 )
     1703             .
     1704         end.
     1705         when 2 then  do:
     1706             assign
     1707               loc-name = entry ( 1 , v-font7 )
     1708               loc-size = entry ( 2 , v-font7 )
     1709               loc-type = ""
     1710             .
     1711         end.
     1712         when 1 then do:
     1713             assign
     1714               loc-name = trim(entry ( 1 , v-font7 ))
     1715               loc-size = ""
     1716               loc-type = ""
     1717             .
     1718         end.
     1719       end case.
     1720     create temp-font.
     1721     assign
     1722       temp-font.fontnum  = 7
     1723       temp-font.fontname = trim(loc-name)
     1724       temp-font.fontsize = trim(loc-size)
     1725       temp-font.fonttype = trim(loc-type)
     1726       temp-font.v-row    = 62
     1727       temp-font.v-col    = 136
     1728       temp-font.v-row-lans = 43
     1729       temp-font.v-col-lans = 198
     1730     .
     1731     repeat ii = 16 to 100 :
     1732       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     1733       if v-font = "" or v-font = ? then leave.
     1734       case num-entries (v-font) :
     1735         when 4 then do:
     1736             assign
     1737               loc-name = entry ( 1 , v-font )
     1738               loc-size = entry ( 2 , v-font )
     1739               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     1740             .
     1741         end.
     1742         when 3 then do:
     1743             assign
     1744               loc-name = entry ( 1 , v-font )
     1745               loc-size = entry ( 2 , v-font )
     1746               loc-type = entry ( 3 , v-font )
     1747             .
     1748         end.
     1749         when 2 then do:
     1750             assign
     1751               loc-name = entry ( 1 , v-font )
     1752               loc-size = entry ( 2 , v-font )
     1753               loc-type = ""
     1754             .
     1755         end.
     1756         when 1 then do:
     1757             assign
     1758               loc-name = trim(entry ( 1 , v-font ))
     1759               loc-size = ""
     1760               loc-type = ""
     1761             .
     1762         end.
     1763       end case.
     1764     create temp-font.
     1765     assign
     1766       temp-font.fontnum  = ii
     1767       temp-font.fontname = trim(loc-name)
     1768       temp-font.fontsize = trim(loc-size)
     1769       temp-font.fonttype = trim(loc-type)
     1770     .
     1771     end.
     1772       for each temp-font :
     1773          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     1774          if  vv = ? then vv =  0 .
     1775           run rep/exfont.p (
     1776             input   temp-font.fontname ,
     1777             input   vv ,
     1778             input   temp-font.fonttype ,
     1779             output  temp-font.font-h   ,
     1780             output  temp-font.font-w   )
     1781           .
     1782       end.
     1783   find first temp-font where  temp-font.fontnum  = 7  .
     1784   old_H = temp-font.font-H .
     1785   old_w = temp-font.font-W .
     1786   old-row = temp-font.v-row .
     1787   old-col = temp-font.v-col .
     1788   old-row-lans = temp-font.v-row-lans .
     1789   old-col-lans = temp-font.v-col-lans .
     1790       for each temp-font where
     1791                temp-font.fontnum  <> 7 :
     1792           assign
     1793               temp-font.v-row    = old_H * old-row / temp-font.font-h
     1794               temp-font.v-col    = old_W * old-col / temp-font.font-W
     1795               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     1796               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     1797           .
     1798       end.
     1799     end.
     1800   end procedure.
     1801   PROCEDURE How-name :
     1802   define input  parameter h as integer no-undo .
     1803   define input  parameter w as integer no-undo .
     1804   define output parameter n as character  no-undo .
     1805   define variable A4port-H as integer   no-undo init 63.
     1806   define variable A4port-W as integer   no-undo init 136.
     1807   define variable A4lans-H as integer   no-undo init 43.
     1808   define variable A4lans-W as integer   no-undo init 198.
     1809   define variable Strim-W  as integer   no-undo init 278.
     1810   run define-a4-size (
     1811        input ReportFontNum
     1812       ,output A4port-H
     1813       ,output A4port-W
     1814       ,output A4lans-H
     1815       ,output A4lans-W ).
     1816   If w >= 1 and w <= A4port-W Then DO:
     1817     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1818     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     1819     If h > A4port-H              Then n = "to-file":U.
     1820   End.
     1821   If w > A4port-W and w <= A4lans-W Then DO:
     1822     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1823     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1824     If h > A4port-H              Then n = "to-file":U.
     1825   End.
     1826   If w > A4lans-W and w <= Strim-W Then DO:
     1827     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     1828     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1829     If h > A4port-H              Then n = "to-file":U.
     1830   End.
     1831   If w > Strim-W Then DO:
     1832      n = "to-file":U.
     1833   End.
     1834   END PROCEDURE.
     1835   PROCEDURE define-a4-size :
     1836   define input  parameter p-ReportFontNum as integer   no-undo .
     1837   define output parameter A4port-H as integer   no-undo .
     1838   define output parameter A4port-W as integer   no-undo .
     1839   define output parameter A4lans-H as integer   no-undo .
     1840   define output parameter A4lans-W as integer   no-undo .
     1841   if not can-find (first temp-font ) then do:
     1842      run get-font-ini .
     1843   end.
     1844   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     1845   if available temp-font then do:
     1846   assign
     1847     A4port-H = temp-font.v-row
     1848     A4port-W = temp-font.v-col
     1849     A4lans-H = temp-font.v-row-lans
     1850     A4lans-W = temp-font.v-col-lans
     1851   .
     1852   end.
     1853   else do:
     1854   assign
     1855     A4port-H = 63
     1856     A4port-W = 136
     1857     A4lans-H = 43
     1858     A4lans-W = 198
     1859   .
     1860   end.
     1861   END PROCEDURE.
