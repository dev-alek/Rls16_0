     1235   procedure aht_store-stk-line :
     1236     define parameter buffer buf_temp-aht-ot-line for temp-aht-ot-line .
     1237     define input  parameter p-stk-sum-type   as character no-undo .
     1238     define input  parameter p-fact-order     like ub.trn-doc.fact-order   no-undo .
     1239     define input  parameter p-cut-fact-order like ub.trn-doc.fact-order   no-undo .
     1240     define input  parameter p-ext-doc-type   like ub.trn-doc.ext-doc-type no-undo .
     1241     define input  parameter p-update-sale    as logical   no-undo .
     1242     define buffer buf_aht-stk-line for ub.aht-stk-line .
     1243     define buffer new-buf_aht-stk-line for ub.aht-stk-line .
     1244     do
     1245     on error undo, return error return-value
     1246     :
     1247       find last buf_aht-stk-line exclusive-lock
     1248         where buf_aht-stk-line.obj-type   = buf_temp-aht-ot-line.obj-type
     1249           and buf_aht-stk-line.obj-code   = buf_temp-aht-ot-line.obj-code
     1250           and buf_aht-stk-line.gds-code   = buf_temp-aht-ot-line.gds-code
     1251           and buf_aht-stk-line.sum-type   = p-stk-sum-type
     1252           and buf_aht-stk-line.fact-order <= p-fact-order
     1253         use-index category
     1254         no-error .
     1255       if not available buf_aht-stk-line
     1256       or buf_aht-stk-line.fact-order <> p-fact-order
     1257       then do:
     1258         create new-buf_aht-stk-line .
     1259         assign
     1260           new-buf_aht-stk-line.obj-type   = buf_temp-aht-ot-line.obj-type
     1261           new-buf_aht-stk-line.obj-code   = buf_temp-aht-ot-line.obj-code
     1262           new-buf_aht-stk-line.gds-code   = buf_temp-aht-ot-line.gds-code
     1263           new-buf_aht-stk-line.fact-order = p-fact-order
     1264           new-buf_aht-stk-line.sum-type   = p-stk-sum-type
     1265         .
     1266         if available buf_aht-stk-line then do:
     1267           assign
     1268             new-buf_aht-stk-line.fact-qnty = buf_aht-stk-line.fact-qnty
