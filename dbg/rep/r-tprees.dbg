     2501   PROCEDURE CalcItog :
     2502       run aht-ostatok (
     2503           input x-store-code     ,
     2504           input x-store-type     ,
     2505           input x-tog-shift      ,
     2506           input x-date-start - 1 ,
     2507           input date('')         ,
     2508           input x-shift-start    ,
     2509           input x-shift-end      ,
     2510           input "n"    ,
     2511           input xtog-obj         ,
     2512           output  fact-order-1 ) .
     2513       run aht-ostatok (
     2514           input x-store-code  ,
     2515           input x-store-type  , x-tog-shift,
     2516           input x-date-start  ,
     2517           input x-date-end    , x-shift-start,x-shift-end,
     2518           input "n" ,
     2519           input xtog-obj ,
     2520           output  fact-order-2 ).
     2521     find last  ub.aht-stk-tot where
     2522               ub.aht-stk-tot.obj-type   = x-store-type and
     2523               ub.aht-stk-tot.obj-code   = x-store-code and
     2524               ub.aht-stk-tot.sum-type   = x-type-pr    and
     2525               ub.aht-stk-tot.fact-order <= fact-order-1
     2526               no-lock use-index pi  no-error .
     2527        if available ub.aht-stk-tot then do:
     2528        assign
     2529           Quantity1  = ub.aht-stk-tot.fact-qnty
     2530           Coast_R1   = ub.aht-stk-tot.cost-sum-rubl
     2531           Coast_V1   = ub.aht-stk-tot.cost-sum-base
     2532           VAT_R1     = ub.aht-stk-tot.cost-vat-rubl
     2533           VAT_V1     = ub.aht-stk-tot.cost-vat-base
     2534           Coast_R3   = ub.aht-stk-tot.crsa-sum-rubl
     2535           Coast_V3   = ub.aht-stk-tot.crsa-sum-base
     2536           VAT_R3     = ub.aht-stk-tot.crsa-vat-rubl
     2537           VAT_V3     = ub.aht-stk-tot.crsa-vat-base
     2538        .
     2539        end.
     2540     find last  ub.aht-stk-tot where
     2541                ub.aht-stk-tot.obj-type   = x-store-type and
     2542                ub.aht-stk-tot.obj-code   = x-store-code and
     2543                ub.aht-stk-tot.sum-type   = x-type-pr    and
     2544                ub.aht-stk-tot.fact-order <=  fact-order-2
     2545                no-lock use-index pi no-error .
     2546          if available ub.aht-stk-tot then do:
     2547          assign
     2548             Quantity2 = ub.aht-stk-tot.fact-qnty
     2549             Coast_R2  = ub.aht-stk-tot.cost-sum-rubl
     2550             Coast_V2  = ub.aht-stk-tot.cost-sum-base
     2551             VAT_R2    = ub.aht-stk-tot.cost-vat-rubl
     2552             VAT_V2    = ub.aht-stk-tot.cost-vat-base
     2553             Coast_R4  = ub.aht-stk-tot.crsa-sum-rubl
     2554             Coast_V4  = ub.aht-stk-tot.crsa-sum-base
     2555             VAT_R4    = ub.aht-stk-tot.crsa-vat-rubl
     2556             VAT_V4    = ub.aht-stk-tot.crsa-vat-base
     2557          .
     2558         end.
     2559       Assign
     2560         Coast1        = if tPrintRubl then Coast_R1 else  Coast_V1
     2561         Coast-vat1    = if tPrintRubl then VAT_R1   else  VAT_V1
     2562         Coast2        = if tPrintRubl then Coast_R2 else  Coast_V2
     2563         Coast-vat2    = if tPrintRubl then VAT_R2   else  VAT_V2
     2564         Coast3        = if tPrintRubl then Coast_R3 else  Coast_V3
     2565         Coast-vat3    = if tPrintRubl then VAT_R3   else  VAT_V3
     2566         Coast4        = if tPrintRubl then Coast_R4 else  Coast_V4
     2567         Coast-vat4    = if tPrintRubl then VAT_R4   else  VAT_V4
     2568         .
     2569   END PROCEDURE.
     2570   PROCEDURE foreach :
     2571     If sliv# Then run pre-foreach.
     2572     for each tdedt where tdedt.id  <> 'rs':U + ',' + 'es':U  no-lock :
     2573         For each ub.aht-ot-tot WHERE ub.aht-ot-tot.obj-type     = x-store-type
     2574                               AND ub.aht-ot-tot.obj-code     = x-store-code
     2575                               AND ub.aht-ot-tot.Fact-order  >= fact-order-1
     2576                               AND ub.aht-ot-tot.Fact-order  <= fact-order-2
     2577                               AND ub.aht-ot-tot.sum-type     = x-type-pr
     2578                               AND ub.aht-ot-tot.ext-doc-type = tdedt.id no-lock
     2579                               BREAK BY ub.aht-ot-tot.ext-doc-type BY ub.aht-ot-tot.fact-order BY ub.aht-ot-tot.doc-code :
     2580         ii = ii + 1.
     2581   IF ( ii modulo v-account = 0 )  then DO:
     2582             if  log-manager:logfile-name ne ?
     2583             then DO:
     2584                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     2585             end.
     2586              if mFrameView
     2587              then do:
     2588               DISPLAY
     2589                 ii @ RecordsDone
     2590                 WITH FRAME InfoFrame.
     2591              end.
     2592   End.
     2593      if v-button-stop then  DO:
     2594            if mFrameView
     2595            then
     2596               PROCESS EVENTS.
     2597            IF StopProcessing THEN DO:
     2598            RETURN error.
     2599            End.
     2600      end.
     2601                 If  ub.aht-ot-tot.ext-doc-type = 'ot':U then DO:
     2602                     Find Last ub.price-doc where ub.price-doc.doc-num = ub.aht-ot-tot.doc-code no-lock no-error.
     2603                     Assign
     2604                       fact-date      = If ub.aht-ot-tot.ext-doc-type <> 'ot':U then  ub.trn-doc.fact-date Else (If Available ub.price-doc THEN ub.price-doc.fact-date ELSE date(''))
     2605                       doc-code       = ub.aht-ot-tot.doc-code
     2606                       cli-name       = If ub.aht-ot-tot.ext-doc-type <> 'ot':U then ub.trn-doc.cli-name Else ""
     2607                       qnty           = ub.aht-ot-tot.fact-qnty
     2608                       Sale-sum-ot   = if tPrintRubl then ub.aht-ot-tot.crsa-sum-rubl else ub.aht-ot-tot.crsa-sum-base.
     2609                       Accumulate Sale-sum-ot (TOTAL) .
     2610                 End.
     2611               if  ub.aht-ot-tot.ext-doc-type = 'vt':U then do :
     2612                 Find Last ub.trn-doc where ub.trn-doc.doc-code = ub.aht-ot-tot.doc-code no-lock no-error.
     2613                 if avail ub.trn-doc then
     2614                           Assign
     2615                               fact-date      = ub.trn-doc.fact-date
     2616                               doc-code       = ub.aht-ot-tot.doc-code
     2617                               cli-name       = ub.trn-doc.cli-name
     2618                               qnty           = ub.aht-ot-tot.fact-qnty
     2619                               .
     2620               Assign
     2621                 SumWithNDS-coast    = ub.aht-ot-tot.cost-sum-rubl
     2622                 VAT-Sum-coast       = ub.aht-ot-tot.cost-vat-rubl
     2623                 SLT-sum-coast       = ub.aht-ot-tot.cost-slt-rubl
     2624                 SumWithoutNDS-coast = SumWithNDS-coast - VAT-Sum-coast
     2625                 discnt-sum    =   0
     2626                 ov-sum        =   0
     2627                 VAT-Sum       = if tPrintRubl then  ub.aht-ot-tot.sale-vat-rubl else ub.aht-ot-tot.sale-vat-base
     2628                 SLT-sum       = if tPrintRubl then  ub.aht-ot-tot.sale-slt-rubl else ub.aht-ot-tot.sale-slt-base
     2629                 SumWithNDS    = if tPrintRubl then  ub.aht-ot-tot.sale-sum-rubl else ub.aht-ot-tot.sale-sum-base
     2630                 SumWithoutNDS =  SumWithNDS - VAT-Sum
     2631                 sale-sum      = if tPrintRubl then ub.aht-ot-tot.crsa-sum-rubl else ub.aht-ot-tot.crsa-sum-base .
     2632                 .
     2633               End.
     2634     If  ub.aht-ot-tot.ext-doc-type <> 'ot':U  and
     2635         ub.aht-ot-tot.ext-doc-type <> 'vt':U
     2636         then DO:
     2637             Find Last ub.trn-doc where ub.trn-doc.doc-code = ub.aht-ot-tot.doc-code no-lock no-error.
     2638             Assign
     2639               fact-date      = ub.trn-doc.fact-date
     2640               doc-code       = ub.aht-ot-tot.doc-code
     2641               cli-name       = ub.trn-doc.cli-name
     2642               qnty           = ub.aht-ot-tot.fact-qnty
     2643               SumWithNDS     = If Tprintrubl Then ub.aht-ot-tot.Sale-sum-rubl Else ub.aht-ot-tot.Sale-sum-base
     2644               Discnt-sum     = If Tprintrubl Then ub.aht-ot-tot.Sale-discnt-rubl Else ub.aht-ot-tot.Sale-discnt-base
     2645             .
     2646             iF SumWithNDS = ? tHEN SumWithNDS = 0.
     2647             iF discnt-sum = ? tHEN discnt-sum = 0.
     2648             Assign
     2649             VAT_pc         = 0
     2650             VAT-Sum        = if tPrintRubl then ub.aht-ot-tot.sale-VAT-rubl else ub.aht-ot-tot.sale-VAT-base
     2651             SLT_pc         = 0
     2652             SLT-sum        = if tPrintRubl then ub.aht-ot-tot.sale-SLT-rubl else ub.aht-ot-tot.sale-SLT-base
     2653             .
     2654             iF VAT-Sum = ? tHEN VAT-Sum = 0.
     2655             iF SLT-sum = ? tHEN slt-Sum = 0.
     2656             SumWithoutNDS  = SumWithNDS - VAT-Sum.
     2657             sale-sum   = if tPrintRubl then ub.aht-ot-tot.crsa-sum-rubl else ub.aht-ot-tot.crsa-sum-base .
     2658             ov-sum =  sale-sum - ( SumWithNDS +  discnt-sum ).
     2659             Accumulate sale-sum     (TOTAL) .
     2660             Accumulate qnty         (TOTAL) .
     2661             Accumulate SumWithNDS   (TOTAL) .
     2662             Accumulate discnt-sum   (TOTAL) .
     2663             Accumulate ov-sum       (TOTAL) .
     2664             Accumulate VAT-Sum      (TOTAL) .
     2665             Accumulate SLT-sum      (TOTAL) .
     2666             Accumulate SumWithoutNDS  (TOTAL) .
     2667             Assign
     2668             SumWithNDS-coast     = if tPrintRubl then ub.aht-ot-tot.cost-sum-rubl else ub.aht-ot-tot.cost-sum-base
     2669             VAT-Sum-coast        = if tPrintRubl then ub.aht-ot-tot.cost-vat-rubl else ub.aht-ot-tot.cost-vat-base
     2670             SLT-sum-coast        = if tPrintRubl then ub.aht-ot-tot.cost-slt-rubl else ub.aht-ot-tot.cost-slt-base
     2671             SumWithoutNDS-coast  = SumWithNDS-coast - VAT-Sum-coast.
     2672             Accumulate SumWithNDS-coast          (TOTAL) .
     2673             Accumulate VAT-Sum-coast             (TOTAL) .
     2674             Accumulate SLT-sum-coast             (TOTAL) .
     2675             Accumulate SumWithoutNDS-coast       (TOTAL) .
     2676          End.
     2677             If FIRST-OF ( ub.aht-ot-tot.ext-doc-type ) then  run break-h-1.
     2678             If LAST-OF ( ub.aht-ot-tot.doc-code ) then DO:
     2679                 IF ub.aht-ot-tot.ext-doc-type  =  'ot':U   then DO:  run break-ot. end.
     2680                    Else DO:
     2681                       run break-1str.
     2682                       if available ub.trn-doc then
     2683                         if (absolute(ub.trn-doc.fact-qnty) - absolute(ub.trn-doc.doc-qnty) <> 0) and
     2684                             (aht-ot-tot.ext-doc-type <> 'vt':U and
     2685                              ub.aht-ot-tot.ext-doc-type <> 'ap':U )
     2686                             then run break-akt.
     2687                       if costsum then run break-cost.
     2688                       run break-2str.
     2689                       if dispupfact then run break-disp .
     2690                    end.
     2691                 run erase-var.
     2692             end.
     2693             if last-of ( ub.aht-ot-tot.ext-doc-type ) then do:
     2694                 qnty               = accum total       qnty.
     2695                 sumwithnds         = accum total       sumwithnds                 .
     2696                 discnt-sum         = accum total       discnt-sum                 .
     2697                 ov-sum             = accum total       ov-sum                     .
     2698                 vat-sum            = accum total       vat-sum                    .
     2699                 slt-sum            = accum total       slt-sum                    .
     2700                 sumwithoutnds      = accum total       sumwithoutnds              .
     2701                 sumwithnds-coast   = accum total       sumwithnds-coast           .
     2702                 vat-sum-coast      = accum total       vat-sum-coast              .
     2703                 slt-sum-coast      = accum total       slt-sum-coast              .
     2704                 sumwithoutnds-coast= accum total       sumwithoutnds-coast        .
     2705                 sale-sum-ot        = accum total       sale-sum-ot                .
     2706                 sale-sum           = (accum total       sale-sum   )  + sale-sum-ot  .
     2707                run break-f-1.
     2708             end.
     2709         END.
     2710     End.
     2711     If sliv#  Then run runkassa in this-procedure.
     2712   END PROCEDURE.
     2713   PROCEDURE Break-H-1 :
     2714   Display stream OutStream
     2715       sym1
     2716       sym2
     2717       sym3
     2718       CAPS (tdedt.name)  @ F-cli-name
     2719       sym4
     2720       sym5
     2721       sym6
     2722       sym7
     2723       sym8
     2724       sym9
     2725       sym10
     2726       sym11
     2727       sym12
     2728       sym13
     2729       sym14
     2730       with FRAME DocsRep .
     2731       DOWN stream  OutStream 1 with FRAME DocsRep.
     2732      END PROCEDURE.
     2733   PROCEDURE Break-F-1 :
     2734    run u-line.
     2735    Assign
     2736      fact-date = date('')
     2737      doc-code  = ''
     2738      cli-name  = "ИТОГО " +  tdedt.name .
     2739      run break-1str in this-procedure .
     2740      if costsum then run break-cost in this-procedure .
     2741    run break-2str in this-procedure .
     2742    if dispupfact then run break-disp in this-procedure .
     2743    run u-line in this-procedure .
     2744    run erase-var in this-procedure .
     2745   END PROCEDURE.
     2746   PROCEDURE Break-1str :
     2747   Display stream OutStream
     2748       sym1
     2749       fact-date format "99/99/9999" @ f-fact-date
     2750       sym2
     2751       doc-code @ f-doc-code
     2752       sym3
     2753       cli-name @ f-cli-name
     2754       sym4
     2755       qnty format "->>>>>>>9.999"   @ F-qnty
     2756        sym5
     2757        sym6
     2758        sym7
     2759        sym8
     2760        sym9
     2761        sym10
     2762        sym11
     2763        sym12
     2764        sym13
     2765        sym14
     2766           with FRAME DocsRep .
     2767           DOWN stream  OutStream 1 with FRAME DocsRep.
     2768      END PROCEDURE.
     2769   PROCEDURE Break-ot :
     2770   if NOT (NOT NullPer And sale-sum-ot = 0 And VAT-Sum = 0 and VAT-Sum-coast = 0) THEN DO:
     2771   Display stream OutStream
     2772       sym1
     2773       fact-date format "99/99/9999" @ f-fact-date
     2774       sym2
     2775       doc-code @ f-doc-code
     2776       sym3
     2777       cli-name @ f-cli-name
     2778       sym4
     2779       qnty format "->>>>>>>9.999"   @ F-qnty
     2780       sym5
     2781       sym6
     2782       sym7
     2783       sym8
     2784       sym9
     2785       sale-sum-ot @ F-sale-sum
     2786       sym10
     2787       sym11
     2788       sym12
     2789       sym13
     2790       sym14
     2791           with FRAME DocsRep .
     2792           DOWN stream  OutStream 1 with FRAME DocsRep.
     2793    End .
     2794   END PROCEDURE.
     2795   PROCEDURE Break-2str :
     2796   Display stream OutStream
     2797       sym1
     2798       sym2
     2799       If Available ub.trn-doc then
     2800        (if (trim(string(ub.trn-doc.ord-num)) <> "" and not(cli-name begins "ИТОГО")) then "Заказ"   else "" )
     2801                            else ""   @ f-doc-code
     2802       sym3
     2803       If Available ub.trn-doc then
     2804       (if (trim(string(ub.trn-doc.ord-num)) <> ""  and not(cli-name begins "ИТОГО") ) then String(ub.trn-doc.ord-num)  else "" )
     2805                            else ""  @ f-cli-name
     2806       sym4
     2807       "По документу" @ f-qnty
     2808       sym5
     2809         SumWithNDS  @  F-SumWithNDS
     2810           sym6
     2811           SumWithoutNDS @ f-SumWithoutNDS
     2812           sym7
     2813           discnt-sum    @ f-discnt-sum
     2814           sym8
     2815            ov-sum   when ( NO-PRISE = true )     @ f-ov-sum
     2816           sym9
     2817           sale-sum     @ f-sale-sum
     2818           sym10
     2819           "итого"     @ f-VAT_PC
     2820           sym11
     2821           VAT-Sum      @ f-vat-sum
     2822           sym12
     2823           sym13
     2824           SLT-sum      @ f-slt-sum
     2825           sym14
     2826           with FRAME DocsRep .
     2827           DOWN stream  OutStream 1 with FRAME DocsRep.
     2828      END PROCEDURE.
     2829   PROCEDURE Break-cost :
     2830   Display stream OutStream
     2831       sym1
     2832       sym2
     2833       sym3
     2834       sym4
     2835       "Учет" @ F-qnty
     2836       sym5
     2837       SumWithNDS-coast    @  f-SumWithNDS
     2838       sym6
     2839       SumWithoutNDS-coast @ F-SumWithoutNDS
     2840       sym7
     2841       sym8
     2842       sym9
     2843       sym10
     2844       "итого"            @ f-vat_PC
     2845       sym11
     2846       VAT-Sum-coast      @ f-VAT-Sum
     2847       sym12
     2848       space(6)
     2849       sym13
     2850       SLT-sum-coast      @ f-slt-sum
     2851       sym14
     2852       with FRAME DocsRep .
     2853       DOWN stream  OutStream 1 with FRAME DocsRep.
     2854      END PROCEDURE.
     2855   PROCEDURE Break-Akt :
     2856    tmpact = ABSOLUTE (If Available  ub.trn-doc then ub.trn-doc.doc-qnty else 0 )
     2857            - ABSOLUTE (If Available ub.trn-doc then  ub.trn-doc.fact-qnty else 0).
     2858   Display stream OutStream
     2859       sym1
     2860       sym2
     2861       sym3
     2862       "Акт несоответствия" @ f-cli-name
     2863       sym4
     2864       tmpact @ f-qnty
     2865       sym5
     2866       sym6
     2867       sym7
     2868       sym8
     2869       sym9
     2870       sym10
     2871       sym11
     2872       sym12
     2873       sym13
     2874       sym14
     2875           with FRAME DocsRep .
     2876           DOWN stream  OutStream 1 with FRAME DocsRep.
     2877      END PROCEDURE.
     2878   PROCEDURE Break-disp :
     2879     Assign
     2880     SumWithNDS-disp     = sale-sum - SumWithoutNDS-coast
     2881     SumWithoutNDS-disp  = SumWithNDS - VAT-Sum - SLT-Sum - SumWithoutNDS-coast.
     2882   Display stream OutStream
     2883       sym1
     2884       sym2
     2885       sym3
     2886       sym4
     2887       "Наценка" @ f-qnty
     2888       sym5
     2889       SumWithNDS-disp   @ f-SumWithNDS
     2890       sym6
     2891       SumWithoutNDS-disp @ f-SumWithoutNDS
     2892       sym7
     2893       sym8
     2894       sym9
     2895       sym10
     2896       sym11
     2897       sym12
     2898       sym13
     2899       sym14
     2900           with FRAME DocsRep .
     2901           DOWN stream  OutStream 1 with FRAME DocsRep.
     2902      END PROCEDURE.
     2903   PROCEDURE Erase-var :
     2904     Assign
     2905        qnty                  = 0
     2906        SumWithNDS            = 0
     2907        SumWithoutNDS         = 0
     2908        discnt-sum            = 0
     2909        ov-sum                = 0
     2910        sale-sum              = 0
     2911        sale-sum-ot           = 0
     2912        VAT_pc                = 0
     2913        VAT-Sum               = 0
     2914        SLT_pc                = 0
     2915        SLT-sum               = 0
     2916        SumWithNDS-coast      = 0
     2917        SumWithoutNDS-coast   = 0
     2918        VAT-Sum-coast         = 0
     2919        SLT-sum-coast         = 0
     2920        SumWithNDS-disp       = 0
     2921        SumWithoutNDS-disp    = 0
     2922         .
     2923      END PROCEDURE.
     2924   PROCEDURE pre-foreach :
     2925     if can-find (first tdedt where tdedt.id = 'rs':U) AND
     2926        can-find (first tdedt where tdedt.id = 'es':U)  Then  DO:
     2927        Find  First tdedt where tdedt.id = 'rs':U no-error.
     2928        delete tdedt no-error.
     2929        Find  First tdedt where tdedt.id = 'es':U no-error.
     2930        delete tdedt no-error.
     2931        create tdedt.
     2932        Assign  tdedt.id   = 'rs':U + ',' + 'es':U
     2933                tdedt.name = 'касса' .
     2934     End.
     2935    find-str = arh-type-crsa + ',' + arh-type-sale + ',' +
     2936          if CostSum Then
     2937                arh-type-cost + ','
     2938                Else "".
     2939    temp-find-str = find-str.
     2940    END PROCEDURE.
     2941   procedure runkassa :
     2942     find-str = temp-find-str.
     2943         For each ub.aht-ot-tot WHERE  ub.aht-ot-tot.obj-type = x-store-type
     2944             AND ub.aht-ot-tot.obj-code    = x-store-code
     2945             AND ub.aht-ot-tot.sum-type    = x-type-pr
     2946             AND ub.aht-ot-tot.Fact-order >  fact-order-1
     2947             AND ub.aht-ot-tot.Fact-order <= fact-order-2
     2948             AND (aht-ot-tot.ext-doc-type = 'rs':U
     2949             OR ub.aht-ot-tot.ext-doc-type = 'es':U) no-lock,
     2950             First tdedt where tdedt.id  = 'rs':U + ',' + 'es':U  no-lock
     2951             BREAK BY tdedt.id BY ub.aht-ot-tot.fact-order BY ub.aht-ot-tot.doc-code :
     2952         ii = ii + 1.
     2953   IF ( ii modulo v-account = 0 )  then DO:
     2954             if  log-manager:logfile-name ne ?
     2955             then DO:
     2956                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     2957             end.
     2958              if mFrameView
     2959              then do:
     2960               DISPLAY
     2961                 ii @ RecordsDone
     2962                 WITH FRAME InfoFrame.
     2963              end.
     2964   End.
     2965      if v-button-stop then  DO:
     2966            if mFrameView
     2967            then
     2968               PROCESS EVENTS.
     2969            IF StopProcessing THEN DO:
     2970            RETURN error.
     2971            End.
     2972      end.
     2973                 If  ub.aht-ot-tot.ext-doc-type = 'ot':U then DO:
     2974                     Find Last ub.price-doc where ub.price-doc.doc-num = ub.aht-ot-tot.doc-code no-lock no-error.
     2975                     Assign
     2976                       fact-date      = If ub.aht-ot-tot.ext-doc-type <> 'ot':U then  ub.trn-doc.fact-date Else (If Available ub.price-doc THEN ub.price-doc.fact-date ELSE date(''))
     2977                       doc-code       = ub.aht-ot-tot.doc-code
     2978                       cli-name       = If ub.aht-ot-tot.ext-doc-type <> 'ot':U then ub.trn-doc.cli-name Else ""
     2979                       qnty           = ub.aht-ot-tot.fact-qnty
     2980                       Sale-sum-ot   = if tPrintRubl then ub.aht-ot-tot.crsa-sum-rubl else ub.aht-ot-tot.crsa-sum-base.
     2981                       Accumulate Sale-sum-ot (TOTAL) .
     2982                 End.
     2983               if  ub.aht-ot-tot.ext-doc-type = 'vt':U then do :
     2984                 Find Last ub.trn-doc where ub.trn-doc.doc-code = ub.aht-ot-tot.doc-code no-lock no-error.
     2985                 if avail ub.trn-doc then
     2986                           Assign
     2987                               fact-date      = ub.trn-doc.fact-date
     2988                               doc-code       = ub.aht-ot-tot.doc-code
     2989                               cli-name       = ub.trn-doc.cli-name
     2990                               qnty           = ub.aht-ot-tot.fact-qnty
     2991                               .
     2992               Assign
     2993                 SumWithNDS-coast    = ub.aht-ot-tot.cost-sum-rubl
     2994                 VAT-Sum-coast       = ub.aht-ot-tot.cost-vat-rubl
     2995                 SLT-sum-coast       = ub.aht-ot-tot.cost-slt-rubl
     2996                 SumWithoutNDS-coast = SumWithNDS-coast - VAT-Sum-coast
     2997                 discnt-sum    =   0
     2998                 ov-sum        =   0
     2999                 VAT-Sum       = if tPrintRubl then  ub.aht-ot-tot.sale-vat-rubl else ub.aht-ot-tot.sale-vat-base
     3000                 SLT-sum       = if tPrintRubl then  ub.aht-ot-tot.sale-slt-rubl else ub.aht-ot-tot.sale-slt-base
     3001                 SumWithNDS    = if tPrintRubl then  ub.aht-ot-tot.sale-sum-rubl else ub.aht-ot-tot.sale-sum-base
     3002                 SumWithoutNDS =  SumWithNDS - VAT-Sum
     3003                 sale-sum      = if tPrintRubl then ub.aht-ot-tot.crsa-sum-rubl else ub.aht-ot-tot.crsa-sum-base .
     3004                 .
     3005               End.
     3006     If  ub.aht-ot-tot.ext-doc-type <> 'ot':U  and
     3007         ub.aht-ot-tot.ext-doc-type <> 'vt':U
     3008         then DO:
     3009             Find Last ub.trn-doc where ub.trn-doc.doc-code = ub.aht-ot-tot.doc-code no-lock no-error.
     3010             Assign
     3011               fact-date      = ub.trn-doc.fact-date
     3012               doc-code       = ub.aht-ot-tot.doc-code
     3013               cli-name       = ub.trn-doc.cli-name
     3014               qnty           = ub.aht-ot-tot.fact-qnty
     3015               SumWithNDS     = If Tprintrubl Then ub.aht-ot-tot.Sale-sum-rubl Else ub.aht-ot-tot.Sale-sum-base
     3016               Discnt-sum     = If Tprintrubl Then ub.aht-ot-tot.Sale-discnt-rubl Else ub.aht-ot-tot.Sale-discnt-base
     3017             .
     3018             iF SumWithNDS = ? tHEN SumWithNDS = 0.
     3019             iF discnt-sum = ? tHEN discnt-sum = 0.
     3020             Assign
     3021             VAT_pc         = 0
     3022             VAT-Sum        = if tPrintRubl then ub.aht-ot-tot.sale-VAT-rubl else ub.aht-ot-tot.sale-VAT-base
     3023             SLT_pc         = 0
     3024             SLT-sum        = if tPrintRubl then ub.aht-ot-tot.sale-SLT-rubl else ub.aht-ot-tot.sale-SLT-base
     3025             .
     3026             iF VAT-Sum = ? tHEN VAT-Sum = 0.
     3027             iF SLT-sum = ? tHEN slt-Sum = 0.
     3028             SumWithoutNDS  = SumWithNDS - VAT-Sum.
     3029             sale-sum   = if tPrintRubl then ub.aht-ot-tot.crsa-sum-rubl else ub.aht-ot-tot.crsa-sum-base .
     3030             ov-sum =  sale-sum - ( SumWithNDS +  discnt-sum ).
     3031             Accumulate sale-sum     (TOTAL) .
     3032             Accumulate qnty         (TOTAL) .
     3033             Accumulate SumWithNDS   (TOTAL) .
     3034             Accumulate discnt-sum   (TOTAL) .
     3035             Accumulate ov-sum       (TOTAL) .
     3036             Accumulate VAT-Sum      (TOTAL) .
     3037             Accumulate SLT-sum      (TOTAL) .
     3038             Accumulate SumWithoutNDS  (TOTAL) .
     3039             Assign
     3040             SumWithNDS-coast     = if tPrintRubl then ub.aht-ot-tot.cost-sum-rubl else ub.aht-ot-tot.cost-sum-base
     3041             VAT-Sum-coast        = if tPrintRubl then ub.aht-ot-tot.cost-vat-rubl else ub.aht-ot-tot.cost-vat-base
     3042             SLT-sum-coast        = if tPrintRubl then ub.aht-ot-tot.cost-slt-rubl else ub.aht-ot-tot.cost-slt-base
     3043             SumWithoutNDS-coast  = SumWithNDS-coast - VAT-Sum-coast.
     3044             Accumulate SumWithNDS-coast          (TOTAL) .
     3045             Accumulate VAT-Sum-coast             (TOTAL) .
     3046             Accumulate SLT-sum-coast             (TOTAL) .
     3047             Accumulate SumWithoutNDS-coast       (TOTAL) .
     3048          End.
     3049             If FIRST-OF ( tdedt.id ) then  run break-h-1.
     3050             If LAST-OF ( ub.aht-ot-tot.doc-code ) then DO:
     3051                 IF ub.aht-ot-tot.ext-doc-type  =  'ot':U   then DO:  run break-ot. end.
     3052                    Else DO:
     3053                       run break-1str.
     3054                       if available ub.trn-doc then
     3055                         if (absolute(ub.trn-doc.fact-qnty) - absolute(ub.trn-doc.doc-qnty) <> 0) and
     3056                             (aht-ot-tot.ext-doc-type <> 'vt':U and
     3057                              ub.aht-ot-tot.ext-doc-type <> 'ap':U )
     3058                             then run break-akt.
     3059                       if costsum then run break-cost.
     3060                       run break-2str.
     3061                       if dispupfact then run break-disp .
     3062                    end.
     3063                 run erase-var.
     3064             end.
     3065             if last-of ( tdedt.id ) then do:
     3066                 qnty               = accum total       qnty.
     3067                 sumwithnds         = accum total       sumwithnds                 .
     3068                 discnt-sum         = accum total       discnt-sum                 .
     3069                 ov-sum             = accum total       ov-sum                     .
     3070                 vat-sum            = accum total       vat-sum                    .
     3071                 slt-sum            = accum total       slt-sum                    .
     3072                 sumwithoutnds      = accum total       sumwithoutnds              .
     3073                 sumwithnds-coast   = accum total       sumwithnds-coast           .
     3074                 vat-sum-coast      = accum total       vat-sum-coast              .
     3075                 slt-sum-coast      = accum total       slt-sum-coast              .
     3076                 sumwithoutnds-coast= accum total       sumwithoutnds-coast        .
     3077                 sale-sum-ot        = accum total       sale-sum-ot                .
     3078                 sale-sum           = (accum total       sale-sum   )  + sale-sum-ot  .
     3079                run break-f-1.
     3080             end.
     3081         END.
     3082   END PROCEDURE.
     3083   PROCEDURE on-same-page :
     3084     define input parameter p-line-number as integer  no-undo .
     3085     if p-line-number > page-size( OutStream ) then do:
     3086       return .
     3087     end.
     3088     if line-counter( OutStream ) + p-line-number > page-size( OutStream ) then do:
     3089       page stream OutStream .
     3090     end.
     3091   end procedure.
