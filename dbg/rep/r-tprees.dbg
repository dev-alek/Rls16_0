     2076   define variable mFrameView      as logical   no-undo init yes.
     2077     define variable mFramHandle as handle no-undo.
     2078     mFramHandle = frame InfoFrame:handle.
     2079     if  log-manager:logfile-name ne ?
     2080     then DO:
     2081         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     2082         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     2083         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     2084     end.
     2085     mFrameView = not session:batch-mode and mFramHandle:visible.
     2086     if mFrameView
     2087     then do:
     2088       ASSIGN
     2089          FRAME InfoFrame:HIDDEN                           = TRUE
     2090          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     2091     end.
     2092   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     2093   DO:
     2094     IF not StopProcessing THEN
     2095       Message "Вы действительно хотите прервать" SKIP
     2096               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     2097                 UPDATE StopProcessing.
     2098     IF StopProcessing THEN do:
     2099        if mFrameView
     2100        then do:
     2101           HIDE FRAME InfoFrame.
     2102        end.
     2103     End.
     2104   END.
     2105   assign v-account = ( if integer( 10 ) = 0 then 100 else integer( 10 ) ).
     2106     if  log-manager:logfile-name ne ?
     2107     then DO:
     2108         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     2109     end.
     2110     if not session:batch-mode then
     2111     do:
     2112       VIEW FRAME InfoFrame.
     2113       mFrameView = true.
     2114     end.
     2115      v-button-stop = false .
     2116         if mFrameView
     2117         then do:
     2118         if v-button-stop then view STOPBTN in frame InfoFrame.
     2119                          else Hide STOPBTN in frame InfoFrame.
     2120         end.
     2121          FIND first ub.clients where ub.clients.obj-type = x-store-type AND
     2122                                   ub.clients.obj-code = x-store-code no-lock no-error .
     2123              If available ub.clients then  ObjName = ub.clients.obj-name.
     2124                                            else  ObjName = "объект не определен".
     2125        assign
     2126           i=0
     2127           startdate     = x-date-start
     2128           enddate       = x-date-end
     2129           PayType       = x-SET_PAY_TYPE
     2130           xTog-obj      = true
     2131           ValType       = IF (PayType = 1) Then 0  else x-SET_val_TYPE.
     2132      run aht_get-sum-type (
     2133           input   x-type-pr    ,
     2134           output  arh-type-allsum ).
     2135      run report-execute.
     2136   PROCEDURE report-execute :
     2137     If (ValType=0 and x-base-code=0)  Or ValType=1
     2138                                   then   assign tPrintRubl = yes .
     2139                                   else   assign tPrintRubl = no .
     2140      curr-rep = (if tPrintRubl then "РУБ" else x-base-type ) .
     2141      NO-PRISE = true .
     2142     if var-report-r-b = "rubl"  Then
     2143       if  x-base-code <> 0 and ValType = 2  then NO-PRISE = false  .
     2144     else
     2145       if  x-base-code <> 0 and ValType = 1  then NO-PRISE = false  .
     2146   output stream OutStream to value( string( session:temp-directory +
     2147                                        "rpt" + string( g#report-num ) ) )
     2148                                        page-size  value(ReportPageHeight) .
     2149     FORM with FRAME DocsRep .
     2150   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2151   form header
     2152     line format "x(194)" at 1 skip
     2153     "Продолжение - на следующей странице" at 30 skip
     2154     with frame bottomframe width 232 page-bottom no-labels no-box .
     2155   view stream outstream frame bottomframe .
     2156      Line = fill("-", 194).
     2157      run calcitog in this-procedure.
     2158      run print-header in this-procedure.
     2159     run foreach in this-procedure.
     2160     hide stream outstream frame bottomframe .
     2161     run print-footer in this-procedure.
     2162     hide stream outstream frame docsrep .
     2163     output stream outstream close.
     2164   if mFrameView
     2165   then do:
     2166      HIDE FRAME InfoFrame.
     2167   end.
     2168     define variable v-user-action as character no-undo .
     2169     define variable v-printed as logical   no-undo .
     2170     define variable DisabledOptions as integer   no-undo .
     2171     define variable v-orient-page as character no-undo .
     2172     run How-name in this-procedure (
     2173         input ReportPageHeight,
     2174         input ReportPageWidth,
     2175         output v-orient-page )
     2176         .
     2177     if v-orient-page = "A4-lans":U then DisabledOptions = 8 .
     2178                                    else DisabledOptions = 0 .
     2179     run gbl/prnfilen.w
     2180       (input  ""
     2181       ,input  DisabledOptions
     2182       ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     2183       ,input  ReportFontNum
     2184       ,output v-user-action
     2185       ,output v-printed
     2186       ) .
     2187   END PROCEDURE.
