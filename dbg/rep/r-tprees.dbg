      875      .
      876   define variable sum_1     as   decimal  format "->>>>>>>>>>>9.<<<" no-undo.
      877   define variable sum_2     as   decimal  format "->>>>>>>>>>>9.<<<" no-undo.
      878   define variable b1-sum_1  as   decimal  format "->>>>>>>>>>>9.<<<" no-undo.
