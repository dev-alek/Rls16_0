     2200           '         <th colspan="6" style="text-align: center; font-weight:bold; background-color: green;">По данным банка-партнера</th>' skip
     2201           '         <th colspan="2" style="text-align: center; font-weight:bold; background-color: green;">Разница</th>' skip
     2202           '       </tr>' skip
     2203       .
     2204       put stream OutStr-html unformatted
     2205           '       <tr>' skip
     2206           '         <th style="text-align: center; font-weight:bold; background-color: green; height: 50px;">АЗК/АЗС</th>' skip
