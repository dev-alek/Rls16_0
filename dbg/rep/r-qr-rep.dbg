     1779   if x-TOG-Shift
     1780       then
     1781   do :
     1782       v-period = ("С " + fnc-DD-MM-YYYY(date(string(X-Date-Start,"99/99/9999"))) + ", смена № "  + string(X-Shift-Start) +
     1783           " по " + fnc-DD-MM-YYYY(date(string(X-Date-End,"99/99/9999"))) + ", смена № " + string(X-Shift-End))
     1784           .
