     1798   procedure make-rep :
     1799       define buffer buf_chk-pay      for ub.chk-pay .
     1800       define buffer buf_chk-pay-attr for ub.chk-pay-attr .
     1801       define buffer buf_chk-doc      for ub.chk-doc .
     1802       define buffer buf_chk-gds      for ub.chk-gds .
     1803       define variable v-RRN  as character no-undo .
     1804       define variable v-date as date      no-undo .
     1805       define variable v-time as integer   no-undo .
     1806       empty TEMP-TABLE tt-itog .
     1807       create tt-itog .
     1808       for each obj-list
     1809         :
     1810         if x-TOG-Shift
     1811         then do :
     1812           if can-find(first ub.chk-doc where
     1813               ub.chk-doc.obj-type = obj-list.obj-type and
     1814               ub.chk-doc.obj-code = obj-list.obj-code and
     1815               ub.chk-doc.shift-date >= X-date-Start and
     1816               ub.chk-doc.shift-date <= X-date-End and
     1817               ub.chk-doc.out-code > "" )
     1818           then do:
     1819             run rep/rpychk0.p ( input "r-shftc2"
     1820                 ,input obj-list.obj-type
     1821                 ,input obj-list.obj-code
     1822                 ,input ?
     1823                 ,input ?
     1824                 ,input X-date-Start
     1825                 ,input x-Date-End
     1826                 ,input x-Shift-Start
     1827                 ,input x-Shift-End
     1828                 ,input ?
     1829                 ).
     1830           end .
     1831         end .
     1832         else do :
     1833           if can-find(first ub.chk-doc where
     1834               ub.chk-doc.obj-type = obj-list.obj-type and
     1835               ub.chk-doc.obj-code = obj-list.obj-code and
     1836               ub.chk-doc.chk-date >= X-date-Start and
     1837               ub.chk-doc.chk-date <= X-date-End and
     1838               ub.chk-doc.out-code > "" )
     1839           then do:
     1840             run rep/rpychk0.p ( input "r-shftc2"
     1841                 ,input obj-list.obj-type
     1842                 ,input obj-list.obj-code
     1843                 ,input x-date-Start
     1844                 ,input x-Date-End
     1845                 ,input ?
     1846                 ,input ?
     1847                 ,input ?
     1848                 ,input ?
     1849                 ,input ?
     1850                 ).
     1851           end .
     1852         end .
     1853       end .
     1854       obj_:
     1855       for each obj-list
     1856           :
     1857           if x-TOG-Shift
     1858               then
     1859           do :
     1860               if can-find(first ub.chk-doc where
     1861                   ub.chk-doc.obj-type = obj-list.obj-type and
     1862                   ub.chk-doc.obj-code = obj-list.obj-code and
     1863                   ub.chk-doc.shift-date >= X-date-Start and
     1864                   ub.chk-doc.shift-date <= X-date-End and
     1865                   ub.chk-doc.out-code > "" )
     1866                   then
     1867               do:
     1868                 for each buf_chk-doc no-lock where buf_chk-doc.obj-type = obj-list.obj-type
     1869                                                and buf_chk-doc.obj-code = obj-list.obj-code
     1870                                                and buf_chk-doc.shift-date >= X-date-start
     1871                                                and buf_chk-doc.shift-date <= X-date-end
     1872                                                and buf_chk-doc.out-code > ""
     1873                                                :
     1874                   if ((buf_chk-doc.shift-date = x-date-Start and buf_chk-doc.shift-num < X-shift-start)
     1875                   or (buf_chk-doc.shift-date = x-date-End and  buf_chk-doc.shift-num > X-shift-end) )
     1876                   then next.
     1877                   for each buf_chk-pay-attr no-lock where buf_chk-pay-attr.doc-code = buf_chk-doc.doc-code
     1878                                                       and buf_chk-pay-attr.attr-code = "sbprrn",
     1879                   first buf_chk-pay no-lock where buf_chk-pay.doc-code = buf_chk-pay-attr.doc-code
     1880                                               and buf_chk-pay.line-num = buf_chk-pay-attr.line-num
     1881                                               :
     1882                     if not (buf_chk-pay.pay-code = buf_cash-pay.cdpay-code
     1883                             and buf_chk-pay.curr-code = buf_cash-pay.curr-code)
     1884                     then next .
     1885                     v-RRN = buf_chk-pay-attr.attr-value .
     1886                     find first tt-trans exclusive-lock where  tt-trans.RRN > ""
     1887                         and trim(tt-trans.RRN) = trim(v-RRN)
     1888                         and not tt-trans.taken
     1889                         no-error .
     1890                     create tt-rep .
     1891                     assign
     1892                       tt-rep.obj-type   = obj-list.obj-type
     1893                       tt-rep.obj-code   = obj-list.obj-code
     1894                       tt-rep.obj-name   = obj-list.obj-name
     1895                       tt-rep.summ-TH    = buf_chk-pay.tot-rubl
     1896                       tt-rep.chk-date   = buf_chk-doc.chk-date
     1897                       tt-rep.chk-time   = string(buf_chk-doc.chk-time, "HH:MM:SS")
     1898                       tt-rep.chk-doc-code = buf_chk-doc.doc-code
     1899                       tt-rep.shift-date = buf_chk-doc.shift-date
     1900                       tt-rep.shift-num  = buf_chk-doc.shift-num
     1901                       tt-rep.RRN-TH     = v-RRN
     1902                       tt-rep.azk        = ""
     1903                       tt-itog.op-qnty-TH  = tt-itog.op-qnty-TH + 1
     1904                       tt-itog.summ-TH   = tt-itog.summ-TH + tt-rep.summ-TH
     1905                     .
     1906                     if available tt-trans
     1907                     then do :
     1908                       assign
     1909                         tt-rep.dt-QR        = tt-trans.dt
     1910                         tt-rep.summ-QR      = tt-trans.summ
     1911                         tt-rep.RRN-QR       = tt-trans.RRN
     1912                         tt-trans.taken      = true
     1913                         tt-itog.op-qnty-QR  = tt-itog.op-qnty-QR + 1
     1914                         tt-itog.summ-QR     = tt-itog.summ-QR + tt-rep.summ-QR
     1915                       .
     1916                     end .
     1917                     release tt-rep .
     1918                   end .
     1919                 end .
     1920               end .
     1921           end .
     1922           else
     1923           do :
     1924               if can-find(first ub.chk-doc where
     1925                   ub.chk-doc.obj-type = obj-list.obj-type and
     1926                   ub.chk-doc.obj-code = obj-list.obj-code and
     1927                   ub.chk-doc.chk-date >= X-date-Start and
     1928                   ub.chk-doc.chk-date <= X-date-End and
     1929                   ub.chk-doc.out-code > "" )
     1930                   then
     1931               do:
     1932                 for each buf_chk-doc no-lock where buf_chk-doc.obj-type = obj-list.obj-type
     1933                                                and buf_chk-doc.obj-code = obj-list.obj-code
     1934                                                and buf_chk-doc.chk-date >= X-date-start
     1935                                                and buf_chk-doc.chk-date <= X-date-end
     1936                                                and buf_chk-doc.out-code > ""
     1937                                                :
     1938                   for each buf_chk-pay-attr no-lock where buf_chk-pay-attr.doc-code = buf_chk-doc.doc-code
     1939                                                       and buf_chk-pay-attr.attr-code = "sbprrn",
     1940                   first buf_chk-pay no-lock where buf_chk-pay.doc-code = buf_chk-pay-attr.doc-code
     1941                                               and buf_chk-pay.line-num = buf_chk-pay-attr.line-num
     1942                                               :
     1943                     if not (buf_chk-pay.pay-code = buf_cash-pay.cdpay-code
     1944                             and buf_chk-pay.curr-code = buf_cash-pay.curr-code)
     1945                     then next .
     1946                     v-RRN = buf_chk-pay-attr.attr-value .
     1947                     find first tt-trans exclusive-lock where  tt-trans.RRN > ""
     1948                         and trim(tt-trans.RRN) = trim(v-RRN)
     1949                         and not tt-trans.taken
     1950                         no-error .
     1951                     create tt-rep .
     1952                     assign
     1953                       tt-rep.obj-type   = obj-list.obj-type
     1954                       tt-rep.obj-code   = obj-list.obj-code
     1955                       tt-rep.obj-name   = obj-list.obj-name
     1956                       tt-rep.summ-TH    = buf_chk-pay.tot-rubl
     1957                       tt-rep.chk-date   = buf_chk-doc.chk-date
     1958                       tt-rep.chk-time   = string(buf_chk-doc.chk-time, "HH:MM:SS")
     1959                       tt-rep.chk-doc-code = buf_chk-doc.doc-code
     1960                       tt-rep.shift-date = buf_chk-doc.shift-date
     1961                       tt-rep.shift-num  = buf_chk-doc.shift-num
     1962                       tt-rep.RRN-TH     = v-RRN
     1963                       tt-rep.azk        = ""
     1964                       tt-itog.op-qnty-TH  = tt-itog.op-qnty-TH + 1
     1965                       tt-itog.summ-TH   = tt-itog.summ-TH + tt-rep.summ-TH
     1966                     .
     1967                     if available tt-trans
     1968                     then do :
     1969                       assign
     1970                         tt-rep.azk-disp     = tt-trans.azk
     1971                         tt-rep.dt-QR        = tt-trans.dt
     1972                         tt-rep.summ-QR      = tt-trans.summ
     1973                         tt-rep.RRN-QR       = tt-trans.RRN
     1974                         tt-trans.taken      = true
     1975                         tt-itog.op-qnty-QR  = tt-itog.op-qnty-QR + 1
     1976                         tt-itog.summ-QR     = tt-itog.summ-QR + tt-rep.summ-QR
     1977                       .
     1978                     end .
     1979                     release tt-rep .
     1980                   end .
     1981                 end .
     1982               end .
     1983           end .
     1984       end .
     1985       for each tt-trans exclusive-lock where not tt-trans.taken :
     1986           create tt-rep .
     1987           assign
     1988             tt-rep.azk          = tt-trans.azk
     1989             tt-rep.dt-QR        = tt-trans.dt
     1990             tt-rep.summ-QR      = tt-trans.summ
     1991             tt-rep.RRN-QR       = tt-trans.RRN
     1992             tt-trans.taken      = true
     1993             tt-itog.op-qnty-QR  = tt-itog.op-qnty-QR + 1
     1994             tt-itog.summ-QR     = tt-itog.summ-QR + tt-rep.summ-QR
     1995           .
     1996           if trim(tt-rep.azk) = "" then tt-rep.azk = "?" .
     1997           release tt-rep .
     1998       end .
     1999       for each tt-rep where tt-rep.azk = ""
     2000                       break by tt-rep.obj-type
     2001                             by tt-rep.obj-code
     2002                             by tt-rep.shift-date
     2003                             by tt-rep.shift-num
     2004         :
     2005         if first-of(tt-rep.obj-type)
     2006         or first-of(tt-rep.obj-code)
     2007         then do :
     2008           create tt-obj .
     2009           assign
     2010             tt-obj.obj-type = tt-rep.obj-type
     2011             tt-obj.obj-code = tt-rep.obj-code
     2012             tt-obj.obj-name = tt-rep.obj-name
     2013           .
     2014         end .
     2015         if first-of(tt-rep.shift-date)
     2016         or first-of(tt-rep.shift-num)
     2017         then do :
     2018           create tt-shift .
     2019           assign
     2020             tt-shift.obj-type   = tt-rep.obj-type
     2021             tt-shift.obj-code   = tt-rep.obj-code
     2022             tt-shift.shift-date = tt-rep.shift-date
     2023             tt-shift.shift-num  = tt-rep.shift-num
     2024           .
     2025         end .
     2026         assign
     2027           tt-obj.op-qnty-TH = (tt-obj.op-qnty-TH + 1) when trim(tt-rep.RRN-TH) > ""
     2028           tt-obj.summ-TH    = tt-obj.summ-TH    + tt-rep.summ-TH
     2029           tt-obj.op-qnty-QR = (tt-obj.op-qnty-QR + 1) when trim(tt-rep.RRN-QR) > ""
     2030           tt-obj.summ-QR    = tt-obj.summ-QR    + tt-rep.summ-QR
     2031         .
     2032         assign
     2033           tt-shift.op-qnty-TH = (tt-shift.op-qnty-TH + 1) when trim(tt-rep.RRN-TH) > ""
     2034           tt-shift.summ-TH    = tt-shift.summ-TH    + tt-rep.summ-TH
     2035           tt-shift.op-qnty-QR = (tt-shift.op-qnty-QR + 1) when trim(tt-rep.RRN-QR) > ""
     2036           tt-shift.summ-QR    = tt-shift.summ-QR    + tt-rep.summ-QR
     2037         .
     2038         if last-of(tt-rep.obj-type)
     2039         or last-of(tt-rep.obj-code)
     2040         then do :
     2041           release tt-obj .
     2042         end .
     2043         if last-of(tt-rep.shift-date)
     2044         or last-of(tt-rep.shift-num)
     2045         then do :
     2046           release tt-shift .
     2047         end .
     2048       end .
     2049   end procedure .
     2050   procedure imp-QR :
     2051       DEFINE VARIABLE mExcelApplication AS COMPONENT-HANDLE NO-UNDO.
     2052       DEFINE VARIABLE mWorkBook         AS COMPONENT-HANDLE NO-UNDO.
     2053       DEFINE VARIABLE mWorkSheet        AS COMPONENT-HANDLE NO-UNDO.
     2054       DEFINE VARIABLE mMaxNoLine        AS INTEGER          INITIAL 10 NO-UNDO.
     2055       DEFINE VARIABLE vLine             AS INTEGER          NO-UNDO.
     2056       DEFINE VARIABLE vChLine           AS CHARACTER        NO-UNDO.
     2057       DEFINE VARIABLE vCh               AS CHARACTER        NO-UNDO.
     2058       DEFINE VARIABLE vNoLine           AS INTEGER          NO-UNDO.
     2059       define variable v-azk             as character        no-undo .
     2060       define variable v-summ            as character        no-undo .
     2061       define variable v-dt              as character        no-undo .
     2062       define variable v-RRN             as character        no-undo .
     2063       define variable v-date            as character        no-undo .
     2064       define variable v-time            as character        no-undo .
     2065       CREATE "Excel.Application":U mExcelApplication.
     2066       ASSIGN
     2067           mExcelApplication:DisplayAlerts = NO
     2068           mWorkbook                       = mExcelApplication:WorkBooks:Add(p-file)
     2069           mWorkSheet                      = mWorkbook:Sheets:Item(1)
     2070           .
     2071       loopbl:
     2072       do vLine = 1 to 1000000:
     2073           ASSIGN
     2074               vChLine    = STRING(vLine)
     2075               v-azk      = ''
     2076               v-summ     = ''
     2077               v-dt       = ''
     2078               v-RRN      = ''
     2079               .
     2080           v-RRN = mWorkSheet:Range("I" + vChLine):FORMULA NO-ERROR.
     2081           if v-RRN = ? then v-RRN = mWorkSheet:Range("I" + vChLine):VALUE NO-ERROR.
     2082           v-azk = mWorkSheet:Range("H" + vChLine):VALUE NO-ERROR.
     2083           if v-azk = ? then v-azk = mWorkSheet:Range("H" + vChLine):FORMULA NO-ERROR.
     2084           v-summ = mWorkSheet:Range("C" + vChLine):FORMULA NO-ERROR.
     2085           if v-summ = ? then v-summ = mWorkSheet:Range("C" + vChLine):VALUE NO-ERROR.
     2086           v-summ = replace(v-summ, ",", ".") .
     2087           decimal(v-summ) no-error .
     2088           if error-status:error then next loopbl .
     2089           v-dt = mWorkSheet:Range("A" + vChLine):VALUE NO-ERROR.
     2090           if v-dt = ? then v-dt = mWorkSheet:Range("A" + vChLine):FORMULA NO-ERROR.
     2091           v-dt = trim(v-dt) .
     2092           if length(v-azk) > 0
     2093               or length(v-summ) > 0
     2094               or length(v-dt) > 0
     2095               or length(v-RRN) > 0
     2096               then
     2097           do :
     2098               vNoLine = 0 .
     2099           end.
     2100           else
     2101           do :
     2102               vNoLine = vNoLine + 1.
     2103               IF vNoLine > mMaxNoLine THEN LEAVE loopbl.
     2104               ELSE NEXT loopbl.
     2105           end.
     2106           create tt-trans .
     2107           tt-trans.azk       = v-azk .
     2108           tt-trans.summ      = decimal(v-summ) .
     2109           tt-trans.dt        = datetime(v-dt) .
     2110           tt-trans.RRN       = trim(v-RRN) .
     2111           tt-trans.taken     = false .
     2112           release tt-trans .
     2113       end.
     2114   end procedure .
     2115   procedure my-rep :
     2116       run gbl/getrpnum.p (output g#report-num).
     2117       run define-full-path-Report(input g#report-num, output v-file-name-rep-htm).
     2118       run create-file(v-file-name-rep-htm).
