     2443   procedure define-full-path-Report:
     2444       define input parameter p-rep-num as integer no-undo.
     2445       define output parameter p-file-name-rep-htm as character no-undo.
     2446       p-file-name-rep-htm = session:temp-directory + "rpt" + string(p-rep-num) + ".html".
     2447   end procedure.
     2448   procedure create-file:
     2449       define input parameter p-file-name as character no-undo.
     2450       output to value(string(p-file-name)).
     2451       output close.
     2452   end procedure.
     2453   function fnc-DD-MM-YYYY returns character
     2454       (input p-dat-date as date):
     2455       define variable result     as character no-undo.
     2456       define variable p-str-date as character no-undo.
     2457       p-str-date = replace(string(p-dat-date,'99.99.9999'), "/", ".").
     2458       return p-str-date.
     2459   end function.
     2460    function fnc-obj-name returns character
     2461       (input p-obj-code as integer, input p-obj-type as character):
     2462       define variable result     as character no-undo.
     2463       define variable p-obj-name as character no-undo.
     2464       define buffer buf_clients for ub.clients .
     2465       for first buf_clients no-lock where buf_clients.obj-code = p-obj-code
     2466                                       and buf_clients.obj-type = p-obj-type:
     2467       p-obj-name = buf_clients.obj-name.
     2468       end.
     2469       return p-obj-name.
     2470   end function.
