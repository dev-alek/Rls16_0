      768   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      769     if num-entries(string(p-dec), '.') = 2
      770       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      771       else return( string(p-dec)) .
      772   end function.
      773   function format-point-to-comma returns char (input orig as char ) .
      774   define variable rtext as character no-undo .
      775   define variable strt as integer no-undo .
      776   define variable leng as integer no-undo .
      777   assign rtext = orig .
      778   repeat:
      779     strt =  index(rtext,'.').
      780     if strt = 0 then leave.
      781     leng = 1.
      782     substring(rtext,strt,leng,"character") = v-delim .
      783   end.
      784   return rtext.
      785   end function.
      786   function format-excel-text returns char ( input start-text as char ) :
      787   def var  i    as int no-undo.
      788   def var  ch   as char no-undo.
      789   def var  n    as int no-undo.
      790   def var  ipos as int no-undo.
      791     n = num-entries(trim(start-text), chr(10)) - 1 .
      792     do i = 1 to n :
      793       ipos = index( start-text, chr(10)).
      794       if ipos > 0 then
      795         substr( start-text, ipos, 1 ) = ' '.
      796     end.
      797     n = num-entries(trim(start-text), chr(13)) - 1 .
      798     do i = 1 to n :
      799       ipos = index( start-text, chr(13)).
      800       if ipos > 0 then
      801         substr( start-text, ipos, 1 ) = ' '.
      802     end.
      803     if index( start-text, '"' ) = 0 then
      804       start-text =  '="'   + trim( start-text) + '"'   .
      805       else do:
      806         n = num-entries(trim(start-text), '"') - 1.
      807         do i = 1 to n :
      808           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      809         end.
      810         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      811         start-text = '="'  + ch  + '"' .
      812       end.
      813     return start-text.
      814   end.
      815   function excel-sum returns char (input p-dec as decimal ).
      816     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      817   end function.
      818   function excel-qnty returns char (input p-dec as decimal ).
      819     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      820   end function.
      821   function format-excel-text-macr returns char ( input start-text as char ) :
      822   def var  i    as int no-undo.
      823   def var  ch   as char no-undo.
      824   def var  n    as int no-undo.
      825   def var  ipos as int no-undo.
      826     n = num-entries(trim(start-text), chr(10)) - 1 .
      827     do i = 1 to n :
      828       ipos = index( start-text, chr(10)).
      829       if ipos > 0 then
      830         substring( start-text, ipos , 1 ) = ' '.
      831     end.
      832     n = num-entries(trim(start-text), chr(13)) - 1 .
      833     do i = 1 to n :
      834       ipos = index( start-text, chr(13)).
      835       if ipos > 0 then
      836         substring( start-text, ipos, 1 ) = ' '.
      837     end.
      838     if index( start-text, '"' ) = 0 then
      839       start-text =  '"'   + trim( start-text) + '"'   .
      840       else do:
      841         n = num-entries(trim(start-text), '"') - 1.
      842         do i = 1 to n :
      843           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      844         end.
      845         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      846         start-text = '"'  + ch  + '"' .
      847       end.
      848     n = num-entries(trim(start-text), chr(10)) - 1 .
      849     do i = 1 to n :
      850       ipos = index( start-text, chr(10)).
      851       if ipos > 0 then
      852         substring( start-text, ipos , 1 ) = ' '.
      853     end.
      854       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
      855     return start-text.
      856   end.
      857   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      858   procedure cur-time :
      859      define output parameter p-today as date      no-undo .
      860      define output parameter p-time  as integer   no-undo .
      861     do
      862     on error undo, return error
      863     :
      864       define variable v-date1 as date      no-undo .
      865       define variable v-date2 as date      no-undo .
      866       define variable v-time  as integer   no-undo .
      867       assign
      868         v-date1 = today
      869         v-time  = time
      870         v-date2 = today
      871       .
      872       if v-date1 <> v-date2
      873       then do:
      874         assign
      875           v-date1 = today
      876           v-time  = v-time
      877         .
      878       end.
      879       assign
      880         p-today = v-date1
      881         p-time  = v-time
      882       .
      883     end.
      884   end.
      885   function cur-time-date returns character
      886   :
      887     return string(today, '99/99/9999':U) .
      888   end.
      889   function cur-time-mjd returns decimal
      890   :
      891     define variable v-date as date      no-undo .
      892     define variable v-time as integer   no-undo .
      893     run cur-time in this-procedure
      894       (output v-date
      895       ,output v-time
      896       ) .
      897     return integer(v-date) - 2400002 + (v-time / 86400) .
      898   end.
      899   function cur-time-get-ending-index returns integer
      900   (input p-number as integer
      901   )
      902   :
      903     if p-number < 0
      904     or p-number = ?
      905     then do:
      906       return 1 .
      907     end.
      908     define variable v-rest as integer   no-undo .
      909     assign
      910       p-number = p-number modulo 100
      911     .
      912     if p-number < 20
      913     then do:
      914       assign
      915         v-rest = p-number
      916       .
      917     end.
      918     else do:
      919       assign
      920         v-rest = p-number modulo 10
      921       .
      922     end.
      923     case v-rest :
      924       when 1
      925       then do:
      926         return 2 .
      927       end.
      928       when 2 or
      929       when 3 or
      930       when 4
      931       then do:
      932         return 3 .
      933       end.
      934       otherwise do:
      935         return 1 .
      936       end.
      937     end case .
      938   end.
      939   procedure cur-time-mjd-to-date :
      940      define input  parameter i-mjd-diff as decimal no-undo.
      941      define output parameter o-Date     as date    no-undo.
      942      define output parameter o-Time     as integer no-undo.
      943      define variable v-day-number as integer   no-undo .
      944      if    i-mjd-diff < 0
      945         or i-mjd-diff = ?
      946      then do:
      947         return "?" .
      948      end.
      949      assign
      950         v-day-number = truncate(i-mjd-diff,0).
      951         o-Date = date(v-day-number + 2400002).
      952         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      953     .
      954   end.
      955   function cur-time-mjd-to-string returns character
      956   (input p-mjd-diff as decimal
      957   )
      958   :
      959     define variable v-day-number as integer   no-undo .
      960     define variable v-seconds    as integer   no-undo .
      961     define variable v-hour       as integer   no-undo .
      962     define variable v-min        as integer   no-undo .
      963     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      964     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      965     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      966     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      967     if p-mjd-diff < 0
      968     or p-mjd-diff = ?
      969     then do:
      970       return "?" .
      971     end.
      972     assign
      973       v-day-number = integer(truncate(p-mjd-diff,0))
      974       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      975     .
      976     if v-seconds > 86400
      977     then do:
      978       assign
      979         v-seconds = 86400 - 1
      980       .
      981     end.
      982     if v-seconds < 0
      983     then do:
      984       assign
      985         v-seconds = 0
      986       .
      987     end.
      988     assign
      989       v-hour = truncate(v-seconds / 3600, 0)
      990     .
      991     assign
      992       v-seconds = v-seconds modulo 3600
      993     .
      994     assign
      995       v-min = truncate(v-seconds / 60, 0)
      996     .
      997     assign
      998       v-seconds = v-seconds modulo 60
      999     .
     1000     return
     1001         (if v-day-number <> 0
     1002           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1003           else ""
     1004         )
     1005       + (if v-day-number <> 0 or v-hour <> 0
     1006           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1007           else ""
     1008         )
     1009       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1010           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1011           else ""
     1012         )
     1013       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1014       .
     1015   end.
     1016   function cur-time-string returns character
     1017   :
     1018     define variable v-date as date      no-undo .
     1019     define variable v-time as integer   no-undo .
     1020     run cur-time in this-procedure
     1021       (output v-date
     1022       ,output v-time
     1023       ) .
     1024     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1025   end.
     1026   function cur-time-string-sec returns character
     1027   :
     1028     define variable v-date as date      no-undo .
     1029     define variable v-time as integer   no-undo .
     1030     run cur-time in this-procedure
     1031       (output v-date
     1032       ,output v-time
     1033       ) .
     1034     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1035   end.
     1036   function cur-time-custom  returns character
     1037   (input p-prefix as character
     1038   ,input p-date-format as character
     1039   ,input p-delimiter as character
     1040   ,input p-time-format as character
     1041   ,input p-suffix as character
     1042   )
     1043   :
     1044     define variable v-date as date      no-undo .
     1045     define variable v-time as integer   no-undo .
     1046     run cur-time in this-procedure
     1047       (output v-date
     1048       ,output v-time
     1049       ) .
     1050     return
     1051       p-prefix
     1052       + string(v-date, p-date-format)
     1053       + p-delimiter
     1054       + string(v-time, p-time-format)
     1055       + p-suffix
     1056       .
     1057   end.
     1058   function cur-time-print  returns character
     1059   :
     1060     define variable v-date as date      no-undo .
     1061     define variable v-time as integer   no-undo .
     1062     run cur-time in this-procedure
     1063       (output v-date
     1064       ,output v-time
     1065       ) .
     1066     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1067   end.
     1068   function cur-time-datetime returns datetime
     1069   :
     1070     define variable v-char as character no-undo .
     1071     define variable v-datetime as datetime no-undo .
     1072     v-char = cur-time-string().
     1073     v-datetime = datetime(v-char).
     1074     return  v-datetime.
     1075   end.
     1076   function cur-time-string-msec returns character
     1077   :
     1078     define variable v-date as datetime  no-undo .
     1079     v-date = now.
     1080     return string(v-date) .
     1081   end.
     1082   def var vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1083   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     1084   procedure paramls-clear :
     1085     define buffer buf_temp-param for temp-param .
     1086     do
     1087     on error undo, return error return-value
     1088     :
     1089       for each buf_temp-param
     1090       on error undo, return error
     1091       :
     1092         delete buf_temp-param .
     1093       end.
     1094     end.
     1095   end procedure.
     1096   procedure paramls-write :
     1097     define input  parameter p-code     as character no-undo .
     1098     define input  parameter p-sub-code as character no-undo .
     1099     define input  parameter p-value    as character no-undo .
     1100     define buffer buf_temp-param for temp-param .
     1101     do
     1102     on error undo, return error return-value
     1103     :
     1104       find first buf_temp-param
     1105         where buf_temp-param.param-code     = p-code
     1106           and buf_temp-param.param-sub-code = p-sub-code
     1107         no-error .
     1108       if not available buf_temp-param then do:
     1109         create buf_temp-param .
     1110         assign
     1111           buf_temp-param.param-code     = p-code
     1112           buf_temp-param.param-sub-code = p-sub-code
     1113         .
     1114       end.
     1115       assign
     1116         buf_temp-param.param-value = p-value
     1117       .
     1118     end.
     1119   end procedure.
     1120   procedure paramls-read :
     1121     define input  parameter p-code          as character no-undo .
     1122     define input  parameter p-sub-code      as character no-undo .
     1123     define input  parameter p-default-value as character no-undo .
     1124     define output parameter p-value         as character no-undo .
     1125     define buffer buf_temp-param for temp-param .
     1126     do
     1127     on error undo, return error return-value
     1128     :
     1129       find first buf_temp-param
     1130         where buf_temp-param.param-code     = p-code
     1131           and buf_temp-param.param-sub-code = p-sub-code
     1132         no-error .
     1133       if available buf_temp-param then do:
     1134         assign
     1135           p-value = buf_temp-param.param-value
     1136         .
     1137       end.
     1138       else do:
     1139         assign
     1140           p-value = p-default-value
     1141         .
     1142       end.
     1143     end.
     1144   end procedure.
     1145   procedure paramls-append :
     1146     define input  parameter p-code     as character no-undo .
     1147     define input  parameter p-sub-code as character no-undo .
     1148     define input  parameter p-value    as character no-undo .
     1149     define buffer buf_temp-param for temp-param .
     1150     do
     1151     on error undo, return error return-value
     1152     :
     1153       find first buf_temp-param
     1154            where buf_temp-param.param-code     = p-code
     1155              and buf_temp-param.param-sub-code = p-sub-code
     1156         no-error .
     1157       if not available buf_temp-param then do:
     1158         create buf_temp-param .
     1159         assign
     1160           buf_temp-param.param-code     = p-code
     1161           buf_temp-param.param-sub-code = p-sub-code
     1162           buf_temp-param.param-value    = p-value
     1163         .
     1164       end.
     1165       else do:
     1166           assign
     1167               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     1168           .
     1169       end.
     1170     end.
     1171   end procedure.
     1172   def var vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1173   define stream ahtlog .
     1174   define temp-table temp-aht-ot-tot no-undo like ub.aht-ot-tot .
     1175   define temp-table temp-aht-ot-line no-undo like ub.aht-ot-line .
     1176   define temp-table temp-aht-stk-tot no-undo like ub.aht-stk-tot .
     1177   define temp-table temp-aht-stk-line no-undo like ub.aht-stk-line .
     1178   procedure aht_get-sum-type :
     1179     define input  parameter p-aht-type        as character no-undo .
     1180     define output parameter p-allsum-sum-type as character no-undo .
     1181     do
     1182     on error undo, return error return-value
     1183     :
     1184       case p-aht-type :
     1185         when 'r':U then do:
     1186           assign
     1187             p-allsum-sum-type = 'сумма_по_выкупу_со_знаком':U
     1188           .
     1189         end.
     1190         when 'c':U then do:
     1191           assign
     1192             p-allsum-sum-type = 'сумма_по_консигнации_закупка_со_знаком':U
     1193           .
     1194         end.
     1195         when 'b':U then do:
     1196           assign
     1197             p-allsum-sum-type = 'сумма_по_консигнации_выгода_со_знаком':U
     1198           .
     1199         end.
     1200         when 's':U then do:
     1201           assign
     1202             p-allsum-sum-type = 'сумма_по_ответственному_хранению_со_знаком':U
     1203           .
     1204         end.
     1205         when 'o':U then do:
     1206           assign
     1207             p-allsum-sum-type = 'сумма_по_старой_консигнации_со_знаком':U
     1208           .
     1209         end.
     1210         when 'v':U then do:
     1211           assign
     1212             p-allsum-sum-type = 'сумма_по_услуге_со_знаком':U
     1213           .
     1214         end.
     1215         otherwise do:
     1216           message
     1217             vss-workfile vss-revision vss-description skip
     1218             vss-include-info16 skip
     1219             "Неизвестное значение типа приобретения" skip
     1220             "Тип приобретения" p-aht-type skip
     1221             view-as alert-box error .
     1222           undo, return error .
     1223         end.
     1224       end.
     1225     end.
     1226   end procedure.
     1227   procedure aht_get-stk-sum-type :
     1228     define input  parameter p-ot-sum-type      as character no-undo .
     1229     define input  parameter p-ext-doc-type     as character no-undo .
     1230     define output parameter p-stk-ext-sum-type as character no-undo .
     1231     do
     1232     on error undo, return error return-value
     1233     :
     1234       assign
     1235         p-stk-ext-sum-type = p-ot-sum-type + p-ext-doc-type
     1236       .
     1237     end.
     1238   end procedure.
