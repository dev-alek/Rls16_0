     1608   procedure aht_add-document :
     1609     define input  parameter p-doc-code     like ub.aht-doc.doc-code     no-undo .
     1610     define input  parameter p-obj-type     like ub.aht-doc.obj-type     no-undo .
     1611     define input  parameter p-obj-code     like ub.aht-doc.obj-code     no-undo .
     1612     define input  parameter p-ext-doc-type like ub.aht-doc.ext-doc-type no-undo .
     1613     define input  parameter p-is-trn-doc   like ub.aht-doc.is-trn-doc   no-undo .
     1614     define input  parameter p-fact-order   like ub.aht-doc.fact-order   no-undo .
     1615     define input  parameter p-fact-date    like ub.aht-doc.fact-date    no-undo .
     1616     define input  parameter p-shift-date   like ub.aht-doc.shift-date   no-undo .
     1617     define input  parameter p-shift-num    like ub.aht-doc.shift-num    no-undo .
     1618     define buffer buf_aht-doc for ub.aht-doc .
     1619     do
     1620     on error undo, return error return-value
     1621     :
     1622       find first buf_aht-doc exclusive-lock
     1623         where buf_aht-doc.doc-code = p-doc-code
     1624         no-error .
     1625       if available buf_aht-doc then do:
     1626         message
     1627           vss-workfile vss-revision vss-description skip
     1628           vss-include-info16 skip
     1629           "Попытка повторного создания записи" skip
     1630           "Документ" p-doc-code skip
     1631           view-as alert-box error .
     1632         undo, return error .
     1633       end.
     1634       if p-fact-order = ?
     1635       or p-fact-order = 0
     1636       then do:
     1637         message
     1638           vss-workfile vss-revision vss-description skip
     1639           vss-include-info16 skip
     1640           "Ошибка задания входных параметров" skip
     1641           "Не задан номер документа" skip
     1642           "Документ" p-doc-code skip
     1643           "Номер документа" p-fact-order skip
     1644           view-as alert-box error .
     1645         undo, return error .
     1646       end.
     1647       create buf_aht-doc .
     1648       assign
     1649         buf_aht-doc.doc-code     = p-doc-code
     1650         buf_aht-doc.obj-type     = p-obj-type
     1651         buf_aht-doc.obj-code     = p-obj-code
     1652         buf_aht-doc.ext-doc-type = p-ext-doc-type
     1653         buf_aht-doc.is-trn-doc   = p-is-trn-doc
     1654         buf_aht-doc.fact-order   = p-fact-order
     1655         buf_aht-doc.fact-date    = p-fact-date
     1656         buf_aht-doc.shift-date   = p-shift-date
     1657         buf_aht-doc.shift-num    = p-shift-num
     1658       .
     1659     end.
     1660   end procedure.
     1661   procedure aht_add-date :
     1662     define input  parameter p-obj-type     like ub.aht-stk.obj-type     no-undo .
     1663     define input  parameter p-obj-code     like ub.aht-stk.obj-code     no-undo .
     1664     define input  parameter p-stk-type     like ub.aht-stk.stk-type     no-undo .
     1665     define input  parameter p-fact-order   like ub.aht-stk.fact-order   no-undo .
     1666     define input  parameter p-fact-date    like ub.aht-stk.fact-date    no-undo .
     1667     define input  parameter p-shift-date   like ub.aht-stk.shift-date   no-undo .
     1668     define input  parameter p-shift-num    like ub.aht-stk.shift-num    no-undo .
     1669     define buffer buf_aht-stk for ub.aht-stk .
     1670     do
     1671     on error undo, return error return-value
     1672     :
     1673       find first buf_aht-stk no-lock
     1674         where buf_aht-stk.obj-type   = p-obj-type
     1675           and buf_aht-stk.obj-code   = p-obj-code
     1676           and buf_aht-stk.stk-type   = p-stk-type
     1677           and buf_aht-stk.fact-order = p-fact-order
     1678         no-error .
     1679       if not available buf_aht-stk then do:
     1680         create buf_aht-stk .
     1681         assign
     1682           buf_aht-stk.obj-type   = p-obj-type
     1683           buf_aht-stk.obj-code   = p-obj-code
     1684           buf_aht-stk.stk-type   = p-stk-type
     1685           buf_aht-stk.fact-order = p-fact-order
     1686           buf_aht-stk.fact-date  = p-fact-date
     1687           buf_aht-stk.shift-date = p-shift-date
     1688           buf_aht-stk.shift-num  = p-shift-num
     1689         .
     1690       end.
     1691     end.
     1692   end procedure.
     1693   def var vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1694   PROCEDURE aht-ostatok :
     1695   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     1696   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     1697   def input parameter x-tog-shift   as   logical             no-undo.
     1698   def input parameter x-date-start  like ub.aht-stk.Fact-date   no-undo.
     1699   def input parameter x-date-end    like ub.aht-stk.Fact-date   no-undo.
     1700   def input parameter x-shift-start as integer               no-undo.
     1701   def input parameter x-shift-end   as integer               no-undo.
     1702   def input parameter x-sum-type    like ub.aht-stk.stk-type    no-undo.
     1703   def input parameter xTog-obj   as log no-undo.
     1704   def output parameter Fact-order  like ub.aht-stk.Fact-order  no-undo.
     1705   def var              Fact-order#   like ub.aht-stk.Fact-order  no-undo.
     1706   def var              Fact-orderS   as char  no-undo.
     1707   def var x-date-start-t  like ub.aht-stk.shift-date   no-undo.
     1708       Assign
     1709         Fact-order   = 0
     1710        .
     1711    x-date-start-t  = x-date-start + 1 .
     1712   IF x-date-end = date('') then DO:
     1713      Fact-order = 0 .
     1714      For each obj-list
     1715          WHERE  (NOT xTog-obj OR
     1716                 (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     1717                 no-lock :
     1718         IF  x-TOG-Shift = False Then DO:
     1719                          find last ub.aht-stk where ub.aht-stk.obj-type = obj-list.obj-type and                                             ub.aht-stk.obj-code = obj-list.obj-code and                                             ub.aht-stk.stk-type = x-sum-type
     1720                               and ub.aht-stk.Fact-date <=  x-date-start
     1721                               and ub.aht-stk.shift-num = 0
     1722                               USE-INDEX obj-date no-lock no-error .
     1723              if Available ub.aht-stk THEN  Assign  Fact-order#  = ub.aht-stk.Fact-order .
     1724         End.
     1725         Else  DO :
     1726             find last ub.aht-stk where ub.aht-stk.obj-type = obj-list.obj-type and                                             ub.aht-stk.obj-code = obj-list.obj-code and                                             ub.aht-stk.stk-type = x-sum-type and
     1727               (ub.aht-stk.shift-date  = x-date-start-t and
     1728               ub.aht-stk.shift-num  < x-shift-start or
     1729               ub.aht-stk.shift-date  < x-date-start-t  )
     1730               and ub.aht-stk.shift-num  > 0
     1731               USE-INDEX obj-Shift no-lock no-error .
     1732            If Available ub.aht-stk then  Assign  Fact-order#  = ub.aht-stk.Fact-order .
     1733           END.
     1734       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     1735     End.
     1736   End.
     1737   Else DO:
     1738     For each obj-list  WHERE
     1739        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     1740         no-lock :
     1741      IF  x-TOG-Shift = False Then DO:
     1742          find last ub.aht-stk where ub.aht-stk.obj-type = obj-list.obj-type and                                             ub.aht-stk.obj-code = obj-list.obj-code and                                             ub.aht-stk.stk-type = x-sum-type and
     1743               ub.aht-stk.Fact-date <= x-date-end
     1744               and ub.aht-stk.shift-num = 0
     1745               USE-INDEX obj-date no-lock no-error.
     1746          If Available ub.aht-stk then  Assign  Fact-order#  = ub.aht-stk.Fact-order .
     1747      END.
     1748      Else DO:
     1749           find last ub.aht-stk where ub.aht-stk.obj-type = obj-list.obj-type and                                             ub.aht-stk.obj-code = obj-list.obj-code and                                             ub.aht-stk.stk-type = x-sum-type and
     1750               (ub.aht-stk.shift-date  = x-date-end and
     1751               ub.aht-stk.shift-num  <= x-shift-end or
     1752               ub.aht-stk.shift-date  < x-date-end       ) and
     1753               ub.aht-stk.shift-num   > 0      use-index obj-Shift no-lock no-error.
     1754               if Available ub.aht-stk THEN Assign  Fact-order#  = ub.aht-stk.Fact-order .
     1755       End.
     1756       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     1757     End.
     1758   End.
     1759   END PROCEDURE.
     1760   define temp-table temp-font no-undo
     1761     field fontnum  as integer
     1762     field fontname as character
     1763     field fontsize as character
     1764     field fonttype as character
     1765     field font-h   as integer
     1766     field font-w   as integer
     1767     field v-row    as integer
     1768     field v-col    as integer
     1769     field v-row-lans as integer
     1770     field v-col-lans as integer
     1771   index pi fontnum
     1772   .
     1773   procedure get-font-ini :
     1774     do
     1775     on error undo, return error return-value
     1776     :
     1777   define variable ii as integer   no-undo .
     1778   define variable v-font7 as character no-undo .
     1779   define variable v-font as character no-undo .
     1780   define variable loc-name as character no-undo .
     1781   define variable loc-size as character no-undo .
     1782   define variable loc-type as character no-undo .
     1783   define variable old_H as integer   no-undo .
     1784   define variable old_w as integer   no-undo .
     1785   define variable old-row  as integer   no-undo .
     1786   define variable old-col  as integer   no-undo .
     1787   define variable old-row-lans  as integer   no-undo .
     1788   define variable old-col-lans  as integer   no-undo .
     1789   define variable vv as integer   no-undo .
     1790   empty temp-table temp-font.
     1791     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     1792       case num-entries (v-font7) :
     1793         when 4 then do:
     1794             assign
     1795               loc-name = entry ( 1 , v-font7 )
     1796               loc-size = entry ( 2 , v-font7 )
     1797               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     1798             .
     1799         end.
     1800         when 3 then do:
     1801             assign
     1802               loc-name = entry ( 1 , v-font7 )
     1803               loc-size = entry ( 2 , v-font7 )
     1804               loc-type = entry ( 3 , v-font7 )
     1805             .
     1806         end.
     1807         when 2 then  do:
     1808             assign
     1809               loc-name = entry ( 1 , v-font7 )
     1810               loc-size = entry ( 2 , v-font7 )
     1811               loc-type = ""
     1812             .
     1813         end.
     1814         when 1 then do:
     1815             assign
     1816               loc-name = trim(entry ( 1 , v-font7 ))
     1817               loc-size = ""
     1818               loc-type = ""
     1819             .
     1820         end.
     1821       end case.
     1822     create temp-font.
     1823     assign
     1824       temp-font.fontnum  = 7
     1825       temp-font.fontname = trim(loc-name)
     1826       temp-font.fontsize = trim(loc-size)
     1827       temp-font.fonttype = trim(loc-type)
     1828       temp-font.v-row    = 62
     1829       temp-font.v-col    = 136
     1830       temp-font.v-row-lans = 43
     1831       temp-font.v-col-lans = 198
     1832     .
     1833     repeat ii = 16 to 100 :
     1834       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     1835       if v-font = "" or v-font = ? then leave.
     1836       case num-entries (v-font) :
     1837         when 4 then do:
     1838             assign
     1839               loc-name = entry ( 1 , v-font )
     1840               loc-size = entry ( 2 , v-font )
     1841               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     1842             .
     1843         end.
     1844         when 3 then do:
     1845             assign
     1846               loc-name = entry ( 1 , v-font )
     1847               loc-size = entry ( 2 , v-font )
     1848               loc-type = entry ( 3 , v-font )
     1849             .
     1850         end.
     1851         when 2 then do:
     1852             assign
     1853               loc-name = entry ( 1 , v-font )
     1854               loc-size = entry ( 2 , v-font )
     1855               loc-type = ""
     1856             .
     1857         end.
     1858         when 1 then do:
     1859             assign
     1860               loc-name = trim(entry ( 1 , v-font ))
     1861               loc-size = ""
     1862               loc-type = ""
     1863             .
     1864         end.
     1865       end case.
     1866     create temp-font.
     1867     assign
     1868       temp-font.fontnum  = ii
     1869       temp-font.fontname = trim(loc-name)
     1870       temp-font.fontsize = trim(loc-size)
     1871       temp-font.fonttype = trim(loc-type)
     1872     .
     1873     end.
     1874       for each temp-font :
     1875          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     1876          if  vv = ? then vv =  0 .
     1877           run rep/exfont.p (
     1878             input   temp-font.fontname ,
     1879             input   vv ,
     1880             input   temp-font.fonttype ,
     1881             output  temp-font.font-h   ,
     1882             output  temp-font.font-w   )
     1883           .
     1884       end.
     1885   find first temp-font where  temp-font.fontnum  = 7  .
     1886   old_H = temp-font.font-H .
     1887   old_w = temp-font.font-W .
     1888   old-row = temp-font.v-row .
     1889   old-col = temp-font.v-col .
     1890   old-row-lans = temp-font.v-row-lans .
     1891   old-col-lans = temp-font.v-col-lans .
     1892       for each temp-font where
     1893                temp-font.fontnum  <> 7 :
     1894           assign
     1895               temp-font.v-row    = old_H * old-row / temp-font.font-h
     1896               temp-font.v-col    = old_W * old-col / temp-font.font-W
     1897               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     1898               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     1899           .
     1900       end.
     1901     end.
     1902   end procedure.
     1903   PROCEDURE How-name :
     1904   define input  parameter h as integer no-undo .
     1905   define input  parameter w as integer no-undo .
     1906   define output parameter n as character  no-undo .
     1907   define variable A4port-H as integer   no-undo init 63.
     1908   define variable A4port-W as integer   no-undo init 136.
     1909   define variable A4lans-H as integer   no-undo init 43.
     1910   define variable A4lans-W as integer   no-undo init 198.
     1911   define variable Strim-W  as integer   no-undo init 278.
     1912   run define-a4-size (
     1913        input ReportFontNum
     1914       ,output A4port-H
     1915       ,output A4port-W
     1916       ,output A4lans-H
     1917       ,output A4lans-W ).
     1918   If w >= 1 and w <= A4port-W Then DO:
     1919     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1920     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     1921     If h > A4port-H              Then n = "to-file":U.
     1922   End.
     1923   If w > A4port-W and w <= A4lans-W Then DO:
     1924     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1925     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1926     If h > A4port-H              Then n = "to-file":U.
     1927   End.
     1928   If w > A4lans-W and w <= Strim-W Then DO:
     1929     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     1930     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1931     If h > A4port-H              Then n = "to-file":U.
     1932   End.
     1933   If w > Strim-W Then DO:
     1934      n = "to-file":U.
     1935   End.
     1936   END PROCEDURE.
     1937   PROCEDURE define-a4-size :
     1938   define input  parameter p-ReportFontNum as integer   no-undo .
     1939   define output parameter A4port-H as integer   no-undo .
     1940   define output parameter A4port-W as integer   no-undo .
     1941   define output parameter A4lans-H as integer   no-undo .
     1942   define output parameter A4lans-W as integer   no-undo .
     1943   if not can-find (first temp-font ) then do:
     1944      run get-font-ini .
     1945   end.
     1946   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     1947   if available temp-font then do:
     1948   assign
     1949     A4port-H = temp-font.v-row
     1950     A4port-W = temp-font.v-col
     1951     A4lans-H = temp-font.v-row-lans
     1952     A4lans-W = temp-font.v-col-lans
     1953   .
     1954   end.
     1955   else do:
     1956   assign
     1957     A4port-H = 63
     1958     A4port-W = 136
     1959     A4lans-H = 43
     1960     A4lans-W = 198
     1961   .
     1962   end.
     1963   END PROCEDURE.
