     3808                 if sums-only then do:
     3809                     if fr0 = true then do:
     3810                         run proc-prt-3 .
     3811                         fr0 = false .
     3812                       end.
     3813                  end.
     3814                 tmp#stroka = "Итого по " + (if string(entry(2,"gds-list.grp-name",".")) <> "grp-name":u then "произв." + gds-zap-prod-name else "группе " + gds-zap-grp-name).
     3815                 run proc-prt-1.
     3816           end.
     3817         end.
     3818       if last-of((substring(clients.obj-name,1,10) + string(gds-obj.prod-code))) then do:
     3819               if  not (not show-negativ  and
     3820               ( tot-2-1 = 0 and
     3821                 tot-2-2 = 0 and
     3822                 tot-2-4 = 0 and
     3823                 tot-2-5 = 0 and
     3824                 tot-2-3 = 0 )) then do:
     3825                 tmp#stroka = "Итого по " + (if string(entry(2,"(substring(clients.obj-name,1,10) + string(gds-obj.prod-code))",".")) <> "grp-name" then "произв." + gds-zap-prod-name else "группе " + gds-zap-grp-name ).
     3826                 run proc-prt-2.
     3827             end.
     3828                 assign  break_group1 = true
     3829                               tot-2-1=0
     3830                               tot-2-2=0
     3831                               tot-2-3=0
     3832                               tot-2-4=0
     3833                               tot-2-5=0.
     3834                 if not sums-only then run u-line .
     3835       end.
     3836   end.
     3837      end.
     3838         End case.
     3839    end.
     3840   END PROCEDURE.
     3841   procedure proc-prt-1 :
     3842    do
     3843    on error undo, return error return-value
     3844    :
     3845    run new-tmp-page .
     3846         DISPLAY stream  OutStream sym11 sym1 sym5 sym6 sym7 sym8 sym9 sym10
     3847                 substring(tmp#stroka,1,16)  @  gds-zap-artic
     3848                 substring(tmp#stroka,17,60)  @  gds-zap-gds-name
     3849                 Tot-1-1     @  gds-zap-qnty
     3850                 Tot-1-2     @  gds-zap-stoim-base
     3851                 Tot-1-4     @  gds-zap-Nds
     3852                 Tot-1-5     @  gds-zap-Np
     3853                 Tot-1-3     @  tot_tqnty
     3854                 with FRAME  zapas    .
     3855         DOWN stream  OutStream 1 with FRAME zapas    .
     3856         assign
     3857           num#str# = num#str# + 1
     3858           num#col# =  1
     3859           var-1 = num#str#
     3860           var-2 = num#col#
     3861         .
     3862         run macr_excel_char( tmp#stroka, num#str# , num#col# ). assign   num#col# = num#col# + 5.
     3863         run macr_excel_dec ( Tot-1-1 , num#str# , num#col# ) . assign   num#col# = num#col# + 2.
     3864         run macr_excel_dec ( round(Tot-1-2,2) , num#str# , num#col# ) . assign   num#col# = num#col# + 1.
     3865         run macr_excel_dec ( round(Tot-1-4,2) , num#str# , num#col# ) . assign   num#col# = num#col# + 1.
     3866         run macr_excel_dec ( round(Tot-1-5,2) , num#str# , num#col# ) . assign   num#col# = num#col# + 2.
     3867         run macr_excel_dec ( round(Tot-1-3,2) , num#str# , num#col# ) . assign   num#col# = num#col# + 1.
     3868         run macr_cell_format
     3869             ( 10    ,
     3870               true  ,
     3871               true  ,
     3872               ?     ,
     3873               var-1 ,
     3874               var-2 ,
     3875               num#str# ,
     3876               num#col# ) .
     3877       IF NOT Sums-Only THEN Run U-LINE.
     3878       Assign break_group = true
     3879         Tot-1-1=0
     3880         Tot-1-2=0
     3881         Tot-1-3=0
     3882         Tot-1-4=0
     3883         Tot-1-5=0 .
     3884    end.
     3885   end procedure.
     3886   procedure proc-prt-2 :
     3887    do
     3888    on error undo, return error return-value
     3889    :
     3890   run new-tmp-page .
     3891   DISPLAY stream  OutStream sym11 sym1 sym5 sym6 sym7 sym8 sym9 sym10
     3892             substring(tmp#stroka,1,10)   @  gds-zap-b-code
     3893             substring(tmp#stroka,11,18)  @  gds-zap-artic
     3894             substring(tmp#stroka,29,60)  @  gds-zap-gds-name
     3895             Tot-2-1     @  gds-zap-qnty
     3896             Tot-2-2     @  gds-zap-stoim-base
     3897             Tot-2-4     @  gds-zap-Nds
     3898             Tot-2-5     @  gds-zap-Np
     3899             Tot-2-3     @  tot_tqnty
     3900             with FRAME  zapas    .
     3901   DOWN stream  OutStream 1 with FRAME zapas    .
     3902     assign
     3903     num#str# = num#str# + 1
     3904     num#col# =  1
     3905     var-1 = num#str#
     3906     var-2 = num#col#
     3907     .
     3908     run macr_excel_char( tmp#stroka, num#str# , num#col# ). assign   num#col# = num#col# + 5.
     3909     run macr_excel_dec ( Tot-2-1 , num#str# , num#col# ) . assign   num#col# = num#col# + 2.
     3910     run macr_excel_dec ( round(Tot-2-2,2) , num#str# , num#col# ) . assign   num#col# = num#col# + 1.
     3911     run macr_excel_dec ( round(Tot-2-4,2) , num#str# , num#col# ) . assign   num#col# = num#col# + 1.
     3912     run macr_excel_dec ( round(Tot-2-5,2) , num#str# , num#col# ) . assign   num#col# = num#col# + 2.
     3913     run macr_excel_dec ( round(Tot-2-3,2) , num#str# , num#col# ) . assign   num#col# = num#col# + 1.
     3914     run macr_cell_format
     3915         ( 10    ,
     3916           true  ,
     3917           true  ,
     3918           ?     ,
     3919           var-1 ,
     3920           var-2 ,
     3921           num#str# ,
     3922           num#col# ) .
     3923    end.
     3924   end procedure.
     3925   procedure proc-prt-3 :
     3926    do
     3927    on error undo, return error return-value
     3928    :
     3929     PUT stream  OutStream  tmp#stroka0 format "X(100)" SKIP.
     3930     assign
     3931     num#str# = num#str# + 1
     3932     num#col# =  1
     3933     var-1 = num#str#
     3934     var-2 = num#col#
     3935     .
     3936     run macr_excel_char( tmp#stroka0, num#str# , num#col# ). assign   num#col# = num#col# + 5.
     3937     run macr_cell_format
     3938     ( 10    ,
     3939       true  ,
     3940       true  ,
     3941       40    ,
     3942       var-1 ,
     3943       var-2 ,
     3944       num#str# ,
     3945       num#col# ) .
     3946    end.
     3947   end procedure.
     3948   procedure new-tmp-page :
     3949    do
     3950    on error undo, return error return-value
     3951    :
     3952       if   num#str#  >= 63000 then do:
     3953           Output stream Macr_Excel  close .
     3954           run paramls-write in this-procedure
     3955             (input "file"
     3956             ,input string(v-ind)
     3957             ,input v-file-name
     3958             ) .
     3959           run gbl/_tmpfile.p ("wb", ".txt", output v-file-name) .
     3960           output stream  Macr_Excel to value(v-file-name) .
     3961           v-ind = v-ind + 1 .
     3962           num#str# = 0 .
     3963           run proc-print-header-my.
     3964       end.
     3965    end.
     3966   end procedure.
     3967   procedure proc-print-header-my :
     3968    do
     3969    on error undo, return error return-value
     3970    :
     3971      find first sheetf .
     3972        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     3973        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     3974        var-1 =  num#str# .
     3975        repeat c-c = 1 to sheetf.excel-row-title :
     3976        num#str# = num#str# + 1 .
     3977        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     3978        do c-i = 1 to p-var :
     3979           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     3980           str--2 = integer(entry( c-i, sheetf.sizes )) .
     3981           num#col# = c-i .
     3982           run macr_excel_char( str--1  , num#str# , num#col#  ) .
     3983           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     3984        end.
     3985       c-i = 0.
     3986       end.
     3987       run macr_cell_format (
     3988           10       ,
     3989           true     ,
     3990           false    ,
     3991           35       ,
     3992           var-1 + 1,
     3993           1        ,
     3994           num#str# ,
     3995           num#col# )
     3996           .
     3997     put  stream macr_excel unformatted
     3998          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     3999           'BORDER( 2 , 2 , 2 , 2 , 2 , ,0,0,0,0,0) '  + chr(10) +
     4000          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     4001          .
     4002    end.
     4003   end procedure.
     4004   PROCEDURE report-execute :
     4005    do
     4006    on error undo, return error return-value
     4007    :
     4008   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4009   case x-set_pay_type :
     4010     when 1 then do:
     4011           tprintrubl = ( var-report-r-b = 'rubl':U ) .
     4012     end.
     4013     when 2 or when 3 then do:
     4014           if x-set_val_type = 1  then tprintrubl = yes .
     4015           if x-set_val_type = 2  then tprintrubl = no  .
     4016     end.
     4017   end case.
     4018       run gbl/_tmpfile.p ("wb", ".txt", output v-file-name) .
     4019       output stream macr_excel to value(v-file-name)   .
     4020       v-ind = 1    .
     4021       num#str# = 0 .
     4022   output stream OutStream to value( string( session:temp-directory +
     4023                                        "rpt" + string( g#report-num ) ) )
     4024                                        page-size  value(ReportPageHeight) .
     4025     FORM with FRAME zapas .
     4026     Line = fill("-", 187).
     4027   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4028   form header
     4029     line format "X(187)" at 1 skip
     4030     "Продолжение - на следующей странице" at 30 skip
     4031     with frame bottomframe width 232 page-bottom no-labels no-box .
     4032   view stream outstream frame bottomframe .
     4033     FIND First ub.clients where
     4034                x-store-type = ub.clients.obj-type AND
     4035                x-store-code = ub.clients.obj-code no-lock no-error.
     4036       If available ub.clients then  ObjName = ub.clients.obj-name.
     4037                            else  ObjName="объект не определен".
     4038     Run Print-Header .
     4039         num#str# = num#str# + 1 .
     4040         num#col# =  1 .
     4041         run macr_excel_char_with_format( ReportNAme , num#str# , num#col#  ).
     4042         run macr_cell_format
     4043             ( 12    ,
     4044               true  ,
     4045               false ,
     4046               ?     ,
     4047               num#str# ,
     4048               num#col# ,
     4049               ? ,
     4050               ?         ) .
     4051   define variable l-ii  as integer no-undo .
     4052   define variable l-jj  as integer no-undo .
     4053   define variable l-len as integer no-undo .
     4054   define variable l-m   as integer no-undo .
     4055   define variable v-nn as integer   no-undo .
     4056   v-nn =  num-entries( str1 , "chr(10)"  )   .   do l-ii = 1 to v-nn :        l-len = length (entry( l-ii , str1  , "chr(10)")) .                       l-m = integer( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format(                                                                        substring(entry( l-ii , str1  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     4057   v-nn =  num-entries( str2 , "chr(10)"  )   .   do l-ii = 1 to v-nn :        l-len = length (entry( l-ii , str2  , "chr(10)")) .                       l-m = integer( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format(                                                                        substring(entry( l-ii , str2  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     4058   v-nn =  num-entries( str3 , "chr(10)"  )   .   do l-ii = 1 to v-nn :        l-len = length (entry( l-ii , str3  , "chr(10)")) .                       l-m = integer( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format(                                                                        substring(entry( l-ii , str3  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     4059   v-nn =  num-entries( str4 , "chr(10)"  )   .   do l-ii = 1 to v-nn :        l-len = length (entry( l-ii , str4  , "chr(10)")) .                       l-m = integer( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format(                                                                        substring(entry( l-ii , str4  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     4060   v-nn =  num-entries( reportheader , "chr(10)"  )   .   do l-ii = 1 to v-nn :        l-len = length (entry( l-ii , reportheader  , "chr(10)")) .                       l-m = integer( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format(                                                                        substring(entry( l-ii , reportheader  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     4061     num#str# = num#str# + 1.
     4062     num#col# = 1.
     4063     run macr_excel_char_with_format( string(
     4064         cur-time-print()  +
     4065         " Цены указаны в " +
     4066         (if tPrintRubl then "руб" else x-base-type )  )
     4067         , num#str#
     4068         , num#col#
     4069           ) .
     4070      Run proc-print-header-my.
     4071      For each obj-list no-lock :
     4072         x-store-type  =  obj-list.obj-type .
     4073         x-store-code  =  obj-list.obj-code .
     4074         FIND First ub.clients where x-store-type = ub.clients.obj-type AND
     4075                                  x-store-code = ub.clients.obj-code no-lock no-error.
     4076           If available ub.clients then  ObjName = ub.clients.obj-name.
     4077                                else  ObjName = "объект не определен".
     4078         PUT stream OutStream  string(  "ПО ОБЬЕКТУ : (" + x-store-type  + string(x-store-code)  +  ") " + ObjName) at 2 format "x(100)" chr(10) .
     4079          CASE RetClassify :
     4080             when "no-classify":U  then DO:
     4081               run run1 in this-procedure .
     4082               End.
     4083             when "grp-goods":U then DO:
     4084               run run2 in this-procedure .
     4085               END.
     4086             when "prod":U then DO:
     4087               run run3 in this-procedure .
     4088               End.
     4089             when "prod/grp-goods":U then DO:
     4090               run run4 in this-procedure .
     4091               end.
     4092             when "grp-goods/prod":u then do:
     4093               end.
     4094         End case.
     4095         Run Print-footer-o.
     4096     End.
     4097     HIDE stream OutStream FRAME BottomFrame .
     4098     Run Print-footer.
     4099     HIDE STREAM   OutStream   FRAME ZAPAS .
     4100     Output stream OutStream   close .
     4101     Output stream Macr_Excel  close .
     4102   if mFrameView
     4103   then do:
     4104      HIDE FRAME InfoFrame.
     4105   end.
     4106       run paramls-write in this-procedure
     4107         (input "file"
     4108         ,input string(v-ind)
     4109         ,input v-file-name
     4110         ) .
     4111       run paramls-write in this-procedure
     4112           (input "charcol"
     4113           ,input ""
     4114           ,input "2,3,4,5"
     4115           ) .
     4116     run end-proc .
     4117     define variable v-user-action as character no-undo .
     4118     define variable v-printed as logical   no-undo .
     4119     define variable DisabledOptions as integer   no-undo .
     4120     define variable v-orient-page as character no-undo .
     4121     run How-name in this-procedure (
     4122         input ReportPageHeight,
     4123         input ReportPageWidth,
     4124         output v-orient-page )
     4125         .
     4126     if v-orient-page = "A4-lans":U then DisabledOptions = 8 .
     4127                                    else DisabledOptions = 0 .
     4128     run gbl/prnfilen.w
     4129       (input  ""
     4130       ,input  DisabledOptions
     4131       ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     4132       ,input REportFontNum
     4133       ,output v-user-action
     4134       ,output v-printed
     4135       ) .
     4136    end.
     4137   END PROCEDURE.
     4138   procedure one-type :
     4139    do
     4140    on error undo, return error return-value
     4141    :
     4142    FIND LAST  ub.aht-stk-line where
     4143                           ub.aht-stk-line.gds-code   = gds-zap-b-code
     4144                     AND   ub.aht-stk-line.fact-order <= fact-order-2
     4145                     AND   ub.aht-stk-line.obj-code   = x-store-code
     4146                     AND   ub.aht-stk-line.obj-type   = x-store-type
     4147                     AND   ub.aht-stk-line.sum-type   = p-type-pr
     4148                           USE-INDEX category no-lock no-error.
     4149           IF AVAILABLE ub.aht-stk-line Then DO:
     4150               IF  tPrintRubl  THEN
     4151                     ASSIGN gds-zap-qnty       =  ub.aht-stk-line.fact-qnty
     4152                           gds-zap-stoim-base  = IF PayType = 2  then  ub.aht-stk-line.cost-sum-rubl
     4153                                                                 else  ub.aht-stk-line.crsa-sum-rubl
     4154                           gds-zap-Nds         = IF PayType = 2  then  ub.aht-stk-line.cost-VAT-rubl
     4155                                                                 else  ub.aht-stk-line.crsa-VAT-rubl
     4156                           gds-zap-Np          = IF PayType = 2  then  ub.aht-stk-line.cost-SLT-rubl
     4157                                                                 else  ub.aht-stk-line.crsa-SLT-rubl  .
     4158                 ELSE
     4159                     ASSIGN gds-zap-qnty       =  ub.aht-stk-line.fact-qnty
     4160                           gds-zap-stoim-base  = IF PayType = 2  then ub.aht-stk-line.cost-sum-base
     4161                                                                 else ub.aht-stk-line.crsa-sum-base
     4162                           gds-zap-Nds         = IF PayType = 2  then ub.aht-stk-line.cost-VAT-base
     4163                                                                 else ub.aht-stk-line.crsa-VAT-base
     4164                           gds-zap-Np          = IF PayType = 2  then ub.aht-stk-line.cost-SLT-base
     4165                                                                else  ub.aht-stk-line.crsa-SLT-base .
     4166                End.
     4167             Else ASSIGN gds-zap-qnty       = 0
     4168                         gds-zap-price-base = 0
     4169                         gds-zap-price-nds  = 0
     4170                         gds-zap-stoim-base = 0
     4171                         gds-zap-Nds        = 0
     4172                         gds-zap-Np         = 0 .
     4173           Assign
     4174             gds-zap-price-base = if (gds-zap-qnty <> 0) Then (gds-zap-stoim-base / gds-zap-qnty) Else 0
     4175             tot_tqnty          = gds-zap-stoim-base - gds-zap-Nds
     4176             gds-zap-price-nds = if (gds-zap-qnty <> 0) Then (tot_tqnty / gds-zap-qnty)  Else 0
     4177             .
     4178    end.
     4179   end procedure.
     4180   procedure many-type :
     4181    do
     4182    on error undo, return error return-value
     4183    :
     4184    define variable tt as integer no-undo .
     4185    define variable tv as character no-undo .
     4186    ASSIGN gds-zap-qnty       = 0
     4187       gds-zap-price-base = 0
     4188       gds-zap-price-nds  = 0
     4189       gds-zap-stoim-base = 0
     4190       gds-zap-Nds        = 0
     4191       gds-zap-Np         = 0 .
     4192   define variable v-1 as integer   no-undo .
     4193   v-1 = num-entries(p-type-pr)  .
     4194    do tt = 1 to v-1 :
     4195    tv = entry(tt,p-type-pr) .
     4196    FIND LAST  ub.aht-stk-line where
     4197                           ub.aht-stk-line.gds-code   = gds-zap-b-code
     4198                     AND   ub.aht-stk-line.fact-order <= fact-order-2
     4199                     AND   ub.aht-stk-line.obj-code   = x-store-code
     4200                     AND   ub.aht-stk-line.obj-type   = x-store-type
     4201                     AND   ub.aht-stk-line.sum-type   = tv
     4202                           USE-INDEX category no-lock no-error.
     4203           IF AVAILABLE ub.aht-stk-line Then DO:
     4204               IF  tPrintRubl  THEN
     4205                     ASSIGN gds-zap-qnty        = gds-zap-qnty      +  (if ub.aht-stk-line.sum-type <> "b"
     4206                                                                           then  ub.aht-stk-line.fact-qnty else 0 )
     4207                            gds-zap-stoim-base  = gds-zap-stoim-base + IF PayType = 2  then  ub.aht-stk-line.cost-sum-rubl
     4208                                                                                       else  ub.aht-stk-line.crsa-sum-rubl
     4209                            gds-zap-Nds         = gds-zap-Nds        + IF PayType = 2  then  ub.aht-stk-line.cost-VAT-rubl
     4210                                                                                       else  ub.aht-stk-line.crsa-VAT-rubl
     4211                            gds-zap-Np          = gds-zap-Np         + IF PayType = 2  then  ub.aht-stk-line.cost-SLT-rubl
     4212                                                                                       else  ub.aht-stk-line.crsa-SLT-rubl  .
     4213                 ELSE
     4214                     ASSIGN gds-zap-qnty        = gds-zap-qnty       + (if ub.aht-stk-line.sum-type <> "b"
     4215                                                                           then  ub.aht-stk-line.fact-qnty else 0 )
     4216                            gds-zap-stoim-base  = gds-zap-stoim-base + IF PayType = 2  then ub.aht-stk-line.cost-sum-base
     4217                                                                                       else ub.aht-stk-line.crsa-sum-base
     4218                            gds-zap-Nds         = gds-zap-Nds        + IF PayType = 2  then ub.aht-stk-line.cost-VAT-base
     4219                                                                                       else ub.aht-stk-line.crsa-VAT-base
     4220                            gds-zap-Np          = gds-zap-Np         + IF PayType = 2  then ub.aht-stk-line.cost-SLT-base
     4221                                                                else ub.aht-stk-line.crsa-SLT-base .
     4222                End.
     4223           Assign
     4224             gds-zap-price-base = if (gds-zap-qnty <> 0) Then (gds-zap-stoim-base / gds-zap-qnty) Else 0
     4225             tot_tqnty          = gds-zap-stoim-base - gds-zap-Nds
     4226             gds-zap-price-nds = if (gds-zap-qnty <> 0) Then  ( tot_tqnty / gds-zap-qnty )  Else 0
     4227             .
     4228      end.
     4229    end.
     4230   end procedure.
     4231   def var vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4232   procedure macr_excel_char :
     4233    do
     4234    on error undo, return error return-value
     4235    :
     4236    define input parameter  p-val as character no-undo .
     4237    define input parameter  p-row as integer no-undo .
     4238    define input parameter  p-col as integer no-undo .
     4239    if p-val = ? then p-val = "" .
     4240       put stream macr_excel unformatted
     4241             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     4242    end.
     4243   end procedure.
     4244   procedure macr_excel_char_with_format :
     4245    do
     4246    on error undo, return error return-value
     4247    :
     4248    define input parameter  p-val as character no-undo .
     4249    define input parameter  p-row as integer no-undo .
     4250    define input parameter  p-col as integer no-undo .
     4251    if p-val = ? then p-val = "" .
     4252       put stream macr_excel unformatted
     4253             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     4254       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     4255       put stream macr_excel unformatted
     4256             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     4257    end.
     4258   end procedure.
     4259   procedure macr_excel_cell_format :
     4260    do
     4261    on error undo, return error return-value
     4262    :
     4263    define input parameter  p-val    as character no-undo .
     4264    define input parameter  p-row    as integer   no-undo .
     4265    define input parameter  p-col    as integer   no-undo .
     4266    define input parameter  p-format as character no-undo .
     4267    if p-val = ? then p-val = "" .
     4268       put stream macr_excel unformatted
     4269             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     4270       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     4271       put stream macr_excel unformatted
     4272             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     4273    end.
     4274   end procedure.
     4275   procedure macr_excel_sum :
     4276    do
     4277    on error undo, return error return-value
     4278    :
     4279    define input parameter  p-row as integer no-undo .
     4280    define input parameter  p-col as integer no-undo .
     4281    define input parameter  p-row1 as integer no-undo .
     4282    define input parameter  p-col1 as integer no-undo .
     4283    define input parameter  p-row2 as integer no-undo .
     4284    define input parameter  p-col2 as integer no-undo .
     4285       put stream macr_excel unformatted
     4286             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     4287    end.
     4288   end procedure.
     4289   procedure macr_excel_dec :
     4290    do
     4291    on error undo, return error return-value
     4292    :
     4293    define input parameter  p-val as character no-undo .
     4294    define input parameter  p-row as integer   no-undo .
     4295    define input parameter  p-col as integer   no-undo .
     4296     if p-val = ? then p-val =  "" .
     4297      put  stream macr_excel unformatted
     4298           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     4299    end.
     4300   end procedure.
     4301   procedure macr_cell_format :
     4302    do
     4303    on error undo, return error return-value
     4304    :
     4305    define input parameter  p-size   as integer   no-undo .
     4306    define input parameter  p-bold   as logical   no-undo .
     4307    define input parameter  p-italic as logical   no-undo .
     4308    define input parameter  p-color  as integer   no-undo .
     4309    define input parameter  p-row    as integer   no-undo .
     4310    define input parameter  p-col    as integer   no-undo .
     4311    define input parameter  p-row-2  as integer   no-undo .
     4312    define input parameter  p-col-2  as integer   no-undo .
     4313     if p-size = ? then p-size = 10 .
     4314     if p-bold = ? then p-bold = false .
     4315     if p-italic = ? then p-italic = false .
     4316     if p-row-2 = ? then p-row-2 = p-row .
     4317     if p-col-2 = ? then p-col-2 = p-col .
     4318     put  stream macr_excel unformatted
     4319      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     4320     if p-color <> ? then do:
     4321        put  stream macr_excel unformatted
     4322          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     4323     end.
     4324     put  stream macr_excel unformatted
     4325          substitute('format.font(,&1,&2,&3)' , p-size,
     4326                                           string ( p-bold  , "true/false" ) ,
     4327                                           string ( p-italic , "true/false" )
     4328                                           ) + chr(10) .
     4329    end.
     4330   end procedure.
     4331   procedure macr_cell_size :
     4332    do
     4333    on error undo, return error return-value
     4334    :
     4335    define input parameter  p-w   as integer   no-undo .
     4336    define input parameter  p-l   as integer   no-undo .
     4337    define input parameter  p-row    as integer   no-undo .
     4338    define input parameter  p-col    as integer   no-undo .
     4339    define input parameter  p-row-2  as integer   no-undo .
     4340    define input parameter  p-col-2  as integer   no-undo .
     4341     if p-row-2 = ? then p-row-2 = p-row .
     4342     if p-col-2 = ? then p-col-2 = p-col .
     4343     if p-w = ? then    p-w = 0 .
     4344     if p-l = ? then    p-l = 0 .
     4345    define variable s-w as character no-undo .
     4346    define variable s-l as character no-undo .
     4347    if p-w = 0 then s-w = "" .
     4348               else s-w = string(p-w)  .
     4349    if p-l = 0 then s-l = "" .
     4350               else s-l = string(p-l)  .
     4351   put  stream macr_excel unformatted
     4352        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     4353   put  stream macr_excel unformatted
     4354        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     4355   put  stream macr_excel unformatted
     4356        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     4357    end.
     4358   end procedure.
     4359   procedure proc-print-header :
     4360    do
     4361    on error undo, return error return-value
     4362    :
     4363      find first sheetf .
     4364        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     4365        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     4366        var-1 =  num#str# .
     4367        repeat c-c = 1 to sheetf.excel-row-title :
     4368        num#str# = num#str# + 1 .
     4369        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     4370        do c-i = 1 to p-var :
     4371           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     4372           str--2 = integer(entry( c-i, sheetf.sizes )) .
     4373           num#col# = c-i .
     4374           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     4375           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     4376        end.
     4377       c-i = 0.
     4378       end.
     4379       run macr_cell_format (
     4380           10       ,
     4381           true     ,
     4382           false    ,
     4383           35       ,
     4384           var-1 + 1,
     4385           1        ,
     4386           num#str# ,
     4387           num#col# )
     4388           .
     4389     put  stream macr_excel unformatted
     4390          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     4391          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     4392          .
     4393    end.
     4394   end procedure.
     4395   procedure end-proc :
     4396    do
     4397    on error undo, return error return-value
     4398    :
     4399     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     4400     OUTPUT to VALUE (v-file-name) .
     4401     for each temp-param :
     4402       export  temp-param  .
     4403     end.
     4404    end.
     4405   end procedure.
