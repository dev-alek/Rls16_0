     1245         (input  parparentproc
     1246         ,input  this-procedure :handle
     1247         ,input  p-db-num
     1248         ,input  p-user-id
     1249         ,input  p-host-code-obj
     1250         ,input  p-obj-type
     1251         ,input  p-obj-code
     1252         ,INPUT  "b-sel,b-mark"
