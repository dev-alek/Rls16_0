     1389        RADIO-SET-1 AT ROW 12.21 COL 55.38 NO-LABEL
     1390        RADIO-AltObj AT ROW 12.25 COL 3.88 NO-LABEL
     1391        ShowZero at row 13 col 32
     1392        SumsOnly AT ROW 14 COL 32
     1393        no-nds AT ROW 15 COL 32
     1394        B-columns AT ROW 16.5 COL 3
     1395        TOGGLE-1 AT ROW 16.63 COL 31.63
     1396        FILL-IN-31 AT ROW 5.54 COL 51.63 NO-LABEL
     1397        FILL-IN-30 AT ROW 10.88 COL 4 NO-LABEL
     1398        FILL-IN-33 AT ROW 10.88 COL 32.38 NO-LABEL
     1399        FILL-IN-32 AT ROW 10.92 COL 53.5 NO-LABEL
     1400        "Сортировка :" VIEW-AS TEXT
     1401             size 13.63 by 0.75 at row 1.46 col 51.5
     1402             FGCOLOR 4
     1403        "Классификация :":C47 VIEW-AS TEXT
     1404             size 46.25 by 0.75 at row 1.42 col 2.5
     1405             FGCOLOR 4
     1406        RECT-7 AT ROW 5.38 COL 50.5
     1407        RECT-5 AT ROW 1.21 COL 1.75
     1408        RECT-8 AT ROW 10.63 COL 1.75
     1409        RECT-6 AT ROW 1.21 COL 50.38
     1410       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1411            SIDE-LABELS NO-UNDERLINE THREE-D
     1412            AT COL 1 ROW 1 SCROLLABLE .
     1413   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1414   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1415   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1416   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1417   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1418   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1419   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1420   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1421         adm-object-hdl = FRAME F-Main:HANDLE.
     1422   RUN ensure-broker.
     1423   THIS-PROCEDURE:ADM-DATA =
     1424        'ADM1.1~`':U +
     1425        'SmartObject~`':U +
     1426        '~`':U +
     1427        'NO ~`':U +
     1428        '~`':U +
     1429        '~`':U +
     1430        '~`':U +
     1431        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1432           + "~`":U +
     1433        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
     1434        'Record-Source,Record-Target,TableIO-Target~`':U +
     1435        '~`':U +
     1436        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1437        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1438            THEN "^^":U
     1439        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1440             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1441   PROCEDURE adm-apply-entry :
     1442     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1443   END PROCEDURE.
     1444   PROCEDURE adm-destroy :
     1445    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1446   END PROCEDURE.
     1447   PROCEDURE adm-disable :
     1448       DISABLE RECT-7 RECT-5 RECT-8 RECT-6 SortType Tog-obj Classify RADIO-Nomenkl ShowZero-2 RADIO-SET-1 RADIO-AltObj B-columns TOGGLE-1 FILL-IN-31 FILL-IN-30 FILL-IN-33 FILL-IN-32 no-nds WITH FRAME F-Main.
     1449       RUN dispatch ('disable-fields':U).
     1450       RUN set-attribute-list ('ENABLED=no':U).
     1451       RETURN.
     1452   END PROCEDURE.
     1453   PROCEDURE adm-edit-attribute-list :
     1454         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
     1455         RETURN.
     1456   END PROCEDURE.
     1457   PROCEDURE adm-enable :
     1458       ENABLE UNLESS-HIDDEN RECT-7 RECT-5 RECT-8 RECT-6 SortType Tog-obj Classify RADIO-Nomenkl ShowZero-2 RADIO-SET-1 RADIO-AltObj B-columns TOGGLE-1 FILL-IN-31 FILL-IN-30 FILL-IN-33 FILL-IN-32 no-nds WITH FRAME F-Main.
     1459       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1460       RUN set-attribute-list ('ENABLED=yes':U).
     1461       RETURN.
     1462   END PROCEDURE.
     1463   PROCEDURE adm-exit :
     1464        RUN notify ('exit':U).
     1465     RETURN.
     1466   END PROCEDURE.
     1467   PROCEDURE adm-hide :
     1468     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1469   END PROCEDURE.
     1470   PROCEDURE adm-initialize :
     1471     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1472   END PROCEDURE.
     1473   PROCEDURE adm-show-errors :
     1474       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1475       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1476           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1477       END.
     1478       RETURN.
     1479   END PROCEDURE.
     1480   PROCEDURE adm-UIB-mode :
     1481     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1482   END PROCEDURE.
     1483   PROCEDURE adm-view :
     1484     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1485   END PROCEDURE.
     1486   PROCEDURE dispatch :
     1487       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1488       RUN broker-dispatch IN adm-broker-hdl
     1489           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1490       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1491   END PROCEDURE.
     1492   PROCEDURE ensure-broker :
     1493   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1494   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1495   DO:
     1496       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1497       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1498   END.
     1499   END PROCEDURE.
     1500   PROCEDURE get-attribute :
     1501     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1502     RUN broker-get-attribute IN adm-broker-hdl
     1503         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1504     RETURN RETURN-VALUE.
     1505   END PROCEDURE.
     1506   PROCEDURE get-attribute-list :
     1507     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1508     RUN broker-get-attribute-list IN adm-broker-hdl
     1509         (INPUT THIS-PROCEDURE,
     1510          INPUT ?,
     1511          OUTPUT p-attr-list) NO-ERROR.
     1512     RETURN.
     1513   END PROCEDURE.
     1514   PROCEDURE new-state :
     1515     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1516     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1517     RETURN.
     1518   END PROCEDURE.
     1519   PROCEDURE notify :
     1520     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1521     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1522     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1523         RETURN "ADM-ERROR":U.
     1524     RETURN.
     1525   END PROCEDURE.
     1526   PROCEDURE set-attribute-list :
     1527     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1528     RUN ensure-broker.
     1529     RUN broker-set-attribute-list IN adm-broker-hdl
     1530         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1531     RETURN.
     1532   END PROCEDURE.
     1533   PROCEDURE set-position :
     1534       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1535       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1536       IF VALID-HANDLE(adm-object-hdl) THEN
     1537       DO:
     1538         ASSIGN adm-object-hdl:ROW    =   p-row
     1539                adm-object-hdl:COLUMN =   p-col.
     1540       END.
     1541       RETURN.
     1542   END PROCEDURE.
     1543   PROCEDURE adm-display-fields :
     1544       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1545       RETURN.
     1546   END PROCEDURE.
     1547   PROCEDURE adm-open-query :
     1548     RETURN.
     1549   END PROCEDURE.
     1550   PROCEDURE adm-row-changed :
     1551         IF VALID-HANDLE(adm-object-hdl) THEN
     1552           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1553         RUN notify ('row-available':U).
     1554         RETURN.
     1555   END PROCEDURE.
     1556   PROCEDURE reposition-query :
     1557       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1558       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1559       RETURN.
     1560   END PROCEDURE.
     1561     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1562     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1563     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1564     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1565     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1566     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1567     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1568     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1569     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1570     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1571     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1572     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1573     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1574     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1575     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1576     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1577     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1578     IF "":U = "":U THEN
     1579       RUN modify-list-attribute IN adm-broker-hdl
     1580         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1581     RUN use-create-on-add(?).
     1582   PROCEDURE adm-add-record :
     1583       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1584          "must have at least one Enabled Table to perform Add.":U
     1585          VIEW-AS ALERT-BOX ERROR.
     1586       RETURN.
     1587   END PROCEDURE.
     1588   PROCEDURE adm-assign-record :
     1589    MESSAGE
     1590          "Object ":U THIS-PROCEDURE:FILE-NAME
     1591            "must have at least one Enabled Table to perform Assign.":U
     1592              VIEW-AS ALERT-BOX ERROR.
     1593      RETURN.
     1594     END PROCEDURE.
     1595   PROCEDURE adm-assign-statement :
     1596     RETURN.
     1597   END PROCEDURE.
     1598   PROCEDURE adm-cancel-record :
     1599      RETURN.
     1600     END PROCEDURE.
     1601   PROCEDURE adm-copy-record :
     1602       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1603        "must have at least one Enabled Table to perform Copy.":U
     1604          VIEW-AS ALERT-BOX ERROR.
     1605       RETURN.
     1606   END PROCEDURE.
     1607   PROCEDURE adm-create-record :
     1608      RETURN.
     1609   END PROCEDURE.
     1610   PROCEDURE adm-current-changed :
     1611     RETURN.
     1612   END PROCEDURE.
     1613   PROCEDURE adm-delete-record :
     1614    MESSAGE
     1615          "Object ":U THIS-PROCEDURE:FILE-NAME
     1616            "must have at least one Enabled Table to perform Delete.":U
     1617              VIEW-AS ALERT-BOX ERROR.
     1618       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1619       RETURN.
     1620   END PROCEDURE.
     1621   PROCEDURE adm-disable-fields :
     1622         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1623       RETURN.
     1624   END PROCEDURE.
     1625   PROCEDURE adm-enable-fields :
     1626       RETURN.
     1627   END PROCEDURE.
     1628   PROCEDURE adm-end-update :
     1629     RETURN.
     1630   END PROCEDURE.
     1631   PROCEDURE adm-reset-record :
     1632       RETURN.
     1633   END PROCEDURE.
     1634   PROCEDURE adm-update-record :
     1635       MESSAGE
     1636         "Object ":U THIS-PROCEDURE:FILE-NAME
     1637           "must have at least one Enabled Table to perform Update.":U
     1638             VIEW-AS ALERT-BOX ERROR.
     1639      RETURN.
     1640   END PROCEDURE.
     1641   PROCEDURE check-modified :
     1642   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1643   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1644   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1645   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1646     IF check-state = "check":U THEN
     1647     DO:
     1648       RUN get-link-handle IN adm-broker-hdl
     1649         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1650            OUTPUT group-target-list).
     1651       IF group-target-list NE "":U THEN
     1652       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1653         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1654         RUN check-modified IN curr-widget ('group-check':U).
     1655         IF RETURN-VALUE NE "":U THEN
     1656         DO:
     1657           RUN check-modified-message(RETURN-VALUE).
     1658           RETURN "":U.
     1659         END.
     1660       END.
     1661     END.
     1662     RETURN "":U.
     1663   END PROCEDURE.
     1664   PROCEDURE check-modified-message :
     1665     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1666        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1667           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1668        IF RETURN-VALUE = "YES":U THEN
     1669           RUN notify ('view,CONTAINER-SOURCE':U).
     1670        MESSAGE IF p-changed-table NE ? THEN
     1671           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1672           ELSE "Current values have been changed."
     1673           SKIP "  Do you wish to save those changes?"
     1674           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1675        IF ANS THEN
     1676        DO:
     1677           IF group-assign-target THEN
     1678             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1679           ELSE RUN dispatch('update-record':U).
     1680           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1681           DO:
     1682               MESSAGE "Changes to the previous record were not saved."
     1683                 VIEW-AS ALERT-BOX ERROR.
     1684               IF group-assign-target THEN
     1685                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1686               ELSE RUN dispatch ('cancel-record':U).
     1687           END.
     1688        END.
     1689        ELSE DO:
     1690          IF group-assign-target THEN
     1691             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1692          ELSE RUN dispatch('cancel-record':U).
     1693        END.
     1694        RETURN.
     1695   END PROCEDURE.
     1696   PROCEDURE get-rowid :
     1697       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1698       ASSIGN
     1699       p-table   =   adm-first-table.
     1700       RETURN.
     1701   END PROCEDURE.
     1702   PROCEDURE init-group-assign :
     1703       RUN request-attribute IN adm-broker-hdl
     1704         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1705       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1706         group-assign-target = yes.
     1707       ELSE group-assign-target = no.
     1708       RETURN.
     1709   END PROCEDURE.
     1710   PROCEDURE set-editors :
     1711       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1712       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1713       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1714       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1715       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1716       DO WHILE VALID-HANDLE (curr-widget):
     1717           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1718              curr-widget:HIDDEN = no THEN DO:
     1719             CASE p-field-setting:
     1720               WHEN "INITIALIZE":U THEN
     1721               DO:
     1722                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1723                     read-only-list +
     1724                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1725                        STRING(curr-widget).
     1726               END.
     1727               WHEN "DISABLE":U OR
     1728               WHEN "ENABLE":U THEN
     1729               DO:
     1730                   curr-widget:SENSITIVE = yes.
     1731                   RUN get-attribute ('Read-Only-Editors':U).
     1732                   IF RETURN-VALUE = ? OR
     1733                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1734                       curr-widget:READ-ONLY =
     1735                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1736               END.
     1737               WHEN "CLEAR":U THEN
     1738                   curr-widget:SCREEN-VALUE = "":U.
     1739             END CASE.
     1740           END.
     1741           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1742       END.
     1743       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1744         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1745           + '"':U).
     1746       RETURN.
     1747   END PROCEDURE.
     1748   PROCEDURE use-check-modified-all :
     1749    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1750     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1751     RETURN.
     1752   END PROCEDURE.
     1753   PROCEDURE use-create-on-add :
     1754   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1755      RETURN.
     1756   END PROCEDURE.
     1757   PROCEDURE use-initial-lock :
     1758     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1759     ASSIGN adm-initial-lock = p-attr-value.
     1760     RETURN.
     1761   END PROCEDURE.
     1762     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1763   ASSIGN
     1764          FRAME F-Main:SCROLLABLE       = FALSE
     1765          FRAME F-Main:HIDDEN           = TRUE.
     1766   ON CHOOSE OF B-columns IN FRAME F-Main
     1767   DO:
     1768     run rep/askfld1.w ( input 0, input-output prod-zen, output print-o ) .
     1769   END.
     1770   ON VALUE-CHANGED OF Classify IN FRAME F-Main
     1771   DO:
     1772     Assign Classify.
     1773       if Classify  Begins "prod":U OR
     1774          Classify  Begins "grp-goods":U OR
     1775          Classify  Begins "vat-ps":U
     1776           then
     1777           enable SumsOnly with frame F-Main .
     1778      if Classify = "no-classify":U
     1779         Then do:
     1780               SumsOnly = FALSE .
     1781               display SumsOnly with frame F-Main .
     1782               disable SumsOnly with frame F-Main .
     1783           end.
     1784      if Classify = "grp-goods":U
     1785            Then do:
     1786               display TOG-lavel   with frame F-Main .
     1787               enable  TOG-lavel   with frame F-Main .
     1788           end.
     1789            Else do:
     1790               display  TOG-lavel  var-Lavel tog-tree with frame F-Main .
     1791               disable  TOG-lavel  var-Lavel tog-tree with frame F-Main .
     1792           end.
     1793   END.
     1794   ON VALUE-CHANGED OF RADIO-AltObj IN FRAME F-Main
     1795   DO:
     1796     assign RADIO-AltObj .
     1797     assign AltObj-list = "" .
     1798     if RADIO-AltObj = 3 then do:
     1799       define variable v-user-select as logical   no-undo .
     1800   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1801   run userobjs_select-many in this-procedure
     1802     (input  my-handle
     1803     ,input  v-cntxt-db-num
     1804     ,input  v-cntxt-userid
     1805     ,input  v-cntxt-host-code-obj
     1806     ,input  v-cntxt-obj-type
     1807     ,input  v-cntxt-obj-code
     1808     ,output v-user-select
     1809     )  .
     1810       if v-user-select <> true then do:
     1811         assign RADIO-AltObj = 1 .
     1812         display RADIO-AltObj with frame F-Main .
     1813       end.
     1814       else do:
     1815         define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1816         for each buf_userobjs_temp-user-obj :
     1817           if AltObj-list = "" then
     1818             assign  AltObj-list = AltObj-list + buf_userobjs_temp-user-obj.obj-type + "," + string(buf_userobjs_temp-user-obj.obj-code) .
     1819           else
     1820             assign  AltObj-list = AltObj-list + "," + buf_userobjs_temp-user-obj.obj-type + "," + string(buf_userobjs_temp-user-obj.obj-code) .
     1821         end.
     1822       end.
     1823     end.
     1824   END.
     1825   ON VALUE-CHANGED OF ShowZero-2 IN FRAME F-Main
     1826   DO:
     1827       assign ShowZero-2.
     1828     if ShowZero-2 = no then do:
     1829        ShowZero = no .
     1830        display ShowZero with frame F-Main .
     1831        disable ShowZero with frame F-Main .
     1832     end.
     1833     else enable ShowZero with frame F-Main .
     1834   END.
     1835   ON VALUE-CHANGED OF Tog-lavel IN FRAME F-Main
     1836   DO:
     1837     if tog-lavel:screen-value = string(TRUE)
     1838           Then do:
     1839               display  var-Lavel tog-tree with frame F-Main .
     1840               enable   var-Lavel tog-tree with frame F-Main .
     1841           end.
     1842            Else do:
     1843               assign tog-tree = no .
     1844               display    var-Lavel tog-tree with frame F-Main .
     1845               disable    var-Lavel tog-tree with frame F-Main .
     1846           end.
     1847   END.
     1848   ON VALUE-CHANGED OF Tog-tree IN FRAME F-Main
     1849   DO:
     1850     if tog-tree:screen-value=string(TRUE)
     1851           Then do:
     1852               SumsOnly = true.
     1853               display    SumsOnly with frame F-Main .
     1854               disable    SumsOnly with frame F-Main .
     1855           end.
     1856            Else do:
     1857               display  SumsOnly  with frame F-Main .
     1858               enable   SumsOnly  with frame F-Main .
     1859           end.
     1860   END.
     1861   if not this-procedure :persistent
     1862   then do:
     1863     message
     1864       vss-workfile vss-revision vss-description skip
     1865       "Ошибка при запуске процедуры" skip
     1866       "Данную процедуру следует запускать только с параметром persistent" skip
     1867       view-as alert-box error .
     1868     undo, return error .
     1869   end.
     1870   PROCEDURE disable_UI :
     1871     HIDE FRAME F-Main.
     1872     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1873   END PROCEDURE.
     1874   PROCEDURE local-apply-layout :
     1875     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     1876   END PROCEDURE.
     1877   PROCEDURE local-initialize :
     1878   define variable l-ind as integer no-undo .
     1879   define variable glog as logical no-undo .
     1880     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1881     Tog-obj:screen-value in frame F-Main = string(True).
     1882     var-lavel:screen-value in frame F-Main = '1'.
     1883     repeat l-ind = 1 to 96 :  use-column[ l-ind ] =  false . End.
     1884    find first ubflt.usr-flt share-lock
     1885      where ubflt.usr-flt.user-name  = v-cntxt-userid
     1886        and ubflt.usr-flt.call-point = "e-obort1":U
     1887      no-error .
     1888    if not avail ubflt.usr-flt then run rep/askfld1.w ( input 0, input-output prod-zen, output print-o ).
     1889    else do:
     1890      repeat l-ind = 1 to num-entries(ubflt.usr-flt.list_) :
     1891        if index ( entry(l-ind,ubflt.usr-flt.list_),"=") = 0 THEN DO :
     1892          if int(entry(l-ind,ubflt.usr-flt.list_)) > 0 and int(entry(l-ind,ubflt.usr-flt.list_)) <= 88  then use-column[int(entry(l-ind,ubflt.usr-flt.list_)) ] =  true  .
     1893        End.
     1894        Else DO :
     1895          if entry(1,entry(l-ind,ubflt.usr-flt.list_),"=")  = "print-o":U then  print-o = entry(2,entry(l-ind,ubflt.usr-flt.list_),"=") no-error .
     1896          Else DO :
     1897            if entry(1,entry(l-ind,ubflt.usr-flt.list_),"=")  = "prod-zen":U then do:
     1898              if lookup(entry(2,entry(l-ind,ubflt.usr-flt.list_),"="),"yes,true") = 0 then prod-zen = no .
     1899              else prod-zen = yes .
     1900            end.
     1901            if error-status :error then DO:
     1902              run rep/askfld1.w ( input 0, input-output prod-zen, output print-o ).
     1903              return no-apply.
     1904            End.
     1905          End.
     1906        End.
     1907      End.
     1908      run get-gds-engl   in my-handle ( output g#gds-engl ) .
     1909      if g#gds-engl then assign RADIO-SET-1 = 2 .
     1910    End.
     1911    display FILL-IN-30 FILL-IN-31 FILL-IN-32 FILL-IN-33 RADIO-SET-1 with frame F-Main .
     1912   END PROCEDURE.
     1913   PROCEDURE my-report :
     1914     define variable sz-qnty      as integer initial 3  no-undo .
     1915     define variable v-fact-order-start   as decimal   no-undo .
     1916     define variable v-fact-order-end     as decimal   no-undo .
     1917     define variable sys-key as char no-undo.
     1918     define variable par-type as char no-undo.
     1919   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile:currsysk.i $ $Revision: $".
     1920   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currsysk in g#library
     1921     (output sys-key
     1922     ) no-error .
     1923     if error-status :error then message
     1924       vss-workfile vss-revision vss-description skip
     1925       error-status :get-message(1) skip
     1926       return-value skip
     1927       "sys-key"
     1928       view-as alert-box error
     1929     .
     1930     if sys-key = "BDC" then assign sz-qnty = 0 .
     1931   if x-date-end < today then do:
     1932     if use-column[89] or use-column[90] or use-column[91] or use-column[92] or use-column[93] or use-column[94] or use-column[95] or use-column[96] then do:
     1933       message "Данные по резервам можно корректно рассчитать только на текущую дату!" view-as alert-box.
     1934       assign
     1935         use-column[89] = no
     1936         use-column[90] = no
     1937         use-column[91] = no
     1938         use-column[92] = no
     1939         use-column[93] = no
     1940         use-column[94] = no
     1941         use-column[95] = no
     1942         use-column[96] = no
     1943       .
     1944     end.
     1945   end.
     1946   run rep/r-obort1.p  (
     1947      input ShowZero       ,
     1948      input ShowZero-2     ,
     1949      input RADIO-Nomenkl  ,
     1950      input Tog-obj        ,
     1951      input Classify       ,
     1952      input RADIO-AltObj   ,
     1953      input AltObj-list    ,
     1954      input SortType       ,
     1955      input prod-zen       ,
     1956      input print-o        ,
     1957      input SumsOnly       ,
     1958      input tog-lavel      ,
     1959      input var-lavel      ,
     1960      input tog-tree       ,
     1961      input RADIO-SET-1    ,
     1962      input no-nds         ,
     1963      input TOGGLE-1       ,
     1964      input sz-qnty        ,
     1965      input sys-key
     1966     ).
     1967   END PROCEDURE.
     1968   PROCEDURE my-var :
     1969   Assign frame F-Main SumsOnly ShowZero tog-obj Classify SortType RADIO-SET-1  TOGGLE-1
     1970                 ShowZero-2 tog-lavel var-lavel tog-tree RADIO-Nomenkl RADIO-AltObj no-nds .
     1971   Assign
     1972    STR-obj-type = ''
     1973    STR-obj-code = ''
     1974    STR-obj-name = ''
     1975    STR-obj      = ''
     1976    str4  = ""
     1977   .
     1978   For each obj-list no-lock:
     1979    Assign
     1980    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     1981    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     1982    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     1983    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ','
     1984    str4   = STR-obj
     1985   .
     1986   End.
     1987   assign ReportNAme = "Оборотная ведомость детализированная: " + (If X-TOG-Shift Then
     1988                   "Cмены с "  + string(X-Shift-Start)   + " по "  + string(X-Shift-End)  Else "" ) +
     1989                   " за период с  " + string(X-Date-Start,"99/99/9999") + "г." + "  по " + string(X-Date-End,"99/99/9999") + "г."
     1990    .
     1991   def var t-class as char no-undo.
     1992   def var t-sort as char no-undo.
     1993     case classify:
     1994       when "no-classify":u    then t-class =   "Без классификации" .
     1995       when "prod":u           then t-class =   "Производители"   .
     1996       when "post":u           then t-class =   "Поставщики"   .
     1997       when "grp-goods":u      then t-class =   "Группы товаров"  .
     1998       when "post/grp-goods":u then t-class =   "Поставщики/Группы товаров" .
     1999       when "prod/grp-goods":u then t-class =   "Производители/Группы товаров" .
     2000       when "grp-goods/prod":u then t-class =   "Группы товаров/Производители" .
     2001       when "grp-goods/post":u then t-class =   "Группы товаров/Поставщики" .
     2002       when  "vat-ps":u        then t-class =   "Ставка НДС" .
     2003       when  "sort":u          then t-class =   "Проба(Сорт)" .
     2004       when  "n-level":u       then t-class =   "Группы с уровнем вложенности " .
     2005       when  "t-level":u       then t-class =   "Терминальные группы" .
     2006    end case.
     2007     case sorttype:
     2008       when "sort-pp":u               then t-sort =   "по порядку" .
     2009       when "sort-code":u             then t-sort =   "по коду" .
     2010       when "sort-artic":u            then t-sort =   "по артикулу"  .
     2011       when "sort-qunty":u            then t-sort =   "по реализации".
     2012       when "sort-name":u             then t-sort =   "по наименованию".
     2013       when "sort-type":u             then t-sort =   "по типу ткани".
     2014       when "sort-doc-code":u         then t-sort =   "по номеру документа".
     2015       when "sort-recipe-code":u      then t-sort =   "по номеру рецепта".
     2016    end case.
     2017   ReportHeader = "Классификация : " + t-Class.
     2018   ReportHeader = ReportHeader + (if tog-lavel  then "    Итоги с уровня  "  + String(var-lavel)  else " "    ).
     2019   ReportHeader = ReportHeader  + chr(10).
     2020   ReportHeader = ReportHeader  + "Выбор цен: " + (if x-SET_val_TYPE = 1 then "рублевые" else "валютные" ) + chr(10).
     2021    assign
     2022      str3 = ""
     2023      str1 = "Показать : " +
     2024            (if SumsOnly     then " только итоги, "             else " " ) +
     2025            (if no-nds       then " учет. цены без НДС, "         else " " ) +
     2026            (if tog-tree     then " группировка в виде дерева, "   else " " ) +
     2027            (if Tog-obj      then " раздельно по объектам, "  else " " ) +
     2028            (if ShowZero     then " показывать нулевые остатки, "  else " не показывать нулевые остатки, " ) +
     2029            (if ShowZero-2   then " показывать нулевые обороты "  else " не показывать нулевые обороты " ).
     2030    .
     2031    ReportHeader = ReportHeader + "Сортировка " + t-Sort  + chr(10) + str1 + chr(10) .
     2032    case RADIO-Nomenkl :
     2033      when 1 then str2 =  "Номенклатура : Вся".
     2034      when 2 then str2 =  "Номенклатура : Текущая" .
     2035      when 3 then str2 =  "Номенклатура : Удаленная" .
     2036    end case .
     2037    ReportHeader = ReportHeader + str2 +  chr(10).
     2038    if RADIO-AltObj > 1 then do:
     2039      if RADIO-AltObj = 2 then ReportHeader = ReportHeader + "Альтернативные объекты : Все " .
     2040      else do:
     2041        define buffer buf_clients  for ub.clients .
     2042        define variable ii as integer   no-undo .
     2043        define variable p-num as integer   no-undo .
     2044        assign str3 =  "Альтернативные объекты: " .
     2045        assign p-num = num-entries( AltObj-list ) .
     2046        do ii = 1 to p-num by 2 :
     2047          find first buf_clients no-lock
     2048            where buf_clients.obj-type = entry( ii, AltObj-list )
     2049              and buf_clients.obj-code = integer( entry( ii + 1 , AltObj-list ))
     2050          .
     2051          str3 = str3 + buf_clients.obj-name + " (" + buf_clients.obj-type + '#' + string(buf_clients.obj-code) + ")"  + ", " .
     2052        end.
     2053      end.
     2054    end.
     2055   if tog-tree and (use-column [1] = false OR use-column [2] = false  ) then  do:
     2056      message "Для получения отчета с группировкой по дереву должны быть выбраны колонки  Код и Артикул !" view-as alert-box .
     2057   return error.
     2058   end.
     2059   END PROCEDURE.
     2060   PROCEDURE state-changed :
     2061     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     2062     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     2063     CASE p-state:
     2064       when "link-changed":U then  DO:
     2065            Run my-var.
     2066            End.
     2067     END CASE.
     2068   END PROCEDURE.
