     1259   procedure thobjs :
     1260      define input        parameter parparentproc     as widget-handle no-undo .
     1261      define input        parameter i-bttns           as character     no-undo .
     1262      define input        parameter i-list-mode       as character     no-undo.
     1263      define input        parameter i-obj-type        as character     no-undo.
     1264      define input        parameter i-db-num          as integer       no-undo.
     1265      define input        parameter i-host-code       as integer       no-undo.
     1266      define input-output parameter p-rid-list        as character     no-undo .
     1267   run ref/thobjs.p
     1268           ( input parparentproc
     1269            ,input  this-procedure :handle
