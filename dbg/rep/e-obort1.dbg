     1088   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1089   define temp-table userobjs_temp-user-obj no-undo
     1090     field obj-type as character
     1091     field obj-code as integer
     1092     index xpk is primary unique obj-type obj-code
     1093     .
     1094   procedure userobjs_clear :
     1095     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1096     do
     1097     on error undo, return error return-value
     1098     :
     1099       for each buf_userobjs_temp-user-obj
     1100       on error undo, return error return-value
     1101       :
     1102         delete buf_userobjs_temp-user-obj .
     1103       end.
     1104     end.
     1105   end .
     1106   procedure userobjs_object-count :
     1107     define output parameter p-total-count as integer   no-undo .
     1108     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1109     do
     1110     on error undo, return error return-value
     1111     :
     1112       assign
     1113         p-total-count = 0
     1114       .
     1115       for each buf_userobjs_temp-user-obj
     1116       on error undo, return error return-value
     1117       :
     1118         assign
     1119           p-total-count = p-total-count + 1
     1120         .
     1121       end.
     1122     end.
     1123   end.
     1124   procedure userobjs_append :
     1125      define input  parameter p-obj-type as character no-undo .
     1126      define input  parameter p-obj-code as integer   no-undo .
     1127     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1128     do
     1129     on error undo, return error return-value
     1130     :
     1131       find first buf_userobjs_temp-user-obj
     1132         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
     1133           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
     1134         no-error .
     1135       if not available buf_userobjs_temp-user-obj
     1136       then do:
     1137         create buf_userobjs_temp-user-obj .
     1138         assign
     1139           buf_userobjs_temp-user-obj.obj-type = p-obj-type
     1140           buf_userobjs_temp-user-obj.obj-code = p-obj-code
     1141         .
     1142       end.
     1143     end.
     1144   end.
     1145   procedure userobjs_object-exist :
     1146     define output parameter p-object-exist as logical   no-undo .
     1147     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1148     do
     1149     on error undo, return error return-value
     1150     :
     1151       find first buf_userobjs_temp-user-obj
     1152         no-error .
     1153       if not available buf_userobjs_temp-user-obj
     1154       then do:
     1155         assign
     1156           p-object-exist = false
     1157         .
     1158       end.
     1159       else do:
     1160         assign
     1161           p-object-exist = true
     1162         .
     1163       end.
     1164     end.
     1165   end.
     1166   procedure userobjs_transfer :
     1167     define input  parameter p-callback-handle as handle no-undo .
     1168     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
     1169     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1170     do
     1171     on error undo, return error return-value
     1172     :
     1173       if valid-handle(p-callback-handle) <> true
     1174       then do:
     1175         message
     1176           vss-workfile vss-revision vss-description skip
     1177           "Ошибка задания входных параметров" skip
     1178           "Неизвестный указатель на процедуру" skip
     1179           view-as alert-box error .
     1180         undo, return error return-value .
     1181       end.
     1182       if p-callback-handle :get-signature("userobjs_append") = ""
     1183       then do:
     1184         message
     1185           vss-workfile vss-revision vss-description skip
     1186           "Ошибка задания входных параметров" skip
     1187           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
     1188                     ,p-callback-handle :file-name
     1189                     ) skip
     1190           view-as alert-box error .
     1191         undo, return error return-value .
     1192       end.
     1193       for each buf_userobjs_temp-user-obj
     1194       on error undo, return error return-value
     1195       :
     1196         run userobjs_append in p-callback-handle
     1197           (input  buf_userobjs_temp-user-obj.obj-type
     1198           ,input  buf_userobjs_temp-user-obj.obj-code
     1199           ) .
     1200       end.
     1201     end.
     1202   end procedure.
     1203   procedure userobjs_select-one :
     1204      define input  parameter parparentproc     as widget-handle no-undo .
     1205      define input  parameter p-db-num          as integer   no-undo .
     1206      define input  parameter p-user-id         as character no-undo .
     1207      define input  parameter p-host-code-obj   as integer   no-undo .
     1208      define input  parameter p-obj-type        as character no-undo .
     1209      define input  parameter p-obj-code        as integer   no-undo .
     1210      define output parameter p-user-select     as logical   no-undo .
     1211      define output parameter p-select-obj-type as character no-undo .
     1212      define output parameter p-select-obj-code as character no-undo .
     1213     do
     1214     on error undo, return error return-value
     1215     :
     1216       run gbl/userobjs.w
     1217         (input  parparentproc
     1218         ,input  this-procedure :handle
     1219         ,input  p-db-num
     1220         ,input  p-user-id
     1221         ,input  p-host-code-obj
     1222         ,input  p-obj-type
     1223         ,input  p-obj-code
     1224         ,INPUT  "b-sel"
     1225         ,output p-user-select
     1226         ,output p-select-obj-type
     1227         ,output p-select-obj-code
     1228         ) .
     1229     end.
     1230   end.
     1231   procedure userobjs_select-many :
     1232     define input  parameter parparentproc   as widget-handle no-undo .
     1233     define input  parameter p-db-num        as integer   no-undo .
     1234     define input  parameter p-user-id       as character no-undo .
     1235     define input  parameter p-host-code-obj as integer   no-undo .
     1236     define input  parameter p-obj-type      as character no-undo .
     1237     define input  parameter p-obj-code      as integer   no-undo .
     1238     define output parameter p-user-select   as logical   no-undo .
     1239     define variable v-select-obj-type as character no-undo .
     1240     define variable v-select-obj-code as integer   no-undo .
     1241     do
     1242     on error undo, return error return-value
     1243     :
