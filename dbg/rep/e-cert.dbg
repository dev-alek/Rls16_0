      934   define temp-table temp-font no-undo
      935     field fontnum  as integer
      936     field fontname as character
      937     field fontsize as character
      938     field fonttype as character
      939     field font-h   as integer
      940     field font-w   as integer
      941     field v-row    as integer
      942     field v-col    as integer
      943     field v-row-lans as integer
      944     field v-col-lans as integer
      945   index pi fontnum
      946   .
      947   procedure get-font-ini :
      948     do
      949     on error undo, return error return-value
      950     :
      951   define variable ii as integer   no-undo .
      952   define variable v-font7 as character no-undo .
      953   define variable v-font as character no-undo .
      954   define variable loc-name as character no-undo .
      955   define variable loc-size as character no-undo .
      956   define variable loc-type as character no-undo .
      957   define variable old_H as integer   no-undo .
      958   define variable old_w as integer   no-undo .
      959   define variable old-row  as integer   no-undo .
      960   define variable old-col  as integer   no-undo .
      961   define variable old-row-lans  as integer   no-undo .
      962   define variable old-col-lans  as integer   no-undo .
      963   define variable vv as integer   no-undo .
      964   empty temp-table temp-font.
      965     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
      966       case num-entries (v-font7) :
      967         when 4 then do:
      968             assign
      969               loc-name = entry ( 1 , v-font7 )
      970               loc-size = entry ( 2 , v-font7 )
      971               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
      972             .
      973         end.
      974         when 3 then do:
      975             assign
      976               loc-name = entry ( 1 , v-font7 )
      977               loc-size = entry ( 2 , v-font7 )
      978               loc-type = entry ( 3 , v-font7 )
      979             .
      980         end.
      981         when 2 then  do:
      982             assign
      983               loc-name = entry ( 1 , v-font7 )
      984               loc-size = entry ( 2 , v-font7 )
      985               loc-type = ""
      986             .
      987         end.
      988         when 1 then do:
      989             assign
      990               loc-name = trim(entry ( 1 , v-font7 ))
      991               loc-size = ""
      992               loc-type = ""
      993             .
      994         end.
      995       end case.
      996     create temp-font.
      997     assign
      998       temp-font.fontnum  = 7
      999       temp-font.fontname = trim(loc-name)
     1000       temp-font.fontsize = trim(loc-size)
     1001       temp-font.fonttype = trim(loc-type)
     1002       temp-font.v-row    = 62
     1003       temp-font.v-col    = 136
     1004       temp-font.v-row-lans = 43
     1005       temp-font.v-col-lans = 198
     1006     .
     1007     repeat ii = 16 to 100 :
     1008       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     1009       if v-font = "" or v-font = ? then leave.
     1010       case num-entries (v-font) :
     1011         when 4 then do:
     1012             assign
     1013               loc-name = entry ( 1 , v-font )
     1014               loc-size = entry ( 2 , v-font )
     1015               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     1016             .
     1017         end.
     1018         when 3 then do:
     1019             assign
     1020               loc-name = entry ( 1 , v-font )
     1021               loc-size = entry ( 2 , v-font )
     1022               loc-type = entry ( 3 , v-font )
     1023             .
     1024         end.
     1025         when 2 then do:
     1026             assign
     1027               loc-name = entry ( 1 , v-font )
     1028               loc-size = entry ( 2 , v-font )
     1029               loc-type = ""
     1030             .
     1031         end.
     1032         when 1 then do:
     1033             assign
     1034               loc-name = trim(entry ( 1 , v-font ))
     1035               loc-size = ""
     1036               loc-type = ""
     1037             .
     1038         end.
     1039       end case.
     1040     create temp-font.
     1041     assign
     1042       temp-font.fontnum  = ii
     1043       temp-font.fontname = trim(loc-name)
     1044       temp-font.fontsize = trim(loc-size)
     1045       temp-font.fonttype = trim(loc-type)
     1046     .
     1047     end.
     1048       for each temp-font :
     1049          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     1050          if  vv = ? then vv =  0 .
     1051           run rep/exfont.p (
     1052             input   temp-font.fontname ,
     1053             input   vv ,
     1054             input   temp-font.fonttype ,
     1055             output  temp-font.font-h   ,
     1056             output  temp-font.font-w   )
     1057           .
     1058       end.
     1059   find first temp-font where  temp-font.fontnum  = 7  .
     1060   old_H = temp-font.font-H .
     1061   old_w = temp-font.font-W .
     1062   old-row = temp-font.v-row .
     1063   old-col = temp-font.v-col .
     1064   old-row-lans = temp-font.v-row-lans .
     1065   old-col-lans = temp-font.v-col-lans .
     1066       for each temp-font where
     1067                temp-font.fontnum  <> 7 :
     1068           assign
     1069               temp-font.v-row    = old_H * old-row / temp-font.font-h
     1070               temp-font.v-col    = old_W * old-col / temp-font.font-W
     1071               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     1072               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     1073           .
     1074       end.
     1075     end.
     1076   end procedure.
     1077   PROCEDURE How-name :
     1078   define input  parameter h as integer no-undo .
     1079   define input  parameter w as integer no-undo .
     1080   define output parameter n as character  no-undo .
     1081   define variable A4port-H as integer   no-undo init 63.
     1082   define variable A4port-W as integer   no-undo init 136.
     1083   define variable A4lans-H as integer   no-undo init 43.
     1084   define variable A4lans-W as integer   no-undo init 198.
     1085   define variable Strim-W  as integer   no-undo init 278.
     1086   run define-a4-size (
     1087        input ReportFontNum
     1088       ,output A4port-H
     1089       ,output A4port-W
     1090       ,output A4lans-H
     1091       ,output A4lans-W ).
     1092   If w >= 1 and w <= A4port-W Then DO:
     1093     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1094     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     1095     If h > A4port-H              Then n = "to-file":U.
     1096   End.
     1097   If w > A4port-W and w <= A4lans-W Then DO:
     1098     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1099     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1100     If h > A4port-H              Then n = "to-file":U.
     1101   End.
     1102   If w > A4lans-W and w <= Strim-W Then DO:
     1103     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     1104     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1105     If h > A4port-H              Then n = "to-file":U.
     1106   End.
     1107   If w > Strim-W Then DO:
     1108      n = "to-file":U.
     1109   End.
     1110   END PROCEDURE.
     1111   PROCEDURE define-a4-size :
     1112   define input  parameter p-ReportFontNum as integer   no-undo .
     1113   define output parameter A4port-H as integer   no-undo .
     1114   define output parameter A4port-W as integer   no-undo .
     1115   define output parameter A4lans-H as integer   no-undo .
     1116   define output parameter A4lans-W as integer   no-undo .
     1117   if not can-find (first temp-font ) then do:
     1118      run get-font-ini .
     1119   end.
     1120   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     1121   if available temp-font then do:
     1122   assign
     1123     A4port-H = temp-font.v-row
     1124     A4port-W = temp-font.v-col
     1125     A4lans-H = temp-font.v-row-lans
     1126     A4lans-W = temp-font.v-col-lans
     1127   .
     1128   end.
     1129   else do:
     1130   assign
     1131     A4port-H = 63
     1132     A4port-W = 136
     1133     A4lans-H = 43
     1134     A4lans-W = 198
     1135   .
     1136   end.
     1137   END PROCEDURE.
     1138   CREATE WIDGET-POOL.
     1139       define variable rid-list as character no-undo.
     1140       DEFINE STREAM Out-Stream .
     1141       define variable Line      as      character    no-undo.
     1142       define variable lastdate as date no-undo.
     1143       define temp-table gds-sert no-undo
     1144           field artic like goods.artic
     1145           field prod-type like goods.prod-type
     1146           field prod-code like goods.prod-code
     1147           field gds-name like goods.gds-name
     1148           field b-code like bar-code.b-code
     1149           index pi as UNIQUE artic prod-type prod-code.
     1150       define frame gds-srt
     1151           sym1 column-label ":!:" format "X(1)" space(0)
     1152           gds-sert.artic COLUMN-LABEL "Артикул" format "X(20)" space(0)
     1153           sym2 column-label ":!:" format "X(1)" space(0)
     1154           gds-sert.gds-name COLUMN-LABEL "Наименование товара! " format "X(40)" space(0)
     1155           sym3 column-label ":!:" format "X(1)" space(0)
     1156           lastdate COLUMN-LABEL "Дата окончания"  space(0)
     1157           sym4 column-label ":!:" format "X(1)" space(0)
     1158       HEADER
     1159           string( "Страница " + string( PAGE-NUMBER( Out-Stream ), ">>9" ) ) AT 120 format "X(13)" SKIP
     1160           Line format "X(135)" AT 1
     1161       with width 235 down stream-io.
     1162   RUN set-attribute-list (
     1163       'Keys-Accepted = "",
     1164        Keys-Supplied = ""':U).
     1165   DEFINE BUTTON B-cli
     1166        IMAGE-UP FILE "btn-down-arrow":U
     1167        IMAGE-DOWN FILE "btn-down-arrow":U
     1168        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1169        LABEL ""
     1170        SIZE 2.5 BY 1 TOOLTIP "Выбор контрагента".
     1171   DEFINE VARIABLE cl-code AS INTEGER FORMAT ">>>>>>>>9" INITIAL 0
     1172        LABEL "Код"
     1173        VIEW-AS FILL-IN
     1174        SIZE 10.25 BY 1 NO-UNDO.
     1175   DEFINE VARIABLE cl-name AS CHARACTER FORMAT "X(256)":U
     1176        VIEW-AS FILL-IN
     1177        SIZE 62 BY 1 NO-UNDO.
     1178   DEFINE VARIABLE cl-type AS CHARACTER FORMAT "X(3)":U
     1179        VIEW-AS FILL-IN
     1180        SIZE 4 BY 1 NO-UNDO.
     1181   DEFINE VARIABLE cur-date AS DATE FORMAT "99/99/9999":U
     1182        LABEL "Дата"
     1183        VIEW-AS FILL-IN
     1184        SIZE 14 BY 1 NO-UNDO.
     1185   DEFINE VARIABLE q-days AS INTEGER FORMAT "->,>>>,>>9":U INITIAL ?
     1186        LABEL "Количество дней"
     1187        VIEW-AS FILL-IN
     1188        SIZE 14 BY 1 NO-UNDO.
     1189   DEFINE VARIABLE t-date AS DATE FORMAT "99/99/9999":U
     1190        VIEW-AS FILL-IN
     1191        SIZE 14 BY 1 NO-UNDO.
     1192   DEFINE VARIABLE r-s-type AS INTEGER
     1193        VIEW-AS RADIO-SET VERTICAL
     1194        RADIO-BUTTONS
     1195             "Товары без сертификатов", 1,
     1196   "Товары (срок годности не позже указанной даты)", 2,
     1197   "Товары (срок годности не позже кол-ва дней от текущей даты)", 3
     1198        SIZE 62 BY 2.63 NO-UNDO.
     1199   DEFINE FRAME F-Main
     1200        cl-code AT ROW 1 COL 17.63 COLON-ALIGNED
     1201        cl-type AT ROW 1 COL 28.25 COLON-ALIGNED NO-LABEL
     1202        B-cli AT ROW 1 COL 34.75
     1203        t-date AT ROW 1 COL 47 COLON-ALIGNED NO-LABEL
     1204        cl-name AT ROW 2.13 COL 1 NO-LABEL
     1205        r-s-type AT ROW 3.54 COL 1 NO-LABEL
     1206        cur-date AT ROW 6.5 COL 5 COLON-ALIGNED
     1207        q-days AT ROW 6.5 COL 39.5 COLON-ALIGNED
     1208        "Контрагент:" VIEW-AS TEXT
     1209             SIZE 13 BY 1 AT ROW 1 COL 1
     1210       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1211            SIDE-LABELS NO-UNDERLINE THREE-D
     1212            AT COL 1 ROW 1 SCROLLABLE .
     1213   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1214   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1215   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1216   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1217   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1218   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1219   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1220   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1221         adm-object-hdl = FRAME F-Main:HANDLE.
     1222   RUN ensure-broker.
     1223   THIS-PROCEDURE:ADM-DATA =
     1224        'ADM1.1~`':U +
     1225        'SmartObject~`':U +
     1226        '~`':U +
     1227        'NO ~`':U +
     1228        '~`':U +
     1229        '~`':U +
     1230        '~`':U +
     1231        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1232           + "~`":U +
     1233        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
     1234        'Record-Source,Record-Target,TableIO-Target~`':U +
     1235        '~`':U +
     1236        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1237        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1238            THEN "^^":U
     1239        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1240             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1241   PROCEDURE adm-apply-entry :
     1242     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1243   END PROCEDURE.
     1244   PROCEDURE adm-destroy :
     1245    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1246   END PROCEDURE.
     1247   PROCEDURE adm-disable :
     1248       DISABLE cl-code cl-type B-cli r-s-type WITH FRAME F-Main.
     1249       RUN dispatch ('disable-fields':U).
     1250       RUN set-attribute-list ('ENABLED=no':U).
     1251       RETURN.
     1252   END PROCEDURE.
     1253   PROCEDURE adm-edit-attribute-list :
     1254         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
     1255         RETURN.
     1256   END PROCEDURE.
     1257   PROCEDURE adm-enable :
     1258       ENABLE UNLESS-HIDDEN cl-code cl-type B-cli r-s-type WITH FRAME F-Main.
     1259       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1260       RUN set-attribute-list ('ENABLED=yes':U).
     1261       RETURN.
     1262   END PROCEDURE.
     1263   PROCEDURE adm-exit :
     1264        RUN notify ('exit':U).
     1265     RETURN.
     1266   END PROCEDURE.
     1267   PROCEDURE adm-hide :
     1268     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1269   END PROCEDURE.
     1270   PROCEDURE adm-initialize :
     1271     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1272   END PROCEDURE.
     1273   PROCEDURE adm-show-errors :
     1274       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1275       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1276           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1277       END.
     1278       RETURN.
     1279   END PROCEDURE.
     1280   PROCEDURE adm-UIB-mode :
     1281     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1282   END PROCEDURE.
     1283   PROCEDURE adm-view :
     1284     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1285   END PROCEDURE.
     1286   PROCEDURE dispatch :
     1287       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1288       RUN broker-dispatch IN adm-broker-hdl
     1289           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1290       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1291   END PROCEDURE.
     1292   PROCEDURE ensure-broker :
     1293   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1294   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1295   DO:
     1296       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1297       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1298   END.
     1299   END PROCEDURE.
     1300   PROCEDURE get-attribute :
     1301     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1302     RUN broker-get-attribute IN adm-broker-hdl
     1303         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1304     RETURN RETURN-VALUE.
     1305   END PROCEDURE.
     1306   PROCEDURE get-attribute-list :
     1307     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1308     RUN broker-get-attribute-list IN adm-broker-hdl
     1309         (INPUT THIS-PROCEDURE,
     1310          INPUT ?,
     1311          OUTPUT p-attr-list) NO-ERROR.
     1312     RETURN.
     1313   END PROCEDURE.
     1314   PROCEDURE new-state :
     1315     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1316     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1317     RETURN.
     1318   END PROCEDURE.
     1319   PROCEDURE notify :
     1320     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1321     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1322     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1323         RETURN "ADM-ERROR":U.
     1324     RETURN.
     1325   END PROCEDURE.
     1326   PROCEDURE set-attribute-list :
     1327     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1328     RUN ensure-broker.
     1329     RUN broker-set-attribute-list IN adm-broker-hdl
     1330         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1331     RETURN.
     1332   END PROCEDURE.
     1333   PROCEDURE set-position :
     1334       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1335       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1336       IF VALID-HANDLE(adm-object-hdl) THEN
     1337       DO:
     1338         ASSIGN adm-object-hdl:ROW    =   p-row
     1339                adm-object-hdl:COLUMN =   p-col.
     1340       END.
     1341       RETURN.
     1342   END PROCEDURE.
     1343   PROCEDURE adm-display-fields :
     1344       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1345       RETURN.
     1346   END PROCEDURE.
     1347   PROCEDURE adm-open-query :
     1348     RETURN.
     1349   END PROCEDURE.
     1350   PROCEDURE adm-row-changed :
     1351         IF VALID-HANDLE(adm-object-hdl) THEN
     1352           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1353         RUN notify ('row-available':U).
     1354         RETURN.
     1355   END PROCEDURE.
     1356   PROCEDURE reposition-query :
     1357       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1358       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1359       RETURN.
     1360   END PROCEDURE.
     1361     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1362     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1363     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1364     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1365     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1366     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1367     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1368     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1369     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1370     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1371     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1372     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1373     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1374     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1375     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1376     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1377     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1378     IF "":U = "":U THEN
     1379       RUN modify-list-attribute IN adm-broker-hdl
     1380         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1381     RUN use-create-on-add(?).
     1382   PROCEDURE adm-add-record :
     1383       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1384          "must have at least one Enabled Table to perform Add.":U
     1385          VIEW-AS ALERT-BOX ERROR.
     1386       RETURN.
