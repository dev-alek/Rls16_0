      602   procedure cur-time :
      603      define output parameter p-today as date      no-undo .
      604      define output parameter p-time  as integer   no-undo .
      605     do
      606     on error undo, return error
      607     :
      608       define variable v-date1 as date      no-undo .
      609       define variable v-date2 as date      no-undo .
      610       define variable v-time  as integer   no-undo .
      611       assign
      612         v-date1 = today
      613         v-time  = time
      614         v-date2 = today
      615       .
      616       if v-date1 <> v-date2
      617       then do:
      618         assign
      619           v-date1 = today
      620           v-time  = v-time
      621         .
      622       end.
      623       assign
      624         p-today = v-date1
      625         p-time  = v-time
      626       .
      627     end.
      628   end.
      629   function cur-time-date returns character
      630   :
      631     return string(today, '99/99/9999':U) .
      632   end.
      633   function cur-time-mjd returns decimal
      634   :
      635     define variable v-date as date      no-undo .
      636     define variable v-time as integer   no-undo .
      637     run cur-time in this-procedure
      638       (output v-date
      639       ,output v-time
      640       ) .
      641     return integer(v-date) - 2400002 + (v-time / 86400) .
      642   end.
      643   function cur-time-get-ending-index returns integer
      644   (input p-number as integer
      645   )
      646   :
      647     if p-number < 0
      648     or p-number = ?
      649     then do:
      650       return 1 .
      651     end.
      652     define variable v-rest as integer   no-undo .
      653     assign
      654       p-number = p-number modulo 100
      655     .
      656     if p-number < 20
      657     then do:
      658       assign
      659         v-rest = p-number
      660       .
      661     end.
      662     else do:
      663       assign
      664         v-rest = p-number modulo 10
      665       .
      666     end.
      667     case v-rest :
      668       when 1
      669       then do:
      670         return 2 .
      671       end.
      672       when 2 or
      673       when 3 or
      674       when 4
      675       then do:
      676         return 3 .
      677       end.
      678       otherwise do:
      679         return 1 .
      680       end.
      681     end case .
      682   end.
      683   procedure cur-time-mjd-to-date :
      684      define input  parameter i-mjd-diff as decimal no-undo.
      685      define output parameter o-Date     as date    no-undo.
      686      define output parameter o-Time     as integer no-undo.
      687      define variable v-day-number as integer   no-undo .
      688      if    i-mjd-diff < 0
      689         or i-mjd-diff = ?
      690      then do:
      691         return "?" .
      692      end.
      693      assign
      694         v-day-number = truncate(i-mjd-diff,0).
      695         o-Date = date(v-day-number + 2400002).
      696         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      697     .
      698   end.
      699   function cur-time-mjd-to-string returns character
      700   (input p-mjd-diff as decimal
      701   )
      702   :
      703     define variable v-day-number as integer   no-undo .
      704     define variable v-seconds    as integer   no-undo .
      705     define variable v-hour       as integer   no-undo .
      706     define variable v-min        as integer   no-undo .
      707     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      708     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      709     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      710     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      711     if p-mjd-diff < 0
      712     or p-mjd-diff = ?
      713     then do:
      714       return "?" .
      715     end.
      716     assign
      717       v-day-number = integer(truncate(p-mjd-diff,0))
      718       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      719     .
      720     if v-seconds > 86400
      721     then do:
      722       assign
      723         v-seconds = 86400 - 1
      724       .
      725     end.
      726     if v-seconds < 0
      727     then do:
      728       assign
      729         v-seconds = 0
      730       .
      731     end.
      732     assign
      733       v-hour = truncate(v-seconds / 3600, 0)
      734     .
      735     assign
      736       v-seconds = v-seconds modulo 3600
      737     .
      738     assign
      739       v-min = truncate(v-seconds / 60, 0)
      740     .
      741     assign
      742       v-seconds = v-seconds modulo 60
      743     .
      744     return
      745         (if v-day-number <> 0
      746           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      747           else ""
      748         )
      749       + (if v-day-number <> 0 or v-hour <> 0
      750           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      751           else ""
      752         )
      753       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      754           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      755           else ""
      756         )
      757       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      758       .
      759   end.
      760   function cur-time-string returns character
      761   :
      762     define variable v-date as date      no-undo .
      763     define variable v-time as integer   no-undo .
      764     run cur-time in this-procedure
      765       (output v-date
      766       ,output v-time
      767       ) .
      768     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      769   end.
      770   function cur-time-string-sec returns character
      771   :
      772     define variable v-date as date      no-undo .
      773     define variable v-time as integer   no-undo .
      774     run cur-time in this-procedure
      775       (output v-date
      776       ,output v-time
      777       ) .
      778     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      779   end.
      780   function cur-time-custom  returns character
      781   (input p-prefix as character
      782   ,input p-date-format as character
      783   ,input p-delimiter as character
      784   ,input p-time-format as character
      785   ,input p-suffix as character
      786   )
      787   :
      788     define variable v-date as date      no-undo .
      789     define variable v-time as integer   no-undo .
      790     run cur-time in this-procedure
      791       (output v-date
      792       ,output v-time
      793       ) .
      794     return
      795       p-prefix
      796       + string(v-date, p-date-format)
      797       + p-delimiter
      798       + string(v-time, p-time-format)
      799       + p-suffix
      800       .
      801   end.
      802   function cur-time-print  returns character
      803   :
      804     define variable v-date as date      no-undo .
      805     define variable v-time as integer   no-undo .
      806     run cur-time in this-procedure
      807       (output v-date
      808       ,output v-time
      809       ) .
      810     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      811   end.
      812   function cur-time-datetime returns datetime
      813   :
      814     define variable v-char as character no-undo .
      815     define variable v-datetime as datetime no-undo .
      816     v-char = cur-time-string().
      817     v-datetime = datetime(v-char).
      818     return  v-datetime.
      819   end.
      820   function cur-time-string-msec returns character
      821   :
      822     define variable v-date as datetime  no-undo .
      823     v-date = now.
      824     return string(v-date) .
      825   end.
