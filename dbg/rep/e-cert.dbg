      844       run gbl/d-inform.w
      845         (  input self
      846         ,  input this-procedure
      847         , output v-action
      848         ) no-error .
      849       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      850       assign
      851         v-inform-launched = false
      852       .
      853     end.
      854   end.
