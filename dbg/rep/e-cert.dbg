     1388   PROCEDURE adm-assign-record :
     1389    MESSAGE
     1390          "Object ":U THIS-PROCEDURE:FILE-NAME
     1391            "must have at least one Enabled Table to perform Assign.":U
     1392              VIEW-AS ALERT-BOX ERROR.
     1393      RETURN.
     1394     END PROCEDURE.
     1395   PROCEDURE adm-assign-statement :
     1396     RETURN.
     1397   END PROCEDURE.
     1398   PROCEDURE adm-cancel-record :
     1399      RETURN.
     1400     END PROCEDURE.
     1401   PROCEDURE adm-copy-record :
     1402       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1403        "must have at least one Enabled Table to perform Copy.":U
     1404          VIEW-AS ALERT-BOX ERROR.
     1405       RETURN.
     1406   END PROCEDURE.
     1407   PROCEDURE adm-create-record :
     1408      RETURN.
     1409   END PROCEDURE.
     1410   PROCEDURE adm-current-changed :
     1411     RETURN.
     1412   END PROCEDURE.
     1413   PROCEDURE adm-delete-record :
     1414    MESSAGE
     1415          "Object ":U THIS-PROCEDURE:FILE-NAME
     1416            "must have at least one Enabled Table to perform Delete.":U
     1417              VIEW-AS ALERT-BOX ERROR.
     1418       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1419       RETURN.
     1420   END PROCEDURE.
     1421   PROCEDURE adm-disable-fields :
     1422         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1423       RETURN.
     1424   END PROCEDURE.
     1425   PROCEDURE adm-enable-fields :
     1426       RETURN.
     1427   END PROCEDURE.
     1428   PROCEDURE adm-end-update :
     1429     RETURN.
     1430   END PROCEDURE.
     1431   PROCEDURE adm-reset-record :
     1432       RETURN.
     1433   END PROCEDURE.
     1434   PROCEDURE adm-update-record :
     1435       MESSAGE
     1436         "Object ":U THIS-PROCEDURE:FILE-NAME
     1437           "must have at least one Enabled Table to perform Update.":U
     1438             VIEW-AS ALERT-BOX ERROR.
     1439      RETURN.
     1440   END PROCEDURE.
     1441   PROCEDURE check-modified :
     1442   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1443   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1444   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1445   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1446     IF check-state = "check":U THEN
     1447     DO:
     1448       RUN get-link-handle IN adm-broker-hdl
     1449         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1450            OUTPUT group-target-list).
     1451       IF group-target-list NE "":U THEN
     1452       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1453         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1454         RUN check-modified IN curr-widget ('group-check':U).
     1455         IF RETURN-VALUE NE "":U THEN
     1456         DO:
     1457           RUN check-modified-message(RETURN-VALUE).
     1458           RETURN "":U.
     1459         END.
     1460       END.
     1461     END.
     1462     RETURN "":U.
     1463   END PROCEDURE.
     1464   PROCEDURE check-modified-message :
     1465     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1466        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1467           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1468        IF RETURN-VALUE = "YES":U THEN
     1469           RUN notify ('view,CONTAINER-SOURCE':U).
     1470        MESSAGE IF p-changed-table NE ? THEN
     1471           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1472           ELSE "Current values have been changed."
     1473           SKIP "  Do you wish to save those changes?"
     1474           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1475        IF ANS THEN
     1476        DO:
     1477           IF group-assign-target THEN
     1478             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1479           ELSE RUN dispatch('update-record':U).
     1480           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1481           DO:
     1482               MESSAGE "Changes to the previous record were not saved."
     1483                 VIEW-AS ALERT-BOX ERROR.
     1484               IF group-assign-target THEN
     1485                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1486               ELSE RUN dispatch ('cancel-record':U).
     1487           END.
     1488        END.
     1489        ELSE DO:
     1490          IF group-assign-target THEN
     1491             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1492          ELSE RUN dispatch('cancel-record':U).
     1493        END.
     1494        RETURN.
     1495   END PROCEDURE.
     1496   PROCEDURE get-rowid :
     1497       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1498       ASSIGN
     1499       p-table   =   adm-first-table.
     1500       RETURN.
     1501   END PROCEDURE.
     1502   PROCEDURE init-group-assign :
     1503       RUN request-attribute IN adm-broker-hdl
     1504         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1505       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1506         group-assign-target = yes.
     1507       ELSE group-assign-target = no.
     1508       RETURN.
     1509   END PROCEDURE.
     1510   PROCEDURE set-editors :
     1511       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1512       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1513       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1514       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1515       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1516       DO WHILE VALID-HANDLE (curr-widget):
     1517           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1518              curr-widget:HIDDEN = no THEN DO:
     1519             CASE p-field-setting:
     1520               WHEN "INITIALIZE":U THEN
     1521               DO:
     1522                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1523                     read-only-list +
     1524                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1525                        STRING(curr-widget).
     1526               END.
     1527               WHEN "DISABLE":U OR
     1528               WHEN "ENABLE":U THEN
     1529               DO:
     1530                   curr-widget:SENSITIVE = yes.
     1531                   RUN get-attribute ('Read-Only-Editors':U).
     1532                   IF RETURN-VALUE = ? OR
     1533                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1534                       curr-widget:READ-ONLY =
     1535                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1536               END.
     1537               WHEN "CLEAR":U THEN
     1538                   curr-widget:SCREEN-VALUE = "":U.
     1539             END CASE.
     1540           END.
     1541           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1542       END.
     1543       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1544         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1545           + '"':U).
     1546       RETURN.
     1547   END PROCEDURE.
     1548   PROCEDURE use-check-modified-all :
     1549    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1550     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1551     RETURN.
     1552   END PROCEDURE.
     1553   PROCEDURE use-create-on-add :
     1554   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1555      RETURN.
     1556   END PROCEDURE.
     1557   PROCEDURE use-initial-lock :
     1558     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1559     ASSIGN adm-initial-lock = p-attr-value.
     1560     RETURN.
     1561   END PROCEDURE.
     1562     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1563   ASSIGN
     1564          FRAME F-Main:SCROLLABLE       = FALSE
     1565          FRAME F-Main:HIDDEN           = TRUE.
     1566   ON CHOOSE OF B-cli IN FRAME F-Main
     1567   DO:
     1568     run ref/cli-all.w (my-handle,  "'ПРОСМОТР':U,b-sel", ?, ?, ?, ?, ?, ?, output rid-list).
     1569     find clients where recid(clients) = integer(rid-list) no-lock no-error.
     1570     if not available clients then do:
     1571       message "Контрагент не выбран!" view-as alert-box warning.
     1572       return no-apply.
     1573     end.
     1574     if clients.obj-type = 'маг':U or clients.obj-type = 'скл':U then do:
     1575       message "Склады и магазины не могут иметь сертификаты" view-as alert-box error.
     1576       return no-apply.
     1577     end.
     1578     assign
     1579         cl-type = clients.obj-type
     1580         cl-code = clients.obj-code
     1581         cl-name  = clients.obj-name.
     1582     disp
     1583         cl-type
     1584         cl-code
     1585         cl-name
     1586         with frame F-Main.
     1587   END.
     1588   ON VALUE-CHANGED OF r-s-type IN FRAME F-Main
     1589   DO:
     1590     assign r-s-type.
     1591     case r-s-type:
     1592       when 1 then do:
     1593           disable cur-date q-days with frame F-Main.
     1594           hide cur-date q-days .
     1595       end.
     1596       when 2 then do:
     1597           disable q-days with frame F-Main.
     1598           hide q-days .
     1599           enable cur-date with frame F-Main.
     1600           disp cur-date with frame F-Main.
     1601       end.
     1602       when 3 then do:
     1603           disable cur-date with frame F-Main.
     1604           hide cur-date .
     1605           enable q-days with frame F-Main.
     1606           disp q-days with frame F-Main.
     1607       end.
     1608      end case.
     1609   END.
     1610   if not this-procedure :persistent
     1611   then do:
     1612     message
     1613       vss-workfile vss-revision vss-description skip
     1614       "Ошибка при запуске процедуры" skip
     1615       "Данную процедуру следует запускать только с параметром persistent" skip
     1616       view-as alert-box error .
     1617     undo, return error .
     1618   end.
     1619     define variable v-today as date      no-undo.
     1620     define variable v-time  as integer   no-undo.
     1621     run cur-time in this-procedure ( output t-date
     1622                                    , output v-time
     1623                                    ).
     1624     assign
     1625       Line = fill("-", 135)
     1626     .
     1627     disp t-date with frame F-Main.
     1628   PROCEDURE adm-row-available :
     1629     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1630     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1631     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1632     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1633     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1634     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1635     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1636     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1637     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1638     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1639     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1640     IF adm-updating-record THEN RETURN.
     1641     RUN get-attribute ('FIELDS-ENABLED':U).
     1642     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1643     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1644         OUTPUT link-handle) NO-ERROR.
     1645     IF link-handle = "":U THEN
     1646         RETURN.
     1647     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1648     IF NUM-ENTRIES(link-handle) > 1 THEN
     1649         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1650             "encountered more than one RECORD-SOURCE.":U SKIP
     1651             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1652                VIEW-AS ALERT-BOX ERROR.
     1653     RUN get-attribute ('Key-Name':U).
     1654     key-name = RETURN-VALUE.
     1655     IF key-name = "":U THEN key-name = ?.
     1656     IF key-name NE ? THEN DO:
     1657       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1658         NO-ERROR.
     1659       IF key-value NE ? THEN
     1660         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1661     END.
     1662   IF VALID-HANDLE (adm-object-hdl) THEN
     1663       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1664   RUN notify IN THIS-PROCEDURE ('row-available':U).
     1665   END PROCEDURE.
     1666   PROCEDURE disable_UI :
     1667     HIDE FRAME F-Main.
     1668     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1669   END PROCEDURE.
     1670   PROCEDURE my-report :
     1671   run print-cert (buffer clients).
     1672   END PROCEDURE.
     1673   PROCEDURE my-var :
     1674   assign frame F-Main
     1675             r-s-type cl-type cl-code q-days cur-date.
     1676     find clients where clients.obj-type = cl-type  and clients.obj-code = cl-code  no-lock no-error.
     1677     if not available clients then do:
     1678       message "Не выбран контрагент!" view-as alert-box error.
     1679       return no-apply.
     1680     end.
     1681     if clients.is-prod = yes or clients.sup-gds = yes then.
     1682     else do:
     1683       message "Клиент должен быть поставщиком или (и) производителем!" view-as alert-box error.
     1684       return no-apply.
     1685     end.
     1686     if r-s-type = 2 and cur-date = ? then do:
     1687       message "Надо ввести дату окончания срока действия сертификатов" view-as alert-box error.
     1688       return no-apply.
     1689     end.
     1690     if r-s-type = 3 and q-days = ? then do:
     1691       message "Надо ввести количество дней срока действия сертификатов" view-as alert-box error.
     1692       return no-apply.
     1693     end.
     1694   END PROCEDURE.
     1695   PROCEDURE print-cert :
     1696       define parameter buffer b-cli for clients.
     1697       define variable sup-type as character format "x(25)" no-undo.
     1698       if clients.is-prod = yes then sup-type = "Производитель".
     1699       if clients.sup-gds = yes then sup-type = "Поставщик".
     1700       if clients.sup-gds = yes and clients.is-prod = yes then sup-type = "Поставщик/Производитель".
     1701       for each gds-sert:
     1702           delete gds-sert.
     1703       end.
     1704       if session:set-wait-state("compiler") then.
     1705   output STREAM Out-Stream to value( string( session:temp-directory +
     1706                                        "rpt" + string( g#report-num ) ) )
     1707                                        page-size  value(ReportPageHeight) .
     1708       case r-s-type:
     1709           when 1 then
     1710               put stream out-stream
     1711                   " Товары без сертификатов " format "x(30)" skip
     1712                   sup-type format "x(25)" b-cli.obj-name format "x(50)"  skip.
     1713           when 2 then
     1714               put stream out-stream
     1715                   " Товары со сроком годности не позднее " format "x(40)" string(cur-date)  skip
     1716                   sup-type format "x(25)" b-cli.obj-name format "x(50)"  skip.
     1717           when 3 then
     1718               put stream out-stream
     1719                   " Товары со сроком годности заканчивающимся не позднее чем через " format "x(60)" string(q-days)  " дней" skip
     1720                   sup-type format "x(25)" b-cli.obj-name format "x(50)"  skip.
     1721       end case.
     1722       FORM HEADER
     1723           Line format "X(135)" AT 1 SKIP
     1724           "Продолжение - на следующей странице" AT 30 SKIP
     1725           with FRAME BottomFrame width 160 PAGE-BOTTOM NO-LABELS NO-BOX.
     1726       VIEW stream out-stream FRAME BottomFrame .
     1727       Line = fill("-", 135) .
     1728       if b-cli.sup-gds = yes then do:
     1729           for each cli-gds where cli-gds.cli-type = b-cli.obj-type and cli-gds.cli-code = b-cli.obj-code no-lock:
     1730               find gds-sert where gds-sert.artic = cli-gds.artic and
     1731                                               gds-sert.prod-type = cli-gds.prod-type and
     1732                                               gds-sert.prod-code = cli-gds.prod-code no-error.
     1733               if  not available gds-sert then do:
     1734                   find goods where goods.artic = cli-gds.artic and
     1735                                               goods.prod-type  = cli-gds.prod-type and
     1736                                               goods.prod-code = cli-gds.prod-code no-lock.
     1737                   FIND ub.gds-prt WHERE ub.gds-prt.upper-code = goods.prt-root NO-LOCK .
     1738                   find bar-code where   bar-code.gds-code = goods.gds-code
     1739                                                       AND bar-code.node-code = gds-prt.node-code
     1740                                                       AND bar-code.part-code = ""
     1741                                                       AND bar-code.in-code = ""
     1742                                                       AND bar-code.unit-cli = goods.unit-base no-lock.
     1743                   create gds-sert.
     1744                   assign
     1745                       gds-sert.artic = goods.artic
     1746                       gds-sert.prod-type = goods.prod-type
     1747                       gds-sert.prod-code = goods.prod-code
     1748                       gds-sert.b-code = bar-code.b-code
     1749                       gds-sert.gds-name = goods.gds-name.
     1750               end.
     1751           end.
     1752       end.
     1753       if b-cli.is-prod = yes then do:
     1754           for each goods where goods.prod-type = b-cli.obj-type and goods.prod-code = b-cli.obj-code no-lock:
     1755               find gds-sert where gds-sert.artic = goods.artic and
     1756                                               gds-sert.prod-type = goods.prod-type and
     1757                                               gds-sert.prod-code = goods.prod-code no-error.
     1758               if  not available gds-sert then do:
     1759                   FIND ub.gds-prt WHERE ub.gds-prt.upper-code = goods.prt-root NO-LOCK .
     1760                   find bar-code where   bar-code.gds-code = goods.gds-code
     1761                                                       AND bar-code.node-code = gds-prt.node-code
     1762                                                       AND bar-code.part-code = ""
     1763                                                       AND bar-code.in-code = ""
     1764                                                       AND bar-code.unit-cli = goods.unit-base no-lock.
     1765                   create gds-sert.
     1766                   assign
     1767                       gds-sert.artic = goods.artic
     1768                       gds-sert.prod-type = goods.prod-type
     1769                       gds-sert.prod-code = goods.prod-code
     1770                       gds-sert.b-code = bar-code.b-code
     1771                       gds-sert.gds-name = goods.gds-name.
     1772               end.
     1773           end.
     1774       end.
     1775       if session:set-wait-state("COMPILER") then.
     1776       FORM with frame gds-srt .
     1777           case r-s-type:
     1778               when 1 then do:
     1779                   for each gds-sert no-lock:
     1780                       if not can-find( first sert-join where sert-join.b-code = gds-sert.b-code) then
     1781                           disp stream out-stream sym1 gds-sert.artic sym2 gds-sert.gds-name sym3
     1782                           with frame gds-srt.
     1783                       DOWN stream out-stream 1 with frame gds-srt .
     1784                   end.
     1785               end.
     1786               when 2 then do:
     1787                   for each gds-sert no-lock:
     1788                       for each sert-join where sert-join.b-code = gds-sert.b-code and
     1789                                                              sert-join.cli-type = b-cli.obj-type and
     1790                                                              sert-join.cli-code = b-cli.obj-code:
     1791                           find sert of sert-join no-lock.
     1792                           if sert.last-date <= cur-date then do:
     1793                               lastdate = sert.last-date.
     1794                               disp stream out-stream sym1 gds-sert.artic sym2 gds-sert.gds-name sym3
     1795                               lastdate  sym4
     1796                               with frame gds-srt.
     1797                               DOWN stream out-stream 1 with frame gds-srt .
     1798                           end.
     1799                       end.
     1800                   end.
     1801               end.
     1802               when 3 then do:
     1803                   for each gds-sert no-lock:
     1804                       for each sert-join where sert-join.b-code = gds-sert.b-code and
     1805                                                              sert-join.cli-type = b-cli.obj-type and
     1806                                                              sert-join.cli-code = b-cli.obj-code:
     1807                           find sert of sert-join no-lock.
     1808                           run cur-time in this-procedure ( output v-today
     1809                                                          , output v-time
     1810                                                          ).
     1811                           if sert.last-date <= v-today + q-days then do:
     1812                               lastdate = sert.last-date.
     1813                               disp stream out-stream sym1 gds-sert.artic sym2 gds-sert.gds-name sym3
     1814                               lastdate sym4
     1815                               with frame gds-srt.
     1816                               DOWN stream out-stream 1 with frame gds-srt .
     1817                           end.
     1818                       end.
     1819                   end.
     1820               end.
     1821           end case.
     1822       HIDE stream out-stream FRAME BottomFrame .
     1823       PUT stream out-stream Line format "X(135)" SKIP .
     1824       output stream out-stream CLOSE .
     1825   define variable v-user-action as character no-undo .
     1826   define variable v-printed as logical   no-undo .
     1827   define variable DisabledOptions as integer   no-undo .
     1828   define variable v-orient-page as character no-undo .
     1829   run How-name in this-procedure (
     1830       input ReportPageHeight,
     1831       input ReportPageWidth,
     1832       output v-orient-page )
     1833       .
     1834   if v-orient-page = "A4-lans":U then DisabledOptions = 8 .
     1835                                  else DisabledOptions = 0 .
     1836   run gbl/prnfilen.w
     1837     (input  ""
     1838     ,input  DisabledOptions
     1839     ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     1840     ,input  reportFontNum
     1841     ,output v-user-action
     1842     ,output v-printed
     1843     ) .
     1844   END PROCEDURE.
     1845   PROCEDURE send-records :
     1846   END PROCEDURE.
     1847   PROCEDURE state-changed :
     1848     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1849     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1850     CASE p-state:
     1851       WHEN 'update-begin':U THEN DO:
     1852           RUN dispatch('enable-fields':U).
     1853           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1854           DO:
     1855             RUN new-state('update-failed,TABLEIO-SOURCE':U).
     1856             RUN new-state('update-complete':U).
     1857           END.
     1858           ELSE RUN new-state ('update':U).
     1859       END.
     1860       WHEN 'update-complete':U THEN DO:
     1861           RUN new-state ('update-complete':U).
     1862       END.
     1863     END CASE.
     1864   END PROCEDURE.
