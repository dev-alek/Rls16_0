     1938       firstline = true .
     1939        form with FRAME ZAPAS .  DOWN stream   OutStream 1 with FRAME ZAPAS .
     1940         run clear-b1 .
     1941         run clear-b2.
     1942         run clear-bi .
     1943         break_group = true.
     1944         break_group1 = true.
     1945      end procedure.
     1946   procedure print-footer :
     1947         if retclassify = "no-classify":u  then run u-line.
     1948          gds-zap-artic = "ИТОГО" .
     1949          run display-bi.
     1950          run u-line.
     1951          end procedure.
