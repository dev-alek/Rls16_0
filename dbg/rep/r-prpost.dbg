     1980   procedure calcitog :
     1981      xtog-obj = false .
     1982       run ostatok (
     1983           input x-store-code  ,
     1984           input x-store-type  ,x-tog-shift,
     1985           input x-date-start - 1 ,
     1986           input date('')      , x-shift-start,x-shift-end,
     1987           input 'crsa':U   ,
     1988           input '##,##':U,
     1989           input xtog-obj ,
     1990           output  quantity1  ,
     1991           output  coast_r1   ,
     1992           output  coast_v1   ,
     1993           output  vat_r1     ,
     1994           output  vat_v1     ,
     1995           output  fact-order-1 ).
     1996       run ostatok (
     1997           input x-store-code  ,
     1998           input x-store-type  , x-tog-shift,
     1999           input x-date-start  ,
     2000           input x-date-end    , x-shift-start,x-shift-end,
     2001           input 'crsa':U   ,
     2002           input '##,##':U,
     2003           input xtog-obj ,
     2004           output  quantity1  ,
     2005           output  coast_r1   ,
     2006           output  coast_v1   ,
     2007           output  vat_r1     ,
     2008           output  vat_v1     ,
     2009           output  fact-order-2 ).
     2010       run ostatok (
     2011           input x-store-code  ,
     2012           input x-store-type  , false ,
     2013           input  date1rash - 1 ,
     2014           input date('')      , ? , ?,
     2015           input 'crsa':U   ,
     2016           input '##,##':U,
     2017           input xtog-obj ,
     2018           output  quantity1  ,
     2019           output  coast_r1   ,
     2020           output  coast_v1   ,
     2021           output  vat_r1     ,
     2022           output  vat_v1     ,
     2023           output  fact-order-3 ).
     2024       run ostatok (
     2025           input x-store-code  ,
     2026           input x-store-type  , false ,
     2027           input date1rash  ,
     2028           input date2rash    , ?, ?,
     2029           input 'crsa':U   ,
     2030           input '##,##':U,
     2031           input xtog-obj ,
     2032           output  quantity1  ,
     2033           output  coast_r1   ,
     2034           output  coast_v1   ,
     2035           output  vat_r1     ,
     2036           output  vat_v1     ,
     2037           output  fact-order-4 ).
     2038             quantity1  = 0.
     2039             coast_r1   = 0.
     2040             coast_v1   = 0.
     2041             vat_r1     = 0.
     2042             vat_v1     = 0.
     2043    xtog-obj = xtogobj .
     2044   end procedure.
     2045   procedure display-bi  :
     2046                                run di-qnty ("кол-во" , 1 , "", gds-zap-artic ,"" ,"", "bi":u).
     2047            if show-cost        then do: run di ("учет."  , 2 , "","", "", "", "bi":u).  end.
     2048            if show-cost-vat    then do: run di ("уч.НДС" , 3 , "","", "", "", "bi":u).  end.
     2049            if show-sale        then do: run di ("док-т." , 5 , "","", "", "", "bi":u).  end.
     2050            if show-sale-vat    then do: run di ("д. НДС" , 6 , "","", "", "", "bi":u).  end.
     2051   end procedure.
