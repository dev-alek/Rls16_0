     1902           run report-execute.
     1903   procedure report-execute :
     1904     if (valtype=0 and x-base-code=0)  or valtype=1
     1905                                   then   assign tprintrubl = yes .
     1906                                   else   assign tprintrubl = no .
     1907     run waitfram-show in this-procedure  ( 'Подождите ...' ) .
     1908   output stream outstream to value( string( session:temp-directory +
     1909                                        "rpt" + string( g#report-num ) ) )
     1910                                        page-size  value(reportpageheight) .
     1911     run report-exec1.
     1912     hide   stream outstream frame zapas .
     1913     output stream outstream close.
     1914     run waitfram-hide .
     1915     if Make-Excel then output stream ForExcel close.
     1916     define variable v-user-action as character no-undo .
     1917     define variable v-printed as logical   no-undo .
     1918     define variable disabledoptions as integer   no-undo .
     1919     define variable v-orient-page as character no-undo .
     1920     run How-name in this-procedure (
     1921         input ReportPageHeight,
     1922         input ReportPageWidth,
     1923         output v-orient-page )
     1924         .
     1925     if v-orient-page = "A4-lans":U then DisabledOptions = 8 .
     1926                                    else DisabledOptions = 0 .
     1927     run gbl/prnfilen.w
     1928       (input  ""
     1929       ,input  disabledoptions
     1930       ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     1931       ,input ReportFontNum
     1932       ,output v-user-action
     1933       ,output v-printed
     1934       ) .
     1935   end procedure.
     1936   procedure print-header :
