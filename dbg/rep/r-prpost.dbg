     1227   procedure create-temp-t-post-stk-line :
     1228       define variable str  as char      format "X(60)" no-undo.
     1229       define variable str2 as char      no-undo.
     1230       define variable v-r  as character no-undo init "" .
     1231       define variable i#i  as int       no-undo.
     1232    do
     1233    on error undo, return error return-value
     1234    :
     1235    if available ub.goods and
     1236       available ub.clients and
     1237       available prod-cli then do:
     1238     create temp-t-post-stk-line .
     1239     BUFFER-COPY post-stk-line  TO temp-t-post-stk-line
     1240     assign
     1241       temp-t-post-stk-line.goods-grp-name    = ub.goods.grp-name
     1242       temp-t-post-stk-line.gds-code          = ub.goods.gds-code
     1243       temp-t-post-stk-line.unit-base         = ub.goods.unit-base
     1244       temp-t-post-stk-line.prt-root          = ub.goods.prt-root
     1245       temp-t-post-stk-line.gds-type          = ub.goods.gds-type
     1246       temp-t-post-stk-line.gds-name          = if g#gds-engl then ub.goods.engl-name else ub.goods.gds-name
     1247       temp-t-post-stk-line.clients-grp-name  = ub.clients.grp-name
     1248       temp-t-post-stk-line.clients-obj-name  = ub.clients.obj-name
     1249       temp-t-post-stk-line.prod-cli-obj-name = prod-cli.obj-name
     1250       temp-t-post-stk-line.prod-cli-obj-code = prod-cli.obj-code
     1251       temp-t-post-stk-line.prod-cli-obj-type = prod-cli.obj-type
     1252     .
     1253               if xlavel > 0 then
     1254               do:
     1255                   repeat i#i =1 to xlavel:
     1256                       if i#i =1 then str   = entry(1,ub.goods.grp-name, chr(47)) .
     1257                       else
     1258                       do:
     1259                           str2 = entry(i#i,ub.goods.grp-name, chr(47)) no-error.
     1260                           if not error-status:error  and str2 <> "":u then
     1261                               str = str +  chr(47) +  entry(i#i,ub.goods.grp-name, chr(47)) no-error .
     1262                       end.
     1263                   end.
     1264                   if str <> ? then
     1265                   do:
     1266                       temp-t-post-stk-line.goods-grp-name = str + chr(47) .
     1267                   end.
     1268               end.
     1269               else
     1270               do :
     1271                   temp-t-post-stk-line.goods-grp-name = ub.goods.grp-name.
     1272               end.
     1273           end.
     1274    end.
     1275   end procedure.
     1276   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     1277     if num-entries(string(p-dec), '.') = 2
     1278       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     1279       else return( string(p-dec)) .
     1280   end function.
     1281   function format-point-to-comma returns char (input orig as char ) .
     1282   define variable rtext as character no-undo .
     1283   define variable strt as integer no-undo .
     1284   define variable leng as integer no-undo .
     1285   assign rtext = orig .
     1286   repeat:
     1287     strt =  index(rtext,'.').
     1288     if strt = 0 then leave.
     1289     leng = 1.
     1290     substring(rtext,strt,leng,"character") = v-delim .
     1291   end.
     1292   return rtext.
     1293   end function.
     1294   function format-excel-text returns char ( input start-text as char ) :
     1295   def var  i    as int no-undo.
     1296   def var  ch   as char no-undo.
     1297   def var  n    as int no-undo.
     1298   def var  ipos as int no-undo.
     1299     n = num-entries(trim(start-text), chr(10)) - 1 .
     1300     do i = 1 to n :
     1301       ipos = index( start-text, chr(10)).
     1302       if ipos > 0 then
     1303         substr( start-text, ipos, 1 ) = ' '.
     1304     end.
     1305     n = num-entries(trim(start-text), chr(13)) - 1 .
     1306     do i = 1 to n :
     1307       ipos = index( start-text, chr(13)).
     1308       if ipos > 0 then
     1309         substr( start-text, ipos, 1 ) = ' '.
     1310     end.
     1311     if index( start-text, '"' ) = 0 then
     1312       start-text =  '="'   + trim( start-text) + '"'   .
     1313       else do:
     1314         n = num-entries(trim(start-text), '"') - 1.
     1315         do i = 1 to n :
     1316           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1317         end.
     1318         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1319         start-text = '="'  + ch  + '"' .
     1320       end.
     1321     return start-text.
     1322   end.
     1323   function excel-sum returns char (input p-dec as decimal ).
     1324     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     1325   end function.
     1326   function excel-qnty returns char (input p-dec as decimal ).
     1327     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     1328   end function.
     1329   function format-excel-text-macr returns char ( input start-text as char ) :
     1330   def var  i    as int no-undo.
     1331   def var  ch   as char no-undo.
     1332   def var  n    as int no-undo.
     1333   def var  ipos as int no-undo.
     1334     n = num-entries(trim(start-text), chr(10)) - 1 .
     1335     do i = 1 to n :
     1336       ipos = index( start-text, chr(10)).
     1337       if ipos > 0 then
     1338         substring( start-text, ipos , 1 ) = ' '.
     1339     end.
     1340     n = num-entries(trim(start-text), chr(13)) - 1 .
     1341     do i = 1 to n :
     1342       ipos = index( start-text, chr(13)).
     1343       if ipos > 0 then
     1344         substring( start-text, ipos, 1 ) = ' '.
     1345     end.
     1346     if index( start-text, '"' ) = 0 then
     1347       start-text =  '"'   + trim( start-text) + '"'   .
     1348       else do:
     1349         n = num-entries(trim(start-text), '"') - 1.
     1350         do i = 1 to n :
     1351           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1352         end.
     1353         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1354         start-text = '"'  + ch  + '"' .
     1355       end.
     1356     n = num-entries(trim(start-text), chr(10)) - 1 .
     1357     do i = 1 to n :
     1358       ipos = index( start-text, chr(10)).
     1359       if ipos > 0 then
     1360         substring( start-text, ipos , 1 ) = ' '.
     1361     end.
     1362       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     1363     return start-text.
     1364   end.
     1365   FUNCTION n-lavel RETURNS char (INPUT grp-name as char, INPUT lavel# as int ).
     1366   define variable  str  as char format "X(60)"  no-undo.
     1367   define variable  str2 as char no-undo.
     1368   define variable v-r as character no-undo init "" .
     1369   define variable  i#i as int no-undo.
     1370   STR = "".
     1371   repeat i#i =1 to lavel#:
     1372       if i#i =1 then str   = entry(1,grp-name, chr(47)) .
     1373       else do:
     1374           str2 = entry(i#i,grp-name, chr(47)) no-error.
     1375           if not error-status:error  and str2 <> "":u then
     1376                  str = str +  chr(47) +  entry(i#i,grp-name, chr(47)) no-error .
     1377           end.
     1378   end.
     1379   if str <> ? then do:
     1380   v-r = str + chr(47) .
     1381   end.
     1382   RETURN v-r .
     1383   END FUNCTION.
     1384   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1385   define variable v-waitfram-action01         as character   no-undo .
     1386   define variable v-waitfram-action02         as character   no-undo .
     1387   define variable v-waitfram-action03         as character   no-undo .
     1388   define variable mWaitFramTextBeg            as character   no-undo.
     1389   define variable mWaitFramTextEnd            as character   no-undo.
     1390   define variable mWaitFramView               as logical     no-undo.
     1391   define variable mWaitProcEvent              as logical     no-undo init yes.
     1392   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1393   define variable mWaitFramStop               as logical     no-undo.
     1394   define variable mWaitFramStopUser           as logical     no-undo.
     1395   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1396   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1397   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1398   define button B-WaitFramStop auto-end-key
     1399        label "Стоп"
     1400        size 10 by 1 tooltip "Остоновить процесс".
     1401   define button B-viewProcInfo
     1402        label "Информация"
     1403        size 15 by 1 tooltip "Информация о процесс".
     1404   define frame waitfram
     1405     v-waitfram-action01 format "x(72)" no-label skip
     1406     v-waitfram-action02 format "x(72)" no-label skip
     1407     v-waitfram-action03 format "x(72)" no-label skip
     1408     B-viewProcInfo
     1409     B-WaitFramStop at row 4 col 30
     1410     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1411     .
     1412   define new global shared variable mBatchMode as logical no-undo init ?.
     1413   define variable mFramBachModHandle as handle no-undo.
     1414   mFramBachModHandle = frame waitfram:handle.
     1415   define variable mFameOldVis as logical no-undo.
     1416   define variable mVisCUrentVin as logical no-undo.
     1417   if session:batch-mode
     1418   then
     1419      mBatchMode = yes.
     1420   if mBatchMode = ? then do:
     1421     mVisCUrentVin = current-window:visible.
     1422     mFameOldVis = mFramBachModHandle:visible.
     1423     mFramBachModHandle:visible  = yes.
     1424     mBatchMode = mFramBachModHandle:visible ne yes.
     1425     mFramBachModHandle:visible = mFameOldVis.
     1426     current-window:visible = mVisCUrentVin.
     1427   end.
     1428    if  log-manager:logfile-name ne ?
     1429     then DO:
     1430         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1431         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1432         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1433     end.
     1434   on choose of B-WaitFramStop in frame waitfram
     1435   do:
     1436     mWaitFramStop = yes.
     1437     mWaitFramStopUser = yes.
     1438   end.
     1439   function waitfram-check-timeout returns logical():
     1440      define variable vtime as int64 no-undo.
     1441      if mWaitFramStopTimeOut
     1442      then
     1443         return yes.
     1444      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1445      if     mWaitFramTimeOut ne ?
     1446         and mWaitFramTimeOut ne 0
     1447         and mWaitFramTimeOut lt vtime
     1448      then do:
     1449         mWaitFramStopTimeOut = yes.
     1450      end.
     1451      return mWaitFramStopTimeOut.
     1452   end.
     1453   procedure waitfram-hide :
     1454     if not session:batch-mode
     1455     then do
     1456     on error undo, return error return-value
     1457     :
     1458       pause 0 before-hide .
     1459       if not mBatchMode then
     1460         hide frame waitfram .
     1461     if     not mWaitFramView
     1462        and mWaitProcEvent
     1463     then
     1464       process events .
     1465     end.
     1466   end procedure.
     1467   procedure waitfram-show :
     1468     define input  parameter p-message as character no-undo .
     1469     define variable v-left-margin as integer   no-undo .
     1470     if not session:batch-mode
     1471     then do
     1472     on error undo, return error return-value
     1473     :
     1474       if length(p-message) <= 70 then do:
     1475         assign
     1476           v-left-margin = integer((70 - length(p-message)) / 2)
     1477         .
     1478         assign
     1479           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1480         .
     1481         assign
     1482           v-waitfram-action01 = " "
     1483           v-waitfram-action02 = " "
     1484                                    + fill(" ", v-left-margin)
     1485                                    + p-message
     1486           v-waitfram-action03 = " "
     1487         .
     1488       end.
     1489       else do:
     1490         define variable vRindex1 as integer no-undo.
     1491         define variable vRindex2 as integer no-undo.
     1492         vRindex1 = r-index(p-message," ",70).
     1493         if vRindex1 = 0
     1494         then
     1495            vRindex1 = 70.
     1496         if length(p-message)  <= vRindex1 + 70 then do:
     1497           assign
     1498             v-waitfram-action01 = " "
     1499             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1500             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1501           .
     1502         end.
     1503         else do:
     1504           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1505           if vRindex2 <= vRindex1
     1506           then
     1507              vRindex2 = vRindex1 + 70.
     1508           assign
     1509             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1510             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1511             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1512           .
     1513         end.
     1514       end.
     1515       B-viewProcInfo:visible   in frame waitfram = no.
     1516       B-viewProcInfo:sensitive in frame waitfram = no.
     1517       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1518       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1519       if  (   mWaitFramView
     1520          or  mWaitProcEvent)
     1521          and not mBatchMode
     1522       then
     1523          display
     1524             v-waitfram-action01 skip
     1525             v-waitfram-action02 skip
     1526             v-waitfram-action03 skip
     1527          with frame waitfram .
     1528       if     mWaitFramView
     1529          then do:
     1530             if     mWaitFramInterval ne ?
     1531                and not mBatchMode
     1532             then
     1533                wait-for go of frame waitfram pause mWaitFramInterval.
     1534          end.
     1535          else
     1536             if     mWaitProcEvent
     1537                and not mBatchMode
     1538             then
     1539                process events .
     1540     end.
     1541   end procedure.
     1542      procedure waitfram-show-this:
     1543         define input  parameter iInterval as int64 no-undo.
     1544         define variable vtime as int64 no-undo.
     1545         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1546         mWaitFramInterval = iInterval.
     1547         run waitfram-show (substitute("&1&2 &3&4" ,
     1548                                       mWaitFramTextBeg ,
     1549                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1550                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1551                                       mWaitFramTextEnd
     1552                                      )
     1553                           ).
     1554      end.
     1555      procedure WaitFramRunPause:
     1556         define input  parameter iInterval as dec no-undo.
     1557         define variable vStart  as datetime-tz no-undo.
     1558         define variable vend    as datetime-tz no-undo.
     1559         define variable vint as int64 no-undo.
     1560         define variable vOk as logical no-undo.
     1561         vStart = now.
     1562         vend   = vStart.
     1563         publish "WaitFramPause" (iInterval,output vOk).
     1564         vend   =  now.
     1565         vint = vend - vStart.
     1566         vint = iInterval - vint / 1000.
     1567         if     not mWaitFramStop
     1568            and (   vint > 0
     1569                 or (    not vOk
     1570                     and iInterval eq ?
     1571                     )
     1572                 )
     1573         then
     1574            run waitfram-show-this (iInterval).
     1575         vend   =  now.
     1576         vint = vend - vStart.
     1577         vint = iInterval - vint / 1000.
     1578         if     not mWaitFramStop
     1579            and vint > 0
     1580         then do:
     1581            run gbl/pause.p (vint * 1000).
     1582         end.
     1583         if iInterval ne ?
     1584         then
     1585            publish "WaitFramStop".
     1586         waitfram-check-timeout().
     1587      end.
     1588      procedure WaitFramWaitFor:
     1589         define input  parameter iInterval as dec no-undo.
     1590         assign
     1591            mWaitFramStartProc   = now
     1592            mWaitFramStopUser    = no
     1593            mWaitFramStopTimeOut = no
     1594         .
     1595         block-wait:
     1596         do while not mWaitFramStop:
     1597            run WaitFramRunPause (iInterval).
     1598            if  waitfram-check-timeout()
     1599            then do:
     1600               leave block-wait.
     1601            end.
     1602         end.
     1603         run waitfram-hide.
     1604      end.
     1605   procedure waitfram-join :
     1606     define input  parameter p-line-1  as character no-undo .
     1607     define input  parameter p-line-2  as character no-undo .
     1608     define input  parameter p-line-3  as character no-undo .
     1609     define output parameter p-message as character no-undo .
     1610     do
     1611     on error undo, return error return-value
     1612     :
     1613       assign
     1614         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1615                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1616                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1617       .
     1618     end.
     1619   end procedure.
     1620   function waitfram-join-function returns character
     1621     (input p-line-1 as character
     1622     ,input p-line-2 as character
     1623     ,input p-line-3 as character
     1624     ).
     1625     define variable v-message as character no-undo .
     1626     run waitfram-join in this-procedure
     1627       (input  p-line-1
     1628       ,input  p-line-2
     1629       ,input  p-line-3
     1630       ,output v-message
     1631       ) .
     1632     return v-message .
     1633   end function .
     1634   define temp-table temp-font no-undo
     1635     field fontnum  as integer
     1636     field fontname as character
     1637     field fontsize as character
     1638     field fonttype as character
     1639     field font-h   as integer
     1640     field font-w   as integer
     1641     field v-row    as integer
     1642     field v-col    as integer
     1643     field v-row-lans as integer
     1644     field v-col-lans as integer
     1645   index pi fontnum
     1646   .
     1647   procedure get-font-ini :
     1648     do
     1649     on error undo, return error return-value
     1650     :
     1651   define variable ii as integer   no-undo .
     1652   define variable v-font7 as character no-undo .
     1653   define variable v-font as character no-undo .
     1654   define variable loc-name as character no-undo .
     1655   define variable loc-size as character no-undo .
     1656   define variable loc-type as character no-undo .
     1657   define variable old_H as integer   no-undo .
     1658   define variable old_w as integer   no-undo .
     1659   define variable old-row  as integer   no-undo .
     1660   define variable old-col  as integer   no-undo .
     1661   define variable old-row-lans  as integer   no-undo .
     1662   define variable old-col-lans  as integer   no-undo .
     1663   define variable vv as integer   no-undo .
     1664   empty temp-table temp-font.
     1665     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     1666       case num-entries (v-font7) :
     1667         when 4 then do:
     1668             assign
     1669               loc-name = entry ( 1 , v-font7 )
     1670               loc-size = entry ( 2 , v-font7 )
     1671               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     1672             .
     1673         end.
     1674         when 3 then do:
     1675             assign
     1676               loc-name = entry ( 1 , v-font7 )
     1677               loc-size = entry ( 2 , v-font7 )
     1678               loc-type = entry ( 3 , v-font7 )
     1679             .
     1680         end.
     1681         when 2 then  do:
     1682             assign
     1683               loc-name = entry ( 1 , v-font7 )
     1684               loc-size = entry ( 2 , v-font7 )
     1685               loc-type = ""
     1686             .
     1687         end.
     1688         when 1 then do:
     1689             assign
     1690               loc-name = trim(entry ( 1 , v-font7 ))
     1691               loc-size = ""
     1692               loc-type = ""
     1693             .
     1694         end.
     1695       end case.
     1696     create temp-font.
     1697     assign
     1698       temp-font.fontnum  = 7
     1699       temp-font.fontname = trim(loc-name)
     1700       temp-font.fontsize = trim(loc-size)
     1701       temp-font.fonttype = trim(loc-type)
     1702       temp-font.v-row    = 62
     1703       temp-font.v-col    = 136
     1704       temp-font.v-row-lans = 43
     1705       temp-font.v-col-lans = 198
     1706     .
     1707     repeat ii = 16 to 100 :
     1708       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     1709       if v-font = "" or v-font = ? then leave.
     1710       case num-entries (v-font) :
     1711         when 4 then do:
     1712             assign
     1713               loc-name = entry ( 1 , v-font )
     1714               loc-size = entry ( 2 , v-font )
     1715               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     1716             .
     1717         end.
     1718         when 3 then do:
     1719             assign
     1720               loc-name = entry ( 1 , v-font )
     1721               loc-size = entry ( 2 , v-font )
     1722               loc-type = entry ( 3 , v-font )
     1723             .
     1724         end.
     1725         when 2 then do:
     1726             assign
     1727               loc-name = entry ( 1 , v-font )
     1728               loc-size = entry ( 2 , v-font )
     1729               loc-type = ""
     1730             .
     1731         end.
     1732         when 1 then do:
     1733             assign
     1734               loc-name = trim(entry ( 1 , v-font ))
     1735               loc-size = ""
     1736               loc-type = ""
     1737             .
     1738         end.
     1739       end case.
     1740     create temp-font.
     1741     assign
     1742       temp-font.fontnum  = ii
     1743       temp-font.fontname = trim(loc-name)
     1744       temp-font.fontsize = trim(loc-size)
     1745       temp-font.fonttype = trim(loc-type)
     1746     .
     1747     end.
     1748       for each temp-font :
     1749          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     1750          if  vv = ? then vv =  0 .
     1751           run rep/exfont.p (
     1752             input   temp-font.fontname ,
     1753             input   vv ,
     1754             input   temp-font.fonttype ,
     1755             output  temp-font.font-h   ,
     1756             output  temp-font.font-w   )
     1757           .
     1758       end.
     1759   find first temp-font where  temp-font.fontnum  = 7  .
     1760   old_H = temp-font.font-H .
     1761   old_w = temp-font.font-W .
     1762   old-row = temp-font.v-row .
     1763   old-col = temp-font.v-col .
     1764   old-row-lans = temp-font.v-row-lans .
     1765   old-col-lans = temp-font.v-col-lans .
     1766       for each temp-font where
     1767                temp-font.fontnum  <> 7 :
     1768           assign
     1769               temp-font.v-row    = old_H * old-row / temp-font.font-h
     1770               temp-font.v-col    = old_W * old-col / temp-font.font-W
     1771               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     1772               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     1773           .
     1774       end.
     1775     end.
     1776   end procedure.
     1777   PROCEDURE How-name :
     1778   define input  parameter h as integer no-undo .
     1779   define input  parameter w as integer no-undo .
     1780   define output parameter n as character  no-undo .
     1781   define variable A4port-H as integer   no-undo init 63.
     1782   define variable A4port-W as integer   no-undo init 136.
     1783   define variable A4lans-H as integer   no-undo init 43.
     1784   define variable A4lans-W as integer   no-undo init 198.
     1785   define variable Strim-W  as integer   no-undo init 278.
     1786   run define-a4-size (
     1787        input ReportFontNum
     1788       ,output A4port-H
     1789       ,output A4port-W
     1790       ,output A4lans-H
     1791       ,output A4lans-W ).
     1792   If w >= 1 and w <= A4port-W Then DO:
     1793     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1794     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     1795     If h > A4port-H              Then n = "to-file":U.
     1796   End.
     1797   If w > A4port-W and w <= A4lans-W Then DO:
     1798     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1799     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1800     If h > A4port-H              Then n = "to-file":U.
     1801   End.
     1802   If w > A4lans-W and w <= Strim-W Then DO:
     1803     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     1804     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1805     If h > A4port-H              Then n = "to-file":U.
     1806   End.
     1807   If w > Strim-W Then DO:
     1808      n = "to-file":U.
     1809   End.
     1810   END PROCEDURE.
     1811   PROCEDURE define-a4-size :
     1812   define input  parameter p-ReportFontNum as integer   no-undo .
     1813   define output parameter A4port-H as integer   no-undo .
     1814   define output parameter A4port-W as integer   no-undo .
     1815   define output parameter A4lans-H as integer   no-undo .
     1816   define output parameter A4lans-W as integer   no-undo .
     1817   if not can-find (first temp-font ) then do:
     1818      run get-font-ini .
     1819   end.
     1820   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     1821   if available temp-font then do:
     1822   assign
     1823     A4port-H = temp-font.v-row
     1824     A4port-W = temp-font.v-col
     1825     A4lans-H = temp-font.v-row-lans
     1826     A4lans-W = temp-font.v-col-lans
     1827   .
     1828   end.
     1829   else do:
     1830   assign
     1831     A4port-H = 63
     1832     A4port-W = 136
     1833     A4lans-H = 43
     1834     A4lans-W = 198
     1835   .
     1836   end.
     1837   END PROCEDURE.
