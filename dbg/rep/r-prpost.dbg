     2088   procedure display-title :
     2089      PUT stream  OutStream  UNFORMATTED  string( v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + objname) at 50 format "x(85)" skip(2)
     2090             reportname  at 20 format "x(170)" skip
     2091             trim(str1)  at 35 format "x(75)" skip.
     2092        repeat i = 1 to num-entries(str2,chr(10)) :
     2093         PUT stream  OutStream  UNFORMATTED  entry(i,str2,chr(10))  at 1 format "x(170)" skip.
     2094        end.
     2095       i=0.
     2096          PUT stream  OutStream  UNFORMATTED  trim(str3)  at 35 format "x(75)" skip.
     2097        repeat i = 1 to num-entries(str4,chr(10)) :
     2098         PUT stream  OutStream  UNFORMATTED  entry(i,str4,chr(10))  at 1 format "x(170)" skip.
     2099        end.
     2100       i=0.
     2101        repeat i = 1 to num-entries(reportheader,chr(10)) :
     2102         PUT stream  OutStream  UNFORMATTED  entry(i,reportheader,chr(10))  at 1 format "x(170)" skip.
     2103        end.
     2104       i=0.
     2105       run rep/extitle.p (1) .
     2106   end procedure.
     2107   PROCEDURE ostatok :
     2108   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     2109   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     2110   def input parameter x-tog-shift   as   logical             no-undo.
     2111   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     2112   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     2113   def input parameter x-shift-start as integer               no-undo.
     2114   def input parameter x-shift-end   as integer               no-undo.
     2115   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     2116   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     2117   def input parameter xTog-obj   as log no-undo.
     2118   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     2119   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     2120   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     2121   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     2122   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     2123   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     2124   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     2125   def var              Fact-orderS   as char  no-undo.
     2126   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     2127      Assign
     2128         Fact-order   = 0
     2129         Quantity     = 0
     2130         Coast_R      = 0
     2131         Coast_V      = 0
     2132         VAT_R        = 0
     2133         VAT_V        = 0 .
     2134    x-date-start-t  = x-date-start + 1 .
     2135   IF x-date-end = date('') then DO:
     2136      Fact-order = 0 .
     2137      for each obj-list
     2138          where  ( not xtog-obj or
     2139                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     2140                 no-lock :
     2141         if  x-tog-shift = false then do:
     2142                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2143                               ub.stk-tot.Fact-date <=  x-date-start
     2144                               and ub.stk-tot.shift-num = 0
     2145                               USE-INDEX fact-date no-lock no-error .
     2146              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2147         End.
     2148         Else  DO :
     2149             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2150              (ub.stk-tot.shift-date  = x-date-start-t and
     2151               ub.stk-tot.shift-num  < x-shift-start or
     2152               ub.stk-tot.shift-date  < x-date-start-t  )
     2153               and ub.stk-tot.shift-num  > 0
     2154               USE-INDEX Shift-num no-lock no-error .
     2155            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2156           END.
     2157       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     2158     End.
     2159   End.
     2160   Else DO:
     2161     For each obj-list  WHERE
     2162        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     2163         no-lock :
     2164      IF  x-TOG-Shift = False Then DO:
     2165          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2166               ub.stk-tot.Fact-date <= x-date-end
     2167               and ub.stk-tot.shift-num = 0
     2168               USE-INDEX fact-date no-lock no-error.
     2169          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2170      END.
     2171      Else DO:
     2172           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2173               (ub.stk-tot.shift-date  = x-date-end and
     2174               ub.stk-tot.shift-num  <= x-shift-end or
     2175               ub.stk-tot.shift-date  < x-date-end       ) and
     2176               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     2177               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2178       End.
     2179       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     2180     End.
     2181   End.
     2182   END PROCEDURE.
     2183   procedure report-exec1  :
     2184      find first a-clients where x-store-type = a-clients.obj-type and
     2185                               x-store-code = a-clients.obj-code no-lock no-error.
     2186              if available a-clients then  objname = a-clients.obj-name. else  objname = "объект не определен".
     2187     run waitfram-show in this-procedure  (objname) .
     2188     form with frame zapas .
     2189   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2190   form header
     2191     line format "x(194)" at 1 skip
     2192     "Продолжение - на следующей странице" at 30 skip
     2193     with frame bottomframe width 232 page-bottom no-labels no-box .
     2194   view stream outstream frame bottomframe .
     2195     run calcitog.
     2196     run print-header.
     2197     case retsorttype :
     2198         when "sort-article":u  or when "sort-artic":u  then
     2199         if not can-find(first g#post no-lock)
     2200             then   run rep/r-ppr-1.p (x-store-code, x-store-type, x-base-type , x-base-code ).
     2201             else   run rep/r-ppr-2.p (x-store-code, x-store-type, x-base-type , x-base-code ).
     2202         when "sort-code":u  then
     2203         if not can-find(first g#post no-lock)
     2204             then   run rep/r-ppr-3.p (x-store-code, x-store-type, x-base-type , x-base-code ).
     2205             else   run rep/r-ppr-4.p (x-store-code, x-store-type, x-base-type , x-base-code ).
     2206     end case.
     2207     hide stream outstream frame bottomframe .
     2208     run print-footer.
     2209     end procedure.
     2210   procedure calc-sub-itog :
     2211   define input parameter tt as int no-undo.
     2212   define variable b as int no-undo.
     2213   repeat b = 1 to 3:
     2214     assign
     2215     b1-prih[b + tt]    = b1-prih[b + tt]    +  prih[b + tt]
     2216     b2-prih[b + tt]    = b2-prih[b + tt]    +  prih[b + tt]
     2217     bi-prih[b + tt]    = bi-prih[b + tt]    +  prih[b + tt]
     2218     b1-rash[b + tt]    = b1-rash[b + tt]    +  rash[b + tt]
     2219     b2-rash[b + tt]    = b2-rash[b + tt]    +  rash[b + tt]
     2220     bi-rash[b + tt]    = bi-rash[b + tt]    +  rash[b + tt]
     2221     b1-kassa[b + tt]    = b1-kassa[b + tt]    +  kassa[b + tt]
     2222     b2-kassa[b + tt]    = b2-kassa[b + tt]    +  kassa[b + tt]
     2223     bi-kassa[b + tt]    = bi-kassa[b + tt]    +  kassa[b + tt]
     2224     b1-inv[b + tt]    = b1-inv[b + tt]    +  inv[b + tt]
     2225     b2-inv[b + tt]    = b2-inv[b + tt]    +  inv[b + tt]
     2226     bi-inv[b + tt]    = bi-inv[b + tt]    +  inv[b + tt]
     2227     .
     2228   end.
     2229   end procedure.
     2230   procedure clear-item :
     2231   define variable kk as int no-undo.
     2232    repeat kk = 1 to 9:
     2233    assign
     2234       prih             [kk]  = 0
     2235       rash             [kk]  = 0
     2236       kassa            [kk]  = 0
     2237       inv              [kk]  = 0
     2238       vzvr-post        [kk]  = 0
     2239       vzvr             [kk]  = 0
     2240       spis             [kk]  = 0 .
     2241          end.
     2242    end procedure.
     2243   procedure di :
     2244   define input parameter p1 as char no-undo.
     2245   define input parameter p2 as int no-undo.
     2246   define input parameter p3 as char no-undo.
     2247   define input parameter p4 as char no-undo.
     2248   define input parameter p5 as char no-undo.
     2249   define input parameter p6 as char no-undo.
     2250   define input parameter p7 as char no-undo.
     2251    case caps(p7) :
     2252      when "bi":u then do:
     2253                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym13
     2254                   p3 @ gds-zap-b-code
     2255                   p4 @ gds-zap-artic
     2256                   p5 @ gds-zap-gds-name
     2257                   p6 @ gds-zap-unit-base
     2258                   p1 @ gds-type
     2259                  bi-vzvr      [p2]    @  F-vzvr
     2260                  bi-vzvr-post [p2]    @  F-vzvr-post
     2261                  bi-Prih      [p2]    @  F-Prih
     2262                  bi-RAsh      [p2]    @  F-RAsh
     2263                  bi-KAssa     [p2]    @  F-KAssa
     2264                  bi-Inv       [p2]    @  F-Inv
     2265                  bi-spis      [p2]    @  F-spis
     2266                  bi-sm        [p2]    @  F-sm
     2267                  with FRAME ZAPAS .
     2268                end.
     2269      end case.
     2270                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     2271    end procedure.
     2272   procedure di-qnty :
     2273   define input parameter p1 as char no-undo.
     2274   define input parameter p2 as int no-undo.
     2275   define input parameter p3 as char no-undo.
     2276   define input parameter p4 as char no-undo.
     2277   define input parameter p5 as char no-undo.
     2278   define input parameter p6 as char no-undo.
     2279   define input parameter p7 as char no-undo.
     2280    case caps(p7) :
     2281      when "bi":u then  do :
     2282                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym13
     2283                   p3 @ gds-zap-b-code
     2284                   p4 @ gds-zap-artic
     2285                   p5 @ gds-zap-gds-name
     2286                   p6 @ gds-zap-unit-base
     2287                   p1 @ gds-type
     2288                  bi-vzvr      [p2]    @  F-vzvr
     2289                  bi-vzvr-post [p2]    @  F-vzvr-post
     2290                  bi-Prih      [p2]    @  F-Prih
     2291                  bi-RAsh      [p2]    @  F-RAsh
     2292                  bi-KAssa     [p2]    @  F-KAssa
     2293                  bi-Inv       [p2]    @  F-Inv
     2294                  bi-spis      [p2]    @  F-spis
     2295                  bi-sm        [p2]    @  F-sm
     2296                  with FRAME ZAPAS .
     2297       if Make-Excel then  put   stream ForExcel unformatted p3 CHR(9)
     2298                   p4 CHR(9)
     2299                   p5 CHR(9)
     2300                   p6 CHR(9)
     2301                   gds-zap-type CHR(9)
     2302                   bi-Prih[1]  CHR(9)
     2303   if Showcost       then (     excel-sum(bi-Prih [2]) + CHR(9)   ) else ("")
     2304   if Show-cost-vat  then (     excel-sum  (   bi-Prih [3]) + CHR(9)   ) else ("")
     2305   if Showsale       then (     excel-sum  (   bi-Prih [5]) + CHR(9)   ) else ("")
     2306   if Show-sale-vat  then (     excel-sum  (   bi-Prih [6]) + CHR(9)   ) else ("")
     2307                     bi-RAsh         [1] FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     2308   if Showcost       then (     excel-sum  (   bi-RAsh[2] )  + CHR(9)   ) else ("")
     2309   if Show-cost-vat  then (     excel-sum  (   bi-RAsh[3] )  + CHR(9)   ) else ("")
     2310   if Showsale       then (     excel-sum  (   bi-RAsh[5] )  + CHR(9)   ) else ("")
     2311   if Show-sale-vat  then (     excel-sum  (   bi-RAsh[6] )  + CHR(9)   ) else ("")
     2312                    bi-KAssa        [1] FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     2313   if Showcost       then (     excel-sum  (   bi-KAssa[2])  + CHR(9)    ) else ("")
     2314   if Show-cost-vat  then (     excel-sum  (   bi-KAssa[3])  + CHR(9)    ) else ("")
     2315   if Showsale       then (     excel-sum  (   bi-KAssa[5])  + CHR(9)    ) else ("")
     2316   if Show-sale-vat  then (     excel-sum  (   bi-KAssa[6])  + CHR(9)    ) else ("")
     2317   .
     2318   if Make-Excel then  put   stream ForExcel unformatted     bi-Inv            [1] FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     2319   if Showcost       then (     excel-sum  (   bi-Inv [2] ) + CHR(9)    ) else ("")
     2320   if Show-cost-vat  then (     excel-sum  (   bi-Inv [3] ) + CHR(9)    ) else ("")
     2321   if Showsale       then (     excel-sum  (   bi-Inv [5] ) + CHR(9)    ) else ("")
     2322   if Show-sale-vat  then (     excel-sum  (   bi-Inv [6] ) + CHR(9)    ) else ("")
     2323                    bi-vzvr         [1] FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     2324   if Showcost       then (     excel-sum  (   bi-vzvr [2] ) + CHR(9)    ) else ("")
     2325   if Show-cost-vat  then (     excel-sum  (   bi-vzvr [3] ) + CHR(9)    ) else ("")
     2326   if Showsale       then (     excel-sum  (   bi-vzvr [5] ) + CHR(9)    ) else ("")
     2327   if Show-sale-vat  then (     excel-sum  (   bi-vzvr [6] ) + CHR(9)    ) else ("")
     2328                   bi-vzvr-post    [1] FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     2329   if Showcost       then (     excel-sum  (   bi-vzvr-post[2] ) + CHR(9)     ) else ("")
     2330   if Show-cost-vat  then (     excel-sum  (   bi-vzvr-post[3] ) + CHR(9)     ) else ("")
     2331   if Showsale       then (     excel-sum  (   bi-vzvr-post[5] ) + CHR(9)     ) else ("")
     2332   if Show-sale-vat  then (     excel-sum  (   bi-vzvr-post[6] ) + CHR(9)     ) else ("")
     2333            chr(10).
     2334                end.
     2335      end case.
     2336                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     2337    end procedure.
