      569   CREATE WIDGET-POOL.
      570   def var State-source as  WIDGET-HANDLE.
      571   def var ii as integer no-undo .
      572   define variable cli-list as character no-undo .
      573   define buffer buf_clients for clients .
      574   DEFINE BUTTON BUTTON-cli
      575        IMAGE-UP FILE "btn-down-arrow":U
      576        IMAGE-DOWN FILE "btn-down-arrow":U
      577        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      578        LABEL "2"
      579        SIZE 2.88 BY 1.
      580   DEFINE BUTTON BUTTON-cli-2
      581        IMAGE-UP FILE "btn-down-arrow":U
      582        IMAGE-DOWN FILE "btn-down-arrow":U
      583        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      584        LABEL "2"
      585        SIZE 2.88 BY 1.
      586   DEFINE VARIABLE cli-type AS CHARACTER FORMAT "X(256)":U
      587        VIEW-AS COMBO-BOX INNER-LINES 2
      588        DROP-DOWN-LIST
      589        SIZE 6 BY 1 NO-UNDO.
      590   DEFINE VARIABLE cli-type-2 AS CHARACTER FORMAT "X(256)":U
      591        VIEW-AS COMBO-BOX INNER-LINES 2
      592        DROP-DOWN-LIST
      593        SIZE 6 BY 1 NO-UNDO.
      594   DEFINE VARIABLE cli-code AS INTEGER FORMAT ">>>>>>>>>>>9" INITIAL 0
      595        LABEL "1"
      596        VIEW-AS FILL-IN
      597        SIZE 6 BY 1.
      598   DEFINE VARIABLE cli-code-2 AS INTEGER FORMAT ">>>>>>>>>>>9" INITIAL 0
      599        LABEL "2"
      600        VIEW-AS FILL-IN
      601        SIZE 6 BY 1.
      602   DEFINE VARIABLE cli-name AS CHARACTER FORMAT "X(40)"
      603         VIEW-AS TEXT
      604        SIZE 47.5 BY 1.
      605   DEFINE VARIABLE cli-name-2 AS CHARACTER FORMAT "X(40)"
      606         VIEW-AS TEXT
      607        SIZE 47 BY 1.
      608   DEFINE VARIABLE FILL-date AS DATE FORMAT "99/99/99":U
      609        VIEW-AS FILL-IN
      610        SIZE 9 BY 1 NO-UNDO.
      611   DEFINE VARIABLE FILL-date1 AS DATE FORMAT "99/99/99":U
      612        LABEL "c"
      613        VIEW-AS FILL-IN
      614        SIZE 9 BY 1 NO-UNDO.
      615   DEFINE VARIABLE FILL-date2 AS DATE FORMAT "99/99/99":U
      616        LABEL "по"
      617        VIEW-AS FILL-IN
      618        SIZE 9 BY 1 NO-UNDO.
      619   DEFINE VARIABLE FILL-time AS INTEGER FORMAT ">9":U INITIAL 0
      620        LABEL "время (часы)"
      621        VIEW-AS FILL-IN
      622        SIZE 3 BY 1 NO-UNDO.
      623   DEFINE VARIABLE var-lavel AS INTEGER FORMAT ">>9":U INITIAL 1
      624        VIEW-AS FILL-IN NATIVE
      625        SIZE 5 BY .79 NO-UNDO.
      626   DEFINE VARIABLE var-lavel-2 AS INTEGER FORMAT ">>9":U INITIAL 1
      627        VIEW-AS FILL-IN NATIVE
      628        SIZE 5 BY .79 NO-UNDO.
      629   DEFINE VARIABLE Classify AS CHARACTER
      630        VIEW-AS RADIO-SET VERTICAL
      631        RADIO-BUTTONS
      632             "Без классификации", "no-classify":U,
      633   "Группы поставщиков", "post":U,
      634   "Группы товаров", "grp-goods":U,
      635   "Группы поставщиков/Группы товаров", "post/grp-goods":U,
      636   "Группы товаров/Группы поставщиков", "grp-goods/post":U
      637        SIZE 38.5 BY 5
      638        FGCOLOR 0  NO-UNDO.
      639   DEFINE VARIABLE Rad-Goods AS INTEGER
      640        VIEW-AS RADIO-SET VERTICAL
      641        RADIO-BUTTONS
      642             "все", 1,
      643   "только 0", 2
      644        SIZE 13 BY 2.29
      645        FGCOLOR 0  NO-UNDO.
      646   DEFINE VARIABLE Rad-Inter AS INTEGER
      647        VIEW-AS RADIO-SET VERTICAL
      648        RADIO-BUTTONS
      649             "за период", 1,
      650   "на дату", 2
      651        SIZE 12 BY 2.17 NO-UNDO.
      652   DEFINE VARIABLE SortType AS CHARACTER
      653        VIEW-AS RADIO-SET VERTICAL
      654        RADIO-BUTTONS
      655             "по артикулу", "sort-article":U,
      656   "по наимен.", "sort-name":U
      657        SIZE 14 BY 2.25
      658        FGCOLOR 0  NO-UNDO.
      659   DEFINE RECTANGLE RECT-5
      660        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      661        SIZE 45.75 BY 8.
      662   DEFINE RECTANGLE RECT-7
      663        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      664        SIZE 42.25 BY 3.42.
      665   DEFINE RECTANGLE RECT-8
      666        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      667        SIZE 23 BY 8.
      668   DEFINE RECTANGLE RECT-9
      669        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      670        SIZE 69.5 BY 3.42.
      671   DEFINE VARIABLE ShowGoods AS LOGICAL INITIAL no
      672        LABEL "Показать товары":L
      673        VIEW-AS TOGGLE-BOX
      674        SIZE 19 BY .83
      675        FGCOLOR 4  NO-UNDO.
      676   DEFINE VARIABLE Tog-lavel AS LOGICAL INITIAL no
      677        LABEL "с уровня":L
      678        VIEW-AS TOGGLE-BOX
      679        SIZE 12.63 BY .79
      680        FGCOLOR 0  NO-UNDO.
      681   DEFINE VARIABLE Tog-lavel-2 AS LOGICAL INITIAL no
      682        LABEL "с уровня":L
      683        VIEW-AS TOGGLE-BOX
