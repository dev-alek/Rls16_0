      685        FGCOLOR 0  NO-UNDO.
      686   DEFINE FRAME F-Main
      687        Rad-Inter AT ROW 2 COL 3 NO-LABEL
      688        FILL-date1 AT ROW 2 COL 17.25 COLON-ALIGNED
      689        FILL-date2 AT ROW 2 COL 31.63 COLON-ALIGNED
      690        FILL-date AT ROW 3.08 COL 13.75 COLON-ALIGNED NO-LABEL
      691        FILL-time AT ROW 3.13 COL 37.63 COLON-ALIGNED
      692        cli-code AT ROW 5.5 COL 4 COLON-ALIGNED
      693        cli-type AT ROW 5.5 COL 10.5 COLON-ALIGNED NO-LABEL
      694        BUTTON-cli AT ROW 5.5 COL 18.5
      695        cli-code-2 AT ROW 6.75 COL 4 COLON-ALIGNED
      696        cli-type-2 AT ROW 6.75 COL 10.5 COLON-ALIGNED NO-LABEL
      697        BUTTON-cli-2 AT ROW 6.75 COL 18.5
      698        ShowGoods AT ROW 8.75 COL 49.5
      699        Classify AT ROW 9.5 COL 2.75 NO-LABEL
      700        Rad-Goods AT ROW 9.71 COL 51 NO-LABEL
      701        Tog-lavel-2 AT ROW 10.46 COL 28.25
      702        var-lavel-2 AT ROW 10.46 COL 39.13 COLON-ALIGNED NO-LABEL
      703        var-lavel AT ROW 11.29 COL 39.13 COLON-ALIGNED NO-LABEL
      704        Tog-lavel AT ROW 11.33 COL 28.25
      705        SortType AT ROW 13.75 COL 50.5 NO-LABEL
      706        cli-name AT ROW 5.5 COL 21 NO-LABEL
      707        cli-name-2 AT ROW 6.75 COL 21.5 NO-LABEL
      708        "Классификация :" VIEW-AS TEXT
      709             SIZE 15 BY .75 AT ROW 8.63 COL 7.13
      710             FGCOLOR 4
      711        "Сортировка :" VIEW-AS TEXT
      712             SIZE 13.63 BY .75 AT ROW 12.79 COL 50.13
      713             FGCOLOR 4
      714        "Выбор отчета:" VIEW-AS TEXT
      715             SIZE 19.38 BY .67 AT ROW 1.25 COL 3
      716             FGCOLOR 4
      717        "Объекты для анализа:" VIEW-AS TEXT
      718             SIZE 22.25 BY .67 AT ROW 4.88 COL 2.75
      719             FGCOLOR 4
      720        RECT-8 AT ROW 8.5 COL 48
      721        RECT-5 AT ROW 8.46 COL 1.75
      722        RECT-7 AT ROW 1.04 COL 1.75
      723        RECT-9 AT ROW 4.75 COL 1.5
      724       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      725            SIDE-LABELS NO-UNDERLINE THREE-D
      726            AT COL 1 ROW 1 SCROLLABLE .
      727   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      728   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      729   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      730   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      731   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      732   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      733   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      734   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      735         adm-object-hdl = FRAME F-Main:HANDLE.
      736   RUN ensure-broker.
      737   THIS-PROCEDURE:ADM-DATA =
      738        'ADM1.1~`':U +
      739        'SmartObject~`':U +
      740        '~`':U +
      741        'NO ~`':U +
      742        '~`':U +
      743        '~`':U +
      744        '~`':U +
      745        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      746           + "~`":U +
      747        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      748        'Record-Source,Record-Target,TableIO-Target~`':U +
      749        '~`':U +
      750        '~`~`~`~`~`~`~`~`~`~`~`':U +
      751        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      752            THEN "^^":U
      753        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      754             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      755   PROCEDURE adm-apply-entry :
      756     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      757   END PROCEDURE.
      758   PROCEDURE adm-destroy :
      759    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      760   END PROCEDURE.
      761   PROCEDURE adm-disable :
      762       DISABLE RECT-8 RECT-5 RECT-7 RECT-9 Rad-Inter FILL-date1 FILL-date2 FILL-date FILL-time cli-code cli-type BUTTON-cli cli-code-2 cli-type-2 BUTTON-cli-2 ShowGoods Classify Rad-Goods SortType WITH FRAME F-Main.
      763       RUN dispatch ('disable-fields':U).
      764       RUN set-attribute-list ('ENABLED=no':U).
      765       RETURN.
      766   END PROCEDURE.
      767   PROCEDURE adm-edit-attribute-list :
      768         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      769         RETURN.
      770   END PROCEDURE.
      771   PROCEDURE adm-enable :
      772       ENABLE UNLESS-HIDDEN RECT-8 RECT-5 RECT-7 RECT-9 Rad-Inter FILL-date1 FILL-date2 FILL-date FILL-time cli-code cli-type BUTTON-cli cli-code-2 cli-type-2 BUTTON-cli-2 ShowGoods Classify Rad-Goods SortType WITH FRAME F-Main.
      773       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      774       RUN set-attribute-list ('ENABLED=yes':U).
      775       RETURN.
      776   END PROCEDURE.
      777   PROCEDURE adm-exit :
      778        RUN notify ('exit':U).
      779     RETURN.
      780   END PROCEDURE.
      781   PROCEDURE adm-hide :
      782     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      783   END PROCEDURE.
      784   PROCEDURE adm-initialize :
      785     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      786   END PROCEDURE.
      787   PROCEDURE adm-show-errors :
      788       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      789       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      790           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      791       END.
      792       RETURN.
      793   END PROCEDURE.
      794   PROCEDURE adm-UIB-mode :
      795     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      796   END PROCEDURE.
      797   PROCEDURE adm-view :
      798     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      799   END PROCEDURE.
      800   PROCEDURE dispatch :
      801       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      802       RUN broker-dispatch IN adm-broker-hdl
      803           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      804       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      805   END PROCEDURE.
      806   PROCEDURE ensure-broker :
      807   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      808   IF RETURN-VALUE NE "ADM-Broker":U THEN
      809   DO:
      810       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      811       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      812   END.
      813   END PROCEDURE.
      814   PROCEDURE get-attribute :
      815     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      816     RUN broker-get-attribute IN adm-broker-hdl
      817         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      818     RETURN RETURN-VALUE.
      819   END PROCEDURE.
      820   PROCEDURE get-attribute-list :
      821     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      822     RUN broker-get-attribute-list IN adm-broker-hdl
      823         (INPUT THIS-PROCEDURE,
      824          INPUT ?,
      825          OUTPUT p-attr-list) NO-ERROR.
      826     RETURN.
      827   END PROCEDURE.
      828   PROCEDURE new-state :
      829     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      830     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      831     RETURN.
      832   END PROCEDURE.
      833   PROCEDURE notify :
      834     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      835     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      836     IF RETURN-VALUE = "ADM-ERROR":U THEN
      837         RETURN "ADM-ERROR":U.
      838     RETURN.
      839   END PROCEDURE.
      840   PROCEDURE set-attribute-list :
      841     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      842     RUN ensure-broker.
      843     RUN broker-set-attribute-list IN adm-broker-hdl
      844         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      845     RETURN.
      846   END PROCEDURE.
      847   PROCEDURE set-position :
      848       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      849       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      850       IF VALID-HANDLE(adm-object-hdl) THEN
      851       DO:
      852         ASSIGN adm-object-hdl:ROW    =   p-row
      853                adm-object-hdl:COLUMN =   p-col.
      854       END.
      855       RETURN.
      856   END PROCEDURE.
      857   PROCEDURE adm-display-fields :
      858       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      859       RETURN.
      860   END PROCEDURE.
      861   PROCEDURE adm-open-query :
      862     RETURN.
      863   END PROCEDURE.
      864   PROCEDURE adm-row-changed :
      865         IF VALID-HANDLE(adm-object-hdl) THEN
      866           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      867         RUN notify ('row-available':U).
      868         RETURN.
      869   END PROCEDURE.
      870   PROCEDURE reposition-query :
      871       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      872       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      873       RETURN.
      874   END PROCEDURE.
      875     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      876     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      877     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      878     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      879     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      880     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      881     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      882     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      883     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      884     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      885     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      886     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      887     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      888     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      889     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      890     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      891     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      892     IF "":U = "":U THEN
      893       RUN modify-list-attribute IN adm-broker-hdl
      894         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      895     RUN use-create-on-add(?).
      896   PROCEDURE adm-add-record :
      897       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      898          "must have at least one Enabled Table to perform Add.":U
      899          VIEW-AS ALERT-BOX ERROR.
      900       RETURN.
      901   END PROCEDURE.
      902   PROCEDURE adm-assign-record :
      903    MESSAGE
      904          "Object ":U THIS-PROCEDURE:FILE-NAME
      905            "must have at least one Enabled Table to perform Assign.":U
      906              VIEW-AS ALERT-BOX ERROR.
      907      RETURN.
      908     END PROCEDURE.
      909   PROCEDURE adm-assign-statement :
      910     RETURN.
      911   END PROCEDURE.
      912   PROCEDURE adm-cancel-record :
      913      RETURN.
      914     END PROCEDURE.
      915   PROCEDURE adm-copy-record :
      916       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      917        "must have at least one Enabled Table to perform Copy.":U
      918          VIEW-AS ALERT-BOX ERROR.
      919       RETURN.
      920   END PROCEDURE.
      921   PROCEDURE adm-create-record :
      922      RETURN.
      923   END PROCEDURE.
      924   PROCEDURE adm-current-changed :
      925     RETURN.
      926   END PROCEDURE.
      927   PROCEDURE adm-delete-record :
      928    MESSAGE
      929          "Object ":U THIS-PROCEDURE:FILE-NAME
      930            "must have at least one Enabled Table to perform Delete.":U
      931              VIEW-AS ALERT-BOX ERROR.
      932       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      933       RETURN.
      934   END PROCEDURE.
      935   PROCEDURE adm-disable-fields :
      936         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
      937       RETURN.
      938   END PROCEDURE.
      939   PROCEDURE adm-enable-fields :
      940       RETURN.
      941   END PROCEDURE.
      942   PROCEDURE adm-end-update :
      943     RETURN.
      944   END PROCEDURE.
      945   PROCEDURE adm-reset-record :
      946       RETURN.
      947   END PROCEDURE.
      948   PROCEDURE adm-update-record :
      949       MESSAGE
      950         "Object ":U THIS-PROCEDURE:FILE-NAME
      951           "must have at least one Enabled Table to perform Update.":U
      952             VIEW-AS ALERT-BOX ERROR.
      953      RETURN.
      954   END PROCEDURE.
      955   PROCEDURE check-modified :
      956   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      957   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      958   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      959   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      960     IF check-state = "check":U THEN
      961     DO:
      962       RUN get-link-handle IN adm-broker-hdl
      963         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      964            OUTPUT group-target-list).
      965       IF group-target-list NE "":U THEN
      966       DO i = 1 TO NUM-ENTRIES(group-target-list):
      967         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      968         RUN check-modified IN curr-widget ('group-check':U).
      969         IF RETURN-VALUE NE "":U THEN
      970         DO:
      971           RUN check-modified-message(RETURN-VALUE).
      972           RETURN "":U.
      973         END.
      974       END.
      975     END.
      976     RETURN "":U.
      977   END PROCEDURE.
      978   PROCEDURE check-modified-message :
      979     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      980        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      981           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      982        IF RETURN-VALUE = "YES":U THEN
      983           RUN notify ('view,CONTAINER-SOURCE':U).
      984        MESSAGE IF p-changed-table NE ? THEN
      985           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      986           ELSE "Current values have been changed."
      987           SKIP "  Do you wish to save those changes?"
      988           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      989        IF ANS THEN
      990        DO:
      991           IF group-assign-target THEN
      992             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      993           ELSE RUN dispatch('update-record':U).
      994           IF RETURN-VALUE = "ADM-ERROR":U THEN
      995           DO:
      996               MESSAGE "Changes to the previous record were not saved."
      997                 VIEW-AS ALERT-BOX ERROR.
      998               IF group-assign-target THEN
      999                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1000               ELSE RUN dispatch ('cancel-record':U).
     1001           END.
     1002        END.
     1003        ELSE DO:
     1004          IF group-assign-target THEN
     1005             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1006          ELSE RUN dispatch('cancel-record':U).
     1007        END.
     1008        RETURN.
     1009   END PROCEDURE.
     1010   PROCEDURE get-rowid :
     1011       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1012       ASSIGN
     1013       p-table   =   adm-first-table.
     1014       RETURN.
     1015   END PROCEDURE.
     1016   PROCEDURE init-group-assign :
     1017       RUN request-attribute IN adm-broker-hdl
     1018         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1019       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1020         group-assign-target = yes.
     1021       ELSE group-assign-target = no.
     1022       RETURN.
     1023   END PROCEDURE.
     1024   PROCEDURE set-editors :
     1025       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1026       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1027       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1028       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1029       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1030       DO WHILE VALID-HANDLE (curr-widget):
     1031           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1032              curr-widget:HIDDEN = no THEN DO:
     1033             CASE p-field-setting:
     1034               WHEN "INITIALIZE":U THEN
     1035               DO:
     1036                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1037                     read-only-list +
     1038                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1039                        STRING(curr-widget).
     1040               END.
     1041               WHEN "DISABLE":U OR
     1042               WHEN "ENABLE":U THEN
     1043               DO:
     1044                   curr-widget:SENSITIVE = yes.
     1045                   RUN get-attribute ('Read-Only-Editors':U).
     1046                   IF RETURN-VALUE = ? OR
     1047                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1048                       curr-widget:READ-ONLY =
     1049                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1050               END.
     1051               WHEN "CLEAR":U THEN
     1052                   curr-widget:SCREEN-VALUE = "":U.
     1053             END CASE.
     1054           END.
     1055           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1056       END.
     1057       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1058         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1059           + '"':U).
     1060       RETURN.
     1061   END PROCEDURE.
     1062   PROCEDURE use-check-modified-all :
     1063    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1064     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1065     RETURN.
     1066   END PROCEDURE.
     1067   PROCEDURE use-create-on-add :
     1068   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1069      RETURN.
     1070   END PROCEDURE.
     1071   PROCEDURE use-initial-lock :
     1072     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1073     ASSIGN adm-initial-lock = p-attr-value.
     1074     RETURN.
     1075   END PROCEDURE.
     1076     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1077   ASSIGN
     1078          FRAME F-Main:SCROLLABLE       = FALSE
     1079          FRAME F-Main:HIDDEN           = TRUE.
     1080   ON CHOOSE OF BUTTON-cli IN FRAME F-Main
     1081   DO:
     1082     run ref/cli-all.w ( my-handle, "b-sel", 'объект':U, 'все':U, 'текущие':U, ?, ",,,,,,NO,,":u, "without-obj":U, output cli-list ) .
     1083     if cli-list <> "" then do:
     1084       find first buf_clients no-lock where RECID(buf_clients) = int (cli-list) no-error.
     1085       assign cli-type = buf_clients.obj-type  cli-code = buf_clients.obj-code  cli-name = buf_clients.obj-name .
     1086     end.
     1087     else assign cli-name = ""   cli-code = ?  .
     1088     display cli-name    cli-code   with frame F-Main.
     1089   END.
     1090   ON CHOOSE OF BUTTON-cli-2 IN FRAME F-Main
     1091   DO:
     1092     run ref/cli-all.w ( my-handle, "b-sel", 'объект':U, 'все':U, 'текущие':U, ?, ",,,,,,NO,,":u, "without-obj":U, output cli-list ) .
     1093     if cli-list <> "" then do:
     1094       find first buf_clients no-lock where RECID(buf_clients) = int (cli-list) no-error.
     1095       assign cli-type-2 = buf_clients.obj-type  cli-code-2 = buf_clients.obj-code  cli-name-2 = buf_clients.obj-name .
     1096     end.
     1097     else assign cli-name-2 = ""   cli-code-2 = ?  .
     1098     display cli-name-2    cli-code-2   with frame F-Main.
     1099   END.
     1100   ON VALUE-CHANGED OF Classify IN FRAME F-Main
     1101   DO:
     1102     Assign Classify.
     1103     if Classify = "grp-goods":U  Then do:
     1104       display TOG-lavel   with frame F-Main .
     1105       enable  TOG-lavel   with frame F-Main .
     1106     end.
     1107     Else do:
     1108       assign TOG-lavel = no .
     1109       display  TOG-lavel  var-Lavel with frame F-Main .
     1110       disable  TOG-lavel  var-Lavel with frame F-Main .
     1111     end.
     1112     if Classify = "post":U Then do:
     1113       display TOG-lavel-2   with frame F-Main .
     1114       enable  TOG-lavel-2   with frame F-Main .
     1115     end.
     1116     Else do:
     1117       assign TOG-lavel-2 = no .
     1118       display  TOG-lavel-2  var-Lavel-2 with frame F-Main .
     1119       disable  TOG-lavel-2  var-Lavel-2 with frame F-Main .
     1120     end.
     1121   END.
     1122   ON LEAVE OF cli-code IN FRAME F-Main
     1123   DO:
     1124     if cli-code = int ( cli-code:screen-value ) then return.
     1125     assign cli-code.
     1126     find first buf_clients no-lock where buf_clients.obj-type = cli-type and buf_clients.obj-code = cli-code no-error.
     1127     if not available buf_clients then apply "CHOOSE" to BUTTON-cli IN FRAME F-Main .
     1128     else do:
     1129       assign cli-name = buf_clients.obj-name   cli-code = buf_clients.obj-code .
     1130       display cli-name  cli-code  with frame F-Main.
     1131     end.
     1132   END.
     1133   ON RETURN OF cli-code IN FRAME F-Main
     1134   DO:
     1135     if cli-code = int ( cli-code:screen-value ) then return.
     1136     assign cli-code.
     1137     find first buf_clients no-lock where buf_clients.obj-type = cli-type and buf_clients.obj-code = cli-code no-error.
     1138     if not available buf_clients then apply "CHOOSE" to BUTTON-cli IN FRAME F-Main .
     1139     else do:
     1140       assign cli-name = buf_clients.obj-name   cli-code = buf_clients.obj-code .
     1141       display cli-name  cli-code  with frame F-Main.
     1142     end.
     1143   END.
     1144   ON LEAVE OF cli-code-2 IN FRAME F-Main
     1145   DO:
     1146     if cli-code-2 = int ( cli-code-2:screen-value ) then return.
     1147     assign cli-code-2.
     1148     find first buf_clients no-lock where buf_clients.obj-type = cli-type-2 and buf_clients.obj-code = cli-code-2 no-error.
     1149     if not available buf_clients then apply "CHOOSE" to BUTTON-cli-2 IN FRAME F-Main .
     1150     else do:
     1151       assign cli-name-2 = buf_clients.obj-name   cli-code-2 = buf_clients.obj-code .
     1152       display cli-name-2  cli-code-2  with frame F-Main.
     1153     end.
     1154   END.
     1155   ON RETURN OF cli-code-2 IN FRAME F-Main
     1156   DO:
     1157     if cli-code-2 = int ( cli-code-2:screen-value ) then return.
     1158     assign cli-code-2.
     1159     find first buf_clients no-lock where buf_clients.obj-type = cli-type-2 and buf_clients.obj-code = cli-code-2 no-error.
     1160     if not available buf_clients then apply "CHOOSE" to BUTTON-cli-2 IN FRAME F-Main .
     1161     else do:
     1162       assign cli-name-2 = buf_clients.obj-name   cli-code-2 = buf_clients.obj-code .
     1163       display cli-name-2  cli-code-2  with frame F-Main.
     1164     end.
     1165   END.
     1166   ON VALUE-CHANGED OF cli-type IN FRAME F-Main
     1167   DO:
     1168     assign cli-type .
     1169     if cli-code <> 0 and cli-code <> ? then do:
     1170       find first buf_clients no-lock where buf_clients.obj-type = cli-type and buf_clients.obj-code = cli-code no-error.
     1171       if not available buf_clients then assign cli-name = ""                     cli-code = ? .
     1172       else                              assign cli-name = buf_clients.obj-name   cli-code = buf_clients.obj-code .
     1173     end.
     1174     display cli-name  cli-code  with frame F-Main.
     1175   END.
     1176   ON VALUE-CHANGED OF cli-type-2 IN FRAME F-Main
     1177   DO:
     1178     assign cli-type-2 .
     1179     if cli-code-2 <> 0 and cli-code-2 <> ? then do:
     1180       find first buf_clients no-lock where buf_clients.obj-type = cli-type-2 and buf_clients.obj-code = cli-code-2 no-error.
     1181       if not available buf_clients then assign cli-name-2 = ""                     cli-code-2 = ? .
     1182       else                              assign cli-name-2 = buf_clients.obj-name   cli-code-2 = buf_clients.obj-code .
     1183     end.
     1184     display cli-name-2  cli-code-2  with frame F-Main.
     1185   END.
     1186   ON VALUE-CHANGED OF Rad-Inter IN FRAME F-Main
     1187   DO:
     1188      Assign Rad-Inter.
     1189      if Rad-Inter = 1 Then do:
     1190        enable   FILL-date1  FILL-date2   with frame F-Main .
     1191        disable  FILL-date   FILL-time    with frame F-Main .
     1192      end.
     1193      Else do:
     1194        disable  FILL-date1  FILL-date2   with frame F-Main .
     1195        enable   FILL-date   FILL-time    with frame F-Main .
     1196      end.
     1197      display  FILL-date  FILL-date1  FILL-date2  FILL-time  with frame F-Main .
     1198   END.
     1199   ON VALUE-CHANGED OF ShowGoods IN FRAME F-Main
     1200   DO:
     1201     assign ShowGoods .
     1202     if ShowGoods = yes then do:
     1203       enable   Rad-Goods SortType with frame F-Main .
     1204     end.
     1205     else do:
     1206       disable   Rad-Goods SortType with frame F-Main .
     1207     end.
     1208   END.
     1209   ON VALUE-CHANGED OF Tog-lavel IN FRAME F-Main
     1210   DO:
     1211     Assign tog-lavel.
     1212     if tog-lavel =TRUE Then do:
     1213       display  var-Lavel  with frame F-Main .
     1214       enable   var-Lavel  with frame F-Main .
     1215     end.
     1216     Else do:
     1217       display    var-Lavel with frame F-Main .
     1218       disable    var-Lavel with frame F-Main .
     1219     end.
     1220   END.
     1221   ON VALUE-CHANGED OF Tog-lavel-2 IN FRAME F-Main
     1222   DO:
     1223      Assign tog-lavel-2.
     1224      if tog-lavel-2 = TRUE Then do:
     1225        display  var-Lavel-2  with frame F-Main .
     1226        enable   var-Lavel-2  with frame F-Main .
     1227      end.
     1228      Else do:
     1229        display    var-Lavel-2 with frame F-Main .
     1230        disable    var-Lavel-2 with frame F-Main .
     1231      end.
     1232   END.
     1233   if not this-procedure :persistent
     1234   then do:
     1235     message
     1236       vss-workfile vss-revision vss-description skip
     1237       "Ошибка при запуске процедуры" skip
     1238       "Данную процедуру следует запускать только с параметром persistent" skip
     1239       view-as alert-box error .
     1240     undo, return error .
     1241   end.
     1242   PROCEDURE disable_UI :
     1243     HIDE FRAME F-Main.
     1244     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1245   END PROCEDURE.
     1246   PROCEDURE local-initialize :
     1247     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1248       var-lavel:screen-value in frame F-Main = '1'.
     1249       var-lavel-2:screen-value in frame F-Main = '1'.
     1250       cli-type:list-items     = 'скл':U + "," + 'маг':U .
     1251       cli-type:screen-value   = 'маг':U .
     1252       cli-type-2:list-items   = 'скл':U + "," + 'маг':U .
     1253       cli-type-2:screen-value = 'скл':U .
     1254       assign cli-type cli-type-2 .
     1255       apply "VALUE-CHANGED" to ShowGoods IN FRAME F-Main .
     1256       apply "VALUE-CHANGED" to Rad-Inter IN FRAME F-Main .
     1257   END PROCEDURE.
     1258   PROCEDURE my-report :
     1259     if Rad-Inter = 1 then do:
     1260       if FILL-date1 = ? THEN DO:
     1261         message "Не задана дата начала интервала!" view-as alert-box ERROR.
     1262         return.
     1263       end.
     1264       if FILL-date2 = ? THEN DO:
     1265         message "Не задана дата окончания интервала!" view-as alert-box ERROR.
     1266         return.
     1267       end.
     1268       if FILL-date1 > FILL-date2 THEN DO:
     1269         message "Дата начала интервала больше даты окончания!" view-as alert-box ERROR.
     1270         return.
     1271       end.
     1272     end.
     1273     else do:
     1274       if FILL-date = ? THEN DO:
     1275         message "Не задана дата отчета!" view-as alert-box ERROR.
     1276         return.
     1277       end.
     1278       if FILL-time > 23 then do:
     1279         message "Время отчета должно быть от 0 до 23 часов!" view-as alert-box ERROR.
     1280         return.
     1281       end.
     1282       assign
     1283         FILL-date1 = FILL-date
     1284         FILL-date2 = FILL-date
     1285       .
     1286     end.
     1287     if cli-code = ? or cli-code = 0 then do:
     1288       message "Не задан 1 объект для отчета!" view-as alert-box ERROR.
     1289       return.
     1290     end.
     1291     if cli-code-2 = ? or cli-code-2 = 0 then do:
     1292       message "Не задан 2 объект для отчета!" view-as alert-box ERROR.
     1293       return.
     1294     end.
     1295      run rep/r-mattov.p  (
     1296                     input Rad-Inter   ,
     1297                     input FILL-date1  ,
     1298                     input FILL-date2  ,
     1299                     input FILL-time   ,
     1300                     input cli-code    ,
     1301                     input cli-type    ,
     1302                     input cli-code-2  ,
     1303                     input cli-type-2  ,
     1304                     input ShowGoods   ,
     1305                     input Rad-Goods   ,
     1306                     input Classify    ,
     1307                     input SortType    ,
     1308                     input tog-lavel   ,
     1309                     input var-lavel   ,
     1310                     input tog-lavel-2 ,
     1311                     input var-lavel-2) .
     1312   END PROCEDURE.
     1313   PROCEDURE my-var :
     1314   assign frame F-Main  Classify SortType  Tog-lavel  var-lavel Tog-lavel-2  Var-lavel-2
     1315                               Rad-Inter FILL-date1 FILL-date2 FILL-date FILL-time cli-code cli-type
     1316                               cli-code-2 cli-type-2 ShowGoods Rad-Goods  .
     1317   def var t-class as char no-undo.
     1318   def var t-sort as char no-undo.
     1319     case classify:
     1320       when "no-classify":u    then t-class =   "Без классификации" .
     1321       when "prod":u           then t-class =   "Производители"   .
     1322       when "post":u           then t-class =   "Поставщики"   .
     1323       when "grp-goods":u      then t-class =   "Группы товаров"  .
     1324       when "post/grp-goods":u then t-class =   "Поставщики/Группы товаров" .
     1325       when "prod/grp-goods":u then t-class =   "Производители/Группы товаров" .
     1326       when "grp-goods/prod":u then t-class =   "Группы товаров/Производители" .
     1327       when "grp-goods/post":u then t-class =   "Группы товаров/Поставщики" .
     1328       when  "vat-ps":u        then t-class =   "Ставка НДС" .
     1329       when  "sort":u          then t-class =   "Проба(Сорт)" .
     1330       when  "n-level":u       then t-class =   "Группы с уровнем вложенности " .
     1331       when  "t-level":u       then t-class =   "Терминальные группы" .
     1332    end case.
     1333     case sorttype:
     1334       when "sort-pp":u               then t-sort =   "по порядку" .
     1335       when "sort-code":u             then t-sort =   "по коду" .
     1336       when "sort-artic":u            then t-sort =   "по артикулу"  .
     1337       when "sort-qunty":u            then t-sort =   "по реализации".
     1338       when "sort-name":u             then t-sort =   "по наименованию".
     1339       when "sort-type":u             then t-sort =   "по типу ткани".
     1340       when "sort-doc-code":u         then t-sort =   "по номеру документа".
     1341       when "sort-recipe-code":u      then t-sort =   "по номеру рецепта".
     1342    end case.
     1343   if Classify = "time":U THEN t-class =   "Временные интервалы" .
     1344   if Classify = "time/grp-goods":U THEN t-class =   "Временные интервалы/Группы товаров" .
     1345   ReportNAme = "Представленность матрицы товаров на объекте" .
     1346   if Rad-Inter = 1 then ReportNAme = ReportNAme + " c " + string(FILL-date1,"99/99/99") + " по " + string(FILL-date2,"99/99/99") .
     1347   else                  ReportNAme = ReportNAme + " на " + string(FILL-time,"99") + " ч. " + string(FILL-date,"99/99/99") .
     1348   ReportHeader = "Классификация : " + t-Class .
     1349   ReportHeader = ReportHeader + (if tog-lavel  then "    Итоги с уровня товаров "  + String(var-lavel)  else " "    ).
     1350   ReportHeader = ReportHeader + (if tog-lavel-2  then "    Итоги с уровня поставщиков "  + String(var-lavel-2)  else " "    ).
     1351    assign
     1352      str1 = cli-name
     1353      str2 = cli-name-2
     1354    .
     1355   END PROCEDURE.
     1356   PROCEDURE state-changed :
     1357     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1358     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1359     CASE p-state:
     1360     END CASE.
     1361   END PROCEDURE.
