     2383   procedure clcprtsl_calc-ttable :
     2384   define input parameter paris-doc           as   logical                 no-undo.
     2385   define input parameter paris-cur           as   logical                 no-undo.
     2386   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     2387   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     2388   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     2389   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     2390   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     2391   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     2392   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     2393   define input parameter parr-b              as   character               no-undo.
     2394   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     2395   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     2396   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     2397   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     2398   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     2399   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     2400   define buffer bf_tt-allsum      for tt-allsum.
     2401   define buffer bf_tt-clcparts    for tt-clcparts.
     2402   define buffer bf_tt-allsum-line for tt-allsum-line.
     2403   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     2404   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     2405   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     2406   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     2407   define variable varexcise          like ub.price-list.excise     no-undo.
     2408   do on error undo, return error return-value :
     2409   for each bf_tt-allsum-line
     2410   on error undo, return error return-value
     2411    :
     2412     delete bf_tt-allsum-line.
     2413   end.
     2414   for each bf_tt-allsum
     2415   on error undo, return error return-value
     2416   :
     2417     delete bf_tt-allsum.
     2418   end.
     2419   for each bf_tt-clcparts
     2420   on error undo, return error return-value
     2421   :
     2422   if v-calcbypart then do:
     2423             assign
     2424             parcur-base =   bf_tt-clcparts.part-cur-base
     2425             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     2426             parcur-excise =   bf_tt-clcparts.part-cur-excise
     2427             .
     2428   end.
     2429      run clcprtsl_calc-parts in this-procedure (
     2430        input recid(bf_tt-clcparts),
     2431        input paris-doc,
     2432        input paris-cur,
     2433        input parroad-tax,
     2434        input parexcise,
     2435        input parvat-pc,
     2436        input parcons-vat-pc,
     2437        input parslt-pc,
     2438        input parbase-rate,
     2439        input parbase-scale,
     2440        input parr-b,
