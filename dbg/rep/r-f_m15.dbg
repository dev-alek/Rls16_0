     2244     (input  bf_trn-doc.obj-type
     2245     ,input  bf_trn-doc.obj-code
     2246     ,input  varb-code
     2247     ,input  0
     2248     ,input  bf_trn-doc.fact-order
     2249     ,output vardoc-num
     2250     ,output varprice-sale
     2251     ,output varroad-tax
     2252     ,output varexcise
     2253     )  .
     2254             if varprice-sale = ?
     2255             then do:
     2256               assign
     2257                 varprice-sale = 0
     2258                 varroad-tax   = 0
     2259                 varexcise     = 0
     2260               .
     2261             end.
     2262             assign
     2263               varlastcur-base     = varprice-sale
     2264               varlastcur-road-tax = varroad-tax
     2265               varlastcur-excise   = varexcise
     2266               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     2267               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     2268               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     2269               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     2270             .
     2271         end.
     2272       end.
     2273       if varcur-fact-qnty = 0 then do:
     2274         assign
     2275           varcur-base      = varlastcur-base
     2276           varcur-road-tax  = varlastcur-road-tax
     2277           varcur-excise    = varlastcur-excise
     2278         .
     2279       end.
     2280       else do:
     2281         assign
     2282           varcur-base      = varcur-base      / varcur-fact-qnty
     2283           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     2284           varcur-excise    = varcur-excise    / varcur-fact-qnty
     2285         .
     2286       end.
