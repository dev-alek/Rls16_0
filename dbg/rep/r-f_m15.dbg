     1908       bfsacc_tt-allsum.vat-rubl-cur        = 0
     1909       bfsacc_tt-allsum.vat-base-buyer-cur  = bfs_tt-allsum.vat-base-acc
     1910       bfsacc_tt-allsum.vat-rubl-buyer-cur  = bfs_tt-allsum.vat-rubl-acc
     1911       bfsacc_tt-allsum.slt-base-cur        = bfs_tt-allsum.slt-base-acc
     1912       bfsacc_tt-allsum.slt-rubl-cur        = bfs_tt-allsum.slt-rubl-acc
     1913       bfsacc_tt-allsum.road-tax-base-cur   = bfs_tt-allsum.road-tax-base-acc
     1914       bfsacc_tt-allsum.road-tax-rubl-cur   = bfs_tt-allsum.road-tax-rubl-acc
     1915       bfsacc_tt-allsum.excise-base-cur     = bfs_tt-allsum.excise-base-acc
     1916       bfsacc_tt-allsum.excise-rubl-cur     = bfs_tt-allsum.excise-rubl-acc
     1917       bfsacc_tt-allsum.sum-dsc-base-acc    = bfs_tt-allsum.sum-dsc-base-acc
     1918       bfsacc_tt-allsum.sum-dsc-rubl-acc    = bfs_tt-allsum.sum-dsc-rubl-acc
     1919       bfsacc_tt-allsum.sum-dsc-cli-acc     = bfs_tt-allsum.sum-dsc-cli-acc
     1920       bfsacc_tt-allsum.dsc-base-acc        = bfs_tt-allsum.dsc-base-acc
     1921       bfsacc_tt-allsum.dsc-rubl-acc        = bfs_tt-allsum.dsc-rubl-acc
     1922       bfsacc_tt-allsum.dsc-cli-acc         = bfs_tt-allsum.dsc-cli-acc
     1923       bfsacc_tt-allsum.vat-base-acc        = bfs_tt-allsum.vat-base-acc
     1924       bfsacc_tt-allsum.vat-rubl-acc        = bfs_tt-allsum.vat-rubl-acc
     1925       bfsacc_tt-allsum.vat-cli-acc         = bfs_tt-allsum.vat-cli-acc
     1926       bfsacc_tt-allsum.slt-base-acc        = bfs_tt-allsum.slt-base-acc
     1927       bfsacc_tt-allsum.slt-rubl-acc        = bfs_tt-allsum.slt-rubl-acc
     1928       bfsacc_tt-allsum.slt-cli-acc         = bfs_tt-allsum.slt-cli-acc
     1929       bfsacc_tt-allsum.excise-base-acc     = bfs_tt-allsum.excise-base-acc
     1930       bfsacc_tt-allsum.excise-rubl-acc     = bfs_tt-allsum.excise-rubl-acc
     1931       bfsacc_tt-allsum.excise-cli-acc      = bfs_tt-allsum.excise-cli-acc
     1932       bfsacc_tt-allsum.road-tax-base-acc   = bfs_tt-allsum.road-tax-base-acc
     1933       bfsacc_tt-allsum.road-tax-rubl-acc   = bfs_tt-allsum.road-tax-rubl-acc
     1934       bfsacc_tt-allsum.road-tax-cli-acc    = bfs_tt-allsum.road-tax-cli-acc
     1935       bfsacc_tt-allsum.transport-base-acc  = bfs_tt-allsum.transport-base-acc
     1936       bfsacc_tt-allsum.transport-rubl-acc  = bfs_tt-allsum.transport-rubl-acc
     1937       bfsacc_tt-allsum.transport-cli-acc   = bfs_tt-allsum.transport-cli-acc
     1938       bfsacc_tt-allsum.other-base-acc      = bfs_tt-allsum.other-base-acc
     1939       bfsacc_tt-allsum.other-rubl-acc      = bfs_tt-allsum.other-rubl-acc
     1940       bfsacc_tt-allsum.other-cli-acc       = bfs_tt-allsum.other-cli-acc
     1941       .
     1942   end.
     1943   otherwise do:
     1944     return error substitute ("Неизвестный тип приобретения &1 по партии с кодом &2 по документу &3, порожденную документом &4 по товару &5 &6 &7.",
     1945                              cl_tt-clcparts.purch-code,
     1946                              cl_tt-clcparts.part-code,
     1947                              cl_tt-clcparts.out-code,
     1948                              cl_tt-clcparts.in-code,
     1949                              cl_tt-clcparts.artic,
     1950                              cl_tt-clcparts.prod-type,
     1951                              cl_tt-clcparts.prod-code).
     1952   end.
     1953   end case.
     1954   end.
     1955   end procedure.
     1956   procedure clcprtsl_calc-line :
     1957   define input  parameter parrec-line as recid no-undo.
     1958   define variable v-tax-date         as   date                     no-undo.
     1959   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     1960   define variable varr-b             as   character                no-undo.
     1961   define variable varr-btype         as   character                no-undo.
     1962   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     1963   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     1964   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     1965   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     1966   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     1967   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     1968   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     1969   define variable varb-code          like ub.bar-code.b-code       no-undo.
     1970   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     1971   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     1972   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     1973   define variable varexcise          like ub.price-list.excise     no-undo.
     1974   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     1975   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     1976   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     1977   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     1978   define variable v-varsum           as decimal                  no-undo.
     1979   define variable varprice-salef as decimal   no-undo .
     1980   define buffer bf_trn-doc             for ub.trn-doc.
     1981   define buffer bf_doc-line            for ub.doc-line.
     1982   define buffer bf_gds-dtl             for ub.gds-dtl.
     1983   define buffer bf_goods               for ub.goods.
     1984   define buffer bf_parts               for ub.parts.
     1985   define buffer bf_sysconf             for ub.sysconf.
     1986   define buffer bf_tt-allsum-line      for tt-allsum-line.
     1987   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     1988   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     1989   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     1990   define buffer buf_parts        for ub.parts.
     1991   v-calcbypart = no.
     1992   do on error undo, return error return-value :
     1993   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1994   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1995     (output varr-b
     1996     )  .
     1997     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     1998     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     1999     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     2000                               bf_goods.prod-type = bf_doc-line.prod-type and
     2001                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     2002     if bf_trn-doc.fact-date <> ?        then do:
     2003       assign v-tax-date = bf_trn-doc.fact-date.
     2004     end.
     2005     else do:
     2006       assign v-tax-date = ?.
     2007     end.
     2008   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2009   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2010     (input  bf_goods.gds-code
     2011     ,input  '1':U
     2012     ,input  v-tax-date
     2013     ,input  bf_trn-doc.host-code
     2014     ,input  bf_trn-doc.obj-type
     2015     ,input  bf_trn-doc.obj-code
     2016     ,output v-vat-pc
     2017     ) no-error .
     2018     if error-status :error
     2019     or v-vat-pc = ? then do:
     2020        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     2021     end.
     2022     if bf_goods.gds-type = 'у':U or
     2023        bf_trn-doc.status_ = 'запрос':U then do:
     2024       for each bf_tt-allsum-line
     2025       on error undo, return error return-value
     2026        :
     2027         delete bf_tt-allsum-line.
     2028       end.
     2029       create bf_tt-allsum-line.
     2030       assign
     2031        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     2032       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     2033                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     2034                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     2035                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     2036         assign
     2037           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     2038           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     2039           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     2040           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     2041           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     2042           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     2043           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     2044           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     2045           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     2046           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     2047           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     2048           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     2049           bf_tt-allsum-line.vat-cli-acc          =  ?
     2050           .
     2051       end.
     2052       assign
     2053         bf_tt-allsum-line.cli-qnty             =  ?
     2054         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2055         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2056         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2057         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2058         bf_tt-allsum-line.road-tax-base-doc    =  0
     2059         bf_tt-allsum-line.road-tax-rubl-doc    =  0
     2060         bf_tt-allsum-line.excise-base-doc      =  0
     2061         bf_tt-allsum-line.excise-rubl-doc      =  0
     2062         bf_tt-allsum-line.vat-base-doc         =  bf_tt-allsum-line.vat-base-buyer-doc
     2063         bf_tt-allsum-line.vat-rubl-doc         =  bf_tt-allsum-line.vat-rubl-buyer-doc
     2064         bf_tt-allsum-line.dsc-base-cur         =  0
     2065         bf_tt-allsum-line.dsc-rubl-cur         =  0
     2066         bf_tt-allsum-line.slt-base-cur         =  bf_tt-allsum-line.sum-dsc-base-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2067         bf_tt-allsum-line.slt-rubl-cur         =  bf_tt-allsum-line.sum-dsc-rubl-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2068         bf_tt-allsum-line.vat-base-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-base-cur - bf_tt-allsum-line.slt-base-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2069         bf_tt-allsum-line.vat-rubl-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-rubl-cur - bf_tt-allsum-line.slt-rubl-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2070         bf_tt-allsum-line.road-tax-base-cur    =  0
     2071         bf_tt-allsum-line.road-tax-rubl-cur    =  0
     2072         bf_tt-allsum-line.excise-base-cur      =  0
     2073         bf_tt-allsum-line.excise-rubl-cur      =  0
     2074         bf_tt-allsum-line.vat-base-cur         =  bf_tt-allsum-line.vat-base-buyer-cur
     2075         bf_tt-allsum-line.vat-rubl-cur         =  bf_tt-allsum-line.vat-rubl-buyer-cur
     2076         bf_tt-allsum-line.dsc-base-acc         =  0
     2077         bf_tt-allsum-line.dsc-rubl-acc         =  0
     2078         bf_tt-allsum-line.dsc-cli-acc          =  0
     2079         bf_tt-allsum-line.slt-base-acc         =  0
     2080         bf_tt-allsum-line.slt-rubl-acc         =  0
     2081         bf_tt-allsum-line.slt-cli-acc          =  0
     2082         bf_tt-allsum-line.road-tax-base-acc    =  0
     2083         bf_tt-allsum-line.road-tax-rubl-acc    =  0
     2084         bf_tt-allsum-line.road-tax-cli-acc     =  0
     2085         bf_tt-allsum-line.excise-base-acc      =  0
     2086         bf_tt-allsum-line.excise-rubl-acc      =  0
     2087         bf_tt-allsum-line.excise-cli-acc       =  0
     2088         bf_tt-allsum-line.transport-base-acc   =  0
     2089         bf_tt-allsum-line.transport-rubl-acc   =  0
     2090         bf_tt-allsum-line.transport-cli-acc    =  0
     2091         bf_tt-allsum-line.other-base-acc       =  0
     2092         bf_tt-allsum-line.other-rubl-acc       =  0
     2093         bf_tt-allsum-line.other-cli-acc        =  0
     2094         .
     2095       create bfs_tt-allsum-line.
     2096       assign
     2097       bfs_tt-allsum-line.sum-type = 'основная_сумма_со_знаком':U.
     2098       if bf_trn-doc.doc-type = 'инв':U or
     2099          bf_trn-doc.doc-type = 'при':U    or
     2100          bf_trn-doc.doc-type = 'возврат':U    then do:
     2101          buffer-copy bf_tt-allsum-line except bf_tt-allsum-line.sum-type to bfs_tt-allsum-line.
     2102       end.
     2103       else do:
     2104         assign
     2105           bfs_tt-allsum-line.fact-qnty           =  - bf_tt-allsum-line.fact-qnty
     2106           bfs_tt-allsum-line.cli-qnty            =  - bf_tt-allsum-line.cli-qnty
     2107           bfs_tt-allsum-line.sum-dsc-base-doc    =  - bf_tt-allsum-line.sum-dsc-base-doc
     2108           bfs_tt-allsum-line.sum-dsc-rubl-doc    =  - bf_tt-allsum-line.sum-dsc-rubl-doc
     2109           bfs_tt-allsum-line.dsc-base-doc        =  - bf_tt-allsum-line.dsc-base-doc
     2110           bfs_tt-allsum-line.dsc-rubl-doc        =  - bf_tt-allsum-line.dsc-rubl-doc
     2111           bfs_tt-allsum-line.vat-base-doc        =  - bf_tt-allsum-line.vat-base-doc
     2112           bfs_tt-allsum-line.vat-rubl-doc        =  - bf_tt-allsum-line.vat-rubl-doc
     2113           bfs_tt-allsum-line.vat-base-buyer-doc  =  - bf_tt-allsum-line.vat-base-buyer-doc
     2114           bfs_tt-allsum-line.vat-rubl-buyer-doc  =  - bf_tt-allsum-line.vat-rubl-buyer-doc
     2115           bfs_tt-allsum-line.slt-base-doc        =  - bf_tt-allsum-line.slt-base-doc
     2116           bfs_tt-allsum-line.slt-rubl-doc        =  - bf_tt-allsum-line.slt-rubl-doc
     2117           bfs_tt-allsum-line.road-tax-base-doc   =  - bf_tt-allsum-line.road-tax-base-doc
     2118           bfs_tt-allsum-line.road-tax-rubl-doc   =  - bf_tt-allsum-line.road-tax-rubl-doc
     2119           bfs_tt-allsum-line.excise-base-doc     =  - bf_tt-allsum-line.excise-base-doc
     2120           bfs_tt-allsum-line.excise-rubl-doc     =  - bf_tt-allsum-line.excise-rubl-doc
     2121           bfs_tt-allsum-line.sum-dsc-base-cur    =  - bf_tt-allsum-line.sum-dsc-base-cur
     2122           bfs_tt-allsum-line.sum-dsc-rubl-cur    =  - bf_tt-allsum-line.sum-dsc-rubl-cur
     2123           bfs_tt-allsum-line.dsc-base-cur        =  - bf_tt-allsum-line.dsc-base-cur
     2124           bfs_tt-allsum-line.dsc-rubl-cur        =  - bf_tt-allsum-line.dsc-rubl-cur
     2125           bfs_tt-allsum-line.vat-base-cur        =  - bf_tt-allsum-line.vat-base-cur
     2126           bfs_tt-allsum-line.vat-rubl-cur        =  - bf_tt-allsum-line.vat-rubl-cur
     2127           bfs_tt-allsum-line.vat-base-buyer-cur  =  - bf_tt-allsum-line.vat-base-buyer-cur
     2128           bfs_tt-allsum-line.vat-rubl-buyer-cur  =  - bf_tt-allsum-line.vat-rubl-buyer-cur
     2129           bfs_tt-allsum-line.slt-base-cur        =  - bf_tt-allsum-line.slt-base-cur
     2130           bfs_tt-allsum-line.slt-rubl-cur        =  - bf_tt-allsum-line.slt-rubl-cur
     2131           bfs_tt-allsum-line.road-tax-base-cur   =  - bf_tt-allsum-line.road-tax-base-cur
     2132           bfs_tt-allsum-line.road-tax-rubl-cur   =  - bf_tt-allsum-line.road-tax-rubl-cur
     2133           bfs_tt-allsum-line.excise-base-cur     =  - bf_tt-allsum-line.excise-base-cur
     2134           bfs_tt-allsum-line.excise-rubl-cur     =  - bf_tt-allsum-line.excise-rubl-cur
     2135           bfs_tt-allsum-line.sum-dsc-base-acc    =  - bf_tt-allsum-line.sum-dsc-base-acc
     2136           bfs_tt-allsum-line.sum-dsc-rubl-acc    =  - bf_tt-allsum-line.sum-dsc-rubl-acc
     2137           bfs_tt-allsum-line.sum-dsc-cli-acc     =  - bf_tt-allsum-line.sum-dsc-cli-acc
     2138           bfs_tt-allsum-line.dsc-base-acc        =  - bf_tt-allsum-line.dsc-base-acc
     2139           bfs_tt-allsum-line.dsc-rubl-acc        =  - bf_tt-allsum-line.dsc-rubl-acc
     2140           bfs_tt-allsum-line.dsc-cli-acc         =  - bf_tt-allsum-line.dsc-cli-acc
     2141           bfs_tt-allsum-line.vat-base-acc        =  - bf_tt-allsum-line.vat-base-acc
     2142           bfs_tt-allsum-line.vat-rubl-acc        =  - bf_tt-allsum-line.vat-rubl-acc
     2143           bfs_tt-allsum-line.vat-cli-acc         =  - bf_tt-allsum-line.vat-cli-acc
     2144           bfs_tt-allsum-line.slt-base-acc        =  - bf_tt-allsum-line.slt-base-acc
     2145           bfs_tt-allsum-line.slt-rubl-acc        =  - bf_tt-allsum-line.slt-rubl-acc
     2146           bfs_tt-allsum-line.slt-cli-acc         =  - bf_tt-allsum-line.slt-cli-acc
     2147           bfs_tt-allsum-line.road-tax-base-acc   =  - bf_tt-allsum-line.road-tax-base-acc
