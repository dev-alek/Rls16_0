     1661     end.
     1662     else do:
     1663       for each G#CUSTOMER :
     1664         find first buf_clients no-lock where buf_clients.obj-type = G#CUSTOMER.obj-type and buf_clients.obj-code = G#CUSTOMER.obj-code .
     1665         for each buf_contract no-lock
     1666           where buf_contract.host-code = v-cntxt-host-code-obj
     1667             and buf_contract.cli-type  = G#CUSTOMER.obj-type
     1668             and buf_contract.cli-code  = G#CUSTOMER.obj-code
     1669           :
     1670   define variable vss-include-info17 as character format "X(65)" no-undo
     1671   initial "@(#)$Workfile$ $Revision$".
