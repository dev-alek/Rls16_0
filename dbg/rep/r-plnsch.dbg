     1836   procedure prn-line :
     1837     do on error undo, return error return-value :
     1838       run is-page in this-procedure .
     1839       if temp-contr.day > 0 then
     1840         put stream PrnLibStream
     1841           "|"  At 1   temp-contr.dat  Format "99/99/9999"
     1842           "|"  At 12   temp-contr.num  Format "X(15)"
     1843           "|"  At 29   temp-contr.day  Format ">>>9"
     1844           "|"  At 35   temp-contr.sum  Format "->>>,>>>,>>>,>>>,>>9.99"
     1845           "|"  At 60   "|"  At 85   "|"  At 110
     1846         skip .
     1847       else
     1848         put stream PrnLibStream
     1849           "|"  At 1   temp-contr.dat  Format "99/99/9999"
     1850           "|"  At 12   temp-contr.num  Format "X(15)"
     1851           "|"  At 29
     1852           "|"  At 35   temp-contr.sum  Format "->>>,>>>,>>>,>>>,>>9.99"
