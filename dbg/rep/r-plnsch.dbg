     1010   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1011   procedure cur-time :
     1012      define output parameter p-today as date      no-undo .
     1013      define output parameter p-time  as integer   no-undo .
     1014     do
     1015     on error undo, return error
     1016     :
     1017       define variable v-date1 as date      no-undo .
     1018       define variable v-date2 as date      no-undo .
     1019       define variable v-time  as integer   no-undo .
     1020       assign
     1021         v-date1 = today
     1022         v-time  = time
     1023         v-date2 = today
     1024       .
     1025       if v-date1 <> v-date2
     1026       then do:
     1027         assign
     1028           v-date1 = today
     1029           v-time  = v-time
     1030         .
     1031       end.
     1032       assign
     1033         p-today = v-date1
     1034         p-time  = v-time
     1035       .
     1036     end.
     1037   end.
     1038   function cur-time-date returns character
     1039   :
     1040     return string(today, '99/99/9999':U) .
     1041   end.
     1042   function cur-time-mjd returns decimal
     1043   :
     1044     define variable v-date as date      no-undo .
     1045     define variable v-time as integer   no-undo .
     1046     run cur-time in this-procedure
     1047       (output v-date
     1048       ,output v-time
     1049       ) .
     1050     return integer(v-date) - 2400002 + (v-time / 86400) .
     1051   end.
     1052   function cur-time-get-ending-index returns integer
     1053   (input p-number as integer
     1054   )
     1055   :
     1056     if p-number < 0
     1057     or p-number = ?
     1058     then do:
     1059       return 1 .
     1060     end.
     1061     define variable v-rest as integer   no-undo .
     1062     assign
     1063       p-number = p-number modulo 100
     1064     .
     1065     if p-number < 20
     1066     then do:
     1067       assign
     1068         v-rest = p-number
     1069       .
     1070     end.
     1071     else do:
     1072       assign
     1073         v-rest = p-number modulo 10
     1074       .
     1075     end.
     1076     case v-rest :
     1077       when 1
     1078       then do:
     1079         return 2 .
     1080       end.
     1081       when 2 or
     1082       when 3 or
     1083       when 4
     1084       then do:
     1085         return 3 .
     1086       end.
     1087       otherwise do:
     1088         return 1 .
     1089       end.
     1090     end case .
     1091   end.
     1092   procedure cur-time-mjd-to-date :
     1093      define input  parameter i-mjd-diff as decimal no-undo.
     1094      define output parameter o-Date     as date    no-undo.
     1095      define output parameter o-Time     as integer no-undo.
     1096      define variable v-day-number as integer   no-undo .
     1097      if    i-mjd-diff < 0
     1098         or i-mjd-diff = ?
     1099      then do:
     1100         return "?" .
     1101      end.
     1102      assign
     1103         v-day-number = truncate(i-mjd-diff,0).
     1104         o-Date = date(v-day-number + 2400002).
     1105         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1106     .
     1107   end.
     1108   function cur-time-mjd-to-string returns character
     1109   (input p-mjd-diff as decimal
     1110   )
     1111   :
     1112     define variable v-day-number as integer   no-undo .
     1113     define variable v-seconds    as integer   no-undo .
     1114     define variable v-hour       as integer   no-undo .
     1115     define variable v-min        as integer   no-undo .
     1116     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1117     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1118     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1119     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1120     if p-mjd-diff < 0
     1121     or p-mjd-diff = ?
     1122     then do:
     1123       return "?" .
     1124     end.
     1125     assign
     1126       v-day-number = integer(truncate(p-mjd-diff,0))
     1127       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1128     .
     1129     if v-seconds > 86400
     1130     then do:
     1131       assign
     1132         v-seconds = 86400 - 1
     1133       .
     1134     end.
     1135     if v-seconds < 0
     1136     then do:
     1137       assign
     1138         v-seconds = 0
     1139       .
     1140     end.
     1141     assign
     1142       v-hour = truncate(v-seconds / 3600, 0)
     1143     .
     1144     assign
     1145       v-seconds = v-seconds modulo 3600
     1146     .
     1147     assign
     1148       v-min = truncate(v-seconds / 60, 0)
     1149     .
     1150     assign
     1151       v-seconds = v-seconds modulo 60
     1152     .
     1153     return
     1154         (if v-day-number <> 0
     1155           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1156           else ""
     1157         )
     1158       + (if v-day-number <> 0 or v-hour <> 0
     1159           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1160           else ""
     1161         )
     1162       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1163           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1164           else ""
     1165         )
     1166       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1167       .
     1168   end.
     1169   function cur-time-string returns character
     1170   :
     1171     define variable v-date as date      no-undo .
     1172     define variable v-time as integer   no-undo .
     1173     run cur-time in this-procedure
     1174       (output v-date
     1175       ,output v-time
     1176       ) .
     1177     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1178   end.
     1179   function cur-time-string-sec returns character
     1180   :
     1181     define variable v-date as date      no-undo .
     1182     define variable v-time as integer   no-undo .
     1183     run cur-time in this-procedure
     1184       (output v-date
     1185       ,output v-time
     1186       ) .
     1187     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1188   end.
     1189   function cur-time-custom  returns character
     1190   (input p-prefix as character
     1191   ,input p-date-format as character
     1192   ,input p-delimiter as character
     1193   ,input p-time-format as character
     1194   ,input p-suffix as character
     1195   )
     1196   :
     1197     define variable v-date as date      no-undo .
     1198     define variable v-time as integer   no-undo .
     1199     run cur-time in this-procedure
     1200       (output v-date
     1201       ,output v-time
     1202       ) .
     1203     return
     1204       p-prefix
     1205       + string(v-date, p-date-format)
     1206       + p-delimiter
     1207       + string(v-time, p-time-format)
     1208       + p-suffix
     1209       .
     1210   end.
     1211   function cur-time-print  returns character
     1212   :
     1213     define variable v-date as date      no-undo .
     1214     define variable v-time as integer   no-undo .
     1215     run cur-time in this-procedure
     1216       (output v-date
     1217       ,output v-time
     1218       ) .
     1219     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1220   end.
     1221   function cur-time-datetime returns datetime
     1222   :
     1223     define variable v-char as character no-undo .
     1224     define variable v-datetime as datetime no-undo .
     1225     v-char = cur-time-string().
     1226     v-datetime = datetime(v-char).
     1227     return  v-datetime.
     1228   end.
     1229   function cur-time-string-msec returns character
     1230   :
     1231     define variable v-date as datetime  no-undo .
     1232     v-date = now.
     1233     return string(v-date) .
     1234   end.
