     1863   procedure is-page :
     1864     do
     1865     on error undo, return error return-value
     1866     :
     1867       if line-counter( PrnLibStream ) + 2 > page-size( PrnLibStream ) then do:
     1868         put stream PrnLibStream  skip Line format "X(110)" skip "продолжение - на следующей странице" AT 30 SKIP .
     1869         page stream PrnLibStream .
     1870         run PrintTitul .
     1871       end.
     1872     end.
     1873   end procedure.
     1874   procedure PrintTitul :
     1875     do
     1876     on error undo, return error return-value
     1877     :
     1878       PUT stream PrnLibStream SPACE(10) ReportNAme format "X(100)" SKIP .
     1879       PUT stream PrnLibStream str1 format "X(100)" SKIP .
     1880       put stream PrnLibStream  skip cur-time-print() format "x(35)" string( "Страница" ) AT 45 PAGE-NUMBER( PrnLibStream ) AT 55 FORMAT ">>>>9" SKIP .
     1881       put stream PrnLibStream
     1882         skip  Line format "X(110)"  skip
     1883         "|"           "План. дата"     format "X(10)"
     1884         "|" at 12  " № фин.об."      format "X(10)"
     1885         "|" at 29  "Про-" format "X(4)"
     1886         "|" at 35  " Непогашенная"  format "X(15)"
     1887         "|" at 60  " Сумма "  format "X(15)"
     1888         "|" at 85  " Итого "  format "X(15)"
     1889         "|" at 110
     1890         skip
     1891         "|"           "платежа"     format "X(10)"
     1892         "|" at 12
     1893         "|" at 29  "сроч"        format "X(4)"
     1894         "|" at 35  string(" сумма (" + s-val + ")")    format "X(17)"
     1895         "|" at 60  "несвязанных"                       format "X(15)"
     1896         "|" at 85  string(" к оплате (" + s-val + ")") format "X(17)"
     1897         "|" at 110
     1898         skip
     1899         "|"
     1900         "|" at 12
     1901         "|" at 29  "дней " format "X(4)"
     1902         "|" at 35
     1903         "|" at 60  string("платежей (" + s-val + ")") format "X(17)"
     1904         "|" at 85
     1905         "|" at 110
     1906         skip  Line format "X(110)"  skip
     1907       .
     1908     end.
