     1762   if session :set-wait-state( "compiler" ) then.
     1763     Line = fill("-", 250).
     1764     run prn-lib-open-stream  in this-procedure (input parParentProc,input 62,input yes,input no).
     1765     FORM with FRAME f-doc .
     1766     run PrintTitul in this-procedure .
     1767     if itog-contract then do:
     1768       for each temp-doc break by temp-doc.cli-type by temp-doc.cli-code :
     1769         if first-of(temp-doc.cli-code) then do:
     1770           if itog-comp = no then do:
     1771             PUT STREAM PrnLibStream string("|Контрагент: " + temp-doc.cli-name) format "X(89)" "|" at 110 skip .
     1772             run is-page in this-procedure .
     1773           end.
     1774           assign
     1775             v-sum = 0
     1776             v-sum1 = 0
     1777           .
     1778         end.
     1779         PUT STREAM PrnLibStream string("|Договор: " + temp-doc.contr-name) format "X(89)" "|" at 110  skip .
     1780         run is-page in this-procedure .
     1781         if itog-comp = no then do:
     1782           for each temp-contr where temp-contr.contr = temp-doc.contr :      run prn-line in this-procedure .    end.
     1783         end.
     1784         PUT STREAM PrnLibStream string("|Всего по " + temp-doc.contr-name) format "X(29)" "|" at 35 temp-doc.sum-fo format "->>>,>>>,>>>,>>>,>>9.99"  "|" at 60 temp-doc.sum-pl format "->>>,>>>,>>>,>>>,>>9.99" "|" at 85 (temp-doc.sum-fo - temp-doc.sum-pl)  format "->>>,>>>,>>>,>>>,>>9.99"   "|" at 110 skip  .
     1785         run is-page in this-procedure .
     1786         assign
     1787           v-sum  = v-sum  + temp-doc.sum-fo
     1788           v-sum1 = v-sum1 + temp-doc.sum-pl
     1789         .
     1790         if last-of(temp-doc.cli-code)  then do:
