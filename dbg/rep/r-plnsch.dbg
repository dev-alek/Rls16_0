     1406   procedure prn-lib-reportviewer :
     1407     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1408     define input parameter p-report-name-html as character no-undo .
     1409     define input parameter p-param        as character no-undo .
     1410     define variable v-excel           as character no-undo init 'TRUE' .
     1411     define variable v-value-character as character no-undo .
     1412     define variable v-value-integer   as character no-undo .
     1413     define variable v-value-date      as date      no-undo .
     1414     define variable v-value-decimal   as decimal   no-undo .
     1415     define variable rep-excel         as logical   no-undo .
     1416     define variable excel-string      as character no-undo .
     1417     define variable v-param-type      as character no-undo .
     1418     define variable v-tth             as handle    no-undo .
     1419     run adm/shattri.p (
     1420       input "get":U
     1421       ,input  ""
     1422       ,input  0
     1423       ,input  'report-glob':U
     1424       ,input  'rep-excel':U
     1425       ,output v-value-character
     1426       ,output v-value-date
     1427       ,output v-value-decimal
     1428       ,output v-value-integer
     1429       ,output rep-excel
     1430       ,output v-param-type
     1431       ,INPUT-OUTPUT table-handle v-tth
     1432       )  .
     1433     if rep-excel then v-excel = "TRUE" .
     1434     else v-excel = "FALSE" .
     1435     if p-param eq ""
     1436     then
     1437        p-param = "EXCEL:" + v-excel.
     1438     else
     1439        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1440     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1441   end procedure.
