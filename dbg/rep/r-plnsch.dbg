      569   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      570     (output var-report-r-b
      571     )  .
      572   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      573   procedure factord :
      574     define input  parameter p-fact-date            as date    no-undo .
      575     define input  parameter p-fact-time            as integer no-undo .
      576     define input  parameter p-fact-num             as integer no-undo .
      577     define input  parameter p-shift-date           as date    no-undo .
      578     define input  parameter p-shift-num            as integer no-undo .
      579     define input  parameter p-shift-on             as logical no-undo .
      580     define output parameter p-fact-order           as decimal no-undo .
      581     define output parameter p-shift-end-fact-order as decimal no-undo .
      582     define output parameter p-day-end-fact-order   as decimal no-undo .
      583     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      584     if p-fact-date = ?
      585     then do:
      586       return error "Не указана фактическая дата" .
      587     end.
      588     define variable v-fact-date-num as integer no-undo .
      589     assign
      590       v-fact-date-num = integer(p-fact-date)
      591     .
      592     if p-fact-num = ?
      593     or p-fact-num = 0
      594     then do:
      595       return error "Не задан p-fact-num " + string(p-fact-num) .
      596     end.
      597     if p-fact-num < 0
      598     then do:
      599       return error "Отрицательный fact-num " + string(p-fact-num) .
      600     end.
      601     if p-fact-num >= 100000000
      602     then do:
      603       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      604     end.
      605     if p-shift-on = true
      606     then do:
      607       if p-shift-date = ?
      608       then do:
      609         return error "Не задана дата смены" .
      610       end.
      611       if p-shift-num = ?
      612       or p-shift-num = 0
      613       then do:
      614         return error "Не задан номер смены" .
      615       end.
      616     end.
      617     else do:
      618       assign
      619         p-shift-date = p-fact-date
      620         p-shift-num  = 24
      621       .
      622     end.
      623     define variable v-shift-offset as integer no-undo .
      624     if p-shift-date = p-fact-date
      625     then do:
      626       assign
      627         v-shift-offset = 1
      628       .
      629     end.
      630     if p-shift-date < p-fact-date
      631     then do:
      632       assign
      633         v-shift-offset = 0
      634       .
      635     end.
      636     if p-shift-date > p-fact-date
      637     then do:
      638       message
      639         vss-workfile vss-revision vss-description skip
      640         "Неправильная дата закрытия смены" skip
      641         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      642         view-as alert-box error .
      643       undo, return error
      644         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      645           ,string(p-fact-date, '99/99/9999':U)
      646           ,string(p-shift-date, '99/99/9999':U)
      647           )
      648       .
      649     end.
      650     if p-shift-num < 1
      651     or p-shift-num > 24
      652     then do:
      653       message
      654         vss-workfile vss-revision vss-description skip
      655         "Неправильный номер смены" skip
      656         "p-shift-num" p-shift-num skip
      657         view-as alert-box error .
      658       undo, return error return-value .
      659     end.
      660     assign
      661       p-fact-order           = v-fact-date-num
      662                              + v-shift-offset * 0.5
      663                              + p-shift-num    * 0.02 - 0.01
      664                              + p-fact-num     * 0.0000000001
      665       p-shift-end-fact-order = v-fact-date-num
      666                              + v-shift-offset * 0.5
      667                              + p-shift-num    * 0.02
      668       p-day-end-fact-order   = v-fact-date-num
      669                              + 0.99
      670     .
      671     if p-fact-order           <= v-fact-date-num
      672     or p-shift-end-fact-order <= v-fact-date-num
      673     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      674     or p-shift-end-fact-order >= p-day-end-fact-order
      675     then do:
      676       message
      677         vss-workfile vss-revision vss-description skip
      678         "Внутренняя ошибка при генерации фактического номера" skip
      679         "p-fact-date"            p-fact-date            skip
      680         "p-fact-time"            p-fact-time            skip
      681         "p-fact-num"             p-fact-num             skip
      682         "p-shift-date"           p-shift-date           skip
      683         "p-shift-num"            p-shift-num            skip
      684         "p-shift-on"             p-shift-on             skip
      685         "p-shift-end-fact-order" p-shift-end-fact-order skip
      686         "p-day-end-fact-order"   p-day-end-fact-order   skip
      687         "v-fact-date-num"        v-fact-date-num        skip
      688         view-as alert-box error .
      689       undo, return error return-value .
      690     end.
      691   end procedure.
      692   procedure day-begin-fact-order :
      693     define input  parameter p-fact-date            as date    no-undo .
      694     define output parameter p-day-begin-fact-order as decimal no-undo .
      695     do
      696     on error undo, return error return-value
      697     :
      698       if p-fact-date = ?
      699       then do:
      700         assign
      701           p-day-begin-fact-order = 0
      702         .
      703       end.
      704       else do:
      705         assign
      706           p-day-begin-fact-order = integer(p-fact-date)
      707         .
      708       end.
      709     end.
      710   end procedure.
      711   procedure factord-max-fact-order :
      712     define output parameter p-max-fact-order as decimal   no-undo .
      713     do
      714     on error undo, return error return-value
      715     :
      716       run day-begin-fact-order in this-procedure
      717         (input  date(1, 1, 5000)
      718         ,output p-max-fact-order
      719         ) .
      720     end.
      721   end procedure.
      722   procedure factord-cut-archive :
      723     define input  parameter p-obj-type             as character no-undo .
      724     define input  parameter p-obj-code             as integer   no-undo .
      725     define input  parameter p-fact-date            as date      no-undo .
      726     define output parameter p-shift-on             as logical   no-undo .
      727     define output parameter p-shift-date           as date      no-undo .
      728     define output parameter p-shift-num            as integer   no-undo .
      729     define output parameter p-day-end-fact-order   as decimal   no-undo .
      730     define output parameter p-shift-end-fact-order as decimal   no-undo .
      731     define variable v-fact-order as decimal   no-undo .
      732     define buffer buf_shift-obj for ub.shift-obj .
      733     do
      734     on error undo, return error return-value
      735     :
      736   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      737   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      738     (input  p-obj-type
      739     ,input  p-obj-code
      740     ,input  'shift-on=request'
      741     ,output p-shift-on
      742     ) no-error .
      743       if error-status :error
      744       then do:
      745         message
      746           vss-workfile vss-revision vss-description skip
      747           "Ошибка при определении атрибута объекта" skip
      748           "Объект" p-obj-type p-obj-code skip
      749           error-status :get-message(1) skip
      750           return-value skip
      751           view-as alert-box error .
      752         undo, return error return-value .
      753       end.
      754       if p-shift-on = false
      755       then do:
      756         assign
      757           p-shift-date               = ?
      758           p-shift-num                = 0
      759         .
      760       end.
      761       else do:
      762         find first buf_shift-obj share-lock
      763           where buf_shift-obj.obj-type   = p-obj-type
      764             and buf_shift-obj.obj-code   = p-obj-code
      765             and buf_shift-obj.shift-date > p-fact-date
      766           use-index pi
      767           no-error .
      768         if not available buf_shift-obj
      769         or buf_shift-obj.status_ <> 'зкр':U
      770         then do:
      771           message
      772             vss-workfile vss-revision vss-description skip
      773             "Невозможно вычислить последнюю смену" skip
      774             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      775             "Объект" p-obj-type p-obj-code skip
      776             "Дата" p-fact-date skip
      777             view-as alert-box error .
      778           undo, return error return-value .
      779         end.
      780         find last buf_shift-obj share-lock
      781           where buf_shift-obj.obj-type = p-obj-type
      782             and buf_shift-obj.obj-code = p-obj-code
      783             and buf_shift-obj.shift-date <= p-fact-date
      784           use-index pi
      785           no-error .
      786         if available buf_shift-obj
      787         then do:
      788           if  buf_shift-obj.status_ = 'зкр':U
      789           then do:
      790             assign
      791               p-shift-date = buf_shift-obj.shift-date
      792               p-shift-num  = buf_shift-obj.shift-num
      793             .
      794           end.
      795           else do:
      796             message
      797               vss-workfile vss-revision vss-description skip
      798               "Невозможно вычислить последнюю смену" skip
      799               "Статус смены отличен от статуса" 'зкр':U skip
      800               "Объект" p-obj-type p-obj-code skip
      801               "Дата" p-fact-date skip
      802               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      803               view-as alert-box error .
      804             undo, return error return-value .
      805           end.
      806         end.
      807         else do:
      808           assign
      809             p-shift-date = p-fact-date - 1
      810             p-shift-num  = 1
      811           .
      812         end.
      813       end.
      814       run factord in this-procedure
      815         (input  p-fact-date
      816         ,input  1
      817         ,input  1
      818         ,input  p-shift-date
      819         ,input  p-shift-num
      820         ,input  p-shift-on
      821         ,output v-fact-order
      822         ,output p-shift-end-fact-order
      823         ,output p-day-end-fact-order
      824         ) no-error .
      825       if error-status :error
      826       then do:
      827         message
      828           vss-workfile vss-revision vss-description skip
      829           "Ошибка при вызове процедуры factord"
      830           error-status :get-message(1) skip
      831           return-value skip
      832           view-as alert-box error .
      833         undo, return error return-value .
      834       end.
      835     end.
      836   end procedure.
      837   procedure factord-lock-shift :
      838     define input  parameter p-obj-type  as character no-undo .
      839     define input  parameter p-obj-code  as integer   no-undo .
      840     define input  parameter p-fact-date as date      no-undo .
      841     define parameter buffer buf_shift-obj for ub.shift-obj .
      842     define variable v-shift-on      as logical   no-undo .
      843     define variable v-extra-message as character no-undo .
      844     define variable v-error as character no-undo .
      845     do
      846     on error undo, return error return-value
      847     :
      848   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      849   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      850     (input  p-obj-type
      851     ,input  p-obj-code
      852     ,input  'shift-on=request'
      853     ,output v-shift-on
      854     ) no-error .
      855       if error-status :error
      856       then do:
      857         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      858         undo, return error v-error .
      859       end.
      860       if v-shift-on = true
      861       then do:
      862         find first buf_shift-obj share-lock
      863           where buf_shift-obj.obj-type   = p-obj-type
      864             and buf_shift-obj.obj-code   = p-obj-code
      865             and buf_shift-obj.shift-date > p-fact-date
      866           use-index pi
      867           no-error .
      868         if not available buf_shift-obj
      869         or buf_shift-obj.status_ <> 'зкр':U
      870         then do:
      871           find last buf_shift-obj
      872             where buf_shift-obj.obj-type = p-obj-type
      873               and buf_shift-obj.obj-code = p-obj-code
      874               and buf_shift-obj.status_  = 'зкр':U
      875             use-index stts
      876             no-error .
      877           if available buf_shift-obj
      878           then do:
      879             assign
      880               v-extra-message =
      881                     substitute("Дата начала последеней закрытой смены на объекте &1"
      882                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      883                               )
      884             .
      885           end.
      886           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      887           undo, return error v-error .
      888         end.
      889       end.
      890     end.
      891   end procedure.
      892   procedure factord-end-day :
      893     define input  parameter p-fact-date            as date    no-undo .
      894     define output parameter p-day-end-fact-order   as decimal no-undo .
      895     do
      896     on error undo, return error return-value
      897     :
      898       if p-fact-date = ?
      899       then do:
      900         return error "Не указана фактическая дата" .
      901       end.
      902       assign
      903         p-day-end-fact-order = integer(p-fact-date) + 0.99
      904       .
      905     end.
      906   end procedure.
      907   procedure factord-to-date :
      908     define input  parameter p-fact-order as decimal no-undo .
      909     define output parameter p-fact-date  as date    no-undo .
      910     define variable v-ref-date  as date      no-undo .
      911     define variable v-ref-delta as integer   no-undo .
      912     do
      913     on error undo, return error return-value
      914     :
      915       if p-fact-order = ?
      916       or p-fact-order = 0
      917       then do:
      918         return error "Не указан fact-order" .
      919       end.
      920       assign
      921         v-ref-date  = date(1, 1, 2000)
      922       .
      923       assign
      924         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      925       .
      926       assign
      927         p-fact-date = v-ref-date + v-ref-delta
      928       .
      929     end.
      930   end procedure.
      931   procedure factord-to-fact-num :
      932     define input  parameter p-fact-order as decimal no-undo .
      933     define output parameter p-fact-num   as integer no-undo .
      934     define variable v-fact-order-trunc as decimal no-undo .
      935     do
      936     on error undo, return error return-value
      937     :
      938       if p-fact-order = ?
      939       or p-fact-order = 0
      940       then do:
      941         return error "Не указан fact-order" .
      942       end.
      943       assign
      944        v-fact-order-trunc = truncate(p-fact-order, 2)
      945       .
      946       assign
      947         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      948       .
      949     end.
      950   end procedure.
      951   procedure factord-to-shift-num :
      952     define input  parameter p-fact-order as decimal no-undo .
      953     define output parameter p-shift-num   as integer no-undo .
      954     define variable  p-shift-numd  as decimal   no-undo .
      955     define variable v-fact-order-trunc as decimal no-undo .
      956     do
      957     on error undo, return error return-value
      958     :
      959       if p-fact-order = ?
      960       or p-fact-order = 0
      961       then do:
      962         return error "Не указан fact-order" .
      963       end.
      964       assign
      965        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      966       .
      967       if v-fact-order-trunc < 0.5 then do:
      968         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      969       end.
      970       assign
      971         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      972         .
      973        assign
      974         p-shift-num = truncate (p-shift-numd , 0)
      975       .
      976     end.
      977   end procedure.
