     1647       create temp-contr .
     1648       assign
     1649         temp-contr.dat       = buf_fin-ob.pay-date
     1650         temp-contr.day       = if buf_fin-ob.pay-date < today then ( today - buf_fin-ob.pay-date ) else  0
     1651         temp-contr.num       = buf_fin-ob.prn-doc-code
     1652         temp-contr.contr     = buf_contract.contract-code
     1653         no-fo                = no
