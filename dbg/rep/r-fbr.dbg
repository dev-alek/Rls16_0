     2099                   , input v-sum-cost-rb
     2100                   , input v-sum-cost-not-rb
     2101                   , input v-sum-cost-vat-rb
     2102                   , input v-sum-cost-vat-not-rb
     2103                   , input v-sum-sale
     2104                   , input v-print-sale
     2105                   , input v-calories
     2106                   , input v-protein
     2107                   , input v-carbohydrate
     2108                   , input v-fat
     2109               ).
     2110           end.
     2111       end.
