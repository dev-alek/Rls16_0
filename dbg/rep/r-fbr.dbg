     2089                        v-protein      = 0
     2090                        v-carbohydrate = 0
     2091                     .
     2092               END.
     2093               run print-fbr-line in this-procedure (
     2094                     input recid( buf_fbr-line )
     2095                   , input v-counter
     2096                   , input p-print-in-rubl
