     1611       define variable v-doc-code                          as character    no-undo.
     1612       define variable v-doc-date                          as date         no-undo.
     1613       define variable v-barcode                           as character    no-undo.
     1614       define variable v-is-waste                          as character    no-undo.
     1615       define variable v-counter                           as integer      no-undo.
     1616       define variable v-line-string                       as character    no-undo.
     1617       define variable v-host-code                         as integer      no-undo.
     1618       define variable v-print-sale                        as logical      no-undo.
     1619       define variable v-sum-qnty                          as decimal      no-undo.
     1620       define variable v-price-cost-rb                     as decimal      no-undo.
     1621       define variable v-price-cost-not-rb                 as decimal      no-undo.
     1622       define variable v-sum-cost-rb                       as decimal      no-undo.
     1623       define variable v-sum-cost-not-rb                   as decimal      no-undo.
     1624       define variable v-sum-cost-vat-rb                   as decimal      no-undo.
     1625       define variable v-sum-cost-vat-not-rb               as decimal      no-undo.
     1626       define variable v-price-sale                        as decimal      no-undo.
     1627       define variable v-sum-sale                          as decimal      no-undo.
     1628       define variable v-tot-sum-write-off-cost-rubl       as decimal      no-undo.
     1629       define variable v-tot-sum-write-off-cost-base       as decimal      no-undo.
     1630       define variable v-tot-sum-write-off-costvat-rubl    as decimal      no-undo.
     1631       define variable v-tot-sum-write-off-costvat-base    as decimal      no-undo.
     1632       define variable v-tot-sum-write-off-price           as decimal      no-undo.
     1633       define variable v-tot-sum-income-cost-rubl          as decimal      no-undo.
     1634       define variable v-tot-sum-income-cost-base          as decimal      no-undo.
     1635       define variable v-tot-sum-income-cost-vat-rubl      as decimal      no-undo.
     1636       define variable v-tot-sum-income-cost-vat-base      as decimal      no-undo.
     1637       define variable v-tot-sum-income-price              as decimal      no-undo.
     1638       define variable v-fat                               as decimal      no-undo.
     1639       define variable v-calories                          as decimal      no-undo.
     1640       define variable v-protein                           as decimal      no-undo.
     1641       define variable v-carbohydrate                      as decimal      no-undo.
     1642       define variable v-artic                             as character        no-undo.
     1643       define variable v-gds-name                          as character        no-undo.
     1644       define variable v-unit-base                         as character        no-undo.
     1645       define variable v-rb-is-base                        as logical init no  no-undo.
     1646       define buffer buf_fbr-doc   for ub.fbr-doc.
     1647       define buffer buf_fbr-line  for ub.fbr-line.
     1648       define buffer buf_goods     for ub.goods.
     1649       define buffer buf_trn-doc   for ub.trn-doc.
     1650       define buffer buf_clients for ub.clients.
     1651   define variable sym1  as character init "|"   no-undo.
     1652   define variable sym2  as character init "|"   no-undo.
     1653   define variable sym3  as character init "|"   no-undo.
     1654   define variable sym4  as character init "|"   no-undo.
     1655   define variable sym5  as character init "|"   no-undo.
     1656   define variable sym6  as character init "|"   no-undo.
     1657   define variable sym7  as character init "|"   no-undo.
     1658   define variable sym8  as character init "|"   no-undo.
     1659   define variable sym9  as character init "|"   no-undo.
     1660   define variable sym10 as character init "|"   no-undo.
     1661   define variable sym11 as character init "|"   no-undo.
     1662   define variable sym12 as character init "|"   no-undo.
     1663   define variable sym13 as character init "|"   no-undo.
     1664   define variable sym14 as character init "|"   no-undo.
     1665   define variable sym15 as character init "|"   no-undo.
     1666   define variable sym16 as character init "|"   no-undo.
     1667   define variable sym17 as character init "|"   no-undo.
     1668       define variable g#report-num    as integer      no-undo.
     1669       define variable g#quest-print   as logical      no-undo.
     1670       define variable g#log           as logical      no-undo.
     1671       define stream Outstream.
     1672   define frame fbr-in-rb
     1673       sym1                    column-label "|!|"                      format "X(1)"           space(0)
     1674       v-counter               column-label "N!п/п"                    format ">>9"            space(0)
     1675       sym2                    column-label "|!|"                      format "X(1)"           space(0)
     1676       v-is-waste              column-label "Отх! "                    format "X(3)"           space(0)
     1677       sym3                    column-label "|!|"                      format "X(1)"           space(0)
     1678       v-barcode               column-label "Код! "                    format "X(10)" space(0)
     1679       sym4                    column-label "|!|"                      format "X(1)"           space(0)
     1680       v-artic                 column-label "Артикул! "                format "X(16)"          space(0)
     1681       sym5                    column-label "|!|"                      format "X(1)"           space(0)
     1682       v-gds-name              column-label "Название товара! "        format "X(39)"          space(0)
     1683       sym6                    column-label "|!|"                      format "X(1)"           space(0)
     1684       v-unit-base             column-label "Ед.!изм"                  format "X(3)"           space(0)
     1685       sym7                    column-label "|!|"                      format "X(1)"           space(0)
     1686       v-sum-qnty              column-label "Количество! "             format ">>,>>9.999"     space(0)
     1687       sym8                    column-label "|!|"                      format "X(1)"           space(0)
