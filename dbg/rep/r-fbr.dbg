     1484   procedure nutro_get-nutrition-info :
     1485     define input  parameter p-artic         as character no-undo .
     1486     define input  parameter p-prod-type     as character no-undo .
     1487     define input  parameter p-prod-code     as integer   no-undo .
     1488     define input  parameter p-obj-type      as character no-undo .
     1489     define input  parameter p-obj-code      as integer   no-undo .
     1490     define output parameter p-calories      as decimal   no-undo .
     1491     define output parameter p-protein       as decimal   no-undo .
     1492     define output parameter p-carbohydrate  as decimal   no-undo .
     1493     define output parameter p-fat           as decimal   no-undo .
     1494     define buffer buf_goods    for ub.goods .
     1495     define variable v-attr-value    as character no-undo .
     1496     define variable v-attr-type     as character no-undo .
     1497     define variable v-attr-code     as character no-undo .
     1498     define variable v-exist         as logical   no-undo .
     1499     define variable v-is-global     as logical   no-undo .
     1500     define variable v-nutro-value   as decimal   no-undo .
     1501     define buffer buf_fbr-gds-obj  for ub.fbr-gds-obj.
     1502     define buffer buf_recipe       for ub.recipe.
     1503   do
     1504   on error undo, return error return-value
     1505   :
     1506     assign
     1507       p-carbohydrate  = ?
     1508       p-fat           = ?
     1509       p-protein       = ?
     1510       p-calories      = ?
     1511     .
     1512     find first buf_goods no-lock
     1513       where buf_goods.artic     = p-artic
     1514         and buf_goods.prod-type = p-prod-type
     1515         and buf_goods.prod-code = p-prod-code
     1516     no-error .
     1517     if not available buf_goods
     1518     then do:
     1519       return .
     1520     end.
     1521     assign
     1522       v-is-global = yes
     1523     .
     1524     find first buf_fbr-gds-obj no-lock
     1525       where buf_fbr-gds-obj.obj-type = p-obj-type
     1526         and buf_fbr-gds-obj.obj-code = p-obj-code
     1527         and buf_fbr-gds-obj.gds-code = buf_goods.gds-code
     1528     no-error .
     1529     if available buf_fbr-gds-obj
     1530     then do:
     1531       if  buf_fbr-gds-obj.is-semi-finished or
     1532           buf_fbr-gds-obj.is-menu
     1533       then do:
     1534         assign
     1535           v-is-global = no
     1536         .
     1537         find first buf_recipe no-lock
     1538           where buf_recipe.recipe-code = buf_fbr-gds-obj.default-recipe-code
     1539         no-error .
     1540         if available buf_recipe
     1541         then do:
     1542           assign
     1543             v-is-global = ( buf_recipe.host-code = 0    ) and
     1544                           ( buf_recipe.obj-type  = "":U ) and
     1545                           ( buf_recipe.obj-code  = 0    )
     1546           .
     1547         end.
     1548       end.
     1549     end.
     1550     if v-is-global = yes
     1551     then do:
     1552       assign
     1553         v-attr-code = 'calories':U
     1554       .
     1555       assign                       v-nutro-value = ?                     .                     run gds-attr-exist in this-procedure ( input  buf_goods.gds-code                                                          , input  v-attr-code                                                          , output v-exist                                                          ) no-error .                     if error-status :error = yes or                         v-exist = no                     then do:                       assign                         v-nutro-value = ?                       .                     end.                     else do:                       run gds-attr-value in this-procedure ( input  buf_goods.gds-code                                                           , input  v-attr-code                                                           , output v-attr-value                                                           , output v-attr-type                                                           ) no-error .                       if error-status :error                       then do:                         assign                           v-nutro-value = ?                         .                       end.                       assign                         v-nutro-value = decimal( v-attr-value )                       no-error .                       if error-status :error = yes                       then do:                         assign                           v-nutro-value = ?                         .                       end.                     end.
     1556       assign
     1557         p-calories  = v-nutro-value
     1558         v-attr-code = 'carbohydrate':U
     1559       .
     1560       assign                       v-nutro-value = ?                     .                     run gds-attr-exist in this-procedure ( input  buf_goods.gds-code                                                          , input  v-attr-code                                                          , output v-exist                                                          ) no-error .                     if error-status :error = yes or                         v-exist = no                     then do:                       assign                         v-nutro-value = ?                       .                     end.                     else do:                       run gds-attr-value in this-procedure ( input  buf_goods.gds-code                                                           , input  v-attr-code                                                           , output v-attr-value                                                           , output v-attr-type                                                           ) no-error .                       if error-status :error                       then do:                         assign                           v-nutro-value = ?                         .                       end.                       assign                         v-nutro-value = decimal( v-attr-value )                       no-error .                       if error-status :error = yes                       then do:                         assign                           v-nutro-value = ?                         .                       end.                     end.
     1561       assign
     1562         p-carbohydrate  = v-nutro-value
     1563         v-attr-code     = 'fat':U
     1564       .
     1565       assign                       v-nutro-value = ?                     .                     run gds-attr-exist in this-procedure ( input  buf_goods.gds-code                                                          , input  v-attr-code                                                          , output v-exist                                                          ) no-error .                     if error-status :error = yes or                         v-exist = no                     then do:                       assign                         v-nutro-value = ?                       .                     end.                     else do:                       run gds-attr-value in this-procedure ( input  buf_goods.gds-code                                                           , input  v-attr-code                                                           , output v-attr-value                                                           , output v-attr-type                                                           ) no-error .                       if error-status :error                       then do:                         assign                           v-nutro-value = ?                         .                       end.                       assign                         v-nutro-value = decimal( v-attr-value )                       no-error .                       if error-status :error = yes                       then do:                         assign                           v-nutro-value = ?                         .                       end.                     end.
     1566       assign
     1567         p-fat       = v-nutro-value
     1568         v-attr-code = 'protein':U
     1569       .
     1570       assign                       v-nutro-value = ?                     .                     run gds-attr-exist in this-procedure ( input  buf_goods.gds-code                                                          , input  v-attr-code                                                          , output v-exist                                                          ) no-error .                     if error-status :error = yes or                         v-exist = no                     then do:                       assign                         v-nutro-value = ?                       .                     end.                     else do:                       run gds-attr-value in this-procedure ( input  buf_goods.gds-code                                                           , input  v-attr-code                                                           , output v-attr-value                                                           , output v-attr-type                                                           ) no-error .                       if error-status :error                       then do:                         assign                           v-nutro-value = ?                         .                       end.                       assign                         v-nutro-value = decimal( v-attr-value )                       no-error .                       if error-status :error = yes                       then do:                         assign                           v-nutro-value = ?                         .                       end.                     end.
     1571       assign
     1572         p-protein = v-nutro-value
     1573       .
     1574     end.
     1575     else do:
     1576       assign
     1577         v-attr-code = 'calories-o':U
     1578       .
     1579       assign                      v-nutro-value = ?                    .                    run gdsoattr-exist in this-procedure ( input buf_goods.gds-code                                                         , input p-obj-type                                                         , input p-obj-code                                                         , input v-attr-code                                                         , output v-exist                                                         ) no-error .                    if error-status :error = yes or                       v-exist = no                    then do:                     assign                       v-nutro-value = ?                     .                    end.                    else do:                     run gdsoattr-value in this-procedure ( input  v-attr-code                                                           , input  buf_goods.gds-code                                                           , input  p-obj-type                                                           , input  p-obj-code                                                           , output v-attr-value                                                           , output v-attr-type                                                           ) no-error .                     if error-status :error = yes                     then do:                       assign                         v-nutro-value = ?                       .                     end.                     assign                       v-nutro-value = decimal(v-attr-value)                     no-error .                     if error-status :error = yes                     then do:                       assign                         v-nutro-value = ?                       .                     end.                    end.
     1580       assign
     1581         p-calories  = v-nutro-value
     1582         v-attr-code = 'carbohydrate-o':U
     1583       .
     1584       assign                      v-nutro-value = ?                    .                    run gdsoattr-exist in this-procedure ( input buf_goods.gds-code                                                         , input p-obj-type                                                         , input p-obj-code                                                         , input v-attr-code                                                         , output v-exist                                                         ) no-error .                    if error-status :error = yes or                       v-exist = no                    then do:                     assign                       v-nutro-value = ?                     .                    end.                    else do:                     run gdsoattr-value in this-procedure ( input  v-attr-code                                                           , input  buf_goods.gds-code                                                           , input  p-obj-type                                                           , input  p-obj-code                                                           , output v-attr-value                                                           , output v-attr-type                                                           ) no-error .                     if error-status :error = yes                     then do:                       assign                         v-nutro-value = ?                       .                     end.                     assign                       v-nutro-value = decimal(v-attr-value)                     no-error .                     if error-status :error = yes                     then do:                       assign                         v-nutro-value = ?                       .                     end.                    end.
     1585       assign
     1586         p-carbohydrate  = v-nutro-value
     1587         v-attr-code     = 'fat-o':U
     1588       .
     1589       assign                      v-nutro-value = ?                    .                    run gdsoattr-exist in this-procedure ( input buf_goods.gds-code                                                         , input p-obj-type                                                         , input p-obj-code                                                         , input v-attr-code                                                         , output v-exist                                                         ) no-error .                    if error-status :error = yes or                       v-exist = no                    then do:                     assign                       v-nutro-value = ?                     .                    end.                    else do:                     run gdsoattr-value in this-procedure ( input  v-attr-code                                                           , input  buf_goods.gds-code                                                           , input  p-obj-type                                                           , input  p-obj-code                                                           , output v-attr-value                                                           , output v-attr-type                                                           ) no-error .                     if error-status :error = yes                     then do:                       assign                         v-nutro-value = ?                       .                     end.                     assign                       v-nutro-value = decimal(v-attr-value)                     no-error .                     if error-status :error = yes                     then do:                       assign                         v-nutro-value = ?                       .                     end.                    end.
     1590       assign
     1591         p-fat       = v-nutro-value
     1592         v-attr-code = 'protein-o':U
     1593       .
     1594       assign                      v-nutro-value = ?                    .                    run gdsoattr-exist in this-procedure ( input buf_goods.gds-code                                                         , input p-obj-type                                                         , input p-obj-code                                                         , input v-attr-code                                                         , output v-exist                                                         ) no-error .                    if error-status :error = yes or                       v-exist = no                    then do:                     assign                       v-nutro-value = ?                     .                    end.                    else do:                     run gdsoattr-value in this-procedure ( input  v-attr-code                                                           , input  buf_goods.gds-code                                                           , input  p-obj-type                                                           , input  p-obj-code                                                           , output v-attr-value                                                           , output v-attr-type                                                           ) no-error .                     if error-status :error = yes                     then do:                       assign                         v-nutro-value = ?                       .                     end.                     assign                       v-nutro-value = decimal(v-attr-value)                     no-error .                     if error-status :error = yes                     then do:                       assign                         v-nutro-value = ?                       .                     end.                    end.
     1595       assign
     1596         p-protein = v-nutro-value
     1597       .
     1598     end.
     1599   end.
     1600   end procedure.
     1601   do
     1602   on error undo, return error return-value
     1603   :
     1604       define variable type-det as character init 'спи':U no-undo.
