     1749       sym8                    column-label "|!|"                      format "X(1)"           space(0)
     1750       v-price-cost-rb         column-label "Уч.цена!без НДС"          format ">,>>>,>>9.99"   space(0)
     1751       sym9                    column-label "|!|"                      format "X(1)"           space(0)
     1752       v-sum-cost-rb           column-label "Сумма уч.цен!без НДС"     format ">>>,>>>,>>9.99" space(0)
     1753       sym10                   column-label "|!|"                      format "X(1)"           space(0)
     1754       v-sum-cost-vat-rb       column-label "Сумма НДС! "              format ">>,>>>,>>9.99" space(0)
     1755       sym11                   column-label "|!|"                      format "X(1)"           space(0)
     1756       v-price-sale            column-label "Прод. цена! "             format ">,>>>,>>9.99"   space(0)
     1757       sym12                   column-label "|!|"                      format "X(1)"           space(0)
     1758       v-sum-sale              column-label "Сумма прод.!цен "         format ">>>,>>>,>>9.99" space(0)
     1759       sym13                   column-label "|!|"                      format "X(1)"           space(0)
     1760       v-calories              column-label "Калории! "                format ">>>>>>>9"       space(0)
     1761       sym14                   column-label "|!|"                      format "X(1)"           space(0)
