     2222            skip(1)
     2223            v-line-string   format "X(127)"
     2224         .
     2225         form with frame fbr-not-in-rb.
     2226      end.
     2227   END.
     2228   if p-print-details = yes
     2229   and type-det = 'при':U
     2230   then do:
     2231       for each buf_fbr-line no-lock
     2232          where buf_fbr-line.doc-code = buf_fbr-doc.doc-code
     2233            and buf_fbr-line.trn-type = 'при':U
     2234       break by buf_fbr-line.recipe-code
     2235       :
     2236           assign
     2237               v-counter = v-counter + 1
     2238           .
     2239            IF p-fat
     2240            THEN DO:
     2241               run nutro_get-nutrition-info in this-procedure ( input  buf_fbr-line.artic
     2242                                                              , input  buf_fbr-line.prod-type
     2243                                                              , input  buf_fbr-line.prod-code
     2244                                                              , input  v-cntxt-obj-type
     2245                                                              , input  v-cntxt-obj-code
     2246                                                              , output v-calories
     2247                                                              , output v-protein
     2248                                                              , output v-carbohydrate
     2249                                                              , output v-fat
     2250                                                              ).
     2251            END.
     2252            ELSE DO:
     2253                  ASSIGN
     2254                     v-fat          = 0
     2255                     v-calories     = 0
     2256                     v-protein      = 0
     2257                     v-carbohydrate = 0
     2258                  .
     2259            END.
     2260           run print-fbr-line in this-procedure (
     2261                 input recid( buf_fbr-line )
     2262               , input v-counter
     2263               , input p-print-in-rubl
     2264               , input buf_fbr-line.is-waste
     2265               , input buf_fbr-line.fact-qnty
     2266               , input ( if buf_fbr-line.is-waste = yes then 0 else buf_fbr-line.price-sum-rubl     )
     2267               , input ( if buf_fbr-line.is-waste = yes then 0 else buf_fbr-line.price-sum-base     )
     2268               , input ( if buf_fbr-line.is-waste = yes then 0 else buf_fbr-line.price-sum-vat-rubl )
     2269               , input ( if buf_fbr-line.is-waste = yes then 0 else buf_fbr-line.price-sum-vat-base )
     2270               , input ( if buf_fbr-line.price-sale = ? then 0 else buf_fbr-line.price-sale )
     2271               , input v-print-sale
     2272               , input v-fat
     2273               , input v-calories
     2274               , input v-protein
     2275               , input v-carbohydrate
     2276           ).
     2277           assign
     2278               v-tot-sum-income-cost-rubl      = v-tot-sum-income-cost-rubl        + ( if buf_fbr-line.is-waste = yes then 0 else buf_fbr-line.price-sum-rubl     )
     2279               v-tot-sum-income-cost-base      = v-tot-sum-income-cost-base        + ( if buf_fbr-line.is-waste = yes then 0 else buf_fbr-line.price-sum-base     )
     2280               v-tot-sum-income-cost-vat-rubl  = v-tot-sum-income-cost-vat-rubl    + ( if buf_fbr-line.is-waste = yes then 0 else buf_fbr-line.price-sum-vat-rubl )
     2281               v-tot-sum-income-cost-vat-base  = v-tot-sum-income-cost-vat-base    + ( if buf_fbr-line.is-waste = yes then 0 else buf_fbr-line.price-sum-vat-base )
     2282               v-tot-sum-income-price          = v-tot-sum-income-price            + ( if buf_fbr-line.price-sale = ? then 0 else buf_fbr-line.price-sale * buf_fbr-line.fact-qnty )
     2283           .
     2284       end.
     2285   end.
     2286   else do:
     2287       for each buf_fbr-line no-lock
     2288          where buf_fbr-line.doc-code = buf_fbr-doc.doc-code
     2289            and buf_fbr-line.trn-type = 'при':U
     2290       break by string( buf_fbr-line.artic + buf_fbr-line.prod-type + string( buf_fbr-line.prod-code ) )
     2291       :
     2292           if first-of( string( buf_fbr-line.artic + buf_fbr-line.prod-type + string( buf_fbr-line.prod-code ) ) )
     2293           then do:
     2294               assign
     2295                   v-sum-qnty          = 0
     2296                   v-sum-cost-rb     = 0
     2297                   v-sum-cost-not-rb     = 0
     2298                   v-sum-cost-vat-rb = 0
     2299                   v-sum-cost-vat-not-rb = 0
     2300                   v-sum-sale          = 0
     2301               .
     2302           end.
     2303           assign
     2304               v-sum-qnty          = v-sum-qnty            + buf_fbr-line.fact-qnty
     2305               v-sum-cost-rb     = v-sum-cost-rb       + ( if buf_fbr-line.is-waste = yes then 0 else buf_fbr-line.price-sum-rubl     )
     2306               v-sum-cost-not-rb     = v-sum-cost-not-rb       + ( if buf_fbr-line.is-waste = yes then 0 else buf_fbr-line.price-sum-base     )
     2307               v-sum-cost-vat-rb = v-sum-cost-vat-rb   + ( if buf_fbr-line.is-waste = yes then 0 else buf_fbr-line.price-sum-vat-rubl )
     2308               v-sum-cost-vat-not-rb = v-sum-cost-vat-not-rb   + ( if buf_fbr-line.is-waste = yes then 0 else buf_fbr-line.price-sum-vat-base )
     2309               v-sum-sale          = v-sum-sale            + ( if buf_fbr-line.price-sale = ? then 0 else buf_fbr-line.price-sale * buf_fbr-line.fact-qnty )
     2310           .
     2311           if last-of( string( buf_fbr-line.artic + buf_fbr-line.prod-type + string( buf_fbr-line.prod-code ) ) )
     2312           then do:
     2313               assign
     2314                   v-tot-sum-income-cost-rubl      = v-tot-sum-income-cost-rubl        + v-sum-cost-rb
     2315                   v-tot-sum-income-cost-base      = v-tot-sum-income-cost-base        + v-sum-cost-not-rb
     2316                   v-tot-sum-income-cost-vat-rubl  = v-tot-sum-income-cost-vat-rubl    + v-sum-cost-vat-rb
     2317                   v-tot-sum-income-cost-vat-base  = v-tot-sum-income-cost-vat-base    + v-sum-cost-vat-not-rb
     2318                   v-tot-sum-income-price          = v-tot-sum-income-price            + v-sum-sale
     2319                   v-counter                       = v-counter + 1
     2320               .
     2321               IF p-fat
     2322               THEN DO:
     2323                 run nutro_get-nutrition-info in this-procedure ( input  buf_fbr-line.artic
     2324                                                                , input  buf_fbr-line.prod-type
     2325                                                                , input  buf_fbr-line.prod-code
     2326                                                                , input  v-cntxt-obj-type
     2327                                                                , input  v-cntxt-obj-code
     2328                                                                , output v-calories
     2329                                                                , output v-protein
     2330                                                                , output v-carbohydrate
     2331                                                                , output v-fat
     2332                                                                ).
     2333               END.
     2334               ELSE DO:
     2335                     ASSIGN
     2336                        v-fat          = 0
     2337                        v-calories     = 0
     2338                        v-protein      = 0
     2339                        v-carbohydrate = 0
     2340                     .
     2341               END.
     2342               run print-fbr-line in this-procedure (
     2343                     input recid( buf_fbr-line )
     2344                   , input v-counter
     2345                   , input p-print-in-rubl
     2346                   , input buf_fbr-line.is-waste
     2347                   , input v-sum-qnty
     2348                   , input v-sum-cost-rb
     2349                   , input v-sum-cost-not-rb
     2350                   , input v-sum-cost-vat-rb
     2351                   , input v-sum-cost-vat-not-rb
     2352                   , input v-sum-sale
     2353                   , input v-print-sale
     2354                   , input v-calories
     2355                   , input v-protein
     2356                   , input v-carbohydrate
     2357                   , input v-fat
     2358               ).
     2359           end.
     2360       end.
     2361   end.
     2362   IF p-fat
     2363   THEN DO:
     2364      if v-print-sale = yes
     2365      then do:
     2366         if line-counter( Outstream ) <> 1
     2367         then do:
     2368           put stream outstream
     2369             v-line-string format "X(198)"
     2370           .
     2371         end.
     2372         display stream outstream
     2373            "ИТОГО" @ v-gds-name
     2374            ( if p-print-in-rubl = yes
     2375            then v-tot-sum-income-cost-rubl
     2376            else v-tot-sum-income-cost-base )     @ v-sum-cost-rb
     2377            ( if p-print-in-rubl = yes
     2378            then v-tot-sum-income-cost-vat-rubl
     2379            else v-tot-sum-income-cost-vat-base ) @ v-sum-cost-vat-rb
     2380            v-tot-sum-income-price                @ v-sum-sale
     2381            with frame fbr-in-rb-fat.
     2382         down stream outstream 2 with frame fbr-in-rb-fat.
     2383      end.
     2384      else do:
     2385         if line-counter( Outstream ) <> 1
     2386         then do:
     2387           put stream outstream
     2388             v-line-string format "X(162)"
     2389           .
     2390         end.
     2391         display stream outstream
     2392            "ИТОГО" @ v-gds-name
     2393            ( if p-print-in-rubl = yes
     2394            then v-tot-sum-income-cost-rubl
     2395            else v-tot-sum-income-cost-base )     @ v-sum-cost-not-rb
     2396            ( if p-print-in-rubl = yes
     2397            then v-tot-sum-income-cost-vat-rubl
     2398            else v-tot-sum-income-cost-vat-base )  @ v-sum-cost-vat-not-rb
     2399         with frame fbr-not-in-rb-fat.
     2400         down stream outstream 2 with frame fbr-not-in-rb-fat.
     2401      end.
     2402   END.
     2403   ELSE DO:
     2404      if v-print-sale = yes
     2405      then do:
     2406         if line-counter( Outstream ) <> 1
     2407         then do:
     2408           put stream outstream
     2409             v-line-string format "X(163)"
     2410           .
     2411         end.
     2412         display stream outstream
     2413            "ИТОГО" @ v-gds-name
     2414            ( if p-print-in-rubl = yes
     2415            then v-tot-sum-income-cost-rubl
     2416            else v-tot-sum-income-cost-base )     @ v-sum-cost-rb
     2417            ( if p-print-in-rubl = yes
     2418            then v-tot-sum-income-cost-vat-rubl
     2419            else v-tot-sum-income-cost-vat-base ) @ v-sum-cost-vat-rb
     2420            v-tot-sum-income-price                @ v-sum-sale
     2421            with frame fbr-in-rb.
     2422         down stream outstream 2 with frame fbr-in-rb.
     2423      end.
     2424      else do:
     2425         if line-counter( Outstream ) <> 1
     2426         then do:
     2427           put stream outstream
     2428             v-line-string format "X(127)"
     2429           .
     2430         end.
     2431         display stream outstream
     2432            "ИТОГО" @ v-gds-name
     2433            ( if p-print-in-rubl = yes
     2434            then v-tot-sum-income-cost-rubl
     2435            else v-tot-sum-income-cost-base )     @ v-sum-cost-not-rb
     2436            ( if p-print-in-rubl = yes
     2437            then v-tot-sum-income-cost-vat-rubl
     2438            else v-tot-sum-income-cost-vat-base )  @ v-sum-cost-vat-not-rb
     2439         with frame fbr-not-in-rb.
     2440         down stream outstream 2 with frame fbr-not-in-rb.
     2441      end.
     2442   END.
     2443   if v-print-sale = yes
     2444   then do:
     2445       if line-counter( Outstream ) + 11 > page-size( Outstream )
     2446       then do:
     2447           page stream Outstream .
     2448       end.
     2449   end.
     2450   else do:
     2451       if line-counter( Outstream ) + 8 > page-size( Outstream )
     2452       then do:
     2453           page stream Outstream .
     2454       end.
     2455   end.
     2456   put stream Outstream
     2457       "Всего списано товаров (в учетных ценах) на сумму" ": " at 57
     2458       ( if p-print-in-rubl = no
     2459         then v-tot-sum-write-off-cost-base + v-tot-sum-write-off-costvat-base
     2460         else v-tot-sum-write-off-cost-rubl + v-tot-sum-write-off-costvat-rubl
     2461       ) format ">>>,>>>,>>>,>>>,>>9.99"
     2462       skip
     2463       "Всего произведено товаров (в учетных ценах) на сумму" ": " at 57
     2464       ( if p-print-in-rubl = no
     2465         then v-tot-sum-income-cost-base + v-tot-sum-income-cost-vat-base
     2466         else v-tot-sum-income-cost-rubl + v-tot-sum-income-cost-vat-rubl
     2467       ) format ">>>,>>>,>>>,>>>,>>9.99"
     2468       skip(1)
     2469   .
     2470   if v-print-sale = yes
     2471   then do:
     2472       put stream Outstream
     2473           "Всего списано товаров (в продажных ценах) на сумму" ": " at 57 v-tot-sum-write-off-price format ">>>,>>>,>>>,>>>,>>9.99"
     2474           skip
     2475           "Всего произведено товаров (в продажных ценах) на сумму" ": " at 57 v-tot-sum-income-price  format ">>>,>>>,>>>,>>>,>>9.99"
     2476           skip(1)
     2477       .
     2478   end.
     2479       put stream Outstream
     2480           "Материально ответственное лицо: ____________________ "
     2481           skip(1)
     2482           "Бухгалтер: ____________________ "
     2483           skip(1)
     2484           "Обработал: ____________________ "
     2485           skip(1)
     2486       .
     2487       hide stream Outstream frame Bottomframe .
     2488       output stream Outstream close.
     2489   if session :set-wait-state( "" ) then.
     2490       define variable v-user-action           as character            no-undo.
     2491       define variable v-printed               as logical              no-undo.
     2492       if v-print-sale = yes or p-fat = yes
     2493       then do:
     2494           run gbl/prnfilen.w (
     2495                 input "":U
     2496               , input 8
     2497               , input string( session :temp-directory ) + "rpt" + string( g#report-num )
     2498               , input 7
     2499               , output v-user-action
     2500               , output v-printed
     2501           ) .
     2502       end.
     2503       else do:
     2504           run gbl/prnfilen.w (
     2505                 input "":U
     2506               , input 0
     2507               , input string( session :temp-directory ) + "rpt" + string( g#report-num )
     2508               , input 7
     2509               , output v-user-action
     2510               , output v-printed
     2511           ) .
     2512       end.
     2513   end.
     2514   end.
     2515   procedure print-fbr-line :
     2516   do
     2517   on error undo, return error
     2518   :
     2519   define input parameter p-fbr-line-recid     as recid        no-undo.
     2520   define input parameter p-counter            as integer      no-undo.
     2521   define input parameter p-print-in-rubl      as logical      no-undo.
     2522   define input parameter p-is-waste           as logical      no-undo.
     2523   define input parameter p-fact-qnty          as decimal      no-undo.
     2524   define input parameter p-sum-cost-rubl      as decimal      no-undo.
     2525   define input parameter p-sum-cost-base      as decimal      no-undo.
     2526   define input parameter p-sum-cost-vat-rubl  as decimal      no-undo.
     2527   define input parameter p-sum-cost-vat-base  as decimal      no-undo.
     2528   define input parameter p-sum-sale           as decimal      no-undo.
     2529   define input parameter p-print-price-sale   as logical      no-undo.
     2530   define input parameter p-calories           as decimal      no-undo.
     2531   define input parameter p-protein            as decimal      no-undo.
     2532   define input parameter p-carbohydrate       as decimal      no-undo.
     2533   define input parameter p-fat-1              as decimal      no-undo.
     2534       define variable v-bar-code              as character     no-undo.
     2535       define variable v-print-sum-cost        as decimal       no-undo.
     2536       define variable v-print-sum-cost-vat    as decimal       no-undo.
     2537       define buffer buf_fbr-line  for ub.fbr-line.
     2538       define buffer buf_goods     for ub.goods.
     2539       find first buf_fbr-line no-lock
     2540           where recid( buf_fbr-line ) = p-fbr-line-recid
     2541       .
     2542       find first buf_goods no-lock
     2543            where buf_goods.artic      = buf_fbr-line.artic
     2544              and buf_goods.prod-type  = buf_fbr-line.prod-type
     2545              and buf_goods.prod-code  = buf_fbr-line.prod-code
     2546       .
     2547   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2548     (input  buf_goods.gds-code
     2549     ,input  ?
     2550     ,output v-bar-code
     2551     ) no-error .
     2552    .
     2553       if p-print-in-rubl = yes
     2554       then do:
     2555           assign
     2556               v-print-sum-cost        =  p-sum-cost-rubl
     2557               v-print-sum-cost-vat    =  p-sum-cost-vat-rubl
     2558           .
     2559       end.
     2560       else do:
     2561           assign
     2562               v-print-sum-cost        = p-sum-cost-base
     2563               v-print-sum-cost-vat    = p-sum-cost-vat-base
     2564           .
     2565       end.
     2566       IF p-fat
     2567       THEN DO:
     2568         if p-print-price-sale = yes
     2569         then do:
     2570            display stream OutStream
     2571                  sym1 p-counter                                                  @ v-counter
     2572                  sym2 " О"                       when p-is-waste = yes           @ v-is-waste
     2573                  sym3 string( v-bar-code )                                       @ v-barcode
     2574                  sym4 buf_fbr-line.artic                                         @ v-artic
     2575                  sym5 buf_goods.gds-name                                         @ v-gds-name
     2576                  sym6 buf_goods.unit-base                                        @ v-unit-base
     2577                  sym7 p-fact-qnty                                                @ v-sum-qnty
     2578                  sym8 v-print-sum-cost / p-fact-qnty                              @ v-price-cost-rb
     2579                  sym9 v-print-sum-cost                                            @ v-sum-cost-rb
     2580                  sym10 v-print-sum-cost-vat                                       @ v-sum-cost-vat-rb
     2581                  sym11
     2582                  sym12 p-sum-sale                                                @ v-sum-sale
     2583                  sym13 p-calories     @ v-calories
     2584                  sym14 p-protein      @ v-protein
     2585                  sym15 p-fat-1        @ v-fat
     2586                  sym16 p-carbohydrate @ v-carbohydrate
     2587                  sym17
     2588            with frame fbr-in-rb-fat.
     2589            down stream OutStream 1 with frame fbr-in-rb-fat.
     2590         end.
     2591         else do:
     2592            display stream OutStream
     2593                  sym1 p-counter                                                  @ v-counter
     2594                  sym2 " О"                       when p-is-waste = yes           @ v-is-waste
     2595                  sym3 string( v-bar-code )                                       @ v-barcode
     2596                  sym4 buf_fbr-line.artic                                         @ v-artic
     2597                  sym5 buf_goods.gds-name                                         @ v-gds-name
     2598                  sym6 buf_goods.unit-base                                        @ v-unit-base
     2599                  sym7 p-fact-qnty                                                @ v-sum-qnty
     2600                  sym8 v-print-sum-cost / p-fact-qnty                              @ v-price-cost-not-rb
     2601                  sym9 v-print-sum-cost                                            @ v-sum-cost-not-rb
     2602                  sym10 v-print-sum-cost-vat                                       @ v-sum-cost-vat-not-rb
     2603                  sym11 p-calories     @ v-calories
     2604                  sym12 p-protein      @ v-protein
     2605                  sym13 p-fat-1        @ v-fat
     2606                  sym14 p-carbohydrate @ v-carbohydrate
     2607                  sym15
     2608            with frame fbr-not-in-rb-fat.
     2609            down stream OutStream 1 with frame fbr-not-in-rb-fat.
     2610         end.
     2611       END.
     2612       ELSE DO:
     2613         if p-print-price-sale = yes
     2614         then do:
     2615            display stream OutStream
     2616                  sym1 p-counter                                                  @ v-counter
     2617                  sym2 " О"                       when p-is-waste = yes           @ v-is-waste
     2618                  sym3 string( v-bar-code )                                       @ v-barcode
     2619                  sym4 buf_fbr-line.artic                                         @ v-artic
     2620                  sym5 buf_goods.gds-name                                         @ v-gds-name
     2621                  sym6 buf_goods.unit-base                                        @ v-unit-base
     2622                  sym7 p-fact-qnty                                                @ v-sum-qnty
     2623                  sym8 v-print-sum-cost / p-fact-qnty                              @ v-price-cost-rb
     2624                  sym9 v-print-sum-cost                                            @ v-sum-cost-rb
     2625                  sym10 v-print-sum-cost-vat                                       @ v-sum-cost-vat-rb
     2626                  sym11 p-sum-sale / p-fact-qnty                                  @ v-price-sale
     2627                  sym12 p-sum-sale                                                @ v-sum-sale
     2628                  sym13
     2629            with frame fbr-in-rb.
     2630            down stream OutStream 1 with frame fbr-in-rb.
     2631         end.
     2632         else do:
     2633            display stream OutStream
     2634                  sym1 p-counter                                                  @ v-counter
     2635                  sym2 " О"                       when p-is-waste = yes           @ v-is-waste
     2636                  sym3 string( v-bar-code )                                       @ v-barcode
     2637                  sym4 buf_fbr-line.artic                                         @ v-artic
     2638                  sym5 buf_goods.gds-name                                         @ v-gds-name
     2639                  sym6 buf_goods.unit-base                                        @ v-unit-base
     2640                  sym7 p-fact-qnty                                                @ v-sum-qnty
     2641                  sym8 v-print-sum-cost / p-fact-qnty                              @ v-price-cost-not-rb
     2642                  sym9 v-print-sum-cost                                            @ v-sum-cost-not-rb
     2643                  sym10 v-print-sum-cost-vat                                       @ v-sum-cost-vat-not-rb
     2644                  sym11
     2645            with frame fbr-not-in-rb.
     2646            down stream OutStream 1 with frame fbr-not-in-rb.
     2647         end.
     2648       END.
     2649       if line-counter( Outstream ) + 2 > page-size( Outstream )
     2650       then do:
     2651         if p-fat
     2652         then do:
     2653           if v-print-sale = yes
     2654           then do:
     2655             put stream outstream
     2656               v-line-string format "X(198)"
     2657             .
     2658           end.
     2659           else do:
     2660             put stream outstream
     2661               v-line-string format "X(162)"
     2662             .
     2663           end.
     2664         end.
     2665         else do:
     2666           if v-print-sale = yes
     2667           then do:
     2668             put stream outstream
     2669               v-line-string format "X(163)"
     2670             .
     2671           end.
     2672           else do:
     2673             put stream outstream
     2674               v-line-string format "X(127)"
     2675             .
     2676           end.
     2677         end.
     2678         page stream Outstream .
     2679       end.
     2680   end.
     2681   end procedure.
