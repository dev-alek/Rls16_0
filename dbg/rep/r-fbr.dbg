     1772              string( "Страница " + string( page-number( OutStream ), ">>9" ) ) at  150 format "X(14)"
     1773       skip v-line-string format  "X(198)" AT 1
     1774   with width 198 down stream-io NO-BOX.
     1775   define frame fbr-not-in-rb-fat
     1776       sym1                    column-label "|!|"                          format "X(1)"           space(0)
     1777       v-counter               column-label "N!п/п"                        format ">>9"            space(0)
     1778       sym2                    column-label "|!|"                          format "X(1)"           space(0)
     1779       v-is-waste              column-label "Отх! "                        format "X(3)"           space(0)
     1780       sym3                    column-label "|!|"                          format "X(1)"           space(0)
     1781       v-barcode               column-label "Код! "                        format "X(10)" space(0)
     1782       sym4                    column-label "|!|"                          format "X(1)"           space(0)
     1783       v-artic                 column-label "Артикул! "                    format "X(16)"          space(0)
     1784       sym5                    column-label "|!|"                          format "X(1)"           space(0)
     1785       v-gds-name              column-label "Название товара! "            format "X(31)"          space(0)
     1786       sym6                    column-label "|!|"                          format "X(1)"           space(0)
     1787       v-unit-base             column-label "Ед.!изм"                      format "X(3)"           space(0)
     1788       sym7                    column-label "|!|"                          format "X(1)"           space(0)
     1789       v-sum-qnty              column-label "Количество! "                 format ">>,>>9.999"     space(0)
     1790       sym8                    column-label "|!|"                          format "X(1)"           space(0)
     1791       v-price-cost-not-rb     column-label "Уч.цена!без НДС"              format ">,>>>,>>9.99"   space(0)
     1792       sym9                    column-label "|!|"                          format "X(1)"           space(0)
     1793       v-sum-cost-not-rb       column-label "Сумма уч.цен!без НДС"         format ">>>,>>>,>>9.99" space(0)
     1794       sym10                   column-label "|!|"                          format "X(1)"           space(0)
     1795       v-sum-cost-vat-not-rb   column-label "Сумма НДС! "                  format ">>,>>>,>>9.99"  space(0)
     1796       sym11                   column-label "|!|"                          format "X(1)"           space(0)
     1797       v-calories              column-label "Калории! "                    format ">>>>>>>9"       space(0)
     1798       sym12                   column-label "|!|"                          format "X(1)"           space(0)
     1799       v-protein               column-label "Белки! "                      format ">>>>>9.9"       space(0)
     1800       sym13                   column-label "|!|"                          format "X(1)"           space(0)
     1801       v-fat                   column-label "Жиры! "                       format ">>>>>9.9"       space(0)
     1802       sym14                   column-label "|!|"                          format "X(1)"           space(0)
     1803       v-carbohydrate          column-label "Углеводы! "                   format ">>>>>9.9"       space(0)
     1804       sym15                   column-label "|!|"                          format "X(1)"           space(0)
     1805   HEADER
     1806       cur-time-print() at 5  format "X(35)"
     1807              v-title at 45 format "X(60)"
     1808              string( "Страница " + string( PAGE-NUMBER( OutStream ), ">>9" ) ) at 114 format "X(14)"
     1809       skip v-prices-string at 5 format "X(30)"
     1810       skip v-line-string format  "X(162)" AT 1
     1811   with width 198 down stream-io NO-BOX.
     1812   do
     1813   on error undo, return error
     1814   :
     1815   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1816     run mainmenu_getcntxt in p-mainmenu-handle
     1817       (output v-cntxt-db-num
     1818       ,output v-cntxt-userid
     1819       ,output v-cntxt-level
     1820       ,output v-cntxt-host-code-obj
     1821       ,output v-cntxt-obj-type
     1822       ,output v-cntxt-obj-code
     1823       ,output v-cntxt-db-num-obj
     1824       ,output v-cntxt-is-admin
     1825       ) .
     1826   run get-report-num in p-mainmenu-handle (
     1827       output g#report-num
     1828   ).
     1829   run get-quest-print in p-mainmenu-handle (
     1830       output g#quest-print
     1831   ).
     1832   find first buf_fbr-doc no-lock
     1833        where recid( buf_fbr-doc ) = p-fbr-doc-recid
     1834   .
     1835   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1836   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
     1837     (output v-rb-is-base
     1838     )  .
     1839   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1840   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1841     (input  buf_fbr-doc.obj-type
     1842     ,input  buf_fbr-doc.obj-code
     1843     ,output v-host-code
     1844     )  .
     1845   if ( v-rb-is-base = no  and p-print-in-rubl = yes )
     1846   or ( v-rb-is-base = yes and p-print-in-rubl = no  )
     1847   then do:
     1848       assign
     1849           v-print-sale = yes
     1850       .
     1851   end.
     1852   else do:
     1853       assign
     1854           v-print-sale = no
     1855       .
     1856   end.
     1857   if ( p-print-in-rubl = no and p-fat = no )
     1858   then do:
     1859   output stream Outstream to value( string( session:temp-directory +
     1860                                        "rpt" + string( g#report-num ) ) )
     1861                                        page-size  value(62) .
     1862   end.
     1863   else do:
     1864   output stream Outstream to value( string( session:temp-directory +
     1865                                        "rpt" + string( g#report-num ) ) )
     1866                                        page-size  value(43) .
     1867   end.
     1868   if session :set-wait-state( "compiler" ) then.
     1869   if p-fat
     1870   THEN DO:
     1871      if v-print-sale = yes
     1872      then do:
     1873         assign
     1874            v-line-string = fill( "-", 198 )
     1875         .
     1876      end.
     1877      else do:
     1878         assign
     1879            v-line-string = fill( "-", 162 )
     1880         .
     1881      end.
     1882   END.
     1883   ELSE DO:
     1884      if v-print-sale = yes
     1885      then do:
     1886         assign
     1887            v-line-string = fill( "-", 163 )
     1888         .
     1889      end.
     1890      else do:
     1891         assign
     1892            v-line-string = fill( "-", 127 )
     1893         .
     1894      end.
     1895   END.
     1896   form header
     1897       v-line-string format "X(127)" at 1 skip
     1898       "Продолжение - на следующей странице" at 30
     1899   with frame Bottomframe width 136 page-bottom no-labels no-box .
     1900   view stream Outstream frame Bottomframe .
     1901   find first buf_trn-doc no-lock
     1902        where buf_trn-doc.out-code = buf_fbr-doc.doc-code
     1903   no-error.
     1904   assign
     1905       v-doc-code      = buf_fbr-doc.doc-code
     1906       v-doc-date      = ( if buf_fbr-doc.status_ = 'факт':U then buf_fbr-doc.fact-date else buf_fbr-doc.doc-date )
     1907       v-write-off-doc = (if buf_fbr-doc.status_ = 'факт':U then string( "(по накладной N " + buf_fbr-doc.doc-code + ")" ) else "" )
     1908       v-income-doc    = (if buf_fbr-doc.status_ = 'факт':U and available buf_trn-doc then string( "(по накладной N " + buf_trn-doc.doc-code + ")" ) else "" )
     1909   .
     1910   case buf_fbr-doc.doc-type:
     1911       when 'разделка':U
     1912       then do:
     1913               assign
     1914                   v-title = "Акт производства полуфабрикатов N: " + v-doc-code + " от " +  string( v-doc-date, "99/99/9999" )
     1915                   v-write-off-title = "Товары, списанные для производства"
     1916                   type-det = 'при':U
     1917               .
     1918       end.
     1919       when "Разукомплектация"
     1920       then do:
     1921               assign
     1922                   v-title = "Акт разукомплектации N: " + v-doc-code + " от " +  string( v-doc-date, "99/99/9999" )
     1923                   v-write-off-title = "Товары списанные"
     1924                   type-det = 'при':U
     1925               .
     1926       end.
     1927       when 'производство':U
     1928       then do:
     1929               assign
     1930                   v-title = "Акт производства готовой продукции N: " + v-doc-code + " от " +  string( v-doc-date, "99/99/9999" )
     1931                   v-write-off-title = "Товары, списанные для производства"
     1932                   type-det = 'спи':U
     1933               .
     1934       end.
     1935       when 'комплектация':U
     1936       then do:
     1937               assign
     1938                   v-title = "Акт комплектации N: " + v-doc-code + " от " +  string( v-doc-date, "99/99/9999" )
     1939                   v-write-off-title = "Товары списанные"
     1940                   type-det = 'спи':U
     1941               .
     1942       end.
     1943   end case.
     1944   assign
     1945       v-prices-string = "Цены указаны в " + ( if p-print-in-rubl = yes then "рублях" else "базовой валюте" )
     1946       v-income-title  = "Товары произведенные"
     1947   .
     1948   find first buf_clients no-lock
     1949        where buf_clients.obj-type = buf_fbr-doc.obj-type
     1950          and buf_clients.obj-code = buf_fbr-doc.obj-code
     1951   .
     1952   put stream Outstream
     1953       string( "Объект: (" + buf_fbr-doc.obj-type + " " + string(buf_fbr-doc.obj-code) + ") " + '"' + trim(buf_clients.obj-name) + '"' ) format "X(160)"
     1954       skip(2) space( 30 )
     1955           caps( v-title ) format "X(160)"
     1956       skip(2)
     1957           string( caps( v-write-off-title ) + " " + v-write-off-doc )         format "X(160)"
     1958       skip(1)
     1959   .
     1960   IF p-fat
     1961   THEN DO:
     1962      if v-print-sale = yes
     1963      then do:
     1964         form with frame fbr-in-rb-fat.
     1965      end.
     1966      else do:
     1967         form with frame fbr-not-in-rb-fat.
     1968      end.
     1969   END.
     1970   ELSE DO:
     1971      if v-print-sale = yes
     1972      then do:
     1973         form with frame fbr-in-rb.
     1974      end.
     1975      else do:
     1976         form with frame fbr-not-in-rb.
     1977      end.
     1978   END.
     1979   if p-print-details = yes
     1980   and type-det = 'спи':U
     1981   then do:
     1982       for each buf_fbr-line no-lock
     1983          where buf_fbr-line.doc-code = buf_fbr-doc.doc-code
     1984            and buf_fbr-line.trn-type = 'спи':U
     1985       break by buf_fbr-line.recipe-code
     1986       :
     1987           assign
     1988               v-counter = v-counter + 1
     1989           .
     1990           IF p-fat
     1991           THEN DO:
     1992               run nutro_get-nutrition-info in this-procedure ( input  buf_fbr-line.artic
     1993                                                              , input  buf_fbr-line.prod-type
     1994                                                              , input  buf_fbr-line.prod-code
     1995                                                              , input  v-cntxt-obj-type
     1996                                                              , input  v-cntxt-obj-code
     1997                                                              , output v-calories
     1998                                                              , output v-protein
     1999                                                              , output v-carbohydrate
     2000                                                              , output v-fat
     2001                                                              ).
     2002           END.
     2003           ELSE DO:
     2004               ASSIGN
     2005                 v-fat          = 0
     2006                 v-calories     = 0
     2007                 v-protein      = 0
     2008                 v-carbohydrate = 0
     2009               .
     2010           END.
     2011           run print-fbr-line in this-procedure (
     2012                 input recid( buf_fbr-line )
     2013               , input v-counter
     2014               , input p-print-in-rubl
     2015               , input buf_fbr-line.is-waste
     2016               , input buf_fbr-line.fact-qnty
     2017               , input ( if buf_fbr-line.is-waste = yes then 0 else buf_fbr-line.price-sum-rubl     )
     2018               , input ( if buf_fbr-line.is-waste = yes then 0 else buf_fbr-line.price-sum-base     )
     2019               , input ( if buf_fbr-line.is-waste = yes then 0 else buf_fbr-line.price-sum-vat-rubl )
     2020               , input ( if buf_fbr-line.is-waste = yes then 0 else buf_fbr-line.price-sum-vat-base )
     2021               , input ( if buf_fbr-line.price-sale = ? then 0 else buf_fbr-line.price-sale * buf_fbr-line.fact-qnty )
     2022               , input v-print-sale
     2023               , input v-fat
     2024               , input v-calories
     2025               , input v-protein
     2026               , input v-carbohydrate
     2027           ).
     2028           assign
     2029               v-tot-sum-write-off-cost-rubl      = v-tot-sum-write-off-cost-rubl    + ( if buf_fbr-line.is-waste = yes then 0 else buf_fbr-line.price-sum-rubl     )
     2030               v-tot-sum-write-off-cost-base      = v-tot-sum-write-off-cost-base    + ( if buf_fbr-line.is-waste = yes then 0 else buf_fbr-line.price-sum-base     )
     2031               v-tot-sum-write-off-costvat-rubl   = v-tot-sum-write-off-costvat-rubl + ( if buf_fbr-line.is-waste = yes then 0 else buf_fbr-line.price-sum-vat-rubl )
     2032               v-tot-sum-write-off-costvat-base   = v-tot-sum-write-off-costvat-base + ( if buf_fbr-line.is-waste = yes then 0 else buf_fbr-line.price-sum-vat-base )
     2033               v-tot-sum-write-off-price          = v-tot-sum-write-off-price        + ( if buf_fbr-line.price-sale = ? then 0 else buf_fbr-line.price-sale * buf_fbr-line.fact-qnty )
     2034           .
     2035       end.
     2036   end.
     2037   else do:
     2038       for each buf_fbr-line no-lock
     2039          where buf_fbr-line.doc-code = buf_fbr-doc.doc-code
     2040            and buf_fbr-line.trn-type = 'спи':U
     2041       break by string( buf_fbr-line.artic + buf_fbr-line.prod-type + string( buf_fbr-line.prod-code ) )
     2042       :
     2043           if first-of( string( buf_fbr-line.artic + buf_fbr-line.prod-type + string( buf_fbr-line.prod-code ) ) )
     2044           then do:
     2045               assign
     2046                   v-sum-qnty              = 0
     2047                   v-sum-cost-rb           = 0
     2048                   v-sum-cost-not-rb       = 0
     2049                   v-sum-cost-vat-rb       = 0
     2050                   v-sum-cost-vat-not-rb   = 0
     2051                   v-sum-sale              = 0
     2052               .
     2053           end.
     2054           assign
     2055               v-sum-qnty          = v-sum-qnty            + buf_fbr-line.fact-qnty
     2056               v-sum-cost-rb     = v-sum-cost-rb       + ( if buf_fbr-line.is-waste = yes then 0 else buf_fbr-line.price-sum-rubl     )
     2057               v-sum-cost-not-rb     = v-sum-cost-not-rb       + ( if buf_fbr-line.is-waste = yes then 0 else buf_fbr-line.price-sum-base     )
     2058               v-sum-cost-vat-rb = v-sum-cost-vat-rb   + ( if buf_fbr-line.is-waste = yes then 0 else buf_fbr-line.price-sum-vat-rubl )
     2059               v-sum-cost-vat-not-rb = v-sum-cost-vat-not-rb   + ( if buf_fbr-line.is-waste = yes then 0 else buf_fbr-line.price-sum-vat-base )
     2060               v-sum-sale          = v-sum-sale            + ( if buf_fbr-line.price-sale = ? then 0 else buf_fbr-line.price-sale * buf_fbr-line.fact-qnty )
     2061           .
