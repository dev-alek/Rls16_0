      113   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      114   procedure cur-time :
      115      define output parameter p-today as date      no-undo .
      116      define output parameter p-time  as integer   no-undo .
      117     do
      118     on error undo, return error
      119     :
      120       define variable v-date1 as date      no-undo .
      121       define variable v-date2 as date      no-undo .
      122       define variable v-time  as integer   no-undo .
      123       assign
      124         v-date1 = today
      125         v-time  = time
      126         v-date2 = today
      127       .
      128       if v-date1 <> v-date2
      129       then do:
      130         assign
      131           v-date1 = today
      132           v-time  = v-time
      133         .
      134       end.
      135       assign
      136         p-today = v-date1
      137         p-time  = v-time
      138       .
      139     end.
      140   end.
      141   function cur-time-date returns character
      142   :
      143     return string(today, '99/99/9999':U) .
      144   end.
      145   function cur-time-mjd returns decimal
      146   :
      147     define variable v-date as date      no-undo .
      148     define variable v-time as integer   no-undo .
      149     run cur-time in this-procedure
      150       (output v-date
      151       ,output v-time
      152       ) .
      153     return integer(v-date) - 2400002 + (v-time / 86400) .
      154   end.
      155   function cur-time-get-ending-index returns integer
      156   (input p-number as integer
      157   )
      158   :
      159     if p-number < 0
      160     or p-number = ?
      161     then do:
      162       return 1 .
      163     end.
      164     define variable v-rest as integer   no-undo .
      165     assign
      166       p-number = p-number modulo 100
      167     .
      168     if p-number < 20
      169     then do:
      170       assign
      171         v-rest = p-number
      172       .
      173     end.
      174     else do:
      175       assign
      176         v-rest = p-number modulo 10
      177       .
      178     end.
      179     case v-rest :
      180       when 1
      181       then do:
      182         return 2 .
      183       end.
      184       when 2 or
      185       when 3 or
      186       when 4
      187       then do:
      188         return 3 .
      189       end.
      190       otherwise do:
      191         return 1 .
      192       end.
      193     end case .
      194   end.
      195   procedure cur-time-mjd-to-date :
      196      define input  parameter i-mjd-diff as decimal no-undo.
      197      define output parameter o-Date     as date    no-undo.
      198      define output parameter o-Time     as integer no-undo.
      199      define variable v-day-number as integer   no-undo .
      200      if    i-mjd-diff < 0
      201         or i-mjd-diff = ?
      202      then do:
      203         return "?" .
      204      end.
      205      assign
      206         v-day-number = truncate(i-mjd-diff,0).
      207         o-Date = date(v-day-number + 2400002).
      208         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      209     .
      210   end.
      211   function cur-time-mjd-to-string returns character
      212   (input p-mjd-diff as decimal
      213   )
      214   :
      215     define variable v-day-number as integer   no-undo .
      216     define variable v-seconds    as integer   no-undo .
      217     define variable v-hour       as integer   no-undo .
      218     define variable v-min        as integer   no-undo .
      219     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      220     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      221     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      222     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      223     if p-mjd-diff < 0
      224     or p-mjd-diff = ?
      225     then do:
      226       return "?" .
      227     end.
      228     assign
      229       v-day-number = integer(truncate(p-mjd-diff,0))
      230       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      231     .
      232     if v-seconds > 86400
      233     then do:
      234       assign
      235         v-seconds = 86400 - 1
      236       .
      237     end.
      238     if v-seconds < 0
      239     then do:
      240       assign
      241         v-seconds = 0
      242       .
      243     end.
      244     assign
      245       v-hour = truncate(v-seconds / 3600, 0)
      246     .
      247     assign
      248       v-seconds = v-seconds modulo 3600
      249     .
      250     assign
      251       v-min = truncate(v-seconds / 60, 0)
      252     .
      253     assign
      254       v-seconds = v-seconds modulo 60
      255     .
      256     return
      257         (if v-day-number <> 0
      258           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      259           else ""
      260         )
      261       + (if v-day-number <> 0 or v-hour <> 0
      262           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      263           else ""
      264         )
      265       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      266           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      267           else ""
      268         )
      269       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      270       .
      271   end.
      272   function cur-time-string returns character
      273   :
      274     define variable v-date as date      no-undo .
      275     define variable v-time as integer   no-undo .
      276     run cur-time in this-procedure
      277       (output v-date
      278       ,output v-time
      279       ) .
      280     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      281   end.
      282   function cur-time-string-sec returns character
      283   :
      284     define variable v-date as date      no-undo .
      285     define variable v-time as integer   no-undo .
      286     run cur-time in this-procedure
      287       (output v-date
      288       ,output v-time
      289       ) .
      290     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      291   end.
      292   function cur-time-custom  returns character
      293   (input p-prefix as character
      294   ,input p-date-format as character
      295   ,input p-delimiter as character
      296   ,input p-time-format as character
      297   ,input p-suffix as character
      298   )
      299   :
      300     define variable v-date as date      no-undo .
      301     define variable v-time as integer   no-undo .
      302     run cur-time in this-procedure
      303       (output v-date
      304       ,output v-time
      305       ) .
      306     return
      307       p-prefix
      308       + string(v-date, p-date-format)
      309       + p-delimiter
      310       + string(v-time, p-time-format)
      311       + p-suffix
      312       .
      313   end.
      314   function cur-time-print  returns character
      315   :
      316     define variable v-date as date      no-undo .
      317     define variable v-time as integer   no-undo .
      318     run cur-time in this-procedure
      319       (output v-date
      320       ,output v-time
      321       ) .
      322     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      323   end.
      324   function cur-time-datetime returns datetime
      325   :
      326     define variable v-char as character no-undo .
      327     define variable v-datetime as datetime no-undo .
      328     v-char = cur-time-string().
      329     v-datetime = datetime(v-char).
      330     return  v-datetime.
      331   end.
      332   function cur-time-string-msec returns character
      333   :
      334     define variable v-date as datetime  no-undo .
      335     v-date = now.
      336     return string(v-date) .
      337   end.
      338   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      339   define variable v-waitfram-action01         as character   no-undo .
      340   define variable v-waitfram-action02         as character   no-undo .
      341   define variable v-waitfram-action03         as character   no-undo .
      342   define variable mWaitFramTextBeg            as character   no-undo.
      343   define variable mWaitFramTextEnd            as character   no-undo.
      344   define variable mWaitFramView               as logical     no-undo.
      345   define variable mWaitProcEvent              as logical     no-undo init yes.
      346   define variable mWaitFramInterval           as integer     no-undo init 1 .
      347   define variable mWaitFramStop               as logical     no-undo.
      348   define variable mWaitFramStopUser           as logical     no-undo.
      349   define variable mWaitFramStopTimeOut        as logical     no-undo.
      350   define variable mWaitFramStartProc          as datetime-tz no-undo.
      351   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      352   define button B-WaitFramStop auto-end-key
      353        label "Стоп"
      354        size 10 by 1 tooltip "Остоновить процесс".
      355   define button B-viewProcInfo
      356        label "Информация"
      357        size 15 by 1 tooltip "Информация о процесс".
      358   define frame waitfram
      359     v-waitfram-action01 format "x(72)" no-label skip
      360     v-waitfram-action02 format "x(72)" no-label skip
      361     v-waitfram-action03 format "x(72)" no-label skip
      362     B-viewProcInfo
      363     B-WaitFramStop at row 4 col 30
      364     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      365     .
      366   define new global shared variable mBatchMode as logical no-undo init ?.
      367   define variable mFramBachModHandle as handle no-undo.
      368   mFramBachModHandle = frame waitfram:handle.
      369   define variable mFameOldVis as logical no-undo.
      370   define variable mVisCUrentVin as logical no-undo.
      371   if session:batch-mode
      372   then
      373      mBatchMode = yes.
      374   if mBatchMode = ? then do:
      375     mVisCUrentVin = current-window:visible.
      376     mFameOldVis = mFramBachModHandle:visible.
      377     mFramBachModHandle:visible  = yes.
      378     mBatchMode = mFramBachModHandle:visible ne yes.
      379     mFramBachModHandle:visible = mFameOldVis.
      380     current-window:visible = mVisCUrentVin.
      381   end.
      382    if  log-manager:logfile-name ne ?
      383     then DO:
      384         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      385         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      386         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      387     end.
      388   on choose of B-WaitFramStop in frame waitfram
      389   do:
      390     mWaitFramStop = yes.
      391     mWaitFramStopUser = yes.
      392   end.
      393   function waitfram-check-timeout returns logical():
      394      define variable vtime as int64 no-undo.
      395      if mWaitFramStopTimeOut
      396      then
      397         return yes.
      398      vtime = ( now - mWaitFramStartProc ) / 1000 .
      399      if     mWaitFramTimeOut ne ?
      400         and mWaitFramTimeOut ne 0
      401         and mWaitFramTimeOut lt vtime
      402      then do:
      403         mWaitFramStopTimeOut = yes.
      404      end.
      405      return mWaitFramStopTimeOut.
      406   end.
      407   procedure waitfram-hide :
      408     if not session:batch-mode
      409     then do
      410     on error undo, return error return-value
      411     :
      412       pause 0 before-hide .
      413       if not mBatchMode then
      414         hide frame waitfram .
      415     if     not mWaitFramView
      416        and mWaitProcEvent
      417     then
      418       process events .
      419     end.
      420   end procedure.
      421   procedure waitfram-show :
      422     define input  parameter p-message as character no-undo .
      423     define variable v-left-margin as integer   no-undo .
      424     if not session:batch-mode
      425     then do
      426     on error undo, return error return-value
      427     :
      428       if length(p-message) <= 70 then do:
      429         assign
      430           v-left-margin = integer((70 - length(p-message)) / 2)
      431         .
      432         assign
      433           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      434         .
      435         assign
      436           v-waitfram-action01 = " "
      437           v-waitfram-action02 = " "
      438                                    + fill(" ", v-left-margin)
      439                                    + p-message
      440           v-waitfram-action03 = " "
      441         .
      442       end.
      443       else do:
      444         define variable vRindex1 as integer no-undo.
      445         define variable vRindex2 as integer no-undo.
      446         vRindex1 = r-index(p-message," ",70).
      447         if vRindex1 = 0
      448         then
      449            vRindex1 = 70.
      450         if length(p-message)  <= vRindex1 + 70 then do:
      451           assign
      452             v-waitfram-action01 = " "
      453             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      454             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      455           .
      456         end.
      457         else do:
      458           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      459           if vRindex2 <= vRindex1
      460           then
      461              vRindex2 = vRindex1 + 70.
      462           assign
      463             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      464             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      465             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      466           .
      467         end.
      468       end.
      469       B-viewProcInfo:visible   in frame waitfram = no.
      470       B-viewProcInfo:sensitive in frame waitfram = no.
      471       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      472       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      473       if  (   mWaitFramView
      474          or  mWaitProcEvent)
      475          and not mBatchMode
      476       then
      477          display
      478             v-waitfram-action01 skip
      479             v-waitfram-action02 skip
      480             v-waitfram-action03 skip
      481          with frame waitfram .
      482       if     mWaitFramView
      483          then do:
      484             if     mWaitFramInterval ne ?
      485                and not mBatchMode
      486             then
      487                wait-for go of frame waitfram pause mWaitFramInterval.
      488          end.
      489          else
      490             if     mWaitProcEvent
      491                and not mBatchMode
      492             then
      493                process events .
      494     end.
      495   end procedure.
      496      procedure waitfram-show-this:
      497         define input  parameter iInterval as int64 no-undo.
      498         define variable vtime as int64 no-undo.
      499         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      500         mWaitFramInterval = iInterval.
      501         run waitfram-show (substitute("&1&2 &3&4" ,
      502                                       mWaitFramTextBeg ,
      503                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      504                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      505                                       mWaitFramTextEnd
      506                                      )
      507                           ).
      508      end.
      509      procedure WaitFramRunPause:
      510         define input  parameter iInterval as dec no-undo.
      511         define variable vStart  as datetime-tz no-undo.
      512         define variable vend    as datetime-tz no-undo.
      513         define variable vint as int64 no-undo.
      514         define variable vOk as logical no-undo.
      515         vStart = now.
      516         vend   = vStart.
      517         publish "WaitFramPause" (iInterval,output vOk).
      518         vend   =  now.
      519         vint = vend - vStart.
      520         vint = iInterval - vint / 1000.
      521         if     not mWaitFramStop
      522            and (   vint > 0
      523                 or (    not vOk
      524                     and iInterval eq ?
      525                     )
      526                 )
      527         then
      528            run waitfram-show-this (iInterval).
      529         vend   =  now.
      530         vint = vend - vStart.
      531         vint = iInterval - vint / 1000.
      532         if     not mWaitFramStop
      533            and vint > 0
      534         then do:
      535            run gbl/pause.p (vint * 1000).
      536         end.
      537         if iInterval ne ?
      538         then
      539            publish "WaitFramStop".
      540         waitfram-check-timeout().
      541      end.
      542      procedure WaitFramWaitFor:
      543         define input  parameter iInterval as dec no-undo.
      544         assign
      545            mWaitFramStartProc   = now
      546            mWaitFramStopUser    = no
      547            mWaitFramStopTimeOut = no
      548         .
      549         block-wait:
      550         do while not mWaitFramStop:
      551            run WaitFramRunPause (iInterval).
      552            if  waitfram-check-timeout()
      553            then do:
      554               leave block-wait.
      555            end.
      556         end.
      557         run waitfram-hide.
      558      end.
      559   procedure waitfram-join :
      560     define input  parameter p-line-1  as character no-undo .
      561     define input  parameter p-line-2  as character no-undo .
      562     define input  parameter p-line-3  as character no-undo .
      563     define output parameter p-message as character no-undo .
      564     do
      565     on error undo, return error return-value
      566     :
      567       assign
      568         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      569                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      570                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      571       .
      572     end.
      573   end procedure.
      574   function waitfram-join-function returns character
      575     (input p-line-1 as character
      576     ,input p-line-2 as character
      577     ,input p-line-3 as character
      578     ).
      579     define variable v-message as character no-undo .
      580     run waitfram-join in this-procedure
      581       (input  p-line-1
      582       ,input  p-line-2
      583       ,input  p-line-3
      584       ,output v-message
      585       ) .
      586     return v-message .
      587   end function .
      588   define input parameter p-mainmenu-handle    as handle           no-undo.
      589   define input parameter p-recid              as recid            no-undo.
      590   def stream repstr .
      591   def var v-ind         as integer   no-undo .
