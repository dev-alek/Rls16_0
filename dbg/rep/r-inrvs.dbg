      725   ASSIGN v-curr-abbr = ub.currency.curr-abbr.
      726   find first bef-rvs-doc where bef-rvs-doc.out-code = ub.trn-doc.doc-code and
      727                                bef-rvs-doc.rvs-type = 'перед_док':U    no-lock no-error.
      728   ASSIGN v-bef-rvs = if available bef-rvs-doc then string(bef-rvs-doc.rvs-code) else "сверка не производилась".
      729   find first aft-rvs-doc where aft-rvs-doc.out-code = ub.trn-doc.doc-code and
      730                                aft-rvs-doc.rvs-type = 'после_док':U     no-lock no-error.
      731   ASSIGN v-aft-rvs = if available aft-rvs-doc then string(aft-rvs-doc.rvs-code) else "сверка не производилась".
      732   define frame doc-line-frm
      733     sym1  space(0) ub.goods.artic             format "x(7)" column-label "1" space(0)
      734     sym2  space(0) ub.goods.gds-name          format "x(35)" column-label "2" space(0)
      735     sym3  space(0) varpl-qnty              format ">>>,>>9.<<<" column-label "3" space(0)
      736     sym4  space(0) ub.doc-line.fact-density   format ">.9999" column-label "4" space(0)
      737     sym5  space(0) varpl-cli-qnty          format ">>>,>>9.<<<" column-label "5" space(0)
      738     sym6  space(0) varpl-fact-qnty         format ">>>,>>9.<<<" column-label "6" space(0)
      739     sym7  space(0) varpl-state-qnty        format ">>>,>>9.<<<" column-label "7" space(0)
      740     sym8  space(0) varpl-acc-prc-cur-cli   format "->>,>>9.99" column-label "8" space(0)
      741     sym9  space(0) varpl-acc-sum-cur-cli   format "->,>>>,>>9.99" column-label "9=6*8" space(0)
      742     sym10 space(0) varpl-sale-prc-cur-base format "->>,>>9.99" column-label "10" space(0)
      743     sym11 space(0) varpl-sale-sum-cur-base format "->,>>>,>>9.99" column-label "11=10*6" space(0)
      744     sym12 space(0) varpl-acc-prc-cur-base  format "->>,>>9.99" column-label "12" space(0)
      745     sym13 space(0) varpl-acc-sum-cur-base  format "->,>>>,>>9.99" column-label "13=12*6" space(0)
      746     sym14 space(0) varpl-num               format " 999999999" column-label "14" space(0)
      747     sym15 space(0) varcar-num              format "X(8)" column-label "15" space(0)
      748     sym16 space(0) varcar-volume           format "X(11)" column-label "16" space(0)
      749     sym17 space(0)
      750     with width 197  stream-io use-text .
      751   form with frame doc-line-frm .
      752       define variable v-oper-name    as character    no-undo.
      753   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      754   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrnick in g#library
      755     (input  ub.trn-doc.creid
      756     ,output v-oper-name
      757     )  .
      758   put stream repstr unformatted
      759     string(v-host-name + fill(" ", 40), "x(40)")  v-host-city skip
      760     "--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------"  v-print-time skip
      761     "   Номер смены "  ub.trn-doc.shift-name  "    Дата начала смены "  ub.trn-doc.shift-date skip
      762     "                                 П Р И Х О Д Н А Я  Н А К Л А Д Н А Я  П О  Т О П Л И В У  № "  ub.trn-doc.doc-code skip
      763     "   АЗС: "  v-obj-name  "    Оператор: "  v-oper-name skip
      764     "   Поставщик: "  v-cli-name skip
