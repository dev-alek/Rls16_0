      711   find first ub.clients no-lock
      712     where ub.clients.obj-type = 'орг':U
      713       and ub.clients.obj-code = ub.trn-doc.host-code
      714     .
      715   assign
      716     v-host-name = ub.clients.obj-name
      717   .
      718   find first ub.firm no-lock
      719     where ub.firm.firm-code = ub.clients.obj-code
      720     .
