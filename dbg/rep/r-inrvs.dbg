      766     "   По документу: "  ub.trn-doc.doc-code   " от "  string( if ub.trn-doc.fact-date <> ? then ub.trn-doc.fact-date else ub.trn-doc.doc-date )
      767     " г.          Валюта: "  v-curr-abbr " Курс: " ub.trn-doc.exch-rate " Шкала: " ub.trn-doc.exch-scale skip
      768     "   Номер протокол измерений до слива: " v-bef-rvs "      Номер протокола после слива и стабилизации: " v-aft-rvs skip
      769     .
      770   put stream repstr unformatted
      771     v-line skip
      772     STRING("!       ", "X(8)") STRING("!                                   ", "X(36)") STRING("!        ", "X(9)") STRING("! Плот ", "X(7)") STRING("!        ", "X(9)") STRING("! Фактич.", "X(9)") STRING("!Фактич. ", "X(9)") STRING("!  Учетная ", "X(11)") STRING("!  Сумма по   ", "X(14)") STRING("! Розничная", "X(11)") STRING("!  Сумма по   ", "X(14)") STRING("!  Учетная ", "X(11)") STRING("!  Сумма по   ", "X(14)") STRING("!          ", "X(11)") STRING("! Гос    ", "X(9)") STRING("!           !", "X(13)") skip
      773     STRING("!       ", "X(8)") STRING("!                                   ", "X(36)") STRING("!Объем по", "X(9)") STRING("!ность ", "X(7)") STRING("!Кол-во  ", "X(9)") STRING("! кол-во ", "X(9)") STRING("!объем по", "X(9)") STRING("!    цена  ", "X(11)") STRING("!  учет. цене ", "X(14)") STRING("!   цена в ", "X(11)") STRING("!  розн. цене ", "X(14)") STRING("!   цена в ", "X(11)") STRING("!  учет. цене ", "X(14)") STRING("!  Номер   ", "X(11)") STRING("! номер  ", "X(9)") STRING("!   Объем   !", "X(13)") skip
      774     STRING("!Артикул", "X(8)") STRING("!            Наименование           ", "X(36)") STRING("!ТТН в л.", "X(9)") STRING("!поТТН ", "X(7)") STRING("! по ТТН ", "X(9)") STRING("! принят.", "X(9)") STRING("!счетчику", "X(9)") STRING("!  в валюте", "X(11)") STRING("!  в валюте   ", "X(14)") STRING("!  базовой ", "X(11)") STRING("!  в базовой  ", "X(14)") STRING("!  базовой ", "X(11)") STRING("!  в базовой  ", "X(14)") STRING("!резервуара", "X(11)") STRING("! авто   ", "X(9)") STRING("!  цистерны !", "X(13)") skip
      775     STRING("!       ", "X(8)") STRING("!                                   ", "X(36)") STRING("!        ", "X(9)") STRING("! куб  ", "X(7)") STRING("!  в кг  ", "X(9)") STRING("!топлива ", "X(9)") STRING("!в литрах", "X(9)") STRING("! накладной", "X(11)") STRING("!  накладной  ", "X(14)") STRING("!   валюте ", "X(11)") STRING("!   валюте    ", "X(14)") STRING("!   валюте ", "X(11)") STRING("!   валюте    ", "X(14)") STRING("!          ", "X(11)") STRING("!цистерны", "X(9)") STRING("!           !", "X(13)") skip
      776     STRING("!       ", "X(8)") STRING("!                                   ", "X(36)") STRING("!        ", "X(9)") STRING("! см   ", "X(7)") STRING("!        ", "X(9)") STRING("!в литрах", "X(9)") STRING("!        ", "X(9)") STRING("!          ", "X(11)") STRING("!             ", "X(14)") STRING("!          ", "X(11)") STRING("!             ", "X(14)") STRING("!          ", "X(11)") STRING("!             ", "X(14)") STRING("!          ", "X(11)") STRING("!        ", "X(9)") STRING("!           !", "X(13)") skip
      777     v-line
      778     .
      779   form header
      780     v-line1 at 1 skip
      781     v-header-name format "x(50)" at 1
      782       "Дата:" at 60
      783       v-print-time format "x(20)"
      784       "Стр." at 169 string( page-number(repstr), ">>>9" )  skip
      785     v-line2 at 1 skip
      786     with frame topframe
      787     width 197 page-top no-labels no-box .
      788   view stream repstr frame topframe .
      789   form header
      790     v-line skip
      791     "Продолжение на следующей странице " at 30 skip
      792     with frame bottomframe
      793     width 197 page-bottom no-labels no-box .
      794   view stream repstr frame bottomframe .
      795   for each ub.doc-line
      796     where ub.doc-line.doc-code = ub.trn-doc.doc-code no-lock,
      797     first ub.goods where ub.goods.artic     = ub.doc-line.artic     and
      798                       ub.goods.prod-type = ub.doc-line.prod-type and
      799                       ub.goods.prod-code = ub.doc-line.prod-code no-lock,
      800     each ub.parts where ub.parts.out-code  = ub.doc-line.doc-code  and
      801                      ub.parts.obj-type  = ub.doc-line.obj-type  and
      802                      ub.parts.obj-code  = ub.doc-line.obj-code  and
      803                      ub.parts.artic     = ub.doc-line.artic     and
      804                      ub.parts.prod-type = ub.doc-line.prod-type and
      805                      ub.parts.prod-code = ub.doc-line.prod-code no-lock
      806    break by ub.parts.artic
      807          by ub.parts.prod-type
      808          by ub.parts.prod-code
      809          by ub.parts.pl-code
      810   :
      811     if first-of(ub.parts.prod-code) then do:
      812        find first ub.doc-attr where ub.doc-attr.doc-code  = ub.doc-line.doc-code and
      813                                     ub.doc-attr.attr-code = 'car-num':U no-lock no-error.
      814        ASSIGN
      815        varcar-num    = if available ub.doc-attr then ub.doc-attr.attr-value else "".
      816        find first ub.doc-line-attr where ub.doc-line-attr.doc-code  = ub.doc-line.doc-code and
      817                                       ub.doc-line-attr.gds-code  = ub.goods.gds-code    and
      818                                       ub.doc-line-attr.attr-code = "car-vol" no-lock no-error.
      819        ASSIGN
      820        varcar-volume = if available ub.doc-line-attr then ub.doc-line-attr.attr-value else "".
      821        for each ub.gds-dtl where ub.gds-dtl.doc-code  = ub.doc-line.doc-code  and
      822                               ub.gds-dtl.artic     = ub.doc-line.artic     and
      823                               ub.gds-dtl.prod-type = ub.doc-line.prod-type and
      824                               ub.gds-dtl.prod-code = ub.doc-line.prod-code no-lock :
      825           accumulate ub.gds-dtl.cur-base * ub.gds-dtl.fact-qnty (total)
      826                      ub.gds-dtl.fact-qnty (total).
      827        end.
      828        ASSIGN varpl-sale-prc-cur-base = (accum total ub.gds-dtl.cur-base * ub.gds-dtl.fact-qnty) / (accum total ub.gds-dtl.fact-qnty).
      829     end.
      830     assign
      831       v-ind = v-ind + 1
      832     .
      833     process events .
      834     run waitfram-show in this-procedure
      835       (input "Печать приходной накладной. Обработано строк: " + string(v-ind)
      836       ) .
      837   assign
      838     price-rubl-with-tax-loc = ub.parts.price-rubl
      839     price-base-with-tax-loc = ub.parts.price-base
      840   .
      841   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      842   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      843     (output varinvprb
      844     )  .
      845     if ub.parts.out-code = 'free-zone':U     or
      846        ub.parts.out-code = 'out-zone':U   or
      847        ub.parts.doc-type = 'акт':U then do:
      848       assign
      849         in-vatp-have-vat-slt = yes.
      850     end.
      851     else do:
      852       find first in-vatp_doc-attr no-lock
      853         where in-vatp_doc-attr.doc-code  = ub.parts.out-code
      854           and in-vatp_doc-attr.attr-code = 'envd':U
      855         no-error .
      856       if not available in-vatp_doc-attr then do:
      857         assign
      858           in-vatp-have-vat-slt = yes.
      859       end.
      860       else do:
      861            in-vatp-have-vat-slt = no.
      862       end.
      863     end.
      864     assign
      865      price-cli-with-tax-loc = ub.parts.price-cli
      866      cli-base-rate          = ub.parts.cli-base-rate.
      867     ASSIGN   road-tax-base-loc  = (if ub.parts.road-tax-base  = ? then 0 else ub.parts.road-tax-base)
      868              road-tax-rubl-loc  = (if ub.parts.road-tax-rubl  = ? then 0 else ub.parts.road-tax-rubl).
      869     ASSIGN  transport-base-loc = (if ub.parts.transport-base = ? then 0 else ub.parts.transport-base)
      870             transport-rubl-loc = (if ub.parts.transport-rubl = ? then 0 else ub.parts.transport-rubl)
      871             other-base-loc     = (if ub.parts.other-base     = ? then 0 else ub.parts.other-base)
      872             other-rubl-loc     = (if ub.parts.other-rubl     = ? then 0 else ub.parts.other-rubl)
      873             vat-pc-loc         = (if ub.parts.vat-pc         = ? then 0 else ub.parts.vat-pc)
      874             slt-pc-loc         = (if ub.parts.slt-pc         = ? then 0 else ub.parts.slt-pc).
      875             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      876       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      877     assign
      878       exch-rate-cli-loc = (ub.parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if ub.parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if ub.parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / ub.parts.price-cli .
      879     assign
      880       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
      881       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
      882       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
      883       transport-cli-loc  = 0
      884       other-cli-loc      = 0
      885     .
      886   ASSIGN
      887             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
      888       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
      889   .
      890     ACCUMULATE slt-base-loc * ub.parts.fact-qnty (TOTAL)
      891                vat-base-loc * ub.parts.fact-qnty (TOTAL).
      892     ACCUMULATE
      893     ub.parts.qnty                           (TOTAL BY ub.parts.pl-code)
      894     ub.parts.cli-qnty                       (TOTAL BY ub.parts.pl-code)
      895     ub.parts.fact-qnty                      (TOTAL BY ub.parts.pl-code)
      896     .
      897     if last-of(ub.parts.pl-code) then do:
      898        if available bef-rvs-doc and
      899           available aft-rvs-doc then do:
      900           find first bef-rvs-line where bef-rvs-line.rvs-code = bef-rvs-doc.rvs-code and
      901                                         bef-rvs-line.obj-type = bef-rvs-doc.obj-type and
      902                                         bef-rvs-line.obj-code = bef-rvs-doc.obj-code and
      903                                         bef-rvs-line.pl-code  = ub.parts.pl-code        and
      904                                         bef-rvs-line.gds-code = ub.goods.gds-code       no-lock.
      905           find first aft-rvs-line where aft-rvs-line.rvs-code = aft-rvs-doc.rvs-code and
      906                                         aft-rvs-line.obj-type = aft-rvs-doc.obj-type and
      907                                         aft-rvs-line.obj-code = aft-rvs-doc.obj-code and
      908                                         aft-rvs-line.pl-code  = ub.parts.pl-code        and
      909                                         aft-rvs-line.gds-code = ub.goods.gds-code       no-lock.
      910        end.
      911        ASSIGN
      912          varpl-qnty              = (ACCUM TOTAL BY ub.parts.pl-code ub.parts.qnty)
      913          varpl-cli-qnty          = (ACCUM TOTAL BY ub.parts.pl-code ub.parts.cli-qnty)
      914          varpl-fact-qnty         = (ACCUM TOTAL BY ub.parts.pl-code ub.parts.fact-qnty)
      915          varpl-state-qnty        = (if available bef-rvs-doc and available aft-rvs-doc then aft-rvs-line.state-measure-qnty - bef-rvs-line.state-measure-qnty else ?)
      916          varpl-acc-prc-cur-cli   = ub.doc-line.price-rubl / ub.trn-doc.exch-rate * ub.trn-doc.exch-scale
      917          varpl-acc-sum-cur-cli   = varpl-acc-prc-cur-cli   * varpl-fact-qnty
      918          varpl-sale-sum-cur-base = varpl-sale-prc-cur-base * varpl-fact-qnty
      919          varpl-acc-prc-cur-base  = ub.doc-line.price-base
      920          varpl-acc-sum-cur-base  = varpl-acc-prc-cur-base * varpl-fact-qnty
      921          varpl-num               = ub.parts.pl-code.
      922      ASSIGN
      923       varpl-acc-sum-cur-cli-doc   = varpl-acc-prc-cur-cli   * varpl-qnty
      924       varpl-sale-sum-cur-base-doc = varpl-sale-prc-cur-base * varpl-qnty
      925       varpl-acc-sum-cur-base-doc  = varpl-acc-prc-cur-base  * varpl-qnty.
      926      ACCUMULATE varpl-acc-sum-cur-cli        (TOTAL)
      927                 varpl-sale-sum-cur-base      (TOTAL)
      928                 varpl-acc-sum-cur-base       (TOTAL)
      929                 varpl-acc-sum-cur-cli-doc    (TOTAL)
      930                 varpl-sale-sum-cur-base-doc  (TOTAL)
      931                 varpl-acc-sum-cur-base-doc   (TOTAL).
      932       display stream repstr
      933         sym1  ub.goods.artic
      934         sym2  ub.goods.gds-name
      935         sym3  varpl-qnty
      936         sym4  ub.doc-line.fact-density
      937         sym5  varpl-cli-qnty
      938         sym6  varpl-state-qnty
      939         sym7  varpl-fact-qnty
      940         sym8  varpl-acc-prc-cur-cli
      941         sym9  varpl-acc-sum-cur-cli
      942         sym10 varpl-sale-prc-cur-base
      943         sym11 varpl-sale-sum-cur-base
      944         sym12 varpl-acc-prc-cur-base
      945         sym13 varpl-acc-sum-cur-base
      946         sym14 varpl-num
      947         sym15 varcar-num
      948         sym16 varcar-volume
      949         sym17
      950         with frame doc-line-frm 0 down.
      951         down stream repstr 1 with frame doc-line-frm.
      952     end.
      953   end.
      954   put stream repstr
      955     v-line  skip
      956     .
      957   hide frame input-frm .
      958   put stream repstr
      959     skip
      960     "   П О  Ф А К Т У:                                                               П О  Т Т Н :" skip
      961     "   Итого в валюте накладной по учетной цене " (ACCUM TOTAL varpl-acc-sum-cur-cli)    format ">>,>>>,>>9.99" "                           Итого в валюте накладной по учетной цене" (ACCUM TOTAL varpl-acc-sum-cur-cli-doc)   format ">>,>>>,>>9.99" skip
      962     "   Итого в базовой валюте по учетной цене   " (ACCUM TOTAL varpl-acc-sum-cur-base)   format ">>,>>>,>>9.99" "                           Итого в базовой валюте по учетной цене  " (ACCUM TOTAL varpl-acc-sum-cur-base-doc)  format ">>,>>>,>>9.99" skip
      963     "   Итого в базовой валюте по розничной цене " (ACCUM TOTAL varpl-sale-sum-cur-base)  format ">>,>>>,>>9.99" "                           Итого в базовой валюте по розничной цене" (ACCUM TOTAL varpl-sale-sum-cur-base-doc) format ">>,>>>,>>9.99" skip
      964     "   В том числе в базовой валюте по учетной цене:" skip
      965     "          НДС                                " (ACCUM TOTAL vat-base-loc * ub.parts.fact-qnty) format ">>,>>>,>>9.99" skip
      966     "          Без НДС                            " (ACCUM TOTAL varpl-acc-sum-cur-base) - (ACCUM TOTAL vat-base-loc * ub.parts.fact-qnty) format ">>,>>>,>>9.99" skip
      967     "          НсП                                " (ACCUM TOTAL slt-base-loc * ub.parts.fact-qnty) format ">>,>>>,>>9.99" skip
      968     "          ГСМ                                "
      969     .
      970   put stream repstr
      971     skip(2)
      972     .
      973   put stream repstr unformatted
      974     "   Топливо сдал ___________________________                                          Топливо принял _________________________ "
      975     .
      976   hide stream repstr frame bottomframe .
      977   output stream repstr close.
      978   run waitfram-hide in this-procedure .
      979   if g#quest-print = false
      980   then do:
      981     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
      982                                         7, (if 8 >= 8 then 2 else 0), 0, 0,
      983                                         OUTPUT g#log ).
      984   end.
      985   else do:
      986     os-command silent
      987       value( "COPY /b " +
      988         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
      989         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
      990         string( session:temp-directory) +  "$" + string( g#report-num )
      991                 ) .
      992     os-command silent
      993       value( "COPY /b " +
      994         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
      995         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
      996         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
      997                 ) .
      998   end.
