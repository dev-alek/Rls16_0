      665   def var v-host-name   as character no-undo.
      666   def var v-host-city   as character no-undo.
      667   def var v-obj-name    as character no-undo.
      668   def var v-cli-name    as character no-undo.
      669   def var v-cli-city    as character no-undo.
      670   def var v-header-name as character no-undo.
      671   def var v-print-time  as character no-undo.
      672   def var v-curr-abbr   as character no-undo.
      673   def var v-bef-rvs     as character no-undo.
      674   def var v-aft-rvs     as character no-undo.
      675   assign
      676     v-header-name = "П Р И Х О Д Н А Я  Н А К Л А Д Н А Я  П О  Т О П Л И В У  № " + ub.trn-doc.doc-code
      677     v-print-time  = cur-time-string()
      678   .
      679   find first ub.clients no-lock
      680     where ub.clients.obj-type = ub.trn-doc.obj-type
      681       and ub.clients.obj-code = ub.trn-doc.obj-code
      682     .
      683   assign
