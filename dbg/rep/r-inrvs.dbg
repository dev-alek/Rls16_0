      597   def var v-line2        as character no-undo format "X(195)" .
      598   def var v-line3        as character no-undo format "X(195)" .
      599   assign
      600     v-line1 = v-line
      601     v-line2 = v-line
      602     v-line3 = v-line
      603   .
