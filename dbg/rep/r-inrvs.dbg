       80       define buffer   in-vatp-doc      for ub.trn-doc .
       81       define buffer   in-vatp-goods    for ub.goods   .
       82       define buffer   in-vatp-sysconf  for ub.sysconf .
       83       define buffer   in-vatp_doc-attr for ub.doc-attr.
       84       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
       85       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
       86       define variable varinvprb                  as   character              no-undo.
       87       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
       88       define variable cli-base-rate              as   decimal                no-undo.
       89       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
       90       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
       91       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
       92       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
       93       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
       94       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
       95       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
       96       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
       97       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
       98       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
       99       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
      100       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
      101       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
      102       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
