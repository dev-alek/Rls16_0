      685   .
      686   find first ub.clients no-lock
      687     where ub.clients.obj-type = ub.trn-doc.cli-type
      688       and ub.clients.obj-code = ub.trn-doc.cli-code
      689     .
      690   assign
      691     v-cli-name = ub.clients.obj-name
      692   .
      693   case ub.clients.obj-type :
      694     when 'орг':U then do:
      695       find first ub.firm no-lock
      696         where ub.firm.firm-code = ub.clients.obj-code
      697         .
      698       assign
      699         v-cli-city = ub.firm.city
      700       .
      701     end.
      702     when 'чел':U then do:
      703       find first ub.person no-lock
      704         where ub.person.psn-code = ub.clients.obj-code
      705         .
      706       assign
      707         v-cli-city = ub.person.city
      708       .
      709     end.
