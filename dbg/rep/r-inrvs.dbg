      104       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
      105       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
      106       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
      107       define variable other-base-loc             like ub.doc-line.price-base no-undo.
      108       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
      109       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
      110       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
