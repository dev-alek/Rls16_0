      578   define new global shared variable g#library  as handle no-undo .
      579   define new global shared variable g#library2 as handle no-undo .
      580   function ChkGdsPromo returns logical
      581       (input iDocCode as character)
      582       :
      583       define buffer buf_chk-gds for ub.chk-gds.
      584       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      585       define variable vPromo as logical no-undo.
      586       vPromo = no.
      587       cspr:
      588       for each buf_chk-gds no-lock where
      589                    buf_chk-gds.doc-code = iDocCode,
      590              first buf_chk-gds-attr no-lock where
      591                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
      592                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
      593                and buf_chk-gds-attr.attr-code = "CSPromo"
      594                and buf_chk-gds-attr.attr-value <> "0":
      595          vPromo = yes.
      596          leave cspr.
      597       end.
      598       return vPromo.
      599   end.
      600   function ChkPromoLine returns logical
      601       (input iDocCode as character,
      602       input iLineNum as integer)
      603       :
      604       define buffer buf_chk-gds for ub.chk-gds.
      605       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      606       define variable vPromo as logical no-undo.
      607       vPromo = no.
      608       find first buf_chk-gds-attr no-lock where
      609                    buf_chk-gds-attr.doc-code = iDocCode
      610                and buf_chk-gds-attr.line-num  = iLineNum
      611                and buf_chk-gds-attr.attr-code = "CSPromo"
      612                and buf_chk-gds-attr.attr-value <> "0"
      613       no-error.
      614       if avail buf_chk-gds-attr then vPromo = yes.
      615       return vPromo.
      616   end.
      617   function ChkPromoSum returns decimal
      618       (input iDocCode as character,
      619        input iLineNum as integer)
      620       :
      621      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      622      define variable vSumPromo as decimal no-undo.
      623      find first buf_chk-gds-attr no-lock where
      624                 buf_chk-gds-attr.doc-code = iDocCode
      625             and buf_chk-gds-attr.line-num  = iLineNum
      626             and buf_chk-gds-attr.attr-code = "CSPromoSum"
      627         no-error.
      628      if avail buf_chk-gds-attr then
      629         vSumPromo = DEC(buf_chk-gds-attr.attr-value) no-error.
      630      return vSumPromo.
      631   end function.
      632   function ChkPromoPrice returns logical
      633       (input iDocCode as character,
      634        input iLineNum as integer)
      635       :
      636      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      637      define variable v-is-promo as logical no-undo.
      638      v-is-promo = no.
      639      find first buf_chk-gds-attr no-lock where
      640                 buf_chk-gds-attr.doc-code = iDocCode
      641             and buf_chk-gds-attr.line-num  = iLineNum
      642             and buf_chk-gds-attr.attr-code = "CSPromo"
      643         no-error.
      644      if avail buf_chk-gds-attr
      645        and can-do("2,4,5,7", buf_chk-gds-attr.attr-value)
      646      then v-is-promo = yes.
      647      return v-is-promo.
      648   end function.
      649   function ChkDopLitr returns logical
      650       (input iDocCode as character,
      651        input iLineNum as integer)
      652       :
      653      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      654      define variable v-is-promo as logical no-undo.
      655      v-is-promo = no.
      656      find first buf_chk-gds-attr no-lock where
      657                 buf_chk-gds-attr.doc-code = iDocCode
      658             and buf_chk-gds-attr.line-num  = iLineNum
      659             and buf_chk-gds-attr.attr-code = "CSPromo"
      660         no-error.
      661      if avail buf_chk-gds-attr and
      662        buf_chk-gds-attr.attr-value = "3"
      663      then v-is-promo = yes.
      664      return v-is-promo.
      665   end function.
      666   function RoundUp return decimal
      667       (input iQnty as decimal,
      668        input iPrice as decimal):
      669       def var vSum  as decimal no-undo.
      670       def var vSumR as decimal no-undo.
      671       vSum = ABSOLUTE(iQnty) * iPrice.
      672       vSumR = Round(vSum,2).
      673       if vSumR < vSum then vSumR = vSumR + 0.01.
      674       if iQnty < 0 then vSumR = - vSumR.
      675       return vSumR.
      676   end function.
      677   function GetPromoSum returns decimal
      678       (input iDocCode as character)
      679       :
      680       define buffer buf_chk-doc for ub.chk-doc.
      681       define buffer buf2_chk-doc for ub.chk-doc.
      682       define buffer buf_chk-gds for ub.chk-gds.
      683       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      684       define buffer buf2_chk-gds for ub.chk-gds.
      685       define buffer buf2_chk-gds-attr for ub.chk-gds-attr.
      686       define variable v-price-base as decimal no-undo.
      687       define variable v-doc-qnty as decimal no-undo.
      688       define variable v-sum-base as decimal no-undo.
      689       define variable v-sum-all as decimal no-undo.
      690       define variable v-sum-promo as decimal no-undo.
      691       define variable v-sum-chk as decimal no-undo.
      692       assign
      693          v-price-base = 0
      694          v-doc-qnty = 0
      695          v-sum-all = 0
      696          v-sum-chk = 0
      697          v-sum-promo = 0
      698          .
      699       for each buf_chk-gds no-lock where
      700                buf_chk-gds.doc-code = iDocCode,
      701          first buf_chk-gds-attr no-lock where
      702                buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
      703            and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
      704            and buf_chk-gds-attr.attr-code = "CSPromoSum"
      705          :
      706          v-sum-promo = Dec(buf_chk-gds-attr.attr-value).
      707       end.
      708       if v-sum-promo = 0 then do:
      709           for each buf_chk-gds no-lock where
      710                    buf_chk-gds.doc-code = iDocCode,
      711              first buf_chk-gds-attr no-lock where
      712                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
      713                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
      714                and buf_chk-gds-attr.attr-code = "CSPromo"
      715                and can-do("1,6", buf_chk-gds-attr.attr-value)
      716              :
      717              assign
      718                v-price-base = buf_chk-gds.price-base
      719                v-doc-qnty   = if buf_chk-gds.doc-qnty = ? then buf_chk-gds.src-qnty else buf_chk-gds.doc-qnty
      720                v-sum-base = if buf_chk-gds.sum-base = ? then round(v-doc-qnty * v-price-base, 2) else buf_chk-gds.sum-base
      721                .
      722           end.
      723           for each buf_chk-gds no-lock where
      724                    buf_chk-gds.doc-code = iDocCode,
      725              first buf_chk-gds-attr no-lock where
      726                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
      727                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
      728                and buf_chk-gds-attr.attr-code = "CSPromo"
      729                and can-do("2,4,5,7", buf_chk-gds-attr.attr-value)
      730              :
      731              if v-price-base = 0 then do:
      732                 find first buf_chk-doc no-lock where
      733                            buf_chk-doc.doc-code = iDocCode
      734                     no-error.
      735                 if avail buf_chk-doc and
      736                    buf_chk-doc.chk-type = int('6':U) and
      737                    buf_chk-doc.doc-num2 > ""  and
      738                    num-entries(buf_chk-doc.doc-num2,":") = 2
      739                 then
      740                 for first buf2_chk-doc no-lock where
      741                           buf2_chk-doc.obj-code = buf_chk-doc.obj-code
      742                       and buf2_chk-doc.obj-type = buf_chk-doc.obj-type
      743                       and buf2_chk-doc.chk-type = int('1':U)
      744                       and buf2_chk-doc.chk-num = int(entry(1,buf_chk-doc.doc-num2,":"))
      745                       and buf2_chk-doc.z-number = int(entry(2, buf_chk-doc.doc-num2,":"))
      746                       :
      747                   for each buf2_chk-gds no-lock where
      748                            buf2_chk-gds.doc-code = buf2_chk-doc.doc-code,
      749                      first buf2_chk-gds-attr no-lock where
      750                            buf2_chk-gds-attr.doc-code = buf2_chk-gds.doc-code
      751                        and buf2_chk-gds-attr.line-num  = buf2_chk-gds.line-num
      752                        and buf2_chk-gds-attr.attr-code = "CSPromo"
      753                        and can-do("1,6", buf2_chk-gds-attr.attr-value)
      754                      :
      755                       v-price-base = buf2_chk-gds.price-base.
      756                   end.
      757                 end.
      758              end.
      759              if buf_chk-gds.sum-base = ? or buf_chk-gds.src-qnty = 0 then do:
      760                  assign
      761                     v-sum-all = (buf_chk-gds.src-qnty + v-doc-qnty) * v-price-base
      762                     v-sum-chk = v-sum-base + RoundUp(buf_chk-gds.src-qnty, buf_chk-gds.src-price)
      763                     .
      764              end.
      765              else do:
      766                 assign
      767                 v-sum-all = (buf_chk-gds.doc-qnty + v-doc-qnty ) * v-price-base
      768                 v-sum-chk = v-sum-base + buf_chk-gds.sum-base
      769                 .
      770              end.
      771           end.
      772           v-sum-promo = Round(v-sum-all, 2) - Round(v-sum-chk, 2).
      773       end.
      774       return v-sum-promo.
      775   end function.
      776   function GetUnBaseSum returns decimal
      777       (input iDocCode as character,
      778        input iLineNum as integer,
      779        input iQnty as decimal,
      780        input iPrice as decimal):
      781      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      782      define variable vBaseSum as decimal no-undo.
      783      define variable vDiscSum as decimal no-undo.
      784      vDiscSum = 0.
      785      find first buf_chk-gds-attr no-lock where
      786                        buf_chk-gds-attr.doc-code = iDocCode
      787                    and buf_chk-gds-attr.line-num  = iLineNum
      788                    and buf_chk-gds-attr.attr-code = "CSPromoSum"
      789             no-error.
      790      if avail buf_chk-gds-attr then
      791         vDiscSum = dec(buf_chk-gds-attr.attr-value) no-error.
      792      vBaseSum = iQnty * iPrice + vDiscSum.
      793      if vDiscSum = 0 and ChkPromoPrice(iDocCode, iLineNum) then
      794         vBaseSum = RoundUp(iQnty, iPrice).
      795      return vBaseSum.
      796   end function.
      797   function GetRoundSum returns decimal
      798       (input iDocCode as character,
      799        input iLineNum as integer,
      800        input iQnty as decimal,
      801        input iPrice as decimal):
      802      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      803      define variable vBaseSum as decimal no-undo.
      804      if ChkPromoPrice(iDocCode, iLineNum) then
      805         vBaseSum = RoundUp(iQnty, iPrice).
      806      else vBaseSum = iQnty * iPrice.
      807      return vBaseSum.
      808   end function.
      809   function GetRoundSumChkDel returns decimal
      810       (input iDocCode as character,
      811        input iLineNum as integer,
      812        input iChipNum as integer,
      813        input iQnty as decimal,
      814        input iPrice as decimal):
      815      define buffer  buf_c-chk-doc-attr for ub.c-chk-doc-attr.
      816      define variable vBaseSum as decimal no-undo.
      817      define variable vIsPromo as logical no-undo.
      818      for each buf_c-chk-doc-attr no-lock where
      819               buf_c-chk-doc-attr.doc-code = iDocCode
      820           and buf_c-chk-doc-attr.chip-num = iChipNum
      821          :
      822          if num-entries(buf_c-chk-doc-attr.attr-code, chr(4)) > 1
      823          then do :
      824            if entry(1, buf_c-chk-doc-attr.attr-code, chr(4)) begins "gds="
      825            and entry(2, buf_c-chk-doc-attr.attr-code, chr(4)) = "CSPromo"
      826            and entry(2, entry(1, buf_c-chk-doc-attr.attr-code, chr(4)), "=") = String(iLineNum)
      827            and can-do("2,4,5,7", buf_c-chk-doc-attr.attr-value)
      828            then vIsPromo = yes.
      829          end.
      830      end.
      831      if ChkPromoPrice(iDocCode, iLineNum) then
      832         vBaseSum = RoundUp(iQnty, iPrice).
      833      else vBaseSum = iQnty * iPrice.
      834      return vBaseSum.
      835   end function.
      836   function GetSaleRetDisc returns decimal
      837       (input iDocCode as character,
      838        input iSaleCode as character):
      839      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      840      define buffer buf_chk-gds for ub.chk-gds.
      841      define variable vQntyPromoRet as decimal no-undo.
      842      define variable vQntyPromoSel as decimal no-undo.
      843      define variable vDiscSumRet   as decimal no-undo.
      844      define variable vDiscSumSale  as decimal no-undo.
      845      vDiscSumRet = 0.
      846      cspr:
      847      for each  buf_chk-gds no-lock where
      848                buf_chk-gds.doc-code = iDocCode,
      849          first buf_chk-gds-attr no-lock where
      850                buf_chk-gds-attr.doc-code  = buf_chk-gds.doc-code
      851            and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
      852            and buf_chk-gds-attr.attr-code = "CSPromo"
      853            and can-do("2,4,5,7", buf_chk-gds-attr.attr-value)
      854          :
      855          vQntyPromoRet = buf_chk-gds.src-qnty.
      856          leave cspr.
      857      end.
      858      if vQntyPromoRet <> 0 then
      859      for each  buf_chk-gds no-lock where
      860                buf_chk-gds.doc-code = iSaleCode:
      861          find first buf_chk-gds-attr no-lock where
      862                     buf_chk-gds-attr.doc-code  = buf_chk-gds.doc-code
      863                 and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
      864                 and buf_chk-gds-attr.attr-code = "CSPromo"
      865          no-error.
      866          if avail buf_chk-gds-attr
      867               and can-do("2,4,5,7", buf_chk-gds-attr.attr-value)
      868          then
      869            vQntyPromoSel = buf_chk-gds.src-qnty.
      870          find first buf_chk-gds-attr no-lock where
      871                    buf_chk-gds-attr.doc-code  = buf_chk-gds.doc-code
      872                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
      873                and buf_chk-gds-attr.attr-code = "CSPromoSum"
      874          no-error.
      875          if avail buf_chk-gds-attr then
      876             vDiscSumSale = dec(buf_chk-gds-attr.attr-value) no-error.
      877      end.
      878      if vQntyPromoRet <> 0 and
      879         vQntyPromoSel = -1 * vQntyPromoRet
      880      then vDiscSumRet = -1 * vDiscSumSale.
      881      return vDiscSumRet.
      882   end function.
      883   function SetPromoDisc return logical
      884    (input iDocCode as character,
      885        input iLineNum as integer
      886        )
      887       :
      888      define buffer buf_chk-doc for ub.chk-doc.
      889      define buffer buf2_chk-doc for ub.chk-doc.
      890      define buffer buf_chk-gds for ub.chk-gds.
      891      define buffer buf2_chk-gds for ub.chk-gds.
      892      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      893      define buffer buf2_chk-gds-attr for ub.chk-gds-attr.
      894      define buffer buf_chk-discnt for ub.chk-discnt.
      895      define buffer buf2_chk-discnt for ub.chk-discnt.
      896      define buffer buf_chk-discnt-attr for ub.chk-discnt-attr.
      897      define buffer buf2_chk-discnt-attr for ub.chk-discnt-attr.
      898      define variable v-promo-sum as decimal no-undo.
      899      define variable v-disc-promo-id as character no-undo.
      900      define variable var-discnt-id as integer no-undo.
      901      define variable v-chk-sale as character no-undo.
      902      find first buf_chk-gds-attr no-lock where
      903                 buf_chk-gds-attr.doc-code = iDocCode
      904             and buf_chk-gds-attr.line-num  = iLineNum
      905             and buf_chk-gds-attr.attr-code = "CSPromo"
      906         no-error.
      907      if avail buf_chk-gds-attr
      908        then do:
      909        find first buf_chk-discnt no-lock where
      910                   buf_chk-discnt.doc-code = buf_chk-gds-attr.doc-code
      911               and buf_chk-discnt.line-num = buf_chk-gds-attr.line-num
      912               and buf_chk-discnt.record-type = 0
      913               and buf_chk-discnt.promo-id > ""
      914               no-error.
      915        if not avail buf_chk-discnt then do:
      916           find first buf_chk-doc no-lock where
      917                      buf_chk-doc.doc-code = iDocCode
      918              no-error.
      919           find first buf_chk-gds no-lock where
      920                      buf_chk-gds.doc-code = iDocCode
      921                 and  buf_chk-gds.line-num = iLineNum
      922              no-error.
      923          for first buf2_chk-doc no-lock where
      924                    buf2_chk-doc.obj-code = buf_chk-doc.obj-code
      925                and buf2_chk-doc.obj-type = buf_chk-doc.obj-type
      926                and buf2_chk-doc.pay-desk = buf_chk-doc.pay-desk
      927                and buf2_chk-doc.chk-type = int('1':U)
      928                and buf2_chk-doc.chk-num  = int(entry(1,buf_chk-doc.doc-num2,":"))
      929                and buf2_chk-doc.z-number = int(entry(2, buf_chk-doc.doc-num2,":"))
      930              :
      931              find first buf2_chk-gds no-lock where
      932                         buf2_chk-gds.doc-code = buf2_chk-doc.doc-code
      933                    and  buf2_chk-gds.b-code   = buf_chk-gds.b-code
      934              no-error.
      935              if not avail buf2_chk-gds then return no.
      936              v-chk-sale = buf2_chk-doc.doc-code.
      937              find first buf_chk-discnt no-lock where
      938                         buf_chk-discnt.doc-code =  buf2_chk-doc.doc-code and
      939                         buf_chk-discnt.record-type = 1 and
      940                         buf_chk-discnt.object-line-num = buf2_chk-gds.line-num and
      941                         buf_chk-discnt.promo-id > ""
      942              no-error .
      943              if avail buf_chk-discnt
      944              then do:
      945                 v-disc-promo-id = buf_chk-discnt.promo-id.
      946                 find first buf2_chk-discnt no-lock where
      947                   buf2_chk-discnt.doc-code = iDocCode and
      948                   buf2_chk-discnt.record-type = 5 and
      949                   buf2_chk-discnt.line-num = 0 and
      950                   buf2_chk-discnt.promo-id =  v-disc-promo-id
      951                 no-error.
      952                 find first buf2_chk-discnt-attr no-lock where
      953                            buf2_chk-discnt-attr.doc-code = iDocCode and
      954                            buf2_chk-discnt-attr.record-type = 5 and
      955                            buf2_chk-discnt-attr.line-num = 0 and
      956                            buf2_chk-discnt-attr.attr-code = "promo-id" and
      957                            buf2_chk-discnt-attr.attr-value = v-disc-promo-id
      958                       no-error .
      959                 if not avail buf2_chk-discnt
      960                 then do:
      961                     for each buf_chk-discnt no-lock where
      962                              buf_chk-discnt.doc-code = buf_chk-gds-attr.doc-code
      963                          and buf_chk-discnt.record-type = 5:
      964                          var-discnt-id  = var-discnt-id + 1.
      965                     end.
      966                     create buf2_chk-discnt.
      967                     assign
      968                       buf2_chk-discnt.doc-code = iDocCode
      969                       buf2_chk-discnt.record-type = 5
      970                       buf2_chk-discnt.line-num = 0
      971                       buf2_chk-discnt.promo-id = v-disc-promo-id
      972                       buf2_chk-discnt.object-sum = 0
      973                       buf2_chk-discnt.discnt-id = if avail buf2_chk-discnt-attr
      974                                                      then buf2_chk-discnt-attr.discnt-id
      975                                                      else (var-discnt-id + 1)
      976                       var-discnt-id = 0
      977                       buf2_chk-discnt.object-line-num = 0
      978                       buf2_chk-discnt.pay-desk = buf_chk-doc.pay-desk
      979                       buf2_chk-discnt.obj-code = buf_chk-doc.obj-code
      980                       buf2_chk-discnt.obj-type = buf_chk-doc.obj-type
      981                       buf2_chk-discnt.chk-date = buf_chk-doc.chk-date
      982                       buf2_chk-discnt.shift-date = buf_chk-doc.shift-date
      983                       buf2_chk-discnt.shift-num = buf_chk-doc.shift-num
      984                       buf2_chk-discnt.chk-time = buf_chk-doc.chk-time
      985                       .
      986                 end.
      987                 if avail buf2_chk-discnt and
      988                    not avail buf2_chk-discnt-attr
      989                 then do:
      990                    create buf2_chk-discnt-attr.
      991                    assign
      992                       buf2_chk-discnt-attr.doc-code = iDocCode
      993                       buf2_chk-discnt-attr.discnt-id = buf2_chk-discnt.discnt-id
      994                       buf2_chk-discnt-attr.record-type     = 5
      995                       buf2_chk-discnt-attr.line-num        = 0
      996                       buf2_chk-discnt-attr.object-line-num = 0
      997                       buf2_chk-discnt-attr.attr-code       = "promo-id"
      998                       buf2_chk-discnt-attr.attr-value      = v-disc-promo-id
      999                       .
     1000                 end.
     1001              end.
     1002          end.
     1003           v-promo-sum = 0.
     1004           if can-do("1,6,7", buf_chk-gds-attr.attr-value)
     1005           then do:
     1006              if v-chk-sale <> ? and v-chk-sale <> "" then
     1007                 v-promo-sum = GetSaleRetDisc(iDocCode,v-chk-sale).
     1008              v-promo-sum = if v-promo-sum = 0 then GetPromoSum(iDocCode) else v-promo-sum.
     1009              if v-promo-sum <> 0 then do:
     1010                  find first buf2_chk-gds-attr no-lock where
     1011                             buf2_chk-gds-attr.doc-code = iDocCode
     1012                         and buf2_chk-gds-attr.line-num  = iLineNum
     1013                         and buf2_chk-gds-attr.attr-code = "CSPromoSum"
     1014                     no-error.
     1015                  if not avail buf2_chk-gds-attr then do:
     1016                      create buf2_chk-gds-attr.
     1017                      assign
     1018                         buf2_chk-gds-attr.doc-code = iDocCode
     1019                         buf2_chk-gds-attr.line-num  = iLineNum
     1020                         buf2_chk-gds-attr.attr-code = "CSPromoSum"
     1021                         buf2_chk-gds-attr.attr-value = string(Round(v-promo-sum,2))
     1022                         .
     1023                  end.
     1024              end.
     1025           end.
     1026           for each buf_chk-discnt no-lock where
     1027                   buf_chk-discnt.doc-code = buf_chk-gds-attr.doc-code
     1028               and buf_chk-discnt.record-type = 0:
     1029              var-discnt-id  = var-discnt-id + 1.
     1030           end.
     1031           create buf_chk-discnt.
     1032           assign
     1033               buf_chk-discnt.doc-code = iDocCode
     1034               buf_chk-discnt.line-num = iLineNum
     1035               buf_chk-discnt.record-type = 0
     1036               buf_chk-discnt.discnt-id = (var-discnt-id + 1)
     1037               buf_chk-discnt.time-oper = buf_chk-gds.time-oper
     1038               buf_chk-discnt.line-type = integer('1':U)
     1039               buf_chk-discnt.line-sign = no
     1040               buf_chk-discnt.pass-discnt = integer('0':U)
     1041               buf_chk-discnt.value-type = integer('2':U)
     1042               buf_chk-discnt.src-d-card = buf_chk-gds.src-d-card
     1043               buf_chk-discnt.d-card = buf_chk-gds.d-card
     1044               buf_chk-discnt.discnt-value-abs = 0
     1045               buf_chk-discnt.discnt-value-pcnt = 0
     1046               buf_chk-discnt.object-line-num = iLineNum
     1047               buf_chk-discnt.pay-desk = buf_chk-doc.pay-desk
     1048               buf_chk-discnt.obj-code = buf_chk-doc.obj-code
     1049               buf_chk-discnt.obj-type = buf_chk-doc.obj-type
     1050               buf_chk-discnt.chk-date = buf_chk-doc.chk-date
     1051               buf_chk-discnt.chk-time = buf_chk-doc.chk-time
     1052               buf_chk-discnt.shift-date = buf_chk-doc.shift-date
     1053               buf_chk-discnt.shift-num = buf_chk-doc.shift-num
     1054               buf_chk-discnt.object-qnty = buf_chk-gds.src-qnty
     1055               buf_chk-discnt.object-sum = buf_chk-gds.src-sum
     1056               var-discnt-id = var-discnt-id + 1
     1057               buf_chk-discnt.promo-id = v-disc-promo-id
     1058               buf_chk-discnt.discnt-type = integer('7':U)
     1059               .
     1060           find first buf_chk-discnt-attr no-lock where
     1061                      buf_chk-discnt-attr.attr-code = "promo-id"
     1062                  and buf_chk-discnt-attr.discnt-id = buf_chk-discnt.discnt-id
     1063                  and buf_chk-discnt-attr.doc-code = buf_chk-discnt.doc-code
     1064                  and buf_chk-discnt-attr.line-num = buf_chk-discnt.line-num
     1065                  no-error.
     1066           if not avail buf_chk-discnt-attr then
     1067           do:
     1068               create buf_chk-discnt-attr .
     1069               assign
     1070                   buf_chk-discnt-attr.attr-code = "promo-id"
     1071                   buf_chk-discnt-attr.attr-value = buf_chk-discnt.promo-id
     1072                   buf_chk-discnt-attr.discnt-id = buf_chk-discnt.discnt-id
     1073                   buf_chk-discnt-attr.doc-code = buf_chk-discnt.doc-code
     1074                   buf_chk-discnt-attr.line-num = buf_chk-discnt.line-num
     1075                   buf_chk-discnt-attr.object-line-num = buf_chk-discnt.object-line-num
     1076                   buf_chk-discnt-attr.record-type = buf_chk-discnt.record-type
     1077                   .
     1078            end.
     1079        end.
     1080      end.
     1081      return yes.
     1082   end function.
     1083   function GetPromoPriceSum returns decimal
     1084       (input iDocCode as character)
     1085       :
     1086       define buffer buf_chk-gds for ub.chk-gds.
     1087       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     1088       define variable vPromoSum as decimal no-undo.
     1089       vPromoSum = 0.
     1090       cspr:
     1091       for each buf_chk-gds no-lock where
     1092                    buf_chk-gds.doc-code = iDocCode,
     1093              first buf_chk-gds-attr no-lock where
     1094                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     1095                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     1096                and buf_chk-gds-attr.attr-code = "CSPromo"
     1097                and can-do("2,4,5,7", buf_chk-gds-attr.attr-value):
     1098          vPromoSum = RoundUp(buf_chk-gds.src-qnty, buf_chk-gds.src-price).
     1099          leave cspr.
     1100       end.
     1101       return vPromoSum.
     1102   end.
     1103   function GetPromoPriceLine returns integer
     1104       (input iDocCode as character)
     1105       :
     1106       define buffer buf_chk-gds for ub.chk-gds.
     1107       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     1108       define variable vPromoLine as integer no-undo.
     1109       vPromoLine = 0.
     1110       cspr:
     1111       for each buf_chk-gds no-lock where
     1112                    buf_chk-gds.doc-code = iDocCode,
     1113              first buf_chk-gds-attr no-lock where
     1114                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     1115                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     1116                and buf_chk-gds-attr.attr-code = "CSPromo"
     1117                and can-do("2,4,5,7", buf_chk-gds-attr.attr-value):
     1118          vPromoLine = buf_chk-gds-attr.line-num.
     1119          leave cspr.
     1120       end.
     1121       return vPromoLine.
     1122   end.
     1123   define variable strbuf1     as character no-undo.
     1124   DEFINE variable for-saleman as integer no-undo.
     1125   DEFINE variable for-saleman-psn-code as integer no-undo.
     1126   define variable for-saleman-chr as character no-undo .
     1127   DEFINE VARIABLE vproc-check as character no-undo .
     1128   vproc-check = entry(1, par-run-names, chr(4)).
     1129   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1130   define SHARED temp-table sj-goods no-undo
     1131   field obj-attr     as   char
     1132   field b-code like ub.bar-code.b-code format "9999999999999"
     1133   field saleman-chr as   character
     1134   field artic     like ub.goods.artic
     1135   field name   like ub.goods.gds-name format "x(30)"
     1136   field grp-code          like ub.goods.grp-code
     1137   field grp-name          like ub.goods.grp-code
     1138   field prod-name   like ub.clients.obj-name
     1139   field node-code like ub.gds-prt.node-code
     1140   field node-name like ub.gds-prt.node-name
     1141   field twounit as decimal
     1142   field two-type as logical
     1143   field alt-type as logical
     1144   INDEX p1 IS PRIMARY   obj-attr ASCENDING
     1145   INDEX p2              obj-attr artic ASCENDING
     1146   INDEX p3              obj-attr prod-name ASCENDING
     1147   INDEX p4              obj-attr b-code saleman-chr ASCENDING
     1148   INDEX p6              obj-attr grp-name prod-name
     1149   INDEX p7              grp-code
     1150   .
     1151   define SHARED temp-table sj-adv no-undo
     1152   field obj-attr     as   char
     1153   field b-code like ub.bar-code.b-code format "9999999999999"
     1154   field saleman-chr as    character
     1155   field price    like ub.chk-gds.price-base
     1156   field discnt  like ub.chk-gds.discnt
     1157   field qnty     like ub.chk-gds.doc-qnty
     1158   field qnty-2     like ub.chk-gds.doc-qnty
     1159   field qnty-3    like ub.chk-gds.doc-qnty
     1160   field dop-rowid as rowid
     1161   field brutto-sum   as   decimal
     1162   field discnt-sum  like ub.chk-gds.discnt
     1163   field netto-sum    as   decimal
     1164   field brutto-sum-r   as   decimal
     1165   field netto-sum-r    as   decimal
     1166   field num-lines as integer
     1167   field num-docs as integer
     1168   INDEX pi  IS PRIMARY   obj-attr b-code saleman-chr price discnt dop-rowid ASCENDING
     1169   .
     1170   define SHARED temp-table sj-tots no-undo
     1171   field obj-attr     as   char
     1172   field grp-code          like ub.goods.grp-code
     1173   field grp-name          like ub.goods.grp-code
     1174   field prod-name   like ub.clients.obj-name
     1175   field saleman-chr as    character
     1176   field qnty     like ub.chk-gds.doc-qnty
     1177   field qnty-2   like ub.chk-gds.doc-qnty
     1178   field qnty-3   like ub.chk-gds.doc-qnty
     1179   field brutto-sum   as   decimal
     1180   field discnt-sum  like ub.chk-gds.discnt
     1181   field netto-sum    as   decimal
     1182   field brutto-sum-r   as   decimal
     1183   field netto-sum-r    as   decimal
     1184   field num-lines as integer
     1185   field num-docs as integer
     1186   INDEX pi  IS PRIMARY   obj-attr ASCENDING
     1187   INDEX p1                        prod-name ASCENDING
     1188   INDEX p2                        grp-name  ASCENDING
     1189   INDEX p3                        grp-code
     1190   .
     1191   define SHARED temp-table sj-grp no-undo
     1192   field grp-code like ub.goods.grp-code
     1193   field grp-name like ub.goods.grp-name
     1194   field grp-code-alpha like ub.goods.grp-code
     1195   INDEX pi grp-code
     1196   INDEX iname  grp-name
     1197   INDEX grp-code-alpha grp-code-alpha
     1198   .
     1199   define SHARED temp-table sj-salesman no-undo
     1200   field seller like ub.person.seller
     1201   field psn-code like ub.person.psn-code
     1202   field sal-chr as character
     1203   index pi is unique primary seller psn-code
     1204   index ichr sal-chr
     1205   index ipsn psn-code
     1206   .
     1207   FUNCTION get-grp-name returns character( input p-grp-code-alpha as integer):
     1208   define buffer buf_sj-grp for sj-grp.
     1209     find first buf_sj-grp no-lock where
     1210               buf_sj-grp.grp-code-alpha = p-grp-code-alpha no-error.
     1211     if available buf_sj-grp then do:
     1212       return buf_sj-grp.grp-name .
     1213     end.
     1214     return "!!!Неизвестное имя группы!!!".
     1215   END FUNCTION.
     1216   DEFINE SHARED VARiable   cashdesc-num    AS    INTEGER         no-undo.
     1217   DEFINE SHARED VARiable    saleman-num     AS    INTEGER         no-undo.
     1218   DEFINE VARIABLE v-found-chk-gds as logical no-undo .
     1219   define variable v-rate as decimal no-undo .
     1220   define variable prev-doc as character no-undo .
     1221   DEFINE shared VARIABLE v-num-chk as integer no-undo .
     1222   assign
     1223   v-num-chk = 0
     1224   .
     1225   FOR EACH obj-list :
     1226       strbuf1 = obj-list.obj-type + string( obj-list.obj-code ) .
     1227       _chk-doc:
     1228     FOR EACH ub.chk-doc no-lock WHERE
     1229             ub.chk-doc.obj-type = obj-list.obj-type AND
     1230             ub.chk-doc.obj-code = obj-list.obj-code
     1231             and
     1232             (
     1233                 (p-by-shift-dates = yes
     1234                 AND
     1235                 (ub.chk-doc.shift-date >= startdate AND
     1236                 ub.chk-doc.shift-date <= enddate)
     1237                 )
     1238                 or
     1239                 (p-by-shift-dates = no
     1240                 AND ub.chk-doc.chk-date >= startdate
     1241                 AND ub.chk-doc.chk-date <= enddate
     1242                 )
     1243            )
     1244          :
     1245         if lookup(string(ub.chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then NEXT _chk-doc.
     1246         if saleman-num < 10000 then do:
     1247           if rs-seller-cashier = "seller" then do:
     1248             if ub.chk-doc.sales-man <> 0
     1249             and not can-find(first sj-salesman where sj-salesman.seller = ub.chk-doc.sales-man) then NEXT.
     1250             if ub.chk-doc.salesman-psn-code <> ?
     1251             and ub.chk-doc.salesman-psn-code <> 0
     1252             and not can-find(first sj-salesman where sj-salesman.psn-code = ub.chk-doc.salesman-psn-code) then NEXT.
     1253           end.
     1254           else do:
     1255             if ub.chk-doc.cashier <> 0
     1256             and not can-find(first sj-salesman where sj-salesman.seller = ub.chk-doc.cashier) then NEXT.
     1257             if ub.chk-doc.cashier-psn-code <> ?
     1258             and ub.chk-doc.cashier-psn-code <> 0
     1259             and not can-find(first sj-salesman where sj-salesman.psn-code = ub.chk-doc.cashier-psn-code) then NEXT.
     1260           end.
     1261         end.
     1262         if p-cash-desk-num >= 0
     1263         and ub.chk-doc.pay-desk <> p-cash-desk-num then   NEXT .
     1264         if p-by-shift-dates then do:
     1265           IF Period-Type = 3 AND
     1266               ((ub.chk-doc.shift-date = startdate AND ub.chk-doc.shift-num < startshift) OR
     1267                 (ub.chk-doc.shift-date = enddate AND  ub.chk-doc.shift-num > endshift) ) THEN NEXT.
     1268           IF Period-Type = 4 AND
     1269               ub.chk-doc.shift-num <> shiftalone THEN NEXT.
     1270        end.
     1271     if v-curr-r-b = 'base':U then do:
     1272       v-rate = ?.
     1273       assign
     1274       v-rate = ub.chk-doc.cash-rate / ub.chk-doc.cash-scale
     1275       no-error .
     1276       if error-status:error
     1277       or v-rate = 0 or v-rate = ?
     1278       then do:
     1279         FIND FIRST ub.chk-pay WHERE
     1280                     ub.chk-pay.doc-code = ub.chk-doc.doc-code NO-LOCK .
     1281         if not avail ub.chk-pay then  NEXT _chk-doc.
     1282         assign
     1283         v-rate = ub.chk-pay.tot-rubl / ub.chk-pay.tot-base.
     1284       end.
     1285   end.
     1286       if rs-seller-cashier = "seller" then do:
     1287         assign
     1288         for-saleman = IF BYSALERS
     1289                       then ub.chk-doc.sales-man
     1290                       else 0
     1291         for-saleman-psn-code = IF BYSALERS and ub.chk-doc.salesman-psn-code <> ?
     1292                               then ub.chk-doc.salesman-psn-code
     1293                               else 0
     1294         for-saleman-chr = string(for-saleman) + chr(4) + string(for-saleman-psn-code)
     1295         v-found-chk-gds = no
     1296         .
     1297       end.
     1298       else do:
     1299         assign
     1300         for-saleman = IF BYSALERS
     1301                       then ub.chk-doc.cashier
     1302                       else 0
     1303         for-saleman-psn-code = IF BYSALERS and ub.chk-doc.cashier-psn-code <> ?
     1304                               then ub.chk-doc.cashier-psn-code
     1305                               else 0
     1306         for-saleman-chr = string(for-saleman) + chr(4) + string(for-saleman-psn-code)
     1307         v-found-chk-gds = no
     1308         .
     1309       end.
     1310       FOR EACH ub.chk-gds WHERE
     1311                 ub.chk-gds.doc-code = ub.chk-doc.doc-code NO-LOCK :
     1312         if rs-seller-cashier = "seller" then do:
     1313           assign
     1314           for-saleman = (if BYSALERS AND ub.chk-gds.sales-man <> ? AND ub.chk-gds.sales-man <> 0
     1315                           then ub.chk-gds.sales-man
     1316                           else for-saleman)
     1317           for-saleman-psn-code = (if BYSALERS AND ub.chk-gds.salesman-psn-code <> ?  AND ub.chk-gds.salesman-psn-code <> 0
     1318                           then ub.chk-gds.salesman-psn-code
     1319                           else for-saleman-psn-code)
     1320           for-saleman-chr = string(for-saleman) + chr(4) + string(for-saleman-psn-code)
     1321           .
     1322         end.
     1323         FIND sj-goods WHERE
     1324               sj-goods.obj-attr = strbuf1 AND
     1325               sj-goods.b-code = ub.chk-gds.b-code AND
     1326               sj-goods.saleman-chr = for-saleman-chr
     1327                NO-ERROR .
     1328         if available sj-goods then do:
     1329           if ptwounit and sj-goods.twounit > 0 then
     1330                 FIND sj-adv WHERE
     1331                       sj-adv.obj-attr = strbuf1 AND
     1332                       sj-adv.b-code = ub.chk-gds.b-code AND
     1333                       sj-adv.saleman-chr = for-saleman-chr AND
     1334                       sj-adv.price = ub.chk-gds.price-base AND
     1335                       sj-adv.dop-rowid = rowid(ub.chk-gds)
     1336                       NO-ERROR .
     1337           else
     1338                 FIND sj-adv WHERE
     1339                       sj-adv.obj-attr = strbuf1 AND
     1340                       sj-adv.b-code = ub.chk-gds.b-code AND
     1341                       sj-adv.saleman-chr = for-saleman-chr AND
     1342                       sj-adv.price = ub.chk-gds.price-base
     1343                       NO-ERROR .
     1344           if NOT available sj-adv then  do:
     1345             CREATE sj-adv.
     1346             assign
     1347             sj-adv.obj-attr = strbuf1
     1348             sj-adv.b-code = ub.chk-gds.b-code
     1349             sj-adv.saleman-chr = for-saleman-chr
     1350             sj-adv.price = ub.chk-gds.price-base
     1351             sj-adv.discnt = ub.chk-gds.discnt
     1352             sj-adv.qnty = 0
     1353             sj-adv.qnty-2 = 0
     1354             sj-adv.qnty-3 = 0
     1355             sj-adv.dop-rowid = if ptwounit
     1356                                 then rowid(ub.chk-gds)
     1357                                 else sj-adv.dop-rowid
     1358             .
     1359           end.
     1360         end.
     1361         else do:
     1362           FIND ub.bar-code WHERE
     1363                 ub.bar-code.b-code = ub.chk-gds.b-code NO-LOCK NO-ERROR .
     1364           IF not avail ub.bar-code then NEXT.
     1365           if available ub.bar-code then do:
     1366             if Producer = 4 then do:
     1367               find first gds-list where
     1368                         gds-list.gds-code = ub.bar-code.gds-code no-error .
     1369               if not available gds-list then NEXT.
     1370             end.
     1371             FIND ub.goods WHERE
     1372                   ub.goods.gds-code = ub.bar-code.gds-code NO-LOCK.
     1373             if not avail ub.goods then NEXT.
     1374             IF Producer = 3 then do:
     1375               FIND g#cli WHERE
     1376                     g#cli.obj-type = ub.goods.prod-type AND
     1377                     g#cli.obj-code = ub.goods.prod-code NO-LOCK NO-ERROR.
     1378               if not avail g#cli then NEXT.
     1379             end.
     1380             if ptwounit then do:
     1381               FIND FIRST ub.units no-LOCK WHERE
     1382                          ub.units.unit-name = ub.goods.unit-base No-ERROR.
     1383             end.
     1384             FIND ub.clients WHERE
     1385                   ub.clients.obj-type = ub.goods.prod-type AND
     1386                   ub.clients.obj-code = ub.goods.prod-code NO-LOCK.
     1387             FIND FIRST ub.gds-prt No-LOCK WHERE
     1388                         ub.gds-prt.node-code = ub.bar-code.node-code No-ERROR.
     1389             CREATE sj-goods.
     1390             CREATE sj-adv.
     1391             assign
     1392             sj-goods.obj-attr = strbuf1
     1393             sj-goods.b-code = ub.bar-code.b-code
     1394             sj-goods.saleman-chr = for-saleman-chr
     1395             sj-goods.artic = ub.goods.artic
     1396             sj-goods.name = ub.goods.gds-name
     1397             sj-goods.grp-code = ub.goods.grp-code
     1398             sj-goods.prod-name = ub.clients.obj-name
     1399             sj-goods.node-code = ub.bar-code.node-code
     1400             sj-goods.node-name = if avail ub.gds-prt and NOT ub.gds-prt.node-name = '_Пустая шкала':U
     1401                                     then ub.gds-prt.node-name
     1402                                     else ""
     1403             sj-goods.two-type = if ptwounit
     1404                                     then  (if avail ub.units and LOOKUP('2ед':U, ub.units.type ) > 0
     1405                                             then yes
     1406                                             else no)
     1407                                     else no
     1408             sj-goods.alt-type = if ptwounit
     1409                                     then (if  avail units and LOOKUP('доп':U, units.type) > 0
     1410                                           then yes
     1411                                           else no)
     1412                                       else no
     1413             sj-goods.twounit = if sj-goods.two-type
     1414                                 then 1
     1415                                 else (if sj-goods.alt-type
     1416                                       then ub.goods.wt-cart
     1417                                       else 0)
     1418             sj-adv.obj-attr = strbuf1
     1419             sj-adv.b-code = ub.chk-gds.b-code
     1420             sj-adv.saleman = for-saleman-chr
     1421             sj-adv.price = ub.chk-gds.price-base
     1422             sj-adv.discnt = ub.chk-gds.discnt
     1423             sj-adv.qnty = 0
     1424             sj-adv.qnty-2 = 0
     1425             sj-adv.qnty-3 = 0
     1426             sj-adv.dop-rowid = if ptwounit
     1427                                 then rowid(ub.chk-gds)
     1428                                 else sj-adv.dop-rowid
     1429             .
     1430             find first sj-grp where
     1431                         sj-grp.grp-code = sj-goods.grp-code no-error .
     1432             if not available sj-grp then do:
     1433               create sj-grp.
     1434               assign
     1435               sj-grp.grp-code = sj-goods.grp-code
     1436               sj-grp.grp-name = ub.goods.grp-name
     1437               .
     1438             end.
     1439           end.
     1440         end.
     1441         assign
     1442         sj-adv.qnty = sj-adv.qnty + ub.chk-gds.doc-qnty
     1443         sj-adv.qnty-2 = sj-adv.qnty-2 + (if ub.chk-gds.doc-qnty >= 0 then 1 else - 1 ) *
     1444                                         (if sj-goods.two-type then 1 else 0) * sj-goods.twounit +
     1445                                         (if sj-goods.alt-type then 1 else 0) * ub.chk-gds.doc-qnty
     1446         sj-adv.qnty-3 = sj-adv.qnty-3 + (if ub.chk-gds.doc-qnty >= 0 then 1 else - 1 ) *
     1447                                         (if sj-goods.alt-type then 1 else 0) * sj-goods.twounit +
     1448                                         (if sj-goods.two-type then 1 else 0) * ub.chk-gds.doc-qnty
     1449         sj-adv.num-lines  = sj-adv.num-lines + 1
     1450         sj-adv.num-docs   = sj-adv.num-doc + (if ub.chk-gds.doc-code = prev-doc then 0 else 1)
     1451         prev-doc          = ub.chk-gds.doc-code
     1452         sj-adv.brutto-sum = sj-adv.brutto-sum + GetRoundSum(ub.chk-gds.doc-code,ub.chk-gds.line-num,ub.chk-gds.doc-qnty, ub.chk-gds.price-base)
     1453                             + ChkPromoSum(ub.chk-gds.doc-code,ub.chk-gds.line-num)
     1454         sj-adv.discnt-sum = sj-adv.discnt-sum + ub.chk-gds.discnt * ub.chk-gds.doc-qnty
     1455                             + ChkPromoSum(ub.chk-gds.doc-code,ub.chk-gds.line-num)
     1456         sj-adv.netto-sum = sj-adv.netto-sum +
     1457                            GetRoundSum(ub.chk-gds.doc-code,ub.chk-gds.line-num,ub.chk-gds.doc-qnty, ( ub.chk-gds.price-base - ub.chk-gds.discnt )).
     1458         if v-curr-r-b = 'base':U then do:
     1459           assign
     1460           sj-adv.brutto-sum-r = sj-adv.brutto-sum-r +
     1461                                 round(GetRoundSum(ub.chk-gds.doc-code,ub.chk-gds.line-num,ub.chk-gds.doc-qnty * v-rate, chk-gds.price-base), 2) +
     1462                                 ChkPromoSum(ub.chk-gds.doc-code,ub.chk-gds.line-num)
     1463           sj-adv.netto-sum-r = sj-adv.netto-sum-r +
     1464                                round(GetRoundSum(ub.chk-gds.doc-code,ub.chk-gds.line-num,ub.chk-gds.doc-qnty * v-rate,( ub.chk-gds.price-base - ub.chk-gds.discnt )),2)
     1465           .
     1466          end.
     1467          v-found-chk-gds = yes
     1468          .
     1469        END .
     1470       assign
     1471       v-num-chk = (if v-found-chk-gds
     1472                     then v-num-chk + 1
     1473                     else v-num-chk)
     1474       .
     1475       ACCUMULATE ub.chk-doc.doc-code ( COUNT ) .
     1476       if ( ( ACCUM COUNT ub.chk-doc.doc-code ) modulo 20 ) = 0 AND
     1477             ( ACCUM COUNT ub.chk-doc.doc-code ) >= 20 then
     1478           run waitfram-show in p-sj-handle ( obj-list.obj-type + " " + string( obj-list.obj-code ) +
     1479               vproc-check + string( ACCUM COUNT ub.chk-doc.doc-code ) ) .
     1480     END.
     1481   END.
