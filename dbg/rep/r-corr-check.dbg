      571   define variable var-report-r-b as character no-undo .
      572   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      573   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      574     (output var-report-r-b
      575     )  .
      576   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      577   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      578   define  shared variable RepPathName        as character no-undo .
      579   define  shared variable PrintRubl          as logical   no-undo .
      580   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      581   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      582   procedure cur-time :
      583      define output parameter p-today as date      no-undo .
      584      define output parameter p-time  as integer   no-undo .
      585     do
      586     on error undo, return error
      587     :
      588       define variable v-date1 as date      no-undo .
      589       define variable v-date2 as date      no-undo .
      590       define variable v-time  as integer   no-undo .
      591       assign
      592         v-date1 = today
      593         v-time  = time
      594         v-date2 = today
      595       .
      596       if v-date1 <> v-date2
      597       then do:
      598         assign
      599           v-date1 = today
      600           v-time  = v-time
      601         .
      602       end.
      603       assign
      604         p-today = v-date1
      605         p-time  = v-time
      606       .
      607     end.
      608   end.
      609   function cur-time-date returns character
      610   :
      611     return string(today, '99/99/9999':U) .
      612   end.
      613   function cur-time-mjd returns decimal
      614   :
      615     define variable v-date as date      no-undo .
      616     define variable v-time as integer   no-undo .
      617     run cur-time in this-procedure
      618       (output v-date
      619       ,output v-time
      620       ) .
      621     return integer(v-date) - 2400002 + (v-time / 86400) .
      622   end.
      623   function cur-time-get-ending-index returns integer
      624   (input p-number as integer
      625   )
      626   :
      627     if p-number < 0
      628     or p-number = ?
      629     then do:
      630       return 1 .
      631     end.
      632     define variable v-rest as integer   no-undo .
      633     assign
      634       p-number = p-number modulo 100
      635     .
      636     if p-number < 20
      637     then do:
      638       assign
      639         v-rest = p-number
      640       .
      641     end.
      642     else do:
      643       assign
      644         v-rest = p-number modulo 10
      645       .
      646     end.
      647     case v-rest :
      648       when 1
      649       then do:
      650         return 2 .
      651       end.
      652       when 2 or
      653       when 3 or
      654       when 4
      655       then do:
      656         return 3 .
      657       end.
      658       otherwise do:
      659         return 1 .
      660       end.
      661     end case .
      662   end.
      663   procedure cur-time-mjd-to-date :
      664      define input  parameter i-mjd-diff as decimal no-undo.
      665      define output parameter o-Date     as date    no-undo.
      666      define output parameter o-Time     as integer no-undo.
      667      define variable v-day-number as integer   no-undo .
      668      if    i-mjd-diff < 0
      669         or i-mjd-diff = ?
      670      then do:
      671         return "?" .
      672      end.
      673      assign
      674         v-day-number = truncate(i-mjd-diff,0).
      675         o-Date = date(v-day-number + 2400002).
      676         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      677     .
      678   end.
      679   function cur-time-mjd-to-string returns character
      680   (input p-mjd-diff as decimal
      681   )
      682   :
      683     define variable v-day-number as integer   no-undo .
      684     define variable v-seconds    as integer   no-undo .
      685     define variable v-hour       as integer   no-undo .
      686     define variable v-min        as integer   no-undo .
      687     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      688     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      689     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      690     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      691     if p-mjd-diff < 0
      692     or p-mjd-diff = ?
      693     then do:
      694       return "?" .
      695     end.
      696     assign
      697       v-day-number = integer(truncate(p-mjd-diff,0))
      698       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      699     .
      700     if v-seconds > 86400
      701     then do:
      702       assign
      703         v-seconds = 86400 - 1
      704       .
      705     end.
      706     if v-seconds < 0
      707     then do:
      708       assign
      709         v-seconds = 0
      710       .
      711     end.
      712     assign
      713       v-hour = truncate(v-seconds / 3600, 0)
      714     .
      715     assign
      716       v-seconds = v-seconds modulo 3600
      717     .
      718     assign
      719       v-min = truncate(v-seconds / 60, 0)
      720     .
      721     assign
      722       v-seconds = v-seconds modulo 60
      723     .
      724     return
      725         (if v-day-number <> 0
      726           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      727           else ""
      728         )
      729       + (if v-day-number <> 0 or v-hour <> 0
      730           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      731           else ""
      732         )
      733       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      734           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      735           else ""
      736         )
      737       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      738       .
      739   end.
      740   function cur-time-string returns character
      741   :
      742     define variable v-date as date      no-undo .
      743     define variable v-time as integer   no-undo .
      744     run cur-time in this-procedure
      745       (output v-date
      746       ,output v-time
      747       ) .
      748     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      749   end.
      750   function cur-time-string-sec returns character
      751   :
      752     define variable v-date as date      no-undo .
      753     define variable v-time as integer   no-undo .
      754     run cur-time in this-procedure
      755       (output v-date
      756       ,output v-time
      757       ) .
      758     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      759   end.
      760   function cur-time-custom  returns character
      761   (input p-prefix as character
      762   ,input p-date-format as character
      763   ,input p-delimiter as character
      764   ,input p-time-format as character
      765   ,input p-suffix as character
      766   )
      767   :
      768     define variable v-date as date      no-undo .
      769     define variable v-time as integer   no-undo .
      770     run cur-time in this-procedure
      771       (output v-date
      772       ,output v-time
      773       ) .
      774     return
      775       p-prefix
      776       + string(v-date, p-date-format)
      777       + p-delimiter
      778       + string(v-time, p-time-format)
      779       + p-suffix
      780       .
      781   end.
      782   function cur-time-print  returns character
      783   :
      784     define variable v-date as date      no-undo .
      785     define variable v-time as integer   no-undo .
      786     run cur-time in this-procedure
      787       (output v-date
      788       ,output v-time
      789       ) .
      790     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      791   end.
      792   function cur-time-datetime returns datetime
      793   :
      794     define variable v-char as character no-undo .
      795     define variable v-datetime as datetime no-undo .
      796     v-char = cur-time-string().
      797     v-datetime = datetime(v-char).
      798     return  v-datetime.
      799   end.
      800   function cur-time-string-msec returns character
      801   :
      802     define variable v-date as datetime  no-undo .
      803     v-date = now.
      804     return string(v-date) .
      805   end.
      806   procedure cp-attr-code :
      807     do
      808     on error undo, return error
      809     :
      810       define input  parameter p-code           as character no-undo .
      811       define output parameter p-type           as character no-undo .
      812       define output parameter p-format         as character no-undo .
      813       define output parameter p-label          as character no-undo .
      814       define output parameter p-range          as integer   no-undo .
      815       define output parameter p-user-can-edit  as logical   no-undo .
      816       define output parameter p-output-display as logical   no-undo .
      817       define output parameter p-other          as character no-undo .
      818       case p-code :
      819               when 'paycard-export-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      820               when 'grp-code':U then do:     assign     p-label = "Группа платежа"     p-type = 'C':U      p-format = "X(45)"     p-label = "Группа платежа"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=grp-code':u      .   end.
      821               when 'is-use':U then do:     assign     p-label = "Используется"     p-type = 'C':U      p-format = "X(255)"     p-label = "Используется"     p-range = 4     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=is-use':u      .   end.
      822               when 'dop-doc':U then do:     assign     p-label = "Дополнительный документ"     p-type = 'C':U      p-format = "X(255)"     p-label = "Дополнительный документ"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=dop-doc':u      .   end.
      823               when 'paycard-all-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      824               when 'paycard-edit-prefix':U then do:     assign     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      825               when 'form_km3':U then do:     assign     p-label = "Формировать КМ-3 по чекам возврата"     p-type = 'L':U      p-format = "+/-"     p-label = "Формировать КМ-3 по чекам возврата"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      826               when 'bal_malina':U then do:     assign     p-label = "Оплата баллами Малина"     p-type = 'L':U      p-format = "+/-"     p-label = "Оплата баллами Малина"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      827               when 'max_proc_sum':U then do:     assign     p-label = "Максимальный % порог от суммы"     p-type = 'D':U      p-format = ">>9.99"     p-label = "Максимальный % порог от суммы"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      828               when 'mask_card_kup':U then do:     assign     p-label = "Маска карты\купона"     p-type = 'C':U      p-format = "x(129)"     p-label = "Маска карты\купона"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      829         otherwise do:
      830           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code ).
      831         end.
      832       end.
      833     end.
      834   end procedure.
      835   procedure cp-attr-tooltip :
      836     do
      837     on error undo, return error
      838     :
      839       define input  parameter p-code    as character no-undo .
      840       define output parameter p-tooltip as character no-undo .
      841       define output parameter p-label   as character no-undo .
      842       case p-code :
      843               when 'paycard-export-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт (для выгрузки в XML)"     p-label = "Префиксы платежных карт (для выгрузки в XML)" .   end.
      844               when 'grp-code':U then do:     assign     p-tooltip = "Группа платежа"     p-label = "Группа платежа" .   end.
      845               when 'is-use':U then do:     assign     p-tooltip = "Используется"     p-label = "Используется" .   end.
      846               when 'dop-doc':U then do:     assign     p-tooltip = "Дополнительный документ"     p-label = "Дополнительный документ" .   end.
      847               when 'paycard-all-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)" .   end.
      848               when 'paycard-edit-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт, разрешенных для редактировани"     p-label = "Префиксы платежных карт, разрешенных для редактирования" .   end.
      849               when 'form_km3':U then do:     assign     p-tooltip = "Формировать КМ-3 по чекам возврата"     p-label = "Формировать КМ-3 по чекам возврата" .   end.
      850               when 'bal_malina':U then do:     assign     p-tooltip = "Оплата баллами Малина"     p-label = "Оплата баллами Малина" .   end.
      851               when 'max_proc_sum':U then do:     assign     p-tooltip = "Максимальный % порог от суммы"     p-label = "Максимальный % порог от суммы" .   end.
      852               when 'mask_card_kup':U then do:     assign     p-tooltip = "Маска карты\купона"     p-label = "Маска карты\купона" .   end.
      853         otherwise do:
      854           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code) .
      855         end.
      856       end.
      857     end.
      858   end procedure.
      859   procedure cp-attr-value :
      860     do
      861     on error undo, return error
      862     :
      863       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      864       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      865       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      866       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      867       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      868       define input  parameter p-code        like ub.cash-pay-attr.attr-code      no-undo .
      869       define output parameter p-value       like ub.cash-pay-attr.attr-value    no-undo .
      870       define output parameter p-type        as character no-undo .
      871       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      872       define variable v-format         as character no-undo .
      873       define variable v-label          as character no-undo .
      874       define variable v-range          as integer   no-undo .
      875       define variable v-user-can-edit  as logical   no-undo .
      876       define variable v-output-display as logical   no-undo .
      877       define variable v-other          as character no-undo .
      878       run cp-attr-code in this-procedure
      879         (input  p-code
      880         ,output p-type
      881         ,output v-format
      882         ,output v-label
      883         ,output v-range
      884         ,output v-user-can-edit
      885         ,output v-output-display
      886         ,output v-other
      887         ) no-error .
      888       if error-status :error then do:
      889         undo, return error return-value .
      890       end.
      891       find first buf_cash-pay-attr no-lock
      892         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      893           and buf_cash-pay-attr.curr-code  = p-curr-code
      894           and buf_cash-pay-attr.host-code  = p-host-code
      895           and buf_cash-pay-attr.obj-type   = p-obj-type
      896           and buf_cash-pay-attr.obj-code   = p-obj-code
      897           and buf_cash-pay-attr.attr-code  = p-code
      898         no-error .
      899       if avail buf_cash-pay-attr then do:
      900         assign
      901           p-value =  buf_cash-pay-attr.attr-value
      902         .
      903       end.
      904       else do:
      905         assign
      906           p-value = if p-type = 'L':U then "no":U else ""
      907         .
      908       end.
      909     end.
      910   end procedure.
      911   procedure cp-attr-write :
      912     do
      913     on error undo, return error
      914     :
      915       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      916       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      917       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      918       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      919       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      920       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
      921       define input parameter p-value    like ub.cash-pay-attr.attr-value no-undo .
      922       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      923       define buffer last_cash-pay-attr for ub.cash-pay-attr .
      924       define variable v-type           as character no-undo .
      925       define variable v-format         as character no-undo .
      926       define variable v-label          as character no-undo .
      927       define variable v-range          as integer   no-undo .
      928       define variable v-user-can-edit  as logical   no-undo .
      929       define variable v-output-display as logical   no-undo .
      930       define variable v-other          as character no-undo .
      931       run cp-attr-code in this-procedure
      932         (input  p-code
      933         ,output v-type
      934         ,output v-format
      935         ,output v-label
      936         ,output v-range
      937         ,output v-user-can-edit
      938         ,output v-output-display
      939         ,output v-other
      940         ) no-error .
      941       if error-status :error then do:
      942         undo, return error return-value .
      943       end.
      944       find first buf_cash-pay-attr exclusive-lock
      945         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      946           and buf_cash-pay-attr.curr-code  = p-curr-code
      947           and buf_cash-pay-attr.host-code  = p-host-code
      948           and buf_cash-pay-attr.obj-type   = p-obj-type
      949           and buf_cash-pay-attr.obj-code   = p-obj-code
      950           and buf_cash-pay-attr.attr-code = p-code
      951         no-error .
      952       if not available buf_cash-pay-attr then do:
      953         create buf_cash-pay-attr .
      954         assign
      955         buf_cash-pay-attr.cdpay-code = p-cdpay-code
      956         buf_cash-pay-attr.curr-code  = p-curr-code
      957         buf_cash-pay-attr.host-code  = p-host-code
      958         buf_cash-pay-attr.obj-type   = p-obj-type
      959         buf_cash-pay-attr.obj-code   = p-obj-code
      960         buf_cash-pay-attr.attr-code = p-code
      961         .
      962       end.
      963       assign
      964         buf_cash-pay-attr.attr-value = p-value
      965       .
      966       release buf_cash-pay-attr no-error .
      967       if error-status:error then do:
      968         undo, return error return-value .
      969       end.
      970     end.
      971   end procedure.
      972   procedure cp-attr-exist :
