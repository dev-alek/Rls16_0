     1165   procedure prn-lib-open-stream :
     1166     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1167     define input parameter p-page-size    as integer no-undo .
     1168     define input parameter p-is-stream    as logical no-undo .
     1169     define input parameter p-append       as logical no-undo .
     1170     define variable v-report-name as character no-undo .
     1171     do
     1172       on error undo, return error
     1173       :
     1174       run prn-lib-get-report-name  in this-procedure (
     1175         input parParentProc
     1176         ,output v-report-name
     1177         ).
     1178       if p-is-stream then
     1179       do:
     1180         if p-append then
     1181         do:
     1182           output stream PrnLibStream to value( v-report-name )
     1183             page-size value(p-page-size) append .
     1184         end.
     1185         if not p-append then
     1186         do:
     1187           output stream PrnLibStream to value( v-report-name )
     1188             page-size value(p-page-size) .
     1189         end.
     1190       end.
     1191       if not p-is-stream then
     1192       do:
     1193         if p-append then
     1194         do:
     1195           output to value( v-report-name )
     1196             page-size value(p-page-size) append .
     1197         end.
     1198         if not p-append then
     1199         do:
     1200           output to value( v-report-name )
     1201             page-size value(p-page-size) .
     1202         end.
     1203       end.
     1204     end.
     1205   end procedure.
     1206   procedure prn-lib-open-exp :
     1207     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1208     define input parameter p-is-stream    as logical no-undo .
     1209     define input parameter p-is-append    as logical no-undo .
     1210     define output parameter p-ReportFileName as char init "report" no-undo.
     1211     define output parameter p-process as logical no-undo .
     1212     define variable glog as logical no-undo .
     1213     do
     1214       on error undo, return error
     1215       :
     1216       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1217         TITLE      "Укажите путь"
     1218         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1219         ASK-OVERWRITE
     1220         CREATE-TEST-FILE
     1221         SAVE-AS
     1222         USE-FILENAME
     1223         DEFAULT-EXTENSION "txt"
     1224         UPDATE glog
     1225         .
     1226       if not glog then  return.
     1227       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1228       if p-is-stream then
     1229       do:
     1230         if p-is-append then
     1231         do:
     1232           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1233         end.
     1234         else
     1235         do:
     1236           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1237         end.
     1238       end.
     1239       else
     1240       do:
     1241         if p-is-append then
     1242         do:
     1243           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1244         end.
     1245         else
     1246         do:
     1247           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1248         end.
     1249       end.
     1250       p-process = yes.
     1251     end.
     1252   end procedure.
     1253   procedure prn-lib-get-report-name :
     1254     define input parameter parParentProc  as widget-handle no-undo.
     1255     define output parameter p-report-name as character no-undo .
     1256     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1257   end procedure.
     1258   procedure prn-lib-reportviewer-report-name :
     1259     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1260     define input parameter p-report-name-html as character no-undo .
     1261     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1262   end procedure.
     1263   procedure prn-lib-reportviewer :
     1264     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1265     define input parameter p-report-name-html as character no-undo .
     1266     define input parameter p-param        as character no-undo .
     1267     define variable v-excel           as character no-undo init 'TRUE' .
     1268     define variable v-value-character as character no-undo .
     1269     define variable v-value-integer   as character no-undo .
     1270     define variable v-value-date      as date      no-undo .
     1271     define variable v-value-decimal   as decimal   no-undo .
     1272     define variable rep-excel         as logical   no-undo .
     1273     define variable excel-string      as character no-undo .
     1274     define variable v-param-type      as character no-undo .
     1275     define variable v-tth             as handle    no-undo .
     1276     run adm/shattri.p (
     1277       input "get":U
     1278       ,input  ""
     1279       ,input  0
     1280       ,input  'report-glob':U
     1281       ,input  'rep-excel':U
     1282       ,output v-value-character
     1283       ,output v-value-date
     1284       ,output v-value-decimal
     1285       ,output v-value-integer
     1286       ,output rep-excel
     1287       ,output v-param-type
     1288       ,INPUT-OUTPUT table-handle v-tth
     1289       )  .
     1290     if rep-excel then v-excel = "TRUE" .
     1291     else v-excel = "FALSE" .
     1292     if p-param eq ""
     1293     then
     1294        p-param = "EXCEL:" + v-excel.
     1295     else
     1296        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1297     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1298   end procedure.
     1299   function fnc-convert-dot-to-colon returns character
     1300       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
     1301   function fnc-convert-dot-to-colon returns character
     1302   (input p-data as decimal, input p-accur as character, input p-num as integer):
     1303       define variable result as character no-undo.
     1304       define variable v-str-result as character no-undo.
     1305       if p-data = ? then p-data = 0 .
     1306       p-data = round(p-data, p-num).
     1307       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     1308       return v-str-result.
     1309   END FUNCTION.
