     1069   procedure cp-attr-news :
     1070     do
     1071     on error undo, return error
     1072     :
     1073       define input  parameter p-code           as character no-undo .
     1074       define output parameter p-news           as logical   no-undo .
     1075       case p-code :
     1076               when 'paycard-export-prefix':U then do:     assign     p-news = true.   end.
     1077               when 'grp-code':U then do:     assign     p-news = true.   end.
     1078               when 'is-use':U then do:     assign     p-news = true.   end.
     1079               when 'dop-doc':U then do:     assign     p-news = true.   end.
     1080               when 'paycard-all-prefix':U then do:     assign     p-news = true.   end.
     1081               when 'paycard-edit-prefix':U then do:     assign     p-news = true.   end.
     1082               when 'form_km3':U then do:     assign     p-news = false.   end.
     1083               when 'bal_malina':U then do:     assign     p-news = false.   end.
     1084               when 'max_proc_sum':U then do:     assign     p-news = true.   end.
     1085               when 'mask_card_kup':U then do:     assign     p-news = true.   end.
     1086         otherwise do:
     1087           p-news = no.
     1088         end.
     1089       end.
     1090     end.
     1091   end procedure.
