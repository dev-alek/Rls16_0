     1395   define buffer buf_tt-corr-check for tt-corr-check .
     1396   define buffer buf_clients       for ub.clients .
     1397   define variable v-check-type      as character no-undo .
     1398   define variable v-osnov-corr_name as character no-undo .
     1399   define variable v-date-corr_name  as character no-undo .
     1400   define variable v-num-corr_name   as character no-undo .
     1401   define variable v-shift           as character no-undo .
     1402   define variable v-change          as character no-undo .
     1403   define variable v-create-time     as character no-undo .
     1404   define variable v-create-date     as character no-undo .
     1405   define stream Out-Stream.
     1406   define stream OutStr-html.
     1407   do
     1408     on error undo, return error return-value
     1409     :
     1410     find first obj-list no-error .
     1411     if not available obj-list then
     1412     do:
     1413       message
     1414         "Не указан объект для формирования отчета!"
     1415         view-as alert-box error.
     1416       undo, return error.
     1417     end.
     1418     DEFINE VARIABLE v-dop   AS character NO-UNDO .
     1419     DEFINE VARIABLE v-value AS character NO-UNDO.
     1420     DEFINE VARIABLE v-type  AS character NO-UNDO.
     1421     if x-TOG-Shift then
     1422     do:
     1423       v-period = "Смены с " + string (x-Shift-Start) + " по " + string (x-Shift-End) + " За период с " + string (x-Date-Start,"99.99.9999") + " по " + string (x-Date-End,"99.99.9999") .
     1424     end.
     1425     else
     1426     do:
     1427       v-period = "За период с " + string (x-Date-Start,"99.99.9999") + " по " + string (x-Date-End,"99.99.9999") .
     1428     end.
     1429     run clients-write(INPUT v-cntxt-host-code-obj, INPUT 'орг':U, OUTPUT v-obj-name) no-error .
     1430     DEFINE VARIABLE v-today as date    no-undo .
     1431     DEFINE VARIABLE v-time  as integer no-undo .
     1432     run cur-time in this-procedure (
     1433       output v-today
     1434       , output v-time
     1435       ).
     1436     v-print-date = "Дата печати: " + string (v-today,"99.99.9999") + ", время: " + string(truncate (v-time / 3600, 0)) + ":" + string((v-time modulo 3600) / 60,"99")  + ":" + string((v-time modulo 3600) / 360,"99").
     1437     if p-check-type <> "" then v-check-type = "Тип чека: " + ChkType(integer(p-check-type)) .
     1438     else v-check-type = "По всем типам чеков" .
     1439     if p-osnov-corr <> "0" then v-osnov-corr_name = "Документ основания: " + OsnovCorr(integer(p-osnov-corr)) .
     1440     if p-date-corr <> ? then v-date-corr_name = "Дата документа основания: " + string(p-date-corr) .
     1441     if p-num-corr <> "" then v-num-corr_name = "Номер документа основания: " + p-num-corr .
     1442     if p-check-type = "" then p-check-type = 'Продажа,1,Возврат,6,ВзврСпис,96,СбросТрнзкц,14,Перелив,15,ПеревТрнзкц,16,РазблТрнзкц,36,ТехПролив,17,Списание,69,Аннуляция,8,Инвентаризация,11,Закрытие_смены,13,Открытие_смены,40,Z-отчет,12,_Продажа,101,_Возврат,106,_ВзврСпис,196,_СбросТрнзкц,114,_Перелив,115,_ПеревТрнзкц,116,_ТехПролив,117,_Списание,169,_Аннуляция,108,_Инвентаризация,111,_Z-отчет,112,_СбросТрнзкц,114,_РазблТрнзкц,136,_Закрытие_смены,113,>Продажа,201,>Возврат,206,>Аннуляция,208,>>Продажа,301,>>Возврат,306,Инкассация,2,Касс_фонд,3,Перевод_опл,4,Расход_кассы,5,Декл_ден_ящ,7,Приход_Корр,43,Расход_Корр,44':U .
     1443     case p-shift:
     1444       when 0 then
     1445         v-shift = "По всем сменам" .
     1446       when 1 then
     1447         v-shift = "По закрытым сменам" .
     1448       when 2 then
     1449         v-shift = "По открытым сменам" .
     1450     end case.
     1451     for each obj-list no-lock:
     1452       if v-list-obj = "" then v-list-obj = string(obj-list.obj-code).
     1453       else v-list-obj = v-list-obj + ", " + string(obj-list.obj-code).
     1454       if x-TOG-Shift then
     1455       do:
     1456         for each buf_chk-doc no-lock
     1457           where buf_chk-doc.obj-code = obj-list.obj-code
     1458           and buf_chk-doc.obj-type = obj-list.obj-type
     1459           and buf_chk-doc.shift-date >= x-Date-Start
     1460           and buf_chk-doc.shift-date <= x-Date-End
     1461           and buf_chk-doc.out-code <> ?:
     1462           if p-check-type <> "" then
     1463           do:
     1464             if lookup(string(buf_chk-doc.chk-type), p-check-type) = 0 then next .
     1465           end.
     1466           if (buf_chk-doc.shift-date = X-date-Start)
     1467             and (buf_chk-doc.shift-num < x-Shift-Start) then next.
     1468           if (buf_chk-doc.shift-date = X-date-End)
     1469             and (buf_chk-doc.shift-num > x-Shift-End) then next.
     1470           run report .
     1471         end.
     1472       end.
     1473       else
     1474       do:
     1475         for each buf_chk-doc no-lock
     1476           where buf_chk-doc.obj-code = obj-list.obj-code
     1477           and buf_chk-doc.obj-type = obj-list.obj-type
     1478           and buf_chk-doc.chk-date >= x-Date-Start
     1479           and buf_chk-doc.chk-date <= x-Date-End
     1480           and buf_chk-doc.out-code <> ?
     1481           :
     1482           if p-check-type <> "" then
     1483           do:
     1484             if lookup(string(buf_chk-doc.chk-type), p-check-type) = 0 then next .
     1485           end.
     1486           run report .
     1487         end.
     1488       end.
     1489   procedure report:
     1490     if p-shift > 0 then
     1491     do:
     1492       if p-shift = 1 then
     1493       do:
     1494         find first buf_shift-obj no-lock where buf_shift-obj.obj-code = buf_chk-doc.obj-code
     1495           and buf_shift-obj.obj-type = buf_chk-doc.obj-type
     1496           and buf_shift-obj.shift-date = buf_chk-doc.shift-date
     1497           and buf_shift-obj.shift-num = buf_chk-doc.shift-num
     1498           and buf_shift-obj.status_ = 'зкр':U no-error .
     1499       end.
     1500       else
     1501       do:
     1502         find first buf_shift-obj no-lock where buf_shift-obj.obj-code = buf_chk-doc.obj-code
     1503           and buf_shift-obj.obj-type = buf_chk-doc.obj-type
     1504           and buf_shift-obj.shift-date = buf_chk-doc.shift-date
     1505           and buf_shift-obj.shift-num = buf_chk-doc.shift-num
     1506           and buf_shift-obj.status_ = 'тек':U no-error .
     1507       end.
     1508       if not available (buf_shift-obj) then next .
     1509     end.
     1510     find first buf_chk-doc-attr exclusive-lock where buf_chk-doc-attr.doc-code = buf_chk-doc.doc-code
     1511       and buf_chk-doc-attr.attr-code  = "create-type" and buf_chk-doc-attr.attr-value = "manual" no-error .
     1512     if not available (buf_chk-doc-attr) then
     1513     do:
     1514       if buf_chk-doc.chk-type <> integer('43':U) and buf_chk-doc.chk-type <> integer('44':U) then next .
     1515       if num-entries(buf_chk-doc.doc-num, ",") > 2 then v-osnov-corr = entry(3,buf_chk-doc.doc-num,",") .
     1516       if p-osnov-corr <> "0" and p-osnov-corr <> "" then
     1517         if v-osnov-corr <> p-osnov-corr then next .
     1518       if num-entries(buf_chk-doc.doc-num, ",") > 0 then v-date-corr = entry(1,buf_chk-doc.doc-num,",") .
     1519       if p-date-corr <> ? then
     1520         if p-date-corr <> date(v-date-corr) then next .
     1521       if num-entries(buf_chk-doc.doc-num, ",") > 1 then v-num-corr = entry(2,buf_chk-doc.doc-num,",") .
     1522       if p-num-corr <> "" then
     1523         if p-num-corr <> v-num-corr then next .
     1524     end.
     1525     else
     1526     do:
     1527       if p-osnov-corr <> "0" and p-osnov-corr <> "" then
     1528       do:
     1529         find first buf_chk-doc-attr no-lock where buf_chk-doc-attr.doc-code = buf_chk-doc.doc-code
     1530           and buf_chk-doc-attr.attr-code = "corr-osnov" and buf_chk-doc-attr.attr-value = string(p-osnov-corr) no-error .
     1531         if not available (buf_chk-doc-attr) then next .
     1532         else v-osnov-corr = OsnovCorr(integer(p-osnov-corr)) .
     1533       end.
     1534       else
     1535       do:
     1536         find first buf_chk-doc-attr no-lock where buf_chk-doc-attr.doc-code = buf_chk-doc.doc-code
     1537           and buf_chk-doc-attr.attr-code = "corr-osnov" no-error .
     1538         if available (buf_chk-doc-attr) then v-osnov-corr = OsnovCorr(integer(buf_chk-doc-attr.attr-value)) .
     1539       end.
     1540       if p-date-corr <> ? then
     1541       do:
     1542         find first buf_chk-doc-attr no-lock where buf_chk-doc-attr.doc-code = buf_chk-doc.doc-code
     1543           and buf_chk-doc-attr.attr-code = "corr-date" and buf_chk-doc-attr.attr-value = string(p-date-corr) no-error .
     1544         if not available (buf_chk-doc-attr) then next .
     1545         else v-date-corr = string(p-date-corr) .
     1546       end.
     1547       else
     1548       do:
     1549         find first buf_chk-doc-attr no-lock where buf_chk-doc-attr.doc-code = buf_chk-doc.doc-code
     1550           and buf_chk-doc-attr.attr-code = "corr-date" no-error .
     1551         if available (buf_chk-doc-attr) then v-date-corr = buf_chk-doc-attr.attr-value .
     1552       end.
     1553       if p-num-corr <> "" then
     1554       do:
     1555         find first buf_chk-doc-attr no-lock where buf_chk-doc-attr.doc-code = buf_chk-doc.doc-code
     1556           and buf_chk-doc-attr.attr-code = "corr-num" and buf_chk-doc-attr.attr-value = p-num-corr no-error .
     1557         if not available (buf_chk-doc-attr) then next .
     1558         else v-num-corr = p-num-corr .
     1559       end.
     1560       else
     1561       do:
     1562         find first buf_chk-doc-attr no-lock where buf_chk-doc-attr.doc-code = buf_chk-doc.doc-code
     1563           and buf_chk-doc-attr.attr-code = "corr-num" no-error .
     1564         if available (buf_chk-doc-attr) then v-num-corr = buf_chk-doc-attr.attr-value .
     1565       end.
     1566     end.
     1567     v-create-shift-date = ? .
     1568     v-create-shift-num = 0 .
     1569     find first buf_chk-doc-attr exclusive-lock where buf_chk-doc-attr.doc-code = buf_chk-doc.doc-code
     1570       and buf_chk-doc-attr.attr-code  = "create-shift-num" no-error .
     1571     if available (buf_chk-doc-attr) then v-create-shift-num = integer (buf_chk-doc-attr.attr-value) .
     1572     find first buf_chk-doc-attr exclusive-lock where buf_chk-doc-attr.doc-code = buf_chk-doc.doc-code
     1573       and buf_chk-doc-attr.attr-code  = "create-shift-date" no-error .
     1574     if available (buf_chk-doc-attr) then v-create-shift-date = date (buf_chk-doc-attr.attr-value) .
     1575     find first buf_chk-doc-attr exclusive-lock where buf_chk-doc-attr.doc-code = buf_chk-doc.doc-code
     1576       and buf_chk-doc-attr.attr-code  = "create-date" no-error .
     1577     if available (buf_chk-doc-attr) then v-create-date = buf_chk-doc-attr.attr-value .
     1578     find first buf_chk-doc-attr exclusive-lock where buf_chk-doc-attr.doc-code = buf_chk-doc.doc-code
     1579       and buf_chk-doc-attr.attr-code  = "create-time" no-error .
     1580     if available (buf_chk-doc-attr) then v-create-time = buf_chk-doc-attr.attr-value .
     1581     if (v-create-shift-date = buf_chk-doc.shift-date and v-create-shift-num = buf_chk-doc.shift-num) or v-create-shift-date = ? or v-create-shift-num = 0 then v-shift-status =  "-" .
     1582     else v-shift-status = "да" .
     1583     create tt-corr-check .
     1584     assign
     1585       tt-corr-check.obj-code    = buf_chk-doc.obj-code
     1586       tt-corr-check.shift-corr  = if v-create-shift-date <> ? then string(v-create-shift-date) + " " + string(v-create-shift-num) else string(v-create-shift-num)
     1587       tt-corr-check.shift-num   = string(buf_chk-doc.shift-date) + " " + string(buf_chk-doc.shift-num)
     1588       tt-corr-check.shift-close = v-shift-status
     1589       tt-corr-check.cash-num    = buf_chk-doc.pay-desk
     1590       tt-corr-check.chk-num     = string(buf_chk-doc.doc-code)
     1591       tt-corr-check.num-z       = buf_chk-doc.z-number
     1592       tt-corr-check.time-chk    = string(buf_chk-doc.chk-date,"99.99.9999") + " " + string(buf_chk-doc.chk-time,"HH:MM:SS")
     1593       tt-corr-check.date-corr   = string (v-create-date) + " " + string (v-create-time)
     1594       tt-corr-check.chk-sum     = buf_chk-doc.tot-doc
     1595       tt-corr-check.osnov-corr  = v-osnov-corr
     1596       tt-corr-check.date-osnov  = date(v-date-corr)
     1597       tt-corr-check.num-corr    = v-num-corr
     1598       tt-corr-check.sum-paytype = 0 .
     1599       tt-corr-check.chk-type    = ChkType(buf_chk-doc.chk-type)
     1600       .
     1601       run clients-write(INPUT buf_chk-doc.obj-code, INPUT buf_chk-doc.obj-type, OUTPUT tt-corr-check.obj-name) no-error .
     1602     for each buf_chk-pay no-lock where buf_chk-pay.doc-code = buf_chk-doc.doc-code:
     1603       assign
     1604         tt-corr-check.sum-paytype = buf_chk-pay.tot-sum
     1605         .
     1606       tt-corr-check.pay-type    = PayType(buf_chk-pay.pay-code).
     1607     end.
     1608   end procedure .
     1609       run get-report-num (output p-report-id).
     1610       v-file-name-rep-htm = session:temp-directory + string(p-report-id) + ".html".
     1611       ii = 0 .
     1612       output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8'.
     1613       put stream OutStr-html unformatted
     1614         "<!DOCTYPE HTML>" skip
     1615         ' <html>' skip
     1616         '  <head>' skip
     1617         '   <meta charset="utf-8">' skip
     1618         '    <style type="text/css">' skip
     1619         '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     1620         '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     1621         '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black; height: 14px;' + chr(125) skip
     1622         '   </style>' skip
     1623         '  </head>' skip
     1624         .
     1625       put stream OutStr-html unformatted
     1626         '<body>' skip
     1627         '<TABLE name="1"  fit_to_page="true" orientation="landscape" CELLSPACING="0" BORDER="0">'skip
     1628         '<thead>' skip
     1629         .
     1630       put stream OutStr-html unformatted
     1631         '<tr>' skip
     1632         '<td style="width: 40px;"></td>' skip
     1633         '<td style="width: 100px;"></td>' skip
     1634         '<td style="width: 100px;"></td>' skip
     1635         '<td style="width: 100px;"></td>' skip
     1636         '<td style="width: 100px;"></td>' skip
     1637         '<td style="width: 100px;"></td>' skip
     1638         '<td style="width: 100px;"></td>' skip
     1639         '<td style="width: 100px;"></td>' skip
     1640         '<td style="width: 100px;"></td>' skip
     1641         '<td style="width: 100px;"></td>' skip
     1642         '<td style="width: 100px;"></td>' skip
     1643         '<td style="width: 100px;"></td>' skip
     1644         '<td style="width: 100px;"></td>' skip
     1645         '<td style="width: 100px;"></td>' skip
     1646         '<td style="width: 100px;"></td>' skip
     1647         '<td style="width: 100px;"></td>' skip
     1648         '<td style="width: 100px;"></td>' skip
     1649         '</tr>' skip
     1650         .
     1651       put stream OutStr-html unformatted
     1652         '<TR><TD colspan="17"></TD></TR>' skip
     1653         '<TR>' skip
     1654         '<TD colspan="17" style="font-weight: bold;">Отчет по Транзакциям коррекции</TD>' skip
     1655         '</TR>'skip
     1656         '<TR>' skip
     1657         '<TD colspan="17">' + v-period + '</TD>' skip
     1658         '</TR>'skip
     1659         '<TR>' skip
     1660         '<TD colspan="17">' + v-obj-name + '</TD>' skip
     1661         '</TR>'skip
     1662         '<TR>' skip
     1663         '<TD colspan="17">Выбор объекта:</TD>' skip
     1664         '</TR>'skip
     1665         '<TR>' skip
     1666         '<TD colspan="17">' + "АЗК №" + v-list-obj + " маг" + '</TD>' skip
     1667         '</TR>'skip
     1668         '<TR>' skip
     1669         '<TD colspan="17">' + v-print-date + '</TD>' skip
     1670         '</TR>'skip
     1671         .
     1672       if v-check-type <> "" then
     1673       do:
     1674         put stream OutStr-html unformatted
     1675           '<TR><TD colspan="17">' + v-check-type + '</TD></TR>' skip
     1676           .
     1677       end.
     1678       if v-osnov-corr_name <> "" then
     1679       do:
     1680         put stream OutStr-html unformatted
     1681           '<TR><TD colspan="17">' + v-osnov-corr_name + '</TD></TR>' skip
     1682           .
     1683       end.
     1684       if v-date-corr_name <> "" then
     1685       do:
     1686         put stream OutStr-html unformatted
     1687           '<TR><TD colspan="17">' + v-date-corr_name + '</TD></TR>' skip
     1688           .
     1689       end.
     1690       if v-num-corr_name <> "" then
     1691       do:
     1692         put stream OutStr-html unformatted
     1693           '<TR><TD colspan="17">' + v-num-corr_name + '</TD></TR>' skip
     1694           .
     1695       end.
     1696       if v-shift <> "" then
     1697       do:
     1698         put stream OutStr-html unformatted
     1699           '<TR><TD colspan="17">' + v-shift + '</TD></TR>' skip
     1700           .
     1701       end.
     1702       put stream OutStr-html unformatted
     1703         '</thead>' skip
     1704         '<tbody>' skip
     1705         .
     1706       put stream OutStr-html unformatted
     1707         '<TR>' skip
     1708         '<TD text_wrap="true" style="text-align: center;">№</TD>' skip
     1709         '<TD text_wrap="true" style="text-align: center;">АЗС</TD>' skip
     1710         '<TD text_wrap="true" style="text-align: center;">Смена корректи- руемого расчета</TD>' skip
     1711         '<TD text_wrap="true" style="text-align: center;">Смена формиро- вания транзакции</TD>' skip
     1712         '<TD text_wrap="true" style="text-align: center;">Корр. в закрытой смене</TD>' skip
     1713         '<TD text_wrap="true" style="text-align: center;">Касса</TD>' skip
     1714         '<TD text_wrap="true" style="text-align: center;">Номер чека</TD>' skip
     1715         '<TD text_wrap="true" style="text-align: center;">Номер Z-отчета</TD>' skip
     1716         '<TD text_wrap="true" style="text-align: center;">Дата и время формиро- вания транзакции</TD>' skip
     1717         '<TD text_wrap="true" style="text-align: center;">Дата корректи- руемого расчета</TD>' skip
     1718         '<TD text_wrap="true" style="text-align: center;">Тип чека</TD>' skip
     1719         '<TD text_wrap="true" style="text-align: center;">Сумма чека, руб.</TD>' skip
     1720         '<TD text_wrap="true" style="text-align: center;">Тип оплаты</TD>' skip
     1721         '<TD text_wrap="true" style="text-align: center;">Сумма по типу оплаты</TD>' skip
     1722         '<TD text_wrap="true" style="text-align: center;">Документ основания для коррекции</TD>' skip
     1723         '<TD text_wrap="true" style="text-align: center;">Дата документа основания</TD>' skip
     1724         '<TD text_wrap="true" style="text-align: center;">Номер документа основания</TD>' skip
     1725         '</TR>'skip
     1726         .
     1727       for each buf_tt-corr-check by obj-code:
     1728         ii = ii + 1 .
     1729         put stream OutStr-html unformatted
     1730           '<TR>' skip
     1731           '<TD text_wrap="true" style="text-align: center;">' + string(ii) + '</TD>' skip
     1732           '<TD text_wrap="true" style="text-align: center;">' + string(buf_tt-corr-check.obj-name) + '</TD>' skip
     1733           '<TD text_wrap="true" style="text-align: center;">' + string(buf_tt-corr-check.shift-num) + '</TD>' skip
     1734           '<TD text_wrap="true" style="text-align: center;">' + string(buf_tt-corr-check.shift-corr) + '</TD>' skip
     1735           '<TD text_wrap="true" style="text-align: center;">' + string(buf_tt-corr-check.shift-close) + '</TD>' skip
     1736           '<TD text_wrap="true" style="text-align: center;">' + string(buf_tt-corr-check.cash-num) + '</TD>' skip
     1737           '<TD text_wrap="true" style="text-align: center;">' + string(buf_tt-corr-check.chk-num) + '</TD>' skip
     1738           '<TD text_wrap="true" style="text-align: center;">' + string(buf_tt-corr-check.num-z) + '</TD>' skip
     1739           '<TD text_wrap="true" style="text-align: center;">' + string(buf_tt-corr-check.date-corr) + '</TD>' skip
     1740           '<TD text_wrap="true" style="text-align: center;">' + string(buf_tt-corr-check.time-chk) + '</TD>' skip
     1741           '<TD text_wrap="true" style="text-align: center;">' + string(buf_tt-corr-check.chk-type) + '</TD>' skip
     1742           '<TD text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(buf_tt-corr-check.chk-sum,"->>>>>>>>>>>9.99",2) + '" style="text-align: right;">' + fnc-convert-dot-to-colon(buf_tt-corr-check.chk-sum,"->>>>>>>>>>>9.99",2) + '</TD>' skip
     1743           '<TD text_wrap="true" style="text-align: center;">' + if buf_tt-corr-check.pay-type = "" then "Служебн." + '</TD>' else buf_tt-corr-check.pay-type + '</TD>' skip
     1744           '<TD text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(buf_tt-corr-check.sum-paytype,"->>>>>>>>>>>9.99",2) + '" style="text-align: right;">' + fnc-convert-dot-to-colon(buf_tt-corr-check.sum-paytype,"->>>>>>>>>>>9.99",2) + '</TD>' skip
     1745           '<TD text_wrap="true" style="text-align: center;">' + if buf_tt-corr-check.osnov-corr <> "" then string(buf_tt-corr-check.osnov-corr) + '</TD>' else ""  + '</TD>' skip
     1746           '<TD text_wrap="true" style="text-align: center;">' + if buf_tt-corr-check.date-osnov <> ? then string(buf_tt-corr-check.date-osnov) + '</TD>' else "" + '</TD>' skip
     1747           '<TD text_wrap="true" style="text-align: center;">' + if buf_tt-corr-check.num-corr <> "" then string(buf_tt-corr-check.num-corr) + '</TD>' else "" + '</TD>' skip
     1748           '</TR>'skip
     1749           .
     1750       end.
     1751     end.
     1752     put stream OutStr-html unformatted
     1753       '</table>' skip
     1754       '</body>' skip
     1755       '</html>' skip
     1756       .
     1757     output stream OutStr-html close.
     1758     run prn-lib-reportviewer-report-name in this-procedure (
     1759       input THIS-PROCEDURE
     1760       ,input v-file-name-rep-htm
     1761       ).
     1762   PROCEDURE get-report-num :
     1763     define output parameter p-report-num as integer no-undo .
     1764     do
     1765       on error undo, return error return-value
     1766       :
     1767       run gbl/getrpnum.p (output p-report-num).
     1768     end.
     1769   END PROCEDURE.
     1770   procedure clients-write:
     1771     DEFINE input PARAMETER   p-obj-code      as integer      no-undo .
     1772     DEFINE INPUT PARAMETER   p-obj-type      as character    no-undo .
     1773     DEFINE OUTPUT PARAMETER  p-obj-name      as character    no-undo .
     1774     find first buf_clients no-lock where buf_clients.obj-code = p-obj-code
     1775       and buf_clients.obj-type = p-obj-type no-error .
     1776     if AVAILABLE buf_clients then
     1777     do:
     1778       p-obj-name = buf_clients.obj-name .
     1779     end.
     1780   end.
     1781   end.
