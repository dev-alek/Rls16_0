      498     Col-name[248]=   'IN':U
      499     Col-name[249]=   'IO':U
      500     Col-name[250]=   'IP':U
      501     Col-name[251]=   'IQ':U
      502     Col-name[252]=   'IR':U
      503     Col-name[253]=   'IS':U
      504     Col-name[254]=   'IT':U
      505     Col-name[255]=   'IU':U
      506     Col-name[256]=   'IV':U
      507     .
      508    end.
      509   end procedure.
      510   do
      511   on error undo, return error
      512   :
      513       run rep/d-report.w ( input parparentproc
      514                          , input "rep/e-tap.w":U
      515                          , input "Акт переоценки за период ТАП1-ДО":U
      516                          , input 4
      517                          , input "1,2,4,5":U
      518                          , input "2":U
      519                          , input "":U
      520                          , input "":U
      521                          , input "all,1,10":U
      522                          , input no
      523                          ) .
      524   end.
