     4443     skip.
     4444                end.
     4445      when ""  then     do :
     4446       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     4447         p3 @ s-bar-code
     4448         p4 @ gds-zap-artic
     4449         p5 @ gds-zap-gds-name
     4450         p6 @ gds-zap-unit-base
     4451         p1 @ gds-type
     4452         ostatok-start [p2] format "->>>>>>>>>>9.<<<" @  F-ostatok-start
     4453         Prih          [p2] format "->>>>>>>>>>9.<<<" @  F-Prih
     4454         RAsh          [p2] format "->>>>>>>>>>9.<<<" @  F-RAsh
     4455         KAssa         [p2] format "->>>>>>>>>>9.<<<" @  F-KAssa
     4456         Inv           [p2] format "->>>>>>>>>>9.<<<" @  F-Inv
     4457         Overturn      [p2] format "->>>>>>>>>>9.<<<" @  F-Overturn
     4458         Ostatok-end   [p2] format "->>>>>>>>>>9.<<<" @  F-Ostatok-end
     4459         gds-zap-other      format "->>>>>>>>>>9.<<<" when (p2 = 1) @  gds-zap-other
     4460         with FRAME ZAPAS .
     4461    if  p2 > 10  then f_e = 10 .
     4462                 else f_e =  0 .
     4463   if Make-Excel then  put   stream ForExcel unformatted
     4464     p3 CHR(9)
     4465     p4 CHR(9)
     4466     if f_e = 0 then g1 else p5 CHR(9)
     4467     p6 CHR(9)
     4468     gds-zap-type CHR(9)
     4469     excel-sum(gds-zap-other   )  CHR(9)
     4470     excel-qnty(ostatok-start[1  + f_e ])  CHR(9)
     4471     excel-sum(ostatok-start[2  + f_e ])  CHR(9)
     4472     excel-sum(ostatok-start[5  + f_e ])  CHR(9)
     4473     excel-sum(ostatok-start[8  + f_e ])  CHR(9)
     4474     .
     4475     if Make-Excel then  put   stream ForExcel unformatted
     4476     excel-sum(ostatok-start[3  + f_e ])  CHR(9)
     4477     excel-sum(ostatok-start[6  + f_e ])  CHR(9)
     4478     excel-sum(ostatok-start[9  + f_e ])  CHR(9)
     4479     excel-qnty(Prih        [1  + f_e ])  CHR(9)
     4480     excel-sum(Prih         [2  + f_e ])  CHR(9)
     4481     excel-sum(Prih         [5  + f_e ])  CHR(9)
     4482     excel-sum(Prih         [8  + f_e ])  CHR(9)
     4483     excel-sum(Prih         [3  + f_e ])  CHR(9)
     4484     excel-sum(Prih         [6  + f_e ])  CHR(9)
     4485     excel-sum(Prih         [9  + f_e ])  CHR(9)
     4486     .
     4487     if Make-Excel then  put   stream ForExcel unformatted
     4488     excel-qnty(RAsh        [1  + f_e ])  CHR(9)
     4489     excel-sum(RAsh         [2  + f_e ])  CHR(9)
     4490     excel-sum(RAsh         [5  + f_e ])  CHR(9)
     4491     excel-sum(RAsh         [8  + f_e ])  CHR(9)
     4492     excel-sum(RAsh         [3  + f_e ])  CHR(9)
     4493     excel-sum(RAsh         [6  + f_e ])  CHR(9)
     4494     excel-sum(RAsh         [9  + f_e ])  CHR(9)
     4495     excel-qnty(KAssa       [1  + f_e ])  CHR(9)
     4496     excel-sum(KAssa        [2  + f_e ])  CHR(9)
     4497     excel-sum(KAssa        [5  + f_e ])  CHR(9)
     4498     excel-sum(KAssa        [8  + f_e ])  CHR(9)
     4499     excel-sum(KAssa        [3  + f_e ])  CHR(9)
     4500     excel-sum(KAssa        [6  + f_e ])  CHR(9)
     4501     .
     4502     if Make-Excel then  put   stream ForExcel unformatted
     4503     excel-sum(KAssa        [9  + f_e ])  CHR(9)
     4504     excel-qnty(Inv         [1  + f_e ])  CHR(9)
     4505     excel-sum(Inv          [2  + f_e ])  CHR(9)
     4506     excel-sum(Inv          [5  + f_e ])  CHR(9)
     4507     excel-sum(Inv          [8  + f_e ])  CHR(9)
     4508     excel-sum(Inv          [3  + f_e ])  CHR(9)
     4509     excel-sum(Inv          [6  + f_e ])  CHR(9)
     4510     excel-sum(Inv          [9  + f_e ])  CHR(9)
     4511     .
     4512     if Make-Excel then  put   stream ForExcel unformatted
     4513     excel-qnty(Overturn    [1  + f_e ])  CHR(9)
     4514     excel-sum(Overturn     [2  + f_e ])  CHR(9)
     4515     excel-sum(Overturn     [5  + f_e ])  CHR(9)
     4516     excel-sum(Overturn     [8  + f_e ])  CHR(9)
     4517     excel-sum(Overturn     [3  + f_e ])  CHR(9)
     4518     excel-sum(Overturn     [6  + f_e ])  CHR(9)
     4519     excel-sum(Overturn     [9  + f_e ])  CHR(9)
     4520     excel-qnty(Ostatok-end [1  + f_e ])  CHR(9)
     4521     excel-sum(Ostatok-end  [2  + f_e ])  CHR(9)
     4522     excel-sum(Ostatok-end  [5  + f_e ])  CHR(9)
     4523     excel-sum(Ostatok-end  [8  + f_e ])  CHR(9)
     4524     excel-sum(Ostatok-end  [3  + f_e ])  CHR(9)
     4525     excel-sum(Ostatok-end  [6  + f_e ])  CHR(9)
     4526     excel-sum(Ostatok-end  [9  + f_e ])  CHR(9)
     4527     g2
     4528     skip.
     4529                 end.
     4530      end case.
     4531                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     4532    end procedure.
     4533   procedure ost-line-body :
     4534   do on error undo, return error return-value :
     4535   define input parameter p-num        as   integer   no-undo .
     4536   define input parameter p-store-type like ub.clients.obj-type no-undo .
     4537   define input parameter p-store-code like ub.clients.obj-code no-undo .
     4538    find last  ub.aht-stk-line where
     4539                           ub.aht-stk-line.gds-code   = gds-zap-b-code
     4540                     and   ub.aht-stk-line.fact-order <= fact-order-1
     4541                     and   ub.aht-stk-line.obj-code   = p-store-code
     4542                     and   ub.aht-stk-line.obj-type   = p-store-type
     4543                     and   ub.aht-stk-line.sum-type   = x-type-pr
     4544                           use-index category no-lock no-error.
     4545           if available ub.aht-stk-line then do:
     4546               if  tprintrubl  then
     4547                     assign
     4548                           ostatok-start[1 + p-num]  = ostatok-start[1 + p-num] +  (if ub.aht-stk-line.sum-type <> "b"
     4549                                                                   then round( ub.aht-stk-line.fact-qnty,3) else 0 )
     4550                           ostatok-start[2 + p-num]  =ostatok-start[2 + p-num] +  round( ub.aht-stk-line.cost-sum-rubl ,2)
     4551                           ostatok-start[3 + p-num]  =ostatok-start[3 + p-num] +  round( ub.aht-stk-line.cost-vat-rubl ,2)
     4552                           ostatok-start[4 + p-num]  =ostatok-start[4 + p-num] +  0
     4553                           ostatok-start[5 + p-num]  =ostatok-start[5 + p-num]  + round( ub.aht-stk-line.crsa-sum-rubl ,2)
     4554                           ostatok-start[6 + p-num]  =ostatok-start[6 + p-num]  + round( ub.aht-stk-line.crsa-vat-rubl ,2)
     4555                           ostatok-start[7 + p-num]  =ostatok-start[7 + p-num]  + round( ub.aht-stk-line.sale-discnt-rubl ,2)
     4556                           ostatok-start[8 + p-num]  =ostatok-start[8 + p-num]  + round( ub.aht-stk-line.crsa-sum-rubl ,2)
     4557                           ostatok-start[9 + p-num]  =ostatok-start[9 + p-num]  + round( ub.aht-stk-line.crsa-vat-rubl ,2)
     4558                           ostatok-start[10 + p-num] =ostatok-start[10 + p-num] + round( ub.aht-stk-line.crsa-slt-rubl ,2)
     4559                           .
     4560                 else
     4561                     assign
     4562                           ostatok-start[1 + p-num]  = ostatok-start[1 + p-num] + (if ub.aht-stk-line.sum-type <> "b"
     4563                                                                      then round( ub.aht-stk-line.fact-qnty,3) else 0 )
     4564                           ostatok-start[2 + p-num]  = ostatok-start[2 + p-num] +  round( ub.aht-stk-line.cost-sum-base ,2)
     4565                           ostatok-start[3 + p-num]  = ostatok-start[3 + p-num] +  round( ub.aht-stk-line.cost-vat-base ,2)
     4566                           ostatok-start[4 + p-num]  = ostatok-start[4 + p-num] +  0
     4567                           ostatok-start[5 + p-num]  = ostatok-start[5 + p-num]  + round( ub.aht-stk-line.crsa-sum-base ,2)
     4568                           ostatok-start[6 + p-num]  = ostatok-start[6 + p-num]  + round( ub.aht-stk-line.crsa-vat-base ,2)
     4569                           ostatok-start[7 + p-num]  = ostatok-start[7 + p-num]  + round( ub.aht-stk-line.sale-discnt-base ,2)
     4570                           ostatok-start[8 + p-num]  = ostatok-start[8 + p-num]  + round( ub.aht-stk-line.crsa-sum-base ,2)
     4571                           ostatok-start[9 + p-num]  = ostatok-start[9 + p-num]  + round( ub.aht-stk-line.crsa-vat-base ,2)
     4572                           ostatok-start[10 + p-num] = ostatok-start[10 + p-num] + round( ub.aht-stk-line.crsa-slt-base ,2)
     4573                     .
     4574                end.
     4575    find last  ub.aht-stk-line where
     4576                           ub.aht-stk-line.gds-code   = gds-zap-b-code
     4577                     and   ub.aht-stk-line.fact-order <= fact-order-2
     4578                     and   ub.aht-stk-line.obj-code   = p-store-code
     4579                     and   ub.aht-stk-line.obj-type   = p-store-type
     4580                     and   ub.aht-stk-line.sum-type   = x-type-pr
     4581                           use-index category no-lock no-error.
     4582           if available ub.aht-stk-line then do:
     4583               if  tprintrubl  then
     4584                     assign
     4585                           ostatok-end[1 + p-num]  = ostatok-end[1 + p-num] + (if ub.aht-stk-line.sum-type <> "b"
     4586                                                                  then round( ub.aht-stk-line.fact-qnty,3) else 0 )
     4587                           ostatok-end[2 + p-num]  = ostatok-end[2 + p-num] + round( ub.aht-stk-line.cost-sum-rubl ,2)
     4588                           ostatok-end[3 + p-num]  = ostatok-end[3 + p-num] + round( ub.aht-stk-line.cost-vat-rubl ,2)
     4589                           ostatok-end[4 + p-num]  = ostatok-end[4 + p-num] + 0
     4590                           ostatok-end[5 + p-num]  = ostatok-end[5 + p-num] + round( ub.aht-stk-line.crsa-sum-rubl ,2)
     4591                           ostatok-end[6 + p-num]  = ostatok-end[6 + p-num] + round( ub.aht-stk-line.crsa-vat-rubl ,2)
     4592                           ostatok-end[7 + p-num]  = ostatok-end[7 + p-num] + round( ub.aht-stk-line.sale-discnt-rubl ,2)
     4593                           ostatok-end[8 + p-num]  = ostatok-end[8 + p-num] + round( ub.aht-stk-line.crsa-sum-rubl ,2)
     4594                           ostatok-end[9 + p-num]  = ostatok-end[9 + p-num] + round( ub.aht-stk-line.crsa-vat-rubl ,2)
     4595                           ostatok-end[10 + p-num] = ostatok-end[10 + p-num] + round( ub.aht-stk-line.crsa-slt-rubl ,2)
     4596                           .
     4597                 else
     4598                     assign
     4599                           ostatok-end[1 + p-num]  = ostatok-end[1 + p-num] +  (if ub.aht-stk-line.sum-type <> "b"
     4600                                                                   then round( ub.aht-stk-line.fact-qnty,3) else 0 )
     4601                           ostatok-end[2 + p-num]  = ostatok-end[2 + p-num] +  round( ub.aht-stk-line.cost-sum-base ,2)
     4602                           ostatok-end[3 + p-num]  = ostatok-end[3 + p-num] +  round( ub.aht-stk-line.cost-vat-base ,2)
     4603                           ostatok-end[4 + p-num]  = ostatok-end[4 + p-num] +  0
     4604                           ostatok-end[5 + p-num]  = ostatok-end[5 + p-num] +  round( ub.aht-stk-line.crsa-sum-base ,2)
     4605                           ostatok-end[6 + p-num]  = ostatok-end[6 + p-num] +  round( ub.aht-stk-line.crsa-vat-base ,2)
     4606                           ostatok-end[7 + p-num]  = ostatok-end[7 + p-num] +  round( ub.aht-stk-line.sale-discnt-base ,2)
     4607                           ostatok-end[8 + p-num]  = ostatok-end[8 + p-num] +  round( ub.aht-stk-line.crsa-sum-base ,2)
     4608                           ostatok-end[9 + p-num]  = ostatok-end[9 + p-num] +  round( ub.aht-stk-line.crsa-vat-base ,2)
     4609                           ostatok-end[10 + p-num] = ostatok-end[10 + p-num] + round( ub.aht-stk-line.crsa-slt-base ,2)
     4610                     .
     4611                end.
     4612   end.
     4613   end procedure.
     4614   procedure ob-line  :
     4615   do on error undo, return error return-value :
     4616   def input  parameter x-store-code     like ub.clients.obj-code         no-undo .
     4617   def input  parameter x-store-type     like ub.clients.obj-type         no-undo .
     4618   def input  parameter x-gds-code       like ub.aht-ot-line.gds-code     no-undo .
     4619   def input  parameter x-fact-order-1   like ub.aht-ot-line.fact-order   no-undo .
     4620   def input  parameter x-fact-order-2   like ub.aht-ot-line.fact-order   no-undo .
     4621   def input  parameter x-sum-type       like ub.aht-ot-line.sum-type     no-undo .
     4622   def input  parameter xtog-obj         as logical no-undo .
     4623   define variable      tt#              as integer no-undo .
     4624   define variable x-type-pr1 as character no-undo .
     4625   define variable x-type-pr2 as character no-undo .
     4626   define variable p-ok as logical   no-undo .
     4627    if x-sum-type = arh-type-cost then tt# = 0 .
     4628    if x-sum-type = arh-type-crsa then tt# = 3 .
     4629    if x-sum-type = arh-type-sale then tt# = 6 .
     4630   if  x-sum-type = "cb" then
     4631    assign
     4632       x-type-pr1 = "c"
     4633       x-type-pr2 = "b"
     4634    .
     4635   else
     4636    assign
     4637       x-type-pr1 = x-sum-type
     4638       x-type-pr2 = x-sum-type
     4639    .
     4640        for each ub.aht-ot-line where
     4641                     (      ub.aht-ot-line.gds-code     = x-gds-code
     4642                     and   ub.aht-ot-line.fact-order   <= x-fact-order-2
     4643                     and   ub.aht-ot-line.fact-order   >= x-fact-order-1
     4644                     and   ub.aht-ot-line.obj-code     = x-store-code
     4645                     and   ub.aht-ot-line.obj-type     = x-store-type
     4646                     and   ub.aht-ot-line.sum-type     = x-type-pr1)
     4647                     or
     4648                     (     ub.aht-ot-line.gds-code     = x-gds-code
     4649                     and   ub.aht-ot-line.fact-order   <= x-fact-order-2
     4650                     and   ub.aht-ot-line.fact-order   >= x-fact-order-1
     4651                     and   ub.aht-ot-line.obj-code     = x-store-code
     4652                     and   ub.aht-ot-line.obj-type     = x-store-type
     4653                     and   ub.aht-ot-line.sum-type     = x-type-pr2 )
     4654                     no-lock :
     4655       if  p-tpsy = true then do:
     4656           run ver-owner2
     4657           ( input  ub.aht-ot-line.gds-code,
     4658             input  ub.aht-ot-line.obj-type,
     4659             input  ub.aht-ot-line.obj-code,
     4660             output p-ok ) .
     4661       end.
     4662       case ub.aht-ot-line.ext-doc-type:
     4663                 when        'ie':U  or
     4664                 when        're':U  or
     4665                 when        'iv':U    or
     4666                 when        'rv':U or
     4667                 when        'im':U     then
     4668                 do:
     4669                 assign
     4670                        prih[1 ]   = prih[1 ]   + (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4671                        prih[2 ]   = prih[2 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4672                        prih[3 ]   = prih[3 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4673                        prih[4 ]   = prih[4 ]
     4674                        prih[5 ]   = prih[5 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4675                        prih[6 ]   = prih[6 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4676                        prih[7 ]   = prih[7 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4677                        prih[8 ]   = prih[8 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4678                        prih[9 ]   = prih[9 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4679                        gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4680                  .
     4681        if p-ok = true then do:
     4682           assign
     4683             prih[11 ]   = prih[11 ]   + (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4684             prih[12 ]   = prih[12 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4685             prih[13 ]   = prih[13 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4686             prih[14 ]   = prih[14 ]
     4687             prih[15 ]   = prih[15 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4688             prih[16 ]   = prih[16 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4689             prih[17 ]   = prih[17 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4690             prih[18 ]   = prih[18 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4691             prih[19 ]   = prih[19 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4692             .
     4693        end.
     4694                 end.
     4695                 when       'ee':U      or
     4696                 when       'ep':U    or
     4697                 when       'ev':U     or
     4698                 when       'em':U       or
     4699                 when       'wm':U       or
     4700                 when       'we':U     then
     4701                 do:
     4702                   assign
     4703                       rash[1  ]   = rash[1 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4704                       rash[2  ]   = rash[2 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4705                       rash[3 ]   = rash[3 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4706                       rash[4 ]   = rash[4 ]
     4707                       rash[5 ]   = rash[5 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4708                       rash[6 ]   = rash[6 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4709                       rash[7 ]   = rash[7 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4710                       rash[8 ]   = rash[8 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4711                       rash[9 ]   = rash[9 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4712                       gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4713                 .
     4714                   if p-ok = true then do:
     4715                     assign
     4716                       rash[11  ]   = rash[11 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4717                       rash[12  ]   = rash[12 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4718                       rash[13 ]   = rash[13 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4719                       rash[14 ]   = rash[14 ]
     4720                       rash[15 ]   = rash[15 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4721                       rash[16 ]   = rash[16 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4722                       rash[17 ]   = rash[17 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4723                       rash[18 ]   = rash[18 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4724                       rash[19 ]   = rash[19 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4725                     .
     4726                   end.
     4727                 end.
     4728                 when       'es':U  or
     4729                 when       'rs':U then
     4730                 do:
     4731                     assign
     4732                       kassa[1  ]   = kassa[1 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4733                       kassa[2  ]   = kassa[2 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4734                       kassa[3  ]   = kassa[3 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4735                       kassa[4  ]   = kassa[4 ]
     4736                       kassa[5  ]   = kassa[5 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4737                       kassa[6  ]   = kassa[6 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4738                       kassa[7  ]   = kassa[7 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4739                       kassa[8  ]   = kassa[8 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4740                       kassa[9  ]   = kassa[9 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4741                       gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4742                       .
     4743                     if p-ok = true then
     4744                     assign
     4745                       kassa[11  ]   = kassa[11 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4746                       kassa[12  ]   = kassa[12 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4747                       kassa[13  ]   = kassa[13 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4748                       kassa[14  ]   = kassa[14 ]
     4749                       kassa[15  ]   = kassa[15 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4750                       kassa[16  ]   = kassa[16 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4751                       kassa[17  ]   = kassa[17 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4752                       kassa[18  ]   = kassa[18 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4753                       kassa[19  ]   = kassa[19 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4754                       .
     4755                 end.
     4756             when       'vt':U            or
     4757             when       'pc':U or
     4758             when       'vp':U       then do:
     4759                 assign
     4760                   inv[1  ]   = inv[1 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4761                   inv[2  ]   = inv[2 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4762                   inv[3  ]   = inv[3 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4763                   inv[4  ]   = inv[4 ]
     4764                   inv[5  ]   = inv[5 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4765                   inv[6  ]   = inv[6 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4766                   inv[7  ]   = inv[7 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4767                   inv[8  ]   = inv[8 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4768                   inv[9  ]   = inv[9 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4769                   gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4770                   .
     4771                 if p-ok = true then
     4772                 assign
     4773                   inv[11  ]   = inv[11 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4774                   inv[12  ]   = inv[12 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4775                   inv[13  ]   = inv[13 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4776                   inv[14  ]   = inv[14 ]
     4777                   inv[15  ]   = inv[15 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4778                   inv[16  ]   = inv[16 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4779                   inv[17  ]   = inv[17 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4780                   inv[18  ]   = inv[18 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4781                   inv[19  ]   = inv[19 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4782                   .
     4783                 end.
     4784             when       'ot':U or
     4785             when       'ap':U then
     4786                 do:
     4787                    assign
     4788                       overturn[1  ]   = overturn[1 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4789                       overturn[2  ]   = overturn[2 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4790                       overturn[3  ]   = overturn[3 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4791                       overturn[4  ]   = overturn[4 ]
     4792                       overturn[5  ]   = overturn[5 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4793                       overturn[6  ]   = overturn[6 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4794                       overturn[7  ]   = overturn[7 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4795                       overturn[8  ]   = overturn[8 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4796                       overturn[9  ]   = overturn[9 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4797                       gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4798                       .
     4799                    if p-ok = true then
     4800                    assign
     4801                       overturn[11  ]   = overturn[11 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4802                       overturn[12  ]   = overturn[12 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4803                       overturn[13  ]   = overturn[13 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4804                       overturn[14  ]   = overturn[14 ]
     4805                       overturn[15  ]   = overturn[15 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4806                       overturn[16  ]   = overturn[16 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4807                       overturn[17  ]   = overturn[17 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4808                       overturn[18  ]   = overturn[18 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4809                       overturn[19  ]   = overturn[19 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4810                       .
     4811                 end.
     4812         end case.
     4813     end.
     4814     assign
     4815       tt# = 6
     4816       overturn[1 + tt# ]   = (ostatok-end[1 + tt# ]  - ostatok-start[1 + tt# ] )  -  (inv[1 + tt# ] + prih[1 + tt# ] + kassa[1 + tt# ] + rash[1 + tt# ]  )
     4817       overturn[2 + tt# ]   = (ostatok-end[2 + tt# ]  - ostatok-start[2 + tt# ] )  -  (inv[2 + tt# ] + prih[2 + tt# ] + kassa[2 + tt# ] + rash[2 + tt# ]  )
     4818       overturn[3 + tt# ]   = (ostatok-end[3 + tt# ]  - ostatok-start[3 + tt# ] )  -  (inv[3 + tt# ] + prih[3 + tt# ] + kassa[3 + tt# ] + rash[3 + tt# ]  )
     4819     .
     4820     if p-ok = true then
     4821     assign
     4822       tt# = 6
     4823       overturn[1 + tt# ]   = (ostatok-end[1 + tt# ]  - ostatok-start[1 + tt# ] )  -  (inv[1 + tt# ] + prih[1 + tt# ] + kassa[1 + tt# ] + rash[1 + tt# ]  )
     4824       overturn[2 + tt# ]   = (ostatok-end[2 + tt# ]  - ostatok-start[2 + tt# ] )  -  (inv[2 + tt# ] + prih[2 + tt# ] + kassa[2 + tt# ] + rash[2 + tt# ]  )
     4825       overturn[3 + tt# ]   = (ostatok-end[3 + tt# ]  - ostatok-start[3 + tt# ] )  -  (inv[3 + tt# ] + prih[3 + tt# ] + kassa[3 + tt# ] + rash[3 + tt# ]  )
     4826     .
     4827   end.
     4828   end procedure.
     4829   procedure ver-owner :
     4830     do
     4831     on error undo, return error return-value
     4832     :
     4833   define input  parameter p-gds-code like ub.goods.gds-code no-undo .
     4834   define input  parameter p-db-num as integer   no-undo .
     4835   define output parameter p-ok as logical   no-undo .
     4836   define variable  p-proprietor-host-code like ub.clients.host-code no-undo .
     4837   define variable  p-proprietor-obj-type  like ub.clients.obj-type no-undo .
     4838   define variable  p-proprietor-obj-code  like ub.clients.obj-code no-undo .
     4839   p-ok = false .
     4840   if  p-tpsy = false  then return.
     4841     run tpsi-gds-proprietor (
     4842         input  p-gds-code             ,
     4843         input  p-db-num               ,
     4844         output p-proprietor-host-code ,
     4845         output p-proprietor-obj-type  ,
     4846         output p-proprietor-obj-code )  .
     4847    if p-proprietor-host-code = v-cntxt-host-code-obj then p-ok = true  .
     4848   end.
     4849   end procedure.
     4850   procedure ver-owner2 :
     4851     do
     4852     on error undo, return error return-value
     4853     :
     4854   define input  parameter p-gds-code like ub.goods.gds-code no-undo .
     4855   define input  parameter p-obj-type  like ub.clients.obj-type no-undo .
     4856   define input  parameter p-obj-code  like ub.clients.obj-code no-undo .
     4857   define output parameter p-ok as logical   no-undo .
     4858   define variable  p-proprietor-host-code like ub.clients.host-code no-undo .
     4859   define variable  p-proprietor-obj-type  like ub.clients.obj-type no-undo .
     4860   define variable  p-proprietor-obj-code  like ub.clients.obj-code no-undo .
     4861   p-ok = false .
     4862   if  p-tpsy = false  then return.
     4863   define buffer buf_obj-list for obj-list.
     4864   find first buf_obj-list where
     4865         buf_obj-list.obj-type = p-obj-type and
     4866         buf_obj-list.obj-code = p-obj-code
     4867         no-error .
     4868   if error-status :error then return .
     4869     run tpsi-gds-proprietor (
     4870         input  p-gds-code             ,
     4871         input  buf_obj-list.db-num     ,
     4872         output p-proprietor-host-code ,
     4873         output p-proprietor-obj-type  ,
     4874         output p-proprietor-obj-code )  .
     4875    if p-proprietor-host-code = v-cntxt-host-code-obj then p-ok = true  .
     4876   end.
     4877   end procedure.
