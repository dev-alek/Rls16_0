     3544   procedure display-b1  :
     3545         if not( not show-negativ-2 and
     3546            ( b1-prih          [1]   = 0 and
     3547              b1-rash          [1]   = 0 and
     3548              b1-kassa         [1]   = 0 and
     3549              b1-inv           [1]   = 0 and
     3550              b1-overturn      [1]   = 0 and
     3551              b1-overturn      [5]   = 0 and
     3552              b1-overturn      [8]   = 0 ) ) then do:
     3553           if  not (not show-negativ  and (
     3554                 b1-prih          [1]   = 0 and
     3555                 b1-rash          [1]   = 0 and
     3556                 b1-kassa         [1]   = 0 and
     3557                 b1-inv           [1]   = 0 and
     3558                 b1-overturn      [1]   = 0 and
     3559                 b1-overturn      [5]   = 0 and
     3560                 b1-ostatok-start [1]   = 0 and
     3561                 b1-ostatok-end   [1]   = 0   )) then do:
     3562                 if sums-only then do:
     3563                     if fr0 = true then do:
     3564                         put stream  outstream  tmp#stroka0 format "x(100)" skip.
     3565                         if Make-Excel then  put   stream ForExcel unformatted string(tmp#stroka0) skip.
     3566                         fr0 = false .
     3567                       end.
     3568                  end.
     3569      if p-tpsy = no  or ( p-tpsy = true and  p-type-tpsy-goods = 2 ) then do:
     3570           run di-qnty in this-procedure ("кол-во"  ,1, s-bar-code, gds-zap-artic, gds-zap-gds-name  ,"","b1":u).
     3571           if xshowcost    then do: run di in this-procedure ("учет." ,2 ,"","", "", "", "b1":u).  end.
     3572           if xshowcrsa    then do: run di in this-procedure ("прод." , 5, "","", "", "", "b1":u).  end.
     3573           if xshowsale    then do: run di in this-procedure ("док." , 8, "","", "", "", "b1":u).  end.
     3574           if vat-cost    then do: run di in this-procedure ( "уч.НДС", 3,"","","","","b1":u ). end.
     3575           if vat-crsa    then do: run di in this-procedure ( "пр.НДС", 6,"","","","","b1":u ).  end.
     3576           if vat-sale    then do: run di in this-procedure ( "дк.НДС", 9,"","","","","b1":u ).  end.
     3577      end.
     3578      if p-tpsy = true  then do:
     3579            if  p-type-tpsy-goods = 3 then
     3580                run di-qnty ("кол-во"  ,11, s-bar-code, gds-zap-artic, gds-zap-gds-name  ,"","b1":u).
     3581            else
     3582               run di-qnty in this-procedure ("кол-во"  ,11, "","", str_svoi, "","b1":u).
     3583           if xshowcost    then do: run di in this-procedure ("учет." ,12 ,"","", "", "", "b1":u).  end.
     3584           if xshowcrsa    then do: run di in this-procedure ("прод." ,15, "","", "", "", "b1":u).  end.
     3585           if xshowsale    then do: run di in this-procedure ("док." , 18, "","", "", "", "b1":u).  end.
     3586           if vat-cost    then do: run di in this-procedure ( "уч.НДС", 13,"","","","","b1":u ). end.
     3587           if vat-crsa    then do: run di in this-procedure ( "пр.НДС", 16,"","","","","b1":u ).  end.
     3588           if vat-sale    then do: run di in this-procedure ( "дк.НДС", 19,"","","","","b1":u ).  end.
     3589      end.
     3590          if not sums-only then run p-line.
     3591    end.
     3592    end.
     3593   end procedure.
