     3675   procedure display-title :
     3676   define variable v-nn as integer   no-undo .
     3677      PUT stream  OutStream  UNFORMATTED  string( v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + objname) at 50 format "x(85)" skip(2)
     3678             reportname  at 20 format "x(170)" skip
     3679             trim(str1)  at 35 format "x(75)" skip.
     3680        v-nn = num-entries(str2,chr(10)) .
     3681        repeat i = 1 to v-nn :
     3682         PUT stream  OutStream  UNFORMATTED  entry(i,str2,chr(10))  at 1 format "x(170)" skip.
     3683        end.
     3684       i=0.
     3685        PUT stream  OutStream  UNFORMATTED  trim(str3)  at 35 format "x(75)" skip.
     3686        v-nn = num-entries(str4,chr(10)) .
     3687        repeat i = 1 to v-nn:
     3688          PUT stream  OutStream  UNFORMATTED  entry(i,str4,chr(10))  at 1 format "x(170)" skip.
     3689        end.
     3690       i=0.
     3691        v-nn = num-entries( reportheader,chr(10)) .
     3692        repeat i = 1 to v-nn :
     3693         PUT stream  OutStream  UNFORMATTED  entry(i,reportheader,chr(10))  at 1 format "x(170)" skip.
     3694        end.
     3695       i=0.
     3696       run rep/extitle.p (1) .
     3697   end procedure.
     3698   procedure report-exec1  :
     3699      find first clients where x-store-type = clients.obj-type and
     3700                               x-store-code = clients.obj-code no-lock no-error.
     3701     run calcitog.
     3702     run print-header.
     3703      case retclassify :
     3704         when "vat-ps":u         then run run7 in this-procedure .
     3705         otherwise do:
     3706           message "error" view-as alert-box error .
     3707         end.
     3708      end case.
     3709     run print-footer.
     3710     end procedure.
     3711   procedure calc-sub-itog :
     3712   define variable b  as int no-undo.
     3713   assign
     3714     b1-gds-zap-other = b1-gds-zap-other +  gds-zap-other
     3715     b2-gds-zap-other = b2-gds-zap-other +  gds-zap-other
     3716     bi-gds-zap-other = bi-gds-zap-other +  gds-zap-other
     3717     bo-gds-zap-other = bo-gds-zap-other +  gds-zap-other
     3718     .
     3719   repeat b = 1 to 20 :
     3720     assign
     3721     b1-ostatok-start[b ]    = b1-ostatok-start[b ]    +  ostatok-start[b ]
     3722     b1-ostatok-end  [b ]    = b1-ostatok-end  [b ]    +  ostatok-end  [b ]
     3723     b2-ostatok-start[b ]    = b2-ostatok-start[b ]    +  ostatok-start[b ]
     3724     b2-ostatok-end  [b ]    = b2-ostatok-end  [b ]    +  ostatok-end  [b ]
     3725     bi-ostatok-start[b ]    = bi-ostatok-start[b ]    +  ostatok-start[b ]
     3726     bi-ostatok-end  [b ]    = bi-ostatok-end  [b ]    +  ostatok-end  [b ]
     3727     bo-ostatok-start[b ]    = bo-ostatok-start[b ]    +  ostatok-start[b ]
     3728     bo-ostatok-end  [b ]    = bo-ostatok-end  [b ]    +  ostatok-end  [b ]
     3729     b1-prih[b ]    = b1-prih[b ]    +  prih[b ]
     3730     b2-prih[b ]    = b2-prih[b ]    +  prih[b ]
     3731     bi-prih[b ]    = bi-prih[b ]    +  prih[b ]
     3732     bo-prih[b ]    = bo-prih[b ]    +  prih[b ]
     3733     b1-rash[b ]    = b1-rash[b ]    +  rash[b ]
     3734     b2-rash[b ]    = b2-rash[b ]    +  rash[b ]
     3735     bi-rash[b ]    = bi-rash[b ]    +  rash[b ]
     3736     bo-rash[b ]    = bo-rash[b ]    +  rash[b ]
     3737     b1-kassa[b ]    = b1-kassa[b ]    +  kassa[b ]
     3738     b2-kassa[b ]    = b2-kassa[b ]    +  kassa[b ]
     3739     bi-kassa[b ]    = bi-kassa[b ]    +  kassa[b ]
     3740     bo-kassa[b ]    = bo-kassa[b ]    +  kassa[b ]
     3741     b1-inv[b ]    = b1-inv[b ]    +  inv[b ]
     3742     b2-inv[b ]    = b2-inv[b ]    +  inv[b ]
     3743     bi-inv[b ]    = bi-inv[b ]    +  inv[b ]
     3744     bo-inv[b ]    = bo-inv[b ]    +  inv[b ]
     3745     b1-overturn[b ]    = b1-overturn[b ]    +  overturn[b ]
     3746     b2-overturn[b ]    = b2-overturn[b ]    +  overturn[b ]
     3747     bi-overturn[b ]    = bi-overturn[b ]    +  overturn[b ]
     3748     bo-overturn[b ]    = bo-overturn[b ]    +  overturn[b ]
     3749     .
     3750   end.
     3751   end procedure.
     3752   procedure clear-item :
     3753   define variable kk as int no-undo.
     3754    gds-zap-other = 0 .
     3755    repeat kk = 1 to 20 :
     3756    assign
     3757       prih            [kk]    = 0
     3758       rash            [kk]    = 0
     3759       kassa           [kk]    = 0
     3760       inv             [kk]    = 0
     3761       overturn        [kk]    = 0
     3762       ostatok-end     [kk]    = 0
     3763       ostatok-start   [kk]    = 0 .
     3764          end.
     3765    end procedure.
     3766   procedure item-goods :
     3767      def input parameter  par-3 as char no-undo.
     3768      def input parameter  par-4 as char no-undo.
     3769        if par-4 = "goods":u  then do:
     3770           assign
     3771               gds-zap-unit-base  = goods.unit-base
     3772               gds-zap-prt-root   = goods.prt-root
     3773               gds-zap-prod-type  = goods.prod-type
     3774               gds-zap-prod-code  = goods.prod-code
     3775               gds-zap-artic      = goods.artic
     3776               gds-zap-grp-name   = goods.grp-name
     3777               gds-zap-b-code     = goods.gds-code
     3778               gds-zap-type       = goods.gds-type.
     3779           if g#gds-engl then
     3780               assign gds-zap-gds-name = goods.engl-name.
     3781           else
     3782               assign gds-zap-gds-name = goods.gds-name.
     3783        end.
     3784        if par-4 = "gds-list":u  then do:
     3785           assign
     3786               gds-zap-unit-base  = gds-list.unit-base
     3787               gds-zap-prt-root   = gds-list.prt-root
     3788               gds-zap-prod-type  = gds-list.prod-type
     3789               gds-zap-prod-code  = gds-list.prod-code
     3790               gds-zap-artic      = gds-list.artic
     3791               gds-zap-grp-name   = gds-list.grp-name
     3792               gds-zap-b-code     = gds-list.gds-code
     3793               gds-zap-type       = gds-list.gds-type.
     3794           if g#gds-engl then
     3795               assign gds-zap-gds-name = gds-list.engl-name.
     3796           else
     3797               assign gds-zap-gds-name = gds-list.gds-name.
     3798        end.
     3799       define variable old-gds-zap-gds-name as character no-undo .
     3800       old-gds-zap-gds-name = gds-zap-gds-name.
