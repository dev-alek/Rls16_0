     3444                                   .
     3445               Run Display-b1 In This-procedure .
     3446               Run Clear-b1 In This-procedure .
     3447               Assign Break_Group = True.
     3448           End.
     3449     End.
     3450   End.
     3451           end.
     3452         end case.
     3453   end procedure.
     3454   procedure calcitog :
     3455       run aht-ostatok (
     3456           input x-store-code     ,
     3457           input x-store-type     ,
     3458           input x-tog-shift      ,
     3459           input x-date-start - 1 ,
     3460           input date('')         ,
     3461           input x-shift-start    ,
     3462           input x-shift-end      ,
     3463           input "n"    ,
     3464           input xtog-obj         ,
     3465           output  fact-order-1 ) .
     3466       run aht-ostatok (
     3467           input x-store-code  ,
     3468           input x-store-type  , x-tog-shift,
     3469           input x-date-start  ,
     3470           input x-date-end    , x-shift-start,x-shift-end,
     3471           input "n" ,
     3472           input xtog-obj ,
     3473           output  fact-order-2 ).
     3474   end procedure.
     3475   procedure display-str1  :
     3476      if p-tpsy = no  or ( p-tpsy = true and  p-type-tpsy-goods = 2 ) then do:
     3477            run di-qnty ("кол-во", 1, s-bar-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     3478            if xshowcost   then do: run di ( "учет." , 2,"","","","","" ). end.
     3479            if xshowcrsa   then do: run di ( "прод." , 5,"","","","","" ). end.
     3480            if xshowsale   then do: run di ( "док."  , 8,"","","","","" ). end.
     3481            if vat-cost    then do: run di ( "уч.НДС", 3,"","","","","" ). end.
     3482            if vat-crsa    then do: run di ( "пр.НДС", 6,"","","","","" ). end.
     3483            if vat-sale    then do: run di ( "дк.НДС", 9,"","","","","" ). end.
     3484      end.
     3485      if p-tpsy = true  then do:
     3486            if  p-type-tpsy-goods = 3 then
     3487                run di-qnty ("кол-во", 11, s-bar-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     3488            else
     3489               run di-qnty ("кол-во", 11, "","",str_svoi,"","").
     3490            if xshowcost   then do: run di ( "учет." , 12,"","","","","" ). end.
     3491            if xshowcrsa   then do: run di ( "прод." , 15,"","","","","" ). end.
     3492            if xshowsale   then do: run di ( "док."  , 18,"","","","","" ). end.
     3493            if vat-cost    then do: run di ( "уч.НДС", 13,"","","","","" ). end.
     3494            if vat-crsa    then do: run di ( "пр.НДС", 16,"","","","","" ). end.
     3495            if vat-sale    then do: run di ( "дк.НДС", 19,"","","","","" ). end.
     3496      end.
     3497   end procedure.
