      777   FUNCTION n-lavel RETURNS char (INPUT grp-name as char, INPUT lavel# as int ).
      778   define variable  str  as char format "X(60)"  no-undo.
      779   define variable  str2 as char no-undo.
      780   define variable v-r as character no-undo init "" .
      781   define variable  i#i as int no-undo.
      782   STR = "".
      783   repeat i#i =1 to lavel#:
      784       if i#i =1 then str   = entry(1,grp-name, chr(47)) .
      785       else do:
      786           str2 = entry(i#i,grp-name, chr(47)) no-error.
      787           if not error-status:error  and str2 <> "":u then
      788                  str = str +  chr(47) +  entry(i#i,grp-name, chr(47)) no-error .
      789           end.
      790   end.
      791   if str <> ? then do:
      792   v-r = str + chr(47) .
      793   end.
      794   RETURN v-r .
      795   END FUNCTION.
      796   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      797     if num-entries(string(p-dec), '.') = 2
      798       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      799       else return( string(p-dec)) .
      800   end function.
      801   function format-point-to-comma returns char (input orig as char ) .
      802   define variable rtext as character no-undo .
      803   define variable strt as integer no-undo .
      804   define variable leng as integer no-undo .
      805   assign rtext = orig .
      806   repeat:
      807     strt =  index(rtext,'.').
      808     if strt = 0 then leave.
      809     leng = 1.
      810     substring(rtext,strt,leng,"character") = v-delim .
      811   end.
      812   return rtext.
      813   end function.
      814   function format-excel-text returns char ( input start-text as char ) :
      815   def var  i    as int no-undo.
      816   def var  ch   as char no-undo.
      817   def var  n    as int no-undo.
      818   def var  ipos as int no-undo.
      819     n = num-entries(trim(start-text), chr(10)) - 1 .
      820     do i = 1 to n :
      821       ipos = index( start-text, chr(10)).
      822       if ipos > 0 then
      823         substr( start-text, ipos, 1 ) = ' '.
      824     end.
      825     n = num-entries(trim(start-text), chr(13)) - 1 .
      826     do i = 1 to n :
      827       ipos = index( start-text, chr(13)).
      828       if ipos > 0 then
      829         substr( start-text, ipos, 1 ) = ' '.
      830     end.
      831     if index( start-text, '"' ) = 0 then
      832       start-text =  '="'   + trim( start-text) + '"'   .
      833       else do:
      834         n = num-entries(trim(start-text), '"') - 1.
      835         do i = 1 to n :
      836           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      837         end.
      838         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      839         start-text = '="'  + ch  + '"' .
      840       end.
      841     return start-text.
      842   end.
      843   function excel-sum returns char (input p-dec as decimal ).
      844     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      845   end function.
      846   function excel-qnty returns char (input p-dec as decimal ).
      847     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      848   end function.
      849   function format-excel-text-macr returns char ( input start-text as char ) :
      850   def var  i    as int no-undo.
      851   def var  ch   as char no-undo.
      852   def var  n    as int no-undo.
      853   def var  ipos as int no-undo.
      854     n = num-entries(trim(start-text), chr(10)) - 1 .
      855     do i = 1 to n :
      856       ipos = index( start-text, chr(10)).
      857       if ipos > 0 then
      858         substring( start-text, ipos , 1 ) = ' '.
      859     end.
      860     n = num-entries(trim(start-text), chr(13)) - 1 .
      861     do i = 1 to n :
      862       ipos = index( start-text, chr(13)).
      863       if ipos > 0 then
      864         substring( start-text, ipos, 1 ) = ' '.
      865     end.
      866     if index( start-text, '"' ) = 0 then
      867       start-text =  '"'   + trim( start-text) + '"'   .
      868       else do:
      869         n = num-entries(trim(start-text), '"') - 1.
      870         do i = 1 to n :
      871           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      872         end.
      873         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      874         start-text = '"'  + ch  + '"' .
      875       end.
      876     n = num-entries(trim(start-text), chr(10)) - 1 .
      877     do i = 1 to n :
      878       ipos = index( start-text, chr(10)).
      879       if ipos > 0 then
      880         substring( start-text, ipos , 1 ) = ' '.
      881     end.
      882       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
      883     return start-text.
      884   end.
      885   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      886   procedure cur-time :
      887      define output parameter p-today as date      no-undo .
      888      define output parameter p-time  as integer   no-undo .
      889     do
      890     on error undo, return error
      891     :
      892       define variable v-date1 as date      no-undo .
      893       define variable v-date2 as date      no-undo .
      894       define variable v-time  as integer   no-undo .
      895       assign
      896         v-date1 = today
      897         v-time  = time
      898         v-date2 = today
      899       .
      900       if v-date1 <> v-date2
      901       then do:
      902         assign
      903           v-date1 = today
      904           v-time  = v-time
      905         .
      906       end.
      907       assign
      908         p-today = v-date1
      909         p-time  = v-time
      910       .
      911     end.
      912   end.
      913   function cur-time-date returns character
      914   :
      915     return string(today, '99/99/9999':U) .
      916   end.
      917   function cur-time-mjd returns decimal
      918   :
      919     define variable v-date as date      no-undo .
      920     define variable v-time as integer   no-undo .
      921     run cur-time in this-procedure
      922       (output v-date
      923       ,output v-time
      924       ) .
      925     return integer(v-date) - 2400002 + (v-time / 86400) .
      926   end.
      927   function cur-time-get-ending-index returns integer
      928   (input p-number as integer
      929   )
      930   :
      931     if p-number < 0
      932     or p-number = ?
      933     then do:
      934       return 1 .
      935     end.
      936     define variable v-rest as integer   no-undo .
      937     assign
      938       p-number = p-number modulo 100
      939     .
      940     if p-number < 20
      941     then do:
      942       assign
      943         v-rest = p-number
      944       .
      945     end.
      946     else do:
      947       assign
      948         v-rest = p-number modulo 10
      949       .
      950     end.
      951     case v-rest :
      952       when 1
      953       then do:
      954         return 2 .
      955       end.
      956       when 2 or
      957       when 3 or
      958       when 4
      959       then do:
      960         return 3 .
      961       end.
      962       otherwise do:
      963         return 1 .
      964       end.
      965     end case .
      966   end.
      967   procedure cur-time-mjd-to-date :
      968      define input  parameter i-mjd-diff as decimal no-undo.
      969      define output parameter o-Date     as date    no-undo.
      970      define output parameter o-Time     as integer no-undo.
      971      define variable v-day-number as integer   no-undo .
      972      if    i-mjd-diff < 0
      973         or i-mjd-diff = ?
      974      then do:
      975         return "?" .
      976      end.
      977      assign
      978         v-day-number = truncate(i-mjd-diff,0).
      979         o-Date = date(v-day-number + 2400002).
      980         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      981     .
      982   end.
      983   function cur-time-mjd-to-string returns character
      984   (input p-mjd-diff as decimal
      985   )
      986   :
      987     define variable v-day-number as integer   no-undo .
      988     define variable v-seconds    as integer   no-undo .
      989     define variable v-hour       as integer   no-undo .
      990     define variable v-min        as integer   no-undo .
      991     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      992     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      993     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      994     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      995     if p-mjd-diff < 0
      996     or p-mjd-diff = ?
      997     then do:
      998       return "?" .
      999     end.
     1000     assign
     1001       v-day-number = integer(truncate(p-mjd-diff,0))
     1002       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1003     .
     1004     if v-seconds > 86400
     1005     then do:
     1006       assign
     1007         v-seconds = 86400 - 1
     1008       .
     1009     end.
     1010     if v-seconds < 0
     1011     then do:
     1012       assign
     1013         v-seconds = 0
     1014       .
     1015     end.
     1016     assign
     1017       v-hour = truncate(v-seconds / 3600, 0)
     1018     .
     1019     assign
     1020       v-seconds = v-seconds modulo 3600
     1021     .
     1022     assign
     1023       v-min = truncate(v-seconds / 60, 0)
     1024     .
     1025     assign
     1026       v-seconds = v-seconds modulo 60
     1027     .
     1028     return
     1029         (if v-day-number <> 0
     1030           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1031           else ""
     1032         )
     1033       + (if v-day-number <> 0 or v-hour <> 0
     1034           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1035           else ""
     1036         )
     1037       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1038           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1039           else ""
     1040         )
     1041       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1042       .
     1043   end.
     1044   function cur-time-string returns character
     1045   :
     1046     define variable v-date as date      no-undo .
     1047     define variable v-time as integer   no-undo .
     1048     run cur-time in this-procedure
     1049       (output v-date
     1050       ,output v-time
     1051       ) .
     1052     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1053   end.
     1054   function cur-time-string-sec returns character
     1055   :
     1056     define variable v-date as date      no-undo .
     1057     define variable v-time as integer   no-undo .
     1058     run cur-time in this-procedure
     1059       (output v-date
     1060       ,output v-time
     1061       ) .
     1062     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1063   end.
     1064   function cur-time-custom  returns character
     1065   (input p-prefix as character
     1066   ,input p-date-format as character
     1067   ,input p-delimiter as character
     1068   ,input p-time-format as character
     1069   ,input p-suffix as character
     1070   )
     1071   :
     1072     define variable v-date as date      no-undo .
     1073     define variable v-time as integer   no-undo .
     1074     run cur-time in this-procedure
     1075       (output v-date
     1076       ,output v-time
     1077       ) .
     1078     return
     1079       p-prefix
     1080       + string(v-date, p-date-format)
     1081       + p-delimiter
     1082       + string(v-time, p-time-format)
     1083       + p-suffix
     1084       .
     1085   end.
     1086   function cur-time-print  returns character
     1087   :
     1088     define variable v-date as date      no-undo .
     1089     define variable v-time as integer   no-undo .
     1090     run cur-time in this-procedure
     1091       (output v-date
     1092       ,output v-time
     1093       ) .
     1094     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1095   end.
     1096   function cur-time-datetime returns datetime
     1097   :
     1098     define variable v-char as character no-undo .
     1099     define variable v-datetime as datetime no-undo .
     1100     v-char = cur-time-string().
     1101     v-datetime = datetime(v-char).
     1102     return  v-datetime.
     1103   end.
     1104   function cur-time-string-msec returns character
     1105   :
     1106     define variable v-date as datetime  no-undo .
     1107     v-date = now.
     1108     return string(v-date) .
     1109   end.
