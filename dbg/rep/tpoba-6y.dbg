     3627           if xshowcrsa    then do: run di ("прод.", 15 ,"","", "", "", "b2":u).  end.
     3628           if xshowsale    then do: run di ("док.", 18 ,"","", "", "", "b2":u).  end.
     3629            if vat-cost    then do: run di ( "уч.НДС", 13,"","","","","b2":u ). end.
     3630            if vat-crsa    then do: run di ( "пр.НДС", 16,"","","","","b2":u ).  end.
     3631            if vat-sale    then do: run di ( "дк.НДС", 19,"","","","","b2":u ).  end.
     3632      end.
     3633    end.
     3634   end.
     3635   end procedure.
     3636   procedure clear-b1  :
     3637    b1-gds-zap-other           = 0.
     3638    repeat kk = 1 to 20 :
     3639    assign
     3640       b1-prih                                            [kk]    = 0
     3641       b1-rash                                            [kk]    = 0
     3642       b1-kassa                                           [kk]    = 0
     3643       b1-inv                                             [kk]    = 0
     3644       b1-overturn                                        [kk]    = 0
     3645       b1-ostatok-end                                     [kk]    = 0
     3646       b1-ostatok-start                                   [kk]    = 0   .
     3647      end.
     3648    end procedure.
     3649   procedure clear-b2  :
     3650    b2-gds-zap-other      = 0.
     3651    repeat kk = 1 to 20 :
     3652    assign
     3653       b2-prih                                            [kk]    = 0
     3654       b2-rash                                            [kk]    = 0
     3655       b2-kassa                                           [kk]    = 0
