     3982   procedure di :
     3983   def input parameter p1 as char no-undo.
     3984   def input parameter p2 as int no-undo.
     3985   def input parameter p3 as char no-undo.
     3986   def input parameter p4 as char no-undo.
     3987   def input parameter p5 as char no-undo.
     3988   def input parameter p6 as char no-undo.
     3989   def input parameter p7 as char no-undo.
     3990    case caps(p7) :
     3991      when "b1":u  then do:
     3992       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3993         p3 @ s-bar-code
     3994         p4 @ gds-zap-artic
     3995         p5 @ gds-zap-gds-name
     3996         p6 @ gds-zap-unit-base
     3997         p1 @ gds-type
     3998         b1-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     3999         b1-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     4000         b1-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     4001         b1-KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     4002         b1-Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     4003         b1-Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     4004         b1-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     4005         b1-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     4006         with FRAME ZAPAS .
     4007                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     4008                   end.
     4009      when "b2":u  then  do:
     4010       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     4011         p3 @ s-bar-code
     4012         p4 @ gds-zap-artic
     4013         p5 @ gds-zap-gds-name
     4014         p6 @ gds-zap-unit-base
     4015         p1 @ gds-type
     4016         b2-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     4017         b2-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     4018         b2-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     4019         b2-KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     4020         b2-Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     4021         b2-Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     4022         b2-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     4023         b2-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     4024         with FRAME ZAPAS .
     4025                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     4026                 end.
     4027      when "bi":u then  do:
     4028       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     4029         p3 @ s-bar-code
     4030         p4 @ gds-zap-artic
     4031         p5 @ gds-zap-gds-name
     4032         p6 @ gds-zap-unit-base
     4033         p1 @ gds-type
     4034         bi-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     4035         bi-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     4036         bi-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     4037         bi-KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     4038         bi-Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     4039         bi-Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     4040         bi-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     4041         bi-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     4042         with FRAME ZAPAS .
     4043                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     4044                 end.
     4045      when "bo":u then  do:
     4046       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     4047         p3 @ s-bar-code
     4048         p4 @ gds-zap-artic
     4049         p5 @ gds-zap-gds-name
     4050         p6 @ gds-zap-unit-base
     4051         p1 @ gds-type
     4052         bo-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     4053         bo-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     4054         bo-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     4055         bo-KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     4056         bo-Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     4057         bo-Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     4058         bo-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     4059         bo-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     4060         with FRAME ZAPAS .
     4061                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     4062                 end.
     4063      when ""  then  do:
     4064       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     4065         p3 @ s-bar-code
     4066         p4 @ gds-zap-artic
     4067         p5 @ gds-zap-gds-name
     4068         p6 @ gds-zap-unit-base
     4069         p1 @ gds-type
     4070         ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     4071         Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     4072         RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     4073         KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     4074         Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     4075         Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     4076         Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     4077         gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     4078         with FRAME ZAPAS .
     4079                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     4080                 end.
     4081      end case.
     4082    end procedure.
     4083   procedure di-qnty :
     4084   def input parameter p1 as char no-undo.
     4085   def input parameter p2 as int no-undo.
     4086   def input parameter p3 as char no-undo.
     4087   def input parameter p4 as char no-undo.
     4088   def input parameter p5 as char no-undo.
     4089   def input parameter p6 as char no-undo.
     4090   def input parameter p7 as char no-undo.
     4091    case caps(p7) :
     4092      when "b1":u  then do :
     4093       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     4094         p3 @ s-bar-code
     4095         p4 @ gds-zap-artic
     4096         p5 @ gds-zap-gds-name
     4097         p6 @ gds-zap-unit-base
     4098         p1 @ gds-type
     4099         b1-ostatok-start [p2] format "->>>>>>>>>>9.<<<" @  F-ostatok-start
     4100         b1-Prih          [p2] format "->>>>>>>>>>9.<<<" @  F-Prih
     4101         b1-RAsh          [p2] format "->>>>>>>>>>9.<<<" @  F-RAsh
     4102         b1-KAssa         [p2] format "->>>>>>>>>>9.<<<" @  F-KAssa
     4103         b1-Inv           [p2] format "->>>>>>>>>>9.<<<" @  F-Inv
     4104         b1-Overturn      [p2] format "->>>>>>>>>>9.<<<" @  F-Overturn
     4105         b1-Ostatok-end   [p2] format "->>>>>>>>>>9.<<<" @  F-Ostatok-end
     4106         b1-gds-zap-other      format "->>>>>>>>>>9.<<<" when (p2 = 1) @  gds-zap-other
     4107         with FRAME ZAPAS .
     4108                 if num-entries(g1, "|") = 2 then assign  g1 =  "" .
     4109                 p6 = "" .
     4110                 gds-zap-type = "" .
     4111    if  p2 > 10  then f_e = 10 .
     4112                 else f_e =  0 .
     4113   if Make-Excel then  put   stream ForExcel unformatted
     4114     p3 CHR(9)
     4115     p4 CHR(9)
     4116     if f_e = 0 then g1 else p5 CHR(9)
     4117     p6 CHR(9)
     4118     gds-zap-type CHR(9)
     4119     excel-sum(b1-gds-zap-other   )  CHR(9)
     4120     excel-qnty(b1-ostatok-start[1  + f_e ])  CHR(9)
     4121     excel-sum(b1-ostatok-start[2  + f_e ])  CHR(9)
     4122     excel-sum(b1-ostatok-start[5  + f_e ])  CHR(9)
     4123     excel-sum(b1-ostatok-start[8  + f_e ])  CHR(9)
     4124     .
     4125     if Make-Excel then  put   stream ForExcel unformatted
     4126     excel-sum(b1-ostatok-start[3  + f_e ])  CHR(9)
     4127     excel-sum(b1-ostatok-start[6  + f_e ])  CHR(9)
     4128     excel-sum(b1-ostatok-start[9  + f_e ])  CHR(9)
     4129     excel-qnty(b1-Prih        [1  + f_e ])  CHR(9)
     4130     excel-sum(b1-Prih         [2  + f_e ])  CHR(9)
     4131     excel-sum(b1-Prih         [5  + f_e ])  CHR(9)
     4132     excel-sum(b1-Prih         [8  + f_e ])  CHR(9)
     4133     excel-sum(b1-Prih         [3  + f_e ])  CHR(9)
     4134     excel-sum(b1-Prih         [6  + f_e ])  CHR(9)
     4135     excel-sum(b1-Prih         [9  + f_e ])  CHR(9)
     4136     .
     4137     if Make-Excel then  put   stream ForExcel unformatted
     4138     excel-qnty(b1-RAsh        [1  + f_e ])  CHR(9)
     4139     excel-sum(b1-RAsh         [2  + f_e ])  CHR(9)
