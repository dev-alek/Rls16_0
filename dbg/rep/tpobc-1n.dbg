     2924   procedure display-title :
     2925   define variable v-nn as integer   no-undo .
     2926      PUT stream  OutStream  UNFORMATTED  string( v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + objname) at 50 format "x(85)" skip(2)
     2927             reportname  at 20 format "x(170)" skip
     2928             trim(str1)  at 35 format "x(75)" skip.
     2929        v-nn = num-entries(str2,chr(10)).
     2930        repeat i = 1 to v-nn :
     2931         PUT stream  OutStream  UNFORMATTED  entry(i,str2,chr(10))  at 1 format "x(170)" skip.
     2932        end.
     2933       i=0.
     2934          PUT stream  OutStream  UNFORMATTED  trim(str3)  at 35 format "x(75)" skip.
     2935        v-nn  = num-entries(str4,chr(10)) .
     2936        repeat i = 1 to v-nn :
     2937         PUT stream  OutStream  UNFORMATTED  entry(i,str4,chr(10))  at 1 format "x(170)" skip.
     2938        end.
     2939       i=0.
     2940        v-nn = num-entries(reportheader,chr(10)) .
     2941        repeat i = 1 to v-nn  :
     2942         PUT stream  OutStream  UNFORMATTED  entry(i,reportheader,chr(10))  at 1 format "x(170)" skip.
     2943        end.
     2944       i=0.
     2945       run rep/extitle.p (1) .
     2946   end procedure.
     2947   procedure ob-line  :
     2948   define input  parameter x-store-code     like ub.clients.obj-code         no-undo .
     2949   define input  parameter x-store-type     like ub.clients.obj-type         no-undo .
     2950   define input  parameter x-gds-code       like ub.aht-ot-line.gds-code     no-undo .
     2951   define input  parameter x-fact-order-1   like ub.aht-ot-line.fact-order   no-undo .
     2952   define input  parameter x-fact-order-2   like ub.aht-ot-line.fact-order   no-undo .
     2953   define input  parameter x-sum-type       like ub.aht-ot-line.sum-type     no-undo .
     2954   define input  parameter xtog-obj         as logical no-undo .
     2955   define variable      tt#              as integer no-undo .
     2956   define variable x-type-pr1 as character no-undo .
     2957   define variable x-type-pr2 as character no-undo .
     2958    if x-sum-type = arh-type-cost then tt# = 0 .
     2959    if x-sum-type = arh-type-crsa then tt# = 3 .
     2960    if x-sum-type = arh-type-sale then tt# = 6 .
     2961   if  x-sum-type = "cb" then
     2962    assign
     2963       x-type-pr1 = "c"
     2964       x-type-pr2 = "b"
     2965    .
     2966   else
     2967    assign
     2968       x-type-pr1 = x-sum-type
     2969       x-type-pr2 = x-sum-type
     2970    .
     2971     for each obj-list  no-lock :
     2972        for each ub.aht-ot-line where
     2973                         ( ub.aht-ot-line.gds-code      = x-gds-code
     2974                     and   ub.aht-ot-line.fact-order   <= x-fact-order-2
     2975                     and   ub.aht-ot-line.fact-order   >= x-fact-order-1
     2976                     and   ub.aht-ot-line.obj-code     = obj-list.obj-code
     2977                     and   ub.aht-ot-line.obj-type     = obj-list.obj-type
     2978                     and   ub.aht-ot-line.sum-type     = x-type-pr1 )
     2979                     OR  ( ub.aht-ot-line.gds-code      = x-gds-code
     2980                     and   ub.aht-ot-line.fact-order   <= x-fact-order-2
     2981                     and   ub.aht-ot-line.fact-order   >= x-fact-order-1
     2982                     and   ub.aht-ot-line.obj-code     = obj-list.obj-code
     2983                     and   ub.aht-ot-line.obj-type     = obj-list.obj-type
     2984                     and   ub.aht-ot-line.sum-type     = x-type-pr2 )
     2985                     no-lock :
     2986       case ub.aht-ot-line.ext-doc-type:
     2987                 when        'ie':U  or
     2988                 when        're':U  or
     2989                 when        'iv':U    or
     2990                 when        'rv':U or
     2991                 when        'im':U     then
     2992                 do:
     2993                 assign
     2994                        prih[1 ]   = prih[1]   + (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     2995                        prih[2 ]   = prih[2]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     2996                        prih[3 ]   = prih[3]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     2997                        prih[4 ]   = prih[4]
     2998                        prih[5 ]   = prih[5]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     2999                        prih[6 ]   = prih[6]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     3000                        prih[7 ]   = prih[7]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     3001                        prih[8 ]   = prih[8]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     3002                        prih[9 ]   = prih[9]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     3003                        gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     3004                  .
     3005                 end.
     3006                 when       'ee':U      or
     3007                 when       'ep':U    or
     3008                 when       'ev':U     or
     3009                 when       'em':U       or
     3010                 when       'wm':U       or
     3011                 when       'we':U     then
     3012                 do:
     3013                   assign
     3014                       rash[1 ]   = rash[1]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     3015                       rash[2 ]   = rash[2]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     3016                       rash[3 ]   = rash[3]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     3017                       rash[4 ]   = rash[4]
     3018                       rash[5 ]   = rash[5]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     3019                       rash[6 ]   = rash[6]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     3020                       rash[7 ]   = rash[7]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     3021                       rash[8 ]   = rash[8]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     3022                       rash[9 ]   = rash[9]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     3023                       gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     3024                 .
     3025                 end.
     3026                 when       'es':U  or
     3027                 when       'rs':U then
     3028                 do:
     3029                     assign
     3030                       kassa[1 ]   = kassa[1]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     3031                       kassa[2 ]   = kassa[2]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     3032                       kassa[3 ]   = kassa[3]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     3033                       kassa[4 ]   = kassa[4]
     3034                       kassa[5 ]   = kassa[5]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     3035                       kassa[6 ]   = kassa[6]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     3036                       kassa[7 ]   = kassa[7]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     3037                       kassa[8 ]   = kassa[8]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     3038                       kassa[9 ]   = kassa[9]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     3039                       gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     3040                       .
     3041                 end.
     3042             when       'vt':U            or
     3043             when       'pc':U or
     3044             when       'vp':U       then  do:
     3045                 assign
     3046                   inv[1 ]   = inv[1]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     3047                   inv[2 ]   = inv[2]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     3048                   inv[3 ]   = inv[3]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     3049                   inv[4 ]   = inv[4]
     3050                   inv[5 ]   = inv[5]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     3051                   inv[6 ]   = inv[6]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     3052                   inv[7 ]   = inv[7]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     3053                   inv[8 ]   = inv[8]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     3054                   inv[9 ]   = inv[9]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     3055                   gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     3056                   .
     3057                 end.
     3058             when       'ot':U or
     3059             when       'ap':U then
     3060                 do:
     3061                    assign
     3062                       overturn[1 ]   = overturn[1]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     3063                       overturn[2 ]   = overturn[2]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     3064                       overturn[3 ]   = overturn[3]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     3065                       overturn[4 ]   = overturn[4]
     3066                       overturn[5 ]   = overturn[5]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     3067                       overturn[6 ]   = overturn[6]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     3068                       overturn[7 ]   = overturn[7]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     3069                       overturn[8 ]   = overturn[8]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     3070                       overturn[9 ]   = overturn[9]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     3071                       gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     3072                       .
     3073                 end.
     3074         end case.
     3075      end.
     3076     end.
     3077     assign
     3078       tt# = 6
     3079       overturn[1 + tt#]   = (ostatok-end[1 + tt#]  - ostatok-start[1 + tt#] )  -  (inv[1 + tt#] + prih[1 + tt#] + kassa[1 + tt#] + rash[1 + tt#]  )
     3080       overturn[2 + tt#]   = (ostatok-end[2 + tt#]  - ostatok-start[2 + tt#] )  -  (inv[2 + tt#] + prih[2 + tt#] + kassa[2 + tt#] + rash[2 + tt#]  )
     3081       overturn[3 + tt#]   = (ostatok-end[3 + tt#]  - ostatok-start[3 + tt#] )  -  (inv[3 + tt#] + prih[3 + tt#] + kassa[3 + tt#] + rash[3 + tt#]  )
     3082     .
     3083   end procedure.
     3084   procedure report-exec1  :
     3085      find first clients where x-store-type = clients.obj-type and
     3086                               x-store-code = clients.obj-code no-lock no-error.
     3087     run calcitog.
     3088     run print-header.
     3089      case retclassify :
     3090         when "no-classify":u  then            run run1 in this-procedure .
     3091         otherwise do:
     3092           message "error" view-as alert-box error .
     3093         end.
     3094      end case.
     3095     run print-footer.
     3096     end procedure.
     3097   procedure calc-sub-itog :
     3098   define variable b  as int no-undo.
     3099   assign
     3100     b1-gds-zap-other = b1-gds-zap-other +  gds-zap-other
     3101     b2-gds-zap-other = b2-gds-zap-other +  gds-zap-other
     3102     bi-gds-zap-other = bi-gds-zap-other +  gds-zap-other
     3103     bo-gds-zap-other = bo-gds-zap-other +  gds-zap-other
     3104     .
     3105   repeat b = 1 to 10 :
     3106     assign
     3107     b1-ostatok-start[b ]    = b1-ostatok-start[b ]    +  ostatok-start[b ]
     3108     b1-ostatok-end  [b ]    = b1-ostatok-end  [b ]    +  ostatok-end  [b ]
     3109     b2-ostatok-start[b ]    = b2-ostatok-start[b ]    +  ostatok-start[b ]
     3110     b2-ostatok-end  [b ]    = b2-ostatok-end  [b ]    +  ostatok-end  [b ]
     3111     bi-ostatok-start[b ]    = bi-ostatok-start[b ]    +  ostatok-start[b ]
     3112     bi-ostatok-end  [b ]    = bi-ostatok-end  [b ]    +  ostatok-end  [b ]
     3113     bo-ostatok-start[b ]    = bo-ostatok-start[b ]    +  ostatok-start[b ]
     3114     bo-ostatok-end  [b ]    = bo-ostatok-end  [b ]    +  ostatok-end  [b ]
     3115     b1-prih[b ]    = b1-prih[b ]    +  prih[b ]
     3116     b2-prih[b ]    = b2-prih[b ]    +  prih[b ]
     3117     bi-prih[b ]    = bi-prih[b ]    +  prih[b ]
     3118     bo-prih[b ]    = bo-prih[b ]    +  prih[b ]
     3119     b1-rash[b ]    = b1-rash[b ]    +  rash[b ]
     3120     b2-rash[b ]    = b2-rash[b ]    +  rash[b ]
     3121     bi-rash[b ]    = bi-rash[b ]    +  rash[b ]
     3122     bo-rash[b ]    = bo-rash[b ]    +  rash[b ]
     3123     b1-kassa[b ]    = b1-kassa[b ]    +  kassa[b ]
     3124     b2-kassa[b ]    = b2-kassa[b ]    +  kassa[b ]
     3125     bi-kassa[b ]    = bi-kassa[b ]    +  kassa[b ]
     3126     bo-kassa[b ]    = bo-kassa[b ]    +  kassa[b ]
     3127     b1-inv[b ]    = b1-inv[b ]    +  inv[b ]
     3128     b2-inv[b ]    = b2-inv[b ]    +  inv[b ]
     3129     bi-inv[b ]    = bi-inv[b ]    +  inv[b ]
     3130     bo-inv[b ]    = bo-inv[b ]    +  inv[b ]
     3131     b1-overturn[b ]    = b1-overturn[b ]    +  overturn[b ]
     3132     b2-overturn[b ]    = b2-overturn[b ]    +  overturn[b ]
     3133     bi-overturn[b ]    = bi-overturn[b ]    +  overturn[b ]
     3134     bo-overturn[b ]    = bo-overturn[b ]    +  overturn[b ]
     3135     .
     3136   end.
     3137   end procedure.
     3138   procedure clear-item :
     3139   define variable kk as int no-undo.
     3140    gds-zap-other = 0 .
     3141    repeat kk = 1 to 9 :
     3142    assign
     3143       prih            [kk]    = 0
     3144       rash            [kk]    = 0
     3145       kassa           [kk]    = 0
     3146       inv             [kk]    = 0
     3147       overturn        [kk]    = 0
     3148       ostatok-end     [kk]    = 0
     3149       ostatok-start   [kk]    = 0 .
     3150          end.
     3151    end procedure.
     3152   procedure item-goods :
     3153      define input parameter  par-3 as char no-undo.
     3154      define input parameter  par-4 as char no-undo.
     3155        if par-4 = "goods":u  then do:
     3156           assign
     3157               gds-zap-unit-base  = goods.unit-base
     3158               gds-zap-prt-root   = goods.prt-root
     3159               gds-zap-prod-type  = goods.prod-type
     3160               gds-zap-prod-code  = goods.prod-code
     3161               gds-zap-artic      = goods.artic
     3162               gds-zap-grp-name   = goods.grp-name
     3163               gds-zap-b-code     = goods.gds-code
     3164               gds-zap-type       = goods.gds-type.
     3165           if g#gds-engl then
     3166               assign gds-zap-gds-name = goods.engl-name.
     3167           else
     3168               assign gds-zap-gds-name = goods.gds-name.
     3169        end.
     3170        if par-4 = "gds-list":u  then do:
     3171           assign
     3172               gds-zap-unit-base  = gds-list.unit-base
     3173               gds-zap-prt-root   = gds-list.prt-root
     3174               gds-zap-prod-type  = gds-list.prod-type
     3175               gds-zap-prod-code  = gds-list.prod-code
     3176               gds-zap-artic      = gds-list.artic
     3177               gds-zap-grp-name   = gds-list.grp-name
     3178               gds-zap-b-code     = gds-list.gds-code
     3179               gds-zap-type       = gds-list.gds-type.
     3180           if g#gds-engl then
     3181               assign gds-zap-gds-name = gds-list.engl-name.
     3182           else
     3183               assign gds-zap-gds-name = gds-list.gds-name.
     3184        end.
     3185       run foreach.
     3186   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3187     (input  gds-zap-b-code
     3188     ,input  ?
     3189     ,output v-bar-code
     3190     )  .
     3191   s-bar-code = string (v-bar-code,"999999999").
     3192       If  break_group = true  and par-3 <> "1"  then DO :
     3193            FIND FIRST clients WHERE clients.obj-type = gds-zap-prod-type AND clients.obj-code = gds-zap-prod-code use-index pi NO-LOCK .
     3194            gds-zap-prod-name  = clients.obj-name.
     3195             If break_group1 = true  THEN  DO :
     3196               if (par-3 = "3"  OR  par-3 = "5" ) and  par-3 <> "6"
     3197                 then DO: Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )         b1-name = gds-zap-grp-name . end.
     3198                 else DO: Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) b1-name = gds-zap-prod-name. end.
     3199               if par-3 = "6"  then  dO:
     3200                  if xTog-obj = true then do:
     3201                    var-vat-pc = func-vat (input gds-zap-b-code , input x-store-type, input x-store-code)
     3202                     .
     3203                   end.
     3204                  else do:
     3205                   var-vat-pc = temp-gds-list.vat-pc .
     3206                   end.
     3207                   assign
     3208                       temp-str = string( "СТАВКА НДС : " + string(var-vat-pc) + "%" )
     3209                       b1-name = temp-str.
     3210                   end.
     3211               if NOT xSumsOnly or (par-3 = "4" Or par-3 = "5" ) THEN DO :
     3212                   fr0 = true .
     3213                   tmp#stroka0 = temp-str.
     3214               End.
     3215             End.
     3216               IF (par-3 = "4"  OR  par-3 = "5")  THEN DO:
     3217                 if par-3 = "4"
     3218                   then Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )          b2-name = gds-zap-grp-name .
     3219                   else Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name )  b2-name = gds-zap-prod-name.
     3220                 if NOT xSumsOnly THEN DO:
     3221                     fr = true .
     3222                 End.
     3223                 break_group1 = false.
     3224               END.
     3225          break_group = false.
     3226       End.
     3227       run display-line.
     3228    end procedure.
     3229   procedure di :
     3230   define input parameter p1 as char no-undo.
     3231   define input parameter p2 as int no-undo.
     3232   define input parameter p3 as char no-undo.
     3233   define input parameter p4 as char no-undo.
     3234   define input parameter p5 as char no-undo.
     3235   define input parameter p6 as char no-undo.
     3236   define input parameter p7 as char no-undo.
     3237    case caps(p7) :
     3238      when "b1":u  then do:
     3239       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3240         p3 @ s-bar-code
     3241         p4 @ gds-zap-artic
     3242         p5 @ gds-zap-gds-name
     3243         p6 @ gds-zap-unit-base
     3244         p1 @ gds-type
     3245         b1-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     3246         b1-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     3247         b1-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     3248         b1-KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     3249         b1-Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     3250         b1-Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     3251         b1-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     3252         b1-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     3253         with FRAME ZAPAS .
     3254                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     3255                   end.
     3256      when "b2":u  then  do:
     3257       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3258         p3 @ s-bar-code
     3259         p4 @ gds-zap-artic
     3260         p5 @ gds-zap-gds-name
     3261         p6 @ gds-zap-unit-base
     3262         p1 @ gds-type
     3263         b2-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     3264         b2-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     3265         b2-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     3266         b2-KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     3267         b2-Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     3268         b2-Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     3269         b2-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     3270         b2-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     3271         with FRAME ZAPAS .
     3272                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     3273                 end.
     3274      when "bi":u then  do:
     3275       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3276         p3 @ s-bar-code
     3277         p4 @ gds-zap-artic
     3278         p5 @ gds-zap-gds-name
     3279         p6 @ gds-zap-unit-base
     3280         p1 @ gds-type
     3281         bi-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     3282         bi-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     3283         bi-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     3284         bi-KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     3285         bi-Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     3286         bi-Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     3287         bi-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     3288         bi-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     3289         with FRAME ZAPAS .
     3290                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     3291                 end.
     3292      when "bo":u then  do:
     3293       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
