     1369   end procedure.
     1370   procedure aht_update-stk-table :
     1371     define input  parameter p-fact-order     like ub.trn-doc.fact-order   no-undo .
     1372     define input  parameter p-cut-fact-order like ub.trn-doc.fact-order   no-undo .
     1373     define input  parameter p-ext-doc-type   like ub.trn-doc.ext-doc-type no-undo .
     1374     define input  parameter p-trn-doc        as logical   no-undo .
     1375     define buffer buf_temp-aht-ot-tot for temp-aht-ot-tot .
     1376     define buffer buf_temp-aht-ot-line for temp-aht-ot-line .
     1377     define variable v-stk-ext-sum-type as character no-undo .
     1378     do
     1379     on error undo, return error
     1380     :
     1381       for each buf_temp-aht-ot-tot
     1382       on error undo, return error
     1383       :
     1384         run aht_get-stk-sum-type in this-procedure
     1385           (input  buf_temp-aht-ot-tot.sum-type
     1386           ,input  p-ext-doc-type
     1387           ,output v-stk-ext-sum-type
     1388           ) .
     1389         run aht_store-stk-tot in this-procedure
     1390           (buffer buf_temp-aht-ot-tot
     1391           ,input buf_temp-aht-ot-tot.sum-type
     1392           ,input p-fact-order
     1393           ,input p-cut-fact-order
     1394           ,input p-ext-doc-type
     1395           ,input false
     1396           ) .
     1397         run aht_store-stk-tot in this-procedure
     1398           (buffer buf_temp-aht-ot-tot
     1399           ,input v-stk-ext-sum-type
     1400           ,input p-fact-order
     1401           ,input p-cut-fact-order
     1402           ,input p-ext-doc-type
     1403           ,input p-trn-doc
     1404           ) .
     1405       end.
     1406       for each buf_temp-aht-ot-line
     1407       on error undo, return error
     1408       :
     1409         run aht_get-stk-sum-type in this-procedure
     1410           (input  buf_temp-aht-ot-line.sum-type
     1411           ,input  p-ext-doc-type
     1412           ,output v-stk-ext-sum-type
     1413           ) .
     1414         run aht_store-stk-line in this-procedure
     1415           (buffer buf_temp-aht-ot-line
     1416           ,input buf_temp-aht-ot-line.sum-type
     1417           ,input p-fact-order
     1418           ,input p-cut-fact-order
     1419           ,input p-ext-doc-type
     1420           ,input false
     1421           ) .
     1422         run aht_store-stk-line in this-procedure
     1423           (buffer buf_temp-aht-ot-line
     1424           ,input v-stk-ext-sum-type
     1425           ,input p-fact-order
     1426           ,input p-cut-fact-order
     1427           ,input p-ext-doc-type
     1428           ,input p-trn-doc
     1429           ) .
     1430       end.
     1431     end.
     1432   end procedure.
     1433   procedure aht_store-stk-tot :
     1434     define parameter buffer buf_temp-aht-ot-tot for temp-aht-ot-tot .
     1435     define input  parameter p-stk-sum-type      as character no-undo .
     1436     define input  parameter p-fact-order        like ub.trn-doc.fact-order   no-undo .
     1437     define input  parameter p-cut-fact-order    like ub.trn-doc.fact-order   no-undo .
     1438     define input  parameter p-ext-doc-type      like ub.trn-doc.ext-doc-type no-undo .
     1439     define input  parameter p-update-sale       as logical   no-undo .
     1440     define buffer buf_aht-stk-tot for ub.aht-stk-tot .
     1441     define buffer new-buf_aht-stk-tot for ub.aht-stk-tot .
     1442     do
     1443     on error undo, return error return-value
     1444     :
     1445       find last buf_aht-stk-tot exclusive-lock
     1446         where buf_aht-stk-tot.obj-type   = buf_temp-aht-ot-tot.obj-type
     1447           and buf_aht-stk-tot.obj-code   = buf_temp-aht-ot-tot.obj-code
     1448           and buf_aht-stk-tot.sum-type   = p-stk-sum-type
     1449           and buf_aht-stk-tot.fact-order <= p-fact-order
     1450         use-index category
     1451         no-error .
     1452       if not available buf_aht-stk-tot
     1453       or buf_aht-stk-tot.fact-order <> p-fact-order
     1454       then do:
     1455         create new-buf_aht-stk-tot .
     1456         assign
     1457           new-buf_aht-stk-tot.obj-type   = buf_temp-aht-ot-tot.obj-type
     1458           new-buf_aht-stk-tot.obj-code   = buf_temp-aht-ot-tot.obj-code
     1459           new-buf_aht-stk-tot.fact-order = p-fact-order
     1460           new-buf_aht-stk-tot.sum-type   = p-stk-sum-type
     1461         .
     1462         if available buf_aht-stk-tot then do:
     1463           assign
     1464             new-buf_aht-stk-tot.fact-qnty = buf_aht-stk-tot.fact-qnty
