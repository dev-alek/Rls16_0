     2913    repeat kk = 1 to 9 :
     2914    assign
     2915       bi-prih                                            [kk]    = 0
     2916       bi-rash                                            [kk]    = 0
     2917       bi-kassa                                           [kk]    = 0
     2918       bi-inv                                             [kk]    = 0
     2919       bi-overturn                                        [kk]    = 0
