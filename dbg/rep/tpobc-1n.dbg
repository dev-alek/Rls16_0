     2901    assign
     2902       b2-prih                                            [kk]    = 0
     2903       b2-rash                                            [kk]    = 0
     2904       b2-kassa                                           [kk]    = 0
     2905       b2-inv                                             [kk]    = 0
     2906       b2-overturn                                        [kk]    = 0
