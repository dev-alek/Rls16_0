     2890       b1-rash                                            [kk]    = 0
     2891       b1-kassa                                           [kk]    = 0
     2892       b1-inv                                             [kk]    = 0
     2893       b1-overturn                                        [kk]    = 0
     2894       b1-ostatok-end                                     [kk]    = 0
     2895       b1-ostatok-start                                   [kk]    = 0   .
     2896      end.
     2897    end procedure.
