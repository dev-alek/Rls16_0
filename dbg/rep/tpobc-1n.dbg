     2210   define variable  vat_v2         like ub.stk-tot.sum-rubl   no-undo.
     2211   define variable  quantity    like ub.stk-tot.fact-qnty  no-undo.
     2212   define variable  coast       like ub.stk-tot.sum-rubl   no-undo.
     2213   define variable  coast_r     like ub.stk-tot.sum-rubl   no-undo.
     2214   define variable  coast_v     like ub.stk-tot.sum-rubl   no-undo.
     2215   define variable  vat_r       like ub.stk-tot.sum-rubl   no-undo.
     2216   define variable  vat_v       like ub.stk-tot.sum-rubl   no-undo.
     2217   define variable  slt_r       like ub.stk-tot.sum-rubl   no-undo.
     2218   define variable  slt_v       like ub.stk-tot.sum-rubl   no-undo.
     2219   define variable  coast3       like ub.stk-tot.sum-rubl   no-undo.
     2220   define variable  coast4       like ub.stk-tot.sum-rubl   no-undo.
     2221   define variable  temp-str as char no-undo.
     2222   define variable xshowcost as logical no-undo .
     2223   define variable xshowsale as logical no-undo .
     2224   define variable xshowcrsa as logical no-undo .
     2225   define variable arh-type-sale as character no-undo .
     2226   define variable arh-type-crsa as character no-undo .
     2227   define variable arh-type-cost as character no-undo .
     2228   define variable arh-type-sadt as character no-undo .
     2229   define variable arh-type-cgdt as character no-undo .
     2230   define variable arh-type-csdt as character no-undo .
     2231   define variable arh-type-allsum  as character no-undo .
     2232   define variable str as char format "x(60)" no-undo.
     2233   define variable i#i as int no-undo.
     2234   define variable xlavel as int  no-undo.
     2235   define variable list-field as char no-undo.
     2236   define variable str10 as char no-undo.
     2237   define frame zapas
     2238           s-bar-code column-label  "Код! ! ":c9 space(0)
     2239           sym1 column-label ":!:!:" format "x(1)"       space(0)
     2240           gds-zap-artic column-label "Артикул! ! ":c16 format "x(16)" space(0)
     2241           sym2 column-label ":!:!:" format "x(1)"                         space(0)
     2242           gds-zap-gds-name column-label "Название товара! ! ":c36 format "x(36)" space(0)
     2243           sym3 column-label ":!:!:" format "x(1)"                                     space(0)
     2244           gds-zap-unit-base column-label "Ед.!изм! " format "x(3)"                  space(0)
     2245           sym4 column-label ":!:!:" format "x(1)"                                     space(0)
     2246           gds-type column-label "Тип!данных! ":c6 format "x(6)"                  space(0)
     2247           sym5 column-label ":!:!:" format "x(1)" space(0)
     2248           f-ostatok-start     column-label "Остаток на!начало! ":c14 format "x(14)"           space(0)
     2249           sym6 column-label ":!:!:" format "x(1)" space(0)
     2250           f-prih       column-label "Приход! ! ":c14     format "x(14)"     space(0)
     2251           sym7 column-label ":!:!:" format "x(1)" space(0)
     2252           f-rash       column-label "Расход! ! ":c14  format "x(14)"   space(0)
     2253           sym8 column-label ":!:!:" format "x(1)" space(0)
     2254           f-kassa             column-label "Касса! ! ":c14  format "x(14)"   space(0)
     2255           sym9  column-label ":!:!:" format "x(1)" space(0)
     2256           f-inv               column-label "Инвентаризация!Смена типа!приобретения":c14  format "x(14)"   space(0)
     2257           sym10 column-label ":!:!:" format "x(1)" space(0)
     2258           f-overturn         column-label "Переоценка!продажной и!учетной цен":c14  format "x(14)"   space(0)
     2259           sym11 column-label ":!:!:" format "x(1)" space(0)
     2260           gds-zap-other      column-label "Скидка! ! ":c13     space(0)
     2261           sym12 column-label ":!:!:" format "x(1)" space(0)
     2262           f-ostatok-end     column-label "Остаток!на конец! ":c14 format "x(14)"           space(0)
     2263       header
     2264           string( "Дата печати : " + string(today,"99.99.9999") +  " , " + string(time, "hh:mm") ) at 5 format "x(35)"
     2265           "Цены указаны в" (if tprintrubl then "руб" else x-base-type )
     2266           string( "Страница " + string( page-number( outstream ), ">>>>>9") ) at 147 format "x(53)" skip
     2267           line format "x(194)" at 1
     2268      with width 232 down stream-io use-text no-box.
     2269        assign
     2270           i = 0
     2271           xlavel        = xvar-lavel
     2272           select-good   = x-selectgood
     2273           paytype       = x-set_pay_type
     2274           retclassify   = xclassify
     2275           retsorttype   = xsorttype
     2276           sums-only     = xsumsonly
     2277           show-negativ  = xshowzero
     2278           show-negativ-2  = xshowzero-2
     2279           xshowcost     = show-cost
     2280           xshowsale     = show-sale
     2281           xshowcrsa     = show-crsa
     2282           firstline     = false
     2283           line          = fill("-", 232)
     2284           valtype       = if (paytype = 1) then 0  else x-set_val_type.
     2285      run report-execute.
     2286   procedure report-execute :
     2287   define variable gj as integer no-undo init 0.
     2288     if (valtype=0 and x-base-code=0)  or valtype=1
     2289                                   then   assign tprintrubl = yes .
     2290                                   else   assign tprintrubl = no .
     2291     if reportpageheight = 0 then reportpageheight  = 43.
     2292   output stream outstream to value( string( session:temp-directory +
     2293                                        "rpt" + string( g#report-num ) ) )
     2294                                        page-size  value(reportpageheight) .
     2295     find first clients where x-store-type = clients.obj-type and
     2296                              x-store-code = clients.obj-code no-lock no-error.
     2297     if available clients then  objname = clients.obj-name.
     2298                                   else  objname="объект не определен".
     2299   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2300   form header
     2301     line format "x(194)" at 1 skip
     2302     "Продолжение - на следующей странице" at 30 skip
     2303     with frame bottomframe width 232 page-bottom no-labels no-box .
     2304   view stream outstream frame bottomframe .
     2305        run report-exec1.
     2306     hide stream outstream frame bottomframe .
     2307     hide   stream outstream frame zapas .
     2308     output stream outstream close.
     2309   if mFrameView
     2310   then do:
     2311      HIDE FRAME InfoFrame.
     2312   end.
     2313     if Make-Excel then output stream ForExcel close.
     2314     define variable v-user-action as character no-undo .
     2315     define variable v-printed as logical   no-undo .
     2316     define variable DisabledOptions as integer   no-undo .
     2317     define variable v-orient-page as character no-undo .
     2318     run How-name in this-procedure (
     2319         input ReportPageHeight,
     2320         input ReportPageWidth,
     2321         output v-orient-page )
     2322         .
     2323     if v-orient-page = "A4-lans":U then DisabledOptions = 8 .
     2324                                    else DisabledOptions = 0 .
     2325     run gbl/prnfilen.w
     2326       (input  ""
     2327       ,input  DisabledOptions
     2328       ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     2329       ,input reportFontNum
     2330       ,output v-user-action
     2331       ,output v-printed
     2332       ) .
     2333   end procedure.
     2334   procedure clear-line :
     2335    do
     2336    on error undo, return error return-value
     2337    :
     2338       assign
     2339           ostatok-start[1]  = 0
     2340           ostatok-start[2]  = 0
     2341           ostatok-start[3]  = 0
     2342           ostatok-start[4]  = 0
     2343           ostatok-start[5]  = 0
     2344           ostatok-start[6]  = 0
     2345           ostatok-start[7]  = 0
     2346           ostatok-start[8]  = 0
     2347           ostatok-start[9]  = 0
     2348           ostatok-start[10] = 0
     2349           ostatok-end[1]  = 0
     2350           ostatok-end[2]  = 0
     2351           ostatok-end[3]  = 0
     2352           ostatok-end[4]  = 0
     2353           ostatok-end[5]  = 0
     2354           ostatok-end[6]  = 0
     2355           ostatok-end[7]  = 0
     2356           ostatok-end[8]  = 0
     2357           ostatok-end[9]  = 0
     2358           ostatok-end[10] = 0
     2359     .
     2360    end.
     2361   end procedure.
     2362   procedure ost-line :
     2363   do
     2364   on error undo, return error return-value
     2365   :
     2366   define input parameter p-store-type like ub.clients.obj-type no-undo .
     2367   define input parameter p-store-code like ub.clients.obj-code no-undo .
     2368    find last  ub.aht-stk-line where
     2369                           ub.aht-stk-line.gds-code   = gds-zap-b-code
     2370                     and   ub.aht-stk-line.fact-order <= fact-order-1
     2371                     and   ub.aht-stk-line.obj-code   = p-store-code
     2372                     and   ub.aht-stk-line.obj-type   = p-store-type
     2373                     and   ub.aht-stk-line.sum-type   = x-type-pr
     2374                           use-index category no-lock no-error.
     2375           if available ub.aht-stk-line then do:
     2376               if  tprintrubl  then
     2377                     assign
     2378                           ostatok-start[1]  =ostatok-start[1] +  (if ub.aht-stk-line.sum-type <> "b"
     2379                                                                      then round( ub.aht-stk-line.fact-qnty,3) else 0 )
     2380                           ostatok-start[2]  =ostatok-start[2] +  round( ub.aht-stk-line.cost-sum-rubl ,2)
     2381                           ostatok-start[3]  =ostatok-start[3] +  round( ub.aht-stk-line.cost-vat-rubl ,2)
     2382                           ostatok-start[4]  =ostatok-start[4] +  0
     2383                           ostatok-start[5]  =ostatok-start[5]  + round( ub.aht-stk-line.crsa-sum-rubl ,2)
     2384                           ostatok-start[6]  =ostatok-start[6]  + round( ub.aht-stk-line.crsa-vat-rubl ,2)
     2385                           ostatok-start[7]  =ostatok-start[7]  + round( ub.aht-stk-line.sale-discnt-rubl ,2)
     2386                           ostatok-start[8]  =ostatok-start[8]  + round( ub.aht-stk-line.crsa-sum-rubl ,2)
     2387                           ostatok-start[9]  =ostatok-start[9]  + round( ub.aht-stk-line.crsa-vat-rubl ,2)
     2388                           ostatok-start[10] =ostatok-start[10] + round( ub.aht-stk-line.crsa-slt-rubl ,2)
     2389                           .
     2390                 else
     2391                     assign
     2392                           ostatok-start[1]  = ostatok-start[1] + (if ub.aht-stk-line.sum-type <> "b"
     2393                                                                      then round( ub.aht-stk-line.fact-qnty,3) else 0 )
     2394                           ostatok-start[2]  = ostatok-start[2] +  round( ub.aht-stk-line.cost-sum-base ,2)
     2395                           ostatok-start[3]  = ostatok-start[3] +  round( ub.aht-stk-line.cost-vat-base ,2)
     2396                           ostatok-start[4]  = ostatok-start[4] +  0
     2397                           ostatok-start[5]  = ostatok-start[5]  + round( ub.aht-stk-line.crsa-sum-base ,2)
     2398                           ostatok-start[6]  = ostatok-start[6]  + round( ub.aht-stk-line.crsa-vat-base ,2)
     2399                           ostatok-start[7]  = ostatok-start[7]  + round( ub.aht-stk-line.sale-discnt-base ,2)
     2400                           ostatok-start[8]  = ostatok-start[8]  + round( ub.aht-stk-line.crsa-sum-base ,2)
     2401                           ostatok-start[9]  = ostatok-start[9]  + round( ub.aht-stk-line.crsa-vat-base ,2)
     2402                           ostatok-start[10] = ostatok-start[10] + round( ub.aht-stk-line.crsa-slt-base ,2)
     2403                     .
     2404                end.
     2405    find last  ub.aht-stk-line where
     2406                           ub.aht-stk-line.gds-code   = gds-zap-b-code
     2407                     and   ub.aht-stk-line.fact-order <= fact-order-2
     2408                     and   ub.aht-stk-line.obj-code   = p-store-code
     2409                     and   ub.aht-stk-line.obj-type   = p-store-type
     2410                     and   ub.aht-stk-line.sum-type   = x-type-pr
     2411                           use-index category no-lock no-error.
     2412           if available ub.aht-stk-line then do:
     2413               if  tprintrubl  then
     2414                     assign
     2415                           ostatok-end[1]  = ostatok-end[1] + (if ub.aht-stk-line.sum-type <> "b"
     2416                                                                  then round( ub.aht-stk-line.fact-qnty,3) else 0 )
     2417                           ostatok-end[2]  = ostatok-end[2] + round( ub.aht-stk-line.cost-sum-rubl ,2)
     2418                           ostatok-end[3]  = ostatok-end[3] + round( ub.aht-stk-line.cost-vat-rubl ,2)
     2419                           ostatok-end[4]  = ostatok-end[4] + 0
     2420                           ostatok-end[5]  = ostatok-end[5] + round( ub.aht-stk-line.crsa-sum-rubl ,2)
     2421                           ostatok-end[6]  = ostatok-end[6] + round( ub.aht-stk-line.crsa-vat-rubl ,2)
     2422                           ostatok-end[7]  = ostatok-end[7] + round( ub.aht-stk-line.sale-discnt-rubl ,2)
     2423                           ostatok-end[8]  = ostatok-end[8] + round( ub.aht-stk-line.crsa-sum-rubl ,2)
     2424                           ostatok-end[9]  = ostatok-end[9] + round( ub.aht-stk-line.crsa-vat-rubl ,2)
     2425                           ostatok-end[10] = ostatok-end[10] + round( ub.aht-stk-line.crsa-slt-rubl ,2)
     2426                           .
     2427                 else
     2428                     assign
     2429                           ostatok-end[1]  = ostatok-end[1] +  (if ub.aht-stk-line.sum-type <> "b"
     2430                                                                   then round( ub.aht-stk-line.fact-qnty,3) else 0 )
     2431                           ostatok-end[2]  = ostatok-end[2] +  round( ub.aht-stk-line.cost-sum-base ,2)
     2432                           ostatok-end[3]  = ostatok-end[3] +  round( ub.aht-stk-line.cost-vat-base ,2)
     2433                           ostatok-end[4]  = ostatok-end[4] +  0
     2434                           ostatok-end[5]  = ostatok-end[5] +  round( ub.aht-stk-line.crsa-sum-base ,2)
     2435                           ostatok-end[6]  = ostatok-end[6] +  round( ub.aht-stk-line.crsa-vat-base ,2)
     2436                           ostatok-end[7]  = ostatok-end[7] +  round( ub.aht-stk-line.sale-discnt-base ,2)
     2437                           ostatok-end[8]  = ostatok-end[8] +  round( ub.aht-stk-line.crsa-sum-base ,2)
     2438                           ostatok-end[9]  = ostatok-end[9] +  round( ub.aht-stk-line.crsa-vat-base ,2)
     2439                           ostatok-end[10] = ostatok-end[10] + round( ub.aht-stk-line.crsa-slt-base ,2)
     2440                     .
     2441                end.
     2442   end.
     2443   end procedure.
     2444   procedure foreach :
     2445   define variable old-type as character no-undo .
     2446      old-type = x-type-pr.
     2447   IF ( i modulo v-account = 0 )  then DO:
     2448    Assign
     2449       v-kol-spice = (50 - LENGTH(reportname)) / 2
     2450       RecordsString = fill(' ',v-kol-spice) + string(reportname)
     2451       .
     2452    Assign
     2453       v-kol-spice = (50 - LENGTH(objname)) / 2
     2454       RecordsString2 = fill(' ',v-kol-spice) + string(objname)
     2455       .
     2456             if  log-manager:logfile-name ne ?
     2457             then DO:
     2458                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     2459             end.
     2460              if mFrameView
     2461              then do:
     2462               DISPLAY
     2463                 i @ RecordsDone
     2464                 RecordsString   @ RecordsString
     2465                 RecordsString2  @ RecordsString2
     2466                 WITH FRAME InfoFrame.
     2467              end.
     2468   End.
     2469      if v-button-stop then  DO:
     2470            if mFrameView
     2471            then
     2472               PROCESS EVENTS.
     2473            IF StopProcessing THEN DO:
     2474            RETURN error.
     2475            End.
     2476      end.
     2477     run clear-item.
     2478     run clear-line.
     2479     for each obj-list  no-lock :
     2480       if x-type-pr = "cb" then do:
     2481          x-type-pr = "b".
     2482          run ost-line (obj-list.obj-type , obj-list.obj-code ) .
     2483          x-type-pr = "c".
     2484          run ost-line (obj-list.obj-type , obj-list.obj-code ) .
     2485          x-type-pr = old-type .
     2486       end.
     2487       else do:
     2488          run ost-line (obj-list.obj-type , obj-list.obj-code ) .
     2489       end.
     2490     end.
     2491      run ob-line (
     2492             input   x-store-code   ,
     2493             input   x-store-type   ,
     2494             input   gds-zap-b-code ,
     2495             input   fact-order-1,
     2496             input   fact-order-2,
     2497             input   x-type-pr     ,
     2498             input   xtog-obj) .
     2499      run calc-sub-itog .
     2500   end procedure.
     2501   procedure display-line :
     2502        i = i + 1.
     2503           if not( not show-negativ-2 and
     2504            ( prih         [1]   = 0 and
     2505             rash          [1]   = 0 and
     2506             kassa         [1]   = 0 and
     2507             inv           [1]   = 0 and
     2508             overturn      [1]   = 0 and
     2509             overturn      [5]   = 0 and
     2510             overturn      [8]   = 0 ) ) then do:
     2511           if  not (not show-negativ  and (
     2512                 prih          [1]   = 0 and
     2513                 rash          [1]   = 0 and
     2514                 kassa         [1]   = 0 and
     2515                 inv           [1]   = 0 and
     2516                 overturn      [1]   = 0 and
     2517                 overturn      [5]   = 0 and
     2518                 ostatok-start [1]   = 0 and
     2519                 ostatok-end   [1]   = 0   )) then do:
     2520           if not sums-only then do:
     2521               if fr0 = true then do:
     2522                 put stream  outstream  tmp#stroka0 format "x(100)" skip.
     2523                 if Make-Excel then  put   stream ForExcel unformatted string(tmp#stroka0) skip.
     2524                 fr0 = false .
     2525               end.
     2526               if fr = true then do:
     2527                 put stream outstream space(10) temp-str format "x(100)" skip.
     2528                 if Make-Excel then  put   stream ForExcel unformatted CHR(9) string(temp-str) skip.
     2529                 fr = false .
     2530               end.
     2531              run display-str1 in this-procedure.
     2532             end.
     2533           end.
     2534        end.
     2535     end procedure.
     2536   procedure print-header :
     2537   if not firstline then do:
     2538      run display-title.
     2539      form with FRAME ZAPAS .  DOWN stream   OutStream 1 with FRAME ZAPAS .
     2540   end.
     2541    firstline = true .
     2542       if xtog-obj and   x-selectobject <> "currency":u   then  do:
     2543             PUT stream  OutStream  UNFORMATTED     "ПО ОБЪЕКТУ : " + caps(clients.obj-name)  at 30 format "x(170)" skip.
     2544             if Make-Excel then  put   stream ForExcel unformatted   "ПО ОБЪЕКТУ : " + caps(clients.obj-name) format "x(170)" skip.
     2545         end.
     2546         run clear-b1 .
     2547         run clear-b2.
     2548         run clear-bi .
     2549         break_group = true.
     2550         break_group1 = true.
     2551      end procedure.
     2552   procedure print-footer :
     2553         if retclassify = "no-classify":u  then run u-line.
     2554          gds-zap-artic = "ИТОГО" .
     2555          run display-bi.
     2556          run u-line.
     2557          end procedure.
     2558   procedure u-line :
     2559   underline stream outstream  sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     2560     s-bar-code
     2561     gds-zap-artic
     2562     gds-zap-gds-name
     2563     gds-zap-unit-base
     2564     gds-type
     2565     f-ostatok-start
     2566     f-prih
     2567     f-rash
     2568     f-kassa
     2569     f-inv
     2570     f-overturn
     2571     f-ostatok-end
     2572     gds-zap-other
     2573     with FRAME ZAPAS .
     2574     DOWN stream   OutStream 1 with FRAME ZAPAS.
     2575   end procedure.
     2576   procedure p-line :
     2577   underline stream outstream  sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     2578           gds-zap-artic
     2579           gds-zap-gds-name
     2580           gds-zap-unit-base
     2581           gds-type
     2582           f-ostatok-start
     2583           f-prih
     2584           f-rash
     2585           f-kassa
     2586           f-inv
     2587           f-overturn
     2588           f-ostatok-end
     2589           gds-zap-other
     2590           with FRAME ZAPAS .
     2591           DOWN stream   OutStream 1 with FRAME ZAPAS.
     2592   end procedure.
     2593   procedure run1 :
     2594          case select-good :
     2595           when 1  then do:
     2596   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2597   IF x-SelectObject = "currency":U  OR  xTog-obj THEN DO :
     2598       for each gds-obj  where
     2599             gds-obj.obj-type = x-store-type  and
     2600             gds-obj.obj-code = x-store-code
     2601             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2602                   no-lock,
     2603             First goods  where  gds-obj.gds-code   = goods.gds-code
     2604   no-lock
     2605   BREAK
     2606       BY (temp-gds-list.gds-code) :
     2607         run item-goods ( "1" , "goods" ) .
     2608         if return-value <> "" then NEXT.
     2609       End.
     2610     END.
     2611     Else DO:
     2612      For each obj-list no-lock :
     2613                     FOR EACH gds-obj where
     2614                   gds-obj.obj-type = obj-list.obj-type    and
     2615                   gds-obj.obj-code = obj-list.obj-code
     2616                   and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2617                   no-lock :
     2618                   if NOT can-find(First temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) Then do:
     2619                       find first goods no-lock  where goods.gds-code  = gds-obj.gds-code .
     2620                       Create temp-gds-list.
     2621                       Assign
     2622                         temp-gds-list.prod-code = gds-obj.prod-code
     2623                         temp-gds-list.grp-name  = gds-obj.grp-name
     2624                         temp-gds-list.gds-name  = goods.gds-name
     2625                         temp-gds-list.gds-code  = gds-obj.gds-code
     2626                         temp-gds-list.artic     = gds-obj.artic
     2627                       .
     2628                   End.
     2629               End.
     2630     End.
     2631     for each temp-gds-list no-lock
     2632       , First goods     where goods.gds-code  = temp-gds-list.gds-code no-lock
     2633         BREAK
     2634       BY temp-gds-list.gds-code :
     2635       run item-goods ( "1" , "goods" ) .
     2636         if return-value <> "" then NEXT.
     2637     End.
     2638   End.
     2639     end.
     2640           when 2  then do:
     2641   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2642     if x-selectobject = "currency":u  or  xtog-obj then do:
     2643         for  each gds-obj
     2644                     where gds-obj.obj-code   = x-store-code
     2645                      and  gds-obj.obj-type   = x-store-type
     2646                           and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2647                           no-lock ,
     2648                 first  tmp#grp  where gds-obj.grp-name   begins tmp#grp.grp-name   no-lock ,
     2649                 first goods       where gds-obj.gds-code   = goods.gds-code  no-lock
     2650                     break
     2651                     by temp-gds-list.gds-code :
     2652                     run item-goods ( input "1" , input "goods" ) .
     2653                     if return-value <> "" then next.
     2654         end.
     2655     end.
     2656     else do:
     2657         for each obj-list no-lock :
     2658               for  each gds-obj
     2659                 where  gds-obj.obj-code   = obj-list.obj-code
     2660                   and  gds-obj.obj-type   = obj-list.obj-type
     2661                        and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2662                 no-lock ,
     2663                 first  tmp#grp  where gds-obj.grp-name   begins tmp#grp.grp-name   no-lock ,
     2664                 first goods       where gds-obj.gds-code   = goods.gds-code  no-lock :
     2665                       if not can-find(first temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) then do:
     2666                           create temp-gds-list.
     2667                           assign
     2668                             temp-gds-list.prod-code = gds-obj.prod-code
     2669                             temp-gds-list.grp-name  = gds-obj.grp-name
     2670                             temp-gds-list.gds-name  = goods.grp-name
     2671                             temp-gds-list.gds-code  = gds-obj.gds-code
     2672                             temp-gds-list.artic     = gds-obj.artic
     2673                           .
     2674                       end.
     2675               end.
     2676       end.
     2677     for each temp-gds-list no-lock
     2678       , first goods  where goods.gds-code  = temp-gds-list.gds-code no-lock
     2679         break
     2680       by temp-gds-list.gds-code :
     2681       run item-goods ( "1" , "goods" ) .
     2682         if return-value <> "" then next.
     2683     end.
     2684   end.
     2685     end.
     2686           when 3 then do:
     2687   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2688   if x-selectobject = "currency":u  or  xtog-obj then do:
     2689     for  each gds-obj
     2690         where  gds-obj.obj-code   = x-store-code
     2691           and  gds-obj.obj-type   = x-store-type
     2692                 and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2693                 no-lock ,
     2694     first g#cli
     2695           where gds-obj.prod-code  = g#cli.obj-code
     2696           and  gds-obj.prod-type   = g#cli.obj-type
     2697           no-lock,
     2698     first goods
     2699           where gds-obj.gds-code = goods.gds-code no-lock
     2700           break
     2701           by temp-gds-list.gds-code :
     2702           run item-goods ( "1" , "goods" ) .
     2703           if return-value <> "" then next.
     2704         end.
     2705     end.
     2706     else do:
     2707       for each obj-list no-lock :
     2708             for  each gds-obj
     2709               where  gds-obj.obj-code   = obj-list.obj-code
     2710                 and  gds-obj.obj-type   = obj-list.obj-type
     2711                       and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2712                       no-lock ,
     2713             first g#cli
     2714                 where gds-obj.prod-code  = g#cli.obj-code
     2715                 and  gds-obj.prod-type   = g#cli.obj-type
     2716                 no-lock,
     2717             first goods
     2718                 where gds-obj.gds-code = goods.gds-code no-lock :
     2719                   if not can-find (first temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) then do:
     2720                       create temp-gds-list.
     2721                       assign
     2722                         temp-gds-list.prod-code = gds-obj.prod-code
     2723                         temp-gds-list.grp-name  = gds-obj.grp-name
     2724                         temp-gds-list.gds-name  = goods.gds-name
     2725                         temp-gds-list.gds-code  = gds-obj.gds-code
     2726                         temp-gds-list.artic     = gds-obj.artic
     2727                       .
     2728                   end.
     2729             end.
     2730       end.
     2731         for each temp-gds-list no-lock
     2732           , first goods  where goods.gds-code  = temp-gds-list.gds-code no-lock
     2733             break
     2734               by temp-gds-list.gds-code :
     2735           run item-goods ( "1" , "goods" ) .
     2736             if return-value <> "" then next.
     2737         end.
     2738   end.
     2739     end.
     2740           otherwise do:
     2741   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2742   IF x-SelectObject = "currency":U  OR  xTog-obj THEN DO :
     2743       for each gds-obj  where
     2744             gds-obj.obj-type = x-store-type  and
     2745             gds-obj.obj-code = x-store-code
     2746             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2747                   no-lock,
     2748             First goods  where  gds-obj.gds-code   = goods.gds-code
     2749         no-lock,
     2750   First gds-list  where gds-obj.gds-code  = gds-list.gds-code
     2751   no-lock
     2752   BREAK
     2753       BY (gds-list.gds-code) :
     2754         run item-goods ( "1" , "gds-list" ) .
     2755         if return-value <> "" then NEXT.
     2756       End.
     2757     END.
     2758     Else DO:
     2759      For each obj-list no-lock :
     2760                     FOR EACH gds-obj where
     2761                   gds-obj.obj-type = obj-list.obj-type    and
     2762                   gds-obj.obj-code = obj-list.obj-code
     2763                   and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2764                   no-lock,
     2765             First gds-list  where gds-obj.gds-code  = gds-list.gds-code
     2766                   no-lock :
     2767                   if NOT can-find(First temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) Then do:
     2768                       find first goods no-lock  where goods.gds-code  = gds-obj.gds-code .
     2769                       Create temp-gds-list.
     2770                       Assign
     2771                         temp-gds-list.prod-code = gds-obj.prod-code
     2772                         temp-gds-list.grp-name  = gds-obj.grp-name
     2773                         temp-gds-list.gds-name  = goods.gds-name
     2774                         temp-gds-list.gds-code  = gds-obj.gds-code
     2775                         temp-gds-list.artic     = gds-obj.artic
     2776                       .
     2777                   End.
     2778               End.
     2779     End.
     2780     for each temp-gds-list no-lock
     2781       , First gds-list  where gds-list.gds-code  = temp-gds-list.gds-code no-lock
     2782         BREAK
     2783       BY gds-list.gds-code :
     2784       run item-goods ( "1" , "gds-list" ) .
     2785         if return-value <> "" then NEXT.
     2786     End.
     2787   End.
     2788           end.
     2789          end case.
     2790   end procedure.
     2791   procedure calcitog :
     2792       run aht-ostatok (
     2793           input x-store-code     ,
     2794           input x-store-type     ,
     2795           input x-tog-shift      ,
     2796           input x-date-start - 1 ,
     2797           input date('')         ,
     2798           input x-shift-start    ,
     2799           input x-shift-end      ,
     2800           input "n"    ,
     2801           input xtog-obj         ,
     2802           output  fact-order-1 ) .
     2803       run aht-ostatok (
     2804           input x-store-code  ,
     2805           input x-store-type  , x-tog-shift,
     2806           input x-date-start  ,
     2807           input x-date-end    , x-shift-start,x-shift-end,
     2808           input "n" ,
     2809           input xtog-obj ,
     2810           output  fact-order-2 ).
     2811   end procedure.
     2812   procedure display-str1  :
     2813              run di-qnty ("кол-во", 1, s-bar-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     2814            if xshowcost    then do: run di ( "учет.", 2,"","","","",""). end.
     2815            if xshowcrsa    then do: run di ( "прод.", 5,"","","","","" ).  end.
     2816            if xshowsale    then do: run di ( "док." , 8,"","","","","" ).  end.
     2817            if vat-cost    then do: run di ( "уч.НДС", 3,"","","","","" ). end.
     2818            if vat-crsa    then do: run di ( "пр.НДС", 6,"","","","","" ).  end.
     2819            if vat-sale    then do: run di ( "дк.НДС", 9,"","","","","" ).  end.
     2820   end procedure.
     2821   procedure display-bi  :
     2822              run di-qnty("кол-во",1,  "", gds-zap-artic ,"" ,"", "bi":u).
     2823            if xshowcost    then do: run di ("учет." , 2 , "","", "", "", "bi":u).  end.
     2824            if xshowcrsa    then do: run di ("прод." , 5, "","", "", "",  "bi":u).  end.
     2825            if xshowsale    then do: run di ("док." , 8, "","", "", "",  "bi":u).  end.
     2826            if vat-cost    then do: run di ( "уч.НДС", 3,"","","","","bi":u ). end.
     2827            if vat-crsa    then do: run di ( "пр.НДС", 6,"","","","","bi":u ).  end.
     2828            if vat-sale    then do: run di ( "дк.НДС", 9,"","","","","bi":u ).  end.
     2829   end procedure.
     2830   procedure display-bo  :
     2831              run di-qnty("кол-во",1,  "", "ИТОГО ПО" ,"ОБЪЕКТАМ" ,"", "bo":u).
     2832            if xshowcost    then do: run di ("учет." , 2 , "","", "", "", "bo":u).  end.
     2833            if xshowcrsa    then do: run di ("прод." , 5, "","", "", "",  "bo":u).  end.
     2834            if xshowsale    then do: run di ("док." , 8, "","", "", "",  "bo":u).  end.
     2835            if vat-cost    then do: run di ( "уч.НДС", 3,"","","","","bo":u ). end.
     2836            if vat-crsa    then do: run di ( "пр.НДС", 6,"","","","","bo":u ).  end.
     2837            if vat-sale    then do: run di ( "дк.НДС", 9,"","","","","bo":u ).  end.
     2838   end procedure.
     2839   procedure display-b1  :
     2840           if  not (not show-negativ  and (
     2841                 b1-prih          [1]   = 0 and
     2842                 b1-rash          [1]   = 0 and
     2843                 b1-kassa         [1]   = 0 and
     2844                 b1-inv           [1]   = 0 and
     2845                 b1-overturn      [1]   = 0 and
     2846                 b1-overturn      [5]   = 0 and
     2847                 b1-ostatok-start [1]   = 0 and
     2848                 b1-ostatok-end   [1]   = 0   )) then do:
     2849                 if sums-only then do:
     2850                     if fr0 = true then do:
     2851                         put stream  outstream  tmp#stroka0 format "x(100)" skip.
     2852                         if Make-Excel then  put   stream ForExcel unformatted string(tmp#stroka0) skip.
     2853                         fr0 = false .
     2854                       end.
     2855                  end.
     2856           run di-qnty in this-procedure ("кол-во"  ,1, s-bar-code, gds-zap-artic, gds-zap-gds-name ,"","b1":u).
     2857           if xshowcost    then do: run di in this-procedure ("учет." ,2 ,"","", "", "", "b1":u).  end.
     2858           if xshowcrsa    then do: run di in this-procedure ("прод." , 5, "","", "", "", "b1":u).  end.
     2859           if xshowsale    then do: run di in this-procedure ("док." , 8, "","", "", "", "b1":u).  end.
     2860           if vat-cost    then do: run di in this-procedure ( "уч.НДС", 3,"","","","","b1":u ). end.
     2861           if vat-crsa    then do: run di in this-procedure ( "пр.НДС", 6,"","","","","b1":u ).  end.
     2862           if vat-sale    then do: run di in this-procedure ( "дк.НДС", 9,"","","","","b1":u ).  end.
     2863          if not sums-only then run p-line.
     2864    end.
     2865   end procedure.
     2866   procedure display-b2  :
     2867           if  not (not show-negativ  and (
     2868                 b2-prih          [1]   = 0 and
     2869                 b2-rash          [1]   = 0 and
     2870                 b2-kassa         [1]   = 0 and
     2871                 b2-inv           [1]   = 0 and
     2872                 b2-overturn      [1]   = 0 and
     2873                 b2-overturn      [5]   = 0 and
     2874                 b2-ostatok-start [1]   = 0 and
     2875                 b2-ostatok-end   [1]   = 0   )) then do:
     2876           run di-qnty( "кол-во", 1 ,s-bar-code,gds-zap-artic, gds-zap-gds-name,"", "b2":u).
     2877           if xshowcost    then do: run di ("учет.", 2, "","", "", "", "b2":u).  end.
     2878           if xshowcrsa    then do: run di ("прод.", 5 ,"","", "", "", "b2":u).  end.
     2879           if xshowsale    then do: run di ("док.", 8 ,"","", "", "", "b2":u).  end.
     2880            if vat-cost    then do: run di ( "уч.НДС", 3,"","","","","b2":u ). end.
     2881            if vat-crsa    then do: run di ( "пр.НДС", 6,"","","","","b2":u ).  end.
     2882            if vat-sale    then do: run di ( "дк.НДС", 9,"","","","","b2":u ).  end.
     2883    end.
     2884   end procedure.
     2885   procedure clear-b1  :
     2886    b1-gds-zap-other           = 0.
     2887    repeat kk = 1 to 9 :
