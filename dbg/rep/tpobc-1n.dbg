     3625     excel-sum(bo-Overturn     [9])  CHR(9)
     3626     excel-qnty(bo-Ostatok-end  [1])  CHR(9)
     3627     excel-sum(bo-Ostatok-end  [2])  CHR(9)
     3628     excel-sum(bo-Ostatok-end  [5])  CHR(9)
     3629     excel-sum(bo-Ostatok-end  [8])  CHR(9)
     3630     excel-sum(bo-Ostatok-end  [3])  CHR(9)
     3631     excel-sum(bo-Ostatok-end  [6])  CHR(9)
     3632     excel-sum(bo-Ostatok-end  [9])  CHR(9)
     3633     skip.
     3634                end.
     3635      when ""  then     do :
     3636       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3637         p3 @ s-bar-code
     3638         p4 @ gds-zap-artic
     3639         p5 @ gds-zap-gds-name
     3640         p6 @ gds-zap-unit-base
     3641         p1 @ gds-type
     3642         ostatok-start [p2] format "->>>>>>>>>>9.<<<" @  F-ostatok-start
     3643         Prih          [p2] format "->>>>>>>>>>9.<<<" @  F-Prih
     3644         RAsh          [p2] format "->>>>>>>>>>9.<<<" @  F-RAsh
     3645         KAssa         [p2] format "->>>>>>>>>>9.<<<" @  F-KAssa
     3646         Inv           [p2] format "->>>>>>>>>>9.<<<" @  F-Inv
     3647         Overturn      [p2] format "->>>>>>>>>>9.<<<" @  F-Overturn
     3648         Ostatok-end   [p2] format "->>>>>>>>>>9.<<<" @  F-Ostatok-end
     3649         gds-zap-other      format "->>>>>>>>>>9.<<<" when (p2 = 1) @  gds-zap-other
     3650         with FRAME ZAPAS .
     3651   if Make-Excel then  put   stream ForExcel unformatted
     3652     p3 CHR(9)
     3653     p4 CHR(9)
     3654     gds-zap-gds-name CHR(9)
     3655     p6 CHR(9)
     3656     gds-zap-type     CHR(9)
     3657     excel-sum(gds-zap-other   )   CHR(9)
     3658     excel-qnty(ostatok-start[1])  CHR(9)
     3659     excel-sum(ostatok-start[2])  CHR(9)
     3660     excel-sum(ostatok-start[5])  CHR(9)
     3661     excel-sum(ostatok-start[8])  CHR(9)
     3662     excel-sum(ostatok-start[3])  CHR(9)
     3663     excel-sum(ostatok-start[6])  CHR(9)
     3664     excel-sum(ostatok-start[9])  CHR(9)
     3665     excel-qnty(Prih         [1])  CHR(9)
     3666     excel-sum(Prih         [2])  CHR(9)
     3667     excel-sum(Prih         [5])  CHR(9)
     3668     excel-sum(Prih         [8])  CHR(9)
     3669     excel-sum(Prih         [3])  CHR(9)
     3670     excel-sum(Prih         [6])  CHR(9)
     3671     excel-sum(Prih         [9])  CHR(9)
     3672     excel-qnty(RAsh         [1])  CHR(9)
     3673     excel-sum(RAsh         [2])  CHR(9)
     3674     excel-sum(RAsh         [5])  CHR(9)
     3675     excel-sum(RAsh         [8])  CHR(9)
     3676     excel-sum(RAsh         [3])  CHR(9)
     3677     excel-sum(RAsh         [6])  CHR(9)
     3678     excel-sum(RAsh         [9])  CHR(9)
     3679     excel-qnty(KAssa        [1])  CHR(9)
     3680     excel-sum(KAssa        [2])  CHR(9)
     3681     excel-sum(KAssa        [5])  CHR(9)
     3682     excel-sum(KAssa        [8])  CHR(9)
     3683     excel-sum(KAssa        [3])  CHR(9)
     3684     excel-sum(KAssa        [6])  CHR(9)
     3685     excel-sum(KAssa        [9])  CHR(9)
     3686     excel-qnty(Inv          [1])  CHR(9)
     3687     excel-sum(Inv          [2])  CHR(9)
     3688     excel-sum(Inv          [5])  CHR(9)
     3689     excel-sum(Inv          [8])  CHR(9)
     3690     excel-sum(Inv          [3])  CHR(9)
     3691     excel-sum(Inv          [6])  CHR(9)
     3692     excel-sum(Inv          [9])  CHR(9)
     3693     excel-qnty(Overturn     [1])  CHR(9)
     3694     excel-sum(Overturn     [2])  CHR(9)
     3695     excel-sum(Overturn     [5])  CHR(9)
     3696     excel-sum(Overturn     [8])  CHR(9)
     3697     excel-sum(Overturn     [3])  CHR(9)
     3698     excel-sum(Overturn     [6])  CHR(9)
     3699     excel-sum(Overturn     [9])  CHR(9)
     3700     excel-qnty(Ostatok-end  [1])  CHR(9)
     3701     excel-sum(Ostatok-end  [2])  CHR(9)
     3702     excel-sum(Ostatok-end  [5])  CHR(9)
     3703     excel-sum(Ostatok-end  [8])  CHR(9)
     3704     excel-sum(Ostatok-end  [3])  CHR(9)
     3705     excel-sum(Ostatok-end  [6])  CHR(9)
     3706     excel-sum(Ostatok-end  [9])  CHR(9)
     3707     skip.
     3708                 end.
     3709      end case.
     3710                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     3711    end procedure.
