      196   procedure create_obj-list :
      197      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      198      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      199      do
      200      on error undo, return error return-value
      201      :
      202         define buffer cli-obj for ub.clients .
      203         define variable p-var as integer no-undo .
      204         define buffer buf_obj-list for obj-list .
      205         find last buf_obj-list  use-index pi no-error .
      206         if available buf_obj-list
      207         then
      208            p-var = buf_obj-list.obj-id + 1.
      209         else
      210            p-var = 1.
      211         find first cli-obj where
      212                   cli-obj.obj-type = p-obj-type
      213               and cli-obj.obj-code = p-obj-code
      214         no-lock no-error.
      215         if available cli-obj
      216         then do:
      217            create buf_obj-list.
      218            assign
      219               buf_obj-list.obj-id   = p-var
      220               buf_obj-list.obj-code = cli-obj.obj-code
      221               buf_obj-list.obj-type = cli-obj.obj-type
      222               buf_obj-list.obj-name = cli-obj.obj-name
      223               buf_obj-list.db-num   = cli-obj.db-num
      224            .
      225         end.
      226      end.
      227   end.
