      647   procedure r-sale :
      648     define input parameter  p-doc-code          like ub.doc-line.doc-code          no-undo .
      649     define input parameter  p-artic             like ub.doc-line.artic             no-undo .
      650     define input parameter  p-prod-type         like ub.doc-line.prod-type         no-undo .
      651     define input parameter  p-prod-code         like ub.doc-line.prod-code         no-undo .
      652     define output parameter p-fact-qnty         like ub.ot-line.fact-qnty       no-undo .
      653     define output parameter p-vat-pc            like ub.doc-line.vat-pc         no-undo .
      654     define output parameter p-slt-pc            like ub.doc-line.slt-pc         no-undo .
      655     define output parameter p-sum-base          like ub.ot-line.sum-base        no-undo .
      656     define output parameter p-sum-rubl          like ub.ot-line.sum-rubl        no-undo .
      657     define output parameter p-vat-base          like ub.ot-line.vat-base        no-undo .
      658     define output parameter p-vat-rubl          like ub.ot-line.vat-rubl        no-undo .
      659     define output parameter p-slt-base          like ub.ot-line.slt-base        no-undo .
      660     define output parameter p-slt-rubl          like ub.ot-line.slt-rubl        no-undo .
      661     define output parameter p-road-tax-base     like ub.ot-line.road-tax-base   no-undo .
      662     define output parameter p-road-tax-rubl     like ub.ot-line.road-tax-rubl   no-undo .
      663     define output parameter p-transport-base    like ub.ot-line.transport-base  no-undo .
      664     define output parameter p-transport-rubl    like ub.ot-line.transport-rubl  no-undo .
      665     define output parameter p-other-base        like ub.ot-line.other-base      no-undo .
      666     define output parameter p-other-rubl        like ub.ot-line.other-rubl      no-undo .
      667     define output parameter p-excise-base       like ub.ot-line.excise-base     no-undo .
      668     define output parameter p-excise-rubl       like ub.ot-line.excise-rubl     no-undo .
      669     define variable vss-description as character no-undo initial "r-sale-01: обработка продажных цен товара".
      670     do
      671     on error undo, return error
      672     :
      673       define  variable price-rubl-with-tax-sale    like ub.doc-line.price-rubl no-undo.
      674       define  variable price-base-with-tax-sale    like ub.doc-line.price-base no-undo.
      675       define  variable price-rubl-without-tax-sale like ub.doc-line.price-rubl no-undo.
      676       define  variable price-base-without-tax-sale like ub.doc-line.price-base no-undo.
      677       define  variable vat-base-sale               like ub.doc-line.price-base no-undo.
      678       define  variable vat-rubl-sale               like ub.doc-line.price-rubl no-undo.
      679       define  variable vat-base-buyer              like ub.doc-line.price-base no-undo.
      680       define  variable vat-rubl-buyer              like ub.doc-line.price-rubl no-undo.
      681       define  variable slt-base-sale               like ub.doc-line.price-base no-undo.
      682       define  variable slt-rubl-sale               like ub.doc-line.price-rubl no-undo.
      683       define  variable road-tax-base-sale          like ub.doc-line.road-tax   no-undo.
      684       define  variable road-tax-rubl-sale          like ub.doc-line.road-tax   no-undo.
      685       define  variable excise-base-sale            like ub.doc-line.price-base no-undo.
      686       define  variable excise-rubl-sale            like ub.doc-line.price-rubl no-undo.
      687       define  variable discnt-base-sale            like ub.gds-dtl.discnt-base no-undo.
      688       define  variable discnt-rubl-sale            like ub.gds-dtl.discnt-rubl no-undo.
      689       define buffer out-vatp_gds-dtl     for ub.gds-dtl.
      690       define buffer buf_out-vatp_gds-dtl for ub.gds-dtl.
      691       define buffer out-vatp_parts       for ub.parts.
      692       define buffer out-vatp_sysconf     for ub.sysconf.
      693       define buffer out-vatp_doc-line    for ub.doc-line.
      694       define buffer out-vatp_goods       for ub.goods.
      695       define buffer out-vatp_trn-doc     for ub.trn-doc.
      696       define buffer out-vatp_doc-attr    for ub.doc-attr.
      697       define variable varprice-base-cons      like ub.doc-line.price-base initial 0.00 no-undo.
      698       define variable varprice-rubl-cons      like ub.doc-line.price-rubl initial 0.00 no-undo.
      699       define variable varfrm-cnsv-type         as   character                           no-undo.
      700       define variable varfrm-cnsv              as   character                           no-undo.
      701       define variable varroot-node             as   integer                             no-undo.
      702       define variable varempty-scale           as   logical                             no-undo.
      703       define variable varis-cons-parts-have    as   logical                             no-undo.
      704       define variable varsum-base-factovp      like ub.gds-dtl.price-base               no-undo.
      705       define variable varslt-base-factovp      like ub.gds-dtl.price-base               no-undo.
      706       define variable varvat-base-factovp      like ub.gds-dtl.price-base               no-undo.
      707       define variable varvatcons-base-factovp  like ub.gds-dtl.price-base               no-undo.
      708       define variable vardsc-base-factovp      like ub.gds-dtl.price-base               no-undo.
      709       define variable varsum-base-docovp       like ub.gds-dtl.price-base               no-undo.
      710       define variable varslt-base-docovp       like ub.gds-dtl.price-base               no-undo.
      711       define variable varvat-base-docovp       like ub.gds-dtl.price-base               no-undo.
      712       define variable varvatcons-base-docovp   like ub.gds-dtl.price-base               no-undo.
      713       define variable vardsc-base-docovp       like ub.gds-dtl.price-base               no-undo.
      714       define variable varsum-rubl-factovp      like ub.gds-dtl.price-base               no-undo.
      715       define variable varslt-rubl-factovp      like ub.gds-dtl.price-base               no-undo.
      716       define variable varvat-rubl-factovp      like ub.gds-dtl.price-base               no-undo.
      717       define variable varvatcons-rubl-factovp  like ub.gds-dtl.price-base               no-undo.
      718       define variable vardsc-rubl-factovp      like ub.gds-dtl.price-base               no-undo.
      719       define variable varsum-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
      720       define variable varslt-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
      721       define variable varvat-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
      722       define variable varvatcons-rubl-docovp   like ub.gds-dtl.price-base               no-undo.
      723       define variable vardsc-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
      724       define variable varfact-qnty             like ub.parts.fact-qnty                  no-undo.
      725       define variable varcons-qnty             like ub.parts.fact-qnty                  no-undo.
      726       define variable varis-one-gds-dtl        as   logical                             no-undo.
      727       define variable varcurprice-base         like ub.gds-dtl.cur-base                 no-undo.
      728       define variable varcurprice-rubl         like ub.gds-dtl.price-base               no-undo.
      729       define variable varcurdiscnt-base        like ub.gds-dtl.cur-base                 no-undo.
      730       define variable varcurdiscnt-rubl        like ub.gds-dtl.price-base               no-undo.
      731       define variable varoutvprb               as   character                           no-undo.
      732       define variable out-vatp-have-vat-slt    as   logical initial yes                 no-undo.
      733       define buffer   in-vatp-trn-doco  for ub.trn-doc .
      734       define buffer   in-vatp-partso    for ub.parts   .
      735       define buffer   in-vatp-doco      for ub.trn-doc .
      736       define buffer   in-vatp-goodso    for ub.goods   .
      737       define buffer   in-vatp-sysconfo  for ub.sysconf .
      738       define buffer   in-vatp_doc-attro for ub.doc-attr.
      739       define variable in-vatp-have-vat-slto       as   logical initial yes    no-undo.
      740       define variable vat-pc-loco                 like ub.doc-line.vat-pc     no-undo.
      741       define variable varinvprbo                  as   character              no-undo.
      742       define variable slt-pc-loco                 like ub.doc-line.slt-pc     no-undo.
      743       define variable cli-base-rateo              as   decimal                no-undo.
      744       define variable price-rubl-with-tax-loco    like ub.doc-line.price-rubl no-undo.
      745       define variable price-base-with-tax-loco    like ub.doc-line.price-base no-undo.
      746       define variable price-cli-with-tax-loco     like ub.doc-line.price-cli  no-undo.
      747       define variable price-rubl-without-tax-loco like ub.doc-line.price-rubl no-undo.
      748       define variable price-base-without-tax-loco like ub.doc-line.price-base no-undo.
      749       define variable price-cli-without-tax-loco  like ub.doc-line.price-base no-undo.
      750       define variable vat-base-loco               like ub.doc-line.price-base no-undo.
      751       define variable vat-rubl-loco               like ub.doc-line.price-rubl no-undo.
      752       define variable vat-cli-loco                like ub.doc-line.price-rubl no-undo.
      753       define variable slt-base-loco               like ub.doc-line.price-base no-undo.
      754       define variable slt-rubl-loco               like ub.doc-line.price-rubl no-undo.
      755       define variable slt-cli-loco                like ub.doc-line.price-rubl no-undo.
      756       define variable road-tax-base-loco          like ub.doc-line.road-tax   no-undo.
      757       define variable road-tax-rubl-loco          like ub.doc-line.road-tax   no-undo.
      758       define variable road-tax-cli-loco           like ub.doc-line.road-tax   no-undo.
      759       define variable transport-base-loco         like ub.doc-line.price-base no-undo.
      760       define variable transport-rubl-loco         like ub.doc-line.price-rubl no-undo.
      761       define variable transport-cli-loco          like ub.doc-line.price-rubl no-undo.
      762       define variable other-base-loco             like ub.doc-line.price-base no-undo.
      763       define variable other-rubl-loco             like ub.doc-line.price-rubl no-undo.
      764       define variable other-cli-loco              like ub.doc-line.price-rubl no-undo.
      765       define variable exch-rate-cli-loco          like ub.trn-doc.exch-rate   no-undo.
      766       define variable varinvatp-envdo             as   character              no-undo.
      767       define variable varinvatp-typeo             as   character              no-undo.
      768       define variable v-gds-dtl-fact-qnty as decimal no-undo .
      769       define buffer buf_gds-dtl  for ub.gds-dtl .
      770       define buffer buf_goods    for ub.goods .
      771       define buffer buf_trn-doc  for ub.trn-doc .
      772       define buffer buf_doc-line for ub.doc-line .
      773       find first buf_doc-line no-lock
      774         where buf_doc-line.doc-code  = p-doc-code
      775           and buf_doc-line.artic     = p-artic
      776           and buf_doc-line.prod-type = p-prod-type
      777           and buf_doc-line.prod-code = p-prod-code
      778         no-error .
      779       if not available buf_doc-line then do:
      780         message
      781           vss-workfile vss-revision vss-description skip
      782           vss-include-info11 skip
      783           "Ошибка задания входных параметров" skip
      784           "Не найдена строка документа" skip
      785           "Документ" p-doc-code skip
      786           "Артикул" p-artic p-prod-type p-prod-code skip
      787           view-as alert-box error .
      788         undo, return error .
      789       end.
      790       find first buf_trn-doc no-lock
      791         where buf_trn-doc.doc-code = buf_doc-line.doc-code
      792         no-error .
      793       if not available buf_trn-doc then do:
      794         message
      795           vss-workfile vss-revision vss-description skip
      796           vss-include-info11 skip
      797           "Не найден документ" skip
      798           "Документ" p-doc-code skip
      799           "Артикул" p-artic p-prod-type p-prod-code skip
      800           view-as alert-box error .
      801         undo, return error .
      802       end.
      803       for each buf_gds-dtl no-lock
      804         where buf_gds-dtl.doc-code  = buf_doc-line.doc-code
      805           and buf_gds-dtl.artic     = buf_doc-line.artic
      806           and buf_gds-dtl.prod-type = buf_doc-line.prod-type
      807           and buf_gds-dtl.prod-code = buf_doc-line.prod-code
      808       on error undo, return error
      809       :
      810           if buf_trn-doc.doc-type <> 'инв':U
      811           then do:
      812               if buf_trn-doc.doc-type = 'при':U
      813               or buf_trn-doc.doc-type = 'возврат':U
      814               then do:
      815                   assign
      816                       v-gds-dtl-fact-qnty = buf_gds-dtl.fact-qnty
      817                   .
      818               end.
      819               else do:
      820                   assign
      821                       v-gds-dtl-fact-qnty = - buf_gds-dtl.fact-qnty
      822                   .
      823               end.
      824           end.
      825           else do:
      826               assign
      827                   v-gds-dtl-fact-qnty = buf_gds-dtl.doc-qnty
      828               .
      829           end.
      830           if v-gds-dtl-fact-qnty <> 0
      831           then do:
      832   if buf_trn-doc.ext-doc-type = 'ot':U or
      833      buf_trn-doc.ext-doc-type = ?                 then do:
      834     assign
      835      out-vatp-have-vat-slt = yes.
      836   end.
      837   else do:
      838     find first out-vatp_doc-attr no-lock
      839       where out-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
      840         and out-vatp_doc-attr.attr-code = 'envd':U
      841         no-error .
      842     if not available out-vatp_doc-attr then do:
      843       assign
      844         out-vatp-have-vat-slt = yes.
      845     end.
      846     else do:
      847        out-vatp-have-vat-slt = no.
      848     end.
      849   end.
      850   find first out-vatp_goods where out-vatp_goods.artic     = buf_doc-line.artic     and
      851                                      out-vatp_goods.prod-type = buf_doc-line.prod-type and
      852                                      out-vatp_goods.prod-code = buf_doc-line.prod-code no-lock.
      853   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      854   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
      855     (input  buf_doc-line.artic
      856     ,input  buf_doc-line.prod-type
      857     ,input  buf_doc-line.prod-code
      858     ,output varroot-node
      859     ) no-error .
      860   if error-status :error then do:
      861     message
      862       vss-workfile vss-revision vss-description skip
      863       "Ошибка при определении корневого признака товара" skip
