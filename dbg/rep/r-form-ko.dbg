     2333   run define-full-path-Report-2(input g#report-num, output v-file-name-rep-htm-2).
     2334   run create-file(v-file-name-rep-htm-2).
     2335   v-report-name = "Журнал регистрации ПКО и РКО (КО-3) (страница 2 )".
     2336   do:
     2337       output stream macr_excel to value(v-file-name-rep-htm-2) append convert target 'UTF-8'.
     2338               put stream macr_excel unformatted
     2339                "<!DOCTYPE HTML>" skip
     2340                   ' <html>' skip
     2341                   '  <head>' skip
     2342                   '   <meta charset="utf-8">' skip
     2343             '    <style type="text/css">' skip
     2344                   '      table ' + chr(123) + ' border-collapse: collapse; font-size:9pt; font-family:Calibri; table-layout: fixed; width: 540px; hight:  padding: 8px;  ' + chr(125) skip
     2345                   '      td ' + chr(123) ' border: 1px black solid; word-wrap:break-word; ' + chr(125) skip
     2346                   '      htm' skip
     2347                   '      .rotate ' + chr(123) skip
     2348                   '        -webkit-transform: rotate(-90deg);' skip
     2349                   '        -moz-transform: rotate(-90deg);' skip
     2350                   '        -ms-transform: rotate(-90deg);' skip
     2351                   '        -o-transform: rotate(-90deg);' skip
     2352                   '        transform: rotate(-90deg);' skip
     2353                   '        -webkit-transform-origin: 50% 50%;' skip
     2354                   '        -moz-transform-origin: 50% 50%;' skip
     2355                   '        -ms-transform-origin: 50% 50%;' skip
     2356                   '        -o-transform-origin: 50% 50%;' skip
     2357                   '        transform-origin: 50% 50%;' skip
     2358                   '        filter: progid:DXImageTransform.Microsoft.BasicImage(rotation=3);' skip
     2359                   '          ' + chr(125) skip
     2360                   '            th' + ' ' + chr(123) skip
     2361                   '            border: 1px black solid;' skip
     2362                   '            word-wrap: break-word;' skip
     2363                   '          ' + chr(125) skip
     2364                   '   </style>' skip
     2365                   '  </head>' skip
     2366               .
     2367       end.
     2368    do:
     2369        put stream macr_excel unformatted
     2370            ' <body>' skip
     2371            '   <table name="КО-3" fit_to_page="true"  orientation="Portrait">' skip
     2372        '     <thead>' skip
     2373        '       <tr class="set_columns">' skip
     2374        '         <td style="width:80px; border: none;"></td>' skip
     2375        '         <td style="width:80px; border: none;"></td>' skip
     2376        '         <td style="width:80px; border: none;"></td>' skip
     2377        '         <td style="width:220px; border: none;"></td>' skip
     2378        '         <td style="width:80px; border: none;"></td>' skip
     2379        '         <td style="width:80px; border: none;"></td>' skip
     2380        '         <td style="width:80px; border: none;"></td>' skip
     2381        '         <td style="width:220px; border: none;"></td>' skip
     2382            '       </tr>' skip
     2383             .
     2384               end.
     2385    do:
     2386               put stream macr_excel unformatted
     2387               '     <tbody>' skip
     2388               '       <tr style="height: 50pt;">' skip
     2389               '         <th  colspan="2" style="background-color:#ffffcc; font-size:11pt; text-align: center;">Приходный документ</th>' skip
     2390               '         <th   rowspan = "2" style="background-color:#ffffcc; font-size:11pt; text-align: center;">Сумма, руб. коп</th>' skip
     2391               '         <th  rowspan = "2" style="background-color:#ffffcc; font-size:11pt;text-align: center;">Примечание</th>' skip
     2392               '         <th  colspan="2" style="background-color:#ffffcc; font-size:11pt; text-align: center;">Расходный документ</th>' skip
     2393               '         <th   rowspan = "2" style="background-color:#ffffcc;font-size:11pt; text-align: center;">Сумма, руб. коп.</th>' skip
     2394               '         <th  rowspan = "2" style="background-color:#ffffcc;  font-size:11pt; text-align: center;">Примечание</th>' skip
     2395               '</tr >'   skip
     2396               '       <tr style="height: 30pt;">' skip
     2397               '       <th   style="background-color:#ffffcc; font-size:11pt;text-align: center;">Дата</th>' skip
     2398               '       <th   style="background-color:#ffffcc; font-size:11pt;text-align: center;">Номер</th>' skip
     2399               '       <th   style="background-color:#ffffcc; font-size:11pt;text-align: center;">Дата</th>' skip
     2400               '       <th   style="background-color:#ffffcc; font-size:11pt;text-align: center;">Номер</th>' skip
     2401               '</tr>'
     2402               '       <tr style="height: 40pt;">' skip
     2403               '       <th   style="background-color:#ffffcc; font-size:11pt;text-align: center;">1</th>' skip
     2404               '       <th   style="background-color:#ffffcc; font-size:11pt;text-align: center;">2</th>' skip
     2405               '       <th   style="background-color:#ffffcc; font-size:11pt;text-align: center;">3</th>' skip
     2406               '       <th   style="background-color:#ffffcc; font-size:11pt;text-align: center;">4</th>' skip
     2407               '       <th   style="background-color:#ffffcc; font-size:11pt;text-align: center;">5</th>' skip
     2408               '       <th   style="background-color:#ffffcc; font-size:11pt;text-align: center;">6</th>' skip
     2409               '       <th   style="background-color:#ffffcc; font-size:11pt;text-align: center;">7</th>' skip
     2410               '       <th   style="background-color:#ffffcc; font-size:11pt;text-align: center;">8</th>' skip
     2411               '</tr>'
     2412   .
     2413   end.
     2414   do:
     2415       find first buf_income where buf_income.obj-code  = v-obj-list-code and buf_income.obj-type = v-obj-list-type and buf_income.fin-ext-doc-type = 'пко':U    no-lock no-error.
     2416       find first buf_expense where buf_expense.obj-code  = v-obj-list-code and buf_expense.obj-type = v-obj-list-type and buf_expense.fin-ext-doc-type =  'рко':U  no-lock  no-error .
     2417       do while available buf_income or available buf_expense  :
     2418           do:
     2419               put stream macr_excel unformatted
     2420                   '<tr>' skip
     2421                   '         <td  style="display: yes; font-size:11pt; text-align: left">' + (if available buf_income    then    fnc-DD-MM-YYYY(date(string(buf_income.doc-date,"99/99/9999"))) else " ")  + '</td>' skip
     2422                   '         <td style="display: yes; font-size:11pt; text-align:  left">' + (if available buf_income   then buf_income.prn-doc-code else " ") +  '</td>' skip
     2423                   '         <td style="display: yes; font-size:11pt; text-align:  left">' + (if available buf_income   then fnc-convert-dot-to-colon( buf_income.sum-doc, "->>>>>>>9.99") else " ") + '</td>' skip
     2424                   '         <td style="display: yes; font-size:11pt; word-wrap: break-word; text-align:  left">' + (if available buf_income   then   buf_income.receiver-name else " ") + '</td>' skip
     2425                   '         <td  style="display: yes; font-size:11pt; text-align: left">' + (if available buf_expense  then  fnc-DD-MM-YYYY(date(string(buf_expense.doc-date,"99/99/9999"))) else " ") + '</td>' skip
     2426                   '         <td style="display: yes; font-size:11pt; text-align:  left">' + (if available buf_expense then buf_expense.prn-doc-code else " ") +  '</td>' skip
     2427                   '         <td style="display: yes; font-size:11pt; text-align:  left">' + (if available buf_expense then  fnc-convert-dot-to-colon( buf_expense.sum-doc, "->>>>>>>9.99") else " ")  + '</td>' skip
     2428                   '         <td style="display: yes; font-size:11pt; word-wrap: break-word; text-align:  left">' + (if available buf_expense   then   buf_expense.receiver-name else " ") + '</td>' skip
     2429                   '</tr>' skip
     2430                   .
     2431               find next   buf_income   where buf_income.obj-code  = v-obj-list-code and buf_income.obj-type = v-obj-list-type and buf_income.fin-ext-doc-type = 'пко':U no-lock  no-error .
     2432               find next  buf_expense   where buf_expense.obj-code  = v-obj-list-code and buf_expense.obj-type = v-obj-list-type and buf_expense.fin-ext-doc-type =  'рко':U no-lock no-error .
     2433           end.
     2434       end.
     2435   end.
     2436   do:
     2437       put stream macr_excel unformatted
     2438           '</tbody>'skip
     2439           '</table>' skip
     2440           '</body>' skip
     2441           '</html>' skip.
     2442                   output stream OutStr-html close.
     2443   end.
     2444     run search-full-path-Report(input v-file-name-rep-htm).
     2445   run search-full-path-Report(input v-file-name-rep-htm-2).
     2446   run Report-Viewer(input v-full-path-RepView, input v-file-name-rep-htm-2 , input v-file-name-rep-htm).
     2447               procedure get-full-path-RepViewer:
     2448       define output parameter p-fill-path-RepView as character no-undo.
     2449       if search("exe\ReportViewer\reportviewer.exe") <> ? then
     2450       do:
     2451           p-fill-path-RepView = search("exe\ReportViewer\reportviewer.exe").
     2452       end.
     2453       else
     2454       do:
     2455           message "Не найдена программа просмотра отчёта!" view-as alert-box error.
     2456       end.
     2457   end procedure.
     2458   procedure search-full-path-Report:
     2459       define input parameter p-file-name as character no-undo.
     2460       if search(p-file-name) = ? then
     2461       do:
     2462           message "Не найден файл отчёта: " p-file-name view-as alert-box error.
     2463       end.
     2464       else
     2465       do:
     2466           p-file-name = search(p-file-name).
     2467       end.
     2468   end procedure.
     2469   procedure create-file:
     2470       define input parameter p-file-name as character no-undo.
     2471       output to value(string(p-file-name)).
     2472       output close.
     2473   end procedure.
     2474   procedure define-full-path-Report:
     2475       define input parameter p-rep-num as integer no-undo.
     2476       define output parameter p-file-name-rep-htm as character no-undo.
     2477       p-file-name-rep-htm = session:temp-directory  + string(p-rep-num)  + ".html".
     2478   end procedure.
     2479   procedure Report-Viewer:
     2480       define input parameter p-full-path-RepView as character no-undo.
     2481       define input parameter p-file-name-rep-htm as character no-undo.
     2482   define input parameter p-file-name-rep-htm-2 as char.
     2483       os-command no-wait value(p-full-path-RepView + " true " + search(p-file-name-rep-htm-2) + " " + search(p-file-name-rep-htm)).
     2484   end procedure.
     2485   procedure define-full-path-Report-2:
     2486       define input parameter p-rep-num as integer no-undo.
     2487       define output parameter p-file-name-rep-htm as character no-undo.
     2488       p-file-name-rep-htm = session:temp-directory  + string(p-rep-num) +  "страница-2"+ ".html".
     2489   end procedure.
     2490   function fnc-DD-MM-YYYY returns character
     2491   (input p-dat-date as date):
     2492       define variable result as character no-undo.
     2493       define variable p-str-date as character no-undo.
     2494       p-str-date = replace(string(p-dat-date,'99.99.9999'), "/", ".").
     2495           return p-str-date.
     2496   end function.
     2497   function fnc-convert-dot-to-colon returns character
     2498   (input p-data as decimal, input p-accur as character):
     2499       define variable result as character no-undo.
     2500       define variable v-str-result as character no-undo.
     2501       p-data = round(p-data, 2).
     2502       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     2503       return v-str-result.
     2504   end function.
