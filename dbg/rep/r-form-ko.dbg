     1869   define variable  v-format         as character no-undo .
     1870   define variable  v-label          as character no-undo .
     1871   define variable  v-user-can-edit  as logical   no-undo .
     1872   define variable  v-output-display as logical   no-undo .
     1873   define variable  v-other          as character no-undo .
     1874   define variable  v-type           as character no-undo .
     1875   define buffer buf_c-fin-doc-attr for ub.c-fin-doc-attr.
     1876   run fd-attr-code in this-procedure
     1877     (input  p-attr-code
     1878     ,output v-type
