     1904   function fnc-DD-MM-YYYY returns character
     1905   (input p-dat-date as date) forward.
     1906   function fnc-convert-dot-to-colon returns character
     1907   (input p-data as decimal, input p-accur as character) forward.
     1908   run get-full-path-RepViewer(output v-full-path-RepView).
     1909   run get-report-num in parParentProc(output g#report-num).
     1910   run define-full-path-Report(input g#report-num, output v-file-name-rep-htm).
     1911   run create-file(v-file-name-rep-htm).
     1912   v-report-name = "Журнал регистрации ПКО и РКО (КО-3)".
     1913   for each obj-list:
     1914   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1915   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
     1916     (input  obj-list.obj-type
     1917     ,input  obj-list.obj-code
     1918     ,output v-cntxt-host-code-obj
     1919     ,output v-cntxt-host-name-obj
     1920     )  .
     1921   v-obj-list-code = obj-list.obj-code.
     1922   v-obj-list-type = obj-list.obj-type.
     1923   end.
     1924   if x-TOG-Shift = no then
     1925   do:
     1926       for each fin-doc where fin-doc.doc-date  >= X-date-Start and fin-doc.doc-date <= X-date-End and fin-doc.obj-code = v-obj-list-code and fin-doc.obj-type = v-obj-list-type and (fin-doc.fin-doc-type = 'рко':U or fin-doc.fin-doc-type = 'пко':U) :
     1927           find first tt-fin-doc where
     1928               tt-fin-doc.obj-type = fin-doc.obj-type and
     1929               tt-fin-doc.obj-code = fin-doc.obj-code and
     1930               tt-fin-doc.fin-doc-code   = fin-doc.fin-doc-code no-error.
     1931           if not available tt-fin-doc then
     1932           do:
     1933               create tt-fin-doc.
     1934               buffer-copy fin-doc to tt-fin-doc.
     1935           end.
     1936       end.
     1937   end.
     1938   else
     1939   do:
     1940       find last  shift-obj where shift-obj.obj-code = v-obj-list-code and   shift-obj.obj-type = v-obj-list-type  and shift-obj.shift-date = x-Date-Start and shift-obj.shift-num   >= x-Shift-Start no-lock no-error .
     1941       if shift-obj.close-date = ?  then shift-obj.close-date = today.
     1942       for each fin-doc where fin-doc.doc-date  >= shift-obj.shift-date and fin-doc.obj-code = v-obj-list-code and fin-doc.obj-type = v-obj-list-type and (fin-doc.fin-doc-type = 'рко':U or fin-doc.fin-doc-type = 'пко':U) :
     1943           if (fin-doc.shift-date > X-date-Start   or (fin-doc.shift-date = X-date-Start and fin-doc.shift-num >= x-Shift-Start)) and
     1944               (fin-doc.shift-date < X-date-End or (fin-doc.shift-date = X-date-End and fin-doc.shift-num <= x-Shift-End))
     1945               then
     1946           do:
     1947               find first tt-fin-doc where
     1948                   tt-fin-doc.obj-type = fin-doc.obj-type and
     1949                   tt-fin-doc.obj-code = fin-doc.obj-code and
     1950                   tt-fin-doc.fin-doc-code   = fin-doc.fin-doc-code no-error.
     1951               if not available tt-fin-doc then
     1952               do:
     1953                   create tt-fin-doc.
     1954                   buffer-copy fin-doc to tt-fin-doc.
     1955               end.
     1956           end.
     1957       end.
