      184   def
      185    shared
      186   temp-table  obj-list no-undo
      187     field obj-type like ub.clients.obj-type
      188     field obj-code like ub.clients.obj-code
      189     field obj-name like ub.clients.obj-name
      190     field obj-id   as integer
