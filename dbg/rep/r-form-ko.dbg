     1090     or p-other-base     = ?
     1091     or p-other-rubl     = ?
     1092     or p-excise-base    = ?
     1093     or p-excise-rubl    = ?
     1094     then do:
     1095       message
     1096         vss-workfile vss-revision vss-description skip
     1097         vss-include-info11 skip
     1098         "Получены неопределенные значения" skip
     1099         "Документ" p-doc-code skip
     1100         "Артикул" p-artic p-prod-type p-prod-code skip
     1101         "fact-qnty     " p-fact-qnty      skip
     1102         "vat-pc        " p-vat-pc         skip
     1103         "slt-pc        " p-slt-pc         skip
     1104         "sum-base      " p-sum-base       skip
     1105         "sum-rubl      " p-sum-rubl       skip
     1106         "vat-base      " p-vat-base       skip
     1107         "vat-rubl      " p-vat-rubl       skip
     1108         "slt-base      " p-slt-base       skip
     1109         "slt-rubl      " p-slt-rubl       skip
     1110         "road-tax-base " p-road-tax-base  skip
     1111         "road-tax-rubl " p-road-tax-rubl  skip
     1112         "transport-base" p-transport-base skip
     1113         "transport-rubl" p-transport-rubl skip
     1114         "other-base    " p-other-base     skip
     1115         "other-rubl    " p-other-rubl     skip
     1116         "excise-base   " p-excise-base    skip
     1117         "excise-rubl   " p-excise-rubl    skip
     1118         view-as alert-box error .
     1119       undo, return error .
     1120     end.
     1121   end procedure.
     1122   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1123   procedure factord :
     1124     define input  parameter p-fact-date            as date    no-undo .
     1125     define input  parameter p-fact-time            as integer no-undo .
     1126     define input  parameter p-fact-num             as integer no-undo .
     1127     define input  parameter p-shift-date           as date    no-undo .
     1128     define input  parameter p-shift-num            as integer no-undo .
     1129     define input  parameter p-shift-on             as logical no-undo .
     1130     define output parameter p-fact-order           as decimal no-undo .
     1131     define output parameter p-shift-end-fact-order as decimal no-undo .
     1132     define output parameter p-day-end-fact-order   as decimal no-undo .
     1133     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1134     if p-fact-date = ?
     1135     then do:
     1136       return error "Не указана фактическая дата" .
     1137     end.
     1138     define variable v-fact-date-num as integer no-undo .
     1139     assign
     1140       v-fact-date-num = integer(p-fact-date)
     1141     .
     1142     if p-fact-num = ?
     1143     or p-fact-num = 0
     1144     then do:
     1145       return error "Не задан p-fact-num " + string(p-fact-num) .
     1146     end.
     1147     if p-fact-num < 0
     1148     then do:
     1149       return error "Отрицательный fact-num " + string(p-fact-num) .
     1150     end.
     1151     if p-fact-num >= 100000000
     1152     then do:
     1153       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1154     end.
     1155     if p-shift-on = true
     1156     then do:
     1157       if p-shift-date = ?
     1158       then do:
     1159         return error "Не задана дата смены" .
     1160       end.
     1161       if p-shift-num = ?
     1162       or p-shift-num = 0
     1163       then do:
     1164         return error "Не задан номер смены" .
     1165       end.
     1166     end.
     1167     else do:
     1168       assign
     1169         p-shift-date = p-fact-date
     1170         p-shift-num  = 24
     1171       .
     1172     end.
     1173     define variable v-shift-offset as integer no-undo .
     1174     if p-shift-date = p-fact-date
     1175     then do:
     1176       assign
     1177         v-shift-offset = 1
     1178       .
     1179     end.
     1180     if p-shift-date < p-fact-date
     1181     then do:
     1182       assign
     1183         v-shift-offset = 0
     1184       .
     1185     end.
     1186     if p-shift-date > p-fact-date
     1187     then do:
     1188       message
     1189         vss-workfile vss-revision vss-description skip
     1190         "Неправильная дата закрытия смены" skip
     1191         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1192         view-as alert-box error .
     1193       undo, return error
     1194         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1195           ,string(p-fact-date, '99/99/9999':U)
     1196           ,string(p-shift-date, '99/99/9999':U)
     1197           )
     1198       .
     1199     end.
     1200     if p-shift-num < 1
     1201     or p-shift-num > 24
     1202     then do:
     1203       message
     1204         vss-workfile vss-revision vss-description skip
     1205         "Неправильный номер смены" skip
     1206         "p-shift-num" p-shift-num skip
     1207         view-as alert-box error .
     1208       undo, return error return-value .
     1209     end.
     1210     assign
     1211       p-fact-order           = v-fact-date-num
     1212                              + v-shift-offset * 0.5
     1213                              + p-shift-num    * 0.02 - 0.01
     1214                              + p-fact-num     * 0.0000000001
     1215       p-shift-end-fact-order = v-fact-date-num
     1216                              + v-shift-offset * 0.5
     1217                              + p-shift-num    * 0.02
     1218       p-day-end-fact-order   = v-fact-date-num
     1219                              + 0.99
     1220     .
     1221     if p-fact-order           <= v-fact-date-num
     1222     or p-shift-end-fact-order <= v-fact-date-num
     1223     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1224     or p-shift-end-fact-order >= p-day-end-fact-order
     1225     then do:
     1226       message
     1227         vss-workfile vss-revision vss-description skip
     1228         "Внутренняя ошибка при генерации фактического номера" skip
     1229         "p-fact-date"            p-fact-date            skip
     1230         "p-fact-time"            p-fact-time            skip
     1231         "p-fact-num"             p-fact-num             skip
     1232         "p-shift-date"           p-shift-date           skip
     1233         "p-shift-num"            p-shift-num            skip
     1234         "p-shift-on"             p-shift-on             skip
     1235         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1236         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1237         "v-fact-date-num"        v-fact-date-num        skip
     1238         view-as alert-box error .
     1239       undo, return error return-value .
     1240     end.
     1241   end procedure.
     1242   procedure day-begin-fact-order :
     1243     define input  parameter p-fact-date            as date    no-undo .
     1244     define output parameter p-day-begin-fact-order as decimal no-undo .
     1245     do
     1246     on error undo, return error return-value
     1247     :
     1248       if p-fact-date = ?
     1249       then do:
     1250         assign
     1251           p-day-begin-fact-order = 0
     1252         .
     1253       end.
     1254       else do:
     1255         assign
     1256           p-day-begin-fact-order = integer(p-fact-date)
     1257         .
     1258       end.
     1259     end.
     1260   end procedure.
     1261   procedure factord-max-fact-order :
     1262     define output parameter p-max-fact-order as decimal   no-undo .
     1263     do
     1264     on error undo, return error return-value
     1265     :
     1266       run day-begin-fact-order in this-procedure
     1267         (input  date(1, 1, 5000)
     1268         ,output p-max-fact-order
     1269         ) .
     1270     end.
     1271   end procedure.
     1272   procedure factord-cut-archive :
     1273     define input  parameter p-obj-type             as character no-undo .
     1274     define input  parameter p-obj-code             as integer   no-undo .
     1275     define input  parameter p-fact-date            as date      no-undo .
     1276     define output parameter p-shift-on             as logical   no-undo .
     1277     define output parameter p-shift-date           as date      no-undo .
     1278     define output parameter p-shift-num            as integer   no-undo .
     1279     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1280     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1281     define variable v-fact-order as decimal   no-undo .
     1282     define buffer buf_shift-obj for ub.shift-obj .
     1283     do
     1284     on error undo, return error return-value
     1285     :
     1286   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1287   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1288     (input  p-obj-type
     1289     ,input  p-obj-code
     1290     ,input  'shift-on=request'
     1291     ,output p-shift-on
     1292     ) no-error .
     1293       if error-status :error
     1294       then do:
     1295         message
     1296           vss-workfile vss-revision vss-description skip
     1297           "Ошибка при определении атрибута объекта" skip
     1298           "Объект" p-obj-type p-obj-code skip
     1299           error-status :get-message(1) skip
     1300           return-value skip
     1301           view-as alert-box error .
     1302         undo, return error return-value .
     1303       end.
     1304       if p-shift-on = false
     1305       then do:
     1306         assign
     1307           p-shift-date               = ?
     1308           p-shift-num                = 0
     1309         .
     1310       end.
     1311       else do:
     1312         find first buf_shift-obj share-lock
     1313           where buf_shift-obj.obj-type   = p-obj-type
     1314             and buf_shift-obj.obj-code   = p-obj-code
     1315             and buf_shift-obj.shift-date > p-fact-date
     1316           use-index pi
     1317           no-error .
     1318         if not available buf_shift-obj
     1319         or buf_shift-obj.status_ <> 'зкр':U
     1320         then do:
     1321           message
     1322             vss-workfile vss-revision vss-description skip
     1323             "Невозможно вычислить последнюю смену" skip
     1324             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1325             "Объект" p-obj-type p-obj-code skip
     1326             "Дата" p-fact-date skip
     1327             view-as alert-box error .
     1328           undo, return error return-value .
     1329         end.
     1330         find last buf_shift-obj share-lock
     1331           where buf_shift-obj.obj-type = p-obj-type
     1332             and buf_shift-obj.obj-code = p-obj-code
     1333             and buf_shift-obj.shift-date <= p-fact-date
     1334           use-index pi
     1335           no-error .
     1336         if available buf_shift-obj
     1337         then do:
     1338           if  buf_shift-obj.status_ = 'зкр':U
     1339           then do:
     1340             assign
     1341               p-shift-date = buf_shift-obj.shift-date
     1342               p-shift-num  = buf_shift-obj.shift-num
     1343             .
     1344           end.
     1345           else do:
     1346             message
     1347               vss-workfile vss-revision vss-description skip
     1348               "Невозможно вычислить последнюю смену" skip
     1349               "Статус смены отличен от статуса" 'зкр':U skip
     1350               "Объект" p-obj-type p-obj-code skip
     1351               "Дата" p-fact-date skip
     1352               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1353               view-as alert-box error .
     1354             undo, return error return-value .
     1355           end.
     1356         end.
     1357         else do:
     1358           assign
     1359             p-shift-date = p-fact-date - 1
     1360             p-shift-num  = 1
     1361           .
     1362         end.
     1363       end.
     1364       run factord in this-procedure
     1365         (input  p-fact-date
     1366         ,input  1
     1367         ,input  1
     1368         ,input  p-shift-date
     1369         ,input  p-shift-num
     1370         ,input  p-shift-on
     1371         ,output v-fact-order
     1372         ,output p-shift-end-fact-order
     1373         ,output p-day-end-fact-order
     1374         ) no-error .
     1375       if error-status :error
     1376       then do:
     1377         message
     1378           vss-workfile vss-revision vss-description skip
     1379           "Ошибка при вызове процедуры factord"
     1380           error-status :get-message(1) skip
     1381           return-value skip
     1382           view-as alert-box error .
     1383         undo, return error return-value .
     1384       end.
     1385     end.
     1386   end procedure.
     1387   procedure factord-lock-shift :
     1388     define input  parameter p-obj-type  as character no-undo .
     1389     define input  parameter p-obj-code  as integer   no-undo .
     1390     define input  parameter p-fact-date as date      no-undo .
     1391     define parameter buffer buf_shift-obj for ub.shift-obj .
     1392     define variable v-shift-on      as logical   no-undo .
     1393     define variable v-extra-message as character no-undo .
     1394     define variable v-error as character no-undo .
     1395     do
     1396     on error undo, return error return-value
     1397     :
     1398   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1399   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1400     (input  p-obj-type
     1401     ,input  p-obj-code
     1402     ,input  'shift-on=request'
     1403     ,output v-shift-on
     1404     ) no-error .
     1405       if error-status :error
     1406       then do:
     1407         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1408         undo, return error v-error .
     1409       end.
     1410       if v-shift-on = true
     1411       then do:
     1412         find first buf_shift-obj share-lock
     1413           where buf_shift-obj.obj-type   = p-obj-type
     1414             and buf_shift-obj.obj-code   = p-obj-code
     1415             and buf_shift-obj.shift-date > p-fact-date
     1416           use-index pi
     1417           no-error .
     1418         if not available buf_shift-obj
     1419         or buf_shift-obj.status_ <> 'зкр':U
     1420         then do:
     1421           find last buf_shift-obj
     1422             where buf_shift-obj.obj-type = p-obj-type
     1423               and buf_shift-obj.obj-code = p-obj-code
     1424               and buf_shift-obj.status_  = 'зкр':U
     1425             use-index stts
     1426             no-error .
     1427           if available buf_shift-obj
     1428           then do:
     1429             assign
     1430               v-extra-message =
     1431                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1432                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1433                               )
     1434             .
     1435           end.
     1436           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1437           undo, return error v-error .
     1438         end.
     1439       end.
     1440     end.
     1441   end procedure.
     1442   procedure factord-end-day :
     1443     define input  parameter p-fact-date            as date    no-undo .
     1444     define output parameter p-day-end-fact-order   as decimal no-undo .
     1445     do
     1446     on error undo, return error return-value
     1447     :
     1448       if p-fact-date = ?
     1449       then do:
     1450         return error "Не указана фактическая дата" .
     1451       end.
     1452       assign
     1453         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1454       .
     1455     end.
     1456   end procedure.
     1457   procedure factord-to-date :
     1458     define input  parameter p-fact-order as decimal no-undo .
     1459     define output parameter p-fact-date  as date    no-undo .
     1460     define variable v-ref-date  as date      no-undo .
     1461     define variable v-ref-delta as integer   no-undo .
     1462     do
     1463     on error undo, return error return-value
     1464     :
     1465       if p-fact-order = ?
     1466       or p-fact-order = 0
     1467       then do:
     1468         return error "Не указан fact-order" .
     1469       end.
     1470       assign
     1471         v-ref-date  = date(1, 1, 2000)
     1472       .
     1473       assign
     1474         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1475       .
     1476       assign
     1477         p-fact-date = v-ref-date + v-ref-delta
     1478       .
     1479     end.
     1480   end procedure.
     1481   procedure factord-to-fact-num :
     1482     define input  parameter p-fact-order as decimal no-undo .
     1483     define output parameter p-fact-num   as integer no-undo .
     1484     define variable v-fact-order-trunc as decimal no-undo .
     1485     do
     1486     on error undo, return error return-value
     1487     :
     1488       if p-fact-order = ?
     1489       or p-fact-order = 0
     1490       then do:
     1491         return error "Не указан fact-order" .
     1492       end.
     1493       assign
     1494        v-fact-order-trunc = truncate(p-fact-order, 2)
     1495       .
     1496       assign
     1497         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1498       .
     1499     end.
     1500   end procedure.
     1501   procedure factord-to-shift-num :
     1502     define input  parameter p-fact-order as decimal no-undo .
     1503     define output parameter p-shift-num   as integer no-undo .
     1504     define variable  p-shift-numd  as decimal   no-undo .
     1505     define variable v-fact-order-trunc as decimal no-undo .
     1506     do
     1507     on error undo, return error return-value
     1508     :
     1509       if p-fact-order = ?
     1510       or p-fact-order = 0
     1511       then do:
     1512         return error "Не указан fact-order" .
     1513       end.
     1514       assign
     1515        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1516       .
     1517       if v-fact-order-trunc < 0.5 then do:
     1518         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1519       end.
     1520       assign
     1521         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1522         .
     1523        assign
     1524         p-shift-num = truncate (p-shift-numd , 0)
     1525       .
     1526     end.
     1527   end procedure.
     1528   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1529   procedure fd-attr-code :
     1530     do
     1531     on error undo, return error
     1532     :
     1533       define input  parameter p-code           as character no-undo .
     1534       define output parameter p-type           as character no-undo .
     1535       define output parameter p-format         as character no-undo .
     1536       define output parameter p-label          as character no-undo .
     1537       define output parameter p-user-can-edit  as logical   no-undo .
     1538       define output parameter p-output-display as logical   no-undo .
     1539       define output parameter p-other          as character no-undo .
     1540       case p-code :
     1541               when 'shift-date':U then do:     assign     p-label = "Дата смены"     p-type = 'T':U      p-format = "99/99/9999"     p-label = "Дата смены"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     1542               when 'shift-num':U then do:     assign     p-label = "П.смены"     p-type = 'I':U      p-format = "99"     p-label = "П.смены"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     1543               when 'shift-name':U then do:     assign     p-label = "№ смены"     p-type = 'C':U      p-format = "X(2)"     p-label = "№ смены"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     1544               when 'barcode':U then do:     assign     p-label = "Штрих-код"     p-type = 'C':U      p-format = "X(20)"     p-label = "Штрих-код"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     1545               when 'lockid':U then do:     assign     p-label = "ID блокировки чека"     p-type = 'C':U      p-format = "X(2)"     p-label = "ID блокировки чека"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     1546               when 'cover_sheet':U then do:     assign     p-label = "Разбиение по номиналам"     p-type = 'C':U      p-format = "X(4000)"     p-label = "Разбиение по номиналам"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     1547               when 'pre-vedom':U then do:     assign     p-label = "Атрибут для препроводительной ведомости"     p-type = 'C':U      p-format = "X(256)"     p-label = "Атрибут для препроводительной ведомости"     p-user-can-edit  = false     p-output-display = false     p-other = '':u      .   end.
     1548               when 'contr-kb':U then do:     assign     p-label = "Код кассовой книги получателя\отправителя при перемещении ДС между кассами"     p-type = 'I':U      p-format = ">>>9"     p-label = "Код кассовой книги получателя\отправителя при перемещении ДС между кассами"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     1549         otherwise do:
     1550           undo, return error "неизвестный атрибут платежа" + " " + p-code .
     1551         end.
     1552       end.
     1553     end.
     1554   end procedure.
     1555   procedure fd-attr-tooltip :
     1556     do
     1557     on error undo, return error
     1558     :
     1559       define input  parameter p-code    as character no-undo .
     1560       define output parameter p-tooltip as character no-undo .
     1561       define output parameter p-label   as character no-undo .
     1562       case p-code :
     1563               when 'shift-date':U then do:     assign     p-tooltip = "Дата смены"     p-label = "Дата смены" .   end.
     1564               when 'shift-num':U then do:     assign     p-tooltip = "П.смены"     p-label = "П.смены" .   end.
     1565               when 'shift-name':U then do:     assign     p-tooltip = "№ смены"     p-label = "№ смены" .   end.
     1566               when 'barcode':U then do:     assign     p-tooltip = "Штрих-код"     p-label = "Штрих-код" .   end.
     1567               when 'lockid':U then do:     assign     p-tooltip = "ID блокировки чека"     p-label = "ID блокировки чека" .   end.
     1568               when 'cover_sheet':U then do:     assign     p-tooltip = "Разбиение по номиналам"     p-label = "Разбиение по номиналам" .   end.
     1569               when 'pre-vedom':U then do:     assign     p-tooltip = "Атрибут для препроводительной ведомости"     p-label = "Атрибут для препроводительной ведомости" .   end.
     1570               when 'contr-kb':U then do:     assign     p-tooltip = "Код кассовой книги получателя\отправителя при перемещении ДС между кассами"     p-label = "Код кассовой книги получателя\отправителя при перемещении ДС между кассами" .   end.
     1571         otherwise do:
     1572           undo, return error "неизвестный атрибут платежа" + " " + p-code .
     1573         end.
     1574       end.
     1575     end.
     1576   end procedure.
     1577   procedure fin-doc-attr-write :
     1578    do
     1579    on error undo, return error return-value
     1580    :
     1581   define input parameter p-host-code     like ub.fin-doc-attr.host-code  no-undo .
     1582   define input parameter p-fin-doc-code  like ub.fin-doc-attr.fin-doc-code   no-undo .
     1583   define input parameter p-attr-code     like ub.fin-doc-attr.attr-code  no-undo .
     1584   define input parameter p-attr-value    like ub.fin-doc-attr.attr-value no-undo .
     1585   define variable  v-format         as character no-undo .
     1586   define variable  v-label          as character no-undo .
     1587   define variable  v-user-can-edit  as logical   no-undo .
     1588   define variable  v-output-display as logical   no-undo .
     1589   define variable  v-other          as character no-undo .
     1590   define variable  v-type           as character no-undo .
     1591   define buffer buf_fin-doc-attr for ub.fin-doc-attr.
     1592   run fd-attr-code in this-procedure
     1593                                     (input  p-attr-code
     1594                                     ,output v-type
     1595                                     ,output v-format
     1596                                     ,output v-label
     1597                                     ,output v-user-can-edit
     1598                                     ,output v-output-display
     1599                                     ,output v-other
     1600                                     ) no-error .
     1601   if error-status :error then do:
     1602     undo, return error return-value .
     1603   end.
     1604   find first buf_fin-doc-attr  exclusive-lock  where
     1605             buf_fin-doc-attr.attr-code    = p-attr-code
     1606         AND buf_fin-doc-attr.host-code    = p-host-code
     1607         AND buf_fin-doc-attr.fin-doc-code     = p-fin-doc-code  no-error .
     1608     if not available  buf_fin-doc-attr then do:
     1609         create buf_fin-doc-attr.
     1610         assign
     1611         buf_fin-doc-attr.attr-code    = p-attr-code
     1612         buf_fin-doc-attr.attr-value   = p-attr-value
     1613         buf_fin-doc-attr.host-code    = p-host-code
     1614         buf_fin-doc-attr.fin-doc-code     = p-fin-doc-code
     1615         .
     1616     end.
     1617     else do:
     1618          assign
     1619          buf_fin-doc-attr.attr-value = p-attr-value.
     1620     end.
     1621    end.
     1622   end procedure.
     1623   procedure fd-attr-exist :
     1624     do
     1625     on error undo, return error
     1626     :
     1627       define input parameter p-host-code     like ub.fin-doc-attr.host-code  no-undo .
     1628       define input parameter p-fin-doc-code  like ub.fin-doc-attr.fin-doc-code   no-undo .
     1629       define input parameter p-code          like ub.fin-doc-attr.attr-code  no-undo .
     1630       define output parameter p-exist   as logical  no-undo .
     1631       define buffer buf_fin-doc-attr for ub.fin-doc-attr .
     1632       define variable  v-type           as character no-undo .
     1633       define variable  v-format         as character no-undo .
     1634       define variable  v-label          as character no-undo .
     1635       define variable  v-user-can-edit  as logical   no-undo .
     1636       define variable  v-output-display as logical   no-undo .
     1637       define variable  v-other          as character no-undo .
     1638       run fd-attr-code in this-procedure
     1639         (input  p-code
     1640         ,output v-type
     1641         ,output v-format
     1642         ,output v-label
     1643         ,output v-user-can-edit
     1644         ,output v-output-display
     1645         ,output v-other
     1646         ) no-error .
     1647       if error-status :error then do:
     1648         undo, return error return-value .
     1649       end.
     1650       find first buf_fin-doc-attr exclusive-lock
     1651         where buf_fin-doc-attr.host-code  = p-host-code
     1652           and buf_fin-doc-attr.fin-doc-code  = p-fin-doc-code
     1653           and buf_fin-doc-attr.attr-code = p-code
     1654         no-error .
     1655       if  available buf_fin-doc-attr then do:
     1656         p-exist = yes.
     1657       end.
     1658     end.
     1659   end procedure.
     1660   procedure fd-attr-delete :
     1661     do
     1662     on error undo, return error
     1663     :
     1664     define input parameter p-host-code     like ub.fin-doc-attr.host-code  no-undo .
     1665     define input parameter p-fin-doc-code  like ub.fin-doc-attr.fin-doc-code   no-undo .
     1666     define input parameter p-code          like ub.fin-doc-attr.attr-code  no-undo .
     1667     define output parameter p-deleted  as logical no-undo.
     1668       define buffer buf_fin-doc-attr for ub.fin-doc-attr .
     1669       define variable  v-type           as character no-undo .
     1670       define variable  v-format         as character no-undo .
     1671       define variable  v-label          as character no-undo .
     1672       define variable  v-user-can-edit  as logical   no-undo .
     1673       define variable  v-output-display as logical   no-undo .
     1674       define variable  v-other          as character no-undo .
     1675       run fd-attr-code in this-procedure
     1676         (input  p-code
     1677         ,output v-type
     1678         ,output v-format
     1679         ,output v-label
     1680         ,output v-user-can-edit
     1681         ,output v-output-display
     1682         ,output v-other
     1683         ) no-error .
     1684       if error-status :error then do:
     1685         undo, return error return-value .
     1686       end.
     1687       find first buf_fin-doc-attr exclusive-lock
     1688         where buf_fin-doc-attr.host-code  = p-host-code
     1689           and buf_fin-doc-attr.fin-doc-code  = p-fin-doc-code
     1690           and buf_fin-doc-attr.attr-code = p-code
     1691         no-error NO-WAIT.
     1692       if not available buf_fin-doc-attr then do:
     1693         p-deleted = no.
     1694       end.
     1695       else do:
     1696         delete buf_fin-doc-attr no-error .
     1697         if error-status:error then do:
     1698           undo, return error return-value .
     1699         end.
     1700         p-deleted = yes.
     1701       end.
     1702     end.
     1703   end procedure.
