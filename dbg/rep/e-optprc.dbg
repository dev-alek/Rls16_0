      764               when 'wrsttl2':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = yes      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val =       p-label = "Реестр отоваренных талонов"     p-tooltip = "Реестр отоваренных талонов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      765               when 'wthobr-sup':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = yes      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val =       p-label = "Оборотная ведомость серийных МЦ по контрагентам"     p-tooltip = "Оборотная ведомость серийных МЦ по контрагентам"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      766               when 'wthobr-wth':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = yes      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val =       p-label = "Оборотная ведомость серийных МЦ по контрагентам"     p-tooltip = "Оборотная ведомость серийных МЦ по контрагентам"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      767               when 'e-ptlbal':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Оперативный балансовый отчет движения нефтепродуктов"     p-tooltip = "Оперативный балансовый отчет движения нефтепродуктов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      768               when 'ctrasm':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val =       p-label = "Контроль ассортиментной матрицы"     p-tooltip = "Контроль ассортиментной матрицы"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      769               when 'e-eslg-e':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Оперативный балансовый отчет движения нефтепродуктов"     p-tooltip = "Оперативный балансовый отчет движения нефтепродуктов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      770               when 'prphoto':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(2256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(2256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Прайс-лист с фото товаров"     p-tooltip = "Прайс-лист с фото товаров"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      771               when 'chkgdsfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Товарная строка чека - доп поля"     p-tooltip = "Товарная строка чека - доп поля "     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      772               when 'chkdocfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Чек - доп поля"     p-tooltip = "Чек - доп поля"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      773               when 'barcodfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Бар-код - доп поля"     p-tooltip = "Бар-код - доп поля"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      774                when 'UPD':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника Электронного документоборота"     p-tooltip = "Настройки справочника Электронного документоборота"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      775               when 'LK_RECEIPT':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-tooltip = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      776         otherwise do:
      777           undo, return error "неизвестная настройка пользователя usr-flt" + " " + p-code .
      778         end.
      779       end CASE.
      780     end.
      781   end procedure.
      782   procedure uf-get :
      783     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      784     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      785     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      786     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      787     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      788     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      789     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      790     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      791     do
      792     on error undo, return error
      793     :
      794       define buffer buf_usr-flt for ubflt.usr-flt .
      795       define variable v-use-List_     as logical   no-undo .
      796       define variable v-type-List_     as character no-undo .
      797       define variable v-format-List_   as character no-undo .
      798       define variable v-use-Naim      as logical   no-undo .
      799       define variable v-type-Naim      as character no-undo .
      800       define variable v-format-Naim    as character no-undo .
      801       define variable v-use-print-graft as logical   no-undo .
      802       define variable v-use-sort-gr     as logical   no-undo .
      803       define variable v-use-type-price  as logical   no-undo .
      804       define variable v-use-type-val    as logical   no-undo .
      805       define variable v-label          as character no-undo .
      806       define variable v-tooltip        as character no-undo .
      807       define variable v-user-can-edit  as logical   no-undo .
      808       define variable v-output-display as logical   no-undo .
      809       define variable v-other          as character no-undo .
      810       run uf-name in this-procedure
      811          (input  entry(1, p-code, chr(4))
      812         ,output v-use-List_
      813         ,output v-type-List_
      814         ,output v-format-List_
      815         ,output v-use-Naim
      816         ,output v-type-Naim
      817         ,output v-format-Naim
      818         ,output v-use-print-graft
      819         ,output v-use-sort-gr
      820         ,output v-use-type-price
      821         ,output v-use-type-val
      822         ,output v-label
      823         ,output v-tooltip
      824         ,output v-user-can-edit
      825         ,output v-output-display
      826         ,output v-other
      827         ) no-error .
      828       if error-status :error then do:
      829         undo, return error return-value .
      830       end.
      831       find first buf_usr-flt no-lock where
      832                  buf_usr-flt.Call-point     = p-code AND
      833                  buf_usr-flt.user-name       = p-user-name
      834         no-error .
      835       if avail buf_usr-flt then do:
      836         assign
      837         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
      838         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
      839         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
      840         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
      841         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
      842         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
      843         .
      844       end.
      845       else do:
      846         assign
      847         p-List_        = (if v-use-List_       then "":U                    else ?)
      848         p-Naim         = (if v-use-Naim        then "":U                    else ?)
      849         p-print-graft  = (if v-use-print-graft then no                      else ?)
      850         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
      851         p-type-price   = (if v-use-type-price  then no                      else ?)
      852         p-type-val     = (if v-use-List_       then no                      else ?)
      853         .
      854       end.
      855     end.
      856   end procedure.
      857   procedure uf-set :
      858     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      859     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      860     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      861     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      862     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      863     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      864     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      865     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      866     do
      867     on error undo, return error
      868     :
      869       define buffer buf_usr-flt for ubflt.usr-flt .
      870       define variable v-use-List_     as logical   no-undo .
      871       define variable v-type-List_     as character no-undo .
      872       define variable v-format-List_   as character no-undo .
      873       define variable v-use-Naim      as logical   no-undo .
      874       define variable v-type-Naim      as character no-undo .
      875       define variable v-format-Naim    as character no-undo .
      876       define variable v-use-print-graft as logical   no-undo .
      877       define variable v-use-sort-gr   as logical   no-undo .
      878       define variable v-use-type-price as logical   no-undo .
      879       define variable v-use-type-val  as logical   no-undo .
      880       define variable v-tooltip        as character no-undo .
      881       define variable v-label          as character no-undo .
      882       define variable v-user-can-edit  as logical   no-undo .
      883       define variable v-output-display as logical   no-undo .
      884       define variable v-other          as character no-undo .
      885       run uf-name in this-procedure
      886         (input  entry(1, p-code, chr(4))
      887         ,output v-use-List_
      888         ,output v-type-List_
      889         ,output v-format-List_
      890         ,output v-use-Naim
      891         ,output v-type-Naim
      892         ,output v-format-Naim
      893         ,output v-use-print-graft
      894         ,output v-use-sort-gr
      895         ,output v-use-type-price
      896         ,output v-use-type-val
      897         ,output v-label
      898         ,output v-tooltip
      899         ,output v-user-can-edit
      900         ,output v-output-display
      901         ,output v-other
      902         ) no-error .
      903       if error-status :error then do:
      904         undo, return error return-value .
      905       end.
      906       find first buf_usr-flt where
      907                  buf_usr-flt.Call-point     = p-code AND
      908                  buf_usr-flt.user-name       = p-user-name
      909         no-error .
      910       if not avail buf_usr-flt then do:
      911           create buf_usr-flt .
      912           assign
      913           buf_usr-flt.call-point = p-code
      914           buf_usr-flt.user-name  = p-user-name
      915           .
      916       end.
      917       if avail buf_usr-flt then do:
      918        assign
      919        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
      920        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
      921        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
      922        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
      923        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
      924        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
      925       .
      926       release buf_usr-flt.
      927       end.
      928       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
      929     end.
      930   end procedure.
      931   CREATE WIDGET-POOL.
      932   def var State-source as  WIDGET-HANDLE.
      933   define variable lns-cnt as integer   no-undo .
      934   DEFINE VARIABLE tg-price-doc AS LOGICAL INITIAL no
      935        LABEL "Выводить дополнительные е.и. при отсутствии переоценки"
      936        VIEW-AS TOGGLE-BOX
      937        SIZE 59 BY .83 NO-UNDO.
      938   DEFINE FRAME F-Main
      939        tg-price-doc AT ROW 2 COL 2 WIDGET-ID 10
      940       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      941            SIDE-LABELS NO-UNDERLINE THREE-D
      942            AT COL 1 ROW 1 SCROLLABLE .
      943   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      944   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      945   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      946   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      947   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      948   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      949   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      950   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      951         adm-object-hdl = FRAME F-Main:HANDLE.
      952   RUN ensure-broker.
      953   THIS-PROCEDURE:ADM-DATA =
      954        'ADM1.1~`':U +
      955        'SmartObject~`':U +
      956        '~`':U +
      957        'NO ~`':U +
      958        '~`':U +
      959        '~`':U +
      960        '~`':U +
      961        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      962           + "~`":U +
      963        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      964        'Record-Source,Record-Target,TableIO-Target~`':U +
      965        '~`':U +
      966        '~`~`~`~`~`~`~`~`~`~`~`':U +
      967        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      968            THEN "^^":U
      969        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      970             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      971   PROCEDURE adm-apply-entry :
      972     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      973   END PROCEDURE.
      974   PROCEDURE adm-destroy :
      975    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      976   END PROCEDURE.
      977   PROCEDURE adm-disable :
      978       DISABLE tg-price-doc WITH FRAME F-Main.
      979       RUN dispatch ('disable-fields':U).
      980       RUN set-attribute-list ('ENABLED=no':U).
      981       RETURN.
      982   END PROCEDURE.
      983   PROCEDURE adm-edit-attribute-list :
      984         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      985         RETURN.
      986   END PROCEDURE.
      987   PROCEDURE adm-enable :
      988       ENABLE UNLESS-HIDDEN tg-price-doc WITH FRAME F-Main.
      989       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      990       RUN set-attribute-list ('ENABLED=yes':U).
      991       RETURN.
      992   END PROCEDURE.
      993   PROCEDURE adm-exit :
      994        RUN notify ('exit':U).
      995     RETURN.
      996   END PROCEDURE.
      997   PROCEDURE adm-hide :
      998     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      999   END PROCEDURE.
     1000   PROCEDURE adm-initialize :
     1001     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1002   END PROCEDURE.
     1003   PROCEDURE adm-show-errors :
     1004       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1005       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1006           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1007       END.
     1008       RETURN.
     1009   END PROCEDURE.
     1010   PROCEDURE adm-UIB-mode :
     1011     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1012   END PROCEDURE.
     1013   PROCEDURE adm-view :
     1014     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1015   END PROCEDURE.
     1016   PROCEDURE dispatch :
     1017       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1018       RUN broker-dispatch IN adm-broker-hdl
     1019           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1020       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1021   END PROCEDURE.
     1022   PROCEDURE ensure-broker :
     1023   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1024   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1025   DO:
     1026       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1027       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1028   END.
     1029   END PROCEDURE.
     1030   PROCEDURE get-attribute :
     1031     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1032     RUN broker-get-attribute IN adm-broker-hdl
     1033         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1034     RETURN RETURN-VALUE.
     1035   END PROCEDURE.
     1036   PROCEDURE get-attribute-list :
     1037     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1038     RUN broker-get-attribute-list IN adm-broker-hdl
     1039         (INPUT THIS-PROCEDURE,
     1040          INPUT ?,
     1041          OUTPUT p-attr-list) NO-ERROR.
     1042     RETURN.
     1043   END PROCEDURE.
     1044   PROCEDURE new-state :
     1045     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1046     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1047     RETURN.
     1048   END PROCEDURE.
     1049   PROCEDURE notify :
     1050     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1051     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1052     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1053         RETURN "ADM-ERROR":U.
     1054     RETURN.
     1055   END PROCEDURE.
     1056   PROCEDURE set-attribute-list :
     1057     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1058     RUN ensure-broker.
     1059     RUN broker-set-attribute-list IN adm-broker-hdl
     1060         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1061     RETURN.
     1062   END PROCEDURE.
     1063   PROCEDURE set-position :
     1064       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1065       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1066       IF VALID-HANDLE(adm-object-hdl) THEN
     1067       DO:
     1068         ASSIGN adm-object-hdl:ROW    =   p-row
     1069                adm-object-hdl:COLUMN =   p-col.
     1070       END.
     1071       RETURN.
     1072   END PROCEDURE.
     1073   PROCEDURE adm-display-fields :
     1074       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1075       RETURN.
     1076   END PROCEDURE.
     1077   PROCEDURE adm-open-query :
     1078     RETURN.
     1079   END PROCEDURE.
     1080   PROCEDURE adm-row-changed :
     1081         IF VALID-HANDLE(adm-object-hdl) THEN
     1082           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1083         RUN notify ('row-available':U).
     1084         RETURN.
     1085   END PROCEDURE.
     1086   PROCEDURE reposition-query :
     1087       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1088       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1089       RETURN.
     1090   END PROCEDURE.
     1091     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1092     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1093     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1094     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1095     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1096     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1097     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1098     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1099     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1100     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1101     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1102     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1103     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1104     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1105     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1106     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1107     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1108     IF "":U = "":U THEN
     1109       RUN modify-list-attribute IN adm-broker-hdl
     1110         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1111     RUN use-create-on-add(?).
     1112   PROCEDURE adm-add-record :
     1113       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1114          "must have at least one Enabled Table to perform Add.":U
     1115          VIEW-AS ALERT-BOX ERROR.
     1116       RETURN.
     1117   END PROCEDURE.
     1118   PROCEDURE adm-assign-record :
     1119    MESSAGE
     1120          "Object ":U THIS-PROCEDURE:FILE-NAME
     1121            "must have at least one Enabled Table to perform Assign.":U
     1122              VIEW-AS ALERT-BOX ERROR.
     1123      RETURN.
     1124     END PROCEDURE.
     1125   PROCEDURE adm-assign-statement :
     1126     RETURN.
     1127   END PROCEDURE.
     1128   PROCEDURE adm-cancel-record :
     1129      RETURN.
     1130     END PROCEDURE.
     1131   PROCEDURE adm-copy-record :
     1132       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1133        "must have at least one Enabled Table to perform Copy.":U
     1134          VIEW-AS ALERT-BOX ERROR.
     1135       RETURN.
     1136   END PROCEDURE.
     1137   PROCEDURE adm-create-record :
     1138      RETURN.
     1139   END PROCEDURE.
     1140   PROCEDURE adm-current-changed :
     1141     RETURN.
     1142   END PROCEDURE.
     1143   PROCEDURE adm-delete-record :
     1144    MESSAGE
     1145          "Object ":U THIS-PROCEDURE:FILE-NAME
     1146            "must have at least one Enabled Table to perform Delete.":U
     1147              VIEW-AS ALERT-BOX ERROR.
     1148       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1149       RETURN.
     1150   END PROCEDURE.
     1151   PROCEDURE adm-disable-fields :
     1152         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1153       RETURN.
     1154   END PROCEDURE.
     1155   PROCEDURE adm-enable-fields :
     1156       RETURN.
     1157   END PROCEDURE.
     1158   PROCEDURE adm-end-update :
     1159     RETURN.
     1160   END PROCEDURE.
     1161   PROCEDURE adm-reset-record :
     1162       RETURN.
     1163   END PROCEDURE.
     1164   PROCEDURE adm-update-record :
     1165       MESSAGE
     1166         "Object ":U THIS-PROCEDURE:FILE-NAME
     1167           "must have at least one Enabled Table to perform Update.":U
     1168             VIEW-AS ALERT-BOX ERROR.
     1169      RETURN.
     1170   END PROCEDURE.
     1171   PROCEDURE check-modified :
     1172   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1173   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1174   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1175   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1176     IF check-state = "check":U THEN
     1177     DO:
     1178       RUN get-link-handle IN adm-broker-hdl
     1179         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1180            OUTPUT group-target-list).
     1181       IF group-target-list NE "":U THEN
     1182       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1183         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1184         RUN check-modified IN curr-widget ('group-check':U).
     1185         IF RETURN-VALUE NE "":U THEN
     1186         DO:
     1187           RUN check-modified-message(RETURN-VALUE).
     1188           RETURN "":U.
     1189         END.
     1190       END.
     1191     END.
     1192     RETURN "":U.
     1193   END PROCEDURE.
     1194   PROCEDURE check-modified-message :
     1195     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1196        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1197           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1198        IF RETURN-VALUE = "YES":U THEN
     1199           RUN notify ('view,CONTAINER-SOURCE':U).
     1200        MESSAGE IF p-changed-table NE ? THEN
     1201           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1202           ELSE "Current values have been changed."
     1203           SKIP "  Do you wish to save those changes?"
     1204           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1205        IF ANS THEN
     1206        DO:
     1207           IF group-assign-target THEN
     1208             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1209           ELSE RUN dispatch('update-record':U).
     1210           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1211           DO:
     1212               MESSAGE "Changes to the previous record were not saved."
     1213                 VIEW-AS ALERT-BOX ERROR.
     1214               IF group-assign-target THEN
     1215                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1216               ELSE RUN dispatch ('cancel-record':U).
     1217           END.
     1218        END.
     1219        ELSE DO:
     1220          IF group-assign-target THEN
     1221             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1222          ELSE RUN dispatch('cancel-record':U).
     1223        END.
     1224        RETURN.
     1225   END PROCEDURE.
     1226   PROCEDURE get-rowid :
     1227       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1228       ASSIGN
     1229       p-table   =   adm-first-table.
     1230       RETURN.
     1231   END PROCEDURE.
     1232   PROCEDURE init-group-assign :
     1233       RUN request-attribute IN adm-broker-hdl
     1234         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1235       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1236         group-assign-target = yes.
     1237       ELSE group-assign-target = no.
     1238       RETURN.
     1239   END PROCEDURE.
     1240   PROCEDURE set-editors :
     1241       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1242       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1243       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1244       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1245       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1246       DO WHILE VALID-HANDLE (curr-widget):
     1247           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1248              curr-widget:HIDDEN = no THEN DO:
     1249             CASE p-field-setting:
     1250               WHEN "INITIALIZE":U THEN
     1251               DO:
     1252                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1253                     read-only-list +
     1254                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1255                        STRING(curr-widget).
     1256               END.
     1257               WHEN "DISABLE":U OR
     1258               WHEN "ENABLE":U THEN
     1259               DO:
     1260                   curr-widget:SENSITIVE = yes.
     1261                   RUN get-attribute ('Read-Only-Editors':U).
     1262                   IF RETURN-VALUE = ? OR
     1263                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1264                       curr-widget:READ-ONLY =
     1265                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1266               END.
     1267               WHEN "CLEAR":U THEN
     1268                   curr-widget:SCREEN-VALUE = "":U.
     1269             END CASE.
     1270           END.
     1271           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1272       END.
     1273       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1274         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1275           + '"':U).
     1276       RETURN.
     1277   END PROCEDURE.
     1278   PROCEDURE use-check-modified-all :
     1279    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1280     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1281     RETURN.
     1282   END PROCEDURE.
     1283   PROCEDURE use-create-on-add :
     1284   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1285      RETURN.
     1286   END PROCEDURE.
     1287   PROCEDURE use-initial-lock :
     1288     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1289     ASSIGN adm-initial-lock = p-attr-value.
     1290     RETURN.
     1291   END PROCEDURE.
     1292     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1293   ASSIGN
     1294          FRAME F-Main:SCROLLABLE       = FALSE
     1295          FRAME F-Main:PRIVATE-DATA     =
     1296                   "DLGCLOSE".
     1297   if not this-procedure :persistent
     1298   then do:
     1299     message
     1300       vss-workfile vss-revision vss-description skip
     1301       "Ошибка при запуске процедуры" skip
     1302       "Данную процедуру следует запускать только с параметром persistent" skip
     1303       view-as alert-box error .
     1304     undo, return error .
     1305   end.
     1306   PROCEDURE disable_UI :
     1307     HIDE FRAME F-Main.
     1308     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1309   END PROCEDURE.
     1310   PROCEDURE GOTO-first-page :
     1311   message " Для этого отчета надо выбрать только один товар ! вернитесь на закладку <Параметры> и выберите 1 товар ".
     1312     RUN get-attribute IN THIS-PROCEDURE ('UIB-MODE').
     1313     IF RETURN-VALUE NE "DESIGN" THEN DO:
     1314       RUN get-link-handle IN adm-broker-hdl ( THIS-PROCEDURE, 'State':U , OUTPUT source-str ).
     1315       State-source = WIDGET-HANDLE ( source-str ).
     1316       IF not VALID-HANDLE ( State-source ) THEN
     1317         Message "Не определен линк " 'State':U view-as alert-box error.
     1318     END.
     1319      run Select1 IN State-source.
     1320   END PROCEDURE.
     1321   PROCEDURE local-initialize :
     1322     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1323     define variable v-found     as logical   no-undo.
     1324     define variable v-void-str  as character no-undo .
     1325     define variable v-void-log  as logical   no-undo .
     1326     define variable v-price-doc as logical   no-undo .
     1327     run uf-get (
     1328           input 'e-optprc.w':U
     1329         , input v-cntxt-userid
     1330         , output v-void-str
     1331         , output v-void-str
     1332         , output v-price-doc
     1333         , output v-void-log
     1334         , output v-void-log
     1335         , output v-void-log
     1336       ).
     1337       assign
     1338         tg-price-doc = v-price-doc
     1339       .
     1340       display
     1341         tg-price-doc
     1342       with frame F-Main.
     1343   END PROCEDURE.
     1344   PROCEDURE my-report :
     1345     define variable v-void-str  as character no-undo .
     1346     define variable v-void-log  as logical   no-undo .
     1347     assign frame F-Main
     1348       tg-price-doc
     1349     .
     1350     run uf-set (
     1351         input 'e-optprc.w':U
     1352       , input v-cntxt-userid
     1353       , input v-void-str
     1354       , input v-void-str
     1355       , input tg-price-doc
     1356       , input v-void-log
     1357       , input v-void-log
     1358       , input v-void-log
     1359      ) .
     1360     run rep/r-optprc.p ( input tg-price-doc ) .
     1361   END PROCEDURE.
     1362   PROCEDURE my-var :
     1363     assign frame F-Main
     1364       tg-price-doc
     1365     .
     1366     assign
     1367       ReportHeader = chr(10) + (if(tg-price-doc) then "В" else "Не в" ) + "ыводить дополнительные е.и. при отсутствии переоценки".
     1368     .
     1369   END PROCEDURE.
     1370   PROCEDURE state-changed :
     1371     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1372     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1373     CASE p-state:
     1374       When 'link-changed':U then do:
     1375            if lns-cnt > 1 and NOT Link# Then
     1376               run goto-first-page in this-procedure.
     1377       End.
     1378     END CASE.
     1379   END PROCEDURE.
