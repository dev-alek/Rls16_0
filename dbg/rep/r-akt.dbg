     1407         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     1408                 ) .
     1409   end.
     1410   end.
     1411   procedure print-line-fact :
     1412   do
     1413   on error undo, return error
     1414   :
     1415     run writelog in this-procedure (log-file-name, 1, "Вызов программы печати строки АКТА").
     1416     if not can-find( first gds-prt where gds-prt.upper-code = v-gds-prt-node-code )
     1417     then do:
     1418       run writelog in this-procedure (log-file-name, 2, "Пустая шкала").
     1419       if ( price-list.doc-qnty <> 0 ) or ( p-print-null-qnty = yes )
     1420       then do:
     1421           run writelog in this-procedure (log-file-name, 3, "Количество по документу > 0 ( = "
     1422                                                                  + string(price-list.doc-qnty)
     1423                                                                  + " ) или включена печать нулевого количества ( "
     1424                                                                  + string( p-print-null-qnty ) + " )"
     1425                                               ).
     1426           if v-print-cost-price
     1427           then do:
     1428               run writelog in this-procedure (log-file-name, 4, "Включена печать по учетным ценам").
     1429               if p-sort-by-group = yes
     1430               then do:
     1431   define variable vss-include-info18 as character format "X(65)" no-undo
     1432   initial "@(#)$Workfile$ $Revision$".
     1433       if v-shift-down = yes
     1434       then do:
     1435           down stream AktStr 1
     1436              with frame Akt-Cost
     1437           .
     1438           assign
     1439               v-shift-down = no
     1440           .
     1441       end.
     1442       if v-print-group = yes
     1443       then do:
     1444           run writelog in this-procedure (log-file-name, 4, "R-AKT.i   Печать имени группы ( " + goods.grp-name + " )").
     1445           put stream aktstr
     1446               goods.grp-name format "X(136)" AT 1
     1447           .
     1448       end.
     1449               end.
     1450               display stream AktStr
     1451                   sym1 trim( string( bar-code.b-code ) )  @ v-b-code
     1452                   price-list.artic
     1453                   v-gds-prt-node-name                     @ goods.gds-name
     1454                   price-list.doc-qnty                     when price-list.doc-qnty <> ?
     1455                   price-list.price-sale
     1456                   ( price-list.doc-qnty * price-list.price-sale )         @ v-new-sum
     1457                   v-gds-obj-last-price
     1458                   ( price-list.doc-qnty * v-gds-obj-last-price )          @ v-old-sum
     1459                   ( price-list.price-sale - v-gds-obj-last-price ) / v-gds-obj-last-price * 100
     1460                                                                           when v-gds-obj-last-price <> 0
     1461                                                                           @ v-up-fact
     1462                   sym7 with frame Akt-Cost .
     1463               down stream AktStr 1 with frame Akt-Cost .
     1464   define variable vss-include-info19 as character format "X(65)" no-undo
     1465   initial "@(#)$Workfile$ $Revision$".
     1466       if hvrdtax (recid(goods))
     1467       then do:
     1468           run tax-name (  input 'rdt':U
     1469                         , output v-taxname
     1470                        ).
     1471           assign
     1472               v-tax       = price-list.road-tax * price-list.doc-qnty
     1473               v-tax-sum   = v-tax-sum + v-tax
     1474           .
     1475           run writelog in this-procedure (log-file-name, 5, "R-AKT.i   Товар с третьим налогом ( "
     1476                                                       + dtm-char(v-taxname) + " ), определили значение ( " + dtm-char(string(v-tax))
     1477                                                       + " ) и сумму всего ( " + dtm-char(string(v-tax-sum)) + " )"
     1478                                               ).
     1479               for each parts
     1480               where parts.obj-type     = price-list.obj-type
     1481                   and parts.obj-code     = price-list.obj-code
     1482                   and parts.artic        = price-list.artic
     1483                   and parts.prod-type    = price-list.prod-type
     1484                   and parts.prod-code    = price-list.prod-code
     1485                   and parts.out-code     = price-list.doc-num
     1486               break by parts.road-tax-rubl
     1487               :
     1488                   if first-of( parts.road-tax-rubl )
     1489                   then do:
     1490                       assign
     1491                           v-tax-parts-qnty  = 0
     1492                       .
     1493                   end.
     1494                   assign
     1495                       v-tax-parts-qnty    = v-tax-parts-qnty  + parts.fact-qnty
     1496                   .
     1497                   if last-of( parts.road-tax-rubl )
     1498                   then do:
     1499                       display stream AktStr
