     1008                                               ( price-list.doc-qnty ) (total)
     1009                                               ( price-list.doc-qnty * v-price-list-price-sale_old ) (total)
     1010                                               ( price-list.doc-qnty * price-list.price-sale ) (total)
     1011                                               ( price-list.doc-qnty * v-gds-obj-last-price ) (total) .
