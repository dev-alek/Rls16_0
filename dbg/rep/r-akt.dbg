     1041           display stream AktStr
     1042             "Итого" format "X(8)" @ goods.gds-name
     1043             accum total ( price-list.doc-qnty ) @ price-list.doc-qnty
     1044             accum total ( price-list.doc-qnty * v-price-list-price-sale_old ) @ v-old-sum
     1045             accum total ( price-list.doc-qnty * price-list.price-sale ) @ v-new-sum
     1046             ( 100 * (
