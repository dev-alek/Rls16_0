     1804                   sym5 price-list.doc-qnty               when price-list.doc-qnty <> ?
     1805                   v-gds-obj-last-price
     1806                   price-list.price-sale
     1807                   ( 100 * ( price-list.price-sale - v-gds-obj-last-price )
     1808                   / v-gds-obj-last-price )
