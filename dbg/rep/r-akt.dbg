     1022               accum total ( price-list.doc-qnty * v-gds-obj-last-price )   @ v-old-sum
     1023               accum total ( price-list.doc-qnty * price-list.price-sale )  @ v-new-sum
     1024               ( 100 * (
     1025               ( accum total ( price-list.doc-qnty * price-list.price-sale ) )
     1026               / ( accum total ( price-list.doc-qnty * v-gds-obj-last-price ) )
     1027               ) - 100 )
     1028               when round(
     1029               accum total ( price-list.doc-qnty * v-gds-obj-last-price ), 2
     1030                         ) <> 0
     1031                                                                             @ v-up-fact
     1032           with frame Akt-Cost .
     1033           underline stream AktStr
     1034             price-list.doc-qnty
     1035             v-old-sum
     1036             v-new-sum
     1037             v-up-fact
     1038           with frame Akt-Cost .
