     1765   procedure print-line-no-fact :
     1766   do
     1767   on error undo, return error
     1768   :
     1769       run writelog in this-procedure (log-file-name, 1, "Вызов программы печати строки НЕ АКТА").
     1770       if not can-find( first gds-prt where gds-prt.upper-code = v-gds-prt-node-code)
     1771       then do:
     1772           if v-print-cost-price
     1773           then do:
     1774               if p-sort-by-group = yes
     1775               then do:
     1776   define variable vss-include-info24 as character format "X(65)" no-undo
     1777   initial "@(#)$Workfile$ $Revision$".
