     1788       then do:
     1789           run writelog in this-procedure (log-file-name, 4, "R-AKT.i   Печать имени группы ( " + goods.grp-name + " )").
     1790           put stream aktstr
     1791               goods.grp-name format "X(136)" AT 1
     1792           .
     1793       end.
     1794               end.
     1795               assign
     1796                   v-line-counter = v-line-counter + 1
     1797                   v-good-line-counter = v-good-line-counter + 1
     1798               .
