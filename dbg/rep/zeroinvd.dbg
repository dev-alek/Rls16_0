        1   define output parameter v-dif as char no-undo.
        2   def var vss-revision    as character no-undo init "$Revision$":U .
        3   def var vss-author      as character no-undo init "$Author$":U .
        4   def var vss-date        as character no-undo init "$Date$":U .
        5   def var vss-workfile    as character no-undo init "$Workfile$":U .
        6   def var vss-archive     as character no-undo init "$Archive$":U .
        7   def var vss-description as character no-undo init "Диалог к печати пустографки ".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   procedure proc-alt-shift-f2:
       63     if not ibs.th.gbl.gbl-var:rcode
       64   then
       65     run gbl\inidebug.p .
       66   end.
       67   procedure proc-alt-shift-f3:
       68     run gbl/prvssinf.p
       69       ( input this-procedure
       70       ) .
       71   end.
       72   define variable v-inform-launched as logical no-undo initial false .
       73   procedure proc-alt-shift-f4:
       74     define variable v-action as character no-undo .
       75     if v-inform-launched = false then do:
       76       assign
       77         v-inform-launched = true
       78       .
       79       run gbl/d-inform.w
       80         (  input self
       81         ,  input this-procedure
       82         , output v-action
       83         ) no-error .
       84       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       85       assign
       86         v-inform-launched = false
       87       .
       88     end.
       89   end.
       90   procedure proc-alt-f1:
       91     run gbl/corrhelp.p
       92       (input this-procedure
       93       ) .
       94   end .
       95   on alt-shift-f2 anywhere do:
       96     run proc-alt-shift-f2.
       97   end.
       98   on alt-shift-f3 anywhere do:
       99     run proc-alt-shift-f3 in this-procedure .
      100   end.
      101   on alt-shift-f4 anywhere do:
      102     run proc-alt-shift-f4 in this-procedure.
      103   end.
      104   on alt-f1 anywhere do:
      105     run proc-alt-f1 in this-procedure .
      106   end.
      107   DEFINE BUTTON b-help
      108        LABEL "&Помощь"
      109        SIZE 10 BY 1.
      110   DEFINE BUTTON Btn_OK AUTO-GO
      111        LABEL "Ввод"
      112        SIZE 10 BY 1
      113        BGCOLOR 8 .
      114   DEFINE VARIABLE RADIO-SET-1 AS CHARACTER INITIAL "all"
      115        VIEW-AS RADIO-SET VERTICAL
      116        RADIO-BUTTONS
      117             "&Все", "all",
      118   "&Излишки", "surplus",
      119   "&Недостача", "shortage",
      120   "&Совпадение", "coincidence",
      121   "Нулевой &остаток", "zero-remainder"
      122        SIZE 26 BY 3 NO-UNDO.
      123   DEFINE FRAME Dialog-Frame
      124        b-help AT ROW 1 COL 19 WIDGET-ID 2
      125        RADIO-SET-1 AT ROW 2 COL 2 NO-LABEL
      126        Btn_OK AT ROW 6 COL 10
      127        "Товары:" VIEW-AS TEXT
      128             SIZE 8 BY 1 AT ROW 1 COL 2
      129             FGCOLOR 4
      130        SPACE(19.00) SKIP(5.00)
      131       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      132            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      133            TITLE "Инвентаризация (пустографка)"
      134            DEFAULT-BUTTON Btn_OK.
      135   ASSIGN
      136          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      137          FRAME Dialog-Frame:HIDDEN           = TRUE.
      138   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      139   DO:
      140     APPLY "END-ERROR":U TO SELF.
      141   END.
      142   on choose of Btn_OK
      143   do:
      144     assign radio-set-1.
      145     assign
      146       v-dif = radio-set-1
      147     .
      148   end.
      149   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      150   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      151   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      152   on help of frame Dialog-Frame
      153   do:
      154     run gbl/app_help.p
      155       (input this-procedure :file-name
      156       ,input ''
      157       ,input ?
      158       ) no-error.
      159     if error-status :error then do:
      160       message
      161         "Ошибка при вызове помощи"
      162         error-status :get-message(1)
      163         view-as alert-box .
      164     end.
      165   end.
      166   run minbtn-set in this-procedure .
      167   on choose of b-help in frame Dialog-Frame
      168   do:
      169     apply "help":u to frame Dialog-Frame .
      170   end.
      171   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      172   procedure minbtn-set :
      173       do
      174           on error undo, return error return-value
      175           :
      176           define variable ii              as integer       no-undo .
      177           define variable fh              as widget-handle no-undo .
      178           define variable hh              as widget-handle no-undo .
      179           define variable v-h             as handle        extent 4 no-undo .
      180           define variable v-name-button   as character     no-undo .
      181           define variable v-help-old-x    as decimal       no-undo .
      182           define variable v-help-old-y    as decimal       no-undo .
      183           define variable v-help-old-size as decimal       no-undo .
      184           define variable v-frame-width   as decimal       no-undo .
      185           define variable jj              as integer       no-undo .
      186           do
      187               on error undo, return error
      188               :
      189               assign
      190                   v-frame-width = frame Dialog-Frame:width - 0.3
      191                   fh            = frame Dialog-Frame:first-child
      192                   hh            = fh:first-child
      193                   ii            = 1
      194                   .
      195               do while valid-handle(hh):
      196                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      197                   do:
      198                       case lc(hh:name) :
      199                           when "b-help" then
      200                               do:
      201                                   hh:load-image-up("cmp/b-help.bmp":u) .
      202                                   hh:load-image-down("cmp/b-help.bmp":u) .
      203                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      204                                   hh:TOOLTIP = "Помощь" .
      205                                   v-help-old-x = hh:column .
      206                                   v-help-old-y = hh:row    .
      207                                   v-help-old-size = hh:width .
      208                                   hh:width-chars = 2.5 .
      209                               end.
      210                           when "b-print" then
      211                               do:
      212                                   hh:load-image("cmp/b-print.bmp":u) .
      213                                   hh:TOOLTIP = "Печать" .
      214                                   v-h[ii] = hh:handle .
      215                                   ii = ii + 1 .
      216                                   hh:width-chars = 3 .
      217                               end.
      218                           when "b-history" or
      219                           when "b-hist" then
      220                               do:
      221                                   hh:load-image("cmp/b-hist.bmp":u) .
      222                                   hh:TOOLTIP = "История" .
      223                                   v-h[ii] = hh:handle .
      224                                   ii = ii + 1 .
      225                                   hh:width-chars = 3 .
      226                               end.
      227                           when "b-sch" then
      228                               do:
      229                                   hh:load-image("cmp/b-sch.bmp":u) .
      230                                   hh:TOOLTIP = "Установка Фильтра" .
      231                                   v-h[ii] = hh:handle .
      232                                   ii = ii + 1 .
      233                                   hh:width-chars = 3 .
      234                               end.
      235                           when "b-hist-user" then
      236                               do:
      237                                   hh:load-image("cmp/b-hist.bmp":u) .
      238                                   hh:TOOLTIP = "История пользователя" .
      239                                   ii = ii + 1 .
      240                               end.
      241                       end case.
      242                   end.
      243                   hh = hh:next-sibling.
      244               end.
      245               b-help:column = v-frame-width - b-help:width-chars.
      246               jj = 0.
      247               repeat ii = 4 to 1 by -1 :
      248                   if valid-handle (v-h[ii] ) then
      249                   do:
      250                       jj  = jj + 1 .
      251                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      252                       v-h[ii]:row    = v-help-old-y .
      253                   end.
      254               end.
      255           end.
      256       end.
      257   end procedure.
      258   MAIN-BLOCK:
      259   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      260      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      261     RUN enable_UI.
      262     WAIT-FOR GO OF FRAME Dialog-Frame.
      263   END.
      264   RUN disable_UI.
      265   PROCEDURE disable_UI :
      266     HIDE FRAME Dialog-Frame.
      267   END PROCEDURE.
      268   PROCEDURE enable_UI :
      269     DISPLAY RADIO-SET-1
      270         WITH FRAME Dialog-Frame.
      271     ENABLE b-help RADIO-SET-1 Btn_OK
      272         WITH FRAME Dialog-Frame.
      273     VIEW FRAME Dialog-Frame.
      274   END PROCEDURE.
