        1   block-level on error undo, throw.
        2   define input parameter parParentProc     AS WIDGET-HANDLE NO-UNDO.
        3   define input parameter rec_id              as recid        no-undo .
        4   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   def var vss-author      as character no-undo init "$Author: expertek $":U .
        6   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   def var vss-workfile    as character no-undo init "$Workfile: r-akt-st.p $":U .
        8   def var vss-archive     as character no-undo init "$Archive: rep/r-akt-st.p $":U .
        9   def var vss-description as character no-undo init "Печать акта смены типа приобретени ".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   procedure cur-time :
       72      define output parameter p-today as date      no-undo .
       73      define output parameter p-time  as integer   no-undo .
       74     do
       75     on error undo, return error
       76     :
       77       define variable v-date1 as date      no-undo .
       78       define variable v-date2 as date      no-undo .
       79       define variable v-time  as integer   no-undo .
       80       assign
       81         v-date1 = today
       82         v-time  = time
       83         v-date2 = today
       84       .
       85       if v-date1 <> v-date2
       86       then do:
       87         assign
       88           v-date1 = today
       89           v-time  = v-time
       90         .
       91       end.
       92       assign
       93         p-today = v-date1
       94         p-time  = v-time
       95       .
       96     end.
       97   end.
       98   function cur-time-date returns character
       99   :
      100     return string(today, '99/99/9999':U) .
      101   end.
      102   function cur-time-mjd returns decimal
      103   :
      104     define variable v-date as date      no-undo .
      105     define variable v-time as integer   no-undo .
      106     run cur-time in this-procedure
      107       (output v-date
      108       ,output v-time
      109       ) .
      110     return integer(v-date) - 2400002 + (v-time / 86400) .
      111   end.
      112   function cur-time-get-ending-index returns integer
      113   (input p-number as integer
      114   )
      115   :
      116     if p-number < 0
      117     or p-number = ?
      118     then do:
      119       return 1 .
      120     end.
      121     define variable v-rest as integer   no-undo .
      122     assign
      123       p-number = p-number modulo 100
      124     .
      125     if p-number < 20
      126     then do:
      127       assign
      128         v-rest = p-number
      129       .
      130     end.
      131     else do:
      132       assign
      133         v-rest = p-number modulo 10
      134       .
      135     end.
      136     case v-rest :
      137       when 1
      138       then do:
      139         return 2 .
      140       end.
      141       when 2 or
      142       when 3 or
      143       when 4
      144       then do:
      145         return 3 .
      146       end.
      147       otherwise do:
      148         return 1 .
      149       end.
      150     end case .
      151   end.
      152   procedure cur-time-mjd-to-date :
      153      define input  parameter i-mjd-diff as decimal no-undo.
      154      define output parameter o-Date     as date    no-undo.
      155      define output parameter o-Time     as integer no-undo.
      156      define variable v-day-number as integer   no-undo .
      157      if    i-mjd-diff < 0
      158         or i-mjd-diff = ?
      159      then do:
      160         return "?" .
      161      end.
      162      assign
      163         v-day-number = truncate(i-mjd-diff,0).
      164         o-Date = date(v-day-number + 2400002).
      165         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      166     .
      167   end.
      168   function cur-time-mjd-to-string returns character
      169   (input p-mjd-diff as decimal
      170   )
      171   :
      172     define variable v-day-number as integer   no-undo .
      173     define variable v-seconds    as integer   no-undo .
      174     define variable v-hour       as integer   no-undo .
      175     define variable v-min        as integer   no-undo .
      176     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      177     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      178     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      179     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      180     if p-mjd-diff < 0
      181     or p-mjd-diff = ?
      182     then do:
      183       return "?" .
      184     end.
      185     assign
      186       v-day-number = integer(truncate(p-mjd-diff,0))
      187       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      188     .
      189     if v-seconds > 86400
      190     then do:
      191       assign
      192         v-seconds = 86400 - 1
      193       .
      194     end.
      195     if v-seconds < 0
      196     then do:
      197       assign
      198         v-seconds = 0
      199       .
      200     end.
      201     assign
      202       v-hour = truncate(v-seconds / 3600, 0)
      203     .
      204     assign
      205       v-seconds = v-seconds modulo 3600
      206     .
      207     assign
      208       v-min = truncate(v-seconds / 60, 0)
      209     .
      210     assign
      211       v-seconds = v-seconds modulo 60
      212     .
      213     return
      214         (if v-day-number <> 0
      215           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      216           else ""
      217         )
      218       + (if v-day-number <> 0 or v-hour <> 0
      219           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      220           else ""
      221         )
      222       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      223           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      224           else ""
      225         )
      226       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      227       .
      228   end.
      229   function cur-time-string returns character
      230   :
      231     define variable v-date as date      no-undo .
      232     define variable v-time as integer   no-undo .
      233     run cur-time in this-procedure
      234       (output v-date
      235       ,output v-time
      236       ) .
      237     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      238   end.
      239   function cur-time-string-sec returns character
      240   :
      241     define variable v-date as date      no-undo .
      242     define variable v-time as integer   no-undo .
      243     run cur-time in this-procedure
      244       (output v-date
      245       ,output v-time
      246       ) .
      247     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      248   end.
      249   function cur-time-custom  returns character
      250   (input p-prefix as character
      251   ,input p-date-format as character
      252   ,input p-delimiter as character
      253   ,input p-time-format as character
      254   ,input p-suffix as character
      255   )
      256   :
      257     define variable v-date as date      no-undo .
      258     define variable v-time as integer   no-undo .
      259     run cur-time in this-procedure
      260       (output v-date
      261       ,output v-time
      262       ) .
      263     return
      264       p-prefix
      265       + string(v-date, p-date-format)
      266       + p-delimiter
      267       + string(v-time, p-time-format)
      268       + p-suffix
      269       .
      270   end.
      271   function cur-time-print  returns character
      272   :
      273     define variable v-date as date      no-undo .
      274     define variable v-time as integer   no-undo .
      275     run cur-time in this-procedure
      276       (output v-date
      277       ,output v-time
      278       ) .
      279     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      280   end.
      281   function cur-time-datetime returns datetime
      282   :
      283     define variable v-char as character no-undo .
      284     define variable v-datetime as datetime no-undo .
      285     v-char = cur-time-string().
      286     v-datetime = datetime(v-char).
      287     return  v-datetime.
      288   end.
      289   function cur-time-string-msec returns character
      290   :
      291     define variable v-date as datetime  no-undo .
      292     v-date = now.
      293     return string(v-date) .
      294   end.
      295   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      296   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      297   define  shared variable RepPathName        as character no-undo .
      298   define  shared variable PrintRubl          as logical   no-undo .
      299   do
      300   on error undo, return error
      301   :
      302     define variable g#report-num as integer   no-undo .
      303     run get-report-num  in parParentProc ( output g#report-num ).
      304     define variable g#quest-print as logical   no-undo .
      305     run get-quest-print in parParentProc ( output g#quest-print ).
      306     define variable g#log as logical   no-undo .
      307     define buffer buf_clients for clients.
      308     define buffer buf_parts   for parts .
      309     define buffer buf_trn-doc for trn-doc .
      310     define buffer buf_goods   for goods .
      311     def shared var sort-gr      as logical no-undo.
      312     def shared var sort-name    as logical no-undo.
      313     def var v-single-line       as char    no-undo.
      314     def var sym1  as char init ":"   no-undo.
      315     def var sym2  as char init ":"   no-undo.
      316     def var sym3  as char init ":"   no-undo.
      317     def var sym4  as char init ":"   no-undo.
      318     def var sym5  as char init ":"   no-undo.
      319     def var sym6  as char init ":"   no-undo.
      320     def var sym7  as char init ":"   no-undo.
      321     def var sym8  as char init ":"   no-undo.
      322     def var sym9  as char init ":"   no-undo.
      323     def var sym10 as char init ":"   no-undo.
      324     define variable all-qnty as decimal   no-undo .
      325     define variable all-sum  as decimal   no-undo .
      326     define variable s-isp    as character no-undo .
      327     DEFINE temp-table gds-prop no-undo
      328       field   artic            as  char
      329       field   prod-type        as  char
      330       field   prod-code        as  integer
      331       field   cli-type         as  char
      332       field   cli-code         as  integer
      333       field   part-code        like parts.part-code
      334       field   in-code          like parts.in-code
      335       field   gds-code         as  integer
      336       field   gds-name         as  char
      337       field   grp-name         as  char
      338       field   b-code           as  integer
      339       field   qnty             as  decimal
      340       field   zen              as  decimal
      341       field   sum              as  decimal
      342       INDEX pi  IS PRIMARY   artic  prod-type prod-code
      343       INDEX pi1              gds-name
      344       INDEX pi2              grp-name
      345       INDEX pi3              cli-type cli-code
      346    .
      347     def var v-doc-num          like trn-doc.doc-code    no-undo.
      348     def var v-doc-date         like trn-doc.doc-date    no-undo.
      349     find first buf_trn-doc no-lock  where recid(buf_trn-doc) = rec_id .
      350     assign
      351       v-doc-num  = buf_trn-doc.doc-code
      352       v-doc-date = buf_trn-doc.doc-date
      353     .
      354     for each parts-root no-lock where parts-root.doc-code = buf_trn-doc.doc-code :
      355       create gds-prop .
      356       find first buf_goods where buf_goods.gds-code = parts-root.gds-code no-lock .
      357       find first buf_parts no-lock
      358         where buf_parts.artic     = buf_goods.artic
      359           and buf_parts.prod-code = buf_goods.prod-code
      360           and buf_parts.prod-type = buf_goods.prod-type
      361           and buf_parts.part-code = parts-root.part-code
      362           and buf_parts.in-code   = parts-root.in-code
      363           and buf_parts.out-code  = buf_trn-doc.doc-code
      364           and buf_parts.obj-code  = buf_trn-doc.obj-code
      365           and buf_parts.obj-type  = buf_trn-doc.obj-type
      366         no-error .
      367       if PrintRubl then assign gds-prop.zen = buf_parts.price-rubl .
      368       else              assign gds-prop.zen = buf_parts.price-base .
      369   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      370     (input  buf_goods.gds-code
      371     ,input  ?
      372     ,output gds-prop.b-code
      373     ) no-error .
      374       if error-status :error then do:
      375         message vss-workfile vss-revision vss-description skip "Ошибка при определении бар-кода товара" skip  "Код товара" buf_goods.gds-code skip
      376         view-as alert-box error .
      377       end.
      378       assign
      379         gds-prop.artic     = buf_goods.artic
      380         gds-prop.prod-type = buf_goods.prod-type
      381         gds-prop.prod-code = buf_goods.prod-code
      382         gds-prop.gds-code  = buf_goods.gds-code
      383         gds-prop.gds-name  = buf_goods.gds-name
      384         gds-prop.grp-name  = buf_goods.grp-name
      385         gds-prop.part-code = parts-root.part-code
      386         gds-prop.in-code   = parts-root.in-code
      387         gds-prop.cli-type  = buf_parts.supp-type
      388         gds-prop.cli-code  = buf_parts.supp-code
      389         gds-prop.qnty      = buf_parts.fact-qnty
      390         gds-prop.sum       = buf_parts.fact-qnty * gds-prop.zen
      391       .
      392     end.
      393     def stream out-stream .
      394     define frame f-doc1
      395           sym1              column-label ":"                       format "X(1)"
      396           gds-prop.b-code   column-label "Код"                     format ">>>>>>>>>>>>9"
      397           sym2              column-label ":"                       format "X(1)"
      398           gds-prop.artic    column-label "Артикул"                 format "X(16)"
      399           sym3              column-label ":"                       format "X(1)"
      400           gds-prop.gds-name column-label "Название товара"         format "X(41)"
      401           sym4              column-label ":"                       format "X(1)"
      402           gds-prop.qnty     column-label "Количество"              format "->>>>>>>>9.<<"
      403           sym5              column-label ":"                       format "X(1)"
      404           gds-prop.zen      column-label "Цена (РУБ)"              format "->>>>>>>9.99"
      405           sym6              column-label ":"                       format "X(1)"
      406           gds-prop.sum      column-label "Сумма  (РУБ)"            format "->>>>>>>>>>>9.99"
      407           sym7              column-label ":"                       format "X(1)"
      408       header
      409           cur-time-print() at 5 format "X(35)"
      410           string( "Акт смены типа приобретения" ) at 50 format "X(30)" v-doc-num format "X(10)" " от " v-doc-date format "99/99/9999"
      411           string( "Страница " + string( PAGE-NUMBER( out-stream ), ">>9" ) ) at 110 format "X(13)" skip
      412           v-single-line format "X(128)" at 1
      413       with width 235 down stream-io use-text .
      414     define frame f-doc2
      415           sym1              column-label ":"                         format "X(1)"
      416           gds-prop.b-code   column-label "Код"                       format ">>>>>>>>>>>>9"
      417           sym2              column-label ":"                         format "X(1)"
      418           gds-prop.artic    column-label "Артикул"                   format "X(16)"
      419           sym3              column-label ":"                         format "X(1)"
      420           gds-prop.gds-name column-label "Название товара"           format "X(41)"
      421           sym4              column-label ":"                         format "X(1)"
      422           gds-prop.qnty     column-label "Количество"                format "->>>>>>>>9.<<"
      423           sym5              column-label ":"                         format "X(1)"
      424           gds-prop.zen      column-label "цена (Б.Вал)"              format "->>>>>>>9.99"
      425           sym6              column-label ":"                         format "X(1)"
      426           gds-prop.sum      column-label "Сумма (Б.Вал)"             format "->>>>>>>>>>>9.99"
      427           sym7              column-label ":"                         format "X(1)"
      428       header
      429           cur-time-print() at 5 format "X(35)"
      430           string( "Акт смены типа приобретения" ) at 50 format "X(30)" v-doc-num format "X(10)" " от " v-doc-date format "99/99/9999"
      431           string( "Страница " + string( PAGE-NUMBER( out-stream ), ">>9" ) ) at 110 format "X(13)" skip
      432           v-single-line format "X(128)" at 1
      433       with width 235 down stream-io use-text .
      434   if session :set-wait-state( "compiler" ) then.
      435     assign   v-single-line = fill("-", 140) .
      436   output stream out-stream to value( string( session:temp-directory +
      437                                        "rpt" + string( g#report-num ) ) )
      438                                        page-size  value(62) .
      439     find first  buf_clients no-lock where buf_clients.obj-type = 'орг':U  and buf_clients.obj-code = buf_trn-doc.host-code .
      440     put stream out-stream space(50) buf_clients.obj-name format "x(70)" skip(2) .
      441     put stream out-stream space(25) string( "А К Т  смены типа приобретения  N "
      442       + v-doc-num + " от " + string(v-doc-date,"99/99/9999") )    format "x(128)"    skip(1)
      443     .
      444     form header v-single-line format "X(128)" at 1 skip  "Продолжение - на следующей странице" at 30 skip
      445     with frame Bottomframe width 235 page-bottom no-labels no-box .
      446     view stream out-stream frame bottomframe .
      447     if PrintRubl then form with frame f-doc1 .
      448     else              form with frame f-doc2 .
      449     if sort-gr then do:
      450       if sort-name then do:
      451         for each gds-prop break by gds-prop.cli-type by gds-prop.cli-code by gds-prop.grp-name by gds-prop.gds-name :
      452           if  first-of( gds-prop.cli-code) then do:
      453             run print-prod in this-procedure .
      454           end.
      455           if  first-of( gds-prop.grp-name) then do:
      456             run print-grp in this-procedure .
      457           end.
      458           run print-line in this-procedure .
      459         end.
      460       end.
      461       else do:
      462         for each gds-prop break by gds-prop.cli-type by gds-prop.cli-code by gds-prop.grp-name by gds-prop.artic :
      463           if  first-of( gds-prop.cli-code) then do:
      464             run print-prod in this-procedure .
      465           end.
      466           if  first-of( gds-prop.grp-name) then do:
      467             run print-grp in this-procedure .
      468           end.
      469           run print-line in this-procedure .
      470         end.
      471       end.
      472     end.
      473     else do:
      474       if sort-name then do:
      475         for each gds-prop break by gds-prop.cli-type by gds-prop.cli-code by gds-prop.gds-name :
      476           if  first-of( gds-prop.cli-code) then do:
      477             run print-prod in this-procedure .
      478           end.
      479           run print-line in this-procedure .
      480         end.
      481       end.
      482       else do:
      483         for each gds-prop break by gds-prop.cli-type by gds-prop.cli-code by gds-prop.artic  :
      484           if  first-of( gds-prop.cli-code) then do:
      485             run print-prod in this-procedure .
      486           end.
      487           run print-line in this-procedure .
      488         end.
      489       end.
      490     end.
      491     put stream out-stream v-single-line format "X(128)" skip .
      492     if PrintRubl then do:
      493       display stream out-stream
      494         sym1   sym2   sym3   "ИТОГО:" @ gds-prop.gds-name
      495         sym4   all-qnty               @ gds-prop.qnty
      496         sym5   sym6   all-sum         @ gds-prop.sum
      497         sym7
      498       with frame f-doc1 .
      499       down stream out-stream with frame f-doc1 .
      500     end.
      501     else do:
      502       display stream out-stream
      503         sym1   sym2   sym3   "ИТОГО:" @ gds-prop.gds-name
      504         sym4   all-qnty               @ gds-prop.qnty
      505         sym5   sym6   all-sum         @ gds-prop.sum
      506         sym7
      507       with frame f-doc2 .
      508       down stream out-stream with frame f-doc2 .
      509     end.
      510     hide stream out-stream frame Bottomframe .
      511     if line-counter( out-stream ) + 6 > page-size( out-stream ) then  page stream out-stream .
      512     find first  buf_clients no-lock where buf_clients.obj-type = 'чел':U  and buf_clients.obj-code = buf_trn-doc.agnt no-error .
      513     if available buf_clients then assign s-isp = buf_clients.obj-name .
      514     else                          assign s-isp = "" .
      515     put stream out-stream v-single-line format "X(128)" skip(2)
      516                space(10) "Подписи сторон : "    format "X(60)" skip
      517                space(10) "Зав. складом/Зав. секцией : _____________________" format "X(70)"  "От поставщика : _____________________" format "X(70)" skip(2)
      518                space(20) "Исполнитель : " s-isp   skip
      519               .
      520     output stream out-stream close.
      521   if session :set-wait-state( "" ) then.
      522   if g#quest-print = false
      523   then do:
      524     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
      525                                         7, (if 0 >= 8 then 2 else 0), 0, 0,
      526                                         OUTPUT g#log ).
      527   end.
      528   else do:
      529     os-command silent
      530       value( "COPY /b " +
      531         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
      532         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
      533         string( session:temp-directory) +  "$" + string( g#report-num )
      534                 ) .
      535     os-command silent
      536       value( "COPY /b " +
      537         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
      538         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
      539         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
      540                 ) .
      541   end.
      542   end.
      543   procedure print-grp :
      544     do
      545     on error undo, return error return-value
      546     :
      547       if PrintRubl then do:
      548         display stream out-stream  sym1  gds-prop.grp-name @ gds-prop.gds-name  sym7  with frame f-doc1 .
      549         down stream out-stream with frame f-doc1 .
      550       end.
      551       else do:
      552         display stream out-stream  sym1  gds-prop.grp-name @ gds-prop.gds-name  sym7  with frame f-doc2 .
      553         down stream out-stream with frame f-doc2 .
      554       end.
      555     end.
      556   end procedure.
      557   procedure print-prod :
      558     do
      559     on error undo, return error return-value
      560     :
      561       find first buf_clients where buf_clients.obj-type = gds-prop.cli-type and buf_clients.obj-code = gds-prop.cli-code no-lock .
      562       if PrintRubl then do:
      563         display stream out-stream  sym1 "Поставщик:" @ gds-prop.artic sym2  buf_clients.obj-name @ gds-prop.gds-name  sym7  with frame f-doc1 .
      564         down stream out-stream with frame f-doc1 .
      565       end.
      566       else do:
      567         display stream out-stream  sym1 "Поставщик:" @ gds-prop.artic sym2    buf_clients.obj-name @ gds-prop.gds-name  sym7  with frame f-doc2 .
      568         down stream out-stream with frame f-doc2 .
      569       end.
      570     end.
      571   end procedure.
      572   procedure print-line :
      573     do
      574     on error undo, return error return-value
      575     :
      576       assign
      577         all-qnty = all-qnty + gds-prop.qnty
      578         all-sum  = all-sum  + gds-prop.sum
      579       .
      580       if PrintRubl then do:
      581         display stream out-stream
      582           sym1   gds-prop.b-code
      583           sym2   gds-prop.artic
      584           sym3   gds-prop.gds-name
      585           sym4   gds-prop.qnty
      586           sym5   gds-prop.zen
      587           sym6   gds-prop.sum
      588           sym7
      589         with frame f-doc1 .
      590         down stream out-stream with frame f-doc1 .
      591       end.
      592       else do:
      593         display stream out-stream
      594           sym1   gds-prop.b-code
      595           sym2   gds-prop.artic
      596           sym3   gds-prop.gds-name
      597           sym4   gds-prop.qnty
      598           sym5   gds-prop.zen
      599           sym6   gds-prop.sum
      600           sym7
      601         with frame f-doc2 .
      602         down stream out-stream with frame f-doc2 .
      603       end.
      604     end.
      605   end procedure.
