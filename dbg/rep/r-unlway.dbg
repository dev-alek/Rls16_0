      578   define variable var-report-r-b as character no-undo .
      579   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      580   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      581     (output var-report-r-b
      582     )  .
      583   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      584   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      585   define  shared variable RepPathName        as character no-undo .
      586   define  shared variable PrintRubl          as logical   no-undo .
      587   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      588   define variable v-waitfram-action01         as character   no-undo .
      589   define variable v-waitfram-action02         as character   no-undo .
      590   define variable v-waitfram-action03         as character   no-undo .
      591   define variable mWaitFramTextBeg            as character   no-undo.
      592   define variable mWaitFramTextEnd            as character   no-undo.
      593   define variable mWaitFramView               as logical     no-undo.
      594   define variable mWaitProcEvent              as logical     no-undo init yes.
      595   define variable mWaitFramInterval           as integer     no-undo init 1 .
      596   define variable mWaitFramStop               as logical     no-undo.
      597   define variable mWaitFramStopUser           as logical     no-undo.
      598   define variable mWaitFramStopTimeOut        as logical     no-undo.
      599   define variable mWaitFramStartProc          as datetime-tz no-undo.
      600   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      601   define button B-WaitFramStop auto-end-key
      602        label "Стоп"
      603        size 10 by 1 tooltip "Остоновить процесс".
      604   define button B-viewProcInfo
      605        label "Информация"
      606        size 15 by 1 tooltip "Информация о процесс".
      607   define frame waitfram
      608     v-waitfram-action01 format "x(72)" no-label skip
      609     v-waitfram-action02 format "x(72)" no-label skip
      610     v-waitfram-action03 format "x(72)" no-label skip
      611     B-viewProcInfo
      612     B-WaitFramStop at row 4 col 30
      613     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      614     .
      615   define new global shared variable mBatchMode as logical no-undo init ?.
      616   define variable mFramBachModHandle as handle no-undo.
      617   mFramBachModHandle = frame waitfram:handle.
      618   define variable mFameOldVis as logical no-undo.
      619   define variable mVisCUrentVin as logical no-undo.
      620   if session:batch-mode
      621   then
      622      mBatchMode = yes.
      623   if mBatchMode = ? then do:
      624     mVisCUrentVin = current-window:visible.
      625     mFameOldVis = mFramBachModHandle:visible.
      626     mFramBachModHandle:visible  = yes.
      627     mBatchMode = mFramBachModHandle:visible ne yes.
      628     mFramBachModHandle:visible = mFameOldVis.
      629     current-window:visible = mVisCUrentVin.
      630   end.
      631    if  log-manager:logfile-name ne ?
      632     then DO:
      633         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      634         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      635         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      636     end.
      637   on choose of B-WaitFramStop in frame waitfram
      638   do:
      639     mWaitFramStop = yes.
      640     mWaitFramStopUser = yes.
      641   end.
      642   function waitfram-check-timeout returns logical():
      643      define variable vtime as int64 no-undo.
      644      if mWaitFramStopTimeOut
      645      then
      646         return yes.
      647      vtime = ( now - mWaitFramStartProc ) / 1000 .
      648      if     mWaitFramTimeOut ne ?
      649         and mWaitFramTimeOut ne 0
      650         and mWaitFramTimeOut lt vtime
      651      then do:
      652         mWaitFramStopTimeOut = yes.
      653      end.
      654      return mWaitFramStopTimeOut.
      655   end.
      656   procedure waitfram-hide :
      657     if not session:batch-mode
      658     then do
      659     on error undo, return error return-value
      660     :
      661       pause 0 before-hide .
      662       if not mBatchMode then
      663         hide frame waitfram .
      664     if     not mWaitFramView
      665        and mWaitProcEvent
      666     then
      667       process events .
      668     end.
      669   end procedure.
      670   procedure waitfram-show :
      671     define input  parameter p-message as character no-undo .
      672     define variable v-left-margin as integer   no-undo .
      673     if not session:batch-mode
      674     then do
      675     on error undo, return error return-value
      676     :
      677       if length(p-message) <= 70 then do:
      678         assign
      679           v-left-margin = integer((70 - length(p-message)) / 2)
      680         .
      681         assign
      682           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      683         .
      684         assign
      685           v-waitfram-action01 = " "
      686           v-waitfram-action02 = " "
      687                                    + fill(" ", v-left-margin)
      688                                    + p-message
      689           v-waitfram-action03 = " "
      690         .
      691       end.
      692       else do:
      693         define variable vRindex1 as integer no-undo.
      694         define variable vRindex2 as integer no-undo.
      695         vRindex1 = r-index(p-message," ",70).
      696         if vRindex1 = 0
      697         then
      698            vRindex1 = 70.
      699         if length(p-message)  <= vRindex1 + 70 then do:
      700           assign
      701             v-waitfram-action01 = " "
      702             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      703             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      704           .
      705         end.
      706         else do:
      707           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      708           if vRindex2 <= vRindex1
      709           then
      710              vRindex2 = vRindex1 + 70.
      711           assign
      712             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      713             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      714             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      715           .
      716         end.
      717       end.
      718       B-viewProcInfo:visible   in frame waitfram = no.
      719       B-viewProcInfo:sensitive in frame waitfram = no.
      720       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      721       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      722       if  (   mWaitFramView
      723          or  mWaitProcEvent)
      724          and not mBatchMode
      725       then
      726          display
      727             v-waitfram-action01 skip
      728             v-waitfram-action02 skip
      729             v-waitfram-action03 skip
      730          with frame waitfram .
      731       if     mWaitFramView
      732          then do:
      733             if     mWaitFramInterval ne ?
      734                and not mBatchMode
      735             then
      736                wait-for go of frame waitfram pause mWaitFramInterval.
      737          end.
      738          else
      739             if     mWaitProcEvent
      740                and not mBatchMode
      741             then
      742                process events .
      743     end.
      744   end procedure.
      745      procedure waitfram-show-this:
      746         define input  parameter iInterval as int64 no-undo.
      747         define variable vtime as int64 no-undo.
      748         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      749         mWaitFramInterval = iInterval.
      750         run waitfram-show (substitute("&1&2 &3&4" ,
      751                                       mWaitFramTextBeg ,
      752                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      753                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      754                                       mWaitFramTextEnd
      755                                      )
      756                           ).
      757      end.
      758      procedure WaitFramRunPause:
      759         define input  parameter iInterval as dec no-undo.
      760         define variable vStart  as datetime-tz no-undo.
      761         define variable vend    as datetime-tz no-undo.
      762         define variable vint as int64 no-undo.
      763         define variable vOk as logical no-undo.
      764         vStart = now.
      765         vend   = vStart.
      766         publish "WaitFramPause" (iInterval,output vOk).
      767         vend   =  now.
      768         vint = vend - vStart.
      769         vint = iInterval - vint / 1000.
      770         if     not mWaitFramStop
      771            and (   vint > 0
      772                 or (    not vOk
      773                     and iInterval eq ?
      774                     )
      775                 )
      776         then
      777            run waitfram-show-this (iInterval).
      778         vend   =  now.
      779         vint = vend - vStart.
      780         vint = iInterval - vint / 1000.
      781         if     not mWaitFramStop
      782            and vint > 0
      783         then do:
      784            run gbl/pause.p (vint * 1000).
      785         end.
      786         if iInterval ne ?
      787         then
      788            publish "WaitFramStop".
      789         waitfram-check-timeout().
      790      end.
      791      procedure WaitFramWaitFor:
      792         define input  parameter iInterval as dec no-undo.
      793         assign
      794            mWaitFramStartProc   = now
      795            mWaitFramStopUser    = no
      796            mWaitFramStopTimeOut = no
      797         .
      798         block-wait:
      799         do while not mWaitFramStop:
      800            run WaitFramRunPause (iInterval).
      801            if  waitfram-check-timeout()
      802            then do:
      803               leave block-wait.
      804            end.
      805         end.
      806         run waitfram-hide.
      807      end.
      808   procedure waitfram-join :
      809     define input  parameter p-line-1  as character no-undo .
      810     define input  parameter p-line-2  as character no-undo .
      811     define input  parameter p-line-3  as character no-undo .
      812     define output parameter p-message as character no-undo .
      813     do
      814     on error undo, return error return-value
      815     :
      816       assign
      817         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      818                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      819                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      820       .
      821     end.
      822   end procedure.
      823   function waitfram-join-function returns character
      824     (input p-line-1 as character
      825     ,input p-line-2 as character
      826     ,input p-line-3 as character
      827     ).
      828     define variable v-message as character no-undo .
      829     run waitfram-join in this-procedure
      830       (input  p-line-1
      831       ,input  p-line-2
      832       ,input  p-line-3
      833       ,output v-message
      834       ) .
      835     return v-message .
      836   end function .
      837   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      838   procedure cur-time :
      839      define output parameter p-today as date      no-undo .
      840      define output parameter p-time  as integer   no-undo .
      841     do
      842     on error undo, return error
      843     :
      844       define variable v-date1 as date      no-undo .
      845       define variable v-date2 as date      no-undo .
      846       define variable v-time  as integer   no-undo .
      847       assign
      848         v-date1 = today
      849         v-time  = time
      850         v-date2 = today
      851       .
      852       if v-date1 <> v-date2
      853       then do:
      854         assign
      855           v-date1 = today
      856           v-time  = v-time
      857         .
      858       end.
      859       assign
      860         p-today = v-date1
      861         p-time  = v-time
      862       .
      863     end.
      864   end.
      865   function cur-time-date returns character
      866   :
      867     return string(today, '99/99/9999':U) .
      868   end.
      869   function cur-time-mjd returns decimal
      870   :
      871     define variable v-date as date      no-undo .
      872     define variable v-time as integer   no-undo .
      873     run cur-time in this-procedure
      874       (output v-date
      875       ,output v-time
      876       ) .
      877     return integer(v-date) - 2400002 + (v-time / 86400) .
      878   end.
      879   function cur-time-get-ending-index returns integer
      880   (input p-number as integer
      881   )
      882   :
      883     if p-number < 0
      884     or p-number = ?
      885     then do:
      886       return 1 .
      887     end.
      888     define variable v-rest as integer   no-undo .
      889     assign
      890       p-number = p-number modulo 100
      891     .
      892     if p-number < 20
      893     then do:
      894       assign
      895         v-rest = p-number
      896       .
      897     end.
      898     else do:
      899       assign
      900         v-rest = p-number modulo 10
      901       .
      902     end.
      903     case v-rest :
      904       when 1
      905       then do:
      906         return 2 .
      907       end.
      908       when 2 or
      909       when 3 or
      910       when 4
      911       then do:
      912         return 3 .
      913       end.
      914       otherwise do:
      915         return 1 .
      916       end.
      917     end case .
      918   end.
      919   procedure cur-time-mjd-to-date :
      920      define input  parameter i-mjd-diff as decimal no-undo.
      921      define output parameter o-Date     as date    no-undo.
      922      define output parameter o-Time     as integer no-undo.
      923      define variable v-day-number as integer   no-undo .
      924      if    i-mjd-diff < 0
      925         or i-mjd-diff = ?
      926      then do:
      927         return "?" .
      928      end.
      929      assign
      930         v-day-number = truncate(i-mjd-diff,0).
      931         o-Date = date(v-day-number + 2400002).
      932         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      933     .
      934   end.
      935   function cur-time-mjd-to-string returns character
      936   (input p-mjd-diff as decimal
      937   )
      938   :
      939     define variable v-day-number as integer   no-undo .
      940     define variable v-seconds    as integer   no-undo .
      941     define variable v-hour       as integer   no-undo .
      942     define variable v-min        as integer   no-undo .
      943     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      944     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      945     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      946     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      947     if p-mjd-diff < 0
      948     or p-mjd-diff = ?
      949     then do:
      950       return "?" .
      951     end.
      952     assign
      953       v-day-number = integer(truncate(p-mjd-diff,0))
      954       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      955     .
      956     if v-seconds > 86400
      957     then do:
      958       assign
      959         v-seconds = 86400 - 1
      960       .
      961     end.
      962     if v-seconds < 0
      963     then do:
      964       assign
      965         v-seconds = 0
      966       .
      967     end.
      968     assign
      969       v-hour = truncate(v-seconds / 3600, 0)
      970     .
      971     assign
      972       v-seconds = v-seconds modulo 3600
      973     .
      974     assign
      975       v-min = truncate(v-seconds / 60, 0)
      976     .
      977     assign
      978       v-seconds = v-seconds modulo 60
      979     .
      980     return
      981         (if v-day-number <> 0
      982           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      983           else ""
      984         )
      985       + (if v-day-number <> 0 or v-hour <> 0
      986           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      987           else ""
      988         )
      989       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      990           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      991           else ""
      992         )
      993       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      994       .
      995   end.
      996   function cur-time-string returns character
      997   :
      998     define variable v-date as date      no-undo .
      999     define variable v-time as integer   no-undo .
     1000     run cur-time in this-procedure
     1001       (output v-date
     1002       ,output v-time
     1003       ) .
     1004     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1005   end.
     1006   function cur-time-string-sec returns character
     1007   :
     1008     define variable v-date as date      no-undo .
     1009     define variable v-time as integer   no-undo .
     1010     run cur-time in this-procedure
     1011       (output v-date
     1012       ,output v-time
     1013       ) .
     1014     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1015   end.
     1016   function cur-time-custom  returns character
     1017   (input p-prefix as character
     1018   ,input p-date-format as character
     1019   ,input p-delimiter as character
     1020   ,input p-time-format as character
     1021   ,input p-suffix as character
     1022   )
     1023   :
     1024     define variable v-date as date      no-undo .
     1025     define variable v-time as integer   no-undo .
     1026     run cur-time in this-procedure
     1027       (output v-date
     1028       ,output v-time
     1029       ) .
     1030     return
     1031       p-prefix
     1032       + string(v-date, p-date-format)
     1033       + p-delimiter
     1034       + string(v-time, p-time-format)
     1035       + p-suffix
     1036       .
     1037   end.
     1038   function cur-time-print  returns character
     1039   :
     1040     define variable v-date as date      no-undo .
     1041     define variable v-time as integer   no-undo .
     1042     run cur-time in this-procedure
     1043       (output v-date
     1044       ,output v-time
     1045       ) .
     1046     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1047   end.
     1048   function cur-time-datetime returns datetime
     1049   :
     1050     define variable v-char as character no-undo .
     1051     define variable v-datetime as datetime no-undo .
     1052     v-char = cur-time-string().
     1053     v-datetime = datetime(v-char).
     1054     return  v-datetime.
