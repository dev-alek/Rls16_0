     1613           vat-rubl-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-rubl-saleprl) * varvat-pc / (100 + varvat-pc).
     1614   end.
     1615   else do:
     1616     if vardoc-type = 'инв':U then do:
     1617       assign
     1618               vat-base-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else (((varprice-base - vardiscnt-base) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-base-saleprl - varprice-base-consprl) * varcons-vat-pc / (100 + varcons-vat-pc) * vardoc-qnty * varcons-qntyprl / varfact-qntyprl + ((varprice-base - vardiscnt-base) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-base-saleprl) * varvat-pc / (100 + varvat-pc) * vardoc-qnty * (varfact-qntyprl - varcons-qntyprl) / varfact-qntyprl) / varfact-qntyprl)
     1619               vat-rubl-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else (((varprice-rubl - vardiscnt-rubl) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-rubl-saleprl - varprice-rubl-consprl) * varcons-vat-pc / (100 + varcons-vat-pc) * vardoc-qnty * varcons-qntyprl / varfact-qntyprl + ((varprice-rubl - vardiscnt-rubl) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-rubl-saleprl) * varvat-pc / (100 + varvat-pc) * vardoc-qnty * (varfact-qntyprl - varcons-qntyprl) / varfact-qntyprl) / varfact-qntyprl)
     1620        .
     1621     end.
     1622     else do:
     1623       assign
     1624               vat-base-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else (((varprice-base - vardiscnt-base) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-base-saleprl - varprice-base-consprl) * varcons-vat-pc / (100 + varcons-vat-pc) * varfact-qnty * varcons-qntyprl / varfact-qntyprl + ((varprice-base - vardiscnt-base) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - varprice-base-consprl) * varvat-pc / (100 + varvat-pc) * varfact-qnty * (varfact-qntyprl - varcons-qntyprl) / varfact-qntyprl) / varfact-qntyprl)
     1625               vat-rubl-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else (((varprice-rubl - vardiscnt-rubl) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-rubl-saleprl - varprice-rubl-consprl) * varcons-vat-pc / (100 + varcons-vat-pc) * varfact-qnty * varcons-qntyprl / varfact-qntyprl + ((varprice-rubl - vardiscnt-rubl) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - varprice-rubl-consprl) * varvat-pc / (100 + varvat-pc) * varfact-qnty * (varfact-qntyprl - varcons-qntyprl) / varfact-qntyprl) / varfact-qntyprl)
     1626        .
     1627     end.
     1628   end.
     1629   assign
     1630   price-base-without-tax-saleprl = price-base-with-tax-saleprl - vat-base-saleprl - slt-base-saleprl - road-tax-base-saleprl
     1631   price-rubl-without-tax-saleprl = price-rubl-with-tax-saleprl - vat-rubl-saleprl - slt-rubl-saleprl - road-tax-rubl-saleprl.
     1632     end.
     1633   end procedure.
     1634   procedure proc-cur-rate :
     1635     do
     1636     on error undo, return error return-value
     1637     :
     1638   define input  parameter p-obj-type as character no-undo .
     1639   define input  parameter p-obj-code as integer   no-undo .
     1640   define output parameter Rubl_Coeff as decimal   no-undo .
     1641   define variable v-base-code like ub.sysconf.base-code no-undo .
     1642   define variable v-host-code like ub.sysconf.host-code no-undo .
     1643   DEFINE VARIABLE v-today as date no-undo .
     1644   DEFINE VARIABLE v-time as integer no-undo .
     1645   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1646   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1647     (input  p-obj-type
     1648     ,input  p-obj-code
     1649     ,output v-host-code
     1650     )  .
     1651   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1652   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1653     (input  v-host-code
     1654     ,output v-base-code
     1655     )  .
     1656   run cur-time in this-procedure ( output v-today, output v-time).
     1657           FIND LAST ub.curr-accnt WHERE ub.curr-accnt.curr-code = v-base-code
     1658                                                    AND ub.curr-accnt.exch-date <= v-today
     1659                                                    NO-LOCK NO-ERROR .
     1660           FIND LAST ub.curr-shop WHERE ub.curr-shop.curr-code = v-base-code
     1661                                                    AND ub.curr-shop.obj-code = p-obj-code
     1662                                                    AND ub.curr-shop.obj-type = p-obj-type
     1663                                                    USE-INDEX pi NO-LOCK NO-ERROR .
     1664           if p-obj-type = 'маг':U then
     1665               do:
     1666                   if not available ub.curr-shop then
     1667                       do:
     1668                           bell.
     1669                           message "Нет ни одного МАГАЗИННОГО курса базовой валюты к рублям.".
     1670                           Rubl_Coeff = 1.
     1671                       end.
     1672                   else
     1673                       Rubl_Coeff = ub.curr-shop.exch-rate / ub.curr-shop.exch-scale.
     1674               end.
     1675           else
     1676               do:
     1677                   if not available ub.curr-accnt then
     1678                       do:
     1679                           bell.
     1680                           message "Нет ни одного курса ММВБ базовой валюты к рублям.".
     1681                           return.
     1682                       end.
     1683                   else
     1684                       Rubl_Coeff = ub.curr-accnt.exch-rate / ub.curr-accnt.exch-scale.
     1685               end.
     1686     end.
     1687   end procedure.
     1688   define shared variable CostPrice as logical no-undo.
     1689   define variable g#report-num     as integer no-undo.
     1690   define variable Rubl_Coeff       as decimal  no-undo.
     1691   run get-report-num in p-parent-proc (output g#report-num).
     1692   procedure OpenForExcel :
     1693      define variable v-ch#ExcelApplication as com-handle no-undo .
     1694      define variable v-ch#Workbook         as com-handle no-undo .
     1695      define variable v-ch#Worksheet        as com-handle no-undo .
     1696      os-delete value( string( session:temp-directory ) +
     1697                                 "rpt" + string( g#report-num ) + ".txt":U ) .
     1698      os-delete value( string( session:temp-directory ) +
     1699                                 "rpt" + string( g#report-num ) + ".frm":U ) .
     1700      os-delete value( string( session:temp-directory ) +
     1701                                 "rpt" + string( g#report-num ) + ".txl":U ) .
     1702      if Make-Excel
     1703      then do:
     1704         output stream ForExcel to value( string( session:temp-directory +
     1705                                        "rpt" + string( g#report-num ) + ".txt":U ) ) .
     1706         assign
     1707            v-excel-file = string( session:temp-directory + "rpt" + string( g#report-num ) )
     1708            number-list = 1
     1709         .
     1710         if make-excel-com
     1711         then do:
     1712   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1713   if valid-handle(ch#WorkSheet) then
     1714   RELEASE OBJECT ch#WorkSheet no-error.
     1715   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1716   if valid-handle(ch#Workbook) then
     1717   RELEASE OBJECT ch#Workbook no-error.
     1718   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1719   if valid-handle(ch#ExcelApplication) then
     1720   RELEASE OBJECT ch#ExcelApplication no-error.
     1721            create "Excel.Application" ch#excelApplication connect no-error.
     1722            if error-status:error
     1723            then do :
     1724           create "Excel.Application" ch#excelApplication no-error.
     1725       if error-status :error then do:
     1726           message
     1727           "Ошибка при запуске Excel" skip
     1728           error-status :get-message(1) skip
     1729           view-as alert-box error .
     1730           undo, return error .
     1731       end.
     1732            end.
     1733            assign
     1734               num#str#  = 0.
     1735               v-ch#excelApplication  = ch#excelApplication.
     1736               v-ch#excelApplication:Interactive = false.
     1737               v-ch#excelApplication:ScreenUpdating = false.
     1738               v-ch#excelApplication:Visible = false.
     1739               ch#Workbook  = v-ch#excelApplication:Workbooks:add ().
     1740               ch#WorkSheet = v-ch#excelApplication:Sheets:Item (1).
     1741               v-ch#Worksheet = ch#WorkSheet.
     1742               v-ch#Worksheet:Range ("A1"):Font:Bold = true.
     1743               v-ch#Worksheet:Range ("A1"):Font:Size = 14.
     1744               v-ch#Worksheet:Range ("A1"):HorizontalAlignment = -4131.
     1745               v-ch#Worksheet:Range ("A1"):VerticalAlignment   = -4160
     1746            no-error .
     1747            if error-status:error
     1748            then do:
     1749               Make-Excel-com = false .
     1750               Make-Excel = false .
     1751               output Stream  ForExcel close.
     1752               os-delete value( string( session:temp-directory ) +
     1753                              "rpt" + string( g#report-num ) + ".txt":U ) .
     1754               os-delete value( string( session:temp-directory ) +
     1755                              "rpt" + string( g#report-num ) + ".frm":U ) .
     1756               return.
     1757            end.
     1758         end.
     1759      end.
     1760   end.
     1761   procedure CloseForExcel :
     1762      define variable ii as integer no-undo .
     1763      define variable vsheet-num as integer no-undo.
     1764      if Make-Excel
     1765      then  do:
     1766         output Stream  ForExcel close.
     1767         os-delete value( string( session:temp-directory ) +
     1768                                "rpt" + string( g#report-num ) + ".txt":U ) .
     1769         os-delete value( string( session:temp-directory ) +
     1770                                "rpt" + string( g#report-num ) + ".frm":U ) .
     1771         define buffer buf_sheetf for sheetf.
     1772         find last buf_sheetf no-error .
     1773         if available buf_sheetf
     1774         then
     1775            vsheet-num = buf_sheetf.sheet-num.
     1776         if vsheet-num > 1
     1777         then do:
     1778            do ii = 2 to vsheet-num:
     1779               os-delete value( string( session:temp-directory ) +
     1780                                     "rpt" + string( g#report-num ) + ".":U  + string(ii)) .
     1781            end.
     1782         end.
     1783   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1784   if valid-handle(ch#WorkSheet) then
     1785   RELEASE OBJECT ch#WorkSheet no-error.
     1786   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1787   if valid-handle(ch#Workbook) then
     1788   RELEASE OBJECT ch#Workbook no-error.
     1789   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1790   if valid-handle(ch#ExcelApplication) then
     1791   RELEASE OBJECT ch#ExcelApplication no-error.
     1792      end.
     1793   end.
     1794   define buffer buf_doc  for ub.trn-doc.
     1795   Main-Block:
     1796   do on error   undo Main-Block, leave Main-Block
     1797      on end-key undo Main-Block, leave Main-Block :
     1798     find buf_doc no-lock where recid( buf_doc ) = p-rec-id no-error.
     1799     if not available buf_doc then do:
     1800       message "Накладная не найдена!" view-as alert-box error.
     1801       undo Main-Block, leave Main-Block.
     1802     end.
     1803     run WaitFram-Show in this-procedure ( input "Ждите..." ).
     1804     if session :SET-WAIT-STATE( "COMPILER" ) then do: end.
     1805     Make-Excel = true.
     1806     run openforexcel in this-procedure .
     1807     run print-header in this-procedure .
     1808       run print-line-dtl in this-procedure (  input p-rec-id )
     1809                                               no-error .
     1810       if error-status :error then do: undo Main-Block, leave Main-Block. end.
     1811       if error-status :error then do: undo Main-Block, leave Main-Block. end.
     1812     if Make-Excel then output stream ForExcel close.
     1813     if session :SET-WAIT-STATE( "":U       ) then do: end.
     1814   if session :set-wait-state( "" ) then.
     1815     run rep/runexcel.p (string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txt") .
     1816     os-delete value( string( session:temp-directory ) +
     1817                               "rpt" + string( g#report-num ) + ".txt":u ) .
     1818     run WaitFram-Hide in this-procedure.
     1819   end.
     1820   run WaitFram-Hide in this-procedure.
     1821   procedure print-header :
     1822     find first sheetf where sheet-num = 1 .
     1823     assign
     1824       sheetf.MergeCellsH = ""
     1825       Sheetf.MergeCellsV = ""
     1826       Sheetf.Excel-Column-Lable = "Артикул-цвет-размер" + chr(44) +
     1827                                   "Наименование"        + chr(44) +
     1828                                   "Цена розничная"      + chr(44) +
     1829                                   "Количество"          + chr(44) +
     1830                                   "Цена за ед."         + chr(44) +
     1831                                   "Стоимость"           + chr(44) +
     1832                                   "Штрих коды"
     1833       Sheetf.Sizes = "21,42,15,11,11,11,15"
     1834       Sheetf.colformat = "1=@;2=@;3=0,00;4=0,00;5=0,00;6=0,00;7=0;"
     1835     .
     1836     assign
     1837       str1 = ""
     1838       str2 = ""
     1839       str3 = ""
     1840       str4 = ""
     1841       ReportHeader = ""
     1842     .
     1843     run rep/extitle.p (1).
     1844   end.
     1845   procedure print-line-dtl :
     1846   define input parameter p-doc-recid as recid  no-undo.
     1847   define variable v-article     as character no-undo .
     1848   define variable v-wealth-name as character no-undo .
     1849   define variable v-cost-mpl    as decimal   no-undo .
     1850   define variable v-fact-qnty   as decimal   no-undo .
     1851   define variable v-cost        as decimal   no-undo .
     1852   define variable v-sum         as decimal   no-undo .
     1853   define variable v-b-code      as integer   no-undo .
     1854   define variable v-b-str       as character no-undo .
     1855   define variable v-prt-name    as character no-undo.
     1856   define variable v-doc-num     like ub.price-doc.doc-num     no-undo .
     1857   define variable v-price-sale  like ub.bar-code.b-code       no-undo .
     1858   define variable v-road-tax    like ub.price-list.road-tax   no-undo .
     1859   define variable v-excise      like ub.price-list.excise     no-undo .
     1860   define variable v-node-code     like    gds-prt.upper-code  no-undo.
     1861       define buffer buf_trn-doc       for ub.trn-doc  .
     1862       define buffer buf_doc-line      for ub.doc-line .
     1863       define buffer buf_goods         for ub.goods    .
     1864       define buffer buf_prod-bc       for ub.prod-bc  .
     1865       define buffer buf_bar-code      for ub.bar-code .
     1866     do
     1867     for buf_trn-doc
     1868       , buf_doc-line
     1869     on error undo, return error
     1870     :
     1871       find buf_trn-doc no-lock where recid( buf_trn-doc ) = p-doc-recid .
     1872       for each buf_doc-line no-lock where
     1873              buf_trn-doc.doc-code = buf_doc-line.doc-code :
     1874       find first buf_goods no-lock
     1875         where buf_goods.prod-type = buf_doc-line.prod-type
     1876           and buf_goods.prod-code = buf_doc-line.prod-code
     1877           and buf_goods.artic = buf_doc-line.artic
     1878       .
     1879       assign
     1880         v-wealth-name = ( if available buf_goods then buf_goods.gds-name   else "":U )
     1881         v-article     = buf_doc-line.artic
     1882       .
     1883       for each gds-dtl no-lock
     1884       where gds-dtl.prod-type = buf_doc-line.prod-type
     1885         and gds-dtl.prod-code = buf_doc-line.prod-code
     1886         and gds-dtl.artic     = buf_doc-line.artic
     1887         and gds-dtl.doc-code  = buf_doc-line.doc-code
     1888       :
     1889       find first gds-prt no-lock
     1890             where gds-prt.node-code = gds-dtl.prt-code
     1891       .
     1892           if CostPrice = yes
     1893       then do:
     1894   assign
     1895     price-rubl-with-tax-loc = buf_doc-line.price-rubl
     1896     price-base-with-tax-loc = buf_doc-line.price-base
     1897   .
     1898   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1899   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1900     (output varinvprb
     1901     )  .
     1902      find first in-vatp_doc-attr no-lock
     1903       where in-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
     1904         and in-vatp_doc-attr.attr-code = 'envd':U
     1905       no-error .
     1906       if available in-vatp_doc-attr
     1907          then do:
     1908          assign
     1909            in-vatp-have-vat-slt = no.
     1910      end.
     1911      else do:
     1912        assign
     1913          in-vatp-have-vat-slt = yes.
     1914      end.
     1915      find first in-vatp-goods where in-vatp-goods.artic     = buf_doc-line.artic     and
     1916                                        in-vatp-goods.prod-type = buf_doc-line.prod-type and
     1917                                        in-vatp-goods.prod-code = buf_doc-line.prod-code no-lock.
     1918      if (not buf_trn-doc.internal and
     1919              buf_trn-doc.doc-type = 'при':U) or
     1920         in-vatp-goods.gds-type = 'у':U then do:
     1921         if varinvprb = "base":u then do:
     1922           assign
     1923             road-tax-base-loc = buf_doc-line.road-tax
     1924             road-tax-rubl-loc = buf_doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale.
     1925         end.
     1926         else do:
     1927           ASSIGN
     1928             road-tax-rubl-loc = buf_doc-line.road-tax
     1929             road-tax-base-loc = buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale.
     1930         end.
     1931         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     1932         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     1933         assign
     1934           road-tax-cli-loc = ?.
     1935         ASSIGN
     1936           transport-base-loc = (if buf_doc-line.transport-base = ? then 0 else buf_doc-line.transport-base)
     1937           transport-rubl-loc = (if buf_doc-line.transport-rubl = ? then 0 else buf_doc-line.transport-rubl)
     1938           transport-cli-loc  = 0
     1939           other-base-loc     = (if buf_doc-line.other-base     = ? then 0 else buf_doc-line.other-base)
     1940           other-rubl-loc     = (if buf_doc-line.other-rubl     = ? then 0 else buf_doc-line.other-rubl)
     1941           other-cli-loc      = 0
     1942           vat-pc-loc         = (if buf_doc-line.vat-pc         = ? then 0 else buf_doc-line.vat-pc)
     1943           slt-pc-loc         = (if buf_doc-line.slt-pc         = ? then 0 else buf_doc-line.slt-pc).
     1944                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1945               ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1946         assign
     1947           vat-cli-loc            = ?
     1948           slt-cli-loc            = ?
     1949           price-cli-with-tax-loc = ?.
     1950      end.
     1951      else do:
