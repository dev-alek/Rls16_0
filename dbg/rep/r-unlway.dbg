     2155             ASSIGN   slt-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     2156       ASSIGN   slt-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     2157     assign
     2158       exch-rate-cli-loco = (out-vatp_parts.price-rubl - transport-rubl-loco - other-rubl-loco - road-tax-rubl-loco - (if out-vatp_parts.vat-type <> 'в т. ч.':U then vat-rubl-loco else 0) - (if out-vatp_parts.slt-type <> 'в т. ч.':U then slt-rubl-loco else 0)) / out-vatp_parts.price-cli .
     2159     assign
     2160       slt-cli-loco        = slt-rubl-loco       / exch-rate-cli-loco
     2161       vat-cli-loco        = vat-rubl-loco       / exch-rate-cli-loco
     2162       road-tax-cli-loco   = road-tax-rubl-loco  / exch-rate-cli-loco
     2163       transport-cli-loco  = 0
     2164       other-cli-loco      = 0
     2165     .
     2166   ASSIGN
     2167             price-base-without-tax-loco = price-base-with-tax-loco - vat-base-loco - slt-base-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))
     2168       price-rubl-without-tax-loco = price-rubl-with-tax-loco - vat-rubl-loco - slt-rubl-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))
     2169   .
     2170         assign
     2171           varprice-base-cons = varprice-base-cons + (price-base-with-tax-loco - (if road-tax-base-loco = ? then 0 else road-tax-base-loco))* out-vatp_parts.fact-qnty
     2172           varprice-rubl-cons = varprice-rubl-cons + (price-rubl-with-tax-loco - (if road-tax-rubl-loco = ? then 0 else road-tax-rubl-loco))* out-vatp_parts.fact-qnty.
     2173         assign
     2174           varis-cons-parts-have = yes
     2175           varcons-qnty          = varcons-qnty + out-vatp_parts.fact-qnty.
     2176       end.
     2177       assign
     2178         varfact-qnty = varfact-qnty + out-vatp_parts.fact-qnty.
     2179     end.
     2180   end.
     2181   assign
     2182     varprice-base-cons = varprice-base-cons / varcons-qnty
     2183     varprice-rubl-cons = varprice-rubl-cons / varcons-qnty.
     2184   if varprice-base-cons = ? then do:
     2185     assign
     2186       varprice-base-cons = 0.
     2187   end.
     2188   if varprice-rubl-cons = ? then do:
     2189     assign
     2190       varprice-rubl-cons = 0.
     2191   end.
     2192   assign
     2193       slt-base-sale               = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc)
     2194     vat-base-buyer              = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
     2195     discnt-base-sale            = gds-dtl.discnt-base
     2196     price-base-with-tax-sale    = (gds-dtl.price-base - gds-dtl.discnt-base)
     2197       slt-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc)
     2198     vat-rubl-buyer              = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
     2199     discnt-rubl-sale            = gds-dtl.discnt-rubl
     2200     price-rubl-with-tax-sale    = (gds-dtl.price-rubl - gds-dtl.discnt-rubl)
     2201     .
     2202   if buf_trn-doc.doc-type = 'инв':U then do:
     2203     assign
     2204       varfact-qnty = gds-dtl.doc-qnty.
     2205   end.
     2206   else do:
     2207     assign
     2208       varfact-qnty = gds-dtl.fact-qnty.
     2209   end.
     2210   if varis-cons-parts-have = no then do:
     2211     assign
     2212           vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
     2213           vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc).
     2214   end.
     2215   else do:
     2216     if buf_trn-doc.doc-type = 'инв':U then do:
     2217       assign
     2218               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     2219               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     2220        .
     2221     end.
     2222     else do:
     2223       assign
     2224               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-base-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     2225               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-rubl-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     2226        .
     2227     end.
     2228   end.
     2229   assign
     2230   price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     2231   price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     2232           assign
     2233               v-cost = ( if PrintRubl then price-rubl-with-tax-sale else price-base-with-tax-sale )
     2234           .
     2235       end.
     2236           find first buf_bar-code no-lock
     2237                 where buf_bar-code.gds-code  = buf_goods.gds-code
     2238                   and buf_bar-code.unit-cli  = buf_goods.unit-base
     2239                   and buf_bar-code.node-code = gds-dtl.prt-code
     2240                   and buf_bar-code.part-code = ""
     2241                   and buf_bar-code.in-code   = ""
     2242           .
     2243           find first buf_prod-bc no-lock
     2244                 where buf_prod-bc.b-code = buf_bar-code.b-code no-error
     2245           .
     2246           assign
     2247             v-b-code  = buf_bar-code.b-code
     2248             v-b-str = if available buf_prod-bc then buf_prod-bc.b-str else ""
     2249           .
     2250   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2251   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2252     (input  buf_trn-doc.obj-type
     2253     ,input  buf_trn-doc.obj-code
     2254     ,input  v-b-code
     2255     ,input  0
     2256     ,input  0
     2257     ,output v-doc-num
     2258     ,output v-price-sale
     2259     ,output v-road-tax
     2260     ,output v-excise
     2261     ) no-error .
     2262             if error-status :error then do:
     2263               message
     2264                 vss-workfile vss-revision vss-description skip
     2265                 "Ошибка при определении цены бар-кода" skip
     2266                 "Объект" buf_trn-doc.obj-type buf_trn-doc.obj-code skip
     2267                 "Бар-код" v-b-code skip
     2268                 error-status :get-message(1) skip
     2269                 return-value skip
     2270                 view-as alert-box error .
     2271             end.
     2272        run proc-cur-rate( input buf_trn-doc.obj-type, input buf_trn-doc.obj-code, output Rubl_Coeff ).
     2273           assign
     2274             v-prt-name = ""
     2275           v-fact-qnty = gds-dtl.fact-qnty
     2276           v-cost-mpl  = if PrintRubl then v-price-sale  else ( v-price-sale / Rubl_Coeff )
     2277           .
     2278           do while available gds-prt:
     2279               if available gds-prt
     2280             then do:
     2281               assign
     2282                   v-prt-name = "-" + string( gds-prt.node-name  ) + v-prt-name
     2283               .
     2284             end.
     2285               assign
     2286                   v-node-code = gds-prt.upper-code
     2287               .
     2288               find first gds-prt no-lock
     2289                     where gds-prt.node-code = v-node-code
     2290                       and gds-prt.root <> yes
     2291               no-error.
     2292           end.
     2293       if Make-Excel then  put   stream ForExcel unformatted
     2294             v-article + v-prt-name       CHR(9)
     2295             v-wealth-name   CHR(9)
     2296               v-cost-mpl      CHR(9)
     2297             v-fact-qnty     CHR(9)
     2298             v-cost          CHR(9)
     2299             (v-cost
     2300             * v-fact-qnty)  CHR(9)
     2301             v-b-str         CHR(9)
     2302       skip.
     2303       end.
     2304     end.
     2305     end.
     2306   end procedure.
