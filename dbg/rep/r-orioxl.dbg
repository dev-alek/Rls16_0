      893     find first bf_object no-lock where
      894                bf_object.obj-type = bf_trn-doc.obj-type and
      895                bf_object.obj-code = bf_trn-doc.obj-code .
      896   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
