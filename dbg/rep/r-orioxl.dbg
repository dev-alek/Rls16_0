      592         buf_temp_line-data.LevelTotal    = p-LevelTotal
      593         buf_temp_line-data.LevelWater    = p-LevelWater
      594         buf_temp_line-data.BruttoQnty    = p-BruttoQnty
      595         buf_temp_line-data.WaterQnty     = p-WaterQnty
      596         buf_temp_line-data.PetrolQnty    = p-PetrolQnty
      597         buf_temp_line-data.Density       = p-Density
      598         buf_temp_line-data.Temperature   = p-Temperature
      599         buf_temp_line-data.BruttoCliQnty = p-BruttoCliQnty
      600         buf_temp_line-data.WaterCliQnty  = p-WaterCliQnty
      601         buf_temp_line-data.PetrolCliQnty = p-PetrolCliQnty
      602         buf_temp_line-data.AddCliQnty    = p-AddCliQnty
      603         buf_temp_line-data.OverCliQnty   = p-OverCliQnty
      604         buf_temp_line-data.Price         = p-Price
      605         buf_temp_line-data.OverSum       = p-OverSum
      606         buf_temp_line-data.BookQnty      = p-BookQnty
      607         buf_temp_line-data.BookSum       = p-BookSum
      608         buf_temp_line-data.ExtraQnty     = p-ExtraQnty
      609         buf_temp_line-data.ExtraSum      = p-ExtraSum
      610         buf_temp_line-data.MissQnty      = p-MissQnty
      611         buf_temp_line-data.MissSum       = p-MissSum
      612       .
      613       put stream excel-line unformatted
      614         buf_temp_line-data.data-key      chr(9)
      615         buf_temp_line-data.Num           chr(9)
      616         buf_temp_line-data.Name          chr(9)
      617         buf_temp_line-data.Locate        chr(9)
      618         buf_temp_line-data.Artic         chr(9)
      619         buf_temp_line-data.LevelTotal    chr(9)
      620         buf_temp_line-data.LevelWater    chr(9)
      621         buf_temp_line-data.BruttoQnty    chr(9)
      622         buf_temp_line-data.WaterQnty     chr(9)
      623         buf_temp_line-data.PetrolQnty    chr(9)
      624         buf_temp_line-data.Density       chr(9)
      625         buf_temp_line-data.Temperature   chr(9)
      626         buf_temp_line-data.BruttoCliQnty chr(9)
      627         buf_temp_line-data.WaterCliQnty  chr(9)
      628         buf_temp_line-data.PetrolCliQnty chr(9)
      629         buf_temp_line-data.AddCliQnty    chr(9)
      630         buf_temp_line-data.OverCliQnty   chr(9)
      631         buf_temp_line-data.Price         chr(9)
      632         buf_temp_line-data.OverSum       chr(9)
      633         buf_temp_line-data.BookQnty      chr(9)
      634         buf_temp_line-data.BookSum       chr(9)
