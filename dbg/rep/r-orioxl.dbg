      460   .
      461   define variable v-r-orioxl-current-data-row as integer   no-undo .
      462   define variable v-r-orioxl-cell-file-name   as character no-undo .
      463   define variable v-r-orioxl-data-file-name   as character no-undo .
      464   procedure r-orioxl-init :
      465     define buffer buf_temp_cell-data for temp_cell-data .
      466     define buffer buf_usr-flt        for ubflt.usr-flt .
      467     do
      468     for buf_temp_cell-data
      469       , buf_usr-flt
      470     on error undo, return error
      471     :
      472       assign
      473         v-r-orioxl-current-data-row = 0
      474       .
      475       run gbl/_tmpfile.p
      476         ( input "xd"
      477         , input ".txt"
      478         , output v-r-orioxl-data-file-name
      479         ) .
      480       output stream excel-line to value( v-r-orioxl-data-file-name ) .
      481       run gbl/_tmpfile.p
      482         ( input "xc"
      483         , input ".txt"
      484         , output v-r-orioxl-cell-file-name
      485         ) .
      486       output stream excel-cell to value( v-r-orioxl-cell-file-name ) .
      487       run r-orioxl-write-cell-data in this-procedure
      488         ( input "valutCode":U
      489         , input "0":U
      490         ) .
      491       run r-orioxl-write-cell-data in this-procedure
      492         ( input "columnList":U
      493         , input "Num,Name,Locate,Artic,LevelTotal,LevelWater,BruttoQnty,WaterQnty,PetrolQnty,Density,Temperature,"
      494         +       "BruttoCliQnty,WaterCliQnty,PetrolCliQnty,AddCliQnty,OverCliQnty,Price,OverSum,BookQnty,BookSum,ExtraQnty,"
      495         +       "ExtraSum,MissQnty,MissSum":U
      496         ) .
      497       run r-orioxl-write-cell-data in this-procedure
      498         ( input "columnType":U
      499         , input "I,S,I,S,D,D,D,D,D,D,D,D,D,D,D,D,C,C,D,C,D,C,D,C":U
      500         ) .
      501       run r-orioxl-write-cell-data in this-procedure
      502         ( input "columnAmount":U
      503         , input "24":U
      504         ) .
      505     end.
      506   end procedure.
      507   procedure r-orioxl-close :
      508     do
      509     on error undo, return error
      510     :
      511       output stream excel-line close .
      512       output stream excel-cell close .
      513       output to value( string( session :temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append .
      514       export "exe/t32np_97.xlt":U .
      515       export "exe/t_97.bas":U .
      516       export v-r-orioxl-cell-file-name .
      517       export v-r-orioxl-data-file-name .
      518       output close .
      519     end.
      520   end procedure.
      521   procedure r-orioxl-write-cell-data :
      522     define input parameter p-data-key   as character no-undo .
      523     define input parameter p-data-value as character no-undo .
      524     define buffer buf_temp_cell-data for temp_cell-data .
      525     do
      526     for buf_temp_cell-data
      527     on error undo, return error
      528     :
      529       find first buf_temp_cell-data where
      530                  buf_temp_cell-data.data-key = p-data-key no-error.
      531       if not available buf_temp_cell-data
      532       then do:
      533         create buf_temp_cell-data .
      534         assign
      535           buf_temp_cell-data.data-key = p-data-key
      536         .
      537       end.
      538       assign
      539         buf_temp_cell-data.data-value = p-data-value
      540       .
      541       put stream excel-cell unformatted
      542         buf_temp_cell-data.data-key   chr(9)
      543         buf_temp_cell-data.data-value chr(10)
      544       .
      545     end.
      546   end procedure.
      547   procedure r-orioxl-write-line-data :
      548     define input parameter p-Num           as integer   no-undo .
      549     define input parameter p-Name          as character no-undo .
      550     define input parameter p-Locate        as character no-undo .
