      636         buf_temp_line-data.ExtraSum      chr(9)
      637         buf_temp_line-data.MissQnty      chr(9)
      638         buf_temp_line-data.MissSum       chr(10)
      639       .
      640     end.
      641   end procedure.
      642   procedure r-orioxl-run-excel :
      643     define input parameter p-header-filename as character no-undo .
      644     define input parameter p-data-filename   as character no-undo .
      645     define variable v-template-file-name as character no-undo .
      646     define variable v-vb-file-name       as character no-undo .
      647     define buffer buf_temp-param for temp-param .
      648     do
      649     for buf_temp-param
      650     on error undo, return error
      651     :
      652       create buf_temp-param.
      653       assign
      654         v-template-file-name = search( "exe/t32np_97.xlt" )
      655         v-vb-file-name       = search( "exe/t_97.bas" )
      656       .
      657       if v-template-file-name = ? or
      658          v-template-file-name = "":U
      659       then do:
      660         message
      661           "Ошибка имени файла шаблона."
      662         view-as alert-box error .
      663       end.
      664       if v-vb-file-name = ? or
      665          v-vb-file-name = "":U
      666       then do:
      667         message
      668           "Ошибка имени файла кода обработки."
      669         view-as alert-box error .
      670       end.
      671       run paramls-write in this-procedure
      672         ( input "template":U
      673         , input "template-file-name":U
      674         , input v-template-file-name
      675         ) .
      676       run paramls-write in this-procedure
      677         ( input "template":U
      678         , input "vb-file-name":U
      679         , input v-vb-file-name
      680         ) .
      681       run paramls-write in this-procedure
      682         ( input "data":U
      683         , input "data-header-filename":U
      684         , input p-header-filename
      685         ) .
      686       run paramls-write in this-procedure
      687         ( input "data":U
      688         , input "data-filename":U
      689         , input p-data-filename
      690         ) .
      691       run gbl/macroxlt.p
      692         ( input-output table buf_temp-param
      693         ) no-error .
      694       if error-status :error
      695       then do:
      696         message vss-workfile skip( 0 ) vss-date skip( 0 ) vss-revision skip( 1 ) vss-description skip( 1 )
      697                 "Ошибка создания файла Excel."  skip( 0 )
      698                 return-value                    skip( 0 )
      699                 trim( error-status :get-message( 1 ) )
      700                 trim( error-status :get-message( 2 ) )
      701                 trim( error-status :get-message( 3 ) )
      702         view-as alert-box error .
      703         undo, return error .
      704       end.
      705     end.
      706   end procedure.
