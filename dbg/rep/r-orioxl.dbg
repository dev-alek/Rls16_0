      732   FUNCTION MonthNameRusCase RETURNS CHARACTER ( INPUT i-month AS INTEGER, INPUT i-case AS INTEGER ) :
      733     DEFINE VARIABLE v-name AS CHARACTER NO-UNDO.
      734     RUN get-month-name-case IN THIS-PROCEDURE ( INPUT i-month, INPUT i-case, OUTPUT v-name ) NO-ERROR.
      735     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-name ).
      736   END FUNCTION.
      737   PROCEDURE get-month-name-case :
      738     DEFINE  INPUT PARAMETER p-month AS INTEGER   NO-UNDO.
      739     DEFINE  INPUT PARAMETER p-case  AS INTEGER   NO-UNDO.
      740     DEFINE OUTPUT PARAMETER p-name  AS CHARACTER NO-UNDO.
      741     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO EXTENT 6 INITIAL
      742       [ "Январь,Февраль,Март,Апрель,Май,Июнь,Июль,Август,Сентябрь,Октябрь,Ноябрь,Декабрь",
      743         "января,февраля,марта,апреля,мая,июня,июля,августа,сентября,октября,ноября,декабря",
      744         "Январю,Февралю,Марту,Апрелю,Маю,Июню,Июлю,Августу,Сентябрю,Октябрю,Ноябрю,Декабрю",
      745         "Январь,Февраль,Март,Апрель,Май,Июнь,Июль,Август,Сентябрь,Октябрь,Ноябрь,Декабрь",
      746         "Январем,Февралем,Мартом,Апрелем,Маем,Июнем,Июлем,Августом,Сентябрем,Октябрем,Ноябрем,Декабрем",
      747         "Январе,Феврале,Марте,Апреле,Мае,Июне,Июле,Августе,Сентябре,Октябре,Ноябре,Декабре"              ].
      748     DO ON ERROR UNDO, RETURN ERROR :
      749       IF p-month < 1 OR p-month > 12 OR
      750          p-case  < 1 OR p-case  >  6 THEN DO:
      751         ASSIGN p-name = ?.
      752       END.                           ELSE DO:
      753         ASSIGN p-name = ENTRY( p-month, v-list[ p-case ] ).
      754       END.
      755     END.
      756   END PROCEDURE.
      757   FUNCTION Sparse RETURNS CHARACTER ( INPUT p-instring AS CHARACTER ) :
      758     DEFINE VARIABLE v-outstring AS CHARACTER NO-UNDO.
      759     RUN get-sparsed-string IN THIS-PROCEDURE ( INPUT p-instring, OUTPUT v-outstring ) NO-ERROR.
      760     RETURN ( IF ERROR-STATUS :ERROR THEN p-instring ELSE v-outstring ).
      761   END FUNCTION.
      762   PROCEDURE get-sparsed-string :
      763     DEFINE  INPUT PARAMETER p-instring  AS CHARACTER NO-UNDO.
      764     DEFINE OUTPUT PARAMETER p-outstring AS CHARACTER NO-UNDO INITIAL "":U.
      765     DEFINE VARIABLE jj AS INTEGER NO-UNDO.
      766     DO ON ERROR UNDO, RETURN ERROR :
      767       DO jj = 1 TO LENGTH( p-instring ) :
      768         ASSIGN p-outstring = p-outstring + ( IF p-outstring = "":U THEN "":U ELSE " ":U ) + SUBSTRING( p-instring, jj, 1 ).
      769       END.
      770       ASSIGN p-outstring = CAPS( TRIM( p-outstring ) ).
      771     END.
      772   END PROCEDURE.
      773   function OutDec returns character ( input p-sum  as decimal
      774                                     , input p-hide as logical ) :
      775     define variable v-sum as character no-undo .
      776     run dec2char in this-procedure
      777       (  input p-sum
      778       ,  input p-hide
      779       , output v-sum
      780       ) no-error.
      781     return ( if error-status :error then '':U else v-sum ) .
      782   end function.
      783   function CenterLine returns character ( input p-in-string as character
      784                                         , input p-rep-width as integer ) :
