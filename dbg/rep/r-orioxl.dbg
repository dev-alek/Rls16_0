      555     define input parameter p-WaterQnty     as character no-undo .
      556     define input parameter p-PetrolQnty    as character no-undo .
      557     define input parameter p-Density       as character no-undo .
      558     define input parameter p-Temperature   as character no-undo .
      559     define input parameter p-BruttoCliQnty as character no-undo .
      560     define input parameter p-WaterCliQnty  as character no-undo .
      561     define input parameter p-PetrolCliQnty as character no-undo .
      562     define input parameter p-AddCliQnty    as character no-undo .
      563     define input parameter p-OverCliQnty   as character no-undo .
