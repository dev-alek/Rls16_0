     3270           p-fact-qnty         = buf_main_price-list.doc-qnty
     3271           p-cur-base          = price-rubl-with-tax-sale-prl * buf_main_price-list.doc-qnty
     3272           p-cur-VAT-base      = vat-rubl-sale-prl * buf_main_price-list.doc-qnty
     3273           p-cur-SLT-base      = slt-rubl-sale-prl * buf_main_price-list.doc-qnty
     3274           p-cur-road-tax-base = road-tax-rubl-sale-prl * buf_main_price-list.doc-qnty
     3275           p-cur-excise-base   = excise-rubl-sale-prl * buf_main_price-list.doc-qnty
     3276         .
     3277       end.
     3278         define variable v-unit-base like ub.goods.unit-base no-undo .
     3279   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3280   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     3281     (input  buf_goods.gds-code
     3282     ,output v-unit-base
     3283     ) no-error .
     3284         if error-status :error
     3285         then do:
     3286           message
     3287             vss-workfile vss-revision vss-description skip
     3288             vss-include-info24 skip
     3289             "Ошибка при определении базовой единицы измерения товара" skip
     3290             "Код товара" buf_goods.gds-code skip
     3291             error-status :get-message(1) skip
     3292             return-value skip
     3293             view-as alert-box error .
     3294           undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     3295         end.
     3296         for each buf_price-list no-lock
     3297           where buf_price-list.doc-num    = buf_main_price-list.doc-num
     3298             and buf_price-list.main-price = false
     3299             and buf_price-list.artic      = buf_main_price-list.artic
     3300             and buf_price-list.prod-type  = buf_main_price-list.prod-type
     3301             and buf_price-list.prod-code  = buf_main_price-list.prod-code
     3302         :
     3303           if buf_price-list.doc-qnty = ?
     3304           then do:
     3305             find first buf_bar-code no-lock
     3306               where buf_bar-code.b-code = buf_price-list.b-code
     3307               no-error .
     3308             if available buf_bar-code
     3309             and buf_bar-code.unit-cli = v-unit-base
     3310             then do:
     3311               message
     3312                 vss-workfile vss-revision vss-description skip
     3313                 vss-include-info24 skip
     3314                 "Ошибка при закрытии переоценки" skip
     3315                 "Не задано количество для бар-кода с основной единицей измерения" skip
     3316                 "Переоценка" buf_main_price-list.doc-num skip
     3317                 "Бар-код" buf_price-list.b-code skip
     3318                 "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     3319                 "Количество" buf_price-list.doc-qnty skip
     3320                 "Основная единица измерения" v-unit-base skip
     3321                 "Единица измерения бар-кода" buf_bar-code.unit-cli skip
     3322                 view-as alert-box error .
     3323               undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     3324             end.
     3325             next .
     3326           end.
     3327           if not can-find
     3328             (first buf_bar-code
     3329             where buf_bar-code.b-code = buf_price-list.b-code
     3330             )
     3331           then do:
     3332             message
     3333               vss-workfile vss-revision vss-description skip
     3334               vss-include-info24 skip
     3335               "В переоценке задан несуществующий бар-код" skip
     3336               "Переоценка" buf_price-list.doc-num skip
     3337               "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
     3338               "Бар-код" buf_price-list.b-code skip
     3339               view-as alert-box error .
     3340             undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     3341           end.
     3342           if buf_price-list.doc-qnty <> 0
     3343           then do:
     3344             run prl-vat in this-procedure
     3345               (input  recid(buf_price-list)
     3346               ,output price-rubl-with-tax-sale-prl
     3347               ,output price-base-with-tax-sale-prl
     3348               ,output price-rubl-without-tax-sale-prl
     3349               ,output price-base-without-tax-sale-prl
     3350               ,output vat-base-sale-prl
     3351               ,output vat-rubl-sale-prl
     3352               ,output vat-base-buyer-prl
     3353               ,output vat-rubl-buyer-prl
     3354               ,output slt-base-sale-prl
     3355               ,output slt-rubl-sale-prl
     3356               ,output road-tax-base-sale-prl
     3357               ,output road-tax-rubl-sale-prl
     3358               ,output excise-base-sale-prl
     3359               ,output excise-rubl-sale-prl
     3360               ,output discnt-base-sale-prl
     3361               ,output discnt-rubl-sale-prl
     3362               ) no-error .
     3363             if error-status :error
     3364             then do:
     3365               message
     3366                 vss-workfile vss-revision vss-description skip
     3367                 vss-include-info24 skip
     3368                 "Ошибка при вызове процеды prl-vat" skip
     3369                 "Документ" buf_price-list.doc-num skip
     3370                 "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
     3371                 error-status :get-message(1) skip
     3372                 return-value skip
     3373                 view-as alert-box error .
     3374               undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     3375             end.
     3376           end.
     3377           else do:
     3378             assign
     3379               price-rubl-with-tax-sale-prl    = 0
     3380               price-base-with-tax-sale-prl    = 0
     3381               price-rubl-without-tax-sale-prl = 0
     3382               price-base-without-tax-sale-prl = 0
     3383               vat-base-sale-prl               = 0
     3384               vat-rubl-sale-prl               = 0
     3385               vat-base-buyer-prl              = 0
     3386               vat-rubl-buyer-prl              = 0
     3387               slt-base-sale-prl               = 0
     3388               slt-rubl-sale-prl               = 0
     3389               road-tax-base-sale-prl          = 0
     3390               road-tax-rubl-sale-prl          = 0
     3391               excise-base-sale-prl            = 0
     3392               excise-rubl-sale-prl            = 0
     3393               discnt-base-sale-prl            = 0
     3394               discnt-rubl-sale-prl            = 0
     3395             .
     3396           end.
     3397           if v-curr-r-b = 'base':U
     3398           then do:
     3399             assign
     3400               p-fact-qnty         = p-fact-qnty
     3401                                   + buf_price-list.doc-qnty
     3402               p-cur-base          = p-cur-base
     3403                                   + price-base-with-tax-sale-prl * buf_price-list.doc-qnty
     3404               p-cur-VAT-base      = p-cur-VAT-base
     3405                                   + vat-base-sale-prl * buf_price-list.doc-qnty
     3406               p-cur-SLT-base      = p-cur-SLT-base
     3407                                   + slt-base-sale-prl * buf_price-list.doc-qnty
     3408               p-cur-road-tax-base = p-cur-road-tax-base
     3409                                   + road-tax-base-sale-prl * buf_price-list.doc-qnty
     3410               p-cur-excise-base   = p-cur-excise-base
     3411                                   + excise-base-sale-prl * buf_price-list.doc-qnty
     3412             .
     3413           end.
     3414           else do:
     3415             assign
     3416               p-fact-qnty         = p-fact-qnty
     3417                                   + buf_price-list.doc-qnty
     3418               p-cur-base          = p-cur-base
     3419                                   + price-rubl-with-tax-sale-prl * buf_price-list.doc-qnty
     3420               p-cur-VAT-base      = p-cur-VAT-base
     3421                                   + vat-rubl-sale-prl * buf_price-list.doc-qnty
     3422               p-cur-SLT-base      = p-cur-SLT-base
     3423                                   + slt-rubl-sale-prl * buf_price-list.doc-qnty
     3424               p-cur-road-tax-base = p-cur-road-tax-base
     3425                                   + road-tax-rubl-sale-prl * buf_price-list.doc-qnty
     3426               p-cur-excise-base   = p-cur-excise-base
     3427                                   + excise-rubl-sale-prl * buf_price-list.doc-qnty
     3428             .
     3429           end.
     3430         end.
     3431     end.
     3432   end procedure.
     3433   procedure prdoclib-calc-prc :
     3434     define input  parameter p-price-doc-recid as   recid                  no-undo.
     3435     define input  parameter p-cons-pay        as   integer                no-undo.
     3436     define output parameter p-ov-cons         like ub.doc-line.price-base no-undo.
     3437     define output parameter p-ov-VAT-cons     like ub.doc-line.price-base no-undo.
     3438     define output parameter p-ov-SLT-cons     like ub.doc-line.price-base no-undo.
     3439     define output parameter p-ov-prch         like ub.doc-line.price-base no-undo.
     3440     define output parameter p-ov-VAT-prch     like ub.doc-line.price-base no-undo.
     3441     define output parameter p-ov-SLT-prch     like ub.doc-line.price-base no-undo.
     3442     do
     3443     on error undo, return error return-value
     3444     :
     3445       define buffer buf_price-doc       for ub.price-doc .
     3446       define buffer buf_price-list      for ub.price-list .
     3447       define buffer buf_parts           for ub.parts .
     3448       define variable v-ov-qnty     as decimal   no-undo .
     3449       define variable v-ov-base     as decimal   no-undo .
     3450       define variable v-ov-VAT-base as decimal   no-undo .
     3451       define variable v-ov-SLT-base as decimal   no-undo .
     3452       define variable v-cons-qnty   as decimal   no-undo .
     3453       define variable v-prch-qnty   as decimal   no-undo .
     3454       define variable v-cons-mult   as decimal   no-undo .
     3455       define variable v-prch-mult   as decimal   no-undo .
     3456       find first buf_price-doc no-lock
     3457         where recid(buf_price-doc) = p-price-doc-recid
     3458         no-error .
     3459       if not available buf_price-doc
     3460       then do:
     3461         message
     3462           vss-workfile vss-revision vss-description skip
     3463           vss-include-info24 skip
     3464           "Ошибка задания входных параметров" skip
     3465           "Не найден документ переоценки" skip
     3466           "Код записи (recid)" p-price-doc-recid skip
     3467           view-as alert-box error .
     3468         undo, return error .
     3469       end.
     3470       for each buf_price-list no-lock
     3471         where buf_price-list.doc-num    = buf_price-doc.doc-num
     3472           and buf_price-list.main-price = true
     3473       on error undo, return error return-value
     3474       :
     3475         run prdoclib-calc-ov
     3476           (input recid(buf_price-list)
     3477           ,output v-ov-qnty
     3478           ,output v-ov-base
     3479           ,output v-ov-VAT-base
     3480           ,output v-ov-SLT-base
     3481           ) no-error .
     3482         if error-status :error
     3483         then do:
     3484           if error-status :get-message(1) <> ""
     3485           then do:
     3486             message
     3487               vss-workfile vss-revision vss-description skip
     3488               vss-include-info24 skip
     3489               "Ошибка при вызове процедуры prdoclib-calc-ov" skip
     3490               error-status :get-message(1) skip
     3491               return-value skip
     3492               view-as alert-box error .
     3493           end.
     3494           undo, return error return-value .
     3495         end.
     3496         assign
     3497           v-cons-qnty = 0
     3498           v-prch-qnty = 0
     3499         .
     3500         for each buf_parts no-lock
     3501           where buf_parts.out-code  = buf_price-list.doc-num
     3502             and buf_parts.obj-type  = buf_price-list.obj-type
     3503             and buf_parts.obj-code  = buf_price-list.obj-code
     3504             and buf_parts.artic     = buf_price-list.artic
     3505             and buf_parts.prod-type = buf_price-list.prod-type
     3506             and buf_parts.prod-code = buf_price-list.prod-code
     3507         on error undo, return error return-value
     3508         :
     3509           if buf_parts.pay-code = p-cons-pay
     3510           then do:
     3511             assign
     3512               v-cons-qnty = v-cons-qnty + buf_parts.fact-qnty
     3513             .
     3514           end.
     3515           else do:
     3516             assign
     3517               v-prch-qnty = v-prch-qnty + buf_parts.fact-qnty
     3518             .
     3519           end.
     3520         end.
     3521         if (v-cons-qnty + v-prch-qnty) = 0
     3522         then do:
     3523           assign
     3524             v-cons-mult = 0
     3525             v-prch-mult = 1
     3526           .
     3527         end.
     3528         else do:
     3529           assign
     3530             v-cons-mult = v-cons-qnty / (v-cons-qnty + v-prch-qnty)
     3531             v-prch-mult = v-prch-qnty / (v-cons-qnty + v-prch-qnty)
     3532           .
     3533         end.
     3534         assign
     3535           p-ov-cons     = p-ov-cons     + v-ov-base     * v-cons-mult
     3536           p-ov-VAT-cons = p-ov-VAT-cons + v-ov-VAT-base * v-cons-mult
     3537           p-ov-SLT-cons = p-ov-SLT-cons + v-ov-SLT-base * v-cons-mult
     3538           p-ov-prch     = p-ov-prch     + v-ov-base     * v-prch-mult
     3539           p-ov-VAT-prch = p-ov-VAT-prch + v-ov-VAT-base * v-prch-mult
     3540           p-ov-SLT-prch = p-ov-SLT-prch + v-ov-SLT-base * v-prch-mult
     3541         .
     3542       end.
     3543     end.
     3544   end procedure.
     3545   procedure prdoclib-calc-ov :
     3546     define input  parameter p-price-list-recid as recid     no-undo .
     3547     define output parameter p-fact-qnty        as decimal   no-undo .
     3548     define output parameter p-ov-base          as decimal   no-undo .
     3549     define output parameter p-ov-VAT-base      as decimal   no-undo .
     3550     define output parameter p-ov-SLT-base      as decimal   no-undo .
     3551     do
     3552     on error undo, return error return-value
     3553     :
     3554       define buffer buf_main_price-list    for ub.price-list .
     3555       define buffer buf_prev_price-list    for ub.price-list .
     3556       define buffer buf_special_price-list for ub.price-list .
     3557       define buffer buf_goods              for ub.goods .
     3558       define variable v-fact-qnty             like ub.doc-line.price-base no-undo.
     3559       define variable v-cur-base              like ub.doc-line.price-base no-undo.
     3560       define variable v-cur-VAT-base          like ub.doc-line.price-base no-undo.
     3561       define variable v-cur-SLT-base          like ub.doc-line.price-base no-undo.
     3562       define variable v-cur-road-tax-base     like ub.doc-line.price-base no-undo.
     3563       define variable v-cur-excise-base       like ub.doc-line.price-base no-undo.
     3564       define variable v-prev-price-list-recid as   recid                  no-undo.
     3565       define variable v-prev-cli-base-rate    like ub.goods.cli-base-rate no-undo.
     3566       define variable v-prev-fact-qnty        like ub.doc-line.price-base no-undo.
     3567       define variable v-prev-cur-base         like ub.doc-line.price-base no-undo.
     3568       define variable v-prev-cur-VAT-base     like ub.doc-line.price-base no-undo.
     3569       define variable v-prev-cur-SLT-base     like ub.doc-line.price-base no-undo.
     3570       find first buf_main_price-list no-lock
     3571         where recid(buf_main_price-list) = p-price-list-recid
     3572         no-error .
     3573       if not available buf_main_price-list
     3574       then do:
     3575         message
     3576           vss-workfile vss-revision vss-description skip
     3577           vss-include-info24 skip
     3578           "Ошибка задания входных параметров" skip
     3579           "Не найдена строка переоценки" skip
     3580           "Код записи (recid)" p-price-list-recid skip
     3581           view-as alert-box error .
     3582         undo, return error .
     3583       end.
     3584       if buf_main_price-list.main-price <> true
     3585       then do:
     3586         message
     3587           vss-workfile vss-revision vss-description skip
     3588           vss-include-info24 skip
     3589           "Ошибка задания входных параметров" skip
     3590           "Строка переоценки не является основной" skip
     3591           "Код записи (recid)" p-price-list-recid skip
     3592           "Переоценка" buf_main_price-list.doc-num skip
     3593           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     3594           "Бар-код" buf_main_price-list.b-code skip
     3595           view-as alert-box error .
     3596         undo, return error .
     3597       end.
     3598       run prdoclib-calc-fact-sale in this-procedure
     3599         (input  recid(buf_main_price-list)
     3600         ,output v-fact-qnty
     3601         ,output v-cur-base
     3602         ,output v-cur-VAT-base
     3603         ,output v-cur-SLT-base
     3604         ,output v-cur-road-tax-base
     3605         ,output v-cur-excise-base
     3606         ) no-error.
     3607       if error-status :error
     3608       then do:
     3609         message
     3610           vss-workfile vss-revision vss-description skip
     3611           vss-include-info24 skip
     3612           "Ошибка при расчете сумм переоценки." skip
     3613           "Документ переоценки" buf_main_price-list.doc-num skip
     3614           "Товар" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     3615           error-status :get-message(1) skip
     3616           return-value skip
     3617           view-as alert-box error .
     3618         undo, return error .
     3619       end.
     3620   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3621   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     3622     (input  buf_main_price-list.obj-type
     3623     ,input  buf_main_price-list.obj-code
     3624     ,input  buf_main_price-list.b-code
     3625     ,input  buf_main_price-list.b-code
     3626     ,input  buf_main_price-list.fact-order
     3627     ,output v-prev-price-list-recid
     3628     ,output v-prev-cli-base-rate
     3629     ) no-error .
     3630       if error-status :error
     3631       then do:
     3632         message
     3633           vss-workfile vss-revision vss-description skip
     3634           vss-include-info24 skip
     3635           "Ошибка при поиске предыдущей переоценки." skip
     3636           "Документ переоценки " buf_main_price-list.doc-num skip
     3637           "Товар " buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     3638           error-status :get-message(1) skip
     3639           return-value skip
     3640           view-as alert-box error .
     3641         undo, return error .
     3642       end.
     3643       if v-prev-price-list-recid <> ?
     3644       then do:
     3645         find first buf_prev_price-list no-lock
     3646           where recid(buf_prev_price-list) = v-prev-price-list-recid
     3647           .
     3648         find first buf_special_price-list no-lock
     3649           where buf_special_price-list.doc-num    = buf_prev_price-list.doc-num
     3650             and buf_special_price-list.main-price = false
     3651             and buf_special_price-list.artic      = buf_prev_price-list.artic
     3652             and buf_special_price-list.prod-type  = buf_prev_price-list.prod-type
     3653             and buf_special_price-list.prod-code  = buf_prev_price-list.prod-code
     3654             and buf_special_price-list.doc-qnty   <> ?
     3655           no-error .
     3656         if available buf_special_price-list
     3657         then do:
     3658           message
     3659             "Товар имеет специальные цены на признаки" skip
     3660             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     3661             "Переоценка" buf_prev_price-list.doc-num skip
     3662             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     3663             view-as alert-box error .
     3664           undo, return error .
     3665         end.
     3666         find first buf_goods no-lock
     3667           where buf_goods.artic     = buf_main_price-list.artic
     3668             and buf_goods.prod-type = buf_main_price-list.prod-type
     3669             and buf_goods.prod-code = buf_main_price-list.prod-code
     3670           no-error .
     3671         if not available buf_goods
     3672         then do:
     3673           message
     3674             vss-workfile vss-revision vss-description skip
     3675             vss-include-info24 skip
     3676             "Не найден товар" skip
     3677             "Переоценка" buf_main_price-list.doc-num skip
     3678             "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     3679             view-as alert-box error .
     3680           undo, return error .
     3681         end.
     3682         if buf_prev_price-list.vat-pc = ?
     3683         or buf_prev_price-list.slt-pc = ?
     3684         then do:
     3685           message
     3686             "В переоценке не заданы налоги товара" skip
     3687             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     3688             "Переоценка" buf_prev_price-list.doc-num skip
     3689             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     3690             "НДС" buf_prev_price-list.vat-pc skip
     3691             "НП" buf_prev_price-list.slt-pc skip
     3692             view-as alert-box error .
     3693           undo, return error return-value .
     3694         end.
     3695         define variable v-prev-cur-SLT-pc as decimal no-undo .
     3696         assign
     3697           v-prev-cur-SLT-pc   = buf_prev_price-list.price-sale * buf_prev_price-list.slt-pc / (100 + buf_prev_price-list.slt-pc)
     3698         .
     3699         assign
     3700           v-prev-cur-base     = v-fact-qnty * buf_prev_price-list.price-sale
     3701           v-prev-cur-VAT-base = v-fact-qnty
     3702                               * (buf_prev_price-list.price-sale - v-prev-cur-SLT-pc)
     3703                               * buf_prev_price-list.vat-pc / (100 + buf_prev_price-list.vat-pc)
     3704           v-prev-cur-SLT-base = v-fact-qnty * v-prev-cur-SLT-pc
     3705         .
     3706         assign
     3707           p-fact-qnty   = v-fact-qnty
     3708           p-ov-base     = v-cur-base     - v-prev-cur-base
     3709           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     3710           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     3711         .
     3712       end.
     3713       else do:
     3714         assign
     3715           v-prev-cur-base     = 0
     3716           v-prev-cur-VAT-base = 0
     3717           v-prev-cur-SLT-base = 0
     3718           .
     3719         assign
     3720           p-fact-qnty   = v-fact-qnty
     3721           p-ov-base     = v-cur-base     - v-prev-cur-base
     3722           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     3723           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     3724         .
     3725       end.
     3726     end.
     3727   end procedure.
     3728   procedure prdoclib-init-prt-obj-by-factord :
     3729     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     3730     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     3731     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     3732     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     3733     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     3734     define input parameter p-fact-order         as decimal   no-undo .
     3735     define input parameter p-include-fact-order as logical   no-undo .
     3736     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-factord: определение остатков по признакам на любой момент времени".
     3737     define buffer buf_gds-obj      for ub.gds-obj .
     3738     define buffer buf_doc-line     for ub.doc-line .
     3739     define buffer buf_temp-prt-obj for temp-prt-obj .
     3740     define variable v-total-gds-dtl-qnty as decimal   no-undo .
     3741     do
     3742     on error undo, return error return-value
     3743     :
     3744       do transaction
     3745       on error undo, return error return-value
     3746       :
     3747   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3748   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     3749     (input  p-obj-type
     3750     ,input  p-obj-code
     3751     ,input  p-artic
     3752     ,input  p-prod-type
     3753     ,input  p-prod-code
     3754     ,buffer buf_gds-obj
     3755     ) no-error .
     3756         if error-status :error
     3757         then do:
     3758           message
     3759             vss-workfile vss-revision vss-description skip
     3760             vss-include-info24 skip
     3761             "Невозможно найти gds-obj" skip
     3762             error-status :get-message(1) skip
     3763             return-value skip
     3764             view-as alert-box error .
     3765           undo, return error .
     3766         end.
     3767         find current buf_gds-obj exclusive-lock .
     3768       end.
     3769       run prdoclib-init-temp-prt-obj in this-procedure
     3770         (input p-obj-type
     3771         ,input p-obj-code
     3772         ,input p-artic
     3773         ,input p-prod-type
     3774         ,input p-prod-code
     3775         ,input 0
     3776         ) .
     3777       for each buf_temp-prt-obj
     3778         where buf_temp-prt-obj.is-term <> true
     3779       on error undo, return error return-value
     3780       :
     3781         delete buf_temp-prt-obj .
     3782       end.
     3783       if p-include-fact-order = true
     3784       then do:
     3785         assign
     3786          p-fact-order = p-fact-order - 0.0000000001
     3787         .
     3788       end.
     3789       for each buf_doc-line no-lock
     3790         where buf_doc-line.obj-type   = p-obj-type
     3791           and buf_doc-line.obj-code   = p-obj-code
     3792           and buf_doc-line.artic      = p-artic
     3793           and buf_doc-line.prod-type  = p-prod-type
     3794           and buf_doc-line.prod-code  = p-prod-code
     3795           and buf_doc-line.status_    = 'факт':U
     3796           and buf_doc-line.fact-order >= p-fact-order
     3797       on error undo, return error return-value
     3798       :
     3799         run prdoclib-process-document in this-procedure
     3800           (input  buf_doc-line.doc-code
     3801           ,input  p-obj-type
     3802           ,input  p-obj-code
     3803           ,input  p-artic
     3804           ,input  p-prod-type
     3805           ,input  p-prod-code
     3806           ,output v-total-gds-dtl-qnty
     3807           ) .
     3808       end.
     3809     end.
     3810   end procedure.
     3811   procedure prdoclib-process-document :
     3812     define input  parameter p-doc-code           as character no-undo .
     3813     define input  parameter p-obj-type           as character no-undo .
     3814     define input  parameter p-obj-code           as integer   no-undo .
     3815     define input  parameter p-artic              as character no-undo .
     3816     define input  parameter p-prod-type          as character no-undo .
     3817     define input  parameter p-prod-code          as integer   no-undo .
     3818     define output parameter p-total-gds-dtl-qnty as decimal   no-undo .
     3819     define buffer buf_trn-doc      for ub.trn-doc .
     3820     define buffer buf_gds-dtl      for ub.gds-dtl .
     3821     define buffer buf_temp-prt-obj for temp-prt-obj .
     3822     do
     3823     on error undo, return error return-value
     3824     :
     3825       find first buf_trn-doc no-lock
     3826         where buf_trn-doc.doc-code = p-doc-code
     3827         no-error .
     3828       if not available buf_trn-doc then do:
     3829         message
     3830           vss-workfile vss-revision vss-description skip
     3831           vss-include-info24 skip
     3832           "Ошибка при поиске документа" skip
     3833           "Документ" p-doc-code skip
     3834           "Объект" p-obj-type p-obj-code skip
     3835           "Артикул" p-artic p-prod-type p-prod-code skip
     3836           view-as alert-box error .
     3837         undo, return error .
     3838       end.
     3839       assign
     3840         p-total-gds-dtl-qnty = 0
     3841       .
     3842       for each buf_gds-dtl no-lock
     3843         where buf_gds-dtl.doc-code  = p-doc-code
     3844           and buf_gds-dtl.artic     = p-artic
     3845           and buf_gds-dtl.prod-type = p-prod-type
     3846           and buf_gds-dtl.prod-code = p-prod-code
     3847       on error undo, return error
     3848       :
     3849         define variable v-term-node as integer   no-undo .
     3850   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run termnode in g#library
     3851     (input  buf_gds-dtl.prt-code
     3852     ,output v-term-node
     3853     )  .
     3854         run prdoclib-temp-prt-obj-by-prt-root in this-procedure
     3855           (input  v-term-node
     3856           ,buffer buf_temp-prt-obj
     3857           ) .
     3858         if buf_temp-prt-obj.is-term <> true then do:
     3859           undo, return error substitute("Документ ссылается на нетерминальный признак. Код признака &1"
     3860                                        ,buf_gds-dtl.prt-code
     3861                                        ) .
     3862         end.
     3863         case buf_trn-doc.doc-type :
     3864           when 'при':U or
     3865           when 'возврат':U
     3866           then do:
     3867             assign
     3868               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     3869                                           - buf_gds-dtl.fact-qnty
     3870               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     3871                                           - buf_gds-dtl.fact-qnty
     3872             .
     3873           end.
     3874           when 'рас':U or
     3875           when 'спи':U
     3876           then do:
     3877             assign
     3878               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     3879                                           + buf_gds-dtl.fact-qnty
     3880               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     3881                                           + buf_gds-dtl.fact-qnty
     3882             .
     3883           end.
     3884           when 'инв':U
     3885           then do:
     3886             assign
     3887               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     3888                                           - buf_gds-dtl.doc-qnty
     3889               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     3890                                           - buf_gds-dtl.doc-qnty
     3891             .
     3892           end.
     3893           otherwise do:
     3894             undo, return error substitute("Неизвестный тип документа &1"
     3895                                          ,buf_trn-doc.doc-type
     3896                                          ) .
     3897           end.
     3898         end.
     3899       end.
     3900     end.
     3901   end procedure.
     3902   procedure prdoclib-prc-pl-document :
     3903     define input  parameter p-doc-code              as character no-undo .
     3904     define input  parameter p-obj-type              as character no-undo .
     3905     define input  parameter p-obj-code              as integer   no-undo .
     3906     define input  parameter p-gds-code              as integer   no-undo .
     3907     define output parameter p-total-pl-gds-qnty     as decimal   no-undo .
     3908     define output parameter p-total-pl-gds-cli-qnty as decimal   no-undo .
     3909     do
     3910     on error undo, return error return-value
     3911     :
     3912       define buffer buf_trn-doc      for ub.trn-doc .
     3913       define buffer buf_doc-pl       for ub.doc-pl .
     3914       define buffer buf_temp-pl-gds for temp-pl-gds .
     3915       define variable v-sign as decimal   no-undo .
     3916       find first buf_trn-doc no-lock
     3917         where buf_trn-doc.doc-code = p-doc-code
     3918         no-error .
     3919       if not available buf_trn-doc then do:
     3920         message
     3921           vss-workfile vss-revision vss-description skip
     3922           vss-include-info24 skip
     3923           "Ошибка при поиске документа" skip
     3924           "Документ" p-doc-code skip
     3925           "Объект" p-obj-type p-obj-code skip
     3926           "Товар" p-gds-code skip
     3927           view-as alert-box error .
     3928         undo, return error .
     3929       end.
     3930       assign
     3931         p-total-pl-gds-qnty     = 0
     3932         p-total-pl-gds-cli-qnty = 0
     3933       .
     3934       for each buf_doc-pl no-lock
     3935         where buf_doc-pl.out-code  = p-doc-code
     3936           and buf_doc-pl.gds-code  = p-gds-code
     3937       on error undo, return error return-value
     3938       :
     3939         find first buf_temp-pl-gds
     3940           where buf_temp-pl-gds.obj-type = buf_trn-doc.obj-type
     3941             and buf_temp-pl-gds.obj-code = buf_trn-doc.obj-code
     3942             and buf_temp-pl-gds.pl-code  = buf_doc-pl.pl-code
     3943           .
     3944         case buf_trn-doc.doc-type :
     3945           when 'при':U
     3946           or when 'возврат':U
     3947           or when 'инв':U
     3948           then do:
     3949             assign
     3950               v-sign = -1.0
     3951             .
     3952           end.
     3953           when 'рас':U or
     3954           when 'спи':U
     3955           then do:
     3956             assign
     3957               v-sign = 1.0
     3958             .
     3959           end.
     3960           otherwise do:
     3961             undo, return error substitute("(prdoclib-prc-pl-document) Неизвестный тип документа &1", buf_trn-doc.doc-type ) .
     3962           end.
     3963         end case.
     3964         assign
     3965           p-total-pl-gds-qnty           = p-total-pl-gds-qnty           + buf_doc-pl.fact-qnty     * v-sign
     3966           p-total-pl-gds-cli-qnty       = p-total-pl-gds-cli-qnty       + buf_doc-pl.cli-fact-qnty * v-sign
     3967           buf_temp-pl-gds.fact-qnty     = buf_temp-pl-gds.fact-qnty     + buf_doc-pl.fact-qnty     * v-sign
     3968           buf_temp-pl-gds.cli-fact-qnty = buf_temp-pl-gds.cli-fact-qnty + buf_doc-pl.cli-fact-qnty * v-sign
     3969         .
     3970       end.
     3971     end.
     3972   end procedure.
     3973   procedure prdoclib-init-prt-obj-by-date :
     3974     define input parameter p-obj-type   like ub.gds-obj.obj-type  no-undo .
     3975     define input parameter p-obj-code   like ub.gds-obj.obj-code  no-undo .
     3976     define input parameter p-artic      like ub.gds-obj.artic     no-undo .
     3977     define input parameter p-prod-type  like ub.gds-obj.prod-type no-undo .
     3978     define input parameter p-prod-code  like ub.gds-obj.prod-code no-undo .
     3979     define input parameter p-fact-date  as date      no-undo .
     3980     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-date: определение остатков по признакам на конец дня".
     3981     do
     3982     on error undo, return error return-value
     3983     :
     3984       define variable v-fact-order                as decimal   no-undo .
     3985       define variable v-shift-end-fact-order      as decimal   no-undo .
     3986       define variable v-day-end-fact-order        as decimal   no-undo .
     3987       run factord in this-procedure
     3988         (input  p-fact-date
     3989         ,input  1
     3990         ,input  1
     3991         ,input  ?
     3992         ,input  0
     3993         ,input  false
     3994         ,output v-fact-order
     3995         ,output v-shift-end-fact-order
     3996         ,output v-day-end-fact-order
     3997         ) no-error .
     3998       if error-status :error
     3999       then do:
     4000         message
     4001           vss-workfile vss-revision vss-description skip
     4002           vss-include-info24 skip
     4003           "Ошибка при определении момента времени, на который требуется остаток" skip
     4004           "Объект" p-obj-type p-obj-code skip
     4005           "Артикул" p-artic p-prod-type p-prod-code skip
     4006           "Дата" p-fact-date skip
     4007           view-as alert-box error .
     4008         undo, return error .
     4009       end.
     4010       run prdoclib-init-prt-obj-by-date-factord in this-procedure
     4011         (input p-obj-type
     4012         ,input p-obj-code
     4013         ,input p-artic
     4014         ,input p-prod-type
     4015         ,input p-prod-code
     4016         ,input v-day-end-fact-order
     4017         ,input false
     4018         ) no-error .
     4019       if error-status :error
     4020       then do:
     4021         message
     4022           vss-workfile vss-revision vss-description skip
     4023           vss-include-info24 skip
     4024           "Ошибка при вызове метода prdoclib-init-prt-obj-by-date-factord" skip
     4025           "Объект" p-obj-type p-obj-code skip
     4026           "Артикул" p-artic p-prod-type p-prod-code skip
     4027           "Дата" p-fact-date skip
     4028           view-as alert-box error .
     4029         undo, return error .
     4030       end.
     4031     end.
     4032   end procedure.
     4033   procedure prdoclib-calc-temp-fact-sale :
     4034     define input  parameter p-obj-type           as character no-undo .
     4035     define input  parameter p-obj-code           as integer   no-undo .
     4036     define input  parameter p-gds-code           as integer   no-undo .
     4037     define input  parameter p-day-end-fact-order as decimal   no-undo .
     4038     define input  parameter p-curr-r-b           as character no-undo .
     4039     define output parameter p-fact-qnty          as decimal   no-undo .
     4040     define output parameter p-cur-base           as decimal   no-undo .
     4041     define output parameter p-cur-VAT-base       as decimal   no-undo .
     4042     define output parameter p-cur-SLT-base       as decimal   no-undo .
     4043     define output parameter p-cur-road-tax-base  as decimal   no-undo .
     4044     define output parameter p-cur-excise-base    as decimal   no-undo .
     4045     define buffer buf_temp-prt-obj for temp-prt-obj .
     4046     define variable v-prt-b-code        like ub.bar-code.b-code no-undo .
     4047     define variable v-cli-base-rate     like ub.bar-code.cli-base-rate no-undo .
     4048     define variable parrecid-prl        as recid     no-undo .
     4049     define variable v-fact-qnty         as decimal   no-undo .
     4050     define variable v-cur-base          as decimal   no-undo .
     4051     define variable v-cur-VAT-base      as decimal   no-undo .
     4052     define variable v-cur-SLT-base      as decimal   no-undo .
     4053     define variable v-cur-road-tax-base as decimal   no-undo .
     4054     define variable v-cur-excise-base   as decimal   no-undo .
     4055     define variable price-rubl-with-tax-sale-prl    as decimal   no-undo .
     4056     define variable price-base-with-tax-sale-prl    as decimal   no-undo .
     4057     define variable price-rubl-without-tax-sale-prl as decimal   no-undo .
     4058     define variable price-base-without-tax-sale-prl as decimal   no-undo .
     4059     define variable vat-base-sale-prl               as decimal   no-undo .
     4060     define variable vat-rubl-sale-prl               as decimal   no-undo .
     4061     define variable vat-base-buyer-prl              as decimal   no-undo .
     4062     define variable vat-rubl-buyer-prl              as decimal   no-undo .
     4063     define variable slt-base-sale-prl               as decimal   no-undo .
     4064     define variable slt-rubl-sale-prl               as decimal   no-undo .
     4065     define variable road-tax-base-sale-prl          as decimal   no-undo .
     4066     define variable road-tax-rubl-sale-prl          as decimal   no-undo .
     4067     define variable excise-base-sale-prl            as decimal   no-undo .
     4068     define variable excise-rubl-sale-prl            as decimal   no-undo .
     4069     define variable discnt-base-sale-prl            as decimal   no-undo .
     4070     define variable discnt-rubl-sale-prl            as decimal   no-undo .
     4071     do
     4072     on error undo, return error return-value
     4073     :
     4074       for each buf_temp-prt-obj no-lock
     4075       on error undo, return error return-value
     4076       :
     4077   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     4078     (input  p-gds-code
     4079     ,input  buf_temp-prt-obj.prt-code
     4080     ,output v-prt-b-code
     4081     ) no-error .
     4082         if error-status :error
     4083         then do:
     4084           message
     4085             vss-workfile vss-revision vss-description skip
     4086             "Ошибка при определении бар-кода признака" skip
     4087             "Код товара"   p-gds-code skip
     4088             "Код признака" buf_temp-prt-obj.prt-code skip
     4089             error-status :get-message(1) skip
     4090             return-value skip
     4091             view-as alert-box error .
     4092           undo, return error .
     4093         end.
     4094   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4095   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     4096     (input  p-obj-type
     4097     ,input  p-obj-code
     4098     ,input  v-prt-b-code
     4099     ,input  0
     4100     ,input  p-day-end-fact-order
     4101     ,output parrecid-prl
     4102     ,output v-cli-base-rate
     4103     ) no-error .
     4104         if error-status :error
     4105         then do:
     4106           message
     4107             vss-workfile vss-revision vss-description skip
     4108             "Ошибка при определении цены бар-кода" skip
     4109             "Объект" p-obj-type p-obj-code skip
     4110             "Бар-код" v-prt-b-code skip
     4111             "fact-order" p-day-end-fact-order skip
     4112             error-status :get-message(1) skip
     4113             return-value skip
     4114             view-as alert-box error .
     4115           undo, return error .
     4116         end.
     4117         if parrecid-prl <> ?
     4118         then do:
     4119           run prl-vat in this-procedure
     4120             (input  parrecid-prl
     4121             ,output price-rubl-with-tax-sale-prl
     4122             ,output price-base-with-tax-sale-prl
     4123             ,output price-rubl-without-tax-sale-prl
     4124             ,output price-base-without-tax-sale-prl
     4125             ,output vat-base-sale-prl
     4126             ,output vat-rubl-sale-prl
     4127             ,output vat-base-buyer-prl
     4128             ,output vat-rubl-buyer-prl
     4129             ,output slt-base-sale-prl
     4130             ,output slt-rubl-sale-prl
     4131             ,output road-tax-base-sale-prl
     4132             ,output road-tax-rubl-sale-prl
     4133             ,output excise-base-sale-prl
     4134             ,output excise-rubl-sale-prl
     4135             ,output discnt-base-sale-prl
     4136             ,output discnt-rubl-sale-prl
     4137             ) no-error .
     4138           if error-status :error
     4139           then do:
     4140             message
     4141               vss-workfile vss-revision vss-description skip
     4142               "Ошибка при вызове процеды prl-vat" skip
     4143               "Объект" p-obj-type p-obj-code skip
     4144               "Код товара" p-gds-code skip
     4145               "Указатель на запись переоценки" parrecid-prl skip
     4146               error-status :get-message(1) skip
     4147               return-value skip
     4148               view-as alert-box error .
     4149             undo, return error .
     4150           end.
     4151         end.
     4152         else do:
     4153           assign
     4154             price-rubl-with-tax-sale-prl    = 0
     4155             price-base-with-tax-sale-prl    = 0
     4156             price-rubl-without-tax-sale-prl = 0
     4157             price-base-without-tax-sale-prl = 0
     4158             vat-base-sale-prl               = 0
     4159             vat-rubl-sale-prl               = 0
     4160             slt-base-sale-prl               = 0
     4161             slt-rubl-sale-prl               = 0
     4162             road-tax-base-sale-prl          = 0
     4163             road-tax-rubl-sale-prl          = 0
     4164             excise-base-sale-prl            = 0
     4165             excise-rubl-sale-prl            = 0
     4166             discnt-base-sale-prl            = 0
     4167             discnt-rubl-sale-prl            = 0
     4168           .
     4169         end.
     4170         assign
     4171           v-fact-qnty         = v-fact-qnty
     4172                               + buf_temp-prt-obj.fact-qnty
     4173           v-cur-base          = v-cur-base
     4174                               + (if p-curr-r-b = 'base':U
     4175                                   then price-base-with-tax-sale-prl
     4176                                   else price-rubl-with-tax-sale-prl
     4177                                 )
     4178                               * buf_temp-prt-obj.fact-qnty
     4179           v-cur-VAT-base      = v-cur-VAT-base
     4180                               + (if p-curr-r-b = 'base':U
     4181                                   then vat-base-sale-prl
     4182                                   else vat-rubl-sale-prl
     4183                                 )
     4184                               * buf_temp-prt-obj.fact-qnty
     4185           v-cur-SLT-base      = v-cur-SLT-base
     4186                               + (if p-curr-r-b = 'base':U
     4187                                   then slt-base-sale-prl
     4188                                   else slt-rubl-sale-prl
     4189                                 )
     4190                               * buf_temp-prt-obj.fact-qnty
     4191           v-cur-road-tax-base = v-cur-road-tax-base
     4192                               + (if p-curr-r-b = 'base':U
     4193                                   then road-tax-base-sale-prl
     4194                                   else road-tax-rubl-sale-prl
     4195                                 )
     4196                               * buf_temp-prt-obj.fact-qnty
     4197           v-cur-excise-base   = v-cur-excise-base
     4198                               + (if p-curr-r-b = 'base':U
     4199                                   then excise-base-sale-prl
     4200                                   else excise-rubl-sale-prl
     4201                                 )
     4202                               * buf_temp-prt-obj.fact-qnty
     4203         .
     4204       end.
     4205       assign
     4206         p-fact-qnty         = v-fact-qnty
     4207         p-cur-base          = v-cur-base
     4208         p-cur-VAT-base      = v-cur-VAT-base
     4209         p-cur-SLT-base      = v-cur-SLT-base
     4210         p-cur-road-tax-base = v-cur-road-tax-base
     4211         p-cur-excise-base   = v-cur-excise-base
     4212       .
     4213     end.
     4214   end procedure.
     4215   procedure prdoclib-clear-temp-pl-gds :
     4216     define buffer buf_temp-pl-gds for temp-pl-gds .
     4217     do
     4218     on error undo, return error return-value
     4219     :
     4220       for each buf_temp-pl-gds
     4221       on error undo, return error return-value
     4222       :
     4223         delete buf_temp-pl-gds .
     4224       end.
     4225     end.
     4226   end procedure.
     4227   procedure prdoclib-init-temp-pl-gds :
     4228     define input parameter p-obj-type        like ub.pl-gds.obj-type  no-undo .
     4229     define input parameter p-obj-code        like ub.pl-gds.obj-code  no-undo .
     4230     define input parameter p-gds-code        like ub.pl-gds.gds-code  no-undo .
     4231     define buffer buf_pl-gds      for ub.pl-gds .
     4232     define buffer buf_temp-pl-gds for temp-pl-gds .
     4233     do
     4234     on error undo, return error return-value
     4235     :
     4236       run prdoclib-clear-temp-pl-gds in this-procedure .
     4237       for each buf_pl-gds
     4238         where buf_pl-gds.obj-type = p-obj-type
     4239           and buf_pl-gds.obj-code = p-obj-code
     4240           and buf_pl-gds.gds-code = p-gds-code
     4241       on error undo, return error return-value
     4242       :
     4243         create buf_temp-pl-gds .
     4244         buffer-copy buf_pl-gds to buf_temp-pl-gds .
     4245       end.
     4246     end.
     4247   end procedure.
     4248   procedure prdoclib-init-pl-gds-by-factord :
     4249     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     4250     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     4251     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     4252     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     4253     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     4254     define input parameter p-fact-order         as decimal   no-undo .
     4255     define input parameter p-include-fact-order as logical   no-undo .
     4256     define variable vss-description as character no-undo init "prdoclib-init-pl-gds-by-factord: определение остатков по признакам на любой момент времени".
     4257     define buffer buf_goods       for ub.goods .
     4258     define buffer buf_gds-obj     for ub.gds-obj .
     4259     define buffer buf_doc-line    for ub.doc-line .
     4260     define buffer buf_temp-pl-gds for temp-pl-gds .
     4261     define variable v-total-pl-gds-qnty     as decimal   no-undo .
     4262     define variable v-total-pl-gds-cli-qnty as decimal   no-undo .
     4263     do
     4264     on error undo, return error return-value
     4265     :
     4266       do transaction
     4267       on error undo, return error return-value
     4268       :
     4269   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4270   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     4271     (input  p-obj-type
     4272     ,input  p-obj-code
     4273     ,input  p-artic
     4274     ,input  p-prod-type
     4275     ,input  p-prod-code
     4276     ,buffer buf_gds-obj
     4277     ) no-error .
     4278         if error-status :error
     4279         then do:
     4280           message
     4281             vss-workfile vss-revision vss-description skip
     4282             vss-include-info24 skip
     4283             "Невозможно найти gds-obj" skip
     4284             error-status :get-message(1) skip
     4285             return-value skip
     4286             view-as alert-box error .
     4287           undo, return error return-value .
     4288         end.
     4289         find current buf_gds-obj exclusive-lock .
     4290       end.
     4291       find first buf_goods no-lock
     4292         where buf_goods.artic     = p-artic
     4293           and buf_goods.prod-type = p-prod-type
     4294           and buf_goods.prod-code = p-prod-code
     4295         .
     4296       run prdoclib-init-temp-pl-gds in this-procedure
     4297         (input p-obj-type
     4298         ,input p-obj-code
     4299         ,input buf_goods.gds-code
     4300         ) .
     4301       if p-include-fact-order = true
     4302       then do:
     4303         assign
     4304          p-fact-order = p-fact-order - 0.0000000001
     4305         .
     4306       end.
     4307       for each buf_doc-line no-lock
     4308         where buf_doc-line.obj-type   = p-obj-type
     4309           and buf_doc-line.obj-code   = p-obj-code
     4310           and buf_doc-line.artic      = p-artic
     4311           and buf_doc-line.prod-type  = p-prod-type
     4312           and buf_doc-line.prod-code  = p-prod-code
     4313           and buf_doc-line.status_    = 'факт':U
     4314           and buf_doc-line.fact-order >= p-fact-order
     4315       on error undo, return error return-value
     4316       :
     4317         run prdoclib-prc-pl-document in this-procedure
     4318           ( input  buf_doc-line.doc-code
     4319            ,input  p-obj-type
     4320            ,input  p-obj-code
     4321            ,input  buf_goods.gds-code
     4322            ,output v-total-pl-gds-qnty
     4323            ,output v-total-pl-gds-cli-qnty
     4324           ) .
     4325       end.
     4326     end.
     4327   end procedure.
     4328   define variable vss-include-info41 as character format "X(65)" no-undo
     4329   initial "@(#)$Workfile$ $Revision$".
     4330   define temp-table temp_grplib_grp no-undo
