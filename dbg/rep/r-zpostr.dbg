     3262           p-cur-VAT-base      = vat-base-sale-prl * buf_main_price-list.doc-qnty
     3263           p-cur-SLT-base      = slt-base-sale-prl * buf_main_price-list.doc-qnty
     3264           p-cur-road-tax-base = road-tax-base-sale-prl * buf_main_price-list.doc-qnty
     3265           p-cur-excise-base   = excise-base-sale-prl * buf_main_price-list.doc-qnty
     3266         .
     3267       end.
     3268       else do:
