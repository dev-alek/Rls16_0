     6887           if first-of(temp-gds.obj-code) then run PrintName ( temp-gds.obj-name, no ) .
     6888   define variable vss-include-info54 as character format "X(65)" no-undo
     6889   initial "@(#)$Workfile$ $Revision$".
     6890   if first-of(temp-gds.grp-name) then do:
     6891     assign
     6892       lvel = num-entries( right-trim(temp-gds.grp-name, chr(47)), chr(47) )
     6893     .
     6894     assign CurrGrpName = "" .
     6895     do ind = 1 to lvel :
     6896       assign CurrGrpName = CurrGrpName + entry ( ind, temp-gds.grp-name, chr(47) )  + chr(47) .
     6897       find first tt-grp-tree where tt-grp-tree.full = CurrGrpName no-error .
     6898       if not available tt-grp-tree then LEAVE.
     6899     end.
     6900     do ij = old-lvel to ind by -1 :
     6901       find first tt-grp-tree where tt-grp-tree.num = (ij + 3) .
     6902       if ij <= xvar-lavel then do:
     6903         assign ItogStr = "" .
