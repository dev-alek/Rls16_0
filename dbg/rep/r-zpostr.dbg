     6136              then do:
     6137               DISPLAY
     6138                 Counter1 @ RecordsDone
     6139                 WITH FRAME InfoFrame.
     6140              end.
     6141   End.
     6142      if v-button-stop then  DO:
     6143            if mFrameView
     6144            then
     6145               PROCESS EVENTS.
     6146            IF StopProcessing THEN DO:
     6147            RETURN error.
     6148            End.
     6149      end.
     6150     if x-date-end < today then do:
     6151       run partslib-init-temp-parts-by-factord in this-procedure( input buf_gds-obj.obj-type, input buf_gds-obj.obj-code, input buf_gds-obj.artic, input buf_gds-obj.prod-type, input buf_gds-obj.prod-code, input v-fact-order-end, input false ) .
     6152     end.
     6153     else do:
     6154       run partslib-init-temp-parts in this-procedure( input buf_gds-obj.obj-type, input buf_gds-obj.obj-code, input buf_gds-obj.artic, input buf_gds-obj.prod-type, input buf_gds-obj.prod-code ) .
     6155     end.
     6156     for each temp-parts :
