     3164           and buf_gds-obj.obj-type = buf_main_price-list.obj-type
     3165           and buf_gds-obj.obj-code = buf_main_price-list.obj-code
     3166         no-error .
     3167         if not available buf_gds-obj then do:
     3168   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3169   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     3170     (input  buf_main_price-list.obj-type
     3171     ,input  buf_main_price-list.obj-code
     3172     ,input  buf_goods.artic
     3173     ,input  buf_goods.prod-type
     3174     ,input  buf_goods.prod-code
     3175     ,buffer buf_gds-obj
     3176     ) no-error .
     3177           if error-status :error then do:
     3178              undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     3179           end.
     3180         end.
     3181       define variable price-rubl-with-tax-sale-prl    as decimal   no-undo .
     3182       define variable price-base-with-tax-sale-prl    as decimal   no-undo .
     3183       define variable price-rubl-without-tax-sale-prl as decimal   no-undo .
     3184       define variable price-base-without-tax-sale-prl as decimal   no-undo .
     3185       define variable vat-base-sale-prl               as decimal   no-undo .
     3186       define variable vat-rubl-sale-prl               as decimal   no-undo .
     3187       define variable vat-base-buyer-prl              as decimal   no-undo .
     3188       define variable vat-rubl-buyer-prl              as decimal   no-undo .
     3189       define variable slt-base-sale-prl               as decimal   no-undo .
     3190       define variable slt-rubl-sale-prl               as decimal   no-undo .
     3191       define variable road-tax-base-sale-prl          as decimal   no-undo .
     3192       define variable road-tax-rubl-sale-prl          as decimal   no-undo .
     3193       define variable excise-base-sale-prl            as decimal   no-undo .
     3194       define variable excise-rubl-sale-prl            as decimal   no-undo .
     3195       define variable discnt-base-sale-prl            as decimal   no-undo .
     3196       define variable discnt-rubl-sale-prl            as decimal   no-undo .
     3197       if buf_main_price-list.doc-qnty <> 0
     3198       then do:
     3199         run prl-vat in this-procedure
     3200           (input  recid(buf_main_price-list)
     3201           ,output price-rubl-with-tax-sale-prl
     3202           ,output price-base-with-tax-sale-prl
     3203           ,output price-rubl-without-tax-sale-prl
     3204           ,output price-base-without-tax-sale-prl
     3205           ,output vat-base-sale-prl
     3206           ,output vat-rubl-sale-prl
     3207           ,output vat-base-buyer-prl
     3208           ,output vat-rubl-buyer-prl
     3209           ,output slt-base-sale-prl
     3210           ,output slt-rubl-sale-prl
     3211           ,output road-tax-base-sale-prl
     3212           ,output road-tax-rubl-sale-prl
     3213           ,output excise-base-sale-prl
     3214           ,output excise-rubl-sale-prl
     3215           ,output discnt-base-sale-prl
     3216           ,output discnt-rubl-sale-prl
     3217           ) no-error .
     3218         if error-status :error
     3219         then do:
     3220           message
     3221             vss-workfile vss-revision vss-description skip
     3222             vss-include-info24 skip
     3223             "Ошибка при вызове процеды prl-vat" skip
     3224             "Документ" buf_main_price-list.doc-num skip
     3225             "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     3226             error-status :get-message(1) skip
     3227             return-value skip
     3228             view-as alert-box error .
     3229           undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     3230         end.
     3231       end.
     3232       else do:
     3233         assign
     3234           price-rubl-with-tax-sale-prl    = 0
     3235           price-base-with-tax-sale-prl    = 0
     3236           price-rubl-without-tax-sale-prl = 0
     3237           price-base-without-tax-sale-prl = 0
     3238           vat-base-sale-prl               = 0
     3239           vat-rubl-sale-prl               = 0
     3240           vat-base-buyer-prl              = 0
     3241           vat-rubl-buyer-prl              = 0
     3242           slt-base-sale-prl               = 0
     3243           slt-rubl-sale-prl               = 0
     3244           road-tax-base-sale-prl          = 0
     3245           road-tax-rubl-sale-prl          = 0
     3246           excise-base-sale-prl            = 0
     3247           excise-rubl-sale-prl            = 0
     3248           discnt-base-sale-prl            = 0
     3249           discnt-rubl-sale-prl            = 0
     3250         .
     3251       end.
     3252       define variable v-curr-r-b as character no-undo .
     3253   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3254   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3255     (output v-curr-r-b
     3256     )  .
     3257       if v-curr-r-b = 'base':U
     3258       then do:
     3259         assign
     3260           p-fact-qnty         = buf_main_price-list.doc-qnty
