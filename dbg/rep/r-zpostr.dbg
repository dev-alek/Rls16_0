     2120       define variable varvat-rubl-docovpprl       like ub.gds-dtl.price-base               no-undo.
     2121       define variable varvatcons-rubl-docovpprl   like ub.gds-dtl.price-base               no-undo.
     2122       define variable vardsc-rubl-docovpprl       like ub.gds-dtl.price-base               no-undo.
     2123       define variable varfact-qntyprl             like ub.parts.fact-qnty                  no-undo.
     2124       define variable varcons-qntyprl             like ub.parts.fact-qnty                  no-undo.
     2125       define variable varis-one-gds-dtlprl        as   logical                             no-undo.
     2126       define variable varcurprlprice-base         like ub.gds-dtl.cur-base                 no-undo.
     2127       define variable varcurprlprice-rubl         like ub.gds-dtl.price-base               no-undo.
     2128       define variable varcurprldiscnt-base        like ub.gds-dtl.cur-base                 no-undo.
     2129       define variable varcurprldiscnt-rubl        like ub.gds-dtl.price-base               no-undo.
     2130       define variable varoutvprbprl               as   character                           no-undo.
     2131       define variable out-vatp-have-vat-sltprl    as   logical initial yes                 no-undo.
     2132       define buffer   in-vatp-trn-docoprl  for ub.trn-doc .
     2133       define buffer   in-vatp-partsoprl    for ub.parts   .
     2134       define buffer   in-vatp-docoprl      for ub.trn-doc .
     2135       define buffer   in-vatp-goodsoprl    for ub.goods   .
     2136       define buffer   in-vatp-sysconfoprl  for ub.sysconf .
     2137       define buffer   in-vatp_doc-attroprl for ub.doc-attr.
     2138       define variable in-vatp-have-vat-sltoprl       as   logical initial yes    no-undo.
     2139       define variable vat-pc-locoprl                 like ub.doc-line.vat-pc     no-undo.
     2140       define variable varinvprboprl                  as   character              no-undo.
     2141       define variable slt-pc-locoprl                 like ub.doc-line.slt-pc     no-undo.
     2142       define variable cli-base-rateoprl              as   decimal                no-undo.
     2143       define variable price-rubl-with-tax-locoprl    like ub.doc-line.price-rubl no-undo.
     2144       define variable price-base-with-tax-locoprl    like ub.doc-line.price-base no-undo.
     2145       define variable price-cli-with-tax-locoprl     like ub.doc-line.price-cli  no-undo.
     2146       define variable price-rubl-without-tax-locoprl like ub.doc-line.price-rubl no-undo.
     2147       define variable price-base-without-tax-locoprl like ub.doc-line.price-base no-undo.
     2148       define variable price-cli-without-tax-locoprl  like ub.doc-line.price-base no-undo.
     2149       define variable vat-base-locoprl               like ub.doc-line.price-base no-undo.
     2150       define variable vat-rubl-locoprl               like ub.doc-line.price-rubl no-undo.
     2151       define variable vat-cli-locoprl                like ub.doc-line.price-rubl no-undo.
     2152       define variable slt-base-locoprl               like ub.doc-line.price-base no-undo.
     2153       define variable slt-rubl-locoprl               like ub.doc-line.price-rubl no-undo.
     2154       define variable slt-cli-locoprl                like ub.doc-line.price-rubl no-undo.
     2155       define variable road-tax-base-locoprl          like ub.doc-line.road-tax   no-undo.
     2156       define variable road-tax-rubl-locoprl          like ub.doc-line.road-tax   no-undo.
     2157       define variable road-tax-cli-locoprl           like ub.doc-line.road-tax   no-undo.
     2158       define variable transport-base-locoprl         like ub.doc-line.price-base no-undo.
     2159       define variable transport-rubl-locoprl         like ub.doc-line.price-rubl no-undo.
     2160       define variable transport-cli-locoprl          like ub.doc-line.price-rubl no-undo.
     2161       define variable other-base-locoprl             like ub.doc-line.price-base no-undo.
     2162       define variable other-rubl-locoprl             like ub.doc-line.price-rubl no-undo.
     2163       define variable other-cli-locoprl              like ub.doc-line.price-rubl no-undo.
     2164       define variable exch-rate-cli-locoprl          like ub.trn-doc.exch-rate   no-undo.
     2165       define variable varinvatp-envdoprl             as   character              no-undo.
     2166       define variable varinvatp-typeoprl             as   character              no-undo.
     2167     define buffer bf_price-list for ub.price-list.
     2168     define buffer bf_goods      for ub.goods.
     2169     define buffer bf_sysconf    for ub.sysconf.
     2170     define buffer bf_parts      for ub.parts.
     2171     define variable varbase-rate   like ub.trn-doc.base-rate     no-undo.
     2172     define variable varbase-scale  like ub.trn-doc.base-scale    no-undo.
     2173     define variable varroad-tax    like ub.price-list.road-tax   no-undo.
     2174     define variable varexcise      like ub.price-list.excise     no-undo.
     2175     define variable varvat-pc      like ub.doc-line.vat-pc       no-undo.
     2176     define variable varslt-pc      like ub.doc-line.slt-pc       no-undo.
     2177     define variable varprice-base  like ub.price-list.price-sale no-undo.
     2178     define variable varprice-rubl  like ub.price-list.price-sale no-undo.
     2179     define variable vardiscnt-base like ub.price-list.price-sale no-undo.
     2180     define variable vardiscnt-rubl like ub.price-list.price-sale no-undo.
     2181     define variable v-host-code    like ub.sysconf.host-code     no-undo.
     2182     define variable vardoc-num     like ub.price-list.doc-num    no-undo.
     2183     define variable vardoc-code    like ub.price-list.doc-num    no-undo.
     2184     define variable varobj-type    like ub.price-list.obj-type   no-undo.
     2185     define variable varobj-code    like ub.price-list.obj-code   no-undo.
     2186     define variable varartic       like ub.price-list.artic      no-undo.
     2187     define variable varprod-type   like ub.price-list.prod-type  no-undo.
     2188     define variable varprod-code   like ub.price-list.prod-code  no-undo.
     2189     define variable varfact-qnty   like ub.price-list.doc-qnty   no-undo.
     2190     define variable varcons-vat-pc like ub.doc-line.vat-pc       no-undo.
     2191     define variable varext-doc-type like ub.trn-doc.ext-doc-type no-undo.
     2192     define variable vardoc-qnty     like ub.price-list.doc-qnty no-undo.
     2193     define variable vardoc-type     as   character              no-undo.
     2194     do
     2195     on error undo, return error "Ошибка при вызове процедуры prl-vat."
     2196     :
     2197       find first bf_price-list no-lock
     2198         where recid(bf_price-list) = parrecid
     2199         no-error .
     2200       if not available bf_price-list
     2201       then do:
     2202         return error "Ошибка во входящих параметрах prl-vat.i" .
     2203       end.
     2204       find first bf_goods no-lock
     2205         where bf_goods.artic     = bf_price-list.artic
     2206           and bf_goods.prod-type = bf_price-list.prod-type
     2207           and bf_goods.prod-code = bf_price-list.prod-code
     2208         no-error .
     2209       if not available bf_goods
     2210       then do:
     2211         undo, return error substitute("Не найден товар &1 &2 &3 для переоценки с кодом &4",bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code,parrecid).
     2212       end.
     2213       assign
     2214         varvat-pc = bf_price-list.vat-pc
     2215         varslt-pc = bf_price-list.slt-pc
     2216       .
     2217       if varvat-pc = ?
     2218       then do:
     2219         undo, return error substitute("В переоценке &1 для товара &2 &3 &4 не задан НДС",bf_price-list.doc-num,bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code).
     2220       end.
     2221       if varslt-pc = ?
     2222       then do:
     2223         undo, return error substitute("В переоценке &1 для товара &2 &3 &4 не задан НП",bf_price-list.doc-num,bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code).
     2224       end.
     2225       assign
     2226         varbase-rate   = 1
     2227         varbase-scale  = 1
     2228         varroad-tax    = bf_price-list.road-tax
