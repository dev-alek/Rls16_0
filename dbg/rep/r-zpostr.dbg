     4375   define variable v-grplib-no-warning-grp-amount      as logical      no-undo.
     4376   define variable v-grplib-grp-amount-for-load        as integer      no-undo.
     4377   procedure grplib-get-parameters :
     4378   define input parameter p-store-type     as character        no-undo.
     4379   define input parameter p-store-code     as integer          no-undo.
     4380   do
     4381   on error undo, return error
     4382   :
     4383       assign
     4384           v-grplib-not-fill-extra-info = no
     4385       .
     4386   end.
     4387   end procedure.
     4388   procedure grplib-get-sort-name :
     4389   do
     4390   on error undo, return error
     4391   :
     4392   define input parameter p-node-code  as integer      no-undo.
     4393   define output parameter p-sort-name as character    no-undo.
     4394       define variable v-upper-code    as integer           no-undo.
     4395       define buffer buf_gds-grp       for ub.gds-grp.
     4396       define buffer buf_upper_gds-grp for ub.gds-grp.
     4397       find first buf_gds-grp no-lock
     4398            where buf_gds-grp.node-code = p-node-code
     4399       no-error.
     4400       if not available buf_gds-grp
     4401       then do:
     4402           undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     4403       end.
     4404       assign
     4405           p-sort-name  = ""
     4406           v-upper-code = 1
     4407       .
     4408       do while buf_gds-grp.upper-code <> 0
     4409       on error undo, return error "grplib-get-sort-name: Ошибка составления полного имени группы"
     4410       :
     4411           assign
     4412               p-sort-name  = buf_gds-grp.node-name
     4413                            + (if p-sort-name <> "" then chr(2) else "")
     4414                            + p-sort-name
     4415               v-upper-code = buf_gds-grp.upper-code
     4416           .
     4417           find first buf_gds-grp no-lock
     4418                where buf_gds-grp.node-code = v-upper-code
     4419           no-error.
     4420           if not available buf_gds-grp
     4421           then do:
     4422               undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом "
     4423                                   + string( v-upper-code )
     4424                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     4425           end.
     4426       end.
     4427   end.
     4428   end procedure.
     4429   define variable vss-include-info42 as character format "X(65)" no-undo
     4430   initial "@(#)$Workfile$ $Revision$".
     4431   procedure grplib-get-full-name :
     4432      define input parameter p-node-code  as integer      no-undo.
     4433      define output parameter p-full-name as character    no-undo.
     4434      do
     4435   on error undo, return error
     4436   :
     4437       define variable v-upper-code    as integer           no-undo.
     4438       define buffer buf_gds-grp       for ub.gds-grp.
     4439       define buffer buf_upper_gds-grp for ub.gds-grp.
     4440       find first buf_gds-grp no-lock
     4441            where buf_gds-grp.node-code = p-node-code
     4442       no-error.
     4443       if not available buf_gds-grp
     4444       then do:
     4445           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     4446       end.
     4447       assign
     4448           p-full-name  = ""
     4449           v-upper-code = 1
     4450       .
     4451       do while buf_gds-grp.upper-code <> 0
     4452       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     4453       :
     4454           assign
     4455               p-full-name  = buf_gds-grp.node-name
     4456                            + (if p-full-name <> "" then chr(47) else "")
     4457                            + p-full-name
     4458               v-upper-code = buf_gds-grp.upper-code
     4459           .
     4460           find first buf_gds-grp no-lock
     4461                where buf_gds-grp.node-code = v-upper-code
     4462           no-error.
     4463           if not available buf_gds-grp
     4464           then do:
     4465               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     4466                                   + string( v-upper-code )
     4467                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     4468           end.
     4469       end.
     4470       assign
     4471       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     4472       .
     4473   end.
     4474   end .
     4475   procedure grplib-get-node-from-full-name :
     4476   define input parameter p-full-name as character no-undo .
     4477   define output parameter p-node-code as integer no-undo .
     4478   define variable v-ii as integer no-undo .
     4479   define variable v-upper-code as integer no-undo .
     4480   define variable v-root-code as integer no-undo .
     4481   define variable v-entry as character no-undo .
     4482   define buffer buf_gds-grp       for ub.gds-grp.
     4483   do
     4484   on error undo, return error
     4485   :
     4486     find first buf_gds-grp no-lock
     4487         where buf_gds-grp.upper-code = 0
     4488     no-error .
     4489     if not available buf_gds-grp
     4490     then do:
     4491         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     4492     end.
     4493     else do:
     4494       assign
     4495       v-root-code = buf_gds-grp.node-code
     4496       .
     4497     end.
     4498     v-upper-code = v-root-code.
     4499     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     4500       assign
     4501       v-entry = entry(v-ii, p-full-name, chr(47)).
     4502       if v-entry = '' then leave.
     4503       find first buf_gds-grp no-lock where
     4504                 buf_gds-grp.node-name = v-entry
     4505             and buf_gds-grp.upper-code = v-upper-code
     4506             no-error.
     4507       if not available buf_gds-grp then do:
     4508         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     4509       end.
     4510       else do:
     4511         p-node-code = buf_gds-grp.node-code.
     4512         v-upper-code = buf_gds-grp.node-code.
     4513       end.
     4514     end.
     4515   end.
     4516   end .
     4517   procedure grplib-get-root-code :
     4518   do
     4519   on error undo, return error
     4520   :
     4521   define output parameter p-root-code as integer      no-undo.
     4522       define buffer buf_gds-grp       for ub.gds-grp.
     4523       find first buf_gds-grp no-lock
     4524           where buf_gds-grp.upper-code = 0
     4525       no-error .
     4526       if not available buf_gds-grp
     4527       then do:
     4528           undo, return error .
     4529       end.
     4530       else do:
     4531           assign
     4532               p-root-code = buf_gds-grp.node-code
     4533           .
     4534       end.
     4535   end.
     4536   end procedure.
     4537   procedure grplib-find-grp-by-full-name :
     4538   do
     4539   on error undo, return error
     4540   :
     4541   define input parameter p-search-name  as character    no-undo.
     4542   define input parameter p-fill-path    as logical      no-undo.
     4543   define output parameter p-found       as logical      no-undo.
     4544       define variable v-upper-code    as integer          no-undo.
     4545       define variable v-counter       as integer           no-undo.
     4546       define variable v-level         as integer           no-undo.
     4547       define variable v-full-name     as character         no-undo.
     4548       define variable v-sort-name     as character         no-undo.
     4549       define buffer buf_gds-grp       for ub.gds-grp.
     4550       assign
     4551           p-search-name = replace( p-search-name, chr(47), chr(2) )
     4552       .
     4553       run grplib-get-root-code ( output v-upper-code ) no-error .
     4554       if error-status :error
     4555       then do:
     4556           undo, return error "grplib-expand-name: Ошибка при поиске корневого узла".
     4557       end.
     4558       assign
     4559           v-full-name  = ""
     4560           v-level      = num-entries( p-search-name, chr(2) )
     4561       .
     4562       for each temp_grplib_found-grp
     4563       :
     4564           delete temp_grplib_found-grp.
     4565       end.
     4566       start-name-analyze:
     4567       do v-counter = 1 to v-level
     4568       :
     4569           if v-counter < v-level
     4570           then do:
     4571               find first buf_gds-grp no-lock
     4572                    where buf_gds-grp.upper-code = v-upper-code
     4573                      and buf_gds-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
     4574               no-error .
     4575               if not available buf_gds-grp
     4576               then do:
     4577                   assign
     4578                       v-full-name  = p-search-name
     4579                       v-sort-name  = p-search-name
     4580                   .
     4581                   return error "grplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
     4582               end.
     4583               else do:
     4584                   assign
     4585                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_gds-grp.node-name
     4586                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_gds-grp.node-name
     4587                       v-upper-code = buf_gds-grp.node-code
     4588                   .
     4589                   if p-fill-path = yes
     4590                   then do:
     4591                       create temp_grplib_found-grp.
     4592                       assign
     4593                           temp_grplib_found-grp.full-name = v-full-name + chr(47)
     4594                           temp_grplib_found-grp.sort-name = v-sort-name
     4595                           temp_grplib_found-grp.node-code = v-upper-code
     4596                           temp_grplib_found-grp.level     = v-counter
     4597                       .
     4598                   end.
     4599               end.
     4600           end.
     4601           else do:
     4602               for each buf_gds-grp no-lock
     4603                  where buf_gds-grp.upper-code = v-upper-code
     4604                    and buf_gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
     4605               :
     4606                   assign
     4607                       p-found = yes
     4608                   .
     4609                   create temp_grplib_found-grp.
     4610                   assign
     4611                       temp_grplib_found-grp.full-name = v-full-name
     4612                                                           + (if v-full-name = "" then "" else chr(47) )
     4613                                                           + buf_gds-grp.node-name + chr(47)
     4614                       temp_grplib_found-grp.sort-name = v-sort-name
     4615                                                           + ( if v-sort-name = "" then "" else chr(2) )
     4616                                                           + buf_gds-grp.node-name
     4617                       temp_grplib_found-grp.node-code = buf_gds-grp.node-code
     4618                       temp_grplib_found-grp.level     = v-level
     4619                   .
     4620               end.
     4621               if p-found = no
     4622               then do:
     4623                   assign
     4624                       v-full-name  = p-search-name
     4625                       v-sort-name  = p-search-name
     4626                   .
     4627                   for each temp_grplib_found-grp
     4628                   :
     4629                       delete temp_grplib_found-grp.
     4630                   end.
     4631                   assign
     4632                       p-found = no
     4633                   .
     4634               end.
     4635           end.
     4636       end.
     4637   end.
     4638   end procedure.
     4639   procedure grplib-find-all-subgroup :
     4640   do
     4641   on error undo, return error
     4642   :
     4643   define input parameter p-start-node-code    as integer      no-undo.
     4644   define input parameter p-terminal-only      as logical      no-undo.
     4645       define variable v-start-full-name   as character     no-undo.
     4646       define variable v-start-sort-name   as character     no-undo.
     4647       define variable v-not-found         as logical       no-undo.
     4648       define variable v-is-terminal       as logical       no-undo.
     4649       define buffer buf_gds-grp           for ub.gds-grp.
     4650       create temp_found-result-nodelist.
     4651       assign
     4652           temp_found-result-nodelist.node-code = p-start-node-code
     4653           temp_found-result-nodelist.processed = no
     4654       .
     4655       run grplib-get-full-name in this-procedure (
     4656             input p-start-node-code
     4657           , output v-start-full-name
     4658       ).
     4659       run grplib-get-full-name in this-procedure (
     4660             input p-start-node-code
     4661           , output v-start-sort-name
     4662       ).
     4663       process-nodes:
     4664       do while yes
     4665       :
     4666           find first temp_found-result-nodelist
     4667                where temp_found-result-nodelist.node-code = p-start-node-code
     4668           .
     4669           assign
     4670               temp_found-result-nodelist.processed = yes
     4671           .
     4672           for each buf_gds-grp no-lock
     4673              where buf_gds-grp.upper-code = p-start-node-code
     4674           on error undo, return error
     4675           :
     4676               run grplib-is-terminal in this-procedure (
     4677                     input buf_gds-grp.node-code
     4678                   , output v-is-terminal
     4679               ).
     4680               if v-is-terminal = yes
     4681               then do:
     4682                   create temp_grplib_found-grp.
     4683                   assign
     4684                       temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     4685                                                           chr(47) + buf_gds-grp.node-name + chr(47)
     4686                       temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     4687                                                           chr(2) + buf_gds-grp.node-name + chr(2)
     4688                       temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
     4689                       temp_grplib_found-grp.is-terminal = yes
     4690                   .
     4691               end.
     4692               else do:
     4693                   create temp_found-result-nodelist.
     4694                   assign
     4695                       temp_found-result-nodelist.node-code = buf_gds-grp.node-code
     4696                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
     4697                                                              chr(47) + buf_gds-grp.node-name + chr(47)
     4698                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
     4699                                                              chr(2) + buf_gds-grp.node-name + chr(2)
     4700                       temp_found-result-nodelist.processed = no
     4701                   .
     4702                   if p-terminal-only = no
     4703                   then do:
     4704                       create temp_grplib_found-grp.
     4705                       assign
     4706                           temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     4707                                                               chr(47) + buf_gds-grp.node-name + chr(47)
     4708                           temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     4709                                                               chr(2) + buf_gds-grp.node-name + chr(2)
     4710                           temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
     4711                           temp_grplib_found-grp.is-terminal = no
     4712                       .
     4713                   end.
     4714               end.
     4715           end.
     4716           find first temp_found-result-nodelist
     4717                where temp_found-result-nodelist.processed = no
     4718           no-error.
     4719           if not available temp_found-result-nodelist
     4720           then do:
     4721               leave process-nodes.
     4722           end.
     4723           else do:
     4724               assign
     4725                   p-start-node-code = temp_found-result-nodelist.node-code
     4726                   v-start-full-name = temp_found-result-nodelist.full-name
     4727                   v-start-sort-name = temp_found-result-nodelist.sort-name
     4728               .
     4729           end.
     4730       end.
     4731   end.
     4732   end procedure.
     4733   procedure grplib-expand-name :
     4734   define input parameter p-start-name as character        no-undo.
     4735   define output parameter p-end-name  as character        no-undo.
     4736       define variable v-is-terminal   as logical      no-undo.
     4737       define variable v-found         as character    no-undo.
     4738       define buffer buf_temp_grplib_found-grp     for temp_grplib_found-grp.
     4739   do
     4740   for buf_temp_grplib_found-grp
     4741   on error undo, return error
     4742   :
     4743       run grplib-find-grp-by-full-name in this-procedure (
     4744             input p-start-name
     4745           , input no
     4746           , output v-found
     4747       ) no-error.
     4748       run grplib-get-max-substring in this-procedure (
     4749                   input length( p-start-name )
     4750                 , output p-end-name
     4751       ) no-error .
     4752       if error-status :error
     4753       then do:
     4754           assign
     4755               p-end-name = ""
     4756           .
     4757       end.
     4758       else do:
     4759           find first temp_grplib_found-grp
     4760               where temp_grplib_found-grp.full-name = p-end-name
     4761           no-error.
     4762           if available temp_grplib_found-grp
     4763           then do:
     4764               find first buf_temp_grplib_found-grp
     4765                   where buf_temp_grplib_found-grp.full-name begins p-end-name
     4766                   and recid( buf_temp_grplib_found-grp ) <> recid( temp_grplib_found-grp )
     4767               no-error.
     4768               if not available buf_temp_grplib_found-grp
     4769               then do:
     4770                   run grplib-is-terminal in this-procedure (
     4771                       input temp_grplib_found-grp.node-code
     4772                       , output v-is-terminal
     4773                   ).
     4774               end.
     4775           end.
     4776       end.
     4777   end.
     4778   end procedure.
     4779   procedure grplib-get-max-substring :
     4780   do
     4781   on error undo, return error
     4782   :
     4783   define input parameter p-min-substring-length   as integer      no-undo.
     4784   define output parameter p-substring             as character    no-undo.
     4785           define variable v-char-counter  as integer           no-undo.
     4786           define variable v-current-char  as character         no-undo.
     4787           define variable v-names-counter  as integer           no-undo.
     4788           define variable v-base-string   as character         no-undo.
     4789           assign
     4790               v-char-counter  = p-min-substring-length
     4791           .
     4792           find first temp_grplib_found-grp no-error.
     4793           if not available temp_grplib_found-grp
     4794           then do:
     4795               undo, return error "grplib-get-max-substring: Нет строк для вычисления общей подстроки".
     4796           end.
     4797           else do:
     4798               assign
     4799                   v-base-string  = temp_grplib_found-grp.full-name
     4800                   v-char-counter = 0
     4801               .
     4802               counter-block:
     4803               do while yes
     4804               on error undo, return error "grplib-get-max-substring: Ошибка вычисления продолжения имени группы."
     4805               :
     4806                   assign
     4807                       v-char-counter  = v-char-counter + 1
     4808                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
     4809                       v-names-counter = 0
     4810                   .
     4811                   compare-block:
     4812                   for each temp_grplib_found-grp
     4813                   :
     4814                       assign
     4815                           v-names-counter = v-names-counter + 1
     4816                       .
     4817                       if v-names-counter = 1
     4818                       then do:
     4819                           next compare-block.
     4820                       end.
     4821                       if substring( temp_grplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
     4822                       then do:
     4823                           leave counter-block.
     4824                       end.
     4825                   end.
     4826                   if v-names-counter = 1
     4827                   then do:
     4828                       assign
     4829                           p-substring = v-base-string
     4830                       .
     4831                       return.
     4832                   end.
     4833               end.
     4834               assign
     4835                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
     4836               .
     4837           end.
     4838   end.
     4839   end procedure.
     4840   procedure grplib-is-terminal :
     4841   do
     4842   on error undo, return error "Ошибка процедуры grplib-is-terminal"
     4843   :
     4844   define input parameter p-node-code      as integer      no-undo.
     4845   define output parameter p-is-terminal   as logical      no-undo.
     4846       define buffer buf_gds-grp       for ub.gds-grp.
     4847       find first buf_gds-grp no-lock
     4848           where buf_gds-grp.upper-code = p-node-code
     4849       no-error .
     4850       if not available buf_gds-grp
     4851       then do:
     4852           assign
     4853               p-is-terminal = yes
     4854           .
     4855       end.
     4856       else do:
     4857           assign
     4858               p-is-terminal = no
     4859           .
     4860       end.
     4861   end.
     4862   end procedure.
     4863   procedure grplib-have-goods :
     4864   do
     4865   on error undo, return error
     4866   :
     4867   define input parameter p-node-code      as integer      no-undo.
     4868   define output parameter p-have-goods   as logical      no-undo.
     4869       define buffer buf_goods         for ub.goods.
     4870       find first buf_goods no-lock
     4871            where buf_goods.grp-code = p-node-code
     4872       no-error .
     4873       if available buf_goods
     4874       then do:
     4875           assign
     4876               p-have-goods = yes
     4877           .
     4878       end.
     4879       else do:
     4880           assign
     4881               p-have-goods = no
     4882           .
     4883       end.
     4884   end.
     4885   end procedure.
     4886   procedure grplib-find-by-substring :
     4887   do
     4888   on error undo, return error
     4889   :
     4890   define input parameter p-start-code         as integer      no-undo.
     4891   define input parameter p-full-search-string as character    no-undo.
     4892   define output parameter p-found-code        as integer      no-undo.
     4893   define output parameter p-full-name         as character    no-undo.
     4894       define variable v-start-code     as integer           no-undo.
     4895       define variable v-found          as logical  init no  no-undo.
     4896       define buffer buf_gds-grp       for ub.gds-grp.
     4897       search-grp:
     4898       for each buf_gds-grp no-lock
     4899           where buf_gds-grp.node-code > p-start-code
     4900       :
     4901           if index( buf_gds-grp.node-name, p-full-search-string ) <> 0
     4902           then do:
     4903               assign
     4904                   p-found-code = buf_gds-grp.node-code
     4905                   v-found      = yes
     4906               .
     4907               run grplib-get-full-name in this-procedure (
     4908                     input p-found-code
     4909                   , output p-full-name
     4910               ) no-error .
     4911               if error-status :error
     4912               then do:
     4913                   undo, return error "grplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
     4914               end.
     4915               leave search-grp.
     4916           end.
     4917       end.
     4918       if v-found = yes
     4919       then do:
     4920       end.
     4921       else do:
     4922           assign
     4923               p-full-name  = ""
     4924               p-found-code = 0
     4925           .
     4926       end.
     4927   end.
     4928   end procedure.
     4929   procedure grplib-analyze-grp-name :
     4930   do
     4931   on error undo, return error
     4932   :
     4933   define input parameter p-grp-name       as character            no-undo.
     4934   define input parameter p-upper-code     as integer              no-undo.
     4935   define output parameter p-error-message as character init ""    no-undo.
     4936       define variable v-char-list     as character    no-undo.
     4937       define variable v-char-counter  as integer      no-undo.
     4938       define variable v-full-name     as character    no-undo.
     4939       if p-grp-name = "" then do:
     4940           assign
     4941               p-error-message = "Название группы не может быть пустым.".
     4942           .
     4943       end.
     4944       else do:
     4945           assign
     4946               v-char-list = "47,92,58,63,34,60,62,171,187,183"
     4947           .
     4948           do v-char-counter = 1 to num-entries( v-char-list )
     4949           :
     4950               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
     4951               then do:
     4952                   assign
     4953                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
     4954                   .
     4955                   return.
     4956               end.
     4957           end.
     4958           if p-upper-code > 0
     4959           then do:
     4960               run grplib-get-full-name in this-procedure (
     4961                     input p-upper-code
     4962                   , output v-full-name
     4963               ) no-error .
     4964               if error-status :error
     4965               then do:
     4966                   undo, return error "grplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
     4967               end.
     4968               if length( v-full-name ) + 1 + length( p-grp-name ) > 350
     4969               then do:
     4970                   assign
     4971                       p-error-message = 'Полное название группы не может содержать более 350 символов.'
     4972                   .
     4973               end.
     4974           end.
     4975       end.
     4976   end.
     4977   end procedure.
     4978   procedure grplib-get-lvl-num :
     4979   define input parameter p-node-code  as integer      no-undo.
     4980   define output parameter p-lvl-num   as integer      no-undo.
     4981       define variable v-full-name    as character    no-undo.
     4982   do
     4983   on error undo, return error
     4984   :
     4985       run grplib-get-full-name in this-procedure (
     4986             input p-node-code
     4987           , output v-full-name
     4988       ).
     4989       assign
     4990           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
     4991       .
     4992       if p-lvl-num = -1
     4993       then do:
     4994           assign
     4995               p-lvl-num = 0
     4996           .
     4997       end.
     4998   end.
     4999   end procedure.
     5000   define variable vss-include-info43 as character format "X(65)" no-undo
     5001   initial "@(#)$Workfile$ $Revision$".
     5002   define temp-table temp_cgrplib_grp no-undo
     5003       field sel           as character
     5004       field full-name     as character
     5005       field sort-name     as character
     5006       field node-code     as integer
     5007       field upper-code    as integer
     5008       field d-pcnt        as decimal
     5009       field name          as character
     5010       field level         as integer
     5011       field mark          as character
     5012       index pi is primary unique sort-name
     5013       index fn full-name
     5014       index nc is unique node-code
     5015       index sl sel
     5016       index uc upper-code
     5017   .
     5018   define temp-table temp_cgrplib_found-grp no-undo
     5019       field full-name   as character
     5020       field sort-name   as character
     5021       field node-code   as integer
     5022       field level       as integer
     5023       field is-terminal as logical
     5024       field d-pcnt      as decimal
     5025       index pi is primary unique sort-name
     5026       index fn full-name
     5027       index lv level
     5028       index it is-terminal
     5029   .
     5030   define temp-table temp_cfound-result-nodelist no-undo
     5031       field node-code     as recid
     5032       field processed     as logical
     5033       field full-name     as character
     5034       field sort-name     as character
     5035       index pi is primary unique node-code
     5036       index ps processed
     5037   .
     5038   procedure cli-grplib-get-sort-name :
     5039   do
     5040   on error undo, return error
     5041   :
     5042   define input parameter p-node-code  as integer      no-undo.
     5043   define output parameter p-sort-name as character    no-undo.
     5044       define variable v-upper-code    as integer           no-undo.
     5045       define buffer buf_cli-grp       for ub.cli-grp.
     5046       define buffer buf_upper_cli-grp for ub.cli-grp.
     5047       find first buf_cli-grp no-lock
     5048            where buf_cli-grp.node-code = p-node-code
     5049       no-error.
     5050       if not available buf_cli-grp
     5051       then do:
     5052           undo, return error "cli-grplib-get-sort-name: Не найдена группа клиентов с кодом " + string( p-node-code ).
     5053       end.
     5054       assign
     5055           p-sort-name  = ""
     5056           v-upper-code = 1
     5057       .
     5058       do while buf_cli-grp.upper-code <> 0
     5059       on error undo, return error "cli-grplib-get-sort-name: Ошибка составления полного имени группы"
     5060       :
     5061           assign
     5062               p-sort-name  = buf_cli-grp.node-name
     5063                            + (if p-sort-name <> "" then chr(2) else "")
     5064                            + p-sort-name
     5065               v-upper-code = buf_cli-grp.upper-code
     5066           .
     5067           find first buf_cli-grp no-lock
     5068                where buf_cli-grp.node-code = v-upper-code
     5069           no-error.
     5070           if not available buf_cli-grp
     5071           then do:
     5072               undo, return error "cli-grplib-get-sort-name: Не найдена группа клиентов с кодом "
     5073                                   + string( v-upper-code )
     5074                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     5075           end.
     5076       end.
     5077   end.
     5078   end procedure.
     5079   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5080   procedure cli-grplib-get-full-name :
     5081      define input parameter  p-node-code  as integer      no-undo.
     5082      define output parameter p-full-name as character    no-undo.
     5083   do
     5084   on error undo, return error
     5085   :
     5086       define variable v-upper-code    as integer           no-undo.
     5087       define buffer buf_cli-grp       for ub.cli-grp.
     5088       define buffer buf_upper_cli-grp for ub.cli-grp.
     5089       find first buf_cli-grp no-lock
     5090            where buf_cli-grp.node-code = p-node-code
     5091       no-error.
     5092       if not available buf_cli-grp
     5093       then do:
     5094           undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом " + string( p-node-code ).
     5095       end.
     5096       assign
     5097           p-full-name  = ""
     5098           v-upper-code = 1
     5099       .
     5100       do while buf_cli-grp.upper-code <> 0
     5101       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     5102       :
     5103           assign
     5104               p-full-name  = buf_cli-grp.node-name
     5105                            + (if p-full-name <> "" then chr(47) else "")
     5106                            + p-full-name
     5107               v-upper-code = buf_cli-grp.upper-code
     5108           .
     5109           find first buf_cli-grp no-lock
     5110                where buf_cli-grp.node-code = v-upper-code
     5111           no-error.
     5112           if not available buf_cli-grp
     5113           then do:
     5114               undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом "
     5115                                   + string( v-upper-code )
     5116                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     5117           end.
     5118       end.
     5119       assign
     5120       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     5121       .
     5122   end.
     5123   end .
     5124   procedure cgrplib-get-node-from-full-name :
     5125   define input parameter p-full-name as character no-undo .
     5126   define output parameter p-node-code as integer no-undo .
     5127   define variable v-ii as integer no-undo .
     5128   define variable v-upper-code as integer no-undo .
     5129   define variable v-root-code as integer no-undo .
     5130   define variable v-entry as character no-undo .
     5131   define buffer buf_cli-grp       for ub.cli-grp.
     5132   do
     5133   on error undo, return error
     5134   :
     5135     find first buf_cli-grp no-lock
     5136         where buf_cli-grp.upper-code = 0
     5137     no-error .
     5138     if not available buf_cli-grp
     5139     then do:
     5140         undo, return error substitute("Не найдена корневая группа клиентов (upper-code = 0)").
     5141     end.
     5142     else do:
     5143       assign
     5144       v-root-code = buf_cli-grp.node-code
     5145       .
     5146     end.
     5147     v-upper-code = v-root-code.
     5148     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     5149       assign
     5150       v-entry = entry(v-ii, p-full-name, chr(47)).
     5151       if v-entry = '' then leave.
     5152       find first buf_cli-grp no-lock where
     5153                 buf_cli-grp.node-name = v-entry
     5154             and buf_cli-grp.upper-code = v-upper-code
     5155             no-error.
     5156       if not available buf_cli-grp then do:
     5157         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     5158       end.
     5159       else do:
     5160         p-node-code = buf_cli-grp.node-code.
     5161         v-upper-code = buf_cli-grp.node-code.
     5162       end.
     5163     end.
     5164   end.
     5165   end .
     5166   procedure cgrplib-get-root-code :
     5167   do
     5168   on error undo, return error
     5169   :
     5170   define output parameter p-root-code as integer      no-undo.
     5171       define buffer buf_cli-grp       for ub.cli-grp.
     5172       find first buf_cli-grp no-lock
     5173           where buf_cli-grp.upper-code = 0
     5174       no-error .
     5175       if not available buf_cli-grp
     5176       then do:
     5177           undo, return error .
     5178       end.
     5179       else do:
     5180           assign
     5181               p-root-code = buf_cli-grp.node-code
     5182           .
     5183       end.
     5184   end.
     5185   end procedure.
     5186   procedure cgrplib-find-grp-by-full-name :
     5187   do
     5188   on error undo, return error
     5189   :
     5190   define input parameter p-search-name  as character    no-undo.
     5191   define input parameter p-fill-path    as logical      no-undo.
     5192       define variable v-upper-code    as integer          no-undo.
     5193       define variable v-not-found     as logical init yes no-undo.
     5194       define variable v-counter       as integer           no-undo.
     5195       define variable v-level         as integer           no-undo.
     5196       define variable v-full-name     as character         no-undo.
     5197       define variable v-sort-name     as character         no-undo.
     5198       define buffer buf_cli-grp       for ub.cli-grp.
     5199       assign
     5200           p-search-name = replace( p-search-name, chr(47), chr(2) )
     5201       .
     5202       run cgrplib-get-root-code ( output v-upper-code ) no-error .
     5203       if error-status :error
     5204       then do:
     5205           undo, return error "cgrplib-expand-name: Ошибка при поиске корневого узла".
     5206       end.
     5207       assign
     5208           v-full-name  = ""
     5209           v-level      = num-entries( p-search-name, chr(2) )
     5210       .
     5211       for each temp_cgrplib_found-grp
     5212       :
     5213           delete temp_cgrplib_found-grp.
     5214       end.
     5215       start-name-analyze:
     5216       do v-counter = 1 to v-level
     5217       :
     5218           if v-counter < v-level
     5219           then do:
     5220               find first buf_cli-grp no-lock
     5221                    where buf_cli-grp.upper-code = v-upper-code
     5222                      and buf_cli-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
     5223               no-error .
     5224               if not available buf_cli-grp
     5225               then do:
     5226                   assign
     5227                       v-full-name  = p-search-name
     5228                       v-sort-name  = p-search-name
     5229                   .
     5230                   return error "cgrplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
     5231               end.
     5232               else do:
     5233                   assign
     5234                       v-full-name = v-full-name + (if v-full-name = "" then "" else chr(47) )         + buf_cli-grp.node-name
     5235                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_cli-grp.node-name
     5236                       v-upper-code = buf_cli-grp.node-code
     5237                   .
     5238                   if p-fill-path = yes
     5239                   then do:
     5240                       create temp_cgrplib_found-grp.
     5241                       assign
     5242                           temp_cgrplib_found-grp.full-name = v-full-name + chr(47)
     5243                           temp_cgrplib_found-grp.sort-name = v-sort-name
     5244                           temp_cgrplib_found-grp.node-code = v-upper-code
     5245                           temp_cgrplib_found-grp.level     = v-counter
     5246                       .
     5247                   end.
     5248               end.
     5249           end.
     5250           else do:
     5251               for each buf_cli-grp no-lock
     5252                  where buf_cli-grp.upper-code = v-upper-code
     5253                    and buf_cli-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
     5254               :
     5255                   assign
     5256                       v-not-found = no
     5257                   .
     5258                   create temp_cgrplib_found-grp.
     5259                   assign
     5260                       temp_cgrplib_found-grp.full-name = v-full-name
     5261                                                           + ( if v-full-name = "" then "" else chr(47) )
     5262                                                           + buf_cli-grp.node-name + chr(47)
     5263                       temp_cgrplib_found-grp.sort-name = v-sort-name
     5264                                                           + ( if v-sort-name = "" then "" else chr(2) )
     5265                                                           + buf_cli-grp.node-name
     5266                       temp_cgrplib_found-grp.node-code = buf_cli-grp.node-code
     5267                       temp_cgrplib_found-grp.level     = v-level
     5268                   .
     5269               end.
     5270               if v-not-found = yes
     5271               then do:
     5272                   assign
     5273                       v-full-name  = p-search-name
     5274                       v-sort-name  = p-search-name
     5275                   .
     5276                   for each temp_cgrplib_found-grp
     5277                   :
     5278                       delete temp_cgrplib_found-grp.
     5279                   end.
     5280                   return error "cgrplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
     5281               end.
     5282           end.
     5283       end.
     5284   end.
     5285   end procedure.
     5286   procedure cgrplib-find-all-subgroup :
     5287   do
     5288   on error undo, return error
     5289   :
     5290   define input parameter p-start-node-code    as integer      no-undo.
     5291   define input parameter p-terminal-only      as logical      no-undo.
     5292       define variable v-start-full-name   as character     no-undo.
     5293       define variable v-start-sort-name   as character     no-undo.
     5294       define variable v-not-found         as logical       no-undo.
     5295       define variable v-is-terminal       as logical       no-undo.
     5296       define variable v-d-pcnt            as decimal       no-undo.
     5297       define buffer buf_cli-grp           for ub.cli-grp.
     5298       create temp_cfound-result-nodelist.
     5299       assign
     5300           temp_cfound-result-nodelist.node-code = p-start-node-code
     5301           temp_cfound-result-nodelist.processed = no
     5302       .
     5303       run cli-grplib-get-full-name in this-procedure (
     5304             input p-start-node-code
     5305           , output v-start-full-name
     5306       ).
     5307       run cli-grplib-get-sort-name in this-procedure (
     5308             input p-start-node-code
     5309           , output v-start-sort-name
     5310       ).
     5311       process-nodes:
     5312       do while yes
     5313       :
     5314           find first temp_cfound-result-nodelist
     5315                where temp_cfound-result-nodelist.node-code = p-start-node-code
     5316           .
     5317           assign
     5318               temp_cfound-result-nodelist.processed = yes
     5319           .
     5320           for each buf_cli-grp no-lock
     5321              where buf_cli-grp.upper-code = p-start-node-code
     5322           on error undo, return error
     5323           :
     5324               run cgrplib-is-terminal in this-procedure (
     5325                     input buf_cli-grp.node-code
     5326                   , output v-is-terminal
     5327               ).
     5328               if v-is-terminal = yes
     5329               then do:
     5330                   create temp_cgrplib_found-grp.
     5331                   assign
     5332                       temp_cgrplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     5333                                                           chr(47) + buf_cli-grp.node-name + chr(47)
     5334                       temp_cgrplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     5335                                                           chr(2) + buf_cli-grp.node-name + chr(2)
     5336                       temp_cgrplib_found-grp.node-code   = buf_cli-grp.node-code
     5337                       temp_cgrplib_found-grp.is-terminal = yes
     5338                   .
     5339                  run cgrplib-get-pcnt-value in this-procedure ( input temp_cgrplib_found-grp.node-code , output v-d-pcnt) no-error .
     5340                  if not error-status:error then do:
     5341                    temp_cgrplib_found-grp.d-pcnt = v-d-pcnt.
     5342                  end.
     5343                  else do:
     5344                    temp_cgrplib_found-grp.d-pcnt = ?.
     5345                  end.
     5346               end.
     5347               else do:
     5348                   create temp_cfound-result-nodelist.
     5349                   assign
     5350                       temp_cfound-result-nodelist.node-code = buf_cli-grp.node-code
     5351                       temp_cfound-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
     5352                                                              chr(47) + buf_cli-grp.node-name + chr(47)
     5353                       temp_cfound-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
     5354                                                              chr(2) + buf_cli-grp.node-name + chr(2)
     5355                       temp_cfound-result-nodelist.processed = no
     5356                   .
     5357                   if p-terminal-only = no
     5358                   then do:
     5359                       create temp_cgrplib_found-grp.
     5360                       assign
     5361                           temp_cgrplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     5362                                                               chr(47) + buf_cli-grp.node-name + chr(47)
     5363                           temp_cgrplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     5364                                                               chr(2) + buf_cli-grp.node-name + chr(2)
     5365                           temp_cgrplib_found-grp.node-code   = buf_cli-grp.node-code
     5366                           temp_cgrplib_found-grp.is-terminal = no
     5367                       .
     5368                   end.
     5369               end.
     5370           end.
     5371           find first temp_cfound-result-nodelist
     5372                where temp_cfound-result-nodelist.processed = no
     5373           no-error.
     5374           if not available temp_cfound-result-nodelist
     5375           then do:
     5376               leave process-nodes.
     5377           end.
     5378           else do:
     5379               assign
     5380                   p-start-node-code = temp_cfound-result-nodelist.node-code
     5381                   v-start-full-name = temp_cfound-result-nodelist.full-name
     5382                   v-start-sort-name = temp_cfound-result-nodelist.sort-name
     5383               .
     5384           end.
     5385       end.
     5386   end.
     5387   end procedure.
     5388   procedure cgrplib-expand-name :
     5389   do
     5390   on error undo, return error
     5391   :
     5392   define input parameter p-start-name as character        no-undo.
     5393   define output parameter p-end-name  as character        no-undo.
     5394       define variable v-is-terminal     as logical           no-undo.
     5395       define buffer buf_temp_cgrplib_found-grp     for temp_cgrplib_found-grp.
     5396       run cgrplib-find-grp-by-full-name in this-procedure (
     5397             input p-start-name
     5398           , input no
     5399       ) no-error.
     5400       run cgrplib-get-max-substring in this-procedure (
     5401                   input length( p-start-name )
     5402                 , output p-end-name
     5403       ) no-error .
     5404       if error-status :error
     5405       then do:
     5406           assign
     5407               p-end-name = ""
     5408           .
     5409       end.
     5410       else do:
     5411           find first temp_cgrplib_found-grp
     5412               where temp_cgrplib_found-grp.full-name = p-end-name
     5413           no-error.
     5414           if available temp_cgrplib_found-grp
     5415           then do:
     5416               find first buf_temp_cgrplib_found-grp
     5417                   where buf_temp_cgrplib_found-grp.full-name begins p-end-name
     5418                   and recid( buf_temp_cgrplib_found-grp ) <> recid( temp_cgrplib_found-grp )
     5419               no-error.
     5420               if not available buf_temp_cgrplib_found-grp
     5421               then do:
     5422                   run cgrplib-is-terminal in this-procedure (
     5423                       input temp_cgrplib_found-grp.node-code
     5424                       , output v-is-terminal
     5425                   ).
     5426               end.
     5427           end.
     5428       end.
     5429   end.
     5430   end procedure.
     5431   procedure cgrplib-get-max-substring :
     5432   do
     5433   on error undo, return error
     5434   :
     5435   define input parameter p-min-substring-length   as integer      no-undo.
     5436   define output parameter p-substring             as character    no-undo.
     5437           define variable v-char-counter  as integer           no-undo.
     5438           define variable v-current-char  as character         no-undo.
     5439           define variable v-names-counter  as integer           no-undo.
     5440           define variable v-base-string   as character         no-undo.
     5441           assign
     5442               v-char-counter  = p-min-substring-length
     5443           .
     5444           find first temp_cgrplib_found-grp no-error.
     5445           if not available temp_cgrplib_found-grp
     5446           then do:
     5447               undo, return error "cgrplib-get-max-substring: Нет строк для вычисления общей подстроки".
     5448           end.
     5449           else do:
     5450               assign
     5451                   v-base-string = temp_cgrplib_found-grp.full-name
     5452               .
     5453               counter-block:
     5454               do while yes
     5455               on error undo, return error "cgrplib-get-max-substring: Ошибка вычисления продолжения имени группы."
     5456               :
     5457                   assign
     5458                       v-char-counter  = v-char-counter + 1
     5459                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
     5460                       v-names-counter = 0
     5461                   .
     5462                   compare-block:
     5463                   for each temp_cgrplib_found-grp
     5464                   :
     5465                       assign
     5466                           v-names-counter = v-names-counter + 1
     5467                       .
     5468                       if v-names-counter = 1
     5469                       then do:
     5470                           next compare-block.
     5471                       end.
     5472                       if substring( temp_cgrplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
     5473                       then do:
     5474                           leave counter-block.
     5475                       end.
     5476                   end.
     5477                   if v-names-counter = 1
     5478                   then do:
     5479                       assign
     5480                           p-substring = v-base-string
     5481                       .
     5482                       return.
     5483                   end.
     5484               end.
     5485               assign
     5486                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
     5487               .
     5488           end.
     5489   end.
     5490   end procedure.
     5491   procedure cgrplib-is-terminal :
     5492   do
     5493   on error undo, return error "Ошибка процедуры cgrplib-is-terminal"
     5494   :
     5495   define input parameter p-node-code      as integer      no-undo.
     5496   define output parameter p-is-terminal   as logical      no-undo.
     5497       define buffer buf_cli-grp       for ub.cli-grp.
     5498       find first buf_cli-grp no-lock
     5499           where buf_cli-grp.upper-code = p-node-code
     5500       no-error .
     5501       if not available buf_cli-grp
     5502       then do:
     5503           assign
     5504               p-is-terminal = yes
     5505           .
     5506       end.
     5507       else do:
     5508           assign
     5509               p-is-terminal = no
     5510           .
     5511       end.
     5512   end.
     5513   end procedure.
     5514   procedure cgrplib-have-clients :
     5515   do
     5516   on error undo, return error
     5517   :
     5518   define input parameter p-node-code      as integer      no-undo.
     5519   define output parameter p-have-clients   as logical      no-undo.
     5520       define buffer buf_clients         for ub.clients.
     5521       find first buf_clients no-lock
     5522            where buf_clients.grp-code = p-node-code
     5523       no-error .
     5524       if available buf_clients
     5525       then do:
     5526           assign
     5527               p-have-clients = yes
     5528           .
     5529       end.
     5530       else do:
     5531           assign
     5532               p-have-clients = no
     5533           .
     5534       end.
     5535   end.
     5536   end procedure.
     5537   procedure cgrplib-find-by-substring :
     5538   do
     5539   on error undo, return error
     5540   :
     5541   define input parameter p-start-code         as integer      no-undo.
     5542   define input parameter p-full-search-string as character    no-undo.
     5543   define output parameter p-found-code        as integer      no-undo.
     5544   define output parameter p-full-name         as character    no-undo.
     5545       define variable v-start-code     as integer           no-undo.
     5546       define variable v-found          as logical  init no  no-undo.
     5547       define buffer buf_cli-grp       for ub.cli-grp.
     5548       search-grp:
     5549       for each buf_cli-grp no-lock
     5550           where buf_cli-grp.node-code > p-start-code
     5551       :
     5552           if index( buf_cli-grp.node-name, p-full-search-string ) <> 0
     5553           then do:
     5554               assign
     5555                   p-found-code = buf_cli-grp.node-code
     5556                   v-found      = yes
     5557               .
     5558               run cli-grplib-get-full-name in this-procedure (
     5559                     input p-found-code
     5560                   , output p-full-name
     5561               ) no-error .
     5562               if error-status :error
     5563               then do:
     5564                   undo, return error "cgrplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
     5565               end.
     5566               leave search-grp.
     5567           end.
     5568       end.
     5569       if v-found = yes
     5570       then do:
     5571       end.
     5572       else do:
     5573           assign
     5574               p-full-name  = ""
     5575               p-found-code = 0
     5576           .
     5577       end.
     5578   end.
     5579   end procedure.
     5580   procedure cgrplib-analyze-grp-name :
     5581   do
     5582   on error undo, return error
     5583   :
     5584   define input parameter p-grp-name       as character            no-undo.
     5585   define input parameter p-upper-code     as integer              no-undo.
     5586   define output parameter p-error-message as character init ""    no-undo.
     5587       define variable v-char-list     as character    no-undo.
     5588       define variable v-char-counter  as integer      no-undo.
     5589       define variable v-full-name     as character    no-undo.
     5590       if p-grp-name = "" then do:
     5591           assign
     5592               p-error-message = "Название группы не может быть пустым.".
     5593           .
     5594       end.
     5595       else do:
     5596           assign
     5597               v-char-list = "47,92,58,63,34,60,62,171,187,183"
     5598           .
     5599           do v-char-counter = 1 to num-entries( v-char-list )
     5600           :
     5601               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
     5602               then do:
     5603                   assign
     5604                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
     5605                   .
     5606                   return.
     5607               end.
     5608           end.
     5609           run cli-grplib-get-full-name in this-procedure (
     5610                 input p-upper-code
     5611               , output v-full-name
     5612           ) no-error .
     5613           if error-status :error
     5614           then do:
     5615               undo, return error "cgrplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
     5616           end.
     5617           if length( v-full-name ) + 1 + length( p-grp-name ) > 120
     5618           then do:
     5619               assign
     5620                   p-error-message = 'Полное название группы не может содержать более 120 символов.'
     5621               .
     5622           end.
     5623       end.
     5624   end.
     5625   end procedure.
     5626   procedure cgrplib-get-lvl-num :
     5627   define input parameter p-node-code  as integer      no-undo.
     5628   define output parameter p-lvl-num   as integer      no-undo.
     5629       define variable v-full-name    as character    no-undo.
     5630   do
     5631   on error undo, return error
     5632   :
     5633       run cli-grplib-get-full-name in this-procedure (
     5634             input p-node-code
     5635           , output v-full-name
     5636       ).
     5637       assign
     5638           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
     5639       .
     5640       if p-lvl-num = -1
     5641       then do:
     5642           assign
     5643               p-lvl-num = 0
     5644           .
     5645       end.
     5646   end.
     5647   end procedure.
     5648   PROCEDURE cgrplib-get-pcnt-value :
     5649   DEFINE INPUT PARAMETER p-node-code AS INTEGER NO-UNDO.
     5650   DEFINE output PARAMETER p-pcnt-value AS DECIMAL NO-UNDO.
     5651   define buffer buf_dis-grp-rule for ub.dis-grp-rule.
     5652   define buffer buf_dis-rule for ub.dis-rule.
     5653   find first buf_dis-grp-rule no-lock where
     5654             buf_dis-grp-rule.classif-type = 'cli-grp':U
     5655         and buf_dis-grp-rule.node-code = p-node-code
     5656         and buf_dis-grp-rule.host-code = 0
     5657         and buf_dis-grp-rule.obj-type = '':U
     5658         and buf_dis-grp-rule.obj-code = 0
     5659         and buf_dis-grp-rule.pos-type = '-':U
     5660         and buf_dis-grp-rule.discnt-role = 'cli-grp-pcnt':U no-error.
     5661   if available buf_dis-grp-rule then do:
     5662     find first buf_dis-rule no-lock where
     5663               buf_dis-rule.rule-num = buf_dis-grp-rule.rule-num no-error.
     5664     if available buf_dis-rule then do:
     5665       assign
     5666       p-pcnt-value        = buf_dis-rule.discnt-value.
     5667       .
     5668     end.
     5669   end.
     5670   END PROCEDURE.
     5671   define temp-table temp-font no-undo
     5672     field fontnum  as integer
     5673     field fontname as character
     5674     field fontsize as character
     5675     field fonttype as character
     5676     field font-h   as integer
     5677     field font-w   as integer
     5678     field v-row    as integer
     5679     field v-col    as integer
     5680     field v-row-lans as integer
     5681     field v-col-lans as integer
     5682   index pi fontnum
     5683   .
     5684   procedure get-font-ini :
     5685     do
     5686     on error undo, return error return-value
     5687     :
     5688   define variable ii as integer   no-undo .
     5689   define variable v-font7 as character no-undo .
     5690   define variable v-font as character no-undo .
     5691   define variable loc-name as character no-undo .
     5692   define variable loc-size as character no-undo .
     5693   define variable loc-type as character no-undo .
     5694   define variable old_H as integer   no-undo .
     5695   define variable old_w as integer   no-undo .
     5696   define variable old-row  as integer   no-undo .
     5697   define variable old-col  as integer   no-undo .
     5698   define variable old-row-lans  as integer   no-undo .
     5699   define variable old-col-lans  as integer   no-undo .
     5700   define variable vv as integer   no-undo .
     5701   empty temp-table temp-font.
     5702     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     5703       case num-entries (v-font7) :
     5704         when 4 then do:
     5705             assign
     5706               loc-name = entry ( 1 , v-font7 )
     5707               loc-size = entry ( 2 , v-font7 )
     5708               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     5709             .
     5710         end.
     5711         when 3 then do:
     5712             assign
     5713               loc-name = entry ( 1 , v-font7 )
     5714               loc-size = entry ( 2 , v-font7 )
     5715               loc-type = entry ( 3 , v-font7 )
     5716             .
     5717         end.
     5718         when 2 then  do:
     5719             assign
     5720               loc-name = entry ( 1 , v-font7 )
     5721               loc-size = entry ( 2 , v-font7 )
     5722               loc-type = ""
     5723             .
     5724         end.
     5725         when 1 then do:
     5726             assign
     5727               loc-name = trim(entry ( 1 , v-font7 ))
     5728               loc-size = ""
     5729               loc-type = ""
     5730             .
     5731         end.
     5732       end case.
     5733     create temp-font.
     5734     assign
     5735       temp-font.fontnum  = 7
     5736       temp-font.fontname = trim(loc-name)
     5737       temp-font.fontsize = trim(loc-size)
     5738       temp-font.fonttype = trim(loc-type)
     5739       temp-font.v-row    = 62
     5740       temp-font.v-col    = 136
     5741       temp-font.v-row-lans = 43
     5742       temp-font.v-col-lans = 198
     5743     .
     5744     repeat ii = 16 to 100 :
     5745       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     5746       if v-font = "" or v-font = ? then leave.
     5747       case num-entries (v-font) :
     5748         when 4 then do:
     5749             assign
     5750               loc-name = entry ( 1 , v-font )
     5751               loc-size = entry ( 2 , v-font )
     5752               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     5753             .
     5754         end.
     5755         when 3 then do:
     5756             assign
     5757               loc-name = entry ( 1 , v-font )
     5758               loc-size = entry ( 2 , v-font )
     5759               loc-type = entry ( 3 , v-font )
     5760             .
     5761         end.
     5762         when 2 then do:
     5763             assign
     5764               loc-name = entry ( 1 , v-font )
     5765               loc-size = entry ( 2 , v-font )
     5766               loc-type = ""
     5767             .
     5768         end.
     5769         when 1 then do:
     5770             assign
     5771               loc-name = trim(entry ( 1 , v-font ))
     5772               loc-size = ""
     5773               loc-type = ""
     5774             .
     5775         end.
     5776       end case.
     5777     create temp-font.
     5778     assign
     5779       temp-font.fontnum  = ii
     5780       temp-font.fontname = trim(loc-name)
     5781       temp-font.fontsize = trim(loc-size)
     5782       temp-font.fonttype = trim(loc-type)
     5783     .
     5784     end.
     5785       for each temp-font :
     5786          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     5787          if  vv = ? then vv =  0 .
     5788           run rep/exfont.p (
     5789             input   temp-font.fontname ,
     5790             input   vv ,
     5791             input   temp-font.fonttype ,
     5792             output  temp-font.font-h   ,
     5793             output  temp-font.font-w   )
     5794           .
     5795       end.
     5796   find first temp-font where  temp-font.fontnum  = 7  .
     5797   old_H = temp-font.font-H .
     5798   old_w = temp-font.font-W .
     5799   old-row = temp-font.v-row .
     5800   old-col = temp-font.v-col .
     5801   old-row-lans = temp-font.v-row-lans .
     5802   old-col-lans = temp-font.v-col-lans .
     5803       for each temp-font where
     5804                temp-font.fontnum  <> 7 :
     5805           assign
     5806               temp-font.v-row    = old_H * old-row / temp-font.font-h
     5807               temp-font.v-col    = old_W * old-col / temp-font.font-W
     5808               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     5809               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     5810           .
     5811       end.
     5812     end.
     5813   end procedure.
     5814   PROCEDURE How-name :
     5815   define input  parameter h as integer no-undo .
     5816   define input  parameter w as integer no-undo .
     5817   define output parameter n as character  no-undo .
     5818   define variable A4port-H as integer   no-undo init 63.
     5819   define variable A4port-W as integer   no-undo init 136.
     5820   define variable A4lans-H as integer   no-undo init 43.
     5821   define variable A4lans-W as integer   no-undo init 198.
     5822   define variable Strim-W  as integer   no-undo init 278.
     5823   run define-a4-size (
     5824        input ReportFontNum
     5825       ,output A4port-H
     5826       ,output A4port-W
     5827       ,output A4lans-H
     5828       ,output A4lans-W ).
     5829   If w >= 1 and w <= A4port-W Then DO:
     5830     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     5831     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     5832     If h > A4port-H              Then n = "to-file":U.
     5833   End.
     5834   If w > A4port-W and w <= A4lans-W Then DO:
     5835     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     5836     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     5837     If h > A4port-H              Then n = "to-file":U.
     5838   End.
     5839   If w > A4lans-W and w <= Strim-W Then DO:
     5840     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     5841     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     5842     If h > A4port-H              Then n = "to-file":U.
     5843   End.
     5844   If w > Strim-W Then DO:
     5845      n = "to-file":U.
     5846   End.
     5847   END PROCEDURE.
     5848   PROCEDURE define-a4-size :
     5849   define input  parameter p-ReportFontNum as integer   no-undo .
     5850   define output parameter A4port-H as integer   no-undo .
     5851   define output parameter A4port-W as integer   no-undo .
     5852   define output parameter A4lans-H as integer   no-undo .
     5853   define output parameter A4lans-W as integer   no-undo .
     5854   if not can-find (first temp-font ) then do:
     5855      run get-font-ini .
     5856   end.
     5857   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     5858   if available temp-font then do:
     5859   assign
     5860     A4port-H = temp-font.v-row
     5861     A4port-W = temp-font.v-col
     5862     A4lans-H = temp-font.v-row-lans
     5863     A4lans-W = temp-font.v-col-lans
     5864   .
     5865   end.
     5866   else do:
     5867   assign
     5868     A4port-H = 63
     5869     A4port-W = 136
     5870     A4lans-H = 43
     5871     A4lans-W = 198
     5872   .
     5873   end.
     5874   END PROCEDURE.
