     3089     define buffer buf_gds-obj         for ub.gds-obj .
     3090     define buffer buf_bar-code        for ub.bar-code .
     3091     define variable l-empty-scale   as logical   no-undo .
     3092     do
     3093     on error undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )
     3094     on stop undo, return error substitute(" stop &1 &2" , return-value , error-status :get-message(1)  )
     3095     on end-key undo, return error substitute(" end-key &1 &2" , return-value , error-status :get-message(1)  )
     3096     :
     3097       find first buf_main_price-list no-lock
     3098         where recid(buf_main_price-list) = p-price-list-recid
     3099         no-error .
     3100       if not available buf_main_price-list
     3101       then do:
     3102         message
     3103           vss-workfile vss-revision vss-description skip
     3104           vss-include-info24 skip
     3105           "Ошибка задания входных параметров" skip
     3106           "Не найдена строка переоценки" skip
     3107           "Код записи (recid)" p-price-list-recid skip
     3108           view-as alert-box error .
     3109         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )   .
     3110       end.
     3111       if buf_main_price-list.main-price <> true
     3112       then do:
     3113         message
     3114           vss-workfile vss-revision vss-description skip
     3115           vss-include-info24 skip
     3116           "Ошибка задания входных параметров" skip
     3117           "Строка переоценки не является основной" skip
     3118           "Код записи (recid)" p-price-list-recid skip
     3119           "Переоценка" buf_main_price-list.doc-num skip
     3120           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     3121           "Бар-код" buf_main_price-list.b-code skip
     3122           view-as alert-box error .
     3123         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )  .
     3124       end.
     3125       find first buf_goods no-lock
     3126         where buf_goods.artic     = buf_main_price-list.artic
     3127           and buf_goods.prod-type = buf_main_price-list.prod-type
     3128           and buf_goods.prod-code = buf_main_price-list.prod-code
     3129         no-error .
     3130       if not available buf_goods
     3131       then do:
     3132         message
     3133           vss-workfile vss-revision vss-description skip
     3134           vss-include-info24 skip
     3135           "Не найден товар" skip
     3136           "Переоценка" buf_main_price-list.doc-num skip
     3137           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     3138           view-as alert-box error .
     3139         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     3140       end.
     3141   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3142   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     3143     (input  buf_main_price-list.artic
     3144     ,input  buf_main_price-list.prod-type
     3145     ,input  buf_main_price-list.prod-code
     3146     ,input  'empty-scale=request':u
     3147     ,output l-empty-scale
     3148     ) no-error .
     3149       if error-status :error
