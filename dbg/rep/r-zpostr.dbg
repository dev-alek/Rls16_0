     2860         end.
     2861       end.
     2862       assign
     2863         v-total-fact-sale = v-total-fact-sale
     2864                           + buf_temp-prt-obj.fact-qnty * buf_temp-prt-obj.price-sale
     2865       .
     2866       if v-total-fact-sale = ?
     2867       then do:
     2868         message
     2869           vss-workfile vss-revision vss-description skip
     2870           vss-include-info24 skip
     2871           "Ошибка при вычислении суммы в продажных ценах" skip
     2872           "Получено неопределенное значение" skip
     2873           "Переоценка" v-doc-num skip
     2874           "Артикул" p-artic p-prod-type p-prod-code skip
     2875           "Код признака" buf_temp-prt-obj.prt-code skip
     2876           "Сумма в продажных ценах" v-total-fact-sale skip
     2877           view-as alert-box error .
     2878         undo, return error .
     2879       end.
     2880       define variable v-old-fact-qnty     as decimal   no-undo .
     2881       define variable v-old-fact-cli-qnty as decimal   no-undo .
     2882       define variable v-old-fact-base     as decimal   no-undo .
     2883       define variable v-old-fact-rubl     as decimal   no-undo .
     2884       define variable v-old-fact-sale     as decimal   no-undo .
     2885       assign
     2886         v-old-fact-qnty     = buf_gds-obj.fact-qnty
     2887         v-old-fact-cli-qnty = buf_gds-obj.fact-cli-qnty
     2888         v-old-fact-base     = buf_gds-obj.fact-base
     2889         v-old-fact-rubl     = buf_gds-obj.fact-rubl
     2890         v-old-fact-sale     = buf_gds-obj.fact-sale
     2891       .
     2892       assign
     2893         buf_gds-obj.price-sale = v-price-sale
     2894         buf_gds-obj.fact-sale  = v-total-fact-sale
     2895       .
