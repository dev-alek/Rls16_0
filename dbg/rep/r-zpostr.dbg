      616   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      617     if num-entries(string(p-dec), '.') = 2
      618       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      619       else return( string(p-dec)) .
      620   end function.
      621   function format-point-to-comma returns char (input orig as char ) .
      622   define variable rtext as character no-undo .
      623   define variable strt as integer no-undo .
      624   define variable leng as integer no-undo .
      625   assign rtext = orig .
      626   repeat:
      627     strt =  index(rtext,'.').
      628     if strt = 0 then leave.
      629     leng = 1.
      630     substring(rtext,strt,leng,"character") = v-delim .
      631   end.
      632   return rtext.
      633   end function.
      634   function format-excel-text returns char ( input start-text as char ) :
      635   def var  i    as int no-undo.
      636   def var  ch   as char no-undo.
      637   def var  n    as int no-undo.
      638   def var  ipos as int no-undo.
      639     n = num-entries(trim(start-text), chr(10)) - 1 .
      640     do i = 1 to n :
      641       ipos = index( start-text, chr(10)).
      642       if ipos > 0 then
      643         substr( start-text, ipos, 1 ) = ' '.
      644     end.
      645     n = num-entries(trim(start-text), chr(13)) - 1 .
      646     do i = 1 to n :
      647       ipos = index( start-text, chr(13)).
      648       if ipos > 0 then
      649         substr( start-text, ipos, 1 ) = ' '.
      650     end.
      651     if index( start-text, '"' ) = 0 then
      652       start-text =  '="'   + trim( start-text) + '"'   .
      653       else do:
      654         n = num-entries(trim(start-text), '"') - 1.
      655         do i = 1 to n :
      656           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      657         end.
      658         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      659         start-text = '="'  + ch  + '"' .
      660       end.
      661     return start-text.
      662   end.
      663   function excel-sum returns char (input p-dec as decimal ).
      664     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      665   end function.
      666   function excel-qnty returns char (input p-dec as decimal ).
      667     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      668   end function.
      669   function format-excel-text-macr returns char ( input start-text as char ) :
      670   def var  i    as int no-undo.
      671   def var  ch   as char no-undo.
      672   def var  n    as int no-undo.
      673   def var  ipos as int no-undo.
      674     n = num-entries(trim(start-text), chr(10)) - 1 .
      675     do i = 1 to n :
      676       ipos = index( start-text, chr(10)).
      677       if ipos > 0 then
      678         substring( start-text, ipos , 1 ) = ' '.
      679     end.
      680     n = num-entries(trim(start-text), chr(13)) - 1 .
      681     do i = 1 to n :
      682       ipos = index( start-text, chr(13)).
      683       if ipos > 0 then
      684         substring( start-text, ipos, 1 ) = ' '.
      685     end.
      686     if index( start-text, '"' ) = 0 then
      687       start-text =  '"'   + trim( start-text) + '"'   .
      688       else do:
      689         n = num-entries(trim(start-text), '"') - 1.
      690         do i = 1 to n :
      691           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      692         end.
      693         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      694         start-text = '"'  + ch  + '"' .
      695       end.
      696     n = num-entries(trim(start-text), chr(10)) - 1 .
      697     do i = 1 to n :
      698       ipos = index( start-text, chr(10)).
      699       if ipos > 0 then
      700         substring( start-text, ipos , 1 ) = ' '.
      701     end.
      702       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
      703     return start-text.
      704   end.
      705   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      706   procedure cur-time :
      707      define output parameter p-today as date      no-undo .
      708      define output parameter p-time  as integer   no-undo .
      709     do
      710     on error undo, return error
      711     :
      712       define variable v-date1 as date      no-undo .
      713       define variable v-date2 as date      no-undo .
      714       define variable v-time  as integer   no-undo .
      715       assign
      716         v-date1 = today
      717         v-time  = time
      718         v-date2 = today
      719       .
      720       if v-date1 <> v-date2
      721       then do:
      722         assign
      723           v-date1 = today
      724           v-time  = v-time
      725         .
      726       end.
      727       assign
      728         p-today = v-date1
      729         p-time  = v-time
      730       .
      731     end.
      732   end.
      733   function cur-time-date returns character
      734   :
      735     return string(today, '99/99/9999':U) .
      736   end.
      737   function cur-time-mjd returns decimal
      738   :
      739     define variable v-date as date      no-undo .
      740     define variable v-time as integer   no-undo .
      741     run cur-time in this-procedure
      742       (output v-date
      743       ,output v-time
      744       ) .
      745     return integer(v-date) - 2400002 + (v-time / 86400) .
      746   end.
      747   function cur-time-get-ending-index returns integer
      748   (input p-number as integer
      749   )
      750   :
      751     if p-number < 0
      752     or p-number = ?
      753     then do:
      754       return 1 .
      755     end.
      756     define variable v-rest as integer   no-undo .
      757     assign
      758       p-number = p-number modulo 100
      759     .
      760     if p-number < 20
      761     then do:
      762       assign
      763         v-rest = p-number
      764       .
      765     end.
      766     else do:
      767       assign
      768         v-rest = p-number modulo 10
      769       .
      770     end.
      771     case v-rest :
      772       when 1
      773       then do:
      774         return 2 .
      775       end.
      776       when 2 or
      777       when 3 or
      778       when 4
      779       then do:
      780         return 3 .
      781       end.
      782       otherwise do:
      783         return 1 .
      784       end.
      785     end case .
      786   end.
      787   procedure cur-time-mjd-to-date :
      788      define input  parameter i-mjd-diff as decimal no-undo.
      789      define output parameter o-Date     as date    no-undo.
      790      define output parameter o-Time     as integer no-undo.
      791      define variable v-day-number as integer   no-undo .
      792      if    i-mjd-diff < 0
      793         or i-mjd-diff = ?
      794      then do:
      795         return "?" .
      796      end.
      797      assign
      798         v-day-number = truncate(i-mjd-diff,0).
      799         o-Date = date(v-day-number + 2400002).
      800         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      801     .
      802   end.
      803   function cur-time-mjd-to-string returns character
      804   (input p-mjd-diff as decimal
      805   )
      806   :
      807     define variable v-day-number as integer   no-undo .
      808     define variable v-seconds    as integer   no-undo .
      809     define variable v-hour       as integer   no-undo .
      810     define variable v-min        as integer   no-undo .
      811     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      812     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      813     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      814     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      815     if p-mjd-diff < 0
      816     or p-mjd-diff = ?
      817     then do:
      818       return "?" .
      819     end.
      820     assign
      821       v-day-number = integer(truncate(p-mjd-diff,0))
      822       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      823     .
      824     if v-seconds > 86400
      825     then do:
      826       assign
      827         v-seconds = 86400 - 1
      828       .
      829     end.
      830     if v-seconds < 0
      831     then do:
      832       assign
      833         v-seconds = 0
      834       .
      835     end.
      836     assign
      837       v-hour = truncate(v-seconds / 3600, 0)
      838     .
      839     assign
      840       v-seconds = v-seconds modulo 3600
      841     .
      842     assign
      843       v-min = truncate(v-seconds / 60, 0)
      844     .
      845     assign
      846       v-seconds = v-seconds modulo 60
      847     .
      848     return
      849         (if v-day-number <> 0
      850           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      851           else ""
      852         )
      853       + (if v-day-number <> 0 or v-hour <> 0
      854           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      855           else ""
      856         )
      857       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      858           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      859           else ""
      860         )
      861       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      862       .
      863   end.
      864   function cur-time-string returns character
      865   :
      866     define variable v-date as date      no-undo .
      867     define variable v-time as integer   no-undo .
      868     run cur-time in this-procedure
      869       (output v-date
      870       ,output v-time
      871       ) .
      872     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      873   end.
      874   function cur-time-string-sec returns character
      875   :
      876     define variable v-date as date      no-undo .
      877     define variable v-time as integer   no-undo .
      878     run cur-time in this-procedure
      879       (output v-date
      880       ,output v-time
      881       ) .
      882     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      883   end.
      884   function cur-time-custom  returns character
      885   (input p-prefix as character
      886   ,input p-date-format as character
      887   ,input p-delimiter as character
      888   ,input p-time-format as character
      889   ,input p-suffix as character
      890   )
      891   :
      892     define variable v-date as date      no-undo .
      893     define variable v-time as integer   no-undo .
      894     run cur-time in this-procedure
      895       (output v-date
      896       ,output v-time
      897       ) .
      898     return
      899       p-prefix
      900       + string(v-date, p-date-format)
      901       + p-delimiter
      902       + string(v-time, p-time-format)
      903       + p-suffix
      904       .
      905   end.
      906   function cur-time-print  returns character
      907   :
      908     define variable v-date as date      no-undo .
      909     define variable v-time as integer   no-undo .
      910     run cur-time in this-procedure
      911       (output v-date
      912       ,output v-time
      913       ) .
      914     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      915   end.
      916   function cur-time-datetime returns datetime
      917   :
      918     define variable v-char as character no-undo .
      919     define variable v-datetime as datetime no-undo .
      920     v-char = cur-time-string().
      921     v-datetime = datetime(v-char).
      922     return  v-datetime.
      923   end.
      924   function cur-time-string-msec returns character
      925   :
      926     define variable v-date as datetime  no-undo .
      927     v-date = now.
      928     return string(v-date) .
      929   end.
      930   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      931   procedure factord :
      932     define input  parameter p-fact-date            as date    no-undo .
      933     define input  parameter p-fact-time            as integer no-undo .
      934     define input  parameter p-fact-num             as integer no-undo .
      935     define input  parameter p-shift-date           as date    no-undo .
      936     define input  parameter p-shift-num            as integer no-undo .
      937     define input  parameter p-shift-on             as logical no-undo .
      938     define output parameter p-fact-order           as decimal no-undo .
      939     define output parameter p-shift-end-fact-order as decimal no-undo .
      940     define output parameter p-day-end-fact-order   as decimal no-undo .
      941     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      942     if p-fact-date = ?
      943     then do:
      944       return error "Не указана фактическая дата" .
      945     end.
      946     define variable v-fact-date-num as integer no-undo .
      947     assign
      948       v-fact-date-num = integer(p-fact-date)
      949     .
      950     if p-fact-num = ?
      951     or p-fact-num = 0
      952     then do:
      953       return error "Не задан p-fact-num " + string(p-fact-num) .
      954     end.
      955     if p-fact-num < 0
      956     then do:
      957       return error "Отрицательный fact-num " + string(p-fact-num) .
      958     end.
      959     if p-fact-num >= 100000000
      960     then do:
      961       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      962     end.
      963     if p-shift-on = true
      964     then do:
      965       if p-shift-date = ?
      966       then do:
      967         return error "Не задана дата смены" .
      968       end.
      969       if p-shift-num = ?
      970       or p-shift-num = 0
      971       then do:
      972         return error "Не задан номер смены" .
      973       end.
      974     end.
      975     else do:
      976       assign
      977         p-shift-date = p-fact-date
      978         p-shift-num  = 24
      979       .
      980     end.
      981     define variable v-shift-offset as integer no-undo .
      982     if p-shift-date = p-fact-date
      983     then do:
      984       assign
      985         v-shift-offset = 1
      986       .
      987     end.
      988     if p-shift-date < p-fact-date
      989     then do:
      990       assign
      991         v-shift-offset = 0
      992       .
      993     end.
      994     if p-shift-date > p-fact-date
      995     then do:
      996       message
      997         vss-workfile vss-revision vss-description skip
      998         "Неправильная дата закрытия смены" skip
      999         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1000         view-as alert-box error .
     1001       undo, return error
     1002         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1003           ,string(p-fact-date, '99/99/9999':U)
     1004           ,string(p-shift-date, '99/99/9999':U)
     1005           )
     1006       .
     1007     end.
     1008     if p-shift-num < 1
     1009     or p-shift-num > 24
     1010     then do:
     1011       message
     1012         vss-workfile vss-revision vss-description skip
     1013         "Неправильный номер смены" skip
     1014         "p-shift-num" p-shift-num skip
     1015         view-as alert-box error .
     1016       undo, return error return-value .
     1017     end.
     1018     assign
     1019       p-fact-order           = v-fact-date-num
     1020                              + v-shift-offset * 0.5
     1021                              + p-shift-num    * 0.02 - 0.01
     1022                              + p-fact-num     * 0.0000000001
     1023       p-shift-end-fact-order = v-fact-date-num
     1024                              + v-shift-offset * 0.5
     1025                              + p-shift-num    * 0.02
     1026       p-day-end-fact-order   = v-fact-date-num
     1027                              + 0.99
     1028     .
     1029     if p-fact-order           <= v-fact-date-num
     1030     or p-shift-end-fact-order <= v-fact-date-num
     1031     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1032     or p-shift-end-fact-order >= p-day-end-fact-order
     1033     then do:
     1034       message
     1035         vss-workfile vss-revision vss-description skip
     1036         "Внутренняя ошибка при генерации фактического номера" skip
     1037         "p-fact-date"            p-fact-date            skip
     1038         "p-fact-time"            p-fact-time            skip
     1039         "p-fact-num"             p-fact-num             skip
     1040         "p-shift-date"           p-shift-date           skip
     1041         "p-shift-num"            p-shift-num            skip
     1042         "p-shift-on"             p-shift-on             skip
     1043         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1044         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1045         "v-fact-date-num"        v-fact-date-num        skip
     1046         view-as alert-box error .
     1047       undo, return error return-value .
     1048     end.
     1049   end procedure.
     1050   procedure day-begin-fact-order :
     1051     define input  parameter p-fact-date            as date    no-undo .
     1052     define output parameter p-day-begin-fact-order as decimal no-undo .
     1053     do
     1054     on error undo, return error return-value
     1055     :
     1056       if p-fact-date = ?
     1057       then do:
     1058         assign
     1059           p-day-begin-fact-order = 0
     1060         .
     1061       end.
     1062       else do:
     1063         assign
     1064           p-day-begin-fact-order = integer(p-fact-date)
     1065         .
     1066       end.
     1067     end.
     1068   end procedure.
     1069   procedure factord-max-fact-order :
     1070     define output parameter p-max-fact-order as decimal   no-undo .
     1071     do
     1072     on error undo, return error return-value
     1073     :
     1074       run day-begin-fact-order in this-procedure
     1075         (input  date(1, 1, 5000)
     1076         ,output p-max-fact-order
     1077         ) .
     1078     end.
     1079   end procedure.
     1080   procedure factord-cut-archive :
     1081     define input  parameter p-obj-type             as character no-undo .
     1082     define input  parameter p-obj-code             as integer   no-undo .
     1083     define input  parameter p-fact-date            as date      no-undo .
     1084     define output parameter p-shift-on             as logical   no-undo .
     1085     define output parameter p-shift-date           as date      no-undo .
     1086     define output parameter p-shift-num            as integer   no-undo .
     1087     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1088     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1089     define variable v-fact-order as decimal   no-undo .
     1090     define buffer buf_shift-obj for ub.shift-obj .
     1091     do
     1092     on error undo, return error return-value
     1093     :
     1094   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1095   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1096     (input  p-obj-type
     1097     ,input  p-obj-code
     1098     ,input  'shift-on=request'
     1099     ,output p-shift-on
     1100     ) no-error .
     1101       if error-status :error
     1102       then do:
     1103         message
     1104           vss-workfile vss-revision vss-description skip
     1105           "Ошибка при определении атрибута объекта" skip
     1106           "Объект" p-obj-type p-obj-code skip
     1107           error-status :get-message(1) skip
     1108           return-value skip
     1109           view-as alert-box error .
     1110         undo, return error return-value .
     1111       end.
     1112       if p-shift-on = false
     1113       then do:
     1114         assign
     1115           p-shift-date               = ?
     1116           p-shift-num                = 0
     1117         .
     1118       end.
     1119       else do:
     1120         find first buf_shift-obj share-lock
     1121           where buf_shift-obj.obj-type   = p-obj-type
     1122             and buf_shift-obj.obj-code   = p-obj-code
     1123             and buf_shift-obj.shift-date > p-fact-date
     1124           use-index pi
     1125           no-error .
     1126         if not available buf_shift-obj
     1127         or buf_shift-obj.status_ <> 'зкр':U
     1128         then do:
     1129           message
     1130             vss-workfile vss-revision vss-description skip
     1131             "Невозможно вычислить последнюю смену" skip
     1132             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1133             "Объект" p-obj-type p-obj-code skip
     1134             "Дата" p-fact-date skip
     1135             view-as alert-box error .
     1136           undo, return error return-value .
     1137         end.
     1138         find last buf_shift-obj share-lock
     1139           where buf_shift-obj.obj-type = p-obj-type
     1140             and buf_shift-obj.obj-code = p-obj-code
     1141             and buf_shift-obj.shift-date <= p-fact-date
     1142           use-index pi
     1143           no-error .
     1144         if available buf_shift-obj
     1145         then do:
     1146           if  buf_shift-obj.status_ = 'зкр':U
     1147           then do:
     1148             assign
     1149               p-shift-date = buf_shift-obj.shift-date
     1150               p-shift-num  = buf_shift-obj.shift-num
     1151             .
     1152           end.
     1153           else do:
     1154             message
     1155               vss-workfile vss-revision vss-description skip
     1156               "Невозможно вычислить последнюю смену" skip
     1157               "Статус смены отличен от статуса" 'зкр':U skip
     1158               "Объект" p-obj-type p-obj-code skip
     1159               "Дата" p-fact-date skip
     1160               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1161               view-as alert-box error .
     1162             undo, return error return-value .
     1163           end.
     1164         end.
     1165         else do:
     1166           assign
     1167             p-shift-date = p-fact-date - 1
     1168             p-shift-num  = 1
     1169           .
     1170         end.
     1171       end.
     1172       run factord in this-procedure
     1173         (input  p-fact-date
     1174         ,input  1
     1175         ,input  1
     1176         ,input  p-shift-date
     1177         ,input  p-shift-num
     1178         ,input  p-shift-on
     1179         ,output v-fact-order
     1180         ,output p-shift-end-fact-order
     1181         ,output p-day-end-fact-order
     1182         ) no-error .
     1183       if error-status :error
     1184       then do:
     1185         message
     1186           vss-workfile vss-revision vss-description skip
     1187           "Ошибка при вызове процедуры factord"
     1188           error-status :get-message(1) skip
     1189           return-value skip
     1190           view-as alert-box error .
     1191         undo, return error return-value .
     1192       end.
     1193     end.
     1194   end procedure.
     1195   procedure factord-lock-shift :
     1196     define input  parameter p-obj-type  as character no-undo .
     1197     define input  parameter p-obj-code  as integer   no-undo .
     1198     define input  parameter p-fact-date as date      no-undo .
     1199     define parameter buffer buf_shift-obj for ub.shift-obj .
     1200     define variable v-shift-on      as logical   no-undo .
     1201     define variable v-extra-message as character no-undo .
     1202     define variable v-error as character no-undo .
     1203     do
     1204     on error undo, return error return-value
     1205     :
     1206   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1207   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1208     (input  p-obj-type
     1209     ,input  p-obj-code
     1210     ,input  'shift-on=request'
     1211     ,output v-shift-on
     1212     ) no-error .
     1213       if error-status :error
     1214       then do:
     1215         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1216         undo, return error v-error .
     1217       end.
     1218       if v-shift-on = true
     1219       then do:
     1220         find first buf_shift-obj share-lock
     1221           where buf_shift-obj.obj-type   = p-obj-type
     1222             and buf_shift-obj.obj-code   = p-obj-code
     1223             and buf_shift-obj.shift-date > p-fact-date
     1224           use-index pi
     1225           no-error .
     1226         if not available buf_shift-obj
     1227         or buf_shift-obj.status_ <> 'зкр':U
     1228         then do:
     1229           find last buf_shift-obj
     1230             where buf_shift-obj.obj-type = p-obj-type
     1231               and buf_shift-obj.obj-code = p-obj-code
     1232               and buf_shift-obj.status_  = 'зкр':U
     1233             use-index stts
     1234             no-error .
     1235           if available buf_shift-obj
     1236           then do:
     1237             assign
     1238               v-extra-message =
     1239                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1240                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1241                               )
     1242             .
     1243           end.
     1244           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1245           undo, return error v-error .
     1246         end.
     1247       end.
     1248     end.
     1249   end procedure.
     1250   procedure factord-end-day :
     1251     define input  parameter p-fact-date            as date    no-undo .
     1252     define output parameter p-day-end-fact-order   as decimal no-undo .
     1253     do
     1254     on error undo, return error return-value
     1255     :
     1256       if p-fact-date = ?
     1257       then do:
     1258         return error "Не указана фактическая дата" .
     1259       end.
     1260       assign
     1261         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1262       .
     1263     end.
     1264   end procedure.
     1265   procedure factord-to-date :
     1266     define input  parameter p-fact-order as decimal no-undo .
     1267     define output parameter p-fact-date  as date    no-undo .
     1268     define variable v-ref-date  as date      no-undo .
     1269     define variable v-ref-delta as integer   no-undo .
     1270     do
     1271     on error undo, return error return-value
     1272     :
     1273       if p-fact-order = ?
     1274       or p-fact-order = 0
     1275       then do:
     1276         return error "Не указан fact-order" .
     1277       end.
     1278       assign
     1279         v-ref-date  = date(1, 1, 2000)
     1280       .
     1281       assign
     1282         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1283       .
     1284       assign
     1285         p-fact-date = v-ref-date + v-ref-delta
     1286       .
     1287     end.
     1288   end procedure.
     1289   procedure factord-to-fact-num :
     1290     define input  parameter p-fact-order as decimal no-undo .
     1291     define output parameter p-fact-num   as integer no-undo .
     1292     define variable v-fact-order-trunc as decimal no-undo .
     1293     do
     1294     on error undo, return error return-value
     1295     :
     1296       if p-fact-order = ?
     1297       or p-fact-order = 0
     1298       then do:
     1299         return error "Не указан fact-order" .
     1300       end.
     1301       assign
     1302        v-fact-order-trunc = truncate(p-fact-order, 2)
     1303       .
     1304       assign
     1305         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1306       .
     1307     end.
     1308   end procedure.
     1309   procedure factord-to-shift-num :
     1310     define input  parameter p-fact-order as decimal no-undo .
     1311     define output parameter p-shift-num   as integer no-undo .
     1312     define variable  p-shift-numd  as decimal   no-undo .
     1313     define variable v-fact-order-trunc as decimal no-undo .
     1314     do
     1315     on error undo, return error return-value
     1316     :
     1317       if p-fact-order = ?
     1318       or p-fact-order = 0
     1319       then do:
     1320         return error "Не указан fact-order" .
     1321       end.
     1322       assign
     1323        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1324       .
     1325       if v-fact-order-trunc < 0.5 then do:
     1326         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1327       end.
     1328       assign
     1329         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1330         .
     1331        assign
     1332         p-shift-num = truncate (p-shift-numd , 0)
     1333       .
     1334     end.
     1335   end procedure.
     1336   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1337   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
     1338   procedure partslib-clear-temp-parts :
     1339     define buffer buf_temp-parts for temp-parts .
     1340     do
     1341     on error undo, return error
     1342     :
     1343       for each buf_temp-parts
     1344       on error undo, return error
     1345       :
     1346         delete buf_temp-parts .
     1347       end.
     1348     end.
     1349   end procedure.
     1350   procedure partslib-create-temp-parts :
     1351     define parameter buffer buf_parts       for ub.parts .
     1352     define parameter buffer buf_temp-parts  for temp-parts .
     1353     define input  parameter p-goods-twounit as logical   no-undo .
     1354     define variable v-base-part-code as character no-undo .
     1355     do
     1356     on error undo, return error
     1357     :
     1358       if p-goods-twounit = true
     1359       then do:
     1360         assign
     1361           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
     1362         .
     1363       end.
     1364       else do:
     1365         assign
     1366           v-base-part-code = buf_parts.part-code
     1367         .
     1368       end.
     1369       find first buf_temp-parts exclusive-lock
     1370         where buf_temp-parts.obj-type  = buf_parts.obj-type
     1371           and buf_temp-parts.obj-code  = buf_parts.obj-code
     1372           and buf_temp-parts.artic     = buf_parts.artic
     1373           and buf_temp-parts.prod-type = buf_parts.prod-type
     1374           and buf_temp-parts.prod-code = buf_parts.prod-code
     1375           and buf_temp-parts.in-code   = buf_parts.in-code
     1376           and buf_temp-parts.out-code  = 'free-zone':U
     1377           and buf_temp-parts.part-code = v-base-part-code
     1378         no-error.
     1379       if not available buf_temp-parts
     1380       then do:
     1381         create buf_temp-parts .
     1382         buffer-copy buf_parts to buf_temp-parts
     1383         assign
     1384           buf_temp-parts.out-code  = 'free-zone':U
     1385           buf_temp-parts.part-code = v-base-part-code
     1386           buf_temp-parts.rsrv-free = yes
     1387           buf_temp-parts.status_   = no
     1388           buf_temp-parts.qnty      = 0
     1389           buf_temp-parts.fact-qnty = 0
     1390           buf_temp-parts.real-qnty = 0
     1391           buf_temp-parts.cli-qnty  = 0
     1392         .
     1393       end.
     1394     end.
     1395   end procedure.
     1396   procedure partslib-init-temp-parts :
     1397     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     1398     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     1399     define input parameter p-artic           like ub.parts.artic     no-undo .
     1400     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     1401     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     1402     define buffer buf_parts      for ub.parts .
     1403     define buffer buf_temp-parts for temp-parts .
     1404     define variable v-goods-twounit    as logical   no-undo .
     1405     do
     1406     on error undo, return error
     1407     :
     1408   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1409   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1410     (input  p-artic
     1411     ,input  p-prod-type
     1412     ,input  p-prod-code
     1413     ,input  'twounit=request':u
     1414     ,output v-goods-twounit
     1415     ) no-error .
     1416       if error-status :error
     1417       then do:
     1418         message
     1419           vss-workfile vss-revision vss-description skip
     1420           vss-include-info12 skip
     1421           "Ошибка при определении атрибута товара" skip
     1422           "Артикул" p-artic p-prod-type p-prod-code skip
     1423           "twounit=request" skip
     1424           error-status :get-message(1) skip
     1425           return-value skip
     1426           view-as alert-box error .
     1427         undo, return error return-value .
     1428       end.
     1429       run partslib-clear-temp-parts in this-procedure .
     1430       for each buf_parts
     1431         where buf_parts.obj-type  = p-obj-type
     1432           and buf_parts.obj-code  = p-obj-code
     1433           and buf_parts.artic     = p-artic
     1434           and buf_parts.prod-type = p-prod-type
     1435           and buf_parts.prod-code = p-prod-code
     1436           and buf_parts.rsrv-free = yes
     1437           and buf_parts.status_   = no
     1438           and buf_parts.in-code   <> buf_parts.out-code
     1439       on error undo, return error
     1440       :
     1441         run partslib-create-temp-parts in this-procedure
     1442           (buffer buf_parts
     1443           ,buffer buf_temp-parts
     1444           ,input  v-goods-twounit
     1445           ) .
     1446         define variable v-parts-qnty          as decimal   no-undo .
     1447         define variable v-parts-cli-qnty      as decimal   no-undo .
     1448         define variable v-parts-free-qnty     as decimal   no-undo .
     1449         define variable v-parts-free-cli-qnty as decimal   no-undo .
     1450         if buf_parts.out-code = 'free-zone':U
     1451         then do:
     1452           assign
     1453             v-parts-qnty          = buf_parts.qnty
     1454             v-parts-cli-qnty      = buf_parts.cli-qnty
     1455             v-parts-free-qnty     = buf_parts.qnty
     1456             v-parts-free-cli-qnty = buf_parts.cli-qnty
     1457           .
     1458         end.
     1459         else do:
     1460           assign
     1461             v-parts-qnty          = abs(buf_parts.qnty)
     1462             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
     1463             v-parts-free-qnty     = 0
     1464             v-parts-free-cli-qnty = 0
     1465           .
     1466         end.
     1467         assign
     1468           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
     1469           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
     1470           buf_temp-parts.real-qnty     = 0
     1471           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
     1472           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
     1473           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
     1474         .
     1475       end.
     1476     end.
     1477   end procedure.
     1478   procedure partslib-init-temp-parts-by-factord :
     1479     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     1480     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     1481     define input parameter p-artic              like ub.parts.artic     no-undo .
     1482     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     1483     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     1484     define input parameter p-fact-order         as decimal   no-undo .
     1485     define input parameter p-include-fact-order as logical   no-undo .
     1486     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     1487     define buffer buf_gds-obj  for ub.gds-obj .
     1488     do
     1489     on error undo, return error
     1490     :
     1491       do transaction
     1492       on error undo, return error
     1493       :
     1494   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1495   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1496     (input  p-obj-type
     1497     ,input  p-obj-code
     1498     ,input  p-artic
     1499     ,input  p-prod-type
     1500     ,input  p-prod-code
     1501     ,buffer buf_gds-obj
     1502     ) no-error .
     1503         if error-status :error
     1504         then do:
     1505           message
     1506             vss-workfile vss-revision vss-description skip
     1507             vss-include-info12 skip
     1508             "Невозможно найти товар на объекте" skip
     1509             "Объект" p-obj-type p-obj-code skip
     1510             "Артикул" p-artic p-prod-type p-prod-code skip
     1511             error-status :get-message(1) skip
     1512             return-value skip
     1513             view-as alert-box error .
     1514           undo, return error .
     1515         end.
     1516         find current buf_gds-obj exclusive-lock .
     1517       end.
     1518       run partslib-init-temp-parts in this-procedure
     1519         (input p-obj-type
     1520         ,input p-obj-code
     1521         ,input p-artic
     1522         ,input p-prod-type
     1523         ,input p-prod-code
     1524         ) no-error .
     1525       if error-status :error
     1526       then do:
     1527         message
     1528           vss-workfile vss-revision vss-description skip
     1529           vss-include-info12 skip
     1530           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
     1531           "Объект" p-obj-type p-obj-code skip
     1532           "Артикул" p-artic p-prod-type p-prod-code skip
     1533           "p-fact-order" p-fact-order skip
     1534           view-as alert-box error .
     1535         undo, return error .
     1536       end.
     1537       if p-include-fact-order = true
     1538       then do:
     1539         assign
     1540           p-fact-order = p-fact-order - 0.0000000001
     1541         .
     1542       end.
     1543       define variable v-max-fact-order as character no-undo .
     1544       run factord-max-fact-order in this-procedure
     1545         (output v-max-fact-order
     1546         ) no-error .
     1547       if error-status :error
     1548       then do:
     1549         message
     1550           vss-workfile vss-revision vss-description skip
     1551           vss-include-info12 skip
     1552           "Ошибка при вызове процедуры factord-max-fact-order" skip
     1553           "Объект" p-obj-type p-obj-code skip
     1554           "Артикул" p-artic p-prod-type p-prod-code skip
     1555           "p-fact-order" p-fact-order skip
     1556           view-as alert-box error .
     1557         undo, return error .
     1558       end.
     1559       run partslib-update-by-factord in this-procedure
     1560         (input p-obj-type
     1561         ,input p-obj-code
     1562         ,input p-artic
     1563         ,input p-prod-type
     1564         ,input p-prod-code
     1565         ,input p-fact-order
     1566         ,input v-max-fact-order
     1567         ,input false
     1568         ) no-error .
     1569       if error-status :error
     1570       then do:
     1571         message
     1572           vss-workfile vss-revision vss-description skip
     1573           vss-include-info12 skip
     1574           "Ошибка при вызове процедуры partslib-update-by-factord" skip
     1575           "Объект" p-obj-type p-obj-code skip
     1576           "Артикул" p-artic p-prod-type p-prod-code skip
     1577           "p-fact-order" p-fact-order skip
     1578           "v-max-fact-order" v-max-fact-order skip
     1579           view-as alert-box error .
     1580         undo, return error .
     1581       end.
     1582     end.
     1583   end procedure.
     1584   procedure partslib-update-by-factord :
     1585     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     1586     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     1587     define input parameter p-artic              like ub.parts.artic     no-undo .
     1588     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     1589     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     1590     define input parameter p-start-fact-order   as decimal   no-undo .
     1591     define input parameter p-end-fact-order     as decimal   no-undo .
     1592     define input parameter p-lock-gds-obj       as logical   no-undo .
     1593     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     1594     define buffer buf_gds-obj  for ub.gds-obj .
     1595     define buffer buf_doc-line for ub.doc-line .
     1596     define variable v-total-parts-qnty as decimal   no-undo .
     1597     define variable v-goods-gds-goods  as logical   no-undo .
     1598     define variable v-goods-twounit    as logical   no-undo .
     1599     do
     1600     on error undo, return error
     1601     :
     1602       if p-start-fact-order > p-end-fact-order
     1603       then do:
     1604         message
     1605           vss-workfile vss-revision vss-description skip
     1606           vss-include-info12 skip
     1607           "Ошибка задания входных параметров" skip
     1608           "Начало интервала превышает конец интервала" skip
     1609           "Объект" p-obj-type p-obj-code skip
     1610           "Артикул" p-artic p-prod-type p-prod-code skip
     1611           "p-start-fact-order" p-start-fact-order skip
     1612           "p-end-fact-order"   p-end-fact-order skip
     1613           view-as alert-box error .
     1614         undo, return error .
     1615       end.
     1616       if p-lock-gds-obj = true
     1617       then do:
     1618         do transaction
     1619         on error undo, return error
     1620         :
     1621   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1622   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1623     (input  p-obj-type
     1624     ,input  p-obj-code
     1625     ,input  p-artic
     1626     ,input  p-prod-type
     1627     ,input  p-prod-code
     1628     ,buffer buf_gds-obj
     1629     ) no-error .
     1630           if error-status :error
     1631           then do:
     1632             message
     1633               vss-workfile vss-revision vss-description skip
     1634               vss-include-info12 skip
     1635               "Невозможно найти gds-obj" skip
     1636               error-status :get-message(1) skip
     1637               return-value skip
     1638               view-as alert-box error .
     1639             undo, return error .
     1640           end.
     1641           find current buf_gds-obj exclusive-lock .
     1642         end.
     1643       end.
     1644   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1645   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1646     (input  p-artic
     1647     ,input  p-prod-type
     1648     ,input  p-prod-code
     1649     ,input  'gds-goods=request':u
     1650     ,output v-goods-gds-goods
     1651     ) no-error .
     1652       if error-status :error
     1653       then do:
     1654         message
     1655           vss-workfile vss-revision vss-description skip
     1656           vss-include-info12 skip
     1657           "Ошибка при определении атрибута товара" skip
     1658           "Артикул" p-artic p-prod-type p-prod-code skip
     1659           "gds-goods=request" skip
     1660           error-status :get-message(1) skip
     1661           return-value skip
     1662           view-as alert-box error .
     1663         undo, return error return-value .
     1664       end.
     1665   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1666   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1667     (input  p-artic
     1668     ,input  p-prod-type
     1669     ,input  p-prod-code
     1670     ,input  'twounit=request':u
     1671     ,output v-goods-twounit
     1672     ) no-error .
     1673       if error-status :error
     1674       then do:
     1675         message
     1676           vss-workfile vss-revision vss-description skip
     1677           vss-include-info12 skip
     1678           "Ошибка при определении атрибута товара" skip
     1679           "Артикул" p-artic p-prod-type p-prod-code skip
     1680           "twounit=request" skip
     1681           error-status :get-message(1) skip
     1682           return-value skip
     1683           view-as alert-box error .
     1684         undo, return error return-value .
     1685       end.
     1686       for each buf_doc-line no-lock
     1687         where buf_doc-line.obj-type   = p-obj-type
     1688           and buf_doc-line.obj-code   = p-obj-code
     1689           and buf_doc-line.artic      = p-artic
     1690           and buf_doc-line.prod-type  = p-prod-type
     1691           and buf_doc-line.prod-code  = p-prod-code
     1692           and buf_doc-line.status_    = 'факт':U
     1693           and buf_doc-line.fact-order > p-start-fact-order
     1694           and buf_doc-line.fact-order <= p-end-fact-order
     1695       on error undo, return error
     1696       :
     1697         run partslib-process-document in this-procedure
     1698           (input  buf_doc-line.doc-code
     1699           ,input  p-obj-type
     1700           ,input  p-obj-code
     1701           ,input  p-artic
     1702           ,input  p-prod-type
     1703           ,input  p-prod-code
     1704           ,input  v-goods-gds-goods
     1705           ,input  v-goods-twounit
     1706           ,output v-total-parts-qnty
     1707           ) no-error .
     1708         if error-status :error
     1709         then do:
     1710           message
     1711             vss-workfile vss-revision vss-description skip
     1712             vss-include-info12 skip
     1713             "Ошибка при вызове процедуры partslib-process-document" skip
     1714             "Документ" buf_doc-line.doc-code skip
     1715             "Объект" p-obj-type p-obj-code skip
     1716             "Артикул" p-artic p-prod-type p-prod-code skip
     1717             "p-start-fact-order" p-start-fact-order skip
     1718             "p-end-fact-order" p-end-fact-order skip
     1719             error-status :get-message(1) skip
     1720             return-value skip
     1721             view-as alert-box error .
     1722           undo, return error return-value .
     1723         end.
     1724       end.
     1725     end.
     1726   end procedure.
     1727   procedure partslib-process-document :
     1728     define input  parameter p-doc-code         as character no-undo .
     1729     define input  parameter p-obj-type         as character no-undo .
     1730     define input  parameter p-obj-code         as integer   no-undo .
     1731     define input  parameter p-artic            as character no-undo .
     1732     define input  parameter p-prod-type        as character no-undo .
     1733     define input  parameter p-prod-code        as integer   no-undo .
     1734     define input  parameter p-goods-gds-goods  as logical   no-undo .
     1735     define input  parameter p-goods-twounit    as logical   no-undo .
     1736     define output parameter p-total-parts-qnty as decimal   no-undo .
     1737     define variable v-parts-sign as integer   no-undo .
     1738     define buffer buf_trn-doc    for ub.trn-doc .
     1739     define buffer buf_doc-line   for ub.doc-line .
     1740     define buffer buf_parts      for ub.parts .
     1741     define buffer buf_temp-parts for temp-parts .
     1742     do
     1743     on error undo, return error return-value
     1744     :
     1745       find first buf_trn-doc no-lock
     1746         where buf_trn-doc.doc-code = p-doc-code
     1747         no-error .
     1748       if not available buf_trn-doc
     1749       then do:
     1750         undo, return error substitute("Ошибка при поиске документа. Документ &1"
     1751                                      ,p-doc-code
     1752                                      ) .
     1753       end.
     1754       case buf_trn-doc.doc-type
     1755       :
     1756         when 'при':U or
     1757         when 'возврат':U or
     1758         when 'инв':U
     1759         then do:
     1760           assign
     1761             v-parts-sign = -1
     1762           .
     1763         end.
     1764         when 'рас':U or
     1765         when 'спи':U
     1766         then do:
     1767           assign
     1768             v-parts-sign = 1
     1769           .
     1770         end.
     1771         otherwise do:
     1772           undo, return error substitute("Неизвестный тип документа &1"
     1773                                       ,buf_trn-doc.doc-type
     1774                                       ) .
     1775         end.
     1776       end.
     1777       find first buf_doc-line no-lock
     1778         where buf_doc-line.doc-code  = p-doc-code
     1779           and buf_doc-line.artic     = p-artic
     1780           and buf_doc-line.prod-type = p-prod-type
     1781           and buf_doc-line.prod-code = p-prod-code
     1782         no-error .
     1783       if not available buf_doc-line
     1784       then do:
     1785         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
     1786                                      ,p-doc-code
     1787                                      ,artic
     1788                                      ,prod-type
     1789                                      ,prod-code
     1790                                      ) .
     1791       end.
     1792       assign
     1793         p-total-parts-qnty = 0
     1794       .
     1795       if p-goods-gds-goods = true
     1796       then do:
     1797         for each buf_parts no-lock
     1798           where buf_parts.out-code  = p-doc-code
     1799             and buf_parts.obj-type  = p-obj-type
     1800             and buf_parts.obj-code  = p-obj-code
     1801             and buf_parts.artic     = p-artic
     1802             and buf_parts.prod-type = p-prod-type
     1803             and buf_parts.prod-code = p-prod-code
     1804         on error undo, return error
     1805         :
     1806           run partslib-create-temp-parts in this-procedure
     1807             (buffer buf_parts
     1808             ,buffer buf_temp-parts
     1809             ,input  p-goods-twounit
     1810             ) .
     1811           assign
     1812             p-total-parts-qnty        = p-total-parts-qnty
     1813                                       + v-parts-sign * buf_parts.fact-qnty
     1814             buf_temp-parts.qnty       = buf_temp-parts.qnty
     1815                                       + v-parts-sign * buf_parts.fact-qnty
     1816             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
     1817                                       + v-parts-sign * buf_parts.fact-qnty
     1818             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
     1819                                       + v-parts-sign * buf_parts.cli-qnty
     1820           .
     1821           if buf_temp-parts.qnty = 0
     1822           then do:
     1823             delete buf_temp-parts .
     1824           end.
     1825         end.
     1826       end.
     1827       else do:
     1828         assign
     1829           p-total-parts-qnty = p-total-parts-qnty
     1830                              + v-parts-sign * buf_doc-line.fact-qnty
     1831         .
     1832       end.
     1833     end.
     1834   end procedure.
     1835   procedure partslib-init-temp-parts-by-date :
     1836     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     1837     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     1838     define input parameter p-artic           like ub.parts.artic     no-undo .
     1839     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     1840     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     1841     define input parameter p-fact-date       as date      no-undo .
     1842     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
     1843     do
     1844     on error undo, return error
     1845     :
     1846       define variable v-fact-order                as decimal   no-undo .
     1847       define variable v-shift-end-fact-order      as decimal   no-undo .
     1848       define variable v-day-end-fact-order        as decimal   no-undo .
     1849       run factord in this-procedure
     1850         (input  p-fact-date
     1851         ,input  1
     1852         ,input  1
     1853         ,input  ?
     1854         ,input  0
     1855         ,input  false
     1856         ,output v-fact-order
     1857         ,output v-shift-end-fact-order
     1858         ,output v-day-end-fact-order
     1859         ) no-error .
     1860       if error-status :error
     1861       then do:
     1862         message
     1863           vss-workfile vss-revision vss-description skip
     1864           vss-include-info12 skip
     1865           "Ошибка при определении момента времени, на который требуется остаток" skip
     1866           "Объект" p-obj-type p-obj-code skip
     1867           "Артикул" p-artic p-prod-type p-prod-code skip
     1868           "Дата" p-fact-date skip
     1869           view-as alert-box error .
     1870         undo, return error .
     1871       end.
     1872       run partslib-init-temp-parts-by-factord in this-procedure
     1873         (input p-obj-type
     1874         ,input p-obj-code
     1875         ,input p-artic
     1876         ,input p-prod-type
     1877         ,input p-prod-code
     1878         ,input v-day-end-fact-order
     1879         ,input false
     1880         ) no-error .
     1881       if error-status :error
     1882       then do:
     1883         message
     1884           vss-workfile vss-revision vss-description skip
     1885           vss-include-info12 skip
     1886           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
     1887           "Объект" p-obj-type p-obj-code skip
     1888           "Артикул" p-artic p-prod-type p-prod-code skip
     1889           "Дата" p-fact-date skip
     1890           view-as alert-box error .
     1891         undo, return error .
     1892       end.
     1893     end.
     1894   end procedure.
     1895   procedure partslib-calc-cost :
     1896     define output parameter p-fact-qnty      as decimal   no-undo .
     1897     define output parameter p-vat-pc         as decimal   no-undo .
     1898     define output parameter p-slt-pc         as decimal   no-undo .
     1899     define output parameter p-sum-base       as decimal   no-undo .
     1900     define output parameter p-sum-rubl       as decimal   no-undo .
     1901     define output parameter p-vat-base       as decimal   no-undo .
     1902     define output parameter p-vat-rubl       as decimal   no-undo .
     1903     define output parameter p-slt-base       as decimal   no-undo .
     1904     define output parameter p-slt-rubl       as decimal   no-undo .
     1905     define output parameter p-road-tax-base  as decimal   no-undo .
     1906     define output parameter p-road-tax-rubl  as decimal   no-undo .
     1907     define output parameter p-transport-base as decimal   no-undo .
     1908     define output parameter p-transport-rubl as decimal   no-undo .
     1909     define output parameter p-other-base     as decimal   no-undo .
     1910     define output parameter p-other-rubl     as decimal   no-undo .
     1911     define output parameter p-excise-base    as decimal   no-undo .
     1912     define output parameter p-excise-rubl    as decimal   no-undo .
     1913     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     1914     do
     1915     on error undo, return error return-value
     1916     :
     1917       define buffer buf_temp-parts for temp-parts .
     1918       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     1919       define buffer   in-vatp-parts    for ub.parts   .
     1920       define buffer   in-vatp-doc      for ub.trn-doc .
     1921       define buffer   in-vatp-goods    for ub.goods   .
     1922       define buffer   in-vatp-sysconf  for ub.sysconf .
     1923       define buffer   in-vatp_doc-attr for ub.doc-attr.
     1924       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     1925       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     1926       define variable varinvprb                  as   character              no-undo.
     1927       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     1928       define variable cli-base-rate              as   decimal                no-undo.
     1929       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     1930       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     1931       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     1932       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     1933       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     1934       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     1935       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     1936       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1937       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     1938       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     1939       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1940       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     1941       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     1942       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     1943       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     1944       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     1945       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     1946       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     1947       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     1948       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     1949       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     1950       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     1951       define variable varinvatp-envd             as   character              no-undo.
     1952       define variable varinvatp-type             as   character              no-undo.
     1953       for each buf_temp-parts
     1954       on error undo, return error
     1955       :
     1956   assign
     1957     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     1958     price-base-with-tax-loc = buf_temp-parts.price-base
     1959   .
     1960   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1961   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1962     (output varinvprb
     1963     )  .
     1964     if buf_temp-parts.out-code = 'free-zone':U     or
     1965        buf_temp-parts.out-code = 'out-zone':U   or
     1966        buf_temp-parts.doc-type = 'акт':U then do:
     1967       assign
     1968         in-vatp-have-vat-slt = yes.
     1969     end.
     1970     else do:
     1971       find first in-vatp_doc-attr no-lock
     1972         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     1973           and in-vatp_doc-attr.attr-code = 'envd':U
     1974         no-error .
     1975       if not available in-vatp_doc-attr then do:
     1976         assign
     1977           in-vatp-have-vat-slt = yes.
     1978       end.
     1979       else do:
     1980            in-vatp-have-vat-slt = no.
     1981       end.
     1982     end.
     1983     assign
     1984      price-cli-with-tax-loc = buf_temp-parts.price-cli
     1985      cli-base-rate          = buf_temp-parts.cli-base-rate.
     1986     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     1987              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     1988     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     1989             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     1990             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     1991             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     1992             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     1993             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     1994             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1995       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1996     assign
     1997       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     1998     assign
     1999       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     2000       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     2001       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     2002       transport-cli-loc  = 0
     2003       other-cli-loc      = 0
     2004     .
     2005   ASSIGN
     2006             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     2007       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     2008   .
     2009         assign
     2010           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     2011           p-vat-pc         = p-vat-pc         + vat-pc-loc
     2012           p-slt-pc         = p-slt-pc         + slt-pc-loc
     2013           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     2014           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     2015           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     2016           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     2017           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     2018           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     2019           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     2020           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     2021           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     2022           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     2023           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     2024           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     2025           p-excise-base    = p-excise-base    + 0
     2026           p-excise-rubl    = p-excise-rubl    + 0
     2027         .
     2028       end.
     2029       if p-fact-qnty      = ?
     2030       or p-sum-base       = ?
     2031       or p-sum-rubl       = ?
     2032       or p-vat-base       = ?
     2033       or p-vat-rubl       = ?
     2034       or p-slt-base       = ?
     2035       or p-slt-rubl       = ?
     2036       or p-road-tax-base  = ?
     2037       or p-road-tax-rubl  = ?
     2038       or p-transport-base = ?
     2039       or p-transport-rubl = ?
     2040       or p-other-base     = ?
     2041       or p-other-rubl     = ?
     2042       or p-excise-base    = ?
     2043       or p-excise-rubl    = ?
     2044       then do:
     2045         message
     2046           vss-workfile vss-revision vss-description skip
     2047           vss-include-info12 skip
     2048           "Программа in-vatp.i вернула неопределенные значения" skip
     2049           "p-fact-qnty"      p-fact-qnty      skip
     2050           "p-sum-base"       p-sum-base       skip
     2051           "p-sum-rubl"       p-sum-rubl       skip
     2052           "p-vat-base"       p-vat-base       skip
     2053           "p-vat-rubl"       p-vat-rubl       skip
     2054           "p-slt-base"       p-slt-base       skip
     2055           "p-slt-rubl"       p-slt-rubl       skip
     2056           "p-road-tax-base"  p-road-tax-base  skip
     2057           "p-road-tax-rubl"  p-road-tax-rubl  skip
     2058           "p-transport-base" p-transport-base skip
     2059           "p-transport-rubl" p-transport-rubl skip
     2060           "p-other-base"     p-other-base     skip
     2061           "p-other-rubl"     p-other-rubl     skip
     2062           "p-excise-base"    p-excise-base    skip
     2063           "p-excise-rubl"    p-excise-rubl    skip
     2064           view-as alert-box error .
     2065         undo, return error .
     2066       end.
     2067     end.
     2068   end procedure.
     2069   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2070   procedure prl-vat:
     2071     define input parameter parrecid as recid no-undo.
