     2103       define variable varsum-base-factovpprl      like ub.gds-dtl.price-base               no-undo.
     2104       define variable varslt-base-factovpprl      like ub.gds-dtl.price-base               no-undo.
     2105       define variable varvat-base-factovpprl      like ub.gds-dtl.price-base               no-undo.
