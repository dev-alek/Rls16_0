     2073       define output parameter price-base-with-tax-saleprl    like ub.doc-line.price-base no-undo.
     2074       define output parameter price-rubl-without-tax-saleprl like ub.doc-line.price-rubl no-undo.
     2075       define output parameter price-base-without-tax-saleprl like ub.doc-line.price-base no-undo.
     2076       define output parameter vat-base-saleprl               like ub.doc-line.price-base no-undo.
     2077       define output parameter vat-rubl-saleprl               like ub.doc-line.price-rubl no-undo.
     2078       define output parameter vat-base-buyerprl              like ub.doc-line.price-base no-undo.
     2079       define output parameter vat-rubl-buyerprl              like ub.doc-line.price-rubl no-undo.
     2080       define output parameter slt-base-saleprl               like ub.doc-line.price-base no-undo.
     2081       define output parameter slt-rubl-saleprl               like ub.doc-line.price-rubl no-undo.
     2082       define output parameter road-tax-base-saleprl          like ub.doc-line.road-tax   no-undo.
     2083       define output parameter road-tax-rubl-saleprl          like ub.doc-line.road-tax   no-undo.
     2084       define output parameter excise-base-saleprl            like ub.doc-line.price-base no-undo.
