     6066   DEFINE FRAME InfoFrame
     6067        StopBtn AT ROW 4.25 COL 21.75
     6068        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     6069        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     6070        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     6071        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     6072        RECT-1 AT ROW 1 COL 1
     6073       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     6074            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     6075            TITLE "Процесс"
     6076            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     6077   define variable mFrameView      as logical   no-undo init yes.
     6078     define variable mFramHandle as handle no-undo.
     6079     mFramHandle = frame InfoFrame:handle.
     6080     if  log-manager:logfile-name ne ?
     6081     then DO:
     6082         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     6083         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     6084         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     6085     end.
     6086     mFrameView = not session:batch-mode and mFramHandle:visible.
     6087     if mFrameView
     6088     then do:
     6089       ASSIGN
     6090          FRAME InfoFrame:HIDDEN                           = TRUE
     6091          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     6092     end.
     6093   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     6094   DO:
     6095     IF not StopProcessing THEN
     6096       Message "Вы действительно хотите прервать" SKIP
     6097               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     6098                 UPDATE StopProcessing.
     6099     IF StopProcessing THEN do:
     6100        if mFrameView
     6101        then do:
     6102           HIDE FRAME InfoFrame.
     6103        end.
     6104     End.
     6105   END.
     6106   assign v-account = ( if integer( 25 ) = 0 then 100 else integer( 25 ) ).
     6107     if  log-manager:logfile-name ne ?
     6108     then DO:
     6109         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     6110     end.
     6111     if not session:batch-mode then
     6112     do:
     6113       VIEW FRAME InfoFrame.
     6114       mFrameView = true.
     6115     end.
     6116      v-button-stop = false .
     6117         if mFrameView
     6118         then do:
     6119         if v-button-stop then view STOPBTN in frame InfoFrame.
     6120                          else Hide STOPBTN in frame InfoFrame.
     6121         end.
     6122       for each obj-list :
     6123           case x-SelectGood :
     6124               when 1 then
     6125                   do:
     6126                       for each buf_gds-obj no-lock where buf_gds-obj.obj-type = obj-list.obj-type and buf_gds-obj.obj-code = obj-list.obj-code :
     6127   define variable vss-include-info49 as character format "X(65)" no-undo
     6128   initial "@(#)$Workfile$ $Revision$".
     6129     assign Counter1 = Counter1 + 1.
     6130   IF ( Counter1 modulo v-account = 0 )  then DO:
     6131             if  log-manager:logfile-name ne ?
     6132             then DO:
     6133                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     6134             end.
