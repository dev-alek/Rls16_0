     7274                 do jj = 1 to ij : assign ItogStr = ItogStr + "  " . end.
     7275                 assign ItogStr = ItogStr + "Всего по гр. пост. " + tt-grp-tree.name .
     7276                 run PrintItogGroup in this-procedure ( ItogStr, tt-grp-tree.fact-qnty, tt-grp-tree.free-qnty, tt-grp-tree.zak-sum, tt-grp-tree.naz-sum, tt-grp-tree.wait-qnty ) .
     7277               end.
     7278               delete tt-grp-tree .
     7279             end.
     7280             assign old-lvel = 0 .
     7281             Run PrintItog ("Всего по объекту " + temp-gds.obj-name, 2 ).
     7282             if xSumsOnly = yes then  put stream outstream   Line format frmt skip .
     7283           end.
     7284         end.
     7285       end.
     7286       else do:
     7287         for each temp-gds
     7288           break by temp-gds.cgrp-name
     7289                 by temp-gds.post-type
     7290                 by temp-gds.post-code
     7291                 by if xSortType = "sort-code" then  temp-gds.sb-code  Else (if xSortType = "sort-artic" then  temp-gds.artic Else  temp-gds.gds-name) :
     7292   define variable vss-include-info57 as character format "X(65)" no-undo
     7293   initial "@(#)$Workfile$ $Revision$".
     7294   if first-of(temp-gds.cgrp-name) then do:
     7295     assign
     7296       lvel = num-entries( right-trim(temp-gds.cgrp-name, chr(47)), chr(47) )
     7297     .
     7298     assign CurrGrpName = "" .
     7299     do ind = 1 to lvel :
     7300       assign CurrGrpName = CurrGrpName + entry ( ind, temp-gds.cgrp-name, chr(47) )  + chr(47) .
     7301       find first tt-grp-tree
     7302         where tt-grp-tree.full = CurrGrpName
     7303       no-error .
     7304       if not available tt-grp-tree then LEAVE.
     7305     end.
     7306     do ij = old-lvel to ind by -1 :
     7307       find first tt-grp-tree where tt-grp-tree.num = (ij + 3) .
     7308       if ij <= xvar-lavel-2 then do:
     7309         assign ItogStr = "" .
     7310         do jj = 1 to ij : assign ItogStr = ItogStr + "  " . end.
     7311         assign ItogStr = ItogStr + "Всего по гр. пост. " + tt-grp-tree.name .
     7312         run PrintItogGroup in this-procedure ( ItogStr, tt-grp-tree.fact-qnty, tt-grp-tree.free-qnty, tt-grp-tree.zak-sum, tt-grp-tree.naz-sum, tt-grp-tree.wait-qnty ) .
     7313       end.
     7314       delete tt-grp-tree .
     7315     end.
     7316     assign old-lvel = lvel .
     7317     run is-page .
     7318     put stream outstream   Line format frmt skip .
     7319     do ij = ind to lvel :
     7320       create tt-grp-tree .
     7321       if ij > ind then do:
     7322         assign CurrGrpName = CurrGrpName + entry ( ij, temp-gds.cgrp-name, chr(47) )  + chr(47) .
     7323       end.
     7324       assign
     7325         tt-grp-tree.num  = ij + 3
     7326         tt-grp-tree.full = CurrGrpName
     7327         tt-grp-tree.name = entry ( ij, temp-gds.cgrp-name, chr(47) )
     7328         tt-grp-tree.fact-qnty = 0
     7329         tt-grp-tree.free-qnty = 0
     7330         tt-grp-tree.zak-sum   = 0
     7331         tt-grp-tree.naz-sum   = 0
     7332         tt-grp-tree.wait-qnty = 0
     7333       .
     7334       if ij <= xvar-lavel-2 then do:
     7335         assign ItogStr = "" .
     7336         do jj = 1 to ij : assign ItogStr = ItogStr + "  " . end.
     7337         run PrintName ( ItogStr + "Гр. пост. " + tt-grp-tree.name, no ) .
     7338       end.
     7339     end.
     7340   end.
     7341   if first-of(temp-gds.post-code) then run PrintName ( ItogStr + "  Поставщик " + temp-gds.post-name, yes ) .
     7342   run PrintLine        in this-procedure .
     7343   if last-of(temp-gds.post-code)  then Run PrintItog ( ItogStr + "  Всего по поставщику " + temp-gds.post-name, 1).
     7344   for each tt-grp-tree :
     7345     assign
     7346       tt-grp-tree.fact-qnty = tt-grp-tree.fact-qnty + temp-gds.fact-qnty
     7347       tt-grp-tree.free-qnty = tt-grp-tree.free-qnty + temp-gds.free-qnty
     7348       tt-grp-tree.zak-sum   = tt-grp-tree.zak-sum   + temp-gds.zak-sum
     7349       tt-grp-tree.naz-sum   = tt-grp-tree.naz-sum   + temp-gds.naz-sum
     7350       tt-grp-tree.wait-qnty = tt-grp-tree.wait-qnty + temp-gds.wait-qnty
     7351     .
     7352   end.
     7353         end.
     7354         do ij = old-lvel to 1 by -1 :
     7355           find first tt-grp-tree where tt-grp-tree.num = (ij + 3) .
     7356           if ij <= xvar-lavel-2 then do:
     7357             assign ItogStr = "" .
     7358             do jj = 1 to ij : assign ItogStr = ItogStr + "  " . end.
     7359             assign ItogStr = ItogStr + "Всего по гр. пост. " + tt-grp-tree.name .
     7360             run PrintItogGroup in this-procedure ( ItogStr, tt-grp-tree.fact-qnty, tt-grp-tree.free-qnty, tt-grp-tree.zak-sum, tt-grp-tree.naz-sum, tt-grp-tree.wait-qnty ) .
     7361           end.
     7362           delete tt-grp-tree .
     7363         end.
     7364       end.
     7365     end.
     7366   end procedure.
     7367   procedure Run6 :
     7368     do on error undo, return error return-value :
     7369       if tog-obj then do:
     7370         for each temp-gds
     7371           break by temp-gds.obj-type
     7372                 by temp-gds.obj-code
     7373                 by temp-gds.cgrp-name
     7374                 by temp-gds.grp-name
     7375                 by temp-gds.post-type
     7376                 by temp-gds.post-code
     7377                 by if xSortType = "sort-code" then  temp-gds.sb-code  Else (if xSortType = "sort-artic" then  temp-gds.artic Else  temp-gds.gds-name) :
     7378           if first-of(temp-gds.obj-code)  then run PrintName ( temp-gds.obj-name, no ) .
     7379           if first-of(temp-gds.cgrp-name) then run PrintName ( "  Гр. пост. " + temp-gds.cgrp-name, no ) .
     7380           if first-of(temp-gds.grp-name)  then run PrintName ( "    Группа " + temp-gds.grp-name, no ) .
     7381           if first-of(temp-gds.post-code) then run PrintName ( "      Поставщик " + temp-gds.post-name, yes ) .
     7382           run PrintLine        in this-procedure .
     7383           if last-of(temp-gds.post-code)  then Run PrintItog ("      Всего по поставщику " + temp-gds.post-name, 1).
     7384           if last-of(temp-gds.grp-name)   then Run PrintItog ("    Всего по группе " + temp-gds.grp-name, 2).
     7385           if last-of(temp-gds.cgrp-name)  then Run PrintItog ("  Всего по гр. пост. " + temp-gds.cgrp-name, 3).
     7386           if last-of(temp-gds.obj-code)   then Run PrintItog ("Всего по объекту " + temp-gds.obj-name, 4).
     7387         end.
     7388       end.
     7389       else do:
     7390         for each temp-gds
     7391           break by temp-gds.cgrp-name
     7392                 by temp-gds.grp-name
     7393                 by temp-gds.post-type
     7394                 by temp-gds.post-code
     7395                 by if xSortType = "sort-code" then  temp-gds.sb-code  Else (if xSortType = "sort-artic" then  temp-gds.artic Else  temp-gds.gds-name) :
     7396           if first-of(temp-gds.cgrp-name) then run PrintName ( "Гр. пост. " + temp-gds.cgrp-name, no ) .
     7397           if first-of(temp-gds.grp-name)  then run PrintName ( "  Группа " + temp-gds.grp-name, no ) .
     7398           if first-of(temp-gds.post-code) then run PrintName ( "    Поставщик " + temp-gds.post-name, yes ) .
     7399           run PrintLine        in this-procedure .
     7400           if last-of(temp-gds.post-code)  then Run PrintItog ("    Всего по поставщику " + temp-gds.post-name, 1).
     7401           if last-of(temp-gds.grp-name)   then Run PrintItog ("  Всего по группе " + temp-gds.grp-name, 2).
     7402           if last-of(temp-gds.cgrp-name)  then Run PrintItog ("Всего по гр. пост. " + temp-gds.cgrp-name, 3).
     7403         end.
     7404       end.
     7405     end.
     7406   end procedure.
     7407   procedure Run7 :
     7408     do on error undo, return error return-value :
     7409       if tog-obj then do:
     7410         for each temp-gds
     7411           break by temp-gds.obj-type
     7412                 by temp-gds.obj-code
     7413                 by temp-gds.grp-name
     7414                 by temp-gds.cgrp-name
     7415                 by temp-gds.post-type
     7416                 by temp-gds.post-code
     7417                 by if xSortType = "sort-code" then  temp-gds.sb-code  Else (if xSortType = "sort-artic" then  temp-gds.artic Else  temp-gds.gds-name) :
     7418           if first-of(temp-gds.obj-code)  then run PrintName ( temp-gds.obj-name, no ) .
     7419           if first-of(temp-gds.grp-name)  then run PrintName ( "  Группа " + temp-gds.grp-name, no ) .
     7420           if first-of(temp-gds.cgrp-name) then run PrintName ( "    Гр. пост. " + temp-gds.cgrp-name, no ) .
     7421           if first-of(temp-gds.post-code) then run PrintName ( "      Поставщик " + temp-gds.post-name, yes ) .
     7422           run PrintLine        in this-procedure .
     7423           if last-of(temp-gds.post-code)  then Run PrintItog ("      Всего по поставщику " + temp-gds.post-name, 1).
     7424           if last-of(temp-gds.cgrp-name)  then Run PrintItog ("    Всего по гр. пост. " + temp-gds.cgrp-name, 2).
     7425           if last-of(temp-gds.grp-name)   then Run PrintItog ("  Всего по группе " + temp-gds.grp-name, 3).
     7426           if last-of(temp-gds.obj-code)   then Run PrintItog ("Всего по объекту " + temp-gds.obj-name, 4).
     7427         end.
     7428       end.
     7429       else do:
     7430         for each temp-gds
     7431           break by temp-gds.grp-name
     7432                 by temp-gds.cgrp-name
     7433                 by temp-gds.post-type
     7434                 by temp-gds.post-code
     7435                 by if xSortType = "sort-code" then  temp-gds.sb-code  Else (if xSortType = "sort-artic" then  temp-gds.artic Else  temp-gds.gds-name) :
     7436           if first-of(temp-gds.grp-name) then  run PrintName ( "Группа " + temp-gds.grp-name, no ) .
     7437           if first-of(temp-gds.cgrp-name) then run PrintName ( "  Гр. пост. " + temp-gds.cgrp-name, no ) .
     7438           if first-of(temp-gds.post-code) then run PrintName ( "    Поставщик " + temp-gds.post-name, yes ) .
     7439           run PrintLine        in this-procedure .
     7440           if last-of(temp-gds.post-code)  then Run PrintItog ("    Всего по поставщику " + temp-gds.post-name, 1).
     7441           if last-of(temp-gds.cgrp-name)  then Run PrintItog ("  Всего по гр. пост. " + temp-gds.cgrp-name, 2).
     7442           if last-of(temp-gds.grp-name)   then Run PrintItog ("Всего по группе " + temp-gds.grp-name, 3).
     7443         end.
     7444       end.
     7445     end.
     7446   end procedure.
     7447   procedure CalcWaitQnty :
     7448       do on error undo, return error return-value :
     7449           define input  parameter p-ext-doc-type as character no-undo .
     7450           define buffer buf_doc-line for doc-line .
     7451           define buffer buf_parts    for parts .
     7452           for each buf_doc-line no-lock
     7453               where buf_doc-line.obj-type     = obj-list.obj-type
     7454               and buf_doc-line.obj-code     = obj-list.obj-code
     7455               and buf_doc-line.prod-type    = buf_gds-obj.prod-type
     7456               and buf_doc-line.prod-code    = buf_gds-obj.prod-code
     7457               and buf_doc-line.artic        = buf_gds-obj.artic
     7458               and buf_doc-line.ext-doc-type = p-ext-doc-type
     7459               and buf_doc-line.status_      = 'накл':U
     7460               :
     7461               for each buf_parts no-lock
     7462                   where buf_parts.out-code     = buf_doc-line.doc-code
     7463                   and buf_parts.obj-type     = buf_doc-line.obj-type
     7464                   and buf_parts.obj-code     = buf_doc-line.obj-code
     7465                   and buf_parts.prod-type    = buf_doc-line.prod-type
     7466                   and buf_parts.prod-code    = buf_doc-line.prod-code
     7467                   and buf_parts.artic        = buf_doc-line.artic
     7468                   :
     7469                   if x-RADPost = 2 then
     7470                   do:
     7471                       find first g#post where g#post.obj-type = buf_parts.supp-type and g#post.obj-code  = buf_parts.supp-code no-error .
     7472                       if not available g#post then next.
     7473                   end.
     7474                   if xtype-stor <> 1 then
     7475                   do:
     7476                       if buf_parts.purch-code <>  xtype-stor - 1 then next.
     7477                   end.
     7478                   if ( p-ext-doc-type = 'vt':U or p-ext-doc-type = 'vp':U ) and buf_parts.fact-qnty <= 0 then next .
     7479                   if tog-obj = true then
     7480                   do:
     7481                       find first temp-gds
     7482                           where temp-gds.prod-type = buf_parts.prod-type
     7483                           and temp-gds.prod-code = buf_parts.prod-code
     7484                           and temp-gds.artic     = buf_parts.artic
     7485                           and temp-gds.in-code   = buf_parts.in-code
     7486                           and temp-gds.part-code = buf_parts.part-code
     7487                           and temp-gds.obj-type  = buf_parts.obj-type
     7488                           and temp-gds.obj-code  = buf_parts.obj-code
     7489                           and temp-gds.post-type = buf_parts.supp-type
     7490                           and temp-gds.post-code = buf_parts.supp-code
     7491                           no-error .
     7492                   end.
     7493                   else
     7494                   do:
     7495                       find first temp-gds
     7496                           where temp-gds.prod-type = buf_parts.prod-type
     7497                           and temp-gds.prod-code = buf_parts.prod-code
     7498                           and temp-gds.artic     = buf_parts.artic
     7499                           and temp-gds.in-code   = buf_parts.in-code
     7500                           and temp-gds.part-code = buf_parts.part-code
     7501                           and temp-gds.post-type = buf_parts.supp-type
     7502                           and temp-gds.post-code = buf_parts.supp-code
     7503                           no-error .
     7504                   end.
     7505                   if not available temp-gds then
     7506                   do:
     7507                       run CreateGDS ( buf_parts.artic, buf_parts.prod-type, buf_parts.prod-code, buf_parts.in-code, buf_parts.part-code, buf_parts.supp-type, buf_parts.supp-code) .
     7508                   end.
     7509                   assign
     7510                       temp-gds.wait-qnty = temp-gds.wait-qnty + buf_parts.fact-qnty  .
     7511               end.
     7512           end.
     7513       end.
     7514   end procedure.
     7515   procedure CreateGDS :
     7516       do on error undo, return error return-value :
     7517           define input  parameter p-artic     like parts.artic     no-undo.
     7518           define input  parameter p-prod-type like parts.prod-type no-undo.
     7519           define input  parameter p-prod-code like parts.prod-code no-undo.
     7520           define input  parameter p-in-code   like parts.in-code   no-undo.
     7521           define input  parameter p-part-code like parts.part-code no-undo.
     7522           define input  parameter p-supp-type like parts.supp-type no-undo.
     7523           define input  parameter p-supp-code like parts.supp-code no-undo.
     7524           find first buf_goods no-lock where buf_goods.artic = p-artic and buf_goods.prod-type = p-prod-type and buf_goods.prod-code = p-prod-code .
     7525           create temp-gds .
     7526   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     7527     (input  buf_goods.gds-code
     7528     ,input  ?
     7529     ,output temp-gds.b-code
     7530     ) no-error .
     7531           if error-status :error then
     7532           do:
     7533               message   vss-workfile vss-revision vss-description skip
     7534                   "Ошибка при определении бар-кода товара" skip
     7535                   "Артикул товара" skip buf_goods.artic
     7536                   view-as alert-box error .
     7537           end.
     7538           else assign temp-gds.sb-code = string(temp-gds.b-code) .
     7539   define variable vss-include-info58 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7540   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     7541     (input  buf_goods.gds-code
     7542     ,input  '1':U
     7543     ,input  ?
     7544     ,input  v-cntxt-host-code-obj
     7545     ,input  obj-list.obj-type
     7546     ,input  obj-list.obj-code
     7547     ,output temp-gds.vat-pc
     7548     ) no-error .
     7549           find first buf_clients no-lock where buf_clients.obj-type = p-supp-type and buf_clients.obj-code = p-supp-code no-error .
     7550           if available buf_clients then
     7551           do:
     7552               assign
     7553                   temp-gds.cgrp-code = buf_clients.grp-code
     7554                   temp-gds.cgrp-name = trim( buf_clients.grp-name )
     7555                   temp-gds.post-name = buf_clients.obj-name
     7556                   .
     7557           end.
     7558           find first buf_clients no-lock where buf_clients.obj-type = p-prod-type and buf_clients.obj-code = p-prod-code no-error .
     7559           assign
     7560               temp-gds.prod-name = buf_clients.obj-name
     7561               temp-gds.prod-type = buf_goods.prod-type
     7562               temp-gds.prod-code = buf_goods.prod-code
     7563               temp-gds.post-type = p-supp-type
     7564               temp-gds.post-code = p-supp-code
     7565               temp-gds.artic     = buf_goods.artic
     7566               temp-gds.obj-type  = obj-list.obj-type
     7567               temp-gds.obj-code  = obj-list.obj-code
     7568               temp-gds.obj-name  = obj-list.obj-name
     7569               temp-gds.unit-base = buf_goods.unit-base
     7570               temp-gds.gds-name1 = buf_goods.engl-name
     7571               temp-gds.gds-name  = buf_goods.gds-name
     7572               temp-gds.in-code   = p-in-code
     7573               temp-gds.part-code = p-part-code
     7574               temp-gds.grp-code  = buf_goods.grp-code
     7575               temp-gds.grp-name  = trim( buf_goods.grp-name )
     7576               .
     7577       end.
     7578   end procedure.
     7579   procedure ColumnTitle :
     7580       do on error undo, return error return-value :
     7581           put stream outstream  skip cur-time-print() format "x(35)"  "Цены указаны в "  (if x-SET_val_TYPE = 1 then "РУБ" else x-base-type )  string( "Страница" ) AT 100 PAGE-NUMBER( outstream ) FORMAT ">>>>9" SKIP .
     7582           put stream outstream   Line format frmt skip .
     7583           if use-column[1]  = yes then  PUT stream OutStream  "|"  "№ п/п"              format "X(5)"  .
     7584           if use-column[2]  = yes then  PUT stream OutStream  "|"  "  Код"              format "X(10)" .
     7585           if use-column[3]  = yes then  PUT stream OutStream  "|"  "  Артикул"          format "X(16)" .
     7586           if use-column[4]  = yes then  PUT stream OutStream  "|"  "  Название товара"  format "X(40)" .
     7587           if use-column[5]  = yes then  PUT stream OutStream  "|"  "Ед."                format "X(3)"  .
     7588           if use-column[6]  = yes then  PUT stream OutStream  "|"   "Фактическое"       format "X(14)" .
     7589           if use-column[7]  = yes then  PUT stream OutStream  "|"   "Свободное"         format "X(14)" .
     7590           if use-column[8]  = yes then  PUT stream OutStream  "|"   "Учетная"           format "X(15)" .
     7591           if use-column[9]  = yes then  PUT stream OutStream  "|"   "Продажная"         format "X(15)" .
     7592           if use-column[10] = yes then  PUT stream OutStream  "|"   "Сумма в учет."     format "X(15)" .
     7593           if use-column[11] = yes then  PUT stream OutStream  "|"   "Сумма"             format "X(15)" .
     7594           if use-column[12] = yes then  PUT stream OutStream  "|"   "Процент"           format "X(9)"  .
     7595           if use-column[13] = yes then  PUT stream OutStream  "|"   "Ожидаемое"         format "X(13)" .
     7596           PUT stream OutStream "|"   skip .
     7597           if use-column[1]  = yes then  PUT stream OutStream  "|"  ""                   format "X(5)"  .
     7598           if use-column[2]  = yes then  PUT stream OutStream  "|"  ""                   format "X(10)" .
     7599           if use-column[3]  = yes then  PUT stream OutStream  "|"  ""                   format "X(16)" .
     7600           if use-column[4]  = yes then  PUT stream OutStream  "|"  ""                   format "X(40)" .
     7601           if use-column[5]  = yes then  PUT stream OutStream  "|"  "изм"                format "X(3)"  .
     7602           if use-column[6]  = yes then  PUT stream OutStream  "|"   "кол-во"            format "X(14)" .
     7603           if use-column[7]  = yes then  PUT stream OutStream  "|"   "кол-во"            format "X(14)" .
     7604           if use-column[8]  = yes then  PUT stream OutStream  "|"   "цена с НДС"        format "X(15)" .
     7605           if use-column[9]  = yes then  PUT stream OutStream  "|"   "цена"              format "X(15)" .
     7606           if use-column[10] = yes then  PUT stream OutStream  "|"   "ценах с НДС"       format "X(15)" .
     7607           if use-column[11] = yes then  PUT stream OutStream  "|"   "наценки"           format "X(15)" .
     7608           if use-column[12] = yes then  PUT stream OutStream  "|"   "наценки"           format "X(9)"  .
     7609           if use-column[13] = yes then  PUT stream OutStream  "|"   "кол-во"            format "X(13)" .
     7610           put stream outstream "|" skip  Line format frmt skip .
     7611       end.
     7612   end procedure.
     7613   procedure is-page :
     7614       do on error undo, return error return-value :
     7615           if line-counter( Outstream ) + 2 > page-size( Outstream ) then
     7616           do:
     7617               put stream outstream  skip Line format frmt skip
     7618                   "продолжение - на следующей странице" AT 30 SKIP .
     7619               page stream OutStream .
     7620               run ColumnTitle .
     7621           end.
     7622       end.
     7623   end procedure.
     7624   procedure PrintLine :
     7625       do on error undo, return error return-value :
     7626           if temp-gds.fact-qnty <> 0 then
     7627           do:
     7628               assign
     7629                   temp-gds.zak-price  = temp-gds.zak-sum  / abs ( temp-gds.fact-qnty)
     7630                   temp-gds.prod-price = temp-gds.prod-sum / abs ( temp-gds.fact-qnty)
     7631                   .
     7632           end.
     7633           assign
     7634               temp-gds.naz-sum = temp-gds.prod-sum - temp-gds.zak-sum
     7635               temp-gds.naz-prc = if temp-gds.zak-sum = 0 then 0 else temp-gds.naz-sum * 100 / temp-gds.zak-sum
     7636               .
     7637           find first temp-sum where temp-sum.num = 0 no-error .
     7638           if not available temp-sum then
     7639           do:
     7640               create temp-sum .
     7641               assign
     7642                   temp-sum.num = 0 .
     7643           end.
     7644           assign
     7645               temp-sum.fact-qnty = temp-sum.fact-qnty + temp-gds.fact-qnty
     7646               temp-sum.free-qnty = temp-sum.free-qnty + temp-gds.free-qnty
     7647               temp-sum.wait-qnty = temp-sum.wait-qnty + temp-gds.wait-qnty
     7648               temp-sum.zak-sum   = temp-sum.zak-sum   + temp-gds.zak-sum
     7649               temp-sum.naz-sum   = temp-sum.naz-sum   + temp-gds.naz-sum
     7650               .
     7651           if xSumsOnly = no then
     7652           do:
     7653               assign
     7654                   num-line = num-line + 1 .
     7655               run is-page .
     7656               IF  NOT (NOT xshowzero  AND (temp-gds.fact-qnty = 0 and temp-gds.free-qnty = 0)) then
     7657               do:
     7658                   if use-column[1]  = yes then
     7659                   do:
     7660                       PUT stream OutStream  "|"   num-line   format ">>>>9" .
     7661                       if Make-Excel then  put   stream ForExcel unformatted  string(num-line)   CHR(9) .
     7662                   end.
     7663                   if use-column[2]  = yes then
     7664                   do:
     7665                       PUT stream OutStream  "|"   temp-gds.sb-code     format "X(10)" .
     7666                       if Make-Excel then  put   stream ForExcel unformatted  temp-gds.sb-code   CHR(9) .
     7667                   end.
     7668                   if use-column[3]  = yes then
     7669                   do:
     7670                       PUT stream OutStream  "|"   temp-gds.artic       format "X(16)" .
     7671                       if Make-Excel then  put   stream ForExcel unformatted  temp-gds.artic   CHR(9) .
     7672                   end.
     7673                   if use-column[4]  = yes then
     7674                   do:
     7675                       PUT stream OutStream  "|"   temp-gds.gds-name    format "X(40)" .
     7676                       if Make-Excel then  put   stream ForExcel unformatted  temp-gds.gds-name   CHR(9) .
     7677                   end.
     7678                   if use-column[5]  = yes then
     7679                   do:
     7680                       PUT stream OutStream  "|"   temp-gds.unit-base   format "X(3)" .
     7681                       if Make-Excel then  put   stream ForExcel unformatted   temp-gds.unit-base  CHR(9) .
     7682                   end.
     7683                   if use-column[6]  = yes then
     7684                   do:
     7685                       PUT stream OutStream  "|"   temp-gds.fact-qnty   format "->>>>>>>>9.999" .
     7686                       if Make-Excel then  put   stream ForExcel unformatted  excel-qnty ( temp-gds.fact-qnty )   CHR(9) .
     7687                   end.
     7688                   if use-column[7]  = yes then
     7689                   do:
     7690                       PUT stream OutStream  "|"   temp-gds.free-qnty   format "->>>>>>>>9.999".
     7691                       if Make-Excel then  put   stream ForExcel unformatted  excel-qnty ( temp-gds.free-qnty )   CHR(9) .
     7692                   end.
     7693                   if use-column[8]  = yes then
     7694                   do:
     7695                       PUT stream OutStream  "|"   temp-gds.zak-price   format "->>>>>>>>>>9.99" .
     7696                       if Make-Excel then  put   stream ForExcel unformatted  excel-sum ( temp-gds.zak-price )  CHR(9) .
     7697                   end.
     7698                   if use-column[9]  = yes then
     7699                   do:
     7700                       PUT stream OutStream  "|"   temp-gds.prod-price  format "->>>>>>>>>>9.99" .
     7701                       if Make-Excel then  put   stream ForExcel unformatted  excel-sum ( temp-gds.prod-price )  CHR(9) .
     7702                   end.
     7703                   if use-column[10] = yes then
     7704                   do:
     7705                       PUT stream OutStream  "|"   temp-gds.zak-sum     format "->>>>>>>>>>9.99" .
     7706                       if Make-Excel then  put   stream ForExcel unformatted  excel-sum ( temp-gds.zak-sum )  CHR(9) .
     7707                   end.
     7708                   if use-column[11] = yes then
     7709                   do:
     7710                       PUT stream OutStream  "|"   temp-gds.naz-sum     format "->>>>>>>>>>9.99" .
     7711                       if Make-Excel then  put   stream ForExcel unformatted  excel-sum ( temp-gds.naz-sum )  CHR(9) .
     7712                   end.
     7713                   if use-column[12] = yes then
     7714                   do:
     7715                       PUT stream OutStream  "|"   temp-gds.naz-prc     format "->>>>9.99" .
     7716                       if Make-Excel then  put   stream ForExcel unformatted  excel-sum ( temp-gds.naz-prc )  CHR(9) .
     7717                   end.
     7718                   if use-column[13] = yes then
     7719                   do:
     7720                       PUT stream OutStream  "|"   temp-gds.wait-qnty   format "->>>>>>>9.999" .
     7721                       if Make-Excel then  put   stream ForExcel unformatted  excel-qnty ( temp-gds.wait-qnty )   CHR(9) .
     7722                   end.
     7723                   if Make-Excel then  put   stream ForExcel unformatted chr(10) .
     7724                   PUT stream OutStream "|" skip  .
     7725               end.
     7726           end.
     7727       end.
     7728   end procedure.
     7729   procedure PrintName :
     7730       do on error undo, return error return-value :
     7731           define input  parameter str           as character no-undo .
     7732           define input  parameter is-term       as logical   no-undo .
     7733           if xSumsOnly = no or is-term = no then
     7734           do:
     7735               run is-page .
     7736               PUT stream OutStream  "|"  str format frmt1 "|" skip .
     7737               if Make-Excel then  put   stream ForExcel unformatted   str  chr(10) .
     7738           end.
     7739       end.
     7740   end procedure.
     7741   procedure PrintItog :
     7742       do on error undo, return error return-value :
     7743           define input  parameter str           as character no-undo .
     7744           define input  parameter  level        as integer   no-undo .
     7745           define variable sum-fact-qnty as decimal no-undo .
     7746           define variable sum-free-qnty as decimal no-undo .
     7747           define variable sum-zak-sum   as decimal no-undo .
     7748           define variable sum-naz-sum   as decimal no-undo .
     7749           define variable sum-wait-qnty as decimal no-undo .
     7750           if level = 0 then  find last  temp-sum use-index pi no-error  .
     7751           else               find first temp-sum where temp-sum.num = ( level - 1 ) no-error .
     7752           if available temp-sum then
     7753           do:
     7754               assign
     7755                   sum-fact-qnty      = temp-sum.fact-qnty
     7756                   sum-free-qnty      = temp-sum.free-qnty
     7757                   sum-zak-sum        = temp-sum.zak-sum
     7758                   sum-naz-sum        = temp-sum.naz-sum
     7759                   sum-wait-qnty      = temp-sum.wait-qnty
     7760                   temp-sum.fact-qnty = 0
     7761                   temp-sum.free-qnty = 0
     7762                   temp-sum.wait-qnty = 0
     7763                   temp-sum.zak-sum   = 0
     7764                   temp-sum.naz-sum   = 0
     7765                   .
     7766           end.
     7767           if xSumsOnly = no then
     7768           do:
     7769               run is-page .
     7770               put stream outstream   Line format frmt skip .
     7771           end.
     7772                       IF  NOT (NOT xshowzero  AND ( sum-fact-qnty = 0 and  sum-free-qnty = 0)) then
     7773           do:
     7774           run is-page .
     7775           PUT stream OutStream  "|"  str  format frmt2 .
     7776           do i = 1 to 5 :
     7777               if i = 3 and use-column[3] then  if Make-Excel then  put   stream ForExcel unformatted   str .
     7778               if use-column[i]  = yes then   if Make-Excel then  put   stream ForExcel unformatted   CHR(9)  .
     7779           end.
     7780           if use-column[6]  = yes then
     7781           do:
     7782               PUT stream OutStream  "|"   sum-fact-qnty   format "->>>>>>>>9.999" .
     7783               if Make-Excel then  put   stream ForExcel unformatted  excel-qnty ( sum-fact-qnty )   CHR(9) .
     7784           end.
     7785           if use-column[7]  = yes then
     7786           do:
     7787               PUT stream OutStream  "|"   sum-free-qnty   format "->>>>>>>>9.999".
     7788               if Make-Excel then  put   stream ForExcel unformatted  excel-qnty ( sum-free-qnty )   CHR(9) .
     7789           end.
     7790           if use-column[8]  = yes then
     7791           do:
     7792               PUT stream OutStream  "|"   format "X(16)" .
     7793               if Make-Excel then  put   stream ForExcel unformatted  CHR(9) .
     7794           end.
     7795           if use-column[9]  = yes then
     7796           do:
     7797               PUT stream OutStream  "|"   format "X(16)" .
     7798               if Make-Excel then  put   stream ForExcel unformatted  CHR(9) .
     7799           end.
     7800           if use-column[10] = yes then
     7801           do:
     7802               PUT stream OutStream  "|"   sum-zak-sum     format "->>>>>>>>>>9.99" .
     7803               if Make-Excel then  put   stream ForExcel unformatted  excel-sum ( sum-zak-sum )  CHR(9) .
     7804           end.
     7805           if use-column[11] = yes then
     7806           do:
     7807               PUT stream OutStream  "|"   sum-naz-sum     format "->>>>>>>>>>9.99" .
     7808               if Make-Excel then  put   stream ForExcel unformatted  excel-sum ( sum-naz-sum )  CHR(9) .
     7809           end.
     7810           if use-column[12] = yes then
     7811           do:
     7812               PUT stream OutStream  "|"   format "X(10)" .
     7813               if Make-Excel then  put   stream ForExcel unformatted  CHR(9) .
     7814           end.
     7815           if use-column[13] = yes then
     7816           do:
     7817               PUT stream OutStream  "|"   sum-wait-qnty   format "->>>>>>>9.999" .
     7818               if Make-Excel then  put   stream ForExcel unformatted  excel-qnty ( sum-wait-qnty )   CHR(9) .
     7819           end.
     7820           if Make-Excel then  put   stream ForExcel unformatted chr(10) .
     7821           PUT stream OutStream "|" skip  .
     7822           end.
     7823           if xSumsOnly = no or level = 0 then  put stream outstream   Line format frmt skip .
     7824           if level > 0  then
     7825           do:
     7826               run is-page .
     7827               find first temp-sum where temp-sum.num = level no-error .
     7828               if not available temp-sum then
     7829               do:
     7830                   create temp-sum .
     7831                   assign
     7832                       temp-sum.num = level .
     7833               end.
     7834               assign
     7835                   temp-sum.fact-qnty = temp-sum.fact-qnty + sum-fact-qnty
     7836                   temp-sum.free-qnty = temp-sum.free-qnty + sum-free-qnty
     7837                   temp-sum.wait-qnty = temp-sum.wait-qnty + sum-wait-qnty
     7838                   temp-sum.zak-sum   = temp-sum.zak-sum   + sum-zak-sum
     7839                   temp-sum.naz-sum   = temp-sum.naz-sum   + sum-naz-sum
     7840                   .
     7841           end.
     7842       end.
     7843   end procedure.
     7844   procedure PrintItogGroup :
     7845       do on error undo, return error return-value :
     7846           define input  parameter str           as character no-undo .
     7847           define input  parameter sum-fact-qnty as decimal   no-undo .
     7848           define input  parameter sum-free-qnty as decimal   no-undo .
     7849           define input  parameter sum-zak-sum   as decimal   no-undo .
     7850           define input  parameter sum-naz-sum   as decimal   no-undo .
     7851           define input  parameter sum-wait-qnty as decimal   no-undo .
     7852           run is-page .
     7853           PUT stream OutStream  "|"  str  format frmt2 .
     7854           do i = 1 to 5 :
     7855               if i = 3 and use-column[3] then  if Make-Excel then  put   stream ForExcel unformatted   str .
     7856               if use-column[i]  = yes then   if Make-Excel then  put   stream ForExcel unformatted   CHR(9)  .
     7857           end.
     7858           if use-column[6]  = yes then
     7859           do:
     7860               PUT stream OutStream  "|"   sum-fact-qnty   format "->>>>>>>>9.999" .
     7861               if Make-Excel then  put   stream ForExcel unformatted  excel-qnty ( sum-fact-qnty )   CHR(9) .
     7862           end.
     7863           if use-column[7]  = yes then
     7864           do:
     7865               PUT stream OutStream  "|"   sum-free-qnty   format "->>>>>>>>9.999".
     7866               if Make-Excel then  put   stream ForExcel unformatted  excel-qnty ( sum-free-qnty )   CHR(9) .
     7867           end.
     7868           if use-column[8]  = yes then
     7869           do:
     7870               PUT stream OutStream  "|"   format "X(16)" .
     7871               if Make-Excel then  put   stream ForExcel unformatted  CHR(9) .
     7872           end.
     7873           if use-column[9]  = yes then
     7874           do:
     7875               PUT stream OutStream  "|"   format "X(16)" .
     7876               if Make-Excel then  put   stream ForExcel unformatted  CHR(9) .
     7877           end.
     7878           if use-column[10] = yes then
     7879           do:
     7880               PUT stream OutStream  "|"   sum-zak-sum     format "->>>>>>>>>>9.99" .
     7881               if Make-Excel then  put   stream ForExcel unformatted  excel-sum ( sum-zak-sum )  CHR(9) .
     7882           end.
     7883           if use-column[11] = yes then
     7884           do:
     7885               PUT stream OutStream  "|"   sum-naz-sum     format "->>>>>>>>>>9.99" .
     7886               if Make-Excel then  put   stream ForExcel unformatted  excel-sum ( sum-naz-sum )  CHR(9) .
     7887           end.
     7888           if use-column[12] = yes then
     7889           do:
     7890               PUT stream OutStream  "|"   format "X(10)" .
     7891               if Make-Excel then  put   stream ForExcel unformatted  CHR(9) .
     7892           end.
     7893           if use-column[13] = yes then
     7894           do:
     7895               PUT stream OutStream  "|"   sum-wait-qnty   format "->>>>>>>9.999" .
     7896               if Make-Excel then  put   stream ForExcel unformatted  excel-qnty ( sum-wait-qnty )   CHR(9) .
     7897           end.
     7898           if Make-Excel then  put   stream ForExcel unformatted chr(10) .
     7899           PUT stream OutStream "|" skip  .
     7900       end.
     7901   end procedure.
