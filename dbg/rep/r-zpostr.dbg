     2110       define variable varvat-base-docovpprl       like ub.gds-dtl.price-base               no-undo.
     2111       define variable varvatcons-base-docovpprl   like ub.gds-dtl.price-base               no-undo.
     2112       define variable vardsc-base-docovpprl       like ub.gds-dtl.price-base               no-undo.
     2113       define variable varsum-rubl-factovpprl      like ub.gds-dtl.price-base               no-undo.
     2114       define variable varslt-rubl-factovpprl      like ub.gds-dtl.price-base               no-undo.
