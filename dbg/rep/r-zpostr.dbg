     6042   define variable v-kol-spice3 as integer no-undo .
     6043   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     6044   DEFINE BUTTON StopBtn AUTO-END-KEY
     6045        LABEL "Стоп"
     6046        SIZE 10 BY 1.
     6047   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
