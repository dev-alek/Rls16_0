     6920         tt-grp-tree.full = CurrGrpName
     6921         tt-grp-tree.name = entry ( ij, temp-gds.grp-name, chr(47) )
     6922         tt-grp-tree.fact-qnty = 0
     6923         tt-grp-tree.free-qnty = 0
     6924         tt-grp-tree.zak-sum   = 0
     6925         tt-grp-tree.naz-sum   = 0
     6926         tt-grp-tree.wait-qnty = 0
     6927       .
