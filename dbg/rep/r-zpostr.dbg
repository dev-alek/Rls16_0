     2964   procedure prdoclib-clear-temp-prt-obj :
     2965     define buffer buf_temp-prt-obj for temp-prt-obj .
     2966     do
     2967     on error undo, return error return-value
     2968     :
     2969       for each buf_temp-prt-obj
     2970       on error undo, return error return-value
     2971       :
     2972         delete buf_temp-prt-obj .
     2973       end.
     2974     end.
     2975   end procedure.
     2976   procedure prdoclib-create-temp-prt-obj :
     2977     define input parameter  p-root-price-sale like ub.price-list.price-sale no-undo .
     2978     define parameter buffer buf_prt-obj       for ub.prt-obj .
     2979     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
     2980     define buffer buf_gds-prt for ub.gds-prt .
     2981     do
     2982     on error undo, return error return-value
     2983     :
     2984       find first buf_temp-prt-obj
     2985         where buf_temp-prt-obj.prt-code = buf_prt-obj.prt-code
     2986         no-error .
     2987       if not available buf_temp-prt-obj
     2988       then do:
     2989         create buf_temp-prt-obj .
     2990         assign
     2991           buf_temp-prt-obj.prt-code         = buf_prt-obj.prt-code
     2992           buf_temp-prt-obj.price-sale       = ?
     2993           buf_temp-prt-obj.fact-qnty        = buf_prt-obj.fact-qnty
     2994           buf_temp-prt-obj.price-list-qnty  = ?
     2995           buf_temp-prt-obj.prt-obj-recid    = recid(buf_prt-obj)
     2996           buf_temp-prt-obj.price-list-recid = ?
     2997         .
     2998         find first buf_gds-prt no-lock
     2999           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     3000           .
     3001         assign
     3002           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     3003         .
     3004         if buf_temp-prt-obj.is-term
     3005         then do:
     3006           assign
     3007             buf_temp-prt-obj.price-sale = p-root-price-sale
     3008           .
     3009         end.
     3010       end.
     3011     end.
     3012   end procedure.
     3013   procedure prdoclib-temp-prt-obj-by-prt-root :
     3014     define input parameter  p-prt-code like ub.prt-obj.prt-code no-undo .
     3015     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
     3016     define buffer buf_gds-prt for ub.gds-prt .
     3017     do
     3018     on error undo, return error return-value
     3019     :
     3020       find first buf_temp-prt-obj
     3021         where buf_temp-prt-obj.prt-code = p-prt-code
     3022         no-error .
     3023       if not available buf_temp-prt-obj
     3024       then do:
     3025         create buf_temp-prt-obj .
     3026         assign
     3027           buf_temp-prt-obj.prt-code         = p-prt-code
     3028           buf_temp-prt-obj.price-sale       = ?
     3029           buf_temp-prt-obj.fact-qnty        = 0
     3030           buf_temp-prt-obj.price-list-qnty  = ?
     3031           buf_temp-prt-obj.prt-obj-recid    = ?
     3032           buf_temp-prt-obj.price-list-recid = ?
     3033         .
     3034         find first buf_gds-prt no-lock
     3035           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     3036           .
     3037         assign
     3038           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     3039         .
     3040         if buf_temp-prt-obj.is-term
     3041         then do:
     3042           assign
     3043             buf_temp-prt-obj.price-sale = 0
     3044           .
     3045         end.
     3046       end.
     3047     end.
     3048   end procedure.
     3049   procedure prdoclib-init-temp-prt-obj :
     3050     define input parameter p-obj-type        like ub.prt-obj.obj-type  no-undo .
     3051     define input parameter p-obj-code        like ub.prt-obj.obj-code  no-undo .
     3052     define input parameter p-artic           like ub.prt-obj.artic     no-undo .
     3053     define input parameter p-prod-type       like ub.prt-obj.prod-type no-undo .
     3054     define input parameter p-prod-code       like ub.prt-obj.prod-code no-undo .
     3055     define input parameter p-root-price-sale like ub.prt-obj.price-sale no-undo .
     3056     define buffer buf_prt-obj      for ub.prt-obj .
     3057     define buffer buf_temp-prt-obj for temp-prt-obj .
     3058     do
     3059     on error undo, return error return-value
     3060     :
     3061       run prdoclib-clear-temp-prt-obj in this-procedure .
     3062       for each buf_prt-obj
     3063         where buf_prt-obj.obj-type  = p-obj-type
     3064           and buf_prt-obj.obj-code  = p-obj-code
     3065           and buf_prt-obj.artic     = p-artic
     3066           and buf_prt-obj.prod-type = p-prod-type
     3067           and buf_prt-obj.prod-code = p-prod-code
     3068       on error undo, return error return-value
     3069       :
     3070         run prdoclib-create-temp-prt-obj in this-procedure
     3071           (input  p-root-price-sale
     3072           ,buffer buf_prt-obj
     3073           ,buffer buf_temp-prt-obj
     3074           ).
     3075       end.
     3076     end.
     3077   end procedure.
     3078   procedure prdoclib-calc-fact-sale :
     3079     define input  parameter p-price-list-recid   as recid     no-undo .
     3080     define output parameter p-fact-qnty          as decimal   no-undo .
     3081     define output parameter p-cur-base           as decimal   no-undo .
     3082     define output parameter p-cur-VAT-base       as decimal   no-undo .
     3083     define output parameter p-cur-SLT-base       as decimal   no-undo .
     3084     define output parameter p-cur-road-tax-base  as decimal   no-undo .
     3085     define output parameter p-cur-excise-base    as decimal   no-undo .
     3086     define buffer buf_main_price-list for ub.price-list .
