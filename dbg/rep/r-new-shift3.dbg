      116   .
      117   procedure create_obj-list :
      118      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      119      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      120      do
      121      on error undo, return error return-value
      122      :
      123         define buffer cli-obj for ub.clients .
      124         define variable p-var as integer no-undo .
      125         define buffer buf_obj-list for obj-list .
      126         find last buf_obj-list  use-index pi no-error .
      127         if available buf_obj-list
      128         then
      129            p-var = buf_obj-list.obj-id + 1.
      130         else
      131            p-var = 1.
      132         find first cli-obj where
      133                   cli-obj.obj-type = p-obj-type
      134               and cli-obj.obj-code = p-obj-code
      135         no-lock no-error.
      136         if available cli-obj
      137         then do:
      138            create buf_obj-list.
      139            assign
      140               buf_obj-list.obj-id   = p-var
      141               buf_obj-list.obj-code = cli-obj.obj-code
      142               buf_obj-list.obj-type = cli-obj.obj-type
      143               buf_obj-list.obj-name = cli-obj.obj-name
      144               buf_obj-list.db-num   = cli-obj.db-num
      145            .
      146         end.
      147      end.
      148   end.
