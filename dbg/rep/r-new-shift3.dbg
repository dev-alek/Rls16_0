      950   tbl-name
      951   uniq-key-rec
      952   .
      953   def var vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      954   procedure gen-key-rec :
      955     define input  parameter p-tbl-name    as character no-undo.
      956     define input  parameter p-bh_tbl-name as handle    no-undo.
      957     define output parameter p-key-rec     as character no-undo.
      958     do
      959     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      960     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      961     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      962     :
      963       define variable fh               as handle    no-undo .
      964       define variable v-ok             as logical   no-undo .
      965       define variable v-inform         as character no-undo .
      966       define variable v-ind            as integer   no-undo .
      967       define variable v-idx-field-qnty as integer   no-undo .
      968       if p-tbl-name = ?
      969         or p-tbl-name = "":U
      970       then do:
      971         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info17 ).
      972       end.
      973       if not p-bh_tbl-name:available then do:
      974         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info17, p-tbl-name ).
      975       end.
      976       assign
      977         p-key-rec = p-tbl-name
      978         v-inform  = p-bh_tbl-name:index-information(1)
      979         v-ind     = 2
      980       .
      981       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      982       on error undo, return error
      983       :
      984         assign
      985           v-inform = p-bh_tbl-name:index-information( v-ind )
      986           v-ind    = v-ind + 1
      987         .
      988       end.
      989       if v-inform = ?
      990         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      991         or entry( 3, v-inform, ",":U ) <> "1":U
      992       then do:
      993         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info17, p-tbl-name ).
      994       end.
      995       else do:
      996         assign
      997           v-idx-field-qnty = num-entries( v-inform ) - 4
      998         .
      999         if v-idx-field-qnty < 2 then do:
     1000           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info17, v-inform, p-tbl-name ).
     1001         end.
     1002         do v-ind = 1 to v-idx-field-qnty by 2
     1003         on error undo, return error
     1004         :
     1005           assign
     1006             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1007             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1008           .
     1009         end.
     1010       end.
     1011       if p-key-rec = ? then do:
     1012         assign
     1013           p-key-rec = "":U
     1014         .
     1015         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info17, p-tbl-name ).
     1016       end.
     1017     end.
     1018     return.
     1019   end procedure.
     1020   procedure gen-where-keyr-tab :
     1021     define input  parameter i-tableSerach as character no-undo.
     1022     define input  parameter i-tablekey   as character  no-undo.
     1023     define input  parameter p-key-rec    as character  no-undo.
     1024     define input  parameter p-key-handle as handle     no-undo .
     1025     define input  parameter p-db-name    as character  no-undo .
     1026     define input  parameter p-tt-handle  as handle     no-undo .
     1027     define output parameter o-Where      as character  no-undo.
     1028     do
     1029     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1030     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1031     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1032     :
     1033       define variable v-full-tbl-name  as character no-undo .
     1034       define variable bh_tbl-name      as handle    no-undo .
     1035       define variable fh_key           as handle    no-undo .
     1036       define variable fh_search        as handle    no-undo .
     1037       define variable v-field-num      as integer   no-undo .
     1038       define variable v-count-fld      as integer   no-undo .
     1039       define variable v-inform         as character no-undo .
     1040       define variable v-ind            as integer   no-undo .
     1041       define variable v-idx-field-qnty as integer   no-undo .
     1042       define variable v-field-name     as character no-undo .
     1043       define variable v-field-val      as character no-undo .
     1044       define variable v-word-link      as character no-undo .
     1045       define variable vTable           as character no-undo.
     1046       define variable bh_tbl-key       as handle    no-undo .
     1047       assign
     1048         p-key-rec = trim( p-key-rec )
     1049       .
     1050       if p-key-handle <> ? then do:
     1051         if not valid-handle(p-key-handle)
     1052            or p-key-handle:type <> "buffer"
     1053         then do:
     1054           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info17 ).
     1055         end.
     1056         if num-entries( p-key-rec, chr(3) ) > 1
     1057           or p-key-rec = ?
     1058           or p-key-rec = "":U
     1059         then do:
     1060           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info17, p-key-rec ).
     1061         end.
     1062       end.
     1063       else do:
     1064         if p-key-rec = ?
     1065           or p-key-rec = "":U
     1066         then do:
     1067           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info17 ).
     1068         end.
     1069       end.
     1070       assign
     1071         vTable = entry( 1 , p-key-rec, chr(3) )
     1072       .
     1073       if p-tt-handle <> ?
     1074         and ( not valid-handle(p-tt-handle)
     1075               or p-tt-handle:type <> "buffer"
     1076             )
     1077       then do:
     1078         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info17, vTable, chr(10) ).
     1079       end.
     1080       if p-tt-handle = ? then do:
     1081         assign
     1082           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1083         .
     1084         create buffer bh_tbl-name for table v-full-tbl-name .
     1085       end.
     1086       else do:
     1087         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1088       end.
     1089       assign
     1090         v-inform = bh_tbl-name:index-information(1)
     1091         v-ind    = 2
     1092       .
     1093       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1094       on error undo, return error
     1095       :
     1096         assign
     1097           v-inform = bh_tbl-name:index-information( v-ind )
     1098           v-ind    = v-ind + 1
     1099         .
     1100       end.
     1101       if v-inform = ?
     1102         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1103         or entry( 3, v-inform, ",":U ) <> "1":U
     1104       then do:
     1105         delete object bh_tbl-name no-error.
     1106         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info17, vTable ).
     1107       end.
     1108       assign
     1109         v-idx-field-qnty = num-entries( v-inform ) - 4
     1110       .
     1111       if v-idx-field-qnty < 2 then do:
     1112         delete object bh_tbl-name no-error.
     1113         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info17, v-inform, vTable ).
     1114       end.
     1115       assign
     1116         o-where     = "where":U
     1117         v-word-link = "":U
     1118         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1119         v-count-fld = 0
     1120       .
     1121       if i-tablekey ne "" and i-tablekey ne ?
     1122       then do:
     1123         assign
     1124           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1125         .
     1126         create buffer bh_tbl-key for table v-full-tbl-name .
     1127       end.
     1128       if i-tableSerach ne "" and i-tableSerach ne ?
     1129       then do:
     1130         delete object bh_tbl-name no-error.
     1131         assign
     1132           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1133         .
     1134         create buffer bh_tbl-name for table v-full-tbl-name .
     1135       end.
     1136       block_where:
     1137       do v-ind = 1 to v-idx-field-qnty by 2
     1138       on error undo, return error
     1139       :
     1140         assign
     1141           v-count-fld = v-count-fld + 1
     1142         .
     1143         if p-key-handle = ?
     1144           and v-count-fld > v-field-num
     1145         then do:
     1146           leave block_where.
     1147         end.
     1148         define variable VfieldKeyTable as handle no-undo.
     1149         assign
     1150           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1151           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1152         .
     1153         if     bh_tbl-key ne ?
     1154         then do:
     1155            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1156            if VfieldKeyTable eq ?
     1157            then next block_where.
     1158         end.
     1159         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1160         then
     1161            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1162         else
     1163            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1164         if p-key-handle = ? then do:
     1165           assign
     1166             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1167           .
     1168         end.
     1169         else do:
     1170           assign
     1171             fh_key = p-key-handle:buffer-field( v-field-name )
     1172           .
     1173           if fh_key = ?
     1174             or not valid-handle( fh_key )
     1175           then do:
     1176             delete object bh_tbl-name.
     1177             if     bh_tbl-key ne ?
     1178             then
     1179                delete object bh_tbl-key.
     1180             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info17, p-key-handle:name, v-field-name ).
     1181           end.
     1182           assign
     1183             v-field-val = fh_key:buffer-value
     1184           .
     1185         end.
     1186         if fh_search:data-type ="character":U then do:
     1187           assign
     1188             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1189             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1190             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1191             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1192             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1193             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1194             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1195             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1196             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1197             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1198             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1199             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1200             v-field-val = substitute( '"&1"', v-field-val )
     1201           .
     1202         end.
     1203         assign
     1204           o-where = substitute( "&1 &2", o-where, v-field-val )
     1205         .
     1206         if v-word-link = "":U then do:
     1207           assign
     1208             v-word-link = "and":U
     1209           .
     1210         end.
     1211       end.
     1212       delete object bh_tbl-name.
     1213       if     bh_tbl-key ne ?
     1214       then
     1215          delete object bh_tbl-key.
     1216       if p-key-handle = ?
     1217         and v-count-fld <> v-field-num
     1218       then do:
     1219         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info17, vTable ).
     1220       end.
     1221     end.
     1222   end procedure.
     1223   procedure gen-hn-keyr-tab :
     1224     define input  parameter i-tableSerach as character no-undo.
     1225     define input  parameter i-tablekey   as character no-undo.
     1226     define input  parameter p-key-rec    as character no-undo.
     1227     define input  parameter p-key-handle as handle    no-undo .
     1228     define input  parameter p-db-name    as character no-undo .
     1229     define input  parameter p-tt-handle  as handle    no-undo .
     1230     define input  parameter p-stts-lock  as integer   no-undo .
     1231     define output parameter o-hn         as handle    no-undo.
     1232     define variable v-full-tbl-name as character no-undo.
     1233     define variable v-where         as character no-undo.
     1234     define variable bh_tbl-name     as handle    no-undo.
     1235     define variable vTable          as character no-undo.
     1236     do
     1237     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1238     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1239     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1240         run gen-where-keyr-tab(i-tableSerach,
     1241                                i-tablekey,
     1242                                p-key-rec,
     1243                                p-key-handle,
     1244                                p-db-name,
     1245                                p-tt-handle,
     1246                                output v-where).
     1247         if i-tableSerach ne "" and i-tableSerach ne ?
     1248         then do:
     1249            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1250            create buffer bh_tbl-name for table v-full-tbl-name .
     1251         end.
     1252         else do:
     1253            if p-tt-handle = ? then do:
     1254               assign
     1255                  vTable = entry( 1 , p-key-rec, chr(3) )
     1256               .
     1257               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1258               create buffer bh_tbl-name for table v-full-tbl-name .
     1259            end.
     1260            else do:
     1261               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1262            end.
     1263         end.
     1264         if p-tt-handle = ? then do:
     1265            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1266         end.
     1267         else do:
     1268            bh_tbl-name:find-first( v-where ) no-error .
     1269         end.
     1270         o-hn = bh_tbl-name.
     1271      end.
     1272   end procedure.
     1273   procedure gen-hn-keyr :
     1274     define input  parameter p-key-rec    as character no-undo.
     1275     define input  parameter p-key-handle as handle    no-undo .
     1276     define input  parameter p-db-name    as character no-undo .
     1277     define input  parameter p-tt-handle  as handle    no-undo .
     1278     define input  parameter p-stts-lock  as integer   no-undo .
     1279     define output parameter o-hn         as handle    no-undo.
     1280     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1281   end.
     1282   procedure gen-row-keyr :
     1283     define input  parameter p-key-rec    as character no-undo.
     1284     define input  parameter p-key-handle as handle    no-undo .
     1285     define input  parameter p-db-name    as character no-undo .
     1286     define input  parameter p-tt-handle  as handle    no-undo .
     1287     define input  parameter p-stts-lock  as integer   no-undo .
     1288     define output parameter p-tbl-row    as rowid     no-undo.
     1289     define output parameter p-tbl-name   as character no-undo.
     1290     define variable vHn as handle no-undo.
     1291       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1292       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1293       p-tbl-name =  vHn:table.
     1294       delete object vHn no-error.
     1295     if p-tbl-row = ? then do:
     1296       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info17, p-tbl-name, p-key-rec ).
     1297     end.
     1298     else do:
     1299       return.
     1300     end.
     1301   end procedure.
     1302   procedure gen-key-fv :
     1303     define input  parameter p-key-rec    as character no-undo .
     1304     define output parameter p-field-list as character no-undo .
     1305     define output parameter p-value-list as character no-undo.
     1306     do
     1307     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1308     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1309     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1310     :
     1311       define variable v-full-tbl-name  as character no-undo .
     1312       define variable bh_tbl-name      as handle    no-undo .
     1313       define variable v-tbl-name       as character no-undo .
     1314       define variable v-field-num      as integer   no-undo .
     1315       define variable v-count-fld      as integer   no-undo .
     1316       define variable v-inform         as character no-undo .
     1317       define variable v-ind            as integer   no-undo .
     1318       define variable v-idx-field-qnty as integer   no-undo .
     1319       define variable v-delim-key      as character no-undo .
     1320       if p-key-rec = ?
     1321         or p-key-rec = "":U
     1322       then do:
     1323         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info17 ).
     1324       end.
     1325       assign
     1326         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1327         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1328       .
     1329       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1330       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info17 ).
     1331       assign
     1332         v-inform = bh_tbl-name:index-information(1)
     1333         v-ind    = 2
     1334       .
     1335       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1336       on error undo, return error
     1337       :
     1338         assign
     1339           v-inform = bh_tbl-name:index-information( v-ind )
     1340           v-ind    = v-ind + 1
     1341         .
     1342       end.
     1343       if v-inform = ?
     1344         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1345         or entry( 3, v-inform, ",":U ) <> "1":U
     1346       then do:
     1347         delete object bh_tbl-name no-error.
     1348         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info17, v-tbl-name ).
     1349       end.
     1350       assign
     1351         v-idx-field-qnty = num-entries( v-inform ) - 4
     1352       .
     1353       if v-idx-field-qnty < 2 then do:
     1354         delete object bh_tbl-name no-error.
     1355         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info17, v-inform, v-tbl-name ).
     1356       end.
     1357       assign
     1358         p-field-list = "":U
     1359         p-value-list = "":U
     1360         v-delim-key  = "":U
     1361         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1362         v-count-fld  = 0
     1363       .
     1364       block_where:
     1365       do v-ind = 1 to v-idx-field-qnty by 2
     1366       on error undo, return error
     1367       :
     1368         assign
     1369           v-count-fld = v-count-fld + 1
     1370         .
     1371         if v-count-fld > v-field-num then do:
     1372           leave block_where.
     1373         end.
     1374         assign
     1375           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1376           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1377         .
     1378         if v-ind = 1 then do:
     1379           assign
     1380             v-delim-key = chr(3)
     1381           .
     1382         end.
     1383       end.
     1384       delete object bh_tbl-name.
     1385       if v-count-fld <> v-field-num then do:
     1386         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info17, v-tbl-name ).
     1387       end.
     1388     end.
     1389   end procedure.
     1390   procedure gen-key-field :
     1391     define input  parameter p-table      as character no-undo .
     1392     define output parameter p-field-list as character no-undo .
     1393     do
     1394     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1395     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1396     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1397     :
     1398       define variable v-full-tbl-name  as character no-undo .
     1399       define variable bh_tbl-name      as handle    no-undo .
     1400       define variable v-tbl-name       as character no-undo .
     1401       define variable v-field-num      as integer   no-undo .
     1402       define variable v-count-fld      as integer   no-undo .
     1403       define variable v-inform         as character no-undo .
     1404       define variable v-ind            as integer   no-undo .
     1405       define variable v-idx-field-qnty as integer   no-undo .
     1406       define variable v-delim-key      as character no-undo .
     1407       if p-table = ?
     1408         or p-table = "":U
     1409       then do:
     1410         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info17 ).
     1411       end.
     1412       assign
     1413         v-tbl-name      = p-table
     1414         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1415       .
     1416       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1417       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info17 ).
     1418       assign
     1419         v-inform = bh_tbl-name:index-information(1)
     1420         v-ind    = 2
     1421       .
     1422       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1423       on error undo, return error
     1424       :
     1425         assign
     1426           v-inform = bh_tbl-name:index-information( v-ind )
     1427           v-ind    = v-ind + 1
     1428         .
     1429       end.
     1430       if v-inform = ?
     1431         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1432         or entry( 3, v-inform, ",":U ) <> "1":U
     1433       then do:
     1434         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info17, v-tbl-name ).
     1435       end.
     1436       assign
     1437         v-idx-field-qnty = num-entries( v-inform ) - 4
     1438       .
     1439       if v-idx-field-qnty < 2 then do:
     1440         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info17, v-inform, v-tbl-name ).
     1441       end.
     1442       assign
     1443         p-field-list = "":U
     1444         v-delim-key  = "":U
     1445         v-count-fld  = 0
     1446       .
     1447       block_where:
     1448       do v-ind = 1 to v-idx-field-qnty by 2
     1449       on error undo, return error
     1450       :
     1451         assign
     1452           v-count-fld = v-count-fld + 1
     1453         .
     1454         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1455         if v-ind = 1 then do:
     1456           assign
     1457             v-delim-key = chr(3)
     1458           .
     1459         end.
     1460       end.
     1461       delete object bh_tbl-name.
     1462     end.
     1463   end procedure.
     1464   procedure get-gate-file-name :
     1465   define input parameter p-gate-rec as character no-undo .
     1466   define output  parameter p-gate-file-name as character no-undo .
     1467   define buffer buf_clob-data for ub.clob-data.
     1468   define variable v-tbl-row as rowid no-undo .
     1469   define variable v-tbl-name as character no-undo .
     1470   run gen-row-keyr in this-procedure ( input p-gate-rec
     1471                                       ,input ?
     1472                                       ,input "ub"
     1473                                       ,input ?
     1474                                       ,input no-lock
     1475                                       ,output v-tbl-row
     1476                                       ,output v-tbl-name) no-error.
     1477   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1478                                                           ,vss-include-info15
     1479                                                           ,p-gate-rec).
     1480   find first buf_clob-data no-lock where
     1481             rowid(buf_clob-data) = v-tbl-row no-error.
     1482   if not available buf_clob-data then do:
     1483     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1484                                                             ,vss-include-info15
     1485                                                             ,p-gate-rec).
     1486   end.
     1487   p-gate-file-name = buf_clob-data.file-name.
     1488   end procedure.
     1489   procedure get-gate-rec :
     1490   define input  parameter p-gate-name as character no-undo .
     1491   define output parameter p-gate-rec as character no-undo .
     1492   define buffer buf_clob-bind for ub.clob-bind.
     1493   define buffer buf_clob-data for ub.clob-data.
     1494   main-block:
     1495   do
     1496   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info15, return-value, chr(10), error-status :get-message (1))
     1497   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info15 )
     1498   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info15 )
     1499   :
     1500       find first buf_clob-bind no-lock where
     1501                 buf_clob-bind.uniq-key-rec = p-gate-name
     1502             and buf_clob-bind.field-name = '':U
     1503             and buf_clob-bind.part-num = 1
     1504             and buf_clob-bind.resource-type = 'gate':U
     1505             no-error.
     1506       if not available buf_clob-bind then do:
     1507         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1508                                         , p-gate-name
     1509                                         ).
     1510       end.
     1511       find first buf_clob-data no-lock where
     1512                 buf_clob-data.db-num = buf_clob-bind.db-num
     1513             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1514       if not available buf_clob-data then do:
     1515         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1516                                         , buf_clob-bind.db-num
     1517                                         , buf_clob-bind.int64-id
     1518                                         , p-gate-name
     1519                                         ).
     1520       end.
     1521       run gen-key-rec in this-procedure ( input 'clob-data':U
     1522                                 ,input buffer buf_clob-data:handle
     1523                                 ,output p-gate-rec).
     1524   end.
     1525   end procedure.
     1526   procedure get-gate-by-name :
     1527   define input  parameter p-gate-name as character no-undo .
     1528   define output parameter p-gate-rec as character no-undo .
     1529   define output parameter p-dsh as handle no-undo .
     1530   define input-output  parameter p-xmlh as handle no-undo .
     1531   define variable v-ii as integer   no-undo .
     1532   define variable glog as logical   no-undo .
     1533   define variable v-longchar as longchar no-undo .
     1534   define variable v-txmlh as handle no-undo .
     1535   define variable v-db-num as integer no-undo .
     1536   define variable v-int64-id as int64 no-undo .
     1537   define buffer buf_clob-bind for ub.clob-bind.
     1538   define buffer buf_clob-data for ub.clob-data.
     1539   main-block:
     1540   do
     1541   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info15, return-value, chr(10), error-status :get-message (1))
     1542   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info15 )
     1543   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info15 )
     1544   :
     1545       find first buf_clob-bind no-lock where
     1546                 buf_clob-bind.uniq-key-rec = p-gate-name
     1547             and buf_clob-bind.field-name = '':U
     1548             and buf_clob-bind.part-num = 1
     1549             and buf_clob-bind.resource-type = 'gate':U
     1550             no-error.
     1551       if not available buf_clob-bind then do:
     1552         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1553                                         , p-gate-name
     1554                                         ).
     1555       end.
     1556       find first buf_clob-data no-lock where
     1557                 buf_clob-data.db-num = buf_clob-bind.db-num
     1558             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1559       if not available buf_clob-data then do:
     1560         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1561                                         , buf_clob-bind.db-num
     1562                                         , buf_clob-bind.int64-id
     1563                                         , p-gate-name
     1564                                         ).
     1565       end.
     1566       assign
     1567       v-longchar = buf_clob-data.cdata
     1568       .
     1569       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1570       if error-status :error then do:
     1571         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1572       end.
     1573       create dataset p-dsh .
     1574       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1575                                     , v-longchar
     1576                                     , ?
     1577                                     , ?
     1578                                     , ?
     1579                                     ) no-error.
     1580       v-longchar = '':U.
     1581       if error-status :error
     1582       or not glog
     1583       then do:
     1584         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     1585       end.
     1586       if not valid-handle(p-xmlh)
     1587       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1588         create temp-table v-txmlh.
     1589         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1590         v-txmlh:temp-table-prepare("temp-xml-tables").
     1591         p-xmlh = v-txmlh:default-buffer-handle.
     1592       end.
     1593       run gen-key-rec in this-procedure ( input 'clob-data':U
     1594                                 ,input buffer buf_clob-data:handle
     1595                                 ,output p-gate-rec).
     1596       do v-ii = 1 to p-dsh:num-buffers:
     1597         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1598         if not p-xmlh:available then do:
     1599           p-xmlh:buffer-create().
     1600           assign
     1601           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1602           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1603           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1604           p-xmlh::gate-handle_ = p-dsh
     1605           p-xmlh::uniq-gate-rec = p-gate-rec
     1606           p-xmlh::gate-name = p-dsh:name
     1607           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1608           .
     1609           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1610             assign
     1611             p-xmlh::order = -3.
     1612           end.
     1613         end.
     1614       end.
     1615   end.
     1616   end procedure.
     1617   procedure get-gate-by-rec :
     1618   define input  parameter p-gate-rec as character no-undo .
     1619   define output parameter p-dsh as handle no-undo .
     1620   define input-output  parameter p-xmlh as handle no-undo .
     1621   define input-output parameter p-longchar  as longchar no-undo .
     1622   define variable v-ii as integer   no-undo .
     1623   define variable glog as logical   no-undo .
     1624   define variable v-rowid as rowid no-undo .
     1625   define variable v-tbl-name as character no-undo .
     1626   define variable v-longchar as longchar no-undo .
     1627   define variable v-txmlh as handle no-undo .
     1628   define buffer buf_clob-data for ub.clob-data.
     1629   main-block:
     1630   do
     1631   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info15, return-value, chr(10), error-status :get-message (1))
     1632   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info15 )
     1633   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info15 )
     1634   :
     1635     run gen-row-keyr in this-procedure (
     1636                                           input  p-gate-rec
     1637                                           ,input  ?
     1638                                           ,input  "ub"
     1639                                           ,input  ?
     1640                                           ,input  NO-LOCK
     1641                                           ,output v-rowid
     1642                                           ,output v-tbl-name   ) no-error.
     1643       find first buf_clob-data no-lock where
     1644                 rowid(buf_clob-data) = v-rowid  no-error.
     1645       if not available buf_clob-data then do:
     1646         undo, return error substitute("Не найден CLOB  &1"
     1647                                         , p-gate-rec
     1648                                         ).
     1649       end.
     1650       assign
     1651       v-longchar = buf_clob-data.cdata
     1652       .
     1653       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1654       if error-status :error then do:
     1655         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1656       end.
     1657       create dataset p-dsh .
     1658       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1659                                     , v-longchar
     1660                                     , ?
     1661                                     , ?
     1662                                     , ?
     1663                                     ) no-error.
     1664       define variable v-esm as character no-undo .
     1665       v-esm = error-status:get-message(1) .
     1666       if p-longchar <> ? then do:
     1667         p-longchar = v-longchar.
     1668       end.
     1669       v-longchar = '':U.
     1670       if error-status :error
     1671       or not glog
     1672       then do:
     1673         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1674                                      , p-gate-rec
     1675                                      , p-gate-rec
     1676                                      , v-esm
     1677                                      ).
     1678       end.
     1679       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     1680       if not valid-handle(p-xmlh)
     1681       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1682         create temp-table v-txmlh.
     1683         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1684         v-txmlh:temp-table-prepare("temp-xml-tables").
     1685         p-xmlh = v-txmlh:default-buffer-handle.
     1686       end.
     1687       do v-ii = 1 to p-dsh:num-buffers:
     1688         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1689         if not p-xmlh:available then do:
     1690           p-xmlh:buffer-create().
     1691           assign
     1692           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1693           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1694           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1695           p-xmlh::gate-handle_ = p-dsh
     1696           p-xmlh::uniq-gate-rec = p-gate-rec
     1697           p-xmlh::gate-name = p-dsh:name
     1698           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1699           .
     1700           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1701             assign
     1702             p-xmlh::order = -3.
     1703           end.
     1704           p-xmlh:buffer-release().
     1705         end.
     1706       end.
     1707   end.
     1708   end procedure.
     1709   procedure get-gate-by-file :
     1710   define input  parameter p-schema-file-name as character no-undo .
     1711   define input  parameter p-gate-rec as character no-undo .
     1712   define output parameter p-dsh as handle no-undo .
     1713   define input-output  parameter p-xmlh as handle no-undo .
     1714   define variable v-ii as integer   no-undo .
     1715   define variable glog as logical   no-undo .
     1716   define variable v-rowid as rowid no-undo .
     1717   define variable v-tbl-name as character no-undo .
     1718   define variable v-longchar as longchar no-undo .
     1719   define variable v-txmlh as handle no-undo .
     1720   main-block:
     1721   do
     1722   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info15, return-value, chr(10), error-status :get-message (1))
     1723   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info15 )
     1724   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info15 )
     1725   :
     1726       COPY-LOB
     1727       FROM  FILE p-schema-file-name
     1728       TO  OBJECT v-longchar
     1729       no-convert
     1730       NO-ERROR .
     1731       if error-status :error then do:
     1732           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     1733                                     , p-schema-file-name
     1734                                 , chr(10)
     1735                                 , error-status:get-message(1) ).
     1736       end.
     1737       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1738       if error-status :error then do:
     1739         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     1740       end.
     1741       create dataset p-dsh .
     1742       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     1743                                     , v-longchar
     1744                                     , ?
     1745                                     , ?
     1746                                     , ?
     1747                                     ) no-error.
     1748       v-longchar = ''.
     1749       if error-status :error
     1750       or not glog
     1751       then do:
     1752         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     1753                                      , p-schema-file-name
     1754                                      ,chr(10)
     1755                                      , error-status:get-message(1)
     1756                                      ).
     1757       end.
     1758       if not valid-handle(p-xmlh)
     1759       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1760         create temp-table v-txmlh.
     1761         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1762         v-txmlh:temp-table-prepare("temp-xml-tables").
     1763         p-xmlh = v-txmlh:default-buffer-handle.
     1764       end.
     1765       do v-ii = 1 to p-dsh:num-buffers:
     1766         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     1767                                      ,p-dsh:get-buffer-handle(v-ii):name
     1768                                      ,p-gate-rec
     1769                                      )) no-error.
     1770         if not p-xmlh:available then do:
     1771           p-xmlh:buffer-create().
     1772           assign
     1773           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     1774           p-xmlh::uniq-gate-rec = p-gate-rec
     1775           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1776           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1777           p-xmlh::gate-handle_ = p-dsh
     1778           p-xmlh::gate-name = p-dsh:name
     1779           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1780           .
     1781           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1782             assign
     1783             p-xmlh::order = -3.
     1784           end.
     1785           p-xmlh:buffer-release().
     1786         end.
     1787       end.
     1788   end.
     1789   end procedure.
     1790   procedure gate-clear :
     1791   define input  parameter p-dsh as handle no-undo .
     1792   define input  parameter p-xmlh as handle no-undo .
     1793   define variable v-dsh as handle no-undo .
     1794   define variable v-th as handle no-undo .
     1795     do
     1796     on error undo, return error return-value
     1797     :
     1798       if valid-handle(p-dsh) then do:
     1799         delete object p-dsh.
     1800         v-dsh = p-dsh.
     1801         p-dsh = ?.
     1802       end.
     1803       repeat while true:
     1804         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     1805                            , share-lock) no-error.
     1806         if p-xmlh:available then do:
     1807           assign
     1808           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     1809           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     1810           and valid-handle(v-th)
     1811           and v-th:dynamic = yes
     1812           then do:
     1813             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     1814             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     1815           end.
     1816           p-xmlh:buffer-delete().
     1817         end.
     1818         else do:
     1819           leave.
     1820         end.
     1821       end.
     1822       if p-xmlh:dynamic = yes
     1823       and valid-handle(p-xmlh)
     1824       then do:
     1825         delete object p-xmlh:table-handle.
     1826         p-xmlh = ?.
     1827       end.
     1828       v-dsh = ?.
     1829     end.
     1830   end procedure.
     1831   procedure all-gates-clear :
     1832   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     1833   do
     1834   on error undo, return error
     1835   :
     1836     for each buf_temp-xml-tables
     1837     break
     1838     by buf_temp-xml-tables.uniq-gate-rec
     1839     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1840     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1841     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1842     :
     1843         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     1844           delete object buf_temp-xml-tables.gate-handle_.
     1845           buf_temp-xml-tables.gate-handle_ = ?.
     1846         end.
     1847         if valid-handle(buf_temp-xml-tables.table-handle_)
     1848         and buf_temp-xml-tables.table-handle_:dynamic = no
     1849         then do:
     1850           delete object buf_temp-xml-tables.table-handle_.
     1851           buf_temp-xml-tables.table-handle_ = ?.
     1852         end.
     1853         delete buf_temp-xml-tables.
     1854     end.
     1855   end.
     1856   end procedure.
     1857   procedure fix-schemalocation :
     1858   define input-output  parameter p-longchar as longchar no-undo .
     1859   DEFINE VARIABLE hdoc AS HANDLE.
     1860   DEFINE VARIABLE hroot AS HANDLE.
     1861   DEFINE VARIABLE hnode-child AS HANDLE.
     1862   DEFINE VARIABLE hnode-attr AS HANDLE.
     1863   define variable v-jj as integer   no-undo .
     1864   define variable ok as logical   no-undo .
     1865   define variable v-path1                    as character                no-undo .
     1866   DEFINE VARIABLE v-full-path1               as character                no-undo .
     1867   DEFINE VARIABLE v-file-name1               as character                no-undo .
     1868   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     1869   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     1870   define variable v-schema-location          as character                no-undo .
     1871   do
     1872   on error undo, return error return-value
     1873   :
     1874     CREATE X-DOCUMENT hdoc.
     1875     CREATE X-noderef hroot.
     1876     CREATE X-noderef hnode-child.
     1877     CREATE X-noderef hnode-attr.
     1878     hdoc:load("longchar", p-longchar, no) no-error.
     1879     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     1880     hdoc:get-document-element(hroot).
     1881     _repeat:
     1882     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     1883       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     1884       if not ok then next.
     1885       if hNode-Child:local-name = "include"
     1886       then do:
     1887         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     1888           v-schema-location = hnode-attr:node-value.
     1889           run gbl/filename.p (
     1890                           input "exe/" + hnode-attr:node-value
     1891                         ,output v-full-path1
     1892                         ,output v-path1
     1893                         ,output v-file-name1
     1894                         ,output v-file-name-no-ext1
     1895                         ,output v-file-name-ext1
     1896                         ) no-error .
     1897           if error-status :error then do:
     1898             delete object hnode-attr.
     1899             delete object hnode-child.
     1900             delete object hroot.
     1901             delete object hdoc.
     1902             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     1903           end.
     1904         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     1905         leave  _repeat.
     1906       end.
     1907     END.
     1908     hdoc:save("longchar", p-longchar).
     1909     delete object hnode-attr.
     1910     delete object hnode-child.
     1911     delete object hroot.
     1912     delete object hdoc.
     1913   end.
     1914   end procedure.
     1915   procedure gate-clb_fill-xml-tables :
     1916   define input parameter p-dsh as handle no-undo .
     1917   define input-output parameter p-xmlh as handle no-undo .
     1918   define variable v-ii as integer no-undo .
     1919     do
     1920     on error undo, return error
     1921     :
     1922       do v-ii = 1 to p-dsh:num-buffers:
     1923         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1924         if not p-xmlh:available then do:
     1925           p-xmlh:buffer-create().
     1926           assign
     1927           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1928           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1929           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1930           p-xmlh::gate-handle_ = p-dsh
     1931           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     1932           p-xmlh::gate-name = p-dsh:name
     1933           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1934           .
     1935           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1936             assign
     1937             p-xmlh::order = -3.
     1938           end.
     1939           p-xmlh:buffer-release().
     1940         end.
     1941       end.
     1942     end.
     1943   end procedure.
     1944   procedure all-gates-empty :
     1945   define buffer buf_temp-xml-tables for temp-xml-tables.
     1946   do
     1947   on error undo, return error
     1948   :
     1949     for each buf_temp-xml-tables
     1950     break
     1951     by buf_temp-xml-tables.uniq-gate-rec
     1952     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1953     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1954     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1955     :
     1956       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     1957         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     1958       end.
     1959     end.
     1960   end.
     1961   end procedure.
     1962   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1963   define new global shared variable g#trdcalib as handle no-undo.
     1964   define shared stream  PrnLibstream.
     1965   define variable pol1  as character no-undo .
     1966   define variable pol2  as decimal   no-undo .
     1967   define variable pol3  as decimal   no-undo .
     1968   define variable pol4  as character no-undo .
     1969   define variable pol5  as integer   no-undo .
     1970   define variable pol6  as character no-undo .
     1971   define variable pol7  as decimal   no-undo .
     1972   define variable pol8  as decimal   no-undo .
     1973   define variable pol9  as character no-undo .
     1974   define variable pol10 as decimal   no-undo .
     1975   define variable pol11 as decimal   no-undo .
     1976   define variable pol12 as decimal   no-undo .
     1977   define variable pol13 as decimal   no-undo .
     1978   define variable pol6-excel as character no-undo .
     1979   define variable line          as character no-undo .
     1980   DEFINE VARIABLE areal-is-pay-qnty1 as decimal no-undo.
     1981   DEFINE VARIABLE areal-is-pay-netto as decimal no-undo.
     1982   DEFINE VARIABLE areal-no-pay-qnty1 as decimal no-undo.
     1983   DEFINE VARIABLE areal-no-pay-netto as decimal no-undo.
     1984   DEFINE VARIABLE areal-qnty1   as decimal   no-undo.
     1985   DEFINE VARIABLE areal-netto   as decimal   no-undo.
     1986   DEFINE VARIABLE aincome-qnty1 as decimal   no-undo.
     1987   DEFINE VARIABLE aincome-netto as decimal   no-undo.
     1988   DEFINE VARIABLE loc-real-ii   as integer   no-undo.
     1989   DEFINE VARIABLE curr-real-ii  as integer   no-undo.
     1990   DEFINE VARIABLE tovar-ii      as integer   no-undo.
     1991   DEFINE VARIABLE loc-income-ii as integer   no-undo.
     1992   DEFINE VARIABLE jj            as integer   no-undo.
     1993   DEFINE VARIABLE loc-jj        as integer   no-undo.
     1994   DEFINE VARIABLE main-line     as logical   no-undo.
     1995   DEFINE VARIABLE supp-line     as logical   no-undo.
     1996   DEFINE VARIABLE pay-line      as logical   no-undo.
     1997   DEFINE VARIABLE rc            as recid     no-undo.
     1998   DEFINE VARIABLE accum-2       as decimal   no-undo.
     1999   DEFINE VARIABLE accum-3       as decimal   no-undo.
     2000   DEFINE VARIABLE accum-7       as decimal   no-undo.
     2001   DEFINE VARIABLE accum-8       as decimal   no-undo.
     2002   DEFINE VARIABLE accum-10      as decimal   no-undo.
     2003   DEFINE VARIABLE accum-11      as decimal   no-undo.
     2004   DEFINE VARIABLE accum-12      as decimal   no-undo.
     2005   DEFINE VARIABLE accum-13      as decimal   no-undo.
     2006   DEFINE VARIABLE acii          as integer   no-undo .
     2007   define variable v-attr-value  as character no-undo .
     2008   define variable v-attr-type   as character no-undo .
     2009   define buffer buf_shift-grp     for shift-grpt.
     2010   define buffer buf_shift-grp-in  for shift-grp-int.
     2011   define buffer buf_shift-grp-out for shift-grp-outt.
     2012   define buffer buf_cash-pay      for ub.cash-pay.
     2013     procedure on-same-page :
     2014       define input parameter p-line-number as integer no-undo .
     2015       if p-line-number > page-size( PrnLibstream )
     2016       then do:
     2017         return .
     2018       end.
     2019       if line-counter( PrnLibstream ) + p-line-number > page-size( PrnLibstream )
     2020       then do:
     2021         page stream PrnLibstream .
     2022       end.
     2023     end procedure.
     2024   run rep/r-shft3r.p
     2025                   (input p-obj-type,
     2026                    input p-obj-code,
     2027                    input X-date-Start,
     2028                    input X-Shift-Start,
     2029                    input X-date-End,
     2030                    input X-Shift-End,
     2031                    input pClassify,
     2032                    input pSorttype,
     2033                    input ptog-lavel,
     2034                    input pvar-lavel,
     2035                    input p-previous-shift-date,
     2036                    input p-batch
     2037                    ) no-error.
     2038       output stream OutStr-html to value(v-report-name-html) append convert target 'UTF-8' .
     2039           put stream OutStr-html unformatted
     2040               substitute (
     2041             '<tbody> <!-- Здесь начинается таблица отчета -->
     2042               <tr>
     2043                   <th colspan="3" style="text-align: center;">Информация о товаре</th>
     2044                   <th colspan="5" style="text-align: center;">Расшифровка поступления</th>
     2045                   <th colspan="3" style="text-align: center;">Расшифровка реализации</th>
     2046                   <th colspan="2" style="text-align: center;">Остаток на конец</th>
     2047               </tr>
     2048               <tr>
     2049                   <th rowspan="2" style="text-align: center;">Наименование группа товаров</th>
     2050                   <th colspan="2" style="text-align: center;">Остаток на начало</th>
     2051                   <th colspan="2" style="text-align: center;">Поставщик</th>
     2052                   <th rowspan="2" style="text-align: center;">Номер документа прихода (ТТН)</th>
     2053                   <th colspan="2" style="text-align: center;">Поступило</th>
     2054                   <th rowspan="2" style="text-align: center;">Тип расхода (тип платежа)</th>
     2055                   <th rowspan="2" style="text-align: center;">Кол-во</th>
     2056                   <th rowspan="2" style="text-align: center;">Сумма (цены документа)</th>
     2057                   <th rowspan="2" style="text-align: center;">Кол-во</th>
     2058                   <th rowspan="2" style="text-align: center;">Сумма (прод. цены)</th>
     2059               </tr>
     2060               <tr>
     2061                   <th style="text-align: center;">Кол-во</th>
     2062                   <th style="text-align: center;">Сумма (прод. цены)</th>
     2063                   <th style="text-align: center;">Наименование</th>
     2064                   <th style="text-align: center;">Код</th>
     2065                   <th style="text-align: center;">Кол-во</th>
     2066                   <th style="text-align: center;">Сумма (учет. цены)</th>
     2067               </tr>
     2068               <tr>
     2069                   <th style="text-align: center;">3.1</th>
     2070                   <th style="text-align: center;">3.2</th>
     2071                   <th style="text-align: center;">3.3</th>
     2072                   <th style="text-align: center;">3.4</th>
     2073                   <th style="text-align: center;">3.5</th>
     2074                   <th style="text-align: center;">3.6</th>
     2075                   <th style="text-align: center;">3.7</th>
     2076                   <th style="text-align: center;">3.8</th>
     2077                   <th style="text-align: center;">3.9</th>
     2078                   <th style="text-align: center;">3.10</th>
     2079                   <th style="text-align: center;">3.11</th>
     2080                   <th style="text-align: center;">3.12</th>
     2081                   <th style="text-align: center;">3.13</th>
     2082               </tr>
     2083               '
     2084               , chr(123), chr(125)
     2085           ).
     2086   for each actreal-3:
     2087     delete actreal-3.
     2088   end.
     2089   FOR EACH t-3 where (pclassify <> "totals":U or t-3.grp-code-sheet = 0) use-index pi:
     2090     assign
     2091     areal-is-pay-qnty1 = 0
     2092     areal-is-pay-netto = 0
     2093     areal-no-pay-qnty1 = 0
     2094     areal-no-pay-netto = 0
     2095     areal-qnty1 = 0
     2096     areal-netto = 0
     2097     aincome-qnty1 = 0
     2098     aincome-netto = 0
     2099     loc-real-ii = 1
     2100     curr-real-ii = 1
     2101     loc-income-ii = 0
     2102     .
     2103     FIND LAST treal-3 No-LOCK WHERE
     2104               treal-3.grp-code-sheet = t-3.grp-code-sheet AND
     2105               treal-3.is-pay = yes use-index vi No-ERROR.
     2106     if avail treal-3 then
     2107     assign
     2108     loc-real-ii = treal-3.ii + 1
     2109     curr-real-ii = treal-3.ii + 1
     2110     .
     2111     IF can-find(first treal-3 WHERE
     2112                       treal-3.grp-code-sheet = t-3.grp-code-sheet) then do:
     2113       FOR EACh  treal-3 where
     2114                 treal-3.grp-code-sheet = t-3.grp-code-sheet use-index pi:
     2115         assign
     2116         areal-qnty1 = areal-qnty1 + treal-3.qnty1
     2117         areal-netto = areal-netto + treal-3.netto
     2118         .
     2119         if treal-3.is-pay then
     2120         assign
     2121         areal-is-pay-qnty1 = areal-is-pay-qnty1 + treal-3.qnty1
     2122         areal-is-pay-netto = areal-is-pay-netto + treal-3.netto
     2123         .
     2124         else
     2125         assign
     2126         rc = recid(treal-3)
     2127         curr-real-ii = (if curr-real-ii = loc-real-ii AND
     2128                            (loc-real-ii > 1   OR
     2129                             can-find(first treal-3 No-LOCK WHERE
     2130                                            treal-3.grp-code-sheet = t-3.grp-code-sheet AND
     2131                                            treal-3.is-pay = no AND
     2132                                            recid(treal-3) <> rc)
     2133                             )
     2134                         then (curr-real-ii + 1)
     2135                         else curr-real-ii
     2136                        )
     2137         treal-3.ii = curr-real-ii
     2138         curr-real-ii = curr-real-ii + 1
     2139         areal-no-pay-qnty1 = areal-no-pay-qnty1 + treal-3.qnty1
     2140         areal-no-pay-netto = areal-no-pay-netto + treal-3.netto
     2141         .
     2142       END.
     2143       if curr-real-ii > 2 then do:
     2144         run create-treal-3 (
     2145                             INPUT t-3.grp-code-sheet,
     2146                             INPUT 0,
     2147                             INPUT 0,
     2148                             INPUT areal-is-pay-qnty1,
     2149                             INPUT areal-is-pay-netto,
     2150                             INPUT "ИТОГО ОПЛАЧ.РАСХОД",
     2151                             INPUT yes,
     2152                             INPUT loc-real-ii) no-error.
     2153         if loc-real-ii = curr-real-ii then
     2154         curr-real-ii = curr-real-ii + 1.
     2155         run create-treal-3 (
     2156                             INPUT t-3.grp-code-sheet,
     2157                             INPUT 0,
     2158                             INPUT 0,
     2159                             INPUT areal-no-pay-qnty1,
     2160                             INPUT areal-no-pay-netto,
     2161                             INPUT "ИТОГО ПРОЧ.РАСХОДОВ",
     2162                             INPUT no,
     2163                             INPUT curr-real-ii) no-error.
     2164         curr-real-ii = curr-real-ii + 1.
     2165         run create-treal-3 (
     2166                             INPUT t-3.grp-code-sheet,
     2167                             INPUT 0,
     2168                             INPUT 0,
     2169                             INPUT areal-qnty1,
     2170                             INPUT areal-netto,
     2171                             INPUT "ВСЕГО  РАСХОД",
     2172                             INPUT ?,
     2173                             INPUT curr-real-ii) no-error.
     2174       END.
     2175       else curr-real-ii = 1.
     2176     END.
     2177     FOR EACh  tincome-3 where
     2178               tincome-3.grp-code-sheet = t-3.grp-code-sheet use-index vi:
     2179       assign
     2180       aincome-qnty1 = aincome-qnty1 + tincome-3.qnty1
     2181       aincome-netto = aincome-netto + tincome-3.netto
     2182       loc-income-ii = tincome-3.ii
     2183       .
     2184     END.
     2185     if loc-income-ii > 1 then do:
     2186       run create-tincome-3 (
     2187                           INPUT t-3.grp-code-sheet,
     2188                           INPUT "",
     2189                           INPUT aincome-qnty1,
     2190                           INPUT aincome-netto,
     2191                           INPUT "ИТОГО ПОСТУПЛЕНИЙ",
     2192                           INPUT 0,
     2193                           INPUT no,
     2194                           INPUT (loc-income-ii + 1)) no-error .
     2195       loc-income-ii = loc-income-ii + 1.
     2196     END.
     2197     assign
     2198     tovar-ii = 1
     2199     t-3.lines = MAX(curr-real-ii, loc-income-ii, tovar-ii, 1 )
     2200     .
     2201   END.
     2202   FOR EACH t-3 No-LOCK WHERE (pclassify <> "totals":U or t-3.grp-code-sheet = 0)
     2203       break by grp-name:
     2204     DO jj = 1 to t-3.lines :
     2205       assign
     2206       pol1 = ""
     2207       pol2 = 0
     2208       pol3 = 0
     2209       pol4 = ""
     2210       pol5 = 0
     2211       pol6 = ""
     2212       pol7 = 0
     2213       pol8 = 0
     2214       pol9 = ""
     2215       pol10 = 0
     2216       pol11 = 0
     2217       pol12 = 0
     2218       pol13 = 0
     2219       main-line = no
     2220       supp-line = no
     2221       pay-line = no
     2222       .
     2223       IF jj = 1 then do:
     2224         assign
     2225         pol1 = t-3.grp-name
     2226         pol2 = t-3.qnty1-before
     2227         pol3 = t-3.netto-before
     2228         pol12 = t-3.qnty1-after
     2229         pol13 = t-3.netto-after
     2230         main-line = yes
     2231         .
     2232       END.
     2233       FIND FIRST tincome-3 No-LOCK WHERE
     2234                  tincome-3.grp-code-sheet = t-3.grp-code-sheet AND
     2235                  tincome-3.ii = jj No-ERROR.
     2236       FIND FIRST treal-3 No-LOCK WHERE
     2237                  treal-3.grp-code-sheet = t-3.grp-code-sheet AND
     2238                  treal-3.ii = jj No-ERROR.
     2239       if p-batch > 0
     2240       and (available tincome-3
     2241       or available treal-3)
     2242       then do:
     2243         find first buf_shift-grp where
     2244                   buf_shift-grp.obj-type = p-obj-type
     2245               and buf_shift-grp.obj-code = p-obj-code
     2246               and buf_shift-grp.shift-date = x-date-end
     2247               and buf_shift-grp.shift-num = x-shift-end
     2248               and buf_shift-grp.grp-code = t-3.grp-code-sheet no-error.
     2249         if not available buf_shift-grp then do:
     2250           create buf_shift-grp.
     2251           assign
     2252           buf_shift-grp.obj-type = p-obj-type
     2253           buf_shift-grp.obj-code = p-obj-code
     2254           buf_shift-grp.shift-date = x-date-end
     2255           buf_shift-grp.shift-num = x-shift-end
     2256           buf_shift-grp.grp-code = t-3.grp-code-sheet
     2257           buf_shift-grp.full-grp-name = t-3.grp-name
     2258           buf_shift-grp.start-qnty = t-3.qnty1-before
     2259           buf_shift-grp.end-qnty = t-3.qnty1-after
     2260           buf_shift-grp.start-sum = t-3.netto-before
     2261           buf_shift-grp.end-sum = t-3.netto-after
     2262           .
     2263         end.
     2264       end.
     2265       IF AVAIl tincome-3 then do:
     2266   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input tincome-3.doc-code ,
     2267                           input 'nids':U ,
     2268                          output v-attr-value ,
     2269                          output v-attr-type )  .
     2270         assign
     2271           pol6 = if v-attr-value = "" or v-attr-value = ?
     2272                  then tincome-3.doc-code
     2273                  else v-attr-value
     2274           pol6-excel = if v-attr-value = "" or v-attr-value = ?
     2275                  then tincome-3.doc-code
     2276                  else '="' + v-attr-value + '"'
     2277         .
     2278         assign
     2279         pol4 = tincome-3.supp-name
     2280         pol5 = tincome-3.supp-code
     2281         pol7 = tincome-3.qnty1
     2282         pol8 = tincome-3.netto
     2283         supp-line = yes
     2284         .
     2285           find first buf_shift-grp-in where
     2286                     buf_shift-grp-in.obj-type = p-obj-type
     2287                 and buf_shift-grp-in.obj-code = p-obj-code
     2288                 and buf_shift-grp-in.shift-date = x-date-end
     2289                 and buf_shift-grp-in.shift-num = x-shift-end
     2290                 and buf_shift-grp-in.grp-code = tincome-3.grp-code-sheet
     2291                 and buf_shift-grp-in.doc-code = tincome-3.doc-code   no-error.
     2292           if not available buf_shift-grp-in then do:
     2293             create buf_shift-grp-in.
     2294             assign
     2295             buf_shift-grp-in.obj-type = p-obj-type
     2296             buf_shift-grp-in.obj-code = p-obj-code
     2297             buf_shift-grp-in.shift-date = x-date-end
     2298             buf_shift-grp-in.shift-num = x-shift-end
     2299             buf_shift-grp-in.grp-code = tincome-3.grp-code-sheet
     2300             buf_shift-grp-in.doc-code = tincome-3.doc-code
     2301             buf_shift-grp-in.cli-type-code = substitute("&1&2", tincome-3.supp-type, tincome-3.supp-code)
     2302             buf_shift-grp-in.cli-name = tincome-3.supp-name
     2303             buf_shift-grp-in.fact-qnty = tincome-3.qnty1
     2304             buf_shift-grp-in.fact-cost-sum = tincome-3.netto
     2305             .
     2306             release buf_shift-grp-in.
     2307           end.
     2308       END.
     2309       IF AVAIl treal-3 then do:
     2310         if treal-3.cpay-code <> 0 then do:
     2311           FIND FIRST actreal-3 WHERE
     2312                     actreal-3.grp-code-sheet = 0 AND
     2313                     actreal-3.cpay-code = treal-3.cpay-code AND
     2314                     actreal-3.curr-code = treal-3.curr-code AND
     2315                     actreal-3.is-pay = treal-3.is-pay NO-ERROR.
     2316           if not avail actreal-3 then do:
     2317             acii = acii + 1.
     2318             run create-actreal-3 (
     2319                                 INPUT 0,
     2320                                 INPUT treal-3.cpay-code,
     2321                                 INPUT treal-3.curr-code,
     2322                                 INPUT treal-3.qnty1,
     2323                                 INPUT treal-3.netto,
     2324                                 INPUT treal-3.out-name,
     2325                                 INPUT treal-3.is-pay,
     2326                                 INPUT acii) no-error.
     2327           end.
     2328           else
     2329           assign
     2330           actreal-3.qnty1 = actreal-3.qnty1 + treal-3.qnty1
     2331           actreal-3.netto = actreal-3.netto + treal-3.netto
     2332           .
     2333         end.
     2334         assign
     2335         pol9 = treal-3.out-name
     2336         pol10 = treal-3.qnty1
     2337         pol11 = treal-3.netto
     2338         pay-line = yes
     2339         .
     2340         if p-batch > 0
     2341         and (treal-3.curr-code > 0
     2342         or not (treal-3.curr-code = 0 and treal-3.cpay-code = 0))
     2343         and treal-3.grp-code > 0
     2344         then do:
     2345           find first buf_shift-grp-out where
     2346                     buf_shift-grp-out.obj-type = p-obj-type
     2347                 and buf_shift-grp-out.obj-code = p-obj-code
     2348                 and buf_shift-grp-out.shift-date = x-date-end
     2349                 and buf_shift-grp-out.shift-num = x-shift-end
     2350                 and buf_shift-grp-out.grp-code = treal-3.grp-code-sheet
     2351                 and buf_shift-grp-out.pay-code = treal-3.cpay-code
     2352                 and buf_shift-grp-out.curr-code = treal-3.curr-code
     2353                 no-error.
     2354           if not available buf_shift-grp-out then do:
     2355               find first buf_cash-pay no-lock where
     2356                         buf_cash-pay.cdpay-code = treal-3.cpay-code
     2357                    and  buf_cash-pay.curr-code = treal-3.curr-code no-error.
     2358             create buf_shift-grp-out.
     2359             assign
     2360             buf_shift-grp-out.obj-type = p-obj-type
     2361             buf_shift-grp-out.obj-code = p-obj-code
     2362             buf_shift-grp-out.shift-date = x-date-end
     2363             buf_shift-grp-out.shift-num = x-shift-end
     2364             buf_shift-grp-out.grp-code = treal-3.grp-code-sheet
     2365             buf_shift-grp-out.pay-code = treal-3.cpay-code
     2366             buf_shift-grp-out.curr-code = treal-3.curr-code
     2367             buf_shift-grp-out.out-name = treal-3.out-name
     2368             buf_shift-grp-out.fact-qnty = treal-3.qnty1
     2369             buf_shift-grp-out.fact-sum = treal-3.netto
     2370             buf_shift-grp-out.cp-type = (if available buf_cash-pay
     2371                                           and buf_cash-pay.is-cash
     2372                                           then 1
     2373                                           else 2)
     2374             .
     2375             release buf_shift-grp-out.
     2376           end.
     2377         end.
     2378           put stream OutStr-html unformatted
     2379               substitute (
     2380               '  <tr>
     2381                       <td text_wrap="true">&1</td>
     2382                       <td style="text-align: right;">&2</td>
     2383                       <td style="text-align: right;">&3</td>
     2384                       <td text_wrap="true">&4</td>
     2385                       <td style="text-align: right;">&5</td>
     2386                       <td>&6</td>
     2387                       <td style="text-align: right;">&7</td>
     2388                       <td style="text-align: right;">&8</td>
     2389                       <td text_wrap="true">&9</td>'
     2390               ,
     2391               pol1,
     2392               if main-line = no then "" else string(pol2,"->>>>>>>>>>>9.99"),
     2393               if main-line = no then "" else string(pol3,"->>>>>>>>>>>9.99"),
     2394               pol4,
     2395               if pol5 = 0 then "" else string(pol5),
     2396               pol6,
     2397               if supp-line = no then "" else string(pol7,"->>>>>>>>>>>9.99"),
     2398               if supp-line = no then "" else string(pol8,"->>>>>>>>>>>9.99"),
     2399               pol9
     2400               ).
     2401                         put stream OutStr-html unformatted
     2402               substitute (
     2403               '  
     2404                       <td style="text-align: right;">&1</td>
     2405                       <td style="text-align: right;">&2</td>
     2406                       <td style="text-align: right;">&3</td>
     2407                       <td style="text-align: right;">&4</td>
     2408                   </tr>'
     2409               ,
     2410               if pay-line = no then "" else string(pol10,"->>>>>>>>>>>9.99"),
     2411               if pay-line = no then "" else string(pol11,"->>>>>>>>>>>9.99"),
     2412               if main-line = no then "" else string(pol12,"->>>>>>>>>>>9.99"),
     2413               if main-line = no then "" else string(pol13,"->>>>>>>>>>>9.99")
     2414               ).
     2415       END.
     2416       if not available tincome-3 and not available treal-3 then do:
     2417               put stream OutStr-html unformatted
     2418               substitute (
     2419               '  <tr>
     2420                       <td text_wrap="true">&1</td>
     2421                       <td style="text-align: right;">&2</td>
     2422                       <td style="text-align: right;">&3</td>
     2423                       <td text_wrap="true"></td>
     2424                       <td style="text-align: right;"></td>
     2425                       <td></td>
     2426                       <td style="text-align: right;"></td>
     2427                       <td style="text-align: right;"></td>
     2428                       <td text_wrap="true"></td>
     2429                       <td style="text-align: right;"></td>
     2430                       <td style="text-align: right;"></td>
     2431                       <td style="text-align: right;">&4</td>
     2432                       <td style="text-align: right;">&5</td>
     2433                   </tr>'
     2434               ,
     2435               pol1,
     2436               string(pol2,"->>>>>>>>>>>9.99"),
     2437               string(pol3,"->>>>>>>>>>>9.99"),
     2438               string(pol12,"->>>>>>>>>>>9.99"),
     2439               string(pol13,"->>>>>>>>>>>9.99")
     2440               ).
     2441       end.
     2442       if jj < t-3.lines then do:
     2443           if main-line then do:
     2444             assign
     2445             accum-2 = accum-2 + pol2
     2446             accum-3 = accum-3 + pol3
     2447             accum-12 = accum-12 + pol12
     2448             accum-13 = accum-13 + pol13
     2449             .
     2450           end.
     2451           if supp-line then do:
     2452             if tincome-3.is-fact = yes then
     2453             assign
     2454             accum-7 = accum-7 + pol7
     2455             accum-8 = accum-8 + pol8
     2456             .
     2457           end.
     2458           if pay-line then do:
     2459             if treal-3.cpay-code <> 0 then
     2460             assign
     2461             accum-10 = accum-10 + pol10
     2462             accum-11 = accum-11 + pol11
     2463             .
     2464           end.
     2465       end.
     2466       if jj = 1 and t-3.lines = 1 then do:
     2467           if main-line then do:
     2468             assign
     2469             accum-2 = accum-2 + pol2
     2470             accum-3 = accum-3 + pol3
     2471             accum-12 = accum-12 + pol12
     2472             accum-13 = accum-13 + pol13
     2473             .
     2474           end.
     2475           if supp-line then do:
     2476             if tincome-3.is-fact = yes then
     2477             assign
     2478             accum-7 = accum-7 + pol7
     2479             accum-8 = accum-8 + pol8
     2480             .
     2481           end.
     2482           if pay-line then do:
     2483             if treal-3.cpay-code <> 0 then
     2484             assign
     2485             accum-10 = accum-10 + pol10
     2486             accum-11 = accum-11 + pol11
     2487             .
     2488           end.
     2489       end.
     2490    END.
     2491     if pclassify <> "totals":U and last(t-3.grp-name) then do:
     2492       assign
     2493       pol1 = "ИТОГО ПО ВСЕМ ГРУППАМ"
     2494       pol2 = accum-2
     2495       pol3 = accum-3
     2496       pol7 = accum-7
     2497       pol8 = accum-8
     2498       pol9 = "ИТОГО РАСХОД"
     2499       pol10 = accum-10
     2500       pol11 = accum-11
     2501       pol12 = accum-12
     2502       pol13 = accum-13
     2503       .
     2504           put stream OutStr-html unformatted
     2505               substitute (
     2506               '  <tr>
     2507                       <th text_wrap="true" style="text-align: left;">&1</th>
     2508                       <th style="text-align: right;">&2</th>
     2509                       <th style="text-align: right;">&3</th>
     2510                       <th style="text-align: left;"></th>
     2511                       <th></th>
     2512                       <th></th>
     2513                       <th style="text-align: right;">&4</th>
     2514                       <th style="text-align: right;">&5</th>
     2515                       <th text_wrap="true" style="text-align: left;">&6</th>'
     2516               ,
     2517               pol1,
     2518               string(pol2,"->>>>>>>>>>>9.99"),
     2519               string(pol3,"->>>>>>>>>>>9.99"),
     2520               string(pol7,"->>>>>>>>>>>9.99"),
     2521               string(pol8,"->>>>>>>>>>>9.99"),
     2522               pol9
     2523               ).
     2524           put stream OutStr-html unformatted
     2525               substitute (
     2526               '  
     2527                       <th style="text-align: right;">&1</th>
     2528                       <th style="text-align: right;">&2</th>
     2529                       <th style="text-align: right;">&3</th>
     2530                       <th style="text-align: right;">&4</th>
     2531                   </tr>'
     2532               ,
     2533               string(pol10,"->>>>>>>>>>>9.99"),
     2534               string(pol11,"->>>>>>>>>>>9.99"),
     2535               string(pol12,"->>>>>>>>>>>9.99"),
     2536               string(pol13,"->>>>>>>>>>>9.99")
     2537               ).
     2538       if can-find(first actreal-3 No-LOCK) then do:
     2539         pol9 = "     в том числе:".
     2540           put stream OutStr-html unformatted
     2541               substitute (
     2542               '  <tr>
     2543                       <td></td>
     2544                       <td></td>
     2545                       <td></td>
     2546                       <td></td>
     2547                       <td></td>
     2548                       <td></td>
     2549                       <td></td>
     2550                       <td></td>
     2551                       <td text_wrap="true">&1</td>
     2552                       <td></td>
     2553                       <td></td>
     2554                       <td></td>
     2555                       <td></td>
     2556                   </tr>'
     2557               ,
     2558               pol9
     2559               ).
     2560         assign
     2561         areal-is-pay-qnty1 = 0
     2562         areal-is-pay-netto = 0
     2563         areal-no-pay-qnty1 = 0
     2564         areal-no-pay-netto = 0
     2565         .
     2566         FOR EACH actreal-3 No-LOCK
     2567         BREAK
     2568         BY actreal-3.grp-code-sheet
     2569         By actreal-3.is-pay descending
     2570         BY actreal-3.cpay-code descending
     2571         BY actreal-3.curr-code:
     2572           if actreal-3.is-pay = yes then
     2573           assign
     2574           areal-is-pay-qnty1 = areal-is-pay-qnty1 + actreal-3.qnty1
     2575           areal-is-pay-netto = areal-is-pay-netto + actreal-3.netto
     2576           .
     2577           else
     2578           assign
     2579           areal-no-pay-qnty1 = areal-no-pay-qnty1 + actreal-3.qnty1
     2580           areal-no-pay-netto = areal-no-pay-netto + actreal-3.netto
     2581           .
     2582           assign
     2583           pol9 = actreal-3.out-name
     2584           pol10 = actreal-3.qnty1
     2585           pol11 = actreal-3.netto
     2586           .
     2587           put stream OutStr-html unformatted
     2588               substitute (
     2589               '  <tr>
     2590                       <td></td>
     2591                       <td></td>
     2592                       <td></td>
     2593                       <td></td>
     2594                       <td></td>
     2595                       <td></td>
     2596                       <td></td>
     2597                       <td></td>
     2598                       <td text_wrap="true">&1</td>
     2599                       <td style="text-align: right;">&2</td>
     2600                       <td style="text-align: right;">&3</td>
     2601                       <td></td>
     2602                       <td></td>
     2603                   </tr>'
     2604               ,
     2605               pol9,
     2606               string(pol10,"->>>>>>>>>>>9.99"),
     2607               string(pol11,"->>>>>>>>>>>9.99")
     2608               ).
     2609          if last-of(actreal-3.is-pay)  then do:
     2610             if actreal-3.is-pay = yes then
     2611             assign
     2612             pol9 = "ИТОГО ОПЛАЧ.РАСХОД"
     2613             pol10 = areal-is-pay-qnty1
     2614             pol11 = areal-is-pay-netto
     2615             .
     2616             else
     2617             assign
     2618             pol9 = "ИТОГО ПРОЧ.РАСХОД"
     2619             pol10 = areal-no-pay-qnty1
     2620             pol11 = areal-no-pay-netto
     2621             .
     2622           put stream OutStr-html unformatted
     2623               substitute (
     2624               '  <tr>
     2625                       <td></td>
     2626                       <td></td>
     2627                       <td></td>
     2628                       <td></td>
     2629                       <td></td>
     2630                       <td></td>
     2631                       <td></td>
     2632                       <td></td>
     2633                       <td text_wrap="true">&1</td>
     2634                       <td style="text-align: right;">&2</td>
     2635                       <td style="text-align: right;">&3</td>
     2636                       <td></td>
     2637                       <td></td>
     2638                   </tr>'
     2639               ,
     2640               pol9,
     2641               string(pol10,"->>>>>>>>>>>9.99"),
     2642               string(pol11,"->>>>>>>>>>>9.99")
     2643               ).
     2644           end.
     2645         END.
     2646       end.
     2647     end.
     2648   END.
     2649        output stream OutStr-html close.
     2650        output stream OutStr-html to value(v-report-name-html) append convert target 'UTF-8' .
     2651        put stream OutStr-html unformatted
     2652           substitute (
     2653           '
     2654           </tbody>
     2655           '
     2656               , chr(123), chr(125)
     2657          ).
     2658         output stream OutStr-html close.
     2659   PROCEDURE create-tincome-3.
     2660   DEFINE INPUT PARAMETER pgrp-code-sheet like ub.gds-grp.node-code no-undo.
     2661   DEFINE INPUT PARAMETER pdoc-code like ub.trn-doc.doc-code no-undo.
     2662   DEFINE INPUT PARAMETER pqnty1 as decimal no-undo.
     2663   DEFINE INPUT PARAMETER pnetto as decimal no-undo.
     2664   DEFINE INPUT PARAMETER psupp-name as character no-undo.
     2665   DEFINE INPUT PARAMETER psupp-code like ub.clients.obj-code no-undo.
     2666   DEFINE INPUT PARAMETER pis-fact as logical no-undo.
     2667   DEFINE INPUT PARAMETER pii as integer no-undo.
     2668   _main:
     2669   DO ON ERROR UNDO _main, return error:
     2670       create tincome-3.
     2671       assign
     2672       tincome-3.grp-code-sheet = pgrp-code-sheet
     2673       tincome-3.doc-code = pdoc-code
     2674       tincome-3.qnty1  =  pqnty1
     2675       tincome-3.netto  = pnetto
     2676       tincome-3.supp-code = psupp-code
     2677       tincome-3.supp-name = psupp-name
     2678       tincome-3.is-fact = pis-fact
     2679       tincome-3.ii = pii
     2680       no-error
     2681       .
     2682       if error-status:error then undo _main, return error.
     2683   END.
     2684   END PROCEDURE.
