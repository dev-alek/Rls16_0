      660   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      661   PROCEDURE create-treal-3.
      662   DEFINE INPUT PARAMETER pgrp-code-sheet like ub.gds-grp.node-code no-undo.
      663   DEFINE INPUT PARAMETER pcpay-code like ub.cash-pay.cdpay-code no-undo.
      664   DEFINE INPUT PARAMETER pcurr-code like ub.cash-pay.curr-code no-undo.
      665   DEFINE INPUT PARAMETER pqnty1 as decimal no-undo.
      666   DEFINE INPUT PARAMETER pnetto as decimal no-undo.
      667   DEFINE INPUT PARAMETER pout-name as character no-undo.
      668   DEFINE INPUT PARAMETER pis-pay as logical no-undo.
      669   DEFINE INPUT PARAMETER pii as integer no-undo.
      670   _main:
      671   DO ON ERROR UNDO _main, return error:
      672       create treal-3.
      673       assign
      674       treal-3.grp-code-sheet = pgrp-code-sheet
      675       treal-3.cpay-code = pcpay-code
      676       treal-3.curr-code = pcurr-code
      677       treal-3.qnty1  =  pqnty1
      678       treal-3.netto = pnetto
      679       treal-3.out-name = pout-name
      680       treal-3.is-pay = pis-pay
      681       treal-3.ii = pii
      682       treal-3.discnt-type = -99
      683       no-error
      684       .
      685       if error-status:error then undo _main, return error.
      686   END.
      687   END PROCEDURE.
      688   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      689   PROCEDURE create-actreal-3.
      690   DEFINE INPUT PARAMETER pgrp-code-sheet like ub.gds-grp.node-code no-undo.
      691   DEFINE INPUT PARAMETER pcpay-code like ub.cash-pay.cdpay-code no-undo.
      692   DEFINE INPUT PARAMETER pcurr-code like ub.cash-pay.curr-code no-undo.
      693   DEFINE INPUT PARAMETER pqnty1 as decimal no-undo.
      694   DEFINE INPUT PARAMETER pnetto as decimal no-undo.
      695   DEFINE INPUT PARAMETER pout-name as character no-undo.
      696   DEFINE INPUT PARAMETER pis-pay as logical no-undo.
      697   DEFINE INPUT PARAMETER pii as integer no-undo.
      698   _main:
      699   DO ON ERROR UNDO _main, return error:
      700       create actreal-3.
      701       assign
      702       actreal-3.grp-code-sheet = pgrp-code-sheet
      703       actreal-3.cpay-code = pcpay-code
      704       actreal-3.curr-code = pcurr-code
      705       actreal-3.qnty1  =  pqnty1
      706       actreal-3.netto = pnetto
