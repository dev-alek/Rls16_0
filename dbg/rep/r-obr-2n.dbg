     4015   procedure oborot-stk :
     4016   define input  parameter l-store-code   like ub.clients.obj-code      no-undo.
     4017   define input  parameter l-store-type   like ub.clients.obj-type      no-undo.
     4018   define input  parameter l-artic        like ub.stk-line.artic        no-undo.
     4019   define input  parameter l-prod-code    like ub.stk-line.prod-code    no-undo.
     4020   define input  parameter l-prod-type    like ub.stk-line.prod-type    no-undo.
     4021   define input  parameter l-tog-shift    as   logical                  no-undo.
     4022   define input  parameter l-fact-order-1   like ub.stk-line.fact-order   no-undo.
     4023   define input  parameter l-fact-order-2   like ub.stk-line.fact-order   no-undo.
     4024   define input  parameter l-sum-type     like ub.stk-line.sum-type     no-undo.
     4025   define input  parameter l-cat-id       like ub.stk-line.cat-id       no-undo.
     4026   define input  parameter l-tog-obj       as log no-undo.
     4027   define output parameter quantity    like ub.stk-line.fact-qnty   no-undo.
     4028   define output parameter coast_r     like ub.stk-line.sum-rubl    no-undo.
     4029   define output parameter coast_v     like ub.stk-line.sum-rubl    no-undo.
     4030   define output parameter vat_r       like ub.stk-line.sum-rubl    no-undo.
     4031   define output parameter vat_v       like ub.stk-line.sum-rubl    no-undo.
     4032   define output parameter slt_r       like ub.stk-line.sum-rubl    no-undo.
     4033   define output parameter slt_v       like ub.stk-line.sum-rubl    no-undo.
     4034   define output parameter other_r     like ub.stk-line.sum-rubl    no-undo.
     4035   define output parameter other_v     like ub.stk-line.sum-rubl    no-undo.
     4036   define variable  quantity#1    like ub.stk-line.fact-qnty   no-undo.
     4037   define variable  coast_r#1     like ub.stk-line.sum-rubl    no-undo.
     4038   define variable  coast_v#1     like ub.stk-line.sum-rubl    no-undo.
     4039   define variable  vat_r#1       like ub.stk-line.sum-rubl    no-undo.
     4040   define variable  vat_v#1       like ub.stk-line.sum-rubl    no-undo.
     4041   define variable  slt_r#1       like ub.stk-line.sum-rubl    no-undo.
     4042   define variable  slt_v#1       like ub.stk-line.sum-rubl    no-undo.
     4043   define variable  other_r#1     like ub.stk-line.sum-rubl    no-undo.
     4044   define variable  other_v#1     like ub.stk-line.sum-rubl    no-undo.
     4045   define variable  quantity#2    like ub.stk-line.fact-qnty   no-undo.
     4046   define variable  coast_r#2     like ub.stk-line.sum-rubl    no-undo.
     4047   define variable  coast_v#2     like ub.stk-line.sum-rubl    no-undo.
     4048   define variable  vat_r#2       like ub.stk-line.sum-rubl    no-undo.
     4049   define variable  vat_v#2       like ub.stk-line.sum-rubl    no-undo.
     4050   define variable  slt_r#2       like ub.stk-line.sum-rubl    no-undo.
     4051   define variable  slt_v#2       like ub.stk-line.sum-rubl    no-undo.
     4052   define variable  other_r#2     like ub.stk-line.sum-rubl    no-undo.
     4053   define variable  other_v#2     like ub.stk-line.sum-rubl    no-undo.
     4054   run ost-lineother-tax  in this-procedure
     4055    (  input   l-store-code  ,
     4056       input   l-store-type  ,
     4057       input   l-artic       ,
     4058       input   l-prod-code   ,
     4059       input   l-prod-type   ,
     4060       input   l-tog-shift   ,
     4061       input   l-fact-order-1,
     4062       input   l-sum-type    ,
     4063       input   l-cat-id      ,
     4064       input   l-tog-obj     ,
     4065       output  quantity#1 ,
     4066       output  coast_r#1  ,
     4067       output  coast_v#1  ,
     4068       output  vat_r#1    ,
     4069       output  vat_v#1    ,
     4070       output  slt_r#1    ,
     4071       output  slt_v#1    ,
     4072       output  other_r#1  ,
     4073       output  other_v#1  ).
     4074   run ost-lineother-tax  in this-procedure
     4075    (  input   l-store-code  ,
     4076       input   l-store-type  ,
     4077       input   l-artic       ,
     4078       input   l-prod-code   ,
     4079       input   l-prod-type   ,
     4080       input   l-tog-shift   ,
     4081       input   l-fact-order-2,
     4082       input   l-sum-type    ,
     4083       input   l-cat-id      ,
     4084       input   l-tog-obj     ,
     4085       output  quantity#2 ,
     4086       output  coast_r#2  ,
     4087       output  coast_v#2  ,
     4088       output  vat_r#2    ,
     4089       output  vat_v#2    ,
     4090       output  slt_r#2    ,
     4091       output  slt_v#2    ,
     4092       output  other_r#2  ,
     4093       output  other_v#2  ).
     4094       assign
     4095         quantity =   quantity#2 -  quantity#1
     4096         coast_r  =   coast_r#2  -  coast_r#1
     4097         coast_v  =   coast_v#2  -  coast_v#1
     4098         vat_r    =   vat_r#2    -  vat_r#1
     4099         vat_v    =   vat_v#2    -  vat_v#1
     4100         slt_r    =   slt_r#2    -  slt_r#1
     4101         slt_v    =   slt_v#2    -  slt_v#1
     4102         other_r  =   other_r#2  -  other_r#1
     4103         other_v  =   other_v#2  -  other_v#1
     4104         .
     4105    end procedure.
