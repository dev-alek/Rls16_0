     1906           show-negativ-2  = xshowzero-2
     1907           xshowcost     = show-cost
     1908           xshowsale     = show-sale
     1909           xshowcrsa     = show-crsa
     1910           firstline     = false
     1911           line          = fill("-", 232)
     1912           valtype       = if (paytype = 1) then 0  else x-set_val_type.
     1913        run report-execute  in this-procedure .
     1914   FUNCTION n-lavel RETURNS char (INPUT grp-name as char, INPUT lavel# as int ).
     1915   define variable  str  as char format "X(60)"  no-undo.
     1916   define variable  str2 as char no-undo.
     1917   define variable v-r as character no-undo init "" .
     1918   define variable  i#i as int no-undo.
     1919   STR = "".
     1920   repeat i#i =1 to lavel#:
     1921       if i#i =1 then str   = entry(1,grp-name, chr(47)) .
     1922       else do:
     1923           str2 = entry(i#i,grp-name, chr(47)) no-error.
     1924           if not error-status:error  and str2 <> "":u then
     1925                  str = str +  chr(47) +  entry(i#i,grp-name, chr(47)) no-error .
     1926           end.
     1927   end.
     1928   if str <> ? then do:
     1929   v-r = str + chr(47) .
     1930   end.
     1931   RETURN v-r .
     1932   END FUNCTION.
     1933   procedure report-execute :
     1934   define variable gj as integer no-undo init 0.
     1935     if (valtype=0 and x-base-code=0)  or valtype=1
     1936                                   then   assign tprintrubl = yes .
     1937                                   else   assign tprintrubl = no .
     1938   assign v-account = ( if integer( 30 ) = 0 then 100 else integer( 30 ) ).
     1939     if  log-manager:logfile-name ne ?
     1940     then DO:
     1941         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1942     end.
     1943     if not session:batch-mode then
     1944     do:
     1945       VIEW FRAME InfoFrame.
     1946       mFrameView = true.
     1947     end.
     1948      v-button-stop = false .
     1949         if mFrameView
     1950         then do:
     1951         if v-button-stop then view STOPBTN in frame InfoFrame.
     1952                          else Hide STOPBTN in frame InfoFrame.
     1953         end.
     1954     if reportpageheight = 0 then reportpageheight  = 43.
     1955   output stream outstream to value( string( session:temp-directory +
     1956                                        "rpt" + string( g#report-num ) ) )
     1957                                        page-size  value(reportpageheight) .
     1958     find first clients where x-store-type = clients.obj-type and
     1959                              x-store-code = clients.obj-code no-lock no-error.
     1960     if available clients then  objname = clients.obj-name.
     1961                                   else  objname="объект не определен".
     1962   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1963   form header
     1964     line format "x(194)" at 1 skip
     1965     "Продолжение - на следующей странице" at 30 skip
     1966     with frame bottomframe width 232 page-bottom no-labels no-box .
     1967   view stream outstream frame bottomframe .
     1968        run report-exec1 in this-procedure.
     1969     hide stream outstream frame bottomframe .
     1970     hide   stream outstream frame zapas .
     1971     output stream outstream close.
     1972   if mFrameView
     1973   then do:
     1974      HIDE FRAME InfoFrame.
     1975   end.
     1976     if Make-Excel then output stream ForExcel close.
     1977     define variable v-user-action as character no-undo .
     1978     define variable v-printed as logical   no-undo .
     1979     define variable disabledoptions as integer   no-undo .
     1980     define variable v-orient-page as character no-undo .
     1981     run How-name in this-procedure (
     1982         input ReportPageHeight,
     1983         input ReportPageWidth,
     1984         output v-orient-page )
     1985         .
     1986     if v-orient-page = "A4-lans":U then DisabledOptions = 8 .
     1987                                    else DisabledOptions = 0 .
     1988     run gbl/prnfilen.w
     1989       (input  ""
     1990       ,input  disabledoptions
     1991       ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     1992       ,input  ReportFontNum
     1993       ,output v-user-action
     1994       ,output v-printed
     1995       ) .
     1996   end procedure.
     1997   procedure foreach :
     1998   IF ( i modulo v-account = 0 )  then DO:
     1999             if  log-manager:logfile-name ne ?
     2000             then DO:
     2001                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     2002             end.
     2003              if mFrameView
     2004              then do:
     2005               DISPLAY
     2006                 i @ RecordsDone
     2007                 WITH FRAME InfoFrame.
     2008              end.
     2009   End.
     2010      if v-button-stop then  DO:
     2011            if mFrameView
     2012            then
     2013               PROCESS EVENTS.
     2014            IF StopProcessing THEN DO:
     2015            RETURN error.
     2016            End.
     2017      end.
