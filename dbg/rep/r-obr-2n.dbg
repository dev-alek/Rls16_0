     3055       , first gds-list  where gds-list.gds-code  = temp-gds-list.gds-code no-lock
     3056         break
     3057           by  temp-gds-list.grp-name
     3058           by gds-list.artic :
     3059           str = n-lavel(input gds-list.grp-name, input xlavel ) no-error .
     3060   find clients where clients.obj-type = gds-list.prod-type and
     3061                      clients.obj-code = gds-list.prod-code no-lock .
     3062     assign
     3063         gds-zap-unit-base  = gds-list.unit-base
     3064         gds-zap-prt-root   = gds-list.prt-root
     3065         gds-zap-prod-type  = gds-list.prod-type
     3066         gds-zap-prod-code  = gds-list.prod-code
     3067         gds-zap-artic      = gds-list.artic
     3068         gds-zap-type       = gds-list.gds-type
     3069         gds-zap-grp-name   = gds-list.grp-name
     3070         gds-zap-b-code     = gds-list.gds-code
     3071         gds-zap-prod-name  = clients.obj-name .
     3072     if g#gds-engl then
     3073         assign gds-zap-gds-name = gds-list.engl-name.
     3074     else
     3075         assign gds-zap-gds-name = gds-list.gds-name.
     3076   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3077     (input  gds-zap-b-code
     3078     ,input  ?
     3079     ,output v-bar-code
     3080     )  .
     3081     s-bar-code = string (v-bar-code,"999999999").
     3082     run foreach in this-procedure .
     3083       if  first-of ( temp-gds-list.grp-name )  then do:
     3084           fr = true .
     3085           l-stroka = "ГРУППА : " + str .
     3086           temp-str = l-stroka.
     3087       end.
     3088      run display-line in this-procedure .
     3089      if last-of( temp-gds-list.grp-name ) then do:
     3090         s-bar-code = "Итого по " .
     3091         gds-zap-artic = substring(str,1,16) .
     3092         gds-zap-gds-name = substring(str,17,250) .
     3093         run display-b1 in this-procedure .
     3094         run clear-b1 in this-procedure .
     3095         run clear-b2 in this-procedure .
     3096      end.
     3097     end.
     3098                     end.
     3099                 end case.
     3100      end procedure.
     3101   procedure calcitog :
     3102       run ostatok  in this-procedure(
     3103           input x-store-code  ,
     3104           input x-store-type  ,x-tog-shift,
     3105           input x-date-start - 1 ,
     3106           input date('')      , x-shift-start,x-shift-end,
     3107           input 'crsa':U   ,
     3108           input '##,##':U,
     3109           input xtog-obj ,
     3110           output  quantity1  ,
     3111           output  coast_r1   ,
     3112           output  coast_v1   ,
     3113           output  vat_r1     ,
     3114           output  vat_v1     ,
     3115           output  fact-order-1 ).
     3116       run ostatok  in this-procedure (
     3117           input x-store-code  ,
     3118           input x-store-type  , x-tog-shift,
     3119           input x-date-start  ,
     3120           input x-date-end    , x-shift-start,x-shift-end,
     3121           input 'crsa':U   ,
     3122           input '##,##':U,
     3123           input xtog-obj ,
     3124           output  quantity1  ,
     3125           output  coast_r1   ,
     3126           output  coast_v1   ,
     3127           output  vat_r1     ,
     3128           output  vat_v1     ,
     3129           output  fact-order-2 ).
     3130             quantity1  = 0.
     3131             coast_r1   = 0.
     3132             coast_v1   = 0.
     3133             vat_r1     = 0.
     3134             vat_v1     = 0.
     3135   end procedure.
     3136   procedure display-str1  :
     3137              run di-qnty  in this-procedure("кол-во", 1, s-bar-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     3138            if xshowcost    then do: run di  in this-procedure( "учет.", 2,"","","","",""). end.
     3139            if xshowcrsa    then do: run di  in this-procedure( "прод.", 5,"","","","","" ).  end.
     3140            if xshowsale    then do: run di  in this-procedure( "док." , 8,"","","","","" ).  end.
     3141            if vat-cost    then do: run di  in this-procedure( "уч.НДС", 3,"","","","","" ). end.
     3142            if vat-crsa    then do: run di  in this-procedure( "пр.НДС", 6,"","","","","" ).  end.
     3143            if vat-sale    then do: run di  in this-procedure( "дк.НДС", 9,"","","","","" ).  end.
     3144   end procedure.
     3145   procedure display-bi  :
     3146              run di-qnty in this-procedure ("кол-во",1,  "", gds-zap-artic ,"" ,"", "bi":u).
     3147            if xshowcost    then do: run di in this-procedure ("учет." , 2 , "","", "", "", "bi":u).  end.
     3148            if xshowcrsa    then do: run di in this-procedure ("прод." , 5, "","", "", "",  "bi":u).  end.
     3149            if xshowsale    then do: run di in this-procedure ("док." , 8, "","", "", "",  "bi":u).  end.
     3150            if vat-cost    then do: run di in this-procedure ( "уч.НДС", 3,"","","","","bi":u ). end.
     3151            if vat-crsa    then do: run di in this-procedure ( "пр.НДС", 6,"","","","","bi":u ).  end.
     3152            if vat-sale    then do: run di in this-procedure ( "дк.НДС", 9,"","","","","bi":u ).  end.
     3153   end procedure.
     3154   procedure display-bo  :
     3155              run di-qnty in this-procedure ("кол-во",1,  "", "ИТОГО ПО" ,"ОБЪЕКТАМ" ,"", "bo":u).
     3156            if xshowcost    then do: run di in this-procedure ("учет." , 2 , "","", "", "", "bo":u).  end.
     3157            if xshowcrsa    then do: run di in this-procedure ("прод." , 5, "","", "", "",  "bo":u).  end.
     3158            if xshowsale    then do: run di in this-procedure ("док." , 8, "","", "", "",  "bo":u).  end.
     3159            if vat-cost    then do: run di in this-procedure ( "уч.НДС", 3,"","","","","bo":u ). end.
     3160            if vat-crsa    then do: run di in this-procedure ( "пр.НДС", 6,"","","","","bo":u ).  end.
     3161            if vat-sale    then do: run di in this-procedure ( "дк.НДС", 9,"","","","","bo":u ).  end.
     3162   end procedure.
     3163   procedure display-b1  :
     3164        if not( not show-negativ-2 and
     3165            ( b1-prih         [1]   = 0 and
     3166              b1-rash          [1]   = 0 and
     3167              b1-kassa         [1]   = 0 and
     3168              b1-inv           [1]   = 0 and
     3169              b1-overturn      [1]   = 0 and
     3170              b1-overturn      [5]   = 0 and
     3171              b1-gds-zap-other       = 0 and
     3172              b1-overturn      [8]   = 0 ) ) then do:
     3173           if  not (not show-negativ  and (
     3174                 b1-prih          [1]   = 0 and
     3175                 b1-rash          [1]   = 0 and
     3176                 b1-kassa         [1]   = 0 and
     3177                 b1-inv           [1]   = 0 and
     3178                 b1-gds-zap-other       = 0 and
     3179                 b1-overturn      [1]   = 0 and
     3180                 b1-overturn      [5]   = 0 and
     3181                 b1-ostatok-start [1]   = 0 and
     3182                 b1-ostatok-end   [1]   = 0   )) then do:
     3183                 if sums-only then do:
     3184                     if fr0 = true then do:
     3185                         put stream  outstream  tmp#stroka0 format "x(100)" skip.
     3186                         if Make-Excel then  put   stream ForExcel unformatted string(tmp#stroka0) skip.
     3187                         fr0 = false .
     3188                       end.
     3189                  end.
     3190           run di-qnty in this-procedure ("кол-во"  ,1, s-bar-code, gds-zap-artic, gds-zap-gds-name ,"","b1":u).
     3191           if xshowcost    then do: run di in this-procedure ("учет." ,2 ,"","", "", "", "b1":u).  end.
     3192           if xshowcrsa    then do: run di in this-procedure ("прод." , 5, "","", "", "", "b1":u).  end.
     3193           if xshowsale    then do: run di in this-procedure ("док." , 8, "","", "", "", "b1":u).  end.
     3194           if vat-cost    then do: run di in this-procedure ( "уч.НДС", 3,"","","","","b1":u ). end.
     3195           if vat-crsa    then do: run di in this-procedure ( "пр.НДС", 6,"","","","","b1":u ).  end.
     3196           if vat-sale    then do: run di in this-procedure ( "дк.НДС", 9,"","","","","b1":u ).  end.
     3197          if not sums-only then run p-line.
     3198    end.
     3199    end.
     3200   end procedure.
     3201   procedure display-b2  :
     3202        if not( not show-negativ-2 and
     3203            ( b2-prih         [1]   = 0 and
     3204              b2-rash          [1]   = 0 and
     3205              b2-kassa         [1]   = 0 and
     3206              b2-inv           [1]   = 0 and
     3207              b2-gds-zap-other       = 0 and
     3208              b2-overturn      [1]   = 0 and
     3209              b2-overturn      [5]   = 0 and
     3210              b2-overturn      [8]   = 0 ) ) then do:
     3211           if  not (not show-negativ  and (
     3212                 b2-prih          [1]   = 0 and
     3213                 b2-rash          [1]   = 0 and
     3214                 b2-kassa         [1]   = 0 and
     3215                 b2-inv           [1]   = 0 and
     3216                 b2-gds-zap-other       = 0 and
     3217                 b2-overturn      [1]   = 0 and
     3218                 b2-overturn      [5]   = 0 and
     3219                 b2-ostatok-start [1]   = 0 and
     3220                 b2-ostatok-end   [1]   = 0   )) then do:
     3221           run di-qnty( "кол-во", 1 ,s-bar-code,gds-zap-artic, gds-zap-gds-name,"", "b2":u).
     3222           if xshowcost    then do: run di in this-procedure ("учет.", 2, "","", "", "", "b2":u).  end.
     3223           if xshowcrsa    then do: run di in this-procedure ("прод.", 5 ,"","", "", "", "b2":u).  end.
     3224           if xshowsale    then do: run di in this-procedure ("док.", 8 ,"","", "", "", "b2":u).  end.
     3225            if vat-cost    then do: run di in this-procedure ( "уч.НДС", 3,"","","","","b2":u ). end.
     3226            if vat-crsa    then do: run di in this-procedure ( "пр.НДС", 6,"","","","","b2":u ).  end.
     3227            if vat-sale    then do: run di in this-procedure ( "дк.НДС", 9,"","","","","b2":u ).  end.
     3228            if not sums-only then run u-line.
     3229    end.
     3230   end.
     3231   end procedure.
     3232   procedure clear-b1  :
     3233    b1-gds-zap-other           = 0.
     3234    repeat kk = 1 to 9 :
     3235    assign
     3236       b1-prih                                            [kk]    = 0
     3237       b1-rash                                            [kk]    = 0
     3238       b1-kassa                                           [kk]    = 0
     3239       b1-inv                                             [kk]    = 0
     3240       b1-overturn                                        [kk]    = 0
     3241       b1-ostatok-end                                     [kk]    = 0
     3242       b1-ostatok-start                                   [kk]    = 0   .
     3243      end.
     3244    end procedure.
     3245   procedure clear-b2  :
     3246    b2-gds-zap-other           = 0.
     3247    repeat kk = 1 to 9 :
     3248    assign
     3249       b2-prih                                            [kk]    = 0
     3250       b2-rash                                            [kk]    = 0
     3251       b2-kassa                                           [kk]    = 0
     3252       b2-inv                                             [kk]    = 0
     3253       b2-overturn                                        [kk]    = 0
     3254       b2-ostatok-end                                     [kk]    = 0
     3255       b2-ostatok-start                                   [kk]    = 0   .
     3256      end.
     3257   end procedure.
     3258   procedure clear-bi  :
     3259    bi-gds-zap-other           = 0.
     3260    repeat kk = 1 to 9 :
     3261    assign
     3262       bi-prih                                            [kk]    = 0
     3263       bi-rash                                            [kk]    = 0
     3264       bi-kassa                                           [kk]    = 0
     3265       bi-inv                                             [kk]    = 0
     3266       bi-overturn                                        [kk]    = 0
     3267       bi-ostatok-end                                     [kk]    = 0
     3268       bi-ostatok-start                                   [kk]    = 0   .
     3269      end.
     3270   end procedure.
     3271   procedure display-title :
     3272      PUT stream  OutStream  UNFORMATTED  string( v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + objname) at 50 format "x(85)" skip(2)
     3273             reportname  at 20 format "x(170)" skip
     3274             trim(str1)  at 35 format "x(75)" skip.
     3275        repeat i = 1 to num-entries(str2,chr(10)) :
     3276         PUT stream  OutStream  UNFORMATTED  entry(i,str2,chr(10))  at 1 format "x(170)" skip.
     3277        end.
     3278       i=0.
     3279          PUT stream  OutStream  UNFORMATTED  trim(str3)  at 35 format "x(75)" skip.
     3280        repeat i = 1 to num-entries(str4,chr(10)) :
     3281         PUT stream  OutStream  UNFORMATTED  entry(i,str4,chr(10))  at 1 format "x(170)" skip.
     3282        end.
     3283       i=0.
     3284        repeat i = 1 to num-entries(reportheader,chr(10)) :
     3285         PUT stream  OutStream  UNFORMATTED  entry(i,reportheader,chr(10))  at 1 format "x(170)" skip.
     3286        end.
     3287       i=0.
     3288       run rep/extitle.p (1) .
     3289   end procedure.
     3290   procedure ob-line  :
     3291   define input  parameter x-store-code   like ub.clients.obj-code     no-undo.
     3292   define input  parameter x-store-type   like ub.clients.obj-type     no-undo.
     3293   define input  parameter x-artic        like ub.ot-line.artic        no-undo.
     3294   define input  parameter x-prod-code    like ub.ot-line.prod-code    no-undo.
     3295   define input  parameter x-prod-type    like ub.ot-line.prod-type    no-undo.
     3296   define input  parameter x-fact-order-1   like ub.ot-line.fact-order   no-undo.
     3297   define input  parameter x-fact-order-2   like ub.ot-line.fact-order   no-undo.
     3298   define input  parameter x-sum-type       like ub.ot-line.sum-type     no-undo.
     3299   define input  parameter x-cat-id         like ub.ot-line.cat-id       no-undo.
     3300   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type no-undo.
     3301   define input  parameter xtog-obj           as log no-undo.
     3302   define variable  tt#          as   int                 no-undo.
     3303   define variable  quantity#1    like ub.stk-line.fact-qnty   no-undo.
     3304   define variable  coast_r#1     like ub.stk-line.sum-rubl    no-undo.
     3305   define variable  coast_v#1     like ub.stk-line.sum-rubl    no-undo.
     3306   define variable  vat_r#1       like ub.stk-line.sum-rubl    no-undo.
     3307   define variable  vat_v#1       like ub.stk-line.sum-rubl    no-undo.
     3308   define variable  slt_r#1       like ub.stk-line.sum-rubl    no-undo.
     3309   define variable  slt_v#1       like ub.stk-line.sum-rubl    no-undo.
     3310   define variable  other_r#1     like ub.stk-line.sum-rubl    no-undo.
     3311   define variable  other_v#1     like ub.stk-line.sum-rubl    no-undo.
     3312   define variable  l-sum-type as character no-undo .
     3313   define variable  l-cat-id   as character no-undo .
     3314   define variable v-s# as character no-undo .
     3315    if (x-sum-type = 'sale':U ) then assign tt# = 6 v-s# = 'sadt':U .
     3316    if (x-sum-type = 'crsa':U ) then assign tt# = 3 v-s# = 'cgdt':U .
     3317    if (x-sum-type = 'cost':U ) then assign tt# = 0 v-s# = 'csdt':U .
     3318    if (x-sum-type = 'sasr':U) then assign tt# = 6 v-s# = 'adsr':U .
     3319    if (x-sum-type = 'cgsr':U) then assign tt# = 3 v-s# = 'gdsr':U .
     3320    if (x-sum-type = 'cssr':U) then assign tt# = 0 v-s# = 'sdsr':U .
     3321   define variable v-i as integer no-undo .
     3322   repeat v-i = 1 to  extent(m-prih) :
     3323    run oborot-stk in this-procedure (input  x-store-code , input  x-store-type , input  x-artic ,input  x-prod-code  ,input  x-prod-type  ,input  x-tog-shift  ,input  fact-order-1 ,input  fact-order-2 , input v-s# + m-prih[v-i] , input l-cat-id , input xtog-obj     ,    output quantity#1   ,    output coast_r#1    ,    output coast_v#1    ,    output vat_r#1      ,    output vat_v#1      ,    output slt_r#1      ,    output slt_v#1      ,    output other_r#1    ,    output other_v#1    ) .
     3324       assign prih[1 + tt#]   = prih[1 + tt#] + quantity#1
     3325              prih[2 + tt#]   = prih[2 + tt#] + if tprintrubl then coast_r#1 else coast_v#1
     3326              prih[3 + tt#]   = prih[3 + tt#] + if tprintrubl then vat_r#1   else vat_v#1 .
     3327       if tt# = 6 then gds-zap-other  = gds-zap-other + if tprintrubl then other_r#1  else other_v#1  .
     3328   end.
     3329   repeat v-i = 1 to  extent(m-rash) :
     3330    run oborot-stk in this-procedure (input  x-store-code , input  x-store-type , input  x-artic ,input  x-prod-code  ,input  x-prod-type  ,input  x-tog-shift  ,input  fact-order-1 ,input  fact-order-2 , input  v-s# + m-rash[v-i] , input l-cat-id , input xtog-obj     ,    output quantity#1   ,    output coast_r#1    ,    output coast_v#1    ,    output vat_r#1      ,    output vat_v#1      ,    output slt_r#1      ,    output slt_v#1      ,    output other_r#1    ,    output other_v#1    ) .
     3331       assign rash[1 + tt#]   = rash[1 + tt#] +  quantity#1
     3332              rash[2 + tt#]   = rash[2 + tt#] +  if tprintrubl then coast_r#1 else coast_v#1
     3333              rash[3 + tt#]   = rash[3 + tt#] +  if tprintrubl then vat_r#1   else vat_v#1 .
     3334       if tt# = 6 then gds-zap-other  = gds-zap-other + if tprintrubl then other_r#1  else other_v#1  .
     3335   end.
     3336   repeat v-i = 1 to  extent(m-kassa) :
     3337    run oborot-stk in this-procedure (input  x-store-code , input  x-store-type , input  x-artic ,input  x-prod-code  ,input  x-prod-type  ,input  x-tog-shift  ,input  fact-order-1 ,input  fact-order-2 , input  v-s# + m-kassa[v-i] , input l-cat-id , input xtog-obj     ,    output quantity#1   ,    output coast_r#1    ,    output coast_v#1    ,    output vat_r#1      ,    output vat_v#1      ,    output slt_r#1      ,    output slt_v#1      ,    output other_r#1    ,    output other_v#1    ) .
     3338       assign kassa[1 + tt#]   = kassa[1 + tt#] + quantity#1
     3339              kassa[2 + tt#]   = kassa[2 + tt#] + if tprintrubl then coast_r#1 else coast_v#1
     3340              kassa[3 + tt#]   = kassa[3 + tt#] + if tprintrubl then vat_r#1   else vat_v#1 .
     3341       if tt# = 6 then gds-zap-other  = gds-zap-other + if tprintrubl then other_r#1  else other_v#1  .
     3342    end.
     3343   repeat v-i = 1 to  extent(m-inv) :
     3344    run oborot-stk in this-procedure (input  x-store-code , input  x-store-type , input  x-artic ,input  x-prod-code  ,input  x-prod-type  ,input  x-tog-shift  ,input  fact-order-1 ,input  fact-order-2 , input  v-s# + m-inv[v-i] , input l-cat-id , input xtog-obj     ,    output quantity#1   ,    output coast_r#1    ,    output coast_v#1    ,    output vat_r#1      ,    output vat_v#1      ,    output slt_r#1      ,    output slt_v#1      ,    output other_r#1    ,    output other_v#1    ) .
     3345       assign inv[1 + tt#]   = inv[1 + tt#] + quantity#1
     3346              inv[2 + tt#]   = inv[2 + tt#] + if tprintrubl then coast_r#1 else coast_v#1
     3347              inv[3 + tt#]   = inv[3 + tt#] + if tprintrubl then vat_r#1   else vat_v#1 .
     3348       if tt# = 6 then gds-zap-other  = gds-zap-other + if tprintrubl then other_r#1  else other_v#1  .
     3349   end.
     3350   repeat v-i = 1 to  extent(m-overturn) :
     3351    run oborot-stk in this-procedure (input  x-store-code , input  x-store-type , input  x-artic ,input  x-prod-code  ,input  x-prod-type  ,input  x-tog-shift  ,input  fact-order-1 ,input  fact-order-2 , input  v-s# + m-overturn[v-i] , input l-cat-id , input xtog-obj     ,    output quantity#1   ,    output coast_r#1    ,    output coast_v#1    ,    output vat_r#1      ,    output vat_v#1      ,    output slt_r#1      ,    output slt_v#1      ,    output other_r#1    ,    output other_v#1    ) .
     3352       assign overturn[1 + tt#]   = overturn[1 + tt#] + quantity#1
     3353              overturn[2 + tt#]   = overturn[2 + tt#] + if tprintrubl then coast_r#1 else coast_v#1
     3354              overturn[3 + tt#]   = overturn[3 + tt#] + if tprintrubl then vat_r#1   else vat_v#1 .
     3355       if tt# = 6 then gds-zap-other  = gds-zap-other + if tprintrubl then other_r#1  else other_v#1  .
     3356   end.
     3357     if tt# = 6 then do:
     3358          if (x-sum-type = 'sasr':U) then do:
     3359              assign
     3360              prih[1 ]   = prih[7 ]
     3361              rash[1 ]   = rash[7 ]
     3362              kassa[1]   = kassa[7]
     3363              inv[1]     = inv[7  ]
     3364              .
     3365              end.
     3366              assign overturn[1 + tt#]   = (ostatok-end[1 + tt#]  - ostatok-start[1 + tt#] )  -  (inv[1 + tt#] + prih[1 + tt#]   +  kassa[1 + tt#]  +  rash[1 + tt#]  )
     3367                     overturn[2 + tt#]   = (ostatok-end[2 + tt#]  - ostatok-start[2 + tt#] )  -  (inv[2 + tt#] + prih[2 + tt#]   +  kassa[2 + tt#]  +  rash[2 + tt#]  +  gds-zap-other )
     3368                     overturn[3 + tt#]   = (ostatok-end[3 + tt#]  - ostatok-start[3 + tt#] )  -  (inv[3 + tt#] + prih[3 + tt#]   +  kassa[3 + tt#]  +  rash[3 + tt#]  )  .
     3369     end.
     3370   end procedure.
     3371   procedure report-exec1  :
     3372      find first clients where x-store-type = clients.obj-type and
     3373                               x-store-code = clients.obj-code no-lock no-error.
     3374   IF ( i modulo v-account = 0 )  then DO:
     3375    Assign
     3376       v-kol-spice = (50 - LENGTH(clients.obj-name)) / 2
     3377       RecordsString = fill(' ',v-kol-spice) + string(clients.obj-name)
     3378       .
     3379             if  log-manager:logfile-name ne ?
     3380             then DO:
     3381                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     3382             end.
     3383              if mFrameView
     3384              then do:
     3385               DISPLAY
     3386                 i @ RecordsDone
     3387                 RecordsString   @ RecordsString
     3388                 WITH FRAME InfoFrame.
     3389              end.
     3390   End.
     3391      if v-button-stop then  DO:
     3392            if mFrameView
     3393            then
     3394               PROCESS EVENTS.
     3395            IF StopProcessing THEN DO:
     3396            RETURN error.
     3397            End.
     3398      end.
     3399     run calcitog.
     3400     run print-header.
     3401      case retclassify :
     3402        when "grp-goods":u then      run run2.
     3403      end case.
     3404     run print-footer.
     3405     end procedure.
     3406   procedure calc-sub-itog :
     3407   define input parameter tt as int no-undo.
     3408   define variable b as int no-undo.
     3409   if tt = 6  then assign
     3410     b1-gds-zap-other = b1-gds-zap-other +  gds-zap-other
     3411     b2-gds-zap-other = b2-gds-zap-other +  gds-zap-other
     3412     bi-gds-zap-other = bi-gds-zap-other +  gds-zap-other
     3413     bo-gds-zap-other = bo-gds-zap-other +  gds-zap-other
     3414     .
     3415   repeat b = 1 to 3:
     3416     assign
     3417     b1-prih[b + tt]    = b1-prih[b + tt]    +  prih[b + tt]
     3418     b2-prih[b + tt]    = b2-prih[b + tt]    +  prih[b + tt]
     3419     bi-prih[b + tt]    = bi-prih[b + tt]    +  prih[b + tt]
     3420     bo-prih[b + tt]    = bo-prih[b + tt]    +  prih[b + tt]
     3421     bo-ostatok-start[b + tt]    = bo-ostatok-start[b + tt]    +  ostatok-start[b + tt]
     3422     bo-ostatok-end[b + tt]      = bo-ostatok-end[b + tt]      +  ostatok-end[b + tt]
     3423     b1-rash[b + tt]    = b1-rash[b + tt]    +  rash[b + tt]
     3424     b2-rash[b + tt]    = b2-rash[b + tt]    +  rash[b + tt]
     3425     bi-rash[b + tt]    = bi-rash[b + tt]    +  rash[b + tt]
     3426     bo-rash[b + tt]    = bo-rash[b + tt]    +  rash[b + tt]
     3427     b1-kassa[b + tt]    = b1-kassa[b + tt]    +  kassa[b + tt]
     3428     b2-kassa[b + tt]    = b2-kassa[b + tt]    +  kassa[b + tt]
     3429     bi-kassa[b + tt]    = bi-kassa[b + tt]    +  kassa[b + tt]
     3430     bo-kassa[b + tt]    = bo-kassa[b + tt]    +  kassa[b + tt]
     3431     b1-inv[b + tt]    = b1-inv[b + tt]    +  inv[b + tt]
     3432     b2-inv[b + tt]    = b2-inv[b + tt]    +  inv[b + tt]
     3433     bi-inv[b + tt]    = bi-inv[b + tt]    +  inv[b + tt]
     3434     bo-inv[b + tt]    = bo-inv[b + tt]    +  inv[b + tt]
     3435     b1-overturn[b + tt]    = b1-overturn[b + tt]    +  overturn[b + tt]
     3436     b2-overturn[b + tt]    = b2-overturn[b + tt]    +  overturn[b + tt]
     3437     bi-overturn[b + tt]    = bi-overturn[b + tt]    +  overturn[b + tt]
     3438     bo-overturn[b + tt]    = bo-overturn[b + tt]    +  overturn[b + tt] .
     3439   end.
     3440   end procedure.
     3441   procedure clear-item :
     3442   define variable kk as int no-undo.
     3443    gds-zap-other = 0 .
     3444    repeat kk = 1 to 9 :
     3445    assign
     3446       prih            [kk]    = 0
     3447       rash            [kk]    = 0
     3448       kassa           [kk]    = 0
     3449       inv             [kk]    = 0
     3450       overturn        [kk]    = 0
     3451       ostatok-end     [kk]    = 0
     3452       ostatok-start   [kk]    = 0 .
     3453          end.
     3454    end procedure.
     3455   procedure item-goods :
     3456      define input parameter  par-3 as char no-undo.
     3457      define input parameter  par-4 as char no-undo.
     3458        if par-4 = "goods":u  then do:
     3459           assign
     3460               gds-zap-unit-base  = goods.unit-base
     3461               gds-zap-prt-root   = goods.prt-root
     3462               gds-zap-prod-type  = goods.prod-type
     3463               gds-zap-prod-code  = goods.prod-code
     3464               gds-zap-artic      = goods.artic
     3465               gds-zap-grp-name   = goods.grp-name
     3466               gds-zap-b-code     = goods.gds-code
     3467               gds-zap-type       = goods.gds-type.
     3468           if g#gds-engl then
     3469               assign gds-zap-gds-name = goods.engl-name.
     3470           else
     3471               assign gds-zap-gds-name = goods.gds-name.
     3472        end.
     3473        if par-4 = "gds-list":u  then do:
     3474           assign
     3475               gds-zap-unit-base  = gds-list.unit-base
     3476               gds-zap-prt-root   = gds-list.prt-root
     3477               gds-zap-prod-type  = gds-list.prod-type
     3478               gds-zap-prod-code  = gds-list.prod-code
     3479               gds-zap-artic      = gds-list.artic
     3480               gds-zap-grp-name   = gds-list.grp-name
     3481               gds-zap-b-code     = gds-list.gds-code
     3482               gds-zap-type       = gds-list.gds-type.
     3483           if g#gds-engl then
     3484               assign gds-zap-gds-name = gds-list.engl-name.
     3485           else
     3486               assign gds-zap-gds-name = gds-list.gds-name.
     3487       end.
     3488       run foreach  in this-procedure.
     3489   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3490     (input  gds-zap-b-code
     3491     ,input  ?
     3492     ,output v-bar-code
     3493     )  .
     3494   s-bar-code = string (v-bar-code,"999999999").
     3495       If  break_group = true  and par-3 <> "1"  then DO :
     3496            FIND FIRST clients WHERE clients.obj-type = gds-zap-prod-type AND clients.obj-code = gds-zap-prod-code use-index pi NO-LOCK .
     3497            gds-zap-prod-name  = clients.obj-name.
     3498             If break_group1 = true  THEN  DO :
     3499               if (par-3 = "3"  OR  par-3 = "5" ) and  par-3 <> "6"
     3500                 then DO: Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )         b1-name = gds-zap-grp-name . end.
     3501                 else DO: Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) b1-name = gds-zap-prod-name. end.
     3502               if par-3 = "6"  then  dO:
     3503                  if xTog-obj = true then do:
     3504                    var-vat-pc = func-vat (input gds-zap-b-code , input x-store-type, input x-store-code)
     3505                     .
     3506                   end.
     3507                  else do:
     3508                   var-vat-pc = temp-gds-list.vat-pc .
     3509                   end.
     3510                   assign
     3511                       temp-str = string( "СТАВКА НДС : " + string(var-vat-pc) + "%" )
     3512                       b1-name = temp-str.
     3513                   end.
     3514               if NOT xSumsOnly or (par-3 = "4" Or par-3 = "5" ) THEN DO :
     3515                   fr0 = true .
     3516                   tmp#stroka0 = temp-str.
     3517               End.
     3518             End.
     3519               IF (par-3 = "4"  OR  par-3 = "5")  THEN DO:
     3520                 if par-3 = "4"
     3521                   then Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )          b2-name = gds-zap-grp-name .
     3522                   else Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name )  b2-name = gds-zap-prod-name.
     3523                 if NOT xSumsOnly THEN DO:
     3524                     fr = true .
     3525                 End.
     3526                 break_group1 = false.
     3527               END.
     3528          break_group = false.
     3529       End.
     3530       run display-line  in this-procedure.
     3531    end procedure.
     3532   procedure di :
     3533   define input parameter p1 as char no-undo.
     3534   define input parameter p2 as int no-undo.
     3535   define input parameter p3 as char no-undo.
     3536   define input parameter p4 as char no-undo.
     3537   define input parameter p5 as char no-undo.
     3538   define input parameter p6 as char no-undo.
     3539   define input parameter p7 as char no-undo.
     3540    case caps(p7) :
     3541      when "b1":u  then do:
     3542       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3543         p3 @ s-bar-code
     3544         p4 @ gds-zap-artic
     3545         p5 @ gds-zap-gds-name
     3546         p6 @ gds-zap-unit-base
     3547         p1 @ gds-type
     3548         b1-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     3549         b1-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     3550         b1-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     3551         b1-KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     3552         b1-Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     3553         b1-Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     3554         b1-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     3555         b1-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     3556         with FRAME ZAPAS .
     3557                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     3558                   end.
     3559      when "b2":u  then  do:
     3560       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3561         p3 @ s-bar-code
     3562         p4 @ gds-zap-artic
     3563         p5 @ gds-zap-gds-name
     3564         p6 @ gds-zap-unit-base
     3565         p1 @ gds-type
     3566         b2-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     3567         b2-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     3568         b2-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     3569         b2-KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     3570         b2-Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     3571         b2-Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     3572         b2-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     3573         b2-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     3574         with FRAME ZAPAS .
     3575                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     3576                 end.
     3577      when "bi":u then  do:
     3578       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3579         p3 @ s-bar-code
     3580         p4 @ gds-zap-artic
     3581         p5 @ gds-zap-gds-name
     3582         p6 @ gds-zap-unit-base
     3583         p1 @ gds-type
     3584         bi-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     3585         bi-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     3586         bi-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     3587         bi-KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     3588         bi-Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     3589         bi-Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     3590         bi-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     3591         bi-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     3592         with FRAME ZAPAS .
     3593                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     3594                 end.
     3595      when "bo":u then  do:
     3596       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3597         p3 @ s-bar-code
     3598         p4 @ gds-zap-artic
     3599         p5 @ gds-zap-gds-name
     3600         p6 @ gds-zap-unit-base
     3601         p1 @ gds-type
     3602         bo-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     3603         bo-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     3604         bo-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     3605         bo-KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     3606         bo-Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     3607         bo-Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     3608         bo-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     3609         bo-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     3610         with FRAME ZAPAS .
     3611                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     3612                 end.
     3613      when ""  then  do:
     3614       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3615         p3 @ s-bar-code
     3616         p4 @ gds-zap-artic
     3617         p5 @ gds-zap-gds-name
     3618         p6 @ gds-zap-unit-base
     3619         p1 @ gds-type
     3620         ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     3621         Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     3622         RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     3623         KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     3624         Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     3625         Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     3626         Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     3627         gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     3628         with FRAME ZAPAS .
     3629                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     3630                 end.
     3631      end case.
     3632    end procedure.
     3633   procedure di-qnty :
     3634   define input parameter p1 as char no-undo.
     3635   define input parameter p2 as int no-undo.
     3636   define input parameter p3 as char no-undo.
     3637   define input parameter p4 as char no-undo.
     3638   define input parameter p5 as char no-undo.
     3639   define input parameter p6 as char no-undo.
     3640   define input parameter p7 as char no-undo.
     3641    case caps(p7) :
     3642      when "b1":u  then do :
     3643       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3644         p3 @ s-bar-code
     3645         p4 @ gds-zap-artic
     3646         p5 @ gds-zap-gds-name
     3647         p6 @ gds-zap-unit-base
     3648         p1 @ gds-type
     3649         b1-ostatok-start [p2] format "->>>>>>>>>>9.<<<" @  F-ostatok-start
     3650         b1-Prih          [p2] format "->>>>>>>>>>9.<<<" @  F-Prih
     3651         b1-RAsh          [p2] format "->>>>>>>>>>9.<<<" @  F-RAsh
     3652         b1-KAssa         [p2] format "->>>>>>>>>>9.<<<" @  F-KAssa
     3653         b1-Inv           [p2] format "->>>>>>>>>>9.<<<" @  F-Inv
     3654         b1-Overturn      [p2] format "->>>>>>>>>>9.<<<" @  F-Overturn
     3655         b1-Ostatok-end   [p2] format "->>>>>>>>>>9.<<<" @  F-Ostatok-end
     3656         b1-gds-zap-other      format "->>>>>>>>>>9.<<<" when (p2 = 1) @  gds-zap-other
     3657         with FRAME ZAPAS .
     3658   if Make-Excel then  put   stream ForExcel unformatted
     3659     p3 CHR(9)
     3660     p4 CHR(9)
     3661     gds-zap-gds-name CHR(9)
     3662     p6 CHR(9)
     3663     gds-zap-type     CHR(9)
     3664     excel-sum(b1-gds-zap-other   )   CHR(9)
     3665     excel-qnty(b1-ostatok-start[1])  CHR(9)
     3666     excel-sum(b1-ostatok-start[2])  CHR(9)
     3667     excel-sum(b1-ostatok-start[5])  CHR(9)
     3668     excel-sum(b1-ostatok-start[8])  CHR(9)
     3669     excel-sum(b1-ostatok-start[3])  CHR(9)
     3670     excel-sum(b1-ostatok-start[6])  CHR(9)
     3671     excel-sum(b1-ostatok-start[9])  CHR(9)
     3672     excel-qnty(b1-Prih         [1])  CHR(9)
     3673     excel-sum(b1-Prih         [2])  CHR(9)
     3674     excel-sum(b1-Prih         [5])  CHR(9)
     3675     excel-sum(b1-Prih         [8])  CHR(9)
     3676     excel-sum(b1-Prih         [3])  CHR(9)
     3677     excel-sum(b1-Prih         [6])  CHR(9)
     3678     excel-sum(b1-Prih         [9])  CHR(9)
     3679     excel-qnty(b1-RAsh         [1])  CHR(9)
     3680     excel-sum(b1-RAsh         [2])  CHR(9)
     3681     excel-sum(b1-RAsh         [5])  CHR(9)
     3682     excel-sum(b1-RAsh         [8])  CHR(9)
     3683     excel-sum(b1-RAsh         [3])  CHR(9)
     3684     excel-sum(b1-RAsh         [6])  CHR(9)
     3685     excel-sum(b1-RAsh         [9])  CHR(9)
     3686     excel-qnty(b1-KAssa        [1])  CHR(9)
     3687     excel-sum(b1-KAssa        [2])  CHR(9)
     3688     excel-sum(b1-KAssa        [5])  CHR(9)
     3689     excel-sum(b1-KAssa        [8])  CHR(9)
     3690     excel-sum(b1-KAssa        [3])  CHR(9)
     3691     excel-sum(b1-KAssa        [6])  CHR(9)
     3692     excel-sum(b1-KAssa        [9])  CHR(9)
     3693     excel-qnty(b1-Inv          [1])  CHR(9)
     3694     excel-sum(b1-Inv          [2])  CHR(9)
     3695     excel-sum(b1-Inv          [5])  CHR(9)
     3696     excel-sum(b1-Inv          [8])  CHR(9)
     3697     excel-sum(b1-Inv          [3])  CHR(9)
     3698     excel-sum(b1-Inv          [6])  CHR(9)
     3699     excel-sum(b1-Inv          [9])  CHR(9)
     3700     excel-qnty(b1-Overturn     [1])  CHR(9)
     3701     excel-sum(b1-Overturn     [2])  CHR(9)
     3702     excel-sum(b1-Overturn     [5])  CHR(9)
     3703     excel-sum(b1-Overturn     [8])  CHR(9)
     3704     excel-sum(b1-Overturn     [3])  CHR(9)
     3705     excel-sum(b1-Overturn     [6])  CHR(9)
     3706     excel-sum(b1-Overturn     [9])  CHR(9)
     3707     excel-qnty(b1-Ostatok-end  [1])  CHR(9)
     3708     excel-sum(b1-Ostatok-end  [2])  CHR(9)
     3709     excel-sum(b1-Ostatok-end  [5])  CHR(9)
     3710     excel-sum(b1-Ostatok-end  [8])  CHR(9)
     3711     excel-sum(b1-Ostatok-end  [3])  CHR(9)
     3712     excel-sum(b1-Ostatok-end  [6])  CHR(9)
     3713     excel-sum(b1-Ostatok-end  [9])  CHR(9)
     3714     skip.
     3715                   end.
     3716      when "b2":u  then do :
     3717       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
