      760   procedure ost-line :
      761     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
      762     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
      763     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
      764     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
      765     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
      766     define input  parameter x-tog-shift  as logical no-undo .
      767     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
      768     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
      769     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
      770     define input  parameter xtog-obj     as logical no-undo .
      771     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
      772     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
      773     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
      774     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
      775     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
      776     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
      777     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
      778     define buffer buff-obj-list  for obj-list .
      779     define buffer buff-stk-line  for ub.stk-line .
      780     assign
      781       Quantity = 0
      782       Coast_R  = 0
      783       Coast_V  = 0
      784       VAT_R    = 0
      785       VAT_V    = 0
      786       SLT_R    = 0
      787       SLT_V    = 0
      788     .
      789     if  x-tog-shift = false then do:
      790       for each buff-obj-list no-lock
      791       on error undo, return error
      792       :
      793         find last buff-stk-line no-lock
      794           where buff-stk-line.obj-type   = buff-obj-list.obj-type
      795             and buff-stk-line.obj-code   = buff-obj-list.obj-code
      796             and buff-stk-line.artic      = x-artic
      797             and buff-stk-line.prod-type  = x-prod-type
      798             and buff-stk-line.prod-code  = x-prod-code
      799             and buff-stk-line.sum-type   = x-sum-type
      800             and buff-stk-line.cat-id     = '##,##':U
      801             and buff-stk-line.fact-order <= x-fact-order
      802             and buff-stk-line.shift-num  = 0
      803           use-index category
      804           no-error .
      805         if available buff-stk-line then do:
      806           assign
      807             Quantity = Quantity +  buff-stk-line.fact-qnty
      808             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
      809             Coast_V  = Coast_V  +  buff-stk-line.sum-base
      810             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
      811             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
      812             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
      813             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
      814           .
      815         end.
      816       end.
      817     end.
      818     else do:
      819       for each buff-obj-list no-lock
      820         where xtog-obj = false
      821            or (buff-obj-list.obj-type = x-store-type
      822               and buff-obj-list.obj-code = x-store-code
      823               )
      824       on error undo, return error
      825       :
      826         find last buff-stk-line no-lock
      827           where buff-stk-line.obj-type   = buff-obj-list.obj-type
      828             and buff-stk-line.obj-code   = buff-obj-list.obj-code
      829             and buff-stk-line.artic      = x-artic
      830             and buff-stk-line.prod-type  = x-prod-type
      831             and buff-stk-line.prod-code  = x-prod-code
      832             and buff-stk-line.sum-type   = x-sum-type
      833             and buff-stk-line.cat-id     = '##,##':U
      834             and buff-stk-line.fact-order <= x-fact-order
      835             and buff-stk-line.shift-num  > 0
      836           use-index category
      837           no-error .
      838         if available buff-stk-line then do:
      839           assign
      840             Quantity = Quantity +  buff-stk-line.fact-qnty
      841             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
      842             Coast_V  = Coast_V  +  buff-stk-line.sum-base
      843             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
      844             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
      845             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
      846             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
      847           .
      848         end.
      849       end.
      850     end.
      851   end procedure.
      852   procedure ost-lineother-tax :
      853     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
      854     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
      855     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
      856     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
      857     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
      858     define input  parameter x-tog-shift  as logical no-undo .
      859     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
      860     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
      861     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
      862     define input  parameter xTog-obj     as logical no-undo .
      863     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
      864     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
      865     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
      866     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
      867     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
      868     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
      869     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
      870     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
      871     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
      872     define buffer buff-obj-list  for obj-list .
      873     define buffer buff-stk-line  for ub.stk-line .
      874     assign
      875       Quantity = 0
      876       Coast_R  = 0
      877       Coast_V  = 0
      878       VAT_R    = 0
      879       VAT_V    = 0
      880       SLT_R    = 0
      881       SLT_V    = 0
      882       other_R  = 0
      883       other_V  = 0
      884     .
      885     if  x-tog-shift = false then do:
      886       for each buff-obj-list no-lock
      887       on error undo, return error
      888       :
      889         find last buff-stk-line no-lock
      890           where buff-stk-line.obj-type   = buff-obj-list.obj-type
      891             and buff-stk-line.obj-code   = buff-obj-list.obj-code
      892             and buff-stk-line.artic      = x-artic
      893             and buff-stk-line.prod-type  = x-prod-type
      894             and buff-stk-line.prod-code  = x-prod-code
      895             and buff-stk-line.sum-type   = x-sum-type
      896             and buff-stk-line.cat-id     = '##,##':U
      897             and buff-stk-line.fact-order <= x-fact-order
      898             and buff-stk-line.shift-num  = 0
      899           use-index category
      900           no-error .
      901         if available buff-stk-line then do:
      902           assign
      903             Quantity = Quantity +  buff-stk-line.fact-qnty
      904             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
      905             Coast_V  = Coast_V  +  buff-stk-line.sum-base
      906             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
      907             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
      908             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
      909             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
      910             other_R  = other_R  +  buff-stk-line.other-rubl
      911             other_V  = other_V  +  buff-stk-line.other-base
      912           .
      913         end.
      914       end.
      915     end.
      916     else do:
      917       for each buff-obj-list no-lock
      918         where xtog-obj = false
      919            or (buff-obj-list.obj-type = x-store-type
      920               and buff-obj-list.obj-code = x-store-code
      921               )
      922       on error undo, return error
      923       :
      924         find last buff-stk-line no-lock
      925           where buff-stk-line.obj-type   = buff-obj-list.obj-type
      926             and buff-stk-line.obj-code   = buff-obj-list.obj-code
      927             and buff-stk-line.artic      = x-artic
      928             and buff-stk-line.prod-type  = x-prod-type
      929             and buff-stk-line.prod-code  = x-prod-code
      930             and buff-stk-line.sum-type   = x-sum-type
      931             and buff-stk-line.cat-id     = '##,##':U
      932             and buff-stk-line.fact-order <= x-fact-order
      933             and buff-stk-line.shift-num  > 0
      934           use-index category
      935           no-error .
      936         if available buff-stk-line then do:
      937           assign
      938             Quantity = Quantity +  buff-stk-line.fact-qnty
      939             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
      940             Coast_V  = Coast_V  +  buff-stk-line.sum-base
      941             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
      942             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
      943             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
      944             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
      945             other_R = other_R   +  buff-stk-line.other-rubl
      946             other_V = other_V   +  buff-stk-line.other-base
      947           .
      948         end.
      949       end.
      950     end.
      951   end procedure.
      952   procedure ost-line-kg :
      953     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
      954     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
      955     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
      956     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
      957     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
      958     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
      959     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
      960     define buffer buff-obj-list  for obj-list .
      961     define buffer buf_doc-line for ub.doc-line .
      962     define buffer buf_inv-line for ub.inv-line .
      963     do
      964     on error undo, return error
      965     :
      966       for each buf_doc-line no-lock where
      967                buf_doc-line.obj-type    = p-obj-type   and
      968                buf_doc-line.obj-code    = p-obj-code   and
      969                buf_doc-line.prod-type   = p-prod-type  and
      970                buf_doc-line.prod-code   = p-prod-code  and
      971                buf_doc-line.artic       = p-artic      and
      972                buf_doc-line.status_     = 'факт':U      and
      973                buf_doc-line.fact-order <= p-fact-order
      974             by buf_doc-line.fact-order    descending
      975       :
      976         find first buf_inv-line no-lock where
      977                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
      978                    buf_inv-line.artic     = buf_doc-line.artic     and
      979                    buf_inv-line.prod-type = buf_doc-line.prod-type and
      980                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
      981         if available buf_inv-line
      982         then do:
      983           if buf_inv-line.after-cli-qnty <> ?
      984           then do:
      985             assign
      986               p-quantity-kg = buf_inv-line.after-cli-qnty
      987             .
      988             leave .
      989           end.
      990         end.
      991       end.
      992       if p-quantity-kg = ?
      993       then do:
      994         assign
      995           p-quantity-kg = 0
      996         .
      997       end.
      998     end.
      999   end procedure.
     1000   PROCEDURE ostatok :
     1001   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     1002   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     1003   def input parameter x-tog-shift   as   logical             no-undo.
     1004   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     1005   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     1006   def input parameter x-shift-start as integer               no-undo.
     1007   def input parameter x-shift-end   as integer               no-undo.
     1008   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     1009   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     1010   def input parameter xTog-obj   as log no-undo.
     1011   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     1012   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     1013   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     1014   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     1015   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     1016   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     1017   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     1018   def var              Fact-orderS   as char  no-undo.
     1019   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     1020      Assign
     1021         Fact-order   = 0
     1022         Quantity     = 0
     1023         Coast_R      = 0
     1024         Coast_V      = 0
     1025         VAT_R        = 0
     1026         VAT_V        = 0 .
     1027    x-date-start-t  = x-date-start + 1 .
     1028   IF x-date-end = date('') then DO:
     1029      Fact-order = 0 .
     1030      for each obj-list
     1031          where  ( not xtog-obj or
     1032                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     1033                 no-lock :
     1034         if  x-tog-shift = false then do:
     1035                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1036                               ub.stk-tot.Fact-date <=  x-date-start
     1037                               and ub.stk-tot.shift-num = 0
     1038                               USE-INDEX fact-date no-lock no-error .
     1039              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1040         End.
     1041         Else  DO :
     1042             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1043              (ub.stk-tot.shift-date  = x-date-start-t and
     1044               ub.stk-tot.shift-num  < x-shift-start or
     1045               ub.stk-tot.shift-date  < x-date-start-t  )
     1046               and ub.stk-tot.shift-num  > 0
     1047               USE-INDEX Shift-num no-lock no-error .
     1048            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1049           END.
     1050       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     1051     End.
     1052   End.
     1053   Else DO:
     1054     For each obj-list  WHERE
     1055        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     1056         no-lock :
     1057      IF  x-TOG-Shift = False Then DO:
     1058          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1059               ub.stk-tot.Fact-date <= x-date-end
     1060               and ub.stk-tot.shift-num = 0
     1061               USE-INDEX fact-date no-lock no-error.
     1062          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1063      END.
     1064      Else DO:
     1065           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1066               (ub.stk-tot.shift-date  = x-date-end and
     1067               ub.stk-tot.shift-num  <= x-shift-end or
     1068               ub.stk-tot.shift-date  < x-date-end       ) and
     1069               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     1070               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1071       End.
     1072       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     1073     End.
     1074   End.
     1075   END PROCEDURE.
     1076   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     1077     if num-entries(string(p-dec), '.') = 2
     1078       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     1079       else return( string(p-dec)) .
     1080   end function.
     1081   function format-point-to-comma returns char (input orig as char ) .
     1082   define variable rtext as character no-undo .
     1083   define variable strt as integer no-undo .
     1084   define variable leng as integer no-undo .
     1085   assign rtext = orig .
     1086   repeat:
     1087     strt =  index(rtext,'.').
     1088     if strt = 0 then leave.
     1089     leng = 1.
     1090     substring(rtext,strt,leng,"character") = v-delim .
     1091   end.
     1092   return rtext.
     1093   end function.
     1094   function format-excel-text returns char ( input start-text as char ) :
     1095   def var  i    as int no-undo.
     1096   def var  ch   as char no-undo.
     1097   def var  n    as int no-undo.
     1098   def var  ipos as int no-undo.
     1099     n = num-entries(trim(start-text), chr(10)) - 1 .
     1100     do i = 1 to n :
     1101       ipos = index( start-text, chr(10)).
     1102       if ipos > 0 then
     1103         substr( start-text, ipos, 1 ) = ' '.
     1104     end.
     1105     n = num-entries(trim(start-text), chr(13)) - 1 .
     1106     do i = 1 to n :
     1107       ipos = index( start-text, chr(13)).
     1108       if ipos > 0 then
     1109         substr( start-text, ipos, 1 ) = ' '.
     1110     end.
     1111     if index( start-text, '"' ) = 0 then
     1112       start-text =  '="'   + trim( start-text) + '"'   .
     1113       else do:
     1114         n = num-entries(trim(start-text), '"') - 1.
     1115         do i = 1 to n :
     1116           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1117         end.
     1118         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1119         start-text = '="'  + ch  + '"' .
     1120       end.
     1121     return start-text.
     1122   end.
     1123   function excel-sum returns char (input p-dec as decimal ).
     1124     if p-access = true then do:
     1125        return(string(round(p-dec,2))) .
     1126     end.
     1127     else do:
     1128         return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     1129     end.
     1130   end function.
     1131   function excel-qnty returns char (input p-dec as decimal ).
     1132     if p-access = true then do:
     1133        return(string(round(p-dec,3))) .
     1134     end.
     1135     else do:
     1136         return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     1137     end.
     1138   end function.
     1139   function format-excel-text-macr returns char ( input start-text as char ) :
     1140   def var  i    as int no-undo.
     1141   def var  ch   as char no-undo.
     1142   def var  n    as int no-undo.
     1143   def var  ipos as int no-undo.
     1144     n = num-entries(trim(start-text), chr(10)) - 1 .
     1145     do i = 1 to n :
     1146       ipos = index( start-text, chr(10)).
     1147       if ipos > 0 then
     1148         substring( start-text, ipos , 1 ) = ' '.
     1149     end.
     1150     n = num-entries(trim(start-text), chr(13)) - 1 .
     1151     do i = 1 to n :
     1152       ipos = index( start-text, chr(13)).
     1153       if ipos > 0 then
     1154         substring( start-text, ipos, 1 ) = ' '.
     1155     end.
     1156     if index( start-text, '"' ) = 0 then
     1157       start-text =  '"'   + trim( start-text) + '"'   .
     1158       else do:
     1159         n = num-entries(trim(start-text), '"') - 1.
     1160         do i = 1 to n :
     1161           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1162         end.
     1163         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1164         start-text = '"'  + ch  + '"' .
     1165       end.
     1166     n = num-entries(trim(start-text), chr(10)) - 1 .
     1167     do i = 1 to n :
     1168       ipos = index( start-text, chr(10)).
     1169       if ipos > 0 then
     1170         substring( start-text, ipos , 1 ) = ' '.
     1171     end.
     1172       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     1173     return start-text.
     1174   end.
     1175   function func-vat returns decimal (
     1176       input p-gds-code as integer  ,
     1177       input p-obj-type as character ,
     1178       input p-obj-code as integer  ).
     1179   define variable i-vat-pc as decimal no-undo .
     1180   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1181   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1182     (input  p-gds-code
     1183     ,input  '1':U
     1184     ,input  x-Date-End
     1185     ,input  v-cntxt-host-code-obj
     1186     ,input  p-obj-type
     1187     ,input  p-obj-code
     1188     ,output i-vat-pc
     1189     ) no-error .
     1190   if error-status :error then return 0 .
     1191   else return i-vat-pc.
     1192   end function .
     1193   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1194   procedure cur-time :
     1195      define output parameter p-today as date      no-undo .
     1196      define output parameter p-time  as integer   no-undo .
     1197     do
     1198     on error undo, return error
     1199     :
     1200       define variable v-date1 as date      no-undo .
     1201       define variable v-date2 as date      no-undo .
     1202       define variable v-time  as integer   no-undo .
     1203       assign
     1204         v-date1 = today
     1205         v-time  = time
     1206         v-date2 = today
     1207       .
     1208       if v-date1 <> v-date2
     1209       then do:
     1210         assign
     1211           v-date1 = today
     1212           v-time  = v-time
     1213         .
     1214       end.
     1215       assign
     1216         p-today = v-date1
     1217         p-time  = v-time
     1218       .
     1219     end.
     1220   end.
     1221   function cur-time-date returns character
     1222   :
     1223     return string(today, '99/99/9999':U) .
     1224   end.
     1225   function cur-time-mjd returns decimal
     1226   :
     1227     define variable v-date as date      no-undo .
     1228     define variable v-time as integer   no-undo .
     1229     run cur-time in this-procedure
     1230       (output v-date
     1231       ,output v-time
     1232       ) .
     1233     return integer(v-date) - 2400002 + (v-time / 86400) .
     1234   end.
     1235   function cur-time-get-ending-index returns integer
     1236   (input p-number as integer
     1237   )
     1238   :
     1239     if p-number < 0
     1240     or p-number = ?
     1241     then do:
     1242       return 1 .
     1243     end.
     1244     define variable v-rest as integer   no-undo .
     1245     assign
     1246       p-number = p-number modulo 100
     1247     .
     1248     if p-number < 20
     1249     then do:
     1250       assign
     1251         v-rest = p-number
     1252       .
     1253     end.
     1254     else do:
     1255       assign
     1256         v-rest = p-number modulo 10
     1257       .
     1258     end.
     1259     case v-rest :
     1260       when 1
     1261       then do:
     1262         return 2 .
     1263       end.
     1264       when 2 or
     1265       when 3 or
     1266       when 4
     1267       then do:
     1268         return 3 .
     1269       end.
     1270       otherwise do:
     1271         return 1 .
     1272       end.
     1273     end case .
     1274   end.
     1275   procedure cur-time-mjd-to-date :
     1276      define input  parameter i-mjd-diff as decimal no-undo.
     1277      define output parameter o-Date     as date    no-undo.
     1278      define output parameter o-Time     as integer no-undo.
     1279      define variable v-day-number as integer   no-undo .
     1280      if    i-mjd-diff < 0
     1281         or i-mjd-diff = ?
     1282      then do:
     1283         return "?" .
     1284      end.
     1285      assign
     1286         v-day-number = truncate(i-mjd-diff,0).
     1287         o-Date = date(v-day-number + 2400002).
     1288         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1289     .
     1290   end.
     1291   function cur-time-mjd-to-string returns character
     1292   (input p-mjd-diff as decimal
     1293   )
     1294   :
     1295     define variable v-day-number as integer   no-undo .
     1296     define variable v-seconds    as integer   no-undo .
     1297     define variable v-hour       as integer   no-undo .
     1298     define variable v-min        as integer   no-undo .
     1299     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1300     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1301     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1302     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1303     if p-mjd-diff < 0
     1304     or p-mjd-diff = ?
     1305     then do:
     1306       return "?" .
     1307     end.
     1308     assign
     1309       v-day-number = integer(truncate(p-mjd-diff,0))
     1310       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1311     .
     1312     if v-seconds > 86400
     1313     then do:
     1314       assign
     1315         v-seconds = 86400 - 1
     1316       .
     1317     end.
     1318     if v-seconds < 0
     1319     then do:
     1320       assign
     1321         v-seconds = 0
     1322       .
     1323     end.
     1324     assign
     1325       v-hour = truncate(v-seconds / 3600, 0)
     1326     .
     1327     assign
     1328       v-seconds = v-seconds modulo 3600
     1329     .
     1330     assign
     1331       v-min = truncate(v-seconds / 60, 0)
     1332     .
     1333     assign
     1334       v-seconds = v-seconds modulo 60
     1335     .
     1336     return
     1337         (if v-day-number <> 0
     1338           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1339           else ""
     1340         )
     1341       + (if v-day-number <> 0 or v-hour <> 0
     1342           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1343           else ""
     1344         )
     1345       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1346           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1347           else ""
     1348         )
     1349       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1350       .
     1351   end.
     1352   function cur-time-string returns character
     1353   :
     1354     define variable v-date as date      no-undo .
     1355     define variable v-time as integer   no-undo .
     1356     run cur-time in this-procedure
     1357       (output v-date
     1358       ,output v-time
     1359       ) .
     1360     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1361   end.
     1362   function cur-time-string-sec returns character
     1363   :
     1364     define variable v-date as date      no-undo .
     1365     define variable v-time as integer   no-undo .
     1366     run cur-time in this-procedure
     1367       (output v-date
     1368       ,output v-time
     1369       ) .
     1370     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1371   end.
     1372   function cur-time-custom  returns character
     1373   (input p-prefix as character
     1374   ,input p-date-format as character
     1375   ,input p-delimiter as character
     1376   ,input p-time-format as character
     1377   ,input p-suffix as character
     1378   )
     1379   :
     1380     define variable v-date as date      no-undo .
     1381     define variable v-time as integer   no-undo .
     1382     run cur-time in this-procedure
     1383       (output v-date
     1384       ,output v-time
     1385       ) .
     1386     return
     1387       p-prefix
     1388       + string(v-date, p-date-format)
     1389       + p-delimiter
     1390       + string(v-time, p-time-format)
     1391       + p-suffix
     1392       .
     1393   end.
     1394   function cur-time-print  returns character
     1395   :
     1396     define variable v-date as date      no-undo .
     1397     define variable v-time as integer   no-undo .
     1398     run cur-time in this-procedure
     1399       (output v-date
     1400       ,output v-time
     1401       ) .
     1402     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1403   end.
     1404   function cur-time-datetime returns datetime
     1405   :
     1406     define variable v-char as character no-undo .
     1407     define variable v-datetime as datetime no-undo .
     1408     v-char = cur-time-string().
     1409     v-datetime = datetime(v-char).
     1410     return  v-datetime.
     1411   end.
     1412   function cur-time-string-msec returns character
     1413   :
     1414     define variable v-date as datetime  no-undo .
     1415     v-date = now.
     1416     return string(v-date) .
     1417   end.
     1418   define temp-table temp-font no-undo
     1419     field fontnum  as integer
     1420     field fontname as character
     1421     field fontsize as character
     1422     field fonttype as character
     1423     field font-h   as integer
     1424     field font-w   as integer
     1425     field v-row    as integer
     1426     field v-col    as integer
     1427     field v-row-lans as integer
     1428     field v-col-lans as integer
     1429   index pi fontnum
     1430   .
     1431   procedure get-font-ini :
     1432     do
     1433     on error undo, return error return-value
     1434     :
     1435   define variable ii as integer   no-undo .
     1436   define variable v-font7 as character no-undo .
     1437   define variable v-font as character no-undo .
     1438   define variable loc-name as character no-undo .
     1439   define variable loc-size as character no-undo .
     1440   define variable loc-type as character no-undo .
     1441   define variable old_H as integer   no-undo .
     1442   define variable old_w as integer   no-undo .
     1443   define variable old-row  as integer   no-undo .
     1444   define variable old-col  as integer   no-undo .
     1445   define variable old-row-lans  as integer   no-undo .
     1446   define variable old-col-lans  as integer   no-undo .
     1447   define variable vv as integer   no-undo .
     1448   empty temp-table temp-font.
     1449     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     1450       case num-entries (v-font7) :
     1451         when 4 then do:
     1452             assign
     1453               loc-name = entry ( 1 , v-font7 )
     1454               loc-size = entry ( 2 , v-font7 )
     1455               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     1456             .
     1457         end.
     1458         when 3 then do:
     1459             assign
     1460               loc-name = entry ( 1 , v-font7 )
     1461               loc-size = entry ( 2 , v-font7 )
     1462               loc-type = entry ( 3 , v-font7 )
     1463             .
     1464         end.
     1465         when 2 then  do:
     1466             assign
     1467               loc-name = entry ( 1 , v-font7 )
     1468               loc-size = entry ( 2 , v-font7 )
     1469               loc-type = ""
     1470             .
     1471         end.
     1472         when 1 then do:
     1473             assign
     1474               loc-name = trim(entry ( 1 , v-font7 ))
     1475               loc-size = ""
     1476               loc-type = ""
     1477             .
     1478         end.
     1479       end case.
     1480     create temp-font.
     1481     assign
     1482       temp-font.fontnum  = 7
     1483       temp-font.fontname = trim(loc-name)
     1484       temp-font.fontsize = trim(loc-size)
     1485       temp-font.fonttype = trim(loc-type)
     1486       temp-font.v-row    = 62
     1487       temp-font.v-col    = 136
     1488       temp-font.v-row-lans = 43
     1489       temp-font.v-col-lans = 198
     1490     .
     1491     repeat ii = 16 to 100 :
     1492       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     1493       if v-font = "" or v-font = ? then leave.
     1494       case num-entries (v-font) :
     1495         when 4 then do:
     1496             assign
     1497               loc-name = entry ( 1 , v-font )
     1498               loc-size = entry ( 2 , v-font )
     1499               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     1500             .
     1501         end.
     1502         when 3 then do:
     1503             assign
     1504               loc-name = entry ( 1 , v-font )
     1505               loc-size = entry ( 2 , v-font )
     1506               loc-type = entry ( 3 , v-font )
     1507             .
     1508         end.
     1509         when 2 then do:
     1510             assign
     1511               loc-name = entry ( 1 , v-font )
     1512               loc-size = entry ( 2 , v-font )
     1513               loc-type = ""
     1514             .
     1515         end.
     1516         when 1 then do:
     1517             assign
     1518               loc-name = trim(entry ( 1 , v-font ))
     1519               loc-size = ""
     1520               loc-type = ""
     1521             .
     1522         end.
     1523       end case.
     1524     create temp-font.
     1525     assign
     1526       temp-font.fontnum  = ii
     1527       temp-font.fontname = trim(loc-name)
     1528       temp-font.fontsize = trim(loc-size)
     1529       temp-font.fonttype = trim(loc-type)
     1530     .
     1531     end.
     1532       for each temp-font :
     1533          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     1534          if  vv = ? then vv =  0 .
     1535           run rep/exfont.p (
     1536             input   temp-font.fontname ,
     1537             input   vv ,
     1538             input   temp-font.fonttype ,
     1539             output  temp-font.font-h   ,
     1540             output  temp-font.font-w   )
     1541           .
     1542       end.
     1543   find first temp-font where  temp-font.fontnum  = 7  .
     1544   old_H = temp-font.font-H .
     1545   old_w = temp-font.font-W .
     1546   old-row = temp-font.v-row .
     1547   old-col = temp-font.v-col .
     1548   old-row-lans = temp-font.v-row-lans .
     1549   old-col-lans = temp-font.v-col-lans .
     1550       for each temp-font where
     1551                temp-font.fontnum  <> 7 :
     1552           assign
     1553               temp-font.v-row    = old_H * old-row / temp-font.font-h
     1554               temp-font.v-col    = old_W * old-col / temp-font.font-W
     1555               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     1556               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     1557           .
     1558       end.
     1559     end.
     1560   end procedure.
     1561   PROCEDURE How-name :
     1562   define input  parameter h as integer no-undo .
     1563   define input  parameter w as integer no-undo .
     1564   define output parameter n as character  no-undo .
     1565   define variable A4port-H as integer   no-undo init 63.
     1566   define variable A4port-W as integer   no-undo init 136.
     1567   define variable A4lans-H as integer   no-undo init 43.
     1568   define variable A4lans-W as integer   no-undo init 198.
     1569   define variable Strim-W  as integer   no-undo init 278.
     1570   run define-a4-size (
     1571        input ReportFontNum
     1572       ,output A4port-H
     1573       ,output A4port-W
     1574       ,output A4lans-H
     1575       ,output A4lans-W ).
     1576   If w >= 1 and w <= A4port-W Then DO:
     1577     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1578     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     1579     If h > A4port-H              Then n = "to-file":U.
     1580   End.
     1581   If w > A4port-W and w <= A4lans-W Then DO:
     1582     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1583     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1584     If h > A4port-H              Then n = "to-file":U.
     1585   End.
     1586   If w > A4lans-W and w <= Strim-W Then DO:
     1587     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     1588     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1589     If h > A4port-H              Then n = "to-file":U.
     1590   End.
     1591   If w > Strim-W Then DO:
     1592      n = "to-file":U.
     1593   End.
     1594   END PROCEDURE.
     1595   PROCEDURE define-a4-size :
     1596   define input  parameter p-ReportFontNum as integer   no-undo .
     1597   define output parameter A4port-H as integer   no-undo .
     1598   define output parameter A4port-W as integer   no-undo .
     1599   define output parameter A4lans-H as integer   no-undo .
     1600   define output parameter A4lans-W as integer   no-undo .
     1601   if not can-find (first temp-font ) then do:
     1602      run get-font-ini .
     1603   end.
     1604   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     1605   if available temp-font then do:
     1606   assign
     1607     A4port-H = temp-font.v-row
     1608     A4port-W = temp-font.v-col
     1609     A4lans-H = temp-font.v-row-lans
     1610     A4lans-W = temp-font.v-col-lans
     1611   .
     1612   end.
     1613   else do:
     1614   assign
     1615     A4port-H = 63
     1616     A4port-W = 136
     1617     A4lans-H = 43
     1618     A4lans-W = 198
     1619   .
     1620   end.
     1621   END PROCEDURE.
