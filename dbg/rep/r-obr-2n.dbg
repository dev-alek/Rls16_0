     2447   no-lock
     2448   BREAK
     2449         BY (temp-gds-list.grp-name)
     2450       BY (temp-gds-list.artic) :
     2451         run item-goods ( "3" , "goods" ) .
     2452         if return-value <> "" then NEXT.
     2453           If Last-of(temp-gds-list.grp-name) Then Do:
     2454           If String(Entry(2,"temp-gds-list.grp-name",".")) = "Grp-name"
     2455             Then  Assign
     2456                     S-bar-code   = " Итого по "
     2457                     Gds-zap-artic = Substring(
     2458                                         B1-name
     2459                                         ,1,16)
     2460                     Gds-zap-gds-name = Substring(
     2461                                         B1-name
     2462                                         ,17,40)
     2463                                   .
     2464             Else  Assign
     2465                     S-bar-code   = ""
     2466                     Gds-zap-artic = "        Итого по "
     2467                     Gds-zap-gds-name =  B1-name
     2468                                   .
