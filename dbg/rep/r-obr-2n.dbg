     2470               Run Clear-b1 In This-procedure .
     2471               Assign Break_Group = True.
     2472           End.
     2473       End.
     2474     END.
     2475     Else DO:
     2476      For each obj-list no-lock :
     2477                     FOR EACH gds-obj where
     2478                   gds-obj.obj-type = obj-list.obj-type    and
     2479                   gds-obj.obj-code = obj-list.obj-code
     2480                   and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2481                   no-lock :
     2482                   if NOT can-find(First temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) Then do:
     2483                       find first goods no-lock  where goods.gds-code  = gds-obj.gds-code .
