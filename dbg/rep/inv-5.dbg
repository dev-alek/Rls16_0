        1   block-level on error undo, throw.
        2   define input parameter parParentProc      as handle no-undo .
        3   define input parameter rec_id             as recid no-undo .
        4   define input parameter rep-tipe           as character no-undo.
        5   define input parameter p-grp              as character no-undo.
        6   define input parameter print-graft        as logical          no-undo.
        7   define variable vss-revision    as character no-undo initial "$Revision: 03c97b127fc3, 2119, rls $":U .
        8   define variable vss-author      as character no-undo initial "$Author: SMMolotkov $":U .
        9   define variable vss-date        as character no-undo initial "$Date: Wed Dec 25 15:23:52 2019 +0300 $":U .
       10   define variable vss-workfile    as character no-undo initial "$Workfile: inv-5.p $":U .
       11   define variable vss-archive     as character no-undo initial "$Archive: rep/inv-5.p $":U .
       12   define variable vss-description as character no-undo initial "Формы по инвентаризации ".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71       def var t-addres        like ub.firm.addres1   no-undo.
       72       def var t-phone         like ub.firm.phone     no-undo.
       73       def var t-inn           like ub.firm.inn       no-undo.
       74       def var t-okpo          like ub.firm.okpo      no-undo.
       75       def var t-temp-address  like ub.firm.addres1   no-undo.
       76   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       77   define new global shared variable g#trdcalib as handle no-undo.
       78   FUNCTION MonthNameRusCase RETURNS CHARACTER ( INPUT i-month AS INTEGER, INPUT i-case AS INTEGER ) :
       79     DEFINE VARIABLE v-name AS CHARACTER NO-UNDO.
       80     RUN get-month-name-case IN THIS-PROCEDURE ( INPUT i-month, INPUT i-case, OUTPUT v-name ) NO-ERROR.
       81     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-name ).
       82   END FUNCTION.
       83   PROCEDURE get-month-name-case :
       84     DEFINE  INPUT PARAMETER p-month AS INTEGER   NO-UNDO.
       85     DEFINE  INPUT PARAMETER p-case  AS INTEGER   NO-UNDO.
       86     DEFINE OUTPUT PARAMETER p-name  AS CHARACTER NO-UNDO.
       87     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO EXTENT 6 INITIAL
       88       [ "Январь,Февраль,Март,Апрель,Май,Июнь,Июль,Август,Сентябрь,Октябрь,Ноябрь,Декабрь",
       89         "января,февраля,марта,апреля,мая,июня,июля,августа,сентября,октября,ноября,декабря",
       90         "Январю,Февралю,Марту,Апрелю,Маю,Июню,Июлю,Августу,Сентябрю,Октябрю,Ноябрю,Декабрю",
       91         "Январь,Февраль,Март,Апрель,Май,Июнь,Июль,Август,Сентябрь,Октябрь,Ноябрь,Декабрь",
       92         "Январем,Февралем,Мартом,Апрелем,Маем,Июнем,Июлем,Августом,Сентябрем,Октябрем,Ноябрем,Декабрем",
       93         "Январе,Феврале,Марте,Апреле,Мае,Июне,Июле,Августе,Сентябре,Октябре,Ноябре,Декабре"              ].
       94     DO ON ERROR UNDO, RETURN ERROR :
       95       IF p-month < 1 OR p-month > 12 OR
       96          p-case  < 1 OR p-case  >  6 THEN DO:
       97         ASSIGN p-name = ?.
       98       END.                           ELSE DO:
       99         ASSIGN p-name = ENTRY( p-month, v-list[ p-case ] ).
      100       END.
      101     END.
      102   END PROCEDURE.
      103   FUNCTION Sparse RETURNS CHARACTER ( INPUT p-instring AS CHARACTER ) :
      104     DEFINE VARIABLE v-outstring AS CHARACTER NO-UNDO.
      105     RUN get-sparsed-string IN THIS-PROCEDURE ( INPUT p-instring, OUTPUT v-outstring ) NO-ERROR.
      106     RETURN ( IF ERROR-STATUS :ERROR THEN p-instring ELSE v-outstring ).
      107   END FUNCTION.
      108   PROCEDURE get-sparsed-string :
      109     DEFINE  INPUT PARAMETER p-instring  AS CHARACTER NO-UNDO.
      110     DEFINE OUTPUT PARAMETER p-outstring AS CHARACTER NO-UNDO INITIAL "":U.
      111     DEFINE VARIABLE jj AS INTEGER NO-UNDO.
      112     DO ON ERROR UNDO, RETURN ERROR :
      113       DO jj = 1 TO LENGTH( p-instring ) :
      114         ASSIGN p-outstring = p-outstring + ( IF p-outstring = "":U THEN "":U ELSE " ":U ) + SUBSTRING( p-instring, jj, 1 ).
      115       END.
      116       ASSIGN p-outstring = CAPS( TRIM( p-outstring ) ).
      117     END.
      118   END PROCEDURE.
      119     define temp-table temp-str no-undo
      120         field   prod-type         as character
      121         field   prod-code         as integer
      122         field   prod-name         as character
      123         field   prod-okpo         as character
      124         field   gds-name          as character
      125         field   artic             as character
      126         field   store-name        as character
      127         field   unit-base         as character
      128         field   OKEI              as integer
      129         field   a-qnty            as decimal
      130         field   a-stoim           as decimal
      131         field   b-qnty            as decimal
      132         field   b-stoim           as decimal
      133     .
      134   define variable g#gds-engl    as logical no-undo .
      135   define variable g#report-num  as integer no-undo .
      136   define variable v-prn0        as character no-undo .
      137   define variable v-par-type    as character no-undo .
      138   define variable v-organization as character no-undo .
      139   define variable v-store-name   as character no-undo .
      140   define variable v-doc-code     as character no-undo .
      141   define variable v-doc-date     as date no-undo .
      142   define variable v-sfact-date   as character no-undo .
      143   define variable v-sfact-prop   as character no-undo .
      144   define variable v-prod-name    as character no-undo .
      145   define variable v-prod-okpo    as character no-undo .
      146   define variable v-price-lastin as decimal no-undo .
      147   define variable v-a-qnty       as decimal no-undo .
      148   define variable v-a-stoim      as decimal no-undo .
      149   define variable v-b-qnty       as decimal no-undo .
      150   define variable v-b-stoim      as decimal no-undo .
      151   define variable v-sum          as decimal no-undo .
      152   define variable v-a-stoim-tot  as decimal no-undo .
      153   define variable v-b-stoim-tot  as decimal no-undo .
      154   define variable v-a-quant-tot  as decimal no-undo .
      155   define variable v-b-quant-tot  as decimal no-undo .
      156   define variable PropisSumall   as character no-undo .
      157   define variable abbr           as character no-undo .
      158   define buffer buf_goods        for ub.goods .
      159   define buffer buf_units        for ub.units .
      160   define buffer buf_clients      for ub.clients .
      161   define buffer This_Object      for ub.clients .
      162   define buffer buf_clients0     for ub.clients .
      163   define buffer buf_trn-doc      for ub.trn-doc .
      164   define buffer buf_doc-line     for ub.doc-line .
      165   define buffer buf_doc-line-sum for ub.doc-line-sum .
      166   define buffer buf_trn-doc2     for ub.trn-doc .
      167   define buffer buf_doc-line2    for ub.doc-line .
      168   do
      169   on error undo, return error
      170   :
      171      find first buf_trn-doc no-lock where recid(buf_trn-doc) = rec_id no-error .
      172      if not available buf_trn-doc then return error .
      173      assign
      174        g#gds-engl   = false
      175        g#report-num = 0
      176      .
      177      if valid-handle (parParentProc) then do :
      178        if can-do (parParentProc:internal-entries, "get-gds-engl":U) then
      179          run get-gds-engl   in parParentProc ( output g#gds-engl ).
      180        if can-do (parParentProc:internal-entries, "get-report-num":U) then
      181          run get-report-num in parParentProc ( output g#report-num ).
      182      end .
      183      run gbl/conf-rd.p ("invprn0", "", "", 0, "", "", "", no, output v-prn0, output v-par-type) no-error.
      184      if error-status:error then v-prn0 = 'yes' .
      185      find first This_Object no-lock
      186           where This_Object.obj-type = buf_trn-doc.obj-type
      187             and This_Object.obj-code = buf_trn-doc.obj-code no-error .
      188      v-store-name = if available This_Object then This_Object.obj-name
      189                                              else substitute("&1&2", buf_trn-doc.obj-type, buf_trn-doc.obj-code) .
      190     assign
      191       v-prod-name    = ""
      192       v-prod-okpo    = ""
      193       v-price-lastin = 0
      194       v-a-stoim-tot = 0
      195       v-b-stoim-tot = 0
      196       v-a-quant-tot = 0
      197       v-b-quant-tot = 0
      198     .
      199   for each buf_doc-line no-lock
      200      where buf_doc-line.doc-code = buf_trn-doc.doc-code :
      201     find first buf_goods no-lock
      202          where buf_goods.prod-type = buf_doc-line.prod-type
      203            and buf_goods.prod-code = buf_doc-line.prod-code
      204            and buf_goods.artic     = buf_doc-line.artic    no-error.
      205     if not available buf_goods then next .
      206     find first buf_units no-lock
      207          where buf_units.unit-name = buf_doc-line.unit-cli no-error.
      208     if not available buf_units then do :
      209       find first buf_units no-lock
      210            where buf_units.unit-name = buf_goods.unit-base no-error.
      211       if not available buf_units then next .
      212     end .
      213     do :
      214       for each buf_doc-line2 no-lock
      215          where buf_doc-line2.obj-type  = buf_trn-doc.obj-type
      216            and buf_doc-line2.obj-code  = buf_trn-doc.obj-code
      217            and buf_doc-line2.prod-type = buf_doc-line.prod-type
      218            and buf_doc-line2.prod-code = buf_doc-line.prod-code
      219            and buf_doc-line2.artic     = buf_doc-line.artic
      220            and buf_doc-line2.ext-doc-type = 'ie':U
      221            and buf_doc-line2.status_   = 'факт':U,
      222          first buf_trn-doc2 no-lock
      223          where buf_trn-doc2.doc-code   = buf_doc-line2.doc-code
      224             by buf_doc-line2.fact-order descending :
      225         find first buf_clients no-lock
      226              where buf_clients.obj-type = buf_trn-doc2.cli-type
      227                and buf_clients.obj-code = buf_trn-doc2.cli-code no-error .
      228         if available buf_clients then do :
      229       case buf_clients.obj-type:
      230          when 'орг':U
      231          then do:
      232               FIND ub.firm WHERE ub.firm.firm-code = buf_clients.obj-code NO-LOCK .
      233               if available ub.firm
      234               then do:
      235                   assign
      236                       t-addres = ( if ub.firm.ind = 0 or ub.firm.ind = ? then "" else string( ub.firm.ind ) )
      237                       t-addres = t-addres
      238                           + ( if ub.firm.city = ? or trim(ub.firm.city) = ""
      239                               then ""
      240                               else ( (if t-addres = "" then "" else ", ") + trim( ub.firm.city ) )
      241                             )
      242                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 1, 50 ) ) )
      243                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
      244                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
      245                           + ( if  ub.firm.addres2 = ? or trim(ub.firm.addres2) = "" then "" else ( ", " + trim( ub.firm.addres2 ) ) )
      246                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 51, 50 ) ) )
      247                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
      248                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
      249                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 101, 50 ) ) )
      250                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
      251                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
      252                       t-phone = ub.firm.phone
      253                       t-inn   = ub.firm.inn
      254                       t-okpo  = ub.firm.okpo
      255                   .
      256               end.
      257          end.
      258          when 'маг':U
      259          then do:
      260               FIND ub.shop WHERE ub.shop.obj-code = buf_clients.obj-code NO-LOCK .
      261               if available ub.shop
      262               then do:
      263                   assign
      264                       t-addres = ( if trim( shop.addres1 ) <> "" then ( trim( shop.addres1 ) ) else "" )
      265                               + ( if trim( shop.addres2 ) <> "" then ( ", " + trim( shop.addres2 ) ) else "" )
      266                       t-phone = shop.phone
      267                       t-inn = ""
      268                       t-okpo = ""
      269                   .
      270               end.
      271          end.
      272          when 'скл':U
      273          then do:
      274               FIND ub.store WHERE ub.store.obj-code = buf_clients.obj-code NO-LOCK .
      275               if available ub.store
      276               then do:
      277                   assign
      278                       t-addres = ( if trim( ub.store.addres1 ) <> "" then ( trim( ub.store.addres1 ) ) else "" )
      279                               + ( if trim( ub.store.addres2 ) <> "" then ( ", " + trim( ub.store.addres2 ) ) else "" )
      280                       t-phone = ub.store.phone
      281                       t-inn = ""
      282                       t-okpo = ""
      283                   .
      284               end.
      285          end.
      286          when 'чел':U
      287          then do:
      288               find ub.person where ub.person.psn-code = buf_clients.obj-code no-lock .
      289               if available ub.person
      290               then do:
      291                   assign
      292                       t-addres = ( if ub.person.ind <> 0 and ub.person.ind <> ? then string( ub.person.ind ) else "" )
      293                                   + ( if  ub.person.city <> ? and trim(ub.person.city) <> "" then ( ", " + trim( ub.person.city ) ) else "" )
      294                                   + ( if  ub.person.address <> ? and trim(ub.person.address) <> "" then ( ", " + trim( ub.person.address ) ) else "" )
      295                       t-phone = ub.person.phone1
      296                       t-inn = ub.person.inn
      297                       t-okpo = ub.person.okpo
      298                   .
      299               end.
      300          end.
      301       end case.
      302           assign
      303             v-prod-name    = buf_clients.obj-name
      304             v-prod-okpo    = t-okpo
      305             v-price-lastin = buf_doc-line2.price-rubl
      306           .
      307           leave .
      308         end .
      309       end .
      310     end .
      311     do :
      312       find first buf_doc-line-sum no-lock
      313            where buf_doc-line-sum.doc-code = buf_doc-line.doc-code
      314              and buf_doc-line-sum.gds-code = buf_goods.gds-code
      315              and buf_doc-line-sum.sum-type = 'bd':U no-error.
      316       if available buf_doc-line-sum then assign
      317         v-b-qnty  = buf_doc-line-sum.fact-qnty
      318         v-b-stoim = buf_doc-line-sum.cost-sum-rubl
      319       .
      320       else assign
      321         v-b-qnty  = 0
      322         v-b-stoim = 0
      323       .
      324       find first buf_doc-line-sum no-lock
      325            where buf_doc-line-sum.doc-code = buf_doc-line.doc-code
      326              and buf_doc-line-sum.gds-code = buf_goods.gds-code
      327              and buf_doc-line-sum.sum-type = 'ad':U no-error.
      328       if available buf_doc-line-sum then assign
      329         v-a-qnty  = buf_doc-line-sum.fact-qnty
      330         v-a-stoim = buf_doc-line-sum.cost-sum-rubl
      331       .
      332       else assign
      333         v-a-qnty  = v-b-qnty  + buf_doc-line.fact-qnty
      334       .
      335       v-a-stoim = v-a-qnty * v-price-lastin .
      336       if v-prn0 = "no" then do:
      337         if v-a-qnty = 0 and v-a-stoim = 0 and v-b-qnty = 0 and v-b-stoim = 0 then next .
      338       end.
      339     end .
      340     create temp-str.
      341     assign
      342       temp-str.prod-name   = v-prod-name
      343       temp-str.prod-okpo   = v-prod-okpo
      344       temp-str.gds-name    = ( if g#gds-engl then buf_goods.engl-name else buf_goods.gds-name )
      345       temp-str.artic       = buf_doc-line.artic
      346       temp-str.store-name  = v-store-name
      347       temp-str.unit-base   = buf_units.unit-name
      348       temp-str.OKEI        = buf_units.OKEI
      349       temp-str.a-qnty      = v-a-qnty
      350       temp-str.a-stoim     = v-a-stoim
      351       temp-str.b-qnty      = v-b-qnty
      352       temp-str.b-stoim     = v-b-stoim
      353       v-a-stoim-tot = v-a-stoim-tot + v-a-stoim
      354       v-b-stoim-tot = v-b-stoim-tot + v-b-stoim
      355       v-a-quant-tot = v-a-quant-tot + v-a-qnty
      356       v-b-quant-tot = v-b-quant-tot + v-b-qnty
      357     .
      358   end.
      359      find first buf_clients0 no-lock
      360           where buf_clients0.obj-type = 'орг':U
      361             and buf_clients0.obj-code = buf_trn-doc.host-code no-error .
      362      v-organization =
      363      if available buf_clients0 then substitute( "&1", CAPS(buf_clients0.obj-name))
      364                                else substitute( "&1 (&2)", 'орг':U, buf_trn-doc.host-code)
      365      .
      366      assign
      367        v-doc-code = buf_trn-doc.doc-code
      368        v-doc-date = buf_trn-doc.doc-date
      369      .
      370      if buf_trn-doc.fact-date = ? then assign
      371        v-sfact-date = ""
      372        v-sfact-prop = ""
      373      .
      374      else assign
      375        v-sfact-date = string(buf_trn-doc.fact-date,"99/99/9999")
      376        v-sfact-prop = "&laquo;" + string(day(buf_trn-doc.fact-date)) + "&raquo;" +
      377                       substitute(" &1 &2 г.",
      378                                  MonthNameRusCase( month( buf_trn-doc.fact-date ), 2 ),
      379                                  year(buf_trn-doc.fact-date)
      380                                 )
      381      .
      382      run rep/wp-rub.p (input v-a-stoim-tot, output PropisSumall, output abbr) .
      383   function fnc-convert-dot-to-colon returns character
      384       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
      385   function fnc-convert-dot-to-colon returns character
      386   (input p-data as decimal, input p-accur as character, input p-num as integer):
      387       define variable result as character no-undo.
      388       define variable v-str-result as character no-undo.
      389       if p-data = ? then p-data = 0 .
      390       p-data = round(p-data, p-num).
      391       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
      392       return v-str-result.
      393   END FUNCTION.
      394   define new global shared variable g#library  as handle no-undo .
      395   define new global shared variable g#library2 as handle no-undo .
      396   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      397   define  stream PrnLibStream.
      398   procedure prn-lib-prn-file :
      399     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      400     define input parameter p-DIsabledoptions as integer no-undo .
      401     define variable v-report-name as character no-undo .
      402     define variable v-user-action as character no-undo .
      403     define variable v-printed     as logical   no-undo .
      404     define variable v-exist       as logical   no-undo .
      405     do
      406       on error undo, return error
      407       :
      408       run prn-lib-get-report-name  in this-procedure (
      409         input parParentProc
      410         ,output v-report-name
      411         ).
      412   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      413   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      414     (input  v-report-name
      415     ,input  2
      416     ,output v-exist
      417     )  .
      418       if NOT v-exist then
      419       DO:
      420         Message
      421           "Нет заданий на печать ! "
      422           view-as alert-box .
      423         Return  .
      424       End.
      425       run gbl/prnfilen.w
      426         (input  ""
      427         ,input  p-DisabledOptions
      428         ,input  string(v-report-name )
      429         ,input  7
      430         ,output v-user-action
      431         ,output v-printed
      432         ) .
      433       if v-printed then
      434       do:
      435         return "YES" .
      436       end.
      437       else
      438       do:
      439         return "NO" .
      440       end.
      441     end.
      442   end procedure.
      443   procedure prn-lib-open-stream :
      444     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      445     define input parameter p-page-size    as integer no-undo .
      446     define input parameter p-is-stream    as logical no-undo .
      447     define input parameter p-append       as logical no-undo .
      448     define variable v-report-name as character no-undo .
      449     do
      450       on error undo, return error
      451       :
      452       run prn-lib-get-report-name  in this-procedure (
      453         input parParentProc
      454         ,output v-report-name
      455         ).
      456       if p-is-stream then
      457       do:
      458         if p-append then
      459         do:
      460           output stream PrnLibStream to value( v-report-name )
      461             page-size value(p-page-size) append .
      462         end.
      463         if not p-append then
      464         do:
      465           output stream PrnLibStream to value( v-report-name )
      466             page-size value(p-page-size) .
      467         end.
      468       end.
      469       if not p-is-stream then
      470       do:
      471         if p-append then
      472         do:
      473           output to value( v-report-name )
      474             page-size value(p-page-size) append .
      475         end.
      476         if not p-append then
      477         do:
      478           output to value( v-report-name )
      479             page-size value(p-page-size) .
      480         end.
      481       end.
      482     end.
      483   end procedure.
      484   procedure prn-lib-open-exp :
      485     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      486     define input parameter p-is-stream    as logical no-undo .
      487     define input parameter p-is-append    as logical no-undo .
      488     define output parameter p-ReportFileName as char init "report" no-undo.
      489     define output parameter p-process as logical no-undo .
      490     define variable glog as logical no-undo .
      491     do
      492       on error undo, return error
      493       :
      494       SYSTEM-DIALOG GET-FILE p-ReportFileName
      495         TITLE      "Укажите путь"
      496         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      497         ASK-OVERWRITE
      498         CREATE-TEST-FILE
      499         SAVE-AS
      500         USE-FILENAME
      501         DEFAULT-EXTENSION "txt"
      502         UPDATE glog
      503         .
      504       if not glog then  return.
      505       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      506       if p-is-stream then
      507       do:
      508         if p-is-append then
      509         do:
      510           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      511         end.
      512         else
      513         do:
      514           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      515         end.
      516       end.
      517       else
      518       do:
      519         if p-is-append then
      520         do:
      521           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      522         end.
      523         else
      524         do:
      525           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      526         end.
      527       end.
      528       p-process = yes.
      529     end.
      530   end procedure.
      531   procedure prn-lib-get-report-name :
      532     define input parameter parParentProc  as widget-handle no-undo.
      533     define output parameter p-report-name as character no-undo .
      534     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      535   end procedure.
      536   procedure prn-lib-reportviewer-report-name :
      537     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      538     define input parameter p-report-name-html as character no-undo .
      539     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      540   end procedure.
      541   procedure prn-lib-reportviewer :
      542     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      543     define input parameter p-report-name-html as character no-undo .
      544     define input parameter p-param        as character no-undo .
      545     define variable v-excel           as character no-undo init 'TRUE' .
      546     define variable v-value-character as character no-undo .
      547     define variable v-value-integer   as character no-undo .
      548     define variable v-value-date      as date      no-undo .
      549     define variable v-value-decimal   as decimal   no-undo .
      550     define variable rep-excel         as logical   no-undo .
      551     define variable excel-string      as character no-undo .
      552     define variable v-param-type      as character no-undo .
      553     define variable v-tth             as handle    no-undo .
      554     run adm/shattri.p (
      555       input "get":U
      556       ,input  ""
      557       ,input  0
      558       ,input  'report-glob':U
      559       ,input  'rep-excel':U
      560       ,output v-value-character
      561       ,output v-value-date
      562       ,output v-value-decimal
      563       ,output v-value-integer
      564       ,output rep-excel
      565       ,output v-param-type
      566       ,INPUT-OUTPUT table-handle v-tth
      567       )  .
      568     if rep-excel then v-excel = "TRUE" .
      569     else v-excel = "FALSE" .
      570     if p-param eq ""
      571     then
      572        p-param = "EXCEL:" + v-excel.
      573     else
      574        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      575     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
