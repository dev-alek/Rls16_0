      908        put stream OutStr-html unformatted
      909          '  <tr>'
      910          substitute('<td>&1</td>', Lines_Counter)
      911          substitute('<td text_wrap="true">&1</td>', temp-str.prod-name)
      912          substitute('<td>&1</td>', temp-str.prod-okpo)
