      922          substitute('<td num="0.000" val="&1">&1</td>', fnc-convert-dot-to-colon(temp-str.a-qnty, "->>>>>>>>>>>9.999",3)  )
      923          substitute('<td num="0.00"  val="&1">&1</td>', fnc-convert-dot-to-colon(temp-str.a-stoim,"->>>>>>>>>>>9.99", 2)  )
