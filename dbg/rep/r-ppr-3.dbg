     4695      End case.
     4696                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     4697    END PROCEDURE.
     4698   PROCEDURE Di-qnty :
     4699   def input parameter p1 as char no-undo.
     4700   def input parameter p2 as int no-undo.
     4701   def input parameter p3 as char no-undo.
     4702   def input parameter p4 as char no-undo.
     4703   def input parameter p5 as char no-undo.
     4704   def input parameter p6 as char no-undo.
     4705   def input parameter p7 as char no-undo.
     4706    CASE CAPS ( p7) :
     4707      WHEN "P":U  Then DO :
     4708                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym13
     4709                   p3 @ gds-zap-b-code
     4710                   p4 @ gds-zap-artic
     4711                   p5 @ gds-zap-gds-name
     4712                   p6 @ gds-zap-unit-base
     4713                   p1 @ gds-type
     4714                  p-vzvr      [p2]    @  F-vzvr
     4715                  p-vzvr-post [p2]    @  F-vzvr-post
     4716                  p-Prih      [p2]    @  F-Prih
     4717                  p-RAsh      [p2]    @  F-RAsh
     4718                  p-KAssa     [p2]    @  F-KAssa
     4719                  p-Inv       [p2]    @  F-Inv
     4720                  p-spis      [p2]    @  F-spis
     4721                  p-sm        [p2]    @  F-sm
     4722                  with FRAME ZAPAS .
     4723       if Make-Excel then  put   stream ForExcel unformatted p3 CHR(9)
     4724                   p4 CHR(9)
     4725                   p5 CHR(9)
     4726                   p6 CHR(9)
     4727                   gds-zap-type CHR(9)
     4728                   p-Prih[1]  CHR(9)
     4729   if Showcost       then (     excel-sum(p-Prih [2]) + CHR(9)   ) else ("")
     4730   if Show-cost-vat  then (     excel-sum  (   p-Prih [3]) + CHR(9)   ) else ("")
     4731   if Showsale       then (     excel-sum  (   p-Prih [5]) + CHR(9)   ) else ("")
     4732   if Show-sale-vat  then (     excel-sum  (   p-Prih [6]) + CHR(9)   ) else ("")
     4733                     p-RAsh         [1] FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4734   if Showcost       then (     excel-sum  (   p-RAsh[2] )  + CHR(9)   ) else ("")
     4735   if Show-cost-vat  then (     excel-sum  (   p-RAsh[3] )  + CHR(9)   ) else ("")
     4736   if Showsale       then (     excel-sum  (   p-RAsh[5] )  + CHR(9)   ) else ("")
     4737   if Show-sale-vat  then (     excel-sum  (   p-RAsh[6] )  + CHR(9)   ) else ("")
     4738                    p-KAssa        [1] FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4739   if Showcost       then (     excel-sum  (   p-KAssa[2])  + CHR(9)    ) else ("")
     4740   if Show-cost-vat  then (     excel-sum  (   p-KAssa[3])  + CHR(9)    ) else ("")
     4741   if Showsale       then (     excel-sum  (   p-KAssa[5])  + CHR(9)    ) else ("")
     4742   if Show-sale-vat  then (     excel-sum  (   p-KAssa[6])  + CHR(9)    ) else ("")
     4743   .
     4744   if Make-Excel then  put   stream ForExcel unformatted     p-Inv            [1] FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4745   if Showcost       then (     excel-sum  (   p-Inv [2] ) + CHR(9)    ) else ("")
     4746   if Show-cost-vat  then (     excel-sum  (   p-Inv [3] ) + CHR(9)    ) else ("")
     4747   if Showsale       then (     excel-sum  (   p-Inv [5] ) + CHR(9)    ) else ("")
     4748   if Show-sale-vat  then (     excel-sum  (   p-Inv [6] ) + CHR(9)    ) else ("")
     4749                    p-vzvr         [1] FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4750   if Showcost       then (     excel-sum  (   p-vzvr [2] ) + CHR(9)    ) else ("")
     4751   if Show-cost-vat  then (     excel-sum  (   p-vzvr [3] ) + CHR(9)    ) else ("")
     4752   if Showsale       then (     excel-sum  (   p-vzvr [5] ) + CHR(9)    ) else ("")
     4753   if Show-sale-vat  then (     excel-sum  (   p-vzvr [6] ) + CHR(9)    ) else ("")
     4754                   p-vzvr-post    [1] FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4755   if Showcost       then (     excel-sum  (   p-vzvr-post[2] ) + CHR(9)     ) else ("")
     4756   if Show-cost-vat  then (     excel-sum  (   p-vzvr-post[3] ) + CHR(9)     ) else ("")
     4757   if Showsale       then (     excel-sum  (   p-vzvr-post[5] ) + CHR(9)     ) else ("")
     4758   if Show-sale-vat  then (     excel-sum  (   p-vzvr-post[6] ) + CHR(9)     ) else ("")
     4759            chr(10).
     4760                   End.
     4761      WHEN "O":U  Then DO :
     4762                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym13
     4763                   p3 @ gds-zap-b-code
     4764                   p4 @ gds-zap-artic
     4765                   p5 @ gds-zap-gds-name
     4766                   p6 @ gds-zap-unit-base
     4767                   p1 @ gds-type
     4768                  o-vzvr      [p2]    @  F-vzvr
     4769                  o-vzvr-post [p2]    @  F-vzvr-post
     4770                  o-Prih      [p2]    @  F-Prih
     4771                  o-RAsh      [p2]    @  F-RAsh
     4772                  o-KAssa     [p2]    @  F-KAssa
     4773                  o-Inv       [p2]    @  F-Inv
     4774                  o-spis      [p2]    @  F-spis
     4775                  o-sm        [p2]    @  F-sm
     4776                  with FRAME ZAPAS .
     4777       if Make-Excel then  put   stream ForExcel unformatted p3 CHR(9)
     4778                   p4 CHR(9)
     4779                   p5 CHR(9)
     4780                   p6 CHR(9)
     4781                   gds-zap-type CHR(9)
     4782                   o-Prih[1]  CHR(9)
     4783   if Showcost       then (     excel-sum(o-Prih [2]) + CHR(9)   ) else ("")
     4784   if Show-cost-vat  then (     excel-sum  (   o-Prih [3]) + CHR(9)   ) else ("")
     4785   if Showsale       then (     excel-sum  (   o-Prih [5]) + CHR(9)   ) else ("")
     4786   if Show-sale-vat  then (     excel-sum  (   o-Prih [6]) + CHR(9)   ) else ("")
     4787                     o-RAsh         [1] FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4788   if Showcost       then (     excel-sum  (   o-RAsh[2] )  + CHR(9)   ) else ("")
     4789   if Show-cost-vat  then (     excel-sum  (   o-RAsh[3] )  + CHR(9)   ) else ("")
     4790   if Showsale       then (     excel-sum  (   o-RAsh[5] )  + CHR(9)   ) else ("")
     4791   if Show-sale-vat  then (     excel-sum  (   o-RAsh[6] )  + CHR(9)   ) else ("")
     4792                    o-KAssa        [1] FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4793   if Showcost       then (     excel-sum  (   o-KAssa[2])  + CHR(9)    ) else ("")
     4794   if Show-cost-vat  then (     excel-sum  (   o-KAssa[3])  + CHR(9)    ) else ("")
     4795   if Showsale       then (     excel-sum  (   o-KAssa[5])  + CHR(9)    ) else ("")
     4796   if Show-sale-vat  then (     excel-sum  (   o-KAssa[6])  + CHR(9)    ) else ("")
     4797   .
     4798   if Make-Excel then  put   stream ForExcel unformatted     o-Inv            [1] FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4799   if Showcost       then (     excel-sum  (   o-Inv [2] ) + CHR(9)    ) else ("")
     4800   if Show-cost-vat  then (     excel-sum  (   o-Inv [3] ) + CHR(9)    ) else ("")
     4801   if Showsale       then (     excel-sum  (   o-Inv [5] ) + CHR(9)    ) else ("")
     4802   if Show-sale-vat  then (     excel-sum  (   o-Inv [6] ) + CHR(9)    ) else ("")
     4803                    o-vzvr         [1] FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4804   if Showcost       then (     excel-sum  (   o-vzvr [2] ) + CHR(9)    ) else ("")
     4805   if Show-cost-vat  then (     excel-sum  (   o-vzvr [3] ) + CHR(9)    ) else ("")
     4806   if Showsale       then (     excel-sum  (   o-vzvr [5] ) + CHR(9)    ) else ("")
     4807   if Show-sale-vat  then (     excel-sum  (   o-vzvr [6] ) + CHR(9)    ) else ("")
     4808                   o-vzvr-post    [1] FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4809   if Showcost       then (     excel-sum  (   o-vzvr-post[2] ) + CHR(9)     ) else ("")
     4810   if Show-cost-vat  then (     excel-sum  (   o-vzvr-post[3] ) + CHR(9)     ) else ("")
     4811   if Showsale       then (     excel-sum  (   o-vzvr-post[5] ) + CHR(9)     ) else ("")
     4812   if Show-sale-vat  then (     excel-sum  (   o-vzvr-post[6] ) + CHR(9)     ) else ("")
     4813            chr(10).
     4814                End.
     4815      WHEN "B1":U  Then DO :
     4816                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym13
     4817                   p3 @ gds-zap-b-code
     4818                   p4 @ gds-zap-artic
     4819                   p5 @ gds-zap-gds-name
     4820                   p6 @ gds-zap-unit-base
     4821                   p1 @ gds-type
     4822                  b1-vzvr      [p2]    @  F-vzvr
     4823                  b1-vzvr-post [p2]    @  F-vzvr-post
     4824                  b1-Prih      [p2]    @  F-Prih
     4825                  b1-RAsh      [p2]    @  F-RAsh
     4826                  b1-KAssa     [p2]    @  F-KAssa
     4827                  b1-Inv       [p2]    @  F-Inv
     4828                  b1-spis      [p2]    @  F-spis
     4829                  b1-sm        [p2]    @  F-sm
     4830                  with FRAME ZAPAS .
     4831       if Make-Excel then  put   stream ForExcel unformatted p3 CHR(9)
     4832                   p4 CHR(9)
     4833                   p5 CHR(9)
     4834                   p6 CHR(9)
     4835                   gds-zap-type CHR(9)
     4836                   b1-Prih[1]  CHR(9)
     4837   if Showcost       then (     excel-sum(b1-Prih [2]) + CHR(9)   ) else ("")
     4838   if Show-cost-vat  then (     excel-sum  (   b1-Prih [3]) + CHR(9)   ) else ("")
     4839   if Showsale       then (     excel-sum  (   b1-Prih [5]) + CHR(9)   ) else ("")
     4840   if Show-sale-vat  then (     excel-sum  (   b1-Prih [6]) + CHR(9)   ) else ("")
     4841                     b1-RAsh         [1] FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
