     2931   procedure run3 :
     2932   CASE RetClassify :
     2933     when "no-classify":U  then   DO:
     2934          For each obj-list no-lock :
     2935            for each temp-t-post-stk-line : delete temp-t-post-stk-line. end.
     2936            if t#kol-rec-obj > 1 THEN run print-header (1, '(' + obj-list.obj-type + ' ' + trim(string(obj-list.obj-code)) + ') ' + obj-list.obj-name).
     2937             For each post-stk-line  no-lock where
     2938                                               post-stk-line.obj-type = obj-list.obj-type and
     2939                                               post-stk-line.obj-code = obj-list.obj-code and
     2940                                               post-stk-line.fact-order >= null-fact-order   and
     2941                                               post-stk-line.fact-order <= fact-order-2   and
     2942                                               post-stk-line.sum-type    = 'cost':U    and
     2943                                               post-stk-line.cat-id      = '##':U
     2944                                               and  can-find(first G#cli where  post-stk-line.prod-type = G#cli.obj-type and  post-stk-line.prod-code = G#cli.obj-code ) = TRUE
     2945                                               :
     2946                    find first  temp-t-post-stk-line where
     2947                      temp-t-post-stk-line.cli-type  = post-stk-line.cli-type  and
     2948                      temp-t-post-stk-line.cli-code  = post-stk-line.cli-code   and
     2949                      temp-t-post-stk-line.artic     = post-stk-line.artic     and
     2950                      temp-t-post-stk-line.prod-type = post-stk-line.prod-type and
     2951                      temp-t-post-stk-line.prod-code = post-stk-line.prod-code no-lock no-error .
     2952                      if not available  temp-t-post-stk-line then do:
     2953                         find first  ub.goods no-lock where
     2954                                               ub.goods.artic     = post-stk-line.artic     and
     2955                                               ub.goods.prod-type = post-stk-line.prod-type and
     2956                                               ub.goods.prod-code = post-stk-line.prod-code no-error .
     2957                         find first  prod-cli no-lock  where
     2958                                                   prod-cli.obj-type = post-stk-line.prod-type and
     2959                                                   prod-cli.obj-code = post-stk-line.prod-code
     2960                                                   no-error .
     2961                         find first  ub.clients  no-lock  where
     2962                                                   ub.clients.obj-type = post-stk-line.cli-type and
     2963                                                   ub.clients.obj-code = post-stk-line.cli-code no-error .
     2964                           run create-temp-t-post-stk-line .
     2965                    end.
     2966                    else do:
     2967                            assign
     2968                              temp-t-post-stk-line.fact-order = post-stk-line.fact-order  .
     2969                            .
     2970                    end.
     2971             end.
     2972             For each temp-t-post-stk-line no-lock   ,
     2973                    Last temp-post-stk-line  where
     2974                         temp-post-stk-line.fact-order <= fact-order-2   and
     2975                         temp-post-stk-line.cat-id     =  t#cat-id      and
