     4503                                                          temp-t-post-stk-line.cli-type,
     4504                                                          temp-t-post-stk-line.clients-obj-name,
     4505                                                          obj-list.obj-code,
     4506                                                          obj-list.obj-type ) .
     4507                                          run tmp-clear.
     4508                                       end.
     4509             end.
     4510          end.
     4511          for each tmp-cli-gds no-lock
     4512              break
     4513              by tmp-cli-gds.name
     4514              by (tmp-cli-gds.cli-type + string(tmp-cli-gds.cli-code)) :
     4515              if first-of(tmp-cli-gds.cli-type + string(tmp-cli-gds.cli-code)) then run tmp-clear.
     4516               run tmp-assign.
     4517              if last-of((tmp-cli-gds.cli-type + string(tmp-cli-gds.cli-code))) then do:
     4518                  run print-footer ( 3 ,tmp-cli-gds.name).
     4519              end.
     4520          end.
     4521   End procedure.
     4522   procedure Goods-start :
     4523   END PROCEDURE.
     4524   procedure Goods-end :
     4525   END PROCEDURE.
     4526   PROCEDURE display-line :
     4527     i = i + 1.
     4528   If Integer(10) = 0 Then Temp1  = 100  .
     4529                         Else Temp1 = Integer(10) .
     4530        IF ( i modulo Temp1 = 0 ) AND ( i >= Temp1 ) then
     4531            RUN waitfram-show( "Обработано строк : " + string( i )) .
     4532     run clear-item in this-procedure .
     4533       assign
     4534             gds-zap-gds-name   = temp-t-post-stk-line.gds-name
     4535             gds-zap-unit-base  = temp-t-post-stk-line.unit-base
     4536             gds-zap-prt-root   = temp-t-post-stk-line.prt-root
     4537             gds-zap-prod-type  = temp-t-post-stk-line.prod-type
     4538             gds-zap-prod-code  = temp-t-post-stk-line.prod-code
     4539             gds-zap-artic      = temp-t-post-stk-line.artic
     4540             gds-zap-grp-name   = temp-t-post-stk-line.Goods-grp-name
     4541             gds-zap-b-code     = temp-t-post-stk-line.gds-code
     4542             gds-zap-type       = temp-t-post-stk-line.gds-type
     4543             pos-cli-type       = temp-t-post-stk-line.Cli-type
     4544             pos-cli-code       = temp-t-post-stk-line.Cli-code
     4545             pos-cli-grp-name   = temp-t-post-stk-line.Clients-grp-name.
     4546        run ob-line  in this-procedure
     4547             (  temp-t-post-stk-line.gds-code,
     4548                temp-t-post-stk-line.obj-code    ,
     4549                temp-t-post-stk-line.obj-type    ,
     4550                temp-t-post-stk-line.cli-code    ,
     4551                temp-t-post-stk-line.cli-type    ,
     4552                temp-t-post-stk-line.artic       ,
     4553                temp-t-post-stk-line.prod-code   ,
     4554                temp-t-post-stk-line.prod-type   ,
     4555                Fact-order-1   ,
     4556                Fact-order-2   ,
     4557                t#sum-type     ,
     4558                t#cat-id       ,
     4559                ""             ,
     4560                yes) .
     4561      if Show-Sale or Show-Sale-vat Then  run ob-line  in this-procedure (
     4562                temp-t-post-stk-line.gds-code    ,
     4563                temp-t-post-stk-line.obj-code    ,
     4564                temp-t-post-stk-line.obj-type    ,
     4565                temp-t-post-stk-line.cli-code    ,
     4566                temp-t-post-stk-line.cli-type    ,
     4567                temp-t-post-stk-line.artic       ,
     4568                temp-t-post-stk-line.prod-code   ,
     4569                temp-t-post-stk-line.prod-type   ,
     4570                Fact-order-1   ,
     4571                Fact-order-2   ,
     4572                'sale':U    ,
     4573                '##':U ,
     4574                ""             ,
     4575                yes) .
     4576            run calc-sub-itog in this-procedure  ( 0 ).
     4577               if Show-Sale Then run calc-sub-itog in this-procedure ( 3 ).
     4578              IF NOT Sums-Only then DO:
     4579                 run display-str1 in this-procedure .
     4580              End.
     4581     END PROCEDURE.
     4582   PROCEDURE display-str1  :
     4583        run di-qnty ( "кол-во", 1, gds-zap-b-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     4584            if show-cost        then do: run di ( "учет."  , 2 , "","", "", "", "":u).  end.
     4585            if show-cost-vat    then do: run di ( "уч.НДС" , 3 , "","", "", "", "":u).  end.
     4586            if show-sale        then do: run di ( "док-т." , 5 , "","", "", "", "":u).  end.
     4587            if show-sale-vat    then do: run di ( "д. НДС" , 6 , "","", "", "", "":u).  end.
     4588   END PROCEDURE.
     4589   PROCEDURE Di :
     4590   def input parameter p1 as char no-undo.
     4591   def input parameter p2 as int no-undo.
     4592   def input parameter p3 as char no-undo.
     4593   def input parameter p4 as char no-undo.
     4594   def input parameter p5 as char no-undo.
     4595   def input parameter p6 as char no-undo.
     4596   def input parameter p7 as char no-undo.
     4597    CASE CAPS ( p7) :
     4598      WHEN "P":U  Then
     4599                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym13
     4600                   p3 @ gds-zap-b-code
     4601                   p4 @ gds-zap-artic
     4602                   p5 @ gds-zap-gds-name
     4603                   p6 @ gds-zap-unit-base
     4604                   p1 @ gds-type
     4605                  p-vzvr      [p2]    @  F-vzvr
     4606                  p-vzvr-post [p2]    @  F-vzvr-post
     4607                  p-Prih      [p2]    @  F-Prih
     4608                  p-RAsh      [p2]    @  F-RAsh
     4609                  p-KAssa     [p2]    @  F-KAssa
     4610                  p-Inv       [p2]    @  F-Inv
     4611                  p-spis      [p2]    @  F-spis
     4612                  p-sm        [p2]    @  F-sm
     4613                  with FRAME ZAPAS .
     4614      WHEN "O":U  Then
     4615                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym13
     4616                   p3 @ gds-zap-b-code
     4617                   p4 @ gds-zap-artic
     4618                   p5 @ gds-zap-gds-name
     4619                   p6 @ gds-zap-unit-base
     4620                   p1 @ gds-type
     4621                  o-vzvr      [p2]    @  F-vzvr
     4622                  o-vzvr-post [p2]    @  F-vzvr-post
     4623                  o-Prih      [p2]    @  F-Prih
