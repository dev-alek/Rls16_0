     5000   if Show-cost-vat  then (     excel-sum  (   Prih [3]) + CHR(9)   ) else ("")
     5001   if Showsale       then (     excel-sum  (   Prih [5]) + CHR(9)   ) else ("")
     5002   if Show-sale-vat  then (     excel-sum  (   Prih [6]) + CHR(9)   ) else ("")
