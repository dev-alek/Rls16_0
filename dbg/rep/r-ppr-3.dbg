     4967   if Show-cost-vat  then (     excel-sum  (   bi-vzvr [3] ) + CHR(9)    ) else ("")
     4968   if Showsale       then (     excel-sum  (   bi-vzvr [5] ) + CHR(9)    ) else ("")
     4969   if Show-sale-vat  then (     excel-sum  (   bi-vzvr [6] ) + CHR(9)    ) else ("")
     4970                   bi-vzvr-post    [1] FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
