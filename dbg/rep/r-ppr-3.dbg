     5031      End case.
     5032                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     5033    END PROCEDURE.
     5034   PROCEDURE Clear-item :
     5035   def var kk as int no-undo.
     5036    REPEAT kk = 1 to 9:
     5037    Assign
     5038       prih             [kk]  = 0
     5039       rash             [kk]  = 0
     5040       kassa            [kk]  = 0
     5041       Inv              [kk]  = 0
     5042       vzvr-post        [kk]  = 0
     5043       vzvr             [kk]  = 0
     5044       sm               [kk]  = 0
     5045       spis             [kk]  = 0 .
     5046          End.
     5047    END PROCEDURE.
     5048   PROCEDURE ob-line :
     5049   def input  parameter x-gds-code     like goods.gds-code     no-undo.
     5050   def input  parameter x-store-code   like ub.clients.obj-code     no-undo.
     5051   def input  parameter x-store-type   like ub.clients.obj-type     no-undo.
     5052   def input  parameter x-cli-code     like ub.clients.obj-code     no-undo.
     5053   def input  parameter x-cli-type     like ub.clients.obj-type     no-undo.
     5054   def INPUT  parameter x-artic        like post-ot-line.artic        no-undo.
     5055   def INPUT  parameter x-prod-code    like post-ot-line.prod-code    no-undo.
     5056   def INPUT  parameter x-prod-type    like post-ot-line.prod-type    no-undo.
     5057   def INPUT  parameter x-Fact-order-1   like post-ot-line.Fact-order   no-undo.
     5058   def INPUT  parameter x-Fact-order-2   like post-ot-line.Fact-order   no-undo.
     5059   def input  parameter x-sum-type       like post-ot-line.sum-type     no-undo.
     5060   def input  parameter x-cat-id         like post-ot-line.cat-id       no-undo.
     5061   def input  parameter x-ext-doc-type   like post-ot-line.ext-doc-type no-undo.
     5062   def input  parameter xTog-obj           as log no-undo .
     5063   def var  tt#          as   int                 no-undo .
     5064   def var tt-cost like  ub.gds-dtl.price-rubl no-undo .
     5065   def var tt-sale like  ub.gds-dtl.price-rubl no-undo .
     5066   define buffer a-supp         for ub.ot-supp-line .
     5067   define buffer buf_parts-attr for ub.parts-attr .
     5068    if x-sum-type = 'cost':U   then tt# = 0.
     5069    if x-sum-type = 'sale':U   then tt# = 3.
     5070    if x-sum-type = 'crsa':U   then tt# = 6.
     5071        FOR each post-ot-line where
     5072                 post-ot-line.artic        = x-artic
     5073           AND   post-ot-line.fact-order  <= x-fact-order-2  AND   post-ot-line.fact-order  >= x-fact-order-1
     5074           AND   post-ot-line.obj-code     = x-store-code
     5075           AND   post-ot-line.obj-type     = x-store-type
     5076           AND   post-ot-line.prod-code    = x-prod-code
     5077           AND   post-ot-line.prod-type    = x-prod-type
     5078           AND   post-ot-line.cli-code     = x-cli-code
     5079           AND   post-ot-line.cli-type     = x-cli-type
     5080           AND   post-ot-line.sum-type     = x-sum-type
     5081           AND   post-ot-line.cat-id       = x-cat-id
     5082           and   post-ot-line.ext-doc-type  =  'ie':U
     5083           no-lock :
     5084              ASSIGN prih[1 + tt#]   = prih[1 + tt#]   +  post-ot-line.fact-qnty
     5085                     prih[2 + tt#]   = prih[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     5086                     prih[3 + tt#]   = prih[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base  .
     5087                    .
     5088        End.
     5089        FOR each post-ot-line where
     5090                 post-ot-line.artic        = x-artic
     5091           AND   post-ot-line.fact-order  <= fact-order-4  AND   post-ot-line.fact-order  >= fact-order-3
     5092           AND   post-ot-line.obj-code     = x-store-code
     5093           AND   post-ot-line.obj-type     = x-store-type
     5094           AND   post-ot-line.prod-code    = x-prod-code
     5095           AND   post-ot-line.prod-type    = x-prod-type
     5096           AND   post-ot-line.cli-code     = x-cli-code
     5097           AND   post-ot-line.cli-type     = x-cli-type
     5098           AND   post-ot-line.sum-type     = x-sum-type
     5099           AND   post-ot-line.cat-id       = x-cat-id
     5100           and   post-ot-line.ext-doc-type <> 'ie':U
     5101           no-lock :
     5102           For each ub.parts no-lock where
     5103                      ub.parts.artic      =  post-ot-line.artic
     5104                 AND  ub.parts.prod-code  =  post-ot-line.prod-code
     5105                 AND  ub.parts.prod-type  =  post-ot-line.prod-type
     5106                 AND  ub.parts.supp-code  =  post-ot-line.cli-code
     5107                 AND  ub.parts.supp-type  =  post-ot-line.cli-type
     5108                 AND  ub.parts.obj-code   =  post-ot-line.obj-code
     5109                 AND  ub.parts.obj-type   =  post-ot-line.obj-type
     5110                 AND  ub.parts.out-code   =  post-ot-line.doc-code
     5111                 and  ub.parts.out-code   <>  ub.parts.in-code
     5112                 ,
     5113          first buf_parts-attr no-lock where
     5114                 buf_parts-attr.in-code   = ub.parts.in-code
     5115             and buf_parts-attr.gds-code  = x-gds-code
     5116             and buf_parts-attr.part-code = ub.parts.part-code        ,
     5117          first a-supp no-lock  where
     5118               a-supp.doc-code     = buf_parts-attr.income-in-code and
     5119               a-supp.artic        = x-artic        and
     5120               a-supp.fact-order  <= fact-order-2   AND
     5121               a-supp.fact-order  >= fact-order-1   and
     5122               a-supp.obj-code     = x-store-code   and
     5123               a-supp.obj-type     = x-store-type   and
     5124               a-supp.prod-code    = x-prod-code    and
     5125               a-supp.prod-type    = x-prod-type    and
     5126               a-supp.cli-code     = x-cli-code     and
     5127               a-supp.cli-type     = x-cli-type     and
     5128               a-supp.sum-type     = x-sum-type     and
     5129               a-supp.cat-id       = x-cat-id      and
     5130                (  a-supp.ext-doc-type = 'ie':U  or
     5131                   a-supp.ext-doc-type = 'vt':U        or
     5132                   a-supp.ext-doc-type = 'vp':U      )                 :
     5133                 if tt# = 0  then DO:  end.
     5134                 if tt# = 3  then DO:  end.
     5135                 if tt# = 6  then DO:  end.
     5136           CASE post-ot-line.ext-doc-type:
     5137                WHEN         're':U      THEN DO :
     5138              ASSIGN vzvr[1 + tt#]   = vzvr[1 + tt#]   +  ub.parts.fact-qnty
     5139                     vzvr[2 + tt#]   = vzvr[2 + tt#]   +  if tprintrubl then  ( ub.parts.fact-qnty / post-ot-line.fact-qnty) * post-ot-line.sum-rubl else   ( ub.parts.fact-qnty / post-ot-line.fact-qnty) * post-ot-line.sum-base
     5140                     vzvr[3 + tt#]   = vzvr[3 + tt#]   +  if tprintrubl then  ( ub.parts.fact-qnty / post-ot-line.fact-qnty) * post-ot-line.vat-rubl else   ( ub.parts.fact-qnty / post-ot-line.fact-qnty) * post-ot-line.vat-base  .
     5141                    End.
     5142                WHEN       'ep':U    Then DO:
     5143              ASSIGN vzvr-post[1 + tt#]   = vzvr-post[1 + tt#]   +  ub.parts.fact-qnty
     5144                     vzvr-post[2 + tt#]   = vzvr-post[2 + tt#]   +  if tprintrubl then  ( ub.parts.fact-qnty / post-ot-line.fact-qnty) * post-ot-line.sum-rubl else  ( ub.parts.fact-qnty / post-ot-line.fact-qnty) * post-ot-line.sum-base
     5145                     vzvr-post[3 + tt#]   = vzvr-post[3 + tt#]   +  if tprintrubl then  ( ub.parts.fact-qnty / post-ot-line.fact-qnty) * post-ot-line.vat-rubl else   ( ub.parts.fact-qnty / post-ot-line.fact-qnty) * post-ot-line.vat-base  .
     5146                     End.
     5147                WHEN       'ee':U       THEN  DO:
     5148              ASSIGN rash[1 + tt#]   = rash[1 + tt#]   +  ub.parts.fact-qnty
     5149                     rash[2 + tt#]   = rash[2 + tt#]   +  if tprintrubl then   ( ub.parts.fact-qnty / post-ot-line.fact-qnty) * post-ot-line.sum-rubl else  ( ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.sum-base
     5150                     rash[3 + tt#]   = rash[3 + tt#]   +  if tprintrubl then   ( ub.parts.fact-qnty / post-ot-line.fact-qnty) * post-ot-line.vat-rubl else  ( ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.vat-base  .
     5151                    End.
     5152                WHEN      'we':U       THEN  DO:
     5153              ASSIGN spis[1 + tt#]   = spis[1 + tt#]   +  ub.parts.fact-qnty
     5154                     spis[2 + tt#]   = spis[2 + tt#]   +  if tprintrubl then  ( ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.sum-rubl else  ( ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.sum-base
     5155                     spis[3 + tt#]   = spis[3 + tt#]   +  if tprintrubl then  ( ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.vat-rubl else  ( ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.vat-base  .
     5156                    End.
     5157                WHEN       'es':U  OR
     5158                WHEN       'rs':U THEN  DO:
     5159              ASSIGN kassa[1 + tt#]   = kassa[1 + tt#]   +  ub.parts.fact-qnty
     5160                     kassa[2 + tt#]   = kassa[2 + tt#]   +  if tprintrubl then  ( ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.sum-rubl else  ( ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.sum-base
     5161                     kassa[3 + tt#]   = kassa[3 + tt#]   +  if tprintrubl then  ( ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.vat-rubl else  ( ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.vat-base .
     5162                    End.
     5163                when       'vt':U              or
     5164                when       'vp':U         or
     5165                when       'ap':U   or
     5166                when       'mp':U then  do:
     5167              ASSIGN INV[1 + tt#]   = INV[1 + tt#]   +  ub.parts.fact-qnty
     5168                     inv[2 + tt#]   = inv[2 + tt#]   +  if tprintrubl then  ( ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.sum-rubl else  ( ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.sum-base
     5169                     Inv[3 + tt#]   = Inv[3 + tt#]   +  if tprintrubl then  ( ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.vat-rubl else  ( ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.vat-base  .
     5170                    End.
     5171             WHEN   'pc':U      THEN  DO:
     5172              ASSIGN sm[1 + tt#]   = sm[1 + tt#]   +  ub.parts.fact-qnty
     5173                     sm[2 + tt#]   = sm[2 + tt#]   +  if tprintrubl then  ( ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.sum-rubl else  ( ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.sum-base
     5174                     sm[3 + tt#]   = sm[3 + tt#]   +  if tprintrubl then  ( ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.vat-rubl else  ( ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.vat-base  .
     5175                end.
     5176             End CASE.
     5177        End.
     5178      End.
     5179   END PROCEDURE.
     5180   PROCEDURE Calc-Sub-itog :
     5181   def input parameter tt as int no-undo.
     5182   def var b as int init 0 no-undo.
     5183   repeat b = 1 to 3 :
     5184     Assign
     5185     B1-sm[b + TT]    = B1-sm[b + TT]    +  sm[b + TT]
     5186     B2-sm[b + TT]    = B2-sm[b + TT]    +  sm[b + TT]
     5187     Bi-sm[b + TT]    = Bi-sm[b + TT]    +  sm[b + TT]
     5188      p-sm[b + TT]    =  p-sm[b + TT]    +  sm[b + TT]
     5189      o-sm[b + TT]    =  o-sm[b + TT]    +  sm[b + TT]
     5190     B1-Prih[b + TT]    = B1-Prih[b + TT]    +  Prih[b + TT]
     5191     B2-Prih[b + TT]    = B2-Prih[b + TT]    +  Prih[b + TT]
     5192     Bi-Prih[b + TT]    = Bi-Prih[b + TT]    +  Prih[b + TT]
     5193     p-Prih[b + TT]     = p-Prih[b + TT]     +  Prih[b + TT]
     5194     o-Prih[b + TT]     = o-Prih[b + TT]     +  Prih[b + TT]
     5195     B1-RAsh[b + TT]    = B1-RAsh[b + TT]    +  RAsh[b + TT]
     5196     B2-RAsh[b + TT]    = B2-RAsh[b + TT]    +  RAsh[b + TT]
     5197     Bi-RAsh[b + TT]    = Bi-RAsh[b + TT]    +  RAsh[b + TT]
     5198     p-RAsh[b + TT]     = p-RAsh[b + TT]      +  RAsh[b + TT]
     5199     o-RAsh[b + TT]     = o-RAsh[b + TT]      +  RAsh[b + TT]
     5200     B1-KAssa[b + TT]    = B1-KAssa[b + TT]    +  KAssa[b + TT]
     5201     B2-kassa[b + TT]    = B2-kassa[b + TT]    +  kassa[b + TT]
     5202     Bi-kassa[b + TT]    = Bi-kassa[b + TT]     +  kassa[b + TT]
     5203     p-kassa[b + TT]     = p-kassa[b + TT]      +  kassa[b + TT]
     5204     o-kassa[b + TT]     = o-kassa[b + TT]      +  kassa[b + TT]
     5205     B1-Inv[b + TT]    = B1-Inv[b + TT]    +  Inv[b + TT]
     5206     B2-Inv[b + TT]    = B2-Inv[b + TT]    +  Inv[b + TT]
     5207     Bi-Inv[b + TT]    = Bi-Inv[b + TT]    +  Inv[b + TT]
     5208     p-Inv[b + TT]    = p-Inv[b + TT]    +  Inv[b + TT]
     5209     o-Inv[b + TT]    = o-Inv[b + TT]    +  Inv[b + TT]
     5210     B1-vzvr[b + TT]    = B1-vzvr[b + TT]    + vzvr[b + TT]
     5211     B2-vzvr[b + TT]    = B2-vzvr[b + TT]    + vzvr[b + TT]
     5212     Bi-vzvr[b + TT]    = Bi-vzvr[b + TT]    + vzvr[b + TT]
     5213     p-vzvr[b + TT]    = p-vzvr[b + TT]    + vzvr[b + TT]
     5214     o-vzvr[b + TT]    = o-vzvr[b + TT]    + vzvr[b + TT]
     5215     B1-vzvr-post[b + TT]    = B1-vzvr-post[b + TT]    + vzvr-post[b + TT]
     5216     B2-vzvr-post[b + TT]    = B2-vzvr-post[b + TT]    + vzvr-post[b + TT]
     5217     Bi-vzvr-post[b + TT]    = Bi-vzvr-post[b + TT]    + vzvr-post[b + TT]
     5218     p-vzvr-post[b + TT]    = p-vzvr-post[b + TT]    + vzvr-post[b + TT]
     5219     o-vzvr-post[b + TT]    = o-vzvr-post[b + TT]    + vzvr-post[b + TT]
     5220   .
     5221   End.
     5222   END PROCEDURE.
     5223   PROCEDURE U-LINE :
     5224   UNDERLINE stream OutStream  sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym13
     5225           gds-zap-b-code
     5226           gds-zap-artic
     5227           gds-zap-gds-name
     5228           gds-zap-unit-base
     5229           gds-type
     5230           F-Prih
     5231           F-Rash
     5232           F-KAssa
     5233           F-Inv
     5234           F-vzvr
     5235           F-vzvr-post
     5236           F-spis
     5237           F-sm
     5238           with FRAME ZAPAS .
     5239           DOWN stream   OutStream 1 with FRAME ZAPAS.
     5240           END PROCEDURE.
     5241   procedure Print-Footer :
     5242   define input parameter Nx as integer no-undo .
     5243   define input parameter Name as char no-undo .
     5244       if Nx = 1 Then DO:
     5245            run di-qnty  ( "кол-во", 1,"","Итого по : ",trim ( name),"","b1").
     5246            if show-cost then do :     run di  (  "учет." , 2, "","","","","b1" ).  end.
     5247            if show-cost-vat then do : run di  (  "уч.НДС", 3, "","","","","b1" ).  end.
     5248            if show-sale then do :     run di  (  "док-т.", 5, "","","","","b1" ).  end.
     5249            if show-sale-vat then do : run di  (  "д. НДС", 6, "","","","","b1" ).  end.
     5250            if not sums-only then run u-line.
     5251            run clear-itemb1-.
     5252            end.
     5253    if nx = 2 then do:
     5254            run di-qnty  ( "кол-во", 1,"","","Итого по : " + trim ( name),"","b2").
     5255            if show-cost then do :      run di  (  "учет." , 2, "","","","","b2" ).  end.
     5256            if show-cost-vat  then do : run di  (  "уч.НДС", 3, "","","","","b2" ).  end.
     5257            if show-sale then do :      run di  (  "док-т.", 5, "","","","","b2" ).  end.
     5258            if show-sale-vat  then do : run di  (  "д. НДС", 6, "","","","","b2" ).  end.
     5259            if not sums-only then run u-line.
     5260            run clear-itemb2-.
     5261           end.
     5262    if nx = 3 then do:
     5263            if not sums-only then run u-line.
     5264            run di-qnty  ( "кол-во", 1,"","Итого по пост-ку" , trim ( name),"","p").
     5265            if show-cost then do :      run di  (  "учет." , 2, "","","","","p" ).  end.
     5266            if show-cost-vat  then do : run di  (  "уч.НДС", 3, "","","","","p" ).  end.
     5267            if show-sale then do :      run di  (  "док-т.", 5, "","","","","p" ).  end.
     5268            if show-sale-vat  then do : run di  (  "д. НДС", 6, "","","","","p" ).  end.
     5269            if not sums-only then run u-line.
     5270            run clear-itemp-.
     5271             end.
     5272    if nx = 0 then do:
     5273            run di-qnty  ( "кол-во", 1,"","Итого  объект: " , trim ( name),"","o").
     5274            if show-cost then do :      run di  (  "учет." , 2, "","","","","o" ).  end.
     5275            if show-cost-vat  then do : run di  (  "уч.НДС", 3, "","","","","o" ).  end.
     5276            if show-sale then do :      run di  (  "док-т.", 5, "","","","","o" ).  end.
     5277            if show-sale-vat  then do : run di  (  "д. НДС", 6, "","","","","o" ).  end.
     5278            if not sums-only then run u-line.
     5279            run clear-itemo-.
     5280             end.
     5281    END PROCEDURE.
     5282   PROCEDURE Clear-itemb1- :
     5283   def var kk as int no-undo.
     5284    REPEAT kk = 1 to 9:
     5285    Assign
     5286      b1-prih             [kk]  = 0
     5287      b1-rash             [kk]  = 0
     5288      b1-kassa            [kk]  = 0
     5289      b1-Inv              [kk]  = 0
     5290      b1-vzvr             [kk]  = 0
     5291      b1-vzvr-post        [kk]  = 0
     5292      b1-sm        [kk]  = 0
     5293      .
     5294          End.
     5295    END PROCEDURE.
     5296   PROCEDURE Clear-itemb2- :
     5297   def var kk as int no-undo.
     5298    REPEAT kk = 1 to 9:
     5299    Assign
     5300      b2-prih             [kk]  = 0
     5301      b2-rash             [kk]  = 0
     5302      b2-kassa            [kk]  = 0
     5303      b2-Inv              [kk]  = 0
     5304      b2-vzvr             [kk]  = 0
     5305      b2-vzvr-post        [kk]  = 0
     5306      b2-sm        [kk]  = 0
     5307      .
     5308      End.
     5309    END PROCEDURE.
     5310   PROCEDURE Clear-itemp- :
     5311   def var kk as int no-undo.
     5312    REPEAT kk = 1 to 9:
     5313    Assign
     5314      p-prih             [kk]  = 0
     5315      p-rash             [kk]  = 0
     5316      p-kassa            [kk]  = 0
     5317      p-Inv              [kk]  = 0
     5318      p-vzvr             [kk]  = 0
     5319      p-vzvr-post        [kk]  = 0
     5320      p-sm               [kk]  = 0
     5321      .
     5322      End.
     5323    END PROCEDURE.
     5324   PROCEDURE Clear-itemo- :
     5325   def var kk as int no-undo.
     5326    REPEAT kk = 1 to 9:
     5327    Assign
     5328      o-prih             [kk]  = 0
     5329      o-rash             [kk]  = 0
     5330      o-kassa            [kk]  = 0
     5331      o-Inv              [kk]  = 0
     5332      o-vzvr             [kk]  = 0
     5333      o-vzvr-post        [kk]  = 0
     5334      o-sm        [kk]  = 0
     5335      .
     5336      End.
     5337    END PROCEDURE.
     5338   Procedure Tmp-create :
     5339   define input parameter p1   like ub.clients.obj-code  no-undo .
     5340   define input parameter p2   like ub.clients.obj-type  no-undo .
     5341   define input parameter Name like ub.clients.obj-name  no-undo .
     5342   define input parameter p3   like obj-list.obj-code no-undo .
     5343   define input parameter p4   like obj-list.obj-type no-undo .
     5344     Create tmp-cli-gds.
     5345    def var kk as int no-undo.
     5346    REPEAT kk = 1 to 9 :
     5347      Assign
     5348         tmp-cli-gds.p-prih[kk]           = p-prih[kk]
     5349         tmp-cli-gds.p-rash[kk]           = p-rash[kk]
     5350         tmp-cli-gds.p-kassa[kk]          = p-kassa[kk]
     5351         tmp-cli-gds.p-Inv[kk]            = p-Inv[kk]
     5352         tmp-cli-gds.p-spis[kk]           = p-spis[kk]
     5353         tmp-cli-gds.p-vzvr[kk]           = p-vzvr[kk]
     5354         tmp-cli-gds.p-vzvr-post[kk]      = p-vzvr-post[kk]
     5355         tmp-cli-gds.p-sm[kk]             = p-sm[kk]
     5356         .
     5357    end.
     5358         assign
     5359         tmp-cli-gds.cli-code         = p1
     5360         tmp-cli-gds.cli-type         = p2
     5361         tmp-cli-gds.Name             = Name
     5362         tmp-cli-gds.obj-code         = p3
     5363         tmp-cli-gds.obj-type         = p4
     5364         .
     5365    END PROCEDURE.
     5366   Procedure Tmp-clear :
     5367    def var kk as int no-undo.
     5368    REPEAT kk = 1 to 9 :
     5369    Assign
     5370        p-prih[kk]          = 0
     5371        p-rash[kk]          = 0
     5372        p-kassa[kk]         = 0
     5373        p-Inv[kk]           = 0
     5374        p-spis[kk]          = 0
     5375        p-vzvr[kk]          = 0
     5376        p-vzvr-post[kk]     = 0
     5377        p-sm[kk]     = 0
     5378       .
     5379       end.
     5380   END PROCEDURE.
     5381   Procedure Tmp-assign :
     5382    def var kk as int no-undo.
     5383    REPEAT kk = 1 to 9 :
     5384       Assign
     5385       p-prih[kk]           = p-prih[kk]            + tmp-cli-gds.p-prih[kk]
     5386       p-rash[kk]           = p-rash[kk]            + tmp-cli-gds.p-rash[kk]
     5387       p-kassa[kk]          = p-kassa[kk]           + tmp-cli-gds.p-kassa[kk]
     5388       p-Inv[kk]            = p-Inv[kk]             + tmp-cli-gds.p-Inv[kk]
     5389       p-spis[kk]           = p-spis[kk]            + tmp-cli-gds.p-spis[kk]
     5390       p-vzvr[kk]           = p-vzvr[kk]            + tmp-cli-gds.p-vzvr[kk]
     5391       p-vzvr-post[kk]      = p-vzvr-post[kk]       + tmp-cli-gds.p-vzvr-post[kk]
     5392       p-sm[kk]             = p-sm[kk]       + tmp-cli-gds.p-sm[kk]
     5393       .
     5394    end.
     5395   END PROCEDURE.
