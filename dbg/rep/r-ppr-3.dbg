     5015   if Showcost       then (     excel-sum  (   Inv [2] ) + CHR(9)    ) else ("")
     5016   if Show-cost-vat  then (     excel-sum  (   Inv [3] ) + CHR(9)    ) else ("")
     5017   if Showsale       then (     excel-sum  (   Inv [5] ) + CHR(9)    ) else ("")
     5018   if Show-sale-vat  then (     excel-sum  (   Inv [6] ) + CHR(9)    ) else ("")
     5019                    vzvr         [1] FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     5020   if Showcost       then (     excel-sum  (   vzvr [2] ) + CHR(9)    ) else ("")
     5021   if Show-cost-vat  then (     excel-sum  (   vzvr [3] ) + CHR(9)    ) else ("")
