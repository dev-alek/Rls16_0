     3564   procedure run45 :
     3565   CASE RetClassify :
     3566     when "no-classify":U  then   DO:
     3567          For each obj-list no-lock :
     3568            for each temp-t-post-stk-line : delete temp-t-post-stk-line. end.
     3569            if t#kol-rec-obj > 1 THEN run print-header (1, '(' + obj-list.obj-type + ' ' + trim(string(obj-list.obj-code)) + ') ' + obj-list.obj-name).
     3570             For each post-stk-line  no-lock where
     3571                                               post-stk-line.obj-type = obj-list.obj-type and
     3572                                               post-stk-line.obj-code = obj-list.obj-code and
     3573                                               post-stk-line.fact-order >= null-fact-order   and
     3574                                               post-stk-line.fact-order <= fact-order-2   and
     3575                                               post-stk-line.sum-type    = 'cost':U    and
     3576                                               post-stk-line.cat-id      = '##':U
     3577                                               ,
     3578                    each ub.goods no-lock where
     3579                                               ub.goods.artic     = post-stk-line.artic     and
     3580                                               ub.goods.prod-type = post-stk-line.prod-type and
