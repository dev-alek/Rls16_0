     4638                  b1-vzvr-post [p2]    @  F-vzvr-post
     4639                  b1-Prih      [p2]    @  F-Prih
     4640                  b1-RAsh      [p2]    @  F-RAsh
     4641                  b1-KAssa     [p2]    @  F-KAssa
     4642                  b1-Inv       [p2]    @  F-Inv
     4643                  b1-spis      [p2]    @  F-spis
     4644                  b1-sm        [p2]    @  F-sm
     4645                  with FRAME ZAPAS .
     4646      WHEN "B2":U  Then
     4647                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym13
     4648                   p3 @ gds-zap-b-code
     4649                   p4 @ gds-zap-artic
     4650                   p5 @ gds-zap-gds-name
     4651                   p6 @ gds-zap-unit-base
     4652                   p1 @ gds-type
     4653                  b2-vzvr      [p2]    @  F-vzvr
     4654                  b2-vzvr-post [p2]    @  F-vzvr-post
     4655                  b2-Prih      [p2]    @  F-Prih
     4656                  b2-RAsh      [p2]    @  F-RAsh
     4657                  b2-KAssa     [p2]    @  F-KAssa
     4658                  b2-Inv       [p2]    @  F-Inv
     4659                  b2-spis      [p2]    @  F-spis
     4660                  b2-sm        [p2]    @  F-sm
     4661                  with FRAME ZAPAS .
     4662      WHEN "BI":U Then
     4663                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym13
     4664                   p3 @ gds-zap-b-code
     4665                   p4 @ gds-zap-artic
     4666                   p5 @ gds-zap-gds-name
     4667                   p6 @ gds-zap-unit-base
