     5005   if Show-cost-vat  then (     excel-sum  (   RAsh[3] )  + CHR(9)   ) else ("")
     5006   if Showsale       then (     excel-sum  (   RAsh[5] )  + CHR(9)   ) else ("")
     5007   if Show-sale-vat  then (     excel-sum  (   RAsh[6] )  + CHR(9)   ) else ("")
