     4972   if Show-cost-vat  then (     excel-sum  (   bi-vzvr-post[3] ) + CHR(9)     ) else ("")
     4973   if Showsale       then (     excel-sum  (   bi-vzvr-post[5] ) + CHR(9)     ) else ("")
     4974   if Show-sale-vat  then (     excel-sum  (   bi-vzvr-post[6] ) + CHR(9)     ) else ("")
     4975            chr(10).
