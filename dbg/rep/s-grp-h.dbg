      989   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      990     (output var-report-r-b
      991     )  .
      992   define variable l-col-type         as character no-undo .
      993   define variable l-col-pos          as integer no-undo .
      994   define variable l-col-len          as integer no-undo .
      995   define variable l-col-format       as character no-undo .
      996   define variable l-col-lable        as character no-undo .
      997   define variable v-dec-sep          as character no-undo init ? .
      998   define variable v-th-sep           as character no-undo init ? .
      999   define variable v-r-col-num        as integer no-undo .
     1000   define variable v-reg-replace      as logical no-undo .
     1001   define variable v-date-col-format  as character no-undo .
     1002   DEFINE VARIABLE last-col-num as integer no-undo.
     1003   run gbl/getlocal.p (
     1004                     output v-dec-sep
     1005                    ,output v-th-sep
     1006                    ,output v-sdate
     1007                    ,output v-shortdate
     1008                    ) no-error .
     1009   assign
     1010   v-reg-replace = NOT (v-dec-sep = ".":U and v-th-sep = chr(44))
     1011                   AND (v-dec-sep <> ? and v-th-sep <> ?)
     1012   .
     1013     FUNCTION supress-null RETURNS CHARACTER ( INPUT p-string  AS CHARACTER,
     1014                                               INPUT p-dec-sep AS CHARACTER  ) :
     1015       DEFINE VARIABLE v-string AS CHARACTER NO-UNDO.
     1016       IF TRIM( p-string ) = "0"                    OR
     1017          TRIM( p-string ) = "0" + p-dec-sep + "00" OR
     1018          TRIM( p-string ) =       p-dec-sep + "00" OR
     1019          TRIM( p-string ) =       p-dec-sep + "0"  OR
     1020          TRIM( p-string ) = "0" + p-dec-sep + "0"  THEN DO: ASSIGN v-string = "":U.     END.
     1021                                                    ELSE DO: ASSIGN v-string = p-string. END.
     1022       RETURN ( TRIM( v-string ) ).
     1023     END FUNCTION.
     1024   FUNCTION reg-output returns character( input p-string as character
     1025                                         ,input p-private-data as character
     1026                                         ,input p-replace as logical
     1027                                         ,input p-supress as logical
     1028                                         ,input p-dec-sep as character
     1029                                         ,input p-th-sep as character
     1030                                         ):
     1031   DEFINE VARIABLE v-reg-output as character no-undo .
     1032   DEFINE VARIABLE v-data-type as character no-undo .
     1033   DEFINE VARIABLE v-progress-format as character no-undo .
     1034   assign
     1035   v-progress-format = entry(1, p-private-data, chr(4))
     1036   v-data-type = entry(2, p-private-data, chr(4))
     1037   .
     1038   if p-string = ? then return chr(63).
     1039   if (v-data-type = "INTEGER"
     1040       OR v-data-type = "DECIMAL" ) THEN DO:
     1041     IF p-replace THEN DO:
     1042       assign
     1043         v-reg-output = replace( p-string
     1044                                         ,chr(44)
     1045                                         ,"":U
     1046                                       )
     1047         v-reg-output = trim(v-reg-output)
     1048       .
     1049     END.
     1050     else do:
     1051       v-reg-output = p-string.
     1052     end.
     1053     IF p-supress THEN DO: ASSIGN v-reg-output = supress-null( TRIM( v-reg-output ), p-dec-sep ). END.
     1054     return v-reg-output.
     1055   end.
     1056     return p-string.
     1057   END FUNCTION.
     1058   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1059   DEFINE SHARED temp-table grp-h no-undo
