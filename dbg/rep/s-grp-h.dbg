     1078   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1079   DEFINE   temp-table full-grp no-undo
     1080       field obj-code like ub.clients.obj-code
     1081       field grp-code like ub.gds-grp.node-code
     1082       field full-name like ub.goods.grp-name
     1083       field other-code as integer
