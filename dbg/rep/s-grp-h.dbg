      454   procedure prn-lib-reportviewer :
      455     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      456     define input parameter p-report-name-html as character no-undo .
      457     define input parameter p-param        as character no-undo .
      458     define variable v-excel           as character no-undo init 'TRUE' .
      459     define variable v-value-character as character no-undo .
      460     define variable v-value-integer   as character no-undo .
      461     define variable v-value-date      as date      no-undo .
      462     define variable v-value-decimal   as decimal   no-undo .
      463     define variable rep-excel         as logical   no-undo .
      464     define variable excel-string      as character no-undo .
      465     define variable v-param-type      as character no-undo .
      466     define variable v-tth             as handle    no-undo .
      467     run adm/shattri.p (
      468       input "get":U
      469       ,input  ""
      470       ,input  0
      471       ,input  'report-glob':U
      472       ,input  'rep-excel':U
      473       ,output v-value-character
      474       ,output v-value-date
      475       ,output v-value-decimal
      476       ,output v-value-integer
      477       ,output rep-excel
      478       ,output v-param-type
      479       ,INPUT-OUTPUT table-handle v-tth
      480       )  .
      481     if rep-excel then v-excel = "TRUE" .
      482     else v-excel = "FALSE" .
      483     if p-param eq ""
      484     then
      485        p-param = "EXCEL:" + v-excel.
      486     else
      487        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      488     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      489   end procedure.
