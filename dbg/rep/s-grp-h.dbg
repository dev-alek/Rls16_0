      311   procedure prn-lib-prn-file :
      312     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      313     define input parameter p-DIsabledoptions as integer no-undo .
      314     define variable v-report-name as character no-undo .
      315     define variable v-user-action as character no-undo .
