     1088         .
     1089   define variable vss-include-info13 as character format "X(65)" no-undo
     1090   initial "@(#)$Workfile$ $Revision$".
     1091   procedure grplib-get-full-name :
     1092      define input parameter p-node-code  as integer      no-undo.
     1093      define output parameter p-full-name as character    no-undo.
     1094      do
     1095   on error undo, return error
     1096   :
     1097       define variable v-upper-code    as integer           no-undo.
     1098       define buffer buf_gds-grp       for ub.gds-grp.
     1099       define buffer buf_upper_gds-grp for ub.gds-grp.
     1100       find first buf_gds-grp no-lock
     1101            where buf_gds-grp.node-code = p-node-code
     1102       no-error.
     1103       if not available buf_gds-grp
     1104       then do:
     1105           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1106       end.
     1107       assign
     1108           p-full-name  = ""
     1109           v-upper-code = 1
     1110       .
     1111       do while buf_gds-grp.upper-code <> 0
     1112       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1113       :
     1114           assign
     1115               p-full-name  = buf_gds-grp.node-name
     1116                            + (if p-full-name <> "" then chr(47) else "")
     1117                            + p-full-name
     1118               v-upper-code = buf_gds-grp.upper-code
     1119           .
     1120           find first buf_gds-grp no-lock
     1121                where buf_gds-grp.node-code = v-upper-code
     1122           no-error.
     1123           if not available buf_gds-grp
     1124           then do:
     1125               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     1126                                   + string( v-upper-code )
     1127                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1128           end.
     1129       end.
     1130       assign
     1131       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1132       .
     1133   end.
     1134   end .
     1135   procedure grplib-get-node-from-full-name :
     1136   define input parameter p-full-name as character no-undo .
     1137   define output parameter p-node-code as integer no-undo .
     1138   define variable v-ii as integer no-undo .
     1139   define variable v-upper-code as integer no-undo .
     1140   define variable v-root-code as integer no-undo .
     1141   define variable v-entry as character no-undo .
     1142   define buffer buf_gds-grp       for ub.gds-grp.
     1143   do
     1144   on error undo, return error
     1145   :
     1146     find first buf_gds-grp no-lock
     1147         where buf_gds-grp.upper-code = 0
     1148     no-error .
     1149     if not available buf_gds-grp
     1150     then do:
     1151         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     1152     end.
     1153     else do:
     1154       assign
     1155       v-root-code = buf_gds-grp.node-code
     1156       .
     1157     end.
     1158     v-upper-code = v-root-code.
     1159     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1160       assign
     1161       v-entry = entry(v-ii, p-full-name, chr(47)).
     1162       if v-entry = '' then leave.
     1163       find first buf_gds-grp no-lock where
     1164                 buf_gds-grp.node-name = v-entry
     1165             and buf_gds-grp.upper-code = v-upper-code
     1166             no-error.
     1167       if not available buf_gds-grp then do:
     1168         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1169       end.
     1170       else do:
     1171         p-node-code = buf_gds-grp.node-code.
     1172         v-upper-code = buf_gds-grp.node-code.
     1173       end.
     1174     end.
     1175   end.
     1176   end .
     1177   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1178   define variable v-waitfram-action01         as character   no-undo .
     1179   define variable v-waitfram-action02         as character   no-undo .
     1180   define variable v-waitfram-action03         as character   no-undo .
     1181   define variable mWaitFramTextBeg            as character   no-undo.
     1182   define variable mWaitFramTextEnd            as character   no-undo.
     1183   define variable mWaitFramView               as logical     no-undo.
     1184   define variable mWaitProcEvent              as logical     no-undo init yes.
     1185   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1186   define variable mWaitFramStop               as logical     no-undo.
     1187   define variable mWaitFramStopUser           as logical     no-undo.
     1188   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1189   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1190   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1191   define button B-WaitFramStop auto-end-key
     1192        label "Стоп"
     1193        size 10 by 1 tooltip "Остоновить процесс".
     1194   define button B-viewProcInfo
     1195        label "Информация"
     1196        size 15 by 1 tooltip "Информация о процесс".
     1197   define frame waitfram
     1198     v-waitfram-action01 format "x(72)" no-label skip
     1199     v-waitfram-action02 format "x(72)" no-label skip
     1200     v-waitfram-action03 format "x(72)" no-label skip
     1201     B-viewProcInfo
     1202     B-WaitFramStop at row 4 col 30
     1203     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1204     .
     1205   define new global shared variable mBatchMode as logical no-undo init ?.
     1206   define variable mFramBachModHandle as handle no-undo.
     1207   mFramBachModHandle = frame waitfram:handle.
     1208   define variable mFameOldVis as logical no-undo.
     1209   define variable mVisCUrentVin as logical no-undo.
     1210   if session:batch-mode
     1211   then
     1212      mBatchMode = yes.
     1213   if mBatchMode = ? then do:
     1214     mVisCUrentVin = current-window:visible.
     1215     mFameOldVis = mFramBachModHandle:visible.
     1216     mFramBachModHandle:visible  = yes.
     1217     mBatchMode = mFramBachModHandle:visible ne yes.
     1218     mFramBachModHandle:visible = mFameOldVis.
     1219     current-window:visible = mVisCUrentVin.
     1220   end.
     1221    if  log-manager:logfile-name ne ?
     1222     then DO:
     1223         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1224         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1225         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1226     end.
     1227   on choose of B-WaitFramStop in frame waitfram
     1228   do:
     1229     mWaitFramStop = yes.
     1230     mWaitFramStopUser = yes.
     1231   end.
     1232   function waitfram-check-timeout returns logical():
     1233      define variable vtime as int64 no-undo.
     1234      if mWaitFramStopTimeOut
     1235      then
     1236         return yes.
     1237      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1238      if     mWaitFramTimeOut ne ?
     1239         and mWaitFramTimeOut ne 0
     1240         and mWaitFramTimeOut lt vtime
     1241      then do:
     1242         mWaitFramStopTimeOut = yes.
     1243      end.
     1244      return mWaitFramStopTimeOut.
     1245   end.
     1246   procedure waitfram-hide :
     1247     if not session:batch-mode
     1248     then do
     1249     on error undo, return error return-value
     1250     :
     1251       pause 0 before-hide .
     1252       if not mBatchMode then
     1253         hide frame waitfram .
     1254     if     not mWaitFramView
     1255        and mWaitProcEvent
     1256     then
     1257       process events .
     1258     end.
     1259   end procedure.
     1260   procedure waitfram-show :
     1261     define input  parameter p-message as character no-undo .
     1262     define variable v-left-margin as integer   no-undo .
     1263     if not session:batch-mode
     1264     then do
     1265     on error undo, return error return-value
     1266     :
     1267       if length(p-message) <= 70 then do:
     1268         assign
     1269           v-left-margin = integer((70 - length(p-message)) / 2)
     1270         .
     1271         assign
     1272           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1273         .
     1274         assign
     1275           v-waitfram-action01 = " "
     1276           v-waitfram-action02 = " "
     1277                                    + fill(" ", v-left-margin)
     1278                                    + p-message
     1279           v-waitfram-action03 = " "
     1280         .
     1281       end.
     1282       else do:
     1283         define variable vRindex1 as integer no-undo.
     1284         define variable vRindex2 as integer no-undo.
     1285         vRindex1 = r-index(p-message," ",70).
     1286         if vRindex1 = 0
     1287         then
     1288            vRindex1 = 70.
     1289         if length(p-message)  <= vRindex1 + 70 then do:
     1290           assign
     1291             v-waitfram-action01 = " "
     1292             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1293             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1294           .
     1295         end.
     1296         else do:
     1297           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1298           if vRindex2 <= vRindex1
     1299           then
     1300              vRindex2 = vRindex1 + 70.
     1301           assign
     1302             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1303             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1304             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1305           .
     1306         end.
     1307       end.
     1308       B-viewProcInfo:visible   in frame waitfram = no.
     1309       B-viewProcInfo:sensitive in frame waitfram = no.
     1310       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1311       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1312       if  (   mWaitFramView
     1313          or  mWaitProcEvent)
     1314          and not mBatchMode
     1315       then
     1316          display
     1317             v-waitfram-action01 skip
     1318             v-waitfram-action02 skip
     1319             v-waitfram-action03 skip
     1320          with frame waitfram .
     1321       if     mWaitFramView
     1322          then do:
     1323             if     mWaitFramInterval ne ?
     1324                and not mBatchMode
     1325             then
     1326                wait-for go of frame waitfram pause mWaitFramInterval.
     1327          end.
     1328          else
     1329             if     mWaitProcEvent
     1330                and not mBatchMode
     1331             then
     1332                process events .
     1333     end.
     1334   end procedure.
     1335      procedure waitfram-show-this:
     1336         define input  parameter iInterval as int64 no-undo.
     1337         define variable vtime as int64 no-undo.
     1338         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1339         mWaitFramInterval = iInterval.
     1340         run waitfram-show (substitute("&1&2 &3&4" ,
     1341                                       mWaitFramTextBeg ,
     1342                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1343                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1344                                       mWaitFramTextEnd
     1345                                      )
     1346                           ).
     1347      end.
     1348      procedure WaitFramRunPause:
     1349         define input  parameter iInterval as dec no-undo.
     1350         define variable vStart  as datetime-tz no-undo.
     1351         define variable vend    as datetime-tz no-undo.
     1352         define variable vint as int64 no-undo.
     1353         define variable vOk as logical no-undo.
     1354         vStart = now.
     1355         vend   = vStart.
     1356         publish "WaitFramPause" (iInterval,output vOk).
     1357         vend   =  now.
     1358         vint = vend - vStart.
     1359         vint = iInterval - vint / 1000.
     1360         if     not mWaitFramStop
     1361            and (   vint > 0
     1362                 or (    not vOk
     1363                     and iInterval eq ?
     1364                     )
     1365                 )
     1366         then
     1367            run waitfram-show-this (iInterval).
     1368         vend   =  now.
     1369         vint = vend - vStart.
     1370         vint = iInterval - vint / 1000.
     1371         if     not mWaitFramStop
     1372            and vint > 0
     1373         then do:
     1374            run gbl/pause.p (vint * 1000).
     1375         end.
     1376         if iInterval ne ?
     1377         then
     1378            publish "WaitFramStop".
     1379         waitfram-check-timeout().
     1380      end.
     1381      procedure WaitFramWaitFor:
     1382         define input  parameter iInterval as dec no-undo.
     1383         assign
     1384            mWaitFramStartProc   = now
     1385            mWaitFramStopUser    = no
     1386            mWaitFramStopTimeOut = no
     1387         .
     1388         block-wait:
     1389         do while not mWaitFramStop:
     1390            run WaitFramRunPause (iInterval).
     1391            if  waitfram-check-timeout()
     1392            then do:
     1393               leave block-wait.
     1394            end.
     1395         end.
     1396         run waitfram-hide.
     1397      end.
     1398   procedure waitfram-join :
     1399     define input  parameter p-line-1  as character no-undo .
     1400     define input  parameter p-line-2  as character no-undo .
     1401     define input  parameter p-line-3  as character no-undo .
     1402     define output parameter p-message as character no-undo .
     1403     do
     1404     on error undo, return error return-value
     1405     :
     1406       assign
     1407         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1408                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1409                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1410       .
     1411     end.
     1412   end procedure.
     1413   function waitfram-join-function returns character
     1414     (input p-line-1 as character
     1415     ,input p-line-2 as character
     1416     ,input p-line-3 as character
     1417     ).
     1418     define variable v-message as character no-undo .
     1419     run waitfram-join in this-procedure
     1420       (input  p-line-1
     1421       ,input  p-line-2
     1422       ,input  p-line-3
     1423       ,output v-message
     1424       ) .
     1425     return v-message .
     1426   end function .
