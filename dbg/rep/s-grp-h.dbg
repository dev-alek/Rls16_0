       80   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       81   procedure cur-time :
       82      define output parameter p-today as date      no-undo .
       83      define output parameter p-time  as integer   no-undo .
       84     do
       85     on error undo, return error
       86     :
       87       define variable v-date1 as date      no-undo .
       88       define variable v-date2 as date      no-undo .
       89       define variable v-time  as integer   no-undo .
       90       assign
       91         v-date1 = today
       92         v-time  = time
       93         v-date2 = today
       94       .
       95       if v-date1 <> v-date2
       96       then do:
       97         assign
       98           v-date1 = today
       99           v-time  = v-time
      100         .
      101       end.
      102       assign
      103         p-today = v-date1
      104         p-time  = v-time
      105       .
      106     end.
      107   end.
      108   function cur-time-date returns character
      109   :
      110     return string(today, '99/99/9999':U) .
      111   end.
      112   function cur-time-mjd returns decimal
      113   :
      114     define variable v-date as date      no-undo .
      115     define variable v-time as integer   no-undo .
      116     run cur-time in this-procedure
      117       (output v-date
      118       ,output v-time
      119       ) .
      120     return integer(v-date) - 2400002 + (v-time / 86400) .
      121   end.
      122   function cur-time-get-ending-index returns integer
      123   (input p-number as integer
      124   )
      125   :
      126     if p-number < 0
      127     or p-number = ?
      128     then do:
      129       return 1 .
      130     end.
      131     define variable v-rest as integer   no-undo .
      132     assign
      133       p-number = p-number modulo 100
      134     .
      135     if p-number < 20
      136     then do:
      137       assign
      138         v-rest = p-number
      139       .
      140     end.
      141     else do:
      142       assign
      143         v-rest = p-number modulo 10
      144       .
      145     end.
      146     case v-rest :
      147       when 1
      148       then do:
      149         return 2 .
      150       end.
      151       when 2 or
      152       when 3 or
      153       when 4
      154       then do:
      155         return 3 .
      156       end.
      157       otherwise do:
      158         return 1 .
      159       end.
      160     end case .
      161   end.
      162   procedure cur-time-mjd-to-date :
      163      define input  parameter i-mjd-diff as decimal no-undo.
      164      define output parameter o-Date     as date    no-undo.
      165      define output parameter o-Time     as integer no-undo.
      166      define variable v-day-number as integer   no-undo .
      167      if    i-mjd-diff < 0
      168         or i-mjd-diff = ?
      169      then do:
      170         return "?" .
      171      end.
      172      assign
      173         v-day-number = truncate(i-mjd-diff,0).
      174         o-Date = date(v-day-number + 2400002).
      175         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      176     .
      177   end.
      178   function cur-time-mjd-to-string returns character
      179   (input p-mjd-diff as decimal
      180   )
      181   :
      182     define variable v-day-number as integer   no-undo .
      183     define variable v-seconds    as integer   no-undo .
      184     define variable v-hour       as integer   no-undo .
      185     define variable v-min        as integer   no-undo .
      186     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      187     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      188     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      189     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      190     if p-mjd-diff < 0
      191     or p-mjd-diff = ?
      192     then do:
      193       return "?" .
      194     end.
      195     assign
      196       v-day-number = integer(truncate(p-mjd-diff,0))
      197       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      198     .
      199     if v-seconds > 86400
      200     then do:
      201       assign
      202         v-seconds = 86400 - 1
      203       .
      204     end.
      205     if v-seconds < 0
      206     then do:
      207       assign
      208         v-seconds = 0
      209       .
      210     end.
      211     assign
      212       v-hour = truncate(v-seconds / 3600, 0)
      213     .
      214     assign
      215       v-seconds = v-seconds modulo 3600
      216     .
      217     assign
      218       v-min = truncate(v-seconds / 60, 0)
      219     .
      220     assign
      221       v-seconds = v-seconds modulo 60
      222     .
      223     return
      224         (if v-day-number <> 0
      225           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      226           else ""
      227         )
      228       + (if v-day-number <> 0 or v-hour <> 0
      229           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      230           else ""
      231         )
      232       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      233           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      234           else ""
      235         )
      236       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      237       .
      238   end.
      239   function cur-time-string returns character
      240   :
      241     define variable v-date as date      no-undo .
      242     define variable v-time as integer   no-undo .
      243     run cur-time in this-procedure
      244       (output v-date
      245       ,output v-time
      246       ) .
      247     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      248   end.
      249   function cur-time-string-sec returns character
      250   :
      251     define variable v-date as date      no-undo .
      252     define variable v-time as integer   no-undo .
      253     run cur-time in this-procedure
      254       (output v-date
      255       ,output v-time
      256       ) .
      257     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      258   end.
      259   function cur-time-custom  returns character
      260   (input p-prefix as character
      261   ,input p-date-format as character
      262   ,input p-delimiter as character
      263   ,input p-time-format as character
      264   ,input p-suffix as character
      265   )
      266   :
      267     define variable v-date as date      no-undo .
      268     define variable v-time as integer   no-undo .
      269     run cur-time in this-procedure
      270       (output v-date
      271       ,output v-time
      272       ) .
      273     return
      274       p-prefix
      275       + string(v-date, p-date-format)
      276       + p-delimiter
      277       + string(v-time, p-time-format)
      278       + p-suffix
      279       .
      280   end.
      281   function cur-time-print  returns character
      282   :
      283     define variable v-date as date      no-undo .
      284     define variable v-time as integer   no-undo .
      285     run cur-time in this-procedure
      286       (output v-date
      287       ,output v-time
      288       ) .
      289     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      290   end.
      291   function cur-time-datetime returns datetime
      292   :
      293     define variable v-char as character no-undo .
      294     define variable v-datetime as datetime no-undo .
      295     v-char = cur-time-string().
      296     v-datetime = datetime(v-char).
      297     return  v-datetime.
      298   end.
      299   function cur-time-string-msec returns character
      300   :
      301     define variable v-date as datetime  no-undo .
      302     v-date = now.
      303     return string(v-date) .
      304   end.
