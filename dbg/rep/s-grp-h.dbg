      325   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      326   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      327     (input  v-report-name
      328     ,input  2
      329     ,output v-exist
      330     )  .
      331       if NOT v-exist then
      332       DO:
      333         Message
      334           "Нет заданий на печать ! "
      335           view-as alert-box .
      336         Return  .
      337       End.
      338       run gbl/prnfilen.w
      339         (input  ""
      340         ,input  p-DisabledOptions
      341         ,input  string(v-report-name )
      342         ,input  7
      343         ,output v-user-action
      344         ,output v-printed
      345         ) .
      346       if v-printed then
      347       do:
      348         return "YES" .
      349       end.
      350       else
      351       do:
      352         return "NO" .
      353       end.
      354     end.
      355   end procedure.
      356   procedure prn-lib-open-stream :
      357     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      358     define input parameter p-page-size    as integer no-undo .
      359     define input parameter p-is-stream    as logical no-undo .
      360     define input parameter p-append       as logical no-undo .
      361     define variable v-report-name as character no-undo .
      362     do
      363       on error undo, return error
      364       :
      365       run prn-lib-get-report-name  in this-procedure (
      366         input parParentProc
      367         ,output v-report-name
      368         ).
      369       if p-is-stream then
      370       do:
      371         if p-append then
      372         do:
      373           output stream PrnLibStream to value( v-report-name )
      374             page-size value(p-page-size) append .
      375         end.
      376         if not p-append then
      377         do:
      378           output stream PrnLibStream to value( v-report-name )
      379             page-size value(p-page-size) .
      380         end.
      381       end.
      382       if not p-is-stream then
      383       do:
      384         if p-append then
      385         do:
      386           output to value( v-report-name )
      387             page-size value(p-page-size) append .
      388         end.
      389         if not p-append then
      390         do:
      391           output to value( v-report-name )
      392             page-size value(p-page-size) .
      393         end.
      394       end.
      395     end.
      396   end procedure.
      397   procedure prn-lib-open-exp :
      398     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      399     define input parameter p-is-stream    as logical no-undo .
      400     define input parameter p-is-append    as logical no-undo .
      401     define output parameter p-ReportFileName as char init "report" no-undo.
      402     define output parameter p-process as logical no-undo .
      403     define variable glog as logical no-undo .
      404     do
      405       on error undo, return error
      406       :
      407       SYSTEM-DIALOG GET-FILE p-ReportFileName
      408         TITLE      "Укажите путь"
      409         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      410         ASK-OVERWRITE
      411         CREATE-TEST-FILE
      412         SAVE-AS
      413         USE-FILENAME
      414         DEFAULT-EXTENSION "txt"
      415         UPDATE glog
      416         .
      417       if not glog then  return.
      418       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      419       if p-is-stream then
      420       do:
      421         if p-is-append then
      422         do:
      423           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      424         end.
      425         else
      426         do:
      427           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      428         end.
      429       end.
      430       else
      431       do:
      432         if p-is-append then
      433         do:
      434           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      435         end.
      436         else
      437         do:
      438           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      439         end.
      440       end.
      441       p-process = yes.
      442     end.
      443   end procedure.
      444   procedure prn-lib-get-report-name :
      445     define input parameter parParentProc  as widget-handle no-undo.
      446     define output parameter p-report-name as character no-undo .
      447     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      448   end procedure.
      449   procedure prn-lib-reportviewer-report-name :
      450     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      451     define input parameter p-report-name-html as character no-undo .
