     1482   DEFINE VARIABLE t-1 AS CHARACTER INITIAL "||||"
     1483        VIEW-AS EDITOR
     1484        SIZE 1 BY 4 NO-UNDO.
     1485   CREATE WIDGET-POOL "My-pool" PERSISTENT no-error .
     1486   l-col-pos = 1.
     1487   DEFINE FRAME top-framet
     1488       t-1       AT ROW 1 COL 1 no-label
     1489       HEADER
     1490       cur-time-print() AT 5 format "x(35)"
     1491       string( "Страница" ) AT 45 PAGE-NUMBER( PrnLibStream ) AT 55 FORMAT ">>9" SKIP
     1492       with width 232 down stream-io use-text NO-BOX.
     1493   DEFINE FRAME top-frame
     1494       t-1       AT ROW 1 COL 1 no-label
     1495       HEADER
     1496       cur-time-print() AT 5 format "x(35)"
     1497       string( "Страница" ) AT 45 PAGE-NUMBER( PrnLibStream ) AT 55 FORMAT ">>9" SKIP
     1498       with width 232 down stream-io use-text NO-BOX NO-HIDE.
     1499   DEFINE FRAME TOTALS
     1500   with width 232 down stream-io use-text NO-BOX OVERLAY.
     1501   DEFINE FRAME Hour
     1502   with width 232 down stream-io use-text NO-BOX OVERLAY.
     1503   if method = "TOTALS":U then do:
     1504     l-col-pos = 1.
     1505     Assign l-col-type="CHARACTER" l-col-len=1  l-col-format="X(1)"             l-col-lable = ":".
     1506     define variable ed1t as handle no-undo.
     1507     define variable l-1t as handle no-undo.
     1508     define variable ll-1t as handle no-undo.
     1509     define variable c-sym1t as widget-handle no-undo.
     1510      if l-col-pos > 320 then l-col-pos = 320 .
     1511     if use-column[1] = true then DO:
     1512           CREATE EDITOR LL-1t IN WIDGET-POOL "My-pool"
     1513             ASSIGN
     1514               FRAME = FRAME top-Framet:HANDLE
     1515               ROW = 1
     1516               COLUMN = l-col-pos
     1517               screen-value = Fill("-", l-col-len)
     1518               WIDTH-CHARS = l-col-len
     1519               HEIGHT-CHARS = 3
     1520           .
     1521           CREATE EDITOR ed1t IN WIDGET-POOL "My-pool"
     1522             ASSIGN
     1523               FRAME = FRAME top-Framet:HANDLE
     1524               ROW = 2
     1525               COLUMN = l-col-pos
     1526               screen-value = l-col-lable
     1527               WIDTH-CHARS = l-col-len
     1528               HEIGHT-CHARS = 3
     1529           .
     1530           CREATE EDITOR L-1t IN WIDGET-POOL "My-pool"
     1531             ASSIGN
     1532               FRAME = FRAME top-Framet:HANDLE
     1533               ROW = 4
     1534               COLUMN = l-col-pos
     1535               screen-value = Fill("-", l-col-len)
     1536               WIDTH-CHARS = l-col-len
     1537               HEIGHT-CHARS = 3
     1538           .
     1539           CREATE FILL-IN C-sym1t IN WIDGET-POOL "My-pool"
     1540             ASSIGN
     1541               FRAME = FRAME TOTALS:HANDLE
     1542               DATA-TYPE = "CHARACTER"
     1543               FORMAT = "X(":U + string(l-col-len) + ")":U
     1544               PRIVATE-DATA =  l-col-format + chr(4) + l-col-type
     1545               ROW = 1
     1546               COLUMN = l-col-pos
     1547           .
     1548        assign
     1549        l-col-pos =  l-col-pos + l-col-len + 1
     1550        v-r-col-num = v-r-col-num + 1
     1551        .
