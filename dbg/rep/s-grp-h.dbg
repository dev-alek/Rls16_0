      563   procedure create_obj-list :
      564      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      565      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      566      do
      567      on error undo, return error return-value
      568      :
      569         define buffer cli-obj for ub.clients .
      570         define variable p-var as integer no-undo .
      571         define buffer buf_obj-list for obj-list .
      572         find last buf_obj-list  use-index pi no-error .
      573         if available buf_obj-list
      574         then
      575            p-var = buf_obj-list.obj-id + 1.
      576         else
      577            p-var = 1.
      578         find first cli-obj where
      579                   cli-obj.obj-type = p-obj-type
      580               and cli-obj.obj-code = p-obj-code
      581         no-lock no-error.
      582         if available cli-obj
      583         then do:
      584            create buf_obj-list.
      585            assign
      586               buf_obj-list.obj-id   = p-var
      587               buf_obj-list.obj-code = cli-obj.obj-code
      588               buf_obj-list.obj-type = cli-obj.obj-type
      589               buf_obj-list.obj-name = cli-obj.obj-name
      590               buf_obj-list.db-num   = cli-obj.db-num
      591            .
      592         end.
      593      end.
      594   end.
