     3093               PRIVATE-DATA =  l-col-format + chr(4) + l-col-type
     3094               ROW = 1
     3095               COLUMN = l-col-pos
     3096           .
     3097        assign
     3098        l-col-pos =  l-col-pos + l-col-len + 1
     3099        v-r-col-num = v-r-col-num + 1
     3100        .
     3101     end.
     3102     Assign l-col-type="DECIMAL"   l-col-len=14 l-col-format= "->>,>>>,>>9.99"  l-col-lable="Итого по строке".
     3103     define variable ed28 as handle no-undo.
     3104     define variable l-28 as handle no-undo.
     3105     define variable ll-28 as handle no-undo.
     3106     define variable c-tot-by-grp as widget-handle no-undo.
     3107      if l-col-pos > 320 then l-col-pos = 320 .
     3108     if use-column[28] = true then DO:
     3109           CREATE EDITOR LL-28 IN WIDGET-POOL "My-pool"
     3110             ASSIGN
     3111               FRAME = FRAME top-Frame:HANDLE
     3112               ROW = 1
     3113               COLUMN = l-col-pos
     3114               screen-value = Fill("-", l-col-len)
     3115               WIDTH-CHARS = l-col-len
     3116               HEIGHT-CHARS = 3
     3117           .
     3118           CREATE EDITOR ed28 IN WIDGET-POOL "My-pool"
     3119             ASSIGN
     3120               FRAME = FRAME top-Frame:HANDLE
     3121               ROW = 2
     3122               COLUMN = l-col-pos
     3123               screen-value = l-col-lable
     3124               WIDTH-CHARS = l-col-len
     3125               HEIGHT-CHARS = 3
     3126           .
     3127           CREATE EDITOR L-28 IN WIDGET-POOL "My-pool"
     3128             ASSIGN
     3129               FRAME = FRAME top-Frame:HANDLE
     3130               ROW = 4
     3131               COLUMN = l-col-pos
     3132               screen-value = Fill("-", l-col-len)
     3133               WIDTH-CHARS = l-col-len
     3134               HEIGHT-CHARS = 3
     3135           .
     3136           CREATE FILL-IN C-tot-by-grp IN WIDGET-POOL "My-pool"
     3137             ASSIGN
     3138               FRAME = FRAME hour:HANDLE
     3139               DATA-TYPE = "CHARACTER"
     3140               FORMAT = "X(":U + string(l-col-len) + ")":U
     3141               PRIVATE-DATA =  l-col-format + chr(4) + l-col-type
     3142               ROW = 1
     3143               COLUMN = l-col-pos
     3144           .
     3145        assign
     3146        l-col-pos =  l-col-pos + l-col-len + 1
     3147        v-r-col-num = v-r-col-num + 1
     3148        .
     3149     end.
     3150     Assign l-col-type="CHARACTER" l-col-len=1  l-col-format="X(1)"       l-col-lable=":".
     3151     define variable ed29 as handle no-undo.
     3152     define variable l-29 as handle no-undo.
     3153     define variable ll-29 as handle no-undo.
     3154     define variable c-sym3 as widget-handle no-undo.
     3155      if l-col-pos > 320 then l-col-pos = 320 .
     3156     if use-column[29] = true then DO:
     3157           CREATE EDITOR LL-29 IN WIDGET-POOL "My-pool"
     3158             ASSIGN
     3159               FRAME = FRAME top-Frame:HANDLE
     3160               ROW = 1
     3161               COLUMN = l-col-pos
     3162               screen-value = Fill("-", l-col-len)
     3163               WIDTH-CHARS = l-col-len
     3164               HEIGHT-CHARS = 3
     3165           .
     3166           CREATE EDITOR ed29 IN WIDGET-POOL "My-pool"
     3167             ASSIGN
     3168               FRAME = FRAME top-Frame:HANDLE
     3169               ROW = 2
     3170               COLUMN = l-col-pos
     3171               screen-value = l-col-lable
     3172               WIDTH-CHARS = l-col-len
     3173               HEIGHT-CHARS = 3
     3174           .
     3175           CREATE EDITOR L-29 IN WIDGET-POOL "My-pool"
     3176             ASSIGN
     3177               FRAME = FRAME top-Frame:HANDLE
     3178               ROW = 4
     3179               COLUMN = l-col-pos
     3180               screen-value = Fill("-", l-col-len)
     3181               WIDTH-CHARS = l-col-len
     3182               HEIGHT-CHARS = 3
     3183           .
     3184           CREATE FILL-IN C-sym3 IN WIDGET-POOL "My-pool"
     3185             ASSIGN
     3186               FRAME = FRAME hour:HANDLE
     3187               DATA-TYPE = "CHARACTER"
     3188               FORMAT = "X(":U + string(l-col-len) + ")":U
     3189               PRIVATE-DATA =  l-col-format + chr(4) + l-col-type
     3190               ROW = 1
     3191               COLUMN = l-col-pos
     3192           .
     3193        assign
     3194        l-col-pos =  l-col-pos + l-col-len + 1
     3195        v-r-col-num = v-r-col-num + 1
     3196        .
     3197     end.
     3198   end.
     3199   IF METHOD = "GOODS":U then WIth-goods = yes.
     3200   else with-goods = no.
     3201   Line = fill( "-" , 60 ) .
     3202   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3203   define buffer tot_full-grp for full-grp.
     3204   for each obj-list no-lock:
     3205     assign
     3206     accum-obj-list = accum-obj-list + 1.
     3207     if accum-obj-list > 1 then LEAVE.
     3208   end.
     3209   IF METHOD = "GOODS" then WIth-goods = yes.
     3210   else with-goods = no.
     3211   CASE method:
     3212     when "pay-desk":U then do:
     3213       for each ub.cash-desk no-lock :
     3214         if X-SelectObject = 'все':U then.
     3215         else do:
     3216           find first obj-list No-LOCK WHERE
     3217                     obj-list.obj-code = ub.cash-desk.obj-code AND
     3218                     obj-list.obj-type = 'маг':U No-ERROR.
     3219           if not available obj-list then next.
     3220         end.
     3221         create full-grp.
     3222         assign
     3223         full-grp.grp-code =   ub.cash-desk.cash-num
     3224         full-grp.other-code = ub.cash-desk.obj-code
     3225         full-grp.full-name = substitute("БД_&1_маг_&2_Касса_&3"
     3226                                                   ,  ub.cash-desk.db-num
     3227                                                   ,  ub.cash-desk.obj-code
     3228                                                   ,  ub.cash-desk.cash-num)
     3229         .
     3230       end.
     3231       create full-grp.
     3232       assign
     3233       full-grp.grp-code =   0
     3234       full-grp.other-code = 0
     3235       full-grp.full-name = '':U
     3236       .
     3237     end.
     3238     when "pays":U then do:
     3239       for each ub.cash-pay No-LOCK:
     3240         create full-grp.
     3241         assign
     3242         full-grp.obj-code = 0
     3243         full-grp.grp-code = ub.cash-pay.cdpay-code
     3244         full-grp.other-code = ub.cash-pay.curr-code
     3245         .
     3246         FIND FIRST ub.currency No-LOCK WHERE
     3247                   ub.currency.curr-code = ub.cash-pay.curr-code no-error.
     3248         full-grp.full-name = substitute("&1_Валюта_&2"
     3249                                         , ub.cash-pay.obj-name
     3250                                         ,(if available ub.currency
     3251                                           then ub.currency.curr-abbr
     3252                                           else string(cash-pay.curr-code))).
     3253       end.
     3254     end.
     3255     when "GOODS" or
     3256     when "GROUPS" then do:
     3257       run waitfram-show in this-procedure ("Строю дерево групп ...").
     3258       for each ub.gds-grp no-lock:
     3259         find first for-grp where
     3260                   for-grp.upper-code = ub.gds-grp.node-code No-LOCK No-ERROR.
     3261         if not avail for-grp then do:
     3262           create full-grp.
     3263           assign
     3264           full-grp.obj-code = 0
     3265           full-grp.grp-code = ub.gds-grp.node-code.
     3266           if tree then
     3267           run grplib-get-full-name in this-procedure(input ub.gds-grp.node-code, output full-grp.full-name).
     3268           else
     3269           full-grp.full-name = ub.gds-grp.node-name.
     3270           full-grp.full-name = replace(full-grp.full-name, " ", "_").
     3271         end.
     3272       end.
     3273       run waitfram-hide in this-procedure .
     3274     end.
     3275   end CASE.
     3276   if method <> "TOTALS":U and method <> "pays":U then do:
     3277     for each grp-h :
     3278       assign
     3279       grp-h.sum[1] = grp-h.sum[1] - grp-h.sum_disc[1]
     3280       grp-h.sum[2] = grp-h.sum[2] - grp-h.sum_disc[2]
     3281       grp-h.sum[3] = grp-h.sum[3] - grp-h.sum_disc[3]
     3282       grp-h.sum[4] = grp-h.sum[4] - grp-h.sum_disc[4]
     3283       grp-h.sum[5] = grp-h.sum[5] - grp-h.sum_disc[5]
     3284       grp-h.sum[6] = grp-h.sum[6] - grp-h.sum_disc[6]
     3285       grp-h.sum[7] = grp-h.sum[7] - grp-h.sum_disc[7]
     3286       grp-h.sum[8] = grp-h.sum[8] - grp-h.sum_disc[8]
     3287       grp-h.sum[9] = grp-h.sum[9] - grp-h.sum_disc[9]
     3288       grp-h.sum[10] = grp-h.sum[10] - grp-h.sum_disc[10]
     3289       grp-h.sum[11] = grp-h.sum[11] - grp-h.sum_disc[11]
     3290       grp-h.sum[12] = grp-h.sum[12] - grp-h.sum_disc[12]
     3291       grp-h.sum[13] = grp-h.sum[13] - grp-h.sum_disc[13]
     3292       grp-h.sum[14] = grp-h.sum[14] - grp-h.sum_disc[14]
     3293       grp-h.sum[15] = grp-h.sum[15] - grp-h.sum_disc[15]
     3294       grp-h.sum[16] = grp-h.sum[16] - grp-h.sum_disc[16]
     3295       grp-h.sum[17] = grp-h.sum[17] - grp-h.sum_disc[17]
     3296       grp-h.sum[18] = grp-h.sum[18] - grp-h.sum_disc[18]
     3297       grp-h.sum[19] = grp-h.sum[19] - grp-h.sum_disc[19]
     3298       grp-h.sum[20] = grp-h.sum[20] - grp-h.sum_disc[20]
     3299       grp-h.sum[21] = grp-h.sum[21] - grp-h.sum_disc[21]
     3300       grp-h.sum[22] = grp-h.sum[22] - grp-h.sum_disc[22]
     3301       grp-h.sum[23] = grp-h.sum[23] - grp-h.sum_disc[23]
     3302       grp-h.sum[24] = grp-h.sum[24] - grp-h.sum_disc[24]
     3303       .
     3304     end.
     3305   END.
     3306   for each gds-h:
     3307     assign
     3308     gds-h.sum[1] = gds-h.sum[1] - gds-h.sum_disc[1]
     3309     gds-h.sum[2] = gds-h.sum[2] - gds-h.sum_disc[2]
     3310     gds-h.sum[3] = gds-h.sum[3] - gds-h.sum_disc[3]
     3311     gds-h.sum[4] = gds-h.sum[4] - gds-h.sum_disc[4]
     3312     gds-h.sum[5] = gds-h.sum[5] - gds-h.sum_disc[5]
     3313     gds-h.sum[6] = gds-h.sum[6] - gds-h.sum_disc[6]
     3314     gds-h.sum[7] = gds-h.sum[7] - gds-h.sum_disc[7]
     3315     gds-h.sum[8] = gds-h.sum[8] - gds-h.sum_disc[8]
     3316     gds-h.sum[9] = gds-h.sum[9] - gds-h.sum_disc[9]
     3317     gds-h.sum[10] = gds-h.sum[10] - gds-h.sum_disc[10]
     3318     gds-h.sum[11] = gds-h.sum[11] - gds-h.sum_disc[11]
     3319     gds-h.sum[12] = gds-h.sum[12] - gds-h.sum_disc[12]
     3320     gds-h.sum[13] = gds-h.sum[13] - gds-h.sum_disc[13]
     3321     gds-h.sum[14] = gds-h.sum[14] - gds-h.sum_disc[14]
     3322     gds-h.sum[15] = gds-h.sum[15] - gds-h.sum_disc[15]
     3323     gds-h.sum[16] = gds-h.sum[16] - gds-h.sum_disc[16]
     3324     gds-h.sum[17] = gds-h.sum[17] - gds-h.sum_disc[17]
     3325     gds-h.sum[18] = gds-h.sum[18] - gds-h.sum_disc[18]
     3326     gds-h.sum[19] = gds-h.sum[19] - gds-h.sum_disc[19]
     3327     gds-h.sum[20] = gds-h.sum[20] - gds-h.sum_disc[20]
     3328     gds-h.sum[21] = gds-h.sum[21] - gds-h.sum_disc[21]
     3329     gds-h.sum[22] = gds-h.sum[22] - gds-h.sum_disc[22]
     3330     gds-h.sum[23] = gds-h.sum[23] - gds-h.sum_disc[23]
     3331     gds-h.sum[24] = gds-h.sum[24] - gds-h.sum_disc[24]
     3332     .
     3333   end.
     3334   if method = "TOTALS":U then do:
     3335     if nc > 15 then do:
     3336       run prn-lib-open-stream  in this-procedure (
     3337                                                   input parParentProc
     3338                                                   ,input 62
     3339                                                   ,input yes
     3340                                                   ,input no
     3341                                                   ).
     3342     end.
     3343     else do:
     3344       run prn-lib-open-stream  in this-procedure (
     3345                                                   input parParentProc
     3346                                                   ,input 43
     3347                                                   ,input yes
     3348                                                   ,input no
     3349                                                   ).
     3350     end.
     3351   END.
     3352   else do:
     3353     if nc > 15 then do:
     3354       run prn-lib-open-stream  in this-procedure (
     3355                                                   input parParentProc
     3356                                                   ,input 62
     3357                                                   ,input yes
     3358                                                   ,input no
     3359                                                   ).
     3360     end.
     3361     else do:
     3362       run prn-lib-open-stream  in this-procedure (
     3363                                                   input parParentProc
     3364                                                   ,input 43
     3365                                                   ,input yes
     3366                                                   ,input no
     3367                                                  ).
     3368     end.
     3369   END.
     3370   IF METHOD = "TOTALS":U THEN DO:
     3371     FORM with FRAME TOTALS .
     3372     FORM HEADER
     3373     Line format "X(60)" AT 1 SKIP
     3374     string( "Продолжение - на следующей странице" ) FORMAT "X(40)" AT 10 SKIP
     3375     with FRAME NBottomFramet width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     3376     VIEW stream PrnLibStream FRAME NBottomFramet .
     3377     PUT stream PrnLibStream
     3378     SPACE(10)
     3379     ("Почасовая статистика розничных продаж ( по СУММЕ ПРОДАЖ ) ЗА ПЕРИОД c " +
     3380     string( startdate, "99/99/9999" ) + " по " + string( enddate, "99/99/9999" ) + ".")      format "x(110)" SKIP(1).
     3381     if t-dis-card then do:
     3382       PUT stream PrnLibStream UNFORMATTED
     3383       SPACE(10)
     3384       "Только покупки по дисконтным картам" skip.
     3385       if rs-dis-card = 1 then do:
     3386         for each temp-dis-card-type No-LOCK:
     3387           PUT stream PrnLibStream UNFORMATTED
     3388           SPACE(10)
     3389           temp-dis-card-type.type
     3390           skip.
     3391         END.
     3392       end.
     3393     end.
     3394     PUT stream PrnLibStream UNFORMATTED
     3395     SPACE(10) SelectObject SKIP(0)
     3396     (if byobject then "С разбивкой по объектам" else '')  SKIP(1).
     3397     display STREAM PrnLibStream with frame top-Framet .
     3398     _cycle:
     3399     do cycle = 1 to 0 by -1:
     3400       if byobject and cycle = 0 and accum-obj-list = 1 then LEAVE _cycle.
     3401       _obj-list:
     3402       for each obj-list no-lock:
     3403         if not byobject and cycle = 1 then LEAVE _obj-list.
     3404         if cycle = 1 then v-obj-code = obj-list.obj-code.
     3405         if cycle = 0 then v-obj-code = 0.
     3406         assign
     3407         v-accum-sum      = 0
     3408         v-accum-sum_disc = 0
     3409         v-accum-num-chk  = 0
     3410         .
     3411         if cycle = 1 then do:
     3412           FIND FIRST ub.clients NO-LOCK WHERE
     3413                     ub.clients.obj-code = v-obj-code AND
     3414                     ub.clients.obj-type = 'маг':U NO-ERROR.
     3415           if available ub.clients then do:
     3416             v-obj-name = ub.clients.obj-name.
     3417           end.
     3418           else v-obj-name = string(v-obj-code).
     3419         end.
     3420         if byobject and cycle = 0 then do:
     3421           v-obj-name = "ПО ВСЕМ ОБЪЕКТАМ".
     3422         end.
     3423         if byobject then do:
     3424           PUT stream PrnLibStream UNFORMATTED
     3425           v-obj-name
     3426           skip.
     3427     if use-column[2]
     3428     then  C-hourst:screen-value = string(fill14).
     3429     if use-column[3]
     3430     then  C-sumt:screen-value = string(fill16).
     3431     if use-column[4]
     3432     then  C-sum_disct:screen-value = string(fill16).
     3433     if use-column[5]
     3434     then  C-sumst:screen-value = string(fill16).
     3435     if use-column[6]
     3436     then  C-num-chkt:screen-value = string(fill16).
     3437           DISPLAY stream  PrnLibStream with frame TOTALS.       DOWN 1 stream PrnLibStream with frame TOTALS.
     3438         end.
     3439         FOR EACH grp-h No-LOCK  where
     3440                 grp-h.obj-code = v-obj-code
     3441         BY grp-h.obj-code:
     3442           DO ii = 0 TO 23 :
     3443             if entry(ii + 1, checked-time-intervals) = "no" then next.
     3444             HOURS = string(ii, "99") + ".00-" + string(ii, "99") + ".59".
     3445     if use-column[2]
     3446     then  C-hourst:screen-value = string(hours, entry(1, c-hourst:private-data, chr(4))).
     3447     if use-column[3]
     3448     then  C-sumt:screen-value = string(grp-h.sum[ii + 1], entry(1, c-sumt:private-data, chr(4))).
     3449     if use-column[4]
     3450     then  C-sum_disct:screen-value = string(grp-h.sum_disc[ii + 1], entry(1, c-sum_disct:private-data, chr(4))).
     3451     if use-column[5]
     3452     then  C-sumst:screen-value = string(grp-h.sum[ii + 1] - grp-h.sum_disc[ii + 1], entry(1, c-sumst:private-data, chr(4))).
     3453     if use-column[6]
     3454     then  C-num-chkt:screen-value = string(grp-h.num-chk[ii + 1], entry(1, c-num-chkt:private-data, chr(4))).
     3455             DISPLAY stream  PrnLibStream with frame TOTALS.                                        DOWN 1 stream PrnLibStream with frame TOTALS.
     3456             assign
     3457             v-accum-sum = v-accum-sum + grp-h.sum[ii + 1]
     3458             v-accum-sum_disc = v-accum-sum_disc + grp-h.sum_disc[ii + 1]
     3459             v-accum-num-chk  = v-accum-num-chk + grp-h.num-chk[ii + 1]
     3460             .
     3461             IF ii = 23 then do:
     3462     if use-column[2]
     3463     then  C-hourst:screen-value = string(fill14).
     3464     if use-column[3]
     3465     then  C-sumt:screen-value = string(fill16).
     3466     if use-column[4]
     3467     then  C-sum_disct:screen-value = string(fill16).
     3468     if use-column[5]
     3469     then  C-sumst:screen-value = string(fill16).
     3470     if use-column[6]
     3471     then  C-num-chkt:screen-value = string(fill16).
     3472           DISPLAY stream  PrnLibStream with frame TOTALS.       DOWN 1 stream PrnLibStream with frame TOTALS.
     3473     if use-column[1]
     3474     then  C-sym1t:screen-value = string(sym1, entry(1, c-sym1t:private-data, chr(4))).
     3475     if use-column[2]
     3476     then  C-hourst:screen-value = string(substitute('ИТОГО &1', v-obj-name), entry(1, c-hourst:private-data, chr(4))).
     3477     if use-column[3]
     3478     then  C-sumt:screen-value = string(v-accum-sum, entry(1, c-sumt:private-data, chr(4))).
     3479     if use-column[4]
     3480     then  C-sum_disct:screen-value = string(v-accum-sum_disc, entry(1, c-sum_disct:private-data, chr(4))).
     3481     if use-column[5]
     3482     then  C-sumst:screen-value = string((v-accum-sum - v-accum-sum_disc), entry(1, c-sumst:private-data, chr(4))).
     3483     if use-column[6]
     3484     then  C-num-chkt:screen-value = string(v-accum-num-chk, entry(1, c-num-chkt:private-data, chr(4))).
     3485               DISPLAY stream  PrnLibStream with frame TOTALS.                                        DOWN 1 stream PrnLibStream with frame TOTALS.
     3486     if use-column[2]
     3487     then  C-hourst:screen-value = string(fill14).
     3488     if use-column[3]
     3489     then  C-sumt:screen-value = string(fill16).
     3490     if use-column[4]
     3491     then  C-sum_disct:screen-value = string(fill16).
     3492     if use-column[5]
     3493     then  C-sumst:screen-value = string(fill16).
     3494     if use-column[6]
     3495     then  C-num-chkt:screen-value = string(fill16).
     3496           DISPLAY stream  PrnLibStream with frame TOTALS.       DOWN 1 stream PrnLibStream with frame TOTALS.
     3497             end.
     3498           END.
     3499         END.
     3500         if cycle = 0 then LEAVE _obj-list.
     3501       end.
     3502     end.
     3503     HIDE STREAM PrnLibStream frame TOTALS .
     3504     HIDE STREAM PrnLibStream FRAME top-Framet .
     3505     HIDE stream PrnLibStream FRAME NBottomFramet .
     3506   END.
     3507   ELSE DO:
     3508     FORM with FRAME Hour .
     3509     FORM HEADER
     3510     Line format "X(60)" AT 1 SKIP
     3511     string( "Продолжение - на следующей странице" ) FORMAT "X(40)" AT 10 SKIP
     3512     with FRAME NBottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     3513     VIEW stream PrnLibStream FRAME NBottomFrame .
     3514     PUT stream PrnLibStream
     3515     SPACE(10)
     3516     ("Почасовая статистика розничных продаж ( по СУММЕ ПРОДАЖ ) ЗА ПЕРИОД c " +
     3517     string( startdate, "99/99/9999" ) + " по " + string( enddate, "99/99/9999" ) + ".")      format "x(110)" SKIP(1).
     3518     if t-dis-card then do:
     3519       PUT stream PrnLibStream UNFORMATTED
     3520       SPACE(10)
     3521       "Только покупки по дисконтным картам" skip.
     3522       if rs-dis-card = 1 then do:
     3523         for each temp-dis-card-type No-LOCK:
     3524           PUT stream PrnLibStream UNFORMATTED
     3525           SPACE(10)
     3526           temp-dis-card-type.type
     3527           skip.
     3528         END.
     3529       end.
     3530     end.
     3531     PUT stream PrnLibStream UNFORMATTED
     3532     SPACE(10) SelectObject SKIP(0)
     3533     (if byobject then "С разбивкой по объектам" else '')  SKIP(1).
     3534     VIEW stream PrnLibStream FRAME top-frame .
     3535     display STREAM PrnLibStream
     3536     with frame top-frame .
     3537     _cycle2:
