      778         end.
      779       end CASE.
      780     end.
      781   end procedure.
      782   procedure uf-get :
      783     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      784     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      785     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      786     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      787     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      788     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      789     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      790     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      791     do
      792     on error undo, return error
      793     :
      794       define buffer buf_usr-flt for ubflt.usr-flt .
      795       define variable v-use-List_     as logical   no-undo .
      796       define variable v-type-List_     as character no-undo .
      797       define variable v-format-List_   as character no-undo .
      798       define variable v-use-Naim      as logical   no-undo .
      799       define variable v-type-Naim      as character no-undo .
      800       define variable v-format-Naim    as character no-undo .
      801       define variable v-use-print-graft as logical   no-undo .
      802       define variable v-use-sort-gr     as logical   no-undo .
      803       define variable v-use-type-price  as logical   no-undo .
      804       define variable v-use-type-val    as logical   no-undo .
      805       define variable v-label          as character no-undo .
      806       define variable v-tooltip        as character no-undo .
      807       define variable v-user-can-edit  as logical   no-undo .
      808       define variable v-output-display as logical   no-undo .
      809       define variable v-other          as character no-undo .
      810       run uf-name in this-procedure
      811          (input  entry(1, p-code, chr(4))
      812         ,output v-use-List_
      813         ,output v-type-List_
      814         ,output v-format-List_
      815         ,output v-use-Naim
      816         ,output v-type-Naim
      817         ,output v-format-Naim
      818         ,output v-use-print-graft
      819         ,output v-use-sort-gr
      820         ,output v-use-type-price
      821         ,output v-use-type-val
      822         ,output v-label
      823         ,output v-tooltip
      824         ,output v-user-can-edit
      825         ,output v-output-display
      826         ,output v-other
      827         ) no-error .
      828       if error-status :error then do:
      829         undo, return error return-value .
      830       end.
      831       find first buf_usr-flt no-lock where
      832                  buf_usr-flt.Call-point     = p-code AND
      833                  buf_usr-flt.user-name       = p-user-name
      834         no-error .
      835       if avail buf_usr-flt then do:
      836         assign
      837         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
      838         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
      839         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
      840         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
      841         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
      842         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
      843         .
      844       end.
      845       else do:
      846         assign
      847         p-List_        = (if v-use-List_       then "":U                    else ?)
      848         p-Naim         = (if v-use-Naim        then "":U                    else ?)
      849         p-print-graft  = (if v-use-print-graft then no                      else ?)
      850         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
      851         p-type-price   = (if v-use-type-price  then no                      else ?)
      852         p-type-val     = (if v-use-List_       then no                      else ?)
      853         .
      854       end.
      855     end.
      856   end procedure.
      857   procedure uf-set :
      858     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      859     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      860     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      861     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      862     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      863     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      864     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      865     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      866     do
      867     on error undo, return error
      868     :
      869       define buffer buf_usr-flt for ubflt.usr-flt .
      870       define variable v-use-List_     as logical   no-undo .
      871       define variable v-type-List_     as character no-undo .
      872       define variable v-format-List_   as character no-undo .
      873       define variable v-use-Naim      as logical   no-undo .
      874       define variable v-type-Naim      as character no-undo .
      875       define variable v-format-Naim    as character no-undo .
      876       define variable v-use-print-graft as logical   no-undo .
      877       define variable v-use-sort-gr   as logical   no-undo .
      878       define variable v-use-type-price as logical   no-undo .
      879       define variable v-use-type-val  as logical   no-undo .
      880       define variable v-tooltip        as character no-undo .
      881       define variable v-label          as character no-undo .
      882       define variable v-user-can-edit  as logical   no-undo .
      883       define variable v-output-display as logical   no-undo .
      884       define variable v-other          as character no-undo .
      885       run uf-name in this-procedure
      886         (input  entry(1, p-code, chr(4))
      887         ,output v-use-List_
      888         ,output v-type-List_
      889         ,output v-format-List_
      890         ,output v-use-Naim
      891         ,output v-type-Naim
      892         ,output v-format-Naim
      893         ,output v-use-print-graft
      894         ,output v-use-sort-gr
      895         ,output v-use-type-price
      896         ,output v-use-type-val
      897         ,output v-label
      898         ,output v-tooltip
      899         ,output v-user-can-edit
      900         ,output v-output-display
      901         ,output v-other
      902         ) no-error .
      903       if error-status :error then do:
      904         undo, return error return-value .
      905       end.
      906       find first buf_usr-flt where
      907                  buf_usr-flt.Call-point     = p-code AND
      908                  buf_usr-flt.user-name       = p-user-name
      909         no-error .
      910       if not avail buf_usr-flt then do:
      911           create buf_usr-flt .
      912           assign
      913           buf_usr-flt.call-point = p-code
      914           buf_usr-flt.user-name  = p-user-name
      915           .
      916       end.
      917       if avail buf_usr-flt then do:
      918        assign
      919        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
      920        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
      921        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
      922        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
      923        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
      924        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
      925       .
      926       release buf_usr-flt.
      927       end.
      928       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
      929     end.
      930   end procedure.
      931   CREATE WIDGET-POOL.
      932   define variable v-wth-list         as character    no-undo.
      933   DEFINE BUTTON bt-wth
      934        IMAGE-UP FILE "btn-down-arrow":U
      935        IMAGE-DOWN FILE "btn-down-arrow":U
      936        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      937        LABEL "&Изменить"
      938        SIZE 3 BY 1.
      939   DEFINE VARIABLE ed-wth AS CHARACTER
      940        VIEW-AS EDITOR NO-WORD-WRAP SCROLLBAR-HORIZONTAL SCROLLBAR-VERTICAL
      941        SIZE 51.5 BY 13
      942        FGCOLOR 4  NO-UNDO.
      943   DEFINE VARIABLE rs-wth AS INTEGER
      944        VIEW-AS RADIO-SET VERTICAL
      945        RADIO-BUTTONS
      946             "Все", 1,
      947   "Выборочно", 2
      948        SIZE 12 BY 2 NO-UNDO.
      949   DEFINE RECTANGLE RECT-7
      950        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      951        SIZE 71.38 BY 16.25.
      952   DEFINE VARIABLE v-free-zone AS LOGICAL INITIAL no
      953        LABEL "Свободные"
      954        VIEW-AS TOGGLE-BOX
      955        SIZE 13 BY .83 NO-UNDO.
      956   DEFINE VARIABLE v-put-zone AS LOGICAL INITIAL no
      957        LABEL "Погашенные"
      958        VIEW-AS TOGGLE-BOX
      959        SIZE 14 BY .83 NO-UNDO.
      960   DEFINE FRAME F-Main
      961        v-free-zone AT ROW 2 COL 4 WIDGET-ID 38
      962        v-put-zone AT ROW 3 COL 4 WIDGET-ID 40
      963        ed-wth AT ROW 4 COL 20.5 NO-LABEL WIDGET-ID 28
      964        rs-wth AT ROW 4.79 COL 4 NO-LABEL WIDGET-ID 34
      965        bt-wth AT ROW 5.79 COL 16 WIDGET-ID 18
      966        "Номиналы:" VIEW-AS TEXT
      967             SIZE 15 BY .67 AT ROW 4.04 COL 4
      968             FGCOLOR 4
      969        RECT-7 AT ROW 1.25 COL 2
      970       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      971            SIDE-LABELS NO-UNDERLINE THREE-D
      972            AT COL 1 ROW 1 SCROLLABLE
      973            BGCOLOR 8 .
      974   IF NOT THIS-PROCEDURE:PERSISTENT THEN DO:
      975     MESSAGE "c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\rep\e-wthrst.w should only be RUN PERSISTENT.":U
      976             VIEW-AS ALERT-BOX ERROR BUTTONS OK.
      977     RETURN.
      978   END.
      979   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      980   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      981   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      982   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      983   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      984   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      985   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      986   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      987         adm-object-hdl = FRAME F-Main:HANDLE.
      988   RUN ensure-broker.
      989   THIS-PROCEDURE:ADM-DATA =
      990        'ADM1.1~`':U +
      991        'SmartViewer~`':U +
      992        '~`':U +
      993        'NO ~`':U +
      994        '~`':U +
      995        '~`':U +
      996        '~`':U +
      997        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      998           + "~`":U +
      999        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
     1000        'Record-Source,Record-Target,TableIO-Target~`':U +
     1001        '~`':U +
     1002        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1003        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1004            THEN "^^":U
     1005        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1006             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1007   PROCEDURE adm-apply-entry :
     1008     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1009   END PROCEDURE.
     1010   PROCEDURE adm-destroy :
     1011    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1012   END PROCEDURE.
     1013   PROCEDURE adm-disable :
     1014       DISABLE RECT-7 v-free-zone v-put-zone ed-wth rs-wth bt-wth WITH FRAME F-Main.
     1015       RUN dispatch ('disable-fields':U).
     1016       RUN set-attribute-list ('ENABLED=no':U).
     1017       RETURN.
     1018   END PROCEDURE.
     1019   PROCEDURE adm-edit-attribute-list :
     1020         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
     1021         RETURN.
     1022   END PROCEDURE.
     1023   PROCEDURE adm-enable :
     1024       ENABLE UNLESS-HIDDEN RECT-7 v-free-zone v-put-zone ed-wth rs-wth bt-wth WITH FRAME F-Main.
     1025       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1026       RUN set-attribute-list ('ENABLED=yes':U).
     1027       RETURN.
     1028   END PROCEDURE.
     1029   PROCEDURE adm-exit :
     1030        RUN notify ('exit':U).
     1031     RETURN.
     1032   END PROCEDURE.
     1033   PROCEDURE adm-hide :
     1034     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1035   END PROCEDURE.
     1036   PROCEDURE adm-initialize :
     1037     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1038   END PROCEDURE.
     1039   PROCEDURE adm-show-errors :
     1040       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1041       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1042           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1043       END.
     1044       RETURN.
     1045   END PROCEDURE.
     1046   PROCEDURE adm-UIB-mode :
     1047     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1048   END PROCEDURE.
     1049   PROCEDURE adm-view :
     1050     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1051   END PROCEDURE.
     1052   PROCEDURE dispatch :
     1053       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1054       RUN broker-dispatch IN adm-broker-hdl
     1055           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1056       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1057   END PROCEDURE.
     1058   PROCEDURE ensure-broker :
     1059   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1060   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1061   DO:
     1062       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1063       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1064   END.
     1065   END PROCEDURE.
     1066   PROCEDURE get-attribute :
     1067     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1068     RUN broker-get-attribute IN adm-broker-hdl
     1069         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1070     RETURN RETURN-VALUE.
     1071   END PROCEDURE.
     1072   PROCEDURE get-attribute-list :
     1073     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1074     RUN broker-get-attribute-list IN adm-broker-hdl
     1075         (INPUT THIS-PROCEDURE,
     1076          INPUT ?,
     1077          OUTPUT p-attr-list) NO-ERROR.
     1078     RETURN.
     1079   END PROCEDURE.
     1080   PROCEDURE new-state :
     1081     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1082     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1083     RETURN.
     1084   END PROCEDURE.
     1085   PROCEDURE notify :
     1086     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1087     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1088     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1089         RETURN "ADM-ERROR":U.
     1090     RETURN.
     1091   END PROCEDURE.
     1092   PROCEDURE set-attribute-list :
     1093     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1094     RUN ensure-broker.
     1095     RUN broker-set-attribute-list IN adm-broker-hdl
     1096         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1097     RETURN.
     1098   END PROCEDURE.
     1099   PROCEDURE set-position :
     1100       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1101       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1102       IF VALID-HANDLE(adm-object-hdl) THEN
     1103       DO:
     1104         ASSIGN adm-object-hdl:ROW    =   p-row
     1105                adm-object-hdl:COLUMN =   p-col.
     1106       END.
     1107       RETURN.
     1108   END PROCEDURE.
     1109   PROCEDURE adm-display-fields :
     1110       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1111       RETURN.
     1112   END PROCEDURE.
     1113   PROCEDURE adm-open-query :
     1114     RETURN.
     1115   END PROCEDURE.
     1116   PROCEDURE adm-row-changed :
     1117         IF VALID-HANDLE(adm-object-hdl) THEN
     1118           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1119         RUN notify ('row-available':U).
     1120         RETURN.
     1121   END PROCEDURE.
     1122   PROCEDURE reposition-query :
     1123       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1124       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1125       RETURN.
     1126   END PROCEDURE.
     1127     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1128     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1129     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1130     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1131     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1132     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1133     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1134     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1135     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1136     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1137     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1138     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1139     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1140     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1141     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1142     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1143     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1144     IF "":U = "":U THEN
     1145       RUN modify-list-attribute IN adm-broker-hdl
     1146         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1147     RUN use-create-on-add(?).
     1148   PROCEDURE adm-add-record :
     1149       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1150          "must have at least one Enabled Table to perform Add.":U
     1151          VIEW-AS ALERT-BOX ERROR.
     1152       RETURN.
     1153   END PROCEDURE.
     1154   PROCEDURE adm-assign-record :
     1155    MESSAGE
     1156          "Object ":U THIS-PROCEDURE:FILE-NAME
     1157            "must have at least one Enabled Table to perform Assign.":U
     1158              VIEW-AS ALERT-BOX ERROR.
     1159      RETURN.
     1160     END PROCEDURE.
     1161   PROCEDURE adm-assign-statement :
     1162     RETURN.
     1163   END PROCEDURE.
     1164   PROCEDURE adm-cancel-record :
     1165      RETURN.
     1166     END PROCEDURE.
     1167   PROCEDURE adm-copy-record :
     1168       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1169        "must have at least one Enabled Table to perform Copy.":U
     1170          VIEW-AS ALERT-BOX ERROR.
     1171       RETURN.
     1172   END PROCEDURE.
     1173   PROCEDURE adm-create-record :
     1174      RETURN.
     1175   END PROCEDURE.
     1176   PROCEDURE adm-current-changed :
     1177     RETURN.
     1178   END PROCEDURE.
     1179   PROCEDURE adm-delete-record :
     1180    MESSAGE
     1181          "Object ":U THIS-PROCEDURE:FILE-NAME
     1182            "must have at least one Enabled Table to perform Delete.":U
     1183              VIEW-AS ALERT-BOX ERROR.
     1184       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1185       RETURN.
     1186   END PROCEDURE.
     1187   PROCEDURE adm-disable-fields :
     1188         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1189       RETURN.
     1190   END PROCEDURE.
     1191   PROCEDURE adm-enable-fields :
     1192       RETURN.
     1193   END PROCEDURE.
     1194   PROCEDURE adm-end-update :
     1195     RETURN.
     1196   END PROCEDURE.
     1197   PROCEDURE adm-reset-record :
     1198       RETURN.
     1199   END PROCEDURE.
     1200   PROCEDURE adm-update-record :
     1201       MESSAGE
     1202         "Object ":U THIS-PROCEDURE:FILE-NAME
     1203           "must have at least one Enabled Table to perform Update.":U
     1204             VIEW-AS ALERT-BOX ERROR.
     1205      RETURN.
     1206   END PROCEDURE.
     1207   PROCEDURE check-modified :
     1208   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1209   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1210   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1211   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1212     IF check-state = "check":U THEN
     1213     DO:
     1214       RUN get-link-handle IN adm-broker-hdl
     1215         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1216            OUTPUT group-target-list).
     1217       IF group-target-list NE "":U THEN
     1218       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1219         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1220         RUN check-modified IN curr-widget ('group-check':U).
     1221         IF RETURN-VALUE NE "":U THEN
     1222         DO:
     1223           RUN check-modified-message(RETURN-VALUE).
     1224           RETURN "":U.
     1225         END.
     1226       END.
     1227     END.
     1228     RETURN "":U.
     1229   END PROCEDURE.
     1230   PROCEDURE check-modified-message :
     1231     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1232        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1233           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1234        IF RETURN-VALUE = "YES":U THEN
     1235           RUN notify ('view,CONTAINER-SOURCE':U).
     1236        MESSAGE IF p-changed-table NE ? THEN
     1237           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1238           ELSE "Current values have been changed."
     1239           SKIP "  Do you wish to save those changes?"
     1240           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1241        IF ANS THEN
     1242        DO:
     1243           IF group-assign-target THEN
     1244             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1245           ELSE RUN dispatch('update-record':U).
     1246           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1247           DO:
     1248               MESSAGE "Changes to the previous record were not saved."
     1249                 VIEW-AS ALERT-BOX ERROR.
     1250               IF group-assign-target THEN
     1251                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1252               ELSE RUN dispatch ('cancel-record':U).
     1253           END.
     1254        END.
     1255        ELSE DO:
     1256          IF group-assign-target THEN
     1257             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1258          ELSE RUN dispatch('cancel-record':U).
     1259        END.
     1260        RETURN.
     1261   END PROCEDURE.
     1262   PROCEDURE get-rowid :
     1263       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1264       ASSIGN
     1265       p-table   =   adm-first-table.
     1266       RETURN.
     1267   END PROCEDURE.
     1268   PROCEDURE init-group-assign :
     1269       RUN request-attribute IN adm-broker-hdl
     1270         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1271       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1272         group-assign-target = yes.
     1273       ELSE group-assign-target = no.
     1274       RETURN.
     1275   END PROCEDURE.
     1276   PROCEDURE set-editors :
     1277       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1278       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1279       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1280       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1281       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1282       DO WHILE VALID-HANDLE (curr-widget):
     1283           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1284              curr-widget:HIDDEN = no THEN DO:
     1285             CASE p-field-setting:
     1286               WHEN "INITIALIZE":U THEN
     1287               DO:
     1288                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1289                     read-only-list +
     1290                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1291                        STRING(curr-widget).
     1292               END.
     1293               WHEN "DISABLE":U OR
     1294               WHEN "ENABLE":U THEN
     1295               DO:
     1296                   curr-widget:SENSITIVE = yes.
     1297                   RUN get-attribute ('Read-Only-Editors':U).
     1298                   IF RETURN-VALUE = ? OR
     1299                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1300                       curr-widget:READ-ONLY =
     1301                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1302               END.
     1303               WHEN "CLEAR":U THEN
     1304                   curr-widget:SCREEN-VALUE = "":U.
     1305             END CASE.
     1306           END.
     1307           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1308       END.
     1309       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1310         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1311           + '"':U).
     1312       RETURN.
     1313   END PROCEDURE.
     1314   PROCEDURE use-check-modified-all :
     1315    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1316     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1317     RETURN.
     1318   END PROCEDURE.
     1319   PROCEDURE use-create-on-add :
     1320   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1321      RETURN.
     1322   END PROCEDURE.
     1323   PROCEDURE use-initial-lock :
     1324     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1325     ASSIGN adm-initial-lock = p-attr-value.
     1326     RETURN.
     1327   END PROCEDURE.
     1328     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1329   ASSIGN
     1330          FRAME F-Main:SCROLLABLE       = FALSE
     1331          FRAME F-Main:HIDDEN           = TRUE.
     1332   ASSIGN
     1333          ed-wth:READ-ONLY IN FRAME F-Main        = TRUE.
     1334   ON CHOOSE OF bt-wth IN FRAME F-Main
     1335   DO:
     1336       assign
     1337         rs-wth = 2
     1338       .
     1339       display
     1340         rs-wth
     1341       with frame F-Main.
     1342       run select-wth in this-procedure.
     1343   END.
     1344   ON VALUE-CHANGED OF rs-wth IN FRAME F-Main
     1345   DO:
     1346   define buffer buf_wth-par for ub.wth-par.
     1347   define buffer buf_wealth  for ub.wealth .
     1348      assign
     1349         rs-wth
     1350      .
     1351      case rs-wth :
     1352      when 1 then do:
     1353         assign
     1354            ed-wth      = "Все"
     1355            v-wth-list  = ""
     1356         .
     1357         for each buf_wth-par
     1358            no-lock
     1359            ,
     1360            FIRST buf_wealth
     1361            WHERE buf_wealth.wth-code  = buf_wth-par.wth-code
     1362              and buf_wealth.is-ser    = 1
     1363            no-lock
     1364            :
     1365            assign
     1366               v-wth-list = v-wth-list
     1367                           + string( buf_wth-par.wth-code )
     1368                           + chr(4)
     1369                           + string( buf_wth-par.par-code )
     1370                           + chr(44)
     1371            .
     1372         end.
     1373         assign
     1374            v-wth-list = trim( v-wth-list, chr(44) )
     1375         .
     1376         display
     1377            ed-wth
     1378         with frame F-Main.
     1379      end.
     1380      when 2 then do:
     1381         apply "choose" to bt-wth.
     1382      end.
     1383      otherwise do:
     1384         return no-apply.
     1385      end.
     1386      end case.
     1387   END.
     1388   PROCEDURE convert-wth-code :
     1389   define input  parameter p-code-list   as character no-undo .
     1390   define output parameter p-recid-list  as character no-undo .
     1391   define buffer buf_wth-par for ub.wth-par.
     1392   define variable v-i               as integer   no-undo .
     1393   do
     1394   on error undo, return error return-value
     1395   :
     1396      do v-i = 1 to num-entries( p-code-list , chr(44) )
     1397      :
     1398         find first buf_wth-par
     1399              where buf_wth-par.wth-code = integer( ENTRY(1, entry( v-i, p-code-list, chr(44)), chr(4) ))
     1400                and buf_wth-par.par-code = integer( ENTRY(2, entry( v-i, p-code-list, chr(44)), chr(4) ))
     1401              no-lock
     1402            no-error
     1403            .
     1404         if available buf_wth-par
     1405         then do:
     1406         assign
     1407            p-recid-list = p-recid-list + string( recid(buf_wth-par) ) + chr(44)
     1408         .
     1409         end.
     1410      end.
     1411      assign
     1412         p-recid-list = trim( p-recid-list, chr(44) )
     1413      .
     1414   end.
     1415   END PROCEDURE.
     1416   PROCEDURE convert-wth-recid :
     1417   define input  parameter p-recid-list  as character no-undo .
     1418   define output parameter p-code-list   as character no-undo .
     1419   define buffer buf_wth-par for ub.wth-par.
     1420   define variable v-i               as integer   no-undo .
     1421   do
     1422   on error undo, return error return-value
     1423   :
     1424      do v-i = 1 to num-entries( p-recid-list, chr(44) )
     1425      :
     1426         find first buf_wth-par no-lock
     1427            where recid(buf_wth-par) = integer( entry( v-i, p-recid-list ) )
     1428         no-error .
     1429         if available buf_wth-par
     1430         then do:
     1431            assign
     1432               p-code-list = p-code-list
     1433                           + string( buf_wth-par.wth-code )
     1434                           + chr(4)
     1435                           + string( buf_wth-par.par-code )
     1436                           + chr(44)
     1437            .
     1438         end.
     1439      end.
     1440      assign
     1441         p-code-list = trim( p-code-list, chr(44) )
     1442      .
     1443   end.
     1444   END PROCEDURE.
     1445   PROCEDURE disable_UI :
     1446     HIDE FRAME F-Main.
     1447     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1448   END PROCEDURE.
     1449   PROCEDURE local-apply-layout :
     1450     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     1451   END PROCEDURE.
     1452   PROCEDURE local-initialize :
     1453      define buffer buf_wth-par for ub.wth-par .
     1454      define buffer buf_wealth  for ub.wealth .
     1455      define variable v-value-character as character no-undo .
     1456      define variable v-value-date as date no-undo .
     1457      define variable v-value-decimal as decimal no-undo .
     1458      define variable v-value-integer as INTEGER no-undo .
     1459      define variable v-value-logical AS LOGICAL no-undo .
     1460      define variable v-param-type as character no-undo .
     1461      define variable v-rs-cli-grp      as logical   no-undo.
     1462      define variable v-rs-wth          as logical   no-undo.
     1463      define variable v-void-logical-3        as logical      no-undo.
     1464      define variable v-void-logical-4        as logical      no-undo.
     1465      define variable v-i               as integer   no-undo .
     1466      define variable v-cli-grp-lst     as character    no-undo.
     1467   do
     1468   on error undo, return error
     1469   :
     1470      RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1471      run uf-get (
     1472           input 'wthrst':U
     1473         , input  v-cntxt-userid
     1474         , output v-cli-grp-lst
     1475         , output v-wth-list
     1476         , output v-free-zone
     1477         , output v-put-zone
     1478         , output v-rs-wth
     1479         , output v-void-logical-4
     1480      ) .
     1481      if v-rs-wth = no
     1482      then do:
     1483         assign
     1484            rs-wth  = 1
     1485            ed-wth  = "Все":u
     1486            v-wth-list = "":U
     1487         .
     1488         for each buf_wth-par
     1489            no-lock
     1490            ,
     1491            FIRST buf_wealth
     1492            WHERE buf_wealth.wth-code  = buf_wth-par.wth-code
     1493              and buf_wealth.is-ser    = 1
     1494            no-lock
     1495            :
     1496            assign
     1497               v-wth-list = v-wth-list
     1498                           + string( buf_wth-par.wth-code )
     1499                           + chr(4)
     1500                           + string( buf_wth-par.par-code )
     1501                           + chr(44)
     1502            .
     1503         end.
     1504         assign
     1505            v-wth-list = trim( v-wth-list, chr(44) )
     1506         .
     1507      end.
     1508      else do:
     1509         assign
     1510            rs-wth = 2
     1511         .
     1512         do v-i = 1 to num-entries(v-wth-list, chr(44) )
     1513         :
     1514            find first buf_wth-par
     1515                 where buf_wth-par.wth-code = integer( ENTRY(1, entry( v-i, v-wth-list, chr(44)), chr(4) ))
     1516                   and buf_wth-par.par-code = integer( ENTRY(2, entry( v-i, v-wth-list, chr(44)), chr(4) ))
     1517                 no-lock
     1518                 no-error
     1519                 .
     1520            if available buf_wth-par
     1521            then do:
     1522               assign
     1523                  ed-wth = ed-wth + STRING(buf_wth-par.par-val, ">>>>>9") + " " + buf_wth-par.par-unit + chr(10)
     1524               .
     1525            end.
     1526         end.
     1527      end.
     1528      display
     1529         v-free-zone
     1530         v-put-zone
     1531         rs-wth
     1532         ed-wth
     1533      with frame F-Main.
     1534   end.
     1535   END PROCEDURE.
     1536   PROCEDURE my-report :
     1537   do
     1538   on error undo, return error
     1539   with frame F-Main
     1540   :
     1541      ASSIGN
     1542        v-free-zone
     1543        v-put-zone
     1544        rs-wth
     1545      .
     1546      IF  v-free-zone = FALSE
     1547      AND v-put-zone  = FALSE
     1548      THEN DO:
     1549         message
     1550            "Не выбрана зона"
     1551            skip
     1552         view-as alert-box error.
     1553         return no-apply.
     1554      END.
     1555      IF v-wth-list = "":U
     1556      THEN DO:
     1557         message
     1558            "Не выбран список материальных ценностей"
     1559            skip
     1560         view-as alert-box error.
     1561         return no-apply.
     1562      END.
     1563      run uf-set (
     1564           input 'wthrst':U
     1565         , input v-cntxt-userid
     1566         , input "":U
     1567         , input v-wth-list
     1568         , input v-free-zone
     1569         , input v-put-zone
     1570         , input (rs-wth <> 1)
     1571         , input no
     1572      ) .
     1573      run rep/r-wthrst.p ( input my-handle
     1574                         , input v-wth-list
     1575                         , input v-free-zone
     1576                         , input v-put-zone
     1577                         , input (rs-wth = 1)
     1578                         , input ((x-SelectObject = "4":U) OR (x-SelectObject = "все"))
     1579                         ) .
     1580   end.
     1581   END PROCEDURE.
     1582   PROCEDURE my-var :
     1583     assign
     1584       ReportHeader =  ReportHeader + "Группы объектов: " + chr(10) + chr(10) +
     1585                       "Материальные ценности: " + chr(10) + ed-wth
     1586   .
     1587   END PROCEDURE.
     1588   PROCEDURE select-cli-grp :
     1589   define buffer buf_cli-grp     for ub.cli-grp .
     1590   define variable v-count    as integer      no-undo.
     1591   do
     1592   on error undo, return error
     1593   :
     1594   end.
     1595   END PROCEDURE.
     1596   PROCEDURE select-wth :
     1597   do
     1598   on error undo, return error
     1599   :
     1600     define buffer buf_wth-par for ub.wth-par.
     1601     define variable v-wth-recid-list  as character no-undo .
     1602     define variable v-i               as integer   no-undo .
     1603     run convert-wth-code in this-procedure ( input v-wth-list
     1604                                            , output v-wth-recid-list
     1605                                            ).
     1606      run ref/wthp-ref.w ( INPUT my-handle
     1607                        , INPUT "b-sel,b-mark"
     1608                        , INPUT v-cntxt-host-code-obj
     1609                        , INPUT v-cntxt-obj-type
     1610                        , INPUT v-cntxt-obj-code
     1611                        , INPUT 'ser_wealth':U
     1612                        , INPUT ?
     1613                        , INPUT-OUTPUT v-wth-recid-list
     1614                        ) .
     1615     assign
     1616       ed-wth = "":u
     1617     .
     1618     do v-i = 1 to num-entries( v-wth-recid-list, chr(44) )
     1619     :
     1620       find first buf_wth-par no-lock
     1621         where recid(buf_wth-par) = integer( entry( v-i, v-wth-recid-list ) )
     1622       no-error .
     1623       if available buf_wth-par
     1624       then do:
     1625         assign
     1626           ed-wth = ed-wth + STRING(buf_wth-par.par-val, ">>>>>9") + " " + buf_wth-par.par-unit + chr(10)
     1627         .
     1628       end.
     1629     end.
     1630     run convert-wth-recid in this-procedure ( input v-wth-recid-list
     1631                                             , output v-wth-list
     1632                        ) .
     1633     display
     1634       ed-wth
     1635     with frame F-Main.
     1636   end.
     1637   END PROCEDURE.
